// src/kernel/core/cap/kind_vk_swapchain_image.pdx -- G3.M2-001 (#1462)
//
// KIND_VK_SWAPCHAIN_IMAGE = 0x18A, derived over KIND_GPU_BO (0x174),
// whose runtime base is KIND_MEMORY (= KIND_PAGE, 4).
//
// One swapchain image -- a LINEAR handle over ONE KIND_GPU_BO
// carrying the two timelines needed for explicit-sync present:
//
//   gpu_timeline_slot     -> KIND_DISPLAY_TIMELINE the swapchain
//                            signals on ACQUIRE (image ready for
//                            the app to render into).
//   display_timeline_slot -> KIND_DISPLAY_TIMELINE the compositor
//                            signals on PRESENT (image scanned out
//                            for the app to wait on).
//
// Plus the presentation-timing fields the compositor consumes:
// target_pts (nanoseconds at which the client wants the image on
// glass) and present_id (VK_KHR_present_id, monotone per surface).
//
// =============================================================================
// SECTION 0  WHY THIS KIND IS LINEAR
// =============================================================================
//
// Vulkan WSI's acquire/render/present cycle is a single-owner
// baton. Once vkAcquireNextImageKHR returns image N to the app, no
// other actor may render into that BO until vkQueuePresentKHR
// returns it to the compositor. In hosted stacks the invariant is
// carried by convention -- a driver that hands the same image to
// two frames is a "swapchain corruption" bug people chase for
// weeks. Here it is expressed by making the CAP linear: the row's
// state field records ACQUIRED / RENDERING / QUEUED_FOR_PRESENT /
// PRESENTED_HELD_BY_COMPOSITOR / FREE, and revoke-and-remint is
// the only way to move an image between states. A second holder
// is refused at the mint gate (VKSI_MINT_IN_USE).
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_GPU_BO
// =============================================================================
//
// The kind half of the gate demands `kind == KIND_GPU_BO (0x174)`
// carrying RIGHT_MINT. The mint additionally requires:
//
//   (a) image_key non-zero and unique among live rows
//   (b) surface_slot names a live KIND_VK_SURFACE (0x189)
//   (c) image_index < VKSI_MAX_ROTATION (a swapchain has at most 4
//       images in flight at once)
//   (d) present_mode in {FIFO=0, MAILBOX=1, IMMEDIATE=2,
//       FIFO_RELAXED=3}
//   (e) gpu_timeline_slot names a live KIND_DISPLAY_TIMELINE
//   (f) display_timeline_slot names a second live
//       KIND_DISPLAY_TIMELINE, distinct from (e)
//   (g) rights subset of R_VKSI_ALL (R_MINT ABSENT -- LINEAR leaf)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 48 BYTES (SIX u64 WORDS)
// =============================================================================
//
//   [+0]  header: in_use[63:56] | parent_slot[15:8] | state[47:40]
//   [+8]  image_key (u64)
//   [+16] body1: bo_slot[15:0] | surface_slot[31:16]
//              | image_index[39:32] | present_mode[47:40]
//              | gpu_tl_slot[63:48]
//   [+24] body2: display_tl_slot[15:0] | reserved[63:16]
//   [+32] present_id (u64)          -- VK_KHR_present_id
//   [+40] target_pts (u64)          -- ns since boot; 0 = "asap"
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEE00..0xFFFFEE0F
// =============================================================================

module KindVkSwapchainImage = structure {

  pub let KIND_VK_SWAPCHAIN_IMAGE : u64 = 0x18A
  pub let VKSI_PARENT_KIND        : u64 = 0x174        // KIND_GPU_BO
  pub let VKSI_SURFACE_KIND       : u64 = 0x189        // KIND_VK_SURFACE
  pub let VKSI_TIMELINE_KIND      : u64 = 0x185        // KIND_DISPLAY_TIMELINE

  // Rights. R_MINT ABSENT -- LINEAR leaf.
  pub let R_VKSI_READ    : u64 = 0x001
  pub let R_VKSI_INVOKE  : u64 = 0x008
  pub let R_VKSI_REVOKE  : u64 = 0x010
  pub let R_VKSI_OBSERVE : u64 = 0x400
  pub let R_VKSI_ALL     : u64 = 0x419

  // Present modes.
  pub let VKSI_MODE_FIFO         : u64 = 0
  pub let VKSI_MODE_MAILBOX      : u64 = 1
  pub let VKSI_MODE_IMMEDIATE    : u64 = 2
  pub let VKSI_MODE_FIFO_RELAXED : u64 = 3
  pub let VKSI_MODE_MAX          : u64 = 3

  // Ops. Every op arity ONE.
  pub let VKSI_OP_QUERY_KEY        : u64 = 0
  pub let VKSI_OP_QUERY_BO         : u64 = 1
  pub let VKSI_OP_QUERY_SURFACE    : u64 = 2
  pub let VKSI_OP_QUERY_INDEX      : u64 = 3
  pub let VKSI_OP_QUERY_MODE       : u64 = 4
  pub let VKSI_OP_QUERY_STATE      : u64 = 5
  pub let VKSI_OP_QUERY_PRESENT_ID : u64 = 6
  pub let VKSI_OP_QUERY_TARGET_PTS : u64 = 7
  pub let VKSI_OP_DEBUG_PRINT      : u64 = 8
  pub let VKSI_OP_MAX              : u64 = 8

  // State field values.
  pub let VKSI_ST_FREE       : u64 = 0
  pub let VKSI_ST_ACQUIRED   : u64 = 1
  pub let VKSI_ST_RENDERING  : u64 = 2
  pub let VKSI_ST_QUEUED     : u64 = 3
  pub let VKSI_ST_PRESENTED  : u64 = 4
  pub let VKSI_ST_DISCARDED  : u64 = 5     // maintenance1 release-on-discard
  pub let VKSI_ST_MAX        : u64 = 5

  // Failure taxonomy -- 0xFFFFEE00..0xFFFFEE0F.
  pub let VKSI_OK               : u64 = 0
  pub let VKSI_TAIL_ENOSPC      : u64 = 0xFFFFEE0F
  pub let VKSI_TAIL_BAD_ARG     : u64 = 0xFFFFEE0E
  pub let VKSI_MINT_BAD_PARENT  : u64 = 0xFFFFEE0D
  pub let VKSI_MINT_BAD_RIGHTS  : u64 = 0xFFFFEE0C
  pub let VKSI_MINT_BAD_SURFACE : u64 = 0xFFFFEE0B
  pub let VKSI_MINT_BAD_INDEX   : u64 = 0xFFFFEE0A
  pub let VKSI_MINT_BAD_MODE    : u64 = 0xFFFFEE09
  pub let VKSI_MINT_BAD_GPU_TL  : u64 = 0xFFFFEE08
  pub let VKSI_MINT_BAD_DPY_TL  : u64 = 0xFFFFEE07
  pub let VKSI_MINT_TL_ALIAS    : u64 = 0xFFFFEE06
  pub let VKSI_MINT_NO_KEY      : u64 = 0xFFFFEE05
  pub let VKSI_MINT_ENOSPC      : u64 = 0xFFFFEE04
  pub let VKSI_MINT_IN_USE      : u64 = 0xFFFFEE03
  pub let VKSI_BAD_SLOT         : u64 = 0xFFFFEE02
  pub let VKSI_WRONG_KIND       : u64 = 0xFFFFEE01
  pub let VKSI_BAD_STATE        : u64 = 0xFFFFEE00

  pub let VKSI_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let VKSI_ROW_NONE   : u64 = 0xFF

  pub let VKSI_MAX          : u64 = 16      // rows in the table
  pub let VKSI_MAX_ROTATION : u64 = 4       // swapchain length ceiling
  pub let VKSI_ROW_BYTES    : u64 = 48

  // THE ONE STATE CELL. Confined by tools/build.sh. 16 rows *
  // 48 bytes = 768 bytes = 96 u64 slots.
  pub let mut _vk_swapchain_image_table : [u64; 96] = uninit @align(64)
  pub let mut _vk_swapchain_image_stats : [u64; 8]  = uninit @align(64)

  pub let VKSI_STA_MINTS     : u64 = 0
  pub let VKSI_STA_REVOKES   : u64 = 1
  pub let VKSI_STA_REFUSED   : u64 = 2
  pub let VKSI_STA_ACQUIRES  : u64 = 3
  pub let VKSI_STA_PRESENTS  : u64 = 4
  pub let VKSI_STA_DISCARDS  : u64 = 5
  pub let VKSI_STA_QUERIES   : u64 = 6

  pub let vksi_dbg_msg : [u8; 24] = "VK SWAPCHAIN IMAGE ROW\0\0"

  pub let vksi_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): clear row table + counters.",
      block: {
        lea r10, [rip + _vk_swapchain_image_table];
        xor rax, rax;
        xor rcx, rcx;
      vksi_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  vksi_rs_rows;

        lea r10, [rip + _vk_swapchain_image_stats];
        xor rcx, rcx;
      vksi_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vksi_rs_stats;
        ret
      }
    }

  pub let vksi_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): counter bump.",
      block: {
        cmp rdi, 8;
        jae vksi_nt_out;
        lea r10, [rip + _vk_swapchain_image_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vksi_nt_out:
        ret
      }
    }

  pub let vksi_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): counter read.",
      block: {
        cmp rdi, 8;
        jae vksi_st_zero;
        lea r10, [rip + _vk_swapchain_image_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vksi_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vksi_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-001 (#1462): subset test against R_VKSI_ALL = 0x419. R_MINT (0x200) OUTSIDE mask (LINEAR leaf).",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne vksi_rv_no;
        mov rax, 1;
        ret;
      vksi_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vksi_mode_valid : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-004 (#1465): 1 iff mode in {FIFO=0, MAILBOX=1, IMMEDIATE=2, FIFO_RELAXED=3}.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  vksi_mv_no;
        mov rax, 1;
        ret;
      vksi_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vksi_index_valid : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-001 (#1462): 1 iff idx < VKSI_MAX_ROTATION = 4.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae vksi_iv_no;
        mov rax, 1;
        ret;
      vksi_iv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vksi_state_valid : (u64) -> u64 !{} @{} =
    fn (st: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-001 (#1462): 1 iff st in [0, VKSI_ST_MAX=5].",
      block: {
        mov r10, 5;
        cmp rdi, r10;
        ja  vksi_sv_no;
        mov rax, 1;
        ret;
      vksi_sv_no:
        xor rax, rax;
        ret
      }
    }

  // Row body pack helpers.
  // body1: bo_slot[15:0] | surface_slot[31:16] | image_index[39:32]
  //      | present_mode[47:40] | gpu_tl_slot[63:48]
  pub let vksi_body1_pack : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (bo: u64) (surf: u64) (idx: u64) (mode: u64) (gpu_tl: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-001 (#1462): body1 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vksi_b1_bad;
        cmp rsi, r10;
        ja  vksi_b1_bad;
        mov r10, 0xFF;
        cmp rdx, r10;
        ja  vksi_b1_bad;
        cmp rcx, r10;
        ja  vksi_b1_bad;
        mov r10, 0xFFFF;
        cmp r8, r10;
        ja  vksi_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        mov r10, r8;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      vksi_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: display_tl_slot[15:0] | reserved[63:16]
  pub let vksi_body2_pack : (u64) -> u64 !{} @{} =
    fn (dpy_tl: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-001 (#1462): body2 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vksi_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      vksi_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // header: in_use[63:56] | state[47:40] | parent_slot[15:8]
  // in_use is set at claim time; parent + state are packed here.
  pub let vksi_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (parent_slot: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M2-001 (#1462): (parent_slot << 8) | (state << 40).",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vksi_hp_bad;
        mov r10, 5;
        cmp rsi, r10;
        ja  vksi_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        mov r10, rsi;
        shl r10, 40;
        or  rax, r10;
        ret;
      vksi_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vksi_tail_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (image_key: u64) (body1: u64) (body2: u64) (present_id: u64) (target_pts: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): claim one VK_SWAPCHAIN_IMAGE row. THE ONE WRITER of _vk_swapchain_image_table.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;
        mov rbp, r8;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne vksi_ta_bad;
        cmp r13, 0;
        je  vksi_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  vksi_ta_bad;
        cmp r15, r10;
        je  vksi_ta_bad;

        xor rbx, rbx;
      vksi_ta_scan:
        cmp rbx, 16;
        jae vksi_ta_enospc;
        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, rbx;
        imul r11, r11, 48;           // 48-byte row stride
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vksi_ta_claim;
        add rbx, 1;
        jmp vksi_ta_scan;

      vksi_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov [r10 + 32], rbp;
        mov [r10 + 40], r9;     // arg6 target_pts (SysV: r9; not clobbered pre-alloc)
        mov rax, rbx;
        jmp vksi_ta_out;

      vksi_ta_enospc:
        mov rax, 0xFFFFEE0F;
        jmp vksi_ta_out;
      vksi_ta_bad:
        mov rax, 0xFFFFEE0E;

      vksi_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vksi_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): 1 iff row_id < VKSI_MAX and in_use. Row stride = 48 (6*u64).",
      block: {
        cmp rdi, 16;
        jae vksi_tv_no;
        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vksi_tv_no;
        mov rax, 1;
        ret;
      vksi_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vksi_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): scrub one row.",
      block: {
        cmp rdi, 16;
        jae vksi_tf_out;
        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      vksi_tf_out:
        ret
      }
    }

  pub let vksi_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): image_key.",
      block: {
        push r12;
        mov r12, rdi;
        call vksi_tail_valid;
        cmp rax, 0;
        je  vksi_rk_bad;
        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp vksi_rk_out;
      vksi_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vksi_rk_out:
        pop r12;
        ret
      }
    }

  pub let vksi_row_bo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): bo_slot at body1[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call vksi_tail_valid;
        cmp rax, 0;
        je  vksi_rb_bad;
        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp vksi_rb_out;
      vksi_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vksi_rb_out:
        pop r12;
        ret
      }
    }

  pub let vksi_row_surface : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): surface_slot at body1[31:16].",
      block: {
        push r12;
        mov r12, rdi;
        call vksi_tail_valid;
        cmp rax, 0;
        je  vksi_rs_bad;
        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp vksi_rs_out;
      vksi_rs_bad:
