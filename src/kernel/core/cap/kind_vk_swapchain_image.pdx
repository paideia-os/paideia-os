  pub let vksi_row_dpy_tl : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): display_timeline_slot at body2[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call vksi_tail_valid;
        cmp rax, 0;
