  // Transition the state field. Row valid + state fits u8. THE ONE
  // WRITER of the state field outside vksi_tail_alloc / vksi_tail_free.
  pub let vksi_row_set_state : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): rewrite state[47:40] on header. Row valid + state <= VKSI_ST_MAX. Three pushes to keep rsp aligned across the calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r13;
        call vksi_state_valid;
        cmp rax, 0;
        je  vksi_ss_bad;

        mov rdi, r12;
        call vksi_tail_valid;
        cmp rax, 0;
        je  vksi_ss_bad;

        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, 0xFF;
        shl r11, 40;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 40;
        or  rax, r11;
        mov [r10 + 0], rax;

        xor rax, rax;
        jmp vksi_ss_out;

      vksi_ss_bad:
        mov rax, 0xFFFFEE00;

      vksi_ss_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vksi_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (image_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): live row with this image_key, or ROW_NONE.",
      block: {
        cmp rdi, 0;
        je  vksi_fk_none;
        xor rcx, rcx;
      vksi_fk_scan:
        cmp rcx, 16;
        jae vksi_fk_none;
        lea r10, [rip + _vk_swapchain_image_table];
        mov r11, rcx;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vksi_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  vksi_fk_hit;
      vksi_fk_next:
        add rcx, 1;
        jmp vksi_fk_scan;
      vksi_fk_hit:
        mov rax, rcx;
        ret;
      vksi_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let vksi_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G3.M2-001 (#1462): slot -> row_id, gated on live KIND_VK_SWAPCHAIN_IMAGE.",
      block: {
        push r12;
        mov r11, 256;
        cmp rdi, r11;
        jae vksi_ros_none;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x18A;
        cmp r10, r11;
        jne vksi_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call vksi_tail_valid;
        cmp rax, 0;
        je  vksi_ros_none;
        mov rax, r12;
        jmp vksi_ros_out;
      vksi_ros_none:
        mov rax, 0xFF;
      vksi_ros_out:
        pop r12;
        ret
      }
    }

  pub let cap_handler_vk_swapchain_image : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G3.M2-001 (#1462): KIND_VK_SWAPCHAIN_IMAGE dispatch. QUERY ops arity ONE.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_vk_swapchain_image_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne vksi_hn_res;

        cmp rbp, 8;
        ja  vksi_hn_unsup;
        cmp rbp, 8;
        je  vksi_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  vksi_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  vksi_hn_key;
        cmp rbp, 1;
        je  vksi_hn_bo;
        cmp rbp, 2;
        je  vksi_hn_surf;
        cmp rbp, 3;
        je  vksi_hn_idx;
        cmp rbp, 4;
        je  vksi_hn_mode;
        cmp rbp, 5;
        je  vksi_hn_state;
        cmp rbp, 6;
        je  vksi_hn_pid;
        call vksi_row_target_pts;
        jmp vksi_hn_out;

      vksi_hn_key:
        call vksi_row_key;
        jmp vksi_hn_out;
      vksi_hn_bo:
        call vksi_row_bo;
        jmp vksi_hn_out;
      vksi_hn_surf:
        call vksi_row_surface;
        jmp vksi_hn_out;
      vksi_hn_idx:
        call vksi_row_index;
        jmp vksi_hn_out;
      vksi_hn_mode:
        call vksi_row_mode;
        jmp vksi_hn_out;
      vksi_hn_state:
        call vksi_row_state;
        jmp vksi_hn_out;
      vksi_hn_pid:
        call vksi_row_present_id;
        jmp vksi_hn_out;

      vksi_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  vksi_hn_denied;
        xor rax, rax;
        jmp vksi_hn_out;

      vksi_hn_res:
        mov rax, 0xFFFFEE0E;
        jmp vksi_hn_out;
      vksi_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp vksi_hn_out;
      vksi_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      vksi_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
