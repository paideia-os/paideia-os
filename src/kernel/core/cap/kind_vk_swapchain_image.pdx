  pub let vksi_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M2-001 (#1462): present_mode at body1[47:40].",
