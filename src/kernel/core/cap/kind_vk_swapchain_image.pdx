        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFF;
        jmp vksi_rdt_out;
      vksi_rdt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vksi_rdt_out:
        pop r12;
        ret
