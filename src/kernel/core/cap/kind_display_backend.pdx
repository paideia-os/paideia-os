// src/kernel/core/cap/kind_display_backend.pdx -- R101.M1-001
//
// KIND_DISPLAY_BACKEND = 0x1AE, derived over KIND_DEVICE (= slot 10).
//
// The multi-backend anchor above the Iris-Xe-specific KIND_DISPLAY_
// ENGINE (0x16F). Per design/graphics/r101-kernel-plan.md §4.1: the
// KIND_DISPLAY_ENGINE mint gate refuses gpu_gen not in {1,2,3} (Xe1/
// Xe2/Xe3), so a QEMU stdvga or virtio-gpu cannot mint one. This kind
// sits above KIND_DISPLAY_ENGINE (option C in that section) and carries
// a backend_kind selector distinguishing BOCHS_STDVGA / VIRTIO_GPU /
// IRIS_XE.
//
// Row substrate + mint gate + row accessors + cap_invoke dispatch
// handler folded into one file (kind_nic.pdx precedent) because the op
// surface is deliberately tiny at R101 -- one QUERY op (query backend
// kind) at this landing; the compositor-facing dispatch surface expands
// in R104/R105 (KIND_PAGE_FLIP, KIND_HOTPLUG_CHANNEL).
//
// =============================================================================
// SECTION 0  WHY KIND_DISPLAY_BACKEND DERIVES OVER KIND_DEVICE
// =============================================================================
//
// Every display path is anchored on a PCI function -- the Bochs/stdvga
// device (0x1234/0x1111), the virtio-gpu-pci device (0x1AF4/0x1050), or
// the Iris Xe integrated graphics function. Every PCI function is
// already a KIND_DEVICE by the R31.M3 discipline this file family
// reuses. The kind half of the derivation gate therefore discriminates
// NOTHING on its own (KIND_NIC §0's honest-division note applies
// verbatim); what the mint additionally enforces is a plausible
// backend_kind selector and the parent capability carrying RIGHT_MINT.
// "This device is a Bochs stdvga" is a class-code + vendor/device fact
// distilled at probe time; the KIND_DISPLAY_BACKEND capability is the
// record of that decision.
//
// =============================================================================
// SECTION 1  TAIL ENCODING -- 32 BYTES (four u64 words)
// =============================================================================
//
// The r101-kernel-plan §5 R101.M1-001 issue-text row shape names four
// fields: {backend_kind, pci_bdf, provider_slot, format_caps}. The
// prompt-supplied ordering (kind_tag@+0, backend_type@+8, bar_pa@+16,
// mmio_base@+24) collides with the tree-wide "header at +0" pattern
// every other kind_*.pdx file follows (in_use flag lives in header
// bits [63:56] so tail_alloc's low-first scan can find a free row).
// This file honours the tree pattern:
//
//   [+0]  header (u64):
//         in_use      [63:56]  (allocator flag; 0=free, 1=live)
//         reserved    [55:16]
//         backend_kind[7:0]    (0=NONE, 1=BOCHS_STDVGA, 2=VIRTIO_GPU_2D,
//                               3=VIRTIO_GPU_3D, 4=IRIS_XE; DPYB_KIND_MAX = 4)
//   [+8]  bar_pa    (u64)      -- the framebuffer PA (BAR0 for stdvga;
//                                  RESOURCE_ID base for virtio-gpu; scan-out
//                                  GTT VA for Iris Xe)
//   [+16] mmio_base (u64)      -- BAR2 MMIO base for stdvga VBE-DISPI
//                                  registers; MMIO cfg base for virtio-gpu;
//                                  MMIO_BAR for Iris Xe
//   [+24] provider_slot (u64)  -- for IRIS_XE: cap_table slot naming a
//                                  KIND_DISPLAY_ENGINE row; for BOCHS /
//                                  VIRTIO_GPU: 0 (driver owns tail state)
//
// Row-addressed capacity: DPYB_MAX = 4 rows. Rationale: T14 G4 has at
// most three concurrently active outputs so one KIND_DISPLAY_BACKEND
// per driver (Bochs + virtio-gpu + Iris Xe + one headroom) suffices at
// R101 and follow-on rounds without inflating the pool. 4 * 32 = 128
// bytes = 16 u64.
//
// =============================================================================
// SECTION 2  RIGHTS  --  R_DPYB_QUERY (0x001) ONLY at R101.M1
// =============================================================================
//
//   R_DPYB_QUERY (0x001) -- gate the one QUERY op in cap_handler.
//
// No R_DPYB_INVOKE / MINT / REVOKE at this landing: KIND_DISPLAY_BACKEND
// is a *static-identity* capability at R101.M1. R104.M4 introduces
// KIND_PAGE_FLIP as a SEPARATE derived kind under KIND_DISPLAY_OUTPUT
// for the compositor's swap authority -- widening this kind's rights
// mask would let a holder of pure backend authority reach the
// per-output flip path, inverting the layering §4.3 encodes.
//
// R_DPYB_ALL = R_DPYB_QUERY = 0x001. Subset test in dpyb_rights_valid.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB30..0xFFFFEB3F
// =============================================================================
//
// A repo-wide audit at landing time (grep -rEho '0xFFFFEB[0-9A-Fa-f]{2}'
// under src/kernel/) shows 0xFFFFEB30..0xFFFFEB3F is entirely free.
// Disjoint from KIND_SIG_KEY's 0xFFFFEB00..0F, KIND_TUI_CANVAS's
// 0xFFFFEB10..1F, KIND_TLS_TRUST's 0xFFFFEB20..27 and KIND_NIC's
// 0xFFFFEB28..2F. R101.M3 KIND_FRAMEBUFFER claims 0xFFFFEB40..4F.
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag 0x1AE stages through r11 for `cmp reg, imm` (32-bit
// immediate does not sign-extend cleanly). No mov_b/w/d for row loads
// (row fields are full u64 words). No `test`, no `add reg, [mem]`, no
// `cmp reg, [mem]`. Labels prefixed `dpyb_`.

module KindDisplayBackend = structure {

  pub let KIND_DISPLAY_BACKEND      : u64 = 0x1AE
  pub let KIND_DISPLAY_BACKEND_BASE : u64 = 10        // = KIND_DEVICE

  // backend_kind selector (§1).
  pub let DPYB_KIND_NONE          : u64 = 0
  pub let DPYB_KIND_BOCHS_STDVGA  : u64 = 1
  pub let DPYB_KIND_VIRTIO_GPU_2D : u64 = 2
  pub let DPYB_KIND_VIRTIO_GPU_3D : u64 = 3
  pub let DPYB_KIND_IRIS_XE       : u64 = 4
  pub let DPYB_KIND_MAX           : u64 = 4

  // Rights (§2). Immutable-once-minted at this landing.
  pub let R_DPYB_QUERY : u64 = 0x001
  pub let R_DPYB_ALL   : u64 = 0x001

  // Ops.
  pub let DPYB_OP_QUERY_KIND : u64 = 0
  pub let DPYB_OP_MAX        : u64 = 0

  // Failure taxonomy (§3). 0xFFFFEB30..0xFFFFEB3F band.
  pub let DPYB_OK              : u64 = 0
  pub let DPYB_MINT_BAD_PARENT : u64 = 0xFFFFEB3F
  pub let DPYB_MINT_BAD_KIND   : u64 = 0xFFFFEB3E
  pub let DPYB_MINT_BAD_RIGHTS : u64 = 0xFFFFEB3D
  pub let DPYB_TAIL_BAD_ARG    : u64 = 0xFFFFEB3C
  pub let DPYB_TAIL_ENOSPC     : u64 = 0xFFFFEB3B
  pub let DPYB_BAD_SLOT        : u64 = 0xFFFFEB3A

  pub let DPYB_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPYB_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let DPYB_MAX       : u64 = 4
  pub let DPYB_ROW_BYTES : u64 = 32

  // 4 rows * 32 bytes = 128 bytes = 16 u64.
  pub let mut _dpyb_table : [u64; 16] = uninit @align(64)
  pub let mut _dpyb_stats : [u64; 4]  = uninit @align(32)

  pub let DPYB_ST_MINTS   : u64 = 0
  pub let DPYB_ST_QUERIES : u64 = 1
  pub let DPYB_ST_REFUSED : u64 = 2

  // The one live backend slot for R101 dispatch. Set by
  // kind_display_backend_mint_body's success tail; consumed by
  // core/graphics/backend_dispatch.pdx. Zero == no backend live.
  pub let mut _active_backend_kind : u64 = 0

  // Fingerprint tag (all-lowercase, no OK_TOK trigger).
  pub let dpyb_mint_ok_msg : [u8; 32] = "r101 display_backend mint ok\0\0\0\0"

  // ==========================================================================
  // dpyb_table_reset() -> ()
  // ==========================================================================
  pub let dpyb_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M1-001: clear every _dpyb_table row + counters + _active_backend_kind. .bss zero at real boot; defensive re-scrub for chaos-restart. Mirrors nic_table_reset one-for-one. Labels prefixed dpyb_rs_.",
      block: {
        lea r10, [rip + _dpyb_table];
        xor rax, rax;
        xor rcx, rcx;
      dpyb_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  dpyb_rs_rows;

        lea r10, [rip + _dpyb_stats];
        xor rcx, rcx;
      dpyb_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dpyb_rs_stats;

        lea r10, [rip + _active_backend_kind];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let dpyb_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M1-001: bounded increment on _dpyb_stats; out-of-range no-op. Load-inc-store idiom, no `add reg, [mem]`. Labels prefixed dpyb_nt_.",
      block: {
        cmp rdi, 4;
        jae dpyb_nt_out;
        lea r10, [rip + _dpyb_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpyb_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpyb_kind_valid : (u64) -> u64 !{} @{} =
    fn (bk: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M1-001: 1 iff bk in (0, DPYB_KIND_MAX = 4]. NONE (0) is REFUSED here (unlike KIND_NIC which allows NIC_KIND_NONE): a display backend with no concrete driver behind it cannot participate in dispatch, and the plan gives no path for it to become one after mint. Labels prefixed dpyb_kv_.",
      block: {
        cmp rdi, 0;
        je  dpyb_kv_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  dpyb_kv_no;
        mov rax, 1;
        ret;
      dpyb_kv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpyb_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M1-001: subset test against R_DPYB_ALL = 0x001. Labels prefixed dpyb_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x001;
        and rax, r10;
        cmp rax, rdi;
        jne dpyb_rv_no;
        mov rax, 1;
        ret;
      dpyb_rv_no:
        xor rax, rax;
        ret
      }
    }

  // KIND_DEVICE derivation gate. Mirrors nic_check_parent_device one-
  // for-one -- cap_table[slot*24 + 0/+8/+16] = (kind, rights, target_ptr).
  pub let dpyb_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R101.M1-001: first half of the derivation gate. bounds parent_slot < 256; require kind == KIND_DEVICE (10) AND rights carry RIGHT_MINT (0x200). Structurally identical to nic_check_parent_device. Labels prefixed dpyb_cpd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpyb_cpd_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne dpyb_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  dpyb_cpd_no;

        mov rax, 1;
        ret;

      dpyb_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  // dpyb_hdr_pack(backend_kind) -> hdr | DPYB_DECODE_BAD.
  // Packs backend_kind into bits [7:0]. in_use ([63:56]) left 0 -- tail_
  // alloc's claim path sets it in the same qword store.
  pub let dpyb_hdr_pack : (u64) -> u64 !{} @{} =
    fn (backend_kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M1-001: canonical header encoder. backend_kind in (0,4] fits [7:0]. Out-of-range -> DPYB_DECODE_BAD (~0). Labels prefixed dpyb_hp_.",
      block: {
        cmp rdi, 0;
        je  dpyb_hp_bad;
        mov r10, 4;
        cmp rdi, r10;
        ja  dpyb_hp_bad;
        mov rax, rdi;
        ret;
      dpyb_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Row pool: row_valid / tail_alloc / tail_free / row_backend_kind.
  // ==========================================================================

  pub let dpyb_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M1-001: 1 iff idx < DPYB_MAX(4) and in_use byte set. Inlined address compute (idx*32 via shl 5). Labels prefixed dpyb_rv2_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae dpyb_rv2_no;
        lea r10, [rip + _dpyb_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpyb_rv2_no;
        mov rax, 1;
        ret;
      dpyb_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // dpyb_row_backend_kind(idx) -> backend_kind | DPYB_DECODE_BAD.
  pub let dpyb_row_backend_kind : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M1-001: read backend_kind from _dpyb_table[idx].header[7:0]; refuses idx out of range or in_use==0. Labels prefixed dpyb_rbk_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae dpyb_rbk_bad;
        lea r10, [rip + _dpyb_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  dpyb_rbk_bad;
        and rax, 0xFF;
        ret;
      dpyb_rbk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // dpyb_tail_alloc(hdr, bar_pa, mmio_base, provider_slot) -> row_id | *_SENTINEL.
  pub let dpyb_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (bar_pa: u64) (mmio_base: u64) (provider_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M1-001: claim one KIND_DISPLAY_BACKEND row. THE ONLY WRITER of _dpyb_table on the allocate path. Refuses hdr in_use pre-set (bits [63:56] non-zero) -> DPYB_TAIL_BAD_ARG. Low-first scan over 4 rows of 32 bytes (idx*32 via shl 5). Row writes: bar_pa, mmio_base, provider_slot first; header last with in_use=1 OR'd in same qword. Four callee-save pushes preserve loop-carried state -- rsp%16==0 across the internal scan, no nested calls. Labels prefixed dpyb_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // hdr
        mov r12, rsi;                    // bar_pa
        mov r13, rdx;                    // mmio_base
        mov r14, rcx;                    // provider_slot

        // hdr in_use pre-set?
        mov rax, rbx;
        shr rax, 56;
        cmp rax, 0;
        jne dpyb_ta_bad;

        xor rcx, rcx;                    // row cursor idx = 0
      dpyb_ta_scan:
        cmp rcx, 4;
        jae dpyb_ta_enospc;

        lea r10, [rip + _dpyb_table];
        mov r11, rcx;
        shl r11, 5;                      // idx * 32
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpyb_ta_claim;

        add rcx, 1;
        jmp dpyb_ta_scan;

      dpyb_ta_claim:
        mov [r10 + 8],  r12;             // bar_pa
        mov [r10 + 16], r13;             // mmio_base
        mov [r10 + 24], r14;             // provider_slot

        mov rax, rbx;                    // hdr
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;              // header last (publish in_use)

        mov rax, rcx;                    // row_id
        jmp dpyb_ta_out;

      dpyb_ta_enospc:
        mov rax, 0xFFFFEB3B;             // DPYB_TAIL_ENOSPC
        jmp dpyb_ta_out;
      dpyb_ta_bad:
        mov rax, 0xFFFFEB3C;             // DPYB_TAIL_BAD_ARG

      dpyb_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dpyb_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M1-001: scrub one row (all four u64 words). Labels prefixed dpyb_tf_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae dpyb_tf_out;
        lea r10, [rip + _dpyb_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      dpyb_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Mint body.
  //
  // kind_display_backend_mint_body(parent_slot, rights, backend_kind,
  //   bar_pa, mmio_base, provider_slot) -> row_id | DPYB_MINT_*
  //
  // paideia-as caps SysV register args at 6, so the sixth arg
  // (provider_slot) travels in r9. Register plan: r12=bar_pa,
  // r13=mmio_base, r14=provider_slot, r15=backend_kind, rbx=hdr.
  //
  // Publishes _active_backend_kind = backend_kind on the FIRST successful
  // mint after boot (R101.M2-005 boot integration is the sole caller in
  // this landing; subsequent virtio-gpu/Iris-Xe mints in R103/R104 do
  // NOT overwrite an already-set value -- the dispatch shim only needs
  // one live backend at a time until KIND_PAGE_FLIP arrives at R104.M4).
  // ==========================================================================
  pub let kind_display_backend_mint_body : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) (rights: u64) (backend_kind: u64) (bar_pa: u64) (mmio_base: u64) (provider_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R101.M1-001: mint KIND_DISPLAY_BACKEND over KIND_DEVICE. Gate order: (1) parent_slot via dpyb_check_parent_device (KIND_DEVICE + RIGHT_MINT); (2) rights via dpyb_rights_valid; (3) backend_kind via dpyb_kind_valid; (4) header pack via dpyb_hdr_pack; (5) row claim via dpyb_tail_alloc. On success emits the mint fingerprint via klog_s1_d1 and, if _active_backend_kind is zero, publishes backend_kind there for backend_dispatch to consume. Register plan (all six caller-args spilled to callee-save before the first gate call clobbers rsi/rdx/rcx/r8/r9; matches the R89 kind_tui_canvas_mint_body / R91 kind_nic_mint_body shape): rbx=parent_slot (later reused for row_id), r12=rights, r13=backend_kind, r14=bar_pa, r15=mmio_base, rbp=provider_slot. Six callee-save pushes + sub rsp,8: entry rsp%16==8, +48+8=56, rsp%16==0. klog_s1_d1 preserves rbx/r12-r15/rbp per SysV. Labels prefixed dpyb_mb_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                    // parent_slot
        mov r12, rsi;                    // rights
        mov r13, rdx;                    // backend_kind
        mov r14, rcx;                    // bar_pa
        mov r15, r8;                     // mmio_base
        mov rbp, r9;                     // provider_slot

        // Gate 1: parent
        mov rdi, rbx;
        call dpyb_check_parent_device;
        cmp rax, 0;
        je  dpyb_mb_bad_parent;

        // Gate 2: rights
        mov rdi, r12;
        call dpyb_rights_valid;
        cmp rax, 0;
        je  dpyb_mb_bad_rights;

        // Gate 3: backend_kind
        mov rdi, r13;
        call dpyb_kind_valid;
        cmp rax, 0;
        je  dpyb_mb_bad_kind;

        // Header pack (returns hdr in rax; save into rbx now that
        // parent_slot is no longer needed).
        mov rdi, r13;
        call dpyb_hdr_pack;
        mov rbx, rax;                    // rbx = hdr

        // Row claim: dpyb_tail_alloc(hdr, bar_pa, mmio_base, provider_slot).
        mov rdi, rbx;                    // hdr
        mov rsi, r14;                    // bar_pa
        mov rdx, r15;                    // mmio_base
        mov rcx, rbp;                    // provider_slot
        call dpyb_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae dpyb_mb_refused;             // rax already carries sentinel

        mov rbx, rax;                    // rbx = row_id

        // Publish _active_backend_kind if unset.
        lea r10, [rip + _active_backend_kind];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne dpyb_mb_active_kept;
        mov [r10 + 0], r13;
      dpyb_mb_active_kept:

        // Stats.
        mov rdi, 0;                      // DPYB_ST_MINTS
        call dpyb_note;

        // Fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + dpyb_mint_ok_msg];
        lea rcx, [rip + k_row];
        mov r8, rbx;
        call klog_s1_d1;

        mov rax, rbx;
        jmp dpyb_mb_out;

      dpyb_mb_bad_parent:
        mov rax, 0xFFFFEB3F;             // DPYB_MINT_BAD_PARENT
        jmp dpyb_mb_refused;
      dpyb_mb_bad_rights:
        mov rax, 0xFFFFEB3D;             // DPYB_MINT_BAD_RIGHTS
        jmp dpyb_mb_refused;
      dpyb_mb_bad_kind:
        mov rax, 0xFFFFEB3E;             // DPYB_MINT_BAD_KIND

      dpyb_mb_refused:
        push rax;
        mov rdi, 2;                      // DPYB_ST_REFUSED
        call dpyb_note;
        pop rax;

      dpyb_mb_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  pub let kind_display_backend_revoke_body : (u64) -> u64 !{mem} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R101.M1-001: revoke KIND_DISPLAY_BACKEND row. row_id >= DPYB_MAX(4) -> DPYB_BAD_SLOT; not in_use -> DPYB_BAD_SLOT (revoke-of-empty is caller bug); else tail_free + return 0. Does NOT clear _active_backend_kind (a compositor teardown that revokes and re-mints another backend keeps dispatch coherent). Labels prefixed dpyb_rb_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 4;
        cmp r12, r10;
        jae dpyb_rb_bad_slot;

        mov rdi, r12;
        call dpyb_row_valid;
        cmp rax, 0;
        je  dpyb_rb_bad_slot;

        mov rdi, r12;
        call dpyb_tail_free;
        xor rax, rax;
        jmp dpyb_rb_out;

      dpyb_rb_bad_slot:
        mov rax, 0xFFFFEB3A;             // DPYB_BAD_SLOT

      dpyb_rb_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_display_backend_init() -> ()
  //
  // Boot-time defensive re-scrub. .bss is zero at real boot; matches the
  // KIND_TUI_CANVAS / KIND_TLS_TRUST / KIND_NIC discipline.
  // ==========================================================================
  pub let kind_display_backend_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M1-001: dpyb_table_reset alias / boot-time defensive re-scrub. Zero args, no push/pop (dpyb_table_reset only touches rax/rcx/r10), safe alongside live handoff registers. Labels prefixed dpyb_bi_ (none needed, one nested call).",
      block: {
        call dpyb_table_reset;
        ret
      }
    }
}
