// src/kernel/core/cap/kind_hid_event.pdx — R32.M3-002 (#1126)
//
// KIND_HID_EVENT = 0x15c, derived over KIND_IPC_ENDPOINT (5).
//
// The authority a ring-3 SUBSCRIBER holds to be told, on ONE endpoint
// it also holds, about the subset of the HID event-class stream it
// asks for (key / pointer / touch / sensor). The record of one
// subscription.
//
// =============================================================================
// §0  UNITS: THE EVENT MASK IS A CLASS SUBSET, NOT AN ID LIST
// =============================================================================
//
// The row stores an EVENT-TYPE MASK -- four bits, one per class of
// HID event the R32 substrate emits (§5) -- and NOT a list of report
// ids, usages, or Universal Serial Bus descriptor bytes. The class
// carries a subscriber's answer to "am I interested in keys, or in
// pointer motion, or in touchpoints, or in orientation" and the
// R32.M4 router will fan a decoded event out to exactly the
// subscriptions whose class matches. Widening the mask beyond the
// four defined bits would let a subscription claim reach that has no
// meaning yet -- the row would carry a bit no router consulted, and
// the answer to "does this subscription want the meta-key" would be
// invented at read time. So `hid_event_mask_valid` refuses any
// superset of `HID_EVT_MASK_ALL`, and admits any non-empty subset.
//
// A subscription to the empty mask is REFUSED at mint (§2), because
// unlike KIND_EC_QUERY's monotone bitmap this kind is not narrowed
// over time -- the mask is set once and there is no primitive that
// changes it -- so a zero mask at mint would be a subscription that
// received nothing forever while looking perfectly registered.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT — THE WHOLE ROW IS STATIC
// =============================================================================
//
// Unlike KIND_HID_DEVICE (#1125) which carries a lifetime install
// count, this kind's row has NO DYNAMIC FIELD. The four values
// (endpoint id, event type mask, subscriber pid, in_use flag) are
// set once at mint and read thereafter. Delivery accounting lives in
// the R32.M4 router when it lands; this row's job is to be the
// SUBSCRIPTION RECORD the router consults.
//
// A dynamic field on this kind would be a temptation for the router
// to store per-subscription state that a mint gate never validated.
// Not carrying one is the load-bearing decision.
//
// =============================================================================
// §2  DERIVATION OVER KIND_IPC_ENDPOINT — THE THIRD TIME AN EMPTY GATE
//     IS NAMED SO
// =============================================================================
//
// FIRST HALF: `cap_table[parent_slot].kind == KIND_IPC_ENDPOINT (5)`
// carrying RIGHT_MINT.
//
// THAT HALF IS EMPTY ON ITS OWN. Every endpoint in this system is a
// KIND_IPC_ENDPOINT -- the shell's stdout included -- so a gate that
// stopped there would let any process holding any endpoint mint
// itself a subscription to the HID event stream. This is the #1075
// lesson restated for the third time in the derived-kind file family
// (KIND_FW_SESSION, KIND_EC_QUERY, and now this).
//
// SECOND HALF: the mint reads the parent's target_ptr bits [15:0]
// (the encoding cap/kind_endpoint.pdx's endpoint_tail_pack writes)
// and stores it as `event_channel_key`, refusing zero (`HID_EVT_
// MINT_BAD_EID`). Zero is a fabricated-parent sentinel: kind_endpoint
// treats endpoint_id 0 as unallocated, so a mint that admitted it
// would install a subscription whose deliveries the router refused as
// unroutable while looking perfectly registered.
//
// THE SUBSCRIBER PID IS A SECOND VALIDATED FIELD, not a decoration.
// R32.M4's router will use it to name the recipient in every
// delivered event's accounting record, and to run an owner-column
// sweep when the subscribing process dies -- so a mint that admitted
// pid == 0 would install a subscription owned by nothing (the
// reserved 'no process' pid), which the sweep would later interpret
// as 'the kernel holds this' and refuse to clean up. Refused with
// `HID_EVT_MINT_BAD_PID`.
//
// Unlike KIND_EC_QUERY there is NO SECOND CAPABILITY ARGUMENT here.
// The mask is a bit set (§0) and the router fans out on it; there is
// no address, no controller, and no external table to consult. The
// gate's uniqueness key is (endpoint_id, event_type_mask): two
// subscriptions on the same endpoint for the same mask would install
// the same event twice at the same endpoint, so `hid_event_find_by_
// pair` refuses that with `HID_EVT_MINT_IN_USE`. Two subscriptions
// on the SAME endpoint for DIFFERENT masks are legal -- a subscriber
// that wants keys and touch separately does so with two rows.
//
// =============================================================================
// §3  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
//   * NOTHING ROUTES AN EVENT. Routing is R32.M4's; this kind is the
//     record of a subscription that a router will consult.
//   * NOTHING NARROWS OR WIDENS A MASK. The mask is set once at
//     mint, and there is no primitive that changes it. Unlike
//     KIND_EC_QUERY's monotone-narrowing bitmap, whose in-place
//     narrowing exists so a subscriber can drop interest in a
//     specific query byte, HID event classes are coarse-grained
//     enough (four classes) that the natural discipline is "one
//     subscription per class combination the subscriber wants".
//   * NOTHING VALIDATES A REPORT DESCRIPTOR OR A REPORT BYTE. That is
//     the HID class driver's, and it holds KIND_HID_DEVICE (#1125),
//     not this kind.
//
// =============================================================================
// §4  ENUMERATIONS: EVENT TYPE MASK BITS
// =============================================================================
//
//   HID_EVT_KEY     0x01   keyboard / keypad / consumer keys
//   HID_EVT_POINTER 0x02   mouse / trackpoint / touchpad motion
//   HID_EVT_TOUCH   0x04   touchscreen contacts
//   HID_EVT_SENSOR  0x08   orientation, ambient light, hall effect
//   HID_EVT_MASK_ALL 0x0F  a supervisor that wants everything
//
// The four bits are the four subscriber shapes the R32 substrate
// exists for. A future R32.M4+ class (biometrics, ancillary controls)
// takes the next free bit and adds itself to MASK_ALL in the same
// commit that adds a router bit for it -- the mask validator refuses
// any bit outside MASK_ALL, so a future class cannot silently
// activate an old row.
//
// =============================================================================
// §5  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// This module contains no `in`/`out` and no firmware-bytecode
// identifier. `tools/lint-no-kernel-aml.sh` refuses any kernel
// identifier matching `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`,
// `\_SB_` or `\_SB.`. KIND_HID_EVENT, hid_event_* and
// _hid_event_table match none of the six.
//
// =============================================================================

module KindHidEvent = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_HID_EVENT        : u64 = 0x15c  // derived-kind tag (348)
  pub let HID_EVENT_PARENT_KIND : u64 = 5      // = KIND_IPC_ENDPOINT

  // ==========================================================================
  // §4 event type mask bits.
  // ==========================================================================

  pub let HID_EVT_KEY      : u64 = 0x01
  pub let HID_EVT_POINTER  : u64 = 0x02
  pub let HID_EVT_TOUCH    : u64 = 0x04
  pub let HID_EVT_SENSOR   : u64 = 0x08
  pub let HID_EVT_MASK_ALL : u64 = 0x0F

  // ==========================================================================
  // Rights.
  //
  // R_HID_EVENT_READ / _REPORT / _INVOKE / _REVOKE / _OBSERVE.
  // RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf.
  // Nothing in the tree derives from a subscription.
  // ==========================================================================

  pub let R_HID_EVENT_READ    : u64 = 0x001
  pub let R_HID_EVENT_REPORT  : u64 = 0x002
  pub let R_HID_EVENT_INVOKE  : u64 = 0x008
  pub let R_HID_EVENT_REVOKE  : u64 = 0x010
  pub let R_HID_EVENT_OBSERVE : u64 = 0x400
  pub let R_HID_EVENT_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each requires.
  //
  //   0 QUERY_CHANNEL  INVOKE   the row's own event_channel_key
  //   1 QUERY_MASK     INVOKE   event_type_mask
  //   2 QUERY_PID      INVOKE   subscriber_pid
  //   3 QUERY_PARENT   INVOKE   parent KIND_IPC_ENDPOINT slot
  //   4 DEBUG_PRINT    OBSERVE  canonical row dump
  //
  // No REPORT op: this kind is a subscription record, and delivery is
  // R32.M4's router (§3). No SUBSCRIBE / UNSUBSCRIBE op either: the
  // mask is set once at mint and never changes (§3).
  //
  // Every op takes NO OPERAND. The whole op_arg field beyond the low
  // byte is REFUSED with HID_EVT_TAIL_BAD_ARG rather than masked, for
  // the reason KIND_BACKLIGHT's REPORT reserved is refused rather
  // than masked: reserved bits on a capability-invocation op are
  // where a future field would appear, and admitting them silently
  // now would make it impossible to add one later without breaking
  // callers who had been passing garbage.
  // ==========================================================================

  pub let HID_EVT_OP_QUERY_CHANNEL : u64 = 0
  pub let HID_EVT_OP_QUERY_MASK    : u64 = 1
  pub let HID_EVT_OP_QUERY_PID     : u64 = 2
  pub let HID_EVT_OP_QUERY_PARENT  : u64 = 3
  pub let HID_EVT_OP_DEBUG_PRINT   : u64 = 4
  pub let HID_EVT_OP_MAX           : u64 = 4

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE90..0xFFFFFE9F.
  //
  // Sixteen-wide, disjoint from KIND_HID_DEVICE (0xFFFFFE80..8F),
  // KIND_BACKLIGHT (0xFFFFFE70..7F), KIND_COOLING_DEVICE
  // (0xFFFFFE50..5F), KIND_BATTERY (0xFFFFFE40..4F),
  // KIND_THERMAL_ZONE (0xFFFFFE30..3F), owner (0xFFFFFE2B..2F),
  // thermal policy (0xFFFFFE20..2A), KIND_FW_SESSION
  // (0xFFFFFE10..1F), KIND_EC_QUERY (0xFFFFFE00..0F) and
  // battery_monitor (0xFFFFFE60..6F). Disjointness is what lets a
  // u64 threaded up through the mint, the row allocator and the
  // dispatch handler still name the gate that refused it.
  // ==========================================================================

  pub let HID_EVT_OK                 : u64 = 0
  pub let HID_EVT_TAIL_ENOSPC        : u64 = 0xFFFFFE9F
  pub let HID_EVT_TAIL_BAD_ARG       : u64 = 0xFFFFFE9E
  pub let HID_EVT_MINT_BAD_PARENT    : u64 = 0xFFFFFE9D
  pub let HID_EVT_MINT_BAD_RIGHTS    : u64 = 0xFFFFFE9C
  pub let HID_EVT_MINT_BAD_MASK      : u64 = 0xFFFFFE9B
  pub let HID_EVT_MINT_BAD_PID       : u64 = 0xFFFFFE9A
  pub let HID_EVT_MINT_BAD_EID       : u64 = 0xFFFFFE99
  pub let HID_EVT_MINT_ENOSPC        : u64 = 0xFFFFFE98
  pub let HID_EVT_MINT_IN_USE        : u64 = 0xFFFFFE97
  pub let HID_EVT_BAD_SLOT           : u64 = 0xFFFFFE96
  pub let HID_EVT_WRONG_KIND         : u64 = 0xFFFFFE95
  pub let HID_EVT_REVOKE_ALREADY     : u64 = 0xFFFFFE94

  // The decoders' contract for a dead or out-of-range row.
  pub let HID_EVT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // `hid_event_find_by_pair`'s "no row holds this (endpoint, mask)".
  // 0xFF rather than 0, because row 0 is a legitimate answer.
  pub let HID_EVT_ROW_NONE : u64 = 0xFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // EIGHT ROWS, sized by CONCURRENT HID SUBSCRIBERS a T14 G4 boot
  // reasonably hosts. Per-subscriber, per-mask combination: a WM
  // wanting keys AND touch counts as two rows, a security service
  // wanting sensor for lid state counts as one. Eight covers a
  // supervisor plus a compositor plus two class-driver monitors
  // plus room to spare.
  //
  // Sixty-four bytes per row so the index is a `shl 6`; paideia-as
  // has no `mul`.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot  cap_table slot of the parent
  //                                     KIND_IPC_ENDPOINT at mint;
  //                                     audit and query only
  //           bits [55:16] reserved, must be zero
  //           bits [63:56] in_use       allocator flag
  //   [+8]  event_channel_key  INHERITED from the parent descriptor's
  //                            target_ptr[15:0]. Non-zero. The
  //                            endpoint the router will deliver on.
  //   [+16] event_type_mask    u32; (mask & HID_EVT_MASK_ALL) == mask
  //                            and mask != 0. Widened bits refused.
  //   [+24] subscriber_pid     u32; non-zero. The recipient a router
  //                            will name in a delivered event's
  //                            accounting.
  //   [+32] reserved, zero
  //   [+40] reserved, zero
  //   [+48] reserved, zero
  //   [+56] reserved, zero
  //
  // `tools/build.sh` asserts by `objdump -r` that no object other
  // than `core/cap/kind_hid_event.o` relocates against
  // `_hid_event_table`. The table is the only place in the kernel
  // where a subscription's (endpoint, mask, pid) triple lives, and a
  // second writer could install a subscription with no gate involved
  // and no audit record.
  // ==========================================================================

  pub let HID_EVT_MAX       : u64 = 8
  pub let HID_EVT_ROW_BYTES : u64 = 64

  pub let mut _hid_event_table : [u64; 64] = uninit @align(64)

  // Counters. Deliberately outside the row so a diagnostic about the
  // subscription-mint pipeline survives revocation.
  pub let mut _hid_event_stats : [u64; 8] = uninit @align(64)

  pub let HID_EVT_ST_MINTS  : u64 = 0
  pub let HID_EVT_ST_MAX    : u64 = 8

  // Local klog keys and tags.
  pub let hide_dbg_msg : [u8; 15] = "HID EVT ROW\n\0\0\0"
  pub let hide_k_row   : [u8; 4]  = "row\0"
  pub let hide_k_eid   : [u8; 4]  = "eid\0"
  pub let hide_k_msk   : [u8; 5]  = "mask\0"
  pub let hide_k_pid   : [u8; 4]  = "pid\0"

  // ==========================================================================
  // hid_event_table_reset() -> ()
  // ==========================================================================

  pub let hid_event_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring the reset shape every derived kind in this family uses: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Bounded by immediate compares, 64 iterations for the row table and 8 for the counters. Leaf. Labels prefixed hide_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _hid_event_table];
        xor rax, rax;
        xor rcx, rcx;
      hide_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  hide_rs_rows;

        lea r10, [rip + _hid_event_stats];
        xor rcx, rcx;
      hide_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hide_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_mask_valid(mask) -> 1 | 0
  // ==========================================================================

  pub let hid_event_mask_valid : (u64) -> u64 !{} @{} =
    fn (mask: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-002 (#1126): 1 iff (mask & HID_EVT_MASK_ALL) == mask AND mask != 0. Subset test with a non-zero requirement. Refuses zero because the mask is set once and never narrowed (§3): a zero mask at mint would be a subscription that received nothing forever while looking perfectly registered. Refuses any bit outside MASK_ALL because a future class takes the next free bit and adds itself to MASK_ALL in the same commit that adds a router bit for it -- admitting an unknown bit today would make it impossible to add that class later without silently activating existing rows. Pure leaf. Labels prefixed hide_mv_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  hide_mv_no;
        mov rax, rdi;
        mov r10, 0x0F;                   // HID_EVT_MASK_ALL
        and rax, r10;
        cmp rax, rdi;
        jne hide_mv_no;
        mov rax, 1;
        ret;
      hide_mv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_note(which) -> ()
  // hid_event_stat(which) -> count
  // ==========================================================================

  pub let hid_event_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): increment one counter; silent no-op on out-of-range. Same shape as backlight_note / cooling_note: every caller inside this module passes a constant, and the bound is here so the array cannot be walked past if that ever stops being true. Leaf. Labels prefixed hide_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_EVT_ST_MAX
        jae hide_nt_out;
        lea r10, [rip + _hid_event_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hide_nt_out:
        ret
      }
    } @no_frame

  pub let hid_event_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): bounds-checked read of one counter; out of range returns 0. Leaf. Labels prefixed hide_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_EVT_ST_MAX
        jae hide_st_zero;
        lea r10, [rip + _hid_event_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hide_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let hid_event_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-002 (#1126): 1 iff (rights & R_HID_EVENT_ALL) == rights. R_HID_EVENT_ALL = 0x41B. Subset test, RIGHT_MINT (0x200) outside the mask because this kind is a leaf of the lattice. Pure leaf. Labels prefixed hide_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;                  // R_HID_EVENT_ALL
        and rax, r10;
        cmp rax, rdi;
        jne hide_rv_no;
        mov rax, 1;
        ret;
      hide_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_check_parent_endpoint(parent_slot) -> 1 | 0
  //
  // §2. THE FIRST HALF of the derivation gate. Necessary and, by
  // itself, empty.
  // ==========================================================================

  pub let hid_event_check_parent_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): first half of the derivation gate. Bounds-check parent_slot < 256 BEFORE any address arithmetic so an unbounded slot cannot read outside cap_table; descriptor at cap_table + slot*8 + slot*16 (stride 24 per cap/mint.pdx); require kind ([+0]) == 5 (KIND_IPC_ENDPOINT) AND rights ([+8]) carrying RIGHT_MINT (0x200). Both conditions: the kind establishes the caller holds an endpoint, MINT establishes it was authorised to hand reach to that endpoint onward. THIS PREDICATE DISCRIMINATES ALMOST NOTHING ON ITS OWN and is not meant to -- every endpoint in the machine is kind 5, the shell's stdout included -- which is why hid_event_cap_mint_inner refuses unless the SECOND half (a well-formed non-zero mask and pid, together with an inherited endpoint id that is not the fabricated-parent sentinel 0) also passes. It is a separate function rather than four inline instructions so the two halves are separately mutable and separately witnessed: a corpus that can fail one and pass the other is what proves neither is doing the other's work. Same shape as ec_query_check_parent_endpoint and fw_session_check_parent_endpoint. Pure read. Labels prefixed hide_cpe_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae hide_cpe_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 5;                      // KIND_IPC_ENDPOINT
        cmp r10, r11;
        jne hide_cpe_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  hide_cpe_no;

        mov rax, 1;
        ret;

      hide_cpe_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_parent_eid(parent_slot) -> endpoint_id | 0
  // ==========================================================================

  pub let hid_event_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): read the parent KIND_IPC_ENDPOINT descriptor's endpoint id -- target_ptr bits [15:0], the encoding cap/kind_endpoint.pdx's endpoint_tail_pack writes. THIS IS THE ONLY SOURCE OF A SUBSCRIPTION'S CHANNEL IDENTITY: the mint has no endpoint argument, so the endpoint a subscription will deliver on is the endpoint its parent capability names and no other. A mint that took the id as an argument would let a holder attach one endpoint's identity to a different endpoint's row -- and every routed HID event thereafter would be confidently wrong about where the delivery landed. That is the discipline #1070 established for KIND_I2C_BUS, #1083 for KIND_FW_SESSION, and #1090 for KIND_EC_QUERY. The kind is re-checked here rather than trusted from the gate, because this function turns a slot number into the IDENTITY EVERY ROUTED RECORD WILL CARRY, and a caller that reached it by another path must not get an id out of an unrelated descriptor. Returns 0 for a bad slot or a non-KIND_IPC_ENDPOINT descriptor; 0 is also what hid_event_cap_mint_inner refuses outright, so a fabricated parent degrades into a counted refusal rather than a plausible identity. Pure read. Labels prefixed hide_pei_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae hide_pei_zero;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 5;                      // KIND_IPC_ENDPOINT
        cmp r10, r11;
        jne hide_pei_zero;

        mov rax, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and rax, r11;                    // endpoint_id [15:0]
        ret;

      hide_pei_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_hdr_pack(parent_slot) -> hdr | HID_EVT_DECODE_BAD
  // ==========================================================================

  pub let hid_event_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-002 (#1126): canonical header-word encoder. Validates parent_slot < 256 then packs (parent_slot << 8), leaving bits [7:0], [55:16] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero: a header arriving with in_use pre-set would hand back a row the free scan skips forever, leaking a subscription record whose endpoint identity outlives its capability. Pure leaf. Labels prefixed hide_hp_ per reserved-label discipline.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae hide_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        ret;

      hide_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hid_event_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-002 (#1126): parent_slot from header bits [15:8]. Named accessor rather than a shift at each call site. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    } @no_frame

  // ==========================================================================
  // hid_event_tail_alloc(hdr, event_channel_key, event_type_mask,
  //                      subscriber_pid) -> row_id | HID_EVT_TAIL_*
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A HID EVENT SUBSCRIPTION.
  // ==========================================================================

  pub let hid_event_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (event_channel_key: u64) (event_type_mask: u64) (subscriber_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A HID EVENT SUBSCRIPTION, which is why tools/build.sh confines relocations against _hid_event_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (the allocator's in_use flag); hdr reserved bits [7:0] or [55:16] non-zero -> TAIL_BAD_ARG; event_channel_key == 0 -> TAIL_BAD_ARG (0 is hid_event_parent_eid's refusal value and kind_endpoint's unallocated sentinel); mask == 0 OR (mask & ~HID_EVT_MASK_ALL) != 0 -> TAIL_BAD_ARG (see §0/§4 for why a zero mask and a superset mask are both refused); subscriber_pid == 0 -> TAIL_BAD_ARG (the reserved 'no process' pid; a subscription owned by nobody would confuse the owner-column sweep). ALSO: subscriber_pid >= 2^32 -> TAIL_BAD_ARG (the field is a u32; a value that overflows is a caller who thought a field was wider than it is). THE VALIDATIONS ARE HERE AS WELL AS IN THE MINT, deliberately: the mint's versions produce specific codes an installer needs (MINT_BAD_MASK / MINT_BAD_PID / MINT_BAD_EID), while this makes it impossible for ANY future second caller of the allocator to create a row without them. Low-first scan over 8 rows of 64 bytes, free iff byte 7 of [row+0] is zero. Claim writes all eight words, so a reused row cannot inherit the previous subscription's endpoint identity or mask. Four pushes plus rbp leave rsp%16 == 0 at every nested call site (there are none in this leaf). Labels prefixed hide_ta_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // event_channel_key
        mov r14, rdx;                    // event_type_mask
        // subscriber_pid stays in rcx

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne hide_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne hide_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits [55:16]
        and rax, r10;
        cmp rax, 0;
        jne hide_ta_bad;

        cmp r13, 0;
        je  hide_ta_bad;

        // mask non-zero and within HID_EVT_MASK_ALL.
        cmp r14, 0;
        je  hide_ta_bad;
        mov rax, r14;
        mov r10, 0x0F;                   // HID_EVT_MASK_ALL
        and rax, r10;
        cmp rax, r14;
        jne hide_ta_bad;

        // subscriber_pid non-zero.
        cmp rcx, 0;
        je  hide_ta_bad;
        // subscriber_pid fits in u32.
        mov rax, rcx;
        shr rax, 32;
        cmp rax, 0;
        jne hide_ta_bad;

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      hide_ta_scan:
        cmp rbx, 8;                      // HID_EVT_MAX
        jae hide_ta_enospc;

        lea r10, [rip + _hid_event_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hide_ta_claim;

        add rbx, 1;
        jmp hide_ta_scan;

      hide_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // event_channel_key
        mov [r10 + 16], r14;             // event_type_mask
        mov [r10 + 24], rcx;             // subscriber_pid
        xor rax, rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov rax, rbx;
        jmp hide_ta_out;

      hide_ta_enospc:
        mov rax, 0xFFFFFE9F;             // HID_EVT_TAIL_ENOSPC
        jmp hide_ta_out;
      hide_ta_bad:
        mov rax, 0xFFFFFE9E;             // HID_EVT_TAIL_BAD_ARG

      hide_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hid_event_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): 1 iff row_id < HID_EVT_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers HID_EVT_DECODE_BAD rather than the zeroes it was scrubbed to. Leaf. Labels prefixed hide_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_EVT_MAX
        jae hide_tv_no;
        lea r10, [rip + _hid_event_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hide_tv_no;
        mov rax, 1;
        ret;
      hide_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hid_event_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): scrub one row to zero, which clears in_use and returns it to the free scan. ALL EIGHT WORDS, including the endpoint identity, mask and pid. A revoke is the point at which the subscriber has decided this delivery contract no longer applies, and a row that kept its endpoint identity across a re-mint would let one subscriber's row be reused by another for a completely different (endpoint, mask) pair -- and, worse, would let a subscription outlive its subscriber (the pid field would still read the dead process's pid, and an owner-column sweep would not find the row because it was scrubbed to zero). Scrubbing the PAIR is what makes the (endpoint, mask) combination re-mintable. No-op on an out-of-range row. Leaf. Labels prefixed hide_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_EVT_MAX
        jae hide_tf_out;
        lea r10, [rip + _hid_event_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      hide_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors. Every one returns HID_EVT_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let hid_event_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): raw header word of a live row, or HID_EVT_DECODE_BAD. Labels prefixed hide_rh_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_event_tail_valid;
        cmp rax, 0;
        je  hide_rh_bad;
        lea r10, [rip + _hid_event_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp hide_rh_out;
      hide_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_rh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_event_row_channel : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): inherited endpoint id of a live row, or HID_EVT_DECODE_BAD. This is the field a future router will use to name the delivery endpoint; never accepted as an argument anywhere -- it is inherited at mint from the parent endpoint and only read thereafter. Labels prefixed hide_rc_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_event_tail_valid;
        cmp rax, 0;
        je  hide_rc_bad;
        lea r10, [rip + _hid_event_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp hide_rc_out;
      hide_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_rc_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_event_row_mask : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): event_type_mask of a live row, or HID_EVT_DECODE_BAD. Read-only. The mask is set once at mint and there is no primitive that changes it -- see §3 for why coarse-grained event classes do not warrant an in-place narrowing op. Labels prefixed hide_rm_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_event_tail_valid;
        cmp rax, 0;
        je  hide_rm_bad;
        lea r10, [rip + _hid_event_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp hide_rm_out;
      hide_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_rm_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_event_row_pid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): subscriber_pid of a live row, or HID_EVT_DECODE_BAD. Labels prefixed hide_rp_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_event_tail_valid;
        cmp rax, 0;
        je  hide_rp_bad;
        lea r10, [rip + _hid_event_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp hide_rp_out;
      hide_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_rp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_event_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): parent KIND_IPC_ENDPOINT slot recorded at mint, or HID_EVT_DECODE_BAD. Audit and query only. Labels prefixed hide_rpa_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_event_row_hdr;
        mov r13, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  hide_rpa_bad;
        mov rdi, r13;
        call hid_event_hdr_parent;
        jmp hide_rpa_out;
      hide_rpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_rpa_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hid_event_find_by_pair(endpoint_key, mask) -> row_id | HID_EVT_ROW_NONE
  // ==========================================================================

  pub let hid_event_find_by_pair : (u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_key: u64, mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-002 (#1126): the live row holding this (endpoint, mask) pair, or HID_EVT_ROW_NONE (0xFF). Linear scan over 8 rows. THE UNIQUENESS TEST §2's second gate needs: two subscriptions on the same endpoint for the same mask would install the same event twice at the same endpoint. Two subscriptions on the SAME endpoint for DIFFERENT masks are legal -- a subscriber that wants keys and touch separately does so with two rows -- so the KEY IS THE PAIR, not the endpoint alone. Refuses to match an endpoint_key of 0 at all, so a fabricated parent cannot collide with the sentinel hid_event_parent_eid returns for a bad slot. Sentinel is 0xFF because row 0 is a legitimate answer. Leaf. Labels prefixed hide_fp_.",
      block: {
        cmp rdi, 0;
        je  hide_fp_none;
        xor rcx, rcx;
      hide_fp_scan:
        cmp rcx, 8;                      // HID_EVT_MAX
        jae hide_fp_none;
        lea r10, [rip + _hid_event_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hide_fp_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        jne hide_fp_next;
        mov rax, [r10 + 16];
        cmp rax, rsi;
        je  hide_fp_hit;
      hide_fp_next:
        add rcx, 1;
        jmp hide_fp_scan;
      hide_fp_hit:
        mov rax, rcx;
        ret;
      hide_fp_none:
        mov rax, 0xFF;                   // HID_EVT_ROW_NONE
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_row_of_slot(slot) -> row_id | HID_EVT_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let hid_event_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): slot -> row_id, gated on the descriptor being a live KIND_HID_EVENT. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A SUBSCRIPTION ROW, and ARITY ONE. Returns HID_EVT_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Pure read. Labels prefixed hide_ros_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae hide_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x15c;                  // KIND_HID_EVENT
        cmp r10, r11;
        jne hide_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call hid_event_tail_valid;
        cmp rax, 0;
        je  hide_ros_none;

        mov rax, r12;
        jmp hide_ros_out;

      hide_ros_none:
        mov rax, 0xFF;                   // HID_EVT_ROW_NONE
      hide_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Slot-arity-one resolvers.
  // ==========================================================================

  pub let hid_event_channel_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): endpoint id of the subscription this capability names. ARITY ONE. Labels prefixed hide_cos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call hid_event_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  hide_cos_bad;
        mov rdi, r12;
        call hid_event_row_channel;
        jmp hide_cos_out;
      hide_cos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_cos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_event_mask_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): event_type_mask of the subscription this capability names, or HID_EVT_DECODE_BAD. ARITY ONE, pinned by tools/build.sh. A second parameter would be a caller-supplied mask that widens or narrows the row's own, and neither is a change this kind exposes. Labels prefixed hide_mos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call hid_event_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  hide_mos_bad;
        mov rdi, r12;
        call hid_event_row_mask;
        jmp hide_mos_out;
      hide_mos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_mos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_event_pid_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): subscriber_pid of the subscription this capability names, or HID_EVT_DECODE_BAD. ARITY ONE. Labels prefixed hide_pos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call hid_event_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  hide_pos_bad;
        mov rdi, r12;
        call hid_event_row_pid;
        jmp hide_pos_out;
      hide_pos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hide_pos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hid_event_cap_mint_inner(slot, parent_slot, rights,
  //                          event_type_mask, subscriber_pid)
  //   -> HID_EVT_OK | HID_EVT_MINT_*
  //
  // Five arguments, fits SysV six-register limit.
  // ==========================================================================

  pub let hid_event_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64, parent_slot: u64, rights: u64, event_type_mask: u64, subscriber_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): mint a KIND_HID_EVENT subscription over a KIND_IPC_ENDPOINT. Sequence: (1) slot < 256 else HID_EVT_BAD_SLOT. (2) hid_event_check_parent_endpoint(parent_slot) -- FIRST HALF, the empty gate -- else HID_EVT_MINT_BAD_PARENT. (3) hid_event_rights_valid(rights) else HID_EVT_MINT_BAD_RIGHTS. (4) hid_event_mask_valid(mask) -- refuses zero and any bit outside HID_EVT_MASK_ALL -- else HID_EVT_MINT_BAD_MASK. (5) subscriber_pid != 0 else HID_EVT_MINT_BAD_PID; subscriber_pid fits in u32 else HID_EVT_MINT_BAD_PID. (6) INHERIT the endpoint id via hid_event_parent_eid; zero -> HID_EVT_MINT_BAD_EID (fabricated parent, or a parent with kind != 5). (7) UNIQUENESS: hid_event_find_by_pair(endpoint, mask) must answer HID_EVT_ROW_NONE else HID_EVT_MINT_IN_USE. Two subscriptions on the same endpoint for the same mask would install the same event twice at the same endpoint. Same endpoint, DIFFERENT masks is legal and there are two rows. (8) hdr_pack(parent_slot) then tail_alloc -> HID_EVT_MINT_ENOSPC on exhaustion. (9) cap_mint_write(slot, KIND_HID_EVENT, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579. Neither the mask nor the pid is inherited: both are subscription decisions the subscriber makes. The endpoint IS inherited, for the reason ec_query does not accept an endpoint argument (§2). Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed hide_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // event_type_mask
        mov r15, r8;                     // subscriber_pid

        mov r10, 256;
        cmp rbx, r10;
        jae hide_mi_bad_slot;

        mov rdi, r12;
        call hid_event_check_parent_endpoint;
        cmp rax, 0;
        je  hide_mi_bad_parent;

        mov rdi, r13;
        call hid_event_rights_valid;
        cmp rax, 0;
        je  hide_mi_bad_rights;

        mov rdi, r14;
        call hid_event_mask_valid;
        cmp rax, 0;
        je  hide_mi_bad_mask;

        // subscriber_pid non-zero and fits in u32.
        cmp r15, 0;
        je  hide_mi_bad_pid;
        mov rax, r15;
        shr rax, 32;
        cmp rax, 0;
        jne hide_mi_bad_pid;

        // Inherit endpoint id.
        mov rdi, r12;
        call hid_event_parent_eid;
        cmp rax, 0;
        je  hide_mi_bad_eid;
        mov rcx, rax;                    // rcx = endpoint_key across the next call

        // Uniqueness check: hid_event_find_by_pair(endpoint_key, mask).
        push rcx;                        // save endpoint_key
        sub rsp, 8;                      // rsp%16 == 0 at call
        mov rdi, rcx;
        mov rsi, r14;                    // mask
        call hid_event_find_by_pair;
        add rsp, 8;
        pop rcx;                         // restore endpoint_key
        cmp rax, 0xFF;                   // HID_EVT_ROW_NONE
        jne hide_mi_in_use;

        // Pack header.
        push rcx;
        sub rsp, 8;
        mov rdi, r12;
        call hid_event_hdr_pack;
        add rsp, 8;
        pop rcx;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  hide_mi_bad_parent;

        // tail_alloc(hdr, event_channel_key, mask, pid).
        mov rdi, rax;                    // hdr
        mov rsi, rcx;                    // endpoint_key
        mov rdx, r14;                    // mask
        mov rcx, r15;                    // pid
        call hid_event_tail_alloc;

        mov r10, 0xFFFFFE9F;             // HID_EVT_TAIL_ENOSPC
        cmp rax, r10;
        je  hide_mi_enospc;
        mov r10, 0xFFFFFE9E;             // HID_EVT_TAIL_BAD_ARG
        cmp rax, r10;
        je  hide_mi_bad_mask;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x15c;                  // KIND_HID_EVENT
        mov rdx, r13;                    // rights
        mov rcx, r14;
        call cap_mint_write;

        // Count successful mints.
        mov rdi, 0;                      // HID_EVT_ST_MINTS
        call hid_event_note;

        xor rax, rax;                    // HID_EVT_OK
        jmp hide_mi_out;

      hide_mi_bad_slot:
        mov rax, 0xFFFFFE96;
        jmp hide_mi_out;
      hide_mi_bad_parent:
        mov rax, 0xFFFFFE9D;
        jmp hide_mi_out;
      hide_mi_bad_rights:
        mov rax, 0xFFFFFE9C;
        jmp hide_mi_out;
      hide_mi_bad_mask:
        mov rax, 0xFFFFFE9B;
        jmp hide_mi_out;
      hide_mi_bad_pid:
        mov rax, 0xFFFFFE9A;
        jmp hide_mi_out;
      hide_mi_bad_eid:
        mov rax, 0xFFFFFE99;
        jmp hide_mi_out;
      hide_mi_enospc:
        mov rax, 0xFFFFFE98;
        jmp hide_mi_out;
      hide_mi_in_use:
        mov rax, 0xFFFFFE97;

      hide_mi_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hid_event_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64, parent_slot: u64, rights: u64, event_type_mask: u64, subscriber_pid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): audited entry point. Same wrapper shape as ec_query_cap_mint / fw_session_cap_mint. Putting emission in the wrapper means a second mint path cannot exist without being audited. The PRINCIPAL recorded is the parent endpoint slot: even though it decides nothing on its own (§2), it is the only authority the subscriber can be said to have derived from. Three pushes leave rsp%16 == 0 at both nested calls. Labels prefixed hide_mw_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent endpoint)

        call hid_event_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x15c;                  // KIND_HID_EVENT
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hid_event_cap_revoke_inner(slot) -> HID_EVT_OK | ...
  // ==========================================================================

  pub let hid_event_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): revoke a KIND_HID_EVENT subscription. (1) slot < 256 -> HID_EVT_BAD_SLOT. (2) kind == 0 -> HID_EVT_REVOKE_ALREADY. (3) kind != 0x15c -> HID_EVT_WRONG_KIND. (4) row_id from target_ptr[15:0]; if live, hid_event_tail_free scrubs it. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0) per #1579. Nothing routes an event, so a revoke leaves nothing to unbind in a router; when R32.M4 lands the router, its owner-column path is what tears down any transient delivery state, not this function. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed hide_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae hide_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  hide_rvk_already;

        mov r11, 0x15c;                  // KIND_HID_EVENT
        cmp r10, r11;
        jne hide_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call hid_event_tail_valid;
        cmp rax, 0;
        je  hide_rvk_clear;

        mov rdi, r13;
        call hid_event_tail_free;

      hide_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // HID_EVT_OK
        jmp hide_rvk_out;

      hide_rvk_bad_slot:
        mov rax, 0xFFFFFE96;
        jmp hide_rvk_out;
      hide_rvk_wrong_kind:
        mov rax, 0xFFFFFE95;
        jmp hide_rvk_out;
      hide_rvk_already:
        mov rax, 0xFFFFFE94;

      hide_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hid_event_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS. NO cascade: nothing in this tree derives from a subscription. Three pushes leave rsp%16 == 0 at both nested calls. Labels prefixed hide_rw_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call hid_event_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x15c;                  // KIND_HID_EVENT
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hid_event_debug_print(row_id) -> HID_EVT_OK | HID_EVT_TAIL_BAD_ARG
  // ==========================================================================

  pub let hid_event_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R32.M3-002 (#1126): canonical printer for one subscription row. Refuses a dead or out-of-range row with HID_EVT_TAIL_BAD_ARG rather than printing zeroes: a freed row renders as {eid 0, mask 0, pid 0}, which is a plausible-looking subscription that no router could satisfy -- and, worse, no owner-column sweep could clean up (pid 0 is the reserved 'no process' pid). Four KV lines. r12 holds row_id across the calls; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed hide_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call hid_event_tail_valid;
        cmp rax, 0;
        je  hide_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hide_dbg_msg];
        lea rcx, [rip + hide_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call hid_event_row_channel;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hide_dbg_msg];
        lea rcx, [rip + hide_k_eid];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call hid_event_row_mask;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hide_dbg_msg];
        lea rcx, [rip + hide_k_msk];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call hid_event_row_pid;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hide_dbg_msg];
        lea rcx, [rip + hide_k_pid];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // HID_EVT_OK
        jmp hide_dp_out;

      hide_dp_bad:
        mov rax, 0xFFFFFE9E;             // HID_EVT_TAIL_BAD_ARG

      hide_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_hid_event(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_hid_event : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M3-002 (#1126): KIND_HID_EVENT dispatch handler. Emits cap_hid_event_msg on entry. row_id = target_ptr[15:0], op = op_arg[7:0]. RIGHTS PER OP: QUERY_CHANNEL / QUERY_MASK / QUERY_PID / QUERY_PARENT require R_HID_EVENT_INVOKE; DEBUG_PRINT requires R_HID_EVENT_OBSERVE. NO OPERAND FIELDS: every op takes op_arg = op only. op_arg[63:8] MUST be zero -- refused with HID_EVT_TAIL_BAD_ARG rather than masked, because reserved bits on an invocation op are where a future field would appear, and admitting them silently now would make it impossible to add one later. Unknown op -> INVOKE_UNSUPPORTED; rights failure -> INVOKE_DENIED. Every query returns HID_EVT_DECODE_BAD for a dead row and never a plausible zero. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed hide_h_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hid_event_msg];
        call klog_s1;

        // Decode op and reserved.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov r11, r14;
        shr r11, 8;                      // reserved bits [63:8]
        mov r14, r10;                    // r14 = op

        cmp r14, 4;                      // HID_EVT_OP_MAX
        ja  hide_h_unsup;

        // Every op takes NO operand -- refuse non-zero reserved.
        cmp r11, 0;
        jne hide_h_res;

        cmp r14, 4;                      // DEBUG_PRINT
        je  hide_h_dbg;

        // Ops 0..3: INVOKE.
        mov r10, r12;
        and r10, 0x008;                  // R_HID_EVENT_INVOKE
        cmp r10, 0;
        je  hide_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  hide_h_ch;
        cmp r14, 1;
        je  hide_h_msk;
        cmp r14, 2;
        je  hide_h_pd;
        call hid_event_row_parent;
        jmp hide_h_out;

      hide_h_ch:
        call hid_event_row_channel;
        jmp hide_h_out;
      hide_h_msk:
        call hid_event_row_mask;
        jmp hide_h_out;
      hide_h_pd:
        call hid_event_row_pid;
        jmp hide_h_out;

      hide_h_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_HID_EVENT_OBSERVE
        cmp r10, 0;
        je  hide_h_denied;
        mov rdi, r13;
        call hid_event_debug_print;
        jmp hide_h_out;

      hide_h_res:
        mov rax, 0xFFFFFE9E;             // HID_EVT_TAIL_BAD_ARG
        jmp hide_h_out;
      hide_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp hide_h_out;
      hide_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      hide_h_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
