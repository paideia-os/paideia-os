// src/kernel/core/cap/kind_vk_surface.pdx -- G3.M1-001 (#1457)
//
// KIND_VK_SURFACE = 0x189, derived over KIND_IPC_ENDPOINT (5).
//
// One Vulkan WSI (Window System Integration) surface. In a hosted
// stack this is what vkCreateXxxSurfaceKHR would return; in paideia
// it is the RPC endpoint through which a client asks the compositor
// for a swapchain over ONE named KIND_DISPLAY_OUTPUT. The surface is
// not the swapchain -- it is the authority under which a swapchain
// may be minted.
//
// =============================================================================
// SECTION 0  WHAT THIS KIND EXISTS FOR
// =============================================================================
//
// A hosted Vulkan stack conflates two authorities in one object: the
// right to speak to the compositor about ONE window, and the right
// to receive presentation events on it. That conflation is what
// lets a compromised swapchain leak presentation timing to a peer.
// paideia splits them: KIND_VK_SURFACE names the conversation, and
// derived KIND_VK_SWAPCHAIN_IMAGE handles name the individual
// buffers a swapchain rotates through. The surface's role is to
// AUTHORIZE swapchain mints against the output it names -- nothing
// more.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The kind half of the gate is EMPTY on its own -- every endpoint
// in the system is a KIND_IPC_ENDPOINT, the shell's stdout
// included. The mint's second half is a validated non-zero
// surface_key, an output_slot naming a live KIND_DISPLAY_OUTPUT
// (0x170), a validated pixel format, non-zero extent, a fractional
// scale factor (P3 acceptance -- see G3.M3-005 #1441 and
// drivers/vk/features.pdx), and an INHERITED endpoint id read
// from the parent's target_ptr[15:0] (endpoint_tail_pack).
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header: in_use[63:56] | parent_slot[15:8]
//   [+8]  surface_key (u64)
//   [+16] body1:  endpoint_id[15:0] | output_slot[31:16] | fmt[47:32]
//               | extent_w[63:48]
//   [+24] body2:  extent_h[15:0] | scale_num[31:16] | scale_den[47:32]
//               | flags[63:48]
//
// The fractional scale factor lives on the surface -- not on the
// swapchain -- because a compositor deciding whether to composite
// or scan out (G2) needs the scale before it hands out the swapchain
// image handles. P3 acceptance is enforced at mint time.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEE10..0xFFFFEE1F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind band.

module KindVkSurface = structure {

  pub let KIND_VK_SURFACE : u64 = 0x189
  pub let VKS_PARENT_KIND : u64 = 5                    // KIND_IPC_ENDPOINT
  pub let VKS_OUTPUT_KIND : u64 = 0x170                // KIND_DISPLAY_OUTPUT

  // Rights. R_MINT PRESENT -- KIND_VK_SWAPCHAIN_IMAGE derives.
  pub let R_VKS_READ    : u64 = 0x001
  pub let R_VKS_INVOKE  : u64 = 0x008
  pub let R_VKS_REVOKE  : u64 = 0x010
  pub let R_VKS_MINT    : u64 = 0x200
  pub let R_VKS_OBSERVE : u64 = 0x400
  pub let R_VKS_ALL     : u64 = 0x619

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED.
  pub let VKS_OP_QUERY_KEY      : u64 = 0
  pub let VKS_OP_QUERY_OUTPUT   : u64 = 1
  pub let VKS_OP_QUERY_FORMAT   : u64 = 2
  pub let VKS_OP_QUERY_EXTENT_W : u64 = 3
  pub let VKS_OP_QUERY_EXTENT_H : u64 = 4
  pub let VKS_OP_QUERY_SCALE_N  : u64 = 5
  pub let VKS_OP_QUERY_SCALE_D  : u64 = 6
  pub let VKS_OP_DEBUG_PRINT    : u64 = 7
  pub let VKS_OP_MAX            : u64 = 7

  // Failure taxonomy -- 0xFFFFEE10..0xFFFFEE1F.
  pub let VKS_OK               : u64 = 0
  pub let VKS_TAIL_ENOSPC      : u64 = 0xFFFFEE1F
  pub let VKS_TAIL_BAD_ARG     : u64 = 0xFFFFEE1E
  pub let VKS_MINT_BAD_PARENT  : u64 = 0xFFFFEE1D
  pub let VKS_MINT_BAD_RIGHTS  : u64 = 0xFFFFEE1C
  pub let VKS_MINT_BAD_OUTPUT  : u64 = 0xFFFFEE1B
  pub let VKS_MINT_BAD_FMT     : u64 = 0xFFFFEE1A
  pub let VKS_MINT_BAD_EXTENT  : u64 = 0xFFFFEE19
  pub let VKS_MINT_BAD_SCALE   : u64 = 0xFFFFEE18
  pub let VKS_MINT_NO_KEY      : u64 = 0xFFFFEE17
  pub let VKS_MINT_ENOSPC      : u64 = 0xFFFFEE16
  pub let VKS_MINT_IN_USE      : u64 = 0xFFFFEE15
  pub let VKS_BAD_SLOT         : u64 = 0xFFFFEE14
  pub let VKS_WRONG_KIND       : u64 = 0xFFFFEE13
  pub let VKS_REVOKE_ALREADY   : u64 = 0xFFFFEE12

  pub let VKS_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let VKS_ROW_NONE   : u64 = 0xFF

  pub let VKS_MAX       : u64 = 8
  pub let VKS_ROW_BYTES : u64 = 32

  // Pixel formats -- narrow subset the swapchain supports at G3.
  pub let VKS_FMT_B8G8R8A8_UNORM : u64 = 1
  pub let VKS_FMT_R8G8B8A8_UNORM : u64 = 2
  pub let VKS_FMT_A2R10G10B10    : u64 = 3
  pub let VKS_FMT_R16G16B16A16_F : u64 = 4
  pub let VKS_FMT_MAX            : u64 = 4

  // Extent ceiling. 8K-plus headroom without letting a bad
  // extent alias a negative extent.
  pub let VKS_EXTENT_MAX : u64 = 16384

  // Scale factor. numerator / denominator, both u16, both > 0.
  // 1/1 is unscaled; 3/2 is 150% (a real T14 fractional case).
  pub let VKS_SCALE_MAX : u64 = 65535

  // THE ONE STATE CELL. Confined by tools/build.sh.
  pub let mut _vk_surface_table : [u64; 32] = uninit @align(64)
  pub let mut _vk_surface_stats : [u64; 4]  = uninit @align(64)

  pub let VKS_ST_MINTS   : u64 = 0
  pub let VKS_ST_REVOKES : u64 = 1
  pub let VKS_ST_REFUSED : u64 = 2
  pub let VKS_ST_QUERIES : u64 = 3

  pub let vks_dbg_msg : [u8; 16] = "VK SURFACE ROW\0\0"

  pub let vks_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): clear row table + counters. Labels prefixed vks_rs_.",
      block: {
        lea r10, [rip + _vk_surface_table];
        xor rax, rax;
        xor rcx, rcx;
      vks_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  vks_rs_rows;

        lea r10, [rip + _vk_surface_stats];
        xor rcx, rcx;
      vks_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vks_rs_stats;
        ret
      }
    }

  pub let vks_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): counter bump. Labels prefixed vks_nt_.",
      block: {
        cmp rdi, 4;
        jae vks_nt_out;
        lea r10, [rip + _vk_surface_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vks_nt_out:
        ret
      }
    }

  pub let vks_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): counter read.",
      block: {
        cmp rdi, 4;
        jae vks_st_zero;
        lea r10, [rip + _vk_surface_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vks_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vks_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-001 (#1457): subset test against R_VKS_ALL = 0x619. R_MINT (0x200) IN the mask.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne vks_rv_no;
        mov rax, 1;
        ret;
      vks_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vks_fmt_valid : (u64) -> u64 !{} @{} =
    fn (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-001 (#1457): 1 iff fmt in [1, VKS_FMT_MAX=4]. 0 refused.",
      block: {
        cmp rdi, 0;
        je  vks_fv_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  vks_fv_no;
        mov rax, 1;
        ret;
      vks_fv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vks_extent_valid : (u64, u64) -> u64 !{} @{} =
    fn (w: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-001 (#1457): 1 iff 0 < w <= VKS_EXTENT_MAX and same for h.",
      block: {
        cmp rdi, 0;
        je  vks_ev_no;
        mov r10, 16384;
        cmp rdi, r10;
        ja  vks_ev_no;
        cmp rsi, 0;
        je  vks_ev_no;
        cmp rsi, r10;
        ja  vks_ev_no;
        mov rax, 1;
        ret;
      vks_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let vks_scale_valid : (u64, u64) -> u64 !{} @{} =
    fn (num: u64) (den: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-001 (#1457) + G3.M3-005 (#1471): 1 iff 0 < num, den <= VKS_SCALE_MAX. Fractional scale as first-class geometry param (P3).",
      block: {
        cmp rdi, 0;
        je  vks_sv_no;
        mov r10, 65535;
        cmp rdi, r10;
        ja  vks_sv_no;
        cmp rsi, 0;
        je  vks_sv_no;
        cmp rsi, r10;
        ja  vks_sv_no;
        mov rax, 1;
        ret;
      vks_sv_no:
        xor rax, rax;
        ret
      }
    }

  // Row body pack helpers. body1: endpoint_id[15:0] |
  // output_slot[31:16] | fmt[47:32] | extent_w[63:48].
  pub let vks_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (eid: u64) (out_slot: u64) (fmt: u64) (w: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-001 (#1457): body1 pack. Refuses out-of-range fields.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vks_b1_bad;
        cmp rsi, r10;
        ja  vks_b1_bad;
        cmp rdx, r10;
        ja  vks_b1_bad;
        cmp rcx, r10;
        ja  vks_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      vks_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: extent_h[15:0] | scale_num[31:16] | scale_den[47:32]
  //      | flags[63:48].
  pub let vks_body2_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (h: u64) (snum: u64) (sden: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-001 (#1457): body2 pack. Refuses out-of-range fields.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vks_b2_bad;
        cmp rsi, r10;
        ja  vks_b2_bad;
        cmp rdx, r10;
        ja  vks_b2_bad;
        cmp rcx, r10;
        ja  vks_b2_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      vks_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vks_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-001 (#1457): (parent_slot << 8).",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vks_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      vks_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vks_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (surface_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): claim one VK_SURFACE row. THE ONE WRITER of _vk_surface_table.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne vks_ta_bad;
        cmp r13, 0;
        je  vks_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  vks_ta_bad;
        cmp r15, r10;
        je  vks_ta_bad;

        xor rbx, rbx;
      vks_ta_scan:
        cmp rbx, 8;
        jae vks_ta_enospc;
        lea r10, [rip + _vk_surface_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vks_ta_claim;
        add rbx, 1;
        jmp vks_ta_scan;

      vks_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp vks_ta_out;

      vks_ta_enospc:
        mov rax, 0xFFFFEE1F;
        jmp vks_ta_out;
      vks_ta_bad:
        mov rax, 0xFFFFEE1E;

      vks_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vks_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): 1 iff row_id < VKS_MAX and in_use.",
      block: {
        cmp rdi, 8;
        jae vks_tv_no;
        lea r10, [rip + _vk_surface_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vks_tv_no;
        mov rax, 1;
        ret;
      vks_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vks_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): scrub one row.",
      block: {
        cmp rdi, 8;
        jae vks_tf_out;
        lea r10, [rip + _vk_surface_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      vks_tf_out:
        ret
      }
    }

  pub let vks_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): surface_key at [+8].",
      block: {
        push r12;
        mov r12, rdi;
        call vks_tail_valid;
        cmp rax, 0;
        je  vks_rk_bad;
        lea r10, [rip + _vk_surface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp vks_rk_out;
      vks_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vks_rk_out:
        pop r12;
        ret
      }
    }

  pub let vks_row_output : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): output_slot at body1[31:16].",
      block: {
        push r12;
        mov r12, rdi;
        call vks_tail_valid;
        cmp rax, 0;
        je  vks_ro_bad;
        lea r10, [rip + _vk_surface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp vks_ro_out;
      vks_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vks_ro_out:
        pop r12;
        ret
      }
    }

  pub let vks_row_fmt : (u64) -> u64 !{mem} @{} =
