  pub let vks_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (surface_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-001 (#1457): live row holding this surface_key, or ROW_NONE.",
      block: {
        cmp rdi, 0;
        je  vks_fk_none;
        xor rcx, rcx;
      vks_fk_scan:
        cmp rcx, 8;
        jae vks_fk_none;
        lea r10, [rip + _vk_surface_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vks_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  vks_fk_hit;
      vks_fk_next:
        add rcx, 1;
        jmp vks_fk_scan;
      vks_fk_hit:
        mov rax, rcx;
        ret;
      vks_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let vks_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G3.M1-001 (#1457): slot -> row_id, gated on live KIND_VK_SURFACE.",
      block: {
        push r12;
        mov r11, 256;
        cmp rdi, r11;
        jae vks_ros_none;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x189;
        cmp r10, r11;
        jne vks_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call vks_tail_valid;
        cmp rax, 0;
        je  vks_ros_none;
        mov rax, r12;
        jmp vks_ros_out;
      vks_ros_none:
        mov rax, 0xFF;
      vks_ros_out:
        pop r12;
        ret
      }
    }

  pub let cap_handler_vk_surface : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G3.M1-001 (#1457): KIND_VK_SURFACE dispatch. QUERY ops all take NO OPERAND -- op_arg[63:8] REFUSED.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_vk_surface_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne vks_hn_res;

        cmp rbp, 7;
        ja  vks_hn_unsup;

        cmp rbp, 7;
        je  vks_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  vks_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  vks_hn_key;
        cmp rbp, 1;
        je  vks_hn_out_slot;
        cmp rbp, 2;
        je  vks_hn_fmt;
        cmp rbp, 3;
        je  vks_hn_ew;
        cmp rbp, 4;
        je  vks_hn_eh;
        cmp rbp, 5;
        je  vks_hn_sn;
        call vks_row_scale_den;
        jmp vks_hn_out;

      vks_hn_key:
        call vks_row_key;
        jmp vks_hn_out;
      vks_hn_out_slot:
        call vks_row_output;
        jmp vks_hn_out;
      vks_hn_fmt:
        call vks_row_fmt;
        jmp vks_hn_out;
      vks_hn_ew:
        call vks_row_extent_w;
        jmp vks_hn_out;
      vks_hn_eh:
        call vks_row_extent_h;
        jmp vks_hn_out;
      vks_hn_sn:
        call vks_row_scale_num;
        jmp vks_hn_out;

      vks_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  vks_hn_denied;
        xor rax, rax;
        jmp vks_hn_out;

      vks_hn_res:
        mov rax, 0xFFFFEE1E;
        jmp vks_hn_out;
      vks_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp vks_hn_out;
      vks_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      vks_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
