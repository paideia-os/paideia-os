// src/kernel/core/cap/kind_pcie_hotplug_event.pdx — R35.M1-002 (#1196)
//
// KIND_PCIE_HOTPLUG_EVENT = 0x16B, derived over KIND_IPC_ENDPOINT (5).
//
// The authority a ring-3 hotplug supervisor holds to be told, on ONE
// endpoint it also holds, about ONE PCIe root port's slot-status
// events (presence-detect change / data-link-layer state change /
// command completed / power fault). The record of one subscription
// against one root port.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// PCIe hot-plug is the point at which every OS's driver model breaks:
// devices arrive deep in the topology, mid-runtime, and DMA-attack
// vectors open at the moment enumeration completes. Per D3 the
// SOFTWARE-CM path is what R35 lands (not firmware-CM), so the kernel
// is the party that observes root-port service interrupts and the
// hotplug supervisor is the party that authorises what happens next.
// The subscription record IS this kind.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// Like KIND_HID_EVENT, KIND_EC_QUERY and KIND_FW_SESSION, THE KIND
// HALF OF THE GATE DISCRIMINATES NOTHING on its own — every endpoint
// in the machine is kind 5, the shell's stdout included — so the mint
// additionally requires:
//
//   (a) event_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (NO_ENDPOINT); its endpoint id is INHERITED from the parent's
//       target_ptr[15:0] and stored on the row rather than accepted as
//       an argument
//   (c) root_port_bdf fits in u16 (bus:dev:func packed) (BAD_BDF)
//   (d) event_type in {0,1,2,3} (BAD_EVENT)
//   (e) port_status fits in u16 (BAD_STATUS)
//   (f) rights subset of R_PCIE_HP_EVT_ALL
//
// =============================================================================
// §2  EVENT ORDINALS (PCIe base §6.7 Slot Status decoding)
// =============================================================================
//
//   0 PRESENCE_DETECT_CHANGE  — Slot Status bit 3 raised
//   1 DATA_LINK_LAYER_STATE_CHANGE — Slot Status bit 8 raised
//   2 COMMAND_COMPLETED        — Slot Status bit 4 raised
//   3 POWER_FAULT              — Slot Status bit 1 raised
//
// The four are the raw wire encodings the ISR (#1195) reads from Slot
// Status and clears with a write-1-to-clear. Higher-level abstractions
// (link_up, link_down, dpc_triggered, surprise_removal) are the
// supervisor's derived vocabulary, computed from a sequence of raw
// events plus link status; they are NOT confused with the raw events
// here because the record of a raw event is what an auditor needs to
// reconstruct what the hardware actually reported.
//
// =============================================================================
// §3  LEAF OF THE HOTPLUG LATTICE
// =============================================================================
//
// R_PCIE_HP_EVT_MINT (0x200) is DELIBERATELY ABSENT from
// R_PCIE_HP_EVT_ALL: nothing derives from a hotplug-event cap in this
// milestone. Same discipline KIND_HID_EVENT / KIND_EC_QUERY /
// KIND_FW_SESSION applied for the same reason.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFFA30..0xFFFFFA3F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: pcie_hotplug_isr
// 0xFFFFFA20..2F, pcie_hotplug_channel 0xFFFFFA10..1F, pcie_link_retrain
// 0xFFFFFA00..0F; adjacent used band above: synaptics 0xFFFFFA40..4F).

module KindPcieHotplugEvent = structure {

  pub let KIND_PCIE_HOTPLUG_EVENT         : u64 = 0x16B
  pub let PCIE_HP_EVT_PARENT_KIND         : u64 = 5    // = KIND_IPC_ENDPOINT

  // Event ordinals (§2).
  pub let PCIE_HP_EVT_PRESENCE_DETECT_CHANGE   : u64 = 0
  pub let PCIE_HP_EVT_DLL_STATE_CHANGE         : u64 = 1
  pub let PCIE_HP_EVT_COMMAND_COMPLETED        : u64 = 2
  pub let PCIE_HP_EVT_POWER_FAULT              : u64 = 3
  pub let PCIE_HP_EVT_TYPE_MAX                 : u64 = 3

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_PCIE_HP_EVT_READ    : u64 = 0x001
  pub let R_PCIE_HP_EVT_INVOKE  : u64 = 0x008
  pub let R_PCIE_HP_EVT_REVOKE  : u64 = 0x010
  pub let R_PCIE_HP_EVT_OBSERVE : u64 = 0x400
  pub let R_PCIE_HP_EVT_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let PCIE_HP_EVT_OP_QUERY_KEY        : u64 = 0
  pub let PCIE_HP_EVT_OP_QUERY_ENDPOINT   : u64 = 1
  pub let PCIE_HP_EVT_OP_QUERY_BDF        : u64 = 2
  pub let PCIE_HP_EVT_OP_QUERY_TYPE       : u64 = 3
  pub let PCIE_HP_EVT_OP_QUERY_STATUS     : u64 = 4
  pub let PCIE_HP_EVT_OP_QUERY_PARENT     : u64 = 5
  pub let PCIE_HP_EVT_OP_DEBUG_PRINT      : u64 = 6
  pub let PCIE_HP_EVT_OP_MAX              : u64 = 6

  // Failure taxonomy — 0xFFFFFA30..0xFFFFFA3F.
  pub let PCIE_HP_EVT_OK                 : u64 = 0
  pub let PCIE_HP_EVT_TAIL_ENOSPC        : u64 = 0xFFFFFA3F
  pub let PCIE_HP_EVT_TAIL_BAD_ARG       : u64 = 0xFFFFFA3E
  pub let PCIE_HP_EVT_MINT_BAD_PARENT    : u64 = 0xFFFFFA3D
  pub let PCIE_HP_EVT_MINT_BAD_RIGHTS    : u64 = 0xFFFFFA3C
  pub let PCIE_HP_EVT_MINT_BAD_BDF       : u64 = 0xFFFFFA3B
  pub let PCIE_HP_EVT_MINT_BAD_EVENT     : u64 = 0xFFFFFA3A
  pub let PCIE_HP_EVT_MINT_BAD_STATUS    : u64 = 0xFFFFFA39
  pub let PCIE_HP_EVT_MINT_NO_ENDPOINT   : u64 = 0xFFFFFA38
  pub let PCIE_HP_EVT_MINT_NO_KEY        : u64 = 0xFFFFFA37
  pub let PCIE_HP_EVT_MINT_ENOSPC        : u64 = 0xFFFFFA36
  pub let PCIE_HP_EVT_MINT_IN_USE        : u64 = 0xFFFFFA35
  pub let PCIE_HP_EVT_BAD_SLOT           : u64 = 0xFFFFFA34
  pub let PCIE_HP_EVT_WRONG_KIND         : u64 = 0xFFFFFA33
  pub let PCIE_HP_EVT_REVOKE_ALREADY     : u64 = 0xFFFFFA32

  pub let PCIE_HP_EVT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PCIE_HP_EVT_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  event_key
  //   [+16] body word 1: endpoint_id[15:0] | root_port_bdf[31:16]
  //                     | event_type[39:32] | port_status[55:40]
  //                     | reserved[63:56]
  //   [+24] body word 2: reserved (zero)
  pub let PCIE_HP_EVT_MAX       : u64 = 8
  pub let PCIE_HP_EVT_ROW_BYTES : u64 = 32

  pub let mut _pcie_hp_evt_table : [u64; 32] = uninit @align(64)
  pub let mut _pcie_hp_evt_stats : [u64; 4]  = uninit @align(64)

  pub let PCIE_HP_EVT_ST_MINTS   : u64 = 0
  pub let PCIE_HP_EVT_ST_REVOKES : u64 = 1
  pub let PCIE_HP_EVT_ST_IN_USE  : u64 = 2
  pub let PCIE_HP_EVT_ST_ENOSPC  : u64 = 3

  pub let pcie_hp_evt_dbg_msg : [u8; 18] = "PCIE HP EVT ROW\0\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let pcie_hp_evt_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): clear the PCIE HP EVT row table and its counters. Boot and teardown only. Labels prefixed phe_rs_.",
      block: {
        lea r10, [rip + _pcie_hp_evt_table];
        xor rax, rax;
        xor rcx, rcx;
      phe_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  phe_rs_rows;

        lea r10, [rip + _pcie_hp_evt_stats];
        xor rcx, rcx;
      phe_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  phe_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let pcie_hp_evt_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-002 (#1196): 1 iff t in [0, 3] (PRESENCE / DLL / CMD_COMPLETED / POWER_FAULT). Labels prefixed phe_tv_.",
      block: {
        cmp rdi, 3;
        ja  phe_tv_no;
        mov rax, 1;
        ret;
      phe_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_hp_evt_bdf_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-002 (#1196): 1 iff b fits in u16 (bus:dev:func packed as bus[15:8] dev[7:3] func[2:0]). Labels prefixed phe_bv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  phe_bv_no;
        mov rax, 1;
        ret;
      phe_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_hp_evt_status_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-002 (#1196): 1 iff s fits in u16 (raw Slot Status register value). Labels prefixed phe_sv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  phe_sv_no;
        mov rax, 1;
        ret;
      phe_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_hp_evt_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-002 (#1196): subset test against R_PCIE_HP_EVT_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — this kind is a leaf (§3). Labels prefixed phe_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne phe_rv_no;
        mov rax, 1;
        ret;
      phe_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let pcie_hp_evt_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): counter bump. Labels prefixed phe_nt_.",
      block: {
        cmp rdi, 4;
        jae phe_nt_out;
        lea r10, [rip + _pcie_hp_evt_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      phe_nt_out:
        ret
      }
    }

  pub let pcie_hp_evt_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): counter read. Labels prefixed phe_st_.",
      block: {
        cmp rdi, 4;
        jae phe_st_zero;
        lea r10, [rip + _pcie_hp_evt_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      phe_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_IPC_ENDPOINT with RIGHT_MINT.
  // ==========================================================================

  pub let pcie_hp_evt_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): §1 gate. parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Kind check alone discriminates NOTHING; the mint's additional gates cover the rest. Labels prefixed phe_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae phe_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne phe_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  phe_cp_no;

        mov rax, 1;
        ret;
      phe_cp_no:
        xor rax, rax;
        ret
      }
    }

  // Read parent KIND_IPC_ENDPOINT endpoint_id from target_ptr[15:0].
  pub let pcie_hp_evt_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): parent KIND_IPC_ENDPOINT target_ptr[15:0] = endpoint_id. Returns 0 if bad slot or wrong kind — the mint refuses NO_ENDPOINT for 0. Labels prefixed phe_pe_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae phe_pe_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne phe_pe_no;

        mov rax, [rax + 16];
        and rax, 0xFFFF;
        ret;
      phe_pe_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let pcie_hp_evt_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-002 (#1196): (parent_slot << 8). Labels prefixed phe_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae phe_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      phe_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let pcie_hp_evt_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (endpoint_id: u64) (root_port_bdf: u64) (event_type: u64) (port_status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-002 (#1196): pack endpoint_id[15:0] | root_port_bdf[31:16] | event_type[39:32] | port_status[55:40]. Refuses out-of-range fields. Labels prefixed phe_b1_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  phe_b1_bad;
        cmp rsi, r10;
        ja  phe_b1_bad;
        cmp rdx, 3;
        ja  phe_b1_bad;
        cmp rcx, r10;
        ja  phe_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      phe_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/valid/free.
  //
  // THE ONE WRITER of _pcie_hp_evt_table. tools/build.sh confines
  // relocations against `_pcie_hp_evt_table` to this object.
  // ==========================================================================

  pub let pcie_hp_evt_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (event_key: u64) (body1_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): claim one PCIE HP EVT row. THE ONE WRITER of _pcie_hp_evt_table. Gates: hdr in_use pre-set -> BAD_ARG; event_key != 0 -> BAD_ARG; body1 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows of 32 bytes. Labels prefixed phe_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // event_key
        mov r14, rdx;                    // body1

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne phe_ta_bad;

        cmp r13, 0;
        je  phe_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  phe_ta_bad;

        xor rbx, rbx;
      phe_ta_scan:
        cmp rbx, 8;
        jae phe_ta_enospc;

        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phe_ta_claim;

        add rbx, 1;
        jmp phe_ta_scan;

      phe_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp phe_ta_out;

      phe_ta_enospc:
        mov rax, 0xFFFFFA3F;
        jmp phe_ta_out;
      phe_ta_bad:
        mov rax, 0xFFFFFA3E;

      phe_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pcie_hp_evt_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): 1 iff row_id < MAX and in_use. Labels prefixed phe_tvr_.",
      block: {
        cmp rdi, 8;
        jae phe_tvr_no;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phe_tvr_no;
        mov rax, 1;
        ret;
      phe_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_hp_evt_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): scrub one row. Labels prefixed phe_tf_.",
      block: {
        cmp rdi, 8;
        jae phe_tf_out;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      phe_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let pcie_hp_evt_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): event_key. Labels prefixed phe_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call pcie_hp_evt_tail_valid;
        cmp rax, 0;
        je  phe_rk_bad;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp phe_rk_out;
      phe_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      phe_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let pcie_hp_evt_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): endpoint_id (inherited from parent). Labels prefixed phe_re_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call pcie_hp_evt_tail_valid;
        cmp rax, 0;
        je  phe_re_bad;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp phe_re_out;
      phe_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      phe_re_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let pcie_hp_evt_row_bdf : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): root_port_bdf. Labels prefixed phe_rb_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call pcie_hp_evt_tail_valid;
        cmp rax, 0;
        je  phe_rb_bad;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp phe_rb_out;
      phe_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      phe_rb_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let pcie_hp_evt_row_type : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): event_type. Labels prefixed phe_rt_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call pcie_hp_evt_tail_valid;
        cmp rax, 0;
        je  phe_rt_bad;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFF;
        jmp phe_rt_out;
      phe_rt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      phe_rt_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let pcie_hp_evt_row_status : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): port_status. Labels prefixed phe_rst_.",
