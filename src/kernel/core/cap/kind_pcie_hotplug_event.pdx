        mov r12, rdi;
        call pcie_hp_evt_tail_valid;
        cmp rax, 0;
        je  phe_rst_bad;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 40;
        and rax, 0xFFFF;
        jmp phe_rst_out;
      phe_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      phe_rst_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

