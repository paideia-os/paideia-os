  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let pcie_hp_evt_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (event_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-002 (#1196): live row holding this event_key, or ROW_NONE. Refuses to match 0. Labels prefixed phe_fk_.",
      block: {
        cmp rdi, 0;
        je  phe_fk_none;
        xor rcx, rcx;
      phe_fk_scan:
        cmp rcx, 8;
        jae phe_fk_none;
        lea r10, [rip + _pcie_hp_evt_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  phe_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  phe_fk_hit;
      phe_fk_next:
        add rcx, 1;
        jmp phe_fk_scan;
      phe_fk_hit:
        mov rax, rcx;
        ret;
      phe_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let pcie_hp_evt_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): slot -> row_id, gated on live KIND_PCIE_HOTPLUG_EVENT. Labels prefixed phe_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae phe_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x16B;
        cmp r10, r11;
        jne phe_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call pcie_hp_evt_tail_valid;
        cmp rax, 0;
        je  phe_ros_none;

        mov rax, r12;
        jmp phe_ros_out;

      phe_ros_none:
        mov rax, 0xFF;
      phe_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

