      justification: "R35.M1-002 (#1196): event_type. ARITY ONE. Labels prefixed phe_tos_.",
      block: {
        push r12; push r13; push r14;
        call pcie_hp_evt_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  phe_tos_bad;
        mov rdi, r12;
        call pcie_hp_evt_row_type;
        jmp phe_tos_out;
