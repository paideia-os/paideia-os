  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, event_key, packed_ident, _r).
  // packed_ident encoding:
  //   [15:0]  root_port_bdf
  //   [23:16] event_type
  //   [39:24] port_status
  //   [63:40] reserved (must be zero)
  // Note: the endpoint_id is INHERITED from the parent's target_ptr[15:0],
  // never accepted as an argument.
  // ==========================================================================

  pub let pcie_hp_evt_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (event_key: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): mint KIND_PCIE_HOTPLUG_EVENT over KIND_IPC_ENDPOINT. Five args (slot, parent, rights, key, packed). packed = bdf[15:0] | event_type[23:16] | port_status[39:24]. Sequence: slot<256; check_parent; parent_eid non-zero (NO_ENDPOINT); rights_valid; unpack + validate bdf/type/status; event_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body1_pack (with inherited eid); tail_alloc; cap_mint_write. Labels prefixed phe_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // event_key
        mov r15, r8;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae phe_mi_bad_slot;

        mov rdi, r12;
        call pcie_hp_evt_check_parent;
        cmp rax, 0;
        je  phe_mi_bad_parent;

        mov rdi, r12;
        call pcie_hp_evt_parent_eid;
        cmp rax, 0;
        je  phe_mi_no_endpoint;
        mov rbp, rax;                    // inherited endpoint_id

        mov rdi, r13;
        call pcie_hp_evt_rights_valid;
        cmp rax, 0;
        je  phe_mi_bad_rights;

        // Validate bdf.
        mov rdi, r15;
        and rdi, 0xFFFF;
        call pcie_hp_evt_bdf_valid;
        cmp rax, 0;
        je  phe_mi_bad_bdf;

        // Validate event_type.
        mov rdi, r15;
        shr rdi, 16;
        and rdi, 0xFF;
        call pcie_hp_evt_type_valid;
        cmp rax, 0;
        je  phe_mi_bad_event;

        // Validate port_status.
        mov rdi, r15;
        shr rdi, 24;
        and rdi, 0xFFFF;
        call pcie_hp_evt_status_valid;
        cmp rax, 0;
        je  phe_mi_bad_status;

        cmp r14, 0;
        je  phe_mi_no_key;

        mov rdi, r14;
        call pcie_hp_evt_find_by_key;
        cmp rax, 0xFF;
        jne phe_mi_in_use;

        // Body1 pack args: (endpoint_id, bdf, event_type, port_status).
        mov rdi, rbp;                    // inherited endpoint_id
        mov rsi, r15;
        and rsi, 0xFFFF;                 // bdf
        mov rdx, r15;
        shr rdx, 16;
        and rdx, 0xFF;                   // event_type
        mov rcx, r15;
        shr rcx, 24;
        and rcx, 0xFFFF;                 // port_status
        call pcie_hp_evt_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  phe_mi_bad_bdf;
        mov r15, rax;                    // body1

        // Header.
        mov rdi, r12;
        call pcie_hp_evt_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  phe_mi_bad_parent;

        // tail_alloc(hdr, event_key, body1).
        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // event_key
        mov rdx, r15;                    // body1
        call pcie_hp_evt_tail_alloc;

        mov r10, 0xFFFFFA3F;             // ENOSPC
        cmp rax, r10;
        je  phe_mi_enospc;
        mov r10, 0xFFFFFA3E;             // BAD_ARG
        cmp rax, r10;
        je  phe_mi_bad_event;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x16B;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call pcie_hp_evt_note;

        xor rax, rax;
        jmp phe_mi_out;

      phe_mi_bad_slot:
        mov rax, 0xFFFFFA34;
        jmp phe_mi_out;
      phe_mi_bad_parent:
        mov rax, 0xFFFFFA3D;
        jmp phe_mi_out;
      phe_mi_bad_rights:
        mov rax, 0xFFFFFA3C;
        jmp phe_mi_out;
      phe_mi_bad_bdf:
        mov rax, 0xFFFFFA3B;
        jmp phe_mi_out;
      phe_mi_bad_event:
        mov rax, 0xFFFFFA3A;
        jmp phe_mi_out;
      phe_mi_bad_status:
        mov rax, 0xFFFFFA39;
        jmp phe_mi_out;
      phe_mi_no_endpoint:
        mov rax, 0xFFFFFA38;
        jmp phe_mi_out;
      phe_mi_no_key:
        mov rax, 0xFFFFFA37;
        jmp phe_mi_out;
      phe_mi_in_use:
        mov rdi, 2;
        call pcie_hp_evt_note;
        mov rax, 0xFFFFFA35;
        jmp phe_mi_out;
      phe_mi_enospc:
        mov rdi, 3;
        call pcie_hp_evt_note;
        mov rax, 0xFFFFFA36;

      phe_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pcie_hp_evt_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (event_key: u64) (packed_ident: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call pcie_hp_evt_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x16B;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let pcie_hp_evt_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): revoke KIND_PCIE_HOTPLUG_EVENT. Labels prefixed phe_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae phe_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  phe_rvk_already;

        mov r11, 0x16B;
        cmp r10, r11;
        jne phe_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call pcie_hp_evt_tail_valid;
        cmp rax, 0;
        je  phe_rvk_clear;

        mov rdi, r13;
        call pcie_hp_evt_tail_free;

      phe_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call pcie_hp_evt_note;

        xor rax, rax;
        jmp phe_rvk_out;

      phe_rvk_bad_slot:
        mov rax, 0xFFFFFA34;
        jmp phe_rvk_out;
      phe_rvk_wrong_kind:
        mov rax, 0xFFFFFA33;
        jmp phe_rvk_out;
      phe_rvk_already:
        mov rax, 0xFFFFFA32;

      phe_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pcie_hp_evt_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call pcie_hp_evt_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x16B;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_pcie_hp_evt : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M1-002 (#1196): KIND_PCIE_HOTPLUG_EVENT dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed phe_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_pcie_hp_evt_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne phe_hn_res;

        cmp rbp, 6;
        ja  phe_hn_unsup;

        cmp rbp, 6;
        je  phe_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  phe_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  phe_hn_key;
        cmp rbp, 1;
        je  phe_hn_eid;
        cmp rbp, 2;
        je  phe_hn_bdf;
        cmp rbp, 3;
        je  phe_hn_typ;
        cmp rbp, 4;
        je  phe_hn_sts;
        call pcie_hp_evt_row_parent;
        jmp phe_hn_out;

      phe_hn_key:
        call pcie_hp_evt_row_key;
        jmp phe_hn_out;
      phe_hn_eid:
        call pcie_hp_evt_row_endpoint;
        jmp phe_hn_out;
      phe_hn_bdf:
        call pcie_hp_evt_row_bdf;
        jmp phe_hn_out;
      phe_hn_typ:
        call pcie_hp_evt_row_type;
        jmp phe_hn_out;
      phe_hn_sts:
        call pcie_hp_evt_row_status;
        jmp phe_hn_out;

      phe_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  phe_hn_denied;
        xor rax, rax;
        jmp phe_hn_out;

      phe_hn_res:
        mov rax, 0xFFFFFA3E;
        jmp phe_hn_out;
      phe_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp phe_hn_out;
      phe_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      phe_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
