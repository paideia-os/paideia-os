// src/kernel/core/cap/nvme_reliability.pdx -- R51.M4-001 (#1651) +
// R51.M4-002 (#1652).
//
// design/hardware/nvme-oncs-reliability.md (commit 1682a41) §1 assigns
// this file "I/O-queue-side optional ops": nvme_io_submit_flush (FLUSH
// opcode 0x00, ONCS[0] gate, #1651) and nvme_io_submit_trim (DSM
// opcode 0x09, ONCS[2] gate, #1652, this commit).  Kept out of
// nvme_io_queues.pdx (1533 lines at M3 close) to avoid re-creating the
// god-file pressure the M3 file-split already resolved (design §1).
//
// FLUSH is an I/O-queue command (NVMe §5.8, opcode 0x00 submitted on
// the per-(controller,cpu) SQ nvme_io_queues.pdx already maintains) --
// NOT an admin-queue command.  It reuses the same pair-picking /
// doorbell / completion-drain substrate nvme_io_submit_rw (M3) already
// established, just without any PRP/CDW10-12 payload (FLUSH carries no
// data).  This resolves a wording gap in the issuing task text, which
// described the op as a "NVMe FLUSH admin cmd" via a putative
// nvme_io_submit_admin path and a single-arg nvme_reliability_flush
// (bdev_row_id) signature -- the design doc (this file's stated
// authority) is unambiguous that FLUSH is I/O-queue-side and takes two
// args (ctrl_row_id, ns_row_id); the design doc's shape is followed
// here (nvme_io_submit_flush), matching its §5.1 pseudocode and label
// prefix table.
//
// ONCS gating (design §2.3): read the cached ONCS field from the
// controller row (+32, stamped at R51.M1 IDENTIFY-controller time) via
// nvme_ctrl_row_oncs (kind_nvme_controller.pdx L605); a clear bit 0
// returns NVMEREL_FLUSH_UNSUP without touching any I/O queue.  Note on
// the FLUSH <-> ONCS[0] mapping: NVMe spec-wise, ONCS bit 0 is Compare
// (FLUSH is mandatory, ungated by any ONCS bit); the parent substrate
// doc and issue #1651 nevertheless specify this gate for shape
// symmetry with TRIM's ONCS[2] gate.  Design §2.2's "defensive-uniform"
// reading is adopted verbatim: on real hardware every controller sets
// ONCS[0], so the gate is vacuous; on a synthetic/fuzzed controller
// that clears it, BDEV_ERR_UNSUPPORTED (design §2.2) is a defensible
// reply. No code change needed if this reading is ever revisited.
//
// R51.M4-002 (#1652) design-doc gaps resolved in this commit:
//   - §5.2's CDW11 pack formula ("AD << 2 | IDW << 1 | IDR"; "we ship
//     AD=1 unconditionally at M4") is read together with §4.3's
//     descriptor-page `flags` bit layout (bit0=ad_bit, bit1=idw_bit,
//     bit2=idr_bit -- the caller-facing encoding) to mean: this
//     function's own `flags` argument uses that SAME caller-facing
//     layout (bit0=ad_bit, bit1=idw_bit, bit2=idr_bit; validated
//     `flags & ~0x7 == 0`), and the wire-format CDW11 is built by
//     remapping IDW (flags bit1) and IDR (flags bit2) into CDW11 bits
//     1 and 0 respectively while forcing CDW11 bit 2 (AD) to 1
//     unconditionally, regardless of the caller's own ad_bit value --
//     M4 supports only the deallocate mode, so a caller's ad_bit is
//     accepted (bit 0 is included in the reserved-bits validation
//     range so a caller must still pass a well-formed value) but not
//     separately consulted when building the wire word.  No new
//     failure code needed: NVMEREL_TRIM_BAD_FLAGS already covers the
//     `flags & ~0x7 != 0` validation failure.
//   - Register pressure: five args (ctrl_row_id, ns_row_id,
//     range_count, dsm_desc_iova, flags) plus three call-surviving
//     locals (pair_row, bar0, nsid) exceed what five callee-save
//     registers can hold across the run of nested calls (oncs check,
//     pick_pair, bar0, nsid) -- following the nvme_ios_ precedent
//     (nvme_io_queues.pdx's own submit-and-validate leaf, same
//     register-exhaustion shape), range_count/dsm_desc_iova/flags are
//     spilled to stack scratch slots ([rsp+0]/[rsp+8]/[rsp+16], a
//     fourth slot [rsp+24] unused/alignment-only) rather than crammed
//     into a sixth+ callee-save register.
//
// Design-doc gaps resolved in this commit:
//   - §3.1's per-CID watchdog deadline table (_nvme_inflight_deadline)
//     is documented as written by every I/O-submitting function
//     (nvme_io_submit_rw, nvme_io_submit_flush, nvme_io_submit_trim)
//     and cleared by nvme_io_completion_drain (M3, patched at M4).
//     That table, and the watchdog scanner that consumes it (#1655,
//     nvme_recovery.pdx, not yet landed), are both out of #1651's
//     scope -- stamping a deadline nothing yet reads or clears would
//     be dead state with no consumer, and patching the shared
//     nvme_io_completion_drain in nvme_io_queues.pdx is itself outside
//     this commit's file list. Deferred to whichever of #1653-#1656
//     lands the watchdog; flagged here for that triage (mirrors the
//     nvme_io_queues.pdx file-header precedent of flagging a deferred
//     cross-issue dependency rather than silently dropping it).
//   - §4.4 claims the full 0xFFFFEC70..0xFFFFEC7F band up front (whole-
//     module taxonomy declared in one place, per the nvme_io_queues.pdx
//     precedent at its own §2), even though this commit's code only
//     ever returns NVMEREL_FLUSH_UNSUP; the remaining fourteen values
//     are declared for #1652-#1656 to consume without a second
//     failure-code file.
//   - §5.1's stated register plan (rbx=ctrl_row, rbp=ns_row,
//     r12=pair_row_addr, r13=cid, r14=cpu_idx, r15=deadline) assumes
//     the deadline-stamp write this commit defers (previous bullet);
//     without it, cid/cpu_idx/deadline are never simultaneously live,
//     so this commit uses a five-register plan instead (rbx=ctrl_row_id
//     then reused as the stashed cid, rbp=ns_row_id, r12=pair_row,
//     r13=bar0, r14=nsid) -- same total push count (5), same resulting
//     alignment shape, no functional difference for the FLUSH path
//     actually implemented.
//
// =============================================================================
// paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: sized loads/stores use xor <reg>,<reg>; mov_b for the qid byte
//       read (base+immediate-displacement, so the `[reg+reg]` ->
//       `[reg + reg * 1]` restriction does not apply); mov_d for the
//       32-bit dword0/NSID SQE field stores (mov_d does not need
//       explicit zero-extension on a store, only on a load).
//   G4: every sentinel compare against a value with bit 31/63 set is
//       staged through `mov r10, <imm>; cmp reg, r10` rather than a
//       bare `cmp reg, <imm>` (imm32 cmp operands sign-extend; a bare
//       `cmp rax, 0xFFFFEC58` would compare against
//       0xFFFFFFFFFFFFEC58 instead) -- identical posture to
//       nvme_io_queues.pdx / cap_handler_blkdev.pdx.
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this commit's function is prefixed `nvme_rel_`.

module NvmeReliability = structure {

  // ============================================================================
  // §4.4 failure taxonomy -- the M4 band, 0xFFFFEC70..0xFFFFEC7F.
  // Declared in full (whole-module posture); NVMEREL_FLUSH_UNSUP (#1651)
  // and the four NVMEREL_TRIM_* codes (#1652, this commit) are returned
  // by this file's code. The remaining ten are #1653-#1656's to consume
  // when they land in nvme_admin_events.pdx / nvme_recovery.pdx.
  // ============================================================================

  pub let NVMEREL_FLUSH_UNSUP        : u64 = 0xFFFFEC70   // ONCS[0] clear (#1651)
  pub let NVMEREL_TRIM_UNSUP         : u64 = 0xFFFFEC71   // ONCS[2] clear (#1652, this commit)
  pub let NVMEREL_TRIM_BAD_RANGES    : u64 = 0xFFFFEC72   // range_count 0 or > 256 (#1652, this commit)
  pub let NVMEREL_TRIM_BAD_FLAGS     : u64 = 0xFFFFEC73   // reserved flag bits set (#1652, this commit)
  pub let NVMEREL_TRIM_BAD_IOVA      : u64 = 0xFFFFEC74   // dsm_desc_iova not page-aligned (#1652, this commit)
  pub let NVMEREL_AER_NO_ENDPOINT    : u64 = 0xFFFFEC75   // (#1653)
  pub let NVMEREL_AER_POOL_FULL      : u64 = 0xFFFFEC76   // (#1653)
  pub let NVMEREL_LOG_BAD_LID        : u64 = 0xFFFFEC77   // (#1654)
  pub let NVMEREL_LOG_TIMEOUT        : u64 = 0xFFFFEC78   // (#1654)
  pub let NVMEREL_WD_TIMEOUT_INJECT  : u64 = 0xFFFFEC79   // (#1655)
  pub let NVMEREL_QRESET_FAILED      : u64 = 0xFFFFEC7A   // (#1655)
  pub let NVMEREL_CFS_OBSERVED       : u64 = 0xFFFFEC7B   // (#1656)
  pub let NVMEREL_NSSR_FIRED         : u64 = 0xFFFFEC7C   // (#1656)
  pub let NVMEREL_NSSR_NOT_SUPPORTED : u64 = 0xFFFFEC7D   // (#1656)
  // 0xFFFFEC7E, 0xFFFFEC7F reserved for R52 attach/detach codes.

  // ==========================================================================
  // nvme_io_submit_flush(ctrl_row_id, ns_row_id) -> u64
  //
  // design/hardware/nvme-oncs-reliability.md §5.1.  Submits NVMe FLUSH
  // (opcode 0x00) on a live I/O pair for ctrl_row_id, targeting
  // ns_row_id's NSID.  No PRP, no CDW10-12 -- FLUSH carries no data.
  //
  // Returns 0 on OK; NVMEREL_FLUSH_UNSUP if ONCS[0] is clear;
  // BDEV_ERR_BAD_ROW (0xFFFFEC62, cap_handler_blkdev.pdx) on a decode
  // failure against either row; NVMEIO_PICK_NONE / NVMEIO_SUBMIT_TIMEOUT
  // / NVMEIO_SUBMIT_CQE_ERR (nvme_io_queues.pdx's own band) from the
  // shared pick/doorbell/drain tail.
  // ==========================================================================
  pub let nvme_io_submit_flush : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) (ns_row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M4-001 (#1651): NVMe FLUSH (opcode 0x00), ONCS[0]-gated. Five callee-save pushes (rbx=ctrl_row_id, then reused post-bar0-call as the stashed CID across the nvme_ring_sq call; rbp=ns_row_id, unused after its sole nvme_ns_row_nsid call; r12=pair_row; r13=bar0; r14=nsid) = 40 B; entry rsp%16==8 -> 48, %16==0 -- no pad needed (matches cap_handler_blkdev's own 5-push, no-pad shape), so every nested call (nvme_ctrl_row_oncs, nvme_io_pick_pair, nvme_ctrl_row_bar0, nvme_ns_row_nsid, nvme_ring_sq, nvme_io_completion_drain) executes at rsp%16==0. Sequence: (1) nvme_ctrl_row_oncs(ctrl_row_id) -- NVMEC_DECODE_BAD (all-ones) maps to BDEV_ERR_BAD_ROW; ONCS[0] clear maps to NVMEREL_FLUSH_UNSUP; (2) nvme_io_pick_pair(ctrl_row_id) -> pair_row, NVMEIO_PICK_NONE (0xFFFFEC58) forwarded verbatim on failure -- identical shape to nvme_io_submit_rw's own pick-fail handling; (3) nvme_ctrl_row_bar0(ctrl_row_id) -> bar0, DECODE_BAD -> BDEV_ERR_BAD_ROW; (4) nvme_ns_row_nsid(ns_row_id) -> nsid, DECODE_BAD -> BDEV_ERR_BAD_ROW; (5) build the 64-byte SQE at pair_row's sq_pa + sq_tail*64 (zeroed via an 8-qword loop identical to nvme_iox_sqe_submit's own zero loop), dword0 = (sq_tail<<16) [OPC=0, so no OR against a nonzero opcode is needed], NSID stored via mov_d at +4, every other field left zero (FLUSH takes no PRP/CDW10-12); (6) advance sq_tail mod 64, rebuild the packed cursors word preserving cq_head/cq_phase, stash the pre-advance sq_tail (== CID) into rbx (ctrl_row_id is dead by this point -- its last read was the bar0 call), ring SQyTDBL via nvme_ring_sq(bar0, qid, new_sq_tail) (qid read via the G1 xor+mov_b zero-extension idiom); (7) nvme_io_completion_drain(pair_row, bar0, cid, 50000000 /* NVME_SYNC_SPIN_MAX, drivers/nvme/sync.pdx */) -- DECODE_BAD (timeout sentinel) maps to NVMEIO_SUBMIT_TIMEOUT, non-zero status maps to NVMEIO_SUBMIT_CQE_ERR, zero -> success (return 0). Every sentinel comparison against a value with bit 31/63 set is staged through `mov r10, <imm>; cmp reg, r10` per this file's G4 note. Labels prefixed nvme_rel_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                     // ctrl_row_id
        mov rbp, rsi;                     // ns_row_id

        // ---- ONCS[0] gate ----
        mov rdi, rbx;
        call nvme_ctrl_row_oncs;
        mov r10, 0xFFFFFFFFFFFFFFFF;      // NVMEC_DECODE_BAD
        cmp rax, r10;
        je  nvme_rel_flush_bad_row;
        and rax, 1;                       // ONCS[0]
        cmp rax, 0;
        je  nvme_rel_flush_unsup;

        // ---- pick a live I/O pair for this controller ----
        mov rdi, rbx;
        call nvme_io_pick_pair;
        mov r10, 0xFFFFEC58;              // NVMEIO_PICK_NONE
        cmp rax, r10;
        je  nvme_rel_flush_pick_fail;
        mov r12, rax;                     // pair_row

        // ---- bar0 ----
        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_rel_flush_bad_row;
        mov r13, rax;                     // bar0

        // ---- nsid ----
        mov rdi, rbp;
        call nvme_ns_row_nsid;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_rel_flush_bad_row;
        mov r14, rax;                     // nsid

        // ---- zero the 64-byte SQE at sq_pa + sq_tail*64 ----
        mov r10, [r12 + 32];              // cursors
        shr r10, 32;
        and r10, 0xFFFF;                  // sq_tail
        mov r11, [r12 + 8];               // sq_pa
        shl r10, 6;
        add r10, r11;                     // r10 = sqe_addr

        xor rax, rax;
        xor rcx, rcx;
      nvme_rel_flush_zero_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  nvme_rel_flush_zero_loop;

        // ---- dword0 = OPC(0x00) | (cid<<16); cid == sq_tail ----
        mov r11, [r12 + 32];
        shr r11, 32;
        and r11, 0xFFFF;                  // sq_tail == cid
        mov rax, r11;
        shl rax, 16;                      // OPC is 0 -> dword0 == cid<<16
        mov_d [r10 + 0], rax;

        // ---- NSID (u32 @+4) ----
        mov rax, r14;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov_d [r10 + 4], rax;

        // ---- advance sq_tail (mod 64); rebuild cursors; stash cid ----
        mov r10, [r12 + 32];              // cursors (old)
        mov r11, r10;
        shr r11, 32;
        and r11, 0xFFFF;                  // old sq_tail == cid
        mov rbx, r11;                     // stash cid (ctrl_row_id no longer needed)

        mov rax, r11;
        add rax, 1;
        and rax, 0x3F;                    // new sq_tail (NVME_IO_QUEUE_ENTRIES=64)

        mov r9, 0xFFFFFFFF;
        and r10, r9;                       // low32 (cq_head|cq_phase) preserved
        mov rcx, rax;
        shl rcx, 32;
        or  r10, rcx;                      // new cursors
        mov [r12 + 32], r10;               // write back

        xor rcx, rcx;
        mov_b rcx, [r12 + 0];              // qid, zero-extended

        mov rdi, r13;                      // bar0
        mov rsi, rcx;                      // qid
        mov rdx, rax;                      // new_sq_tail
        call nvme_ring_sq;

        // ---- drain ----
        mov rdi, r12;                      // pair_row
        mov rsi, r13;                      // bar0
        mov rdx, rbx;                      // expected_cid (stashed)
        mov rcx, 50000000;                 // NVME_SYNC_SPIN_MAX (drivers/nvme/sync.pdx)
        call nvme_io_completion_drain;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_rel_flush_timeout;

        cmp rax, 0;
        jne nvme_rel_flush_cqe_err;

        xor rax, rax;                      // success
        jmp nvme_rel_flush_out;

      nvme_rel_flush_bad_row:
        mov rax, 0xFFFFEC62;               // BDEV_ERR_BAD_ROW (cap_handler_blkdev.pdx)
        jmp nvme_rel_flush_out;

      nvme_rel_flush_unsup:
        mov rax, 0xFFFFEC70;               // NVMEREL_FLUSH_UNSUP
        jmp nvme_rel_flush_out;

      nvme_rel_flush_pick_fail:
        mov rax, 0xFFFFEC58;               // NVMEIO_PICK_NONE
        jmp nvme_rel_flush_out;

      nvme_rel_flush_timeout:
        mov rax, 0xFFFFEC56;               // NVMEIO_SUBMIT_TIMEOUT
        jmp nvme_rel_flush_out;

      nvme_rel_flush_cqe_err:
        mov rax, 0xFFFFEC57;               // NVMEIO_SUBMIT_CQE_ERR

      nvme_rel_flush_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_io_submit_trim(ctrl_row_id, ns_row_id, range_count, dsm_desc_iova,
  //                      flags) -> u64
  //
  // design/hardware/nvme-oncs-reliability.md §5.2.  Submits NVMe
  // DATASET_MANAGEMENT (opcode 0x09) on a live I/O pair for
  // ctrl_row_id, targeting ns_row_id's NSID, with a caller-owned
  // range-descriptor page at dsm_desc_iova (already mapped into the
  // driver's DMA domain by the caller per §4.3 -- handed to PRP1
  // verbatim, no PRP-list encoding needed since <=256 x 16 B = 4096 B
  // always fits one page/one PRP entry).
  //
  // Returns 0 on OK; NVMEREL_TRIM_UNSUP if ONCS[2] is clear;
  // NVMEREL_TRIM_BAD_RANGES/BAD_FLAGS/BAD_IOVA on argument validation
  // failure; BDEV_ERR_BAD_ROW (0xFFFFEC62, cap_handler_blkdev.pdx) on a
  // decode failure against either row; NVMEIO_PICK_NONE /
  // NVMEIO_SUBMIT_TIMEOUT / NVMEIO_SUBMIT_CQE_ERR (nvme_io_queues.pdx's
  // own band) from the shared pick/doorbell/drain tail.
  // ==========================================================================
  pub let nvme_io_submit_trim : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) (ns_row_id: u64) (range_count: u64) (dsm_desc_iova: u64) (flags: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M4-002 (#1652): NVMe DATASET_MANAGEMENT (opcode 0x09), ONCS[2]-gated. Five callee-save pushes (rbx=ctrl_row_id, then reused post-bar0-call as the stashed CID across the nvme_ring_sq call; rbp=ns_row_id, unused after its sole nvme_ns_row_nsid call; r12=pair_row; r13=bar0; r14=nsid) = 40 B; entry rsp%16==8 -> 48, %16==0; sub rsp,32 gives four 8-byte scratch slots ([rsp+0]=range_count, [rsp+8]=dsm_desc_iova, [rsp+16]=flags, [rsp+24] unused/alignment-only) -> 80, %16==0 -- every nested call executes at rsp%16==0. range_count/dsm_desc_iova/flags spill to the stack rather than a sixth+ callee-save register because all five GP callee-save registers are already committed to ctrl_row_id/ns_row_id/pair_row/bar0/nsid across the same run of nested calls (oncs check, pick_pair, bar0, nsid) -- same register-exhaustion shape as nvme_io_queues.pdx's nvme_ios_ (submit-and-validate leaf) precedent. Sequence: (1) nvme_ctrl_row_oncs(ctrl_row_id) -- NVMEC_DECODE_BAD maps to BDEV_ERR_BAD_ROW; ONCS[2] clear maps to NVMEREL_TRIM_UNSUP; (2) validate range_count in [1,256] else NVMEREL_TRIM_BAD_RANGES (small positive immediates, no G4 staging needed); flags & ~0x7 == 0 (mov-then-and idiom, AND has no full-imm64 form) else NVMEREL_TRIM_BAD_FLAGS; dsm_desc_iova & 0xFFF == 0 else NVMEREL_TRIM_BAD_IOVA; (3) nvme_io_pick_pair(ctrl_row_id) -> pair_row, NVMEIO_PICK_NONE forwarded verbatim on failure; (4) nvme_ctrl_row_bar0(ctrl_row_id) -> bar0, DECODE_BAD -> BDEV_ERR_BAD_ROW; (5) nvme_ns_row_nsid(ns_row_id) -> nsid, DECODE_BAD -> BDEV_ERR_BAD_ROW; (6) build the 64-byte SQE at pair_row's sq_pa + sq_tail*64 (zeroed via an 8-qword loop identical to nvme_iox_sqe_submit's own zero loop): dword0 = OPC(0x09) | (cid<<16) [cid == sq_tail], NSID stored via mov_d at +4, PRP1 (u64 @+24) = dsm_desc_iova stored verbatim (plain 64-bit mov -- no PRP-list encoding, per file-header note), PRP2 (@+32) left zero (already zeroed by the zero loop, DSM range lists never span a second PRP at M4's 256-entry cap), CDW10 (u32 @+40) = range_count-1 (0-based per NVMe §6.6), CDW11 (u32 @+44) = (1<<2)|(idw<<1)|idr where idw=flags[1], idr=flags[2] and AD (bit2) is forced to 1 unconditionally regardless of flags[0] (file-header gap note: M4 supports only the deallocate mode); (7) advance sq_tail mod 64, rebuild the packed cursors word preserving cq_head/cq_phase, stash the pre-advance sq_tail (== CID) into rbx (ctrl_row_id is dead by this point), ring SQyTDBL via nvme_ring_sq(bar0, qid, new_sq_tail) (qid read via the G1 xor+mov_b zero-extension idiom); (8) nvme_io_completion_drain(pair_row, bar0, cid, 50000000 /* NVME_SYNC_SPIN_MAX, drivers/nvme/sync.pdx */) -- DECODE_BAD maps to NVMEIO_SUBMIT_TIMEOUT, non-zero status maps to NVMEIO_SUBMIT_CQE_ERR, zero -> success (return 0). Every sentinel comparison against a value with bit 31/63 set is staged through `mov r10, <imm>; cmp reg, r10` per this file's G4 note. Labels prefixed nvme_rel_trim_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 32;

        mov rbx, rdi;                      // ctrl_row_id
        mov rbp, rsi;                      // ns_row_id
        mov [rsp + 0], rdx;                // range_count
        mov [rsp + 8], rcx;                // dsm_desc_iova
        mov [rsp + 16], r8;                // flags

        // ---- ONCS[2] gate ----
        mov rdi, rbx;
        call nvme_ctrl_row_oncs;
        mov r10, 0xFFFFFFFFFFFFFFFF;       // NVMEC_DECODE_BAD
        cmp rax, r10;
        je  nvme_rel_trim_bad_row;
        and rax, 4;                        // ONCS[2] (design §2.3: "same shape with `and rax, 4`")
        cmp rax, 0;
        je  nvme_rel_trim_unsup;

        // ---- validate range_count in [1, 256] ----
        mov rax, [rsp + 0];
        cmp rax, 1;
        jb  nvme_rel_trim_bad_ranges;
        mov r10, 256;
        cmp rax, r10;
        ja  nvme_rel_trim_bad_ranges;

        // ---- validate flags: reserved bits [63:3] must be 0 ----
        mov rax, [rsp + 16];
        mov r10, 0xFFFFFFFFFFFFFFF8;
        and rax, r10;
        cmp rax, 0;
        jne nvme_rel_trim_bad_flags;

        // ---- validate dsm_desc_iova: page-aligned ----
        mov rax, [rsp + 8];
        mov r10, 0xFFF;
        and rax, r10;
        cmp rax, 0;
        jne nvme_rel_trim_bad_iova;

        // ---- pick a live I/O pair for this controller ----
        mov rdi, rbx;
        call nvme_io_pick_pair;
        mov r10, 0xFFFFEC58;               // NVMEIO_PICK_NONE
        cmp rax, r10;
        je  nvme_rel_trim_pick_fail;
        mov r12, rax;                      // pair_row

        // ---- bar0 ----
        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_rel_trim_bad_row;
        mov r13, rax;                      // bar0

        // ---- nsid ----
        mov rdi, rbp;
        call nvme_ns_row_nsid;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_rel_trim_bad_row;
        mov r14, rax;                      // nsid

        // ---- zero the 64-byte SQE at sq_pa + sq_tail*64 ----
        mov r10, [r12 + 32];               // cursors
        shr r10, 32;
        and r10, 0xFFFF;                   // sq_tail
        mov r11, [r12 + 8];                // sq_pa
        shl r10, 6;
        add r10, r11;                      // r10 = sqe_addr

        xor rax, rax;
        xor rcx, rcx;
      nvme_rel_trim_zero_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  nvme_rel_trim_zero_loop;

        // ---- dword0 = OPC(0x09) | (cid<<16); cid == sq_tail ----
        mov r11, [r12 + 32];
        shr r11, 32;
        and r11, 0xFFFF;                   // sq_tail == cid
        mov rax, r11;
        shl rax, 16;
        or  rax, 9;                        // OPC = 0x09 (DATASET_MANAGEMENT)
        mov_d [r10 + 0], rax;

        // ---- NSID (u32 @+4) ----
        mov rax, r14;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov_d [r10 + 4], rax;

        // ---- PRP1 (u64 @+24) = dsm_desc_iova, verbatim ----
        mov rax, [rsp + 8];
        mov [r10 + 24], rax;

        // ---- CDW10 (u32 @+40) = range_count - 1 ----
        mov rax, [rsp + 0];
        sub rax, 1;
        mov_d [r10 + 40], rax;

        // ---- CDW11 (u32 @+44) = (AD=1 forced)<<2 | (IDW=flags[1])<<1 | (IDR=flags[2]) ----
        mov rax, [rsp + 16];                // flags
        mov r11, rax;
        shr r11, 1;
        and r11, 1;
        shl r11, 1;                         // IDW -> CDW11 bit 1
        mov rcx, rax;
        shr rcx, 2;
        and rcx, 1;                         // IDR -> CDW11 bit 0
        or  r11, rcx;
        mov r9, 4;
        or  r11, r9;                        // AD -> CDW11 bit 2, forced
        mov_d [r10 + 44], r11;

        // ---- advance sq_tail (mod 64); rebuild cursors; stash cid ----
        mov r10, [r12 + 32];                // cursors (old)
        mov r11, r10;
        shr r11, 32;
        and r11, 0xFFFF;                     // old sq_tail == cid
        mov rbx, r11;                        // stash cid (ctrl_row_id no longer needed)

        mov rax, r11;
        add rax, 1;
        and rax, 0x3F;                       // new sq_tail (NVME_IO_QUEUE_ENTRIES=64)

        mov r9, 0xFFFFFFFF;
        and r10, r9;                         // low32 (cq_head|cq_phase) preserved
        mov rcx, rax;
        shl rcx, 32;
        or  r10, rcx;                        // new cursors
        mov [r12 + 32], r10;                 // write back

        xor rcx, rcx;
        mov_b rcx, [r12 + 0];                // qid, zero-extended

        mov rdi, r13;                        // bar0
        mov rsi, rcx;                        // qid
        mov rdx, rax;                        // new_sq_tail
        call nvme_ring_sq;

        // ---- drain ----
        mov rdi, r12;                        // pair_row
        mov rsi, r13;                        // bar0
        mov rdx, rbx;                        // expected_cid (stashed)
        mov rcx, 50000000;                   // NVME_SYNC_SPIN_MAX (drivers/nvme/sync.pdx)
        call nvme_io_completion_drain;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_rel_trim_timeout;

        cmp rax, 0;
        jne nvme_rel_trim_cqe_err;

        xor rax, rax;                        // success
        jmp nvme_rel_trim_out;

      nvme_rel_trim_bad_row:
        mov rax, 0xFFFFEC62;                 // BDEV_ERR_BAD_ROW (cap_handler_blkdev.pdx)
        jmp nvme_rel_trim_out;

      nvme_rel_trim_unsup:
        mov rax, 0xFFFFEC71;                 // NVMEREL_TRIM_UNSUP
        jmp nvme_rel_trim_out;

      nvme_rel_trim_bad_ranges:
        mov rax, 0xFFFFEC72;                 // NVMEREL_TRIM_BAD_RANGES
        jmp nvme_rel_trim_out;

      nvme_rel_trim_bad_flags:
        mov rax, 0xFFFFEC73;                 // NVMEREL_TRIM_BAD_FLAGS
        jmp nvme_rel_trim_out;

      nvme_rel_trim_bad_iova:
        mov rax, 0xFFFFEC74;                 // NVMEREL_TRIM_BAD_IOVA
        jmp nvme_rel_trim_out;

      nvme_rel_trim_pick_fail:
        mov rax, 0xFFFFEC58;                 // NVMEIO_PICK_NONE
        jmp nvme_rel_trim_out;

      nvme_rel_trim_timeout:
        mov rax, 0xFFFFEC56;                 // NVMEIO_SUBMIT_TIMEOUT
        jmp nvme_rel_trim_out;

      nvme_rel_trim_cqe_err:
        mov rax, 0xFFFFEC57;                 // NVMEIO_SUBMIT_CQE_ERR

      nvme_rel_trim_out:
        add rsp, 32;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
