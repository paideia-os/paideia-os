  // ============================================================================
  // dma_domain_set_binding(row_id, bind_base, bind_mask) -> u64
  //
  // Supervisor authority to WIDEN (or re-anchor) a domain's binding.
  // Returns DMA_BIND_OK, or:
  //   DMA_BIND_ERR_BAD_ROW — row_id out of range or row not in_use.
  //   DMA_BIND_ERR_BAD_ARG — bind_base >= 2^16, bind_mask >= 2^16, or
  //                          bind_mask == 0.
  //
  // A zero mask is refused because it would make EVERY BDF a member of
  // the binding — an unbounded grant dressed as a narrowing operation.
  // The supervisor that wants a driver to reach an entire bus writes
  // 0xFF00 and is visibly accountable for it.
  //
  // parent_slot (bits [7:0]) is preserved by read-modify-write: the
  // cascade-revoke walk reads it, and losing it would orphan the row.
  //
  // SysV ABI: rdi = row_id, rsi = bind_base, rdx = bind_mask.
  // ============================================================================

  pub let dma_domain_set_binding : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (bind_base: u64) (bind_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): rewrite the (bind_base, bind_mask) pair at _dma_domain_table[row_id][+16] bits [39:8], preserving parent_slot at bits [7:0]. Gates: row_id >= DMA_DOMAIN_MAX or in_use byte zero -> DMA_BIND_ERR_BAD_ROW; bind_base >> 16 non-zero, bind_mask >> 16 non-zero, or bind_mask == 0 -> DMA_BIND_ERR_BAD_ARG. Commit: load [+16], AND with 0xFF (keep parent_slot, clear the rest including the [63:40] reserved field so a future field addition cannot inherit stale bits), OR in (base << 8) | (mask << 24), store. Leaf; single u64 store.",
      block: {
        cmp rdi, 32;
        jae dma_bind_bad_row;

        // bind_base < 2^16.
        mov r10, rsi;
        shr r10, 16;
        cmp r10, 0;
        jne dma_bind_bad_arg;

        // bind_mask < 2^16 and non-zero.
        mov r10, rdx;
        shr r10, 16;
        cmp r10, 0;
        jne dma_bind_bad_arg;
        cmp rdx, 0;
        je  dma_bind_bad_arg;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_bind_bad_row;

        // Preserve parent_slot; rebuild the rest.
        mov rax, [r8 + 16];
        mov r10, 0xFF;
        and rax, r10;                      // parent_slot only

        mov r11, rsi;
        shl r11, 8;
        or  rax, r11;                      // | bind_base << 8

        mov r11, rdx;
        shl r11, 24;
        or  rax, r11;                      // | bind_mask << 24

        mov [r8 + 16], rax;

        xor rax, rax;                      // DMA_BIND_OK
        ret;

      dma_bind_bad_row:
        mov rax, 0xFFFFFFD2;               // DMA_BIND_ERR_BAD_ROW
        ret;

      dma_bind_bad_arg:
        mov rax, 0xFFFFFFD1;               // DMA_BIND_ERR_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // dma_bdf_in_binding(row_id, bus_dev_fn) -> u64
  //
  // Returns 1 iff the row is live AND
  //   (bdf & bind_mask) == (bind_base & bind_mask).
  // Returns 0 on a dead row, an out-of-range row, or a non-member BDF —
  // all three are "the kernel will not switch this domain onto that BDF",
  // so a single 0 is the honest answer; the caller that needs to
  // distinguish a dead row calls dma_tail_valid first (and
  // iommu_domain_switch does exactly that).
  //
  // SysV ABI: rdi = row_id, rsi = bus_dev_fn.
  // ============================================================================

  pub let dma_bdf_in_binding : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (bus_dev_fn: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): prefix-membership predicate over the row's (bind_base, bind_mask). Gates: row_id >= DMA_DOMAIN_MAX -> 0; in_use byte zero -> 0; bus_dev_fn >> 16 non-zero -> 0 (a BDF wider than 16 bits can never be a member). Load [+16]; base = bits [23:8], mask = bits [39:24]; return 1 iff (bdf & mask) == (base & mask), else 0. Leaf; pure read.",
      block: {
        cmp rdi, 32;
        jae dma_inbind_no;

        // bdf must fit in 16 bits.
        mov r10, rsi;
        shr r10, 16;
        cmp r10, 0;
        jne dma_inbind_no;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_inbind_no;

        mov rax, [r8 + 16];

        mov r10, rax;
        shr r10, 8;
        mov r11, 0xFFFF;
        and r10, r11;                      // r10 = bind_base

        shr rax, 24;
        and rax, r11;                      // rax = bind_mask

        and r10, rax;                      // base & mask
        mov r11, rsi;
        and r11, rax;                      // bdf & mask

        cmp r10, r11;
        jne dma_inbind_no;

        mov rax, 1;
        ret;

      dma_inbind_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // R29.M5-004 (#1039) — context-entry state accessors (row [+24])
  // ============================================================================
  //
  // dma_ctx_pack(state, bdf, hw)  -> u64   canonical [+24] word encoder
  // dma_ctx_read(row_id)          -> u64   raw word
  // dma_ctx_write(row_id, word)   -> u64   rc
  // dma_ctx_state(row_id)         -> u64   bits [7:0]
  // dma_ctx_bdf(row_id)           -> u64   bits [23:8]
  // dma_ctx_hw(row_id)            -> u64   bits [31:24]
  //
  // The pack/read/write triple exists (rather than three field setters)
  // because the switch path must be able to SNAPSHOT the whole word
  // before it moves the row into DMA_CTX_PENDING and RESTORE it verbatim
  // if the hardware commit refuses. A field-at-a-time API cannot express
  // "put it back exactly as it was" without re-deriving each field, which
  // is where a partial restore would hide.
  // ============================================================================

  pub let dma_ctx_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (state: u64) (bus_dev_fn: u64) (hw_committed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M5-004 (#1039): canonical row [+24] encoder. Validate state <= DMA_CTX_STATE_MAX (2), bus_dev_fn < 2^16, hw_committed <= 1; any violation returns DMA_DECODE_BAD (0xFF..FF), which cannot collide with a well-formed word because bits [63:32] of a well-formed word are always zero. Pack: (state & 0xFF) | ((bdf & 0xFFFF) << 8) | ((hw & 0xFF) << 24). Pure leaf; no memory effect.",
      block: {
        cmp rdi, 2;                        // DMA_CTX_STATE_MAX
        ja  dma_ctxpack_bad;

        mov r10, rsi;
        shr r10, 16;
        cmp r10, 0;
        jne dma_ctxpack_bad;

        cmp rdx, 1;
        ja  dma_ctxpack_bad;

        mov rax, rdi;
        mov r10, 0xFF;
        and rax, r10;

        mov r10, rsi;
        mov r11, 0xFFFF;
        and r10, r11;
        shl r10, 8;
        or  rax, r10;

        mov r10, rdx;
        mov r11, 0xFF;
        and r10, r11;
        shl r10, 24;
        or  rax, r10;
        ret;

      dma_ctxpack_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dma_ctx_read : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): return the raw [+24] context-entry word for row_id. Bounds-check + in_use check first; DMA_DECODE_BAD on failure (unambiguous — a well-formed word has bits [63:32] zero). Leaf; pure read.",
      block: {
        cmp rdi, 32;
        jae dma_ctxread_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_ctxread_bad;

        mov rax, [r8 + 24];
        ret;

      dma_ctxread_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dma_ctx_write : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (ctx_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): store ctx_word into _dma_domain_table[row_id][+24]. Gates: row_id >= DMA_DOMAIN_MAX or in_use byte zero -> DMA_CTX_ERR_BAD_ROW; ctx_word bits [63:32] non-zero -> DMA_CTX_ERR_BAD_ARG (rejecting the reserved field is what makes DMA_DECODE_BAD unable to be written into the row, so a subsequent dma_ctx_read cannot return a sentinel that the caller would read as failure); ctx_word state byte > DMA_CTX_STATE_MAX -> DMA_CTX_ERR_BAD_ARG. Commit is a single u64 store. Leaf.",
      block: {
        cmp rdi, 32;
        jae dma_ctxwrite_bad_row;

        // Reserved field must be clear.
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne dma_ctxwrite_bad_arg;

        // State byte must be a legal state.
        mov r10, rsi;
        mov r11, 0xFF;
        and r10, r11;
        cmp r10, 2;                        // DMA_CTX_STATE_MAX
        ja  dma_ctxwrite_bad_arg;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_ctxwrite_bad_row;

        mov [r8 + 24], rsi;

        xor rax, rax;                      // DMA_CTX_OK
        ret;

      dma_ctxwrite_bad_row:
        mov rax, 0xFFFFFFD4;               // DMA_CTX_ERR_BAD_ROW
        ret;

      dma_ctxwrite_bad_arg:
        mov rax, 0xFFFFFFD3;               // DMA_CTX_ERR_BAD_ARG
        ret
      }
    }

  pub let dma_ctx_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): extract ctx_state from row [+24] bits [7:0]. Bounds + in_use gate; DMA_DECODE_BAD on failure. Unambiguous: a live row's state is 0..2 by construction (dma_ctx_write refuses anything else). Leaf; pure read.",
      block: {
        cmp rdi, 32;
        jae dma_ctxstate_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_ctxstate_bad;

        mov rax, [r8 + 24];
        mov r10, 0xFF;
        and rax, r10;
        ret;

      dma_ctxstate_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dma_ctx_bdf : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): extract ctx_bdf from row [+24] bits [23:8]. Bounds + in_use gate; DMA_DECODE_BAD on failure. Meaningless (zero) when ctx_state == DMA_CTX_NONE — callers gate on the state first. Leaf; pure read.",
      block: {
        cmp rdi, 32;
        jae dma_ctxbdf_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_ctxbdf_bad;

        mov rax, [r8 + 24];
        shr rax, 8;
        mov r10, 0xFFFF;
        and rax, r10;
        ret;

      dma_ctxbdf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dma_ctx_hw : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-004 (#1039): extract hw_committed from row [+24] bits [31:24]. Bounds + in_use gate; DMA_DECODE_BAD on failure. 1 iff a real VT-d context entry was written for this binding; 0 when the domain owns the entry only in the kernel's software record (the state at IOMMU_ENABLED = 0). Leaf; pure read.",
      block: {
        cmp rdi, 32;
        jae dma_ctxhw_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_ctxhw_bad;

        mov rax, [r8 + 24];
        shr rax, 24;
        mov r10, 0xFF;
        and rax, r10;
        ret;

      dma_ctxhw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // dma_domain_debug_print(row_id) -> u64
  //
  // Canonical debug printer (#1037). Emits one klog line per tail field
  // at LEVEL_INFO under SUBSYS_CAP_, all sharing the tag "DMA DOMAIN
  // ROW" so the five lines read as one record:
  //
  //   ... |I|CAP_|DMA DOMAIN ROW row=<hex>
  //   ... |I|CAP_|DMA DOMAIN ROW ctx=<hex>
  //   ... |I|CAP_|DMA DOMAIN ROW bdf=<hex>
  //   ... |I|CAP_|DMA DOMAIN ROW cap=<hex>
  //   ... |I|CAP_|DMA DOMAIN ROW coh=<hex>
  //
  // Five klog_s1_x1 calls rather than one klog_s1_x4: the KV wrappers
  // cap out at what fits in SysV argument registers (see
  // klog/wrappers.pdx §klog_s1_x2, which already needs a caller-side
  // stack push for its second value), and a per-field line keeps the
  // printer's own failure mode trivial.
  //
  // Returns DMA_TAIL_OK on success, DMA_DECODE_BAD if the row is dead or
  // out of range (nothing is printed in that case — a debug printer must
  // never emit fabricated field values for a row that does not exist).
  // ============================================================================

  pub let dma_domain_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R29.M5-002 (#1037): canonical KIND_DMA_DOMAIN row printer. Validate via dma_tail_valid(row_id); on 0 return DMA_DECODE_BAD without emitting. Otherwise emit five klog_s1_x1(LEVEL_INFO=3, SUBSYS_CAP_, dma_dbg_msg, key, value) lines keyed row/ctx/bdf/cap/coh, each value sourced from the matching decoder. row_id parked in rbx (callee-save, pushed/popped) because every klog + decoder call clobbers the caller-save set. Stack: push rbx keeps rsp 16-byte aligned at each call site (entry rsp is 8 mod 16 after the return address; one push makes it 0 mod 16). Returns DMA_TAIL_OK (0).",
      block: {
        push rbx;
        mov rbx, rdi;                      // park row_id

        // Validity gate — never print a dead row.
        mov rdi, rbx;
        call dma_tail_valid;
        cmp rax, 0;
        je  dma_dbg_bad;

        // row=<row_id>
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + dma_dbg_msg];
        lea rcx, [rip + dma_k_row];
        mov r8,  rbx;
        call klog_s1_x1;

        // ctx=<iommu_ctx_id>
        mov rdi, rbx;
        call dma_tail_decode_ctx_id;
        mov r8, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + dma_dbg_msg];
        lea rcx, [rip + dma_k_ctx];
        call klog_s1_x1;

        // bdf=<bus_dev_fn>
        mov rdi, rbx;
        call dma_tail_decode_bdf;
        mov r8, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + dma_dbg_msg];
        lea rcx, [rip + dma_k_bdf];
        call klog_s1_x1;

        // cap=<capacity_bytes>
        mov rdi, rbx;
        call dma_tail_decode_capacity;
        mov r8, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + dma_dbg_msg];
        lea rcx, [rip + dma_k_cap];
        call klog_s1_x1;

        // coh=<coherency>
        mov rdi, rbx;
        call dma_tail_decode_coherency;
        mov r8, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + dma_dbg_msg];
        lea rcx, [rip + dma_k_coh];
        call klog_s1_x1;

        xor rax, rax;                      // DMA_TAIL_OK
        pop rbx;
        ret;

      dma_dbg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;       // DMA_DECODE_BAD
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // dma_rights_valid(rights) -> u64
  //
  // Returns 1 iff rights is a subset of R_DMA_ALL (0x618).
  // ============================================================================

  pub let dma_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M5-001 (#1036): KIND_DMA_DOMAIN rights-subset validator. Returns 1 iff (rights & R_DMA_ALL) == rights; else 0. R_DMA_ALL = 0x618 (INVOKE|REVOKE|MINT|OBSERVE). Same shape as msix_rights_valid / hw_int_rights_valid. Pure leaf.",
      block: {
        mov rax, rdi;
        mov r10, 0x618;
        and rax, r10;
        cmp rax, rdi;
        jne dma_rights_no;
        mov rax, 1;
        ret;

      dma_rights_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // dma_check_parent_kind_memory(parent_slot) -> u64
  //
  // Returns 1 iff cap_table[parent_slot].kind == KIND_MEMORY (4) AND
  // (rights & RIGHT_MINT = 0x200) != 0. Else 0.
  //
  // This is the "ancestor KIND_MEMORY cap holding RIGHT_MINT" gate that
  // makes the derivation real: a caller cannot conjure a DMA domain
  // (which is memory reach for a bus-mastering device) without already
  // holding mintable memory authority.
  // ============================================================================

  pub let dma_check_parent_kind_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M5-001 (#1036): supervisor mint-gate for KIND_DMA_DOMAIN. Bounds-check parent_slot < 256. Load descriptor at cap_table + parent_slot*24 (stride 24 = kind + rights + target_ptr, per cap/mint.pdx). Assert kind field ([+0]) == 4 (KIND_MEMORY = KIND_PAGE) AND rights field ([+8]) has bit 0x200 (RIGHT_MINT) set. Returns 1 on OK, 0 otherwise. Pure read; no writes. Mirrors msix_check_parent_kind_hw_int one lattice over.",
      block: {
        cmp rdi, 256;
        jae dma_parent_no;

        // cap_table + parent_slot * 24.
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // kind == KIND_MEMORY (4)?
        mov r10, [rax + 0];
        cmp r10, 4;
        jne dma_parent_no;

        // rights & RIGHT_MINT (0x200) != 0?
        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  dma_parent_no;

        mov rax, 1;
        ret;

      dma_parent_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // dma_cap_mint(slot, parent_slot, rights, tail_word, capacity_bytes)
  //   -> u64
  //
  // Full mint: validate parent (KIND_MEMORY + RIGHT_MINT), validate the
  // rights subset, allocate + populate a row, write the descriptor.
  //
  // SysV ABI (5 args in registers):
  //   rdi = slot            (target cap_table slot; 0..255)
  //   rsi = parent_slot     (ancestor KIND_MEMORY slot; 0..255)
  //   rdx = rights          (subset of R_DMA_ALL)
  //   rcx = tail_word       (from dma_tail_pack; bits [63:56] must be 0)
  //   r8  = capacity_bytes  (u64; must be non-zero)
  // ============================================================================

  // R29.M6-002 (#1041): the PUBLIC symbol is the audited wrapper below.
  pub let dma_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (tail_word: u64) (capacity_bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M5-001 (#1036): supervisor mint API for KIND_DMA_DOMAIN. Sequence: (1) bounds-check slot < 256 -> DMA_MINT_BAD_ARG. (2) dma_check_parent_kind_memory(parent_slot) -> DMA_MINT_BAD_PARENT. (3) dma_rights_valid(rights) -> DMA_MINT_BAD_RIGHTS. (4) dma_tail_alloc(tail_word, capacity_bytes, parent_slot); translate DMA_TAIL_ENOSPC -> DMA_MINT_ENOSPC, DMA_TAIL_BAD_COHERENCY -> DMA_MINT_BAD_COHERENCY, DMA_TAIL_BAD_ARG -> DMA_MINT_BAD_ARG so each failure edge keeps a distinct code at the mint boundary. (5) cap_mint_write(slot, KIND_DMA_DOMAIN=0x142, rights, row_id). Return DMA_MINT_OK (0). All 5 arg regs preserved across sub-calls via caller-save stack pushes; the tail_alloc step only needs slot + rights afterwards so it pushes just those two. Mint return codes (0xFFFFFFD8..0xFFFFFFDC) disjoint from MSIX_MINT_* and HW_INT_MINT_*. Mirrors msix_cap_mint's shape.",
      block: {
        // Bounds-check slot.
        cmp rdi, 256;
        jae dma_mint_bad_arg;

        // -- Step 2: parent gate.
        push rdi;
        push rsi;
        push rdx;
        push rcx;
        push r8;
        mov rdi, rsi;                      // parent_slot
        call dma_check_parent_kind_memory;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        pop rdi;
        cmp rax, 0;
        je  dma_mint_bad_parent;

        // -- Step 3: rights subset.
        push rdi;
        push rsi;
        push rdx;
        push rcx;
        push r8;
        mov rdi, rdx;                      // rights
        call dma_rights_valid;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        pop rdi;
        cmp rax, 0;
        je  dma_mint_bad_rights;

        // -- Step 4: dma_tail_alloc(tail_word, capacity_bytes, parent_slot).
        //    Arg move: rdi=tail_word (from rcx), rsi=capacity (from r8),
        //              rdx=parent_slot (from rsi).
        push rdi;                          // save slot
        push rdx;                          // save rights
        mov rdx, rsi;                      // parent_slot -> arg 3
        mov rdi, rcx;                      // tail_word   -> arg 1
        mov rsi, r8;                       // capacity    -> arg 2
        call dma_tail_alloc;
        pop rdx;                           // rights
        pop rdi;                           // slot

        // Translate allocator failures into distinct mint codes.
        mov r10, 0xFFFFFFDF;               // DMA_TAIL_ENOSPC
        cmp rax, r10;
        je  dma_mint_enospc;
        mov r10, 0xFFFFFFDD;               // DMA_TAIL_BAD_COHERENCY
        cmp rax, r10;
        je  dma_mint_bad_coh;
        mov r10, 0xFFFFFFDE;               // DMA_TAIL_BAD_ARG
        cmp rax, r10;
        je  dma_mint_bad_arg;

        // -- Step 5: cap_mint_write(slot, 0x142, rights, row_id).
        //    ABI: rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr.
        mov rsi, 0x142;                    // KIND_DMA_DOMAIN
        mov rcx, rax;                      // target_ptr = row_id
        call cap_mint_write;

        xor rax, rax;                      // DMA_MINT_OK (0)
        ret;

      dma_mint_bad_parent:
        mov rax, 0xFFFFFFDC;
        ret;

      dma_mint_bad_rights:
        mov rax, 0xFFFFFFDB;
        ret;

      dma_mint_enospc:
        mov rax, 0xFFFFFFDA;
        ret;

      dma_mint_bad_coh:
        mov rax, 0xFFFFFFD8;
        ret;

      dma_mint_bad_arg:
        mov rax, 0xFFFFFFD9;
        ret
      }
    }

  // ============================================================================
  // R29.M6-002 (#1041) — audited mint. Same wrapper shape as
  // hw_int_cap_mint; see that file for why the emission is a wrapper
  // rather than an edit to each of the five failure labels.
  //
  // The DMA case is the one where forgetting a call site would hurt
  // most: driver_lifecycle_start mints the driver-process domain and
  // driver_lifecycle_teardown revokes it, and D1.b's per-driver-process
  // cardinality claim (blob-policy §2.5) is only checkable if every
  // domain that ever existed left a record. Putting the emission here
  // means a future second mint path cannot exist without being audited.
  // ============================================================================

  pub let dma_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (tail_word: u64) (capacity_bytes: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M6-002 (#1041): audited entry point for KIND_DMA_DOMAIN mint. Three-push prologue (r12/r13/r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls. r12 = target slot, r13 = parent KIND_MEMORY slot, saved before the inner body clobbers rdi/rsi; the five SysV argument registers are untouched by the movs so the inner body sees them exactly as passed. r14 carries the inner return value across drv_audit_emit and is restored to rax, making the wrapper return-value transparent. Covers every exit of the inner body — success and all five failure codes.",
      block: {
        push r12;
        push r13;
        push r14;                            // 3 pushes -> rsp%16 = 0

        mov r12, rdi;                        // target cap slot
        mov r13, rsi;                        // parent KIND_MEMORY slot

        call dma_cap_mint_inner;
        mov r14, rax;                        // outcome

        mov rdi, 1;                          // DRV_AUDIT_EV_MINT
        mov rsi, 0x142;                      // KIND_DMA_DOMAIN
        mov rdx, r12;                        // subject
        mov rcx, r13;                        // principal
        mov r8,  r14;                        // outcome
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // dma_cap_revoke(slot) -> u64
  //
  // Verifies cap_table[slot] is a KIND_DMA_DOMAIN, extracts row_id from
  // target_ptr[15:0], frees (and scrubs) the row, clears the descriptor.
  // Idempotent on an already-null slot (DMA_REVOKE_ALREADY).
  // ============================================================================

  // R29.M6-002 (#1041): the PUBLIC symbol is the audited wrapper below.
  pub let dma_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M5-001 (#1036): supervisor revoke API for KIND_DMA_DOMAIN. Sequence: (1) bounds-check slot < 256 -> DMA_REVOKE_BAD_SLOT. (2) Load descriptor at cap_table + slot*24. (3) kind == 0 -> DMA_REVOKE_ALREADY (idempotent). (4) kind != 0x142 -> DMA_REVOKE_WRONG_KIND (never touch a foreign descriptor). (5) row_id = target_ptr & 0xFFFF; dma_tail_free(row_id) scrubs the row so no stale iommu_ctx_id / bdf survives. (6) Clear descriptor to (0,0,0). Return DMA_REVOKE_OK. Descriptor base parked in r11 across the dma_tail_free call via push/pop. Revoke codes (0xFFFFFFD5..0xFFFFFFD7) disjoint from MSIX_REVOKE_* and HW_INT_REVOKE_*.",
      block: {
        cmp rdi, 256;
        jae dma_revoke_bad_slot;

        // cap_table + slot * 24.
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r11, rax;                      // save descriptor base
        mov r10, [rax + 0];                // kind

        cmp r10, 0;
        je  dma_revoke_already;

        mov r9, 0x142;
        cmp r10, r9;
        jne dma_revoke_wrong_kind;

        // row_id = target_ptr[15:0].
        mov rdi, [r11 + 16];
        mov r10, 0xFFFF;
        and rdi, r10;

        push r11;
        call dma_tail_free;
        pop r11;

        // Clear descriptor.
        xor rax, rax;
        mov [r11 + 0],  rax;
        mov [r11 + 8],  rax;
        mov [r11 + 16], rax;

        xor rax, rax;                      // DMA_REVOKE_OK (0)
        ret;

      dma_revoke_bad_slot:
        mov rax, 0xFFFFFFD7;
        ret;

      dma_revoke_wrong_kind:
        mov rax, 0xFFFFFFD6;
        ret;

      dma_revoke_already:
        mov rax, 0xFFFFFFD5;
        ret
      }
    }

  // ============================================================================
  // R29.M6-002 (#1041) — audited revoke.
  //
  // dma_cascade_revoke_by_parent below calls THIS symbol, so a
  // driver-process teardown that cascades N domains leaves N records,
  // not one. Without that, the #1042 reconciliation would balance a
  // single cascade call against N destroyed descriptors and report a
  // leak that is not there — or, worse, fail to report one that is.
  // ============================================================================

  pub let dma_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M6-002 (#1041): audited entry point for KIND_DMA_DOMAIN revoke. Three-push prologue (r12/r13/r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls. r12 = slot saved before the inner body clobbers rdi; r13 pushed for alignment uniformity; r14 carries the inner return value across drv_audit_emit and is restored to rax. principal = the slot itself, as in the other two revoke wrappers. Called from dma_cascade_revoke_by_parent, which preserves r12/r13/r14 around its own call site, so these pushes nest correctly inside the cascade walk.",
      block: {
        push r12;
        push r13;
        push r14;                            // 3 pushes -> rsp%16 = 0

        mov r12, rdi;                        // slot

        call dma_cap_revoke_inner;
        mov r14, rax;                        // outcome

        mov rdi, 2;                          // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x142;                      // KIND_DMA_DOMAIN
        mov rdx, r12;                        // subject
        mov rcx, r12;                        // principal
        mov r8,  r14;                        // outcome
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // dma_cascade_revoke_by_parent(parent_slot) -> u64
  //
  // Scans cap_table[0..255]; for each descriptor with kind ==
  // KIND_DMA_DOMAIN (0x142), reads the row's parent_slot field; if it
  // matches, calls dma_cap_revoke on that slot. Returns the count of
  // domains revoked.
  //
  // Invariant established on return: no cap_table slot i in [0..256) has
  // (kind == 0x142) AND (row.parent_slot == parent_slot).
  //
  // Called by any teardown of the KIND_MEMORY ancestor — at R29.M5-003
  // that is driver-process exit. A stale IOMMU context entry outliving
  // the memory authority that justified it is exactly the failure this
  // closes.
  // ============================================================================

  // R29.M6-002 (#1041): {sysreg} added because the cascade now calls the
  // AUDITED dma_cap_revoke, whose emission timestamps each record.
  pub let dma_cascade_revoke_by_parent : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M5-001 (#1036): cascade revoke for KIND_DMA_DOMAIN children of a KIND_MEMORY parent. Iterate slot in 0..256; load kind at cap_table[slot][+0]; skip if != 0x142. Extract row_id from target_ptr [+16][15:0]; bounds-check row_id < DMA_DOMAIN_MAX; read the row's parent_slot inline from _dma_domain_table[row_id][+16][7:0]. If it matches, call dma_cap_revoke(slot) and increment the count. Registers: r12 = slot cursor, r13 = target parent_slot, r14 = count, rbx = scratch row_id — all callee-save in SysV and pushed/popped around the scan so dma_cap_revoke's clobbers cannot corrupt the walk. cap_table stride 24 bytes; row stride 32 bytes. Same shape as msix_cascade_revoke_by_parent.",
      block: {
        push r12;
        push r13;
        push r14;
        push rbx;

        mov r13, rdi;                      // target parent_slot
        and r13, 0xFF;                     // parent_slot fits in u8

        xor r14, r14;                      // count = 0
        xor r12, r12;                      // slot cursor

      dma_cascade_loop:
        cmp r12, 256;
        jae dma_cascade_done;

        // desc_addr = cap_table + r12 * 24.
        //
        // R51.M8-006 FIX: lea for the cap_table BASE ADDRESS. Same
        // fault as kind_nvme_namespace.pdx nvme_ns_cascade_revoke_blkdev
        // -- `mov rax, cap_table` compiled as a LOAD of the array's
        // first u64 rather than its address. This 0..256 walker was
        // one of the seven latent instances that fault at slot 171
        // when rax=0 sends the descriptor address past the
        // identity-mapped low page.
        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // kind == 0x142?
        mov r10, [rax + 0];
        mov r11, 0x142;
        cmp r10, r11;
        jne dma_cascade_skip;

        // row_id from target_ptr[15:0].
        mov rbx, [rax + 16];
        and rbx, 0xFFFF;

        cmp rbx, 32;                       // DMA_DOMAIN_MAX
        jae dma_cascade_skip;

        // row_addr = _dma_domain_table + row_id * 32.
        mov r8, rbx;
        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        // row [+16] bits [7:0] = parent_slot.
        mov r10, [r8 + 16];
        and r10, 0xFF;

        cmp r10, r13;
        jne dma_cascade_skip;

        // Match — revoke this domain.
        mov rdi, r12;
        call dma_cap_revoke;
        add r14, 1;

      dma_cascade_skip:
        add r12, 1;
        jmp dma_cascade_loop;

      dma_cascade_done:
        mov rax, r14;

        pop rbx;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // cap_handler_dma_domain(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler installed by cap_invoke_dispatch when
  // descriptor.kind == 0x142. RDI=rights, RSI=target_ptr, RDX=op_arg.
  //
  // op_arg[7:0] = op_code; required right varies BY OP (unlike the M1
  // kinds, which gate once at entry on RIGHT_INVOKE):
  //
  //   0 OP_QUERY_CTX_ID    INVOKE  -> iommu_ctx_id
  //   1 OP_QUERY_BDF       INVOKE  -> bus_dev_fn
  //   2 OP_QUERY_CAPACITY  INVOKE  -> capacity_bytes
  //   3 OP_QUERY_COHERENCY INVOKE  -> coherency
  //   4 OP_QUERY_PARENT    INVOKE  -> parent_slot
  //   5 OP_MAP             MINT    -> INVOKE_UNSUPPORTED (R29.M5-003)
  //   6 OP_UNMAP           MINT    -> INVOKE_UNSUPPORTED (R29.M5-003)
  //   7 OP_FLUSH           INVOKE  -> INVOKE_UNSUPPORTED (R29.M5-004)
  //   8 OP_QUERY_FAULT     OBSERVE -> INVOKE_UNSUPPORTED (R29.M5-004)
  //   9 OP_DEBUG_PRINT     OBSERVE -> dma_domain_debug_print(row_id)
  //   else                 INVOKE  -> INVOKE_UNSUPPORTED
  //
  // Per-op gating is the point: mapping a page into a device's reach
  // (OP_MAP) is a strictly stronger authority than reading which BDF the
  // domain is bound to, and reading the fault log is a strictly weaker
  // one. A single entry gate would collapse all three into whichever was
  // chosen, which is precisely the over-grant this kind exists to
  // prevent.
  // ============================================================================

  pub let cap_handler_dma_domain : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M5-001 (#1036) / R29.M5-002 (#1037): KIND_DMA_DOMAIN dispatch handler. Emits klog_s1(INFO, SUBSYS_CAP_, cap_dma_dom_msg) entry chatter with rdi/rsi/rdx preserved across the call, matching every other kind_*.pdx handler. Then: op_code = op_arg & 0xFF; select the required right into r9 (0x200 for OP_MAP/OP_UNMAP, 0x400 for OP_QUERY_FAULT/OP_DEBUG_PRINT, 0x008 otherwise); test (rights & r9) == r9 -> INVOKE_DENIED on failure. Query ops 0..4 delegate to dma_tail_decode_{ctx_id,bdf,capacity,coherency,parent} with row_id = target_ptr & 0xFFFF. Op 9 delegates to dma_domain_debug_print. Ops 5..8 and unknown ops return INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC) after their rights check — an unimplemented op must still refuse an unauthorized caller, so the gate precedes the unsupported return.",
      block: {
        push rdi;
        push rsi;
        push rdx;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_dma_dom_msg];
        call klog_s1;
        pop rdx;
        pop rsi;
        pop rdi;

        // op_code = op_arg & 0xFF.
        mov r8, rdx;
        mov r10, 0xFF;
        and r8, r10;

        // Select required right into r9.
        mov r9, 0x008;                     // default: RIGHT_INVOKE
        cmp r8, 5;
        je  dma_h_need_mint;
        cmp r8, 6;
        je  dma_h_need_mint;
        cmp r8, 8;
        je  dma_h_need_observe;
        cmp r8, 9;
        je  dma_h_need_observe;
        jmp dma_h_rights_gate;

      dma_h_need_mint:
        mov r9, 0x200;                     // RIGHT_MINT
        jmp dma_h_rights_gate;

      dma_h_need_observe:
        mov r9, 0x400;                     // RIGHT_OBSERVE

      dma_h_rights_gate:
        mov rax, rdi;
        and rax, r9;
        cmp rax, r9;
        jne dma_h_denied;

        cmp r8, 0;
        je  dma_h_q_ctx;
        cmp r8, 1;
        je  dma_h_q_bdf;
        cmp r8, 2;
        je  dma_h_q_cap;
        cmp r8, 3;
        je  dma_h_q_coh;
        cmp r8, 4;
        je  dma_h_q_par;
        cmp r8, 9;
        je  dma_h_dbg;
        // Ops 5..8 (MAP / UNMAP / FLUSH / QUERY_FAULT) and every unknown
        // op: authorized but not yet implemented.
        mov rax, 0xFFFFFFFFFFFFFFFC;       // INVOKE_UNSUPPORTED
        ret;

      dma_h_q_ctx:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call dma_tail_decode_ctx_id;
        ret;

      dma_h_q_bdf:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call dma_tail_decode_bdf;
        ret;

      dma_h_q_cap:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call dma_tail_decode_capacity;
        ret;

      dma_h_q_coh:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call dma_tail_decode_coherency;
        ret;

      dma_h_q_par:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call dma_tail_decode_parent;
        ret;

      dma_h_dbg:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call dma_domain_debug_print;
        ret;

      dma_h_denied:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;       // INVOKE_DENIED
        ret
      }
    }

}
