// src/kernel/core/cap/kind_dma_domain.pdx — R29.M5-001 (#1036) +
// R29.M5-002 (#1037)
//
// KIND_DMA_DOMAIN derived-kind: row-indirection tail encoding
// ({iommu_ctx_id, bus_dev_fn, capacity_bytes, coherency}), canonical
// tail-word encoder/decoder, rights validator, parent-kind gate,
// mint / revoke / cascade-revoke API, dispatch handler, and canonical
// debug printer.
//
// ---------------------------------------------------------------------
// Naming reconciliation (#1036 vs. the planning catalog)
// ---------------------------------------------------------------------
// design/architecture/next-wave-derived-kinds.md carried a planning
// skeleton named `KIND_HW_DMA_DOMAIN` with runtime base `KIND_HW = 14`,
// grouping it with the other R29.M1 hardware-adjacent derived kinds.
// design/roadmap/next-wave-softarch.md §3 R29 — and issues #1036/#1037,
// which are the binding specification for this landing — name it
// `KIND_DMA_DOMAIN` and derive it over `KIND_MEMORY`.
//
// Resolution adopted here: the softarch/issue name and derivation win.
//
//   * NAME. `KIND_DMA_DOMAIN`. The `HW_` infix on the planning skeleton
//     encoded a *base-kind* claim (KIND_HW) that this landing rejects;
//     keeping the infix while changing the base would leave the name
//     actively lying about the derivation. `KIND_HW_DMA_DOMAIN` is
//     retired as a name — the catalog entry is renamed, not aliased,
//     because no code ever referenced the skeleton.
//
//   * DERIVATION. Over `KIND_MEMORY`, not `KIND_HW`. A DMA domain is
//     not a device-authority handle; it is a *memory-access scope* — it
//     names the set of physical pages a bus-mastering device is
//     permitted to reach. Deriving it over KIND_HW would let a driver
//     that holds only device authority conjure new memory reach, which
//     inverts the R29 IOMMU invariant (the domain cap authorizes the
//     mapping *site*; a KIND_PAGE cap authorizes the *page*). Deriving
//     it over KIND_MEMORY makes the mint gate structurally enforce
//     "you cannot widen a device's memory reach beyond memory authority
//     you already hold".
//
//   * BASE SLOT. `KIND_MEMORY` is the design-document name for the
//     memory base kind. In the closed 16-slot runtime enum that base
//     kind is slot 4 (`KIND_PAGE` — "individual memory page or region",
//     whose dispatch chatter is literally "CAP INVOKE MEM"). kind.pdx
//     now binds `KIND_MEMORY = 4` once, so the document vocabulary and
//     the runtime enum stop drifting. The parent-kind gate below checks
//     against that constant.
//
//   * NUMERIC TAG. `0x142` is retained from the planning skeleton. The
//     `0x14x` block is the *R29-round* derived-kind block, not a
//     base-slot encoding — the existing derived tags already have no
//     correspondence between tag prefix and base slot (KIND_DRIVER=0x15
//     has base 10; KIND_DMESG=0x16 has base 15). Keeping 0x142 keeps
//     the R29 block contiguous (0x140 interrupt, 0x141 msix, 0x142 dma
//     domain, 0x143 timeline reserved) and avoids re-numbering a value
//     already published in the catalog.
//
// ---------------------------------------------------------------------
// Domain granularity — one domain per driver process (D1.b)
// ---------------------------------------------------------------------
// Per design/roadmap/next-wave-synthesis.md §10 D1.b and
// design/drivers/blob-policy.md §2: exactly ONE KIND_DMA_DOMAIN per
// driver process, shared across every device that driver claims — not
// one per device and not one per firmware image. The `bus_dev_fn` tail
// field therefore records the PCI BDF the domain is *currently bound
// to* (the first/primary function attached via the R29.M5-003
// `dma_domain_attach` path), not an exclusive ownership claim. R29.M5-003
// adds per-driver-process minting; R29.M5-004 adds the kernel-side
// context-entry switching contract. This module is the substrate both
// build on.
//
// ---------------------------------------------------------------------
// Descriptor tail (row indirection — mirrors KIND_HW_INTERRUPT #1019 and
// KIND_HW_MSIX_VECTOR #1022)
// ---------------------------------------------------------------------
// The tail is {u32, u16, u64, u8} = 104 live bits, which does not fit in
// the descriptor's 64-bit `target_ptr`. As with the two R29.M1 derived
// kinds, `target_ptr` holds a `row_id` in bits [15:0] (upper bits
// [63:16] MUST be zero) and the payload lives in a kernel-owned table.
// This is deliberately the SAME indirection shape as the M1 kinds — a
// third encoding would fragment the revoke/cascade reasoning.
//
// Row layout — `_dma_domain_table[row_id]`, 32 bytes (four u64s):
//
//   [+0]  u64:  bits [31:0]  = iommu_ctx_id  (u32; VT-d context-entry id)
//               bits [47:32] = bus_dev_fn    (u16; PCI BDF bound to the
//                                             domain — bus[15:8],
//                                             dev[7:3], fn[2:0])
//               bits [55:48] = coherency     (u8; 0 = coherent,
//                                             1 = non-coherent)
//               bits [63:56] = in_use flag   (0 = free, 1 = allocated)
//   [+8]  u64:  capacity_bytes (u64; mapped-window ceiling — the maximum
//               total byte span the domain may hold mapped at once.
//               Full 64-bit field: a 1 TiB GPU aperture must be
//               representable, so this is the one tail field that gets
//               its own word rather than a bitfield.)
//   [+16] u64:  bits [7:0]   = parent_slot (u8; cap_table slot of the
//                              KIND_MEMORY ancestor — used for O(N)
//                              cascade revocation, exactly as
//                              KIND_HW_MSIX_VECTOR stores its parent)
//               bits [23:8]  = bind_base (u16; anchor BDF of the
//                              domain's *binding* — see below)
//               bits [39:24] = bind_mask (u16; significant-bit mask of
//                              the binding)
//               bits [63:40] = reserved (must be zero)
//   [+24] u64:  context-entry state (R29.M5-004 #1039):
//               bits [7:0]   = ctx_state (DMA_CTX_NONE / _PENDING /
//                              _PROGRAMMED)
//               bits [23:8]  = ctx_bdf (u16; the BDF the context entry
//                              is programmed for; meaningless when
//                              ctx_state == DMA_CTX_NONE)
//               bits [31:24] = hw_committed (u8; 1 iff a real VT-d
//                              context entry was written for this
//                              binding — see iommu/domain_switch.pdx)
//               bits [63:32] = reserved (must be zero)
//
// ---------------------------------------------------------------------
// Binding (R29.M5-004 #1039) — which BDFs this domain may be switched onto
// ---------------------------------------------------------------------
// D1.b makes the domain per driver PROCESS, and a driver process may own
// more than one PCI function. The `bus_dev_fn` tail field records the
// anchor BDF fixed at mint; the *binding* is the set of BDFs the kernel
// will accept in a domain-switch request, encoded as a (base, mask) pair
// at [+16]:
//
//   bdf ∈ binding  ⟺  (bdf & bind_mask) == (bind_base & bind_mask)
//
// dma_tail_alloc seeds base = the minted BDF and mask = 0xFFFF, i.e. the
// binding starts as exactly one function — the narrowest legal shape.
// `dma_domain_set_binding` is the supervisor authority that widens it:
// mask 0xFFF8 admits every function of one device (the CNVi Wi-Fi/BT
// case in design/drivers/blob-policy.md §2.1), mask 0xFF00 admits a whole
// bus (a driver owning everything behind one bridge).
//
// A (base, mask) pair rather than an attach list is deliberate. An attach
// list would need unbounded per-row storage and an O(N) membership test
// on a path the kernel takes on every device arrival; the prefix form is
// O(1), fits the 24 free bits already present at [+16], and expresses the
// three shapes PCI topology actually produces (one function, one
// multifunction device, one bus). A binding that cannot be expressed as a
// prefix — a driver owning two unrelated BDFs on different buses — is
// representable only by widening the mask past what it owns, which is a
// *visible* over-grant the supervisor must justify, rather than an
// invisible one hidden inside a list.
//
// Bits [63:56] of the *packed tail word* (row [+0] minus the in_use
// byte) are structurally reserved: the canonical encoder rejects any
// caller-supplied tail word with those bits set, which is what lets the
// allocator OR in the in_use flag without a read-modify-write hazard.
//
// ---------------------------------------------------------------------
// Canonical tail word (#1037)
// ---------------------------------------------------------------------
// `dma_tail_pack(iommu_ctx_id, bus_dev_fn, coherency) -> u64` is THE
// canonical encoding of the three bitfield tail members:
//
//   tail_word = (iommu_ctx_id & 0xFFFFFFFF)
//             | ((bus_dev_fn  & 0xFFFF) << 32)
//             | ((coherency   & 0xFF)   << 48)
//
// It returns 0xFFFFFFFFFFFFFFFF on any malformed input (ctx >= 2^32,
// bdf >= 2^16, coherency > DMA_COH_MAX). That sentinel can never
// collide with a well-formed tail word because bits [63:56] of a
// well-formed word are always zero.
//
// The tail word exists for a concrete reason beyond tidiness: SysV
// argument registers cap the mint entry point at 6 arguments (see
// src/kernel/core/klog/wrappers.pdx §klog_s1_x2 for the same
// constraint). A naive mint would need
// (slot, parent_slot, rights, ctx, bdf, capacity, coherency) = 7.
// Folding the three bitfields into their on-row representation brings
// it to 5 AND makes the argument the caller passes byte-identical to
// what lands in the row — no re-shuffling between the API boundary and
// storage, so there is exactly one place the encoding is defined.
//
// `capacity_bytes` stays a separate argument because it is a full u64.
//
// ---------------------------------------------------------------------
// Rights discipline
// ---------------------------------------------------------------------
//   R_DMA_INVOKE  (0x008 = RIGHT_INVOKE)  — query ops + OP_FLUSH
//   R_DMA_REVOKE  (0x010 = RIGHT_REVOKE)  — supervisor teardown path
//   R_DMA_MINT    (0x200 = RIGHT_MINT)    — OP_MAP / OP_UNMAP (widening
//                                            or narrowing the domain's
//                                            mapped set is a MINT-class
//                                            authority, not an INVOKE)
//   R_DMA_OBSERVE (0x400 = RIGHT_OBSERVE) — OP_QUERY_FAULT + the
//                                            canonical debug printer
//   R_DMA_ALL     (0x618) — bitwise OR of the four.
//
// Unlike KIND_HW_MSIX_VECTOR (whose #1022 directive pinned rights to
// {MINT, REVOKE, INVOKE}), this kind DOES carry RIGHT_OBSERVE: the
// catalog row specifies a fault log, and the IOMMU fault stream is
// precisely an observe-class channel — a monitor should be able to read
// DMA faults without holding the authority to map pages. The handler
// gates per-op rather than with a single entry gate, so the three
// authority classes stay separable at the call site.
//
// ---------------------------------------------------------------------
// Mint discipline
// ---------------------------------------------------------------------
// `dma_cap_mint` requires the caller to hold an ancestor KIND_MEMORY cap
// (kind == 4) carrying RIGHT_MINT (0x200). The gate is
// `dma_check_parent_kind_memory`, structurally identical to
// `msix_check_parent_kind_hw_int` one lattice over: KIND_MEMORY →
// KIND_DMA_DOMAIN.
//
// ---------------------------------------------------------------------
// Revoke discipline + cascade
// ---------------------------------------------------------------------
// `dma_cap_revoke(slot)` verifies kind == 0x142, frees the row (zeroing
// all 32 bytes, which drops the in_use flag), and clears the descriptor.
// Idempotent on an already-null slot (DMA_REVOKE_ALREADY).
//
// `dma_cascade_revoke_by_parent(parent_slot) -> count` scans
// cap_table[0..255] for KIND_DMA_DOMAIN descriptors whose row records
// `parent_slot`, and revokes each. This is the real cascade edge for
// this kind: tearing down the memory authority a domain was derived
// from must not leave a live IOMMU context entry behind, because a
// stale context entry is a device with reach into memory nobody owns
// any more. R29.M5-003 wires this into driver-process teardown (process
// exit revokes the process's memory root, which cascades into its single
// domain); until then it is a supervisor entry point exercised by the
// boot witness.
//
// Cost is O(256) per parent revoke — identical to the MSI-X cascade and
// far below any hot-path threshold at R29 substrate stage.
//
// ---------------------------------------------------------------------
// Table sizing
// ---------------------------------------------------------------------
// DMA_DOMAIN_MAX = 32. One domain per driver process (D1.b) and the
// driver descriptor table (src/kernel/core/driver/driver_table.pdx) is
// itself 32 slots, so 32 domains is exactly the reachable ceiling — a
// larger table could not be filled by legal minting. Storage:
// 32 * 32 = 1024 bytes .bss, align 64.

module KindDmaDomain = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================

  // Runtime base kind (LAM kind-hint slot): KIND_MEMORY = KIND_PAGE = 4.
  // See kind.pdx for the KIND_MEMORY binding and the naming rationale.
  pub let KIND_DMA_DOMAIN_BASE : u64 = 4

  // Derived-kind tag. Value 0x142 (decimal 322); third entry in the R29
  // derived-kind block (0x140 interrupt, 0x141 msix, 0x142 dma domain).
  pub let KIND_DMA_DOMAIN : u64 = 0x142

  // Parent derived/base kind required by the mint gate: KIND_MEMORY.
  pub let KIND_DMA_PARENT : u64 = 4

  // ============================================================================
  // Rights (subset legal on a KIND_DMA_DOMAIN capability)
  // ============================================================================

  pub let R_DMA_INVOKE  : u64 = 0x008    // matches Rights.RIGHT_INVOKE
  pub let R_DMA_REVOKE  : u64 = 0x010    // matches Rights.RIGHT_REVOKE
  pub let R_DMA_MINT    : u64 = 0x200    // matches Rights.RIGHT_MINT
  pub let R_DMA_OBSERVE : u64 = 0x400    // matches Rights.RIGHT_OBSERVE
  pub let R_DMA_ALL     : u64 = 0x618    // INVOKE|REVOKE|MINT|OBSERVE

  // ============================================================================
  // Table caps + field domains
  // ============================================================================

  pub let DMA_DOMAIN_MAX  : u64 = 32
  pub let DMA_ROW_BYTES   : u64 = 32

  // coherency domain: 0 = coherent (IOMMU-coherent; no explicit cache
  // maintenance required around DMA), 1 = non-coherent (driver must
  // issue cache maintenance around every buffer handoff). Any other
  // value is rejected at encode time.
  pub let DMA_COH_COHERENT     : u64 = 0
  pub let DMA_COH_NON_COHERENT : u64 = 1
  pub let DMA_COH_MAX          : u64 = 1

  // ============================================================================
  // Return codes
  //
  // Block 0xFFFFFFD5..0xFFFFFFDF — disjoint from HW_INT_* (0xFFFFFFF7..
  // 0xFFFFFFFF) and MSIX_* (0xFFFFFFE7..0xFFFFFFEF) so a witness failure
  // names its originating kind unambiguously.
  // ============================================================================

  pub let DMA_TAIL_OK             : u64 = 0
  pub let DMA_TAIL_ENOSPC         : u64 = 0xFFFFFFDF
  pub let DMA_TAIL_BAD_ARG        : u64 = 0xFFFFFFDE
  pub let DMA_TAIL_BAD_COHERENCY  : u64 = 0xFFFFFFDD

  pub let DMA_MINT_OK             : u64 = 0
  pub let DMA_MINT_BAD_PARENT     : u64 = 0xFFFFFFDC
  pub let DMA_MINT_BAD_RIGHTS     : u64 = 0xFFFFFFDB
  pub let DMA_MINT_ENOSPC         : u64 = 0xFFFFFFDA
  pub let DMA_MINT_BAD_ARG        : u64 = 0xFFFFFFD9
  pub let DMA_MINT_BAD_COHERENCY  : u64 = 0xFFFFFFD8

  pub let DMA_REVOKE_OK           : u64 = 0
  pub let DMA_REVOKE_BAD_SLOT     : u64 = 0xFFFFFFD7
  pub let DMA_REVOKE_WRONG_KIND   : u64 = 0xFFFFFFD6
  pub let DMA_REVOKE_ALREADY      : u64 = 0xFFFFFFD5

  // R29.M5-004 (#1039) — row [+24] context-entry state + row [+16]
  // binding accessors. Codes continue the same downward block
  // (0xFFFFFFD0..0xFFFFFFD4), still disjoint from MSIX_* / HW_INT_*.
  pub let DMA_CTX_OK              : u64 = 0
  pub let DMA_CTX_ERR_BAD_ROW     : u64 = 0xFFFFFFD4
  pub let DMA_CTX_ERR_BAD_ARG     : u64 = 0xFFFFFFD3
  pub let DMA_BIND_OK             : u64 = 0
  pub let DMA_BIND_ERR_BAD_ROW    : u64 = 0xFFFFFFD2
  pub let DMA_BIND_ERR_BAD_ARG    : u64 = 0xFFFFFFD1

  // ============================================================================
  // Context-entry state machine (row [+24] bits [7:0]) — R29.M5-004
  //
  //   NONE       — no IOMMU context entry is attributed to this domain.
  //   PENDING    — a switch/unswitch is mid-flight. Any *further* switch
  //                request against a PENDING row is refused rather than
  //                queued: a context entry that two callers believe they
  //                are programming is exactly the split-brain the kernel
  //                owns this operation to prevent.
  //   PROGRAMMED — the domain owns the context entry for ctx_bdf.
  //
  // Legal edges (enforced in iommu/domain_switch.pdx):
  //   NONE       -> PENDING -> PROGRAMMED       (switch)
  //   PROGRAMMED -> PENDING -> PROGRAMMED       (re-point onto a new BDF)
  //   PROGRAMMED -> PENDING -> NONE             (unswitch)
  // PENDING is never a resting state; every path that sets it either
  // completes to a resting state or restores the prior word.
  // ============================================================================

  pub let DMA_CTX_NONE            : u64 = 0
  pub let DMA_CTX_PENDING         : u64 = 1
  pub let DMA_CTX_PROGRAMMED      : u64 = 2
  pub let DMA_CTX_STATE_MAX       : u64 = 2

  // Sentinel returned by dma_tail_pack and every decoder on malformed
  // input / dead row. Cannot collide with a well-formed tail word (whose
  // bits [63:56] are always zero) nor with a well-formed field value.
  pub let DMA_DECODE_BAD          : u64 = 0xFFFFFFFFFFFFFFFF

  // ============================================================================
  // Ops (op_arg[7:0] = op_code) and their required right
  // ============================================================================

  pub let DMA_OP_QUERY_CTX_ID    : u64 = 0   // INVOKE  -> iommu_ctx_id
  pub let DMA_OP_QUERY_BDF       : u64 = 1   // INVOKE  -> bus_dev_fn
  pub let DMA_OP_QUERY_CAPACITY  : u64 = 2   // INVOKE  -> capacity_bytes
  pub let DMA_OP_QUERY_COHERENCY : u64 = 3   // INVOKE  -> coherency
  pub let DMA_OP_QUERY_PARENT    : u64 = 4   // INVOKE  -> parent_slot
  pub let DMA_OP_MAP             : u64 = 5   // MINT    -> UNSUPPORTED (M5-003)
  pub let DMA_OP_UNMAP           : u64 = 6   // MINT    -> UNSUPPORTED (M5-003)
  pub let DMA_OP_FLUSH           : u64 = 7   // INVOKE  -> UNSUPPORTED (M5-004)
  pub let DMA_OP_QUERY_FAULT     : u64 = 8   // OBSERVE -> UNSUPPORTED (M5-004)
  pub let DMA_OP_DEBUG_PRINT     : u64 = 9   // OBSERVE -> canonical printer

  // ============================================================================
  // Backing table (.bss, align 64)
  //
  // 32 rows * 32 bytes = 1024 bytes = 128 u64s. .bss zero-init means
  // every row starts with in_use=0 (byte 7 of the [+0] u64), which is
  // the free sentinel dma_tail_alloc scans for.
  // ============================================================================

  pub let mut _dma_domain_table : [u64; 128] = uninit @align(64)

  // ============================================================================
  // Canonical debug-printer strings (.rodata)
  //
  // Declared here rather than in tags.pdx because they are KV *keys* for
  // the printer, not dispatch-chatter tags. tags.pdx owns the single
  // KIND_DMA_DOMAIN dispatch tag (cap_dma_dom_msg).
  // ============================================================================

  pub let dma_dbg_msg  : [u8; 15] = "DMA DOMAIN ROW\0"
  pub let dma_k_row    : [u8; 4]  = "row\0"
  pub let dma_k_ctx    : [u8; 4]  = "ctx\0"
  pub let dma_k_bdf    : [u8; 4]  = "bdf\0"
  pub let dma_k_cap    : [u8; 4]  = "cap\0"
  pub let dma_k_coh    : [u8; 4]  = "coh\0"

  // ============================================================================
  // dma_tail_pack(iommu_ctx_id, bus_dev_fn, coherency) -> u64
  //
  // Canonical tail-word encoder (#1037). Returns the packed word, or
  // DMA_DECODE_BAD (0xFF..FF) on malformed input.
  //
  // SysV ABI: rdi=iommu_ctx_id, rsi=bus_dev_fn, rdx=coherency.
  // ============================================================================

  pub let dma_tail_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (iommu_ctx_id: u64) (bus_dev_fn: u64) (coherency: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M5-002 (#1037): canonical KIND_DMA_DOMAIN tail-word encoder. Validate iommu_ctx_id < 2^32 (shr 32 must be zero), bus_dev_fn < 2^16 (shr 16 must be zero), coherency <= DMA_COH_MAX (1). Any violation returns DMA_DECODE_BAD = 0xFFFFFFFFFFFFFFFF, which cannot collide with a well-formed word because bits [63:56] of a well-formed word are always zero. Pack: (ctx & 0xFFFFFFFF) | ((bdf & 0xFFFF) << 32) | ((coh & 0xFF) << 48). Bits [63:56] left clear for the allocator's in_use flag. Pure leaf; no memory effect.",
      block: {
        // Validate iommu_ctx_id < 2^32.
        mov r10, rdi;
        shr r10, 32;
        cmp r10, 0;
        jne dma_pack_bad;

        // Validate bus_dev_fn < 2^16.
        mov r10, rsi;
        shr r10, 16;
        cmp r10, 0;
        jne dma_pack_bad;

        // Validate coherency <= DMA_COH_MAX.
        cmp rdx, 1;
        ja  dma_pack_bad;

        // rax = ctx & 0xFFFFFFFF
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;

        // |= (bdf & 0xFFFF) << 32
        mov r10, rsi;
        mov r11, 0xFFFF;
        and r10, r11;
        shl r10, 32;
        or  rax, r10;

        // |= (coh & 0xFF) << 48
        mov r10, rdx;
        mov r11, 0xFF;
        and r10, r11;
        shl r10, 48;
        or  rax, r10;
        ret;

      dma_pack_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // dma_tail_word_ctx_id(tail_word)   -> u64  (bits [31:0])
  // dma_tail_word_bdf(tail_word)      -> u64  (bits [47:32])
  // dma_tail_word_coherency(tail_word)-> u64  (bits [55:48])
  //
  // Pure field extractors over a packed tail word — the decode half of
  // the #1037 round-trip. These operate on the WORD, not on a row, so
  // an encoder round-trip can be asserted without touching the table.
  // ============================================================================

  pub let dma_tail_word_ctx_id : (u64) -> u64 !{} @{} =
    fn (tail_word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M5-002 (#1037): extract iommu_ctx_id from a packed tail word, bits [31:0]. Pure leaf. No validity check — the word is caller-owned; row-level validity is dma_tail_decode_ctx_id's job.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  pub let dma_tail_word_bdf : (u64) -> u64 !{} @{} =
    fn (tail_word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M5-002 (#1037): extract bus_dev_fn from a packed tail word, bits [47:32]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    }

  pub let dma_tail_word_coherency : (u64) -> u64 !{} @{} =
    fn (tail_word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M5-002 (#1037): extract coherency from a packed tail word, bits [55:48]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 48;
        mov r10, 0xFF;
        and rax, r10;
        ret
      }
    }

  // ============================================================================
  // dma_tail_alloc(tail_word, capacity_bytes, parent_slot) -> u64
  //
  // Allocates a free row, populates it, returns row_id.
  //
  // Failure codes:
  //   DMA_TAIL_BAD_ARG       — tail_word bits [63:56] non-zero, or
  //                            capacity_bytes == 0, or parent_slot >= 256
  //   DMA_TAIL_BAD_COHERENCY — tail_word coherency field > DMA_COH_MAX
  //   DMA_TAIL_ENOSPC        — no free row
  //
  // A zero capacity_bytes is rejected rather than silently accepted: a
  // domain that may map nothing is indistinguishable from no domain at
  // all, and admitting it would let a caller mint a cap whose only
  // effect is to consume a scarce IOMMU context id.
  //
  // SysV ABI: rdi=tail_word, rsi=capacity_bytes, rdx=parent_slot.
  // ============================================================================

  pub let dma_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tail_word: u64) (capacity_bytes: u64) (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-001 (#1036) + R29.M5-004 (#1039): allocate a free _dma_domain_table row + populate it. Gates, in order: tail_word bits [63:56] non-zero -> DMA_TAIL_BAD_ARG (those bits belong to the in_use flag the allocator ORs in); coherency field (bits [55:48]) > 1 -> DMA_TAIL_BAD_COHERENCY; capacity_bytes == 0 -> DMA_TAIL_BAD_ARG; parent_slot >= 256 -> DMA_TAIL_BAD_ARG. Low-first row scan over 32 rows of 32 bytes: row free iff in_use byte (byte 7 of [row+0]) is zero. Exhaustion -> DMA_TAIL_ENOSPC. Claim: [row+0] = tail_word | (1 << 56); [row+8] = capacity_bytes; [row+16] = (parent_slot & 0xFF) | (minted_bdf << 8) | (0xFFFF << 24) — the binding is seeded to exactly the minted BDF (mask 0xFFFF), the narrowest legal shape, so a domain can never be switched onto a function the supervisor did not name at mint without an explicit dma_domain_set_binding widening; [row+24] = 0 (ctx_state = DMA_CTX_NONE). minted_bdf is read back out of the tail word (bits [47:32]) rather than taken as a seventh argument, so there is exactly one source of truth for the anchor BDF. Callee-save args parked in r13/r14/r15 across the scan (pushed/popped). .bss zero-init preserves the in_use=0 invariant at boot. Same shape as msix_tail_alloc (kind_hw_msix_vector.pdx).",
      block: {
        // Gate: tail_word bits [63:56] must be zero (reserved for in_use).
        mov r10, rdi;
        shr r10, 56;
        cmp r10, 0;
        jne dma_alloc_bad_arg;

        // Gate: coherency field (bits [55:48]) <= DMA_COH_MAX.
        mov r10, rdi;
        shr r10, 48;
        mov r11, 0xFF;
        and r10, r11;
        cmp r10, 1;
        ja  dma_alloc_bad_coh;

        // Gate: capacity_bytes != 0.
        cmp rsi, 0;
        je  dma_alloc_bad_arg;

        // Gate: parent_slot < 256.
        cmp rdx, 256;
        jae dma_alloc_bad_arg;

        // Park args across the scan.
        push r13;
        push r14;
        push r15;
        mov r13, rdi;                      // tail_word
        mov r14, rsi;                      // capacity_bytes
        mov r15, rdx;                      // parent_slot

        // Row cursor.
        lea r8, [rip + _dma_domain_table];
        xor rcx, rcx;

      dma_alloc_scan:
        cmp rcx, 32;                       // DMA_DOMAIN_MAX
        jae dma_alloc_none;
        mov rax, [r8];                     // row header
        mov r10, rax;
        shr r10, 56;                       // in_use byte
        cmp r10, 0;
        je  dma_alloc_found;
        add r8, 32;                        // DMA_ROW_BYTES
        add rcx, 1;
        jmp dma_alloc_scan;

      dma_alloc_found:
        // [+0] = tail_word | (1 << 56).
        mov rax, r13;
        mov r10, 1;
        shl r10, 56;
        or  rax, r10;
        mov [r8 + 0], rax;

        // [+8] = capacity_bytes (full u64).
        mov rax, r14;
        mov [r8 + 8], rax;

        // [+16] = parent_slot | (bind_base << 8) | (bind_mask << 24).
        //   bind_base = the minted BDF, read back from the tail word's
        //               bits [47:32] so the anchor has one source of truth.
        //   bind_mask = 0xFFFF — binding starts at exactly one function.
        mov rax, r15;
        mov r10, 0xFF;
        and rax, r10;                      // parent_slot
        mov r11, r13;                      // tail_word
        shr r11, 32;
        mov r10, 0xFFFF;
        and r11, r10;                      // minted bdf
        shl r11, 8;
        or  rax, r11;                      // | bind_base << 8
        mov r11, 0xFFFF;
        shl r11, 24;
        or  rax, r11;                      // | bind_mask << 24
        mov [r8 + 16], rax;

        // [+24] = 0 -> ctx_state DMA_CTX_NONE, ctx_bdf 0, hw_committed 0.
        xor rax, rax;
        mov [r8 + 24], rax;

        mov rax, rcx;                      // return row_id

        pop r15;
        pop r14;
        pop r13;
        ret;

      dma_alloc_none:
        pop r15;
        pop r14;
        pop r13;
        mov rax, 0xFFFFFFDF;               // DMA_TAIL_ENOSPC
        ret;

      dma_alloc_bad_coh:
        mov rax, 0xFFFFFFDD;               // DMA_TAIL_BAD_COHERENCY
        ret;

      dma_alloc_bad_arg:
        mov rax, 0xFFFFFFDE;               // DMA_TAIL_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // dma_tail_free(row_id) -> ()
  //
  // Zeros the row at row_id, releasing it (the zeroing is what clears
  // in_use). No-op if row_id >= DMA_DOMAIN_MAX.
  // ============================================================================

  pub let dma_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-001 (#1036): row_id >= DMA_DOMAIN_MAX -> silent no-op. Otherwise row = &_dma_domain_table + row_id*32 via shl 5. Zero all four u64s — zeroing [row+0] is what clears the in_use byte, so free and scrub are the same operation and no stale iommu_ctx_id / bdf survives in the table. Leaf function.",
      block: {
        cmp rdi, 32;                       // DMA_DOMAIN_MAX
        jae dma_free_done;

        mov r8, rdi;
        shl r8, 5;                         // row_id * 32
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        xor rax, rax;
        mov [r8 + 0], rax;
        mov [r8 + 8], rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;

      dma_free_done:
        ret
      }
    }

  // ============================================================================
  // dma_tail_valid(row_id) -> u64
