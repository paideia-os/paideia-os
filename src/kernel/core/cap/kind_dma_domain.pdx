        shl r8, 5;
        lea r9, [rip + _dma_domain_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dma_valid_no;

        mov rax, 1;
        ret;

      dma_valid_no:
        xor rax, rax;
        ret
