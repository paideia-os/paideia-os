// src/kernel/core/cap/kind_i2c_bus.pdx — R30.M5-001 (#1070)
//
// KIND_I2C_BUS derived kind: the I²C controller capability.
//
// ---------------------------------------------------------------------
// WHY A BUS NEEDS ITS OWN KIND, AND WHY IT IS NOT THE ONE DRIVERS HOLD
// ---------------------------------------------------------------------
// I²C is a SHARED BUS. Every peripheral the vendor hung on it sits on
// the same two wires, and the controller can address any of them. A
// component that holds "the I²C controller" therefore holds every
// device on it: the touchpad driver that holds the controller can also
// talk to the fingerprint reader, the sensor hub, the battery gauge and
// whatever else the board designer found a free address for.
//
// That is why this milestone lands TWO kinds and not one. This file is
// the CONTROLLER capability — what a bus driver holds, what authorises
// bringing the controller up, and what authorises handing out reach to
// the individual devices behind it. R30.M5-002 (#1071) lands
// KIND_I2C_SLAVE, derived over this kind, which is what a DEVICE driver
// holds: exactly one address, and no way to name another.
//
// The split is the security property. If drivers held bus capabilities,
// per-device isolation on I²C would not exist at all — it would be a
// convention, enforced by each driver's good manners, on a bus where a
// single misaddressed transaction can put a neighbouring device into a
// state its own driver cannot explain.
//
// ---------------------------------------------------------------------
// WHAT THIS KIND DELIBERATELY DOES NOT AUTHORISE
// ---------------------------------------------------------------------
// Holding a KIND_I2C_BUS does NOT authorise a transaction on the wire.
// There is no read op, no write op, and no rights bit for either — see
// the RIGHTS section. The only reach it confers is (a) reading the
// bus's own recorded properties and (b) MINTING slave capabilities
// under it.
//
// This is deliberate and it is the whole point. If the bus capability
// could transact, the slave capability would be an optional courtesy: a
// controller driver could simply address any device directly and the
// per-device isolation the next file builds would be decorative. Making
// the bus cap non-transacting means the ONLY path to the wire is
// through a slave capability that names one address.
//
// (The controller's registers are a separate authority: they live
// behind the KIND_DEVICE capability's BARs, which R30.M5-003 (#1072)
// maps. Bringing the controller up and talking to a device on it are
// different powers, and this kind is the second one's root, not the
// first one's.)
//
// ---------------------------------------------------------------------
// DERIVATION — over KIND_DEVICE (base slot 10)
// ---------------------------------------------------------------------
// An I²C bus exists because a PCI function exists: on this platform the
// LPSS I²C controllers are PCI devices under the PCH. A bus capability
// is therefore strictly downstream of the device capability for that
// function, and the gate demands `kind == KIND_DEVICE (10)` carrying
// RIGHT_MINT. Without it nothing could stop a component from
// manufacturing a bus out of nothing and then minting slaves on it.
//
// A NOTE ON WHICH DEVICE TAG. R22 defines two names for the PCI device
// authority: the base slot `KIND_DEVICE = 10` (cap/kind.pdx), which the
// dispatcher routes and which real descriptors carry, and the derived
// tag `KIND_PCI_DEV = 0x30` (cap/device_cap.pdx), whose mint path
// `device_cap_mint` is still the R22-M3 scaffolding that validates its
// arguments and writes NO DESCRIPTOR. Gating on 0x30 would therefore be
// gating on a tag no descriptor in the running kernel carries — a
// vacuous check that passes review and refuses nothing, because nothing
// can satisfy it either. This gate uses slot 10, which is the same
// choice `opregion_check_parent_base` makes for KIND_MEMORY (4) and
// KIND_IO_PORT (11), and it is non-vacuous: the boot witness both
// satisfies it and is refused by it.
//
// ---------------------------------------------------------------------
// CONTROLLER IDENTITY IS INHERITED, NEVER ARGUED
// ---------------------------------------------------------------------
// `i2c_bus_cap_mint` takes NO controller argument. The controller
// identity written into the row is the parent KIND_DEVICE descriptor's
// own `target_ptr` — the BDF key R22 stamped there — read out of the
// descriptor the gate just checked.
//
// This is R30.M4-003's discipline (#1068), where the GSI came from the
// parent KIND_HW_INTERRUPT row rather than from the caller, and it is
// load-bearing for the same reason: a field that identifies WHICH
// PHYSICAL THING the authority is about must come from the authority
// that was checked. If the caller supplied it, a holder of device A's
// capability could mint a bus that claims to be device B's controller,
// and every later audit record, every debug dump and every operator
// reconstructing "which driver was talking to which controller" would
// be reading the caller's claim rather than the checked fact.
//
// ---------------------------------------------------------------------
// BUS SPEED — an enumeration, not a number
// ---------------------------------------------------------------------
// `max_speed_hz` IS an argument, because it is a property of the board
// (trace length, pull-up sizing, what the slowest part on the bus can
// follow) rather than of the controller. But it is validated against
// the four rates the I²C specification defines, and anything else is
// refused with I2C_BUS_MINT_BAD_SPEED:
//
//   100 000 Hz    Standard mode
//   400 000 Hz    Fast mode
//   1 000 000 Hz  Fast mode Plus
//   3 400 000 Hz  High-speed mode
//
// Admitting an arbitrary integer would make this field a request to
// program a clock divider to a value nobody validated — the failure
// mode is not a refusal but a bus that transacts and corrupts, which is
// the worst kind. Refusing at mint means the divider computation
// R30.M5-003 will write has a closed domain.
//
// ---------------------------------------------------------------------
// DESCRIPTOR TAIL — row indirection (the R29/R30 family shape)
// ---------------------------------------------------------------------
// The tail is {parent_slot:u8, controller_id:u64, max_speed_hz:u64,
// num_slaves:u64} — far past the descriptor's 64-bit target_ptr — so
// `target_ptr` holds a `row_id` in bits [15:0] and the payload lives in
// a kernel-owned private table, exactly as KIND_HW_INTERRUPT (#1019),
// KIND_DMA_DOMAIN (#1036), KIND_OP_REGION (#1061) and KIND_ACPI_EVENT
// (#1068) do. A sixth encoding would fragment the revoke/cascade
// reasoning across the whole family.
//
// Row layout — `_i2c_bus_table[row_id]`, 32 bytes (four u64s):
//
//   [+0]  u64:  bits [7:0]   = parent_slot   (cap_table slot of the
//                                             KIND_DEVICE this bus was
//                                             derived from)
//               bits [55:8]  = reserved (must be zero)
//               bits [63:56] = in_use        (0 = free, 1 = allocated)
//   [+8]  u64:  controller_id — the parent KIND_DEVICE descriptor's
//               target_ptr (a bdf_pack key). INHERITED, never argued.
//               Zero is refused: a device capability with no identity
//               is not a controller.
//   [+16] u64:  max_speed_hz — one of the four validated rates.
//   [+24] u64:  num_slaves — count of LIVE KIND_I2C_SLAVE rows derived
//               from this bus. Maintained by kind_i2c_slave.o through
//               `i2c_bus_note_slave_added` / `_removed`, which are the
//               only two mutators and are exported for exactly that.
//
// Bits [63:56] of a caller-supplied header word are structurally
// reserved: `i2c_bus_tail_pack` refuses to produce one with those bits
// set and `i2c_bus_tail_alloc` refuses to accept one, which is what
// lets the allocator OR in the in_use flag with no read-modify-write
// hazard. Same device as `dma_tail_alloc` and `opregion_tail_alloc`.
//
// ---------------------------------------------------------------------
// RIGHTS
// ---------------------------------------------------------------------
//   R_I2C_BUS_INVOKE  (0x008 = RIGHT_INVOKE)  — the query ops
//   R_I2C_BUS_REVOKE  (0x010 = RIGHT_REVOKE)  — supervisor teardown
//   R_I2C_BUS_MINT    (0x200 = RIGHT_MINT)    — DERIVE a slave
//   R_I2C_BUS_OBSERVE (0x400 = RIGHT_OBSERVE) — the canonical printer
//   R_I2C_BUS_ALL     (0x618) — bitwise OR of the four.
//
// THERE IS NO READ AND NO WRITE BIT, and their absence is the rights
// half of the "does not authorise a transaction" argument above. A
// rights bitmask that carried them would be an invitation for a later
// milestone to add a bus-level transfer op that consumes them, and at
// that moment per-device isolation would quietly stop being enforced
// anywhere. Leaving them unrepresentable on this kind means such an op
// cannot be added without also changing this line, which is a review a
// human will notice.
//
// MINT is separable from INVOKE on purpose: a bus enumerator that
// publishes slave capabilities during bring-up and then drops MINT
// leaves behind a capability that can still be queried but can never
// widen the device set again.
//
// ---------------------------------------------------------------------
// REVOKE + CASCADE
// ---------------------------------------------------------------------
// `i2c_bus_cap_revoke(slot)` verifies kind == 0x152, CASCADES to every
// slave derived from this bus, then frees and scrubs the bus row and
// clears the descriptor. Idempotent on a null slot.
//
// The cascade runs FIRST and it is not optional. A KIND_I2C_SLAVE row
// that outlived its bus would be a live, addressable handle to a device
// on a controller nobody owns any more — and because slave rows carry
// the bus's row_id, a later mint that reused that row_id would silently
// re-attach the orphan to a DIFFERENT bus. That is the same failure
// KIND_HW_MSIX_VECTOR's cascade (#1022) exists to prevent, and the
// cascade here is that pair's shape: the parent's revoke calls the
// child kind's `i2c_slave_cascade_revoke_by_bus`, which sweeps both the
// descriptors and the rows.
//
// A single-level cascade suffices, unlike KIND_OP_REGION's fixed point:
// KIND_I2C_SLAVE is a LEAF of the derivation lattice — it carries no
// MINT right at all — so there are no grandchildren to reach.
//
// ---------------------------------------------------------------------
// TABLE SIZING
// ---------------------------------------------------------------------
// I2C_BUS_MAX = 8. A PCH exposes on the order of six LPSS I²C
// controllers (plus SMBus, which is a different kind); eight covers
// every part in the T14 G4 class with room and matches the R30.M4
// fixture-scale sizing. Storage: 8 * 32 = 256 bytes .bss, align 64.
//
// tools/build.sh asserts with `objdump -r` that no kernel object other
// than kind_i2c_bus.o relocates against `_i2c_bus_table`, which is what
// upgrades "the KIND_DEVICE gate is the only path to a bus row" from a
// claim about this file to a property of the whole kernel.

module KindI2cBus = structure {

  // ==========================================================================
  // Kind tags
  //
  // 0x152 is the third entry in the R30 derived-kind block, after
  // KIND_OP_REGION (0x150) and KIND_ACPI_EVENT (0x151). As with every
  // derived tag it sits above the 4-bit base-slot range, so the LAM
  // kind-hint is unaffected and the dispatcher's full-u64 comparison
  // coexists with the slot-10 KIND_DEVICE handler.
  // ==========================================================================

  pub let KIND_I2C_BUS : u64 = 0x152     // derived-kind tag (decimal 338)

  // The base kind a bus must derive over. See the header note on why
  // this is the base slot 10 and not the R22 derived tag 0x30.
  pub let I2C_BUS_BASE_KIND : u64 = 10   // = KIND_DEVICE

  // ==========================================================================
  // Rights
  // ==========================================================================

  pub let R_I2C_BUS_INVOKE  : u64 = 0x008
  pub let R_I2C_BUS_REVOKE  : u64 = 0x010
  pub let R_I2C_BUS_MINT    : u64 = 0x200
  pub let R_I2C_BUS_OBSERVE : u64 = 0x400
  pub let R_I2C_BUS_ALL     : u64 = 0x618

  // ==========================================================================
  // The four I²C bus rates. Nothing else is admitted.
  // ==========================================================================

  pub let I2C_SPEED_STANDARD  : u64 = 100000
  pub let I2C_SPEED_FAST      : u64 = 400000
  pub let I2C_SPEED_FAST_PLUS : u64 = 1000000
  pub let I2C_SPEED_HIGH      : u64 = 3400000

  // ==========================================================================
  // Table caps
  // ==========================================================================

  pub let I2C_BUS_MAX       : u64 = 8
  pub let I2C_BUS_ROW_BYTES : u64 = 32

  // ==========================================================================
  // Return codes
  //
  // Block 0xFFFFFF80..0xFFFFFF8F — disjoint from ACPI_EVT_*
  // (0xFFFFFF90..9F), DRV_RESTART_* (0xFFFFFFB5..BE), OPREG_*
  // (0xFFFFFFC2..CF), DMA_* (0xFFFFFFD5..DF), MSIX_* (0xFFFFFFE7..EF)
  // and HW_INT_* (0xFFFFFFF7..FF), and disjoint from the I2C_SLAVE_*
  // block (0xFFFFFF70..7F) directly below it, so a witness failure
  // names its originating kind unambiguously.
  // ==========================================================================

  pub let I2C_BUS_OK                    : u64 = 0
  pub let I2C_BUS_TAIL_ENOSPC           : u64 = 0xFFFFFF8F
  pub let I2C_BUS_TAIL_BAD_ARG          : u64 = 0xFFFFFF8E
  pub let I2C_BUS_MINT_BAD_PARENT       : u64 = 0xFFFFFF8D
  pub let I2C_BUS_MINT_BAD_RIGHTS       : u64 = 0xFFFFFF8C
  pub let I2C_BUS_MINT_BAD_ARG          : u64 = 0xFFFFFF8B
  pub let I2C_BUS_MINT_ENOSPC           : u64 = 0xFFFFFF8A
  pub let I2C_BUS_MINT_BAD_SPEED        : u64 = 0xFFFFFF89
  pub let I2C_BUS_MINT_BAD_CONTROLLER   : u64 = 0xFFFFFF88
  pub let I2C_BUS_REVOKE_BAD_SLOT       : u64 = 0xFFFFFF87
  pub let I2C_BUS_REVOKE_WRONG_KIND     : u64 = 0xFFFFFF86
  pub let I2C_BUS_REVOKE_ALREADY        : u64 = 0xFFFFFF85
  pub let I2C_BUS_REVOKE_SLAVES_LIVE    : u64 = 0xFFFFFF84
  pub let I2C_BUS_COUNT_BAD_ROW         : u64 = 0xFFFFFF83

  // Cannot collide with a well-formed header word (bits [63:56] of a
  // well-formed word are zero before the allocator sets in_use, and
  // 0xFF there would mean 255 concurrent uses of a 1-bit flag).
  pub let I2C_BUS_DECODE_BAD            : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Ops (op_arg[7:0] = op_code) and their required right
  //
  // QUERY ONLY. There is deliberately no transfer op — see the module
  // header. R30.M5-004 (#1073) puts transfers on the SLAVE capability,
  // where the address is a property of the row rather than of the call.
  // ==========================================================================

  pub let I2C_BUS_OP_QUERY_CONTROLLER : u64 = 0   // INVOKE  -> controller_id
  pub let I2C_BUS_OP_QUERY_SPEED      : u64 = 1   // INVOKE  -> max_speed_hz
  pub let I2C_BUS_OP_QUERY_SLAVES     : u64 = 2   // INVOKE  -> num_slaves
  pub let I2C_BUS_OP_QUERY_PARENT     : u64 = 3   // INVOKE  -> parent_slot
  pub let I2C_BUS_OP_DEBUG_PRINT      : u64 = 4   // OBSERVE -> printer

  // ==========================================================================
  // Backing table (.bss, align 64) — MODULE-PRIVATE BY CONSTRUCTION.
  //
  // 8 rows * 32 bytes = 256 bytes = 32 u64s. .bss zero-init means every
  // row starts in_use = 0, which is the free sentinel the allocator
  // scans for.
  // ==========================================================================

  pub let mut _i2c_bus_table : [u64; 32] = uninit @align(64)

  // ==========================================================================
  // Canonical debug-printer strings (.rodata)
  // ==========================================================================

  pub let i2cb_dbg_msg : [u8; 12] = "I2C BUS ROW\0"
  pub let i2cb_k_row   : [u8; 4]  = "row\0"
  pub let i2cb_k_ctl   : [u8; 4]  = "ctl\0"
  pub let i2cb_k_spd   : [u8; 4]  = "spd\0"
  pub let i2cb_k_slv   : [u8; 4]  = "slv\0"

  // ==========================================================================
  // i2c_bus_table_reset() -> ()
  // ==========================================================================

  pub let i2c_bus_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): zero all 32 u64s of _i2c_bus_table, returning every row to the free state the .bss zero-init established. Exists so the boot witness can start from a known table rather than from whatever an earlier fixture left behind, and so a failing witness cannot poison a later one -- the same posture acpi_evt_table_reset established in #1068. Straight-line stores rather than a loop: 32 stores are cheaper than a loop and leave nothing to get an off-by-one wrong in. Leaf. Reserved labels: none.",
      block: {
        lea r8, [rip + _i2c_bus_table];
        xor rax, rax;
        xor rcx, rcx;

      i2cb_tr_loop:
        cmp rcx, 32;
        jae i2cb_tr_done;
        mov [r8], rax;
        add r8, 8;
        add rcx, 1;
        jmp i2cb_tr_loop;

      i2cb_tr_done:
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_speed_valid(hz) -> u64
  //
  // 1 iff hz is one of the four rates the I²C specification defines.
  // ==========================================================================

  pub let i2c_bus_speed_valid : (u64) -> u64 !{} @{} =
    fn (hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-001 (#1070): 1 iff hz is 100000 (Standard), 400000 (Fast), 1000000 (Fast Plus) or 3400000 (High-speed). Written as an explicit compare chain against the four named rates rather than as a range test, because a range test would admit every value between them and this field's whole purpose is to have a CLOSED domain: it becomes a clock-divider computation in R30.M5-003, and a divider derived from a rate nobody validated does not refuse -- it transacts and corrupts, which is the failure mode with no symptom at the point of the mistake. Pure leaf. Reserved labels: i2cb_sv_.",
      block: {
        mov r10, 100000;
        cmp rdi, r10;
        je i2cb_sv_yes;
        mov r10, 400000;
        cmp rdi, r10;
        je i2cb_sv_yes;
        mov r10, 1000000;
        cmp rdi, r10;
        je i2cb_sv_yes;
        mov r10, 3400000;
        cmp rdi, r10;
        je i2cb_sv_yes;

        xor rax, rax;
        ret;

      i2cb_sv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_rights_valid(rights) -> u64
  // ==========================================================================

  pub let i2c_bus_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-001 (#1070): 1 iff (rights & R_I2C_BUS_ALL) == rights. R_I2C_BUS_ALL = 0x618 (INVOKE|REVOKE|MINT|OBSERVE). A SUBSET test, not an equality, so a strictly weaker bus capability is expressible -- an enumerator that has finished publishing slaves and dropped MINT still holds a queryable bus it can no longer widen. RIGHT_READ (0x01) and RIGHT_WRITE (0x02) are outside the mask on purpose: this kind authorises no transaction on the wire, and a bitmask that admitted them would leave room for a later bus-level transfer op to consume them, at which point per-device isolation would stop being enforced anywhere. Pure leaf. Reserved labels: i2cb_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x618;
        and rax, r10;
        cmp rax, rdi;
        jne i2cb_rv_no;
        mov rax, 1;
        ret;

      i2cb_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_check_parent_device(parent_slot) -> u64
  //
  // THE DERIVATION GATE. 1 iff cap_table[parent_slot] is a KIND_DEVICE
  // carrying RIGHT_MINT.
  // ==========================================================================

  pub let i2c_bus_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): the KIND_I2C_BUS derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_DEVICE (10) AND (rights & RIGHT_MINT 0x200) != 0. An I2C bus exists because a PCI function exists -- the LPSS controllers are PCI devices under the PCH -- so bus authority must be strictly downstream of device authority or a component could manufacture a bus out of nothing and then mint slaves on it. Gates on base slot 10 rather than on the R22 derived tag KIND_PCI_DEV (0x30) because device_cap_mint is still R22-M3 scaffolding that writes no descriptor: a 0x30 gate would be vacuous, refusing nothing because nothing could satisfy it either. Same shape as opregion_check_parent_base, which gates on base slots 4 and 11 for the same reason. Pure read. Reserved labels: i2cb_cpd_.",
      block: {
        cmp rdi, 256;
        jae i2cb_cpd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // I2C_BUS_BASE_KIND = KIND_DEVICE
        jne i2cb_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je i2cb_cpd_no;

        mov rax, 1;
        ret;

      i2cb_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_parent_controller_id(parent_slot) -> id | I2C_BUS_DECODE_BAD
  //
  // THE INHERITANCE. The controller identity comes from here and from
  // nowhere else; `i2c_bus_cap_mint` has no controller argument.
  // ==========================================================================

  pub let i2c_bus_parent_controller_id : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): controller_id = cap_table[parent_slot].target_ptr, for a descriptor that must be a KIND_DEVICE. The kind is RE-CHECKED here rather than trusted from the gate that ran a moment earlier, because this function is what turns a slot number into a claim about which physical controller a bus is, and a caller that reached it by some other path must not get an identity out of an unrelated descriptor. Returns I2C_BUS_DECODE_BAD on a bad slot, a wrong kind, or a zero target_ptr -- zero is refused because R22 stamps a bdf_pack key there and a device capability with no identity is not a controller, so a bus row carrying zero would be indistinguishable from a scrubbed one in every dump and every audit record. This is #1068's discipline (the GSI inherited from the parent KIND_HW_INTERRUPT row) applied to identity rather than to a line number, and for the same reason: a field naming WHICH physical thing the authority is about must come from the authority that was checked, or a holder of device A's capability could mint a bus claiming to be device B's controller. Pure read. Reserved labels: i2cb_pci_.",
      block: {
        cmp rdi, 256;
        jae i2cb_pci_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne i2cb_pci_bad;

        mov rax, [rax + 16];             // target_ptr = bdf key
        cmp rax, 0;
        je i2cb_pci_bad;
        ret;

      i2cb_pci_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_tail_pack(parent_slot) -> hdr | I2C_BUS_DECODE_BAD
  // ==========================================================================

  pub let i2c_bus_tail_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-001 (#1070): canonical KIND_I2C_BUS header-word encoder. The header carries exactly one live field -- parent_slot in bits [7:0] -- because everything else about a bus is a full u64 that lives in its own row qword. Validates parent_slot < 256 and returns I2C_BUS_DECODE_BAD otherwise. Bits [55:8] are left clear as reserved and bits [63:56] are left clear for the allocator's in_use flag; the allocator re-checks both, so a caller that fabricated a header cannot pre-set in_use and be handed a row the free scan skips. Kept as a named encoder rather than an inline `and` at the two call sites so that the reserved-bit contract has one owner. Pure leaf. Reserved labels: i2cb_tp_.",
      block: {
        cmp rdi, 256;
        jae i2cb_tp_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;

      i2cb_tp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let i2c_bus_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-001 (#1070): parent_slot from header bits [7:0]. The decode half of the tail_pack round trip. Pure leaf.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_tail_alloc(hdr, controller_id, max_speed_hz) -> row_id | error
  //
  // THE ONLY WRITER OF A BUS ROW'S IDENTITY FIELDS. One caller, in this
  // file, which has already established that the requester holds
  // KIND_DEVICE authority over the controller being described.
  // ==========================================================================

  pub let i2c_bus_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (controller_id: u64) (max_speed_hz: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): allocate and populate a free _i2c_bus_table row. THIS IS THE ONLY FUNCTION IN THE KERNEL THAT WRITES A {controller_id, max_speed_hz} PAIR, which is what makes the single authority gate upstream of it exhaustive rather than merely usual. Gates, in order: hdr bits [63:56] non-zero -> I2C_BUS_TAIL_BAD_ARG (those bits belong to the in_use flag the allocator ORs in, so accepting them would hand back a row the free scan skips); hdr reserved bits [55:8] non-zero -> I2C_BUS_TAIL_BAD_ARG (a reserved bit that is merely ignored is a reserved bit a later revision cannot use); controller_id == 0 -> I2C_BUS_TAIL_BAD_ARG (a bus with no controller identity is indistinguishable from a scrubbed row); max_speed_hz not one of the four validated rates -> I2C_BUS_TAIL_BAD_ARG. Low-first scan over 8 rows of 32 bytes; free iff the in_use byte (byte 7 of [row+0]) is zero; exhaustion -> I2C_BUS_TAIL_ENOSPC. Claim: [row+0] = hdr | (1 << 56), [row+8] = controller_id, [row+16] = max_speed_hz, [row+24] = 0 (num_slaves -- a bus is born with no devices behind it, and the count is thereafter maintained only by the two note_ functions below). Args parked in r13/r14/r15 across the scan and the nested speed check; three pushes leave rsp%16 == 0 at that call. Reserved labels: i2cb_ta_.",
      block: {
        push r13;
        push r14;
        push r15;

        mov r13, rdi;                    // hdr
        mov r14, rsi;                    // controller_id
        mov r15, rdx;                    // max_speed_hz

        // Gate: hdr bits [63:56] must be zero.
        mov r10, r13;
        shr r10, 56;
        cmp r10, 0;
        jne i2cb_ta_bad_arg;

        // Gate: hdr reserved bits [55:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne i2cb_ta_bad_arg;

        // Gate: controller identity is present.
        cmp r14, 0;
        je i2cb_ta_bad_arg;

        // Gate: the rate is one of the four.
        mov rdi, r15;
        call i2c_bus_speed_valid;
        cmp rax, 0;
        je i2cb_ta_bad_arg;

        // Row cursor.
        lea r8, [rip + _i2c_bus_table];
        xor rcx, rcx;

      i2cb_ta_scan:
        cmp rcx, 8;                      // I2C_BUS_MAX
        jae i2cb_ta_none;
        mov rax, [r8];
        mov r10, rax;
        shr r10, 56;                     // in_use byte
        cmp r10, 0;
        je i2cb_ta_found;
        add r8, 32;                      // I2C_BUS_ROW_BYTES
        add rcx, 1;
        jmp i2cb_ta_scan;

      i2cb_ta_found:
        mov rax, r13;
        mov r10, 1;
        shl r10, 56;
        or  rax, r10;
        mov [r8 + 0], rax;               // hdr | in_use

        mov [r8 + 8],  r14;              // controller_id
        mov [r8 + 16], r15;              // max_speed_hz

        xor rax, rax;
        mov [r8 + 24], rax;              // num_slaves = 0

        mov rax, rcx;                    // row_id
        pop r15;
        pop r14;
        pop r13;
        ret;

      i2cb_ta_none:
        mov rax, 0xFFFFFF8F;             // I2C_BUS_TAIL_ENOSPC
        pop r15;
        pop r14;
        pop r13;
        ret;

      i2cb_ta_bad_arg:
        mov rax, 0xFFFFFF8E;             // I2C_BUS_TAIL_BAD_ARG
        pop r15;
        pop r14;
        pop r13;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_tail_free(row_id) -> ()
  // ==========================================================================

  pub let i2c_bus_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): row_id >= I2C_BUS_MAX -> silent no-op. Otherwise zero all four u64s of the row. Zeroing [row+0] is what clears in_use, so free and SCRUB are the same operation: no stale controller identity survives in the table. That matters here specifically because slave rows record their parent's ROW_ID, so a freed-but-unscrubbed bus row that a later mint reused would silently re-attach any surviving orphan slave to a different controller -- which is why the cascade in i2c_bus_cap_revoke_inner runs before this call rather than after. Leaf. Reserved labels: i2cb_tf_.",
      block: {
        cmp rdi, 8;
        jae i2cb_tf_done;

        mov r8, rdi;
        shl r8, 5;                       // row_id * 32
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        xor rax, rax;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;

      i2cb_tf_done:
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_tail_valid(row_id) -> u64
  // ==========================================================================

  pub let i2c_bus_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): 1 iff row_id < I2C_BUS_MAX and the row's in_use byte is non-zero. Exported because kind_i2c_slave.o must be able to ask 'is my parent bus still alive?' without reaching into _i2c_bus_table, which tools/build.sh forbids it from doing. Same shape as opregion_tail_valid and acpi_evt_tail_valid. Leaf, pure read. Reserved labels: i2cb_tv_.",
      block: {
        cmp rdi, 8;
        jae i2cb_tv_no;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cb_tv_no;

        mov rax, 1;
        ret;

      i2cb_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_rows_live() -> count
  // ==========================================================================

  pub let i2c_bus_rows_live : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): number of _i2c_bus_table rows whose in_use byte is set. The standing observable for row leakage: a mint/revoke cycle that returns this to its starting value has leaked nothing, and a cascade that does not is the bug. Kept as a plain exported query rather than a capability op because it is a property of the TABLE rather than of any one capability, and putting it behind a capability would mean the holder of one bus could measure how many other buses exist. Leaf, pure read. Reserved labels: i2cb_rl_.",
      block: {
        lea r8, [rip + _i2c_bus_table];
        xor rcx, rcx;                    // row cursor
        xor rax, rax;                    // count

      i2cb_rl_scan:
        cmp rcx, 8;
        jae i2cb_rl_done;
        mov r10, [r8 + 0];
        shr r10, 56;
        cmp r10, 0;
        je i2cb_rl_next;
        add rax, 1;

      i2cb_rl_next:
        add r8, 32;
        add rcx, 1;
        jmp i2cb_rl_scan;

      i2cb_rl_done:
        ret
      }
    }

  // ==========================================================================
  // Row decoders. Every one bounds-checks and in_use-checks first, and
  // returns I2C_BUS_DECODE_BAD on a dead or out-of-range row — never a
  // plausible-looking zero.
  // ==========================================================================

  pub let i2c_bus_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): raw header word of a LIVE row with the in_use flag stripped, so the value round-trips against i2c_bus_tail_pack's output; I2C_BUS_DECODE_BAD otherwise. The other header decoders are written in terms of this one so the bounds check and the liveness check exist once and cannot drift apart. Leaf, pure read. Reserved labels: i2cb_rh_.",
      block: {
        cmp rdi, 8;
        jae i2cb_rh_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je i2cb_rh_bad;

        mov r10, 0x00FFFFFFFFFFFFFF;
        and rax, r10;
        ret;

      i2cb_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let i2c_bus_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): parent KIND_DEVICE cap slot of a live row, I2C_BUS_DECODE_BAD on a dead or out-of-range row. One push (rbx, unused) brings rsp%16 to 0 at the nested call. Reserved labels: i2cb_rp_.",
      block: {
        push rbx;
        call i2c_bus_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cb_rp_out;
        and rax, 0xFF;
      i2cb_rp_out:
        pop rbx;
        ret
      }
    }

  pub let i2c_bus_row_controller : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): controller identity of a live row from [+8] -- the bdf_pack key inherited from the parent KIND_DEVICE descriptor at mint. I2C_BUS_DECODE_BAD on a dead or out-of-range row; unambiguous because the allocator refuses a zero identity and a bdf key never reaches all-ones. Leaf, pure read. Reserved labels: i2cb_rc_.",
      block: {
        cmp rdi, 8;
        jae i2cb_rc_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cb_rc_bad;

        mov rax, [r8 + 8];
        ret;

      i2cb_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let i2c_bus_row_speed : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): max_speed_hz of a live row from [+16], I2C_BUS_DECODE_BAD on a dead or out-of-range row. Unambiguous: a live row's rate is one of four small constants. Leaf, pure read. Reserved labels: i2cb_rs_.",
      block: {
        cmp rdi, 8;
        jae i2cb_rs_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cb_rs_bad;

        mov rax, [r8 + 16];
        ret;

      i2cb_rs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let i2c_bus_row_slaves : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): live slave count of a row from [+24], I2C_BUS_DECODE_BAD on a dead or out-of-range row. This is the observable that makes the cascade checkable: after i2c_bus_cap_revoke has swept a bus, the count read from the row immediately before it is freed must be zero, and the revoke reports I2C_BUS_REVOKE_SLAVES_LIVE if it is not. Leaf, pure read. Reserved labels: i2cb_rsl_.",
      block: {
        cmp rdi, 8;
        jae i2cb_rsl_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cb_rsl_bad;

        mov rax, [r8 + 24];
        ret;

      i2cb_rsl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_note_slave_added(row_id) / _removed(row_id)
  //
  // The ONLY two mutators of num_slaves. Exported for kind_i2c_slave.o,
  // which cannot touch _i2c_bus_table directly — tools/build.sh forbids
  // it — so the count can only move through these two doors.
  // ==========================================================================

  pub let i2c_bus_note_slave_added : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): increment [row+24] on a live row; I2C_BUS_COUNT_BAD_ROW on a dead or out-of-range one. Called by i2c_slave_cap_mint_inner AFTER its row has been allocated, so a refused slave mint never moves the count. Exported across the object boundary on purpose: the objdump confinement in tools/build.sh means kind_i2c_slave.o cannot reach _i2c_bus_table itself, so this pair of functions is the entire mutation surface of the count and 'who can change it' is answered by reading two function bodies rather than by grepping the kernel. Saturation is not possible in any reachable configuration -- the count is bounded above by I2C_SLAVE_MAX = 32 rows -- so no clamp is applied; a clamp would silently hide the corruption the SLAVES_LIVE check exists to report. Leaf. Reserved labels: i2cb_nsa_.",
      block: {
        cmp rdi, 8;
        jae i2cb_nsa_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cb_nsa_bad;

        mov rax, [r8 + 24];
        add rax, 1;
        mov [r8 + 24], rax;

        xor rax, rax;                    // I2C_BUS_OK
        ret;

      i2cb_nsa_bad:
        mov rax, 0xFFFFFF83;             // I2C_BUS_COUNT_BAD_ROW
        ret
      }
    }

  pub let i2c_bus_note_slave_removed : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-001 (#1070): decrement [row+24] on a live row; I2C_BUS_COUNT_BAD_ROW on a dead or out-of-range row, and ALSO on a count that is already zero. The zero case is refused rather than wrapped: an unsigned decrement below zero produces 0xFFFFFFFFFFFFFFFF, which would read as a bus with eighteen quintillion devices behind it and would make the SLAVES_LIVE invariant permanently unsatisfiable -- the cascade would then report failure on every subsequent teardown of that row. Refusing leaves the count at zero and names the anomaly once. Note that a dead parent row is a legitimate outcome here and not an error the caller must handle: i2c_slave_cap_revoke calls this before it frees its own row, and if the bus row is already gone the count it would have decremented no longer exists. Leaf. Reserved labels: i2cb_nsr_.",
      block: {
        cmp rdi, 8;
        jae i2cb_nsr_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_bus_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cb_nsr_bad;

        mov rax, [r8 + 24];
        cmp rax, 0;
        je i2cb_nsr_bad;
        sub rax, 1;
        mov [r8 + 24], rax;

        xor rax, rax;                    // I2C_BUS_OK
        ret;

      i2cb_nsr_bad:
        mov rax, 0xFFFFFF83;             // I2C_BUS_COUNT_BAD_ROW
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_row_of_slot(slot) -> row_id | I2C_BUS_DECODE_BAD
  //
  // Slot -> row for a descriptor that must be a live KIND_I2C_BUS.
  // kind_i2c_slave.o uses this to find its parent's row without reading
  // the descriptor layout a second time.
  // ==========================================================================

  pub let i2c_bus_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): row_id = cap_table[slot].target_ptr[15:0], for a descriptor that must be a KIND_I2C_BUS (0x152) whose row is live. Every step is re-checked here rather than trusted from a caller's earlier gate, because this is the function that turns a slot number into a bus identity and a caller that arrived by another path must not get a row_id belonging to an unrelated descriptor. Returns I2C_BUS_DECODE_BAD on a bad slot, a wrong kind, or a row that is out of range or already freed; all-ones is not a plausible row_id because rows are 16-bit and bounded by 8. One push (rbx, unused) aligns the nested call. Pure read. Reserved labels: i2cb_ros_.",
      block: {
        push rbx;

        cmp rdi, 256;
        jae i2cb_ros_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x152;                  // KIND_I2C_BUS
        cmp r10, r11;
        jne i2cb_ros_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;                    // row_id

        mov rdi, rbx;
        call i2c_bus_tail_valid;
        cmp rax, 0;
        je i2cb_ros_bad;

        mov rax, rbx;
        pop rbx;
        ret;

      i2cb_ros_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_cap_mint(slot, parent_slot, rights, max_speed_hz) -> u64
  //
  // NOTE THE ARGUMENT LIST. There is no controller argument: identity
  // is inherited from the parent KIND_DEVICE descriptor.
  //
  // SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=max_speed_hz.
  // ==========================================================================

  pub let i2c_bus_cap_mint_inner : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (max_speed_hz: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): mint a KIND_I2C_BUS. Sequence: (1) slot < 256 else I2C_BUS_MINT_BAD_ARG. (2) i2c_bus_check_parent_device(parent_slot) -- THE DERIVATION GATE -- else I2C_BUS_MINT_BAD_PARENT: a caller who does not hold the controller's KIND_DEVICE capability with RIGHT_MINT cannot manufacture a bus, and therefore cannot mint slaves on one. (3) i2c_bus_rights_valid(rights) else I2C_BUS_MINT_BAD_RIGHTS. (4) i2c_bus_speed_valid(max_speed_hz) else I2C_BUS_MINT_BAD_SPEED, checked here as well as in the allocator so the boundary code names the specific edge rather than the allocator's generic BAD_ARG. (5) INHERIT the controller identity: i2c_bus_parent_controller_id(parent_slot), I2C_BUS_MINT_BAD_CONTROLLER on refusal. It is NOT an argument -- see the module header -- so a holder of device A's capability cannot mint a bus that claims to be device B's controller. (6) i2c_bus_tail_pack + i2c_bus_tail_alloc, translating TAIL codes to distinct MINT codes so each failure edge stays nameable at the boundary. (7) cap_mint_write(slot, KIND_I2C_BUS = 0x152, rights, row_id). Five pushes (rbx, r12, r13, r14, r15) hold slot, parent_slot, rights, max_speed_hz and the inherited controller id across the five nested calls; entry rsp%16 == 8 and five pushes (40 bytes) return it to 0 at every call site. Reserved labels: i2cb_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov r15, rcx;                    // max_speed_hz

        cmp r12, 256;
        jae i2cb_mi_bad_arg;

        // -- Step 2: THE DERIVATION GATE.
        mov rdi, r13;
        call i2c_bus_check_parent_device;
        cmp rax, 0;
        je i2cb_mi_bad_parent;

        // -- Step 3: rights subset.
        mov rdi, r14;
        call i2c_bus_rights_valid;
        cmp rax, 0;
        je i2cb_mi_bad_rights;

        // -- Step 4: the rate is one of the four.
        mov rdi, r15;
        call i2c_bus_speed_valid;
        cmp rax, 0;
        je i2cb_mi_bad_speed;

        // -- Step 5: INHERIT the controller identity.
        mov rdi, r13;
        call i2c_bus_parent_controller_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cb_mi_bad_controller;
        mov rbx, rax;                    // controller_id

        // -- Step 6: header word, then the row.
        mov rdi, r13;
        call i2c_bus_tail_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cb_mi_bad_arg;

        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // controller_id
        mov rdx, r15;                    // max_speed_hz
        call i2c_bus_tail_alloc;

        mov r10, 0xFFFFFF8F;             // I2C_BUS_TAIL_ENOSPC
        cmp rax, r10;
        je i2cb_mi_enospc;
        mov r10, 0xFFFFFF8E;             // I2C_BUS_TAIL_BAD_ARG
        cmp rax, r10;
        je i2cb_mi_bad_arg;

        // -- Step 7: descriptor.
        mov rcx, rax;                    // target_ptr = row_id
        mov rdi, r12;                    // slot
        mov rsi, 0x152;                  // KIND_I2C_BUS
        mov rdx, r14;                    // rights
        call cap_mint_write;

        xor rax, rax;                    // I2C_BUS_OK
        jmp i2cb_mi_out;

      i2cb_mi_bad_parent:
        mov rax, 0xFFFFFF8D;
        jmp i2cb_mi_out;
      i2cb_mi_bad_rights:
        mov rax, 0xFFFFFF8C;
        jmp i2cb_mi_out;
      i2cb_mi_enospc:
        mov rax, 0xFFFFFF8A;
        jmp i2cb_mi_out;
      i2cb_mi_bad_speed:
        mov rax, 0xFFFFFF89;
        jmp i2cb_mi_out;
      i2cb_mi_bad_controller:
        mov rax, 0xFFFFFF88;
        jmp i2cb_mi_out;
      i2cb_mi_bad_arg:
        mov rax, 0xFFFFFF8B;

      i2cb_mi_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let i2c_bus_cap_mint : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (max_speed_hz: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): audited entry point for the bus mint, same wrapper shape as dma_cap_mint / opregion_cap_mint_root / acpi_evt_cap_mint. The audit is not decoration: a bus capability is the standing authority to hand out reach to every device on a shared wire, and the only way to answer 'which component was allowed to enumerate that controller' after the fact is for every bus that ever existed -- and every bus mint that was REFUSED -- to have left a record. Putting the emission in the wrapper means a future second bus-mint path cannot exist without being audited. Three pushes (r12/r13/r14) leave rsp%16 == 0 at both nested calls; the four SysV argument registers are untouched by the two movs, so the inner body sees them exactly as passed, and r14 carries the inner outcome across drv_audit_emit so the wrapper is return-value transparent. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent device slot)

        call i2c_bus_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x152;                  // KIND_I2C_BUS
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_cap_revoke(slot) -> u64
  //
  // CASCADES FIRST. Every slave derived from this bus is revoked before
  // the bus row is freed.
  // ==========================================================================

  pub let i2c_bus_cap_revoke_inner : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): revoke a KIND_I2C_BUS, cascading to its slaves. (1) slot < 256 else I2C_BUS_REVOKE_BAD_SLOT. (2) descriptor at cap_table + slot*24. (3) kind == 0 -> I2C_BUS_REVOKE_ALREADY (idempotent). (4) kind != 0x152 -> I2C_BUS_REVOKE_WRONG_KIND, so a bus revoke can never clear another kind's descriptor. (5) row_id from target_ptr[15:0]. (6) CASCADE: i2c_slave_cascade_revoke_by_bus_row(row_id) sweeps every KIND_I2C_SLAVE derived from this bus, by descriptor AND by row, BEFORE anything here is freed. It is keyed on the bus ROW rather than on this cap slot because a slot can later hold a different bus while a live row_id cannot, so the row is the identity that actually binds child to parent. The order is not stylistic -- each slave revoke decrements this bus's num_slaves through i2c_bus_note_slave_removed, which requires the bus row to still be live, and a slave row that outlived its bus would be a live handle to a device on a controller nobody owns whose recorded parent row_id a later mint could silently re-use. (7) read num_slaves: a non-zero count after a completed cascade is an internal inconsistency, and it is REPORTED (I2C_BUS_REVOKE_SLAVES_LIVE) rather than allowed to abort the teardown -- a revoke that refuses to finish would leave the bus alive, which is strictly worse than a completed teardown with a named anomaly in the audit record. (8) i2c_bus_tail_free scrubs the row; (9) clear the descriptor. Descriptor base parked in rbx, slot in r12, row in r13, outcome in r14 across the cascade; five pushes leave rsp%16 == 0 at every nested call. Reserved labels: i2cb_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot
        xor r14, r14;                    // outcome, optimistic

        cmp r12, 256;
        jae i2cb_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je i2cb_rvk_already;

        mov r11, 0x152;                  // KIND_I2C_BUS
        cmp r10, r11;
        jne i2cb_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        // -- Step 6: CASCADE, before anything is freed.
        mov rdi, r13;                    // bus row_id — the parent key
        call i2c_slave_cascade_revoke_by_bus_row;

        // -- Step 7: the cascade must have emptied the bus.
        mov rdi, r13;
        call i2c_bus_row_slaves;
        cmp rax, 0;
        je i2cb_rvk_swept;
        mov r14, 0xFFFFFF84;             // I2C_BUS_REVOKE_SLAVES_LIVE

      i2cb_rvk_swept:
        // -- Step 8: free + scrub the row.
        mov rdi, r13;
        call i2c_bus_tail_free;

        // -- Step 9: clear the descriptor.
        xor rax, rax;
        mov [rbx + 0],  rax;
        mov [rbx + 8],  rax;
        mov [rbx + 16], rax;

        mov rax, r14;
        jmp i2cb_rvk_out;

      i2cb_rvk_bad_slot:
        mov rax, 0xFFFFFF87;
        jmp i2cb_rvk_out;
      i2cb_rvk_wrong_kind:
        mov rax, 0xFFFFFF86;
        jmp i2cb_rvk_out;
      i2cb_rvk_already:
        mov rax, 0xFFFFFF85;

      i2cb_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let i2c_bus_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): audited revoke. The cascade inside the inner body calls the SLAVE kind's audited revoke, so tearing down a bus that owns N devices leaves N+1 records rather than one -- the same reconciliation property R29.M6-002 established for the DMA cascade, and the property an operator needs when a device stops responding and the question is whether its capability was revoked or its driver crashed. Three pushes (r12/r13/r14) leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call i2c_bus_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x152;                  // KIND_I2C_BUS
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_debug_print(row_id) -> u64
  // ==========================================================================

  pub let i2c_bus_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R30.M5-001 (#1070): canonical debug printer for one bus row. Refuses a dead or out-of-range row with I2C_BUS_TAIL_BAD_ARG rather than printing zeroes, because a printer that renders a freed row as {ctl 0, spd 0, slv 0} is indistinguishable from one rendering a live bus whose fields happen to be zero -- and controller identity zero is precisely what the allocator refuses, so a zero there means 'this dump is lying'. Emits four KV lines (row / ctl / spd / slv) through klog_s1_x1 so each value is machine-greppable in the smoke log. r12 holds row_id across the four calls; three pushes leave rsp%16 == 0. Reserved labels: i2cb_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call i2c_bus_tail_valid;
        cmp rax, 0;
        je i2cb_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cb_dbg_msg];
        lea rcx, [rip + i2cb_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call i2c_bus_row_controller;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cb_dbg_msg];
        lea rcx, [rip + i2cb_k_ctl];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call i2c_bus_row_speed;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cb_dbg_msg];
        lea rcx, [rip + i2cb_k_spd];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call i2c_bus_row_slaves;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cb_dbg_msg];
        lea rcx, [rip + i2cb_k_slv];
        mov r8, r13;
        call klog_s1_x1;

        xor rax, rax;                    // I2C_BUS_OK
        pop r14;
        pop r13;
        pop r12;
        ret;

      i2cb_dp_bad:
        mov rax, 0xFFFFFF8E;             // I2C_BUS_TAIL_BAD_ARG
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_i2c_bus(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler. QUERY OPS ONLY. There is no transfer op and no
  // mint op: minting a slave is a kernel-side operation that names a
  // destination slot, which is not expressible in a three-register
  // capability invocation, and a transfer op here would defeat the
  // entire point of KIND_I2C_SLAVE.
  // ==========================================================================

  pub let cap_handler_i2c_bus : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-001 (#1070): KIND_I2C_BUS dispatch handler. Emits cap_i2c_bus_msg on entry (argument registers saved across klog_s1, which clobbers all three per klog/wrappers.pdx section 5.1). row_id = target_ptr[15:0]; op = op_arg[7:0] -- the upper 56 bits of op_arg are DISCARDED, which is what stops a caller from smuggling any second operand through the op word. Ops 0..3 (QUERY_CONTROLLER / SPEED / SLAVES / PARENT) require RIGHT_INVOKE (0x008); op 4 (DEBUG_PRINT) requires RIGHT_OBSERVE (0x400). The rights gate is PER-OP rather than a single entry gate so the query and observe authority classes stay separable. Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Every query returns I2C_BUS_DECODE_BAD for a dead row, which is the decoders' contract and never a plausible zero. r12=rights, r13=row_id, r14=op across the klog call. Reserved labels: i2cb_h_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;
        and r14, 0xFF;                   // op — upper 56 bits discarded

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_i2c_bus_msg];
        call klog_s1;

        cmp r14, 4;
        je i2cb_h_dbg;
        cmp r14, 3;
        ja i2cb_h_unsup;

        // Ops 0..3: RIGHT_INVOKE.
        mov rax, r12;
        mov r10, 0x008;
        and rax, r10;
        cmp rax, 0;
        je i2cb_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je i2cb_h_ctl;
        cmp r14, 1;
        je i2cb_h_spd;
        cmp r14, 2;
        je i2cb_h_slv;

        call i2c_bus_row_parent;
        jmp i2cb_h_out;

      i2cb_h_ctl:
        call i2c_bus_row_controller;
        jmp i2cb_h_out;
      i2cb_h_spd:
        call i2c_bus_row_speed;
        jmp i2cb_h_out;
      i2cb_h_slv:
        call i2c_bus_row_slaves;
        jmp i2cb_h_out;

      i2cb_h_dbg:
        mov rax, r12;
        mov r10, 0x400;                  // RIGHT_OBSERVE
        and rax, r10;
        cmp rax, 0;
        je i2cb_h_denied;
        mov rdi, r13;
        call i2c_bus_debug_print;
        jmp i2cb_h_out;

      i2cb_h_denied:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp i2cb_h_out;

      i2cb_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      i2cb_h_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

}
