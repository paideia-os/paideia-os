// src/kernel/core/cap/kind_pdxfs_file.pdx -- R48b substrate-prep (#1623)
// Row widened 48 -> 64 bytes at R52.M4-001 (#1697): see SECTION 1.
//
// KIND_PDXFS_FILE = 0x195, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// The runtime authority for ONE file (or file-shaped object) in the
// PdxFS v1 filesystem: an inode number, a byte-length ceiling, POSIX-
// analog mode bits, birth + modification timestamps, and a reference
// count.  The row is the substrate for every R49 file-authoring tool
// (edit, cat, ls, pkg -- see design/tooling/r49-r50-plan.md §5) that
// asks the kernel for authority to touch a specific file rather than a
// mount or a directory.
//
// =============================================================================
// SECTION 0  WHY KIND_PDXFS_FILE DERIVES OVER KIND_MEMORY
// =============================================================================
//
// A file in PdxFS is, at the CoW walker's abstraction layer
// (src/kernel/core/fs/pdxfs/cow_read.pdx §0), a rooted chain of blocks
// that name pages the mount has authority over.  The set of pages an
// inode may reach is a subset of the mount's page authority.  So the
// derivation gate demands `parent.kind == KIND_MEMORY (4) carrying
// RIGHT_MINT` -- an authorised holder of pages backing the volume mints
// a file cap that reaches into those pages, and cannot invent a file
// whose pages come from elsewhere.
//
// This matches the KIND_DMA_DOMAIN choice at R29.M5-001 (#1036) where a
// device-reach cap derives over KIND_MEMORY for the identical reason:
// "you cannot widen an authority beyond the memory authority you
// already hold" (design/architecture/next-wave-derived-kinds.md
// §KIND_DMA_DOMAIN naming reconciliation).
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words; widened 48 -> 64 at
// R52.M4-001 (#1697) to carry the M4 inode-fetch coordinates):
//
//   [+0]   header: in_use[63:56] | mode_bits[15:0]
//   [+8]   inode_no  (u64)               -- FS-assigned; refused == 0 at mint
//   [+16]  byte_len  (u64)               -- current file length ceiling
//   [+24]  created_ns (u64)              -- birth timestamp
//   [+32]  mtime_ns  (u64)               -- last modification timestamp
//   [+40]  refcount  (u64)               -- kernel-side ref count (userspace
//                                          hardlink-count is on-disk)
//   [+48]  volume_slot (u64)             -- KIND_VOLUME cap slot backing this
//                                          file, or 0xFF (PFF_ROW_NONE) as
//                                          the tmpfs / pre-M4 backward-compat
//                                          sentinel meaning "no real volume"
//   [+56]  inode_lba  (u64)              -- the inode's on-disk block, or 0
//                                          when volume_slot is the sentinel
//
// mode_bits packing (16 bits): the low 12 bits mirror POSIX rwxrwxrwx
// + setuid/setgid/sticky; upper 4 bits are the PdxFS file-type nibble
// (dir/file/symlink/socket/...).  A row lives in _pdxfs_file_table and
// is claimed via pdxfs_file_tail_alloc; freed via pdxfs_file_tail_free
// which scrubs all eight words.  pdxfs_file_tail_alloc itself has not
// grown an inode-aware call signature at #1697 -- every existing caller
// still mints through the 5-arg walker, and the claim path writes the
// backward-compat sentinel pair (volume_slot = 0xFF, inode_lba = 0)
// into the two new words.  #1698+ (inode_table.pdx, KIND_INODE_HANDLE)
// land the real-volume mint path that populates them.
//
// Row addressed capacity: 16 rows x 64 bytes = 1024 bytes.  16 is a
// soft ceiling for the substrate-prep round -- enough to exercise the
// mint/revoke path plus the four R49 tool M1 witnesses simultaneously.
// R50 will re-shape the table when the pool of live file caps is
// bounded by design/tooling/r49-r50-plan.md §5.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// R_PDXFS_FILE_READ    (0x001) -- read file content through the walker
// R_PDXFS_FILE_WRITE   (0x002) -- append or overwrite (CoW cow_write path)
// R_PDXFS_FILE_INVOKE  (0x008) -- query ops (inode_no, byte_len, mode, ...)
// R_PDXFS_FILE_REVOKE  (0x010) -- teardown the row + drop refcount
// R_PDXFS_FILE_MINT    (0x200) -- derive a narrower child (view, snapshot ref)
// R_PDXFS_FILE_OBSERVE (0x400) -- debug printer
// R_PDXFS_FILE_ALL     (0x61B)
//
// R_MINT is PRESENT: a snapshot-viewer cap derives a read-only child
// (design/tooling/r49-r50-plan.md §5, pkg install path).
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEC20..0xFFFFEC2F
// =============================================================================
//
// Sixteen wide, disjoint from every previous kind's band (KIND_USER's
// band was 0xFFFFED30..0xFFFFED3F).

module KindPdxfsFile = structure {

  pub let KIND_PDXFS_FILE      : u64 = 0x195
  pub let KIND_PDXFS_FILE_BASE : u64 = 4          // = KIND_MEMORY (= KIND_PAGE)

  pub let R_PDXFS_FILE_READ    : u64 = 0x001
  pub let R_PDXFS_FILE_WRITE   : u64 = 0x002
  pub let R_PDXFS_FILE_INVOKE  : u64 = 0x008
  pub let R_PDXFS_FILE_REVOKE  : u64 = 0x010
  pub let R_PDXFS_FILE_MINT    : u64 = 0x200
  pub let R_PDXFS_FILE_OBSERVE : u64 = 0x400
  pub let R_PDXFS_FILE_ALL     : u64 = 0x61B

  // Ops. Every op ARITY ONE -- op_arg high bits refused.
  pub let PFF_OP_QUERY_INODE  : u64 = 0
  pub let PFF_OP_QUERY_LEN    : u64 = 1
  pub let PFF_OP_QUERY_MODE   : u64 = 2
  pub let PFF_OP_QUERY_BIRTH  : u64 = 3
  pub let PFF_OP_QUERY_MTIME  : u64 = 4
  pub let PFF_OP_QUERY_REFS   : u64 = 5
  pub let PFF_OP_DEBUG_PRINT  : u64 = 6
  pub let PFF_OP_MAX          : u64 = 6

  // Failure taxonomy. 0xFFFFEC20..0xFFFFEC2F, disjoint band.
  pub let PFF_OK              : u64 = 0
  pub let PFF_TAIL_ENOSPC     : u64 = 0xFFFFEC2F
  pub let PFF_TAIL_BAD_ARG    : u64 = 0xFFFFEC2E
  pub let PFF_MINT_BAD_PARENT : u64 = 0xFFFFEC2D
  pub let PFF_MINT_BAD_RIGHTS : u64 = 0xFFFFEC2C
  pub let PFF_MINT_BAD_INODE  : u64 = 0xFFFFEC2B
  pub let PFF_MINT_BAD_LEN    : u64 = 0xFFFFEC2A
  pub let PFF_MINT_BAD_MODE   : u64 = 0xFFFFEC29
  pub let PFF_BAD_SLOT        : u64 = 0xFFFFEC28
  pub let PFF_WRONG_KIND      : u64 = 0xFFFFEC27
  pub let PFF_REVOKE_ALREADY  : u64 = 0xFFFFEC26

  pub let PFF_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PFF_ROW_NONE   : u64 = 0xFF

  // Ceilings.  1 TiB per-file cap; a nonsense length above this is
  // refused rather than silently accepted (same posture as
  // USER_QUOTA_MAX in kind_user.pdx).
  pub let PFF_LEN_MAX  : u64 = 0x10000000000       // 1 TiB
  pub let PFF_MODE_MAX : u64 = 0xFFFF              // 16 bits reachable

  pub let PFF_MAX       : u64 = 16
  pub let PFF_ROW_BYTES : u64 = 64
  // 16 rows * 64 bytes = 1024 bytes = 128 u64.  Widened 96 -> 128 u64
  // at R52.M4-001 (#1697); see SECTION 1 for the two new fields.
  pub let mut _pdxfs_file_table : [u64; 128] = uninit @align(64)
  pub let mut _pdxfs_file_stats : [u64; 8]  = uninit @align(64)

  pub let PFF_ST_MINTS   : u64 = 0
  pub let PFF_ST_REVOKES : u64 = 1
  pub let PFF_ST_QUERIES : u64 = 2
  pub let PFF_ST_REFUSED : u64 = 3
  pub let PFF_ST_MAX     : u64 = 8

  pub let pdxfs_file_dbg_msg : [u8; 15] = "PDXFS FILE ROW\0"

  // ==========================================================================
  // pdxfs_file_table_reset() -> ()
  // ==========================================================================

  pub let pdxfs_file_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring kind_user's user_table_reset: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Row count widened to 128 u64 (16 rows * 64 bytes) at R52.M4-001 (#1697). Labels prefixed pff_rs_.",
      block: {
        lea r10, [rip + _pdxfs_file_table];
        xor rax, rax;
        xor rcx, rcx;
      pff_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  pff_rs_rows;

        lea r10, [rip + _pdxfs_file_stats];
        xor rcx, rcx;
      pff_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pff_rs_stats;
        ret
      }
    }

  pub let pdxfs_file_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): bounded increment on out-of-range no-op. Same shape as user_note. Labels prefixed pff_nt_.",
      block: {
        cmp rdi, 8;
        jae pff_nt_out;
        lea r10, [rip + _pdxfs_file_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pff_nt_out:
        ret
      }
    }

  pub let pdxfs_file_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): bounded read; out-of-range returns 0. Labels prefixed pff_st_.",
      block: {
        cmp rdi, 8;
        jae pff_st_zero;
        lea r10, [rip + _pdxfs_file_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pff_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let pdxfs_file_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1623): subset test against R_PDXFS_FILE_ALL = 0x61B. Labels prefixed pff_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x61B;                  // R_PDXFS_FILE_ALL
        and rax, r10;
        cmp rax, rdi;
        jne pff_rv_no;
        mov rax, 1;
        ret;
      pff_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_len_valid(byte_len) -> 1 | 0
  // ==========================================================================

  pub let pdxfs_file_len_valid : (u64) -> u64 !{} @{} =
    fn (byte_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1623): 1 iff byte_len <= PFF_LEN_MAX (1 TiB). Zero is legitimate (empty file). Ceiling refuses only nonsense values that would swallow a downstream sum. 1 TiB requires staging through r11 because the immediate is above 0x7FFFFFFF. Labels prefixed pff_lv_.",
      block: {
        mov r11, 0x10000000000;          // 1 TiB
        cmp rdi, r11;
        ja  pff_lv_no;
        mov rax, 1;
        ret;
      pff_lv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_check_parent_memory(parent_slot) -> 1 | 0
  //
  // The KIND_PDXFS_FILE derivation gate. Requires
  // parent.kind == KIND_MEMORY (4) AND (rights & RIGHT_MINT 0x200) != 0.
  // ==========================================================================

  pub let pdxfs_file_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1623): the derivation gate for KIND_PDXFS_FILE. Bounds-check parent_slot < 256, load descriptor at cap_table + slot*24, require kind == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200). This mirrors kind_dma_domain's dma_check_parent_kind_memory: a file cap widens no memory reach beyond its parent. Pure read. Labels prefixed pff_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae pff_cpm_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne pff_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  pff_cpm_no;

        mov rax, 1;
        ret;

      pff_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_hdr_pack(mode_bits) -> hdr | PFF_DECODE_BAD
  // ==========================================================================

  pub let pdxfs_file_hdr_pack : (u64) -> u64 !{} @{} =
    fn (mode_bits: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1623): canonical header encoder. mode_bits fits in [15:0]; upper bits refused. Bits [63:56] MUST leave this function zero -- they belong to the allocator's in_use flag. Labels prefixed pff_hp_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  pff_hp_bad;
        mov rax, rdi;
        ret;
      pff_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_tail_alloc(hdr, inode_no, byte_len, created_ns, mtime_ns)
  //   -> row_id | PFF_TAIL_*
  //
  // Five args, exactly the identity + mutable-header fields the mint
  // needs to write.  refcount initialises to 1.
  // ==========================================================================

  pub let pdxfs_file_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (inode_no: u64) (byte_len: u64) (created_ns: u64) (mtime_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): claim one KIND_PDXFS_FILE row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A PDXFS-FILE ROW; tools/build.sh confines relocations against _pdxfs_file_table to this object.  Gates in order: hdr in_use pre-set -> BAD_ARG; hdr bits [55:16] non-zero -> BAD_ARG; inode_no == 0 -> BAD_INODE (0 is the free-slot sentinel in on-disk PdxFS inode tables); byte_len > 1 TiB -> BAD_LEN.  Low-first scan over 16 rows, row stride now 64 bytes (R52.M4-001 (#1697): single shl by 6, 64 being a power of two, rather than the former 32+16 split).  Claim path writes the two new M4 words with the backward-compat sentinel pair volume_slot = 0xFF (PFF_ROW_NONE, 'no real volume') and inode_lba = 0; #1698+ lands the real-volume mint path that overwrites them.  Six callee-save pushes leave rsp%16 == 0 at every nested call (this leaf has none). Labels prefixed pff_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // inode_no
        mov r14, rdx;                    // byte_len
        mov r15, rcx;                    // created_ns
        mov rbp, r8;                     // mtime_ns

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne pff_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne pff_ta_bad;

        // inode_no non-zero.
        cmp r13, 0;
        je  pff_ta_bad_inode;

        // byte_len <= PFF_LEN_MAX.
        mov r11, 0x10000000000;
        cmp r14, r11;
        ja  pff_ta_bad_len;

        // Low-first free scan. Row stride is 64 (power-of-two: single shl).
        xor rbx, rbx;                    // row_id
      pff_ta_scan:
        cmp rbx, 16;
        jae pff_ta_enospc;

        lea r10, [rip + _pdxfs_file_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pff_ta_claim;

        add rbx, 1;
        jmp pff_ta_scan;

      pff_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // inode_no
        mov [r10 + 16], r14;             // byte_len
        mov [r10 + 24], r15;             // created_ns
        mov [r10 + 32], rbp;             // mtime_ns
        mov rax, 1;
        mov [r10 + 40], rax;             // refcount = 1
        mov rax, 0xFF;
        mov [r10 + 48], rax;             // volume_slot = 0xFF (backward-compat sentinel)
        xor rax, rax;
        mov [r10 + 56], rax;             // inode_lba = 0 (backward-compat sentinel)
        mov rax, rbx;
        jmp pff_ta_out;

      pff_ta_enospc:
        mov rax, 0xFFFFEC2F;             // PFF_TAIL_ENOSPC
        jmp pff_ta_out;
      pff_ta_bad_inode:
        mov rax, 0xFFFFEC2B;             // PFF_MINT_BAD_INODE
        jmp pff_ta_out;
      pff_ta_bad_len:
        mov rax, 0xFFFFEC2A;             // PFF_MINT_BAD_LEN
        jmp pff_ta_out;
      pff_ta_bad:
        mov rax, 0xFFFFEC2E;             // PFF_TAIL_BAD_ARG

      pff_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_tail_valid(row_id) -> 1 | 0
  // ==========================================================================

  pub let pdxfs_file_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): 1 iff row_id < PFF_MAX and in_use byte set. Every decoder gates on this so a freed row answers PFF_DECODE_BAD. Row stride widened to 64 bytes at R52.M4-001 (#1697). Labels prefixed pff_tv_.",
      block: {
        cmp rdi, 16;
        jae pff_tv_no;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, rdi;
        shl r11, 6;                      // row * 64
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pff_tv_no;
        mov rax, 1;
        ret;
      pff_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_tail_free(row_id) -> ()
  // ==========================================================================

  pub let pdxfs_file_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): scrub one row to zero, clearing in_use, inode, len, timestamps, refcount, and (R52.M4-001 (#1697)) volume_slot + inode_lba. Eight words, row stride 64 bytes. A row that kept its inode (or its volume_slot / inode_lba) across a re-mint would let a stale reader observe a live-looking descriptor pointing at bytes no capability names. No-op on out-of-range. Labels prefixed pff_tf_.",
      block: {
        cmp rdi, 16;
        jae pff_tf_out;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      pff_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors -- every one returns PFF_DECODE_BAD on a dead row.
  // ==========================================================================

  pub let pdxfs_file_row_inode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): inode_no, or PFF_DECODE_BAD. Labels prefixed pff_ri_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_ri_bad;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, r12;
        shl r11, 6;                      // row * 64 (R52.M4-001 #1697)
        add r10, r11;
        mov rax, [r10 + 8];
        jmp pff_ri_out;
      pff_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pff_ri_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_file_row_len : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): byte_len, or PFF_DECODE_BAD. Labels prefixed pff_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_rl_bad;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, r12;
        shl r11, 6;                      // row * 64 (R52.M4-001 #1697)
        add r10, r11;
        mov rax, [r10 + 16];
        jmp pff_rl_out;
      pff_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pff_rl_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_file_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): mode_bits (low 16 bits of header), or PFF_DECODE_BAD. Labels prefixed pff_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_rm_bad;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, r12;
        shl r11, 6;                      // row * 64 (R52.M4-001 #1697)
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFFFF;
        and rax, r10;
        jmp pff_rm_out;
      pff_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pff_rm_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_file_row_birth : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): created_ns, or PFF_DECODE_BAD. Labels prefixed pff_rb_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_rb_bad;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, r12;
        shl r11, 6;                      // row * 64 (R52.M4-001 #1697)
        add r10, r11;
        mov rax, [r10 + 24];
        jmp pff_rb_out;
      pff_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pff_rb_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_file_row_mtime : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): mtime_ns, or PFF_DECODE_BAD. Labels prefixed pff_rt_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_rt_bad;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, r12;
        shl r11, 6;                      // row * 64 (R52.M4-001 #1697)
        add r10, r11;
        mov rax, [r10 + 32];
        jmp pff_rt_out;
      pff_rt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pff_rt_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_file_row_refs : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): refcount, or PFF_DECODE_BAD. Labels prefixed pff_rr_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_rr_bad;
        lea r10, [rip + _pdxfs_file_table];
        mov r11, r12;
        shl r11, 6;                      // row * 64 (R52.M4-001 #1697)
        add r10, r11;
        mov rax, [r10 + 40];
        jmp pff_rr_out;
      pff_rr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pff_rr_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_row_of_slot(slot) -> row_id | PFF_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let pdxfs_file_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1623): slot -> row_id, gated on the descriptor being a live KIND_PDXFS_FILE. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A PDXFS-FILE ROW. Returns PFF_ROW_NONE (0xFF) for an out-of-range slot, null descriptor, wrong kind, or dead row. Kind constant 0x195 is staged in r11 because it does not sign-extend from a 32-bit immediate (band 0x100-0xFFF exceeds the imm sign-ext range for cmp reg, imm). Labels prefixed pff_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae pff_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x195;                  // KIND_PDXFS_FILE
        cmp r10, r11;
        jne pff_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_ros_none;

        mov rax, r12;
        jmp pff_ros_out;

      pff_ros_none:
        mov rax, 0xFF;                   // PFF_ROW_NONE
      pff_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_cap_revoke(row_id) -> PFF_OK | PFF_BAD_SLOT | PFF_REVOKE_ALREADY
  // ==========================================================================

  pub let pdxfs_file_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1623): scrub one row via pdxfs_file_tail_free and bump REVOKES. Refuses out-of-range with BAD_SLOT; refuses already-dead with REVOKE_ALREADY so the caller can distinguish 'never existed' from 'already gone'. Two callee-save pushes leave rsp%16 == 0. Labels prefixed pff_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae pff_cr_bad_slot;

        mov rdi, r12;
        call pdxfs_file_tail_valid;
        cmp rax, 0;
        je  pff_cr_already;

        mov rdi, r12;
        call pdxfs_file_tail_free;
        mov rdi, 1;                      // PFF_ST_REVOKES
        call pdxfs_file_note;
        xor rax, rax;                    // PFF_OK
        jmp pff_cr_out;

      pff_cr_bad_slot:
        mov rax, 0xFFFFEC28;             // PFF_BAD_SLOT
        jmp pff_cr_out;
      pff_cr_already:
        mov rax, 0xFFFFEC26;             // PFF_REVOKE_ALREADY

      pff_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_file_cap_mint_inner(parent_slot, rights, inode_no, byte_len,
  //                           created_ns, mtime_ns) -> row_id | PFF_MINT_*
  // ==========================================================================

  pub let pdxfs_file_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (inode_no: u64) (byte_len: u64) (created_ns: u64) (mtime_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1623): the KIND_PDXFS_FILE mint walker.  Sequences: (1) parent gate (kind == KIND_MEMORY carrying RIGHT_MINT) -> MINT_BAD_PARENT; (2) rights_valid -> MINT_BAD_RIGHTS; (3) header pack over mode_bits = default (0o644 = 0x1A4) -- callers supply mode via a widened wrapper later; (4) tail_alloc claims a row.  On refusal PFF_ST_REFUSED bumps.  Six callee-save pushes + sub rsp, 8 = 56 bytes: post-prologue rsp%16 == 0 for every nested call.  Labels prefixed pff_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // inode_no
        mov r14, rcx;                    // byte_len
        mov r15, r8;                     // created_ns
        mov rbp, r9;                     // mtime_ns

        // (1) Parent gate.
        mov rdi, r12;
        call pdxfs_file_check_parent_memory;
        cmp rax, 0;
        je  pff_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call pdxfs_file_rights_valid;
        cmp rax, 0;
        je  pff_mi_bad_rights;

        // (3) Pack header with default mode 0o644 (0x1A4).
        mov rdi, 0x1A4;
        call pdxfs_file_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pff_mi_bad_rights;

        // (4) tail_alloc.
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // inode_no
        mov rdx, r14;                    // byte_len
        mov rcx, r15;                    // created_ns
        mov r8,  rbp;                    // mtime_ns
        call pdxfs_file_tail_alloc;
        mov r10, 16;                     // PFF_MAX
        cmp rax, r10;
        jae pff_mi_alloc_fail;

        // Success -- row_id in rax. Bump MINTS.
        push rax;
        mov rdi, 0;                      // PFF_ST_MINTS
        call pdxfs_file_note;
        pop rax;
        jmp pff_mi_out;

      pff_mi_alloc_fail:
        jmp pff_mi_refused;
      pff_mi_bad_parent:
        mov rax, 0xFFFFEC2D;             // PFF_MINT_BAD_PARENT
        jmp pff_mi_refused;
      pff_mi_bad_rights:
        mov rax, 0xFFFFEC2C;             // PFF_MINT_BAD_RIGHTS

      pff_mi_refused:
        push rax;
        mov rdi, 3;                      // PFF_ST_REFUSED
        call pdxfs_file_note;
        pop rax;

      pff_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_pdxfs_file(rights, target_ptr, op_arg) -> ...
  //
  // Wired into cap_invoke_dispatch on `cmp rcx, 0x195; je call_kind_pdxfs_file`.
  // ==========================================================================

  pub let cap_handler_pdxfs_file : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R48b substrate-prep (#1623): KIND_PDXFS_FILE dispatch. RIGHTS TESTED PER OP -- QUERY_* need R_PDXFS_FILE_INVOKE; DEBUG_PRINT needs R_PDXFS_FILE_OBSERVE. op_arg[63:8] MUST be zero -- a smuggled second value on an op reaching an inode / len / mode field is refused rather than masked. Labels prefixed pff_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id in low 16
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne pff_hn_res;

        cmp rbp, 6;                      // PFF_OP_MAX
        ja  pff_hn_unsup;

        cmp rbp, 6;                      // DEBUG_PRINT?
        je  pff_hn_dbg;

        // Query ops need R_PDXFS_FILE_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  pff_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  pff_hn_inode;
        cmp rbp, 1;
        je  pff_hn_len;
        cmp rbp, 2;
        je  pff_hn_mode;
        cmp rbp, 3;
        je  pff_hn_birth;
        cmp rbp, 4;
        je  pff_hn_mtime;
        call pdxfs_file_row_refs;        // op == 5
        jmp pff_hn_count;

      pff_hn_inode:
        call pdxfs_file_row_inode;
        jmp pff_hn_count;
      pff_hn_len:
        call pdxfs_file_row_len;
        jmp pff_hn_count;
      pff_hn_mode:
        call pdxfs_file_row_mode;
        jmp pff_hn_count;
      pff_hn_birth:
        call pdxfs_file_row_birth;
        jmp pff_hn_count;
      pff_hn_mtime:
        call pdxfs_file_row_mtime;
        jmp pff_hn_count;

      pff_hn_count:
        push rax;
        mov rdi, 2;                      // PFF_ST_QUERIES
        call pdxfs_file_note;
        pop rax;
        jmp pff_hn_out;

      pff_hn_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_PDXFS_FILE_OBSERVE
        cmp r10, 0;
        je  pff_hn_denied;
        xor rax, rax;
        jmp pff_hn_out;

      pff_hn_res:
        mov rax, 0xFFFFEC2E;             // PFF_TAIL_BAD_ARG
        jmp pff_hn_out;
      pff_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp pff_hn_out;
      pff_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      pff_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
