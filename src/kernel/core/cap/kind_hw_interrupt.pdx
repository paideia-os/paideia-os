// src/kernel/core/cap/kind_hw_interrupt.pdx — R29.M1-001..003 (#1019/#1020/#1021)
// KIND_HW_INTERRUPT derived-kind: tail encoding + mint/revoke + dispatch handler.
//
// Design context
// --------------
// Slot 14 of the base_kind enum was promoted to KIND_HW at R29.M0-001
// (#1017). Per design/roadmap/next-wave-synthesis.md §10 D6 and §3 R29
// of next-wave-softarch.md, the R29.M1 family of hardware-adjacent
// derived kinds rides that base. This module realises the first —
// KIND_HW_INTERRUPT (numeric tag 0x140) — with:
//
//   - a 128-bit descriptor tail encoding {gsi:u32, cpu_affinity_mask:u64,
//     edge_or_level:u8, reserved} in a kernel-owned indirection table
//     (`_hw_interrupt_table`) that the cap descriptor points into by
//     row_id;
//   - a rights refinement subset {R_HW_INT_INVOKE, R_HW_INT_MINT,
//     R_HW_INT_REVOKE, R_HW_INT_OBSERVE};
//   - a supervisor mint/revoke API (hw_int_cap_mint / hw_int_cap_revoke)
//     that requires an ancestor KIND_HW cap and cascades on revoke;
//   - a dispatch handler (cap_handler_hw_interrupt) that services the
//     OP_QUERY_* introspection ops today and reserves OP_MASK / OP_UNMASK /
//     OP_ACK op-codes for the R29.M2 IOAPIC/APIC integration.
//
// Numeric derived-kind tag
// ------------------------
// KIND_HW_INTERRUPT = 0x140 (decimal 320). Placed above the 4-bit base
// range (0..15) and distinct from every existing derived-kind tag
// (KIND_DRIVER=0x15, KIND_DMESG=0x16, KIND_ACPI=0x20, KIND_PCI_DEV=0x30).
// The base slot at LAM kind-hint level remains 14 (KIND_HW), so
// fast-dispatch on the base slot survives; the full u64 kind field
// stored in the descriptor at [+0] is compared against 0x140 in
// cap_invoke_dispatch to route to this module's handler.
//
// Descriptor tail
// ---------------
// The cap descriptor's target_ptr slot (bits [63:0]) holds a row_id
// (0..HW_INT_MAX-1) in bits [15:0]; upper bits [63:16] MUST be zero.
// The actual per-interrupt state (gsi/affinity/edge_or_level plus
// reserved bytes) lives in `_hw_interrupt_table[row_id]`, a 32-byte
// row (four u64s):
//
//   [+0]  u64:  bits [31:0]  = gsi (u32)
//               bits [39:32] = edge_or_level (u8; 0=edge, 1=level)
//               bits [47:40] = reserved (must be zero)
//               bits [55:48] = reserved (must be zero)
//               bits [63:56] = in_use flag (0=free, 1=allocated)
//   [+8]  u64:  cpu_affinity_mask (full u64, one bit per CPU)
//   [+16] u64:  reserved (future: polarity, ioapic_id, source_id per
//               next-wave-derived-kinds.md §KIND_HW_INTERRUPT)
//   [+24] u64:  reserved (future: pending-count, last-ack timestamp)
//
// Total tail state: 32 bytes = 256 bits, of which 104 are live and 152
// reserved for the R30+ IOAPIC/APIC integration work.
//
// Table sizing
// ------------
// HW_INT_MAX = 64. This matches typical IOAPIC redirection-table depth
// (24 entries per IOAPIC × up to 2 IOAPICs = 48 for the base MADT of a
// server board, rounded up to a power-of-two for scan efficiency). The
// backing storage is 64 * 32 = 2048 bytes in .bss.
//
// Rights discipline
// -----------------
// A KIND_HW_INTERRUPT cap carries a subset of R_HW_INT_ALL:
//
//   R_HW_INT_INVOKE  (0x008) — OP_UNMASK / OP_MASK / OP_ACK (R29.M2+)
//   R_HW_INT_REVOKE  (0x010) — supervisor revoke path
//   R_HW_INT_MINT    (0x200) — mint further derived caps (unused today;
//                              reserved for KIND_HW_MSIX_VECTOR
//                              derivation at R29.M1-004 #1022)
//   R_HW_INT_OBSERVE (0x400) — OP_QUERY_GSI / _AFFINITY / _TRIGGER
//   R_HW_INT_ALL     (0x618) — bitwise OR of all four.
//
// These bits are aliases of Rights.RIGHT_INVOKE/RIGHT_REVOKE/RIGHT_MINT/
// RIGHT_OBSERVE (rights.pdx); local names sharpen the intent for the
// mint gate + dispatch handler.
//
// Mint discipline
// ---------------
// hw_int_cap_mint requires the caller to hold an ancestor KIND_HW cap
// with RIGHT_MINT (0x200) — the "hardware authority" gate. The mint
// call takes the ancestor's slot number as its first argument;
// hw_int_check_parent_kind_hw runs the ancestor probe (reads the
// descriptor at cap_table[parent_slot], asserts kind==14 and
// rights & 0x200 != 0). No paideia-as / ring-3 code should be able to
// mint a KIND_HW_INTERRUPT cap without going through this gate — every
// caller passes through hw_int_cap_mint.
//
// Revoke discipline
// -----------------
// hw_int_cap_revoke reads the cap descriptor at the target slot,
// verifies kind == KIND_HW_INTERRUPT (0x140), extracts the row_id
// from target_ptr[15:0], frees the row (zeros all 32 bytes), and
// clears the cap descriptor (kind=KIND_NULL=0, rights=0, target_ptr=0).
// Idempotent: revoking an already-revoked slot returns
// HW_INT_REVOKE_ALREADY.
//
// Cascade note: KIND_HW_MSIX_VECTOR (#1022, landed) derives over
// KIND_HW_INTERRUPT — a KIND_HW_INTERRUPT cap authorizes a line/GSI
// and MINTS N KIND_HW_MSIX_VECTOR children (one per MSI-X vector on
// the underlying device). hw_int_cap_revoke calls
// msix_cascade_revoke_by_parent (kind_hw_msix_vector.pdx) BEFORE
// freeing its own row/descriptor. The cascade scans cap_table[0..255],
// matches every descriptor with kind == 0x141 whose row.parent_slot ==
// the being-revoked slot, and revokes each child. The invariant "no
// dangling KIND_HW_MSIX_VECTOR child after parent revoke" is enforced
// by the cascade + witness sub-tests.
//
// Boot witness (kernel_main.pdx §kind_hw_interrupt_witness) exercises
// the full round-trip: allocate a row (gsi=0x30, affinity=0x01,
// edge_or_level=0), mint the derived cap into slot 12, invoke each of
// the three OP_QUERY_* ops, revoke the cap, verify the descriptor is
// null and the row is free. Emits `R29 KIND_INTERRUPT OK`.
//
// Structural witness gate for paideia-as: the tail_alloc / tail_valid
// / rights_valid encoders reject malformed inputs (row_id >= HW_INT_MAX,
// rights outside R_HW_INT_ALL, edge_or_level > 1). Witness sub-tests
// C/D/H cover the three failure edges.

module KindHwInterrupt = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================

  // Runtime base kind (LAM kind-hint slot). Matches cap/kind.pdx §KIND_HW.
  pub let KIND_HW_INT_BASE : u64 = 14

  // Derived-kind tag. Value 0x140 (decimal 320); above the 4-bit base
  // range, distinct from KIND_DRIVER (0x15), KIND_DMESG (0x16),
  // KIND_ACPI (0x20), and KIND_PCI_DEV (0x30).
  pub let KIND_HW_INTERRUPT : u64 = 0x140

  // ============================================================================
  // Rights (subset legal on a KIND_HW_INTERRUPT capability)
  // ============================================================================

  pub let R_HW_INT_INVOKE  : u64 = 0x008   // matches Rights.RIGHT_INVOKE
  pub let R_HW_INT_REVOKE  : u64 = 0x010   // matches Rights.RIGHT_REVOKE
  pub let R_HW_INT_MINT    : u64 = 0x200   // matches Rights.RIGHT_MINT
  pub let R_HW_INT_OBSERVE : u64 = 0x400   // matches Rights.RIGHT_OBSERVE
  pub let R_HW_INT_ALL     : u64 = 0x618   // INVOKE|REVOKE|MINT|OBSERVE

  // ============================================================================
  // Table caps
  // ============================================================================

  pub let HW_INT_MAX       : u64 = 64
  pub let HW_INT_ROW_BYTES : u64 = 32

  // ============================================================================
  // Return codes
  // ============================================================================

  pub let HW_INT_TAIL_OK             : u64 = 0
  pub let HW_INT_TAIL_ENOSPC         : u64 = 0xFFFFFFFF
  pub let HW_INT_TAIL_BAD_ARG        : u64 = 0xFFFFFFFE

  pub let HW_INT_MINT_OK             : u64 = 0
  pub let HW_INT_MINT_BAD_PARENT     : u64 = 0xFFFFFFFD
  pub let HW_INT_MINT_BAD_RIGHTS     : u64 = 0xFFFFFFFC
  pub let HW_INT_MINT_ENOSPC         : u64 = 0xFFFFFFFB
  pub let HW_INT_MINT_BAD_ARG        : u64 = 0xFFFFFFFA

  pub let HW_INT_REVOKE_OK           : u64 = 0
  pub let HW_INT_REVOKE_BAD_SLOT     : u64 = 0xFFFFFFF9
  pub let HW_INT_REVOKE_WRONG_KIND   : u64 = 0xFFFFFFF8
  pub let HW_INT_REVOKE_ALREADY      : u64 = 0xFFFFFFF7

  // ============================================================================
  // Ops (op_arg[7:0] = op_code)
  // ============================================================================

  pub let HW_INT_OP_QUERY_GSI       : u64 = 0   // RIGHT_OBSERVE -> gsi
  pub let HW_INT_OP_QUERY_AFFINITY  : u64 = 1   // RIGHT_OBSERVE -> cpu_affinity_mask
  pub let HW_INT_OP_QUERY_TRIGGER   : u64 = 2   // RIGHT_OBSERVE -> edge_or_level
  pub let HW_INT_OP_MASK            : u64 = 3   // RIGHT_INVOKE  -> INVOKE_UNSUPPORTED (R29.M2)
  pub let HW_INT_OP_UNMASK          : u64 = 4   // RIGHT_INVOKE  -> INVOKE_UNSUPPORTED (R29.M2)
  pub let HW_INT_OP_ACK             : u64 = 5   // RIGHT_INVOKE  -> INVOKE_UNSUPPORTED (R29.M2)

  // ============================================================================
  // Backing table
  // ============================================================================
  //
  // 64 rows * 32 bytes = 2048 bytes = 256 u64s. .bss zero-init means every
  // row starts with in_use=0 (byte 7 of the [+0] u64), which is the free
  // sentinel that hw_int_tail_alloc scans for.

  pub let mut _hw_interrupt_table : [u64; 256] = uninit @align(64)

  // ============================================================================
  // hw_int_tail_alloc(gsi, cpu_affinity_mask, edge_or_level) -> u64
  //
  // Allocates a free row, populates it with the caller's tail fields,
  // and returns the row_id. Returns HW_INT_TAIL_ENOSPC (0xFFFFFFFF) if
  // no free row is available; returns HW_INT_TAIL_BAD_ARG (0xFFFFFFFE)
  // if edge_or_level > 1 or gsi >= 2^32.
  //
  // SysV ABI: rdi = gsi, rsi = cpu_affinity_mask, rdx = edge_or_level.
  // ============================================================================

  pub let hw_int_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (gsi: u64) (cpu_affinity_mask: u64) (edge_or_level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-002 (#1020): allocate a free _hw_interrupt_table row + populate it. Bad-arg gate first: gsi >= 2^32 -> HW_INT_TAIL_BAD_ARG (defensive; caller-side u32 truncation would silently drop bits). edge_or_level > 1 -> HW_INT_TAIL_BAD_ARG. Low-first row scan (r8 = row cursor, rcx = row_id): row is free iff in_use byte (byte 7 of [row+0]) is zero. Exhaustion returns HW_INT_TAIL_ENOSPC. Claim: pack (gsi & 0xFFFFFFFF) | ((edge_or_level & 0xFF) << 32) | (1 << 56) into [row+0]; cpu_affinity_mask into [row+8]; zero into [row+16] and [row+24] (guarantee no stale bytes for the R30+ reserved fields). Row size 32 bytes. .bss zero-init preserves the in_use=0 invariant between kernel boots. Written as unsafe block per paideia-as #913 (multi-statement pure-fn T0532).",
      block: {
        // Bad-arg gate: edge_or_level > 1.
        cmp rdx, 1;
        ja  hw_int_alloc_bad_arg;

        // Bad-arg gate: gsi >= 2^32 (upper bits of rdi non-zero).
        mov r10, rdi;
        shr r10, 32;
        cmp r10, 0;
        jne hw_int_alloc_bad_arg;

        // Save incoming args across the scan.
        //   rdi = gsi          -> keep in r13 (callee-save, restore across leaf)
        //   rsi = affinity     -> keep in r14
        //   rdx = edge_or_level-> keep in r15
        push r13;
        push r14;
        push r15;
        mov r13, rdi;
        mov r14, rsi;
        mov r15, rdx;

        // Row cursor.
        lea r8, [rip + _hw_interrupt_table];
        xor rcx, rcx;

      hw_int_alloc_scan:
        cmp rcx, 64;                       // HW_INT_MAX
        jae hw_int_alloc_none;
        mov rax, [r8];                     // row header
        // in_use = byte 7 = (header >> 56) & 0xFF. Test upper byte.
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  hw_int_alloc_found;
        add r8, 32;                        // HW_INT_ROW_BYTES
        add rcx, 1;
        jmp hw_int_alloc_scan;

      hw_int_alloc_found:
        // Pack row header:
        //   bits [31:0]  = gsi
        //   bits [39:32] = edge_or_level
        //   bits [63:56] = in_use (1)
        mov rax, r13;                      // gsi
        mov r10, 0xFFFFFFFF;
        and rax, r10;                      // rax = gsi & 0xFFFFFFFF

        mov r10, r15;                      // edge_or_level
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;

        mov r10, 1;
        shl r10, 56;                       // in_use bit
        or  rax, r10;

        mov [r8 + 0], rax;                 // header
        mov [r8 + 8], r14;                 // cpu_affinity_mask
        xor rax, rax;
        mov [r8 + 16], rax;                // reserved
        mov [r8 + 24], rax;                // reserved

        mov rax, rcx;                      // return row_id

        pop r15;
        pop r14;
        pop r13;
        ret;

      hw_int_alloc_none:
        pop r15;
        pop r14;
        pop r13;
        mov rax, 0xFFFFFFFF;               // HW_INT_TAIL_ENOSPC
        ret;

      hw_int_alloc_bad_arg:
        mov rax, 0xFFFFFFFE;               // HW_INT_TAIL_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // hw_int_tail_free(row_id) -> ()
  //
  // Zeros the row at row_id, releasing it. No-op if row_id >= HW_INT_MAX.
  // ============================================================================

  pub let hw_int_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-003 (#1021): row_id >= HW_INT_MAX -> silent no-op (out of range, matches endpoint_free discipline). Otherwise compute row = &_hw_interrupt_table + row_id*32 via `shl 5` (row_id * 32 = row_id << 5). Zero all four u64s of the row via `xor rax,rax; mov [r8+off],rax` for off in {0,8,16,24}. Zeroing [row+0] alone clears in_use (byte 7) — sufficient for the free/live discipline used by hw_int_tail_alloc's scan; full-row zero prevents stale gsi/affinity bytes from leaking into a subsequent alloc's row read. Leaf function; no callee-save writes.",
      block: {
        cmp rdi, 64;                       // HW_INT_MAX
        jae hw_int_free_done;

        // row = &_hw_interrupt_table + row_id * 32 (shl 5).
        mov r8, rdi;
        shl r8, 5;                         // row_id * 32
        lea r9, [rip + _hw_interrupt_table];
        add r8, r9;

        xor rax, rax;
        mov [r8 + 0], rax;
        mov [r8 + 8], rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;

      hw_int_free_done:
        ret
      }
    }

  // ============================================================================
  // hw_int_tail_decode_gsi(row_id) -> u64
  //
  // Returns gsi (bits [31:0] of the row header) if row_id is live;
  // 0xFFFFFFFFFFFFFFFF if row_id >= HW_INT_MAX or row is not in_use.
  // ============================================================================

  pub let hw_int_tail_decode_gsi : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-002 (#1020): decode gsi from _hw_interrupt_table[row_id]. Bounds-check row_id < HW_INT_MAX, load [row+0], check in_use byte (bit 56..63) non-zero, mask low 32 bits. Returns 0xFF... sentinel on any failure so callers cannot mistake a zero gsi for a decode-fail. Leaf function; pure read.",
      block: {
        cmp rdi, 64;
        jae hw_int_dec_gsi_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_interrupt_table];
        add r8, r9;

        mov rax, [r8 + 0];
        // Check in_use (byte 7 = bits 56..63).
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  hw_int_dec_gsi_bad;

        // Mask low 32 bits.
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret;

      hw_int_dec_gsi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // hw_int_tail_decode_affinity(row_id) -> u64
  //
  // Returns cpu_affinity_mask from row_id's [+8] u64 if live; else 0.
  // (cpu_affinity_mask=0 is meaningful on a live cap — "no CPUs" — but
  // no live cap should have cpu_affinity_mask=0 per the mint gate.)
  // ============================================================================

  pub let hw_int_tail_decode_affinity : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-002 (#1020): decode cpu_affinity_mask from _hw_interrupt_table[row_id][+8]. Bounds-check + in_use check first; returns 0 on failure. Leaf function; pure read.",
      block: {
        cmp rdi, 64;
        jae hw_int_dec_aff_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_interrupt_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  hw_int_dec_aff_bad;

        mov rax, [r8 + 8];
        ret;

      hw_int_dec_aff_bad:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // hw_int_tail_decode_edge_or_level(row_id) -> u64
  //
  // Returns edge_or_level (bits [39:32] of header) if live; else 0xFF...
  // ============================================================================

  pub let hw_int_tail_decode_edge_or_level : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-002 (#1020): decode edge_or_level from _hw_interrupt_table[row_id][+0] bits [39:32]. Bounds-check + in_use check first; returns 0xFF... on failure so callers cannot mistake 0=edge or 1=level for a decode-fail. Leaf function; pure read.",
      block: {
        cmp rdi, 64;
        jae hw_int_dec_eol_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_interrupt_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  hw_int_dec_eol_bad;

        // Extract bits [39:32].
        shr rax, 32;
        mov r10, 0xFF;
        and rax, r10;
        ret;

      hw_int_dec_eol_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // hw_int_tail_valid(row_id) -> u64
  //
  // Returns 1 iff row_id < HW_INT_MAX AND row's in_use byte is non-zero.
  // ============================================================================

  pub let hw_int_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-002 (#1020): return 1 iff row_id refers to a live row in _hw_interrupt_table. Bounds-check row_id < HW_INT_MAX (64), load [row+0], test in_use (byte 7). Same shape as endpoint_tail_valid but on the hw_int_table layout. Leaf function; pure read.",
      block: {
        cmp rdi, 64;
        jae hw_int_valid_no;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_interrupt_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hw_int_valid_no;

        mov rax, 1;
        ret;

      hw_int_valid_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // hw_int_rights_valid(rights) -> u64
  //
  // Returns 1 iff rights is a subset of R_HW_INT_ALL (0x618).
  // ============================================================================

  pub let hw_int_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M1-001 (#1019): KIND_HW_INTERRUPT rights-subset validator. Returns 1 iff (rights & R_HW_INT_ALL) == rights; else 0. R_HW_INT_ALL = 0x618 (INVOKE|REVOKE|MINT|OBSERVE). Same shape as DeviceCap.rights_valid.",
      block: {
        mov rax, rdi;
        mov r10, 0x618;
        and rax, r10;
        cmp rax, rdi;
        jne hw_int_rights_no;
        mov rax, 1;
        ret;

      hw_int_rights_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // hw_int_check_parent_kind_hw(parent_slot) -> u64
  //
  // Returns 1 iff cap_table[parent_slot].kind == KIND_HW (14) AND
  // (rights & R_HW_INT_MINT) != 0. Else returns 0.
  //
  // This is the "ancestor KIND_HW cap holding RIGHT_MINT" gate required
  // for hw_int_cap_mint per design/architecture/next-wave-derived-kinds.md
  // §KIND_HW rights table.
  // ============================================================================

  pub let hw_int_check_parent_kind_hw : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M1-001 (#1019): supervisor mint-gate for KIND_HW_INTERRUPT. Load descriptor at cap_table + parent_slot*24 (mul-by-24 = shl 3 + shl 4 + add, same as invoke.pdx). Assert kind field ([+0]) == 14 (KIND_HW) AND rights field ([+8]) has bit 0x200 (RIGHT_MINT / R_HW_INT_MINT) set. Bounds-check parent_slot < 256 first (cap_table capacity). Returns 1 on OK, 0 otherwise. Pure read; no writes.",
      block: {
        cmp rdi, 256;
        jae hw_int_parent_no;

        // Compute cap_table + parent_slot * 24.
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // Check kind == 14.
        mov r10, [rax + 0];
        cmp r10, 14;
        jne hw_int_parent_no;

        // Check rights & 0x200 != 0.
        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  hw_int_parent_no;

        mov rax, 1;
        ret;

      hw_int_parent_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // hw_int_cap_mint(slot, parent_slot, rights, gsi, cpu_affinity_mask,
  //                 edge_or_level) -> u64
  //
  // Full mint: validate parent, validate rights, allocate row, write
  // descriptor. Returns HW_INT_MINT_OK (0) on success; one of the
  // HW_INT_MINT_BAD_* codes on failure.
  //
  // SysV ABI (6 args in registers):
  //   rdi = slot                (target cap_table slot; 0..255)
  //   rsi = parent_slot         (ancestor KIND_HW cap slot; 0..255)
  //   rdx = rights              (subset of R_HW_INT_ALL)
  //   rcx = gsi                 (u32; upper bits must be zero)
  //   r8  = cpu_affinity_mask
  //   r9  = edge_or_level       (0 or 1)
  // ============================================================================

  // R29.M6-002 (#1041): the PUBLIC symbol is the audited wrapper below.
  // This is the verified body, unchanged, called only from it.
  pub let hw_int_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (gsi: u64)
       (cpu_affinity_mask: u64) (edge_or_level: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M1-003 (#1021): supervisor mint API for KIND_HW_INTERRUPT. Sequence: (1) bounds-check slot < 256 -> BAD_ARG. (2) hw_int_check_parent_kind_hw(parent_slot) -> BAD_PARENT. (3) hw_int_rights_valid(rights) -> BAD_RIGHTS. (4) hw_int_tail_alloc(gsi, affinity, edge_or_level) -> ENOSPC / BAD_ARG. (5) cap_mint_write(slot, KIND_HW_INTERRUPT=0x140, rights, row_id). Return HW_INT_MINT_OK (0). All 6 SysV register args are preserved across sub-calls via the caller-save stack (push rdi/rsi/rdx/rcx/r8/r9, pop in reverse). Callee-save r13/r14/r15 already saved by hw_int_tail_alloc if reached. Return-code space (HW_INT_MINT_*) is disjoint from cap_mint_write's void return.",
      block: {
        // Bounds-check slot.
        cmp rdi, 256;
        jae hw_int_mint_bad_arg;

        // Bounds-check edge_or_level.
        cmp r9, 1;
        ja  hw_int_mint_bad_arg;

        // -- Step 2: hw_int_check_parent_kind_hw(parent_slot).
        //    Save all 6 arg regs.
        push rdi;
        push rsi;
        push rdx;
        push rcx;
        push r8;
        push r9;
        mov rdi, rsi;                      // parent_slot in rdi
        call hw_int_check_parent_kind_hw;
        pop r9;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        pop rdi;
        cmp rax, 0;
        je  hw_int_mint_bad_parent;

        // -- Step 3: hw_int_rights_valid(rights).
        push rdi;
        push rsi;
        push rdx;
        push rcx;
        push r8;
        push r9;
        mov rdi, rdx;                      // rights in rdi
        call hw_int_rights_valid;
        pop r9;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        pop rdi;
        cmp rax, 0;
        je  hw_int_mint_bad_rights;

        // -- Step 4: hw_int_tail_alloc(gsi, affinity, edge_or_level).
        //    Arg move: rdi=gsi (from rcx), rsi=affinity (from r8), rdx=edge_or_level (from r9).
        push rdi;                          // save slot
        push rsi;                          // save parent_slot
        push rdx;                          // save rights
        mov rdi, rcx;                      // gsi
        mov rsi, r8;                       // affinity
        mov rdx, r9;                       // edge_or_level
        call hw_int_tail_alloc;
        // rax = row_id (or 0xFFFFFFFF / 0xFFFFFFFE on failure).
        pop rdx;                           // rights
        pop rsi;                           // parent_slot (unused past here)
        pop rdi;                           // slot

        // Check for allocation failure.
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je  hw_int_mint_enospc;
        mov r10, 0xFFFFFFFE;
        cmp rax, r10;
        je  hw_int_mint_bad_arg;

        // -- Step 5: cap_mint_write(slot, kind=0x140, rights, target_ptr=row_id).
        //    ABI: rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr.
        //    Current: rdi=slot, rdx=rights, rax=row_id.
        mov rsi, 0x140;                    // KIND_HW_INTERRUPT
        mov rcx, rax;                      // target_ptr = row_id
        call cap_mint_write;

        // Success.
        xor rax, rax;                      // HW_INT_MINT_OK (0)
        ret;

      hw_int_mint_bad_parent:
        mov rax, 0xFFFFFFFD;
        ret;

      hw_int_mint_bad_rights:
        mov rax, 0xFFFFFFFC;
        ret;

      hw_int_mint_enospc:
        mov rax, 0xFFFFFFFB;
        ret;

      hw_int_mint_bad_arg:
        mov rax, 0xFFFFFFFA;
        ret
      }
    }

  // ============================================================================
  // R29.M6-002 (#1041) — audited mint.
  //
  // Why the emission is a wrapper and not an edit to each exit path
  // ---------------------------------------------------------------
  // hw_int_cap_mint_inner has five exits carrying four distinct error
  // codes. Instrumenting each one means five chances to forget one, and
  // a separate register-preservation argument at every label — which is
  // exactly the "a call site can be forgotten" failure mode the audit
  // trail exists to not have, relocated one level down.
  //
  // The public symbol therefore saves the two identifying arguments,
  // calls the (otherwise untouched) verified body, and emits with the
  // body's return value as the outcome. Every exit is covered by
  // construction, callers see the same symbol and the same ABI, and the
  // verified body is unchanged.
  //
  // Refusals are recorded too, not just successes (audit schema §3.1): a
  // refused mint creates no descriptor and is therefore invisible to
  // every state-based check, while being precisely the pattern —
  // a supervisor repeatedly attempting mints it is not entitled to —
  // that an audit trail exists to surface. The reconciliation harness
  // counts only outcome == 0 records, so retaining refusals costs the
  // conservation check nothing.
  //
  // The added {sysreg} effect comes from drv_audit_emit's timestamp read
  // (kread_tsc) and propagates to the revoke wrapper and the two cascade
  // walkers below.
  // ============================================================================

  pub let hw_int_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (gsi: u64)
       (cpu_affinity_mask: u64) (edge_or_level: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M6-002 (#1041): audited entry point for KIND_HW_INTERRUPT mint. Three-push prologue (r12/r13/r14): at entry rsp%16 == 8 and three pushes bring it to 0, which SysV requires at both nested calls. r12 = target slot, r13 = parent slot — saved BEFORE the inner call because the inner body clobbers rdi/rsi. The six SysV argument registers are untouched by the three movs, so the inner body receives them exactly as the caller passed them. r14 holds the inner return value across drv_audit_emit and is restored to rax as this function's result, so the wrapper is return-value transparent. Emission happens on EVERY exit of the inner body — success and all four failure codes — because the wrapper cannot see which label was taken and does not need to: the code itself is field 5.",
      block: {
        push r12;
        push r13;
        push r14;                            // 3 pushes -> rsp%16 = 0

        mov r12, rdi;                        // target cap slot
        mov r13, rsi;                        // parent KIND_HW slot

        call hw_int_cap_mint_inner;
        mov r14, rax;                        // outcome

        mov rdi, 1;                          // DRV_AUDIT_EV_MINT
        mov rsi, 0x140;                      // KIND_HW_INTERRUPT
        mov rdx, r12;                        // subject
        mov rcx, r13;                        // principal
        mov r8,  r14;                        // outcome
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // hw_int_cap_revoke(slot) -> u64
  //
  // Full revoke: verify descriptor at cap_table[slot] is a KIND_HW_INTERRUPT,
  // extract row_id from target_ptr, free the row, clear the descriptor
  // (kind=KIND_NULL, rights=0, target_ptr=0).
  //
  // Returns HW_INT_REVOKE_OK on success, or one of the HW_INT_REVOKE_*
  // codes. Idempotent: revoking an already-null slot returns
  // HW_INT_REVOKE_ALREADY.
  // ============================================================================

  // R29.M6-002 (#1041): the PUBLIC symbol is the audited wrapper below.
  pub let hw_int_cap_revoke_inner : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M1-003 (#1021) + R29.M1-004 cascade (#1022): supervisor revoke API for KIND_HW_INTERRUPT. Sequence: (1) bounds-check slot < 256 -> BAD_SLOT. (2) Load descriptor at cap_table + slot*24. (3) If kind == 0 -> REVOKE_ALREADY (already-null slot is idempotent). (4) If kind != 0x140 -> WRONG_KIND. (5) Cascade: call msix_cascade_revoke_by_parent(slot) BEFORE freeing our own row/descriptor so children can still observe the parent-slot metadata in their rows. (6) Extract row_id from target_ptr[15:0], call hw_int_tail_free(row_id). (7) Clear descriptor (write 0,0,0). Return REVOKE_OK. Cascade landed with #1022 — the invariant 'no dangling KIND_HW_MSIX_VECTOR child after parent revoke' is enforced here. The revoke path is safe against a concurrent invoke because R29.M1 substrate is single-flow pre-scheduler-bringup + non-preemptible (no other CPU can hold a stale row_id past revoke; SMP-safety revisits at R29.M4). Preserve slot in a callee-save register (r13) across the msix cascade call.",
      block: {
        cmp rdi, 256;
        jae hw_int_revoke_bad_slot;

        // Compute cap_table + slot * 24.
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // Save descriptor base for later writeback.
        mov r11, rax;

        // Load kind. target_ptr is re-loaded from [r11+16] after the
        // kind / already-null branches — no need to cache it in a
        // callee-save register (r12 was used in an earlier draft but
        // that violated SysV callee-save discipline; every caller-side
        // r12 write inside hw_int_cap_revoke would leak into the
        // caller's state without a matching push/pop).
        mov r10, [rax + 0];                // kind

        // Idempotent already-null check.
        cmp r10, 0;
        je  hw_int_revoke_already;

        // Kind check.
        mov r9, 0x140;
        cmp r10, r9;
        jne hw_int_revoke_wrong_kind;

        // -- Cascade: revoke all KIND_HW_MSIX_VECTOR children whose
        //    row's parent_slot matches the slot being revoked. Runs
        //    BEFORE freeing our own row/descriptor so children can
        //    still observe the parent-slot metadata during their own
        //    row-decode. Preserve rdi (slot) + r11 (descriptor base)
        //    across the call — msix_cascade_revoke_by_parent uses
        //    r12/r13/r14/rbx internally with proper push/pop.
        push rdi;                          // preserve slot for later
        push r11;                          // preserve descriptor base
        call msix_cascade_revoke_by_parent;
        pop r11;
        pop rdi;

        // Extract row_id = target_ptr[15:0] (re-load from descriptor).
        mov rdi, [r11 + 16];
        mov r10, 0xFFFF;
        and rdi, r10;

        // Free the row (silent no-op if row_id >= HW_INT_MAX).
        push r11;                          // preserve descriptor base
        call hw_int_tail_free;
        pop r11;

        // Clear descriptor: kind=0, rights=0, target_ptr=0.
        xor rax, rax;
        mov [r11 + 0],  rax;
        mov [r11 + 8],  rax;
        mov [r11 + 16], rax;

        // HW_INT_REVOKE_OK (0)
        xor rax, rax;
        ret;

      hw_int_revoke_bad_slot:
        mov rax, 0xFFFFFFF9;
        ret;

      hw_int_revoke_wrong_kind:
        mov rax, 0xFFFFFFF8;
        ret;

      hw_int_revoke_already:
        mov rax, 0xFFFFFFF7;
        ret
      }
    }

  // ============================================================================
  // R29.M6-002 (#1041) — audited revoke.
  //
  // Ordering note: the inner body cascades into
  // msix_cascade_revoke_by_parent, which calls the PUBLIC (and therefore
  // audited) msix_cap_revoke. So the stream reads
  //
  //   REVOKE 0x141 child_a
  //   REVOKE 0x141 child_b
  //   ...
  //   REVOKE 0x140 parent      <- emitted here, after the inner returns
  //
  // one record per descriptor actually destroyed. That is the
  // precondition for the reconciliation harness (#1042) to be a real
  // conservation check rather than a count of top-level calls: a cascade
  // that freed rows without revoking descriptors shows up as a live
  // count exceeding the audit-derived balance, with nobody having to
  // think to check that particular table.
  // ============================================================================

  pub let hw_int_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M6-002 (#1041): audited entry point for KIND_HW_INTERRUPT revoke. Three-push prologue (r12/r13/r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls. r12 = slot, saved before the inner call clobbers rdi; r13 pushed for alignment uniformity with the mint wrapper; r14 carries the inner return value across drv_audit_emit and is restored to rax, so the wrapper is return-value transparent. principal is the slot itself for a revoke: unlike a mint there is no separate authorising parent, and recording the slot twice is more honest than inventing an authority the operation did not consult. Emission covers every exit of the inner body, including the idempotent REVOKE_ALREADY — an attempt to revoke nothing is still an attempt worth seeing.",
      block: {
        push r12;
        push r13;
        push r14;                            // 3 pushes -> rsp%16 = 0

        mov r12, rdi;                        // slot

        call hw_int_cap_revoke_inner;
        mov r14, rax;                        // outcome

        mov rdi, 2;                          // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x140;                      // KIND_HW_INTERRUPT
        mov rdx, r12;                        // subject
        mov rcx, r12;                        // principal
        mov r8,  r14;                        // outcome
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // cap_handler_hw_interrupt(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler installed by cap_invoke_dispatch when descriptor.kind
  // == 0x140. RDI=rights, RSI=target_ptr, RDX=op_arg — matches every other
  // kind_*.pdx handler ABI.
  //
  // op_arg[7:0] = op_code:
  //   0 (OP_QUERY_GSI)      RIGHT_OBSERVE -> gsi
  //   1 (OP_QUERY_AFFINITY) RIGHT_OBSERVE -> cpu_affinity_mask
  //   2 (OP_QUERY_TRIGGER)  RIGHT_OBSERVE -> edge_or_level
  //   3 (OP_MASK)           RIGHT_INVOKE  -> INVOKE_UNSUPPORTED (R29.M2)
  //   4 (OP_UNMASK)         RIGHT_INVOKE  -> INVOKE_UNSUPPORTED (R29.M2)
  //   5 (OP_ACK)            RIGHT_INVOKE  -> INVOKE_UNSUPPORTED (R29.M2)
  //   else                                -> INVOKE_UNSUPPORTED
  //
  // target_ptr is the row_id (bits [15:0]); the three OP_QUERY_* ops
  // extract row_id and delegate to hw_int_tail_decode_*.
  // ============================================================================

  pub let cap_handler_hw_interrupt : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M1-001 (#1019): KIND_HW_INTERRUPT dispatch handler. op_arg[7:0] = op_code. OP_QUERY_* (0..2) require RIGHT_OBSERVE (0x400) and delegate to hw_int_tail_decode_* with row_id = target_ptr & 0xFFFF. OP_MASK/UNMASK/ACK (3..5) require RIGHT_INVOKE (0x08) and return INVOKE_UNSUPPORTED (real IOAPIC/APIC integration lands at R29.M2 #1030+). Bad op -> INVOKE_UNSUPPORTED. Rights failure -> INVOKE_DENIED. Emits klog_s1(INFO, SUBSYS_CAP_, cap_hw_int_msg) chatter on entry for dispatch-witness continuity — matches every other kind_*.pdx handler. RDI-preserve discipline: push rdi/rsi/rdx before klog_s1, pop after.",
      block: {
        push rdi;
        push rsi;
        push rdx;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hw_int_msg];
        call klog_s1;
        pop rdx;
        pop rsi;
        pop rdi;

        // Extract op_code from op_arg[7:0].
        mov r8, rdx;
        and r8, 0xFF;

        cmp r8, 0;
        je  hw_int_h_query_gsi;
        cmp r8, 1;
        je  hw_int_h_query_aff;
        cmp r8, 2;
        je  hw_int_h_query_trig;
        cmp r8, 3;
        je  hw_int_h_mask;
        cmp r8, 4;
        je  hw_int_h_unmask;
        cmp r8, 5;
        je  hw_int_h_ack;
        // Unknown op.
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret;

      hw_int_h_query_gsi:
        // RIGHT_OBSERVE required.
        mov rax, rdi;
        and rax, 0x400;
        cmp rax, 0x400;
        jne hw_int_h_denied;
        // row_id = target_ptr & 0xFFFF.
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call hw_int_tail_decode_gsi;
        ret;

      hw_int_h_query_aff:
        mov rax, rdi;
        and rax, 0x400;
        cmp rax, 0x400;
        jne hw_int_h_denied;
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call hw_int_tail_decode_affinity;
        ret;

      hw_int_h_query_trig:
        mov rax, rdi;
        and rax, 0x400;
        cmp rax, 0x400;
        jne hw_int_h_denied;
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call hw_int_tail_decode_edge_or_level;
        ret;

      hw_int_h_mask:
      hw_int_h_unmask:
      hw_int_h_ack:
        // RIGHT_INVOKE required — but the op returns INVOKE_UNSUPPORTED
        // regardless (R29.M2 wire-up pending). Rights check runs first
        // so a caller without RIGHT_INVOKE sees DENIED, not the more
        // informative UNSUPPORTED.
        mov rax, rdi;
        and rax, 0x08;
        cmp rax, 0x08;
        jne hw_int_h_denied;
        mov rax, 0xFFFFFFFFFFFFFFFC;       // INVOKE_UNSUPPORTED
        ret;

      hw_int_h_denied:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;       // INVOKE_DENIED
        ret
      }
    }

}
