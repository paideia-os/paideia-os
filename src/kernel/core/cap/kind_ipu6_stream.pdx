  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let ipu6s_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (stream_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): live row holding stream_key, or ROW_NONE. Refuses to match 0. Labels prefixed ipu6s_fk_.",
      block: {
        cmp rdi, 0;
        je  ipu6s_fk_none;
        xor rcx, rcx;
      ipu6s_fk_scan:
        cmp rcx, 8;
        jae ipu6s_fk_none;
        lea r10, [rip + _ipu6_stream_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ipu6s_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  ipu6s_fk_hit;
      ipu6s_fk_next:
        add rcx, 1;
        jmp ipu6s_fk_scan;
      ipu6s_fk_hit:
        mov rax, rcx;
        ret;
      ipu6s_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let ipu6s_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): slot -> row_id, gated on live KIND_IPU6_STREAM. Labels prefixed ipu6s_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae ipu6s_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x17F;
        cmp r10, r11;
        jne ipu6s_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call ipu6s_tail_valid;
        cmp rax, 0;
        je  ipu6s_ros_none;

        mov rax, r12;
        jmp ipu6s_ros_out;

      ipu6s_ros_none:
        mov rax, 0xFF;
      ipu6s_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Six args -- camera_slot / format / width / height / fps packed
  // in two args to fit the ABI:
  //
  //   packed_geom encoding:
  //     [15:0]   format
  //     [31:16]  width
  //     [47:32]  height
  //     [55:48]  fps
  //     [63:56]  reserved
  // ==========================================================================

  pub let ipu6_stream_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (stream_key: u64) (camera_slot: u64) (packed_geom: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): mint KIND_IPU6_STREAM over KIND_IPC_ENDPOINT. Sequence: slot<256; check_parent; rights_valid; check_camera; format_valid; width/height/fps valid; stream_key non-zero (NO_KEY); uniqueness (IN_USE); read inherited endpoint id (BAD_EID on 0); pack; tail_alloc; cap_mint_write. Labels prefixed ipu6s_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // stream_key
        mov r15, r8;                     // camera_slot
        mov rbp, r9;                     // packed_geom

        mov r10, 256;
        cmp rbx, r10;
        jae ipu6s_mi_bad_slot;

        mov rdi, r12;
        call ipu6s_check_parent;
        cmp rax, 0;
        je  ipu6s_mi_bad_parent;

        mov rdi, r13;
        call ipu6s_rights_valid;
        cmp rax, 0;
        je  ipu6s_mi_bad_rights;

        // camera_slot check
        mov rdi, r15;
        call ipu6s_check_camera;
        cmp rax, 0;
        je  ipu6s_mi_bad_camera;

        // format
        mov r10, rbp;
        and r10, 0xFFFF;
        mov rdi, r10;
        call ipu6s_format_valid;
        cmp rax, 0;
        je  ipu6s_mi_bad_format;

        // width
        mov r10, rbp;
        shr r10, 16;
        and r10, 0xFFFF;
        mov rdi, r10;
        call ipu6s_dim_valid;
        cmp rax, 0;
        je  ipu6s_mi_bad_width;

        // height
        mov r10, rbp;
        shr r10, 32;
        and r10, 0xFFFF;
        mov rdi, r10;
        call ipu6s_dim_valid;
        cmp rax, 0;
        je  ipu6s_mi_bad_height;

        // fps
        mov r10, rbp;
        shr r10, 48;
        and r10, 0xFF;
        mov rdi, r10;
        call ipu6s_fps_valid;
        cmp rax, 0;
        je  ipu6s_mi_bad_fps;

        cmp r14, 0;
        je  ipu6s_mi_no_key;

        mov rdi, r14;
        call ipu6s_find_by_key;
        cmp rax, 0xFF;
        jne ipu6s_mi_in_use;

        // Inherited endpoint id from parent.
        mov rdi, r12;
        call ipu6s_parent_eid;
        cmp rax, 0;
        je  ipu6s_mi_bad_eid;
        push rax;                        // endpoint_id on stack

        // Pack body1(endpoint_slot, camera_slot).
        pop rdi;                         // endpoint_id
        mov rsi, r15;                    // camera_slot
        call ipu6s_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ipu6s_mi_bad_camera;
        push rax;                        // body1 on stack

        // Pack body2(fmt, width, height, fps).
        mov rdi, rbp;
        and rdi, 0xFFFF;                 // fmt
        mov rsi, rbp;
        shr rsi, 16;
        and rsi, 0xFFFF;                 // width
        mov rdx, rbp;
        shr rdx, 32;
        and rdx, 0xFFFF;                 // height
        mov rcx, rbp;
        shr rcx, 48;
        and rcx, 0xFF;                   // fps
        call ipu6s_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ipu6s_mi_bad_geom_pop;
        push rax;                        // body2 on stack

        // Header.
        mov rdi, r12;
        call ipu6s_hdr_pack;
        pop r11;                         // body2
        pop rbp;                         // body1 (rbp is being reused now)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ipu6s_mi_bad_parent;

        // tail_alloc(hdr, stream_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r11;
        call ipu6s_tail_alloc;

        mov r10, 0xFFFFF1FF;
        cmp rax, r10;
        je  ipu6s_mi_enospc;
        mov r10, 0xFFFFF1FE;
        cmp rax, r10;
        je  ipu6s_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x17F;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call ipu6s_note;

        xor rax, rax;
        jmp ipu6s_mi_out;

      ipu6s_mi_bad_geom_pop:
        add rsp, 8;
        jmp ipu6s_mi_bad_fps;

      ipu6s_mi_bad_slot:
        mov rax, 0xFFFFF1F2;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_parent:
        mov rax, 0xFFFFF1FD;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_rights:
        mov rax, 0xFFFFF1FC;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_camera:
        mov rax, 0xFFFFF1FB;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_format:
        mov rax, 0xFFFFF1FA;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_width:
        mov rax, 0xFFFFF1F9;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_height:
        mov rax, 0xFFFFF1F8;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_fps:
        mov rax, 0xFFFFF1F7;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_eid:
        mov rax, 0xFFFFF1F6;
        jmp ipu6s_mi_out;
      ipu6s_mi_no_key:
        mov rax, 0xFFFFF1F5;
        jmp ipu6s_mi_out;
      ipu6s_mi_in_use:
        mov rdi, 2;
        call ipu6s_note;
        mov rax, 0xFFFFF1F4;
        jmp ipu6s_mi_out;
      ipu6s_mi_enospc:
        mov rdi, 2;
        call ipu6s_note;
        mov rax, 0xFFFFF1F3;
        jmp ipu6s_mi_out;
      ipu6s_mi_bad_arg:
        mov rax, 0xFFFFF1FE;

      ipu6s_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let ipu6_stream_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): revoke KIND_IPU6_STREAM. Labels prefixed ipu6s_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae ipu6s_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  ipu6s_rvk_already;

        mov r11, 0x17F;
        cmp r10, r11;
        jne ipu6s_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call ipu6s_tail_valid;
        cmp rax, 0;
        je  ipu6s_rvk_clear;

        mov rdi, r13;
        call ipu6s_tail_free;

      ipu6s_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call ipu6s_note;

        xor rax, rax;
        jmp ipu6s_rvk_out;

      ipu6s_rvk_bad_slot:
        mov rax, 0xFFFFF1F2;
        jmp ipu6s_rvk_out;
      ipu6s_rvk_wrong_kind:
        mov rax, 0xFFFFF1F1;
        jmp ipu6s_rvk_out;
      ipu6s_rvk_already:
        mov rax, 0xFFFFF1F0;

      ipu6s_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_ipu6_stream : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): KIND_IPU6_STREAM dispatch. All ops arity ONE -- op_arg[63:8] REFUSED. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. Labels prefixed ipu6s_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_ipu6_stream_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne ipu6s_hn_res;

        cmp rbp, 7;
        ja  ipu6s_hn_unsup;

        cmp rbp, 7;
        je  ipu6s_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  ipu6s_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  ipu6s_hn_key;
        cmp rbp, 1;
        je  ipu6s_hn_ep;
        cmp rbp, 2;
        je  ipu6s_hn_cam;
        cmp rbp, 3;
        je  ipu6s_hn_fmt;
        cmp rbp, 4;
        je  ipu6s_hn_width;
        cmp rbp, 5;
        je  ipu6s_hn_height;
        call ipu6s_row_fps;
        jmp ipu6s_hn_out;

      ipu6s_hn_key:
        call ipu6s_row_key;
        jmp ipu6s_hn_out;
      ipu6s_hn_ep:
        call ipu6s_row_endpoint;
        jmp ipu6s_hn_out;
      ipu6s_hn_cam:
        call ipu6s_row_camera;
        jmp ipu6s_hn_out;
      ipu6s_hn_fmt:
        call ipu6s_row_format;
        jmp ipu6s_hn_out;
      ipu6s_hn_width:
        call ipu6s_row_width;
        jmp ipu6s_hn_out;
      ipu6s_hn_height:
        call ipu6s_row_height;
        jmp ipu6s_hn_out;

      ipu6s_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  ipu6s_hn_denied;
        xor rax, rax;
        jmp ipu6s_hn_out;

      ipu6s_hn_res:
        mov rax, 0xFFFFF1FE;
        jmp ipu6s_hn_out;
      ipu6s_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp ipu6s_hn_out;
      ipu6s_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      ipu6s_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
