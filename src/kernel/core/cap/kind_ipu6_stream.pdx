// src/kernel/core/cap/kind_ipu6_stream.pdx — R40.M3-002 (#1356)
//
// KIND_IPU6_STREAM = 0x17F, derived over KIND_IPC_ENDPOINT (5).
//
// The authority to hold ONE IPU6 camera-capture stream's static
// identity: a stream_key, an inherited endpoint id (the delivery
// endpoint for compressed frames + metadata), a camera_slot naming
// the live KIND_CSI_CAMERA the pipeline is bound to, an output
// pixel format ordinal (NV12 / YUYV / RAW10), a width, a height,
// and a target frame rate.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// R40.M2 admitted the camera sensor as KIND_CSI_CAMERA -- the static
// identity of one MIPI-CSI sensor plus its firmware/hardware bounds.
// R40.M3 introduces the STREAMING SESSION over that sensor: the row
// that names the pixel format the IPU6 pipeline shall emit, the
// resolution/fps setpoint the capture supervisor requested, the
// delivery endpoint frames land on, and the SPECIFIC camera the
// stream is bound to.
//
// The kind half of the derivation gate discriminates NOTHING on its
// own -- every endpoint in the system is a KIND_IPC_ENDPOINT (the
// shell's stdout included) -- so the mint additionally requires:
//
//   (a) stream_key non-zero and unique among live rows (NO_KEY /
//       IN_USE).
//   (b) camera_slot names a live KIND_CSI_CAMERA (BAD_CAMERA).
//   (c) format in {IPU6S_FMT_NV12, IPU6S_FMT_YUYV, IPU6S_FMT_RAW10}
//       (BAD_FORMAT).
//   (d) width in [1, IPU6S_DIM_MAX = 8192] (BAD_WIDTH).
//   (e) height in [1, IPU6S_DIM_MAX = 8192] (BAD_HEIGHT).
//   (f) fps in [1, IPU6S_FPS_MAX = 120] (BAD_FPS).
//   (g) rights subset of R_IPU6S_ALL (RIGHT_MINT outside -- LEAF).
//
// The endpoint_slot the row records is INHERITED at mint from the
// parent's target_ptr[15:0] (the encoding kind_endpoint.pdx's
// endpoint_tail_pack writes).  A mint that took the endpoint id as
// an argument would let one endpoint's identity be stamped on a
// different endpoint's row -- and every capture frame thereafter
// would be delivered to the wrong recipient.
//
// =============================================================================
// §1  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  stream_key    (u64)
//   [+16] body1:   endpoint_slot[31:0] | camera_slot[63:32]
//   [+24] body2:   format[15:0] | width[31:16] | height[47:32]
//                | fps[55:48] | reserved[63:56]
//
// Every field is set once at mint; no primitive in this module
// mutates any of them.  Revoke scrubs the entire row.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF1F0..0xFFFFF1FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band.  Adjacent used band above: sensor_init
// 0xFFFFF200..0F, R40.M2-004.  Adjacent free band below:
// ipu6_pipeline 0xFFFFF1E0..EF (R40.M3-001).

module KindIpu6Stream = structure {

  pub let KIND_IPU6_STREAM      : u64 = 0x17F
  pub let IPU6S_PARENT_KIND     : u64 = 5        // = KIND_IPC_ENDPOINT

  pub let IPU6S_DIM_MAX         : u64 = 8192
  pub let IPU6S_FPS_MAX         : u64 = 120

  // Output format ordinals -- opaque to this kind; the IPU6 pipeline
  // consumes them.  Enumerated so bit-widening is refused, not masked.
  pub let IPU6S_FMT_NV12        : u64 = 1
  pub let IPU6S_FMT_YUYV        : u64 = 2
  pub let IPU6S_FMT_RAW10       : u64 = 3

  // Rights -- LEAF.  R_MINT (0x200) OUTSIDE R_IPU6S_ALL.
  pub let R_IPU6S_READ    : u64 = 0x001
  pub let R_IPU6S_INVOKE  : u64 = 0x008
  pub let R_IPU6S_REVOKE  : u64 = 0x010
  pub let R_IPU6S_OBSERVE : u64 = 0x400
  pub let R_IPU6S_ALL     : u64 = 0x419

  // Ops -- all QUERY, all arity ONE (op_arg[63:8] REFUSED).
  pub let IPU6S_OP_QUERY_KEY      : u64 = 0
  pub let IPU6S_OP_QUERY_ENDPOINT : u64 = 1
  pub let IPU6S_OP_QUERY_CAMERA   : u64 = 2
  pub let IPU6S_OP_QUERY_FORMAT   : u64 = 3
  pub let IPU6S_OP_QUERY_WIDTH    : u64 = 4
  pub let IPU6S_OP_QUERY_HEIGHT   : u64 = 5
  pub let IPU6S_OP_QUERY_FPS      : u64 = 6
  pub let IPU6S_OP_DEBUG_PRINT    : u64 = 7
  pub let IPU6S_OP_MAX            : u64 = 7

  // Failure taxonomy 0xFFFFF1F0..FF.
  pub let IPU6S_OK                 : u64 = 0
  pub let IPU6S_TAIL_ENOSPC        : u64 = 0xFFFFF1FF
  pub let IPU6S_TAIL_BAD_ARG       : u64 = 0xFFFFF1FE
  pub let IPU6S_MINT_BAD_PARENT    : u64 = 0xFFFFF1FD
  pub let IPU6S_MINT_BAD_RIGHTS    : u64 = 0xFFFFF1FC
  pub let IPU6S_MINT_BAD_CAMERA    : u64 = 0xFFFFF1FB
  pub let IPU6S_MINT_BAD_FORMAT    : u64 = 0xFFFFF1FA
  pub let IPU6S_MINT_BAD_WIDTH     : u64 = 0xFFFFF1F9
  pub let IPU6S_MINT_BAD_HEIGHT    : u64 = 0xFFFFF1F8
  pub let IPU6S_MINT_BAD_FPS       : u64 = 0xFFFFF1F7
  pub let IPU6S_MINT_BAD_EID       : u64 = 0xFFFFF1F6
  pub let IPU6S_MINT_NO_KEY        : u64 = 0xFFFFF1F5
  pub let IPU6S_MINT_IN_USE        : u64 = 0xFFFFF1F4
  pub let IPU6S_MINT_ENOSPC        : u64 = 0xFFFFF1F3
  pub let IPU6S_BAD_SLOT           : u64 = 0xFFFFF1F2
  pub let IPU6S_WRONG_KIND         : u64 = 0xFFFFF1F1
  pub let IPU6S_REVOKE_ALREADY     : u64 = 0xFFFFF1F0

  pub let IPU6S_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let IPU6S_ROW_NONE   : u64 = 0xFF

  // Eight rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let IPU6S_MAX       : u64 = 8
  pub let IPU6S_ROW_BYTES : u64 = 32

  pub let mut _ipu6_stream_table : [u64; 32] = uninit @align(64)
  pub let mut _ipu6_stream_stats : [u64; 4]  = uninit @align(64)

  pub let IPU6S_ST_MINTS   : u64 = 0
  pub let IPU6S_ST_REVOKES : u64 = 1
  pub let IPU6S_ST_REFUSED : u64 = 2
  pub let IPU6S_ST_QUERIES : u64 = 3

  pub let ipu6s_dbg_msg : [u8; 16] = "IPU6 STREAM ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let ipu6_stream_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): clear KIND_IPU6_STREAM row table and counters. Boot + teardown only. Labels prefixed ipu6s_rs_.",
      block: {
        lea r10, [rip + _ipu6_stream_table];
        xor rax, rax;
        xor rcx, rcx;
      ipu6s_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  ipu6s_rs_rows;

        lea r10, [rip + _ipu6_stream_stats];
        xor rcx, rcx;
      ipu6s_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  ipu6s_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let ipu6s_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-002 (#1356): subset test against R_IPU6S_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask -- LEAF. Labels prefixed ipu6s_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne ipu6s_rv_no;
        mov rax, 1;
        ret;
      ipu6s_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ipu6s_format_valid : (u64) -> u64 !{} @{} =
    fn (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-002 (#1356): 1 iff fmt in {NV12, YUYV, RAW10}. Enumerated -- widening is refused, not masked. Labels prefixed ipu6s_fv_.",
      block: {
        cmp rdi, 1;
        je  ipu6s_fv_yes;
        cmp rdi, 2;
        je  ipu6s_fv_yes;
        cmp rdi, 3;
        je  ipu6s_fv_yes;
        xor rax, rax;
        ret;
      ipu6s_fv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let ipu6s_dim_valid : (u64) -> u64 !{} @{} =
    fn (dim: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-002 (#1356): 1 iff dim in [1, IPU6S_DIM_MAX=8192]. Labels prefixed ipu6s_dv_.",
      block: {
        cmp rdi, 0;
        je  ipu6s_dv_no;
        mov r10, 8192;
        cmp rdi, r10;
        ja  ipu6s_dv_no;
        mov rax, 1;
        ret;
      ipu6s_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ipu6s_fps_valid : (u64) -> u64 !{} @{} =
    fn (fps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-002 (#1356): 1 iff fps in [1, IPU6S_FPS_MAX=120]. Labels prefixed ipu6s_pv_.",
      block: {
        cmp rdi, 0;
        je  ipu6s_pv_no;
        mov r10, 120;
        cmp rdi, r10;
        ja  ipu6s_pv_no;
        mov rax, 1;
        ret;
      ipu6s_pv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let ipu6s_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): counter bump. Labels prefixed ipu6s_nt_.",
      block: {
        cmp rdi, 4;
        jae ipu6s_nt_out;
        lea r10, [rip + _ipu6_stream_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ipu6s_nt_out:
        ret
      }
    }

  pub let ipu6s_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): counter read. Labels prefixed ipu6s_stt_.",
      block: {
        cmp rdi, 4;
        jae ipu6s_stt_zero;
        lea r10, [rip + _ipu6_stream_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ipu6s_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let ipu6s_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed ipu6s_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae ipu6s_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne ipu6s_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  ipu6s_cp_no;

        mov rax, 1;
        ret;
      ipu6s_cp_no:
        xor rax, rax;
        ret
      }
    }

  // Read inherited endpoint id from parent target_ptr[15:0].
  pub let ipu6s_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): inherited endpoint id from parent's target_ptr[15:0] -- the encoding endpoint_tail_pack writes. THE ONLY SOURCE of a stream's delivery-endpoint identity. Zero on bad slot / wrong kind. Labels prefixed ipu6s_pei_.",
      block: {
        cmp rdi, 256;
        jae ipu6s_pei_zero;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne ipu6s_pei_zero;

        mov rax, [rax + 16];
        mov r11, 0xFFFF;
        and rax, r11;
        ret;

      ipu6s_pei_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Camera gate: live KIND_CSI_CAMERA (0x17E) at camera_slot.
  // ==========================================================================

  pub let ipu6s_check_camera : (u64) -> u64 !{mem} @{cap} =
    fn (camera_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M3-002 (#1356): camera_slot must name a live KIND_CSI_CAMERA (0x17E). Labels prefixed ipu6s_cc_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae ipu6s_cc_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x17E;
        cmp r10, r11;
        jne ipu6s_cc_no;

        mov rax, 1;
        ret;
      ipu6s_cc_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let ipu6s_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-002 (#1356): (parent_slot << 8). Labels prefixed ipu6s_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae ipu6s_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      ipu6s_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body1: endpoint_slot[31:0] | camera_slot[63:32].
  pub let ipu6s_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (camera_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-002 (#1356): pack body1: endpoint_slot[31:0] | camera_slot[63:32]. endpoint_slot here carries the INHERITED endpoint id -- a u32 wide enough to hold the u16 kind_endpoint value plus room for future widening. Labels prefixed ipu6s_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  ipu6s_b1_bad;
        cmp rsi, r10;
        ja  ipu6s_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      ipu6s_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: format[15:0] | width[31:16] | height[47:32] | fps[55:48] | reserved[63:56].
  pub let ipu6s_body2_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (fmt: u64) (width: u64) (height: u64) (fps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-002 (#1356): pack body2: format[15:0] | width[31:16] | height[47:32] | fps[55:48]. Reserved bits [63:56] MUST be zero on read. Labels prefixed ipu6s_b2_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  ipu6s_b2_bad;
        cmp rsi, r10;
        ja  ipu6s_b2_bad;
        cmp rdx, r10;
        ja  ipu6s_b2_bad;
        mov r10, 0xFF;
        cmp rcx, r10;
        ja  ipu6s_b2_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      ipu6s_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _ipu6_stream_table.
  // ==========================================================================

  pub let ipu6s_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (stream_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): claim one IPU6 STREAM row. THE ONE WRITER of _ipu6_stream_table. Gates: hdr in_use pre-set -> BAD_ARG; stream_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed ipu6s_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne ipu6s_ta_bad;

        cmp r13, 0;
        je  ipu6s_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  ipu6s_ta_bad;
        cmp r15, r10;
        je  ipu6s_ta_bad;

        xor rbx, rbx;
      ipu6s_ta_scan:
        cmp rbx, 8;
        jae ipu6s_ta_enospc;

        lea r10, [rip + _ipu6_stream_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ipu6s_ta_claim;

        add rbx, 1;
        jmp ipu6s_ta_scan;

      ipu6s_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp ipu6s_ta_out;

      ipu6s_ta_enospc:
        mov rax, 0xFFFFF1FF;
        jmp ipu6s_ta_out;
      ipu6s_ta_bad:
        mov rax, 0xFFFFF1FE;

      ipu6s_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ipu6s_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): 1 iff row_id < MAX and in_use. Labels prefixed ipu6s_tvr_.",
      block: {
        cmp rdi, 8;
        jae ipu6s_tvr_no;
        lea r10, [rip + _ipu6_stream_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ipu6s_tvr_no;
        mov rax, 1;
        ret;
      ipu6s_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let ipu6s_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): scrub one row. Labels prefixed ipu6s_tf_.",
      block: {
        cmp rdi, 8;
        jae ipu6s_tf_out;
        lea r10, [rip + _ipu6_stream_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      ipu6s_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let ipu6s_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): stream_key. Labels prefixed ipu6s_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call ipu6s_tail_valid;
        cmp rax, 0;
        je  ipu6s_rk_bad;
        lea r10, [rip + _ipu6_stream_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp ipu6s_rk_out;
      ipu6s_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ipu6s_rk_out:
        pop r12;
        ret
      }
    }

  pub let ipu6s_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): endpoint_slot (body1[31:0]). Labels prefixed ipu6s_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call ipu6s_tail_valid;
        cmp rax, 0;
        je  ipu6s_re_bad;
        lea r10, [rip + _ipu6_stream_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp ipu6s_re_out;
      ipu6s_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ipu6s_re_out:
        pop r12;
        ret
      }
    }

  pub let ipu6s_row_camera : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-002 (#1356): camera_slot (body1[63:32]). Labels prefixed ipu6s_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call ipu6s_tail_valid;
        cmp rax, 0;
        je  ipu6s_rc_bad;
        lea r10, [rip + _ipu6_stream_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp ipu6s_rc_out;
      ipu6s_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ipu6s_rc_out:
        pop r12;
        ret
      }
    }

