  // ==========================================================================
  // Row setters. Internal exports for the loader-integration code /
  // sig_verify.pdx (#1701's sibling call sites) to populate key_hash
  // once the key material at key_material_lba has been read and
  // hashed -- NOT wired into cap_handler_sig_key's op dispatch (mirrors
  // kind_volume.pdx's / kind_inode_handle.pdx's setter precedent).
  // tail_valid-gated; dead row is a silent no-op.
  // ==========================================================================

  pub let sig_key_row_hash_w0_set : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (new_w0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): stamp key_hash_w0 on a live row once the key material is hashed. tail_valid gate; dead row is a no-op. Labels prefixed sigk_rh0_s_.",
      block: {
        push r12;
        mov r12, rdi;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_rh0_s_out;
        lea r10, [rip + _sig_key_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 8], rsi;
        push rax;
        mov rdi, 4;                      // SIGK_ST_REFRESHES
        call sig_key_note;
        pop rax;
      sigk_rh0_s_out:
        pop r12;
        ret
      }
    }

