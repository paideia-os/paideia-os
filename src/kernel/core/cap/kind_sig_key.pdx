// src/kernel/core/cap/kind_sig_key.pdx -- R52.M5-001 (#1703)
//
// KIND_SIG_KEY = 0x1A3, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// The runtime authority for ONE ML-DSA-65 public-key handle used for
// signed-inode-tail verification (R52.M4's sig_verify.pdx, #1701) and
// for volume-mount key cross-checking (design/filesystem/volume-fs-
// substrate.md §6.4). At boot, the loader passes an ML-DSA-65 public
// key material as a KIND_SIG_KEY cap to the FS init module; §6.4:
// "Volume mount cross-checks superblock.sig_key_hash ==
// KIND_SIG_KEY.key_hash; a mismatch refuses the mount with
// VOL_MOUNT_KEY_MISMATCH." This file registers the ordinal + the basic
// mint/revoke/row-table substrate only (per design/filesystem/
// r52-implementation-plan.md's #1703 scope); the actual verify call
// site lands in sig_verify.pdx (#6.4's own module, already scoped to
// R52.M5 by the design doc) and the loader-integration code that
// stamps a row's key_hash fields lands wherever the loader handoff is
// wired -- both consumers reach this module's row-setter exports
// (SECTION 1) to do so.
//
// =============================================================================
// SECTION 0  WHY KIND_SIG_KEY DERIVES OVER KIND_MEMORY
// =============================================================================
//
// design/filesystem/volume-fs-substrate.md §6.1 names KIND_MEMORY (4)
// as KIND_SIG_KEY's base, same posture as KIND_VOLUME
// (kind_volume.pdx §0): a signing-key handle is not a refinement of
// some other derived authority, it is minted directly from the memory
// region the loader placed the key material in. The derivation gate is
// the KIND_PDXFS_FILE / KIND_VOLUME rule: parent.kind == KIND_MEMORY
// (4) AND rights carry RIGHT_MINT (0x200).
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words; design/filesystem/volume-fs-
// substrate.md §6.4's row is `{key_hash:[u8;32], key_material_lba:u64,
// key_type:u8}`, laid out here as):
//
//   [+0]   header: in_use[63:56] | key_type[7:0] | reserved[55:8]
//   [+8]   key_hash_w0     (u64)  -- key_hash bytes [0..8);  0 at mint
//   [+16]  key_hash_w1     (u64)  -- key_hash bytes [8..16); 0 at mint
//   [+24]  key_hash_w2     (u64)  -- key_hash bytes [16..24);0 at mint
//   [+32]  key_hash_w3     (u64)  -- key_hash bytes [24..32);0 at mint
//   [+40]  key_material_lba (u64) -- out-of-line key-material block
//   [+48]  reserved         (u64) -- zeroed at alloc
//   [+56]  reserved         (u64) -- zeroed at alloc
//
// key_type (1 = ML-DSA-65 per §6.4; "other post-quantum algorithms
// reserved for future") is small enough to pack into the header
// alongside in_use, matching KIND_INODE_HANDLE's header-packing
// discipline. key_material_lba is essential-at-mint identity (the
// loader knows exactly which block it placed the key in) so it is a
// direct tail_alloc arg. The four key_hash words are the BLAKE3
// fingerprint of the key material itself -- computed by the caller
// AFTER the key bytes are read from key_material_lba, which cannot
// happen before the row (and its LBA) exists -- so they default to 0
// at claim and are populated via the four key_hash_w*_set exports
// (§1) once the loader-integration code has hashed the key.
//
// Row-addressed capacity: 16 rows x 64 bytes = 1024 bytes, matching
// the KIND_VOLUME / KIND_PDXFS_FILE / KIND_PDXFS_TXN 16-row convention
// -- one signing key per mounted volume is the expected working set,
// with headroom for key rotation (a fresh KIND_SIG_KEY is minted
// rather than mutating a live one; see §2, no R_SIGK_WRITE).
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
//   R_SIGK_READ    (0x001) -- read the key material through the handle
//   R_SIGK_INVOKE  (0x008) -- QUERY ops (key_type/hash words/material_lba)
//   R_SIGK_REVOKE  (0x010) -- teardown the row (key rotation/unload)
//   R_SIGK_REFRESH (0x020) -- gates the row-setter exports (§1)
//   R_SIGK_OBSERVE (0x400) -- debug printer
//   R_SIGK_ALL     (0x439)
//
// No R_SIGK_WRITE, no R_SIGK_MINT: signing-key material is immutable
// once minted (rotation mints a fresh cap, per §1) and nothing derives
// a child kind over KIND_SIG_KEY per §6.1's table.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB00..0xFFFFEB07
// =============================================================================
//
// By 2026-08-23 the entire 0xFFFFEC00..0xFFFFECFF page is band-claimed
// end to end (KIND_ELEVATE_CHANNEL through the R51.M7/M8 MOUNTW +
// BDEVFS + KIND_BLKDEV bands -- audited against every kind_*.pdx /
// cap_handler_*.pdx / bdev_*.pdx / blkdev_*.pdx / drivers/ahci/*.pdx
// file at #1703's landing), and the R52-reserved 0xFFFFED00..0xFFFFED4F
// slice is fully spoken for by design/filesystem/r52-implementation-
// plan.md §4's per-milestone table (kind_volume.pdx §3 claims the
// whole M5 sub-slice 0xFFFFED20..0xFFFFED27 for the design-named
// volume/journal/mount codes). KIND_SIG_KEY's own cap-primitives
// taxonomy (mint/revoke/tail_alloc bookkeeping, not an on-disk
// substrate concern) therefore opens a fresh, page-level, wholly
// unclaimed band rather than crowding eight more codes into an
// already-full 8-slot M5 slice: 0xFFFFEB00..0xFFFFEB0F (16 codes, of
// which this file uses eight, 0xFFFFEB08..0xFFFFEB0F).  Disjoint from
// every existing band audited above.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
// Kind-tag constant 0x1A3 (KIND_SIG_KEY) does not sign-extend cleanly
// from a 32-bit immediate for `cmp reg, imm` forms (0x100..0xFFF band
// note, kind_inode_handle.pdx §4); every compare against it stages
// through r11 first. KIND_MEMORY (4) needs no staging. No mov_b /
// mov_w / mov_d anywhere in this file -- every sub-field is packed/
// unpacked in full 64-bit registers via shift + mask. No `test`
// instruction; bit checks use `and` + `cmp`. Labels prefixed `sigk_`.
//
// =============================================================================
// SECTION 5  ARITY -- THE cap_mint_inner COLLAPSE
// =============================================================================
//
// A naive `sigkey_cap_mint_inner(parent_slot, rights, key_type,
// key_hash_w0, key_hash_w1, key_hash_w2, key_hash_w3,
// key_material_lba)` is EIGHT args -- impossible. Design choice made
// up front, mirroring kind_volume.pdx §5: (1) key_type packs into a
// header word via sigkey_hdr_pack; (2) the four key_hash words are NOT
// mint-time args -- they default to 0 at claim and are populated via
// the four key_hash_w*_set row setters (§1) once the caller has hashed
// the key material. That reduces cap_mint_inner to (parent_slot,
// rights, hdr, key_material_lba) = four args.

module KindSigKey = structure {

  pub let KIND_SIG_KEY      : u64 = 0x1A3
  pub let KIND_SIG_KEY_BASE : u64 = 4       // = KIND_MEMORY (LAM-hint slot)

  pub let R_SIGK_READ    : u64 = 0x001
  pub let R_SIGK_INVOKE  : u64 = 0x008
  pub let R_SIGK_REVOKE  : u64 = 0x010
  pub let R_SIGK_REFRESH : u64 = 0x020
  pub let R_SIGK_OBSERVE : u64 = 0x400
  pub let R_SIGK_ALL     : u64 = 0x439

  // Ops. Every op ARITY ONE -- op_arg high bits refused (matches
  // KIND_VOLUME / KIND_INODE_HANDLE discipline).
  pub let SIGK_OP_QUERY_KEY_TYPE      : u64 = 0
  pub let SIGK_OP_QUERY_HASH_W0       : u64 = 1
  pub let SIGK_OP_QUERY_HASH_W1       : u64 = 2
  pub let SIGK_OP_QUERY_HASH_W2       : u64 = 3
  pub let SIGK_OP_QUERY_HASH_W3       : u64 = 4
  pub let SIGK_OP_QUERY_MATERIAL_LBA  : u64 = 5
  pub let SIGK_OP_DEBUG_PRINT         : u64 = 6
  pub let SIGK_OP_MAX                 : u64 = 6

  // Failure taxonomy. 0xFFFFEB00..0xFFFFEB0F band; this file uses
  // 0xFFFFEB08..0xFFFFEB0F. See §3 above.
  pub let SIGK_OK              : u64 = 0
  pub let SIGK_MINT_BAD_PARENT : u64 = 0xFFFFEB0F
  pub let SIGK_MINT_BAD_RIGHTS : u64 = 0xFFFFEB0E
  pub let SIGK_MINT_BAD_TYPE   : u64 = 0xFFFFEB0D
  pub let SIGK_MINT_BAD_LBA    : u64 = 0xFFFFEB0C
  pub let SIGK_TAIL_BAD_ARG    : u64 = 0xFFFFEB0B
  pub let SIGK_TAIL_ENOSPC     : u64 = 0xFFFFEB0A
  pub let SIGK_BAD_SLOT        : u64 = 0xFFFFEB09
  pub let SIGK_REVOKE_ALREADY  : u64 = 0xFFFFEB08

  pub let SIGK_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let SIGK_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let SIGK_MAX       : u64 = 16
  pub let SIGK_ROW_BYTES : u64 = 64
  // 16 rows * 64 bytes = 1024 bytes = 128 u64.
  pub let mut _sig_key_table : [u64; 128] = uninit @align(64)
  pub let mut _sig_key_stats : [u64; 8]   = uninit @align(64)

  pub let SIGK_ST_MINTS     : u64 = 0
  pub let SIGK_ST_REVOKES   : u64 = 1
  pub let SIGK_ST_QUERIES   : u64 = 2
  pub let SIGK_ST_REFUSED   : u64 = 3
  pub let SIGK_ST_REFRESHES : u64 = 4
  pub let SIGK_ST_MAX       : u64 = 8

  pub let sig_key_dbg_msg : [u8; 13] = "SIG KEY ROW\0\0"

  // ==========================================================================
  // sig_key_table_reset() -> ()
  //
  // Clear every row and every counter. Boot and teardown only. Two
  // separate loops mirror kind_volume's / kind_inode_handle's shape.
  // ==========================================================================
  pub let sig_key_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): clear every row and every counter. Boot and teardown only. Labels prefixed sigk_rs_.",
      block: {
        lea r10, [rip + _sig_key_table];
        xor rax, rax;
        xor rcx, rcx;
      sigk_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  sigk_rs_rows;

        lea r10, [rip + _sig_key_stats];
        xor rcx, rcx;
      sigk_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sigk_rs_stats;
        ret
      }
    }

  pub let sig_key_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): bounded increment; out-of-range no-op. Labels prefixed sigk_nt_.",
      block: {
        cmp rdi, 8;
        jae sigk_nt_out;
        lea r10, [rip + _sig_key_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sigk_nt_out:
        ret
      }
    }

  pub let sig_key_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): bounded read; out-of-range returns 0. Labels prefixed sigk_st_.",
      block: {
        cmp rdi, 8;
        jae sigk_st_zero;
        lea r10, [rip + _sig_key_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sigk_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let sig_key_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M5-001 (#1703): subset test against R_SIGK_ALL = 0x439. Labels prefixed sigk_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x439;
        and rax, r10;
        cmp rax, rdi;
        jne sigk_rv_no;
        mov rax, 1;
        ret;
      sigk_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sig_key_check_parent_memory(parent_slot) -> 1 | 0
  //
  // Derivation gate. parent.kind == KIND_MEMORY (4) AND rights carry
  // RIGHT_MINT (0x200). Mirrors volume_check_parent_memory /
  // pdxfs_file_check_parent_memory exactly.
  // ==========================================================================
  pub let sig_key_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24; require kind ([+0]) == KIND_MEMORY (4) AND (rights & RIGHT_MINT 0x200) != 0. Mirrors kind_volume.pdx's volume_check_parent_memory one-for-one. Pure read. Labels prefixed sigk_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae sigk_cpm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne sigk_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  sigk_cpm_no;

        mov rax, 1;
        ret;

      sigk_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sig_key_hdr_pack(key_type) -> hdr | SIGK_DECODE_BAD
  //
  // key_type packs into bits [7:0]. Per §6.4, 0 is never valid (1 =
  // ML-DSA-65; other values reserved for future algorithms, but the
  // all-zero sentinel is refused here the same way inode 0 / LBA 0 are
  // refused elsewhere in R52). Bits [63:56] MUST leave this function
  // zero -- that byte belongs to the allocator's in_use flag.
  // ==========================================================================
  pub let sig_key_hdr_pack : (u64) -> u64 !{} @{} =
    fn (key_type: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M5-001 (#1703): canonical header encoder. key_type fits [7:0] and must be non-zero (0 is the invalid sentinel; 1 = ML-DSA-65 per design/filesystem/volume-fs-substrate.md §6.4, other values reserved for future PQ algorithms). Bits [63:56] left zero for the allocator's in_use flag. Labels prefixed sigk_hp_.",
      block: {
        cmp rdi, 0;
        je  sigk_hp_bad;

        mov r10, 0xFF;
        cmp rdi, r10;
        ja  sigk_hp_bad;

        mov rax, rdi;                    // key_type in [7:0]
        ret;

      sigk_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // sig_key_tail_alloc(hdr, key_material_lba) -> row_id | SIGK_TAIL_*
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A SIG_KEY ROW;
  // tools/build.sh confines relocations against _sig_key_table to this
  // object. Gates: hdr in_use pre-set -> SIGK_TAIL_BAD_ARG; key_type
  // byte zero -> SIGK_TAIL_BAD_ARG; key_material_lba == 0 -> SIGK_
  // MINT_BAD_LBA (LBA 0 is the superblock, never valid key material,
  // matching inode_handle_tail_alloc's LBA-0 refusal). The four key-
  // hash words default to 0; caller populates them via the setters
  // (§1) once the key material is hashed. Low-first scan over 16 rows
  // of 64 bytes (power-of-2 stride: row_id << 6).
  // ==========================================================================
  pub let sig_key_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (key_material_lba: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): claim one sig-key row. THE ONLY WRITER of _sig_key_table; tools/build.sh confines it via ec_confine_one. Gates: hdr in_use pre-set -> SIGK_TAIL_BAD_ARG; key_type byte zero -> SIGK_TAIL_BAD_ARG; key_material_lba == 0 -> SIGK_MINT_BAD_LBA. Low-first scan over 16 rows of 64 bytes. Labels prefixed sigk_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // key_material_lba

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne sigk_ta_bad;

        // key_type byte zero?
        mov rax, r12;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  sigk_ta_bad;

        // key_material_lba non-zero.
        cmp r13, 0;
        je  sigk_ta_bad_lba;

        xor rbx, rbx;                    // row_id
      sigk_ta_scan:
        cmp rbx, 16;                     // SIGK_MAX
        jae sigk_ta_enospc;

        lea r10, [rip + _sig_key_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sigk_ta_claim;

        add rbx, 1;
        jmp sigk_ta_scan;

      sigk_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header + in_use
        xor rax, rax;
        mov [r10 + 8],  rax;             // key_hash_w0 = 0
        mov [r10 + 16], rax;             // key_hash_w1 = 0
        mov [r10 + 24], rax;             // key_hash_w2 = 0
        mov [r10 + 32], rax;             // key_hash_w3 = 0
        mov [r10 + 40], r13;             // key_material_lba
        xor rax, rax;
        mov [r10 + 48], rax;             // reserved = 0
        mov [r10 + 56], rax;             // reserved = 0
        mov rax, rbx;
        jmp sigk_ta_out;

      sigk_ta_enospc:
        mov rax, 0xFFFFEB0A;             // SIGK_TAIL_ENOSPC
        jmp sigk_ta_out;
      sigk_ta_bad_lba:
        mov rax, 0xFFFFEB0C;             // SIGK_MINT_BAD_LBA
        jmp sigk_ta_out;
      sigk_ta_bad:
        mov rax, 0xFFFFEB0B;             // SIGK_TAIL_BAD_ARG

      sigk_ta_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sig_key_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): 1 iff row_id < SIGK_MAX and in_use byte set. Labels prefixed sigk_tv_.",
      block: {
        cmp rdi, 16;
        jae sigk_tv_no;
        lea r10, [rip + _sig_key_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sigk_tv_no;
        mov rax, 1;
        ret;
      sigk_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let sig_key_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): scrub row (all eight words). Labels prefixed sigk_tf_.",
      block: {
        cmp rdi, 16;
        jae sigk_tf_out;
        lea r10, [rip + _sig_key_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      sigk_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors. Each returns SIGK_DECODE_BAD when the row is not
  // live.
  // -------------------------------------------------------------------

  pub let sig_key_row_key_type : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): key_type (header bits [7:0]), or SIGK_DECODE_BAD. Labels prefixed sigk_rkt_.",
      block: {
        push r12;
        mov r12, rdi;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_rkt_bad;
        lea r10, [rip + _sig_key_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFF;
        and rax, r10;
        jmp sigk_rkt_out;
      sigk_rkt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sigk_rkt_out:
        pop r12;
        ret
      }
    }

  pub let sig_key_row_hash_w0 : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): key_hash_w0, or SIGK_DECODE_BAD. Labels prefixed sigk_rh0_.",
      block: {
        push r12;
        mov r12, rdi;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_rh0_bad;
        lea r10, [rip + _sig_key_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp sigk_rh0_out;
      sigk_rh0_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sigk_rh0_out:
        pop r12;
        ret
      }
    }

  pub let sig_key_row_hash_w1 : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): key_hash_w1, or SIGK_DECODE_BAD. Labels prefixed sigk_rh1_.",
      block: {
        push r12;
        mov r12, rdi;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_rh1_bad;
        lea r10, [rip + _sig_key_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp sigk_rh1_out;
      sigk_rh1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sigk_rh1_out:
        pop r12;
        ret
      }
    }

  pub let sig_key_row_hash_w2 : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): key_hash_w2, or SIGK_DECODE_BAD. Labels prefixed sigk_rh2_.",
      block: {
        push r12;
        mov r12, rdi;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_rh2_bad;
        lea r10, [rip + _sig_key_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp sigk_rh2_out;
      sigk_rh2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sigk_rh2_out:
        pop r12;
        ret
      }
    }

  pub let sig_key_row_hash_w3 : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): key_hash_w3, or SIGK_DECODE_BAD. Labels prefixed sigk_rh3_.",
      block: {
        push r12;
        mov r12, rdi;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_rh3_bad;
        lea r10, [rip + _sig_key_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp sigk_rh3_out;
      sigk_rh3_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sigk_rh3_out:
        pop r12;
        ret
      }
    }

