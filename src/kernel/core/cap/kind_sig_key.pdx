  // Slot -> row_id, gated on the descriptor being a live KIND_SIG_KEY.
  // Kind constant 0x1A3 staged in r11 (§4).
  pub let sig_key_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): slot -> row_id gated on KIND_SIG_KEY. THE ONLY ROUTE IN THE KERNEL FROM A CAP SLOT TO A SIG-KEY ROW. Labels prefixed sigk_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae sigk_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1A3;                  // KIND_SIG_KEY
        cmp r10, r11;
        jne sigk_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_ros_none;

        mov rax, r12;
        jmp sigk_ros_out;

      sigk_ros_none:
        mov rax, 0xFF;                   // SIGK_ROW_NONE
      sigk_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sig_key_cap_revoke(row_id) -> SIGK_OK | SIGK_BAD_SLOT | SIGK_REVOKE_ALREADY
  // ==========================================================================
  pub let sig_key_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): scrub one row via sig_key_tail_free and bump REVOKES. Refuses out-of-range with BAD_SLOT; refuses already-dead with REVOKE_ALREADY so the caller can distinguish 'never existed' from 'already gone' (mirrors kind_inode_handle.pdx's inode_handle_cap_revoke). Two callee-save pushes leave rsp%16 == 0. Labels prefixed sigk_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae sigk_cr_bad_slot;

        mov rdi, r12;
        call sig_key_tail_valid;
        cmp rax, 0;
        je  sigk_cr_already;

        mov rdi, r12;
        call sig_key_tail_free;
        mov rdi, 1;                      // SIGK_ST_REVOKES
        call sig_key_note;
        xor rax, rax;                    // SIGK_OK
        jmp sigk_cr_out;

      sigk_cr_bad_slot:
        mov rax, 0xFFFFEB09;             // SIGK_BAD_SLOT
        jmp sigk_cr_out;
      sigk_cr_already:
        mov rax, 0xFFFFEB08;             // SIGK_REVOKE_ALREADY

      sigk_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sig_key_cap_mint_inner(parent_slot, rights, hdr, key_material_lba)
  //   -> row_id | SIGK_MINT_*
  //
  // §5: hdr is PRE-PACKED by the caller via sig_key_hdr_pack; the four
  // key_hash words are NOT mint-time args (deferred to setters, §1).
  // Gate sequence: (1) parent (KIND_MEMORY + RIGHT_MINT); (2) rights
  // subset; (3) tail_alloc (hdr, key_material_lba). Five callee-save
  // pushes + sub rsp, 8 = 48 bytes, mirroring kind_volume.pdx's
  // volume_cap_mint_inner / kind_inode_handle.pdx's inode_handle_cap_
  // mint_inner shape. Refusal paths bump SIGK_ST_REFUSED.
  // ==========================================================================
  pub let sig_key_cap_mint_inner : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (hdr: u64) (key_material_lba: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): the KIND_SIG_KEY mint walker. Gate sequence: parent (KIND_MEMORY + RIGHT_MINT), rights subset, tail_alloc (hdr, key_material_lba). Five callee-save pushes + sub rsp, 8 = 48 bytes: post-prologue rsp%16 == 0 for every nested call, mirroring kind_volume.pdx's volume_cap_mint_inner. Refusal paths bump SIGK_ST_REFUSED. Labels prefixed sigk_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // hdr
        mov r14, rcx;                    // key_material_lba

        // (1) Parent gate.
        mov rdi, r12;
        call sig_key_check_parent_memory;
        cmp rax, 0;
        je  sigk_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call sig_key_rights_valid;
        cmp rax, 0;
        je  sigk_mi_bad_rights;

        // (3) tail_alloc (hdr, key_material_lba).
        mov rdi, rbx;
        mov rsi, r14;
        call sig_key_tail_alloc;
        mov r10, 16;                     // SIGK_MAX
        cmp rax, r10;
        jae sigk_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // SIGK_ST_MINTS
        call sig_key_note;
        pop rax;
        jmp sigk_mi_out;

      sigk_mi_alloc_fail:
        jmp sigk_mi_refused;
      sigk_mi_bad_parent:
        mov rax, 0xFFFFEB0F;             // SIGK_MINT_BAD_PARENT
        jmp sigk_mi_refused;
      sigk_mi_bad_rights:
        mov rax, 0xFFFFEB0E;             // SIGK_MINT_BAD_RIGHTS

      sigk_mi_refused:
        push rax;
        mov rdi, 3;                      // SIGK_ST_REFUSED
        call sig_key_note;
        pop rax;

      sigk_mi_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_sig_key(rights, target_ptr, op_arg) -> ...
  //
  // Wired into cap_invoke_dispatch on `cmp rcx, 0x1A3; je call_kind_sig_key`.
  // ==========================================================================
  pub let cap_handler_sig_key : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): KIND_SIG_KEY dispatch. RIGHTS TESTED PER OP -- QUERY_* need R_SIGK_INVOKE; DEBUG_PRINT needs R_SIGK_OBSERVE. op_arg[63:8] MUST be zero -- a smuggled second value on an op reaching a sig-key field is refused rather than masked. Labels prefixed sigk_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id in low 16
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne sigk_hn_res;

        cmp rbp, 6;                      // SIGK_OP_MAX
        ja  sigk_hn_unsup;

        cmp rbp, 6;                      // DEBUG_PRINT?
        je  sigk_hn_dbg;

        // Query ops need R_SIGK_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  sigk_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  sigk_hn_key_type;
        cmp rbp, 1;
        je  sigk_hn_hash_w0;
        cmp rbp, 2;
        je  sigk_hn_hash_w1;
        cmp rbp, 3;
        je  sigk_hn_hash_w2;
        cmp rbp, 4;
        je  sigk_hn_hash_w3;
        call sig_key_row_material_lba;   // op == 5
        jmp sigk_hn_count;

      sigk_hn_key_type:
        call sig_key_row_key_type;
        jmp sigk_hn_count;
      sigk_hn_hash_w0:
        call sig_key_row_hash_w0;
        jmp sigk_hn_count;
      sigk_hn_hash_w1:
        call sig_key_row_hash_w1;
        jmp sigk_hn_count;
      sigk_hn_hash_w2:
        call sig_key_row_hash_w2;
        jmp sigk_hn_count;
      sigk_hn_hash_w3:
        call sig_key_row_hash_w3;
        jmp sigk_hn_count;

      sigk_hn_count:
        push rax;
        mov rdi, 2;                      // SIGK_ST_QUERIES
        call sig_key_note;
        pop rax;
        jmp sigk_hn_out;

      sigk_hn_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_SIGK_OBSERVE
        cmp r10, 0;
        je  sigk_hn_denied;
        xor rax, rax;
        jmp sigk_hn_out;

      sigk_hn_res:
        mov rax, 0xFFFFEB0B;             // SIGK_TAIL_BAD_ARG
        jmp sigk_hn_out;
      sigk_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp sigk_hn_out;
      sigk_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      sigk_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
