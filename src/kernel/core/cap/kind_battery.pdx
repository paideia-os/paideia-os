  pub let battery_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): last reported state ordinal (state word bits [7:0]) of a live row, or BATTERY_DECODE_BAD. Labels prefixed batt_rs2_.",
      block: {
