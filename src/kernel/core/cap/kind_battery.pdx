  pub let battery_row_reports : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): lifetime report count of a live row (state word bits [63:32]), or BATTERY_DECODE_BAD. Labels prefixed batt_rr_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_rr_bad;
