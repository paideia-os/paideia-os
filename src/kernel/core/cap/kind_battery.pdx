// src/kernel/core/cap/kind_battery.pdx — R31.M3-001 (#1099)
//
// KIND_BATTERY = 0x158, derived over KIND_DEVICE (10).
//
// The authority to hold one battery's static identity (index, design
// capacity, chemistry) and to be told what that battery's most recently
// reported state was.
//
// =============================================================================
// §0  UNITS: PERCENT 0..100, CAPACITY mWh, VOLTAGE mV — NO CONVERSION ON THE
//     CONTROL PATH
// =============================================================================
//
// ACPI 6.5 §10.2 reports battery capacity in [mWh] or [mAh], voltage in
// [mV] and current in [mA]. This kind is the mWh flavour: it stores a
// DESIGN CAPACITY in mWh and every REPORT it accepts is a percentage in
// 0..100 plus a voltage in mV plus a state ordinal. Nothing in this
// module is in fractions, watts, joules or amperes.
//
// The two silent ways to get that wrong:
//
//   * READ a fractional 0..1 percentage as 0..100 and every battery
//     reports as 0 or 1 percent full. The critical-state predicate a
//     future consumer will write would then fire on every boot.
//   * READ a full-scale integer as a fraction and every battery reports
//     as thousands of percent. A "> threshold" comparison then holds
//     forever, which is the same class of never-fires bug the thermal
//     module §0 warns about.
//
// The defence is that THE CONTROL PATH NEVER CONVERTS. `_report_percent`,
// the plausibility gate, the state derivation and the row's stored value
// are ALL 0..100. Any conversion — to a bar, to a display fraction — is
// display-only and confined by `tools/build.sh` to the row printer.
//
// The witness asserts a known value end to end: report 85% at 12042 mV
// with state DISCHARGING, and every read-back returns exactly those.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS INSTALLED
// =============================================================================
//
// Same discipline as `kind_thermal_zone.pdx` §2. `index`, `design_cap_mwh`
// and `chemistry` are ROW IDENTITY — they name the physical part and its
// unchanging factory data — and are refused to a mint that supplies
// implausible values. The dynamic fields (percent, voltage, state,
// report count) start at UNKNOWN and are updated by
// `battery_report_install`, which is REACHABLE ONLY THROUGH THE ROUTED
// ASSESSMENT: capability in, deci-percent + mV + state in, no other
// parameter.
//
// WHAT `_HOT`/`_CRT` IS TO A THERMAL ZONE, `design_cap_mwh` IS TO A
// BATTERY. It is set once by the mint and there is no primitive anywhere
// that changes it. A design capacity that could be raised by a caller
// would let a nearly-flat pack appear as one that had barely been used;
// a design capacity that could be lowered would let a healthy pack
// appear as one that had already lost most of its charge. Neither is
// reachable through this kind at all.
//
// =============================================================================
// §2  DERIVATION OVER KIND_DEVICE — THE THIRD TIME THE KIND HALF PROVES
//     NOTHING
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`. As
// with KIND_THERMAL_ZONE, that half discriminates NOTHING on its own:
// every PCI function in the machine is a KIND_DEVICE, and "this device
// is a battery" is a firmware-namespace fact this ring may not read
// (design/acpi/no-aml-in-kernel.md). The kernel enforces exactly what it
// can:
//
//   * The inherited device key must be NON-ZERO
//     (`BATTERY_MINT_NO_DEVICE`).
//   * NO OTHER LIVE ROW MAY HOLD THAT KEY (`BATTERY_MINT_BATT_IN_USE`).
//     One battery, one capability — because two capabilities for one
//     pack means two policy servers with two independent charge counters
//     making two independent shutdown decisions, and the one that reads
//     last decides.
//   * The static identity is plausible (index < BATTERY_INDEX_MAX,
//     design_cap_mwh in (0, BATTERY_DESIGN_MWH_MAX], chemistry a member
//     of the small enumeration in §5).
//
// The discrimination this gate does not perform is performed by the
// ring-3 supervisor that walked the namespace, and the capability is the
// record of ITS decision — the same honest division kind_thermal_zone §5
// writes down. The identity is INHERITED, never argued, via
// `battery_parent_key`.
//
// =============================================================================
// §3  A GARBAGE REPORT IS DANGEROUS IN BOTH DIRECTIONS
// =============================================================================
//
// A battery reading comes through the embedded controller (KIND_EC_QUERY
// +ACPI supervisor), and #1580 is still open: EC transactions are
// UNARBITRATED against SMM, so a read that races firmware can return a
// byte that is not a percentage.
//
//   * A percent above 100 that is silently clamped hides a firmware bug
//     from the operator and blesses the garbage; the fans then throttle
//     on the strength of a claim the sensor never made.
//   * A percent below 0 (i.e., interpreted as a large u64) that is
//     silently masked wraps to a plausible in-range value and the
//     shutdown that should have fired never does.
//
// So `battery_percent_valid` refuses anything outside [0, 100]
// INCLUSIVE with `BATTERY_IMPLAUSIBLE_PCT`, `battery_voltage_valid`
// refuses zero and anything above BATTERY_VOLTAGE_MV_MAX (25000 mV, a
// wide bound that covers even a two-cell-in-series pack), and the
// state ordinal must be a member of the enumeration in §5.
//
// UNLIKE THERMAL_ZONE THERE IS NO TWO-READING CONFIRMATION. A thermal
// crossing latches an authority to power the machine off; a battery
// report only updates the row's cached view of a fact the platform will
// see again in the next sampling interval. The confirmation cost
// (§thermal §3) is not paid for something the operator can wait one
// interval to re-observe.
//
// =============================================================================
// §4  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
// Stated plainly:
//
//   * NOTHING SHUTS THE MACHINE DOWN. `battery_report_install` returns
//     BATTERY_OK for a critical-state report and the row records it;
//     there is no platform power-off path in this kernel at all
//     (see `core/acpi/ec_event.pdx` §1 and `kind_thermal_zone.pdx` §6).
//   * NOTHING PULLS A LIVE READING. Reports are pushed by whichever
//     ring-3 component observed the pack; this kind holds a cache and
//     an identity, not a driver.
//   * NOTHING CONVERTS mWh TO mAh. Firmware chooses one flavour per
//     namespace; the supervisor picks the correct kind at mint time. A
//     conversion primitive here would encode the assumption that both
//     views are always available, and they are not.
//
// =============================================================================
// §5  ENUMERATIONS: STATE AND CHEMISTRY
// =============================================================================
//
// STATE is the pack's high-level condition, and both readers and future
// writers depend on the small closed set:
//
//   0 UNKNOWN      no report installed since row creation or last revoke
//   1 CHARGING     capacity is monotonically non-decreasing right now
//   2 DISCHARGING  capacity is monotonically non-increasing right now
//   3 FULL         at design capacity or nominally full
//   4 CRITICAL     below the platform's critical threshold
//
// CHEMISTRY is a small closed set the mint must accept and every reader
// may echo back verbatim:
//
//   0 UNKNOWN
//   1 LION          Lithium-ion
//   2 LIPO          Lithium-polymer
//   3 NIMH          Nickel metal hydride
//   4 NICD          Nickel cadmium (historical; a T14 G4 will never see one)
//   5 PB            Lead-acid (likewise; kept for completeness)
//
// Neither enumeration is stored as a string. String chemistry names are
// firmware-supplied via `_BIF`/`_BIX` and their parsing is ring 3's
// (see `design/acpi/no-aml-in-kernel.md`); this kind takes the ordinal
// after that parse.
//
// =============================================================================
// §6  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// This module contains no `in`/`out` and no firmware-bytecode
// identifier. `tools/lint-no-kernel-aml.sh` refuses any kernel
// identifier matching `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`, `\_SB_`
// or `\_SB.`. KIND_BATTERY, battery_* and _battery_table match none of
// the six; the `_BIF`/`_BIX` names above are in comments only.
//
// =============================================================================

module KindBattery = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_BATTERY         : u64 = 0x158  // derived-kind tag (344)
  pub let BATTERY_PARENT_KIND  : u64 = 10     // = KIND_DEVICE

  // ==========================================================================
  // §0's units and §5's bounds.
  // ==========================================================================

  pub let BATTERY_PCT_MAX          : u64 = 100      // inclusive
  pub let BATTERY_VOLTAGE_MV_MAX   : u64 = 25000    // 25 V, covers 6S packs
  pub let BATTERY_INDEX_MAX        : u64 = 16       // 0..15
  pub let BATTERY_DESIGN_MWH_MAX   : u64 = 1000000  // 1 MWh, well beyond any laptop pack

  // ==========================================================================
  // §5's state enumeration.
  // ==========================================================================

  pub let BATTERY_STATE_UNKNOWN     : u64 = 0
  pub let BATTERY_STATE_CHARGING    : u64 = 1
  pub let BATTERY_STATE_DISCHARGING : u64 = 2
  pub let BATTERY_STATE_FULL        : u64 = 3
  pub let BATTERY_STATE_CRITICAL    : u64 = 4
  pub let BATTERY_STATE_MAX         : u64 = 4

  // ==========================================================================
  // §5's chemistry enumeration.
  // ==========================================================================

  pub let BATTERY_CHEM_UNKNOWN : u64 = 0
  pub let BATTERY_CHEM_LION    : u64 = 1
  pub let BATTERY_CHEM_LIPO    : u64 = 2
  pub let BATTERY_CHEM_NIMH    : u64 = 3
  pub let BATTERY_CHEM_NICD    : u64 = 4
  pub let BATTERY_CHEM_PB      : u64 = 5
  pub let BATTERY_CHEM_MAX     : u64 = 5

  // ==========================================================================
  // Rights.
  //
  // R_BATTERY_READ and R_BATTERY_REPORT are the two halves that matter.
  // A monitoring UI needs READ forever; a supervisor that pushes reports
  // needs REPORT as well. Splitting them is what lets a untrusted panel
  // show percent-full without also being able to tell the kernel that
  // the pack is critical.
  //
  // RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf. Nothing
  // in the tree derives from a battery capability today (a cooling
  // device is not a subdivision of a battery), and a mint bit no gate
  // reads is authority that later acquires a meaning nobody audited —
  // the same argument kind_thermal_zone rights_valid gives.
  // ==========================================================================

  pub let R_BATTERY_READ    : u64 = 0x001
  pub let R_BATTERY_REPORT  : u64 = 0x002
  pub let R_BATTERY_INVOKE  : u64 = 0x008
  pub let R_BATTERY_REVOKE  : u64 = 0x010
  pub let R_BATTERY_OBSERVE : u64 = 0x400
  pub let R_BATTERY_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each requires.
  //
  //   0 QUERY_INDEX     INVOKE   the row's own battery index
  //   1 QUERY_DESIGN    INVOKE   design capacity in mWh
  //   2 QUERY_CHEM      INVOKE   chemistry ordinal
  //   3 QUERY_PERCENT   READ     last reported percent, 0xFF if none
  //   4 QUERY_STATE     READ     last reported state ordinal
  //   5 QUERY_VOLTAGE   READ     last reported voltage in mV
  //   6 QUERY_REPORTS   INVOKE   report count, lifetime
  //   7 QUERY_PARENT    INVOKE   the parent KIND_DEVICE slot
  //   8 DEBUG_PRINT     OBSERVE  canonical row dump
  //   9 REPORT          REPORT   push {percent, voltage_mv, state}
  //
  // REPORT carries three values in op_arg:
  //   op_arg[7:0]   = op = 9
  //   op_arg[15:8]  = percent, 0..100
  //   op_arg[23:16] = state ordinal, 0..4
  //   op_arg[47:24] = voltage_mv (24 bits, > BATTERY_VOLTAGE_MV_MAX)
  //   op_arg[63:48] = reserved, MUST be zero
  //
  // The reserved field is REFUSED with BATTERY_TAIL_BAD_ARG rather than
  // masked, for the reason kind_thermal_zone's ASSESS refuses op_arg's
  // upper half: sixteen free bits on an op that reaches the row's cached
  // state is where a second reading would be smuggled.
  //
  // QUERY_PERCENT is READ (not INVOKE) because the percent is the
  // reading's conclusion — the same category kind_thermal_zone gives its
  // QUERY_LATCHED. QUERY_INDEX and QUERY_DESIGN are configuration
  // introspection and gate on INVOKE.
  // ==========================================================================

  pub let BATTERY_OP_QUERY_INDEX   : u64 = 0
  pub let BATTERY_OP_QUERY_DESIGN  : u64 = 1
  pub let BATTERY_OP_QUERY_CHEM    : u64 = 2
  pub let BATTERY_OP_QUERY_PERCENT : u64 = 3
  pub let BATTERY_OP_QUERY_STATE   : u64 = 4
  pub let BATTERY_OP_QUERY_VOLTAGE : u64 = 5
  pub let BATTERY_OP_QUERY_REPORTS : u64 = 6
  pub let BATTERY_OP_QUERY_PARENT  : u64 = 7
  pub let BATTERY_OP_DEBUG_PRINT   : u64 = 8
  pub let BATTERY_OP_REPORT        : u64 = 9
  pub let BATTERY_OP_MAX           : u64 = 9

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE40..0xFFFFFE4F.
  //
  // Sixteen-wide, disjoint from KIND_THERMAL_ZONE (0xFFFFFE30..3F),
  // KIND_FW_SESSION (0xFFFFFE10..1F), owner (0xFFFFFE2B..2F) and the
  // thermal policy (0xFFFFFE20..2A). Disjointness is what lets a u64
  // threaded up through the mint, the row allocator and the dispatch
  // handler still name the gate that refused it.
  //
  // BAD_SLOT and WRONG_KIND are SHARED between the report installer, the
  // dispatch handler and the revoke, for the same reason kind_thermal_
  // zone's are: a slot out of range is the same operator problem
  // whichever entry point saw it.
  // ==========================================================================

  pub let BATTERY_OK                : u64 = 0
  pub let BATTERY_TAIL_ENOSPC       : u64 = 0xFFFFFE4F
  pub let BATTERY_TAIL_BAD_ARG      : u64 = 0xFFFFFE4E
  pub let BATTERY_MINT_BAD_PARENT   : u64 = 0xFFFFFE4D
  pub let BATTERY_MINT_BAD_RIGHTS   : u64 = 0xFFFFFE4C
  pub let BATTERY_MINT_BAD_INDEX    : u64 = 0xFFFFFE4B
  pub let BATTERY_MINT_BAD_DESIGN   : u64 = 0xFFFFFE4A
  pub let BATTERY_MINT_BAD_CHEM     : u64 = 0xFFFFFE49
  pub let BATTERY_MINT_NO_DEVICE    : u64 = 0xFFFFFE48
  pub let BATTERY_MINT_ENOSPC       : u64 = 0xFFFFFE47
  pub let BATTERY_MINT_BATT_IN_USE  : u64 = 0xFFFFFE46
  pub let BATTERY_BAD_SLOT          : u64 = 0xFFFFFE45
  pub let BATTERY_WRONG_KIND        : u64 = 0xFFFFFE44
  pub let BATTERY_REVOKE_ALREADY    : u64 = 0xFFFFFE43
  pub let BATTERY_IMPLAUSIBLE_PCT   : u64 = 0xFFFFFE42
  pub let BATTERY_IMPLAUSIBLE_MV    : u64 = 0xFFFFFE41
  pub let BATTERY_IMPLAUSIBLE_STATE : u64 = 0xFFFFFE40

  // The decoders' contract for a dead or out-of-range row.
  pub let BATTERY_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // `battery_find_by_key`'s "no row holds this key". 0xFF rather than 0,
  // because row 0 is a legitimate answer.
  pub let BATTERY_ROW_NONE : u64 = 0xFF

  // "No percent has been reported yet." 0xFF is out of the 0..100
  // domain, so a caller that echoes it cannot confuse it with a low
  // charge and a critical-state test written on the row cannot fire on a
  // never-reported pack.
  pub let BATTERY_PCT_NONE : u64 = 0xFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // EIGHT ROWS, sized by BATTERIES A MACHINE HAS. A T14 G4 declares one
  // primary and (with a dock) one secondary. Eight covers every laptop
  // this OS is likely to run on plus a two-battery workstation with a
  // UPS pack, and there is no per-process multiplier: a battery is a
  // physical part of one machine.
  //
  // Sixty-four bytes per row so the index is a `shl 6`; paideia-as has
  // no `mul`.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot  cap_table slot of the parent
  //                                     KIND_DEVICE at mint; audit and
  //                                     query only
  //           bits [55:16] reserved, must be zero
  //           bits [63:56] in_use       allocator flag
  //   [+8]  batt_key    INHERITED from the parent descriptor's
  //                     target_ptr. Non-zero. The uniqueness key.
  //   [+16] index       0..BATTERY_INDEX_MAX-1
  //   [+24] design_mwh  (0, BATTERY_DESIGN_MWH_MAX]
  //   [+32] chemistry   0..BATTERY_CHEM_MAX
  //   [+40] last_pct    0..100, or BATTERY_PCT_NONE
  //   [+48] last_mv     0 (unreported) or 1..BATTERY_VOLTAGE_MV_MAX
  //   [+56] state word
  //           bits [7:0]   last_state  ordinal, 0..BATTERY_STATE_MAX
  //           bits [31:8]  reserved, must be zero
  //           bits [63:32] reports     lifetime install count
  //
  // `tools/build.sh` asserts by `objdump -r` that no object other than
  // `core/cap/kind_battery.o` relocates against `_battery_table`. The
  // table is the only place in the kernel where a design capacity
  // lives, and a second writer could raise it with no capability
  // involved and no refusal recorded.
  // ==========================================================================

  pub let BATTERY_MAX       : u64 = 8
  pub let BATTERY_ROW_BYTES : u64 = 64

  pub let mut _battery_table : [u64; 64] = uninit @align(64)

  // Counters. Deliberately NOT in the row: they survive a revoke, so
  // "this pack keeps returning nonsense" is evidence about a sensor and
  // outlives any one capability over it.
  //
  //   +0  reports         reports that installed successfully
  //   +8  impl_pct        reports refused for percent out of [0, 100]
  //   +16 impl_mv         reports refused for voltage out of (0, MAX_MV]
  //   +24 impl_state      reports refused for a state not in the enum
  //   +32 critical        reports whose state was BATTERY_STATE_CRITICAL
  pub let mut _battery_stats : [u64; 8] = uninit @align(64)

  pub let BATTERY_ST_REPORTS    : u64 = 0
  pub let BATTERY_ST_IMPL_PCT   : u64 = 1
  pub let BATTERY_ST_IMPL_MV    : u64 = 2
  pub let BATTERY_ST_IMPL_STATE : u64 = 3
  pub let BATTERY_ST_CRITICAL   : u64 = 4
  pub let BATTERY_ST_MAX        : u64 = 8

  // Local klog keys and tags.
  pub let batt_dbg_msg : [u8; 12] = "BATTERY ROW\0"
  pub let batt_k_row   : [u8; 4]  = "row\0"
  pub let batt_k_idx   : [u8; 4]  = "idx\0"
  pub let batt_k_des   : [u8; 8]  = "des_mwh\0"
  pub let batt_k_chm   : [u8; 5]  = "chem\0"
  pub let batt_k_pct   : [u8; 4]  = "pct\0"
  pub let batt_k_mv    : [u8; 3]  = "mv\0"
  pub let batt_k_st    : [u8; 6]  = "state\0"

  // ==========================================================================
  // battery_table_reset() -> ()
  // ==========================================================================

  pub let battery_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring kind_thermal_zone.pdx thermal_zone_table_reset: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Bounded by immediate compares, 64 and 8 iterations. Leaf. Labels prefixed batt_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _battery_table];
        xor rax, rax;
        xor rcx, rcx;
      batt_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  batt_rs_rows;

        lea r10, [rip + _battery_stats];
        xor rcx, rcx;
      batt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  batt_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_percent_valid(pct) -> 1 | 0
  //
  // §0. Is this a percentage at all.
  // ==========================================================================

  pub let battery_percent_valid : (u64) -> u64 !{} @{} =
    fn (pct: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-001 (#1099): 1 iff pct in [0, BATTERY_PCT_MAX] (inclusive). Its job is to reject a byte that is not a percentage -- which is what an EC transaction unarbitrated against SMM can return while #1580 is open -- and NOT to second-guess the platform's calibration. The bounds are the ACPI stated limits; a value equal to either is admitted rather than refused, because a limit that is refused is a different limit. NOT SILENTLY CLAMPED: 101 -> refused, not 100. Clamping would bless the garbage and hide the sensor bug from every downstream reader. Pure leaf. Labels prefixed batt_pv_ per reserved-label discipline.",
      block: {
        mov r10, 100;                    // BATTERY_PCT_MAX
        cmp rdi, r10;
        ja  batt_pv_no;
        mov rax, 1;
        ret;
      batt_pv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_voltage_valid(mv) -> 1 | 0
  // ==========================================================================

  pub let battery_voltage_valid : (u64) -> u64 !{} @{} =
    fn (mv: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-001 (#1099): 1 iff mv in (0, BATTERY_VOLTAGE_MV_MAX]. Zero is refused because it is the row's 'never reported' sentinel and admitting it would erase every past voltage into a report indistinguishable from that state. The upper bound is wide (25 V, more than any 6S pack); its purpose is to reject a byte that is not a voltage and not to guess the platform. Pure leaf. Labels prefixed batt_vv_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  batt_vv_no;
        mov r10, 25000;                  // BATTERY_VOLTAGE_MV_MAX
        cmp rdi, r10;
        ja  batt_vv_no;
        mov rax, 1;
        ret;
      batt_vv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_state_valid(state) -> 1 | 0
  // ==========================================================================

  pub let battery_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-001 (#1099): 1 iff state in [0, BATTERY_STATE_MAX]. §5's small closed set. A state ordinal that survived this check is one the row can safely store and the dispatch handler can safely echo back to a caller that switches on it; a value outside the set could be silently masked to a plausible-looking neighbour, and a supervisor that saw CHARGING when the platform reported CRITICAL is the failure mode this kind exists in part to prevent. Pure leaf. Labels prefixed batt_sv_ per reserved-label discipline.",
      block: {
        mov r10, 4;                      // BATTERY_STATE_MAX
        cmp rdi, r10;
        ja  batt_sv_no;
        mov rax, 1;
        ret;
      batt_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_chem_valid(chem) -> 1 | 0
  // ==========================================================================

  pub let battery_chem_valid : (u64) -> u64 !{} @{} =
    fn (chem: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-001 (#1099): 1 iff chem in [0, BATTERY_CHEM_MAX]. §5's closed set. A chemistry outside the enumeration would not just render as a nonsense number in a debug dump; a future consumer that used chemistry to select a discharge curve would apply a table it never had. Refused rather than mapped to UNKNOWN because 'the firmware advertised something we do not understand' and 'the firmware advertised no chemistry' are different facts. Pure leaf. Labels prefixed batt_cv_ per reserved-label discipline.",
      block: {
        mov r10, 5;                      // BATTERY_CHEM_MAX
        cmp rdi, r10;
        ja  batt_cv_no;
        mov rax, 1;
        ret;
      batt_cv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_note(which) -> ()
  // battery_stat(which) -> count
  // ==========================================================================

  pub let battery_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): increment one counter; silent no-op on out-of-range. Same shape as thermal_zone_note: every caller inside this module passes a constant, and the bound is here so the array cannot be walked past if that ever stops being true. Leaf. Labels prefixed batt_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // BATTERY_ST_MAX
        jae batt_nt_out;
        lea r10, [rip + _battery_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      batt_nt_out:
        ret
      }
    } @no_frame

  pub let battery_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): bounds-checked read of one counter; out of range returns 0. This is what makes a lying sensor DIAGNOSABLE: a pack whose reports are refused by §3's bounds looks, from every other vantage point, exactly like a pack whose supervisor never sent a report. The impl_pct / impl_mv / impl_state counters are the only place the difference is visible. Leaf. Labels prefixed batt_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // BATTERY_ST_MAX
        jae batt_st_zero;
        lea r10, [rip + _battery_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      batt_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let battery_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-001 (#1099): 1 iff (rights & R_BATTERY_ALL) == rights. R_BATTERY_ALL = 0x41B (READ|REPORT|INVOKE|REVOKE|OBSERVE). A subset test, and RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf of the lattice and a MINT bit no gate reads is authority that later acquires a meaning nobody audited -- kind_thermal_zone rights_valid's argument, applied one kind over. The subset shape (not equality) lets a monitoring UI hold R_BATTERY_READ alone while the ring-3 supervisor holds READ|REPORT. Pure leaf. Labels prefixed batt_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;                  // R_BATTERY_ALL
        and rax, r10;
        cmp rax, rdi;
        jne batt_rv_no;
        mov rax, 1;
        ret;
      batt_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_check_parent_device(parent_slot) -> 1 | 0
  //
  // §2. The first half of the derivation gate. Discriminates NOTHING on
  // its own; the second half is in battery_cap_mint_inner.
  // ==========================================================================

  pub let battery_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): the first half of the KIND_BATTERY derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_DEVICE (10) AND (rights & RIGHT_MINT 0x200) != 0. THIS HALF DISCRIMINATES NOTHING and the mint does not treat it as though it did -- every PCI function is a KIND_DEVICE, which is #1075's lesson stated for the fourth time in this file family. 'This device is a battery' is a firmware-namespace fact this ring may not read, so the second half is what the kernel CAN enforce (non-zero inherited key, one battery per key, plausible index / design / chemistry). Pure read. Labels prefixed batt_cpd_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae batt_cpd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne batt_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  batt_cpd_no;

        mov rax, 1;
        ret;

      batt_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // battery_parent_key(parent_slot) -> batt_key | 0
  // ==========================================================================

  pub let battery_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): read the parent KIND_DEVICE descriptor's target_ptr, which for a device capability is its identity key. THE ONLY SOURCE OF A BATTERY CAPABILITY'S IDENTITY: the mint has no device argument, so the pack whose static identity a row holds is the part its parent capability names and no other. A mint that took the key as an argument would let a holder attach one pack's design capacity and chemistry to a different pack -- and every reading thereafter would be confidently wrong about which of the two batteries a machine's future shutdown decision was taken from. Same shape as thermal_zone_parent_key. Returns 0 for a bad slot or a non-KIND_DEVICE descriptor, and battery_cap_mint_inner refuses 0 with BATTERY_MINT_NO_DEVICE. Pure read. Labels prefixed batt_pk_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae batt_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne batt_pk_no;

        mov rax, [rax + 16];             // target_ptr = device identity key
        ret;

      batt_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // battery_hdr_pack(parent_slot) -> hdr | BATTERY_DECODE_BAD
  // ==========================================================================

  pub let battery_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-001 (#1099): canonical header-word encoder. Validates parent_slot < 256 then packs (parent_slot << 8), leaving bits [7:0], [55:16] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero, which is the whole reason the encoder exists rather than a shift at the call site: a header arriving with in_use pre-set hands back a row the free scan skips forever, and on this kind the leaked row holds a design capacity, so the next legitimate mint of that pack is refused BATT_IN_USE by a ghost that is still the only record of what the pack's design capacity was. Pure leaf. Labels prefixed batt_hp_ per reserved-label discipline.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae batt_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        ret;

      batt_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let battery_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M3-001 (#1099): parent_slot from header bits [15:8]. Named accessor rather than a shift at each call site, so a future header field cannot silently change what a caller reads. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    } @no_frame

  // ==========================================================================
  // battery_tail_alloc(hdr, batt_key, index, design_mwh, chem)
  //   -> row_id | BATTERY_TAIL_*
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A BATTERY DESIGN CAPACITY.
  // ==========================================================================

  pub let battery_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (batt_key: u64) (index: u64) (design_mwh: u64) (chem: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A DESIGN CAPACITY, which is why tools/build.sh confines relocations against _battery_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (the allocator's in_use flag, and a caller that pre-set it would be handed a row the free scan skips forever); hdr reserved bits [7:0] or [55:16] non-zero -> TAIL_BAD_ARG (a reserved bit merely ignored is one a later revision cannot use); batt_key == 0 -> TAIL_BAD_ARG (0 is battery_parent_key's refusal value); index >= BATTERY_INDEX_MAX -> TAIL_BAD_ARG; design_mwh == 0 OR > BATTERY_DESIGN_MWH_MAX -> TAIL_BAD_ARG; chem outside enum -> TAIL_BAD_ARG. THE INDEX / DESIGN / CHEM CHECKS ARE HERE AS WELL AS IN THE MINT, deliberately: the mint's versions produce the specific codes an installer needs (MINT_BAD_INDEX etc.), while these make it impossible for ANY future second caller of the allocator to create a row without them. A row with a zero design_mwh would be a battery a policy server could read and act on with nothing behind it. Low-first scan over 8 rows of 64 bytes, free iff byte 7 of [row+0] is zero. Claim writes all eight words, so a reused row cannot inherit the previous battery's cached percent, voltage, state or report count. Six pushes leave rsp%16 == 0 at both nested calls. Labels prefixed batt_ta_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // batt_key
        mov r14, rdx;                    // index
        mov r15, rcx;                    // design_mwh
        mov rbp, r8;                     // chem

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne batt_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne batt_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne batt_ta_bad;

        cmp r13, 0;
        je  batt_ta_bad;

        mov r10, 16;                     // BATTERY_INDEX_MAX
        cmp r14, r10;
        jae batt_ta_bad;

        cmp r15, 0;
        je  batt_ta_bad;
        mov r10, 1000000;                // BATTERY_DESIGN_MWH_MAX
        cmp r15, r10;
        ja  batt_ta_bad;

        mov r10, 5;                      // BATTERY_CHEM_MAX
        cmp rbp, r10;
        ja  batt_ta_bad;

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      batt_ta_scan:
        cmp rbx, 8;                      // BATTERY_MAX
        jae batt_ta_enospc;

        lea r10, [rip + _battery_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  batt_ta_claim;

        add rbx, 1;
        jmp batt_ta_scan;

      batt_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // batt_key
        mov [r10 + 16], r14;             // index
        mov [r10 + 24], r15;             // design_mwh
        mov [r10 + 32], rbp;             // chemistry
        mov rax, 0xFF;                   // BATTERY_PCT_NONE
        mov [r10 + 40], rax;             // last_pct
        xor rax, rax;
        mov [r10 + 48], rax;             // last_mv
        mov [r10 + 56], rax;             // state word
        mov rax, rbx;
        jmp batt_ta_out;

      batt_ta_enospc:
        mov rax, 0xFFFFFE4F;             // BATTERY_TAIL_ENOSPC
        jmp batt_ta_out;
      batt_ta_bad:
        mov rax, 0xFFFFFE4E;             // BATTERY_TAIL_BAD_ARG

      batt_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let battery_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): 1 iff row_id < BATTERY_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers BATTERY_DECODE_BAD rather than the zeroes it was scrubbed to. On this kind that matters for design capacity above all: a scrubbed row renders as a pack with a design of 0 mWh, i.e. as a pack that is by definition always full or always empty depending on which reader reads the field. Leaf. Labels prefixed batt_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // BATTERY_MAX
        jae batt_tv_no;
        lea r10, [rip + _battery_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  batt_tv_no;
        mov rax, 1;
        ret;
      batt_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let battery_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): scrub one row to zero, which clears in_use and returns it to the free scan. ALL EIGHT WORDS, including the cached percent, voltage, state and lifetime report count: a revoke is the point at which somebody has decided this battery's history no longer applies, and a row that kept its cached CRITICAL across a re-mint would report a pack as being past its limit on the strength of a report about a capability that no longer exists. Scrubbing the KEY is what makes the pack re-mintable, and therefore what makes a policy-server restart possible at all. No-op on an out-of-range row: the callers are the revoke path and the allocator's own error handling. Leaf. Labels prefixed batt_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // BATTERY_MAX
        jae batt_tf_out;
        lea r10, [rip + _battery_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      batt_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors. Every one returns BATTERY_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let battery_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): raw header word of a live row, or BATTERY_DECODE_BAD. Labels prefixed batt_rh_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_rh_bad;
        lea r10, [rip + _battery_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp batt_rh_out;
      batt_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_rh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let battery_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): inherited device identity key of a live row, or BATTERY_DECODE_BAD. Labels prefixed batt_rk_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_rk_bad;
        lea r10, [rip + _battery_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp batt_rk_out;
      batt_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_rk_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let battery_row_index : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): the battery index of a live row, or BATTERY_DECODE_BAD. Read-only; the only writer is battery_tail_alloc, so an index is set once in a row's life and 'the pack changed slot at runtime' is unrepresentable. Labels prefixed batt_ri_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_ri_bad;
        lea r10, [rip + _battery_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp batt_ri_out;
      batt_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_ri_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let battery_row_design : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): design capacity in mWh, or BATTERY_DECODE_BAD. Read-only and there is no counterpart writer: the only function that stores a design_mwh is battery_tail_alloc, so §1's 'design capacity cannot be raised or lowered' is a property of this module's surface rather than a rule callers are asked to respect. Labels prefixed batt_rd_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_rd_bad;
        lea r10, [rip + _battery_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp batt_rd_out;
      batt_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_rd_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let battery_row_chem : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): chemistry ordinal, or BATTERY_DECODE_BAD. Labels prefixed batt_rc_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_rc_bad;
        lea r10, [rip + _battery_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp batt_rc_out;
      batt_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_rc_out:
