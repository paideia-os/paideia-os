  pub let battery_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): parent KIND_DEVICE slot recorded at mint, or BATTERY_DECODE_BAD. Audit and query only -- nothing in the module resolves anything through it, because the pack's identity is the KEY and not the slot. Labels prefixed batt_rpa_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_row_hdr;
        mov r13, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  batt_rpa_bad;
        mov rdi, r13;
        call battery_hdr_parent;
        jmp batt_rpa_out;
      batt_rpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_rpa_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // battery_find_by_key(batt_key) -> row_id | BATTERY_ROW_NONE
  // ==========================================================================

  pub let battery_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (batt_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): the live row holding this device key, or BATTERY_ROW_NONE (0xFF). Linear scan over 8 rows. THE UNIQUENESS TEST §2's second gate needs: two live battery capabilities over one pack means two policy servers with two independent cached percent values driving one shutdown decision, neither able to see the other, and the one that reads last decides -- KIND_GPIO_LINE's 'a pin has one state' argument applied to a physical energy store. Refuses to match a batt_key of 0 at all, so a fabricated parent cannot collide with, or be found by, the sentinel battery_parent_key returns for a bad slot. Sentinel is 0xFF because row 0 is a legitimate answer. Leaf. Labels prefixed batt_fk_.",
      block: {
        cmp rdi, 0;
        je  batt_fk_none;
        xor rcx, rcx;
      batt_fk_scan:
        cmp rcx, 8;                      // BATTERY_MAX
        jae batt_fk_none;
        lea r10, [rip + _battery_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  batt_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  batt_fk_hit;
      batt_fk_next:
        add rcx, 1;
        jmp batt_fk_scan;
      batt_fk_hit:
        mov rax, rcx;
        ret;
      batt_fk_none:
        mov rax, 0xFF;                   // BATTERY_ROW_NONE
        ret
      }
    } @no_frame

  // ==========================================================================
  // battery_row_of_slot(slot) -> row_id | BATTERY_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let battery_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): slot -> row_id, gated on the descriptor being a live KIND_BATTERY. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A BATTERY ROW, and ARITY ONE so the row a caller reaches is the row its capability names. Every function below that touches a design capacity, a percent or a state goes through it. Returns BATTERY_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Pure read. Labels prefixed batt_ros_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae batt_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x158;                  // KIND_BATTERY
        cmp r10, r11;
        jne batt_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_ros_none;

        mov rax, r12;
        jmp batt_ros_out;

      batt_ros_none:
        mov rax, 0xFF;                   // BATTERY_ROW_NONE
      batt_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Slot-arity-one resolvers. ARITY ONE, pinned by tools/build.sh.
  // ==========================================================================

  pub let battery_design_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): design capacity in mWh, of the battery this capability names. ARITY ONE, PINNED BY tools/build.sh. A second parameter -- any second parameter -- is how a caller-supplied design capacity would reach the row: `design_of_slot(slot, default_mwh)` reads as a convenience and is a way to overstate a nearly-flat pack; `design_of_slot(slot, scale)` is a way to make a healthy pack look nearly-dead. Neither is expressible against a one-argument signature. Labels prefixed batt_dos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call battery_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  batt_dos_bad;
        mov rdi, r12;
        call battery_row_design;
        jmp batt_dos_out;
      batt_dos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_dos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let battery_percent_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): last reported percent, or BATTERY_DECODE_BAD. ARITY ONE for the same reason design_of_slot is: a percent argument would let a caller assert a charge level rather than read one. Labels prefixed batt_pos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call battery_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  batt_pos_bad;
        mov rdi, r12;
        call battery_row_percent;
        jmp batt_pos_out;
      batt_pos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_pos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let battery_state_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): last reported state ordinal, or BATTERY_DECODE_BAD. Labels prefixed batt_sos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call battery_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  batt_sos_bad;
        mov rdi, r12;
        call battery_row_state;
        jmp batt_sos_out;
      batt_sos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_sos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // battery_report_install(slot, percent, mv, state) -> BATTERY_OK | ...
  //
  // §3. THE ONE PUSH-STATE PRIMITIVE. THREE VALUES, PLAUSIBILITY EACH.
  // ==========================================================================

  pub let battery_report_install : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (percent: u64) (mv: u64) (state: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): install one report of the battery this capability names. FOUR ARGUMENTS AND NO MORE: a capability, and the three values §5's row layout has fields for. A fifth argument would be a caller-supplied design capacity or index reaching the row, and both are set-once at mint by §1. Gates, in order: (1) the slot must name a live KIND_BATTERY -> BATTERY_BAD_SLOT / BATTERY_WRONG_KIND via battery_row_of_slot, reusing the checks every other path uses rather than restating them. (2) percent > BATTERY_PCT_MAX -> IMPLAUSIBLE_PCT, counted, AND NOTHING IN THE ROW IS TOUCHED. NOT CLAMPED: 101 is refused and 100 is not silently substituted for it, because clamping would bless the garbage and hide the sensor bug. (3) mv OUTSIDE (0, BATTERY_VOLTAGE_MV_MAX] -> IMPLAUSIBLE_MV, counted, again UNSETTING NOTHING; zero is refused because it is the row's 'never reported' sentinel and admitting it would erase every past voltage into a report indistinguishable from that state. (4) state OUTSIDE the enum -> IMPLAUSIBLE_STATE, counted, again UNSETTING NOTHING; a state ordinal that survived this check is one the row can safely store and the dispatch handler can safely echo back. (5) install: write percent, mv, state; increment the state-word report count in place and BATTERY_ST_REPORTS overall; if state == CRITICAL, also increment BATTERY_ST_CRITICAL, because a CRITICAL count is the diagnostic a shutdown consumer will need when it exists. NOTHING SHUTS DOWN and nothing latches: this is §3's design decision, stated once in the file header (§4). Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed batt_ri2_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // percent
        mov r13, rdx;                    // mv
        mov r14, rcx;                    // state

        call battery_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;                   // BATTERY_ROW_NONE
        je  batt_ri2_bad_slot;

        // (2) percent.
        mov rdi, r12;
        call battery_percent_valid;
        cmp rax, 0;
        je  batt_ri2_impl_pct;

        // (3) voltage.
        mov rdi, r13;
        call battery_voltage_valid;
        cmp rax, 0;
        je  batt_ri2_impl_mv;

        // (4) state.
        mov rdi, r14;
        call battery_state_valid;
        cmp rax, 0;
        je  batt_ri2_impl_state;

        // (5) install.
        lea r10, [rip + _battery_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov [r10 + 40], r12;             // last_pct
        mov [r10 + 48], r13;             // last_mv

        // state word: clear low byte, OR the new state; increment reports.
        mov rax, [r10 + 56];
        mov r11, 0xFFFFFFFFFFFFFF00;
        and rax, r11;
        or  rax, r14;                    // last_state
        // reports in bits [63:32].
        mov r11, rax;
        shr r11, 32;
        add r11, 1;
        // Clear top 32 bits of rax and re-OR the new count.
        mov r15, 0xFFFFFFFF;             // low-32 mask
        and rax, r15;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 56], rax;

        // Global counters.
        mov rdi, 0;                      // BATTERY_ST_REPORTS
        call battery_note;

        cmp r14, 4;                      // BATTERY_STATE_CRITICAL
        jne batt_ri2_ok;
        mov rdi, 4;                      // BATTERY_ST_CRITICAL
        call battery_note;

      batt_ri2_ok:
        xor rax, rax;                    // BATTERY_OK
        jmp batt_ri2_out;

      batt_ri2_bad_slot:
        mov rax, 0xFFFFFE45;
        jmp batt_ri2_out;
      batt_ri2_impl_pct:
        mov rdi, 1;                      // BATTERY_ST_IMPL_PCT
        call battery_note;
        mov rax, 0xFFFFFE42;
        jmp batt_ri2_out;
      batt_ri2_impl_mv:
        mov rdi, 2;                      // BATTERY_ST_IMPL_MV
        call battery_note;
        mov rax, 0xFFFFFE41;
        jmp batt_ri2_out;
      batt_ri2_impl_state:
        mov rdi, 3;                      // BATTERY_ST_IMPL_STATE
        call battery_note;
        mov rax, 0xFFFFFE40;

      batt_ri2_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // battery_cap_mint_inner(slot, parent_slot, rights, index, design_mwh, chem)
  // ==========================================================================

  pub let battery_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (design_mwh: u64) (chem: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): mint a KIND_BATTERY over a KIND_DEVICE. Gates, in order: (1) slot < 256 -> BATTERY_BAD_SLOT. (2) battery_check_parent_device -> BATTERY_MINT_BAD_PARENT (the half that discriminates NOTHING, §2). (3) battery_rights_valid -> BATTERY_MINT_BAD_RIGHTS. (4) index < BATTERY_INDEX_MAX -> BATTERY_MINT_BAD_INDEX. A per-machine bound; 16 is plenty for any laptop or workstation this kernel will run on. (5) design_mwh in (0, BATTERY_DESIGN_MWH_MAX] -> BATTERY_MINT_BAD_DESIGN. Zero is refused: a battery with no design capacity is one every percent calculation divides by, and there is no shortcut past that here. (6) chem in enum -> BATTERY_MINT_BAD_CHEM. Refused rather than mapped to UNKNOWN, so 'the firmware advertised something the parser could not translate' is a diagnosable outcome rather than a silent one. (7) INHERIT the identity: battery_parent_key(parent_slot); 0 -> BATTERY_MINT_NO_DEVICE. The key is not an argument, for the reason ec_event_map_bind takes no address -- an argued key would attach one pack's identity to a different pack. (8) UNIQUENESS: battery_find_by_key must answer BATTERY_ROW_NONE -> BATTERY_MINT_BATT_IN_USE. Two capabilities over one pack means two hysteresis-less policy servers driving one shutdown decision. (9) hdr_pack(parent_slot) then tail_alloc -> BATTERY_MINT_ENOSPC on exhaustion, and the allocator re-validates every one of these fields independently so that no future second caller can create a row without them. (10) cap_mint_write(slot, KIND_BATTERY, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed batt_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // index
        mov r15, r8;                     // design_mwh
        mov rbp, r9;                     // chemistry

        mov r10, 256;
        cmp rbx, r10;
        jae batt_mi_bad_slot;

        mov rdi, r12;
        call battery_check_parent_device;
        cmp rax, 0;
        je  batt_mi_bad_parent;

        mov rdi, r13;
        call battery_rights_valid;
        cmp rax, 0;
        je  batt_mi_bad_rights;

        mov r10, 16;                     // BATTERY_INDEX_MAX
        cmp r14, r10;
        jae batt_mi_bad_index;

        cmp r15, 0;
        je  batt_mi_bad_design;
        mov r10, 1000000;                // BATTERY_DESIGN_MWH_MAX
        cmp r15, r10;
        ja  batt_mi_bad_design;

        mov rdi, rbp;
        call battery_chem_valid;
        cmp rax, 0;
        je  batt_mi_bad_chem;

        mov rdi, r12;
        call battery_parent_key;
        cmp rax, 0;
        je  batt_mi_no_device;

        // Stash the key across battery_find_by_key.
        mov r10, rax;
        push r10;
        sub rsp, 8;                      // keep rsp%16 == 0
        mov rdi, r10;
        call battery_find_by_key;
        add rsp, 8;
        pop r10;                         // r10 = batt_key
        cmp rax, 0xFF;                   // BATTERY_ROW_NONE
        jne batt_mi_in_use;

        // hdr_pack + tail_alloc.
        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call battery_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  batt_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // batt_key
        mov rdx, r14;                    // index
        mov rcx, r15;                    // design_mwh
        mov r8,  rbp;                    // chem
        call battery_tail_alloc;

        mov r10, 0xFFFFFE4F;             // BATTERY_TAIL_ENOSPC
        cmp rax, r10;
        je  batt_mi_enospc;
        mov r10, 0xFFFFFE4E;             // BATTERY_TAIL_BAD_ARG
        cmp rax, r10;
        je  batt_mi_bad_design;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x158;                  // KIND_BATTERY
        mov rdx, r13;                    // rights
        mov rcx, r14;
        call cap_mint_write;

        xor rax, rax;                    // BATTERY_OK
        jmp batt_mi_out;

      batt_mi_bad_slot:
        mov rax, 0xFFFFFE45;
        jmp batt_mi_out;
      batt_mi_bad_parent:
        mov rax, 0xFFFFFE4D;
        jmp batt_mi_out;
      batt_mi_bad_rights:
        mov rax, 0xFFFFFE4C;
        jmp batt_mi_out;
      batt_mi_bad_index:
        mov rax, 0xFFFFFE4B;
        jmp batt_mi_out;
      batt_mi_bad_design:
        mov rax, 0xFFFFFE4A;
        jmp batt_mi_out;
      batt_mi_bad_chem:
        mov rax, 0xFFFFFE49;
        jmp batt_mi_out;
      batt_mi_no_device:
        mov rax, 0xFFFFFE48;
        jmp batt_mi_out;
      batt_mi_enospc:
        mov rax, 0xFFFFFE47;
        jmp batt_mi_out;
      batt_mi_in_use:
        mov rax, 0xFFFFFE46;

      batt_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let battery_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (design_mwh: u64) (chem: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): audited mint. Putting emission in the wrapper means a second mint path cannot exist without being audited (the discipline every derived kind since #1068 follows). The audit record carries SUBJECT slot and PRINCIPAL parent slot, so 'which device capability was used to claim this battery' is answerable after the fact. Four pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call battery_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x158;                  // KIND_BATTERY
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // battery_cap_revoke_inner(slot) -> BATTERY_OK | ...
  // ==========================================================================

  pub let battery_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): revoke a KIND_BATTERY. (1) slot < 256 -> BATTERY_BAD_SLOT. (2) kind == 0 -> BATTERY_REVOKE_ALREADY, idempotent and distinct so a caller can tell 'nothing to do' from 'done'. (3) kind != 0x158 -> BATTERY_WRONG_KIND, which is what stops a battery revoke from freeing another kind's row through a coincidentally-shaped target_ptr and is what makes it safe for the owner-column sweep to call this blindly. (4) row_id from target_ptr[15:0]; if live, battery_tail_free scrubs it, which is what makes the pack RE-MINTABLE. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0) rather than three raw stores, per #1579. NOTHING SHUTS DOWN. Revoking authority over a pack leaves the pack exactly as it was; that is deliberate, for the same reason kind_thermal_zone's revoke does not act on a latch. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed batt_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae batt_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  batt_rvk_already;

        mov r11, 0x158;                  // KIND_BATTERY
        cmp r10, r11;
        jne batt_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_rvk_clear;

        mov rdi, r13;
        call battery_tail_free;

      batt_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // BATTERY_OK
        jmp batt_rvk_out;

      batt_rvk_bad_slot:
        mov rax, 0xFFFFFE45;
        jmp batt_rvk_out;
      batt_rvk_wrong_kind:
        mov rax, 0xFFFFFE44;
        jmp batt_rvk_out;
      batt_rvk_already:
        mov rax, 0xFFFFFE43;

      batt_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let battery_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS, so a process death leaves the same audit trail a deliberate teardown would. NO cascade: nothing in this tree derives from a battery capability (KIND_COOLING_DEVICE derives over KIND_DEVICE, and there is no cell-level sub-battery kind), and an empty cascade call would be a hook that looks maintained and is not. Three pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call battery_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x158;                  // KIND_BATTERY
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // battery_debug_print(row_id) -> BATTERY_OK | BATTERY_TAIL_BAD_ARG
  // ==========================================================================

  pub let battery_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R31.M3-001 (#1099): canonical printer for one battery row. Refuses a dead or out-of-range row with BATTERY_TAIL_BAD_ARG rather than printing zeroes: a freed row renders as {idx 0, des 0, chem 0, pct 0, mv 0, state UNKNOWN}, which is a plausible-looking bay-1 pack with zero design capacity sitting in an unknown state -- the most misleading six values this module could emit. Seven KV lines. r12 holds row_id across the calls; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed batt_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call battery_tail_valid;
        cmp rax, 0;
        je  batt_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + batt_dbg_msg];
        lea rcx, [rip + batt_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call battery_row_index;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + batt_dbg_msg];
        lea rcx, [rip + batt_k_idx];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call battery_row_design;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + batt_dbg_msg];
        lea rcx, [rip + batt_k_des];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call battery_row_chem;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + batt_dbg_msg];
        lea rcx, [rip + batt_k_chm];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call battery_row_percent;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + batt_dbg_msg];
        lea rcx, [rip + batt_k_pct];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call battery_row_voltage;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + batt_dbg_msg];
        lea rcx, [rip + batt_k_mv];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call battery_row_state;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + batt_dbg_msg];
        lea rcx, [rip + batt_k_st];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // BATTERY_OK
        jmp batt_dp_out;

      batt_dp_bad:
        mov rax, 0xFFFFFE4E;             // BATTERY_TAIL_BAD_ARG

      batt_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_battery(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_battery : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M3-001 (#1099): KIND_BATTERY dispatch handler. Emits cap_battery_msg on entry. row_id = target_ptr[15:0] and slot = target_ptr[31:16], both from the DESCRIPTOR (which only cap_mint_write writes); op = op_arg[7:0]. RIGHTS PER OP: QUERY_PERCENT / QUERY_STATE / QUERY_VOLTAGE require R_BATTERY_READ; QUERY_INDEX / QUERY_DESIGN / QUERY_CHEM / QUERY_REPORTS / QUERY_PARENT require R_BATTERY_INVOKE; DEBUG_PRINT requires R_BATTERY_OBSERVE; REPORT requires R_BATTERY_REPORT. THE OP THAT IS ABSENT is a design-capacity or chemistry setter: nothing in this handler can raise or lower a static field, and R_BATTERY_MINT is consequently a right this handler never reads -- the shape #1075 gave the reserved rights. OPS 0..8 TAKE NO OPERAND. OP 9 (REPORT) takes three operand fields packed per §BATTERY_OP_REPORT (percent [15:8], state [23:16], mv [47:24], reserved [63:48] MUST be zero -> BATTERY_TAIL_BAD_ARG). Refused rather than masked, for the reason kind_thermal_zone ASSESS's reserved field is: sixteen free bits on an op that reaches the row's cached state is where a fourth value would be smuggled. Unknown op -> INVOKE_UNSUPPORTED; rights failure -> INVOKE_DENIED. Every query returns BATTERY_DECODE_BAD for a dead row and never a plausible zero, because 0 is a legitimate index, a legitimate reports count and a legitimate state (UNKNOWN). r12=rights, r13=row_id, rbx=slot, r14=op, r15=percent, rbp=state, r10/r11 scratch; six pushes leave rsp%16 == 0 at every nested call. Labels prefixed batt_h_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot   = target_ptr[31:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_battery_msg];
        call klog_s1;

        // Decode op and REPORT operand.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov rax, r14;
        shr rax, 8;
        and rax, 0xFF;                   // percent
        mov r15, rax;
        mov rax, r14;
        shr rax, 16;
        and rax, 0xFF;                   // state
        mov rbp, rax;
        mov rax, r14;
        shr rax, 24;
        mov r11, 0xFFFFFF;
        and rax, r11;                    // mv, 24 bits
        // Reserved field: op_arg[63:48].
        mov r11, r14;
        shr r11, 48;
        mov r14, r10;                    // r14 = op from here on
        // r15 = percent, rbp = state, rax = mv, r11 = reserved-hi

        cmp r14, 9;                      // BATTERY_OP_MAX
        ja  batt_h_unsup;

        cmp r14, 9;                      // BATTERY_OP_REPORT
        je  batt_h_report_gate;

        cmp r14, 8;                      // BATTERY_OP_DEBUG_PRINT
        je  batt_h_dbg;

        // Ops 0..7: no operand.
        cmp r14, 3;
        je  batt_h_read_gate;
        cmp r14, 4;
        je  batt_h_read_gate;
        cmp r14, 5;
        je  batt_h_read_gate;

        // QUERY_INDEX / QUERY_DESIGN / QUERY_CHEM / QUERY_REPORTS /
        // QUERY_PARENT: INVOKE.
        mov r10, r12;
        and r10, 0x008;                  // R_BATTERY_INVOKE
        cmp r10, 0;
        je  batt_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  batt_h_idx;
        cmp r14, 1;
        je  batt_h_des;
        cmp r14, 2;
        je  batt_h_chem;
        cmp r14, 6;
        je  batt_h_rep;
        call battery_row_parent;
        jmp batt_h_out;

      batt_h_read_gate:
        mov r10, r12;
        and r10, 0x001;                  // R_BATTERY_READ
        cmp r10, 0;
        je  batt_h_denied;

        mov rdi, r13;
        cmp r14, 3;
        je  batt_h_pct;
        cmp r14, 4;
        je  batt_h_state;
        call battery_row_voltage;
        jmp batt_h_out;

      batt_h_report_gate:
        // The reserved field is REFUSED, not masked.
        cmp r11, 0;
        jne batt_h_res;

        mov r10, r12;
        and r10, 0x002;                  // R_BATTERY_REPORT
        cmp r10, 0;
        je  batt_h_denied;

        // Save the three operands across battery_row_of_slot, since
        // that helper clobbers caller-save. Not needed here -- we route
        // through battery_report_install with rbx = slot -- so pass the
        // slot from the descriptor and let install re-resolve to a row.
        mov rdi, rbx;                    // slot
        mov rsi, r15;                    // percent
        mov rdx, rax;                    // mv
        mov rcx, rbp;                    // state
        call battery_report_install;
        jmp batt_h_out;

      batt_h_idx:
        call battery_row_index;
        jmp batt_h_out;
      batt_h_des:
        call battery_row_design;
        jmp batt_h_out;
      batt_h_chem:
        call battery_row_chem;
        jmp batt_h_out;
      batt_h_rep:
        call battery_row_reports;
        jmp batt_h_out;

      batt_h_pct:
        call battery_row_percent;
        jmp batt_h_out;
      batt_h_state:
        call battery_row_state;
        jmp batt_h_out;

      batt_h_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_BATTERY_OBSERVE
        cmp r10, 0;
        je  batt_h_denied;
        mov rdi, r13;
        call battery_debug_print;
        jmp batt_h_out;

      batt_h_res:
        mov rax, 0xFFFFFE4E;             // BATTERY_TAIL_BAD_ARG
        jmp batt_h_out;
      batt_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp batt_h_out;
      batt_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      batt_h_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
