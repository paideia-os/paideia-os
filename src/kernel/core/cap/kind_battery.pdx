    }

  pub let battery_row_percent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): last reported percent (0..100), BATTERY_PCT_NONE if no report has installed yet, BATTERY_DECODE_BAD for a dead row. The three answers are DIFFERENT and must stay so: 100 is a legitimate full pack, 0xFF is 'no supervisor has reported yet', all-ones is 'there is no such pack'. A decoder that collapsed any two would let a caller act on a state that was never reported. Labels prefixed batt_rp_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call battery_tail_valid;
        cmp rax, 0;
        je  batt_rp_bad;
        lea r10, [rip + _battery_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        jmp batt_rp_out;
      batt_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      batt_rp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let battery_row_voltage : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M3-001 (#1099): last reported voltage in mV, 0 if unreported, BATTERY_DECODE_BAD for a dead row. Labels prefixed batt_rv2_.",
      block: {
        push r12;
        push r13;
        push r14;
