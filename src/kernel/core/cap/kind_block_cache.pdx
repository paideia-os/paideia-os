// src/kernel/core/cap/kind_block_cache.pdx -- R52.M7-002 (#1716)
//
// KIND_BLOCK_CACHE = 0x1A1, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// The runtime authority for ONE per-volume block-cache handle: a
// cache_id (small integer naming which cache slot this row backs), a
// flags word, and four u64 observability counters (hit / miss /
// eviction / writeback).  This file registers the ordinal + the basic
// mint / revoke / row-table substrate + a bare cap-invoke handler
// only -- LOOKUP / INSERT / FLUSH / INVALIDATE / PIN / UNPIN ops are
// out of scope for R52.M7-002 per design/filesystem/
// r52-implementation-plan.md §2.7 and are named in the design doc as
// future work.  The cap_handler_block_cache handler installed at
// SECTION 6 refuses every op with INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC),
// matching the "register the KIND + capability handler" scope wording
// in the issue brief.  block_cache.pdx's own cache-line internals are
// NOT wired into this row -- a follow-up landing threads the row into
// the cache-line walker; see the design plan §2.7 for that split.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// design/filesystem/volume-fs-substrate.md §6.1 names KIND_MEMORY (4)
// as this kind's base ("One per-volume cache handle").  Same argument
// as KIND_VOLUME / KIND_SIG_KEY: a cache is not a refinement of another
// derived-kind authority; it is a root of block-cache authority whose
// backing storage is ordinary memory.  The derivation gate is
// therefore the SAME "cannot widen memory reach beyond what you
// already hold" rule KIND_VOLUME itself uses (volume_check_parent_memory,
// kind_volume.pdx §0): parent.kind == KIND_MEMORY (4) AND rights carry
// RIGHT_MINT (0x200).
//
// Supervisor-only mint.  There is no cap-invoke op that reaches
// block_cache_cap_mint_inner (the same structural discipline
// kind_volume.pdx uses: mint is a kernel-trusted primitive callable
// only from boot / mount / supervisor code that already holds a root
// KIND_MEMORY parent cap with RIGHT_MINT).  A ring-3 caller holding
// only a KIND_BLOCK_CACHE handle cannot mint a fresh row -- it can
// only reach the handler's op dispatch, which at this landing has no
// ops wired.  Same posture as KIND_VOLUME's own "no ring-3 mint
// surface" contract.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words):
//
//   [+0]   header0: in_use[63:56] | flags_lo[55:32] | gen[31:16] | kind[15:0]
//   [+8]   header1: reserved[63:32] | res[31:16] | cache_id[15:0]
//   [+16]  hit_count       (u64) -- bumped by the cache-line walker on hits
//   [+24]  miss_count      (u64) -- bumped by the cache-line walker on misses
//   [+32]  eviction_count  (u64) -- bumped when a resident line is dropped
//   [+40]  writeback_count (u64) -- bumped when a dirty line is flushed
//   [+48]  reserved        (u64)
//   [+56]  reserved        (u64)
//
// The `flags` field the design brief names as u32 is split across the
// header word as flags_lo[55:32] (24 bits of user flags) plus the
// top-byte in_use marker at [63:56] that the allocator uses to scan
// for a free row -- same convention KIND_VOLUME uses on its own header
// word.  A future landing that needs the full 32 bits of user flags
// can move the in_use marker into header1 at a design cost; the
// 24-bit slice is sufficient for M7's own flag needs (no flag names
// are wired yet at this landing).
//
// Reserved footprint: header1[63:32] (4 bytes) + word 6 (8 bytes) +
// word 7 (8 bytes) = 20 bytes.  The design brief names 24 bytes;
// the four-byte delta is the pad the flags/in_use co-hosting yields
// on header word 0.
//
// Row-addressed capacity: 16 rows x 64 bytes = 1024 bytes, matching
// the KIND_VOLUME / KIND_SIG_KEY 16-row convention (design/filesystem/
// volume-fs-substrate.md §3.4).
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
//   R_BC_READ    (0x001) -- reserved; observation of counters through the
//                            handler once QUERY ops are wired
//   R_BC_WRITE   (0x002) -- reserved; INSERT / FLUSH / INVALIDATE
//                            (out of scope at this landing)
//   R_BC_INVOKE  (0x008) -- reserved; QUERY ops
//   R_BC_REVOKE  (0x010) -- supervisor teardown
//   R_BC_OBSERVE (0x400) -- reserved; debug printer
//   R_BC_ALL     (0x41B)
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFED30..0xFFFFED37  (R52.M7 band)
// =============================================================================
//
// design/filesystem/r52-implementation-plan.md §4 reserves the M7
// band 0xFFFFED30..0xFFFFED37 for the block-cache milestone.  This
// file claims the codes its own mint / revoke path needs; the
// remaining slots stay reserved for whichever future landing wires
// LOOKUP / INSERT / FLUSH / INVALIDATE / PIN / UNPIN.
//
//   BC_MINT_BAD_PARENT   0xFFFFED30
//   BC_MINT_BAD_RIGHTS   0xFFFFED31
//   BC_TAIL_BAD_ARG      0xFFFFED32
//   BC_BAD_SLOT          0xFFFFED33
//   BC_REGISTRY_FULL     0xFFFFED34
//   -- 0xFFFFED35..0xFFFFED37 reserved for M7 ops walker landings.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x1A1 (KIND_BLOCK_CACHE) does not sign-extend
// cleanly from a 32-bit immediate for `cmp reg, imm` forms (same
// 0x100..0xFFF band note as kind_volume.pdx §4); every compare
// against it stages through r11 first.  KIND_MEMORY (4) needs no
// staging.  No mov_b / mov_w / mov_d anywhere in this file -- every
// sub-field is packed / unpacked in full 64-bit registers via shift +
// mask.  No `test` instruction; bit checks use `and` + `cmp`.  Labels
// prefixed `bc_`.
//
// =============================================================================
// SECTION 5  ARITY -- THE cap_mint_inner COLLAPSE
// =============================================================================
//
// block_cache_cap_mint_inner(parent_slot, rights, hdr, cache_id_word)
// -- four args, well under the SysV register cap.  hdr is PRE-PACKED
// by the caller via block_cache_hdr_pack(flags, gen); cache_id_word
// is PRE-PACKED by block_cache_ext_pack(cache_id, res).  The four
// observability counters default to zero and are bumped by the
// cache-line walker post-mint (a follow-up landing wires those).

module KindBlockCache = structure {

  pub let KIND_BLOCK_CACHE      : u64 = 0x1A1
  pub let KIND_BLOCK_CACHE_BASE : u64 = 4         // = KIND_MEMORY

  pub let R_BC_READ    : u64 = 0x001
  pub let R_BC_WRITE   : u64 = 0x002
  pub let R_BC_INVOKE  : u64 = 0x008
  pub let R_BC_REVOKE  : u64 = 0x010
  pub let R_BC_OBSERVE : u64 = 0x400
  pub let R_BC_ALL     : u64 = 0x41B

  // No ops are wired at this landing. The handler at SECTION 6 refuses
  // every op with INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC).  Ordinals
  // are reserved here for the future LOOKUP / INSERT / FLUSH /
  // INVALIDATE / PIN / UNPIN walkers named in design/filesystem/
  // r52-implementation-plan.md §2.7 so those landings do not have to
  // re-derive the numbering.
  pub let BC_OP_QUERY_CACHE_ID       : u64 = 0
  pub let BC_OP_QUERY_HIT_COUNT      : u64 = 1
  pub let BC_OP_QUERY_MISS_COUNT     : u64 = 2
  pub let BC_OP_QUERY_EVICTION_COUNT : u64 = 3
  pub let BC_OP_QUERY_WRITEBACK      : u64 = 4
  pub let BC_OP_FLUSH                : u64 = 5
  pub let BC_OP_INVALIDATE           : u64 = 6
  pub let BC_OP_PIN                  : u64 = 7
  pub let BC_OP_UNPIN                : u64 = 8
  pub let BC_OP_MAX                  : u64 = 8

  // Failure taxonomy. 0xFFFFED30..0xFFFFED37, the whole R52.M7 band
  // per design/filesystem/r52-implementation-plan.md §4.
  pub let BC_OK                  : u64 = 0
  pub let BC_MINT_BAD_PARENT     : u64 = 0xFFFFED30
  pub let BC_MINT_BAD_RIGHTS     : u64 = 0xFFFFED31
  pub let BC_TAIL_BAD_ARG        : u64 = 0xFFFFED32
  pub let BC_BAD_SLOT            : u64 = 0xFFFFED33
  pub let BC_REGISTRY_FULL       : u64 = 0xFFFFED34

  pub let BC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let BC_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let BC_MAX       : u64 = 16
  pub let BC_ROW_BYTES : u64 = 64
  // 16 rows * 64 bytes = 1024 bytes = 128 u64.
  pub let mut _kind_bc_table : [u64; 128] = uninit @align(64)
  pub let mut _kind_bc_stats : [u64; 8]   = uninit @align(64)

  pub let BC_ST_MINTS   : u64 = 0
  pub let BC_ST_REVOKES : u64 = 1
  pub let BC_ST_QUERIES : u64 = 2
  pub let BC_ST_REFUSED : u64 = 3
  pub let BC_ST_MAX     : u64 = 8

  pub let block_cache_dbg_msg : [u8; 16] = "BLOCK CACHE ROW\0"

  // ==========================================================================
  // block_cache_table_reset() -> ()
  //
  // Clear every row and every counter. Boot and teardown only. Two
  // separate loops mirror kind_volume.pdx's shape.
  // ==========================================================================
  pub let block_cache_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): clear every row and every counter. Boot and teardown only. Labels prefixed bc_rs_.",
      block: {
        lea r10, [rip + _kind_bc_table];
        xor rax, rax;
        xor rcx, rcx;
      bc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  bc_rs_rows;

        lea r10, [rip + _kind_bc_stats];
        xor rcx, rcx;
      bc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bc_rs_stats;
        ret
      }
    }

  pub let block_cache_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): bounded increment; out-of-range no-op. Labels prefixed bc_nt_.",
      block: {
        cmp rdi, 8;
        jae bc_nt_out;
        lea r10, [rip + _kind_bc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bc_nt_out:
        ret
      }
    }

  pub let block_cache_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): bounded read; out-of-range returns 0. Labels prefixed bc_st_.",
      block: {
        cmp rdi, 8;
        jae bc_st_zero;
        lea r10, [rip + _kind_bc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let block_cache_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M7-002 (#1716): subset test against R_BC_ALL = 0x41B. Labels prefixed bc_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne bc_rv_no;
        mov rax, 1;
        ret;
      bc_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // block_cache_check_parent_memory(parent_slot) -> 1 | 0
  //
  // Derivation gate. parent.kind == KIND_MEMORY (4) AND rights carry
  // RIGHT_MINT (0x200). Mirrors volume_check_parent_memory one-for-one.
  // ==========================================================================
  pub let block_cache_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M7-002 (#1716): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_MEMORY (4) AND (rights & RIGHT_MINT 0x200) != 0. Mirrors kind_volume.pdx's volume_check_parent_memory one-for-one -- KIND_MEMORY(4) is a small immediate, no r11 staging needed. Pure read. Labels prefixed bc_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae bc_cpm_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne bc_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  bc_cpm_no;

        mov rax, 1;
        ret;

      bc_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // block_cache_hdr_pack(flags, gen) -> hdr | BC_DECODE_BAD
  //
  // flags must fit 24 bits (bits [55:32], top byte reserved for
  // in_use); gen must fit 16 bits (bits [31:16]).  kind bits [15:0]
  // are stamped by the header as the constant KIND_BLOCK_CACHE.
  // Bits [63:56] MUST leave this function zero -- that byte belongs
  // to the allocator's in_use flag.
  // ==========================================================================
  pub let block_cache_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (flags: u64) (gen: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M7-002 (#1716): canonical header0 encoder. flags fits [55:32] (< 0x1000000), gen fits [31:16] (< 0x10000). kind stamped as KIND_BLOCK_CACHE (0x1A1) in [15:0] -- staged in r11 because the constant does not sign-extend cleanly. Bits [63:56] left zero for the allocator's in_use flag. Labels prefixed bc_hp_.",
      block: {
        mov r10, 0x1000000;              // 2^24
        cmp rdi, r10;
        jae bc_hp_bad;

        mov r10, 0x10000;                // 2^16
        cmp rsi, r10;
        jae bc_hp_bad;

        mov r11, 0x1A1;                  // KIND_BLOCK_CACHE
        mov rax, r11;                    // kind in [15:0]
        mov r11, rsi;
        shl r11, 16;                     // gen in [31:16]
        or  rax, r11;
        mov r11, rdi;
        shl r11, 32;                     // flags in [55:32]
        or  rax, r11;
        ret;

      bc_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // block_cache_ext_pack(cache_id, res) -> ext | BC_DECODE_BAD
  //
  // Packs header1: cache_id in bits [15:0], res in [31:16].  Top word
  // bits [63:32] are the reserved u32 named in §1.
  // ==========================================================================
  pub let block_cache_ext_pack : (u64, u64) -> u64 !{} @{} =
    fn (cache_id: u64) (res: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M7-002 (#1716): canonical header1 encoder. cache_id fits [15:0] (< 0x10000), res fits [31:16] (< 0x10000). Reserved [63:32] left zero. Labels prefixed bc_ep_.",
      block: {
        mov r10, 0x10000;
        cmp rdi, r10;
        jae bc_ep_bad;

        mov r10, 0x10000;
        cmp rsi, r10;
        jae bc_ep_bad;

        mov rax, rdi;                    // cache_id in [15:0]
        mov r11, rsi;
        shl r11, 16;                     // res in [31:16]
        or  rax, r11;
        ret;

      bc_ep_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // block_cache_tail_alloc(hdr, ext) -> row_id | BC_TAIL_BAD_ARG | BC_REGISTRY_FULL
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A BLOCK-CACHE ROW;
  // tools/build.sh confines relocations against _kind_bc_table to
  // this object. Gates: hdr in_use pre-set -> BC_TAIL_BAD_ARG. The
  // four observability counters default to 0; reserved words default
  // to 0. Low-first scan over 16 rows of 64 bytes (power-of-2 stride:
  // row_id << 6). Three callee-save pushes mirror volume_tail_alloc's
  // shape (one fewer -- no uuid pair to spill).
  // ==========================================================================
  pub let block_cache_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (ext: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): claim one block-cache row. THE ONLY WRITER of _kind_bc_table; tools/build.sh confines it via ec_confine_one. Gates: hdr in_use pre-set -> BC_TAIL_BAD_ARG. Low-first scan over 16 rows of 64 bytes (stride 64 = row << 6). Two callee-save pushes (r12=hdr, r13=ext) + one for rbx (scan index) leaves the frame odd; sub rsp, 8 aligns. Labels prefixed bc_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // ext

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne bc_ta_bad;

        xor rbx, rbx;                    // row_id
      bc_ta_scan:
        cmp rbx, 16;                     // BC_MAX
        jae bc_ta_enospc;

        lea r10, [rip + _kind_bc_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  bc_ta_claim;

        add rbx, 1;
        jmp bc_ta_scan;

      bc_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header0 + in_use
        mov [r10 + 8],  r13;             // header1 (cache_id/res)
        xor rax, rax;
        mov [r10 + 16], rax;             // hit_count = 0
        mov [r10 + 24], rax;             // miss_count = 0
        mov [r10 + 32], rax;             // eviction_count = 0
        mov [r10 + 40], rax;             // writeback_count = 0
        mov [r10 + 48], rax;             // reserved
        mov [r10 + 56], rax;             // reserved
        mov rax, rbx;
        jmp bc_ta_out;

      bc_ta_enospc:
        mov rax, 0xFFFFED34;             // BC_REGISTRY_FULL
        jmp bc_ta_out;
      bc_ta_bad:
        mov rax, 0xFFFFED32;             // BC_TAIL_BAD_ARG

      bc_ta_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let block_cache_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): 1 iff row_id < BC_MAX and in_use byte set. Labels prefixed bc_tv_.",
      block: {
        cmp rdi, 16;
        jae bc_tv_no;
        lea r10, [rip + _kind_bc_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  bc_tv_no;
        mov rax, 1;
        ret;
      bc_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let block_cache_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): scrub row (all eight words). Labels prefixed bc_tf_.",
      block: {
        cmp rdi, 16;
        jae bc_tf_out;
        lea r10, [rip + _kind_bc_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      bc_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors. Each returns BC_DECODE_BAD when the row is not
  // live. Shape mirrors volume_row_* one-for-one.
  // -------------------------------------------------------------------

  // kind_block_cache_row(row_id) -> row_ptr | 0
  //
  // The per-task-brief public row-pointer helper.  Returns the base
  // address of the row's 64-byte slot on a live row, or 0 on a dead /
  // out-of-range row.  Callers cache-line-walkers hold this pointer
  // long enough to bump one of the four counter words in place.
  pub let kind_block_cache_row : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): row_id -> base pointer of the 64-byte row, or 0 on dead / out-of-range. tail_valid gate. One callee-save push preserves row_id across the tail_valid call. Labels prefixed bc_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_rp_bad;
        lea r10, [rip + _kind_bc_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, r10;
        jmp bc_rp_out;
      bc_rp_bad:
        xor rax, rax;
      bc_rp_out:
        pop r12;
        ret
      }
    }

  pub let block_cache_row_cache_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): cache_id (header1 [15:0]), or BC_DECODE_BAD. Labels prefixed bc_rci_.",
      block: {
        push r12;
        mov r12, rdi;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_rci_bad;
        lea r10, [rip + _kind_bc_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        mov r10, 0xFFFF;
        and rax, r10;
        jmp bc_rci_out;
      bc_rci_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bc_rci_out:
        pop r12;
        ret
      }
    }

  // The four counter accessors -- the R52.M7-002 (#1716) public
  // surface named in the issue brief.  Each returns BC_DECODE_BAD
  // on a dead / out-of-range row.
  pub let kind_block_cache_hit_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): hit_count, or BC_DECODE_BAD. Labels prefixed bc_rhit_.",
      block: {
        push r12;
        mov r12, rdi;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_rhit_bad;
        lea r10, [rip + _kind_bc_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp bc_rhit_out;
      bc_rhit_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bc_rhit_out:
        pop r12;
        ret
      }
    }

  pub let kind_block_cache_miss_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): miss_count, or BC_DECODE_BAD. Labels prefixed bc_rmiss_.",
      block: {
        push r12;
        mov r12, rdi;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_rmiss_bad;
        lea r10, [rip + _kind_bc_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp bc_rmiss_out;
      bc_rmiss_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bc_rmiss_out:
        pop r12;
        ret
      }
    }

  pub let kind_block_cache_eviction_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): eviction_count, or BC_DECODE_BAD. Labels prefixed bc_revc_.",
      block: {
        push r12;
        mov r12, rdi;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_revc_bad;
        lea r10, [rip + _kind_bc_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp bc_revc_out;
      bc_revc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bc_revc_out:
        pop r12;
        ret
      }
    }

  pub let kind_block_cache_writeback_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): writeback_count, or BC_DECODE_BAD. Labels prefixed bc_rwbk_.",
      block: {
        push r12;
        mov r12, rdi;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_rwbk_bad;
        lea r10, [rip + _kind_bc_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        jmp bc_rwbk_out;
      bc_rwbk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bc_rwbk_out:
        pop r12;
        ret
      }
    }

  // Slot -> row_id, gated on the descriptor being a live KIND_BLOCK_CACHE.
  // Kind constant 0x1A1 staged in r11 (§4).
  pub let block_cache_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M7-002 (#1716): slot -> row_id gated on KIND_BLOCK_CACHE. THE ONLY ROUTE IN THE KERNEL FROM A CAP SLOT TO A BLOCK-CACHE ROW. Labels prefixed bc_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae bc_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1A1;                  // KIND_BLOCK_CACHE
        cmp r10, r11;
        jne bc_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_ros_none;

        mov rax, r12;
        jmp bc_ros_out;

      bc_ros_none:
        mov rax, 0xFF;                   // BC_ROW_NONE
      bc_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // block_cache_cap_revoke(row_id) -> BC_OK | BC_BAD_SLOT
  // ==========================================================================
  pub let block_cache_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M7-002 (#1716): scrub one row via block_cache_tail_free and bump REVOKES. Refuses out-of-range OR already-dead rows with the same BC_BAD_SLOT code (mirroring volume_cap_revoke's precedent -- basic mint/revoke scope per the design brief; a future landing may split this if a caller needs the distinction). Two callee-save pushes leave rsp%16 == 0. Labels prefixed bc_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae bc_cr_bad_slot;

        mov rdi, r12;
        call block_cache_tail_valid;
        cmp rax, 0;
        je  bc_cr_bad_slot;

        mov rdi, r12;
        call block_cache_tail_free;
        mov rdi, 1;                      // BC_ST_REVOKES
        call block_cache_note;
        xor rax, rax;                    // BC_OK
        jmp bc_cr_out;

      bc_cr_bad_slot:
        mov rax, 0xFFFFED33;             // BC_BAD_SLOT

      bc_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_block_cache_mint(parent_slot, rights, hdr, ext)
  //   -> row_id | BC_MINT_*
  //
  // §5: hdr is PRE-PACKED by the caller via block_cache_hdr_pack; ext
  // is PRE-PACKED via block_cache_ext_pack. Gate sequence: (1) parent
  // (KIND_MEMORY + RIGHT_MINT); (2) rights subset; (3) tail_alloc (hdr,
  // ext). Four callee-save pushes lands rsp%16 == 8 -- sub rsp, 8
  // aligns for the nested calls. Refusal paths bump BC_ST_REFUSED.
  //
  // Supervisor-only: no cap-invoke op reaches this function; a
  // KIND_BLOCK_CACHE holder cannot mint a fresh row -- only kernel-
  // side code holding a root KIND_MEMORY parent cap with RIGHT_MINT
  // can (same structural pattern as kind_volume.pdx's own mint gate).
  // ==========================================================================
  pub let kind_block_cache_mint : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (hdr: u64) (ext: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M7-002 (#1716): the KIND_BLOCK_CACHE mint walker. Gate sequence: parent (KIND_MEMORY + RIGHT_MINT), rights subset, tail_alloc (hdr, ext). Four callee-save pushes (r12=parent_slot, r13=rights, r14=hdr, r15=ext) + sub rsp, 8 = 40 bytes: post-prologue rsp%16 == 0 for every nested call, mirroring kind_volume.pdx's volume_cap_mint_inner (one fewer push because no uuid pair to spill). Refusal paths bump BC_ST_REFUSED. Labels prefixed bc_mi_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov r14, rdx;                    // hdr
        mov r15, rcx;                    // ext

        // (1) Parent gate.
        mov rdi, r12;
        call block_cache_check_parent_memory;
        cmp rax, 0;
        je  bc_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call block_cache_rights_valid;
        cmp rax, 0;
        je  bc_mi_bad_rights;

        // (3) tail_alloc (hdr, ext).
        mov rdi, r14;
        mov rsi, r15;
        call block_cache_tail_alloc;
        mov r10, 16;                     // BC_MAX
        cmp rax, r10;
        jae bc_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // BC_ST_MINTS
        call block_cache_note;
        pop rax;
        jmp bc_mi_out;

      bc_mi_alloc_fail:
        jmp bc_mi_refused;
      bc_mi_bad_parent:
        mov rax, 0xFFFFED30;             // BC_MINT_BAD_PARENT
        jmp bc_mi_refused;
      bc_mi_bad_rights:
        mov rax, 0xFFFFED31;             // BC_MINT_BAD_RIGHTS

      bc_mi_refused:
        push rax;
        mov rdi, 3;                      // BC_ST_REFUSED
        call block_cache_note;
        pop rax;

      bc_mi_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6  cap_handler_block_cache(rights, target_ptr, op_arg) -> ...
  //
  // Wired into cap_invoke_dispatch on `cmp rcx, 0x1A1; je call_kind_
  // block_cache`.  At R52.M7-002 landing this is a BARE handler: every
  // op refuses with INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC).  The
  // LOOKUP / INSERT / FLUSH / INVALIDATE / PIN / UNPIN walkers named
  // in design/filesystem/r52-implementation-plan.md §2.7 land in a
  // follow-up round; the ordinals BC_OP_* are reserved above so those
  // landings do not have to re-derive the numbering.
  //
  // op_arg[63:8] must be zero -- a smuggled second value on an op
  // reaching a cache row is refused rather than masked, mirroring
  // kind_volume.pdx's own posture on the same shape.
  // ==========================================================================
  pub let cap_handler_block_cache : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M7-002 (#1716): KIND_BLOCK_CACHE bare dispatch. No ops wired at this landing; every op returns INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC). op_arg[63:8] MUST be zero -- a smuggled second value is refused with BC_TAIL_BAD_ARG rather than masked. Prologue kept minimal (no callee-save juggling needed -- this handler owns none of its inputs past the op-arg gate). Labels prefixed bc_hn_.",
      block: {
        mov r10, rdx;                    // op_arg
        mov r11, r10;
        shr r11, 8;
        cmp r11, 0;
        jne bc_hn_res;

        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        ret;

      bc_hn_res:
        mov rax, 0xFFFFED32;             // BC_TAIL_BAD_ARG
        ret
      }
    }
}
