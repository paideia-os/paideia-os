// src/kernel/core/cap/kind_page_flip.pdx -- R105.M3-001 (co-landed for R104.M4)
//
// KIND_PAGE_FLIP = 0x1B0, derived over KIND_DISPLAY_OUTPUT (= 0x170).
//
// Per design/graphics/r101-kernel-plan.md §4.3: the compositor's normal
// per-frame path is neither KIND_MODESET_TXN (full mode change) nor
// KIND_DISPLAY_PLANE (plane identity) nor KIND_SCANOUT_LEASE (fullscreen
// direct-scanout). It needs a capability that says "at the next vblank
// on this output, this plane's backing memory shall be fb_slot, and here
// is the target timeline value the display engine will latch."
//
// LINEAR: a page-flip authority is single-holder -- the compositor
// created it for a specific output-plane pair. cap_mint_write refuses
// duplication when the R_FLIP_MINT bit is absent (this cap NEVER carries
// R_FLIP_MINT; §2). Revocation is only via R_FLIP_REVOKE, held by the
// compositor's own supervisor scope.
//
// Prompt requirement (R105 co-landing): R104 has not landed at the time
// of R105, so KIND_PAGE_FLIP is CO-LANDED here. When R104 lands its own
// modeset + vblank ISR wiring, the seq_pending/seq_completed fields
// grow real writers; at R105 the writers are the sys_page_flip syscall
// path (bumps pending) and a simulated-vblank tick (bumps completed).
//
// =============================================================================
// SECTION 0  WHY KIND_PAGE_FLIP DERIVES OVER KIND_DISPLAY_OUTPUT
// =============================================================================
//
// A page-flip is per-output authority. The output cap already names the
// engine + plane + timeline the flip must resolve against; the flip cap
// specializes it to a specific active_fb_slot and an in-flight flag.
//
// =============================================================================
// SECTION 1  TAIL ENCODING -- 48 BYTES (six u64 words)
// =============================================================================
//
//   [+0]  header (u64):
//         in_use          [63:56]  allocator flag
//         in_flight       [55:48]  1 iff a flip is queued/latched
//         reserved        [47:16]
//         source_hint     [15:8]   0=NONE, 1=SIM_TICK, 2=VBLANK,
//                                  3=VIRTIO_COMPLETION
//         reserved        [7:0]
//   [+8]  output_slot     (u64)   parent KIND_DISPLAY_OUTPUT slot
//   [+16] active_fb_slot  (u64)   currently-scanned KIND_FRAMEBUFFER row
//   [+24] pending_fb_slot (u64)   flip target (set on SUBMIT)
//   [+32] seq_pending     (u64)   monotonic count of submitted flips
//   [+40] seq_completed   (u64)   monotonic count of latched flips
//
// Row-addressed capacity: PGFL_MAX = 4 (one per T14 output + headroom).
// 4 * 48 = 192 bytes = 24 u64.
//
// =============================================================================
// SECTION 2  RIGHTS  (LINEAR)
// =============================================================================
//
//   R_FLIP_INVOKE (0x001) -- authority to SUBMIT + WAIT.
//   R_FLIP_REVOKE (0x002) -- authority to tear down.
//   R_FLIP_ALL    (0x003)
//
// NO R_FLIP_MINT -- LINEAR. A holder cannot dup the cap; cap_mint_write
// with kind = KIND_PAGE_FLIP is refused unless the caller passes the
// LINEAR-mint gate through the compositor's supervisor scope. This is
// the invariant design/graphics/authority-boundary.md pins.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB50..0xFFFFEB5F
// =============================================================================
//
// Landing-time audit: 0xFFFFEB50..0xFFFFEB5F free (disjoint from KIND_
// FRAMEBUFFER 0xFFFFEB40..4F and KIND_HOTPLUG_CHANNEL 0xFFFFEB60..6F).
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag 0x1B0 stages through r11. Row fields are full u64 words. No
// `test`, no `add reg, [mem]`, no `cmp reg, [mem]`. Labels prefixed `pgfl_`.

module KindPageFlip = structure {

  pub let KIND_PAGE_FLIP      : u64 = 0x1B0
  pub let KIND_PAGE_FLIP_BASE : u64 = 0x170       // = KIND_DISPLAY_OUTPUT

  // Rights (§2). LINEAR: no R_FLIP_MINT.
  pub let R_FLIP_INVOKE : u64 = 0x001
  pub let R_FLIP_REVOKE : u64 = 0x002
  pub let R_FLIP_ALL    : u64 = 0x003

  // Source hint (§1 header field).
  pub let PGFL_SRC_NONE               : u64 = 0
  pub let PGFL_SRC_SIM_TICK           : u64 = 1
  pub let PGFL_SRC_VBLANK             : u64 = 2
  pub let PGFL_SRC_VIRTIO_COMPLETION  : u64 = 3

  // Ops.
  pub let PGFL_OP_SUBMIT : u64 = 0
  pub let PGFL_OP_QUERY  : u64 = 1
  pub let PGFL_OP_WAIT   : u64 = 2
  pub let PGFL_OP_MAX    : u64 = 2

  // Failure taxonomy (§3). 0xFFFFEB50..0xFFFFEB5F band.
  pub let PGFL_OK              : u64 = 0
  pub let PGFL_MINT_BAD_OUTPUT : u64 = 0xFFFFEB5F
  pub let PGFL_MINT_BAD_RIGHTS : u64 = 0xFFFFEB5E
  pub let PGFL_MINT_BAD_FB     : u64 = 0xFFFFEB5D
  pub let PGFL_TAIL_BAD_ARG    : u64 = 0xFFFFEB5C
  pub let PGFL_TAIL_ENOSPC     : u64 = 0xFFFFEB5B
  pub let PGFL_BAD_SLOT        : u64 = 0xFFFFEB5A
  pub let PGFL_SUBMIT_BUSY     : u64 = 0xFFFFEB59  // in-flight, retry
  pub let PGFL_WAIT_TIMEOUT    : u64 = 0xFFFFEB58

  pub let PGFL_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PGFL_ROW_NONE   : u64 = 0xFF

  // sched_wait key kind (matches SchedWait.SCHED_WAIT_* discipline). A
  // new value distinct from ELEVATE_CHANNEL_RX (1); the SchedWait enum
  // grows this alias in its own module on a future retrospective refresh.
  pub let SCHED_WAIT_PAGE_FLIP : u64 = 2

  // Ceilings.
  pub let PGFL_MAX       : u64 = 4
  pub let PGFL_ROW_BYTES : u64 = 48

  // 4 rows * 48 bytes = 192 bytes = 24 u64.
  pub let mut _pgfl_table : [u64; 24] = uninit @align(64)
  pub let mut _pgfl_stats : [u64; 4]  = uninit @align(32)

  pub let PGFL_ST_MINTS      : u64 = 0
  pub let PGFL_ST_SUBMITS    : u64 = 1
  pub let PGFL_ST_COMPLETIONS: u64 = 2
  pub let PGFL_ST_REFUSED    : u64 = 3

  // Fingerprint (lowercase, no OK_TOK). NUL-terminated.
  pub let pgfl_mint_ok_msg : [u8; 23] = "r105 page flip mint ok\0"

  // ==========================================================================
  // pgfl_table_reset() -> ()
  // ==========================================================================
  pub let pgfl_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: clear every _pgfl_table row + counters. Boot + teardown. Labels prefixed pgfl_rs_.",
      block: {
        lea r10, [rip + _pgfl_table];
        xor rax, rax;
        xor rcx, rcx;
      pgfl_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 24;
        jb  pgfl_rs_rows;

        lea r10, [rip + _pgfl_stats];
        xor rcx, rcx;
      pgfl_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  pgfl_rs_stats;
        ret
      }
    }

  pub let pgfl_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: bounded stats increment; OOR no-op. Labels prefixed pgfl_nt_.",
      block: {
        cmp rdi, 4;
        jae pgfl_nt_out;
        lea r10, [rip + _pgfl_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pgfl_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let pgfl_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R105.M3-001: subset test against R_FLIP_ALL = 0x003. LINEAR: no R_FLIP_MINT ever accepted. Labels prefixed pgfl_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x003;
        and rax, r10;
        cmp rax, rdi;
        jne pgfl_rv_no;
        mov rax, 1;
        ret;
      pgfl_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool.
  // ==========================================================================

  pub let pgfl_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: 1 iff idx < PGFL_MAX(4) and in_use bit set. idx*48 via shl 5 + shl 4 + add. Labels prefixed pgfl_rv2_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae pgfl_rv2_no;
        lea r10, [rip + _pgfl_table];
        mov r11, rdi;
        shl r11, 5;
        mov r9, rdi;
        shl r9, 4;
        add r11, r9;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pgfl_rv2_no;
        mov rax, 1;
        ret;
      pgfl_rv2_no:
        xor rax, rax;
        ret
      }
    }

  pub let pgfl_row_addr : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: address compute. idx*48 = idx*32 + idx*16. Labels prefixed pgfl_ra_.",
      block: {
        lea rax, [rip + _pgfl_table];
        mov r10, rdi;
        shl r10, 5;
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        ret
      }
    }

  // pgfl_tail_alloc(output_slot, active_fb_slot) -> row_id | PGFL_TAIL_*.
  pub let pgfl_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (output_slot: u64) (active_fb_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: claim one PGFL row. Low-first scan. Writes tail first, header last with in_use=1. Header source_hint = 0 (PGFL_SRC_NONE) at mint. 2 callee-save pushes for args. Labels prefixed pgfl_ta_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // output_slot
        mov r12, rsi;                    // active_fb_slot

        xor rcx, rcx;
      pgfl_ta_scan:
        cmp rcx, 4;
        jae pgfl_ta_enospc;

        lea r10, [rip + _pgfl_table];
        mov r11, rcx;
        shl r11, 5;
        mov rax, rcx;
        shl rax, 4;
        add r11, rax;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pgfl_ta_claim;

        add rcx, 1;
        jmp pgfl_ta_scan;

      pgfl_ta_claim:
        mov [r10 + 8],  rbx;             // output_slot
        mov [r10 + 16], r12;             // active_fb_slot
        xor rax, rax;
        mov [r10 + 24], rax;             // pending_fb_slot = 0
        mov [r10 + 32], rax;             // seq_pending = 0
        mov [r10 + 40], rax;             // seq_completed = 0

        mov r11, 1;
        shl r11, 56;                     // in_use = 1
        mov [r10 + 0], r11;              // header last

        mov rax, rcx;
        jmp pgfl_ta_out;

      pgfl_ta_enospc:
        mov rax, 0xFFFFEB5B;             // PGFL_TAIL_ENOSPC

      pgfl_ta_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pgfl_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: scrub one PGFL row (six u64 words). Labels prefixed pgfl_tf_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae pgfl_tf_out;
        lea r10, [rip + _pgfl_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      pgfl_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let pgfl_row_output : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: read output_slot from row[+8]. Labels prefixed pgfl_ro_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call pgfl_row_valid;
        cmp rax, 0;
        je  pgfl_ro_bad;
        mov rdi, rbx;
        call pgfl_row_addr;
        mov r10, rax;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      pgfl_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let pgfl_row_pending : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: read seq_pending from row[+32]. Labels prefixed pgfl_rp_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call pgfl_row_valid;
        cmp rax, 0;
        je  pgfl_rp_bad;
        mov rdi, rbx;
        call pgfl_row_addr;
        mov r10, rax;
        mov rax, [r10 + 32];
        pop rbx;
        ret;
      pgfl_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let pgfl_row_completed : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: read seq_completed from row[+40]. Labels prefixed pgfl_rc_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call pgfl_row_valid;
        cmp rax, 0;
        je  pgfl_rc_bad;
        mov rdi, rbx;
        call pgfl_row_addr;
        mov r10, rax;
        mov rax, [r10 + 40];
        pop rbx;
        ret;
      pgfl_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let pgfl_row_in_flight : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: read in_flight bit from row[+0][55:48]. Labels prefixed pgfl_rif_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call pgfl_row_valid;
        cmp rax, 0;
        je  pgfl_rif_bad;
        mov rdi, rbx;
        call pgfl_row_addr;
        mov r10, rax;
        mov rax, [r10 + 0];
        shr rax, 48;
        and rax, 0xFF;
        pop rbx;
        ret;
      pgfl_rif_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_page_flip_mint_body(output_slot, rights, active_fb_slot)
  //   -> row_id | PGFL_MINT_*
  //
  // 3-arg body (SysV fits in registers). LINEAR: caller must be the
  // compositor supervisor scope (enforced upstream at the cap_mint_write
  // gate; this body only validates numerics).
  // ==========================================================================
  pub let kind_page_flip_mint_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (output_slot: u64) (rights: u64) (active_fb_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R105.M3-001: mint KIND_PAGE_FLIP. Gates: (1) rights via pgfl_rights_valid (LINEAR -- R_FLIP_MINT never valid); (2) tail_alloc. output_slot and active_fb_slot are stored verbatim; deep validation of their liveness lives in the SUBMIT path so a compositor tearing down an output does not have to first tear down every flip cap. Register plan: rbx=output_slot, r12=active_fb_slot. 2 callee-save pushes + sub rsp,8: entry rsp%16==8, +16+8=24, rsp%16==0. Labels prefixed pgfl_mb_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // output_slot
        mov r12, rdx;                    // active_fb_slot

        // Gate 1: rights.
        mov rdi, rsi;
        call pgfl_rights_valid;
        cmp rax, 0;
        je  pgfl_mb_bad_rights;

        // tail_alloc.
        mov rdi, rbx;
        mov rsi, r12;
        call pgfl_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae pgfl_mb_refused;

        mov rbx, rax;                    // rbx = row_id (final)

        mov rdi, 0;                      // PGFL_ST_MINTS
        call pgfl_note;

        // Fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pgfl_mint_ok_msg];
        lea rcx, [rip + k_row];
        mov r8, rbx;
        call klog_s1_d1;

        mov rax, rbx;
        jmp pgfl_mb_out;

      pgfl_mb_bad_rights:
        mov rax, 0xFFFFEB5E;             // PGFL_MINT_BAD_RIGHTS

      pgfl_mb_refused:
        push rax;
        mov rdi, 3;                      // PGFL_ST_REFUSED
        call pgfl_note;
        pop rax;

      pgfl_mb_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kind_page_flip_revoke_body : (u64) -> u64 !{mem} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R105.M3-001: revoke KIND_PAGE_FLIP row. Bounds + in_use gate; else tail_free + return 0. Labels prefixed pgfl_rb_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 4;
        cmp r12, r10;
        jae pgfl_rb_bad_slot;

        mov rdi, r12;
        call pgfl_row_valid;
        cmp rax, 0;
        je  pgfl_rb_bad_slot;

        mov rdi, r12;
        call pgfl_tail_free;
        xor rax, rax;
        jmp pgfl_rb_out;

      pgfl_rb_bad_slot:
        mov rax, 0xFFFFEB5A;             // PGFL_BAD_SLOT

      pgfl_rb_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pgfl_submit(row_id, target_fb_slot) -> u64
  //
  // Queue a flip. Sets pending_fb_slot = target_fb_slot, marks in_flight
  // = 1, bumps seq_pending. Refuses if a flip is already in flight
  // (returns PGFL_SUBMIT_BUSY).
  //
  // The actual latch (in_flight -> 0, active_fb_slot <- pending_fb_slot,
  // seq_completed++) happens in pgfl_deliver_vblank, called by the
  // simulated-vblank tick or a real vblank ISR.
  // ==========================================================================
  pub let pgfl_submit : (u64, u64) -> u64 !{mem, sysreg} @{sched} =
    fn (row_id: u64) (target_fb_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched},
      justification: "R105.M3-002: submit a page-flip. Reads row header; refuses if in_flight bit already set. Otherwise sets in_flight=1, pending_fb_slot, seq_pending++, and returns 0. Register plan: rbx=row_id, r12=target_fb_slot, rbp=row_addr. 3 callee-save pushes + sub rsp,8 pad: entry rsp%16==8, +24+8=32, rsp%16==0. Labels prefixed pgfl_sb_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // target_fb_slot

        mov rdi, rbx;
        call pgfl_row_valid;
        cmp rax, 0;
        je  pgfl_sb_bad_slot;

        mov rdi, rbx;
        call pgfl_row_addr;
        mov rbp, rax;

        // in_flight check.
        mov rax, [rbp + 0];
        mov r10, rax;
        shr r10, 48;
        and r10, 0xFF;
        cmp r10, 0;
        jne pgfl_sb_busy;

        // Set pending_fb_slot.
        mov [rbp + 24], r12;

        // Bump seq_pending.
        mov rax, [rbp + 32];
        add rax, 1;
        mov [rbp + 32], rax;

        // Set in_flight in header.
        mov rax, [rbp + 0];
        mov r10, 1;
        shl r10, 48;
        or  rax, r10;
        mov [rbp + 0], rax;

        mov rdi, 1;                      // PGFL_ST_SUBMITS
        call pgfl_note;

        xor rax, rax;
        jmp pgfl_sb_out;

      pgfl_sb_bad_slot:
        mov rax, 0xFFFFEB5A;             // PGFL_BAD_SLOT
        jmp pgfl_sb_out;
      pgfl_sb_busy:
        mov rax, 0xFFFFEB59;             // PGFL_SUBMIT_BUSY

      pgfl_sb_out:
        add rsp, 8;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgfl_deliver_vblank(row_id, source_hint) -> u64
  //
  // Called by the simulated-vblank tick / real vblank ISR / virtio-gpu
  // completion. If in_flight is set: latch pending_fb_slot into
  // active_fb_slot, clear in_flight, bump seq_completed, wake any waiter
  // parked on sched_wait(SCHED_WAIT_PAGE_FLIP, row_id).
  //
  // Returns 1 if a latch occurred, 0 otherwise.
  // ==========================================================================
  pub let pgfl_deliver_vblank : (u64, u64) -> u64 !{mem, sysreg} @{sched} =
    fn (row_id: u64) (source_hint: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched},
      justification: "R105.M3-003: latch pending flip -> active on vblank source. Refuses OOR row / free row / not-in-flight (returns 0 silently -- the source may fire on rows that never submitted). On latch: active_fb_slot <- pending_fb_slot, in_flight cleared, seq_completed++, source_hint stashed in header[15:8], sched_wake_kind(SCHED_WAIT_PAGE_FLIP, row_id). Register plan: rbx=row_id, r12=source_hint, rbp=row_addr. 3 callee-save pushes + sub rsp,8 pad. Labels prefixed pgfl_dv_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        call pgfl_row_valid;
        cmp rax, 0;
        je  pgfl_dv_nolatch;

        mov rdi, rbx;
        call pgfl_row_addr;
        mov rbp, rax;

        // in_flight check.
        mov rax, [rbp + 0];
        mov r10, rax;
        shr r10, 48;
        and r10, 0xFF;
        cmp r10, 0;
        je  pgfl_dv_nolatch;

        // Latch: active <- pending.
        mov rax, [rbp + 24];             // pending_fb_slot
        mov [rbp + 16], rax;             // active_fb_slot <- pending

        // Clear in_flight (byte 6) and source_hint (byte 1); overwrite
        // source_hint with r12. Byte roles: [7]=in_use (keep),
        // [6]=in_flight (clear), [5,4,3,2]=reserved (keep), [1]=source_
        // hint (overwrite), [0]=reserved (keep). Mask = 0xFF00FFFFFFFF00FF.
        mov rax, [rbp + 0];
        mov r10, 0xFF00FFFFFFFF00FF;
        and rax, r10;
        mov r11, r12;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        mov [rbp + 0], rax;

        // Bump seq_completed.
        mov rax, [rbp + 40];
        add rax, 1;
        mov [rbp + 40], rax;

        mov rdi, 2;                      // PGFL_ST_COMPLETIONS
        call pgfl_note;

        // Wake any waiter on (SCHED_WAIT_PAGE_FLIP, row_id).
        mov rdi, 2;                      // SCHED_WAIT_PAGE_FLIP
        mov rsi, rbx;
        call sched_wake_kind;

        mov rax, 1;
        jmp pgfl_dv_out;

      pgfl_dv_nolatch:
        xor rax, rax;

      pgfl_dv_out:
        add rsp, 8;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  pub let kind_page_flip_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M3-001: boot-time defensive re-scrub. .bss zero at real boot. Zero args, no push/pop.",
      block: {
        call pgfl_table_reset;
        ret
      }
    }
}
