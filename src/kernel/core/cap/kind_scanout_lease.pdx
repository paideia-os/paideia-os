// src/kernel/core/cap/kind_scanout_lease.pdx -- G2.M1-001 (#1443)
//
// KIND_SCANOUT_LEASE = 0x188, derived over KIND_DISPLAY_PLANE (0x173),
// whose runtime base is KIND_MEMORY (= KIND_PAGE, 4).
//
// One direct-scanout lease: the authority a fullscreen client holds
// to program a display plane WITHOUT a compositor round-trip. The
// lease names the display plane, the output that carries it, the
// timeline the GPU signals for frame-latch, and an expiry deadline
// past which the compositor may recover the plane at will.
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS (G2 PURPOSE / P7 / P8)
// =============================================================================
//
// The compositor round-trip is the reason X's "always composite"
// default is a latency floor. A fullscreen game wants its buffer to
// go STRAIGHT to the display plane; its GPU timeline should directly
// signal the display engine's frame-latch cell (G1.M1 wired the seam
// already). What P7 demands is that direct-scanout be the DEFAULT for
// fullscreen -- not a compositor opt-in -- and P8 demands the plane
// on pipe 0 stay reserved for the recovery console even under lease
// pressure.
//
// A capability names the authority so both properties are expressible
// as row-table invariants rather than compositor policy. Naming the
// range as a lease -- not a permanent grant -- also lets P8 be
// enforced without a special-case: the compositor never has to
// negotiate with a client for plane 0; the row-scan REFUSES to hand
// out a lease against it.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_DISPLAY_PLANE
// =============================================================================
//
// The gate demands `kind == KIND_DISPLAY_PLANE (0x173)` carrying
// RIGHT_MINT. Because KIND_DISPLAY_PLANE's runtime base is slot 4
// (KIND_MEMORY), the cap_invoke dispatch table matches on the full
// u64 kind field, not the LAM slot -- same discipline every derived-
// on-derived kind in the tree applies (KIND_VRR_RANGE over
// KIND_DISPLAY_MODE, KIND_USB_HUB over KIND_USB_DEVICE, etc.).
//
// The mint additionally requires:
//
//   (a) lease_key non-zero and unique among live rows (NO_KEY /
//       IN_USE)
//   (b) plane_slot names a live KIND_DISPLAY_PLANE (0x173) with
//       RIGHT_MINT (BAD_PLANE)
//   (c) output_slot fits u8; 0 is refused (a lease without an output
//       is not a live lease) (BAD_OUTPUT)
//   (d) timeline_slot fits u8; 0 is refused (a lease without a
//       timeline degrades to implicit sync, which P1 forbids)
//       (BAD_TIMELINE)
//   (e) lease_ns_expiry non-zero (BAD_EXPIRY); the zero value means
//       "no expiry" and is refused for the same reason the R44
//       compositor cannot hand out an infinite grant -- G2.M3-002
//       (#1454) demands the row hold a deadline so the compositor
//       can recover a hung client's plane
//   (f) plane_slot is NOT the reserved-plane row (P8, G2.M1-005
//       #1447). Pipe 0's primary plane is reserved for the recovery
//       console; a mint that names it returns RESERVED_PLANE rather
//       than silently succeeding
//   (g) rights subset of R_SL_ALL (R_MINT ABSENT -- leaf kind)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  lease_key (u64)
//   [+16] body1:   output_slot[7:0] | timeline_slot[15:8]
//                | plane_key_hi16[31:16] | plane_slot[47:32]
//                | state[55:48] | reserved[63:56]
//   [+24] lease_ns_expiry (u64, absolute deadline in HPET ns)
//
// state ordinals live in body1[55:48]:
//   SL_STATE_GRANTED  = 1  fresh lease, client may present
//   SL_STATE_REVOKED  = 2  compositor has withdrawn (G2.M1-004)
//   SL_STATE_EXPIRED  = 3  expiry safety-net fired (G2.M3-002)
//
// The state ordinal is the ONE mutable field. Every other identity
// field is frozen at mint. The revocation and expiry paths in
// drivers/dpy/scanout.pdx are the two writers; tools/build.sh
// confines the table symbol to those two files plus this one.
//
// =============================================================================
// SECTION 3  LEAF OF THE SCANOUT LATTICE
// =============================================================================
//
// R_SL_MINT (0x200) is DELIBERATELY ABSENT from R_SL_ALL: no cap in
// this tree derives from a KIND_SCANOUT_LEASE. Same discipline every
// leaf kind applies. The compositor and scanout driver read the row
// through sl_row_* accessors and do NOT mint further children.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFF611..0xFFFFF61D (SHARED SUB-BAND)
// =============================================================================
//
// Shared with cache_policy.pdx (which owns 0xFFFFF610, 0xFFFFF61E,
// 0xFFFFF61F as taxonomy boundary markers -- CPOL_BAD_ARG /
// CPOL_BAD_POLICY / band-declaration constants); KIND_SCANOUT_LEASE
// takes the interior sub-band 0xFFFFF611..0xFFFFF61D. The G2 milestone
// documents this share in design/architecture/next-wave-derived-
// kinds.md; the pattern is the same one R47 established when
// nvme_bridge and nvme_isolation split 0xFFFFFD90..0xFFFFFD9F.

module KindScanoutLease = structure {

  pub let KIND_SCANOUT_LEASE : u64 = 0x188
  pub let SL_PARENT_KIND     : u64 = 0x173               // = KIND_DISPLAY_PLANE

  // Reserved-plane slot (P8). Pipe 0's primary plane is reserved for
  // the recovery console; a lease that names it is refused. The
  // reserved slot is a compile-time constant here rather than a
  // dynamic registration so the mint refuses without an extra
  // registry read.
  pub let SL_RESERVED_PLANE_SLOT : u64 = 0

  // Lease state ordinals.
  pub let SL_STATE_GRANTED : u64 = 1
  pub let SL_STATE_REVOKED : u64 = 2
  pub let SL_STATE_EXPIRED : u64 = 3
  pub let SL_STATE_MAX     : u64 = 3

  // Rights. R_MINT (0x200) NOT in the mask (leaf).
  pub let R_SL_READ    : u64 = 0x001
  pub let R_SL_INVOKE  : u64 = 0x008
  pub let R_SL_REVOKE  : u64 = 0x010
  pub let R_SL_OBSERVE : u64 = 0x400
  pub let R_SL_ALL     : u64 = 0x419

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED.
  pub let SL_OP_QUERY_KEY      : u64 = 0
  pub let SL_OP_QUERY_PLANE    : u64 = 1
  pub let SL_OP_QUERY_OUTPUT   : u64 = 2
  pub let SL_OP_QUERY_TIMELINE : u64 = 3
  pub let SL_OP_QUERY_EXPIRY   : u64 = 4
  pub let SL_OP_QUERY_STATE    : u64 = 5
  pub let SL_OP_DEBUG_PRINT    : u64 = 6
  pub let SL_OP_MAX            : u64 = 6

  // Failure taxonomy -- 0xFFFFF611..0xFFFFF61D (SHARED SUB-BAND with
  // cache_policy; see §4 above). Every code is disjoint from
  // cache_policy's 0xFFFFF610 / 0xFFFFF61E / 0xFFFFF61F and from every
  // other kind/driver band verified at repo-grep time.
  pub let SL_OK               : u64 = 0
  pub let SL_TAIL_ENOSPC      : u64 = 0xFFFFF61D
  pub let SL_TAIL_BAD_ARG     : u64 = 0xFFFFF61C
  pub let SL_MINT_BAD_PARENT  : u64 = 0xFFFFF61B
  pub let SL_MINT_BAD_RIGHTS  : u64 = 0xFFFFF61A
  pub let SL_MINT_BAD_PLANE   : u64 = 0xFFFFF619
  pub let SL_MINT_BAD_OUTPUT  : u64 = 0xFFFFF618
  pub let SL_MINT_BAD_TIMELINE: u64 = 0xFFFFF617
  pub let SL_MINT_BAD_EXPIRY  : u64 = 0xFFFFF616
  pub let SL_MINT_RESERVED    : u64 = 0xFFFFF615
  pub let SL_MINT_NO_KEY      : u64 = 0xFFFFF614
  pub let SL_MINT_IN_USE      : u64 = 0xFFFFF613
  pub let SL_BAD_SLOT         : u64 = 0xFFFFF612
  pub let SL_WRONG_KIND       : u64 = 0xFFFFF611

  pub let SL_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let SL_ROW_NONE   : u64 = 0xFF

  pub let SL_MAX       : u64 = 8
  pub let SL_ROW_BYTES : u64 = 32

  // THE ONE STATE CELL. Confined to this object plus
  // drivers/dpy/scanout.pdx by tools/build.sh.
  pub let mut _scanout_lease_table : [u64; 32] = uninit @align(64)
  pub let mut _scanout_lease_stats : [u64; 4]  = uninit @align(64)

  pub let SL_ST_MINTS   : u64 = 0
  pub let SL_ST_REVOKES : u64 = 1
  pub let SL_ST_REFUSED : u64 = 2
  pub let SL_ST_QUERIES : u64 = 3

  pub let sl_dbg_msg : [u8; 19] = "SCANOUT LEASE ROW\0\0"

  pub let sl_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): clear the SCANOUT LEASE row table + counters. Boot and teardown only. Labels prefixed sl_rs_.",
      block: {
        lea r10, [rip + _scanout_lease_table];
        xor rax, rax;
        xor rcx, rcx;
      sl_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  sl_rs_rows;

        lea r10, [rip + _scanout_lease_stats];
        xor rcx, rcx;
      sl_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  sl_rs_stats;
        ret
      }
    }

  pub let sl_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): counter bump. Labels prefixed sl_nt_.",
      block: {
        cmp rdi, 4;
        jae sl_nt_out;
        lea r10, [rip + _scanout_lease_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sl_nt_out:
        ret
      }
    }

  pub let sl_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): counter read.",
      block: {
        cmp rdi, 4;
        jae sl_st_zero;
        lea r10, [rip + _scanout_lease_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sl_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let sl_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-001 (#1443): subset test against R_SL_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask (leaf). Labels prefixed sl_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne sl_rv_no;
        mov rax, 1;
        ret;
      sl_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let sl_output_valid : (u64) -> u64 !{} @{} =
    fn (output_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-001 (#1443): 1 iff 0 < output_slot <= 0xFF. Labels prefixed sl_ov_.",
      block: {
        cmp rdi, 0;
        je  sl_ov_no;
        cmp rdi, 0xFF;
        ja  sl_ov_no;
        mov rax, 1;
        ret;
      sl_ov_no:
        xor rax, rax;
        ret
      }
    }

  pub let sl_timeline_valid : (u64) -> u64 !{} @{} =
    fn (timeline_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-001 (#1443) + P1: 1 iff 0 < timeline_slot <= 0xFF. Zero refused -- a lease without a timeline degrades to implicit sync, which P1 forbids. Labels prefixed sl_tlv_.",
      block: {
        cmp rdi, 0;
        je  sl_tlv_no;
        cmp rdi, 0xFF;
        ja  sl_tlv_no;
        mov rax, 1;
        ret;
      sl_tlv_no:
        xor rax, rax;
        ret
      }
    }

  pub let sl_expiry_valid : (u64) -> u64 !{} @{} =
    fn (expiry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-001 (#1443) + G2.M3-002 (#1454): 1 iff expiry != 0. A zero expiry means 'no deadline' and is refused; the safety-net auto-revoke path REQUIRES a deadline to compare hpet_now_ns against. Labels prefixed sl_ev_.",
      block: {
        cmp rdi, 0;
        je  sl_ev_no;
        mov rax, 1;
        ret;
      sl_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let sl_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-001 (#1443): 1 iff state in {1,2,3}. Labels prefixed sl_sv_.",
      block: {
        cmp rdi, 1;
        jb  sl_sv_no;
        cmp rdi, 3;
        ja  sl_sv_no;
        mov rax, 1;
        ret;
      sl_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let sl_reserved_plane : (u64) -> u64 !{} @{} =
    fn (plane_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-005 (#1447) + P8: 1 iff plane_slot == SL_RESERVED_PLANE_SLOT (0). The compositor cannot claim it. Labels prefixed sl_rp_.",
      block: {
        cmp rdi, 0;
        je  sl_rp_yes;
        xor rax, rax;
        ret;
      sl_rp_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free / accessors.
  //
  // THE ONE WRITER of _scanout_lease_table (plus drivers/dpy/scanout.
  // pdx for state transitions). tools/build.sh confines relocations
  // against `_scanout_lease_table` to those two files.
  // ==========================================================================

  pub let sl_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (output_slot: u64) (timeline_slot: u64) (plane_slot: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-001 (#1443): pack body1: output_slot[7:0] | timeline_slot[15:8] | reserved[31:16] | plane_slot[47:32] | state[55:48]. Every out-of-range field returns DECODE_BAD rather than silently masking. Labels prefixed sl_b1_.",
      block: {
        cmp rdi, 0xFF;
        ja  sl_b1_bad;
        cmp rsi, 0xFF;
        ja  sl_b1_bad;
        cmp rdx, 0xFFFF;
        ja  sl_b1_bad;
        cmp rcx, 0xFF;
        ja  sl_b1_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      sl_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sl_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M1-001 (#1443): (parent_slot << 8). Labels prefixed sl_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae sl_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      sl_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sl_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (lease_key: u64) (body1: u64) (expiry_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): claim one SCANOUT LEASE row. THE ONE WRITER of _scanout_lease_table. Gates: hdr in_use pre-set -> BAD_ARG; lease_key != 0 -> BAD_ARG; body1 != DECODE_BAD -> BAD_ARG; expiry != 0 -> BAD_ARG. Low-first free scan across SL_MAX=8 rows. Labels prefixed sl_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne sl_ta_bad;
        cmp r13, 0;
        je  sl_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  sl_ta_bad;
        cmp r15, 0;
        je  sl_ta_bad;

        xor rbx, rbx;
      sl_ta_scan:
        cmp rbx, 8;
        jae sl_ta_enospc;
        lea r10, [rip + _scanout_lease_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sl_ta_claim;
        add rbx, 1;
        jmp sl_ta_scan;

      sl_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp sl_ta_out;

      sl_ta_enospc:
        mov rax, 0xFFFFF61D;
        jmp sl_ta_out;
      sl_ta_bad:
        mov rax, 0xFFFFF61C;

      sl_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sl_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): 1 iff row_id < SL_MAX and in_use. Labels prefixed sl_tv_.",
      block: {
        cmp rdi, 8;
        jae sl_tv_no;
        lea r10, [rip + _scanout_lease_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sl_tv_no;
        mov rax, 1;
        ret;
      sl_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let sl_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): scrub one row. Labels prefixed sl_tf_.",
      block: {
        cmp rdi, 8;
        jae sl_tf_out;
        lea r10, [rip + _scanout_lease_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      sl_tf_out:
        ret
      }
    }

  pub let sl_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): lease_key.",
      block: {
        push r12;
        mov r12, rdi;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_rk_bad;
        lea r10, [rip + _scanout_lease_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp sl_rk_out;
      sl_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sl_rk_out:
        pop r12;
        ret
      }
    }

  pub let sl_row_output : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): output_slot at body1[7:0].",
      block: {
        push r12;
        mov r12, rdi;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_ro_bad;
        lea r10, [rip + _scanout_lease_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp sl_ro_out;
      sl_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sl_ro_out:
        pop r12;
        ret
      }
    }

  pub let sl_row_timeline : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): timeline_slot at body1[15:8].",
      block: {
        push r12;
        mov r12, rdi;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_rt_bad;
        lea r10, [rip + _scanout_lease_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFF;
        jmp sl_rt_out;
      sl_rt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sl_rt_out:
        pop r12;
        ret
      }
    }

  pub let sl_row_plane : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): plane_slot at body1[47:32].",
      block: {
        push r12;
        mov r12, rdi;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_rp_bad;
        lea r10, [rip + _scanout_lease_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp sl_rp_out;
      sl_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sl_rp_out:
        pop r12;
        ret
      }
    }

  pub let sl_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): state at body1[55:48].",
      block: {
        push r12;
        mov r12, rdi;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_rst_bad;
        lea r10, [rip + _scanout_lease_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp sl_rst_out;
      sl_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sl_rst_out:
        pop r12;
        ret
      }
    }

  pub let sl_row_expiry : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): lease_ns_expiry at body2.",
      block: {
        push r12;
        mov r12, rdi;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_rex_bad;
        lea r10, [rip + _scanout_lease_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp sl_rex_out;
      sl_rex_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sl_rex_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sl_row_transition(row_id, new_state) -> OK | BAD_ARG
  //
  // The ONE state-transition primitive exported to the scanout driver.
  // Refuses any transition that is not GRANTED -> REVOKED or
  // GRANTED -> EXPIRED. tools/build.sh authorises drivers/dpy/scanout.o
  // to relocate against _scanout_lease_table via THIS symbol only.
  // ==========================================================================
  pub let sl_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-004 (#1446) + G2.M3-002 (#1454): mutate body1[55:48] to new_state. Refuses invalid new_state, non-live row, or a transition out of a non-GRANTED starting state. Labels prefixed sl_rtr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r13;
        call sl_state_valid;
        cmp rax, 0;
        je  sl_rtr_bad;

        mov rdi, r12;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_rtr_bad;

        // Only GRANTED (1) may transition to REVOKED (2) or EXPIRED
        // (3). Any other transition is refused so an already-revoked
        // row cannot be re-revoked or downgraded.
        mov rdi, r12;
        call sl_row_state;
        cmp rax, 1;
        jne sl_rtr_bad;

        lea rbx, [rip + _scanout_lease_table];
        mov r11, r12;
        shl r11, 5;
        add rbx, r11;
        mov rax, [rbx + 16];
        // Clear body1[55:48].
        mov r10, 0xFF;
        shl r10, 48;
        not r10;
        and rax, r10;
        // Set new state.
        mov r10, r13;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov [rbx + 16], rax;

        xor rax, rax;
        jmp sl_rtr_out;

      sl_rtr_bad:
        mov rax, 0xFFFFF61C;

      sl_rtr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sl_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (lease_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-001 (#1443): live row holding this lease_key, or ROW_NONE. Labels prefixed sl_fk_.",
      block: {
        cmp rdi, 0;
        je  sl_fk_none;
        xor rcx, rcx;
      sl_fk_scan:
        cmp rcx, 8;
        jae sl_fk_none;
        lea r10, [rip + _scanout_lease_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sl_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  sl_fk_hit;
      sl_fk_next:
        add rcx, 1;
        jmp sl_fk_scan;
      sl_fk_hit:
        mov rax, rcx;
        ret;
      sl_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  // Scan the row table for a lease that names this plane_slot. Used
  // by the grant path (G2.M1-003 #1445) to refuse a second lease
  // against a plane a client already holds, and by the driver's
  // revoke_by_plane path (G2.M1-004 #1446).
  pub let sl_find_by_plane : (u64) -> u64 !{mem} @{} =
    fn (plane_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-003 (#1445) + G2.M1-004 (#1446): live row whose plane_slot matches, or ROW_NONE. Labels prefixed sl_fp_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;
        xor r12, r12;
      sl_fp_scan:
        cmp r12, 8;
        jae sl_fp_none;
        mov rdi, r12;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_fp_next;
        mov rdi, r12;
        call sl_row_plane;
        cmp rax, rbx;
        je  sl_fp_hit;
      sl_fp_next:
        add r12, 1;
        jmp sl_fp_scan;
      sl_fp_hit:
        mov rax, r12;
        jmp sl_fp_out;
      sl_fp_none:
        mov rax, 0xFF;
      sl_fp_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sl_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-001 (#1443): slot -> row_id, gated on live KIND_SCANOUT_LEASE. Labels prefixed sl_ros_.",
      block: {
        push r12;
        mov r11, 256;
        cmp rdi, r11;
        jae sl_ros_none;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x188;
        cmp r10, r11;
        jne sl_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_ros_none;
        mov rax, r12;
        jmp sl_ros_out;
      sl_ros_none:
        mov rax, 0xFF;
      sl_ros_out:
        pop r12;
        ret
      }
    }

  pub let sl_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-001 (#1443): §1 gate. parent must be live KIND_DISPLAY_PLANE (0x173) with RIGHT_MINT. Labels prefixed sl_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae sl_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x173;                  // KIND_DISPLAY_PLANE
        cmp r10, r11;
        jne sl_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  sl_cp_no;

        mov rax, 1;
        ret;
      sl_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Mint. Seven-arg mint API. Because paideia-as caps at 6 args, we
  // split (output_slot, timeline_slot, plane_slot) into a single
  // packed_slots u64:
  //   [7:0]   output_slot
  //   [15:8]  timeline_slot
  //   [47:32] plane_slot
  //
  // (This mirrors sl_body1_pack's contract; the state and expiry are
  // separate args.)
  // ==========================================================================

  pub let sl_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (lease_key: u64) (packed_slots: u64) (expiry_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-001..005 (#1443-#1447): mint KIND_SCANOUT_LEASE over KIND_DISPLAY_PLANE. Sequence: slot < 256; check_parent; rights_valid; unpack + validate output/timeline/plane; expiry_valid; reserved-plane refuse (P8); lease_key != 0; uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed sl_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // lease_key
        mov r15, r8;                     // packed_slots
        mov rbp, r9;                     // expiry_ns

        mov r10, 256;
        cmp rbx, r10;
        jae sl_mi_bad_slot;

        mov rdi, r12;
        call sl_check_parent;
        cmp rax, 0;
        je  sl_mi_bad_parent;

        mov rdi, r13;
        call sl_rights_valid;
        cmp rax, 0;
        je  sl_mi_bad_rights;

        // Unpack + validate output_slot.
        mov rdi, r15;
        and rdi, 0xFF;
        call sl_output_valid;
        cmp rax, 0;
        je  sl_mi_bad_output;

        // Unpack + validate timeline_slot.
        mov rdi, r15;
        shr rdi, 8;
        and rdi, 0xFF;
        call sl_timeline_valid;
        cmp rax, 0;
        je  sl_mi_bad_timeline;

        // Unpack plane_slot; refuse reserved (P8).
        mov rdi, r15;
        shr rdi, 32;
        and rdi, 0xFFFF;
        call sl_reserved_plane;
        cmp rax, 1;
        je  sl_mi_reserved;

        // Validate expiry.
        mov rdi, rbp;
        call sl_expiry_valid;
        cmp rax, 0;
        je  sl_mi_bad_expiry;

        cmp r14, 0;
        je  sl_mi_no_key;

        mov rdi, r14;
        call sl_find_by_key;
        cmp rax, 0xFF;
        jne sl_mi_in_use;

        // Pack body1 with state=GRANTED (1).
        mov rdi, r15;
        and rdi, 0xFF;                   // output_slot
        mov rsi, r15;
        shr rsi, 8;
        and rsi, 0xFF;                   // timeline_slot
        mov rdx, r15;
        shr rdx, 32;
        and rdx, 0xFFFF;                 // plane_slot
        mov rcx, 1;                      // SL_STATE_GRANTED
        call sl_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  sl_mi_bad_output;
        mov r15, rax;                    // body1 (r15 reused)

        mov rdi, r12;
        call sl_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  sl_mi_bad_parent;

        // tail_alloc(hdr, lease_key, body1, expiry).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r15;
        mov rcx, rbp;
        call sl_tail_alloc;

        mov r10, 0xFFFFF61D;             // ENOSPC
        cmp rax, r10;
        je  sl_mi_enospc;
        mov r10, 0xFFFFF61C;             // BAD_ARG
        cmp rax, r10;
        je  sl_mi_bad_output;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x188;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call sl_note;

        xor rax, rax;
        jmp sl_mi_out;

      sl_mi_bad_slot:
        mov rax, 0xFFFFF612;
        jmp sl_mi_out;
      sl_mi_bad_parent:
        mov rax, 0xFFFFF61B;
        jmp sl_mi_out;
      sl_mi_bad_rights:
        mov rax, 0xFFFFF61A;
        jmp sl_mi_out;
      sl_mi_bad_output:
        mov rax, 0xFFFFF618;
        jmp sl_mi_out;
      sl_mi_bad_timeline:
        mov rax, 0xFFFFF617;
        jmp sl_mi_out;
      sl_mi_bad_expiry:
        mov rax, 0xFFFFF616;
        jmp sl_mi_out;
      sl_mi_reserved:
        mov rdi, 2;
        call sl_note;
        mov rax, 0xFFFFF615;
        jmp sl_mi_out;
      sl_mi_no_key:
        mov rax, 0xFFFFF614;
        jmp sl_mi_out;
      sl_mi_in_use:
        mov rdi, 2;
        call sl_note;
        mov rax, 0xFFFFF613;
        jmp sl_mi_out;
      sl_mi_enospc:
        mov rdi, 2;
        call sl_note;
        mov rax, 0xFFFFF61D;

      sl_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sl_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-004 (#1446): revoke KIND_SCANOUT_LEASE. Frees the row and clears the descriptor. Labels prefixed sl_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae sl_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  sl_rvk_already;

        mov r11, 0x188;
        cmp r10, r11;
        jne sl_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call sl_tail_valid;
        cmp rax, 0;
        je  sl_rvk_clear;

        mov rdi, r13;
        call sl_tail_free;

      sl_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call sl_note;

        xor rax, rax;
        jmp sl_rvk_out;

      sl_rvk_bad_slot:
        mov rax, 0xFFFFF612;
        jmp sl_rvk_out;
      sl_rvk_wrong_kind:
        mov rax, 0xFFFFF611;
        jmp sl_rvk_out;
      sl_rvk_already:
        mov rax, 0xFFFFF611;

      sl_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cap_handler_scanout_lease : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G2.M1-001 (#1443): KIND_SCANOUT_LEASE dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed sl_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_scanout_lease_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne sl_hn_res;

        cmp rbp, 6;
        ja  sl_hn_unsup;

        cmp rbp, 6;
        je  sl_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  sl_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  sl_hn_key;
        cmp rbp, 1;
        je  sl_hn_plane;
        cmp rbp, 2;
        je  sl_hn_output;
        cmp rbp, 3;
        je  sl_hn_timeline;
        cmp rbp, 4;
        je  sl_hn_expiry;
        call sl_row_state;
        jmp sl_hn_out;

      sl_hn_key:
        call sl_row_key;
        jmp sl_hn_out;
      sl_hn_plane:
        call sl_row_plane;
        jmp sl_hn_out;
      sl_hn_output:
        call sl_row_output;
        jmp sl_hn_out;
      sl_hn_timeline:
        call sl_row_timeline;
        jmp sl_hn_out;
      sl_hn_expiry:
        call sl_row_expiry;
        jmp sl_hn_out;

      sl_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  sl_hn_denied;
        xor rax, rax;
        jmp sl_hn_out;

      sl_hn_res:
        mov rax, 0xFFFFF61C;
        jmp sl_hn_out;
      sl_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp sl_hn_out;
      sl_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      sl_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
