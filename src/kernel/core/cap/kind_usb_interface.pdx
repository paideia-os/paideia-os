// src/kernel/core/cap/kind_usb_interface.pdx — R34.M2-001 (#1172)
//
// KIND_USB_INTERFACE = 0x164, derived over KIND_USB_DEVICE (0x162).
//
// The authority to hold ONE USB interface's static identity — its
// inherited interface_key (a fresh identity supplied by the class
// driver), the interface_number (bInterfaceNumber, USB 2.0 §9.6.5),
// the alt_setting (bAlternateSetting), and the three USB-IF class
// ordinals (bInterfaceClass, bInterfaceSubClass, bInterfaceProtocol).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A USB DEVICE is one physical part; a USB INTERFACE is one FUNCTION
// exposed by that part. A composite device (a laptop's fingerprint
// reader plus its camera, or a headset's audio-plus-microphone plus
// its HID buttons) presents SEVERAL interfaces from a SINGLE device
// address. The interface-per-driver rule (see
// drivers/usb/composite_bind.pdx) says one class driver binds to one
// interface — so the CAPABILITY at which driver-binding decisions are
// gated has to be the INTERFACE, not the DEVICE. That is this kind.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS ABSENT
// =============================================================================
//
// Same discipline as kind_usb_hub.pdx §1. interface_key,
// interface_number, alt_setting, class, subclass and protocol are ROW
// IDENTITY and refused to a mint that supplies implausible values.
// There is NO dynamic state on this row: alt-setting SWITCHING is a
// separate operation the class driver performs by REVOKING one
// KIND_USB_INTERFACE and MINTING another over the same USB device,
// which is what keeps alt_setting fixed for the life of a single
// capability. An interface whose alt_setting could be re-stamped in
// place would silently reroute all endpoint capabilities minted under
// its old bandwidth budget.
//
// =============================================================================
// §2  DERIVATION OVER KIND_USB_DEVICE
// =============================================================================
//
// The gate demands `kind == KIND_USB_DEVICE (0x162)` carrying
// `RIGHT_MINT`. Like KIND_USB_HUB (which derives over the same
// parent), the first half is the intermediate USB-device authority
// that proves the enumerator negotiated an address. Without it, any
// PCI holder could claim to have enumerated an interface on a device
// that was never addressed on the bus.
//
// SECOND HALF: (a) inherited device_key from the parent USB device
// row must be non-zero (NO_DEVICE); (b) interface_number in [0, 31]
// (BAD_IFNUM — USB spec caps bInterfaceNumber at 31 for practical
// composite devices; a class driver reporting a number above that is
// misreading the descriptor); (c) alt_setting in [0, 15] (BAD_ALT —
// same reasoning); (d) rights are a subset of R_USB_IF_ALL
// (BAD_RIGHTS); (e) interface_key is non-zero and unique among all
// live rows (IN_USE).
//
// =============================================================================
// §3  KIND_USB_ENDPOINT DERIVES OVER THIS KIND (indirectly)
// =============================================================================
//
// A USB endpoint capability is derived over a KIND_IPC_ENDPOINT (the
// place the class driver will receive completions on), with a SECOND
// capability argument naming the KIND_USB_INTERFACE that establishes
// this endpoint belongs to this interface. This is the same two-cap
// derivation pattern KIND_EC_QUERY uses over KIND_IPC_ENDPOINT +
// KIND_OP_REGION: the endpoint half is where events arrive, the
// interface half is what the events are ABOUT.
//
// R_USB_IF_MINT (0x200) IS PART OF THE MASK because this kind is a
// NON-LEAF: endpoint mints demand it.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFFBB0..0xFFFFFBBF
// =============================================================================
//
// Sixteen-wide band disjoint from KIND_USB_DEVICE (0xFFFFFDE0..EF),
// KIND_USB_HUB (0xFFFFFEF0..FF), and every other kind in the tree.
// NOT 0xFFFFFDF0..FF: that band is drivers/hid/gestures.pdx's declared
// (not yet consumed) reservation (see gestures.pdx §5), so this kind
// takes 0xFFFFFBB0..BF instead — free territory adjacent to this
// milestone's own composite_bind.pdx (0xFFFFFB80..8F) and
// interface_parser.pdx (0xFFFFFB90..9F) bands.

module KindUsbInterface = structure {

  pub let KIND_USB_INTERFACE        : u64 = 0x164
  pub let USB_INTERFACE_PARENT_KIND : u64 = 0x162   // = KIND_USB_DEVICE

  // §2 bounds.
  pub let USB_IF_NUM_MIN : u64 = 0
  pub let USB_IF_NUM_MAX : u64 = 31
  pub let USB_IF_ALT_MIN : u64 = 0
  pub let USB_IF_ALT_MAX : u64 = 15

  // Rights. RIGHT_MINT (0x200) IN the mask — non-leaf (§3).
  pub let R_USB_IF_READ    : u64 = 0x001
  pub let R_USB_IF_INVOKE  : u64 = 0x008
  pub let R_USB_IF_REVOKE  : u64 = 0x010
  pub let R_USB_IF_MINT    : u64 = 0x200
  pub let R_USB_IF_OBSERVE : u64 = 0x400
  pub let R_USB_IF_ALL     : u64 = 0x619

  // Ops (op_arg[7:0]):
  pub let USBIF_OP_QUERY_KEY      : u64 = 0
  pub let USBIF_OP_QUERY_IF_NUM   : u64 = 1
  pub let USBIF_OP_QUERY_ALT      : u64 = 2
  pub let USBIF_OP_QUERY_CLASS    : u64 = 3
  pub let USBIF_OP_QUERY_SUBCLASS : u64 = 4
  pub let USBIF_OP_QUERY_PROTOCOL : u64 = 5
  pub let USBIF_OP_QUERY_PARENT   : u64 = 6
  pub let USBIF_OP_DEBUG_PRINT    : u64 = 7
  pub let USBIF_OP_MAX            : u64 = 7

  // Failure taxonomy — 0xFFFFFBB0..0xFFFFFBBF.
  pub let USBIF_OK                 : u64 = 0
  pub let USBIF_TAIL_ENOSPC        : u64 = 0xFFFFFBBF
  pub let USBIF_TAIL_BAD_ARG       : u64 = 0xFFFFFBBE
  pub let USBIF_MINT_BAD_PARENT    : u64 = 0xFFFFFBBD
  pub let USBIF_MINT_BAD_RIGHTS    : u64 = 0xFFFFFBBC
  pub let USBIF_MINT_BAD_IFNUM     : u64 = 0xFFFFFBBB
  pub let USBIF_MINT_BAD_ALT       : u64 = 0xFFFFFBBA
  pub let USBIF_MINT_NO_DEVICE     : u64 = 0xFFFFFBB9
  pub let USBIF_MINT_ENOSPC        : u64 = 0xFFFFFBB8
  pub let USBIF_MINT_IN_USE        : u64 = 0xFFFFFBB7
  pub let USBIF_BAD_SLOT           : u64 = 0xFFFFFBB6
  pub let USBIF_WRONG_KIND         : u64 = 0xFFFFFBB5
  pub let USBIF_REVOKE_ALREADY     : u64 = 0xFFFFFBB4

  pub let USBIF_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let USBIF_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  interface_key
  //   [+16] body: ifnum[7:0] | alt[15:8] | class[23:16] |
  //               subclass[31:24] | protocol[39:32]
  //   [+24] reserved
  pub let USBIF_MAX       : u64 = 16
  pub let USBIF_ROW_BYTES : u64 = 32

  pub let mut _usb_interface_table : [u64; 64] = uninit @align(64)
  pub let mut _usb_interface_stats : [u64; 4]  = uninit @align(64)

  pub let USBIF_ST_MINTS   : u64 = 0
  pub let USBIF_ST_REVOKES : u64 = 1
  pub let USBIF_ST_IN_USE  : u64 = 2
  pub let USBIF_ST_ENOSPC  : u64 = 3

  // R51 boot-transcript §5 Bug B: strip embedded '\n' (composer emits its own).
  pub let usbif_dbg_msg : [u8; 13] = "USB IF ROW\0\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let usb_interface_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): clear the USB interface row table and its counters. Boot and teardown only. Labels prefixed usbif_rs_.",
      block: {
        lea r10, [rip + _usb_interface_table];
        xor rax, rax;
        xor rcx, rcx;
      usbif_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  usbif_rs_rows;

        lea r10, [rip + _usb_interface_stats];
        xor rcx, rcx;
      usbif_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  usbif_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let usb_interface_ifnum_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-001 (#1172): 1 iff n <= 31. Labels prefixed usbif_iv_.",
      block: {
        cmp rdi, 31;
        ja  usbif_iv_no;
        mov rax, 1;
        ret;
      usbif_iv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_interface_alt_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-001 (#1172): 1 iff a <= 15. Labels prefixed usbif_av_.",
      block: {
        cmp rdi, 15;
        ja  usbif_av_no;
        mov rax, 1;
        ret;
      usbif_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_interface_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-001 (#1172): subset test against R_USB_IF_ALL. Labels prefixed usbif_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne usbif_rv_no;
        mov rax, 1;
        ret;
      usbif_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let usb_interface_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): counter bump. Labels prefixed usbif_nt_.",
      block: {
        cmp rdi, 4;
        jae usbif_nt_out;
        lea r10, [rip + _usb_interface_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      usbif_nt_out:
        ret
      }
    }

  pub let usb_interface_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): counter read. Labels prefixed usbif_st_.",
      block: {
        cmp rdi, 4;
        jae usbif_st_zero;
        lea r10, [rip + _usb_interface_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      usbif_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_USB_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let usb_interface_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): parent must be live KIND_USB_DEVICE (0x162) with RIGHT_MINT. §2's gate. Labels prefixed usbif_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae usbif_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x162;                  // KIND_USB_DEVICE
        cmp r10, r11;
        jne usbif_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  usbif_cp_no;

        mov rax, 1;
        ret;
      usbif_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_interface_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): parent USB device row's device_key, or 0. Labels prefixed usbif_pk_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;

        mov r11, 256;
        cmp r12, r11;
        jae usbif_pk_zero;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x162;
        cmp r10, r11;
        jne usbif_pk_zero;

        mov r13, [rax + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // parent's usb_device row_id

        mov rdi, r13;
        call usb_device_row_key;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbif_pk_zero;
        jmp usbif_pk_out;

      usbif_pk_zero:
        xor rax, rax;
      usbif_pk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let usb_interface_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-001 (#1172): (parent_slot << 8). Labels prefixed usbif_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae usbif_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      usbif_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_interface_body_pack : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (ifnum: u64) (alt: u64) (class: u64) (subclass: u64) (protocol: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-001 (#1172): pack ifnum[7:0] | alt[15:8] | class[23:16] | subclass[31:24] | protocol[39:32]. Refuses out-of-range ifnum/alt. Class/subclass/protocol are single bytes each. Labels prefixed usbif_bp_.",
      block: {
        cmp rdi, 31;
        ja  usbif_bp_bad;
        cmp rsi, 15;
        ja  usbif_bp_bad;
        cmp rdx, 255;
        ja  usbif_bp_bad;
        cmp rcx, 255;
        ja  usbif_bp_bad;
        cmp r8, 255;
        ja  usbif_bp_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        mov r10, r8;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      usbif_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/free/valid.
  // ==========================================================================

  pub let usb_interface_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (interface_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): claim one USB interface row. THE ONE WRITER of _usb_interface_table. Labels prefixed usbif_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // interface_key
        mov r14, rdx;                    // body_packed

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne usbif_ta_bad;

        cmp r13, 0;
        je  usbif_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  usbif_ta_bad;

        xor rbx, rbx;
      usbif_ta_scan:
        cmp rbx, 16;
        jae usbif_ta_enospc;

        lea r10, [rip + _usb_interface_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbif_ta_claim;

        add rbx, 1;
        jmp usbif_ta_scan;

      usbif_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp usbif_ta_out;

      usbif_ta_enospc:
        mov rax, 0xFFFFFBBF;
        jmp usbif_ta_out;
      usbif_ta_bad:
        mov rax, 0xFFFFFBBE;

      usbif_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_interface_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): 1 iff row_id < MAX and in_use. Labels prefixed usbif_tv_.",
      block: {
        cmp rdi, 16;
        jae usbif_tv_no;
        lea r10, [rip + _usb_interface_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbif_tv_no;
        mov rax, 1;
        ret;
      usbif_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_interface_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): scrub one row. Labels prefixed usbif_tf_.",
      block: {
        cmp rdi, 16;
        jae usbif_tf_out;
        lea r10, [rip + _usb_interface_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      usbif_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let usb_interface_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): interface_key. Labels prefixed usbif_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_rk_bad;
        lea r10, [rip + _usb_interface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp usbif_rk_out;
      usbif_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbif_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_interface_row_ifnum : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): interface_number. Labels prefixed usbif_ri_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_ri_bad;
        lea r10, [rip + _usb_interface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp usbif_ri_out;
      usbif_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbif_ri_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_interface_row_alt : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): alt_setting. Labels prefixed usbif_ra_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_ra_bad;
        lea r10, [rip + _usb_interface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFF;
        jmp usbif_ra_out;
      usbif_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbif_ra_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_interface_row_class : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): class. Labels prefixed usbif_rc_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_rc_bad;
        lea r10, [rip + _usb_interface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFF;
        jmp usbif_rc_out;
      usbif_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbif_rc_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_interface_row_subclass : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): subclass. Labels prefixed usbif_rsc_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_rsc_bad;
        lea r10, [rip + _usb_interface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 24;
        and rax, 0xFF;
        jmp usbif_rsc_out;
      usbif_rsc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbif_rsc_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_interface_row_protocol : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): protocol. Labels prefixed usbif_rp_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_rp_bad;
        lea r10, [rip + _usb_interface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFF;
        jmp usbif_rp_out;
      usbif_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbif_rp_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_interface_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): parent slot. Labels prefixed usbif_rpa_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_rpa_bad;
        lea r10, [rip + _usb_interface_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp usbif_rpa_out;
      usbif_rpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbif_rpa_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

