  // ==========================================================================
  // Mint.
  // ==========================================================================

  pub let usb_interface_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (interface_key: u64) (packed_ifnum_alt: u64) (packed_class_sc_proto: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): mint a KIND_USB_INTERFACE over a KIND_USB_DEVICE. Six args because SysV has six argument regs and paideia-as does not emit stack-argument prologues; the five USB descriptor fields (ifnum, alt, class, subclass, protocol) are therefore packed into two args (ifnum in [7:0] alt in [15:8]; class in [7:0] subclass in [15:8] protocol in [23:16]). Sequence: (1) slot<256 else BAD_SLOT. (2) check_parent -> BAD_PARENT. (3) rights_valid -> BAD_RIGHTS. (4) ifnum_valid -> BAD_IFNUM. (5) alt_valid -> BAD_ALT. (6) INHERIT device_key from parent, must be non-zero -> NO_DEVICE. (7) UNIQUENESS on interface_key -> IN_USE. (8) hdr_pack + body_pack + tail_alloc. (9) cap_mint_write. Labels prefixed usbif_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // interface_key
        mov r15, r8;                     // packed_ifnum_alt
        mov rbp, r9;                     // packed_class_sc_proto

        mov r10, 256;
        cmp rbx, r10;
        jae usbif_mi_bad_slot;

        mov rdi, r12;
        call usb_interface_check_parent;
        cmp rax, 0;
        je  usbif_mi_bad_parent;

        mov rdi, r13;
        call usb_interface_rights_valid;
        cmp rax, 0;
        je  usbif_mi_bad_rights;

        // Unpack ifnum from r15[7:0], alt from r15[15:8].
        mov rdi, r15;
        and rdi, 0xFF;
        call usb_interface_ifnum_valid;
        cmp rax, 0;
        je  usbif_mi_bad_ifnum;

        mov rdi, r15;
        shr rdi, 8;
        and rdi, 0xFF;
        call usb_interface_alt_valid;
        cmp rax, 0;
        je  usbif_mi_bad_alt;

        cmp r14, 0;
        je  usbif_mi_no_device;

        mov rdi, r12;
        call usb_interface_parent_key;
        cmp rax, 0;
        je  usbif_mi_no_device;

        mov rdi, r14;
        call usb_interface_find_by_key;
        cmp rax, 0xFF;
        jne usbif_mi_in_use;

        // Build body via usb_interface_body_pack.
        mov rdi, r15;
        and rdi, 0xFF;                   // ifnum
        mov rsi, r15;
        shr rsi, 8;
        and rsi, 0xFF;                   // alt
        mov rdx, rbp;
        and rdx, 0xFF;                   // class
        mov rcx, rbp;
        shr rcx, 8;
        and rcx, 0xFF;                   // subclass
        mov r8, rbp;
        shr r8, 16;
        and r8, 0xFF;                    // protocol
        call usb_interface_body_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  usbif_mi_bad_ifnum;
        push rax;                        // body
        sub rsp, 8;

        mov rdi, r12;
        call usb_interface_hdr_pack;
        add rsp, 8;
        pop r10;                         // body
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbif_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // interface_key
        mov rdx, r10;                    // body
        call usb_interface_tail_alloc;

        mov r10, 0xFFFFFBBF;
        cmp rax, r10;
        je  usbif_mi_enospc;
        mov r10, 0xFFFFFBBE;
        cmp rax, r10;
        je  usbif_mi_bad_ifnum;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x164;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call usb_interface_note;

        xor rax, rax;
        jmp usbif_mi_out;

      usbif_mi_bad_slot:
        mov rax, 0xFFFFFBB6;
        jmp usbif_mi_out;
      usbif_mi_bad_parent:
        mov rax, 0xFFFFFBBD;
        jmp usbif_mi_out;
      usbif_mi_bad_rights:
        mov rax, 0xFFFFFBBC;
        jmp usbif_mi_out;
      usbif_mi_bad_ifnum:
        mov rax, 0xFFFFFBBB;
        jmp usbif_mi_out;
      usbif_mi_bad_alt:
        mov rax, 0xFFFFFBBA;
        jmp usbif_mi_out;
      usbif_mi_no_device:
        mov rax, 0xFFFFFBB9;
        jmp usbif_mi_out;
      usbif_mi_in_use:
        mov rdi, 2;
        call usb_interface_note;
        mov rax, 0xFFFFFBB7;
        jmp usbif_mi_out;
      usbif_mi_enospc:
        mov rdi, 3;
        call usb_interface_note;
        mov rax, 0xFFFFFBB8;

      usbif_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_interface_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (interface_key: u64) (packed_ifnum_alt: u64) (packed_class_sc_proto: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): audited mint. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call usb_interface_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x164;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let usb_interface_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): revoke a KIND_USB_INTERFACE. Labels prefixed usbif_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae usbif_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  usbif_rvk_already;

        mov r11, 0x164;
        cmp r10, r11;
        jne usbif_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_rvk_clear;

        mov rdi, r13;
        call usb_interface_tail_free;

      usbif_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call usb_interface_note;

        xor rax, rax;
        jmp usbif_rvk_out;

      usbif_rvk_bad_slot:
        mov rax, 0xFFFFFBB6;
        jmp usbif_rvk_out;
      usbif_rvk_wrong_kind:
        mov rax, 0xFFFFFBB5;
        jmp usbif_rvk_out;
      usbif_rvk_already:
        mov rax, 0xFFFFFBB4;

      usbif_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_interface_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call usb_interface_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x164;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_usb_interface : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): KIND_USB_INTERFACE dispatch handler. Queries need INVOKE; DEBUG_PRINT needs OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed usbif_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_usb_interface_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne usbif_hn_res;

        cmp rbp, 7;
        ja  usbif_hn_unsup;

        cmp rbp, 7;
        je  usbif_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  usbif_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  usbif_hn_key;
        cmp rbp, 1;
        je  usbif_hn_ifn;
        cmp rbp, 2;
        je  usbif_hn_alt;
        cmp rbp, 3;
        je  usbif_hn_cls;
        cmp rbp, 4;
        je  usbif_hn_scl;
        cmp rbp, 5;
        je  usbif_hn_prt;
        call usb_interface_row_parent;
        jmp usbif_hn_out;

      usbif_hn_key:
        call usb_interface_row_key;
        jmp usbif_hn_out;
      usbif_hn_ifn:
        call usb_interface_row_ifnum;
        jmp usbif_hn_out;
      usbif_hn_alt:
        call usb_interface_row_alt;
        jmp usbif_hn_out;
      usbif_hn_cls:
        call usb_interface_row_class;
        jmp usbif_hn_out;
      usbif_hn_scl:
        call usb_interface_row_subclass;
        jmp usbif_hn_out;
      usbif_hn_prt:
        call usb_interface_row_protocol;
        jmp usbif_hn_out;

      usbif_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  usbif_hn_denied;
        xor rax, rax;
        jmp usbif_hn_out;

      usbif_hn_res:
        mov rax, 0xFFFFFBBE;
        jmp usbif_hn_out;
      usbif_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp usbif_hn_out;
      usbif_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      usbif_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
