  // Lookups.
  // ==========================================================================

  pub let usb_interface_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (interface_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-001 (#1172): live row holding this interface_key, or ROW_NONE. Labels prefixed usbif_fk_.",
      block: {
        cmp rdi, 0;
        je  usbif_fk_none;
        xor rcx, rcx;
      usbif_fk_scan:
        cmp rcx, 16;
        jae usbif_fk_none;
        lea r10, [rip + _usb_interface_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbif_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  usbif_fk_hit;
      usbif_fk_next:
        add rcx, 1;
        jmp usbif_fk_scan;
      usbif_fk_hit:
        mov rax, rcx;
        ret;
      usbif_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let usb_interface_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-001 (#1172): slot -> row_id, gated on live KIND_USB_INTERFACE. Labels prefixed usbif_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae usbif_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x164;
        cmp r10, r11;
        jne usbif_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call usb_interface_tail_valid;
        cmp rax, 0;
        je  usbif_ros_none;

        mov rax, r12;
        jmp usbif_ros_out;

      usbif_ros_none:
        mov rax, 0xFF;
      usbif_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

