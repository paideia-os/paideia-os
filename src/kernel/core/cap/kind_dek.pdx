// src/kernel/core/cap/kind_dek.pdx -- PFS-12 (paideia-os #2579)
//
// KIND_DEK = 0x1A4, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// Data-Encryption-Key capability. One row holds a 32-byte plaintext
// DEK, the volume_id the DEK belongs to, and a small flags word.
// The DEK is unwrapped from the superblock's wrapped-DEK blob by
// libpdx-volume's pdxb_dek_unwrap (using the KEK derived by
// pdxb_kek_derive from a mount-time passphrase); mount.pdxfs holds the
// unwrapped bytes in ring-3 scratch across a single supervisor hop
// that seeds a KIND_DEK row via kind_dek_mint_body. The per-block
// pdxb_block_encrypt / pdxb_block_decrypt helpers (libpdx-volume
// v1.1.x -- PFS-05 fail-closed stubs today) then compose the real
// crypto with a dek_lookup_body(volume_id) step: given a KIND_VOLUME
// handle the FS layer already knows the volume_id, so no cap-invoke
// payload needs to carry 32 bytes of key material.
//
// =============================================================================
// SECTION 0  ORDINAL CHOICE  --  0x1A4
// =============================================================================
//
// paideia-os/paideia-os#2579's issue title suggested KIND_DEK = 0x1A6.
// 0x1A6 has been occupied by KIND_TUI_CANVAS since R89.M1-002 (#1989)
// -- src/kernel/core/cap/kind_tui_canvas.pdx §0. A tree-wide
// `grep -rln "0x1A6" src/kernel/` at landing time (2026-10-11) returns
// kind_tui_canvas.pdx + cap_handler_tui_canvas.pdx + the dispatch arm
// at cap/invoke.pdx:1901. The issue author did not verify the slot
// was free before writing the title.
//
// This landing claims 0x1A4 instead, which is architecturally cleaner:
//
//   0x1A0  KIND_VOLUME               (R52.M5-001)
//   0x1A1  KIND_BLOCK_CACHE          (R52.M7-002)
//   0x1A2  KIND_INODE_HANDLE         (R52.M4-003)
//   0x1A3  KIND_SIG_KEY              (R52.M5-001) -- MLDSA-65 public-key
//   0x1A4  KIND_DEK                  (this landing)                     NEW
//   0x1A5  KIND_PDXFS_MOUNT_TABLE    (R53-PREP-001)
//   0x1A6  KIND_TUI_CANVAS           (R89.M1-002)
//
// 0x1A4 is the only free slot in the FS / crypto key cluster
// (0x1A0..0x1A5) and sits adjacent to KIND_SIG_KEY, which is also a
// key-material cap. audit_schema's ceiling was already raised to
// 0x1AC at fix#2005 so this slot's audit emission is in-band
// (audit_schema.pdx L362) -- no ceiling bump.
//
// =============================================================================
// SECTION 1  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// A KIND_DEK row holds the plaintext 32-byte DEK produced by
// libpdx-volume's pdxb_dek_unwrap (an AEAD-authenticated unwrap of
// the superblock's wrapped-DEK blob under a KEK derived from the
// mount-time passphrase). mount.pdxfs reaches the mint path with
// RIGHT_MINT on a KIND_MEMORY parent cap over its own private scratch
// page -- the parent gate is therefore the standard "cannot widen
// memory reach beyond what you already hold" rule: parent.kind ==
// KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200). This matches
// kind_kek.pdx §1 one-for-one; the two sibling kinds (DEK / KEK)
// derive over KIND_MEMORY for the same reason.
//
// Supervisor-only mint: no cap-invoke op reaches kind_dek_mint_body
// (per the cap_handler_dek dispatcher below -- SEAL returns a stub
// sentinel). A ring-3 holder of a KIND_DEK cap reaches only the
// three op-catalog entries SEAL / LOOKUP_BY_VOLUME / SCRUB, gated per
// §3; SEAL is the "ask authority for a new sealed row" surface that
// at MVP returns DEK_STUB_SENTINEL (the real sealing happens through
// a supervisor-mediated mint syscall landing in a follow-up round;
// see §9 FOLLOW-UP WORK below).
//
// =============================================================================
// SECTION 2  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words). Row stride is a power of
// two, so idx*64 composes as a single `shl r,6` -- simpler than
// kind_kek's 72-byte stride (kek had to carry the kek_id + created_tsc
// + refcount; DEK is a mount-lifetime slot, no counters needed).
//
//   [+0]   header       (u64):  in_use[63:56] | kind_tag[55:0]
//                               kind_tag mirrors KIND_DEK (0x1A4) for
//                               a defensive tag-in-row assertion at
//                               scrub time.
//   [+8]   dek_lo64     (u64):  bytes 0..7 of the 32-byte DEK (LE).
//   [+16]  dek_mid64_lo (u64):  bytes 8..15.
//   [+24]  dek_mid64_hi (u64):  bytes 16..23.
//   [+32]  dek_hi64     (u64):  bytes 24..31.
//   [+40]  volume_id    (u64):  the KIND_VOLUME row's volume_id -- a
//                               kernel-assigned sequential u64 (per
//                               kind_volume.pdx _volume_next_id); the
//                               FS layer looks up a DEK row by this
//                               key at per-block encrypt/decrypt time.
//                               volume_id == 0 is reserved (invalid)
//                               so the "row is live but owns no volume"
//                               state is distinguishable from a free
//                               row through the header's in_use byte.
//   [+48]  flags        (u64):  flags[31:0] | reserved[63:32]
//                               flags -- bit 0 = REVOKED, others
//                                        reserved.
//   [+56]  reserved     (u64):  must be zero at mint (future KDF-mode
//                               / nonce-prefix storage).
//
// Row-addressed capacity: DEK_MAX = 16 rows. 16 * 64 = 1024 bytes =
// 128 u64 words. Sixteen outstanding DEKs is above the current design
// ceiling of "up to eight concurrently mounted encrypted volumes"
// (per libpdx-volume design/architecture.md §8.2), leaving headroom
// for per-user DEKs on multi-tenant volumes.
//
// =============================================================================
// SECTION 3  RIGHTS
// =============================================================================
//
//   R_DEK_SEAL   (0x001) -- DEK_OP_SEAL: request a sealed row (MVP
//                           returns DEK_STUB_SENTINEL; supervisor path
//                           goes direct to kind_dek_mint_body).
//   R_DEK_READ   (0x002) -- DEK_OP_LOOKUP_BY_VOLUME: resolve a
//                           volume_id to a row_id for the pdxb_block_
//                           encrypt / _decrypt per-block call sites.
//   R_DEK_SCRUB  (0x004) -- DEK_OP_SCRUB: zero + free a row (umount
//                           path).
//   R_DEK_ALL    (0x007) -- subset test in dek_rights_valid.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFEFA0..0xFFFFEFAF
// =============================================================================
//
// Band audit at landing time (2026-10-11): `grep -hoE "0xFFFFEFA[0-
// 9A-F]" . -r` returned zero hits across the entire repo. kind_kek's
// 0xFFFFEB50..57 band is adjacent to kind_page_flip (0xFFFFEB58..5F),
// hotplug_channel + user/identity (0xFFFFEB60..6F); the next fully
// empty 16-slot window at the DEK landing is 0xFFFFEFA0..AF.
//
//   DEK_MINT_BAD_PARENT   0xFFFFEFA0  -- parent not KIND_MEMORY
//   DEK_MINT_BAD_RIGHTS   0xFFFFEFA1  -- rights not subset of R_DEK_ALL
//   DEK_MINT_BAD_ARG      0xFFFFEFA2  -- dek_ptr == 0 / dek_len != 32
//                                        / volume_id == 0 / flags OOR
//   DEK_TAIL_ENOSPC       0xFFFFEFA3  -- 16-row pool full
//   DEK_BAD_SLOT          0xFFFFEFA4  -- op_arg row_id OOR or free
//   DEK_BAD_RIGHTS        0xFFFFEFA5  -- op invoked without required right
//   DEK_TAIL_BAD_ARG      0xFFFFEFA6  -- SEAL / SCRUB op_arg[63:8]
//                                        non-zero
//   DEK_STUB_SENTINEL     0xFFFFEFA7  -- SEAL via cap-invoke (MVP);
//                                        caller composes the supervisor
//                                        mint hop
//   DEK_LOOKUP_MISS       0xFFFFEFA8  -- LOOKUP_BY_VOLUME: no row
//                                        matches volume_id
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag 0x1A4 fits in a 32-bit immediate (no sign-extension needed),
// but every compare still stages through r10/r11 for parallel-wave
// uniformity with kind_kek (same pattern, same code shape). Row stride
// is 64 bytes (DEK_ROW_BYTES = a power of two), so idx*64 is a single
// `shl r,6`. No `add reg, [mem]`, no `mov_bzx` / `mov_wzx`, no `test`.
// Labels prefixed `dek_` or `dek_hn_`.
//
// Module basename match: file is kind_dek.pdx, module is KindDek.
// (paideia-as encoder: the `module Name` identifier must case-fold-
// match the file basename with underscores dropped -- kind_dek.pdx
// -> KindDek.)
//
// =============================================================================
// SECTION 9  FOLLOW-UP WORK
// =============================================================================
//
// This landing wires the KIND_DEK SUBSTRATE (row pool + mint gate +
// narrow gate + lookup/scrub direct-call reach + 3-op cap-invoke
// dispatcher). Two follow-up pieces complete the end-to-end
// passphrase-fd flow and the per-block crypto path:
//
//   #1: mount.pdxfs supervisor-mint hop. Today passphrase_wire_unlock
//     (tools/user/mount.pdxfs/src/passphrase_wire.pdx) leaves the
//     unwrapped DEK in a .bss scratch (GAP #P2 in that file's header).
//     Composing that scratch into a KIND_DEK row needs a supervisor
//     mint syscall (sys_dek_seal) that reads the 32 DEK bytes from a
//     caller-pinned KIND_MEMORY page + takes volume_id from the
//     narrowed KIND_VOLUME slot's row header, then calls kind_dek_
//     mint_body here. The syscall ABI, the pinned-page gate, and the
//     mount.pdxfs call-site rewiring are a separate wave (filed as
//     paideia-os/paideia-os#TBD1).
//
//   #2: libpdx-volume pdxb_block_encrypt / pdxb_block_decrypt real
//     bodies. PFS-05 (block-crypto-contract.md) landed these as
//     fail-closed stubs returning LPV_CRYPTO_ERR_NOT_IMPL. With
//     KIND_DEK live, each real body now dek_lookup_body(volume_id) ->
//     row_id, reads the 32-byte DEK via dek_row_read (NEW accessor to
//     land alongside), derives the per-block nonce (volume_prefix[4]
//     || LE_u64(blk_lba)), and invokes the paideia-as chacha20_poly1305
//     intrinsic. Also a separate wave (filed as paideia-os/paideia-
//     os#TBD2).
//
// Both deferred by scope: the issue header itself notes "if KIND_DEK
// alone fits the wave budget, land just that and defer passphrase-fd
// + libpdx-volume bodies." This landing takes that posture.

module KindDek = structure {

  pub let KIND_DEK      : u64 = 0x1A4
  pub let KIND_DEK_BASE : u64 = 4                     // = KIND_MEMORY

  // Rights (§3).
  pub let R_DEK_SEAL   : u64 = 0x001
  pub let R_DEK_READ   : u64 = 0x002
  pub let R_DEK_SCRUB  : u64 = 0x004
  pub let R_DEK_ALL    : u64 = 0x007

  // Ops.
  pub let DEK_OP_SEAL              : u64 = 0
  pub let DEK_OP_LOOKUP_BY_VOLUME  : u64 = 1
  pub let DEK_OP_SCRUB             : u64 = 2
  pub let DEK_OP_MAX               : u64 = 2

  // Flag bits.
  pub let DEK_FLAG_REVOKED : u64 = 1
  pub let DEK_FLAG_ALL     : u64 = 1

  // DEK plaintext length (bytes). Fixed at 32 for ChaCha20-Poly1305
  // (matches libpdx-volume LPV_DEK_LEN).
  pub let DEK_LEN : u64 = 32

  // Failure taxonomy (§4).
  pub let DEK_OK                : u64 = 0
  pub let DEK_MINT_BAD_PARENT   : u64 = 0xFFFFEFA0
  pub let DEK_MINT_BAD_RIGHTS   : u64 = 0xFFFFEFA1
  pub let DEK_MINT_BAD_ARG      : u64 = 0xFFFFEFA2
  pub let DEK_TAIL_ENOSPC       : u64 = 0xFFFFEFA3
  pub let DEK_BAD_SLOT          : u64 = 0xFFFFEFA4
  pub let DEK_BAD_RIGHTS        : u64 = 0xFFFFEFA5
  pub let DEK_TAIL_BAD_ARG      : u64 = 0xFFFFEFA6
  pub let DEK_STUB_SENTINEL     : u64 = 0xFFFFEFA7
  pub let DEK_LOOKUP_MISS       : u64 = 0xFFFFEFA8

  pub let DEK_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DEK_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let DEK_MAX       : u64 = 16
  pub let DEK_ROW_BYTES : u64 = 64

  // 16 rows * 64 bytes = 1024 bytes = 128 u64.
  pub let mut _dek_table : [u64; 128] = uninit @align(64)
  pub let mut _dek_stats : [u64; 8]   = uninit @align(64)

  pub let DEK_ST_MINTS   : u64 = 0
  pub let DEK_ST_LOOKUPS : u64 = 1
  pub let DEK_ST_HITS    : u64 = 2
  pub let DEK_ST_MISSES  : u64 = 3
  pub let DEK_ST_SCRUBS  : u64 = 4
  pub let DEK_ST_REFUSED : u64 = 5
  pub let DEK_ST_MAX     : u64 = 8

  // ==========================================================================
  // kind_dek_init() -> ()
  //
  // Boot / teardown scrub of the row pool and counter table. .bss
  // already starts zero at real boot; defensive, matches
  // kind_kek_init one-for-one.
  // ==========================================================================

  pub let kind_dek_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): clear _dek_table (128 u64 = 1024 bytes) and _dek_stats (8 u64). Two straight-line loops. Labels prefixed dek_rs_.",
      block: {
        lea r10, [rip + _dek_table];
        xor rax, rax;
        xor rcx, rcx;
      dek_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  dek_rs_rows;

        lea r10, [rip + _dek_stats];
        xor rcx, rcx;
      dek_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dek_rs_stats;
        ret
      }
    }

  pub let dek_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): bounded increment on _dek_stats. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed dek_nt_.",
      block: {
        cmp rdi, 8;
        jae dek_nt_out;
        lea r10, [rip + _dek_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dek_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dek_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): subset test against R_DEK_ALL = 0x007. Labels prefixed dek_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x007;                  // R_DEK_ALL
        and rax, r10;
        cmp rax, rdi;
        jne dek_rv_no;
        mov rax, 1;
        ret;
      dek_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dek_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "PFS-12 (paideia-os #2579): KIND_MEMORY derivation gate. Bounds-check parent_slot < 256; load descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_MEMORY (4) AND rights ([+8]) carry RIGHT_MINT (0x200). Pure read (@{cap} because it inspects cap_table). Labels prefixed dek_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dek_cpm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne dek_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  dek_cpm_no;

        mov rax, 1;
        ret;
      dek_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool: dek_row_valid / dek_row_alloc / dek_row_free.
  //
  // Row stride is 64 bytes (DEK_ROW_BYTES) -- a power of two, so
  // idx*64 is a single `shl r,6`.
  // ==========================================================================

  pub let dek_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): 1 iff idx < DEK_MAX(16) and in_use byte set. idx*64 via shl 6. Labels prefixed dek_rv2_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae dek_rv2_no;
        lea r10, [rip + _dek_table];
        mov r11, rdi;
        shl r11, 6;                      // idx * 64
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use byte
        cmp rax, 0;
        je  dek_rv2_no;
        mov rax, 1;
        ret;
      dek_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // dek_row_alloc(volume_id, dek_ptr, flags) -> row_idx | DEK_TAIL_ENOSPC
  //
  // Low-first scan over 16 rows of 64 bytes. Header write is LAST:
  // packs (KIND_DEK tag in low 56 bits) OR (1 << 56 in_use marker)
  // into [row+0] in the same qword store. Reads 32 bytes of DEK
  // material from dek_ptr via four aligned u64 loads.
  pub let dek_row_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (volume_id: u64) (dek_ptr: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): claim one KIND_DEK row. Low-first scan (r14=idx cursor) over 16 rows of 64 bytes; address compute via `shl r11,6`. On claim: (1) read four u64 words from [dek_ptr+0/+8/+16/+24], store them at [row+8/+16/+24/+32]; (2) write volume_id at row+40; (3) pack (flags & 0xFFFFFFFF) at row+48; (4) zero reserved at row+56; (5) publish header LAST at row+0 as (KIND_DEK tag) | (1<<56 in_use marker). Six callee-save pushes (rbx=volume_id, r12=dek_ptr, r13=flags, r14=idx cursor, r15=scratch, rbp=scratch) + sub rsp,8 pad = 56 bytes -> rsp%16==0 at every nested call. (No nested calls happen in this function body, but the push/pop frame survives a future audit-emit insertion without rework.) Effects {mem}: row + counter stores. Labels prefixed dek_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // volume_id
        mov r12, rsi;                    // dek_ptr
        mov r13, rdx;                    // flags

        xor r14, r14;                    // idx = 0
      dek_ra_scan:
        mov r10, 16;                     // DEK_MAX
        cmp r14, r10;
        jae dek_ra_enospc;

        lea r10, [rip + _dek_table];
        mov r11, r14;
        shl r11, 6;                      // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use byte
        cmp rax, 0;
        je  dek_ra_claim;

        add r14, 1;
        jmp dek_ra_scan;

      dek_ra_claim:
        // (1) 32-byte DEK copy: four aligned u64 loads from [r12+0/+8/+16/+24]
        //     stored into [r10+8/+16/+24/+32].
        mov rax, [r12 + 0];
        mov [r10 + 8],  rax;
        mov rax, [r12 + 8];
        mov [r10 + 16], rax;
        mov rax, [r12 + 16];
        mov [r10 + 24], rax;
        mov rax, [r12 + 24];
        mov [r10 + 32], rax;

        // (2) volume_id @ +40.
        mov [r10 + 40], rbx;

        // (3) flags (low 32 bits) @ +48.
        mov rax, r13;
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        mov [r10 + 48], rax;

        // (4) reserved = 0 @ +56.
        xor rax, rax;
        mov [r10 + 56], rax;

        // (5) Publish header LAST: kind_tag OR (in_use << 56).
        mov rax, 0x1A4;                  // KIND_DEK kind tag
        mov rcx, 1;
        shl rcx, 56;
        or  rax, rcx;
        mov [r10 + 0], rax;

        mov rax, r14;                    // row_idx
        jmp dek_ra_out;

      dek_ra_enospc:
        mov rax, 0xFFFFEFA3;             // DEK_TAIL_ENOSPC

      dek_ra_out:
        add rsp, 8;                      // undo entry pad
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // dek_row_free(idx) -> () -- unconditional scrub (eight u64 writes
  // of zero). Clears the in_use byte via the +0 header write, which
  // also wipes the kind tag; the next alloc re-stamps it.
  pub let dek_row_free : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): scrub one row (eight u64 words). Zero-writes include the DEK bytes (rows +8..+32), so this is the per-row key wipe at umount/scrub time. Labels prefixed dek_rf_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae dek_rf_out;
        lea r10, [rip + _dek_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      dek_rf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let dek_row_volume_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): volume_id (row+40) or DEK_DECODE_BAD. Labels prefixed dek_rvi_.",
      block: {
        push r12;
        mov r12, rdi;
        call dek_row_valid;
        cmp rax, 0;
        je  dek_rvi_bad;
        lea r10, [rip + _dek_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        jmp dek_rvi_out;
      dek_rvi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dek_rvi_out:
        pop r12;
        ret
      }
    }

  pub let dek_row_flags : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): flags (flags[31:0] of row+48) or DEK_DECODE_BAD. Labels prefixed dek_rfl_.",
      block: {
        push r12;
        mov r12, rdi;
        call dek_row_valid;
        cmp rax, 0;
        je  dek_rfl_bad;
        lea r10, [rip + _dek_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 48];
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        jmp dek_rfl_out;
      dek_rfl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dek_rfl_out:
        pop r12;
        ret
      }
    }

  // dek_row_read_qword(idx, qword_offset_0..3) -> u64 | DEK_DECODE_BAD
  //
  // Returns one of the four u64 DEK words (qword_offset in {0,1,2,3}
  // selects rows[+8]/[+16]/[+24]/[+32] respectively). The libpdx-
  // volume per-block path (follow-up #TBD2) assembles the 32-byte
  // DEK via four successive calls. This indirection keeps the DEK
  // bytes behind the row-valid gate at every read.
  pub let dek_row_read_qword : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64) (qword_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): read one 8-byte word of the DEK material at row+8+qword_offset*8. qword_offset bounds-checked < 4; row-valid gate before dereference. Two callee-save pushes (rbx=idx, r12=qword_offset) + sub rsp,8 pad = 24 bytes -> entry rsp%16==8 + 3 8-byte adjustments = rsp%16==0 at the nested dek_row_valid call. Labels prefixed dek_rrq_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;
        mov rbx, rdi;                    // idx
        mov r12, rsi;                    // qword_offset

        cmp r12, 4;
        jae dek_rrq_bad;

        mov rdi, rbx;
        call dek_row_valid;
        cmp rax, 0;
        je  dek_rrq_bad;

        lea r10, [rip + _dek_table];
        mov r11, rbx;
        shl r11, 6;                      // idx * 64
        add r10, r11;

        // Base offset = 8 + qword_offset * 8.
        mov rcx, r12;
        shl rcx, 3;                      // qword_offset * 8
        add rcx, 8;                      // +8 (base of DEK bytes)
        add r10, rcx;
        mov rax, [r10 + 0];
        jmp dek_rrq_out;

      dek_rrq_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // DEK_DECODE_BAD
      dek_rrq_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // dek_row_flag_set(idx, flag_bit) -> 0 | DEK_BAD_SLOT
  // Sets one bit in the row's flags[31:0] sub-field via load-or-store.
  pub let dek_row_flag_set : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64) (flag_bit: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): set one bit in the row's flags[31:0] via load-or-store. Reserved for a future SCRUB-without-free path (today DEK_OP_SCRUB frees the row outright). Two callee-save pushes (rbx=idx, r12=flag_bit) + sub rsp,8 pad = 24 bytes -> entry rsp%16==8 + 3 8-byte adjustments = rsp%16==0 at the nested dek_row_valid call. Labels prefixed dek_fs_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;
        mov rbx, rdi;                    // idx
        mov r12, rsi;                    // flag_bit

        mov rdi, rbx;
        call dek_row_valid;
        cmp rax, 0;
        je  dek_fs_bad;

        lea r10, [rip + _dek_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 48];             // flags
        mov rcx, r12;
        mov r11, 0xFFFFFFFF;
        and rcx, r11;
        or  rax, rcx;
        mov [r10 + 48], rax;

        xor rax, rax;
        jmp dek_fs_out;
      dek_fs_bad:
        mov rax, 0xFFFFEFA4;             // DEK_BAD_SLOT
      dek_fs_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dek_lookup_body(volume_id) -> row_id (0..15) | DEK_LOOKUP_MISS
  //
  // Linear scan over the 16-row pool for the first live row whose
  // volume_id matches. volume_id == 0 is a reserved sentinel ("no
  // volume") so a legitimate caller never passes 0 here; the scan
  // treats it as a miss. Not a cap-invoke op by itself -- reached
  // directly by the FS layer's per-block encrypt/decrypt call sites
  // (follow-up #TBD2). The cap_handler_dek DEK_OP_LOOKUP_BY_VOLUME
  // arm below composes this with a R_DEK_READ rights check.
  // ==========================================================================

  pub let dek_lookup_body : (u64) -> u64 !{mem} @{} =
    fn (volume_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): linear scan over _dek_table for the first live row whose [row+40] == volume_id. volume_id == 0 is a reserved miss. Three callee-save pushes (rbx=volume_id, r12=idx cursor, r13=saved-row_id-across-note-call) + sub rsp,16 pad = 40 bytes -> entry rsp%16==8 + 5 8-byte adjustments = rsp%16==0 for every nested dek_note call. Bumps DEK_ST_LOOKUPS unconditionally; DEK_ST_HITS on success, DEK_ST_MISSES on miss. Labels prefixed dek_lb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 16;

        mov rbx, rdi;                    // volume_id

        // Reject volume_id == 0 (reserved sentinel).
        cmp rbx, 0;
        je  dek_lb_miss;

        // Bump total-lookups counter.
        mov rdi, 1;                      // DEK_ST_LOOKUPS
        call dek_note;

        xor r12, r12;                    // idx = 0
      dek_lb_scan:
        mov r10, 16;
        cmp r12, r10;
        jae dek_lb_miss_counted;

        lea r10, [rip + _dek_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        // in_use check.
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dek_lb_next;

        // volume_id compare.
        mov rax, [r10 + 40];
        cmp rax, rbx;
        jne dek_lb_next;

        // Hit.
        mov r13, r12;                    // save row_id
        mov rdi, 2;                      // DEK_ST_HITS
        call dek_note;
        mov rax, r13;
        jmp dek_lb_out;

      dek_lb_next:
        add r12, 1;
        jmp dek_lb_scan;

      dek_lb_miss_counted:
        mov rdi, 3;                      // DEK_ST_MISSES
        call dek_note;
      dek_lb_miss:
        mov rax, 0xFFFFEFA8;             // DEK_LOOKUP_MISS

      dek_lb_out:
        add rsp, 16;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dek_scrub_body(row_id) -> 0 | DEK_BAD_SLOT
  //
  // Zero the DEK bytes + volume_id + flags + reserved + in_use byte.
  // The umount path and the SCRUB op both reach this. Bumps DEK_ST_
  // SCRUBS on success.
  // ==========================================================================

  pub let dek_scrub_body : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): wipe one row then bump DEK_ST_SCRUBS. Row-valid gate first (dek_row_valid). One callee-save push (rbx=row_id) + sub rsp,16 pad = 24 bytes -> entry rsp%16==8 + 3 8-byte adjustments = rsp%16==0 across every nested call (dek_row_valid + dek_row_free + dek_note). Labels prefixed dek_sb_.",
      block: {
        push rbx;
        sub rsp, 16;

        mov rbx, rdi;

        mov rdi, rbx;
        call dek_row_valid;
        cmp rax, 0;
        je  dek_sb_bad;

        mov rdi, rbx;
        call dek_row_free;

        mov rdi, 4;                      // DEK_ST_SCRUBS
        call dek_note;

        xor rax, rax;                    // DEK_OK
        jmp dek_sb_out;
      dek_sb_bad:
        mov rax, 0xFFFFEFA4;             // DEK_BAD_SLOT
      dek_sb_out:
        add rsp, 16;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_dek_mint_body(parent_slot, rights, volume_id, dek_ptr,
  //                    dek_len, flags) -> row_idx | DEK_*
  //
  // The KIND_DEK mint walker. Supervisor-only (no cap-invoke op
  // reaches this -- the DEK_OP_SEAL arm in cap_handler_dek returns
  // DEK_STUB_SENTINEL instead; the mount.pdxfs supervisor hop lands
  // in follow-up #TBD1 of §9).
  //
  // 6-arg SysV: rdi=parent_slot, rsi=rights, rdx=volume_id,
  // rcx=dek_ptr, r8=dek_len, r9=flags.
  // ==========================================================================

  pub let kind_dek_mint_body : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (volume_id: u64) (dek_ptr: u64) (dek_len: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "PFS-12 (paideia-os #2579): mint KIND_DEK over KIND_MEMORY. Gate order: (1) parent gate (KIND_MEMORY(4) + RIGHT_MINT(0x200)); (2) rights subset (<= R_DEK_ALL = 0x007); (3) arg validation: dek_ptr != 0 AND dek_len == 32 AND volume_id != 0 AND flags has no bits above DEK_FLAG_ALL (= 1); (4) dek_row_alloc(volume_id, dek_ptr, flags). Six callee-save pushes (rbx=parent_slot, r12=rights, r13=volume_id, r14=dek_ptr, r15=dek_len, rbp=flags) + sub rsp,8 pad = 56 bytes: post-prologue rsp%16==0 at every nested call. On success bumps DEK_ST_MINTS; every refuse funnel bumps DEK_ST_REFUSED. Labels prefixed dek_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // parent_slot
        mov r12, rsi;                    // rights
        mov r13, rdx;                    // volume_id
        mov r14, rcx;                    // dek_ptr
        mov r15, r8;                     // dek_len
        mov rbp, r9;                     // flags

        // (1) Parent gate.
        mov rdi, rbx;
        call dek_check_parent_memory;
        cmp rax, 0;
        je  dek_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r12;
        call dek_rights_valid;
        cmp rax, 0;
        je  dek_mi_bad_rights;

        // (3) Arg validation.
        cmp r14, 0;                      // dek_ptr != 0
        je  dek_mi_bad_arg;
        cmp r15, 32;                     // dek_len == 32
        jne dek_mi_bad_arg;
        cmp r13, 0;                      // volume_id != 0
        je  dek_mi_bad_arg;
        mov r10, rbp;
        mov r11, 1;                      // DEK_FLAG_ALL
        shr r10, 1;                      // bits above DEK_FLAG_ALL
        cmp r10, 0;
        jne dek_mi_bad_arg;

        // (4) Row alloc.
        //   dek_row_alloc(volume_id, dek_ptr, flags)
        mov rdi, r13;
        mov rsi, r14;
        mov rdx, rbp;
        call dek_row_alloc;
        mov r10, 16;                     // DEK_MAX
        cmp rax, r10;
        jae dek_mi_alloc_fail;

        push rax;
        sub rsp, 8;
        mov rdi, 0;                      // DEK_ST_MINTS
        call dek_note;
        add rsp, 8;
        pop rax;
        jmp dek_mi_out;

      dek_mi_alloc_fail:
        jmp dek_mi_refused;
      dek_mi_bad_parent:
        mov rax, 0xFFFFEFA0;             // DEK_MINT_BAD_PARENT
        jmp dek_mi_refused;
      dek_mi_bad_rights:
        mov rax, 0xFFFFEFA1;             // DEK_MINT_BAD_RIGHTS
        jmp dek_mi_refused;
      dek_mi_bad_arg:
        mov rax, 0xFFFFEFA2;             // DEK_MINT_BAD_ARG

      dek_mi_refused:
        push rax;
        sub rsp, 8;
        mov rdi, 5;                      // DEK_ST_REFUSED
        call dek_note;
        add rsp, 8;
        pop rax;

      dek_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_dek_narrow_body(row_id, drop_mask) -> 0 | DEK_*
  //
  // Narrow the caller's DEK cap by dropping every right in drop_mask.
  // Row-live + subset gate; descriptor-side rewrite is the caller's
  // responsibility (mirrors kind_kek_narrow_body one-for-one).
  // ==========================================================================

  pub let kind_dek_narrow_body : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (drop_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "PFS-12 (paideia-os #2579): narrow gate. (1) dek_row_valid(row_id); (2) drop_mask subset of R_DEK_ALL (0x007). No stored-rights rewrite here. Two callee-save pushes (rbx=row_id, r12=drop_mask) + sub rsp,8 pad = 24 bytes -> entry rsp%16==8 + 3 8-byte adjustments = rsp%16==0 at every nested call. Labels prefixed dek_nb_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // drop_mask

        mov rdi, rbx;
        call dek_row_valid;
        cmp rax, 0;
        je  dek_nb_bad_slot;

        mov rdi, r12;
        call dek_rights_valid;
        cmp rax, 0;
        je  dek_nb_bad_rights;

        xor rax, rax;
        jmp dek_nb_out;

      dek_nb_bad_slot:
        mov rax, 0xFFFFEFA4;             // DEK_BAD_SLOT
        jmp dek_nb_out;
      dek_nb_bad_rights:
        mov rax, 0xFFFFEFA5;             // DEK_BAD_RIGHTS

      dek_nb_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_dek(rights, target_ptr, op_arg) -> u64
  //
  // KIND_DEK op dispatch. Per-op semantics:
  //
  //   DEK_OP_SEAL (0): REQUIRES R_DEK_SEAL. target_ptr unused;
  //     op_arg[63:8] MUST be zero. Returns DEK_STUB_SENTINEL at MVP --
  //     the real sealing path is a supervisor-mediated mint hop
  //     (follow-up #TBD1 of §9) that reaches kind_dek_mint_body
  //     directly with the 32-byte DEK read from a pinned KIND_MEMORY
  //     page.
  //
  //   DEK_OP_LOOKUP_BY_VOLUME (1): REQUIRES R_DEK_READ. target_ptr
  //     carries the full-u64 volume_id. op_arg[63:8] MUST be zero
  //     (only the ordinal and payload). Returns a row_id (0..15) on
  //     hit or DEK_LOOKUP_MISS on miss. Note: this is the only op
  //     whose target_ptr is NOT a row_id -- target_ptr IS the search
  //     key.
  //
  //   DEK_OP_SCRUB (2): REQUIRES R_DEK_SCRUB. target_ptr[15:0] is the
  //     row_id; op_arg[63:8] MUST be zero. Zeros the row's DEK bytes
  //     + volume_id + flags + header, freeing the slot. Returns 0 on
  //     success.
  //
  // Three callee-save pushes (rbx=rights, r12=target_ptr, r13=op_arg)
  // leave rsp%16==0 at every nested call. The LOOKUP arm forwards
  // target_ptr verbatim as volume_id; the SCRUB arm narrows
  // target_ptr to its low 16 bits before calling dek_scrub_body.
  // ==========================================================================

  pub let cap_handler_dek : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "PFS-12 (paideia-os #2579): KIND_DEK ops dispatch. op = op_arg[7:0]; op_arg[63:8] MUST be zero. Per-op semantics differ in how target_ptr is interpreted (row_id for SCRUB; volume_id search key for LOOKUP_BY_VOLUME; unused for SEAL). Per-op rights gates: SEAL needs R_DEK_SEAL; LOOKUP_BY_VOLUME needs R_DEK_READ; SCRUB needs R_DEK_SCRUB. LOOKUP and SCRUB check the row-live gate inside their respective called helpers (dek_lookup_body / dek_scrub_body) rather than here, since LOOKUP's target_ptr is not a row index at all. SEAL returns DEK_STUB_SENTINEL; LOOKUP returns row_id | DEK_LOOKUP_MISS; SCRUB returns 0 | DEK_BAD_SLOT. Three callee-save pushes (rbx=rights, r12=target_ptr, r13=op_arg) leave rsp%16==0 at every nested call. Effects {mem}: reads _dek_table + stat counter + flag/alloc writes. Labels prefixed dek_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;                    // target_ptr
        mov r13, rdx;                    // op_arg

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne dek_hn_bad_arg;

        // op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        mov r13, r10;

        // Op dispatch.
        cmp r13, 0;
        je  dek_hn_op_seal;
        cmp r13, 1;
        je  dek_hn_op_lookup;
        cmp r13, 2;
        je  dek_hn_op_scrub;
        jmp dek_hn_bad_slot;

      dek_hn_op_seal:
        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                  // R_DEK_SEAL
        cmp r10, 0;
        je  dek_hn_bad_rights;
        // MVP stub: real supervisor-mint path lives at follow-up #TBD1.
        mov rax, 0xFFFFEFA7;             // DEK_STUB_SENTINEL
        jmp dek_hn_out;

      dek_hn_op_lookup:
        // Rights gate.
        mov r10, rbx;
        and r10, 0x002;                  // R_DEK_READ
        cmp r10, 0;
        je  dek_hn_bad_rights;
        // target_ptr IS the volume_id search key.
        mov rdi, r12;
        call dek_lookup_body;
        // rax = row_id (0..15) | DEK_LOOKUP_MISS -- passthrough.
        jmp dek_hn_out;

      dek_hn_op_scrub:
        // Rights gate.
        mov r10, rbx;
        and r10, 0x004;                  // R_DEK_SCRUB
        cmp r10, 0;
        je  dek_hn_bad_rights;
        // target_ptr[15:0] = row_id.
        mov rdi, r12;
        mov r10, 0xFFFF;
        and rdi, r10;
        call dek_scrub_body;
        jmp dek_hn_out;

      dek_hn_bad_arg:
        mov rax, 0xFFFFEFA6;             // DEK_TAIL_BAD_ARG
        jmp dek_hn_out;
      dek_hn_bad_slot:
        mov rax, 0xFFFFEFA4;             // DEK_BAD_SLOT
        jmp dek_hn_out;
      dek_hn_bad_rights:
        mov rax, 0xFFFFEFA5;             // DEK_BAD_RIGHTS

      dek_hn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
