  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, route_key,
  // endpoint_slot, packed_ident).
  //
  // packed_ident encoding (single u64, fits every non-key field
  // that needs validation):
  //   [23:0]   route_id       (24 bits, USB4 route)
  //   [31:24]  tunnel_type    (8 bits; validator restricts to {0,1,2})
  //   [39:32]  source_adapter (8 bits)
  //   [47:40]  sink_adapter   (8 bits)
  //   [55:48]  state          (8 bits; validator restricts to {0,1,2})
  //   [63:56]  reserved       (must be zero)
  // ==========================================================================

  pub let tb_route_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (route_key: u64) (endpoint_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): mint KIND_TB_ROUTE over KIND_IPC_ENDPOINT. Six args (slot, parent, rights, key, endpoint_slot, packed_ident). packed_ident = route_id[23:0] | tunnel_type[31:24] | source[39:32] | sink[47:40] | state[55:48]. Sequence: slot<256; check_parent; check_endpoint (BAD_ENDPOINT); rights_valid; unpack + validate route/tunnel/adapters/state; source != sink (BAD_ADAPTER); reserved[63:56] == 0 (BAD_ARG); route_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body1_pack; body2_pack; tail_alloc; cap_mint_write. Labels prefixed tbr_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // route_key
        mov r15, r8;                     // endpoint_slot
        mov rbp, r9;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae tbr_mi_bad_slot;

        mov rdi, r12;
        call tb_route_check_parent;
        cmp rax, 0;
        je  tbr_mi_bad_parent;

        mov rdi, r15;
        call tb_route_check_endpoint;
        cmp rax, 0;
        je  tbr_mi_bad_endpoint;

        mov rdi, r13;
        call tb_route_rights_valid;
        cmp rax, 0;
        je  tbr_mi_bad_rights;

        // Reserved [63:56] must be zero.
        mov r10, rbp;
        shr r10, 56;
        cmp r10, 0;
        jne tbr_mi_bad_route;

        // Validate route_id.
        mov rdi, rbp;
        and rdi, 0xFFFFFF;
        call tb_route_route_valid;
        cmp rax, 0;
        je  tbr_mi_bad_route;

        // Validate tunnel_type.
        mov rdi, rbp;
        shr rdi, 24;
        and rdi, 0xFF;
        call tb_route_tunnel_valid;
        cmp rax, 0;
        je  tbr_mi_bad_tunnel;

        // Validate source_adapter.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFF;
        call tb_route_adapter_valid;
        cmp rax, 0;
        je  tbr_mi_bad_adapter;

        // Validate sink_adapter.
        mov rdi, rbp;
        shr rdi, 40;
        and rdi, 0xFF;
        call tb_route_adapter_valid;
        cmp rax, 0;
        je  tbr_mi_bad_adapter;

        // Self-loop check (source != sink).
        mov rax, rbp;
        shr rax, 32;
        and rax, 0xFF;
        mov r11, rbp;
        shr r11, 40;
        and r11, 0xFF;
        cmp rax, r11;
        je  tbr_mi_bad_adapter;

        // Validate state.
        mov rdi, rbp;
        shr rdi, 48;
        and rdi, 0xFF;
        call tb_route_state_valid;
        cmp rax, 0;
        je  tbr_mi_bad_state;

        cmp r14, 0;
        je  tbr_mi_no_key;

        mov rdi, r14;
        call tb_route_find_by_key;
        cmp rax, 0xFF;
        jne tbr_mi_in_use;

        // Body1 pack args: (endpoint_slot, route_id, tunnel_type).
        mov rdi, r15;                    // endpoint_slot
        mov rsi, rbp;
        and rsi, 0xFFFFFF;               // route_id
        mov rdx, rbp;
        shr rdx, 24;
        and rdx, 0xFF;                   // tunnel_type
        call tb_route_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tbr_mi_bad_route;
        push rax;                        // body1
        sub rsp, 8;                      // 16-byte align

        // Body2 pack args: (source, sink, state).
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFF;                   // source
        mov rsi, rbp;
        shr rsi, 40;
        and rsi, 0xFF;                   // sink
        mov rdx, rbp;
        shr rdx, 48;
        and rdx, 0xFF;                   // state
        call tb_route_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tbr_mi_bad_adapter;
        // Stash body2 in r15; endpoint_slot no longer needed
        // as separate register (its value is baked into body1).
        mov r15, rax;                    // body2
        push r11;                        // body1
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call tb_route_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tbr_mi_bad_parent;

        // tail_alloc(hdr, route_key, body1, body2).
        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // route_key
        mov rdx, r11;                    // body1
        mov rcx, r15;                    // body2
        call tb_route_tail_alloc;

        mov r10, 0xFFFFF9AF;             // ENOSPC
        cmp rax, r10;
        je  tbr_mi_enospc;
        mov r10, 0xFFFFF9AE;             // BAD_ARG
        cmp rax, r10;
        je  tbr_mi_bad_route;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x16D;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call tb_route_note;

        xor rax, rax;
        jmp tbr_mi_out;

      tbr_mi_bad_slot:
        mov rax, 0xFFFFF9A3;
        jmp tbr_mi_out;
      tbr_mi_bad_parent:
        mov rax, 0xFFFFF9AD;
        jmp tbr_mi_out;
      tbr_mi_bad_rights:
        mov rax, 0xFFFFF9AC;
        jmp tbr_mi_out;
      tbr_mi_bad_route:
        mov rax, 0xFFFFF9AB;
        jmp tbr_mi_out;
      tbr_mi_bad_tunnel:
        mov rax, 0xFFFFF9AA;
        jmp tbr_mi_out;
      tbr_mi_bad_adapter:
        mov rax, 0xFFFFF9A9;
        jmp tbr_mi_out;
      tbr_mi_bad_state:
        mov rax, 0xFFFFF9A8;
        jmp tbr_mi_out;
      tbr_mi_bad_endpoint:
        mov rax, 0xFFFFF9A7;
        jmp tbr_mi_out;
      tbr_mi_no_key:
        mov rax, 0xFFFFF9A6;
        jmp tbr_mi_out;
      tbr_mi_in_use:
        mov rdi, 2;
        call tb_route_note;
        mov rax, 0xFFFFF9A4;
        jmp tbr_mi_out;
      tbr_mi_enospc:
        mov rdi, 3;
        call tb_route_note;
        mov rax, 0xFFFFF9A5;

      tbr_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_route_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (route_key: u64) (endpoint_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call tb_route_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x16D;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let tb_route_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): revoke KIND_TB_ROUTE. Labels prefixed tbr_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae tbr_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  tbr_rvk_already;

        mov r11, 0x16D;
        cmp r10, r11;
        jne tbr_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call tb_route_tail_valid;
        cmp rax, 0;
        je  tbr_rvk_clear;

        mov rdi, r13;
        call tb_route_tail_free;

      tbr_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call tb_route_note;

        xor rax, rax;
        jmp tbr_rvk_out;

      tbr_rvk_bad_slot:
        mov rax, 0xFFFFF9A3;
        jmp tbr_rvk_out;
      tbr_rvk_wrong_kind:
        mov rax, 0xFFFFF9A2;
        jmp tbr_rvk_out;
      tbr_rvk_already:
        mov rax, 0xFFFFF9A1;

      tbr_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_route_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call tb_route_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x16D;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_tb_route : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): KIND_TB_ROUTE dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed tbr_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_tb_route_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne tbr_hn_res;

        cmp rbp, 8;
        ja  tbr_hn_unsup;

        cmp rbp, 8;
        je  tbr_hn_dbg;

        // Ops 0..7: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  tbr_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  tbr_hn_key;
        cmp rbp, 1;
        je  tbr_hn_eid;
        cmp rbp, 2;
        je  tbr_hn_rid;
        cmp rbp, 3;
        je  tbr_hn_tun;
        cmp rbp, 4;
        je  tbr_hn_src;
        cmp rbp, 5;
        je  tbr_hn_snk;
        cmp rbp, 6;
        je  tbr_hn_stt;
        call tb_route_row_parent;
        jmp tbr_hn_out;

      tbr_hn_key:
        call tb_route_row_key;
        jmp tbr_hn_out;
      tbr_hn_eid:
        call tb_route_row_endpoint;
        jmp tbr_hn_out;
      tbr_hn_rid:
        call tb_route_row_route_id;
        jmp tbr_hn_out;
      tbr_hn_tun:
        call tb_route_row_tunnel;
        jmp tbr_hn_out;
      tbr_hn_src:
        call tb_route_row_source;
        jmp tbr_hn_out;
      tbr_hn_snk:
        call tb_route_row_sink;
        jmp tbr_hn_out;
      tbr_hn_stt:
        call tb_route_row_state;
        jmp tbr_hn_out;

      tbr_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  tbr_hn_denied;
        xor rax, rax;
        jmp tbr_hn_out;

      tbr_hn_res:
        mov rax, 0xFFFFF9AE;
        jmp tbr_hn_out;
      tbr_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp tbr_hn_out;
      tbr_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      tbr_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
