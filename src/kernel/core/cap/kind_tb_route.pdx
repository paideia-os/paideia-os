// src/kernel/core/cap/kind_tb_route.pdx — R35.M3-004 (#1208)
//
// KIND_TB_ROUTE = 0x16D, derived over KIND_IPC_ENDPOINT (5).
//
// The authority a ring-3 TB4 supervisor holds to record ONE established
// TB4 tunnel — its route_key, the KIND_IPC_ENDPOINT cap slot that
// delivers tunnel events (endpoint_slot), the 24-bit Thunderbolt
// route_id (five bits per hop, USB4 §5, twelve hops max), the tunnel
// type ordinal (PCIe / DP / USB3), the source and sink adapter
// ordinals, and the tunnel's current lifecycle state (negotiating /
// active / torn).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A TB4 tunnel is not a hardware object the OS can point at; it is a
// negotiated agreement between two adapters within a router tree that
// this pair of ports will carry PCIe / DP / USB3 traffic across the
// domain. The three tunnel-establishment scaffolds (pcie_tunnel.pdx,
// dp_tunnel.pdx, usb3_tunnel.pdx) mint tunnels in the driver-facing
// bookkeeping; the CAPABILITY that names one — for revocation, for
// event delivery, for teardown authorisation — is this kind. Same
// discipline as KIND_ISOCH_STREAM over USB endpoints: the driver owns
// the queue, but the AUTHORITY over its lifecycle is a capability.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// Like KIND_PCIE_HOTPLUG_EVENT, KIND_HID_EVENT, KIND_EC_QUERY and
// KIND_FW_SESSION, THE KIND HALF OF THE GATE DISCRIMINATES NOTHING on
// its own — every endpoint in the machine is kind 5, the shell's
// stdout included — so the mint additionally requires:
//
//   (a) route_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (BAD_ENDPOINT); the slot is stashed on the row and used by
//       the tunnel-event fanout path to reach the subscriber
//   (c) route_id fits in 24 bits — five bits per hop, twelve hops max
//       per USB4 §5 (BAD_ROUTE)
//   (d) tunnel_type in {0,1,2} — PCIe / DP / USB3 (BAD_TUNNEL)
//   (e) source_adapter and sink_adapter fit in u8 (BAD_ADAPTER)
//   (f) source_adapter != sink_adapter — SELF-LOOP refused (BAD_ADAPTER)
//   (g) state in {0,1,2} — NEGOTIATING / ACTIVE / TORN (BAD_STATE)
//   (h) rights subset of R_TB_ROUTE_ALL
//
// The parent is KIND_IPC_ENDPOINT rather than KIND_TB_DOMAIN because
// this kind's PRIMARY function on the invoke path is to deliver
// tunnel-lifecycle events to a subscriber; the parent must be the
// endpoint the events arrive on. A future refinement can add a
// second-cap gate demanding a KIND_TB_DOMAIN also be presented at
// mint (the way KIND_EC_QUERY demands a KIND_OP_REGION) — the row's
// route_id field is the anchor that would make that check meaningful.
//
// =============================================================================
// §2  STATE IS THE ONE DYNAMIC FIELD
// =============================================================================
//
// route_key, endpoint_slot, route_id, tunnel_type, source_adapter and
// sink_adapter are ROW IDENTITY, frozen at mint. state moves
// through {NEGOTIATING → ACTIVE → TORN} as pcie_tunnel /dp_tunnel /
// usb3_tunnel establishment completes and as route_teardown.pdx
// tears down, but the transition primitive is NOT on this kind:
// kind_tb_route exposes only ROW ACCESSORS and a COUNTER, and the
// state field is the record of decisions taken by the tunnel-
// establishment / teardown scaffolds through their own audited paths.
// Same discipline as KIND_TB_DOMAIN's state field.
//
// =============================================================================
// §3  LEAF OF THE TB TUNNEL LATTICE
// =============================================================================
//
// R_TB_ROUTE_MINT (0x200) is DELIBERATELY ABSENT from R_TB_ROUTE_ALL:
// nothing derives from a tb-route cap in this milestone. Same
// discipline KIND_TB_DOMAIN / KIND_FP_SENSOR / KIND_USB_URB /
// KIND_ISOCH_STREAM applied for the same reason.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF9A0..0xFFFFF9AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: pcie_tunnel 0xFFFFF990..9F,
// dp_tunnel 0xFFFFF980..8F, usb3_tunnel 0xFFFFF970..7F,
// route_teardown 0xFFFFF960..6F; adjacent used band above:
// tb_topology_channel 0xFFFFF9B0..BF).

module KindTbRoute = structure {

  pub let KIND_TB_ROUTE         : u64 = 0x16D
  pub let TB_ROUTE_PARENT_KIND  : u64 = 5           // = KIND_IPC_ENDPOINT

  // Tunnel type ordinals (§1.d).
  pub let TB_ROUTE_TUNNEL_PCIE : u64 = 0
  pub let TB_ROUTE_TUNNEL_DP   : u64 = 1
  pub let TB_ROUTE_TUNNEL_USB3 : u64 = 2
  pub let TB_ROUTE_TUNNEL_MAX  : u64 = 2

  // State ordinals (§2).
  pub let TB_ROUTE_STATE_NEGOTIATING : u64 = 0
  pub let TB_ROUTE_STATE_ACTIVE      : u64 = 1
  pub let TB_ROUTE_STATE_TORN        : u64 = 2
  pub let TB_ROUTE_STATE_MAX         : u64 = 2

  // Route bounds. 24 bits total (§1.c).
  pub let TB_ROUTE_BITS : u64 = 24
  pub let TB_ROUTE_MAX  : u64 = 0xFFFFFF

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_TB_ROUTE_READ    : u64 = 0x001
  pub let R_TB_ROUTE_INVOKE  : u64 = 0x008
  pub let R_TB_ROUTE_REVOKE  : u64 = 0x010
  pub let R_TB_ROUTE_OBSERVE : u64 = 0x400
  pub let R_TB_ROUTE_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let TB_RTE_OP_QUERY_KEY       : u64 = 0
  pub let TB_RTE_OP_QUERY_ENDPOINT  : u64 = 1
  pub let TB_RTE_OP_QUERY_ROUTE     : u64 = 2
  pub let TB_RTE_OP_QUERY_TUNNEL    : u64 = 3
  pub let TB_RTE_OP_QUERY_SOURCE    : u64 = 4
  pub let TB_RTE_OP_QUERY_SINK      : u64 = 5
  pub let TB_RTE_OP_QUERY_STATE     : u64 = 6
  pub let TB_RTE_OP_QUERY_PARENT    : u64 = 7
  pub let TB_RTE_OP_DEBUG_PRINT     : u64 = 8
  pub let TB_RTE_OP_MAX             : u64 = 8

  // Failure taxonomy — 0xFFFFF9A0..0xFFFFF9AF.
  pub let TB_RTE_OK                 : u64 = 0
  pub let TB_RTE_TAIL_ENOSPC        : u64 = 0xFFFFF9AF
  pub let TB_RTE_TAIL_BAD_ARG       : u64 = 0xFFFFF9AE
  pub let TB_RTE_MINT_BAD_PARENT    : u64 = 0xFFFFF9AD
  pub let TB_RTE_MINT_BAD_RIGHTS    : u64 = 0xFFFFF9AC
  pub let TB_RTE_MINT_BAD_ROUTE     : u64 = 0xFFFFF9AB
  pub let TB_RTE_MINT_BAD_TUNNEL    : u64 = 0xFFFFF9AA
  pub let TB_RTE_MINT_BAD_ADAPTER   : u64 = 0xFFFFF9A9
  pub let TB_RTE_MINT_BAD_STATE     : u64 = 0xFFFFF9A8
  pub let TB_RTE_MINT_BAD_ENDPOINT  : u64 = 0xFFFFF9A7
  pub let TB_RTE_MINT_NO_KEY        : u64 = 0xFFFFF9A6
  pub let TB_RTE_MINT_ENOSPC        : u64 = 0xFFFFF9A5
  pub let TB_RTE_MINT_IN_USE        : u64 = 0xFFFFF9A4
  pub let TB_RTE_BAD_SLOT           : u64 = 0xFFFFF9A3
  pub let TB_RTE_WRONG_KIND         : u64 = 0xFFFFF9A2
  pub let TB_RTE_REVOKE_ALREADY     : u64 = 0xFFFFF9A1

  pub let TB_RTE_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TB_RTE_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  route_key
  //   [+16] body word 1: endpoint_slot[31:0] | route_id[55:32]
  //                     | tunnel_type[63:56]
  //   [+24] body word 2: source_adapter[7:0] | sink_adapter[15:8]
  //                     | state[23:16] | reserved[63:24]
  pub let TB_RTE_MAX       : u64 = 8
  pub let TB_RTE_ROW_BYTES : u64 = 32

  pub let mut _tb_route_table : [u64; 32] = uninit @align(64)
  pub let mut _tb_route_stats : [u64; 4]  = uninit @align(64)

  pub let TB_RTE_ST_MINTS   : u64 = 0
  pub let TB_RTE_ST_REVOKES : u64 = 1
  pub let TB_RTE_ST_IN_USE  : u64 = 2
  pub let TB_RTE_ST_ENOSPC  : u64 = 3

  pub let tb_rte_dbg_msg : [u8; 14] = "TB ROUTE ROW\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let tb_route_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): clear the TB ROUTE row table and its counters. Boot and teardown only. Labels prefixed tbr_rs_.",
      block: {
        lea r10, [rip + _tb_route_table];
        xor rax, rax;
        xor rcx, rcx;
      tbr_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  tbr_rs_rows;

        lea r10, [rip + _tb_route_stats];
        xor rcx, rcx;
      tbr_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  tbr_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let tb_route_route_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): 1 iff r fits in 24 bits (USB4 §5 route). Labels prefixed tbr_rv_.",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  tbr_rv_no;
        mov rax, 1;
        ret;
      tbr_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_route_tunnel_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): 1 iff t in {0,1,2} (PCIe/DP/USB3). Labels prefixed tbr_tv_.",
      block: {
        cmp rdi, 2;
        ja  tbr_tv_no;
        mov rax, 1;
        ret;
      tbr_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_route_adapter_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): 1 iff a fits in u8. Labels prefixed tbr_av_.",
      block: {
        cmp rdi, 0xFF;
        ja  tbr_av_no;
        mov rax, 1;
        ret;
      tbr_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_route_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): 1 iff s in {0,1,2} (NEGOTIATING/ACTIVE/TORN). Labels prefixed tbr_sv_.",
      block: {
        cmp rdi, 2;
        ja  tbr_sv_no;
        mov rax, 1;
        ret;
      tbr_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_route_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): subset test against R_TB_ROUTE_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — this kind is a leaf (§3). Labels prefixed tbr_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne tbr_rgv_no;
        mov rax, 1;
        ret;
      tbr_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let tb_route_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): counter bump. Labels prefixed tbr_nt_.",
      block: {
        cmp rdi, 4;
        jae tbr_nt_out;
        lea r10, [rip + _tb_route_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tbr_nt_out:
        ret
      }
    }

  pub let tb_route_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): counter read. Labels prefixed tbr_st_.",
      block: {
        cmp rdi, 4;
        jae tbr_st_zero;
        lea r10, [rip + _tb_route_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tbr_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_IPC_ENDPOINT with RIGHT_MINT.
  // ==========================================================================

  pub let tb_route_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): §1 gate. parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Kind check alone discriminates NOTHING; the mint's additional gates cover the rest. Labels prefixed tbr_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tbr_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne tbr_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  tbr_cp_no;

        mov rax, 1;
        ret;
      tbr_cp_no:
        xor rax, rax;
        ret
      }
    }

  // Verify that a candidate endpoint_slot names a live KIND_IPC_ENDPOINT
  // with RIGHT_MINT. Structurally identical to check_parent — this is
  // the second-cap gate that stashes endpoint_slot on the row.
  pub let tb_route_check_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (endpoint_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M3-004 (#1208): §1.b gate. endpoint_slot must be a live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed tbr_ce_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tbr_ce_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne tbr_ce_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  tbr_ce_no;

        mov rax, 1;
        ret;
      tbr_ce_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let tb_route_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): (parent_slot << 8). Labels prefixed tbr_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae tbr_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      tbr_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let tb_route_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (route_id: u64) (tunnel_type: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): pack endpoint_slot[31:0] | route_id[55:32] | tunnel_type[63:56]. Refuses out-of-range fields. Labels prefixed tbr_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  tbr_b1_bad;
        mov r10, 0xFFFFFF;
        cmp rsi, r10;
        ja  tbr_b1_bad;
        cmp rdx, 2;
        ja  tbr_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      tbr_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let tb_route_body2_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (source_adapter: u64) (sink_adapter: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-004 (#1208): pack source_adapter[7:0] | sink_adapter[15:8] | state[23:16]. Reserved [63:24] left zero. Refuses out-of-range fields. Labels prefixed tbr_b2_.",
      block: {
        cmp rdi, 0xFF;
        ja  tbr_b2_bad;
        cmp rsi, 0xFF;
        ja  tbr_b2_bad;
        cmp rdx, 2;
        ja  tbr_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      tbr_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/valid/free.
  //
  // THE ONE WRITER of _tb_route_table. tools/build.sh confines
  // relocations against `_tb_route_table` to this object.
  // ==========================================================================

  pub let tb_route_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (route_key: u64) (body1_packed: u64) (body2_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): claim one TB ROUTE row. THE ONE WRITER of _tb_route_table. Gates: hdr in_use pre-set -> BAD_ARG; route_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows of 32 bytes. Labels prefixed tbr_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // route_key
        mov r14, rdx;                    // body1
        mov r15, rcx;                    // body2

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne tbr_ta_bad;

        cmp r13, 0;
        je  tbr_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  tbr_ta_bad;
        cmp r15, r10;
        je  tbr_ta_bad;

        xor rbx, rbx;
      tbr_ta_scan:
        cmp rbx, 8;
        jae tbr_ta_enospc;

        lea r10, [rip + _tb_route_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tbr_ta_claim;

        add rbx, 1;
        jmp tbr_ta_scan;

      tbr_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp tbr_ta_out;

      tbr_ta_enospc:
        mov rax, 0xFFFFF9AF;
        jmp tbr_ta_out;
      tbr_ta_bad:
        mov rax, 0xFFFFF9AE;

      tbr_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_route_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): 1 iff row_id < MAX and in_use. Labels prefixed tbr_tvr_.",
      block: {
        cmp rdi, 8;
        jae tbr_tvr_no;
        lea r10, [rip + _tb_route_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tbr_tvr_no;
        mov rax, 1;
        ret;
      tbr_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_route_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): scrub one row. Labels prefixed tbr_tf_.",
      block: {
        cmp rdi, 8;
        jae tbr_tf_out;
        lea r10, [rip + _tb_route_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      tbr_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let tb_route_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): route_key. Labels prefixed tbr_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call tb_route_tail_valid;
        cmp rax, 0;
        je  tbr_rk_bad;
        lea r10, [rip + _tb_route_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp tbr_rk_out;
      tbr_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tbr_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let tb_route_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-004 (#1208): endpoint_slot. Labels prefixed tbr_re_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
