// src/kernel/core/cap/kind_bt_pairing.pdx — R39.M4-002 (#1336)
//
// KIND_BT_PAIRING = 0x17D, SEALED, derived over KIND_MEMORY (base slot 4).
//
// The authority to hold ONE Bluetooth LE Secure Connections pairing
// record (pair_key, memory_slot naming the backing store, peer BD_ADDR,
// ltk_algo, bond_flag) WITHOUT the LTK bytes.  A holder can identify
// the pairing, can point at the KIND_MEMORY slot that names its
// backing store, can query its algorithm / bond flag / peer address --
// but CANNOT extract the LTK material.  A crypto server (R32) is the
// one process that unseals and programs the link-layer encryption
// registers; every other holder passes the SEALED reference across a
// boundary that never carries raw material.
//
// =============================================================================
// §0  WHY THIS KIND IS SEALED
// =============================================================================
//
// A BT LE Long-Term Key is a shared secret that authorises link-layer
// encryption on a bonded connection.  A capability that let its holder
// read the bytes would be equivalent to the bytes themselves.  Mirrors
// the KIND_WIFI_KEY (0x17B) SEALED discipline exactly.
//
// The seal is enforced structurally in three ways:
//
//   (1) R_BTP_READ is DELIBERATELY ABSENT from R_BTP_ALL.  A mint
//       request with R_READ set trips the subset test and is refused
//       BTP_MINT_BAD_RIGHTS.
//   (2) There is NO op in this kind that reads LTK material.  The
//       enumerated op set covers pair_key, memory_slot, peer_addr,
//       algo, bond_flag, sealed_flag, bind_to_link, debug_print --
//       none expose the LTK bytes.  An op above BTP_OP_MAX returns
//       UNSUPPORTED.
//   (3) The row itself carries sealed_flag = 1 in body1[55:48], set
//       by btp_body1_pack and never rewritten.
//
// =============================================================================
// §1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The gate demands `kind == KIND_MEMORY (4)` carrying RIGHT_MINT.  A
// mint additionally requires:
//
//   (a) pair_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) memory_slot names a live KIND_MEMORY (BAD_MEMORY)
//   (c) peer_addr[47:0] non-zero (BAD_PEER); the all-zero BD_ADDR is
//       reserved by BT §1.2
//   (d) ltk_algo in {0=AES-CCM-128, 1=AES-CCM-256} (BAD_ALGO)
//   (e) bond_flag in {0, 1} (BAD_BOND) -- 1 iff the pairing is a bond
//   (f) sealed_flag frozen at 1 (SEALED)
//   (g) rights subset of R_BTP_ALL; NO R_READ; NO R_MINT
//
// =============================================================================
// §2  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  pair_key    (u64)
//   [+16] body1:   memory_slot[31:0] | ltk_algo[39:32] | bond_flag[47:40]
//                | sealed_flag[55:48]=1 | reserved[63:56]
//   [+24] body2:   peer_addr[47:0] | reserved[63:48]
//
// Every field is set once at mint and no primitive in this module
// mutates any of them.  Revoke scrubs the entire row.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF2F0..0xFFFFF2FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: bt_gatt_channel
// 0xFFFFF300..0x30F; adjacent free band below: lesc pairing driver
// 0xFFFFF2E0..0x2EF).

module KindBtPairing = structure {

  pub let KIND_BT_PAIRING        : u64 = 0x17D
  pub let BT_PAIRING_PARENT_KIND : u64 = 4        // = KIND_MEMORY

  // §1d algorithm ordinals.
  pub let BTP_ALGO_AES_CCM_128   : u64 = 0
  pub let BTP_ALGO_AES_CCM_256   : u64 = 1
  pub let BTP_ALGO_MAX           : u64 = 1

  // §1e bond flag values.
  pub let BTP_BOND_NO            : u64 = 0
  pub let BTP_BOND_YES           : u64 = 1
  pub let BTP_BOND_MAX           : u64 = 1

  // Rights.  SEALED: R_READ (0x001) OUTSIDE the mask, R_MINT (0x200) OUTSIDE
  // the mask.  The absence of R_READ is the whole point of the SEAL.
  pub let R_BTP_INVOKE  : u64 = 0x008
  pub let R_BTP_REVOKE  : u64 = 0x010
  pub let R_BTP_OBSERVE : u64 = 0x400
  pub let R_BTP_ALL     : u64 = 0x418
  pub let R_BTP_READ    : u64 = 0x001            // SEALED gate refuses
  pub let R_BTP_MINT    : u64 = 0x200            // never granted on a leaf pairing

  // Ops -- NO LTK-reading op exists.
  pub let BTP_OP_QUERY_KEY         : u64 = 0
  pub let BTP_OP_QUERY_MEMORY      : u64 = 1
  pub let BTP_OP_QUERY_PEER_HI     : u64 = 2
  pub let BTP_OP_QUERY_PEER_LO     : u64 = 3
  pub let BTP_OP_QUERY_ALGO        : u64 = 4
  pub let BTP_OP_QUERY_BOND        : u64 = 5
  pub let BTP_OP_QUERY_SEALED_FLAG : u64 = 6
  pub let BTP_OP_BIND_TO_LINK      : u64 = 7
  pub let BTP_OP_DEBUG_PRINT       : u64 = 8
  pub let BTP_OP_MAX               : u64 = 8

  // Failure taxonomy 0xFFFFF2F0..0xFFFFF2FF.
  pub let BTP_OK                : u64 = 0
  pub let BTP_TAIL_ENOSPC       : u64 = 0xFFFFF2FF
  pub let BTP_TAIL_BAD_ARG      : u64 = 0xFFFFF2FE
  pub let BTP_MINT_BAD_PARENT   : u64 = 0xFFFFF2FD
  pub let BTP_MINT_BAD_RIGHTS   : u64 = 0xFFFFF2FC
  pub let BTP_MINT_BAD_MEMORY   : u64 = 0xFFFFF2FB
  pub let BTP_MINT_BAD_PEER     : u64 = 0xFFFFF2FA
  pub let BTP_MINT_BAD_ALGO     : u64 = 0xFFFFF2F9
  pub let BTP_MINT_BAD_BOND     : u64 = 0xFFFFF2F8
  pub let BTP_MINT_NO_KEY       : u64 = 0xFFFFF2F7
  pub let BTP_MINT_IN_USE       : u64 = 0xFFFFF2F6
  pub let BTP_MINT_ENOSPC       : u64 = 0xFFFFF2F5
  pub let BTP_BAD_SLOT          : u64 = 0xFFFFF2F4
  pub let BTP_WRONG_KIND        : u64 = 0xFFFFF2F3
  pub let BTP_REVOKE_ALREADY    : u64 = 0xFFFFF2F2
  pub let BTP_OP_UNSUPPORTED    : u64 = 0xFFFFF2F1
  pub let BTP_RESERVED_A        : u64 = 0xFFFFF2F0

  pub let BTP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let BTP_ROW_NONE   : u64 = 0xFF

  pub let KBTP_MAX       : u64 = 8
  pub let BTP_ROW_BYTES  : u64 = 32

  pub let mut _bt_pairing_table : [u64; 32] = uninit @align(64)
  pub let mut _bt_pairing_stats : [u64; 4]  = uninit @align(64)

  pub let BTP_ST_MINTS   : u64 = 0
  pub let BTP_ST_REVOKES : u64 = 1
  pub let BTP_ST_REFUSED : u64 = 2
  pub let BTP_ST_QUERIES : u64 = 3

  pub let bt_pairing_dbg_msg : [u8; 15] = "BT PAIRING ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bt_pairing_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): clear KIND_BT_PAIRING row table and counters. Labels prefixed btp_rs_.",
      block: {
        lea r10, [rip + _bt_pairing_table];
        xor rax, rax;
        xor rcx, rcx;
      btp_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  btp_rs_rows;

        lea r10, [rip + _bt_pairing_stats];
        xor rcx, rcx;
      btp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  btp_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let btp_algo_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): 1 iff a <= BTP_ALGO_MAX. Labels prefixed btp_av_.",
      block: {
        cmp rdi, 1;
        ja  btp_av_no;
        mov rax, 1;
        ret;
      btp_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let btp_bond_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): 1 iff b <= BTP_BOND_MAX (1). Labels prefixed btp_bv_.",
      block: {
        cmp rdi, 1;
        ja  btp_bv_no;
        mov rax, 1;
        ret;
      btp_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let btp_peer_valid : (u64) -> u64 !{} @{} =
    fn (addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): 1 iff addr fits 48 bits AND is non-zero (BT reserves all-zero BD_ADDR). Labels prefixed btp_pv_.",
      block: {
        cmp rdi, 0;
        je  btp_pv_no;
        mov r10, 0xFFFFFFFFFFFF;
        mov rax, rdi;
        and rax, r10;
        cmp rax, rdi;
        jne btp_pv_no;
        mov rax, 1;
        ret;
      btp_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let btp_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): subset test against R_BTP_ALL = 0x418. SEALED: R_READ (0x001) OUTSIDE the mask -- any mint request carrying R_READ fails here. Labels prefixed btp_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x418;
        and rax, r10;
        cmp rax, rdi;
        jne btp_rgv_no;
        mov rax, 1;
        ret;
      btp_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let btp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): counter bump. Labels prefixed btp_nt_.",
      block: {
        cmp rdi, 4;
        jae btp_nt_out;
        lea r10, [rip + _bt_pairing_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      btp_nt_out:
        ret
      }
    }

  pub let btp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): counter read. Labels prefixed btp_stt_.",
      block: {
        cmp rdi, 4;
        jae btp_stt_zero;
        lea r10, [rip + _bt_pairing_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      btp_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent + KIND_MEMORY gates.
  // ==========================================================================

  pub let btp_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): parent must be live KIND_MEMORY (4) with RIGHT_MINT. Labels prefixed btp_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae btp_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;
        jne btp_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  btp_cp_no;

        mov rax, 1;
        ret;
      btp_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let btp_check_memory : (u64) -> u64 !{mem} @{cap} =
    fn (memory_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): memory_slot must name a live KIND_MEMORY (4). Labels prefixed btp_cm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae btp_cm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;
        jne btp_cm_no;

        mov rax, 1;
        ret;
      btp_cm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  pub let btp_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): (parent_slot << 8). Labels prefixed btp_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae btp_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      btp_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // Body1: memory_slot[31:0] | ltk_algo[39:32] | bond_flag[47:40] |
  //        sealed_flag[55:48]=1 | reserved[63:56]=0.
  pub let btp_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (memory_slot: u64) (ltk_algo: u64) (bond_flag: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): pack body1. sealed_flag FROZEN at 1 -- the SEAL is a row-level invariant that no path in this module rewrites. Labels prefixed btp_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  btp_b1_bad;
        cmp rsi, 0xFF;
        ja  btp_b1_bad;
        cmp rdx, 0xFF;
        ja  btp_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;

        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;

        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;

        // sealed_flag frozen at 1 in [55:48].
        mov r10, 1;
        shl r10, 48;
        or  rax, r10;

        ret;
      btp_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let btp_body2_pack : (u64) -> u64 !{} @{} =
    fn (peer_addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): pack peer_addr[47:0] | reserved[63:48]=0. Labels prefixed btp_b2_.",
      block: {
        mov r10, 0xFFFFFFFFFFFF;
        cmp rdi, r10;
        ja  btp_b2_bad;
        mov rax, rdi;
        and rax, r10;
        ret;
      btp_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _bt_pairing_table.
  // ==========================================================================

  pub let btp_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (pair_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): claim one KIND_BT_PAIRING row. THE ONE WRITER. Labels prefixed btp_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne btp_ta_bad;

        cmp r13, 0;
        je  btp_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  btp_ta_bad;
        cmp r15, r10;
        je  btp_ta_bad;

        xor rbx, rbx;
      btp_ta_scan:
        cmp rbx, 8;
        jae btp_ta_enospc;

        lea r10, [rip + _bt_pairing_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  btp_ta_claim;

        add rbx, 1;
        jmp btp_ta_scan;

      btp_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp btp_ta_out;

      btp_ta_enospc:
        mov rax, 0xFFFFF2FF;
        jmp btp_ta_out;
      btp_ta_bad:
        mov rax, 0xFFFFF2FE;

      btp_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let btp_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): 1 iff row_id<MAX and in_use. Labels prefixed btp_tvr_.",
      block: {
        cmp rdi, 8;
        jae btp_tvr_no;
        lea r10, [rip + _bt_pairing_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  btp_tvr_no;
        mov rax, 1;
        ret;
      btp_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let btp_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): scrub one row. Labels prefixed btp_tf_.",
      block: {
        cmp rdi, 8;
        jae btp_tf_out;
        lea r10, [rip + _bt_pairing_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      btp_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.  None of them expose LTK material.
  // ==========================================================================

  pub let btp_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): pair_key. Labels prefixed btp_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_rk_bad;
        lea r10, [rip + _bt_pairing_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp btp_rk_out;
      btp_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      btp_rk_out:
        pop r12;
        ret
      }
    }

  pub let btp_row_memory : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): memory_slot (body1[31:0]). Labels prefixed btp_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_rm_bad;
        lea r10, [rip + _bt_pairing_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp btp_rm_out;
      btp_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      btp_rm_out:
        pop r12;
        ret
      }
    }

  pub let btp_row_algo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): ltk_algo (body1[39:32]). Labels prefixed btp_ra_.",
      block: {
        push r12;
        mov r12, rdi;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_ra_bad;
        lea r10, [rip + _bt_pairing_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFF;
        jmp btp_ra_out;
      btp_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      btp_ra_out:
        pop r12;
        ret
      }
    }

  pub let btp_row_bond : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): bond_flag (body1[47:40]). Labels prefixed btp_rb_.",
      block: {
        push r12;
        mov r12, rdi;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_rb_bad;
        lea r10, [rip + _bt_pairing_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 40;
        and rax, 0xFF;
        jmp btp_rb_out;
      btp_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      btp_rb_out:
        pop r12;
        ret
      }
    }

  pub let btp_row_sealed_flag : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): sealed_flag (body1[55:48]). SEALED §0 gate 3: frozen at 1 at mint. Labels prefixed btp_rsf_.",
      block: {
        push r12;
        mov r12, rdi;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_rsf_bad;
        lea r10, [rip + _bt_pairing_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp btp_rsf_out;
      btp_rsf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      btp_rsf_out:
        pop r12;
        ret
      }
    }

  pub let btp_row_peer : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): peer_addr (body2[47:0]). Labels prefixed btp_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_rp_bad;
        lea r10, [rip + _bt_pairing_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        mov r11, 0xFFFFFFFFFFFF;
        and rax, r11;
        jmp btp_rp_out;
      btp_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      btp_rp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let btp_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (pair_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-002 (#1336): live row holding pair_key, or ROW_NONE. Labels prefixed btp_fk_.",
      block: {
        cmp rdi, 0;
        je  btp_fk_none;
        xor rcx, rcx;
      btp_fk_scan:
        cmp rcx, 8;
        jae btp_fk_none;
        lea r10, [rip + _bt_pairing_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  btp_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  btp_fk_hit;
      btp_fk_next:
        add rcx, 1;
        jmp btp_fk_scan;
      btp_fk_hit:
        mov rax, rcx;
        ret;
      btp_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let btp_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): slot -> row_id, gated on live KIND_BT_PAIRING. Labels prefixed btp_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae btp_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x17D;
        cmp r10, r11;
        jne btp_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_ros_none;

        mov rax, r12;
        jmp btp_ros_out;

      btp_ros_none:
        mov rax, 0xFF;
      btp_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Six args: (slot, parent_slot, rights, pair_key, memory_slot,
  // meta).  meta packs peer_addr LOW 24 bits [23:0], plus algo[31:24]
  // + bond[39:32]; the FULL peer_addr comes on the last arg via a
  // wrapper (below).  For the inner form, meta packs:
  //
  //   meta[7:0]   = algo
  //   meta[15:8]  = bond_flag
  //   meta[63:16] = peer_addr (48 bits)
  //
  // A caller that packs meta from validated fields cannot smuggle
  // extra bits; the callee unpacks with 0xFF / 0xFFFFFFFFFFFF masks.
  //
  // Sequence: slot<256; rights_valid (SEALED gate 1: R_READ absent
  // from R_BTP_ALL); check_parent; check_memory; algo/bond/peer
  // validators; pair_key non-zero (NO_KEY); uniqueness (IN_USE);
  // body1_pack (SEALED gate 3: sealed_flag frozen at 1); tail_alloc;
  // cap_mint_write.
  // ==========================================================================

  // Helper packer for meta.
  pub let btp_meta_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (algo: u64) (bond: u64) (peer_addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-002 (#1336): pack (algo, bond, peer_addr) into one u64. Labels prefixed btp_mp_.",
      block: {
        cmp rdi, 0xFF;
        ja  btp_mp_bad;
        cmp rsi, 0xFF;
        ja  btp_mp_bad;
        mov r10, 0xFFFFFFFFFFFF;
        cmp rdx, r10;
        ja  btp_mp_bad;

        mov rax, rdi;
        and rax, 0xFF;

        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;

        mov r10, rdx;
        mov r11, 0xFFFFFFFFFFFF;
        and r10, r11;
        shl r10, 16;
        or  rax, r10;
        ret;
      btp_mp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let bt_pairing_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (pair_key: u64) (memory_slot: u64) (meta: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): mint KIND_BT_PAIRING. SEALED TRIPLE-CHECK -- gate 1: R_READ absent from R_BTP_ALL (rights_valid refuses); gate 2: no LTK-read op exists; gate 3: sealed_flag frozen at 1 in the row body. Labels prefixed btp_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // pair_key
        mov rbp, r8;                     // memory_slot
        mov r15, r9;                     // meta

        mov r10, 256;
        cmp rbx, r10;
        jae btp_mi_bad_slot;

        // SEALED gate 1: rights subset of R_BTP_ALL.  R_READ (0x001)
        // OUTSIDE the mask -- a request carrying R_READ trips here.
        mov rdi, r13;
        call btp_rights_valid;
        cmp rax, 0;
        je  btp_mi_bad_rights;

        mov rdi, r12;
        call btp_check_parent;
        cmp rax, 0;
        je  btp_mi_bad_parent;

        mov rdi, rbp;
        call btp_check_memory;
        cmp rax, 0;
        je  btp_mi_bad_memory;

        // Unpack meta.
        mov rdi, r15;
        and rdi, 0xFF;                   // algo
        call btp_algo_valid;
        cmp rax, 0;
        je  btp_mi_bad_algo;

        mov rdi, r15;
        shr rdi, 8;
        and rdi, 0xFF;                   // bond
        call btp_bond_valid;
        cmp rax, 0;
        je  btp_mi_bad_bond;

        mov rdi, r15;
        shr rdi, 16;
        mov r10, 0xFFFFFFFFFFFF;
        and rdi, r10;                    // peer_addr
        call btp_peer_valid;
        cmp rax, 0;
        je  btp_mi_bad_peer;

        cmp r14, 0;
        je  btp_mi_no_key;

        mov rdi, r14;
        call btp_find_by_key;
        cmp rax, 0xFF;
        jne btp_mi_in_use;

        // Body1 pack: (memory_slot, algo, bond).
        mov rdi, rbp;
        mov rsi, r15;
        and rsi, 0xFF;                   // algo
        mov rdx, r15;
        shr rdx, 8;
        and rdx, 0xFF;                   // bond
        call btp_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  btp_mi_bad_algo;
        push rax;                        // body1 on stack

        // Body2 pack: peer_addr.
        mov rdi, r15;
        shr rdi, 16;
        mov r10, 0xFFFFFFFFFFFF;
        and rdi, r10;
        call btp_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  btp_mi_bad_peer_pop;
        push rax;                        // body2 on stack

        // Header.
        mov rdi, r12;
        call btp_hdr_pack;
        pop r11;                         // body2
        pop rbp;                         // body1 (overwrite -- rbp no longer needed)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  btp_mi_bad_parent;

        // tail_alloc(hdr, pair_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r11;
        call btp_tail_alloc;

        mov r10, 0xFFFFF2FF;
        cmp rax, r10;
        je  btp_mi_enospc;
        mov r10, 0xFFFFF2FE;
        cmp rax, r10;
        je  btp_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x17D;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call btp_note;

        xor rax, rax;
        jmp btp_mi_out;

      btp_mi_bad_peer_pop:
        add rsp, 8;
        jmp btp_mi_bad_peer;

      btp_mi_bad_slot:
        mov rax, 0xFFFFF2F4;
        jmp btp_mi_out;
      btp_mi_bad_parent:
        mov rax, 0xFFFFF2FD;
        jmp btp_mi_out;
      btp_mi_bad_rights:
        mov rdi, 2;
        call btp_note;
        mov rax, 0xFFFFF2FC;
        jmp btp_mi_out;
      btp_mi_bad_memory:
        mov rax, 0xFFFFF2FB;
        jmp btp_mi_out;
      btp_mi_bad_peer:
        mov rax, 0xFFFFF2FA;
        jmp btp_mi_out;
      btp_mi_bad_algo:
        mov rax, 0xFFFFF2F9;
        jmp btp_mi_out;
      btp_mi_bad_bond:
        mov rax, 0xFFFFF2F8;
        jmp btp_mi_out;
      btp_mi_no_key:
        mov rax, 0xFFFFF2F7;
        jmp btp_mi_out;
      btp_mi_in_use:
        mov rdi, 2;
        call btp_note;
        mov rax, 0xFFFFF2F6;
        jmp btp_mi_out;
      btp_mi_enospc:
        mov rdi, 2;
        call btp_note;
        mov rax, 0xFFFFF2F5;
        jmp btp_mi_out;
      btp_mi_bad_arg:
        mov rax, 0xFFFFF2FE;

      btp_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Audited outer mint -- wraps inner with drv_audit_emit(1, kind, slot, parent, result).
  pub let bt_pairing_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (pair_key: u64) (memory_slot: u64) (meta: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): audited mint. Wraps _inner with one drv_audit_emit record per attempt. Labels prefixed btp_am_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot

        call bt_pairing_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x17D;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let bt_pairing_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): revoke KIND_BT_PAIRING. Scrubs row and cap_table entry. Labels prefixed btp_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae btp_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  btp_rvk_already;

        mov r11, 0x17D;
        cmp r10, r11;
        jne btp_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call btp_tail_valid;
        cmp rax, 0;
        je  btp_rvk_clear;

        mov rdi, r13;
        call btp_tail_free;

      btp_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call btp_note;

        xor rax, rax;
        jmp btp_rvk_out;

      btp_rvk_bad_slot:
        mov rax, 0xFFFFF2F4;
        jmp btp_rvk_out;
      btp_rvk_wrong_kind:
        mov rax, 0xFFFFF2F3;
        jmp btp_rvk_out;
      btp_rvk_already:
        mov rax, 0xFFFFF2F2;

      btp_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let bt_pairing_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): audited revoke. Wraps _inner with one drv_audit_emit record. Labels prefixed btp_ar_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;

        call bt_pairing_cap_revoke_inner;
        mov r13, rax;

        mov rdi, 2;
        mov rsi, 0x17D;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r13;
        call drv_audit_emit;

        mov rax, r13;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  SEALED: NO OP READS LTK MATERIAL.  Every op above
  // BTP_OP_MAX returns UNSUPPORTED.  Every op with a non-zero
  // op_arg[63:8] is REFUSED as TAIL_BAD_ARG.
  // ==========================================================================

  pub let cap_handler_bt_pairing : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R39.M4-002 (#1336): KIND_BT_PAIRING dispatch. SEALED: NO OP exposes LTK material. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE; BIND_TO_LINK requires INVOKE (crypto-server-scope pin). All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed btp_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_bt_pairing_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne btp_hn_res;

        cmp rbp, 8;
        ja  btp_hn_unsup;

        cmp rbp, 8;
        je  btp_hn_dbg;

        // Ops 0..7: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  btp_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  btp_hn_key;
        cmp rbp, 1;
        je  btp_hn_mem;
        cmp rbp, 2;
        je  btp_hn_peer_hi;
        cmp rbp, 3;
        je  btp_hn_peer_lo;
        cmp rbp, 4;
        je  btp_hn_algo;
        cmp rbp, 5;
        je  btp_hn_bond;
        cmp rbp, 6;
        je  btp_hn_sflag;
        // rbp == 7: BIND_TO_LINK.  Honesty pin: returns 0 until R32
        // crypto server unseals + programs the link encryption regs.
        xor rax, rax;
        jmp btp_hn_out;

      btp_hn_key:
        call btp_row_key;
        jmp btp_hn_out;
      btp_hn_mem:
        call btp_row_memory;
        jmp btp_hn_out;
      btp_hn_peer_hi:
        call btp_row_peer;
        shr rax, 24;
        and rax, 0xFFFFFF;
        jmp btp_hn_out;
      btp_hn_peer_lo:
        call btp_row_peer;
        and rax, 0xFFFFFF;
        jmp btp_hn_out;
      btp_hn_algo:
        call btp_row_algo;
        jmp btp_hn_out;
      btp_hn_bond:
        call btp_row_bond;
        jmp btp_hn_out;
      btp_hn_sflag:
        call btp_row_sealed_flag;
        jmp btp_hn_out;

      btp_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  btp_hn_denied;
        xor rax, rax;
        jmp btp_hn_out;

      btp_hn_res:
        mov rax, 0xFFFFF2FE;
        jmp btp_hn_out;
      btp_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp btp_hn_out;
      btp_hn_unsup:
        mov rax, 0xFFFFF2F1;

      btp_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
