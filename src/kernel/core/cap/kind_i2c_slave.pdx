// src/kernel/core/cap/kind_i2c_slave.pdx — R30.M5-002 (#1071)
//
// KIND_I2C_SLAVE derived kind: authority over ONE address on ONE bus.
//
// ---------------------------------------------------------------------
// THE PROPERTY THIS FILE EXISTS TO MAKE TRUE
// ---------------------------------------------------------------------
//   A holder of a slave capability can address the device its
//   capability names, and cannot address any other device on the bus.
//
// On a shared two-wire bus that property is not a natural consequence
// of anything. The controller can address every peripheral on it; the
// wire has no protection domain; a transaction to the wrong address
// looks, from the controller's side, exactly like a transaction to the
// right one. Per-device isolation on I²C therefore has to be
// manufactured entirely inside the capability system, and this file is
// where it is manufactured.
//
// The mechanism is one sentence:
//
//   THE ADDRESS COMES FROM THE CAPABILITY ROW, NEVER FROM THE CALLER.
//
// `i2c_slave_addr_of_slot(slot)` and `i2c_slave_row_addr(row_id)` take
// no address argument, and neither does any op on the capability. There
// is no code path in this kernel by which a caller states an address
// and gets it used. "Talk to a different address than my capability
// names" is not a request that is refused — it is a request that cannot
// be phrased.
//
// This is the discipline R30.M4-003 (#1068) established for the GSI
// inherited from a parent KIND_HW_INTERRUPT, applied to the field that
// selects a device on a shared bus. tools/build.sh pins the arity of
// the two address resolvers with a literal signature check, so a mutant
// that adds an address parameter fails the build rather than the review
// — see the `i2c-addr-confine` step there.
//
// The address IS an argument at MINT, and that is the only place it can
// be. Minting is the authorising moment: it is gated on the parent
// KIND_I2C_BUS capability with RIGHT_MINT, and it is where the platform
// decides that this driver owns this device. Once minted, the row is
// the only remaining source of truth.
//
// ---------------------------------------------------------------------
// WHAT A SLAVE CAPABILITY DOES **NOT** YET PERMIT
// ---------------------------------------------------------------------
// This milestone is capability STRUCTURE only. Holding a
// KIND_I2C_SLAVE today permits exactly:
//
//   * reading back the row's own address, addressing mode, parent bus
//     and driver hint (RIGHT_INVOKE);
//   * the canonical debug dump (RIGHT_OBSERVE);
//   * being revoked (RIGHT_REVOKE).
//
// It does NOT permit, and there is no code that would honour:
//
//   * any transaction on the wire — no read, no write, no combined
//     write-then-read, no SMBus block transfer. R30.M5-004 (#1073)
//     defines the transfer channel;
//   * bringing the controller up, programming its clock divider, or
//     touching any controller register. Those live behind the parent
//     KIND_DEVICE capability's BARs, which R30.M5-003 (#1072) maps;
//   * deriving anything. This kind is a LEAF of the derivation lattice
//     and carries no MINT right at all;
//   * bus-level operations of any sort — resetting the bus, changing
//     its speed, or enumerating its other devices. A slave holder
//     cannot even count its siblings.
//
// RIGHT_READ and RIGHT_WRITE ARE nevertheless in R_I2C_SLAVE_ALL, and
// nothing in this milestone consumes them. That is deliberate rather
// than aspirational: reserving them NOW means a capability minted today
// with rights 0x418 (INVOKE|REVOKE|OBSERVE) will still be refused a
// transfer when #1073 lands, because the transfer op will demand bits
// this capability was never given. If the bits were added later
// instead, every already-minted slave capability would either have to
// be re-minted or would silently acquire transfer authority on the day
// the op appeared. Reserving the bits keeps existing capabilities'
// authority STABLE across the addition, which is the property that
// matters.
//
// ---------------------------------------------------------------------
// ADDRESSING — what is legal, and what is refused per range
// ---------------------------------------------------------------------
// SEVEN-BIT MODE (I2C_ADDR_MODE_7BIT = 0). The numeric range is
// 0x00..0x7F, but the I²C specification reserves both ends:
//
//   0x00        general call address / START byte
//   0x01        CBUS address
//   0x02        reserved for a different bus format
//   0x03        reserved for future purposes
//   0x04..0x07  Hs-mode master codes
//   0x78..0x7B  10-bit slave addressing prefix (11110xx)
//   0x7C..0x7F  reserved for future purposes / device ID
//
// So the usable device range is 0x08..0x77, and this kind refuses
// everything else — with a DIFFERENT code per range, because the two
// ends fail for different reasons and an operator debugging a bad ACPI
// _CRS wants to know which:
//
//   0x00..0x07  -> I2C_SLAVE_MINT_ADDR_RESERVED_LOW
//   0x78..0x7F  -> I2C_SLAVE_MINT_ADDR_RESERVED_HIGH
//   > 0x7F      -> I2C_SLAVE_MINT_ADDR_RANGE
//
// Refusing rather than masking is the same argument KIND_OP_REGION's
// no-clipping rule makes: a driver that asked for 0x00 and was silently
// given 0x40 would be talking to a device it does not own, and the
// first symptom would appear in the OTHER device's driver.
//
// The high reserved range matters more than it looks. 0x78..0x7B is
// the 10-BIT ADDRESSING PREFIX. A 7-bit capability minted at 0x78 would
// put the controller into a state where the following byte is
// interpreted as the low half of a 10-bit address — that is, it would
// let a capability naming one 7-bit address reach an entire 256-address
// space. Refusing it is not spec pedantry; it is the confinement
// property.
//
// TEN-BIT MODE (I2C_ADDR_MODE_10BIT = 1). The range is 0x000..0x3FF and
// all of it is usable: the 11110xx prefix is what distinguishes the
// mode on the wire, so a 10-bit address does not collide with any
// 7-bit device address. Anything above 0x3FF -> I2C_SLAVE_MINT_ADDR_RANGE.
//
// A mode other than 0 or 1 -> I2C_SLAVE_MINT_BAD_MODE.
//
// ---------------------------------------------------------------------
// ADDRESS COLLISION — the second mint is REFUSED
// ---------------------------------------------------------------------
// Two live slave capabilities for the same (bus, mode, address) are
// refused with I2C_SLAVE_MINT_ADDR_IN_USE. The uniqueness key is
// (parent_row, mode, addr) — SCOPED TO THE BUS, not global.
//
// Why refuse rather than permit sharing. An I²C peripheral is not a
// stateless register file: the near-universal access pattern is "write
// the register pointer, then read", which is two transactions with
// device-side state between them. Two independent owners interleaving
// those sequences do not get a race that shows up as an error; they get
// each other's data, silently, in whichever direction the arbitration
// happened to fall. There is no protocol-level way for either driver to
// detect it. A device that genuinely must be shared needs an ARBITER —
// one holder of the slave capability that serialises access and exposes
// its own interface — and an arbiter is a thing you build, not a thing
// you get by minting the capability twice. Permitting the second mint
// would make the broken configuration the easy one.
//
// Why the key is scoped to the bus. Address 0x1A on the touchpad's
// controller and address 0x1A on the sensor hub's controller are two
// different devices on two different pairs of wires, and there is no
// sense in which they conflict. A global address table would reject the
// second one, which is not a conservative failure — it would make a
// perfectly ordinary board unbootable. The scan in
// `i2c_slave_addr_in_use` compares parent_row first for exactly this
// reason.
//
// Why MODE is in the key. A 7-bit device at 0x1A and a 10-bit device at
// 0x01A are addressed by different byte sequences on the wire (the
// latter carries the 11110xx prefix), so they are distinct devices and
// may coexist on one bus. Leaving mode out of the key would refuse a
// legal configuration.
//
// ---------------------------------------------------------------------
// DERIVATION — over KIND_I2C_BUS, and the cascade
// ---------------------------------------------------------------------
// The gate demands `kind == KIND_I2C_BUS (0x152)` carrying RIGHT_MINT.
// A component that does not hold the bus cannot mint reach to anything
// on it.
//
// Revoking the bus CASCADES to every slave derived from it —
// `i2c_bus_cap_revoke_inner` calls `i2c_slave_cascade_revoke_by_bus_row`
// before it frees its own row. This is the KIND_HW_INTERRUPT /
// KIND_HW_MSIX_VECTOR pair's shape (#1019/#1022): the parent's teardown
// reaches the children, because a child that outlived its parent is a
// live handle to hardware whose only justification has been destroyed.
//
// The cascade has TWO PHASES and both are necessary:
//
//   Phase 1 sweeps by DESCRIPTOR — every cap_table slot holding a
//   KIND_I2C_SLAVE whose row records this bus row.
//
//   Phase 2 sweeps by ROW — every live row recording this bus row, even
//   if no descriptor points at it any more. Phase 2 is what makes "no
//   row leak" structural rather than probable: a descriptor that was
//   cleared by some other path would otherwise strand its row forever,
//   and a stranded row still occupies an address on a bus that no
//   longer exists, so the next mint at that address would be refused
//   IN_USE by a ghost.
//
// A single level suffices. KIND_I2C_SLAVE is a leaf — it carries no
// MINT right — so unlike KIND_OP_REGION there are no grandchildren and
// no fixed point to reach.
//
// ---------------------------------------------------------------------
// DESCRIPTOR TAIL — row indirection (the R29/R30 family shape)
// ---------------------------------------------------------------------
// Row layout — `_i2c_slave_table[row_id]`, 32 bytes (four u64s):
//
//   [+0]  u64:  bits [7:0]   = parent_slot  (cap_table slot of the
//                                            KIND_I2C_BUS at mint time;
//                                            recorded for audit and
//                                            query, NOT used as the
//                                            cascade key)
//               bits [23:8]  = parent_row   (u16; row_id in
//                                            _i2c_bus_table — the true
//                                            parent identity and the
//                                            cascade / uniqueness key,
//                                            because a cap slot can be
//                                            reused by a different bus
//                                            while a row_id cannot be
//                                            while it is live)
//               bits [39:24] = addr         (u16; <= 0x7F in 7-bit
//                                            mode, <= 0x3FF in 10-bit)
//               bits [47:40] = mode         (u8; 0 = 7-bit, 1 = 10-bit)
//               bits [55:48] = reserved (must be zero)
//               bits [63:56] = in_use       (0 = free, 1 = allocated)
//   [+8]  u64:  driver_hint — opaque owner identity, non-zero. What the
//               R31 binder will match a driver against. Zero is refused
//               at allocation: zero is the "unclaimed" sentinel, and a
//               capability that is both minted and unclaimed is a state
//               with no meaning that every later binder would have to
//               special-case.
//   [+16] u64:  reserved (must be zero) — R30.M5-004 transfer counters.
//   [+24] u64:  reserved (must be zero) — R30.M5-004 transfer counters.
//
// ---------------------------------------------------------------------
// RIGHTS
// ---------------------------------------------------------------------
//   R_I2C_SLAVE_READ    (0x001) — reserved for #1073's transfer channel
//   R_I2C_SLAVE_WRITE   (0x002) — reserved for #1073's transfer channel
//   R_I2C_SLAVE_INVOKE  (0x008) — the query ops
//   R_I2C_SLAVE_REVOKE  (0x010) — teardown
//   R_I2C_SLAVE_OBSERVE (0x400) — the canonical printer
//   R_I2C_SLAVE_ALL     (0x41B) — bitwise OR of the five.
//
// RIGHT_MINT (0x200) IS ABSENT AND ITS ABSENCE IS STRUCTURAL. This kind
// is the bottom of the derivation lattice: there is nothing below a
// single address on a single bus. A MINT bit here would be a bit no
// gate reads, which is the shape that later acquires a meaning nobody
// audited.
//
// READ and WRITE are separate because a read-only sensor capability and
// a read-write configuration capability are different authorities over
// the same device, and folding them would make "may sample the
// temperature but may never write the calibration registers"
// inexpressible.
//
// ---------------------------------------------------------------------
// TABLE SIZING
// ---------------------------------------------------------------------
// I2C_SLAVE_MAX = 32. Four times I2C_BUS_MAX, which covers a realistic
// T14 G4 population (touchpad, touchscreen, sensor hub, fingerprint
// reader, one or two power-management parts) with headroom, and matches
// the R30 fixture-scale sizing. Storage: 32 * 32 = 1024 bytes .bss,
// align 64.
//
// tools/build.sh asserts with `objdump -r` that no kernel object other
// than kind_i2c_slave.o relocates against `_i2c_slave_table`. That is
// what makes "the address lives in the row and the row is reachable
// only through this module's functions" a property of the kernel rather
// than of one file.

module KindI2cSlave = structure {

  // ==========================================================================
  // Kind tags
  //
  // 0x153 is the fourth entry in the R30 derived-kind block, after
  // KIND_OP_REGION (0x150), KIND_ACPI_EVENT (0x151) and KIND_I2C_BUS
  // (0x152). Above the 4-bit base-slot range, so the LAM kind-hint is
  // unaffected.
  // ==========================================================================

  pub let KIND_I2C_SLAVE : u64 = 0x153   // derived-kind tag (decimal 339)

  // The parent kind. A DERIVED tag, not a base slot: a slave is reach
  // to one address on a specific bus, and that bus is itself a derived
  // capability with its own gate.
  pub let I2C_SLAVE_PARENT_KIND : u64 = 0x152   // = KIND_I2C_BUS

  // ==========================================================================
  // Rights
  // ==========================================================================

  pub let R_I2C_SLAVE_READ    : u64 = 0x001
  pub let R_I2C_SLAVE_WRITE   : u64 = 0x002
  pub let R_I2C_SLAVE_INVOKE  : u64 = 0x008
  pub let R_I2C_SLAVE_REVOKE  : u64 = 0x010
  pub let R_I2C_SLAVE_OBSERVE : u64 = 0x400
  pub let R_I2C_SLAVE_ALL     : u64 = 0x41B

  // ==========================================================================
  // Addressing
  // ==========================================================================

  pub let I2C_ADDR_MODE_7BIT  : u64 = 0
  pub let I2C_ADDR_MODE_10BIT : u64 = 1

  pub let I2C_ADDR7_FIRST_USABLE : u64 = 0x08
  pub let I2C_ADDR7_LAST_USABLE  : u64 = 0x77
  pub let I2C_ADDR7_MAX          : u64 = 0x7F
  pub let I2C_ADDR10_MAX         : u64 = 0x3FF

  // ==========================================================================
  // Table caps
  // ==========================================================================

  pub let I2C_SLAVE_MAX       : u64 = 32
  pub let I2C_SLAVE_ROW_BYTES : u64 = 32

  // ==========================================================================
  // Return codes
  //
  // Block 0xFFFFFF70..0xFFFFFF7F — sixteen codes, exactly the width of
  // the band, and disjoint from I2C_BUS_* (0xFFFFFF80..8F) directly
  // above it as well as from ACPI_EVT_* (0xFFFFFF90..9F), DRV_RESTART_*
  // (0xFFFFFFB5..BE), OPREG_* (0xFFFFFFC2..CF), DMA_* (0xFFFFFFD5..DF),
  // MSIX_* (0xFFFFFFE7..EF) and HW_INT_* (0xFFFFFFF7..FF). A witness
  // failure therefore names its originating kind unambiguously, which
  // matters more here than usual because the bus and the slave refuse
  // for structurally similar reasons and a shared band would make
  // "which of the two refused" a guess.
  // ==========================================================================

  pub let I2C_SLAVE_OK                       : u64 = 0
  pub let I2C_SLAVE_TAIL_ENOSPC              : u64 = 0xFFFFFF7F
  pub let I2C_SLAVE_TAIL_BAD_ARG             : u64 = 0xFFFFFF7E
  pub let I2C_SLAVE_MINT_BAD_PARENT          : u64 = 0xFFFFFF7D
  pub let I2C_SLAVE_MINT_BAD_RIGHTS          : u64 = 0xFFFFFF7C
  pub let I2C_SLAVE_MINT_BAD_ARG             : u64 = 0xFFFFFF7B
  pub let I2C_SLAVE_MINT_ENOSPC              : u64 = 0xFFFFFF7A
  pub let I2C_SLAVE_MINT_BAD_MODE            : u64 = 0xFFFFFF79
  pub let I2C_SLAVE_MINT_ADDR_RANGE          : u64 = 0xFFFFFF78
  pub let I2C_SLAVE_MINT_ADDR_RESERVED_LOW   : u64 = 0xFFFFFF77
  pub let I2C_SLAVE_MINT_ADDR_RESERVED_HIGH  : u64 = 0xFFFFFF76
  pub let I2C_SLAVE_MINT_ADDR_IN_USE         : u64 = 0xFFFFFF75
  pub let I2C_SLAVE_MINT_BAD_HINT            : u64 = 0xFFFFFF74
  pub let I2C_SLAVE_REVOKE_BAD_SLOT          : u64 = 0xFFFFFF73
  pub let I2C_SLAVE_REVOKE_WRONG_KIND        : u64 = 0xFFFFFF72
  pub let I2C_SLAVE_REVOKE_ALREADY           : u64 = 0xFFFFFF71
  pub let I2C_SLAVE_BUS_LOST                 : u64 = 0xFFFFFF70

  pub let I2C_SLAVE_DECODE_BAD               : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Ops (op_arg[7:0] = op_code) and their required right
  //
  // QUERY ONLY, AND NONE OF THEM TAKES AN OPERAND. `op_arg` is masked
  // to its low byte on entry to the handler, so the fifty-six bits a
  // caller might try to hide an address in are discarded before any
  // dispatch decision is made. There is no transfer op — see the module
  // header's "does not yet permit" section.
  // ==========================================================================

  pub let I2C_SLAVE_OP_QUERY_ADDR   : u64 = 0   // INVOKE  -> addr (from the row)
  pub let I2C_SLAVE_OP_QUERY_MODE   : u64 = 1   // INVOKE  -> addressing mode
  pub let I2C_SLAVE_OP_QUERY_BUS    : u64 = 2   // INVOKE  -> parent bus cap slot
  pub let I2C_SLAVE_OP_QUERY_HINT   : u64 = 3   // INVOKE  -> driver hint
  pub let I2C_SLAVE_OP_DEBUG_PRINT  : u64 = 4   // OBSERVE -> printer

  // ==========================================================================
  // Backing table (.bss, align 64) — MODULE-PRIVATE BY CONSTRUCTION.
  //
  // 32 rows * 32 bytes = 1024 bytes = 128 u64s. .bss zero-init means
  // every row starts in_use = 0, the free sentinel the allocator scans
  // for.
  //
  // THIS IS THE ONLY PLACE IN THE KERNEL WHERE AN I²C DEVICE ADDRESS
  // LIVES, and tools/build.sh asserts it with `objdump -r`.
  // ==========================================================================

  pub let mut _i2c_slave_table : [u64; 128] = uninit @align(64)

  // ==========================================================================
  // Canonical debug-printer strings (.rodata)
  // ==========================================================================

  pub let i2cs_dbg_msg : [u8; 14] = "I2C SLAVE ROW\0"
  pub let i2cs_k_row   : [u8; 4]  = "row\0"
  pub let i2cs_k_bus   : [u8; 4]  = "bus\0"
  pub let i2cs_k_adr   : [u8; 4]  = "adr\0"
  pub let i2cs_k_mod   : [u8; 4]  = "mod\0"

  // ==========================================================================
  // i2c_slave_table_reset() -> ()
  // ==========================================================================

  pub let i2c_slave_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): zero all 128 u64s of _i2c_slave_table, returning every row to the free state the .bss zero-init established. Exists so the boot witness can start from a known table and so a failing witness cannot poison a later one -- the same posture acpi_evt_table_reset established in #1068. Note that this does NOT decrement any bus's num_slaves: it is a table reset, not a revoke, and it is called only by fixture setup where the bus table is being reset in the same breath. Loop over 128 qwords. Leaf. Reserved labels: i2cs_tr_.",
      block: {
        lea r8, [rip + _i2c_slave_table];
        xor rax, rax;
        xor rcx, rcx;

      i2cs_tr_loop:
        cmp rcx, 128;
        jae i2cs_tr_done;
        mov [r8], rax;
        add r8, 8;
        add rcx, 1;
        jmp i2cs_tr_loop;

      i2cs_tr_done:
        ret
      }
    }

  // ==========================================================================
  // i2c_addr_check(mode, addr) -> 0 (legal) | I2C_SLAVE_MINT_*
  //
  // THE ADDRESS POLICY, as one function. Returns the SPECIFIC refusal
  // code per range rather than a boolean, so the mint path can hand the
  // caller the reason without a second classification pass.
  // ==========================================================================

  pub let i2c_addr_check : (u64, u64) -> u64 !{} @{} =
    fn (mode: u64) (addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-002 (#1071): the single source of truth for which I2C addresses this kind admits. mode 0 (7-bit): addr > 0x7F -> I2C_SLAVE_MINT_ADDR_RANGE; addr <= 0x07 -> I2C_SLAVE_MINT_ADDR_RESERVED_LOW (general call 0x00, CBUS 0x01, other-bus-format 0x02, future 0x03, Hs-mode master codes 0x04..0x07); addr >= 0x78 -> I2C_SLAVE_MINT_ADDR_RESERVED_HIGH (0x78..0x7B is the 11110xx TEN-BIT ADDRESSING PREFIX, 0x7C..0x7F is reserved/device-ID); otherwise 0. mode 1 (10-bit): addr > 0x3FF -> I2C_SLAVE_MINT_ADDR_RANGE, otherwise 0 -- the whole 10-bit space is usable because the prefix distinguishes the mode on the wire, so no 10-bit address collides with a 7-bit device address. Any other mode -> I2C_SLAVE_MINT_BAD_MODE. Three distinct address codes rather than one because the two reserved ends fail for different reasons and an operator debugging a bad ACPI _CRS needs to know which; and because the HIGH range is the confinement-critical one -- a 7-bit capability at 0x78 would put the controller into 10-bit framing, letting a capability that names one address reach a 256-address space. Refusal, never masking: a driver silently moved from 0x00 to 0x40 would be talking to a device it does not own, and the first symptom would surface in the OTHER driver. Pure leaf. rdi=mode, rsi=addr. Reserved labels: i2cs_ac_.",
      block: {
        cmp rdi, 0;
        je i2cs_ac_7bit;
        cmp rdi, 1;
        je i2cs_ac_10bit;

        mov rax, 0xFFFFFF79;             // I2C_SLAVE_MINT_BAD_MODE
        ret;

      i2cs_ac_7bit:
        mov r10, 0x7F;
        cmp rsi, r10;
        ja i2cs_ac_range;
        mov r10, 0x08;                   // first usable 7-bit address
        cmp rsi, r10;
        jb i2cs_ac_res_low;              // 0x00..0x07
        mov r10, 0x78;
        cmp rsi, r10;
        jae i2cs_ac_res_high;            // 0x78..0x7F
        xor rax, rax;
        ret;

      i2cs_ac_10bit:
        mov r10, 0x3FF;
        cmp rsi, r10;
        ja i2cs_ac_range;
        xor rax, rax;
        ret;

      i2cs_ac_range:
        mov rax, 0xFFFFFF78;             // I2C_SLAVE_MINT_ADDR_RANGE
        ret;

      i2cs_ac_res_low:
        mov rax, 0xFFFFFF77;             // I2C_SLAVE_MINT_ADDR_RESERVED_LOW
        ret;

      i2cs_ac_res_high:
        mov rax, 0xFFFFFF76;             // I2C_SLAVE_MINT_ADDR_RESERVED_HIGH
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_rights_valid(rights) -> u64
  // ==========================================================================

  pub let i2c_slave_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-002 (#1071): 1 iff (rights & R_I2C_SLAVE_ALL) == rights. R_I2C_SLAVE_ALL = 0x41B (READ|WRITE|INVOKE|REVOKE|OBSERVE). A subset test, so a read-only sensor capability is expressible. RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is the bottom of the derivation lattice, nothing derives from a single address on a single bus, and a MINT bit no gate reads is the shape that later acquires a meaning nobody audited. READ and WRITE are inside the mask although nothing in this milestone consumes them -- see the module header: reserving them now is what keeps an already-minted capability's authority stable on the day #1073's transfer op appears, instead of silently widening it. Pure leaf. Reserved labels: i2cs_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne i2cs_rv_no;
        mov rax, 1;
        ret;

      i2cs_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_check_parent_bus(parent_slot) -> u64
  //
  // THE DERIVATION GATE. 1 iff cap_table[parent_slot] is a
  // KIND_I2C_BUS carrying RIGHT_MINT.
  // ==========================================================================

  pub let i2c_slave_check_parent_bus : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): the KIND_I2C_SLAVE derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_I2C_BUS (0x152) AND (rights & RIGHT_MINT 0x200) != 0. Compares against the DERIVED tag rather than the base kind KIND_DEVICE, and that distinction is the whole gate: a raw KIND_DEVICE holder must not be able to mint a slave, because it would then be minting device reach without ever having established that the controller in question is an I2C controller at a validated bus rate -- the bus capability is the proof that step happened. This is the same conflation opregion_cap_derive avoids when it declines to reuse opregion_check_parent_base. Pure read. Reserved labels: i2cs_cpb_.",
      block: {
        cmp rdi, 256;
        jae i2cs_cpb_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x152;                  // KIND_I2C_BUS
        cmp r10, r11;
        jne i2cs_cpb_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je i2cs_cpb_no;

        mov rax, 1;
        ret;

      i2cs_cpb_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_tail_pack(parent_slot, parent_row, addr, mode)
  //   -> hdr | I2C_SLAVE_DECODE_BAD
  // ==========================================================================

  pub let i2c_slave_tail_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (parent_slot: u64) (parent_row: u64) (addr: u64) (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-002 (#1071): canonical KIND_I2C_SLAVE header-word encoder. Validates parent_slot < 256, parent_row <= 0xFFFF, mode <= 1, and the CROSS-FIELD rule that the address must be legal for the mode -- i2c_addr_check(mode, addr) must return 0. That last rule is why this is an encoder and not four shifts at the call site: a row carrying a 7-bit mode and an address of 0x200 would be a capability whose recorded address cannot be put on the wire in its recorded framing, and every consumer would then have to decide independently what to do about it. Making the combination unrepresentable is cheaper than agreeing on a repair. Pack: parent_slot | (parent_row << 8) | (addr << 24) | (mode << 40). Bits [55:48] left clear as reserved and [63:56] left clear for the allocator's in_use flag. Five pushes (rbx, r12, r13, r14, r15) hold the four fields across the nested address check and leave rsp%16 == 0 at it. Reserved labels: i2cs_tp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // parent_row
        mov r14, rdx;                    // addr
        mov r15, rcx;                    // mode

        cmp r12, 256;
        jae i2cs_tp_bad;
        mov rbx, 0xFFFF;
        cmp r13, rbx;
        ja i2cs_tp_bad;
        cmp r15, 1;
        ja i2cs_tp_bad;

        // Cross-field rule: the address must be legal for the mode.
        mov rdi, r15;
        mov rsi, r14;
        call i2c_addr_check;
        cmp rax, 0;
        jne i2cs_tp_bad;

        mov rax, r12;
        and rax, 0xFF;                   // parent_slot

        mov rbx, r13;
        mov r10, 0xFFFF;
        and rbx, r10;
        shl rbx, 8;
        or  rax, rbx;                    // | parent_row << 8

        mov rbx, r14;
        mov r10, 0xFFFF;
        and rbx, r10;
        shl rbx, 24;
        or  rax, rbx;                    // | addr << 24

        mov rbx, r15;
        and rbx, 0xFF;
        shl rbx, 40;
        or  rax, rbx;                    // | mode << 40

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      i2cs_tp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Header-word field extractors — the decode half of the round-trip.
  // These operate on the WORD, not on a row.
  // ==========================================================================

  pub let i2c_slave_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-002 (#1071): parent_slot from header bits [7:0]. Pure leaf.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let i2c_slave_hdr_parent_row : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-002 (#1071): parent_row from header bits [23:8]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    }

  pub let i2c_slave_hdr_addr : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-002 (#1071): addr from header bits [39:24]. Pure leaf. Takes a header WORD, never a caller-supplied address -- this is a decoder, and the only headers it is ever handed come from live rows.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    }

  pub let i2c_slave_hdr_mode : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-002 (#1071): mode from header bits [47:40]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_tail_alloc(hdr, driver_hint) -> row_id | error
  //
  // THE ONLY WRITER OF _i2c_slave_table. Two callers, both in this
  // file; the mint path is the only one that creates a row, and it has
  // already established the bus authority and the address policy.
  // ==========================================================================

  pub let i2c_slave_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (driver_hint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): allocate and populate a free _i2c_slave_table row. THIS IS THE ONLY FUNCTION IN THE KERNEL THAT WRITES AN I2C DEVICE ADDRESS, which is what makes the bus gate and the address policy upstream of it exhaustive rather than merely usual. Gates, in order: hdr bits [63:56] non-zero -> I2C_SLAVE_TAIL_BAD_ARG (those bits are the allocator's in_use flag; a caller that pre-set them would be handed a row the free scan skips); hdr reserved bits [55:48] non-zero -> I2C_SLAVE_TAIL_BAD_ARG (a reserved bit that is merely ignored is a reserved bit a later revision cannot use); the header's own {mode, addr} pair re-checked through i2c_addr_check -> I2C_SLAVE_TAIL_BAD_ARG, so even a fabricated header cannot land a reserved address in a row; driver_hint == 0 -> I2C_SLAVE_TAIL_BAD_ARG, because zero is the 'unclaimed' sentinel the R31 binder reads and a capability that is both minted and unclaimed is a state with no meaning. Low-first scan over 32 rows of 32 bytes; free iff the in_use byte (byte 7 of [row+0]) is zero; exhaustion -> I2C_SLAVE_TAIL_ENOSPC. Claim: [row+0] = hdr | (1 << 56), [row+8] = driver_hint, [row+16] = 0, [row+24] = 0. Args parked in r14/r15 across the nested address check and the scan; three pushes leave rsp%16 == 0 at that call. Reserved labels: i2cs_ta_.",
      block: {
        push r13;
        push r14;
        push r15;

        mov r14, rdi;                    // hdr
        mov r15, rsi;                    // driver_hint

        // Gate: hdr bits [63:56] must be zero.
        mov r10, r14;
        shr r10, 56;
        cmp r10, 0;
        jne i2cs_ta_bad_arg;

        // Gate: hdr reserved bits [55:48] must be zero.
        mov r10, r14;
        shr r10, 48;
        and r10, 0xFF;
        cmp r10, 0;
        jne i2cs_ta_bad_arg;

        // Gate: driver_hint present.
        cmp r15, 0;
        je i2cs_ta_bad_arg;

        // Gate: the header's own {mode, addr} is admissible.
        mov rdi, r14;
        shr rdi, 40;
        and rdi, 0xFF;                   // mode
        mov rsi, r14;
        shr rsi, 24;
        mov r10, 0xFFFF;
        and rsi, r10;                    // addr
        call i2c_addr_check;
        cmp rax, 0;
        jne i2cs_ta_bad_arg;

        // Row cursor.
        lea r8, [rip + _i2c_slave_table];
        xor rcx, rcx;

      i2cs_ta_scan:
        cmp rcx, 32;                     // I2C_SLAVE_MAX
        jae i2cs_ta_none;
        mov rax, [r8];
        mov r10, rax;
        shr r10, 56;                     // in_use byte
        cmp r10, 0;
        je i2cs_ta_found;
        add r8, 32;                      // I2C_SLAVE_ROW_BYTES
        add rcx, 1;
        jmp i2cs_ta_scan;

      i2cs_ta_found:
        mov rax, r14;
        mov r10, 1;
        shl r10, 56;
        or  rax, r10;
        mov [r8 + 0], rax;               // hdr | in_use

        mov [r8 + 8], r15;               // driver_hint

        xor rax, rax;
        mov [r8 + 16], rax;              // reserved
        mov [r8 + 24], rax;              // reserved

        mov rax, rcx;                    // row_id
        pop r15;
        pop r14;
        pop r13;
        ret;

      i2cs_ta_none:
        mov rax, 0xFFFFFF7F;             // I2C_SLAVE_TAIL_ENOSPC
        pop r15;
        pop r14;
        pop r13;
        ret;

      i2cs_ta_bad_arg:
        mov rax, 0xFFFFFF7E;             // I2C_SLAVE_TAIL_BAD_ARG
        pop r15;
        pop r14;
        pop r13;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_tail_free(row_id) -> ()
  // ==========================================================================

  pub let i2c_slave_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): row_id >= I2C_SLAVE_MAX -> silent no-op. Otherwise zero all four u64s of the row. Zeroing [row+0] clears in_use, so free and SCRUB are the same operation. Scrubbing matters here for a reason specific to this kind: the address is the uniqueness key, so a freed-but-unscrubbed row would keep refusing the next legitimate mint at that address with I2C_SLAVE_MINT_ADDR_IN_USE -- a ghost device that no capability names but that no driver can displace. Leaf. Reserved labels: i2cs_tf_.",
      block: {
        cmp rdi, 32;
        jae i2cs_tf_done;

        mov r8, rdi;
        shl r8, 5;                       // row_id * 32
        lea r9, [rip + _i2c_slave_table];
        add r8, r9;

        xor rax, rax;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;

      i2cs_tf_done:
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_tail_valid(row_id) -> u64
  // ==========================================================================

  pub let i2c_slave_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): 1 iff row_id < I2C_SLAVE_MAX and the row's in_use byte is non-zero. Same shape as opregion_tail_valid and acpi_evt_tail_valid. Leaf, pure read. Reserved labels: i2cs_tv_.",
      block: {
        cmp rdi, 32;
        jae i2cs_tv_no;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_slave_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cs_tv_no;

        mov rax, 1;
        ret;

      i2cs_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_rows_live() -> count
  // ==========================================================================

  pub let i2c_slave_rows_live : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): number of _i2c_slave_table rows whose in_use byte is set. The standing observable for row leakage, and the assertion the cascade is checked against: a bus teardown that returns this to its pre-mint value has leaked nothing, and phase 2 of the cascade exists precisely so it always does. Kept as a plain exported query rather than a capability op because it is a property of the TABLE, and putting it behind a capability would let the holder of one device's capability measure how many other devices exist. Leaf, pure read. Reserved labels: i2cs_rl_.",
      block: {
        lea r8, [rip + _i2c_slave_table];
        xor rcx, rcx;
        xor rax, rax;

      i2cs_rl_scan:
        cmp rcx, 32;
        jae i2cs_rl_done;
        mov r10, [r8 + 0];
        shr r10, 56;
        cmp r10, 0;
        je i2cs_rl_next;
        add rax, 1;

      i2cs_rl_next:
        add r8, 32;
        add rcx, 1;
        jmp i2cs_rl_scan;

      i2cs_rl_done:
        ret
      }
    }

  // ==========================================================================
  // Row decoders. Every one bounds-checks and in_use-checks first, and
  // returns I2C_SLAVE_DECODE_BAD on a dead or out-of-range row.
  // ==========================================================================

  pub let i2c_slave_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): raw header word of a LIVE row with the in_use flag stripped, so the value round-trips against i2c_slave_tail_pack's output; I2C_SLAVE_DECODE_BAD otherwise. The other decoders are written in terms of this one so the bounds check and the liveness check exist once and cannot drift apart. Leaf, pure read. Reserved labels: i2cs_rh_.",
      block: {
        cmp rdi, 32;
        jae i2cs_rh_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_slave_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je i2cs_rh_bad;

        mov r10, 0x00FFFFFFFFFFFFFF;
        and rax, r10;
        ret;

      i2cs_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // -- THE ADDRESS RESOLVER, ROW FORM. ARITY ONE, AND tools/build.sh
  //    PINS IT. There is no second parameter for a caller to pass an
  //    address in; the address is read out of the row named by row_id
  //    and nowhere else.
  pub let i2c_slave_row_addr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): THE ADDRESS OF A SLAVE CAPABILITY, read from header bits [39:24] of a live row. I2C_SLAVE_DECODE_BAD on a dead or out-of-range row -- never a plausible zero, which matters because 0x00 is the general-call address and a decoder that returned it for a dead row would be handing back the one address that reaches EVERY device on the bus. ARITY IS ONE AND IT IS LOAD-BEARING: this function has no parameter through which a caller could supply an address, which is what makes 'talk to an address other than the one my capability names' unphrasable rather than merely refused. tools/build.sh asserts the literal signature line of this function and of i2c_slave_addr_of_slot, so a mutant that adds a second parameter fails the build. One push (rbx, unused) aligns the nested call. Reserved labels: i2cs_ra_.",
      block: {
        push rbx;
        call i2c_slave_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cs_ra_out;
        shr rax, 24;
        mov r10, 0xFFFF;
        and rax, r10;
      i2cs_ra_out:
        pop rbx;
        ret
      }
    }

  pub let i2c_slave_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): addressing mode of a live row from header bits [47:40] -- 0 for 7-bit framing, 1 for 10-bit. I2C_SLAVE_DECODE_BAD on a dead row. Carried in the row rather than inferred from the address magnitude, because 7-bit 0x1A and 10-bit 0x01A are the same number and different devices. One push (rbx, unused) aligns the nested call. Reserved labels: i2cs_rm_.",
      block: {
        push rbx;
        call i2c_slave_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cs_rm_out;
        shr rax, 40;
        and rax, 0xFF;
      i2cs_rm_out:
        pop rbx;
        ret
      }
    }

  pub let i2c_slave_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): parent KIND_I2C_BUS cap slot of a live row, from header bits [7:0]. Recorded for audit and query only; the CASCADE key is parent_row, not this, because a cap slot can be reused by a different bus while a live row_id cannot. I2C_SLAVE_DECODE_BAD on a dead row. One push (rbx, unused) aligns the nested call. Reserved labels: i2cs_rp_.",
      block: {
        push rbx;
        call i2c_slave_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cs_rp_out;
        and rax, 0xFF;
      i2cs_rp_out:
        pop rbx;
        ret
      }
    }

  pub let i2c_slave_row_parent_row : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): the _i2c_bus_table row_id this slave was derived from, from header bits [23:8]. THE TRUE PARENT IDENTITY: it is the cascade key and the first term of the (bus, mode, addr) uniqueness key, because it names the bus ROW rather than a capability slot that could later hold a different bus. I2C_SLAVE_DECODE_BAD on a dead row. One push (rbx, unused) aligns the nested call. Reserved labels: i2cs_rpr_.",
      block: {
        push rbx;
        call i2c_slave_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cs_rpr_out;
        shr rax, 8;
        mov r10, 0xFFFF;
        and rax, r10;
      i2cs_rpr_out:
        pop rbx;
        ret
      }
    }

  pub let i2c_slave_row_hint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): opaque driver identity of a live row from [+8]. I2C_SLAVE_DECODE_BAD on a dead or out-of-range row; unambiguous because the allocator refuses a zero hint. Leaf, pure read. Reserved labels: i2cs_rhi_.",
      block: {
        cmp rdi, 32;
        jae i2cs_rhi_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _i2c_slave_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je i2cs_rhi_bad;

        mov rax, [r8 + 8];
        ret;

      i2cs_rhi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_addr_of_slot(slot) -> addr | I2C_SLAVE_DECODE_BAD
  //
  // THE ADDRESS RESOLVER, CAPABILITY FORM — and the function every
  // future transfer path must go through.
  //
  // ARITY ONE. There is no parameter for an address. A caller hands
  // over a capability SLOT and receives the address that capability
  // names; it cannot hand over an address and have it honoured, because
  // there is nowhere to put it.
  // ==========================================================================

  pub let i2c_slave_addr_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): resolve a capability slot to the ONE address that capability authorises. Bounds-check slot < 256; require kind == KIND_I2C_SLAVE (0x153); row_id from target_ptr[15:0]; return i2c_slave_row_addr(row_id). I2C_SLAVE_DECODE_BAD on a bad slot, a wrong kind, or a dead row -- never a plausible address, which matters because 0x00 is the general-call address that reaches every device on the bus. THIS IS THE ADDRESS CONFINEMENT PROPERTY IN ONE FUNCTION: the parameter list is (slot) and nothing else, so a transfer path built on it in R30.M5-004 physically cannot be handed an address by its caller; the only address it can obtain is the one the capability row records. Structurally, 'address a different device than my capability names' is not a refused request -- it is an unphrasable one. tools/build.sh pins the literal signature line of this function, so a mutant that adds an addr parameter fails the build rather than the review. Two pushes plus the return address would misalign; one push (rbx, which also carries the row_id) leaves rsp%16 == 0 at the nested call. Reserved labels: i2cs_aos_.",
      block: {
        push rbx;

        cmp rdi, 256;
        jae i2cs_aos_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x153;                  // KIND_I2C_SLAVE
        cmp r10, r11;
        jne i2cs_aos_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;                    // row_id

        mov rdi, rbx;
        call i2c_slave_row_addr;
        pop rbx;
        ret;

      i2cs_aos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_addr_in_use(bus_row, mode, addr) -> u64
  //
  // 1 iff a LIVE slave row on THIS bus already holds this (mode, addr).
  // The collision test, scoped to the bus.
  // ==========================================================================

  pub let i2c_slave_addr_in_use : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bus_row: u64) (mode: u64) (addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-002 (#1071): linear scan of the 32 slave rows; 1 iff some LIVE row's (parent_row, mode, addr) equals the triple asked about. The key is scoped to the BUS and not global, and both facts are load-bearing. Scoped, because address 0x1A on the touchpad controller and 0x1A on the sensor hub are two devices on two pairs of wires that do not conflict -- a global table would refuse the second and make an ordinary board unbootable, which is not a conservative failure. MODE is in the key because a 7-bit device at 0x1A and a 10-bit device at 0x01A are addressed by different byte sequences on the wire and may legitimately coexist. Dead rows are skipped, which is why i2c_slave_tail_free scrubs rather than merely clearing in_use: a stale address in a freed row would be a ghost device that no capability names and no driver can displace. Linear rather than indexed because 32 rows is small, the scan happens only at mint, and an index would be a second place the truth lives. Leaf, pure read. rdi=bus_row, rsi=mode, rdx=addr. Reserved labels: i2cs_aiu_.",
      block: {
        lea r8, [rip + _i2c_slave_table];
        xor rcx, rcx;

      i2cs_aiu_scan:
        cmp rcx, 32;
        jae i2cs_aiu_no;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je i2cs_aiu_next;                // dead row

        // parent_row (bits [23:8])
        mov r10, rax;
        shr r10, 8;
        mov r11, 0xFFFF;
        and r10, r11;
        cmp r10, rdi;
        jne i2cs_aiu_next;               // a different bus

        // mode (bits [47:40])
        mov r10, rax;
        shr r10, 40;
        and r10, 0xFF;
        cmp r10, rsi;
        jne i2cs_aiu_next;               // a different framing

        // addr (bits [39:24])
        mov r10, rax;
        shr r10, 24;
        mov r11, 0xFFFF;
        and r10, r11;
        cmp r10, rdx;
        jne i2cs_aiu_next;

        mov rax, 1;
        ret;

      i2cs_aiu_next:
        add r8, 32;
        add rcx, 1;
        jmp i2cs_aiu_scan;

      i2cs_aiu_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_cap_mint(slot, parent_slot, rights, addr, mode, driver_hint)
  //   -> u64
  //
  // The address IS an argument HERE and only here. This is the
  // authorising moment: it is gated on the parent KIND_I2C_BUS with
  // RIGHT_MINT, it is where the platform decides which driver owns
  // which device, and after it the row is the only source of truth.
  //
  // SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=addr, r8=mode,
  //       r9=driver_hint.
  // ==========================================================================

  pub let i2c_slave_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (addr: u64) (mode: u64) (driver_hint: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): mint a KIND_I2C_SLAVE. Sequence: (1) slot < 256 else I2C_SLAVE_MINT_BAD_ARG. (2) i2c_slave_check_parent_bus(parent_slot) -- THE DERIVATION GATE -- else I2C_SLAVE_MINT_BAD_PARENT: without the bus capability carrying RIGHT_MINT, reach to a device on that bus cannot be manufactured. (3) i2c_slave_rights_valid(rights) else I2C_SLAVE_MINT_BAD_RIGHTS. (4) i2c_addr_check(mode, addr) -- ITS CODE IS RETURNED VERBATIM, so BAD_MODE / ADDR_RANGE / ADDR_RESERVED_LOW / ADDR_RESERVED_HIGH each reach the caller as themselves rather than collapsing into one 'bad address'. (5) driver_hint != 0 else I2C_SLAVE_MINT_BAD_HINT. (6) bus_row = i2c_bus_row_of_slot(parent_slot) else I2C_SLAVE_BUS_LOST -- a descriptor whose row was already freed passes the kind check but names no bus. (7) i2c_slave_addr_in_use(bus_row, mode, addr) -> I2C_SLAVE_MINT_ADDR_IN_USE: THE SECOND MINT AT AN ADDRESS IS REFUSED, because two independent owners of an I2C peripheral interleave register-pointer-then-read sequences and silently read each other's data, with no protocol-level way for either to notice; a device that must be shared needs an arbiter, which is a thing you build rather than a thing you get by minting twice. (8) i2c_slave_tail_pack + i2c_slave_tail_alloc, translating TAIL codes to distinct MINT codes. (9) i2c_bus_note_slave_added(bus_row) -- the ONLY increment of the bus's live-device count, and it happens after allocation so a refused mint never moves it; if it fails the freshly allocated row is FREED before returning I2C_SLAVE_BUS_LOST, so a failed mint leaks nothing. (10) cap_mint_write(slot, KIND_I2C_SLAVE = 0x153, rights, row_id). Five pushes plus a 32-byte frame (72 bytes total, rsp%16 == 0 at every nested call) hold slot/parent_slot/rights/addr/mode in r12/r13/r14/r15/rbx with driver_hint at [rsp+0], bus_row at [rsp+8] and row_id at [rsp+16]. Reserved labels: i2cs_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov r15, rcx;                    // addr
        mov rbx, r8;                     // mode
        mov [rsp + 0], r9;               // driver_hint

        cmp r12, 256;
        jae i2cs_mi_bad_arg;

        // -- Step 2: THE DERIVATION GATE.
        mov rdi, r13;
        call i2c_slave_check_parent_bus;
        cmp rax, 0;
        je i2cs_mi_bad_parent;

        // -- Step 3: rights subset.
        mov rdi, r14;
        call i2c_slave_rights_valid;
        cmp rax, 0;
        je i2cs_mi_bad_rights;

        // -- Step 4: the address policy. Its code is returned verbatim.
        mov rdi, rbx;                    // mode
        mov rsi, r15;                    // addr
        call i2c_addr_check;
        cmp rax, 0;
        jne i2cs_mi_out;

        // -- Step 5: the driver hint must be present.
        mov r10, [rsp + 0];
        cmp r10, 0;
        je i2cs_mi_bad_hint;

        // -- Step 6: the parent's bus row must still be live.
        mov rdi, r13;
        call i2c_bus_row_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cs_mi_bus_lost;
        mov [rsp + 8], rax;              // bus_row

        // -- Step 7: THE COLLISION TEST, scoped to this bus.
        mov rdi, [rsp + 8];
        mov rsi, rbx;                    // mode
        mov rdx, r15;                    // addr
        call i2c_slave_addr_in_use;
        cmp rax, 0;
        jne i2cs_mi_in_use;

        // -- Step 8: header word, then the row.
        mov rdi, r13;                    // parent_slot
        mov rsi, [rsp + 8];              // parent_row
        mov rdx, r15;                    // addr
        mov rcx, rbx;                    // mode
        call i2c_slave_tail_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je i2cs_mi_bad_arg;

        mov rdi, rax;                    // hdr
        mov rsi, [rsp + 0];              // driver_hint
        call i2c_slave_tail_alloc;

        mov r10, 0xFFFFFF7F;             // I2C_SLAVE_TAIL_ENOSPC
        cmp rax, r10;
        je i2cs_mi_enospc;
        mov r10, 0xFFFFFF7E;             // I2C_SLAVE_TAIL_BAD_ARG
        cmp rax, r10;
        je i2cs_mi_bad_arg;
        mov [rsp + 16], rax;             // row_id

        // -- Step 9: count the device on its bus.
        mov rdi, [rsp + 8];
        call i2c_bus_note_slave_added;
        cmp rax, 0;
        jne i2cs_mi_unwind;

        // -- Step 10: descriptor.
        mov rcx, [rsp + 16];             // target_ptr = row_id
        mov rdi, r12;                    // slot
        mov rsi, 0x153;                  // KIND_I2C_SLAVE
        mov rdx, r14;                    // rights
        call cap_mint_write;

        xor rax, rax;                    // I2C_SLAVE_OK
        jmp i2cs_mi_out;

        // The bus row died between step 6 and step 9. Free the row we
        // just allocated so a failed mint leaks nothing.
      i2cs_mi_unwind:
        mov rdi, [rsp + 16];
        call i2c_slave_tail_free;
        mov rax, 0xFFFFFF70;             // I2C_SLAVE_BUS_LOST
        jmp i2cs_mi_out;

      i2cs_mi_bad_parent:
        mov rax, 0xFFFFFF7D;
        jmp i2cs_mi_out;
      i2cs_mi_bad_rights:
        mov rax, 0xFFFFFF7C;
        jmp i2cs_mi_out;
      i2cs_mi_enospc:
        mov rax, 0xFFFFFF7A;
        jmp i2cs_mi_out;
      i2cs_mi_in_use:
        mov rax, 0xFFFFFF75;
        jmp i2cs_mi_out;
      i2cs_mi_bad_hint:
        mov rax, 0xFFFFFF74;
        jmp i2cs_mi_out;
      i2cs_mi_bus_lost:
        mov rax, 0xFFFFFF70;
        jmp i2cs_mi_out;
      i2cs_mi_bad_arg:
        mov rax, 0xFFFFFF7B;

      i2cs_mi_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let i2c_slave_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (addr: u64) (mode: u64) (driver_hint: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): audited entry point for the slave mint. The audit is the record of WHICH DRIVER WAS GIVEN WHICH DEVICE, and it is the only such record: after this call the address lives in a row the holder cannot restate, so an operator reconstructing 'who was allowed to talk to the fingerprint reader' has this line and nothing else. Refusals are audited too -- an I2C_SLAVE_MINT_ADDR_IN_USE (0xFFFFFF75) line is the trace of a second component trying to claim a device that already has an owner, which is exactly the event worth seeing. Three pushes (r12/r13/r14) leave rsp%16 == 0 at both nested calls; the six SysV argument registers are untouched by the two movs, so the inner body sees them exactly as passed, and r14 carries the inner outcome across drv_audit_emit so the wrapper is return-value transparent. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent bus slot)

        call i2c_slave_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x153;                  // KIND_I2C_SLAVE
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_cap_revoke(slot) -> u64
  // ==========================================================================

  pub let i2c_slave_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): revoke a KIND_I2C_SLAVE. (1) slot < 256 else I2C_SLAVE_REVOKE_BAD_SLOT. (2) descriptor at cap_table + slot*24. (3) kind == 0 -> I2C_SLAVE_REVOKE_ALREADY (idempotent). (4) kind != 0x153 -> I2C_SLAVE_REVOKE_WRONG_KIND, so a slave revoke can never clear a bus descriptor or any other kind's. (5) row_id from target_ptr[15:0]; if the row is live, read its parent_row and call i2c_bus_note_slave_removed BEFORE freeing, then i2c_slave_tail_free to scrub the address out of the table. The note_ result is deliberately NOT propagated: a dead parent row is a legitimate state here, because i2c_bus_cap_revoke_inner cascades through this function while its own row is still live but a caller may equally revoke a slave whose bus was torn down by some other path, and turning that into a failure would make an idempotent teardown non-idempotent. (6) clear the descriptor. Five pushes leave rsp%16 == 0 at every nested call; rbx holds the descriptor base and r13 the row_id across them. Reserved labels: i2cs_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        cmp r12, 256;
        jae i2cs_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je i2cs_rvk_already;

        mov r11, 0x153;                  // KIND_I2C_SLAVE
        cmp r10, r11;
        jne i2cs_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call i2c_slave_tail_valid;
        cmp rax, 0;
        je i2cs_rvk_clear;

        // Decrement the bus's live-device count, then scrub the row.
        mov rdi, r13;
        call i2c_slave_row_parent_row;
        mov rdi, rax;
        call i2c_bus_note_slave_removed;

        mov rdi, r13;
        call i2c_slave_tail_free;

      i2cs_rvk_clear:
        xor rax, rax;
        mov [rbx + 0],  rax;
        mov [rbx + 8],  rax;
        mov [rbx + 16], rax;

        xor rax, rax;                    // I2C_SLAVE_OK
        jmp i2cs_rvk_out;

      i2cs_rvk_bad_slot:
        mov rax, 0xFFFFFF73;
        jmp i2cs_rvk_out;
      i2cs_rvk_wrong_kind:
        mov rax, 0xFFFFFF72;
        jmp i2cs_rvk_out;
      i2cs_rvk_already:
        mov rax, 0xFFFFFF71;

      i2cs_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let i2c_slave_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): audited revoke. The bus cascade calls THIS symbol, so tearing down a controller that owns N devices leaves N slave records plus the bus's own -- the reconciliation property R29.M6-002 established for the DMA cascade, and the one an operator needs when a device stops responding and the question is whether its capability was revoked or its driver crashed. Three pushes (r12/r13/r14) leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call i2c_slave_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x153;                  // KIND_I2C_SLAVE
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_cascade_revoke_by_bus_row(bus_row) -> count
  //
  // Called by i2c_bus_cap_revoke_inner BEFORE the bus row is freed.
  // Two phases: by descriptor, then by row. See the module header for
  // why the second phase is not redundant.
  // ==========================================================================

  pub let i2c_slave_cascade_revoke_by_bus_row : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bus_row: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): revoke every KIND_I2C_SLAVE derived from the given bus ROW, and return how many were reached. PHASE 1 scans cap_table slots 0..255 for kind == 0x153, takes row_id from target_ptr[15:0], skips row_id >= I2C_SLAVE_MAX, reads the row's parent_row from _i2c_slave_table[row_id] header bits [23:8], and calls the audited i2c_slave_cap_revoke on a match. PHASE 2 then scans the 32 rows directly and frees any LIVE row still recording this bus_row, decrementing the bus count for each. Phase 2 is not redundant: a slave descriptor cleared by any other path would otherwise strand its row forever, and a stranded row still occupies an address on a bus that no longer exists, so the next legitimate mint at that address would be refused ADDR_IN_USE by a ghost -- which is how 'no row leak' becomes structural rather than probable. Keying on bus_row rather than on the parent cap SLOT is deliberate: a slot can be reused by a different bus, a live row_id cannot, so the row is the identity that actually binds child to parent. A single level suffices -- KIND_I2C_SLAVE carries no MINT right, so there are no grandchildren and no fixed point to reach, unlike opregion_cascade_revoke_by_parent. Registers: r12 = cursor, r13 = bus_row, r14 = count, rbx = scratch; all callee-save and preserved across the nested revoke, whose clobbers are otherwise unconstrained. Five pushes leave rsp%16 == 0 at every nested call. Reserved labels: i2cs_cs_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r13, rdi;                    // bus_row
        xor r14, r14;                    // count

        // ------------------------------------------------------------
        // PHASE 1 — by descriptor.
        // ------------------------------------------------------------
        xor r12, r12;

      i2cs_cs_scan:
        cmp r12, 256;
        jae i2cs_cs_phase2;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x153;                  // KIND_I2C_SLAVE
        cmp r10, r11;
        jne i2cs_cs_skip;

        mov r10, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and r10, r11;                    // row_id
        cmp r10, 32;                     // I2C_SLAVE_MAX
        jae i2cs_cs_skip;

        // Row header -> parent_row, read directly (we are inside the
        // owning module, so the table access is legitimate here).
        mov r8, r10;
        shl r8, 5;
        lea r9, [rip + _i2c_slave_table];
        add r8, r9;
        mov r11, [r8 + 0];               // hdr

        mov r10, r11;
        shr r10, 56;
        cmp r10, 0;
        je i2cs_cs_skip;                 // dead row

        mov r10, r11;
        shr r10, 8;
        mov rbx, 0xFFFF;
        and r10, rbx;                    // row.parent_row

        cmp r10, r13;
        jne i2cs_cs_skip;

        mov rdi, r12;
        call i2c_slave_cap_revoke;
        add r14, 1;

      i2cs_cs_skip:
        add r12, 1;
        jmp i2cs_cs_scan;

        // ------------------------------------------------------------
        // PHASE 2 — by row. Any LIVE row still naming this bus has no
        // descriptor pointing at it; free it and decrement the bus.
        // ------------------------------------------------------------
      i2cs_cs_phase2:
        xor r12, r12;

      i2cs_cs_rowscan:
        cmp r12, 32;
        jae i2cs_cs_done;

        mov r8, r12;
        shl r8, 5;
        lea r9, [rip + _i2c_slave_table];
        add r8, r9;
        mov r11, [r8 + 0];

        mov r10, r11;
        shr r10, 56;
        cmp r10, 0;
        je i2cs_cs_rownext;              // free already

        mov r10, r11;
        shr r10, 8;
        mov rbx, 0xFFFF;
        and r10, rbx;                    // row.parent_row
        cmp r10, r13;
        jne i2cs_cs_rownext;

        mov rdi, r13;
        call i2c_bus_note_slave_removed;

        mov rdi, r12;
        call i2c_slave_tail_free;
        add r14, 1;

      i2cs_cs_rownext:
        add r12, 1;
        jmp i2cs_cs_rowscan;

      i2cs_cs_done:
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_slave_debug_print(row_id) -> u64
  // ==========================================================================

  pub let i2c_slave_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R30.M5-002 (#1071): canonical debug printer for one slave row. Refuses a dead or out-of-range row with I2C_SLAVE_TAIL_BAD_ARG rather than printing zeroes: a printer that rendered a freed row as {bus 0, adr 0, mod 0} would be showing the GENERAL CALL ADDRESS on bus row 0, which is a plausible-looking line describing a capability that reaches every device on a real bus. Emits four KV lines (row / bus / adr / mod) through klog_s1_x1 so each value is machine-greppable in the smoke log. r12 holds row_id across the four calls; three pushes leave rsp%16 == 0. Reserved labels: i2cs_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call i2c_slave_tail_valid;
        cmp rax, 0;
        je i2cs_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cs_dbg_msg];
        lea rcx, [rip + i2cs_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call i2c_slave_row_parent_row;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cs_dbg_msg];
        lea rcx, [rip + i2cs_k_bus];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call i2c_slave_row_addr;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cs_dbg_msg];
        lea rcx, [rip + i2cs_k_adr];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call i2c_slave_row_mode;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + i2cs_dbg_msg];
        lea rcx, [rip + i2cs_k_mod];
        mov r8, r13;
        call klog_s1_x1;

        xor rax, rax;                    // I2C_SLAVE_OK
        pop r14;
        pop r13;
        pop r12;
        ret;

      i2cs_dp_bad:
        mov rax, 0xFFFFFF7E;             // I2C_SLAVE_TAIL_BAD_ARG
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_i2c_slave(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler. QUERY OPS ONLY, AND NO OP TAKES AN OPERAND.
  //
  // This is the second half of the address-confinement argument. The
  // only caller-controlled word that reaches this function is op_arg,
  // and its top fifty-six bits are discarded before any dispatch
  // decision is made. There is therefore no channel — not an argument,
  // not a packed field, not an out-of-band register — by which the
  // holder of a slave capability can name an address.
  // ==========================================================================

  pub let cap_handler_i2c_slave : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M5-002 (#1071): KIND_I2C_SLAVE dispatch handler. Emits cap_i2c_slave_msg on entry (argument registers saved across klog_s1, which clobbers all three per klog/wrappers.pdx section 5.1). row_id = target_ptr[15:0] -- from the DESCRIPTOR, which only the kernel writes; op = op_arg[7:0], with the upper 56 bits DISCARDED, which is what closes the last channel a caller might use to smuggle an address into the invocation. Ops 0..3 (QUERY_ADDR / MODE / BUS / HINT) require RIGHT_INVOKE (0x008); op 4 (DEBUG_PRINT) requires RIGHT_OBSERVE (0x400). QUERY_ADDR returns the row's own address: it is an introspection op, not an addressing one -- a holder learning which device it owns is not a holder choosing which device to talk to, and there is no transfer op here for the answer to be fed into (R30.M5-004 #1073 adds that, and it will read the row too). Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Every query returns I2C_SLAVE_DECODE_BAD for a dead row, never a plausible zero -- which matters most for QUERY_ADDR, since zero is the general-call address. r12=rights, r13=row_id, r14=op across the klog call. Reserved labels: i2cs_h_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;
        and r14, 0xFF;                   // op — upper 56 bits discarded

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_i2c_slave_msg];
        call klog_s1;

        cmp r14, 4;
        je i2cs_h_dbg;
        cmp r14, 3;
        ja i2cs_h_unsup;

        // Ops 0..3: RIGHT_INVOKE.
        mov rax, r12;
        mov r10, 0x008;
        and rax, r10;
        cmp rax, 0;
        je i2cs_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je i2cs_h_addr;
        cmp r14, 1;
        je i2cs_h_mode;
        cmp r14, 2;
        je i2cs_h_bus;

        call i2c_slave_row_hint;
        jmp i2cs_h_out;

      i2cs_h_addr:
        call i2c_slave_row_addr;
        jmp i2cs_h_out;
      i2cs_h_mode:
        call i2c_slave_row_mode;
        jmp i2cs_h_out;
      i2cs_h_bus:
        call i2c_slave_row_parent;
        jmp i2cs_h_out;

      i2cs_h_dbg:
        mov rax, r12;
        mov r10, 0x400;                  // RIGHT_OBSERVE
        and rax, r10;
        cmp rax, 0;
        je i2cs_h_denied;
        mov rdi, r13;
        call i2c_slave_debug_print;
        jmp i2cs_h_out;

      i2cs_h_denied:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp i2cs_h_out;

      i2cs_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      i2cs_h_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

}
