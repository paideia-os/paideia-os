// src/kernel/core/cap/kind_mbim_session.pdx -- R40.M4-004 (#1362)
//
// KIND_MBIM_SESSION = 0x181, derived over KIND_IPC_ENDPOINT (5).
//
// The authority to hold ONE MBIM (Mobile Broadband Interface Model,
// per USB CDC MBIM spec) session's static identity: a session_key,
// an inherited endpoint id (the delivery endpoint for MBIM control
// notifications), a modem_slot naming the live KIND_WWAN_MODEM the
// session is bound to, a session_id [0, 255], a FSM state ordinal
// (idle / connecting / connected / disconnecting), and the most
// recently reported signal strength in dBm (signed 16-bit).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// R40.M4-002 admitted a WWAN modem as KIND_WWAN_MODEM -- the static
// identity of one probed modem plus its form-factor + power-state.
// R40.M4-004 (this issue) introduces the SESSION over that modem: the
// row that names the MBIM data-session id the ring-3 supervisor
// opened, its FSM state, the last signal-strength sample the driver
// posted, and the SPECIFIC modem the session is bound to.
//
// The kind half of the derivation gate discriminates NOTHING on its
// own -- every endpoint in the system is a KIND_IPC_ENDPOINT (the
// shell's stdout included) -- so the mint additionally requires:
//
//   (a) session_key non-zero and unique among live rows (NO_KEY /
//       IN_USE).
//   (b) modem_slot names a live KIND_WWAN_MODEM (BAD_MODEM).
//   (c) session_id in [0, 255] (fits the 8-bit field; refuses widening).
//   (d) state in {IDLE, CONNECTING, CONNECTED, DISCONNECTING}
//       (BAD_STATE).
//   (e) signal_strength_dbm in i16 range [-32768, 32767] --
//       specifically, the raw bit pattern in [0, 0xFFFF] (BAD_SIGNAL).
//   (f) rights subset of R_MBS_ALL (RIGHT_MINT outside -- LEAF).
//
// The endpoint_slot the row records is INHERITED at mint from the
// parent's target_ptr[15:0] (the encoding kind_endpoint.pdx's
// endpoint_tail_pack writes). A mint that took the endpoint id as
// an argument would let one endpoint's identity be stamped on a
// different endpoint's row -- and every notification thereafter would
// be delivered to the wrong recipient.
//
// =============================================================================
// §1  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  session_key   (u64)
//   [+16] body1:   endpoint_slot[31:0] | modem_slot[63:32]
//   [+24] body2:   session_id[7:0] | state[15:8]
//                | signal_strength_dbm[31:16] (i16 as u16 bit pattern)
//                | reserved[63:32]
//
// Every field is set once at mint OR advanced by a controlled
// primitive in this module (state via mbs_row_transition on connect /
// disconnect; signal via mbs_row_note_signal on notification). Revoke
// scrubs the entire row.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF1B0..0xFFFFF1BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band. Adjacent used band above: kind_wwan_modem
// 0xFFFFF1C0..CF (R40.M4-001). Adjacent free band below:
// wwan_probe 0xFFFFF1A0..AF (R40.M4-002).

module KindMbimSession = structure {

  pub let KIND_MBIM_SESSION    : u64 = 0x181
  pub let MBS_PARENT_KIND      : u64 = 5        // = KIND_IPC_ENDPOINT

  // State ordinals -- enumerated so bit-widening is refused, not masked.
  pub let MBS_STATE_IDLE          : u64 = 0
  pub let MBS_STATE_CONNECTING    : u64 = 1
  pub let MBS_STATE_CONNECTED     : u64 = 2
  pub let MBS_STATE_DISCONNECTING : u64 = 3
  pub let MBS_STATE_MAX           : u64 = 3

  // Rights -- LEAF. R_MINT (0x200) OUTSIDE R_MBS_ALL.
  pub let R_MBS_READ    : u64 = 0x001
  pub let R_MBS_INVOKE  : u64 = 0x008
  pub let R_MBS_REVOKE  : u64 = 0x010
  pub let R_MBS_OBSERVE : u64 = 0x400
  pub let R_MBS_ALL     : u64 = 0x419

  // Ops -- all QUERY, all arity ONE (op_arg[63:8] REFUSED).
  pub let MBS_OP_QUERY_KEY      : u64 = 0
  pub let MBS_OP_QUERY_ENDPOINT : u64 = 1
  pub let MBS_OP_QUERY_MODEM    : u64 = 2
  pub let MBS_OP_QUERY_SESSION  : u64 = 3
  pub let MBS_OP_QUERY_STATE    : u64 = 4
  pub let MBS_OP_QUERY_SIGNAL   : u64 = 5
  pub let MBS_OP_DEBUG_PRINT    : u64 = 6
  pub let MBS_OP_MAX            : u64 = 6

  // Failure taxonomy 0xFFFFF1B0..BF.
  pub let MBS_OK                : u64 = 0
  pub let MBS_TAIL_ENOSPC       : u64 = 0xFFFFF1BF
  pub let MBS_TAIL_BAD_ARG      : u64 = 0xFFFFF1BE
  pub let MBS_MINT_BAD_PARENT   : u64 = 0xFFFFF1BD
  pub let MBS_MINT_BAD_RIGHTS   : u64 = 0xFFFFF1BC
  pub let MBS_MINT_BAD_MODEM    : u64 = 0xFFFFF1BB
  pub let MBS_MINT_BAD_SESSION  : u64 = 0xFFFFF1BA
  pub let MBS_MINT_BAD_STATE    : u64 = 0xFFFFF1B9
  pub let MBS_MINT_BAD_SIGNAL   : u64 = 0xFFFFF1B8
  pub let MBS_MINT_BAD_EID      : u64 = 0xFFFFF1B7
  pub let MBS_MINT_NO_KEY       : u64 = 0xFFFFF1B6
  pub let MBS_MINT_IN_USE       : u64 = 0xFFFFF1B5
  pub let MBS_MINT_ENOSPC       : u64 = 0xFFFFF1B4
  pub let MBS_BAD_SLOT          : u64 = 0xFFFFF1B3
  pub let MBS_WRONG_KIND        : u64 = 0xFFFFF1B2
  pub let MBS_REVOKE_ALREADY    : u64 = 0xFFFFF1B1
  pub let MBS_RESERVED          : u64 = 0xFFFFF1B0

  pub let MBS_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let MBS_ROW_NONE   : u64 = 0xFF

  // Eight rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let MBS_MAX       : u64 = 8
  pub let MBS_ROW_BYTES : u64 = 32

  pub let mut _mbim_session_table : [u64; 32] = uninit @align(64)
  pub let mut _mbim_session_stats : [u64; 4]  = uninit @align(64)

  pub let MBS_ST_MINTS   : u64 = 0
  pub let MBS_ST_REVOKES : u64 = 1
  pub let MBS_ST_REFUSED : u64 = 2
  pub let MBS_ST_QUERIES : u64 = 3

  pub let mbs_dbg_msg : [u8; 17] = "MBIM SESSION ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let mbim_session_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): clear KIND_MBIM_SESSION row table and counters. Boot + teardown only. Labels prefixed mbs_rs_.",
      block: {
        lea r10, [rip + _mbim_session_table];
        xor rax, rax;
        xor rcx, rcx;
      mbs_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  mbs_rs_rows;

        lea r10, [rip + _mbim_session_stats];
        xor rcx, rcx;
      mbs_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  mbs_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let mbs_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-004 (#1362): subset test against R_MBS_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask -- LEAF. Labels prefixed mbs_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne mbs_rv_no;
        mov rax, 1;
        ret;
      mbs_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let mbs_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-004 (#1362): 1 iff state in {IDLE, CONNECTING, CONNECTED, DISCONNECTING} = [0, 3]. Enumerated. Labels prefixed mbs_sv_.",
      block: {
        cmp rdi, 3;
        ja  mbs_sv_no;
        mov rax, 1;
        ret;
      mbs_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let mbs_signal_valid : (u64) -> u64 !{} @{} =
    fn (raw: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-004 (#1362): 1 iff raw bit pattern fits u16 (i16 domain). Widening past 0xFFFF is refused, not masked. Labels prefixed mbs_gv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  mbs_gv_no;
        mov rax, 1;
        ret;
      mbs_gv_no:
        xor rax, rax;
        ret
      }
    }

  pub let mbs_session_valid : (u64) -> u64 !{} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-004 (#1362): 1 iff session_id fits u8 [0, 255]. Widening refused, not masked. Labels prefixed mbs_iv_.",
      block: {
        cmp rdi, 255;
        ja  mbs_iv_no;
        mov rax, 1;
        ret;
      mbs_iv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let mbs_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): counter bump. Labels prefixed mbs_nt_.",
      block: {
        cmp rdi, 4;
        jae mbs_nt_out;
        lea r10, [rip + _mbim_session_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      mbs_nt_out:
        ret
      }
    }

  pub let mbs_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): counter read. Labels prefixed mbs_stt_.",
      block: {
        cmp rdi, 4;
        jae mbs_stt_zero;
        lea r10, [rip + _mbim_session_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      mbs_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let mbs_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed mbs_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae mbs_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne mbs_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  mbs_cp_no;

        mov rax, 1;
        ret;
      mbs_cp_no:
        xor rax, rax;
        ret
      }
    }

  // Read inherited endpoint id from parent target_ptr[15:0].
  pub let mbs_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): inherited endpoint id from parent's target_ptr[15:0] -- the encoding endpoint_tail_pack writes. THE ONLY SOURCE of a session's delivery-endpoint identity. Zero on bad slot / wrong kind. Labels prefixed mbs_pei_.",
      block: {
        cmp rdi, 256;
        jae mbs_pei_zero;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne mbs_pei_zero;

        mov rax, [rax + 16];
        mov r11, 0xFFFF;
        and rax, r11;
        ret;

      mbs_pei_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Modem gate: live KIND_WWAN_MODEM (0x180) at modem_slot.
  // ==========================================================================

  pub let mbs_check_modem : (u64) -> u64 !{mem} @{cap} =
    fn (modem_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): modem_slot must name a live KIND_WWAN_MODEM (0x180). Labels prefixed mbs_cm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae mbs_cm_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x180;
        cmp r10, r11;
        jne mbs_cm_no;

        mov rax, 1;
        ret;
      mbs_cm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let mbs_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-004 (#1362): (parent_slot << 8). Labels prefixed mbs_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae mbs_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      mbs_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body1: endpoint_slot[31:0] | modem_slot[63:32].
  pub let mbs_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (modem_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-004 (#1362): pack body1: endpoint_slot[31:0] | modem_slot[63:32]. endpoint_slot carries the INHERITED endpoint id -- a u32 wide enough for the u16 kind_endpoint id plus room for future widening. Labels prefixed mbs_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  mbs_b1_bad;
        cmp rsi, r10;
        ja  mbs_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      mbs_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: session_id[7:0] | state[15:8] | signal_dbm[31:16] | reserved[63:32].
  pub let mbs_body2_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (session_id: u64) (state: u64) (signal_raw: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-004 (#1362): pack body2: session_id[7:0] | state[15:8] | signal_dbm[31:16]. Reserved [63:32] MUST be zero on read. Labels prefixed mbs_b2_.",
      block: {
        mov r10, 0xFF;
        cmp rdi, r10;
        ja  mbs_b2_bad;
        cmp rsi, r10;
        ja  mbs_b2_bad;
        mov r10, 0xFFFF;
        cmp rdx, r10;
        ja  mbs_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      mbs_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _mbim_session_table.
  // ==========================================================================

  pub let mbs_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (session_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): claim one MBIM SESSION row. THE ONE WRITER of _mbim_session_table. Gates: hdr in_use pre-set -> BAD_ARG; session_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed mbs_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne mbs_ta_bad;

        cmp r13, 0;
        je  mbs_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  mbs_ta_bad;
        cmp r15, r10;
        je  mbs_ta_bad;

        xor rbx, rbx;
      mbs_ta_scan:
        cmp rbx, 8;
        jae mbs_ta_enospc;

        lea r10, [rip + _mbim_session_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mbs_ta_claim;

        add rbx, 1;
        jmp mbs_ta_scan;

      mbs_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp mbs_ta_out;

      mbs_ta_enospc:
        mov rax, 0xFFFFF1BF;
        jmp mbs_ta_out;
      mbs_ta_bad:
        mov rax, 0xFFFFF1BE;

      mbs_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let mbs_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): 1 iff row_id < MAX and in_use. Labels prefixed mbs_tvr_.",
      block: {
        cmp rdi, 8;
        jae mbs_tvr_no;
        lea r10, [rip + _mbim_session_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mbs_tvr_no;
        mov rax, 1;
        ret;
      mbs_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let mbs_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): scrub one row. Labels prefixed mbs_tf_.",
      block: {
        cmp rdi, 8;
        jae mbs_tf_out;
        lea r10, [rip + _mbim_session_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      mbs_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let mbs_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): session_key. Labels prefixed mbs_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_rk_bad;
        lea r10, [rip + _mbim_session_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp mbs_rk_out;
      mbs_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mbs_rk_out:
        pop r12;
        ret
      }
    }

  pub let mbs_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): endpoint_slot (body1[31:0]). Labels prefixed mbs_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_re_bad;
        lea r10, [rip + _mbim_session_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp mbs_re_out;
      mbs_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mbs_re_out:
        pop r12;
        ret
      }
    }

  pub let mbs_row_modem : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): modem_slot (body1[63:32]). Labels prefixed mbs_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_rm_bad;
        lea r10, [rip + _mbim_session_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp mbs_rm_out;
      mbs_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mbs_rm_out:
        pop r12;
        ret
      }
    }

  pub let mbs_row_session : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): session_id (body2[7:0]). Labels prefixed mbs_ri_.",
      block: {
        push r12;
        mov r12, rdi;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_ri_bad;
        lea r10, [rip + _mbim_session_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp mbs_ri_out;
      mbs_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mbs_ri_out:
        pop r12;
        ret
      }
    }

  pub let mbs_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): state (body2[15:8]). Labels prefixed mbs_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_rst_bad;
        lea r10, [rip + _mbim_session_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 8;
        and rax, 0xFF;
        jmp mbs_rst_out;
      mbs_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mbs_rst_out:
        pop r12;
        ret
      }
    }

  pub let mbs_row_signal : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): signal_dbm raw (body2[31:16]). Caller interprets as i16. Labels prefixed mbs_rg_.",
      block: {
        push r12;
        mov r12, rdi;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_rg_bad;
        lea r10, [rip + _mbim_session_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp mbs_rg_out;
      mbs_rg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mbs_rg_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let mbs_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (session_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-004 (#1362): live row holding session_key, or ROW_NONE. Refuses to match 0. Labels prefixed mbs_fk_.",
      block: {
        cmp rdi, 0;
        je  mbs_fk_none;
        xor rcx, rcx;
      mbs_fk_scan:
        cmp rcx, 8;
        jae mbs_fk_none;
        lea r10, [rip + _mbim_session_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mbs_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  mbs_fk_hit;
      mbs_fk_next:
        add rcx, 1;
        jmp mbs_fk_scan;
      mbs_fk_hit:
        mov rax, rcx;
        ret;
      mbs_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let mbs_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): slot -> row_id, gated on live KIND_MBIM_SESSION. Labels prefixed mbs_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae mbs_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x181;
        cmp r10, r11;
        jne mbs_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_ros_none;

        mov rax, r12;
        jmp mbs_ros_out;

      mbs_ros_none:
        mov rax, 0xFF;
      mbs_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args -- modem_slot / session_id / state / signal_raw packed
  // in two args to fit the ABI:
  //
  //   packed_state encoding:
  //     [7:0]   session_id
  //     [15:8]  state
  //     [31:16] signal_raw
  //     [63:32] reserved
  // ==========================================================================

  pub let mbim_session_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (session_key: u64) (modem_slot: u64) (packed_state: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): mint KIND_MBIM_SESSION over KIND_IPC_ENDPOINT. Sequence: slot<256; check_parent; rights_valid; check_modem; session_valid; state_valid; signal_valid; session_key non-zero (NO_KEY); uniqueness (IN_USE); read inherited endpoint id (BAD_EID on 0); pack; tail_alloc; cap_mint_write. Labels prefixed mbs_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // session_key
        mov r15, r8;                     // modem_slot
        mov rbp, r9;                     // packed_state

        mov r10, 256;
        cmp rbx, r10;
        jae mbs_mi_bad_slot;

        mov rdi, r12;
        call mbs_check_parent;
        cmp rax, 0;
        je  mbs_mi_bad_parent;

        mov rdi, r13;
        call mbs_rights_valid;
        cmp rax, 0;
        je  mbs_mi_bad_rights;

        mov rdi, r15;
        call mbs_check_modem;
        cmp rax, 0;
        je  mbs_mi_bad_modem;

        // session_id
        mov r10, rbp;
        and r10, 0xFF;
        mov rdi, r10;
        call mbs_session_valid;
        cmp rax, 0;
        je  mbs_mi_bad_session;

        // state
        mov r10, rbp;
        shr r10, 8;
        and r10, 0xFF;
        mov rdi, r10;
        call mbs_state_valid;
        cmp rax, 0;
        je  mbs_mi_bad_state;

        // signal_raw
        mov r10, rbp;
        shr r10, 16;
        and r10, 0xFFFF;
        mov rdi, r10;
        call mbs_signal_valid;
        cmp rax, 0;
        je  mbs_mi_bad_signal;

        cmp r14, 0;
        je  mbs_mi_no_key;

        mov rdi, r14;
        call mbs_find_by_key;
        cmp rax, 0xFF;
        jne mbs_mi_in_use;

        // Inherited endpoint id from parent.
        mov rdi, r12;
        call mbs_parent_eid;
        cmp rax, 0;
        je  mbs_mi_bad_eid;
        push rax;                        // endpoint_id on stack

        // Pack body1(endpoint_id, modem_slot).
        pop rdi;                         // endpoint_id
        mov rsi, r15;                    // modem_slot
        call mbs_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  mbs_mi_bad_modem;
        push rax;                        // body1 on stack

        // Pack body2(session_id, state, signal_raw).
        mov rdi, rbp;
        and rdi, 0xFF;                   // session_id
        mov rsi, rbp;
        shr rsi, 8;
        and rsi, 0xFF;                   // state
        mov rdx, rbp;
        shr rdx, 16;
        and rdx, 0xFFFF;                 // signal_raw
        call mbs_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  mbs_mi_bad_state_pop;
        push rax;                        // body2 on stack

        // Header.
        mov rdi, r12;
        call mbs_hdr_pack;
        pop r11;                         // body2
        pop rbp;                         // body1 (rbp reused)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  mbs_mi_bad_parent;

        // tail_alloc(hdr, session_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r11;
        call mbs_tail_alloc;

        mov r10, 0xFFFFF1BF;
        cmp rax, r10;
        je  mbs_mi_enospc;
        mov r10, 0xFFFFF1BE;
        cmp rax, r10;
        je  mbs_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x181;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call mbs_note;

        xor rax, rax;
        jmp mbs_mi_out;

      mbs_mi_bad_state_pop:
        add rsp, 8;
        jmp mbs_mi_bad_signal;

      mbs_mi_bad_slot:
        mov rax, 0xFFFFF1B3;
        jmp mbs_mi_out;
      mbs_mi_bad_parent:
        mov rax, 0xFFFFF1BD;
        jmp mbs_mi_out;
      mbs_mi_bad_rights:
        mov rax, 0xFFFFF1BC;
        jmp mbs_mi_out;
      mbs_mi_bad_modem:
        mov rax, 0xFFFFF1BB;
        jmp mbs_mi_out;
      mbs_mi_bad_session:
        mov rax, 0xFFFFF1BA;
        jmp mbs_mi_out;
      mbs_mi_bad_state:
        mov rax, 0xFFFFF1B9;
        jmp mbs_mi_out;
      mbs_mi_bad_signal:
        mov rax, 0xFFFFF1B8;
        jmp mbs_mi_out;
      mbs_mi_bad_eid:
        mov rax, 0xFFFFF1B7;
        jmp mbs_mi_out;
      mbs_mi_no_key:
        mov rax, 0xFFFFF1B6;
        jmp mbs_mi_out;
      mbs_mi_in_use:
        mov rdi, 2;
        call mbs_note;
        mov rax, 0xFFFFF1B5;
        jmp mbs_mi_out;
      mbs_mi_enospc:
        mov rdi, 2;
        call mbs_note;
        mov rax, 0xFFFFF1B4;
        jmp mbs_mi_out;
      mbs_mi_bad_arg:
        mov rax, 0xFFFFF1BE;

      mbs_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let mbim_session_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): revoke KIND_MBIM_SESSION. Labels prefixed mbs_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae mbs_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  mbs_rvk_already;

        mov r11, 0x181;
        cmp r10, r11;
        jne mbs_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call mbs_tail_valid;
        cmp rax, 0;
        je  mbs_rvk_clear;

        mov rdi, r13;
        call mbs_tail_free;

      mbs_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call mbs_note;

        xor rax, rax;
        jmp mbs_rvk_out;

      mbs_rvk_bad_slot:
        mov rax, 0xFFFFF1B3;
        jmp mbs_rvk_out;
      mbs_rvk_wrong_kind:
        mov rax, 0xFFFFF1B2;
        jmp mbs_rvk_out;
      mbs_rvk_already:
        mov rax, 0xFFFFF1B1;

      mbs_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler. Queries only.
  // ==========================================================================

  pub let cap_handler_mbim_session : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R40.M4-004 (#1362): KIND_MBIM_SESSION dispatch. All ops arity ONE -- op_arg[63:8] REFUSED. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. Labels prefixed mbs_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_mbim_session_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne mbs_hn_res;

        cmp rbp, 6;
        ja  mbs_hn_unsup;

        cmp rbp, 6;
        je  mbs_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  mbs_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  mbs_hn_key;
        cmp rbp, 1;
        je  mbs_hn_ep;
        cmp rbp, 2;
        je  mbs_hn_modem;
        cmp rbp, 3;
        je  mbs_hn_sess;
        cmp rbp, 4;
        je  mbs_hn_st;
        call mbs_row_signal;
        jmp mbs_hn_out;

      mbs_hn_key:
        call mbs_row_key;
        jmp mbs_hn_out;
      mbs_hn_ep:
        call mbs_row_endpoint;
        jmp mbs_hn_out;
      mbs_hn_modem:
        call mbs_row_modem;
        jmp mbs_hn_out;
      mbs_hn_sess:
        call mbs_row_session;
        jmp mbs_hn_out;
      mbs_hn_st:
        call mbs_row_state;
        jmp mbs_hn_out;

      mbs_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  mbs_hn_denied;
        xor rax, rax;
        jmp mbs_hn_out;

      mbs_hn_res:
        mov rax, 0xFFFFF1BE;
        jmp mbs_hn_out;
      mbs_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp mbs_hn_out;
      mbs_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      mbs_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
