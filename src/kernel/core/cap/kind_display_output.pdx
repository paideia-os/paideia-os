// src/kernel/core/cap/kind_display_output.pdx — R36.M2-003 (#1241)
//
// KIND_DISPLAY_OUTPUT = 0x170, derived over KIND_DEVICE (10).
//
// The authority to hold ONE display OUTPUT under a KIND_DISPLAY_ENGINE:
// the DDI a link is attached to, the wire protocol (HDMI / DP / eDP /
// DP-MST), the current connection state, and the hash of the last EDID
// the panel produced.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// KIND_DISPLAY_ENGINE (0x16F) names the tile. It says nothing about how
// many outputs the tile drives, which output is attached to which panel,
// what wire format the panel wants, or whether a panel is even there.
// An engine on the T14 G4 has up to four DDIs, and every one of them is
// a distinct authority: mistaking DDI_B for DDI_D would drive HDCP
// negotiation and audio channel mapping at the wrong sink.
//
// This kind is the record of "one output on one engine". It is the
// authority a display pipeline consumer names when it asks about mode
// lists, connection state, or EDID payloads.
//
// =============================================================================
// §1  DERIVATION OVER KIND_DEVICE
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`.
// Like every KIND_DEVICE-derived kind in this tree, THE KIND HALF OF
// THE GATE DISCRIMINATES NOTHING — every PCI function is a KIND_DEVICE.
// The mint additionally requires:
//
//   (a) output_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE with RIGHT_MINT
//       (NO_DEVICE)
//   (c) engine_slot names a live KIND_DISPLAY_ENGINE (NO_ENGINE)
//   (d) ddi_index in {0..7} (BAD_DDI); the T14 G4 tops out at four DDIs
//       per engine but the field admits every DDI a shipping Xe part
//       exposes
//   (e) output_type in {0 HDMI, 1 DP, 2 eDP, 3 DP_MST} (BAD_TYPE); a
//       value outside the set is a wire format neither the link
//       trainer nor the audio path knows how to handle
//   (f) connected in {0, 1} (BAD_CONNECTED)
//   (g) rights subset of R_DISPLAY_OUTPUT_ALL
//
// edid_hash is a 32-bit CRC over the base EDID block; 0 means "no EDID
// captured yet". Refused values live outside {0, non-zero u32}.
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
// output_key, device_slot, engine_slot, ddi_index, output_type are ROW
// IDENTITY, frozen at mint. connected and edid_hash are dynamic and
// reflect the most recent report from hpd_isr.pdx / edid.pdx. Neither
// transition primitive is on this kind: this row exposes ROW ACCESSORS
// and a COUNTER.
//
// =============================================================================
// §3  LEAF OF THE OUTPUT LATTICE
// =============================================================================
//
// R_DISPLAY_OUTPUT_MINT (0x200) is DELIBERATELY ABSENT from
// R_DISPLAY_OUTPUT_ALL: no kind derives from a display-output cap in
// this milestone. Same discipline every leaf kind in this tree
// applies for the same reason — a later pipe / plane / transcoder /
// HDCP-session kind can be added as a separate derived kind that
// consults this one at mint.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF780..0xFFFFF78F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: dpclk_config
// 0xFFFFF790..9F, pwr_wells 0xFFFFF7A0..AF, iris_xe_probe 0xFFFFF7B0..BF,
// kind_display_engine 0xFFFFF7C0..CF; adjacent free bands below:
// topology 0xFFFFF770..7F, edid 0xFFFFF760..6F).

module KindDisplayOutput = structure {

  pub let KIND_DISPLAY_OUTPUT         : u64 = 0x170
  pub let DISPLAY_OUTPUT_PARENT_KIND  : u64 = 10          // = KIND_DEVICE

  // Output-type ordinals (§1). A value outside the set is refused
  // BAD_TYPE.
  pub let DPO_TYPE_HDMI   : u64 = 0
  pub let DPO_TYPE_DP     : u64 = 1
  pub let DPO_TYPE_EDP    : u64 = 2
  pub let DPO_TYPE_DP_MST : u64 = 3
  pub let DPO_TYPE_MAX    : u64 = 3

  // DDI cap. The T14 G4 uses at most four DDIs per engine; the field
  // admits every DDI a shipping Xe part exposes.
  pub let DPO_DDI_MAX : u64 = 7

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_DISPLAY_OUTPUT_READ    : u64 = 0x001
  pub let R_DISPLAY_OUTPUT_INVOKE  : u64 = 0x008
  pub let R_DISPLAY_OUTPUT_REVOKE  : u64 = 0x010
  pub let R_DISPLAY_OUTPUT_OBSERVE : u64 = 0x400
  pub let R_DISPLAY_OUTPUT_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let DPO_OP_QUERY_KEY       : u64 = 0
  pub let DPO_OP_QUERY_DEVICE    : u64 = 1
  pub let DPO_OP_QUERY_ENGINE    : u64 = 2
  pub let DPO_OP_QUERY_DDI       : u64 = 3
  pub let DPO_OP_QUERY_TYPE      : u64 = 4
  pub let DPO_OP_QUERY_CONNECTED : u64 = 5
  pub let DPO_OP_QUERY_EDID_HASH : u64 = 6
  pub let DPO_OP_DEBUG_PRINT     : u64 = 7
  pub let DPO_OP_MAX             : u64 = 7

  // Failure taxonomy — 0xFFFFF780..0xFFFFF78F.
  pub let DPO_OK                 : u64 = 0
  pub let DPO_TAIL_ENOSPC        : u64 = 0xFFFFF78F
  pub let DPO_TAIL_BAD_ARG       : u64 = 0xFFFFF78E
  pub let DPO_MINT_BAD_PARENT    : u64 = 0xFFFFF78D
  pub let DPO_MINT_BAD_RIGHTS    : u64 = 0xFFFFF78C
  pub let DPO_MINT_BAD_DDI       : u64 = 0xFFFFF78B
  pub let DPO_MINT_BAD_TYPE      : u64 = 0xFFFFF78A
  pub let DPO_MINT_BAD_CONNECTED : u64 = 0xFFFFF789
  pub let DPO_MINT_NO_DEVICE     : u64 = 0xFFFFF788
  pub let DPO_MINT_NO_ENGINE     : u64 = 0xFFFFF787
  pub let DPO_MINT_NO_KEY        : u64 = 0xFFFFF786
  pub let DPO_MINT_ENOSPC        : u64 = 0xFFFFF785
  pub let DPO_MINT_IN_USE        : u64 = 0xFFFFF784
  pub let DPO_BAD_SLOT           : u64 = 0xFFFFF783
  pub let DPO_WRONG_KIND         : u64 = 0xFFFFF782
  pub let DPO_REVOKE_ALREADY     : u64 = 0xFFFFF781

  pub let DPO_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPO_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride — total 256 bytes as [u64; 32].
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  output_key
  //   [+16] body word 1: device_slot[31:0] | engine_slot[63:32]
  //   [+24] body word 2: ddi_index[7:0] | output_type[15:8]
  //                     | connected[23:16] | edid_hash[63:32]
  pub let DPO_MAX       : u64 = 8
  pub let DPO_ROW_BYTES : u64 = 32

  pub let mut _display_output_table : [u64; 32] = uninit @align(64)
  pub let mut _display_output_stats : [u64; 4]  = uninit @align(64)

  pub let DPO_ST_MINTS   : u64 = 0
  pub let DPO_ST_REVOKES : u64 = 1
  pub let DPO_ST_IN_USE  : u64 = 2
  pub let DPO_ST_ENOSPC  : u64 = 3

  pub let dpo_dbg_msg : [u8; 18] = "DISPLAY OUTPUT ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let display_output_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): clear the DISPLAY OUTPUT row table and its counters. Boot and teardown only. Labels prefixed dpo_rs_.",
      block: {
        lea r10, [rip + _display_output_table];
        xor rax, rax;
        xor rcx, rcx;
      dpo_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  dpo_rs_rows;

        lea r10, [rip + _display_output_stats];
        xor rcx, rcx;
      dpo_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dpo_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let display_output_ddi_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-003 (#1241): 1 iff d <= DPO_DDI_MAX (7). Labels prefixed dpo_dv_.",
      block: {
        cmp rdi, 7;
        ja  dpo_dv_no;
        mov rax, 1;
        ret;
      dpo_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_output_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-003 (#1241): 1 iff t in {0 HDMI, 1 DP, 2 eDP, 3 DP_MST}. A value outside the set is a wire format neither link training nor audio routing knows. Labels prefixed dpo_tv_.",
      block: {
        cmp rdi, 3;
        ja  dpo_tv_no;
        mov rax, 1;
        ret;
      dpo_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_output_connected_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-003 (#1241): 1 iff c in {0, 1}. Labels prefixed dpo_cv_.",
      block: {
        cmp rdi, 1;
        ja  dpo_cv_no;
        mov rax, 1;
        ret;
      dpo_cv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_output_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-003 (#1241): subset test against R_DISPLAY_OUTPUT_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — leaf (§3). Labels prefixed dpo_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne dpo_rgv_no;
        mov rax, 1;
        ret;
      dpo_rgv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let display_output_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): counter bump. Labels prefixed dpo_nt_.",
      block: {
        cmp rdi, 4;
        jae dpo_nt_out;
        lea r10, [rip + _display_output_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpo_nt_out:
        ret
      }
    } @no_frame

  pub let display_output_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): counter read. Labels prefixed dpo_st_.",
      block: {
        cmp rdi, 4;
        jae dpo_st_zero;
        lea r10, [rip + _display_output_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpo_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: parent must be live KIND_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let display_output_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): §1 gate. parent must be live KIND_DEVICE (10) with RIGHT_MINT. Kind check alone discriminates NOTHING; additional mint gates cover the rest. Labels prefixed dpo_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpo_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne dpo_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  dpo_cp_no;

        mov rax, 1;
        ret;
      dpo_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let display_output_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): parent KIND_DEVICE target_ptr = its identity key. 0 if bad slot or wrong kind — NO_DEVICE refused at mint. Labels prefixed dpo_pk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpo_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne dpo_pk_no;

        mov rax, [rax + 16];
        ret;
      dpo_pk_no:
        xor rax, rax;
        ret
      }
    }

  pub let display_output_engine_live : (u64) -> u64 !{mem} @{cap} =
    fn (engine_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): engine slot must name a live KIND_DISPLAY_ENGINE (0x16F). Refuses out-of-range slots (< 256). Returns 1 iff live. Labels prefixed dpo_el_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpo_el_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x16F;                  // KIND_DISPLAY_ENGINE
        cmp r10, r11;
        jne dpo_el_no;

        mov rax, 1;
        ret;
      dpo_el_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let display_output_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-003 (#1241): (parent_slot << 8). Labels prefixed dpo_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae dpo_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      dpo_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let display_output_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (engine_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-003 (#1241): pack device_slot[31:0] | engine_slot[63:32]. Refuses out-of-range fields. Labels prefixed dpo_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dpo_b1_bad;
        cmp rsi, r10;
        ja  dpo_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      dpo_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let display_output_body2_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (ddi_index: u64) (output_type: u64) (connected: u64) (edid_hash: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-003 (#1241): pack ddi_index[7:0] | output_type[15:8] | connected[23:16] | edid_hash[63:32]. Refuses out-of-range fields. Labels prefixed dpo_b2_.",
      block: {
        cmp rdi, 0xFF;
        ja  dpo_b2_bad;
        cmp rsi, 0xFF;
        ja  dpo_b2_bad;
        cmp rdx, 0xFF;
        ja  dpo_b2_bad;
        mov r10, 0xFFFFFFFF;
        cmp rcx, r10;
        ja  dpo_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      dpo_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc/valid/free — THE ONE WRITER of _display_output_table.
  // ==========================================================================

  pub let display_output_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (output_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): claim one DISPLAY OUTPUT row. THE ONE WRITER of _display_output_table. Gates: hdr in_use pre-set -> BAD_ARG; output_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows of 32 bytes. Labels prefixed dpo_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne dpo_ta_bad;

        cmp r13, 0;
        je  dpo_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  dpo_ta_bad;
        cmp r15, r10;
        je  dpo_ta_bad;

        xor rbx, rbx;
      dpo_ta_scan:
        cmp rbx, 8;
        jae dpo_ta_enospc;

        lea r10, [rip + _display_output_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpo_ta_claim;

        add rbx, 1;
        jmp dpo_ta_scan;

      dpo_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp dpo_ta_out;

      dpo_ta_enospc:
        mov rax, 0xFFFFF78F;
        jmp dpo_ta_out;
      dpo_ta_bad:
        mov rax, 0xFFFFF78E;

      dpo_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_output_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): 1 iff row_id < MAX and in_use. Labels prefixed dpo_tvr_.",
      block: {
        cmp rdi, 8;
        jae dpo_tvr_no;
        lea r10, [rip + _display_output_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpo_tvr_no;
        mov rax, 1;
        ret;
      dpo_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_output_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): scrub one row. Labels prefixed dpo_tf_.",
      block: {
        cmp rdi, 8;
        jae dpo_tf_out;
        lea r10, [rip + _display_output_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      dpo_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let display_output_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): output_key. Labels prefixed dpo_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call display_output_tail_valid;
        cmp rax, 0;
        je  dpo_rk_bad;
        lea r10, [rip + _display_output_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp dpo_rk_out;
      dpo_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpo_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let display_output_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): device_slot. Labels prefixed dpo_rd_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call display_output_tail_valid;
        cmp rax, 0;
        je  dpo_rd_bad;
        lea r10, [rip + _display_output_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp dpo_rd_out;
      dpo_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpo_rd_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let display_output_row_engine : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): engine_slot. Labels prefixed dpo_re_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call display_output_tail_valid;
        cmp rax, 0;
        je  dpo_re_bad;
        lea r10, [rip + _display_output_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp dpo_re_out;
      dpo_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpo_re_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

