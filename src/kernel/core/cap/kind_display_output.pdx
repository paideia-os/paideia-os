  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let display_output_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (output_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-003 (#1241): live row holding this output_key, or ROW_NONE. Refuses to match 0. Labels prefixed dpo_fk_.",
      block: {
        cmp rdi, 0;
        je  dpo_fk_none;
        xor rcx, rcx;
      dpo_fk_scan:
        cmp rcx, 8;
        jae dpo_fk_none;
        lea r10, [rip + _display_output_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpo_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  dpo_fk_hit;
      dpo_fk_next:
        add rcx, 1;
        jmp dpo_fk_scan;
      dpo_fk_hit:
        mov rax, rcx;
        ret;
      dpo_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let display_output_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): slot -> row_id, gated on live KIND_DISPLAY_OUTPUT. Labels prefixed dpo_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae dpo_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x170;
        cmp r10, r11;
        jne dpo_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call display_output_tail_valid;
        cmp rax, 0;
        je  dpo_ros_none;

        mov rax, r12;
        jmp dpo_ros_out;

      dpo_ros_none:
        mov rax, 0xFF;
      dpo_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, output_key, device_slot,
  // packed_ident). packed_ident encoding:
  //   [15:0]  engine_slot (low 16b)
  //   [23:16] ddi_index
  //   [31:24] output_type
  //   [39:32] connected
  //   [63:40] edid_hash low 24 (packed in [63:32] compact form; witness
  //           passes only small hashes here, or 0)
  //
  // In practice the witness passes edid_hash=0 at mint and the row is
  // later updated by edid.pdx through a dedicated setter (deferred).
  // For today, edid_hash arrives via a 7th field encoded in packed_ident
  // [63:32], overlapping the connected byte at [39:32]. Callers pass
  // (engine_slot | (ddi<<16) | (type<<24) | (connected<<32) | (hash<<40))
  // which packs into 64 bits provided engine_slot fits 16b.
  // ==========================================================================

  pub let display_output_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (output_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): mint KIND_DISPLAY_OUTPUT over KIND_DEVICE. Six args (slot, parent, rights, key, device_slot, packed). packed = engine_slot[15:0] | ddi[23:16] | type[31:24] | connected[39:32] | edid_hash[63:40]. Sequence: slot<256; check_parent; parent_key non-zero (NO_DEVICE); engine_slot names live KIND_DISPLAY_ENGINE (NO_ENGINE); rights_valid; unpack + validate ddi/type/connected; output_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body1_pack; body2_pack; tail_alloc; cap_mint_write. Labels prefixed dpo_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // output_key
        mov r15, r8;                     // device_slot
        mov rbp, r9;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae dpo_mi_bad_slot;

        mov rdi, r12;
        call display_output_check_parent;
        cmp rax, 0;
        je  dpo_mi_bad_parent;

        mov rdi, r12;
        call display_output_parent_key;
        cmp rax, 0;
        je  dpo_mi_no_device;

        // engine_slot lives in packed_ident[15:0].
        mov rdi, rbp;
        and rdi, 0xFFFF;
        call display_output_engine_live;
        cmp rax, 0;
        je  dpo_mi_no_engine;

        mov rdi, r13;
        call display_output_rights_valid;
        cmp rax, 0;
        je  dpo_mi_bad_rights;

        // Validate ddi_index.
        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFF;
        call display_output_ddi_valid;
        cmp rax, 0;
        je  dpo_mi_bad_ddi;

        // Validate output_type.
        mov rdi, rbp;
        shr rdi, 24;
        and rdi, 0xFF;
        call display_output_type_valid;
        cmp rax, 0;
        je  dpo_mi_bad_type;

        // Validate connected.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFF;
        call display_output_connected_valid;
        cmp rax, 0;
        je  dpo_mi_bad_connected;

        cmp r14, 0;
        je  dpo_mi_no_key;

        mov rdi, r14;
        call display_output_find_by_key;
        cmp rax, 0xFF;
        jne dpo_mi_in_use;

        // Body1 pack: (device_slot, engine_slot).
        mov rdi, r15;                    // device_slot
        mov rsi, rbp;
        and rsi, 0xFFFF;                 // engine_slot
        call display_output_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpo_mi_bad_ddi;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack: (ddi_index, output_type, connected, edid_hash).
        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFF;                   // ddi
        mov rsi, rbp;
        shr rsi, 24;
        and rsi, 0xFF;                   // type
        mov rdx, rbp;
        shr rdx, 32;
        and rdx, 0xFF;                   // connected
        mov rcx, rbp;
        shr rcx, 40;
        and rcx, 0xFFFFFF;               // edid_hash (24 bits packed)
        call display_output_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpo_mi_bad_ddi;
        mov r15, rax;                    // body2
        push r11;                        // body1
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call display_output_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpo_mi_bad_parent;

        // tail_alloc(hdr, output_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call display_output_tail_alloc;

        mov r10, 0xFFFFF78F;
        cmp rax, r10;
        je  dpo_mi_enospc;
        mov r10, 0xFFFFF78E;
        cmp rax, r10;
        je  dpo_mi_bad_ddi;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x170;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call display_output_note;

        xor rax, rax;
        jmp dpo_mi_out;

      dpo_mi_bad_slot:
        mov rax, 0xFFFFF783;
        jmp dpo_mi_out;
      dpo_mi_bad_parent:
        mov rax, 0xFFFFF78D;
        jmp dpo_mi_out;
      dpo_mi_bad_rights:
        mov rax, 0xFFFFF78C;
        jmp dpo_mi_out;
      dpo_mi_bad_ddi:
        mov rax, 0xFFFFF78B;
        jmp dpo_mi_out;
      dpo_mi_bad_type:
        mov rax, 0xFFFFF78A;
        jmp dpo_mi_out;
      dpo_mi_bad_connected:
        mov rax, 0xFFFFF789;
        jmp dpo_mi_out;
      dpo_mi_no_device:
        mov rax, 0xFFFFF788;
        jmp dpo_mi_out;
      dpo_mi_no_engine:
        mov rax, 0xFFFFF787;
        jmp dpo_mi_out;
      dpo_mi_no_key:
        mov rax, 0xFFFFF786;
        jmp dpo_mi_out;
      dpo_mi_in_use:
        mov rdi, 2;
        call display_output_note;
        mov rax, 0xFFFFF784;
        jmp dpo_mi_out;
      dpo_mi_enospc:
        mov rdi, 3;
        call display_output_note;
        mov rax, 0xFFFFF785;

      dpo_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_output_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (output_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call display_output_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x170;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let display_output_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): revoke KIND_DISPLAY_OUTPUT. Labels prefixed dpo_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae dpo_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  dpo_rvk_already;

        mov r11, 0x170;
        cmp r10, r11;
        jne dpo_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call display_output_tail_valid;
        cmp rax, 0;
        je  dpo_rvk_clear;

        mov rdi, r13;
        call display_output_tail_free;

      dpo_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call display_output_note;

        xor rax, rax;
        jmp dpo_rvk_out;

      dpo_rvk_bad_slot:
        mov rax, 0xFFFFF783;
        jmp dpo_rvk_out;
      dpo_rvk_wrong_kind:
        mov rax, 0xFFFFF782;
        jmp dpo_rvk_out;
      dpo_rvk_already:
        mov rax, 0xFFFFF781;

      dpo_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_output_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call display_output_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x170;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_display_output : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M2-003 (#1241): KIND_DISPLAY_OUTPUT dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed dpo_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_display_output_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne dpo_hn_res;

        cmp rbp, 7;
        ja  dpo_hn_unsup;

        cmp rbp, 7;
        je  dpo_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  dpo_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  dpo_hn_key;
        cmp rbp, 1;
        je  dpo_hn_dev;
        cmp rbp, 2;
        je  dpo_hn_eng;
        cmp rbp, 3;
        je  dpo_hn_ddi;
        cmp rbp, 4;
        je  dpo_hn_typ;
        cmp rbp, 5;
        je  dpo_hn_con;
        call display_output_row_edid_hash;
        jmp dpo_hn_out;

      dpo_hn_key:
        call display_output_row_key;
        jmp dpo_hn_out;
      dpo_hn_dev:
        call display_output_row_device;
        jmp dpo_hn_out;
      dpo_hn_eng:
        call display_output_row_engine;
        jmp dpo_hn_out;
      dpo_hn_ddi:
        call display_output_row_ddi;
        jmp dpo_hn_out;
      dpo_hn_typ:
        call display_output_row_type;
        jmp dpo_hn_out;
      dpo_hn_con:
        call display_output_row_connected;
        jmp dpo_hn_out;

      dpo_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  dpo_hn_denied;
        xor rax, rax;
        jmp dpo_hn_out;

      dpo_hn_res:
        mov rax, 0xFFFFF78E;
        jmp dpo_hn_out;
      dpo_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp dpo_hn_out;
      dpo_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      dpo_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
