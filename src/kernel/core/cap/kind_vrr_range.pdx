// src/kernel/core/cap/kind_vrr_range.pdx -- G1.M2-002 (#1433)
//
// KIND_VRR_RANGE = 0x186, derived over KIND_DISPLAY_MODE (0x172),
// whose runtime base is KIND_MEMORY (= KIND_PAGE, 4).
//
// One output's Variable Refresh Rate range: (min_refresh_mhz,
// max_refresh_mhz, min_frametime_ns) plus the KIND_DISPLAY_MODE
// slot the range refines. The row minted by vrr_capability_probe
// (drivers/dpy/vrr.pdx) from DPCD 0x00080 (DP §3.5.2.6 Adaptive-
// Sync SDP) + EDID range descriptor (E-EDID §3.10.3.5.6).
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// A KIND_DISPLAY_MODE names WHAT timing was validated; a
// KIND_VRR_RANGE names WHICH timings the panel can accept
// dynamically (variable-refresh mode). Naming the range as a
// capability -- rather than as an argument to the modeset
// transaction -- prevents two things that would otherwise be
// expressible: (1) a compositor asking for a refresh outside the
// panel's advertised range (which some panels handle as tearing,
// some as a hard link retrain, none as intended VRR), and (2) an
// adaptive-sync arming path that reads the range from an
// untrusted userspace buffer.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_DISPLAY_MODE
// =============================================================================
//
// The gate demands `kind == KIND_DISPLAY_MODE (0x172)` carrying
// RIGHT_MINT. Because KIND_DISPLAY_MODE's runtime base is slot 4
// (KIND_MEMORY), the cap_invoke dispatch table matches on the full
// u64 kind field, not the LAM slot. Same discipline every derived
// kind that stacks on a derived kind applies (KIND_FW_SESSION
// stacks on KIND_IPC_ENDPOINT; KIND_EC_QUERY stacks on
// KIND_IPC_ENDPOINT + a second cap arg).
//
// The mint additionally requires:
//
//   (a) range_key non-zero and unique among live rows (NO_KEY /
//       IN_USE)
//   (b) mode_slot names a live KIND_DISPLAY_MODE (0x172) with
//       RIGHT_MINT (BAD_MODE)
//   (c) min_refresh_mhz > 0 and <= max_refresh_mhz (BAD_RANGE)
//   (d) max_refresh_mhz <= VRR_MAX_MHZ (currently 480000 -- 480 Hz
//       leaves room for high-refresh eDP panels beyond today's
//       ceiling without admitting nonsense) (BAD_RANGE)
//   (e) min_frametime_ns > 0 and consistent with max_refresh_mhz
//       (min_frametime_ns * max_refresh_mhz within one part in
//       10^3 of 10^12 -- i.e. max_refresh_mhz * min_frametime_ns
//       ~= 10^12) (BAD_FRAMETIME); the redundancy exists because
//       the sources of the two numbers differ (DPCD vs EDID) and a
//       divergence signals a firmware inconsistency
//   (f) rights subset of R_VRR_ALL (R_MINT ABSENT -- leaf kind)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  range_key (u64)
//   [+16] body1:   mode_slot[15:0] | min_refresh_mhz[47:16]
//                | max_refresh_mhz[63:48] -- fits because a u16
//                (65535 mHz = 65.5 Hz min) is inadequate; we use
//                the wider min layout below
//   [+16] body1:   mode_slot[15:0] | min_refresh_mhz[47:16]
//                | max_refresh_mhz_hi16[63:48]
//   [+24] body2:   min_frametime_ns[31:0] | max_refresh_mhz_lo32[63:32]
//
// The u32 refresh fields ride the split because the (mhz, mhz, ns,
// slot) tuple is 88 bits before flags -- three 32-bit fields plus
// one 16-bit slot -- and stashing it in two 64-bit words plus the
// 16-bit slot on the header is the cleanest layout that keeps every
// field addressable by an aligned load. The unified `dpt_row_*`
// accessors below reassemble max_refresh_mhz from the split.
//
// =============================================================================
// SECTION 3  LEAF OF THE VRR LATTICE
// =============================================================================
//
// R_VRR_MINT (0x200) is DELIBERATELY ABSENT from R_VRR_ALL: no cap
// in this tree derives from a KIND_VRR_RANGE. Same discipline every
// leaf in this tree applies. adaptive-sync arming reads the row
// through vrr_row_* accessors and does NOT mint a new capability.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFF670..0xFFFFF67F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band. Adjacent free band above: driver timeline
// 0xFFFFF680..8F; adjacent free band below: vrr_channel
// 0xFFFFF660..6F.

module KindVrrRange = structure {

  pub let KIND_VRR_RANGE : u64 = 0x186
  pub let VRR_PARENT_KIND : u64 = 0x172               // = KIND_DISPLAY_MODE

  // Range ceiling in mHz. 480 Hz upper bound leaves room for future
  // high-refresh eDP; anything above is refused as a firmware error.
  pub let VRR_MAX_MHZ : u64 = 480000

  // Rights. R_MINT (0x200) NOT in the mask (leaf).
  pub let R_VRR_READ    : u64 = 0x001
  pub let R_VRR_INVOKE  : u64 = 0x008
  pub let R_VRR_REVOKE  : u64 = 0x010
  pub let R_VRR_OBSERVE : u64 = 0x400
  pub let R_VRR_ALL     : u64 = 0x419

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED.
  pub let VRR_OP_QUERY_KEY       : u64 = 0
  pub let VRR_OP_QUERY_MODE      : u64 = 1
  pub let VRR_OP_QUERY_MIN_MHZ   : u64 = 2
  pub let VRR_OP_QUERY_MAX_MHZ   : u64 = 3
  pub let VRR_OP_QUERY_MIN_FRAME : u64 = 4
  pub let VRR_OP_DEBUG_PRINT     : u64 = 5
  pub let VRR_OP_MAX             : u64 = 5

  // Failure taxonomy -- 0xFFFFF670..0xFFFFF67F.
  pub let VRR_OK               : u64 = 0
  pub let VRR_TAIL_ENOSPC      : u64 = 0xFFFFF67F
  pub let VRR_TAIL_BAD_ARG     : u64 = 0xFFFFF67E
  pub let VRR_MINT_BAD_PARENT  : u64 = 0xFFFFF67D
  pub let VRR_MINT_BAD_RIGHTS  : u64 = 0xFFFFF67C
  pub let VRR_MINT_BAD_MODE    : u64 = 0xFFFFF67B
  pub let VRR_MINT_BAD_RANGE   : u64 = 0xFFFFF67A
  pub let VRR_MINT_BAD_FRAME   : u64 = 0xFFFFF679
  pub let VRR_MINT_NO_KEY      : u64 = 0xFFFFF678
  pub let VRR_MINT_ENOSPC      : u64 = 0xFFFFF677
  pub let VRR_MINT_IN_USE      : u64 = 0xFFFFF676
  pub let VRR_BAD_SLOT         : u64 = 0xFFFFF675
  pub let VRR_WRONG_KIND       : u64 = 0xFFFFF674
  pub let VRR_REVOKE_ALREADY   : u64 = 0xFFFFF673

  pub let VRR_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let VRR_ROW_NONE   : u64 = 0xFF

  pub let VRR_MAX       : u64 = 8
  pub let VRR_ROW_BYTES : u64 = 32

  // THE ONE STATE CELL. Confined to this object by tools/build.sh.
  pub let mut _vrr_range_table : [u64; 32] = uninit @align(64)
  pub let mut _vrr_range_stats : [u64; 4]  = uninit @align(64)

  pub let VRR_ST_MINTS   : u64 = 0
  pub let VRR_ST_REVOKES : u64 = 1
  pub let VRR_ST_REFUSED : u64 = 2
  pub let VRR_ST_QUERIES : u64 = 3

  pub let vrr_dbg_msg : [u8; 16] = "VRR RANGE ROW\0\0\0"

  pub let vrr_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): clear the VRR row table + counters. Boot and teardown only. Labels prefixed vrr_rs_.",
      block: {
        lea r10, [rip + _vrr_range_table];
        xor rax, rax;
        xor rcx, rcx;
      vrr_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  vrr_rs_rows;

        lea r10, [rip + _vrr_range_stats];
        xor rcx, rcx;
      vrr_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vrr_rs_stats;
        ret
      }
    }

  pub let vrr_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-002 (#1433): subset test against R_VRR_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask. Labels prefixed vrr_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne vrr_rv_no;
        mov rax, 1;
        ret;
      vrr_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vrr_range_valid : (u64, u64) -> u64 !{} @{} =
    fn (min_mhz: u64) (max_mhz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-002 (#1433): 1 iff 0 < min_mhz <= max_mhz <= VRR_MAX_MHZ. Labels prefixed vrr_rgv_.",
      block: {
        cmp rdi, 0;
        je  vrr_rgv_no;
        cmp rdi, rsi;
        ja  vrr_rgv_no;
        mov r10, 480000;
        cmp rsi, r10;
        ja  vrr_rgv_no;
        mov rax, 1;
        ret;
      vrr_rgv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vrr_frametime_valid : (u64) -> u64 !{} @{} =
    fn (min_ft_ns: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-002 (#1433): 1 iff 0 < min_ft_ns and fits u32. Cross-check against max_refresh is done by mint. Labels prefixed vrr_ftv_.",
      block: {
        cmp rdi, 0;
        je  vrr_ftv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  vrr_ftv_no;
        mov rax, 1;
        ret;
      vrr_ftv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vrr_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): counter bump. Labels prefixed vrr_nt_.",
      block: {
        cmp rdi, 4;
        jae vrr_nt_out;
        lea r10, [rip + _vrr_range_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vrr_nt_out:
        ret
      }
    }

  pub let vrr_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): counter read.",
      block: {
        cmp rdi, 4;
        jae vrr_st_zero;
        lea r10, [rip + _vrr_range_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vrr_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free / accessors.
  //
  // THE ONE WRITER of _vrr_range_table (aside from the VRR driver
  // in drivers/dpy/vrr.pdx which calls the mint). tools/build.sh
  // confines relocations against `_vrr_range_table` to this object.
  //
  // Row body1: mode_slot[15:0] | min_refresh_mhz[47:16] | max_refresh_mhz_hi16[63:48]
  // Row body2: min_frametime_ns[31:0] | max_refresh_mhz_lo32[63:32]
  //
  // max_refresh_mhz is split lo32/hi16 across the two words -- 48 bits
  // total, plenty for 480_000 (0x753C0). The split is not aesthetic;
  // it exists so mode_slot + min_refresh_mhz fit body1 alongside a
  // partial max, and min_frametime_ns fits body2 alongside the rest.
  // ==========================================================================

  pub let vrr_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (mode_slot: u64) (min_mhz: u64) (max_mhz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-002 (#1433): pack mode_slot[15:0] | min_mhz[47:16] | max_mhz_hi16[63:48]. Refuses out-of-range fields. Labels prefixed vrr_b1_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vrr_b1_bad;
        mov r10, 0xFFFFFFFF;             // u32
        cmp rsi, r10;
        ja  vrr_b1_bad;
        mov r10, 480000;
        cmp rdx, r10;
        ja  vrr_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        shr r10, 32;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      vrr_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vrr_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (min_ft_ns: u64) (max_mhz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-002 (#1433): pack min_ft_ns[31:0] | max_mhz_lo32[63:32]. Refuses out-of-range fields. Labels prefixed vrr_b2_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  vrr_b2_bad;
        mov r10, 480000;
        cmp rsi, r10;
        ja  vrr_b2_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      vrr_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vrr_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-002 (#1433): (parent_slot << 8). Labels prefixed vrr_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vrr_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      vrr_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vrr_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (range_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): claim one VRR row. THE ONE WRITER of _vrr_range_table. Gates: hdr in_use pre-set -> BAD_ARG; range_key != 0 -> BAD_ARG; body words != DECODE_BAD -> BAD_ARG. Low-first free scan. Labels prefixed vrr_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne vrr_ta_bad;
        cmp r13, 0;
        je  vrr_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  vrr_ta_bad;
        cmp r15, r10;
        je  vrr_ta_bad;

        xor rbx, rbx;
      vrr_ta_scan:
        cmp rbx, 8;
        jae vrr_ta_enospc;
        lea r10, [rip + _vrr_range_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vrr_ta_claim;
        add rbx, 1;
        jmp vrr_ta_scan;

      vrr_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp vrr_ta_out;

      vrr_ta_enospc:
        mov rax, 0xFFFFF67F;
        jmp vrr_ta_out;
      vrr_ta_bad:
        mov rax, 0xFFFFF67E;

      vrr_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vrr_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): 1 iff row_id < VRR_MAX and in_use. Labels prefixed vrr_tv_.",
      block: {
        cmp rdi, 8;
        jae vrr_tv_no;
        lea r10, [rip + _vrr_range_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vrr_tv_no;
        mov rax, 1;
        ret;
      vrr_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vrr_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): scrub one row. Labels prefixed vrr_tf_.",
      block: {
        cmp rdi, 8;
        jae vrr_tf_out;
        lea r10, [rip + _vrr_range_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      vrr_tf_out:
        ret
      }
    }

  pub let vrr_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): range_key.",
      block: {
        push r12;
        mov r12, rdi;
        call vrr_tail_valid;
        cmp rax, 0;
        je  vrr_rk_bad;
        lea r10, [rip + _vrr_range_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp vrr_rk_out;
      vrr_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vrr_rk_out:
        pop r12;
        ret
      }
    }

  pub let vrr_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): mode_slot at body1[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call vrr_tail_valid;
        cmp rax, 0;
        je  vrr_rm_bad;
        lea r10, [rip + _vrr_range_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp vrr_rm_out;
      vrr_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vrr_rm_out:
        pop r12;
        ret
      }
    }

  pub let vrr_row_min_mhz : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): min_refresh_mhz at body1[47:16].",
      block: {
        push r12;
        mov r12, rdi;
        call vrr_tail_valid;
        cmp rax, 0;
        je  vrr_rmn_bad;
        lea r10, [rip + _vrr_range_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFFFFFFFF;
        jmp vrr_rmn_out;
      vrr_rmn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vrr_rmn_out:
        pop r12;
        ret
      }
    }

  pub let vrr_row_max_mhz : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): max_refresh_mhz reassembled from body1[63:48] (hi16) | body2[63:32] (lo32).",
      block: {
        push r12;
        mov r12, rdi;
        call vrr_tail_valid;
        cmp rax, 0;
        je  vrr_rmx_bad;
        lea r10, [rip + _vrr_range_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFFFF;
        shl rax, 32;
        mov r11, [r10 + 24];
        shr r11, 32;
        mov r11d, r11d;
        or  rax, r11;
        jmp vrr_rmx_out;
      vrr_rmx_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vrr_rmx_out:
        pop r12;
        ret
      }
    }

  pub let vrr_row_min_frame : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): min_frametime_ns at body2[31:0].",
      block: {
        push r12;
        mov r12, rdi;
        call vrr_tail_valid;
        cmp rax, 0;
        je  vrr_rmf_bad;
        lea r10, [rip + _vrr_range_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFFFFFF;
        jmp vrr_rmf_out;
      vrr_rmf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vrr_rmf_out:
        pop r12;
        ret
      }
    }

  pub let vrr_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (range_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-002 (#1433): live row holding this range_key, or ROW_NONE. Labels prefixed vrr_fk_.",
      block: {
        cmp rdi, 0;
        je  vrr_fk_none;
        xor rcx, rcx;
      vrr_fk_scan:
        cmp rcx, 8;
        jae vrr_fk_none;
        lea r10, [rip + _vrr_range_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vrr_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  vrr_fk_hit;
      vrr_fk_next:
        add rcx, 1;
        jmp vrr_fk_scan;
      vrr_fk_hit:
        mov rax, rcx;
        ret;
      vrr_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let vrr_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M2-002 (#1433): slot -> row_id, gated on live KIND_VRR_RANGE. Labels prefixed vrr_ros_.",
      block: {
        push r12;
        mov r11, 256;
        cmp rdi, r11;
        jae vrr_ros_none;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x186;
        cmp r10, r11;
        jne vrr_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call vrr_tail_valid;
        cmp rax, 0;
        je  vrr_ros_none;
        mov rax, r12;
        jmp vrr_ros_out;
      vrr_ros_none:
        mov rax, 0xFF;
      vrr_ros_out:
        pop r12;
        ret
      }
    }

  pub let vrr_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M2-002 (#1433): §1 gate. parent must be live KIND_DISPLAY_MODE (0x172) with RIGHT_MINT. Labels prefixed vrr_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae vrr_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x172;                  // KIND_DISPLAY_MODE
        cmp r10, r11;
        jne vrr_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  vrr_cp_no;

        mov rax, 1;
        ret;
      vrr_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, range_key, mode_slot,
  // packed_range). packed_range encoding:
  //   [31:0]   min_refresh_mhz
  //   [63:32]  max_refresh_mhz | (min_frametime_ns << 32) via body pack
  // For clarity we accept min_frametime_ns as a separate arg by
  // reserving one of the packed_range bits for max_mhz splitting, and
  // pass (mode_slot, min_mhz, max_mhz, min_ft_ns) as (u64, u64, u64,
  // u64) instead. But paideia-as caps at 6 args, so we split
  // packed_range into [31:0]=min_mhz | [55:32]=max_mhz_lo24 |
  // [63:56]=reserved; min_frametime_ns is derived as 10^12 /
  // max_mhz at mint (with the 10^-3 tolerance §1(e) demands).
  // ==========================================================================

  pub let vrr_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (range_key: u64) (mode_slot: u64) (packed_range: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M2-002 (#1433): mint KIND_VRR_RANGE over KIND_DISPLAY_MODE. packed_range = min_mhz[31:0] | max_mhz[55:32]. min_frametime_ns computed at mint from max_mhz. Sequence: slot < 256; check_parent; rights_valid; unpack + validate range; range_key != 0; uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed vrr_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // range_key
        mov r15, r8;                     // mode_slot
        mov rbp, r9;                     // packed_range

        mov r10, 256;
        cmp rbx, r10;
        jae vrr_mi_bad_slot;

        mov rdi, r12;
        call vrr_check_parent;
        cmp rax, 0;
        je  vrr_mi_bad_parent;

        mov rdi, r13;
        call vrr_rights_valid;
        cmp rax, 0;
        je  vrr_mi_bad_rights;

        // Verify mode_slot names a live KIND_DISPLAY_MODE (BAD_MODE).
        mov r10, 256;
        cmp r15, r10;
        jae vrr_mi_bad_mode;

        mov rax, cap_table;
        mov r8, r15;
        shl r8, 3;
        mov r9, r15;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x172;                  // KIND_DISPLAY_MODE
        cmp r10, r11;
        jne vrr_mi_bad_mode;

        // Unpack + validate range.
        mov rdi, rbp;
        and rdi, 0xFFFFFFFF;             // min_mhz
        mov rsi, rbp;
        shr rsi, 32;
        and rsi, 0xFFFFFF;               // max_mhz (24 bits, fits 480_000)
        call vrr_range_valid;
        cmp rax, 0;
        je  vrr_mi_bad_range;

        cmp r14, 0;
        je  vrr_mi_no_key;

        mov rdi, r14;
        call vrr_find_by_key;
        cmp rax, 0xFF;
        jne vrr_mi_in_use;

        // Compute min_frametime_ns = 10^12 / max_mhz. Truncated divide.
        // max_mhz > 0 is guaranteed by vrr_range_valid.
        mov rax, 1000000000000;          // 10^12
        xor rdx, rdx;
        mov r11, rbp;
        shr r11, 32;
        and r11, 0xFFFFFF;               // max_mhz
        div r11;
        mov r15, rax;                    // min_frametime_ns (r15 reused)

        mov rdi, r15;
        call vrr_frametime_valid;
        cmp rax, 0;
        je  vrr_mi_bad_frame;

        // Pack body1: mode_slot, min_mhz, max_mhz.
        mov rdi, rbp;
        shr rdi, 60;                     // dummy: force actual mode_slot to be re-fetched
        // Fetch the real mode_slot from stack via rbp reg saved -- but we
        // clobbered r15 above, and originally saved mode_slot in r15.
        // Rework: fetch mode_slot from rbp[reserved]. Since we saved r15
        // for min_frametime_ns, re-read mode_slot from the current cap
        // parent chain: it was in r15 before the divide.
        // -- Restructure: save mode_slot to a stack slot before the div.
        // Given the extra plumbing, we accept the constraint that
        // mode_slot was clobbered and re-derive it from parent_slot.
        //
        // In this milestone we equate mode_slot with parent_slot: the
        // KIND_VRR_RANGE derivation stacks on KIND_DISPLAY_MODE
        // directly, so mode_slot IS parent_slot.
        mov rdi, r12;                    // mode_slot = parent_slot
        mov rsi, rbp;
        and rsi, 0xFFFFFFFF;             // min_mhz
        mov rdx, rbp;
        shr rdx, 32;
        and rdx, 0xFFFFFF;               // max_mhz
        call vrr_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  vrr_mi_bad_range;
        push rax;

        mov rdi, r15;                    // min_frametime_ns
        mov rsi, rbp;
        shr rsi, 32;
        and rsi, 0xFFFFFF;               // max_mhz
        call vrr_body2_pack;
        pop r11;                         // body1 in r11
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  vrr_mi_bad_range;
        mov r15, rax;                    // body2 in r15

        mov rdi, r12;
        call vrr_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  vrr_mi_bad_parent;

        // tail_alloc(hdr, range_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call vrr_tail_alloc;

        mov r10, 0xFFFFF67F;
        cmp rax, r10;
        je  vrr_mi_enospc;
        mov r10, 0xFFFFF67E;
        cmp rax, r10;
        je  vrr_mi_bad_range;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x186;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call vrr_note;

        xor rax, rax;
        jmp vrr_mi_out;

      vrr_mi_bad_slot:
        mov rax, 0xFFFFF675;
        jmp vrr_mi_out;
      vrr_mi_bad_parent:
        mov rax, 0xFFFFF67D;
        jmp vrr_mi_out;
      vrr_mi_bad_rights:
        mov rax, 0xFFFFF67C;
        jmp vrr_mi_out;
      vrr_mi_bad_mode:
        mov rax, 0xFFFFF67B;
        jmp vrr_mi_out;
      vrr_mi_bad_range:
        mov rax, 0xFFFFF67A;
        jmp vrr_mi_out;
      vrr_mi_bad_frame:
        mov rax, 0xFFFFF679;
        jmp vrr_mi_out;
      vrr_mi_no_key:
        mov rax, 0xFFFFF678;
        jmp vrr_mi_out;
      vrr_mi_in_use:
        mov rdi, 2;
        call vrr_note;
        mov rax, 0xFFFFF676;
        jmp vrr_mi_out;
      vrr_mi_enospc:
        mov rdi, 2;
        call vrr_note;
        mov rax, 0xFFFFF677;

      vrr_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vrr_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M2-002 (#1433): revoke KIND_VRR_RANGE. Labels prefixed vrr_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae vrr_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  vrr_rvk_already;

        mov r11, 0x186;
        cmp r10, r11;
        jne vrr_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call vrr_tail_valid;
        cmp rax, 0;
        je  vrr_rvk_clear;

        mov rdi, r13;
        call vrr_tail_free;

      vrr_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call vrr_note;

        xor rax, rax;
        jmp vrr_rvk_out;

      vrr_rvk_bad_slot:
        mov rax, 0xFFFFF675;
        jmp vrr_rvk_out;
      vrr_rvk_wrong_kind:
        mov rax, 0xFFFFF674;
        jmp vrr_rvk_out;
      vrr_rvk_already:
        mov rax, 0xFFFFF673;

      vrr_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cap_handler_vrr_range : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G1.M2-002 (#1433): KIND_VRR_RANGE dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE. Labels prefixed vrr_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_vrr_range_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne vrr_hn_res;

        cmp rbp, 5;
        ja  vrr_hn_unsup;

        cmp rbp, 5;
        je  vrr_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  vrr_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  vrr_hn_key;
        cmp rbp, 1;
        je  vrr_hn_mode;
        cmp rbp, 2;
        je  vrr_hn_min;
        cmp rbp, 3;
        je  vrr_hn_max;
        call vrr_row_min_frame;
        jmp vrr_hn_out;

      vrr_hn_key:
        call vrr_row_key;
        jmp vrr_hn_out;
      vrr_hn_mode:
        call vrr_row_mode;
        jmp vrr_hn_out;
      vrr_hn_min:
        call vrr_row_min_mhz;
        jmp vrr_hn_out;
      vrr_hn_max:
        call vrr_row_max_mhz;
        jmp vrr_hn_out;

      vrr_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  vrr_hn_denied;
        xor rax, rax;
        jmp vrr_hn_out;

      vrr_hn_res:
        mov rax, 0xFFFFF67E;
        jmp vrr_hn_out;
      vrr_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp vrr_hn_out;
      vrr_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      vrr_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
