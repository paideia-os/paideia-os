// src/kernel/core/cap/kind_elevate_channel.pdx -- R48b substrate-prep (#1626)
//
// KIND_ELEVATE_CHANNEL = 0x191, derived over KIND_IPC_ENDPOINT (= 5).
//
// The runtime authority for ONE in-flight elevation request handled by
// svc.elevate-broker.  A client that wants to run a narrow, time-bounded
// escalation flow (design/user/model.md §5 sudo-replacement) holds an
// endpoint cap to talk to the broker, then mints a KIND_ELEVATE_CHANNEL
// cap that carries the state of ONE request through its lifetime --
// REQUESTED -> APPROVED -> EXPIRED / REVOKED.
//
// The wire protocol between the requester and the broker lives in
// src/kernel/core/ipc/elevate_channel.pdx (R48.M7-001 #1549).  This
// module lands the CAPABILITY KIND that gates access to the broker at
// derivation-lattice granularity -- the wire schema alone cannot say
// "you may drive the elevate flow, but with this specific expiry
// deadline attached".  A KIND_ELEVATE_CHANNEL cap says exactly that.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The elevate broker is a userspace RPC service; every client-side
// interaction goes through an endpoint cap resolvable via svc_lookup on
// the "svc.elevate-broker" name (R20b service registry).  Deriving
// KIND_ELEVATE_CHANNEL over KIND_IPC_ENDPOINT lets the mint gate refuse
// a channel cap whose parent is not a live endpoint cap -- there is no
// path to fabricate a channel that talks to a broker no capability
// currently names.  This is the same shape KIND_VK_SURFACE (0x189)
// derives over KIND_IPC_ENDPOINT (G3 opener); the elevate channel is
// the mirror of that on the identity / authority axis.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (48 bytes, six u64 words):
//
//   [+0]   header: in_use[63:56] | state[15:8] | target_cap_kind[47:16]
//   [+8]   request_id       (u64)   -- broker-assigned; refused == 0
//   [+16]  requester_pid    (u64)   -- pid of the caller
//   [+24]  target_cap_rights (u64)  -- rights bitmask the request asks to be
//                                      granted on the target cap
//   [+32]  expire_ns        (u64)   -- absolute deadline (0 = broker default)
//   [+40]  broker_endpoint_id (u64) -- endpoint id of the broker itself
//                                      (redundant with target_ptr, kept for
//                                       O(1) row-only cascade path)
//
// State byte values:
//   ELV_STATE_REQUESTED = 1   -- broker has queued the request
//   ELV_STATE_APPROVED  = 2   -- approver granted; grant reified on the caller
//   ELV_STATE_DENIED    = 3   -- approver refused
//   ELV_STATE_EXPIRED   = 4   -- deadline hit before approve/deny
//   ELV_STATE_REVOKED   = 5   -- explicit revoke by supervisor
//
// target_cap_kind is stored in the header's [47:16] slice (32 bits)
// because a derived-kind tag lives in [15:0] of the u64 kind field and
// storing it in the header keeps the row at exactly 48 bytes.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// R_ELVC_INVOKE  (0x008) -- query ops + approve + deny (per approver-side
//                           policy, gated by broker cap not this one)
// R_ELVC_REVOKE  (0x010) -- teardown the request
// R_ELVC_OBSERVE (0x400) -- debug print / query state without holding INVOKE
// R_ELVC_ALL     (0x418)
//
// R_MINT deliberately ABSENT: an elevation request is a LEAF authority
// -- fanning children out from it would let a granted request become a
// factory for more grants without approver intervention.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEC00..0xFFFFEC0F
// =============================================================================

module KindElevateChannel = structure {

  pub let KIND_ELEVATE_CHANNEL      : u64 = 0x191
  pub let KIND_ELEVATE_CHANNEL_BASE : u64 = 5          // = KIND_IPC_ENDPOINT

  pub let R_ELVC_INVOKE  : u64 = 0x008
  pub let R_ELVC_REVOKE  : u64 = 0x010
  pub let R_ELVC_OBSERVE : u64 = 0x400
  pub let R_ELVC_ALL     : u64 = 0x418

  pub let ELVC_STATE_REQUESTED : u64 = 1
  pub let ELVC_STATE_APPROVED  : u64 = 2
  pub let ELVC_STATE_DENIED    : u64 = 3
  pub let ELVC_STATE_EXPIRED   : u64 = 4
  pub let ELVC_STATE_REVOKED   : u64 = 5
  pub let ELVC_STATE_MAX       : u64 = 5

  pub let ELVC_OP_QUERY_REQ_ID   : u64 = 0
  pub let ELVC_OP_QUERY_PID      : u64 = 1
  pub let ELVC_OP_QUERY_KIND     : u64 = 2
  pub let ELVC_OP_QUERY_RIGHTS   : u64 = 3
  pub let ELVC_OP_QUERY_STATE    : u64 = 4
  pub let ELVC_OP_QUERY_EXPIRE   : u64 = 5
  pub let ELVC_OP_QUERY_BROKER   : u64 = 6
  pub let ELVC_OP_DEBUG_PRINT    : u64 = 7
  pub let ELVC_OP_MAX            : u64 = 7

  pub let ELVC_OK              : u64 = 0
  pub let ELVC_TAIL_ENOSPC     : u64 = 0xFFFFEC0F
  pub let ELVC_TAIL_BAD_ARG    : u64 = 0xFFFFEC0E
  pub let ELVC_MINT_BAD_PARENT : u64 = 0xFFFFEC0D
  pub let ELVC_MINT_BAD_RIGHTS : u64 = 0xFFFFEC0C
  pub let ELVC_MINT_BAD_REQ    : u64 = 0xFFFFEC0B
  pub let ELVC_MINT_BAD_STATE  : u64 = 0xFFFFEC0A
  pub let ELVC_MINT_BAD_KIND   : u64 = 0xFFFFEC09
  pub let ELVC_BAD_SLOT        : u64 = 0xFFFFEC08
  pub let ELVC_WRONG_KIND      : u64 = 0xFFFFEC07
  pub let ELVC_REVOKE_ALREADY  : u64 = 0xFFFFEC06

  pub let ELVC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let ELVC_ROW_NONE   : u64 = 0xFF

  pub let ELVC_MAX       : u64 = 16
  pub let ELVC_ROW_BYTES : u64 = 48
  pub let mut _elevate_channel_table : [u64; 96] = uninit @align(64)
  pub let mut _elevate_channel_stats : [u64; 8]  = uninit @align(64)

  pub let ELVC_ST_MINTS   : u64 = 0
  pub let ELVC_ST_REVOKES : u64 = 1
  pub let ELVC_ST_QUERIES : u64 = 2
  pub let ELVC_ST_REFUSED : u64 = 3
  pub let ELVC_ST_MAX     : u64 = 8

  pub let elvc_dbg_msg : [u8; 15] = "ELV CHAN ROW  \0"

  pub let elevate_channel_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): clear every row and every counter. Labels prefixed elvc_rs_.",
      block: {
        lea r10, [rip + _elevate_channel_table];
        xor rax, rax;
        xor rcx, rcx;
      elvc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  elvc_rs_rows;

        lea r10, [rip + _elevate_channel_stats];
        xor rcx, rcx;
      elvc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  elvc_rs_stats;
        ret
      }
    }

  pub let elevate_channel_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): bounded increment. Labels prefixed elvc_nt_.",
      block: {
        cmp rdi, 8;
        jae elvc_nt_out;
        lea r10, [rip + _elevate_channel_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      elvc_nt_out:
        ret
      }
    }

  pub let elevate_channel_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): bounded read. Labels prefixed elvc_st_.",
      block: {
        cmp rdi, 8;
        jae elvc_st_zero;
        lea r10, [rip + _elevate_channel_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      elvc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let elevate_channel_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1626): subset test against R_ELVC_ALL = 0x418. R_MINT ABSENT -- see §2. Labels prefixed elvc_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x418;
        and rax, r10;
        cmp rax, rdi;
        jne elvc_rv_no;
        mov rax, 1;
        ret;
      elvc_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let elevate_channel_check_parent_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1626): derivation gate. parent.kind == KIND_IPC_ENDPOINT (5). RIGHT_MINT is NOT required on the parent because a client of the elevate broker holds a plain endpoint (bidi) cap and the broker's mint gate on the request side is what confers authority to open a channel row -- the derivation gate here just refuses a channel whose parent is not addressable at all. Labels prefixed elvc_cpe_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae elvc_cpe_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne elvc_cpe_no;
        mov rax, 1;
        ret;

      elvc_cpe_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | reserved[55:48] | target_cap_kind[47:16] | state[15:8] | reserved[7:0]
  pub let elevate_channel_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (target_cap_kind: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1626): canonical header encoder. Validates target_cap_kind < 2^32, state in [1..5]. Bits [63:48] and [7:0] MUST leave this function zero. Labels prefixed elvc_hp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  elvc_hp_bad;
        cmp rsi, 1;
        jb  elvc_hp_bad;
        mov r10, 5;
        cmp rsi, r10;
        ja  elvc_hp_bad;
        mov rax, rdi;
        shl rax, 16;                     // target_cap_kind -> [47:16]
        mov r11, rsi;
        shl r11, 8;                      // state -> [15:8]
        or  rax, r11;
        ret;
      elvc_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let elevate_channel_tail_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (request_id: u64) (requester_pid: u64) (target_cap_rights: u64) (expire_ns: u64) (broker_endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): claim one channel row. THE ONLY WRITER of _elevate_channel_table. Gates: hdr in_use pre-set -> BAD_ARG; request_id == 0 -> BAD_REQ. Low-first scan over 16 rows. Six callee-save pushes leave rsp%16 == 0. Labels prefixed elvc_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // request_id
        mov r14, rdx;                    // requester_pid
        mov r15, rcx;                    // target_cap_rights
        mov rbp, r8;                     // expire_ns
        // broker_endpoint_id in r9 -- keep it in r9 (not touched below).

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne elvc_ta_bad;

        cmp r13, 0;
        je  elvc_ta_bad_req;

        xor rbx, rbx;
      elvc_ta_scan:
        cmp rbx, 16;
        jae elvc_ta_enospc;

        lea r10, [rip + _elevate_channel_table];
        mov r11, rbx;
        shl r11, 5;
        mov rax, rbx;
        shl rax, 4;
        add r11, rax;                    // row * 48
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  elvc_ta_claim;

        add rbx, 1;
        jmp elvc_ta_scan;

      elvc_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov [r10 + 32], rbp;
        mov [r10 + 40], r9;
        mov rax, rbx;
        jmp elvc_ta_out;

      elvc_ta_enospc:
        mov rax, 0xFFFFEC0F;             // ELVC_TAIL_ENOSPC
        jmp elvc_ta_out;
      elvc_ta_bad_req:
        mov rax, 0xFFFFEC0B;             // ELVC_MINT_BAD_REQ
        jmp elvc_ta_out;
      elvc_ta_bad:
        mov rax, 0xFFFFEC0E;             // ELVC_TAIL_BAD_ARG

      elvc_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let elevate_channel_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): 1 iff row_id < ELVC_MAX and in_use byte set. Labels prefixed elvc_tv_.",
      block: {
        cmp rdi, 16;
        jae elvc_tv_no;
        lea r10, [rip + _elevate_channel_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  elvc_tv_no;
        mov rax, 1;
        ret;
      elvc_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let elevate_channel_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): scrub row. Labels prefixed elvc_tf_.",
      block: {
        cmp rdi, 16;
        jae elvc_tf_out;
        lea r10, [rip + _elevate_channel_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      elvc_tf_out:
        ret
      }
    }

  pub let elevate_channel_row_req : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): request_id. Labels prefixed elvc_rq_.",
      block: {
        push r12;
        mov r12, rdi;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_rq_bad;
        lea r10, [rip + _elevate_channel_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp elvc_rq_out;
      elvc_rq_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      elvc_rq_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_row_pid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): requester_pid. Labels prefixed elvc_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_rp_bad;
        lea r10, [rip + _elevate_channel_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp elvc_rp_out;
      elvc_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      elvc_rp_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_row_rights : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): target_cap_rights. Labels prefixed elvc_rr_.",
      block: {
        push r12;
        mov r12, rdi;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_rr_bad;
        lea r10, [rip + _elevate_channel_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp elvc_rr_out;
      elvc_rr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      elvc_rr_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_row_expire : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): expire_ns. Labels prefixed elvc_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_re_bad;
        lea r10, [rip + _elevate_channel_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp elvc_re_out;
      elvc_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      elvc_re_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_row_broker : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): broker_endpoint_id. Labels prefixed elvc_rb_.",
      block: {
        push r12;
        mov r12, rdi;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_rb_bad;
        lea r10, [rip + _elevate_channel_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 40];
        jmp elvc_rb_out;
      elvc_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      elvc_rb_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): state byte from header [15:8]. Labels prefixed elvc_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_rst_bad;
        lea r10, [rip + _elevate_channel_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp elvc_rst_out;
      elvc_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      elvc_rst_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_row_kind : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): target_cap_kind from header [47:16]. Labels prefixed elvc_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_rk_bad;
        lea r10, [rip + _elevate_channel_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 16;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        jmp elvc_rk_out;
      elvc_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      elvc_rk_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1626): slot -> row_id gated on KIND_ELEVATE_CHANNEL. Kind constant 0x191 staged in r11. Labels prefixed elvc_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae elvc_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x191;                  // KIND_ELEVATE_CHANNEL
        cmp r10, r11;
        jne elvc_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_ros_none;

        mov rax, r12;
        jmp elvc_ros_out;

      elvc_ros_none:
        mov rax, 0xFF;
      elvc_ros_out:
        pop r12;
        ret
      }
    }

  pub let elevate_channel_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1626): scrub + bump REVOKES; distinguishes BAD_SLOT / REVOKE_ALREADY. Labels prefixed elvc_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae elvc_cr_bad_slot;

        mov rdi, r12;
        call elevate_channel_tail_valid;
        cmp rax, 0;
        je  elvc_cr_already;

        mov rdi, r12;
        call elevate_channel_tail_free;
        mov rdi, 1;
        call elevate_channel_note;
        xor rax, rax;
        jmp elvc_cr_out;

      elvc_cr_bad_slot:
        mov rax, 0xFFFFEC08;
        jmp elvc_cr_out;
      elvc_cr_already:
        mov rax, 0xFFFFEC06;

      elvc_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let elevate_channel_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (request_id: u64) (requester_pid: u64) (target_cap_kind: u64) (target_cap_rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1626): the KIND_ELEVATE_CHANNEL mint walker. Sequences: (1) parent gate (KIND_IPC_ENDPOINT); (2) rights subset; (3) hdr_pack (target_cap_kind, state=REQUESTED); (4) tail_alloc with expire_ns=0 (default), broker_endpoint_id read from parent's tail low 16 bits. Six callee-save pushes + sub rsp, 8 = 56 bytes. Labels prefixed elvc_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // request_id
        mov r14, rcx;                    // requester_pid
        mov r15, r8;                     // target_cap_kind
        mov rbp, r9;                     // target_cap_rights

        // (1) Parent gate.
        mov rdi, r12;
        call elevate_channel_check_parent_endpoint;
        cmp rax, 0;
        je  elvc_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call elevate_channel_rights_valid;
        cmp rax, 0;
        je  elvc_mi_bad_rights;

        // Read parent's target_ptr low 16 bits -> broker_endpoint_id.
        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 16];
        mov r11, 0xFFFF;
        and r10, r11;
        // r10 = broker_endpoint_id, park it in the scratch slot
        // reserved by `sub rsp, 8` above.
        mov [rsp + 0], r10;

        // (3) Pack header with state=REQUESTED.
        mov rdi, r15;                    // target_cap_kind
        mov rsi, 1;                      // state = REQUESTED
        call elevate_channel_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  elvc_mi_bad_kind;

        // (4) tail_alloc(hdr, request_id, requester_pid, target_cap_rights,
        //                expire_ns=0, broker_endpoint_id).
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // request_id
        mov rdx, r14;                    // requester_pid
        mov rcx, rbp;                    // target_cap_rights
        xor r8,  r8;                     // expire_ns = 0
        mov r9,  [rsp + 0];              // broker_endpoint_id
        call elevate_channel_tail_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae elvc_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // ELVC_ST_MINTS
        call elevate_channel_note;
        pop rax;
        jmp elvc_mi_out;

      elvc_mi_alloc_fail:
        jmp elvc_mi_refused;
      elvc_mi_bad_parent:
        mov rax, 0xFFFFEC0D;
        jmp elvc_mi_refused;
      elvc_mi_bad_rights:
        mov rax, 0xFFFFEC0C;
        jmp elvc_mi_refused;
      elvc_mi_bad_kind:
        mov rax, 0xFFFFEC09;

      elvc_mi_refused:
        push rax;
        mov rdi, 3;                      // ELVC_ST_REFUSED
        call elevate_channel_note;
        pop rax;

      elvc_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cap_handler_elevate_channel : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R48b substrate-prep (#1626): KIND_ELEVATE_CHANNEL dispatch. Query ops need R_ELVC_INVOKE (0x008); DEBUG_PRINT needs R_ELVC_OBSERVE (0x400). op_arg[63:8] refused. Labels prefixed elvc_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne elvc_hn_res;

        cmp rbp, 7;                      // ELVC_OP_MAX
        ja  elvc_hn_unsup;

        cmp rbp, 7;
        je  elvc_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  elvc_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  elvc_hn_req;
        cmp rbp, 1;
        je  elvc_hn_pid;
        cmp rbp, 2;
        je  elvc_hn_kind;
        cmp rbp, 3;
        je  elvc_hn_rights;
        cmp rbp, 4;
        je  elvc_hn_state;
        cmp rbp, 5;
        je  elvc_hn_expire;
        call elevate_channel_row_broker; // op == 6
        jmp elvc_hn_count;

      elvc_hn_req:
        call elevate_channel_row_req;
        jmp elvc_hn_count;
      elvc_hn_pid:
        call elevate_channel_row_pid;
        jmp elvc_hn_count;
      elvc_hn_kind:
        call elevate_channel_row_kind;
        jmp elvc_hn_count;
      elvc_hn_rights:
        call elevate_channel_row_rights;
        jmp elvc_hn_count;
      elvc_hn_state:
        call elevate_channel_row_state;
        jmp elvc_hn_count;
      elvc_hn_expire:
        call elevate_channel_row_expire;
        jmp elvc_hn_count;

      elvc_hn_count:
        push rax;
        mov rdi, 2;
        call elevate_channel_note;
        pop rax;
        jmp elvc_hn_out;

      elvc_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  elvc_hn_denied;
        xor rax, rax;
        jmp elvc_hn_out;

      elvc_hn_res:
        mov rax, 0xFFFFEC0E;
        jmp elvc_hn_out;
      elvc_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp elvc_hn_out;
      elvc_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      elvc_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
