  // ==========================================================================
  // gpio_line_pad_off_of_slot(slot) -> byte offset within BAR0
  //                                  | GPIO_LINE_DECODE_BAD
  //
  // THE FUNCTION R30.M6-004 WILL DRIVE. Capability in, register address
  // out, and no other parameter.
  // ==========================================================================

  pub let gpio_line_pad_off_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): resolve a capability slot to the byte offset of its pad's PADCFG0 within the controller's BAR. It reads controller, community and pad index from the ROW and passes them to lpss_gpio_pad_off, which tools/build.sh confines to this object and lpss_gpio.o -- so this function is the ONLY route in the kernel from a capability to a pad register address, and there is no route at all that does not start at a capability. ARITY ONE AND PINNED. That is the whole design: R30.M6-004 will write PADCFG registers, and the address it writes to comes from here or from nowhere. A helper that took (community, pad) would put the two most dangerous numbers on this part back in the caller's hands after four resolvers spent an issue taking them out. GPIO_LINE_DECODE_BAD on a bad slot, a wrong kind, a dead row, an unknown controller, or a pad index outside its community -- the last of those a refusal rather than a wrap, because a wrapped index lands on a real register belonging to a real pin. Five pushes (rbx, r12-r15) leave rsp%16 == 0 at every nested call; r13 carries the row id. Reserved labels: gpl_pof_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_pof_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;                  // KIND_GPIO_LINE
        cmp r10, r11;
        jne gpl_pof_bad;

        mov r13, [rax + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call gpio_line_row_ctrl;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je gpl_pof_bad;
        mov r12, rax;                    // controller_id

        mov rdi, r13;
        call gpio_line_row_community;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je gpl_pof_bad;
        mov r14, rax;                    // community

        mov rdi, r13;
        call gpio_line_row_pad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je gpl_pof_bad;
        mov r15, rax;                    // pad index

        mov rdi, r12;
        mov rsi, r14;
        mov rdx, r15;
        call lpss_gpio_pad_off;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpl_pof_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // R30.M6-003 (#1077): THE CACHED-CONFIGURATION ACCESSORS.
  //
  // Four functions, all SLOT-FORM. There is deliberately NO exported
  // row-form setter and no exported slot-to-row-id converter: a row id is
  // an index into the table, and an exported converter would let a holder
  // of one line's capability obtain an index and then mutate a DIFFERENT
  // line's cached direction — which is the bit that decides whether a SET
  // is allowed to drive a net. The cached byte gates a physical action,
  // so it is reachable only the way the pad address is: from a
  // capability, through a function with nowhere to put a pad selector.
  //
  // The setters take a second parameter, and it is a CONFIGURATION VALUE,
  // never a selector: six bits wide, refused outright if any bit outside
  // that width is set. Six bits cannot name one of 512 pins, one of 16
  // communities or one of 128 pads. tools/build.sh pins these signatures
  // alongside the six resolvers, so a mutant that widens either second
  // parameter into a pin, community or pad argument fails the build.
  // ==========================================================================

  pub let gpio_line_cfg_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-003 (#1077): the cached pad-configuration byte of the line a capability names, from header bits [55:48] of its live row. GPIO_LINE_DECODE_BAD for a bad slot, a wrong kind or a dead row -- never zero, because zero is the legitimate reset configuration (input, no pull, no trigger, unsubscribed) and a decoder that returned it for a dead row would report a perfectly plausible line. ARITY ONE, for the same reason every other resolver here is: the configuration byte gates whether a SET may drive a net, so a caller able to ask about a DIFFERENT row is a caller able to reason about, and ultimately steer, a pad it was not granted. One push (rbx, which also carries the row id) leaves rsp%16 == 0 at the nested call. Reserved labels: gpl_cfs_.",
      block: {
        push rbx;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_cfs_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;                  // KIND_GPIO_LINE
        cmp r10, r11;
        jne gpl_cfs_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;                    // row_id

        mov rdi, rbx;
        call gpio_line_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpl_cfs_bad;

        shr rax, 48;
        and rax, 0xFF;
        pop rbx;
        ret;

      gpl_cfs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let gpio_line_set_cfg_of_slot : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (cfg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-003 (#1077): replace the cached configuration byte of the line a capability names, preserving every other bit of the header word. Refuses cfg & ~GPIO_LINE_CFG_MASK != 0 with GPIO_LINE_TAIL_BAD_ARG rather than masking it: bits [7:6] of that byte are reserved and a caller setting them is a caller with a model of this row that does not match ours, which is a disagreement to surface rather than round off. GPIO_LINE_DECODE_BAD for a bad slot, a wrong kind or a dead row. The read-modify-write clears exactly bits [55:48] and ORs the new byte in, so parent_slot, pin, pad_index, community and the in_use flag survive untouched -- the same discipline the driver applies to PADCFG0, and for the same reason: a writer that rebuilds a word from the fields it happens to care about silently zeroes the ones it does not. This is the ONLY writer of that byte. Three pushes leave rsp%16 == 0 at the nested call; r12 holds cfg and rbx the row id. Reserved labels: gpl_scs_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rsi;                    // cfg

        // Reserved bits refused, not masked.
        mov rax, r12;
        mov r10, 0x3F;                   // GPIO_LINE_CFG_MASK
        mov r11, rax;
        and r11, r10;
        cmp r11, rax;
        jne gpl_scs_arg;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_scs_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;                  // KIND_GPIO_LINE
        cmp r10, r11;
        jne gpl_scs_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;                    // row_id

        mov rdi, rbx;
        call gpio_line_tail_valid;
        cmp rax, 0;
        je  gpl_scs_bad;

        mov r8, rbx;
        shl r8, 5;                       // row_id * 32
        lea r9, [rip + _gpio_line_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, 0xFF;
        shl r10, 48;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        xor r10, r11;                    // ~(0xFF << 48)
        and rax, r10;                    // clear [55:48], keep the rest
        mov r11, r12;
        shl r11, 48;
        or  rax, r11;
        mov [r8 + 0], rax;

        xor rax, rax;                    // GPIO_LINE_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpl_scs_arg:
        mov rax, 0xFFFFFF1E;             // GPIO_LINE_TAIL_BAD_ARG
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpl_scs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // GPIO_LINE_DECODE_BAD
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpio_line_edge_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-003 (#1077): the edge-state qword of the line a capability names, from [row+24] -- the qword #1075 allocated and left zero for exactly this. Layout: serviced-edge count in [31:0], interrupt-storm flag in [32]. GPIO_LINE_DECODE_BAD for a bad slot, a wrong kind or a dead row; a live line that has seen no edges legitimately reads zero, which is why the dead-row answer must not be zero as well. ARITY ONE. One push (rbx, which also carries the row id) leaves rsp%16 == 0 at the nested call. Reserved labels: gpl_egs_.",
      block: {
        push rbx;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_egs_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;
        cmp r10, r11;
        jne gpl_egs_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;

        mov rdi, rbx;
        call gpio_line_tail_valid;
        cmp rax, 0;
        je  gpl_egs_bad;

        mov r8, rbx;
        shl r8, 5;
        lea r9, [rip + _gpio_line_table];
        add r8, r9;
        mov rax, [r8 + 24];
        pop rbx;
        ret;

      gpl_egs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let gpio_line_set_edge_of_slot : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (edge: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-003 (#1077): replace the edge-state qword of the line a capability names. The whole qword is this field, so unlike the configuration byte there is nothing to preserve and no read-modify-write to get wrong. Refuses edge >= 2^33 with GPIO_LINE_TAIL_BAD_ARG: only the count and the storm flag are defined, and the bits above them are held for a later milestone the way [55:48] was held for this one -- a field that silently accepts undefined bits is a field the next issue cannot use. GPIO_LINE_DECODE_BAD for a bad slot, a wrong kind or a dead row. This is the ONLY writer of [row+24]. Three pushes leave rsp%16 == 0 at the nested call. Reserved labels: gpl_ses_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rsi;                    // edge

        mov r10, 1;
        shl r10, 33;
        cmp r12, r10;
        jae gpl_ses_arg;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_ses_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;
        cmp r10, r11;
        jne gpl_ses_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;

        mov rdi, rbx;
        call gpio_line_tail_valid;
        cmp rax, 0;
        je  gpl_ses_bad;

        mov r8, rbx;
        shl r8, 5;
        lea r9, [rip + _gpio_line_table];
        add r8, r9;
        mov [r8 + 24], r12;

        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpl_ses_arg:
        mov rax, 0xFFFFFF1E;             // GPIO_LINE_TAIL_BAD_ARG
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpl_ses_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_line_pin_in_use(controller_id, pin) -> u64
  //
  // 1 iff a LIVE line row on THIS controller already holds this pin.
  // The collision test, scoped to the controller.
  // ==========================================================================

  pub let gpio_line_pin_in_use : (u64, u64) -> u64 !{mem} @{} =
    fn (controller_id: u64) (pin: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-001 (#1075): linear scan of the 32 line rows; 1 iff some LIVE row's (controller_id, pin) equals the pair asked about. Scoped to the CONTROLLER and not global, and that is load-bearing: a machine with two pad controllers numbers each one's pins from zero, so pin 5 on the PCH controller and pin 5 on a second controller are two pieces of silicon that do not conflict, and a global pin table would refuse the second and make an ordinary board unbootable. Keyed on the ABSOLUTE pin rather than on (community, pad_index) -- equivalent within a controller, since the mapping is a bijection -- because the absolute pin is the number the platform description carries, so the uniqueness test applies to what the caller asked for rather than to something derived from it. It also makes THE SAME PAD INDEX IN TWO DIFFERENT COMMUNITIES coexist, which a key that looked only at the pad index would wrongly refuse. Dead rows are skipped, which is why gpio_line_tail_free scrubs rather than merely clearing in_use: a stale pin in a freed row would be a ghost owner of a pin no capability names and no driver can displace. Linear rather than indexed because 32 rows is small, the scan happens only at mint, and an index would be a second place the truth lives. Leaf, pure read. rdi=controller_id, rsi=pin. Reserved labels: gpl_piu_.",
      block: {
        lea r8, [rip + _gpio_line_table];
        xor rcx, rcx;

      gpl_piu_scan:
        cmp rcx, 32;
        jae gpl_piu_no;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je gpl_piu_next;                 // dead row

        mov r10, [r8 + 8];               // controller_id
        cmp r10, rdi;
        jne gpl_piu_next;                // a different controller

        mov r10, rax;
        shr r10, 8;
        mov r11, 0xFFFF;
        and r10, r11;                    // pin
        cmp r10, rsi;
        jne gpl_piu_next;

        mov rax, 1;
        ret;

      gpl_piu_next:
        add r8, 32;
        add rcx, 1;
        jmp gpl_piu_scan;

      gpl_piu_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // gpio_line_cap_mint(slot, parent_slot, rights, pin, driver_hint) -> u64
  //
  // The pin IS an argument HERE and only here. This is the authorising
  // moment.
  //
  // SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=pin, r8=driver_hint.
  // ==========================================================================

  pub let gpio_line_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (pin: u64) (driver_hint: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): mint a KIND_GPIO_LINE. Sequence: (1) slot < 256 else GPIO_LINE_MINT_BAD_ARG. (2) gpio_line_check_parent_device(parent_slot) -- THE FIRST HALF OF THE DERIVATION GATE -- else GPIO_LINE_MINT_BAD_PARENT. (3) gpio_line_rights_valid(rights) else GPIO_LINE_MINT_BAD_RIGHTS. (4) pin < GPIO_PIN_MAX else GPIO_LINE_MINT_PIN_RANGE, checked BEFORE the mapping so a pin that cannot be represented is refused as unrepresentable rather than as unrouted -- two different operator problems. (5) driver_hint != 0 else GPIO_LINE_MINT_BAD_HINT. (6) controller_id = gpio_line_parent_ctrl_id(parent_slot) -- INHERITED, never argued; zero -> GPIO_LINE_MINT_NO_CONTROLLER. (7) lpss_gpio_resolve_pin(controller_id, pin) -- THE SECOND HALF OF THE GATE AND THE MAPPING IN ONE STEP. GPIO_MAP_NO_CTRL -> GPIO_LINE_MINT_NO_CONTROLLER, which is what refuses a KIND_DEVICE capability for something that is not a probed pad controller; GPIO_MAP_UNMAPPED -> GPIO_LINE_MINT_PIN_UNMAPPED, which is what refuses a pin this part does not route. NEITHER is clamped: a clamp would hand back SOME pin, and on this part some pin is a device reset or a rail enable. community = result >> 16, pad_index = result & 0xFFFF, and neither was a parameter. (8) gpio_line_pin_in_use(controller_id, pin) -> GPIO_LINE_MINT_PIN_IN_USE: THE SECOND MINT OF A PIN IS REFUSED, because a pin has one physical state, two owners of it cannot detect each other, there is no protocol on a pin to arbitrate them, and the loser's failure surfaces in whatever hardware the pin controls rather than in the loser's driver. (9) gpio_line_tail_pack + gpio_line_tail_alloc, translating TAIL codes to distinct MINT codes. (10) cap_mint_write(slot, KIND_GPIO_LINE = 0x154, rights, row_id). Five pushes plus a 32-byte frame (72 bytes total, rsp%16 == 0 at every nested call) hold slot/parent_slot/rights/pin/driver_hint in r12/r13/r14/r15/rbx with controller_id at [rsp+0], community at [rsp+8], pad_index at [rsp+16] and row_id at [rsp+24]. Reserved labels: gpl_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov r15, rcx;                    // pin
        mov rbx, r8;                     // driver_hint

        mov r10, 256;
        cmp r12, r10;
        jae gpl_mi_bad_arg;

        // -- Step 2: the first half of the derivation gate.
        mov rdi, r13;
        call gpio_line_check_parent_device;
        cmp rax, 0;
        je gpl_mi_bad_parent;

        // -- Step 3: rights subset.
        mov rdi, r14;
        call gpio_line_rights_valid;
        cmp rax, 0;
        je gpl_mi_bad_rights;

        // -- Step 4: the pin must be representable.
        mov r10, 512;                    // GPIO_PIN_MAX
        cmp r15, r10;
        jae gpl_mi_pin_range;

        // -- Step 5: the driver hint must be present.
        cmp rbx, 0;
        je gpl_mi_bad_hint;

        // -- Step 6: controller identity, INHERITED.
        mov rdi, r13;
        call gpio_line_parent_ctrl_id;
        cmp rax, 0;
        je gpl_mi_no_ctrl;
        mov [rsp + 0], rax;              // controller_id

        // -- Step 7: the second half of the gate, and the mapping.
        mov rdi, [rsp + 0];
        mov rsi, r15;
        call lpss_gpio_resolve_pin;
        mov r10, 0xFFFFFFFFFFFFFFFE;     // GPIO_MAP_NO_CTRL
        cmp rax, r10;
        je gpl_mi_no_ctrl;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // GPIO_MAP_UNMAPPED
        cmp rax, r10;
        je gpl_mi_unmapped;

        mov r10, rax;
        shr r10, 16;
        mov [rsp + 8], r10;              // community
        mov r10, 0xFFFF;
        and rax, r10;
        mov [rsp + 16], rax;             // pad_index

        // -- Step 8: THE COLLISION TEST, scoped to this controller.
        mov rdi, [rsp + 0];
        mov rsi, r15;
        call gpio_line_pin_in_use;
        cmp rax, 0;
        jne gpl_mi_in_use;

        // -- Step 9: header word, then the row.
        mov rdi, r13;                    // parent_slot
        mov rsi, r15;                    // pin
        mov rdx, [rsp + 16];             // pad_index
        mov rcx, [rsp + 8];              // community
        call gpio_line_tail_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je gpl_mi_bad_arg;

        mov rdi, rax;                    // hdr
        mov rsi, [rsp + 0];              // controller_id
        mov rdx, rbx;                    // driver_hint
        call gpio_line_tail_alloc;

        mov r10, 0xFFFFFF1F;             // GPIO_LINE_TAIL_ENOSPC
        cmp rax, r10;
        je gpl_mi_enospc;
        mov r10, 0xFFFFFF1E;             // GPIO_LINE_TAIL_BAD_ARG
        cmp rax, r10;
        je gpl_mi_bad_arg;
        mov [rsp + 24], rax;             // row_id

        // -- Step 10: descriptor.
        //
        // R30.M6-003 (#1077): target_ptr = row_id | (slot << 16).
        //
        // The handler ABI is (rights, target_ptr, op_arg) — cap_invoke
        // does NOT pass the slot. But every route from a capability to a
        // pad register address starts at gpio_line_pad_off_of_slot(slot),
        // and #1078 deliberately does not get a second one. So the OWNING
        // SLOT is recorded in the descriptor, where only cap_mint_write
        // can put it, and the handler reads it back out.
        //
        // This is not a caller-supplied slot with extra steps. target_ptr
        // is kernel-written; a caller cannot present a descriptor naming
        // someone else's slot any more than it can present one naming
        // someone else's row. The alternative — a row-form pad-address
        // function — would take a table INDEX from anywhere and hand back
        // a pad address, which is exactly the second route the pin
        // confinement exists to deny.
        //
        // [15:0] stays the row id, so every existing decoder that masks
        // with 0xFFFF is unaffected.
        mov rcx, [rsp + 24];             // row_id
        mov r10, r12;                    // slot
        and r10, 0xFF;
        shl r10, 16;
        or  rcx, r10;                    // target_ptr
        mov rdi, r12;                    // slot
        mov rsi, 0x154;                  // KIND_GPIO_LINE
        mov rdx, r14;                    // rights
        call cap_mint_write;

        xor rax, rax;                    // GPIO_LINE_OK
        jmp gpl_mi_out;

      gpl_mi_bad_parent:
        mov rax, 0xFFFFFF1D;
        jmp gpl_mi_out;
      gpl_mi_bad_rights:
        mov rax, 0xFFFFFF1C;
        jmp gpl_mi_out;
      gpl_mi_enospc:
        mov rax, 0xFFFFFF1A;
        jmp gpl_mi_out;
      gpl_mi_pin_range:
        mov rax, 0xFFFFFF19;
        jmp gpl_mi_out;
      gpl_mi_unmapped:
        mov rax, 0xFFFFFF18;
        jmp gpl_mi_out;
      gpl_mi_in_use:
        mov rax, 0xFFFFFF17;
        jmp gpl_mi_out;
      gpl_mi_no_ctrl:
        mov rax, 0xFFFFFF16;
        jmp gpl_mi_out;
      gpl_mi_bad_hint:
        mov rax, 0xFFFFFF15;
        jmp gpl_mi_out;
      gpl_mi_bad_arg:
        mov rax, 0xFFFFFF1B;

      gpl_mi_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpio_line_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (pin: u64) (driver_hint: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): audited entry point for the line mint. The audit is the record of WHICH DRIVER WAS GIVEN WHICH PIN, and it is the only such record: after this call the pin lives in a row the holder cannot restate, so an operator reconstructing 'who was allowed to drive the touchscreen reset' has this line and nothing else. Refusals are audited too -- a GPIO_LINE_MINT_PIN_IN_USE (0xFFFFFF17) line is the trace of a second component trying to claim a pin that already has an owner, which on this part is exactly the event worth seeing before it becomes a device that will not come out of reset. Three pushes (r12/r13/r14) leave rsp%16 == 0 at both nested calls; the five SysV argument registers are untouched by the two movs, so the inner body sees them exactly as passed, and r14 carries the inner outcome across drv_audit_emit so the wrapper is return-value transparent. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent device slot)

        call gpio_line_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x154;                  // KIND_GPIO_LINE
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // gpio_line_cap_revoke(slot) -> u64
  // ==========================================================================

  pub let gpio_line_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): revoke a KIND_GPIO_LINE. (1) slot < 256 else GPIO_LINE_REVOKE_BAD_SLOT. (2) descriptor at cap_table + slot*24. (3) kind == 0 -> GPIO_LINE_REVOKE_ALREADY (idempotent). (4) kind != 0x154 -> GPIO_LINE_REVOKE_WRONG_KIND, so a line revoke can never clear a device descriptor or any other kind's. (5) row_id from target_ptr[15:0]; if the row is live, gpio_line_tail_free scrubs the pin out of the table -- which is what makes the pin re-mintable, and therefore what makes a driver restart possible at all. (6) clear the descriptor. NOTE WHAT THIS DOES NOT DO: it does not touch the pad. Revoking authority over a pin leaves the pin exactly as the previous owner left it, and that is deliberate rather than an omission -- 'return the pin to a safe state' has no meaning this kernel could supply, because whether high or low is safe is a property of the board and not of the controller. Driving a reset line to a guessed level on revoke would be a worse bug than any this file prevents. R30.M6-004 will let a holder configure a pin; deciding what a released pin should look like is a platform-policy question that belongs with whoever knows the board. Five pushes leave rsp%16 == 0 at every nested call; rbx holds the descriptor base and r13 the row_id across them. Reserved labels: gpl_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae gpl_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je gpl_rvk_already;

        mov r11, 0x154;                  // KIND_GPIO_LINE
        cmp r10, r11;
        jne gpl_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call gpio_line_tail_valid;
        cmp rax, 0;
        je gpl_rvk_clear;

        mov rdi, r13;
        call gpio_line_tail_free;

      gpl_rvk_clear:
        xor rax, rax;
        mov [rbx + 0],  rax;
        mov [rbx + 8],  rax;
        mov [rbx + 16], rax;

        xor rax, rax;                    // GPIO_LINE_OK
        jmp gpl_rvk_out;

      gpl_rvk_bad_slot:
        mov rax, 0xFFFFFF14;
        jmp gpl_rvk_out;
      gpl_rvk_wrong_kind:
        mov rax, 0xFFFFFF13;
        jmp gpl_rvk_out;
      gpl_rvk_already:
        mov rax, 0xFFFFFF12;

      gpl_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpio_line_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): audited revoke. The controller cascade calls THIS symbol, so tearing down a pad controller that owns N pins leaves N records plus the controller's own -- the reconciliation property R29.M6-002 established for the DMA cascade, and the one an operator needs when a device stops responding and the question is whether its reset line was released by a revoke or held by a crash. Three pushes (r12/r13/r14) leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call gpio_line_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x154;                  // KIND_GPIO_LINE
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // gpio_line_cascade_revoke_by_controller(controller_id) -> count
  //
  // Called by lpss_gpio_release BEFORE the controller row is freed.
  // Two phases: by descriptor, then by row.
  // ==========================================================================

  pub let gpio_line_cascade_revoke_by_controller : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (controller_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): revoke every KIND_GPIO_LINE sitting on the given controller, and return how many were reached. PHASE 1 scans cap_table slots 0..255 for kind == 0x154, takes row_id from target_ptr[15:0], skips row_id >= GPIO_LINE_MAX, reads the row's controller_id from _gpio_line_table[row_id][+8], and calls the audited gpio_line_cap_revoke on a match. PHASE 2 then scans the 32 rows directly and frees any LIVE row still recording this controller. Phase 2 is not redundant: a line descriptor cleared by any other path would otherwise strand its row forever, and a stranded row still holds a PIN on a controller that no longer exists, so the next legitimate mint of that pin would be refused IN_USE by a ghost -- which is how 'no row leak' becomes structural rather than probable. On this kind the ghost is worse than on I2C: the pin it holds may be the only way to bring a device out of reset, so a leaked row can make a device permanently unusable until reboot. Keying on controller_id rather than on the parent cap SLOT is deliberate: a slot can be reused by a different device, a part's bdf key names the part. A single level suffices -- KIND_GPIO_LINE carries no MINT right, so there are no grandchildren and no fixed point to reach. Registers: r12 = cursor, r13 = controller_id, r14 = count, rbx = scratch; all callee-save and preserved across the nested revoke, whose clobbers are otherwise unconstrained. Five pushes leave rsp%16 == 0 at every nested call. Reserved labels: gpl_cs_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r13, rdi;                    // controller_id
        xor r14, r14;                    // count

        // ------------------------------------------------------------
        // PHASE 1 — by descriptor.
        // ------------------------------------------------------------
        xor r12, r12;

      gpl_cs_scan:
        mov r10, 256;
        cmp r12, r10;
        jae gpl_cs_phase2;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;                  // KIND_GPIO_LINE
        cmp r10, r11;
        jne gpl_cs_skip;

        mov r10, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and r10, r11;                    // row_id
        cmp r10, 32;                     // GPIO_LINE_MAX
        jae gpl_cs_skip;

        // Row, read directly (we are inside the owning module, so the
        // table access is legitimate here).
        mov r8, r10;
        shl r8, 5;
        lea r9, [rip + _gpio_line_table];
        add r8, r9;

        mov r11, [r8 + 0];               // hdr
        mov r10, r11;
        shr r10, 56;
        cmp r10, 0;
        je gpl_cs_skip;                  // dead row

        mov rbx, [r8 + 8];               // row.controller_id
        cmp rbx, r13;
        jne gpl_cs_skip;

        mov rdi, r12;
        call gpio_line_cap_revoke;
        add r14, 1;

      gpl_cs_skip:
        add r12, 1;
        jmp gpl_cs_scan;

        // ------------------------------------------------------------
        // PHASE 2 — by row. Any LIVE row still naming this controller
        // has no descriptor pointing at it; free it.
        // ------------------------------------------------------------
      gpl_cs_phase2:
        xor r12, r12;

      gpl_cs_rowscan:
        cmp r12, 32;
        jae gpl_cs_done;

        mov r8, r12;
        shl r8, 5;
        lea r9, [rip + _gpio_line_table];
        add r8, r9;

        mov r11, [r8 + 0];
        mov r10, r11;
        shr r10, 56;
        cmp r10, 0;
        je gpl_cs_rownext;               // free already

        mov rbx, [r8 + 8];
        cmp rbx, r13;
        jne gpl_cs_rownext;

        mov rdi, r12;
        call gpio_line_tail_free;
        add r14, 1;

      gpl_cs_rownext:
        add r12, 1;
        jmp gpl_cs_rowscan;

      gpl_cs_done:
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_line_debug_print(row_id) -> u64
  // ==========================================================================

  pub let gpio_line_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R30.M6-001 (#1075): canonical debug printer for one line row. Refuses a dead or out-of-range row with GPIO_LINE_TAIL_BAD_ARG rather than printing zeroes: a printer that rendered a freed row as {ctl 0, pin 0, com 0, pad 0} would be showing a plausible-looking line describing authority over community 0's first pad on an unnamed controller -- a real pin on every part in existence. Emits five KV lines (row / ctl / pin / com / pad) through klog_s1_x1 so each value is machine-greppable in the smoke log, and pin and pad are printed SEPARATELY on purpose: they are equal for every pin of community 0 and differ everywhere else, so a log in which they are always equal is a log from a machine on which only community 0 was ever used -- which is the coverage gap this milestone exists to close. r12 holds row_id across the five calls; three pushes leave rsp%16 == 0. Reserved labels: gpl_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call gpio_line_tail_valid;
        cmp rax, 0;
        je gpl_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gpl_dbg_msg];
        lea rcx, [rip + gpl_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call gpio_line_row_ctrl;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gpl_dbg_msg];
        lea rcx, [rip + gpl_k_ctl];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call gpio_line_row_pin;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gpl_dbg_msg];
        lea rcx, [rip + gpl_k_pin];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call gpio_line_row_community;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gpl_dbg_msg];
        lea rcx, [rip + gpl_k_com];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call gpio_line_row_pad;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gpl_dbg_msg];
        lea rcx, [rip + gpl_k_pad];
        mov r8, r13;
        call klog_s1_x1;

        xor rax, rax;                    // GPIO_LINE_OK
        pop r14;
        pop r13;
        pop r12;
        ret;

      gpl_dp_bad:
        mov rax, 0xFFFFFF1E;             // GPIO_LINE_TAIL_BAD_ARG
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_gpio_line(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler. QUERY OPS ONLY, AND NO OP TAKES AN OPERAND.
  //
  // This is the second half of the pin-confinement argument. The only
  // caller-controlled word that reaches this function is op_arg, and its
  // top fifty-six bits are discarded before any dispatch decision is
  // made. There is therefore no channel — not an argument, not a packed
  // field, not an out-of-band register — by which the holder of a line
  // capability can name a pin.
  // ==========================================================================

  pub let cap_handler_gpio_line : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): KIND_GPIO_LINE dispatch handler. Emits cap_gpio_line_msg on entry (argument registers saved across klog_s1, which clobbers all three per klog/wrappers.pdx section 5.1). row_id = target_ptr[15:0] -- from the DESCRIPTOR, which only the kernel writes; op = op_arg[7:0], with the upper 56 bits DISCARDED, which closes the last channel a caller might use to smuggle a pin number into the invocation. Ops 0..4 (QUERY_PIN / COMM / PAD / CTRL / HINT) require RIGHT_INVOKE (0x008); op 5 (DEBUG_PRINT) requires RIGHT_OBSERVE (0x400). QUERY_PIN returns the row's own pin: it is an introspection op, not an addressing one -- a holder learning which pin it owns is not a holder choosing which pin to drive, and there is no level or configuration op here for the answer to be fed into. Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Every query returns GPIO_LINE_DECODE_BAD for a dead row, never a plausible zero -- which matters for all five, since pin 0, community 0, pad 0 and controller 0 are each a value a live row could legitimately hold on some machine. r12=rights, r13=row_id, rbx=owning slot, r14=op, r15=operand across the klog call; five pushes leave rsp%16 == 0 at every nested call. R30.M6-003 (#1077) EXTENDS THIS HANDLER with the eight channel ops (6..13): GET requires RIGHT_READ, SET requires RIGHT_WRITE, direction/pull/edge-subscribe/edge-unsubscribe require RIGHT_CONFIG, the edge count requires RIGHT_OBSERVE and the configuration query requires RIGHT_INVOKE -- the SAME bits #1075 reserved and left unconsumed, so a capability minted before this change gains nothing it was not minted with. The channel ops carry an eight-bit operand in op_arg[15:8] and REFUSE any invocation with op_arg[63:16] non-zero (GPIO_LINE_OP_ARG_RESERVED); ops 0..5 keep discarding their upper bits because they have no operand for those bits to be confused with. An eight-bit operand cannot name one of 512 pins, one of 16 communities or one of 128 pads, and the pad address the driver acts on still comes from gpio_line_pad_off_of_slot and nowhere else -- the slot being read out of target_ptr[31:16], a field cap_mint_write wrote, not an argument any caller supplies. Reserved labels: gpl_h_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id  = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot    = target_ptr[31:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_gpio_line_msg];
        call klog_s1;

        // Decode. No call may intervene between forming r11 and testing
        // it; there is none.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov r15, r14;
        shr r15, 8;
        and r15, 0xFF;                   // operand
        mov r11, r14;
        shr r11, 16;                     // everything above the operand
        mov r14, r10;                    // r14 = op from here on

        cmp r14, 5;
        jbe gpl_h_query;

        cmp r14, 13;                     // GPIO_LINE_OP_MAX
        ja gpl_h_unsup;

        // R30.M6-003 (#1077): the channel ops carry an operand, so the
        // bits above it are REFUSED rather than discarded. Fifty-six free
        // bits on an invocation that reaches a pad is where a pin number
        // would be smuggled; masking them would turn that attempt into an
        // ordinary successful call.
        cmp r11, 0;
        jne gpl_h_res;
        jmp gpl_h_chan;

      gpl_h_query:
        // Ops 0..5 take NO operand, so their upper bits are discarded as
        // they always were -- there is nothing up there they could mean,
        // and the #1075 witness asserts exactly that.
        cmp r14, 5;
        je gpl_h_dbg;

        // Ops 0..4: RIGHT_INVOKE.
        mov rax, r12;
        mov r10, 0x008;
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je gpl_h_pin;
        cmp r14, 1;
        je gpl_h_comm;
        cmp r14, 2;
        je gpl_h_pad;
        cmp r14, 3;
        je gpl_h_ctrl;

        call gpio_line_row_hint;
        jmp gpl_h_out;

      gpl_h_pin:
        call gpio_line_row_pin;
        jmp gpl_h_out;
      gpl_h_comm:
        call gpio_line_row_community;
        jmp gpl_h_out;
      gpl_h_pad:
        call gpio_line_row_pad;
        jmp gpl_h_out;
      gpl_h_ctrl:
        call gpio_line_row_parent;
        jmp gpl_h_out;

      gpl_h_dbg:
        mov rax, r12;
        mov r10, 0x400;                  // RIGHT_OBSERVE
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, r13;
        call gpio_line_debug_print;
        jmp gpl_h_out;

        // ================================================================
        // R30.M6-003 (#1077) channel ops. Each checks ITS OWN right --
        // READ for get, WRITE for set, CONFIG for direction, pull and
        // trigger, OBSERVE for the edge count -- against the bits #1075
        // reserved and refused to let anything consume. A capability
        // minted before this change with INVOKE alone still cannot reach
        // any of them.
        //
        // The slot handed to the driver comes from target_ptr[31:16],
        // which cap_mint_write put there; it is not an argument and there
        // is no path by which a caller supplies one.
        // ================================================================

      gpl_h_chan:
        cmp r14, 6;
        je gpl_h_get;
        cmp r14, 7;
        je gpl_h_set;
        cmp r14, 8;
        je gpl_h_cfgdir;
        cmp r14, 9;
        je gpl_h_cfgpull;
        cmp r14, 10;
        je gpl_h_esub;
        cmp r14, 11;
        je gpl_h_eunsub;
        cmp r14, 12;
        je gpl_h_ecount;

        // 13: QUERY_CFG -- introspection, so RIGHT_INVOKE like the other
        // queries. Learning that a line is currently an input is not
        // authority to make it an output.
        mov rax, r12;
        mov r10, 0x008;
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        call gpio_line_cfg_of_slot;
        jmp gpl_h_out;

      gpl_h_get:
        mov rax, r12;
        mov r10, 0x001;                  // R_GPIO_LINE_READ
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        call gpio_pad_get_level;
        jmp gpl_h_out;

      gpl_h_set:
        mov rax, r12;
        mov r10, 0x002;                  // R_GPIO_LINE_WRITE
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        mov rsi, r15;
        call gpio_pad_set_level;
        jmp gpl_h_out;

      gpl_h_cfgdir:
        mov rax, r12;
        mov r10, 0x004;                  // R_GPIO_LINE_CONFIG
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        mov rsi, r15;
        call gpio_pad_set_dir;
        jmp gpl_h_out;

      gpl_h_cfgpull:
        mov rax, r12;
        mov r10, 0x004;                  // R_GPIO_LINE_CONFIG
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        mov rsi, r15;
        call gpio_pad_set_pull;
        jmp gpl_h_out;

      gpl_h_esub:
        mov rax, r12;
        mov r10, 0x004;                  // R_GPIO_LINE_CONFIG
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        mov rsi, r15;
        call gpio_pad_edge_subscribe;
        jmp gpl_h_out;

      gpl_h_eunsub:
        mov rax, r12;
        mov r10, 0x004;                  // R_GPIO_LINE_CONFIG
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        call gpio_pad_edge_unsubscribe;
        jmp gpl_h_out;

      gpl_h_ecount:
        mov rax, r12;
        mov r10, 0x400;                  // R_GPIO_LINE_OBSERVE
        and rax, r10;
        cmp rax, 0;
        je gpl_h_denied;
        mov rdi, rbx;
        call gpio_pad_edge_count;
        jmp gpl_h_out;

      gpl_h_res:
        mov rax, 0xFFFFFF10;             // GPIO_LINE_OP_ARG_RESERVED
        jmp gpl_h_out;

      gpl_h_denied:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp gpl_h_out;

      gpl_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      gpl_h_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
