        jae gpl_rct_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _gpio_line_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je gpl_rct_bad;

        mov rax, [r8 + 8];
        ret;

      gpl_rct_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let gpio_line_row_hint : (u64) -> u64 !{mem} @{} =
