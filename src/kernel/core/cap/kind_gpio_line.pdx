        call gpio_line_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je gpl_rpa_out;
        and rax, 0xFF;
      gpl_rpa_out:
        pop rbx;
        ret
