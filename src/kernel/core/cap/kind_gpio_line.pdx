    }

  pub let gpio_line_row_ctrl : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-001 (#1075): the controller identity (bdf_pack key) this line sits on, from [+8]. THE TRUE PARENT IDENTITY: the cascade key and the first term of the (controller, pin) uniqueness key, because it names the PART rather than a capability slot that could later hold a different device. GPIO_LINE_DECODE_BAD on a dead or out-of-range row; unambiguous because the allocator refuses a zero controller id. Leaf, pure read. Reserved labels: gpl_rct_.",
