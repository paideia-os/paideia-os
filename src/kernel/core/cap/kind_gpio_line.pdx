  pub let gpio_line_ctrl_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): resolve a capability slot to the pad controller its pin sits on. ARITY ONE and pinned, because this is the join a pad access walks from a line capability to the register window that owns its pad: a caller-supplied controller id would let a capability naming pin 5 on controller A be applied on controller B, where pin 5 is a different signal on different silicon -- the exact cross-controller confusion the per-controller uniqueness key was scoped to PERMIT at mint and must therefore not permit at use. Returns the bdf key and not the parent cap slot, per #1071's cascade-key argument: a slot can later hold a different device, a part's identity cannot. Bounds-check slot < 256; require kind == 0x154; row_id from target_ptr[15:0]; return gpio_line_row_ctrl(row_id). One push leaves rsp%16 == 0 at the nested call. Reserved labels: gpl_cts_.",
      block: {
        push rbx;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_cts_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;
        cmp r10, r11;
        jne gpl_cts_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;

        mov rdi, rbx;
        call gpio_line_row_ctrl;
        pop rbx;
        ret;

      gpl_cts_bad:
