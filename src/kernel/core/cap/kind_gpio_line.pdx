  // ==========================================================================
  // THE CAPABILITY-FORM RESOLVERS.
  //
  // Four of them, ALL ARITY ONE, all pinned by tools/build.sh. A caller
  // hands over a capability SLOT and receives a fact about the pin that
  // capability names; it cannot hand over a pin, a community or a pad
  // index and have it honoured, because there is nowhere to put one.
  //
  // Every field that participates in selecting a physical pad is here,
  // and that is the point: the register address is
  // community.reg_off + community.padbar + pad_index * stride, so a
  // caller-supplied community or pad index reaches a different pin
  // exactly as surely as a caller-supplied pin does.
  // ==========================================================================

  pub let gpio_line_pin_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): resolve a capability slot to the ONE absolute pin that capability authorises. Bounds-check slot < 256; require kind == KIND_GPIO_LINE (0x154); row_id from target_ptr[15:0]; return gpio_line_row_pin(row_id). GPIO_LINE_DECODE_BAD on a bad slot, a wrong kind, or a dead row -- never a plausible pin, which matters because pin 0 is a real pad on every controller. THIS IS THE PIN CONFINEMENT PROPERTY IN ONE FUNCTION: the parameter list is (slot) and nothing else, so the level and configuration ops built on it in R30.M6-003/004 physically cannot be handed a pin by their caller. Structurally, 'act on a different pin than my capability names' is not a refused request -- it is an unphrasable one. tools/build.sh pins the literal signature line, so a mutant that adds a pin parameter fails the build rather than the review. One push (rbx, which also carries the row_id) leaves rsp%16 == 0 at the nested call. Reserved labels: gpl_pos_.",
      block: {
        push rbx;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_pos_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;                  // KIND_GPIO_LINE
        cmp r10, r11;
        jne gpl_pos_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;                    // row_id

        mov rdi, rbx;
        call gpio_line_row_pin;
        pop rbx;
        ret;

      gpl_pos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let gpio_line_community_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-001 (#1075): resolve a capability slot to the community its pad lives in. ARITY ONE and pinned for the same reason gpio_line_pin_of_slot is, and the reason is specific rather than symmetric: the community selects the register WINDOW inside the BAR, so a caller-supplied community moves an access a whole bank -- to a pad with the same community-relative index in a different community, which is a perfectly valid pad belonging to a different pin. That is the single most dangerous confusion available on this part, because the resulting address is well-formed and inside the capability's window. Bounds-check slot < 256; require kind == 0x154; row_id from target_ptr[15:0]; return gpio_line_row_community(row_id). One push leaves rsp%16 == 0 at the nested call. Reserved labels: gpl_cos_.",
      block: {
        push rbx;

        mov r11, 256;
        cmp rdi, r11;
        jae gpl_cos_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x154;
        cmp r10, r11;
        jne gpl_cos_bad;

        mov rbx, [rax + 16];
        mov r10, 0xFFFF;
        and rbx, r10;

        mov rdi, rbx;
        call gpio_line_row_community;
        pop rbx;
        ret;

      gpl_cos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let gpio_line_pad_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
