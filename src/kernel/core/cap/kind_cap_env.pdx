// src/kernel/core/cap/kind_cap_env.pdx -- Wave UMB-W1 R125.M1 skeleton
// paideia-os #2591
//
// KIND_CAP_ENV = 0x5D, derived over KIND_MEMORY (= KIND_PAGE, base slot 4).
//
// A capability ENVIRONMENT is the bounded cap-flow a shell session hands
// into a cmd-module invocation at launch: a small, append-only (until
// FREEZE) collection of up to six caps indexed by SLOT. The parent
// umbrella (paideia-os #2478, R125 cap-flow) frames this as the
// mechanism that implements "every command runs in a bounded cap-flow":
// the shell mints a KIND_CAP_ENV, INSERTs the caps the command is
// authorised to touch (one slot per logical role: fs, net, tty, ...),
// FREEZEs the env, hands it to the cmd-module via R123 cmd-module
// invocation, and DESTROYs it when the command exits.
//
// =============================================================================
// SECTION 0  DERIVATION POSTURE
// =============================================================================
//
// KIND_CAP_ENV derives over KIND_MEMORY (= KIND_PAGE, base slot 4)
// because the artefact is a kernel-owned row in _cap_env_table referenced
// by env_handle (row index). Same posture as KIND_FIRMWARE_BLOB (0x3C),
// KIND_FW_MANIFEST (0x5B), KIND_SIG_KEY (0x1A3), KIND_TLS_TRUST (0x1A7):
// the kind field encodes the SEMANTIC (this is a bounded cap-flow
// environment) and the LAM-hint base slot encodes the RUNTIME SHAPE (a
// memory region). Full-u64 kind compare means the (deferred, R125.M2)
// dispatch arm at `cmp rcx, 0x5D` will coexist with the slot-4
// KIND_PAGE handler without ambiguity.
//
// =============================================================================
// SECTION 1  SLOT ASSIGNMENT  --  0x5D
// =============================================================================
//
// Numeric derived-kind tag KIND_CAP_ENV = 0x5D (decimal 93). Audit at
// landing time:
//   `grep -rnE 'cmp rcx, 0x5D\b' src/kernel/` returned zero hits -- no
//   existing dispatch arm overwritten. The adjacent Wave 84 I8
//   KIND_FW_MANIFEST took 0x5B, and the parallel R123.M1 KIND_CMD_MODULE
//   is reserving 0x5C in Wave UMB-W1. 0x5D is the next natural slot.
//
// 0x5D fits imm32 with bit 31 clear so no r9 staging is required; a
// future dispatch arm in cap/invoke.pdx would be a direct `cmp rcx,
// 0x5D` (R125.M2 wires that arm; R125.M1 lands the module only, same
// posture as R123.M1 which left its 0x5C -- 0x200 in the earlier
// landing -- arm unwired for its own M2 to pick up).
//
// =============================================================================
// SECTION 2  ROW LAYOUT  --  64 BYTES PER ROW, 16 ROWS
// =============================================================================
//
// Per R125.M1 task directive, each row is 64 bytes = 8 u64. Stride 64
// is a power of two so row addressing uses `shl rax, 6` -- no imul.
//
//   [+0]   flags             (u64)  bit 0 = IN_USE  (row allocated)
//                                   bit 1 = FROZEN  (read-only)
//                                   all other bits reserved (zero on
//                                   mint; .bss zero-init is the FREE
//                                   sentinel)
//   [+8]   cap_count         (u64)  number of populated slots (0..6)
//   [+16]  slot_0            (u64)  cap value at logical slot 0 (0 =
//                                   empty)
//   [+24]  slot_1            (u64)  cap value at logical slot 1
//   [+32]  slot_2            (u64)
//   [+40]  slot_3            (u64)
//   [+48]  slot_4            (u64)
//   [+56]  slot_5            (u64)
//
// Row-addressed capacity: CAP_ENV_MAX = 16 envs. 16 x 64 = 1024 bytes =
// 128 u64. Max six caps per env at skeleton level matches the R125 plan
// (one role per slot: fs / net / tty / stdout / stderr / stdin for a
// typical shell command; extended in a follow-up slice).
//
// The flags==0 sentinel marks a FREE row. The .bss zero-init gives us
// the FREE state for free at real boot; the defensive reset
// (cap_env_table_reset) covers chaos-restart / witness-replay paths.
//
// =============================================================================
// SECTION 3  RIGHTS  --  R_CAP_ENV_READ (0x001), R_CAP_ENV_FREEZE (0x002)
// =============================================================================
//
//   R_CAP_ENV_READ    (0x001)  gates the read-only ops in
//                              cap_handler_cap_env (COUNT, LOOKUP,
//                              IS_FROZEN).
//   R_CAP_ENV_FREEZE  (0x002)  reserved for a future handler-exposed
//                              freeze op (R125.M3). Create / insert /
//                              freeze / destroy at this landing are
//                              SUPERVISOR entrypoints that the shell
//                              calls directly; a ring-3 holder of a
//                              KIND_CAP_ENV cap cannot mint, mutate, or
//                              tear one down.
//
// R_CAP_ENV_ALL = R_CAP_ENV_READ | R_CAP_ENV_FREEZE = 0x003.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFFCC1..0xFFFFFCC5
// =============================================================================
//
// Per R125.M1 task directive this module reserves five contiguous codes:
//
//   CAP_ENV_BAD_ENV      = 0xFFFFFCC1  (env_handle out of range OR row
//                                       not in use)
//   CAP_ENV_ENV_FULL     = 0xFFFFFCC2  (overloaded: pool full on create
//                                       OR per-env slots full on insert)
//   CAP_ENV_ENV_FROZEN   = 0xFFFFFCC3  (insert / destroy mutation on a
//                                       frozen env)
//   CAP_ENV_BAD_SLOT     = 0xFFFFFCC4  (slot >= CAP_ENV_SLOTS = 6)
//   CAP_ENV_SLOT_EMPTY   = 0xFFFFFCC5  (future cap_env_remove on empty
//                                       slot; reserved at skeleton)
//
// All five fit imm32 with bit 31 clear (zero-extend-safe via the 7-byte
// `mov rax, imm32` emit). Band audit (2026-10-11): `grep -rnE
// '0xFFFFFCC[1-5]\b' src/ 2>/dev/null` returned zero hits -- clean band
// adjacent to the Wave 84 I8 FFFFFCB9..BD KIND_FW_MANIFEST band
// immediately below (gap of three codes BE..C0, left as a terminator
// margin) and the FFFFFCC0 fence immediately below our band
// (unrelated R20 code).
//
// =============================================================================
// SECTION 5  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x5D fits imm32, so a future compare uses `cmp rcx,
// 0x5D` directly (no r9/r11 staging). Error sentinels 0xFFFFFCC1..C5
// fit imm32 (zero-extend to u64 via `mov rax, imm32` 7-byte emit). Row
// stride 64 is a power of two: `shl rax, 6` (no 2-op `imul r, imm`
// which the paideia-as encoder does not emit). flag-bit tests use
// `cmp rN, 0` (never `test rN, rN`). All `pub let` string declarations
// are single-line. Module basename `KindCapEnv` matches the file
// basename `kind_cap_env.pdx`. Every label in this file is prefixed
// `ce_` (reserved-word discipline -- `loop`/`if`/`let` are keywords).
//
// klog_s1_x1 convention: 5 register params fit the SysV budget exactly
// so no stack arg is needed for the single-hex-KV fingerprint frames
// (CREATE / FREEZE / DESTROY). klog_s1_x1_d1 (INSERT) carries one
// decimal stack arg; v2 lives at the caller's [rsp+0] AFTER the stack
// adjust, per feedback_pdx_encoder_pitfalls "v2 at caller [rsp+0]".
// With TWO callee-save pushes + 1 stack-arg call, the stack adjust is
// `sub rsp, 24` (2-push shape per task directive). With THREE pushes,
// `sub rsp, 16`.
//
// Fingerprint tag `[u8; N]` string literals have N = string length + 1
// (the trailing NUL counts). Each tag's N is spelled next to the
// literal for audit.

module KindCapEnv = structure {

  pub let KIND_CAP_ENV      : u64 = 0x5D
  pub let KIND_CAP_ENV_BASE : u64 = 4         // = KIND_MEMORY (LAM-hint slot)

  // Capacity + geometry (§2).
  pub let CAP_ENV_MAX       : u64 = 16        // rows (envs)
  pub let CAP_ENV_SLOTS     : u64 = 6         // caps per env at skeleton
  pub let CAP_ENV_ROW_BYTES : u64 = 64        // 8 u64 per row

  // Flag bits (§2).
  pub let CAP_ENV_FLAG_IN_USE : u64 = 0x1
  pub let CAP_ENV_FLAG_FROZEN : u64 = 0x2

  // Row-handle sentinel (used internally by cap_env_find_free).
  pub let CAP_ENV_ROW_NONE : u64 = 0xFF

  // Rights (§3).
  pub let R_CAP_ENV_READ   : u64 = 0x001
  pub let R_CAP_ENV_FREEZE : u64 = 0x002
  pub let R_CAP_ENV_ALL    : u64 = 0x003

  // Handler ops (future wiring; R125.M2 adds the dispatch arm).
  pub let CAP_ENV_OP_COUNT     : u64 = 0  // -> cap_count
  pub let CAP_ENV_OP_LOOKUP    : u64 = 1  // op_arg[15:8] = slot -> cap|0
  pub let CAP_ENV_OP_IS_FROZEN : u64 = 2  // -> 0 or 1
  pub let CAP_ENV_OP_MAX       : u64 = 2

  // Return band (§4). All five fit imm32 (zero-extend to u64).
  pub let CAP_ENV_OK         : u64 = 0
  pub let CAP_ENV_BAD_ENV    : u64 = 0xFFFFFCC1
  pub let CAP_ENV_ENV_FULL   : u64 = 0xFFFFFCC2
  pub let CAP_ENV_ENV_FROZEN : u64 = 0xFFFFFCC3
  pub let CAP_ENV_BAD_SLOT   : u64 = 0xFFFFFCC4
  pub let CAP_ENV_SLOT_EMPTY : u64 = 0xFFFFFCC5

  // Standard cap_invoke sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Storage: 16 envs x 64 bytes = 1024 bytes = 128 u64.
  pub let mut _cap_env_table : [u64; 128] = uninit @align(64)

  // Observability counters: create_ok / create_refused_full / insert_ok /
  // insert_refused_full / insert_refused_frozen / freeze_ok / destroy_ok
  // / lookup_miss. Zero-init matches other kinds' discipline.
  pub let mut _cap_env_stats : [u64; 8] = uninit @align(64)

  pub let CE_ST_CREATE_OK     : u64 = 0
  pub let CE_ST_CREATE_FULL   : u64 = 1
  pub let CE_ST_INSERT_OK     : u64 = 2
  pub let CE_ST_INSERT_FULL   : u64 = 3
  pub let CE_ST_INSERT_FROZEN : u64 = 4
  pub let CE_ST_FREEZE_OK     : u64 = 5
  pub let CE_ST_DESTROY_OK    : u64 = 6
  pub let CE_ST_LOOKUP_MISS   : u64 = 7

  // Fingerprint tags. Byte counts NUL-inclusive per kernel-logging-
  // substrate.md discipline. N = len(string) + 1.
  //
  //   `CAP_ENV CREATE env=0x<16-hex>`           -- 15 chars + NUL = 16? -- the
  //                                                 string "CAP_ENV CREATE" is
  //                                                 14 chars, +1 NUL => N=15
  //   `CAP_ENV INSERT env=0x<16-hex> slot=<dec>` -- "CAP_ENV INSERT" = 14 chars
  //                                                 +1 NUL => N=15
  //   `CAP_ENV FREEZE env=0x<16-hex>`            -- 14 chars + 1 NUL => N=15
  //   `CAP_ENV DESTROY env=0x<16-hex>`           -- "CAP_ENV DESTROY" = 15
  //                                                  chars +1 NUL => N=16
  pub let ce_tag_create         : [u8; 15] = "CAP_ENV CREATE\0"
  pub let ce_tag_insert         : [u8; 15] = "CAP_ENV INSERT\0"
  pub let ce_tag_freeze         : [u8; 15] = "CAP_ENV FREEZE\0"
  pub let ce_tag_destroy        : [u8; 16] = "CAP_ENV DESTROY\0"
  pub let ce_tag_handler_entry  : [u8; 26] = "KIND_CAP_ENV dispatch inv\0"

  pub let ce_k_env  : [u8; 4] = "env\0"
  pub let ce_k_slot : [u8; 5] = "slot\0"

  // ==========================================================================
  // cap_env_table_reset() -> ()
  //
  // Defensive clear. Zero every u64 in _cap_env_table (128 words) and
  // _cap_env_stats (8 words). .bss zero-init already handles real boot;
  // this exists for the chaos-restart / witness-replay flow and matches
  // every other kind's `*_table_reset`.
  // ==========================================================================
  pub let cap_env_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M1 (paideia-os #2591): clear every _cap_env_table u64 (128 words) and every _cap_env_stats u64 (8 words). Boot and teardown only; defensive (matches kind_firmware_manifest fw_manifest_table_reset / cmd_module cmd_module_init one-for-one). Labels prefixed ce_tr_.",
      block: {
        lea r10, [rip + _cap_env_table];
        xor rax, rax;
        xor rcx, rcx;
      ce_tr_table:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  ce_tr_table;

        lea r10, [rip + _cap_env_stats];
        xor rcx, rcx;
      ce_tr_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ce_tr_stats;
        ret
      }
    }

  // ==========================================================================
  // cap_env_note(slot) -> ()
  //
  // Bump _cap_env_stats[slot]. Caller passes constants only (one of the
  // CE_ST_* ordinals); the bounds check guards against future
  // mis-callers.
  // ==========================================================================
  pub let cap_env_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M1 (paideia-os #2591): bounded increment on _cap_env_stats. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed ce_no_.",
      block: {
        cmp rdi, 8;
        jae ce_no_out;
        lea r10, [rip + _cap_env_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ce_no_out:
        ret
      }
    }

  // ==========================================================================
  // cap_env_row_base(env_handle) -> &_cap_env_table[env_handle*8]
  //
  // Row index -> row base pointer. Stride 64 = 2^6, so `shl rax, 6`
  // suffices (no `imul r, imm` encoder gap, no reg-reg staging). Caller
  // is responsible for validating env_handle < CAP_ENV_MAX first; this
  // helper is a pure address compute.
  // ==========================================================================
  pub let cap_env_row_base : (u64) -> u64 !{} @{} =
    fn (env_handle: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R125.M1 (paideia-os #2591): env_handle -> &_cap_env_table[env_handle*64]. Power-of-two stride uses `shl rax, 6` so no 2-op imul-with-imm is required. No bounds check by policy -- caller validates. Labels prefixed ce_rb_.",
      block: {
        mov rax, rdi;                    // env_handle
        shl rax, 6;                      // env_handle * 64
        lea r10, [rip + _cap_env_table];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // cap_env_row_in_use(env_handle) -> 1 iff env_handle<CAP_ENV_MAX and
  //                                        flags & CAP_ENV_FLAG_IN_USE
  //
  // Validator used by every mutating entrypoint. One callee-save push
  // (rbx) + sub rsp,8 keeps rsp%16==0 at the nested row-base call
  // (entry rsp%16==8; +push8+sub8 = +16 -> %16==8 -- WAIT -- +push8 ->
  // %16==0, that is call-ready; sub rsp,8 after moves us to %16==8).
  // Simpler: no pushes needed since this is a pure leaf -- row-base is
  // the only call and it is a leaf itself.
  // ==========================================================================
  pub let cap_env_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (env_handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M1 (paideia-os #2591): 1 iff env_handle<CAP_ENV_MAX(16) AND flags (word 0 at [+0]) & CAP_ENV_FLAG_IN_USE != 0. Inlined address compute (shl 6). Pure leaf -- no callee-save pushes, no nested calls. Labels prefixed ce_ru_.",
      block: {
        mov r10, 16;                     // CAP_ENV_MAX
        cmp rdi, r10;
        jae ce_ru_no;
        mov rax, rdi;
        shl rax, 6;                      // env_handle * 64
        lea r10, [rip + _cap_env_table];
        add rax, r10;                    // row base
        mov r10, [rax + 0];              // flags
        mov r11, 1;                      // CAP_ENV_FLAG_IN_USE
        and r10, r11;
        cmp r10, 0;
        je  ce_ru_no;
        mov rax, 1;
        ret;
      ce_ru_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cap_env_find_free() -> row_id | CAP_ENV_ROW_NONE
  //
  // Linear scan for the first row whose IN_USE bit is clear. Used only
  // by cap_env_create. Pure leaf (row-base is inlined).
  // ==========================================================================
  pub let cap_env_find_free : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M1 (paideia-os #2591): linear scan _cap_env_table[0..CAP_ENV_MAX) for the first row whose flags IN_USE bit is clear. Return row_id or CAP_ENV_ROW_NONE (0xFF). Inlined row-base (shl 6). Pure leaf -- no pushes. Labels prefixed ce_ff_.",
      block: {
        lea r10, [rip + _cap_env_table];
        xor rcx, rcx;                    // row_id cursor
      ce_ff_scan:
        cmp rcx, 16;
        jae ce_ff_none;

        mov rax, rcx;
        shl rax, 6;                      // row_id * 64
        add rax, r10;                    // row base
        mov r11, [rax + 0];              // flags
        mov r9,  1;                      // CAP_ENV_FLAG_IN_USE
        and r11, r9;
        cmp r11, 0;
        je  ce_ff_hit;                   // IN_USE clear -> free row

        add rcx, 1;
        jmp ce_ff_scan;

      ce_ff_hit:
        mov rax, rcx;
        ret;

      ce_ff_none:
        mov rax, 0xFF;                   // CAP_ENV_ROW_NONE
        ret
      }
    }

  // ==========================================================================
  // cap_env_create() -> env_handle | CAP_ENV_ENV_FULL
  //
  // Allocate a fresh row. Sets flags = IN_USE (bit 0), cap_count = 0,
  // and leaves slot_0..slot_5 at the .bss-zero / destroy-cleared state.
  // Emits `CAP_ENV CREATE env=0x<16-hex>` via klog_s1_x1 on success.
  //
  // Register plan: one callee-save push (rbx) parks the row_id across
  // the row-base + klog calls. Entry rsp%16==8; +1 push -> %16==0
  // (call-ready for the two nested calls below). klog_s1_x1 is a
  // 5-register-arg wrapper (no stack arg), so no additional sub rsp
  // is needed at its call site.
  // ==========================================================================
  pub let cap_env_create : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M1 (paideia-os #2591): mint a fresh KIND_CAP_ENV. Allocate via cap_env_find_free; on pool-full return CAP_ENV_ENV_FULL (bump CE_ST_CREATE_FULL). On success write flags=IN_USE, cap_count=0, bump CE_ST_CREATE_OK, emit `CAP_ENV CREATE env=0x<16-hex>` via klog_s1_x1 (5-reg wrapper, no stack arg). One callee-save push (rbx = row_id) lands rsp%16==0 at every nested call. Labels prefixed ce_cr_.",
      block: {
        push rbx;

        call cap_env_find_free;
        mov r10, 0xFF;
        cmp rax, r10;
        je  ce_cr_full;

        mov rbx, rax;                    // row_id

        // Row init: flags = IN_USE, cap_count = 0.
        mov rdi, rbx;
        call cap_env_row_base;
        mov r11, 1;                      // CAP_ENV_FLAG_IN_USE
        mov [rax + 0],  r11;             // flags
        xor r11, r11;
        mov [rax + 8],  r11;             // cap_count

        // Bump CE_ST_CREATE_OK.
        mov rdi, 0;                      // CE_ST_CREATE_OK
        call cap_env_note;

        // Emit `CAP_ENV CREATE env=0x<16-hex>` via klog_s1_x1 (5 regs).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ce_tag_create];
        lea rcx, [rip + ce_k_env];
        mov r8,  rbx;                    // env_handle
        call klog_s1_x1;

        mov rax, rbx;                    // return env_handle
        pop rbx;
        ret;

      ce_cr_full:
        mov rdi, 1;                      // CE_ST_CREATE_FULL
        call cap_env_note;
        mov rax, 0xFFFFFCC2;             // CAP_ENV_ENV_FULL
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_env_insert(env_handle, slot, cap) -> u64
  //
  // Add `cap` into env at `slot`. Validation ladder:
  //   1. env_handle < 16 AND row is IN_USE  -> else CAP_ENV_BAD_ENV
  //   2. flags & FROZEN == 0                -> else CAP_ENV_ENV_FROZEN
  //   3. slot < CAP_ENV_SLOTS (6)           -> else CAP_ENV_BAD_SLOT
  //   4. Target slot is empty AND cap_count == 6 -> CAP_ENV_ENV_FULL
  // Writes [row+16+slot*8] = cap. If the slot was previously empty
  // (zero) AND cap is non-zero, cap_count is incremented. If cap is
  // zero (clear operation), cap_count is decremented when the slot
  // previously held a cap. Emits `CAP_ENV INSERT env=0x<16-hex>
  // slot=<dec>` via klog_s1_x1_d1 (6 regs + 1 stack arg).
  //
  // Register plan: three callee-save pushes (rbx = env_handle, r12 =
  // slot, r13 = cap). Entry rsp%16==8; +3 pushes = +24 -> %16==0
  // (call-ready). The klog_s1_x1_d1 call needs one stack arg (vd), so
  // `sub rsp, 16` for 8 bytes arg + 8 pad keeps rsp%16==0 at the call
  // (per task directive: 3-push -> sub rsp, 16).
  // ==========================================================================
  pub let cap_env_insert : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (env_handle: u64) (slot: u64) (cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M1 (paideia-os #2591): add cap into env at slot. Validate env_handle via cap_env_row_in_use (else CAP_ENV_BAD_ENV); check flags & FROZEN (else CAP_ENV_ENV_FROZEN, bump CE_ST_INSERT_FROZEN); validate slot<CAP_ENV_SLOTS=6 (else CAP_ENV_BAD_SLOT); if slot empty AND cap_count==6 refuse (CAP_ENV_ENV_FULL, bump CE_ST_INSERT_FULL); else write [row+16+slot*8] = cap, update cap_count: +1 if newly filled, -1 if newly cleared. Emit `CAP_ENV INSERT env=0x<16-hex> slot=<dec>` via klog_s1_x1_d1 (6-reg + 1-stack-arg wrapper; v_dec at caller [rsp+0] after sub rsp,16 per feedback_pdx_encoder_pitfalls, 3-push -> sub rsp,16 for 8 arg + 8 pad). Three callee-save pushes (rbx=env_handle, r12=slot, r13=cap) land rsp%16==0 at every nested call. Labels prefixed ce_in_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // env_handle
        mov r12, rsi;                    // slot
        mov r13, rdx;                    // cap

        // Step 1: env_handle validity.
        mov rdi, rbx;
        call cap_env_row_in_use;
        cmp rax, 0;
        je  ce_in_bad_env;

        // Load row base for subsequent reads/writes.
        mov rdi, rbx;
        call cap_env_row_base;
        mov r10, rax;                    // r10 = row base (preserved
                                         // across the leaf flag/count
                                         // ops below; no further calls
                                         // until just before klog)

        // Step 2: FROZEN gate.
        mov r11, [r10 + 0];              // flags
        mov r9,  2;                      // CAP_ENV_FLAG_FROZEN
        and r11, r9;
        cmp r11, 0;
        jne ce_in_frozen;

        // Step 3: slot bounds.
        cmp r12, 6;                      // CAP_ENV_SLOTS
        jae ce_in_bad_slot;

        // Compute slot address: row + 16 + slot*8.
        mov rax, r12;
        shl rax, 3;                      // slot * 8
        add rax, r10;
        add rax, 16;                     // &row.slot[slot]
        mov r9,  [rax + 0];              // existing slot value

        // Step 4: full-when-empty check. If existing slot is 0 AND
        // cap_count == 6, we would be adding a 7th cap -> refuse.
        mov r11, [r10 + 8];              // cap_count
        cmp r9,  0;
        jne ce_in_write;                 // slot occupied -> overwrite
                                         // path (count stays same if
                                         // new cap != 0 else -1)
        cmp r13, 0;
        je  ce_in_write;                 // clearing an already-empty
                                         // slot -> no-op write path
                                         // (keep count unchanged)
        cmp r11, 6;                      // cap_count == 6?
        jae ce_in_full;

      ce_in_write:
        // Write cap into slot. Update cap_count:
        //   old=0, new!=0 -> +1 (fresh fill)
        //   old!=0, new=0 -> -1 (clear)
        //   old=0, new=0  -> no change
        //   old!=0, new!=0 -> no change (overwrite)
        mov [rax + 0], r13;              // slot = cap

        cmp r9,  0;
        jne ce_in_old_full;
        // old == 0
        cmp r13, 0;
        je  ce_in_count_done;            // 0 -> 0: no change
        // 0 -> non-zero: +1
        add r11, 1;
        mov [r10 + 8], r11;
        jmp ce_in_count_done;

      ce_in_old_full:
        // old != 0
        cmp r13, 0;
        jne ce_in_count_done;            // non-zero -> non-zero: no change
        // non-zero -> 0: -1 (cap_count > 0 invariant)
        sub r11, 1;
        mov [r10 + 8], r11;

      ce_in_count_done:
        // Bump CE_ST_INSERT_OK.
        mov rdi, 2;                      // CE_ST_INSERT_OK
        call cap_env_note;

        // Emit fingerprint via klog_s1_x1_d1. 6 regs: rdi=level, rsi=
        // subsys, rdx=tag, rcx=k_env, r8=v_env (hex), r9=k_slot;
        // caller stack [rsp+0] = v_slot (decimal). Three pushes already
        // on stack; sub rsp,16 (8 arg + 8 pad) keeps rsp%16==0.
        sub rsp, 16;
        mov [rsp + 0], r12;              // v_dec = slot
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ce_tag_insert];
        lea rcx, [rip + ce_k_env];
        mov r8,  rbx;                    // v_hex = env_handle
        lea r9,  [rip + ce_k_slot];
        call klog_s1_x1_d1;
        add rsp, 16;

        xor rax, rax;                    // CAP_ENV_OK
        jmp ce_in_out;

      ce_in_bad_env:
        mov rax, 0xFFFFFCC1;             // CAP_ENV_BAD_ENV
        jmp ce_in_out;

      ce_in_frozen:
        mov rdi, 4;                      // CE_ST_INSERT_FROZEN
        call cap_env_note;
        mov rax, 0xFFFFFCC3;             // CAP_ENV_ENV_FROZEN
        jmp ce_in_out;

      ce_in_bad_slot:
        mov rax, 0xFFFFFCC4;             // CAP_ENV_BAD_SLOT
        jmp ce_in_out;

      ce_in_full:
        mov rdi, 3;                      // CE_ST_INSERT_FULL
        call cap_env_note;
        mov rax, 0xFFFFFCC2;             // CAP_ENV_ENV_FULL

      ce_in_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_env_lookup(env_handle, slot) -> cap | 0
  //
  // Pure read. Returns 0 on miss (bad env OR bad slot OR empty slot --
  // spec: "returns 0 on miss"). Bumps CE_ST_LOOKUP_MISS when the
  // lookup resolves to a 0 slot but the env itself is valid (bad-env /
  // bad-slot are silent).
  //
  // Register plan: two callee-save pushes (rbx = env_handle, r12 =
  // slot). Entry rsp%16==8; +2 pushes = +16 -> %16==8 (NOT call-ready).
  // The one nested call (cap_env_row_in_use) is a leaf and does not
  // itself call out, so the %16==8 at its entry becomes %16==0 after
  // its own call-site discipline -- but the call instruction pushes 8
  // more bytes so the callee sees %16==0 which is WRONG (should see
  // %16==8). We must `sub rsp, 8` after the 2 pushes to realign. The
  // trailing `add rsp, 8` restores before the pops.
  // ==========================================================================
  pub let cap_env_lookup : (u64, u64) -> u64 !{mem} @{} =
    fn (env_handle: u64) (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M1 (paideia-os #2591): pure read. Returns slot value or 0 on any miss (bad env, bad slot, empty slot). Two callee-save pushes (rbx=env_handle, r12=slot) + sub rsp,8 land rsp%16==0 at every nested call (entry rsp%16==8; +2 pushes +sub8 = +24 -> %16==0). Labels prefixed ce_lu_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // env_handle
        mov r12, rsi;                    // slot

        // Validate env.
        mov rdi, rbx;
        call cap_env_row_in_use;
        cmp rax, 0;
        je  ce_lu_miss;

        // Validate slot.
        cmp r12, 6;                      // CAP_ENV_SLOTS
        jae ce_lu_miss;

        // Load row base + slot value.
        mov rax, rbx;
        shl rax, 6;                      // env_handle * 64
        lea r10, [rip + _cap_env_table];
        add rax, r10;                    // row base
        mov r11, r12;
        shl r11, 3;                      // slot * 8
        add rax, r11;
        mov rax, [rax + 16];             // slot value
        cmp rax, 0;
        je  ce_lu_miss_count;            // empty slot
        jmp ce_lu_out;

      ce_lu_miss_count:
        mov rdi, 7;                      // CE_ST_LOOKUP_MISS
        call cap_env_note;
        xor rax, rax;
        jmp ce_lu_out;

      ce_lu_miss:
        xor rax, rax;

      ce_lu_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_env_freeze(env_handle) -> CAP_ENV_OK | CAP_ENV_BAD_ENV
  //
  // Mark the env read-only. Idempotent: freezing an already-frozen env
  // succeeds silently (still bumps CE_ST_FREEZE_OK and emits a
  // fingerprint -- the record of the attempt is the fingerprint).
  //
  // Register plan: one callee-save push (rbx = env_handle). Entry
  // rsp%16==8; +1 push -> %16==0 (call-ready). klog_s1_x1 is 5 regs
  // (no stack arg).
  // ==========================================================================
  pub let cap_env_freeze : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (env_handle: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M1 (paideia-os #2591): set bit 1 (FROZEN) of flags. Validate env (else CAP_ENV_BAD_ENV); OR flags with CAP_ENV_FLAG_FROZEN; bump CE_ST_FREEZE_OK; emit `CAP_ENV FREEZE env=0x<16-hex>` via klog_s1_x1 (5-reg wrapper, no stack arg). One callee-save push (rbx) lands rsp%16==0 at every nested call. Labels prefixed ce_fz_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // env_handle

        mov rdi, rbx;
        call cap_env_row_in_use;
        cmp rax, 0;
        je  ce_fz_bad_env;

        // OR FROZEN bit into flags.
        mov rdi, rbx;
        call cap_env_row_base;
        mov r10, [rax + 0];              // flags
        mov r11, 2;                      // CAP_ENV_FLAG_FROZEN
        or  r10, r11;
        mov [rax + 0], r10;

        mov rdi, 5;                      // CE_ST_FREEZE_OK
        call cap_env_note;

        // Emit `CAP_ENV FREEZE env=0x<16-hex>`.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ce_tag_freeze];
        lea rcx, [rip + ce_k_env];
        mov r8,  rbx;
        call klog_s1_x1;

        xor rax, rax;                    // CAP_ENV_OK
        pop rbx;
        ret;

      ce_fz_bad_env:
        mov rax, 0xFFFFFCC1;             // CAP_ENV_BAD_ENV
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_env_destroy(env_handle) -> CAP_ENV_OK | CAP_ENV_BAD_ENV
  //
  // Zero every word of the row (flags, cap_count, slot_0..slot_5). After
  // the clear, flags==0 which is the FREE sentinel so a future create
  // scan picks the row up. DESTROY is unconditional on freeze state at
  // this skeleton (frozen means "no mutation OF CONTENTS"; teardown is
  // still permitted by the supervisor-side shell exit path).
  //
  // Register plan: one callee-save push (rbx = env_handle). Entry
  // rsp%16==8; +1 push -> %16==0 (call-ready).
  // ==========================================================================
  pub let cap_env_destroy : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (env_handle: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M1 (paideia-os #2591): tear down env. Validate env (else CAP_ENV_BAD_ENV); zero every u64 of the row (flags, cap_count, 6 slots) so flags==0 is the FREE sentinel for a future allocator scan. DESTROY is unconditional on freeze state (teardown is a supervisor-only right; the FROZEN bit protects CONTENTS, not EXISTENCE). Bump CE_ST_DESTROY_OK; emit `CAP_ENV DESTROY env=0x<16-hex>` via klog_s1_x1 (5-reg wrapper, no stack arg). One callee-save push (rbx) lands rsp%16==0 at every nested call. Labels prefixed ce_ds_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // env_handle

        mov rdi, rbx;
        call cap_env_row_in_use;
        cmp rax, 0;
        je  ce_ds_bad_env;

        // Zero the row (8 u64 = 64 bytes).
        mov rdi, rbx;
        call cap_env_row_base;
        xor r11, r11;
        mov [rax + 0],  r11;             // flags = 0 (publishes FREE)
        mov [rax + 8],  r11;             // cap_count
        mov [rax + 16], r11;             // slot_0
        mov [rax + 24], r11;             // slot_1
        mov [rax + 32], r11;             // slot_2
        mov [rax + 40], r11;             // slot_3
        mov [rax + 48], r11;             // slot_4
        mov [rax + 56], r11;             // slot_5

        mov rdi, 6;                      // CE_ST_DESTROY_OK
        call cap_env_note;

        // Emit `CAP_ENV DESTROY env=0x<16-hex>`.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ce_tag_destroy];
        lea rcx, [rip + ce_k_env];
        mov r8,  rbx;
        call klog_s1_x1;

        xor rax, rax;                    // CAP_ENV_OK
        pop rbx;
        ret;

      ce_ds_bad_env:
        mov rax, 0xFFFFFCC1;             // CAP_ENV_BAD_ENV
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_cap_env(rights, target_ptr, op_arg) -> u64
  //
  // KIND_CAP_ENV cap_invoke dispatch. R125.M2 wires the dispatch arm in
  // cap/invoke.pdx at `cmp rcx, 0x5D`; at R125.M1 the handler is
  // written and symbol-exposed but unreachable from ring 3 (no arm).
  //
  // target_ptr encodes env_handle in its low 8 bits (handles are
  // 0..CAP_ENV_MAX-1 = 0..15, which fits trivially in 4 bits -- the
  // standard row-encoding convention from cap/mint.pdx).
  //
  // op_arg layout:
  //   [7:0]   op_code
  //   [15:8]  slot (for LOOKUP; ignored otherwise)
  //
  // Ops (all read-only; the mutating entrypoints are supervisor-only):
  //   op 0 CAP_ENV_OP_COUNT     -> cap_count
  //   op 1 CAP_ENV_OP_LOOKUP    -> cap_env_lookup(env_handle, slot)
  //   op 2 CAP_ENV_OP_IS_FROZEN -> flags & FROZEN bit (0 or 1)
  //   else                      -> INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_CAP_ENV_READ.
  //
  // Register plan: three callee-save pushes (rbx = rights, r12 =
  // op_code, r13 = env_handle). Entry rsp%16==8; +3 pushes = +24 ->
  // %16==0 (call-ready at every nested call).
  // ==========================================================================
  pub let cap_handler_cap_env : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R125.M1 (paideia-os #2591): KIND_CAP_ENV read-only dispatch. Entry chatter (klog_s1 of ce_tag_handler_entry). Rights gate against R_CAP_ENV_READ (uniform). env_handle = target_ptr[7:0]; op_code = op_arg[7:0]; slot = op_arg[15:8]. op_code and slot are packed into r12 as (slot << 8) | op_code (= op_arg[15:0]) so a single callee-save register parks both across the nested klog chatter without needing a fourth push (3 pushes land rsp%16==0; 4 pushes would need a realigning sub rsp,8 slot). Op 0 COUNT returns cap_count via a direct row read (bad env -> INVOKE_DENIED). Op 1 LOOKUP delegates to cap_env_lookup with slot=(r12 >> 8). Op 2 IS_FROZEN returns the FROZEN bit (0 or 1). Three callee-save pushes (rbx=rights, r12=op_arg[15:0], r13=env_handle) land rsp%16==0 at every nested call. Labels prefixed ce_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r10, 0xFF;
        mov r13, rsi;
        and r13, r10;                    // env_handle = target_ptr[7:0]
        mov r12, rdx;
        mov r11, 0xFFFF;
        and r12, r11;                    // r12 = op_arg[15:0]
                                         //   bits [7:0]  = op_code
                                         //   bits [15:8] = slot

        // Entry chatter.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ce_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        mov r11, 1;                      // R_CAP_ENV_READ
        and r10, r11;
        cmp r10, 0;
        je  ce_hd_denied;

        // Extract op_code from the packed r12 for dispatch.
        mov r11, r12;
        and r11, 0xFF;                   // op_code
        cmp r11, 0;
        je  ce_hd_op_count;
        cmp r11, 1;
        je  ce_hd_op_lookup;
        cmp r11, 2;
        je  ce_hd_op_is_frozen;
        jmp ce_hd_unsup;

      ce_hd_op_count:
        // Return cap_count. Validate env first.
        mov rdi, r13;
        call cap_env_row_in_use;
        cmp rax, 0;
        je  ce_hd_bad_env;
        mov rdi, r13;
        call cap_env_row_base;
        mov rax, [rax + 8];              // cap_count
        jmp ce_hd_out;

      ce_hd_op_lookup:
        // Extract slot = r12[15:8]. (cap_env_lookup accepts slot >=
        // CAP_ENV_SLOTS as a miss and returns 0.)
        mov rsi, r12;
        shr rsi, 8;                      // slot
        and rsi, 0xFF;
        mov rdi, r13;                    // env_handle
        call cap_env_lookup;
        jmp ce_hd_out;

      ce_hd_op_is_frozen:
        mov rdi, r13;
        call cap_env_row_in_use;
        cmp rax, 0;
        je  ce_hd_bad_env;
        mov rdi, r13;
        call cap_env_row_base;
        mov rax, [rax + 0];              // flags
        mov r11, 2;                      // CAP_ENV_FLAG_FROZEN
        and rax, r11;
        shr rax, 1;                      // 0 or 1
        jmp ce_hd_out;

      ce_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp ce_hd_out;

      ce_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        jmp ce_hd_out;

      ce_hd_bad_env:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
                                         // (bad env from a handler
                                         // caller is a rights-reach
                                         // mismatch -- the slot points
                                         // at a dead or stale row; the
                                         // standard sentinel is DENIED
                                         // rather than CAP_ENV_BAD_ENV
                                         // because the handler is a
                                         // ring-3-reachable surface)

      ce_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx will add ONE new call alongside the existing table
  // resets:
  //
  //   call cap_env_table_reset;        // defensive zero
  //
  // Zero-arg, allocates nothing on the stack, touches rax/rcx/r10;
  // safe alongside kernel_main's live r12/r13/r14 handoff registers.
  // Wiring deferred to R125.M2 (same discipline every other `*_table_
  // reset` boot wiring follows). At real boot .bss zero-init leaves
  // _cap_env_table already in the FREE state so create works correctly
  // without the wiring.
  //
  // Dispatch arm (R125.M2 wires in cap/invoke.pdx after the Wave 84
  // KIND_FW_MANIFEST 0x5B arm and the parallel R123.M1 KIND_CMD_MODULE
  // 0x5C arm, iff that lands):
  //
  //   cmp rcx, 0x5D;
  //   je  call_kind_cap_env;
  //   ...
  //   call_kind_cap_env:
  //     call cap_handler_cap_env;
  //     ret;
  //
  // Cross-module caller sites (R125.M2 and later):
  //   - R123.M4 cmd-module launch: shell holds a KIND_CAP_ENV handle,
  //     INSERTs the per-command caps, FREEZEs, hands the handle to the
  //     cmd-module launcher via R123 cmd-module invocation ABI, and
  //     DESTROYs on exit.
  //   - R127.M* cap-flow checker: static-time verifier walks the env
  //     via cap_env_lookup to confirm the command's declared cap-flow
  //     matches the actual env it was handed.
  // ==========================================================================
}
