// src/kernel/core/cap/kind_capture.pdx -- R113.M7-036 (paideia-os #2416)
//
// KIND_CAPTURE = 0x1BE kernel-side substrate (row pool + grant + revoke +
// check).
//
// PURPOSE.  A capture-consent capability: a screenshot or screencast
// caller MUST present a valid KIND_CAPTURE cap before the compositor
// hands over pixel data.  The grant is scoped to a single source
// surface (or full-screen when source_surface == 0), a single grantee
// task, and a bounded validity window in monotonic-ns.  The check leaf
// is the sole gate every screenshot / screencast body reaches through
// -- passing arbitrary display bytes to a task that lacks a live
// KIND_CAPTURE grant is a policy violation with no legal path today.
//
// This landing is the KERNEL-SIDE mechanism.  Policy (who is allowed
// to mint a KIND_CAPTURE, when the compositor UI must prompt the user,
// how long a default grant lives) lives in the follow-on capture-broker
// landing that speaks OP_CAPTURE_GRANT / OP_CAPTURE_REVOKE via the cap
// dispatcher.  The three ops here are the invariant primitives; the
// broker layers a UX + duration-policy above them.
//
// IDENTITY CHOICE -- capture_id == row_id (slot).  Same identity
// discipline as kind_session (session_id == row_id) and kind_surface
// (row_id is the visible handle).  The LAM generation on row+0 is what
// invalidates a stale handle to a reused slot -- a distinct
// monotonic-id space would double the state and buy nothing.
//
// SCOPE OF THIS LANDING (per issue #2416):
//   * Substrate: row pool (CAPTURE_ROW_MAX = 16 rows * 64 bytes = 1 KiB),
//     _capture_stats[8], and the init leaf that scrubs both.
//   * Ops: capture_grant(source_surface, granted_task, duration_ns)
//              -> capture_id | error,
//          capture_revoke(capture_id) -> 0 | error,
//          capture_check(capture_id, task) -> 1 (allowed) | 0 (denied).
//   * Fingerprint: `CAPTURE GRANT OK id=<n> src=<n> expires=<n>` via
//     klog_s1_x3 (3 hex KVs).  Revoke / check DO NOT emit fingerprints
//     -- the grant tag is the only R113.M7-036 boot-witness anchor per
//     the issue's fingerprint contract, matching kind_session's
//     mint-only emit posture.
//   * Row accessors (capture_row_valid / capture_row_addr /
//     capture_row_task_get / capture_row_source_get /
//     capture_row_expires_get) as pure leaves for consumers in the
//     follow-on capture-broker + screenshot syscall landings.
//
// DERIVED-KIND POSITIONING.  KIND_CAPTURE derives from KIND_IPC_
// ENDPOINT (= 5) in the abstract graph -- capture is a rendez-vous
// between a broker (holds R_CAPTURE_MINT), a grantee task (holds a
// capture_id + performs check), and the compositor (calls check
// during the screenshot body).  The concrete substrate parent is nil
// (this kind is the root of the capture sub-graph).
//
// KIND-ID SLOT ALLOCATION -- 0x1BE.
//   0x1BC  KIND_SESSION             (R113.M5-022)
//   0x1BD  reserved (next-free run above KIND_SESSION)
//   0x1BE  KIND_CAPTURE             (THIS LANDING, R113.M7-036)
//   0x1BF  free (next fresh slot for follow-on rows)
//
// A tree-wide grep for `= 0x1BE` across src/**/*.pdx returns zero
// declarations before this landing (verified at landing time; the
// only nearby mentions are the reserved-range comments in
// kind_session.pdx L73 and kind_kek.pdx L31 which name 0x1B2..0x1BF
// as the R101 G7+ reserved band).
//
// FAILURE BAND -- 0xFFFFE2D0..0xFFFFE2DF.  Verified free by tree-wide
// grep for 0xFFFFE2D* against src/**/*.pdx (empty match at landing
// time); allocated per the issue's pre-assigned band directive.
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+):
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- row-offset math uses `shl r, 6` for *64.
//   * No `and reg, imm64` -- the 56-bit gen mask (0x00FFFFFFFFFFFFFF)
//     is staged through `mov r9, imm64` then `and r11, r9`.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement form `[reg + 8N]`
//     used throughout; register-scaled `[reg + rcx * 8]` (SIB-legal
//     scale) is used only in the stats bumpers and init scrub.
//   * Reserved-keyword labels avoided (loop/if/let/while/for/match/pub/
//     mod/use/fn/struct/enum/impl/trait/type/where/move/mut/ref).
//     Label prefixes:  cap_init_  cap_bg_  cap_bv_  cap_br_
//                      cap_bd_    cap_g_   cap_v_   cap_c_
//                      cap_rv_    cap_ra_  cap_rt_  cap_rs_  cap_re_
//
// STACK DISCIPLINE (grant path calls klog_s1_x3 with a 3-arg v-push).
// The x3-push idiom is lifted verbatim from src/kernel/core/fs/pdxfs/
// cow_write.pdx L996-1002:
//     sub rsp, 8;      // pad to keep rsp%16==0 after the 3 pushes
//     push <v3>;       // 9th klog arg
//     push <k3>;       // 8th klog arg
//     push <v2>;       // 7th klog arg
//     call klog_s1_x3;
//     add rsp, 32;     // undo pad + 3 pushes
// The grant prologue lands rsp%16 == 0 before the sub/push block via
// 5 callee-save pushes (rbx, r12, r13, r14, r15) matching kind_surface
// mint's discipline.
//
// TIME SOURCE.  capture_grant + capture_check both call hpet_now_ns
// (src/kernel/core/time/hpet.pdx) as the monotonic clock.  The 2-arg
// check signature (capture_id, task) per issue #2416 forces this
// (a caller-supplied `now_ns` third arg would let the leaf stay
// capability-clean like scanout_expiry_sweep does, but the issue's
// contract is 2-arg).  hpet_now_ns carries @{boot}; both ops inherit
// it via effect propagation, kept narrow (no other capability bleed).

module KindCapture = structure {

  // ==========================================================================
  // SECTION 1 -- IDENTITY + PARENT + POOL CEILING
  // ==========================================================================

  pub let KIND_CAPTURE_ID    : u64 = 0x1BE
  pub let KIND_CAPTURE_BASE  : u64 = 5           // = KIND_IPC_ENDPOINT

  // Pool ceiling.  16 concurrent grants covers: (a) a running
  // screenshot tool (1 grant, full-screen), (b) a screencast recorder
  // (1 grant, single-surface), (c) a broker-issued short-lived grant
  // for a snapshot preview (1 grant), (d) 3-4 held grants across a
  // desktop-switch or fast-user-switch chain, (e) 8+ additional
  // headroom for a chained multi-surface recording scenario.  16 * 64
  // = 1024 bytes -- one quarter-page slab, matches SURFACE_ROW_MAX /
  // SESSION_ROW_MAX one-for-one so the substrate math is uniform.
  pub let CAPTURE_ROW_MAX   : u64 = 16
  pub let CAPTURE_ROW_BYTES : u64 = 64
  pub let CAPTURE_ROW_WORDS : u64 = 8

  // ==========================================================================
  // SECTION 2 -- RIGHTS
  // ==========================================================================
  //
  // Rights split so a screenshot tool (holds CHECK) is distinct from
  // the broker that mints its grants (holds GRANT + MINT + REVOKE).
  // R_CAPTURE_READ / _OBSERVE are the introspection rights a status
  // widget (or a privacy-indicator overlay) uses to enumerate the
  // live-grant set for the current user.
  //
  //   R_CAPTURE_READ         -- read capture_id, grantee, source, expiry
  //   R_CAPTURE_GRANT        -- mint a new capture row via capture_grant
  //   R_CAPTURE_REVOKE       -- revoke a live capture row
  //   R_CAPTURE_CHECK        -- exercise capture_check on a specific id
  //   R_CAPTURE_MINT         -- derive a child capture grant (future)
  //   R_CAPTURE_OBSERVE      -- introspection (live-grant enumeration)

  pub let R_CAPTURE_READ     : u64 = 0x001
  pub let R_CAPTURE_GRANT    : u64 = 0x008
  pub let R_CAPTURE_REVOKE   : u64 = 0x010
  pub let R_CAPTURE_CHECK    : u64 = 0x020
  pub let R_CAPTURE_MINT     : u64 = 0x200
  pub let R_CAPTURE_OBSERVE  : u64 = 0x400
  pub let R_CAPTURE_ALL      : u64 = 0x639
    // 0x001 | 0x008 | 0x010 | 0x020 | 0x200 | 0x400 = 0x639

  // ==========================================================================
  // SECTION 3 -- ROW LAYOUT OFFSETS
  // ==========================================================================
  //
  //   +0   hdr        in_use[63:56] | generation[55:0]  (56-bit LAM ABA)
  //   +8   capture_id (u64; == row_id, mirrored for legibility)
  //   +16  granted_to_task (u64; the grantee task; capture_check enforces)
  //   +24  source_surface (u64; surface_id whose pixels this grant reads;
  //                        0 means full-screen -- the compositor's own
  //                        front buffer is the source)
  //   +32  granted_ns (u64; hpet_now_ns at grant time -- audit trail
  //                    for a live-grants enumerator)
  //   +40  expires_ns (u64; absolute monotonic-ns; a check firing after
  //                    hpet_now_ns >= expires_ns denies the grant.
  //                    expires_ns == 0 is a permanent grant (issue
  //                    #2416 allows duration_ns == 0 as a broker-scoped
  //                    "no expiry" contract; the check leaf mirrors
  //                    that -- 0 means skip the expiry gate))
  //   +48  reserved   (future: parent_capture_id for delegated grants)
  //   +56  reserved   (future: revoked_by_task for audit rollup)

  pub let CAPTURE_OFF_HDR        : u64 = 0
  pub let CAPTURE_OFF_ID         : u64 = 8
  pub let CAPTURE_OFF_TASK       : u64 = 16
  pub let CAPTURE_OFF_SOURCE     : u64 = 24
  pub let CAPTURE_OFF_GRANTED    : u64 = 32
  pub let CAPTURE_OFF_EXPIRES    : u64 = 40
  pub let CAPTURE_OFF_RESERVED1  : u64 = 48
  pub let CAPTURE_OFF_RESERVED2  : u64 = 56

  // Full-screen sentinel for source_surface.  A zero here is a legal
  // grant value meaning "compositor's own front buffer".  Any nonzero
  // value MUST correspond to a live KIND_SURFACE row; that liveness
  // gate lives on the broker side (this substrate treats source_surface
  // as an opaque u64 to keep the leaf pure).
  pub let CAPTURE_SOURCE_FULLSCREEN : u64 = 0

  // Permanent-grant sentinel for duration_ns.  A caller that passes
  // duration_ns == 0 gets a row whose expires_ns is stamped as 0, and
  // capture_check skips the expiry gate for such rows.  This is the
  // broker-policy escape hatch (a system-level "screenshot service"
  // that lives for the whole session, not a bounded per-invocation
  // grant); the broker enforces UX rules around when such a grant is
  // legitimate.
  pub let CAPTURE_DURATION_PERMANENT : u64 = 0

  // ==========================================================================
  // SECTION 4 -- FAILURE TAXONOMY -- 0xFFFFE2D0..0xFFFFE2DF
  // ==========================================================================
  //
  // Verified free by tree-wide grep for 0xFFFFE2D* against src/**/*.pdx
  // (empty match) at landing time.

  pub let CAPTURE_OK                    : u64 = 0
  pub let CAPTURE_TAIL_ENOSPC           : u64 = 0xFFFFE2DF
  pub let CAPTURE_GRANT_BAD_TASK        : u64 = 0xFFFFE2DE
  pub let CAPTURE_GRANT_BAD_DURATION    : u64 = 0xFFFFE2DD
  pub let CAPTURE_BAD_SLOT              : u64 = 0xFFFFE2DC
  pub let CAPTURE_REVOKE_ALREADY        : u64 = 0xFFFFE2DB
  pub let CAPTURE_CHECK_EXPIRED         : u64 = 0xFFFFE2DA
  pub let CAPTURE_CHECK_WRONG_TASK      : u64 = 0xFFFFE2D9
  pub let CAPTURE_GEN_MISMATCH          : u64 = 0xFFFFE2D8
  pub let CAPTURE_BAD_ARG               : u64 = 0xFFFFE2D7
  pub let CAPTURE_WRONG_KIND            : u64 = 0xFFFFE2D6
  pub let CAPTURE_UNSUP_OP              : u64 = 0xFFFFE2D5
  pub let CAPTURE_BAD_RIGHTS            : u64 = 0xFFFFE2D4
  pub let CAPTURE_ROW_NONE              : u64 = 0xFFFFE2D3
  pub let CAPTURE_MINT_BAD_RIGHTS       : u64 = 0xFFFFE2D2
  pub let CAPTURE_RESERVED_2D1          : u64 = 0xFFFFE2D1
  pub let CAPTURE_DECODE_BAD            : u64 = 0xFFFFE2D0

  // ==========================================================================
  // SECTION 5 -- POOL SUBSTRATE
  // ==========================================================================
  //
  // 16 rows * 64 bytes = 1024 bytes = 128 u64 words.  Stats table sized
  // to 8 slots to leave headroom for follow-on landings (a per-op
  // denials counter, a check-hit counter for observability).  Pool
  // named `_captures` per issue #2416 contract (kind_session's
  // parallel pool is `_sessions`; the naming shape is consistent).

  pub let mut _captures        : [u64; 128] = uninit @align(64)  // 16 * 8
  pub let mut _capture_stats   : [u64; 8]   = uninit @align(64)

  pub let CAPTURE_ST_GRANTS         : u64 = 0
  pub let CAPTURE_ST_REVOKES        : u64 = 1
  pub let CAPTURE_ST_REFUSED        : u64 = 2
  pub let CAPTURE_ST_CHECKS_ALLOWED : u64 = 3
  pub let CAPTURE_ST_CHECKS_DENIED  : u64 = 4
  pub let CAPTURE_ST_MAX            : u64 = 8

  // ==========================================================================
  // SECTION 6 -- FINGERPRINT TAG + KV KEY NAMES
  // ==========================================================================
  //
  // Only the grant tag is emitted by this landing (per issue #2416's
  // fingerprint contract).  Byte counts verified by hand:
  //
  //   "capture grant ok [legacy: CAPTURE GRANT OK]\0" = 44 bytes
  //     - "capture grant ok"                    = 16
  //     - " [legacy: CAPTURE GRANT OK]"         = 27
  //     - NUL                                   = 1
  //     -------------------------------------------
  //     - total                                 = 44
  //
  // KV keys: "id\0" (3), "src\0" (4), "expires\0" (8).  The tag prefix
  // + KV keys reconstitute the issue-required wire line shape verbatim:
  //     "CAPTURE GRANT OK id=<n> src=<n> expires=<n>"

  pub let capture_grant_ok_msg : [u8; 44] = "capture grant ok [legacy: CAPTURE GRANT OK]\0"
  pub let capture_k_id         : [u8; 3]  = "id\0"
  pub let capture_k_src        : [u8; 4]  = "src\0"
  pub let capture_k_expires    : [u8; 8]  = "expires\0"

  // ==========================================================================
  // SECTION 7 -- STATS BUMPERS (narrow writers)
  // ==========================================================================
  //
  // Narrow writers per the kind_surface / kind_session discipline:
  // one leaf per stats slot, load-inc-store, no `add reg, [mem]`.
  // The ONLY writers of _capture_stats.

  pub let capture_stats_bump_grants : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): bump _capture_stats[CAPTURE_ST_GRANTS=0]. Load-inc-store leaf, no `add reg, [mem]`. Called from capture_grant success tail only. Labels prefixed cap_bg_.",
      block: {
        lea r10, [rip + _capture_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let capture_stats_bump_revokes : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): bump _capture_stats[CAPTURE_ST_REVOKES=1]. Load-inc-store leaf. Called from capture_revoke success tail only. Labels prefixed cap_bv_.",
      block: {
        lea r10, [rip + _capture_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let capture_stats_bump_refused : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): bump _capture_stats[CAPTURE_ST_REFUSED=2]. Load-inc-store leaf. Called from every refusal funnel across grant/revoke (check has its own allowed/denied counters) -- matches kind_session's session_stats_bump_refused broad scope. Labels prefixed cap_br_.",
      block: {
        lea r10, [rip + _capture_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  pub let capture_stats_bump_check_allowed : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): bump _capture_stats[CAPTURE_ST_CHECKS_ALLOWED=3]. Load-inc-store leaf. Called from capture_check success tail only. Labels prefixed cap_bd_ (a=allowed disambiguator inline).",
      block: {
        lea r10, [rip + _capture_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        ret
      }
    }

  pub let capture_stats_bump_check_denied : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): bump _capture_stats[CAPTURE_ST_CHECKS_DENIED=4]. Load-inc-store leaf. Called from capture_check denial arms (bad slot / wrong task / expired). Labels prefixed cap_bd_ (d=denied disambiguator inline).",
      block: {
        lea r10, [rip + _capture_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- BOOT INIT (kind_capture_init)
  // ==========================================================================
  //
  // Zeroes _captures (128 u64 words = 1 KiB) and _capture_stats (8 u64
  // = 64 B).  Defensive re-scrub matching kind_surface_init /
  // kind_session_init / kind_kek_init one-for-one.  .bss is zero at
  // real boot; this leaf gives a future chaos-restart witness (and any
  // repeat call to the init sequence) a clean re-scrub point.

  pub let kind_capture_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): zero _captures (128 u64) and _capture_stats (8 u64). Defensive boot-time re-scrub, mirrors kind_session_init / kind_surface_init one-for-one. Two straight-line loops. Labels prefixed cap_init_.",
      block: {
        lea r10, [rip + _captures];
        xor rax, rax;
        xor rcx, rcx;
      cap_init_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  cap_init_rows;

        lea r10, [rip + _capture_stats];
        xor rcx, rcx;
      cap_init_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cap_init_stats;

        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- ROW ACCESSORS (pure leaves)
  // ==========================================================================
  //
  // Every accessor takes a capture_id (== row_id / slot);
  // return-shape sentinels use CAPTURE_BAD_SLOT = 0xFFFFE2DC.

  // capture_row_valid(capture_id) -> 1 iff capture_id < CAPTURE_ROW_MAX
  // and the row's in_use byte (top byte of hdr) is nonzero.
  pub let capture_row_valid : (u64) -> u64 !{mem} @{} =
    fn (capture_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): 1 iff capture_id < CAPTURE_ROW_MAX(16) and in_use set. Inlined address compute (capture_id*64 via shl 6). Labels prefixed cap_rv_.",
      block: {
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp rdi, r10;
        jae cap_rv_no;
        lea r10, [rip + _captures];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_rv_no;
        mov rax, 1;
        ret;
      cap_rv_no:
        xor rax, rax;
        ret
      }
    }

  // capture_row_addr(capture_id) -> &_captures[capture_id*64] iff live; 0 else.
  pub let capture_row_addr : (u64) -> u64 !{mem} @{} =
    fn (capture_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): row base pointer post-liveness. Returns 0 on invalid slot. Exported for the follow-on capture-broker landing for its live-grants enumerator. Labels prefixed cap_ra_.",
      block: {
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp rdi, r10;
        jae cap_ra_no;
        lea r10, [rip + _captures];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_ra_no;
        mov rax, r10;
        ret;
      cap_ra_no:
        xor rax, rax;
        ret
      }
    }

  // capture_row_task_get(capture_id) -> granted_to_task | CAPTURE_BAD_SLOT.
  pub let capture_row_task_get : (u64) -> u64 !{mem} @{} =
    fn (capture_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): raw granted_to_task load from row+16. Labels prefixed cap_rt_.",
      block: {
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp rdi, r10;
        jae cap_rt_bad;
        lea r10, [rip + _captures];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_rt_bad;
        mov rax, [r10 + 16];
        ret;
      cap_rt_bad:
        mov rax, 0xFFFFE2DC;
        ret
      }
    }

  // capture_row_source_get(capture_id) -> source_surface | CAPTURE_BAD_SLOT.
  pub let capture_row_source_get : (u64) -> u64 !{mem} @{} =
    fn (capture_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): raw source_surface load from row+24. Labels prefixed cap_rs_.",
      block: {
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp rdi, r10;
        jae cap_rs_bad;
        lea r10, [rip + _captures];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_rs_bad;
        mov rax, [r10 + 24];
        ret;
      cap_rs_bad:
        mov rax, 0xFFFFE2DC;
        ret
      }
    }

  // capture_row_expires_get(capture_id) -> expires_ns | CAPTURE_BAD_SLOT.
  pub let capture_row_expires_get : (u64) -> u64 !{mem} @{} =
    fn (capture_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-036 (#2416): raw expires_ns load from row+40. Returns 0 for a permanent-grant row (expires_ns == 0 sentinel). Labels prefixed cap_re_.",
      block: {
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp rdi, r10;
        jae cap_re_bad;
        lea r10, [rip + _captures];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_re_bad;
        mov rax, [r10 + 40];
        ret;
      cap_re_bad:
        mov rax, 0xFFFFE2DC;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- capture_grant(source_surface, granted_task, duration_ns)
  //                -> capture_id | error
  // ==========================================================================
  //
  // Gate order:
  //   (1) granted_task != 0         -> else CAPTURE_GRANT_BAD_TASK
  //       (source_surface == 0 is legal; that is the full-screen sentinel.
  //        duration_ns  == 0 is legal; that is the permanent-grant sentinel.)
  //   (2) low-first free-slot scan  -> else CAPTURE_TAIL_ENOSPC
  //   (3) hpet_now_ns() -> granted_ns (monotonic clock read via
  //       src/kernel/core/time/hpet.pdx; falls back to 0 when
  //       _hpet_mmio_va is unset, which the check leaf tolerates --
  //       a 0 granted_ns with 0 duration_ns lands as a permanent
  //       grant, and a 0 granted_ns with a nonzero duration_ns lands
  //       as `expires_ns = duration_ns`, still a valid live window
  //       from the check's perspective)
  //   (4) expires_ns:
  //         duration_ns == 0  -> expires_ns = 0 (permanent grant)
  //         else              -> expires_ns = granted_ns + duration_ns
  //   (5) LAM header bump: low-56 gen+1, OR in 1<<56 in_use marker
  //   (6) row stamp per SECTION 3:
  //         +8   capture_id (= row_id)
  //         +16  granted_task
  //         +24  source_surface
  //         +32  granted_ns
  //         +40  expires_ns
  //         +48/+56 reserved = 0
  //   (7) stats.grants++
  //   (8) klog CAPTURE GRANT OK id=<capture_id> src=<source_surface>
  //       expires=<expires_ns> via klog_s1_x3
  //   (9) return capture_id
  //
  // Register plan: rbx=capture_id (survives klog), r12=source_surface
  // (for KV), r13=granted_task, r14=duration_ns, r15=expires_ns (for KV).
  // 5 callee-save pushes = 40 B; entry rsp%16==8 -> post-pushes rsp%16==0,
  // safe for every nested call.  hpet_now_ns / bumper preserves callee-
  // saves (SysV) so rbx/r12-r15 survive through the whole body.
  //
  // The klog_s1_x3 v-push idiom is lifted verbatim from
  // src/kernel/core/fs/pdxfs/cow_write.pdx L996-1002:
  //     sub rsp, 8;      // pad to keep rsp%16==0 after 3 pushes
  //     push v3;         // expires_ns
  //     push k3;         // &capture_k_expires
  //     push v2;         // source_surface
  //     call klog_s1_x3;
  //     add rsp, 32;     // undo pad + 3 pushes

  pub let capture_grant : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap, boot} =
    fn (source_surface: u64) (granted_task: u64) (duration_ns: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, boot},
      justification: "R113.M7-036 (#2416): mint KIND_CAPTURE grant. Gate order: (1) granted_task != 0 else BAD_TASK (source_surface == 0 is legal FULLSCREEN sentinel; duration_ns == 0 is legal PERMANENT sentinel); (2) low-first scan over 16 rows else TAIL_ENOSPC; (3) hpet_now_ns() -> granted_ns; (4) expires_ns computed (0 for permanent, granted_ns+duration_ns otherwise); (5) LAM header bump; (6) row stamp per section 3; (7) stats.grants++; (8) klog CAPTURE GRANT OK id=<row_id> src=<source_surface> expires=<expires_ns> via klog_s1_x3 with the 3-push idiom lifted from cow_write.pdx L996-1002; (9) return row_id. Five callee-save pushes (rbx=capture_id, r12=source_surface, r13=granted_task, r14=duration_ns, r15=expires_ns) leave rsp%16==0 for every nested call. hpet_now_ns and the bumper preserve callee-saves per SysV. Refusal funnel bumps stats.refused. Effects {mem, sysreg}: mem for row + counter stores; sysreg for the klog path (serial writes). Capabilities {cap, boot}: cap for the substrate mint role; boot propagates from hpet_now_ns's own @{boot} annotation. Labels prefixed cap_g_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // source_surface
        mov r13, rsi;                        // granted_task
        mov r14, rdx;                        // duration_ns

        // Gate 1: granted_task != 0
        cmp r13, 0;
        je  cap_g_bad_task;

        // Gate 2: low-first scan over 16 rows for in_use == 0
        xor rcx, rcx;                        // idx = 0
      cap_g_scan:
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp rcx, r10;
        jae cap_g_enospc;

        lea r10, [rip + _captures];
        mov r11, rcx;
        shl r11, 6;                          // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_g_claim;

        add rcx, 1;
        jmp cap_g_scan;

      cap_g_claim:
        // rcx = free slot idx; r10 = row base pointer.
        mov rbx, rcx;                        // save capture_id in callee-save
        // Save row base across the hpet_now_ns call.  r10 is caller-save
        // in SysV so we must recompute the row base after the call;
        // rbx (capture_id) is callee-save so recomputing via shl 6 is
        // cheap and avoids a 6th callee-save push.

        // (3) granted_ns = hpet_now_ns()
        //   Nested call: rsp%16 == 0 at this point (5 pushes from entry
        //   rsp%16 == 8 -> 0).  hpet_now_ns preserves callee-saves.
        call hpet_now_ns;
        //   rax = granted_ns.  Save granted_ns in r11 while we compute
        //   expires_ns; r11 is caller-save but we finish using it before
        //   any further call.
        mov r11, rax;                        // r11 = granted_ns

        // (4) expires_ns:
        //   duration_ns == 0  -> expires_ns = 0 (permanent grant)
        //   else              -> expires_ns = granted_ns + duration_ns
        cmp r14, 0;
        je  cap_g_perm;
        mov r15, r11;                        // r15 = granted_ns
        add r15, r14;                        // r15 = granted_ns + duration_ns
        jmp cap_g_have_expires;
      cap_g_perm:
        xor r15, r15;                        // r15 = 0 (permanent)
      cap_g_have_expires:

        // Recompute row base (r10 was clobbered by hpet_now_ns).
        lea r10, [rip + _captures];
        mov r9, rbx;
        shl r9, 6;                           // capture_id * 64
        add r10, r9;                         // r10 = row base

        // (5) LAM: hdr = ((old_gen + 1) & 0x00FFFFFFFFFFFFFF) | (1<<56)
        mov r8, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r8, r9;                          // r8 = old low-56 gen
        add r8, 1;
        and r8, r9;                          // clip to 56 bits
        mov rcx, 1;
        shl rcx, 56;                         // rcx = 1<<56 (in_use marker)
        or  r8, rcx;
        mov [r10 + 0], r8;                   // write new hdr

        // (6a) capture_id (== row_id, mirrored at +8 for legibility)
        mov [r10 + 8], rbx;

        // (6b) granted_task
        mov [r10 + 16], r13;

        // (6c) source_surface
        mov [r10 + 24], r12;

        // (6d) granted_ns (still in r11)
        mov [r10 + 32], r11;

        // (6e) expires_ns
        mov [r10 + 40], r15;

        // (6f) reserved words = 0
        xor rax, rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        // (7) stats.grants++
        call capture_stats_bump_grants;

        // (8) klog_s1_x3(LEVEL_INFO=3, SUBSYS_CAP_, capture_grant_ok_msg,
        //                capture_k_id, id=rbx,
        //                capture_k_src, src=r12,
        //                capture_k_expires, expires=r15)
        //   Stack shape (post 3 pushes + 1 pad = 32 bytes below rsp):
        //     [rsp+0]  = v2 (source_surface)
        //     [rsp+8]  = k3 (&capture_k_expires)
        //     [rsp+16] = v3 (expires_ns)
        //     [rsp+24] = 8-byte pad
        //   rsp%16 == 0 post 5 callee-save pushes; sub 8 -> 8; push v3 ->
        //   0; push k3 -> 8; push v2 -> 0 (aligned pre-call).
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + capture_grant_ok_msg];
        lea rcx, [rip + capture_k_id];
        mov r8, rbx;                         // v1 = capture_id
        lea r9, [rip + capture_k_src];

        sub rsp, 8;                          // pad
        push r15;                            // v3 = expires_ns
        lea r10, [rip + capture_k_expires];
        push r10;                            // k3
        push r12;                            // v2 = source_surface
        call klog_s1_x3;
        add rsp, 32;                         // undo pad + 3 pushes

        mov rax, rbx;                        // return capture_id
        jmp cap_g_out;

      cap_g_bad_task:
        mov rax, 0xFFFFE2DE;
        jmp cap_g_refused;
      cap_g_enospc:
        mov rax, 0xFFFFE2DF;

      cap_g_refused:
        // Shared refusal funnel: bump stats.refused, preserving the
        // sentinel across the call (bumper clobbers rax as scratch).
        push rax;
        call capture_stats_bump_refused;
        pop rax;

      cap_g_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11 -- capture_revoke(capture_id) -> 0 | error
  // ==========================================================================
  //
  // Bumps generation (so a stale handle to the same slot is invalidated)
  // and clears the in_use marker byte.  Row payload is left intact so a
  // chaos-restart witness reading the tombstone sees the pre-revoke
  // grantee + source + expiry.  No fingerprint emit per issue #2416's
  // contract (only grant emits).
  //
  // Register plan: r12=capture_id (survives the bumper call).  One
  // callee-save push = 8 bytes; entry rsp%16==8 -> (8+8)%16 = 0 for
  // the nested bumper call.

  pub let capture_revoke : (u64) -> u64 !{mem} @{cap} =
    fn (capture_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M7-036 (#2416): revoke KIND_CAPTURE row. capture_id >= CAPTURE_ROW_MAX(16) -> CAPTURE_BAD_SLOT; row not in_use -> CAPTURE_REVOKE_ALREADY; else bump generation + clear in_use byte + stats.revokes++. No fingerprint (per issue #2416's contract; only grant emits). One callee-save push (r12) aligns rsp to 16 for the nested bumper call. Refusal funnel bumps stats.refused. Labels prefixed cap_v_.",
      block: {
        push r12;

        mov r12, rdi;                        // capture_id

        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp r12, r10;
        jae cap_v_bad_slot;

        lea r10, [rip + _captures];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_v_already;

        // Bump generation and clear in_use in one write.
        mov r11, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        add r11, 1;
        and r11, r9;
        mov [r10 + 0], r11;                  // in_use now 0; gen bumped

        call capture_stats_bump_revokes;

        xor rax, rax;                        // CAPTURE_OK
        jmp cap_v_out;

      cap_v_bad_slot:
        mov rax, 0xFFFFE2DC;
        jmp cap_v_refused;
      cap_v_already:
        mov rax, 0xFFFFE2DB;

      cap_v_refused:
        push rax;
        call capture_stats_bump_refused;
        pop rax;

      cap_v_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12 -- capture_check(capture_id, task) -> 1 (allowed) | 0 (denied)
  // ==========================================================================
  //
  // The hot-path gate every screenshot / screencast body reaches through.
  // Returns 1 iff:
  //   (a) capture_id < CAPTURE_ROW_MAX and the row is in_use,
  //   (b) row's granted_to_task == task, and
  //   (c) row's expires_ns == 0 (permanent) OR hpet_now_ns() < expires_ns.
  // Otherwise returns 0.  The 2-arg signature per issue #2416 forces the
  // hpet_now_ns call to live inside the leaf (a caller-supplied third
  // `now_ns` arg would let the leaf stay capability-clean like
  // scanout_expiry_sweep does, but the issue's contract is 2-arg).
  //
  // Emits NO fingerprint (per issue #2416's contract).  A denied check
  // is a normal outcome (a task without a live grant asking for pixels
  // is denied silently); the caller reports it to userspace as a
  // permission error.
  //
  // Both allowed and denied arms bump their respective stats counters
  // so a post-mortem enumerator can distinguish "no checks ever fired"
  // from "checks fired but every one was denied".
  //
  // Register plan: r12=capture_id, r13=task.  Two callee-save pushes
  // + sub rsp,8 = 24 bytes; entry rsp%16==8 -> (8+24)%16 = 0 for the
  // hpet_now_ns / bumper nested calls.

  pub let capture_check : (u64, u64) -> u64 !{mem} @{cap, boot} =
    fn (capture_id: u64) (task: u64) -> unsafe {
      effects: {mem}, capabilities: {cap, boot},
      justification: "R113.M7-036 (#2416): hot-path capture-consent gate. Returns 1 iff (capture_id valid + in_use) AND (granted_to_task == task) AND (expires_ns == 0 OR hpet_now_ns() < expires_ns); 0 otherwise. No fingerprint (per issue #2416 contract; denied check is a normal outcome). Both arms bump their respective stats counters (allowed vs denied) so a post-mortem can tell no-checks from all-denied. Two callee-save pushes (r12=capture_id, r13=task) + sub rsp,8 leave rsp%16==0 for the hpet_now_ns and bumper nested calls. Capabilities {cap, boot}: cap for the substrate check role; boot propagates from hpet_now_ns's own @{boot}. Labels prefixed cap_c_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // capture_id
        mov r13, rsi;                        // task

        // Gate a: capture_id < CAPTURE_ROW_MAX
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp r12, r10;
        jae cap_c_deny;

        // Row base + in_use check
        lea r10, [rip + _captures];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cap_c_deny;

        // Gate b: granted_to_task == task
        mov rax, [r10 + 16];
        cmp rax, r13;
        jne cap_c_deny;

        // Gate c: expires_ns check.  Load expires; 0 means permanent.
        mov r11, [r10 + 40];                 // r11 = expires_ns
        cmp r11, 0;
        je  cap_c_allow;                     // permanent grant

        // hpet_now_ns() < expires_ns?  hpet_now_ns is caller-save-safe
        // for r11 -- SysV preserves r12-r15 but r10/r11 are caller-save,
        // so save r11 across the call.
        push r11;
        sub rsp, 8;                          // realign (odd push)
        call hpet_now_ns;
        add rsp, 8;
        pop r11;                             // restore expires_ns
        // rax = now_ns; compare
        cmp rax, r11;
        jae cap_c_deny;                      // now >= expires -> expired

      cap_c_allow:
        call capture_stats_bump_check_allowed;
        mov rax, 1;
        jmp cap_c_out;

      cap_c_deny:
        call capture_stats_bump_check_denied;
        xor rax, rax;

      cap_c_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }
}
