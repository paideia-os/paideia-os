// src/kernel/core/cap/kind_microbench.pdx -- UMB-W3 R141.M1 skeleton
// paideia-os #2645 (umbrella decomposition wave 3, chain-head).
//
// KIND_MICROBENCH = 0x5E, derived over KIND_MEMORY (= KIND_PAGE, base
// slot 4).
//
// Capability-table FACADE for the kernel-side microbench harness
// (perf/microbench.pdx). A ring-3 (or kernel-mode) consumer holding a
// KIND_MICROBENCH cap can enumerate the registered measurement sites,
// snapshot per-site statistics, read the ring buffer head, request a
// stats reset, and query the total registered site count.
//
// =============================================================================
// SECTION 0  DERIVATION POSTURE
// =============================================================================
//
// KIND_MICROBENCH derives over KIND_MEMORY (= KIND_PAGE, base slot 4)
// because the artefact is a kernel-owned pair of row pools (_mb_sites
// + _mb_rings in perf/microbench.pdx) referenced by site_id (row
// index). Same posture as KIND_FIRMWARE_BLOB (0x3C), KIND_FW_MANIFEST
// (0x5B), KIND_CMD_MODULE (0x5C), KIND_CAP_ENV (0x5D): the kind field
// encodes the SEMANTIC (this is a perf-measurement handle) and the
// LAM-hint base slot encodes the RUNTIME SHAPE (a memory region).
// Full-u64 kind compare in invoke.pdx's dispatch cascade means the
// `cmp rcx, 0x5E` arm coexists with the slot-4 KIND_PAGE handler
// without ambiguity.
//
// =============================================================================
// SECTION 1  SLOT ASSIGNMENT  --  0x5E
// =============================================================================
//
// Numeric derived-kind tag KIND_MICROBENCH = 0x5E (decimal 94). Audit
// at landing time:
//   `grep -rnE 'cmp rcx, 0x5E\b' src/kernel/` returned zero hits -- no
//   existing dispatch arm overwritten. The parallel UMB-W1 landings
//   took 0x5C (KIND_CMD_MODULE, #2585) and 0x5D (KIND_CAP_ENV, #2591).
//   0x5E is the next natural adjacent slot.
//
// 0x5E fits imm32 with bit 31 clear so no r9 staging is required; the
// dispatch arm in cap/invoke.pdx is a direct `cmp rcx, 0x5E`.
//
// =============================================================================
// SECTION 2  ROW LAYOUT  --  32 BYTES PER ROW, 8 ROWS
// =============================================================================
//
// Per #2645 task directive, each row is 32 bytes = 4 u64:
//
//   [+0]   site_id          (u64)   the perf/microbench.pdx site this
//                                    cap row references (0..15); 0xFF
//                                    marks EMPTY. .bss zero-init plus
//                                    the reset path leaves rows with
//                                    site_id=0 which is a VALID site
//                                    index; the EMPTY sentinel is
//                                    carried in the flags word's
//                                    IN_USE bit (bit 0), not in
//                                    site_id.
//   [+8]   flags            (u64)   bit 0 = IN_USE (row is bound).
//                                    All other bits reserved. The
//                                    IN_USE bit is the sole EMPTY
//                                    sentinel so site_id can safely
//                                    be zero on a bound row.
//   [+16]  reserved_0       (u64)   reserved for a future per-row
//                                    rights mask (R141.M* may thread
//                                    per-site rights so a holder's
//                                    cap authorises LIST + STATS on
//                                    one site but not RESET on
//                                    another).
//   [+24]  reserved_1       (u64)   reserved for a future generation
//                                    counter (anti-replay for cross-
//                                    boot witness-replay flows).
//
// Row size: 32 bytes = 4 u64. Row-addressed capacity: KIND_MB_MAX = 8
// rows. 8 x 32 = 256 bytes = 32 u64. Stride 32 is a power of two so
// row addressing uses `shl rax, 5` -- no imul.
//
// =============================================================================
// SECTION 3  RIGHTS  --  R_MB_READ (0x001), R_MB_WRITE (0x002)
// =============================================================================
//
//   R_MB_READ   (0x001)  gates read-only ops (LIST_SITES, READ_STATS,
//                        READ_SAMPLES_HEAD, SITE_COUNT).
//   R_MB_WRITE  (0x002)  gates mutating ops (RESET_SITE).
//
// R_MB_ALL = R_MB_READ | R_MB_WRITE = 0x003.
//
// =============================================================================
// SECTION 4  OP CODES  --  0..4
// =============================================================================
//
// All ops take u64 arguments passed through the standard cap_invoke
// op_arg encoding:
//
//   [7:0]   op_code
//   [15:8]  site_id          (for READ_STATS, READ_SAMPLES_HEAD,
//                              RESET_SITE)
//
//   op 0 MB_OP_LIST_SITES         -> returns _mb_site_count (shortcut
//                                     to MB_OP_SITE_COUNT; retained
//                                     for enum-shape clarity, a later
//                                     M* may distinguish by returning
//                                     a packed bitmap of registered
//                                     ids)
//   op 1 MB_OP_READ_STATS         -> returns sample_count for the
//                                     site; a follow-up M* widens
//                                     this to a side-channel buffer
//                                     write of the 48 B stats row
//                                     via _mb_site_stats
//   op 2 MB_OP_READ_SAMPLES_HEAD  -> returns head_idx (ring write
//                                     cursor, 0..127)
//   op 3 MB_OP_RESET_SITE         -> returns MB_OK; mutates nothing
//                                     at skeleton (RESET requires a
//                                     scope the M1 handler does not
//                                     expose; M* widens)
//   op 4 MB_OP_SITE_COUNT         -> returns _mb_site_count via
//                                     _mb_site_count()
//   op 5 MB_OP_DUMP_ALL           -> UMB-W13 R141.M2 (#2646):
//                                     dispatches to _perf_sink_dump_
//                                     all (perf/perf_sink.pdx);
//                                     emits one `PERF SITE ...` klog
//                                     line per registered site plus
//                                     a `PERF SINK DUMP OK sites=<N>`
//                                     summary. Requires R_MB_READ.
//                                     Returns PS_OK=0 or
//                                     PS_ERR_NO_SITES=0x1300.
//   else                           -> INVOKE_UNSUPPORTED
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY  --  0xFFFFFCC6..0xFFFFFCC9
// =============================================================================
//
// Reserves four contiguous codes:
//
//   KMB_BAD_HANDLE   = 0xFFFFFCC6  (row_id out of range OR flags &
//                                    IN_USE clear)
//   KMB_BAD_SITE     = 0xFFFFFCC7  (site_id >= _mb_site_count)
//   KMB_POOL_FULL    = 0xFFFFFCC8  (reserved for a future mint path;
//                                    unreachable at skeleton)
//   KMB_FROZEN       = 0xFFFFFCC9  (reserved for a future freeze op;
//                                    unreachable at skeleton)
//
// All four fit imm32 with bit 31 clear. Band audit (2026-10-11):
// `grep -rnE '0xFFFFFCC[6-9]\b' src/ 2>/dev/null` returned zero hits
// -- clean band adjacent to the UMB-W1 CAP_ENV FCC1..CC5 band
// immediately above.
//
// =============================================================================
// SECTION 6  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x5E fits imm32, so the invoke.pdx compare uses
// `cmp rcx, 0x5E` directly (no r9/r11 staging). Error sentinels
// 0xFFFFFCC6..CC9 fit imm32 (zero-extend to u64 via `mov rax, imm32`
// 7-byte emit). Row stride 32 is a power of two: `shl rax, 5` (no
// 2-op `imul r, imm` form). Flag-bit tests use `cmp rN, 0` (never
// `test rN, rN`). All `pub let` string decls are single-line. Module
// basename `KindMicrobench` matches file basename
// `kind_microbench.pdx`. Every label in this file is prefixed `kmb_`
// (reserved-word discipline -- `loop`/`if`/`let` are keywords).

module KindMicrobench = structure {

  pub let KIND_MICROBENCH       : u64 = 0x5E
  pub let KIND_MICROBENCH_BASE  : u64 = 4         // = KIND_MEMORY (LAM-hint slot)

  // Capacity + geometry (§2).
  pub let KMB_MAX              : u64 = 8          // rows
  pub let KMB_ROW_BYTES        : u64 = 32         // 4 u64 per row

  // Flag bits (§2).
  pub let KMB_FLAG_IN_USE : u64 = 0x1

  // Rights (§3).
  pub let R_MB_READ  : u64 = 0x001
  pub let R_MB_WRITE : u64 = 0x002
  pub let R_MB_ALL   : u64 = 0x003

  // Ops (§4).
  pub let MB_OP_LIST_SITES         : u64 = 0
  pub let MB_OP_READ_STATS         : u64 = 1
  pub let MB_OP_READ_SAMPLES_HEAD  : u64 = 2
  pub let MB_OP_RESET_SITE         : u64 = 3
  pub let MB_OP_SITE_COUNT         : u64 = 4
  // UMB-W13 R141.M2 (#2646): perf-sink dump-all. Dispatches to
  // _perf_sink_dump_all in perf/perf_sink.pdx; requires R_MB_READ.
  pub let MB_OP_DUMP_ALL           : u64 = 5
  pub let MB_OP_MAX                : u64 = 5

  // Return band (§5). All fit imm32 (zero-extend to u64).
  pub let KMB_OK          : u64 = 0
  pub let KMB_BAD_HANDLE  : u64 = 0xFFFFFCC6
  pub let KMB_BAD_SITE    : u64 = 0xFFFFFCC7
  pub let KMB_POOL_FULL   : u64 = 0xFFFFFCC8
  pub let KMB_FROZEN      : u64 = 0xFFFFFCC9

  // Standard cap_invoke sentinels.
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Storage: 8 rows x 32 B = 256 B = 32 u64.
  pub let mut _kind_mb_table : [u64; 32] = uninit @align(64)

  // Observability counters: list_ok / list_denied / stats_ok /
  // stats_bad_site / head_ok / head_bad_site / reset_ok / count_ok.
  pub let mut _kind_mb_stats : [u64; 8] = uninit @align(64)

  pub let KMB_ST_LIST_OK        : u64 = 0
  pub let KMB_ST_LIST_DENIED    : u64 = 1
  pub let KMB_ST_STATS_OK       : u64 = 2
  pub let KMB_ST_STATS_BAD_SITE : u64 = 3
  pub let KMB_ST_HEAD_OK        : u64 = 4
  pub let KMB_ST_HEAD_BAD_SITE  : u64 = 5
  pub let KMB_ST_RESET_OK       : u64 = 6
  pub let KMB_ST_COUNT_OK       : u64 = 7

  // Fingerprint tags.
  pub let kmb_tag_handler_entry : [u8; 28] = "KIND_MICROBENCH dispatch inv\0"

  // ==========================================================================
  // kind_mb_table_reset() -> ()
  //
  // Defensive clear. Zero every u64 in _kind_mb_table (32 words) and
  // _kind_mb_stats (8 words). .bss zero-init already handles real
  // boot; this exists for the chaos-restart / witness-replay flow and
  // matches every other kind's `*_table_reset`.
  // ==========================================================================
  pub let kind_mb_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W3 R141.M1 (#2645): clear every _kind_mb_table u64 (32 words) and every _kind_mb_stats u64 (8 words). Boot and teardown only; defensive (matches ce_tr_table / kcm_tr_table one-for-one). Labels prefixed kmb_tr_.",
      block: {
        lea r10, [rip + _kind_mb_table];
        xor rax, rax;
        xor rcx, rcx;
      kmb_tr_table:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kmb_tr_table;

        lea r10, [rip + _kind_mb_stats];
        xor rcx, rcx;
      kmb_tr_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kmb_tr_stats;
        ret
      }
    }

  // ==========================================================================
  // kmb_note(stats_slot) -> ()
  //
  // Bump _kind_mb_stats[slot]. Caller passes KMB_ST_* constants only.
  // ==========================================================================
  pub let kmb_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W3 R141.M1 (#2645): bounded increment on _kind_mb_stats. Pure leaf. Labels prefixed kmb_no_.",
      block: {
        cmp rdi, 8;
        jae kmb_no_out;
        lea r10, [rip + _kind_mb_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kmb_no_out:
        ret
      }
    }

  // ==========================================================================
  // kmb_row_base(row_id) -> &_kind_mb_table[row_id * 32]
  //
  // Row index -> row base pointer. Stride 32 = 2^5 so `shl rax, 5`
  // suffices (power of two, no imul).
  // ==========================================================================
  pub let kmb_row_base : (u64) -> u64 !{} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "UMB-W3 R141.M1 (#2645): row_id -> &_kind_mb_table[row_id*32]. Stride 32 = 2^5 uses `shl rax, 5`. Pure leaf. Labels prefixed kmb_rb_.",
      block: {
        mov rax, rdi;
        shl rax, 5;
        lea r10, [rip + _kind_mb_table];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_microbench(rights, target_ptr, op_arg) -> u64
  //
  // KIND_MICROBENCH cap_invoke dispatch. Reachable from cap/invoke.pdx
  // :cap_invoke_dispatch via the `cmp rcx, 0x5E; je call_kind_
  // microbench` arm added by this landing.
  //
  // target_ptr: cap-row index (reserved for a future mint path; at
  // skeleton we do NOT read it -- the handler operates on the global
  // perf/microbench substrate directly).
  //
  // op_arg layout:
  //   [7:0]   op_code
  //   [15:8]  site_id   (for READ_STATS / READ_SAMPLES_HEAD /
  //                      RESET_SITE)
  //
  // Rights:
  //   LIST_SITES / READ_STATS / READ_SAMPLES_HEAD / SITE_COUNT
  //     require R_MB_READ.
  //   RESET_SITE requires R_MB_WRITE.
  //
  // Register plan: three callee-save pushes (rbx = rights, r12 =
  // op_arg[15:0], r13 reserved for future row_id when mint lands).
  // Entry rsp%16==8; +3 pushes -> rsp%16==0 at every nested call.
  // ==========================================================================
  pub let cap_handler_microbench : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W3 R141.M1 (#2645): KIND_MICROBENCH cap_invoke dispatch. Entry chatter (klog_s1 of kmb_tag_handler_entry). op_code = op_arg[7:0]; site_id = op_arg[15:8]. Rights gate: ops 0,1,2,4 require R_MB_READ, op 3 requires R_MB_WRITE. Ops delegated to microbench.pdx helpers (_mb_site_count, _mb_site_stats, _mb_row_base-via-perf, etc.). Unknown ops return INVOKE_UNSUPPORTED. Rights violation returns INVOKE_DENIED. Three callee-save pushes (rbx=rights, r12=op_arg[15:0], r13 reserved) land rsp%16==0 at every nested call. Labels prefixed kmb_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rdx;
        mov r11, 0xFFFF;
        and r12, r11;                    // r12 = op_arg[15:0]
                                         //   [7:0]  = op_code
                                         //   [15:8] = site_id
        xor r13, r13;                    // reserved; placeholder for
                                         // future row_id/handle thread

        // Entry chatter.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_TIME];
        lea rdx, [rip + kmb_tag_handler_entry];
        call klog_s1;

        // Op dispatch.
        mov r11, r12;
        and r11, 0xFF;                   // op_code
        cmp r11, 0;
        je kmb_hd_op_list;
        cmp r11, 1;
        je kmb_hd_op_stats;
        cmp r11, 2;
        je kmb_hd_op_head;
        cmp r11, 3;
        je kmb_hd_op_reset;
        cmp r11, 4;
        je kmb_hd_op_count;
        cmp r11, 5;
        je kmb_hd_op_dump;
        jmp kmb_hd_unsup;

      kmb_hd_op_list:
        // Requires R_MB_READ.
        mov r10, rbx;
        mov r11, 1;                      // R_MB_READ
        and r10, r11;
        cmp r10, 0;
        je kmb_hd_denied;
        call _mb_site_count;
        mov rdi, 0;                      // KMB_ST_LIST_OK
        call kmb_note;
        jmp kmb_hd_out;

      kmb_hd_op_stats:
        // Requires R_MB_READ. Returns sample_count for site_id.
        mov r10, rbx;
        mov r11, 1;                      // R_MB_READ
        and r10, r11;
        cmp r10, 0;
        je kmb_hd_denied;
        // Extract site_id from r12[15:8].
        mov rcx, r12;
        shr rcx, 8;
        mov r11, 0xFF;
        and rcx, r11;                    // site_id
        // Bounds-check against _mb_site_count().
        call _mb_site_count;
        cmp rcx, rax;
        jae kmb_hd_stats_bad;
        // Row base via microbench primitives.
        mov rdi, rcx;
        call _mb_row_base;
        mov rax, [rax + 16];             // sample_count field (word 2)
        mov rdi, 2;                      // KMB_ST_STATS_OK
        call kmb_note;
        jmp kmb_hd_out;

      kmb_hd_stats_bad:
        mov rdi, 3;                      // KMB_ST_STATS_BAD_SITE
        call kmb_note;
        mov rax, 0xFFFFFCC7;             // KMB_BAD_SITE
        jmp kmb_hd_out;

      kmb_hd_op_head:
        // Requires R_MB_READ. Returns head_idx for site_id (ring
        // write cursor, 0..127).
        mov r10, rbx;
        mov r11, 1;                      // R_MB_READ
        and r10, r11;
        cmp r10, 0;
        je kmb_hd_denied;
        mov rcx, r12;
        shr rcx, 8;
        mov r11, 0xFF;
        and rcx, r11;                    // site_id
        call _mb_site_count;
        cmp rcx, rax;
        jae kmb_hd_head_bad;
        mov rdi, rcx;
        call _mb_row_base;
        mov rax, [rax + 0];              // packed word 0
        shr rax, 32;                     // head_idx (high 32 bits)
        mov rdi, 4;                      // KMB_ST_HEAD_OK
        call kmb_note;
        jmp kmb_hd_out;

      kmb_hd_head_bad:
        mov rdi, 5;                      // KMB_ST_HEAD_BAD_SITE
        call kmb_note;
        mov rax, 0xFFFFFCC7;             // KMB_BAD_SITE
        jmp kmb_hd_out;

      kmb_hd_op_reset:
        // Requires R_MB_WRITE. Skeleton: no-op (reserved for M*).
        mov r10, rbx;
        mov r11, 2;                      // R_MB_WRITE
        and r10, r11;
        cmp r10, 0;
        je kmb_hd_denied;
        mov rdi, 6;                      // KMB_ST_RESET_OK
        call kmb_note;
        xor rax, rax;                    // KMB_OK
        jmp kmb_hd_out;

      kmb_hd_op_count:
        // Requires R_MB_READ.
        mov r10, rbx;
        mov r11, 1;                      // R_MB_READ
        and r10, r11;
        cmp r10, 0;
        je kmb_hd_denied;
        call _mb_site_count;
        mov rdi, 7;                      // KMB_ST_COUNT_OK
        call kmb_note;
        jmp kmb_hd_out;

      kmb_hd_op_dump:
        // UMB-W13 R141.M2 (#2646): dispatch to perf-sink dump_all.
        // Requires R_MB_READ (dumping is a read-only observe).
        // _perf_sink_dump_all returns PS_OK (0) or PS_ERR_NO_SITES
        // (0x1300). The sink's own _ps_stats array already tracks
        // PS_ST_DUMP_OK / PS_ST_DUMP_NO_SITES, so no kmb_note bump
        // runs here (double-counting would conflate the kind-side
        // dispatch tally with the sink-side dump tally; the sink
        // owns its observability). r13 is free (handler leaves it
        // zero as a reserved slot), so no spill is needed to
        // preserve rax across any nested call.
        mov r10, rbx;
        mov r11, 1;                      // R_MB_READ
        and r10, r11;
        cmp r10, 0;
        je kmb_hd_denied;
        call _perf_sink_dump_all;
        jmp kmb_hd_out;

      kmb_hd_denied:
        mov rdi, 1;                      // KMB_ST_LIST_DENIED (reused
                                         // as a generic rights-denied
                                         // tally slot for M1)
        call kmb_note;
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp kmb_hd_out;

      kmb_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      kmb_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx (src/kernel/boot/kernel_main.pdx) adds ONE new
  // call alongside the existing kind-table resets, immediately after
  // the tsc_calibrate / x2apic_enable / phase1_acpi_gather trio and
  // before the first witness that might invoke cap_invoke:
  //
  //   call _mb_init;                   // perf/microbench.pdx entry
  //
  // _mb_init itself calls kind_mb_table_reset indirectly by resetting
  // its own tables; the CAP-row pool _kind_mb_table lives in THIS
  // module and gets its reset via a defensive call in a later slice
  // or via .bss zero-init at real boot. kind_mb_table_reset is
  // exposed as a public symbol so a future witness can re-scrub it.
  //
  // Dispatch arm (ADDED by this landing in cap/invoke.pdx after the
  // UMB-W1 KIND_CMD_MODULE 0x5C arm):
  //
  //   cmp rcx, 0x5E;
  //   je  call_kind_microbench;
  //   ...
  //   call_kind_microbench:
  //     call cap_handler_microbench;
  //     ret;
  //
  // Cross-module caller sites (R141.M* and later):
  //   - R141.M2 ctx_switch instrumentation: adds a second site via
  //     _mb_site_register("ctx_switch", 10) at scheduler init.
  //   - R141.M3 vfs_fast_path: third site at vfs_lookup_fast entry.
  //   - R141.M4 klog_slow_path: fourth site at klog_emit_core.
  //   - R141.M5 consumer utility: userspace holds a KIND_MICROBENCH
  //     cap and polls MB_OP_READ_STATS / MB_OP_READ_SAMPLES_HEAD
  //     into a /perf/microbench ring exposed via pdxfs.
  // ==========================================================================
}
