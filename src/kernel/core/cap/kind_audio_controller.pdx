  // ==========================================================================
  // audio_ctrl_find_by_key(hda_key) -> row_id | AUDIO_CTRL_ROW_NONE
  // ==========================================================================

  pub let audio_ctrl_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (hda_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-005 (#1141): the live row holding this device key, or AUDIO_CTRL_ROW_NONE (0xFF). Linear scan over 2 rows. THE UNIQUENESS TEST §2's second gate needs: two live audio-controller capabilities over one controller means two drivers writing one BAR window. Refuses to match a hda_key of 0 at all, so a fabricated parent cannot collide with, or be found by, the sentinel audio_ctrl_parent_key returns for a bad slot. Sentinel is 0xFF because row 0 is a legitimate answer. Leaf. Labels prefixed ac_fk_.",
      block: {
        cmp rdi, 0;
        je  ac_fk_none;
        xor rcx, rcx;
      ac_fk_scan:
        cmp rcx, 2;                      // AUDIO_CTRL_MAX
        jae ac_fk_none;
        lea r10, [rip + _audio_controller_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ac_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  ac_fk_hit;
      ac_fk_next:
        add rcx, 1;
        jmp ac_fk_scan;
      ac_fk_hit:
        mov rax, rcx;
        ret;
      ac_fk_none:
        mov rax, 0xFF;                   // AUDIO_CTRL_ROW_NONE
        ret
      }
    } @no_frame

  // ==========================================================================
  // audio_ctrl_row_of_slot(slot) -> row_id | AUDIO_CTRL_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let audio_ctrl_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): slot -> row_id, gated on the descriptor being a live KIND_AUDIO_CONTROLLER. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO AN AUDIO CONTROLLER ROW, and ARITY ONE. Returns AUDIO_CTRL_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Pure read. Labels prefixed ac_ros_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae ac_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x15e;                  // KIND_AUDIO_CONTROLLER
        cmp r10, r11;
        jne ac_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call audio_ctrl_tail_valid;
        cmp rax, 0;
        je  ac_ros_none;

        mov rax, r12;
        jmp ac_ros_out;

      ac_ros_none:
        mov rax, 0xFF;                   // AUDIO_CTRL_ROW_NONE
      ac_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Slot-arity-one resolvers. ARITY ONE, pinned by tools/build.sh.
  // ==========================================================================

  pub let audio_ctrl_bar_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): bar_handle of the controller this capability names. ARITY ONE, PINNED BY tools/build.sh. A second parameter -- any second parameter -- is how a caller-supplied BAR handle would reach the row. Labels prefixed ac_bos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call audio_ctrl_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  ac_bos_bad;
        mov rdi, r12;
        call audio_ctrl_row_bar;
        jmp ac_bos_out;
      ac_bos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ac_bos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let audio_ctrl_codecs_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): codec_count of the controller this capability names. ARITY ONE. Labels prefixed ac_cos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call audio_ctrl_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  ac_cos_bad;
        mov rdi, r12;
        call audio_ctrl_row_codecs;
        jmp ac_cos_out;
      ac_cos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ac_cos_out:
