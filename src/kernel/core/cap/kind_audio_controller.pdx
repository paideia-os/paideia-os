  // ==========================================================================
  // audio_ctrl_report_install(slot, new_codec_count) -> AUDIO_CTRL_OK | ...
  //
  // §3. THE ONE PUSH-STATE PRIMITIVE. ONE VALUE, PLAUSIBILITY AGAINST
  //     [0, CODEC_MAX].
  // ==========================================================================

  pub let audio_ctrl_report_install : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (new_codec_count: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): install one codec-count report of the controller this capability names. TWO ARGUMENTS AND NO MORE: a capability, and the one value §1's row layout has a dynamic field for. A third argument would be a caller-supplied bar_handle or ring shape reaching the row, and both are set-once at mint by §1. Gates, in order: (1) the slot must name a live KIND_AUDIO_CONTROLLER -> AUDIO_CTRL_BAD_SLOT via audio_ctrl_row_of_slot. (2) new_codec_count > AUDIO_CTRL_CODEC_MAX -> IMPLAUSIBLE_COUNT, counted, AND NOTHING IN THE ROW IS TOUCHED. NOT CLAMPED: a count above 15 is refused and 15 is not silently substituted for it, because clamping would bless the garbage and hide the discovery bug. (3) install: write codec_count; increment reports in place and AUDIO_CTRL_ST_REPORTS overall. NOTHING DRIVES A CONTROLLER: this is §4's design decision. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed ac_ri_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // new_codec_count

        call audio_ctrl_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;                   // AUDIO_CTRL_ROW_NONE
        je  ac_ri_bad_slot;

        // Bounds test.
        mov r10, 15;                     // AUDIO_CTRL_CODEC_MAX
        cmp r12, r10;
        ja  ac_ri_impl_count;

        // Install.
        lea r10, [rip + _audio_controller_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov [r10 + 24], r12;             // codec_count

        mov rax, [r10 + 48];             // reports
        add rax, 1;
        mov [r10 + 48], rax;

        // Global counter.
        mov rdi, 1;                      // AUDIO_CTRL_ST_REPORTS
        call audio_ctrl_note;

        xor rax, rax;                    // AUDIO_CTRL_OK
        jmp ac_ri_out;

      ac_ri_bad_slot:
        mov rax, 0xFFFFFEB5;
        jmp ac_ri_out;
      ac_ri_impl_count:
        mov rdi, 2;                      // AUDIO_CTRL_ST_IMPL_COUNT
        call audio_ctrl_note;
        mov rax, 0xFFFFFEB2;             // AUDIO_CTRL_IMPLAUSIBLE_COUNT

      ac_ri_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // audio_ctrl_cap_mint_inner(slot, parent_slot, rights, bar_handle,
  //                            corb_size, rirb_size)
  //   -> AUDIO_CTRL_OK | AUDIO_CTRL_MINT_*
  //
  // Six arguments, fits SysV six-register limit.
  // ==========================================================================

  pub let audio_ctrl_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (bar_handle: u64) (corb_size: u64) (rirb_size: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): mint a KIND_AUDIO_CONTROLLER over a KIND_DEVICE. Gates, in order: (1) slot < 256 -> AUDIO_CTRL_BAD_SLOT. (2) audio_ctrl_check_parent_device -> AUDIO_CTRL_MINT_BAD_PARENT (the half that discriminates NOTHING, §2). (3) audio_ctrl_rights_valid -> AUDIO_CTRL_MINT_BAD_RIGHTS. (4) audio_ctrl_corb_size_valid -> AUDIO_CTRL_MINT_BAD_CORB. (5) audio_ctrl_rirb_size_valid -> AUDIO_CTRL_MINT_BAD_RIRB. (6) INHERIT the identity: audio_ctrl_parent_key(parent_slot); 0 -> AUDIO_CTRL_MINT_NO_DEVICE. (7) UNIQUENESS: audio_ctrl_find_by_key must answer AUDIO_CTRL_ROW_NONE -> AUDIO_CTRL_MINT_AC_IN_USE. Two capabilities over one controller means two drivers writing one BAR window. (8) hdr_pack(parent_slot) then tail_alloc -> AUDIO_CTRL_MINT_ENOSPC on exhaustion. (9) cap_mint_write(slot, KIND_AUDIO_CONTROLLER, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed ac_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // bar_handle
        mov r15, r8;                     // corb_size
        mov rbp, r9;                     // rirb_size

        mov r10, 256;
        cmp rbx, r10;
        jae ac_mi_bad_slot;

        mov rdi, r12;
        call audio_ctrl_check_parent_device;
        cmp rax, 0;
        je  ac_mi_bad_parent;

        mov rdi, r13;
        call audio_ctrl_rights_valid;
        cmp rax, 0;
        je  ac_mi_bad_rights;

        mov rdi, r15;
        call audio_ctrl_corb_size_valid;
        cmp rax, 0;
        je  ac_mi_bad_corb;

        mov rdi, rbp;
        call audio_ctrl_rirb_size_valid;
        cmp rax, 0;
        je  ac_mi_bad_rirb;

        mov rdi, r12;
        call audio_ctrl_parent_key;
        cmp rax, 0;
        je  ac_mi_no_device;

        // Stash the key.
        mov r10, rax;
        push r10;
        sub rsp, 8;                      // keep rsp%16 == 0
        mov rdi, r10;
        call audio_ctrl_find_by_key;
        add rsp, 8;
        pop r10;                         // r10 = hda_key
        cmp rax, 0xFF;                   // AUDIO_CTRL_ROW_NONE
        jne ac_mi_in_use_note;

        // hdr_pack + tail_alloc.
        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call audio_ctrl_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ac_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // hda_key
        mov rdx, r14;                    // bar_handle
        mov rcx, r15;                    // corb_size
        mov r8,  rbp;                    // rirb_size
        call audio_ctrl_tail_alloc;

        mov r10, 0xFFFFFEBF;             // AUDIO_CTRL_TAIL_ENOSPC
        cmp rax, r10;
        je  ac_mi_enospc;
        mov r10, 0xFFFFFEBE;             // AUDIO_CTRL_TAIL_BAD_ARG
        cmp rax, r10;
        je  ac_mi_bad_corb;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x15e;                  // KIND_AUDIO_CONTROLLER
        mov rdx, r13;                    // rights
        mov rcx, r14;
        call cap_mint_write;

        // Count the mint.
        mov rdi, 0;                      // AUDIO_CTRL_ST_MINTS
        call audio_ctrl_note;

        xor rax, rax;                    // AUDIO_CTRL_OK
        jmp ac_mi_out;

      ac_mi_in_use_note:
        mov rdi, 3;                      // AUDIO_CTRL_ST_IN_USE
        call audio_ctrl_note;
        mov rax, 0xFFFFFEB6;             // AUDIO_CTRL_MINT_AC_IN_USE
        jmp ac_mi_out;

      ac_mi_bad_slot:
        mov rax, 0xFFFFFEB5;
        jmp ac_mi_out;
      ac_mi_bad_parent:
        mov rax, 0xFFFFFEBD;
        jmp ac_mi_out;
      ac_mi_bad_rights:
        mov rax, 0xFFFFFEBC;
        jmp ac_mi_out;
      ac_mi_bad_corb:
        mov rax, 0xFFFFFEBB;
        jmp ac_mi_out;
      ac_mi_bad_rirb:
        mov rax, 0xFFFFFEBA;
        jmp ac_mi_out;
      ac_mi_no_device:
        mov rax, 0xFFFFFEB8;
        jmp ac_mi_out;
      ac_mi_enospc:
        mov rdi, 4;                      // AUDIO_CTRL_ST_ENOSPC
        call audio_ctrl_note;
        mov rax, 0xFFFFFEB7;

      ac_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_ctrl_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (bar_handle: u64) (corb_size: u64) (rirb_size: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): audited mint. Same shape as backlight_cap_mint. Putting emission in the wrapper means a second mint path cannot exist without being audited. Four pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call audio_ctrl_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x15e;                  // KIND_AUDIO_CONTROLLER
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // audio_ctrl_cap_revoke_inner(slot) -> AUDIO_CTRL_OK | ...
  // ==========================================================================

  pub let audio_ctrl_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): revoke a KIND_AUDIO_CONTROLLER. (1) slot < 256 -> AUDIO_CTRL_BAD_SLOT. (2) kind == 0 -> AUDIO_CTRL_REVOKE_ALREADY, idempotent and distinct so a caller can tell 'nothing to do' from 'done'. (3) kind != 0x15e -> AUDIO_CTRL_WRONG_KIND, which is what stops an audio-controller revoke from freeing another kind's row through a coincidentally-shaped target_ptr and is what makes it safe for the owner-column sweep to call this blindly. (4) row_id from target_ptr[15:0]; if live, audio_ctrl_tail_free scrubs it. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0). NOTHING DRIVES A CONTROLLER. Revoking authority over a bus master leaves the hardware exactly as it was; that is deliberate. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed ac_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae ac_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  ac_rvk_already;

        mov r11, 0x15e;                  // KIND_AUDIO_CONTROLLER
        cmp r10, r11;
        jne ac_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call audio_ctrl_tail_valid;
        cmp rax, 0;
        je  ac_rvk_clear;

        mov rdi, r13;
        call audio_ctrl_tail_free;

      ac_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 5;                      // AUDIO_CTRL_ST_REVOKES
        call audio_ctrl_note;

        xor rax, rax;                    // AUDIO_CTRL_OK
        jmp ac_rvk_out;

      ac_rvk_bad_slot:
        mov rax, 0xFFFFFEB5;
        jmp ac_rvk_out;
      ac_rvk_wrong_kind:
        mov rax, 0xFFFFFEB4;
        jmp ac_rvk_out;
      ac_rvk_already:
        mov rax, 0xFFFFFEB3;

      ac_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_ctrl_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS, so a process death leaves the same audit trail a deliberate teardown would. NO cascade: nothing in this tree derives from an audio-controller capability. Three pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call audio_ctrl_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x15e;                  // KIND_AUDIO_CONTROLLER
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // audio_ctrl_debug_print(row_id) -> AUDIO_CTRL_OK | AUDIO_CTRL_TAIL_BAD_ARG
  // ==========================================================================

  pub let audio_ctrl_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R33.M1-005 (#1141): canonical printer for one audio controller row. Refuses a dead or out-of-range row with AUDIO_CTRL_TAIL_BAD_ARG rather than printing zeroes. Six KV lines. r12 holds row_id across the calls; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed ac_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call audio_ctrl_tail_valid;
        cmp rax, 0;
        je  ac_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ac_dbg_msg];
        lea rcx, [rip + ac_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call audio_ctrl_row_key;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ac_dbg_msg];
        lea rcx, [rip + ac_k_key];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call audio_ctrl_row_bar;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ac_dbg_msg];
        lea rcx, [rip + ac_k_bar];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call audio_ctrl_row_codecs;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ac_dbg_msg];
        lea rcx, [rip + ac_k_cdc];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call audio_ctrl_row_corbsz;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ac_dbg_msg];
        lea rcx, [rip + ac_k_cbs];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call audio_ctrl_row_rirbsz;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ac_dbg_msg];
        lea rcx, [rip + ac_k_rbs];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // AUDIO_CTRL_OK
        jmp ac_dp_out;

      ac_dp_bad:
        mov rax, 0xFFFFFEBE;             // AUDIO_CTRL_TAIL_BAD_ARG

      ac_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_audio_ctrl(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_audio_ctrl : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): KIND_AUDIO_CONTROLLER dispatch handler. Emits cap_audio_ctrl_msg on entry. row_id = target_ptr[15:0] and slot = target_ptr[31:16], both from the DESCRIPTOR (which only cap_mint_write writes); op = op_arg[7:0]. RIGHTS PER OP: QUERY_KEY / QUERY_BAR / QUERY_CODECS / QUERY_CORBSZ / QUERY_RIRBSZ / QUERY_REPORTS / QUERY_PARENT require R_AUDIO_CTRL_INVOKE; DEBUG_PRINT requires R_AUDIO_CTRL_OBSERVE; REPORT requires R_AUDIO_CTRL_REPORT. OPS 0..7 TAKE NO OPERAND: op_arg[63:8] refused with AUDIO_CTRL_TAIL_BAD_ARG rather than masked. OP 8 (REPORT) takes one operand field packed per §REPORT (new_codec_count [11:8], reserved [63:12] MUST be zero). Unknown op -> INVOKE_UNSUPPORTED; rights failure -> INVOKE_DENIED. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed ac_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot   = target_ptr[31:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_audio_ctrl_msg];
        call klog_s1;

        // Decode op.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov rbp, r10;                    // rbp = op

        cmp rbp, 8;                      // AUDIO_CTRL_OP_MAX
        ja  ac_hn_unsup;

        cmp rbp, 8;                      // REPORT
        je  ac_hn_report_gate;

        cmp rbp, 7;                      // DEBUG_PRINT
        je  ac_hn_dbg;

        // Ops 0..6: no operand. Reserved bits [63:8] refused.
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne ac_hn_res;

        // INVOKE gate.
        mov r10, r12;
        and r10, 0x008;                  // R_AUDIO_CTRL_INVOKE
        cmp r10, 0;
        je  ac_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  ac_hn_key;
        cmp rbp, 1;
        je  ac_hn_bar;
        cmp rbp, 2;
        je  ac_hn_cdc;
        cmp rbp, 3;
        je  ac_hn_cbs;
        cmp rbp, 4;
        je  ac_hn_rbs;
        cmp rbp, 5;
        je  ac_hn_rep;
        call audio_ctrl_row_parent;
        jmp ac_hn_out;

      ac_hn_report_gate:
        // Decode new_codec_count [11:8] and reserved [63:12].
        mov r11, r14;
        shr r11, 8;
        mov r10, 0xF;
        and r11, r10;
        mov r15, r11;                    // new_codec_count

        mov r11, r14;
        shr r11, 12;
        cmp r11, 0;
        jne ac_hn_res;

        mov r10, r12;
        and r10, 0x002;                  // R_AUDIO_CTRL_REPORT
        cmp r10, 0;
        je  ac_hn_denied;

        mov rdi, rbx;                    // slot
        mov rsi, r15;                    // new_codec_count
        call audio_ctrl_report_install;
        jmp ac_hn_out;

      ac_hn_key:
        call audio_ctrl_row_key;
        jmp ac_hn_out;
      ac_hn_bar:
        call audio_ctrl_row_bar;
        jmp ac_hn_out;
      ac_hn_cdc:
        call audio_ctrl_row_codecs;
        jmp ac_hn_out;
      ac_hn_cbs:
        call audio_ctrl_row_corbsz;
        jmp ac_hn_out;
      ac_hn_rbs:
        call audio_ctrl_row_rirbsz;
        jmp ac_hn_out;
      ac_hn_rep:
        call audio_ctrl_row_reports;
        jmp ac_hn_out;

      ac_hn_dbg:
        // Ops 0..7 reserved bits check.
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne ac_hn_res;
        mov r10, r12;
        and r10, 0x400;                  // R_AUDIO_CTRL_OBSERVE
        cmp r10, 0;
        je  ac_hn_denied;
        mov rdi, r13;
        call audio_ctrl_debug_print;
        jmp ac_hn_out;

      ac_hn_res:
        mov rax, 0xFFFFFEBE;             // AUDIO_CTRL_TAIL_BAD_ARG
        jmp ac_hn_out;
      ac_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp ac_hn_out;
      ac_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      ac_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
