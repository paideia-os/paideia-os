        pop r13;
        pop r12;
        ret
      }
    }

  pub let audio_ctrl_reports_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M1-005 (#1141): lifetime report count. ARITY ONE. Labels prefixed ac_rps_.",
      block: {
        push r12;
        push r13;
        push r14;
        call audio_ctrl_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  ac_rps_bad;
        mov rdi, r12;
        call audio_ctrl_row_reports;
        jmp ac_rps_out;
      ac_rps_bad:
