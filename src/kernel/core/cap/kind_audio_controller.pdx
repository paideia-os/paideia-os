  pub let audio_ctrl_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-005 (#1141): parent KIND_DEVICE slot recorded at mint, or AUDIO_CTRL_DECODE_BAD. Audit and query only. Labels prefixed ac_rpa_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call audio_ctrl_row_hdr;
        mov r13, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  ac_rpa_bad;
        mov rdi, r13;
        call audio_ctrl_hdr_parent;
        jmp ac_rpa_out;
