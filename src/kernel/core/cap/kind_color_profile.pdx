  // cp_find_by_key(key) -> row_id | CP_ROW_NONE.
  pub let cp_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): linear scan for profile_key.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      cp_fk_scan:
        cmp rbx, 16;
        jae cp_fk_none;
        lea r10, [rip + _color_profile_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cp_fk_step;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne cp_fk_step;
        mov rax, rbx;
        jmp cp_fk_out;
      cp_fk_step:
        add rbx, 1;
        jmp cp_fk_scan;
      cp_fk_none:
        mov rax, 0xFF;
      cp_fk_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // cp_row_of_slot(cap_slot) -> row_id | CP_ROW_NONE.
  pub let cp_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G6.M1-001 (#1509): resolve cap_slot to COLOR_PROFILE row.",
      block: {
        push r12;
        mov r11, 256;
        cmp rdi, r11;
        jae cp_ros_none;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x18F;
        cmp r10, r11;
        jne cp_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call cp_tail_valid;
        cmp rax, 0;
        je  cp_ros_none;
        mov rax, r12;
        jmp cp_ros_out;
      cp_ros_none:
        mov rax, 0xFF;
      cp_ros_out:
        pop r12;
        ret
      }
    }

  pub let cap_handler_color_profile : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G6.M1-001 (#1509): KIND_COLOR_PROFILE dispatch. QUERY ops NO OPERAND.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_color_profile_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne cp_hn_res;

        cmp rbp, 7;
        ja  cp_hn_unsup;

        cmp rbp, 7;
        je  cp_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  cp_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  cp_hn_key;
        cmp rbp, 1;
        je  cp_hn_colour;
        cmp rbp, 2;
        je  cp_hn_trans;
        cmp rbp, 3;
        je  cp_hn_matrix;
        cmp rbp, 4;
        je  cp_hn_prim;
        cmp rbp, 5;
        je  cp_hn_hasicc;
        call cp_row_icc_ref;
        jmp cp_hn_out;

      cp_hn_key:
        call cp_row_key;
        jmp cp_hn_out;
      cp_hn_colour:
        call cp_row_colour;
        jmp cp_hn_out;
      cp_hn_trans:
        call cp_row_transfer;
        jmp cp_hn_out;
      cp_hn_matrix:
        call cp_row_matrix;
        jmp cp_hn_out;
      cp_hn_prim:
        call cp_row_prim;
        jmp cp_hn_out;
      cp_hn_hasicc:
        call cp_row_has_icc;
        jmp cp_hn_out;

      cp_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  cp_hn_denied;
        xor rax, rax;
        jmp cp_hn_out;

      cp_hn_res:
        mov rax, 0xFFFFEE4E;
        jmp cp_hn_out;
      cp_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp cp_hn_out;
      cp_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      cp_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
