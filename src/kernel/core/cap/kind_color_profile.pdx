// src/kernel/core/cap/kind_color_profile.pdx -- G6.M1-001 (#1509)
//
// KIND_COLOR_PROFILE = 0x18F, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// One color-profile capability: the record of ONE colorspace's
// identity -- CICP (colour_primaries, transfer_characteristics,
// matrix_coefficients) triplet per ITU-T H.273 -- plus an optional
// reference to a KIND_MEMORY-backed ICC v4 profile the caller
// parsed. The compositor demands ONE of these on every surface
// commit under G6 (P5 invariant); the reference-display /
// tone-mapping pipelines read the CICP + optional ICC ref through
// this cap.
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// A hosted stack lets a surface commit implicit-sRGB and paints
// wide-gamut / HDR content into an SDR container silently. That
// works until it does not: the compositor now has to guess a
// colorspace for every buffer, and every wrong guess is a shift a
// user can see. paideia lifts colorspace to a CAPABILITY the
// surface commit MUST present (G6 P5): "which colorspace is this
// pixel data" becomes a cap you either hold or do not, not a
// header field the compositor learns to hope for.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The kind half of the gate demands `kind == KIND_MEMORY (4)`
// carrying RIGHT_MINT. The mint additionally requires:
//
//   (a) profile_key non-zero and unique among live rows
//   (b) cicp_colour in [1, CICP_COLOUR_MAX] (ITU-T H.273 §8.1)
//   (c) cicp_transfer in [1, CICP_TRANSFER_MAX] (§8.2)
//   (d) cicp_matrix in [0, CICP_MATRIX_MAX] (§8.3; identity=0 allowed)
//   (e) primaries_ord in {SRGB, P3, REC709, REC2020} (small enum)
//   (f) has_icc in {0, 1}; when 1, icc_ref_slot < 256
//   (g) rights subset of R_CP_ALL (R_MINT PRESENT -- derived profiles)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]  header: in_use[63:56] | parent_slot[15:8]
//   [+8]  profile_key (u64)
//   [+16] body1: cicp_colour[15:0] | cicp_transfer[31:16]
//              | cicp_matrix[47:32] | primaries_ord[55:48]
//              | has_icc[63:56]
//   [+24] body2: icc_ref_slot[15:0] | flags[63:16]
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEE40..0xFFFFEE4F
// =============================================================================

module KindColorProfile = structure {

  pub let KIND_COLOR_PROFILE : u64 = 0x18F
  pub let CP_PARENT_KIND     : u64 = 4              // KIND_MEMORY

  // Rights. R_MINT PRESENT -- a wide-gamut buffer's derived tone-map
  // target profile derives from the master through the channel.
  pub let R_CP_READ    : u64 = 0x001
  pub let R_CP_INVOKE  : u64 = 0x008
  pub let R_CP_REVOKE  : u64 = 0x010
  pub let R_CP_MINT    : u64 = 0x200
  pub let R_CP_OBSERVE : u64 = 0x400
  pub let R_CP_ALL     : u64 = 0x619

  // Primaries ordinal. The four the compositor knows how to
  // convert between natively.
  pub let PRIM_SRGB    : u64 = 1
  pub let PRIM_P3      : u64 = 2
  pub let PRIM_REC709  : u64 = 3
  pub let PRIM_REC2020 : u64 = 4
  pub let PRIM_MAX     : u64 = 4

  // CICP ceilings (ITU-T H.273). Kept as small non-negative bounds;
  // the CICP parser module refines identity + validity per §8.
  pub let CICP_COLOUR_MAX   : u64 = 22
  pub let CICP_TRANSFER_MAX : u64 = 18
  pub let CICP_MATRIX_MAX   : u64 = 14

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED.
  pub let CP_OP_QUERY_KEY     : u64 = 0
  pub let CP_OP_QUERY_COLOUR  : u64 = 1
  pub let CP_OP_QUERY_TRANS   : u64 = 2
  pub let CP_OP_QUERY_MATRIX  : u64 = 3
  pub let CP_OP_QUERY_PRIM    : u64 = 4
  pub let CP_OP_QUERY_HAS_ICC : u64 = 5
  pub let CP_OP_QUERY_ICC_REF : u64 = 6
  pub let CP_OP_DEBUG_PRINT   : u64 = 7
  pub let CP_OP_MAX           : u64 = 7

  // Failure taxonomy -- 0xFFFFEE40..0xFFFFEE4F.
  pub let CP_OK               : u64 = 0
  pub let CP_TAIL_ENOSPC      : u64 = 0xFFFFEE4F
  pub let CP_TAIL_BAD_ARG     : u64 = 0xFFFFEE4E
  pub let CP_MINT_BAD_PARENT  : u64 = 0xFFFFEE4D
  pub let CP_MINT_BAD_RIGHTS  : u64 = 0xFFFFEE4C
  pub let CP_MINT_BAD_COLOUR  : u64 = 0xFFFFEE4B
  pub let CP_MINT_BAD_TRANS   : u64 = 0xFFFFEE4A
  pub let CP_MINT_BAD_MATRIX  : u64 = 0xFFFFEE49
  pub let CP_MINT_BAD_PRIM    : u64 = 0xFFFFEE48
  pub let CP_MINT_BAD_HAS_ICC : u64 = 0xFFFFEE47
  pub let CP_MINT_BAD_ICC_REF : u64 = 0xFFFFEE46
  pub let CP_MINT_NO_KEY      : u64 = 0xFFFFEE45
  pub let CP_MINT_ENOSPC      : u64 = 0xFFFFEE44
  pub let CP_MINT_KEY_IN_USE  : u64 = 0xFFFFEE43
  pub let CP_BAD_SLOT         : u64 = 0xFFFFEE42
  pub let CP_WRONG_KIND       : u64 = 0xFFFFEE41
  pub let CP_REVOKE_ALREADY   : u64 = 0xFFFFEE40

  pub let CP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let CP_ROW_NONE   : u64 = 0xFF

  pub let CP_MAX          : u64 = 16
  pub let CP_ROW_BYTES    : u64 = 32

  // THE ONE STATE CELL. Confined by tools/build.sh.
  // 16 rows * 32 bytes = 512 bytes = 64 u64.
  pub let mut _color_profile_table : [u64; 64] = uninit @align(64)
  pub let mut _color_profile_stats : [u64; 4]  = uninit @align(64)

  pub let CP_ST_MINTS   : u64 = 0
  pub let CP_ST_REVOKES : u64 = 1
  pub let CP_ST_REFUSED : u64 = 2
  pub let CP_ST_QUERIES : u64 = 3

  pub let cp_dbg_msg : [u8; 18] = "COLOR PROFILE ROW\0"

  pub let cp_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): clear row table + counters.",
      block: {
        lea r10, [rip + _color_profile_table];
        xor rax, rax;
        xor rcx, rcx;
      cp_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  cp_rs_rows;

        lea r10, [rip + _color_profile_stats];
        xor rcx, rcx;
      cp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  cp_rs_stats;
        ret
      }
    }

  pub let cp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): counter bump.",
      block: {
        cmp rdi, 4;
        jae cp_nt_out;
        lea r10, [rip + _color_profile_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cp_nt_out:
        ret
      }
    }

  pub let cp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): counter read.",
      block: {
        cmp rdi, 4;
        jae cp_st_zero;
        lea r10, [rip + _color_profile_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let cp_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): subset test against R_CP_ALL = 0x619.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne cp_rv_no;
        mov rax, 1;
        ret;
      cp_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cp_colour_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): 1 iff c in [1, CICP_COLOUR_MAX=22].",
      block: {
        cmp rdi, 0;
        je  cp_cv_no;
        mov r10, 22;
        cmp rdi, r10;
        ja  cp_cv_no;
        mov rax, 1;
        ret;
      cp_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cp_transfer_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): 1 iff t in [1, CICP_TRANSFER_MAX=18].",
      block: {
        cmp rdi, 0;
        je  cp_tv_no;
        mov r10, 18;
        cmp rdi, r10;
        ja  cp_tv_no;
        mov rax, 1;
        ret;
      cp_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cp_matrix_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): 1 iff m <= CICP_MATRIX_MAX=14. Identity (0) allowed.",
      block: {
        mov r10, 14;
        cmp rdi, r10;
        ja  cp_mv_no;
        mov rax, 1;
        ret;
      cp_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cp_prim_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): 1 iff p in [1, PRIM_MAX=4].",
      block: {
        cmp rdi, 0;
        je  cp_pv_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  cp_pv_no;
        mov rax, 1;
        ret;
      cp_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cp_has_icc_valid : (u64) -> u64 !{} @{} =
    fn (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): 1 iff h in {0,1}.",
      block: {
        mov r10, 1;
        cmp rdi, r10;
        ja  cp_hv_no;
        mov rax, 1;
        ret;
      cp_hv_no:
        xor rax, rax;
        ret
      }
    }

  // body1: cicp_colour[15:0] | cicp_transfer[31:16]
  //      | cicp_matrix[47:32] | primaries_ord[55:48] | has_icc[63:56]
  pub let cp_body1_pack : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (c: u64) (t: u64) (m: u64) (p: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): body1 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  cp_b1_bad;
        cmp rsi, r10;
        ja  cp_b1_bad;
        cmp rdx, r10;
        ja  cp_b1_bad;
        mov r10, 0xFF;
        cmp rcx, r10;
        ja  cp_b1_bad;
        cmp r8, r10;
        ja  cp_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov r10, r8;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      cp_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: icc_ref_slot[15:0] | flags[63:16]
  pub let cp_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (icc_ref: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): body2 pack. `flags` is stored at [63:16]; shifting left 16 drops any bits at [63:48], so no explicit 48-bit mask is required (which spares a 48-bit-immediate that paideia-as would need a movabs to encode).",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  cp_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;
        ret;
      cp_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let cp_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-001 (#1509): pack header sans in_use bit.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae cp_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      cp_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // cp_tail_alloc(hdr, profile_key, body1, body2) -> row_id | err.
  pub let cp_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (profile_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): claim one COLOR_PROFILE row.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne cp_ta_bad;
        cmp r13, 0;
        je  cp_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  cp_ta_bad;
        cmp r15, r10;
        je  cp_ta_bad;

        xor rbx, rbx;
      cp_ta_scan:
        cmp rbx, 16;                        // CP_MAX
        jae cp_ta_enospc;
        lea r10, [rip + _color_profile_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cp_ta_claim;
        add rbx, 1;
        jmp cp_ta_scan;

      cp_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp cp_ta_out;

      cp_ta_enospc:
        mov rax, 0xFFFFEE4F;
        jmp cp_ta_out;
      cp_ta_bad:
        mov rax, 0xFFFFEE4E;

      cp_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cp_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): 1 iff row_id < CP_MAX and in_use.",
      block: {
        cmp rdi, 16;
        jae cp_tv2_no;
        lea r10, [rip + _color_profile_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cp_tv2_no;
        mov rax, 1;
        ret;
      cp_tv2_no:
        xor rax, rax;
        ret
      }
    }

  pub let cp_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): scrub one row.",
      block: {
        cmp rdi, 16;
        jae cp_tf_out;
        lea r10, [rip + _color_profile_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      cp_tf_out:
        ret
      }
    }

  pub let cp_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): profile_key.",
      block: {
        push r12;
        mov r12, rdi;
        call cp_tail_valid;
        cmp rax, 0;
        je  cp_rk_bad;
        lea r10, [rip + _color_profile_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp cp_rk_out;
      cp_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      cp_rk_out:
        pop r12;
        ret
      }
    }

  pub let cp_row_colour : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-001 (#1509): cicp_colour at body1[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call cp_tail_valid;
        cmp rax, 0;
        je  cp_rc_bad;
        lea r10, [rip + _color_profile_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp cp_rc_out;
      cp_rc_bad:
