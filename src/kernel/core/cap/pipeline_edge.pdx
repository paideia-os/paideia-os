// src/kernel/core/cap/pipeline_edge.pdx -- R121.M1 (paideia-os #2495)
//
// KIND_PIPELINE_EDGE substrate: row pool + mint helper + free helper +
// cap_slot -> row_id walker + cap_invoke dispatch handler + defensive
// pool-reset leaf. All folded into one file (kind_schema_handle.pdx /
// kind_kek.pdx compact posture) because the op surface at M1 is
// deliberately tiny (a single QUERY_ROLE proof-of-life op); the
// serious dispatch (SEND / RECV / BIND) arrives with R121.M2 and rides
// on top of this substrate without changing the row layout.
//
// =============================================================================
// SECTION 0  ORDINAL CHOICE -- 0x1F0
// =============================================================================
//
// design/terminal/semantic-shell-materialization-plan.md §4 R121.M1 asked
// for "next slot past KIND_SCHEMA_HANDLE = 0x1B2 (probably 0x1B3 or 0x1B4)".
// A landing-time sweep (2026-09-23) of the entire 0x1B strip shows every
// slot in 0x1B3..0x1BF has been either declared or soft-reserved after
// that plan was written:
//
//   0x1B0  KIND_PAGE_FLIP           (R104.M4-001, declared)
//   0x1B1  KIND_HOTPLUG_CHANNEL     (R105.M4-001, declared)
//   0x1B2  KIND_SCHEMA_HANDLE       (R90-XREPO.012.M3-001, declared)
//   0x1B3  KIND_VOLUME_SNAPSHOT    (LV11.M3-001, declared)
//   0x1B4  KIND_KEK                (LV11.M5-001, declared)
//   0x1B5  KIND_HDR_METADATA        (user G6 Batch-1, soft-reserved via
//                                    kind_session.pdx §KIND-ID SLOT
//                                    ALLOCATION + src/samples/settings/
//                                    color.pdx L12)
//   0x1B6  KIND_TONEMAP_LUT         (user G6 Batch-1, soft-reserved,
//                                    same authorities)
//   0x1B7  KIND_REFERENCE_DISPLAY   (user G6 Batch-1, soft-reserved,
//                                    same authorities)
//   0x1B8  KIND_SURFACE             (R113.M1-001b, declared)
//   0x1B9  KIND_SURFACE_COMMIT      (user G6 Batch-2, declared in
//                                    src/user/compositor/surface_commit.pdx)
//   0x1BA  KIND_SUBSURFACE          (declared in src/user/compositor/
//                                    subsurface_sync.pdx)
//   0x1BB  buffer-attach state      (compositor B6-04 / g7-M2-004,
//                                    soft-reserved via src/user/
//                                    compositor/window_kind.pdx L51)
//   0x1BC  KIND_SESSION             (R113.M5-022, declared)
//   0x1BD  KIND_FRAME_CAPTURE       (declared)
//   0x1BE  KIND_CAPTURE_ID          (declared)
//   0x1BF  KIND_SEAT_ID             (declared)
//
// Per the feedback_spec_vs_codebase_conflicts discipline (preserve
// binding invariants + flag the conflict): the plan's numeric prediction
// is out of date and every plausible in-band slot has been claimed
// after that plan was written. Rather than displace a soft reservation
// belonging to a sibling wave (G6 HDR family, compositor buffer-attach),
// this landing takes the FIRST fresh 16-slot page above the closed
// 0x100..0x1EF band: 0x1F0. A tree-wide `grep -rn "pub let KIND.*= 0x1F"
// src/**/*.pdx` returns zero declarations before this landing (checked
// 2026-09-23), so R121 gets its own uncontended strip 0x1F0..0x1FF that
// R121.M2..M6 can extend without another round of slot-audit friction.
// The design gap between the plan's `kind=0x1B<X>` fingerprint shape
// and the emitted `kind=0x00000000000001f0` is flagged in the R121.M1
// close-out report (report says: update
// design/terminal/semantic-shell-materialization-plan.md §4 R121.M1 row
// to reflect kind=0x1F0).
//
// =============================================================================
// SECTION 1  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// The plan (§4 R121.M1) says "Base derives from KIND_MEMORY." A pipeline
// edge is a per-endpoint handle on a static kernel-owned row pool
// (_pipeline_edge_table lives in .bss like _ksh_table). The parent gate
// is therefore the standard "cannot widen memory reach beyond what you
// already hold" rule: parent.kind == KIND_MEMORY (4) AND rights carry
// RIGHT_MINT (0x200). No cap_invoke op reaches pipeline_edge_alloc at
// M1: the mint is a kernel-trusted primitive callable from the R121.M1
// boot witness (r121_pipeline_edge.pdx) and, from R121.M5 onward, from
// the shell dispatcher after it holds a root KIND_MEMORY + RIGHT_MINT
// parent cap. A ring-3 caller holding only a KIND_PIPELINE_EDGE cannot
// mint a fresh one -- it can only reach the QUERY_ROLE op through the
// cap_handler surface below.
//
// =============================================================================
// SECTION 2  ROW LAYOUT (32 bytes, 4 u64 words)
// =============================================================================
//
// Byte offsets follow design/terminal/semantic-shell-materialization-plan
// .md §4 R121.M1 exactly for offsets 0..23. The plan's offset-24
// "padding u64" is repurposed here as the in_use header word so the
// row substrate can carry a live-marker without changing the plan's
// named-field offsets. Callers reading offsets 0..23 see the fields the
// plan documents; the pool allocator/free path reads offset 24 to
// detect free vs live rows.
//
//   [+0]  ids                (u64)
//         schema_id [31:0]   (u32)
//         edge_id   [63:32]  (u32, monotonic; edge_id=0 is the
//                             "not-an-edge" sentinel, first mint gets 1)
//   [+8]  role_rights        (u64)
//         endpoint_role [7:0]   (u8; 0=PROD, 1=CONS)
//         rights        [23:8]  (u16)
//         reserved      [31:24] (u8; zero-on-mint)
//         buddy_edge_id [63:32] (u32; 0 on mint, R121.M2 bind_edges
//                                writes the peer's edge_id here)
//   [+16] session_pos        (u64; monotonic byte offset into the
//                             session-typed SPSC, 0 on mint, R121.M2
//                             pipe_edge_send bumps by payload len)
//   [+24] header             (u64)
//         in_use    [63:56]  (0=free, 1=live)
//         reserved  [55:0]   (zero-on-mint)
//
// Row-addressed capacity: PE_MAX = 32 rows. 32 * 32 = 1024 bytes = 128
// u64. Matches KSH_MAX (32) one-for-one, and 32 outstanding pipeline
// edges gives headroom for `find | sort | uniq | head` chains of
// depth 4 across an 8-way concurrent shell (4 endpoints per pipeline
// * 8 sessions = 32).
//
// =============================================================================
// SECTION 3  RIGHTS -- R_PE_SEND, R_PE_RECV, R_PE_BIND
// =============================================================================
//
//   R_PE_SEND  (0x001) -- authorises pipe_edge_send (R121.M2).
//                          Held by a producer endpoint.
//   R_PE_RECV  (0x002) -- authorises pipe_edge_recv (R121.M2).
//                          Held by a consumer endpoint.
//   R_PE_BIND  (0x004) -- authorises bind_edges (R121.M4 session-type
//                          duality checker). Held only by the shell
//                          runtime that owns both halves.
//
// R_PE_ALL = 0x007. Subset test in pe_rights_valid uses that constant.
// QUERY_ROLE (op 0, this landing) accepts either R_PE_SEND or R_PE_RECV
// -- an endpoint may always read back its own role.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFEB80..0xFFFFEB8F
// =============================================================================
//
// Band audit (2026-09-23): `grep -rn "0xFFFFEB8[0-9A-F]" src/kernel/`
// returned zero declarations; safe to claim. Neighbours: KIND_KEK ships
// at 0xFFFFEB50..0xFFFFEB5F (page_flip), KIND_HOTPLUG_CHANNEL at
// 0xFFFFEB60..0xFFFFEB6F, KIND_GUC_BUNDLE at 0xFFFFEB70..0xFFFFEB7F, so
// this band sits at the immediate top of that range.
//
//   PE_MINT_BAD_PARENT  0xFFFFEB8F  -- parent not KIND_MEMORY, or no MINT
//   PE_MINT_BAD_RIGHTS  0xFFFFEB8E  -- rights outside R_PE_ALL, or > u16
//   PE_MINT_BAD_ROLE    0xFFFFEB8D  -- endpoint_role not in {0, 1}
//   PE_MINT_BAD_SCHEMA  0xFFFFEB8C  -- schema_id == 0 or > u32
//   PE_TAIL_ENOSPC      0xFFFFEB8B  -- pool full (all 32 rows live)
//   PE_BAD_SLOT         0xFFFFEB8A  -- row_id out of range or free
//   PE_BAD_RIGHTS       0xFFFFEB89  -- cap_handler rights gate refused
//   PE_TAIL_BAD_ARG     0xFFFFEB88  -- op_arg[63:8] non-zero
//   PE_FREE_BAD_SLOT    0xFFFFEB87  -- pipeline_edge_free called on
//                                       out-of-range or already-free row
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE
// =============================================================================
//
// paideia-as encoder posture (feedback_pdx_encoder_pitfalls):
//   * No `test rN, rN` -- every zero-check uses `cmp reg, 0`.
//   * No 2-op `imul r, imm` -- row addressing uses `shl reg, 5` for *32.
//   * No `and reg, imm64` -- 0xFF / 0xFFFF / 0xFFFFFFFF fit imm32; the
//     KIND ordinal 0x1F0 stages through r11 first for the cmp against
//     rcx in invoke.pdx.
//   * No `add reg, [mem]` / `cmp reg, [mem]` -- every memory operand
//     lands in a register first (load-inc-store idiom on the stats
//     bumper and the edge_id counter).
//   * No `mov_b` in this file -- every store is a qword `mov [mem], reg`.
//   * Reserved-label prefix `pe_` (short for pipeline_edge) avoids the
//     `loop`/`if`/`top`/`done` collision class per
//     feedback_paideia_as_reserved_labels; inner labels also carry a
//     second-level prefix (pe_al_ alloc, pe_ra_ row_alloc, pe_fr_ free,
//     pe_rs_ row-of-slot, pe_hn_ handler, pe_nt_ note, pe_in_ init).

module PipelineEdge = structure {

  // =========================================================================
  // SECTION 6  CONSTANTS
  // =========================================================================

  pub let KIND_PIPELINE_EDGE      : u64 = 0x1F0
  pub let KIND_PIPELINE_EDGE_BASE : u64 = 4          // = KIND_MEMORY

  // Endpoint roles.
  pub let PE_ROLE_PROD : u64 = 0
  pub let PE_ROLE_CONS : u64 = 1
  pub let PE_ROLE_MAX  : u64 = 1

  // Rights (§3).
  pub let R_PE_SEND : u64 = 0x001
  pub let R_PE_RECV : u64 = 0x002
  pub let R_PE_BIND : u64 = 0x004
  pub let R_PE_ALL  : u64 = 0x007

  // Ops (M1 ships only QUERY_ROLE; SEND/RECV/BIND arrive at M2/M4).
  pub let PE_OP_QUERY_ROLE : u64 = 0
  pub let PE_OP_MAX        : u64 = 0

  // Failure taxonomy (§4).
  pub let PE_OK              : u64 = 0
  pub let PE_MINT_BAD_PARENT : u64 = 0xFFFFEB8F
  pub let PE_MINT_BAD_RIGHTS : u64 = 0xFFFFEB8E
  pub let PE_MINT_BAD_ROLE   : u64 = 0xFFFFEB8D
  pub let PE_MINT_BAD_SCHEMA : u64 = 0xFFFFEB8C
  pub let PE_TAIL_ENOSPC     : u64 = 0xFFFFEB8B
  pub let PE_BAD_SLOT        : u64 = 0xFFFFEB8A
  pub let PE_BAD_RIGHTS      : u64 = 0xFFFFEB89
  pub let PE_TAIL_BAD_ARG    : u64 = 0xFFFFEB88
  pub let PE_FREE_BAD_SLOT   : u64 = 0xFFFFEB87

  pub let PE_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PE_ROW_NONE   : u64 = 0xFF

  // Pool ceilings.
  pub let PE_MAX       : u64 = 32
  pub let PE_ROW_BYTES : u64 = 32

  // Storage: 32 rows * 32 bytes = 1024 bytes = 128 u64.
  pub let mut _pipeline_edge_table : [u64; 128] = uninit @align(64)
  pub let mut _pipeline_edge_stats : [u64; 8]   = uninit @align(64)
  // Monotonic edge_id counter. Pre-incremented on each mint so the
  // first minted edge gets edge_id = 1; edge_id = 0 is the "not-an-
  // edge" sentinel R121.M2 will use in the buddy_edge_id [63:32] slot
  // of an unbound endpoint.
  pub let mut _pe_next_edge_id     : u64        = 0

  pub let PE_ST_MINTS   : u64 = 0
  pub let PE_ST_FREES   : u64 = 1
  pub let PE_ST_QUERIES : u64 = 2
  pub let PE_ST_REFUSED : u64 = 3
  pub let PE_ST_MAX     : u64 = 8

  // =========================================================================
  // SECTION 7  pipeline_edge_init() -> ()
  // =========================================================================
  //
  // Boot / teardown scrub of the row pool, counter table, and the
  // monotonic edge_id counter. .bss already starts zero at real boot;
  // defensive, matches kind_kek_init one-for-one. Called from
  // kernel_main's derived-kind reset cascade (adjacent to kind_kek_init).

  pub let pipeline_edge_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): defensive scrub of _pipeline_edge_table (128 u64 = 1024 bytes), _pipeline_edge_stats (8 u64) and _pe_next_edge_id (1 u64). Three straight-line loops, mirrors kind_kek_init one-for-one. Labels prefixed pe_in_.",
      block: {
        lea r10, [rip + _pipeline_edge_table];
        xor rax, rax;
        xor rcx, rcx;
      pe_in_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  pe_in_rows;

        lea r10, [rip + _pipeline_edge_stats];
        xor rcx, rcx;
      pe_in_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pe_in_stats;

        lea r10, [rip + _pe_next_edge_id];
        mov [r10 + 0], rax;
        ret
      }
    }

  // =========================================================================
  // SECTION 8  pe_note(which) -- bounded stats increment.
  // =========================================================================

  pub let pe_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): bounded increment on _pipeline_edge_stats. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed pe_nt_.",
      block: {
        cmp rdi, 8;
        jae pe_nt_out;
        lea r10, [rip + _pipeline_edge_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pe_nt_out:
        ret
      }
    }

  // =========================================================================
  // SECTION 9  Validators.
  // =========================================================================

  // pe_rights_valid(rights) -> 1 iff subset of R_PE_ALL (0x007) AND
  // fits in u16 (0xFFFF).
  pub let pe_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): subset test against R_PE_ALL = 0x007 AND u16 fit check (rights >> 16 == 0). The rights field is documented in §2 as u16, so this validator refuses any high-bit smuggle even if it would happen to fall within R_PE_ALL. Labels prefixed pe_rv_.",
      block: {
        // Subset test.
        mov rax, rdi;
        mov r10, 0x007;                  // R_PE_ALL
        and rax, r10;
        cmp rax, rdi;
        jne pe_rv_no;
        // u16 fit.
        mov rax, rdi;
        shr rax, 16;
        cmp rax, 0;
        jne pe_rv_no;
        mov rax, 1;
        ret;
      pe_rv_no:
        xor rax, rax;
        ret
      }
    }

  // pe_role_valid(role) -> 1 iff role in {0, 1}.
  pub let pe_role_valid : (u64) -> u64 !{} @{} =
    fn (role: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): role in {PE_ROLE_PROD=0, PE_ROLE_CONS=1}. Labels prefixed pe_ro_.",
      block: {
        cmp rdi, 1;                      // PE_ROLE_MAX
        ja  pe_ro_no;
        mov rax, 1;
        ret;
      pe_ro_no:
        xor rax, rax;
        ret
      }
    }

  // pe_schema_valid(schema_id) -> 1 iff schema_id in [1..u32_max].
  pub let pe_schema_valid : (u64) -> u64 !{} @{} =
    fn (schema_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): schema_id in [1..0xFFFFFFFF]. 0 is the 'no id' sentinel (svc.schema-registry SREG discipline). Labels prefixed pe_sv_.",
      block: {
        cmp rdi, 0;
        je  pe_sv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne pe_sv_no;
        mov rax, 1;
        ret;
      pe_sv_no:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // SECTION 10  Row pool -- pe_row_valid / pe_row_alloc / pe_row_free.
  // =========================================================================

  // pe_row_valid(idx) -> 1 iff idx < PE_MAX and header at [+24] carries
  // the in_use marker (bit 56).
  pub let pe_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): 1 iff idx < PE_MAX(32) and in_use byte set at [row+24]. Inlined address compute (idx*32 via shl 5). Labels prefixed pe_rv2_.",
      block: {
        mov r10, 32;                     // PE_MAX
        cmp rdi, r10;
        jae pe_rv2_no;
        lea r10, [rip + _pipeline_edge_table];
        mov r11, rdi;
        shl r11, 5;                      // idx * 32
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 56;                     // in_use byte at [+24][63:56]
        cmp rax, 0;
        je  pe_rv2_no;
        mov rax, 1;
        ret;
      pe_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // pe_row_alloc(schema_id, role, rights, edge_id) -> row_idx | PE_TAIL_ENOSPC
  //
  // Low-first scan over 32 rows of 32 bytes. Header write is LAST:
  // in_use bit set via OR with (1 << 56) at [row+24] in the same qword
  // store, matching kind_nic.nic_tail_alloc "publish in_use last"
  // ordering; loads of the header (pe_row_valid, allocator scan) see
  // either the completed row or a scrubbed row, never a torn one.
  pub let pe_row_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (schema_id: u64) (role: u64) (rights: u64) (edge_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): claim one KIND_PIPELINE_EDGE row. Low-first scan (r15=idx cursor) over 32 rows of 32 bytes. On claim: (1) pack ids = (edge_id << 32) | (schema_id & 0xFFFFFFFF) into [row+0]; (2) pack role_rights = (0 << 32 for buddy_edge_id) | (0 << 24 for reserved) | ((rights & 0xFFFF) << 8) | (role & 0xFF) into [row+8]; (3) write session_pos=0 into [row+16]; (4) publish in_use=1 LAST via header store at [row+24] (in_use bit at 1<<56). Five callee-save pushes (rbx=schema_id, r12=role, r13=rights, r14=edge_id, r15=idx cursor) preserve loop-carried state across the internal scan; no nested calls, so no additional stack alignment padding is needed (mirrors ksh_row_alloc one-for-one). Labels prefixed pe_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // schema_id
        mov r12, rsi;                    // role
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // edge_id

        xor r15, r15;                    // idx = 0
      pe_ra_scan:
        mov r10, 32;                     // PE_MAX
        cmp r15, r10;
        jae pe_ra_enospc;

        lea r10, [rip + _pipeline_edge_table];
        mov r11, r15;
        shl r11, 5;                      // idx * 32
        add r10, r11;

        // Check header at [+24] in_use byte.
        mov rax, [r10 + 24];
        shr rax, 56;
        cmp rax, 0;
        je  pe_ra_claim;

        add r15, 1;
        jmp pe_ra_scan;

      pe_ra_claim:
        // [+0] ids = (edge_id << 32) | (schema_id & 0xFFFFFFFF).
        mov rax, rbx;
        mov r11, 0xFFFFFFFF;
        and rax, r11;                    // schema_id low 32
        mov rcx, r14;                    // edge_id
        shl rcx, 32;
        or  rax, rcx;
        mov [r10 + 0], rax;

        // [+8] role_rights = (0<<32 buddy) | (0<<24 rsv) |
        //                    ((rights & 0xFFFF) << 8) | (role & 0xFF).
        mov rax, r12;                    // role
        mov r11, 0xFF;
        and rax, r11;                    // role byte
        mov rcx, r13;                    // rights
        mov r11, 0xFFFF;
        and rcx, r11;                    // rights u16
        shl rcx, 8;                      // rights at [23:8]
        or  rax, rcx;
        // buddy_edge_id (0) + reserved (0) stay zero -- no additional OR.
        mov [r10 + 8], rax;

        // [+16] session_pos = 0.
        xor rax, rax;
        mov [r10 + 16], rax;

        // [+24] header: in_use = 1 << 56. Publish LAST.
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 24], rax;

        mov rax, r15;                    // row_idx
        jmp pe_ra_out;

      pe_ra_enospc:
        mov rax, 0xFFFFEB8B;             // PE_TAIL_ENOSPC

      pe_ra_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // pe_row_free_inner(idx) -> (). Scrub all four u64 words. Not
  // bounds-checked -- callers guarantee idx < PE_MAX. Split from
  // pipeline_edge_free below so the scrub can be reused in future
  // rollback arms (R121.M2 bind rollback, R121.M6 backpressure teardown)
  // without their double-bumping PE_ST_FREES.
  pub let pe_row_free_inner : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): scrub one row (four u64 words). No bounds check by contract (§10 body). Labels prefixed pe_rfi_.",
      block: {
        lea r10, [rip + _pipeline_edge_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;             // in_use cleared LAST
        ret
      }
    }

  // =========================================================================
  // SECTION 11  Row accessors (each returns PE_DECODE_BAD on invalid row).
  // =========================================================================

  pub let pe_row_schema_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): schema_id (ids u64 [31:0] at [row+0]) or PE_DECODE_BAD. Labels prefixed pe_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call pe_row_valid;
        cmp rax, 0;
        je  pe_rk_bad;
        lea r10, [rip + _pipeline_edge_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        jmp pe_rk_out;
      pe_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pe_rk_out:
        pop r12;
        ret
      }
    }

  pub let pe_row_edge_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): edge_id (ids u64 [63:32] at [row+0]) or PE_DECODE_BAD. Labels prefixed pe_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call pe_row_valid;
        cmp rax, 0;
        je  pe_re_bad;
        lea r10, [rip + _pipeline_edge_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;                     // edge_id = ids[63:32]
        jmp pe_re_out;
      pe_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pe_re_out:
        pop r12;
        ret
      }
    }

  pub let pe_row_role : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): endpoint_role (role_rights u64 [7:0] at [row+8]) or PE_DECODE_BAD. Labels prefixed pe_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call pe_row_valid;
        cmp rax, 0;
        je  pe_rl_bad;
        lea r10, [rip + _pipeline_edge_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        mov r10, 0xFF;
        and rax, r10;                    // role byte
        jmp pe_rl_out;
      pe_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pe_rl_out:
        pop r12;
        ret
      }
    }

  // =========================================================================
  // SECTION 12  pipeline_edge_alloc(schema_id, role, rights)
  //             -> row_idx | PE_MINT_BAD_* | PE_TAIL_ENOSPC
  //
  // The M1 mint helper. Not reachable via cap_invoke (no MINT right at
  // this landing); called from the boot witness (r121_pipeline_edge.pdx)
  // and, from R121.M5, the shell dispatcher after it holds a KIND_MEMORY
  // parent cap with RIGHT_MINT.
  //
  // Return: row_idx (u64 in [0..31]) on success. row_idx doubles as the
  // "cap_slot" the M1 contract mentions in its brief -- R121.M5 will
  // wire a KIND_PIPELINE_EDGE cap_table row whose target_ptr = row_idx,
  // and pipeline_edge_row_of_slot below walks that indirection back.
  //
  // Gate order:
  //   (1) schema_id in [1..u32_max]  (pe_schema_valid)
  //   (2) role in {0, 1}             (pe_role_valid)
  //   (3) rights subset of R_PE_ALL AND fits u16 (pe_rights_valid)
  //   (4) fresh edge_id via monotonic counter
  //   (5) pe_row_alloc(schema_id, role, rights, edge_id)
  //
  // Register plan: rbx=schema_id, r12=role, r13=rights, r14=edge_id,
  // r15=row_idx (assigned after step 5). Five callee-save pushes + sub
  // rsp,8 = 48 bytes: entry rsp%16==8, +48 -> %16==0 for every nested
  // call (pe_schema_valid / pe_role_valid / pe_rights_valid / pe_row_
  // alloc / pe_note / klog_s1_x3). On success emits fingerprint via
  // klog_s1_x3 (see §14 below) and bumps PE_ST_MINTS; refusal funnel
  // bumps PE_ST_REFUSED. Labels prefixed pe_al_.
  // =========================================================================

  pub let pipeline_edge_alloc : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (schema_id: u64) (role: u64) (rights: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): mint one KIND_PIPELINE_EDGE endpoint. Gate order: (1) pe_schema_valid(schema_id); (2) pe_role_valid(role); (3) pe_rights_valid(rights); (4) fresh edge_id via monotonic _pe_next_edge_id counter (pre-increment: first mint gets edge_id=1, so 0 stays available as the 'not-an-edge' sentinel R121.M2 buddy_edge_id[63:32] uses for unbound endpoints); (5) pe_row_alloc(schema_id, role, rights, edge_id). Register plan: rbx=schema_id, r12=role, r13=rights, r14=edge_id, r15=row_idx (assigned after step 5). Five callee-save pushes = 40 bytes: entry rsp%16==8, +40 -> rsp%16==0 for every nested call (pe_schema_valid / pe_role_valid / pe_rights_valid / pe_row_alloc / pe_note / klog_s1_x3). No additional stack padding needed -- the five-push count itself carries the alignment. On success emits the fingerprint 'pipe edge mint ok kind=<hex> schema_id=<hex> role=<hex>' via klog_s1_x3 (SUBSYS_CAP_, tag_pipe_edge_mint_ok, k_kind + KIND_PIPELINE_EDGE, k_schema_id + schema_id, k_role + role) and bumps PE_ST_MINTS. klog_s1_x3 caller-push idiom (see bochs_stdvga probe L212): sub rsp,8 pre-align, push v3/k3/v2 in that order, add rsp,32 tail (pop 3 + undo pre-align). Refusal funnel (pe_al_refused) bumps PE_ST_REFUSED. Effects widened to (sysreg, mem) because klog_s1_x3 -> klog_emit_core touches the UART port-IO path. Labels prefixed pe_al_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // schema_id
        mov r12, rsi;                    // role
        mov r13, rdx;                    // rights

        // (1) schema_id validity.
        mov rdi, rbx;
        call pe_schema_valid;
        cmp rax, 0;
        je  pe_al_bad_schema;

        // (2) role validity.
        mov rdi, r12;
        call pe_role_valid;
        cmp rax, 0;
        je  pe_al_bad_role;

        // (3) rights validity.
        mov rdi, r13;
        call pe_rights_valid;
        cmp rax, 0;
        je  pe_al_bad_rights;

        // (4) Fresh edge_id (pre-increment monotonic counter).
        lea r10, [rip + _pe_next_edge_id];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov r14, rax;                    // edge_id

        // (5) Row allocation.
        mov rdi, rbx;                    // schema_id
        mov rsi, r12;                    // role
        mov rdx, r13;                    // rights
        mov rcx, r14;                    // edge_id
        call pe_row_alloc;
        mov r10, 32;                     // PE_MAX (row cap)
        cmp rax, r10;
        jae pe_al_alloc_fail;

        mov r15, rax;                    // row_idx

        // Success: bump PE_ST_MINTS.
        mov rdi, 0;                      // PE_ST_MINTS
        call pe_note;

        // Emit fingerprint: klog_s1_x3(LEVEL_INFO=3, SUBSYS_CAP_,
        //   tag_pipe_edge_mint_ok, k_kind, KIND_PIPELINE_EDGE,
        //   k_schema_id, schema_id, k_role, role).
        //
        // klog_s1_x3 caller-push idiom (see bochs_stdvga probe L212):
        //   sub rsp, 8   pre-align  (rsp %16 == 8 -> 0)
        //   push v3      role       (%16 == 0 -> 8)
        //   push k3      k_role     (%16 == 8 -> 0)
        //   push v2      schema_id  (%16 == 0 -> 8)
        //   call klog_s1_x3
        //   add rsp, 24  pop 3
        //   add rsp, 8   undo pre-align
        //
        // Entry to this emit block: rsp%16 == 0 (see prologue arith
        // above). Sub 8 -> %16 == 8. 3 pushes -> %16 == 8+24 mod 16
        // = 8. Wait -- 8-24 = -16 = 0 mod 16 for a stack that grows
        // down. Correction: rsp DECREASES by 24 across 3 pushes, so
        // %16 goes 8 -> (8 - 24) mod 16 = -16 mod 16 = 0. Correct.
        // Before the call, rsp %16 == 0, which is the SysV alignment
        // requirement.
        sub rsp, 8;
        mov rax, r12;                    // role
        push rax;                        // v3
        lea rax, [rip + k_role];
        push rax;                        // k3
        mov rax, rbx;                    // schema_id
        push rax;                        // v2
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_pipe_edge_mint_ok];
        lea rcx, [rip + k_kind];
        mov r8,  0x1F0;                  // KIND_PIPELINE_EDGE (imm32-safe)
        lea r9,  [rip + k_schema_id];
        call klog_s1_x3;
        add rsp, 24;                     // pop 3 pushed args
        add rsp, 8;                      // undo pre-align

        mov rax, r15;                    // return row_idx
        jmp pe_al_out;

      pe_al_alloc_fail:
        // rax already holds PE_TAIL_ENOSPC (0xFFFFEB8B).
        jmp pe_al_refused;
      pe_al_bad_schema:
        mov rax, 0xFFFFEB8C;             // PE_MINT_BAD_SCHEMA
        jmp pe_al_refused;
      pe_al_bad_role:
        mov rax, 0xFFFFEB8D;             // PE_MINT_BAD_ROLE
        jmp pe_al_refused;
      pe_al_bad_rights:
        mov rax, 0xFFFFEB8E;             // PE_MINT_BAD_RIGHTS

      pe_al_refused:
        push rax;
        mov rdi, 3;                      // PE_ST_REFUSED
        call pe_note;
        pop rax;

      pe_al_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // SECTION 13  pipeline_edge_free(row_idx) -> 0 | PE_FREE_BAD_SLOT
  //
  // Scrubs the row + bumps PE_ST_FREES. Refuses out-of-range indices
  // and already-free rows (the double-free case) with PE_FREE_BAD_SLOT.
  // R121.M2 bind rollback / R121.M6 backpressure teardown may want a
  // silent scrub that skips the counter bump -- they can call
  // pe_row_free_inner directly (§10 above).
  // =========================================================================

  pub let pipeline_edge_free : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R121.M1 (paideia-os #2495): free one KIND_PIPELINE_EDGE row. Gate order: (1) row_idx < PE_MAX (32); (2) row in_use marker set at [row+24]. On success: pe_row_free_inner (scrub) + pe_note(PE_ST_FREES). On refusal: PE_FREE_BAD_SLOT. Single callee-save push (rbx = row_idx cache across pe_row_valid / pe_row_free_inner / pe_note nested calls; rsp%16 goes entry-8 -> 0 which is the SysV pre-call requirement so no additional pad). Labels prefixed pe_fr_.",
      block: {
        cmp rdi, 32;                     // PE_MAX
        jae pe_fr_bad_slot_leaf;

        push rbx;
        mov rbx, rdi;                    // row_idx cache

        // Validate row is in-use (rejects double-free).
        mov rdi, rbx;
        call pe_row_valid;
        cmp rax, 0;
        je  pe_fr_bad_slot_pop;

        // Scrub the row.
        mov rdi, rbx;
        call pe_row_free_inner;

        // Bump PE_ST_FREES.
        mov rdi, 1;                      // PE_ST_FREES
        call pe_note;

        xor rax, rax;                    // PE_OK
        pop rbx;
        ret;

      pe_fr_bad_slot_pop:
        pop rbx;
      pe_fr_bad_slot_leaf:
        mov rax, 0xFFFFEB87;             // PE_FREE_BAD_SLOT
        ret
      }
    }

  // =========================================================================
  // SECTION 14  pipeline_edge_row_of_slot(cap_slot) -> row_id | PE_ROW_NONE
  //
  // Walker for downstream syscalls (R121.M2 pipe_edge_send, R121.M3
  // pipe_edge_recv, R121.M5 shell integration). Resolves a cap_table
  // slot to the underlying pool row_id in constant time:
  //   * cap_slot bounds-checked against the cap_table 256 max
  //   * cap_table[slot].kind must be KIND_PIPELINE_EDGE (0x1F0)
  //   * cap_table[slot].target_ptr low 16 bits carry the row_id
  //     (standard row-encoding convention: cap/mint.pdx §target_ptr
  //     for row-addressed kinds -- KIND_TUI_CANVAS, KIND_NIC,
  //     KIND_TLS_TRUST all use the same [15:0] convention).
  //
  // Returns PE_ROW_NONE (0xFF) on any refusal so downstream can
  // distinguish (rax > PE_MAX) from a valid low index without an
  // additional error-code branch.
  // =========================================================================

  pub let pipeline_edge_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R121.M1 (paideia-os #2495): cap_slot -> row_id walker for downstream syscalls (R121.M2/M3/M5). Bounds-check cap_slot < 256; load descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx -- {kind@0, rights@8, target_ptr@16}); require kind ([+0]) == KIND_PIPELINE_EDGE (0x1F0); return target_ptr ([+16]) low 16 bits as row_id. Pure read (@{cap} because it inspects cap_table). Labels prefixed pe_rs_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae pe_rs_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;                       // slot * 8
        mov r9, rdi;
        shl r9, 4;                       // slot * 16
        add r8, r9;                      // slot * 24
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1F0;                  // KIND_PIPELINE_EDGE
        cmp r10, r11;
        jne pe_rs_none;

        mov rax, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and rax, r11;                    // row_id = target_ptr[15:0]
        ret;

      pe_rs_none:
        mov rax, 0xFF;                   // PE_ROW_NONE
        ret
      }
    }

  // =========================================================================
  // SECTION 15  cap_handler_pipeline_edge(rights, target_ptr, op_arg)
  //
  // KIND_PIPELINE_EDGE op dispatch. Wired into cap_invoke_dispatch on
  // `cmp rcx, 0x1F0; je call_kind_pipeline_edge`. At M1 the only op is
  // PE_OP_QUERY_ROLE (0) -- an endpoint reads back its own role byte.
  // SEND (M2), RECV (M2), BIND (M4) arrive at their respective
  // milestones and extend the dispatch table here without changing the
  // row layout or the rights encoding.
  //
  //   row_id = target_ptr[15:0]
  //   op     = op_arg[7:0]; op_arg[63:8] MUST be zero
  //
  //   op 0 QUERY_ROLE -> read endpoint_role from row; returns u64
  //                      zero-extended (0=PROD, 1=CONS). Rights gate:
  //                      requires R_PE_SEND OR R_PE_RECV (either
  //                      endpoint may read its own role).
  //   else            -> PE_BAD_SLOT.
  //
  // Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave
  // rsp%16 == 0 at every nested call (entry rsp%16 == 8, -24 -> %16 ==
  // 0), mirroring cap_handler_schema_handle's prologue one-for-one --
  // no additional padding needed.
  // =========================================================================

  pub let cap_handler_pipeline_edge : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R121.M1 (paideia-os #2495): KIND_PIPELINE_EDGE ops dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0]; op_arg[63:8] MUST be zero (smuggled second value refused with PE_TAIL_BAD_ARG). Row validity (pe_row_valid) checked once before dispatch. Rights gate is per-op: QUERY_ROLE accepts either R_PE_SEND OR R_PE_RECV (both endpoints may read their own role). Ops dispatched: 0 QUERY_ROLE -> read role byte from row, return zero-extended. Unrecognized op falls to PE_BAD_SLOT. Successful QUERY bumps PE_ST_QUERIES via the shared pe_hn_count funnel. Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave rsp%16 == 0 at every nested call (entry rsp%16 == 8, -24 -> %16 == 0), mirroring cap_handler_schema_handle one-for-one. Labels prefixed pe_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op_arg

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne pe_hn_bad_arg;

        // op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        mov r13, r10;

        // Row validity (once, before dispatch).
        mov rdi, r12;
        call pe_row_valid;
        cmp rax, 0;
        je  pe_hn_bad_slot;

        // Op dispatch.
        cmp r13, 0;                      // PE_OP_QUERY_ROLE
        je  pe_hn_op_role;
        jmp pe_hn_bad_slot;

      pe_hn_op_role:
        // Rights gate: R_PE_SEND (0x001) OR R_PE_RECV (0x002).
        mov r10, rbx;
        and r10, 0x003;                  // R_PE_SEND | R_PE_RECV
        cmp r10, 0;
        je  pe_hn_bad_rights;

        // Read role byte from row.
        mov rdi, r12;
        call pe_row_role;                // rax = role (or PE_DECODE_BAD
                                         //   on internal miss, which
                                         //   pe_row_valid already
                                         //   ruled out).
        jmp pe_hn_count;

      pe_hn_count:
        push rax;
        mov rdi, 2;                      // PE_ST_QUERIES
        call pe_note;
        pop rax;
        jmp pe_hn_out;

      pe_hn_bad_arg:
        mov rax, 0xFFFFEB88;             // PE_TAIL_BAD_ARG
        jmp pe_hn_out;
      pe_hn_bad_slot:
        mov rax, 0xFFFFEB8A;             // PE_BAD_SLOT
        jmp pe_hn_out;
      pe_hn_bad_rights:
        mov rax, 0xFFFFEB89;             // PE_BAD_RIGHTS

      pe_hn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
