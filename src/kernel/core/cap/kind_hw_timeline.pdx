// src/kernel/core/cap/kind_hw_timeline.pdx — Wave 59 D3 (#2520) skeleton
//
// KIND_HW_TIMELINE derived-kind structural stub: declares the kind tag,
// rights discipline, backing-table .bss reservation, and the four
// entrypoints (tl_cap_mint, tl_cap_revoke, cap_timeline_signal,
// cap_timeline_wait) + the dispatch handler shell. Every entrypoint
// emits a `.rodata` dispatch-chatter tag through klog_s1 and returns
// INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC). Real bodies — tail encoder,
// counter-view mapping, wait-list splicing, shared-mem signal fence
// surface — land in the follow-up slice per
// `design/kernel/cap/kind-hw-timeline.md` §2.
//
// Design reference
// ----------------
// `design/kernel/cap/kind-hw-timeline.md` (Wave 59 D3) is the binding
// spec for this file. Sibling patterns copied verbatim from
// `kind_hw_interrupt.pdx` (R29.M1-001) and `kind_hw_msix_vector.pdx`
// (R29.M1-004); row shape mirrors `kind_dma_domain.pdx` (R29.M5-001).
//
// Numeric derived-kind tag
// ------------------------
// KIND_HW_TIMELINE = 0x143 (decimal 323). Fourth entry in the R29
// derived-kind block (0x140 interrupt / 0x141 msix / 0x142 dma domain /
// 0x143 timeline). The slot was reserved for timeline in `kind.pdx`
// header line 275 and in `kind_dma_domain.pdx` line 54 as "timeline
// reserved" since the R29.M5 landing.
//
// Runtime base kind: KIND_HW = 14. The LAM kind-hint fast-dispatch on
// bits [62:59] uses slot 14 (shared with KIND_HW_INTERRUPT 0x140 and
// KIND_HW_MSIX_VECTOR 0x141); cap_invoke_dispatch compares the full
// u64 kind field against 0x143 to reach this module's handler.
//
// Descriptor tail (row-indirection)
// ---------------------------------
// `target_ptr` holds row_id in bits [15:0]; upper bits [63:16] MUST be
// zero. Row at `_hw_timeline_table[row_id]`, 32 bytes (four u64s):
//
//   [+0]  u64:  bits [31:0]  = clock_id (u32)
//               bits [47:32] = source   (u16; 0=SW_FED, 1=GPU_SEQNO,
//                              2=HDA_LPIB, 3=USB_SOF, 4=TSC_DERIVED)
//               bits [55:48] = flags    (u8; bit 0 = HW_BACKED,
//                              bit 1 = WAIT_QUEUE_PRESENT)
//               bits [63:56] = in_use   (0 = free, 1 = allocated)
//   [+8]  u64:  counter_view_pa — PA of the 4 KiB counter page
//   [+16] u64:  bits [15:0]  = parent_slot    (cap_table slot u16)
//               bits [31:16] = notif_slot     (paired KIND_NOTIFICATION)
//               bits [47:32] = wait_head      (0xFFFF = empty)
//               bits [63:48] = resolution_ns  (u16; 0 = unitless)
//   [+24] u64:  last_signaled snapshot (u64; kernel-side observability)
//
// Full layout rationale in `design/kernel/cap/kind-hw-timeline.md §1.2`.
//
// Rights (subset of R_TL_ALL = 0x73)
// ----------------------------------
//   R_TL_WAIT    (0x01) — cap_timeline_wait: observe + block on value
//   R_TL_SIGNAL  (0x02) — cap_timeline_signal: advance the counter
//   R_TL_OBSERVE (0x10) — OP_SAMPLE / OP_QUERY_* snapshot ops
//   R_TL_REBIND  (0x20) — supervisor path (re-point notif / view)
//   R_TL_REVOKE  (0x40) — supervisor revoke
//
// Table sizing
// ------------
// HW_TIMELINE_MAX = 64. Reach: 5 engines per iGPU + 15 HDA streams +
// one USB SOF + 10 SW-fed slots + headroom. Storage: 64 * 32 = 2048
// bytes .bss, align 64 — matches HW_INT_MAX / HW_MSIX_MAX.
//
// What this file does NOT do yet (deferred to follow-up slice):
//   * Tail encoder/decoder (tl_tail_pack / tl_tail_decode_* / tl_tail_alloc).
//   * Mint-gate parent-kind validation (dual-parent: KIND_HW OR
//     KIND_NOTIFICATION per `design §0.2 TL-D2`).
//   * Counter-view page allocation + kernel+user+DMA tri-map.
//   * Wait-list record pool and splice/unsplice.
//   * Scheduler-tick poll walker (bounded ≤64 timelines × ≤8 waiters).
//   * Doorbell-wake IRQ integration via a parent `KIND_INTERRUPT` cap.
//   * Cascade walker (hw_cap_revoke extension for kind == 0x143).
//   * Dispatch wiring in cap_invoke_dispatch.
//
// The skeleton compiles and emits witness chatter; every entrypoint
// returns INVOKE_UNSUPPORTED so a mis-wired dispatch cannot create a
// cap that silently claims a slot.

module KindHwTimeline = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================

  // Runtime base kind (LAM kind-hint slot): KIND_HW = 14.
  pub let KIND_HW_TIMELINE_BASE : u64 = 14

  // Derived-kind tag. Value 0x143 (decimal 323); fourth entry in the
  // R29 derived-kind block.
  pub let KIND_HW_TIMELINE : u64 = 0x143

  // Primary parent kind for a hardware-fed timeline: KIND_HW.
  pub let KIND_TL_PARENT_HW : u64 = 14

  // Alternate parent kind for a software-fed timeline: KIND_NOTIFICATION.
  pub let KIND_TL_PARENT_NOTIF : u64 = 12

  // ============================================================================
  // Rights (subset legal on a KIND_HW_TIMELINE capability)
  // ============================================================================

  pub let R_TL_WAIT    : u64 = 0x01
  pub let R_TL_SIGNAL  : u64 = 0x02
  pub let R_TL_OBSERVE : u64 = 0x10
  pub let R_TL_REBIND  : u64 = 0x20
  pub let R_TL_REVOKE  : u64 = 0x40
  pub let R_TL_ALL     : u64 = 0x73

  // ============================================================================
  // Timeline source enumeration (row [+0] bits [47:32])
  // ============================================================================

  pub let TL_SOURCE_SW_FED      : u64 = 0
  pub let TL_SOURCE_GPU_SEQNO   : u64 = 1
  pub let TL_SOURCE_HDA_LPIB    : u64 = 2
  pub let TL_SOURCE_USB_SOF     : u64 = 3
  pub let TL_SOURCE_TSC_DERIVED : u64 = 4
  pub let TL_SOURCE_MAX         : u64 = 4

  // ============================================================================
  // Table caps + field domains
  // ============================================================================

  pub let HW_TIMELINE_MAX  : u64 = 64
  pub let TL_ROW_BYTES     : u64 = 32

  // Sentinel wait_head value meaning "empty list" (bits [47:32] of [+16]).
  pub let TL_WAIT_HEAD_EMPTY : u64 = 0xFFFF

  // ============================================================================
  // Return codes
  //
  // Block 0xFFFFFFC5..0xFFFFFFCF — disjoint from DMA_* (0xFFFFFFD1..
  // 0xFFFFFFDF), MSIX_* (0xFFFFFFE7..0xFFFFFFEF), and HW_INT_*
  // (0xFFFFFFF7..0xFFFFFFFF) so a witness failure names its originating
  // kind unambiguously.
  // ============================================================================

  pub let TL_MINT_OK           : u64 = 0
  pub let TL_MINT_BAD_SOURCE   : u64 = 0xFFFFFFCF
  pub let TL_MINT_BAD_RIGHTS   : u64 = 0xFFFFFFCE
  pub let TL_MINT_BAD_PARENT   : u64 = 0xFFFFFFCD
  pub let TL_MINT_BAD_NOTIF    : u64 = 0xFFFFFFCC
  pub let TL_MINT_ENOSPC       : u64 = 0xFFFFFFCB
  pub let TL_MINT_BAD_VIEW     : u64 = 0xFFFFFFCA

  pub let TL_REVOKE_OK         : u64 = 0
  pub let TL_REVOKE_BAD_SLOT   : u64 = 0xFFFFFFC9
  pub let TL_REVOKE_WRONG_KIND : u64 = 0xFFFFFFC8
  pub let TL_REVOKE_ALREADY    : u64 = 0xFFFFFFC7

  pub let TL_SIGNAL_OK            : u64 = 0
  pub let TL_SIGNAL_NONMONOTONIC  : u64 = 0xFFFFFFC6

  pub let TL_WAIT_OK      : u64 = 0
  pub let TL_WAIT_TIMEOUT : u64 = 0xFFFFFFC5
  pub let TL_WAIT_ABORTED : u64 = 0xFFFFFFC4

  // Standard dispatch-return sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // ============================================================================
  // Ops (op_arg[7:0] = op_code)
  // ============================================================================

  pub let TL_OP_SAMPLE          : u64 = 0   // R_TL_OBSERVE -> current counter
  pub let TL_OP_QUERY_SOURCE    : u64 = 1   // R_TL_OBSERVE -> source u64
  pub let TL_OP_QUERY_CLOCK_ID  : u64 = 2   // R_TL_OBSERVE -> clock_id
  pub let TL_OP_QUERY_LAST      : u64 = 3   // R_TL_OBSERVE -> last_signaled
  pub let TL_OP_QUERY_RESOLUTION : u64 = 4  // R_TL_OBSERVE -> resolution_ns
  pub let TL_OP_SIGNAL          : u64 = 5   // R_TL_SIGNAL  -> UNSUPPORTED (skeleton)
  pub let TL_OP_WAIT            : u64 = 6   // R_TL_WAIT    -> UNSUPPORTED (skeleton)
  pub let TL_OP_BIND_NOTIF      : u64 = 7   // R_TL_REBIND  -> UNSUPPORTED (skeleton)
  pub let TL_OP_SNAPSHOT_SIG    : u64 = 8   // R_TL_SIGNAL + R_TL_OBSERVE -> UNSUPPORTED

  // ============================================================================
  // Backing table (.bss, align 64)
  //
  // 64 rows * 32 bytes = 2048 bytes = 256 u64s. .bss zero-init means
  // every row starts with in_use=0 (byte 7 of the [+0] u64), which is
  // the free sentinel the real tl_tail_alloc (follow-up slice) will
  // scan for.
  // ============================================================================

  pub let mut _hw_timeline_table : [u64; 256] = uninit @align(64)

  // ============================================================================
  // Dispatch-chatter tag (.rodata)
  //
  // Declared in-module (rather than in tags.pdx) for the skeleton wave:
  // the stub body references exactly one tag and declaring it here
  // keeps the skeleton PR self-contained. The follow-up slice relocates
  // this symbol into tags.pdx alongside its siblings
  // (cap_hw_int_msg / cap_hw_msix_msg / cap_dma_dom_msg) and adds the
  // per-event fingerprint tags enumerated in design §5.1:
  //   TL MINT OK / TL SIGNAL OK / TL WAIT UNBLOCK / TL WAIT TIMEOUT /
  //   TL REVOKE OK / TL REGRESSION / TL SNAPSHOT.
  // ============================================================================

  pub let cap_hw_timeline_msg : [u8; 56] = "hardware timeline invocation [legacy: CAP INVOKE HW_TL]\0"

  // ============================================================================
  // tl_cap_mint(parent_slot, notif_slot, source, clock_id, rights,
  //             counter_view_pa) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - validate source <= TL_SOURCE_MAX
  //   - validate rights ⊆ R_TL_ALL
  //   - dual-parent gate: cap_table[parent_slot].kind == KIND_HW
  //     (hw-fed) or KIND_NOTIFICATION (sw-fed), parent carries MINT
  //   - validate notif_slot.kind == KIND_NOTIFICATION
  //   - for SW-fed: phys_alloc a 4 KiB counter page, zero it, record PA
  //   - for HW-fed: validate counter_view_pa is in the parent's reach
  //   - tl_tail_alloc populates the row + returns row_id
  //   - cap_table_claim with kind=0x143, target_ptr=row_id
  //   - map counter_view page into kernel + user aspaces
  //   - emit "TL MINT OK slot=0x<nn> hw=<0|1>" fingerprint
  //
  // SysV ABI: rdi=parent_slot, rsi=notif_slot, rdx=source, rcx=clock_id,
  //           r8=rights, r9=counter_view_pa.
  // ============================================================================

  pub let tl_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) (notif_slot: u64) (source: u64) (clock_id: u64)
       (rights: u64) (counter_view_pa: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D3 (#2520) skeleton: KIND_HW_TIMELINE mint entry. Emits klog_s1(INFO, SUBSYS_CAP_, cap_hw_timeline_msg) chatter so a boot-witness can observe the entry site is wired, and returns INVOKE_UNSUPPORTED (0xFF..FC). Real body deferred to the Wave 59 D3 follow-up slice per design/kernel/cap/kind-hw-timeline.md §2.1. RDI-preserve discipline: push callee's register args before klog_s1, pop after, matching every other kind_*.pdx handler. The six-arg signature is below SysV's 6-register cap (rdi/rsi/rdx/rcx/r8/r9) and does not force a stack spill.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hw_timeline_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // tl_cap_revoke(slot) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - cap_table[slot].kind == KIND_HW_TIMELINE check -> TL_REVOKE_WRONG_KIND
  //   - already-null slot -> TL_REVOKE_ALREADY
  //   - walk the row's wait list, abort each waiter + post its notif
  //   - unmap counter_view page from the holder's aspace (SW-fed only;
  //     HW-fed BAR mapping teardown is a parent-cap concern)
  //   - tl_tail_free zeroes the row
  //   - cap_table_clear(slot)
  //   - emit "TL REVOKE OK slot=0x<nn>" fingerprint
  // ============================================================================

  pub let tl_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D3 (#2520) skeleton: KIND_HW_TIMELINE revoke entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design §1.5. Leaf shape; no stack spill; klog_s1 is the only call.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hw_timeline_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // cap_timeline_signal(cap_slot, value) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will diverge by variant:
  //   * SW-fed path (fully kernel-mediated):
  //       - rights gate R_TL_SIGNAL
  //       - read current = [counter_view_pa]; reject if value <= current
  //         -> TL_SIGNAL_NONMONOTONIC
  //       - store value to [counter_view_pa]
  //       - walk wait_head list, wake waiters whose target <= value,
  //         post their paired KIND_NOTIFICATION
  //       - update last_signaled snapshot
  //       - emit "TL SIGNAL OK val=<n>" fingerprint
  //   * HW-fed path is NOT this entry: it bypasses the kernel entirely.
  //     See design §2.3; the driver issues `mfence; mov [view]; sfence`
  //     from userspace. This entrypoint for HW-fed caps either refuses
  //     (returning INVOKE_UNSUPPORTED) or routes to OP_SNAPSHOT_SIG for
  //     a kernel-mediated reconciliation (design §2.6).
  //
  // SysV ABI: rdi = cap_slot, rsi = value.
  // ============================================================================

  pub let cap_timeline_signal : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) (value: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D3 (#2520) skeleton: cap_timeline_signal entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design §2.2. The HW-fed fast path (mfence/mov/sfence from userspace) does NOT route through this function by design — this is the SW-fed path + the HW-fed reconciliation entry. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hw_timeline_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // cap_timeline_wait(cap_slot, target, timeout_us) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - rights gate R_TL_WAIT
  //   - sample t_arm from HPET/TSC
  //   - read current = [counter_view_pa]
  //   - if current >= target: emit "TL WAIT UNBLOCK val=<cur> waited_us=0"
  //     and return TL_WAIT_OK (fast path, no scheduler involvement)
  //   - else: allocate a waiter record {notif_slot, target, deadline},
  //     splice into wait_head list, emit "TL WAIT ARM slot=<ss> target=<n>",
  //     call notif_wait(notif_slot, timeout_us)
  //   - on wake: re-sample counter and HPET, emit either
  //     "TL WAIT UNBLOCK val=<n> waited_us=<Δ>" (TL_WAIT_OK) or
  //     "TL WAIT TIMEOUT val=<n> target=<n> waited_us=<Δ>" (TL_WAIT_TIMEOUT)
  //     or TL_WAIT_ABORTED on parent revoke.
  //
  // SysV ABI: rdi = cap_slot, rsi = target, rdx = timeout_us.
  // ============================================================================

  pub let cap_timeline_wait : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) (target: u64) (timeout_us: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D3 (#2520) skeleton: cap_timeline_wait entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design §2.5. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hw_timeline_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // cap_handler_hw_timeline(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch-handler shell. Will be installed by cap_invoke_dispatch
  // (follow-up slice) when descriptor.kind == 0x143. RDI=rights,
  // RSI=target_ptr, RDX=op_arg — matches every other kind_*.pdx handler.
  //
  // Skeleton: emits dispatch chatter and returns INVOKE_UNSUPPORTED for
  // every op. Op routing (TL_OP_SAMPLE / _QUERY_SOURCE / _CLOCK_ID /
  // _LAST / _RESOLUTION / SIGNAL / WAIT / BIND_NOTIF / SNAPSHOT_SIG)
  // lands in the follow-up slice per design §1.4.
  // ============================================================================

  pub let cap_handler_hw_timeline : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D3 (#2520) skeleton: KIND_HW_TIMELINE dispatch handler shell. Emits klog_s1(INFO, SUBSYS_CAP_, cap_hw_timeline_msg) chatter on entry and returns INVOKE_UNSUPPORTED for every op; op-code routing lands in the follow-up slice. Not yet wired into cap_invoke_dispatch (the follow-up slice adds `cmp rcx, 0x143; je call_kind_hw_timeline`). RDI-preserve discipline unneeded here because the stub does not read its args after the klog_s1 call.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hw_timeline_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }
}
