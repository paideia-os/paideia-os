// src/kernel/core/cap/kind_audio_route.pdx — R33.M5-002 (#1158)
//
// KIND_AUDIO_ROUTE = 0x161, derived over KIND_IPC_ENDPOINT (5).
//
// The authority to name ONE audio routing edge -- a directed connection
// from ONE source stream slot to ONE destination PCM slot, with a mixer
// gain (Q15 signed) and a mute bit. The audio supervisor holds one of
// these per active edge in its routing graph; a client that would ask
// the supervisor to "connect source X to dest Y at gain G" phrases the
// request against a route capability instead of against a pair of names,
// which is what makes "route to a stream I do not have authority to
// name" unrepresentable.
//
// =============================================================================
// §0  UNITS: GAIN IS Q15 SIGNED FIXED-POINT
// =============================================================================
//
// gain_q15 is a signed 16-bit fixed-point number in the range
// [-32768, +32767]. It is NOT dB, NOT millibel, NOT a linear multiplier
// in floating point. Two arithmetic units in one row would let a mix
// stage that thought in linear multipliers write a value the mixer's
// combine step reads as Q15 -- off by a factor no downstream limiter
// would recover. The route_table.pdx §Q15 arithmetic is the ONLY
// primitive that combines two gains, and it is saturating (see §3).
//
// mute is a single bit: 0 = passthrough gain, 1 = force zero output on
// this edge regardless of gain_q15.
//
// =============================================================================
// §1  LINEAR — STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS INSTALLED
// =============================================================================
//
// Same discipline as `kind_pcm_stream.pdx` §1. Five fields:
//
//   * route_key           — u64, non-zero. INHERITED from the parent
//                            endpoint's target_ptr[15:0] combined with a
//                            supplied route ordinal. ROW IDENTITY.
//   * source_stream_slot  — u8 (cap slot 0..255). MUST name a live
//                            KIND_PCM_STREAM at mint time. ROW IDENTITY.
//                            A source whose stream_slot could change
//                            would silently redirect one route to
//                            another producer.
//   * dest_pcm_slot       — u8 (cap slot 0..255). MUST name a live
//                            KIND_PCM_STREAM at mint time and MUST NOT
//                            equal source_stream_slot (a self-loop is
//                            refused). ROW IDENTITY.
//   * gain_q15            — signed 16-bit. DYNAMIC — updated by
//                            audio_route_set_gain. Bounded to Q15 range;
//                            values outside are REFUSED, not clamped.
//   * mute                — u8 (0 or 1). DYNAMIC — updated by
//                            audio_route_set_mute.
//
// =============================================================================
// §2  DERIVATION OVER KIND_IPC_ENDPOINT — EMPTY GATE FOR THE SIXTH TIME
// =============================================================================
//
// FIRST HALF: `cap_table[parent_slot].kind == KIND_IPC_ENDPOINT (5)`
// carrying RIGHT_MINT. Discriminates NOTHING on its own -- every endpoint
// in the machine is a KIND_IPC_ENDPOINT, the shell's stdout included.
// This is the same pattern KIND_PCM_STREAM, KIND_HID_EVENT, KIND_EC_QUERY
// et al. state.
//
// SECOND HALF: (a) inherited endpoint id from parent target_ptr[15:0]
// must be non-zero; (b) source_stream_slot must name a live
// KIND_PCM_STREAM; (c) dest_pcm_slot must name a live KIND_PCM_STREAM;
// (d) source_stream_slot != dest_pcm_slot (self-loop refused);
// (e) gain_q15 must decode as a valid Q15 signed value.
//
// UNIQUENESS: route_key must not already be held by a live row.
//
// =============================================================================
// §3  Q15 SATURATING ARITHMETIC LIVES IN route_table.pdx
// =============================================================================
//
// This module holds the CAPABILITY; the ROUTE TABLE holds the FABRIC.
// audio_route_set_gain validates a value; q15_add_sat lives in
// src/kernel/core/drivers/audio/route_table.pdx and is the ONLY
// primitive that combines two gains. Two Q15 adders would let one path
// saturate and the other wrap, and no downstream stage could tell them
// apart.
//
// =============================================================================
// §4  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================

module KindAudioRoute = structure {

  pub let KIND_AUDIO_ROUTE : u64 = 0x161
  pub let AUDIO_ROUTE_PARENT_KIND : u64 = 5  // = KIND_IPC_ENDPOINT

  // Q15 range. Signed 16-bit interpreted as fixed-point [-1, +1) with
  // 32767 representing very-nearly +1.
  pub let Q15_MIN : u64 = 0xFFFFFFFFFFFF8000  // -32768 as u64
  pub let Q15_MAX : u64 = 0x0000000000007FFF  // +32767

  pub let R_AUDIO_ROUTE_READ    : u64 = 0x001
  pub let R_AUDIO_ROUTE_REPORT  : u64 = 0x002
  pub let R_AUDIO_ROUTE_INVOKE  : u64 = 0x008
  pub let R_AUDIO_ROUTE_REVOKE  : u64 = 0x010
  pub let R_AUDIO_ROUTE_OBSERVE : u64 = 0x400
  pub let R_AUDIO_ROUTE_ALL     : u64 = 0x41B

  // Ops:
  //   0 QUERY_KEY      INVOKE  route_key
  //   1 QUERY_SOURCE   INVOKE  source_stream_slot
  //   2 QUERY_DEST     INVOKE  dest_pcm_slot
  //   3 QUERY_GAIN     INVOKE  gain_q15 (as u64, sign-extended)
  //   4 QUERY_MUTE     INVOKE  mute (0 or 1)
  //   5 QUERY_PARENT   INVOKE  parent slot
  //   6 DEBUG_PRINT    OBSERVE
  //   7 SET_GAIN       REPORT  new gain_q15 packed [23:8] as signed 16
  //   8 SET_MUTE       REPORT  new mute in bit 8
  pub let AUDIO_ROUTE_OP_QUERY_KEY    : u64 = 0
  pub let AUDIO_ROUTE_OP_QUERY_SOURCE : u64 = 1
  pub let AUDIO_ROUTE_OP_QUERY_DEST   : u64 = 2
  pub let AUDIO_ROUTE_OP_QUERY_GAIN   : u64 = 3
  pub let AUDIO_ROUTE_OP_QUERY_MUTE   : u64 = 4
  pub let AUDIO_ROUTE_OP_QUERY_PARENT : u64 = 5
  pub let AUDIO_ROUTE_OP_DEBUG_PRINT  : u64 = 6
  pub let AUDIO_ROUTE_OP_SET_GAIN     : u64 = 7
  pub let AUDIO_ROUTE_OP_SET_MUTE     : u64 = 8
  pub let AUDIO_ROUTE_OP_MAX          : u64 = 8

  // Failure taxonomy — 0xFFFFFEE0..0xFFFFFEEF.
  pub let AUDIO_ROUTE_OK                : u64 = 0
  pub let AUDIO_ROUTE_TAIL_ENOSPC       : u64 = 0xFFFFFEEF
  pub let AUDIO_ROUTE_TAIL_BAD_ARG      : u64 = 0xFFFFFEEE
  pub let AUDIO_ROUTE_MINT_BAD_PARENT   : u64 = 0xFFFFFEED
  pub let AUDIO_ROUTE_MINT_BAD_RIGHTS   : u64 = 0xFFFFFEEC
  pub let AUDIO_ROUTE_MINT_BAD_SOURCE   : u64 = 0xFFFFFEEB
  pub let AUDIO_ROUTE_MINT_BAD_DEST     : u64 = 0xFFFFFEEA
  pub let AUDIO_ROUTE_MINT_SELF_LOOP    : u64 = 0xFFFFFEE9
  pub let AUDIO_ROUTE_MINT_BAD_GAIN     : u64 = 0xFFFFFEE8
  pub let AUDIO_ROUTE_MINT_NO_ENDPOINT  : u64 = 0xFFFFFEE7
  pub let AUDIO_ROUTE_MINT_ENOSPC       : u64 = 0xFFFFFEE6
  pub let AUDIO_ROUTE_MINT_IN_USE       : u64 = 0xFFFFFEE5
  pub let AUDIO_ROUTE_BAD_SLOT          : u64 = 0xFFFFFEE4
  pub let AUDIO_ROUTE_WRONG_KIND        : u64 = 0xFFFFFEE3
  pub let AUDIO_ROUTE_REVOKE_ALREADY    : u64 = 0xFFFFFEE2
  pub let AUDIO_ROUTE_BAD_MUTE          : u64 = 0xFFFFFEE1

  pub let AUDIO_ROUTE_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let AUDIO_ROUTE_ROW_NONE   : u64 = 0xFF

  // ==========================================================================
  // Row table — 8 rows of 32 bytes.
  //
  //   [+0]  header (in_use[63:56], parent_slot[15:8])
  //   [+8]  route_key
  //   [+16] source_stream_slot[7:0] | dest_pcm_slot[15:8] | mute[16] | gain_q15[47:32]
  //   [+24] reserved
  // ==========================================================================

  pub let AUDIO_ROUTE_MAX       : u64 = 8
  pub let AUDIO_ROUTE_ROW_BYTES : u64 = 32

  pub let mut _audio_route_table : [u64; 32] = uninit @align(64)

  pub let mut _audio_route_stats : [u64; 8] = uninit @align(64)

  pub let AUDIO_ROUTE_ST_MINTS      : u64 = 0
  pub let AUDIO_ROUTE_ST_REVOKES    : u64 = 1
  pub let AUDIO_ROUTE_ST_SET_GAIN   : u64 = 2
  pub let AUDIO_ROUTE_ST_SET_MUTE   : u64 = 3
  pub let AUDIO_ROUTE_ST_IN_USE     : u64 = 4
  pub let AUDIO_ROUTE_ST_ENOSPC     : u64 = 5
  pub let AUDIO_ROUTE_ST_SELF_LOOP  : u64 = 6

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let audio_route_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): reset audio route rows and stats. Labels prefixed art_rs_.",
      block: {
        lea r10, [rip + _audio_route_table];
        xor rax, rax;
        xor rcx, rcx;
      art_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  art_rs_rows;

        lea r10, [rip + _audio_route_stats];
        xor rcx, rcx;
      art_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  art_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let audio_route_gain_valid : (u64) -> u64 !{} @{} =
    fn (g: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-002 (#1158): 1 iff g decodes as a valid Q15 signed 16-bit value ([-32768, 32767]). Sign-extended in u64: bits [63:16] must be all-zero (positive) or all-one (negative). Labels prefixed art_gv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        cmp rax, 0;
        je  art_gv_yes;                  // positive, top 48 bits zero
        mov r10, 0xFFFFFFFFFFFF;
        cmp rax, r10;
        je  art_gv_yes;                  // negative, top 48 bits all-one
        xor rax, rax;
        ret;
      art_gv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let audio_route_mute_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-002 (#1158): 1 iff m in {0, 1}. Labels prefixed art_mv_.",
      block: {
        cmp rdi, 1;
        ja  art_mv_no;
        mov rax, 1;
        ret;
      art_mv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let audio_route_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-002 (#1158): subset test against R_AUDIO_ROUTE_ALL. Labels prefixed art_rvv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne art_rvv_no;
        mov rax, 1;
        ret;
      art_rvv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let audio_route_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): increment counter. Labels prefixed art_nt_.",
      block: {
        cmp rdi, 8;
        jae art_nt_out;
        lea r10, [rip + _audio_route_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      art_nt_out:
        ret
      }
    } @no_frame

  pub let audio_route_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): read counter. Labels prefixed art_st_.",
      block: {
        cmp rdi, 8;
        jae art_st_zero;
        lea r10, [rip + _audio_route_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      art_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate.
  // ==========================================================================

  pub let audio_route_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): parent must be live KIND_IPC_ENDPOINT with RIGHT_MINT. Labels prefixed art_cp_.",
      block: {
        cmp rdi, 256;
        jae art_cp_no;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne art_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  art_cp_no;

        mov rax, 1;
        ret;
      art_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let audio_route_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): endpoint_id from parent target_ptr[15:0]. Zero on failure. Labels prefixed art_pei_.",
      block: {
        cmp rdi, 256;
        jae art_pei_zero;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne art_pei_zero;

        mov rax, [rax + 16];
        mov r11, 0xFFFF;
        and rax, r11;
        ret;
      art_pei_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // audio_route_pcm_valid(slot) -> 1 | 0
  //
  // Delegates to pcm_stream_row_of_slot; NONE means the slot is not a
  // live KIND_PCM_STREAM.
  // ==========================================================================

  pub let audio_route_pcm_valid : (u64) -> u64 !{mem} @{cap} =
    fn (pcm_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): 1 iff pcm_slot names a live KIND_PCM_STREAM. Labels prefixed art_pv_.",
      block: {
        push r12;
        push r13;
        push r14;
        call pcm_stream_row_of_slot;
        cmp rax, 0xFF;
        je  art_pv_no;
        mov rax, 1;
        jmp art_pv_out;
      art_pv_no:
        xor rax, rax;
      art_pv_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let audio_route_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-002 (#1158): pack (parent_slot << 8). Labels prefixed art_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae art_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      art_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // Pack src[7:0] | dst[15:8] | mute[16] | gain_q15[47:32].
  pub let audio_route_body_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (src: u64) (dst: u64) (mute: u64) (gain: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-002 (#1158): pack body word. Refuses out-of-range values. Labels prefixed art_bp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae art_bp_bad;
        cmp rsi, r10;
        jae art_bp_bad;
        cmp rdx, 1;
        ja  art_bp_bad;

        // Validate gain_q15 range: bits [63:16] must be all-zero or all-one.
        mov rax, rcx;
        shr rax, 16;
        cmp rax, 0;
        je  art_bp_gain_ok;
        mov r11, 0xFFFFFFFFFFFF;
        cmp rax, r11;
        je  art_bp_gain_ok;
        jmp art_bp_bad;

      art_bp_gain_ok:
        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 1;
        shl r10, 16;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      art_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc/free.
  // ==========================================================================

  pub let audio_route_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (route_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): claim one audio route row. Labels prefixed art_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // route_key
        mov r14, rdx;                    // body_packed

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne art_ta_bad;

        cmp r13, 0;
        je  art_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  art_ta_bad;

        xor rbx, rbx;
      art_ta_scan:
        cmp rbx, 8;
        jae art_ta_enospc;

        lea r10, [rip + _audio_route_table];
        mov r11, rbx;
        shl r11, 5;                      // *32
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  art_ta_claim;

        add rbx, 1;
        jmp art_ta_scan;

      art_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp art_ta_out;

      art_ta_enospc:
        mov rax, 0xFFFFFEEF;
        jmp art_ta_out;
      art_ta_bad:
        mov rax, 0xFFFFFEEE;

      art_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_route_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): 1 iff row_id < MAX and in_use. Labels prefixed art_tv_.",
      block: {
        cmp rdi, 8;
        jae art_tv_no;
        lea r10, [rip + _audio_route_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  art_tv_no;
        mov rax, 1;
        ret;
      art_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let audio_route_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): scrub one row. Labels prefixed art_tf_.",
      block: {
        cmp rdi, 8;
        jae art_tf_out;
        lea r10, [rip + _audio_route_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      art_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let audio_route_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): route_key. Labels prefixed art_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_rk_bad;
        lea r10, [rip + _audio_route_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp art_rk_out;
      art_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_row_source : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): source_stream_slot. Labels prefixed art_rs_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_rs_bad;
        lea r10, [rip + _audio_route_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp art_rs_out;
      art_rs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_rs_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_row_dest : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): dest_pcm_slot. Labels prefixed art_rd_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_rd_bad;
        lea r10, [rip + _audio_route_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFF;
        jmp art_rd_out;
      art_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_rd_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_row_mute : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): mute bit. Labels prefixed art_rm_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_rm_bad;
        lea r10, [rip + _audio_route_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 1;
        jmp art_rm_out;
      art_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_rm_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_row_gain : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): gain_q15 as u64 (bits [15:0] of return). Sign-extended for negative values. Labels prefixed art_rg_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_rg_bad;
        lea r10, [rip + _audio_route_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        // Sign-extend from 16 bits.
        mov r11, rax;
        shr r11, 15;
        cmp r11, 0;
        je  art_rg_out;
        mov r11, 0xFFFFFFFFFFFF0000;
        or  rax, r11;
        jmp art_rg_out;
      art_rg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_rg_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): parent slot. Labels prefixed art_rpa_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_rpa_bad;
        lea r10, [rip + _audio_route_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp art_rpa_out;
      art_rpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_rpa_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let audio_route_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (route_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M5-002 (#1158): live row holding this route_key, or ROW_NONE. Labels prefixed art_fk_.",
      block: {
        cmp rdi, 0;
        je  art_fk_none;
        xor rcx, rcx;
      art_fk_scan:
        cmp rcx, 8;
        jae art_fk_none;
        lea r10, [rip + _audio_route_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  art_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  art_fk_hit;
      art_fk_next:
        add rcx, 1;
        jmp art_fk_scan;
      art_fk_hit:
        mov rax, rcx;
        ret;
      art_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let audio_route_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): slot -> row_id. ARITY ONE. Labels prefixed art_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae art_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x161;
        cmp r10, r11;
        jne art_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_ros_none;

        mov rax, r12;
        jmp art_ros_out;

      art_ros_none:
        mov rax, 0xFF;
      art_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_source_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): source_stream_slot of the route this cap names. ARITY ONE. Labels prefixed art_sos_.",
      block: {
        push r12; push r13; push r14;
        call audio_route_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  art_sos_bad;
        mov rdi, r12;
        call audio_route_row_source;
        jmp art_sos_out;
      art_sos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_sos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_dest_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): dest_pcm_slot of the route this cap names. ARITY ONE. Labels prefixed art_dos_.",
      block: {
        push r12; push r13; push r14;
        call audio_route_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  art_dos_bad;
        mov rdi, r12;
        call audio_route_row_dest;
        jmp art_dos_out;
      art_dos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_dos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_gain_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): gain_q15 of the route this cap names. ARITY ONE. Labels prefixed art_gos_.",
      block: {
        push r12; push r13; push r14;
        call audio_route_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  art_gos_bad;
        mov rdi, r12;
        call audio_route_row_gain;
        jmp art_gos_out;
      art_gos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_gos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let audio_route_mute_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): mute of the route this cap names. ARITY ONE. Labels prefixed art_mos_.",
      block: {
        push r12; push r13; push r14;
        call audio_route_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  art_mos_bad;
        mov rdi, r12;
        call audio_route_row_mute;
        jmp art_mos_out;
      art_mos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      art_mos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // audio_route_set_gain(slot, gain) -> OK | BAD_SLOT | BAD_GAIN
  // audio_route_set_mute(slot, mute) -> OK | BAD_SLOT | BAD_MUTE
  //
  // ARITY TWO — a capability and one new value. Labels prefixed art_sg_ / art_sm_.
  // ==========================================================================

  pub let audio_route_set_gain : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (gain: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): gain_q15 = gain (validated). ARITY TWO. Labels prefixed art_sg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // new gain

        call audio_route_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  art_sg_bad_slot;

        mov rdi, r12;
        call audio_route_gain_valid;
        cmp rax, 0;
        je  art_sg_bad_gain;

        lea r10, [rip + _audio_route_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 16];
        // clear bits [47:32].
        mov r11, 0xFFFF00000000;
        not r11;
        and rax, r11;
        // OR in new gain[15:0] shifted to [47:32].
        mov r11, r12;
        and r11, 0xFFFF;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov rdi, 2;                      // ST_SET_GAIN
        call audio_route_note;

        xor rax, rax;
        jmp art_sg_out;

      art_sg_bad_slot:
        mov rax, 0xFFFFFEE4;
        jmp art_sg_out;
      art_sg_bad_gain:
        mov rax, 0xFFFFFEE8;

      art_sg_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_route_set_mute : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (mute: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): mute = new value (0 or 1). ARITY TWO. Labels prefixed art_sm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // new mute

        call audio_route_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  art_sm_bad_slot;

        mov rdi, r12;
        call audio_route_mute_valid;
        cmp rax, 0;
        je  art_sm_bad_mute;

        lea r10, [rip + _audio_route_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 16];
        // clear bit 16.
        mov r11, 0x10000;
        not r11;
        and rax, r11;
        // OR in new mute[0] shifted to [16].
        mov r11, r12;
        and r11, 1;
        shl r11, 16;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov rdi, 3;                      // ST_SET_MUTE
        call audio_route_note;

        xor rax, rax;
        jmp art_sm_out;

      art_sm_bad_slot:
        mov rax, 0xFFFFFEE4;
        jmp art_sm_out;
      art_sm_bad_mute:
        mov rax, 0xFFFFFEE1;

      art_sm_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Mint.
  //
  // audio_route_cap_mint_inner(slot, parent_slot, rights, source_stream_slot,
  //                             dest_pcm_slot, body_packed)
  // ==========================================================================

  pub let audio_route_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (source_stream_slot: u64) (dest_pcm_slot: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): mint a KIND_AUDIO_ROUTE over KIND_IPC_ENDPOINT. Sequence: (1) slot < 256 else BAD_SLOT. (2) check_parent -> BAD_PARENT. (3) rights_valid -> BAD_RIGHTS. (4) source_stream_slot < 256, audio_route_pcm_valid -> BAD_SOURCE. (5) dest_pcm_slot < 256, audio_route_pcm_valid -> BAD_DEST. (6) source != dest -> SELF_LOOP. (7) body_packed != DECODE_BAD -> BAD_GAIN. (8) INHERIT endpoint_id -> NO_ENDPOINT if zero. (9) UNIQUENESS on route_key = endpoint_id | (slot << 32) -> IN_USE. (10) hdr_pack + tail_alloc. (11) cap_mint_write. Labels prefixed art_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // source_stream_slot
        mov r15, r8;                     // dest_pcm_slot
        mov rbp, r9;                     // body_packed

        mov r10, 256;
        cmp rbx, r10;
        jae art_mi_bad_slot;

        mov rdi, r12;
        call audio_route_check_parent;
        cmp rax, 0;
        je  art_mi_bad_parent;

        mov rdi, r13;
        call audio_route_rights_valid;
        cmp rax, 0;
        je  art_mi_bad_rights;

        mov r10, 256;
        cmp r14, r10;
        jae art_mi_bad_source;
        mov rdi, r14;
        call audio_route_pcm_valid;
        cmp rax, 0;
        je  art_mi_bad_source;

        mov r10, 256;
        cmp r15, r10;
        jae art_mi_bad_dest;
        mov rdi, r15;
        call audio_route_pcm_valid;
        cmp rax, 0;
        je  art_mi_bad_dest;

        cmp r14, r15;
        je  art_mi_self_loop_note;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rbp, r10;
        je  art_mi_bad_gain;

        mov rdi, r12;
        call audio_route_parent_eid;
        cmp rax, 0;
        je  art_mi_no_endpoint;

        // route_key = endpoint_id | (slot << 32)
        mov r10, rbx;
        shl r10, 32;
        or  r10, rax;                    // r10 = route_key
        push r10;
        sub rsp, 8;

        mov rdi, r10;
        call audio_route_find_by_key;
        add rsp, 8;
        pop r10;
        cmp rax, 0xFF;
        jne art_mi_in_use_note;

        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call audio_route_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  art_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // route_key
        mov rdx, rbp;                    // body_packed
        call audio_route_tail_alloc;

        mov r10, 0xFFFFFEEF;
        cmp rax, r10;
        je  art_mi_enospc;
        mov r10, 0xFFFFFEEE;
        cmp rax, r10;
        je  art_mi_bad_gain;

        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x161;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;

        mov rdi, 0;                      // ST_MINTS
        call audio_route_note;

        xor rax, rax;
        jmp art_mi_out;

      art_mi_in_use_note:
        mov rdi, 4;                      // ST_IN_USE
        call audio_route_note;
        mov rax, 0xFFFFFEE5;
        jmp art_mi_out;

      art_mi_self_loop_note:
        mov rdi, 6;                      // ST_SELF_LOOP
        call audio_route_note;
        mov rax, 0xFFFFFEE9;
        jmp art_mi_out;

      art_mi_bad_slot:
        mov rax, 0xFFFFFEE4;
        jmp art_mi_out;
      art_mi_bad_parent:
        mov rax, 0xFFFFFEED;
        jmp art_mi_out;
      art_mi_bad_rights:
        mov rax, 0xFFFFFEEC;
        jmp art_mi_out;
      art_mi_bad_source:
        mov rax, 0xFFFFFEEB;
        jmp art_mi_out;
      art_mi_bad_dest:
        mov rax, 0xFFFFFEEA;
        jmp art_mi_out;
      art_mi_bad_gain:
        mov rax, 0xFFFFFEE8;
        jmp art_mi_out;
      art_mi_no_endpoint:
        mov rax, 0xFFFFFEE7;
        jmp art_mi_out;
      art_mi_enospc:
        mov rdi, 5;                      // ST_ENOSPC
        call audio_route_note;
        mov rax, 0xFFFFFEE6;

      art_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let audio_route_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): revoke a KIND_AUDIO_ROUTE. Labels prefixed art_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae art_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  art_rvk_already;

        mov r11, 0x161;
        cmp r10, r11;
        jne art_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call audio_route_tail_valid;
        cmp rax, 0;
        je  art_rvk_clear;

        mov rdi, r13;
        call audio_route_tail_free;

      art_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;                      // ST_REVOKES
        call audio_route_note;

        xor rax, rax;
        jmp art_rvk_out;

      art_rvk_bad_slot:
        mov rax, 0xFFFFFEE4;
        jmp art_rvk_out;
      art_rvk_wrong_kind:
        mov rax, 0xFFFFFEE3;
        jmp art_rvk_out;
      art_rvk_already:
        mov rax, 0xFFFFFEE2;

      art_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_route_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call audio_route_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x161;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch.
  // ==========================================================================

  pub let cap_handler_audio_route : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M5-002 (#1158): KIND_AUDIO_ROUTE dispatch handler. row_id = target_ptr[15:0], slot = target_ptr[31:16]; op = op_arg[7:0]. QUERY_* need INVOKE; DEBUG_PRINT needs OBSERVE; SET_GAIN and SET_MUTE need REPORT. Labels prefixed art_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_audio_route_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op

        cmp rbp, 8;
        ja  art_hn_unsup;

        cmp rbp, 7;
        je  art_hn_set_gain;
        cmp rbp, 8;
        je  art_hn_set_mute;

        cmp rbp, 6;
        je  art_hn_dbg;

        // Queries: reserved bits [63:8] must be zero.
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne art_hn_res;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  art_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  art_hn_key;
        cmp rbp, 1;
        je  art_hn_src;
        cmp rbp, 2;
        je  art_hn_dst;
        cmp rbp, 3;
        je  art_hn_gn;
        cmp rbp, 4;
        je  art_hn_mt;
        call audio_route_row_parent;
        jmp art_hn_out;

      art_hn_set_gain:
        // op_arg[23:8] = new gain (signed 16 as u16); [63:24] reserved zero.
        mov r11, r14;
        shr r11, 24;
        cmp r11, 0;
        jne art_hn_res;

        mov r15, r14;
        shr r15, 8;
        and r15, 0xFFFF;
        // Sign-extend from 16 bits.
        mov r11, r15;
        shr r11, 15;
        cmp r11, 0;
        je  art_hn_sg_ok;
        mov r11, 0xFFFFFFFFFFFF0000;
        or  r15, r11;
      art_hn_sg_ok:

        mov r10, r12;
        and r10, 0x002;
        cmp r10, 0;
        je  art_hn_denied;

        mov rdi, rbx;
        mov rsi, r15;
        call audio_route_set_gain;
        jmp art_hn_out;

      art_hn_set_mute:
        // op_arg[8] = new mute; [63:9] reserved zero.
        mov r11, r14;
        shr r11, 9;
        cmp r11, 0;
        jne art_hn_res;

        mov r15, r14;
        shr r15, 8;
        and r15, 1;

        mov r10, r12;
        and r10, 0x002;
        cmp r10, 0;
        je  art_hn_denied;

        mov rdi, rbx;
        mov rsi, r15;
        call audio_route_set_mute;
        jmp art_hn_out;

      art_hn_key:
        call audio_route_row_key;
        jmp art_hn_out;
      art_hn_src:
        call audio_route_row_source;
        jmp art_hn_out;
      art_hn_dst:
        call audio_route_row_dest;
        jmp art_hn_out;
      art_hn_gn:
        call audio_route_row_gain;
        jmp art_hn_out;
      art_hn_mt:
        call audio_route_row_mute;
        jmp art_hn_out;

      art_hn_dbg:
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne art_hn_res;
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  art_hn_denied;
        xor rax, rax;
        jmp art_hn_out;

      art_hn_res:
        mov rax, 0xFFFFFEEE;
        jmp art_hn_out;
      art_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp art_hn_out;
      art_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      art_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
