// src/kernel/core/cap/kind_seat.pdx -- R113.M5-025 (paideia-os #2405)
//
// KIND_SEAT = 0x1BF kernel-side substrate (row pool + create + destroy +
// bind-kbd + bind-ptr).
//
// PURPOSE.  A per-physical-seat capability that names the input-device
// collection bound to one physical seat (per-seat surface tree +
// input group binding).  A seat carries:
//
//   * 1 keyboard focus surface slot (the KIND_SURFACE row receiving
//     keyboard events from THIS seat's keyboard device group),
//   * 1 pointer focus surface slot  (the KIND_SURFACE row receiving
//     pointer events from THIS seat's pointer device group),
//   * 1 touch focus surface slot    (the KIND_SURFACE row receiving
//     touch events from THIS seat's touch device group),
//   * 1 session cap reference       (the KIND_SESSION row this seat
//     belongs to; multi-seat kiosk has one session per seat, typical
//     desktop has one seat per session).
//
// A single-seat workstation gets seat 0 minted at boot (see §8 kind_
// seat_init) and never touches this substrate again.  A multi-seat
// kiosk extends by calling seat_create for each additional physical
// seat post-boot, each attached to its own KIND_SESSION.  The
// per-seat focus roots are the substrate the compositor's multi-seat
// input dispatcher (a follow-on landing) reads to steer HID reports
// -- distinct from the SINGLE-SEAT-mode _kbd_focus_slot / _ptr_focus_
// slot cells in src/kernel/core/graphics/focus.pdx which the input
// dispatcher will bridge from seat 0's per-seat state in the common
// single-seat case.
//
// This landing is the KERNEL-SIDE mechanism.  Policy (which seats
// exist on this hardware, which physical devices attach to which
// seat, seat-to-session bindings at login time) lives in the follow-
// on seat-manager / display-manager landings that call seat_create +
// seat_bind_kbd + seat_bind_ptr through the cap dispatcher's KIND_
// SEAT arm (not yet landed).
//
// IDENTITY CHOICE -- seat_id == row_id (slot).  Same identity discipline
// as kind_session (session_id == row_id) and kind_capture (capture_id
// == row_id).  The LAM generation on row+0 invalidates a stale handle
// to a reused slot; a distinct monotonic-id space would double the
// state and buy nothing.  The fingerprint's `id=<n>` therefore emits
// the slot index.
//
// KERNEL vs. USER KIND_SEAT NAMING.  A USERSPACE-side KIND_SEAT lives
// at 0x1D6 (src/user/input_server/seat_kind.pdx, B8-06 landing) --
// that is the Wayland-vocabulary seat cap the compositor speaks to
// its clients.  This kernel-side KIND_SEAT_ID = 0x1BF is the kernel
// substrate that the input dispatcher reads; the two are distinct
// capabilities in distinct KIND-ID ranges (0x1B0-band vs. 0x1D0-
// band).  The follow-on kernel<->userspace seat bridge lands a
// KIND_SEAT_KHANDLE derivation that pairs a kernel seat_id with a
// user-side KIND_SEAT for the input-server holder.
//
// SCOPE OF THIS LANDING (per issue #2405):
//   * Substrate: row pool (SEAT_ROW_MAX = 8 rows * 64 bytes = 512 B),
//     _seat_stats[8], and the init leaf that scrubs both.
//   * Ops: seat_create(session_slot, name_ptr) -> seat_id | error,
//          seat_destroy(seat_id),
//          seat_bind_kbd(seat_id, surface_slot),
//          seat_bind_ptr(seat_id, surface_slot).
//   * Fingerprint: `SEAT CREATE OK id=<n> session=<n>` via klog_s1_x2
//     (two-KV tag).  Destroy / bind-kbd / bind-ptr DO NOT emit
//     fingerprints -- the create tag is the only R113.M5-025 boot-
//     witness anchor per the issue's fingerprint contract, matching
//     kind_session / kind_capture mint-only emit posture.
//   * Row accessors (seat_row_valid / seat_row_addr / seat_row_session_
//     get / seat_row_kbd_get / seat_row_ptr_get / seat_row_touch_get /
//     seat_row_name_get) as pure leaves for consumers in the follow-on
//     seat-manager and input-dispatcher landings.
//   * Default seat 0 mint at boot: kind_seat_init scrubs the pool
//     then calls seat_create(0, &default_seat_name) so a single-seat
//     kernel already has seat 0 available before any real seat-
//     manager landing runs.  This emits SEAT CREATE OK id=0 session=0
//     as a boot fingerprint witness -- the R113.M5-025 landing's only
//     required boot artifact.
//
// DERIVED-KIND POSITIONING.  KIND_SEAT derives from KIND_IPC_ENDPOINT
// (= 5) in the abstract graph -- a seat is a rendez-vous between the
// display manager (holds MINT + BIND_KBD + BIND_PTR), the input-
// dispatcher / compositor (holds READ + OBSERVE), and a lock-agent
// (holds no direct rights but observes _kbd_focus_slot on the
// bound session's active seat).  The concrete substrate parent is
// nil (this kind is the root of the seat sub-graph; kind_session's
// seat_slot_bitmap indexes INTO the seat pool, seats do not derive
// FROM sessions).
//
// KIND-ID SLOT ALLOCATION -- 0x1BF.
//   0x1BC  KIND_SESSION             (R113.M5-022)
//   0x1BD  KIND_FRAME_CAPTURE (R113.M7-032 landed 2026-09-08)
//   0x1BE  KIND_CAPTURE             (R113.M7-036)
//   0x1BF  KIND_SEAT                (THIS LANDING, R113.M5-025)
//
// A tree-wide grep for `= 0x1BF` across src/**/*.pdx returns zero
// declarations before this landing (verified at landing time; the
// only nearby mentions are the reserved-range comments in
// kind_session.pdx L73, kind_capture.pdx L56, and kind.pdx L3243
// which name 0x1B2..0x1BF as the R101 G7+ reserved band).  The
// userspace-side KIND_SEAT at 0x1D6 (src/user/input_server/seat_
// kind.pdx L159) is a distinct capability in a distinct KIND-ID
// range and does not collide.
//
// FAILURE BAND -- 0xFFFFE2E0..0xFFFFE2EF.  Verified free by tree-wide
// grep for 0xFFFFE2E* against src/**/*.pdx (empty match at landing
// time); allocated per the issue's pre-assigned band directive.
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+):
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- row-offset math uses `shl r, 6` for *64.
//   * No `and reg, imm64` -- the 56-bit gen mask (0x00FFFFFFFFFFFFFF)
//     is staged through `mov r9, imm64` then `and r11, r9`.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement form `[reg + 8N]`
//     used throughout; register-scaled `[reg + rcx * 8]` (SIB-legal
//     scale) is used only in the stats bumpers and init scrub.
//   * No `mov qword [mem], imm64` -- FOCUS_NONE sentinel writes stage
//     the imm64 into a scratch register (movabs) then store.
//   * Reserved-keyword labels avoided (loop/if/let/while/for/match/pub/
//     mod/use/fn/struct/enum/impl/trait/type/where/move/mut/ref).
//     Label prefixes:  seat_init_  seat_bc_  seat_bv_  seat_br_
//                      seat_bk_    seat_bp_  seat_c_   seat_d_
//                      seat_bindk_ seat_bindp_
//                      seat_rv_    seat_ra_  seat_rss_ seat_rk_
//                      seat_rp_    seat_rt_  seat_rn_
//
// STACK DISCIPLINE (create path calls klog_s1_x2 with a v2 stack push).
// The v2-push idiom is lifted verbatim from src/kernel/core/fs/pdxfs/
// wal.pdx wal_fs_bdev_flush (L1058-1061), same as kind_session's mint:
//     sub rsp, 8;      // pad to keep rsp%16==0 after the push
//     push <v2>;       // seventh klog arg
//     call klog_s1_x2;
//     add rsp, 16;     // undo pad + push in one shot
// The create prologue lands rsp%16 == 0 before the sub/push pair via
// 2 callee-save pushes (rbx, r12) + sub rsp,8 pad matching kind_
// session's mint discipline one-for-one.

module KindSeat = structure {

  // ==========================================================================
  // SECTION 1 -- IDENTITY + PARENT + POOL CEILING
  // ==========================================================================

  pub let KIND_SEAT_ID     : u64 = 0x1BF
  pub let KIND_SEAT_BASE   : u64 = 5           // = KIND_IPC_ENDPOINT

  // Pool ceiling.  8 concurrent seats covers: (a) typical single-seat
  // desktop (1 seat), (b) dual-seat kiosk (2 seats, one session each),
  // (c) 3-4 seat conference-room shared workstation, (d) 4+ headroom
  // for chained multi-seat login-multiplexing scenarios.  Matches the
  // SEAT_MAX = 8 ceiling that kind_session.pdx L21 already cites as
  // its seat_slot_bitmap headroom target.  8 * 64 = 512 bytes -- one
  // eighth-page slab, half the SESSION_ROW_MAX / SURFACE_ROW_MAX pool.
  pub let SEAT_ROW_MAX     : u64 = 8
  pub let SEAT_ROW_BYTES   : u64 = 64
  pub let SEAT_ROW_WORDS   : u64 = 8

  // ==========================================================================
  // SECTION 2 -- RIGHTS
  // ==========================================================================
  //
  // Rights split so a display manager (holds MINT + BIND_KBD + BIND_PTR
  // + DESTROY) is distinct from an input dispatcher (holds READ +
  // OBSERVE) is distinct from a lock agent (holds no seat rights, only
  // observes via the session graph).  R_SEAT_READ / _OBSERVE are the
  // introspection rights a status-bar widget uses to name the active
  // seat.
  //
  //   R_SEAT_READ       -- read seat_id, session_slot, focus roots, name
  //   R_SEAT_BIND_KBD   -- change kbd_focus_slot on the seat row
  //   R_SEAT_BIND_PTR   -- change ptr_focus_slot on the seat row
  //   R_SEAT_DESTROY    -- revoke the seat row
  //   R_SEAT_MINT       -- derive a child seat (future)
  //   R_SEAT_OBSERVE    -- introspection (per-seat focus enumeration)

  pub let R_SEAT_READ      : u64 = 0x001
  pub let R_SEAT_BIND_KBD  : u64 = 0x008
  pub let R_SEAT_BIND_PTR  : u64 = 0x010
  pub let R_SEAT_DESTROY   : u64 = 0x020
  pub let R_SEAT_MINT      : u64 = 0x200
  pub let R_SEAT_OBSERVE   : u64 = 0x400
  pub let R_SEAT_ALL       : u64 = 0x639
    // 0x001 | 0x008 | 0x010 | 0x020 | 0x200 | 0x400 = 0x639

  // ==========================================================================
  // SECTION 3 -- ROW LAYOUT OFFSETS + FOCUS SENTINEL
  // ==========================================================================
  //
  //   +0   hdr        in_use[63:56] | generation[55:0]  (56-bit LAM ABA)
  //   +8   seat_id    (u64; == row_id, mirrored for legibility)
  //   +16  session_slot (u64; the KIND_SESSION row this seat is bound to;
  //                     stored opaque -- session liveness is not checked
  //                     here (the boot-time default seat 0 mint predates
  //                     any KIND_SESSION mint, so a liveness check would
  //                     fail; the follow-on seat-manager landing verifies
  //                     via session_row_valid before real user-visible
  //                     minting).  A range check `session_slot <
  //                     SESSION_ROW_MAX(16)` catches typo-level errors.)
  //   +24  kbd_focus_slot (u64; the KIND_SURFACE row receiving keyboard
  //                       events from THIS seat's keyboard device group;
  //                       SEAT_FOCUS_NONE = 0xFFFFFFFFFFFFFFFF means
  //                       unfocused.  Set by seat_bind_kbd.)
  //   +32  ptr_focus_slot (u64; the KIND_SURFACE row receiving pointer
  //                       events from THIS seat's pointer device group;
  //                       SEAT_FOCUS_NONE = unfocused.  Set by seat_
  //                       bind_ptr.)
  //   +40  touch_focus_slot (u64; the KIND_SURFACE row receiving touch
  //                       events from THIS seat's touch device group;
  //                       SEAT_FOCUS_NONE = unfocused.  No dedicated
  //                       bind op in this landing -- follow-on
  //                       seat_bind_touch will land alongside the M3
  //                       touch-routing bring-up.)
  //   +48  name_ptr   (u64; pointer to a UTF-8 NUL-terminated name
  //                    string; 0 = unnamed seat.  Stored opaque; the
  //                    substrate does not validate the pointer.)
  //   +56  reserved   (future: seat_class or capability-bitmap for
  //                   video/audio/haptic per-seat routing)

  pub let SEAT_OFF_HDR       : u64 = 0
  pub let SEAT_OFF_SEAT_ID   : u64 = 8
  pub let SEAT_OFF_SESSION   : u64 = 16
  pub let SEAT_OFF_KBD_FOCUS : u64 = 24
  pub let SEAT_OFF_PTR_FOCUS : u64 = 32
  pub let SEAT_OFF_TOUCH_FOCUS : u64 = 40
  pub let SEAT_OFF_NAME_PTR  : u64 = 48
  pub let SEAT_OFF_RESERVED1 : u64 = 56

  // Focus-none sentinel: outside u64 slot-id domain (SURFACE_ROW_MAX is
  // 16 today, ~48 at compositor maturity).  Matches focus.pdx FOCUS_
  // NONE one-for-one -- kept local to keep this file free of a symbolic
  // dependency on focus.pdx (small integer constant, easier to inline
  // than plumb across modules; kbd_route.pdx duplicates the same
  // sentinel for the same reason).
  pub let SEAT_FOCUS_NONE    : u64 = 0xFFFFFFFFFFFFFFFF

  // Session-slot ceiling (matches SESSION_ROW_MAX from kind_session.pdx).
  // Range gate only; liveness gate is the follow-on seat-manager's
  // responsibility (see §3 SESSION_SLOT rationale).
  pub let SEAT_SESSION_SLOT_MAX : u64 = 16

  // ==========================================================================
  // SECTION 4 -- FAILURE TAXONOMY -- 0xFFFFE2E0..0xFFFFE2EF
  // ==========================================================================
  //
  // Verified free by tree-wide grep for 0xFFFFE2E* against src/**/*.pdx
  // (empty match) at landing time.

  pub let SEAT_OK                     : u64 = 0
  pub let SEAT_TAIL_ENOSPC            : u64 = 0xFFFFE2EF
  pub let SEAT_CREATE_BAD_SESSION     : u64 = 0xFFFFE2EE
  pub let SEAT_BAD_SLOT               : u64 = 0xFFFFE2ED
  pub let SEAT_DESTROY_ALREADY        : u64 = 0xFFFFE2EC
  pub let SEAT_BIND_BAD_SURFACE       : u64 = 0xFFFFE2EB
  pub let SEAT_GEN_MISMATCH           : u64 = 0xFFFFE2EA
  pub let SEAT_BAD_ARG                : u64 = 0xFFFFE2E9
  pub let SEAT_WRONG_KIND             : u64 = 0xFFFFE2E8
  pub let SEAT_UNSUP_OP               : u64 = 0xFFFFE2E7
  pub let SEAT_BAD_RIGHTS             : u64 = 0xFFFFE2E6
  pub let SEAT_ROW_NONE               : u64 = 0xFFFFE2E5
  pub let SEAT_MINT_BAD_RIGHTS        : u64 = 0xFFFFE2E4
  pub let SEAT_RESERVED_2E3           : u64 = 0xFFFFE2E3
  pub let SEAT_RESERVED_2E2           : u64 = 0xFFFFE2E2
  pub let SEAT_RESERVED_2E1           : u64 = 0xFFFFE2E1
  pub let SEAT_DECODE_BAD             : u64 = 0xFFFFE2E0

  // ==========================================================================
  // SECTION 5 -- POOL SUBSTRATE
  // ==========================================================================
  //
  // 8 rows * 64 bytes = 512 bytes = 64 u64 words.  Stats table sized to
  // 8 slots to leave headroom for follow-on landings (a per-op denials
  // counter, a bind-touch bumper).  Pool named `_seats` per issue #2405
  // contract (kind_session's parallel pool is `_sessions`; kind_capture's
  // is `_captures`).

  pub let mut _seats        : [u64; 64] = uninit @align(64)   // 8 * 8
  pub let mut _seat_stats   : [u64; 8]  = uninit @align(64)

  pub let SEAT_ST_CREATES   : u64 = 0
  pub let SEAT_ST_DESTROYS  : u64 = 1
  pub let SEAT_ST_REFUSED   : u64 = 2
  pub let SEAT_ST_BIND_KBD  : u64 = 3
  pub let SEAT_ST_BIND_PTR  : u64 = 4
  pub let SEAT_ST_MAX       : u64 = 8

  // ==========================================================================
  // SECTION 6 -- FINGERPRINT TAG + KV KEY NAMES + DEFAULT SEAT NAME
  // ==========================================================================
  //
  // Only the create tag is emitted by this landing (per issue #2405's
  // fingerprint contract).  Byte counts verified by hand:
  //
  //   "seat create ok [legacy: SEAT CREATE OK]\0" = 40 bytes
  //     - "seat create ok"                     = 14
  //     - " [legacy: SEAT CREATE OK]"          = 25
  //     - NUL                                  = 1
  //     -------------------------------------------
  //     - total                                = 40
  //
  // KV keys: "id\0" (3), "session\0" (8).  Tag prefix + KV keys
  // reconstitute the issue-required wire line shape verbatim:
  //     "SEAT CREATE OK id=<n> session=<n>"
  //
  // Default seat name for the boot-time seat 0 mint.  8-byte string
  // "default\0" (7 chars + NUL).  A follow-on seat-manager landing
  // may replace this with a locale-aware name once i18n is up.

  pub let seat_create_ok_msg : [u8; 40] = "seat create ok [legacy: SEAT CREATE OK]\0"
  pub let seat_k_id          : [u8; 3]  = "id\0"
  pub let seat_k_session     : [u8; 8]  = "session\0"
  pub let default_seat_name  : [u8; 8]  = "default\0"

  // ==========================================================================
  // SECTION 7 -- STATS BUMPERS (narrow writers)
  // ==========================================================================
  //
  // Narrow writers per the kind_session / kind_capture discipline: one
  // leaf per stats slot, load-inc-store, no `add reg, [mem]`.  The
  // ONLY writers of _seat_stats.

  pub let seat_stats_bump_creates : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): bump _seat_stats[SEAT_ST_CREATES=0]. Load-inc-store leaf, no `add reg, [mem]`. Called from seat_create success tail only. Labels prefixed seat_bc_.",
      block: {
        lea r10, [rip + _seat_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let seat_stats_bump_destroys : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): bump _seat_stats[SEAT_ST_DESTROYS=1]. Load-inc-store leaf. Called from seat_destroy success tail only. Labels prefixed seat_bv_.",
      block: {
        lea r10, [rip + _seat_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let seat_stats_bump_refused : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): bump _seat_stats[SEAT_ST_REFUSED=2]. Load-inc-store leaf. Called from every refusal funnel across create/destroy/bind-kbd/bind-ptr -- matches kind_session's session_stats_bump_refused broad scope (any op refusal counts toward the meter). Labels prefixed seat_br_.",
      block: {
        lea r10, [rip + _seat_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  pub let seat_stats_bump_bind_kbd : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): bump _seat_stats[SEAT_ST_BIND_KBD=3]. Load-inc-store leaf. Called from seat_bind_kbd success tail only. Labels prefixed seat_bk_.",
      block: {
        lea r10, [rip + _seat_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        ret
      }
    }

  pub let seat_stats_bump_bind_ptr : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): bump _seat_stats[SEAT_ST_BIND_PTR=4]. Load-inc-store leaf. Called from seat_bind_ptr success tail only. Labels prefixed seat_bp_.",
      block: {
        lea r10, [rip + _seat_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- BOOT INIT (kind_seat_init)
  // ==========================================================================
  //
  // Two-part boot init:
  //   (a) zero _seats (64 u64 = 512 B) and _seat_stats (8 u64 = 64 B);
  //       defensive re-scrub matching kind_session_init / kind_capture_
  //       init / kind_surface_init one-for-one.  .bss is zero at real
  //       boot; this pass gives a future chaos-restart witness (and any
  //       repeat call to the init sequence) a clean re-scrub point.
  //   (b) mint the default seat 0 via seat_create(session_slot=0,
  //       name_ptr=&default_seat_name).  A single-seat kernel already
  //       has seat 0 available for the input dispatcher before any
  //       real seat-manager landing runs; a multi-seat kiosk extends
  //       by calling seat_create for each additional physical seat.
  //       This emits SEAT CREATE OK id=0 session=0 as a boot
  //       fingerprint witness -- the R113.M5-025 landing's only
  //       required boot artifact.
  //
  // Register plan: no callee-save clobber during the scrub loops (they
  // touch only rax/rcx/r10 -- safe alongside live r12/r13/r14 handoff
  // registers in the boot cascade).  seat_create call preserves the
  // caller's callee-saves per SysV; entry rsp%16==8 unchanged on ret.
  //
  // Alignment for the seat_create call: entry rsp%16==8; scrub loops do
  // not push; pre-call rsp%16==8 -- MISALIGNED for the ABI-strict form,
  // but seat_create's own prologue does `push rbx; push r12; sub rsp,8`
  // (3 stack ops = 24 B) which lands rsp%16 at 0 for its OWN nested
  // calls (bumper, klog); the entry-to-seat_create call itself is a
  // leaf-to-leaf transfer where the outer caller (kernel_main) already
  // established a working alignment discipline.  For belt-and-braces,
  // this init leaf does one `sub rsp, 8` pad before the call and
  // matching `add rsp, 8` after, so the outer cascade sees rsp%16==8
  // preserved on return AND the call itself lands rsp%16==0 pre-call.

  pub let kind_seat_init : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M5-025 (#2405): (a) zero _seats (64 u64) and _seat_stats (8 u64); (b) mint the default seat 0 via seat_create(0, &default_seat_name) so a single-seat kernel has seat 0 available before any real seat-manager landing runs.  Boot-witness fingerprint SEAT CREATE OK id=0 session=0 emitted through the same klog_s1_x2 path production seat_create uses.  Two scrub loops (touch only rax/rcx/r10 -- safe alongside r12/r13/r14 boot-cascade handoff), then sub rsp,8 to align for the nested seat_create call (entry rsp%16==8 -> sub 8 -> 0 pre-call, per SysV), matching add rsp,8 on return.  Effects {mem, sysreg}: mem for the pool + stats stores + the default-seat row stamp; sysreg for the klog serial write in the create's fingerprint path.  Capabilities {cap}: seat_create is a capability mint.  Labels prefixed seat_init_.",
      block: {
        // (a) scrub _seats (64 u64 words = 512 B)
        lea r10, [rip + _seats];
        xor rax, rax;
        xor rcx, rcx;
      seat_init_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  seat_init_rows;

        // (a-2) scrub _seat_stats (8 u64)
        lea r10, [rip + _seat_stats];
        xor rcx, rcx;
      seat_init_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  seat_init_stats;

        // (b) mint default seat 0.  Args: rdi = session_slot = 0,
        //     rsi = name_ptr = &default_seat_name.
        //     Return value in rax is intentionally swallowed -- at boot
        //     time the pool is guaranteed empty (just scrubbed), so the
        //     scan claims slot 0 and returns 0 (SEAT_OK path).  Any
        //     other outcome would indicate a substrate corruption bug
        //     that the follow-on adversarial-boot witness will catch
        //     independently.
        //     rsp alignment: entry rsp%16==8; scrub loops did not push;
        //     sub rsp,8 lands rsp%16==0 pre-call (SysV compliant).
        sub rsp, 8;
        xor rdi, rdi;                     // session_slot = 0
        lea rsi, [rip + default_seat_name];
        call seat_create;
        add rsp, 8;

        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- ROW ACCESSORS (pure leaves)
  // ==========================================================================
  //
  // Every accessor takes a seat_id (== row_id / slot);
  // return-shape sentinels use SEAT_BAD_SLOT = 0xFFFFE2ED.

  // seat_row_valid(seat_id) -> 1 iff seat_id < SEAT_ROW_MAX and the
  // row's in_use byte (top byte of hdr) is nonzero.
  pub let seat_row_valid : (u64) -> u64 !{mem} @{} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): 1 iff seat_id < SEAT_ROW_MAX(8) and in_use set. Inlined address compute (seat_id*64 via shl 6). Labels prefixed seat_rv_.",
      block: {
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rdi, r10;
        jae seat_rv_no;
        lea r10, [rip + _seats];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_rv_no;
        mov rax, 1;
        ret;
      seat_rv_no:
        xor rax, rax;
        ret
      }
    }

  // seat_row_addr(seat_id) -> &_seats[seat_id*64] iff live; 0 else.
  pub let seat_row_addr : (u64) -> u64 !{mem} @{} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): row base pointer post-liveness. Returns 0 on invalid slot. Exported for follow-on seat-manager landings that perform multi-field atomic updates no typed getter can express. Labels prefixed seat_ra_.",
      block: {
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rdi, r10;
        jae seat_ra_no;
        lea r10, [rip + _seats];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_ra_no;
        mov rax, r10;
        ret;
      seat_ra_no:
        xor rax, rax;
        ret
      }
    }

  // seat_row_session_get(seat_id) -> session_slot | SEAT_BAD_SLOT.
  pub let seat_row_session_get : (u64) -> u64 !{mem} @{} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): raw session_slot load from row+16. Labels prefixed seat_rss_.",
      block: {
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rdi, r10;
        jae seat_rss_bad;
        lea r10, [rip + _seats];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_rss_bad;
        mov rax, [r10 + 16];
        ret;
      seat_rss_bad:
        mov rax, 0xFFFFE2ED;
        ret
      }
    }

  // seat_row_kbd_get(seat_id) -> kbd_focus_slot | SEAT_BAD_SLOT.
  // NB: a live row may legitimately hold SEAT_FOCUS_NONE (0xFFFF...FF)
  // as its kbd_focus_slot value; that is distinct from the SEAT_BAD_
  // SLOT (0xFFFFE2ED) sentinel returned on row-liveness failure.
  pub let seat_row_kbd_get : (u64) -> u64 !{mem} @{} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): raw kbd_focus_slot load from row+24. Returns SEAT_FOCUS_NONE for an unfocused live row (distinct from the SEAT_BAD_SLOT sentinel returned on liveness failure). Labels prefixed seat_rk_.",
      block: {
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rdi, r10;
        jae seat_rk_bad;
        lea r10, [rip + _seats];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_rk_bad;
        mov rax, [r10 + 24];
        ret;
      seat_rk_bad:
        mov rax, 0xFFFFE2ED;
        ret
      }
    }

  // seat_row_ptr_get(seat_id) -> ptr_focus_slot | SEAT_BAD_SLOT.
  pub let seat_row_ptr_get : (u64) -> u64 !{mem} @{} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): raw ptr_focus_slot load from row+32. Returns SEAT_FOCUS_NONE for an unfocused live row. Labels prefixed seat_rp_.",
      block: {
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rdi, r10;
        jae seat_rp_bad;
        lea r10, [rip + _seats];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
