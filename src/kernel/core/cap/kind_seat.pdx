  // seat_row_touch_get(seat_id) -> touch_focus_slot | SEAT_BAD_SLOT.
  pub let seat_row_touch_get : (u64) -> u64 !{mem} @{} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): raw touch_focus_slot load from row+40. Returns SEAT_FOCUS_NONE for an unfocused live row. Labels prefixed seat_rt_.",
      block: {
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rdi, r10;
        jae seat_rt_bad;
        lea r10, [rip + _seats];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
