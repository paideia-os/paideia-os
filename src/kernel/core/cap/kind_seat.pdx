  // seat_row_name_get(seat_id) -> name_ptr | SEAT_BAD_SLOT.
  // NB: a live row may legitimately hold 0 as its name_ptr (unnamed
  // seat); that is distinct from the SEAT_BAD_SLOT sentinel returned
  // on row-liveness failure.
  pub let seat_row_name_get : (u64) -> u64 !{mem} @{} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-025 (#2405): raw name_ptr load from row+48. Returns 0 for an unnamed live seat (distinct from the SEAT_BAD_SLOT sentinel returned on liveness failure). Labels prefixed seat_rn_.",
      block: {
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rdi, r10;
        jae seat_rn_bad;
        lea r10, [rip + _seats];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_rn_bad;
        mov rax, [r10 + 48];
        ret;
      seat_rn_bad:
        mov rax, 0xFFFFE2ED;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- seat_create(session_slot, name_ptr) -> seat_id | error
  // ==========================================================================
  //
  // Gate order:
  //   (1) session_slot < SEAT_SESSION_SLOT_MAX(16) -> else
  //       SEAT_CREATE_BAD_SESSION.  Range check only (liveness is not
  //       checked here; boot-time default seat 0 mint predates any
  //       KIND_SESSION mint).  name_ptr = 0 is legal (unnamed seat).
  //   (2) low-first free-slot scan over SEAT_ROW_MAX(8) rows -> else
  //       SEAT_TAIL_ENOSPC.
  //   (3) LAM header bump: low-56 gen+1, OR in 1<<56 in_use marker.
  //   (4) row stamp per §3:
  //         +8   seat_id (= row_id, mirrored for legibility)
  //         +16  session_slot
  //         +24  kbd_focus_slot = SEAT_FOCUS_NONE (movabs into scratch)
  //         +32  ptr_focus_slot = SEAT_FOCUS_NONE
  //         +40  touch_focus_slot = SEAT_FOCUS_NONE
  //         +48  name_ptr
  //         +56  reserved = 0
  //   (5) bump stats.creates.
  //   (6) emit SEAT CREATE OK id=<seat_id> session=<session_slot> via
  //       klog_s1_x2 (v2-push idiom lifted from wal.pdx L1058-1061,
  //       same as kind_session_mint).
  //   (7) return seat_id (== row_id).
  //
  // Register plan: rbx=seat_id (survives klog), r12=session_slot
  // (needed at fingerprint).  name_ptr survives from entry (rsi) to
  // its store at row+48 without any intervening call, so no callee-save
  // preservation needed.  Two callee-save pushes = 16 bytes; entry
  // rsp%16==8 -> post-pushes rsp%16==8; sub rsp,8 pad -> rsp%16==0
  // for the pre-klog nested call (seat_stats_bump_creates).  The
  // klog_s1_x2 v2-push idiom (sub rsp,8; push v2; call; add rsp,16)
  // then adds a net 16 bytes during the call, preserving rsp%16==0.
  // add rsp,8 at exit undoes the initial pad.

  pub let seat_create : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_slot: u64) (name_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M5-025 (#2405): mint KIND_SEAT. Gate order: (1) session_slot < SEAT_SESSION_SLOT_MAX(16) else CREATE_BAD_SESSION (range check only -- liveness is deferred to the follow-on seat-manager because the boot-time default seat 0 mint predates any KIND_SESSION mint; name_ptr=0 is legal for an unnamed seat); (2) low-first scan over 8 rows else TAIL_ENOSPC; (3) LAM header bump; (4) row stamp per §3 (seat_id=row_id mirrored at +8, focus roots latched to SEAT_FOCUS_NONE via movabs into scratch then store -- no `mov qword [mem], imm64`, reserved zero); (5) stats.creates++; (6) klog SEAT CREATE OK id=<row_id> session=<session_slot> via klog_s1_x2 with v2-push idiom lifted verbatim from wal.pdx wal_fs_bdev_flush L1058-1061 (same discipline kind_session_mint uses); (7) return row_id. name_ptr survives from entry (rsi) to its store at row+48 without any intervening call, so no callee-save preservation needed. Two callee-save pushes (rbx=seat_id, r12=session_slot) plus a sub rsp,8 pad leave rsp%16==0 for every nested call. klog_s1_x2 preserves callee-saves per SysV. Refusal funnel bumps stats.refused. Effects {mem, sysreg}: mem for row + counter stores; sysreg for the klog path (serial writes). Capabilities {cap}: this is the substrate mint for a capability kind. Labels prefixed seat_c_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov r12, rdi;                        // session_slot
        // rsi still holds name_ptr and survives to its row stamp store
        // (no calls between here and step 4f).

        // Gate 1: session_slot < SEAT_SESSION_SLOT_MAX(16)
        mov r10, [rip + SEAT_SESSION_SLOT_MAX];
        cmp r12, r10;
        jae seat_c_bad_session;

        // Gate 2: low-first scan over 8 rows for in_use == 0
        xor rcx, rcx;                        // idx = 0
      seat_c_scan:
        mov r10, [rip + SEAT_ROW_MAX];
        cmp rcx, r10;
        jae seat_c_enospc;

        lea r10, [rip + _seats];
        mov r11, rcx;
        shl r11, 6;                          // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_c_claim;

        add rcx, 1;
        jmp seat_c_scan;

      seat_c_claim:
        // rcx = free slot idx; r10 = row base pointer.
        mov rbx, rcx;                        // save seat_id in callee-save

        // (3) LAM: hdr = ((old_gen + 1) & 0x00FFFFFFFFFFFFFF) | (1<<56)
        mov r11, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;                         // r11 = old low-56 gen
        add r11, 1;
        and r11, r9;                         // clip to 56 bits
        mov r8, 1;
        shl r8, 56;                          // r8 = 1<<56 (in_use marker)
        or  r11, r8;
        mov [r10 + 0], r11;                  // write new hdr

        // (4a) seat_id (== row_id, mirrored at +8 for legibility)
        mov [r10 + 8], rbx;

        // (4b) session_slot
        mov [r10 + 16], r12;

        // (4c) kbd_focus_slot = SEAT_FOCUS_NONE (movabs then store)
        mov r9, 0xFFFFFFFFFFFFFFFF;
        mov [r10 + 24], r9;

        // (4d) ptr_focus_slot = SEAT_FOCUS_NONE (r9 still holds it)
        mov [r10 + 32], r9;

        // (4e) touch_focus_slot = SEAT_FOCUS_NONE (r9 still holds it)
        mov [r10 + 40], r9;

        // (4f) name_ptr (still in rsi from entry; no intervening call)
        mov [r10 + 48], rsi;

        // (4g) reserved word = 0
        xor rax, rax;
        mov [r10 + 56], rax;

        // (5) stats.creates++
        call seat_stats_bump_creates;

        // (6) klog_s1_x2(LEVEL_INFO=3, SUBSYS_CAP_, seat_create_ok_msg,
        //                seat_k_id, id=rbx (seat_id),
        //                seat_k_session, session=r12 (session_slot))
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + seat_create_ok_msg];
        lea rcx, [rip + seat_k_id];
        mov r8, rbx;                         // v1 = seat_id
        lea r9, [rip + seat_k_session];
        sub rsp, 8;
        push r12;                            // v2 = session_slot
        call klog_s1_x2;
        add rsp, 16;

        mov rax, rbx;                        // return seat_id (row_id)
        jmp seat_c_out;

      seat_c_bad_session:
        mov rax, 0xFFFFE2EE;
        jmp seat_c_refused;
      seat_c_enospc:
        mov rax, 0xFFFFE2EF;

      seat_c_refused:
        // Shared refusal funnel: bump stats.refused, preserving the
        // sentinel across the call (bumper clobbers rax as scratch).
        push rax;
        call seat_stats_bump_refused;
        pop rax;

      seat_c_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11 -- seat_destroy(seat_id) -> 0 | error
  // ==========================================================================
  //
  // Bumps generation (so a stale handle to the same slot is invalidated)
  // and clears the in_use marker byte.  Row payload is left intact (a
  // chaos-restart witness reading the tombstone sees the pre-destroy
  // session + focus roots + name -- useful for post-mortem).  No
  // fingerprint emit per issue #2405's contract (only create emits).
  //
  // Register plan: r12=seat_id (survives the bumper call).  One
  // callee-save push = 8 bytes; entry rsp%16==8 -> (8+8)%16 = 0 for
  // the nested bumper call.

  pub let seat_destroy : (u64) -> u64 !{mem} @{cap} =
    fn (seat_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M5-025 (#2405): destroy KIND_SEAT row. seat_id >= SEAT_ROW_MAX(8) -> SEAT_BAD_SLOT; row not in_use -> SEAT_DESTROY_ALREADY; else bump generation + clear in_use byte + stats.destroys++. No fingerprint (per issue #2405's contract; only create emits). One callee-save push (r12) aligns rsp to 16 for the nested bumper call. Refusal funnel bumps stats.refused. Labels prefixed seat_d_.",
      block: {
        push r12;

        mov r12, rdi;                        // seat_id

        mov r10, [rip + SEAT_ROW_MAX];
        cmp r12, r10;
        jae seat_d_bad_slot;

        lea r10, [rip + _seats];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_d_already;

        // Bump generation and clear in_use in one write.
        mov r11, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        add r11, 1;
        and r11, r9;
        mov [r10 + 0], r11;                  // in_use now 0; gen bumped

        call seat_stats_bump_destroys;

        xor rax, rax;                        // SEAT_OK
        jmp seat_d_out;

      seat_d_bad_slot:
        mov rax, 0xFFFFE2ED;
        jmp seat_d_refused;
      seat_d_already:
        mov rax, 0xFFFFE2EC;

      seat_d_refused:
        push rax;
        call seat_stats_bump_refused;
        pop rax;

      seat_d_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12 -- seat_bind_kbd(seat_id, surface_slot) -> 0 | error
  // ==========================================================================
  //
  // Writes surface_slot to row+24 (kbd_focus_slot).
  //
  // Gate order:
  //   (1) seat_id < SEAT_ROW_MAX && row in_use  -> else SEAT_BAD_SLOT
  //   (2) surface_slot == SEAT_FOCUS_NONE, OR surface_row_valid(
  //       surface_slot) == 1                      -> else SEAT_BIND_BAD_
  //       SURFACE  (SEAT_FOCUS_NONE is the "clear the binding" arm)
  //   (3) write surface_slot to row+24
  //   (4) bump stats.bind_kbd
  //
  // No fingerprint (per issue #2405's contract).  This landing does NOT
  // cascade into the global focus.pdx _kbd_focus_slot cell -- the
  // per-seat focus roots are the multi-seat substrate; the input
  // dispatcher's follow-on landing decides which seat's kbd focus
  // becomes the "active" one for the single-seat compatibility path.
  //
  // Register plan: r12=seat_id, r13=surface_slot (survive the surface_
  // row_valid call and the bumper).  Two callee-save pushes = 16 bytes;
  // entry rsp%16==8 -> (8+16)%16 = 8; sub rsp,8 pad -> rsp%16==0 for
  // nested call.  add rsp,8 undoes pad at exit.

  pub let seat_bind_kbd : (u64, u64) -> u64 !{mem} @{cap} =
    fn (seat_id: u64) (surface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M5-025 (#2405): bind surface_slot to seat's kbd_focus_slot at row+24. Gate order: (1) seat_id valid + in_use else BAD_SLOT; (2) surface_slot == SEAT_FOCUS_NONE (clear-binding arm) OR surface_row_valid(surface_slot) else BIND_BAD_SURFACE; (3) write; (4) stats.bind_kbd++. SEAT_FOCUS_NONE staged via movabs into r11 for the equality compare; the store form loads r13 (surface_slot) directly (surface_slot may already BE SEAT_FOCUS_NONE, which we allow and store verbatim as the clear-binding value). No fingerprint (per issue #2405's contract; only create emits). This landing does NOT cascade into the global focus.pdx _kbd_focus_slot cell -- the per-seat focus roots are the multi-seat substrate; the input dispatcher's follow-on landing bridges seat 0's per-seat state into the single-seat compatibility path. Two callee-save pushes (r12=seat_id, r13=surface_slot) + sub rsp,8 align rsp for the surface_row_valid + bumper calls. Refusal funnel bumps stats.refused. Labels prefixed seat_bindk_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // seat_id
        mov r13, rsi;                        // surface_slot

        // Gate 1: seat_id < SEAT_ROW_MAX
        mov r10, [rip + SEAT_ROW_MAX];
        cmp r12, r10;
        jae seat_bindk_bad_slot;

        // Row base + in_use check
        lea r10, [rip + _seats];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_bindk_bad_slot;

        // Gate 2: SEAT_FOCUS_NONE arm skips surface validation
        mov r11, 0xFFFFFFFFFFFFFFFF;         // SEAT_FOCUS_NONE
        cmp r13, r11;
        je  seat_bindk_store;

        // Validate surface_slot via surface_row_valid
        mov rdi, r13;
        call surface_row_valid;
        cmp rax, 0;
        je  seat_bindk_bad_surface;

      seat_bindk_store:
        // Recompute row base (surface_row_valid may have clobbered r10).
        lea r10, [rip + _seats];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        // (3) write surface_slot to row+24 (kbd_focus_slot)
        mov [r10 + 24], r13;

        // (4) stats.bind_kbd++
        call seat_stats_bump_bind_kbd;

        xor rax, rax;                        // SEAT_OK
        jmp seat_bindk_out;

      seat_bindk_bad_slot:
        mov rax, 0xFFFFE2ED;
        jmp seat_bindk_refused;
      seat_bindk_bad_surface:
        mov rax, 0xFFFFE2EB;

      seat_bindk_refused:
        push rax;
        call seat_stats_bump_refused;
        pop rax;

      seat_bindk_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 13 -- seat_bind_ptr(seat_id, surface_slot) -> 0 | error
  // ==========================================================================
  //
  // Writes surface_slot to row+32 (ptr_focus_slot).  Mirrors seat_bind_
  // kbd byte-for-byte except for the row offset (+32 vs. +24) and the
  // stats bumper (bind_ptr vs. bind_kbd).  Same gate order, same
  // register plan, same alignment.  Labels prefixed seat_bindp_.

  pub let seat_bind_ptr : (u64, u64) -> u64 !{mem} @{cap} =
    fn (seat_id: u64) (surface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M5-025 (#2405): bind surface_slot to seat's ptr_focus_slot at row+32. Mirrors seat_bind_kbd byte-for-byte with the row offset changed (+32 vs. +24) and the stats bumper changed (bind_ptr vs. bind_kbd). Same gate order (BAD_SLOT / BIND_BAD_SURFACE / SEAT_FOCUS_NONE clear-arm), same alignment (two callee-save pushes + sub rsp,8), same refusal funnel. Labels prefixed seat_bindp_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // seat_id
        mov r13, rsi;                        // surface_slot

        // Gate 1: seat_id < SEAT_ROW_MAX
        mov r10, [rip + SEAT_ROW_MAX];
        cmp r12, r10;
        jae seat_bindp_bad_slot;

        // Row base + in_use check
        lea r10, [rip + _seats];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  seat_bindp_bad_slot;

        // Gate 2: SEAT_FOCUS_NONE arm skips surface validation
        mov r11, 0xFFFFFFFFFFFFFFFF;         // SEAT_FOCUS_NONE
        cmp r13, r11;
        je  seat_bindp_store;

        // Validate surface_slot via surface_row_valid
        mov rdi, r13;
        call surface_row_valid;
        cmp rax, 0;
        je  seat_bindp_bad_surface;

      seat_bindp_store:
        // Recompute row base (surface_row_valid may have clobbered r10).
        lea r10, [rip + _seats];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        // (3) write surface_slot to row+32 (ptr_focus_slot)
        mov [r10 + 32], r13;

        // (4) stats.bind_ptr++
        call seat_stats_bump_bind_ptr;

        xor rax, rax;                        // SEAT_OK
        jmp seat_bindp_out;

      seat_bindp_bad_slot:
        mov rax, 0xFFFFE2ED;
        jmp seat_bindp_refused;
      seat_bindp_bad_surface:
        mov rax, 0xFFFFE2EB;

      seat_bindp_refused:
        push rax;
        call seat_stats_bump_refused;
        pop rax;

      seat_bindp_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }
}
