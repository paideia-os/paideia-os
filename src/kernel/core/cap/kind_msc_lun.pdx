// src/kernel/core/cap/kind_msc_lun.pdx — R34.M3-001 (#1176)
//
// KIND_MSC_LUN = 0x166, derived over KIND_USB_INTERFACE (0x164).
//
// The authority to hold ONE mass-storage-class LOGICAL UNIT's static
// identity — its inherited lun_key (a fresh identity supplied by the
// class driver at Get-Max-LUN time), and the lun_number the class
// driver assigned it (0..15 per USB MSC / BOT §3.2 Get-Max-LUN).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A USB mass-storage INTERFACE may present SEVERAL logical units (a
// card reader with three slots reports Max-LUN = 2, i.e. three LUNs).
// SCSI addressing runs PER-LUN — a READ(10) issued at LUN 1 hits
// different media from a READ(10) at LUN 0 — so the CAPABILITY at
// which storage-command authority is gated has to be the LUN, not
// the interface. That is this kind.
//
// =============================================================================
// §1  DERIVATION OVER KIND_USB_INTERFACE
// =============================================================================
//
// The gate demands `kind == KIND_USB_INTERFACE (0x164)` carrying
// `RIGHT_MINT`. Like KIND_USB_HUB (which derives over KIND_USB_DEVICE),
// the parent proves the enumerator walked the descriptor tree far
// enough to identify a mass-storage class interface. Without that
// intermediate authority, a raw KIND_DEVICE holder could claim to
// have discovered a LUN behind a bus function it never saw.
//
// SECOND HALF: (a) parent's inherited interface_key must be non-zero
// (NO_INTERFACE); (b) lun_key must be non-zero and unique among live
// rows (IN_USE / NO_KEY); (c) lun_number in [0, 15]; (d) rights
// subset of R_MSC_LUN_ALL. lun_number is the number the class driver
// reports the DEVICE assigned; the kernel enforces the range and the
// uniqueness of the (lun_key) pair, not the medium's presence.
//
// =============================================================================
// §2  DYNAMIC STATE IS ABSENT
// =============================================================================
//
// Same discipline as KIND_USB_INTERFACE §2. lun_key and lun_number
// are ROW IDENTITY, refused to a mint that supplies implausible
// values. There is NO dynamic state on this row: SCSI status, media
// presence, block count all live in the KIND_SCSI_DEVICE row that
// derives from this one. A LUN whose number could be re-stamped in
// place would let a driver silently issue commands against a
// different logical unit than the one its capability names.
//
// =============================================================================
// §3  KIND_SCSI_DEVICE DERIVES OVER THIS KIND
// =============================================================================
//
// R_MSC_LUN_MINT (0x200) IS PART OF THE MASK because this kind is a
// NON-LEAF: KIND_SCSI_DEVICE mints demand it.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFFBA0..0xFFFFFBAF
// =============================================================================
//
// Sixteen-wide band disjoint from every other kind in the tree.
// R34.M3 softarch grep confirmed 0xFFFFFBA0..AF was free before this
// milestone opened; disjoint from KIND_USB_INTERFACE (0xFFFFFBB0..BF),
// KIND_USB_ENDPOINT (0xFFFFFBC0..CF), composite_bind (0xFFFFFB80..8F),
// interface_parser (0xFFFFFB90..9F).

module KindMscLun = structure {

  pub let KIND_MSC_LUN         : u64 = 0x166
  pub let MSC_LUN_PARENT_KIND  : u64 = 0x164    // = KIND_USB_INTERFACE

  // §1 bounds.
  pub let MSC_LUN_NUM_MIN : u64 = 0
  pub let MSC_LUN_NUM_MAX : u64 = 15

  // Rights. RIGHT_MINT (0x200) IN the mask — non-leaf (§3).
  pub let R_MSC_LUN_READ    : u64 = 0x001
  pub let R_MSC_LUN_INVOKE  : u64 = 0x008
  pub let R_MSC_LUN_REVOKE  : u64 = 0x010
  pub let R_MSC_LUN_MINT    : u64 = 0x200
  pub let R_MSC_LUN_OBSERVE : u64 = 0x400
  pub let R_MSC_LUN_ALL     : u64 = 0x619

  // Ops:
  pub let MSCLUN_OP_QUERY_KEY    : u64 = 0
  pub let MSCLUN_OP_QUERY_NUM    : u64 = 1
  pub let MSCLUN_OP_QUERY_PARENT : u64 = 2
  pub let MSCLUN_OP_DEBUG_PRINT  : u64 = 3
  pub let MSCLUN_OP_MAX          : u64 = 3

  // Failure taxonomy — 0xFFFFFBA0..0xFFFFFBAF.
  pub let MSCLUN_OK                 : u64 = 0
  pub let MSCLUN_TAIL_ENOSPC        : u64 = 0xFFFFFBAF
  pub let MSCLUN_TAIL_BAD_ARG       : u64 = 0xFFFFFBAE
  pub let MSCLUN_MINT_BAD_PARENT    : u64 = 0xFFFFFBAD
  pub let MSCLUN_MINT_BAD_RIGHTS    : u64 = 0xFFFFFBAC
  pub let MSCLUN_MINT_BAD_NUM       : u64 = 0xFFFFFBAB
  pub let MSCLUN_MINT_NO_INTERFACE  : u64 = 0xFFFFFBAA
  pub let MSCLUN_MINT_NO_KEY        : u64 = 0xFFFFFBA9
  pub let MSCLUN_MINT_ENOSPC        : u64 = 0xFFFFFBA8
  pub let MSCLUN_MINT_IN_USE        : u64 = 0xFFFFFBA7
  pub let MSCLUN_BAD_SLOT           : u64 = 0xFFFFFBA6
  pub let MSCLUN_WRONG_KIND         : u64 = 0xFFFFFBA5
  pub let MSCLUN_REVOKE_ALREADY     : u64 = 0xFFFFFBA4

  pub let MSCLUN_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let MSCLUN_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  lun_key
  //   [+16] body: lun_number[7:0]
  //   [+24] reserved
  pub let MSCLUN_MAX       : u64 = 16
  pub let MSCLUN_ROW_BYTES : u64 = 32

  pub let mut _msc_lun_table : [u64; 64] = uninit @align(64)
  pub let mut _msc_lun_stats : [u64; 4]  = uninit @align(64)

  pub let MSCLUN_ST_MINTS   : u64 = 0
  pub let MSCLUN_ST_REVOKES : u64 = 1
  pub let MSCLUN_ST_IN_USE  : u64 = 2
  pub let MSCLUN_ST_ENOSPC  : u64 = 3

  pub let msclun_dbg_msg : [u8; 13] = "MSC LUN ROW\n\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let msc_lun_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): clear the MSC LUN row table and its counters. Labels prefixed msclun_rs_.",
      block: {
        lea r10, [rip + _msc_lun_table];
        xor rax, rax;
        xor rcx, rcx;
      msclun_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  msclun_rs_rows;

        lea r10, [rip + _msc_lun_stats];
        xor rcx, rcx;
      msclun_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  msclun_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let msc_lun_num_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): 1 iff n <= 15. Labels prefixed msclun_nv_.",
      block: {
        cmp rdi, 15;
        ja  msclun_nv_no;
        mov rax, 1;
        ret;
      msclun_nv_no:
        xor rax, rax;
        ret
      }
    }

  pub let msc_lun_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): subset test against R_MSC_LUN_ALL = 0x619. Labels prefixed msclun_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne msclun_rv_no;
        mov rax, 1;
        ret;
      msclun_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let msc_lun_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): counter bump. Labels prefixed msclun_nt_.",
      block: {
        cmp rdi, 4;
        jae msclun_nt_out;
        lea r10, [rip + _msc_lun_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      msclun_nt_out:
        ret
      }
    }

  pub let msc_lun_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): counter read. Labels prefixed msclun_st_.",
      block: {
        cmp rdi, 4;
        jae msclun_st_zero;
        lea r10, [rip + _msc_lun_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      msclun_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate.
  // ==========================================================================

  pub let msc_lun_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): parent must be live KIND_USB_INTERFACE (0x164) with RIGHT_MINT. Labels prefixed msclun_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae msclun_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x164;                  // KIND_USB_INTERFACE
        cmp r10, r11;
        jne msclun_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  msclun_cp_no;

        mov rax, 1;
        ret;
      msclun_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let msc_lun_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): parent USB interface row's interface_key, or 0. Labels prefixed msclun_pk_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;

        mov r11, 256;
        cmp r12, r11;
        jae msclun_pk_zero;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x164;
        cmp r10, r11;
        jne msclun_pk_zero;

        mov r13, [rax + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call usb_interface_row_key;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  msclun_pk_zero;
        jmp msclun_pk_out;

      msclun_pk_zero:
        xor rax, rax;
      msclun_pk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let msc_lun_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): (parent_slot << 8). Labels prefixed msclun_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae msclun_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      msclun_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let msc_lun_body_pack : (u64) -> u64 !{} @{} =
    fn (lun_number: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): pack lun_number[7:0]. Refuses > 15. Labels prefixed msclun_bp_.",
      block: {
        cmp rdi, 15;
        ja  msclun_bp_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;
      msclun_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/valid/free.
  // ==========================================================================

  pub let msc_lun_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (lun_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): claim one MSC LUN row. THE ONE WRITER of _msc_lun_table. Labels prefixed msclun_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // lun_key
        mov r14, rdx;                    // body_packed

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne msclun_ta_bad;

        cmp r13, 0;
        je  msclun_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  msclun_ta_bad;

        xor rbx, rbx;
      msclun_ta_scan:
        cmp rbx, 16;
        jae msclun_ta_enospc;

        lea r10, [rip + _msc_lun_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  msclun_ta_claim;

        add rbx, 1;
        jmp msclun_ta_scan;

      msclun_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp msclun_ta_out;

      msclun_ta_enospc:
        mov rax, 0xFFFFFBAF;
        jmp msclun_ta_out;
      msclun_ta_bad:
        mov rax, 0xFFFFFBAE;

      msclun_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let msc_lun_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): 1 iff row_id < MAX and in_use. Labels prefixed msclun_tvr_.",
      block: {
        cmp rdi, 16;
        jae msclun_tvr_no;
        lea r10, [rip + _msc_lun_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  msclun_tvr_no;
        mov rax, 1;
        ret;
      msclun_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let msc_lun_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): scrub one row. Labels prefixed msclun_tf_.",
      block: {
        cmp rdi, 16;
        jae msclun_tf_out;
        lea r10, [rip + _msc_lun_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      msclun_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let msc_lun_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): lun_key. Labels prefixed msclun_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call msc_lun_tail_valid;
        cmp rax, 0;
        je  msclun_rk_bad;
        lea r10, [rip + _msc_lun_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp msclun_rk_out;
      msclun_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      msclun_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let msc_lun_row_num : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): lun_number. Labels prefixed msclun_rn_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call msc_lun_tail_valid;
        cmp rax, 0;
        je  msclun_rn_bad;
        lea r10, [rip + _msc_lun_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp msclun_rn_out;
      msclun_rn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      msclun_rn_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let msc_lun_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): parent slot. Labels prefixed msclun_rp_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call msc_lun_tail_valid;
        cmp rax, 0;
        je  msclun_rp_bad;
        lea r10, [rip + _msc_lun_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp msclun_rp_out;
      msclun_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      msclun_rp_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let msc_lun_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (lun_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): live row holding this lun_key, or ROW_NONE. Labels prefixed msclun_fk_.",
      block: {
        cmp rdi, 0;
        je  msclun_fk_none;
        xor rcx, rcx;
      msclun_fk_scan:
        cmp rcx, 16;
        jae msclun_fk_none;
        lea r10, [rip + _msc_lun_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  msclun_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  msclun_fk_hit;
      msclun_fk_next:
        add rcx, 1;
        jmp msclun_fk_scan;
      msclun_fk_hit:
        mov rax, rcx;
        ret;
      msclun_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let msc_lun_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): slot -> row_id, gated on live KIND_MSC_LUN. Labels prefixed msclun_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae msclun_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x166;
        cmp r10, r11;
        jne msclun_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call msc_lun_tail_valid;
        cmp rax, 0;
        je  msclun_ros_none;

        mov rax, r12;
        jmp msclun_ros_out;

      msclun_ros_none:
        mov rax, 0xFF;
      msclun_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let msc_lun_key_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): lun_key. ARITY ONE. Labels prefixed msclun_kos_.",
      block: {
        push r12; push r13; push r14;
        call msc_lun_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  msclun_kos_bad;
        mov rdi, r12;
        call msc_lun_row_key;
        jmp msclun_kos_out;
      msclun_kos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      msclun_kos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let msc_lun_num_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): lun_number. ARITY ONE. Labels prefixed msclun_nos_.",
      block: {
        push r12; push r13; push r14;
        call msc_lun_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  msclun_nos_bad;
        mov rdi, r12;
        call msc_lun_row_num;
        jmp msclun_nos_out;
      msclun_nos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      msclun_nos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.
  // ==========================================================================

  pub let msc_lun_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (lun_key: u64) (lun_number: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): mint KIND_MSC_LUN over KIND_USB_INTERFACE. Sequence: slot<256; check_parent; rights_valid; num_valid; parent_key non-zero (NO_INTERFACE); lun_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body_pack; tail_alloc; cap_mint_write. Labels prefixed msclun_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // lun_key
        mov r15, r8;                     // lun_number

        mov r10, 256;
        cmp rbx, r10;
        jae msclun_mi_bad_slot;

        mov rdi, r12;
        call msc_lun_check_parent;
        cmp rax, 0;
        je  msclun_mi_bad_parent;

        mov rdi, r13;
        call msc_lun_rights_valid;
        cmp rax, 0;
        je  msclun_mi_bad_rights;

        mov rdi, r15;
        call msc_lun_num_valid;
        cmp rax, 0;
        je  msclun_mi_bad_num;

        mov rdi, r12;
        call msc_lun_parent_key;
        cmp rax, 0;
        je  msclun_mi_no_interface;

        cmp r14, 0;
        je  msclun_mi_no_key;

        mov rdi, r14;
        call msc_lun_find_by_key;
        cmp rax, 0xFF;
        jne msclun_mi_in_use;

        mov rdi, r15;
        call msc_lun_body_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  msclun_mi_bad_num;
        mov rbp, rax;                    // body

        mov rdi, r12;
        call msc_lun_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  msclun_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // lun_key
        mov rdx, rbp;                    // body
        call msc_lun_tail_alloc;

        mov r10, 0xFFFFFBAF;
        cmp rax, r10;
        je  msclun_mi_enospc;
        mov r10, 0xFFFFFBAE;
        cmp rax, r10;
        je  msclun_mi_bad_num;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x166;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call msc_lun_note;

        xor rax, rax;
        jmp msclun_mi_out;

      msclun_mi_bad_slot:
        mov rax, 0xFFFFFBA6;
        jmp msclun_mi_out;
      msclun_mi_bad_parent:
        mov rax, 0xFFFFFBAD;
        jmp msclun_mi_out;
      msclun_mi_bad_rights:
        mov rax, 0xFFFFFBAC;
        jmp msclun_mi_out;
      msclun_mi_bad_num:
        mov rax, 0xFFFFFBAB;
        jmp msclun_mi_out;
      msclun_mi_no_interface:
        mov rax, 0xFFFFFBAA;
        jmp msclun_mi_out;
      msclun_mi_no_key:
        mov rax, 0xFFFFFBA9;
        jmp msclun_mi_out;
      msclun_mi_in_use:
        mov rdi, 2;
        call msc_lun_note;
        mov rax, 0xFFFFFBA7;
        jmp msclun_mi_out;
      msclun_mi_enospc:
        mov rdi, 3;
        call msc_lun_note;
        mov rax, 0xFFFFFBA8;

      msclun_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let msc_lun_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (lun_key: u64) (lun_number: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call msc_lun_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x166;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let msc_lun_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): revoke a KIND_MSC_LUN. Labels prefixed msclun_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae msclun_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  msclun_rvk_already;

        mov r11, 0x166;
        cmp r10, r11;
        jne msclun_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call msc_lun_tail_valid;
        cmp rax, 0;
        je  msclun_rvk_clear;

        mov rdi, r13;
        call msc_lun_tail_free;

      msclun_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call msc_lun_note;

        xor rax, rax;
        jmp msclun_rvk_out;

      msclun_rvk_bad_slot:
        mov rax, 0xFFFFFBA6;
        jmp msclun_rvk_out;
      msclun_rvk_wrong_kind:
        mov rax, 0xFFFFFBA5;
        jmp msclun_rvk_out;
      msclun_rvk_already:
        mov rax, 0xFFFFFBA4;

      msclun_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let msc_lun_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call msc_lun_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x166;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_msc_lun : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-001 (#1176): KIND_MSC_LUN dispatch handler. Queries INVOKE; DEBUG OBSERVE. Arity ONE; op_arg[63:8] REFUSED. Labels prefixed msclun_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_msc_lun_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne msclun_hn_res;

        cmp rbp, 3;
        ja  msclun_hn_unsup;

        cmp rbp, 3;
        je  msclun_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  msclun_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  msclun_hn_key;
        cmp rbp, 1;
        je  msclun_hn_num;
        call msc_lun_row_parent;
        jmp msclun_hn_out;

      msclun_hn_key:
        call msc_lun_row_key;
        jmp msclun_hn_out;
      msclun_hn_num:
        call msc_lun_row_num;
        jmp msclun_hn_out;

      msclun_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  msclun_hn_denied;
        xor rax, rax;
        jmp msclun_hn_out;

      msclun_hn_res:
        mov rax, 0xFFFFFBAE;
        jmp msclun_hn_out;
      msclun_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp msclun_hn_out;
      msclun_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      msclun_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
