// src/kernel/core/cap/kind_pdxfs_txn.pdx -- R48b substrate-prep (#1624)
// R42-PREP-007 write-side ops extension (#1629): add PXT_OP_COMMIT (7),
// PXT_OP_ABORT (8), PXT_OP_CREATE (9), PXT_OP_RENAME (10), PXT_OP_UNLINK
// (11).  COMMIT / ABORT are REAL state-transitions on the row's state
// byte (OPEN -> COMMITTED or OPEN -> ABORTED); CREATE / RENAME / UNLINK
// are wire-only STUBs (bump per-op counter, return PXT_STUB_OK) so the
// R49 tooling wave (pkg / cp / mv / rm / mkdir) can link against real
// op codes even though the mutating filesystem walker body lands later
// (design/tooling/r49-r50-plan.md §5).  Stats table widens from
// [u64; 8] to [u64; 16] to carry the four new counters (CREATES /
// RENAMES / UNLINKS / OPENS).
//
// KIND_PDXFS_TXN = 0x196, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// The runtime authority for ONE in-flight PdxFS transaction: a
// transaction id, a starting snapshot generation, a WAL byte offset
// (where the first record of this transaction landed), a byte-count
// running total, a mode word (CREATE / MODIFY / DELETE), and a state
// (OPEN / COMMITTED / ABORTED / EXPIRED).
//
// The substrate for pkg/cp/mv/rm (design/tooling/r49-r50-plan.md §5
// R49/R50 tools) that must group N file writes into ONE atomic unit --
// either every write lands or none do.  The transaction cap threads
// through cow_write.pdx + wal.pdx + journal_fence.pdx + journal_csum.pdx
// (the R42 substrate) so the walker knows which WAL group a specific
// write belongs to.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// A transaction bounds the set of PdxFS blocks it may mutate to the
// mount's memory authority (same argument as kind_pdxfs_file: an FS
// object is a page-shaped thing).  Deriving over KIND_MEMORY lets the
// mint gate structurally refuse a txn that widens memory reach beyond
// the parent's.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (48 bytes, six u64 words):
//
//   [+0]   header: in_use[63:56] | state[15:8] | mode[7:0]
//   [+8]   txn_id      (u64)                     -- FS-assigned; refused == 0
//   [+16]  snap_gen    (u64)                     -- source snapshot generation
//   [+24]  wal_off     (u64)                     -- WAL byte offset (start)
//   [+32]  bytes_touched (u64)                   -- running total (kernel-side)
//   [+40]  expire_ns    (u64)                    -- absolute deadline (0 = none)
//
// State byte values:
//   PXT_STATE_OPEN      = 1   -- accepting writes
//   PXT_STATE_COMMITTED = 2   -- writes drained to journal
//   PXT_STATE_ABORTED   = 3   -- explicit abort
//   PXT_STATE_EXPIRED   = 4   -- deadline hit before commit
//
// Mode byte values:
//   PXT_MODE_CREATE     = 1   -- pkg install (new files)
//   PXT_MODE_MODIFY     = 2   -- cp/mv onto existing file
//   PXT_MODE_DELETE     = 3   -- rm (unlink files)
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// R_PDXFS_TXN_INVOKE  (0x008) -- query ops + commit + abort
// R_PDXFS_TXN_REVOKE  (0x010) -- supervisor teardown
// R_PDXFS_TXN_MINT    (0x200) -- derive a per-file scope (not used by
//                                pkg today, reserved for R50 layered ops)
// R_PDXFS_TXN_OBSERVE (0x400) -- debug print
// R_PDXFS_TXN_ALL     (0x618)
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEC10..0xFFFFEC1F
// =============================================================================
//
// Sixteen wide, disjoint from KIND_PDXFS_FILE (0xFFFFEC20..0xFFFFEC2F).

module KindPdxfsTxn = structure {

  pub let KIND_PDXFS_TXN      : u64 = 0x196
  pub let KIND_PDXFS_TXN_BASE : u64 = 4          // = KIND_MEMORY

  pub let R_PDXFS_TXN_INVOKE  : u64 = 0x008
  pub let R_PDXFS_TXN_REVOKE  : u64 = 0x010
  pub let R_PDXFS_TXN_MINT    : u64 = 0x200
  pub let R_PDXFS_TXN_OBSERVE : u64 = 0x400
  pub let R_PDXFS_TXN_ALL     : u64 = 0x618

  pub let PXT_STATE_OPEN      : u64 = 1
  pub let PXT_STATE_COMMITTED : u64 = 2
  pub let PXT_STATE_ABORTED   : u64 = 3
  pub let PXT_STATE_EXPIRED   : u64 = 4
  pub let PXT_STATE_MAX       : u64 = 4

  pub let PXT_MODE_CREATE     : u64 = 1
  pub let PXT_MODE_MODIFY     : u64 = 2
  pub let PXT_MODE_DELETE     : u64 = 3
  pub let PXT_MODE_MAX        : u64 = 3

  pub let PXT_OP_QUERY_ID     : u64 = 0
  pub let PXT_OP_QUERY_SNAP   : u64 = 1
  pub let PXT_OP_QUERY_WAL    : u64 = 2
  pub let PXT_OP_QUERY_BYTES  : u64 = 3
  pub let PXT_OP_QUERY_STATE  : u64 = 4
  pub let PXT_OP_QUERY_MODE   : u64 = 5
  pub let PXT_OP_DEBUG_PRINT  : u64 = 6
  // R42-PREP-007 (#1629): write-side op codes.  COMMIT / ABORT are the
  // two real state transitions that any long-running mutating tool must
  // choose between; CREATE / RENAME / UNLINK are the three PdxFS
  // filesystem mutations that mkdir / mv / rm need syscall-facing op
  // ordinals for.  At substrate-prep the mutation ops STUB out to
  // PXT_STUB_OK so the tools link against a fixed op ABI even though
  // the walker body lands later.
  pub let PXT_OP_COMMIT       : u64 = 7
  pub let PXT_OP_ABORT        : u64 = 8
  pub let PXT_OP_CREATE       : u64 = 9
  pub let PXT_OP_RENAME       : u64 = 10
  pub let PXT_OP_UNLINK       : u64 = 11
  pub let PXT_OP_MAX          : u64 = 11

  pub let PXT_OK              : u64 = 0
  pub let PXT_TAIL_ENOSPC     : u64 = 0xFFFFEC1F
  pub let PXT_TAIL_BAD_ARG    : u64 = 0xFFFFEC1E
  pub let PXT_MINT_BAD_PARENT : u64 = 0xFFFFEC1D
  pub let PXT_MINT_BAD_RIGHTS : u64 = 0xFFFFEC1C
  pub let PXT_MINT_BAD_ID     : u64 = 0xFFFFEC1B
  pub let PXT_MINT_BAD_MODE   : u64 = 0xFFFFEC1A
  pub let PXT_MINT_BAD_STATE  : u64 = 0xFFFFEC19
  pub let PXT_BAD_SLOT        : u64 = 0xFFFFEC18
  pub let PXT_WRONG_KIND      : u64 = 0xFFFFEC17
  pub let PXT_REVOKE_ALREADY  : u64 = 0xFFFFEC16
  // R42-PREP-007 (#1629): a COMMIT or ABORT that reaches a row whose
  // state is not OPEN.  Kept disjoint from every other PXT_ sentinel
  // in the 0xFFFFEC10..0xFFFFEC1F band so an operator inspecting the
  // errno can distinguish "the walker refused a duplicate commit"
  // from "the mint refused a bad mode" without a lookup.
  pub let PXT_BAD_TRANSITION  : u64 = 0xFFFFEC15

  // R42-PREP-007 (#1629): STUB sentinel for CREATE / RENAME / UNLINK.
  // Follows the ELVB_DISPATCH_STUB convention (ipc/elevate_broker.pdx)
  // -- a distinct 0xFFFFEB__ value that a caller can distinguish from
  // PXT_OK (real success) via one compare.  Tools translate this into
  // their own TXN_STUB reply until the mutating walker body lands.
  pub let PXT_STUB_OK         : u64 = 0xFFFFEBFB

  pub let PXT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PXT_ROW_NONE   : u64 = 0xFF

  pub let PXT_MAX       : u64 = 16
  pub let PXT_ROW_BYTES : u64 = 48
  pub let mut _pdxfs_txn_table : [u64; 96] = uninit @align(64)
  // R42-PREP-007 (#1629): stats table widened from [u64; 8] to
  // [u64; 16] to carry the four new observability counters
  // (CREATES / RENAMES / UNLINKS / OPENS).  The bounds check in
  // pdxfs_txn_note and pdxfs_txn_stat widens from `cmp rdi, 8` to
  // `cmp rdi, 16` in step; the table_reset loop widens the same way.
  // _pdxfs_txn_stats stays confined to core/cap/kind_pdxfs_txn.o via
  // tools/build.sh's ec_confine_one -- growing its length preserves
  // the one-writer discipline because writes are still the same set
  // of pdxfs_txn_* helpers in this file.
  pub let mut _pdxfs_txn_stats : [u64; 16] = uninit @align(64)

  pub let PXT_ST_MINTS     : u64 = 0
  pub let PXT_ST_REVOKES   : u64 = 1
  pub let PXT_ST_QUERIES   : u64 = 2
  pub let PXT_ST_REFUSED   : u64 = 3
  pub let PXT_ST_COMMITS   : u64 = 4
  pub let PXT_ST_ABORTS    : u64 = 5
  // R42-PREP-007 (#1629): per-op counters for the new write-side ops.
  // Each STUB bumps its own slot on entry; COMMIT / ABORT bump their
  // slot only on a successful transition.  OPENS is bumped by the
  // sys_pdxfs_txn_open syscall body once cap_mint_write returns.
  pub let PXT_ST_CREATES   : u64 = 6
  pub let PXT_ST_RENAMES   : u64 = 7
  pub let PXT_ST_UNLINKS   : u64 = 8
  pub let PXT_ST_OPENS     : u64 = 9
  pub let PXT_ST_MAX       : u64 = 16

  pub let pdxfs_txn_dbg_msg : [u8; 14] = "PDXFS TXN ROW\0"

  pub let pdxfs_txn_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): clear every row and every counter. Boot and teardown only. Labels prefixed pxt_rs_.",
      block: {
        lea r10, [rip + _pdxfs_txn_table];
        xor rax, rax;
        xor rcx, rcx;
      pxt_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  pxt_rs_rows;

        lea r10, [rip + _pdxfs_txn_stats];
        xor rcx, rcx;
      pxt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;                     // R42-PREP-007 (#1629): widened stats
        jb  pxt_rs_stats;
        ret
      }
    }

  pub let pdxfs_txn_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bounded increment; out-of-range no-op. R42-PREP-007 (#1629): widened from 8 to 16 to carry CREATES/RENAMES/UNLINKS/OPENS counters. Labels prefixed pxt_nt_.",
      block: {
        cmp rdi, 16;                     // R42-PREP-007 (#1629): widened bound
        jae pxt_nt_out;
        lea r10, [rip + _pdxfs_txn_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pxt_nt_out:
        ret
      }
    }

  pub let pdxfs_txn_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bounded read; out-of-range returns 0. R42-PREP-007 (#1629): widened from 8 to 16 to match _pdxfs_txn_stats. Labels prefixed pxt_st_.",
      block: {
        cmp rdi, 16;                     // R42-PREP-007 (#1629): widened bound
        jae pxt_st_zero;
        lea r10, [rip + _pdxfs_txn_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pxt_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): subset test against R_PDXFS_TXN_ALL = 0x618. Labels prefixed pxt_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x618;
        and rax, r10;
        cmp rax, rdi;
        jne pxt_rv_no;
        mov rax, 1;
        ret;
      pxt_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_mode_valid : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): 1 iff mode in [1, PXT_MODE_MAX = 3]. Zero is refused (no txn is meaningfully mode-less). Labels prefixed pxt_mv_.",
      block: {
        cmp rdi, 1;
        jb  pxt_mv_no;
        mov r10, 3;
        cmp rdi, r10;
        ja  pxt_mv_no;
        mov rax, 1;
        ret;
      pxt_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): derivation gate. parent.kind == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200). Same shape as pdxfs_file_check_parent_memory. Labels prefixed pxt_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae pxt_cpm_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne pxt_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  pxt_cpm_no;

        mov rax, 1;
        ret;

      pxt_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | state[15:8] | mode[7:0].
  // Callers pack via pdxfs_txn_hdr_pack(mode, state).
  pub let pdxfs_txn_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (mode: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): canonical header encoder. Validates mode in [1..3] and state in [1..4]. Bits [63:56] MUST leave this function zero. Labels prefixed pxt_hp_.",
      block: {
        cmp rdi, 1;
        jb  pxt_hp_bad;
        mov r10, 3;
        cmp rdi, r10;
        ja  pxt_hp_bad;
        cmp rsi, 1;
        jb  pxt_hp_bad;
        mov r10, 4;
        cmp rsi, r10;
        ja  pxt_hp_bad;
        mov rax, rdi;                    // mode in [7:0]
        mov r11, rsi;
        shl r11, 8;
        or  rax, r11;                    // state in [15:8]
        ret;
      pxt_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // tail_alloc(hdr, txn_id, snap_gen, wal_off, expire_ns).  bytes_touched
  // starts at 0 -- the walker bumps it as writes flow through.
  pub let pdxfs_txn_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (txn_id: u64) (snap_gen: u64) (wal_off: u64) (expire_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): claim one txn row. THE ONLY WRITER of _pdxfs_txn_table; tools/build.sh confines it. Gates: hdr in_use pre-set -> BAD_ARG; hdr bits [55:16] non-zero -> BAD_ARG; txn_id == 0 -> BAD_ID. Six callee-save pushes leave rsp%16 == 0. Labels prefixed pxt_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // txn_id
        mov r14, rdx;                    // snap_gen
        mov r15, rcx;                    // wal_off
        mov rbp, r8;                     // expire_ns

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne pxt_ta_bad;

        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        jne pxt_ta_bad;

        cmp r13, 0;
        je  pxt_ta_bad_id;

        xor rbx, rbx;
      pxt_ta_scan:
        cmp rbx, 16;
        jae pxt_ta_enospc;

        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rbx;
        shl r11, 5;
        mov rax, rbx;
        shl rax, 4;
        add r11, rax;                    // row * 48
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pxt_ta_claim;

        add rbx, 1;
        jmp pxt_ta_scan;

      pxt_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        xor rax, rax;
        mov [r10 + 32], rax;             // bytes_touched = 0
        mov [r10 + 40], rbp;
        mov rax, rbx;
        jmp pxt_ta_out;

      pxt_ta_enospc:
        mov rax, 0xFFFFEC1F;             // PXT_TAIL_ENOSPC
        jmp pxt_ta_out;
      pxt_ta_bad_id:
        mov rax, 0xFFFFEC1B;             // PXT_MINT_BAD_ID
        jmp pxt_ta_out;
      pxt_ta_bad:
        mov rax, 0xFFFFEC1E;             // PXT_TAIL_BAD_ARG

      pxt_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pdxfs_txn_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): 1 iff row < PXT_MAX and in_use byte set. Labels prefixed pxt_tv_.",
      block: {
        cmp rdi, 16;
        jae pxt_tv_no;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pxt_tv_no;
        mov rax, 1;
        ret;
      pxt_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): scrub row (all six words). Labels prefixed pxt_tf_.",
      block: {
        cmp rdi, 16;
        jae pxt_tf_out;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      pxt_tf_out:
        ret
      }
    }

  // Row accessors.
  pub let pdxfs_txn_row_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): txn_id, or PXT_DECODE_BAD. Labels prefixed pxt_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rid_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp pxt_rid_out;
      pxt_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rid_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_snap : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): snap_gen, or PXT_DECODE_BAD. Labels prefixed pxt_rsnap_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rsnap_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp pxt_rsnap_out;
      pxt_rsnap_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rsnap_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_wal : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): wal_off, or PXT_DECODE_BAD. Labels prefixed pxt_rwal_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rwal_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp pxt_rwal_out;
      pxt_rwal_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rwal_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_bytes : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bytes_touched, or PXT_DECODE_BAD. Labels prefixed pxt_rbytes_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rbytes_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp pxt_rbytes_out;
      pxt_rbytes_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rbytes_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): state byte, or PXT_DECODE_BAD. Labels prefixed pxt_rstate_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rstate_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp pxt_rstate_out;
      pxt_rstate_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rstate_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): mode byte, or PXT_DECODE_BAD. Labels prefixed pxt_rmode_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rmode_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        jmp pxt_rmode_out;
      pxt_rmode_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rmode_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_row_transition(row_id, new_state) -> PXT_OK | PXT_BAD_TRANSITION
  //                                              | PXT_DECODE_BAD
  //
  // R42-PREP-007 (#1629): the ONLY writer of the state byte after
  // mint.  Rewrites the row's header bits [15:8] from OPEN (1) to
  // `new_state` iff the row is (a) live, (b) currently OPEN.  The
  // OPEN gate is what makes COMMIT and ABORT one-shot: a second call
  // on either state (COMMITTED or ABORTED) is refused with
  // PXT_BAD_TRANSITION rather than silently no-op'd -- an operator
  // debugging a stuck transaction should see the refusal in the
  // failure taxonomy, not have to infer it from a missing counter
  // bump.  new_state values are the caller's responsibility to keep
  // in [PXT_STATE_OPEN..PXT_STATE_EXPIRED]; this helper does not
  // re-validate because its only callers are the hard-coded
  // cap_handler_pdxfs_txn COMMIT / ABORT paths that pass literal
  // 2 / 3 respectively.  A single push (r12) preserves row_id
  // across the pdxfs_txn_tail_valid call and leaves rsp%16 == 0.
  // ==========================================================================
  pub let pdxfs_txn_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-007 (#1629): OPEN -> new_state on the row's header state byte. Sequence: (1) pdxfs_txn_tail_valid gate -- an out-of-range or freed row returns PXT_DECODE_BAD (matches every other pdxfs_txn_row_ decoder's shape). (2) Load header at [row+0]; extract current state byte (bits [15:8]); require == PXT_STATE_OPEN (1). Any other current state (COMMITTED / ABORTED / EXPIRED) returns PXT_BAD_TRANSITION so a duplicate commit or an abort-after-commit is caught. (3) Clear state byte via `and hdr, ~0xFF00`; OR in new_state << 8; store back to [row+0]. Row stride math (row * 48 = row * 32 + row * 16) mirrors every other pdxfs_txn_row_* accessor. Two push (r12 + r13) preserve row_id and new_state across the pdxfs_txn_tail_valid call and leave rsp%16 == 0. new_state validation is the caller's responsibility -- literal 2 / 3 from the hard-coded COMMIT / ABORT paths only. Labels prefixed pxt_tr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // new_state

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_tr_bad;

        // Load header.
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];

        // Extract current state byte.
        mov rcx, rax;
        shr rcx, 8;
        and rcx, 0xFF;
        cmp rcx, 1;                      // PXT_STATE_OPEN
        jne pxt_tr_no;

        // Clear state byte (bits [15:8]) and OR in new_state << 8.
        mov r11, 0xFFFFFFFFFFFF00FF;     // ~0xFF00 mask -- staged in r11
        and rax, r11;
        mov r11, r13;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;                    // PXT_OK
        jmp pxt_tr_out;

      pxt_tr_no:
        mov rax, 0xFFFFEC15;             // PXT_BAD_TRANSITION
        jmp pxt_tr_out;
      pxt_tr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // PXT_DECODE_BAD

      pxt_tr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): slot -> row_id, gated on the descriptor being a live KIND_PDXFS_TXN. Kind constant 0x196 staged in r11. Labels prefixed pxt_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae pxt_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x196;                  // KIND_PDXFS_TXN
        cmp r10, r11;
        jne pxt_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_ros_none;

        mov rax, r12;
        jmp pxt_ros_out;

      pxt_ros_none:
        mov rax, 0xFF;                   // PXT_ROW_NONE
      pxt_ros_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): scrub row + bump REVOKES; distinguishes never-existed (BAD_SLOT) from already-gone (REVOKE_ALREADY). Two callee-save pushes leave rsp%16 == 0. Labels prefixed pxt_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae pxt_cr_bad_slot;

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_cr_already;

        mov rdi, r12;
        call pdxfs_txn_tail_free;
        mov rdi, 1;                      // PXT_ST_REVOKES
        call pdxfs_txn_note;
        xor rax, rax;
        jmp pxt_cr_out;

      pxt_cr_bad_slot:
        mov rax, 0xFFFFEC18;             // PXT_BAD_SLOT
        jmp pxt_cr_out;
      pxt_cr_already:
        mov rax, 0xFFFFEC16;             // PXT_REVOKE_ALREADY

      pxt_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (txn_id: u64) (mode: u64) (wal_off: u64) (snap_gen: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): the KIND_PDXFS_TXN mint walker. Gates in order: (1) parent gate; (2) rights subset; (3) mode_valid; (4) hdr_pack (mode, state=OPEN); (5) tail_alloc. expire_ns and snap_gen are populated from the args; bytes_touched starts at 0. Six callee-save pushes + sub rsp, 8 = 56 bytes; post-prologue rsp%16 == 0. Labels prefixed pxt_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // txn_id
        mov r14, rcx;                    // mode
        mov r15, r8;                     // wal_off
        mov rbp, r9;                     // snap_gen

        // (1)
        mov rdi, r12;
        call pdxfs_txn_check_parent_memory;
        cmp rax, 0;
        je  pxt_mi_bad_parent;

        // (2)
        mov rdi, r13;
        call pdxfs_txn_rights_valid;
        cmp rax, 0;
        je  pxt_mi_bad_rights;

        // (3)
        mov rdi, r14;
        call pdxfs_txn_mode_valid;
        cmp rax, 0;
        je  pxt_mi_bad_mode;

        // (4) Pack header with state=OPEN.
        mov rdi, r14;                    // mode
        mov rsi, 1;                      // state = OPEN
        call pdxfs_txn_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pxt_mi_bad_state;

        // (5) tail_alloc(hdr, txn_id, snap_gen, wal_off, expire_ns=0).
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // txn_id
        mov rdx, rbp;                    // snap_gen
        mov rcx, r15;                    // wal_off
        xor r8,  r8;                     // expire_ns = 0 (no deadline for M1)
        call pdxfs_txn_tail_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae pxt_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // PXT_ST_MINTS
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_mi_out;

      pxt_mi_alloc_fail:
        jmp pxt_mi_refused;
      pxt_mi_bad_parent:
        mov rax, 0xFFFFEC1D;             // PXT_MINT_BAD_PARENT
        jmp pxt_mi_refused;
      pxt_mi_bad_rights:
        mov rax, 0xFFFFEC1C;
        jmp pxt_mi_refused;
      pxt_mi_bad_mode:
        mov rax, 0xFFFFEC1A;
        jmp pxt_mi_refused;
      pxt_mi_bad_state:
        mov rax, 0xFFFFEC19;

      pxt_mi_refused:
        push rax;
        mov rdi, 3;                      // PXT_ST_REFUSED
        call pdxfs_txn_note;
        pop rax;

      pxt_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_commit_wal(row_id) -> u64
  //
  // R52.M6-004 (#1712): the on-disk half of PXT_OP_COMMIT, called by
  // cap_handler_pdxfs_txn's pxt_hn_commit arm BEFORE the OPEN ->
  // COMMITTED state transition (design/filesystem/volume-fs-
  // substrate.md §4.4: "write JOP_COMMIT to the journal + BD_OP_FLUSH
  // + transition the row state ... the new work happens before it").
  //
  // Single-mounted-root-volume scope (R52; journal_ondisk.pdx's own
  // gap 5 note: "R52 mounts the root volume only"). KIND_PDXFS_TXN's
  // 48-B row does not (and per volume-fs-substrate.md §6.3 must not)
  // carry a vol_slot -- the mint gate only ever checked the parent
  // was KIND_MEMORY, so a txn opened before any PdxFS-block volume
  // was mounted is indistinguishable, at the row level, from one
  // opened after. This helper resolves the volume the SAME way
  // `mount_pdxfs_block` (#1707) installs it: `_mount_table
  // [MOUNT_ROOT_SLOT]`'s backend == MOUNT_BACKEND_PDXFS_BLOCK (5)
  // names the mounted KIND_VOLUME row via the `reserved` field (bits
  // [48,64), `row_id & 0xFFFF`, per mount_block.pdx's own packing
  // comment).
  //
  // No block-backed root mount (e.g. every existing witness in
  // tests/kernel/pdxfs_txn/pdxfs_txn_ops_synth.pdx, which mints a
  // txn over a synthetic KIND_MEMORY parent with no volume mounted
  // at all) is NOT an error here -- it means "nothing to journal",
  // matching R48b/R42-PREP-007's existing COMMIT contract (a bare row
  // transition, rax == PXT_OK) so this landing does not regress any
  // already-passing witness. A block-backed root IS mounted but
  // `volume_row_device_slot` / `sb_read` / `journal_append` /
  // `jnl_bdev_flush` fails for real is a genuine failure: that error
  // code is forwarded verbatim to the caller and the row stays OPEN
  // (no transition attempted), so a caller can retry the commit or
  // fall back to PXT_OP_ABORT.
  //
  // journal_encode_commit's payload is `final_content_hash:u64`
  // (volume-fs-substrate.md §2.4). Gap: no upstream walker computes a
  // real content hash yet (PXT_OP_CREATE/RENAME/UNLINK, #1709-1711,
  // are still PXT_STUB_OK stubs at this landing) -- this helper
  // passes 0 as a documented placeholder until one of those lands and
  // threads a real hash through the row or an out-of-band scratch.
  //
  // The explicit `jnl_bdev_flush` call after `journal_append` is
  // deliberately redundant with `journal_append`'s OWN internal
  // per-record durability barrier (journal_ondisk.pdx gap 7: "write
  // payload -> FLUSH -> compute + write csum" already flushes before
  // the record's checksum lands) -- issue #1712 and §4.4 both name
  // BD_OP_FLUSH as its own step following the JOP_COMMIT append, and
  // the R52.M6 R51-gate line is explicit ("Every COMMIT calls
  // FLUSH"). Keeping it a separate, named call makes that guarantee
  // load-bearing at the JOP_COMMIT layer itself rather than an
  // incidental consequence of the record-write barrier.
  //
  // Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) + `sub rsp, 8`
  // pad lands rsp%16==0 for every nested call (identical shape to
  // `pdxfs_txn_cap_mint_inner`). Register plan: r12=row_id,
  // rbx=vol_slot, r14=bdev_cap, r13=journal_lba, r15=sb_ptr then
  // journal_bcount (sb_ptr is dead once both superblock fields are
  // read), rbp=txn_id. Arity 1; every nested call is arity <= 6
  // (journal_append is the widest, at 6). Labels prefixed pxcw_.
  // ==========================================================================
  pub let mut _pxt_commit_scratch : [u64; 4] = uninit @align(8)

  pub let pdxfs_txn_commit_wal : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M6-004 (#1712): see the block-level header comment above this function for the full rationale (single-root-volume resolution via _mount_table, no-mount-is-not-an-error, redundant-but-explicit FLUSH, final_content_hash=0 placeholder gap). Labels prefixed pxcw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // row_id

        // (1) Resolve the mounted root PdxFS-block volume, if any.
        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];               // MOUNT_ROOT_SLOT = 0
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFF;                     // backend_type
        cmp r11, 5;                        // MOUNT_BACKEND_PDXFS_BLOCK
        jne pxcw_none;

        mov rbx, rax;
        shr rbx, 48;
        and rbx, 0xFFFF;                   // rbx = vol_slot

        // (2) bdev_cap for that volume.
        mov rdi, rbx;
        call volume_row_device_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;       // VOL_DECODE_BAD
        cmp rax, r10;
        je  pxcw_none;                     // dead volume row -- treat as unmounted
        mov r14, rax;                      // r14 = bdev_cap

        // (3) Re-read the superblock for journal_lba/journal_bcount
        //     (KIND_VOLUME's row does not cache them).
        mov rdi, r14;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb  pxcw_err;                      // sb_read's own error sentinel, forwarded verbatim
        mov r15, rax;                      // r15 = sb_ptr

        mov rdi, r15;
        call sb_journal_lba;
        mov r13, rax;                      // r13 = journal_lba

        mov rdi, r15;
        call sb_journal_bcount;
        mov r15, rax;                      // r15 = journal_bcount (sb_ptr dead)

        // (4) txn_id for the record.
        mov rdi, r12;
        call pdxfs_txn_row_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;       // PXT_DECODE_BAD
        cmp rax, r10;
        je  pxcw_err;
        mov rbp, rax;                      // rbp = txn_id

        // (5) Encode JOP_COMMIT (final_content_hash=0 placeholder --
        //     see header gap note).
        mov rdi, rbp;
        xor rsi, rsi;
        lea rdx, [rip + _pxt_commit_scratch];
        call journal_encode_commit;

        // (6) Append to the ring.
        mov r9, rax;                       // record_len
        lea r8, [rip + _pxt_commit_scratch];
        mov rcx, r15;                      // journal_bcount
        mov rdx, r13;                      // journal_lba
        mov rsi, rbx;                      // vol_slot
        mov rdi, r14;                      // bdev_cap
        call journal_append;
        cmp rax, 0;
        jne pxcw_err;

        // (7) Explicit BD_OP_FLUSH (#1651) -- see header note on why
        //     this is kept as its own step.
        mov rdi, r14;
        call jnl_bdev_flush;
        cmp rax, 0;
        jne pxcw_err;

      pxcw_none:
        xor rax, rax;
        jmp pxcw_out;

      pxcw_err:
        // rax already holds the failing call's own error code.
        jmp pxcw_out;

      pxcw_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cap_handler_pdxfs_txn : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): KIND_PDXFS_TXN dispatch. Query ops need R_PDXFS_TXN_INVOKE (0x008); DEBUG_PRINT needs R_PDXFS_TXN_OBSERVE (0x400). op_arg[63:8] refused. R42-PREP-007 (#1629): added COMMIT (7), ABORT (8), CREATE (9), RENAME (10), UNLINK (11); all five need R_PDXFS_TXN_INVOKE. COMMIT / ABORT delegate to pdxfs_txn_row_transition (OPEN -> COMMITTED / ABORTED gate) and bump PXT_ST_COMMITS / PXT_ST_ABORTS only on a successful transition; CREATE / RENAME / UNLINK are wire-only STUBs that bump their own per-op counter and return PXT_STUB_OK (0xFFFFEBFB) so the R49 tooling wave links against real op codes even though the walker body arrives later. Op-max widened from 6 to 11 in step; PXT_OP_MAX in the module header carries the same number. Labels prefixed pxt_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne pxt_hn_res;

        cmp rbp, 11;                     // PXT_OP_MAX (was 6; R42-PREP-007)
        ja  pxt_hn_unsup;

        cmp rbp, 6;                      // DEBUG_PRINT
        je  pxt_hn_dbg;

        mov r10, r12;
        and r10, 0x008;                  // R_PDXFS_TXN_INVOKE
        cmp r10, 0;
        je  pxt_hn_denied;

        // Query ops 0..5 use row_id -> arg0 and land in pxt_hn_count.
        mov rdi, r13;
        cmp rbp, 0;
        je  pxt_hn_id;
        cmp rbp, 1;
        je  pxt_hn_snap;
        cmp rbp, 2;
        je  pxt_hn_wal;
        cmp rbp, 3;
        je  pxt_hn_bytes;
        cmp rbp, 4;
        je  pxt_hn_state;
        cmp rbp, 5;
        je  pxt_hn_mode;
        // R42-PREP-007 (#1629): write-side ops 7..11.
        cmp rbp, 7;
        je  pxt_hn_commit;
        cmp rbp, 8;
        je  pxt_hn_abort;
        cmp rbp, 9;
        je  pxt_hn_create;
        cmp rbp, 10;
        je  pxt_hn_rename;
        // Fall-through: op == 11 (UNLINK)
        jmp pxt_hn_unlink;

      pxt_hn_id:
        call pdxfs_txn_row_id;
        jmp pxt_hn_count;
      pxt_hn_snap:
        call pdxfs_txn_row_snap;
        jmp pxt_hn_count;
      pxt_hn_wal:
        call pdxfs_txn_row_wal;
        jmp pxt_hn_count;
      pxt_hn_bytes:
        call pdxfs_txn_row_bytes;
        jmp pxt_hn_count;
      pxt_hn_state:
        call pdxfs_txn_row_state;
        jmp pxt_hn_count;
      pxt_hn_mode:
        call pdxfs_txn_row_mode;
        jmp pxt_hn_count;

      // R42-PREP-007 (#1629): COMMIT -- OPEN -> COMMITTED (2).  Bumps
      // PXT_ST_COMMITS iff the transition succeeded (rax == 0), so
      // an operator counting mutations does not see a bump when the
      // handler refused a duplicate.
      // R52.M6-004 (#1712): before the transition, pdxfs_txn_commit_
      // wal(row_id) writes a REAL on-disk JOP_COMMIT record + issues
      // BD_OP_FLUSH (#1651) against the mounted root PdxFS-block
      // volume, if any -- see that function's own header comment for
      // the full rationale (single-root-volume resolution, no-mount-
      // is-not-an-error, the deliberately redundant explicit FLUSH).
      // A real journal/FLUSH failure is forwarded verbatim WITHOUT
      // attempting the transition or bumping PXT_ST_COMMITS, so a
      // caller can never observe COMMITTED state with no
      // corresponding journal record. r13 (row_id) is callee-save and
      // survives the nested call by ABI convention.
      pxt_hn_commit:
        mov rdi, r13;
        call pdxfs_txn_commit_wal;
        cmp rax, 0;
        jne pxt_hn_out;

        mov rdi, r13;
        mov rsi, 2;                      // PXT_STATE_COMMITTED
        call pdxfs_txn_row_transition;
        cmp rax, 0;
        jne pxt_hn_out;
        push rax;
        mov rdi, 4;                      // PXT_ST_COMMITS
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      // R42-PREP-007 (#1629): ABORT -- OPEN -> ABORTED (3).  Mirror
      // of the COMMIT path with a different target state and stats
      // slot.  Same one-shot semantics: a second abort (or an abort
      // after a commit) returns PXT_BAD_TRANSITION and does not bump.
      pxt_hn_abort:
        mov rsi, 3;                      // PXT_STATE_ABORTED
        call pdxfs_txn_row_transition;
        cmp rax, 0;
        jne pxt_hn_out;
        push rax;
        mov rdi, 5;                      // PXT_ST_ABORTS
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      // R42-PREP-007 (#1629): CREATE / RENAME / UNLINK STUBs.  Each
      // bumps its own counter unconditionally on op-entry (a STUB
      // that never wrote its counter would be indistinguishable from
      // an un-wired op at operator time) then returns PXT_STUB_OK.
      // The row_id in rdi is not consulted -- the walker body that
      // eventually replaces this STUB will use it to name which
      // per-txn write group the mutation joins.
      pxt_hn_create:
        mov rdi, 6;                      // PXT_ST_CREATES
        call pdxfs_txn_note;
        mov rax, 0xFFFFEBFB;             // PXT_STUB_OK
        jmp pxt_hn_out;

      pxt_hn_rename:
        mov rdi, 7;                      // PXT_ST_RENAMES
        call pdxfs_txn_note;
        mov rax, 0xFFFFEBFB;             // PXT_STUB_OK
        jmp pxt_hn_out;

      pxt_hn_unlink:
        mov rdi, 8;                      // PXT_ST_UNLINKS
        call pdxfs_txn_note;
        mov rax, 0xFFFFEBFB;             // PXT_STUB_OK
        jmp pxt_hn_out;

      pxt_hn_count:
        push rax;
        mov rdi, 2;                      // PXT_ST_QUERIES
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      pxt_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  pxt_hn_denied;
        xor rax, rax;
        jmp pxt_hn_out;

      pxt_hn_res:
        mov rax, 0xFFFFEC1E;
        jmp pxt_hn_out;
      pxt_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp pxt_hn_out;
      pxt_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      pxt_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
