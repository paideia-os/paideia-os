  pub let pdxfs_txn_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): mode byte, or PXT_DECODE_BAD. Labels prefixed pxt_rmode_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rmode_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        jmp pxt_rmode_out;
      pxt_rmode_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rmode_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_row_transition(row_id, new_state) -> PXT_OK | PXT_BAD_TRANSITION
  //                                              | PXT_DECODE_BAD
  //
  // R42-PREP-007 (#1629): the ONLY writer of the state byte after
  // mint.  Rewrites the row's header bits [15:8] from OPEN (1) to
  // `new_state` iff the row is (a) live, (b) currently OPEN.  The
  // OPEN gate is what makes COMMIT and ABORT one-shot: a second call
  // on either state (COMMITTED or ABORTED) is refused with
  // PXT_BAD_TRANSITION rather than silently no-op'd -- an operator
  // debugging a stuck transaction should see the refusal in the
  // failure taxonomy, not have to infer it from a missing counter
  // bump.  new_state values are the caller's responsibility to keep
  // in [PXT_STATE_OPEN..PXT_STATE_EXPIRED]; this helper does not
  // re-validate because its only callers are the hard-coded
  // cap_handler_pdxfs_txn COMMIT / ABORT paths that pass literal
  // 2 / 3 respectively.  A single push (r12) preserves row_id
  // across the pdxfs_txn_tail_valid call and leaves rsp%16 == 0.
  // ==========================================================================
  pub let pdxfs_txn_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-007 (#1629): OPEN -> new_state on the row's header state byte. Sequence: (1) pdxfs_txn_tail_valid gate -- an out-of-range or freed row returns PXT_DECODE_BAD (matches every other pdxfs_txn_row_ decoder's shape). (2) Load header at [row+0]; extract current state byte (bits [15:8]); require == PXT_STATE_OPEN (1). Any other current state (COMMITTED / ABORTED / EXPIRED) returns PXT_BAD_TRANSITION so a duplicate commit or an abort-after-commit is caught. (3) Clear state byte via `and hdr, ~0xFF00`; OR in new_state << 8; store back to [row+0]. Row stride math (row * 48 = row * 32 + row * 16) mirrors every other pdxfs_txn_row_* accessor. Two push (r12 + r13) preserve row_id and new_state across the pdxfs_txn_tail_valid call and leave rsp%16 == 0. new_state validation is the caller's responsibility -- literal 2 / 3 from the hard-coded COMMIT / ABORT paths only. Labels prefixed pxt_tr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // new_state

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_tr_bad;

        // Load header.
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];

        // Extract current state byte.
        mov rcx, rax;
        shr rcx, 8;
        and rcx, 0xFF;
        cmp rcx, 1;                      // PXT_STATE_OPEN
        jne pxt_tr_no;

        // Clear state byte (bits [15:8]) and OR in new_state << 8.
        mov r11, 0xFFFFFFFFFFFF00FF;     // ~0xFF00 mask -- staged in r11
        and rax, r11;
        mov r11, r13;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;                    // PXT_OK
        jmp pxt_tr_out;

      pxt_tr_no:
        mov rax, 0xFFFFEC15;             // PXT_BAD_TRANSITION
        jmp pxt_tr_out;
      pxt_tr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // PXT_DECODE_BAD

      pxt_tr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): slot -> row_id, gated on the descriptor being a live KIND_PDXFS_TXN. Kind constant 0x196 staged in r11. Labels prefixed pxt_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae pxt_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x196;                  // KIND_PDXFS_TXN
        cmp r10, r11;
        jne pxt_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_ros_none;

        mov rax, r12;
        jmp pxt_ros_out;

      pxt_ros_none:
        mov rax, 0xFF;                   // PXT_ROW_NONE
      pxt_ros_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): scrub row + bump REVOKES; distinguishes never-existed (BAD_SLOT) from already-gone (REVOKE_ALREADY). Two callee-save pushes leave rsp%16 == 0. Labels prefixed pxt_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae pxt_cr_bad_slot;

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_cr_already;

        mov rdi, r12;
        call pdxfs_txn_tail_free;
        mov rdi, 1;                      // PXT_ST_REVOKES
        call pdxfs_txn_note;
        xor rax, rax;
        jmp pxt_cr_out;

      pxt_cr_bad_slot:
        mov rax, 0xFFFFEC18;             // PXT_BAD_SLOT
        jmp pxt_cr_out;
      pxt_cr_already:
        mov rax, 0xFFFFEC16;             // PXT_REVOKE_ALREADY

      pxt_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (txn_id: u64) (mode: u64) (wal_off: u64) (snap_gen: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): the KIND_PDXFS_TXN mint walker. Gates in order: (1) parent gate; (2) rights subset; (3) mode_valid; (4) hdr_pack (mode, state=OPEN); (5) tail_alloc. expire_ns and snap_gen are populated from the args; bytes_touched starts at 0. Six callee-save pushes + sub rsp, 8 = 56 bytes; post-prologue rsp%16 == 0. Labels prefixed pxt_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // txn_id
        mov r14, rcx;                    // mode
        mov r15, r8;                     // wal_off
        mov rbp, r9;                     // snap_gen

        // (1)
        mov rdi, r12;
        call pdxfs_txn_check_parent_memory;
        cmp rax, 0;
        je  pxt_mi_bad_parent;

        // (2)
        mov rdi, r13;
        call pdxfs_txn_rights_valid;
        cmp rax, 0;
        je  pxt_mi_bad_rights;

        // (3)
        mov rdi, r14;
        call pdxfs_txn_mode_valid;
        cmp rax, 0;
        je  pxt_mi_bad_mode;

        // (4) Pack header with state=OPEN.
        mov rdi, r14;                    // mode
        mov rsi, 1;                      // state = OPEN
        call pdxfs_txn_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pxt_mi_bad_state;

        // (5) tail_alloc(hdr, txn_id, snap_gen, wal_off, expire_ns=0).
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // txn_id
        mov rdx, rbp;                    // snap_gen
        mov rcx, r15;                    // wal_off
        xor r8,  r8;                     // expire_ns = 0 (no deadline for M1)
        call pdxfs_txn_tail_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae pxt_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // PXT_ST_MINTS
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_mi_out;

      pxt_mi_alloc_fail:
        jmp pxt_mi_refused;
      pxt_mi_bad_parent:
        mov rax, 0xFFFFEC1D;             // PXT_MINT_BAD_PARENT
        jmp pxt_mi_refused;
      pxt_mi_bad_rights:
        mov rax, 0xFFFFEC1C;
        jmp pxt_mi_refused;
      pxt_mi_bad_mode:
        mov rax, 0xFFFFEC1A;
        jmp pxt_mi_refused;
      pxt_mi_bad_state:
        mov rax, 0xFFFFEC19;

      pxt_mi_refused:
        push rax;
        mov rdi, 3;                      // PXT_ST_REFUSED
        call pdxfs_txn_note;
        pop rax;

      pxt_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_commit_wal(row_id) -> u64
  //
  // R52.M6-004 (#1712): the on-disk half of PXT_OP_COMMIT, called by
  // cap_handler_pdxfs_txn's pxt_hn_commit arm BEFORE the OPEN ->
  // COMMITTED state transition (design/filesystem/volume-fs-
  // substrate.md §4.4: "write JOP_COMMIT to the journal + BD_OP_FLUSH
  // + transition the row state ... the new work happens before it").
  //
  // Single-mounted-root-volume scope (R52; journal_ondisk.pdx's own
  // gap 5 note: "R52 mounts the root volume only"). KIND_PDXFS_TXN's
  // 48-B row does not (and per volume-fs-substrate.md §6.3 must not)
  // carry a vol_slot -- the mint gate only ever checked the parent
  // was KIND_MEMORY, so a txn opened before any PdxFS-block volume
  // was mounted is indistinguishable, at the row level, from one
  // opened after. This helper resolves the volume the SAME way
  // `mount_pdxfs_block` (#1707) installs it: `_mount_table
  // [MOUNT_ROOT_SLOT]`'s backend == MOUNT_BACKEND_PDXFS_BLOCK (5)
  // names the mounted KIND_VOLUME row via the `reserved` field (bits
  // [48,64), `row_id & 0xFFFF`, per mount_block.pdx's own packing
  // comment).
  //
  // No block-backed root mount (e.g. every existing witness in
  // tests/kernel/pdxfs_txn/pdxfs_txn_ops_synth.pdx, which mints a
  // txn over a synthetic KIND_MEMORY parent with no volume mounted
  // at all) is NOT an error here -- it means "nothing to journal",
  // matching R48b/R42-PREP-007's existing COMMIT contract (a bare row
  // transition, rax == PXT_OK) so this landing does not regress any
  // already-passing witness. A block-backed root IS mounted but
  // `volume_row_device_slot` / `sb_read` / `journal_append` /
  // `jnl_bdev_flush` fails for real is a genuine failure: that error
  // code is forwarded verbatim to the caller and the row stays OPEN
  // (no transition attempted), so a caller can retry the commit or
  // fall back to PXT_OP_ABORT.
  //
  // journal_encode_commit's payload is `final_content_hash:u64`
  // (volume-fs-substrate.md §2.4). Gap: no upstream walker computes a
  // real content hash yet (PXT_OP_CREATE/RENAME/UNLINK, #1709-1711,
  // are still PXT_STUB_OK stubs at this landing) -- this helper
  // passes 0 as a documented placeholder until one of those lands and
  // threads a real hash through the row or an out-of-band scratch.
  //
  // The explicit `jnl_bdev_flush` call after `journal_append` is
  // deliberately redundant with `journal_append`'s OWN internal
  // per-record durability barrier (journal_ondisk.pdx gap 7: "write
  // payload -> FLUSH -> compute + write csum" already flushes before
  // the record's checksum lands) -- issue #1712 and §4.4 both name
  // BD_OP_FLUSH as its own step following the JOP_COMMIT append, and
  // the R52.M6 R51-gate line is explicit ("Every COMMIT calls
  // FLUSH"). Keeping it a separate, named call makes that guarantee
  // load-bearing at the JOP_COMMIT layer itself rather than an
  // incidental consequence of the record-write barrier.
  //
  // Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) + `sub rsp, 8`
  // pad lands rsp%16==0 for every nested call (identical shape to
  // `pdxfs_txn_cap_mint_inner`). Register plan: r12=row_id,
  // rbx=vol_slot, r14=bdev_cap, r13=journal_lba, r15=sb_ptr then
  // journal_bcount (sb_ptr is dead once both superblock fields are
  // read), rbp=txn_id. Arity 1; every nested call is arity <= 6
  // (journal_append is the widest, at 6). Labels prefixed pxcw_.
  // ==========================================================================
  pub let mut _pxt_commit_scratch : [u64; 4] = uninit @align(8)

  pub let pdxfs_txn_commit_wal : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M6-004 (#1712): see the block-level header comment above this function for the full rationale (single-root-volume resolution via _mount_table, no-mount-is-not-an-error, redundant-but-explicit FLUSH, final_content_hash=0 placeholder gap). Labels prefixed pxcw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // row_id

        // (1) Resolve the mounted root PdxFS-block volume, if any.
        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];               // MOUNT_ROOT_SLOT = 0
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFF;                     // backend_type
        cmp r11, 5;                        // MOUNT_BACKEND_PDXFS_BLOCK
        jne pxcw_none;

        mov rbx, rax;
        shr rbx, 48;
        and rbx, 0xFFFF;                   // rbx = vol_slot

        // (2) bdev_cap for that volume.
        mov rdi, rbx;
        call volume_row_device_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;       // VOL_DECODE_BAD
        cmp rax, r10;
        je  pxcw_none;                     // dead volume row -- treat as unmounted
        mov r14, rax;                      // r14 = bdev_cap

        // (3) Re-read the superblock for journal_lba/journal_bcount
        //     (KIND_VOLUME's row does not cache them).
        mov rdi, r14;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb  pxcw_err;                      // sb_read's own error sentinel, forwarded verbatim
        mov r15, rax;                      // r15 = sb_ptr

        mov rdi, r15;
        call sb_journal_lba;
        mov r13, rax;                      // r13 = journal_lba

        mov rdi, r15;
        call sb_journal_bcount;
        mov r15, rax;                      // r15 = journal_bcount (sb_ptr dead)

        // (4) txn_id for the record.
        mov rdi, r12;
        call pdxfs_txn_row_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;       // PXT_DECODE_BAD
        cmp rax, r10;
        je  pxcw_err;
        mov rbp, rax;                      // rbp = txn_id

        // (5) Encode JOP_COMMIT (final_content_hash=0 placeholder --
        //     see header gap note).
        mov rdi, rbp;
        xor rsi, rsi;
        lea rdx, [rip + _pxt_commit_scratch];
        call journal_encode_commit;

        // (6) Append to the ring.
        mov r9, rax;                       // record_len
        lea r8, [rip + _pxt_commit_scratch];
        mov rcx, r15;                      // journal_bcount
        mov rdx, r13;                      // journal_lba
        mov rsi, rbx;                      // vol_slot
        mov rdi, r14;                      // bdev_cap
        call journal_append;
        cmp rax, 0;
        jne pxcw_err;

        // (7) Explicit BD_OP_FLUSH (#1651) -- see header note on why
        //     this is kept as its own step.
        mov rdi, r14;
        call jnl_bdev_flush;
        cmp rax, 0;
        jne pxcw_err;

      pxcw_none:
        xor rax, rax;
        jmp pxcw_out;

      pxcw_err:
        // rax already holds the failing call's own error code.
        jmp pxcw_out;

      pxcw_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_abort_wal(row_id) -> u64
  //
  // R52.M6-005 (#1713): the on-disk half of PXT_OP_ABORT, called by
  // cap_handler_pdxfs_txn's pxt_hn_abort arm BEFORE the OPEN ->
  // ABORTED state transition. Mirrors pdxfs_txn_commit_wal (#1712,
  // above) one-for-one in its root-volume resolution steps -- same
  // `_mount_table[MOUNT_ROOT_SLOT]` lookup, same "no block-backed root
  // mount is not an error" contract (every existing witness in
  // tests/kernel/pdxfs_txn/pdxfs_txn_ops_synth.pdx mints a txn over a
  // synthetic KIND_MEMORY parent with no volume ever mounted, so this
  // landing does not regress it) -- but encodes JOP_ABORT (empty
  // payload, journal_encode_abort) instead of JOP_COMMIT, and per
  // design/filesystem/r52-implementation-plan.md §M6-005 ("emit
  // JOP_ABORT + row transition OPEN -> ABORTED (no data-region
  // writes)") does NOT issue an explicit BD_OP_FLUSH -- only COMMIT's
  // plan line item (§M6-004) names BD_OP_FLUSH explicitly;
  // `journal_append`'s own internal per-record durability barrier
  // (journal_ondisk.pdx gap 7: "write payload -> FLUSH -> compute +
  // write csum") is sufficient for the abort marker's own durability.
  //
  // A block-backed root IS mounted but `volume_row_device_slot` /
  // `sb_read` / `journal_append` fails for real is a genuine failure:
  // that error code is forwarded verbatim to the caller and the row
  // stays OPEN (no transition attempted), so a caller can retry the
  // abort or observe the failure directly rather than silently losing
  // the journal record for a state the row claims to be in.
  //
  // Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) + `sub rsp, 8`
  // pad lands rsp%16==0 for every nested call, identical shape to
  // `pdxfs_txn_commit_wal`. Register plan: r12=row_id, rbx=vol_slot,
  // r14=bdev_cap, r13=journal_lba, r15=sb_ptr then journal_bcount
  // (sb_ptr is dead once both superblock fields are read), rbp=txn_id.
  // Arity 1; every nested call is arity <= 6 (journal_append is the
  // widest, at 6). Labels prefixed pxaw_.
  // ==========================================================================
  pub let mut _pxt_abort_scratch : [u64; 4] = uninit @align(8)

  pub let pdxfs_txn_abort_wal : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M6-005 (#1713): see the block-level header comment above this function for the full rationale (mirrors pdxfs_txn_commit_wal's resolution chain; JOP_ABORT instead of JOP_COMMIT; no explicit BD_OP_FLUSH per plan §M6-005's own wording). Labels prefixed pxaw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // row_id

        // (1) Resolve the mounted root PdxFS-block volume, if any.
        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];               // MOUNT_ROOT_SLOT = 0
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFF;                     // backend_type
        cmp r11, 5;                        // MOUNT_BACKEND_PDXFS_BLOCK
        jne pxaw_none;

        mov rbx, rax;
        shr rbx, 48;
        and rbx, 0xFFFF;                   // rbx = vol_slot (KIND_VOLUME row_id)

        // (2) bdev_cap for that volume.
        mov rdi, rbx;
        call volume_row_device_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;       // VOL_DECODE_BAD
        cmp rax, r10;
        je  pxaw_none;                     // dead volume row -- treat as unmounted
        mov r14, rax;                      // r14 = bdev_cap

        // (3) Re-read the superblock for journal_lba/journal_bcount
        //     (KIND_VOLUME's row does not cache them).
        mov rdi, r14;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb  pxaw_err;                      // sb_read's own error sentinel, forwarded verbatim
        mov r15, rax;                      // r15 = sb_ptr

        mov rdi, r15;
        call sb_journal_lba;
        mov r13, rax;                      // r13 = journal_lba

        mov rdi, r15;
        call sb_journal_bcount;
        mov r15, rax;                      // r15 = journal_bcount (sb_ptr dead)

        // (4) txn_id for the record.
        mov rdi, r12;
        call pdxfs_txn_row_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;       // PXT_DECODE_BAD
        cmp rax, r10;
        je  pxaw_err;
        mov rbp, rax;                      // rbp = txn_id

        // (5) Encode JOP_ABORT (empty payload).
        mov rdi, rbp;
        lea rsi, [rip + _pxt_abort_scratch];
        call journal_encode_abort;

        // (6) Append to the ring.
        mov r9, rax;                       // record_len
        lea r8, [rip + _pxt_abort_scratch];
        mov rcx, r15;                      // journal_bcount
        mov rdx, r13;                      // journal_lba
        mov rsi, rbx;                      // vol_slot
        mov rdi, r14;                      // bdev_cap
        call journal_append;
        cmp rax, 0;
        jne pxaw_err;

      pxaw_none:
        xor rax, rax;
        jmp pxaw_out;

      pxaw_err:
        // rax already holds the failing call's own error code.
        jmp pxaw_out;

      pxaw_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_stage_create_name(row_id, name_ptr, name_len) -> ()
  //
  // R52.M6-001 (#1709): a caller MUST call this for a given row_id
  // before invoking PXT_OP_CREATE on that row -- cap_invoke's 3-
  // register dispatch surface (rights, target_ptr, op_arg) has no room
  // left for a target name (op_arg's upper 56 bits are hard-refused by
  // cap_handler_pdxfs_txn for every op, not just CREATE, per that
  // function's own "op_arg[63:8] refused" gate), so the name travels
  // out-of-band via this per-row staging table instead, mirroring this
  // file's own established scratch-buffer idiom (_pxt_commit_scratch /
  // _pxt_abort_scratch, #1712/#1713) and the BDEV descriptor-page
  // pattern journal_ondisk.pdx uses for the identical "more data than
  // fits in registers" problem. KNOWN GAP: no caller in this landing
  // calls this function yet (vops_block.pdx's `_pdxfs_block_create_
  // stub` is still unwired to kind_pdxfs_txn.pdx per its own #1707
  // header note) -- flagged in the #1709 report for whichever issue
  // wires a real vops/syscall path to CREATE. Leaf, caller-save only.
  // Bound-check row_id<16 else no-op (matches journal_writer_set_
  // checkpoint's shape in journal_ondisk.pdx). row_base = &_pdxfs_txn_
  // create_name + row_id*16 (2 qwords/row). No test instruction.
  // Reserved labels: pscn_.
  // ==========================================================================
  pub let mut _pdxfs_txn_create_name : [u64; 32] = uninit @align(64)

  pub let pdxfs_txn_stage_create_name : (u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M6-001 (#1709). See the block-level header comment above. Leaf, caller-save only. Labels prefixed pscn_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae pscn_done;
        mov r10, rdi;
        shl r10, 4;
        lea r11, [rip + _pdxfs_txn_create_name];
        add r11, r10;
        mov [r11 + 0], rsi;
        mov [r11 + 8], rdx;
      pscn_done:
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_do_create(row_id) -> u64
  //
  // R52.M6-001 (#1709): the on-disk half of PXT_OP_CREATE, called by
  // cap_handler_pdxfs_txn's pxt_hn_create arm. Allocates a fresh inode
  // (inode_table.pdx's inode_alloc_fresh) and durably appends a REAL
  // JOP_INODE_WRITE record followed by a REAL JOP_DENTRY_ADD record
  // (journal_ondisk.pdx's journal_encode_inode_write / _dentry_add +
  // journal_append). Root-volume resolution mirrors pdxfs_txn_commit_
  // wal / pdxfs_txn_abort_wal (#1712/#1713) one-for-one: `_mount_table
  // [MOUNT_ROOT_SLOT]` -> KIND_VOLUME row_id -> volume_row_device_slot
  // -> bdev_cap -> sb_read -> sb_journal_lba/sb_journal_bcount for the
  // journal ring, PLUS (new here) sb_root_inode for the directory every
  // create targets -- #1709's own scope does not resolve an arbitrary
  // parent directory, only the mounted volume's root. JOP_BITMAP_SET
  // emission (named in design/filesystem/r52-implementation-plan.md
  // §2.6's #1709 line item, "if new inode-table block") is likewise out
  // of scope per the issue's own narrowed brief; flagged alongside
  // #1710/#1711 for a follow-up.
  //
  // UNLIKE commit_wal/abort_wal, a root that is not MOUNT_BACKEND_
  // PDXFS_BLOCK is a REAL refusal here (PXT_TAIL_BAD_ARG), not a
  // silent no-op: COMMIT/ABORT always have a meaningful "nothing to
  // journal, just transition the row" fallback, but CREATE has no
  // data-region write to skip -- fabricating PXT_OK with no inode and
  // no journal record would be a lie. The same refusal covers a dead
  // row_id and a missing/oversized (>400 B) staged target name
  // (pdxfs_txn_stage_create_name, above) -- reusing this module's own
  // pre-existing generic bad-arg code rather than claiming a second
  // M6-band slot for each distinct precondition, mirroring journal_
  // ondisk.pdx's own gap-3 precedent (one adjacent, already-frozen
  // code reused across a whole class of "cannot proceed" conditions).
  // TXN_CREATE_INODE_EXHAUSTED (0xFFFFED28) is reserved for the one
  // condition genuinely specific to this op: inode_alloc_fresh found
  // no free slot.
  //
  // Register/memory-lifetime plan: unlike commit_wal/abort_wal (5-6
  // live values, fits comfortably in 6 callee-save registers), CREATE
  // must shepherd 8 values (vol_slot, bdev_cap, journal_lba, journal_
  // bcount, dir_inode, txn_id, inode_no, sb_ptr) through two sequential
  // encode+append round trips. Rather than force that into 6
  // registers, every value except row_id is backed by the static
  // `_pxt_create_ctx` scratch row and reloaded fresh via caller-save
  // r10/r11 immediately before each use -- the same "reload rather
  // than cache across a nested call" discipline journal_append's own
  // header already documents the rationale for (avoids a silent
  // caller-save clobber). Only row_id survives in a register (rbx) --
  // a single push lands rsp%16==0 (odd push count, no pad, per
  // journal_ondisk.pdx's documented parity rule). Every nested call is
  // arity <= 6. Labels prefixed pdc_.
  // ==========================================================================
  pub let mut _pxt_create_ctx : [u64; 8] = uninit @align(64)
  // [+0] bdev_cap  [+8] vol_slot  [+16] journal_lba  [+24] journal_bcount
  // [+32] dir_inode (root_inode)  [+40] txn_id  [+48] inode_no
  // [+56] sb_ptr (transient scratch, dead once the three sb_* reads
  //        that use it complete)

  pub let mut _pdxfs_txn_inode_scratch : [u64; 16] = uninit @align(64)
  pub let mut _pdxfs_txn_jrec_scratch  : [u64; 64] = uninit @align(64)

  pub let pdxfs_txn_do_create : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M6-001 (#1709): see the block-level header comment above this function for the full rationale (resolution chain, refuse-not-noop posture, scratch-backed value lifetime). Labels prefixed pdc_.",
      block: {
        push rbx;

        mov rbx, rdi;                      // rbx = row_id, survives every call below

        // (1) row must be live.
        mov rdi, rbx;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je pdc_bad_arg;

        // (2) a target name must be staged, 0 < name_len <= 400 (fits
        //     _pdxfs_txn_jrec_scratch's 512 B with headroom -- see
        //     journal_encode_dentry_add's own record-length formula,
        //     40 + padded_name_len).
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _pdxfs_txn_create_name];
        add r11, r10;
        mov rax, [r11 + 8];
        cmp rax, 0;
        je pdc_bad_arg;
        mov r10, 400;
        cmp rax, r10;
        ja pdc_bad_arg;

        // (3) resolve the mounted root PdxFS-block volume (mirrors
        //     pdxfs_txn_commit_wal / pdxfs_txn_abort_wal step (1)).
        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];                 // MOUNT_ROOT_SLOT = 0
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFF;                      // backend_type
        cmp r11, 5;                         // MOUNT_BACKEND_PDXFS_BLOCK
        jne pdc_bad_arg;                    // no real volume -- refuse, do not fabricate success

        mov rcx, rax;
        shr rcx, 48;
        and rcx, 0xFFFF;                    // KIND_VOLUME row_id
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 8], rcx;                 // vol_slot

        // (4) bdev_cap.
        mov rdi, rcx;
        call volume_row_device_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;        // VOL_DECODE_BAD
        cmp rax, r10;
        je pdc_bad_arg;
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 0], rax;                 // bdev_cap

        // (5) sb_read -> sb_ptr (stashed transiently for the three
        //     accessor calls below).
        mov rdi, rax;                       // bdev_cap
        call sb_read;
        mov r10, 0xFFFF800000000000;        // KERNEL_VMA_BASE
        cmp rax, r10;
        jb pdc_bad_arg;
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 56], rax;                // sb_ptr

        lea r10, [rip + _pxt_create_ctx];
        mov rdi, [r10 + 56];
        call sb_journal_lba;
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 16], rax;                // journal_lba

        lea r10, [rip + _pxt_create_ctx];
        mov rdi, [r10 + 56];
        call sb_journal_bcount;
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 24], rax;                // journal_bcount

        lea r10, [rip + _pxt_create_ctx];
        mov rdi, [r10 + 56];
        call sb_root_inode;
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 32], rax;                // dir_inode

        // (6) txn_id.
        mov rdi, rbx;
        call pdxfs_txn_row_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;        // PXT_DECODE_BAD
        cmp rax, r10;
        je pdc_bad_arg;
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 40], rax;                // txn_id

        // (7) allocate a fresh inode.
        lea r10, [rip + _pxt_create_ctx];
        mov rdi, [r10 + 0];                 // bdev_cap
        call inode_alloc_fresh;
        mov r10, 0x1000000;
        cmp rax, r10;
        jae pdc_exhausted;
        lea r10, [rip + _pxt_create_ctx];
        mov [r10 + 48], rax;                // inode_no

        // (8) minimal 128-B inode row content -- mirrors inode_table.
        //     pdx's own inode_alloc_fresh construction (in_use=1,
        //     inode_no, refcount=1, everything else zero). This record
        //     reproduces exactly what inode_alloc_fresh already
        //     durably wrote in step (7) (that module's own documented
        //     immediate-commit posture, inode_table.pdx gap 1) -- a
        //     harmless, consistent replay rather than the sole writer.
        lea r10, [rip + _pdxfs_txn_inode_scratch];
        xor rax, rax;
        mov rcx, 0;
      pdc_izero:
        cmp rcx, 16;
        jae pdc_izero_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp pdc_izero;
      pdc_izero_done:
        lea r10, [rip + _pdxfs_txn_inode_scratch];
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;
        lea r11, [rip + _pxt_create_ctx];
        mov rax, [r11 + 48];                // inode_no
        mov [r10 + 8], rax;
        mov rax, 1;
        mov [r10 + 40], rax;

        // (9) encode + append JOP_INODE_WRITE.
        lea r10, [rip + _pxt_create_ctx];
        mov rdi, [r10 + 40];                // txn_id
        mov rsi, [r10 + 48];                // inode_no
        lea rdx, [rip + _pdxfs_txn_inode_scratch];
        lea rcx, [rip + _pdxfs_txn_jrec_scratch];
        call journal_encode_inode_write;
        mov r10, rax;                       // record_len

        lea r11, [rip + _pxt_create_ctx];
        mov rdi, [r11 + 0];                 // bdev_cap
        mov rsi, [r11 + 8];                 // vol_slot
        mov rdx, [r11 + 16];                // journal_lba
        mov rcx, [r11 + 24];                // journal_bcount
        lea r8, [rip + _pdxfs_txn_jrec_scratch];
        mov r9, r10;                        // record_len
        call journal_append;
        cmp rax, 0;
        jne pdc_out;

        // (10) encode + append JOP_DENTRY_ADD.
        mov r10, rbx;
        shl r10, 4;
        lea r11, [rip + _pdxfs_txn_create_name];
        add r11, r10;
        mov rax, [r11 + 0];                 // name_ptr
        mov rcx, [r11 + 8];                 // name_len (arg4 -- set now, untouched below)

        lea r9, [rip + _pxt_create_ctx];
        mov rdi, [r9 + 40];                 // txn_id
        mov rsi, [r9 + 32];                 // dir_inode
        mov r8,  [r9 + 48];                 // target_inode (inode_no)
        mov rdx, rax;                       // name_ptr
        lea r9, [rip + _pdxfs_txn_jrec_scratch];   // out_ptr
        call journal_encode_dentry_add;
        mov r10, rax;                       // record_len

        lea r11, [rip + _pxt_create_ctx];
        mov rdi, [r11 + 0];                 // bdev_cap
        mov rsi, [r11 + 8];                 // vol_slot
        mov rdx, [r11 + 16];                // journal_lba
        mov rcx, [r11 + 24];                // journal_bcount
        lea r8, [rip + _pdxfs_txn_jrec_scratch];
        mov r9, r10;                        // record_len
        call journal_append;
        cmp rax, 0;
        jne pdc_out;

        xor rax, rax;
        jmp pdc_out;

      pdc_exhausted:
        mov rax, 0xFFFFED28;                // TXN_CREATE_INODE_EXHAUSTED
        jmp pdc_out;
      pdc_bad_arg:
        mov rax, 0xFFFFEC1E;                // PXT_TAIL_BAD_ARG

      pdc_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_stage_rename_src(row_id, old_dir_inode, old_name_ptr,
  //                             old_name_len) -> ()
  // pdxfs_txn_stage_rename_dst(row_id, new_dir_inode, new_name_ptr,
  //                             new_name_len, target_inode) -> ()
  //
  // R52.M6-002 (#1710): a caller MUST call BOTH of these for a given
  // row_id before invoking PXT_OP_RENAME on that row -- mirrors
  // #1709's pdxfs_txn_stage_create_name shape one level wider: a
  // rename needs SEVEN fields (old_dir_inode/name_ptr/name_len,
  // new_dir_inode/name_ptr/name_len, target_inode), split across two
  // arity-bounded calls (4 + 5 args) since cap_invoke's single op_arg
  // register has no room for even one field, let alone seven (that
  // function's own "op_arg[63:8] refused" gate is unconditional,
  // per-op, not just for CREATE). Both stage into the SAME per-row
  // `_pdxfs_txn_rename_stage` table (16 rows x 56 bytes = 7 qwords/
  // row: old_dir_inode, old_name_ptr, old_name_len, new_dir_inode,
  // new_name_ptr, new_name_len, target_inode), mirroring
  // `_pdxfs_txn_create_name`'s row-indexed idiom widened for the
  // extra fields. Neither function validates its fields beyond the
  // row_id<16 bound check -- exactly like pdxfs_txn_stage_create_name,
  // ALL semantic validation (name_len bounds, dead row, wrong state)
  // is deferred to pdxfs_txn_do_rename at the point of actual
  // mutation, not duplicated into the setters. KNOWN GAP: no caller in
  // this landing calls either function yet (mirrors #1709's own
  // "no wired caller yet" gap -- vops_block.pdx's rename slot remains
  // unwired per that file's own #1707 header note); flagged for
  // whichever issue wires a real vops/syscall path to RENAME. Both
  // leaf, caller-save only. row_base = &_pdxfs_txn_rename_stage +
  // row_id*56 (three shifts summed -- 32+16+8 -- no imul, matching
  // `_pdxfs_txn_table`'s own 48-byte-stride idiom widened by one
  // term). No test instruction. Reserved labels: pxsrs_ / pxsrd_.
  // ==========================================================================
  pub let mut _pdxfs_txn_rename_stage : [u64; 112] = uninit @align(64)

  pub let pdxfs_txn_stage_rename_src : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (old_dir_inode: u64) (old_name_ptr: u64) (old_name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M6-002 (#1710). See the block-level header comment above. Leaf, caller-save only. Labels prefixed pxsrs_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae pxsrs_done;
        mov r10, rdi;
        shl r10, 5;
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov r11, rdi;
        shl r11, 3;
        add r10, r11;                    // r10 = row_id * 56
        lea r11, [rip + _pdxfs_txn_rename_stage];
        add r11, r10;
        mov [r11 + 0],  rsi;             // old_dir_inode
        mov [r11 + 8],  rdx;             // old_name_ptr
        mov [r11 + 16], rcx;             // old_name_len
      pxsrs_done:
        ret
      }
    }

  pub let pdxfs_txn_stage_rename_dst : (u64, u64, u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (new_dir_inode: u64) (new_name_ptr: u64) (new_name_len: u64) (target_inode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M6-002 (#1710). See the block-level header comment above pdxfs_txn_stage_rename_src. Leaf, caller-save only. Labels prefixed pxsrd_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae pxsrd_done;
        mov r10, rdi;
        shl r10, 5;
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov r11, rdi;
        shl r11, 3;
        add r10, r11;                    // r10 = row_id * 56
        lea r11, [rip + _pdxfs_txn_rename_stage];
        add r11, r10;
        mov [r11 + 24], rsi;             // new_dir_inode
        mov [r11 + 32], rdx;             // new_name_ptr
        mov [r11 + 40], rcx;             // new_name_len
        mov [r11 + 48], r8;              // target_inode
      pxsrd_done:
        ret
      }
    }

  // ==========================================================================
  // pdxfs_txn_do_rename(row_id) -> u64
  //
  // R52.M6-002 (#1710): the on-disk half of PXT_OP_RENAME, called by
  // cap_handler_pdxfs_txn's pxt_hn_rename arm. Durably appends a REAL
  // JOP_DENTRY_DEL record (source) followed by a REAL JOP_DENTRY_ADD
  // record (destination) -- journal_ondisk.pdx's journal_encode_
  // dentry_del / _dentry_add + journal_append -- both under the SAME
  // txn_id (read once from the row itself via pdxfs_txn_row_id, never
  // trusted from the caller) so replay applies or discards them
  // atomically, per plan §M6-002. Root-volume resolution mirrors
  // pdxfs_txn_commit_wal / pdxfs_txn_abort_wal / pdxfs_txn_do_create
  // (#1712/#1713/#1709) one-for-one: `_mount_table[MOUNT_ROOT_SLOT]`
  // -> KIND_VOLUME row_id -> volume_row_device_slot -> bdev_cap ->
  // sb_read -> sb_journal_lba/sb_journal_bcount.
  //
  // Row must be OPEN (pdxfs_txn_row_state == PXT_STATE_OPEN) --
  // PXT_BAD_TRANSITION otherwise (mirrors pdxfs_txn_row_transition's
  // own one-shot gate; a rename against a COMMITTED/ABORTED/EXPIRED
  // txn is refused rather than silently journaled against a group
  // that will never commit). A dead row_id is PXT_DECODE_BAD.
  //
  // UNLIKE commit_wal/abort_wal (but LIKE do_create), a root that is
  // not MOUNT_BACKEND_PDXFS_BLOCK is a REAL refusal (PXT_TAIL_BAD_ARG),
  // not a silent no-op -- a rename has no data-region write to skip;
  // fabricating PXT_OK with no journal record would be a lie. The same
  // refusal covers a destination that was never staged (new_name_len
  // == 0) -- TXN_RENAME_NO_SRC (0xFFFFED29, above) is reserved
  // specifically for the source side (old_name_len == 0). Neither
  // staged name's length is re-bounded here beyond != 0 --
  // pdxfs_txn_stage_rename_src/_dst do not enforce an upper bound
  // either (unlike do_create's 400-B ceiling), so a caller-supplied
  // name longer than journal_ondisk.pdx's own JNL_RECORDS_AREA_SIZE
  // (4056 B) ceiling surfaces as journal_append's own JNL_CSUM_BAD
  // (forwarded verbatim, gap 1/3 of that module's header) rather than
  // a bespoke PXT-side code -- flagged rather than silently widening
  // this landing's own scope to add a matching ceiling check.
  //
  // No source-exists / destination-collision check is performed -- no
  // dentry-lookup/directory-walk primitive exists anywhere in this
  // tree yet (see TXN_RENAME_DEST_EXISTS's own comment, above).
  //
  // Register/memory-lifetime plan: mirrors pdxfs_txn_do_create's own
  // "spill everything except row_id, reload fresh via caller-save
  // r10/r11 immediately before each use" discipline (that function's
  // own header already documents the rationale -- avoids a silent
  // caller-save clobber across journal_encode_*/journal_append/sb_*
  // nested calls). `_pxt_rename_ctx` carries bdev_cap/vol_slot/
  // journal_lba/journal_bcount/txn_id/sb_ptr (six fields -- no
  // dir_inode/inode_no slot, unlike `_pxt_create_ctx`, since RENAME's
  // dir_inode/target_inode fields are read directly out of the
  // per-row `_pdxfs_txn_rename_stage` table at each encode call
  // instead). The DEL and ADD records share `_pdxfs_txn_jrec_scratch`
  // (#1709's own 512-B scratch, reused here since the two encode+
  // append round trips are strictly sequential -- DEL's bytes are
  // durably appended before ADD's encode begins, so no overlap is
  // possible). Only row_id survives in a register (rbx) -- a single
  // push lands rsp%16==0 (odd push count, no pad). Every nested call
  // is arity <= 6. Labels prefixed pxdr_.
  // ==========================================================================
  pub let mut _pxt_rename_ctx : [u64; 8] = uninit @align(64)
  // [+0] bdev_cap  [+8] vol_slot  [+16] journal_lba  [+24] journal_bcount
  // [+32] txn_id  [+40] sb_ptr (transient, dead once both sb_journal_*
  // reads complete)  [+48..+63] unused headroom

  pub let pdxfs_txn_do_rename : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M6-002 (#1710): see the block-level header comment above for the full rationale (resolution chain, OPEN gate, refuse-not-noop posture, scratch-backed value lifetime, shared jrec scratch). Labels prefixed pxdr_.",
      block: {
        push rbx;

        mov rbx, rdi;                      // rbx = row_id, survives every call below

        // (1) row must be live AND OPEN.
        mov rdi, rbx;
        call pdxfs_txn_row_state;
        mov r10, 0xFFFFFFFFFFFFFFFF;        // PXT_DECODE_BAD
        cmp rax, r10;
        je pxdr_decode_bad;
        cmp rax, 1;                         // PXT_STATE_OPEN
        jne pxdr_bad_transition;

        // (2) both ends must be staged.
        mov r10, rbx;
        shl r10, 5;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;                       // r10 = row_id * 56
        lea r11, [rip + _pdxfs_txn_rename_stage];
        add r11, r10;
        mov rax, [r11 + 16];                // old_name_len
        cmp rax, 0;
        je pxdr_no_src;
        mov rax, [r11 + 40];                // new_name_len
        cmp rax, 0;
        je pxdr_bad_arg;

        // (3) resolve the mounted root PdxFS-block volume.
        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];                 // MOUNT_ROOT_SLOT = 0
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFF;                      // backend_type
        cmp r11, 5;                         // MOUNT_BACKEND_PDXFS_BLOCK
        jne pxdr_bad_arg;                   // no real volume -- refuse, do not fabricate success

        mov rcx, rax;
        shr rcx, 48;
        and rcx, 0xFFFF;                    // KIND_VOLUME row_id
        lea r10, [rip + _pxt_rename_ctx];
        mov [r10 + 8], rcx;                 // vol_slot

        // (4) bdev_cap.
        mov rdi, rcx;
        call volume_row_device_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;        // VOL_DECODE_BAD
        cmp rax, r10;
        je pxdr_bad_arg;
        lea r10, [rip + _pxt_rename_ctx];
        mov [r10 + 0], rax;                 // bdev_cap

        // (5) sb_read -> sb_ptr (stashed transiently).
        mov rdi, rax;                       // bdev_cap
        call sb_read;
        mov r10, 0xFFFF800000000000;        // KERNEL_VMA_BASE
        cmp rax, r10;
        jb pxdr_bad_arg;
        lea r10, [rip + _pxt_rename_ctx];
        mov [r10 + 40], rax;                // sb_ptr

        lea r10, [rip + _pxt_rename_ctx];
        mov rdi, [r10 + 40];
        call sb_journal_lba;
        lea r10, [rip + _pxt_rename_ctx];
        mov [r10 + 16], rax;                // journal_lba

        lea r10, [rip + _pxt_rename_ctx];
        mov rdi, [r10 + 40];
        call sb_journal_bcount;
        lea r10, [rip + _pxt_rename_ctx];
        mov [r10 + 24], rax;                // journal_bcount

        // (6) txn_id.
        mov rdi, rbx;
        call pdxfs_txn_row_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;        // PXT_DECODE_BAD
        cmp rax, r10;
        je pxdr_bad_arg;
        lea r10, [rip + _pxt_rename_ctx];
        mov [r10 + 32], rax;                // txn_id

        // (7) encode + append JOP_DENTRY_DEL(old).
        mov r10, rbx;
        shl r10, 5;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        lea r11, [rip + _pdxfs_txn_rename_stage];
        add r11, r10;                       // r11 = stage_base

        lea r9, [rip + _pxt_rename_ctx];
        mov rdi, [r9 + 32];                 // txn_id
        mov rsi, [r11 + 0];                 // old_dir_inode
        mov rdx, [r11 + 8];                 // old_name_ptr
        mov rcx, [r11 + 16];                // old_name_len
        lea r8, [rip + _pdxfs_txn_jrec_scratch];
        call journal_encode_dentry_del;
        mov r10, rax;                       // record_len

        lea r11, [rip + _pxt_rename_ctx];
        mov rdi, [r11 + 0];                 // bdev_cap
        mov rsi, [r11 + 8];                 // vol_slot
        mov rdx, [r11 + 16];                // journal_lba
        mov rcx, [r11 + 24];                // journal_bcount
        lea r8, [rip + _pdxfs_txn_jrec_scratch];
        mov r9, r10;                        // record_len
        call journal_append;
        cmp rax, 0;
        jne pxdr_out;

        // (8) encode + append JOP_DENTRY_ADD(new).
        mov r10, rbx;
        shl r10, 5;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        lea r11, [rip + _pdxfs_txn_rename_stage];
        add r11, r10;                       // r11 = stage_base

        mov rax, [r11 + 32];                 // new_name_ptr
        mov rcx, [r11 + 40];                 // new_name_len (arg4 -- set now, untouched below)
        mov r8,  [r11 + 48];                 // target_inode (arg5 -- set now, untouched below)
        mov rsi, [r11 + 24];                 // new_dir_inode (arg2 -- read before r11's own reuse)

        lea r9, [rip + _pxt_rename_ctx];
        mov rdi, [r9 + 32];                  // txn_id
        mov rdx, rax;                        // new_name_ptr
        lea r9, [rip + _pdxfs_txn_jrec_scratch];   // out_ptr
        call journal_encode_dentry_add;
        mov r10, rax;                        // record_len

        lea r11, [rip + _pxt_rename_ctx];
        mov rdi, [r11 + 0];                  // bdev_cap
        mov rsi, [r11 + 8];                  // vol_slot
        mov rdx, [r11 + 16];                 // journal_lba
        mov rcx, [r11 + 24];                 // journal_bcount
        lea r8, [rip + _pdxfs_txn_jrec_scratch];
        mov r9, r10;                         // record_len
        call journal_append;
        cmp rax, 0;
        jne pxdr_out;

        xor rax, rax;
        jmp pxdr_out;

      pxdr_no_src:
        mov rax, 0xFFFFED29;                 // TXN_RENAME_NO_SRC
        jmp pxdr_out;
      pxdr_bad_transition:
        mov rax, 0xFFFFEC15;                 // PXT_BAD_TRANSITION
        jmp pxdr_out;
      pxdr_decode_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;         // PXT_DECODE_BAD
        jmp pxdr_out;
      pxdr_bad_arg:
        mov rax, 0xFFFFEC1E;                 // PXT_TAIL_BAD_ARG

      pxdr_out:
        pop rbx;
        ret
      }
    }

  pub let cap_handler_pdxfs_txn : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): KIND_PDXFS_TXN dispatch. Query ops need R_PDXFS_TXN_INVOKE (0x008); DEBUG_PRINT needs R_PDXFS_TXN_OBSERVE (0x400). op_arg[63:8] refused. R42-PREP-007 (#1629): added COMMIT (7), ABORT (8), CREATE (9), RENAME (10), UNLINK (11); all five need R_PDXFS_TXN_INVOKE. COMMIT / ABORT delegate to pdxfs_txn_row_transition (OPEN -> COMMITTED / ABORTED gate) after their own real on-disk journal emission (pdxfs_txn_commit_wal / pdxfs_txn_abort_wal, #1712/#1713) and bump PXT_ST_COMMITS / PXT_ST_ABORTS only on a successful transition; CREATE delegates to pdxfs_txn_do_create (#1709, real inode allocation + JOP_INODE_WRITE + JOP_DENTRY_ADD) and bumps PXT_ST_CREATES only on success, same convention; RENAME delegates to pdxfs_txn_do_rename (#1710, real JOP_DENTRY_DEL + JOP_DENTRY_ADD sharing one txn_id) and bumps PXT_ST_RENAMES only on success, same convention; UNLINK remains a wire-only STUB that bumps its own per-op counter and returns PXT_STUB_OK (0xFFFFEBFB) so the R49 tooling wave links against a real op code even though its walker body (#1711) arrives later. Op-max widened from 6 to 11 in step; PXT_OP_MAX in the module header carries the same number. Labels prefixed pxt_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne pxt_hn_res;

        cmp rbp, 11;                     // PXT_OP_MAX (was 6; R42-PREP-007)
        ja  pxt_hn_unsup;

        cmp rbp, 6;                      // DEBUG_PRINT
        je  pxt_hn_dbg;

        mov r10, r12;
        and r10, 0x008;                  // R_PDXFS_TXN_INVOKE
        cmp r10, 0;
        je  pxt_hn_denied;

        // Query ops 0..5 use row_id -> arg0 and land in pxt_hn_count.
        mov rdi, r13;
        cmp rbp, 0;
        je  pxt_hn_id;
        cmp rbp, 1;
        je  pxt_hn_snap;
        cmp rbp, 2;
        je  pxt_hn_wal;
        cmp rbp, 3;
        je  pxt_hn_bytes;
        cmp rbp, 4;
        je  pxt_hn_state;
        cmp rbp, 5;
        je  pxt_hn_mode;
        // R42-PREP-007 (#1629): write-side ops 7..11.
        cmp rbp, 7;
        je  pxt_hn_commit;
        cmp rbp, 8;
        je  pxt_hn_abort;
        cmp rbp, 9;
        je  pxt_hn_create;
        cmp rbp, 10;
        je  pxt_hn_rename;
        // Fall-through: op == 11 (UNLINK)
        jmp pxt_hn_unlink;

      pxt_hn_id:
        call pdxfs_txn_row_id;
        jmp pxt_hn_count;
      pxt_hn_snap:
        call pdxfs_txn_row_snap;
        jmp pxt_hn_count;
      pxt_hn_wal:
        call pdxfs_txn_row_wal;
        jmp pxt_hn_count;
      pxt_hn_bytes:
        call pdxfs_txn_row_bytes;
        jmp pxt_hn_count;
      pxt_hn_state:
        call pdxfs_txn_row_state;
        jmp pxt_hn_count;
      pxt_hn_mode:
        call pdxfs_txn_row_mode;
        jmp pxt_hn_count;

      // R42-PREP-007 (#1629): COMMIT -- OPEN -> COMMITTED (2).  Bumps
      // PXT_ST_COMMITS iff the transition succeeded (rax == 0), so
      // an operator counting mutations does not see a bump when the
      // handler refused a duplicate.
      // R52.M6-004 (#1712): before the transition, pdxfs_txn_commit_
      // wal(row_id) writes a REAL on-disk JOP_COMMIT record + issues
      // BD_OP_FLUSH (#1651) against the mounted root PdxFS-block
      // volume, if any -- see that function's own header comment for
      // the full rationale (single-root-volume resolution, no-mount-
      // is-not-an-error, the deliberately redundant explicit FLUSH).
      // A real journal/FLUSH failure is forwarded verbatim WITHOUT
      // attempting the transition or bumping PXT_ST_COMMITS, so a
      // caller can never observe COMMITTED state with no
      // corresponding journal record. r13 (row_id) is callee-save and
      // survives the nested call by ABI convention.
      pxt_hn_commit:
        mov rdi, r13;
        call pdxfs_txn_commit_wal;
        cmp rax, 0;
        jne pxt_hn_out;

        mov rdi, r13;
        mov rsi, 2;                      // PXT_STATE_COMMITTED
        call pdxfs_txn_row_transition;
        cmp rax, 0;
        jne pxt_hn_out;
        push rax;
        mov rdi, 4;                      // PXT_ST_COMMITS
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      // R52.M6-005 (#1713): ABORT -- OPEN -> ABORTED (3).  Bumps
      // PXT_ST_ABORTS iff the transition succeeded (rax == 0), so an
      // operator counting mutations does not see a bump when the
      // handler refused a duplicate. Before the transition,
      // pdxfs_txn_abort_wal(row_id) writes a REAL on-disk JOP_ABORT
      // record (no data-region write of any kind -- no inode/bitmap/
      // dentry mutation, matching plan §M6-005's "no data-region
      // writes" wording) against the mounted root PdxFS-block volume,
      // if any -- see that function's own header comment for the full
      // rationale (mirrors pdxfs_txn_commit_wal's #1712 resolution
      // chain, no-mount-is-not-an-error, no explicit BD_OP_FLUSH). A
      // real journal failure is forwarded verbatim WITHOUT attempting
      // the transition or bumping PXT_ST_ABORTS, so a caller can never
      // observe ABORTED state with no corresponding journal record.
      // r13 (row_id) is callee-save and survives the nested call by
      // ABI convention. Same one-shot semantics as before: a second
      // abort (or an abort after a commit) still returns
      // PXT_BAD_TRANSITION and does not bump.
      pxt_hn_abort:
        mov rdi, r13;
        call pdxfs_txn_abort_wal;
        cmp rax, 0;
        jne pxt_hn_out;

        mov rdi, r13;
        mov rsi, 3;                      // PXT_STATE_ABORTED
        call pdxfs_txn_row_transition;
        cmp rax, 0;
        jne pxt_hn_out;
        push rax;
        mov rdi, 5;                      // PXT_ST_ABORTS
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      // R52.M6-001 (#1709): CREATE -- allocate a fresh inode and
      // durably append JOP_INODE_WRITE + JOP_DENTRY_ADD against the
      // mounted root PdxFS-block volume. Bumps PXT_ST_CREATES only on
      // success (rax == 0), matching COMMIT/ABORT's own success-only
      // convention -- a real CREATE can genuinely refuse or fail, so
      // an unconditional bump would misrepresent a refusal as a
      // mutation. r13 (row_id) is callee-save and survives the nested
      // call by ABI convention. See pdxfs_txn_do_create's own header
      // comment for the full resolution chain, the refuse-not-noop
      // posture on an unmounted root, and the "no caller stages a name
      // yet" landing gap.
      pxt_hn_create:
        mov rdi, r13;
        call pdxfs_txn_do_create;
        cmp rax, 0;
        jne pxt_hn_out;
        push rax;
        mov rdi, 6;                      // PXT_ST_CREATES
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      // R52.M6-002 (#1710): RENAME -- durably append JOP_DENTRY_DEL
      // (source) + JOP_DENTRY_ADD (destination), both under the same
      // txn_id, THEN bump PXT_ST_RENAMES only on success (mirrors
      // CREATE/COMMIT/ABORT's "bump only on success" convention now
      // that this is a real op, not a STUB). pdxfs_txn_do_rename
      // (above) does the actual work -- see its own header comment for
      // the full resolution chain (per-row staged src/dst, _mount_
      // table root resolution, the two journal_encode_*/journal_append
      // pairs) and the "no wired caller yet" / "no destination-
      // collision check" gaps it flags. r13 (row_id) is callee-save
      // and survives the nested call by ABI convention.
      pxt_hn_rename:
        mov rdi, r13;
        call pdxfs_txn_do_rename;
        cmp rax, 0;
        jne pxt_hn_out;
        push rax;
        mov rdi, 7;                      // PXT_ST_RENAMES
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      // R42-PREP-007 (#1629): UNLINK STUB (CREATE/RENAME, above, are
      // real as of R52.M6-001/#1709 and R52.M6-002/#1710). Bumps its
      // counter unconditionally on op-entry (a STUB that never wrote
      // its counter would be indistinguishable from an un-wired op at
      // operator time) then returns PXT_STUB_OK.  The row_id in rdi is
      // not consulted -- the walker body that eventually replaces this
      // STUB (#1711) will use it to name which per-txn write group the
      // mutation joins.
      pxt_hn_unlink:
        mov rdi, 8;                      // PXT_ST_UNLINKS
        call pdxfs_txn_note;
        mov rax, 0xFFFFEBFB;             // PXT_STUB_OK
        jmp pxt_hn_out;

      pxt_hn_count:
        push rax;
        mov rdi, 2;                      // PXT_ST_QUERIES
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      pxt_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  pxt_hn_denied;
        xor rax, rax;
        jmp pxt_hn_out;

      pxt_hn_res:
        mov rax, 0xFFFFEC1E;
        jmp pxt_hn_out;
      pxt_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp pxt_hn_out;
      pxt_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      pxt_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
