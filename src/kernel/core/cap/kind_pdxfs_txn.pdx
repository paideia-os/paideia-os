// src/kernel/core/cap/kind_pdxfs_txn.pdx -- R48b substrate-prep (#1624)
// R42-PREP-007 write-side ops extension (#1629): add PXT_OP_COMMIT (7),
// PXT_OP_ABORT (8), PXT_OP_CREATE (9), PXT_OP_RENAME (10), PXT_OP_UNLINK
// (11).  COMMIT / ABORT are REAL state-transitions on the row's state
// byte (OPEN -> COMMITTED or OPEN -> ABORTED); UNLINK is still a
// wire-only STUB (bump per-op counter, return PXT_STUB_OK) so the R49
// tooling wave (pkg / cp / mv / rm / mkdir) can link against a real op
// code even though its mutating walker body lands later (#1711;
// design/tooling/r49-r50-plan.md §5). CREATE is now REAL (R52.M6-001,
// #1709) and RENAME is now REAL (R52.M6-002, #1710 -- see below).
// Stats table widens from [u64; 8] to [u64; 16] to carry the four new
// counters (CREATES / RENAMES / UNLINKS / OPENS).
//
// R52.M6-001 (#1709): PXT_OP_CREATE now allocates a fresh inode
// (inode_table.pdx's inode_alloc_fresh) and durably appends a REAL
// JOP_INODE_WRITE record followed by a REAL JOP_DENTRY_ADD record
// (journal_ondisk.pdx's journal_encode_inode_write / _dentry_add +
// journal_append) against the mounted root PdxFS-block volume,
// resolved the SAME way pdxfs_txn_commit_wal (#1712, below) and the
// ABORT arm (#1713) already do: `_mount_table[MOUNT_ROOT_SLOT]` ->
// KIND_VOLUME row_id -> volume_row_device_slot -> bdev_cap -> sb_read
// -> sb_journal_lba/sb_journal_bcount/sb_root_inode. Unlike COMMIT/
// ABORT, a root that is not MOUNT_BACKEND_PDXFS_BLOCK is a REAL
// refusal (PXT_TAIL_BAD_ARG) here, not a silent no-op -- CREATE has no
// meaningful "nothing to do" fallback (there is no data-region write
// to skip). Every create lands in the mounted volume's root directory
// (dir_inode = sb_root_inode) -- arbitrary parent-directory resolution
// is out of #1709's scope. JOP_BITMAP_SET emission (named in design/
// filesystem/r52-implementation-plan.md §2.6's #1709 line item,
// "if new inode-table block") is also out of scope per the issue's
// own narrowed brief; flagged for a follow-up alongside #1710/#1711.
// The caller must stage a target name via pdxfs_txn_stage_create_name
// (row_id, name_ptr, name_len) before invoking PXT_OP_CREATE -- see
// that function's and pdxfs_txn_do_create's own header comments for
// the full contract and the "no wired caller yet" landing gap this
// flags (mirrors this codebase's established practice of landing a
// real primitive ahead of its eventual end-to-end caller, e.g.
// volume_registry.pdx's own sig-verify-deferred-to-#1707 note).
//
// R52.M6-002 (#1710): PXT_OP_RENAME now durably appends a REAL
// JOP_DENTRY_DEL record (source) followed by a REAL JOP_DENTRY_ADD
// record (destination) -- journal_ondisk.pdx's journal_encode_dentry_
// del / _dentry_add + journal_append -- both under the SAME txn_id so
// replay applies (or discards) them atomically, per plan §M6-002
// ("Both records share txn_id -> atomic replay"). Root-volume
// resolution mirrors pdxfs_txn_commit_wal/#1712's and pdxfs_txn_do_
// create/#1709's own `_mount_table[MOUNT_ROOT_SLOT]` chain; like
// CREATE (and unlike COMMIT/ABORT), a root that is not MOUNT_BACKEND_
// PDXFS_BLOCK is a REAL refusal (PXT_TAIL_BAD_ARG), not a silent
// no-op -- a rename has no meaningful "nothing to do" fallback. The
// caller must stage BOTH ends via pdxfs_txn_stage_rename_src(row_id,
// old_dir_inode, old_name_ptr, old_name_len) AND pdxfs_txn_stage_
// rename_dst(row_id, new_dir_inode, new_name_ptr, new_name_len,
// target_inode) before invoking PXT_OP_RENAME -- mirrors #1709's
// pdxfs_txn_stage_create_name shape one level wider (a rename needs
// seven fields, split across two arity-bounded staging calls since
// cap_invoke's single op_arg register has no room for even one, per
// that function's "op_arg[63:8] refused" gate). See pdxfs_txn_do_
// rename's own header comment for the full resolution chain and the
// "no wired caller yet" / "no destination-collision check" gaps this
// landing flags (no dentry-lookup/directory-walk primitive exists
// anywhere in this tree yet -- grep audit 2026-08-23: no `dentry`/
// `dir_walk` module under src/kernel/core/fs/pdxfs/ -- so
// TXN_RENAME_DEST_EXISTS, reserved below, is declared but UNUSED).
//
// R52.M6-005 (#1713): PXT_OP_ABORT now also emits a REAL on-disk
// JOP_ABORT journal record (pdxfs_txn_abort_wal, below -- mirrors
// #1712's pdxfs_txn_commit_wal one-for-one, resolving the mounted
// root PdxFS-block volume out of _mount_table[MOUNT_ROOT_SLOT]) before
// performing the OPEN -> ABORTED row transition. No data-region write
// happens on this path, per plan §M6-005's "no data-region writes"
// wording -- only the journal region gets a record, and unlike COMMIT
// no explicit BD_OP_FLUSH is issued (see pdxfs_txn_abort_wal's own
// header comment).
//
// KIND_PDXFS_TXN = 0x196, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// The runtime authority for ONE in-flight PdxFS transaction: a
// transaction id, a starting snapshot generation, a WAL byte offset
// (where the first record of this transaction landed), a byte-count
// running total, a mode word (CREATE / MODIFY / DELETE), and a state
// (OPEN / COMMITTED / ABORTED / EXPIRED).
//
// The substrate for pkg/cp/mv/rm (design/tooling/r49-r50-plan.md §5
// R49/R50 tools) that must group N file writes into ONE atomic unit --
// either every write lands or none do.  The transaction cap threads
// through cow_write.pdx + wal.pdx + journal_fence.pdx + journal_csum.pdx
// (the R42 substrate) so the walker knows which WAL group a specific
// write belongs to.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// A transaction bounds the set of PdxFS blocks it may mutate to the
// mount's memory authority (same argument as kind_pdxfs_file: an FS
// object is a page-shaped thing).  Deriving over KIND_MEMORY lets the
// mint gate structurally refuse a txn that widens memory reach beyond
// the parent's.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (48 bytes, six u64 words):
//
//   [+0]   header: in_use[63:56] | state[15:8] | mode[7:0]
//   [+8]   txn_id      (u64)                     -- FS-assigned; refused == 0
//   [+16]  snap_gen    (u64)                     -- source snapshot generation
//   [+24]  wal_off     (u64)                     -- WAL byte offset (start)
//   [+32]  bytes_touched (u64)                   -- running total (kernel-side)
//   [+40]  expire_ns    (u64)                    -- absolute deadline (0 = none)
//
// State byte values:
//   PXT_STATE_OPEN      = 1   -- accepting writes
//   PXT_STATE_COMMITTED = 2   -- writes drained to journal
//   PXT_STATE_ABORTED   = 3   -- explicit abort
//   PXT_STATE_EXPIRED   = 4   -- deadline hit before commit
//
// Mode byte values:
//   PXT_MODE_CREATE     = 1   -- pkg install (new files)
//   PXT_MODE_MODIFY     = 2   -- cp/mv onto existing file
//   PXT_MODE_DELETE     = 3   -- rm (unlink files)
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// R_PDXFS_TXN_INVOKE  (0x008) -- query ops + commit + abort
// R_PDXFS_TXN_REVOKE  (0x010) -- supervisor teardown
// R_PDXFS_TXN_MINT    (0x200) -- derive a per-file scope (not used by
//                                pkg today, reserved for R50 layered ops)
// R_PDXFS_TXN_OBSERVE (0x400) -- debug print
// R_PDXFS_TXN_ALL     (0x618)
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEC10..0xFFFFEC1F
// =============================================================================
//
// Sixteen wide, disjoint from KIND_PDXFS_FILE (0xFFFFEC20..0xFFFFEC2F).

module KindPdxfsTxn = structure {

  pub let KIND_PDXFS_TXN      : u64 = 0x196
  pub let KIND_PDXFS_TXN_BASE : u64 = 4          // = KIND_MEMORY

  pub let R_PDXFS_TXN_INVOKE  : u64 = 0x008
  pub let R_PDXFS_TXN_REVOKE  : u64 = 0x010
  pub let R_PDXFS_TXN_MINT    : u64 = 0x200
  pub let R_PDXFS_TXN_OBSERVE : u64 = 0x400
  pub let R_PDXFS_TXN_ALL     : u64 = 0x618

  pub let PXT_STATE_OPEN      : u64 = 1
  pub let PXT_STATE_COMMITTED : u64 = 2
  pub let PXT_STATE_ABORTED   : u64 = 3
  pub let PXT_STATE_EXPIRED   : u64 = 4
  pub let PXT_STATE_MAX       : u64 = 4

  pub let PXT_MODE_CREATE     : u64 = 1
  pub let PXT_MODE_MODIFY     : u64 = 2
  pub let PXT_MODE_DELETE     : u64 = 3
  pub let PXT_MODE_MAX        : u64 = 3

  pub let PXT_OP_QUERY_ID     : u64 = 0
  pub let PXT_OP_QUERY_SNAP   : u64 = 1
  pub let PXT_OP_QUERY_WAL    : u64 = 2
  pub let PXT_OP_QUERY_BYTES  : u64 = 3
  pub let PXT_OP_QUERY_STATE  : u64 = 4
  pub let PXT_OP_QUERY_MODE   : u64 = 5
  pub let PXT_OP_DEBUG_PRINT  : u64 = 6
  // R42-PREP-007 (#1629): write-side op codes.  COMMIT / ABORT are the
  // two real state transitions that any long-running mutating tool must
  // choose between; CREATE / RENAME / UNLINK are the three PdxFS
  // filesystem mutations that mkdir / mv / rm need syscall-facing op
  // ordinals for.  At substrate-prep the mutation ops STUB out to
  // PXT_STUB_OK so the tools link against a fixed op ABI even though
  // the walker body lands later.
  pub let PXT_OP_COMMIT       : u64 = 7
  pub let PXT_OP_ABORT        : u64 = 8
  pub let PXT_OP_CREATE       : u64 = 9
  pub let PXT_OP_RENAME       : u64 = 10
  pub let PXT_OP_UNLINK       : u64 = 11
  pub let PXT_OP_MAX          : u64 = 11

  pub let PXT_OK              : u64 = 0
  pub let PXT_TAIL_ENOSPC     : u64 = 0xFFFFEC1F
  pub let PXT_TAIL_BAD_ARG    : u64 = 0xFFFFEC1E
  pub let PXT_MINT_BAD_PARENT : u64 = 0xFFFFEC1D
  pub let PXT_MINT_BAD_RIGHTS : u64 = 0xFFFFEC1C
  pub let PXT_MINT_BAD_ID     : u64 = 0xFFFFEC1B
  pub let PXT_MINT_BAD_MODE   : u64 = 0xFFFFEC1A
  pub let PXT_MINT_BAD_STATE  : u64 = 0xFFFFEC19
  pub let PXT_BAD_SLOT        : u64 = 0xFFFFEC18
  pub let PXT_WRONG_KIND      : u64 = 0xFFFFEC17
  pub let PXT_REVOKE_ALREADY  : u64 = 0xFFFFEC16
  // R42-PREP-007 (#1629): a COMMIT or ABORT that reaches a row whose
  // state is not OPEN.  Kept disjoint from every other PXT_ sentinel
  // in the 0xFFFFEC10..0xFFFFEC1F band so an operator inspecting the
  // errno can distinguish "the walker refused a duplicate commit"
  // from "the mint refused a bad mode" without a lookup.
  pub let PXT_BAD_TRANSITION  : u64 = 0xFFFFEC15

  // R42-PREP-007 (#1629): STUB sentinel for UNLINK (CREATE / RENAME no
  // longer use this -- R52.M6-001 (#1709) and R52.M6-002 (#1710) below
  // rewire PXT_OP_CREATE / PXT_OP_RENAME to real journaled
  // implementations).  Follows the ELVB_DISPATCH_STUB convention
  // (ipc/elevate_broker.pdx) -- a distinct 0xFFFFEB__ value a caller
  // can distinguish from PXT_OK (real success) via one compare. Tools
  // translate this into their own TXN_STUB reply until #1711 lands the
  // UNLINK walker body.
  pub let PXT_STUB_OK         : u64 = 0xFFFFEBFB

  // R52.M6-001 (#1709): PXT_OP_CREATE's own M6-band failure code --
  // inode_alloc_fresh (inode_table.pdx) found no free inode slot.
  // 0xFFFFED28 is this module's slice of design/filesystem/
  // r52-implementation-plan.md §4's M6 band (0xFFFFED28..ED2F).
  // Every OTHER "cannot proceed" condition inside pdxfs_txn_do_create
  // (dead row_id, no mounted root PdxFS-block volume, missing/
  // oversized staged name) reuses PXT_TAIL_BAD_ARG (0xFFFFEC1E, above)
  // rather than
  // claiming another M6-band slot -- mirroring journal_ondisk.pdx's
  // own gap-3 precedent of reusing one adjacent, already-frozen code
  // across a whole class of "this call cannot proceed as given"
  // conditions instead of inventing a code per condition.
  pub let TXN_CREATE_INODE_EXHAUSTED : u64 = 0xFFFFED28

  // R52.M6-002 (#1710): PXT_OP_RENAME's own M6-band failure codes.
  // TXN_RENAME_NO_SRC fires when pdxfs_txn_do_rename finds no staged
  // source (pdxfs_txn_stage_rename_src was never called for this
  // row_id -- old_name_len reads 0 in the per-row staging table).
  // TXN_RENAME_DEST_EXISTS is declared per design/filesystem/
  // r52-implementation-plan.md §4's M6 band but UNUSED at this
  // landing -- no dentry-lookup/directory-walk primitive exists
  // anywhere in this tree yet to check for a real name collision at
  // the destination; flagged for whichever future landing adds that
  // walker. Every OTHER "cannot proceed" condition in pdxfs_txn_do_
  // rename (dead row_id, row not OPEN, no staged destination, no
  // mounted root PdxFS-block volume) reuses PXT_TAIL_BAD_ARG
  // (0xFFFFEC1E, above) or PXT_BAD_TRANSITION (0xFFFFEC15, above),
  // mirroring TXN_CREATE_INODE_EXHAUSTED's own adjacent precedent of
  // reusing one already-frozen code across a whole class of
  // conditions instead of inventing one per condition.
  pub let TXN_RENAME_NO_SRC      : u64 = 0xFFFFED29
  pub let TXN_RENAME_DEST_EXISTS : u64 = 0xFFFFED2A

  pub let PXT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PXT_ROW_NONE   : u64 = 0xFF

  pub let PXT_MAX       : u64 = 16
  pub let PXT_ROW_BYTES : u64 = 48
  pub let mut _pdxfs_txn_table : [u64; 96] = uninit @align(64)
  // R42-PREP-007 (#1629): stats table widened from [u64; 8] to
  // [u64; 16] to carry the four new observability counters
  // (CREATES / RENAMES / UNLINKS / OPENS).  The bounds check in
  // pdxfs_txn_note and pdxfs_txn_stat widens from `cmp rdi, 8` to
  // `cmp rdi, 16` in step; the table_reset loop widens the same way.
  // _pdxfs_txn_stats stays confined to core/cap/kind_pdxfs_txn.o via
  // tools/build.sh's ec_confine_one -- growing its length preserves
  // the one-writer discipline because writes are still the same set
  // of pdxfs_txn_* helpers in this file.
  pub let mut _pdxfs_txn_stats : [u64; 16] = uninit @align(64)

  pub let PXT_ST_MINTS     : u64 = 0
  pub let PXT_ST_REVOKES   : u64 = 1
  pub let PXT_ST_QUERIES   : u64 = 2
  pub let PXT_ST_REFUSED   : u64 = 3
  pub let PXT_ST_COMMITS   : u64 = 4
  pub let PXT_ST_ABORTS    : u64 = 5
  // R42-PREP-007 (#1629): per-op counters for the new write-side ops.
  // UNLINK's STUB bumps its slot on entry; COMMIT / ABORT bump their
  // slot only on a successful transition. R52.M6-001 (#1709): CREATE
  // is no longer a STUB -- it now bumps PXT_ST_CREATES only on a
  // successful pdxfs_txn_do_create (matching COMMIT/ABORT's own
  // success-only convention, since a real CREATE can genuinely fail).
  // R52.M6-002 (#1710): RENAME is likewise no longer a STUB -- it now
  // bumps PXT_ST_RENAMES only on a successful pdxfs_txn_do_rename,
  // same convention. OPENS is bumped by the sys_pdxfs_txn_open
  // syscall body once cap_mint_write returns.
  pub let PXT_ST_CREATES   : u64 = 6
  pub let PXT_ST_RENAMES   : u64 = 7
  pub let PXT_ST_UNLINKS   : u64 = 8
  pub let PXT_ST_OPENS     : u64 = 9
  pub let PXT_ST_MAX       : u64 = 16

  pub let pdxfs_txn_dbg_msg : [u8; 14] = "PDXFS TXN ROW\0"

  pub let pdxfs_txn_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): clear every row and every counter. Boot and teardown only. Labels prefixed pxt_rs_.",
      block: {
        lea r10, [rip + _pdxfs_txn_table];
        xor rax, rax;
        xor rcx, rcx;
      pxt_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  pxt_rs_rows;

        lea r10, [rip + _pdxfs_txn_stats];
        xor rcx, rcx;
      pxt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;                     // R42-PREP-007 (#1629): widened stats
        jb  pxt_rs_stats;
        ret
      }
    }

  pub let pdxfs_txn_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bounded increment; out-of-range no-op. R42-PREP-007 (#1629): widened from 8 to 16 to carry CREATES/RENAMES/UNLINKS/OPENS counters. Labels prefixed pxt_nt_.",
      block: {
        cmp rdi, 16;                     // R42-PREP-007 (#1629): widened bound
        jae pxt_nt_out;
        lea r10, [rip + _pdxfs_txn_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pxt_nt_out:
        ret
      }
    }

  pub let pdxfs_txn_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bounded read; out-of-range returns 0. R42-PREP-007 (#1629): widened from 8 to 16 to match _pdxfs_txn_stats. Labels prefixed pxt_st_.",
      block: {
        cmp rdi, 16;                     // R42-PREP-007 (#1629): widened bound
        jae pxt_st_zero;
        lea r10, [rip + _pdxfs_txn_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pxt_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): subset test against R_PDXFS_TXN_ALL = 0x618. Labels prefixed pxt_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x618;
        and rax, r10;
        cmp rax, rdi;
        jne pxt_rv_no;
        mov rax, 1;
        ret;
      pxt_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_mode_valid : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): 1 iff mode in [1, PXT_MODE_MAX = 3]. Zero is refused (no txn is meaningfully mode-less). Labels prefixed pxt_mv_.",
      block: {
        cmp rdi, 1;
        jb  pxt_mv_no;
        mov r10, 3;
        cmp rdi, r10;
        ja  pxt_mv_no;
        mov rax, 1;
        ret;
      pxt_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): derivation gate. parent.kind == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200). Same shape as pdxfs_file_check_parent_memory. Labels prefixed pxt_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae pxt_cpm_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne pxt_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  pxt_cpm_no;

        mov rax, 1;
        ret;

      pxt_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | state[15:8] | mode[7:0].
  // Callers pack via pdxfs_txn_hdr_pack(mode, state).
  pub let pdxfs_txn_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (mode: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): canonical header encoder. Validates mode in [1..3] and state in [1..4]. Bits [63:56] MUST leave this function zero. Labels prefixed pxt_hp_.",
      block: {
        cmp rdi, 1;
        jb  pxt_hp_bad;
        mov r10, 3;
        cmp rdi, r10;
        ja  pxt_hp_bad;
        cmp rsi, 1;
        jb  pxt_hp_bad;
        mov r10, 4;
        cmp rsi, r10;
        ja  pxt_hp_bad;
        mov rax, rdi;                    // mode in [7:0]
        mov r11, rsi;
        shl r11, 8;
        or  rax, r11;                    // state in [15:8]
        ret;
      pxt_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // tail_alloc(hdr, txn_id, snap_gen, wal_off, expire_ns).  bytes_touched
  // starts at 0 -- the walker bumps it as writes flow through.
  pub let pdxfs_txn_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (txn_id: u64) (snap_gen: u64) (wal_off: u64) (expire_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): claim one txn row. THE ONLY WRITER of _pdxfs_txn_table; tools/build.sh confines it. Gates: hdr in_use pre-set -> BAD_ARG; hdr bits [55:16] non-zero -> BAD_ARG; txn_id == 0 -> BAD_ID. Six callee-save pushes leave rsp%16 == 0. Labels prefixed pxt_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // txn_id
        mov r14, rdx;                    // snap_gen
        mov r15, rcx;                    // wal_off
        mov rbp, r8;                     // expire_ns

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne pxt_ta_bad;

        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        jne pxt_ta_bad;

        cmp r13, 0;
        je  pxt_ta_bad_id;

        xor rbx, rbx;
      pxt_ta_scan:
        cmp rbx, 16;
        jae pxt_ta_enospc;

        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rbx;
        shl r11, 5;
        mov rax, rbx;
        shl rax, 4;
        add r11, rax;                    // row * 48
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pxt_ta_claim;

        add rbx, 1;
        jmp pxt_ta_scan;

      pxt_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        xor rax, rax;
        mov [r10 + 32], rax;             // bytes_touched = 0
        mov [r10 + 40], rbp;
        mov rax, rbx;
        jmp pxt_ta_out;

      pxt_ta_enospc:
        mov rax, 0xFFFFEC1F;             // PXT_TAIL_ENOSPC
        jmp pxt_ta_out;
      pxt_ta_bad_id:
        mov rax, 0xFFFFEC1B;             // PXT_MINT_BAD_ID
        jmp pxt_ta_out;
      pxt_ta_bad:
        mov rax, 0xFFFFEC1E;             // PXT_TAIL_BAD_ARG

      pxt_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pdxfs_txn_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): 1 iff row < PXT_MAX and in_use byte set. Labels prefixed pxt_tv_.",
      block: {
        cmp rdi, 16;
        jae pxt_tv_no;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pxt_tv_no;
        mov rax, 1;
        ret;
      pxt_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): scrub row (all six words). Labels prefixed pxt_tf_.",
      block: {
        cmp rdi, 16;
        jae pxt_tf_out;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      pxt_tf_out:
        ret
      }
    }

  // Row accessors.
  pub let pdxfs_txn_row_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): txn_id, or PXT_DECODE_BAD. Labels prefixed pxt_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rid_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp pxt_rid_out;
      pxt_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rid_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_snap : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): snap_gen, or PXT_DECODE_BAD. Labels prefixed pxt_rsnap_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rsnap_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp pxt_rsnap_out;
      pxt_rsnap_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rsnap_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_wal : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): wal_off, or PXT_DECODE_BAD. Labels prefixed pxt_rwal_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
