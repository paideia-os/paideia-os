// src/kernel/core/cap/kind_pdxfs_txn.pdx -- R48b substrate-prep (#1624)
//
// KIND_PDXFS_TXN = 0x196, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// The runtime authority for ONE in-flight PdxFS transaction: a
// transaction id, a starting snapshot generation, a WAL byte offset
// (where the first record of this transaction landed), a byte-count
// running total, a mode word (CREATE / MODIFY / DELETE), and a state
// (OPEN / COMMITTED / ABORTED / EXPIRED).
//
// The substrate for pkg/cp/mv/rm (design/tooling/r49-r50-plan.md §5
// R49/R50 tools) that must group N file writes into ONE atomic unit --
// either every write lands or none do.  The transaction cap threads
// through cow_write.pdx + wal.pdx + journal_fence.pdx + journal_csum.pdx
// (the R42 substrate) so the walker knows which WAL group a specific
// write belongs to.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// A transaction bounds the set of PdxFS blocks it may mutate to the
// mount's memory authority (same argument as kind_pdxfs_file: an FS
// object is a page-shaped thing).  Deriving over KIND_MEMORY lets the
// mint gate structurally refuse a txn that widens memory reach beyond
// the parent's.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (48 bytes, six u64 words):
//
//   [+0]   header: in_use[63:56] | state[15:8] | mode[7:0]
//   [+8]   txn_id      (u64)                     -- FS-assigned; refused == 0
//   [+16]  snap_gen    (u64)                     -- source snapshot generation
//   [+24]  wal_off     (u64)                     -- WAL byte offset (start)
//   [+32]  bytes_touched (u64)                   -- running total (kernel-side)
//   [+40]  expire_ns    (u64)                    -- absolute deadline (0 = none)
//
// State byte values:
//   PXT_STATE_OPEN      = 1   -- accepting writes
//   PXT_STATE_COMMITTED = 2   -- writes drained to journal
//   PXT_STATE_ABORTED   = 3   -- explicit abort
//   PXT_STATE_EXPIRED   = 4   -- deadline hit before commit
//
// Mode byte values:
//   PXT_MODE_CREATE     = 1   -- pkg install (new files)
//   PXT_MODE_MODIFY     = 2   -- cp/mv onto existing file
//   PXT_MODE_DELETE     = 3   -- rm (unlink files)
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// R_PDXFS_TXN_INVOKE  (0x008) -- query ops + commit + abort
// R_PDXFS_TXN_REVOKE  (0x010) -- supervisor teardown
// R_PDXFS_TXN_MINT    (0x200) -- derive a per-file scope (not used by
//                                pkg today, reserved for R50 layered ops)
// R_PDXFS_TXN_OBSERVE (0x400) -- debug print
// R_PDXFS_TXN_ALL     (0x618)
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEC10..0xFFFFEC1F
// =============================================================================
//
// Sixteen wide, disjoint from KIND_PDXFS_FILE (0xFFFFEC20..0xFFFFEC2F).

module KindPdxfsTxn = structure {

  pub let KIND_PDXFS_TXN      : u64 = 0x196
  pub let KIND_PDXFS_TXN_BASE : u64 = 4          // = KIND_MEMORY

  pub let R_PDXFS_TXN_INVOKE  : u64 = 0x008
  pub let R_PDXFS_TXN_REVOKE  : u64 = 0x010
  pub let R_PDXFS_TXN_MINT    : u64 = 0x200
  pub let R_PDXFS_TXN_OBSERVE : u64 = 0x400
  pub let R_PDXFS_TXN_ALL     : u64 = 0x618

  pub let PXT_STATE_OPEN      : u64 = 1
  pub let PXT_STATE_COMMITTED : u64 = 2
  pub let PXT_STATE_ABORTED   : u64 = 3
  pub let PXT_STATE_EXPIRED   : u64 = 4
  pub let PXT_STATE_MAX       : u64 = 4

  pub let PXT_MODE_CREATE     : u64 = 1
  pub let PXT_MODE_MODIFY     : u64 = 2
  pub let PXT_MODE_DELETE     : u64 = 3
  pub let PXT_MODE_MAX        : u64 = 3

  pub let PXT_OP_QUERY_ID     : u64 = 0
  pub let PXT_OP_QUERY_SNAP   : u64 = 1
  pub let PXT_OP_QUERY_WAL    : u64 = 2
  pub let PXT_OP_QUERY_BYTES  : u64 = 3
  pub let PXT_OP_QUERY_STATE  : u64 = 4
  pub let PXT_OP_QUERY_MODE   : u64 = 5
  pub let PXT_OP_DEBUG_PRINT  : u64 = 6
  pub let PXT_OP_MAX          : u64 = 6

  pub let PXT_OK              : u64 = 0
  pub let PXT_TAIL_ENOSPC     : u64 = 0xFFFFEC1F
  pub let PXT_TAIL_BAD_ARG    : u64 = 0xFFFFEC1E
  pub let PXT_MINT_BAD_PARENT : u64 = 0xFFFFEC1D
  pub let PXT_MINT_BAD_RIGHTS : u64 = 0xFFFFEC1C
  pub let PXT_MINT_BAD_ID     : u64 = 0xFFFFEC1B
  pub let PXT_MINT_BAD_MODE   : u64 = 0xFFFFEC1A
  pub let PXT_MINT_BAD_STATE  : u64 = 0xFFFFEC19
  pub let PXT_BAD_SLOT        : u64 = 0xFFFFEC18
  pub let PXT_WRONG_KIND      : u64 = 0xFFFFEC17
  pub let PXT_REVOKE_ALREADY  : u64 = 0xFFFFEC16

  pub let PXT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PXT_ROW_NONE   : u64 = 0xFF

  pub let PXT_MAX       : u64 = 16
  pub let PXT_ROW_BYTES : u64 = 48
  pub let mut _pdxfs_txn_table : [u64; 96] = uninit @align(64)
  pub let mut _pdxfs_txn_stats : [u64; 8]  = uninit @align(64)

  pub let PXT_ST_MINTS     : u64 = 0
  pub let PXT_ST_REVOKES   : u64 = 1
  pub let PXT_ST_QUERIES   : u64 = 2
  pub let PXT_ST_REFUSED   : u64 = 3
  pub let PXT_ST_COMMITS   : u64 = 4
  pub let PXT_ST_ABORTS    : u64 = 5
  pub let PXT_ST_MAX       : u64 = 8

  pub let pdxfs_txn_dbg_msg : [u8; 14] = "PDXFS TXN ROW\0"

  pub let pdxfs_txn_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): clear every row and every counter. Boot and teardown only. Labels prefixed pxt_rs_.",
      block: {
        lea r10, [rip + _pdxfs_txn_table];
        xor rax, rax;
        xor rcx, rcx;
      pxt_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  pxt_rs_rows;

        lea r10, [rip + _pdxfs_txn_stats];
        xor rcx, rcx;
      pxt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pxt_rs_stats;
        ret
      }
    }

  pub let pdxfs_txn_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bounded increment; out-of-range no-op. Labels prefixed pxt_nt_.",
      block: {
        cmp rdi, 8;
        jae pxt_nt_out;
        lea r10, [rip + _pdxfs_txn_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pxt_nt_out:
        ret
      }
    }

  pub let pdxfs_txn_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bounded read; out-of-range returns 0. Labels prefixed pxt_st_.",
      block: {
        cmp rdi, 8;
        jae pxt_st_zero;
        lea r10, [rip + _pdxfs_txn_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pxt_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): subset test against R_PDXFS_TXN_ALL = 0x618. Labels prefixed pxt_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x618;
        and rax, r10;
        cmp rax, rdi;
        jne pxt_rv_no;
        mov rax, 1;
        ret;
      pxt_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_mode_valid : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): 1 iff mode in [1, PXT_MODE_MAX = 3]. Zero is refused (no txn is meaningfully mode-less). Labels prefixed pxt_mv_.",
      block: {
        cmp rdi, 1;
        jb  pxt_mv_no;
        mov r10, 3;
        cmp rdi, r10;
        ja  pxt_mv_no;
        mov rax, 1;
        ret;
      pxt_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): derivation gate. parent.kind == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200). Same shape as pdxfs_file_check_parent_memory. Labels prefixed pxt_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae pxt_cpm_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne pxt_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  pxt_cpm_no;

        mov rax, 1;
        ret;

      pxt_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | state[15:8] | mode[7:0].
  // Callers pack via pdxfs_txn_hdr_pack(mode, state).
  pub let pdxfs_txn_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (mode: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48b substrate-prep (#1624): canonical header encoder. Validates mode in [1..3] and state in [1..4]. Bits [63:56] MUST leave this function zero. Labels prefixed pxt_hp_.",
      block: {
        cmp rdi, 1;
        jb  pxt_hp_bad;
        mov r10, 3;
        cmp rdi, r10;
        ja  pxt_hp_bad;
        cmp rsi, 1;
        jb  pxt_hp_bad;
        mov r10, 4;
        cmp rsi, r10;
        ja  pxt_hp_bad;
        mov rax, rdi;                    // mode in [7:0]
        mov r11, rsi;
        shl r11, 8;
        or  rax, r11;                    // state in [15:8]
        ret;
      pxt_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // tail_alloc(hdr, txn_id, snap_gen, wal_off, expire_ns).  bytes_touched
  // starts at 0 -- the walker bumps it as writes flow through.
  pub let pdxfs_txn_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (txn_id: u64) (snap_gen: u64) (wal_off: u64) (expire_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): claim one txn row. THE ONLY WRITER of _pdxfs_txn_table; tools/build.sh confines it. Gates: hdr in_use pre-set -> BAD_ARG; hdr bits [55:16] non-zero -> BAD_ARG; txn_id == 0 -> BAD_ID. Six callee-save pushes leave rsp%16 == 0. Labels prefixed pxt_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // txn_id
        mov r14, rdx;                    // snap_gen
        mov r15, rcx;                    // wal_off
        mov rbp, r8;                     // expire_ns

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne pxt_ta_bad;

        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        jne pxt_ta_bad;

        cmp r13, 0;
        je  pxt_ta_bad_id;

        xor rbx, rbx;
      pxt_ta_scan:
        cmp rbx, 16;
        jae pxt_ta_enospc;

        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rbx;
        shl r11, 5;
        mov rax, rbx;
        shl rax, 4;
        add r11, rax;                    // row * 48
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pxt_ta_claim;

        add rbx, 1;
        jmp pxt_ta_scan;

      pxt_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        xor rax, rax;
        mov [r10 + 32], rax;             // bytes_touched = 0
        mov [r10 + 40], rbp;
        mov rax, rbx;
        jmp pxt_ta_out;

      pxt_ta_enospc:
        mov rax, 0xFFFFEC1F;             // PXT_TAIL_ENOSPC
        jmp pxt_ta_out;
      pxt_ta_bad_id:
        mov rax, 0xFFFFEC1B;             // PXT_MINT_BAD_ID
        jmp pxt_ta_out;
      pxt_ta_bad:
        mov rax, 0xFFFFEC1E;             // PXT_TAIL_BAD_ARG

      pxt_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pdxfs_txn_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): 1 iff row < PXT_MAX and in_use byte set. Labels prefixed pxt_tv_.",
      block: {
        cmp rdi, 16;
        jae pxt_tv_no;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pxt_tv_no;
        mov rax, 1;
        ret;
      pxt_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pdxfs_txn_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): scrub row (all six words). Labels prefixed pxt_tf_.",
      block: {
        cmp rdi, 16;
        jae pxt_tf_out;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      pxt_tf_out:
        ret
      }
    }

  // Row accessors.
  pub let pdxfs_txn_row_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): txn_id, or PXT_DECODE_BAD. Labels prefixed pxt_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rid_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp pxt_rid_out;
      pxt_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rid_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_snap : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): snap_gen, or PXT_DECODE_BAD. Labels prefixed pxt_rsnap_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rsnap_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp pxt_rsnap_out;
      pxt_rsnap_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rsnap_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_wal : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): wal_off, or PXT_DECODE_BAD. Labels prefixed pxt_rwal_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rwal_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp pxt_rwal_out;
      pxt_rwal_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rwal_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_bytes : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): bytes_touched, or PXT_DECODE_BAD. Labels prefixed pxt_rbytes_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rbytes_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp pxt_rbytes_out;
      pxt_rbytes_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rbytes_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): state byte, or PXT_DECODE_BAD. Labels prefixed pxt_rstate_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rstate_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp pxt_rstate_out;
      pxt_rstate_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rstate_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): mode byte, or PXT_DECODE_BAD. Labels prefixed pxt_rmode_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rmode_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        jmp pxt_rmode_out;
      pxt_rmode_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rmode_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): slot -> row_id, gated on the descriptor being a live KIND_PDXFS_TXN. Kind constant 0x196 staged in r11. Labels prefixed pxt_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae pxt_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x196;                  // KIND_PDXFS_TXN
        cmp r10, r11;
        jne pxt_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_ros_none;

        mov rax, r12;
        jmp pxt_ros_out;

      pxt_ros_none:
        mov rax, 0xFF;                   // PXT_ROW_NONE
      pxt_ros_out:
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): scrub row + bump REVOKES; distinguishes never-existed (BAD_SLOT) from already-gone (REVOKE_ALREADY). Two callee-save pushes leave rsp%16 == 0. Labels prefixed pxt_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae pxt_cr_bad_slot;

        mov rdi, r12;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_cr_already;

        mov rdi, r12;
        call pdxfs_txn_tail_free;
        mov rdi, 1;                      // PXT_ST_REVOKES
        call pdxfs_txn_note;
        xor rax, rax;
        jmp pxt_cr_out;

      pxt_cr_bad_slot:
        mov rax, 0xFFFFEC18;             // PXT_BAD_SLOT
        jmp pxt_cr_out;
      pxt_cr_already:
        mov rax, 0xFFFFEC16;             // PXT_REVOKE_ALREADY

      pxt_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pdxfs_txn_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (txn_id: u64) (mode: u64) (wal_off: u64) (snap_gen: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): the KIND_PDXFS_TXN mint walker. Gates in order: (1) parent gate; (2) rights subset; (3) mode_valid; (4) hdr_pack (mode, state=OPEN); (5) tail_alloc. expire_ns and snap_gen are populated from the args; bytes_touched starts at 0. Six callee-save pushes + sub rsp, 8 = 56 bytes; post-prologue rsp%16 == 0. Labels prefixed pxt_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // txn_id
        mov r14, rcx;                    // mode
        mov r15, r8;                     // wal_off
        mov rbp, r9;                     // snap_gen

        // (1)
        mov rdi, r12;
        call pdxfs_txn_check_parent_memory;
        cmp rax, 0;
        je  pxt_mi_bad_parent;

        // (2)
        mov rdi, r13;
        call pdxfs_txn_rights_valid;
        cmp rax, 0;
        je  pxt_mi_bad_rights;

        // (3)
        mov rdi, r14;
        call pdxfs_txn_mode_valid;
        cmp rax, 0;
        je  pxt_mi_bad_mode;

        // (4) Pack header with state=OPEN.
        mov rdi, r14;                    // mode
        mov rsi, 1;                      // state = OPEN
        call pdxfs_txn_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pxt_mi_bad_state;

        // (5) tail_alloc(hdr, txn_id, snap_gen, wal_off, expire_ns=0).
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // txn_id
        mov rdx, rbp;                    // snap_gen
        mov rcx, r15;                    // wal_off
        xor r8,  r8;                     // expire_ns = 0 (no deadline for M1)
        call pdxfs_txn_tail_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae pxt_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // PXT_ST_MINTS
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_mi_out;

      pxt_mi_alloc_fail:
        jmp pxt_mi_refused;
      pxt_mi_bad_parent:
        mov rax, 0xFFFFEC1D;             // PXT_MINT_BAD_PARENT
        jmp pxt_mi_refused;
      pxt_mi_bad_rights:
        mov rax, 0xFFFFEC1C;
        jmp pxt_mi_refused;
      pxt_mi_bad_mode:
        mov rax, 0xFFFFEC1A;
        jmp pxt_mi_refused;
      pxt_mi_bad_state:
        mov rax, 0xFFFFEC19;

      pxt_mi_refused:
        push rax;
        mov rdi, 3;                      // PXT_ST_REFUSED
        call pdxfs_txn_note;
        pop rax;

      pxt_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cap_handler_pdxfs_txn : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R48b substrate-prep (#1624): KIND_PDXFS_TXN dispatch. Query ops need R_PDXFS_TXN_INVOKE (0x008); DEBUG_PRINT needs R_PDXFS_TXN_OBSERVE (0x400). op_arg[63:8] refused. Labels prefixed pxt_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne pxt_hn_res;

        cmp rbp, 6;                      // PXT_OP_MAX
        ja  pxt_hn_unsup;

        cmp rbp, 6;
        je  pxt_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  pxt_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  pxt_hn_id;
        cmp rbp, 1;
        je  pxt_hn_snap;
        cmp rbp, 2;
        je  pxt_hn_wal;
        cmp rbp, 3;
        je  pxt_hn_bytes;
        cmp rbp, 4;
        je  pxt_hn_state;
        call pdxfs_txn_row_mode;         // op == 5
        jmp pxt_hn_count;

      pxt_hn_id:
        call pdxfs_txn_row_id;
        jmp pxt_hn_count;
      pxt_hn_snap:
        call pdxfs_txn_row_snap;
        jmp pxt_hn_count;
      pxt_hn_wal:
        call pdxfs_txn_row_wal;
        jmp pxt_hn_count;
      pxt_hn_bytes:
        call pdxfs_txn_row_bytes;
        jmp pxt_hn_count;
      pxt_hn_state:
        call pdxfs_txn_row_state;
        jmp pxt_hn_count;

      pxt_hn_count:
        push rax;
        mov rdi, 2;                      // PXT_ST_QUERIES
        call pdxfs_txn_note;
        pop rax;
        jmp pxt_hn_out;

      pxt_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  pxt_hn_denied;
        xor rax, rax;
        jmp pxt_hn_out;

      pxt_hn_res:
        mov rax, 0xFFFFEC1E;
        jmp pxt_hn_out;
      pxt_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp pxt_hn_out;
      pxt_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      pxt_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
