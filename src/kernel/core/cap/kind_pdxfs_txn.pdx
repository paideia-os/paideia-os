  pub let pdxfs_txn_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48b substrate-prep (#1624): state byte, or PXT_DECODE_BAD. Labels prefixed pxt_rstate_.",
      block: {
        push r12;
        mov r12, rdi;
        call pdxfs_txn_tail_valid;
        cmp rax, 0;
        je  pxt_rstate_bad;
        lea r10, [rip + _pdxfs_txn_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp pxt_rstate_out;
      pxt_rstate_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pxt_rstate_out:
        pop r12;
        ret
