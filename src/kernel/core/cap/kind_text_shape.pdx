  // ts_find_by_key_scale(key, scale_num, scale_den) -> row_id | TS_ROW_NONE.
  // The uniqueness key that expresses P9's "scale change forces a
  // remint" property: two shapes with the same key but different
  // scale are DIFFERENT rows, and two remints with the same triple
  // are refused as duplicates.
  pub let ts_find_by_key_scale : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (key: u64) (snum: u64) (sden: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497) + G5.M3-002 (#1502): linear scan for (key, scale_num, scale_den) triple.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        xor rbx, rbx;
      ts_fks_scan:
        cmp rbx, 32;
        jae ts_fks_none;
        lea r10, [rip + _text_shape_table];
        mov r11, rbx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ts_fks_step;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne ts_fks_step;
        mov rax, [r10 + 32];
        mov rcx, rax;
        and rcx, 0xFFFF;
        cmp rcx, r13;
        jne ts_fks_step;
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, r14;
        jne ts_fks_step;
        mov rax, rbx;
        jmp ts_fks_out;
      ts_fks_step:
        add rbx, 1;
        jmp ts_fks_scan;
      ts_fks_none:
        mov rax, 0xFF;
      ts_fks_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

