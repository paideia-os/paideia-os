  pub let cap_handler_text_shape : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G5.M2-002 (#1497): KIND_TEXT_SHAPE dispatch. QUERY ops take NO OPERAND.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_text_shape_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne ts_hn_res;

        cmp rbp, 9;
        ja  ts_hn_unsup;

        cmp rbp, 9;
        je  ts_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  ts_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  ts_hn_key;
        cmp rbp, 1;
        je  ts_hn_script;
        cmp rbp, 2;
        je  ts_hn_dir;
        cmp rbp, 3;
        je  ts_hn_atlas;
        cmp rbp, 4;
        je  ts_hn_glyphs;
        cmp rbp, 5;
        je  ts_hn_ew;
        cmp rbp, 6;
        je  ts_hn_eh;
        cmp rbp, 7;
        je  ts_hn_sn;
        call ts_row_scale_d;
        jmp ts_hn_out;

      ts_hn_key:
        call ts_row_key;
        jmp ts_hn_out;
      ts_hn_script:
        call ts_row_script;
        jmp ts_hn_out;
      ts_hn_dir:
        call ts_row_dir;
        jmp ts_hn_out;
      ts_hn_atlas:
        call ts_row_atlas;
        jmp ts_hn_out;
      ts_hn_glyphs:
        call ts_row_glyphs;
        jmp ts_hn_out;
      ts_hn_ew:
        call ts_row_ext_w;
        jmp ts_hn_out;
      ts_hn_eh:
        call ts_row_ext_h;
        jmp ts_hn_out;
      ts_hn_sn:
        call ts_row_scale_n;
        jmp ts_hn_out;

      ts_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  ts_hn_denied;
        xor rax, rax;
        jmp ts_hn_out;

      ts_hn_res:
        mov rax, 0xFFFFEE3E;
        jmp ts_hn_out;
      ts_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp ts_hn_out;
      ts_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      ts_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
