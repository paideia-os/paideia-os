        lea r10, [rip + _text_shape_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp ts_rs_out;
      ts_rs_bad:
