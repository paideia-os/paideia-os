  pub let ts_row_glyphs : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): glyph_count at body2[31:16].",
      block: {
        push r12;
        mov r12, rdi;
        call ts_tail_valid;
        cmp rax, 0;
