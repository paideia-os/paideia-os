// src/kernel/core/cap/kind_text_shape.pdx -- G5.M2-002 (#1497)
//
// KIND_TEXT_SHAPE = 0x18C, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// One immutable, shaped run of text. The output of the shaper for a
// (script, direction, features_hash, font_atlas_slot, size) tuple
// against a source string. Compositor / IME / semantic-terminal
// hold ONE cap per rendered run so they can reason about extent +
// baseline without re-running the shaper, and so the shaper's
// result cache has a cap that expresses "still needed" for
// eviction policy.
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// A hosted stack passes shape results by pointer -- an array of
// glyph_id + advance + offset structs the caller must know how to
// interpret. Ownership drifts silently: which process may free the
// buffer, and which may write into it under partial redraw, is a
// convention people rediscover per stack. paideia expresses it as a
// CAP over KIND_MEMORY: the row is IMMUTABLE after mint (no setter
// for any field), and revoke-and-remint is the only way to advance
// a stale shape. That maps directly onto the P9 acceptance: a scale
// change forces a remint, and every fractional-scale-aware
// sub-pixel positioning cache lookup goes through the row's
// (shape_key, scale_num, scale_den) uniqueness key.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The kind half of the gate demands `kind == KIND_MEMORY (4)`
// carrying RIGHT_MINT. The mint additionally requires:
//
//   (a) shape_key non-zero
//   (b) script in [1, TEXT_SCRIPT_MAX]
//   (c) direction in {LTR=0, RTL=1, TTB=2, BTT=3}
//   (d) font_atlas_slot < 256 and names a live KIND_FONT_ATLAS (0x18B)
//   (e) glyph_count in [1, TEXT_SHAPE_MAX_GLYPHS]
//   (f) extent_w and extent_h in [1, TEXT_SHAPE_MAX_EXTENT]
//   (g) (scale_num, scale_den) both in (0, TEXT_SHAPE_SCALE_MAX]
//   (h) (shape_key, scale_num, scale_den) triple unique among live rows
//   (i) rights subset of R_TS_ALL (R_MINT PRESENT -- sub-runs derive)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 40 BYTES (FIVE u64 WORDS)
// =============================================================================
//
//   [+0]  header: in_use[63:56] | parent_slot[15:8]
//   [+8]  shape_key (u64)
//   [+16] body1: script[15:0] | direction[23:16] | reserved[31:24]
//              | features_hash[63:32]
//   [+24] body2: font_atlas_slot[15:0] | glyph_count[31:16]
//              | extent_w[47:32] | extent_h[63:48]
//   [+32] body3: scale_num[15:0] | scale_den[31:16] | flags[63:32]
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEE30..0xFFFFEE3F
// =============================================================================

module KindTextShape = structure {

  pub let KIND_TEXT_SHAPE  : u64 = 0x18C
  pub let TS_PARENT_KIND   : u64 = 4                   // KIND_MEMORY
  pub let TS_ATLAS_KIND    : u64 = 0x18B               // KIND_FONT_ATLAS

  // Rights. R_MINT PRESENT -- sub-runs (BiDi / Indic clusters) derive.
  pub let R_TS_READ    : u64 = 0x001
  pub let R_TS_INVOKE  : u64 = 0x008
  pub let R_TS_REVOKE  : u64 = 0x010
  pub let R_TS_MINT    : u64 = 0x200
  pub let R_TS_OBSERVE : u64 = 0x400
  pub let R_TS_ALL     : u64 = 0x619

  // Directions.
  pub let TEXT_DIR_LTR : u64 = 0
  pub let TEXT_DIR_RTL : u64 = 1
  pub let TEXT_DIR_TTB : u64 = 2
  pub let TEXT_DIR_BTT : u64 = 3
  pub let TEXT_DIR_MAX : u64 = 3

  // Script ordinals. Small enumerated set the shaper knows how to
  // pass to script-specific engines. Adding a new script requires an
  // entry here so the validator has a value to accept.
  pub let TEXT_SCRIPT_LATIN     : u64 = 1
  pub let TEXT_SCRIPT_CYRILLIC  : u64 = 2
  pub let TEXT_SCRIPT_GREEK     : u64 = 3
  pub let TEXT_SCRIPT_ARABIC    : u64 = 4
  pub let TEXT_SCRIPT_HEBREW    : u64 = 5
  pub let TEXT_SCRIPT_CJK       : u64 = 6
  pub let TEXT_SCRIPT_HIRAGANA  : u64 = 7
  pub let TEXT_SCRIPT_KATAKANA  : u64 = 8
  pub let TEXT_SCRIPT_HANGUL    : u64 = 9
  pub let TEXT_SCRIPT_DEVANAGARI : u64 = 10
  pub let TEXT_SCRIPT_BENGALI   : u64 = 11
  pub let TEXT_SCRIPT_TAMIL     : u64 = 12
  pub let TEXT_SCRIPT_MAX       : u64 = 12

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED.
  pub let TS_OP_QUERY_KEY     : u64 = 0
  pub let TS_OP_QUERY_SCRIPT  : u64 = 1
  pub let TS_OP_QUERY_DIR     : u64 = 2
  pub let TS_OP_QUERY_ATLAS   : u64 = 3
  pub let TS_OP_QUERY_GLYPHS  : u64 = 4
  pub let TS_OP_QUERY_EXT_W   : u64 = 5
  pub let TS_OP_QUERY_EXT_H   : u64 = 6
  pub let TS_OP_QUERY_SCALE_N : u64 = 7
  pub let TS_OP_QUERY_SCALE_D : u64 = 8
  pub let TS_OP_DEBUG_PRINT   : u64 = 9
  pub let TS_OP_MAX           : u64 = 9

  // Failure taxonomy -- 0xFFFFEE30..0xFFFFEE3F.
  pub let TS_OK               : u64 = 0
  pub let TS_TAIL_ENOSPC      : u64 = 0xFFFFEE3F
  pub let TS_TAIL_BAD_ARG     : u64 = 0xFFFFEE3E
  pub let TS_MINT_BAD_PARENT  : u64 = 0xFFFFEE3D
  pub let TS_MINT_BAD_RIGHTS  : u64 = 0xFFFFEE3C
  pub let TS_MINT_BAD_SCRIPT  : u64 = 0xFFFFEE3B
  pub let TS_MINT_BAD_DIR     : u64 = 0xFFFFEE3A
  pub let TS_MINT_BAD_ATLAS   : u64 = 0xFFFFEE39
  pub let TS_MINT_BAD_GLYPHS  : u64 = 0xFFFFEE38
  pub let TS_MINT_BAD_EXTENT  : u64 = 0xFFFFEE37
  pub let TS_MINT_BAD_SCALE   : u64 = 0xFFFFEE36
  pub let TS_MINT_NO_KEY      : u64 = 0xFFFFEE35
  pub let TS_MINT_ENOSPC      : u64 = 0xFFFFEE34
  pub let TS_MINT_KEY_IN_USE  : u64 = 0xFFFFEE33
  pub let TS_BAD_SLOT         : u64 = 0xFFFFEE32
  pub let TS_WRONG_KIND       : u64 = 0xFFFFEE31
  pub let TS_REVOKE_ALREADY   : u64 = 0xFFFFEE30

  pub let TS_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TS_ROW_NONE   : u64 = 0xFF

  pub let TS_MAX          : u64 = 32
  pub let TS_ROW_BYTES    : u64 = 40

  pub let TEXT_SHAPE_MAX_GLYPHS : u64 = 65535
  pub let TEXT_SHAPE_MAX_EXTENT : u64 = 16384
  pub let TEXT_SHAPE_SCALE_MAX  : u64 = 65535

  // THE ONE STATE CELL. Confined by tools/build.sh.
  // 32 rows * 40 bytes = 1280 bytes = 160 u64.
  pub let mut _text_shape_table : [u64; 160] = uninit @align(64)
  pub let mut _text_shape_stats : [u64; 4]   = uninit @align(64)

  pub let TS_ST_MINTS   : u64 = 0
  pub let TS_ST_REVOKES : u64 = 1
  pub let TS_ST_REFUSED : u64 = 2
  pub let TS_ST_QUERIES : u64 = 3

  pub let ts_dbg_msg : [u8; 16] = "TEXT SHAPE ROW\0\0"

  pub let ts_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): clear row table + counters.",
      block: {
        lea r10, [rip + _text_shape_table];
        xor rax, rax;
        xor rcx, rcx;
      ts_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 160;
        jb  ts_rs_rows;

        lea r10, [rip + _text_shape_stats];
        xor rcx, rcx;
      ts_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  ts_rs_stats;
        ret
      }
    }

  pub let ts_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): counter bump.",
      block: {
        cmp rdi, 4;
        jae ts_nt_out;
        lea r10, [rip + _text_shape_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ts_nt_out:
        ret
      }
    }

  pub let ts_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): counter read.",
      block: {
        cmp rdi, 4;
        jae ts_st_zero;
        lea r10, [rip + _text_shape_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ts_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ts_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): subset test against R_TS_ALL = 0x619.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne ts_rv_no;
        mov rax, 1;
        ret;
      ts_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ts_script_valid : (u64) -> u64 !{} @{} =
    fn (script: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): 1 iff script in [1, TEXT_SCRIPT_MAX=12].",
      block: {
        cmp rdi, 0;
        je  ts_sv_no;
        mov r10, 12;
        cmp rdi, r10;
        ja  ts_sv_no;
        mov rax, 1;
        ret;
      ts_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ts_dir_valid : (u64) -> u64 !{} @{} =
    fn (dir: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): 1 iff dir <= 3.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  ts_dv_no;
        mov rax, 1;
        ret;
      ts_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ts_glyphs_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): 1 iff 0 < n <= TEXT_SHAPE_MAX_GLYPHS.",
      block: {
        cmp rdi, 0;
        je  ts_gv_no;
        mov r10, 65535;
        cmp rdi, r10;
        ja  ts_gv_no;
        mov rax, 1;
        ret;
      ts_gv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ts_extent_valid : (u64, u64) -> u64 !{} @{} =
    fn (w: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): 1 iff 0 < w, h <= TEXT_SHAPE_MAX_EXTENT.",
      block: {
        cmp rdi, 0;
        je  ts_ev_no;
        mov r10, 16384;
        cmp rdi, r10;
        ja  ts_ev_no;
        cmp rsi, 0;
        je  ts_ev_no;
        cmp rsi, r10;
        ja  ts_ev_no;
        mov rax, 1;
        ret;
      ts_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let ts_scale_valid : (u64, u64) -> u64 !{} @{} =
    fn (num: u64) (den: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): 1 iff 0 < num, den <= TEXT_SHAPE_SCALE_MAX.",
      block: {
        cmp rdi, 0;
        je  ts_sc_no;
        mov r10, 65535;
        cmp rdi, r10;
        ja  ts_sc_no;
        cmp rsi, 0;
        je  ts_sc_no;
        cmp rsi, r10;
        ja  ts_sc_no;
        mov rax, 1;
        ret;
      ts_sc_no:
        xor rax, rax;
        ret
      }
    }

  // body1: script[15:0] | direction[23:16] | reserved[31:24]
  //      | features_hash[63:32]
  pub let ts_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (script: u64) (dir: u64) (fhash: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): body1 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  ts_b1_bad;
        mov r10, 0xFF;
        cmp rsi, r10;
        ja  ts_b1_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        shl r10, 32;
        or  rax, r10;
        ret;
      ts_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: font_atlas_slot[15:0] | glyph_count[31:16]
  //      | extent_w[47:32] | extent_h[63:48]
  pub let ts_body2_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (atlas: u64) (gcount: u64) (w: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): body2 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  ts_b2_bad;
        cmp rsi, r10;
        ja  ts_b2_bad;
        cmp rdx, r10;
        ja  ts_b2_bad;
        cmp rcx, r10;
        ja  ts_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      ts_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body3: scale_num[15:0] | scale_den[31:16] | flags[63:32]
  pub let ts_body3_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (snum: u64) (sden: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): body3 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  ts_b3_bad;
        cmp rsi, r10;
        ja  ts_b3_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        shl r10, 32;
        or  rax, r10;
        ret;
      ts_b3_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let ts_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-002 (#1497): pack header sans in_use bit.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae ts_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      ts_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ts_tail_alloc(hdr, shape_key, body1, body2, body3) -> row_id | err.
  pub let ts_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (shape_key: u64) (body1: u64) (body2: u64) (body3: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): claim one TEXT_SHAPE row.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;
        mov rbp, r8;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne ts_ta_bad;
        cmp r13, 0;
        je  ts_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  ts_ta_bad;
        cmp r15, r10;
        je  ts_ta_bad;
        cmp rbp, r10;
        je  ts_ta_bad;

        xor rbx, rbx;
      ts_ta_scan:
        cmp rbx, 32;                        // TS_MAX
        jae ts_ta_enospc;
        lea r10, [rip + _text_shape_table];
        mov r11, rbx;
        imul r11, r11, 40;                  // 40-byte row stride
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ts_ta_claim;
        add rbx, 1;
        jmp ts_ta_scan;

      ts_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov [r10 + 32], rbp;
        mov rax, rbx;
        jmp ts_ta_out;

      ts_ta_enospc:
        mov rax, 0xFFFFEE3F;
        jmp ts_ta_out;
      ts_ta_bad:
        mov rax, 0xFFFFEE3E;

      ts_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ts_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): 1 iff row_id < TS_MAX and in_use.",
      block: {
        cmp rdi, 32;
        jae ts_tv_no;
        lea r10, [rip + _text_shape_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ts_tv_no;
        mov rax, 1;
        ret;
      ts_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ts_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): scrub one row.",
      block: {
        cmp rdi, 32;
        jae ts_tf_out;
        lea r10, [rip + _text_shape_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
      ts_tf_out:
        ret
      }
    }

  pub let ts_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-002 (#1497): shape_key.",
      block: {
        push r12;
        mov r12, rdi;
        call ts_tail_valid;
        cmp rax, 0;
        je  ts_rk_bad;
        lea r10, [rip + _text_shape_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp ts_rk_out;
      ts_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ts_rk_out:
        pop r12;
        ret
      }
    }

  pub let ts_row_script : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
