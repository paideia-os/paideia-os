// src/kernel/core/cap/kind_display_timeline.pdx -- G1.M1-001 (#1427)
//
// KIND_DISPLAY_TIMELINE = 0x185, derived over KIND_HW (14).
//
// One drm-syncobj-shaped display timeline: a monotone u64 value
// latched on vblank by the display engine, one timeline per (engine,
// output) pair. The primitive that makes P1 (no implicit sync)
// expressible across the whole G-round.
//
// =============================================================================
// SECTION 0  WHAT THIS KIND IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the CAPABILITY that names ONE display timeline: an integer
// row_id in [0, DPT_MAX), whose row records the (timeline_id,
// engine_id, output_id) triple identifying it and the last_scanout_
// value the vblank handler most recently latched (G1.M1-003 #1429).
//
// It is NOT the vblank ISR (that lives in drivers/dpy/timeline.pdx),
// NOT the wait primitive (that lives in drivers/dpy/timeline.pdx),
// NOT the display-sync channel (that lives in ipc/display_sync_
// channel.pdx). This kind owns only the row table and the row-
// accessor + counter shape, matching the KIND_HW_INTERRUPT /
// KIND_HW_MSIX_VECTOR discipline.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_HW
// =============================================================================
//
// The gate demands `kind == KIND_HW (14)` carrying RIGHT_MINT. A
// display timeline is a hardware-adjacent authority -- its value
// advances on a hardware event (vblank) -- so the sheltering base
// kind is KIND_HW rather than KIND_IPC_ENDPOINT (which would suggest
// the value is set by an IPC conversation) or KIND_DEVICE (which
// would suggest arbitrary MMIO reach). The mint additionally
// requires:
//
//   (a) timeline_id non-zero and unique among live rows (NO_KEY /
//       IN_USE)
//   (b) engine_id fits u16 (BAD_ENGINE); 0 is refused (a timeline
//       without an engine is not a live timeline)
//   (c) output_id fits u16 (BAD_OUTPUT); 0 is refused (a timeline
//       without an output is not a live timeline)
//   (d) rights subset of R_DPT_ALL (R_MINT ABSENT -- leaf kind)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  timeline_id (u64)
//   [+16] body1:   engine_id[15:0] | output_id[31:16] | reserved[63:32]
//   [+24] last_scanout_value (u64) -- monotone, wraps per §3
//
// last_scanout_value is the ONE mutable field. Every other identity
// field is frozen at mint. The signal helper in drivers/dpy/timeline
// .pdx is the one writer; tools/build.sh confines the table symbol
// to this file plus the signal driver's object.
//
// =============================================================================
// SECTION 3  U64 WRAP DISCIPLINE (G1.M3-003 #1439)
// =============================================================================
//
// drm-syncobj values are u64 monotone. At the T14's max eDP refresh
// of 240 Hz a wrap would take 2^64 / 240 / 60 / 60 / 24 / 365 = 2.44
// billion years, so wrap CANNOT be observed at runtime. However, the
// COMPARISON used by dpt_wait_le (G1.M1-004 #1430) is a wraparound
// comparison (signed subtraction) rather than an unsigned less-than,
// so a waiter minted with an out-of-band value near u64 max is
// documented as legal input. The wait primitive's implementation
// treats (a - b) as signed to admit near-wrap arithmetic without
// spurious timeouts.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFF6A0..0xFFFFF6AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band. Adjacent free bands: 0xFFFFF690..9F (reserved
// for KIND_VRR_RANGE below).

module KindDisplayTimeline = structure {

  pub let KIND_DISPLAY_TIMELINE : u64 = 0x185
  pub let DPT_PARENT_KIND       : u64 = 14           // = KIND_HW

  // Rights. R_MINT (0x200) NOT in the mask (leaf kind).
  pub let R_DPT_READ    : u64 = 0x001
  pub let R_DPT_WRITE   : u64 = 0x002               // signal authority
  pub let R_DPT_INVOKE  : u64 = 0x008
  pub let R_DPT_REVOKE  : u64 = 0x010
  pub let R_DPT_OBSERVE : u64 = 0x400
  pub let R_DPT_ALL     : u64 = 0x41B

  // Ops. Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let DPT_OP_QUERY_KEY      : u64 = 0
  pub let DPT_OP_QUERY_ENGINE   : u64 = 1
  pub let DPT_OP_QUERY_OUTPUT   : u64 = 2
  pub let DPT_OP_QUERY_VALUE    : u64 = 3
  pub let DPT_OP_DEBUG_PRINT    : u64 = 4
  pub let DPT_OP_MAX            : u64 = 4

  // Failure taxonomy -- 0xFFFFF6A0..0xFFFFF6AF.
  pub let DPT_OK               : u64 = 0
  pub let DPT_TAIL_ENOSPC      : u64 = 0xFFFFF6AF
  pub let DPT_TAIL_BAD_ARG     : u64 = 0xFFFFF6AE
  pub let DPT_MINT_BAD_PARENT  : u64 = 0xFFFFF6AD
  pub let DPT_MINT_BAD_RIGHTS  : u64 = 0xFFFFF6AC
  pub let DPT_MINT_BAD_ENGINE  : u64 = 0xFFFFF6AB
  pub let DPT_MINT_BAD_OUTPUT  : u64 = 0xFFFFF6AA
  pub let DPT_MINT_NO_KEY      : u64 = 0xFFFFF6A9
  pub let DPT_MINT_ENOSPC      : u64 = 0xFFFFF6A8
  pub let DPT_MINT_IN_USE      : u64 = 0xFFFFF6A7
  pub let DPT_BAD_SLOT         : u64 = 0xFFFFF6A6
  pub let DPT_WRONG_KIND       : u64 = 0xFFFFF6A5
  pub let DPT_REVOKE_ALREADY   : u64 = 0xFFFFF6A4

  pub let DPT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPT_ROW_NONE   : u64 = 0xFF

  pub let DPT_MAX       : u64 = 8
  pub let DPT_ROW_BYTES : u64 = 32

  // THE ONE STATE CELL of this kind. tools/build.sh confines
  // relocations against `_display_timeline_table` to this object and
  // the signal driver's object (core/drivers/dpy/timeline.o), which
  // is the second and only other legitimate writer.
  pub let mut _display_timeline_table : [u64; 32] = uninit @align(64)
  pub let mut _display_timeline_stats : [u64; 4]  = uninit @align(64)

  pub let DPT_ST_MINTS   : u64 = 0
  pub let DPT_ST_REVOKES : u64 = 1
  pub let DPT_ST_REFUSED : u64 = 2
  pub let DPT_ST_SIGNALS : u64 = 3

  pub let dpt_dbg_msg : [u8; 24] = "DISPLAY TIMELINE ROW\0\0\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let dpt_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): clear the DISPLAY TIMELINE row table + counters. Boot and teardown only. Labels prefixed dpt_rs_.",
      block: {
        lea r10, [rip + _display_timeline_table];
        xor rax, rax;
        xor rcx, rcx;
      dpt_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  dpt_rs_rows;

        lea r10, [rip + _display_timeline_stats];
        xor rcx, rcx;
      dpt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dpt_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpt_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-001 (#1427): subset test against R_DPT_ALL = 0x41B. R_MINT (0x200) OUTSIDE the mask. Labels prefixed dpt_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne dpt_rv_no;
        mov rax, 1;
        ret;
      dpt_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpt_engine_valid : (u64) -> u64 !{} @{} =
    fn (e: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-001 (#1427): 1 iff e in (0, 0xFFFF]. Zero is refused (a timeline without an engine is not live). Labels prefixed dpt_ev_.",
      block: {
        cmp rdi, 0;
        je  dpt_ev_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpt_ev_no;
        mov rax, 1;
        ret;
      dpt_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpt_output_valid : (u64) -> u64 !{} @{} =
    fn (o: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-001 (#1427): 1 iff o in (0, 0xFFFF]. Same shape as dpt_engine_valid. Labels prefixed dpt_ov_.",
      block: {
        cmp rdi, 0;
        je  dpt_ov_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpt_ov_no;
        mov rax, 1;
        ret;
      dpt_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let dpt_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): counter bump. Labels prefixed dpt_nt_.",
      block: {
        cmp rdi, 4;
        jae dpt_nt_out;
        lea r10, [rip + _display_timeline_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpt_nt_out:
        ret
      }
    }

  pub let dpt_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): counter read. Labels prefixed dpt_st_.",
      block: {
        cmp rdi, 4;
        jae dpt_st_zero;
        lea r10, [rip + _display_timeline_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpt_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free / accessors.
  //
  // THE ONE WRITER of _display_timeline_table (aside from the vblank
  // signal in drivers/dpy/timeline.pdx). tools/build.sh confines
  // relocations against `_display_timeline_table` to those two files.
  // ==========================================================================

  pub let dpt_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (timeline_id: u64) (body1_packed: u64) (initial_value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): claim one DISPLAY TIMELINE row. Gates: hdr in_use pre-set -> BAD_ARG; timeline_id != 0 -> BAD_ARG; body1 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows. Labels prefixed dpt_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // timeline_id
        mov r14, rdx;                    // body1
        mov r15, rcx;                    // initial_value

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne dpt_ta_bad;

        cmp r13, 0;
        je  dpt_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  dpt_ta_bad;

        xor rbx, rbx;
      dpt_ta_scan:
        cmp rbx, 8;
        jae dpt_ta_enospc;

        lea r10, [rip + _display_timeline_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpt_ta_claim;

        add rbx, 1;
        jmp dpt_ta_scan;

      dpt_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp dpt_ta_out;

      dpt_ta_enospc:
        mov rax, 0xFFFFF6AF;
        jmp dpt_ta_out;
      dpt_ta_bad:
        mov rax, 0xFFFFF6AE;

      dpt_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dpt_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): 1 iff row_id < DPT_MAX and in_use. Labels prefixed dpt_tv_.",
      block: {
        cmp rdi, 8;
        jae dpt_tv_no;
        lea r10, [rip + _display_timeline_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpt_tv_no;
        mov rax, 1;
        ret;
      dpt_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpt_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): scrub one row. Labels prefixed dpt_tf_.",
      block: {
        cmp rdi, 8;
        jae dpt_tf_out;
        lea r10, [rip + _display_timeline_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      dpt_tf_out:
        ret
      }
    }

  pub let dpt_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): timeline_id at [+8]. Labels prefixed dpt_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dpt_rk_bad;
        lea r10, [rip + _display_timeline_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp dpt_rk_out;
      dpt_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpt_rk_out:
        pop r12;
        ret
      }
    }

  pub let dpt_row_engine : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): engine_id at body1[15:0]. Labels prefixed dpt_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dpt_re_bad;
        lea r10, [rip + _display_timeline_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp dpt_re_out;
      dpt_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpt_re_out:
        pop r12;
        ret
      }
    }

  pub let dpt_row_output : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): output_id at body1[31:16]. Labels prefixed dpt_ro_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dpt_ro_bad;
        lea r10, [rip + _display_timeline_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp dpt_ro_out;
      dpt_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpt_ro_out:
        pop r12;
        ret
      }
    }

  pub let dpt_row_value : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): last_scanout_value at [+24]. Labels prefixed dpt_rv2_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dpt_rv2_bad;
        lea r10, [rip + _display_timeline_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp dpt_rv2_out;
      dpt_rv2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpt_rv2_out:
        pop r12;
        ret
      }
    }

  // dpt_row_signal is the SECOND writer of _display_timeline_table.
  // It is intentionally exposed here (rather than living in drivers/
  // dpy/timeline.pdx) so that _display_timeline_table's confinement
  // gate can pin exactly two objects: this file plus timeline.o.
  // Any other object attempting to advance the value is refused at
  // link time by tools/build.sh.
  //
  // WRAP-SAFE: uses unsigned max() rather than a plain overwrite so
  // an out-of-order signal (rare on hardware, common in synthetic
  // fixtures) cannot regress the value. See §3 for the wrap
  // discipline.
  pub let dpt_row_signal : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-003 (#1429): advance last_scanout_value monotonically. Refuses if row not live. Uses unsigned max so an out-of-order signal cannot regress the value. Bumps DPT_ST_SIGNALS. Labels prefixed dpt_sg_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dpt_sg_bad;
        lea r10, [rip + _display_timeline_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        cmp r13, rax;
        jbe dpt_sg_skip;
        mov [r10 + 24], r13;
        mov rdi, 3;                     // DPT_ST_SIGNALS
        call dpt_note;
      dpt_sg_skip:
        xor rax, rax;
        jmp dpt_sg_out;
      dpt_sg_bad:
        mov rax, 0xFFFFF6A6;            // DPT_BAD_SLOT
      dpt_sg_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let dpt_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (timeline_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-001 (#1427): live row holding this timeline_id, or ROW_NONE. Refuses to match 0. Labels prefixed dpt_fk_.",
      block: {
        cmp rdi, 0;
        je  dpt_fk_none;
        xor rcx, rcx;
      dpt_fk_scan:
        cmp rcx, 8;
        jae dpt_fk_none;
        lea r10, [rip + _display_timeline_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpt_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  dpt_fk_hit;
      dpt_fk_next:
        add rcx, 1;
        jmp dpt_fk_scan;
      dpt_fk_hit:
        mov rax, rcx;
        ret;
      dpt_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // dpt_find_by_engine_output(engine_id, output_id) -> row_id | ROW_NONE
  //
  // The vblank ISR path in drivers/dpy/timeline.pdx uses this
  // instead of walking _display_timeline_table itself, so that the
  // one-writer property of the table is expressible in a single-
  // owner confinement gate (kind_display_timeline.o). The driver
  // reaches the row through the exported selector; it never
  // relocates against the table symbol directly.
  // ==========================================================================
  pub let dpt_find_by_engine_output : (u64, u64) -> u64 !{mem} @{} =
    fn (engine_id: u64) (output_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-003 (#1429): linear scan over DPT_MAX for (engine_id, output_id). Refuses to match zero for either. Labels prefixed dpt_feo_.",
      block: {
        cmp rdi, 0;
        je  dpt_feo_none;
        cmp rsi, 0;
        je  dpt_feo_none;
        mov r8, rdi;
        mov r9, rsi;
        xor rcx, rcx;
      dpt_feo_scan:
        cmp rcx, 8;
        jae dpt_feo_none;
        lea r10, [rip + _display_timeline_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpt_feo_next;
        mov rax, [r10 + 16];
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, r8;
        jne dpt_feo_next;
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFF;
        cmp r11, r9;
        jne dpt_feo_next;
        mov rax, rcx;
        ret;
      dpt_feo_next:
        add rcx, 1;
        jmp dpt_feo_scan;
      dpt_feo_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let dpt_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M1-001 (#1427): slot -> row_id, gated on live KIND_DISPLAY_TIMELINE. Labels prefixed dpt_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae dpt_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x185;
        cmp r10, r11;
        jne dpt_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dpt_ros_none;

        mov rax, r12;
        jmp dpt_ros_out;

      dpt_ros_none:
        mov rax, 0xFF;
      dpt_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Five args (slot, parent_slot, rights, timeline_id, packed_ident).
  // packed_ident encoding:
  //   [15:0]  engine_id
  //   [31:16] output_id
  //   [63:32] reserved (must be zero)
  // ==========================================================================

  pub let dpt_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (engine_id: u64) (output_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-001 (#1427): pack engine_id[15:0] | output_id[31:16]. Refuses out-of-range fields. Labels prefixed dpt_b1_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpt_b1_bad;
        cmp rsi, r10;
        ja  dpt_b1_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      dpt_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dpt_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-001 (#1427): (parent_slot << 8). Labels prefixed dpt_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae dpt_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      dpt_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dpt_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M1-001 (#1427): §1 gate. parent must be live KIND_HW (14) with RIGHT_MINT. Labels prefixed dpt_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpt_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 14;                     // KIND_HW
        jne dpt_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  dpt_cp_no;

        mov rax, 1;
        ret;
      dpt_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpt_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (timeline_id: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M1-001 (#1427): mint KIND_DISPLAY_TIMELINE over KIND_HW. Sequence: slot < 256; check_parent; rights_valid; unpack + validate engine/output; timeline_id != 0; uniqueness (IN_USE); hdr_pack; body1_pack; tail_alloc; cap_mint_write. Labels prefixed dpt_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // timeline_id
        mov rbp, r8;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae dpt_mi_bad_slot;

        mov rdi, r12;
        call dpt_check_parent;
        cmp rax, 0;
        je  dpt_mi_bad_parent;

        mov rdi, r13;
        call dpt_rights_valid;
        cmp rax, 0;
        je  dpt_mi_bad_rights;

        mov rdi, rbp;
        and rdi, 0xFFFF;
        call dpt_engine_valid;
        cmp rax, 0;
        je  dpt_mi_bad_engine;

        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFFFF;
        call dpt_output_valid;
        cmp rax, 0;
        je  dpt_mi_bad_output;

        cmp r14, 0;
        je  dpt_mi_no_key;

        mov rdi, r14;
        call dpt_find_by_key;
        cmp rax, 0xFF;
        jne dpt_mi_in_use;

        mov rdi, rbp;
        and rdi, 0xFFFF;
        mov rsi, rbp;
        shr rsi, 16;
        and rsi, 0xFFFF;
        call dpt_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpt_mi_bad_engine;
        mov r15, rax;                    // body1

        mov rdi, r12;
        call dpt_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpt_mi_bad_parent;

        // tail_alloc(hdr, timeline_id, body1, initial_value=0).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r15;
        xor rcx, rcx;
        call dpt_tail_alloc;

        mov r10, 0xFFFFF6AF;             // ENOSPC
        cmp rax, r10;
        je  dpt_mi_enospc;
        mov r10, 0xFFFFF6AE;             // BAD_ARG
        cmp rax, r10;
        je  dpt_mi_bad_engine;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x185;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call dpt_note;

        xor rax, rax;
        jmp dpt_mi_out;

      dpt_mi_bad_slot:
        mov rax, 0xFFFFF6A6;
        jmp dpt_mi_out;
      dpt_mi_bad_parent:
        mov rax, 0xFFFFF6AD;
        jmp dpt_mi_out;
      dpt_mi_bad_rights:
        mov rax, 0xFFFFF6AC;
        jmp dpt_mi_out;
      dpt_mi_bad_engine:
        mov rax, 0xFFFFF6AB;
        jmp dpt_mi_out;
      dpt_mi_bad_output:
        mov rax, 0xFFFFF6AA;
        jmp dpt_mi_out;
      dpt_mi_no_key:
        mov rax, 0xFFFFF6A9;
        jmp dpt_mi_out;
      dpt_mi_in_use:
        mov rdi, 2;
        call dpt_note;
        mov rax, 0xFFFFF6A7;
        jmp dpt_mi_out;
      dpt_mi_enospc:
        mov rdi, 2;
        call dpt_note;
        mov rax, 0xFFFFF6A8;

      dpt_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dpt_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G1.M1-001 (#1427): revoke KIND_DISPLAY_TIMELINE. Labels prefixed dpt_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae dpt_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  dpt_rvk_already;

        mov r11, 0x185;
        cmp r10, r11;
        jne dpt_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dpt_rvk_clear;

        mov rdi, r13;
        call dpt_tail_free;

      dpt_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call dpt_note;

        xor rax, rax;
        jmp dpt_rvk_out;

      dpt_rvk_bad_slot:
        mov rax, 0xFFFFF6A6;
        jmp dpt_rvk_out;
      dpt_rvk_wrong_kind:
        mov rax, 0xFFFFF6A5;
        jmp dpt_rvk_out;
      dpt_rvk_already:
        mov rax, 0xFFFFF6A4;

      dpt_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_display_timeline : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G1.M1-001 (#1427): KIND_DISPLAY_TIMELINE dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed dpt_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_display_timeline_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne dpt_hn_res;

        cmp rbp, 4;
        ja  dpt_hn_unsup;

        cmp rbp, 4;
        je  dpt_hn_dbg;

        // Ops 0..3: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  dpt_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  dpt_hn_key;
        cmp rbp, 1;
        je  dpt_hn_engine;
        cmp rbp, 2;
        je  dpt_hn_output;
        call dpt_row_value;
        jmp dpt_hn_out;

      dpt_hn_key:
        call dpt_row_key;
        jmp dpt_hn_out;
      dpt_hn_engine:
        call dpt_row_engine;
        jmp dpt_hn_out;
      dpt_hn_output:
        call dpt_row_output;
        jmp dpt_hn_out;

      dpt_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  dpt_hn_denied;
        xor rax, rax;
        jmp dpt_hn_out;

      dpt_hn_res:
        mov rax, 0xFFFFF6AE;
        jmp dpt_hn_out;
      dpt_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp dpt_hn_out;
      dpt_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      dpt_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
