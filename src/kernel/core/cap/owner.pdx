// src/kernel/core/cap/owner.pdx — R31.M1-1587 (#1587)
//
// THE OWNER AXIS. "Revoke everything the dead process held."
//
// ---------------------------------------------------------------------
// THE PROPERTY THIS FILE EXISTS TO MAKE TRUE
// ---------------------------------------------------------------------
//
//   When a process dies, every capability it HELD is revoked, and no
//   capability held by anyone else is.
//
// Before this file, that sentence was not expressible. cap_table
// descriptors carried (kind, rights, target_ptr) and no holder, so
// "the capabilities held by process P" was not a representable query.
// A crashed ACPI bubble's OpRegion windows -- and through them its reach
// into the embedded controller -- survived its death, and the next
// process to occupy its pid inherited them.
//
// ---------------------------------------------------------------------
// OWNERSHIP AND LINEAGE ARE DIFFERENT AXES
// ---------------------------------------------------------------------
//
// This is the trap the design is arranged around, so it is stated
// before any code.
//
// EVERY cascade the kernel already has keys on PARENT IDENTITY -- the
// derivation lineage: opregion_cascade_revoke_by_parent takes a cap
// slot, i2c_slave_cascade_revoke_by_bus_row takes a row id,
// gpio_line_cascade_revoke_by_controller takes a bdf key. Owner-based
// revocation keys on HOLDER. These are not the same relation and
// neither implies the other:
//
//   A capability C can be DERIVED FROM a parent owned by X while being
//   HELD BY Y. X dying must cascade to C -- C's authority was carved
//   out of X's, and a sub-window of a window that no longer exists
//   names nothing. Y dying must revoke C -- Y is the process that could
//   exercise it.
//
// Two sweeps, both needed, and the failure modes of substituting one
// for the other are not symmetric. Lineage standing in for ownership
// UNDER-revokes: that is the leak #1587 names. Ownership standing in
// for lineage OVER-revokes in one direction (tearing down a live
// process's derived windows because their root's holder died) and
// UNDER-revokes in the other (missing a child window the dying process
// derived and then handed on).
//
// So this file does not choose between them. IT COMPOSES THEM:
//
//   THE OWNER SWEEP FINDS THE SLOTS.
//   THE PER-KIND AUDITED REVOKE BENEATH EACH SLOT RUNS THE LINEAGE
//   CASCADE.
//
// cap_revoke_slot is deliberately not a loop of three zero stores. It
// dispatches on `kind` to the same opregion_cap_revoke /
// i2c_bus_cap_revoke / i2c_slave_cap_revoke / gpio_line_cap_revoke /
// fw_session_cap_revoke entry points the lineage cascades already call.
// The two axes meet exactly once, at that dispatch, and that is the
// only place they are allowed to meet.
//
// ---------------------------------------------------------------------
// OP_REGION IS THE ONE TRANSITIVE KIND, AND IT STAYS A FIXED POINT
// ---------------------------------------------------------------------
//
// A window can be derived from a window, so revoking a root must reach
// grandchildren. opregion_cascade_revoke_by_parent implements that as
// an ITERATED FIXED POINT -- repeat the full 256-slot scan until a pass
// revokes nothing -- and NOT as recursion, because recursion puts an
// unbounded-depth call chain on a teardown path, which is exactly the
// shape a hostile derivation chain would exploit.
//
// cap_revoke_slot preserves that. For a KIND_OP_REGION slot it calls
// opregion_cascade_revoke_by_parent(slot) and THEN
// opregion_cap_revoke(slot). It does not recurse, does not compute a
// subtree, and does not need to know whether the slot is a root: the
// cascade's own fixed point handles depth, and a leaf simply finds no
// children on pass 1 and terminates on pass 2.
//
// ---------------------------------------------------------------------
// THE OWNER KEY IS (pid, generation), NEVER A BARE PID
// ---------------------------------------------------------------------
//
// pid_alloc is a dense-low-first scan and pid_free zeroes its slot with
// no aging, so a reaped pid is handed to the very next task_new. A
// sweep keyed on the number alone would eventually revoke a LIVE
// process's capabilities -- strictly worse than the leak being fixed.
// The generation comes from _pid_gen[64], the counter #1583 built for
// exactly this. No second mechanism is invented here.
//
// See design/capabilities/ownership-and-lineage.md for the full
// argument, including why the column is a parallel array rather than a
// widened descriptor.

module Owner = structure {

  // ==========================================================================
  // Return codes.
  //
  // The 0xFFFFFE2x band, disjoint from FW_SESSION's 0xFFFFFE1x below it
  // and from every derived kind's block, so a u64 in a mixed error trace
  // still names its origin.
  // ==========================================================================

  pub let CAP_OWNER_OK          : u64 = 0
  pub let CAP_OWNER_BAD_SLOT    : u64 = 0xFFFFFE2F
  pub let CAP_OWNER_BAD_PID     : u64 = 0xFFFFFE2E
  pub let CAP_OWNER_BAD_GEN     : u64 = 0xFFFFFE2D
  pub let CAP_OWNER_NO_TASK     : u64 = 0xFFFFFE2C

  // NOT AN ERROR. The slot's descriptor was already null when the sweep
  // reached it -- ordinarily because a lineage cascade earlier in the
  // SAME sweep cleared it. Distinct from OK so a caller that wants to
  // know whether it did the work can tell.
  pub let CAP_OWNER_ALREADY     : u64 = 0xFFFFFE2B

  // ==========================================================================
  // cap_owner_pack(pid, gen) -> u64
  //
  // The ONLY constructor of an owner key. Every refusal returns
  // CAP_OWNER_NONE (0), which is what makes "an unpackable owner is no
  // owner" a value-level fact rather than a convention: a valid key can
  // never be 0, so it can never match an unowned slot.
  //
  // Refusals, and why each is a refusal rather than a clamp:
  //   pid == 0            -- 0 is the reserved 'no process' pid, and it
  //                          is also what every unowned slot's pid field
  //                          reads as. Clamping would make the two
  //                          indistinguishable.
  //   pid >= 64           -- CAP_OWNER_PID_MAX, which is pid_gen_read's
  //                          own bound. The sweep's domain is exactly
  //                          the domain on which a generation is
  //                          readable. It is ALSO what puts
  //                          CAP_OWNER_KERNEL (pid field 0xFFFF) outside
  //                          the domain entirely rather than merely
  //                          unmatched.
  //   gen & GEN_MASK == 0 -- a generation whose low 48 bits are zero
  //                          would pack to a key whose gen field is 0,
  //                          which is the 'no incarnation' encoding. The
  //                          mask is applied BEFORE the test, not after,
  //                          so gen == 2^48 is refused rather than
  //                          silently becoming 'unowned'.
  // ==========================================================================

  pub let cap_owner_pack : (u64, u64) -> u64 !{} @{} =
    fn (pid: u64) (gen: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M1-1587 (#1587): pack (pid, generation) into the owner-column encoding -- pid in bits [15:0], the low 48 bits of the generation in bits [63:16]. Returns CAP_OWNER_NONE (0) for every refused input, which is the load-bearing property: a valid key is never 0 and never all-ones, so it can match neither an unowned slot nor a kernel-held one no matter what a caller passes. Refuses pid == 0 and pid >= CAP_OWNER_PID_MAX (64) -- the latter being pid_gen_read's own bound, so the sweep's domain is exactly the domain on which a generation is readable, and CAP_OWNER_KERNEL's 0xFFFF pid field is outside it. Refuses a generation whose low 48 bits are zero, masking BEFORE the test so gen == 2^48 is refused rather than silently packing as 'no incarnation'. Leaf, no nested calls, rax/r10/r11 caller-save scratch only. Reserved labels: cap_own_pk_.",
      block: {
        // pid must be a real, generation-readable pid.
        cmp rdi, 0;
        je  cap_own_pk_none;
        mov r10, 64;                     // CAP_OWNER_PID_MAX
        cmp rdi, r10;
        jae cap_own_pk_none;

        // generation, truncated to 48 bits, must be non-zero.
        mov rax, rsi;
        mov r10, 0xFFFFFFFFFFFF;         // CAP_OWNER_GEN_MASK
        and rax, r10;
        cmp rax, 0;
        je  cap_own_pk_none;

        shl rax, 16;                     // CAP_OWNER_GEN_SH
        or  rax, rdi;
        ret;

      cap_own_pk_none:
        xor rax, rax;                    // CAP_OWNER_NONE
        ret
      }
    }

  // ==========================================================================
  // cap_owner_get(slot) -> u64
  //
  // The owner key stored at slot, or CAP_OWNER_NONE for an out-of-range
  // slot. Collapsing the two is deliberate and costs no information:
  // every consumer treats 0 as "no process owns this", and an
  // out-of-range slot is owned by no process in the most literal sense.
  // ==========================================================================

  pub let cap_owner_get : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): read cap_owner[slot]. Bound is `cmp rdi, 256 / jae` so slot 256 is refused rather than reading one qword past the declared [u64; 256] array -- the same fencepost #740 closed in pid_alloc. Answers CAP_OWNER_NONE for out-of-range, which is not a sentinel collision: 0 already means 'no process owns this' and an out-of-range slot is owned by no process. Leaf, callee-save clean. Reserved labels: cap_own_g_.",
      block: {
        mov r10, 256;                    // CAP_SLOT_MAX
        cmp rdi, r10;
        jae cap_own_g_none;
        lea rax, [rip + cap_owner];
        mov rax, [rax + rdi*8];
        ret;
      cap_own_g_none:
        xor rax, rax;                    // CAP_OWNER_NONE
        ret
      }
    }

  // ==========================================================================
  // cap_owner_set(slot, owner) -> u64
  //
  // The raw column writer. Takes an ALREADY-PACKED key, so it cannot be
  // handed a bare pid by accident -- the only constructor of a key is
  // cap_owner_pack, and the two sentinels are constants.
  // ==========================================================================

  pub let cap_owner_set : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (owner: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): write cap_owner[slot] = owner, refusing an out-of-range slot with CAP_OWNER_BAD_SLOT rather than writing past the array. Takes an ALREADY-PACKED key rather than (pid, gen): the only constructor is cap_owner_pack and the only other legal values are the two sentinels, so a caller cannot pass a bare pid here by accident and get a key whose generation field is zero. Leaf, callee-save clean. Reserved labels: cap_own_s_.",
      block: {
        mov r10, 256;                    // CAP_SLOT_MAX
        cmp rdi, r10;
        jae cap_own_s_bad;
        lea rax, [rip + cap_owner];
        mov [rax + rdi*8], rsi;
        xor rax, rax;                    // CAP_OWNER_OK
        ret;
      cap_own_s_bad:
        mov rax, 0xFFFFFE2F;             // CAP_OWNER_BAD_SLOT
        ret
      }
    }

  // ==========================================================================
  // cap_owner_clear(slot) -> u64
  //
  // Back to CAP_OWNER_NONE. Separate from cap_owner_set so the
  // "un-own this slot" intent is a call rather than a magic argument.
  // ==========================================================================

  pub let cap_owner_clear : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): cap_owner[slot] = CAP_OWNER_NONE. A distinct entry point rather than cap_owner_set(slot, 0) so that 'this slot is owned by nobody' reads as an intent at the call site instead of as a magic zero. One push keeps rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;                        // alignment only: rsp%16 == 0 at the call
        xor rsi, rsi;                    // CAP_OWNER_NONE
        call cap_owner_set;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_owner_live_key(slot) -> key
  //
  // R31.M2-1596 (#1596). The owner key at `slot` IF a live incarnation
  // stands behind it, else CAP_OWNER_NONE.
  //
  // WHY THIS IS NOT cap_owner_get
  //
  // cap_owner_get answers what the column SAYS. This answers whether what
  // it says is still TRUE. The difference is the whole point: a key naming
  // a pid whose incarnation has ended is a fact about the past, and a
  // caller deciding whether it may take a slot must not be blocked by one.
  //
  // cap_owner_sweep_revoke clears the column on every death, so in a
  // correct system a stale key should not exist. This function does not
  // assume that. Deriving liveness from _pid_gen rather than trusting the
  // column means a missed sweep degrades into "a slot looks free" -- the
  // conservative direction -- instead of "a slot is permanently
  // unclaimable by anyone", which is what trusting a stale key would give
  // and which no operator could diagnose.
  //
  // THE THREE ANSWERS
  //
  //   CAP_OWNER_NONE     nobody live holds this slot. Out-of-range slots,
  //                      unowned slots, and slots whose recorded
  //                      incarnation has ended all collapse here, because
  //                      a caller can do exactly the same thing in all
  //                      three cases.
  //
  //   CAP_OWNER_KERNEL   the kernel holds it, permanently. Answered
  //                      VERBATIM and before any generation lookup,
  //                      because the sentinel's pid field is 0xFFFF and
  //                      pid_gen_read's domain stops at 64 -- so a
  //                      generation check would answer "not live" for a
  //                      slot that is the most permanently held of all.
  //                      Getting this backwards would let a loader seed
  //                      over kernel-held authority.
  //
  //   a packed key       a live process holds it. The caller compares it
  //                      against its own key to tell "mine" from "someone
  //                      else's"; this function deliberately does not, so
  //                      it has one meaning rather than one per caller.
  //
  // Registers: two pushes (rbx = slot, r12 = key) keep rsp %16 == 0 at
  // both nested calls and carry the slot across cap_owner_get.
  // ==========================================================================
  pub let cap_owner_live_key : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-1596 (#1596): answer the owner key at `slot` only if a LIVE incarnation stands behind it, else CAP_OWNER_NONE. Built for loader_seed_caps' pre-pass, which must distinguish 'this slot is claimed by a running task' from 'this slot carries a key nobody is behind any more'. Sequence: (1) key = cap_owner_get(slot), which already answers CAP_OWNER_NONE for slot >= CAP_SLOT_MAX, so no bound is re-checked here; (2) key == CAP_OWNER_NONE -> return it; (3) key == CAP_OWNER_KERNEL (all-ones) -> return it VERBATIM, before any generation lookup, because that sentinel's pid field is 0xFFFF and pid_gen_read's domain stops at 64 -- running the generation path over it would answer 'not live' for the one owner that never dies, and a loader would then seed over kernel-held authority; (4) otherwise split the key into pid (bits [15:0]) and stored generation (bits [63:16]), read pid_gen_read(pid), mask it to CAP_OWNER_GEN_MASK, and return the key only on exact equality with the stored generation -- answering CAP_OWNER_NONE for both a pid hosting nothing (pid_gen_read gives 0) and a pid hosting a DIFFERENT incarnation. That second case is the one that matters: pid_alloc is dense-low-first with no aging, so a reaped pid is handed straight to the next task_new, and a pid-only comparison would report a dead task's slot as live and refuse a legitimate seed forever. Liveness is derived from _pid_gen rather than trusted from the column so that a missed sweep degrades to 'the slot looks free' rather than 'the slot is unclaimable by anyone', which is the safer of the two failure directions and the only one an operator could diagnose. Two pushes (rbx = slot, r12 = key) leave rsp %16 == 0 at both nested call sites. Effects {mem} for the column and _pid_gen reads; @{cap} because it reads the capability ownership column. Reserved labels: cap_own_lk_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // rbx = slot

        call cap_owner_get;              // rdi = slot already
        mov r12, rax;                    // r12 = key

        // Unowned.
        cmp r12, 0;                      // CAP_OWNER_NONE
        je  cap_own_lk_none;

        // Kernel-held: live by definition, and outside pid_gen_read's
        // domain. Answered before the generation path, not after it.
        mov rax, 0xFFFFFFFFFFFFFFFF;     // CAP_OWNER_KERNEL
        cmp r12, rax;
        je  cap_own_lk_kernel;

        // pid = key & 0xFFFF
        mov rdi, r12;
        mov rax, 0xFFFF;
        and rdi, rax;

        call pid_gen_read;               // rax = current generation, 0 if none
        mov r10, 0xFFFFFFFFFFFF;         // CAP_OWNER_GEN_MASK
        and rax, r10;
        cmp rax, 0;
        je  cap_own_lk_none;             // pid hosts no live incarnation

        // stored generation = key >> 16, already 48 bits by construction
        mov r11, r12;
        shr r11, 16;                     // CAP_OWNER_GEN_SH
        cmp rax, r11;
        jne cap_own_lk_none;             // a DIFFERENT incarnation of this pid

        mov rax, r12;                    // live, and this is its key
        pop r12;
        pop rbx;
        ret;

      cap_own_lk_kernel:
        mov rax, r12;
        pop r12;
        pop rbx;
        ret;

      cap_own_lk_none:
        xor rax, rax;                    // CAP_OWNER_NONE
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_owner_claim(slot, pid) -> u64
  //
  // The audited way to stamp ownership: read the pid's CURRENT
  // incarnation out of the scheduler and pack it with the pid.
  //
  // Refuses a pid with no live incarnation (pid_gen_read answers 0 for
  // both a never-allocated pid and an out-of-range one). Stamping a slot
  // for a pid that hosts nothing would install a key that the NEXT
  // occupant of that pid slot would match -- the wrong-process
  // revocation this whole design exists to prevent, created at claim
  // time instead of at death time. Same refusal, for the same reason, as
  // driver_death_bind's.
  // ==========================================================================

  pub let cap_owner_claim : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (pid: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): stamp cap_owner[slot] with (pid, pid_gen_read(pid)). Refuses a pid hosting no live incarnation with CAP_OWNER_NO_TASK, and a pid outside pid_gen_read's domain likewise, because pid_gen_read answers 0 for both -- collapsing them costs nothing since neither can legitimately own a capability. That refusal is the claim-time half of the pid-reuse defence: a key installed for a pid that hosts nothing would be matched by the NEXT occupant of that pid slot, which is the wrong-process revocation the (pid, generation) pair exists to prevent, manufactured at claim time rather than at death time. Refuses an unpackable key with CAP_OWNER_BAD_PID so a caller cannot end up with a slot silently left unowned while believing it claimed one. Three pushes (rbx/r12/r13) leave rsp%16 == 0 at both nested calls; rbx = slot, r12 = pid. Reserved labels: cap_own_c_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // pid

        mov rdi, r12;
        call pid_gen_read;
        cmp rax, 0;
        je  cap_own_c_no_task;
        mov r13, rax;                    // generation

        mov rdi, r12;
        mov rsi, r13;
        call cap_owner_pack;
        cmp rax, 0;
        je  cap_own_c_bad_pid;

        mov rdi, rbx;
        mov rsi, rax;
        call cap_owner_set;
        jmp cap_own_c_out;

      cap_own_c_no_task:
        mov rax, 0xFFFFFE2C;             // CAP_OWNER_NO_TASK
        jmp cap_own_c_out;

      cap_own_c_bad_pid:
        mov rax, 0xFFFFFE2E;             // CAP_OWNER_BAD_PID

      cap_own_c_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_owner_claim_kernel(slot) -> u64
  //
  // Mark a slot as the KERNEL'S OWN -- boot-seeded authority, the
  // audit channel's endpoint, anything that belongs to no process.
  //
  // This is NOT the same as leaving the slot at CAP_OWNER_NONE, and the
  // difference is the whole of requirement 4. If "unowned" and "owned by
  // the kernel" were the same value, a sweep for one would collect the
  // other. CAP_OWNER_KERNEL is all-ones, whose pid field is 0xFFFF; the
  // sweep refuses pid >= 64 before scanning, so no caller can construct
  // a sweep that reaches it. CAP_OWNER_NONE is 0, which cap_owner_pack
  // can never return for a valid input.
  // ==========================================================================

  pub let cap_owner_claim_kernel : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): cap_owner[slot] = CAP_OWNER_KERNEL. Distinct from leaving the slot at CAP_OWNER_NONE because 'no process owns this' and 'the kernel owns this' are different facts, and a single value for both would let a sweep for one collect the other. All-ones is chosen so the pid field reads 0xFFFF, which pid_alloc -- ceilinged at 64 -- can never produce, and which cap_owner_sweep_revoke refuses before it scans anything. One push keeps rsp%16 == 0 at the nested call. Reserved labels: none.",
      block: {
        push r12;                        // alignment only: rsp%16 == 0 at the call
        mov rsi, 0xFFFFFFFFFFFFFFFF;     // CAP_OWNER_KERNEL
        call cap_owner_set;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_revoke_slot(slot) -> u64
  //
  // REVOKE ONE CAPABILITY, WHATEVER KIND IT IS, AND CLEAR ITS OWNER.
  //
  // This is the dispatch where the two axes meet. Each of the five
  // derived kinds gets its OWN audited revoke -- the same symbol its
  // lineage cascade calls -- so revoking by owner produces exactly the
  // audit records revoking by lineage would, and an operator
  // reconciling a teardown sees one record per capability rather than
  // one per sweep.
  //
  // KIND_OP_REGION additionally gets its cascade run FIRST, because it
  // is the one transitive kind: a window derived from a window must not
  // outlive its parent. The cascade is an iterated fixed point, so
  // depth is handled without recursion.
  //
  // Anything else falls to the generic path: an audit record and three
  // zero stores. That path is honest about what it is -- it clears the
  // descriptor and nothing else. A FUTURE KIND WITH A TAIL TABLE MUST
  // BE ADDED TO THE DISPATCH ABOVE, or its row leaks: the descriptor
  // goes away and the row it named stays allocated, holding whatever
  // uniqueness key the row's allocator enforces. That is the ghost-row
  // failure gpio_line_cascade_revoke_by_controller's phase 2 exists to
  // clean up, and on a pad controller a ghost row holds a PIN that may
  // be the only way to bring a device out of reset.
  // ==========================================================================

  pub let cap_revoke_slot : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): revoke the capability at one slot by dispatching on its kind, then clear its owner column. Sequence: (1) slot < CAP_SLOT_MAX else CAP_OWNER_BAD_SLOT, with the owner column left alone -- an out-of-range slot names no column to clear. (2) read kind from cap_table + slot*24. (3) kind == 0 -> clear the owner and return CAP_OWNER_ALREADY, which is NOT an error: the ordinary way to reach it is a lineage cascade earlier in the same sweep having already cleared this descriptor, and the owner column must still be cleared so a later sweep does not re-count the slot. (4) dispatch: 0x150 KIND_OP_REGION runs opregion_cascade_revoke_by_parent(slot) BEFORE opregion_cap_revoke(slot), because it is the one transitive kind and its cascade is an iterated fixed point rather than recursion -- a leaf simply finds no children on pass 1; 0x152/0x153/0x154/0x155/0x156 each get their own audited revoke, which is the SAME symbol their lineage cascades call, so an owner sweep leaves the same audit trail a lineage teardown would; anything else takes the generic path, emitting DRV_AUDIT_EV_REVOKE with the real kind and then clearing the three descriptor words. (5) clear the owner column in ALL cases, including when the per-kind revoke refused, because the column records who HELD the slot and the holder is dead either way -- leaving it set would let a second sweep count the slot again and, worse, would leave a dead process's key on a slot that a later mint could reuse. The per-kind return code is propagated verbatim so an ALREADY or a WRONG_KIND stays nameable. Five pushes (rbx/r12/r13/r14/r15) leave rsp%16 == 0 at every nested call; rbx = descriptor base (recomputed after the calls, since the callees clobber it), r12 = slot, r13 = kind, r14 = outcome. Reserved labels: cap_own_rv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;                    // CAP_SLOT_MAX
        cmp r12, r10;
        jae cap_own_rv_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;                       // slot * 8
        mov r9, r12;
        shl r9, 4;                       // slot * 16
        add r8, r9;                      // slot * 24
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r13, [rbx + 0];              // kind
        cmp r13, 0;
        je  cap_own_rv_already;

        mov r10, 0x150;                  // KIND_OP_REGION
        cmp r13, r10;
        je  cap_own_rv_opregion;
        mov r10, 0x152;                  // KIND_I2C_BUS
        cmp r13, r10;
        je  cap_own_rv_i2c_bus;
        mov r10, 0x153;                  // KIND_I2C_SLAVE
        cmp r13, r10;
        je  cap_own_rv_i2c_slave;
        mov r10, 0x154;                  // KIND_GPIO_LINE
        cmp r13, r10;
        je  cap_own_rv_gpio_line;
        mov r10, 0x155;                  // KIND_FW_SESSION
        cmp r13, r10;
        je  cap_own_rv_fw_session;
        mov r10, 0x156;                  // KIND_EC_QUERY
        cmp r13, r10;
        je  cap_own_rv_ec_query;
        jmp cap_own_rv_generic;

        // -- KIND_OP_REGION: the one TRANSITIVE kind. The cascade runs
        //    first and is an iterated fixed point, so grandchildren are
        //    reached without recursion. Its return value is a COUNT, not
        //    a status, and is deliberately discarded.
      cap_own_rv_opregion:
        mov rdi, r12;
        call opregion_cascade_revoke_by_parent;
        mov rdi, r12;
        call opregion_cap_revoke;
        mov r14, rax;
        jmp cap_own_rv_unown;

        // -- KIND_I2C_BUS cascades to its slaves from inside its own
        //    body, one level, so no cascade call is needed here.
      cap_own_rv_i2c_bus:
        mov rdi, r12;
        call i2c_bus_cap_revoke;
        mov r14, rax;
        jmp cap_own_rv_unown;

      cap_own_rv_i2c_slave:
        mov rdi, r12;
        call i2c_slave_cap_revoke;
        mov r14, rax;
        jmp cap_own_rv_unown;

      cap_own_rv_gpio_line:
        mov rdi, r12;
        call gpio_line_cap_revoke;
        mov r14, rax;
        jmp cap_own_rv_unown;

      cap_own_rv_fw_session:
        mov rdi, r12;
        call fw_session_cap_revoke;
        mov r14, rax;
        jmp cap_own_rv_unown;

        // -- KIND_EC_QUERY has a tail table and no cascade: nothing in
        //    this tree derives from a subscription, so one audited
        //    revoke frees the row and clears the descriptor. It is here
        //    for the reason the comment above the dispatch gives -- a
        //    tail-table kind left off this list leaks its row, and on
        //    this kind the leaked row holds an endpoint identity and a
        //    controller address, which is a recorded permission to be
        //    told what a machine's battery and thermal sensors are
        //    doing outliving the process that was granted it.
      cap_own_rv_ec_query:
        mov rdi, r12;
        call ec_query_cap_revoke;
        mov r14, rax;
        jmp cap_own_rv_unown;

        // -- Generic: a kind with no tail table of its own. Record the
        //    revocation with the REAL kind so the audit ring says what
        //    was taken, then clear the descriptor.
      cap_own_rv_generic:
        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, r13;                    // the real kind
        mov rdx, r12;                    // subject   = slot
        mov rcx, r12;                    // principal = slot
        xor r8, r8;                      // outcome   = 0
        call drv_audit_emit;

        // Recompute the descriptor base: drv_audit_emit's clobbers are
        // unconstrained and rbx is the only register we parked it in.
        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        xor rax, rax;
        mov [rbx + 0],  rax;
        mov [rbx + 8],  rax;
        mov [rbx + 16], rax;
        xor r14, r14;                    // CAP_OWNER_OK
        jmp cap_own_rv_unown;

      cap_own_rv_already:
        mov r14, 0xFFFFFE2B;             // CAP_OWNER_ALREADY

        // -- The owner column is cleared on EVERY path that got as far
        //    as a valid slot, including a refused per-kind revoke. The
        //    column records who HELD the slot; the holder is dead
        //    either way.
      cap_own_rv_unown:
        mov rdi, r12;
        call cap_owner_clear;
        mov rax, r14;
        jmp cap_own_rv_out;

      cap_own_rv_bad_slot:
        mov rax, 0xFFFFFE2F;             // CAP_OWNER_BAD_SLOT

      cap_own_rv_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_owner_sweep_revoke(pid, gen) -> count
  //
  // "REVOKE EVERYTHING THE DEAD PROCESS HELD."
  //
  // The count is THE NUMBER OF SLOTS WHOSE OWNER COLUMN MATCHED, not
  // the number of successful revokes, and that choice makes the answer
  // order-independent. If the sweep revokes a bus at slot 40 and that
  // bus's lineage cascade clears a slave at slot 41 that the same
  // process also held, slot 41 is still counted when the scan reaches
  // it -- the slot WAS held by the dead process, which is the question
  // being answered. The second visit returns CAP_OWNER_ALREADY, which
  // is not an error and is not reported as one.
  //
  // THE UP-FRONT REFUSALS ARE THE SENTINEL DEFENCE. cap_owner_pack
  // answering CAP_OWNER_NONE ends the call before a single slot is
  // read, and it answers that for pid 0, for pid >= 64 and for a
  // zero generation. So:
  //
  //   * CAP_OWNER_NONE slots (unowned, .bss zero) cannot be swept,
  //     because a valid key is never 0.
  //   * CAP_OWNER_KERNEL slots cannot be swept, because their pid field
  //     is 0xFFFF and 0xFFFF >= 64 is outside the domain -- the kernel's
  //     own capabilities are not merely unmatched, they are UNASKABLE.
  //
  // Two independent guarantees for one property, deliberately: a sweep
  // that misses slots is worse than no sweep, because it reports that
  // authority was revoked when it was not.
  // ==========================================================================

  pub let cap_owner_sweep_revoke : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (pid: u64) (gen: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M1-1587 (#1587): revoke every capability whose owner column matches (pid, generation), and answer how many slots that was. Sequence: (1) key = cap_owner_pack(pid, gen); CAP_OWNER_NONE ends the call with a count of 0 BEFORE any slot is read -- this single gate is what makes both sentinels unsweepable, since a valid key is never 0 (so no unowned slot matches) and never carries a pid field >= 64 (so CAP_OWNER_KERNEL, whose pid field is 0xFFFF, is outside the domain rather than merely unmatched). (2) linear scan of cap_owner[0..256): an exact u64 equality against the key, not a pid-only compare, so a recycled pid at a new generation matches nothing. (3) each match is counted and passed to cap_revoke_slot, which dispatches to the kind's own audited revoke -- running the LINEAGE cascade beneath the OWNER sweep -- and clears the column. The count is slots MATCHED rather than revokes that returned OK, which makes it order-independent: a slot already cleared by a lineage cascade earlier in this same sweep is still a slot the dead process held. (4) one summary audit record, emitted ONLY when count > 0. The guard is not an optimisation: driver_death_notify calls this on EVERY process death, so an unconditional emit would put a record in the ring for every shell command that exits, drowning the driver events the ring exists to carry. Registers: rbx = key, r12 = cursor, r13 = count, r14 = pid (for the audit record); five pushes leave rsp%16 == 0 at every nested call, and all four are callee-save because cap_revoke_slot's clobbers are otherwise unconstrained. Reserved labels: cap_own_sw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r14, rdi;                    // pid, kept for the audit record

        call cap_owner_pack;             // rdi = pid, rsi = gen already
        mov rbx, rax;                    // key
        xor r13, r13;                    // count
        cmp rbx, 0;
        je  cap_own_sw_done;             // refused: nothing is sweepable

        xor r12, r12;                    // cursor

      cap_own_sw_scan:
        mov r10, 256;                    // CAP_SLOT_MAX
        cmp r12, r10;
        jae cap_own_sw_audit;

        lea rax, [rip + cap_owner];
        mov r10, [rax + r12*8];
        cmp r10, rbx;
        jne cap_own_sw_next;

        add r13, 1;
        mov rdi, r12;
        call cap_revoke_slot;

      cap_own_sw_next:
        add r12, 1;
        jmp cap_own_sw_scan;

        // One record per DEATH, not per slot: the per-kind revokes have
        // already left one record each. Suppressed at zero so an
        // ordinary process exit -- which is every exit in every shell
        // smoke mode -- does not perturb the ring.
      cap_own_sw_audit:
        cmp r13, 0;
        je  cap_own_sw_done;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        xor rsi, rsi;                    // kind = 0: a sweep, not a kind
        mov rdx, r13;                    // subject   = slots revoked
        mov rcx, r14;                    // principal = the dead pid
        mov r8,  2;                      // outcome 2 = owning process died
        call drv_audit_emit;

      cap_own_sw_done:
        mov rax, r13;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
