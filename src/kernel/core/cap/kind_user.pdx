// src/kernel/core/cap/kind_user.pdx -- R48.M1-001..004 (#1517-#1520)
//
// KIND_USER = 0x190, derived over KIND_HW (slot 14).
//
// The runtime witness for ONE user identity: a public-key fingerprint
// (SHA3-256 of an ML-DSA-65 user_pk, 32 bytes), a quota_bytes ceiling,
// a created_ns timestamp, and (for a non-founder) the fingerprint of
// the parent user who signed this account's delegation.
//
// A user in PaideiaOS is not a uid/gid integer (design/user/model.md
// §1); the KIND_USER capability is the ROOT of every per-file /
// per-network / per-device capability the user's session will hold.
// Revoking KIND_USER cascades: every downstream user this cap
// delegated is dead in the same operation. The cascade lives entirely
// in this module and is the load-bearing property #1520 pins.
//
// =============================================================================
// SECTION 0  WHY KIND_USER DERIVES OVER KIND_HW
// =============================================================================
//
// The user model is a userspace concept enforced by capability holds
// (§3.3): "founder is not magic; the kernel does not special-case any
// syscall". So the cap's kernel-side authority is the authority to
// hold + delegate + revoke ONE identity, not a per-syscall bit.
//
// Slot 14 (KIND_HW) is chosen as the base because:
//   * the founder mint (§3.2) is the same transaction that hands the
//     first user the KIND_HW root cap sheltering every downstream
//     hardware kind, so the two authorities travel together;
//   * KIND_USER is a leaf of the AUTHORITY tree from the kernel's
//     perspective -- the kernel does not derive further kinds from a
//     user cap (userspace does that via KIND_PDXFS / KIND_NETWORK
//     subtree mints, one KIND_ per axis, each of which derives from
//     its own base kind rather than from KIND_USER);
//   * no other derived family occupies the (KIND_HW, identity)
//     coordinate today.
//
// The mint gate demands `parent.kind == KIND_HW (14)` carrying
// RIGHT_MINT.  A wide-open KIND_HW is exactly what founder holds by
// design, and no ordinary user should hold KIND_HW with RIGHT_MINT --
// so the mint gate's second half naturally restricts KIND_USER minting
// to founder + supervisor.
//
// =============================================================================
// SECTION 1  TAIL ENCODING (#1518)
// =============================================================================
//
// Per design/user/model.md §9.1 the on-disk user record carries the
// 32-byte pk_fingerprint verbatim.  In-kernel we mirror that: the row
// stores all four u64 words of the fingerprint, plus quota_bytes,
// created_ns, and the parent's fingerprint word 0 as the "delegated_by
// key" (0 for founder).
//
// Storing only the parent's fp word 0 as the delegation edge -- rather
// than the full 32-byte parent fingerprint -- keeps a row at 64 bytes
// (eight u64) and matches the uniqueness key we use elsewhere in this
// file (`user_key = pk_fingerprint word 0`). The birthday bound for
// USER_MAX = 16 rows against a 64-bit key is trivially safe.
//
//   [+0]   header: in_use[63:56] | parent_slot[15:8]
//   [+8]   user_key = pk_fingerprint word 0 (uniqueness key)
//   [+16]  pk_fingerprint word 1
//   [+24]  pk_fingerprint word 2
//   [+32]  pk_fingerprint word 3
//   [+40]  quota_bytes (u64)
//   [+48]  created_ns  (u64)
//   [+56]  delegated_by_key (u64) -- parent user_key, or 0 for founder
//
// FOUR REFUSALS AT MINT: user_key == 0 (fingerprint zero is not a
// legal ML-DSA-65 hash), user_key already live (one row per identity),
// quota_bytes > USER_QUOTA_MAX (arbitrary sanity ceiling, guards the
// arithmetic below), delegated_by_key != 0 but no live row holds it
// (a delegation must name a parent that exists in the same runtime).
//
// =============================================================================
// SECTION 2  CASCADE REVOCATION INVARIANT (#1520)
// =============================================================================
//
// user_cap_revoke_cascade(row_id) walks _user_table.  For every live
// row R with R.delegated_by_key == this_row.user_key, it calls itself
// recursively on R.row_id, then frees this_row.  The scan is O(N^2)
// worst-case over USER_MAX = 16 rows; N is a compile-time constant so
// no bound is caller-supplied.
//
// The invariant the witness (tests/kernel/cap/user_synth.pdx) pins is:
//
//   after mint(founder), mint(alice, delegated_by=founder),
//         mint(alice_work, delegated_by=alice),
//         revoke_cascade(founder_row):
//     user_tail_valid(founder_row) == 0
//     user_tail_valid(alice_row) == 0
//     user_tail_valid(alice_work_row) == 0
//
// Two derivations deep is enough to distinguish "recursive walk"
// from "flat-scan revoke my direct children only", which is the one
// mistake a first implementation would make and the one this witness
// exists to refuse.
//
// =============================================================================
// SECTION 3  RIGHTS
// =============================================================================
//
// R_USER_READ    (0x001) -- read the row's static identity fields
// R_USER_INVOKE  (0x008) -- query ops (fingerprint word, quota, ...)
// R_USER_REVOKE  (0x010) -- revoke this user + cascade
// R_USER_MINT    (0x200) -- delegate a sub-user under this identity
// R_USER_OBSERVE (0x400) -- debug print
// R_USER_ALL     (0x619)
//
// R_USER_MINT is present: alice may create alice_work as a sub-user
// under herself (§4.3), which is the whole reason cascade revocation
// is a required kernel-side property rather than a userspace one.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFED30..0xFFFFED3F
// =============================================================================
//
// Sixteen wide, disjoint from every previous kind's band.

module KindUser = structure {

  pub let KIND_USER      : u64 = 0x190
  pub let USER_PARENT    : u64 = 14        // = KIND_HW

  pub let R_USER_READ    : u64 = 0x001
  pub let R_USER_INVOKE  : u64 = 0x008
  pub let R_USER_REVOKE  : u64 = 0x010
  pub let R_USER_MINT    : u64 = 0x200
  pub let R_USER_OBSERVE : u64 = 0x400
  pub let R_USER_ALL     : u64 = 0x619

  // Ops. Every op ARITY ONE -- op_arg high bits REFUSED.
  pub let USER_OP_QUERY_FP0    : u64 = 0
  pub let USER_OP_QUERY_FP1    : u64 = 1
  pub let USER_OP_QUERY_FP2    : u64 = 2
  pub let USER_OP_QUERY_FP3    : u64 = 3
  pub let USER_OP_QUERY_QUOTA  : u64 = 4
  pub let USER_OP_QUERY_TIME   : u64 = 5
  pub let USER_OP_QUERY_PARENT : u64 = 6
  pub let USER_OP_DEBUG_PRINT  : u64 = 7
  pub let USER_OP_MAX          : u64 = 7

  // Failure taxonomy. 0xFFFFED30..0xFFFFED3F, disjoint band.
  pub let USER_OK              : u64 = 0
  pub let USER_TAIL_ENOSPC     : u64 = 0xFFFFED3F
  pub let USER_TAIL_BAD_ARG    : u64 = 0xFFFFED3E
  pub let USER_MINT_BAD_PARENT : u64 = 0xFFFFED3D
  pub let USER_MINT_BAD_RIGHTS : u64 = 0xFFFFED3C
  pub let USER_MINT_NO_KEY     : u64 = 0xFFFFED3B
  pub let USER_MINT_KEY_INUSE  : u64 = 0xFFFFED3A
  pub let USER_MINT_BAD_QUOTA  : u64 = 0xFFFFED39
  pub let USER_MINT_NO_PARENT  : u64 = 0xFFFFED38  // delegated_by_key names no live row
  pub let USER_BAD_SLOT        : u64 = 0xFFFFED37
  pub let USER_WRONG_KIND      : u64 = 0xFFFFED36
  pub let USER_REVOKE_ALREADY  : u64 = 0xFFFFED35

  pub let USER_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let USER_ROW_NONE   : u64 = 0xFF

  // USER_QUOTA_MAX = 1 TiB. Arbitrary but high enough for any
  // plausible per-user home subtree in this generation of hardware, and
  // low enough that a bogus 0xFFFFFFFFFFFFFFFF value slipping through a
  // mint call is refused rather than accepted as "infinite quota".
  pub let USER_QUOTA_MAX : u64 = 0x10000000000  // 1 TiB in bytes

  pub let USER_MAX       : u64 = 16
  pub let USER_ROW_BYTES : u64 = 64

  // THE ONE STATE CELL. Confined by tools/build.sh.
  // 16 rows * 64 bytes = 1024 bytes = 128 u64.
  pub let mut _user_table : [u64; 128] = uninit @align(64)
  pub let mut _user_stats : [u64; 8]   = uninit @align(64)

  pub let USER_ST_MINTS      : u64 = 0
  pub let USER_ST_REVOKES    : u64 = 1
  pub let USER_ST_CASCADES   : u64 = 2  // count of cascaded child frees
  pub let USER_ST_REFUSED    : u64 = 3
  pub let USER_ST_QUERIES    : u64 = 4
  pub let USER_ST_MAX        : u64 = 8

  pub let user_dbg_msg : [u8; 10] = "USER ROW\n\0"

  // ==========================================================================
  // user_table_reset() -> ()
  // ==========================================================================

  pub let user_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-001 (#1517): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring backlight/battery/thermal/cooling table_reset: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Labels prefixed user_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _user_table];
        xor rax, rax;
        xor rcx, rcx;
      user_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  user_rs_rows;

        lea r10, [rip + _user_stats];
        xor rcx, rcx;
      user_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  user_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // user_note(which) / user_stat(which)
  // ==========================================================================

  pub let user_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-001 (#1517): bounded increment on out-of-range no-op. Same shape as backlight_note. Labels prefixed user_nt_.",
      block: {
        cmp rdi, 8;
        jae user_nt_out;
        lea r10, [rip + _user_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      user_nt_out:
        ret
      }
    }

  pub let user_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-001 (#1517): bounded read; out-of-range returns 0. Labels prefixed user_st_.",
      block: {
        cmp rdi, 8;
        jae user_st_zero;
        lea r10, [rip + _user_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      user_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // user_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let user_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M1-002 (#1518): subset test against R_USER_ALL = 0x619. R_MINT PRESENT -- alice may delegate alice_work under herself (design/user/model.md §4.3). Labels prefixed user_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;                 // R_USER_ALL
        and rax, r10;
        cmp rax, rdi;
        jne user_rv_no;
        mov rax, 1;
        ret;
      user_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // user_quota_valid(q) -> 1 | 0
  // ==========================================================================

  pub let user_quota_valid : (u64) -> u64 !{} @{} =
    fn (q: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M1-002 (#1518): 1 iff q <= USER_QUOTA_MAX = 1 TiB. Zero is a legitimate answer (a user with quota 0 cannot mint any KIND_PDXFS write cap, which is exactly the semantics `pass expire alice` should reach); the ceiling refuses only nonsense values that would swallow a downstream sum. Labels prefixed user_qv_.",
      block: {
        // 1 TiB = 0x10000000000 requires staging through r11 because
        // the immediate is above 0x7FFFFFFF and not sign-extendable.
        mov r11, 0x10000000000;
        cmp rdi, r11;
        ja  user_qv_no;
        mov rax, 1;
        ret;
      user_qv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // user_check_parent_hw(parent_slot) -> 1 | 0
  //
  // §0. The first half of the KIND_USER derivation gate. Requires
  // parent.kind == KIND_HW (14) AND (rights & RIGHT_MINT 0x200) != 0.
  // ==========================================================================

  pub let user_check_parent_hw : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M1-003 (#1519): first half of the KIND_USER derivation gate. Bounds-check parent_slot < 256, load descriptor at cap_table + slot*24, require kind == KIND_HW (14) AND rights carry RIGHT_MINT (0x200). This is the shape every KIND_HW-parented derived kind uses (mirrors kind_hw_interrupt / kind_hw_msix_vector / kind_display_timeline's own gate), and it is what confines KIND_USER mint authority to founder + supervisor: only they hold KIND_HW with RIGHT_MINT under the design's founder-cap-bundle (design/user/model.md §3.2). Pure read. Labels prefixed user_cph_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae user_cph_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 14;                     // KIND_HW
        jne user_cph_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  user_cph_no;

        mov rax, 1;
        ret;

      user_cph_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // user_hdr_pack(parent_slot) -> hdr | USER_DECODE_BAD
  // ==========================================================================

  pub let user_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M1-002 (#1518): canonical header-word encoder. Validates parent_slot < 256 then packs (parent_slot << 8), leaving bits [7:0], [55:16] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero: a header arriving with in_use pre-set hands back a row the free scan skips forever, and on this kind the leaked row holds a user_key, so the next legitimate mint of that identity is refused KEY_INUSE by a ghost that is still the only record of the identity's quota. Labels prefixed user_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae user_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        ret;

      user_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // user_find_by_key(user_key) -> row_id | USER_ROW_NONE
  // ==========================================================================

  pub let user_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (user_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-002 (#1518): live row holding this user_key, or USER_ROW_NONE. Refuses user_key == 0 so the founder sentinel and a fabricated zero-fingerprint cannot alias. Linear scan over 16 rows. Labels prefixed user_fk_.",
      block: {
        cmp rdi, 0;
        je  user_fk_none;
        xor rcx, rcx;
      user_fk_scan:
        cmp rcx, 16;                     // USER_MAX
        jae user_fk_none;
        lea r10, [rip + _user_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  user_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  user_fk_hit;
      user_fk_next:
        add rcx, 1;
        jmp user_fk_scan;
      user_fk_hit:
        mov rax, rcx;
        ret;
      user_fk_none:
        mov rax, 0xFF;                   // USER_ROW_NONE
        ret
      }
    }

  // ==========================================================================
  // user_tail_alloc(hdr, user_key, quota_bytes, created_ns,
  //                 delegated_by_key)
  //   -> row_id | USER_TAIL_*
  //
  // Five arguments: exactly the identity fields the mint has to write.
  // pk_fingerprint words [1..3] are stored via user_row_set_fp_ext
  // AFTER the row is claimed; they are not part of the uniqueness key
  // and their delayed write cannot let a caller reach another user's
  // fingerprint, because the row's uniqueness is fixed at claim time
  // by user_key alone.
  // ==========================================================================

  pub let user_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (user_key: u64) (quota_bytes: u64) (created_ns: u64) (delegated_by_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-002 (#1518) + M1-003 (#1519): claim one KIND_USER row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A KIND_USER QUOTA, which is why tools/build.sh confines relocations against _user_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (allocator's in_use flag); hdr reserved bits [7:0] or [55:16] non-zero -> TAIL_BAD_ARG; user_key == 0 -> TAIL_BAD_ARG (0 is the founder sentinel for delegated_by_key and cannot be a legitimate fingerprint word 0); quota_bytes > USER_QUOTA_MAX -> TAIL_BAD_ARG (staged via user_quota_valid). Low-first scan over 16 rows of 64 bytes. Claim writes the six identity words and the fingerprint-extension words to zero (row_set_fp_ext fills those later); a reused row cannot inherit the previous user's fingerprint bytes. Five callee-save pushes leave rsp%16 == 0 at every nested call site (there are none in this leaf). Labels prefixed user_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // user_key
        mov r14, rdx;                    // quota_bytes
        mov r15, rcx;                    // created_ns
        mov rbp, r8;                     // delegated_by_key

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne user_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne user_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne user_ta_bad;

        // user_key non-zero.
        cmp r13, 0;
        je  user_ta_bad;

        // quota <= USER_QUOTA_MAX.
        mov r11, 0x10000000000;          // 1 TiB
        cmp r14, r11;
        ja  user_ta_bad;

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      user_ta_scan:
        cmp rbx, 16;                     // USER_MAX
        jae user_ta_enospc;

        lea r10, [rip + _user_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  user_ta_claim;

        add rbx, 1;
        jmp user_ta_scan;

      user_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // user_key
        xor rax, rax;
        mov [r10 + 16], rax;             // fp word 1 (filled later)
        mov [r10 + 24], rax;             // fp word 2
        mov [r10 + 32], rax;             // fp word 3
        mov [r10 + 40], r14;             // quota_bytes
        mov [r10 + 48], r15;             // created_ns
        mov [r10 + 56], rbp;             // delegated_by_key
        mov rax, rbx;
        jmp user_ta_out;

      user_ta_enospc:
        mov rax, 0xFFFFED3F;             // USER_TAIL_ENOSPC
        jmp user_ta_out;
      user_ta_bad:
        mov rax, 0xFFFFED3E;             // USER_TAIL_BAD_ARG

      user_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // user_row_set_fp_ext(row_id, fp1, fp2, fp3) -> USER_OK | USER_BAD_SLOT
  //
  // Writes pk_fingerprint words 1..3 (bytes 8..32) of a JUST-CLAIMED row.
  // The caller (mint walker) invokes this immediately after
  // user_tail_alloc so the row is not visible to any observer yet;
  // the ordering matters because user_fp_word(row, i) for i in {1,2,3}
  // reads whatever is at the offset unconditionally, and a live row
  // whose fingerprint extension had not been written would report
  // three all-zero fingerprint words.
  // ==========================================================================

  pub let user_row_set_fp_ext : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (fp1: u64) (fp2: u64) (fp3: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-002 (#1518): complete a just-claimed row's 32-byte pk_fingerprint by writing words 1..3. Bounds-checks row_id < USER_MAX and refuses a dead row (this cannot silently populate a scrubbed slot). Labels prefixed user_fpx_.",
      block: {
        cmp rdi, 16;                     // USER_MAX
        jae user_fpx_bad;
        lea r10, [rip + _user_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  user_fpx_bad;
        mov [r10 + 16], rsi;
        mov [r10 + 24], rdx;
        mov [r10 + 32], rcx;
        xor rax, rax;
        ret;
      user_fpx_bad:
        mov rax, 0xFFFFED37;             // USER_BAD_SLOT
        ret
      }
    }

  // ==========================================================================
  // user_tail_valid(row_id) -> 1 | 0
  // ==========================================================================

  pub let user_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-002 (#1518): 1 iff row_id < USER_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers USER_DECODE_BAD rather than the zeroes it was scrubbed to; a scrubbed row would present as a user with quota 0 and fingerprint zero, which the cascade walk uses as the founder sentinel -- collapsing 'a dead row' onto 'founder' would let a revoke propagate the wrong way. Labels prefixed user_tv_.",
      block: {
        cmp rdi, 16;                     // USER_MAX
        jae user_tv_no;
        lea r10, [rip + _user_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  user_tv_no;
        mov rax, 1;
        ret;
      user_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // user_tail_free(row_id) -> ()
  // ==========================================================================

  pub let user_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-003 (#1519): scrub one KIND_USER row to zero, which clears in_use, the user_key, the fingerprint words, quota, created_ns and the parent edge. ALL EIGHT WORDS: a revoke is the point at which the operator has decided this user's authority no longer applies, and a row that kept its user_key across a re-mint would let user_find_by_key hit a ghost and refuse the legitimate re-provisioning of the same identity. Similarly a row that kept its delegated_by_key would let the NEXT revoke_cascade of the old parent walk into a scrubbed slot and free it a second time. No-op on an out-of-range row. Labels prefixed user_tf_.",
      block: {
        cmp rdi, 16;                     // USER_MAX
        jae user_tf_out;
        lea r10, [rip + _user_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      user_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Every one returns USER_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let user_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-002 (#1518): user_key (fp word 0), or USER_DECODE_BAD. Labels prefixed user_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call user_tail_valid;
        cmp rax, 0;
        je  user_rk_bad;
        lea r10, [rip + _user_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp user_rk_out;
      user_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      user_rk_out:
        pop r12;
        ret
      }
    }

