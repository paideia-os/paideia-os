  pub let user_row_quota : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-002 (#1518): quota_bytes, or USER_DECODE_BAD. Read-only; only user_tail_alloc writes it, so 'the quota changed at runtime' is unrepresentable at this layer. A quota RAISE that founder wants to grant is expressed as revoke + re-mint through the walker, which is the audit-visible path the model requires (§7.1). Labels prefixed user_rq_.",
      block: {
        push r12;
        mov r12, rdi;
        call user_tail_valid;
        cmp rax, 0;
        je  user_rq_bad;
        lea r10, [rip + _user_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        jmp user_rq_out;
      user_rq_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
