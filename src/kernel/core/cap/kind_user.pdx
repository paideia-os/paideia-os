    }

  // ==========================================================================
  // user_row_of_slot(slot) -> row_id | USER_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let user_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M1-003 (#1519): slot -> row_id, gated on the descriptor being a live KIND_USER. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A USER ROW. Returns USER_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Kind constant 0x190 is staged in r11 because it does not sign-extend from a 32-bit immediate. Labels prefixed user_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae user_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x190;                  // KIND_USER
        cmp r10, r11;
        jne user_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call user_tail_valid;
        cmp rax, 0;
        je  user_ros_none;

        mov rax, r12;
        jmp user_ros_out;

      user_ros_none:
        mov rax, 0xFF;                   // USER_ROW_NONE
      user_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // user_cap_revoke_cascade(row_id) -> USER_OK | USER_BAD_SLOT
  //
  // §2. THE CASCADE. Walks _user_table in ascending row order; for
  // every live descendant R whose delegated_by_key matches THIS row's
  // user_key, recurses into R first, then frees THIS row.
  //
  // Depth-first, ascending scan: the recursion depth is bounded by the
  // longest chain of user_key -> delegated_by_key edges, which is
  // bounded by USER_MAX = 16 because a cycle would require a mint that
  // named itself as its own parent and user_tail_alloc refuses
  // user_key == delegated_by_key (delegated_by_key must be a DIFFERENT
  // live row's key, enforced by user_cap_mint_inner not here). At
  // USER_MAX = 16 the total stack use is ~16 * (5 callee-save + 1
  // return address) * 8 = 1024 bytes, comfortable within the kernel's
  // per-CPU stack.
  // ==========================================================================

  pub let user_cap_revoke_cascade : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-003 (#1519) + M1-004 (#1520): revoke ONE user row and every descendant. For each live row whose delegated_by_key equals this row's user_key, recurse into it, then free this row. THE ONE CASCADE PATH: alice revoked walks alice_work in the same operation, no scavenger left behind. If a first implementation forgets the recursion and frees direct children only, #1520's witness with a two-deep chain refuses to go green -- which is why the chain the witness builds is founder -> alice -> alice_work rather than founder -> alice alone. Refuses an out-of-range or already-dead row with USER_BAD_SLOT (idempotent-on-dead is a documented property of cascade endpoints: the walker in the middle of a large revoke MUST tolerate a child already freed by an inner recursion). Counters: USER_ST_REVOKES bumps once per top-level call; USER_ST_CASCADES bumps once per recursed descendant. Six callee-save pushes + `sub rsp, 8` = 56 bytes: post-prologue rsp % 16 == 0 so nested calls (user_tail_valid / user_cap_revoke_cascade recursion / user_note / user_tail_free) meet the SysV boundary. Labels prefixed user_cas_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // row_id

        // Bounds + liveness gate.
        mov rdi, r12;
        call user_tail_valid;
        cmp rax, 0;
        je  user_cas_bad;

        // Load THIS row's user_key -> r13.
        lea r10, [rip + _user_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov r13, [r10 + 8];              // user_key

        // Scan for descendants. rbx = candidate row_id.
        xor rbx, rbx;
      user_cas_scan:
        cmp rbx, 16;                     // USER_MAX
        jae user_cas_free_self;

        // Skip self.
        cmp rbx, r12;
        je  user_cas_next;

        lea r10, [rip + _user_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        // Skip dead rows.
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  user_cas_next;

        // R.delegated_by_key == this.user_key?
        mov rax, [r10 + 56];
        cmp rax, r13;
        jne user_cas_next;

        // Recurse into the descendant.
        mov rdi, rbx;
        call user_cap_revoke_cascade;
        // Count the cascaded free (USER_ST_CASCADES = 2).
        mov rdi, 2;
        call user_note;

      user_cas_next:
        add rbx, 1;
        jmp user_cas_scan;

      user_cas_free_self:
        // Every descendant chain has been reaped. Free this row.
        mov rdi, r12;
        call user_tail_free;
        // Count the top-level revoke (USER_ST_REVOKES = 1). This bumps
        // ONCE PER CALL, so a cascade of depth 3 produces:
        //   3 * USER_ST_REVOKES + 2 * USER_ST_CASCADES
        // because the two inner calls also come through user_cas_
        // free_self. That IS the intent -- REVOKES counts every row
        // freed by the cascade walk in total, CASCADES counts every
        // freed row that had a parent that also got freed.
        mov rdi, 1;
        call user_note;
        xor rax, rax;                    // USER_OK
        jmp user_cas_out;

      user_cas_bad:
        mov rax, 0xFFFFED37;             // USER_BAD_SLOT

      user_cas_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // user_cap_mint_inner(parent_slot, rights, user_key, quota_bytes,
  //                     created_ns, delegated_by_key)
  //   -> row_id | USER_MINT_*
  //
  // The KIND_USER mint walker (#1519). Runs the two-half derivation
  // gate: kind == KIND_HW + RIGHT_MINT (user_check_parent_hw), then
  // the identity refusals (rights subset, key non-zero and unused,
  // quota bound, delegated_by must name a live row if non-zero).
  //
  // On success, returns the row_id the caller writes into the fresh
  // descriptor as target_ptr[15:0]. Caller MAY additionally call
  // user_row_set_fp_ext to complete pk_fingerprint words 1..3.
  // ==========================================================================

  pub let user_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (user_key: u64) (quota_bytes: u64) (created_ns: u64) (delegated_by_key: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M1-003 (#1519): the KIND_USER mint walker. Six args are the maximum SysV registers carry, so the caller must sequence: cap_mint_alloc a slot, then call this to obtain a row_id, then cap_mint_write the descriptor with kind=0x190 target_ptr=row_id, then user_row_set_fp_ext to complete the 32-byte pk_fingerprint. Gates, in order: (1) user_check_parent_hw refuses a parent that is not KIND_HW carrying RIGHT_MINT -> MINT_BAD_PARENT. (2) user_rights_valid refuses rights outside R_USER_ALL -> MINT_BAD_RIGHTS. (3) user_key == 0 -> MINT_NO_KEY (0 is the founder sentinel for delegated_by_key; a fingerprint that hashed to zero-word-0 would be a birthday-bound accident, refused rather than silently accepted). (4) user_find_by_key hits -> MINT_KEY_INUSE (one row per identity; the on-disk .pdxuser blacklist enforces the sibling rule across boots). (5) delegated_by_key != 0 but no live row holds it -> MINT_NO_PARENT (a delegation must name a parent this runtime knows; founder mints with delegated_by_key=0 and skips this check). (6) user_tail_alloc claims a row. On any refusal USER_ST_REFUSED (3) bumps for post-hoc diagnosis. Six callee-save pushes + `sub rsp, 8` = 56 bytes: 56 mod 16 = 8, so post-prologue rsp % 16 == 0 (entry rsp % 16 == 8 by SysV, minus 56 = 8-8 = 0). Labels prefixed user_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // user_key
        mov r14, rcx;                    // quota_bytes
        mov r15, r8;                     // created_ns
        mov rbp, r9;                     // delegated_by_key

        // (1) Parent gate.
        mov rdi, r12;
        call user_check_parent_hw;
        cmp rax, 0;
        je  user_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call user_rights_valid;
        cmp rax, 0;
        je  user_mi_bad_rights;

        // (3) user_key non-zero.
        cmp rbx, 0;
        je  user_mi_no_key;

        // (4) Uniqueness.
        mov rdi, rbx;
        call user_find_by_key;
        cmp rax, 0xFF;                   // USER_ROW_NONE
        jne user_mi_inuse;

        // (5) Parent existence (skip if founder).
        cmp rbp, 0;
        je  user_mi_alloc;
        mov rdi, rbp;
        call user_find_by_key;
        cmp rax, 0xFF;
        je  user_mi_no_parent;

      user_mi_alloc:
        // (6) Pack header + claim.
        mov rdi, r12;
        call user_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  user_mi_bad_rights;          // hdr encoder refusal maps to bad-rights bucket
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // user_key
        mov rdx, r14;                    // quota_bytes
        mov rcx, r15;                    // created_ns
        mov r8,  rbp;                    // delegated_by_key
        call user_tail_alloc;
        // tail_alloc returns row_id in [0, USER_MAX) on success, an
        // error code 0xFFFFED3x on failure. The refused counter path
        // owns the failure bucket so ENOSPC / BAD_ARG are diagnosable.
        mov r10, 16;                     // USER_MAX
        cmp rax, r10;
        jae user_mi_alloc_fail;
        // Success -- row_id in rax. Bump MINTS and return.
        push rax;
        mov rdi, 0;                      // USER_ST_MINTS
        call user_note;
        pop rax;
        jmp user_mi_out;
      user_mi_alloc_fail:
        // Preserve the tail_alloc error code (TAIL_ENOSPC / BAD_ARG)
        // as our return so the caller sees exactly which refusal fired.
        jmp user_mi_refused;

      user_mi_bad_parent:
        mov rax, 0xFFFFED3D;             // USER_MINT_BAD_PARENT
        jmp user_mi_refused;
      user_mi_bad_rights:
        mov rax, 0xFFFFED3C;             // USER_MINT_BAD_RIGHTS
        jmp user_mi_refused;
      user_mi_no_key:
        mov rax, 0xFFFFED3B;             // USER_MINT_NO_KEY
        jmp user_mi_refused;
      user_mi_inuse:
        mov rax, 0xFFFFED3A;             // USER_MINT_KEY_INUSE
        jmp user_mi_refused;
      user_mi_no_parent:
        mov rax, 0xFFFFED38;             // USER_MINT_NO_PARENT

      user_mi_refused:
        push rax;
        mov rdi, 3;                      // USER_ST_REFUSED
        call user_note;
        pop rax;

      user_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Slot-arity-one resolvers.
  // ==========================================================================

  pub let user_key_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M1-002 (#1518): user_key of the identity this capability names. ARITY ONE. Labels prefixed user_kos_.",
      block: {
        push r12;
        call user_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  user_kos_bad;
        mov rdi, r12;
        call user_row_key;
        jmp user_kos_out;
      user_kos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      user_kos_out:
        pop r12;
        ret
      }
    }

  pub let user_quota_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R48.M1-002 (#1518): quota_bytes of the identity this capability names. ARITY ONE for the same reason kind_backlight's max_of_slot is: a second argument would let a caller supply a quota to substitute or override. Labels prefixed user_qos_.",
      block: {
        push r12;
        call user_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  user_qos_bad;
        mov rdi, r12;
        call user_row_quota;
        jmp user_qos_out;
      user_qos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      user_qos_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_user(rights, target_ptr, op_arg) -> ...
  //
  // The KIND_USER dispatch handler. Wired into cap_invoke_dispatch on
  // `cmp rcx, 0x190; je call_kind_user`. Every QUERY op takes NO
  // OPERAND -- op_arg high bits refused with USER_TAIL_BAD_ARG.
  // ==========================================================================

  pub let cap_handler_user : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R48.M1-003 (#1519): KIND_USER dispatch. RIGHTS TESTED PER OP -- QUERY_* need R_USER_INVOKE (0x008); DEBUG_PRINT needs R_USER_OBSERVE (0x400). op_arg[63:8] MUST be zero -- a smuggled second value on an op that reaches a user's fingerprint / quota / parent edge is refused rather than masked, matching every other dispatch handler in this tree. Labels prefixed user_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id in low 16
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne user_hn_res;

        cmp rbp, 7;                      // USER_OP_MAX
        ja  user_hn_unsup;

        cmp rbp, 7;                      // DEBUG_PRINT?
        je  user_hn_dbg;

        // Query ops need R_USER_INVOKE.
        mov r10, r12;
        and r10, 0x008;                  // R_USER_INVOKE
        cmp r10, 0;
        je  user_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  user_hn_fp0;
        cmp rbp, 1;
        je  user_hn_fp1;
        cmp rbp, 2;
        je  user_hn_fp2;
        cmp rbp, 3;
        je  user_hn_fp3;
        cmp rbp, 4;
        je  user_hn_quota;
        cmp rbp, 5;
        je  user_hn_time;
        call user_row_parent_key;        // op == 6
        jmp user_hn_count;

      user_hn_fp0:
        call user_row_key;
        jmp user_hn_count;
      user_hn_fp1:
        call user_row_fp1;
        jmp user_hn_count;
      user_hn_fp2:
        call user_row_fp2;
        jmp user_hn_count;
      user_hn_fp3:
        call user_row_fp3;
        jmp user_hn_count;
      user_hn_quota:
        call user_row_quota;
        jmp user_hn_count;
      user_hn_time:
        call user_row_time;
        jmp user_hn_count;

      user_hn_count:
        push rax;
        mov rdi, 4;                      // USER_ST_QUERIES
        call user_note;
        pop rax;
        jmp user_hn_out;

      user_hn_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_USER_OBSERVE
        cmp r10, 0;
        je  user_hn_denied;
        xor rax, rax;
        jmp user_hn_out;

      user_hn_res:
        mov rax, 0xFFFFED3E;             // USER_TAIL_BAD_ARG
        jmp user_hn_out;
      user_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp user_hn_out;
      user_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      user_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
