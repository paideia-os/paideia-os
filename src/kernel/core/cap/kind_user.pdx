      block: {
        push r12;
        mov r12, rdi;
        call user_tail_valid;
        cmp rax, 0;
        je  user_rf1_bad;
        lea r10, [rip + _user_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp user_rf1_out;
      user_rf1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
