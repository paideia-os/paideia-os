  pub let user_row_parent_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M1-002 (#1518): delegated_by_key (parent user_key), or USER_DECODE_BAD. Zero for founder; any non-zero value must have named a live row at mint time. Labels prefixed user_rpk_.",
      block: {
        push r12;
        mov r12, rdi;
        call user_tail_valid;
        cmp rax, 0;
        je  user_rpk_bad;
        lea r10, [rip + _user_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 56];
        jmp user_rpk_out;
      user_rpk_bad:
