// src/kernel/core/cap/kind_font_atlas.pdx -- G5.M1-002 (#1492)
//
// KIND_FONT_ATLAS = 0x18B, derived over KIND_GPU_BO (0x174),
// whose runtime base is KIND_MEMORY (= KIND_PAGE, 4).
//
// One on-GPU font atlas texture, packed with SDF / MSDF / coverage
// glyph tiles. The atlas is the substrate the G5 shaper writes into
// and the G4 renderer samples from during a glyph draw pass; the
// capability is what a font-load server hands a compositor / IME /
// shell so it can name ONE atlas without being able to forge a
// second one over the same BO at a different format.
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// A hosted stack expresses "which atlas is this" as either a pointer
// or an integer chosen by the caller. The former lets any process
// with a pointer walk write into the atlas of any other, and the
// latter lets a bad caller collide against the id space of a good
// one. paideia expresses it as a CAP whose row records the atlas
// identity (atlas_key), the BO slot the atlas sits on, and the
// storage format the sampler must use. The mint gate refuses a
// second row that reuses either the atlas_key OR the BO slot, so
// two conflicting atlases over the same storage are unrepresentable.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_GPU_BO
// =============================================================================
//
// The kind half of the gate demands `kind == KIND_GPU_BO (0x174)`
// carrying RIGHT_MINT. The mint additionally requires:
//
//   (a) atlas_key non-zero and unique among live rows
//   (b) bo_slot < 256 (cap_table slot ceiling) and unique among
//       live rows -- no two atlases share storage
//   (c) atlas_width and atlas_height in [64, FONT_ATLAS_MAX_EXTENT]
//   (d) format in {FONT_FORMAT_SDF, MSDF, COVERAGE, COLR_BMP}
//   (e) glyphs_present in [0, FONT_ATLAS_MAX_GLYPHS]
//   (f) rights subset of R_FA_ALL (R_MINT PRESENT -- subset atlases
//       derive from a parent through font_load_channel.subset_atlas)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]  header: in_use[63:56] | parent_slot[15:8]
//   [+8]  atlas_key (u64)
//   [+16] body1: bo_slot[15:0] | atlas_width[31:16]
//              | atlas_height[47:32] | format[55:48]
//              | reserved[63:56]
//   [+24] body2: glyphs_present[15:0] | flags[63:16]
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEE20..0xFFFFEE2F
// =============================================================================

module KindFontAtlas = structure {

  pub let KIND_FONT_ATLAS   : u64 = 0x18B
  pub let FA_PARENT_KIND    : u64 = 0x174        // KIND_GPU_BO

  // Rights. R_MINT PRESENT -- subset atlases derive.
  pub let R_FA_READ    : u64 = 0x001
  pub let R_FA_INVOKE  : u64 = 0x008
  pub let R_FA_REVOKE  : u64 = 0x010
  pub let R_FA_MINT    : u64 = 0x200
  pub let R_FA_OBSERVE : u64 = 0x400
  pub let R_FA_ALL     : u64 = 0x619

  // Format ordinals. Kept small so the row's byte carries them
  // without escaping.
  pub let FONT_FORMAT_SDF      : u64 = 1
  pub let FONT_FORMAT_MSDF     : u64 = 2
  pub let FONT_FORMAT_COVERAGE : u64 = 3
  pub let FONT_FORMAT_COLR_BMP : u64 = 4
  pub let FONT_FORMAT_MAX      : u64 = 4

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED.
  pub let FA_OP_QUERY_KEY     : u64 = 0
  pub let FA_OP_QUERY_BO      : u64 = 1
  pub let FA_OP_QUERY_WIDTH   : u64 = 2
  pub let FA_OP_QUERY_HEIGHT  : u64 = 3
  pub let FA_OP_QUERY_FORMAT  : u64 = 4
  pub let FA_OP_QUERY_GLYPHS  : u64 = 5
  pub let FA_OP_DEBUG_PRINT   : u64 = 6
  pub let FA_OP_MAX           : u64 = 6

  // Failure taxonomy -- 0xFFFFEE20..0xFFFFEE2F.
  pub let FA_OK               : u64 = 0
  pub let FA_TAIL_ENOSPC      : u64 = 0xFFFFEE2F
  pub let FA_TAIL_BAD_ARG     : u64 = 0xFFFFEE2E
  pub let FA_MINT_BAD_PARENT  : u64 = 0xFFFFEE2D
  pub let FA_MINT_BAD_RIGHTS  : u64 = 0xFFFFEE2C
  pub let FA_MINT_BAD_BO      : u64 = 0xFFFFEE2B
  pub let FA_MINT_BAD_EXTENT  : u64 = 0xFFFFEE2A
  pub let FA_MINT_BAD_FORMAT  : u64 = 0xFFFFEE29
  pub let FA_MINT_BAD_GLYPHS  : u64 = 0xFFFFEE28
  pub let FA_MINT_NO_KEY      : u64 = 0xFFFFEE27
  pub let FA_MINT_ENOSPC      : u64 = 0xFFFFEE26
  pub let FA_MINT_KEY_IN_USE  : u64 = 0xFFFFEE25
  pub let FA_MINT_BO_IN_USE   : u64 = 0xFFFFEE24
  pub let FA_BAD_SLOT         : u64 = 0xFFFFEE23
  pub let FA_WRONG_KIND       : u64 = 0xFFFFEE22
  pub let FA_REVOKE_ALREADY   : u64 = 0xFFFFEE21

  pub let FA_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let FA_ROW_NONE   : u64 = 0xFF

  // Table sizing. 16 rows is enough for a normal font stack (regular
  // + bold + italic in each of 3-4 sizes) without letting a runaway
  // caller mint hundreds of atlases; a font-load server that needs
  // more evicts through revoke.
  pub let FA_MAX          : u64 = 16
  pub let FA_ROW_BYTES    : u64 = 32

  // Extent ceiling -- 4096 x 4096 is enough for the largest SDF
  // atlas that a typical typography stack fits (a single 4k atlas
  // holds ~1000 glyphs at 128 px). A hard ceiling stops a caller
  // asking for a 32k x 32k allocation that no BO could back.
  pub let FONT_ATLAS_MAX_EXTENT : u64 = 4096
  pub let FONT_ATLAS_MIN_EXTENT : u64 = 64
  pub let FONT_ATLAS_MAX_GLYPHS : u64 = 4096

  // THE ONE STATE CELL. Confined by tools/build.sh.
  // 16 rows * 32 bytes = 512 bytes = 64 u64.
  pub let mut _font_atlas_table : [u64; 64] = uninit @align(64)
  pub let mut _font_atlas_stats : [u64; 4]  = uninit @align(64)

  pub let FA_ST_MINTS   : u64 = 0
  pub let FA_ST_REVOKES : u64 = 1
  pub let FA_ST_REFUSED : u64 = 2
  pub let FA_ST_QUERIES : u64 = 3

  pub let fa_dbg_msg : [u8; 16] = "FONT ATLAS ROW\0\0"

  pub let fa_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): clear row table + counters. Labels prefixed fa_rs_.",
      block: {
        lea r10, [rip + _font_atlas_table];
        xor rax, rax;
        xor rcx, rcx;
      fa_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  fa_rs_rows;

        lea r10, [rip + _font_atlas_stats];
        xor rcx, rcx;
      fa_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  fa_rs_stats;
        ret
      }
    }

  pub let fa_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): counter bump.",
      block: {
        cmp rdi, 4;
        jae fa_nt_out;
        lea r10, [rip + _font_atlas_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      fa_nt_out:
        ret
      }
    }

  pub let fa_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): counter read.",
      block: {
        cmp rdi, 4;
        jae fa_st_zero;
        lea r10, [rip + _font_atlas_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      fa_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let fa_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-002 (#1492): subset test against R_FA_ALL = 0x619.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne fa_rv_no;
        mov rax, 1;
        ret;
      fa_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let fa_format_valid : (u64) -> u64 !{} @{} =
    fn (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-002 (#1492): 1 iff fmt in [1, FONT_FORMAT_MAX=4]. 0 refused.",
      block: {
        cmp rdi, 0;
        je  fa_fv_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  fa_fv_no;
        mov rax, 1;
        ret;
      fa_fv_no:
        xor rax, rax;
        ret
      }
    }

  pub let fa_extent_valid : (u64, u64) -> u64 !{} @{} =
    fn (w: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-002 (#1492): 1 iff min <= w, h <= max.",
      block: {
        mov r10, 64;                        // FONT_ATLAS_MIN_EXTENT
        cmp rdi, r10;
        jb  fa_ev_no;
        mov r10, 4096;                      // FONT_ATLAS_MAX_EXTENT
        cmp rdi, r10;
        ja  fa_ev_no;
        mov r10, 64;
        cmp rsi, r10;
        jb  fa_ev_no;
        mov r10, 4096;
        cmp rsi, r10;
        ja  fa_ev_no;
        mov rax, 1;
        ret;
      fa_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let fa_glyphs_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-002 (#1492): 1 iff n <= FONT_ATLAS_MAX_GLYPHS.",
      block: {
        mov r10, 4096;                      // FONT_ATLAS_MAX_GLYPHS
        cmp rdi, r10;
        ja  fa_gv_no;
        mov rax, 1;
        ret;
      fa_gv_no:
        xor rax, rax;
        ret
      }
    }

  // Row body pack helpers. body1: bo_slot[15:0] |
  // atlas_width[31:16] | atlas_height[47:32] | format[55:48]
  // | reserved[63:56].
  pub let fa_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (bo: u64) (w: u64) (h: u64) (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-002 (#1492): body1 pack. Refuses out-of-range fields.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  fa_b1_bad;
        cmp rsi, r10;
        ja  fa_b1_bad;
        cmp rdx, r10;
        ja  fa_b1_bad;
        mov r10, 0xFF;
        cmp rcx, r10;
        ja  fa_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      fa_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: glyphs_present[15:0] | flags[63:16].
  pub let fa_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (glyphs: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-002 (#1492): body2 pack. Refuses out-of-range fields.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  fa_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;
        ret;
      fa_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // header: in_use[63:56] | parent_slot[15:8]. in_use is set at
  // claim time; parent_slot packed here.
  pub let fa_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-002 (#1492): pack header sans in_use bit.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae fa_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      fa_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // fa_tail_alloc(hdr, atlas_key, body1, body2) -> row_id | err.
  // THE ONE WRITER of _font_atlas_table.
  pub let fa_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (atlas_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): claim one FONT_ATLAS row. Refuses malformed args and enospc.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        // hdr's in_use bit must be zero (allocator sets it).
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne fa_ta_bad;
        cmp r13, 0;
        je  fa_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  fa_ta_bad;
        cmp r15, r10;
        je  fa_ta_bad;

        xor rbx, rbx;
      fa_ta_scan:
        cmp rbx, 16;                        // FA_MAX
        jae fa_ta_enospc;
        lea r10, [rip + _font_atlas_table];
        mov r11, rbx;
        imul r11, r11, 32;                  // 32-byte row stride
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fa_ta_claim;
        add rbx, 1;
        jmp fa_ta_scan;

      fa_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp fa_ta_out;

      fa_ta_enospc:
        mov rax, 0xFFFFEE2F;
        jmp fa_ta_out;
      fa_ta_bad:
        mov rax, 0xFFFFEE2E;

      fa_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fa_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): 1 iff row_id < FA_MAX and in_use.",
      block: {
        cmp rdi, 16;
        jae fa_tv_no;
        lea r10, [rip + _font_atlas_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fa_tv_no;
        mov rax, 1;
        ret;
      fa_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let fa_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): scrub one row.",
      block: {
        cmp rdi, 16;
        jae fa_tf_out;
        lea r10, [rip + _font_atlas_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      fa_tf_out:
        ret
      }
    }

  pub let fa_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): atlas_key.",
      block: {
        push r12;
        mov r12, rdi;
        call fa_tail_valid;
        cmp rax, 0;
        je  fa_rk_bad;
        lea r10, [rip + _font_atlas_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp fa_rk_out;
      fa_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fa_rk_out:
        pop r12;
        ret
      }
    }

  pub let fa_row_bo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): bo_slot at body1[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call fa_tail_valid;
        cmp rax, 0;
        je  fa_rb_bad;
        lea r10, [rip + _font_atlas_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp fa_rb_out;
      fa_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fa_rb_out:
        pop r12;
        ret
      }
    }

  pub let fa_row_width : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): atlas_width at body1[31:16].",
      block: {
        push r12;
        mov r12, rdi;
        call fa_tail_valid;
        cmp rax, 0;
        je  fa_rw_bad;
        lea r10, [rip + _font_atlas_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp fa_rw_out;
      fa_rw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fa_rw_out:
        pop r12;
        ret
      }
    }

  pub let fa_row_height : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): atlas_height at body1[47:32].",
      block: {
        push r12;
        mov r12, rdi;
        call fa_tail_valid;
        cmp rax, 0;
        je  fa_rh_bad;
        lea r10, [rip + _font_atlas_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
