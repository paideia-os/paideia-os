  pub let fa_row_format : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): format at body1[55:48].",
      block: {
        push r12;
        mov r12, rdi;
        call fa_tail_valid;
        cmp rax, 0;
        je  fa_rf_bad;
        lea r10, [rip + _font_atlas_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp fa_rf_out;
      fa_rf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fa_rf_out:
