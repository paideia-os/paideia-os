    }

  pub let fa_row_glyphs : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): glyphs_present at body2[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call fa_tail_valid;
        cmp rax, 0;
        je  fa_rg_bad;
        lea r10, [rip + _font_atlas_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFF;
        jmp fa_rg_out;
      fa_rg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fa_rg_out:
        pop r12;
        ret
      }
    }

  // fa_find_by_key(key) -> row_id | FA_ROW_NONE
  pub let fa_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): linear scan for atlas_key uniqueness.",
      block: {
        xor rcx, rcx;
      fa_fk_scan:
        cmp rcx, 16;
        jae fa_fk_none;
        lea r10, [rip + _font_atlas_table];
        mov r11, rcx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fa_fk_step;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  fa_fk_hit;
      fa_fk_step:
        add rcx, 1;
        jmp fa_fk_scan;
      fa_fk_hit:
        mov rax, rcx;
        ret;
      fa_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  // fa_find_by_bo(bo_slot) -> row_id | FA_ROW_NONE
  pub let fa_find_by_bo : (u64) -> u64 !{mem} @{} =
    fn (bo: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-002 (#1492): linear scan for bo_slot uniqueness -- two atlases cannot share storage.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        xor r13, r13;
      fa_fb_scan:
        cmp r13, 16;
        jae fa_fb_none;
        lea r10, [rip + _font_atlas_table];
        mov r11, r13;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fa_fb_step;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        cmp rax, r12;
        je  fa_fb_hit;
      fa_fb_step:
        add r13, 1;
        jmp fa_fb_scan;
      fa_fb_hit:
        mov rax, r13;
        jmp fa_fb_out;
      fa_fb_none:
        mov rax, 0xFF;
      fa_fb_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // fa_row_of_slot(cap_slot) -> row_id | FA_ROW_NONE.
  // Read the cap_table row at cap_slot, gate on kind == 0x18B, and
  // decode row_id from target_ptr[15:0].
  pub let fa_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M1-002 (#1492): resolve a cap_slot to a FONT_ATLAS row. Same shape as vks_row_of_slot.",
      block: {
        push r12;
        mov r11, 256;
        cmp rdi, r11;
        jae fa_ros_none;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x18B;
        cmp r10, r11;
        jne fa_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call fa_tail_valid;
        cmp rax, 0;
        je  fa_ros_none;
        mov rax, r12;
        jmp fa_ros_out;
      fa_ros_none:
        mov rax, 0xFF;
      fa_ros_out:
        pop r12;
        ret
      }
    }

  // Dispatcher. QUERY ops all take NO OPERAND -- op_arg[63:8] refused.
  pub let cap_handler_font_atlas : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G5.M1-002 (#1492): KIND_FONT_ATLAS dispatch. QUERY ops take NO OPERAND.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_font_atlas_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne fa_hn_res;

        cmp rbp, 6;
        ja  fa_hn_unsup;

        cmp rbp, 6;
        je  fa_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  fa_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  fa_hn_key;
        cmp rbp, 1;
        je  fa_hn_bo;
        cmp rbp, 2;
        je  fa_hn_w;
        cmp rbp, 3;
        je  fa_hn_h;
        cmp rbp, 4;
        je  fa_hn_fmt;
        call fa_row_glyphs;
        jmp fa_hn_out;

      fa_hn_key:
        call fa_row_key;
        jmp fa_hn_out;
      fa_hn_bo:
        call fa_row_bo;
        jmp fa_hn_out;
      fa_hn_w:
        call fa_row_width;
        jmp fa_hn_out;
      fa_hn_h:
        call fa_row_height;
        jmp fa_hn_out;
      fa_hn_fmt:
        call fa_row_format;
        jmp fa_hn_out;

      fa_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  fa_hn_denied;
        xor rax, rax;
        jmp fa_hn_out;

      fa_hn_res:
        mov rax, 0xFFFFEE2E;
        jmp fa_hn_out;
      fa_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp fa_hn_out;
      fa_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      fa_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
