// src/kernel/core/cap/kind_bt_l2cap_channel.pdx — R39.M2-003 (#1329)
//
// KIND_BT_L2CAP_CHANNEL = 0x184, derived over KIND_IPC_ENDPOINT (5).
//
// One live L2CAP (Logical Link Control and Adaptation Protocol) channel:
// a chan_key naming the channel, the KIND_IPC_ENDPOINT the client drives
// packets over, the KIND_BT_HCI_CHANNEL slot the L2CAP frames ride,
// the CID (channel identifier per BT §3.2), the PSM (Protocol/Service
// Multiplexer per BT §4.2), the MTU (Maximum Transmission Unit), and the
// current LE CBFC credit count (per BT §3.4).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// L2CAP is the segmentation-and-reassembly layer above HCI ACL (BT §3).
// It multiplexes CIDs onto ACL handles: fixed CIDs 0x0001..0x0006 carry
// signalling, ATT, LE signalling, and SM traffic; dynamic CIDs 0x0040+
// carry connection-oriented flows negotiated through the LE CBFC
// mechanism.  A KIND_BT_L2CAP_CHANNEL row binds one CID to one HCI
// transport channel and freezes its PSM / MTU / credit configuration --
// a subscriber that carries authority to WRITE on cid=0x0040 must not
// also be able to WRITE on cid=0x0041 (a different profile, possibly a
// different security stance).  The kind discriminates that: every
// identity field except `credits` is frozen at mint; the credits column
// is the ONE mutable field, advanced only through row-transition
// helpers exposed to l2cap_dyn.pdx.
//
// The KIND_IPC_ENDPOINT parent is the endpoint the L2CAP channel
// accepts payloads on.  Like every KIND_IPC_ENDPOINT-derived kind in
// this tree (KIND_WIFI_VIF, KIND_GPU_SUBMIT, KIND_MODESET_TXN,
// KIND_BT_HCI_CHANNEL, KIND_BT_GATT_CONNECTION, ...), the parent kind
// alone discriminates NOTHING; the mint gates below cover the rest.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// A mint additionally requires:
//
//   (a) chan_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (this is the parent_slot itself)
//   (c) hci_chan_slot names a live KIND_BT_HCI_CHANNEL (BAD_HCI)
//   (d) cid non-zero and <= 0xFFFF (BAD_CID)
//   (e) mtu >= 23 (BT LE minimum ATT MTU) and <= 0xFFFF (BAD_MTU)
//   (f) rights subset of R_KBL2C_ALL (R_MINT ABSENT from the mask)
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  chan_key    (u64)
//   [+16] body1:   endpoint_slot[31:0] | hci_chan_slot[63:32]
//   [+24] body2:   cid[15:0] | psm[31:16] | mtu[47:32] | credits[63:48]
//
// Every field EXCEPT credits is set once at mint.  credits advances
// through kbl2c_row_credit_add / kbl2c_row_credit_consume (called only
// by l2cap_dyn's FLOW_CONTROL_CREDIT_IND and send paths); revoke
// scrubs the entire row.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF100..0xFFFFF10F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: bt_hci_channel schema
// 0xFFFFF110..1F; adjacent free band below: l2cap_fixed 0xFFFFF0F0..FF).

module KindBtL2capChannel = structure {

  pub let KIND_BT_L2CAP_CHANNEL : u64 = 0x184
  pub let KBL2C_PARENT_KIND     : u64 = 5           // = KIND_IPC_ENDPOINT

  // Rights.  R_MINT (0x200) NOT in the mask.
  pub let R_KBL2C_READ    : u64 = 0x001
  pub let R_KBL2C_WRITE   : u64 = 0x002
  pub let R_KBL2C_INVOKE  : u64 = 0x008
  pub let R_KBL2C_REVOKE  : u64 = 0x010
  pub let R_KBL2C_OBSERVE : u64 = 0x400
  pub let R_KBL2C_ALL     : u64 = 0x41B

  // Ops.  Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KBL2C_OP_QUERY_KEY       : u64 = 0
  pub let KBL2C_OP_QUERY_ENDPOINT  : u64 = 1
  pub let KBL2C_OP_QUERY_HCI_CHAN  : u64 = 2
  pub let KBL2C_OP_QUERY_CID       : u64 = 3
  pub let KBL2C_OP_QUERY_PSM       : u64 = 4
  pub let KBL2C_OP_QUERY_MTU       : u64 = 5
  pub let KBL2C_OP_QUERY_CREDITS   : u64 = 6
  pub let KBL2C_OP_DEBUG_PRINT     : u64 = 7
  pub let KBL2C_OP_MAX             : u64 = 7

  // MTU bounds.  BT §3.2.2 fixes the minimum ATT MTU at 23 for LE.
  pub let KBL2C_MTU_MIN : u64 = 23

  // Failure taxonomy -- 0xFFFFF100..0xFFFFF10F.
  pub let KBL2C_OK                 : u64 = 0
  pub let KBL2C_TAIL_ENOSPC        : u64 = 0xFFFFF10F
  pub let KBL2C_TAIL_BAD_ARG       : u64 = 0xFFFFF10E
  pub let KBL2C_MINT_BAD_PARENT    : u64 = 0xFFFFF10D
  pub let KBL2C_MINT_BAD_RIGHTS    : u64 = 0xFFFFF10C
  pub let KBL2C_MINT_BAD_HCI       : u64 = 0xFFFFF10B
  pub let KBL2C_MINT_BAD_CID       : u64 = 0xFFFFF10A
  pub let KBL2C_MINT_BAD_MTU       : u64 = 0xFFFFF109
  pub let KBL2C_MINT_NO_KEY        : u64 = 0xFFFFF108
  pub let KBL2C_MINT_ENOSPC        : u64 = 0xFFFFF107
  pub let KBL2C_MINT_IN_USE        : u64 = 0xFFFFF106
  pub let KBL2C_BAD_SLOT           : u64 = 0xFFFFF105
  pub let KBL2C_WRONG_KIND         : u64 = 0xFFFFF104
  pub let KBL2C_REVOKE_ALREADY     : u64 = 0xFFFFF103
  pub let KBL2C_RESERVED_ZERO      : u64 = 0xFFFFF102
  pub let KBL2C_CREDIT_OVERFLOW    : u64 = 0xFFFFF101
  pub let KBL2C_CREDIT_UNDERFLOW   : u64 = 0xFFFFF100

  pub let KBL2C_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KBL2C_ROW_NONE   : u64 = 0xFF

  pub let KBL2C_MAX       : u64 = 8
  pub let KBL2C_ROW_BYTES : u64 = 32

  pub let mut _bt_l2cap_chan_table : [u64; 32] = uninit @align(64)
  pub let mut _bt_l2cap_chan_stats : [u64; 4]  = uninit @align(64)

  pub let KBL2C_ST_MINTS    : u64 = 0
  pub let KBL2C_ST_REVOKES  : u64 = 1
  pub let KBL2C_ST_REFUSED  : u64 = 2
  pub let KBL2C_ST_CREDITS  : u64 = 3

  pub let kbl2c_dbg_msg : [u8; 20] = "BT L2CAP CHAN ROW\0\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bt_l2cap_chan_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): clear KIND_BT_L2CAP_CHANNEL row table + counters. Boot and teardown only. Labels prefixed kbl2c_rs_.",
      block: {
        lea r10, [rip + _bt_l2cap_chan_table];
        xor rax, rax;
        xor rcx, rcx;
      kbl2c_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kbl2c_rs_rows;

        lea r10, [rip + _bt_l2cap_chan_stats];
        xor rcx, rcx;
      kbl2c_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kbl2c_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kbl2c_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-003 (#1329): subset test against R_KBL2C_ALL = 0x41B. R_MINT (0x200) OUTSIDE the mask. Labels prefixed kbl2c_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne kbl2c_rv_no;
        mov rax, 1;
        ret;
      kbl2c_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kbl2c_cid_valid : (u64) -> u64 !{} @{} =
    fn (cid: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-003 (#1329): 1 iff cid non-zero and fits 16 bits. Labels prefixed kbl2c_cv_.",
      block: {
        cmp rdi, 0;
        je  kbl2c_cv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  kbl2c_cv_no;
        mov rax, 1;
        ret;
      kbl2c_cv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kbl2c_mtu_valid : (u64) -> u64 !{} @{} =
    fn (mtu: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-003 (#1329): 1 iff mtu in [23, 0xFFFF] per BT §3.2.2 LE minimum ATT MTU. Labels prefixed kbl2c_mv_.",
      block: {
        cmp rdi, 23;
        jb  kbl2c_mv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  kbl2c_mv_no;
        mov rax, 1;
        ret;
      kbl2c_mv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kbl2c_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): counter bump. Labels prefixed kbl2c_nt_.",
      block: {
        cmp rdi, 4;
        jae kbl2c_nt_out;
        lea r10, [rip + _bt_l2cap_chan_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kbl2c_nt_out:
        ret
      }
    } @no_frame

  pub let kbl2c_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): counter read. Labels prefixed kbl2c_stt_.",
      block: {
        cmp rdi, 4;
        jae kbl2c_stt_zero;
        lea r10, [rip + _bt_l2cap_chan_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kbl2c_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let kbl2c_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed kbl2c_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kbl2c_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne kbl2c_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kbl2c_cp_no;

        mov rax, 1;
        ret;
      kbl2c_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // HCI channel gate: live KIND_BT_HCI_CHANNEL (0x183) at hci_chan_slot.
  // ==========================================================================

  pub let kbl2c_check_hci : (u64) -> u64 !{mem} @{cap} =
    fn (hci_chan_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): hci_chan_slot must name a live KIND_BT_HCI_CHANNEL. Labels prefixed kbl2c_ch_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kbl2c_ch_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x183;
        cmp r10, r11;
        jne kbl2c_ch_no;

        mov rax, 1;
        ret;
      kbl2c_ch_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kbl2c_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-003 (#1329): (parent_slot << 8). Labels prefixed kbl2c_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kbl2c_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kbl2c_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let kbl2c_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (hci_chan_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-003 (#1329): pack endpoint_slot[31:0] | hci_chan_slot[63:32]. Labels prefixed kbl2c_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kbl2c_b1_bad;
        cmp rsi, r10;
        ja  kbl2c_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      kbl2c_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let kbl2c_body2_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (cid: u64) (psm: u64) (mtu: u64) (credits: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-003 (#1329): pack cid[15:0] | psm[31:16] | mtu[47:32] | credits[63:48]. Labels prefixed kbl2c_b2_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  kbl2c_b2_bad;
        cmp rsi, r10;
        ja  kbl2c_b2_bad;
        cmp rdx, r10;
        ja  kbl2c_b2_bad;
        cmp rcx, r10;
        ja  kbl2c_b2_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      kbl2c_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _bt_l2cap_chan_table.
  // ==========================================================================

  pub let kbl2c_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (chan_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): claim one BT L2CAP CHANNEL row. THE ONE WRITER. Labels prefixed kbl2c_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kbl2c_ta_bad;

        cmp r13, 0;
        je  kbl2c_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kbl2c_ta_bad;
        cmp r15, r10;
        je  kbl2c_ta_bad;

        xor rbx, rbx;
      kbl2c_ta_scan:
        cmp rbx, 8;
        jae kbl2c_ta_enospc;

        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbl2c_ta_claim;

        add rbx, 1;
        jmp kbl2c_ta_scan;

      kbl2c_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kbl2c_ta_out;

      kbl2c_ta_enospc:
        mov rax, 0xFFFFF10F;
        jmp kbl2c_ta_out;
      kbl2c_ta_bad:
        mov rax, 0xFFFFF10E;

      kbl2c_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kbl2c_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): 1 iff row_id<MAX and in_use. Labels prefixed kbl2c_tvr_.",
      block: {
        cmp rdi, 8;
        jae kbl2c_tvr_no;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbl2c_tvr_no;
        mov rax, 1;
        ret;
      kbl2c_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kbl2c_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): scrub one row. Labels prefixed kbl2c_tf_.",
      block: {
        cmp rdi, 8;
        jae kbl2c_tf_out;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kbl2c_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kbl2c_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): chan_key. Labels prefixed kbl2c_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_rk_bad;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kbl2c_rk_out;
      kbl2c_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbl2c_rk_out:
        pop r12;
        ret
      }
    }

  pub let kbl2c_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): endpoint_slot (body1[31:0]). Labels prefixed kbl2c_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_re_bad;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kbl2c_re_out;
      kbl2c_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbl2c_re_out:
        pop r12;
        ret
      }
    }

  pub let kbl2c_row_hci_chan : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): hci_chan_slot (body1[63:32]). Labels prefixed kbl2c_rh_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_rh_bad;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp kbl2c_rh_out;
      kbl2c_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbl2c_rh_out:
        pop r12;
        ret
      }
    }

  pub let kbl2c_row_cid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): cid (body2[15:0]). Labels prefixed kbl2c_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_rc_bad;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFF;
        jmp kbl2c_rc_out;
      kbl2c_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbl2c_rc_out:
        pop r12;
        ret
      }
    }

  pub let kbl2c_row_psm : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): psm (body2[31:16]). Labels prefixed kbl2c_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_rp_bad;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp kbl2c_rp_out;
      kbl2c_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbl2c_rp_out:
        pop r12;
        ret
      }
    }

  pub let kbl2c_row_mtu : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): mtu (body2[47:32]). Labels prefixed kbl2c_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_rm_bad;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp kbl2c_rm_out;
      kbl2c_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbl2c_rm_out:
        pop r12;
        ret
      }
    }

  pub let kbl2c_row_credits : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): credits (body2[63:48]). Labels prefixed kbl2c_rd_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_rd_bad;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 48;
        and rax, 0xFFFF;
        jmp kbl2c_rd_out;
      kbl2c_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbl2c_rd_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Credit mutators.  credits is the ONE mutable field on this row --
  // add and consume are the sole writers, so a caller cannot forge a
  // credit balance by writing body2 directly.  Both refuse when the
  // resulting balance would leave the u16 domain.
  // ==========================================================================

  pub let kbl2c_row_credit_add : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (delta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): credits += delta; refuse overflow past 0xFFFF (CREDIT_OVERFLOW). Labels prefixed kbl2c_ca_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_ca_bad;

        mov r10, 0xFFFF;
        cmp r13, r10;
        ja  kbl2c_ca_over;

        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 24];
        mov r11, rax;
        shr r11, 48;
        and r11, 0xFFFF;
        add r11, r13;
        mov r8, 0xFFFF;
        cmp r11, r8;
        ja  kbl2c_ca_over;

        // Clear the credits nibble.
        mov r9, 0xFFFF;
        shl r9, 48;
        not r9;
        and rax, r9;
        // Re-insert.
        mov r9, r11;
        and r9, 0xFFFF;
        shl r9, 48;
        or  rax, r9;
        mov [r10 + 24], rax;

        mov rdi, 3;
        call kbl2c_note;

        xor rax, rax;
        jmp kbl2c_ca_out;

      kbl2c_ca_over:
        mov rax, 0xFFFFF101;
        jmp kbl2c_ca_out;
      kbl2c_ca_bad:
        mov rax, 0xFFFFF10E;

      kbl2c_ca_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let kbl2c_row_credit_consume : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (delta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): credits -= delta; refuse underflow below 0 (CREDIT_UNDERFLOW). Labels prefixed kbl2c_cc_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_cc_bad;

        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 24];
        mov r11, rax;
        shr r11, 48;
        and r11, 0xFFFF;
        cmp r11, r13;
        jb  kbl2c_cc_under;
        sub r11, r13;

        mov r9, 0xFFFF;
        shl r9, 48;
        not r9;
        and rax, r9;
        mov r9, r11;
        and r9, 0xFFFF;
        shl r9, 48;
        or  rax, r9;
        mov [r10 + 24], rax;

        xor rax, rax;
        jmp kbl2c_cc_out;

      kbl2c_cc_under:
        mov rax, 0xFFFFF100;
        jmp kbl2c_cc_out;
      kbl2c_cc_bad:
        mov rax, 0xFFFFF10E;

      kbl2c_cc_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kbl2c_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (chan_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-003 (#1329): live row holding chan_key, or ROW_NONE. Refuses to match 0. Labels prefixed kbl2c_fk_.",
      block: {
        cmp rdi, 0;
        je  kbl2c_fk_none;
        xor rcx, rcx;
      kbl2c_fk_scan:
        cmp rcx, 8;
        jae kbl2c_fk_none;
        lea r10, [rip + _bt_l2cap_chan_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbl2c_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kbl2c_fk_hit;
      kbl2c_fk_next:
        add rcx, 1;
        jmp kbl2c_fk_scan;
      kbl2c_fk_hit:
        mov rax, rcx;
        ret;
      kbl2c_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let kbl2c_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): slot -> row_id, gated on live KIND_BT_L2CAP_CHANNEL. Labels prefixed kbl2c_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kbl2c_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x184;
        cmp r10, r11;
        jne kbl2c_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_ros_none;

        mov rax, r12;
        jmp kbl2c_ros_out;

      kbl2c_ros_none:
        mov rax, 0xFF;
      kbl2c_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Six args (slot, parent_slot, rights, chan_key, hci_chan_slot,
  // packed_body):
  //
  //   packed_body encoding:
  //     [15:0]   cid (non-zero)
  //     [31:16]  psm
  //     [47:32]  mtu (>= 23)
  //     [63:48]  credits (initial LE CBFC balance)
  // ==========================================================================

  pub let bt_l2cap_chan_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (chan_key: u64) (hci_chan_slot: u64) (packed_body: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): mint KIND_BT_L2CAP_CHANNEL over KIND_IPC_ENDPOINT. Six-arg because hci_chan_slot needs its own u32 slot alongside cid/psm/mtu/credits. Labels prefixed kbl2c_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // chan_key
        mov r15, r8;                     // hci_chan_slot
        mov rbp, r9;                     // packed_body

        mov r10, 256;
        cmp rbx, r10;
        jae kbl2c_mi_bad_slot;

        mov rdi, r12;
        call kbl2c_check_parent;
        cmp rax, 0;
        je  kbl2c_mi_bad_parent;

        mov rdi, r13;
        call kbl2c_rights_valid;
        cmp rax, 0;
        je  kbl2c_mi_bad_rights;

        // hci_chan check.
        mov rdi, r15;
        call kbl2c_check_hci;
        cmp rax, 0;
        je  kbl2c_mi_bad_hci;

        // cid valid.
        mov r10, rbp;
        and r10, 0xFFFF;
        mov rdi, r10;
        call kbl2c_cid_valid;
        cmp rax, 0;
        je  kbl2c_mi_bad_cid;

        // mtu valid.
        mov r10, rbp;
        shr r10, 32;
        and r10, 0xFFFF;
        mov rdi, r10;
        call kbl2c_mtu_valid;
        cmp rax, 0;
        je  kbl2c_mi_bad_mtu;

        cmp r14, 0;
        je  kbl2c_mi_no_key;

        mov rdi, r14;
        call kbl2c_find_by_key;
        cmp rax, 0xFF;
        jne kbl2c_mi_in_use;

        // Body1 pack (endpoint_slot=parent_slot, hci_chan_slot).
        mov rdi, r12;
        mov rsi, r15;
        call kbl2c_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbl2c_mi_bad_arg;
        push rax;                        // body1 on stack (top)

        // Body2 pack (cid, psm, mtu, credits).
        mov rdi, rbp;
        and rdi, 0xFFFF;                 // cid
        mov rsi, rbp;
        shr rsi, 16;
        and rsi, 0xFFFF;                 // psm
        mov rdx, rbp;
        shr rdx, 32;
        and rdx, 0xFFFF;                 // mtu
        mov rcx, rbp;
        shr rcx, 48;
        and rcx, 0xFFFF;                 // credits
        call kbl2c_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbl2c_mi_bad_arg_pop1;
        push rax;                        // body2 on stack (top)

        // Header pack.
        mov rdi, r12;
        call kbl2c_hdr_pack;
        pop r15;                         // body2 -> r15
        pop rbp;                         // body1 -> rbp
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbl2c_mi_bad_parent;

        // tail_alloc(hdr, chan_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r15;
        call kbl2c_tail_alloc;

        mov r10, 0xFFFFF10F;
        cmp rax, r10;
        je  kbl2c_mi_enospc;
        mov r10, 0xFFFFF10E;
        cmp rax, r10;
        je  kbl2c_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x184;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kbl2c_note;

        xor rax, rax;
        jmp kbl2c_mi_out;

      kbl2c_mi_bad_arg_pop1:
        add rsp, 8;
        jmp kbl2c_mi_bad_arg;

      kbl2c_mi_bad_slot:
        mov rax, 0xFFFFF105;
        jmp kbl2c_mi_out;
      kbl2c_mi_bad_parent:
        mov rax, 0xFFFFF10D;
        jmp kbl2c_mi_out;
      kbl2c_mi_bad_rights:
        mov rax, 0xFFFFF10C;
        jmp kbl2c_mi_out;
      kbl2c_mi_bad_hci:
        mov rax, 0xFFFFF10B;
        jmp kbl2c_mi_out;
      kbl2c_mi_bad_cid:
        mov rax, 0xFFFFF10A;
        jmp kbl2c_mi_out;
      kbl2c_mi_bad_mtu:
        mov rax, 0xFFFFF109;
        jmp kbl2c_mi_out;
      kbl2c_mi_no_key:
        mov rax, 0xFFFFF108;
        jmp kbl2c_mi_out;
      kbl2c_mi_in_use:
        mov rdi, 2;
        call kbl2c_note;
        mov rax, 0xFFFFF106;
        jmp kbl2c_mi_out;
      kbl2c_mi_enospc:
        mov rdi, 2;
        call kbl2c_note;
        mov rax, 0xFFFFF107;
        jmp kbl2c_mi_out;
      kbl2c_mi_bad_arg:
        mov rax, 0xFFFFF10E;

      kbl2c_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let bt_l2cap_chan_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): revoke KIND_BT_L2CAP_CHANNEL. Labels prefixed kbl2c_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kbl2c_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kbl2c_rvk_already;

        mov r11, 0x184;
        cmp r10, r11;
        jne kbl2c_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kbl2c_tail_valid;
        cmp rax, 0;
        je  kbl2c_rvk_clear;

        mov rdi, r13;
        call kbl2c_tail_free;

      kbl2c_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kbl2c_note;

        xor rax, rax;
        jmp kbl2c_rvk_out;

      kbl2c_rvk_bad_slot:
        mov rax, 0xFFFFF105;
        jmp kbl2c_rvk_out;
      kbl2c_rvk_wrong_kind:
        mov rax, 0xFFFFF104;
        jmp kbl2c_rvk_out;
      kbl2c_rvk_already:
        mov rax, 0xFFFFF103;

      kbl2c_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_bt_l2cap_chan : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R39.M2-003 (#1329): KIND_BT_L2CAP_CHANNEL dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kbl2c_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_bt_l2cap_chan_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kbl2c_hn_res;

        cmp rbp, 7;
        ja  kbl2c_hn_unsup;

        cmp rbp, 7;
        je  kbl2c_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kbl2c_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kbl2c_hn_key;
        cmp rbp, 1;
        je  kbl2c_hn_ep;
        cmp rbp, 2;
        je  kbl2c_hn_hci;
        cmp rbp, 3;
        je  kbl2c_hn_cid;
        cmp rbp, 4;
        je  kbl2c_hn_psm;
        cmp rbp, 5;
        je  kbl2c_hn_mtu;
        call kbl2c_row_credits;
        jmp kbl2c_hn_out;

      kbl2c_hn_key:
        call kbl2c_row_key;
        jmp kbl2c_hn_out;
      kbl2c_hn_ep:
        call kbl2c_row_endpoint;
        jmp kbl2c_hn_out;
      kbl2c_hn_hci:
        call kbl2c_row_hci_chan;
        jmp kbl2c_hn_out;
      kbl2c_hn_cid:
        call kbl2c_row_cid;
        jmp kbl2c_hn_out;
      kbl2c_hn_psm:
        call kbl2c_row_psm;
        jmp kbl2c_hn_out;
      kbl2c_hn_mtu:
        call kbl2c_row_mtu;
        jmp kbl2c_hn_out;

      kbl2c_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kbl2c_hn_denied;
        xor rax, rax;
        jmp kbl2c_hn_out;

      kbl2c_hn_res:
        mov rax, 0xFFFFF10E;
        jmp kbl2c_hn_out;
      kbl2c_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kbl2c_hn_out;
      kbl2c_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kbl2c_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
