      block: {
        push r12;
        push r13;
        push r14;
        call sensor_channel_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  sench_cos_bad;
        mov rdi, r12;
        call sensor_channel_row_channel;
        jmp sench_cos_out;
      sench_cos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sench_cos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

