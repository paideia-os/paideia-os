  // ==========================================================================
  // sensor_channel_find_by_pair(endpoint_key, sensor_type) -> row | NONE
  // ==========================================================================

  pub let sensor_channel_find_by_pair : (u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_key: u64, sensor_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): the live row holding this (endpoint, sensor_type) pair, or SENSOR_ROW_NONE (0xFF). Linear scan over 8 rows. THE UNIQUENESS TEST §2's second gate needs: two subscriptions on the same endpoint for the same sensor type would install the same class of sample twice at the same endpoint. Two subscriptions on the SAME endpoint for DIFFERENT sensor types are legal -- a subscriber that wants ACCEL and GYRO separately does so with two rows -- so the KEY IS THE PAIR, not the endpoint alone. Refuses to match an endpoint_key of 0 at all, so a fabricated parent cannot collide with the sentinel sensor_channel_parent_eid returns. Sentinel is 0xFF because row 0 is a legitimate answer. Leaf. Labels prefixed sench_fp_.",
      block: {
        cmp rdi, 0;
        je  sench_fp_none;
        xor rcx, rcx;
      sench_fp_scan:
        cmp rcx, 8;                      // SENSOR_MAX
        jae sench_fp_none;
        lea r10, [rip + _sensor_channel_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sench_fp_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        jne sench_fp_next;
        mov rax, [r10 + 16];
        cmp rax, rsi;
        je  sench_fp_hit;
      sench_fp_next:
        add rcx, 1;
        jmp sench_fp_scan;
      sench_fp_hit:
        mov rax, rcx;
        ret;
      sench_fp_none:
        mov rax, 0xFF;                   // SENSOR_ROW_NONE
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_row_of_slot(slot) -> row_id | NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let sensor_channel_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): slot -> row_id, gated on the descriptor being a live KIND_SENSOR_CHANNEL. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A SENSOR SUBSCRIPTION ROW, and ARITY ONE. Returns SENSOR_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Pure read. Labels prefixed sench_ros_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae sench_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x15d;                  // KIND_SENSOR_CHANNEL
        cmp r10, r11;
        jne sench_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call sensor_channel_tail_valid;
        cmp rax, 0;
        je  sench_ros_none;

        mov rax, r12;
        jmp sench_ros_out;

      sench_ros_none:
        mov rax, 0xFF;                   // SENSOR_ROW_NONE
      sench_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
