  // ==========================================================================
  // sensor_channel_sample_note(slot) -> SENSOR_OK | code
  //
  // The only writer of the row's sample_count. Arity ONE.
  // ==========================================================================

  pub let sensor_channel_sample_note : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): note that one sample was published for the subscription this capability names. ARITY ONE -- capability slot, no payload -- so the sample count reflects deliveries the row itself was consulted for, not counts a caller supplied. THE ONLY DYNAMIC MUTATION IN THIS MODULE. Sequence: (1) resolve slot to row via sensor_channel_row_of_slot; if NONE, SENSOR_BAD_SLOT. (2) increment [row+40] (sample_count). (3) increment module-level ST_SAMPLES for pipeline visibility across revocation. A driver that published a sample and cannot record it should NOT proceed as if it had -- the counter is what the diagnostic 'the driver keeps publishing but this subscriber sees none' consults. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed sench_sn_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        call sensor_channel_row_of_slot;
        mov r13, rax;
        cmp r13, 0xFF;
        je  sench_sn_bad;

        lea r10, [rip + _sensor_channel_table];
        mov r11, r13;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;

        mov rdi, 1;                      // SENSOR_ST_SAMPLES
        call sensor_channel_note;

        xor rax, rax;                    // SENSOR_OK
        jmp sench_sn_out;

      sench_sn_bad:
        mov rax, 0xFFFFFEA5;             // SENSOR_BAD_SLOT

      sench_sn_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_cap_mint_inner(slot, parent_slot, rights,
  //                               sensor_type, rate_hz, subscriber_pid)
  //   -> SENSOR_OK | SENSOR_MINT_*
  //
  // Six arguments, fits SysV six-register limit.
  // ==========================================================================

  pub let sensor_channel_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64, parent_slot: u64, rights: u64, sensor_type: u64, rate_hz: u64, subscriber_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): mint a KIND_SENSOR_CHANNEL subscription over a KIND_IPC_ENDPOINT. Sequence: (1) slot < 256 else SENSOR_BAD_SLOT. (2) sensor_channel_check_parent_endpoint(parent_slot) -- FIRST HALF, the empty gate -- else SENSOR_MINT_BAD_PARENT. (3) sensor_channel_rights_valid(rights) else SENSOR_MINT_BAD_RIGHTS. (4) sensor_channel_type_valid(sensor_type) else SENSOR_MINT_BAD_TYPE. (5) sensor_channel_rate_valid(rate_hz) else SENSOR_MINT_BAD_RATE. (6) subscriber_pid != 0 else SENSOR_MINT_BAD_PID; subscriber_pid fits in u32 else SENSOR_MINT_BAD_PID. (7) INHERIT the endpoint id via sensor_channel_parent_eid; zero -> SENSOR_MINT_BAD_EID. (8) UNIQUENESS: sensor_channel_find_by_pair(endpoint, type) must answer SENSOR_ROW_NONE else SENSOR_MINT_IN_USE. Two subscriptions on the same endpoint for the same sensor type would install the same class twice. Same endpoint, DIFFERENT types is legal and there are two rows. (9) hdr_pack(parent_slot) then tail_alloc -> SENSOR_MINT_ENOSPC on exhaustion. (10) cap_mint_write(slot, KIND_SENSOR_CHANNEL, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579. The endpoint IS inherited, for the reason ec_query does not accept an endpoint argument (§2). Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed sench_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // sensor_type
        mov r15, r8;                     // rate_hz
        mov rbp, r9;                     // subscriber_pid

        mov r10, 256;
        cmp rbx, r10;
        jae sench_mi_bad_slot;

        mov rdi, r12;
        call sensor_channel_check_parent_endpoint;
        cmp rax, 0;
        je  sench_mi_bad_parent;

        mov rdi, r13;
        call sensor_channel_rights_valid;
        cmp rax, 0;
        je  sench_mi_bad_rights;

        mov rdi, r14;
        call sensor_channel_type_valid;
        cmp rax, 0;
        je  sench_mi_bad_type;

        mov rdi, r15;
        call sensor_channel_rate_valid;
        cmp rax, 0;
        je  sench_mi_bad_rate;

        // subscriber_pid non-zero and fits in u32.
        cmp rbp, 0;
        je  sench_mi_bad_pid;
        mov rax, rbp;
        shr rax, 32;
        cmp rax, 0;
        jne sench_mi_bad_pid;

        // Inherit endpoint id.
        mov rdi, r12;
        call sensor_channel_parent_eid;
        cmp rax, 0;
        je  sench_mi_bad_eid;
        mov rcx, rax;                    // rcx = endpoint_key across the next call

        // Uniqueness check: sensor_channel_find_by_pair(endpoint_key, type).
        push rcx;                        // save endpoint_key
        sub rsp, 8;                      // rsp%16 == 0 at call
        mov rdi, rcx;
        mov rsi, r14;                    // type
        call sensor_channel_find_by_pair;
        add rsp, 8;
        pop rcx;                         // restore endpoint_key
        cmp rax, 0xFF;                   // SENSOR_ROW_NONE
        jne sench_mi_in_use;

        // Pack header.
        push rcx;
        sub rsp, 8;
        mov rdi, r12;
        call sensor_channel_hdr_pack;
        add rsp, 8;
        pop rcx;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  sench_mi_bad_parent;

        // tail_alloc(hdr, endpoint_key, type, rate, pid).
        mov rdi, rax;                    // hdr
        mov rsi, rcx;                    // endpoint_key
        mov rdx, r14;                    // sensor_type
        mov rcx, r15;                    // rate_hz
        mov r8,  rbp;                    // subscriber_pid
        call sensor_channel_tail_alloc;

        mov r10, 0xFFFFFEAF;             // SENSOR_TAIL_ENOSPC
        cmp rax, r10;
        je  sench_mi_enospc;
        mov r10, 0xFFFFFEAE;             // SENSOR_TAIL_BAD_ARG
        cmp rax, r10;
        je  sench_mi_bad_type;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x15d;                  // KIND_SENSOR_CHANNEL
        mov rdx, r13;                    // rights
        mov rcx, r14;
        call cap_mint_write;

        // Count successful mints.
        mov rdi, 0;                      // SENSOR_ST_MINTS
        call sensor_channel_note;

        xor rax, rax;                    // SENSOR_OK
        jmp sench_mi_out;

      sench_mi_bad_slot:
        mov rax, 0xFFFFFEA5;
        jmp sench_mi_out;
      sench_mi_bad_parent:
        mov rax, 0xFFFFFEAD;
        jmp sench_mi_out;
      sench_mi_bad_rights:
        mov rax, 0xFFFFFEAC;
        jmp sench_mi_out;
      sench_mi_bad_type:
        mov rax, 0xFFFFFEAB;
        jmp sench_mi_out;
      sench_mi_bad_rate:
        mov rax, 0xFFFFFEAA;
        jmp sench_mi_out;
      sench_mi_bad_pid:
        mov rax, 0xFFFFFEA9;
        jmp sench_mi_out;
      sench_mi_bad_eid:
        mov rax, 0xFFFFFEA8;
        jmp sench_mi_out;
      sench_mi_enospc:
        mov rax, 0xFFFFFEA7;
        jmp sench_mi_out;
      sench_mi_in_use:
        mov rax, 0xFFFFFEA6;

      sench_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sensor_channel_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64, parent_slot: u64, rights: u64, sensor_type: u64, rate_hz: u64, subscriber_pid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): audited entry point. Same wrapper shape as hid_event_cap_mint / ec_query_cap_mint. Putting emission in the wrapper means a second mint path cannot exist without being audited. The PRINCIPAL recorded is the parent endpoint slot: even though it decides nothing on its own (§2), it is the only authority the subscriber can be said to have derived from. Three pushes leave rsp%16 == 0 at both nested calls. Labels prefixed sench_mw_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent endpoint)

        call sensor_channel_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x15d;                  // KIND_SENSOR_CHANNEL
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_cap_revoke_inner(slot) -> SENSOR_OK | ...
  // ==========================================================================

  pub let sensor_channel_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): revoke a KIND_SENSOR_CHANNEL subscription. (1) slot < 256 -> SENSOR_BAD_SLOT. (2) kind == 0 -> SENSOR_REVOKE_ALREADY. (3) kind != 0x15d -> SENSOR_WRONG_KIND. (4) row_id from target_ptr[15:0]; if live, sensor_channel_tail_free scrubs it. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0) per #1579. Nothing routes a sample through this kind (§3), so a revoke leaves nothing to unbind in a router; when a driver is wired to publish, its owner-column path is what tears down any transient delivery state, not this function. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed sench_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae sench_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  sench_rvk_already;

        mov r11, 0x15d;                  // KIND_SENSOR_CHANNEL
        cmp r10, r11;
        jne sench_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call sensor_channel_tail_valid;
        cmp rax, 0;
        je  sench_rvk_clear;

        mov rdi, r13;
        call sensor_channel_tail_free;

      sench_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // SENSOR_OK
        jmp sench_rvk_out;

      sench_rvk_bad_slot:
        mov rax, 0xFFFFFEA5;
        jmp sench_rvk_out;
      sench_rvk_wrong_kind:
        mov rax, 0xFFFFFEA4;
        jmp sench_rvk_out;
      sench_rvk_already:
        mov rax, 0xFFFFFEA3;

      sench_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sensor_channel_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS. NO cascade: nothing in this tree derives from a sensor subscription. Three pushes leave rsp%16 == 0 at both nested calls. Labels prefixed sench_rw_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call sensor_channel_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x15d;                  // KIND_SENSOR_CHANNEL
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_debug_print(row_id) -> SENSOR_OK | SENSOR_TAIL_BAD_ARG
  // ==========================================================================

  pub let sensor_channel_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R32.M5-001 (#1133): canonical printer for one subscription row. Refuses a dead or out-of-range row with SENSOR_TAIL_BAD_ARG rather than printing zeroes: a freed row renders as {eid 0, type 0, rate 0, pid 0}, which is a plausible-looking subscription that no driver could satisfy. Four KV lines. r12 holds row_id across the calls; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed sench_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call sensor_channel_tail_valid;
        cmp rax, 0;
        je  sench_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sench_dbg_msg];
        lea rcx, [rip + sench_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call sensor_channel_row_channel;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sench_dbg_msg];
        lea rcx, [rip + sench_k_eid];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call sensor_channel_row_type;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sench_dbg_msg];
        lea rcx, [rip + sench_k_typ];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call sensor_channel_row_rate;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sench_dbg_msg];
        lea rcx, [rip + sench_k_rat];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // SENSOR_OK
        jmp sench_dp_out;

      sench_dp_bad:
        mov rax, 0xFFFFFEAE;             // SENSOR_TAIL_BAD_ARG

      sench_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_sensor_channel(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_sensor_channel : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): KIND_SENSOR_CHANNEL dispatch handler. Emits cap_sensor_channel_msg on entry. row_id = target_ptr[15:0], op = op_arg[7:0]. RIGHTS PER OP: QUERY_* require R_SENSOR_INVOKE; DEBUG_PRINT requires R_SENSOR_OBSERVE; SAMPLE_NOTE requires R_SENSOR_REPORT. NO OPERAND FIELDS: every op takes op_arg = op only. op_arg[63:8] MUST be zero -- refused with SENSOR_TAIL_BAD_ARG rather than masked. Unknown op -> INVOKE_UNSUPPORTED; rights failure -> INVOKE_DENIED. Every query returns SENSOR_DECODE_BAD for a dead row and never a plausible zero. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed sench_h_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        mov r10, 0xFF;
        and rbx, r10;                    // slot = target_ptr[23:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_sensor_channel_msg];
        call klog_s1;

        // Decode op and reserved.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov r11, r14;
        shr r11, 8;                      // reserved bits [63:8]
        mov r14, r10;                    // r14 = op

        cmp r14, 7;                      // SENSOR_OP_MAX
        ja  sench_h_unsup;

        // Every op takes NO operand -- refuse non-zero reserved.
        cmp r11, 0;
        jne sench_h_res;

        // Dispatch: 6 = DEBUG_PRINT (OBSERVE), 7 = SAMPLE_NOTE (REPORT),
        // 0..5 = QUERY_* (INVOKE).
        cmp r14, 6;
        je  sench_h_dbg;
        cmp r14, 7;
        je  sench_h_note;

        mov r10, r12;
        and r10, 0x008;                  // R_SENSOR_INVOKE
        cmp r10, 0;
        je  sench_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  sench_h_ch;
        cmp r14, 1;
        je  sench_h_ty;
        cmp r14, 2;
        je  sench_h_ra;
        cmp r14, 3;
        je  sench_h_pd;
        cmp r14, 4;
        je  sench_h_pa;
        call sensor_channel_row_samples;
        jmp sench_h_out;

      sench_h_ch:
        call sensor_channel_row_channel;
        jmp sench_h_out;
      sench_h_ty:
        call sensor_channel_row_type;
        jmp sench_h_out;
      sench_h_ra:
        call sensor_channel_row_rate;
        jmp sench_h_out;
      sench_h_pd:
        call sensor_channel_row_pid;
        jmp sench_h_out;
      sench_h_pa:
        call sensor_channel_row_parent;
        jmp sench_h_out;

      sench_h_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_SENSOR_OBSERVE
        cmp r10, 0;
        je  sench_h_denied;
        mov rdi, r13;
        call sensor_channel_debug_print;
        jmp sench_h_out;

      sench_h_note:
        mov r10, r12;
        and r10, 0x002;                  // R_SENSOR_REPORT
        cmp r10, 0;
        je  sench_h_denied;
        // sensor_channel_sample_note takes a SLOT. The slot is encoded
        // in target_ptr[23:16] at mint (see sensor_channel_cap_mint_inner)
        // and preserved in rbx across the klog call above.
        mov rdi, rbx;
        call sensor_channel_sample_note;
        jmp sench_h_out;

      sench_h_res:
        mov rax, 0xFFFFFEAE;             // SENSOR_TAIL_BAD_ARG
        jmp sench_h_out;
      sench_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp sench_h_out;
      sench_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      sench_h_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
