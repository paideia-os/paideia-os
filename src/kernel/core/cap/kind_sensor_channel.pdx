        push r13;
        push r14;
        mov r12, rdi;
        call sensor_channel_row_hdr;
        mov r13, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  sench_rpa_bad;
        mov rdi, r13;
        call sensor_channel_hdr_parent;
        jmp sench_rpa_out;
      sench_rpa_bad:
