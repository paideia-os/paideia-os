        pop r12;
        ret
      }
    }

  pub let sensor_channel_rate_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): rate_hz of the subscription this capability names, or SENSOR_DECODE_BAD. ARITY ONE. A second parameter would be a caller-supplied override that lets a subscriber quietly widen its share of the driver's sample budget after the mint approved a slower one. Labels prefixed sench_ros2_.",
      block: {
