// src/kernel/core/cap/kind_sensor_channel.pdx — R32.M5-001 (#1133)
//
// KIND_SENSOR_CHANNEL = 0x15d, derived over KIND_IPC_ENDPOINT (5).
//
// The authority a ring-3 SUBSCRIBER holds to be told, on ONE endpoint
// it also holds, about ONE class of sensor sample the R32 substrate
// emits (ambient light / accelerometer / gyroscope) at a chosen rate.
// The record of one subscription.
//
// =============================================================================
// §0  UNITS: THE ROW IS A SUBSCRIPTION RECORD, NOT A SAMPLE STORE
// =============================================================================
//
// The row stores four things -- endpoint id, sensor type ordinal, rate
// in Hz, subscriber pid -- and one dynamic counter of how many samples
// the driver has published on behalf of this subscription. It does NOT
// carry a lux value, an acceleration vector, or an angular rate: those
// belong to the sensor sample stream (design/ipc/sensor-read-channel-
// schema.md) and the driver that publishes them (src/kernel/core/
// drivers/sensor_hub.pdx). This kind is the AUTHORITY to name a class
// of samples to a driver and to be counted as a recipient of them; its
// whole surface is queries plus one no-payload counter.
//
// A ROW THAT COULD BE RE-STAMPED IN PLACE WITH A DIFFERENT SENSOR
// TYPE would let one subscription's rate accounting attach to a
// completely different class of samples -- an accelerometer subscriber
// suddenly counted against an ambient-light rate budget. §1 states the
// discipline that makes it unrepresentable: sensor_type, rate_hz,
// subscriber_pid and event_channel_key are ROW IDENTITY, set once at
// mint, and there is no primitive in this module that changes them.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT — ONE DYNAMIC FIELD
// =============================================================================
//
// Same discipline as `kind_hid_event.pdx` §1 with one addition: this
// kind carries a lifetime `sample_count` in the row, incremented only
// by `sensor_channel_sample_note` (arity ONE, capability in, nothing
// else, out). A count that could be raised by a caller with a payload
// would let a subscriber appear to have received samples the driver
// never published; a count that could be lowered would let a stalled
// pipeline look healthy.
//
// The four identity fields are the four things a router will consult
// to decide whether one sensor sample delivery is intended for this
// row, and each has exactly one legitimate value:
//
//   * event_channel_key — INHERITED from the parent KIND_IPC_ENDPOINT's
//     target_ptr[15:0]. The mint has no endpoint argument; a driver
//     forming a delivery uses this key, not one the subscriber names.
//   * sensor_type — one of ALS / ACCEL / GYRO. Zero (UNKNOWN) refused
//     at mint per §5 for the same reason KIND_HID_DEVICE refuses
//     transport UNKNOWN: it is a decoder answer, not a legitimate
//     parent state, and admitting it would leave one legal spelling of
//     an unclassified subscription in the table.
//   * rate_hz — 1..SENSOR_RATE_MAX Hz. Zero refused (no rate = no
//     data), and above the ceiling refused rather than clamped (the
//     driver's sample cadence budget is a bounded resource, and a
//     supersonic rate silently pinned at the ceiling is a subscriber
//     that thinks it is getting samples faster than the hardware can
//     produce them).
//   * subscriber_pid — non-zero, fits u32. Zero is the reserved 'no
//     process' pid; an owner-column sweep on a subscription owned by
//     nobody would refuse to clean it up.
//
// =============================================================================
// §2  DERIVATION OVER KIND_IPC_ENDPOINT — THE FOURTH TIME AN EMPTY GATE
//     IS NAMED SO
// =============================================================================
//
// FIRST HALF: `cap_table[parent_slot].kind == KIND_IPC_ENDPOINT (5)`
// carrying RIGHT_MINT.
//
// THAT HALF IS EMPTY ON ITS OWN. Every endpoint in this system is a
// KIND_IPC_ENDPOINT -- the shell's stdout included -- so a gate that
// stopped there would let any process holding any endpoint mint itself
// a subscription to any sensor. This is the #1075 lesson restated for
// the fourth time in the derived-kind file family (KIND_FW_SESSION,
// KIND_EC_QUERY, KIND_HID_EVENT, and now this).
//
// SECOND HALF: the mint reads the parent's target_ptr bits [15:0]
// (the encoding cap/kind_endpoint.pdx's endpoint_tail_pack writes)
// and stores it as `event_channel_key`, refusing zero with
// `SENSOR_MINT_BAD_EID`. Zero is a fabricated-parent sentinel:
// kind_endpoint treats endpoint_id 0 as unallocated, so a mint that
// admitted it would install a subscription whose deliveries the
// driver refused as unroutable while looking perfectly registered.
//
// UNIQUENESS KEY IS (endpoint_id, sensor_type). Two subscriptions on
// the same endpoint for the same sensor type would install the same
// class of sample twice at the same endpoint, so
// `sensor_channel_find_by_pair` refuses that with
// `SENSOR_MINT_IN_USE`. Two subscriptions on the SAME endpoint for
// DIFFERENT sensor types are legal -- a subscriber that wants both
// accelerometer and gyroscope samples on one endpoint does so with two
// rows. The RATE is NOT part of the uniqueness key: a subscriber does
// not need two rows for two rates of the same sensor (that is what
// revoke-and-remint is for; a rate that could be changed in place
// would let a subscriber quietly widen its share of the driver's
// sample budget after the gate approved a slower one).
//
// =============================================================================
// §3  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
//   * NOTHING DRIVES A SENSOR. `sensor_channel_sample_note` returns
//     SENSOR_OK for any live capability; there is no I²C write, no
//     interrupt acknowledgement, no register poke in this module at
//     all. Publishing a sample is sensor_hub.pdx's; being told about
//     one is design/ipc/sensor-read-channel-schema.md's.
//   * NOTHING NARROWS OR WIDENS A RATE. rate_hz is set once at mint
//     and there is no primitive that changes it (§2).
//   * NOTHING VALIDATES A SAMPLE VALUE. The schema's packer/unpacker
//     is what refuses out-of-range accelerations or lux values; this
//     kind carries none of them.
//
// =============================================================================
// §4  ENUMERATIONS: SENSOR TYPE
// =============================================================================
//
//   0 UNKNOWN — refused at mint per §1; present so ordinal 0 is a
//               real answer rather than a decode error.
//   1 ALS     — ambient light (lux)
//   2 ACCEL   — accelerometer (milli-g per axis)
//   3 GYRO    — gyroscope (milli-deg/s per axis)
//
// A future fourth sensor (magnetometer, orientation) takes the next
// ordinal and adds itself to SENSOR_TYPE_MAX in the same commit that
// adds a publisher for it. The mint validator refuses any ordinal
// outside 1..SENSOR_TYPE_MAX, so a future class cannot silently
// activate an old row.
//
// =============================================================================
// §5  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// This module contains no `in`/`out` and no firmware-bytecode
// identifier. `tools/lint-no-kernel-aml.sh` refuses any kernel
// identifier matching `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`,
// `\_SB_` or `\_SB.`. KIND_SENSOR_CHANNEL, sensor_channel_* and
// _sensor_channel_table match none of the six.
//
// =============================================================================

module KindSensorChannel = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_SENSOR_CHANNEL        : u64 = 0x15d  // derived-kind tag (349)
  pub let SENSOR_CHANNEL_PARENT_KIND : u64 = 5      // = KIND_IPC_ENDPOINT

  // ==========================================================================
  // §4 sensor type enumeration.
  // ==========================================================================

  pub let SENSOR_TYPE_UNKNOWN : u64 = 0
  pub let SENSOR_TYPE_ALS     : u64 = 1
  pub let SENSOR_TYPE_ACCEL   : u64 = 2
  pub let SENSOR_TYPE_GYRO    : u64 = 3
  pub let SENSOR_TYPE_MAX     : u64 = 3

  // Rate ceiling: 1..1000 Hz. A gyroscope sampled above 1kHz produces
  // more angular-rate readings per second than the hub's I²C bus can
  // deliver on a T14 G4, and admitting a rate the hardware cannot
  // sustain would let a subscriber count against a budget it could
  // never fill.
  pub let SENSOR_RATE_MAX : u64 = 1000

  // ==========================================================================
  // Rights.
  //
  // R_SENSOR_READ / _REPORT / _INVOKE / _REVOKE / _OBSERVE.
  // RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf.
  // Nothing in the tree derives from a sensor subscription.
  // ==========================================================================

  pub let R_SENSOR_READ    : u64 = 0x001
  pub let R_SENSOR_REPORT  : u64 = 0x002
  pub let R_SENSOR_INVOKE  : u64 = 0x008
  pub let R_SENSOR_REVOKE  : u64 = 0x010
  pub let R_SENSOR_OBSERVE : u64 = 0x400
  pub let R_SENSOR_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each requires.
  //
  //   0 QUERY_CHANNEL  INVOKE   the row's own event_channel_key
  //   1 QUERY_TYPE     INVOKE   sensor_type ordinal
  //   2 QUERY_RATE     INVOKE   rate_hz
  //   3 QUERY_PID      INVOKE   subscriber_pid
  //   4 QUERY_PARENT   INVOKE   parent KIND_IPC_ENDPOINT slot
  //   5 QUERY_SAMPLES  INVOKE   lifetime sample count
  //   6 DEBUG_PRINT    OBSERVE  canonical row dump
  //   7 SAMPLE_NOTE    REPORT   arity-one "one sample was published"
  //
  // SAMPLE_NOTE takes NO OPERAND. The whole op_arg field beyond the
  // low byte is REFUSED with SENSOR_TAIL_BAD_ARG rather than masked,
  // for the reason KIND_HID_EVENT ops are: reserved bits on an
  // invocation op are where a future field would appear, and
  // admitting them silently now would make it impossible to add one
  // later. All other ops likewise take no operand and refuse a non-
  // zero op_arg[63:8].
  // ==========================================================================

  pub let SENSOR_OP_QUERY_CHANNEL : u64 = 0
  pub let SENSOR_OP_QUERY_TYPE    : u64 = 1
  pub let SENSOR_OP_QUERY_RATE    : u64 = 2
  pub let SENSOR_OP_QUERY_PID     : u64 = 3
  pub let SENSOR_OP_QUERY_PARENT  : u64 = 4
  pub let SENSOR_OP_QUERY_SAMPLES : u64 = 5
  pub let SENSOR_OP_DEBUG_PRINT   : u64 = 6
  pub let SENSOR_OP_SAMPLE_NOTE   : u64 = 7
  pub let SENSOR_OP_MAX           : u64 = 7

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFEA0..0xFFFFFEAF.
  //
  // Sixteen-wide, disjoint from KIND_HID_EVENT (0xFFFFFE90..9F),
  // KIND_HID_DEVICE (0xFFFFFE80..8F), KIND_BACKLIGHT
  // (0xFFFFFE70..7F), battery_monitor (0xFFFFFE60..6F),
  // KIND_COOLING_DEVICE (0xFFFFFE50..5F), KIND_BATTERY
  // (0xFFFFFE40..4F), KIND_THERMAL_ZONE (0xFFFFFE30..3F), owner
  // (0xFFFFFE2B..2F), thermal policy (0xFFFFFE20..2A),
  // KIND_FW_SESSION (0xFFFFFE10..1F), and KIND_EC_QUERY
  // (0xFFFFFE00..0F). Disjointness is what lets a u64 threaded up
  // through the mint, the row allocator and the dispatch handler
  // still name the gate that refused it.
  // ==========================================================================

  pub let SENSOR_OK                 : u64 = 0
  pub let SENSOR_TAIL_ENOSPC        : u64 = 0xFFFFFEAF
  pub let SENSOR_TAIL_BAD_ARG       : u64 = 0xFFFFFEAE
  pub let SENSOR_MINT_BAD_PARENT    : u64 = 0xFFFFFEAD
  pub let SENSOR_MINT_BAD_RIGHTS    : u64 = 0xFFFFFEAC
  pub let SENSOR_MINT_BAD_TYPE      : u64 = 0xFFFFFEAB
  pub let SENSOR_MINT_BAD_RATE      : u64 = 0xFFFFFEAA
  pub let SENSOR_MINT_BAD_PID       : u64 = 0xFFFFFEA9
  pub let SENSOR_MINT_BAD_EID       : u64 = 0xFFFFFEA8
  pub let SENSOR_MINT_ENOSPC        : u64 = 0xFFFFFEA7
  pub let SENSOR_MINT_IN_USE        : u64 = 0xFFFFFEA6
  pub let SENSOR_BAD_SLOT           : u64 = 0xFFFFFEA5
  pub let SENSOR_WRONG_KIND         : u64 = 0xFFFFFEA4
  pub let SENSOR_REVOKE_ALREADY     : u64 = 0xFFFFFEA3

  // The decoders' contract for a dead or out-of-range row.
  pub let SENSOR_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // `sensor_channel_find_by_pair`'s "no row holds this (endpoint,
  // type)". 0xFF rather than 0, because row 0 is a legitimate answer.
  pub let SENSOR_ROW_NONE : u64 = 0xFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // EIGHT ROWS, sized by CONCURRENT SENSOR SUBSCRIBERS a T14 G4 boot
  // reasonably hosts. Per-subscriber, per-sensor-type: a display-auto
  // policy wanting ALS is one row, a screen-rotation service wanting
  // ACCEL is one, a stabilisation subsystem wanting GYRO is one.
  // Eight covers three concurrent subscribers, each of the three
  // sensor types.
  //
  // Sixty-four bytes per row so the index is a `shl 6`; paideia-as
  // has no `mul`.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot  cap_table slot of the parent
  //                                     KIND_IPC_ENDPOINT at mint;
  //                                     audit and query only
  //           bits [55:16] reserved, must be zero
  //           bits [63:56] in_use       allocator flag
  //   [+8]  event_channel_key  INHERITED from the parent descriptor's
  //                            target_ptr[15:0]. Non-zero.
  //   [+16] sensor_type        1..SENSOR_TYPE_MAX (0 refused at mint)
  //   [+24] rate_hz            1..SENSOR_RATE_MAX (0 refused; above
  //                            refused rather than clamped, per §1)
  //   [+32] subscriber_pid     u32; non-zero.
  //   [+40] sample_count       u64; DYNAMIC — bumped by
  //                            sensor_channel_sample_note. Only
  //                            dynamic field on this row.
  //   [+48] reserved, zero
  //   [+56] reserved, zero
  //
  // `tools/build.sh` asserts by `objdump -r` that no object other
  // than `core/cap/kind_sensor_channel.o` relocates against
  // `_sensor_channel_table`.
  // ==========================================================================

  pub let SENSOR_MAX       : u64 = 8
  pub let SENSOR_ROW_BYTES : u64 = 64

  pub let mut _sensor_channel_table : [u64; 64] = uninit @align(64)

  // Counters. Deliberately outside the row so a diagnostic about the
  // subscription-mint pipeline survives revocation.
  pub let mut _sensor_channel_stats : [u64; 8] = uninit @align(64)

  pub let SENSOR_ST_MINTS   : u64 = 0
  pub let SENSOR_ST_SAMPLES : u64 = 1
  pub let SENSOR_ST_MAX     : u64 = 8

  // Local klog keys and tags.
  pub let sench_dbg_msg : [u8; 12] = "SENSOR ROW\n\0"
  pub let sench_k_row   : [u8; 4]  = "row\0"
  pub let sench_k_eid   : [u8; 4]  = "eid\0"
  pub let sench_k_typ   : [u8; 5]  = "type\0"
  pub let sench_k_rat   : [u8; 5]  = "rate\0"
  pub let sench_k_pid   : [u8; 4]  = "pid\0"

  // ==========================================================================
  // sensor_channel_table_reset() -> ()
  // ==========================================================================

  pub let sensor_channel_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring the reset shape every derived kind in this family uses: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Bounded by immediate compares, 64 iterations for the row table and 8 for the counters. Leaf. Labels prefixed sench_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _sensor_channel_table];
        xor rax, rax;
        xor rcx, rcx;
      sench_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  sench_rs_rows;

        lea r10, [rip + _sensor_channel_stats];
        xor rcx, rcx;
      sench_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sench_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_type_valid(type) -> 1 | 0
  // ==========================================================================

  pub let sensor_channel_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-001 (#1133): 1 iff type in [1, SENSOR_TYPE_MAX]. UNKNOWN (0) is REFUSED per §1: it is a decoder answer, not a legitimate parent state, and a mint that admitted it would let a subscription record 'I could not identify what class of sample I want' as a legitimate row and then never notice the mismatch. Refused rather than mapped so 'the caller has not decided' and 'the driver has not identified' stay different facts. Pure leaf. Labels prefixed sench_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  sench_tv_no;
        mov r10, 3;                      // SENSOR_TYPE_MAX
        cmp rdi, r10;
        ja  sench_tv_no;
        mov rax, 1;
        ret;
      sench_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_rate_valid(rate) -> 1 | 0
  // ==========================================================================

  pub let sensor_channel_rate_valid : (u64) -> u64 !{} @{} =
    fn (rate: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-001 (#1133): 1 iff rate in [1, SENSOR_RATE_MAX]. Zero refused: a subscription at zero Hz would receive no samples forever while looking perfectly registered, and the sample-note counter is what would be checked to notice -- but a zero-rate row is expected to have no samples, so the two facts would be indistinguishable. Above the ceiling refused rather than clamped: a supersonic rate silently pinned would let a subscriber think it is getting samples faster than the hardware can produce them, and the driver would happily NOT emit them at the requested cadence without any refusal record. Pure leaf. Labels prefixed sench_rv_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  sench_rv_no;
        mov r10, 1000;                   // SENSOR_RATE_MAX
        cmp rdi, r10;
        ja  sench_rv_no;
        mov rax, 1;
        ret;
      sench_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_note(which) -> ()
  // sensor_channel_stat(which) -> count
  // ==========================================================================

  pub let sensor_channel_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): increment one counter; silent no-op on out-of-range. Same shape as hid_event_note: every caller inside this module passes a constant, and the bound is here so the array cannot be walked past if that ever stops being true. Leaf. Labels prefixed sench_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // SENSOR_ST_MAX
        jae sench_nt_out;
        lea r10, [rip + _sensor_channel_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sench_nt_out:
        ret
      }
    }

  pub let sensor_channel_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): bounds-checked read of one counter; out of range returns 0. Leaf. Labels prefixed sench_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // SENSOR_ST_MAX
        jae sench_st_zero;
        lea r10, [rip + _sensor_channel_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sench_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let sensor_channel_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-001 (#1133): 1 iff (rights & R_SENSOR_ALL) == rights. R_SENSOR_ALL = 0x41B. Subset test, RIGHT_MINT (0x200) outside the mask because this kind is a leaf of the lattice. Pure leaf. Labels prefixed sench_rvv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;                  // R_SENSOR_ALL
        and rax, r10;
        cmp rax, rdi;
        jne sench_rvv_no;
        mov rax, 1;
        ret;
      sench_rvv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_check_parent_endpoint(parent_slot) -> 1 | 0
  //
  // §2. THE FIRST HALF of the derivation gate. Necessary and, by
  // itself, empty.
  // ==========================================================================

  pub let sensor_channel_check_parent_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): first half of the derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == 5 (KIND_IPC_ENDPOINT) AND rights ([+8]) carrying RIGHT_MINT (0x200). Same discipline as hid_event_check_parent_endpoint: this predicate discriminates almost nothing on its own -- every endpoint in the machine is kind 5 -- which is why sensor_channel_cap_mint_inner refuses unless the SECOND half (a well-formed non-zero type, a non-zero rate in range, a non-zero pid, and an inherited endpoint id that is not the fabricated-parent sentinel 0) also passes. A separate function so the two halves are separately mutable and separately witnessed. Pure read. Labels prefixed sench_cpe_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae sench_cpe_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 5;                      // KIND_IPC_ENDPOINT
        cmp r10, r11;
        jne sench_cpe_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  sench_cpe_no;

        mov rax, 1;
        ret;

      sench_cpe_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_parent_eid(parent_slot) -> endpoint_id | 0
  // ==========================================================================

  pub let sensor_channel_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): read the parent KIND_IPC_ENDPOINT descriptor's endpoint id -- target_ptr bits [15:0], the encoding cap/kind_endpoint.pdx's endpoint_tail_pack writes. THE ONLY SOURCE OF A SUBSCRIPTION'S CHANNEL IDENTITY: the mint has no endpoint argument, so the endpoint a subscription will deliver on is the endpoint its parent capability names and no other. A mint that took the id as an argument would let a holder attach one endpoint's identity to a different endpoint's row -- and every routed sample thereafter would be confidently wrong about where the delivery landed. The kind is re-checked here rather than trusted from the gate: this function turns a slot number into the identity every routed record will carry, and a caller that reached it by another path must not get an id out of an unrelated descriptor. Returns 0 for a bad slot or a non-KIND_IPC_ENDPOINT descriptor; 0 is also what sensor_channel_cap_mint_inner refuses outright. Pure read. Labels prefixed sench_pei_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae sench_pei_zero;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 5;                      // KIND_IPC_ENDPOINT
        cmp r10, r11;
        jne sench_pei_zero;

        mov rax, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and rax, r11;                    // endpoint_id [15:0]
        ret;

      sench_pei_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sensor_channel_hdr_pack(parent_slot) -> hdr | SENSOR_DECODE_BAD
  // ==========================================================================

  pub let sensor_channel_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-001 (#1133): canonical header-word encoder. Validates parent_slot < 256 then packs (parent_slot << 8), leaving bits [7:0], [55:16] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero: a header arriving with in_use pre-set would hand back a row the free scan skips forever, leaking a subscription record whose sample_count outlives its capability. Pure leaf. Labels prefixed sench_hp_ per reserved-label discipline.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae sench_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        ret;

      sench_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sensor_channel_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-001 (#1133): parent_slot from header bits [15:8]. Named accessor rather than a shift at each call site. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    }

  // ==========================================================================
  // sensor_channel_tail_alloc(hdr, event_channel_key, sensor_type,
  //                           rate_hz, subscriber_pid) -> row_id | code
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A SENSOR SUBSCRIPTION.
  // ==========================================================================

  pub let sensor_channel_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (event_channel_key: u64) (sensor_type: u64) (rate_hz: u64) (subscriber_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A SENSOR SUBSCRIPTION, which is why tools/build.sh confines relocations against _sensor_channel_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (the allocator's in_use flag); hdr reserved bits [7:0] or [55:16] non-zero -> TAIL_BAD_ARG; event_channel_key == 0 -> TAIL_BAD_ARG (0 is sensor_channel_parent_eid's refusal value and kind_endpoint's unallocated sentinel); sensor_type == 0 OR > SENSOR_TYPE_MAX -> TAIL_BAD_ARG (§1/§4); rate_hz == 0 OR > SENSOR_RATE_MAX -> TAIL_BAD_ARG (§1); subscriber_pid == 0 -> TAIL_BAD_ARG (reserved 'no process' pid); subscriber_pid >= 2^32 -> TAIL_BAD_ARG (u32 field). VALIDATIONS ARE HERE AS WELL AS IN THE MINT, deliberately: the mint's versions produce specific codes an installer needs, while this makes it impossible for ANY future second caller of the allocator to create a row without them. Low-first scan over 8 rows of 64 bytes, free iff byte 7 of [row+0] is zero. Claim writes all eight words including sample_count=0, so a reused row cannot inherit the previous subscription's identity or count. Five pushes leave rsp%16 == 0 at every nested call site (there are none in this leaf). Labels prefixed sench_ta_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // event_channel_key
        mov r14, rdx;                    // sensor_type
        mov r15, rcx;                    // rate_hz
        // subscriber_pid stays in r8

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne sench_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne sench_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits [55:16]
        and rax, r10;
        cmp rax, 0;
        jne sench_ta_bad;

        cmp r13, 0;
        je  sench_ta_bad;

        // sensor_type in [1, SENSOR_TYPE_MAX].
        cmp r14, 0;
        je  sench_ta_bad;
        mov r10, 3;                      // SENSOR_TYPE_MAX
        cmp r14, r10;
        ja  sench_ta_bad;

        // rate_hz in [1, SENSOR_RATE_MAX].
        cmp r15, 0;
        je  sench_ta_bad;
        mov r10, 1000;                   // SENSOR_RATE_MAX
        cmp r15, r10;
        ja  sench_ta_bad;

        // subscriber_pid non-zero.
        cmp r8, 0;
        je  sench_ta_bad;
        // subscriber_pid fits in u32.
        mov rax, r8;
        shr rax, 32;
        cmp rax, 0;
        jne sench_ta_bad;

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      sench_ta_scan:
        cmp rbx, 8;                      // SENSOR_MAX
        jae sench_ta_enospc;

        lea r10, [rip + _sensor_channel_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sench_ta_claim;

        add rbx, 1;
        jmp sench_ta_scan;

      sench_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // event_channel_key
        mov [r10 + 16], r14;             // sensor_type
        mov [r10 + 24], r15;             // rate_hz
        mov [r10 + 32], r8;              // subscriber_pid
        xor rax, rax;
        mov [r10 + 40], rax;             // sample_count = 0
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov rax, rbx;
        jmp sench_ta_out;

      sench_ta_enospc:
        mov rax, 0xFFFFFEAF;             // SENSOR_TAIL_ENOSPC
        jmp sench_ta_out;
      sench_ta_bad:
        mov rax, 0xFFFFFEAE;             // SENSOR_TAIL_BAD_ARG

      sench_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sensor_channel_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): 1 iff row_id < SENSOR_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers SENSOR_DECODE_BAD rather than the zeroes it was scrubbed to. Leaf. Labels prefixed sench_tv2_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // SENSOR_MAX
        jae sench_tv2_no;
        lea r10, [rip + _sensor_channel_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sench_tv2_no;
        mov rax, 1;
        ret;
      sench_tv2_no:
        xor rax, rax;
        ret
      }
    }

  pub let sensor_channel_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): scrub one row to zero, which clears in_use and returns it to the free scan. ALL EIGHT WORDS, including sample_count: a revoke is the point at which the subscriber has decided this delivery contract no longer applies, and a row that kept its identity or count across a re-mint would let one subscriber's row be reused by another for a completely different (endpoint, type) pair. Scrubbing the PAIR is what makes the (endpoint, type) combination re-mintable. No-op on an out-of-range row. Leaf. Labels prefixed sench_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // SENSOR_MAX
        jae sench_tf_out;
        lea r10, [rip + _sensor_channel_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      sench_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Every one returns SENSOR_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let sensor_channel_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): raw header word of a live row, or SENSOR_DECODE_BAD. Labels prefixed sench_rh_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call sensor_channel_tail_valid;
        cmp rax, 0;
        je  sench_rh_bad;
        lea r10, [rip + _sensor_channel_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp sench_rh_out;
      sench_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sench_rh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let sensor_channel_row_channel : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-001 (#1133): inherited endpoint id of a live row, or SENSOR_DECODE_BAD. Never accepted as an argument; only read. Labels prefixed sench_rc_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call sensor_channel_tail_valid;
        cmp rax, 0;
        je  sench_rc_bad;
        lea r10, [rip + _sensor_channel_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp sench_rc_out;
      sench_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      sench_rc_out:
        pop r14;
        pop r13;
        pop r12;
        ret
