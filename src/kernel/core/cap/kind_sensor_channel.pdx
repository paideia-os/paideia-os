    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-001 (#1133): sensor_type of the subscription this capability names, or SENSOR_DECODE_BAD. ARITY ONE, pinned by tools/build.sh. A second parameter would be a caller-supplied type that widens or overrides the row's own. Labels prefixed sench_tos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call sensor_channel_row_of_slot;
