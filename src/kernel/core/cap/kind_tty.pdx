// src/kernel/core/cap/kind_tty.pdx -- R30-PREP (#1631)
//
// KIND_TTY = 0x197, derived over KIND_IPC_ENDPOINT (= 5).
//
// The runtime authority for ONE TTY sink -- a terminal instance that
// accepts byte writes and reports its row/column dimensions.  The
// substrate for the R49/R50 shell / cat / ls tools (design/tooling/
// r49-r50-plan.md §5) that must be handed a specific TTY to write
// output into rather than reaching global uart_putc directly.
//
// SUBSTRATE-PREP SCOPE.  This module lands the KIND, its mint gate,
// its rights, its row layout, its accessors, and its dispatch table
// -- everything a holder can EXPRESS.  It does NOT yet wire the write
// op through to tty_write (src/kernel/core/tty/write.pdx §41): the
// dispatch shape here does not carry a (buf, len) payload, and the
// syscall wire that pumps bytes from userspace through KIND_TTY into
// tty_write is a follow-up (R49.M1).  At this landing TTY_OP_WRITE
// records the acknowledgement (bytes_written++), returns 0, and does
// not touch a physical device.  A holder of KIND_TTY can therefore be
// minted, queried, and revoked; it cannot yet drive glyphs.
//
// Surfaced by ls.M2 (which had provisionally used 0x196 and collided
// with KIND_PDXFS_TXN), and by shell.M2 / cat.M2 (both of which need
// a TTY sink cap they can be handed at spawn time).  Allocating the
// ordinal here settles the collision and unblocks all three.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// A TTY sink is the client-side end of a conversation with the tty
// server (which owns the physical UART / framebuffer / seat).  Every
// client that wants to write to a TTY holds an endpoint cap resolvable
// via svc_lookup on the tty server's registered name (R20b service
// registry).  Deriving KIND_TTY over KIND_IPC_ENDPOINT lets the mint
// gate structurally refuse a TTY cap whose parent is not addressable
// at all -- there is no path to fabricate a TTY sink that talks to a
// server no capability currently names.
//
// This matches the shape KIND_ELEVATE_CHANNEL (0x191, R48b #1626)
// uses to derive over KIND_IPC_ENDPOINT for its client-broker
// conversation: RIGHT_MINT on the parent endpoint is NOT required
// because a client holds a plain endpoint (bidi) cap and the server's
// own mint gate is what confers authority to open a sink row.  The
// derivation gate here just refuses a sink whose parent is not
// addressable at all.
//
// KIND_DEVICE (10) was considered and rejected: shell / cat / ls run
// in userspace and do not hold device authority.  Deriving over
// KIND_DEVICE would move the mint gate off the shape the R49/R50
// tools can actually express.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (48 bytes, six u64 words -- same shape as every other
// derived-kind row in the tree for cost-of-consistency):
//
//   [+0]   header: in_use[63:56] | reserved[55:0]
//   [+8]   tty_id         (u64)   -- server-assigned; refused == 0 at mint
//   [+16]  rows           (u64)   -- screen height in text rows (1..TTY_ROWS_MAX)
//   [+24]  cols           (u64)   -- screen width  in text cols (1..TTY_COLS_MAX)
//   [+32]  bytes_written  (u64)   -- running total (kernel-side, bumped by WRITE
//                                    op ack).  Real byte throughput will be
//                                    populated by the R49.M1 write wire.
//   [+40]  reserved       (u64)   -- for future flags (mode bits, echo state)
//
// Row addressed capacity: 16 rows x 48 bytes = 768 bytes.  16 is a
// soft ceiling for the substrate-prep round -- enough to exercise the
// mint / query / revoke path plus the shell / cat / ls tool witnesses
// simultaneously.  A per-seat compositor round will re-shape when the
// pool of live TTY sinks is bounded by seat count.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// R_TTY_WRITE   (0x002) -- accept a write (substrate-prep: ack only)
// R_TTY_INVOKE  (0x008) -- query ops (rows, cols, id, bytes)
// R_TTY_REVOKE  (0x010) -- teardown the row
// R_TTY_MINT    (0x200) -- derive a narrower child (per-line, per-region;
//                          reserved for R49.M2 when the shell needs to
//                          hand a scoped sink to a subprocess)
// R_TTY_OBSERVE (0x400) -- debug printer
// R_TTY_ALL     (0x61A)
//
// R_MINT is PRESENT because the shell wants to spawn commands with a
// sink they own but the shell can revoke on exit -- classic seL4-shape
// linear-child-of-linear-parent, mirroring the derivation KIND_PDXFS_
// FILE (#1623) opens for snapshot-viewer children.
//
// R_TTY_READ is DELIBERATELY ABSENT: TTY input (keystrokes) travels
// through KIND_HID_EVENT (0x15c) subscriptions on a separate endpoint,
// not through this sink cap.  A future keyboard-echo path lives on the
// HID side, not the sink side.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEC30..0xFFFFEC3F
// =============================================================================
//
// Sixteen wide, disjoint from every previous R48b band:
//   KIND_ELEVATE_CHANNEL  0xFFFFEC00..0xFFFFEC0F
//   KIND_PDXFS_TXN        0xFFFFEC10..0xFFFFEC1F
//   KIND_PDXFS_FILE       0xFFFFEC20..0xFFFFEC2F
//   KIND_TTY              0xFFFFEC30..0xFFFFEC3F   (this file)

module KindTty = structure {

  pub let KIND_TTY      : u64 = 0x197
  pub let KIND_TTY_BASE : u64 = 5          // = KIND_IPC_ENDPOINT

  pub let R_TTY_WRITE   : u64 = 0x002
  pub let R_TTY_INVOKE  : u64 = 0x008
  pub let R_TTY_REVOKE  : u64 = 0x010
  pub let R_TTY_MINT    : u64 = 0x200
  pub let R_TTY_OBSERVE : u64 = 0x400
  pub let R_TTY_ALL     : u64 = 0x61A

  // Ops. Every op ARITY ONE -- op_arg high bits refused.
  pub let TTY_OP_WRITE       : u64 = 0
  pub let TTY_OP_QUERY_ROWS  : u64 = 1
  pub let TTY_OP_QUERY_COLS  : u64 = 2
  pub let TTY_OP_QUERY_ID    : u64 = 3
  pub let TTY_OP_QUERY_BYTES : u64 = 4
  pub let TTY_OP_DEBUG_PRINT : u64 = 5
  pub let TTY_OP_MAX         : u64 = 5

  pub let TTY_OK              : u64 = 0
  pub let TTY_TAIL_ENOSPC     : u64 = 0xFFFFEC3F
  pub let TTY_TAIL_BAD_ARG    : u64 = 0xFFFFEC3E
  pub let TTY_MINT_BAD_PARENT : u64 = 0xFFFFEC3D
  pub let TTY_MINT_BAD_RIGHTS : u64 = 0xFFFFEC3C
  pub let TTY_MINT_BAD_ID     : u64 = 0xFFFFEC3B
  pub let TTY_MINT_BAD_ROWS   : u64 = 0xFFFFEC3A
  pub let TTY_MINT_BAD_COLS   : u64 = 0xFFFFEC39
  pub let TTY_BAD_SLOT        : u64 = 0xFFFFEC38
  pub let TTY_WRONG_KIND      : u64 = 0xFFFFEC37
  pub let TTY_REVOKE_ALREADY  : u64 = 0xFFFFEC36

  pub let TTY_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TTY_ROW_NONE   : u64 = 0xFF

  // Ceilings.  4096 for both dimensions is well past every real
  // display panel (T14 G4's 2880x1800 in eight-column glyph cells
  // gives ~360 cols, ~112 rows); a nonsense value above this is
  // refused rather than silently accepted (same posture as PFF_LEN_
  // MAX in kind_pdxfs_file.pdx).
  pub let TTY_ROWS_MAX : u64 = 4096
  pub let TTY_COLS_MAX : u64 = 4096

  pub let TTY_MAX       : u64 = 16
  pub let TTY_ROW_BYTES : u64 = 48
  // 16 rows * 48 bytes = 768 bytes = 96 u64.
  pub let mut _tty_table : [u64; 96] = uninit @align(64)
  pub let mut _tty_stats : [u64; 8]  = uninit @align(64)

  pub let TTY_ST_MINTS   : u64 = 0
  pub let TTY_ST_REVOKES : u64 = 1
  pub let TTY_ST_QUERIES : u64 = 2
  pub let TTY_ST_REFUSED : u64 = 3
  pub let TTY_ST_WRITES  : u64 = 4
  pub let TTY_ST_MAX     : u64 = 8

  pub let tty_dbg_msg : [u8; 8] = "TTY ROW\0"

  // ==========================================================================
  // tty_table_reset() -> ()
  //
  // Clear every row and every counter.  Boot and teardown only.  Two
  // separate store runs mirror kind_pdxfs_file's pff_rs_ shape rather
  // than one loop over the sum: the two arrays have different lengths
  // and one loop over their total would encode their adjacency in .bss
  // as a fact the code depends on.
  // ==========================================================================
  pub let tty_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): clear every row and every counter. Boot and teardown only. Labels prefixed tty_rs_.",
      block: {
        lea r10, [rip + _tty_table];
        xor rax, rax;
        xor rcx, rcx;
      tty_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  tty_rs_rows;

        lea r10, [rip + _tty_stats];
        xor rcx, rcx;
      tty_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tty_rs_stats;
        ret
      }
    }

  pub let tty_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): bounded increment; out-of-range no-op. Labels prefixed tty_nt_.",
      block: {
        cmp rdi, 8;
        jae tty_nt_out;
        lea r10, [rip + _tty_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tty_nt_out:
        ret
      }
    }

  pub let tty_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): bounded read; out-of-range returns 0. Labels prefixed tty_st_.",
      block: {
        cmp rdi, 8;
        jae tty_st_zero;
        lea r10, [rip + _tty_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tty_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let tty_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30-PREP (#1631): subset test against R_TTY_ALL = 0x61A. Labels prefixed tty_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x61A;
        and rax, r10;
        cmp rax, rdi;
        jne tty_rv_no;
        mov rax, 1;
        ret;
      tty_rv_no:
        xor rax, rax;
        ret
      }
    }

  // rows_valid(rows) -> 1 iff rows in [1, TTY_ROWS_MAX]. Zero refused
  // (a TTY of zero rows is not a TTY).
  pub let tty_rows_valid : (u64) -> u64 !{} @{} =
    fn (rows: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30-PREP (#1631): 1 iff rows in [1, TTY_ROWS_MAX = 4096]. Labels prefixed tty_rowv_.",
      block: {
        cmp rdi, 1;
        jb  tty_rowv_no;
        mov r10, 4096;
        cmp rdi, r10;
        ja  tty_rowv_no;
        mov rax, 1;
        ret;
      tty_rowv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tty_cols_valid : (u64) -> u64 !{} @{} =
    fn (cols: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30-PREP (#1631): 1 iff cols in [1, TTY_COLS_MAX = 4096]. Labels prefixed tty_colv_.",
      block: {
        cmp rdi, 1;
        jb  tty_colv_no;
        mov r10, 4096;
        cmp rdi, r10;
        ja  tty_colv_no;
        mov rax, 1;
        ret;
      tty_colv_no:
        xor rax, rax;
        ret
      }
    }

  // Derivation gate. parent.kind == KIND_IPC_ENDPOINT (5). RIGHT_MINT
  // is NOT required on the parent -- mirrors KIND_ELEVATE_CHANNEL's
  // shape (kind_elevate_channel.pdx §elevate_channel_check_parent_
  // endpoint): a client of the tty server holds a plain endpoint
  // (bidi) cap and the server's own mint gate is what confers
  // authority to open a sink row; the derivation gate here just
  // refuses a sink whose parent is not addressable at all.
  pub let tty_check_parent_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30-PREP (#1631): derivation gate. parent.kind == KIND_IPC_ENDPOINT (5). RIGHT_MINT not required on parent -- see §0 and the elevate-channel precedent. Labels prefixed tty_cpe_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tty_cpe_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne tty_cpe_no;
        mov rax, 1;
        ret;

      tty_cpe_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | reserved[55:0].  Callers pack via
  // tty_hdr_pack(); today only the in_use flag is written and the low
  // 56 bits stay zero.
  pub let tty_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30-PREP (#1631): canonical header encoder. Returns 0; tail_alloc sets the in_use flag under the same write that claims the row. Kept as a callable to mirror the pdxfs_txn / pdxfs_file / elevate_channel shape so a later flag byte can be added without changing callers. Labels prefixed tty_hp_.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // tail_alloc(hdr, tty_id, rows, cols) -> row_id | TTY_TAIL_ENOSPC |
  //                                        TTY_TAIL_BAD_ARG | TTY_MINT_BAD_ID.
  //
  // bytes_written starts at 0 -- the WRITE op bumps it as invocations
  // land.  Reserved word starts at 0.
  pub let tty_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (tty_id: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): claim one TTY row. THE ONLY WRITER of _tty_table; tools/build.sh confines it. Gates: hdr in_use pre-set -> BAD_ARG; tty_id == 0 -> BAD_ID. Low-first scan over 16 rows. Six callee-save pushes leave rsp%16 == 0. Labels prefixed tty_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // tty_id
        mov r14, rdx;                    // rows
        mov r15, rcx;                    // cols

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne tty_ta_bad;

        cmp r13, 0;
        je  tty_ta_bad_id;

        xor rbx, rbx;
      tty_ta_scan:
        cmp rbx, 16;
        jae tty_ta_enospc;

        lea r10, [rip + _tty_table];
        mov r11, rbx;
        shl r11, 5;
        mov rax, rbx;
        shl rax, 4;
        add r11, rax;                    // row * 48
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tty_ta_claim;

        add rbx, 1;
        jmp tty_ta_scan;

      tty_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        xor rax, rax;
        mov [r10 + 32], rax;             // bytes_written = 0
        mov [r10 + 40], rax;             // reserved = 0
        mov rax, rbx;
        jmp tty_ta_out;

      tty_ta_enospc:
        mov rax, 0xFFFFEC3F;             // TTY_TAIL_ENOSPC
        jmp tty_ta_out;
      tty_ta_bad_id:
        mov rax, 0xFFFFEC3B;             // TTY_MINT_BAD_ID
        jmp tty_ta_out;
      tty_ta_bad:
        mov rax, 0xFFFFEC3E;             // TTY_TAIL_BAD_ARG

      tty_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tty_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): 1 iff row_id < TTY_MAX and in_use byte set. Labels prefixed tty_tv_.",
      block: {
        cmp rdi, 16;
        jae tty_tv_no;
        lea r10, [rip + _tty_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tty_tv_no;
        mov rax, 1;
        ret;
      tty_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tty_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): scrub row (all six words). Labels prefixed tty_tf_.",
      block: {
        cmp rdi, 16;
        jae tty_tf_out;
        lea r10, [rip + _tty_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      tty_tf_out:
        ret
      }
    }

  // Row accessors.  Each returns TTY_DECODE_BAD when the row is not
  // live.  Shape mirrors pdxfs_txn_row_* one-for-one.

  pub let tty_row_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): tty_id, or TTY_DECODE_BAD. Labels prefixed tty_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call tty_tail_valid;
        cmp rax, 0;
        je  tty_rid_bad;
        lea r10, [rip + _tty_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp tty_rid_out;
      tty_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tty_rid_out:
        pop r12;
        ret
      }
    }

  pub let tty_row_rows : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): rows, or TTY_DECODE_BAD. Labels prefixed tty_rrows_.",
      block: {
        push r12;
        mov r12, rdi;
        call tty_tail_valid;
        cmp rax, 0;
        je  tty_rrows_bad;
        lea r10, [rip + _tty_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp tty_rrows_out;
      tty_rrows_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tty_rrows_out:
        pop r12;
        ret
      }
    }

  pub let tty_row_cols : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): cols, or TTY_DECODE_BAD. Labels prefixed tty_rcols_.",
      block: {
        push r12;
        mov r12, rdi;
        call tty_tail_valid;
        cmp rax, 0;
        je  tty_rcols_bad;
        lea r10, [rip + _tty_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp tty_rcols_out;
      tty_rcols_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tty_rcols_out:
        pop r12;
        ret
      }
    }

  pub let tty_row_bytes : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): bytes_written, or TTY_DECODE_BAD. Labels prefixed tty_rbytes_.",
      block: {
        push r12;
        mov r12, rdi;
        call tty_tail_valid;
        cmp rax, 0;
        je  tty_rbytes_bad;
        lea r10, [rip + _tty_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp tty_rbytes_out;
      tty_rbytes_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tty_rbytes_out:
        pop r12;
        ret
      }
    }

  // Slot -> row_id, gated on the descriptor being a live KIND_TTY.
  // Kind constant 0x197 staged in r11 (fits imm32; no r11-imm64 issue).
  pub let tty_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30-PREP (#1631): slot -> row_id gated on KIND_TTY. Kind constant 0x197 staged in r11. Labels prefixed tty_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae tty_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x197;                  // KIND_TTY
        cmp r10, r11;
        jne tty_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call tty_tail_valid;
        cmp rax, 0;
        je  tty_ros_none;

        mov rax, r12;
        jmp tty_ros_out;

      tty_ros_none:
        mov rax, 0xFF;                   // TTY_ROW_NONE
      tty_ros_out:
        pop r12;
        ret
      }
    }

  // Internal: bump bytes_written on the row (used by WRITE op ack).
  // Bounds-checked; no-op if row is not live.  Kept internal to this
  // module -- the only writer of the row's bytes_written field is
  // cap_handler_tty on the WRITE branch.
  pub let tty_row_bytes_bump : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): bump bytes_written by 1 on a live row. No-op otherwise. Single callee-save push (r12) survives the tail_valid call; rsp%16 == 0 at that call site. Labels prefixed tty_bb_.",
      block: {
        push r12;
        mov r12, rdi;
        call tty_tail_valid;
        cmp rax, 0;
        je  tty_bb_out;
        lea r10, [rip + _tty_table];
        mov r11, r12;
        shl r11, 5;
        mov rax, r12;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
      tty_bb_out:
        pop r12;
        ret
      }
    }

  pub let tty_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30-PREP (#1631): scrub row + bump REVOKES; distinguishes never-existed (BAD_SLOT) from already-gone (REVOKE_ALREADY). Two callee-save pushes leave rsp%16 == 0. Labels prefixed tty_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae tty_cr_bad_slot;

        mov rdi, r12;
        call tty_tail_valid;
        cmp rax, 0;
        je  tty_cr_already;

        mov rdi, r12;
        call tty_tail_free;
        mov rdi, 1;                      // TTY_ST_REVOKES
        call tty_note;
        xor rax, rax;
        jmp tty_cr_out;

      tty_cr_bad_slot:
        mov rax, 0xFFFFEC38;             // TTY_BAD_SLOT
        jmp tty_cr_out;
      tty_cr_already:
        mov rax, 0xFFFFEC36;             // TTY_REVOKE_ALREADY

      tty_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // The KIND_TTY mint walker.  Gates in order:
  //   (1) parent gate (KIND_IPC_ENDPOINT);
  //   (2) rights subset;
  //   (3) rows_valid;
  //   (4) cols_valid;
  //   (5) hdr_pack (today: 0);
  //   (6) tail_alloc.
  // Six callee-save pushes leave rsp%16 == 0.
  pub let tty_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (tty_id: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30-PREP (#1631): the KIND_TTY mint walker. Sequences: (1) parent gate (KIND_IPC_ENDPOINT); (2) rights subset; (3) rows_valid; (4) cols_valid; (5) hdr_pack; (6) tail_alloc. Six callee-save pushes + sub rsp, 8 = 56 bytes: post-prologue rsp%16 == 0 for every nested call. Labels prefixed tty_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // tty_id
        mov r14, rcx;                    // rows
        mov r15, r8;                     // cols

        // (1) Parent gate.
        mov rdi, r12;
        call tty_check_parent_endpoint;
        cmp rax, 0;
        je  tty_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call tty_rights_valid;
        cmp rax, 0;
        je  tty_mi_bad_rights;

        // (3) rows_valid.
        mov rdi, r14;
        call tty_rows_valid;
        cmp rax, 0;
        je  tty_mi_bad_rows;

        // (4) cols_valid.
        mov rdi, r15;
        call tty_cols_valid;
        cmp rax, 0;
        je  tty_mi_bad_cols;

        // (5) Pack header (today: 0).
        call tty_hdr_pack;

        // (6) tail_alloc(hdr, tty_id, rows, cols).
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // tty_id
        mov rdx, r14;                    // rows
        mov rcx, r15;                    // cols
        call tty_tail_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae tty_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // TTY_ST_MINTS
        call tty_note;
        pop rax;
        jmp tty_mi_out;

      tty_mi_alloc_fail:
        jmp tty_mi_refused;
      tty_mi_bad_parent:
        mov rax, 0xFFFFEC3D;             // TTY_MINT_BAD_PARENT
        jmp tty_mi_refused;
      tty_mi_bad_rights:
        mov rax, 0xFFFFEC3C;             // TTY_MINT_BAD_RIGHTS
        jmp tty_mi_refused;
      tty_mi_bad_rows:
        mov rax, 0xFFFFEC3A;             // TTY_MINT_BAD_ROWS
        jmp tty_mi_refused;
      tty_mi_bad_cols:
        mov rax, 0xFFFFEC39;             // TTY_MINT_BAD_COLS

      tty_mi_refused:
        push rax;
        mov rdi, 3;                      // TTY_ST_REFUSED
        call tty_note;
        pop rax;

      tty_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // cap_handler_tty(rights, target_ptr, op_arg) -> u64
  //
  // KIND_TTY dispatch.
  //   op = op_arg & 0xFF; op_arg[63:8] REFUSED (arity-one on every op).
  //   TTY_OP_WRITE (0)         -> needs R_TTY_WRITE;   bumps bytes_written, ret 0
  //   TTY_OP_QUERY_ROWS (1)    -> needs R_TTY_INVOKE;  returns rows
  //   TTY_OP_QUERY_COLS (2)    -> needs R_TTY_INVOKE;  returns cols
  //   TTY_OP_QUERY_ID (3)      -> needs R_TTY_INVOKE;  returns tty_id
  //   TTY_OP_QUERY_BYTES (4)   -> needs R_TTY_INVOKE;  returns bytes_written
  //   TTY_OP_DEBUG_PRINT (5)   -> needs R_TTY_OBSERVE; returns 0
  pub let cap_handler_tty : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30-PREP (#1631): KIND_TTY dispatch. WRITE needs R_TTY_WRITE (0x002); query ops need R_TTY_INVOKE (0x008); DEBUG_PRINT needs R_TTY_OBSERVE (0x400). op_arg[63:8] refused. Five callee-save pushes leave rsp%16 == 0. Labels prefixed tty_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id (low 16)
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne tty_hn_res;                  // reserved bits set -> refuse

        cmp rbp, 5;                      // TTY_OP_MAX
        ja  tty_hn_unsup;

        // Branch out on op, checking the right rights bit for each.
        cmp rbp, 0;
        je  tty_hn_write;
        cmp rbp, 5;
        je  tty_hn_dbg;

        // Ops 1..4 need R_TTY_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  tty_hn_denied;

        mov rdi, r13;
        cmp rbp, 1;
        je  tty_hn_rows;
        cmp rbp, 2;
        je  tty_hn_cols;
        cmp rbp, 3;
        je  tty_hn_id;
        call tty_row_bytes;              // op == 4
        jmp tty_hn_count;

      tty_hn_rows:
        call tty_row_rows;
        jmp tty_hn_count;
      tty_hn_cols:
        call tty_row_cols;
        jmp tty_hn_count;
      tty_hn_id:
        call tty_row_id;
        jmp tty_hn_count;

      tty_hn_write:
        // Needs R_TTY_WRITE.
        mov r10, r12;
        and r10, 0x002;
        cmp r10, 0;
        je  tty_hn_denied;
        // Substrate-prep ack: bump bytes_written, count the write,
        // return 0.  The syscall wire that pumps a (buf, len) payload
        // through into tty_write lands at R49.M1.
        mov rdi, r13;
        call tty_row_bytes_bump;
        mov rdi, 4;                      // TTY_ST_WRITES
        call tty_note;
        xor rax, rax;
        jmp tty_hn_out;

      tty_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  tty_hn_denied;
        xor rax, rax;
        jmp tty_hn_out;

      tty_hn_count:
        push rax;
        mov rdi, 2;                      // TTY_ST_QUERIES
        call tty_note;
        pop rax;
        jmp tty_hn_out;

      tty_hn_res:
        mov rax, 0xFFFFEC3E;             // TTY_TAIL_BAD_ARG
        jmp tty_hn_out;
      tty_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp tty_hn_out;
      tty_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      tty_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
