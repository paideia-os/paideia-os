// src/kernel/core/cap/reconcile.pdx -- R90-XREPO.013.M0-001 (paideia-os
// #2129).
//
// Exec-time capability-reconciliation substrate.  Invoked by sys_execve's
// tail (in a future round; sys_execve wiring is gated on shell.ENH-032
// per design/round-retrospectives/r90-xrepo-wave3-plan.md §5) just
// BEFORE control transfers into the freshly-loaded image.  The reconciler
// takes the task's current (parent-inherited) cap set, intersects it
// against the declared caps.decl embedded in the new image (or read
// from /etc/caps/<toolname>.decl), and DROPS any cap the decl does not
// enumerate.  Also refuses the exec (-EACCES) if a decl-marked-mandatory
// cap is missing from the parent-inherited set.
//
// -----------------------------------------------------------------------------
// Scope of THIS landing (MVP)
// -----------------------------------------------------------------------------
//
// This is the ROUND M0 substrate landing.  The parser is stubbed --
// caps.decl format design lives in design/architecture/caps-decl-format.md
// (M1-001 sibling), and the real parser lands in a follow-up round once
// that design is ratified (M1-002 libpdx-cap client helper + M2-001 shell
// wire-in gate the full loop).  Concretely:
//
//   * cap_reconcile_at_exec accepts any well-formed non-zero caps.decl
//     buffer (>= 1 byte) and returns 0 (OK).
//   * A zero-length OR NULL caps.decl buffer is treated as "no decl
//     supplied" and also returns 0 (permissive-default at M0; the M2
//     shell wire-in will flip this to fail-closed once every tool has
//     landed its decl file).
//   * The task_ptr argument is validated only for non-zero-ness -- the
//     real cap-table walk lands with M0's follow-up.
//
// The function is CALLABLE from a boot witness (task_ptr=0 is accepted
// for the boot-context arm, matching cap_check_r_net_privileged_protocol's
// own two-arm gate).  A boot witness in a future round can:
//
//   1. Construct a synthetic caps.decl in .rodata.
//   2. Call cap_reconcile_at_exec(0, decl_pa, decl_len).
//   3. Assert rax == 0.
//   4. Emit `boot cap reconcile ok -- count=1`.
//
// -----------------------------------------------------------------------------
// Contract (SysV, 3 args)
// -----------------------------------------------------------------------------
//
// cap_reconcile_at_exec(task_ptr, caps_decl_pa, caps_decl_len) -> u64
//   rdi = task_ptr        TCB pointer for the exec'ing task, or 0 for
//                         boot / kernel-context callers.
//   rsi = caps_decl_pa    Kernel VA of the caps.decl byte buffer
//                         (embedded in the new image's .rodata OR
//                         copied into a kernel scratch page after the
//                         M2 shell wire-in).  0 means "no decl
//                         supplied" (permissive-default arm).
//   rdx = caps_decl_len   Length in bytes.  0 means "no decl supplied"
//                         (permissive-default arm), even if
//                         caps_decl_pa is non-zero.
//
//   -> rax = 0                        (OK -- reconciliation permitted)
//            0xFFFFFFFFFFFFFFF3       (-EACCES -- mandatory cap missing;
//                                       reserved sentinel, unreachable
//                                       in the M0 stub because no real
//                                       cap-table walk runs yet)
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `capr_` (CAPability Reconcile).  `loop`, `if` etc.
// are keywords and never used as labels.
//
// -----------------------------------------------------------------------------
// Frame prologue implicit
// -----------------------------------------------------------------------------

module Reconcile = structure {

  // ==========================================================================
  // Sentinels
  // ==========================================================================
  pub let CAP_RECONCILE_OK      : u64 = 0
  pub let CAP_RECONCILE_EACCES  : u64 = 0xFFFFFFFFFFFFFFF3   // -13

  // ==========================================================================
  // cap_reconcile_at_exec(task_ptr, caps_decl_pa, caps_decl_len) -> u64
  //
  // Register plan: leaf, no callee-save prologue.  rax/rcx caller-save
  // scratch only.
  //
  // Body: MVP stub -- accepts any well-formed input, returns 0.  The
  // real parser + cap-table narrow lands with the follow-up loop
  // (M1-001 design ratified, M1-002 libpdx-cap client helper lands its
  // format assertions, M2-001 shell wires the syscall in the exec tail).
  // ==========================================================================
  pub let cap_reconcile_at_exec : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (task_ptr: u64) (caps_decl_pa: u64) (caps_decl_len: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.013.M0-001 (paideia-os #2129): exec-time capability-reconciliation substrate, MVP stub landing.  Three-arg SysV shape (task_ptr, caps_decl_pa, caps_decl_len) matches the sys_execve tail's future call site per design/round-retrospectives/r90-xrepo-wave3-plan.md §5.  MVP body: accepts any well-formed input, returns CAP_RECONCILE_OK (0).  The parser + cap-table narrow is deliberately deferred to the follow-up round -- caps.decl format design lives in design/architecture/caps-decl-format.md (M1-001 sibling), and the M2-001 shell wire-in gates the full loop.  Two arms today: (Arm A) caps_decl_pa == 0 OR caps_decl_len == 0 -> permissive-default (rax=0).  This is the 'no decl supplied' path; will flip to fail-closed once every tool has landed its decl per the M4-* adoption waves.  (Arm B) both non-zero -> also returns 0 -- the real parse-and-narrow substitutes here in the follow-up.  task_ptr==0 is accepted (boot-context / kernel caller), matching cap_check_r_net_privileged_protocol's own boot-arm posture (core/cap/cap_net_privileged.pdx). CAP_RECONCILE_EACCES (0xFFFFFFFFFFFFFFF3 == -13) is reserved as the mandatory-cap-missing sentinel and is UNREACHABLE at this landing -- the sentinel exists so callers can compile their -EACCES branch against a stable name, and the substrate's fail-closed flip can happen without breaking every call site.  Leaf function: no push/pop, rax/rcx caller-save scratch only.  Encoder-conservative: cmp/je/mov/xor/ret only -- every form already proven at this exact shape in cap_net_privileged.pdx / cap_handler_blkdev.pdx.  Effects {mem} for a future cap-table load; capabilities {cap} matches every other cap-* helper's posture.  Labels prefixed capr_.",
      block: {
        // Arm A: permissive-default when no decl is supplied.
        cmp rsi, 0;
        je  capr_ok;                     // caps_decl_pa == 0
        cmp rdx, 0;
        je  capr_ok;                     // caps_decl_len == 0

        // Arm B: decl supplied.  MVP stub -- accept and return OK.
        // The follow-up round substitutes the real parse-and-narrow
        // here per design/architecture/caps-decl-format.md.  task_ptr
        // (rdi) is accepted at any value (0 for boot, non-zero for
        // ring-3 execs); the real walk lands with the follow-up.

      capr_ok:
        xor rax, rax;
        ret
      }
    }
}
