// src/kernel/core/cap/kind_inode_handle.pdx -- R52.M4-003 (#1699)
//
// KIND_INODE_HANDLE = 0x1A2, derived over KIND_PDXFS_FILE (= 0x195).
//
// The runtime authority for ONE short-lifetime, in-memory-cache-backed
// seat onto an inode row: given a live KIND_PDXFS_FILE cap (which
// already names an inode_no on some mounted volume), a caller with
// RIGHT_MINT on that file cap may mint a KIND_INODE_HANDLE that
// remembers where that inode currently sits in the volume's inode
// table (inode_lba, slot_in_block) plus a cache-generation counter
// (cached_gen) so repeated inode-table operations (inode_table.pdx,
// R52.M4-002 #1698) do not re-run the inode_no -> (inode_lba,
// slot_in_block) resolver (R52.M4-004 #1700) on every call.  This is
// the capability that wraps an inode row for higher-layer file access
// per design/filesystem/volume-fs-substrate.md §6.1's KIND allocation
// table.
//
// =============================================================================
// SECTION 0  WHY KIND_INODE_HANDLE DERIVES OVER KIND_PDXFS_FILE
// =============================================================================
//
// design/filesystem/volume-fs-substrate.md §6.1 names KIND_PDXFS_FILE
// (0x195) -- not the raw KIND_MEMORY (4) base that KIND_PDXFS_FILE
// itself derives over -- as this kind's base: "refinement of
// PDXFS_FILE with in-mem seat".  That is a narrower, and stricter,
// derivation gate than KIND_VOLUME / KIND_BLOCK_CACHE / KIND_SIG_KEY
// (which all derive straight from KIND_MEMORY, per the same table):
// a KIND_INODE_HANDLE cannot be minted from bare memory authority, it
// can only be minted by a caller who ALREADY holds a live
// KIND_PDXFS_FILE cap naming the specific inode this handle will
// cache.  A process cannot fabricate a handle onto an inode it has no
// file-level authority over.
//
// The runtime base slot the descriptor's LAM hint reads is still slot
// 4 (KIND_MEMORY = KIND_PAGE), the same base KIND_PDXFS_FILE itself
// uses -- KIND_INODE_HANDLE_BASE below records that.
// KIND_INODE_HANDLE_PARENT records the derivation-gate parent kind
// (0x195), which is the tighter, kind-specific check
// (inode_handle_check_parent_pdxfs_file) that this module actually
// enforces at mint time.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (32 bytes, four u64 words):
//
//   [+0]   header: in_use[63:56] | cached_gen[55:40] | slot_in_block[39:32]
//                  | vol_slot[31:0]
//   [+8]   inode_no   (u64)  -- the inode this handle caches
//   [+16]  inode_lba  (u64)  -- on-disk LBA of the inode-table block
//   [+24]  reserved   (u64)  -- zeroed at alloc; no field lives here yet
//
// All four small fields (cached_gen, slot_in_block, vol_slot, in_use)
// pack into word [+0] with no reserved bits left over (8 + 16 + 8 + 32
// = 64): there is nothing left to garbage-check beyond in_use at
// tail_alloc time, so the sanctioned door for producing a well-formed
// header is inode_handle_hdr_pack, which validates each sub-field's
// range before packing.  inode_no and inode_lba each need the full 64
// bits (an inode number or LBA can exceed 32 bits on a large volume)
// so they get their own words, matching the KIND_PDXFS_FILE /
// KIND_NVME_CONTROLLER discipline of "small fields share a word,
// wide fields get their own".
//
// Row-addressed capacity: 32 rows x 32 bytes = 1024 bytes.  32 is a
// soft ceiling for a short-lifetime handle type: the row is expected
// to live for one inode_table.pdx call chain, not for a file's whole
// open lifetime (that authority is KIND_PDXFS_FILE's job), so many
// concurrent handles are expected to cycle through a small working
// set. R53 can widen this table if profiling shows contention.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
//   R_INDH_READ     (0x001) -- read inode content through the handle
//   R_INDH_WRITE    (0x002) -- write inode content through the handle
//   R_INDH_INVOKE   (0x008) -- QUERY ops (vol_slot/inode_no/inode_lba/
//                              slot_in_block/cached_gen)
//   R_INDH_REVOKE   (0x010) -- teardown the row
//   R_INDH_REFRESH  (0x020) -- bump cached_gen after a re-read against
//                              the live in-memory inode cache
//   R_INDH_OBSERVE  (0x400) -- debug printer
//   R_INDH_ALL      (0x43B)
//
// No R_INDH_MINT: a KIND_INODE_HANDLE is already the narrow refinement
// of a KIND_PDXFS_FILE; it does not itself derive further children.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEC60..0xFFFFEC6F
// =============================================================================
//
// Sixteen wide, disjoint from every prior kind_*.pdx band:
//   KIND_ELEVATE_CHANNEL   0xFFFFEC00..0xFFFFEC0F
//   KIND_PDXFS_TXN         0xFFFFEC10..0xFFFFEC1F
//   KIND_PDXFS_FILE        0xFFFFEC20..0xFFFFEC2F
//   KIND_TTY                0xFFFFEC30..0xFFFFEC3F
//   KIND_NVME_CONTROLLER   0xFFFFEC40..0xFFFFEC4F
//   KIND_NVME_NAMESPACE    0xFFFFEC50..0xFFFFEC5F
//   KIND_INODE_HANDLE      0xFFFFEC60..0xFFFFEC6F   (this file)
//   KIND_AHCI_PORT (dual)  0xFFFFEC80..0xFFFFEC84, 0xFFFFEC90..0xFFFFEC98
//   KIND_AHCI_CONTROLLER   0xFFFFEC85..0xFFFFEC8F
//
// Note this module's own band (EC60..EC6F) is DISJOINT from the M4
// on-disk-substrate failure band (0xFFFFED18..0xFFFFED1F, owned by
// inode_table.pdx / sig_verify.pdx / the resolver per
// design/filesystem/r52-implementation-plan.md §4) -- this file is
// cap-primitives (mint/revoke/query), not the on-disk walker, so it
// gets its own EC-band slot rather than reusing the ED18..ED1F band.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
// Kind-tag constants in the 0x100..0xFFF band (0x195 = KIND_PDXFS_FILE,
// 0x1A2 = KIND_INODE_HANDLE) do not sign-extend cleanly from a 32-bit
// immediate for `cmp reg, imm` forms (see kind_pdxfs_file.pdx
// pdxfs_file_row_of_slot's note on 0x195); every compare against one
// of these two constants stages through r11 first.  No mov_b / mov_w /
// mov_d anywhere in this file -- every sub-field is packed/unpacked in
// full 64-bit registers via shift + mask, matching kind_nvme_
// controller.pdx's discipline (not kind_pdxfs_file.pdx's, which needed
// sized stores for a different reason not present here).  No `test`
// instruction; bit checks use `and` + `cmp`.  Labels prefixed `indh_`.
//
// =============================================================================
// SECTION 5  ARITY -- THE cap_mint_inner COLLAPSE
// =============================================================================
//
// A naive `inode_handle_cap_mint_inner(parent_slot, rights, vol_slot,
// inode_no, inode_lba, slot_in_block, cached_gen)` is SEVEN args --
// impossible (design/filesystem/r52-implementation-plan.md §5.1's
// arity <= 6 rule).  Design choice made up front, mirroring the
// row-pointer collapse the plan prescribes for inode_table.pdx: the
// caller packs the three small fields (vol_slot, slot_in_block,
// cached_gen) into one header word via the public
// inode_handle_hdr_pack export FIRST, then calls cap_mint_inner with
// the already-packed hdr.  That reduces cap_mint_inner to
// (parent_slot, rights, hdr, inode_no, inode_lba) = five args.

module KindInodeHandle = structure {

  pub let KIND_INODE_HANDLE        : u64 = 0x1A2
  pub let KIND_INODE_HANDLE_BASE   : u64 = 4       // = KIND_MEMORY (LAM-hint slot)
  pub let KIND_INODE_HANDLE_PARENT : u64 = 0x195   // = KIND_PDXFS_FILE (derivation gate)

  pub let R_INDH_READ    : u64 = 0x001
  pub let R_INDH_WRITE   : u64 = 0x002
  pub let R_INDH_INVOKE  : u64 = 0x008
  pub let R_INDH_REVOKE  : u64 = 0x010
  pub let R_INDH_REFRESH : u64 = 0x020
  pub let R_INDH_OBSERVE : u64 = 0x400
  pub let R_INDH_ALL     : u64 = 0x43B

  // Ops.  Every op ARITY ONE -- op_arg high bits refused (matches
  // KIND_PDXFS_FILE / KIND_NVME_CONTROLLER discipline).
  pub let IH_OP_QUERY_VOL_SLOT  : u64 = 0
  pub let IH_OP_QUERY_INODE_NO  : u64 = 1
  pub let IH_OP_QUERY_INODE_LBA : u64 = 2
  pub let IH_OP_QUERY_SLOT      : u64 = 3
  pub let IH_OP_QUERY_GEN       : u64 = 4
  pub let IH_OP_DEBUG_PRINT     : u64 = 5
  pub let IH_OP_MAX             : u64 = 5

  // Failure taxonomy.  0xFFFFEC60..0xFFFFEC6F, disjoint band (§3).
  pub let INDH_OK              : u64 = 0
  pub let INDH_TAIL_ENOSPC     : u64 = 0xFFFFEC6F
  pub let INDH_TAIL_BAD_ARG    : u64 = 0xFFFFEC6E
  pub let INDH_MINT_BAD_PARENT : u64 = 0xFFFFEC6D
  pub let INDH_MINT_BAD_RIGHTS : u64 = 0xFFFFEC6C
  pub let INDH_MINT_BAD_INODE  : u64 = 0xFFFFEC6B
  pub let INDH_MINT_BAD_LBA    : u64 = 0xFFFFEC6A
  pub let INDH_BAD_SLOT        : u64 = 0xFFFFEC69
  pub let INDH_WRONG_KIND      : u64 = 0xFFFFEC68
  pub let INDH_REVOKE_ALREADY  : u64 = 0xFFFFEC67
  pub let INDH_MINT_BAD_SLOTNO : u64 = 0xFFFFEC66
  pub let INDH_MINT_BAD_GEN    : u64 = 0xFFFFEC65

  pub let INDH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let INDH_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let INDH_MAX       : u64 = 32
  pub let INDH_ROW_BYTES : u64 = 32
  // 32 rows * 32 bytes = 1024 bytes = 128 u64.
  pub let mut _inode_handle_table : [u64; 128] = uninit @align(64)
  pub let mut _inode_handle_stats : [u64; 8]   = uninit @align(64)

  pub let INDH_ST_MINTS     : u64 = 0
  pub let INDH_ST_REVOKES   : u64 = 1
  pub let INDH_ST_QUERIES   : u64 = 2
  pub let INDH_ST_REFUSED   : u64 = 3
  pub let INDH_ST_REFRESHES : u64 = 4
  pub let INDH_ST_MAX       : u64 = 8

  pub let inode_handle_dbg_msg : [u8; 17] = "INODE HANDLE ROW\0"

  // ==========================================================================
  // inode_handle_table_reset() -> ()
  //
  // Clear every row and every counter.  Boot and teardown only.  Two
  // separate loops (rows / stats) mirror kind_pdxfs_file's / kind_
  // nvme_controller's shape: the arrays have different lengths and one
  // loop over their total would encode their .bss adjacency as a fact
  // code depends on.
  // ==========================================================================
  pub let inode_handle_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): clear every row and every counter. Boot and teardown only. Labels prefixed indh_rs_.",
      block: {
        lea r10, [rip + _inode_handle_table];
        xor rax, rax;
        xor rcx, rcx;
      indh_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  indh_rs_rows;

        lea r10, [rip + _inode_handle_stats];
        xor rcx, rcx;
      indh_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  indh_rs_stats;
        ret
      }
    }

  pub let inode_handle_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): bounded increment; out-of-range no-op. Labels prefixed indh_nt_.",
      block: {
        cmp rdi, 8;
        jae indh_nt_out;
        lea r10, [rip + _inode_handle_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      indh_nt_out:
        ret
      }
    }

  pub let inode_handle_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): bounded read; out-of-range returns 0. Labels prefixed indh_st_.",
      block: {
        cmp rdi, 8;
        jae indh_st_zero;
        lea r10, [rip + _inode_handle_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      indh_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let inode_handle_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M4-003 (#1699): subset test against R_INDH_ALL = 0x43B. Labels prefixed indh_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x43B;
        and rax, r10;
        cmp rax, rdi;
        jne indh_rv_no;
        mov rax, 1;
        ret;
      indh_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // inode_handle_check_parent_pdxfs_file(parent_slot) -> 1 | 0
  //
  // Derivation gate.  parent.kind == KIND_PDXFS_FILE (0x195) AND
  // rights carry RIGHT_MINT (0x200).  Per §0: a handle cannot be
  // minted from bare memory authority, only from a caller who already
  // holds a live KIND_PDXFS_FILE cap naming the inode this handle will
  // cache.  0x195 stages through r11 for the compare (§4 encoder-gap
  // posture).
  // ==========================================================================
  pub let inode_handle_check_parent_pdxfs_file : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M4-003 (#1699): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_PDXFS_FILE (0x195) AND (rights & RIGHT_MINT 0x200) != 0. Mirrors nvme_ctrl_check_parent_pci_dev / pdxfs_file_check_parent_memory; the parent kind here is itself a derived kind (0x195), not a base slot, so it is staged through r11 per §4's encoder-gap note. Pure read. Labels prefixed indh_cpp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae indh_cpp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x195;                  // KIND_PDXFS_FILE
        cmp r10, r11;
        jne indh_cpp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  indh_cpp_no;

        mov rax, 1;
        ret;

      indh_cpp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // inode_handle_hdr_pack(vol_slot, slot_in_block, cached_gen)
  //   -> hdr | INDH_DECODE_BAD
  //
  // Validates each sub-field's range before packing.  in_use (bits
  // [63:56]) MUST leave this function zero -- tail_alloc's claim path
  // sets it.  vol_slot must fit 32 bits; slot_in_block must be < 32
  // (32 inodes per 4KB inode-table block, design/filesystem/volume-fs-
  // substrate.md §2.3); cached_gen must fit 16 bits.
  // ==========================================================================
  pub let inode_handle_hdr_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (vol_slot: u64) (slot_in_block: u64) (cached_gen: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M4-003 (#1699): canonical header encoder. vol_slot fits [31:0], slot_in_block [39:32] (< 32), cached_gen [55:40] (< 0x10000). Bits [63:56] MUST leave this function zero -- that byte belongs to the allocator's in_use flag. Labels prefixed indh_hp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  indh_hp_bad;

        mov r10, 32;
        cmp rsi, r10;
        jae indh_hp_bad;

        mov r10, 0xFFFF;
        cmp rdx, r10;
        ja  indh_hp_bad;

        mov rax, rdi;                    // vol_slot in [31:0]
        mov r11, rsi;
        shl r11, 32;                     // slot_in_block in [39:32]
        or  rax, r11;
        mov r11, rdx;
        shl r11, 40;                     // cached_gen in [55:40]
        or  rax, r11;
        ret;

      indh_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // inode_handle_tail_alloc(hdr, inode_no, inode_lba) -> row_id | INDH_TAIL_*
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES AN INODE-HANDLE ROW;
  // tools/build.sh confines relocations against _inode_handle_table to
  // this object.  Gates: hdr in_use pre-set -> BAD_ARG; inode_no == 0
  // -> BAD_INODE (0 is the invalid-inode sentinel, design/filesystem/
  // volume-fs-substrate.md §2.3); inode_lba == 0 -> BAD_LBA (LBA 0 is
  // the superblock, never a valid inode-table block).  Low-first scan
  // over 32 rows of 32 bytes (power-of-2 stride: row_id << 5).  Four
  // callee-save pushes mirror nvme_ctrl_tail_alloc's shape.
  // ==========================================================================
  pub let inode_handle_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (inode_no: u64) (inode_lba: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): claim one inode-handle row. THE ONLY WRITER of _inode_handle_table; tools/build.sh confines it via ec_confine_one. Gates: hdr in_use pre-set -> INDH_TAIL_BAD_ARG; inode_no == 0 -> INDH_MINT_BAD_INODE; inode_lba == 0 -> INDH_MINT_BAD_LBA. Low-first scan over 32 rows of 32 bytes. Labels prefixed indh_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // inode_no
        mov r14, rdx;                    // inode_lba

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne indh_ta_bad;

        // inode_no non-zero.
        cmp r13, 0;
        je  indh_ta_bad_inode;

        // inode_lba non-zero.
        cmp r14, 0;
        je  indh_ta_bad_lba;

        xor rbx, rbx;                    // row_id
      indh_ta_scan:
        cmp rbx, 32;                     // INDH_MAX
        jae indh_ta_enospc;

        lea r10, [rip + _inode_handle_table];
        mov r11, rbx;
        shl r11, 5;                      // row * 32
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  indh_ta_claim;

        add rbx, 1;
        jmp indh_ta_scan;

      indh_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header + in_use
        mov [r10 + 8],  r13;             // inode_no
        mov [r10 + 16], r14;             // inode_lba
        xor rax, rax;
        mov [r10 + 24], rax;             // reserved = 0
        mov rax, rbx;
        jmp indh_ta_out;

      indh_ta_enospc:
        mov rax, 0xFFFFEC6F;             // INDH_TAIL_ENOSPC
        jmp indh_ta_out;
      indh_ta_bad_inode:
        mov rax, 0xFFFFEC6B;             // INDH_MINT_BAD_INODE
        jmp indh_ta_out;
      indh_ta_bad_lba:
        mov rax, 0xFFFFEC6A;             // INDH_MINT_BAD_LBA
        jmp indh_ta_out;
      indh_ta_bad:
        mov rax, 0xFFFFEC6E;             // INDH_TAIL_BAD_ARG

      indh_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let inode_handle_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): 1 iff row_id < INDH_MAX and in_use byte set. Labels prefixed indh_tv_.",
      block: {
        cmp rdi, 32;
        jae indh_tv_no;
        lea r10, [rip + _inode_handle_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  indh_tv_no;
        mov rax, 1;
        ret;
      indh_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let inode_handle_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): scrub row (all four words). Labels prefixed indh_tf_.",
      block: {
        cmp rdi, 32;
        jae indh_tf_out;
        lea r10, [rip + _inode_handle_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      indh_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors.  Each returns INDH_DECODE_BAD when the row is not
  // live.  Shape mirrors pdxfs_file_row_* / nvme_ctrl_row_* one-for-
  // one so a regression in one member of the family surfaces the same
  // way in the others.
  // -------------------------------------------------------------------

  pub let inode_handle_row_vol_slot : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): vol_slot (header bits [31:0]), or INDH_DECODE_BAD. Labels prefixed indh_rvs_.",
      block: {
        push r12;
        mov r12, rdi;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_rvs_bad;
        lea r10, [rip + _inode_handle_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        jmp indh_rvs_out;
      indh_rvs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      indh_rvs_out:
        pop r12;
        ret
      }
    }

  pub let inode_handle_row_inode_no : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): inode_no, or INDH_DECODE_BAD. Labels prefixed indh_rin_.",
      block: {
        push r12;
        mov r12, rdi;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_rin_bad;
        lea r10, [rip + _inode_handle_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp indh_rin_out;
      indh_rin_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      indh_rin_out:
        pop r12;
        ret
      }
    }

  pub let inode_handle_row_inode_lba : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): inode_lba, or INDH_DECODE_BAD. Labels prefixed indh_ril_.",
      block: {
        push r12;
        mov r12, rdi;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_ril_bad;
        lea r10, [rip + _inode_handle_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp indh_ril_out;
      indh_ril_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      indh_ril_out:
        pop r12;
        ret
      }
    }

  pub let inode_handle_row_slot_in_block : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): slot_in_block (header bits [39:32]), or INDH_DECODE_BAD. Labels prefixed indh_rsb_.",
      block: {
        push r12;
        mov r12, rdi;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_rsb_bad;
        lea r10, [rip + _inode_handle_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;
        mov r10, 0xFF;
        and rax, r10;
        jmp indh_rsb_out;
      indh_rsb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      indh_rsb_out:
        pop r12;
        ret
      }
    }

  pub let inode_handle_row_cached_gen : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): cached_gen (header bits [55:40]), or INDH_DECODE_BAD. Labels prefixed indh_rcg_.",
      block: {
        push r12;
        mov r12, rdi;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_rcg_bad;
        lea r10, [rip + _inode_handle_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 40;
        mov r10, 0xFFFF;
        and rax, r10;
        jmp indh_rcg_out;
      indh_rcg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      indh_rcg_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // inode_handle_row_cached_gen_set(row_id, new_gen) -> ()
  //
  // Internal mutator backing R_INDH_REFRESH: after inode_table.pdx
  // re-reads an inode against the live in-memory cache, it bumps this
  // handle's cached_gen so a stale reader can detect drift. new_gen
  // must fit 16 bits; out-of-range is a silent no-op (mirrors nvme_
  // ctrl_row_*_set's tail_valid-gated, no-op-on-bad-input discipline).
  // ==========================================================================
  pub let inode_handle_row_cached_gen_set : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (new_gen: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): stamp cached_gen (header bits [55:40]) on a live row. tail_valid gate; new_gen > 0xFFFF or dead row is a no-op. Two callee-save pushes mirror nvme_ctrl_row_admin_ctx_set. Labels prefixed indh_rcg_s_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov r10, 0xFFFF;
        cmp r13, r10;
        ja  indh_rcg_s_out;

        mov rdi, r12;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_rcg_s_out;

        lea r10, [rip + _inode_handle_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        mov r11, 0xFF0000FFFFFFFFFF;     // clear bits [55:40]
        and rax, r11;
        mov r11, r13;
        shl r11, 40;
        or  rax, r11;
        mov [r10 + 0], rax;

        push rax;
        mov rdi, 4;                      // INDH_ST_REFRESHES
        call inode_handle_note;
        pop rax;

      indh_rcg_s_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // Slot -> row_id, gated on the descriptor being a live
  // KIND_INODE_HANDLE.  Kind constant 0x1A2 staged in r11 (§4).
  pub let inode_handle_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M4-003 (#1699): slot -> row_id gated on KIND_INODE_HANDLE. THE ONLY ROUTE IN THE KERNEL FROM A CAP SLOT TO AN INODE-HANDLE ROW. Labels prefixed indh_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae indh_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1A2;                  // KIND_INODE_HANDLE
        cmp r10, r11;
        jne indh_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_ros_none;

        mov rax, r12;
        jmp indh_ros_out;

      indh_ros_none:
        mov rax, 0xFF;                   // INDH_ROW_NONE
      indh_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // inode_handle_cap_revoke(row_id) -> INDH_OK | INDH_BAD_SLOT | INDH_REVOKE_ALREADY
  // ==========================================================================
  pub let inode_handle_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M4-003 (#1699): scrub one row via inode_handle_tail_free and bump REVOKES. Refuses out-of-range with BAD_SLOT; refuses already-dead with REVOKE_ALREADY so the caller can distinguish 'never existed' from 'already gone'. Two callee-save pushes leave rsp%16 == 0. Labels prefixed indh_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 32;
        jae indh_cr_bad_slot;

        mov rdi, r12;
        call inode_handle_tail_valid;
        cmp rax, 0;
        je  indh_cr_already;

        mov rdi, r12;
        call inode_handle_tail_free;
        mov rdi, 1;                      // INDH_ST_REVOKES
        call inode_handle_note;
        xor rax, rax;                    // INDH_OK
        jmp indh_cr_out;

      indh_cr_bad_slot:
        mov rax, 0xFFFFEC69;             // INDH_BAD_SLOT
        jmp indh_cr_out;
      indh_cr_already:
        mov rax, 0xFFFFEC67;             // INDH_REVOKE_ALREADY

      indh_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // inode_handle_cap_mint_inner(parent_slot, rights, hdr, inode_no,
  //                             inode_lba) -> row_id | INDH_MINT_*
  //
  // §5: hdr is PRE-PACKED by the caller via inode_handle_hdr_pack --
  // this is the row-pointer-style arity collapse that keeps this
  // function at five args instead of the naive seven. Gate sequence:
  // (1) parent (KIND_PDXFS_FILE + RIGHT_MINT); (2) rights subset;
  // (3) tail_alloc (hdr, inode_no, inode_lba). Five callee-save pushes
  // + sub rsp, 8 = 48 bytes, mirroring nvme_ctrl_cap_mint_inner's
  // shape. Refusal paths bump INDH_ST_REFUSED.
  // ==========================================================================
  pub let inode_handle_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (hdr: u64) (inode_no: u64) (inode_lba: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M4-003 (#1699): the KIND_INODE_HANDLE mint walker. Gate sequence: parent (KIND_PDXFS_FILE + RIGHT_MINT), rights subset, tail_alloc (hdr, inode_no, inode_lba). Five callee-save pushes + sub rsp, 8 = 48 bytes: post-prologue rsp%16 == 0 for every nested call, mirroring nvme_ctrl_cap_mint_inner. Refusal paths bump INDH_ST_REFUSED. Labels prefixed indh_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // hdr
        mov r14, rcx;                    // inode_no
        mov r15, r8;                     // inode_lba

        // (1) Parent gate.
        mov rdi, r12;
        call inode_handle_check_parent_pdxfs_file;
        cmp rax, 0;
        je  indh_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call inode_handle_rights_valid;
        cmp rax, 0;
        je  indh_mi_bad_rights;

        // (3) tail_alloc (hdr, inode_no, inode_lba).
        mov rdi, rbx;
        mov rsi, r14;
        mov rdx, r15;
        call inode_handle_tail_alloc;
        mov r10, 32;                     // INDH_MAX
        cmp rax, r10;
        jae indh_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // INDH_ST_MINTS
        call inode_handle_note;
        pop rax;
        jmp indh_mi_out;

      indh_mi_alloc_fail:
        jmp indh_mi_refused;
      indh_mi_bad_parent:
        mov rax, 0xFFFFEC6D;             // INDH_MINT_BAD_PARENT
        jmp indh_mi_refused;
      indh_mi_bad_rights:
        mov rax, 0xFFFFEC6C;             // INDH_MINT_BAD_RIGHTS

      indh_mi_refused:
        push rax;
        mov rdi, 3;                      // INDH_ST_REFUSED
        call inode_handle_note;
        pop rax;

      indh_mi_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_inode_handle(rights, target_ptr, op_arg) -> ...
  //
  // Wired into cap_invoke_dispatch on `cmp rcx, 0x1A2; je call_kind_inode_handle`.
  // ==========================================================================
  pub let cap_handler_inode_handle : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M4-003 (#1699): KIND_INODE_HANDLE dispatch. RIGHTS TESTED PER OP -- QUERY_* need R_INDH_INVOKE; DEBUG_PRINT needs R_INDH_OBSERVE. op_arg[63:8] MUST be zero -- a smuggled second value on an op reaching an inode field is refused rather than masked. Labels prefixed indh_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id in low 16
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne indh_hn_res;

        cmp rbp, 5;                      // IH_OP_MAX
        ja  indh_hn_unsup;

        cmp rbp, 5;                      // DEBUG_PRINT?
        je  indh_hn_dbg;

        // Query ops need R_INDH_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  indh_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  indh_hn_vol_slot;
        cmp rbp, 1;
        je  indh_hn_inode_no;
        cmp rbp, 2;
        je  indh_hn_inode_lba;
        cmp rbp, 3;
        je  indh_hn_slot;
        call inode_handle_row_cached_gen;  // op == 4
        jmp indh_hn_count;

      indh_hn_vol_slot:
        call inode_handle_row_vol_slot;
        jmp indh_hn_count;
      indh_hn_inode_no:
        call inode_handle_row_inode_no;
        jmp indh_hn_count;
      indh_hn_inode_lba:
        call inode_handle_row_inode_lba;
        jmp indh_hn_count;
      indh_hn_slot:
        call inode_handle_row_slot_in_block;
        jmp indh_hn_count;

      indh_hn_count:
        push rax;
        mov rdi, 2;                      // INDH_ST_QUERIES
        call inode_handle_note;
        pop rax;
        jmp indh_hn_out;

      indh_hn_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_INDH_OBSERVE
        cmp r10, 0;
        je  indh_hn_denied;
        xor rax, rax;
        jmp indh_hn_out;

      indh_hn_res:
        mov rax, 0xFFFFEC6E;             // INDH_TAIL_BAD_ARG
        jmp indh_hn_out;
      indh_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp indh_hn_out;
      indh_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      indh_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
