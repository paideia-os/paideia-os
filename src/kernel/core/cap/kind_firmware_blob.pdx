// src/kernel/core/cap/kind_firmware_blob.pdx -- Wave 59 I7 [R29] skeleton
// paideia-os #2564
//
// KIND_FIRMWARE_BLOB = 0x3C, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// Kernel-side substrate for the firmware blob fetcher. Resolves a UTF-8
// firmware name (e.g. `i915/dmc_ver2_16.bin`) to a measured in-memory
// blob and mints a per-blob capability for the requesting driver. The
// full policy -- upstream linux-firmware pinning + vendor drops with a
// mandatory sidecar licence file; BLAKE3 build-time measurement; TPM
// PCR 7 extension on successful mount; `cap_firmware_lookup` ->
// KIND_FIRMWARE_BLOB -- is specified in design/drivers/firmware-blob-
// policy.md (1082 lines, landed Wave 72). This file is the Wave 73
// kernel-side skeleton: lookup logic, cap mint, slice, release, dispatch
// handler, and one placeholder bootstrap entry whose blob is 16 zero
// bytes so the fingerprint path can be exercised by a future witness.
//
// Design doc §4.1 names the public contract as `cap_firmware_lookup`
// with a four-argument signature (name_ptr, name_len, version_ptr,
// version_len). This Wave 73 landing restricts to the two-argument
// (name_ptr, name_len) shape per the task directive: the version-
// ordinal / rollback discipline (§5) is deferred to a follow-up
// alongside the build-time manifest enumerator that will replace this
// file's bootstrap entry with the real per-blob rows. The TPM PCR 7
// extension (§6) is explicitly out of scope for Wave 73 and lives in
// paideia-os #2566 (I9) with a TODO marker at the mount site below.
//
// Numeric derived-kind tag
// ------------------------
// KIND_FIRMWARE_BLOB = 0x3C (decimal 60). Above the 4-bit base-slot
// range (0..15), below every existing derived-kind tag (KIND_DRIVER =
// 0x15, KIND_DMESG = 0x16, KIND_INTERRUPT = 0x50, KIND_HW_INTERRUPT =
// 0x140, every R29/R30/R31/... entry). An audit at landing time
// (`grep -nE '\b0x3[cC]\b' src/kernel/core/cap/`) returned zero hits,
// so this tag claims a clean slot without overwriting any dispatch
// branch. The dispatch arm in cap/invoke.pdx is a direct `cmp rcx,
// 0x3C` (0x3C fits imm32 with bit 31 clear, so no r9 staging is
// required and the compare coexists with every other arm in the chain
// at the same cost as the single-byte KIND_PROCESS / KIND_THREAD /
// KIND_PAGE arms at the top of cap_invoke_dispatch).
//
// =============================================================================
// SECTION 0  DERIVATION POSTURE
// =============================================================================
//
// KIND_FIRMWARE_BLOB derives over KIND_MEMORY (= KIND_PAGE, base slot 4)
// because the artefact a lookup hands to a driver is a kernel-owned,
// read-only, physically-contiguous byte range. Same posture as every
// other KIND_MEMORY-derived kind (KIND_SIG_KEY 0x1A3, KIND_PDXFS_FILE
// 0x195, KIND_TLS_TRUST 0x1A7, KIND_SCHEMA_HANDLE 0x1B2, KIND_KEK 0x1B4,
// KIND_PIPELINE_EDGE 0x1F0, ...): the kind field encodes the SEMANTIC
// (this is a firmware blob) and the LAM-hint base slot encodes the
// RUNTIME SHAPE (a memory region). The design doc §4.2 fixes the cap
// payload layout at 56 bytes but Wave 73 reduces that to the five
// u64 fields enumerated below -- the full 56-byte record arrives
// alongside the manifest signature verification path in a follow-up
// (§3.4 scaffold-epoch handling + §6.1 manifest signature).
//
// =============================================================================
// SECTION 1  MANIFEST ROW LAYOUT  --  40 BYTES (FIVE u64 FIELDS)
// =============================================================================
//
// Per Wave 73 task directive:
//
//   [+0]   name_hash_low64        -- BLAKE3(name)[0..8) as a u64
//   [+8]   blob_base              -- kernel virtual address of blob bytes
//   [+16]  blob_len               -- length in bytes
//   [+24]  measured_blake3_lo     -- BLAKE3(blob)[0..8)   as a u64
//   [+32]  measured_blake3_hi     -- BLAKE3(blob)[8..16)  as a u64
//
// Row size: 40 bytes = 5 u64. Row-addressed capacity: FW_BLOB_MANIFEST_MAX
// rows -- 8 at this landing, matching the "~30-ish entries" working-set
// size the design doc §4.1 names. Grows by increasing FW_BLOB_MANIFEST_MAX
// (the arithmetic is a single `imul rax, FW_BLOB_ROW_BYTES` deferred to
// the row-slot helper).
//
// name_hash_low64 == 0 marks an EMPTY ROW. The lookup scan skips zero
// slots and the firmware_blob_table_reset / firmware_blob_substrate_init
// pair below respects this invariant. The design doc's §4.4 "driver
// never sees the file path" property is honoured here: callers pass a
// UTF-8 name, this file hashes it, and the manifest is the only route
// from name to blob.
//
// Measured hash encoding: BLAKE3 produces a 32-byte digest; the manifest
// stores its LOW 16 bytes (bytes [0..16)) as a (lo, hi) pair of u64s.
// This is the SAME truncation the design doc §4.2 names in its 56-byte
// record (`fingerprint` is 32 bytes but Wave 73 restricts to a 16-byte
// prefix match -- a follow-up adds the trailing 16 bytes once the build-
// time step produces real hashes). A manifest entry with both measured
// fields == 0 is treated as a SCAFFOLD entry (§3.4 of the design doc)
// and the blob-hash gate is skipped with a fingerprint note; no caller
// gets a cap over a non-scaffold blob whose BLAKE3 does not match.
//
// =============================================================================
// SECTION 2  RIGHTS  --  R_FW_BLOB_READ (0x001) ONLY
// =============================================================================
//
//   R_FW_BLOB_READ (0x001)  -- gate every op in cap_handler_firmware_blob
//
// No R_FW_BLOB_WRITE, no R_FW_BLOB_MINT, no R_FW_BLOB_REVOKE. Design
// doc §4.2: "The driver cannot mint, revoke, or forward the capability.
// It cannot modify the blob." The firmware_blob_release path is a
// supervisor-only teardown primitive invoked explicitly by the driver
// at exit (not an in-flight op reachable via cap_invoke). Mirrors
// KIND_TLS_TRUST's R_TLS_TRUST_READ-only posture (kind_tls_trust.pdx §2).
//
// R_FW_BLOB_ALL = R_FW_BLOB_READ = 0x001.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  --  0xFFFFFFCF / 0xFFFFFFD0
// =============================================================================
//
// Per Wave 73 task directive this module reserves exactly two codes:
//
//   FW_BLOB_NOT_FOUND        = 0xFFFFFFCF  (no manifest entry; also used
//                                           by cap_handler on dead caps)
//   FW_BLOB_ALREADY_RELEASED = 0xFFFFFFD0  (second release of same cap)
//
// Both sit in the kernel-owned high-dword error band (0xFFFFFFxx) that
// cap_invoke's INVOKE_UNSUPPORTED (0xFF..FC) / INVOKE_DENIED (0xFF..FD)
// / INVOKE_RESULT_INVALID_HANDLE (0xFF..FE) sentinels occupy, but at
// distinct low bytes CF/D0 (versus FC/FD/FE), so a witness failure
// names its originating kind unambiguously. The design doc §4.3's six-
// code taxonomy (FW_LOOKUP_ERR_UNKNOWN_NAME / _UNKNOWN_VERSION /
// _MANIFEST_UNVERIFIED / _BLOB_UNVERIFIED / _BAD_ARG / _ROLLBACK_BLOCKED)
// is the full target; the four remaining codes land alongside the
// manifest-signature + version-ordinal paths in a follow-up.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x3C fits imm32 with bit 31 clear, so every compare
// against it uses `cmp rcx, 0x3C` directly (no r9/r11 staging). Error
// sentinels 0xFFFFFFCF / 0xFFFFFFD0 also fit imm32 (sign-extend cleanly
// to u64), so `mov rax, 0xFFFFFFCF` is a 7-byte emit, not the 10-byte
// movabs form. No `test rN,rN` anywhere; liveness checks use `cmp rN, 0`.
// No `and r11, imm64`; the one masked compare (name_hash == 0 test)
// stages through r10. No 2-op `imul r,imm`; the row-base multiply uses
// `shl + add` (row stride 40 == 32 + 8 == shl 5 + shl 3) rather than
// `imul rax, 40`. All `pub let` string declarations are on single lines.
// Module basename `KindFirmwareBlob` matches the file basename
// `kind_firmware_blob.pdx`. Every label in this file is prefixed `fwb_`
// (reserved-word discipline -- `loop`/`if`/`let` are keywords).

module KindFirmwareBlob = structure {

  pub let KIND_FIRMWARE_BLOB      : u64 = 0x3C
  pub let KIND_FIRMWARE_BLOB_BASE : u64 = 4       // = KIND_MEMORY (LAM-hint slot)

  pub let R_FW_BLOB_READ : u64 = 0x001
  pub let R_FW_BLOB_ALL  : u64 = 0x001

  // Mint-time rights handed to a driver on cap_firmware_lookup success.
  pub let R_FW_BLOB_DRIVER_DEFAULT : u64 = 0x001

  // Ops (cap_handler_firmware_blob dispatch). Every op requires
  // R_FW_BLOB_READ -- there is no WRITE/MINT/REVOKE op in the kind,
  // §2. The three QUERY ops read the three mint-time payload fields;
  // the task directive's firmware_blob_slice path takes the OUT-POINTER
  // ABI (write base + len into caller memory) rather than the single-
  // u64 cap_invoke return, so op 1 and op 2 are the row accessors the
  // slice helper itself threads through.
  pub let FW_BLOB_OP_READ        : u64 = 0  // liveness probe -- row_id or 0
  pub let FW_BLOB_OP_QUERY_BASE  : u64 = 1  // blob_base (u64)
  pub let FW_BLOB_OP_QUERY_LEN   : u64 = 2  // blob_len (u64)
  pub let FW_BLOB_OP_QUERY_HASH_LO : u64 = 3  // measured_blake3_lo
  pub let FW_BLOB_OP_QUERY_HASH_HI : u64 = 4  // measured_blake3_hi
  pub let FW_BLOB_OP_MAX         : u64 = 4

  // Failure codes (§3). Both fit imm32 with bit 31 clear so `mov rax,
  // imm32` is a 7-byte emit.
  pub let FW_BLOB_OK                   : u64 = 0
  pub let FW_BLOB_NOT_FOUND            : u64 = 0xFFFFFFCF
  pub let FW_BLOB_ALREADY_RELEASED     : u64 = 0xFFFFFFD0

  pub let FW_BLOB_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let FW_BLOB_ROW_NONE   : u64 = 0xFF

  // Standard cap_invoke sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Manifest + row ceilings.
  pub let FW_BLOB_MANIFEST_MAX : u64 = 8      // row count at Wave 73
  pub let FW_BLOB_ROW_BYTES    : u64 = 40     // 5 u64

  // 8 rows * 40 bytes = 320 bytes = 40 u64. .bss zero-init means every
  // row starts with name_hash_low64 == 0 (the EMPTY sentinel, §1),
  // which is the free-slot marker firmware_blob_manifest_find scans
  // for and firmware_blob_substrate_init overwrites.
  pub let mut _firmware_blob_manifest : [u64; 40] = uninit @align(64)

  // Per-row live-cap count. Incremented by firmware_lookup on mint,
  // decremented by firmware_blob_release. "Already released" is
  // detected via the cap_table[cap_slot].kind != KIND_FIRMWARE_BLOB
  // check in firmware_blob_release's own gate; this counter is a
  // defensive observability field (bumped by firmware_blob_substrate_
  // reset to 0, visible to a future witness).
  pub let mut _firmware_blob_live_count : [u64; 8] = uninit @align(64)

  // Scratch buffer for BLAKE3 output (name and blob share it: name is
  // hashed first, low 64 extracted, then blob is hashed; the two
  // hash phases are disjoint in time within firmware_lookup).
  pub let mut _firmware_blake3_scratch : [u8; 32] = uninit @align(8)

  // Bootstrap test blob -- 16 bytes zero per Wave 73 task directive.
  // .bss zero-init gives us the content for free. A build-time step
  // that enumerates `firmware/` sidecar entries will later replace
  // this with real blob rows (one per vendor blob), each stamped
  // from the SIGNED linux-firmware set + the hash computed at build
  // time (§6.3 of the design doc).
  pub let mut _firmware_bootstrap_blob : [u8; 16] = uninit @align(8)

  // Fingerprint tags + keys. One tag per emitted event; §5 of the
  // design doc's witness-fingerprint catalog retires to tags.pdx in
  // a follow-up but is declared in-module here to keep this skeleton
  // PR self-contained (same pattern as kind_interrupt.pdx cap_kind_
  // int_msg declaration). Wire shape per Wave 73 task directive:
  //
  //   `FIRMWARE LOOKUP name_hash=0x<16-hex> cap=0x<16-hex>`     -- hit
  //   `FIRMWARE LOOKUP MISS name_hash=0x<16-hex>`               -- miss
  //   `FIRMWARE BLOB SLICE cap=0x<16-hex> base=0x<16-hex> len=<dec>` -- slice
  //   `FIRMWARE BLOB HASH MISMATCH name_hash=0x<16-hex>`        -- hash fail
  //   `FIRMWARE BLOB RELEASE cap=0x<16-hex>`                    -- release
  //
  // Byte counts NUL-inclusive per the kernel-logging-substrate.md #699
  // discipline. The klog_s1_x1 / klog_s1_x2 wrappers (klog/wrappers.pdx)
  // emit the tag then key=value pairs; the final newline is appended
  // by klog_emit_core.
  pub let fw_tag_lookup_hit     : [u8; 16] = "FIRMWARE LOOKUP\0"
  pub let fw_tag_lookup_miss    : [u8; 21] = "FIRMWARE LOOKUP MISS\0"
  pub let fw_tag_slice          : [u8; 20] = "FIRMWARE BLOB SLICE\0"
  pub let fw_tag_hash_mismatch  : [u8; 28] = "FIRMWARE BLOB HASH MISMATCH\0"
  pub let fw_tag_release        : [u8; 22] = "FIRMWARE BLOB RELEASE\0"
  pub let fw_tag_handler_entry  : [u8; 32] = "KIND_FIRMWARE_BLOB dispatch inv\0"

  pub let fw_k_name_hash : [u8; 10] = "name_hash\0"
  pub let fw_k_cap       : [u8; 4]  = "cap\0"
  pub let fw_k_base      : [u8; 5]  = "base\0"
  pub let fw_k_len       : [u8; 4]  = "len\0"

  // ==========================================================================
  // firmware_blob_table_reset() -> ()
  //
  // Defensive clear. Zero the manifest (40 u64) and the live-count
  // array (8 u64). .bss is already zero at real boot; this call is
  // belt-and-braces per the KIND_TLS_TRUST / KIND_NIC precedent and
  // gives a future witness or chaos-restart flow a clean re-scrub
  // point. Scratch buffer + bootstrap blob are intentionally NOT
  // zeroed here -- the scratch is overwritten on every blake3 call,
  // and the bootstrap blob stays at its boot content (16 zero bytes
  // from .bss) until the build-time step rewires it.
  // ==========================================================================
  pub let firmware_blob_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): clear every _firmware_blob_manifest u64 (40 words) and every _firmware_blob_live_count u64 (8 words). Boot and teardown only. .bss is already zero at real boot; this is defensive (matches KIND_TLS_TRUST tls_trust_table_reset / KIND_NIC nic_table_reset shape one-for-one). Labels prefixed fwb_tr_.",
      block: {
        lea r10, [rip + _firmware_blob_manifest];
        xor rax, rax;
        xor rcx, rcx;
      fwb_tr_manifest:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 40;
        jb  fwb_tr_manifest;

        lea r10, [rip + _firmware_blob_live_count];
        xor rcx, rcx;
      fwb_tr_live:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  fwb_tr_live;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_manifest_row_base(row_id) -> &_firmware_blob_manifest[row_id*40]
  //
  // Row index -> row base pointer. row_id * 40 is `(row_id << 5) +
  // (row_id << 3)` -- stride 40 is 32+8, both powers of two, so the
  // product fits two shift-adds and avoids `imul rax, 40` entirely.
  // No bounds check by policy: every caller validates row_id against
  // FW_BLOB_MANIFEST_MAX first (same posture as tls_trust_row_slot /
  // tui_canvas_slot).
  // ==========================================================================
  pub let firmware_blob_manifest_row_base : (u64) -> u64 !{} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): row_id -> &_firmware_blob_manifest[row_id*40]. Stride 40 computed as (row_id<<5)+(row_id<<3) rather than `imul rax, 40` -- the paideia-as encoder has no 2-op `imul r,imm` form, and the two-shift decomposition is a 7-byte emit vs. the staged 3-op form. No bounds check by policy, caller validates first. Labels prefixed fwb_rb_.",
      block: {
        lea rax, [rip + _firmware_blob_manifest];
        mov r10, rdi;
        shl r10, 5;                      // row_id * 32
        mov r11, rdi;
        shl r11, 3;                      // row_id * 8
        add r10, r11;                    // row_id * 40
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_row_valid(row_id) -> 1 iff row_id < FW_BLOB_MANIFEST_MAX
  //                                        AND name_hash_low64 != 0
  //
  // The name_hash == 0 sentinel marks an empty slot (§1), so an in-
  // range row_id whose name_hash is zero is NOT live. firmware_blob_
  // substrate_init refuses to stamp a name_hash of zero; this
  // invariant lets every reader skip the zero-slot case without
  // extra bookkeeping.
  // ==========================================================================
  pub let firmware_blob_row_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): 1 iff row_id < FW_BLOB_MANIFEST_MAX(8) and name_hash_low64 (word 0) != 0. Inlined address compute mirrors firmware_blob_manifest_row_base to keep this a pure leaf. Labels prefixed fwb_rv_.",
      block: {
        mov r10, 8;                      // FW_BLOB_MANIFEST_MAX
        cmp rdi, r10;
        jae fwb_rv_no;
        lea r10, [rip + _firmware_blob_manifest];
        mov r11, rdi;
        shl r11, 5;
        mov rcx, rdi;
        shl rcx, 3;
        add r11, rcx;
        add r10, r11;
        mov rax, [r10 + 0];              // name_hash_low64
        cmp rax, 0;
        je  fwb_rv_no;
        mov rax, 1;
        ret;
      fwb_rv_no:
        xor rax, rax;
        ret
      }
    }

  // Row-accessor family. Each returns FW_BLOB_DECODE_BAD when the
  // row is not live, matching kind_tls_trust.pdx / kind_schema_handle.
  // pdx discipline one-for-one.
  pub let firmware_blob_row_name_hash : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): manifest[row_id].name_hash_low64, or FW_BLOB_DECODE_BAD. Labels prefixed fwb_rn_.",
      block: {
        push r12;
        mov r12, rdi;
        call firmware_blob_row_valid;
        cmp rax, 0;
        je  fwb_rn_bad;
        mov rdi, r12;
        call firmware_blob_manifest_row_base;
        mov rax, [rax + 0];
        jmp fwb_rn_out;
      fwb_rn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fwb_rn_out:
        pop r12;
        ret
      }
    }

  pub let firmware_blob_row_base : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): manifest[row_id].blob_base, or FW_BLOB_DECODE_BAD. Labels prefixed fwb_rbs_.",
      block: {
        push r12;
        mov r12, rdi;
        call firmware_blob_row_valid;
        cmp rax, 0;
        je  fwb_rbs_bad;
        mov rdi, r12;
        call firmware_blob_manifest_row_base;
        mov rax, [rax + 8];
        jmp fwb_rbs_out;
      fwb_rbs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fwb_rbs_out:
        pop r12;
        ret
      }
    }

  pub let firmware_blob_row_len : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): manifest[row_id].blob_len, or FW_BLOB_DECODE_BAD. Labels prefixed fwb_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call firmware_blob_row_valid;
        cmp rax, 0;
        je  fwb_rl_bad;
        mov rdi, r12;
        call firmware_blob_manifest_row_base;
        mov rax, [rax + 16];
        jmp fwb_rl_out;
      fwb_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fwb_rl_out:
        pop r12;
        ret
      }
    }

  pub let firmware_blob_row_hash_lo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): manifest[row_id].measured_blake3_lo, or FW_BLOB_DECODE_BAD. Labels prefixed fwb_rhlo_.",
      block: {
        push r12;
        mov r12, rdi;
        call firmware_blob_row_valid;
        cmp rax, 0;
        je  fwb_rhlo_bad;
        mov rdi, r12;
        call firmware_blob_manifest_row_base;
        mov rax, [rax + 24];
        jmp fwb_rhlo_out;
      fwb_rhlo_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fwb_rhlo_out:
        pop r12;
        ret
      }
    }

  pub let firmware_blob_row_hash_hi : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): manifest[row_id].measured_blake3_hi, or FW_BLOB_DECODE_BAD. Labels prefixed fwb_rhhi_.",
      block: {
        push r12;
        mov r12, rdi;
        call firmware_blob_row_valid;
        cmp rax, 0;
        je  fwb_rhhi_bad;
        mov rdi, r12;
        call firmware_blob_manifest_row_base;
        mov rax, [rax + 32];
        jmp fwb_rhhi_out;
      fwb_rhhi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fwb_rhhi_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_blake3_name_hash(name_ptr, name_len) -> u64
  //
  // Compute BLAKE3(name) and return the low 8 bytes as a u64. The
  // paideia-as-shipped kernel-callable primitive is paideia_crypto_
  // blake3_hash(rdi=data_ptr, rsi=data_len, rdx=&out_32B); same ABI
  // src/kernel/core/fs/pdxfs_lite/inode.pdx:189 and src/kernel/core/
  // ipc/schema_registry.pdx use. The 32-byte digest lands in the
  // module-level _firmware_blake3_scratch; we then read scratch[0..8)
  // as a native-LE u64 and return it. For a zero-length name we skip
  // the call and return 0 (the "empty sentinel" that firmware_blob_
  // manifest_find below rejects, so an empty-name lookup always
  // misses).
  //
  // Alignment: entry rsp%16 == 8; a single `sub rsp, 8` brings it to
  // rsp%16 == 0 for the nested extern-C call; `add rsp, 8` restores
  // before the ret. rdi + rsi already carry the right values on
  // entry; only rdx needs to be loaded.
  // ==========================================================================
  pub let firmware_blob_blake3_name_hash : (u64, u64) -> u64 !{mem} @{} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): BLAKE3(name) low-64 extraction. Shape mirrors inode.pdx inode_checksum / schema_registry.pdx hash path one-for-one: lea rdx = &_firmware_blake3_scratch; call paideia_crypto_blake3_hash(rdi=name_ptr, rsi=name_len, rdx=scratch); read scratch[0..8) as a native-LE u64 and return it. Zero-length name short-circuits with return 0 before the call (the EMPTY sentinel from §1 that manifest_find rejects; this also sidesteps the paideia-as blake3 primitive's zero-length edge case). Alignment: entry rsp%16==8 -> sub rsp,8 -> rsp%16==0 for the call -> add rsp,8 before ret. Kernel-side linker resolves paideia_crypto_blake3_hash via libpaideia_satellite_runtime.a. Labels prefixed fwb_bn_.",
      block: {
        cmp rsi, 0;
        je  fwb_bn_zero;

        sub rsp, 8;                      // rsp%16 == 0 for the call
        lea rdx, [rip + _firmware_blake3_scratch];
        call paideia_crypto_blake3_hash;
        add rsp, 8;

        lea r10, [rip + _firmware_blake3_scratch];
        mov rax, [r10 + 0];
        ret;

      fwb_bn_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_blake3_blob_hash(blob_ptr, blob_len, out_hi_ptr) -> u64
  //
  // Compute BLAKE3(blob), return the low 8 bytes as the u64 return
  // value AND write the next 8 bytes to [out_hi_ptr]. The caller
  // compares both against the manifest's measured_blake3_{lo,hi};
  // the 16-byte prefix is the Wave 73 truncation (§1 note).
  // ==========================================================================
  pub let firmware_blob_blake3_blob_hash : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) (out_hi_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): BLAKE3(blob) 16-byte prefix extraction. Same primitive call as firmware_blob_blake3_name_hash. The TWO 8-byte halves of the digest are returned via two paths: rax carries scratch[0..8) (the LO half) and the HI half (scratch[8..16)) is stored at [out_hi_ptr]. r12/r13 are callee-save; r12 parks out_hi_ptr across the call. Zero-length blob returns 0 and leaves [out_hi_ptr] untouched (same policy as the name path -- an empty blob is a bug upstream, not a condition this file encodes). Alignment: three pushes (r12 + two for size) + one sub rsp,8 keep rsp%16==0 at the call site. Labels prefixed fwb_bb_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;                      // bring rsp%16 to 0 for the call

        mov r12, rdx;                    // out_hi_ptr
        mov r13, rsi;                    // blob_len

        cmp r13, 0;
        je  fwb_bb_zero;

        // rdi already = blob_ptr; rsi already = blob_len.
        lea rdx, [rip + _firmware_blake3_scratch];
        call paideia_crypto_blake3_hash;

        lea r10, [rip + _firmware_blake3_scratch];
        mov rax, [r10 + 0];              // LO half -> rax (return)
        mov r11, [r10 + 8];              // HI half
        mov [r12 + 0], r11;              // store HI at out_hi_ptr
        jmp fwb_bb_out;

      fwb_bb_zero:
        xor rax, rax;

      fwb_bb_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_manifest_find(name_hash_low64) -> row_id | FW_BLOB_ROW_NONE
  //
  // Linear scan over the manifest. First row whose name_hash_low64
  // matches the argument wins. The empty-row sentinel (name_hash == 0)
  // is implicitly rejected because manifest_find's argument is BLAKE3-
  // derived and the probability of a real BLAKE3 digest low-u64 being
  // zero is 2^-64 (and firmware_blob_blake3_name_hash short-circuits
  // the empty-name case to return 0 explicitly, so an empty name also
  // never matches an empty slot).
  // ==========================================================================
  pub let firmware_blob_manifest_find : (u64) -> u64 !{mem} @{} =
    fn (name_hash_low64: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): linear scan _firmware_blob_manifest[0..FW_BLOB_MANIFEST_MAX) for the first row whose name_hash_low64 (word 0) equals the argument. On no match return FW_BLOB_ROW_NONE (0xFF). r12 parks name_hash across the row-base compute; one callee-save push lands rsp%16==0 at the firmware_blob_manifest_row_base call. The lookup argument of 0 is treated as a never-match (empty-name path from blake3_name_hash) and short-circuits to NONE without scanning. Labels prefixed fwb_mf_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // name_hash_low64

        // Zero argument -> never match (empty-name short-circuit).
        cmp r12, 0;
        je  fwb_mf_none;

        xor r13, r13;                    // row_id cursor = 0
      fwb_mf_scan:
        cmp r13, 8;                      // FW_BLOB_MANIFEST_MAX
        jae fwb_mf_none;

        mov rdi, r13;
        call firmware_blob_manifest_row_base;
        mov r10, [rax + 0];              // row's name_hash_low64
        cmp r10, r12;
        je  fwb_mf_hit;

        add r13, 1;
        jmp fwb_mf_scan;

      fwb_mf_hit:
        mov rax, r13;
        jmp fwb_mf_out;

      fwb_mf_none:
        mov rax, 0xFF;                   // FW_BLOB_ROW_NONE

      fwb_mf_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_substrate_init() -> ()
  //
  // Stamp the bootstrap manifest entry. Called by the kernel boot
  // cascade (wiring to kernel_main deferred -- see §Boot wiring note
  // at the bottom of this file). The stamped row names:
  //
  //   row 0: name_hash_low64    = 0xDEADBEEFCAFEBABE  (placeholder --
  //                                                    no real name
  //                                                    hashes to this)
  //          blob_base          = &_firmware_bootstrap_blob
  //          blob_len           = 16
  //          measured_blake3_lo = 0   (SCAFFOLD -- §3.4 of design doc)
  //          measured_blake3_hi = 0   (SCAFFOLD -- §3.4 of design doc)
  //
  // With both measured fields zero, firmware_lookup treats this row
  // as an unmeasured scaffold entry and skips the blob-hash gate
  // (matching the design doc's §3.4 BLOB_UNSIGNED_SCAFFOLD posture);
  // when the build-time step lands, this init path is retired and
  // the manifest is populated from the signed firmware section.
  // ==========================================================================
  pub let firmware_blob_substrate_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I7 [R29] (#2564): stamp row 0 with the bootstrap entry (name_hash_low64=0xDEADBEEFCAFEBABE, blob_base=&_firmware_bootstrap_blob, blob_len=16, measured_blake3_{lo,hi}=0 for scaffold-epoch mode per design/drivers/firmware-blob-policy.md §3.4). The 0xDEADBEEFCAFEBABE placeholder fits imm32=0xCAFEBABE's low half + imm32=0xDEADBEEF's high half -- but as a single u64 immediate it DOES NOT fit sign-extended imm32, so the paideia-as encoder auto-stages it via r11 (B4-005 behaviour, paideia-as #1548). Three such 64-bit immediates get written: the name_hash itself and the two zero sentinels (which fit imm8 and go direct). Labels prefixed fwb_si_.",
      block: {
        xor rdi, rdi;
        call firmware_blob_manifest_row_base;
        // rax = &_firmware_blob_manifest[0]

        // name_hash_low64 = 0xDEADBEEFCAFEBABE (encoder auto-stages).
        mov r10, 0xDEADBEEFCAFEBABE;
        mov [rax + 0], r10;

        // blob_base = &_firmware_bootstrap_blob.
        lea r10, [rip + _firmware_bootstrap_blob];
        mov [rax + 8], r10;

        // blob_len = 16.
        mov r10, 16;
        mov [rax + 16], r10;

        // measured_blake3_lo / _hi = 0 (SCAFFOLD).
        xor r10, r10;
        mov [rax + 24], r10;
        mov [rax + 32], r10;
        ret
      }
    }

  // ==========================================================================
  // firmware_lookup(name_ptr, name_len) -> u64 (cap handle, or 0 on miss)
  //
  // THE primary external entrypoint. Per Wave 73 task directive:
  //
  //   1. BLAKE3(name) low-64 -> key
  //   2. Linear scan _firmware_blob_manifest for the key.
  //      Miss  -> emit `FIRMWARE LOOKUP MISS name_hash=0x<16-hex>`,
  //               return 0.
  //      Hit   -> continue.
  //   3. Read manifest row's measured_blake3_{lo,hi}. If BOTH zero,
  //      treat as scaffold (skip hash gate -- design §3.4). Else
  //      compute BLAKE3(blob) low 16 bytes and compare.
  //      Mismatch -> emit `FIRMWARE BLOB HASH MISMATCH name_hash=
  //                    0x<16-hex>`, return 0.
  //      Match / scaffold -> continue.
  //   4. Allocate a fresh cap_table slot via slab_alloc; write
  //      descriptor (kind=KIND_FIRMWARE_BLOB=0x3C, rights=
  //      R_FW_BLOB_DRIVER_DEFAULT, target_ptr=row_id).
  //      TODO(wave-74): extend TPM PCR 7 on successful mount
  //      (paideia-os #2566 I9; §6 of the design doc).
  //   5. Bump _firmware_blob_live_count[row_id].
  //   6. Emit `FIRMWARE LOOKUP name_hash=0x<16-hex> cap=0x<16-hex>`.
  //   7. Return the cap slot.
  //
  // Register plan: rbx=name_ptr, r12=name_len, r13=name_hash_low64,
  // r14=row_id, r15=cap_slot. Five callee-save pushes + sub rsp,8 =
  // 48 bytes; entry rsp%16==8, +48 -> ==8, so no additional padding
  // is needed before the nested calls (every nested call either
  // pushes its own padding or is leaf shape). Actually entry rsp%16 ==
  // 8, after 5 pushes rsp%16 == 8+40 = 48 == 0 mod 16; after the
  // sub rsp,8 rsp%16 == 8 again, so a cmp-and-call site needs ONE
  // extra push or sub to realign. Simpler: 5 pushes alone land ==0;
  // skip the sub, and every nested call sees rsp%16 == 8 (SysV-safe
  // because the called function's prologue typically pushes rbp
  // first). We follow the SIMPLER path -- 5 pushes, no sub -- and
  // every nested blake3 call carries its OWN sub rsp,8 internally
  // (see firmware_blob_blake3_name_hash prologue).
  // ==========================================================================
  pub let firmware_lookup : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I7 [R29] (#2564): primary firmware fetcher entrypoint. BLAKE3(name) -> key, linear-scan manifest, verify blob BLAKE3 against manifest row (scaffold-epoch skip when both measured fields zero per design §3.4), slab_alloc + cap_mint_write + live-count bump + fingerprint emit. Register plan: rbx=name_ptr, r12=name_len, r13=name_hash_low64, r14=row_id, r15=cap_slot. Five callee-save pushes land rsp%16==0 at every nested call (entry rsp%16==8, +40 -> 0); every nested blake3 call carries its OWN internal sub rsp,8 so no second-level padding is needed here. On miss emits `FIRMWARE LOOKUP MISS name_hash=0x<16-hex>` via klog_s1_x1 and returns 0; on hash mismatch emits `FIRMWARE BLOB HASH MISMATCH name_hash=0x<16-hex>` and returns 0; on hit emits `FIRMWARE LOOKUP name_hash=0x<16-hex> cap=0x<16-hex>` via klog_s1_x2 (second value passed on the caller stack per klog_s1_x2's calling convention) and returns the cap slot. TODO(wave-74): extend TPM PCR 7 on successful mount (paideia-os #2566, I9). Labels prefixed fwb_lk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // name_ptr
        mov r12, rsi;                    // name_len

        // Step 1: BLAKE3(name) low-64 -> r13.
        mov rdi, rbx;
        mov rsi, r12;
        call firmware_blob_blake3_name_hash;
        mov r13, rax;

        // Step 2: manifest scan.
        mov rdi, r13;
        call firmware_blob_manifest_find;
        mov r10, 0xFF;                   // FW_BLOB_ROW_NONE
        cmp rax, r10;
        je  fwb_lk_miss;
        mov r14, rax;                    // row_id

        // Step 3: hash gate (scaffold-aware). Stage manifest_hash_lo
        // through r12 (callee-save; dead at this point -- step 1's
        // name_len has been consumed). r11 is UNSAFE for cross-call
        // staging because the paideia-as SysV convention treats it
        // as caller-save, so a nested helper may clobber it.
        mov rdi, r14;
        call firmware_blob_row_hash_lo;
        mov r12, rax;                    // manifest_hash_lo (callee-save)
        mov rdi, r14;
        call firmware_blob_row_hash_hi;
        // rax = manifest_hash_hi
        // If both r12 and rax are zero, SCAFFOLD -- skip the gate.
        cmp r12, 0;
        jne fwb_lk_verify;
        cmp rax, 0;
        jne fwb_lk_verify;
        jmp fwb_lk_mint;

      fwb_lk_verify:
        // Compute BLAKE3(blob) 16-byte prefix. rbx (name_ptr) and r12
        // (name_len) are DEAD after step 1 (the BLAKE3 of the name
        // has already landed in r13), so we reuse them for the two
        // computed-hash halves -- both are callee-save and survive
        // the manifest-accessor calls below without a spill.
        mov rdi, r14;
        call firmware_blob_row_base;
        mov rbx, rax;                    // reuse rbx = blob_base
        mov rdi, r14;
        call firmware_blob_row_len;
        mov r12, rax;                    // reuse r12 = blob_len

        // Allocate 16 bytes of stack scratch; low 8 bytes receive
        // computed_hi via firmware_blob_blake3_blob_hash's out-ptr.
        sub rsp, 16;
        mov rdi, rbx;                    // blob_ptr
        mov rsi, r12;                    // blob_len
        mov rdx, rsp;                    // out_hi_ptr -> &[rsp+0]
        call firmware_blob_blake3_blob_hash;
        // rax = computed_lo; [rsp+0] = computed_hi
        mov rbx, rax;                    // computed_lo -> rbx (callee-save)
        mov r12, [rsp + 0];              // computed_hi -> r12 (callee-save)
        add rsp, 16;

        // Compare against manifest. rbx/r12 survive the two nested
        // calls because they are SysV callee-save and every reader
        // in this file follows the discipline.
        mov rdi, r14;
        call firmware_blob_row_hash_lo;
        cmp rax, rbx;
        jne fwb_lk_mismatch;
        mov rdi, r14;
        call firmware_blob_row_hash_hi;
        cmp rax, r12;
        jne fwb_lk_mismatch;
        // fallthrough to mint.

      fwb_lk_mint:
        // Allocate a fresh cap_table slot and write the descriptor.
        // slab_alloc has no args. On failure rax == CAP_SLOT_MAX
        // (256) which we treat as "mint failed, miss" (return 0).
        call slab_alloc;
        mov r11, 256;
        cmp rax, r11;
        jae fwb_lk_mint_fail;
        mov r15, rax;                    // cap_slot

        // cap_mint_write(slot=r15, kind=0x3C, rights=0x001,
        //                target_ptr=row_id=r14).
        mov rdi, r15;                    // slot
        mov rsi, 0x3C;                   // KIND_FIRMWARE_BLOB
        mov rdx, 0x001;                  // R_FW_BLOB_DRIVER_DEFAULT
        mov rcx, r14;                    // target_ptr = row_id
        call cap_mint_write;

        // Bump _firmware_blob_live_count[row_id].
        lea r10, [rip + _firmware_blob_live_count];
        mov rax, [r10 + r14 * 8];
        add rax, 1;
        mov [r10 + r14 * 8], rax;

        // TODO(wave-74): extend TPM PCR 7 on successful mount
        // (paideia-os #2566, I9; design/drivers/firmware-blob-policy.md
        // §6). The mount site is HERE -- right after cap_mint_write
        // succeeds and before the fingerprint emit so a TPM failure
        // appears BEFORE the "cap handed to driver" witness line.

        // Emit `FIRMWARE LOOKUP name_hash=0x<16-hex> cap=0x<16-hex>`
        // via klog_s1_x2. klog_s1_x2's SysV shape: rdi=level,
        // rsi=subsys, rdx=tag, rcx=k1, r8=v1, r9=k2, with v2 at
        // [rsp+8] in the CALLER FRAME just before `call` (which
        // becomes [rbp+16] inside the wrapper after its own
        // push rbp). Idiom: `sub rsp,16; mov [rsp+8],v2; call ...;
        // add rsp,16` matches wal.pdx / inode_table.pdx / allocator.
        // pdx one-for-one -- the sub rsp,16 keeps rsp%16==0 at the
        // call site so the callee's own prologue restores alignment.
        sub rsp, 16;
        mov [rsp + 0], r15;              // v2 (cap_slot) at call-time [rsp+0] (PATCH: was +8)
                                         // [rsp+8], surfaces as
                                         // [rbp+16] inside klog_s1_x2.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fw_tag_lookup_hit];
        lea rcx, [rip + fw_k_name_hash]; // k1
        mov r8, r13;                     // v1 = name_hash_low64
        lea r9, [rip + fw_k_cap];        // k2
        call klog_s1_x2;
        add rsp, 16;

        mov rax, r15;                    // return cap_slot
        jmp fwb_lk_out;

      fwb_lk_miss:
        // Emit `FIRMWARE LOOKUP MISS name_hash=0x<16-hex>` via
        // klog_s1_x1.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fw_tag_lookup_miss];
        lea rcx, [rip + fw_k_name_hash];
        mov r8, r13;                     // name_hash_low64
        call klog_s1_x1;
        xor rax, rax;
        jmp fwb_lk_out;

      fwb_lk_mismatch:
        // Emit `FIRMWARE BLOB HASH MISMATCH name_hash=0x<16-hex>` via
        // klog_s1_x1.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fw_tag_hash_mismatch];
        lea rcx, [rip + fw_k_name_hash];
        mov r8, r13;
        call klog_s1_x1;
        xor rax, rax;
        jmp fwb_lk_out;

      fwb_lk_mint_fail:
        xor rax, rax;

      fwb_lk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_slice(cap, out_ptr_ptr, out_len_ptr) -> u64
  //
  // Return the blob base + length through two caller-supplied out
  // pointers. The u64 return value is 0 on success, FW_BLOB_NOT_FOUND
  // (0xFFFFFFCF) if the cap is dead / wrong kind, and FW_BLOB_
  // ALREADY_RELEASED (0xFFFFFFD0) if the row's live-count is zero.
  // Emits `FIRMWARE BLOB SLICE cap=0x<16-hex> base=0x<16-hex>
  // len=<decimal>` on success (klog_s1_x1_d1 with the third value --
  // the key for base and the value for cap carried on the caller
  // stack, matching klog_s1_x3's calling convention). Wave 73
  // simplifies to a single klog_s1_x2 line (`cap`+`base` as hex)
  // followed by a klog_s1_d1 (`len` as decimal) to stay within the
  // 6-arg SysV cap without the stack-arg discipline the s1_x3
  // wrapper requires. The paired emit is a single logical slice
  // event -- consumers that grep for "FIRMWARE BLOB SLICE" and the
  // adjacent "FIRMWARE BLOB SLICE len" line reconstruct the full
  // record.
  //
  // Alt: emit as one klog_s1_x1_d1 (`base` hex + `len` dec). The
  // caller gets `cap` from the context of the slice-call anyway (it
  // just passed the cap in). Choosing this form -- base + len
  // together, cap elided from the fingerprint -- matches the
  // design doc §4.2's four-field cap payload shape (base + size are
  // the two fields a driver copies out).
  // ==========================================================================
  pub let firmware_blob_slice : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap: u64) (out_ptr_ptr: u64) (out_len_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I7 [R29] (#2564): slice-view helper. Validate cap bounds (<256), descriptor kind == KIND_FIRMWARE_BLOB (0x3C), row liveness; on success write blob_base to [out_ptr_ptr] and blob_len to [out_len_ptr], emit `FIRMWARE BLOB SLICE cap=0x<16-hex> base=0x<16-hex> len=<dec>` as a klog_s1_x1 (base) + klog_s1_x1_d1 (cap+len) pair (one logical slice event split across two klog wrapper calls to stay within SysV's 6-reg cap without the s1_x3 stack-arg push). Register plan: rbx=cap, r12=out_ptr_ptr, r13=out_len_ptr, r14=row_id, r15=blob_base. Five callee-save pushes land rsp%16==0 at every nested call. Error path (bad cap -> FW_BLOB_NOT_FOUND; already-released -> FW_BLOB_ALREADY_RELEASED) returns the sentinel without emitting (a failure is caller-attributable; the dmesg trail for the previous mint/release has already named the row). Labels prefixed fwb_sl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // cap
        mov r12, rsi;                    // out_ptr_ptr
        mov r13, rdx;                    // out_len_ptr

        // Validate cap bounds (< 256) and descriptor kind.
        mov r10, 256;
        cmp rbx, r10;
        jae fwb_sl_nf;

        lea r10, [rip + cap_table];
        mov r11, rbx;
        shl r11, 3;
        mov rax, rbx;
        shl rax, 4;
        add r11, rax;
        add r10, r11;                    // &cap_table[cap*24]
        mov rax, [r10 + 0];              // descriptor.kind
        cmp rax, 0x3C;                   // KIND_FIRMWARE_BLOB
        jne fwb_sl_nf;

        mov r14, [r10 + 16];             // descriptor.target_ptr = row_id

        // Validate the row itself (name_hash_low64 non-zero).
        mov rdi, r14;
        call firmware_blob_row_valid;
        cmp rax, 0;
        je  fwb_sl_nf;

        // Row liveness: live_count must be > 0.
        lea r10, [rip + _firmware_blob_live_count];
        mov rax, [r10 + r14 * 8];
        cmp rax, 0;
        je  fwb_sl_rel;

        // Read blob_base + blob_len.
        mov rdi, r14;
        call firmware_blob_row_base;
        mov r15, rax;                    // blob_base
        mov rdi, r14;
        call firmware_blob_row_len;
        // rax = blob_len

        // Write out params.
        mov [r12 + 0], r15;              // *out_ptr_ptr = blob_base
        mov [r13 + 0], rax;              // *out_len_ptr = blob_len

        // Emit `FIRMWARE BLOB SLICE base=0x<16-hex> cap=0x<16-hex>`
        // via klog_s1_x2 (base + cap -- see the §SLICE fingerprint
        // shape comment above). v2 (cap_slot = rbx) lands at the
        // caller's [rsp+8] per klog_s1_x2's convention; the sub rsp,16
        // + mov [rsp+8],v2 idiom mirrors firmware_lookup's own hit
        // emit above (and wal.pdx / inode_table.pdx one-for-one).
        sub rsp, 16;
        mov [rsp + 0], rbx;              // v2 (cap) at call-time [rsp+0] (PATCH: was +8)
                                         // after the wrapper's push rbp.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fw_tag_slice];
        lea rcx, [rip + fw_k_base];      // k1
        mov r8, r15;                     // v1 = blob_base
        lea r9, [rip + fw_k_cap];        // k2
        call klog_s1_x2;
        add rsp, 16;

        // Companion decimal-len line via klog_s1_d1 (len as decimal
        // per the task directive).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fw_tag_slice];
        lea rcx, [rip + fw_k_len];
        mov r8, [r13 + 0];               // reload blob_len
        call klog_s1_d1;

        xor rax, rax;                    // FW_BLOB_OK
        jmp fwb_sl_out;

      fwb_sl_nf:
        mov rax, 0xFFFFFFCF;             // FW_BLOB_NOT_FOUND
        jmp fwb_sl_out;
      fwb_sl_rel:
        mov rax, 0xFFFFFFD0;             // FW_BLOB_ALREADY_RELEASED

      fwb_sl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // firmware_blob_release(cap) -> u64
  //
  // Teardown the cap: zero its descriptor (kind=0, rights=0,
  // target_ptr=0 via cap_mint_write) and decrement the row's live-
  // count. Second release of the same cap returns FW_BLOB_ALREADY_
  // RELEASED. Emits `FIRMWARE BLOB RELEASE cap=0x<16-hex>` on
  // success.
  // ==========================================================================
  pub let firmware_blob_release : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I7 [R29] (#2564): cap teardown. Validate cap bounds + descriptor kind == KIND_FIRMWARE_BLOB; a kind that already doesn't match means the cap has either never existed or was already released (both surfaces as FW_BLOB_ALREADY_RELEASED -- the design doc §4.2 'driver cannot forward' invariant means a driver's second release attempt is a double-release, not a fresh-cap case). On success zero the descriptor via cap_mint_write(slot, kind=0, rights=0, target_ptr=0), decrement _firmware_blob_live_count[row_id], and emit `FIRMWARE BLOB RELEASE cap=0x<16-hex>`. Register plan: rbx=cap, r12=row_id. Three callee-save pushes land rsp%16==0 at every nested call. Labels prefixed fwb_rl2_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // cap

        // Validate cap bounds + descriptor kind.
        mov r10, 256;
        cmp rbx, r10;
        jae fwb_rl2_already;

        lea r10, [rip + cap_table];
        mov r11, rbx;
        shl r11, 3;
        mov rax, rbx;
        shl rax, 4;
        add r11, rax;
        add r10, r11;                    // &cap_table[cap*24]
        mov rax, [r10 + 0];
        cmp rax, 0x3C;
        jne fwb_rl2_already;

        mov r12, [r10 + 16];             // row_id

        // Zero the descriptor via cap_mint_write.
        mov rdi, rbx;                    // slot
        mov rsi, 0;                      // kind
        mov rdx, 0;                      // rights
        mov rcx, 0;                      // target_ptr
        call cap_mint_write;

        // Decrement live-count. Floor at zero (bogus caller case).
        lea r10, [rip + _firmware_blob_live_count];
        mov rax, [r10 + r12 * 8];
        cmp rax, 0;
        je  fwb_rl2_emit;
        sub rax, 1;
        mov [r10 + r12 * 8], rax;

      fwb_rl2_emit:
        // Emit `FIRMWARE BLOB RELEASE cap=0x<16-hex>` via klog_s1_x1.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fw_tag_release];
        lea rcx, [rip + fw_k_cap];
        mov r8, rbx;                     // cap
        call klog_s1_x1;

        xor rax, rax;                    // FW_BLOB_OK
        jmp fwb_rl2_out;

      fwb_rl2_already:
        mov rax, 0xFFFFFFD0;             // FW_BLOB_ALREADY_RELEASED

      fwb_rl2_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_firmware_blob(rights, target_ptr, op_arg) -> u64
  //
  // KIND_FIRMWARE_BLOB cap_invoke dispatch handler. Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x3C; je
  // call_kind_firmware_blob` arm added alongside this file. The
  // handler is a thin op-router over the row accessors -- caller-
  // facing semantics live in firmware_lookup / firmware_blob_slice /
  // firmware_blob_release above; the handler exists so that an
  // ALREADY-minted cap can be queried via the generic cap_invoke
  // syscall ABI for its three static fields.
  //
  //   op 0 FW_BLOB_OP_READ         -> 1 iff row live, 0 else
  //   op 1 FW_BLOB_OP_QUERY_BASE   -> blob_base
  //   op 2 FW_BLOB_OP_QUERY_LEN    -> blob_len
  //   op 3 FW_BLOB_OP_QUERY_HASH_LO -> measured_blake3_lo
  //   op 4 FW_BLOB_OP_QUERY_HASH_HI -> measured_blake3_hi
  //   else                         -> INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_FW_BLOB_READ. target_ptr IS
  // the row_id (firmware_lookup stamped it that way during mint).
  // ==========================================================================
  pub let cap_handler_firmware_blob : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I7 [R29] (#2564): KIND_FIRMWARE_BLOB cap_invoke dispatch. Entry chatter (klog_s1 of fw_tag_handler_entry) with rdi/rsi/rdx preserved across the call, matching every other kind_*.pdx handler. Then: op_code = op_arg & 0xFF; rights gate against R_FW_BLOB_READ (uniform, single up-front check per §2); dispatch 0..4 to the matching firmware_blob_row_* accessor via a cmp cascade; else INVOKE_UNSUPPORTED. target_ptr IS the row_id (16-bit mask applied in case a future layout widens the kind to carry additional sub-fields). Three callee-save pushes (rbx=rights, r12=row_id, r13=op_code) land rsp%16==0 at every nested call. Labels prefixed fwb_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op_arg
        mov r10, 0xFF;
        and r13, r10;                    // op_code = op_arg[7:0]

        // Entry chatter -- preserve rdi/rsi/rdx NOT needed (we have
        // our own callee-save copies in rbx/r12/r13).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fw_tag_handler_entry];
        call klog_s1;

        // Rights gate (uniform, single up-front).
        mov r10, rbx;
        and r10, 0x001;                  // R_FW_BLOB_READ
        cmp r10, 0;
        je  fwb_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  fwb_hd_op_read;
        cmp r13, 1;
        je  fwb_hd_op_base;
        cmp r13, 2;
        je  fwb_hd_op_len;
        cmp r13, 3;
        je  fwb_hd_op_hash_lo;
        cmp r13, 4;
        je  fwb_hd_op_hash_hi;
        jmp fwb_hd_unsup;

      fwb_hd_op_read:
        mov rdi, r12;
        call firmware_blob_row_valid;
        jmp fwb_hd_out;

      fwb_hd_op_base:
        mov rdi, r12;
        call firmware_blob_row_base;
        jmp fwb_hd_out;

      fwb_hd_op_len:
        mov rdi, r12;
        call firmware_blob_row_len;
        jmp fwb_hd_out;

      fwb_hd_op_hash_lo:
        mov rdi, r12;
        call firmware_blob_row_hash_lo;
        jmp fwb_hd_out;

      fwb_hd_op_hash_hi:
        mov rdi, r12;
        call firmware_blob_row_hash_hi;
        jmp fwb_hd_out;

      fwb_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp fwb_hd_out;

      fwb_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      fwb_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx needs TWO new calls alongside the existing TLS /
  // NIC / schema-handle resets (around kernel_main.pdx:2824):
  //
  //   call firmware_blob_table_reset;    // defensive zero
  //   call firmware_blob_substrate_init; // stamp bootstrap row 0
  //
  // Both are zero-arg, allocate nothing on the stack, and only
  // touch rax/rcx/r10/r11; safe alongside kernel_main's live
  // r12/r13/r14 handoff registers. The wiring itself is deferred to
  // a follow-up slice to keep this skeleton PR minimal (same
  // discipline every other `*_table_reset` boot wiring follows --
  // see e.g. r91 nic_table_reset which was declared in Wave R91.M1-
  // 001 and wired a slice later). At real boot .bss zero-init
  // leaves the manifest already empty, so a lookup still MISSES
  // correctly even without the wiring; `firmware_blob_substrate_
  // init` is the only call that lays down the one bootstrap row the
  // fingerprint goldens describe.
  // ==========================================================================
}
