  // ==========================================================================
  // kgctx_row_transition(row_id, new_state) — the ONE MUTATOR of the state
  // field.  LRC-init moves NEW -> ACTIVE at engine bind; revoke moves to
  // DYING.  Any other transition (e.g. ACTIVE -> NEW) is refused.
  // ==========================================================================

  pub let kgctx_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): mutate state field on one row. Only forward FSM edges are legal: NEW->ACTIVE, NEW->DYING, ACTIVE->DYING. Labels prefixed kgctx_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kgctx_tail_valid;
        cmp rax, 0;
        je  kgctx_rt_bad;

        mov rdi, r13;
        call kgctx_state_valid;
        cmp rax, 0;
        je  kgctx_rt_bad;

        lea r10, [rip + _gpu_ctx_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        and rax, 0xFF;

        // Legal edges: (0,1), (0,2), (1,2).  Anything else refused.
        cmp rax, 0;
        je  kgctx_rt_from0;
        cmp rax, 1;
        je  kgctx_rt_from1;
        jmp kgctx_rt_bad;
      kgctx_rt_from0:
        cmp r13, 0;
        je  kgctx_rt_bad;
        jmp kgctx_rt_apply;
      kgctx_rt_from1:
        cmp r13, 2;
        jne kgctx_rt_bad;

      kgctx_rt_apply:
        // Rewrite body2 state[23:16] preserving engine[7:0] priority[15:8]
        // and linear_flag[31:24].
        mov rax, [r10 + 24];
        mov r11, 0xFF0000;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 16;
        or  rax, r11;
        mov [r10 + 24], rax;

        mov rdi, 2;                      // TRANSITIONS
        call kgctx_note;
        xor rax, rax;
        jmp kgctx_rt_out;

      kgctx_rt_bad:
        mov rax, 0xFFFFF5A1;             // BAD_TRANSITION
      kgctx_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kgctx_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (ctx_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): live row holding ctx_key, or ROW_NONE. Refuses to match 0. Labels prefixed kgctx_fk_.",
      block: {
        cmp rdi, 0;
        je  kgctx_fk_none;
        xor rcx, rcx;
      kgctx_fk_scan:
        cmp rcx, 8;
        jae kgctx_fk_none;
        lea r10, [rip + _gpu_ctx_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgctx_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kgctx_fk_hit;
      kgctx_fk_next:
        add rcx, 1;
        jmp kgctx_fk_scan;
      kgctx_fk_hit:
        mov rax, rcx;
        ret;
      kgctx_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let kgctx_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): slot -> row_id, gated on live KIND_GPU_CONTEXT. Labels prefixed kgctx_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kgctx_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x176;
        cmp r10, r11;
        jne kgctx_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kgctx_tail_valid;
        cmp rax, 0;
        je  kgctx_ros_none;

        mov rax, r12;
        jmp kgctx_ros_out;

      kgctx_ros_none:
        mov rax, 0xFF;
      kgctx_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Five args (slot, parent_slot, rights, ctx_key, packed_evp_vm).
  //
  //   packed_evp_vm encoding:
  //     [7:0]    engine_id
  //     [15:8]   priority
  //     [31:16]  vm_slot
  //     [63:32]  reserved (must be zero)
  //
  //  Packing keeps the ABI within the paideia-as SysV pass ceiling.
  // ==========================================================================

  pub let gpu_ctx_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (ctx_key: u64) (packed_evp_vm: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): mint KIND_GPU_CONTEXT over KIND_IPC_ENDPOINT. LINEAR -- rights & R_MINT is EXPLICITLY refused (KGCTX_MINT_REFUSED_MINT) BEFORE the subset check. Sequence: slot<256; explicit R_MINT refuse; check_parent; rights_valid; unpack engine/priority/vm_slot; kgctx_engine_valid; kgctx_priority_valid; kgctx_check_vm; ctx_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed kgctx_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // ctx_key
        mov rbp, r8;                     // packed_evp_vm

        mov r10, 256;
        cmp rbx, r10;
        jae kgctx_mi_bad_slot;

        // LINEAR explicit gate (§3): rights & R_MINT must be zero.
        mov r10, r13;
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        jne kgctx_mi_refused_mint;

        mov rdi, r12;
        call kgctx_check_parent;
        cmp rax, 0;
        je  kgctx_mi_bad_parent;

        mov rdi, r13;
        call kgctx_rights_valid;
        cmp rax, 0;
        je  kgctx_mi_bad_rights;

        // Unpack engine_id, priority, vm_slot.
        mov r10, rbp;
        and r10, 0xFF;                   // engine_id
        mov rdi, r10;
        call kgctx_engine_valid;
        cmp rax, 0;
        je  kgctx_mi_bad_engine;

        mov r10, rbp;
        shr r10, 8;
        and r10, 0xFF;                   // priority
        mov rdi, r10;
        call kgctx_priority_valid;
        cmp rax, 0;
        je  kgctx_mi_bad_state;

        mov r10, rbp;
        shr r10, 16;
        and r10, 0xFFFF;                 // vm_slot
        mov r15, r10;                    // stash vm_slot
        mov rdi, r15;
        call kgctx_check_vm;
        cmp rax, 0;
        je  kgctx_mi_bad_vm;

        cmp r14, 0;
        je  kgctx_mi_no_key;

        mov rdi, r14;
        call kgctx_find_by_key;
        cmp rax, 0xFF;
        jne kgctx_mi_in_use;

        // Body1 pack: (endpoint_slot=parent_slot, vm_slot).
        mov rdi, r12;
        mov rsi, r15;
        call kgctx_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgctx_mi_bad_state;
        push rax;                        // body1 on stack
        sub rsp, 8;

        // Body2 pack: (engine_id, priority, state=NEW).
        mov r10, rbp;
        and r10, 0xFF;
        mov rdi, r10;
        mov r10, rbp;
        shr r10, 8;
        and r10, 0xFF;
        mov rsi, r10;
        mov rdx, 0;                      // state = NEW
        call kgctx_body2_pack;
        add rsp, 8;
        pop r11;                         // body1 back into r11
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgctx_mi_bad_state;
        push rax;                        // body2 on stack
        push r11;                        // body1 on stack

        // Header.
        mov rdi, r12;
        call kgctx_hdr_pack;
        pop r11;                         // body1
        pop r15;                         // body2 (reuse r15 -- vm_slot no longer needed)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgctx_mi_bad_parent;

        // tail_alloc(hdr, ctx_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call kgctx_tail_alloc;

        mov r10, 0xFFFFF5AF;
        cmp rax, r10;
        je  kgctx_mi_enospc;
        mov r10, 0xFFFFF5AE;
        cmp rax, r10;
        je  kgctx_mi_bad_state;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x176;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kgctx_note;

        xor rax, rax;
        jmp kgctx_mi_out;

      kgctx_mi_bad_slot:
        mov rax, 0xFFFFF5A4;
        jmp kgctx_mi_out;
      kgctx_mi_refused_mint:
        mov rdi, 3;
        call kgctx_note;
        mov rax, 0xFFFFF5A0;
        jmp kgctx_mi_out;
      kgctx_mi_bad_parent:
        mov rax, 0xFFFFF5AD;
        jmp kgctx_mi_out;
      kgctx_mi_bad_rights:
        mov rax, 0xFFFFF5AC;
        jmp kgctx_mi_out;
      kgctx_mi_bad_vm:
        mov rax, 0xFFFFF5AB;
        jmp kgctx_mi_out;
      kgctx_mi_bad_engine:
        mov rax, 0xFFFFF5AA;
        jmp kgctx_mi_out;
      kgctx_mi_bad_state:
        mov rax, 0xFFFFF5A9;
        jmp kgctx_mi_out;
      kgctx_mi_no_endpoint:
        mov rax, 0xFFFFF5A8;
        jmp kgctx_mi_out;
      kgctx_mi_no_key:
        mov rax, 0xFFFFF5A7;
        jmp kgctx_mi_out;
      kgctx_mi_in_use:
        mov rdi, 3;
        call kgctx_note;
        mov rax, 0xFFFFF5A5;
        jmp kgctx_mi_out;
      kgctx_mi_enospc:
        mov rdi, 3;
        call kgctx_note;
        mov rax, 0xFFFFF5A6;

      kgctx_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_ctx_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (ctx_key: u64) (packed_evp_vm: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call gpu_ctx_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x176;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.  Advances state to DYING before scrubbing so consumers that
  // observe the row mid-revoke see the drain marker.
  // ==========================================================================

  pub let gpu_ctx_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): revoke KIND_GPU_CONTEXT. Labels prefixed kgctx_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kgctx_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kgctx_rvk_already;

        mov r11, 0x176;
        cmp r10, r11;
        jne kgctx_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kgctx_tail_valid;
        cmp rax, 0;
        je  kgctx_rvk_clear;

        // Advance to DYING (ignore transition failure -- may already be
        // DYING if a prior revoke raced to the row).
        mov rdi, r13;
        mov rsi, 2;                      // DYING
        call kgctx_row_transition;

        mov rdi, r13;
        call kgctx_tail_free;

      kgctx_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kgctx_note;

        xor rax, rax;
        jmp kgctx_rvk_out;

      kgctx_rvk_bad_slot:
        mov rax, 0xFFFFF5A4;
        jmp kgctx_rvk_out;
      kgctx_rvk_wrong_kind:
        mov rax, 0xFFFFF5A3;
        jmp kgctx_rvk_out;
      kgctx_rvk_already:
        mov rax, 0xFFFFF5A2;

      kgctx_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_ctx_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call gpu_ctx_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x176;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_gpu_context : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): KIND_GPU_CONTEXT dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kgctx_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_gpu_context_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kgctx_hn_res;

        cmp rbp, 7;
        ja  kgctx_hn_unsup;

        cmp rbp, 7;
        je  kgctx_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kgctx_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kgctx_hn_key;
        cmp rbp, 1;
        je  kgctx_hn_ep;
        cmp rbp, 2;
        je  kgctx_hn_vm;
        cmp rbp, 3;
        je  kgctx_hn_en;
        cmp rbp, 4;
        je  kgctx_hn_pr;
        cmp rbp, 5;
        je  kgctx_hn_st;
        call kgctx_row_linear;
        jmp kgctx_hn_out;

      kgctx_hn_key:
        call kgctx_row_key;
        jmp kgctx_hn_out;
      kgctx_hn_ep:
        call kgctx_row_endpoint;
        jmp kgctx_hn_out;
      kgctx_hn_vm:
        call kgctx_row_vm;
        jmp kgctx_hn_out;
      kgctx_hn_en:
        call kgctx_row_engine;
        jmp kgctx_hn_out;
      kgctx_hn_pr:
        call kgctx_row_priority;
        jmp kgctx_hn_out;
      kgctx_hn_st:
        call kgctx_row_state;
        jmp kgctx_hn_out;

      kgctx_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kgctx_hn_denied;
        xor rax, rax;
        jmp kgctx_hn_out;

      kgctx_hn_res:
        mov rax, 0xFFFFF5AE;
        jmp kgctx_hn_out;
      kgctx_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kgctx_hn_out;
      kgctx_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kgctx_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
