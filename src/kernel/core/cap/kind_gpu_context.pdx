// src/kernel/core/cap/kind_gpu_context.pdx — R37.M5-001 (#1272)
//
// KIND_GPU_CONTEXT = 0x176, derived over KIND_IPC_ENDPOINT (5).  LINEAR.
//
// One GPU submission context: a ctx_key naming the context, the
// KIND_IPC_ENDPOINT the client drives the context over, the KIND_GPU_VM
// slot that supplies the address space, the engine class the context
// binds to (render / blitter / video), a priority ordinal, an FSM
// state, and a LINEAR flag frozen at 1.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// Every GPU submission needs a context on a specific engine that names
// the address space its commands walk against.  Without a capability
// naming that context, a caller could:
//
//   (1) Retarget an in-flight context to a different VM ("VM swap"):
//       vm_slot is frozen at mint and there is no op on this kind that
//       mutates it.
//   (2) Reclassify a render context as a blitter context to bypass an
//       engine-specific policy ("engine forge"): engine_id is frozen at
//       mint and there is no op that mutates it.
//   (3) Duplicate a live context to run the same LRC on two rings
//       concurrently ("LRC clone"): LINEAR discipline -- R_MINT is
//       ABSENT from R_GPU_CTX_ALL and the mint gate ALSO refuses R_MINT
//       explicitly (§3 below), so no cap in this tree derives from a
//       KIND_GPU_CONTEXT and none can be minted from one.
//
// The KIND_IPC_ENDPOINT parent is the endpoint the GPU service
// dispatches submission ops for this context over.  Like every
// KIND_IPC_ENDPOINT-derived kind in this tree (KIND_MODESET_TXN,
// KIND_FW_SESSION, KIND_EC_QUERY, KIND_GPU_VM ...), the parent kind
// alone discriminates NOTHING; the mint gates below cover the rest.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// A mint additionally requires:
//
//   (a) ctx_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (NO_ENDPOINT); this is the parent_slot itself
//   (c) vm_slot names a live KIND_GPU_VM (0x175) (BAD_VM); the row
//       records the KIND_GPU_VM cap slot so the submit path can drop
//       back to the KIND_GPU_VM row for PPGTT walks
//   (d) engine_id in {0=RENDER, 1=BLITTER, 2=VIDEO} (BAD_ENGINE); no
//       other classes are valid on Iris Xe Gen12 for the first cluster
//   (e) priority fits u8 (BAD_STATE catches the misuse); 0 is lowest,
//       255 highest
//   (f) initial state is always STATE_NEW; a caller cannot mint into
//       ACTIVE / DYING -- the transition to ACTIVE is the LRC-init
//       job and the transition to DYING is the revoke helper
//   (g) rights subset of R_GPU_CTX_ALL, AND rights & R_MINT == 0
//       (LINEAR: §3 explicit gate)
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  ctx_key  (u64)
//   [+16] body1:   endpoint_slot[31:0] | vm_slot[63:32]
//   [+24] body2:   engine_id[7:0] | priority[15:8]
//                | state[23:16]    | linear_flag[31:24]  (linear_flag == 1)
//
// state is the ONE mutable field: kgctx_row_transition (called only by
// the LRC-init path at ACTIVE and by kgctx_revoke_inner at teardown)
// is the sole mutator.  No op reachable through cap_handler_gpu_context
// mutates state.
//
// linear_flag is FROZEN at 1 by kgctx_body2_pack and no path in this
// module rewrites body2.  A row whose linear_flag reads back != 1 is
// a corruption fingerprint the submit gate rejects.
//
// =============================================================================
// §3  LINEAR (STRONGER THAN LEAF)
// =============================================================================
//
// R_GPU_CTX_MINT (0x200) is DELIBERATELY ABSENT from R_GPU_CTX_ALL AND
// the mint gate carries an EXPLICIT refuse
// (KGCTX_MINT_REFUSED_MINT) that fires before the subset check.  Two
// gates because LINEAR is a stronger discipline than LEAF: a LEAF says
// "no child kind derives from this"; LINEAR says "no child cap of ANY
// kind ever descends from a KIND_GPU_CONTEXT row".  The subset check
// would already reject a set-bit R_MINT (0x200 is outside 0x41B), but
// the explicit refuse makes the intent legible and stamps a distinct
// failure code so the operator can distinguish a LINEAR trip from an
// ordinary rights-mask trip.
//
// The row also carries linear_flag = 1 in body2[31:24] so a downstream
// consumer walking the row through kgctx_row_linear can assert LINEAR
// without re-reading rights.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF5A0..0xFFFFF5AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: gtt_scanout
// 0xFFFFF5B0..BF; adjacent free bands below: lrc 0xFFFFF590..9F,
// execlists 0xFFFFF580..8F, ctx_priority 0xFFFFF570..7F).

module KindGpuContext = structure {

  pub let KIND_GPU_CONTEXT        : u64 = 0x176
  pub let GPU_CTX_PARENT_KIND     : u64 = 5           // = KIND_IPC_ENDPOINT
  pub let GPU_CTX_VM_KIND         : u64 = 0x175       // = KIND_GPU_VM

  // FSM state ordinals (§1f).
  pub let KGCTX_STATE_NEW    : u64 = 0
  pub let KGCTX_STATE_ACTIVE : u64 = 1
  pub let KGCTX_STATE_DYING  : u64 = 2
  pub let KGCTX_STATE_MAX    : u64 = 2

  // Engine class ordinals (§1d).
  pub let KGCTX_ENGINE_RENDER  : u64 = 0
  pub let KGCTX_ENGINE_BLITTER : u64 = 1
  pub let KGCTX_ENGINE_VIDEO   : u64 = 2
  pub let KGCTX_ENGINE_MAX     : u64 = 2

  // Rights.  LINEAR: R_MINT (0x200) NOT in the mask AND explicit refuse.
  pub let R_GPU_CTX_READ    : u64 = 0x001
  pub let R_GPU_CTX_WRITE   : u64 = 0x002
  pub let R_GPU_CTX_INVOKE  : u64 = 0x008
  pub let R_GPU_CTX_REVOKE  : u64 = 0x010
  pub let R_GPU_CTX_OBSERVE : u64 = 0x400
  pub let R_GPU_CTX_ALL     : u64 = 0x41B
  pub let R_GPU_CTX_MINT    : u64 = 0x200             // LINEAR gate refuses

  // Ops.  Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KGCTX_OP_QUERY_KEY      : u64 = 0
  pub let KGCTX_OP_QUERY_ENDPOINT : u64 = 1
  pub let KGCTX_OP_QUERY_VM       : u64 = 2
  pub let KGCTX_OP_QUERY_ENGINE   : u64 = 3
  pub let KGCTX_OP_QUERY_PRIORITY : u64 = 4
  pub let KGCTX_OP_QUERY_STATE    : u64 = 5
  pub let KGCTX_OP_QUERY_LINEAR   : u64 = 6
  pub let KGCTX_OP_DEBUG_PRINT    : u64 = 7
  pub let KGCTX_OP_MAX            : u64 = 7

  // Failure taxonomy -- 0xFFFFF5A0..0xFFFFF5AF.
  pub let KGCTX_OK                 : u64 = 0
  pub let KGCTX_TAIL_ENOSPC        : u64 = 0xFFFFF5AF
  pub let KGCTX_TAIL_BAD_ARG       : u64 = 0xFFFFF5AE
  pub let KGCTX_MINT_BAD_PARENT    : u64 = 0xFFFFF5AD
  pub let KGCTX_MINT_BAD_RIGHTS    : u64 = 0xFFFFF5AC
  pub let KGCTX_MINT_BAD_VM        : u64 = 0xFFFFF5AB
  pub let KGCTX_MINT_BAD_ENGINE    : u64 = 0xFFFFF5AA
  pub let KGCTX_MINT_BAD_STATE     : u64 = 0xFFFFF5A9
  pub let KGCTX_MINT_NO_ENDPOINT   : u64 = 0xFFFFF5A8
  pub let KGCTX_MINT_NO_KEY        : u64 = 0xFFFFF5A7
  pub let KGCTX_MINT_ENOSPC        : u64 = 0xFFFFF5A6
  pub let KGCTX_MINT_IN_USE        : u64 = 0xFFFFF5A5
  pub let KGCTX_BAD_SLOT           : u64 = 0xFFFFF5A4
  pub let KGCTX_WRONG_KIND         : u64 = 0xFFFFF5A3
  pub let KGCTX_REVOKE_ALREADY     : u64 = 0xFFFFF5A2
  pub let KGCTX_BAD_TRANSITION     : u64 = 0xFFFFF5A1
  pub let KGCTX_MINT_REFUSED_MINT  : u64 = 0xFFFFF5A0    // LINEAR explicit

  pub let KGCTX_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KGCTX_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let KGCTX_MAX       : u64 = 8
  pub let KGCTX_ROW_BYTES : u64 = 32

  pub let mut _gpu_ctx_table : [u64; 32] = uninit @align(64)
  pub let mut _gpu_ctx_stats : [u64; 4]  = uninit @align(64)

  pub let KGCTX_ST_MINTS       : u64 = 0
  pub let KGCTX_ST_REVOKES     : u64 = 1
  pub let KGCTX_ST_TRANSITIONS : u64 = 2
  pub let KGCTX_ST_REFUSED     : u64 = 3

  pub let kgctx_dbg_msg : [u8; 12] = "GPU CTX ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let gpu_ctx_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): clear the GPU CONTEXT row table and its counters. Boot and teardown only. Labels prefixed kgctx_rs_.",
      block: {
        lea r10, [rip + _gpu_ctx_table];
        xor rax, rax;
        xor rcx, rcx;
      kgctx_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kgctx_rs_rows;

        lea r10, [rip + _gpu_ctx_stats];
        xor rcx, rcx;
      kgctx_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kgctx_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kgctx_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-001 (#1272): 1 iff s <= KGCTX_STATE_MAX (2). Labels prefixed kgctx_sv_.",
      block: {
        cmp rdi, 2;
        ja  kgctx_sv_no;
        mov rax, 1;
        ret;
      kgctx_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgctx_engine_valid : (u64) -> u64 !{} @{} =
    fn (e: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-001 (#1272): 1 iff e in {0,1,2} (render/blitter/video). Labels prefixed kgctx_ev_.",
      block: {
        cmp rdi, 2;
        ja  kgctx_ev_no;
        mov rax, 1;
        ret;
      kgctx_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgctx_priority_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-001 (#1272): 1 iff p <= 0xFF (fits u8). Labels prefixed kgctx_pv_.",
      block: {
        cmp rdi, 0xFF;
        ja  kgctx_pv_no;
        mov rax, 1;
        ret;
      kgctx_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgctx_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-001 (#1272): subset test against R_GPU_CTX_ALL = 0x41B. R_MINT (0x200) is OUTSIDE the mask -- LINEAR (§3). Labels prefixed kgctx_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne kgctx_rgv_no;
        mov rax, 1;
        ret;
      kgctx_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kgctx_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): counter bump. Labels prefixed kgctx_nt_.",
      block: {
        cmp rdi, 4;
        jae kgctx_nt_out;
        lea r10, [rip + _gpu_ctx_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kgctx_nt_out:
        ret
      }
    }

  pub let kgctx_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): counter read. Labels prefixed kgctx_stt_.",
      block: {
        cmp rdi, 4;
        jae kgctx_stt_zero;
        lea r10, [rip + _gpu_ctx_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kgctx_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let kgctx_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): §1 gate. Parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed kgctx_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgctx_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne kgctx_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kgctx_cp_no;

        mov rax, 1;
        ret;
      kgctx_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // VM gate: live KIND_GPU_VM (0x175) at vm_slot.
  // ==========================================================================

  pub let kgctx_check_vm : (u64) -> u64 !{mem} @{cap} =
    fn (vm_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M5-001 (#1272): §1c gate. vm_slot must be a live KIND_GPU_VM. Labels prefixed kgctx_cv_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgctx_cv_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x175;
        cmp r10, r11;
        jne kgctx_cv_no;

        mov rax, 1;
        ret;
      kgctx_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kgctx_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-001 (#1272): (parent_slot << 8). Labels prefixed kgctx_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kgctx_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kgctx_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kgctx_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (vm_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-001 (#1272): pack endpoint_slot[31:0] | vm_slot[63:32]. Labels prefixed kgctx_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kgctx_b1_bad;
        cmp rsi, r10;
        ja  kgctx_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      kgctx_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kgctx_body2_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (engine_id: u64) (priority: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-001 (#1272): pack engine_id[7:0] | priority[15:8] | state[23:16] | linear_flag[31:24]=1. Labels prefixed kgctx_b2_.",
      block: {
        cmp rdi, 2;
        ja  kgctx_b2_bad;
        cmp rsi, 0xFF;
        ja  kgctx_b2_bad;
        cmp rdx, 2;
        ja  kgctx_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        // linear_flag frozen at 1 in [31:24].
        mov r10, 1;
        shl r10, 24;
        or  rax, r10;
        ret;
      kgctx_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _gpu_ctx_table.
  // ==========================================================================

  pub let kgctx_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (ctx_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): claim one GPU CTX row. THE ONE WRITER of _gpu_ctx_table. Gates: hdr in_use pre-set -> BAD_ARG; ctx_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed kgctx_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kgctx_ta_bad;

        cmp r13, 0;
        je  kgctx_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kgctx_ta_bad;
        cmp r15, r10;
        je  kgctx_ta_bad;

        xor rbx, rbx;
      kgctx_ta_scan:
        cmp rbx, 8;
        jae kgctx_ta_enospc;

        lea r10, [rip + _gpu_ctx_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgctx_ta_claim;

        add rbx, 1;
        jmp kgctx_ta_scan;

      kgctx_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kgctx_ta_out;

      kgctx_ta_enospc:
        mov rax, 0xFFFFF5AF;
        jmp kgctx_ta_out;
      kgctx_ta_bad:
        mov rax, 0xFFFFF5AE;

      kgctx_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kgctx_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): 1 iff row_id < MAX and in_use. Labels prefixed kgctx_tvr_.",
      block: {
        cmp rdi, 8;
        jae kgctx_tvr_no;
        lea r10, [rip + _gpu_ctx_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgctx_tvr_no;
        mov rax, 1;
        ret;
      kgctx_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgctx_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): scrub one row. Labels prefixed kgctx_tf_.",
      block: {
        cmp rdi, 8;
        jae kgctx_tf_out;
        lea r10, [rip + _gpu_ctx_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kgctx_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kgctx_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): ctx_key. Labels prefixed kgctx_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgctx_tail_valid;
        cmp rax, 0;
        je  kgctx_rk_bad;
        lea r10, [rip + _gpu_ctx_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kgctx_rk_out;
      kgctx_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgctx_rk_out:
        pop r12;
        ret
      }
    }

  pub let kgctx_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): endpoint_slot (body1[31:0]). Labels prefixed kgctx_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgctx_tail_valid;
        cmp rax, 0;
        je  kgctx_re_bad;
        lea r10, [rip + _gpu_ctx_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kgctx_re_out;
      kgctx_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgctx_re_out:
        pop r12;
        ret
      }
    }

  pub let kgctx_row_vm : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-001 (#1272): vm_slot (body1[63:32]). Labels prefixed kgctx_rv_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgctx_tail_valid;
        cmp rax, 0;
        je  kgctx_rv_bad;
        lea r10, [rip + _gpu_ctx_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp kgctx_rv_out;
      kgctx_rv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgctx_rv_out:
        pop r12;
        ret
      }
    }

  pub let kgctx_row_engine : (u64) -> u64 !{mem} @{} =
