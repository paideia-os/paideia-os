// src/kernel/core/cap/kind_hw_msix_vector.pdx — R29.M1-004 (#1022)
// KIND_HW_MSIX_VECTOR derived-kind: tail encoding + mint/revoke +
// dispatch handler. Second derived kind over KIND_HW (slot 14), riding
// on top of KIND_HW_INTERRUPT (0x140).
//
// Design context
// --------------
// R29.M1-001..003 (#1019, commit 4c60080) landed KIND_HW_INTERRUPT.
// Real MSI-capable devices (NVMe, virtio-net, xhci, ...) expose N
// MSI-X vectors per device — each vector is an independently
// addressable interrupt with its own {table_offset, data} tuple and
// its own dispatch policy. Modeling every one of these as a
// KIND_HW_INTERRUPT would collapse the "per-device authority" boundary
// (a single driver would need N separate parent caps); the correct
// shape is one KIND_HW_INTERRUPT per device (the underlying line/GSI
// authority) that MINTS N KIND_HW_MSIX_VECTOR children (each carrying
// the per-vector table offset + data payload).
//
// Numeric derived-kind tag
// ------------------------
// KIND_HW_MSIX_VECTOR = 0x141 (decimal 321). Adjacent to
// KIND_HW_INTERRUPT (0x140) in the R29 range; distinct from every
// existing derived-kind tag (KIND_DRIVER=0x15, KIND_DMESG=0x16,
// KIND_ACPI=0x20, KIND_PCI_DEV=0x30, KIND_HW_INTERRUPT=0x140). The
// base LAM kind-hint slot remains 14 (KIND_HW), so fast-dispatch on
// the 4-bit LAM tag survives; the full u64 kind field in the
// descriptor is compared against 0x141 in cap_invoke_dispatch to
// route to this module's handler.
//
// Descriptor tail (row-indirection, mirrors KIND_HW_INTERRUPT)
// ------------------------------------------------------------
// The cap descriptor's target_ptr slot holds a row_id in bits [15:0];
// upper bits [63:16] MUST be zero. Row data lives in
// `_hw_msix_vector_table[row_id]`, a 32-byte row (four u64s):
//
//   [+0]  u64:  bits [31:0]  = msix_table_offset (u32; byte offset
//                              into the device's MSI-X table BAR)
//               bits [39:32] = parent_slot (u8; cap_table slot of
//                              the KIND_HW_INTERRUPT parent — used
//                              for O(N) cascade revocation)
//               bits [47:40] = reserved (must be zero)
//               bits [55:48] = reserved (must be zero)
//               bits [63:56] = in_use flag (0=free, 1=allocated)
//   [+8]  u64:  bits [31:0]  = msix_data (u32; the payload written
//                              to the MSI-X message data register on
//                              vector arm)
//               bits [63:32] = reserved (future: msix_addr_hi/lo
//                              overrides, mask/pending shadow bits)
//   [+16] u64:  reserved (future: target_apic_id + delivery_mode +
//                        polarity per next-wave-derived-kinds.md)
//   [+24] u64:  reserved (future: fire_count + last_fire_ns)
//
// Total tail state: 32 bytes = 256 bits, of which 88 are live and 168
// reserved for R29.M2+ MSI-X programming + observability.
//
// Storing parent_slot in the row (rather than only in the cap
// descriptor's rights/target_ptr) is what makes the cascade-revoke
// path efficient: hw_int_cap_revoke calls msix_cascade_revoke_by_parent
// (defined here) which scans cap_table for descriptors with
// kind==0x141 and for each such cap decodes the row's parent_slot to
// decide whether it must be revoked. O(256) scan is bounded by
// cap_table size and runs once per parent-revoke — well below any
// hot-path threshold at the R29 substrate stage.
//
// Table sizing
// ------------
// HW_MSIX_MAX = 64. Matches KIND_HW_INTERRUPT capacity — enough for
// 16 devices × 4 vectors each (typical NVMe + virtio-net + xhci +
// audio baseline) with headroom. Storage: 64 * 32 = 2048 bytes .bss,
// align 64.
//
// Rights discipline
// -----------------
// A KIND_HW_MSIX_VECTOR cap carries a subset of R_MSIX_ALL:
//
//   R_MSIX_INVOKE  (0x008 = RIGHT_INVOKE) — query/mask/unmask ops
//   R_MSIX_REVOKE  (0x010 = RIGHT_REVOKE) — supervisor revoke path
//   R_MSIX_MINT    (0x200 = RIGHT_MINT)   — reserved for a future
//                                            per-vector delegation
//                                            path (unused at R29.M1-004)
//   R_MSIX_ALL     (0x218) — bitwise OR of the three.
//
// RIGHT_OBSERVE is intentionally NOT in the subset — the directive
// for this issue calls out R_MINT / R_REVOKE / R_INVOKE only. Query
// ops therefore live under RIGHT_INVOKE (op_arg dispatched inside the
// handler with a rights & 0x08 gate).
//
// Mint discipline
// ---------------
// msix_cap_mint requires the caller to hold an ancestor
// KIND_HW_INTERRUPT cap (kind == 0x140) with R_HW_INT_MINT set
// (0x200). The gate is msix_check_parent_kind_hw_int which reads
// cap_table[parent_slot] and asserts both invariants. This is the
// exact shape of hw_int_check_parent_kind_hw's gate, one layer up in
// the derivation lattice: KIND_HW → KIND_HW_INTERRUPT → KIND_HW_MSIX_VECTOR.
//
// Revoke discipline + cascade
// ---------------------------
// msix_cap_revoke reads the cap descriptor at the target slot,
// verifies kind == 0x141, frees the row (zeros all 32 bytes), and
// clears the cap descriptor. Idempotent on an already-null slot
// (MSIX_REVOKE_ALREADY).
//
// The cascade path is msix_cascade_revoke_by_parent(parent_slot) —
// invoked from hw_int_cap_revoke BEFORE the parent frees its own
// row/descriptor. Scans cap_table[0..255]; for each descriptor with
// kind == 0x141, loads the row's parent_slot field; if it matches the
// parent being revoked, calls msix_cap_revoke on that child. Returns
// the count of children revoked (informational; hw_int_cap_revoke
// discards it).
//
// The invariant "no dangling KIND_HW_MSIX_VECTOR child after parent
// revoke" is enforced by the cascade + witness sub-test that verifies
// all 4 children in cap_table[16..19] are cleared after
// hw_int_cap_revoke(15).

module KindHwMsixVector = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================

  // Runtime base kind (LAM kind-hint slot). Same as KIND_HW_INTERRUPT
  // (both derive from KIND_HW = 14).
  pub let KIND_HW_MSIX_BASE : u64 = 14

  // Derived-kind tag. Value 0x141 (decimal 321); adjacent to
  // KIND_HW_INTERRUPT (0x140).
  pub let KIND_HW_MSIX_VECTOR : u64 = 0x141

  // Parent derived-kind tag (used by the mint gate). Sourced from
  // kind_hw_interrupt.pdx as 0x140.
  pub let KIND_HW_MSIX_PARENT : u64 = 0x140

  // ============================================================================
  // Rights (subset legal on a KIND_HW_MSIX_VECTOR capability)
  // ============================================================================

  pub let R_MSIX_INVOKE : u64 = 0x008    // matches Rights.RIGHT_INVOKE
  pub let R_MSIX_REVOKE : u64 = 0x010    // matches Rights.RIGHT_REVOKE
  pub let R_MSIX_MINT   : u64 = 0x200    // matches Rights.RIGHT_MINT
  pub let R_MSIX_ALL    : u64 = 0x218    // INVOKE|REVOKE|MINT

  // ============================================================================
  // Table caps
  // ============================================================================

  pub let HW_MSIX_MAX       : u64 = 64
  pub let HW_MSIX_ROW_BYTES : u64 = 32

  // ============================================================================
  // Return codes (disjoint from HW_INT_MINT_* / HW_INT_REVOKE_* to keep
  // per-kind error spaces observably distinct in the witness).
  // ============================================================================

  pub let MSIX_TAIL_OK           : u64 = 0
  pub let MSIX_TAIL_ENOSPC       : u64 = 0xFFFFFFEF
  pub let MSIX_TAIL_BAD_ARG      : u64 = 0xFFFFFFEE

  pub let MSIX_MINT_OK           : u64 = 0
  pub let MSIX_MINT_BAD_PARENT   : u64 = 0xFFFFFFED
  pub let MSIX_MINT_BAD_RIGHTS   : u64 = 0xFFFFFFEC
  pub let MSIX_MINT_ENOSPC       : u64 = 0xFFFFFFEB
  pub let MSIX_MINT_BAD_ARG      : u64 = 0xFFFFFFEA

  pub let MSIX_REVOKE_OK         : u64 = 0
  pub let MSIX_REVOKE_BAD_SLOT   : u64 = 0xFFFFFFE9
  pub let MSIX_REVOKE_WRONG_KIND : u64 = 0xFFFFFFE8
  pub let MSIX_REVOKE_ALREADY    : u64 = 0xFFFFFFE7

  // ============================================================================
  // Ops (op_arg[7:0] = op_code)
  // ============================================================================

  pub let MSIX_OP_QUERY_TABLE_OFFSET : u64 = 0   // RIGHT_INVOKE -> msix_table_offset
  pub let MSIX_OP_QUERY_DATA         : u64 = 1   // RIGHT_INVOKE -> msix_data
  pub let MSIX_OP_QUERY_PARENT       : u64 = 2   // RIGHT_INVOKE -> parent_slot
  pub let MSIX_OP_MASK               : u64 = 3   // RIGHT_INVOKE -> INVOKE_UNSUPPORTED (R29.M2)
  pub let MSIX_OP_UNMASK             : u64 = 4   // RIGHT_INVOKE -> INVOKE_UNSUPPORTED (R29.M2)

  // ============================================================================
  // Backing table (.bss, align 64)
  // ============================================================================
  //
  // 64 rows * 32 bytes = 2048 bytes = 256 u64s. .bss zero-init means
  // every row starts with in_use=0 (byte 7 of the [+0] u64), which is
  // the free sentinel that msix_tail_alloc scans for.

  pub let mut _hw_msix_vector_table : [u64; 256] = uninit @align(64)

  // ============================================================================
  // msix_tail_alloc(msix_table_offset, msix_data, parent_slot) -> u64
  //
  // Allocates a free row, populates it with the caller's tail fields,
  // and returns the row_id. Returns MSIX_TAIL_ENOSPC if no free row
  // is available; MSIX_TAIL_BAD_ARG if msix_table_offset >= 2^32 or
  // msix_data >= 2^32 or parent_slot >= 256.
  //
  // SysV ABI: rdi=msix_table_offset, rsi=msix_data, rdx=parent_slot.
  // ============================================================================

  pub let msix_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (msix_table_offset: u64) (msix_data: u64) (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-004 (#1022): allocate a free _hw_msix_vector_table row + populate it. Bad-arg gates: msix_table_offset upper bits [63:32] non-zero, msix_data upper bits [63:32] non-zero, or parent_slot >= 256 -> MSIX_TAIL_BAD_ARG. Low-first row scan: row is free iff in_use byte (byte 7 of [row+0]) is zero. Exhaustion returns MSIX_TAIL_ENOSPC. Claim: pack (offset & 0xFFFFFFFF) | ((parent_slot & 0xFF) << 32) | (1 << 56) into [row+0]; (msix_data & 0xFFFFFFFF) into [row+8]; zero into [row+16] and [row+24]. Row size 32 bytes. .bss zero-init preserves the in_use=0 invariant between kernel boots. Mirrors hw_int_tail_alloc's shape (kind_hw_interrupt.pdx).",
      block: {
        // Bad-arg gate: msix_table_offset >= 2^32.
        mov r10, rdi;
        shr r10, 32;
        cmp r10, 0;
        jne msix_alloc_bad_arg;

        // Bad-arg gate: msix_data >= 2^32.
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne msix_alloc_bad_arg;

        // Bad-arg gate: parent_slot >= 256.
        cmp rdx, 256;
        jae msix_alloc_bad_arg;

        // Save incoming args across the scan.
        //   rdi = msix_table_offset -> r13
        //   rsi = msix_data         -> r14
        //   rdx = parent_slot       -> r15
        push r13;
        push r14;
        push r15;
        mov r13, rdi;
        mov r14, rsi;
        mov r15, rdx;

        // Row cursor.
        lea r8, [rip + _hw_msix_vector_table];
        xor rcx, rcx;

      msix_alloc_scan:
        cmp rcx, 64;                       // HW_MSIX_MAX
        jae msix_alloc_none;
        mov rax, [r8];                     // row header
        mov r10, rax;
        shr r10, 56;                       // in_use byte
        cmp r10, 0;
        je  msix_alloc_found;
        add r8, 32;                        // HW_MSIX_ROW_BYTES
        add rcx, 1;
        jmp msix_alloc_scan;

      msix_alloc_found:
        // Pack row [+0]:
        //   bits [31:0]  = msix_table_offset
        //   bits [39:32] = parent_slot
        //   bits [63:56] = in_use (1)
        mov rax, r13;                      // msix_table_offset
        mov r10, 0xFFFFFFFF;
        and rax, r10;

        mov r10, r15;                      // parent_slot
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;

        mov r10, 1;
        shl r10, 56;                       // in_use bit
        or  rax, r10;

        mov [r8 + 0], rax;                 // header

        // Pack row [+8] = msix_data (low 32 bits only).
        mov rax, r14;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        mov [r8 + 8], rax;

        xor rax, rax;
        mov [r8 + 16], rax;                // reserved
        mov [r8 + 24], rax;                // reserved

        mov rax, rcx;                      // return row_id

        pop r15;
        pop r14;
        pop r13;
        ret;

      msix_alloc_none:
        pop r15;
        pop r14;
        pop r13;
        mov rax, 0xFFFFFFEF;               // MSIX_TAIL_ENOSPC
        ret;

      msix_alloc_bad_arg:
        mov rax, 0xFFFFFFEE;               // MSIX_TAIL_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // msix_tail_free(row_id) -> ()
  //
  // Zeros the row at row_id, releasing it. No-op if row_id >= HW_MSIX_MAX.
  // ============================================================================

  pub let msix_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-004 (#1022): row_id >= HW_MSIX_MAX -> silent no-op. Otherwise compute row = &_hw_msix_vector_table + row_id*32 via shl 5. Zero all four u64s of the row. Leaf function; no callee-save writes. Mirrors hw_int_tail_free.",
      block: {
        cmp rdi, 64;                       // HW_MSIX_MAX
        jae msix_free_done;

        mov r8, rdi;
        shl r8, 5;                         // row_id * 32
        lea r9, [rip + _hw_msix_vector_table];
        add r8, r9;

        xor rax, rax;
        mov [r8 + 0], rax;
        mov [r8 + 8], rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;

      msix_free_done:
        ret
      }
    }

  // ============================================================================
  // msix_tail_decode_offset(row_id) -> u64
  //
  // Returns msix_table_offset from row_id's [+0] u64 bits [31:0] if
  // row is live; 0xFFFFFFFFFFFFFFFF if row_id >= HW_MSIX_MAX or row
  // is not in_use.
  // ============================================================================

  pub let msix_tail_decode_offset : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-004 (#1022): decode msix_table_offset from _hw_msix_vector_table[row_id][+0][31:0]. Bounds-check + in_use check first; returns 0xFF... on failure so callers cannot mistake a zero offset for a decode-fail. Leaf function; pure read.",
      block: {
        cmp rdi, 64;
        jae msix_dec_off_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_msix_vector_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  msix_dec_off_bad;

        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret;

      msix_dec_off_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // msix_tail_decode_data(row_id) -> u64
  //
  // Returns msix_data from row_id's [+8] u64 bits [31:0] if row is
  // live; 0xFFFFFFFFFFFFFFFF on failure.
  // ============================================================================

  pub let msix_tail_decode_data : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-004 (#1022): decode msix_data from _hw_msix_vector_table[row_id][+8][31:0]. Bounds-check + in_use check first; returns 0xFF... on failure. Leaf function; pure read.",
      block: {
        cmp rdi, 64;
        jae msix_dec_data_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_msix_vector_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  msix_dec_data_bad;

        mov rax, [r8 + 8];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret;

      msix_dec_data_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // msix_tail_decode_parent(row_id) -> u64
  //
  // Returns parent_slot from row_id's [+0] u64 bits [39:32] if row is
  // live; 0xFFFFFFFFFFFFFFFF on failure.
  // ============================================================================

  pub let msix_tail_decode_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-004 (#1022): decode parent_slot from _hw_msix_vector_table[row_id][+0][39:32]. Bounds-check + in_use check first; returns 0xFF... on failure. Leaf function; pure read. Used by the cascade path AND exposed as an op for witness introspection.",
      block: {
        cmp rdi, 64;
        jae msix_dec_par_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_msix_vector_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  msix_dec_par_bad;

        shr rax, 32;
        mov r10, 0xFF;
        and rax, r10;
        ret;

      msix_dec_par_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ============================================================================
  // msix_tail_valid(row_id) -> u64
  //
  // Returns 1 iff row_id < HW_MSIX_MAX AND row's in_use byte is
  // non-zero.
  // ============================================================================

  pub let msix_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M1-004 (#1022): return 1 iff row_id refers to a live row in _hw_msix_vector_table. Same shape as hw_int_tail_valid. Leaf function; pure read.",
      block: {
        cmp rdi, 64;
        jae msix_valid_no;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _hw_msix_vector_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  msix_valid_no;

        mov rax, 1;
        ret;

      msix_valid_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // msix_rights_valid(rights) -> u64
  //
  // Returns 1 iff rights is a subset of R_MSIX_ALL (0x218).
  // ============================================================================

  pub let msix_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR rights-subset validator. Returns 1 iff (rights & R_MSIX_ALL) == rights; else 0. R_MSIX_ALL = 0x218 (INVOKE|REVOKE|MINT). Same shape as hw_int_rights_valid.",
      block: {
        mov rax, rdi;
        mov r10, 0x218;
        and rax, r10;
        cmp rax, rdi;
        jne msix_rights_no;
        mov rax, 1;
        ret;

      msix_rights_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // msix_check_parent_kind_hw_int(parent_slot) -> u64
  //
  // Returns 1 iff cap_table[parent_slot].kind == KIND_HW_INTERRUPT
  // (0x140) AND (rights & R_HW_INT_MINT = 0x200) != 0. Else 0.
  //
  // This is the "ancestor KIND_HW_INTERRUPT cap holding RIGHT_MINT"
  // gate required for msix_cap_mint. One layer up in the derivation
  // lattice from hw_int_check_parent_kind_hw's gate: KIND_HW →
  // KIND_HW_INTERRUPT → KIND_HW_MSIX_VECTOR.
  // ============================================================================

  pub let msix_check_parent_kind_hw_int : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M1-004 (#1022): supervisor mint-gate for KIND_HW_MSIX_VECTOR. Load descriptor at cap_table + parent_slot*24. Assert kind field ([+0]) == 0x140 (KIND_HW_INTERRUPT) AND rights field ([+8]) has bit 0x200 (RIGHT_MINT / R_HW_INT_MINT) set. Bounds-check parent_slot < 256 first. Returns 1 on OK, 0 otherwise. Pure read; no writes. Mirrors hw_int_check_parent_kind_hw.",
      block: {
        cmp rdi, 256;
        jae msix_parent_no;

        // Compute cap_table + parent_slot * 24.
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // Check kind == 0x140.
        mov r10, [rax + 0];
        mov r11, 0x140;
        cmp r10, r11;
        jne msix_parent_no;

        // Check rights & 0x200 != 0.
        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  msix_parent_no;

        mov rax, 1;
        ret;

      msix_parent_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // msix_cap_mint(slot, parent_slot, rights, msix_table_offset,
  //               msix_data) -> u64
  //
  // Full mint: validate parent (KIND_HW_INTERRUPT + RIGHT_MINT),
  // validate rights subset, allocate row, write descriptor.
  //
  // SysV ABI (5 args in registers):
  //   rdi = slot                (target cap_table slot; 0..255)
  //   rsi = parent_slot         (ancestor KIND_HW_INTERRUPT slot; 0..255)
  //   rdx = rights              (subset of R_MSIX_ALL)
  //   rcx = msix_table_offset   (u32; upper bits must be zero)
  //   r8  = msix_data           (u32; upper bits must be zero)
  // ============================================================================

  pub let msix_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (msix_table_offset: u64) (msix_data: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M1-004 (#1022): supervisor mint API for KIND_HW_MSIX_VECTOR. Sequence: (1) bounds-check slot < 256 -> BAD_ARG. (2) msix_check_parent_kind_hw_int(parent_slot) -> BAD_PARENT. (3) msix_rights_valid(rights) -> BAD_RIGHTS. (4) msix_tail_alloc(offset, data, parent_slot) -> ENOSPC/BAD_ARG. (5) cap_mint_write(slot, KIND_HW_MSIX_VECTOR=0x141, rights, row_id). Return MSIX_MINT_OK (0). All 5 arg regs preserved across sub-calls via caller-save stack. Return-code space (MSIX_MINT_*) disjoint from HW_INT_MINT_* and cap_mint_write's void return. Mirrors hw_int_cap_mint shape.",
      block: {
        // Bounds-check slot.
        cmp rdi, 256;
        jae msix_mint_bad_arg;

        // -- Step 2: msix_check_parent_kind_hw_int(parent_slot).
        //    Save all 5 arg regs (rdi/rsi/rdx/rcx/r8).
        push rdi;
        push rsi;
        push rdx;
        push rcx;
        push r8;
        mov rdi, rsi;                      // parent_slot in rdi
        call msix_check_parent_kind_hw_int;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        pop rdi;
        cmp rax, 0;
        je  msix_mint_bad_parent;

        // -- Step 3: msix_rights_valid(rights).
        push rdi;
        push rsi;
        push rdx;
        push rcx;
        push r8;
        mov rdi, rdx;                      // rights in rdi
        call msix_rights_valid;
        pop r8;
        pop rcx;
        pop rdx;
        pop rsi;
        pop rdi;
        cmp rax, 0;
        je  msix_mint_bad_rights;

        // -- Step 4: msix_tail_alloc(offset, data, parent_slot).
        //    Arg move: rdi=offset (from rcx), rsi=data (from r8),
        //              rdx=parent_slot (from rsi).
        push rdi;                          // save slot
        push rdx;                          // save rights
        mov rdx, rsi;                      // parent_slot -> rdx (arg 3)
        mov rdi, rcx;                      // offset -> rdi (arg 1)
        mov rsi, r8;                       // data -> rsi (arg 2)
        call msix_tail_alloc;
        // rax = row_id (or MSIX_TAIL_ENOSPC / MSIX_TAIL_BAD_ARG).
        pop rdx;                           // rights
        pop rdi;                           // slot

        // Check for allocation failure.
        mov r10, 0xFFFFFFEF;
        cmp rax, r10;
        je  msix_mint_enospc;
        mov r10, 0xFFFFFFEE;
        cmp rax, r10;
        je  msix_mint_bad_arg;

        // -- Step 5: cap_mint_write(slot, kind=0x141, rights, target_ptr=row_id).
        //    ABI: rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr.
        //    Current: rdi=slot, rdx=rights, rax=row_id.
        mov rsi, 0x141;                    // KIND_HW_MSIX_VECTOR
        mov rcx, rax;                      // target_ptr = row_id
        call cap_mint_write;

        // Success.
        xor rax, rax;                      // MSIX_MINT_OK (0)
        ret;

      msix_mint_bad_parent:
        mov rax, 0xFFFFFFED;
        ret;

      msix_mint_bad_rights:
        mov rax, 0xFFFFFFEC;
        ret;

      msix_mint_enospc:
        mov rax, 0xFFFFFFEB;
        ret;

      msix_mint_bad_arg:
        mov rax, 0xFFFFFFEA;
        ret
      }
    }

  // ============================================================================
  // msix_cap_revoke(slot) -> u64
  //
  // Full revoke: verify descriptor at cap_table[slot] is a
  // KIND_HW_MSIX_VECTOR, extract row_id from target_ptr, free the row,
  // clear the descriptor.
  //
  // Idempotent on an already-null slot (MSIX_REVOKE_ALREADY).
  //
  // NOTE: msix_cap_revoke does NOT itself cascade — it is a leaf revoke
  // for a single MSI-X vector. The cascade lives in
  // msix_cascade_revoke_by_parent below, which iterates over cap_table
  // and calls msix_cap_revoke on each matching child.
  // ============================================================================

  pub let msix_cap_revoke : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M1-004 (#1022): supervisor revoke API for KIND_HW_MSIX_VECTOR. Sequence: (1) bounds-check slot < 256 -> BAD_SLOT. (2) Load descriptor at cap_table + slot*24. (3) If kind == 0 -> REVOKE_ALREADY. (4) If kind != 0x141 -> WRONG_KIND. (5) Extract row_id from target_ptr[15:0], call msix_tail_free(row_id). (6) Clear descriptor (0,0,0). Return REVOKE_OK. Mirrors hw_int_cap_revoke's shape; return codes disjoint (MSIX_REVOKE_* in 0xFFFFFFE7..0xFFFFFFE9). No self-cascade — this is a leaf revoke for a single MSI-X vector.",
      block: {
        cmp rdi, 256;
        jae msix_revoke_bad_slot;

        // Compute cap_table + slot * 24.
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r11, rax;                      // save descriptor base
        mov r10, [rax + 0];                // kind

        cmp r10, 0;
        je  msix_revoke_already;

        mov r9, 0x141;
        cmp r10, r9;
        jne msix_revoke_wrong_kind;

        // Extract row_id from target_ptr[15:0].
        mov rdi, [r11 + 16];
        mov r10, 0xFFFF;
        and rdi, r10;

        push r11;
        call msix_tail_free;
        pop r11;

        // Clear descriptor.
        xor rax, rax;
        mov [r11 + 0],  rax;
        mov [r11 + 8],  rax;
        mov [r11 + 16], rax;

        xor rax, rax;                      // MSIX_REVOKE_OK (0)
        ret;

      msix_revoke_bad_slot:
        mov rax, 0xFFFFFFE9;
        ret;

      msix_revoke_wrong_kind:
        mov rax, 0xFFFFFFE8;
        ret;

      msix_revoke_already:
        mov rax, 0xFFFFFFE7;
        ret
      }
    }

  // ============================================================================
  // msix_cascade_revoke_by_parent(parent_slot) -> u64
  //
  // Scans cap_table[0..255]; for each descriptor with kind ==
  // KIND_HW_MSIX_VECTOR (0x141), decodes the row's parent_slot field;
  // if it matches the incoming parent_slot, calls msix_cap_revoke on
  // that child. Returns the count of children revoked.
  //
  // Called from hw_int_cap_revoke BEFORE the parent frees its own
  // row/descriptor, so that a child's row-decode still sees the parent
  // slot (which is a metadata field, not a live cap-table pointer).
  //
  // Invariant: after this returns, no cap_table slot i in [0..256)
  // has (kind == 0x141) AND (row.parent_slot == parent_slot).
  //
  // O(256) scan is bounded by cap_table size; runs once per parent
  // revoke — well below any hot-path threshold at R29.M1 substrate
  // stage.
  // ============================================================================

  pub let msix_cascade_revoke_by_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R29.M1-004 (#1022): cascade revoke for KIND_HW_MSIX_VECTOR children of a KIND_HW_INTERRUPT parent. Iterate slot in 0..256; for each cap_table[slot], load kind at [+0]; skip if != 0x141. Extract row_id from target_ptr [+16][15:0]; decode row's parent_slot via inline read of _hw_msix_vector_table[row_id][+0] bits [39:32]. If matches incoming parent_slot, call msix_cap_revoke(slot) and increment count. Registers: r12 = slot cursor, r13 = target parent_slot (arg saved), r14 = count. All three are callee-save in SysV — push/pop preserved across the call to msix_cap_revoke. Cap_table stride = 24 bytes (kind + rights + target_ptr per cap/mint.pdx). MSI-X table row stride = 32 bytes (four u64s). Bounds-safe: row_id derived from live descriptor's target_ptr; msix_cap_revoke re-validates before freeing.",
      block: {
        push r12;
        push r13;
        push r14;
        push rbx;

        mov r13, rdi;                      // r13 = target parent_slot
        and r13, 0xFF;                     // parent_slot fits in u8

        xor r14, r14;                      // r14 = count = 0
        xor r12, r12;                      // r12 = slot cursor

      msix_cascade_loop:
        cmp r12, 256;
        jae msix_cascade_done;

        // desc_addr = cap_table + r12 * 24.
        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // Load kind field.
        mov r10, [rax + 0];
        mov r11, 0x141;
        cmp r10, r11;
        jne msix_cascade_skip;

        // Extract row_id from target_ptr[15:0].
        mov rbx, [rax + 16];
        and rbx, 0xFFFF;

        // Bounds-check row_id < HW_MSIX_MAX.
        cmp rbx, 64;
        jae msix_cascade_skip;

        // Compute row_addr = _hw_msix_vector_table + row_id * 32.
        mov r8, rbx;
        shl r8, 5;
        lea r9, [rip + _hw_msix_vector_table];
        add r8, r9;

        // Load row [+0], extract parent_slot (bits [39:32]).
        mov r10, [r8 + 0];
        shr r10, 32;
        and r10, 0xFF;

        // Compare to target parent_slot.
        cmp r10, r13;
        jne msix_cascade_skip;

        // Match — revoke this child.
        mov rdi, r12;
        call msix_cap_revoke;
        add r14, 1;

      msix_cascade_skip:
        add r12, 1;
        jmp msix_cascade_loop;

      msix_cascade_done:
        mov rax, r14;

        pop rbx;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // cap_handler_hw_msix_vector(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler installed by cap_invoke_dispatch when
  // descriptor.kind == 0x141. RDI=rights, RSI=target_ptr, RDX=op_arg.
  //
  // op_arg[7:0] = op_code:
  //   0 (OP_QUERY_TABLE_OFFSET) RIGHT_INVOKE -> msix_table_offset
  //   1 (OP_QUERY_DATA)         RIGHT_INVOKE -> msix_data
  //   2 (OP_QUERY_PARENT)       RIGHT_INVOKE -> parent_slot
  //   3 (OP_MASK)               RIGHT_INVOKE -> INVOKE_UNSUPPORTED
  //   4 (OP_UNMASK)             RIGHT_INVOKE -> INVOKE_UNSUPPORTED
  //   else                                   -> INVOKE_UNSUPPORTED
  //
  // All ops on this kind gate on RIGHT_INVOKE (0x008) — the directive
  // for #1022 pins rights to {MINT, REVOKE, INVOKE} only. No
  // RIGHT_OBSERVE branch.
  // ============================================================================

  pub let cap_handler_hw_msix_vector : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR dispatch handler. op_arg[7:0] = op_code. OP_QUERY_TABLE_OFFSET/OP_QUERY_DATA/OP_QUERY_PARENT (0..2) require RIGHT_INVOKE and delegate to msix_tail_decode_{offset,data,parent} with row_id = target_ptr & 0xFFFF. OP_MASK/OP_UNMASK (3..4) require RIGHT_INVOKE and return INVOKE_UNSUPPORTED (real MSI-X wire-up lands at R29.M2). Bad op -> INVOKE_UNSUPPORTED. Rights failure -> INVOKE_DENIED. Emits klog_s1(INFO, SUBSYS_CAP_, cap_hw_msix_msg) chatter on entry — matches every other kind_*.pdx handler. RDI-preserve discipline: push rdi/rsi/rdx before klog_s1, pop after.",
      block: {
        push rdi;
        push rsi;
        push rdx;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hw_msix_msg];
        call klog_s1;
        pop rdx;
        pop rsi;
        pop rdi;

        // All ops require RIGHT_INVOKE (0x008).
        mov rax, rdi;
        and rax, 0x08;
        cmp rax, 0x08;
        jne msix_h_denied;

        // Extract op_code.
        mov r8, rdx;
        and r8, 0xFF;

        cmp r8, 0;
        je  msix_h_query_off;
        cmp r8, 1;
        je  msix_h_query_data;
        cmp r8, 2;
        je  msix_h_query_par;
        cmp r8, 3;
        je  msix_h_mask;
        cmp r8, 4;
        je  msix_h_unmask;
        // Unknown op.
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret;

      msix_h_query_off:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call msix_tail_decode_offset;
        ret;

      msix_h_query_data:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call msix_tail_decode_data;
        ret;

      msix_h_query_par:
        mov rdi, rsi;
        mov r10, 0xFFFF;
        and rdi, r10;
        call msix_tail_decode_parent;
        ret;

      msix_h_mask:
      msix_h_unmask:
        mov rax, 0xFFFFFFFFFFFFFFFC;       // INVOKE_UNSUPPORTED
        ret;

      msix_h_denied:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;       // INVOKE_DENIED
        ret
      }
    }

}
