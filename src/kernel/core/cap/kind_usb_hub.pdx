// src/kernel/core/cap/kind_usb_hub.pdx — R34.M1-003 (#1169)
//
// KIND_USB_HUB = 0x163, derived over KIND_USB_DEVICE (0x162).
//
// The authority to hold ONE USB hub's static identity — its
// inherited hub_key (from the parent KIND_USB_DEVICE), port_count
// (1..15 per USB 2.0 §11.23.2.1), transaction-translator support
// flag (0/1), and tier — its depth in the topology tree (1..5, the
// USB 2.0 spec limit).
//
// =============================================================================
// §0  UNITS: HUB DESCRIPTOR FIELDS
// =============================================================================
//
// USB hubs are named by the hub_driver.pdx class driver that decoded
// their standard hub descriptor (USB 2.0 §11.23.2.1). port_count is
// bNbrPorts (the number of downstream-facing ports the hub exposes);
// tt_supported is derived from wHubCharacteristics[6:5] (0 for a
// full/low-speed only hub, non-zero for a hub with a transaction
// translator); tier is not in the descriptor at all — it is the
// physical depth in the topology tree, computed by the enumerator
// from the parent-hub chain. Depth is a property OF THE TOPOLOGY,
// not of the hub; it is recorded here because every downstream
// KIND_USB_HUB mint gate reads it to refuse a mint at depth 6 or
// deeper.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS ABSENT
// =============================================================================
//
// Same discipline as `kind_usb_device.pdx` §1. hub_key, port_count,
// tt_supported and tier are ROW IDENTITY and are refused to a mint
// that supplies implausible values. NO dynamic state on this row:
// port-status FSM state lives in `drivers/usb/hub_fsm.pdx`, not on
// this row, because the FSM is per-port and this cap names the hub
// as a whole. A cap that carried per-port dynamic state would let
// its holder assert one port's status as a proxy for the hub's
// state, which would let a subscriber to the hub_topology_channel
// be told about an event a port never fired.
//
// =============================================================================
// §2  DERIVATION OVER KIND_USB_DEVICE — THE FIRST DERIVED-KIND PARENT IN USB
// =============================================================================
//
// The gate demands `kind == KIND_USB_DEVICE (0x162)` carrying
// `RIGHT_MINT`. Unlike KIND_USB_DEVICE (which derives over a base
// slot), this kind derives over a DERIVED-KIND parent. A raw
// KIND_DEVICE holder must not be able to mint hub authority: the
// intermediate USB device authority is what proves the enumerator
// walked xhci_slot_lifecycle, negotiated an address, and CONFIRMED
// the class code is a hub. Without that intermediate authority, any
// PCI holder could claim to have enumerated a hub.
//
// SECOND HALF: (a) inherited device_key from parent's target_ptr
// must be non-zero; (b) hub_key MUST equal that inherited key —
// there is no independent hub_key input, because the hub IS the
// device; (c) port_count in [1, 15] (USB 2.0 §11.23.2.1: bNbrPorts
// is 8-bit but hub-descriptor size limits it to 15); (d) tier in
// [1, 5]; (e) no other live row holds this hub_key.
//
// =============================================================================
// §3  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
//   * NOTHING DRIVES A HUB. Descriptor fetches and control transfers
//     to the hub itself run through the class driver's transfer-ring
//     authority (not exposed through this kind).
//   * NOTHING ROUTES A TOPOLOGY EVENT. Attach/detach events flow
//     through hub_topology_channel (#1170), which is a DISJOINT
//     surface rooted at KIND_IPC_ENDPOINT.
//   * NOTHING TRACKS PER-PORT STATE. The port-status FSM
//     (#1168) lives in drivers/usb/hub_fsm.pdx.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFEF0..0xFFFFFEFF
// =============================================================================

module KindUsbHub = structure {

  pub let KIND_USB_HUB         : u64 = 0x163
  pub let USB_HUB_PARENT_KIND  : u64 = 0x162    // = KIND_USB_DEVICE

  // §2 bounds.
  pub let USB_HUB_PORT_MIN : u64 = 1
  pub let USB_HUB_PORT_MAX : u64 = 15
  pub let USB_HUB_TIER_MIN : u64 = 1
  pub let USB_HUB_TIER_MAX : u64 = 5

  // Rights. RIGHT_MINT (0x200) NOT in the mask — this kind is a leaf
  // of the derivation lattice (nothing derives from a hub cap).
  pub let R_USB_HUB_READ    : u64 = 0x001
  pub let R_USB_HUB_INVOKE  : u64 = 0x008
  pub let R_USB_HUB_REVOKE  : u64 = 0x010
  pub let R_USB_HUB_OBSERVE : u64 = 0x400
  pub let R_USB_HUB_ALL     : u64 = 0x419

  // Ops:
  //   0 QUERY_KEY         INVOKE  hub_key
  //   1 QUERY_PORT_COUNT  INVOKE  port_count
  //   2 QUERY_TT          INVOKE  tt_supported (0/1)
  //   3 QUERY_TIER        INVOKE  tier
  //   4 QUERY_PARENT      INVOKE  parent slot
  //   5 DEBUG_PRINT       OBSERVE row dump
  pub let USBH_OP_QUERY_KEY        : u64 = 0
  pub let USBH_OP_QUERY_PORT_COUNT : u64 = 1
  pub let USBH_OP_QUERY_TT         : u64 = 2
  pub let USBH_OP_QUERY_TIER       : u64 = 3
  pub let USBH_OP_QUERY_PARENT     : u64 = 4
  pub let USBH_OP_DEBUG_PRINT      : u64 = 5
  pub let USBH_OP_MAX              : u64 = 5

  // Failure taxonomy — 0xFFFFFEF0..0xFFFFFEFF (per task spec).
  pub let USBH_OK                 : u64 = 0
  pub let USBH_TAIL_ENOSPC        : u64 = 0xFFFFFEFF
  pub let USBH_TAIL_BAD_ARG       : u64 = 0xFFFFFEFE
  pub let USBH_MINT_BAD_PARENT    : u64 = 0xFFFFFEFD
  pub let USBH_MINT_BAD_RIGHTS    : u64 = 0xFFFFFEFC
  pub let USBH_MINT_BAD_PORTS     : u64 = 0xFFFFFEFB
  pub let USBH_MINT_BAD_TIER      : u64 = 0xFFFFFEFA
  pub let USBH_MINT_BAD_TT        : u64 = 0xFFFFFEF9
  pub let USBH_MINT_NO_DEVICE     : u64 = 0xFFFFFEF8
  pub let USBH_MINT_ENOSPC        : u64 = 0xFFFFFEF7
  pub let USBH_MINT_IN_USE        : u64 = 0xFFFFFEF6
  pub let USBH_BAD_SLOT           : u64 = 0xFFFFFEF5
  pub let USBH_WRONG_KIND         : u64 = 0xFFFFFEF4
  pub let USBH_REVOKE_ALREADY     : u64 = 0xFFFFFEF3

  pub let USBH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let USBH_ROW_NONE   : u64 = 0xFF

  // Table sizing and row layout.
  //
  // EIGHT ROWS — enough for root + external hub chains a T14 G4 typically
  // wires. 32-byte rows so index is `shl 5`.
  //
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  hub_key (== inherited device_key)
  //   [+16] tail:   port_count[7:0] | tt_supported[15:8] | tier[23:16]
  //   [+24] reserved (zero)
  pub let USBH_MAX       : u64 = 8
  pub let USBH_ROW_BYTES : u64 = 32

  pub let mut _usb_hub_table : [u64; 32] = uninit @align(64)
  pub let mut _usb_hub_stats : [u64; 4]  = uninit @align(64)

  pub let USBH_ST_MINTS   : u64 = 0
  pub let USBH_ST_REVOKES : u64 = 1
  pub let USBH_ST_IN_USE  : u64 = 2
  pub let USBH_ST_ENOSPC  : u64 = 3

  // R51 boot-transcript §5 Bug B: strip embedded '\n' (composer emits its own).
  pub let usbh_dbg_msg : [u8; 15] = "USB HUB ROW\0\0\0\0"
  pub let usbh_k_row   : [u8; 4]  = "row\0"
  pub let usbh_k_prt   : [u8; 5]  = "ports\0"
  pub let usbh_k_tt    : [u8; 3]  = "tt\0"
  pub let usbh_k_tier  : [u8; 5]  = "tier\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let usb_hub_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): clear USB hub rows and counters. Labels prefixed usbh_rs_.",
      block: {
        lea r10, [rip + _usb_hub_table];
        xor rax, rax;
        xor rcx, rcx;
      usbh_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  usbh_rs_rows;

        lea r10, [rip + _usb_hub_stats];
        xor rcx, rcx;
      usbh_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  usbh_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let usb_hub_port_count_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): 1 iff n in [PORT_MIN, PORT_MAX] = [1, 15]. Labels prefixed usbh_pv_.",
      block: {
        cmp rdi, 1;
        jb  usbh_pv_no;
        cmp rdi, 15;
        ja  usbh_pv_no;
        mov rax, 1;
        ret;
      usbh_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_hub_tier_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): 1 iff t in [1, 5]. Labels prefixed usbh_tv_.",
      block: {
        cmp rdi, 1;
        jb  usbh_tv_no;
        cmp rdi, 5;
        ja  usbh_tv_no;
        mov rax, 1;
        ret;
      usbh_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_hub_tt_valid : (u64) -> u64 !{} @{} =
    fn (tt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): 1 iff tt in {0, 1}. Labels prefixed usbh_ttv_.",
      block: {
        cmp rdi, 1;
        ja  usbh_ttv_no;
        mov rax, 1;
        ret;
      usbh_ttv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_hub_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): subset test against R_USB_HUB_ALL = 0x419. Labels prefixed usbh_rvv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne usbh_rvv_no;
        mov rax, 1;
        ret;
      usbh_rvv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let usb_hub_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): counter bump. Labels prefixed usbh_nt_.",
      block: {
        cmp rdi, 4;
        jae usbh_nt_out;
        lea r10, [rip + _usb_hub_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      usbh_nt_out:
        ret
      }
    }

  pub let usb_hub_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): counter read. Labels prefixed usbh_st_.",
      block: {
        cmp rdi, 4;
        jae usbh_st_zero;
        lea r10, [rip + _usb_hub_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      usbh_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be a live KIND_USB_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let usb_hub_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): parent must be live KIND_USB_DEVICE (0x162) with RIGHT_MINT. §2's gate. Labels prefixed usbh_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae usbh_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x162;                  // KIND_USB_DEVICE
        cmp r10, r11;
        jne usbh_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  usbh_cp_no;

        mov rax, 1;
        ret;
      usbh_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_hub_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): inherited hub_key from parent KIND_USB_DEVICE. The parent target_ptr[15:0] is the USB device row_id; we lookup that row's device_key. Zero on failure. Labels prefixed usbh_pk_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;

        mov r11, 256;
        cmp r12, r11;
        jae usbh_pk_zero;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x162;
        cmp r10, r11;
        jne usbh_pk_zero;

        mov r13, [rax + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // parent's row_id

        mov rdi, r13;
        call usb_device_row_key;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbh_pk_zero;
        jmp usbh_pk_out;

      usbh_pk_zero:
        xor rax, rax;
      usbh_pk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let usb_hub_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): (parent_slot << 8). Labels prefixed usbh_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae usbh_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      usbh_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_hub_body_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (port_count: u64) (tt: u64) (tier: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): pack port_count[7:0] | tt[15:8] | tier[23:16]. Refuses out-of-range. Labels prefixed usbh_bp_.",
      block: {
        cmp rdi, 1;
        jb  usbh_bp_bad;
        cmp rdi, 15;
        ja  usbh_bp_bad;
        cmp rsi, 1;
        ja  usbh_bp_bad;
        cmp rdx, 1;
        jb  usbh_bp_bad;
        cmp rdx, 5;
        ja  usbh_bp_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      usbh_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/free.
  // ==========================================================================

  pub let usb_hub_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (hub_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): claim one USB hub row. THE ONE WRITER of _usb_hub_table. Labels prefixed usbh_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // hub_key
        mov r14, rdx;                    // body_packed

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne usbh_ta_bad;

        cmp r13, 0;
        je  usbh_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  usbh_ta_bad;

        xor rbx, rbx;
      usbh_ta_scan:
        cmp rbx, 8;
        jae usbh_ta_enospc;

        lea r10, [rip + _usb_hub_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbh_ta_claim;

        add rbx, 1;
        jmp usbh_ta_scan;

      usbh_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp usbh_ta_out;

      usbh_ta_enospc:
        mov rax, 0xFFFFFEFF;
        jmp usbh_ta_out;
      usbh_ta_bad:
        mov rax, 0xFFFFFEFE;

      usbh_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_hub_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): 1 iff row_id < MAX and in_use. Labels prefixed usbh_tvr_.",
      block: {
        cmp rdi, 8;
        jae usbh_tvr_no;
        lea r10, [rip + _usb_hub_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbh_tvr_no;
        mov rax, 1;
        ret;
      usbh_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_hub_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): scrub one row. Labels prefixed usbh_tf_.",
      block: {
        cmp rdi, 8;
        jae usbh_tf_out;
        lea r10, [rip + _usb_hub_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      usbh_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let usb_hub_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): hub_key. Labels prefixed usbh_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_hub_tail_valid;
        cmp rax, 0;
        je  usbh_rk_bad;
        lea r10, [rip + _usb_hub_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp usbh_rk_out;
      usbh_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_hub_row_port_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): port_count. Labels prefixed usbh_rpc_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_hub_tail_valid;
        cmp rax, 0;
        je  usbh_rpc_bad;
        lea r10, [rip + _usb_hub_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp usbh_rpc_out;
      usbh_rpc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_rpc_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_hub_row_tt : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): tt_supported. Labels prefixed usbh_rtt_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_hub_tail_valid;
        cmp rax, 0;
        je  usbh_rtt_bad;
        lea r10, [rip + _usb_hub_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFF;
        jmp usbh_rtt_out;
      usbh_rtt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_rtt_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_hub_row_tier : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): tier. Labels prefixed usbh_rtr_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_hub_tail_valid;
        cmp rax, 0;
        je  usbh_rtr_bad;
        lea r10, [rip + _usb_hub_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFF;
        jmp usbh_rtr_out;
      usbh_rtr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_rtr_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_hub_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): parent slot. Labels prefixed usbh_rpa_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_hub_tail_valid;
        cmp rax, 0;
        je  usbh_rpa_bad;
        lea r10, [rip + _usb_hub_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp usbh_rpa_out;
      usbh_rpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_rpa_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let usb_hub_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (hub_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): live row holding this hub_key, or ROW_NONE. Labels prefixed usbh_fk_.",
      block: {
        cmp rdi, 0;
        je  usbh_fk_none;
        xor rcx, rcx;
      usbh_fk_scan:
        cmp rcx, 8;
        jae usbh_fk_none;
        lea r10, [rip + _usb_hub_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbh_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  usbh_fk_hit;
      usbh_fk_next:
        add rcx, 1;
        jmp usbh_fk_scan;
      usbh_fk_hit:
        mov rax, rcx;
        ret;
      usbh_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let usb_hub_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): slot -> row_id, gated on live KIND_USB_HUB. ARITY ONE. Labels prefixed usbh_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae usbh_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x163;
        cmp r10, r11;
        jne usbh_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call usb_hub_tail_valid;
        cmp rax, 0;
        je  usbh_ros_none;

        mov rax, r12;
        jmp usbh_ros_out;

      usbh_ros_none:
        mov rax, 0xFF;
      usbh_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_hub_port_count_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): port_count, ARITY ONE. Labels prefixed usbh_pcs_.",
      block: {
        push r12; push r13; push r14;
        call usb_hub_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  usbh_pcs_bad;
        mov rdi, r12;
        call usb_hub_row_port_count;
        jmp usbh_pcs_out;
      usbh_pcs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_pcs_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_hub_tt_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): tt_supported, ARITY ONE. Labels prefixed usbh_tts_.",
      block: {
        push r12; push r13; push r14;
        call usb_hub_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  usbh_tts_bad;
        mov rdi, r12;
        call usb_hub_row_tt;
        jmp usbh_tts_out;
      usbh_tts_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_tts_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_hub_tier_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): tier, ARITY ONE. Labels prefixed usbh_trs_.",
      block: {
        push r12; push r13; push r14;
        call usb_hub_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  usbh_trs_bad;
        mov rdi, r12;
        call usb_hub_row_tier;
        jmp usbh_trs_out;
      usbh_trs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbh_trs_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.
  // ==========================================================================

  pub let usb_hub_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (port_count: u64) (tt: u64) (tier: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): mint a KIND_USB_HUB over a KIND_USB_DEVICE. Sequence: slot<256; check_parent (parent is KIND_USB_DEVICE); rights valid; port_count in [1,15]; tt in {0,1}; tier in [1,5]; inherit hub_key from parent's USB device row; uniqueness on hub_key; hdr_pack + body_pack + tail_alloc; cap_mint_write. Labels prefixed usbh_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // port_count
        mov r15, r8;                     // tt
        mov rbp, r9;                     // tier

        mov r10, 256;
        cmp rbx, r10;
        jae usbh_mi_bad_slot;

        mov rdi, r12;
        call usb_hub_check_parent;
        cmp rax, 0;
        je  usbh_mi_bad_parent;

        mov rdi, r13;
        call usb_hub_rights_valid;
        cmp rax, 0;
        je  usbh_mi_bad_rights;

        mov rdi, r14;
        call usb_hub_port_count_valid;
        cmp rax, 0;
        je  usbh_mi_bad_ports;

        mov rdi, r15;
        call usb_hub_tt_valid;
        cmp rax, 0;
        je  usbh_mi_bad_tt;

        mov rdi, rbp;
        call usb_hub_tier_valid;
        cmp rax, 0;
        je  usbh_mi_bad_tier;

        mov rdi, r12;
        call usb_hub_parent_key;
        cmp rax, 0;
        je  usbh_mi_no_device;
        push rax;                        // hub_key (from parent)
        sub rsp, 8;

        mov rdi, rax;
        call usb_hub_find_by_key;
        add rsp, 8;
        pop rcx;                         // hub_key
        cmp rax, 0xFF;
        jne usbh_mi_in_use;
        mov r10, rcx;                    // r10 = hub_key

        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call usb_hub_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbh_mi_bad_parent;
        push r10;
        push rax;                        // hdr

        mov rdi, r14;
        mov rsi, r15;
        mov rdx, rbp;
        call usb_hub_body_pack;
        pop rcx;                         // hdr
        pop r10;                         // hub_key
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbh_mi_bad_ports;

        mov rdi, rcx;                    // hdr
        mov rsi, r10;                    // hub_key
        mov rdx, rax;                    // body
        call usb_hub_tail_alloc;

        mov r10, 0xFFFFFEFF;
        cmp rax, r10;
        je  usbh_mi_enospc;
        mov r10, 0xFFFFFEFE;
        cmp rax, r10;
        je  usbh_mi_bad_ports;

        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x163;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;

        mov rdi, 0;
        call usb_hub_note;

        xor rax, rax;
        jmp usbh_mi_out;

      usbh_mi_bad_slot:
        mov rax, 0xFFFFFEF5;
        jmp usbh_mi_out;
      usbh_mi_bad_parent:
        mov rax, 0xFFFFFEFD;
        jmp usbh_mi_out;
      usbh_mi_bad_rights:
        mov rax, 0xFFFFFEFC;
        jmp usbh_mi_out;
      usbh_mi_bad_ports:
        mov rax, 0xFFFFFEFB;
        jmp usbh_mi_out;
      usbh_mi_bad_tier:
        mov rax, 0xFFFFFEFA;
        jmp usbh_mi_out;
      usbh_mi_bad_tt:
        mov rax, 0xFFFFFEF9;
        jmp usbh_mi_out;
      usbh_mi_no_device:
        mov rax, 0xFFFFFEF8;
        jmp usbh_mi_out;
      usbh_mi_in_use:
        mov rdi, 2;
        call usb_hub_note;
        mov rax, 0xFFFFFEF6;
        jmp usbh_mi_out;
      usbh_mi_enospc:
        mov rdi, 3;
        call usb_hub_note;
        mov rax, 0xFFFFFEF7;

      usbh_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_hub_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (port_count: u64) (tt: u64) (tier: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call usb_hub_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x163;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let usb_hub_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): revoke KIND_USB_HUB. Labels prefixed usbh_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae usbh_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  usbh_rvk_already;

        mov r11, 0x163;
        cmp r10, r11;
        jne usbh_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call usb_hub_tail_valid;
        cmp rax, 0;
        je  usbh_rvk_clear;

        mov rdi, r13;
        call usb_hub_tail_free;

      usbh_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call usb_hub_note;

        xor rax, rax;
        jmp usbh_rvk_out;

      usbh_rvk_bad_slot:
        mov rax, 0xFFFFFEF5;
        jmp usbh_rvk_out;
      usbh_rvk_wrong_kind:
        mov rax, 0xFFFFFEF4;
        jmp usbh_rvk_out;
      usbh_rvk_already:
        mov rax, 0xFFFFFEF3;

      usbh_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_hub_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call usb_hub_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x163;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch.
  // ==========================================================================

  pub let cap_handler_usb_hub : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): KIND_USB_HUB dispatch handler. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed usbh_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_usb_hub_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne usbh_hn_res;

        cmp rbp, 5;
        ja  usbh_hn_unsup;

        cmp rbp, 5;
        je  usbh_hn_dbg;

        // Ops 0..4: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  usbh_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  usbh_hn_key;
        cmp rbp, 1;
        je  usbh_hn_pc;
        cmp rbp, 2;
        je  usbh_hn_tt;
        cmp rbp, 3;
        je  usbh_hn_tr;
        call usb_hub_row_parent;
        jmp usbh_hn_out;

      usbh_hn_key:
        call usb_hub_row_key;
        jmp usbh_hn_out;
      usbh_hn_pc:
        call usb_hub_row_port_count;
        jmp usbh_hn_out;
      usbh_hn_tt:
        call usb_hub_row_tt;
        jmp usbh_hn_out;
      usbh_hn_tr:
        call usb_hub_row_tier;
        jmp usbh_hn_out;

      usbh_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  usbh_hn_denied;
        xor rax, rax;
        jmp usbh_hn_out;

      usbh_hn_res:
        mov rax, 0xFFFFFEFE;
        jmp usbh_hn_out;
      usbh_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp usbh_hn_out;
      usbh_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      usbh_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
