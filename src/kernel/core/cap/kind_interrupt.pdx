// src/kernel/core/cap/kind_interrupt.pdx — Wave 59 D1 (#2518) skeleton
//
// Implements: design/drivers/kind-interrupt.md (Wave 60).
//
// KIND_INTERRUPT derived-kind structural stub: declares the kind tag,
// rights discipline, backing-table .bss reservation, and the seven
// entrypoints — the dispatch handler `cap_handler_interrupt` (preserved
// from the pre-R29 R13-m6-006 stub so cap_invoke_dispatch's slot-9
// routing at invoke.pdx:1373 keeps resolving) plus the six operation
// entrypoints enumerated by the Wave 59 D1 user story (int_cap_mint,
// int_cap_revoke, int_cap_mask, int_cap_unmask, int_cap_rebind_affinity,
// int_cap_dispatch). Every entrypoint emits a `.rodata` dispatch-chatter
// tag through klog_s1 (SUBSYS_CAP_, KLOG_INFO) and returns
// INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC). Real bodies — vector-pool
// alloc gate, parent-cap kind check, notification-slot cross-check,
// vector-table publication, ISR dispatch core, cascade-revoke extension —
// land in the Wave 59 D1 follow-up slice per
// `design/drivers/kind-interrupt.md §1, §2`.
//
// Design reference
// ----------------
// `design/drivers/kind-interrupt.md` (Wave 60) is the binding spec for
// this file. Sibling patterns copied verbatim from `kind_hw_timeline.pdx`
// (Wave 59 D3 skeleton) and `kind_hw_interrupt.pdx` (R29.M1-001); the
// descriptor-tail layout mirrors `kind_hw_msix_vector.pdx` (R29.M1-004).
//
// Numeric derived-kind tag
// ------------------------
// KIND_INTERRUPT = 0x50 (decimal 80). Deliberately above the 4-bit base-
// slot range (0..15) and distinct from every existing derived-kind tag
// (KIND_INTERRUPT_CAP=0x40 — retired alias per design §4.6,
// KIND_NOTIFICATION_CAP=0x41, KIND_HW_INTERRUPT=0x140,
// KIND_HW_MSIX_VECTOR=0x141). Base slot 9 (KIND_INTERRUPT) stays as the
// LAM kind-hint fast-dispatch anchor; `cap_handler_interrupt` reads the
// full u64 kind field at descriptor offset 0 and will route 0x50 to the
// new per-op body in the follow-up slice (today every op returns
// INVOKE_UNSUPPORTED).
//
// Descriptor tail (16 bytes exactly, per design §1.2)
// ---------------------------------------------------
//   [+0]  u8:  vector            — IDT vector in [0x60..0xEF]
//   [+1]  u8:  parent_hw_int_slot — cap_table slot of parent KIND_HW_INTERRUPT
//                                   (0xFF = synthesized / overlay mode)
//   [+2]  u16: notif_slot        — paired KIND_NOTIFICATION cap slot
//   [+4]  u16: rights            — subset of R_INT_ALL
//   [+6]  u16: cpu_idx           — dense logical CPU index
//   [+8]  u16: pending_count     — saturating; incremented by ISR, decremented by ACK
//  [+10]  u8:  flags             — bit 0 MUTED_SW, bit 1 MUTED_HW, bit 2 LEVEL_TRIGGER
//  [+11]  5*u8: _reserved        — zero-initialized; future delivery policy
//
// Full rationale in `design/drivers/kind-interrupt.md §1.2`.
//
// Backing table (per user spec — Wave 59 D1 directive)
// ----------------------------------------------------
// _kind_interrupt_table : 256 rows × 32 bytes = 8192 bytes .bss, align 64.
// Each row is a staging area for the follow-up slice's tail encoder; row
// index is the slot handle carried in the descriptor's target_ptr. The
// 256-row cap matches the IDT vector space; a sparse row at index v is
// addressable as `_kind_interrupt_table[v * 4 .. v * 4 + 3]` (four u64s
// = 32 bytes). This differs from the hot `_int_vector_table[144]`
// (follow-up slice; one 8-byte notif pointer per MSI-X-pool vector)
// which lives in `src/kernel/core/int/kind_dispatch.pdx`; the table in
// this file holds the cap-row state, not the ISR fast-path pointer.
//
// Rights (subset of R_INT_ALL = 0x7F, per design §1.3)
// ----------------------------------------------------
//   R_INT_RECEIVE (0x01) — bind to notification + receive signals
//   R_INT_ACK     (0x02) — OP_ACK: decrement pending_count + EOI
//   R_INT_MASK_SW (0x04) — OP_MASK_SW / OP_UNMASK_SW: pointer-level mute
//   R_INT_MASK_HW (0x08) — OP_MASK_HW / OP_UNMASK_HW: cascade to parent
//   R_INT_OBSERVE (0x10) — OP_QUERY_VECTOR / _CPU / _PENDING / _FLAGS
//   R_INT_REBIND  (0x20) — revoke + remint shortcut
//   R_INT_REVOKE  (0x40) — supervisor revoke path
//
// Return codes (per user directive: 4-code block 0xFFFFFFC0..0xFFFFFFC3)
// ----------------------------------------------------------------------
// Deliberately disjoint from timeline (0xFFFFFFC4..CF), DMA
// (0xFFFFFFD1..DF), MSIX (0xFFFFFFE7..EF), HW_INT (0xFFFFFFF7..FF), and
// the DRV_REG cluster (0xFFFFFC50..5F). The design doc §2.2 proposed
// 0xFFFF..FF..F9 but those collide with the standard INVOKE_UNSUPPORTED
// (0xFF..FC) / INVOKE_DENIED (0xFF..FD) sentinels and the HW_INT reserve;
// this file claims a clean low-byte block below the timeline reserve so
// a witness failure names its originating kind unambiguously. The real
// bodies will extend the block as additional error conditions surface
// (BAD_NOTIF, VEC_IN_USE, ENOSPC per design §2.2).
//
// What this file does NOT do yet (deferred to the follow-up slice)
// ----------------------------------------------------------------
//   * Vector-table publication (`_int_vector_table[144]` in
//     src/kernel/core/int/kind_dispatch.pdx).
//   * Per-vector ISR trampolines (`_kind_dispatch_vec_v` for 0x60..0xEF).
//   * Vector-pool integration (`vector_alloc_for_cpu` / `_free_for_cpu`
//     from apic/vector_pool.pdx) in mint / revoke.
//   * Parent-kind gate on mint: cap_table[parent_slot].kind == 0x140 and
//     parent carries R_HW_INT_MINT.
//   * Notification-slot cross-check: cap_table[notif_slot].kind ==
//     KIND_NOTIFICATION.
//   * Descriptor-tail encoder/decoder (int_tail_pack / _decode_*).
//   * Cascade-revoke extension in `hw_int_cap_revoke` for kind == 0x50
//     children.
//   * Dispatch wiring: 0x50 branch in `cap_handler_interrupt` body.
//   * Per-event fingerprint tags enumerated in design §5.1
//     (INT KIND MINT OK / REVOKE OK / MASK SW / DISPATCH / ACK / ...).
//   * Legacy-overlay dual-wire into `_isr_stub_36` (UART RX) per §4.3.
//   * `KIND_INTERRUPT_CAP = 0x40` retirement path per §4.6.
//
// The skeleton compiles under paideia-as v0.36.81 and emits witness
// chatter so a boot-witness can observe the entry sites are wired; every
// entrypoint returns INVOKE_UNSUPPORTED so a mis-wired dispatch cannot
// create a cap that silently claims a slot.

module KindInterrupt = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================

  // Runtime base kind (LAM kind-hint slot): KIND_INTERRUPT = 9.
  // Pre-existing in src/kernel/core/cap/kind.pdx line 88.
  pub let KIND_INTERRUPT_BASE : u64 = 9

  // Derived-kind tag. Value 0x50 (decimal 80); above the 4-bit base-slot
  // range, below the R29 derived-kind block (0x140..0x143). Design §1.1.
  pub let KIND_INTERRUPT : u64 = 0x50

  // Retired alias (design §4.6). Pre-existing in interrupt_cap.pdx; this
  // skeleton reserves the symbol so the retirement path can land as a
  // one-line alias change in the follow-up slice.
  pub let KIND_INTERRUPT_CAP_ALIAS : u64 = 0x40

  // Parent kind for the mint-time authority gate: KIND_HW_INTERRUPT.
  pub let KIND_INT_PARENT_HW_INT : u64 = 0x140

  // Paired notification kind the ISR posts to on dispatch.
  pub let KIND_INT_NOTIF : u64 = 12

  // ============================================================================
  // Rights (subset legal on a KIND_INTERRUPT capability, design §1.3)
  // ============================================================================

  pub let R_INT_RECEIVE : u64 = 0x01
  pub let R_INT_ACK     : u64 = 0x02
  pub let R_INT_MASK_SW : u64 = 0x04
  pub let R_INT_MASK_HW : u64 = 0x08
  pub let R_INT_OBSERVE : u64 = 0x10
  pub let R_INT_REBIND  : u64 = 0x20
  pub let R_INT_REVOKE  : u64 = 0x40
  pub let R_INT_ALL     : u64 = 0x7F

  // Default-mint right set handed to a driver on probe (design §1.3):
  // RECEIVE | ACK | MASK_SW | OBSERVE = 0x17.
  pub let R_INT_DRIVER_DEFAULT : u64 = 0x17

  // Supervisor-only right set (design §1.3): MASK_HW | REBIND | REVOKE = 0x68.
  pub let R_INT_SUPERVISOR : u64 = 0x68

  // ============================================================================
  // Vector space + per-row flags (design §1.2, §4.2)
  // ============================================================================

  // MSI-X pool floor and ceiling (vectors in [0x60..0xEF] are KIND-mediated
  // by default per design §4.2).
  pub let INT_VECTOR_POOL_LO : u64 = 0x60
  pub let INT_VECTOR_POOL_HI : u64 = 0xEF

  // Overlay-range floor (ISA legacy vectors 0x20..0x2F, design §4.3).
  pub let INT_VECTOR_OVERLAY_LO : u64 = 0x20
  pub let INT_VECTOR_OVERLAY_HI : u64 = 0x2F

  // Synthesized-parent sentinel for overlay caps (design §1.2).
  pub let INT_PARENT_SYNTHESIZED : u64 = 0xFF

  // Muted-slot sentinel for the vector-table pointer (design §1.5, §2.4).
  // Zero also means muted; 0x1 is the explicit mute marker that
  // distinguishes "deliberately muted" from "never bound".
  pub let INT_VECTOR_MUTED_SENTINEL : u64 = 0x1

  // Flag bits in the tail's [+10] byte (design §1.2).
  pub let INT_FLAG_MUTED_SW      : u64 = 0x01
  pub let INT_FLAG_MUTED_HW      : u64 = 0x02
  pub let INT_FLAG_LEVEL_TRIGGER : u64 = 0x04

  // Saturating pending_count ceiling (design §1.2, §6.5).
  pub let INT_PENDING_SATURATED : u64 = 0xFFFF

  // ============================================================================
  // Table caps + field domains
  // ============================================================================

  // Per Wave 59 D1 user spec: 256 rows × 32 bytes = 8 KiB .bss. The 256
  // cap matches the IDT vector space one-to-one so a row index can serve
  // as a vector identifier in the follow-up slice without a secondary
  // lookup table.
  pub let KIND_INT_ROWS      : u64 = 256
  pub let KIND_INT_ROW_BYTES : u64 = 32

  // ============================================================================
  // Ops (op_arg[7:0] = op_code, design §1.4)
  // ============================================================================

  pub let INT_OP_QUERY_VECTOR  : u64 = 0
  pub let INT_OP_QUERY_CPU     : u64 = 1
  pub let INT_OP_QUERY_PENDING : u64 = 2
  pub let INT_OP_QUERY_FLAGS   : u64 = 3
  pub let INT_OP_ACK           : u64 = 4
  pub let INT_OP_MASK_SW       : u64 = 5
  pub let INT_OP_UNMASK_SW     : u64 = 6
  pub let INT_OP_MASK_HW       : u64 = 7
  pub let INT_OP_UNMASK_HW     : u64 = 8
  pub let INT_OP_BIND_NOTIF    : u64 = 9
  pub let INT_OP_UNBIND_NOTIF  : u64 = 10
  pub let INT_OP_REBIND_CPU    : u64 = 11

  // ============================================================================
  // Trigger-mode enumeration (int_cap_mint arg3)
  // ============================================================================

  pub let INT_TRIGGER_EDGE  : u64 = 0
  pub let INT_TRIGGER_LEVEL : u64 = 1

  // ============================================================================
  // Return codes
  //
  // Block 0xFFFFFFC0..0xFFFFFFC3 — INT_MINT_* family (per Wave 59 D1
  // directive). Disjoint from timeline (0xFFFFFFC4..CF), DMA
  // (0xFFFFFFD1..DF), MSIX (0xFFFFFFE7..EF), HW_INT (0xFFFFFFF7..FF),
  // and from DRV_REG (0xFFFFFC50..5F). The design doc §2.2 enumerated
  // eight mint codes using the 0xFFFF..FF..F9 ladder which collides
  // with the standard INVOKE_UNSUPPORTED / INVOKE_DENIED sentinels;
  // this skeleton claims a clean 4-code block below the timeline
  // reserve and defers the remaining codes (BAD_NOTIF, VEC_IN_USE,
  // ENOSPC) to the follow-up slice which will extend the block
  // contiguously downward.
  // ============================================================================

  pub let INT_MINT_OK          : u64 = 0
  pub let INT_MINT_BAD_VECTOR  : u64 = 0xFFFFFFC0
  pub let INT_MINT_BAD_CPU     : u64 = 0xFFFFFFC1
  pub let INT_MINT_BAD_RIGHTS  : u64 = 0xFFFFFFC2
  pub let INT_MINT_BAD_PARENT  : u64 = 0xFFFFFFC3

  // Standard dispatch-return sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Idempotent-revoke sentinel (shared with HW_INT family).
  pub let INT_REVOKE_ALREADY : u64 = 0xFFFFFFFFFFFFFFF7

  // ============================================================================
  // Backing table (.bss, align 64)
  //
  // 256 rows × 32 bytes = 8192 bytes = 1024 u64s. .bss zero-init means
  // every row starts with in_use=0 (future convention: byte 7 of the
  // [+0] u64, mirroring HW_INT / timeline), which is the free sentinel
  // the real tail-alloc path will scan for in the follow-up slice.
  //
  // Row layout rationale: 32 bytes per row leaves 16 bytes for the
  // descriptor-tail state enumerated in design §1.2 (vector, parent,
  // notif, rights, cpu_idx, pending, flags, reserved) plus 16 bytes of
  // headroom for the follow-up slice's hot-path cache (last-ACK TSC
  // snapshot, affinity-override shadow, etc). Not yet laid out — the
  // skeleton reserves the storage and leaves fields unassigned.
  // ============================================================================

  pub let mut _kind_interrupt_table : [u64; 1024] = uninit @align(64)

  // Monotonic generation counter — bumps on every mint, revoke, mask,
  // unmask, and rebind. Caps carry the generation at mint time;
  // cap_invoke_dispatch compares and fails stale caps with INVOKE_DENIED.
  // Initialized to zero via .bss; the first mint bumps to 1.
  pub let mut _kind_interrupt_generation : u64 = 0

  // ============================================================================
  // Dispatch-chatter tag (.rodata)
  //
  // Declared in-module (rather than in tags.pdx) for the skeleton wave:
  // the stub body references exactly one tag and declaring it here
  // keeps the skeleton PR self-contained. The follow-up slice relocates
  // this symbol into tags.pdx alongside its siblings (cap_hw_int_msg /
  // cap_hw_msix_msg / cap_dma_dom_msg / cap_hw_timeline_msg) and adds
  // the per-event fingerprint tags enumerated in design §5.1:
  //   INT KIND MINT OK / INT KIND REVOKE OK / INT KIND MASK SW /
  //   INT KIND UNMASK SW / INT KIND MASK HW / INT KIND UNMASK HW /
  //   INT KIND BIND NOTIF / INT KIND UNBIND NOTIF / INT KIND REBIND CPU /
  //   INT KIND DISPATCH / INT KIND ACK / INT KIND MINT ERR.
  //
  // Distinct from the pre-R29 `cap_int_msg` (tags.pdx:90, "legacy
  // interrupt invocation") which belongs to the retired KIND_INTERRUPT_CAP
  // = 0x40 shim; the new tag names the Wave 59 D1 KIND_INTERRUPT = 0x50
  // path. Both coexist during the retirement interval (design §4.6).
  // ============================================================================

  pub let cap_kind_int_msg : [u8; 32] = "KIND_INTERRUPT dispatch invoked\0"

  // ============================================================================
  // cap_handler_interrupt(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler. Preserved from the pre-R29 R13-m6-006 (#454) stub
  // so `cap_invoke_dispatch`'s slot-9 routing at invoke.pdx:1373
  // (`call cap_handler_interrupt`) keeps resolving. Will be extended by
  // the follow-up slice to compare the full u64 kind field at
  // descriptor+0 against 0x50 and route per the design §1.4 op table.
  //
  // Skeleton: emits dispatch chatter and returns INVOKE_UNSUPPORTED for
  // every op. RDI=rights, RSI=target_ptr, RDX=op_arg — matches every
  // other kind_*.pdx handler.
  // ============================================================================

  pub let cap_handler_interrupt : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D1 (#2518) skeleton: KIND_INTERRUPT dispatch handler. Preserves the pre-R29 R13-m6-006 symbol so invoke.pdx:1373 keeps resolving. Emits klog_s1(INFO, SUBSYS_CAP_, cap_kind_int_msg) chatter so a boot-witness can observe the entry site is wired, and returns INVOKE_UNSUPPORTED (0xFF..FC) for every op. Op-routing (QUERY_VECTOR / _CPU / _PENDING / _FLAGS / ACK / MASK_SW / UNMASK_SW / MASK_HW / UNMASK_HW / BIND_NOTIF / UNBIND_NOTIF / REBIND_CPU) and the 0x50-vs-0x40 compat shim land in the follow-up slice per design §1.4 and §4.6. RDI-preserve discipline unneeded here because the stub does not read its args after the klog_s1 call.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_kind_int_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // int_cap_mint(vector, cpu_affinity, trigger_mode, handler_fn, context_ptr)
  //              -> u64 (Cap slot on success)
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will:
  //   - validate vector ∈ [0x60..0xEF] -> INT_MINT_BAD_VECTOR
  //   - validate cpu_affinity bit index < VECTOR_POOL_MAX_CPUS
  //     -> INT_MINT_BAD_CPU
  //   - validate trigger_mode ∈ {INT_TRIGGER_EDGE, INT_TRIGGER_LEVEL}
  //   - resolve parent KIND_HW_INTERRUPT via caller's holding slot
  //     -> INT_MINT_BAD_PARENT
  //   - validate the notification slot kind == KIND_NOTIFICATION (via
  //     context_ptr-indexed slot) -> INT_MINT_BAD_NOTIF (future code)
  //   - vector_alloc_for_cpu(cpu_idx, vector) -> INT_MINT_VEC_IN_USE
  //   - allocate a cap_table slot; populate the 16-byte tail per §1.2
  //   - publish `_int_vector_table[vector - 0x60] = &cap_table[notif]`
  //   - emit "INT KIND MINT OK vec=0x<nn> cpu=<cc> slot=<ss>" fingerprint
  //   - return the new cap slot number
  //
  // NOTE: the `handler_fn` parameter is a design placeholder for the
  // supervisor's mint-dispatch tail; it is NOT a userspace function
  // pointer registered against the ISR (per design INT-D3 the kernel
  // never calls a userspace handler from an interrupt context). The
  // real body consumes it as the supervisor-side callback for cap
  // ownership transfer. See design §2.3.
  //
  // SysV ABI: rdi=vector, rsi=cpu_affinity, rdx=trigger_mode,
  //           rcx=handler_fn, r8=context_ptr. Five args fit in SysV's
  //           6-register cap without a stack spill.
  // ============================================================================

  pub let int_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (vector: u64) (cpu_affinity: u64) (trigger_mode: u64)
       (handler_fn: u64) (context_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D1 (#2518) skeleton: KIND_INTERRUPT mint entry. Emits klog_s1(INFO, SUBSYS_CAP_, cap_kind_int_msg) chatter so a boot-witness can observe the entry site is wired, and returns INVOKE_UNSUPPORTED (0xFF..FC) — the real body (follow-up slice per design/drivers/kind-interrupt.md §2.1) assembles the four-leg authority gate (KIND_DRIVER.R_DRIVER_IRQ, KIND_HW_INTERRUPT.R_HW_INT_MINT, KIND_NOTIFICATION.R_NOTIFY_RECV, vector_alloc_for_cpu) and publishes the vector-table pointer. The five-arg signature below SysV's 6-register cap does not force a stack spill. RDI-preserve not needed in the skeleton: args are not read after klog_s1.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_kind_int_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // int_cap_revoke(cap_slot) -> u64
  //
  // Skeleton. Emits dispatch chatter and returns INVOKE_UNSUPPORTED.
  // Real body (follow-up slice) will walk design §1.5:
  //   - validate cap_table[cap_slot].kind == 0x50
  //   - software-mask: store 0 (or INT_VECTOR_MUTED_SENTINEL) into
  //     `_int_vector_table[vector - 0x60]`
  //   - decrement parent's cascade-child count (if parent != 0xFF)
  //   - release the (vector, cpu_idx) pair via vector_free_for_cpu
  //   - unbind the _msix_assignments lane
  //   - clear the cap_table slot (kind=0, rights=0, tail zeroed)
  //   - leave the paired notification cap intact (design §1.5 point 7)
  //   - emit "INT KIND REVOKE OK vec=0x<nn> cpu=<cc> slot=<ss>"
  //   - already-revoked slot returns INT_REVOKE_ALREADY, no side effects
  //
  // SysV ABI: rdi = cap_slot.
  // ============================================================================

  pub let int_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D1 (#2518) skeleton: KIND_INTERRUPT revoke entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design §1.5. Idempotency and cascade-from-parent cases are called out in the design doc; the follow-up slice extends hw_int_cap_revoke's child-walker in kind_hw_interrupt.pdx to recognize kind == 0x50 children with matching parent_hw_int_slot. Leaf shape; klog_s1 is the only call.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_kind_int_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // int_cap_mask(cap_slot) -> u64
  //
  // Software mask (design §1.4 OP_MASK_SW, INT-D5). Skeleton emits
  // dispatch chatter and returns INVOKE_UNSUPPORTED. Real body will:
  //   - rights gate R_INT_MASK_SW -> INVOKE_DENIED
  //   - decode cap_slot -> {vector, cpu_idx} from the row
  //   - atomic store: `_int_vector_table[vector - 0x60] =
  //     INT_VECTOR_MUTED_SENTINEL` (1)
  //   - set INT_FLAG_MUTED_SW in the tail's flags byte
  //   - emit "INT KIND MASK SW vec=0x<nn>" fingerprint
  //
  // Pointer-store is a single aligned 8-byte MOV; no IOAPIC/MSI-X mask
  // bit touched (that is OP_MASK_HW, int_cap_mask does NOT delegate).
  // Design INT-D5: software mask is the fast common case; hardware
  // mask is a separate op for the teardown-quiesce case.
  //
  // SysV ABI: rdi = cap_slot.
  // ============================================================================

  pub let int_cap_mask : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D1 (#2518) skeleton: KIND_INTERRUPT software-mask entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design §1.4 (OP_MASK_SW) and INT-D5. The pointer-level mask vs. the hardware mask (int_cap_mask vs. not-yet-named int_cap_mask_hw, both specified in the design doc §1.4) is the central performance split — this entrypoint stays on the fast single-store path and never calls down to the parent KIND_HW_INTERRUPT cap. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_kind_int_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // int_cap_unmask(cap_slot) -> u64
  //
  // Software unmask (design §1.4 OP_UNMASK_SW). Skeleton emits dispatch
  // chatter and returns INVOKE_UNSUPPORTED. Real body will:
  //   - rights gate R_INT_MASK_SW -> INVOKE_DENIED
  //   - decode cap_slot -> {vector, notif_slot}
  //   - atomic store: `_int_vector_table[vector - 0x60] =
  //     &cap_table[notif_slot]` (restore the notif pointer)
  //   - clear INT_FLAG_MUTED_SW in the tail's flags byte
  //   - emit "INT KIND UNMASK SW vec=0x<nn>" fingerprint
  //
  // Pointer restore is a single aligned 8-byte MOV; on x86-64 the TSO
  // ordering guarantees a racing ISR on another CPU sees either the
  // pre-unmask (muted) or the post-unmask (bound) value, never a torn
  // intermediate. Design INT-D4 argues this at length.
  //
  // SysV ABI: rdi = cap_slot.
  // ============================================================================

  pub let int_cap_unmask : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D1 (#2518) skeleton: KIND_INTERRUPT software-unmask entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design §1.4 (OP_UNMASK_SW) and INT-D4. Pairs with int_cap_mask on the fast pointer-restore path. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_kind_int_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // int_cap_rebind_affinity(cap_slot, new_cpu_idx) -> u64
  //
  // Change the destination CPU for a bound vector (design §1.4
  // OP_REBIND_CPU, §3.1-3.2 IOAPIC + MSI-X paths, INT-D7). Skeleton
  // emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body
  // (follow-up slice) will:
  //   - rights gate R_INT_REBIND -> INVOKE_DENIED
  //   - validate new_cpu_idx < VECTOR_POOL_MAX_CPUS
  //   - call parent KIND_HW_INTERRUPT.rebind_affinity(new_cpu_mask) via
  //     the parent slot's dispatch; this programs the IOAPIC RTE
  //     (ioapic.pdx:ioapic_program_redir) or the MSI-X message-address
  //     register (apic/msi.pdx:msix_program_entry) — the choice is the
  //     parent cap's internal concern
  //   - update the row's cpu_idx field in-place (NO revoke-remint — the
  //     cap stays live; the design INT-D7 revoke-remint variant lives on
  //     the mint path, not this entrypoint)
  //   - emit "INT KIND REBIND CPU vec=0x<nn> old_cpu=<oc> new_cpu=<nc>"
  //
  // The parent-side `rebind_affinity` is R29.M2 integration work;
  // today it is `INVOKE_UNSUPPORTED` in kind_hw_interrupt.pdx:177. The
  // follow-up slice makes real both sides atomically.
  //
  // SysV ABI: rdi = cap_slot, rsi = new_cpu_idx.
  // ============================================================================

  pub let int_cap_rebind_affinity : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) (new_cpu_idx: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D1 (#2518) skeleton: KIND_INTERRUPT CPU-affinity rebind entry. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body deferred to follow-up slice per design §1.4 (OP_REBIND_CPU) and §3.1-3.2 (IOAPIC vs MSI-X paths). Blocks on R29.M2 landing of hw_int_cap_rebind_affinity in kind_hw_interrupt.pdx. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_kind_int_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }

  // ============================================================================
  // int_cap_dispatch(vector_idx) -> u64
  //
  // ISR entry (design §2.4 `_kind_dispatch_core`). Skeleton emits
  // dispatch chatter and returns INVOKE_UNSUPPORTED. Real body
  // (follow-up slice) will:
  //   - load `_int_vector_table[vector_idx]` (NB: vector_idx is already
  //     vector - 0x60 for the MSI-X pool, or vector - 0x20 for the
  //     overlay range — the caller trampoline normalizes before call)
  //   - test for NULL / MUTED_SENTINEL -> _dispatch_muted path
  //   - post the paired notification atomically (lock xadd on sema)
  //   - call sched_wake_notif to move the waiter to RUNNABLE
  //   - saturating increment the cap tail's pending_count
  //   - call apic_eoi
  //   - emit "INT KIND DISPATCH vec=0x<nn> pending=<pp>" fingerprint
  //     (debug builds only; release path is silent per design §5.2)
  //   - return 0 on success, INVOKE_UNSUPPORTED on muted
  //
  // NOTE: the real body lives at `src/kernel/core/int/kind_dispatch.pdx`
  // (new file in the follow-up slice); this entrypoint is a trampoline-
  // callable alias so a boot-witness can simulate an IRQ by invoking
  // `int_cap_dispatch(vector_idx)` directly (design §5.3 witness #2:
  // `kind_interrupt_dispatch_simulated`).
  //
  // SysV ABI: rdi = vector_idx (vector - 0x60 for MSI-X pool;
  //           vector - 0x20 for overlay range).
  // ============================================================================

  pub let int_cap_dispatch : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (vector_idx: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 D1 (#2518) skeleton: KIND_INTERRUPT ISR entry alias. Emits dispatch chatter and returns INVOKE_UNSUPPORTED. Real body lives in src/kernel/core/int/kind_dispatch.pdx (follow-up slice); this alias exists so the design §5.3 kind_interrupt_dispatch_simulated witness can call-site the dispatcher without wiring an actual IRQ. The hot path's instruction budget (~18 for a bound dispatch, ~5 for a muted dispatch per design §2.4) is a follow-up concern — this skeleton pays only the klog_s1 call cost. Leaf shape.",
      block: {
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_kind_int_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret
      }
    }
}
