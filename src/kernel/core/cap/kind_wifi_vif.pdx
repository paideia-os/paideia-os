// src/kernel/core/cap/kind_wifi_vif.pdx — R38.M3-002 (#1300)
//
// KIND_WIFI_VIF = 0x179, derived over KIND_IPC_ENDPOINT (5).
//
// One WiFi virtual interface: a vif_key naming the vif, the
// KIND_IPC_ENDPOINT the supervisor drives control RPCs over, a
// phy_slot pointing at the KIND_WIFI_PHY the vif rides, a 48-bit MAC
// address, a mode ordinal (STA / AP / MONITOR) and a state ordinal.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A KIND_WIFI_PHY names ONE radio; a KIND_WIFI_VIF names ONE 802.11
// interface on it.  Multiple vifs may share a PHY (station + monitor;
// station + AP), but each vif has its own MAC and its own control-plane
// endpoint.  The vif is what wifi_control_channel RPCs address.
//
// The kind half of the derivation gate (KIND_IPC_ENDPOINT) discriminates
// NOTHING on its own -- the pattern repeated across every endpoint-
// derived kind in this tree -- so the mint additionally requires:
//
//   (a) vif_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT;
//       this is the parent_slot itself
//   (c) phy_slot names a live KIND_WIFI_PHY (0x178) (BAD_PHY)
//   (d) mac[47:0] non-zero AND multicast bit clear (BAD_MAC)
//   (e) mode in {STA=0, AP=1, MONITOR=2} (BAD_MODE)
//   (f) initial state is always STATE_DOWN (0) (BAD_STATE)
//   (g) rights subset of R_WVIF_ALL (no R_MINT in the mask)
//
// =============================================================================
// §1  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  vif_key    (u64)
//   [+16] body1:   endpoint_slot[31:0] | phy_slot[63:32]
//   [+24] body2:   mac[47:0] | mode[55:48] | state[63:56]
//
// state is the ONE mutable field: wvif_row_transition (called only by
// the vif bring-up path and the revoke helper) is the sole mutator.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF460..0xFFFFF46F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: KIND_WIFI_PHY
// 0xFFFFF470..7F; adjacent free band below: KIND_WIFI_SCAN_TXN
// 0xFFFFF450..5F).

module KindWifiVif = structure {

  pub let KIND_WIFI_VIF       : u64 = 0x179
  pub let WVIF_PARENT_KIND    : u64 = 5           // = KIND_IPC_ENDPOINT
  pub let WVIF_PHY_KIND       : u64 = 0x178       // = KIND_WIFI_PHY

  // Mode enum.
  pub let WVIF_MODE_STA     : u64 = 0
  pub let WVIF_MODE_AP      : u64 = 1
  pub let WVIF_MODE_MONITOR : u64 = 2
  pub let WVIF_MODE_MAX     : u64 = 2

  // State enum.
  pub let WVIF_STATE_DOWN    : u64 = 0
  pub let WVIF_STATE_UP      : u64 = 1
  pub let WVIF_STATE_SCANNING: u64 = 2
  pub let WVIF_STATE_ASSOC   : u64 = 3
  pub let WVIF_STATE_MAX     : u64 = 3

  // Rights -- R_MINT (0x200) OUTSIDE R_WVIF_ALL.
  pub let R_WVIF_READ    : u64 = 0x001
  pub let R_WVIF_WRITE   : u64 = 0x002
  pub let R_WVIF_INVOKE  : u64 = 0x008
  pub let R_WVIF_REVOKE  : u64 = 0x010
  pub let R_WVIF_OBSERVE : u64 = 0x400
  pub let R_WVIF_ALL     : u64 = 0x41B

  // Ops -- arity ONE.
  pub let WVIF_OP_QUERY_KEY      : u64 = 0
  pub let WVIF_OP_QUERY_ENDPOINT : u64 = 1
  pub let WVIF_OP_QUERY_PHY      : u64 = 2
  pub let WVIF_OP_QUERY_MAC_HI   : u64 = 3
  pub let WVIF_OP_QUERY_MAC_LO   : u64 = 4
  pub let WVIF_OP_QUERY_MODE     : u64 = 5
  pub let WVIF_OP_QUERY_STATE    : u64 = 6
  pub let WVIF_OP_DEBUG_PRINT    : u64 = 7
  pub let WVIF_OP_MAX            : u64 = 7

  // Failure taxonomy.
  pub let WVIF_OK                 : u64 = 0
  pub let WVIF_TAIL_ENOSPC        : u64 = 0xFFFFF46F
  pub let WVIF_TAIL_BAD_ARG       : u64 = 0xFFFFF46E
  pub let WVIF_MINT_BAD_PARENT    : u64 = 0xFFFFF46D
  pub let WVIF_MINT_BAD_RIGHTS    : u64 = 0xFFFFF46C
  pub let WVIF_MINT_BAD_PHY       : u64 = 0xFFFFF46B
  pub let WVIF_MINT_BAD_MAC       : u64 = 0xFFFFF46A
  pub let WVIF_MINT_BAD_MODE      : u64 = 0xFFFFF469
  pub let WVIF_MINT_BAD_STATE     : u64 = 0xFFFFF468
  pub let WVIF_MINT_NO_KEY        : u64 = 0xFFFFF467
  pub let WVIF_MINT_ENOSPC        : u64 = 0xFFFFF466
  pub let WVIF_MINT_IN_USE        : u64 = 0xFFFFF465
  pub let WVIF_BAD_SLOT           : u64 = 0xFFFFF464
  pub let WVIF_WRONG_KIND         : u64 = 0xFFFFF463
  pub let WVIF_REVOKE_ALREADY     : u64 = 0xFFFFF462
  pub let WVIF_BAD_TRANSITION     : u64 = 0xFFFFF461
  pub let WVIF_RESERVED_ZERO      : u64 = 0xFFFFF460

  pub let WVIF_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let WVIF_ROW_NONE   : u64 = 0xFF

  pub let WVIF_MAX       : u64 = 8
  pub let WVIF_ROW_BYTES : u64 = 32

  pub let mut _wifi_vif_table : [u64; 32] = uninit @align(64)
  pub let mut _wifi_vif_stats : [u64; 4]  = uninit @align(64)

  pub let WVIF_ST_MINTS       : u64 = 0
  pub let WVIF_ST_REVOKES     : u64 = 1
  pub let WVIF_ST_TRANSITIONS : u64 = 2
  pub let WVIF_ST_REFUSED     : u64 = 3

  pub let wvif_dbg_msg : [u8; 13] = "WIFI VIF ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let wifi_vif_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): clear KIND_WIFI_VIF row table + counters. Labels prefixed wvif_rs_.",
      block: {
        lea r10, [rip + _wifi_vif_table];
        xor rax, rax;
        xor rcx, rcx;
      wvif_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  wvif_rs_rows;

        lea r10, [rip + _wifi_vif_stats];
        xor rcx, rcx;
      wvif_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  wvif_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let wvif_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-002 (#1300): subset test against R_WVIF_ALL = 0x41B. R_MINT (0x200) OUTSIDE the mask -- LEAF. Labels prefixed wvif_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne wvif_rv_no;
        mov rax, 1;
        ret;
      wvif_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let wvif_mode_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-002 (#1300): 1 iff m <= MODE_MAX. Labels prefixed wvif_mv_.",
      block: {
        cmp rdi, 2;
        ja  wvif_mv_no;
        mov rax, 1;
        ret;
      wvif_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let wvif_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-002 (#1300): 1 iff s <= STATE_MAX. Labels prefixed wvif_sv_.",
      block: {
        cmp rdi, 3;
        ja  wvif_sv_no;
        mov rax, 1;
        ret;
      wvif_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let wvif_mac_valid : (u64) -> u64 !{} @{} =
    fn (mac: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-002 (#1300): 1 iff mac fits 48 bits AND non-zero AND multicast bit (bit 0 of first octet == bit 40) clear. Labels prefixed wvif_macv_.",
      block: {
        cmp rdi, 0;
        je  wvif_macv_no;
        mov r10, 0xFFFFFFFFFFFF;         // 48-bit mask
        mov rax, rdi;
        and rax, r10;
        cmp rax, rdi;
        jne wvif_macv_no;
        // Multicast bit: bit 0 of the first octet -- packed at bit 40 of
        // the u48 (little-endian MAC packing).  A multicast STA MAC would
        // be a class of bug this refuses categorically.
        mov r10, rdi;
        shr r10, 40;
        and r10, 1;
        cmp r10, 0;
        jne wvif_macv_no;
        mov rax, 1;
        ret;
      wvif_macv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let wvif_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): counter bump. Labels prefixed wvif_nt_.",
      block: {
        cmp rdi, 4;
        jae wvif_nt_out;
        lea r10, [rip + _wifi_vif_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wvif_nt_out:
        ret
      }
    }

  pub let wvif_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): counter read. Labels prefixed wvif_stt_.",
      block: {
        cmp rdi, 4;
        jae wvif_stt_zero;
        lea r10, [rip + _wifi_vif_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wvif_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent + PHY gates.
  // ==========================================================================

  pub let wvif_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed wvif_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wvif_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne wvif_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  wvif_cp_no;

        mov rax, 1;
        ret;
      wvif_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let wvif_check_phy : (u64) -> u64 !{mem} @{cap} =
    fn (phy_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): phy_slot must name a live KIND_WIFI_PHY (0x178). Labels prefixed wvif_cph_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wvif_cph_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x178;
        cmp r10, r11;
        jne wvif_cph_no;

        mov rax, 1;
        ret;
      wvif_cph_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let wvif_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-002 (#1300): (parent_slot << 8). Labels prefixed wvif_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae wvif_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      wvif_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wvif_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (phy_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-002 (#1300): pack endpoint_slot[31:0] | phy_slot[63:32]. Labels prefixed wvif_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  wvif_b1_bad;
        cmp rsi, r10;
        ja  wvif_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      wvif_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wvif_body2_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (mac: u64) (mode: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-002 (#1300): pack mac[47:0] | mode[55:48] | state[63:56]. Labels prefixed wvif_b2_.",
      block: {
        mov r10, 0xFFFFFFFFFFFF;
        cmp rdi, r10;
        ja  wvif_b2_bad;
        cmp rsi, 2;
        ja  wvif_b2_bad;
        cmp rdx, 3;
        ja  wvif_b2_bad;

        mov rax, rdi;
        and rax, r10;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      wvif_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _wifi_vif_table.
  // ==========================================================================

  pub let wvif_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (vif_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): claim one WIFI VIF row. THE ONE WRITER. Labels prefixed wvif_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne wvif_ta_bad;

        cmp r13, 0;
        je  wvif_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  wvif_ta_bad;
        cmp r15, r10;
        je  wvif_ta_bad;

        xor rbx, rbx;
      wvif_ta_scan:
        cmp rbx, 8;
        jae wvif_ta_enospc;

        lea r10, [rip + _wifi_vif_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wvif_ta_claim;

        add rbx, 1;
        jmp wvif_ta_scan;

      wvif_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp wvif_ta_out;

      wvif_ta_enospc:
        mov rax, 0xFFFFF46F;
        jmp wvif_ta_out;
      wvif_ta_bad:
        mov rax, 0xFFFFF46E;

      wvif_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let wvif_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): 1 iff row_id<MAX and in_use. Labels prefixed wvif_tvr_.",
      block: {
        cmp rdi, 8;
        jae wvif_tvr_no;
        lea r10, [rip + _wifi_vif_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wvif_tvr_no;
        mov rax, 1;
        ret;
      wvif_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let wvif_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): scrub one row. Labels prefixed wvif_tf_.",
      block: {
        cmp rdi, 8;
        jae wvif_tf_out;
        lea r10, [rip + _wifi_vif_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      wvif_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let wvif_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): vif_key. Labels prefixed wvif_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_rk_bad;
        lea r10, [rip + _wifi_vif_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp wvif_rk_out;
      wvif_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wvif_rk_out:
        pop r12;
        ret
      }
    }

  pub let wvif_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): endpoint_slot (body1[31:0]). Labels prefixed wvif_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_re_bad;
        lea r10, [rip + _wifi_vif_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp wvif_re_out;
      wvif_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wvif_re_out:
        pop r12;
        ret
      }
    }

  pub let wvif_row_phy : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): phy_slot (body1[63:32]). Labels prefixed wvif_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_rp_bad;
        lea r10, [rip + _wifi_vif_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp wvif_rp_out;
      wvif_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wvif_rp_out:
        pop r12;
        ret
      }
    }

  pub let wvif_row_mac : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): mac (body2[47:0]). Labels prefixed wvif_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_rm_bad;
        lea r10, [rip + _wifi_vif_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        mov r11, 0xFFFFFFFFFFFF;
        and rax, r11;
        jmp wvif_rm_out;
      wvif_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wvif_rm_out:
        pop r12;
        ret
      }
    }

  pub let wvif_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): mode (body2[55:48]). Labels prefixed wvif_rmo_.",
      block: {
        push r12;
        mov r12, rdi;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_rmo_bad;
        lea r10, [rip + _wifi_vif_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 48;
        and rax, 0xFF;
        jmp wvif_rmo_out;
      wvif_rmo_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wvif_rmo_out:
        pop r12;
        ret
      }
    }

  pub let wvif_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): state (body2[63:56]). Labels prefixed wvif_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_rst_bad;
        lea r10, [rip + _wifi_vif_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 56;
        and rax, 0xFF;
        jmp wvif_rst_out;
      wvif_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wvif_rst_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // wvif_row_transition -- the ONE mutator of the state field.
  // Legal edges: DOWN->UP, UP->SCANNING, SCANNING->UP, UP->ASSOC,
  // ASSOC->UP, UP->DOWN, and any state -> DOWN on revoke.
  // ==========================================================================

  pub let wvif_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): mutate state.  Legal edges enumerated; anything else refused. Labels prefixed wvif_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_rt_bad;

        mov rdi, r13;
        call wvif_state_valid;
        cmp rax, 0;
        je  wvif_rt_bad;

        lea r10, [rip + _wifi_vif_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 56;
        and rax, 0xFF;

        // Any state -> DOWN (0) is legal.
        cmp r13, 0;
        je  wvif_rt_apply;
        // DOWN -> UP
        cmp rax, 0;
        je  wvif_rt_from_down;
        // UP -> {SCANNING, ASSOC}
        cmp rax, 1;
        je  wvif_rt_from_up;
        // SCANNING -> UP
        cmp rax, 2;
        je  wvif_rt_from_scanning;
        // ASSOC -> UP
        cmp rax, 3;
        je  wvif_rt_from_assoc;
        jmp wvif_rt_bad;

      wvif_rt_from_down:
        cmp r13, 1;
        je  wvif_rt_apply;
        jmp wvif_rt_bad;
      wvif_rt_from_up:
        cmp r13, 2;
        je  wvif_rt_apply;
        cmp r13, 3;
        je  wvif_rt_apply;
        jmp wvif_rt_bad;
      wvif_rt_from_scanning:
        cmp r13, 1;
        je  wvif_rt_apply;
        jmp wvif_rt_bad;
      wvif_rt_from_assoc:
        cmp r13, 1;
        je  wvif_rt_apply;
        jmp wvif_rt_bad;

      wvif_rt_apply:
        mov rax, [r10 + 24];
        mov r11, 0xFF;
        shl r11, 56;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 24], rax;

        mov rdi, 2;
        call wvif_note;
        xor rax, rax;
        jmp wvif_rt_out;

      wvif_rt_bad:
        mov rax, 0xFFFFF461;

      wvif_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let wvif_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (vif_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-002 (#1300): live row holding vif_key, or ROW_NONE. Labels prefixed wvif_fk_.",
      block: {
        cmp rdi, 0;
        je  wvif_fk_none;
        xor rcx, rcx;
      wvif_fk_scan:
        cmp rcx, 8;
        jae wvif_fk_none;
        lea r10, [rip + _wifi_vif_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wvif_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  wvif_fk_hit;
      wvif_fk_next:
        add rcx, 1;
        jmp wvif_fk_scan;
      wvif_fk_hit:
        mov rax, rcx;
        ret;
      wvif_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let wvif_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): slot -> row_id, gated on live KIND_WIFI_VIF. Labels prefixed wvif_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae wvif_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x179;
        cmp r10, r11;
        jne wvif_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_ros_none;

        mov rax, r12;
        jmp wvif_ros_out;

      wvif_ros_none:
        mov rax, 0xFF;
      wvif_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Five args (slot, parent_slot, rights, vif_key, packed_v).
  //
  //   packed_v encoding:
  //     [15:0]   phy_slot
  //     [23:16]  mode
  //     [63:24]  reserved (must be zero) -- MAC is passed via a
  //              distinct mint variant below (mac needs 48 bits and
  //              cannot share a u64 with phy_slot+mode).
  // ==========================================================================

  pub let wifi_vif_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (vif_key: u64) (packed_v: u64) (mac: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): mint KIND_WIFI_VIF over KIND_IPC_ENDPOINT. Six-arg form because mac needs 48 bits it cannot share with anything else. Labels prefixed wvif_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // vif_key
        mov r15, r8;                     // packed_v
        mov rbp, r9;                     // mac

        mov r10, 256;
        cmp rbx, r10;
        jae wvif_mi_bad_slot;

        mov rdi, r12;
        call wvif_check_parent;
        cmp rax, 0;
        je  wvif_mi_bad_parent;

        mov rdi, r13;
        call wvif_rights_valid;
        cmp rax, 0;
        je  wvif_mi_bad_rights;

        // Reserved [63:24] must be zero.
        mov r10, r15;
        shr r10, 24;
        cmp r10, 0;
        jne wvif_mi_reserved;

        // phy_slot check.
        mov r10, r15;
        and r10, 0xFFFF;
        push r10;                        // phy_slot on stack
        mov rdi, r10;
        call wvif_check_phy;
        cmp rax, 0;
        je  wvif_mi_bad_phy_pop;

        // mode valid.
        mov r10, r15;
        shr r10, 16;
        and r10, 0xFF;
        push r10;                        // mode on stack
        mov rdi, r10;
        call wvif_mode_valid;
        cmp rax, 0;
        je  wvif_mi_bad_mode_pop2;

        // mac valid.
        mov rdi, rbp;
        call wvif_mac_valid;
        cmp rax, 0;
        je  wvif_mi_bad_mac_pop2;

        cmp r14, 0;
        je  wvif_mi_no_key_pop2;

        mov rdi, r14;
        call wvif_find_by_key;
        cmp rax, 0xFF;
        jne wvif_mi_in_use_pop2;

        // Body1 pack.  (endpoint_slot=parent_slot, phy_slot).
        mov rdi, r12;
        mov rsi, [rsp + 8];              // phy_slot
        call wvif_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wvif_mi_bad_state_pop2;
        push rax;                        // body1 on stack (top)

        // Body2 pack: (mac, mode, state=DOWN).
        mov rdi, rbp;                    // mac
        mov rsi, [rsp + 8];              // mode (rsp+0 body1, +8 mode, +16 phy_slot)
        mov rdx, 0;                      // state = DOWN
        call wvif_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wvif_mi_bad_state_pop3;
        push rax;                        // body2 on stack (top)

        // Header pack.
        mov rdi, r12;
        call wvif_hdr_pack;
        pop r15;                         // body2 -> r15
        pop rbp;                         // body1 -> rbp
        add rsp, 16;                     // discard mode + phy_slot
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wvif_mi_bad_parent;

        // tail_alloc(hdr, vif_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;                    // body1
        mov rcx, r15;                    // body2
        call wvif_tail_alloc;

        mov r10, 0xFFFFF46F;
        cmp rax, r10;
        je  wvif_mi_enospc;
        mov r10, 0xFFFFF46E;
        cmp rax, r10;
        je  wvif_mi_bad_state;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x179;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call wvif_note;

        xor rax, rax;
        jmp wvif_mi_out;

      wvif_mi_bad_phy_pop:
        add rsp, 8;
        jmp wvif_mi_bad_phy;
      wvif_mi_bad_mode_pop2:
        add rsp, 16;
        jmp wvif_mi_bad_mode;
      wvif_mi_bad_mac_pop2:
        add rsp, 16;
        jmp wvif_mi_bad_mac;
      wvif_mi_no_key_pop2:
        add rsp, 16;
        jmp wvif_mi_no_key;
      wvif_mi_in_use_pop2:
        add rsp, 16;
        jmp wvif_mi_in_use;
      wvif_mi_bad_state_pop2:
        add rsp, 16;
        jmp wvif_mi_bad_state;
      wvif_mi_bad_state_pop3:
        add rsp, 24;
        jmp wvif_mi_bad_state;

      wvif_mi_bad_slot:
        mov rax, 0xFFFFF464;
        jmp wvif_mi_out;
      wvif_mi_bad_parent:
        mov rax, 0xFFFFF46D;
        jmp wvif_mi_out;
      wvif_mi_bad_rights:
        mov rax, 0xFFFFF46C;
        jmp wvif_mi_out;
      wvif_mi_bad_phy:
        mov rax, 0xFFFFF46B;
        jmp wvif_mi_out;
      wvif_mi_bad_mac:
        mov rax, 0xFFFFF46A;
        jmp wvif_mi_out;
      wvif_mi_bad_mode:
        mov rax, 0xFFFFF469;
        jmp wvif_mi_out;
      wvif_mi_bad_state:
        mov rax, 0xFFFFF468;
        jmp wvif_mi_out;
      wvif_mi_no_key:
        mov rax, 0xFFFFF467;
        jmp wvif_mi_out;
      wvif_mi_in_use:
        mov rdi, 3;
        call wvif_note;
        mov rax, 0xFFFFF465;
        jmp wvif_mi_out;
      wvif_mi_enospc:
        mov rdi, 3;
        call wvif_note;
        mov rax, 0xFFFFF466;
        jmp wvif_mi_out;
      wvif_mi_reserved:
        mov rax, 0xFFFFF460;

      wvif_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let wifi_vif_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): revoke KIND_WIFI_VIF. Labels prefixed wvif_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae wvif_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  wvif_rvk_already;

        mov r11, 0x179;
        cmp r10, r11;
        jne wvif_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call wvif_tail_valid;
        cmp rax, 0;
        je  wvif_rvk_clear;

        mov rdi, r13;
        call wvif_tail_free;

      wvif_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call wvif_note;

        xor rax, rax;
        jmp wvif_rvk_out;

      wvif_rvk_bad_slot:
        mov rax, 0xFFFFF464;
        jmp wvif_rvk_out;
      wvif_rvk_wrong_kind:
        mov rax, 0xFFFFF463;
        jmp wvif_rvk_out;
      wvif_rvk_already:
        mov rax, 0xFFFFF462;

      wvif_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_wifi_vif : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R38.M3-002 (#1300): KIND_WIFI_VIF dispatch. Ops arity ONE; op_arg[63:8] REFUSED. Labels prefixed wvif_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_wifi_vif_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne wvif_hn_res;

        cmp rbp, 7;
        ja  wvif_hn_unsup;

        cmp rbp, 7;
        je  wvif_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  wvif_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  wvif_hn_key;
        cmp rbp, 1;
        je  wvif_hn_ep;
        cmp rbp, 2;
        je  wvif_hn_phy;
        cmp rbp, 3;
        je  wvif_hn_mac_hi;
        cmp rbp, 4;
        je  wvif_hn_mac_lo;
        cmp rbp, 5;
        je  wvif_hn_mode;
        call wvif_row_state;
        jmp wvif_hn_out;

      wvif_hn_key:
        call wvif_row_key;
        jmp wvif_hn_out;
      wvif_hn_ep:
        call wvif_row_endpoint;
        jmp wvif_hn_out;
      wvif_hn_phy:
        call wvif_row_phy;
        jmp wvif_hn_out;
      wvif_hn_mac_hi:
        call wvif_row_mac;
        shr rax, 24;                     // upper 24 bits of MAC
        and rax, 0xFFFFFF;
        jmp wvif_hn_out;
      wvif_hn_mac_lo:
        call wvif_row_mac;
        and rax, 0xFFFFFF;               // lower 24 bits of MAC
        jmp wvif_hn_out;
      wvif_hn_mode:
        call wvif_row_mode;
        jmp wvif_hn_out;

      wvif_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  wvif_hn_denied;
        xor rax, rax;
        jmp wvif_hn_out;

      wvif_hn_res:
        mov rax, 0xFFFFF46E;
        jmp wvif_hn_out;
      wvif_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp wvif_hn_out;
      wvif_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      wvif_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
