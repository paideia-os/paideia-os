// src/kernel/core/cap/kind_endpoint.pdx — R20b.M1-001 (#1552)
// KIND_IPC_ENDPOINT tail encoding + rights refinement + mint gate
//
// Design context
// --------------
// Base kind 5 (KIND_IPC_ENDPOINT) is already reserved in the closed
// 16-kind enum (cap/kind.pdx §Kind). Prior to R20b the descriptor's
// target_ptr slot was unused — the existing kind_ipc.pdx handler wires
// OP_SEND / OP_RECV to a single global SPSC channel (the B6 MVP).
//
// R20b formalizes target_ptr as the endpoint's "tail" — the field that
// distinguishes one endpoint from another and encodes the direction the
// holder is authorised to operate in. This module is the reference for
// that layout; every downstream R20b piece (broker M1-002/M1-003,
// framing M2, syscalls M3, loader-seed M4) reads/writes the tail through
// these helpers.
//
// target_ptr layout (see design/ipc/userspace-server-substrate.md §3.1):
//
//   bits [15:0]   endpoint_id       (0..65535)
//   bits [17:16]  direction         (0=send, 1=recv, 2=bidi, 3=reserved)
//   bits [23:18]  reserved          (MUST be zero)
//   bits [63:24]  reserved          (future: credit_bytes / session ptr)
//
// The direction field is a *static* refinement — it tells the type
// system (once session types land, wait-free-dataflow.md §6) which side
// of the channel this endpoint cap authorises. At R20b it is enforced
// procedurally: an OP_SEND on a direction=RECV cap returns
// INVOKE_UNSUPPORTED; ditto OP_RECV on direction=SEND. Bidi holders
// authorise both.
//
// No new base kind
// ----------------
// KIND_IPC_ENDPOINT (=5) already exists. This module does NOT register
// a new base kind; the direction refinement is a tail-level discipline
// per design/capabilities/derived-kinds.md §4 (restricting the parent
// kind's rights, not adding new ones).
//
// Rights discipline
// -----------------
// A KIND_IPC_ENDPOINT cap carries a subset of R_IPC_ALL:
//
//   R_IPC_READ    (0x01) = permit sys_ipc_recv on this endpoint
//   R_IPC_WRITE   (0x02) = permit sys_ipc_send on this endpoint
//   R_IPC_INVOKE  (0x08) = gate bit — required for either op
//   R_IPC_ALL     (0x0B) = READ | WRITE | INVOKE
//
// Servers hold READ|INVOKE; clients hold WRITE|INVOKE; supervisors
// hold ALL. These are aliases of the base rights (Rights.RIGHT_READ /
// RIGHT_WRITE / RIGHT_INVOKE); they exist here for local clarity and
// to give the endpoint-mint gate a single subset to validate against.
//
// Fixture posture at R20b.M1-001
// ------------------------------
// The mint gate is scaffolding — same posture as AcpiCap.acpi_cap_mint
// (#819) and DeviceCap.device_cap_mint (#858): endpoint_rights_valid + tail_valid
// run, but the actual descriptor slab write is deferred until cap_revoke
// grows a real body (see cap/revoke.pdx §R12-m5-001). The boot witness
// in kernel_main.pdx uses cap_mint_write directly to install a witness
// endpoint cap; the endpoint_cap_mint gate is exercised alongside for
// coverage of the validators.

module KindEndpoint = structure {

  // ============================================================================
  // Direction refinement constants
  // ============================================================================

  pub let ENDPOINT_DIR_SEND     : u64 = 0
  pub let ENDPOINT_DIR_RECV     : u64 = 1
  pub let ENDPOINT_DIR_BIDI     : u64 = 2
  pub let ENDPOINT_DIR_RESERVED : u64 = 3

  // ============================================================================
  // Rights aliases (subset of Rights.RIGHT_* — see rights.pdx)
  // ============================================================================

  pub let R_IPC_READ   : u64 = 0x01   // matches Rights.RIGHT_READ
  pub let R_IPC_WRITE  : u64 = 0x02   // matches Rights.RIGHT_WRITE
  pub let R_IPC_INVOKE : u64 = 0x08   // matches Rights.RIGHT_INVOKE
  pub let R_IPC_ALL    : u64 = 0x0B   // READ | WRITE | INVOKE

  // ============================================================================
  // Mint return codes (mirror of AcpiCap.ACPI_MINT_* / DeviceCap.PCI_DEV_MINT_*)
  // ============================================================================

  pub let ENDPOINT_MINT_OK           : u64 = 0
  pub let ENDPOINT_MINT_BAD_RIGHTS   : u64 = 0xFFFFFFFF
  pub let ENDPOINT_MINT_BAD_TAIL     : u64 = 0xFFFFFFFE

  // ============================================================================
  // Table caps (R20b.M1-002 will grow the underlying storage; the bound is
  // fixed here so every downstream piece agrees on the endpoint_id range).
  // ============================================================================

  pub let ENDPOINT_ID_MAX      : u64 = 128   // 0..127 inclusive
  pub let ENDPOINT_DIR_MAX     : u64 = 2     // 0..2 inclusive (RESERVED rejected)

  // ============================================================================
  // endpoint_tail_encode(endpoint_id, direction) -> u64
  //
  // Pack (endpoint_id, direction) into a target_ptr slot. Does NOT
  // validate ranges — callers use endpoint_tail_valid first.
  //
  // Layout (bits): dir[17:16] | eid[15:0]. Upper bits zero at R20b.
  // ============================================================================

  pub let endpoint_tail_encode : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_id: u64) (direction: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R20b.M1-001 (#1552): pack (endpoint_id, direction) into the KIND_IPC_ENDPOINT descriptor's target_ptr slot. eid in bits [15:0], dir in bits [17:16]. No range validation here — callers gate with endpoint_tail_valid. Written as unsafe block per paideia-as #913 (pure-fn if-else T0532); same encoder posture as DeviceCap.bdf_pack.",
      block: {
        // rax = endpoint_id & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // r10 = (direction & 0x3) << 16
        mov r10, rsi;
        and r10, 0x3;
        shl r10, 16;
        or rax, r10;

        ret
      }
    }

  // ============================================================================
  // endpoint_tail_decode_id(tail) -> u64
  //
  // Extract endpoint_id (low 16 bits) from a target_ptr value.
  // ============================================================================

  pub let endpoint_tail_decode_id : (u64) -> u64 !{} @{} =
    fn (tail: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R20b.M1-001 (#1552): decode endpoint_id (bits [15:0]) from a KIND_IPC_ENDPOINT descriptor's target_ptr slot. Pure mask; no side effects.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    }

  // ============================================================================
  // endpoint_tail_decode_dir(tail) -> u64
  //
  // Extract direction (bits [17:16]) from a target_ptr value.
  // ============================================================================

  pub let endpoint_tail_decode_dir : (u64) -> u64 !{} @{} =
    fn (tail: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R20b.M1-001 (#1552): decode direction (bits [17:16]) from a KIND_IPC_ENDPOINT descriptor's target_ptr slot. Shift right 16, mask 0x3; returns 0..3.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0x3;
        and rax, r10;
        ret
      }
    }

  // ============================================================================
  // endpoint_tail_valid(tail) -> u64
  //
  // Return 1 iff the tail is well-formed: reserved bits [23:18] are zero,
  // upper bits [63:24] are zero, endpoint_id < ENDPOINT_ID_MAX, and
  // direction <= ENDPOINT_DIR_MAX (RESERVED direction is rejected).
  // Return 0 otherwise.
  // ============================================================================

  pub let endpoint_tail_valid : (u64) -> u64 !{} @{} =
    fn (tail: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R20b.M1-001 (#1552): validate a KIND_IPC_ENDPOINT descriptor tail. Structural gate — rejects (a) reserved bits [23:18] non-zero, (b) upper bits [63:24] non-zero, (c) endpoint_id >= ENDPOINT_ID_MAX (128), (d) direction >= 3 (RESERVED). Called by endpoint_cap_mint before endpoint_rights_valid. Same shape as AcpiCap.range_valid and DeviceCap.endpoint_rights_valid. Written as unsafe block per paideia-as #913.",
      block: {
        // r10 = tail >> 18 (any non-zero bit above [17:0] fails).
        mov r10, rdi;
        shr r10, 18;
        cmp r10, 0;
        jne endpoint_tail_no;

        // rax = tail & 0xFFFF (endpoint_id)
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;
        // reject if endpoint_id >= ENDPOINT_ID_MAX (128)
        mov r10, 128;
        cmp rax, r10;
        jae endpoint_tail_no;

        // r10 = (tail >> 16) & 0x3 (direction)
        mov r10, rdi;
        shr r10, 16;
        mov r11, 0x3;
        and r10, r11;
        // reject if direction >= 3 (RESERVED)
        cmp r10, 3;
        jae endpoint_tail_no;

        // OK
        mov rax, 1;
        ret;
        endpoint_tail_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // endpoint_rights_valid(rights) -> u64
  //
  // Returns 1 iff rights is a subset of R_IPC_ALL (0x0B), else 0. The
  // pattern (mask + cmp) matches AcpiCap.endpoint_rights_valid / DeviceCap.endpoint_rights_valid.
  // ============================================================================

  pub let endpoint_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R20b.M1-001 (#1552): KIND_IPC_ENDPOINT rights-subset validator. Returns 1 iff (rights & R_IPC_ALL) == rights; else 0. R_IPC_ALL = 0x0B (READ | WRITE | INVOKE). Same encoder posture as AcpiCap.endpoint_rights_valid / DeviceCap.endpoint_rights_valid — unsafe block per paideia-as #913 (pure-fn if-else T0532).",
      block: {
        // rax = rights & R_IPC_ALL (0x0B)
        mov rax, rdi;
        mov r10, 0x0B;
        and rax, r10;
        // if rax == rights (rdi), return 1; else 0
        cmp rax, rdi;
        jne endpoint_rights_no;
        mov rax, 1;
        ret;
        endpoint_rights_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // endpoint_cap_mint(tail, rights) -> u64
  //
  // Gate-only mint per the AcpiCap / DeviceCap pattern (real slab_alloc +
  // descriptor write reuses cap_mint / cap_mint_write; wire-up deferred
  // until cap_revoke has a real body per cap/revoke.pdx §R12-m5-001).
  //
  // SysV ABI:
  //   rdi = tail (encoded endpoint_id + direction)
  //   rsi = rights
  //   -> rax = ENDPOINT_MINT_OK on success, or ENDPOINT_MINT_BAD_*
  //
  // Return codes:
  //   ENDPOINT_MINT_OK           = 0
  //   ENDPOINT_MINT_BAD_TAIL     = 0xFFFFFFFE   (tail failed endpoint_tail_valid)
  //   ENDPOINT_MINT_BAD_RIGHTS   = 0xFFFFFFFF   (rights outside R_IPC_ALL)
  // ============================================================================

  pub let endpoint_cap_mint : (u64, u64) -> u64 !{} @{} =
    fn (tail: u64) (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R20b.M1-001 (#1552) KIND_IPC_ENDPOINT mint gate. Sequence: endpoint_tail_valid(tail) then endpoint_rights_valid(rights). On any failure return the corresponding ENDPOINT_MINT_BAD_*. Real slab_alloc + cap_mint_write wire-up deferred until cap_revoke has a real body (see cap/revoke.pdx §R12-m5-001). Same structural posture as AcpiCap.acpi_cap_mint and DeviceCap.device_cap_mint. Preserves rights (rsi) across the tail_valid call — shuffled into rdi and back for endpoint_rights_valid. Written as unsafe block per paideia-as #913.",
      block: {
        // Save rights (rsi) across endpoint_tail_valid.
        push rsi;
        // endpoint_tail_valid expects tail in rdi — already there.
        call endpoint_tail_valid;
        pop rsi;
        cmp rax, 0;
        je endpoint_mint_bad_tail;

        // Move rights into rdi for endpoint_rights_valid.
        mov rdi, rsi;
        call endpoint_rights_valid;
        cmp rax, 0;
        je endpoint_mint_bad_rights;

        // OK path — return ENDPOINT_MINT_OK (0).
        mov rax, 0;
        ret;

        endpoint_mint_bad_tail:
          // ENDPOINT_MINT_BAD_TAIL = 0xFFFFFFFE
          mov rax, 0xFFFFFFFE;
          ret;
        endpoint_mint_bad_rights:
          // ENDPOINT_MINT_BAD_RIGHTS = 0xFFFFFFFF
          mov rax, 0xFFFFFFFF;
          ret
      }
    }

}
