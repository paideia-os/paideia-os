// PaideiaOS Phase-2 Capability Table
// P2-002: cap: 256-entry static cap table in .bss (P2 placeholder size)
// B5-001: Descriptor table layout and initialization (#337)
// R31.M1-1589 (#1589): the struct stops lying about its own layout.
// R31.M1-1587 (#1587): the owner column.
// See: design/audit/entries/b5-001-descriptor-table.md
//      design/capabilities/ownership-and-lineage.md
//
// ---------------------------------------------------------------------
// THE LAYOUT, AND WHY THE STRUCT ONCE DISAGREED WITH IT
// ---------------------------------------------------------------------
//
// The real, load-bearing descriptor is TWENTY-FOUR BYTES:
//
//   [cap_table + slot*24 +  0] = kind
//   [cap_table + slot*24 +  8] = rights
//   [cap_table + slot*24 + 16] = target_ptr
//
// written by cap_mint_write and read by every gate in the tree.
//
// Until #1589 this struct also declared `generation: u64` and
// `flags: u32`, and NOTHING GAVE THEM STORAGE: the backing array is
// 256 x 3 u64s, not 256 x 4. That was not a cosmetic mismatch. At
// stride 24, struct offset +24 -- where `generation` sat -- is the
// KIND FIELD OF DESCRIPTOR N+1. Anyone implementing generation by
// following the declared struct, which is the natural thing to do since
// the struct is the documentation, would have silently overwritten the
// adjacent capability's kind. `kind` is the first thing every gate
// checks, so the corruption would have presented as an unrelated
// capability changing type, arbitrarily far from its cause. Two TODOs
// in mint.pdx and revoke.pdx instructed a contributor to do exactly
// that; both are corrected.
//
// The struct below now declares exactly what has storage. The
// `[cap-stride]` step in tools/build.sh pins that agreement -- the
// three constants, the two array declarations, the absence of the two
// phantom fields, and the stride arithmetic at every one of the 136
// cap_table sites in the tree -- so a future divergence is a BUILD
// FAILURE rather than a memory-corruption bug.
//
// ---------------------------------------------------------------------
// THE OWNER COLUMN
// ---------------------------------------------------------------------
//
// `cap_owner[slot]` records WHICH PROCESS HOLDS the capability at
// `slot`. Before #1587 there was no such relation and "the capabilities
// held by process P" was not a representable query, so a crashed
// process's OpRegion windows, I2C claims and GPIO lines survived its
// death and were inherited by whatever process next occupied the slot.
//
// It is a PARALLEL ARRAY, not a widened descriptor, and not a side
// table in the sense design/drivers/cascade-restart.md §2 argues
// against. That section's objection is to a table keyed on a DIFFERENT
// identity with an INDEPENDENT lifetime, which can name something that
// has since been reallocated. This is a COLUMN SPLIT of one record:
// same key (slot), same cardinality (CAP_SLOT_MAX), same lifetime, no
// independent allocation. The alternative -- widening the descriptor to
// 32 bytes -- was measured, not estimated: 136 hand-written assembly
// sites across 36 files, 101 of which perform stride arithmetic, and a
// site missed reads a different LIVE descriptor rather than faulting.
//
// The one failure mode a column split creates is stale ownership on a
// reused slot, and it is closed at the only moment a slot changes
// hands: cap_mint_write writes CAP_OWNER_NONE unconditionally on EVERY
// mint. Ownership is stamped afterwards, by cap_owner_claim. See
// design/capabilities/ownership-and-lineage.md §2.3.
//
// Phase 6 workaround (cmd_build hardcodes 8 bytes per element, not 24):
// - Declared as [u64; 768] = uninit in .bss
// - 3 u64s per Capability entry x 256 entries = 768 u64s = 6144 bytes
//
// TODO (Phase 7+): When paideia-as m5-005 element-size computation
// supports non-u64 array types, replace with:
//   let cap_table : [Capability; 256] = uninit

module Table = structure {

  // ==========================================================================
  // THE THREE PINNED CONSTANTS.
  //
  // CAP_SLOT_MAX * CAP_DESC_BYTES == CAP_TABLE_U64S * 8 is the identity
  // #1589's mine violates, and tools/build.sh evaluates it. A struct
  // widened without the array, or an array widened without the stride,
  // breaks it and fails the build.
  //
  // They are `pub let` rather than comments for the same reason the
  // stride is pinned at all: a number that lives only in a comment is a
  // number that a future edit can disagree with silently.
  // ==========================================================================

  pub let CAP_SLOT_MAX   : u64 = 256    // descriptors in the table
  pub let CAP_DESC_BYTES : u64 = 24     // stride, in bytes
  pub let CAP_TABLE_U64S : u64 = 768    // 256 * 24 / 8

  struct Capability {
    kind: u64,
    rights: u64,
    target_ptr: u64
  }

  // 256 capability descriptors x 3 u64s per descriptor = 768 u64s = 6144 bytes
  // Allocated in .bss (uninitialized static memory)
  //
  // ACCESS RULE — cap_table (and cap_owner below) are ARRAYS, not pointer
  // variables. To take their base address use
  //
  //     lea rax, [rip + cap_table];    // opcode 0x8d, address of the array
  //
  // NEVER use
  //
  //     mov rax, cap_table;            // opcode 0x8b, LOAD of the first u64
  //
  // The `mov reg, cap_table;` form compiles to `mov reg, [rip + cap_table]`
  // and returns cap_table[0] (zero in .bss). Any subsequent
  // `[reg + slot*24]` dereference then walks the low unmapped VA range and
  // #PF's on the first write. This bug class was mass-swept in the sweep
  // that landed alongside this comment; the paideia-as compiler does not
  // yet reject the array-name-as-immediate form, so treat this rule as
  // load-bearing until it does. Same rule applies verbatim to cap_owner,
  // cap_table_XXX, and any future sibling [u64; N] declared at this
  // module scope.
  pub let cap_table : [u64; 768] = uninit

  // ==========================================================================
  // THE OWNER COLUMN — one u64 per descriptor slot.
  //
  //   bits [15:0]   pid          1 .. CAP_OWNER_PID_MAX-1  (0 reserved)
  //   bits [63:16]  generation   low 48 bits of _pid_gen[pid] (0 reserved)
  //
  // A BARE PID WOULD BE A BUG, not a simplification. pid_alloc is a
  // dense-low-first scan and pid_free zeroes its slot with no aging, so
  // a reaped pid is handed to the very next task_new. A sweep keyed on
  // the number alone would eventually revoke a LIVE process's
  // capabilities -- strictly worse than the leak it was fixing. The pair
  // (pid, generation) is the identity, and the generation comes from
  // _pid_gen[64], the counter #1583 built for exactly this, rather than
  // from a second mechanism invented here.
  //
  // 48 bits of generation rather than the driver row's 16: the driver
  // row truncates because it had 16 bits of space in a 48-byte layout
  // and says so. A dedicated u64 has room for the rest of the counter,
  // so it takes it. A collision needs 2^48 incarnations of one pid.
  // ==========================================================================

  pub let mut cap_owner : [u64; 256] = uninit @align(64)

  // ==========================================================================
  // THE TWO SENTINELS.
  //
  // Some slots belong to no process, and some belong to the kernel, and
  // these are DIFFERENT FACTS about a slot. If "unowned" and "owned by
  // the kernel" were the same value, a sweep for one would collect the
  // other -- which for a sweep keyed on 0 would mean a dying process
  // collecting the kernel's own capabilities.
  //
  // CAP_OWNER_NONE is .bss zero, so an untouched slot reads as unowned
  // with no initialisation pass. It is also what any of the tree's
  // three-zero-store descriptor-clearing paths degrades to, which is the
  // safe direction: an unowned slot is revoked by nobody, whereas a slot
  // that degraded to some process's key would be revoked by that
  // process's death.
  //
  // CAP_OWNER_KERNEL is all-ones. Its pid field is 0xFFFF, and pid_alloc
  // is ceilinged at 64, so no live process can ever pack a key equal to
  // it. cap_owner_sweep_revoke additionally refuses pid >= 64 BEFORE
  // scanning, so the kernel sentinel is not merely unmatched -- it is
  // outside the sweep's domain, and therefore unaskable.
  //
  // Two independent guarantees for one property, deliberately: a sweep
  // that misses slots is worse than no sweep, because it reports that
  // authority was revoked when it was not.
  // ==========================================================================

  pub let CAP_OWNER_NONE     : u64 = 0
  pub let CAP_OWNER_KERNEL   : u64 = 0xFFFFFFFFFFFFFFFF

  // pid_gen_read's own bound. Chosen so the sweep's domain is EXACTLY
  // the domain on which a generation is readable: a pid the sweep would
  // accept but pid_gen_read would refuse cannot exist.
  pub let CAP_OWNER_PID_MAX  : u64 = 64

  pub let CAP_OWNER_PID_MASK : u64 = 0xFFFF
  pub let CAP_OWNER_GEN_MASK : u64 = 0xFFFFFFFFFFFF
  pub let CAP_OWNER_GEN_SH   : u64 = 16

}
