// src/kernel/core/cap/kind_acpi_event.pdx — R30.M4-003 (#1068)
//
// KIND_ACPI_EVENT derived kind: the platform-event stream endpoint.
//
// -----------------------------------------------------------------------------
// Why this derives over KIND_HW_INTERRUPT and not over KIND_HW
// -----------------------------------------------------------------------------
//
// A platform event does not arrive out of nowhere. It arrives because a
// GPE bit asserted, the SCI line went active, the IOAPIC delivered a
// vector, and core/acpi/sci_isr.pdx queued a record. Every one of those
// steps is authorised by the KIND_HW_INTERRUPT capability that names the
// SCI's GSI (core/cap/kind_hw_interrupt.pdx, tag 0x140).
//
// So the reach a KIND_ACPI_EVENT confers — "you will be told when the
// platform raises an event, and you may acknowledge it, which re-enables
// the hardware source" — is strictly downstream of that interrupt. A
// holder who could mint one without holding the interrupt it comes from
// would have manufactured event reach out of nothing: it would be
// authorised to receive and to acknowledge a line it was never
// authorised to take delivery of, and acknowledgement is a WRITE to the
// GPE enable register.
//
// The gate is therefore `acpi_evt_check_parent_hw_int`, which requires
// cap_table[parent_slot].kind == 0x140 AND rights & RIGHT_MINT. It is
// the same shape as `msix_check_parent_hw_int` (#1022) and
// `opregion_check_parent_base` (#1061), deliberately, because a reader
// who has audited one derivation gate in this tree should not have to
// re-audit the shape of the next.
//
// -----------------------------------------------------------------------------
// The GSI is INHERITED, never accepted
// -----------------------------------------------------------------------------
//
// `acpi_evt_cap_mint` takes no GSI argument. It reads the parent
// descriptor's row_id out of target_ptr[15:0] and asks
// `hw_int_tail_decode_gsi` what line that capability actually names.
//
// That is the same discipline `opregion_cap_derive` uses for the address
// space: a field that identifies WHAT THE PARENT IS must come from the
// parent, because a caller who can relabel it can decouple the child's
// claim from the authority that was checked. An event endpoint stamped
// with GSI 9 while its parent names GSI 21 would pass the gate and then
// misreport, for the whole of its life, which line its events came from
// — and the record of which line an event came from is the only thing
// that makes a post-mortem of a platform-event storm possible.
//
// -----------------------------------------------------------------------------
// Name check (recorded because #1569 exists)
// -----------------------------------------------------------------------------
//
// tools/lint-no-kernel-aml.sh refuses any kernel identifier matching
// `\baml`, `\bdsdt`, `\bssdt`, `\bacpica([^a-zA-Z]|$)`, `\_SB_` or
// `\_SB.`. `KIND_ACPI_EVENT`, `acpi_evt_*` and `_acpi_event_table`
// match none of them: `acpi` is not `acpica` (the TIGHT pattern needs
// the sixth character `a` and a non-letter after it), and nothing here
// names a firmware bytecode construct. This was CHECKED rather than
// assumed, because #1569 records that `KIND_AML_SESSION` has to become
// `KIND_FW_SESSION` for exactly this reason — a name that reads as
// harmless English to a person is not what the linter matches on.
//
// -----------------------------------------------------------------------------
// DESCRIPTOR TAIL — row indirection
// -----------------------------------------------------------------------------
//
// The tail is {parent_slot:u8, gsi:u32, subscriber_id:u64, delivered:u64,
// acked:u64} — far past the descriptor's 64-bit target_ptr. So
// target_ptr holds a `row_id` into a private table, exactly as
// KIND_HW_INTERRUPT (#1019), KIND_HW_MSIX_VECTOR (#1022),
// KIND_DMA_DOMAIN (#1036) and KIND_OP_REGION (#1061) do.
//
// `_acpi_event_table[row_id]`, 32 bytes (four u64s):
//
//   [+0]  header word
//           bits [7:0]   reserved, must be zero
//           bits [15:8]  parent_slot  (cap_table slot of the parent
//                                      KIND_HW_INTERRUPT)
//           bits [47:16] gsi          (u32, INHERITED from the parent row)
//           bits [55:48] reserved, must be zero
//           bits [63:56] in_use       (allocator flag; a row is free iff
//                                      this byte is zero, which .bss
//                                      zero-init makes true at boot)
//   [+8]  subscriber_id   opaque, non-zero — the identity every record
//                         routed to this endpoint is stamped with
//   [+16] delivered       records accepted into the stream for this
//                         endpoint, lifetime
//   [+24] acked           successful acknowledgements, lifetime
//
// delivered and acked are not decoration. A GPE round trip is
// masked -> queued -> routed -> handled -> acknowledged -> RE-ENABLED,
// and the failure that is invisible from any single register is the one
// where the round trip stops after "routed". `delivered - acked` is the
// number of platform events this endpoint was told about and never
// finished, which is the number an operator needs when a device works
// exactly once.
//
// tools/build.sh asserts that no object other than this one relocates
// against `_acpi_event_table`, which is what upgrades "the mint gate is
// the only path to a row" from a convention to a build failure.

module KindAcpiEvent = structure {

  // ==========================================================================
  // Tag
  //
  // 0x151 — the second entry in the R30 derived-kind block, adjacent to
  // KIND_OP_REGION (0x150). Above the 4-bit base-slot space, so
  // core/cap/invoke.pdx can compare the full u64 kind field and this
  // branch coexists with the slot-9 legacy KIND_INTERRUPT handler
  // without ambiguity.
  // ==========================================================================

  pub let KIND_ACPI_EVENT : u64 = 0x151

  // The base kind this derives over. Not a parameter: unlike
  // KIND_OP_REGION, whose base kind is chosen by the address space, an
  // ACPI event has exactly one lineage.
  pub let KIND_HW_INTERRUPT_TAG : u64 = 0x140

  // ==========================================================================
  // Rights
  //
  //   OBSERVE (0x400) — read the endpoint's own metadata: GSI, parent,
  //                     subscriber identity, delivered/acked counters.
  //   INVOKE  (0x008) — drain the stream and acknowledge an event. These
  //                     are one right rather than two because they are
  //                     one operation split in time: a holder who can
  //                     take an event off the stream and cannot
  //                     acknowledge it is a holder who can only ever
  //                     leave GPEs masked, which is worse than not
  //                     draining at all.
  //   MINT    (0x200) — reserved for a future per-device sub-endpoint.
  //   REVOKE  (0x010) — tear the endpoint down.
  // ==========================================================================

  pub let R_ACPI_EVT_INVOKE  : u64 = 0x008
  pub let R_ACPI_EVT_REVOKE  : u64 = 0x010
  pub let R_ACPI_EVT_MINT    : u64 = 0x200
  pub let R_ACPI_EVT_OBSERVE : u64 = 0x400
  pub let R_ACPI_EVT_ALL     : u64 = 0x618

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFF90..0xFFFFFF9F
  //
  // A band disjoint from every other in tree: chaos.pdx owns
  // 0xFFFFFFA0..0xFFFFFFAD, the GPE path owns 0xFFFFFFB5..0xFFFFFFBE,
  // KIND_OP_REGION owns 0xFFFFFFC5..0xFFFFFFCF and KIND_DMA_DOMAIN owns
  // 0xFFFFFFD5..0xFFFFFFDF. Disjointness is what lets a caller that
  // threads a code up through three layers still name the gate that
  // refused.
  // ==========================================================================

  pub let ACPI_EVT_OK                  : u64 = 0
  pub let ACPI_EVT_TAIL_ENOSPC         : u64 = 0xFFFFFF9F
  pub let ACPI_EVT_TAIL_BAD_ARG        : u64 = 0xFFFFFF9E
  pub let ACPI_EVT_MINT_BAD_PARENT     : u64 = 0xFFFFFF9D
  pub let ACPI_EVT_MINT_BAD_RIGHTS     : u64 = 0xFFFFFF9C
  pub let ACPI_EVT_MINT_BAD_ARG        : u64 = 0xFFFFFF9B
  pub let ACPI_EVT_MINT_ENOSPC         : u64 = 0xFFFFFF9A
  pub let ACPI_EVT_MINT_BAD_SUBSCRIBER : u64 = 0xFFFFFF99
  pub let ACPI_EVT_REVOKE_BAD_SLOT     : u64 = 0xFFFFFF98
  pub let ACPI_EVT_REVOKE_WRONG_KIND   : u64 = 0xFFFFFF97
  pub let ACPI_EVT_REVOKE_ALREADY      : u64 = 0xFFFFFF96
  pub let ACPI_EVT_DECODE_BAD          : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each demands
  // ==========================================================================

  pub let ACPI_EVT_OP_QUERY_GSI        : u64 = 0   // OBSERVE
  pub let ACPI_EVT_OP_QUERY_PARENT     : u64 = 1   // OBSERVE
  pub let ACPI_EVT_OP_QUERY_SUBSCRIBER : u64 = 2   // OBSERVE
  pub let ACPI_EVT_OP_QUERY_DELIVERED  : u64 = 3   // OBSERVE
  pub let ACPI_EVT_OP_QUERY_ACKED      : u64 = 4   // OBSERVE
  pub let ACPI_EVT_OP_QUERY_DEPTH      : u64 = 5   // INVOKE
  pub let ACPI_EVT_OP_QUERY_DROPS      : u64 = 6   // INVOKE

  // ==========================================================================
  // Storage — 8 rows x 32 bytes.
  //
  // Eight, not thirty-two. A KIND_ACPI_EVENT endpoint is a per-PROCESS
  // subscription to the platform's event stream, and the set of
  // processes that legitimately hold one is the ACPI supervisor plus a
  // small number of subsystem monitors. Per-GPE fan-out is NOT done by
  // minting one endpoint per GPE — it is done by the subscriber_id the
  // GPE dispatch table already stores per row (core/acpi/gpe_table.pdx),
  // which is carried on every record. Sizing the table for the number
  // of PROCESSES rather than the number of EVENT SOURCES is the whole
  // reason eight is enough, and stating it here is what stops a later
  // reader from "fixing" the table to 256.
  // ==========================================================================

  pub let ACPI_EVT_MAX       : u64 = 8
  pub let ACPI_EVT_ROW_BYTES : u64 = 32

  pub let mut _acpi_event_table : [u64; 32] = uninit @align(64)

  // Row-dump tag, separate from the dispatch-chatter tag in
  // core/cap/tags.pdx so row dumps and invocation chatter never
  // interleave under one label.
  pub let acpi_evt_k_row : [u8; 15] = "ACPI EVENT ROW\0"

  // ==========================================================================
  // acpi_evt_table_reset() -> ()
  // ==========================================================================

  pub let acpi_evt_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): zero all 32 qwords of the endpoint table. A qword loop rather than a row loop because a full zero does not care about the row stride and a qword loop has one bound to get wrong instead of two. Zeroing [row+0] is what clears in_use, so reset and SCRUB are the same operation and no stale subscriber identity survives -- which matters here because a stale identity is a recorded permission to be told about platform events. Leaf. Labels prefixed acpi_evt_tr_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _acpi_event_table];
        xor rax, rax;
        xor rcx, rcx;
      acpi_evt_tr_next:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  acpi_evt_tr_next;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let acpi_evt_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-003 (#1068): 1 iff (rights & R_ACPI_EVT_ALL) == rights. R_ACPI_EVT_ALL = 0x618 (INVOKE|REVOKE|MINT|OBSERVE). Expressed as a subset test rather than an equality so a caller may mint a strictly weaker endpoint -- an observe-only monitor that can read the stream's depth and drop counters but cannot acknowledge anything is a useful and safe thing to hold. Same shape as hw_int_rights_valid and dma_rights_valid. Pure leaf. Labels prefixed acpi_evt_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x618;
        and rax, r10;
        cmp rax, rdi;
        jne acpi_evt_rv_no;
        mov rax, 1;
        ret;
      acpi_evt_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_check_parent_hw_int(parent_slot) -> 1 | 0
  //
  // THE DERIVATION GATE. 1 iff cap_table[parent_slot] is a live
  // KIND_HW_INTERRUPT carrying RIGHT_MINT.
  // ==========================================================================

  pub let acpi_evt_check_parent_hw_int : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M4-003 (#1068): the mint gate. Bounds-check parent_slot < 256 (cap_table capacity) BEFORE any address arithmetic, so an unbounded slot cannot read outside the table. Descriptor stride is 24 bytes per cap/mint.pdx, computed as shl 3 + shl 4 + add, the same idiom invoke.pdx and opregion_check_parent_base use. Require kind field ([+0]) == 0x140 (KIND_HW_INTERRUPT) AND rights field ([+8]) carrying RIGHT_MINT (0x200). Both conditions, not either: the kind establishes that the holder was authorised to take delivery of an interrupt, and MINT establishes that it was authorised to hand that authority onward. A KIND_HW_INTERRUPT without MINT is a driver that may service its own line and may not create subscriptions to it. Pure read, no writes. Labels prefixed acpi_evt_cp_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae acpi_evt_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x140;                  // KIND_HW_INTERRUPT
        cmp r10, r11;
        jne acpi_evt_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  acpi_evt_cp_no;

        mov rax, 1;
        ret;

      acpi_evt_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_parent_row(parent_slot) -> row_id | ACPI_EVT_DECODE_BAD
  //
  // The parent's KIND_HW_INTERRUPT row_id, read out of its descriptor.
  // ==========================================================================

  pub let acpi_evt_parent_row : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M4-003 (#1068): row_id = cap_table[parent_slot].target_ptr[15:0], for a descriptor that must already be a KIND_HW_INTERRUPT -- the kind is re-checked here rather than trusted from an earlier gate, because this function is what turns a slot number into a hardware line number and a caller that reached it by another path must not get a row_id out of an unrelated descriptor. Bounds-checked; returns ACPI_EVT_DECODE_BAD (all ones) on any refusal, which is not a plausible row_id because hw_int rows are 16-bit. Pure read. Labels prefixed acpi_evt_pr_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae acpi_evt_pr_bad;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x140;
        cmp r10, r11;
        jne acpi_evt_pr_bad;

        mov rax, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and rax, r11;
        ret;

      acpi_evt_pr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_tail_pack(parent_slot, gsi) -> hdr | ACPI_EVT_DECODE_BAD
  // ==========================================================================

  pub let acpi_evt_tail_pack : (u64, u64) -> u64 !{} @{} =
    fn (parent_slot: u64, gsi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-003 (#1068): canonical header-word encoder. Validates parent_slot < 256 and gsi <= 0xFFFFFFFF, then packs (parent_slot << 8) | (gsi << 16), leaving bits [7:0], [55:48] and [63:56] clear. Bits [63:56] belong to the allocator's in_use flag and MUST leave this function zero, which is why the encoder exists at all rather than two shifts at the call site: a header that arrives with in_use pre-set would hand back a row the free scan skips forever. Pure leaf. Labels prefixed acpi_evt_tp_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae acpi_evt_tp_bad;
        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  acpi_evt_tp_bad;

        mov rax, rdi;
        shl rax, 8;
        mov r11, rsi;
        shl r11, 16;
        or  rax, r11;
        ret;

      acpi_evt_tp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let acpi_evt_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-003 (#1068): parent_slot from header bits [15:8]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    }

  pub let acpi_evt_hdr_gsi : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M4-003 (#1068): gsi from header bits [47:16]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_tail_alloc(hdr, subscriber_id) -> row_id | error
  // ==========================================================================

  pub let acpi_evt_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64, subscriber_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): allocate and populate a free _acpi_event_table row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A {parent_slot, gsi, subscriber_id} TRIPLE, which is what makes the derivation gate upstream of it exhaustive rather than merely usual. Gates, in order: hdr bits [63:56] non-zero -> ACPI_EVT_TAIL_BAD_ARG (those bits are the allocator's in_use flag and a caller that pre-set them would be handed a row the free scan skips); hdr reserved bits [7:0] or [55:48] non-zero -> ACPI_EVT_TAIL_BAD_ARG (a reserved bit that is merely ignored is a reserved bit a later revision cannot use); subscriber_id == 0 -> ACPI_EVT_TAIL_BAD_ARG, because zero is the sentinel the stream reads as 'no subscriber' and a zero-identity endpoint would have every record it was routed refused as unroutable while looking perfectly registered. Low-first scan over 8 rows of 32 bytes, free iff the in_use byte (byte 7 of [row+0]) is zero; exhaustion -> ACPI_EVT_TAIL_ENOSPC. Claim: [row+0] = hdr | (1 << 56), [row+8] = subscriber_id, [row+16] = 0 (delivered), [row+24] = 0 (acked). Leaf, no nested calls. Labels prefixed acpi_evt_ta_ per reserved-label discipline.",
      block: {
        // hdr bits [63:56] must be clear.
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne acpi_evt_ta_bad;

        // hdr bits [7:0] must be clear.
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0;
        jne acpi_evt_ta_bad;

        // hdr bits [55:48] must be clear.
        mov rax, rdi;
        shr rax, 48;
        and rax, 0xFF;
        cmp rax, 0;
        jne acpi_evt_ta_bad;

        cmp rsi, 0;
        je  acpi_evt_ta_bad;

        lea r10, [rip + _acpi_event_table];
        xor rcx, rcx;
      acpi_evt_ta_next:
        cmp rcx, 8;                      // ACPI_EVT_MAX
        jae acpi_evt_ta_enospc;
        mov r8, rcx;
        shl r8, 5;                       // * ACPI_EVT_ROW_BYTES
        add r8, r10;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  acpi_evt_ta_claim;
        add rcx, 1;
        jmp acpi_evt_ta_next;

      acpi_evt_ta_claim:
        mov rax, 1;
        shl rax, 56;
        or  rax, rdi;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rsi;
        xor rax, rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;
        mov rax, rcx;                    // row_id
        ret;

      acpi_evt_ta_enospc:
        mov rax, 0xFFFFFF9F;             // ACPI_EVT_TAIL_ENOSPC
        ret;

      acpi_evt_ta_bad:
        mov rax, 0xFFFFFF9E;             // ACPI_EVT_TAIL_BAD_ARG
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_tail_free(row_id) -> ()
  // ==========================================================================

  pub let acpi_evt_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): row_id >= ACPI_EVT_MAX -> silent no-op. Otherwise zero all four qwords, which clears in_use and scrubs the subscriber identity in the same store sequence -- a freed row must not retain a recorded permission to be told about platform events, and free-without-scrub is how one process inherits another's subscription through a reused row. Leaf. Labels prefixed acpi_evt_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_tf_out;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        xor rax, rax;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;
      acpi_evt_tf_out:
        ret
      }
    }

  pub let acpi_evt_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): 1 iff row_id < ACPI_EVT_MAX and the row's in_use byte is non-zero. Same shape as dma_tail_valid and opregion_tail_valid. Leaf, pure read. Labels prefixed acpi_evt_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_tv_no;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  acpi_evt_tv_no;
        mov rax, 1;
        ret;
      acpi_evt_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row decoders. Every one returns ACPI_EVT_DECODE_BAD for a dead or
  // out-of-range row — never a plausible zero.
  // ==========================================================================

  pub let acpi_evt_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): raw header word of a LIVE row, ACPI_EVT_DECODE_BAD otherwise. The other decoders are written in terms of this one so the bounds check and the liveness check exist once and cannot drift apart. Leaf, pure read. Labels prefixed acpi_evt_rh_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_rh_bad;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  acpi_evt_rh_bad;
        ret;
      acpi_evt_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let acpi_evt_row_gsi : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): the GSI this endpoint's events arrive on, inherited from the parent KIND_HW_INTERRUPT at mint. ACPI_EVT_DECODE_BAD on a dead row. One push (rbx, unused) brings rsp%16 to 0 at the nested call. Labels prefixed acpi_evt_rg_ per reserved-label discipline.",
      block: {
        push rbx;
        call acpi_evt_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  acpi_evt_rg_out;
        shr rax, 16;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
      acpi_evt_rg_out:
        pop rbx;
        ret
      }
    }

  pub let acpi_evt_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): parent_slot from header bits [15:8]. ACPI_EVT_DECODE_BAD on a dead row. One push (rbx, unused) aligns the nested call. Labels prefixed acpi_evt_rp_ per reserved-label discipline.",
      block: {
        push rbx;
        call acpi_evt_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  acpi_evt_rp_out;
        shr rax, 8;
        and rax, 0xFF;
      acpi_evt_rp_out:
        pop rbx;
        ret
      }
    }

  pub let acpi_evt_row_subscriber : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): the opaque subscriber identity every record routed to this endpoint is stamped with. ACPI_EVT_DECODE_BAD on a dead or out-of-range row; a live row's identity is non-zero by the allocator's gate, so the sentinel is unambiguous. Leaf, pure read. Labels prefixed acpi_evt_rs_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_rs_bad;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  acpi_evt_rs_bad;
        mov rax, [r8 + 8];
        ret;
      acpi_evt_rs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let acpi_evt_row_delivered : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): lifetime count of records accepted into the stream for this endpoint. ACPI_EVT_DECODE_BAD on a dead row. Leaf, pure read. Labels prefixed acpi_evt_rd_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_rd_bad;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  acpi_evt_rd_bad;
        mov rax, [r8 + 16];
        ret;
      acpi_evt_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let acpi_evt_row_acked : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): lifetime count of successful acknowledgements through this endpoint. delivered minus acked is the number of platform events this endpoint was told about and never finished, which is the observable that distinguishes 'the device works' from 'the device worked once' -- a GPE that is masked, dispatched, handled and never re-enabled leaves no trace in any hardware register, only in this difference. ACPI_EVT_DECODE_BAD on a dead row. Leaf, pure read. Labels prefixed acpi_evt_ra_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_ra_bad;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  acpi_evt_ra_bad;
        mov rax, [r8 + 24];
        ret;
      acpi_evt_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Counter mutators. Called from the routing path in task context.
  // ==========================================================================

  pub let acpi_evt_note_delivered : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): increment the endpoint's delivered counter. Bounds- and liveness-checked; a dead row is a silent no-op rather than a refusal, because this is accounting attached to a delivery that has already happened and failing it would be reporting a second, invented, problem. Leaf. Labels prefixed acpi_evt_nd_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_nd_out;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  acpi_evt_nd_out;
        mov rax, [r8 + 16];
        add rax, 1;
        mov [r8 + 16], rax;
      acpi_evt_nd_out:
        ret
      }
    }

  pub let acpi_evt_note_acked : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M4-003 (#1068): increment the endpoint's acked counter. Called ONLY after gpe_ack has returned GPE_OK, so the counter means 'the GPE was re-enabled', not 'an acknowledgement was attempted'. Bounds- and liveness-checked; a dead row is a silent no-op. Leaf. Labels prefixed acpi_evt_na_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae acpi_evt_na_out;
        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _acpi_event_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  acpi_evt_na_out;
        mov rax, [r8 + 24];
        add rax, 1;
        mov [r8 + 24], rax;
      acpi_evt_na_out:
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_cap_mint_inner(slot, parent_slot, rights, subscriber_id)
  //   -> ACPI_EVT_OK | ACPI_EVT_MINT_*
  //
  // SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=subscriber_id.
  // ==========================================================================

  pub let acpi_evt_cap_mint_inner : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64, parent_slot: u64, rights: u64, subscriber_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M4-003 (#1068): mint a KIND_ACPI_EVENT endpoint. Sequence: (1) slot < 256 else ACPI_EVT_MINT_BAD_ARG. (2) acpi_evt_check_parent_hw_int(parent_slot) -- THE DERIVATION GATE -- else ACPI_EVT_MINT_BAD_PARENT: a caller who does not hold the SCI's KIND_HW_INTERRUPT with RIGHT_MINT cannot manufacture reach to the events that interrupt produces, nor the authority to acknowledge one, which is a WRITE to the GPE enable register. (3) acpi_evt_rights_valid(rights) else ACPI_EVT_MINT_BAD_RIGHTS. (4) subscriber_id != 0 else ACPI_EVT_MINT_BAD_SUBSCRIBER -- zero is the stream's 'no subscriber' sentinel and an endpoint holding it would have every record refused as unroutable while looking registered. (5) INHERIT the GSI: acpi_evt_parent_row(parent_slot) then hw_int_tail_decode_gsi. Not accepted as an argument, so a child cannot misreport which line its events came from -- the same discipline opregion_cap_derive uses for the address space, and for the same reason: a field that identifies what the PARENT is must come from the parent or the child's claim decouples from the authority that was checked. (6) acpi_evt_tail_pack + acpi_evt_tail_alloc, translating TAIL codes to distinct MINT codes so each failure edge stays nameable at the boundary. (7) cap_mint_write(slot, KIND_ACPI_EVENT = 0x151, rights, row_id). Five pushes (rbx, r12, r13, r14, r15) hold slot, parent_slot, rights, subscriber_id and the inherited GSI across the five nested calls; entry rsp%16 == 8 and five pushes return it to 0 at every call site. Labels prefixed acpi_evt_mi_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov r15, rcx;                    // subscriber_id

        cmp r12, 256;
        jae acpi_evt_mi_bad_arg;

        // -- (2) the derivation gate.
        mov rdi, r13;
        call acpi_evt_check_parent_hw_int;
        cmp rax, 0;
        je  acpi_evt_mi_bad_parent;

        // -- (3) rights subset.
        mov rdi, r14;
        call acpi_evt_rights_valid;
        cmp rax, 0;
        je  acpi_evt_mi_bad_rights;

        // -- (4) subscriber identity.
        cmp r15, 0;
        je  acpi_evt_mi_bad_sub;

        // -- (5) inherit the GSI from the parent's own row.
        mov rdi, r13;
        call acpi_evt_parent_row;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  acpi_evt_mi_bad_parent;
        mov rdi, rax;
        call hw_int_tail_decode_gsi;
        mov rbx, rax;                    // inherited GSI

        // -- (6) header + row.
        mov rdi, r13;                    // parent_slot
        mov rsi, rbx;                    // gsi
        call acpi_evt_tail_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  acpi_evt_mi_bad_arg;

        mov rdi, rax;                    // hdr
        mov rsi, r15;                    // subscriber_id
        call acpi_evt_tail_alloc;

        mov r11, 0xFFFFFF9F;             // ACPI_EVT_TAIL_ENOSPC
        cmp rax, r11;
        je  acpi_evt_mi_enospc;
        mov r11, 0xFFFFFF9E;             // ACPI_EVT_TAIL_BAD_ARG
        cmp rax, r11;
        je  acpi_evt_mi_bad_arg;

        // -- (7) descriptor.
        mov rcx, rax;                    // target_ptr = row_id
        mov rdi, r12;                    // slot
        mov rsi, 0x151;                  // KIND_ACPI_EVENT
        mov rdx, r14;                    // rights
        call cap_mint_write;

        xor rax, rax;                    // ACPI_EVT_OK
        jmp acpi_evt_mi_out;

      acpi_evt_mi_bad_parent:
        mov rax, 0xFFFFFF9D;
        jmp acpi_evt_mi_out;
      acpi_evt_mi_bad_rights:
        mov rax, 0xFFFFFF9C;
        jmp acpi_evt_mi_out;
      acpi_evt_mi_bad_sub:
        mov rax, 0xFFFFFF99;
        jmp acpi_evt_mi_out;
      acpi_evt_mi_enospc:
        mov rax, 0xFFFFFF9A;
        jmp acpi_evt_mi_out;
      acpi_evt_mi_bad_arg:
        mov rax, 0xFFFFFF9B;

      acpi_evt_mi_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_cap_mint(slot, parent_slot, rights, subscriber_id) -> code
  //
  // Audited entry point.
  // ==========================================================================

  pub let acpi_evt_cap_mint : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64, parent_slot: u64, rights: u64, subscriber_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M4-003 (#1068): audited entry point for the endpoint mint, same wrapper shape as hw_int_cap_mint / dma_cap_mint / opregion_cap_mint_root. The audit is not decoration: an event endpoint is a standing subscription to platform events plus the authority to re-enable the hardware sources behind them, and the only way to answer 'which principal was authorised to acknowledge platform events during this boot' after the fact is for every mint that ever succeeded to have left a record. Putting emission in the wrapper means a second mint path cannot exist without being audited. Three pushes (r12, r13, r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls. r12/r13 are saved BEFORE the inner call because the inner body clobbers rdi/rsi; the four SysV argument registers are untouched by the two movs, so the inner body sees them exactly as passed. r14 carries the inner outcome across drv_audit_emit and is restored to rax, making the wrapper return-value transparent. Emission covers every exit, success and all five refusals, because the code itself is field 5. Labels prefixed acpi_evt_mw_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call acpi_evt_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x151;                  // KIND_ACPI_EVENT
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // acpi_evt_cap_revoke_inner(slot) -> ACPI_EVT_OK | ACPI_EVT_REVOKE_*
  // ==========================================================================

  pub let acpi_evt_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M4-003 (#1068): revoke a KIND_ACPI_EVENT endpoint. Sequence: slot < 256 else ACPI_EVT_REVOKE_BAD_SLOT; kind == 0 -> ACPI_EVT_REVOKE_ALREADY (idempotent on a null slot, and a DISTINCT code from success so a caller can tell 'nothing to do' from 'done'); kind != 0x151 -> ACPI_EVT_REVOKE_WRONG_KIND, which is what stops a revoke aimed at this kind from freeing another kind's row through a coincidentally-shaped target_ptr; then acpi_evt_unbind_slot(slot) BEFORE the row is freed, then acpi_evt_tail_free(target_ptr[15:0]), then clear the descriptor. The unbind is first and it is why revocation is PUSHED rather than polled: core/acpi/evt_stream.pdx's readiness flag falls in the same operation that frees the row, so there is no window in which the stream believes it is bound to a descriptor that no longer exists, and acpi_evt_ready can stay a latched read instead of a descriptor re-validation that would force the {cap} capability up the entire SCI arming path. acpi_evt_unbind_slot compares the slot before clearing, so revoking endpoint A cannot unbind endpoint B. There is NO cascade: nothing in this tree derives from KIND_ACPI_EVENT, and an empty cascade call would be a hook that looks maintained and is not. Three pushes (rbx, r12, r13) carry the slot and the descriptor address across the two nested calls. Labels prefixed acpi_evt_ri_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        cmp rbx, 256;
        jae acpi_evt_ri_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r12, rax;                    // descriptor address

        mov r10, [r12 + 0];
        cmp r10, 0;
        je  acpi_evt_ri_already;
        mov r11, 0x151;
        cmp r10, r11;
        jne acpi_evt_ri_wrong;

        mov r13, [r12 + 16];
        mov r11, 0xFFFF;
        and r13, r11;                    // row_id

        // Readiness falls in the same operation that frees the row.
        mov rdi, rbx;
        call acpi_evt_unbind_slot;

        mov rdi, r13;
        call acpi_evt_tail_free;

        xor r10, r10;
        mov [r12 + 0],  r10;
        mov [r12 + 8],  r10;
        mov [r12 + 16], r10;

        xor rax, rax;                    // ACPI_EVT_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      acpi_evt_ri_bad_slot:
        mov rax, 0xFFFFFF98;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      acpi_evt_ri_wrong:
        mov rax, 0xFFFFFF97;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      acpi_evt_ri_already:
        mov rax, 0xFFFFFF96;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let acpi_evt_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M4-003 (#1068): audited entry point for the endpoint revoke, same wrapper shape as hw_int_cap_revoke. principal is the slot itself: unlike a mint there is no separate authorising parent, and recording the slot twice is more honest than inventing an authority the operation did not consult. Emission covers every exit including the idempotent ALREADY -- an attempt to revoke nothing is still an attempt worth seeing, and on this kind it is the shape a double-teardown takes. Three pushes (r12, r13, r14) for the odd-count call alignment; r14 carries the inner outcome across drv_audit_emit so the wrapper is return-value transparent.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call acpi_evt_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x151;                  // KIND_ACPI_EVENT
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_acpi_event(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler. QUERY ops only.
  //
  // There is deliberately no DRAIN or ACK op here even though both are
  // real operations on this capability. Draining copies a 64-byte record
  // out, which a three-register capability invocation cannot express
  // without taking a destination pointer — and taking a destination
  // pointer across this boundary is exactly the aliasing the confinement
  // assertions exist to prevent. Draining and acknowledgement therefore
  // go through core/acpi/evt_stream.pdx's own entries, which the bound
  // endpoint authorises; the capability's job here is to answer
  // questions about itself.
  // ==========================================================================

  pub let cap_handler_acpi_event : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M4-003 (#1068): KIND_ACPI_EVENT dispatch handler. Emits cap_acpi_evt_msg on entry (all three argument registers saved across klog_s1, which clobbers them per klog/wrappers.pdx §5.1). row_id = target_ptr[15:0]; op = op_arg[7:0]. Ops 0..4 (QUERY_GSI / PARENT / SUBSCRIBER / DELIVERED / ACKED) require RIGHT_OBSERVE (0x400) because they read the endpoint's own metadata; ops 5..6 (QUERY_DEPTH / QUERY_DROPS) require RIGHT_INVOKE (0x008) because they read the shared STREAM rather than this endpoint, and a monitor holding only OBSERVE must not learn the platform's event rate from a capability that only entitles it to introspect itself. Splitting the gate per op rather than gating once at entry is what keeps those two authority classes separable. Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Every metadata query returns ACPI_EVT_DECODE_BAD for a dead row, which is the decoders' contract and never a plausible zero. r12=rights, r13=row_id, r14=op across the klog call. Labels prefixed acpi_evt_h_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;
        and r14, 0xFF;                   // op

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_acpi_evt_msg];
        call klog_s1;

        cmp r14, 6;
        ja  acpi_evt_h_unsup;
        cmp r14, 5;
        jae acpi_evt_h_stream;

        // Ops 0..4: endpoint metadata, RIGHT_OBSERVE.
        mov rax, r12;
        mov r10, 0x400;
        and rax, r10;
        cmp rax, 0;
        je  acpi_evt_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  acpi_evt_h_gsi;
        cmp r14, 1;
        je  acpi_evt_h_parent;
        cmp r14, 2;
        je  acpi_evt_h_sub;
        cmp r14, 3;
        je  acpi_evt_h_delivered;

        call acpi_evt_row_acked;
        jmp acpi_evt_h_out;

      acpi_evt_h_gsi:
        call acpi_evt_row_gsi;
        jmp acpi_evt_h_out;
      acpi_evt_h_parent:
        call acpi_evt_row_parent;
        jmp acpi_evt_h_out;
      acpi_evt_h_sub:
        call acpi_evt_row_subscriber;
        jmp acpi_evt_h_out;
      acpi_evt_h_delivered:
        call acpi_evt_row_delivered;
        jmp acpi_evt_h_out;

      acpi_evt_h_stream:
        // Ops 5..6: shared stream state, RIGHT_INVOKE.
        mov rax, r12;
        mov r10, 0x008;
        and rax, r10;
        cmp rax, 0;
        je  acpi_evt_h_denied;
        cmp r14, 5;
        jne acpi_evt_h_drops;
        call acpi_evt_depth;
        jmp acpi_evt_h_out;
      acpi_evt_h_drops:
        call acpi_evt_drops;
        jmp acpi_evt_h_out;

      acpi_evt_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp acpi_evt_h_out;
      acpi_evt_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      acpi_evt_h_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
