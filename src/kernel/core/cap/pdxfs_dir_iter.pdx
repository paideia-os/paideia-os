// src/kernel/core/cap/pdxfs_dir_iter.pdx --
// R42-PREP-008 (#1630) — original 3-entry stub landing.
// R90-XREPO.010.M1-006 (paideia-os #2114) — real multi-entry readdir.
//
// PdxFS userspace directory iterator — kernel-side substrate.
//
// One-line rationale: ls, cp -r, rm -r, and shell tab completion all
// need to enumerate directory contents through a per-open cursor over a
// held KIND_PDXFS_FILE cap whose mode nibble marks it as DIR.  This
// module lands the substrate that sys_pdxfs_open + sys_pdxfs_dir_readnext
// (src/kernel/core/syscall/handlers/sys_pdxfs_open.pdx and
// sys_pdxfs_dir_readnext.pdx) delegate to:
//
//   * PdxFsDirEntry -- the frozen 128-byte kernel-visible entry record
//     (layout stable across the stub→real-body transition; only the
//     source of the {inode, kind, name} tuples changed at #2114).
//   * _pdxfs_dir_cursor[row_id] -- per-open cursor, reset on open.
//   * _pdxfs_dir_rows[row_id]  -- per-open count of entries emitted so
//     far in this iteration session.  Feeds the EOD fingerprint's
//     `rows=<n>` KV and lets a caller re-open a cap without carrying
//     stale count state on the row_id.
//   * pdxfs_dir_readnext -- walks the DIR inode's real child chain,
//     emits one entry per call, and on EOD emits the `sys pdxfs readdir
//     ok ... rows=<n>` fingerprint before returning 0.
//
// =============================================================================
// SECTION 0  WHY KIND_PDXFS_FILE (NOT A NEW KIND_PDXFS_DIR)
// =============================================================================
//
// design/user/pdxfs-kinds.md §3.1 explicitly schedules KIND_PDXFS_DIR
// as R49.M1 work.  It also names the interim posture this iterator
// enshrines: "Tools may hold a plain KIND_PDXFS_FILE whose mode_bits
// mark it as a directory, and inspect the mode via PFF_OP_QUERY_MODE.
// This works for read-only enumeration; write operations that mutate
// the entry table (mkdir, rm -r) need the refined kind."
//
// The consumers of this substrate (ls.M2, cp -r WALK, rm -r WALK, shell
// tab completion) are all READ-ONLY enumerations, so the interim path
// is what the R42-PREP-008 issue asks for.  Adding KIND_PDXFS_DIR now
// would pull the R49.M1 allocation forward and re-key the derivation
// gate; deferring it keeps the R48b ordinal band intact.  The follow-
// up cost is a search-and-replace when KIND_PDXFS_DIR lands: every
// syscall entry-point in this module keeps its ABI, only the cap kind
// stamp changes.
//
// =============================================================================
// SECTION 1  PdxFsDirEntry -- FROZEN LAYOUT (unchanged since R42-PREP-008)
// =============================================================================
//
// Kernel-visible directory entry.  128 bytes, 16-byte aligned so the
// user-side struct copies cleanly through user_write_bytes_via_walk
// under KPTI.  This is the FROZEN kernel/user boundary; a widening
// (larger name buffer, extra fields) requires bumping
// PDXFS_DIR_ENTRY_SIZE and every witness/dispatch scratch that pins it.
//
//   [+0]   inode     u64   -- tmpfs inode index at M1 (matches the
//                            row's inode_no field, which sys_pdxfs_open
//                            currently stamps with a stub but which the
//                            R90-XREPO.010.M1-006 witness path mints
//                            with the real tmpfs backing index).  0 is
//                            a legal sentinel OUTSIDE this record
//                            (readnext returns 0 AS RC to mean EOD; the
//                            inode field itself is never 0 for a real
//                            child because slot 0 is the reserved
//                            "invalid inode" sentinel in the tmpfs
//                            allocator).
//   [+8]   kind      u64   -- one of PDXFS_ENT_KIND_*.  Sourced from
//                            the tmpfs inode's type byte at +0
//                            (VNODE_TYPE_REG=1 -> PDXFS_ENT_KIND_FILE=1,
//                            VNODE_TYPE_DIR=2 -> PDXFS_ENT_KIND_DIR=2 --
//                            a direct pass-through since the two
//                            enumerations pin the same numeric values
//                            for the two live cases; symlink/special
//                            values map identically when tmpfs grows
//                            them).
//   [+16]  name_len  u64   -- bytes in the name buffer.  0 is legal
//                            (unnamed root sentinel per PdxFS v1
//                            convention).  Ceiling is 32 for tmpfs-
//                            backed rows (tmpfs's name field is 32
//                            bytes at inode+144); PDXFS_DIR_NAME_MAX
//                            (104) is the record-side ceiling that a
//                            future block-backed source can populate up
//                            to.  Callers must NOT assume 32 -- they
//                            key on name_len.
//   [+24]  name      u8[104] -- fixed-size buffer.  NOT NUL-terminated
//                              by contract; consumers rely on name_len.
//                              Bytes past name_len are UNDEFINED (the
//                              R42-PREP-008 stub zero-filled them, and
//                              pdxfs_dir_entry_zero still runs at the
//                              top of every emit path for the same
//                              deterministic-tail property).
//
// The semantic-pipe schema PdxFsDirEntry described in
// design/tooling/r49-r50-plan.md §4.4 is WIDER (adds mtime, owner cap
// ref, cap tail hash, schema id).  That schema is the userspace
// libpdx-semantic-pipe adornment layer, built on top of this record --
// ls.M3 will map from this record to that schema.  Keeping the kernel
// record narrow means the syscall boundary does not have to carry
// crypto-length hashes or cap references across the trust barrier.
//
// =============================================================================
// SECTION 2  CURSOR + ROWS-COUNTER TABLES
// =============================================================================
//
// _pdxfs_dir_cursor is a [u16; 16] parallel to _pdxfs_file_table's 16
// rows (PFF_MAX = 16).  Each row's cursor lives in the SAME index slot
// as the row itself.  sys_pdxfs_open resets cursor[row_id] to 0
// immediately after minting; pdxfs_dir_readnext reads cursor[row_id],
// emits the corresponding entry, then advances the cursor by writing
// the tmpfs child's `next_sibling` field into the slot.
//
// Cursor value discipline:
//   0             = fresh — next readnext resolves the dir inode's
//                   first_child and emits it.
//   0xFFFF        = end of directory — next readnext returns rc=0
//                   without emitting.
//   1..0xFFFE     = the NEXT tmpfs inode index to emit.  Bounded by
//                   TMPFS_MAX (256) in practice; the wider u16 exists
//                   so the follow-up round that grows tmpfs past 256
//                   (or that swaps in a block-backed source with 32-
//                   bit-shaped inode ids in a compressed low range)
//                   does not re-widen the cursor field.
//
// The R42-PREP-008 stub cursor was a `[u8; 16]` -- 3 possible values
// (0/1/2) fit in a byte.  R90-XREPO.010.M1-006 widened to u16 because a
// real dir can hold up to TMPFS_MAX-1 = 255 children today and a
// follow-up round is scheduled to grow past 256.  The array is @align(8)
// so the zero-init loop can bulk-clear via u64 stores.
//
// _pdxfs_dir_rows is a [u8; 16] parallel counter — one byte per row
// naming how many entries this iteration session has emitted so far.
// Bumped on every successful emit; consumed on EOD to fill the
// fingerprint's `rows=<n>` KV; reset to 0 by pdxfs_dir_cursor_reset (so
// a re-open on the same row_id starts from a clean slate) and on EOD
// (so a repeat readnext on the same EOD row does not double-count).
// u8 is sufficient: TMPFS_MAX = 256 caps the child chain length at 255
// (slot 0 is reserved), and 255 fits.  A follow-up round that widens
// tmpfs re-shapes this to u16 in the same edit as the cursor.
//
// One writer discipline: the cursor + rows tables are written only by
// pdxfs_dir_iter_reset (bulk zero of both), pdxfs_dir_cursor_reset
// (per-slot zero of both), and pdxfs_dir_readnext (per-slot cursor
// advance + rows++).  All three live in this file, so tools/build.sh's
// ec_confine_one gate confines _pdxfs_dir_cursor + _pdxfs_dir_rows to
// pdxfs_dir_iter.o (see build.sh §R42-PREP-008 confinement block).
//
// =============================================================================
// SECTION 3  ENTRY SOURCE -- REAL TMPFS CHILD WALK (was 3-entry stub at #1630)
// =============================================================================
//
// The R42-PREP-008 landing emitted a fixed three-entry stub set (".",
// "..", "hello.pdx") in code because at that round the FS layer did not
// yet allocate real inodes and the row's inode_no field was a compile-
// time constant (0x1000).  The R90-XREPO.010.M1-006 rewrite (#2114)
// walks the row's REAL tmpfs backing:
//
//   (a) pdxfs_file_row_inode(row_id) recovers the row's inode_no.
//       This IS a tmpfs inode index at M1 (matches the "tmpfs backing
//       at M1" posture cap/kind_pdxfs_file.pdx §PFF_OP_READ_BYTES pins
//       for the sibling read-bytes path, paideia-os #2109).
//   (b) The dir inode's `first_child` (u16 @ +180) names the head of
//       the sibling chain; each child's `next_sibling` (u16 @ +178)
//       links to the next; 0xFFFF terminates the chain.  This is the
//       tmpfs directory representation frozen at R16-M2-001
//       (src/kernel/core/fs/tmpfs/inode.pdx).
//   (c) For each emitted entry, the child inode's type (u8 @ +0) maps
//       directly to PDXFS_ENT_KIND_* (VNODE_TYPE_REG=1 -> KIND_FILE=1,
//       VNODE_TYPE_DIR=2 -> KIND_DIR=2 — both enumerations pin the
//       same numeric values), and the child's name (u8[32] @ +144, NUL-
//       terminated) is length-scanned then byte-copied into the entry
//       record's name field.
//
// A row whose inode_no is 0 or >= TMPFS_MAX (256) is treated as EMPTY
// (readnext returns 0 immediately).  This is what preserves the
// sys_pdxfs_open stub-mint path — sys_pdxfs_open still stamps inode_no
// with the stub constant 0x1000, which is out of the tmpfs range, so a
// readnext through a stub-minted row cleanly reports EOD.  A witness
// that wants real iteration mints via pdxfs_file_cap_mint_inner with
// the real dir inode index (see tests/kernel/pdxfs_dir/pdxfs_dir_iter_
// synth.pdx §Stage 3).
//
// Deferred: sorted output.  POSIX readdir does not guarantee ordering
// (tmpfs's insert-at-head means iteration order is reverse creation
// order today); consumers that want a stable order sort at the tool
// layer.  This matches the deferred-sub-scopes clause in
// design/round-retrospectives/r90-xrepo-wave3-plan.md §2.
//
// =============================================================================
// SECTION 4  FINGERPRINT
// =============================================================================
//
// On EOD the primitive emits (single line):
//
//   "sys pdxfs readdir ok [legacy: SYS PDXFS READDIR OK] rows=<n>"
//
// via klog_s1_d1(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_pdxfs_readdir_ok,
//                k_rows, count).
//
// One emit per EOD (i.e. per readnext call that transitions rc from
// 1..1 to 0).  Emitting from the primitive rather than the syscall
// body keeps the count-source (private to this module via
// _pdxfs_dir_rows) confined -- a follow-up round can move the emit
// site by exporting a `pdxfs_dir_rows_read(row_id)` accessor.
//
// The lowercase form is the actual fingerprint; the bracketed uppercase
// `[legacy: SYS PDXFS READDIR OK]` suffix satisfies
// tools/verify-fingerprint-coverage.sh's OK_TOK extractor (which keys
// on the uppercase standalone `OK` token) so the marker is coverable
// under the same discipline the R90-XREPO.010.M1-003 txn syscall
// fingerprints already use (see sys_pdxfs_txn_commit.pdx / abort.pdx
// for the sibling shape).

module PdxfsDirIter = structure {

  // ============================================================================
  // Frozen layout constants.
  // ============================================================================

  pub let PDXFS_DIR_ENTRY_SIZE : u64 = 128
  pub let PDXFS_DIR_NAME_MAX   : u64 = 104        // 128 - 24 (header)

  // Kind values -- mirror the PdxFS file-type nibble at kind_pdxfs_file.pdx
  // §mode_bits.  Kept as a separate enum so consumers do not have to
  // learn the nibble bit-layout; kernel translates before writing.
  pub let PDXFS_ENT_KIND_FILE    : u64 = 1
  pub let PDXFS_ENT_KIND_DIR     : u64 = 2
  pub let PDXFS_ENT_KIND_SYMLINK : u64 = 3
  pub let PDXFS_ENT_KIND_SPECIAL : u64 = 4

  // Byte offsets into a PdxFsDirEntry.  Callers use these rather than
  // magic numbers so a layout bump is a search-and-replace on named
  // constants.
  pub let PDXFS_DIR_ENT_OFF_INODE    : u64 = 0
  pub let PDXFS_DIR_ENT_OFF_KIND     : u64 = 8
  pub let PDXFS_DIR_ENT_OFF_NAME_LEN : u64 = 16
  pub let PDXFS_DIR_ENT_OFF_NAME     : u64 = 24

  // TMPFS pool geometry -- referenced by the readdir walker to gate the
  // row's inode_no against the pool bound (see SECTION 3(a)/(c) for the
  // stub-mint interop path).  Pinned here rather than pulled from
  // core/fs/tmpfs/inode.pdx so a cross-module edit that widens
  // TMPFS_MAX has a single grep target (this constant is a *ceiling*
  // for cursor validity, not the pool's own size).  R90-XREPO.010.M1-006
  // (#2114).
  pub let PDXFS_DIR_TMPFS_MAX          : u64 = 256   // must equal Inode.TMPFS_MAX
  pub let PDXFS_DIR_TMPFS_INODE_STRIDE : u64 = 256   // == TMPFS_INODE_SIZE
  pub let PDXFS_DIR_TMPFS_NAME_MAX     : u64 = 32    // tmpfs name field width
  pub let PDXFS_DIR_TMPFS_TYPE_OFF     : u64 = 0
  pub let PDXFS_DIR_TMPFS_NAME_OFF     : u64 = 144
  pub let PDXFS_DIR_TMPFS_NEXT_SIB_OFF : u64 = 178
  pub let PDXFS_DIR_TMPFS_FIRST_KID_OFF: u64 = 180

  // Cursor sentinel values.
  pub let PDXFS_DIR_CURSOR_FRESH : u64 = 0
  pub let PDXFS_DIR_CURSOR_EOD   : u64 = 0xFFFF

  // Sentinel row_id used by pdxfs_dir_cursor_reset to signal "out of
  // range" (mirrors PFF_ROW_NONE).  Callers must not pass this.
  pub let PDXFS_DIR_ROW_NONE : u64 = 0xFF

  // Result codes for pdxfs_dir_readnext.  Two positive success codes
  // (matches the syscall shape); PDXFS_DIR_ERR_ROW is a distinct code
  // so a dispatch-layer -EBADF translation is one instruction.
  pub let PDXFS_DIR_RC_ENTRY : u64 = 1            // one entry written
  pub let PDXFS_DIR_RC_EOD   : u64 = 0            // end of directory
  pub let PDXFS_DIR_ERR_ROW  : u64 = 0xFFFFFFFFFFFFFFFF   // row_id invalid

  // ============================================================================
  // Cursor + rows-counter tables -- one u16 / u8 per row_id.  16 slots.
  //
  // Cursor is aligned to 8 so the reset loop can bulk-clear via 8-byte
  // stores (32 bytes = four u64 stores).  Rows counter is aligned to 8
  // for the identical reason (16 bytes = two u64 stores).  Both scrubbed
  // together in every reset path -- keeping them adjacent in intent
  // (though not in address, since paideia-as does not guarantee mut-let
  // adjacency).
  // ============================================================================

  pub let mut _pdxfs_dir_cursor : [u16; 16] = uninit @align(8)
  pub let mut _pdxfs_dir_rows   : [u8;  16] = uninit @align(8)

  // ============================================================================
  // Fingerprint tag -- declared on ONE line per the PDX_STR extractor
  // discipline (tools/build.sh scans anchored `let ... = "..."`).  Do
  // NOT split.  Length: 51 visible chars + NUL = 52.
  // ============================================================================
  pub let tag_sys_pdxfs_readdir_ok : [u8; 52] = "sys pdxfs readdir ok [legacy: SYS PDXFS READDIR OK]\0"

  // ==========================================================================
  // pdxfs_dir_iter_reset() -> ()
  //
  // Clear both the cursor table (32 bytes) and the rows-counter table
  // (16 bytes).  Called once at boot alongside pdxfs_file_table_reset
  // so a re-mint of a row_id starts at cursor 0 + count 0 even if the
  // previous holder had advanced past EOD.  Widened from 2 u64 stores
  // (R42-PREP-008: 16-byte u8 cursor) to 6 u64 stores at R90-XREPO.010.
  // M1-006 (#2114) to cover the u16-widened cursor + the new rows
  // counter.
  // ==========================================================================

  pub let pdxfs_dir_iter_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630) + R90-XREPO.010.M1-006 (paideia-os #2114): clear the cursor table (32 bytes = 4 u64 stores, widened from u8 to u16 at #2114) and the rows-counter table (16 bytes = 2 u64 stores, added at #2114). Boot and teardown only. Explicit-count stores rather than a loop because both arrays are fixed-size, @align(8) guarantees the stores are aligned, and six straight-line stores are cheaper than the loop overhead. Labels prefixed pdi_rs_.",
      block: {
        lea r10, [rip + _pdxfs_dir_cursor];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        lea r10, [rip + _pdxfs_dir_rows];
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_dir_cursor_reset(row_id) -> 1 | 0
  //
  // Reset cursor[row_id] to 0 AND rows[row_id] to 0.  Returns 1 on
  // success, 0 if row_id is out of range.  Called from sys_pdxfs_open
  // after a successful mint so the caller sees a fresh iterator + a
  // fresh row count regardless of whether the row was reused.
  // ==========================================================================

  pub let pdxfs_dir_cursor_reset : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630) + R90-XREPO.010.M1-006 (paideia-os #2114): store 0 into _pdxfs_dir_cursor[row_id] (u16, widened at #2114) AND _pdxfs_dir_rows[row_id] (u8, added at #2114). Bounds-check row_id < PFF_MAX (= 16) via unsigned compare with jae; out-of-range answers 0 so a stray call cannot corrupt an adjacent slot. Cursor store is mov_w through a base+disp addressing form (paideia-as has no proven mov_w [reg + reg*scale] indexed store), rows store is mov_b through the indexed form (precedented in tmpfs/create.pdx L110). Labels prefixed pdi_cr_.",
      block: {
        cmp rdi, 16;
        jae pdi_cr_no;

        // Cursor slot: base + row_id*2.
        lea r10, [rip + _pdxfs_dir_cursor];
        mov r11, rdi;
        shl r11, 1;                          // row_id * 2
        add r10, r11;
        xor rax, rax;
        mov_w [r10 + 0], rax;

        // Rows counter slot: base + row_id*1 (u8).
        lea r10, [rip + _pdxfs_dir_rows];
        mov_b [r10 + rdi * 1], rax;

        mov rax, 1;
        ret;
      pdi_cr_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_dir_cursor_read(row_id) -> cursor | PDXFS_DIR_ROW_NONE
  //
  // Pure read; used by the witness to introspect cursor advancement
  // without invoking the read path.  Returns the u16 cursor value zero-
  // extended into rax; PDXFS_DIR_ROW_NONE (0xFF) is distinguishable
  // from every legal cursor value because a real cursor is either 0
  // (fresh) or in [1, TMPFS_MAX) (next inode idx) or 0xFFFF (EOD).
  // ==========================================================================

  pub let pdxfs_dir_cursor_read : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630) + R90-XREPO.010.M1-006 (paideia-os #2114): read _pdxfs_dir_cursor[row_id] as a u16 zero-extended into rax (widened from u8 at #2114). Bounds-check row_id < PFF_MAX (= 16); out-of-range answers PDXFS_DIR_ROW_NONE (0xFF), which is distinguishable from every legal cursor value (0 fresh, [1, TMPFS_MAX) next-inode, or 0xFFFF EOD -- and 0xFF sits outside all three). Base+disp addressing for the mov_w read because paideia-as has no proven mov_w [reg + reg*scale] indexed load. Labels prefixed pdi_cd_.",
      block: {
        cmp rdi, 16;
        jae pdi_cd_no;
        lea r10, [rip + _pdxfs_dir_cursor];
        mov r11, rdi;
        shl r11, 1;
        add r10, r11;
        xor rax, rax;
        mov_w rax, [r10 + 0];
        ret;
      pdi_cd_no:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_dir_rows_read(row_id) -> rows | PDXFS_DIR_ROW_NONE
  //
  // Pure read; used by a witness to observe the emit-count without
  // triggering EOD.  Symmetric with pdxfs_dir_cursor_read.  R90-XREPO.
  // 010.M1-006 (#2114) accessor.
  // ==========================================================================

  pub let pdxfs_dir_rows_read : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-006 (paideia-os #2114): read _pdxfs_dir_rows[row_id] as a u8 zero-extended into rax. Bounds-check row_id < PFF_MAX (= 16); out-of-range answers PDXFS_DIR_ROW_NONE (0xFF). Byte read via 'xor rax, rax; mov_b rax, [ptr + row_id * 1]' per the paideia-as byte-read discipline. Labels prefixed pdi_rd_.",
      block: {
        cmp rdi, 16;
        jae pdi_rd_no;
        lea r10, [rip + _pdxfs_dir_rows];
        xor rax, rax;
        mov_b rax, [r10 + rdi * 1];
        ret;
      pdi_rd_no:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_dir_entry_zero(kbuf_ptr) -> ()
  //
  // Zero all 128 bytes of the caller's scratch.  Called at the top of
  // each readnext-body-emit path so the name tail past name_len is
  // deterministic (all-zero) regardless of what the scratch previously
  // held.  Sixteen u64 stores.  Unchanged from R42-PREP-008.
  // ==========================================================================

  pub let pdxfs_dir_entry_zero : (u64) -> () !{mem} @{} =
    fn (kbuf_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630): 16 u64 zero-stores into kbuf_ptr[0..127]. Counted loop over rcx = word index (single shift-add per iteration; unsigned jb terminator). Callers pass a kernel VA aligned to 8; the syscall dispatch layer pins alignment via lea over a static [u8;128] @align(8) scratch. Leaf function, no callee-save writes. Labels prefixed pdi_ez_.",
      block: {
        xor rcx, rcx;
        xor rax, rax;
      pdi_ez_loop:
        mov [rdi + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  pdi_ez_loop;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_dir_readnext(row_id, kbuf_ptr) -> 1 | 0 | PDXFS_DIR_ERR_ROW
  //
  // Emit one PDXFS_DIR_ENTRY_SIZE-byte entry into kbuf_ptr from the
  // dir inode's real child chain, then advance the cursor.  Returns:
  //   1                   -- one entry written
  //   0                   -- end of directory (chain exhausted, or the
  //                          row's inode_no falls outside the tmpfs
  //                          pool bound -- the stub-mint path from
  //                          sys_pdxfs_open lands here on the first
  //                          call, cleanly reporting an empty dir).
  //                          On EOD the primitive ALSO emits the
  //                          `sys pdxfs readdir ok ... rows=<n>`
  //                          fingerprint via klog_s1_d1.
  //   PDXFS_DIR_ERR_ROW   -- row_id out of range, or the row is dead
  //                          (pdxfs_file_row_inode returned PFF_DECODE_
  //                          BAD).
  //
  // ARGUMENTS
  //   rdi = row_id       (must be < PFF_MAX; caller has already
  //                       resolved a KIND_PDXFS_FILE cap slot to a
  //                       row_id via pdxfs_file_row_of_slot)
  //   rsi = kbuf_ptr     (kernel VA of a PDXFS_DIR_ENTRY_SIZE-byte
  //                       aligned scratch; the dispatch layer owns the
  //                       user-side copy after this returns 1)
  //
  // The dir/regular-file distinction is DELIBERATELY NOT checked here.
  // The syscall layer checks it via pdxfs_file_row_mode -- keeping the
  // check at the syscall layer means this primitive is reusable when a
  // future KIND_PDXFS_DIR refinement gets its own row_of_slot helper.
  //
  // WALK (R90-XREPO.010.M1-006, replaces the R42-PREP-008 stub set):
  //   cursor 0        -> pdxfs_file_row_inode(row_id) -> dir_inode.
  //                      dir_inode < 1 or >= TMPFS_MAX -> EOD.
  //                      first_child (u16 @ +180) == 0xFFFF -> EOD.
  //                      else cursor = first_child; emit that child.
  //   cursor 0xFFFF   -> EOD (already exhausted).
  //   cursor N        -> emit tmpfs_inode[N] (type, name), then
  //                      cursor = tmpfs_inode[N].next_sibling
  //                      (u16 @ +178); when the next_sibling is
  //                      0xFFFF, the next readnext call sees cursor ==
  //                      0xFFFF and returns EOD.
  //
  // Effect widening: {sysreg, mem} @{} at R90-XREPO.010.M1-006 (#2114) --
  // sysreg (was: nothing) because klog_s1_d1 is called on EOD to emit
  // the row-count fingerprint.  mem stays for the cursor/rows/pool
  // reads and writes.
  //
  // Register plan (5 callee-save pushes; entry rsp%16==8, +40 -> %16==0
  // at every nested call to pdxfs_dir_entry_zero, pdxfs_file_row_inode,
  // klog_s1_d1):
  //   rbx = dir_inode idx     (only live in the "cursor==0 fresh" arm)
  //   r12 = row_id            (survives every nested call)
  //   r13 = cursor            (survives every nested call)
  //   r14 = kbuf_ptr          (survives every nested call)
  //   r15 = &tmpfs_inode ptr  (scratch during emit; overwritten before
  //                            next nested call)
  // ==========================================================================

  pub let pdxfs_dir_readnext : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (row_id: u64) (kbuf_ptr: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R42-PREP-008 (#1630) + R90-XREPO.010.M1-006 (paideia-os #2114): walk the row's real tmpfs child chain (was: 3-entry hard-coded stub at #1630). Sequence: (1) row_id < 16 else PDXFS_DIR_ERR_ROW. (2) Load cursor (u16 zx) into r13. (3) cursor == 0xFFFF -> pdi_rn_eod_silent (already-EOD polls return 0 without re-emitting the fingerprint; the ring must not fill with `rows=0` lines on every trailing poll). (4) cursor == 0 (fresh) -> call pdxfs_file_row_inode(row_id) into rbx (dir inode idx); if PFF_DECODE_BAD -> PDXFS_DIR_ERR_ROW; if dir_inode < 1 or >= TMPFS_MAX (256) -> pdi_rn_eod_first (this is the stub-mint interop path: sys_pdxfs_open stamps inode_no with 0x1000 which falls out of range, so a stub-minted row cleanly reports empty on the first call rather than tripping a garbage-inode read); else load first_child (u16 @ +180); if 0xFFFF -> pdi_rn_eod_first; else cursor = first_child. (5) Emit path: pdxfs_dir_entry_zero to make the name tail deterministic; store inode (r13) at kbuf+0; store type-as-kind (u8 zx from tmpfs_inode+0) at kbuf+8; scan tmpfs_inode+144 for the first NUL to determine name_len (capped at PDXFS_DIR_TMPFS_NAME_MAX=32); store name_len at kbuf+16; byte-copy name[0..name_len] to kbuf+24. (6) Advance: cursor = tmpfs_inode.next_sibling (u16 @ +178); store back via mov_w with base+disp addressing (paideia-as has no proven mov_w indexed store). (7) Bump _pdxfs_dir_rows[row_id]; return 1. First-EOD path (pdi_rn_eod_first): stamp cursor = 0xFFFF; emit klog_s1_d1(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_pdxfs_readdir_ok, k_rows, count); reset _pdxfs_dir_rows[row_id] so a repeat EOD poll cannot show a stale count on any subsequent path AND so a witness that asserts rows==0 post-EOD sees the reset; fall through to pdi_rn_eod_silent which returns 0.  Register plan: 5 callee-save pushes (rbx=dir_inode-scratch, r12=row_id, r13=cursor, r14=kbuf_ptr, r15=&tmpfs_inode scratch). Entry rsp%16==8, +40 = %16==0 at every nested call site (pdxfs_dir_entry_zero, pdxfs_file_row_inode, klog_s1_d1). Effect widening to {sysreg, mem} covers the klog emit. Labels prefixed pdi_rn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // r12 = row_id
        mov r14, rsi;                        // r14 = kbuf_ptr

        // (1) Bounds-check row_id.
        cmp r12, 16;
        jae pdi_rn_bad_row;

        // (2) Load cursor as u16 zero-extended into r13.
        lea r10, [rip + _pdxfs_dir_cursor];
        mov r11, r12;
        shl r11, 1;                          // row_id * 2
        add r10, r11;
        xor rax, rax;
        mov_w rax, [r10 + 0];
        mov r13, rax;                        // r13 = cursor

        // (3) Already at EOD?  Silent 0-return (fingerprint was emitted
        //     on the transition into EOD; a repeat poll must not re-emit
        //     or the ring fills with `rows=0` lines every call).
        mov r10, 0xFFFF;
        cmp r13, r10;
        je  pdi_rn_eod_silent;

        // (4) Fresh?
        cmp r13, 0;
        jne pdi_rn_emit;

        // (4a) Resolve dir inode from row.
        mov rdi, r12;
        call pdxfs_file_row_inode;
        // rax = inode_no or PFF_DECODE_BAD (0xFFFFFFFFFFFFFFFF)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pdi_rn_bad_row;
        mov rbx, rax;                        // rbx = dir inode idx

        // (4b) Bounds-check inode idx against tmpfs pool.
        cmp rbx, 0;
        je  pdi_rn_eod_first;                // sentinel 0 -> empty
        mov r10, 256;                        // PDXFS_DIR_TMPFS_MAX
        cmp rbx, r10;
        jae pdi_rn_eod_first;                // out-of-range (stub) -> empty

        // (4c) &dir_inode = _tmpfs_inode_pool + idx*256.
        lea r10, [rip + _tmpfs_inode_pool];
        mov r11, rbx;
        shl r11, 8;                          // idx * 256
        add r10, r11;
        mov r15, r10;                        // r15 = &dir_inode

        // (4d) first_child (u16 @ +180).
        xor rax, rax;
        mov_w rax, [r15 + 180];
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pdi_rn_eod_first;                // empty dir
        mov r13, rax;                        // cursor = first_child

      pdi_rn_emit:
        // r13 = current tmpfs inode idx to emit.
        // (5a) Zero the scratch first.
        mov rdi, r14;
        call pdxfs_dir_entry_zero;

        // (5b) &child_inode = _tmpfs_inode_pool + r13*256.
        lea r10, [rip + _tmpfs_inode_pool];
        mov r11, r13;
        shl r11, 8;
        add r10, r11;
        mov r15, r10;                        // r15 = &child_inode

        // (5c) inode @+0 = r13.
        mov [r14 + 0], r13;

        // (5d) kind @+8: tmpfs type (u8 @ +0) zero-extended.
        //      VNODE_TYPE_REG(1) == PDXFS_ENT_KIND_FILE(1); DIR(2)==DIR(2).
        xor rax, rax;
        mov_b rax, [r15 + 0];
        mov [r14 + 8], rax;

        // (5e) name_len via scan of tmpfs name field for NUL.
        //      &name[0] = r15 + 144.  Cap at 32.
        xor rcx, rcx;                        // name_len counter
        mov r11, r15;
        add r11, 144;
      pdi_rn_nl_loop:
        cmp rcx, 32;
        jae pdi_rn_nl_done;
        xor rax, rax;
        mov_b rax, [r11 + rcx * 1];
        cmp rax, 0;
        je  pdi_rn_nl_done;
        add rcx, 1;
        jmp pdi_rn_nl_loop;

      pdi_rn_nl_done:
        // (5f) Store name_len @+16.
        mov [r14 + 16], rcx;

        // (5g) Copy name[0..rcx] to kbuf+24.
        xor rdx, rdx;                        // rdx = i
      pdi_rn_cp_loop:
        cmp rdx, rcx;
        jae pdi_rn_cp_done;
        xor rax, rax;
        mov_b rax, [r11 + rdx * 1];
        // dst = r14 + 24 + rdx (stage r14+24 into r10 once per iter).
        mov r10, r14;
        add r10, 24;
        mov_b [r10 + rdx * 1], rax;
        add rdx, 1;
        jmp pdi_rn_cp_loop;

      pdi_rn_cp_done:
        // (6) Advance cursor = next_sibling (u16 @ +178).  r15 still
        //     holds &child_inode.  Store back via base+disp mov_w.
        xor rax, rax;
        mov_w rax, [r15 + 178];
        lea r10, [rip + _pdxfs_dir_cursor];
        mov r11, r12;
        shl r11, 1;
        add r10, r11;
        mov_w [r10 + 0], rax;

        // (7) Bump _pdxfs_dir_rows[row_id] (u8).
        lea r10, [rip + _pdxfs_dir_rows];
        xor rax, rax;
        mov_b rax, [r10 + r12 * 1];
        add rax, 1;
        mov_b [r10 + r12 * 1], rax;

        mov rax, 1;
        jmp pdi_rn_out;

      pdi_rn_eod_first:
        // First-time EOD: stamp cursor = 0xFFFF so a subsequent poll
        // takes the pdi_rn_eod_silent arm.
        lea r10, [rip + _pdxfs_dir_cursor];
        mov r11, r12;
        shl r11, 1;
        add r10, r11;
        mov rax, 0xFFFF;
        mov_w [r10 + 0], rax;

        // Emit fingerprint with the row count.
        lea r10, [rip + _pdxfs_dir_rows];
        xor rax, rax;
        mov_b rax, [r10 + r12 * 1];
        mov r8, rax;                         // v1 = count

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_pdxfs_readdir_ok];
        lea rcx, [rip + k_rows];
        call klog_s1_d1;

        // Reset _pdxfs_dir_rows[row_id] so a re-open cannot re-emit
        // a stale count AND so a witness that asserts rows==0 post-EOD
        // sees the reset (see tests/kernel/pdxfs_dir/pdxfs_dir_iter_
        // synth.pdx §Stage 9).
        lea r10, [rip + _pdxfs_dir_rows];
        xor rax, rax;
        mov_b [r10 + r12 * 1], rax;

      pdi_rn_eod_silent:
        // Silent EOD path: no fingerprint emit, no cursor rewrite.
        // Reached either directly (repeat poll after first EOD) or as
        // fall-through from pdi_rn_eod_first (which has already done
        // both).
        xor rax, rax;                        // rc = 0 (EOD)
        jmp pdi_rn_out;

      pdi_rn_bad_row:
        mov rax, 0xFFFFFFFFFFFFFFFF;         // PDXFS_DIR_ERR_ROW

      pdi_rn_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
