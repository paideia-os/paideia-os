// src/kernel/core/cap/kind_cooling_device.pdx — R31.M4-001 (#1103)
//
// KIND_COOLING_DEVICE = 0x159, derived over KIND_DEVICE (10).
//
// The authority to hold one cooling device's static identity (index,
// type, [state_min .. state_max] range) and to be told what its most
// recently reported cooling state was.
//
// =============================================================================
// §0  UNITS: STATE IS A DIMENSIONLESS ORDINAL IN [state_min, state_max]
// =============================================================================
//
// ACPI 6.5 §11.7 reports cooling-device state as an unsigned integer
// whose meaning is device-local: for a fan it is a speed table index,
// for a throttling controller it is a percent-throttled ordinal, for a
// power-state controller it is a Dn ordinal. THIS KIND STORES THE
// ORDINAL. There is no conversion in the module at all -- comparisons,
// storage and the report installer are all in ORDINAL, so the
// per-device meaning is preserved verbatim.
//
// The one silent failure this class of device is prone to is a SWAP
// BETWEEN CONVENTIONS: a fan whose 0 means OFF read as a fan whose 0
// means MAX inverts every cooling decision that will ever be taken
// from it. The kernel cannot know which convention any part uses -- it
// is namespace, and ring 0 may not read namespace -- so THE ORDINAL IS
// STORED AS-IS AND NEVER INTERPRETED. §4 states what this kind does
// not do and why the interpretation stays in ring 3.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS INSTALLED
// =============================================================================
//
// Same discipline as `kind_battery.pdx` §1 and `kind_thermal_zone.pdx`
// §2. `index`, `cooling_type`, `state_min` and `state_max` are ROW
// IDENTITY -- they name the physical device and its unchanging control
// surface -- and are refused to a mint that supplies implausible
// values. The dynamic field (current_state, report count) starts at
// COOLING_STATE_NONE and is updated by `cooling_report_install`,
// REACHABLE ONLY THROUGH THE ROUTED ASSESSMENT: capability in, one
// ordinal in, no other parameter.
//
// WHAT `design_cap_mwh` IS TO A BATTERY, `state_max` IS TO A COOLING
// DEVICE. It is set once by the mint and there is no primitive
// anywhere that changes it. A state_max that could be raised by a
// caller would let a fan appear to have a higher speed available than
// it does; a state_max that could be lowered would let the top speed
// of a fan the platform is willing to run become unreachable.
//
// =============================================================================
// §2  DERIVATION OVER KIND_DEVICE — THE FIFTH TIME THE KIND HALF PROVES
//     NOTHING
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`. As
// with KIND_THERMAL_ZONE and KIND_BATTERY, that half discriminates
// NOTHING on its own: every PCI function in the machine is a
// KIND_DEVICE, and "this device is a cooling device" is a
// firmware-namespace fact this ring may not read
// (design/acpi/no-aml-in-kernel.md). The kernel enforces exactly what
// it can:
//
//   * The inherited device key must be NON-ZERO
//     (`COOLING_MINT_NO_DEVICE`).
//   * NO OTHER LIVE ROW MAY HOLD THAT KEY
//     (`COOLING_MINT_COOL_IN_USE`). One cooling device, one capability
//     -- two capabilities for one fan means two servers with two
//     independent state ordinals writing one control surface, and the
//     one that writes last decides.
//   * The static identity is plausible: index < COOLING_INDEX_MAX,
//     cooling_type in the small enumeration in §5, state_max >
//     state_min, state_max <= COOLING_STATE_UPPER.
//
// The discrimination this gate does not perform is performed by the
// ring-3 supervisor that walked the namespace, and the capability is
// the record of ITS decision.
//
// =============================================================================
// §3  A GARBAGE STATE REPORT IS DANGEROUS IN BOTH DIRECTIONS
// =============================================================================
//
// A state report comes through whoever holds the ring-3 policy
// authority, and #1580 is still open: EC transactions that some
// cooling controllers ride are UNARBITRATED against SMM.
//
//   * A state above state_max that is silently CLAMPED hides a bug
//     from the operator and pins the fan at its top speed regardless
//     of what the report meant to say -- the machine survives but the
//     fan runs forever.
//   * A state below state_min that is silently CLAMPED hides the
//     opposite bug -- the fan drops to its floor state (typically
//     OFF) regardless of what the sender intended, and the part
//     cooks.
//
// So `cooling_state_valid` refuses anything outside
// `[state_min, state_max]` INCLUSIVE with
// `COOLING_IMPLAUSIBLE_STATE`, and the report installer counts the
// refusal. NOTHING IS CLAMPED anywhere in this path.
//
// UNLIKE THERMAL_ZONE THERE IS NO TWO-READING CONFIRMATION. A cooling
// report only updates the row's cached view of a state the actuator
// will see again in the next tick.
//
// =============================================================================
// §4  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
//   * NOTHING ACTUATES A FAN. `cooling_report_install` returns
//     COOLING_OK for any legal state; there is no MMIO or port I/O
//     path in this kind at all. Which state means which speed, and
//     how that speed is set, is namespace-level knowledge held by the
//     ring-3 supervisor that mints the capability.
//   * NOTHING SETS A COOLING STATE FROM A THERMAL LEVEL. The
//     level-to-device association is `_ALx`, which is namespace,
//     which is ring 3's. See kind_thermal_zone.pdx §6.
//   * NOTHING INTERPRETS THE ORDINAL. §0.
//
// =============================================================================
// §5  ENUMERATIONS: COOLING TYPE
// =============================================================================
//
//   0 UNKNOWN     firmware advertised no _PPC/_TSD/_PSD hint the
//                 supervisor could translate
//   1 FAN         state is a fan-speed table index (typical _FST)
//   2 THROTTLE    state is a percent-throttled ordinal (typical _TSS)
//   3 POWER_STATE state is a Dn ordinal (D0..D3)
//
// The kind stores the ordinal after the supervisor's parse. Refused
// rather than mapped to UNKNOWN so 'the firmware advertised something
// we do not understand' and 'the firmware advertised nothing' are
// different facts.
//
// =============================================================================
// §6  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// This module contains no `in`/`out` and no firmware-bytecode
// identifier. `tools/lint-no-kernel-aml.sh` refuses any kernel
// identifier matching `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`, `\_SB_`
// or `\_SB.`. KIND_COOLING_DEVICE, cooling_* and _cooling_device_table
// match none of the six; the `_FST`/`_TSS` names above are in comments
// only.
//
// =============================================================================

module KindCoolingDevice = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_COOLING_DEVICE   : u64 = 0x159  // derived-kind tag (345)
  pub let COOLING_PARENT_KIND   : u64 = 10     // = KIND_DEVICE

  // ==========================================================================
  // §0 / §1 bounds.
  // ==========================================================================

  pub let COOLING_INDEX_MAX     : u64 = 16     // 0..15
  pub let COOLING_STATE_UPPER   : u64 = 255    // state_max <= 255

  // ==========================================================================
  // §5 cooling-type enumeration.
  // ==========================================================================

  pub let COOLING_TYPE_UNKNOWN     : u64 = 0
  pub let COOLING_TYPE_FAN         : u64 = 1
  pub let COOLING_TYPE_THROTTLE    : u64 = 2
  pub let COOLING_TYPE_POWER_STATE : u64 = 3
  pub let COOLING_TYPE_MAX         : u64 = 3

  // ==========================================================================
  // Rights.
  //
  // R_COOLING_READ and R_COOLING_REPORT are the two halves that matter.
  // A monitor needs READ forever; a policy server that pushes state
  // reports needs REPORT as well. RIGHT_MINT (0x200) is OUTSIDE the
  // mask: this kind is a leaf. Nothing in the tree derives from a
  // cooling capability.
  // ==========================================================================

  pub let R_COOLING_READ    : u64 = 0x001
  pub let R_COOLING_REPORT  : u64 = 0x002
  pub let R_COOLING_INVOKE  : u64 = 0x008
  pub let R_COOLING_REVOKE  : u64 = 0x010
  pub let R_COOLING_OBSERVE : u64 = 0x400
  pub let R_COOLING_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each requires.
  //
  //   0 QUERY_INDEX     INVOKE   the row's own cooling index
  //   1 QUERY_TYPE      INVOKE   cooling type ordinal
  //   2 QUERY_MIN       INVOKE   state_min
  //   3 QUERY_MAX       INVOKE   state_max
  //   4 QUERY_STATE     READ     last reported state, 0xFFFF if none
  //   5 QUERY_REPORTS   INVOKE   report count, lifetime
  //   6 QUERY_PARENT    INVOKE   the parent KIND_DEVICE slot
  //   7 DEBUG_PRINT     OBSERVE  canonical row dump
  //   8 REPORT          REPORT   push {cur_state}
  //
  // REPORT packs one value in op_arg:
  //   op_arg[7:0]   = op = 8
  //   op_arg[23:8]  = cur_state (16 bits)
  //   op_arg[63:24] = reserved, MUST be zero
  //
  // The reserved field is REFUSED with COOLING_TAIL_BAD_ARG rather
  // than masked, for the reason kind_battery's REPORT reserved is:
  // forty free bits on an op that reaches the row's cached state is
  // where a second value would be smuggled.
  // ==========================================================================

  pub let COOLING_OP_QUERY_INDEX   : u64 = 0
  pub let COOLING_OP_QUERY_TYPE    : u64 = 1
  pub let COOLING_OP_QUERY_MIN     : u64 = 2
  pub let COOLING_OP_QUERY_MAX     : u64 = 3
  pub let COOLING_OP_QUERY_STATE   : u64 = 4
  pub let COOLING_OP_QUERY_REPORTS : u64 = 5
  pub let COOLING_OP_QUERY_PARENT  : u64 = 6
  pub let COOLING_OP_DEBUG_PRINT   : u64 = 7
  pub let COOLING_OP_REPORT        : u64 = 8
  pub let COOLING_OP_MAX           : u64 = 8

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE50..0xFFFFFE5F.
  //
  // Sixteen-wide, disjoint from KIND_BATTERY (0xFFFFFE40..4F),
  // KIND_THERMAL_ZONE (0xFFFFFE30..3F), owner (0xFFFFFE2B..2F),
  // thermal policy (0xFFFFFE20..2A) and KIND_FW_SESSION
  // (0xFFFFFE10..1F). Disjointness is what lets a u64 threaded up
  // through the mint, the row allocator and the dispatch handler still
  // name the gate that refused it.
  // ==========================================================================

  pub let COOLING_OK                : u64 = 0
  pub let COOLING_TAIL_ENOSPC       : u64 = 0xFFFFFE5F
  pub let COOLING_TAIL_BAD_ARG      : u64 = 0xFFFFFE5E
  pub let COOLING_MINT_BAD_PARENT   : u64 = 0xFFFFFE5D
  pub let COOLING_MINT_BAD_RIGHTS   : u64 = 0xFFFFFE5C
  pub let COOLING_MINT_BAD_INDEX    : u64 = 0xFFFFFE5B
  pub let COOLING_MINT_BAD_TYPE     : u64 = 0xFFFFFE5A
  pub let COOLING_MINT_BAD_RANGE    : u64 = 0xFFFFFE59
  pub let COOLING_MINT_NO_DEVICE    : u64 = 0xFFFFFE58
  pub let COOLING_MINT_ENOSPC       : u64 = 0xFFFFFE57
  pub let COOLING_MINT_COOL_IN_USE  : u64 = 0xFFFFFE56
  pub let COOLING_BAD_SLOT          : u64 = 0xFFFFFE55
  pub let COOLING_WRONG_KIND        : u64 = 0xFFFFFE54
  pub let COOLING_REVOKE_ALREADY    : u64 = 0xFFFFFE53
  pub let COOLING_IMPLAUSIBLE_STATE : u64 = 0xFFFFFE52

  // The decoders' contract for a dead or out-of-range row.
  pub let COOLING_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // `cooling_find_by_key`'s "no row holds this key". 0xFF rather than 0,
  // because row 0 is a legitimate answer.
  pub let COOLING_ROW_NONE : u64 = 0xFF

  // "No state has been reported yet." 0xFFFF is out of the 0..255
  // COOLING_STATE_UPPER domain, so a caller that echoes it cannot
  // confuse it with a legitimate speed table index.
  pub let COOLING_STATE_NONE : u64 = 0xFFFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // EIGHT ROWS, sized by COOLING DEVICES A MACHINE HAS. A T14 G4
  // declares CPU fan, GPU/skin fan (on dGPU SKUs), plus throttling
  // controllers on each package -- typically four to six, and eight
  // covers a two-fan workstation with two throttling zones.
  //
  // Sixty-four bytes per row so the index is a `shl 6`; paideia-as has
  // no `mul`.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot  cap_table slot of the parent
  //                                     KIND_DEVICE at mint; audit and
  //                                     query only
  //           bits [55:16] reserved, must be zero
  //           bits [63:56] in_use       allocator flag
  //   [+8]  cool_key    INHERITED from the parent descriptor's
  //                     target_ptr. Non-zero. The uniqueness key.
  //   [+16] index       0..COOLING_INDEX_MAX-1
  //   [+24] cooling_type 0..COOLING_TYPE_MAX
  //   [+32] state_min   the lower endpoint of the valid state range
  //   [+40] state_max   the upper endpoint, > state_min, <= COOLING_STATE_UPPER
  //   [+48] cur_state   last reported state, or COOLING_STATE_NONE
  //   [+56] state word
  //           bits [31:0]  reserved, must be zero
  //           bits [63:32] reports     lifetime install count
  //
  // `tools/build.sh` asserts by `objdump -r` that no object other than
  // `core/cap/kind_cooling_device.o` relocates against
  // `_cooling_device_table`. The table is the only place in the kernel
  // where a cooling state_max lives, and a second writer could raise
  // it with no capability involved and no refusal recorded.
  // ==========================================================================

  pub let COOLING_MAX       : u64 = 8
  pub let COOLING_ROW_BYTES : u64 = 64

  pub let mut _cooling_device_table : [u64; 64] = uninit @align(64)

  // Counters. Deliberately NOT in the row: they survive a revoke, so
  // "this actuator keeps returning nonsense" is evidence about a
  // controller and outlives any one capability over it.
  //
  //   +0  reports         reports that installed successfully
  //   +8  impl_state      reports refused for state out of [min, max]
  pub let mut _cooling_device_stats : [u64; 8] = uninit @align(64)

  pub let COOLING_ST_REPORTS    : u64 = 0
  pub let COOLING_ST_IMPL_STATE : u64 = 1
  pub let COOLING_ST_MAX        : u64 = 8

  // Local klog keys and tags.
  pub let cool_dbg_msg : [u8; 13] = "COOLING ROW\n\0"
  pub let cool_k_row   : [u8; 4]  = "row\0"
  pub let cool_k_idx   : [u8; 4]  = "idx\0"
  pub let cool_k_typ   : [u8; 5]  = "type\0"
  pub let cool_k_min   : [u8; 4]  = "min\0"
  pub let cool_k_max   : [u8; 4]  = "max\0"
  pub let cool_k_cur   : [u8; 4]  = "cur\0"

  // ==========================================================================
  // cooling_device_table_reset() -> ()
  // ==========================================================================

  pub let cooling_device_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring battery/thermal table_reset: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Bounded by immediate compares, 64 and 8 iterations. Leaf. Labels prefixed cool_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _cooling_device_table];
        xor rax, rax;
        xor rcx, rcx;
      cool_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  cool_rs_rows;

        lea r10, [rip + _cooling_device_stats];
        xor rcx, rcx;
      cool_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cool_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // cooling_type_valid(t) -> 1 | 0
  // ==========================================================================

  pub let cooling_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M4-001 (#1103): 1 iff t in [0, COOLING_TYPE_MAX]. §5's small closed set. A type outside the enumeration would not just render as a nonsense number in a debug dump; a future consumer that used type to select a control strategy would apply a table it never had. Refused rather than mapped to UNKNOWN because 'the firmware advertised something we do not understand' and 'the firmware advertised nothing' are different facts. Pure leaf. Labels prefixed cool_tv_ per reserved-label discipline.",
      block: {
        mov r10, 3;                      // COOLING_TYPE_MAX
        cmp rdi, r10;
        ja  cool_tv_no;
        mov rax, 1;
        ret;
      cool_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cooling_note(which) -> ()
  // cooling_stat(which) -> count
  // ==========================================================================

  pub let cooling_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): increment one counter; silent no-op on out-of-range. Same shape as battery_note / thermal_zone_note: every caller inside this module passes a constant, and the bound is here so the array cannot be walked past if that ever stops being true. Leaf. Labels prefixed cool_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // COOLING_ST_MAX
        jae cool_nt_out;
        lea r10, [rip + _cooling_device_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cool_nt_out:
        ret
      }
    }

  pub let cooling_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): bounds-checked read of one counter; out of range returns 0. This is what makes a lying actuator DIAGNOSABLE: a device whose reports are refused by §3's bounds looks, from every other vantage point, exactly like a device whose supervisor never sent a report. The impl_state counter is the only place the difference is visible. Leaf. Labels prefixed cool_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // COOLING_ST_MAX
        jae cool_st_zero;
        lea r10, [rip + _cooling_device_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cool_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cooling_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let cooling_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M4-001 (#1103): 1 iff (rights & R_COOLING_ALL) == rights. R_COOLING_ALL = 0x41B (READ|REPORT|INVOKE|REVOKE|OBSERVE). A subset test, and RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf of the lattice, and a MINT bit no gate reads is authority that later acquires a meaning nobody audited -- battery/thermal rights_valid's argument, applied one kind over. The subset shape (not equality) lets a monitor hold R_COOLING_READ alone while the policy server holds READ|REPORT. Pure leaf. Labels prefixed cool_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;                  // R_COOLING_ALL
        and rax, r10;
        cmp rax, rdi;
        jne cool_rv_no;
        mov rax, 1;
        ret;
      cool_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cooling_check_parent_device(parent_slot) -> 1 | 0
  //
  // §2. The first half of the derivation gate. Discriminates NOTHING
  // on its own; the second half is in cooling_cap_mint_inner.
  // ==========================================================================

  pub let cooling_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): the first half of the KIND_COOLING_DEVICE derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_DEVICE (10) AND (rights & RIGHT_MINT 0x200) != 0. THIS HALF DISCRIMINATES NOTHING and the mint does not treat it as though it did -- every PCI function in the machine is a KIND_DEVICE, which is #1075's lesson stated for the fifth time in this file family. 'This device is a cooling device' is a firmware-namespace fact this ring may not read (design/acpi/no-aml-in-kernel.md), so the second half is what the kernel CAN enforce (non-zero inherited key, one cooler per key, plausible index / type / range). Pure read. Labels prefixed cool_cpd_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae cool_cpd_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne cool_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  cool_cpd_no;

        mov rax, 1;
        ret;

      cool_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cooling_parent_key(parent_slot) -> cool_key | 0
  // ==========================================================================

  pub let cooling_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): read the parent KIND_DEVICE descriptor's target_ptr, which for a device capability is its identity key. THE ONLY SOURCE OF A COOLING CAPABILITY'S IDENTITY: the mint has no device argument, so the actuator whose static identity a row holds is the part its parent capability names and no other. A mint that took the key as an argument would let a holder attach one fan's range to a different fan -- and every report thereafter would be confidently wrong about which of the two devices the policy server's decision was acting on. Same shape as battery_parent_key / thermal_zone_parent_key. Returns 0 for a bad slot or a non-KIND_DEVICE descriptor, and cooling_cap_mint_inner refuses 0 with COOLING_MINT_NO_DEVICE. Pure read. Labels prefixed cool_pk_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae cool_pk_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne cool_pk_no;

        mov rax, [rax + 16];             // target_ptr = device identity key
        ret;

      cool_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cooling_hdr_pack(parent_slot) -> hdr | COOLING_DECODE_BAD
  // ==========================================================================

  pub let cooling_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M4-001 (#1103): canonical header-word encoder. Validates parent_slot < 256 then packs (parent_slot << 8), leaving bits [7:0], [55:16] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero, which is the whole reason the encoder exists rather than a shift at the call site: a header arriving with in_use pre-set hands back a row the free scan skips forever, and on this kind the leaked row holds a state_max, so the next legitimate mint of that cooler is refused COOL_IN_USE by a ghost that is still the only record of the actuator's range. Pure leaf. Labels prefixed cool_hp_ per reserved-label discipline.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae cool_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        ret;

      cool_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let cooling_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M4-001 (#1103): parent_slot from header bits [15:8]. Named accessor rather than a shift at each call site, so a future header field cannot silently change what a caller reads. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    }

  // ==========================================================================
  // cooling_tail_alloc(hdr, cool_key, index, cooling_type, state_min, state_max)
  //   -> row_id | COOLING_TAIL_*
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A COOLING STATE_MAX.
  // ==========================================================================

  pub let cooling_tail_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (cool_key: u64) (index: u64) (ctype: u64) (smin: u64) (smax: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A COOLING STATE_MAX, which is why tools/build.sh confines relocations against _cooling_device_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (the allocator's in_use flag, and a caller that pre-set it would be handed a row the free scan skips forever); hdr reserved bits [7:0] or [55:16] non-zero -> TAIL_BAD_ARG (a reserved bit merely ignored is one a later revision cannot use); cool_key == 0 -> TAIL_BAD_ARG (0 is cooling_parent_key's refusal value); index >= COOLING_INDEX_MAX -> TAIL_BAD_ARG; ctype > COOLING_TYPE_MAX -> TAIL_BAD_ARG; smax > COOLING_STATE_UPPER OR smax <= smin -> TAIL_BAD_ARG. THE RANGE CHECK IS HERE AS WELL AS IN THE MINT, deliberately: the mint's version produces the specific code an installer needs (MINT_BAD_RANGE), while this makes it impossible for ANY future second caller of the allocator to create a row without it. A row with state_max <= state_min would be a device whose only legal state is unreachable. Low-first scan over 8 rows of 64 bytes, free iff byte 7 of [row+0] is zero. Claim writes all eight words, so a reused row cannot inherit the previous cooler's cached state or report count. Seven pushes leave rsp%16 == 8 -- but this function is a leaf, so the 16-alignment invariant is only load-bearing at nested calls. Labels prefixed cool_ta_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // cool_key
        mov r14, rdx;                    // index
        mov r15, rcx;                    // ctype
        mov rbp, r8;                     // smin
        // smax stays in r9

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne cool_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne cool_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne cool_ta_bad;

        cmp r13, 0;
        je  cool_ta_bad;

        mov r10, 16;                     // COOLING_INDEX_MAX
        cmp r14, r10;
        jae cool_ta_bad;

        mov r10, 3;                      // COOLING_TYPE_MAX
        cmp r15, r10;
        ja  cool_ta_bad;

        mov r10, 255;                    // COOLING_STATE_UPPER
        cmp r9, r10;
        ja  cool_ta_bad;
        cmp r9, rbp;
        jbe cool_ta_bad;                 // smax <= smin refused

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      cool_ta_scan:
        cmp rbx, 8;                      // COOLING_MAX
        jae cool_ta_enospc;

        lea r10, [rip + _cooling_device_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cool_ta_claim;

        add rbx, 1;
        jmp cool_ta_scan;

      cool_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // cool_key
        mov [r10 + 16], r14;             // index
        mov [r10 + 24], r15;             // cooling_type
        mov [r10 + 32], rbp;             // state_min
        mov [r10 + 40], r9;              // state_max
        mov rax, 0xFFFF;                 // COOLING_STATE_NONE
        mov [r10 + 48], rax;             // cur_state
        xor rax, rax;
        mov [r10 + 56], rax;             // state word
        mov rax, rbx;
        jmp cool_ta_out;

      cool_ta_enospc:
        mov rax, 0xFFFFFE5F;             // COOLING_TAIL_ENOSPC
        jmp cool_ta_out;
      cool_ta_bad:
        mov rax, 0xFFFFFE5E;             // COOLING_TAIL_BAD_ARG

      cool_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cooling_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): 1 iff row_id < COOLING_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers COOLING_DECODE_BAD rather than the zeroes it was scrubbed to. On this kind that matters for state_max: a scrubbed row renders as a device with zero range, which every legitimate state ordinal is outside. Leaf. Labels prefixed cool_tv2_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // COOLING_MAX
        jae cool_tv2_no;
        lea r10, [rip + _cooling_device_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cool_tv2_no;
        mov rax, 1;
        ret;
      cool_tv2_no:
        xor rax, rax;
        ret
      }
    }

  pub let cooling_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): scrub one row to zero, which clears in_use and returns it to the free scan. ALL EIGHT WORDS, including the cached state and lifetime report count: a revoke is the point at which somebody has decided this cooling device's history no longer applies, and a row that kept its cached state across a re-mint would report an actuator as sitting at a speed on the strength of a report about a capability that no longer exists. Scrubbing the KEY is what makes the device re-mintable. No-op on an out-of-range row. Leaf. Labels prefixed cool_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // COOLING_MAX
        jae cool_tf_out;
        lea r10, [rip + _cooling_device_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      cool_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Every one returns COOLING_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let cooling_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): raw header word of a live row, or COOLING_DECODE_BAD. Labels prefixed cool_rh_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call cooling_tail_valid;
        cmp rax, 0;
        je  cool_rh_bad;
        lea r10, [rip + _cooling_device_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp cool_rh_out;
      cool_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      cool_rh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

