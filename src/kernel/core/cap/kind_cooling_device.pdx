  // ==========================================================================
  // cooling_report_install(slot, cur_state) -> COOLING_OK | ...
  //
  // §3. THE ONE PUSH-STATE PRIMITIVE. ONE VALUE, PLAUSIBILITY AGAINST
  //     THE ROW'S OWN RANGE.
  // ==========================================================================

  pub let cooling_report_install : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (cur_state: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): install one state report of the cooler this capability names. TWO ARGUMENTS AND NO MORE: a capability, and the one value §5's row layout has a dynamic field for. A third argument would be a caller-supplied state_max or index reaching the row, and both are set-once at mint by §1. Gates, in order: (1) the slot must name a live KIND_COOLING_DEVICE -> COOLING_BAD_SLOT / COOLING_WRONG_KIND via cooling_row_of_slot, reusing the checks every other path uses rather than restating them. (2) cur_state OUTSIDE [state_min, state_max] -> IMPLAUSIBLE_STATE, counted, AND NOTHING IN THE ROW IS TOUCHED. NOT CLAMPED: a state above state_max is refused and the top state is not silently substituted for it, because clamping would bless the garbage and hide the sensor bug. (3) install: write cur_state; increment the state-word report count in place and COOLING_ST_REPORTS overall. NOTHING ACTUATES: this is §4's design decision, stated once in the file header. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed cool_rpi_ (report-install) -- distinct from cooling_row_index's cool_ri_ (row-index): both abbreviate to \"ri\" and a shared prefix here previously aliased the two functions' cool_ri_out labels to one address, corrupting the stack on any call into cooling_row_index (issue #1610).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // cur_state

        call cooling_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;                   // COOLING_ROW_NONE
        je  cool_rpi_bad_slot;

        // Load state_min, state_max from the row for the range test.
        lea r10, [rip + _cooling_device_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov r13, [r10 + 32];             // state_min
        mov r14, [r10 + 40];             // state_max

        cmp r12, r13;
        jb  cool_rpi_impl_state;
        cmp r12, r14;
        ja  cool_rpi_impl_state;

        // Install.
        mov [r10 + 48], r12;             // cur_state

        // state word: reports in bits [63:32]; low 32 stay reserved-zero.
        mov rax, [r10 + 56];
        mov r11, rax;
        shr r11, 32;
        add r11, 1;
        mov r15, 0xFFFFFFFF;             // low-32 mask
        and rax, r15;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 56], rax;

        // Global counter.
        mov rdi, 0;                      // COOLING_ST_REPORTS
        call cooling_note;

      cool_rpi_ok:
        xor rax, rax;                    // COOLING_OK
        jmp cool_rpi_out;

      cool_rpi_bad_slot:
        mov rax, 0xFFFFFE55;
        jmp cool_rpi_out;
      cool_rpi_impl_state:
        mov rdi, 1;                      // COOLING_ST_IMPL_STATE
        call cooling_note;
        mov rax, 0xFFFFFE52;             // COOLING_IMPLAUSIBLE_STATE

      cool_rpi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cooling_cap_mint_inner(slot, parent_slot, rights, index, ctype, smin, smax)
  //
  // Seven arguments. Callers pass smax on the stack (SysV ABI beyond r9).
  //
  // We hoist the check to a wrapper that packs (smin, smax) into a single u64
  // to fit the SysV six-register limit. See cooling_cap_mint below.
  // ==========================================================================

  pub let cooling_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (ctype: u64) (range: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): mint a KIND_COOLING_DEVICE over a KIND_DEVICE. `range` packs state_min in bits [31:0] and state_max in bits [63:32] -- a compact encoding that stays within the SysV six-register limit and, more importantly, keeps the two endpoints indivisible on the control path (they arrive as one word and are unpacked once, so a caller cannot supply one without the other). Gates, in order: (1) slot < 256 -> COOLING_BAD_SLOT. (2) cooling_check_parent_device -> COOLING_MINT_BAD_PARENT (the half that discriminates NOTHING, §2). (3) cooling_rights_valid -> COOLING_MINT_BAD_RIGHTS. (4) index < COOLING_INDEX_MAX -> COOLING_MINT_BAD_INDEX. (5) ctype in enum -> COOLING_MINT_BAD_TYPE. (6) smax > COOLING_STATE_UPPER OR smax <= smin -> COOLING_MINT_BAD_RANGE. A degenerate range (smax == smin) is refused: it would name a device with exactly one legal state, which is a control surface with no expressible control. (7) INHERIT the identity: cooling_parent_key(parent_slot); 0 -> COOLING_MINT_NO_DEVICE. (8) UNIQUENESS: cooling_find_by_key must answer COOLING_ROW_NONE -> COOLING_MINT_COOL_IN_USE. Two capabilities over one fan means two policy servers writing one control surface. (9) hdr_pack(parent_slot) then tail_alloc -> COOLING_MINT_ENOSPC on exhaustion, and the allocator re-validates every one of these fields independently so that no future second caller can create a row without them. (10) cap_mint_write(slot, KIND_COOLING_DEVICE, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed cool_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // index
        mov r15, r8;                     // ctype
        mov rbp, r9;                     // range = smin | (smax << 32)

        mov r10, 256;
        cmp rbx, r10;
        jae cool_mi_bad_slot;

        mov rdi, r12;
        call cooling_check_parent_device;
        cmp rax, 0;
        je  cool_mi_bad_parent;

        mov rdi, r13;
        call cooling_rights_valid;
        cmp rax, 0;
        je  cool_mi_bad_rights;

        mov r10, 16;                     // COOLING_INDEX_MAX
        cmp r14, r10;
        jae cool_mi_bad_index;

        mov rdi, r15;
        call cooling_type_valid;
        cmp rax, 0;
        je  cool_mi_bad_type;

        // Unpack range.
        mov r10, rbp;
        mov r11, 0xFFFFFFFF;
        and r10, r11;                    // smin
        mov r11, rbp;
        shr r11, 32;                     // smax

        // smax bounds.
        mov rax, 255;                    // COOLING_STATE_UPPER
        cmp r11, rax;
        ja  cool_mi_bad_range;
        cmp r11, r10;
        jbe cool_mi_bad_range;           // smax <= smin

        // Stash the unpacked endpoints across nested calls.
        push r10;                        // smin
        push r11;                        // smax

        mov rdi, r12;
        call cooling_parent_key;
        cmp rax, 0;
        je  cool_mi_no_device_pop2;

        // Stash the key.
        mov r10, rax;
        push r10;
        sub rsp, 8;                      // keep rsp%16 == 0
        mov rdi, r10;
        call cooling_find_by_key;
        add rsp, 8;
        pop r10;                         // r10 = cool_key
        cmp rax, 0xFF;                   // COOLING_ROW_NONE
        jne cool_mi_in_use_pop2;

        // hdr_pack + tail_alloc.
        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call cooling_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  cool_mi_bad_parent_pop2;

        // Retrieve smin / smax from the earlier pushes.
        // Stack layout at this point: [rsp] = smax, [rsp+8] = smin
        // (Two pushes; no other pushes remain outstanding besides the six
        // callee-save prologue pushes below.)
        mov r9, [rsp + 0];               // smax
        mov r8, [rsp + 8];               // smin

        // Call tail_alloc(hdr=rax, cool_key=r10, index=r14, ctype=r15,
        //                 smin=r8, smax=r9).
        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // cool_key
        mov rdx, r14;                    // index
        mov rcx, r15;                    // ctype
        // r8 = smin (already)
        // r9 = smax (already)
        call cooling_tail_alloc;

        // Pop the two range slots.
        add rsp, 16;

        mov r10, 0xFFFFFE5F;             // COOLING_TAIL_ENOSPC
        cmp rax, r10;
        je  cool_mi_enospc;
        mov r10, 0xFFFFFE5E;             // COOLING_TAIL_BAD_ARG
        cmp rax, r10;
        je  cool_mi_bad_range;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x159;                  // KIND_COOLING_DEVICE
        mov rdx, r13;                    // rights
        mov rcx, r14;
        call cap_mint_write;

        xor rax, rax;                    // COOLING_OK
        jmp cool_mi_out;

      cool_mi_no_device_pop2:
        add rsp, 16;
        jmp cool_mi_no_device;
      cool_mi_in_use_pop2:
        add rsp, 16;
        jmp cool_mi_in_use;
      cool_mi_bad_parent_pop2:
        add rsp, 16;
        jmp cool_mi_bad_parent;

      cool_mi_bad_slot:
        mov rax, 0xFFFFFE55;
        jmp cool_mi_out;
      cool_mi_bad_parent:
        mov rax, 0xFFFFFE5D;
        jmp cool_mi_out;
      cool_mi_bad_rights:
        mov rax, 0xFFFFFE5C;
        jmp cool_mi_out;
      cool_mi_bad_index:
        mov rax, 0xFFFFFE5B;
        jmp cool_mi_out;
      cool_mi_bad_type:
        mov rax, 0xFFFFFE5A;
        jmp cool_mi_out;
      cool_mi_bad_range:
        mov rax, 0xFFFFFE59;
        jmp cool_mi_out;
      cool_mi_no_device:
        mov rax, 0xFFFFFE58;
        jmp cool_mi_out;
      cool_mi_enospc:
        mov rax, 0xFFFFFE57;
        jmp cool_mi_out;
      cool_mi_in_use:
        mov rax, 0xFFFFFE56;

      cool_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cooling_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (ctype: u64) (range: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): audited mint. Same shape as battery_cap_mint. Putting emission in the wrapper means a second mint path cannot exist without being audited (the discipline every derived kind since #1068 follows). `range` packs (state_min, state_max) as it does for the inner mint. The audit record carries SUBJECT slot and PRINCIPAL parent slot, so 'which device capability was used to claim this cooler' is answerable after the fact. Four pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call cooling_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x159;                  // KIND_COOLING_DEVICE
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cooling_cap_revoke_inner(slot) -> COOLING_OK | ...
  // ==========================================================================

  pub let cooling_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): revoke a KIND_COOLING_DEVICE. (1) slot < 256 -> COOLING_BAD_SLOT. (2) kind == 0 -> COOLING_REVOKE_ALREADY, idempotent and distinct so a caller can tell 'nothing to do' from 'done'. (3) kind != 0x159 -> COOLING_WRONG_KIND, which is what stops a cooler revoke from freeing another kind's row through a coincidentally-shaped target_ptr and is what makes it safe for the owner-column sweep to call this blindly. (4) row_id from target_ptr[15:0]; if live, cooling_tail_free scrubs it, which is what makes the device RE-MINTABLE. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0) rather than three raw stores, per #1579. NOTHING ACTUATES. Revoking authority over an actuator leaves the actuator exactly as it was; that is deliberate, for the same reason kind_thermal_zone's revoke does not act on a latch. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed cool_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae cool_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  cool_rvk_already;

        mov r11, 0x159;                  // KIND_COOLING_DEVICE
        cmp r10, r11;
        jne cool_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call cooling_tail_valid;
        cmp rax, 0;
        je  cool_rvk_clear;

        mov rdi, r13;
        call cooling_tail_free;

      cool_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // COOLING_OK
        jmp cool_rvk_out;

      cool_rvk_bad_slot:
        mov rax, 0xFFFFFE55;
        jmp cool_rvk_out;
      cool_rvk_wrong_kind:
        mov rax, 0xFFFFFE54;
        jmp cool_rvk_out;
      cool_rvk_already:
        mov rax, 0xFFFFFE53;

      cool_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let cooling_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS, so a process death leaves the same audit trail a deliberate teardown would. NO cascade: nothing in this tree derives from a cooling capability. Three pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call cooling_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x159;                  // KIND_COOLING_DEVICE
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cooling_debug_print(row_id) -> COOLING_OK | COOLING_TAIL_BAD_ARG
  // ==========================================================================

  pub let cooling_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R31.M4-001 (#1103): canonical printer for one cooling row. Refuses a dead or out-of-range row with COOLING_TAIL_BAD_ARG rather than printing zeroes: a freed row renders as {idx 0, type 0, min 0, max 0, cur 0}, which is a plausible-looking device with no expressible control -- the most misleading five values this module could emit. Six KV lines. r12 holds row_id across the calls; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed cool_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call cooling_tail_valid;
        cmp rax, 0;
        je  cool_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cool_dbg_msg];
        lea rcx, [rip + cool_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call cooling_row_index;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cool_dbg_msg];
        lea rcx, [rip + cool_k_idx];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call cooling_row_type;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cool_dbg_msg];
        lea rcx, [rip + cool_k_typ];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call cooling_row_min;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cool_dbg_msg];
        lea rcx, [rip + cool_k_min];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call cooling_row_max;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cool_dbg_msg];
        lea rcx, [rip + cool_k_max];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call cooling_row_state;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cool_dbg_msg];
        lea rcx, [rip + cool_k_cur];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // COOLING_OK
        jmp cool_dp_out;

      cool_dp_bad:
        mov rax, 0xFFFFFE5E;             // COOLING_TAIL_BAD_ARG

      cool_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_cooling_device(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_cooling_device : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): KIND_COOLING_DEVICE dispatch handler. Emits cap_cooling_msg on entry. row_id = target_ptr[15:0] and slot = target_ptr[31:16], both from the DESCRIPTOR (which only cap_mint_write writes); op = op_arg[7:0]. RIGHTS PER OP: QUERY_STATE requires R_COOLING_READ; QUERY_INDEX / QUERY_TYPE / QUERY_MIN / QUERY_MAX / QUERY_REPORTS / QUERY_PARENT require R_COOLING_INVOKE; DEBUG_PRINT requires R_COOLING_OBSERVE; REPORT requires R_COOLING_REPORT. THE OP THAT IS ABSENT is a state_max setter: nothing in this handler can raise or lower a static field, and R_COOLING_MINT is consequently a right this handler never reads. OPS 0..7 TAKE NO OPERAND. OP 8 (REPORT) takes one operand field packed per §COOLING_OP_REPORT (cur_state [23:8], reserved [63:24] MUST be zero -> COOLING_TAIL_BAD_ARG). Refused rather than masked, for the reason kind_battery ASSESS's reserved field is: forty free bits on an op that reaches the row's cached state is where a second value would be smuggled. Unknown op -> INVOKE_UNSUPPORTED; rights failure -> INVOKE_DENIED. Every query returns COOLING_DECODE_BAD for a dead row and never a plausible zero, because 0 is a legitimate index, a legitimate reports count and a legitimate type (UNKNOWN). r12=rights, r13=row_id, rbx=slot, r14=op, r15=cur_state, r10/r11 scratch; six pushes leave rsp%16 == 0 at every nested call. Labels prefixed cool_h_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot   = target_ptr[31:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_cooling_msg];
        call klog_s1;

        // Decode op and REPORT operand.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov rax, r14;
        shr rax, 8;
        mov r11, 0xFFFF;
        and rax, r11;                    // cur_state, 16 bits
        mov r15, rax;
        // Reserved field: op_arg[63:24].
        mov r11, r14;
        shr r11, 24;
        mov r14, r10;                    // r14 = op from here on
        // r15 = cur_state, r11 = reserved-hi

        cmp r14, 8;                      // COOLING_OP_MAX
        ja  cool_h_unsup;

        cmp r14, 8;                      // COOLING_OP_REPORT
        je  cool_h_report_gate;

        cmp r14, 7;                      // COOLING_OP_DEBUG_PRINT
        je  cool_h_dbg;

        // Ops 0..6: no operand.
        cmp r14, 4;                      // QUERY_STATE
        je  cool_h_read_gate;

        // QUERY_INDEX / QUERY_TYPE / QUERY_MIN / QUERY_MAX / QUERY_REPORTS /
        // QUERY_PARENT: INVOKE.
        mov r10, r12;
        and r10, 0x008;                  // R_COOLING_INVOKE
        cmp r10, 0;
        je  cool_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  cool_h_idx;
        cmp r14, 1;
        je  cool_h_typ;
        cmp r14, 2;
        je  cool_h_min;
        cmp r14, 3;
        je  cool_h_max;
        cmp r14, 5;
        je  cool_h_rep;
        call cooling_row_parent;
        jmp cool_h_out;

      cool_h_read_gate:
        mov r10, r12;
        and r10, 0x001;                  // R_COOLING_READ
        cmp r10, 0;
        je  cool_h_denied;

        mov rdi, r13;
        call cooling_row_state;
        jmp cool_h_out;

      cool_h_report_gate:
        // The reserved field is REFUSED, not masked.
        cmp r11, 0;
        jne cool_h_res;

        mov r10, r12;
        and r10, 0x002;                  // R_COOLING_REPORT
        cmp r10, 0;
        je  cool_h_denied;

        mov rdi, rbx;                    // slot
        mov rsi, r15;                    // cur_state
        call cooling_report_install;
        jmp cool_h_out;

      cool_h_idx:
        call cooling_row_index;
        jmp cool_h_out;
      cool_h_typ:
        call cooling_row_type;
        jmp cool_h_out;
      cool_h_min:
        call cooling_row_min;
        jmp cool_h_out;
      cool_h_max:
        call cooling_row_max;
        jmp cool_h_out;
      cool_h_rep:
        call cooling_row_reports;
        jmp cool_h_out;

      cool_h_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_COOLING_OBSERVE
        cmp r10, 0;
        je  cool_h_denied;
        mov rdi, r13;
        call cooling_debug_print;
        jmp cool_h_out;

      cool_h_res:
        mov rax, 0xFFFFFE5E;             // COOLING_TAIL_BAD_ARG
        jmp cool_h_out;
      cool_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp cool_h_out;
      cool_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      cool_h_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
