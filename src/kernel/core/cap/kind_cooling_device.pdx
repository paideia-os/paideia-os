  pub let cooling_type_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): cooling type ordinal, or COOLING_DECODE_BAD. ARITY ONE. Labels prefixed cool_tos_.",
      block: {
