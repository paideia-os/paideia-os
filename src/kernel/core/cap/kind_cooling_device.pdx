  // ==========================================================================
  // cooling_find_by_key(cool_key) -> row_id | COOLING_ROW_NONE
  // ==========================================================================

  pub let cooling_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (cool_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M4-001 (#1103): the live row holding this device key, or COOLING_ROW_NONE (0xFF). Linear scan over 8 rows. THE UNIQUENESS TEST §2's second gate needs: two live cooling capabilities over one fan means two servers with two independent state ordinals writing one control surface, and the one that writes last decides. Refuses to match a cool_key of 0 at all, so a fabricated parent cannot collide with, or be found by, the sentinel cooling_parent_key returns for a bad slot. Sentinel is 0xFF because row 0 is a legitimate answer. Leaf. Labels prefixed cool_fk_.",
      block: {
        cmp rdi, 0;
        je  cool_fk_none;
        xor rcx, rcx;
      cool_fk_scan:
        cmp rcx, 8;                      // COOLING_MAX
        jae cool_fk_none;
        lea r10, [rip + _cooling_device_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cool_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  cool_fk_hit;
      cool_fk_next:
        add rcx, 1;
        jmp cool_fk_scan;
      cool_fk_hit:
        mov rax, rcx;
        ret;
      cool_fk_none:
        mov rax, 0xFF;                   // COOLING_ROW_NONE
        ret
      }
    }

  // ==========================================================================
  // cooling_row_of_slot(slot) -> row_id | COOLING_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let cooling_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): slot -> row_id, gated on the descriptor being a live KIND_COOLING_DEVICE. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A COOLING ROW, and ARITY ONE so the row a caller reaches is the row its capability names. Every function below that touches a state_max or a cached state goes through it. Returns COOLING_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Pure read. Labels prefixed cool_ros_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae cool_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x159;                  // KIND_COOLING_DEVICE
        cmp r10, r11;
        jne cool_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call cooling_tail_valid;
        cmp rax, 0;
        je  cool_ros_none;

        mov rax, r12;
        jmp cool_ros_out;

      cool_ros_none:
        mov rax, 0xFF;                   // COOLING_ROW_NONE
      cool_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Slot-arity-one resolvers. ARITY ONE, pinned by tools/build.sh.
  // ==========================================================================

  pub let cooling_max_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): state_max of the cooling device this capability names. ARITY ONE, PINNED BY tools/build.sh. A second parameter -- any second parameter -- is how a caller-supplied ceiling would reach the row: `max_of_slot(slot, default_max)` reads as a convenience and is a way to widen a fan's advertised range; neither is expressible against a one-argument signature. Labels prefixed cool_mos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call cooling_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  cool_mos_bad;
        mov rdi, r12;
        call cooling_row_max;
        jmp cool_mos_out;
      cool_mos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      cool_mos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let cooling_state_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M4-001 (#1103): last reported state ordinal, or COOLING_DECODE_BAD. ARITY ONE for the same reason max_of_slot is: a state argument would let a caller assert a state rather than read one. Labels prefixed cool_sos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call cooling_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  cool_sos_bad;
