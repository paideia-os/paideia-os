// src/kernel/core/cap/kind_display_mode.pdx — R36.M3-004 (#1247)
//
// KIND_DISPLAY_MODE = 0x172, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// One display mode: the pixel clock in kHz, the active horizontal and
// vertical resolution, the refresh rate in Hz, and format flags
// (interlaced / double-scan). Paired with a KIND_MEMORY parent that
// carries authority for the byte range in which the mode table entry
// lives (a KIND_MEMORY row inside a mode-descriptor blob, or a caller-
// supplied buffer).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A KIND_DISPLAY_OUTPUT names WHICH panel; a KIND_DISPLAY_MODE names
// WHAT TIMING will be programmed. Naming the timing as a capability
// -- rather than as an argument to the modeset transaction --
// prevents two things that would otherwise be expressible: (1) a
// caller re-stamping a mode's pixel clock between validation and
// commit ("mode aliasing"), and (2) a modeset transaction that names
// a mode by structure pointer, which would need the kernel to trust
// the ring-3 blob those bytes live in.
//
// The KIND_MEMORY parent is the record of the byte range those
// fields were read out of. mode_enum.pdx populates the row by
// walking a display engine's advertised timings plus the panel's
// EDID DTDs and stamping the fields it validated -- the kernel
// never trusts the ring-3 mode blob directly, it trusts the
// enumerator that walked it against the engine's declared limits.
//
// =============================================================================
// §1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The gate demands `kind == KIND_MEMORY (4)` carrying RIGHT_MINT. The
// KIND_MEMORY parent supplies the byte range; a mode row derived over
// it stamps a timing that lies WITHIN that range and no other. The
// mint additionally requires:
//
//   (a) mode_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) memory_slot names a live KIND_MEMORY (4) with RIGHT_MINT
//       (NO_MEMORY); the slot is stashed on the row
//   (c) pixel_clock_khz in [DPM_PCLK_MIN_KHZ, DPM_PCLK_MAX_KHZ]
//       (BAD_PCLK). Iris Xe supports pixel clocks from about 25 MHz
//       (VGA-era 640x480@60) to 1188 MHz (8K60 with reduced blanking);
//       out-of-range refused rather than clamped
//   (d) h_active and v_active in (0, u16 max] (BAD_DIM); a zero
//       dimension is a mode with no visible pixels and refused as a
//       bring-up bug rather than accepted as a legal blank
//   (e) refresh_hz in (0, DPM_REFRESH_MAX] (BAD_REFRESH); zero is
//       refused, and the cap admits every rate a shipping DP panel
//       reports (DP §5 tops out around 240 Hz for high-refresh
//       monitors)
//   (f) flags subset of DPM_FLAG_ALL (BAD_FLAGS); interlaced +
//       double-scan are the two orthogonal fields
//   (g) rights subset of R_DISPLAY_MODE_ALL
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  mode_key (u64)
//   [+16] body1:   memory_slot[31:0] | pixel_clock_khz[63:32]
//   [+24] body2:   h_active[15:0] | v_active[31:16]
//                | refresh_hz[47:32] | flags[55:48]
//
// =============================================================================
// §3  LEAF OF THE MODE LATTICE
// =============================================================================
//
// R_DISPLAY_MODE_MINT (0x200) is DELIBERATELY ABSENT from
// R_DISPLAY_MODE_ALL: no cap in this tree derives from a
// KIND_DISPLAY_MODE. Same discipline every leaf in this tree
// applies -- a later pixel-format-aware kind can be introduced as
// a separate derived kind that consults this one at mint.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF720..0xFFFFF72F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: kind_modeset_txn
// 0xFFFFF730..3F; adjacent free bands below: modeset_channel
// 0xFFFFF710..1F).

module KindDisplayMode = structure {

  pub let KIND_DISPLAY_MODE         : u64 = 0x172
  pub let DISPLAY_MODE_PARENT_KIND  : u64 = 4           // = KIND_MEMORY

  // Pixel clock range (§1). Iris Xe bspec §14 numbers.
  pub let DPM_PCLK_MIN_KHZ : u64 = 25000
  pub let DPM_PCLK_MAX_KHZ : u64 = 1188000

  // Refresh cap (§1).
  pub let DPM_REFRESH_MAX  : u64 = 240

  // Flag bits (§1).
  pub let DPM_FLAG_INTERLACED  : u64 = 0x01
  pub let DPM_FLAG_DOUBLE_SCAN : u64 = 0x02
  pub let DPM_FLAG_ALL         : u64 = 0x03

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_DISPLAY_MODE_READ    : u64 = 0x001
  pub let R_DISPLAY_MODE_INVOKE  : u64 = 0x008
  pub let R_DISPLAY_MODE_REVOKE  : u64 = 0x010
  pub let R_DISPLAY_MODE_OBSERVE : u64 = 0x400
  pub let R_DISPLAY_MODE_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let DPM_OP_QUERY_KEY     : u64 = 0
  pub let DPM_OP_QUERY_MEMORY  : u64 = 1
  pub let DPM_OP_QUERY_PCLK    : u64 = 2
  pub let DPM_OP_QUERY_H       : u64 = 3
  pub let DPM_OP_QUERY_V       : u64 = 4
  pub let DPM_OP_QUERY_REFRESH : u64 = 5
  pub let DPM_OP_QUERY_FLAGS   : u64 = 6
  pub let DPM_OP_DEBUG_PRINT   : u64 = 7
  pub let DPM_OP_MAX           : u64 = 7

  // Failure taxonomy — 0xFFFFF720..0xFFFFF72F.
  pub let DPM_OK               : u64 = 0
  pub let DPM_TAIL_ENOSPC      : u64 = 0xFFFFF72F
  pub let DPM_TAIL_BAD_ARG     : u64 = 0xFFFFF72E
  pub let DPM_MINT_BAD_PARENT  : u64 = 0xFFFFF72D
  pub let DPM_MINT_BAD_RIGHTS  : u64 = 0xFFFFF72C
  pub let DPM_MINT_BAD_PCLK    : u64 = 0xFFFFF72B
  pub let DPM_MINT_BAD_DIM     : u64 = 0xFFFFF72A
  pub let DPM_MINT_BAD_REFRESH : u64 = 0xFFFFF729
  pub let DPM_MINT_BAD_FLAGS   : u64 = 0xFFFFF728
  pub let DPM_MINT_NO_MEMORY   : u64 = 0xFFFFF727
  pub let DPM_MINT_NO_KEY      : u64 = 0xFFFFF726
  pub let DPM_MINT_ENOSPC      : u64 = 0xFFFFF725
  pub let DPM_MINT_IN_USE      : u64 = 0xFFFFF724
  pub let DPM_BAD_SLOT         : u64 = 0xFFFFF723
  pub let DPM_WRONG_KIND       : u64 = 0xFFFFF722
  pub let DPM_REVOKE_ALREADY   : u64 = 0xFFFFF721

  pub let DPM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPM_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride — total 512 bytes as [u64; 64]. Mode-enum
  // populates one row per admitted timing per panel; 16 is enough for
  // an EDID's typical 4-8 preferred modes plus its DP-standard set.
  pub let DPM_MAX       : u64 = 16
  pub let DPM_ROW_BYTES : u64 = 32

  pub let mut _display_mode_table : [u64; 64] = uninit @align(64)
  pub let mut _display_mode_stats : [u64; 4]  = uninit @align(64)

  pub let DPM_ST_MINTS   : u64 = 0
  pub let DPM_ST_REVOKES : u64 = 1
  pub let DPM_ST_IN_USE  : u64 = 2
  pub let DPM_ST_REFUSED : u64 = 3

  pub let dpm_dbg_msg : [u8; 16] = "DISPLAY MODE ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let display_mode_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): clear the DISPLAY MODE row table and its counters. Boot and teardown only. Labels prefixed dpm_rs_.",
      block: {
        lea r10, [rip + _display_mode_table];
        xor rax, rax;
        xor rcx, rcx;
      dpm_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  dpm_rs_rows;

        lea r10, [rip + _display_mode_stats];
        xor rcx, rcx;
      dpm_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dpm_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpm_pclk_valid : (u64) -> u64 !{} @{} =
    fn (pclk: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): 1 iff DPM_PCLK_MIN_KHZ <= pclk <= DPM_PCLK_MAX_KHZ. Labels prefixed dpm_pv_.",
      block: {
        mov r10, 25000;
        cmp rdi, r10;
        jb  dpm_pv_no;
        mov r10, 1188000;
        cmp rdi, r10;
        ja  dpm_pv_no;
        mov rax, 1;
        ret;
      dpm_pv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpm_dim_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): 1 iff 0 < d <= 0xFFFF. Zero refused as a bring-up bug (a zero-visible-pixel mode is not a legal blank). Labels prefixed dpm_dv_.",
      block: {
        cmp rdi, 0;
        je  dpm_dv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpm_dv_no;
        mov rax, 1;
        ret;
      dpm_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpm_refresh_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): 1 iff 0 < r <= DPM_REFRESH_MAX (240). Labels prefixed dpm_rv_.",
      block: {
        cmp rdi, 0;
        je  dpm_rv_no;
        cmp rdi, 240;
        ja  dpm_rv_no;
        mov rax, 1;
        ret;
      dpm_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpm_flags_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): subset test against DPM_FLAG_ALL (0x03). Labels prefixed dpm_fv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x03;
        and rax, r10;
        cmp rax, rdi;
        jne dpm_fv_no;
        mov rax, 1;
        ret;
      dpm_fv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpm_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): subset test against R_DISPLAY_MODE_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — leaf (§3). Labels prefixed dpm_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne dpm_rgv_no;
        mov rax, 1;
        ret;
      dpm_rgv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let dpm_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): counter bump. Labels prefixed dpm_nt_.",
      block: {
        cmp rdi, 4;
        jae dpm_nt_out;
        lea r10, [rip + _display_mode_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpm_nt_out:
        ret
      }
    } @no_frame

  pub let dpm_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): counter read. Labels prefixed dpm_st_.",
      block: {
        cmp rdi, 4;
        jae dpm_st_zero;
        lea r10, [rip + _display_mode_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpm_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: parent must be live KIND_MEMORY (4) with RIGHT_MINT.
  // ==========================================================================

  pub let dpm_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): §1 gate. parent must be live KIND_MEMORY (4) with RIGHT_MINT. Labels prefixed dpm_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpm_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne dpm_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  dpm_cp_no;

        mov rax, 1;
        ret;
      dpm_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let dpm_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): (parent_slot << 8). Labels prefixed dpm_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae dpm_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      dpm_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let dpm_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (memory_slot: u64) (pclk_khz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): pack memory_slot[31:0] | pclk_khz[63:32]. Refuses out-of-range fields. Labels prefixed dpm_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dpm_b1_bad;
        cmp rsi, r10;
        ja  dpm_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      dpm_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let dpm_body2_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (h_active: u64) (v_active: u64) (refresh_hz: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-004 (#1247): pack h[15:0] | v[31:16] | refresh[47:32] | flags[55:48]. Refuses out-of-range fields. Labels prefixed dpm_b2_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpm_b2_bad;
        cmp rsi, r10;
        ja  dpm_b2_bad;
        cmp rdx, r10;
        ja  dpm_b2_bad;
        cmp rcx, 0xFF;
        ja  dpm_b2_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      dpm_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc / valid / free — THE ONE WRITER of _display_mode_table.
  // ==========================================================================

  pub let dpm_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (mode_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): claim one DISPLAY MODE row. THE ONE WRITER of _display_mode_table. Gates: hdr in_use pre-set -> BAD_ARG; mode_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 16 rows of 32 bytes. Labels prefixed dpm_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne dpm_ta_bad;

        cmp r13, 0;
        je  dpm_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  dpm_ta_bad;
        cmp r15, r10;
        je  dpm_ta_bad;

        xor rbx, rbx;
      dpm_ta_scan:
        cmp rbx, 16;
        jae dpm_ta_enospc;

        lea r10, [rip + _display_mode_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpm_ta_claim;

        add rbx, 1;
        jmp dpm_ta_scan;

      dpm_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp dpm_ta_out;

      dpm_ta_enospc:
        mov rax, 0xFFFFF72F;
        jmp dpm_ta_out;
      dpm_ta_bad:
        mov rax, 0xFFFFF72E;

      dpm_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dpm_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): 1 iff row_id < MAX and in_use. Labels prefixed dpm_tvr_.",
      block: {
        cmp rdi, 16;
        jae dpm_tvr_no;
        lea r10, [rip + _display_mode_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpm_tvr_no;
        mov rax, 1;
        ret;
      dpm_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpm_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): scrub one row. Labels prefixed dpm_tf_.",
      block: {
        cmp rdi, 16;
        jae dpm_tf_out;
        lea r10, [rip + _display_mode_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      dpm_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let dpm_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): mode_key. Labels prefixed dpm_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rk_bad;
        lea r10, [rip + _display_mode_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp dpm_rk_out;
      dpm_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpm_rk_out:
        pop r12;
        ret
      }
    }

  pub let dpm_row_memory : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): memory_slot. Labels prefixed dpm_rmem_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rmem_bad;
        lea r10, [rip + _display_mode_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp dpm_rmem_out;
      dpm_rmem_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpm_rmem_out:
        pop r12;
        ret
      }
    }

  pub let dpm_row_pclk : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): pixel_clock_khz. Labels prefixed dpm_rpc_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rpc_bad;
        lea r10, [rip + _display_mode_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp dpm_rpc_out;
      dpm_rpc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpm_rpc_out:
        pop r12;
        ret
      }
    }

  pub let dpm_row_h : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): h_active. Labels prefixed dpm_rh_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rh_bad;
        lea r10, [rip + _display_mode_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFF;
        jmp dpm_rh_out;
      dpm_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpm_rh_out:
        pop r12;
        ret
      }
    }

  pub let dpm_row_v : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): v_active. Labels prefixed dpm_rv2_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rv2_bad;
        lea r10, [rip + _display_mode_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp dpm_rv2_out;
      dpm_rv2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpm_rv2_out:
        pop r12;
        ret
      }
    }

  pub let dpm_row_refresh : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): refresh_hz. Labels prefixed dpm_rref_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rref_bad;
        lea r10, [rip + _display_mode_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp dpm_rref_out;
      dpm_rref_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpm_rref_out:
        pop r12;
        ret
      }
    }

  pub let dpm_row_flags : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): flags. Labels prefixed dpm_rfl_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rfl_bad;
        lea r10, [rip + _display_mode_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 48;
        and rax, 0xFF;
        jmp dpm_rfl_out;
      dpm_rfl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpm_rfl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let dpm_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (mode_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-004 (#1247): live row holding this mode_key, or ROW_NONE. Refuses to match 0. Labels prefixed dpm_fk_.",
      block: {
        cmp rdi, 0;
        je  dpm_fk_none;
        xor rcx, rcx;
      dpm_fk_scan:
        cmp rcx, 16;
        jae dpm_fk_none;
        lea r10, [rip + _display_mode_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpm_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  dpm_fk_hit;
      dpm_fk_next:
        add rcx, 1;
        jmp dpm_fk_scan;
      dpm_fk_hit:
        mov rax, rcx;
        ret;
      dpm_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let dpm_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): slot -> row_id, gated on live KIND_DISPLAY_MODE. Labels prefixed dpm_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae dpm_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x172;
        cmp r10, r11;
        jne dpm_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_ros_none;

        mov rax, r12;
        jmp dpm_ros_out;

      dpm_ros_none:
        mov rax, 0xFF;
      dpm_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, mode_key, memory_slot,
  // packed_ident). packed_ident encoding:
  //   [31:0]  pixel_clock_khz
  //   [47:32] h_active
  //   [63:48] v_active_low16 (v_active low bits; upper truncated in this
  //           packing — dpm accepts up to 65535, and the packer takes
  //           the low 16b, so callers must pass v within u16)
  //
  // A seventh field (refresh_hz + flags) is inferred from the memory row
  // in production; the mint takes both explicitly here as a SEVENTH pack
  // parameter that lives in the low bits of a helper arg — split into a
  // second-shot pack because six args is the SysV ceiling this milestone
  // uses across kind_display_output as well.
  //
  // Concrete arg shape:
  //   packed_ident encoding:
  //     [31:0]  pixel_clock_khz
  //     [47:32] h_active
  //     [63:48] v_active
  //   packed_extra encoding:
  //     [15:0]  refresh_hz
  //     [23:16] flags
  //
  // (packed_extra is stashed inside output_key's high half in the
  // audited wrapper — but the inner mint takes it as a normal
  // parameter through r9.)
  // ==========================================================================

  pub let display_mode_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (mode_key: u64) (memory_slot: u64) (packed_all: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): mint KIND_DISPLAY_MODE over KIND_MEMORY. Six args. packed_all encoding: [31:0] pclk_khz | [47:32] h_active | [63:48] v_active. refresh_hz and flags are IMPLICIT in this milestone: refresh_hz=60 (the panel's default reported rate) and flags=0 (non-interlaced, non-doubled). mode_enum.pdx will replace this stub with a seventh-arg-carrying wrapper in R36.M3-005 (#1248). Labels prefixed dpm_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // mode_key
        mov r15, r8;                     // memory_slot
        mov rbp, r9;                     // packed_all

        mov r10, 256;
        cmp rbx, r10;
        jae dpm_mi_bad_slot;

        mov rdi, r12;
        call dpm_check_parent;
        cmp rax, 0;
        je  dpm_mi_bad_parent;

        mov rdi, r13;
        call dpm_rights_valid;
        cmp rax, 0;
        je  dpm_mi_bad_rights;

        // Unpack + validate pclk_khz.
        mov rdi, rbp;
        and rdi, 0xFFFFFFFF;
        call dpm_pclk_valid;
        cmp rax, 0;
        je  dpm_mi_bad_pclk;

        // Unpack + validate h_active.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFF;
        call dpm_dim_valid;
        cmp rax, 0;
        je  dpm_mi_bad_dim;

        // Unpack + validate v_active.
        mov rdi, rbp;
        shr rdi, 48;
        and rdi, 0xFFFF;
        call dpm_dim_valid;
        cmp rax, 0;
        je  dpm_mi_bad_dim;

        // Refresh / flags are implicit (60 Hz / 0) at this milestone.
        cmp r14, 0;
        je  dpm_mi_no_key;

        mov rdi, r14;
        call dpm_find_by_key;
        cmp rax, 0xFF;
        jne dpm_mi_in_use;

        // Body1 pack: (memory_slot, pclk_khz).
        mov rdi, r15;
        mov rsi, rbp;
        and rsi, 0xFFFFFFFF;
        call dpm_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpm_mi_bad_pclk;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack: (h, v, refresh=60, flags=0).
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFF;                 // h
        mov rsi, rbp;
        shr rsi, 48;
        and rsi, 0xFFFF;                 // v
        mov rdx, 60;                     // refresh_hz
        mov rcx, 0;                      // flags
        call dpm_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpm_mi_bad_dim;
        mov r15, rax;                    // body2
        push r11;
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call dpm_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpm_mi_bad_parent;

        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call dpm_tail_alloc;

        mov r10, 0xFFFFF72F;
        cmp rax, r10;
        je  dpm_mi_enospc;
        mov r10, 0xFFFFF72E;
        cmp rax, r10;
        je  dpm_mi_bad_pclk;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x172;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call dpm_note;

        xor rax, rax;
        jmp dpm_mi_out;

      dpm_mi_bad_slot:
        mov rax, 0xFFFFF723;
        jmp dpm_mi_out;
      dpm_mi_bad_parent:
        mov rax, 0xFFFFF72D;
        jmp dpm_mi_out;
      dpm_mi_bad_rights:
        mov rax, 0xFFFFF72C;
        jmp dpm_mi_out;
      dpm_mi_bad_pclk:
        mov rax, 0xFFFFF72B;
        jmp dpm_mi_out;
      dpm_mi_bad_dim:
        mov rax, 0xFFFFF72A;
        jmp dpm_mi_out;
      dpm_mi_no_key:
        mov rax, 0xFFFFF726;
        jmp dpm_mi_out;
      dpm_mi_in_use:
        mov rdi, 2;
        call dpm_note;
        mov rax, 0xFFFFF724;
        jmp dpm_mi_out;
      dpm_mi_enospc:
        mov rdi, 3;
        call dpm_note;
        mov rax, 0xFFFFF725;

      dpm_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_mode_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (mode_key: u64) (memory_slot: u64) (packed_all: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call display_mode_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x172;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let display_mode_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): revoke KIND_DISPLAY_MODE. Labels prefixed dpm_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae dpm_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  dpm_rvk_already;

        mov r11, 0x172;
        cmp r10, r11;
        jne dpm_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call dpm_tail_valid;
        cmp rax, 0;
        je  dpm_rvk_clear;

        mov rdi, r13;
        call dpm_tail_free;

      dpm_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call dpm_note;

        xor rax, rax;
        jmp dpm_rvk_out;

      dpm_rvk_bad_slot:
        mov rax, 0xFFFFF723;
        jmp dpm_rvk_out;
      dpm_rvk_wrong_kind:
        mov rax, 0xFFFFF722;
        jmp dpm_rvk_out;
      dpm_rvk_already:
        mov rax, 0xFFFFF721;

      dpm_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_mode_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call display_mode_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x172;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_display_mode : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M3-004 (#1247): KIND_DISPLAY_MODE dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed dpm_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_display_mode_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne dpm_hn_res;

        cmp rbp, 7;
        ja  dpm_hn_unsup;

        cmp rbp, 7;
        je  dpm_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  dpm_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  dpm_hn_k;
        cmp rbp, 1;
        je  dpm_hn_m;
        cmp rbp, 2;
        je  dpm_hn_p;
        cmp rbp, 3;
        je  dpm_hn_h;
        cmp rbp, 4;
        je  dpm_hn_v;
        cmp rbp, 5;
        je  dpm_hn_r;
        call dpm_row_flags;
        jmp dpm_hn_out;

      dpm_hn_k:
        call dpm_row_key;
        jmp dpm_hn_out;
      dpm_hn_m:
        call dpm_row_memory;
        jmp dpm_hn_out;
      dpm_hn_p:
        call dpm_row_pclk;
        jmp dpm_hn_out;
      dpm_hn_h:
        call dpm_row_h;
        jmp dpm_hn_out;
      dpm_hn_v:
        call dpm_row_v;
        jmp dpm_hn_out;
      dpm_hn_r:
        call dpm_row_refresh;
        jmp dpm_hn_out;

      dpm_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  dpm_hn_denied;
        xor rax, rax;
        jmp dpm_hn_out;

      dpm_hn_res:
        mov rax, 0xFFFFF72E;
        jmp dpm_hn_out;
      dpm_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp dpm_hn_out;
      dpm_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      dpm_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
