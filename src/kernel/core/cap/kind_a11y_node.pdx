// src/kernel/core/cap/kind_a11y_node.pdx — COMP-IMPL-09 (Wave UUU)
//
// KIND_A11Y_NODE = 0x1E6. A KERNEL-NATIVE capability naming one
// accessibility-tree node: (parent_node_id, role, label_ptr, label_len).
//
// =============================================================================
// §0  WHY A SECOND, DISTINCT KIND_A11Y_NODE
// =============================================================================
//
// src/user/a11y/kind_a11y_node.pdx already declares a KIND_A11Y_NODE
// ordinal (0x1E2) — but that file is a USERSPACE, compositor-internal
// schema-only landing (Wave0-B14 G10-M1-002, #2303): its own header says
// plainly that "the row-pool substrate that would actually allocate,
// link and free a row DOES NOT EXIST YET" and every op function is a
// stub that returns NODE_NOT_INIT. It models a rich AccessKit-style
// node (role/state/value/edges) living entirely inside the compositor
// process's own memory — never a cap_table row, never reachable through
// sys_cap_invoke.
//
// This landing's row prompt asks for something narrower and REAL: "Add
// a dispatch arm to sys_cap_invoke: mint an a11y node cap tied to
// (parent_node_id, role, label_ptr, label_len). Return cap id." That is
// a kernel-native capability — a cap_table row, reachable through the
// same cap_invoke_dispatch every other KIND_* in this file goes through
// — which is a different citizen than the userspace PWP schema. Rather
// than retrofit 0x1E2's stub bodies (out of THIS landing's scope — see
// that file's own "LANDING SCOPE" section for the substrate work it
// explicitly deferred, which is a much larger lift: role/state/value
// packing, attach/detach linearity, tree-mutation ops) this file mints
// a SEPARATE, minimal kernel ordinal that satisfies the row prompt's
// exact signature. The two are NOT meant to merge silently: a future
// reconciliation note belongs in design/a11y/kind-a11y-node.md (landed
// alongside this file) so main can decide whether the PWP-layer schema
// eventually derives over this kernel cap, wraps it, or stays parallel.
//
// Ordinal 0x1E6 chosen because a full-repo grep for every `pub let ... :
// u64 = 0x1XX` declaration at landing time shows the highest claimed
// value in that page is 0x1E5 (src/samples/editor/buffer.pdx,
// KIND_EDITOR_BUFFER); 0x1E6 and above are unclaimed.
//
// =============================================================================
// §1  NO PARENT-CAP DERIVATION — SAME-KIND NODE_ID REFERENCE INSTEAD
// =============================================================================
//
// Every other derived kind in cap/invoke.pdx's dispatch chain gates its
// mint on a PARENT CAP_TABLE SLOT of some other kind (KIND_MEMORY,
// KIND_IPC_ENDPOINT, KIND_DEVICE, ...). KIND_A11Y_NODE does not: its
// `parent_node_id` argument names another LIVE KIND_A11Y_NODE row by
// its kernel-assigned node_id, exactly the same way the userspace PWP
// schema's own (deferred) substrate was going to link nodes into a
// tree (that file's §Section 1: "the future mint gate ... checks: parent
// tree_ref names a live KIND_A11Y_TREE row"). parent_node_id ==
// NODE_ID_NONE (0) mints a root node; a nonzero value must resolve via
// anode_find_by_id to a row that is actually in_use, or the mint is
// refused with ANODE_MINT_BAD_PARENT. This is intentionally a same-kind
// self-reference rather than a second cap-table argument, because the
// row prompt's signature carries exactly four fields and none of them
// is a cap slot.
//
// =============================================================================
// §2  LABEL_PTR / LABEL_LEN ARE OPAQUE, NEVER DEREFERENCED HERE
// =============================================================================
//
// The mint gate validates label_len <= ANODE_LABEL_MAX (256) and
// requires label_ptr != 0 whenever label_len > 0 (a nonzero claimed
// length naming a null pointer is refused as ANODE_MINT_BAD_LABEL) —
// but it does NOT walk label_ptr, copy its bytes, or verify it resolves
// to readable memory. Doing so would require a user_ptr_ok + walker
// copy-in, which needs a dispatch-layer KPTI bounce this substrate-only
// landing does not add (no new syscall is requested by this row prompt
// — see §4). label_ptr is stored as a caller-space identity field, the
// same posture kind_gpio_line.pdx takes toward pin/community indices
// and kind_bt_pairing.pdx takes toward its sealed key material: the
// kernel records the value it was given and trusts the caller (today,
// the compositor's a11y substrate, running with the same privilege as
// the kernel's own driver-process model) to keep the bytes at that
// address valid for as long as the node cap lives. A future landing
// that wants the kernel to own a copy of the label text adds a
// dedicated copy-in op (QUERY_LABEL_COPY or similar) with its own
// user_ptr_ok + walker gate; this file's row layout is unaffected by
// that addition (label_ptr/label_len stay exactly as stored).
//
// =============================================================================
// §3  ROW LAYOUT — 48 BYTES
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | role[15:0]
//   [+8]  node_id:         u64 — kernel-assigned monotonic identity;
//                                0 = NODE_ID_NONE (never a live id)
//   [+16] parent_node_id:  u64 — NODE_ID_NONE(0) at a root node
//   [+24] label_ptr:       u64 — opaque caller-space pointer (§2)
//   [+32] label_len:       u64 — byte length named by label_ptr (§2)
//   [+40] reserved0:       u64 — pads the row to 48 bytes (6 * u64)
//
// =============================================================================
// §4  MINT IS NOT REACHED THROUGH THE 2-ARG cap_invoke(slot, op_arg) ABI
// =============================================================================
//
// a11y_node_cap_mint takes four independent u64-shaped arguments
// (parent_node_id, role, label_ptr, label_len) — label_ptr alone can be
// a full 64-bit value, so unlike call_kind_surface's MINT arm (which
// packs w/h/format into the spare bits of one op_arg word) there is no
// bit-packing scheme that fits all four fields into cap_invoke's single
// op_arg register. This mint is therefore a direct kernel function —
// the SAME posture display_mode_cap_mint / sensor_channel_cap_mint /
// gpio_line's own audited mint entries already take: real substrate,
// callable today, awaiting a future syscall (a sys_a11y_node_mint akin
// to sys_volume_mint.pdx's shape) that marshals ring-3 arguments into
// this exact signature. THIS landing's "dispatch arm to sys_cap_invoke"
// deliverable is the QUERY-only cap_handler_a11y_node wired into
// cap_invoke_dispatch below — the surface a caller uses AFTER minting,
// exactly mirroring how KIND_SURFACE's and KIND_SEAT's own dispatch
// arms (COMP-IMPL-02/03/04, immediately above this file's own arm in
// invoke.pdx) each pair a pre-existing mint substrate with a fresh
// cap_invoke QUERY/op dispatcher.
//
// =============================================================================
// §5  ROLE VALIDATION
// =============================================================================
//
// The kernel does not own role semantics — the PWP-layer schema
// (src/user/a11y/kind_a11y_node.pdx §B.1) is the catalogue of named
// roles (BUTTON, LINK, TEXTBOX, ...). This file only needs a numeric
// ceiling so a garbage role value cannot corrupt the packed header
// word; ANODE_ROLE_MAX (39) is duplicated from that file's own
// ROLE_MAX so the two stay numerically aligned without a cross-module
// reference (paideia-as does not resolve another module's `let` at
// parse time — see sys_kill.pdx's own TASK_STATE_* duplicates for the
// precedent this file follows).
//
// =============================================================================
// §6  FAILURE TAXONOMY  0xFFFFEA00..0xFFFFEA0F
// =============================================================================
//
// Grep-verified free at landing time: three independent prior landings
// (compositor/clipboard.pdx, compositor/subsurface_sync.pdx,
// compositor/dnd_offer.pdx, libpaideia_ui/view_tree.pdx) each note this
// exact page (0xFFFFEA00..) as open and reserved-for-a-future-sibling.
// Eight codes below; 0xFFFFEA08..0xFFFFEA0F (8 slots) stay free.

module KindA11yNode = structure {

  pub let KIND_A11Y_NODE : u64 = 0x1E6

  // ==========================================================================
  // Rights. No R_A11Y_NODE_MINT bit — mint is a direct kernel call (§4),
  // not an op reachable through cap_invoke on an existing cap.
  // ==========================================================================

  pub let R_A11Y_NODE_READ    : u64 = 0x001
  pub let R_A11Y_NODE_INVOKE  : u64 = 0x008
  pub let R_A11Y_NODE_REVOKE  : u64 = 0x010
  pub let R_A11Y_NODE_OBSERVE : u64 = 0x400
  pub let R_A11Y_NODE_ALL     : u64 = 0x419

  // Client-visible right-set at mint time: READ | INVOKE | REVOKE.
  // OBSERVE is a compositor-only debug path, mirroring the CLIENT
  // carve-out convention every other kind in this directory uses.
  pub let R_A11Y_NODE_CLIENT  : u64 = 0x019

  // Role ceiling (§5). Duplicated from src/user/a11y/kind_a11y_node.pdx
  // ROLE_MAX.
  pub let ANODE_ROLE_MAX : u64 = 39

  // Opaque label length ceiling (§2). Generous enough for any single
  // accessible name/description a toolkit would realistically stamp on
  // one node without truncation reading as "and there's more".
  pub let ANODE_LABEL_MAX : u64 = 256

  // Reference sentinel — 0 means "no such node" for node_id /
  // parent_node_id alike. Mirrors NODE_ID_NONE in the sibling userspace
  // schema and kind_tui_canvas.pdx's tui_next_canvas_id convention: the
  // node_id counter below is pre-incremented so the first live id is 1.
  pub let ANODE_ID_NONE : u64 = 0

  // Ops. Every op is arity ONE (row_id in target_ptr; op_arg carries
  // only the op ordinal in its low byte, bits [63:8] REFUSED — mirrors
  // kind_display_mode.pdx's DPM_OP_* discipline).
  pub let ANODE_OP_QUERY_PARENT     : u64 = 0
  pub let ANODE_OP_QUERY_ROLE       : u64 = 1
  pub let ANODE_OP_QUERY_LABEL_PTR  : u64 = 2
  pub let ANODE_OP_QUERY_LABEL_LEN  : u64 = 3
  pub let ANODE_OP_DEBUG_PRINT      : u64 = 4
  pub let ANODE_OP_MAX              : u64 = 4

  // Failure taxonomy — 0xFFFFEA00..0xFFFFEA0F (§6).
  pub let ANODE_OK               : u64 = 0
  pub let ANODE_TAIL_ENOSPC      : u64 = 0xFFFFEA07
  pub let ANODE_TAIL_BAD_ARG     : u64 = 0xFFFFEA06
  pub let ANODE_MINT_BAD_ROLE    : u64 = 0xFFFFEA05
  pub let ANODE_MINT_BAD_LABEL   : u64 = 0xFFFFEA04
  pub let ANODE_MINT_BAD_PARENT  : u64 = 0xFFFFEA03
  pub let ANODE_MINT_ENOSPC_ROW  : u64 = 0xFFFFEA02
  pub let ANODE_MINT_ENOSPC_SLOT : u64 = 0xFFFFEA01
  pub let ANODE_BAD_SLOT         : u64 = 0xFFFFEA00

  pub let ANODE_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let ANODE_ROW_NONE   : u64 = 0xFF

  // 64 rows, 48-byte stride — total 3072 bytes as [u64; 384].
  pub let ANODE_MAX       : u64 = 64
  pub let ANODE_ROW_BYTES : u64 = 48

  pub let mut _a11y_node_table   : [u64; 384] = uninit @align(64)
  pub let mut _a11y_node_next_id : u64        = uninit
  pub let mut _a11y_node_stats   : [u64; 4]   = uninit @align(64)

  pub let ANODE_ST_MINTS   : u64 = 0
  pub let ANODE_ST_REVOKES : u64 = 1
  pub let ANODE_ST_IN_USE  : u64 = 2
  pub let ANODE_ST_REFUSED : u64 = 3

  pub let cap_a11y_node_msg : [u8; 14] = "A11Y NODE ROW\0"

  // ==========================================================================
  // Table reset. Boot only.
  // ==========================================================================

  pub let a11y_node_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): clear the A11Y NODE row table, the node_id counter, and its counters. Boot and teardown only. Labels prefixed anode_rs_.",
      block: {
        lea r10, [rip + _a11y_node_table];
        xor rax, rax;
        xor rcx, rcx;
      anode_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 384;
        jb  anode_rs_rows;

        lea r10, [rip + _a11y_node_next_id];
        mov [r10 + 0], rax;

        lea r10, [rip + _a11y_node_stats];
        xor rcx, rcx;
      anode_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  anode_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let anode_role_valid : (u64) -> u64 !{} @{} =
    fn (role: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): 1 iff role <= ANODE_ROLE_MAX (39). Labels prefixed anode_rv_.",
      block: {
        mov r10, 39;
        cmp rdi, r10;
        ja  anode_rv_no;
        mov rax, 1;
        ret;
      anode_rv_no:
        xor rax, rax;
        ret
      }
    }

  // anode_label_valid(label_ptr, label_len) -> 1 iff label_len <=
  // ANODE_LABEL_MAX AND (label_len == 0 OR label_ptr != 0).
  pub let anode_label_valid : (u64, u64) -> u64 !{} @{} =
    fn (label_ptr: u64) (label_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): 1 iff label_len <= ANODE_LABEL_MAX(256) and (label_len == 0 or label_ptr != 0) -- a nonzero claimed length naming a null pointer is refused rather than silently accepted (§2: the kernel never dereferences label_ptr, so this is the one shape-level check available). Labels prefixed anode_lv_.",
      block: {
        mov r10, 256;
        cmp rsi, r10;
        ja  anode_lv_no;
        cmp rsi, 0;
        je  anode_lv_ok;
        cmp rdi, 0;
        je  anode_lv_no;
      anode_lv_ok:
        mov rax, 1;
        ret;
      anode_lv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let anode_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): bounds-checked counter bump. Labels prefixed anode_nt_.",
      block: {
        cmp rdi, 4;
        jae anode_nt_out;
        lea r10, [rip + _a11y_node_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      anode_nt_out:
        ret
      }
    }

  pub let anode_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): bounds-checked counter read. Labels prefixed anode_st_.",
      block: {
        cmp rdi, 4;
        jae anode_st_zero;
        lea r10, [rip + _a11y_node_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      anode_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free — THE ONE WRITER of _a11y_node_table.
  // ==========================================================================

  // anode_tail_alloc(hdr, node_id, parent_node_id, label_ptr, label_len)
  // -> row_id | ANODE_TAIL_ENOSPC | ANODE_TAIL_BAD_ARG.
  //
  // Six args exceed the five-register SysV integer-arg budget at the
  // encoder's disposal in one call in this tree's established idiom
  // (see kind_display_mode.pdx's own six-arg mint_inner using rdi/rsi/
  // rdx/rcx/r8/r9) — here only five distinct values are needed (hdr
  // folds role into its own low bits before this call), so the plain
  // five-register form suffices with no stack-arg staging.
  pub let anode_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (node_id: u64) (parent_node_id: u64) (label_ptr: u64) (label_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): claim one A11Y NODE row. THE ONE WRITER of _a11y_node_table. Pure leaf -- no nested calls -- so every argument is kept in a register for the function's whole body (r12=hdr, r13=node_id, r14=parent_node_id, r15=label_ptr, r9=label_len; none of r9/r10/r11/rax/rbx are clobbered by any call since none happens) rather than the callee-save-preservation push/pop discipline a non-leaf needs; r12-r15 are still saved/restored across entry/exit purely because THIS function's own caller (a11y_node_cap_mint) holds live values in some of those same registers per SysV's callee-save contract, not because of anything internal to this body. Gates: hdr in_use bit pre-clear (bits [63:56] must be 0) -> BAD_ARG; node_id != 0 -> BAD_ARG (a fresh mint always carries a nonzero pre-incremented id). Low-first free scan over 64 rows of 48 bytes (imul r, r, 48 rather than shl, since 48 is not a power of two -- matches this tree's row-id * N addressing idiom, e.g. damage_aggregate.pdx §Section 7). Labels prefixed anode_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // node_id
        mov r14, rdx;                    // parent_node_id
        mov r15, rcx;                    // label_ptr
        mov r9,  r8;                     // label_len (leaf: r9 safe for the whole body)

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne anode_ta_bad;

        cmp r13, 0;
        je  anode_ta_bad;

        xor rbx, rbx;
      anode_ta_scan:
        cmp rbx, 64;
        jae anode_ta_enospc;

        lea r10, [rip + _a11y_node_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  anode_ta_claim;

        add rbx, 1;
        jmp anode_ta_scan;

      anode_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header (in_use | role)
        mov [r10 + 8],  r13;             // node_id
        mov [r10 + 16], r14;             // parent_node_id
        mov [r10 + 24], r15;             // label_ptr
        mov [r10 + 32], r9;              // label_len
        xor rax, rax;
        mov [r10 + 40], rax;             // reserved0
        mov rax, rbx;
        jmp anode_ta_out;

      anode_ta_enospc:
        mov rax, 0xFFFFEA07;             // ANODE_TAIL_ENOSPC
        jmp anode_ta_out;
      anode_ta_bad:
        mov rax, 0xFFFFEA06;             // ANODE_TAIL_BAD_ARG

      anode_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let anode_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): 1 iff row_id < ANODE_MAX and in_use. Labels prefixed anode_tv_.",
      block: {
        cmp rdi, 64;
        jae anode_tv_no;
        lea r10, [rip + _a11y_node_table];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  anode_tv_no;
        mov rax, 1;
        ret;
      anode_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let anode_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): scrub one row (6 qwords). Labels prefixed anode_tf_.",
      block: {
        cmp rdi, 64;
        jae anode_tf_out;
        lea r10, [rip + _a11y_node_table];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      anode_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Lookup by node_id (§1's same-kind parent reference).
  // ==========================================================================

  pub let anode_find_by_id : (u64) -> u64 !{mem} @{} =
    fn (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): live row_id holding this node_id, or ANODE_ROW_NONE(0xFF). Refuses to match 0 (ANODE_ID_NONE). Labels prefixed anode_fi_.",
      block: {
        cmp rdi, 0;
        je  anode_fi_none;
        xor rcx, rcx;
      anode_fi_scan:
        cmp rcx, 64;
        jae anode_fi_none;
        lea r10, [rip + _a11y_node_table];
        mov r11, rcx;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  anode_fi_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  anode_fi_hit;
      anode_fi_next:
        add rcx, 1;
        jmp anode_fi_scan;
      anode_fi_hit:
        mov rax, rcx;
        ret;
      anode_fi_none:
        mov rax, 0xFF;
        ret
      }
    }

  // anode_parent_valid(parent_node_id) -> 1 iff parent_node_id ==
  // ANODE_ID_NONE(0) (root) OR it names a live row.
  pub let anode_parent_valid : (u64) -> u64 !{mem} @{} =
    fn (parent_node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): §1 parent gate. 0 (root) is always valid; a nonzero value must resolve via anode_find_by_id to a live row. entry rsp%16==8; `sub rsp,8` pads to 0 for the single nested call (anode_find_by_id), `add rsp,8` restores after -- same bracket idiom sys_clock_read_ns_body uses around its own single nested call. Labels prefixed anode_pv_.",
      block: {
        cmp rdi, 0;
        je  anode_pv_yes;
        sub rsp, 8;
        call anode_find_by_id;
        add rsp, 8;
        mov r10, 0xFF;
        cmp rax, r10;
        je  anode_pv_no;
      anode_pv_yes:
        mov rax, 1;
        ret;
      anode_pv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Bad row -> ANODE_DECODE_BAD (0xFFFFFFFFFFFFFFFF),
  // matching kind_display_mode.pdx's dpm_row_* convention.
  // ==========================================================================

  pub let anode_row_node_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): node_id accessor. Labels prefixed anode_rn_.",
      block: {
        push r12;
        mov r12, rdi;
        call anode_tail_valid;
        cmp rax, 0;
        je  anode_rn_bad;
        lea r10, [rip + _a11y_node_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp anode_rn_out;
      anode_rn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      anode_rn_out:
        pop r12;
        ret
      }
    }

  pub let anode_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): parent_node_id accessor. Labels prefixed anode_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call anode_tail_valid;
        cmp rax, 0;
        je  anode_rp_bad;
        lea r10, [rip + _a11y_node_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp anode_rp_out;
      anode_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      anode_rp_out:
        pop r12;
        ret
      }
    }

  pub let anode_row_role : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): role accessor (header bits [15:0]). Labels prefixed anode_rr_.",
      block: {
        push r12;
        mov r12, rdi;
        call anode_tail_valid;
        cmp rax, 0;
        je  anode_rr_bad;
        lea r10, [rip + _a11y_node_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFFFF;
        jmp anode_rr_out;
      anode_rr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      anode_rr_out:
        pop r12;
        ret
      }
    }

  pub let anode_row_label_ptr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): label_ptr accessor (opaque, §2). Labels prefixed anode_rlp_.",
      block: {
        push r12;
        mov r12, rdi;
        call anode_tail_valid;
        cmp rax, 0;
        je  anode_rlp_bad;
        lea r10, [rip + _a11y_node_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp anode_rlp_out;
      anode_rlp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      anode_rlp_out:
        pop r12;
        ret
      }
    }

  pub let anode_row_label_len : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-09 (Wave UUU): label_len accessor. Labels prefixed anode_rll_.",
      block: {
        push r12;
        mov r12, rdi;
        call anode_tail_valid;
        cmp rax, 0;
        je  anode_rll_bad;
        lea r10, [rip + _a11y_node_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp anode_rll_out;
      anode_rll_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      anode_rll_out:
        pop r12;
        ret
      }
    }

  // anode_row_of_slot(slot) -> row_id, gated on live KIND_A11Y_NODE.
  pub let anode_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "COMP-IMPL-09 (Wave UUU): slot -> row_id, gated on live KIND_A11Y_NODE (0x1E6). Labels prefixed anode_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae anode_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1E6;
        cmp r10, r11;
        jne anode_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call anode_tail_valid;
        cmp rax, 0;
        je  anode_ros_none;

        mov rax, r12;
        jmp anode_ros_out;

      anode_ros_none:
        mov rax, 0xFF;
      anode_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. (parent_node_id, role, label_ptr, label_len) -> cap_slot |
  // sentinel. Real substrate: row alloc + free cap_table slot scan +
  // cap_mint_write, all in one call — see §4 for why this is a direct
  // kernel function rather than a cap_invoke op.
  // ==========================================================================

  pub let a11y_node_cap_mint : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_node_id: u64) (role: u64) (label_ptr: u64) (label_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "COMP-IMPL-09 (Wave UUU): mint KIND_A11Y_NODE (0x1E6). Six-push callee-save prologue (rbx=parent_node_id, r12=role, r13=label_ptr, r14=label_len, r15=node_id once allocated, rbp=row_id once allocated) -- entry rsp%16==8, 6 pushes lands rsp%16==8 again (48 bytes), +8-byte pad -> 0 for every nested call. Gate order: (1) anode_parent_valid(parent_node_id) -> BAD_PARENT. (2) anode_role_valid(role) -> BAD_ROLE. (3) anode_label_valid(label_ptr, label_len) -> BAD_LABEL. (4) node_id = ++_a11y_node_next_id (pre-increment so the first live id is 1, mirroring kind_tui_canvas.pdx's tui_next_canvas_id / the sibling userspace schema's NODE_ID_NONE convention). (5) header = role (in_use bit added by anode_tail_alloc itself). (6) anode_tail_alloc(header, node_id, parent_node_id, label_ptr, label_len) -> row_id or ENOSPC_ROW / TAIL_BAD_ARG (TAIL_BAD_ARG cannot fire here since gates 1-3 already validated the shape it re-checks, but the sentinel is still forwarded verbatim rather than asserted unreachable, matching this tree's defensive-forwarding convention). (7) free-slot scan of cap_table for kind==0 (mirrors sys_volume_mint.pdx's own svm_scan idiom exactly) -> ENOSPC_SLOT if none found, freeing the just-allocated row via anode_tail_free before returning so a slot-exhaustion refusal never leaks a live row with no reachable cap. (8) cap_mint_write(slot, KIND_A11Y_NODE, R_A11Y_NODE_CLIENT, row_id). (9) bump ANODE_ST_MINTS; return slot. Register discipline: rbx/r12/r13/r14 hold the four inputs across the three validator calls (all caller-save-clean per their own justifications); r15/rbp hold node_id/row_id once computed, both callee-save so they survive the cap_table scan loop and cap_mint_write. rax/rcx/rdx/rdi/rsi/r8/r9/r10/r11 caller-save scratch throughout. Effects {mem,sysreg}: mem for the row/table/cap_table writes; sysreg is defensive parity with every other audited mint in this directory (none of the calls here actually touch sysreg, but cap_mint_write's own downstream callers in other kinds do, and this tree's convention is to declare the union other kind files in this exact position declare -- see display_mode_cap_mint). Capabilities {cap}: this is the substrate mint for a capability kind. Labels prefixed anode_m_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 8;

        mov rbx, rdi;                    // parent_node_id
        mov r12, rsi;                    // role
        mov r13, rdx;                    // label_ptr
        mov r14, rcx;                    // label_len

        mov rdi, rbx;
        call anode_parent_valid;
        cmp rax, 0;
        je  anode_m_bad_parent;

        mov rdi, r12;
        call anode_role_valid;
        cmp rax, 0;
        je  anode_m_bad_role;

        mov rdi, r13;
        mov rsi, r14;
        call anode_label_valid;
        cmp rax, 0;
        je  anode_m_bad_label;

        // (4) node_id = ++_a11y_node_next_id.
        lea r10, [rip + _a11y_node_next_id];
        mov r15, [r10 + 0];
        add r15, 1;
        mov [r10 + 0], r15;

        // (6) anode_tail_alloc(header=role, node_id, parent_node_id,
        //     label_ptr, label_len).
        mov rdi, r12;                    // header (role only; in_use bit
                                          // is stamped by anode_tail_alloc)
        mov rsi, r15;                    // node_id
        mov rdx, rbx;                    // parent_node_id
        mov rcx, r13;                    // label_ptr
        mov r8,  r14;                    // label_len
        call anode_tail_alloc;

        mov r10, 0xFFFFEA07;             // ANODE_TAIL_ENOSPC
        cmp rax, r10;
        je  anode_m_enospc_row;
        mov r10, 0xFFFFEA06;             // ANODE_TAIL_BAD_ARG
        cmp rax, r10;
        je  anode_m_bad_arg_row;

        mov rbp, rax;                    // rbp = row_id

        // (7) Free-slot scan of cap_table for kind == 0.
        xor r14, r14;                    // slot cursor (label_len dead here)
      anode_m_scan:
        mov r10, 256;
        cmp r14, r10;
        jae anode_m_enospc_slot;
        lea rax, [rip + cap_table];
        mov r10, r14;
        shl r10, 3;
        mov r11, r14;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        mov rcx, [rax + 0];
        cmp rcx, 0;
        je  anode_m_slot_ok;
        add r14, 1;
        jmp anode_m_scan;
      anode_m_slot_ok:

        // (8) Publish.
        mov rdi, r14;                    // slot
        mov rsi, 0x1E6;                  // KIND_A11Y_NODE
        mov rdx, 0x019;                  // R_A11Y_NODE_CLIENT
        mov rcx, rbp;                    // target = row_id
        call cap_mint_write;

        mov rdi, 0;                      // ANODE_ST_MINTS
        call anode_note;

        mov rax, r14;                    // return cap_slot
        jmp anode_m_out;

      anode_m_enospc_slot:
        mov rdi, rbp;
        call anode_tail_free;
        mov rdi, 3;                      // ANODE_ST_REFUSED
        call anode_note;
        mov rax, 0xFFFFEA01;             // ANODE_MINT_ENOSPC_SLOT
        jmp anode_m_out;

      anode_m_bad_parent:
        mov rdi, 3;
        call anode_note;
        mov rax, 0xFFFFEA03;             // ANODE_MINT_BAD_PARENT
        jmp anode_m_out;
      anode_m_bad_role:
        mov rdi, 3;
        call anode_note;
        mov rax, 0xFFFFEA05;             // ANODE_MINT_BAD_ROLE
        jmp anode_m_out;
      anode_m_bad_label:
        mov rdi, 3;
        call anode_note;
        mov rax, 0xFFFFEA04;             // ANODE_MINT_BAD_LABEL
        jmp anode_m_out;
      anode_m_enospc_row:
        mov rdi, 3;
        call anode_note;
        mov rax, 0xFFFFEA02;             // ANODE_MINT_ENOSPC_ROW
        jmp anode_m_out;
      anode_m_bad_arg_row:
        mov rdi, 3;
        call anode_note;
        mov rax, 0xFFFFEA06;             // ANODE_TAIL_BAD_ARG (defensive forward)

      anode_m_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let a11y_node_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "COMP-IMPL-09 (Wave UUU): revoke KIND_A11Y_NODE. Bounds-check slot; wrong/empty kind -> WRONG_KIND/already-clear no-op path (ANODE_BAD_SLOT reused for 'kind was already 0' since an already-revoked slot and an out-of-range slot are both 'nothing to revoke here'); resolve row via target_ptr low 16 bits, tail_free it if still live, then scrub the cap_table descriptor via cap_mint_write(slot, 0, 0, 0). Labels prefixed anode_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae anode_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  anode_rvk_bad_slot;

        mov r11, 0x1E6;
        cmp r10, r11;
        jne anode_rvk_bad_slot;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call anode_tail_valid;
        cmp rax, 0;
        je  anode_rvk_clear;

        mov rdi, r13;
        call anode_tail_free;

      anode_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;                      // ANODE_ST_REVOKES
        call anode_note;

        xor rax, rax;
        jmp anode_rvk_out;

      anode_rvk_bad_slot:
        mov rax, 0xFFFFEA00;             // ANODE_BAD_SLOT

      anode_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler — the "dispatch arm to sys_cap_invoke" this
  // landing's row prompt asks for. QUERY-only: every op is a read
  // against an already-minted row.
  // ==========================================================================

  pub let cap_handler_a11y_node : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "COMP-IMPL-09 (Wave UUU): KIND_A11Y_NODE dispatch. Query ops (0..3) require R_A11Y_NODE_INVOKE; DEBUG_PRINT requires R_A11Y_NODE_OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Mirrors kind_display_mode.pdx's cap_handler_display_mode shape one-for-one (push count, register plan, refusal taxonomy) since both kinds are QUERY-only over a flat row. Labels prefixed anode_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr (row_id, low 16 bits)
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_a11y_node_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op ordinal
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne anode_hn_res;

        cmp rbp, 4;
        ja  anode_hn_unsup;

        cmp rbp, 4;
        je  anode_hn_dbg;

        // Ops 0..3: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  anode_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  anode_hn_parent;
        cmp rbp, 1;
        je  anode_hn_role;
        cmp rbp, 2;
        je  anode_hn_lptr;
        call anode_row_label_len;
        jmp anode_hn_out;

      anode_hn_parent:
        call anode_row_parent;
        jmp anode_hn_out;
      anode_hn_role:
        call anode_row_role;
        jmp anode_hn_out;
      anode_hn_lptr:
        call anode_row_label_ptr;
        jmp anode_hn_out;

      anode_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  anode_hn_denied;
        xor rax, rax;
        jmp anode_hn_out;

      anode_hn_res:
        mov rax, 0xFFFFEA06;             // ANODE_TAIL_BAD_ARG (reserved
                                          // op_arg bits set)
        jmp anode_hn_out;
      anode_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp anode_hn_out;
      anode_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      anode_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
