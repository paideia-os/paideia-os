  // ==========================================================================
  // Mint.
  //
  // Six args: (slot, parent_slot, interface_slot, rights, endpoint_key,
  // packed_ep). packed_ep = ep_num[7:0] | ep_type[15:8] | direction[23:16]
  //                         | max_packet[47:32]
  // ==========================================================================

  pub let usb_endpoint_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (interface_slot: u64) (rights: u64) (endpoint_key: u64) (packed_ep: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): mint a KIND_USB_ENDPOINT over KIND_IPC_ENDPOINT + KIND_USB_INTERFACE. Six args because SysV has six argument regs and paideia-as does not emit stack-arg prologues; the four descriptor byte fields are packed into one u64: ep_num[7:0] | ep_type[15:8] | direction[23:16] | max_packet[47:32] (16 bits so 1024 fits). Sequence: (1) slot<256. (2) check_parent (IPC endpoint) -> BAD_PARENT. (3) check_interface (USB_INTERFACE) -> BAD_INTERFACE. (4) rights_valid -> BAD_RIGHTS. (5) unpack + validate ep_num/ep_type/dir/max_packet. (6) endpoint_key != 0 -> NO_KEY. (7) UNIQUENESS on endpoint_key -> IN_USE. (8) hdr_pack + body_pack + tail_alloc. (9) cap_mint_write. Labels prefixed usbep_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // interface_slot
        mov r14, rcx;                    // rights
        mov r15, r8;                     // endpoint_key
        mov rbp, r9;                     // packed_ep

        mov r10, 256;
        cmp rbx, r10;
        jae usbep_mi_bad_slot;

        mov rdi, r12;
        call usb_endpoint_check_parent;
        cmp rax, 0;
        je  usbep_mi_bad_parent;

        mov rdi, r13;
        call usb_endpoint_check_interface;
        cmp rax, 0;
        je  usbep_mi_bad_interface;

        mov rdi, r14;
        call usb_endpoint_rights_valid;
        cmp rax, 0;
        je  usbep_mi_bad_rights;

        mov rdi, rbp;
        and rdi, 0xFF;                   // ep_num
        call usb_endpoint_epnum_valid;
        cmp rax, 0;
        je  usbep_mi_bad_epnum;

        mov rdi, rbp;
        shr rdi, 8;
        and rdi, 0xFF;                   // ep_type
        call usb_endpoint_eptype_valid;
        cmp rax, 0;
        je  usbep_mi_bad_eptype;

        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFF;                   // direction
        call usb_endpoint_dir_valid;
        cmp rax, 0;
        je  usbep_mi_bad_dir;

        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFF;                 // max_packet
        call usb_endpoint_maxpacket_valid;
        cmp rax, 0;
        je  usbep_mi_bad_maxpkt;

        cmp r15, 0;
        je  usbep_mi_no_key;

        mov rdi, r15;
        call usb_endpoint_find_by_key;
        cmp rax, 0xFF;
        jne usbep_mi_in_use;

        // Build body via usb_endpoint_body_pack(ep_num, ep_type, dir, max_pkt, if_slot).
        mov rdi, rbp;
        and rdi, 0xFF;                   // ep_num
        mov rsi, rbp;
        shr rsi, 8;
        and rsi, 0xFF;                   // ep_type
        mov rdx, rbp;
        shr rdx, 16;
        and rdx, 0xFF;                   // direction
        mov rcx, rbp;
        shr rcx, 32;
        and rcx, 0xFFFF;                 // max_packet
        mov r8, r13;                     // interface_slot
        call usb_endpoint_body_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  usbep_mi_bad_epnum;
        push rax;                        // body
        sub rsp, 8;

        mov rdi, r12;
        call usb_endpoint_hdr_pack;
        add rsp, 8;
        pop r10;                         // body
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbep_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r15;                    // endpoint_key
        mov rdx, r10;                    // body
        call usb_endpoint_tail_alloc;

        mov r10, 0xFFFFFBCF;
        cmp rax, r10;
        je  usbep_mi_enospc;
        mov r10, 0xFFFFFBCE;
        cmp rax, r10;
        je  usbep_mi_bad_epnum;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x165;
        mov rdx, r14;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call usb_endpoint_note;

        xor rax, rax;
        jmp usbep_mi_out;

      usbep_mi_bad_slot:
        mov rax, 0xFFFFFBC3;
        jmp usbep_mi_out;
      usbep_mi_bad_parent:
        mov rax, 0xFFFFFBCD;
        jmp usbep_mi_out;
      usbep_mi_bad_interface:
        mov rax, 0xFFFFFBC7;
        jmp usbep_mi_out;
      usbep_mi_bad_rights:
        mov rax, 0xFFFFFBCC;
        jmp usbep_mi_out;
      usbep_mi_bad_epnum:
        mov rax, 0xFFFFFBCB;
        jmp usbep_mi_out;
      usbep_mi_bad_eptype:
        mov rax, 0xFFFFFBCA;
        jmp usbep_mi_out;
      usbep_mi_bad_dir:
        mov rax, 0xFFFFFBC9;
        jmp usbep_mi_out;
      usbep_mi_bad_maxpkt:
        mov rax, 0xFFFFFBC8;
        jmp usbep_mi_out;
      usbep_mi_no_key:
        mov rax, 0xFFFFFBC6;
        jmp usbep_mi_out;
      usbep_mi_in_use:
        mov rdi, 2;
        call usb_endpoint_note;
        mov rax, 0xFFFFFBC4;
        jmp usbep_mi_out;
      usbep_mi_enospc:
        mov rdi, 3;
        call usb_endpoint_note;
        mov rax, 0xFFFFFBC5;

      usbep_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_endpoint_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (interface_slot: u64) (rights: u64) (endpoint_key: u64) (packed_ep: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call usb_endpoint_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x165;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let usb_endpoint_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): revoke a KIND_USB_ENDPOINT. Labels prefixed usbep_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae usbep_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  usbep_rvk_already;

        mov r11, 0x165;
        cmp r10, r11;
        jne usbep_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call usb_endpoint_tail_valid;
        cmp rax, 0;
        je  usbep_rvk_clear;

        mov rdi, r13;
        call usb_endpoint_tail_free;

      usbep_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call usb_endpoint_note;

        xor rax, rax;
        jmp usbep_rvk_out;

      usbep_rvk_bad_slot:
        mov rax, 0xFFFFFBC3;
        jmp usbep_rvk_out;
      usbep_rvk_wrong_kind:
        mov rax, 0xFFFFFBC2;
        jmp usbep_rvk_out;
      usbep_rvk_already:
        mov rax, 0xFFFFFBC1;

      usbep_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_endpoint_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call usb_endpoint_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x165;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_usb_endpoint : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): KIND_USB_ENDPOINT dispatch handler. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed usbep_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_usb_endpoint_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne usbep_hn_res;

        cmp rbp, 7;
        ja  usbep_hn_unsup;

        cmp rbp, 7;
        je  usbep_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  usbep_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  usbep_hn_key;
        cmp rbp, 1;
        je  usbep_hn_en;
        cmp rbp, 2;
        je  usbep_hn_et;
        cmp rbp, 3;
        je  usbep_hn_ed;
        cmp rbp, 4;
        je  usbep_hn_em;
        cmp rbp, 5;
        je  usbep_hn_ei;
        call usb_endpoint_row_parent;
        jmp usbep_hn_out;

      usbep_hn_key:
        call usb_endpoint_row_key;
        jmp usbep_hn_out;
      usbep_hn_en:
        call usb_endpoint_row_epnum;
        jmp usbep_hn_out;
      usbep_hn_et:
        call usb_endpoint_row_eptype;
        jmp usbep_hn_out;
      usbep_hn_ed:
        call usb_endpoint_row_dir;
        jmp usbep_hn_out;
      usbep_hn_em:
        call usb_endpoint_row_maxpacket;
        jmp usbep_hn_out;
      usbep_hn_ei:
        call usb_endpoint_row_interface;
        jmp usbep_hn_out;

      usbep_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  usbep_hn_denied;
        xor rax, rax;
        jmp usbep_hn_out;

      usbep_hn_res:
        mov rax, 0xFFFFFBCE;
        jmp usbep_hn_out;
      usbep_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp usbep_hn_out;
      usbep_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      usbep_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
