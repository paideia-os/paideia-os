// src/kernel/core/cap/kind_usb_endpoint.pdx — R34.M2-004 (#1175)
//
// KIND_USB_ENDPOINT = 0x165, derived over KIND_IPC_ENDPOINT (5),
// with a SECOND capability argument naming the KIND_USB_INTERFACE
// (0x164) this endpoint belongs to.
//
// The authority to hold ONE USB endpoint's static identity — its
// inherited endpoint_key (a fresh identity supplied by the class
// driver at descriptor-parse time), its ep_num (the low nibble of
// bEndpointAddress, USB 2.0 §9.6.6), its ep_type (control, isoch,
// bulk, interrupt), its direction (IN/OUT), and its max_packet size.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// An INTERFACE is one function on a device; an ENDPOINT is one PIPE
// through which the interface transfers bytes. USB transfer scheduling
// (xhci ring management, bandwidth allocation for isoch, NAK/STALL
// handling for bulk) is per-ENDPOINT, so the CAPABILITY at which
// transfer authority is gated has to be the endpoint. That is this
// kind.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT + KIND_USB_INTERFACE
// =============================================================================
//
// FIRST HALF: `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
//
// THAT HALF IS EMPTY ON ITS OWN. Every endpoint in the machine is
// KIND_IPC_ENDPOINT — the shell's stdout included — so a gate that
// stopped there would let any process holding any endpoint mint
// itself USB transfer authority. This is the KIND_EC_QUERY / #1075
// lesson restated.
//
// SECOND HALF: a `interface_slot` cap argument must be a live
// KIND_USB_INTERFACE (0x164) carrying RIGHT_MINT. The two halves
// prove unrelated things — WHERE the transfer completions will
// arrive, and WHICH USB interface the endpoint belongs to.
// interface_slot IS RECORDED IN THE ROW, so a later revoke cascade
// keyed on the interface finds all its endpoints without re-deriving
// them from a cap slot that may since have been reused.
//
// =============================================================================
// §2  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS ABSENT
// =============================================================================
//
// Same discipline as KIND_USB_DEVICE / KIND_USB_INTERFACE. endpoint_
// key, ep_num, ep_type, direction, max_packet and interface_slot are
// ROW IDENTITY. There is NO transfer state on this row — completion
// counts, ring positions, in-flight packet counts belong to the
// xhci substrate and to the IPC endpoint's own bookkeeping. An
// endpoint whose ep_type could be re-stamped in place would let a
// bulk-scheduled ring receive an isoch packet.
//
// =============================================================================
// §3  KIND_USB_ENDPOINT IS A LEAF
// =============================================================================
//
// Nothing derives from this kind. R_USB_EP_MINT is DELIBERATELY
// ABSENT from R_USB_EP_ALL — a MINT bit that no gate anywhere
// accepts as a parent would be a rights bit that looks like
// authority and confers none. Same call KIND_FW_SESSION / KIND_HID_
// EVENT / KIND_SENSOR_CHANNEL made for the same reason.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFFBC0..0xFFFFFBCF
// =============================================================================
//
// Sixteen-wide band disjoint from every other kind in the tree.
// NOT 0xFFFFFC00..0F: that band is drivers/hid/report_parser.pdx's
// live HID_RP_* error codes (§6 there), already emitting values in
// this exact range, so this kind takes 0xFFFFFBC0..CF instead — free
// territory adjacent to this milestone's own composite_bind.pdx
// (0xFFFFFB80..8F), interface_parser.pdx (0xFFFFFB90..9F) and
// KIND_USB_INTERFACE (0xFFFFFBB0..BF) bands.

module KindUsbEndpoint = structure {

  pub let KIND_USB_ENDPOINT        : u64 = 0x165
  pub let USB_EP_PARENT_KIND       : u64 = 5        // = KIND_IPC_ENDPOINT
  pub let USB_EP_INTERFACE_KIND    : u64 = 0x164    // = KIND_USB_INTERFACE

  // §1 bounds.
  pub let USB_EP_NUM_MIN     : u64 = 0
  pub let USB_EP_NUM_MAX     : u64 = 15
  pub let USB_EP_TYPE_MIN    : u64 = 0
  pub let USB_EP_TYPE_MAX    : u64 = 3
  pub let USB_EP_DIR_MIN     : u64 = 0
  pub let USB_EP_DIR_MAX     : u64 = 1
  pub let USB_EP_MAXPKT_MIN  : u64 = 1
  pub let USB_EP_MAXPKT_MAX  : u64 = 1024

  // ep_type enum.
  pub let USB_EP_TYPE_CONTROL   : u64 = 0
  pub let USB_EP_TYPE_ISOCH     : u64 = 1
  pub let USB_EP_TYPE_BULK      : u64 = 2
  pub let USB_EP_TYPE_INTERRUPT : u64 = 3

  // direction.
  pub let USB_EP_DIR_OUT : u64 = 0
  pub let USB_EP_DIR_IN  : u64 = 1

  // Rights. Leaf: RIGHT_MINT (0x200) NOT in the mask (§3).
  pub let R_USB_EP_READ    : u64 = 0x001
  pub let R_USB_EP_INVOKE  : u64 = 0x008
  pub let R_USB_EP_REVOKE  : u64 = 0x010
  pub let R_USB_EP_OBSERVE : u64 = 0x400
  pub let R_USB_EP_ALL     : u64 = 0x419

  // Ops:
  pub let USBEP_OP_QUERY_KEY       : u64 = 0
  pub let USBEP_OP_QUERY_EP_NUM    : u64 = 1
  pub let USBEP_OP_QUERY_EP_TYPE   : u64 = 2
  pub let USBEP_OP_QUERY_DIR       : u64 = 3
  pub let USBEP_OP_QUERY_MAX_PKT   : u64 = 4
  pub let USBEP_OP_QUERY_INTERFACE : u64 = 5
  pub let USBEP_OP_QUERY_PARENT    : u64 = 6
  pub let USBEP_OP_DEBUG_PRINT     : u64 = 7
  pub let USBEP_OP_MAX             : u64 = 7

  // Failure taxonomy — 0xFFFFFBC0..0xFFFFFBCF.
  pub let USBEP_OK                 : u64 = 0
  pub let USBEP_TAIL_ENOSPC        : u64 = 0xFFFFFBCF
  pub let USBEP_TAIL_BAD_ARG       : u64 = 0xFFFFFBCE
  pub let USBEP_MINT_BAD_PARENT    : u64 = 0xFFFFFBCD
  pub let USBEP_MINT_BAD_RIGHTS    : u64 = 0xFFFFFBCC
  pub let USBEP_MINT_BAD_EPNUM     : u64 = 0xFFFFFBCB
  pub let USBEP_MINT_BAD_EPTYPE    : u64 = 0xFFFFFBCA
  pub let USBEP_MINT_BAD_DIR       : u64 = 0xFFFFFBC9
  pub let USBEP_MINT_BAD_MAXPACKET : u64 = 0xFFFFFBC8
  pub let USBEP_MINT_BAD_INTERFACE : u64 = 0xFFFFFBC7
  pub let USBEP_MINT_NO_KEY        : u64 = 0xFFFFFBC6
  pub let USBEP_MINT_ENOSPC        : u64 = 0xFFFFFBC5
  pub let USBEP_MINT_IN_USE        : u64 = 0xFFFFFBC4
  pub let USBEP_BAD_SLOT           : u64 = 0xFFFFFBC3
  pub let USBEP_WRONG_KIND         : u64 = 0xFFFFFBC2
  pub let USBEP_REVOKE_ALREADY     : u64 = 0xFFFFFBC1

  pub let USBEP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let USBEP_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  endpoint_key
  //   [+16] body: ep_num[7:0] | ep_type[15:8] | direction[23:16] |
  //               max_packet[39:24] | interface_slot[47:40]
  //   [+24] reserved
  pub let USBEP_MAX       : u64 = 16
  pub let USBEP_ROW_BYTES : u64 = 32

  pub let mut _usb_endpoint_table : [u64; 64] = uninit @align(64)
  pub let mut _usb_endpoint_stats : [u64; 4]  = uninit @align(64)

  pub let USBEP_ST_MINTS   : u64 = 0
  pub let USBEP_ST_REVOKES : u64 = 1
  pub let USBEP_ST_IN_USE  : u64 = 2
  pub let USBEP_ST_ENOSPC  : u64 = 3

  pub let usbep_dbg_msg : [u8; 13] = "USB EP ROW\n\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let usb_endpoint_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): clear the USB endpoint row table and its counters. Boot and teardown only. Labels prefixed usbep_rs_.",
      block: {
        lea r10, [rip + _usb_endpoint_table];
        xor rax, rax;
        xor rcx, rcx;
      usbep_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  usbep_rs_rows;

        lea r10, [rip + _usb_endpoint_stats];
        xor rcx, rcx;
      usbep_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  usbep_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let usb_endpoint_epnum_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-004 (#1175): 1 iff n <= 15. Labels prefixed usbep_ev_.",
      block: {
        cmp rdi, 15;
        ja  usbep_ev_no;
        mov rax, 1;
        ret;
      usbep_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_endpoint_eptype_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-004 (#1175): 1 iff t <= 3 (CONTROL/ISOCH/BULK/INTERRUPT). Labels prefixed usbep_tv_.",
      block: {
        cmp rdi, 3;
        ja  usbep_tv_no;
        mov rax, 1;
        ret;
      usbep_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_endpoint_dir_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-004 (#1175): 1 iff d <= 1 (OUT/IN). Labels prefixed usbep_dv_.",
      block: {
        cmp rdi, 1;
        ja  usbep_dv_no;
        mov rax, 1;
        ret;
      usbep_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_endpoint_maxpacket_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-004 (#1175): 1 iff m in [1, 1024]. Labels prefixed usbep_mv_.",
      block: {
        cmp rdi, 1;
        jb  usbep_mv_no;
        cmp rdi, 1024;
        ja  usbep_mv_no;
        mov rax, 1;
        ret;
      usbep_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_endpoint_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-004 (#1175): subset test against R_USB_EP_ALL = 0x419. Labels prefixed usbep_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne usbep_rv_no;
        mov rax, 1;
        ret;
      usbep_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let usb_endpoint_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): counter bump. Labels prefixed usbep_nt_.",
      block: {
        cmp rdi, 4;
        jae usbep_nt_out;
        lea r10, [rip + _usb_endpoint_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      usbep_nt_out:
        ret
      }
    }

  pub let usb_endpoint_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): counter read. Labels prefixed usbep_st_.",
      block: {
        cmp rdi, 4;
        jae usbep_st_zero;
        lea r10, [rip + _usb_endpoint_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      usbep_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_IPC_ENDPOINT with RIGHT_MINT.
  // ==========================================================================

  pub let usb_endpoint_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): first half of the gate. parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. §1 makes plain this half is empty on its own. Labels prefixed usbep_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae usbep_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne usbep_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  usbep_cp_no;

        mov rax, 1;
        ret;
      usbep_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Interface gate: interface_slot must be live KIND_USB_INTERFACE + MINT.
  // ==========================================================================

  pub let usb_endpoint_check_interface : (u64) -> u64 !{mem} @{cap} =
    fn (interface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): second half of the gate. interface_slot must be live KIND_USB_INTERFACE (0x164) with RIGHT_MINT. §1 makes plain this half is what does the discrimination. Labels prefixed usbep_ci_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae usbep_ci_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x164;                  // KIND_USB_INTERFACE
        cmp r10, r11;
        jne usbep_ci_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  usbep_ci_no;

        mov rax, 1;
        ret;
      usbep_ci_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let usb_endpoint_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-004 (#1175): (parent_slot << 8). Labels prefixed usbep_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae usbep_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      usbep_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_endpoint_body_pack : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (ep_num: u64) (ep_type: u64) (direction: u64) (max_packet: u64) (interface_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-004 (#1175): pack ep_num[7:0] | ep_type[15:8] | direction[23:16] | max_packet[39:24] | interface_slot[47:40]. Refuses out-of-range. Labels prefixed usbep_bp_.",
      block: {
        cmp rdi, 15;
        ja  usbep_bp_bad;
        cmp rsi, 3;
        ja  usbep_bp_bad;
        cmp rdx, 1;
        ja  usbep_bp_bad;
        cmp rcx, 1;
        jb  usbep_bp_bad;
        cmp rcx, 1024;
        ja  usbep_bp_bad;
        cmp r8, 255;
        ja  usbep_bp_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 24;
        or  rax, r10;
        mov r10, r8;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      usbep_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/valid/free.
  // ==========================================================================

  pub let usb_endpoint_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (endpoint_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): claim one USB endpoint row. THE ONE WRITER of _usb_endpoint_table. Labels prefixed usbep_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // endpoint_key
        mov r14, rdx;                    // body_packed

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne usbep_ta_bad;

        cmp r13, 0;
        je  usbep_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  usbep_ta_bad;

        xor rbx, rbx;
      usbep_ta_scan:
        cmp rbx, 16;
        jae usbep_ta_enospc;

        lea r10, [rip + _usb_endpoint_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbep_ta_claim;

        add rbx, 1;
        jmp usbep_ta_scan;

      usbep_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp usbep_ta_out;

      usbep_ta_enospc:
        mov rax, 0xFFFFFBCF;
        jmp usbep_ta_out;
      usbep_ta_bad:
        mov rax, 0xFFFFFBCE;

      usbep_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_endpoint_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): 1 iff row_id < MAX and in_use. Labels prefixed usbep_tvr_.",
      block: {
        cmp rdi, 16;
        jae usbep_tvr_no;
        lea r10, [rip + _usb_endpoint_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbep_tvr_no;
        mov rax, 1;
        ret;
      usbep_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_endpoint_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): scrub one row. Labels prefixed usbep_tf_.",
      block: {
        cmp rdi, 16;
        jae usbep_tf_out;
        lea r10, [rip + _usb_endpoint_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      usbep_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let usb_endpoint_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): endpoint_key. Labels prefixed usbep_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_endpoint_tail_valid;
        cmp rax, 0;
        je  usbep_rk_bad;
        lea r10, [rip + _usb_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp usbep_rk_out;
      usbep_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbep_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_endpoint_row_epnum : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): ep_num. Labels prefixed usbep_re_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_endpoint_tail_valid;
        cmp rax, 0;
        je  usbep_re_bad;
        lea r10, [rip + _usb_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp usbep_re_out;
      usbep_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbep_re_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_endpoint_row_eptype : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): ep_type. Labels prefixed usbep_rt_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_endpoint_tail_valid;
        cmp rax, 0;
        je  usbep_rt_bad;
        lea r10, [rip + _usb_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFF;
        jmp usbep_rt_out;
      usbep_rt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbep_rt_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_endpoint_row_dir : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): direction. Labels prefixed usbep_rd_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_endpoint_tail_valid;
        cmp rax, 0;
        je  usbep_rd_bad;
        lea r10, [rip + _usb_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFF;
        jmp usbep_rd_out;
      usbep_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbep_rd_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_endpoint_row_maxpacket : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
