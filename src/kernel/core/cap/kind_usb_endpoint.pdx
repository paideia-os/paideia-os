  pub let usb_endpoint_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (endpoint_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-004 (#1175): live row holding this endpoint_key, or ROW_NONE. Labels prefixed usbep_fk_.",
      block: {
        cmp rdi, 0;
        je  usbep_fk_none;
        xor rcx, rcx;
      usbep_fk_scan:
        cmp rcx, 16;
        jae usbep_fk_none;
        lea r10, [rip + _usb_endpoint_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbep_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  usbep_fk_hit;
      usbep_fk_next:
        add rcx, 1;
        jmp usbep_fk_scan;
      usbep_fk_hit:
        mov rax, rcx;
        ret;
      usbep_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let usb_endpoint_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M2-004 (#1175): slot -> row_id, gated on live KIND_USB_ENDPOINT. Labels prefixed usbep_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae usbep_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x165;
        cmp r10, r11;
        jne usbep_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call usb_endpoint_tail_valid;
        cmp rax, 0;
        je  usbep_ros_none;

        mov rax, r12;
        jmp usbep_ros_out;

      usbep_ros_none:
        mov rax, 0xFF;
      usbep_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

