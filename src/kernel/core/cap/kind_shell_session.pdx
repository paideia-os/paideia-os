  //   SS_ERR_BAD_STATE -> KS_ERR_BAD_OP
  //   (other non-zero) -> KS_ERR_BAD_SESSION (defensive fallback)
  //
  // Two callee-save pushes (rbx = sid, r12 = new_state) + sub rsp,8
