// src/kernel/core/cap/kind_shell_session.pdx -- Wave UMB-W12 R127.M2
// paideia-os #2598
//
// KIND_SHELL_SESSION = 0x1A9 -- the cap-invoke surface wrapping the
// R127.M1 svc.shell-session row pool. Ring-3 holders of this cap reach
// four read/write ops against ONE shell_session row (lookup-by-pid,
// read-state, set-state, read-name) without going through the direct-
// call API that only in-kernel bringup paths may use.
//
// =============================================================================
// SECTION 0  NAMING  --  WHY NOT `KindSession` AT `kind_session.pdx`
// =============================================================================
//
// The umbrella task directive called this landing "KIND_SESSION" and
// specified `src/kernel/core/cap/kind_session.pdx` with module
// `KindSession`. BOTH names are already taken by R113.M5-022 (paideia-
// os #2402, Sep 2026):
//
//   src/kernel/core/cap/kind_session.pdx :: module KindSession ::
//     pub let KIND_SESSION : u64 = 0x1BC
//
// That earlier landing is the user-login session substrate (LOGIN /
// ACTIVE / LOCKED / EXITED lifecycle, seat ownership, derived over
// KIND_IPC_ENDPOINT). It is semantically unrelated to R127's REPL
// shell session (pid + tty_fd + cap_env + history anchor + display
// name). The two live side by side under disjoint names:
//
//   KIND_SESSION       = 0x1BC   kind_session.pdx         user-login
//   KIND_SHELL_SESSION = 0x1A9   kind_shell_session.pdx   REPL shell  (THIS LANDING)
//
// The module basename rule in the paideia-as encoder is that the
// `module Foo` identifier case-folds against the file basename with
// underscores dropped. `kind_shell_session.pdx` -> `KindShellSession`
// is accepted; `kind_session.pdx` -> `KindSession` would collide with
// R113.M5-022's module declaration at link time. We therefore adopt
// the longer name across the board (the KIND constant, the ops, the
// rights, the error band) and keep every symbol prefixed either `KS_`
// or `ks_` for the per-op helpers to stay clear of the login-session
// `SESSION_*` namespace.
//
// Note on the TASK-DIRECTIVE op/rights names. The directive asked for
// `SESSION_OP_*` + `R_SESSION_*` + `KS_*`. The `SESSION_OP_*` /
// `R_SESSION_*` constants are DELIBERATELY LEFT UNDEFINED in this
// module -- an R127.M3+ caller who wants a `SESSION_*` alias may
// re-export under the login-session's module without ambiguity because
// that module today exports no OP or rights constants (it is substrate-
// only). We export only `KS_OP_*` / `R_KS_*` to make the collision
// hazard impossible to introduce.
//
// =============================================================================
// SECTION 1  ORDINAL CHOICE  --  0x1A9
// =============================================================================
//
// Audit at landing time (2026-10-13; `grep -rnE "= 0x1[A-F0-9]+" src/
// --include=*.pdx | sort -k3`):
//
//   0x1A3  KIND_SIG_KEY
//   0x1A4  KIND_DEK
//   0x1A5  KIND_PDXFS_MOUNT_TABLE
//   0x1A6  KIND_TUI_CANVAS
//   0x1A7  KIND_TLS_TRUST
//   0x1A8  KIND_UDP_SOCKET
//   0x1A9  (comment-reserved for KIND_PACKET_FILTER, R96)       <-- taken here
//   0x1AA  (comment-reserved for KIND_TLS_CONN, R97)
//   0x1AB  KIND_TCP_SOCKET
//   0x1AC  KIND_TCP_LISTENER
//   0x1AD  KIND_NIC
//   0x1AE  KIND_DISPLAY_BACKEND
//   0x1AF  KIND_FRAMEBUFFER
//   0x1B0  KIND_PAGE_FLIP
//
// The umbrella directive constrained the search to 0x1A5..0x1B0.
// Every slot in that window is live EXCEPT 0x1A9 and 0x1AA, both
// comment-reserved for a networking kind that has not landed (per
// kind.pdx §KIND_TLS_TRUST which notes "0x1A9 stays reserved for
// KIND_PACKET_FILTER, 0x1AA for KIND_TLS_CONN (both unimplemented)").
// A tree-wide `grep -rnE '= 0x1A9\b|= 0x1AA\b' src/` returned ZERO
// declarations at landing time -- the reservation is a planning
// comment only.
//
// This landing claims 0x1A9. The networking kinds, when they land,
// retarget 0x1B5..0x1B7 (comment-reserved for user G6 HDR / TONEMAP /
// REFERENCE_DISPLAY per kind_session.pdx line 65; those user G6 kinds
// have no live declaration either) or 0x1BD..0x1BF (free M5 follow-on
// slots per kind_session.pdx line 73). An update to kind.pdx L3024-
// L3026's reservation comment accompanies this landing. We take 0x1A9
// in preference to 0x1AA because the lower slot is cache-adjacent to
// the FS / crypto / TTY cluster (0x1A4..0x1A6) and leaves 0x1AA for
// a networking kind whose derivation (KIND_TLS_CONN over KIND_NIC)
// crosses the networking slot cluster boundary already.
//
// =============================================================================
// SECTION 2  DERIVATION  --  OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// A shell session is a RENDEZVOUS point between three parties:
//
//   * the shell parent task (reads from tty_fd, dispatches to the
//     cmd-module launched under cap_env_slot),
//   * the user REPL (writes to tty_fd on behalf of a running cmd),
//   * the session daemon (owns the row, serves lookup / state / name
//     / destroy against the row).
//
// All three communicate over endpoints. The IPC_ENDPOINT (slot 5) is
// therefore the correct runtime base kind -- matching the precedent
// set by KIND_FW_SESSION (0x155), KIND_MBIM_SESSION (0x181), KIND_SESSION
// (0x1BC, the user-login kind), and the two R30 derived-session kinds.
//
// Every endpoint in the machine satisfies the KIND_IPC_ENDPOINT gate on
// its own (the #1075 lesson, repeated in kind_fw_session.pdx §KIND
// HALF). The SECOND half of the derivation gate is `ss_row_in_use(
// shell_session_row_id) == 1` -- a kernel-held row that only the
// R127.M1 daemon writes. mount.pdxfs-shaped unforgeability: the row
// id in a KIND_SHELL_SESSION descriptor's `target_ptr[15:0]` MUST
// correspond to a live row, OR the LOOKUP / READ_STATE / SET_STATE /
// READ_NAME op refuses with KS_ERR_BAD_SESSION.
//
// =============================================================================
// SECTION 3  TAIL ENCODING  --  descriptor layout
// =============================================================================
//
// The row pool itself lives in src/kernel/core/svc/shell_session.pdx
// (R127.M1 landing). This file does NOT allocate a parallel pool; the
// KIND_SHELL_SESSION cap's descriptor carries ONE 16-bit row id in
// `target_ptr[15:0]` and the rest of `target_ptr` is reserved for
// future generation tagging (R127.M3 may fold a 48-bit monotonic
// generation into [63:16] so a destroyed-and-reallocated slot is
// distinguishable from the stale cap).
//
// The 24-byte cap_table descriptor shape (cap/mint.pdx cap_mint_write):
//
//   [+0]  kind         (u64)  = KIND_SHELL_SESSION (0x1A9)
//   [+8]  rights       (u64)  = (R_KS_READ | R_KS_WRITE | R_KS_LIFECYCLE)
//                               subset
//   [+16] target_ptr   (u64)  = shell_session_row_id in bits [15:0]
//                               (0..SS_POOL_MAX-1 = 0..7); bits [63:16]
//                               must be zero at mint, reserved for a
//                               future generation counter.
//
// =============================================================================
// SECTION 4  RIGHTS
// =============================================================================
//
//   R_KS_READ      = 0x001 -- SESSION_OP_LOOKUP_BY_PID,
//                             SESSION_OP_READ_STATE,
//                             SESSION_OP_READ_NAME
//   R_KS_WRITE     = 0x002 -- SESSION_OP_SET_STATE
//   R_KS_LIFECYCLE = 0x004 -- reserved for a future DESTROY op
//                             (R127.M3+); a narrowed child cap that
//                             drops LIFECYCLE cannot destroy the row.
//   R_KS_ALL       = 0x007 -- subset test in ks_rights_valid.
//
// The split READ / WRITE / LIFECYCLE triplet mirrors kind_dek's SEAL /
// READ / SCRUB split and matches the convention in kernel-cap-
// taxonomy.md §4 (rights are op-grained; narrowed children drop
// rights to constrain reach).
//
// =============================================================================
// SECTION 5  OPS
// =============================================================================
//
// Four ops at M2. The op ordinal lives in `op_arg[7:0]`; the
// semantics of `target_ptr` and `op_arg[63:8]` vary by op.
//
//   SESSION_OP_LOOKUP_BY_PID (op 0)   REQUIRES R_KS_READ
//     target_ptr = pid                 (FULL 64 bits; not a row id)
//     op_arg[63:8] = 0                 (no payload)
//     RETURN       = session_id (0..7) | KS_ERR_BAD_SESSION
//     DELEGATE     = _shell_session_lookup(pid). The SS_ID_NONE
//                    sentinel (0xFF) is translated to KS_ERR_BAD_SESSION
//                    before return; the real session_id passes
//                    through unchanged. (session_id lives in [0, 8);
//                    KS_ERR_BAD_SESSION = 0x1110 > 7 so the two
//                    bands are disjoint.)
//
//   SESSION_OP_READ_STATE (op 1)      REQUIRES R_KS_READ
//     target_ptr[15:0] = session_id
//     target_ptr[63:16] = 0            (reserved for generation)
//     op_arg[63:8] = 0
//     RETURN       = state (0..3)      | KS_ERR_BAD_SESSION
//     GATE         = ss_row_in_use(session_id).
//     Read [row_base + 40][31:0] directly (the state field; the
//     high 32 bits of that u64 are the reserved generation slot).
//
//   SESSION_OP_SET_STATE (op 2)       REQUIRES R_KS_WRITE
//     target_ptr[15:0] = session_id
//     op_arg[15:8] = new_state ordinal (0..3; SS_STATE_MAX exclusive)
//     op_arg[63:16] = 0                (padding; else KS_ERR_BAD_OP)
//     RETURN       = KS_OK | KS_ERR_BAD_SESSION | KS_ERR_BAD_OP
//     DELEGATE     = _shell_session_set_state(session_id, new_state).
//     The R127.M1 return codes translate as:
//       SS_OK            -> KS_OK
//       SS_ERR_BAD_ID    -> KS_ERR_BAD_SESSION
//       SS_ERR_BAD_STATE -> KS_ERR_BAD_OP
//       (anything else)  -> KS_ERR_BAD_SESSION (defensive)
//
//   SESSION_OP_READ_NAME (op 3)       REQUIRES R_KS_READ
//     target_ptr[15:0] = session_id
//     op_arg[63:8] = destination user virtual address (56 bits).
//                    User-half canonical addresses on x86_64 are at
//                    most 47 significant bits (bit 47 clear), so 56
//                    bits comfortably carries any valid ring-3 pointer
//                    AND leaves eight zero bits that the dispatcher's
//                    `op_arg = op_arg >> 8` recovers.
//     op_arg[7:0] = op ordinal (3)
//     RETURN       = KS_OK | KS_ERR_BAD_SESSION | KS_ERR_BAD_OP
//     GATE         = ss_row_in_use(session_id) AND out_ptr != 0.
//     Writes 64 bytes (eight u64) from [row_base + 48] (the name
//     field) to [out_ptr + 0..56]. The 64th byte is the trailing NUL
//     that _shell_session_create writes at mint time; the caller is
//     responsible for providing a 64-byte-aligned destination AT A
//     USER-WRITABLE ADDRESS. User-pointer safety (page fault on a
//     bad address) is deferred to the paging gate that lands with
//     the ring-3 syscall ABI around KIND_SHELL_SESSION in R128.
//     At M2 the handler assumes the caller is a supervisor-reach
//     task that passed in-kernel sanitation.
//
// Unknown op ordinal -> KS_ERR_BAD_OP.
// op_arg[63:16] non-zero on an op that reserves it -> KS_ERR_BAD_OP.
// op_arg[63:8] non-zero on an op that reserves it -> KS_ERR_BAD_OP.
//
// =============================================================================
// SECTION 6  RETURN CODE BAND  --  0x1110..0x111F
// =============================================================================
//
//   KS_OK                 = 0
//   KS_ERR_BAD_SESSION    = 0x1110  (bad target_ptr session_id OR row free)
//   KS_ERR_BAD_OP         = 0x1111  (bad op ordinal OR op_arg encoding
//                                    violation OR new_state out of range)
//   KS_ERR_RIGHTS         = 0x1112  (rights gate refused this op)
//
// Band audit at landing time (2026-10-13):
//   `grep -rnE "0x111[0-9A-F]\b" src/kernel/` -> zero hits.
// Clean band; R127.M3+ may extend the band to 0x1113..0x111F while
// retaining the first three as pinned.
//
// All three error codes fit imm32 with bit 31 clear so `mov rax,
// imm32` emits the 7-byte zero-extending form.
//
// =============================================================================
// SECTION 7  MINT HELPER  --  SUPERVISOR-REACH-ONLY
// =============================================================================
//
// `kind_shell_session_mint_body(shell_session_row_id, rights,
//                               out_slot_ptr) -> errno`
//
// The ONLY path to a KIND_SHELL_SESSION cap at M2. No cap-invoke op
// reaches it: a ring-3 holder of a KIND_SHELL_SESSION cap may DERIVE
// a narrowed child via svc.cap-minter (R125.M2) but may not mint a
// fresh cap from scratch. Supervisor paths that reach the mint helper
// are:
//
//   (i)  the R127.M1 daemon's _shell_session_init path (future wiring
//        may auto-mint one KIND_SHELL_SESSION per created row with
//        R_KS_ALL and hand the resulting slot id to the shell parent
//        task's cap-env; today the mint is called by the shell parent
//        itself at task-launch time).
//
//   (ii) a boot smoke harness that validates the mint path returns
//        a usable slot before the first cap_invoke dispatch.
//
// Reserved cap_table range: KIND_SHELL_SESSION mints land in
// [KS_SLOT_BASE, KS_SLOT_LIMIT) = [184, 192). Eight slots -- exactly
// SS_POOL_MAX -- so one mint per shell_session row AT MOST without
// churn. The reservation sits BELOW cap_minter's [192, 256) derived-
// cap range so a cap_minter DERIVE on a KIND_SHELL_SESSION parent
// lands a child in [192, 256) above the mint range. A slab allocator
// with lineage tracking (R128.M*+ Phase-3 rewrite) retires both
// reservations.
//
// Mint failure taxonomy:
//
//   KS_OK                 -- descriptor written, *out_slot_ptr set
//   KS_ERR_BAD_SESSION    -- shell_session_row_id out of range or
//                            row free (per ss_row_in_use)
//   KS_ERR_RIGHTS         -- rights not a subset of R_KS_ALL
//   KS_MINT_ENOSPC        -- [KS_SLOT_BASE, KS_SLOT_LIMIT) exhausted
//                            (adjacent to KS_ERR_RIGHTS; 0x1113)
//
// =============================================================================
// SECTION 8  ENCODER DISCIPLINE
// =============================================================================
//
// Kind tag 0x1A9 fits imm32 (no sign-extension; `mov r9, 0x1A9` emits
// the 7-byte form), but every compare still stages through r10/r11
// for parallel-wave uniformity with kind_dek / kind_kek. Stride 128
// (for shell_session row base compute) uses `shl rax, 7` -- no imul.
// Stride 24 (for cap_table slot address) uses (slot<<3)+(slot<<4),
// same shape as cmnt_find_free_cap_slot. No `test`, no `and r11,
// imm64`, no 2-op `imul r, imm`.
//
// Labels: pure leaves prefix `ks_`, nested-call frames prefix `ks_hn_`
// (handler), `ks_mi_` (mint), `ks_lu_` (op lookup), `ks_rs_`
// (read-state), `ks_ss_` (set-state), `ks_rn_` (read-name), `ks_in_`
// (init). The `ss_` prefix is reserved for shell_session.pdx leaves,
// so none of ours collide.
//
// Module basename match: `kind_shell_session.pdx` -> `KindShellSession`
// (case-folded, underscores dropped). The paideia-as encoder refuses
// a mismatched declaration (per feedback_pdx_encoder_pitfalls).
//
// =============================================================================
// SECTION 9  INTERACTION WITH R127.M1 AND R127.M3
// =============================================================================
//
// R127.M1 (svc.shell-session daemon):
//   * Direct-call API _shell_session_{create,lookup,set_state,destroy}
//     is UNCHANGED. In-kernel bringup paths continue to use it.
//   * ss_row_in_use / ss_row_base are the two load-bearing kernel
//     helpers this file reaches into.
//   * The 128-byte row layout at svc/shell_session.pdx §1 is the
//     authoritative source for field offsets; we re-cite SS_OFF_STATE
//     (40) and SS_OFF_NAME (48) rather than redeclare them.
//
// R127.M3 (shell lifecycle manager + history storage):
//   * Tightens the SS_STATE_* transition graph to INIT -> ACTIVE ->
//     (SUSPENDED | TERMINATED); SET_STATE op refuses an invalid
//     edge AS A CAP-INVOKE RESULT (KS_ERR_BAD_OP), not as a direct-
//     call error. The current M2 landing passes through whatever
//     R127.M1 returns, which at M1 is permissive (any state < 4).
//   * Introduces a history-anchor op (likely op 4 or 5, R_KS_READ
//     for READ_LAST_LINE / R_KS_WRITE for APPEND_LINE); the op band
//     [4, 15] is RESERVED here for M3.
//   * The reserved R_KS_LIFECYCLE right (0x004) gates a future
//     DESTROY op that unbinds the KIND_SHELL_SESSION cap AND the
//     underlying row (bypassing _shell_session_destroy's direct-
//     call-only posture).
//
// See design/shell/kind-session.md for the full cross-reference.
//
// =============================================================================

module KindShellSession = structure {

  // ==========================================================================
  // Kind identity (§1, §2).
  // ==========================================================================

  pub let KIND_SHELL_SESSION      : u64 = 0x1A9
  pub let KIND_SHELL_SESSION_BASE : u64 = 5          // = KIND_IPC_ENDPOINT

  // ==========================================================================
  // Rights (§4).
  // ==========================================================================

  pub let R_KS_READ      : u64 = 0x001
  pub let R_KS_WRITE     : u64 = 0x002
  pub let R_KS_LIFECYCLE : u64 = 0x004
  pub let R_KS_ALL       : u64 = 0x007

  // ==========================================================================
  // Ops (§5).
  // ==========================================================================

  pub let KS_OP_LOOKUP_BY_PID : u64 = 0
  pub let KS_OP_READ_STATE    : u64 = 1
  pub let KS_OP_SET_STATE     : u64 = 2
  pub let KS_OP_READ_NAME     : u64 = 3
  // R127.M3 (paideia-os #2599, Wave UMB-W14): raw-mode set.
  //   target_ptr[15:0] = session_id
  //   op_arg[7:0]  = KS_OP_SET_RAW (4)
  //   op_arg[15:8] = flags (SS_RAW_FLAG_*; valid in [0, 7])
  //   op_arg[63:16] must be zero (else KS_ERR_BAD_OP)
  //   Rights required: R_KS_LIFECYCLE
  pub let KS_OP_SET_RAW       : u64 = 4
  // R127.M4 (paideia-os #2600, Wave UMB-W15): history storage ops.
  //   target_ptr[15:0]  = session_id
  // APPEND (op 5): R_KS_WRITE
  //   target_ptr[63:16] = cmd_ptr  (48-bit user-half canonical)
  //   op_arg[7:0]       = KS_OP_HISTORY_APPEND (5)
  //   op_arg[63:8]      = cmd_len  (56 bits; 126-clamped by helper)
  // READ (op 6): R_KS_READ
  //   target_ptr[31:16] = index_from_head (16 bits)
  //   target_ptr[63:32] = out_cap          (32 bits)
  //   op_arg[7:0]       = KS_OP_HISTORY_READ (6)
  //   op_arg[63:8]      = out_ptr          (56 bits user-half canonical)
  // COUNT (op 7): R_KS_READ
  //   target_ptr[63:16] = 0 (reserved; non-zero -> KS_ERR_BAD_OP)
  //   op_arg[7:0]       = KS_OP_HISTORY_COUNT (7)
  //   op_arg[63:8]      = 0 (reserved; non-zero -> KS_ERR_BAD_OP)
  pub let KS_OP_HISTORY_APPEND : u64 = 5
  pub let KS_OP_HISTORY_READ   : u64 = 6
  pub let KS_OP_HISTORY_COUNT  : u64 = 7
  pub let KS_OP_MAX            : u64 = 7    // inclusive -- highest valid op

  // ==========================================================================
  // Return codes (§6, §7).
  // ==========================================================================

  pub let KS_OK              : u64 = 0
  pub let KS_ERR_BAD_SESSION : u64 = 0x1110
  pub let KS_ERR_BAD_OP      : u64 = 0x1111
  pub let KS_ERR_RIGHTS      : u64 = 0x1112
  pub let KS_MINT_ENOSPC     : u64 = 0x1113

  // ==========================================================================
  // Reserved cap_table range for the mint helper (§7).
  // ==========================================================================

  pub let KS_SLOT_BASE  : u64 = 184
  pub let KS_SLOT_LIMIT : u64 = 192
  pub let KS_SLOT_NONE  : u64 = 256   // sentinel >= CAP_SLOT_MAX

  // ==========================================================================
  // Target_ptr decoding masks.
  // ==========================================================================

  pub let KS_TGT_SID_MASK : u64 = 0xFFFF   // target_ptr[15:0] = session_id

  // ==========================================================================
  // Shell-session row-field offsets (mirrors svc/shell_session.pdx §1).
  // ==========================================================================

  pub let KS_ROW_OFF_STATE : u64 = 40
  pub let KS_ROW_OFF_NAME  : u64 = 48
  pub let KS_NAME_BYTES    : u64 = 64

  // ==========================================================================
  // Stats pool (§8 observability).
  // ==========================================================================

  // R127.M3 (paideia-os #2599, Wave UMB-W14): widened from [u64; 8]
  // to [u64; 16] to carry KS_ST_SET_RAW_OK = 8. The ks_note bounds
  // check is bumped to 16 to match. Slots [9..15] are reserved for
  // R127.M4+ follow-on ops (history anchor, DESTROY op, etc.).
  pub let mut _ks_stats : [u64; 16] = uninit @align(64)

  pub let KS_ST_INIT_OK        : u64 = 0
  pub let KS_ST_LOOKUP_OK      : u64 = 1
  pub let KS_ST_LOOKUP_MISS    : u64 = 2
  pub let KS_ST_READ_STATE_OK  : u64 = 3
  pub let KS_ST_SET_STATE_OK   : u64 = 4
  pub let KS_ST_READ_NAME_OK   : u64 = 5
  pub let KS_ST_REFUSED        : u64 = 6
  pub let KS_ST_MINTS          : u64 = 7
  pub let KS_ST_SET_RAW_OK     : u64 = 8     // R127.M3
  pub let KS_ST_HISTORY_APPEND_OK : u64 = 9  // R127.M4
  pub let KS_ST_HISTORY_READ_OK   : u64 = 10 // R127.M4
  pub let KS_ST_HISTORY_COUNT_OK  : u64 = 11 // R127.M4

  // ==========================================================================
  // Fingerprint tags (N = len(string) + 1, NUL inclusive). Only the
  // "OK" tags trip the fingerprint-coverage gate; REJ tags are opaque.
  // ==========================================================================

  // "KIND_SHELL_SESSION INIT OK"      = 26, +NUL => N=27
  // "KIND_SHELL_SESSION HANDLER OK"   = 29, +NUL => N=30
  // "KIND_SHELL_SESSION HANDLER REJ"  = 30, +NUL => N=31
  // "KIND_SHELL_SESSION MINT OK"      = 26, +NUL => N=27
  // "KIND_SHELL_SESSION MINT REJ"     = 27, +NUL => N=28

  pub let ks_tag_init_ok    : [u8; 27] = "KIND_SHELL_SESSION INIT OK\0"
  pub let ks_tag_handler_ok : [u8; 30] = "KIND_SHELL_SESSION HANDLER OK\0"
  pub let ks_tag_handler_rej: [u8; 31] = "KIND_SHELL_SESSION HANDLER REJ\0"
  pub let ks_tag_mint_ok    : [u8; 27] = "KIND_SHELL_SESSION MINT OK\0"
  pub let ks_tag_mint_rej   : [u8; 28] = "KIND_SHELL_SESSION MINT REJ\0"

  pub let ks_k_sid    : [u8; 4] = "sid\0"
  pub let ks_k_op     : [u8; 3] = "op\0"
  pub let ks_k_slot   : [u8; 5] = "slot\0"
  pub let ks_k_errno  : [u8; 6] = "errno\0"

  // ==========================================================================
  // ks_note(slot) -> ()
  //
  // Bounded increment on _ks_stats[slot < 8]. Load-inc-store idiom
  // (no `add reg, [mem]`). Pure leaf -- no pushes.
  // ==========================================================================
  pub let ks_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R127.M2 (paideia-os #2598) + R127.M3 (paideia-os #2599): bounded increment on _ks_stats[which<16]. Bounds bumped from 8 to 16 at R127.M3 landing to admit KS_ST_SET_RAW_OK=8 without widening ks_note's signature. Pure leaf -- no pushes. Labels prefixed ks_nt_.",
      block: {
        cmp rdi, 16;
        jae ks_nt_out;
        lea r10, [rip + _ks_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ks_nt_out:
        ret
      }
    }

  // ==========================================================================
  // ks_rights_valid(rights) -> 1 iff rights subset of R_KS_ALL.
  //
  // AND-and-compare avoids the paideia-as `not reg` encoder gap.
  // ==========================================================================
  pub let ks_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R127.M2 (paideia-os #2598): subset test against R_KS_ALL = 0x007. Labels prefixed ks_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x007;                  // R_KS_ALL
        and rax, r10;
        cmp rax, rdi;
        jne ks_rv_no;
        mov rax, 1;
        ret;
      ks_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // kind_shell_session_init() -> ()
  //
  // Boot hook. .bss already starts zero at real boot; defensive scrub
  // of _ks_stats (eight u64 words) matches kind_dek_init one-for-one.
  // No endpoint claim (KIND_SHELL_SESSION is cap-invoke-dispatched,
  // not endpoint-published).
  //
  // One callee-save push (r12) to correct entry parity rsp%16==8 ->
  // 0 for the sibling (non-nested) klog_s1 emit.
  // ==========================================================================
  pub let kind_shell_session_init : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M2 (paideia-os #2598): boot-time scrub of _ks_stats (8 u64 = 64 bytes) + one INIT OK fingerprint. .bss zero-init handles the array at real boot; the explicit scrub is defensive for a chaos-restart re-entering init. Single callee-save push (r12) corrects entry parity rsp%16==8 -> 0 for the sibling klog_s1 call. Labels prefixed ks_in_.",
      block: {
        push r12;

        lea r10, [rip + _ks_stats];
        xor rax, rax;
        xor rcx, rcx;
      ks_in_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;                     // R127.M3: pool widened to 16
        jb  ks_in_stats;

        // Bump INIT_OK counter.
        mov rdi, 0;                      // KS_ST_INIT_OK
        call ks_note;

        // Emit INIT OK fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ks_tag_init_ok];
        call klog_s1;

        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ks_decode_sid(target_ptr) -> session_id (bits [15:0])
  //
  // Pure address-compute leaf. The high 48 bits of target_ptr are
  // reserved for a future generation counter and are IGNORED here;
  // M3's tightened validation lands in a separate helper.
  // ==========================================================================
  pub let ks_decode_sid : (u64) -> u64 !{} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R127.M2 (paideia-os #2598): target_ptr[15:0] = session_id. Pure leaf. Labels prefixed ks_de_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFF;                 // KS_TGT_SID_MASK
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // ks_op_lookup_by_pid(target_ptr, op_arg) -> session_id | KS_ERR_BAD_SESSION
  //
  // target_ptr IS the pid search key (full 64 bits).
  // op_arg[63:8] MUST be zero (payload reserved); caller already
  // checked this before dispatching here.
  //
  // Delegates to _shell_session_lookup. The SS_ID_NONE sentinel
  // (0xFF) is translated to KS_ERR_BAD_SESSION; a real session_id in
  // [0, 8) passes through.
  //
  // Two callee-save pushes (rbx = pid, r12 = scratch across note)
  // land rsp%16==0 at every nested call.
  // ==========================================================================
  pub let ks_op_lookup_by_pid : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M2 (paideia-os #2598): delegate to _shell_session_lookup(pid). target_ptr IS the pid (full u64); op_arg[63:8] already validated zero by caller. SS_ID_NONE (0xFF) -> KS_ERR_BAD_SESSION; real session_id (0..7) passes through. Two callee-save pushes (rbx=target_ptr=pid, r12=returned sid) + sub rsp,8 pad land rsp%16==0 at every nested call. Labels prefixed ks_lu_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // pid

        // Delegate to R127.M1 lookup.
        mov rdi, rbx;
        call _shell_session_lookup;
        mov r12, rax;                    // returned session_id or 0xFF

        // Translate SS_ID_NONE -> KS_ERR_BAD_SESSION.
        mov r10, 0xFF;                   // SS_ID_NONE
        cmp r12, r10;
        je  ks_lu_miss;

        // Hit: bump stat, return session_id.
        mov rdi, 1;                      // KS_ST_LOOKUP_OK
        call ks_note;
        mov rax, r12;
        jmp ks_lu_out;

      ks_lu_miss:
        mov rdi, 2;                      // KS_ST_LOOKUP_MISS
        call ks_note;
        mov rax, 0x1110;                 // KS_ERR_BAD_SESSION

      ks_lu_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ks_op_read_state(session_id) -> state (0..3) | KS_ERR_BAD_SESSION
  //
  // Gate: ss_row_in_use(session_id). On live row, read
  // [row_base + 40][31:0] -- the state field. State lives in the low
  // 32 bits of a u64 whose high 32 are the reserved generation
  // counter; a plain `mov rax, [row + 40]` followed by zero-extending
  // the low 32 via a 0xFFFFFFFF mask is the simplest form.
  //
  // Two callee-save pushes (rbx = session_id, r12 = scratch) land
  // rsp%16==0 at every nested call.
  // ==========================================================================
  pub let ks_op_read_state : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M2 (paideia-os #2598): ss_row_in_use gate; on live row read state via [row_base + 40] masked to low 32 bits. Two callee-save pushes (rbx=session_id, r12=state) + sub rsp,8 pad land rsp%16==0 at every nested call. Labels prefixed ks_rs_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // session_id

        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  ks_rs_bad;

        // Compute row base: pool + sid * 128.
        mov rax, rbx;
        shl rax, 7;                      // sid * 128
        lea r10, [rip + _shell_session_pool];
        add rax, r10;                    // row base

        // State is in low 32 bits of [row + 40].
        mov r12, [rax + 40];
        mov r10, 0xFFFFFFFF;
        and r12, r10;                    // zero-extend low 32 -> r12

        mov rdi, 3;                      // KS_ST_READ_STATE_OK
        call ks_note;

        mov rax, r12;
        jmp ks_rs_out;

      ks_rs_bad:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1110;                 // KS_ERR_BAD_SESSION

      ks_rs_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ks_op_set_state(session_id, new_state) -> KS_OK | KS_ERR_*
