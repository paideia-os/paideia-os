        mov r12, rsi;                    // new_state

        mov rdi, rbx;
        mov rsi, r12;
        call _shell_session_set_state;
        // rax = SS_OK (0), SS_ERR_BAD_ID (0x1102), SS_ERR_BAD_STATE (0x1104), ...

        cmp rax, 0;
        je  ks_ss_ok;

        mov r10, 0x1102;                 // SS_ERR_BAD_ID
        cmp rax, r10;
        je  ks_ss_bad_session;

        mov r10, 0x1104;                 // SS_ERR_BAD_STATE
        cmp rax, r10;
        je  ks_ss_bad_op;

        // Defensive fallback.
        jmp ks_ss_bad_session;

      ks_ss_ok:
        mov rdi, 4;                      // KS_ST_SET_STATE_OK
        call ks_note;
        xor rax, rax;                    // KS_OK
        jmp ks_ss_out;

      ks_ss_bad_session:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1110;                 // KS_ERR_BAD_SESSION
        jmp ks_ss_out;

      ks_ss_bad_op:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1111;                 // KS_ERR_BAD_OP

      ks_ss_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ks_op_read_name(session_id, out_ptr) -> KS_OK | KS_ERR_BAD_SESSION
  //
  // Copies 64 bytes (eight u64 words) from [row_base + 48] (the name
  // field, including the trailing NUL at offset 63) to [out_ptr + 0..56].
  //
  // Pointer-safety posture at M2: out_ptr != 0 is the only check.
  // A ring-3 caller passes a user-virtual address via op_arg[63:8];
  // the dispatcher has already shifted op_arg right by 8 so bits
  // [55:0] of the resulting 56-bit value fit in op_arg. User-half
  // canonical addresses are at most 47 significant bits so the shift
  // never truncates a valid pointer. Page-fault safety (what happens
  // if the page is unmapped) is deferred to the ring-3 syscall gate
  // that lands with R128's KIND_SHELL_SESSION user ABI.
  //
  // Three callee-save pushes (rbx = sid, r12 = out_ptr, r13 = scratch
  // for the row base) + sub rsp,8 pad land rsp%16==0 at every nested
  // call. The copy itself is in-flight assembly (eight paired
  // loads+stores), no nested call.
  // ==========================================================================
  pub let ks_op_read_name : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) (out_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M2 (paideia-os #2598): copy 64-byte name field from [row_base + 48] (eight u64 words) to [out_ptr + 0..56]. ss_row_in_use gate + out_ptr != 0 gate. Three callee-save pushes (rbx=session_id, r12=out_ptr, r13=row_base) + sub rsp,8 pad = 32 bytes land rsp%16==0 at every nested call. Loads use [rax + N] / stores use [r12 + N] immediate-displacement forms (no 2-op `imul r, imm`, no `and r11, imm64`). Pointer safety at M2 is restricted to out_ptr != 0; page-fault safety lands with R128's ring-3 syscall gate. Labels prefixed ks_rn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                    // session_id
        mov r12, rsi;                    // out_ptr

        // Gate 1: out_ptr != 0.
        cmp r12, 0;
        je  ks_rn_bad;

        // Gate 2: row in use.
        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  ks_rn_bad;

        // Compute row base: pool + sid * 128.
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _shell_session_pool];
        add rax, r10;                    // rax = row base
        mov r13, rax;                    // park row base in r13

        // 8 x u64 copy from [row_base + 48 + N*8] to [out_ptr + N*8].
        // Writes include the trailing NUL at byte 63 that
        // _shell_session_create guarantees.
        mov rax, [r13 + 48];
        mov [r12 + 0],  rax;
        mov rax, [r13 + 56];
        mov [r12 + 8],  rax;
        mov rax, [r13 + 64];
        mov [r12 + 16], rax;
        mov rax, [r13 + 72];
        mov [r12 + 24], rax;
        mov rax, [r13 + 80];
        mov [r12 + 32], rax;
        mov rax, [r13 + 88];
        mov [r12 + 40], rax;
        mov rax, [r13 + 96];
        mov [r12 + 48], rax;
        mov rax, [r13 + 104];
        mov [r12 + 56], rax;

        mov rdi, 5;                      // KS_ST_READ_NAME_OK
        call ks_note;

        xor rax, rax;                    // KS_OK
        jmp ks_rn_out;

      ks_rn_bad:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1110;                 // KS_ERR_BAD_SESSION

      ks_rn_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ks_op_set_raw(session_id, flags) -> KS_OK | KS_ERR_*
