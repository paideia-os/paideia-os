        je  ks_sr_bad_session;

        mov r10, 0x1105;                 // SS_RAW_ERR_BAD_FLAGS
        cmp rax, r10;
        je  ks_sr_bad_op;

        // Defensive fallback.
        jmp ks_sr_bad_session;

      ks_sr_ok:
        mov rdi, 8;                      // KS_ST_SET_RAW_OK
        call ks_note;
        xor rax, rax;                    // KS_OK
        jmp ks_sr_out;

      ks_sr_bad_session:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1110;                 // KS_ERR_BAD_SESSION
        jmp ks_sr_out;

      ks_sr_bad_op:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1111;                 // KS_ERR_BAD_OP

      ks_sr_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
