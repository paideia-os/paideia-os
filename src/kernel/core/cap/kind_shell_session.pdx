  pub let ks_op_set_state : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) (new_state: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M2 (paideia-os #2598): translate R127.M1's _shell_session_set_state return band to the KS_* band. SS_OK -> KS_OK; SS_ERR_BAD_ID (0x1102) -> KS_ERR_BAD_SESSION (0x1110); SS_ERR_BAD_STATE (0x1104) -> KS_ERR_BAD_OP (0x1111); other non-zero -> KS_ERR_BAD_SESSION defensively. Two callee-save pushes (rbx=session_id, r12=new_state) + sub rsp,8 pad land rsp%16==0 at every nested call. Labels prefixed ks_ss_.",
      block: {
