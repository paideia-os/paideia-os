  // ==========================================================================
  // ks_op_history_read(session_id, index_from_head, out_ptr, out_cap)
  //                                                   -> packed u64 | KS_ERR_*
  //
  // R127.M4 (paideia-os #2600, Wave UMB-W15).
  //
  // Delegates to _shell_history_read(sid, index, out_ptr, out_cap).
  // On success the helper returns a packed u64 (len << 32); the
  // low 32 bits are zero so we distinguish success by masking those
  // low 32 bits (shift-anchor idiom, avoiding the `and r11, imm64`
  // encoder gap) and comparing to zero. On error the low 32 bits
  // carry an SH_ERR_* code.
  //
  //   SH_OK (packed, low 32 == 0)     -> pass through rax unchanged
  //   SH_ERR_BAD_SESSION (0x1102)     -> KS_ERR_BAD_SESSION (0x1110)
  //   SH_ERR_EMPTY (0x1107)           -> KS_ERR_BAD_OP      (0x1111)
  //   SH_ERR_OUT_TOO_SMALL (0x1106)   -> KS_ERR_BAD_OP      (0x1111)
  //   (other non-zero low 32)         -> KS_ERR_BAD_SESSION (defensive)
  //
  // Five callee-save pushes (rbx=sid, r12=index, r13=out_ptr,
  // r14=out_cap, r15=packed_return) + sub rsp,8 pad = 48 bytes land
  // rsp%16==0 at every nested call.
  //
  // Labels prefixed ks_hr_.
  // ==========================================================================
  pub let ks_op_history_read : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) (index_from_head: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M4 (paideia-os #2600): translate _shell_history_read's packed return to the KS_* band. On success rax carries (len << 32) | SH_OK and the low 32 bits are zero -- pass through unchanged. On error the low 32 bits carry SH_ERR_*; translate SH_ERR_BAD_SESSION (0x1102) -> KS_ERR_BAD_SESSION (0x1110), SH_ERR_EMPTY (0x1107) / SH_ERR_OUT_TOO_SMALL (0x1106) -> KS_ERR_BAD_OP (0x1111), other -> KS_ERR_BAD_SESSION defensively. Isolate low 32 via shift-anchor (shl 32, shr 32) rather than `and r11, imm64` to avoid the encoder gap. Bumps KS_ST_HISTORY_READ_OK (slot 10) on success / KS_ST_REFUSED (slot 6) on error. Five callee-save pushes (rbx=sid, r12=index, r13=out_ptr, r14=out_cap, r15=packed_return) + sub rsp,8 pad = 48 bytes land rsp%16==0 at every nested call. Labels prefixed ks_hr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                    // session_id
        mov r12, rsi;                    // index_from_head
        mov r13, rdx;                    // out_ptr
        mov r14, rcx;                    // out_cap

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        call _shell_history_read;
        mov r15, rax;                    // r15 = packed return

        // Isolate low 32 bits via shift-anchor to avoid `and r11, imm64`.
        mov r11, r15;
        shl r11, 32;
        shr r11, 32;                     // r11 = low 32 of packed

        cmp r11, 0;
        je  ks_hr_ok;

        mov r10, 0x1102;                 // SH_ERR_BAD_SESSION
        cmp r11, r10;
        je  ks_hr_bad_session;

        mov r10, 0x1107;                 // SH_ERR_EMPTY
        cmp r11, r10;
        je  ks_hr_bad_op;

        mov r10, 0x1106;                 // SH_ERR_OUT_TOO_SMALL
        cmp r11, r10;
        je  ks_hr_bad_op;

        // Defensive fallback.
        jmp ks_hr_bad_session;

      ks_hr_ok:
        mov rdi, 10;                     // KS_ST_HISTORY_READ_OK
        call ks_note;
        mov rax, r15;                    // pass packed return through
        jmp ks_hr_out;

      ks_hr_bad_session:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1110;                 // KS_ERR_BAD_SESSION
        jmp ks_hr_out;

      ks_hr_bad_op:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1111;                 // KS_ERR_BAD_OP

      ks_hr_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ks_op_history_count(session_id) -> count
  //
  // R127.M4 (paideia-os #2600, Wave UMB-W15).
  //
  // Delegates to _shell_history_count(sid). The helper returns 0 on a
  // bad session_id, so there is no error band to translate; pass the
  // count through unchanged.
  //
  // Two callee-save pushes (rbx = sid, r12 = count) + sub rsp,8 pad
  // = 24 bytes, land rsp%16==0 at every nested call.
  //
  // Labels prefixed ks_hc_.
  // ==========================================================================
  pub let ks_op_history_count : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M4 (paideia-os #2600): pure read; delegate to _shell_history_count(session_id) and pass the count through unchanged. The helper returns 0 on bad session_id (there is no error band). Bumps KS_ST_HISTORY_COUNT_OK (slot 11) on every call for observability. Two callee-save pushes (rbx=sid, r12=count) + sub rsp,8 pad = 24 bytes land rsp%16==0 at every nested call. Labels prefixed ks_hc_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // session_id

        mov rdi, rbx;
        call _shell_history_count;
        mov r12, rax;                    // count

        mov rdi, 11;                     // KS_ST_HISTORY_COUNT_OK
        call ks_note;

        mov rax, r12;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_shell_session(rights, target_ptr, op_arg) -> u64
  //
  // The cap_invoke dispatcher's KIND_SHELL_SESSION arm (invoke.pdx
  // call_kind_shell_session) tail-calls here. Signature matches the
  // 3-arg KIND_DEK / KIND_TLS_TRUST / KIND_SIG_KEY precedent.
  //
  // Dispatch strategy:
  //   1. Decode op = op_arg[7:0].
  //   2. Rights gate per op (R_KS_READ for ops 0/1/3; R_KS_WRITE for op 2).
  //   3. Per-op payload decoding (encoding rules in §5):
  //       op 0 (LOOKUP_BY_PID): op_arg[63:8] must be zero.
  //       op 1 (READ_STATE):    op_arg[63:8] must be zero; sid from
  //                             target_ptr[15:0].
  //       op 2 (SET_STATE):     op_arg[63:16] must be zero; new_state =
  //                             op_arg[15:8]; sid from target_ptr[15:0].
  //       op 3 (READ_NAME):     out_ptr = op_arg[63:8]; sid from
  //                             target_ptr[15:0].
  //   4. Delegate to the per-op helper above.
  //
  // Three callee-save pushes (rbx = rights, r12 = target_ptr, r13 =
  // op_arg) leave rsp%16==0 at every nested call (entry rsp%16==8;
  // -24 -> 0).
  // ==========================================================================
  pub let cap_handler_shell_session : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M2 (paideia-os #2598): KIND_SHELL_SESSION ops dispatch. op = op_arg[7:0]; per-op decode of target_ptr + op_arg[63:8]. Rights gates: R_KS_READ for ops 0/1/3; R_KS_WRITE for op 2. Three callee-save pushes (rbx=rights, r12=target_ptr, r13=op_arg) leave rsp%16==0 at every nested call. op_arg[63:16] / [63:8] padding checks refuse smuggled payload (same posture as cap_handler_dek). Effects/capabilities widened to {mem,sysreg}/{cap} because ks_op_set_state transitively reaches klog via _shell_session_set_state (SysV: effect-widening discipline per this tree). Labels prefixed ks_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;                    // target_ptr
        mov r13, rdx;                    // op_arg

        // Decode op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        // r10 = op; keep in r10 for the dispatch ladder below.

        // Op bounds check. R127.M3 bumped KS_OP_MAX from 3 to 4 for
        // KS_OP_SET_RAW; R127.M4 bumps 4 -> 7 for KS_OP_HISTORY_*.
        // `ja` admits r10 in [0, 7] inclusive.
        mov r11, 7;                      // KS_OP_MAX
        cmp r10, r11;
        ja  ks_hn_bad_op;

        // Dispatch ladder.
        cmp r10, 0;
        je  ks_hn_op_lookup;
        cmp r10, 1;
        je  ks_hn_op_read_state;
        cmp r10, 2;
        je  ks_hn_op_set_state;
        cmp r10, 3;
        je  ks_hn_op_read_name;
        cmp r10, 4;
        je  ks_hn_op_set_raw;
        cmp r10, 5;
        je  ks_hn_op_history_append;
        cmp r10, 6;
        je  ks_hn_op_history_read;
        cmp r10, 7;
        je  ks_hn_op_history_count;
        jmp ks_hn_bad_op;                // unreachable (bounds check above)

      ks_hn_op_lookup:
        // Rights gate: R_KS_READ.
        mov r10, rbx;
        and r10, 0x001;
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne ks_hn_bad_op;

        // Delegate: ks_op_lookup_by_pid(target_ptr=pid, op_arg).
        mov rdi, r12;                    // pid = target_ptr
        mov rsi, r13;                    // op_arg (unused inside helper)
        call ks_op_lookup_by_pid;
        jmp ks_hn_fp_ok;

      ks_hn_op_read_state:
        // Rights gate: R_KS_READ.
        mov r10, rbx;
        and r10, 0x001;
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne ks_hn_bad_op;

        // Decode sid = target_ptr[15:0].
        mov rdi, r12;
        call ks_decode_sid;

        // Delegate: ks_op_read_state(sid).
        mov rdi, rax;
        call ks_op_read_state;
        jmp ks_hn_fp_ok;

      ks_hn_op_set_state:
        // Rights gate: R_KS_WRITE.
        mov r10, rbx;
        and r10, 0x002;
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // op_arg[63:16] must be zero.
        mov r10, r13;
        shr r10, 16;
        cmp r10, 0;
        jne ks_hn_bad_op;

        // Decode sid = target_ptr[15:0].
        mov rdi, r12;
        call ks_decode_sid;
        mov r11, rax;                    // r11 = sid

        // Decode new_state = op_arg[15:8].
        mov r10, r13;
        shr r10, 8;
        and r10, 0xFF;                   // r10 = new_state

        // Delegate: ks_op_set_state(sid, new_state).
        mov rdi, r11;
        mov rsi, r10;
        call ks_op_set_state;
        jmp ks_hn_fp_ok;

      ks_hn_op_read_name:
        // Rights gate: R_KS_READ.
        mov r10, rbx;
        and r10, 0x001;
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // Decode sid = target_ptr[15:0].
        mov rdi, r12;
        call ks_decode_sid;
        mov r11, rax;                    // r11 = sid

        // Decode out_ptr = op_arg >> 8 (56-bit canonical user address).
        mov r10, r13;
        shr r10, 8;                      // r10 = out_ptr

        // Delegate: ks_op_read_name(sid, out_ptr).
        mov rdi, r11;
        mov rsi, r10;
        call ks_op_read_name;
        jmp ks_hn_fp_ok;

      ks_hn_op_set_raw:
        // R127.M3 (paideia-os #2599): raw-mode set. Rights gate =
        // R_KS_LIFECYCLE (session-wide policy flip; same class as a
        // future DESTROY op). target_ptr[15:0] = session_id;
        // op_arg[15:8] = flags; op_arg[63:16] must be zero.
        mov r10, rbx;
        and r10, 0x004;                  // R_KS_LIFECYCLE
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // op_arg[63:16] must be zero (no smuggled payload).
        mov r10, r13;
        shr r10, 16;
        cmp r10, 0;
        jne ks_hn_bad_op;

        // Decode sid = target_ptr[15:0].
        mov rdi, r12;
        call ks_decode_sid;
        mov r11, rax;                    // r11 = sid

        // Decode flags = op_arg[15:8].
        mov r10, r13;
        shr r10, 8;
        and r10, 0xFF;                   // r10 = flags

        // Delegate: ks_op_set_raw(sid, flags).
        mov rdi, r11;
        mov rsi, r10;
        call ks_op_set_raw;
        jmp ks_hn_fp_ok;

      ks_hn_op_history_append:
        // R127.M4 (paideia-os #2600): APPEND. Rights = R_KS_WRITE.
        //   target_ptr[15:0]  = session_id
        //   target_ptr[63:16] = cmd_ptr   (48-bit user-half canonical)
        //   op_arg[7:0]       = KS_OP_HISTORY_APPEND (5)
        //   op_arg[63:8]      = cmd_len  (56 bits; 126-clamped by helper)
        mov r10, rbx;
        and r10, 0x002;                  // R_KS_WRITE
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // Decode sid = target_ptr[15:0].
        mov rdi, r12;
        call ks_decode_sid;
        mov r11, rax;                    // r11 = sid

        // Decode cmd_ptr = target_ptr >> 16 (48-bit user canonical).
        mov r10, r12;
        shr r10, 16;                     // r10 = cmd_ptr

        // Decode cmd_len = op_arg >> 8 (56 bits).
        mov r9, r13;
        shr r9, 8;                       // r9 = cmd_len

        // Delegate: ks_op_history_append(sid, cmd_ptr, cmd_len).
        mov rdi, r11;
        mov rsi, r10;
        mov rdx, r9;
        call ks_op_history_append;
        jmp ks_hn_fp_ok;

      ks_hn_op_history_read:
        // R127.M4 (paideia-os #2600): READ. Rights = R_KS_READ.
        //   target_ptr[15:0]  = session_id
        //   target_ptr[31:16] = index_from_head (16 bits)
        //   target_ptr[63:32] = out_cap          (32 bits)
        //   op_arg[7:0]       = KS_OP_HISTORY_READ (6)
        //   op_arg[63:8]      = out_ptr          (56 bits user-half canonical)
        mov r10, rbx;
        and r10, 0x001;                  // R_KS_READ
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // Decode sid = target_ptr[15:0].
        mov rdi, r12;
        call ks_decode_sid;
        mov r11, rax;                    // r11 = sid

        // Decode index_from_head = (target_ptr >> 16) & 0xFFFF.
        mov r10, r12;
        shr r10, 16;
        mov r9,  0xFFFF;
        and r10, r9;                     // r10 = index_from_head

        // Decode out_cap = target_ptr >> 32 (32 bits).
        mov r9, r12;
        shr r9, 32;                      // r9 = out_cap

        // Decode out_ptr = op_arg >> 8 (56 bits user canonical).
        // r8 is caller-save and free here.
        mov r8, r13;
        shr r8, 8;                       // r8 = out_ptr

        // Delegate: ks_op_history_read(sid, index, out_ptr, out_cap).
        mov rdi, r11;                    // sid
        mov rsi, r10;                    // index
        mov rdx, r8;                     // out_ptr
        mov rcx, r9;                     // out_cap
        call ks_op_history_read;
        jmp ks_hn_fp_ok;

      ks_hn_op_history_count:
        // R127.M4 (paideia-os #2600): COUNT. Rights = R_KS_READ.
        //   target_ptr[15:0]  = session_id
        //   target_ptr[63:16] = 0  (reserved; non-zero -> KS_ERR_BAD_OP)
        //   op_arg[7:0]       = KS_OP_HISTORY_COUNT (7)
        //   op_arg[63:8]      = 0  (reserved; non-zero -> KS_ERR_BAD_OP)
        mov r10, rbx;
        and r10, 0x001;                  // R_KS_READ
        cmp r10, 0;
        je  ks_hn_bad_rights;

        // target_ptr[63:16] must be zero (no smuggled payload).
        mov r10, r12;
        shr r10, 16;
        cmp r10, 0;
        jne ks_hn_bad_op;

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne ks_hn_bad_op;

        // Decode sid = target_ptr[15:0]; delegate.
        mov rdi, r12;
        call ks_decode_sid;

        mov rdi, rax;
        call ks_op_history_count;
        jmp ks_hn_fp_ok;

      ks_hn_fp_ok:
        // Return the per-op helper's return value in rax -- passthrough.
        jmp ks_hn_out;

      ks_hn_bad_op:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1111;                 // KS_ERR_BAD_OP
        jmp ks_hn_out;

      ks_hn_bad_rights:
        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;
        mov rax, 0x1112;                 // KS_ERR_RIGHTS

      ks_hn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ks_find_free_cap_slot() -> slot | KS_SLOT_NONE
  //
  // Scan [KS_SLOT_BASE=184, KS_SLOT_LIMIT=192) of cap_table for the
  // first slot whose kind field (at [cap_table + slot*24 + 0]) is zero.
  // Returns slot (184..191) or 256 as the sentinel.
  //
  // Stride 24 = (slot<<3) + (slot<<4) composes in two shifts (no 2-op
  // `imul r, imm`). Pure leaf -- no pushes.
  // ==========================================================================
  pub let ks_find_free_cap_slot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R127.M2 (paideia-os #2598): scan cap_table slots [KS_SLOT_BASE=184, KS_SLOT_LIMIT=192) for the first slot whose kind field is zero. Stride 24 composed as (slot<<3)+(slot<<4). Pure leaf -- no pushes. Labels prefixed ks_fs_.",
      block: {
        lea r10, [rip + cap_table];
        mov rcx, 184;                    // KS_SLOT_BASE

      ks_fs_scan:
        mov r11, 192;                    // KS_SLOT_LIMIT
        cmp rcx, r11;
        jae ks_fs_none;

        // Compute slot * 24.
        mov rax, rcx;
        shl rax, 3;                      // slot * 8
        mov r11, rcx;
        shl r11, 4;                      // slot * 16
        add rax, r11;                    // slot * 24
        add rax, r10;                    // &cap_table[slot]

        mov r11, [rax + 0];              // kind
        cmp r11, 0;
        je  ks_fs_hit;

        add rcx, 1;
        jmp ks_fs_scan;

      ks_fs_hit:
        mov rax, rcx;
        ret;

      ks_fs_none:
        mov rax, 256;                    // KS_SLOT_NONE
        ret
      }
    }

  // ==========================================================================
  // kind_shell_session_mint_body(shell_session_row_id, rights,
  //                              out_slot_ptr) -> errno
  //
  // Supervisor-only mint. No cap-invoke op reaches this (§7). The
  // kernel-side bringup path or a boot smoke harness calls here with
  // a live shell_session row id, a rights subset of R_KS_ALL, and a
  // pointer to a u64 that will receive the allocated cap_table slot
  // id.
  //
  // Gate order:
  //   (1) ss_row_in_use(shell_session_row_id)   -> else KS_ERR_BAD_SESSION
  //   (2) ks_rights_valid(rights)               -> else KS_ERR_RIGHTS
  //   (3) ks_find_free_cap_slot()               -> else KS_MINT_ENOSPC
  //   (4) cap_mint_write(slot, KIND_SHELL_SESSION, rights,
  //                      shell_session_row_id)
  //   (5) [out_slot_ptr] = slot
  //   (6) emit `KIND_SHELL_SESSION MINT OK sid=<hex>`
  //   (7) bump KS_ST_MINTS; return KS_OK
  //
  // Four callee-save pushes (rbx = row_id, r12 = rights, r13 = out_slot_ptr,
  // r14 = allocated slot) + sub rsp,8 pad = 40 bytes, land rsp%16==0
  // at every nested call.
  // ==========================================================================
  pub let kind_shell_session_mint_body : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (shell_session_row_id: u64) (rights: u64) (out_slot_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R127.M2 (paideia-os #2598): supervisor-only mint of KIND_SHELL_SESSION. Gates in order: ss_row_in_use (KS_ERR_BAD_SESSION), ks_rights_valid subset of R_KS_ALL (KS_ERR_RIGHTS), ks_find_free_cap_slot [184,192) (KS_MINT_ENOSPC). On success calls cap_mint_write(slot, KIND_SHELL_SESSION=0x1A9, rights, shell_session_row_id) and writes slot to [out_slot_ptr]. Four callee-save pushes (rbx=row_id, r12=rights, r13=out_slot_ptr, r14=slot) + sub rsp,8 pad = 40 bytes land rsp%16==0 at every nested call. On every refuse funnel bumps KS_ST_REFUSED and emits MINT REJ fingerprint; on success bumps KS_ST_MINTS and emits MINT OK fingerprint. Labels prefixed ks_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                    // shell_session_row_id
        mov r12, rsi;                    // rights
        mov r13, rdx;                    // out_slot_ptr

        // (1) ss_row_in_use gate.
        mov rdi, rbx;
        call ss_row_in_use;
        cmp rax, 0;
        je  ks_mi_bad_session;

        // (2) rights gate.
        mov rdi, r12;
        call ks_rights_valid;
        cmp rax, 0;
        je  ks_mi_bad_rights;

        // (3) find a free cap_table slot in [184, 192).
        call ks_find_free_cap_slot;
        mov r10, 256;                    // KS_SLOT_NONE
        cmp rax, r10;
        jae ks_mi_enospc;
        mov r14, rax;                    // park allocated slot

        // (4) cap_mint_write(slot=r14, kind=KIND_SHELL_SESSION,
        //                    rights=r12, target_ptr=row_id=rbx).
        mov rdi, r14;                    // slot
        mov rsi, 0x1A9;                  // KIND_SHELL_SESSION
        mov rdx, r12;                    // rights
        mov rcx, rbx;                    // target_ptr (row_id, low 16 bits
                                         //  used, high bits zero at mint)
        call cap_mint_write;

        // (5) *out_slot_ptr = slot.
        mov [r13 + 0], r14;

        // (6) fingerprint `KIND_SHELL_SESSION MINT OK sid=<hex>`.
        //     sid is the shell_session_row_id (not the cap slot); the
        //     slot is observable via the stats counter + the subsequent
        //     cap_table scan.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ks_tag_mint_ok];
        lea rcx, [rip + ks_k_sid];
        mov r8,  rbx;                    // v_hex = row_id
        call klog_s1_x1;

        // (7) bump KS_ST_MINTS; return KS_OK.
        mov rdi, 7;                      // KS_ST_MINTS
        call ks_note;
        xor rax, rax;                    // KS_OK
        jmp ks_mi_out;

      ks_mi_bad_session:
        mov r14, 0x1110;                 // KS_ERR_BAD_SESSION
        jmp ks_mi_refused;

      ks_mi_bad_rights:
        mov r14, 0x1112;                 // KS_ERR_RIGHTS
        jmp ks_mi_refused;

      ks_mi_enospc:
        mov r14, 0x1113;                 // KS_MINT_ENOSPC

      ks_mi_refused:
        // r14 holds the KS_* code; preserve it across the klog + note.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ks_tag_mint_rej];
        lea rcx, [rip + ks_k_errno];
        mov r8,  r14;
        call klog_s1_x1;

        mov rdi, 6;                      // KS_ST_REFUSED
        call ks_note;

        mov rax, r14;

      ks_mi_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
