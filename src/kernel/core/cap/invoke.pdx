// PaideiaOS Phase-2 Capability Invoke Operation
// B5-004: cap_invoke(slot: u64, op_arg: u64) -> u64 (MVP dispatcher)
//
// Per design/audit/entries/b5-004-cap-invoke.md:
// Read descriptor at cap_table[slot] and dispatch on kind.
// MVP: return descriptor.target_ptr as the result.
// Real per-kind dispatch (memory read, IPC enqueue, etc.) deferred to Phase 7+.
//
// Descriptor layout (from cap_mint_write):
//   [cap_table + slot*24 + 0] = kind (u64)
//   [cap_table + slot*24 + 8] = rights (u64)
//   [cap_table + slot*24 + 16] = target_ptr (u64)

module Invoke = structure {

  // ============================================================================
  // Dispatch table configuration
  // ============================================================================

  let INVOKE_DISPATCH_TABLE_SIZE : u32 = 256  // Number of operations per kind (op: 0-255)

  // ============================================================================
  // Standard operations (common across kinds where applicable)
  // ============================================================================

  let INVOKE_OP_NULL : u32 = 0    // No-op; reserved, should return 0
  let INVOKE_OP_READ : u32 = 1    // Read operation (memory, port, etc.)
  let INVOKE_OP_WRITE : u32 = 2   // Write operation
  let INVOKE_OP_EXEC : u32 = 3    // Execute operation (code, handler registration, etc.)
  let INVOKE_OP_REVOKE : u32 = 4  // Revoke operation via invoke interface

  // ============================================================================
  // Result codes for cap_invoke()
  // ============================================================================

  let INVOKE_RESULT_INVALID_HANDLE : u64 = 0xFFFFFFFFFFFFFFFE  // Handle validation failed
  let INVOKE_DENIED : u64 = 0xFFFFFFFFFFFFFFFD       // R12-m1-002: rights check failed
  let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC  // R12-m1-002: op not implemented for kind

  // ============================================================================
  // cap_invoke(slot: u64, op_arg: u64) -> u64
  // MVP dispatcher: read descriptor at slot and return target_ptr.
  // Real per-kind dispatch deferred to Phase 7+.
  // ============================================================================

  // R12-m5-001 note: rewritten from pure-fn if-else to unsafe block per
  // paideia-as #913. Semantics preserved: bounds-check slot < 256 then
  // delegate to cap_invoke_dispatch; else return INVOKE_RESULT_INVALID_HANDLE
  // (0xFFFFFFFFFFFFFFFE).
  pub let cap_invoke : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R8-B5-004 cap_invoke MVP: bounds-check slot < 256 then delegate to cap_invoke_dispatch. Out-of-range slot returns INVOKE_RESULT_INVALID_HANDLE. Rewritten as unsafe block per paideia-as #913.",
      block: {
        // cmp rdi, 256 — slot >= 256 means invalid handle
        cmp rdi, 256;
        jae cap_invoke_bad;
        // Delegate to cap_invoke_dispatch(slot, op_arg); rdi/rsi already set.
        call cap_invoke_dispatch;
        ret;
        cap_invoke_bad:
          // INVOKE_RESULT_INVALID_HANDLE = 0xFFFFFFFFFFFFFFFE
          mov rax, 0xFFFFFFFFFFFFFFFE;
          ret
      }
    }

  pub let cap_invoke_dispatch : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R12-m2-001: descriptor.kind read + four-way branch to per-kind handler. Slot-arithmetic prologue identical to B5-004 MVP. mov r11, rsi is the FIRST hazard-crossing move (saves op_arg before RSI is overwritten with target_ptr). Handler ABI: RDI=rights, RSI=target_ptr, RDX=op_arg. Fallthrough returns target_ptr (R8 MVP behaviour) so KIND_PROCESS=1 cap_smoke stays green.",
      block: {
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rcx, [rax + 0];
        mov rdx, [rax + 8];
        mov r10, [rax + 16];
        mov r11, rsi;
        mov rdi, rdx;
        mov rsi, r10;
        mov rdx, r11;
        cmp rcx, 1;
        je call_kind_process;
        cmp rcx, 2;
        je call_kind_thread;
        cmp rcx, 4;
        je call_kind_page;
        // R20b.M1-001 (#1552): KIND_IPC_ENDPOINT (=5) dispatch — currently
        // routes to cap_handler_ipc (kind_ipc.pdx OP_SEND/OP_RECV against
        // the B6 global SPSC channel). R20b.M3-001..M3-002 will extend the
        // handler to consume the descriptor tail (endpoint_id + direction
        // per src/kernel/core/cap/kind_endpoint.pdx) and dispatch to the
        // per-endpoint pending-msg slot. No functional change here at M1-001
        // — the tail-encoding contract is fixed in kind_endpoint.pdx; the
        // dispatch stays wire-compatible with the B6 substrate.
        cmp rcx, 5;
        je call_kind_ipc;
        cmp rcx, 6;
        je call_kind_ipc_port;
        cmp rcx, 7;
        je call_kind_sched;
        cmp rcx, 8;
        je call_kind_timer;
        cmp rcx, 9;
        je call_kind_interrupt;
        cmp rcx, 10;
        je call_kind_dev;
        cmp rcx, 12;
        je call_kind_notification;
        cmp rcx, 13;
        je call_kind_reply;
        // logging-m9-001 (#708): KIND_DMESG (0x16 = 22) — derived-kind, no
        // 4-bit LAM collision; see cap/kind.pdx and cap/kind_dmesg.pdx.
        cmp rcx, 22;
        je call_kind_dmesg;
        // R29.M1-001 (#1019): KIND_HW_INTERRUPT (0x140 = 320) — derived
        // kind over KIND_HW (slot 14). Same fall-through-safe pattern as
        // KIND_DMESG: the descriptor's kind field is compared against
        // the full derived-kind tag (not the 4-bit LAM base slot), so
        // the branch coexists with the slot-9 legacy KIND_INTERRUPT
        // handler above. See cap/kind_hw_interrupt.pdx.
        mov r9, 0x140;
        cmp rcx, r9;
        je call_kind_hw_interrupt;
        // R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR (0x141 = 321) —
        // second derived kind over KIND_HW, layered atop
        // KIND_HW_INTERRUPT. Adjacent numeric tag to 0x140; same
        // fall-through-safe pattern (derived-kind tag matched against
        // full u64 kind field, not the 4-bit LAM base slot). See
        // cap/kind_hw_msix_vector.pdx for the handler + tail + mint /
        // revoke API + cascade path.
        mov r9, 0x141;
        cmp rcx, r9;
        je call_kind_hw_msix_vector;
        // R29.M5-001 (#1036) / R29.M5-002 (#1037): KIND_DMA_DOMAIN
        // (0x142 = 322) — per-driver-process IOMMU domain, derived over
        // KIND_MEMORY (= KIND_PAGE, base slot 4) rather than KIND_HW.
        // The branch sits in the 0x14x R29 block because 0x14x is the
        // round's derived-kind block, not a base-slot encoding; the
        // full u64 kind field is compared, so this coexists with the
        // slot-4 KIND_PAGE handler above without ambiguity. See
        // cap/kind_dma_domain.pdx for the row-indirection tail, the
        // KIND_MEMORY mint gate, and the cascade path.
        mov r9, 0x142;
        cmp rcx, r9;
        je call_kind_dma_domain;
        // R30.M3-001 (#1061): KIND_OP_REGION (0x150 = 336) — the
        // address-space window capability, and the first entry in the
        // R30 derived-kind block (0x15x). It is the ONE derived kind
        // whose base slot is not fixed: a memory-like space derives it
        // over KIND_MEMORY (slot 4), a port-like space over KIND_IO_PORT
        // (slot 11), and the row records which. Dispatch is unaffected by
        // that asymmetry precisely because the full u64 kind field is
        // compared here rather than the 4-bit LAM base slot — the same
        // fall-through-safe pattern as every derived kind above, and the
        // reason one branch can serve both lineages. See
        // cap/kind_op_region.pdx for the row-indirection tail, the
        // space-driven mint gate, the containment check on derive, and
        // the transitive cascade.
        mov r9, 0x150;
        cmp rcx, r9;
        je call_kind_op_region;
        // R30.M4-003 (#1068): KIND_ACPI_EVENT (0x151 = 337) — the
        // platform-event stream endpoint, second entry in the R30
        // derived-kind block. Derives over KIND_HW_INTERRUPT (0x140)
        // rather than over a base kind directly: the reach it confers is
        // strictly downstream of the SCI interrupt whose delivery
        // produces the events, and acknowledging one WRITES the GPE
        // enable register, so a holder who could mint it without holding
        // that interrupt would have manufactured event reach out of
        // nothing. Same fall-through-safe pattern as every derived kind
        // above — the full u64 kind field is compared, not the 4-bit LAM
        // base slot, so this coexists with the slot-9 legacy
        // KIND_INTERRUPT handler. See cap/kind_acpi_event.pdx for the
        // row-indirection tail and the derivation gate, and
        // core/acpi/evt_stream.pdx for the stream the endpoint binds to.
        mov r9, 0x151;
        cmp rcx, r9;
        je call_kind_acpi_event;
        // R30.M5-001 (#1070): KIND_I2C_BUS (0x152 = 338) — the I²C
        // controller capability, third entry in the R30 derived-kind
        // block. Derives over KIND_DEVICE (base slot 10) because an
        // LPSS I²C bus exists only because a PCI function does. Its
        // ops are QUERIES ONLY: this kind deliberately authorises no
        // transaction on the wire, so that the ONLY path to the bus
        // runs through a KIND_I2C_SLAVE naming one address. Same
        // fall-through-safe pattern as every derived kind above — the
        // full u64 kind field is compared, not the 4-bit LAM base slot
        // — so this coexists with the slot-10 KIND_DEVICE handler.
        // See cap/kind_i2c_bus.pdx.
        mov r9, 0x152;
        cmp rcx, r9;
        je call_kind_i2c_bus;
        // R30.M5-002 (#1071): KIND_I2C_SLAVE (0x153 = 339) — authority
        // over ONE address on ONE bus, and the reason the bus kind
        // above is non-transacting. Derives over KIND_I2C_BUS (0x152),
        // a derived tag rather than a base slot, because a raw
        // KIND_DEVICE holder must not be able to mint device reach
        // without the bus capability that proves the controller was
        // brought up as an I²C bus at a validated rate. No op reachable
        // through this branch takes an address: op_arg is masked to its
        // low byte on entry, and the address is read from the
        // capability's own row. See cap/kind_i2c_slave.pdx.
        mov r9, 0x153;
        cmp rcx, r9;
        je call_kind_i2c_slave;
        // R30.M6-001 (#1075): KIND_GPIO_LINE (0x154 = 340) — authority
        // over ONE pin on ONE pad controller, and the fifth entry in the
        // R30 derived-kind block. Derives over KIND_DEVICE (base slot
        // 10), because a pad controller is a PCI function and there is
        // no intermediate "the pads are configured" authority to derive
        // over; what stands in for one is the second half of the gate,
        // which requires the parent's INHERITED identity to name a
        // probed, identified pad controller. Same fall-through-safe
        // pattern as every derived kind above — the full u64 kind field
        // is compared, not the 4-bit LAM base slot — so this coexists
        // with the slot-10 KIND_DEVICE handler. No op reachable through
        // this branch takes a pin, a community or a pad index: op_arg is
        // masked to its low byte on entry and all three are read from
        // the capability's own row. See cap/kind_gpio_line.pdx.
        mov r9, 0x154;
        cmp rcx, r9;
        je call_kind_gpio_line;
        // R30.M8-002 (#1083): KIND_FW_SESSION (0x155 = 341) — authority
        // to open ONE evaluation session against ONE firmware-supplied
        // object, and the sixth and last entry in the R30 derived-kind
        // block. Derives over KIND_IPC_ENDPOINT (base slot 5): a session
        // is a conversation, and the authority to open one is downstream
        // of the authority to talk to the component that holds the
        // firmware namespace. The kind half of that gate is EMPTY on its
        // own — every endpoint in the machine is a KIND_IPC_ENDPOINT —
        // so the mint additionally requires the parent's INHERITED
        // endpoint id to be registered for the requested op-region
        // domain. Same fall-through-safe pattern as every derived kind
        // above: the full u64 kind field is compared, not the 4-bit LAM
        // base slot, so this coexists with the slot-5 KIND_IPC_ENDPOINT
        // handler. No op reachable through this branch takes an object,
        // a scope or a domain — op_arg is masked to its low byte on
        // entry and the object a session acts on comes from its own row.
        // The kind is named KIND_FW_SESSION and not KIND_AML_SESSION
        // because the latter cannot be spelled under src/kernel/**;
        // #1569 renamed it rather than weaken the guardrail. See
        // cap/kind_fw_session.pdx.
        mov r9, 0x155;
        cmp rcx, r9;
        je call_kind_fw_session;
        // R31.M1-002 (#1090): KIND_EC_QUERY (0x156 = 342) — the right to
        // be told that ONE embedded controller raised ONE of a named set
        // of query events, and the first entry past the R30 derived-kind
        // block. Derives over KIND_IPC_ENDPOINT (base slot 5), like
        // KIND_FW_SESSION above and with the same empty kind half: every
        // endpoint in the machine is a KIND_IPC_ENDPOINT, so the mint
        // additionally requires a live KIND_OP_REGION over the
        // EmbeddedControl space to be presented alongside it, and the
        // controller address is inherited from that region's own row.
        // Same fall-through-safe pattern as every derived kind above:
        // the full u64 kind field is compared, not the 4-bit LAM base
        // slot, so this coexists with the slot-5 endpoint handler. No op
        // reachable through this branch takes a controller address —
        // op_arg is masked to its low byte on entry, the two filter ops
        // read a QUERY BYTE from bits [15:8] which selects a bit of this
        // row's own bitmap and can reach no other row, and the
        // controller comes from the row. The one mutating op can only
        // ever CLEAR a bit: there is no widening primitive in the kind
        // at all. See cap/kind_ec_query.pdx.
        mov r9, 0x156;
        cmp rcx, r9;
        je call_kind_ec_query;
        // R31.M2-001 (#1094): KIND_THERMAL_ZONE (0x157 = 343) — one ACPI
        // thermal zone's trip points, and the right to be told which side
        // of them a reading falls on. Derives over KIND_DEVICE (base slot
        // 10), and the kind half of that gate discriminates NOTHING for
        // the third time in this file: every PCI function is a
        // KIND_DEVICE. Unlike KIND_GPIO_LINE above, there is no probed
        // table the inherited identity can be looked up in — "this device
        // is a thermal zone" is a firmware-namespace fact this ring may
        // not read — so the mint enforces what it can (a non-zero
        // inherited device key, one zone per device, a plausible critical
        // threshold, a non-zero hysteresis) and cap/kind_thermal_zone.pdx
        // §5 says so rather than letting the kind check read as a
        // hardware proof. Same fall-through-safe pattern as every derived
        // kind above: the full u64 kind field is compared, not the 4-bit
        // LAM base slot, so this coexists with the slot-10 KIND_DEVICE
        // handler. NO OP REACHABLE THROUGH THIS BRANCH CAN CHANGE A
        // THRESHOLD: there is no trip-install op and no _CRT setter in
        // the kind at all, and the one op that carries a value at all
        // (ASSESS, a temperature in op_arg[31:16]) REFUSES a non-zero
        // op_arg[63:32] rather than masking it. See
        // cap/kind_thermal_zone.pdx.
        mov r9, 0x157;
        cmp rcx, r9;
        je call_kind_thermal_zone;
        // R31.M3-001 (#1099): KIND_BATTERY (0x158 = 344) — one battery
        // pack's static identity and the right to be told what its most
        // recently reported percent, voltage and state were. Derives
        // over KIND_DEVICE (base slot 10), and the kind half of that
        // gate discriminates NOTHING for the fourth time in this file:
        // every PCI function is a KIND_DEVICE. Unlike KIND_GPIO_LINE
        // there is no probed table the inherited identity can be looked
        // up in — "this device is a battery" is a firmware-namespace
        // fact this ring may not read — so the mint enforces what it
        // can (a non-zero inherited device key, one battery per key, a
        // plausible index, a plausible design capacity, a chemistry in
        // the small enumeration) and cap/kind_battery.pdx §2 says so
        // rather than letting the kind check read as a hardware proof.
        // Same fall-through-safe pattern as every derived kind above:
        // the full u64 kind field is compared, not the 4-bit LAM base
        // slot, so this coexists with the slot-10 KIND_DEVICE handler.
        // NO OP REACHABLE THROUGH THIS BRANCH CAN CHANGE A DESIGN
        // CAPACITY OR A CHEMISTRY: there is no setter in the kind at
        // all, and the one op that carries a value (REPORT, three
        // fields packed into op_arg) REFUSES a non-zero reserved
        // op_arg[63:48] rather than masking it. See
        // cap/kind_battery.pdx.
        mov r9, 0x158;
        cmp rcx, r9;
        je call_kind_battery;
        // R31.M4-001 (#1103): KIND_COOLING_DEVICE (0x159 = 345) — one
        // cooling device's static identity (index, cooling type,
        // [state_min, state_max]) and the right to be told what its
        // most recently reported cooling state was. Derives over
        // KIND_DEVICE (base slot 10), and the kind half of that gate
        // discriminates NOTHING for the fifth time in this file: every
        // PCI function is a KIND_DEVICE. Unlike KIND_GPIO_LINE there
        // is no probed table the inherited identity can be looked up
        // in -- "this device is a cooling device" is a firmware-
        // namespace fact this ring may not read -- so the mint
        // enforces what it can (a non-zero inherited device key, one
        // cooler per key, a plausible index, a type in the small
        // enumeration, a non-degenerate state range) and
        // cap/kind_cooling_device.pdx §2 says so rather than letting
        // the kind check read as a hardware proof. Same fall-through-
        // safe pattern as every derived kind above: the full u64 kind
        // field is compared, not the 4-bit LAM base slot, so this
        // coexists with the slot-10 KIND_DEVICE handler. NO OP
        // REACHABLE THROUGH THIS BRANCH CAN CHANGE A STATE_MAX OR A
        // TYPE: there is no setter in the kind at all, and the one
        // op that carries a value (REPORT, cur_state packed into
        // op_arg) REFUSES a non-zero reserved op_arg[63:24] rather
        // than masking it. See cap/kind_cooling_device.pdx.
        mov r9, 0x159;
        cmp rcx, r9;
        je call_kind_cooling_device;
        // R31.M5-001 (#1106): KIND_BACKLIGHT (0x15a = 346) — one
        // backlight controller's static identity (index, backend,
        // [brightness_min, brightness_max]) and the right to be told
        // what its most recently reported brightness was. Derives over
        // KIND_DEVICE (base slot 10), and the kind half of that gate
        // discriminates NOTHING for the sixth time in this file: every
        // PCI function is a KIND_DEVICE. Unlike KIND_GPIO_LINE there
        // is no probed table the inherited identity can be looked up
        // in -- "this device is a backlight" is a firmware-namespace
        // fact this ring may not read -- so the mint enforces what it
        // can (a non-zero inherited device key, one panel per key, a
        // plausible index, a backend in the small enumeration, a
        // non-degenerate brightness range). Same fall-through-safe
        // pattern as every derived kind above: the full u64 kind field
        // is compared, not the 4-bit LAM base slot, so this coexists
        // with the slot-10 KIND_DEVICE handler. NO OP REACHABLE
        // THROUGH THIS BRANCH CAN CHANGE A BRIGHTNESS_MAX OR A
        // BACKEND: there is no setter in the kind at all, and the one
        // op that carries a value (REPORT, current_brightness packed
        // into op_arg) REFUSES a non-zero reserved op_arg[63:24]
        // rather than masking it. See cap/kind_backlight.pdx.
        mov r9, 0x15a;
        cmp rcx, r9;
        je call_kind_backlight;
        // R32.M3-001 (#1125): KIND_HID_DEVICE (0x15b = 347) — one HID
        // input device's static identity (index, transport, vendor,
        // product, report_id_count) and the right to be told that its
        // owner installed one report against the class driver. Derives
        // over KIND_DEVICE (base slot 10), and the kind half of that
        // gate discriminates NOTHING for the seventh time in this file:
        // every PCI function is a KIND_DEVICE. Unlike KIND_GPIO_LINE
        // there is no probed table the inherited identity can be
        // looked up in — "this device is a HID input peripheral" is a
        // fact about descriptor bytes this ring may not read — so the
        // mint enforces what it can (a non-zero inherited device key,
        // one row per key, a plausible index, a transport in the small
        // enumeration, a non-zero (vendor, product) pair, a
        // report_id_count within 0..256). Same fall-through-safe
        // pattern as every derived kind above: the full u64 kind field
        // is compared, not the 4-bit LAM base slot, so this coexists
        // with the slot-10 KIND_DEVICE handler. NO OP REACHABLE
        // THROUGH THIS BRANCH CAN CHANGE A STATIC FIELD, and the one
        // dynamic op (REPORT_INSTALL) has arity ONE — no payload —
        // and REFUSES a non-zero op_arg[63:8] rather than masking it.
        // See cap/kind_hid_device.pdx.
        mov r9, 0x15b;
        cmp rcx, r9;
        je call_kind_hid_device;
        // R32.M3-002 (#1126): KIND_HID_EVENT (0x15c = 348) — the
        // authority a ring-3 subscriber holds to be told, on ONE
        // endpoint it also holds, about the SUBSET of the HID event-
        // class stream it asks for. Derives over KIND_IPC_ENDPOINT
        // (base slot 5), and the kind half of that gate is EMPTY for
        // the third time (KIND_FW_SESSION, KIND_EC_QUERY, and now this)
        // -- every endpoint in the machine is a KIND_IPC_ENDPOINT.
        // The second half is a validated non-zero mask (four bits, the
        // four HID event classes the R32 substrate exists for), a
        // non-zero subscriber pid, and an INHERITED endpoint id read
        // from the parent's target_ptr[15:0]. Uniqueness key is
        // (endpoint_id, event_type_mask): two subscriptions on the
        // same endpoint for the same mask are refused as duplicates.
        // Same fall-through-safe pattern as every derived kind above.
        // NO OP REACHABLE THROUGH THIS BRANCH TAKES AN OPERAND: every
        // op is (op only) and op_arg[63:8] is REFUSED rather than
        // masked. See cap/kind_hid_event.pdx.
        mov r9, 0x15c;
        cmp rcx, r9;
        je call_kind_hid_event;
        // R32.M5-001 (#1133): KIND_SENSOR_CHANNEL (0x15d = 349) — the
        // authority a ring-3 subscriber holds to be told, on ONE
        // endpoint it also holds, about ONE class of sensor sample
        // (ALS / ACCEL / GYRO) at a chosen rate. Derives over
        // KIND_IPC_ENDPOINT (base slot 5), and the kind half of that
        // gate is EMPTY for the fourth time (KIND_FW_SESSION,
        // KIND_EC_QUERY, KIND_HID_EVENT, and now this) -- every
        // endpoint in the machine is a KIND_IPC_ENDPOINT. The second
        // half is a validated non-zero sensor type, a rate in [1,
        // SENSOR_RATE_MAX] Hz, a non-zero subscriber pid, and an
        // INHERITED endpoint id read from the parent's target_ptr
        // [15:0]. Uniqueness key is (endpoint_id, sensor_type); rate
        // is NOT part of the key so a rate change requires revoke and
        // remint. Same fall-through-safe pattern as every derived kind
        // above. NO OP REACHABLE THROUGH THIS BRANCH TAKES AN OPERAND:
        // every op is (op only) and op_arg[63:8] is REFUSED rather
        // than masked. See cap/kind_sensor_channel.pdx.
        mov r9, 0x15d;
        cmp rcx, r9;
        je call_kind_sensor_channel;
        // R33.M1-005 (#1141): KIND_AUDIO_CONTROLLER (0x15e = 350) — one
        // HDA controller's static identity (inherited hda_key, opaque
        // bar_handle, corb_size, rirb_size) and the right to be told
        // the discovery scan updated the codec count. Derives over
        // KIND_DEVICE (base slot 10), and the kind half of that gate
        // discriminates NOTHING for the eighth time in this file: every
        // PCI function is a KIND_DEVICE. "This device is an HDA
        // controller" is a class-code fact the ring-3 supervisor
        // distills, and the capability is the record of ITS decision.
        // Same fall-through-safe pattern as every derived kind above:
        // the full u64 kind field is compared, not the 4-bit LAM base
        // slot, so this coexists with the slot-10 KIND_DEVICE handler.
        // NO OP REACHABLE THROUGH THIS BRANCH CAN CHANGE A BAR_HANDLE
        // OR A RING SHAPE, and the one op that carries a value (REPORT,
        // new_codec_count packed into op_arg[11:8]) REFUSES a non-zero
        // reserved op_arg[63:12] rather than masking it. See
        // cap/kind_audio_controller.pdx.
        mov r9, 0x15e;
        cmp rcx, r9;
        je call_kind_audio_ctrl;
        // R33.M3-001 (#1147): KIND_PCM_STREAM (0x15f = 351) — the
        // authority to name ONE PCM stream (session_key, audio_clock
        // slot, ring_bo_key, sample_format, sample_rate, channels,
        // position). Derives over KIND_IPC_ENDPOINT (base slot 5), the
        // fifth kind in this file to take that parent after
        // KIND_FW_SESSION, KIND_EC_QUERY, KIND_HID_EVENT and
        // KIND_SENSOR_CHANNEL, and the fifth time the kind half of
        // that gate is EMPTY on its own. LINEAR: no primitive changes
        // any of the six identity fields; the ADVANCE op only
        // increments the row's position counter. NO OP REACHABLE
        // THROUGH THIS BRANCH CAN CHANGE audio_clock_slot,
