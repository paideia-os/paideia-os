// src/kernel/core/cap/kind_schema_handle.pdx -- R90-XREPO.012.M3-001 (paideia-os #2126)
//
// KIND_SCHEMA_HANDLE = 0x1B2, derived over KIND_MEMORY (= 4).
//
// The capability a semantic-pipe consumer holds after resolving a
// schema name via svc.schema-registry. Row substrate + mint gate + row
// accessors + cap_invoke dispatch handler all in one file (kind_nic.
// pdx compact posture), because the op surface is deliberately tiny:
// QUERY_NAME + QUERY_HANDLE, both gated on the single R_SCHEMA_READ
// right.
//
// =============================================================================
// SECTION 0  ORDINAL CHOICE  --  0x1B2
// =============================================================================
//
// R90-XREPO.012 planning originally reserved 0x1AE for KIND_SCHEMA_
// HANDLE. A repo-wide sweep at landing time (2026-09-01) shows the R101
// GUI plan (design/graphics/r101-kernel-plan.md §5) has previously
// reserved 0x1AE / 0x1AF / 0x1B0 / 0x1B1 for the display substrate:
//
//   0x1AD  KIND_NIC              (R91.M1-001, landed)
//   0x1AE  KIND_DISPLAY_BACKEND  (R101.M1-001, reserved)
//   0x1AF  KIND_FRAMEBUFFER      (R101.M3-001, reserved)
//   0x1B0  KIND_PAGE_FLIP        (R104.M4-001, reserved)
//   0x1B1  KIND_HOTPLUG_CHANNEL  (R105.M4-001, reserved)
//   0x1B2  KIND_SCHEMA_HANDLE    (this landing) -- first free
//
// The R101 plan's tail summary explicitly names 0x1B2..0x1BF as the
// "reserved for G7+" band available for adjacent-round claims; this
// landing takes the first slot of that band with no impact on the GUI
// wave's own reservations.
//
// =============================================================================
// SECTION 1  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// A schema handle refers indirectly into _sreg_schema_store, a static
// kernel-owned byte store that lives in .bss (ordinary memory from the
// derivation-gate's perspective, same posture kind_pdxfs_mount_table.
// pdx §0 takes for the _mount_table[] array and kind_tui_canvas.pdx
// §"ROW LAYOUT" takes for its backing-store slot). The parent gate is
// therefore the standard "cannot widen memory reach beyond what you
// already hold" rule: parent.kind == KIND_MEMORY (4) AND rights carry
// RIGHT_MINT (0x200).
//
// Supervisor-only mint. There is no cap-invoke op that reaches
// kind_schema_handle_mint_body: the mint is a kernel-trusted primitive
// callable from sys_sreg_lookup_body (deferred landing) or the boot
// witness, both of which already hold a root KIND_MEMORY parent cap
// with RIGHT_MINT. A ring-3 caller holding only a KIND_SCHEMA_HANDLE
// cannot mint a fresh one -- it can only reach the handler's two
// QUERY ops.
//
// =============================================================================
// SECTION 2  TAIL ENCODING
// =============================================================================
//
// Row layout (32 bytes, four u64 words):
//
//   [+0]  header       (u64):
//         in_use    [63:56] (0=free, 1=live)
//         reserved  [55:0]
//   [+8]  ids         (u64):
//         schema_id [31:0]  (u32; matches sreg row's schema_id field)
//         refcount  [63:32] (u32; incremented on mint, decremented on revoke)
//   [+16] owner_pid   (u64) (pid that registered the schema in sreg)
//   [+24] flags       (u64) (reserved at R90; must be zero on mint)
//
// Row-addressed capacity: KSH_MAX = 32 rows. 32 * 32 = 1024 bytes.
// 32 outstanding schema handles is one order above the current
// 10-consumer count in ECOSYSTEM_STATUS.md, leaving headroom for the
// fan-out when every emitter holds 2-3 handles simultaneously.
//
// =============================================================================
// SECTION 3  RIGHTS  --  R_SCHEMA_READ (0x001), R_SCHEMA_WRITE (0x002)
// =============================================================================
//
//   R_SCHEMA_READ  (0x001) -- gate every QUERY op in cap_handler_ksh.
//   R_SCHEMA_WRITE (0x002) -- reserved; future SREG_OP_EVOLVE gate
//                             (per design/terminal/schema-registry.md §12).
//                             Never minted at R90.
//
// R_KSH_ALL = 0x003. Subset test in ksh_rights_valid uses that
// constant. The R_SCHEMA_WRITE bit is legally settable (subset test
// permits it) but no op consumes it at this landing.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFEB35..0xFFFFEB39
// =============================================================================
//
// Shares the 0xFFFFEB30..0xFFFFEB3F page with schema_registry.pdx's
// SREG_ERR_* codes (which claim 0xFFFFEB3A..0xFFFFEB3F). The KIND_
// SCHEMA_HANDLE band picks up the low half of the page:
//
//   KSH_MINT_BAD_ID     0xFFFFEB39  -- schema_id > SREG_MAX or not live
//   KSH_BAD_RIGHTS      0xFFFFEB38  -- op invoked without R_SCHEMA_READ
//   KSH_BAD_SLOT        0xFFFFEB37  -- row_id out of range or free
//   KSH_TAIL_BAD_ARG    0xFFFFEB36  -- op_arg[63:8] non-zero
//   KSH_TAIL_ENOSPC     0xFFFFEB35  -- KIND_SCHEMA_HANDLE pool full
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag constant 0x1B2 (KIND_SCHEMA_HANDLE) sits in the same
// 0x100..0xFFF band as kind_nic (0x1AD), kind_tls_trust (0x1A7),
// kind_tui_canvas (0x1A6) and kind_pdxfs_mount_table (0x1A5); does not
// sign-extend cleanly from a 32-bit immediate, so every compare
// against it stages through r11 first. KIND_MEMORY (4) needs no
// staging. Rights bits stage through r11 for the RIGHT_MINT (0x200)
// check. No mov_b for the header byte -- the in_use marker packs into
// the top byte of a full u64. Labels prefixed `ksh_` (kind-schema-
// handle) or `ksh_hn_` (handler).

module KindSchemaHandle = structure {

  pub let KIND_SCHEMA_HANDLE      : u64 = 0x1B2
  pub let KIND_SCHEMA_HANDLE_BASE : u64 = 4          // = KIND_MEMORY

  // Rights (§3).
  pub let R_SCHEMA_READ  : u64 = 0x001
  pub let R_SCHEMA_WRITE : u64 = 0x002
  pub let R_KSH_ALL      : u64 = 0x003

  // Ops (both arity-one, both gated on R_SCHEMA_READ).
  pub let KSH_OP_QUERY_NAME   : u64 = 0
  pub let KSH_OP_QUERY_HANDLE : u64 = 1
  pub let KSH_OP_MAX          : u64 = 1

  // Failure taxonomy (§4).
  pub let KSH_OK              : u64 = 0
  pub let KSH_MINT_BAD_ID     : u64 = 0xFFFFEB39
  pub let KSH_BAD_RIGHTS      : u64 = 0xFFFFEB38
  pub let KSH_BAD_SLOT        : u64 = 0xFFFFEB37
  pub let KSH_TAIL_BAD_ARG    : u64 = 0xFFFFEB36
  pub let KSH_TAIL_ENOSPC     : u64 = 0xFFFFEB35

  pub let KSH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KSH_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let KSH_MAX       : u64 = 32
  pub let KSH_ROW_BYTES : u64 = 32

  // 32 rows * 32 bytes = 1024 bytes = 128 u64.
  pub let mut _ksh_table : [u64; 128] = uninit @align(64)
  pub let mut _ksh_stats : [u64; 8]   = uninit @align(64)

  pub let KSH_ST_MINTS   : u64 = 0
  pub let KSH_ST_QUERIES : u64 = 1
  pub let KSH_ST_REFUSED : u64 = 2
  pub let KSH_ST_MAX     : u64 = 8

  // ==========================================================================
  // ksh_table_reset() -> ()
  //
  // Boot / teardown scrub of the row pool and counter table. .bss
  // already starts zero at real boot; defensive, matches
  // kind_nic.nic_table_reset shape.
  // ==========================================================================

  pub let ksh_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): clear _ksh_table (128 u64 = 1024 bytes) and _ksh_stats (8 u64). Two separate loops, mirrors kind_nic.pdx nic_table_reset one-for-one. Labels prefixed ksh_rs_.",
      block: {
        lea r10, [rip + _ksh_table];
        xor rax, rax;
        xor rcx, rcx;
      ksh_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  ksh_rs_rows;

        lea r10, [rip + _ksh_stats];
        xor rcx, rcx;
      ksh_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ksh_rs_stats;
        ret
      }
    }

  pub let ksh_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): bounded increment on _ksh_stats. Labels prefixed ksh_nt_.",
      block: {
        cmp rdi, 8;
        jae ksh_nt_out;
        lea r10, [rip + _ksh_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ksh_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  // ksh_rights_valid(rights) -> 1 iff subset of R_KSH_ALL (0x003).
  pub let ksh_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): subset test against R_KSH_ALL = 0x003. Labels prefixed ksh_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x003;                  // R_KSH_ALL
        and rax, r10;
        cmp rax, rdi;
        jne ksh_rv_no;
        mov rax, 1;
        ret;
      ksh_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ksh_check_parent_memory(parent_slot) -> 1 iff cap_table[parent_
  // slot].kind == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200).
  // Mirrors kind_tui_canvas tui_check_memory one-for-one.
  pub let ksh_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): KIND_MEMORY derivation gate. Bounds-check parent_slot < 256; load descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_MEMORY (4) AND rights ([+8]) carry RIGHT_MINT (0x200). Pure read (@{cap} because it inspects cap_table). Labels prefixed ksh_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae ksh_cpm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne ksh_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  ksh_cpm_no;

        mov rax, 1;
        ret;
      ksh_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool: ksh_row_valid / ksh_row_alloc / ksh_row_free.
  // ==========================================================================

  // ksh_row_valid(idx) -> 1 iff idx < KSH_MAX and header's in_use byte
  // (bits [63:56]) is set. Inlined address compute (idx*32 via shl 5).
  pub let ksh_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): 1 iff idx < KSH_MAX(32) and in_use byte set. Inlined address compute (idx*32 via shl 5). Labels prefixed ksh_rv2_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        jae ksh_rv2_no;
        lea r10, [rip + _ksh_table];
        mov r11, rdi;
        shl r11, 5;                      // idx * 32
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use byte
        cmp rax, 0;
        je  ksh_rv2_no;
        mov rax, 1;
        ret;
      ksh_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // ksh_row_alloc(schema_id, owner_pid) -> row_idx | KSH_TAIL_ENOSPC
  //
  // Low-first scan over 32 rows of 32 bytes. Header write is LAST:
  // in_use bit set via OR with (1 << 56) in the same qword store,
  // matching kind_nic.nic_tail_alloc "publish in_use last" ordering.
  //
  // refcount initialised to 1 (this mint IS the first reference).
  pub let ksh_row_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (schema_id: u64) (owner_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): claim one KIND_SCHEMA_HANDLE row. Low-first scan (r13=idx cursor). On claim: pack ids = (refcount 1 << 32) | (schema_id & 0xFFFFFFFF) into [row+8]; write owner_pid into [row+16]; write flags=0 into [row+24]; publish in_use=1 via header store at [row+0]. Three callee-save pushes (rbx=schema_id, r12=owner_pid, r13=idx) preserve loop-carried state across the internal scan; no nested calls, so no additional stack alignment padding is needed. Labels prefixed ksh_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // schema_id
        mov r12, rsi;                    // owner_pid

        xor r13, r13;                    // idx = 0
      ksh_ra_scan:
        mov r10, 32;                     // KSH_MAX
        cmp r13, r10;
        jae ksh_ra_enospc;

        lea r10, [rip + _ksh_table];
        mov r11, r13;
        shl r11, 5;                      // idx * 32
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use
        cmp rax, 0;
        je  ksh_ra_claim;

        add r13, 1;
        jmp ksh_ra_scan;

      ksh_ra_claim:
        // Pack ids: (refcount=1 << 32) | (schema_id & 0xFFFFFFFF).
        mov rax, rbx;
        mov r11, 0xFFFFFFFF;
        and rax, r11;                    // schema_id low 32
        mov rcx, 1;
        shl rcx, 32;                     // refcount << 32
        or  rax, rcx;
        mov [r10 + 8], rax;

        // owner_pid.
        mov [r10 + 16], r12;

        // flags = 0.
        xor rax, rax;
        mov [r10 + 24], rax;

        // Publish in_use LAST via header at [+0].
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;

        mov rax, r13;                    // row_idx
        jmp ksh_ra_out;

      ksh_ra_enospc:
        mov rax, 0xFFFFEB35;             // KSH_TAIL_ENOSPC

      ksh_ra_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ksh_row_free(idx) -> (). Scrub the whole 32-byte row.
  pub let ksh_row_free : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): scrub one row (four u64 words). Labels prefixed ksh_rf_.",
      block: {
        mov r10, 32;                     // KSH_MAX
        cmp rdi, r10;
        jae ksh_rf_out;
        lea r10, [rip + _ksh_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      ksh_rf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Each returns KSH_DECODE_BAD when the row is not
  // live, matching kind_nic / kind_tls_trust discipline.
  // ==========================================================================

  pub let ksh_row_schema_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): schema_id (ids u64 [31:0]) or KSH_DECODE_BAD. Labels prefixed ksh_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call ksh_row_valid;
        cmp rax, 0;
        je  ksh_rk_bad;
        lea r10, [rip + _ksh_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];              // ids word
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        jmp ksh_rk_out;
      ksh_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ksh_rk_out:
        pop r12;
        ret
      }
    }

  pub let ksh_row_owner_pid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): owner_pid @ row+16 or KSH_DECODE_BAD. Labels prefixed ksh_ro_.",
      block: {
        push r12;
        mov r12, rdi;
        call ksh_row_valid;
        cmp rax, 0;
        je  ksh_ro_bad;
        lea r10, [rip + _ksh_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp ksh_ro_out;
      ksh_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ksh_ro_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_schema_handle_mint_body(parent_slot, rights, schema_id,
  //                              owner_pid) -> row_idx | KSH_*
  //
  // The KIND_SCHEMA_HANDLE mint walker. Not reachable via cap_invoke
  // (no MINT right at this landing); called from sys_sreg_lookup_body
  // (a later landing) or the boot witness after both hold a KIND_
  // MEMORY parent cap with RIGHT_MINT.
  //
  // Gate order: (1) parent (KIND_MEMORY + RIGHT_MINT); (2) rights
  // subset; (3) schema_id in [1..SREG_MAX (64)]; (4) row_alloc.
  //
  // Register plan: r12=parent_slot, r13=rights, r14=schema_id,
  // r15=owner_pid. Four callee-save pushes = 32 bytes; entry
  // rsp%16==8, +32 -> rsp%16==8 still, so we add `sub rsp, 8` (8 pad).
  // ==========================================================================

  pub let kind_schema_handle_mint_body : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (schema_id: u64) (owner_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): mint KIND_SCHEMA_HANDLE over KIND_MEMORY. Gate order: (1) parent gate (ksh_check_parent_memory: KIND_MEMORY(4) + RIGHT_MINT(0x200)); (2) rights subset (ksh_rights_valid: <= R_KSH_ALL = 0x003); (3) schema_id in [1..SREG_MAX (64)] -- 0 is the 'no id' sentinel, and above SREG_MAX cannot exist in the registry; (4) ksh_row_alloc(schema_id, owner_pid). Register plan: r12=parent_slot, r13=rights, r14=schema_id, r15=owner_pid. Four callee-save pushes + sub rsp,8 = 40 bytes: entry rsp%16==8, +40 -> rsp%16==0 for every nested call. On success bumps KSH_ST_MINTS; refusal funnel bumps KSH_ST_REFUSED. Labels prefixed ksh_mi_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov r14, rdx;                    // schema_id
        mov r15, rcx;                    // owner_pid

        // (1) Parent gate.
        mov rdi, r12;
        call ksh_check_parent_memory;
        cmp rax, 0;
        je  ksh_mi_bad_id;

        // (2) Rights subset.
        mov rdi, r13;
        call ksh_rights_valid;
        cmp rax, 0;
        je  ksh_mi_bad_rights;

        // (3) schema_id in [1..64].
        cmp r14, 0;
        je  ksh_mi_bad_id;
        mov r10, 64;                     // SREG_MAX
        cmp r14, r10;
        ja  ksh_mi_bad_id;

        // (4) Row alloc.
        mov rdi, r14;
        mov rsi, r15;
        call ksh_row_alloc;
        mov r10, 32;                     // KSH_MAX (row cap)
        cmp rax, r10;
        jae ksh_mi_alloc_fail;

        // Success: bump mints, return row_idx.
        push rax;
        mov rdi, 0;                      // KSH_ST_MINTS
        call ksh_note;
        pop rax;
        jmp ksh_mi_out;

      ksh_mi_alloc_fail:
        // rax already holds KSH_TAIL_ENOSPC (0xFFFFEB35).
        jmp ksh_mi_refused;
      ksh_mi_bad_id:
        mov rax, 0xFFFFEB39;             // KSH_MINT_BAD_ID
        jmp ksh_mi_refused;
      ksh_mi_bad_rights:
        mov rax, 0xFFFFEB38;             // KSH_BAD_RIGHTS

      ksh_mi_refused:
        push rax;
        mov rdi, 2;                      // KSH_ST_REFUSED
        call ksh_note;
        pop rax;

      ksh_mi_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_schema_handle(rights, target_ptr, op_arg) -> u64
  //
  // KIND_SCHEMA_HANDLE op dispatch. row_id = target_ptr[15:0]; op =
  // op_arg[7:0]; op_arg[63:8] MUST be zero (smuggled second value
  // refused). Rights gate is a SINGLE up-front check against R_SCHEMA_
  // READ (0x001), not per-op, because both ops require the same right
  // at this landing (matches kind_nic cap_handler_nic §uniform-rights
  // posture).
  //
  //   op 0 KSH_OP_QUERY_NAME   -> resolve schema_id, delegate to
  //                               sreg_row_by_id to read back the
  //                               registered name buffer; returns the
  //                               row PA of the registry row (caller
  //                               copies name bytes out of _sreg_
  //                               schema_store using row's offset +
  //                               length). Deliberately a POINTER
  //                               return: the alternative (copying 22
  //                               bytes into a return register) does
  //                               not fit u64, and the two-word design
  //                               brief of the KIND_SCHEMA_HANDLE
  //                               contract (§8) leaves stream-out of
  //                               larger data to a follow-up landing.
  //   op 1 KSH_OP_QUERY_HANDLE -> return schema_id as u64.
  //   else                     -> KSH_BAD_SLOT.
  //
  // Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave
  // rsp%16==0 at every nested call (entry rsp%16==8, -24 -> ...==8; add
  // sub rsp, 8 -> ==0).
  // ==========================================================================

  pub let cap_handler_schema_handle : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.012.M3-001 (paideia-os #2126): KIND_SCHEMA_HANDLE ops dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0]; op_arg[63:8] MUST be zero (smuggled second value refused with KSH_TAIL_BAD_ARG). Row validity (ksh_row_valid) checked once before dispatch. Rights gate is a SINGLE up-front check against R_SCHEMA_READ (0x001), not per-op, because §3 makes both ops require the same right at this landing. Ops dispatched: 0 QUERY_NAME -> read schema_id from row, sreg_row_by_id to get registry row PA, return it (caller reads offset+length from row to copy name bytes out of _sreg_schema_store); 1 QUERY_HANDLE -> return schema_id as u64. Unrecognized op falls to KSH_BAD_SLOT. Each successful QUERY bumps KSH_ST_QUERIES via the shared ksh_hn_count funnel. Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave rsp%16==0 at every nested call (entry rsp%16==8, -24 -> rsp%16==0), mirroring kind_nic cap_handler_nic's prologue one-for-one -- no additional padding needed. Labels prefixed ksh_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op_arg

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne ksh_hn_res;

        // op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        mov r13, r10;

        // Row validity (once, before dispatch).
        mov rdi, r12;
        call ksh_row_valid;
        cmp rax, 0;
        je  ksh_hn_bad_slot;

        // Rights gate (once, uniform).
        mov r10, rbx;
        and r10, 0x001;                  // R_SCHEMA_READ
        cmp r10, 0;
        je  ksh_hn_bad_rights;

        // Op dispatch.
        cmp r13, 0;
        je  ksh_hn_op_name;
        cmp r13, 1;
        je  ksh_hn_op_handle;
        jmp ksh_hn_bad_slot;

      ksh_hn_op_name:
        // Load schema_id from the row (ids word low 32 bits), resolve
        // to the sreg row PA, return that PA. Caller reads offset +
        // length from the sreg row and copies the name bytes out of
        // _sreg_schema_store via sreg_row_offset / sreg_row_length.
        mov rdi, r12;
        call ksh_row_schema_id;
        // rax = schema_id. Pass to sreg_row_by_id.
        mov rdi, rax;
        call sreg_row_by_id;
        // rax = sreg row PA on hit, 0 on miss.
        jmp ksh_hn_count;

      ksh_hn_op_handle:
        mov rdi, r12;
        call ksh_row_schema_id;
        // rax = schema_id (or KSH_DECODE_BAD on internal miss).
        // fallthrough to ksh_hn_count.

      ksh_hn_count:
        push rax;
        mov rdi, 1;                      // KSH_ST_QUERIES
        call ksh_note;
        pop rax;
        jmp ksh_hn_out;

      ksh_hn_res:
        mov rax, 0xFFFFEB36;             // KSH_TAIL_BAD_ARG
        jmp ksh_hn_out;
      ksh_hn_bad_slot:
        mov rax, 0xFFFFEB37;             // KSH_BAD_SLOT
        jmp ksh_hn_out;
      ksh_hn_bad_rights:
        mov rax, 0xFFFFEB38;             // KSH_BAD_RIGHTS

      ksh_hn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
