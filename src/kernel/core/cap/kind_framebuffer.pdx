  // fb_row_backend_kind(idx) -> backend_kind (from header[7:0]).
  pub let fb_row_backend_kind : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: extract backend_kind[7:0] from row[+0] header. Consumed by fb_flush_via_backend to dispatch to backend_flush. Labels prefixed fb_rbk_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call fb_row_valid;
        cmp rax, 0;
        je  fb_rbk_bad;
        mov rdi, rbx;
        call fb_row_addr;
        mov r10, rax;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        pop rbx;
        ret;
      fb_rbk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_framebuffer_mint_body(memory_slot, rights, backend_row,
  //   pixel_format, width, height, stride, lfb_pa, lfb_va) -> row_id | *_SENTINEL
  //
  // paideia-as SysV caps register args at 6. This body accepts 9
  // logical args; the 3 tail args (stride, lfb_pa, lfb_va) travel on
  // the caller's stack in the standard "args past the 6th" convention.
  // Only the R101.M4 witness calls this directly (with the on-stack
  // args set up by its own push sequence); no dispatch shim wraps it.
  //
  // For the R101.M2-005 boot integration path (which sees stride/lfb_pa/
  // lfb_va from the Bochs probe locally), a sibling _simple entry point
  // below packs a fixed BGRA8888 mint with owner_pid=0.
  // ==========================================================================

  // kind_framebuffer_mint_simple(memory_slot, backend_row, width,
  //   height, lfb_pa, lfb_va) -> row_id | *_SENTINEL
  //
  // Six args in registers, no stack args. Fills format=BGRA8888,
  // stride=width*4, owner_pid=0. This is the R101.M2-005 boot-time
  // caller's entry point.
  pub let kind_framebuffer_mint_simple : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (memory_slot: u64) (backend_row: u64) (width: u64) (height: u64) (lfb_pa: u64) (lfb_va: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R101.M3-001: mint KIND_FRAMEBUFFER at boot-time (BGRA8888, stride=width*4, owner_pid=0). Gate order: (1) memory_slot via fb_check_memory (KIND_MEMORY + RIGHT_MINT); (2) backend_row via fb_check_backend (live KIND_DISPLAY_BACKEND row); (3) width/height via fb_dim_valid; (4) fb_hdr_pack for header; (5) fb_pack_wh for width_x_height; (6) fb_tail_alloc. On success emits fingerprint. Backend_kind is READ from _dpyb_table[backend_row].header[7:0] via dpyb_row_backend_kind rather than accepted as an argument (avoids the caller supplying a mismatched value). Register plan: r12=memory_slot, r13=backend_row, r14=width, r15=height, rbx=hdr / reused for row_id, rbp=lfb_pa, and lfb_va lives on the stack across most nested calls (mov to [rsp+0] once). Six callee-save pushes: entry rsp%16==8, +48=56; sub rsp,24 (16 for stack args to fb_tail_alloc + 8 saved slot for lfb_va)=80, rsp%16==0. paideia-as SysV: fb_tail_alloc takes 6 args in registers -- owner_pid in r9. Labels prefixed fb_ms_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov r12, rdi;                    // memory_slot
        mov r13, rsi;                    // backend_row
        mov r14, rdx;                    // width
        mov r15, rcx;                    // height
        mov rbp, r8;                     // lfb_pa
        mov [rsp + 0], r9;               // lfb_va spill

        // Gate 1: memory_slot.
        mov rdi, r12;
        call fb_check_memory;
        cmp rax, 0;
        je  fb_ms_bad_memory;

        // Gate 2: backend_row.
        mov rdi, r13;
        call fb_check_backend;
        cmp rax, 0;
        je  fb_ms_bad_backend;

        // Gate 3: dims.
        mov rdi, r14;
        call fb_dim_valid;
        cmp rax, 0;
        je  fb_ms_bad_dims;
        mov rdi, r15;
        call fb_dim_valid;
        cmp rax, 0;
        je  fb_ms_bad_dims;

        // Read backend_kind from the KIND_DISPLAY_BACKEND row.
        mov rdi, r13;
        call dpyb_row_backend_kind;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fb_ms_bad_backend;
        mov [rsp + 8], rax;              // backend_kind spill

        // Header pack.
        mov rdi, [rsp + 8];
        mov rsi, 1;                      // FB_FMT_BGRA8888
        call fb_hdr_pack;
        mov rbx, rax;                    // hdr

        // width_x_height pack.
        mov rdi, r14;
        mov rsi, r15;
        call fb_pack_wh;
        mov [rsp + 16], rax;             // wh_packed spill

        // stride = width * 4 (BGRA8888).
        mov rax, r14;
        shl rax, 2;

        // fb_tail_alloc(hdr, wh_packed, stride, lfb_pa, lfb_va, owner_pid=0)
        mov rdi, rbx;                    // hdr
        mov rsi, [rsp + 16];             // wh_packed
        mov rdx, rax;                    // stride
        mov rcx, rbp;                    // lfb_pa
        mov r8,  [rsp + 0];              // lfb_va
        xor r9, r9;                      // owner_pid = 0
        call fb_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae fb_ms_refused;

        mov rbx, rax;                    // rbx = row_id

        mov rdi, 0;                      // FB_ST_MINTS
        call fb_note;

        // Fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fb_mint_ok_msg];
        lea rcx, [rip + k_row];
        mov r8, rbx;
        call klog_s1_d1;

        mov rax, rbx;
        jmp fb_ms_out;

      fb_ms_bad_memory:
        mov rax, 0xFFFFEB4F;             // FB_MINT_BAD_MEMORY
        jmp fb_ms_refused;
      fb_ms_bad_backend:
        mov rax, 0xFFFFEB4E;             // FB_MINT_BAD_BACKEND
        jmp fb_ms_refused;
      fb_ms_bad_dims:
        mov rax, 0xFFFFEB4C;             // FB_MINT_BAD_DIMS

      fb_ms_refused:
        push rax;
        mov rdi, 2;                      // FB_ST_REFUSED
        call fb_note;
        pop rax;

      fb_ms_out:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  pub let kind_framebuffer_revoke_body : (u64) -> u64 !{mem} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R101.M3-001: revoke KIND_FRAMEBUFFER row. row_id >= FB_MAX(4) -> FB_BAD_SLOT; not in_use -> FB_BAD_SLOT; else tail_free + return 0. Labels prefixed fb_revoke_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 4;
        cmp r12, r10;
        jae fb_revoke_bad_slot;

        mov rdi, r12;
        call fb_row_valid;
        cmp rax, 0;
        je  fb_revoke_bad_slot;

        mov rdi, r12;
        call fb_tail_free;
        xor rax, rax;
        jmp fb_revoke_out;

      fb_revoke_bad_slot:
        mov rax, 0xFFFFEB47;             // FB_BAD_SLOT

      fb_revoke_out:
        pop r12;
        ret
      }
    }

  pub let kind_framebuffer_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: fb_table_reset alias / boot-time defensive re-scrub. Zero args, no push/pop. Labels prefixed fb_init_ (none needed, one nested call).",
      block: {
        call fb_table_reset;
        ret
      }
    }
}
