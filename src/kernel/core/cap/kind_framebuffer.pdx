// src/kernel/core/cap/kind_framebuffer.pdx -- R101.M3-001
//
// KIND_FRAMEBUFFER = 0x1AF, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// Per design/graphics/r101-kernel-plan.md §4.2: KIND_GPU_BO (0x174) is
// the scan-out-shaped buffer today, but its mint requires a KIND_GPU_VM
// (0x175) parent -- which does NOT exist on Bochs/stdvga (no GPU) or
// on early virtio-gpu 2D. Deriving Bochs's scan-out buffers as GPU_BOs
// would need a stub KIND_GPU_VM promising nothing, a design smell the
// plan explicitly rejects. This kind is the GPU-optional alternative:
// a linear KIND_MEMORY range with pixel geometry and a backend_slot.
//
// Row substrate + mint gate + row accessors folded into one file (kind_
// nic.pdx / kind_display_backend.pdx precedent) because the op surface
// is deliberately tiny at R101 -- one QUERY op (query pixel geometry)
// at this landing; the cap_invoke dispatch for FLIP + REVOKE arrives
// at R105 with the syscall surface.
//
// =============================================================================
// SECTION 0  WHY KIND_FRAMEBUFFER DERIVES OVER KIND_MEMORY
// =============================================================================
//
// A framebuffer's authority IS the memory range it names -- writing to
// the framebuffer means writing to a linear KIND_MEMORY region, whose
// contents the backend's flush op will then transfer to the scan-out
// surface. Deriving over KIND_MEMORY captures that: the parent's
// RIGHT_MINT is the ONLY authority needed to allocate the backing, and
// no reference to a display engine or GPU_VM leaks into the mint gate
// -- which is what lets Bochs/stdvga (no GPU) mint a framebuffer at
// all. This mirrors the KIND_TUI_CANVAS derivation over KIND_MEMORY,
// same base slot, same tui_check_memory shape.
//
// =============================================================================
// SECTION 1  TAIL ENCODING -- 48 BYTES EXACTLY
// =============================================================================
//
// The prompt-supplied row (kind_tag@+0, width@+8, height@+12, stride
// @+16, pixel_format@+20 (u8), lfb_pa@+24, lfb_va@+32, owner_pid@+40)
// is honoured field-for-field, adapted to the tree's "header at +0"
// convention (in_use flag in bits [63:56] so tail_alloc's low-first
// scan can find a free row):
//
//   [+0]  header (u64):
//         in_use       [63:56]  (allocator flag; 0=free, 1=live)
//         reserved     [55:16]
//         pixel_format [15:8]   (0=NONE, 1=BGRA8888; FB_FMT_MAX = 1)
//         backend_kind [7:0]    (mirrors _dpyb_table's row backend_kind
//                                so a fb-flush caller can dispatch
//                                without a second cap lookup)
//   [+8]  width_x_height (u64):
//         width  [31:0]         (pixel width; 0 refused)
//         height [63:32]        (pixel scanlines; 0 refused)
//   [+16] stride (u64):
//         stride [31:0]         (byte pitch; 0 refused)
//         reserved [63:32]
//   [+24] lfb_pa (u64)          -- physical base of the LFB
//   [+32] lfb_va (u64)          -- kernel VA the LFB is mapped at (via
//                                  platform_mmio_map with MMIO_WC=1)
//   [+40] owner_pid (u64)       -- 0 at R101 (compositor path arrives
//                                  at R105 with sys_framebuffer_create)
//
// Row-addressed capacity: FB_MAX = 4 rows. Rationale: T14 G4 has at
// most three concurrently active outputs; one KIND_FRAMEBUFFER per
// output with one headroom slot suffices. 4 * 48 = 192 bytes = 24 u64.
//
// =============================================================================
// SECTION 2  RIGHTS  --  R_FB_MAP | R_FB_FLIP | R_FB_REVOKE
// =============================================================================
//
// Per prompt: R_FB_MAP = 0x001, R_FB_FLIP = 0x002, R_FB_REVOKE = 0x004.
//
// R_FB_MAP    -- authority to obtain the WC-mapped kernel VA (read the
//                lfb_va field via QUERY op)
// R_FB_FLIP   -- authority to invoke fb_flush_via_backend against this
//                fb_slot (consumed at R101.M3-002 dispatch site)
// R_FB_REVOKE -- authority to tear down the row (consumed by
//                kind_framebuffer_revoke_body)
//
// R_FB_ALL = 0x007. Subset test in fb_rights_valid.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB40..0xFFFFEB4F
// =============================================================================
//
// Landing-time audit: 0xFFFFEB40..0xFFFFEB4F entirely free (disjoint
// from KIND_TUI_CANVAS's 0xFFFFEB10..1F, KIND_TLS_TRUST's 0xFFFFEB20..
// 27, KIND_NIC's 0xFFFFEB28..2F, KIND_DISPLAY_BACKEND's 0xFFFFEB30..3F).
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag 0x1AF stages through r11 for `cmp reg, imm`. Row fields are
// full u64 words; no mov_b/w/d for row loads. No `test`, no `add reg,
// [mem]`, no `cmp reg, [mem]`. Labels prefixed `fb_` (kind-framebuffer).

module KindFramebuffer = structure {

  pub let KIND_FRAMEBUFFER      : u64 = 0x1AF
  pub let KIND_FRAMEBUFFER_BASE : u64 = 4         // = KIND_MEMORY

  // Pixel format enum (§1).
  pub let FB_FMT_NONE     : u64 = 0
  pub let FB_FMT_BGRA8888 : u64 = 1
  pub let FB_FMT_MAX      : u64 = 1

  // Rights (§2).
  pub let R_FB_MAP    : u64 = 0x001
  pub let R_FB_FLIP   : u64 = 0x002
  pub let R_FB_REVOKE : u64 = 0x004
  pub let R_FB_ALL    : u64 = 0x007

  // Ops. QUERY family only at R101.M3; FLIP/REVOKE arrive at R105.
  pub let FB_OP_QUERY_WIDTH  : u64 = 0
  pub let FB_OP_QUERY_HEIGHT : u64 = 1
  pub let FB_OP_QUERY_STRIDE : u64 = 2
  pub let FB_OP_QUERY_FORMAT : u64 = 3
  pub let FB_OP_QUERY_VA     : u64 = 4
  pub let FB_OP_MAX          : u64 = 4

  // Failure taxonomy (§3). 0xFFFFEB40..0xFFFFEB4F band.
  pub let FB_OK              : u64 = 0
  pub let FB_MINT_BAD_MEMORY : u64 = 0xFFFFEB4F
  pub let FB_MINT_BAD_BACKEND: u64 = 0xFFFFEB4E
  pub let FB_MINT_BAD_FMT    : u64 = 0xFFFFEB4D
  pub let FB_MINT_BAD_DIMS   : u64 = 0xFFFFEB4C
  pub let FB_MINT_BAD_STRIDE : u64 = 0xFFFFEB4B
  pub let FB_MINT_BAD_RIGHTS : u64 = 0xFFFFEB4A
  pub let FB_TAIL_BAD_ARG    : u64 = 0xFFFFEB49
  pub let FB_TAIL_ENOSPC     : u64 = 0xFFFFEB48
  pub let FB_BAD_SLOT        : u64 = 0xFFFFEB47

  pub let FB_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let FB_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let FB_MAX       : u64 = 4
  pub let FB_ROW_BYTES : u64 = 48

  // Dimension ceiling: 8192x8192 is well above any panel the T14 G4
  // supports (max ~5K = 5120x2880); protects against a caller supplying
  // an unreasonable geometry that would overflow width*height*4 arithmetic.
  pub let FB_DIM_MAX : u64 = 8192

  // 4 rows * 48 bytes = 192 bytes = 24 u64. Extra u64 pads the tail
  // so tail_alloc's row-address compute can safely dereference [row+40]
  // without straddling the array end.
  pub let mut _fb_table : [u64; 24] = uninit @align(64)
  pub let mut _fb_stats : [u64; 4]  = uninit @align(32)

  // R103.M3-003 (paideia-os #2164): pair_slot_optional parallel table.
  // One u64 per row; 0 = no pair (single-buffered), otherwise carries
  // the row_id of the alternate KIND_FRAMEBUFFER that a page-flip
  // alternates with. Consumed by the R103 virtio-gpu double-flip witness
  // + any future compositor's swap chain. Kept as a parallel table (not
  // in-row) so the 48-byte layout every existing accessor uses stays
  // untouched -- widening the row would ripple through fb_row_valid /
  // fb_tail_alloc / fb_row_addr / every fb_row_* getter with no gain.
  pub let mut _fb_pair_table : [u64; 4] = uninit @align(32)

  pub let FB_ST_MINTS   : u64 = 0
  pub let FB_ST_FLUSHES : u64 = 1
  pub let FB_ST_REFUSED : u64 = 2

  // Fingerprint (all-lowercase, no OK_TOK). NUL-terminated.
  pub let fb_mint_ok_msg : [u8; 25] = "r101 framebuffer mint ok\0"

  // ==========================================================================
  // fb_table_reset() -> ()
  // ==========================================================================
  pub let fb_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: clear every _fb_table row + counters. Boot and teardown only. .bss zero at real boot; defensive re-scrub. Mirrors dpyb_table_reset one-for-one. Labels prefixed fb_rs_.",
      block: {
        lea r10, [rip + _fb_table];
        xor rax, rax;
        xor rcx, rcx;
      fb_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 24;
        jb  fb_rs_rows;

        lea r10, [rip + _fb_stats];
        xor rcx, rcx;
      fb_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  fb_rs_stats;

        // R103.M3-003: scrub parallel pair-slot table.
        lea r10, [rip + _fb_pair_table];
        xor rcx, rcx;
      fb_rs_pair:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  fb_rs_pair;
        ret
      }
    }

  // R103.M3-003: pair-slot getter/setter for double-buffer coordination.

  pub let fb_row_pair_get : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R103.M3-003: read _fb_pair_table[row_id]. Returns 0 if row_id out of range OR no pair set. Labels prefixed fb_pg_.",
      block: {
        push r12;
        mov r12, rdi;
        call fb_row_valid;
        cmp rax, 0;
        je  fb_pg_zero;
        lea r10, [rip + _fb_pair_table];
        mov rax, [r10 + r12 * 8];
        jmp fb_pg_out;
      fb_pg_zero:
        xor rax, rax;
      fb_pg_out:
        pop r12;
        ret
      }
    }

  pub let fb_row_pair_set : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64, pair_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R103.M3-003: write _fb_pair_table[row_id] = pair_row. Returns 0 on success, FB_BAD_SLOT if row not live. Labels prefixed fb_ps_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        call fb_row_valid;
        cmp rax, 0;
        je  fb_ps_bad;
        lea r10, [rip + _fb_pair_table];
        mov [r10 + r12 * 8], r13;
        xor rax, rax;
        jmp fb_ps_out;
      fb_ps_bad:
        mov rax, 0xFFFFEB47;                     // FB_BAD_SLOT
      fb_ps_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let fb_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: bounded stats increment; out-of-range no-op. Load-inc-store idiom. Labels prefixed fb_nt_.",
      block: {
        cmp rdi, 4;
        jae fb_nt_out;
        lea r10, [rip + _fb_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      fb_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let fb_dim_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M3-001: 1 iff v in [1, FB_DIM_MAX = 8192]. Zero refused (a fb with zero rows/cols is not scan-out). Labels prefixed fb_dv_.",
      block: {
        cmp rdi, 1;
        jb  fb_dv_no;
        mov r10, 8192;
        cmp rdi, r10;
        ja  fb_dv_no;
        mov rax, 1;
        ret;
      fb_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let fb_fmt_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M3-001: 1 iff f in [1, FB_FMT_MAX = 1] (only BGRA8888 at this landing). Zero refused. Labels prefixed fb_fv_.",
      block: {
        cmp rdi, 1;
        jne fb_fv_no;
        mov rax, 1;
        ret;
      fb_fv_no:
        xor rax, rax;
        ret
      }
    }

  pub let fb_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M3-001: subset test against R_FB_ALL = 0x007. Labels prefixed fb_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x007;
        and rax, r10;
        cmp rax, rdi;
        jne fb_rv_no;
        mov rax, 1;
        ret;
      fb_rv_no:
        xor rax, rax;
        ret
      }
    }

  // KIND_MEMORY derivation gate. Mirrors tui_check_memory one-for-one.
  pub let fb_check_memory : (u64) -> u64 !{mem} @{cap} =
    fn (memory_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R101.M3-001: derivation gate. parent.kind == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200). Structurally identical to tui_check_memory. Labels prefixed fb_cm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae fb_cm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne fb_cm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  fb_cm_no;

        mov rax, 1;
        ret;
      fb_cm_no:
        xor rax, rax;
        ret
      }
    }

  // fb_check_backend(backend_row_id) -> 1 iff row_id names a live
  // KIND_DISPLAY_BACKEND row. Uses dpyb_row_valid (kind_display_backend.
  // pdx). This is the CROSS-CAP invariant §4.2 documents: a framebuffer
  // must name the backend whose flush op will consume it, so the two
  // caps stay coherent.
  pub let fb_check_backend : (u64) -> u64 !{mem} @{} =
    fn (backend_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: 1 iff backend_row < DPYB_MAX(4) and its in_use bit is set. Called after fb_check_memory to bind the framebuffer to a live backend row. Labels prefixed fb_cb_.",
      block: {
        call dpyb_row_valid;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  // fb_hdr_pack(backend_kind, pixel_format) -> hdr | FB_DECODE_BAD.
  pub let fb_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (backend_kind: u64) (pixel_format: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M3-001: packs backend_kind[7:0] | pixel_format[15:8]. backend_kind in [1,4] (DPYB_KIND_MAX); pixel_format in [1,1] (BGRA8888). Out-of-range -> FB_DECODE_BAD. Labels prefixed fb_hp_.",
      block: {
        cmp rdi, 1;
        jb  fb_hp_bad;
        mov r10, 4;
        cmp rdi, r10;
        ja  fb_hp_bad;
        cmp rsi, 1;
        jne fb_hp_bad;

        mov rax, rdi;                    // backend_kind [7:0]
        mov r10, rsi;
        shl r10, 8;                      // pixel_format [15:8]
        or  rax, r10;
        ret;

      fb_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // fb_pack_wh(width, height) -> width[31:0] | height[63:32].
  pub let fb_pack_wh : (u64, u64) -> u64 !{} @{} =
    fn (width: u64) (height: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R101.M3-001: pack width[31:0] | height[63:32] per §1 row layout +8. Labels prefixed fb_pw_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // Row pool: row_valid / tail_alloc / tail_free / row accessors.
  // ==========================================================================

  pub let fb_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: 1 iff idx < FB_MAX(4) and in_use byte set. Inlined address compute (idx*48 = idx*32 + idx*16 via two shl + add). Labels prefixed fb_rv2_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae fb_rv2_no;
        lea r10, [rip + _fb_table];
        mov r11, rdi;
        shl r11, 5;                      // idx * 32
        mov r9, rdi;
        shl r9, 4;                       // idx * 16
        add r11, r9;                     // idx * 48
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fb_rv2_no;
        mov rax, 1;
        ret;
      fb_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // fb_row_addr(idx) -> &_fb_table[idx*48]. Caller must have already
  // validated idx via fb_row_valid.
  pub let fb_row_addr : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: address compute helper. idx*48 = idx*32 + idx*16. Labels prefixed fb_ra_.",
      block: {
        lea rax, [rip + _fb_table];
        mov r10, rdi;
        shl r10, 5;
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        ret
      }
    }

  // fb_tail_alloc(hdr, wh_packed, stride, lfb_pa, lfb_va, owner_pid)
  //   -> row_id | FB_TAIL_*
  //
  // paideia-as caps SysV register args at 6; every arg fits.
  pub let fb_tail_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (wh_packed: u64) (stride: u64) (lfb_pa: u64) (lfb_va: u64) (owner_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: claim one KIND_FRAMEBUFFER row. THE ONLY WRITER of _fb_table on the allocate path. Refuses hdr in_use pre-set (bits [63:56] non-zero) -> FB_TAIL_BAD_ARG. Low-first scan over 4 rows of 48 bytes. Writes wh_packed / stride / lfb_pa / lfb_va / owner_pid first; header last with in_use=1 OR'd. Five callee-save pushes preserve six live args. Labels prefixed fb_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // hdr
        mov r12, rsi;                    // wh_packed
        mov r13, rdx;                    // stride
        mov r14, rcx;                    // lfb_pa
        mov r15, r8;                     // lfb_va
        // owner_pid stays in r9

        // hdr in_use pre-set?
        mov rax, rbx;
        shr rax, 56;
        cmp rax, 0;
        jne fb_ta_bad;

        xor rcx, rcx;                    // row cursor idx = 0
      fb_ta_scan:
        cmp rcx, 4;
        jae fb_ta_enospc;

        lea r10, [rip + _fb_table];
        mov r11, rcx;
        shl r11, 5;                      // idx * 32
        mov rax, rcx;
        shl rax, 4;                      // idx * 16
        add r11, rax;                    // idx * 48
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fb_ta_claim;

        add rcx, 1;
        jmp fb_ta_scan;

      fb_ta_claim:
        mov [r10 + 8],  r12;             // width_x_height
        mov [r10 + 16], r13;             // stride
        mov [r10 + 24], r14;             // lfb_pa
        mov [r10 + 32], r15;             // lfb_va
        mov [r10 + 40], r9;              // owner_pid

        mov rax, rbx;                    // hdr
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;              // header last (publish in_use)

        mov rax, rcx;                    // row_id
        jmp fb_ta_out;

      fb_ta_enospc:
        mov rax, 0xFFFFEB48;             // FB_TAIL_ENOSPC
        jmp fb_ta_out;
      fb_ta_bad:
        mov rax, 0xFFFFEB49;             // FB_TAIL_BAD_ARG

      fb_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fb_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: scrub one row (all six u64 words). Labels prefixed fb_tf_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae fb_tf_out;
        lea r10, [rip + _fb_table];
        mov r11, rdi;
        shl r11, 5;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      fb_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors -- consumed by fb_flush_via_backend (§ R101.M3-002)
  // and backend_flush (§ R101.M2-004).
  // ==========================================================================

  // fb_row_width(idx) -> width | FB_DECODE_BAD.
  pub let fb_row_width : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: extract width[31:0] from row[+8]. Labels prefixed fb_rw_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call fb_row_valid;
        cmp rax, 0;
        je  fb_rw_bad;
        mov rdi, rbx;
        call fb_row_addr;
        mov r10, rax;
        mov rax, [r10 + 8];
        and rax, 0xFFFFFFFF;
        pop rbx;
        ret;
      fb_rw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // fb_row_height(idx) -> height | FB_DECODE_BAD.
  pub let fb_row_height : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: extract height[63:32] from row[+8]. Labels prefixed fb_rh_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call fb_row_valid;
        cmp rax, 0;
        je  fb_rh_bad;
        mov rdi, rbx;
        call fb_row_addr;
        mov r10, rax;
        mov rax, [r10 + 8];
        shr rax, 32;
        pop rbx;
        ret;
      fb_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let fb_row_stride : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M3-001: extract stride[31:0] from row[+16]. Labels prefixed fb_rs2_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call fb_row_valid;
        cmp rax, 0;
        je  fb_rs2_bad;
        mov rdi, rbx;
        call fb_row_addr;
        mov r10, rax;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        pop rbx;
        ret;
      fb_rs2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

