// src/kernel/core/cap/kind_wifi_key.pdx — R38.M5-001 (#1309)
//
// KIND_WIFI_KEY = 0x17B, SEALED, derived over KIND_MEMORY (base slot 4).
//
// The authority to hold ONE 802.11 cryptographic key WITHOUT the
// material.  A holder can identify the key (key_key), can point at
// the KIND_MEMORY slot that names its backing store, can query its
// algorithm and key_id -- but CANNOT extract the key bytes.  The
// crypto server (R32) is the one process that unseals; every other
// holder passes the SEALED reference across a boundary that never
// carries raw material.
//
// =============================================================================
// §0  WHY THIS KIND IS SEALED
// =============================================================================
//
// A WiFi PTK / GTK / IGTK is a shared secret that authorises frame
// encryption on a link.  A capability that let its holder read the
// bytes would be equivalent to the bytes themselves -- a serialised
// cap over IPC could then leak material to any process that can
// receive a u64.  design/roadmap/next-wave-softarch.md §358: "sealed
// so an application can hold the cap without the material; only the
// crypto server can unseal".
//
// The seal is enforced structurally in three ways:
//
//   (1) R_WKEY_READ is DELIBERATELY ABSENT from R_WKEY_ALL.  A mint
//       request with R_READ set trips the subset test and is refused
//       WKEY_MINT_BAD_RIGHTS.
//   (2) There is NO op in this kind that reads material.  The
//       enumerated op set covers key_key, memory_slot, algo, key_id,
//       sealed_flag, sealed_len, bind_to_hw, debug_print -- none of
//       them expose the underlying bytes.  An op above WKEY_OP_MAX
//       returns UNSUPPORTED.
//   (3) The row itself carries sealed_flag = 1 in body1[55:48], set
//       by wkey_body1_pack and never rewritten.  Downstream consumers
//       assert SEALED through wkey_row_sealed_flag without re-reading
//       rights.
//
// The witness (tests/kernel/cap/wifi_key_synth.pdx) asserts (2) and
// (3) directly, and asserts (1) by refusing a mint with R_READ set.
//
// =============================================================================
// §1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The gate demands `kind == KIND_MEMORY (4)` carrying RIGHT_MINT.  A
// mint additionally requires:
//
//   (a) key_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) memory_slot names a live KIND_MEMORY (BAD_MEMORY)
//   (c) algo in {0=CCMP-128, 1=GCMP-256, 2=CMAC} (BAD_ALGO)
//   (d) key_id in [0, 7] (0..3 broadcast/group, 4..7 pairwise per
//       802.11-2020 §12.7.6) (BAD_KEY_ID)
//   (e) sealed_len in {16, 32} (BAD_LEN)
//   (f) sealed_flag frozen at 1 (SEALED)
//   (g) rights subset of R_WKEY_ALL; NO R_READ; NO R_MINT
//
// =============================================================================
// §2  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  key_key    (u64)
//   [+16] body1:   memory_slot[31:0] | algo[39:32] | key_id[47:40]
//                | sealed_flag[55:48] | sealed_len[63:56]
//   [+24] reserved (0)
//
// Every field is set once at mint and no primitive in this module
// mutates any of them.  Revoke scrubs the entire row.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF3E0..0xFFFFF3EF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: net80211_regdom
// 0xFFFFF3F0..FF; adjacent free band below: wpa3_sae 0xFFFFF3D0..DF).

module KindWifiKey = structure {

  pub let KIND_WIFI_KEY        : u64 = 0x17B
  pub let WKEY_PARENT_KIND     : u64 = 4        // = KIND_MEMORY

  // §1c algorithm ordinals.
  pub let WKEY_ALGO_CCMP128    : u64 = 0
  pub let WKEY_ALGO_GCMP256    : u64 = 1
  pub let WKEY_ALGO_CMAC       : u64 = 2
  pub let WKEY_ALGO_MAX        : u64 = 2

  // §1d key_id.  0..3 broadcast/group per 802.11-2020 §12.7.6.
  pub let WKEY_KEY_ID_MAX      : u64 = 7

  // §1e sealed_len.
  pub let WKEY_LEN_16          : u64 = 16
  pub let WKEY_LEN_32          : u64 = 32

  // Rights.  SEALED: R_READ (0x001) OUTSIDE the mask, R_MINT (0x200) OUTSIDE
  // the mask.  The absence of R_READ is the whole point of the SEAL.
  pub let R_WKEY_INVOKE  : u64 = 0x008
  pub let R_WKEY_REVOKE  : u64 = 0x010
  pub let R_WKEY_OBSERVE : u64 = 0x400
  pub let R_WKEY_ALL     : u64 = 0x418
  pub let R_WKEY_READ    : u64 = 0x001            // SEALED gate refuses
  pub let R_WKEY_MINT    : u64 = 0x200            // never granted on a leaf key

  // Ops -- NO material-reading op exists.
  pub let WKEY_OP_QUERY_KEY         : u64 = 0
  pub let WKEY_OP_QUERY_MEMORY      : u64 = 1
  pub let WKEY_OP_QUERY_ALGO        : u64 = 2
  pub let WKEY_OP_QUERY_KEY_ID      : u64 = 3
  pub let WKEY_OP_QUERY_SEALED_LEN  : u64 = 4
  pub let WKEY_OP_QUERY_SEALED_FLAG : u64 = 5
  pub let WKEY_OP_BIND_TO_HW        : u64 = 6
  pub let WKEY_OP_DEBUG_PRINT       : u64 = 7
  pub let WKEY_OP_MAX               : u64 = 7

  // Failure taxonomy 0xFFFFF3E0..0xFFFFF3EF.
  pub let WKEY_OK                : u64 = 0
  pub let WKEY_TAIL_ENOSPC       : u64 = 0xFFFFF3EF
  pub let WKEY_TAIL_BAD_ARG      : u64 = 0xFFFFF3EE
  pub let WKEY_MINT_BAD_PARENT   : u64 = 0xFFFFF3ED
  pub let WKEY_MINT_BAD_RIGHTS   : u64 = 0xFFFFF3EC
  pub let WKEY_MINT_BAD_MEMORY   : u64 = 0xFFFFF3EB
  pub let WKEY_MINT_BAD_ALGO     : u64 = 0xFFFFF3EA
  pub let WKEY_MINT_BAD_KEY_ID   : u64 = 0xFFFFF3E9
  pub let WKEY_MINT_BAD_LEN      : u64 = 0xFFFFF3E8
  pub let WKEY_MINT_NO_KEY       : u64 = 0xFFFFF3E7
  pub let WKEY_MINT_IN_USE       : u64 = 0xFFFFF3E6
  pub let WKEY_MINT_ENOSPC       : u64 = 0xFFFFF3E5
  pub let WKEY_BAD_SLOT          : u64 = 0xFFFFF3E4
  pub let WKEY_WRONG_KIND        : u64 = 0xFFFFF3E3
  pub let WKEY_REVOKE_ALREADY    : u64 = 0xFFFFF3E2
  pub let WKEY_SEALED_REFUSED    : u64 = 0xFFFFF3E1  // any material-read attempt
  pub let WKEY_UNUSED_A          : u64 = 0xFFFFF3E0

  pub let WKEY_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let WKEY_ROW_NONE   : u64 = 0xFF

  pub let WKEY_MAX       : u64 = 8
  pub let WKEY_ROW_BYTES : u64 = 32

  pub let mut _wifi_key_table : [u64; 32] = uninit @align(64)
  pub let mut _wifi_key_stats : [u64; 4]  = uninit @align(64)

  pub let WKEY_ST_MINTS   : u64 = 0
  pub let WKEY_ST_REVOKES : u64 = 1
  pub let WKEY_ST_REFUSED : u64 = 2
  pub let WKEY_ST_QUERIES : u64 = 3

  pub let wkey_dbg_msg : [u8; 13] = "WIFI KEY ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let wifi_key_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): clear KIND_WIFI_KEY row table and counters. Labels prefixed wkey_rs_.",
      block: {
        lea r10, [rip + _wifi_key_table];
        xor rax, rax;
        xor rcx, rcx;
      wkey_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  wkey_rs_rows;

        lea r10, [rip + _wifi_key_stats];
        xor rcx, rcx;
      wkey_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  wkey_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let wkey_algo_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-001 (#1309): 1 iff a <= WKEY_ALGO_MAX. Labels prefixed wkey_av_.",
      block: {
        cmp rdi, 2;
        ja  wkey_av_no;
        mov rax, 1;
        ret;
      wkey_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let wkey_key_id_valid : (u64) -> u64 !{} @{} =
    fn (k: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-001 (#1309): 1 iff k <= WKEY_KEY_ID_MAX (7). Labels prefixed wkey_kv_.",
      block: {
        cmp rdi, 7;
        ja  wkey_kv_no;
        mov rax, 1;
        ret;
      wkey_kv_no:
        xor rax, rax;
        ret
      }
    }

  pub let wkey_len_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-001 (#1309): 1 iff l is 16 or 32. Labels prefixed wkey_lv_.",
      block: {
        cmp rdi, 16;
        je  wkey_lv_yes;
        cmp rdi, 32;
        je  wkey_lv_yes;
        xor rax, rax;
        ret;
      wkey_lv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let wkey_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-001 (#1309): subset test against R_WKEY_ALL = 0x418. SEALED: R_READ (0x001) OUTSIDE the mask -- any mint request carrying R_READ fails here. Labels prefixed wkey_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x418;
        and rax, r10;
        cmp rax, rdi;
        jne wkey_rgv_no;
        mov rax, 1;
        ret;
      wkey_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let wkey_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): counter bump. Labels prefixed wkey_nt_.",
      block: {
        cmp rdi, 4;
        jae wkey_nt_out;
        lea r10, [rip + _wifi_key_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wkey_nt_out:
        ret
      }
    }

  pub let wkey_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): counter read. Labels prefixed wkey_stt_.",
      block: {
        cmp rdi, 4;
        jae wkey_stt_zero;
        lea r10, [rip + _wifi_key_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wkey_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent + KIND_MEMORY gates.
  // ==========================================================================

  pub let wkey_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): parent must be live KIND_MEMORY (4) with RIGHT_MINT. Labels prefixed wkey_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wkey_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;
        jne wkey_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  wkey_cp_no;

        mov rax, 1;
        ret;
      wkey_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let wkey_check_memory : (u64) -> u64 !{mem} @{cap} =
    fn (memory_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): memory_slot must name a live KIND_MEMORY (4). Labels prefixed wkey_cm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wkey_cm_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;
        jne wkey_cm_no;

        mov rax, 1;
        ret;
      wkey_cm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  pub let wkey_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-001 (#1309): (parent_slot << 8). Labels prefixed wkey_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae wkey_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      wkey_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // Body1: memory_slot[31:0] | algo[39:32] | key_id[47:40] |
  //        sealed_flag[55:48]=1 | sealed_len[63:56].
  pub let wkey_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (memory_slot: u64) (algo: u64) (key_id: u64) (sealed_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-001 (#1309): pack body1. sealed_flag FROZEN at 1 -- the SEAL is a row-level invariant that no path in this module rewrites. Labels prefixed wkey_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  wkey_b1_bad;
        cmp rsi, 0xFF;
        ja  wkey_b1_bad;
        cmp rdx, 0xFF;
        ja  wkey_b1_bad;
        cmp rcx, 0xFF;
        ja  wkey_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;

        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;

        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;

        // sealed_flag frozen at 1 in [55:48].
        mov r10, 1;
        shl r10, 48;
        or  rax, r10;

        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      wkey_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _wifi_key_table.
  // ==========================================================================

  pub let wkey_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (key_key: u64) (body1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): claim one KEY row. THE ONE WRITER. Labels prefixed wkey_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne wkey_ta_bad;

        cmp r13, 0;
        je  wkey_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  wkey_ta_bad;

        xor rbx, rbx;
      wkey_ta_scan:
        cmp rbx, 8;
        jae wkey_ta_enospc;

        lea r10, [rip + _wifi_key_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wkey_ta_claim;

        add rbx, 1;
        jmp wkey_ta_scan;

      wkey_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp wkey_ta_out;

      wkey_ta_enospc:
        mov rax, 0xFFFFF3EF;
        jmp wkey_ta_out;
      wkey_ta_bad:
        mov rax, 0xFFFFF3EE;

      wkey_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let wkey_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): 1 iff row_id<MAX and in_use. Labels prefixed wkey_tvr_.",
      block: {
        cmp rdi, 8;
        jae wkey_tvr_no;
        lea r10, [rip + _wifi_key_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wkey_tvr_no;
        mov rax, 1;
        ret;
      wkey_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let wkey_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): scrub one row. Labels prefixed wkey_tf_.",
      block: {
        cmp rdi, 8;
        jae wkey_tf_out;
        lea r10, [rip + _wifi_key_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      wkey_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.  None of them expose material.
  // ==========================================================================

  pub let wkey_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): key_key. Labels prefixed wkey_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_rk_bad;
        lea r10, [rip + _wifi_key_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp wkey_rk_out;
      wkey_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wkey_rk_out:
        pop r12;
        ret
      }
    }

  pub let wkey_row_memory : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): memory_slot (body1[31:0]). Labels prefixed wkey_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_rm_bad;
        lea r10, [rip + _wifi_key_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp wkey_rm_out;
      wkey_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wkey_rm_out:
        pop r12;
        ret
      }
    }

  pub let wkey_row_algo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): algo (body1[39:32]). Labels prefixed wkey_ra_.",
      block: {
        push r12;
        mov r12, rdi;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_ra_bad;
        lea r10, [rip + _wifi_key_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFF;
        jmp wkey_ra_out;
      wkey_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wkey_ra_out:
        pop r12;
        ret
      }
    }

  pub let wkey_row_key_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): key_id (body1[47:40]). Labels prefixed wkey_rki_.",
      block: {
        push r12;
        mov r12, rdi;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_rki_bad;
        lea r10, [rip + _wifi_key_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 40;
        and rax, 0xFF;
        jmp wkey_rki_out;
      wkey_rki_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wkey_rki_out:
        pop r12;
        ret
      }
    }

  pub let wkey_row_sealed_flag : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): sealed_flag (body1[55:48]). SEALED §0 gate 3: frozen at 1 at mint. Labels prefixed wkey_rsf_.",
      block: {
        push r12;
        mov r12, rdi;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_rsf_bad;
        lea r10, [rip + _wifi_key_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp wkey_rsf_out;
      wkey_rsf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wkey_rsf_out:
        pop r12;
        ret
      }
    }

  pub let wkey_row_sealed_len : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): sealed_len (body1[63:56]). Length of the sealed material -- NOT the material itself. Labels prefixed wkey_rsl_.",
      block: {
        push r12;
        mov r12, rdi;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_rsl_bad;
        lea r10, [rip + _wifi_key_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        and rax, 0xFF;
        jmp wkey_rsl_out;
      wkey_rsl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wkey_rsl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let wkey_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (key_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-001 (#1309): live row holding key_key, or ROW_NONE. Labels prefixed wkey_fk_.",
      block: {
        cmp rdi, 0;
        je  wkey_fk_none;
        xor rcx, rcx;
      wkey_fk_scan:
        cmp rcx, 8;
        jae wkey_fk_none;
        lea r10, [rip + _wifi_key_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wkey_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  wkey_fk_hit;
      wkey_fk_next:
        add rcx, 1;
        jmp wkey_fk_scan;
      wkey_fk_hit:
        mov rax, rcx;
        ret;
      wkey_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let wkey_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): slot -> row_id, gated on live KIND_WIFI_KEY. Labels prefixed wkey_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae wkey_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x17B;
        cmp r10, r11;
        jne wkey_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_ros_none;

        mov rax, r12;
        jmp wkey_ros_out;

      wkey_ros_none:
        mov rax, 0xFF;
      wkey_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Six args: (slot, parent_slot, rights, key_key, memory_slot,
  // meta).  `meta` packs algo/key_id/sealed_len into one u64 so the
  // whole signature fits in the SysV ABI's six-register window:
  //
  //   meta[7:0]   = algo
  //   meta[15:8]  = key_id
  //   meta[23:16] = sealed_len
  //   meta[63:24] = reserved (0)
  //
  // A caller that packs meta from validated fields cannot smuggle
  // extra bits; the callee unpacks with 0xFF masks and refuses a
  // non-zero reserved region as BAD_ARG.
  //
  // Sequence: slot<256; rights_valid (SEALED gate 1: R_READ absent
  // from R_WKEY_ALL); check_parent; check_memory; algo/key_id/len
  // validators; key_key non-zero (NO_KEY); uniqueness (IN_USE);
  // body1_pack (SEALED gate 3: sealed_flag frozen at 1); tail_alloc;
  // cap_mint_write.
  // ==========================================================================

  // Helper packer for meta.
  pub let wkey_meta_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (algo: u64) (key_id: u64) (sealed_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-001 (#1309): pack (algo, key_id, sealed_len) into one u64. Labels prefixed wkey_mp_.",
      block: {
        cmp rdi, 0xFF;
        ja  wkey_mp_bad;
        cmp rsi, 0xFF;
        ja  wkey_mp_bad;
        cmp rdx, 0xFF;
        ja  wkey_mp_bad;
        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      wkey_mp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wifi_key_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (key_key: u64) (memory_slot: u64) (meta: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): mint KIND_WIFI_KEY. SEALED TRIPLE-CHECK -- gate 1: R_READ absent from R_WKEY_ALL (rights_valid refuses); gate 2: no material-read op exists; gate 3: sealed_flag frozen at 1 in the row body. Labels prefixed wkey_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // key_key
        mov rbp, r8;                     // memory_slot
        mov r15, r9;                     // meta

        // Reject reserved bits [63:24] in meta.
        mov r10, r15;
        shr r10, 24;
        cmp r10, 0;
        jne wkey_mi_bad_algo;

        mov r10, 256;
        cmp rbx, r10;
        jae wkey_mi_bad_slot;

        // SEALED gate 1: rights subset of R_WKEY_ALL.  R_READ (0x001)
        // OUTSIDE the mask -- a request carrying R_READ trips here.
        mov rdi, r13;
        call wkey_rights_valid;
        cmp rax, 0;
        je  wkey_mi_bad_rights;

        mov rdi, r12;
        call wkey_check_parent;
        cmp rax, 0;
        je  wkey_mi_bad_parent;

        mov rdi, rbp;
        call wkey_check_memory;
        cmp rax, 0;
        je  wkey_mi_bad_memory;

        // Unpack meta.
        mov rdi, r15;
        and rdi, 0xFF;                   // algo
        call wkey_algo_valid;
        cmp rax, 0;
        je  wkey_mi_bad_algo;

        mov rdi, r15;
        shr rdi, 8;
        and rdi, 0xFF;                   // key_id
        call wkey_key_id_valid;
        cmp rax, 0;
        je  wkey_mi_bad_key_id;

        mov rdi, r15;
        shr rdi, 16;
        and rdi, 0xFF;                   // sealed_len
        call wkey_len_valid;
        cmp rax, 0;
        je  wkey_mi_bad_len;

        cmp r14, 0;
        je  wkey_mi_no_key;

        mov rdi, r14;
        call wkey_find_by_key;
        cmp rax, 0xFF;
        jne wkey_mi_in_use;

        // Body1 pack: (memory_slot, algo, key_id, sealed_len).
        mov rdi, rbp;
        mov rsi, r15;
        and rsi, 0xFF;                   // algo
        mov rdx, r15;
        shr rdx, 8;
        and rdx, 0xFF;                   // key_id
        mov rcx, r15;
        shr rcx, 16;
        and rcx, 0xFF;                   // sealed_len
        call wkey_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wkey_mi_bad_len;
        push rax;                        // body1 on stack

        // Header.
        mov rdi, r12;
        call wkey_hdr_pack;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wkey_mi_bad_parent;

        // tail_alloc(hdr, key_key, body1).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        call wkey_tail_alloc;

        mov r10, 0xFFFFF3EF;
        cmp rax, r10;
        je  wkey_mi_enospc;
        mov r10, 0xFFFFF3EE;
        cmp rax, r10;
        je  wkey_mi_bad_len;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x17B;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call wkey_note;

        xor rax, rax;
        jmp wkey_mi_out;

      wkey_mi_bad_slot:
        mov rax, 0xFFFFF3E4;
        jmp wkey_mi_out;
      wkey_mi_bad_parent:
        mov rax, 0xFFFFF3ED;
        jmp wkey_mi_out;
      wkey_mi_bad_rights:
        mov rdi, 2;
        call wkey_note;
        mov rax, 0xFFFFF3EC;
        jmp wkey_mi_out;
      wkey_mi_bad_memory:
        mov rax, 0xFFFFF3EB;
        jmp wkey_mi_out;
      wkey_mi_bad_algo:
        mov rax, 0xFFFFF3EA;
        jmp wkey_mi_out;
      wkey_mi_bad_key_id:
        mov rax, 0xFFFFF3E9;
        jmp wkey_mi_out;
      wkey_mi_bad_len:
        mov rax, 0xFFFFF3E8;
        jmp wkey_mi_out;
      wkey_mi_no_key:
        mov rax, 0xFFFFF3E7;
        jmp wkey_mi_out;
      wkey_mi_in_use:
        mov rdi, 2;
        call wkey_note;
        mov rax, 0xFFFFF3E6;
        jmp wkey_mi_out;
      wkey_mi_enospc:
        mov rdi, 2;
        call wkey_note;
        mov rax, 0xFFFFF3E5;

      wkey_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let wifi_key_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): revoke KIND_WIFI_KEY. Scrubs row and cap_table entry. Labels prefixed wkey_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae wkey_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  wkey_rvk_already;

        mov r11, 0x17B;
        cmp r10, r11;
        jne wkey_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call wkey_tail_valid;
        cmp rax, 0;
        je  wkey_rvk_clear;

        mov rdi, r13;
        call wkey_tail_free;

      wkey_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call wkey_note;

        xor rax, rax;
        jmp wkey_rvk_out;

      wkey_rvk_bad_slot:
        mov rax, 0xFFFFF3E4;
        jmp wkey_rvk_out;
      wkey_rvk_wrong_kind:
        mov rax, 0xFFFFF3E3;
        jmp wkey_rvk_out;
      wkey_rvk_already:
        mov rax, 0xFFFFF3E2;

      wkey_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  SEALED: NO OP READS MATERIAL.  Every op above
  // WKEY_OP_MAX returns UNSUPPORTED.  Every op with a non-zero
  // op_arg[63:8] is REFUSED as TAIL_BAD_ARG.
  // ==========================================================================

  pub let cap_handler_wifi_key : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R38.M5-001 (#1309): KIND_WIFI_KEY dispatch. SEALED: NO OP exposes material. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE; BIND_TO_HW requires INVOKE (crypto-server-scope pin). All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed wkey_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_wifi_key_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne wkey_hn_res;

        cmp rbp, 7;
        ja  wkey_hn_unsup;

        cmp rbp, 7;
        je  wkey_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  wkey_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  wkey_hn_key;
        cmp rbp, 1;
        je  wkey_hn_mem;
        cmp rbp, 2;
        je  wkey_hn_algo;
        cmp rbp, 3;
        je  wkey_hn_kid;
        cmp rbp, 4;
        je  wkey_hn_slen;
        cmp rbp, 5;
        je  wkey_hn_sflag;
        // rbp == 6: BIND_TO_HW.  Honesty pin: returns 0 until R32
        // crypto server unseals + programs the key registers.
        xor rax, rax;
        jmp wkey_hn_out;

      wkey_hn_key:
        call wkey_row_key;
        jmp wkey_hn_out;
      wkey_hn_mem:
        call wkey_row_memory;
        jmp wkey_hn_out;
      wkey_hn_algo:
        call wkey_row_algo;
        jmp wkey_hn_out;
      wkey_hn_kid:
        call wkey_row_key_id;
        jmp wkey_hn_out;
      wkey_hn_slen:
        call wkey_row_sealed_len;
        jmp wkey_hn_out;
      wkey_hn_sflag:
        call wkey_row_sealed_flag;
        jmp wkey_hn_out;

      wkey_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  wkey_hn_denied;
        xor rax, rax;
        jmp wkey_hn_out;

      wkey_hn_res:
        mov rax, 0xFFFFF3EE;
        jmp wkey_hn_out;
      wkey_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp wkey_hn_out;
      wkey_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      wkey_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
