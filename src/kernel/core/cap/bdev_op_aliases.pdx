// src/kernel/core/cap/bdev_op_aliases.pdx -- R51.M7-004 (#1672),
// landed alongside R51.M7-005 (#1673).
//
// SCHEDULED-RETIRE ALIAS MODULE. R52's design draft
// (design/filesystem/volume-fs-substrate.md §4.2, §5.3, §7.M6/M7)
// names the block-device op set with a `BD_OP_*` prefix throughout;
// R51's landed code (`cap_handler_blkdev.pdx`, module CapHandlerBlkdev)
// exports the same seven ops under `BDEV_OP_*`. Rather than force
// every R52 module to rename on R51's schedule (or block R52.M1 open
// on a cross-repo rename), this module re-exports each `BDEV_OP_*`
// ordinal under its `BD_OP_*` alias for one round.
//
// THESE ARE VALUE COPIES, NOT REFERENCES. This codebase has no
// cross-module constant-import syntax (every other alias in this
// tree -- e.g. kind_dma_domain.pdx's R_DMA_INVOKE "matches
// Rights.RIGHT_INVOKE" -- is a duplicated literal with a mirror
// comment, not a live binding) so the values below are copied from
// cap_handler_blkdev.pdx's BDEV_OP_* table by hand. If a future
// change renumbers an op there, THIS FILE MUST BE UPDATED IN THE SAME
// COMMIT or the alias silently diverges from the thing it aliases.
//
// SCHEDULED RETIREMENT: R53 open. Per design/hardware/
// nvme-ahci-tail-milestones.md §3.1/§5.1, R52 modules are expected to
// have renamed their own `BD_OP_*` call sites to `BDEV_OP_*` by then;
// this file is deleted at that point, not extended.
//
// Reserved-label discipline: no labels (constants only, no code).

module BdevOpAliases = structure {

  // Mirrors CapHandlerBlkdev.BDEV_OP_* (cap_handler_blkdev.pdx).
  pub let BD_OP_QUERY_GEOM     : u64 = 0   // matches CapHandlerBlkdev.BDEV_OP_QUERY_GEOM
  pub let BD_OP_QUERY_FAMILY   : u64 = 1   // matches CapHandlerBlkdev.BDEV_OP_QUERY_FAMILY
  pub let BD_OP_QUERY_FEATURES : u64 = 2   // matches CapHandlerBlkdev.BDEV_OP_QUERY_FEATURES
  pub let BD_OP_READ_LBA       : u64 = 3   // matches CapHandlerBlkdev.BDEV_OP_READ_LBA
  pub let BD_OP_WRITE_LBA      : u64 = 4   // matches CapHandlerBlkdev.BDEV_OP_WRITE_LBA
  pub let BD_OP_FLUSH          : u64 = 5   // matches CapHandlerBlkdev.BDEV_OP_FLUSH
  pub let BD_OP_TRIM           : u64 = 6   // matches CapHandlerBlkdev.BDEV_OP_TRIM

}
