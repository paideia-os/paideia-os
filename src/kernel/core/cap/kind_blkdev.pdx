// src/kernel/core/cap/kind_blkdev.pdx -- R51.M7-001 (#1669).
//
// KIND_BLKDEV = 0x42, unified block-device tail accessors.
//
// Design context
// --------------
// design/hardware/nvme-and-disk-substrate.md §4.1/§4.3 + design/
// hardware/nvme-ahci-tail-milestones.md §M7-001. KIND_BLKDEV (R24,
// cap/blkdev_cap.pdx) is dual-kind-minted over TWO different parent
// rows depending on family: NVMe namespaces (kind_nvme_namespace.pdx's
// nvme_ns_dual_kind_mint, R51.M2-004/#1642) and AHCI ports
// (kind_ahci_port.pdx's ahci_port_dual_kind_mint, R51.M5-006/#1662).
// Each family already carries its own 64-byte row
// (_nvme_namespace_table / _ahci_port_table) with the R51-extended
// tail fields (family/features/parent/attest_key, landed incrementally
// at M2/M5/M6 ahead of this ticket) plus, as of THIS issue,
// max_transfer_blocks + dma_domain_slot packed into each row's meta
// word high bits (kind_nvme_namespace.pdx / kind_ahci_port.pdx SECTION
// 1, both updated by #1669).
//
// This file is the "row-indirection via `_blkdev_row_table`" layer the
// design doc describes (§M7-001): rather than a literal third array,
// `_blkdev_row_table` is the union of the two existing per-family
// tables, disambiguated by the family byte every KIND_BLKDEV
// descriptor's target_ptr already carries at bits [23:16] (AHCI mints
// stamp it explicitly -- ahci_port_dual_kind_mint,
// AHCIP_FAMILY_AHCI<<16; NVMe mints currently leave it 0, which
// resolves to the same NVMe-family branch as family=1 everywhere below
// and throughout cap_handler_blkdev.pdx's own family-byte demux --
// DESIGN-DOC GAP, flagged in the final report). Every accessor below
// takes that packed target_ptr value (row_id in bits [15:0], family in
// bits [23:16]) -- exactly what a KIND_BLKDEV cap descriptor's
// target_ptr already is -- and dispatches to the matching per-family
// row accessor.
//
// Family bytes (softarch-visible enum, distinct from the internal
// NVMEN_FAMILY_* / AHCIP_FAMILY_* constants each per-family module
// keeps for its own self-contained use):
//
//   BDEV_FAMILY_LEGACY_NVME = 0  -- R24-era compat-shim mint (M7-003+)
//   BDEV_FAMILY_NVME        = 1
//   BDEV_FAMILY_AHCI        = 2
//
// _blkdev_legacy_view writes the R24 32-byte compat prefix
// (controller_idx/nsid/lba_size/block_count/rights, cap/blkdev_cap.pdx
// §Descriptor tail's R24-preserved 32-byte view) into a caller-owned
// buffer so R24-era
// readers (pdxfs_lite/mount_op.pdx) keep working unchanged; "rights"
// is not row data (it lives on the cap descriptor itself, cap_table +
// slot*24 + 8), so it is threaded through as an explicit argument
// rather than re-derived here.
//
// Failure taxonomy 0xFFFFECC0..0xFFFFECCF (design §M7-001, disjoint
// from every previous R51 band -- KIND_NVME_NAMESPACE claims
// 0xFFFFEC50..5F, KIND_AHCI_PORT 0xFFFFEC80..84 +spillover to 9F):
//
//   BDEVU_TAIL_ENOSPC  0xFFFFECC0  -- unused at M7-001 (no allocator
//                                     lives in this file); reserved
//                                     per the design doc's own listing
//   BDEVU_TAIL_BAD_ARG 0xFFFFECC1  -- family byte outside {0,1,2}
//
// paideia-as encoder-gap posture (v0.22.x)
// ----------------------------------------
//   G1: sized stores via mov_b for the legacy-view buffer's sub-8-byte
//       fields.
//   G4: full-register compares (zero-extend loads via prior xor) for
//       family-byte branches.
//
// Arity <= 6 throughout. Labels prefixed `blku_` per reserved-label
// discipline (distinct from blk_cap_ in blkdev_cap.pdx, nvmen_ in
// kind_nvme_namespace.pdx, ahcip_ in kind_ahci_port.pdx).

module KindBlkdev = structure {

  // ============================================================================
  // Family bytes
  // ============================================================================

  pub let BDEV_FAMILY_LEGACY_NVME : u64 = 0
  pub let BDEV_FAMILY_NVME        : u64 = 1
  pub let BDEV_FAMILY_AHCI        : u64 = 2

  // ============================================================================
  // Failure taxonomy
  // ============================================================================

  pub let BDEVU_TAIL_ENOSPC  : u64 = 0xFFFFECC0
  pub let BDEVU_TAIL_BAD_ARG : u64 = 0xFFFFECC1
  pub let BDEVU_DECODE_BAD   : u64 = 0xFFFFFFFFFFFFFFFF

  // ============================================================================
  // blkdev_row_family(target_ptr) -> u8 | BDEVU_DECODE_BAD
  // ============================================================================
  //
  // Extracts bits [23:16] directly from the cap descriptor's own
  // target_ptr -- no row access needed, the family byte is stamped
  // into the descriptor at mint time (mirrors cap_handler_blkdev.pdx's
  // own BDEV_OP_QUERY_FAMILY: "r15 already IS the validated family
  // byte"). Refuses (BDEVU_TAIL_BAD_ARG) a family outside {0,1,2} so
  // every OTHER blkdev_row_* accessor below can trust the demux.
  // ============================================================================
  pub let blkdev_row_family : (u64) -> u64 !{} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M7-001 (#1669): family byte, bits [23:16] of target_ptr. No memory access -- the family is stamped into the cap descriptor itself at mint time, not read from a row. Refuses BDEVU_TAIL_BAD_ARG outside {0,1,2}. Labels prefixed blku_fam_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        cmp rax, 2;
        ja  blku_fam_bad;
        ret;
      blku_fam_bad:
        mov rax, 0xFFFFECC1;             // BDEVU_TAIL_BAD_ARG
        ret
      }
    }

  // ============================================================================
  // blkdev_row_parent_slot(target_ptr) -> u16 | BDEVU_DECODE_BAD
  // ============================================================================
  pub let blkdev_row_parent_slot : (u64) -> u64 !{mem} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): parent_slot, dispatched by family byte (bits [23:16] of target_ptr) to nvme_ns_row_parent / ahci_port_row_parent, keyed by row_id (bits [15:0]). Family in {0,1} (LEGACY_NVME, NVME) both route to the NVMe table -- same grouping cap_handler_blkdev.pdx's own family demux already uses, since NVMe dual-kind mints today leave target_ptr's family bits at their zero default. Labels prefixed blku_ps_.",
      block: {
        push r12;
        mov r12, rdi;                    // target_ptr

        mov rax, r12;
        shr rax, 16;
        and rax, 0xFF;
        cmp rax, 2;
        je  blku_ps_ahci;
        ja  blku_ps_bad;

        mov rdi, r12;
        and rdi, 0xFFFF;
        call nvme_ns_row_parent;
        jmp blku_ps_out;

      blku_ps_ahci:
        mov rdi, r12;
        and rdi, 0xFFFF;
        call ahci_port_row_parent;
        jmp blku_ps_out;

      blku_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      blku_ps_out:
        pop r12;
        ret
      }
    }

  // ============================================================================
  // blkdev_row_features(target_ptr) -> u8 | BDEVU_DECODE_BAD
  // ============================================================================
  pub let blkdev_row_features : (u64) -> u64 !{mem} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): features bitmap, dispatched by family byte to nvme_ns_row_features / ahci_port_row_features. Same {0,1}->NVMe / {2}->AHCI grouping as blkdev_row_parent_slot. Labels prefixed blku_fe_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rax, r12;
        shr rax, 16;
        and rax, 0xFF;
        cmp rax, 2;
        je  blku_fe_ahci;
        ja  blku_fe_bad;

        mov rdi, r12;
        and rdi, 0xFFFF;
        call nvme_ns_row_features;
        jmp blku_fe_out;

      blku_fe_ahci:
        mov rdi, r12;
        and rdi, 0xFFFF;
        call ahci_port_row_features;
        jmp blku_fe_out;

      blku_fe_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      blku_fe_out:
        pop r12;
        ret
      }
    }

  // ============================================================================
  // blkdev_row_attest_key(target_ptr) -> u64 | BDEVU_DECODE_BAD
  // ============================================================================
  pub let blkdev_row_attest_key : (u64) -> u64 !{mem} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): attest_key, dispatched by family byte to nvme_ns_row_attest_key / ahci_port_row_attest_key. Same {0,1}->NVMe / {2}->AHCI grouping. Labels prefixed blku_ak_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rax, r12;
        shr rax, 16;
        and rax, 0xFF;
        cmp rax, 2;
        je  blku_ak_ahci;
        ja  blku_ak_bad;

        mov rdi, r12;
        and rdi, 0xFFFF;
        call nvme_ns_row_attest_key;
        jmp blku_ak_out;

      blku_ak_ahci:
        mov rdi, r12;
        and rdi, 0xFFFF;
        call ahci_port_row_attest_key;
        jmp blku_ak_out;

      blku_ak_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      blku_ak_out:
        pop r12;
        ret
      }
    }

  // ============================================================================
  // blkdev_row_max_transfer_blocks(target_ptr) -> u16 | BDEVU_DECODE_BAD
  // ============================================================================
  //
  // Zero for every row minted before M7-003 lands the per-family mint
  // entry points that compute a real value from MDTS (NVMe) /
  // PRDTL_max (AHCI). R51.M7-001 (#1669) only reserves + exposes the
  // field.
  // ============================================================================
  pub let blkdev_row_max_transfer_blocks : (u64) -> u64 !{mem} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): max_transfer_blocks, dispatched by family byte to nvme_ns_row_max_transfer_blocks / ahci_port_row_max_transfer_blocks. Zero until M7-003. Same {0,1}->NVMe / {2}->AHCI grouping. Labels prefixed blku_mt_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rax, r12;
        shr rax, 16;
        and rax, 0xFF;
        cmp rax, 2;
        je  blku_mt_ahci;
        ja  blku_mt_bad;

        mov rdi, r12;
        and rdi, 0xFFFF;
        call nvme_ns_row_max_transfer_blocks;
        jmp blku_mt_out;

      blku_mt_ahci:
        mov rdi, r12;
        and rdi, 0xFFFF;
        call ahci_port_row_max_transfer_blocks;
        jmp blku_mt_out;

      blku_mt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      blku_mt_out:
        pop r12;
        ret
      }
    }

  // ============================================================================
  // blkdev_row_dma_domain_slot(target_ptr) -> u8 | BDEVU_DECODE_BAD
  // ============================================================================
  //
  // Zero (unscoped) for every row minted before a driver process wires
  // this cap to a live KIND_DMA_DOMAIN (R51.M7-001 reserves + exposes
  // the field only).
  // ============================================================================
  pub let blkdev_row_dma_domain_slot : (u64) -> u64 !{mem} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): dma_domain_slot, dispatched by family byte to nvme_ns_row_dma_domain_slot / ahci_port_row_dma_domain_slot. Zero (unscoped) until wired. Same {0,1}->NVMe / {2}->AHCI grouping. Labels prefixed blku_ds_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rax, r12;
        shr rax, 16;
        and rax, 0xFF;
        cmp rax, 2;
        je  blku_ds_ahci;
        ja  blku_ds_bad;

        mov rdi, r12;
        and rdi, 0xFFFF;
        call nvme_ns_row_dma_domain_slot;
        jmp blku_ds_out;

      blku_ds_ahci:
        mov rdi, r12;
        and rdi, 0xFFFF;
        call ahci_port_row_dma_domain_slot;
        jmp blku_ds_out;

      blku_ds_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      blku_ds_out:
        pop r12;
        ret
      }
    }

  // ============================================================================
  // _blkdev_legacy_view(target_ptr, rights, out_buf_ptr) -> ()
  // ============================================================================
  //
  // Writes the R24 32-byte compat prefix (cap/blkdev_cap.pdx
  // §Descriptor tail's R24-preserved 32-byte view) at out_buf_ptr, bit-for-bit at the
  // original offsets, so pdxfs_lite/mount_op.pdx's R24-era readers
  // keep compiling/working against a KIND_BLKDEV cap regardless of
  // which family minted it:
  //
  //   +0  u8  controller_idx  = parent_slot & 0xFF
  //   +1  u8  _pad0           = 0
  //   +2  u16 _pad1           = 0
  //   +4  u32 nsid_or_port    = family-dispatched row read
  //                             (nvme_ns_row_nsid / ahci_port_row_port_index)
  //   +8  u32 lba_size        = family-dispatched row read
  //                             (nvme_ns_row_lba_size / ahci_port_row_sector_size)
  //   +12 u32 _pad2           = 0
  //   +16 u64 block_count     = family-dispatched row read
  //   +24 u32 rights          = caller-supplied `rights` arg (not row
  //                             data -- lives on the cap descriptor,
  //                             cap_table + slot*24 + 8)
  //   +28 u32 _pad3           = 0
  //
  // On a bad family byte, refuses without writing (out_buf_ptr left
  // untouched) and returns via rax = BDEVU_TAIL_BAD_ARG; success
  // returns rax = 0. Six-callee-save-free (three args fit rdi/rsi/rdx,
  // one scratch push suffices); entry rsp%16==8 -> post-prologue
  // rsp%16==0 for every nested call.
  // ============================================================================
  pub let _blkdev_legacy_view : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (target_ptr: u64) (rights: u64) (out_buf_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): writes the R24-compat 32-byte legacy view at out_buf_ptr. Five callee-save pushes (rbx=target_ptr, r12=rights, r13=out_buf_ptr, r14=row_id, r15=family) leave rsp%16==0 (entry rsp%16==8 -> 8+40=48 -> %16==0). Dispatches nsid_or_port/lba_size/block_count per family ({0,1}->nvme_ns_row_nsid/_lba_size/_block_count, {2}->ahci_port_row_port_index/_sector_size/_block_count); parent_slot (controller_idx) via the shared blkdev_row_parent_slot dispatcher above. rights is caller-supplied, not row data. G1: mov_b for the sub-8-byte pad fields, mov_d for the 32-bit fields. Labels prefixed blku_lv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // target_ptr
        mov r12, rsi;                    // rights
        mov r13, rdx;                    // out_buf_ptr

        mov rax, rbx;
        shr rax, 16;
        and rax, 0xFF;
        mov r15, rax;                    // family
        cmp r15, 2;
        ja  blku_lv_bad;

        mov rax, rbx;
        and rax, 0xFFFF;
        mov r14, rax;                    // row_id

        // controller_idx (parent_slot & 0xFF) at +0; pads at +1/+2.
        mov rdi, rbx;
        call blkdev_row_parent_slot;
        mov_b [r13 + 0], al;
        xor rax, rax;
        mov_b [r13 + 1], al;
        mov_b [r13 + 2], al;
        mov_b [r13 + 3], al;

        cmp r15, 2;
        je  blku_lv_ahci;

        // +4 nsid_or_port, +8 lba_size (NVMe/legacy family).
        mov rdi, r14;
        call nvme_ns_row_nsid;
        mov_d [r13 + 4], rax;
        mov rdi, r14;
        call nvme_ns_row_lba_size;
        mov_d [r13 + 8], rax;
        mov rdi, r14;
        call nvme_ns_row_block_count;
        mov [r13 + 16], rax;
        jmp blku_lv_tail;

      blku_lv_ahci:
        mov rdi, r14;
        call ahci_port_row_port_index;
        mov_d [r13 + 4], rax;
        mov rdi, r14;
        call ahci_port_row_sector_size;
        mov_d [r13 + 8], rax;
        mov rdi, r14;
        call ahci_port_row_block_count;
        mov [r13 + 16], rax;

      blku_lv_tail:
        xor rax, rax;
        mov_d [r13 + 12], rax;           // _pad2
        mov_d [r13 + 24], r12;           // rights
        mov_d [r13 + 28], rax;           // _pad3
        xor rax, rax;
        jmp blku_lv_out;

      blku_lv_bad:
        mov rax, 0xFFFFECC1;             // BDEVU_TAIL_BAD_ARG

      blku_lv_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
