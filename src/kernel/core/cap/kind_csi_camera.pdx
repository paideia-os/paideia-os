// src/kernel/core/cap/kind_csi_camera.pdx — R40.M2-001 (#1352)
//
// KIND_CSI_CAMERA = 0x17E, derived over KIND_DEVICE (10).
//
// The authority to hold ONE MIPI-CSI camera sensor's static identity
// (cam_key, the KIND_DEVICE slot the sensor was bound on, its 16-bit
// vendor_id, its 16-bit sensor_id, the CSI lane count [1..4], and
// the maximum frame extent [max_width, max_height] in pixels).
// Opens R40.M2 -- the capability layer above the R40.M1 IPU6 bring-up
// substrate and below the R40.M3+ streaming path.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// R40.M1 admitted an IPU6 processor as a probed KIND_DEVICE and staged
// its firmware.  The camera on the other end of the IPU6's CSI-2
// receiver is a SEPARATE piece of hardware -- an OmniVision or a
// similar image sensor sitting on the CSI bus -- and no code in this
// tree had a way to name one.  R40.M2 introduces a CAPABILITY over
// that sensor so a ring-3 supervisor (compositor, camera daemon,
// portrait-mode denoiser) can name ONE CAMERA without touching either
// the IPU6 MMIO or the CSI receiver PHY directly.
//
// The kind half of the derivation gate discriminates NOTHING on its
// own -- every PCI/ACPI-discovered function is a KIND_DEVICE, the
// eleventh time in this tree the pattern repeats -- so the mint
// additionally requires:
//
//   (a) cam_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE (BAD_DEVICE)
//   (c) vendor_id in (0, 0xFFFF] (BAD_VENDOR)
//   (d) sensor_id in (0, 0xFFFF] (BAD_SENSOR)
//   (e) lanes in [1, CCAM_LANES_MAX=4] (BAD_LANES)
//   (f) max_width in [1, CCAM_DIM_MAX=8192] (BAD_WIDTH)
//   (g) max_height in [1, CCAM_DIM_MAX=8192] (BAD_HEIGHT)
//   (h) rights subset of R_CCAM_ALL (no R_MINT in R_CCAM_ALL -- LEAF)
//
// =============================================================================
// §1  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  cam_key    (u64)
//   [+16] body1:   device_slot[31:0] | vendor_id[47:32] | sensor_id[63:48]
//   [+24] body2:   lanes[7:0] | max_width[23:8] | max_height[39:24]
//                | reserved[63:40]
//
// Every field is set once at mint and no primitive in this module
// mutates any of them.  Revoke scrubs the entire row.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF230..0xFFFFF23F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: ipu6_load
// 0xFFFFF240..4F, R40.M1-003; adjacent free band below: csi_phy
// 0xFFFFF220..2F, R40.M2-002).

module KindCsiCamera = structure {

  pub let KIND_CSI_CAMERA      : u64 = 0x17E
  pub let CCAM_PARENT_KIND     : u64 = 10       // = KIND_DEVICE

  pub let CCAM_LANES_MAX       : u64 = 4        // MIPI-CSI D-PHY: 1/2/4
  pub let CCAM_DIM_MAX         : u64 = 8192     // sensor extent cap

  // Rights -- LEAF.  R_MINT (0x200) OUTSIDE R_CCAM_ALL.
  pub let R_CCAM_READ    : u64 = 0x001
  pub let R_CCAM_INVOKE  : u64 = 0x008
  pub let R_CCAM_REVOKE  : u64 = 0x010
  pub let R_CCAM_OBSERVE : u64 = 0x400
  pub let R_CCAM_ALL     : u64 = 0x419

  // Ops -- all QUERY, all arity ONE (op_arg[63:8] REFUSED).
  pub let CCAM_OP_QUERY_KEY      : u64 = 0
  pub let CCAM_OP_QUERY_DEVICE   : u64 = 1
  pub let CCAM_OP_QUERY_VENDOR   : u64 = 2
  pub let CCAM_OP_QUERY_SENSOR   : u64 = 3
  pub let CCAM_OP_QUERY_LANES    : u64 = 4
  pub let CCAM_OP_QUERY_WIDTH    : u64 = 5
  pub let CCAM_OP_QUERY_HEIGHT   : u64 = 6
  pub let CCAM_OP_DEBUG_PRINT    : u64 = 7
  pub let CCAM_OP_MAX            : u64 = 7

  // Failure taxonomy 0xFFFFF230..3F.
  pub let CCAM_OK                 : u64 = 0
  pub let CCAM_TAIL_ENOSPC        : u64 = 0xFFFFF23F
  pub let CCAM_TAIL_BAD_ARG       : u64 = 0xFFFFF23E
  pub let CCAM_MINT_BAD_PARENT    : u64 = 0xFFFFF23D
  pub let CCAM_MINT_BAD_RIGHTS    : u64 = 0xFFFFF23C
  pub let CCAM_MINT_BAD_DEVICE    : u64 = 0xFFFFF23B
  pub let CCAM_MINT_BAD_VENDOR    : u64 = 0xFFFFF23A
  pub let CCAM_MINT_BAD_SENSOR    : u64 = 0xFFFFF239
  pub let CCAM_MINT_BAD_LANES     : u64 = 0xFFFFF238
  pub let CCAM_MINT_BAD_WIDTH     : u64 = 0xFFFFF237
  pub let CCAM_MINT_BAD_HEIGHT    : u64 = 0xFFFFF236
  pub let CCAM_MINT_NO_KEY        : u64 = 0xFFFFF235
  pub let CCAM_MINT_IN_USE        : u64 = 0xFFFFF234
  pub let CCAM_MINT_ENOSPC        : u64 = 0xFFFFF233
  pub let CCAM_BAD_SLOT           : u64 = 0xFFFFF232
  pub let CCAM_WRONG_KIND         : u64 = 0xFFFFF231
  pub let CCAM_REVOKE_ALREADY     : u64 = 0xFFFFF230

  pub let CCAM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let CCAM_ROW_NONE   : u64 = 0xFF

  // Eight rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let CCAM_MAX       : u64 = 8
  pub let CCAM_ROW_BYTES : u64 = 32

  pub let mut _csi_camera_table : [u64; 32] = uninit @align(64)
  pub let mut _csi_camera_stats : [u64; 4]  = uninit @align(64)

  pub let CCAM_ST_MINTS   : u64 = 0
  pub let CCAM_ST_REVOKES : u64 = 1
  pub let CCAM_ST_REFUSED : u64 = 2
  pub let CCAM_ST_QUERIES : u64 = 3

  pub let ccam_dbg_msg : [u8; 15] = "CSI CAMERA ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let csi_camera_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): clear KIND_CSI_CAMERA row table and counters. Boot + teardown only. Labels prefixed ccam_rs_.",
      block: {
        lea r10, [rip + _csi_camera_table];
        xor rax, rax;
        xor rcx, rcx;
      ccam_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  ccam_rs_rows;

        lea r10, [rip + _csi_camera_stats];
        xor rcx, rcx;
      ccam_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  ccam_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let ccam_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-001 (#1352): subset test against R_CCAM_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask -- LEAF. Labels prefixed ccam_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne ccam_rv_no;
        mov rax, 1;
        ret;
      ccam_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ccam_lanes_valid : (u64) -> u64 !{} @{} =
    fn (lanes: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-001 (#1352): 1 iff lanes in [1, CCAM_LANES_MAX=4]. Labels prefixed ccam_lv_.",
      block: {
        cmp rdi, 0;
        je  ccam_lv_no;
        cmp rdi, 4;
        ja  ccam_lv_no;
        mov rax, 1;
        ret;
      ccam_lv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ccam_dim_valid : (u64) -> u64 !{} @{} =
    fn (dim: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-001 (#1352): 1 iff dim in [1, CCAM_DIM_MAX=8192]. Labels prefixed ccam_dv_.",
      block: {
        cmp rdi, 0;
        je  ccam_dv_no;
        mov r10, 8192;
        cmp rdi, r10;
        ja  ccam_dv_no;
        mov rax, 1;
        ret;
      ccam_dv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let ccam_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): counter bump. Labels prefixed ccam_nt_.",
      block: {
        cmp rdi, 4;
        jae ccam_nt_out;
        lea r10, [rip + _csi_camera_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ccam_nt_out:
        ret
      }
    }

  pub let ccam_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): counter read. Labels prefixed ccam_stt_.",
      block: {
        cmp rdi, 4;
        jae ccam_stt_zero;
        lea r10, [rip + _csi_camera_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ccam_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_DEVICE (10) with RIGHT_MINT.
  // ==========================================================================

  pub let ccam_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): parent must be live KIND_DEVICE (10) with RIGHT_MINT. Labels prefixed ccam_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae ccam_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne ccam_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  ccam_cp_no;

        mov rax, 1;
        ret;
      ccam_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Device gate: live KIND_DEVICE (10) at device_slot.
  // ==========================================================================

  pub let ccam_check_device : (u64) -> u64 !{mem} @{cap} =
    fn (device_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): device_slot must name a live KIND_DEVICE. Labels prefixed ccam_cd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae ccam_cd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne ccam_cd_no;

        mov rax, 1;
        ret;
      ccam_cd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let ccam_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-001 (#1352): (parent_slot << 8). Labels prefixed ccam_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae ccam_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      ccam_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body1: device_slot[31:0] | vendor_id[47:32] | sensor_id[63:48].
  pub let ccam_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (vendor_id: u64) (sensor_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-001 (#1352): pack body1: device_slot[31:0] | vendor_id[47:32] | sensor_id[63:48]. Labels prefixed ccam_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  ccam_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  ccam_b1_bad;
        cmp rdx, r10;
        ja  ccam_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      ccam_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: lanes[7:0] | max_width[23:8] | max_height[39:24] | reserved[63:40].
  pub let ccam_body2_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (lanes: u64) (max_width: u64) (max_height: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-001 (#1352): pack body2: lanes[7:0] | max_width[23:8] | max_height[39:24]. Reserved bits [63:40] MUST be zero on read. Labels prefixed ccam_b2_.",
      block: {
        mov r10, 0xFF;
        cmp rdi, r10;
        ja  ccam_b2_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  ccam_b2_bad;
        cmp rdx, r10;
        ja  ccam_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      ccam_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _csi_camera_table.
  // ==========================================================================

  pub let ccam_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (cam_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): claim one CSI CAMERA row. THE ONE WRITER of _csi_camera_table. Gates: hdr in_use pre-set -> BAD_ARG; cam_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed ccam_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne ccam_ta_bad;

        cmp r13, 0;
        je  ccam_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  ccam_ta_bad;
        cmp r15, r10;
        je  ccam_ta_bad;

        xor rbx, rbx;
      ccam_ta_scan:
        cmp rbx, 8;
        jae ccam_ta_enospc;

        lea r10, [rip + _csi_camera_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ccam_ta_claim;

        add rbx, 1;
        jmp ccam_ta_scan;

      ccam_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp ccam_ta_out;

      ccam_ta_enospc:
        mov rax, 0xFFFFF23F;
        jmp ccam_ta_out;
      ccam_ta_bad:
        mov rax, 0xFFFFF23E;

      ccam_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ccam_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): 1 iff row_id < MAX and in_use. Labels prefixed ccam_tvr_.",
      block: {
        cmp rdi, 8;
        jae ccam_tvr_no;
        lea r10, [rip + _csi_camera_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ccam_tvr_no;
        mov rax, 1;
        ret;
      ccam_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let ccam_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): scrub one row. Labels prefixed ccam_tf_.",
      block: {
        cmp rdi, 8;
        jae ccam_tf_out;
        lea r10, [rip + _csi_camera_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      ccam_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let ccam_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): cam_key. Labels prefixed ccam_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rk_bad;
        lea r10, [rip + _csi_camera_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp ccam_rk_out;
      ccam_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ccam_rk_out:
        pop r12;
        ret
      }
    }

  pub let ccam_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): device_slot (body1[31:0]). Labels prefixed ccam_rd_.",
      block: {
        push r12;
        mov r12, rdi;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rd_bad;
        lea r10, [rip + _csi_camera_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp ccam_rd_out;
      ccam_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ccam_rd_out:
        pop r12;
        ret
      }
    }

  pub let ccam_row_vendor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): vendor_id (body1[47:32]). Labels prefixed ccam_rv1_.",
      block: {
        push r12;
        mov r12, rdi;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rv1_bad;
        lea r10, [rip + _csi_camera_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp ccam_rv1_out;
      ccam_rv1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ccam_rv1_out:
        pop r12;
        ret
      }
    }

  pub let ccam_row_sensor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): sensor_id (body1[63:48]). Labels prefixed ccam_rs1_.",
      block: {
        push r12;
        mov r12, rdi;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rs1_bad;
        lea r10, [rip + _csi_camera_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFFFF;
        jmp ccam_rs1_out;
      ccam_rs1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ccam_rs1_out:
        pop r12;
        ret
      }
    }

  pub let ccam_row_lanes : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): lanes (body2[7:0]). Labels prefixed ccam_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rl_bad;
        lea r10, [rip + _csi_camera_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp ccam_rl_out;
      ccam_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ccam_rl_out:
        pop r12;
        ret
      }
    }

  pub let ccam_row_width : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): max_width (body2[23:8]). Labels prefixed ccam_rw_.",
      block: {
        push r12;
        mov r12, rdi;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rw_bad;
        lea r10, [rip + _csi_camera_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 8;
        and rax, 0xFFFF;
        jmp ccam_rw_out;
      ccam_rw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ccam_rw_out:
        pop r12;
        ret
      }
    }

  pub let ccam_row_height : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): max_height (body2[39:24]). Labels prefixed ccam_rh_.",
      block: {
        push r12;
        mov r12, rdi;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rh_bad;
        lea r10, [rip + _csi_camera_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 24;
        and rax, 0xFFFF;
        jmp ccam_rh_out;
      ccam_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ccam_rh_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let ccam_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (cam_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-001 (#1352): live row holding cam_key, or ROW_NONE. Refuses to match 0. Labels prefixed ccam_fk_.",
      block: {
        cmp rdi, 0;
        je  ccam_fk_none;
        xor rcx, rcx;
      ccam_fk_scan:
        cmp rcx, 8;
        jae ccam_fk_none;
        lea r10, [rip + _csi_camera_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ccam_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  ccam_fk_hit;
      ccam_fk_next:
        add rcx, 1;
        jmp ccam_fk_scan;
      ccam_fk_hit:
        mov rax, rcx;
        ret;
      ccam_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let ccam_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): slot -> row_id, gated on live KIND_CSI_CAMERA. Labels prefixed ccam_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae ccam_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x17E;
        cmp r10, r11;
        jne ccam_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_ros_none;

        mov rax, r12;
        jmp ccam_ros_out;

      ccam_ros_none:
        mov rax, 0xFF;
      ccam_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Six args -- device_slot / vendor_id / sensor_id / lanes / width /
  // height packed in two args to fit the ABI:
  //
  //   packed_ids encoding:
  //     [15:0]   device_slot
  //     [31:16]  vendor_id
  //     [47:32]  sensor_id
  //     [63:48]  reserved
  //
  //   packed_geom encoding:
  //     [7:0]    lanes
  //     [23:8]   max_width
  //     [39:24]  max_height
  //     [63:40]  reserved
  // ==========================================================================

  pub let csi_camera_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (cam_key: u64) (packed_ids: u64) (packed_geom: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): mint KIND_CSI_CAMERA over KIND_DEVICE. Sequence: slot<256; check_parent; rights_valid; unpack; check_device; vendor/sensor non-zero; lanes_valid; width/height in [1, DIM_MAX]; cam_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed ccam_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // cam_key
        mov r15, r8;                     // packed_ids
        mov rbp, r9;                     // packed_geom

        mov r10, 256;
        cmp rbx, r10;
        jae ccam_mi_bad_slot;

        mov rdi, r12;
        call ccam_check_parent;
        cmp rax, 0;
        je  ccam_mi_bad_parent;

        mov rdi, r13;
        call ccam_rights_valid;
        cmp rax, 0;
        je  ccam_mi_bad_rights;

        // device_slot check
        mov r10, r15;
        and r10, 0xFFFF;
        mov rdi, r10;
        call ccam_check_device;
        cmp rax, 0;
        je  ccam_mi_bad_device;

        // vendor non-zero
        mov r10, r15;
        shr r10, 16;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  ccam_mi_bad_vendor;

        // sensor non-zero
        mov r10, r15;
        shr r10, 32;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  ccam_mi_bad_sensor;

        // lanes_valid
        mov r10, rbp;
        and r10, 0xFF;
        mov rdi, r10;
        call ccam_lanes_valid;
        cmp rax, 0;
        je  ccam_mi_bad_lanes;

        // width in [1, 8192]
        mov r10, rbp;
        shr r10, 8;
        and r10, 0xFFFF;
        mov rdi, r10;
        call ccam_dim_valid;
        cmp rax, 0;
        je  ccam_mi_bad_width;

        // height in [1, 8192]
        mov r10, rbp;
        shr r10, 24;
        and r10, 0xFFFF;
        mov rdi, r10;
        call ccam_dim_valid;
        cmp rax, 0;
        je  ccam_mi_bad_height;

        cmp r14, 0;
        je  ccam_mi_no_key;

        mov rdi, r14;
        call ccam_find_by_key;
        cmp rax, 0xFF;
        jne ccam_mi_in_use;

        // Pack body1.
        mov rdi, r15;
        and rdi, 0xFFFF;                 // device_slot
        mov rsi, r15;
        shr rsi, 16;
        and rsi, 0xFFFF;                 // vendor_id
        mov rdx, r15;
        shr rdx, 32;
        and rdx, 0xFFFF;                 // sensor_id
        call ccam_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ccam_mi_bad_vendor;
        push rax;                        // body1 on stack

        // Pack body2.
        mov rdi, rbp;
        and rdi, 0xFF;                   // lanes
        mov rsi, rbp;
        shr rsi, 8;
        and rsi, 0xFFFF;                 // max_width
        mov rdx, rbp;
        shr rdx, 24;
        and rdx, 0xFFFF;                 // max_height
        call ccam_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ccam_mi_bad_geom_pop;
        push rax;                        // body2 on stack

        // Header.
        mov rdi, r12;
        call ccam_hdr_pack;
        pop r11;                         // body2
        pop rbp;                         // body1 (overwrite -- rbp no longer needed)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ccam_mi_bad_parent;

        // tail_alloc(hdr, cam_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r11;
        call ccam_tail_alloc;

        mov r10, 0xFFFFF23F;
        cmp rax, r10;
        je  ccam_mi_enospc;
        mov r10, 0xFFFFF23E;
        cmp rax, r10;
        je  ccam_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x17E;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call ccam_note;

        xor rax, rax;
        jmp ccam_mi_out;

      ccam_mi_bad_geom_pop:
        add rsp, 8;
        jmp ccam_mi_bad_lanes;

      ccam_mi_bad_slot:
        mov rax, 0xFFFFF232;
        jmp ccam_mi_out;
      ccam_mi_bad_parent:
        mov rax, 0xFFFFF23D;
        jmp ccam_mi_out;
      ccam_mi_bad_rights:
        mov rax, 0xFFFFF23C;
        jmp ccam_mi_out;
      ccam_mi_bad_device:
        mov rax, 0xFFFFF23B;
        jmp ccam_mi_out;
      ccam_mi_bad_vendor:
        mov rax, 0xFFFFF23A;
        jmp ccam_mi_out;
      ccam_mi_bad_sensor:
        mov rax, 0xFFFFF239;
        jmp ccam_mi_out;
      ccam_mi_bad_lanes:
        mov rax, 0xFFFFF238;
        jmp ccam_mi_out;
      ccam_mi_bad_width:
        mov rax, 0xFFFFF237;
        jmp ccam_mi_out;
      ccam_mi_bad_height:
        mov rax, 0xFFFFF236;
        jmp ccam_mi_out;
      ccam_mi_no_key:
        mov rax, 0xFFFFF235;
        jmp ccam_mi_out;
      ccam_mi_in_use:
        mov rdi, 2;
        call ccam_note;
        mov rax, 0xFFFFF234;
        jmp ccam_mi_out;
      ccam_mi_enospc:
        mov rdi, 2;
        call ccam_note;
        mov rax, 0xFFFFF233;
        jmp ccam_mi_out;
      ccam_mi_bad_arg:
        mov rax, 0xFFFFF23E;

      ccam_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let csi_camera_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): revoke KIND_CSI_CAMERA. Labels prefixed ccam_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae ccam_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  ccam_rvk_already;

        mov r11, 0x17E;
        cmp r10, r11;
        jne ccam_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call ccam_tail_valid;
        cmp rax, 0;
        je  ccam_rvk_clear;

        mov rdi, r13;
        call ccam_tail_free;

      ccam_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call ccam_note;

        xor rax, rax;
        jmp ccam_rvk_out;

      ccam_rvk_bad_slot:
        mov rax, 0xFFFFF232;
        jmp ccam_rvk_out;
      ccam_rvk_wrong_kind:
        mov rax, 0xFFFFF231;
        jmp ccam_rvk_out;
      ccam_rvk_already:
        mov rax, 0xFFFFF230;

      ccam_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_csi_camera : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R40.M2-001 (#1352): KIND_CSI_CAMERA dispatch. All ops arity ONE -- op_arg[63:8] REFUSED. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. Labels prefixed ccam_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_csi_camera_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne ccam_hn_res;

        cmp rbp, 7;
        ja  ccam_hn_unsup;

        cmp rbp, 7;
        je  ccam_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  ccam_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  ccam_hn_key;
        cmp rbp, 1;
        je  ccam_hn_dev;
        cmp rbp, 2;
        je  ccam_hn_vend;
        cmp rbp, 3;
        je  ccam_hn_sens;
        cmp rbp, 4;
        je  ccam_hn_lanes;
        cmp rbp, 5;
        je  ccam_hn_width;
        call ccam_row_height;
        jmp ccam_hn_out;

      ccam_hn_key:
        call ccam_row_key;
        jmp ccam_hn_out;
      ccam_hn_dev:
        call ccam_row_device;
        jmp ccam_hn_out;
      ccam_hn_vend:
        call ccam_row_vendor;
        jmp ccam_hn_out;
      ccam_hn_sens:
        call ccam_row_sensor;
        jmp ccam_hn_out;
      ccam_hn_lanes:
        call ccam_row_lanes;
        jmp ccam_hn_out;
      ccam_hn_width:
        call ccam_row_width;
        jmp ccam_hn_out;

      ccam_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  ccam_hn_denied;
        xor rax, rax;
        jmp ccam_hn_out;

      ccam_hn_res:
        mov rax, 0xFFFFF23E;
        jmp ccam_hn_out;
      ccam_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp ccam_hn_out;
      ccam_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      ccam_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
