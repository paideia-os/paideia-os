// src/kernel/core/cap/kind_gpu_submit.pdx — R37.M6-001 (#1276)
//
// KIND_GPU_SUBMIT = 0x177, derived over KIND_IPC_ENDPOINT (5).  LINEAR.
//
// One in-flight GPU submission: a submit_key naming the submission, the
// KIND_IPC_ENDPOINT the caller drives the submit over, the KIND_GPU_
// CONTEXT slot the submission runs on, the KIND_GPU_BO slot backing the
// batch buffer, a small FSM state (pending / submitted / done / faulted),
// and a linear_flag frozen at 1.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// The submit path needs a capability that names, at once, WHICH context
// a batch runs on and WHICH batch buffer object it consumes.  Without a
// capability naming that pairing, a caller could:
//
//   (1) Retarget a submission to a different context after enqueue
//       ("context swap"): ctx_slot is frozen at mint and there is no
//       op on this kind that mutates it.
//   (2) Point a submission at a different batch BO after enqueue
//       ("batch forge"): batch_bo_slot is frozen at mint and there is
//       no op that mutates it.
//   (3) Duplicate a live submission to run the same batch on two
//       queues concurrently ("submit clone"): LINEAR discipline --
//       R_MINT is ABSENT from R_GPU_SUB_ALL and the mint gate ALSO
//       refuses R_MINT explicitly (§3 below), so no cap in this tree
//       derives from a KIND_GPU_SUBMIT and none can be minted from one.
//
// The KIND_IPC_ENDPOINT parent is the endpoint the GPU service accepts
// submission commands over.  Like every KIND_IPC_ENDPOINT-derived kind
// in this tree (KIND_MODESET_TXN, KIND_FW_SESSION, KIND_EC_QUERY,
// KIND_GPU_VM, KIND_GPU_CONTEXT ...), the parent kind alone
// discriminates NOTHING; the mint gates below cover the rest.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// A mint additionally requires:
//
//   (a) submit_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (NO_ENDPOINT); this is the parent_slot itself
//   (c) ctx_slot names a live KIND_GPU_CONTEXT (0x176) (BAD_CTX); the
//       row records the KIND_GPU_CONTEXT cap slot so the submit path
//       can drop back to the KIND_GPU_CONTEXT row for engine / VM /
//       priority queries
//   (d) batch_bo_slot names a live KIND_GPU_BO (0x174) (BAD_BO); the
//       row records the KIND_GPU_BO cap slot so the submit path can
//       drop back to the KIND_GPU_BO row for size / tiling / cache
//       policy queries
//   (e) initial state is always STATE_PENDING; a caller cannot mint
//       into SUBMITTED / DONE / FAULTED -- transitions are the submit
//       path's and the completion path's job
//   (f) rights subset of R_GPU_SUB_ALL, AND rights & R_MINT == 0
//       (LINEAR: §3 explicit gate)
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  submit_key  (u64)
//   [+16] body1:   endpoint_slot[31:0] | ctx_slot[63:32]
//   [+24] body2:   batch_bo_slot[31:0] | state[39:32] | linear_flag[47:40]
//                | reserved[63:48]     (linear_flag == 1)
//
// state is the ONE mutable field: kgsub_row_transition (called only by
// the submit path at SUBMITTED and by the completion path at DONE /
// FAULTED) is the sole mutator.  No op reachable through
// cap_handler_gpu_submit mutates state.
//
// linear_flag is FROZEN at 1 by kgsub_body2_pack and no path in this
// module rewrites the linear-flag byte.  A row whose linear_flag reads
// back != 1 is a corruption fingerprint the submit path rejects.
//
// =============================================================================
// §3  LINEAR (STRONGER THAN LEAF)
// =============================================================================
//
// R_GPU_SUB_MINT (0x200) is DELIBERATELY ABSENT from R_GPU_SUB_ALL AND
// the mint gate carries an EXPLICIT refuse (KGSUB_MINT_REFUSED_MINT)
// that fires before the subset check.  Two gates because LINEAR is a
// stronger discipline than LEAF: a LEAF says "no child kind derives
// from this"; LINEAR says "no child cap of ANY kind ever descends from
// a KIND_GPU_SUBMIT row".  The subset check would already reject a
// set-bit R_MINT (0x200 is outside 0x41B), but the explicit refuse
// makes the intent legible and stamps a distinct failure code so the
// operator can distinguish a LINEAR trip from an ordinary rights-mask
// trip.
//
// The row also carries linear_flag = 1 in body2[47:40] so a downstream
// consumer walking the row through kgsub_row_linear can assert LINEAR
// without re-reading rights.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF560..0xFFFFF56F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: ctx_priority
// 0xFFFFF570..7F; adjacent free bands below: guc_submit
// 0xFFFFF550..5F, batch_builder 0xFFFFF540..4F).

module KindGpuSubmit = structure {

  pub let KIND_GPU_SUBMIT        : u64 = 0x177
  pub let GPU_SUB_PARENT_KIND    : u64 = 5           // = KIND_IPC_ENDPOINT
  pub let GPU_SUB_CTX_KIND       : u64 = 0x176       // = KIND_GPU_CONTEXT
  pub let GPU_SUB_BO_KIND        : u64 = 0x174       // = KIND_GPU_BO

  // FSM state ordinals (§1e).
  pub let KGSUB_STATE_PENDING   : u64 = 0
  pub let KGSUB_STATE_SUBMITTED : u64 = 1
  pub let KGSUB_STATE_DONE      : u64 = 2
  pub let KGSUB_STATE_FAULTED   : u64 = 3
  pub let KGSUB_STATE_MAX       : u64 = 3

  // Rights.  LINEAR: R_MINT (0x200) NOT in the mask AND explicit refuse.
  pub let R_GPU_SUB_READ    : u64 = 0x001
  pub let R_GPU_SUB_WRITE   : u64 = 0x002
  pub let R_GPU_SUB_INVOKE  : u64 = 0x008
  pub let R_GPU_SUB_REVOKE  : u64 = 0x010
  pub let R_GPU_SUB_OBSERVE : u64 = 0x400
  pub let R_GPU_SUB_ALL     : u64 = 0x41B
  pub let R_GPU_SUB_MINT    : u64 = 0x200             // LINEAR gate refuses

  // Ops.  Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KGSUB_OP_QUERY_KEY      : u64 = 0
  pub let KGSUB_OP_QUERY_ENDPOINT : u64 = 1
  pub let KGSUB_OP_QUERY_CTX      : u64 = 2
  pub let KGSUB_OP_QUERY_BO       : u64 = 3
  pub let KGSUB_OP_QUERY_STATE    : u64 = 4
  pub let KGSUB_OP_QUERY_LINEAR   : u64 = 5
  pub let KGSUB_OP_DEBUG_PRINT    : u64 = 6
  pub let KGSUB_OP_MAX            : u64 = 6

  // Failure taxonomy -- 0xFFFFF560..0xFFFFF56F.
  pub let KGSUB_OK                 : u64 = 0
  pub let KGSUB_TAIL_ENOSPC        : u64 = 0xFFFFF56F
  pub let KGSUB_TAIL_BAD_ARG       : u64 = 0xFFFFF56E
  pub let KGSUB_MINT_BAD_PARENT    : u64 = 0xFFFFF56D
  pub let KGSUB_MINT_BAD_RIGHTS    : u64 = 0xFFFFF56C
  pub let KGSUB_MINT_BAD_CTX       : u64 = 0xFFFFF56B
  pub let KGSUB_MINT_BAD_BO        : u64 = 0xFFFFF56A
  pub let KGSUB_MINT_BAD_STATE     : u64 = 0xFFFFF569
  pub let KGSUB_MINT_NO_ENDPOINT   : u64 = 0xFFFFF568
  pub let KGSUB_MINT_NO_KEY        : u64 = 0xFFFFF567
  pub let KGSUB_MINT_ENOSPC        : u64 = 0xFFFFF566
  pub let KGSUB_MINT_IN_USE        : u64 = 0xFFFFF565
  pub let KGSUB_BAD_SLOT           : u64 = 0xFFFFF564
  pub let KGSUB_WRONG_KIND         : u64 = 0xFFFFF563
  pub let KGSUB_REVOKE_ALREADY     : u64 = 0xFFFFF562
  pub let KGSUB_BAD_TRANSITION     : u64 = 0xFFFFF561
  pub let KGSUB_MINT_REFUSED_MINT  : u64 = 0xFFFFF560    // LINEAR explicit

  pub let KGSUB_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KGSUB_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let KGSUB_MAX       : u64 = 8
  pub let KGSUB_ROW_BYTES : u64 = 32

  pub let mut _gpu_submit_table : [u64; 32] = uninit @align(64)
  pub let mut _gpu_submit_stats : [u64; 4]  = uninit @align(64)

  pub let KGSUB_ST_MINTS       : u64 = 0
  pub let KGSUB_ST_REVOKES     : u64 = 1
  pub let KGSUB_ST_TRANSITIONS : u64 = 2
  pub let KGSUB_ST_REFUSED     : u64 = 3

  pub let kgsub_dbg_msg : [u8; 15] = "GPU SUBMIT ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let gpu_submit_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): clear the GPU SUBMIT row table and its counters. Boot and teardown only. Labels prefixed kgsub_rs_.",
      block: {
        lea r10, [rip + _gpu_submit_table];
        xor rax, rax;
        xor rcx, rcx;
      kgsub_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kgsub_rs_rows;

        lea r10, [rip + _gpu_submit_stats];
        xor rcx, rcx;
      kgsub_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kgsub_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kgsub_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M6-001 (#1276): 1 iff s <= KGSUB_STATE_MAX (3). Labels prefixed kgsub_sv_.",
      block: {
        cmp rdi, 3;
        ja  kgsub_sv_no;
        mov rax, 1;
        ret;
      kgsub_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kgsub_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M6-001 (#1276): subset test against R_GPU_SUB_ALL = 0x41B. R_MINT (0x200) is OUTSIDE the mask -- LINEAR (§3). Labels prefixed kgsub_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne kgsub_rgv_no;
        mov rax, 1;
        ret;
      kgsub_rgv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kgsub_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): counter bump. Labels prefixed kgsub_nt_.",
      block: {
        cmp rdi, 4;
        jae kgsub_nt_out;
        lea r10, [rip + _gpu_submit_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kgsub_nt_out:
        ret
      }
    } @no_frame

  pub let kgsub_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): counter read. Labels prefixed kgsub_stt_.",
      block: {
        cmp rdi, 4;
        jae kgsub_stt_zero;
        lea r10, [rip + _gpu_submit_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kgsub_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let kgsub_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): §1 gate. Parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed kgsub_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgsub_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne kgsub_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kgsub_cp_no;

        mov rax, 1;
        ret;
      kgsub_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // CTX gate: live KIND_GPU_CONTEXT (0x176) at ctx_slot.
  // ==========================================================================

  pub let kgsub_check_ctx : (u64) -> u64 !{mem} @{cap} =
    fn (ctx_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): §1c gate. ctx_slot must be a live KIND_GPU_CONTEXT. Labels prefixed kgsub_cc_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgsub_cc_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x176;
        cmp r10, r11;
        jne kgsub_cc_no;

        mov rax, 1;
        ret;
      kgsub_cc_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // BO gate: live KIND_GPU_BO (0x174) at batch_bo_slot.
  // ==========================================================================

  pub let kgsub_check_bo : (u64) -> u64 !{mem} @{cap} =
    fn (bo_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): §1d gate. batch_bo_slot must be a live KIND_GPU_BO. Labels prefixed kgsub_cb_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgsub_cb_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x174;
        cmp r10, r11;
        jne kgsub_cb_no;

        mov rax, 1;
        ret;
      kgsub_cb_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kgsub_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M6-001 (#1276): (parent_slot << 8). Labels prefixed kgsub_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kgsub_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kgsub_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let kgsub_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (ctx_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M6-001 (#1276): pack endpoint_slot[31:0] | ctx_slot[63:32]. Labels prefixed kgsub_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kgsub_b1_bad;
        cmp rsi, r10;
        ja  kgsub_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      kgsub_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let kgsub_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (batch_bo_slot: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M6-001 (#1276): pack batch_bo_slot[31:0] | state[39:32] | linear_flag[47:40]=1. Labels prefixed kgsub_b2_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kgsub_b2_bad;
        cmp rsi, 3;
        ja  kgsub_b2_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        // linear_flag frozen at 1 in [47:40].
        mov r10, 1;
        shl r10, 40;
        or  rax, r10;
        ret;
      kgsub_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _gpu_submit_table.
  // ==========================================================================

  pub let kgsub_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (submit_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): claim one GPU SUBMIT row. THE ONE WRITER of _gpu_submit_table. Gates: hdr in_use pre-set -> BAD_ARG; submit_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed kgsub_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kgsub_ta_bad;

        cmp r13, 0;
        je  kgsub_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kgsub_ta_bad;
        cmp r15, r10;
        je  kgsub_ta_bad;

        xor rbx, rbx;
      kgsub_ta_scan:
        cmp rbx, 8;
        jae kgsub_ta_enospc;

        lea r10, [rip + _gpu_submit_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgsub_ta_claim;

        add rbx, 1;
        jmp kgsub_ta_scan;

      kgsub_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kgsub_ta_out;

      kgsub_ta_enospc:
        mov rax, 0xFFFFF56F;
        jmp kgsub_ta_out;
      kgsub_ta_bad:
        mov rax, 0xFFFFF56E;

      kgsub_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kgsub_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): 1 iff row_id < MAX and in_use. Labels prefixed kgsub_tvr_.",
      block: {
        cmp rdi, 8;
        jae kgsub_tvr_no;
        lea r10, [rip + _gpu_submit_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgsub_tvr_no;
        mov rax, 1;
        ret;
      kgsub_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kgsub_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): scrub one row. Labels prefixed kgsub_tf_.",
      block: {
        cmp rdi, 8;
        jae kgsub_tf_out;
        lea r10, [rip + _gpu_submit_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kgsub_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kgsub_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): submit_key. Labels prefixed kgsub_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_rk_bad;
        lea r10, [rip + _gpu_submit_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kgsub_rk_out;
      kgsub_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgsub_rk_out:
        pop r12;
        ret
      }
    }

  pub let kgsub_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): endpoint_slot (body1[31:0]). Labels prefixed kgsub_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_re_bad;
        lea r10, [rip + _gpu_submit_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kgsub_re_out;
      kgsub_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgsub_re_out:
        pop r12;
        ret
      }
    }

  pub let kgsub_row_ctx : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): ctx_slot (body1[63:32]). Labels prefixed kgsub_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_rc_bad;
        lea r10, [rip + _gpu_submit_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp kgsub_rc_out;
      kgsub_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgsub_rc_out:
        pop r12;
        ret
      }
    }

  pub let kgsub_row_bo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): batch_bo_slot (body2[31:0]). Labels prefixed kgsub_rb_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_rb_bad;
        lea r10, [rip + _gpu_submit_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFFFFFF;
        jmp kgsub_rb_out;
      kgsub_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgsub_rb_out:
        pop r12;
        ret
      }
    }

  pub let kgsub_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): state (body2[39:32]). Labels prefixed kgsub_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_rst_bad;
        lea r10, [rip + _gpu_submit_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 32;
        and rax, 0xFF;
        jmp kgsub_rst_out;
      kgsub_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgsub_rst_out:
        pop r12;
        ret
      }
    }

  pub let kgsub_row_linear : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): linear_flag (body2[47:40]). Frozen at 1. Labels prefixed kgsub_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_rl_bad;
        lea r10, [rip + _gpu_submit_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 40;
        and rax, 0xFF;
        jmp kgsub_rl_out;
      kgsub_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgsub_rl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kgsub_row_transition(row_id, new_state) — the ONE MUTATOR of the state
  // field.  Legal edges: PENDING -> SUBMITTED, SUBMITTED -> DONE,
  // SUBMITTED -> FAULTED, PENDING -> FAULTED (early refusal path).
  // Any other transition is refused.
  // ==========================================================================

  pub let kgsub_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): mutate state field on one row. Legal forward FSM edges: PENDING->SUBMITTED, PENDING->FAULTED, SUBMITTED->DONE, SUBMITTED->FAULTED. Labels prefixed kgsub_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_rt_bad;

        mov rdi, r13;
        call kgsub_state_valid;
        cmp rax, 0;
        je  kgsub_rt_bad;

        lea r10, [rip + _gpu_submit_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 32;
        and rax, 0xFF;

        // Legal edges: (0,1), (0,3), (1,2), (1,3).  Anything else refused.
        cmp rax, 0;
        je  kgsub_rt_from0;
        cmp rax, 1;
        je  kgsub_rt_from1;
        jmp kgsub_rt_bad;
      kgsub_rt_from0:
        cmp r13, 1;
        je  kgsub_rt_apply;
        cmp r13, 3;
        je  kgsub_rt_apply;
        jmp kgsub_rt_bad;
      kgsub_rt_from1:
        cmp r13, 2;
        je  kgsub_rt_apply;
        cmp r13, 3;
        jne kgsub_rt_bad;

      kgsub_rt_apply:
        // Rewrite body2 state[39:32] preserving batch_bo_slot[31:0]
        // and linear_flag[47:40].
        mov rax, [r10 + 24];
        mov r11, 0xFF;
        shl r11, 32;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 24], rax;

        mov rdi, 2;                      // TRANSITIONS
        call kgsub_note;
        xor rax, rax;
        jmp kgsub_rt_out;

      kgsub_rt_bad:
        mov rax, 0xFFFFF561;             // BAD_TRANSITION
      kgsub_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kgsub_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (submit_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M6-001 (#1276): live row holding submit_key, or ROW_NONE. Refuses to match 0. Labels prefixed kgsub_fk_.",
      block: {
        cmp rdi, 0;
        je  kgsub_fk_none;
        xor rcx, rcx;
      kgsub_fk_scan:
        cmp rcx, 8;
        jae kgsub_fk_none;
        lea r10, [rip + _gpu_submit_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgsub_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kgsub_fk_hit;
      kgsub_fk_next:
        add rcx, 1;
        jmp kgsub_fk_scan;
      kgsub_fk_hit:
        mov rax, rcx;
        ret;
      kgsub_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let kgsub_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): slot -> row_id, gated on live KIND_GPU_SUBMIT. Labels prefixed kgsub_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kgsub_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x177;
        cmp r10, r11;
        jne kgsub_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_ros_none;

        mov rax, r12;
        jmp kgsub_ros_out;

      kgsub_ros_none:
        mov rax, 0xFF;
      kgsub_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Five args (slot, parent_slot, rights, submit_key, packed_cb).
  //
  //   packed_cb encoding:
  //     [15:0]   ctx_slot
  //     [31:16]  batch_bo_slot
  //     [63:32]  reserved (must be zero)
  //
  //  Packing keeps the ABI within the paideia-as SysV pass ceiling.
  // ==========================================================================

  pub let gpu_submit_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (submit_key: u64) (packed_cb: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): mint KIND_GPU_SUBMIT over KIND_IPC_ENDPOINT. LINEAR -- rights & R_MINT is EXPLICITLY refused (KGSUB_MINT_REFUSED_MINT) BEFORE the subset check. Sequence: slot<256; explicit R_MINT refuse; check_parent; rights_valid; unpack ctx_slot/batch_bo_slot; kgsub_check_ctx; kgsub_check_bo; submit_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed kgsub_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // submit_key
        mov rbp, r8;                     // packed_cb

        mov r10, 256;
        cmp rbx, r10;
        jae kgsub_mi_bad_slot;

        // LINEAR explicit gate (§3): rights & R_MINT must be zero.
        mov r10, r13;
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        jne kgsub_mi_refused_mint;

        mov rdi, r12;
        call kgsub_check_parent;
        cmp rax, 0;
        je  kgsub_mi_bad_parent;

        mov rdi, r13;
        call kgsub_rights_valid;
        cmp rax, 0;
        je  kgsub_mi_bad_rights;

        // Unpack ctx_slot and batch_bo_slot.
        mov r10, rbp;
        and r10, 0xFFFF;                 // ctx_slot
        mov r15, r10;                    // stash ctx_slot in r15
        mov rdi, r15;
        call kgsub_check_ctx;
        cmp rax, 0;
        je  kgsub_mi_bad_ctx;

        mov r10, rbp;
        shr r10, 16;
        and r10, 0xFFFF;                 // batch_bo_slot
        // Stash batch_bo_slot on stack (r15 holds ctx_slot).
        push r10;
        mov rdi, r10;
        call kgsub_check_bo;
        cmp rax, 0;
        je  kgsub_mi_bad_bo_pop;

        cmp r14, 0;
        je  kgsub_mi_no_key_pop;

        mov rdi, r14;
        call kgsub_find_by_key;
        cmp rax, 0xFF;
        jne kgsub_mi_in_use_pop;

        // Body1 pack: (endpoint_slot=parent_slot, ctx_slot).
        mov rdi, r12;
        mov rsi, r15;
        call kgsub_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgsub_mi_bad_state_pop;
        // Save body1 alongside batch_bo_slot on stack.
        push rax;                        // body1 on stack
        // Stack: [batch_bo_slot][body1] (rsp-relative)

        // Body2 pack: (batch_bo_slot, state=PENDING).
        mov rdi, [rsp + 8];              // batch_bo_slot
        mov rsi, 0;                      // state = PENDING
        call kgsub_body2_pack;
        pop r11;                         // body1 -> r11
        pop r10;                         // batch_bo_slot -> r10 (discarded)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgsub_mi_bad_state;
        push rax;                        // body2 on stack
        push r11;                        // body1 on stack

        // Header.
        mov rdi, r12;
        call kgsub_hdr_pack;
        pop r11;                         // body1
        pop r15;                         // body2 (reuse r15 -- ctx_slot no longer needed)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgsub_mi_bad_parent;

        // tail_alloc(hdr, submit_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call kgsub_tail_alloc;

        mov r10, 0xFFFFF56F;
        cmp rax, r10;
        je  kgsub_mi_enospc;
        mov r10, 0xFFFFF56E;
        cmp rax, r10;
        je  kgsub_mi_bad_state;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x177;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kgsub_note;

        xor rax, rax;
        jmp kgsub_mi_out;

      kgsub_mi_bad_bo_pop:
        add rsp, 8;
        jmp kgsub_mi_bad_bo;
      kgsub_mi_no_key_pop:
        add rsp, 8;
        jmp kgsub_mi_no_key;
      kgsub_mi_in_use_pop:
        add rsp, 8;
        jmp kgsub_mi_in_use;
      kgsub_mi_bad_state_pop:
        add rsp, 8;
        jmp kgsub_mi_bad_state;

      kgsub_mi_bad_slot:
        mov rax, 0xFFFFF564;
        jmp kgsub_mi_out;
      kgsub_mi_refused_mint:
        mov rdi, 3;
        call kgsub_note;
        mov rax, 0xFFFFF560;
        jmp kgsub_mi_out;
      kgsub_mi_bad_parent:
        mov rax, 0xFFFFF56D;
        jmp kgsub_mi_out;
      kgsub_mi_bad_rights:
        mov rax, 0xFFFFF56C;
        jmp kgsub_mi_out;
      kgsub_mi_bad_ctx:
        mov rax, 0xFFFFF56B;
        jmp kgsub_mi_out;
      kgsub_mi_bad_bo:
        mov rax, 0xFFFFF56A;
        jmp kgsub_mi_out;
      kgsub_mi_bad_state:
        mov rax, 0xFFFFF569;
        jmp kgsub_mi_out;
      kgsub_mi_no_endpoint:
        mov rax, 0xFFFFF568;
        jmp kgsub_mi_out;
      kgsub_mi_no_key:
        mov rax, 0xFFFFF567;
        jmp kgsub_mi_out;
      kgsub_mi_in_use:
        mov rdi, 3;
        call kgsub_note;
        mov rax, 0xFFFFF565;
        jmp kgsub_mi_out;
      kgsub_mi_enospc:
        mov rdi, 3;
        call kgsub_note;
        mov rax, 0xFFFFF566;

      kgsub_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_submit_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (submit_key: u64) (packed_cb: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call gpu_submit_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x177;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.  Advances state to FAULTED before scrubbing so consumers
  // that observe the row mid-revoke see the drain marker.
  // ==========================================================================

  pub let gpu_submit_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): revoke KIND_GPU_SUBMIT. Labels prefixed kgsub_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kgsub_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kgsub_rvk_already;

        mov r11, 0x177;
        cmp r10, r11;
        jne kgsub_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kgsub_tail_valid;
        cmp rax, 0;
        je  kgsub_rvk_clear;

        mov rdi, r13;
        call kgsub_tail_free;

      kgsub_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kgsub_note;

        xor rax, rax;
        jmp kgsub_rvk_out;

      kgsub_rvk_bad_slot:
        mov rax, 0xFFFFF564;
        jmp kgsub_rvk_out;
      kgsub_rvk_wrong_kind:
        mov rax, 0xFFFFF563;
        jmp kgsub_rvk_out;
      kgsub_rvk_already:
        mov rax, 0xFFFFF562;

      kgsub_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_submit_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call gpu_submit_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x177;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_gpu_submit : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M6-001 (#1276): KIND_GPU_SUBMIT dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kgsub_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_gpu_submit_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kgsub_hn_res;

        cmp rbp, 6;
        ja  kgsub_hn_unsup;

        cmp rbp, 6;
        je  kgsub_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kgsub_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kgsub_hn_key;
        cmp rbp, 1;
        je  kgsub_hn_ep;
        cmp rbp, 2;
        je  kgsub_hn_ctx;
        cmp rbp, 3;
        je  kgsub_hn_bo;
        cmp rbp, 4;
        je  kgsub_hn_st;
        call kgsub_row_linear;
        jmp kgsub_hn_out;

      kgsub_hn_key:
        call kgsub_row_key;
        jmp kgsub_hn_out;
      kgsub_hn_ep:
        call kgsub_row_endpoint;
        jmp kgsub_hn_out;
      kgsub_hn_ctx:
        call kgsub_row_ctx;
        jmp kgsub_hn_out;
      kgsub_hn_bo:
        call kgsub_row_bo;
        jmp kgsub_hn_out;
      kgsub_hn_st:
        call kgsub_row_state;
        jmp kgsub_hn_out;

      kgsub_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kgsub_hn_denied;
        xor rax, rax;
        jmp kgsub_hn_out;

      kgsub_hn_res:
        mov rax, 0xFFFFF56E;
        jmp kgsub_hn_out;
      kgsub_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kgsub_hn_out;
      kgsub_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kgsub_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
