// src/kernel/core/cap/kind_ec_query.pdx — R31.M1-002 (#1090)
//
// KIND_EC_QUERY derived kind: the right to be told that ONE embedded
// controller raised ONE of a named set of query events.
//
// -----------------------------------------------------------------------------
// Name check (recorded because #1569 exists)
// -----------------------------------------------------------------------------
//
// tools/lint-no-kernel-aml.sh refuses any kernel identifier matching
// `\baml`, `\bdsdt`, `\bssdt`, `\bacpica([^a-zA-Z]|$)`, `\_SB_` or
// `\_SB.`, in code AND in the justification strings (those are code, not
// comments, and the linter's comment-stripping does not reach them).
// `KIND_EC_QUERY`, `ec_query_*` and `_ec_query_table` match none of the
// six. This was CHECKED against the script rather than assumed, because
// #1569 records that `KIND_AML_SESSION` had to be renamed for exactly
// this reason and the collision was found at push time.
//
// The prose in this file therefore never names the bytecode language.
// Where it must refer to the thing that runs a query handler it says
// "the interpreter bubble", which is also the more accurate description:
// what the kernel routes to is a ring-3 process, and what that process
// does with the byte is its own business.
//
// -----------------------------------------------------------------------------
// THE PROPERTY THIS FILE EXISTS TO MAKE TRUE
// -----------------------------------------------------------------------------
//
// A holder of KIND_EC_QUERY can be told that embedded controller E
// raised query byte q, for exactly those q its row still names, and for
// no other controller. It cannot widen that set, it cannot learn about
// another controller's events, and it cannot be handed one of these
// without somebody having simultaneously proved two unrelated things:
//
//   (a) that it holds the endpoint the events will arrive on, and
//   (b) that the controller in question is a real, firmware-declared
//       EmbeddedControl operation region, named by a live KIND_OP_REGION.
//
// Neither half is decoration; §DERIVATION explains why (a) alone is an
// empty gate.
//
// -----------------------------------------------------------------------------
// WHY THE STORAGE IS A PRIVATE TABLE
// -----------------------------------------------------------------------------
//
// The tail is {ec_addr:u64, notify_bitmap:256 bits, endpoint_id:u64,
// delivered:u64} — 384 bits past what a 64-bit `target_ptr` can hold.
// So `target_ptr` holds a `row_id` into a private table, the same
// indirection KIND_HW_INTERRUPT (#1019), KIND_DMA_DOMAIN (#1036),
// KIND_OP_REGION (#1061), KIND_ACPI_EVENT (#1068) and KIND_FW_SESSION
// (#1083) use.
//
// tools/build.sh asserts that no object other than this one relocates
// against `_ec_query_table`. That is what upgrades "the mint gate is the
// only path to a row" from a claim about this file into a property of
// the whole kernel — and it is why core/acpi/ec_route.pdx, which needs
// to walk the rows on every query, does so through the exported
// selectors below rather than by touching the array.
//
// -----------------------------------------------------------------------------
// TAIL ENCODING — row indirection
// -----------------------------------------------------------------------------
//
// `_ec_query_table[row_id]`, 64 bytes (eight u64s; a power-of-two stride
// so the index is a `shl 6` — paideia-as has no `mul`):
//
//   [+0]  header word
//           bits [7:0]   reserved, must be zero
//           bits [15:8]  parent_slot   cap_table slot of the parent
//                                      KIND_IPC_ENDPOINT
//           bits [23:16] region_slot   cap_table slot of the
//                                      KIND_OP_REGION that proved the
//                                      controller exists
//           bits [39:24] region_row    that capability's own row id, the
//                                      stable key a revoke cascade would
//                                      use (a cap slot can be reused by
//                                      an unrelated region; a live row
//                                      id cannot)
//           bits [55:40] reserved, must be zero
//           bits [63:56] in_use        allocator flag; a row is free iff
//                                      this byte is zero, which .bss
//                                      zero-init makes true at boot
//   [+8]  ec_addr         INHERITED from the region row's own base. Not
//                         an argument — see §INHERITANCE.
//   [+16] notify_bitmap word 0   query bytes 0x00..0x3F
//   [+24] notify_bitmap word 1   query bytes 0x40..0x7F
//   [+32] notify_bitmap word 2   query bytes 0x80..0xBF
//   [+40] notify_bitmap word 3   query bytes 0xC0..0xFF
//   [+48] endpoint_id    INHERITED from the parent endpoint. Non-zero;
//                        zero is the event stream's "no subscriber"
//                        sentinel.
//   [+56] delivered      records this row was routed, lifetime.
//
// -----------------------------------------------------------------------------
// THE NOTIFY BITMAP STARTS FULL AND ONLY EVER NARROWS
// -----------------------------------------------------------------------------
//
// A mint allocates the row with all 256 bits set, and the only mutation
// this module offers is `ec_query_row_narrow`, which CLEARS one bit.
// There is no primitive that sets one.
//
// That asymmetry is a decision, and the alternative is worth naming so
// the decision is auditable. The obvious design takes the bitmap as a
// mint argument. It cannot be done in this ABI — 256 bits of mask plus
// slot, parent, region and rights is eight registers and SysV has six —
// and every workaround for that (a mask covering only the low 128 query
// bytes, a "band index" selecting one word, a pointer to a caller-owned
// array) either silently loses a range of `_Qxx` bytes that real
// firmware uses, or hands a raw destination address across exactly the
// boundary the confinement assertion exists to close.
//
// Starting full is not a weakening, because of what the mint gate
// already proved: the minter holds a KIND_OP_REGION over the whole
// EmbeddedControl space of this controller. "Every query this controller
// raises" is therefore reach the minter demonstrably had, and the child
// begins with no more than its parent. Narrowing afterwards is how a
// subscriber that only cares about the lid stops being woken by the
// battery — a preference, expressed monotonically, so that a holder can
// never end a boot with more reach than it started with.
//
// A holder that narrows to the empty set gets nothing. That is a legal
// and observable state (`EC_QUERY_OP_QUERY_WANTS` reports it), not an
// error: unsubscribing from everything is a choice, and turning it into
// a refusal would mean the last unsubscribe of a shutdown sequence
// failed for no reason a caller could act on.
//
// -----------------------------------------------------------------------------
// DERIVATION — over KIND_IPC_ENDPOINT, in two halves
// -----------------------------------------------------------------------------
//
// FIRST HALF: `cap_table[parent_slot].kind == KIND_IPC_ENDPOINT (5)`
// carrying RIGHT_MINT.
//
// THAT HALF IS EMPTY ON ITS OWN. Every endpoint in this system is a
// KIND_IPC_ENDPOINT — the shell's stdout included — so a gate that
// stopped here would let any process holding any endpoint mint itself a
// subscription to the embedded controller. This is the #1075 lesson
// restated: when every candidate shares the base kind, a kind check
// discriminates nothing, and a gate that discriminates nothing is worse
// than no gate because it reads like one.
//
// SECOND HALF: a second capability argument, `region_slot`, must be a
// live KIND_OP_REGION (0x150) carrying RIGHT_MINT whose address space is
// OPREG_SPACE_EC (0x03) and whose declared length is in 1..256.
//
// The two halves check unrelated things and both are necessary:
//
//   the endpoint    — WHERE the holder will be told
//   the op-region   — WHICH controller it will be told about, and that
//                     the controller is one firmware actually declared
//
// The length bound is not a formality. ACPI 6.5 §12.2 gives the
// EmbeddedControl space 256 single-byte offsets; a region declaring more
// is a malformed table, and design/acpi/embedded-controller.md §6.1
// already refuses one at bind time in the interpreter bubble. Refusing
// it again here is the third of the three independent checks that
// section enumerates, and it guards a different thing than the other
// two: this is the last statement before a SUBSCRIPTION is created, and
// a subscription to a region whose extent is fiction would outlive every
// transaction-time check.
//
//     KIND_IPC_ENDPOINT (5)      KIND_OP_REGION (0x150, space 0x03)
//         + RIGHT_MINT                    + RIGHT_MINT
//              \                              /
//               \                            /
//                +-------- both required ---+
//                              |
//                        KIND_EC_QUERY (0x156)
//                     ec_addr and endpoint_id both INHERITED
//
// -----------------------------------------------------------------------------
// INHERITANCE — ec_addr and endpoint_id are read, never argued
// -----------------------------------------------------------------------------
//
// `ec_query_cap_mint` takes no ec_addr and no endpoint id. It reads the
// region row's own base through `opregion_row_base`, and the parent
// endpoint's own id out of its `target_ptr`.
//
// This is the discipline `acpi_evt_cap_mint` uses for the GSI and
// `opregion_cap_derive` uses for the address space, for the same reason:
// a field that identifies WHAT THE PARENT IS must come from the parent,
// because a caller who can relabel it can decouple the child's claim
// from the authority that was actually checked. A subscription stamped
// with controller A's address while its region capability names
// controller B would pass both halves of the gate and then, for the
// whole of its life, receive one machine's lid events under another
// machine's name.
//
// -----------------------------------------------------------------------------
// THIS KIND IS NOT LOADER-SEEDABLE, AND THAT IS THE POINT
// -----------------------------------------------------------------------------
//
// KIND_SEEDABLE_TABLE (cap/kind.pdx) deliberately omits it, and no entry
// is added by this issue. #1597's rule is that a kind DEFINED BY ITS
// DERIVATION cannot be seeded, because seeding manufactures a root with
// no parent — not a shortcut to the same object but a different and
// unrevocable one. KIND_EC_QUERY is the strongest case for that rule in
// the tree so far: both of its parents are load-bearing, one of them
// supplies the controller address the row records, and a sidecar entry
// naming this kind would produce a subscription to an address taken from
// untrusted image bytes with no region capability behind it.
//
// The refusal needs no code. `kind_is_loader_seedable` scans an
// enumeration, and a kind that is not in it is refused. Stating the
// decision here is what #1597 asks for; adding the entry is what it
// forbids.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY — 0xFFFFFE00..0F
// -----------------------------------------------------------------------------
//
// A sixteen-wide band disjoint from every other in the tree:
// KIND_FW_SESSION owns 0xFFFFFE10..1F, the owner column owns
// 0xFFFFFE2B..2F, and the whole 0xFFFFFFxx page is exhausted (see
// cap/kind_fw_session.pdx §FAILURE TAXONOMY). Disjointness is what lets
// a caller that threads a code up through three layers still name the
// gate that refused it.
//
// -----------------------------------------------------------------------------
// DESCRIPTOR WRITES (#1579)
// -----------------------------------------------------------------------------
//
// `cap_mint_write` is the only descriptor writer used here, on both the
// mint and the revoke path — the revoke clears the descriptor with
// `cap_mint_write(slot, 0, 0, 0)` rather than three direct stores, which
// is what keeps the owner column's unconditional clear (#1587) on the
// teardown path as well as the creation path.

module KindEcQuery = structure {

  // ==========================================================================
  // Tag
  //
  // 0x156 — the first entry past the R30 derived-kind block
  // (0x150 op_region / 0x151 acpi_event / 0x152 i2c_bus / 0x153
  // i2c_slave / 0x154 gpio_line / 0x155 fw_session). Above the 4-bit
  // base-slot space, so cap/invoke.pdx compares the full u64 kind field
  // and this branch coexists with the slot-5 KIND_IPC_ENDPOINT handler.
  // ==========================================================================

  pub let KIND_EC_QUERY : u64 = 0x156   // derived-kind tag (decimal 342)

  // The two authorities the gate consults. The first is a BASE kind
  // (slot 5); the second is a DERIVED tag (0x150), because what must be
  // proved is not "this is memory" but "this is a declared operation
  // region", which only the derived capability establishes.
  pub let EC_QUERY_PARENT_KIND : u64 = 5       // = KIND_IPC_ENDPOINT
  pub let EC_QUERY_REGION_KIND : u64 = 0x150   // = KIND_OP_REGION

  // The one address space this kind will accept a region in.
  pub let EC_QUERY_SPACE : u64 = 0x03          // = OPREG_SPACE_EC

  // ACPI 6.5 §12.2: the EmbeddedControl space is 256 single-byte
  // offsets, and the query byte domain is the same 256 values.
  pub let EC_QUERY_SPACE_MAX : u64 = 256
  pub let EC_QUERY_BYTE_MAX  : u64 = 256

  // ==========================================================================
  // Rights
  //
  //   WRITE   (0x002) — narrow the notify bitmap. A WRITE right for an
  //                     operation that can only ever remove reach may
  //                     read oddly; it is correct, because the row is
  //                     mutated and a holder that may only OBSERVE must
  //                     not be able to silence a subscription somebody
  //                     else depends on.
  //   INVOKE  (0x008) — interrogate the routing filter (does this
  //                     subscription still want query byte q).
  //   REVOKE  (0x010) — tear the subscription down.
  //   OBSERVE (0x400) — read the row's own metadata: controller address,
  //                     endpoint identity, region, delivery count.
  //
  // RIGHT_MINT (0x200) is DELIBERATELY ABSENT. This kind is a leaf of
  // the lattice: nothing derives from a subscription, and a MINT bit
  // that no gate anywhere accepts as a parent right would be a rights
  // bit that looks like authority and confers none. KIND_FW_SESSION
  // (0x41B) made the same call for the same reason.
  // ==========================================================================

  pub let R_EC_QUERY_WRITE   : u64 = 0x002
  pub let R_EC_QUERY_INVOKE  : u64 = 0x008
  pub let R_EC_QUERY_REVOKE  : u64 = 0x010
  pub let R_EC_QUERY_OBSERVE : u64 = 0x400
  pub let R_EC_QUERY_ALL     : u64 = 0x41A

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE00..0F
  // ==========================================================================

  pub let EC_QUERY_OK                : u64 = 0
  pub let EC_QUERY_TAIL_ENOSPC       : u64 = 0xFFFFFE0F
  pub let EC_QUERY_TAIL_BAD_ARG      : u64 = 0xFFFFFE0E
  pub let EC_QUERY_MINT_BAD_PARENT   : u64 = 0xFFFFFE0D
  pub let EC_QUERY_MINT_BAD_RIGHTS   : u64 = 0xFFFFFE0C
  pub let EC_QUERY_MINT_BAD_ARG      : u64 = 0xFFFFFE0B
  pub let EC_QUERY_MINT_ENOSPC       : u64 = 0xFFFFFE0A

  // THE HEADLINE REFUSALS — the second half of the gate.
  //   BAD_REGION : region_slot is not a live KIND_OP_REGION with MINT.
  //   BAD_SPACE  : it is one, but over some other address space, or its
  //                declared length is 0 or past the 256-byte EC space.
  pub let EC_QUERY_MINT_BAD_REGION   : u64 = 0xFFFFFE09
  pub let EC_QUERY_MINT_BAD_SPACE    : u64 = 0xFFFFFE08

  pub let EC_QUERY_MINT_BAD_EID      : u64 = 0xFFFFFE07
  pub let EC_QUERY_REVOKE_BAD_SLOT   : u64 = 0xFFFFFE06
  pub let EC_QUERY_REVOKE_WRONG_KIND : u64 = 0xFFFFFE05
  pub let EC_QUERY_REVOKE_ALREADY    : u64 = 0xFFFFFE04
  pub let EC_QUERY_NARROW_BAD_ARG    : u64 = 0xFFFFFE03

  // Cannot collide with a well-formed row field: an in_use byte of 0xFF
  // would be 255 concurrent uses of a one-bit flag.
  pub let EC_QUERY_DECODE_BAD        : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each demands.
  //
  // Ops 3 and 4 additionally read a query byte from op_arg[15:8]. That
  // is a VALUE, not an authority: it selects which bit of this row's own
  // bitmap to read or clear, and no value of it can reach another row or
  // another controller. Every op that could name a controller reads it
  // from the row instead — there is no op on this capability that takes
  // an address.
  // ==========================================================================

  pub let EC_QUERY_OP_QUERY_ADDR      : u64 = 0   // OBSERVE
  pub let EC_QUERY_OP_QUERY_ENDPOINT  : u64 = 1   // OBSERVE
  pub let EC_QUERY_OP_QUERY_DELIVERED : u64 = 2   // OBSERVE
  pub let EC_QUERY_OP_QUERY_WANTS     : u64 = 3   // INVOKE  (byte in [15:8])
  pub let EC_QUERY_OP_UNSUBSCRIBE     : u64 = 4   // WRITE   (byte in [15:8])
  pub let EC_QUERY_OP_QUERY_REGION    : u64 = 5   // OBSERVE
  pub let EC_QUERY_OP_MAX             : u64 = 5

  // ==========================================================================
  // Storage — 8 rows x 64 bytes.
  //
  // Eight, for the reason kind_acpi_event.pdx sizes its table at eight:
  // a subscription is per-PROCESS, not per-EVENT-SOURCE. Fan-out across
  // the 256 query bytes is the bitmap's job, not the table's, so the
  // table is sized for the number of processes that legitimately watch
  // an embedded controller — the supervisor, a power-policy monitor, a
  // compositor wanting hot-keys — and not for the number of events.
  // Stating that here is what stops a later reader from "fixing" this to
  // 256.
  // ==========================================================================

  pub let EC_QUERY_MAX       : u64 = 8
  pub let EC_QUERY_ROW_BYTES : u64 = 64

  pub let mut _ec_query_table : [u64; 64] = uninit @align(64)

  // Row-dump tag, separate from the dispatch-chatter tag in
  // core/cap/tags.pdx so row dumps and invocation chatter never
  // interleave under one label.
  pub let ec_query_k_row : [u8; 13] = "EC QUERY ROW\0"

  // ==========================================================================
  // ec_query_table_reset() -> ()
  // ==========================================================================

  pub let ec_query_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): zero all 64 qwords of the subscription table. A qword loop rather than a row loop because a full zero does not care about the row stride and a qword loop has one bound to get wrong instead of two. Zeroing [row+0] clears in_use, so reset and SCRUB are the same operation: no stale endpoint identity and no stale controller address survives, and both matter here because together they are a recorded permission to be told what a machine's lid, battery and thermal sensors are doing. Leaf. Labels prefixed ecq_tr_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _ec_query_table];
        xor rcx, rcx;
        xor rax, rax;
      ecq_tr_next:
        cmp rcx, 64;
        jae ecq_tr_done;
        mov r8, rcx;
        shl r8, 3;
        add r8, r10;
        mov [r8 + 0], rax;
        add rcx, 1;
        jmp ecq_tr_next;
      ecq_tr_done:
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let ec_query_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M1-002 (#1090): 1 iff (rights & R_EC_QUERY_ALL) == rights, i.e. the request is a SUBSET of what this kind defines. A subset test rather than an equality test, so a caller may mint an observe-only subscription; and a subset test rather than a mask-and-proceed, so a request naming RIGHT_MINT (0x200) is REFUSED rather than silently stripped. Silent stripping is the failure this shape exists to avoid: the caller would hold a capability it believes can derive and cannot, and would discover it at the first mint attempt on a path with no diagnosis. Pure leaf. Labels prefixed ecq_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41A;                  // R_EC_QUERY_ALL
        and rax, r10;
        cmp rax, rdi;
        jne ecq_rv_no;
        mov rax, 1;
        ret;
      ecq_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_check_parent_endpoint(parent_slot) -> 1 | 0
  //
  // THE FIRST HALF OF THE GATE. Necessary, and by itself empty.
  // ==========================================================================

  pub let ec_query_check_parent_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): first half of the derivation gate. Bounds-check parent_slot < 256 BEFORE any address arithmetic so an unbounded slot cannot read outside cap_table; descriptor at cap_table + slot*8 + slot*16 (stride 24 per cap/mint.pdx); require kind ([+0]) == 5 (KIND_IPC_ENDPOINT) AND rights ([+8]) carrying RIGHT_MINT (0x200). Both conditions: the kind establishes the caller holds an endpoint, MINT establishes it was authorised to hand reach to that endpoint onward. THIS PREDICATE DISCRIMINATES ALMOST NOTHING ON ITS OWN and is not meant to -- every endpoint in the machine is kind 5, the shell's stdout included -- which is why ec_query_cap_mint_inner refuses unless the SECOND half (ec_query_check_region_ec) also passes. It is a separate function rather than four inline instructions so that the two halves are separately mutable and separately witnessed: a corpus that can fail one and pass the other is what proves neither is doing the other's work. Pure read, no writes. Labels prefixed ecq_cpe_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae ecq_cpe_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 5;                      // KIND_IPC_ENDPOINT
        cmp r10, r11;
        jne ecq_cpe_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  ecq_cpe_no;

        mov rax, 1;
        ret;

      ecq_cpe_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_parent_eid(parent_slot) -> endpoint_id | 0
  // ==========================================================================

  pub let ec_query_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): the parent's endpoint id, read out of cap_table[parent_slot].target_ptr[15:0] -- the encoding cap/kind_endpoint.pdx's endpoint_tail_pack writes. The kind is re-checked here rather than trusted from the gate, because this function is what turns a slot number into the IDENTITY EVERY ROUTED RECORD WILL CARRY, and a caller that reached it by another path must not get an id out of an unrelated descriptor. Returns 0 on any refusal; 0 is also the event stream's 'no subscriber' sentinel, which acpi_evt_offer already counts as unrouted, so a fabricated parent degrades into a counted refusal rather than a plausible identity. Pure read. Labels prefixed ecq_pe_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae ecq_pe_zero;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 5;
        cmp r10, r11;
        jne ecq_pe_zero;

        mov rax, [rax + 16];
        mov r11, 0xFFFF;
        and rax, r11;
        ret;

      ecq_pe_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_region_row(region_slot) -> row_id | EC_QUERY_DECODE_BAD
  // ==========================================================================

  pub let ec_query_region_row : (u64) -> u64 !{mem} @{cap} =
    fn (region_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): row_id = cap_table[region_slot].target_ptr[15:0], for a descriptor that must already be a KIND_OP_REGION (0x150). The kind is re-checked here for the same reason ec_query_parent_eid re-checks its own: this function turns a slot number into a key into ANOTHER MODULE'S private table, and handing kind_op_region.pdx a row id derived from some unrelated descriptor's target_ptr would make its decoders answer questions about a row that has nothing to do with the capability presented. Returns EC_QUERY_DECODE_BAD (all ones) on any refusal, which is not a plausible row id because op-region rows are 16-bit and the table holds 32. Pure read. Labels prefixed ecq_rr_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae ecq_rr_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x150;                  // KIND_OP_REGION
        cmp r10, r11;
        jne ecq_rr_bad;

        mov rax, [rax + 16];
        mov r11, 0xFFFF;
        and rax, r11;
        ret;

      ecq_rr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_check_region_ec(region_slot)
  //   -> EC_QUERY_OK | EC_QUERY_MINT_BAD_REGION | EC_QUERY_MINT_BAD_SPACE
  //
  // THE SECOND HALF OF THE GATE, and the half that carries the whole
  // discrimination. Kind AND right AND address space AND extent.
  //
  // It returns a CODE rather than a boolean, and the split is the point:
  // "you presented something that is not a region capability" and "you
  // presented a region capability over the wrong space, or of an
  // impossible size" are different mistakes with different fixes, and a
  // predicate that answered 0 to both would make the mint report one
  // code for two causes.
  // ==========================================================================

  pub let ec_query_check_region_ec : (u64) -> u64 !{mem} @{cap} =
    fn (region_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): second half of the derivation gate, and the half that does the discriminating. Returns EC_QUERY_OK, or the code naming which CLASS of mistake was made -- BAD_REGION for conditions (1) and (2), which say the thing presented is not a region capability at all, and BAD_SPACE for (3) and (4), which say it is one and it describes the wrong device. Two codes and not one, because the two have different fixes: mint a region capability, versus stop minting one over SystemMemory. Four conditions, none of which subsumes another: (1) cap_table[region_slot].kind == 0x150 -- a KIND_OP_REGION, not a raw KIND_MEMORY or KIND_IO_PORT, because what must be proved is not 'this is addressable' but 'firmware declared an operation region here', and only the derived capability establishes that. (2) rights carry RIGHT_MINT (0x200) -- authority to hand the region's reach onward, the same bit every other derivation gate in this tree demands of its parent. (3) opregion_row_space(row) == 0x03 -- the region is EmbeddedControl and not one of the other ten spaces; a subscription to a SystemMemory region's 'queries' would be a subscription to events that do not exist, minted against a capability that passed conditions (1) and (2) perfectly. (4) opregion_row_len(row) is in 1..256 -- ACPI 6.5 sec 12.2 gives the space 256 single-byte offsets, a declaration past that is a malformed table, and a declaration of ZERO is a region with no bytes in it. This is the third of the three independent range checks design/acpi/embedded-controller.md sec 6.1 enumerates, and it guards a different thing than the other two: it is the last statement before a SUBSCRIPTION is created, and a subscription outlives every transaction-time check. Refuses BAD_SPACE on a decode failure from either row accessor, so a dead region row cannot pass by returning an all-ones length that happens to compare below the bound -- the all-ones sentinel is tested explicitly before the range test. Three pushes (rbx, r12, r13) carry the slot and row id across the two nested calls; entry rsp%16 == 8 and three pushes return it to 0 at both. Labels prefixed ecq_cre_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // region_slot

        cmp rbx, 256;
        jae ecq_cre_no_region;

        mov rax, cap_table;
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        // (1) kind.
        mov r10, [rax + 0];
        mov r11, 0x150;                  // KIND_OP_REGION
        cmp r10, r11;
        jne ecq_cre_no_region;

        // (2) RIGHT_MINT.
        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  ecq_cre_no_region;

        mov r12, [rax + 16];
        mov r11, 0xFFFF;
        and r12, r11;                    // region row id

        // (3) address space must be EmbeddedControl.
        mov rdi, r12;
        call opregion_row_space;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_cre_no_space;
        mov r11, 0x03;                   // EC_QUERY_SPACE
        cmp rax, r11;
        jne ecq_cre_no_space;

        // (4) declared extent must be in 1..256.
        mov rdi, r12;
        call opregion_row_len;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_cre_no_space;
        cmp rax, 0;
        je  ecq_cre_no_space;
        mov r11, 256;                    // EC_QUERY_SPACE_MAX
        cmp rax, r11;
        ja  ecq_cre_no_space;

        xor rax, rax;                    // EC_QUERY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_cre_no_region:
        mov rax, 0xFFFFFE09;             // EC_QUERY_MINT_BAD_REGION
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_cre_no_space:
        mov rax, 0xFFFFFE08;             // EC_QUERY_MINT_BAD_SPACE
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ec_query_tail_pack(parent_slot, region_slot, region_row)
  //   -> hdr | EC_QUERY_DECODE_BAD
  // ==========================================================================

  pub let ec_query_tail_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (parent_slot: u64, region_slot: u64, region_row: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M1-002 (#1090): canonical header-word encoder. Validates parent_slot < 256, region_slot < 256 and region_row <= 0xFFFF, then packs (parent_slot << 8) | (region_slot << 16) | (region_row << 24), leaving bits [7:0], [55:40] and [63:56] clear. Bits [63:56] belong to the allocator's in_use flag and MUST leave this function zero: a header arriving with in_use pre-set would hand back a row the free scan skips forever, which is a leak of a table slot rather than a leak of authority and therefore the kind of bug that shows up as 'the ninth subscription fails' five rounds later. The encoder exists rather than three shifts at the call site so there is one definition of the layout to keep in step with the decoders below. Pure leaf. Labels prefixed ecq_tp_ per reserved-label discipline.",
      block: {
        cmp rdi, 256;
        jae ecq_tp_bad;
        cmp rsi, 256;
        jae ecq_tp_bad;
        mov r10, 0xFFFF;
        cmp rdx, r10;
        ja  ecq_tp_bad;

        mov rax, rdi;
        shl rax, 8;
        mov r11, rsi;
        shl r11, 16;
        or  rax, r11;
        mov r11, rdx;
        shl r11, 24;
        or  rax, r11;
        ret;

      ecq_tp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let ec_query_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M1-002 (#1090): parent endpoint slot from header bits [15:8]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let ec_query_hdr_region : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M1-002 (#1090): region capability slot from header bits [23:16]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let ec_query_hdr_region_row : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M1-002 (#1090): region row id from header bits [39:24]. The row id and not the cap slot is the stable key, because a cap slot can be reused by an unrelated region while a live row id cannot. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_tail_alloc(hdr, ec_addr, endpoint_id) -> row_id | error
  //
  // The only writer of an {ec_addr, endpoint_id} pair in this kernel.
  // ==========================================================================

  pub let ec_query_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64, ec_addr: u64, endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): allocate and populate a free _ec_query_table row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES AN {ec_addr, endpoint_id} PAIR, which is what makes the two-part gate upstream of it exhaustive rather than merely usual. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (those bits are the allocator's in_use flag, and a caller that pre-set them would be handed a row the free scan skips forever); hdr bits [7:0] or [55:40] non-zero -> TAIL_BAD_ARG, because a reserved bit that is merely ignored is a reserved bit a later revision cannot use; endpoint_id == 0 -> TAIL_BAD_ARG, because zero is the event stream's 'no subscriber' sentinel and a zero-identity subscription would have every record routed to it refused as unroutable while looking perfectly registered. ec_addr is NOT range-checked here: it is inherited from an op-region row whose extent the gate already bounded to 1..256, and re-deriving a bound from an argument would create a second, weaker definition of what a legal controller address is. Low-first scan over 8 rows of 64 bytes, free iff the in_use byte (byte 7 of [row+0]) is zero; exhaustion -> TAIL_ENOSPC. Claim: [row+0] = hdr | (1 << 56), [row+8] = ec_addr, the four bitmap words = ALL ONES (see the module header: the bitmap starts full and only ever narrows, because the reach it describes is reach the mint gate proved the minter held), [row+48] = endpoint_id, [row+56] = 0 delivered. Leaf, no nested calls. Labels prefixed ecq_ta_ per reserved-label discipline.",
      block: {
        // hdr bits [63:56] must be clear.
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne ecq_ta_bad;

        // hdr bits [7:0] must be clear.
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0;
        jne ecq_ta_bad;

        // hdr bits [55:40] must be clear.
        mov rax, rdi;
        shr rax, 40;
        mov r11, 0xFFFF;
        and rax, r11;
        cmp rax, 0;
        jne ecq_ta_bad;

        cmp rdx, 0;
        je  ecq_ta_bad;

        lea r10, [rip + _ec_query_table];
        xor rcx, rcx;
      ecq_ta_next:
        cmp rcx, 8;                      // EC_QUERY_MAX
        jae ecq_ta_enospc;
        mov r8, rcx;
        shl r8, 6;                       // * EC_QUERY_ROW_BYTES
        add r8, r10;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ecq_ta_claim;
        add rcx, 1;
        jmp ecq_ta_next;

      ecq_ta_claim:
        mov rax, 1;
        shl rax, 56;
        or  rax, rdi;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rsi;              // ec_addr

        mov r11, 0xFFFFFFFFFFFFFFFF;
        mov [r8 + 16], r11;              // notify bytes 0x00..0x3F
        mov [r8 + 24], r11;              // notify bytes 0x40..0x7F
        mov [r8 + 32], r11;              // notify bytes 0x80..0xBF
        mov [r8 + 40], r11;              // notify bytes 0xC0..0xFF

        mov [r8 + 48], rdx;              // endpoint_id
        xor rax, rax;
        mov [r8 + 56], rax;              // delivered
        mov rax, rcx;                    // row_id
        ret;

      ecq_ta_enospc:
        mov rax, 0xFFFFFE0F;             // EC_QUERY_TAIL_ENOSPC
        ret;

      ecq_ta_bad:
        mov rax, 0xFFFFFE0E;             // EC_QUERY_TAIL_BAD_ARG
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_tail_free(row_id) -> ()
  // ==========================================================================

  pub let ec_query_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): row_id >= EC_QUERY_MAX -> silent no-op. Otherwise zero all eight qwords, which clears in_use and scrubs the endpoint identity, the controller address and the notify bitmap in the same store sequence. Free-without-scrub is how one process inherits another's subscription through a reused row, and on this kind the inherited thing is a standing permission to be told what a machine's lid and battery are doing. Scrubbing the BITMAP matters as much as scrubbing the identity: a row freed while narrowed and reused without a scrub would hand the next holder a subscription silently missing the events the previous holder had unsubscribed from, which presents as a device that works for one process and not the next. Leaf. Labels prefixed ecq_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae ecq_tf_out;
        mov r8, rdi;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        xor rax, rax;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;
        mov [r8 + 32], rax;
        mov [r8 + 40], rax;
        mov [r8 + 48], rax;
        mov [r8 + 56], rax;
      ecq_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_tail_valid(row_id) -> 1 | 0
  // ==========================================================================

  pub let ec_query_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): 1 iff row_id < EC_QUERY_MAX and its in_use byte is set. Every decoder below calls this first, so 'is this row live' has one definition. Leaf. Labels prefixed ecq_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae ecq_tv_no;
        mov r8, rdi;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ecq_tv_no;
        mov rax, 1;
        ret;
      ecq_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row decoders. Each returns EC_QUERY_DECODE_BAD on a dead row.
  // ==========================================================================

  pub let ec_query_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): the header word of a live row, EC_QUERY_DECODE_BAD on a dead one. One push (rbx, carrying row_id) leaves rsp%16 == 0 at the nested validity call. Labels prefixed ecq_rh_ per reserved-label discipline.",
      block: {
        push rbx;
        mov rbx, rdi;
        call ec_query_tail_valid;
        cmp rax, 0;
        je  ecq_rh_bad;
        mov r8, rbx;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 0];
        pop rbx;
        ret;
      ecq_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let ec_query_row_addr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): the controller address a live row names, EC_QUERY_DECODE_BAD on a dead one. This is the field that decides WHICH embedded controller a subscription is for, and it is never accepted as an argument anywhere -- it is inherited at mint from the op-region row and only read thereafter. Labels prefixed ecq_ra_ per reserved-label discipline.",
      block: {
        push rbx;
        mov rbx, rdi;
        call ec_query_tail_valid;
        cmp rax, 0;
        je  ecq_ra_bad;
        mov r8, rbx;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 8];
        pop rbx;
        ret;
      ecq_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let ec_query_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): the endpoint identity every record routed to a live row is stamped with, EC_QUERY_DECODE_BAD on a dead one. Labels prefixed ecq_re_ per reserved-label discipline.",
      block: {
        push rbx;
        mov rbx, rdi;
        call ec_query_tail_valid;
        cmp rax, 0;
        je  ecq_re_bad;
        mov r8, rbx;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 48];
        pop rbx;
        ret;
      ecq_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let ec_query_row_delivered : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): lifetime count of records routed to a live row, EC_QUERY_DECODE_BAD on a dead one. Lifetime rather than since-last-read, because a counter a reader can reset is a counter two readers disagree about. Labels prefixed ecq_rd_ per reserved-label discipline.",
      block: {
        push rbx;
        mov rbx, rdi;
        call ec_query_tail_valid;
        cmp rax, 0;
        je  ecq_rd_bad;
        mov r8, rbx;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 56];
        pop rbx;
        ret;
      ecq_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let ec_query_row_region_row : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): the op-region row id a live subscription was minted against, EC_QUERY_DECODE_BAD on a dead one. Recorded so a future cascade keyed on the region can find its subscriptions without re-deriving them from a cap slot that may since have been reused. One push (rbx) carries row_id across the two nested calls and leaves rsp%16 == 0 at both. Labels prefixed ecq_rrr_ per reserved-label discipline.",
      block: {
        push rbx;
        mov rbx, rdi;
        call ec_query_row_hdr;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_rrr_bad;
        mov rdi, rax;
        call ec_query_hdr_region_row;
        pop rbx;
        ret;
      ecq_rrr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ec_query_row_wants(row_id, query_byte) -> 1 | 0
  //
  // THE FILTER. Is bit `query_byte` of this row's notify bitmap set.
  // ==========================================================================

  pub let ec_query_row_wants : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64, query_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): 1 iff a live row's notify bitmap has bit query_byte set. Refuses (returns 0) on a dead row or a query byte >= 256 -- 0 rather than an error code because this is a PREDICATE consulted once per row per event on the routing path, and a routing loop that had to distinguish 'no' from 'malformed' at every row would push that decision into the caller eight times per query. The malformed case is caught once, by the caller, before the loop. Bit selection avoids a variable-count shift, which the mnemonic table does not carry: word index = query_byte >> 6 (a constant shift), byte offset = 16 + index*8 (a constant shift and an add), bit index = query_byte & 63, and the selected word is then shifted right ONE AT A TIME, bit-index times, bounded at 63 iterations. A bounded walk over a 6-bit count on a path that runs at most eight times per platform event is not a cost worth trading a correctness property for -- and the same idiom appears in cap/kind_fw_session.pdx's domain-bit test for the same reason. Leaf, no nested calls. Labels prefixed ecq_rw_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae ecq_rw_no;
        mov r10, 256;                    // EC_QUERY_BYTE_MAX
        cmp rsi, r10;
        jae ecq_rw_no;

        mov r8, rdi;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ecq_rw_no;

        // word index = query_byte >> 6 ; offset = 16 + index*8
        mov r10, rsi;
        shr r10, 6;
        shl r10, 3;
        add r10, 16;
        add r8, r10;
        mov rax, [r8 + 0];

        // bit index = query_byte & 63 ; bounded one-at-a-time shift.
        mov r11, rsi;
        and r11, 63;
      ecq_rw_shift:
        cmp r11, 0;
        je  ecq_rw_test;
        shr rax, 1;
        sub r11, 1;
        jmp ecq_rw_shift;

      ecq_rw_test:
        and rax, 1;
        ret;

      ecq_rw_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_row_narrow(row_id, query_byte) -> EC_QUERY_OK | error
  //
  // THE ONLY MUTATION. It can only ever clear a bit.
  // ==========================================================================

  pub let ec_query_row_narrow : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64, query_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): clear bit query_byte of a live row's notify bitmap. THE ONLY FUNCTION IN THIS MODULE THAT MUTATES A BITMAP, AND IT CANNOT SET A BIT. There is deliberately no widening counterpart: the reach a subscription confers is fixed at mint by what the region capability proved, and a holder that could set bits could re-acquire, at any later moment, reach it had given up -- which would make the bitmap a preference dressed as a boundary. Clearing is expressed as word &= ~(1 << bit), with the mask built by a bounded one-at-a-time left shift for the reason ec_query_row_wants uses a bounded right shift (no variable-count shift in the mnemonic table) and inverted by xor against all-ones rather than a dedicated not, so the sequence is three ordinary ALU ops a reader can check. Refuses NARROW_BAD_ARG on a dead row or a query byte >= 256 -- an error code and not a silent no-op, because a caller unsubscribing from an event it will still receive must be told, and this is the one path where a wrong answer is invisible until the event arrives. Idempotent: narrowing an already-clear bit returns OK, because a caller that unsubscribes twice has achieved what it asked for. Leaf. Labels prefixed ecq_rn_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae ecq_rn_bad;
        mov r10, 256;
        cmp rsi, r10;
        jae ecq_rn_bad;

        mov r8, rdi;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ecq_rn_bad;

        mov r10, rsi;
        shr r10, 6;
        shl r10, 3;
        add r10, 16;
        add r8, r10;                     // address of the selected word

        // mask = 1 << (query_byte & 63), by bounded left shift.
        mov r11, rsi;
        and r11, 63;
        mov rcx, 1;
      ecq_rn_shift:
        cmp r11, 0;
        je  ecq_rn_apply;
        shl rcx, 1;
        sub r11, 1;
        jmp ecq_rn_shift;

      ecq_rn_apply:
        mov r9, 0xFFFFFFFFFFFFFFFF;
        xor r9, rcx;                     // ~mask
        mov rax, [r8 + 0];
        and rax, r9;
        mov [r8 + 0], rax;
        xor rax, rax;                    // EC_QUERY_OK
        ret;

      ecq_rn_bad:
        mov rax, 0xFFFFFE03;             // EC_QUERY_NARROW_BAD_ARG
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_row_covers(row_id, ec_addr) -> 1 | 0
  //
  // Is this live row a subscription to THIS controller, whatever it may
  // have narrowed away.
  // ==========================================================================

  pub let ec_query_row_covers : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64, ec_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): 1 iff a live row names controller ec_addr. Separate from ec_query_row_target so the routing path in core/acpi/ec_route.pdx can tell 'this machine has no subscriber for that controller' from 'it has one and the subscriber unsubscribed from this event'. Those two have different fixes -- the first is a missing mint, the second is the subscriber working as configured -- and a router that reported them under one counter would send an operator looking for a capability that was never supposed to exist. Leaf. Labels prefixed ecq_rc_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae ecq_rc_no;
        mov r8, rdi;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ecq_rc_no;
        mov rax, [r8 + 8];
        cmp rax, rsi;
        jne ecq_rc_no;
        mov rax, 1;
        ret;
      ecq_rc_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_row_target(row_id, ec_addr, query_byte) -> endpoint_id | 0
  //
  // THE ROUTING SELECTOR. The one function core/acpi/ec_route.pdx needs,
  // and the reason it needs no access to _ec_query_table.
  // ==========================================================================

  pub let ec_query_row_target : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64, ec_addr: u64, query_byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): the endpoint identity to route (ec_addr, query_byte) to through this row, or 0 if this row is not a recipient. Three conditions, all required: the row is live, it names this controller, and its notify bitmap still wants this query byte. Returning the IDENTITY rather than a boolean is what keeps _ec_query_table confined to this object: the router needs the subscriber field and nothing else, so it gets exactly that and never an address into the table. tools/build.sh asserts no other object relocates against the array, and this signature is what makes that assertion satisfiable rather than merely aspirational. Zero is an unambiguous 'no' because ec_query_tail_alloc refuses a zero endpoint id. Two pushes plus the return address would misalign; three (rbx, r12, r13) carry the row id and the query byte across the two nested calls and leave rsp%16 == 0 at both. Labels prefixed ecq_rt_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // ec_addr
        mov r13, rdx;                    // query_byte

        mov rdi, rbx;
        mov rsi, r12;
        call ec_query_row_covers;
        cmp rax, 0;
        je  ecq_rt_no;

        mov rdi, rbx;
        mov rsi, r13;
        call ec_query_row_wants;
        cmp rax, 0;
        je  ecq_rt_no;

        mov r8, rbx;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 48];              // endpoint_id
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_rt_no:
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ec_query_row_note_delivered(row_id) -> ()
  // ==========================================================================

  pub let ec_query_row_note_delivered : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-002 (#1090): increment a live row's delivery counter; silent no-op on a dead row or an out-of-range id. A no-op rather than a refusal because the caller is the routing loop, which has already established the row was a recipient, and a failure channel here would be one the router could only log. Counted PER ROW rather than only in the router's aggregate, because 'this subscription has been told about eleven events' is the number an operator needs when one subscriber works and another does not, and an aggregate cannot answer it. Leaf. Labels prefixed ecq_rnd_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae ecq_rnd_out;
        mov r8, rdi;
        shl r8, 6;
        lea r9, [rip + _ec_query_table];
        add r8, r9;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ecq_rnd_out;
        mov rax, [r8 + 56];
        add rax, 1;
        mov [r8 + 56], rax;
      ecq_rnd_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // ec_query_cap_mint_inner(slot, parent_slot, region_slot, rights)
  //   -> EC_QUERY_OK | EC_QUERY_MINT_*
  //
  // SysV: rdi=slot, rsi=parent_slot, rdx=region_slot, rcx=rights.
  // ==========================================================================

  pub let ec_query_cap_mint_inner : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64, parent_slot: u64, region_slot: u64, rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): mint a KIND_EC_QUERY subscription. Sequence: (1) slot < 256 else MINT_BAD_ARG. (2) ec_query_check_parent_endpoint(parent_slot) -- FIRST HALF of the gate -- else MINT_BAD_PARENT. (3) ec_query_check_region_ec(region_slot) -- SECOND HALF, and the half that discriminates -- whose code (MINT_BAD_REGION for 'that is not a region capability', MINT_BAD_SPACE for 'it is one, over the wrong space or of an impossible size') is PROPAGATED VERBATIM rather than collapsed, so the two mistakes stay separately diagnosable; the first half admits every endpoint in the machine and would be an empty gate alone, which is the #1075 lesson this kind is the second instance of. (4) ec_query_rights_valid(rights) else MINT_BAD_RIGHTS. (5) INHERIT the endpoint identity via ec_query_parent_eid; zero -> MINT_BAD_EID. (6) INHERIT the controller address: ec_query_region_row(region_slot) then opregion_row_base of that row; a decode failure from either -> MINT_BAD_SPACE, since the only way to reach it after step 3 passed is a row that died between the two calls. Neither inherited field is an argument, for the reason acpi_evt_cap_mint declines to accept a GSI: a field identifying WHAT THE PARENT IS must come from the parent, or the child's claim decouples from the authority that was checked, and here the consequence is a subscription that reports one machine's lid events under another controller's address for the whole of its life. (7) ec_query_tail_pack then ec_query_tail_alloc, translating TAIL codes into distinct MINT codes so each failure edge stays nameable at the boundary. (8) cap_mint_write(slot, 0x156, rights, row_id) -- the only descriptor writer, per #1579. The notify bitmap is NOT an argument anywhere in this sequence; it is allocated full and narrows only, as the module header argues. Five pushes (rbx, r12, r13, r14, r15) hold slot, parent_slot, region_slot, rights and the inherited identity across the seven nested calls; entry rsp%16 == 8 and five pushes return it to 0 at every call site. Labels prefixed ecq_mi_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // region_slot
        mov r15, rcx;                    // rights

        cmp r12, 256;
        jae ecq_mi_bad_arg;

        // -- (2) first half.
        mov rdi, r13;
        call ec_query_check_parent_endpoint;
        cmp rax, 0;
        je  ecq_mi_bad_parent;

        // -- (3) second half. Its code is propagated verbatim, so
        //    BAD_REGION and BAD_SPACE reach the caller distinct.
        mov rdi, r14;
        call ec_query_check_region_ec;
        cmp rax, 0;
        jne ecq_mi_out;

        // -- (4) rights subset.
        mov rdi, r15;
        call ec_query_rights_valid;
        cmp rax, 0;
        je  ecq_mi_bad_rights;

        // -- (5) inherit the endpoint identity.
        mov rdi, r13;
        call ec_query_parent_eid;
        cmp rax, 0;
        je  ecq_mi_bad_eid;
        mov rbx, rax;                    // endpoint_id

        // -- (6) inherit the controller address, through the region row.
        mov rdi, r14;
        call ec_query_region_row;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_mi_bad_space;
        mov r10, rax;                    // region row id

        // Pack the header while the row id is live, so the region row
        // travels into the row as a stable key.
        mov rdi, r13;                    // parent_slot
        mov rsi, r14;                    // region_slot
        mov rdx, r10;                    // region_row
        call ec_query_tail_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_mi_bad_arg;
        mov r13, rax;                    // hdr (parent_slot no longer needed)

        mov rdi, r14;
        call ec_query_region_row;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_mi_bad_space;
        mov rdi, rax;
        call opregion_row_base;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ecq_mi_bad_space;
        mov r14, rax;                    // ec_addr (region_slot no longer needed)

        // -- (7) row.
        mov rdi, r13;                    // hdr
        mov rsi, r14;                    // ec_addr
        mov rdx, rbx;                    // endpoint_id
        call ec_query_tail_alloc;

        mov r11, 0xFFFFFE0F;             // EC_QUERY_TAIL_ENOSPC
        cmp rax, r11;
        je  ecq_mi_enospc;
        mov r11, 0xFFFFFE0E;             // EC_QUERY_TAIL_BAD_ARG
        cmp rax, r11;
        je  ecq_mi_bad_arg;

        // -- (8) descriptor.
        mov rcx, rax;                    // target_ptr = row_id
        mov rdi, r12;                    // slot
        mov rsi, 0x156;                  // KIND_EC_QUERY
        mov rdx, r15;                    // rights
        call cap_mint_write;

        xor rax, rax;                    // EC_QUERY_OK
        jmp ecq_mi_out;

      ecq_mi_bad_parent:
        mov rax, 0xFFFFFE0D;
        jmp ecq_mi_out;
      ecq_mi_bad_rights:
        mov rax, 0xFFFFFE0C;
        jmp ecq_mi_out;
      ecq_mi_enospc:
        mov rax, 0xFFFFFE0A;
        jmp ecq_mi_out;
      ecq_mi_bad_space:
        mov rax, 0xFFFFFE08;
        jmp ecq_mi_out;
      ecq_mi_bad_eid:
        mov rax, 0xFFFFFE07;
        jmp ecq_mi_out;
      ecq_mi_bad_arg:
        mov rax, 0xFFFFFE0B;

      ecq_mi_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ec_query_cap_mint(slot, parent_slot, region_slot, rights) -> code
  //
  // Audited entry point.
  // ==========================================================================

  pub let ec_query_cap_mint : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64, parent_slot: u64, region_slot: u64, rights: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): audited entry point for the subscription mint, same wrapper shape as opregion_cap_mint_root / acpi_evt_cap_mint / gpio_line_cap_mint. The audit is not decoration on this kind in particular: a subscription is a standing entitlement to learn what a machine's lid, battery, thermal sensors and hot-keys are doing, and the only way to answer 'which principal was authorised to observe the embedded controller during this boot' after the fact is for every mint that ever succeeded to have left a record. Putting emission in the wrapper rather than at call sites means a second mint path cannot exist without being audited. The PRINCIPAL recorded is the region slot and not the endpoint slot, because the region capability is the authority that actually discriminated -- the endpoint half admits every process in the machine, so recording it as the principal would name an authority that decided nothing. Three pushes (r12, r13, r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls. r12/r13 are saved before the inner call because the inner body clobbers rdi/rdx; the four argument registers are untouched by the two movs, so the inner body sees them exactly as passed. r14 carries the inner outcome across drv_audit_emit and is restored to rax, making the wrapper return-value transparent. Emission covers every exit, success and all seven refusals, because the code itself is field 5. Labels prefixed ecq_mw_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rdx;                    // principal (region slot)

        call ec_query_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x156;                  // KIND_EC_QUERY
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ec_query_cap_revoke_inner(slot) -> EC_QUERY_OK | EC_QUERY_REVOKE_*
  // ==========================================================================

  pub let ec_query_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): revoke a KIND_EC_QUERY subscription. Sequence: slot < 256 else REVOKE_BAD_SLOT; kind == 0 -> REVOKE_ALREADY, idempotent on a null slot and a DISTINCT code from success so a caller can tell 'nothing to do' from 'done'; kind != 0x156 -> REVOKE_WRONG_KIND, which is what stops a revoke aimed at this kind from freeing another kind's row through a coincidentally-shaped target_ptr; then ec_query_tail_free(target_ptr[15:0]), then cap_mint_write(slot, 0, 0, 0) to clear the descriptor. The descriptor is cleared through cap_mint_write rather than three direct stores because that function also clears the owner column unconditionally (#1587), and a teardown that left the column stamped would leave a dead principal owning a slot a later sweep would revoke on somebody else's behalf. THE ROW IS FREED BEFORE THE DESCRIPTOR IS CLEARED, which is the opposite of the order it reads: freeing first means there is no window in which a live descriptor points at a freed row, only one in which a freed row is still pointed at by a descriptor whose kind still gates every reader. There is NO cascade: nothing in this tree derives from KIND_EC_QUERY, and an empty cascade call would be a hook that looks maintained and is not. Three pushes (rbx, r12, r13) carry the slot, the descriptor address and the row id across the two nested calls. Labels prefixed ecq_ri_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        cmp rbx, 256;
        jae ecq_ri_bad_slot;

        mov rax, cap_table;
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r12, rax;                    // descriptor address

        mov r10, [r12 + 0];
        cmp r10, 0;
        je  ecq_ri_already;
        mov r11, 0x156;
        cmp r10, r11;
        jne ecq_ri_wrong;

        mov r13, [r12 + 16];
        mov r11, 0xFFFF;
        and r13, r11;                    // row_id

        mov rdi, r13;
        call ec_query_tail_free;

        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // EC_QUERY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_ri_bad_slot:
        mov rax, 0xFFFFFE06;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_ri_wrong:
        mov rax, 0xFFFFFE05;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_ri_already:
        mov rax, 0xFFFFFE04;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ec_query_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): audited entry point for the subscription revoke, same wrapper shape as acpi_evt_cap_revoke. principal is the slot itself: unlike a mint there is no separate authorising parent, and recording the slot twice is more honest than inventing an authority the operation did not consult. Emission covers every exit including the idempotent ALREADY -- an attempt to revoke nothing is still an attempt worth seeing, and on this kind it is the shape a double-teardown takes. Three pushes (r12, r13, r14) for the odd-count call alignment; r14 carries the inner outcome across drv_audit_emit so the wrapper is return-value transparent. Labels prefixed ecq_rw2_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call ec_query_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x156;                  // KIND_EC_QUERY
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_ec_query(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler.
  //
  // There is deliberately no "deliver an event" op. Delivery is the
  // router's job (core/acpi/ec_route.pdx) and it copies a record into
  // the shared stream, which a three-register capability invocation
  // cannot express without taking a destination pointer — the aliasing
  // the confinement assertions exist to prevent. The capability's job
  // here is to answer questions about itself, and to narrow its own
  // filter.
  // ==========================================================================

  pub let cap_handler_ec_query : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M1-002 (#1090): KIND_EC_QUERY dispatch handler. Emits cap_ec_query_msg on entry (all three argument registers are parked in callee-save registers first, because klog_s1 clobbers them per klog/wrappers.pdx sec 5.1). row_id = target_ptr[15:0]; op = op_arg[7:0]; the query byte ops additionally read op_arg[15:8]. Ops 0,1,2,5 (QUERY_ADDR / ENDPOINT / DELIVERED / REGION) require RIGHT_OBSERVE (0x400) -- they read the row's own metadata. Op 3 (QUERY_WANTS) requires RIGHT_INVOKE (0x008) rather than OBSERVE, because it interrogates the ROUTING FILTER rather than the row's identity, and a monitor entitled only to see which controller a subscription names must not thereby learn which events the holder is watching for -- that is a statement about the holder's behaviour, not about the capability. Op 4 (UNSUBSCRIBE) requires RIGHT_WRITE (0x002): it mutates the row, and a holder that may only observe must not be able to silence a subscription somebody else depends on. Splitting the gate per op rather than once at entry is what keeps those three authority classes separable. Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Every metadata query returns EC_QUERY_DECODE_BAD for a dead row, which is the decoders' contract and never a plausible zero. Five pushes (rbx, r12, r13, r14, r15): four of them hold rights, row_id, op and the query byte across the klog call, and the fifth is what makes the count odd -- entry rsp%16 == 8, five pushes take it to 0, which is what SysV requires at klog_s1 and at every row accessor called below. Labels prefixed ecq_h_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;
        and r14, 0xFF;                   // op
        mov r15, rdx;
        shr r15, 8;
        and r15, 0xFF;                   // query byte

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_ec_query_msg];
        call klog_s1;

        mov r11, 5;                      // EC_QUERY_OP_MAX
        cmp r14, r11;
        ja  ecq_h_unsup;

        cmp r14, 3;
        je  ecq_h_wants;
        cmp r14, 4;
        je  ecq_h_unsub;

        // Ops 0, 1, 2, 5: row metadata, RIGHT_OBSERVE.
        mov rax, r12;
        mov r10, 0x400;
        and rax, r10;
        cmp rax, 0;
        je  ecq_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  ecq_h_addr;
        cmp r14, 1;
        je  ecq_h_ep;
        cmp r14, 2;
        je  ecq_h_deliv;

        call ec_query_row_region_row;
        jmp ecq_h_out;

      ecq_h_addr:
        call ec_query_row_addr;
        jmp ecq_h_out;
      ecq_h_ep:
        call ec_query_row_endpoint;
        jmp ecq_h_out;
      ecq_h_deliv:
        call ec_query_row_delivered;
        jmp ecq_h_out;

      ecq_h_wants:
        // Op 3: the routing filter, RIGHT_INVOKE.
        mov rax, r12;
        mov r10, 0x008;
        and rax, r10;
        cmp rax, 0;
        je  ecq_h_denied;
        mov rdi, r13;
        mov rsi, r15;
        call ec_query_row_wants;
        jmp ecq_h_out;

      ecq_h_unsub:
        // Op 4: narrow the filter, RIGHT_WRITE.
        mov rax, r12;
        mov r10, 0x002;
        and rax, r10;
        cmp rax, 0;
        je  ecq_h_denied;
        mov rdi, r13;
        mov rsi, r15;
        call ec_query_row_narrow;
        jmp ecq_h_out;

      ecq_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp ecq_h_out;
      ecq_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      ecq_h_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
