  // ==========================================================================
  // nvme_ctrl_row_force_minted(row_id) -> ()
  //
  // R51.M4-006 (#1656): CFS-recovery escalation (cap/nvme_recovery.pdx,
  // design/hardware/nvme-oncs-reliability.md §5.6) needs to force a live
  // row's state byte back to NVMEC_STATE_MINTED (1) -- both to satisfy
  // nvme_ctrl_bring_up's own MINTED-only precondition when automatically
  // re-running the M1 bring-up chain after a successful soft reset, and
  // per design §5.6's NSSR-path contract ("Reset the controller row to
  // state = MINTED, undoing everything past M1 bring-up"). This
  // deliberately bypasses nvme_ctrl_row_state_set's forward-only
  // monotonic gate (new_state must equal current+1) -- state regression
  // is exactly what a controller-level reset requires, and exactly what
  // that gate exists to prevent for ordinary bring-up callers.
  //
  // This export exists (rather than cap/nvme_recovery.pdx writing the
  // row directly) because _nvme_controller_table is confined to this
  // file's own object (tools/build.sh ec_confine_one, R51.M1-001
  // #1633's one-writer discipline) -- every row mutation must originate
  // in kind_nvme_controller.o; this function is the sanctioned door for
  // the CFS-recovery caller. in_use (bits[63:56]) and ctrl_idx
  // (bits[7:0]) are preserved; a dead/bad row is a no-op.
  // ==========================================================================
  pub let nvme_ctrl_row_force_minted : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M4-006 (#1656): force a controller row's state byte (bits [15:8]) back to NVMEC_STATE_MINTED (1), bypassing nvme_ctrl_row_state_set's forward-only monotonic gate. Exists so cap/nvme_recovery.pdx's CFS-recovery path never has to reference _nvme_controller_table directly (that symbol is confined to this file's object per tools/build.sh's ec_confine_one, R51.M1-001 #1633). One callee-save push (r12=row_id) leaves rsp%16==0 for the nested nvme_ctrl_tail_valid call. Mask bits[15:8] to 0, OR in 1<<8; in_use/ctrl_idx untouched. Dead row is a no-op. Labels prefixed nvmec_rfm_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je nvmec_rfm_out;

        lea r10, [rip + _nvme_controller_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        mov r11, 0xFFFFFFFFFFFF00FF;
        and rax, r11;
        mov r11, 1;                      // NVMEC_STATE_MINTED
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;

      nvmec_rfm_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_row_mark_unhealthy(row_id) -> ()
  //
  // R51.M4-006 (#1656): design §5.6's "CAP.NSSRS clear" (NSSR not
  // supported) case leaves a controller row at NEGOTIATED but stamps a
  // bit in the row's reserved word (+56, bit 32) so a future consumer
  // can tell this row survived a CFS event with no hardware-level
  // recovery path available. No current call site consults this bit --
  // a follow-up ticket would need to wire it into whichever dispatch/
  // submit path should refuse with STATE_BAD; it is stamped now so the
  // information is not lost. Same confinement rationale as
  // nvme_ctrl_row_force_minted above: this export is the sanctioned
  // door for a direct _nvme_controller_table row rewrite from outside
  // this file.
  // ==========================================================================
  pub let nvme_ctrl_row_mark_unhealthy : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M4-006 (#1656): stamp the 'unhealthy' bit (bit 32) into a controller row's reserved word (+56), for cap/nvme_recovery.pdx's CFS-recovery NSSR-not-supported path. Row +56 is zeroed at mint (nvme_ctrl_tail_alloc) and otherwise never written by any existing module, so an OR (rather than an unconditional store) is defensive against a future second reserved-bit use of the same word. One callee-save push (r12=row_id) leaves rsp%16==0 for the nested nvme_ctrl_tail_valid call. Labels prefixed nvmec_rmu_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je nvmec_rmu_out;

        lea r10, [rip + _nvme_controller_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 56];
        mov r11, 1;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 56], rax;

      nvmec_rmu_out:
        pop r12;
        ret
      }
    }

  // Slot -> row_id, gated on the descriptor being a live
  // KIND_NVME_CONTROLLER.  Kind constant 0x198 staged in r11 (fits
  // imm32; no r11-imm64 issue).
  pub let nvme_ctrl_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M1-001 (#1633): slot -> row_id gated on KIND_NVME_CONTROLLER. Labels prefixed nvmec_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae nvmec_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x198;                  // KIND_NVME_CONTROLLER
        cmp r10, r11;
        jne nvmec_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_ros_none;

        mov rax, r12;
        jmp nvmec_ros_out;

      nvmec_ros_none:
        mov rax, 0xFF;                   // NVMEC_ROW_NONE
      nvmec_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_cap_revoke(row_id) -> u64
  //
  // R51.M1-006 (#1638): Controller-cap revoke.  Scrubs the row and
  // bumps REVOKES; distinguishes never-existed (BAD_SLOT) from
  // already-gone (REVOKE_ALREADY).
  //
  // REVOKE CASCADE POSTURE.  Per design/hardware/nvme-and-disk-
  // substrate.md §7 M1-006, revoking a controller must tear down every
  // downstream KIND_NVME_NAMESPACE row + every KIND_BLKDEV row citing
  // this controller.  The cascade primitive lives here as the ONLY
  // path that scrubs a controller row, so a child-revoke sweep can be
  // added without changing callers.  At M1 close, no KIND_NVME_NAMESPACE
  // rows exist (M2 lands #1639+); the cascade is a no-op sweep whose
  // structural shape mirrors i2c_bus_revoke's slave cascade, and M2
  // widens it to walk _nvme_namespace_table.
  // ==========================================================================
  pub let nvme_ctrl_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M1-001 (#1633) + R51.M1-006 (#1638) + R51.M2-005 (#1643): scrub row + bump REVOKES; distinguishes never-existed (BAD_SLOT) from already-gone (REVOKE_ALREADY). At R51.M2-005 the cascade to KIND_NVME_NAMESPACE rows (via nvme_ns_cascade_revoke_by_ctrl) is wired; that helper's own cascade to KIND_BLKDEV brings the effects/capabilities up to {mem, sysreg} @{cap}, matching the audited revoke chain shape (hw_int_cap_revoke calls msix_cascade_revoke_by_parent, same widening). Two callee-save pushes leave rsp%16 == 0. Labels prefixed nvmec_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 8;
        jae nvmec_cr_bad_slot;

        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_cr_already;

        // R51.M2-005 (#1643): cascade to every KIND_NVME_NAMESPACE row
        // whose parent_ctrl_row names THIS controller row.  Runs BEFORE
        // tail_free so the namespace cascade can still read our row_id
        // from the descriptor(s) that reference it (though the cascade
        // only walks _nvme_namespace_table, so the ordering is defensive
        // rather than load-bearing).  Each namespace revoke itself
        // cascades to the dual-kind KIND_BLKDEV children.
        mov rdi, r12;
        call nvme_ns_cascade_revoke_by_ctrl;

        mov rdi, r12;
        call nvme_ctrl_tail_free;
        mov rdi, 1;                      // NVMEC_ST_REVOKES
        call nvme_ctrl_note;
        xor rax, rax;
        jmp nvmec_cr_out;

      nvmec_cr_bad_slot:
        mov rax, 0xFFFFEC49;             // NVMEC_BAD_SLOT
        jmp nvmec_cr_out;
      nvmec_cr_already:
        mov rax, 0xFFFFEC47;             // NVMEC_REVOKE_ALREADY

      nvmec_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_cap_mint_inner(parent_slot, rights, ctrl_idx, bar0_pa)
  //   -> row_id | NVMEC_MINT_BAD_*
  //
  // R51.M1-001 (#1633): the KIND_NVME_CONTROLLER mint walker.
  // Gates in order:
  //   (1) parent gate (KIND_PCI_DEV + RIGHT_MINT);
  //   (2) rights subset;
  //   (3) ctrl_idx bound;
  //   (4) hdr_pack (ctrl_idx, state=MINTED);
  //   (5) tail_alloc(hdr, bar0_pa).
  // Five callee-save pushes + sub rsp, 8 = 48 bytes; post-prologue
  // rsp%16 == 0 for every nested call.
  // ==========================================================================
  pub let nvme_ctrl_cap_mint_inner : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (ctrl_idx: u64) (bar0_pa: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M1-001 (#1633): the KIND_NVME_CONTROLLER mint walker. Gate sequence: parent (KIND_PCI_DEV + RIGHT_MINT), rights subset, ctrl_idx bound, hdr_pack (ctrl_idx, state=MINTED), tail_alloc (hdr, bar0_pa). Five callee-save pushes + sub rsp, 8 = 48 bytes: post-prologue rsp%16 == 0 for every nested call. Refusal paths bump NVMEC_ST_REFUSED. Labels prefixed nvmec_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // ctrl_idx
        mov r14, rcx;                    // bar0_pa

        // (1) Parent gate.
        mov rdi, r12;
        call nvme_ctrl_check_parent_pci_dev;
        cmp rax, 0;
        je  nvmec_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call nvme_ctrl_rights_valid;
        cmp rax, 0;
        je  nvmec_mi_bad_rights;

        // (3) ctrl_idx bound.
        mov rdi, rbx;
        call nvme_ctrl_idx_valid;
        cmp rax, 0;
        je  nvmec_mi_bad_idx;

        // (4) Pack header with state = MINTED (1).
        mov rdi, rbx;                    // ctrl_idx
        mov rsi, 1;                      // NVMEC_STATE_MINTED
        call nvme_ctrl_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvmec_mi_bad_idx;

        // (5) tail_alloc (hdr, bar0_pa).
        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // bar0_pa
        call nvme_ctrl_tail_alloc;
        mov r10, 8;                      // NVMEC_MAX
        cmp rax, r10;
        jae nvmec_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // NVMEC_ST_MINTS
        call nvme_ctrl_note;
        pop rax;
        jmp nvmec_mi_out;

      nvmec_mi_alloc_fail:
        jmp nvmec_mi_refused;
      nvmec_mi_bad_parent:
        mov rax, 0xFFFFEC4D;             // NVMEC_MINT_BAD_PARENT
        jmp nvmec_mi_refused;
      nvmec_mi_bad_rights:
        mov rax, 0xFFFFEC4C;             // NVMEC_MINT_BAD_RIGHTS
        jmp nvmec_mi_refused;
      nvmec_mi_bad_idx:
        mov rax, 0xFFFFEC4B;             // NVMEC_MINT_BAD_IDX

      nvmec_mi_refused:
        push rax;
        mov rdi, 3;                      // NVMEC_ST_REFUSED
        call nvme_ctrl_note;
        pop rax;

      nvmec_mi_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_probe_and_mint(parent_slot, rights) -> u64
  //
  // R51.M1-002 (#1634): the PCI probe hook.  Walks the R24 probe
  // results (_nvme_devices, indexed by ctrl_idx) and mints one
  // KIND_NVME_CONTROLLER row per discovered controller.  Reads
  // _nvme_device_count (published by nvme_probe) and, per index,
  // extracts bar0_pa from _nvme_devices[i] @+8.
  //
  // Returns rax = number of rows minted (0..NVMEC_MAX).  A caller-
  // supplied parent_slot must be a KIND_PCI_DEV descriptor with
  // RIGHT_MINT -- the mint gate refuses otherwise.  Under BIOS/-kernel
  // boot (MCFG absent -> _nvme_device_count == 0) the walk drains
  // immediately and returns 0.  This is the SAME dormant-at-boot
  // posture as R24's nvme_probe itself.
  //
  // Six callee-save pushes leave rsp%16 == 0 at every nested call.
  // ==========================================================================
  pub let nvme_ctrl_probe_and_mint : (u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M1-002 (#1634): the PCI probe hook. Iterates i in [0, _nvme_device_count) reading bar0_pa from _nvme_devices[i] + 8 (u64 field per nvme/probe.pdx layout), calling nvme_ctrl_cap_mint_inner(parent_slot, rights, i, bar0_pa) for each. Preserves parent_slot in rbx and rights in r12 across every nested call. r13 = i (loop cursor), r14 = probe count (cached once), r15 = mint success counter, rbp = scratch. Six callee-save pushes = 48 B; entry rsp%16==8 -> post-prologue 56, sub rsp,8 -> 64, %16==0 (aligned). Bumps NVMEC_ST_PROBES once per successful mint. Labels prefixed nvmec_pm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // parent_slot
        mov r12, rsi;                    // rights

        xor r13, r13;                    // i = 0
        mov r14, [rip + _nvme_device_count];
        xor r15, r15;                    // minted count

      nvmec_pm_loop:
        cmp r13, r14;
        jae nvmec_pm_done;

        // Overflow guard: cap at NVMEC_MAX (8).  Should be impossible
        // since NVMEC_MAX == NVME_MAX_DEVS, but the belt-and-braces
        // check catches drift.
        cmp r13, 8;
        jae nvmec_pm_done;

        // rbp = &_nvme_devices[i] = base + (i << 5).
        mov rax, r13;
        shl rax, 5;
        lea rbp, [rip + _nvme_devices];
        add rbp, rax;

        // bar0_pa (u64 @+8) into rcx (4th mint arg).
        mov rcx, [rbp + 8];

        mov rdi, rbx;                    // parent_slot
        mov rsi, r12;                    // rights
        mov rdx, r13;                    // ctrl_idx = i
        // rcx already = bar0_pa
        call nvme_ctrl_cap_mint_inner;

        // Success iff rax < NVMEC_MAX.
        mov r10, 8;
        cmp rax, r10;
        jae nvmec_pm_next;

        add r15, 1;
        mov rdi, 4;                      // NVMEC_ST_PROBES
        call nvme_ctrl_note;

      nvmec_pm_next:
        add r13, 1;
        jmp nvmec_pm_loop;

      nvmec_pm_done:
        mov rax, r15;

        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_bring_up(row_id) -> u64
  //
  // R51.M1-003 (#1635): admin queue allocation + CC.EN bring-up on a
  // MINTED controller.  Calls:
  //   nvme_admin_queue_init(bar0, &_nvme_admin_ctx)  -- programs
  //     DSTRD/sq_pa/cq_pa/cq_phase into the shared boot-line ctx
  //   nvme_reset(bar0)                                -- runs the
  //     disable / AQA / ASQ / ACQ / enable / RDY poll cycle
  // Then stamps admin_ctx_pa = &_nvme_admin_ctx and advances state to
  // ENABLED.
  //
  // AT M1 THE SUBSTRATE USES THE SHARED _nvme_admin_ctx across all
  // controllers.  A second call for a second row would clobber the
  // first controller's ctx; per-row ctx allocation via KIND_DMA_DOMAIN
  // lands at R51.M3 when the I/O queue path is wired.  Since M1 is the
  // controller-cap round and BIOS/-kernel boot yields zero controllers,
  // the shared-ctx posture is safe for the substrate's actual runtime.
  //
  // Returns NVMEC_OK on success, NVMEC_BRINGUP_FAILED on any
  // nvme_reset failure (timeout / CFS), or NVMEC_DECODE_BAD on a bad
  // row_id.
  //
  // Register plan (3-push callee-save):
  //   rbx = row_id, r12 = bar0, r13 = ctx ptr scratch
  //   3 pushes + sub rsp, 8 = 32 B; entry rsp%16==8 -> post-prologue
  //   40, %16==0 (aligned).
  // ==========================================================================
  pub let nvme_ctrl_bring_up : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (row_id: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M1-003 (#1635): admin queue allocation + CC.EN bring-up. Reads bar0_pa from the row, calls nvme_admin_queue_init to populate _nvme_admin_ctx, then nvme_reset to run the CC.EN cycle. On success stamps admin_ctx_pa and advances state MINTED -> ENABLED. Under BIOS/-kernel boot no controller is discovered so this path is dormant; it lands under UEFI/OVMF where a live bar0 exists. Three callee-save pushes + sub rsp,8 = 32 bytes; post-prologue rsp%16 == 0 for every nested call. Labels prefixed nvmec_bu_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                    // row_id

        // Guard row_id valid.
        mov rdi, rbx;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_bu_bad;

        // Guard current state == MINTED.
        mov rdi, rbx;
        call nvme_ctrl_row_state;
        cmp rax, 1;                      // NVMEC_STATE_MINTED
        jne nvmec_bu_trans;

        // Load bar0_pa.
        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r12, rax;                    // r12 = bar0

        // nvme_admin_queue_init(bar0, &_nvme_admin_ctx).
        lea r13, [rip + _nvme_admin_ctx];
        mov rdi, r12;
        mov rsi, r13;
        call nvme_admin_queue_init;

        // nvme_reset(bar0).  On success returns NVME_RESET_OK (0).
        mov rdi, r12;
        call nvme_reset;
        cmp rax, 0;
        jne nvmec_bu_reset_fail;

        // Stamp admin_ctx_pa and _nvme_current_bar0 for the io_queue
        // dispatch path (io_queue.pdx uses the global _nvme_current_bar0
        // to name which controller to ring on).
        lea r13, [rip + _nvme_admin_ctx];
        mov rdi, rbx;
        mov rsi, r13;
        call nvme_ctrl_row_admin_ctx_set;

        lea r10, [rip + _nvme_current_bar0];
        mov [r10], r12;

        // Advance state.
        mov rdi, rbx;
        mov rsi, 2;                      // NVMEC_STATE_ENABLED
        call nvme_ctrl_row_state_set;

        mov rdi, 5;                      // NVMEC_ST_BRINGUPS
        call nvme_ctrl_note;

        xor rax, rax;                    // NVMEC_OK
        jmp nvmec_bu_out;

      nvmec_bu_reset_fail:
        mov rax, 0xFFFFEC46;             // NVMEC_BRINGUP_FAILED
        jmp nvmec_bu_out;
      nvmec_bu_trans:
        mov rax, 0xFFFFEC43;             // NVMEC_BAD_TRANSITION
        jmp nvmec_bu_out;
      nvmec_bu_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // NVMEC_DECODE_BAD

      nvmec_bu_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_identify(row_id) -> u64
  //
  // R51.M1-004 (#1636): IDENTIFY controller (CNS=0x01) round trip.
  // Delegates to nvme_identify_ctrl_submit_and_parse (defined in
  // src/kernel/core/drivers/nvme/identify_ctrl.pdx) which builds the
  // SQE, submits it via nvme_admin_submit_poll, and returns a packed
  // {mdts:u8, oncs:u16, nn:u32} triple (see identify_ctrl.pdx for the
  // pack layout).  On success caches MDTS/ONCS/NN into the row and
  // advances state ENABLED -> IDENTIFIED.
  //
  // Returns NVMEC_OK on success, NVMEC_IDENTIFY_FAILED if the admin
  // command returned non-zero status or timed out, NVMEC_BAD_TRANSITION
  // if the row is not in state ENABLED, NVMEC_DECODE_BAD on a bad row.
  //
  // Register plan (4-push callee-save):
  //   rbx = row_id, r12 = bar0, r13 = packed identify triple
  //   4 pushes = 32 B; post-prologue rsp%16 == 0.
  // ==========================================================================
  pub let nvme_ctrl_identify : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (row_id: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M1-004 (#1636): IDENTIFY(controller) round trip and row cache. Reads bar0/admin_ctx from row; calls nvme_identify_ctrl_submit_and_parse; on success sets mdts (bits [7:0]), oncs (bits [23:8]), nn (bits [55:24]) into the row and advances state to IDENTIFIED. Failure paths return NVMEC_IDENTIFY_FAILED / _BAD_TRANSITION / _DECODE_BAD. Four callee-save pushes leave rsp%16 == 0. Labels prefixed nvmec_id_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;

        mov rdi, rbx;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_id_bad;

        mov rdi, rbx;
        call nvme_ctrl_row_state;
        cmp rax, 2;                      // NVMEC_STATE_ENABLED
        jne nvmec_id_trans;

        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r12, rax;

        // nvme_identify_ctrl_submit_and_parse(bar0) -> packed triple
        // OR NVME_IDCTRL_FAILED (sentinel = 0xFFFFFFFFFFFFFFFF).
        mov rdi, r12;
        call nvme_identify_ctrl_submit_and_parse;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvmec_id_fail;

        mov r13, rax;                    // packed triple

        // Unpack + stash.
        mov r14, r13;
        and r14, 0xFF;                   // mdts
        mov rdi, rbx;
        mov rsi, r14;
        call nvme_ctrl_row_mdts_set;

        mov r14, r13;
        shr r14, 8;
        and r14, 0xFFFF;                 // oncs (16 bits)
        mov rdi, rbx;
        mov rsi, r14;
        call nvme_ctrl_row_oncs_set;

        mov r14, r13;
        shr r14, 24;
        mov r10, 0xFFFFFFFF;
        and r14, r10;                    // nn (32 bits)
        mov rdi, rbx;
        mov rsi, r14;
        call nvme_ctrl_row_nn_set;

        // Advance state ENABLED -> IDENTIFIED.
        mov rdi, rbx;
        mov rsi, 3;                      // NVMEC_STATE_IDENTIFIED
        call nvme_ctrl_row_state_set;

        mov rdi, 6;                      // NVMEC_ST_IDENTIFIES
        call nvme_ctrl_note;

        xor rax, rax;
        jmp nvmec_id_out;

      nvmec_id_fail:
        mov rax, 0xFFFFEC45;             // NVMEC_IDENTIFY_FAILED
        jmp nvmec_id_out;
      nvmec_id_trans:
        mov rax, 0xFFFFEC43;             // NVMEC_BAD_TRANSITION
        jmp nvmec_id_out;
      nvmec_id_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      nvmec_id_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_negotiate_queues(row_id, requested) -> u64
  //
  // R51.M1-005 (#1637): SET_FEATURES(FID=0x07) queue-count
  // negotiation.  Delegates to nvme_set_features_num_queues_submit
  // (defined in src/kernel/core/drivers/nvme/set_features.pdx) which
  // encodes the request into CDW11 as (NCQR << 16) | NSQR (both 0-
  // based; NVMe §5.21.1.7), submits, and returns the completion's
  // CDW0 = (NCQ_alloc << 16) | NSQ_alloc.
  //
  // Caches the min(NSQ_alloc + 1, NCQ_alloc + 1) into num_io_queues
  // and advances state IDENTIFIED -> NEGOTIATED.
  //
  // Returns NVMEC_OK on success, NVMEC_NEGOTIATE_FAILED on submit
  // failure, NVMEC_BAD_TRANSITION if the row is not in state
  // IDENTIFIED, NVMEC_DECODE_BAD on a bad row.
  //
  // Register plan (4-push callee-save):
  //   rbx = row_id, r12 = requested count, r13 = ack triple
  //   4 pushes = 32 B; post-prologue rsp%16 == 0.
  // ==========================================================================
  pub let nvme_ctrl_negotiate_queues : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (row_id: u64) (requested: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R51.M1-005 (#1637): SET_FEATURES(FID=0x07) queue-count negotiation. Reads bar0 from row; calls nvme_set_features_num_queues_submit(bar0, requested) which returns the 32-bit CDW0 with (NCQ_alloc << 16) | NSQ_alloc, or NVME_SET_FEATURES_FAILED (sentinel = 0xFFFFFFFFFFFFFFFF). Takes min(nsq_alloc+1, ncq_alloc+1) as num_io_queues (NVMe §5.21.1.7: 0-based counts). Advances state IDENTIFIED -> NEGOTIATED. Four callee-save pushes leave rsp%16 == 0. Labels prefixed nvmec_nq_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // requested

        mov rdi, rbx;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_nq_bad;

        mov rdi, rbx;
        call nvme_ctrl_row_state;
        cmp rax, 3;                      // NVMEC_STATE_IDENTIFIED
        jne nvmec_nq_trans;

        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r14, rax;                    // bar0

        mov rdi, r14;
        mov rsi, r12;
        call nvme_set_features_num_queues_submit;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvmec_nq_fail;

        mov r13, rax;                    // packed (NCQ<<16)|NSQ, both 0-based

        // nsq_alloc = (r13 & 0xFFFF) + 1
        mov rax, r13;
        and rax, 0xFFFF;
        add rax, 1;
        mov r10, rax;                    // r10 = nsq count

        // ncq_alloc = ((r13 >> 16) & 0xFFFF) + 1
        mov rax, r13;
        shr rax, 16;
        and rax, 0xFFFF;
        add rax, 1;
        mov r11, rax;                    // r11 = ncq count

        // min(r10, r11).
        cmp r10, r11;
        jbe nvmec_nq_take_r10;
        mov r10, r11;
      nvmec_nq_take_r10:

        mov rdi, rbx;
        mov rsi, r10;
        call nvme_ctrl_row_num_io_queues_set;

        mov rdi, rbx;
        mov rsi, 4;                      // NVMEC_STATE_NEGOTIATED
        call nvme_ctrl_row_state_set;

        mov rdi, 7;                      // NVMEC_ST_NEGOTIATES
        call nvme_ctrl_note;

        xor rax, rax;
        jmp nvmec_nq_out;

      nvmec_nq_fail:
        mov rax, 0xFFFFEC44;             // NVMEC_NEGOTIATE_FAILED
        jmp nvmec_nq_out;
      nvmec_nq_trans:
        mov rax, 0xFFFFEC43;
        jmp nvmec_nq_out;
      nvmec_nq_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      nvmec_nq_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_nvme_controller(rights, target_ptr, op_arg) -> u64
  //
  // KIND_NVME_CONTROLLER dispatch.  All ops arity-ONE
  // (op_arg[63:8] REFUSED).  QUERY ops need R_NVMEC_INVOKE (0x008);
  // DEBUG_PRINT needs R_NVMEC_OBSERVE (0x400).
  //
  //   NVMEC_OP_QUERY_BAR0     -> bar0_pa
  //   NVMEC_OP_QUERY_STATE    -> state byte
  //   NVMEC_OP_QUERY_MDTS     -> mdts
  //   NVMEC_OP_QUERY_ONCS     -> oncs
  //   NVMEC_OP_QUERY_NN       -> nn
  //   NVMEC_OP_QUERY_NQS      -> num_io_queues
  //   NVMEC_OP_QUERY_CTRL_IDX -> ctrl_idx
  //   NVMEC_OP_DEBUG_PRINT    -> 0 (observability only)
  //   NVMEC_OP_BRING_UP_IO    -> count of I/O pairs reaching SQ_LIVE (#1646)
  //                              (arity exception: op_arg[15:8] = ncpu;
  //                              requires R_NVMEC_ADMIN | R_NVMEC_MINT_NS;
  //                              precondition: nvme_io_msix_alloc_for_ctrl
  //                              already ran for this row/ncpu -- see
  //                              nvme_io_queues.pdx nvme_io_bring_up_all)
  // ==========================================================================
  pub let cap_handler_nvme_controller : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M1-001 (#1633), extended R51.M3-002 (#1646): KIND_NVME_CONTROLLER dispatch. QUERY ops need R_NVMEC_INVOKE; DEBUG_PRINT needs R_NVMEC_OBSERVE; BRING_UP_IO needs R_NVMEC_ADMIN|R_NVMEC_MINT_NS. Ops 0..7 are arity ONE (op_arg[63:8] refused); op 8 (BRING_UP_IO) is the one exception -- op_arg[15:8] carries ncpu, op_arg[63:16] refused -- because nvme_io_bring_up_all needs a second argument beyond the row_id already carried in target_ptr, and the dispatch ABI (rights, target_ptr, op_arg) has no other slot to carry it. Five callee-save pushes leave rsp%16 == 0. Labels prefixed nvmec_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id (low 16)
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op

        cmp rbp, 8;                      // NVMEC_OP_BRING_UP_IO
        je  nvmec_hn_bringup_chk;

        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne nvmec_hn_res;                // reserved bits set

        cmp rbp, 7;                      // ops 0..7 valid (8 handled above)
        ja  nvmec_hn_unsup;

        cmp rbp, 7;                      // DEBUG_PRINT
        je  nvmec_hn_dbg;

        // Ops 0..6 need R_NVMEC_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  nvmec_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  nvmec_hn_bar0;
        cmp rbp, 1;
        je  nvmec_hn_state;
        cmp rbp, 2;
        je  nvmec_hn_mdts;
        cmp rbp, 3;
        je  nvmec_hn_oncs;
        cmp rbp, 4;
        je  nvmec_hn_nn;
        cmp rbp, 5;
        je  nvmec_hn_nqs;
        // rbp == 6 (CTRL_IDX)
        call nvme_ctrl_row_ctrl_idx;
        jmp nvmec_hn_count;

      nvmec_hn_bar0:
        call nvme_ctrl_row_bar0;
        jmp nvmec_hn_count;
      nvmec_hn_state:
        call nvme_ctrl_row_state;
        jmp nvmec_hn_count;
      nvmec_hn_mdts:
        call nvme_ctrl_row_mdts;
        jmp nvmec_hn_count;
      nvmec_hn_oncs:
        call nvme_ctrl_row_oncs;
        jmp nvmec_hn_count;
      nvmec_hn_nn:
        call nvme_ctrl_row_nn;
        jmp nvmec_hn_count;
      nvmec_hn_nqs:
        call nvme_ctrl_row_num_io_queues;
        jmp nvmec_hn_count;

      nvmec_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  nvmec_hn_denied;
        xor rax, rax;
        jmp nvmec_hn_out;

      nvmec_hn_bringup_chk:
        // NVMEC_OP_BRING_UP_IO: op_arg[15:8] = ncpu; op_arg[63:16] refused.
        mov r10, r14;
        shr r10, 16;
        cmp r10, 0;
        jne nvmec_hn_res;

        mov r10, r12;                    // rights
        and r10, 0x204;                  // R_NVMEC_ADMIN | R_NVMEC_MINT_NS
        mov r11, 0x204;
        cmp r10, r11;
        jne nvmec_hn_denied;

        mov r10, r14;
        shr r10, 8;
        and r10, 0xFF;                   // ncpu
        cmp r10, 0;
        je  nvmec_hn_res;

        mov rdi, r13;                    // ctrl_row_id
        mov rsi, r10;                    // ncpu
        call nvme_io_bring_up_all;

        push rax;
        mov rdi, 5;                      // NVMEC_ST_BRINGUPS
        call nvme_ctrl_note;
        pop rax;
        jmp nvmec_hn_out;

      nvmec_hn_count:
        push rax;
        mov rdi, 2;                      // NVMEC_ST_QUERIES
        call nvme_ctrl_note;
        pop rax;
        jmp nvmec_hn_out;

      nvmec_hn_res:
        mov rax, 0xFFFFEC4E;             // NVMEC_TAIL_BAD_ARG
        jmp nvmec_hn_out;
      nvmec_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp nvmec_hn_out;
      nvmec_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      nvmec_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
