  // -------------------------------------------------------------------
  // Row mutators.  Internal.  Each is bounds-checked; no-op on bad
  // slot.  Kept internal to this module -- the only writers are the
  // bring-up + identify + set_features wrappers below.
  // -------------------------------------------------------------------

  // Advance state field with strict monotonic gate.  Refuses to move
  // backwards or past NVMEC_STATE_MAX.  Returns NVMEC_OK / _BAD_TRANSITION.
  pub let nvme_ctrl_row_state_set : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-003 (#1635): monotonic state advance. tail_valid gate; new_state must be current+1 (linear pipeline MINTED -> ENABLED -> IDENTIFIED -> NEGOTIATED). Two callee-save pushes leave rsp%16 == 0. Labels prefixed nvmec_rss_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_rss_bad;

        // Range check new_state in [2..4] (never re-enter MINTED).
        cmp r13, 2;
        jb  nvmec_rss_no;
        mov r10, 4;                      // NVMEC_STATE_MAX
        cmp r13, r10;
        ja  nvmec_rss_no;

        lea r10, [rip + _nvme_controller_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        mov rcx, rax;
        shr rcx, 8;
        and rcx, 0xFF;                   // current state

        // Enforce new == current + 1.
        mov r11, rcx;
        add r11, 1;
        cmp r13, r11;
        jne nvmec_rss_no;

        // Clear state byte (bits [15:8]) and OR in new_state << 8.
        mov r11, 0xFFFFFFFFFFFF00FF;
        and rax, r11;
        mov r11, r13;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;                    // NVMEC_OK
        jmp nvmec_rss_out;

      nvmec_rss_no:
        mov rax, 0xFFFFEC43;             // NVMEC_BAD_TRANSITION
        jmp nvmec_rss_out;
      nvmec_rss_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // NVMEC_DECODE_BAD

      nvmec_rss_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let nvme_ctrl_row_admin_ctx_set : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (admin_ctx_pa: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-003 (#1635): stamp admin_ctx_pa on a live row. tail_valid gate; no-op on dead slot. Labels prefixed nvmec_rac_s_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_rac_s_out;
        lea r10, [rip + _nvme_controller_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 16], r13;
      nvmec_rac_s_out:
        pop r13;
        pop r12;
        ret
      }
    }

