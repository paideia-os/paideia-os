// src/kernel/core/cap/kind_nvme_controller.pdx -- R51.M1-001 (#1633),
// R51.M1-002 (#1634), R51.M1-003 (#1635), R51.M1-004 (#1636),
// R51.M1-005 (#1637), R51.M1-006 (#1638).
//
// KIND_NVME_CONTROLLER = 0x198, derived over KIND_DEVICE (= 10).
//
// The runtime authority for ONE NVMe controller function: the right to
// program its BAR0 register set, allocate its admin queues, drive the
// CC.EN reset/enable cycle, submit admin commands (IDENTIFY,
// SET_FEATURES, CREATE_IO_*, DELETE_IO_*), and eventually mint the
// per-namespace KIND_NVME_NAMESPACE + KIND_BLKDEV children.  This
// module lands M1 (mint gate + PCI probe wire + admin queue bring-up +
// IDENTIFY + SET_FEATURES + revoke cascade); M2 (#1639+) is the
// per-namespace derivation.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_DEVICE
// =============================================================================
//
// An NVMe controller is a PCI function -- a device, in the R22 sense
// that KIND_PCI_DEV (0x30) authorises reach to.  The parent derivation
// therefore consults `cap_table[parent_slot].kind == KIND_PCI_DEV
// (0x30)` and `rights & RIGHT_MINT (0x200)`, matching the R24 §2.4
// derivation graph in design/hardware/nvme-and-disk-substrate.md.
//
// This kind's own runtime base is KIND_DEVICE (10) because a controller
// cap authorises MMIO + admin-queue programming -- the classic
// device-authority shape used by every other bus-mastering derived
// kind (KIND_AUDIO_CONTROLLER 0x15E, KIND_USB_DEVICE, etc.).  The LAM
// kind-hint on a KIND_NVME_CONTROLLER descriptor reads slot 10.
//
// Splitting controller-authority (this kind) from namespace-authority
// (KIND_NVME_NAMESPACE = 0x199, M2) and block-device-authority
// (KIND_BLKDEV = 0x42, R24 extended in R51) is what makes the R29.M5
// discipline expressible: the driver process that CAN reset the
// controller is not the process that CAN read/write blocks on any one
// namespace.  A mounter receives KIND_BLKDEV without ever holding
// controller reset authority.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words):
//
//   [+0]   header: in_use[63:56] | state[15:8] | ctrl_idx[7:0]
//   [+8]   bar0_pa           (u64)  -- controller BAR0 physical base
//   [+16]  admin_ctx_pa      (u64)  -- ptr to admin queue ctx; 0 pre-bring-up
//   [+24]  mdts              (u64, low 8 bits)   -- IDENTIFY[+77]
//   [+32]  oncs              (u64, low 16 bits)  -- IDENTIFY[+520]
//   [+40]  nn                (u64, low 32 bits)  -- IDENTIFY[+516]
//   [+48]  num_io_queues     (u64)               -- SET_FEATURES(FID=0x07) ack
//   [+56]  reserved          (u64)
//
// State byte values (in header bits [15:8]):
//   NVMEC_STATE_MINTED       = 1   -- cap minted, admin queue not up
//   NVMEC_STATE_ENABLED      = 2   -- CC.EN=1, CSTS.RDY observed
//   NVMEC_STATE_IDENTIFIED   = 3   -- IDENTIFY(controller) parsed into row
//   NVMEC_STATE_NEGOTIATED   = 4   -- SET_FEATURES(FID=0x07) acked
//
// ctrl_idx (bits [7:0]) is the index into _nvme_devices[] (the R24
// probe's record array) so a KIND_NVME_CONTROLLER row can look up its
// original PCI seg/bus/dev/fn + cap_msix_off without recomputing.
//
// Row-addressed capacity: 8 rows x 64 bytes = 512 bytes.  Matches
// BLK_CAP_CTRL_MAX (blkdev_cap.pdx) and NVME_MAX_DEVS (probe.pdx).
// A ninth controller on a single machine exceeds every consumer +
// workstation to date; if hit at R52+ the ceiling widens together with
// _nvme_devices and _nvme_controller_table.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// Per design/hardware/nvme-and-disk-substrate.md §6.2:
//
//   R_NVMEC_MMIO     (0x001) -- BAR0 accessors (nvme_reg_u32/u64)
//   R_NVMEC_RESET    (0x002) -- CC.EN toggle + NSSR
//   R_NVMEC_ADMIN    (0x004) -- admin-queue command submission
//   R_NVMEC_INVOKE   (0x008) -- QUERY ops (row_bar0/state/mdts/nn/oncs/nqs)
//   R_NVMEC_REVOKE   (0x010) -- teardown the row (cascades to children)
//   R_NVMEC_MINT_NS  (0x200) -- mint downstream KIND_NVME_NAMESPACE
//   R_NVMEC_OBSERVE  (0x400) -- debug printer
//   R_NVMEC_ALL      (0x61F)
//
// The MINT_NS right is what enforces "controller cap is not a
// namespace cap" -- an NVMe supervisor process holding
// KIND_NVME_CONTROLLER without R_NVMEC_MINT_NS cannot open namespaces.
// The R51 boot-time policy grants MINT_NS to the supervisor; a
// downstream FS mounter receives only the derived KIND_BLKDEV.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEC40..0xFFFFEC4F
// =============================================================================
//
// Sixteen wide, disjoint from every previous R48b / R30-PREP band:
//   KIND_ELEVATE_CHANNEL   0xFFFFEC00..0xFFFFEC0F
//   KIND_PDXFS_TXN         0xFFFFEC10..0xFFFFEC1F
//   KIND_PDXFS_FILE        0xFFFFEC20..0xFFFFEC2F
//   KIND_TTY               0xFFFFEC30..0xFFFFEC3F
//   KIND_NVME_CONTROLLER   0xFFFFEC40..0xFFFFEC4F   (this file)
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: sized stores via mov_b / mov_w / mov_d for sub-8-byte fields.
//   G4: full-register compares (zero-extend loads via prior xor).
//
// r11 scratch only for imm32-sized constants.  All KIND / rights /
// state constants fit imm32 (< 0x7FFFFFFF).  Labels prefixed
// `nvmec_` / `nvmecw_` per reserved-label discipline.
//
// -----------------------------------------------------------------------------
// R51.M4-006 (#1656) addition: nvme_ctrl_row_force_minted / _mark_unhealthy
// -----------------------------------------------------------------------------
//
// design/hardware/nvme-oncs-reliability.md §5.6's CFS/NSSR recovery
// path (cap/nvme_recovery.pdx) needs to force a row's state byte back
// to NVMEC_STATE_MINTED and to stamp an "unhealthy" bit into the
// reserved word (+56) -- both direct _nvme_controller_table row
// rewrites. Because that table is confined to THIS file's object by
// tools/build.sh's ec_confine_one (R51.M1-001 #1633), those rewrites
// cannot live in nvme_recovery.pdx; these two exports are the
// sanctioned door instead. Added after nvme_ctrl_row_num_io_queues_set;
// labels prefixed `nvmec_rfm_` / `nvmec_rmu_`.

module KindNvmeController = structure {

  pub let KIND_NVME_CONTROLLER      : u64 = 0x198
  pub let KIND_NVME_CONTROLLER_BASE : u64 = 10         // = KIND_DEVICE

  pub let R_NVMEC_MMIO     : u64 = 0x001
  pub let R_NVMEC_RESET    : u64 = 0x002
  pub let R_NVMEC_ADMIN    : u64 = 0x004
  pub let R_NVMEC_INVOKE   : u64 = 0x008
  pub let R_NVMEC_REVOKE   : u64 = 0x010
  pub let R_NVMEC_MINT_NS  : u64 = 0x200
  pub let R_NVMEC_OBSERVE  : u64 = 0x400
  pub let R_NVMEC_ALL      : u64 = 0x61F

  pub let NVMEC_STATE_MINTED     : u64 = 1
  pub let NVMEC_STATE_ENABLED    : u64 = 2
  pub let NVMEC_STATE_IDENTIFIED : u64 = 3
  pub let NVMEC_STATE_NEGOTIATED : u64 = 4
  pub let NVMEC_STATE_MAX        : u64 = 4

  // Ops.  Every op ARITY ONE -- op_arg high bits refused (matches
  // KIND_TTY / KIND_PDXFS_TXN discipline).
  pub let NVMEC_OP_QUERY_BAR0     : u64 = 0
  pub let NVMEC_OP_QUERY_STATE    : u64 = 1
  pub let NVMEC_OP_QUERY_MDTS     : u64 = 2
  pub let NVMEC_OP_QUERY_ONCS     : u64 = 3
  pub let NVMEC_OP_QUERY_NN       : u64 = 4
  pub let NVMEC_OP_QUERY_NQS      : u64 = 5
  pub let NVMEC_OP_QUERY_CTRL_IDX : u64 = 6
  pub let NVMEC_OP_DEBUG_PRINT    : u64 = 7
  // R51.M3-002 (#1646): design/hardware/nvme-io-queues.md §3.6 originally
  // spec'd this op as value 7, colliding with NVMEC_OP_DEBUG_PRINT (already
  // landed at R51.M1). Assigned the next free value (8) instead. Unlike
  // ops 0..7 (arity ONE, op_arg[63:8] refused), this op's op_arg[15:8]
  // carries ncpu (op_arg[63:16] refused) -- see cap_handler_nvme_controller
  // for the encoding.
  pub let NVMEC_OP_BRING_UP_IO    : u64 = 8
  pub let NVMEC_OP_MAX            : u64 = 8

  pub let NVMEC_OK              : u64 = 0
  pub let NVMEC_TAIL_ENOSPC     : u64 = 0xFFFFEC4F
  pub let NVMEC_TAIL_BAD_ARG    : u64 = 0xFFFFEC4E
  pub let NVMEC_MINT_BAD_PARENT : u64 = 0xFFFFEC4D
  pub let NVMEC_MINT_BAD_RIGHTS : u64 = 0xFFFFEC4C
  pub let NVMEC_MINT_BAD_IDX    : u64 = 0xFFFFEC4B
  pub let NVMEC_MINT_BAD_BAR0   : u64 = 0xFFFFEC4A
  pub let NVMEC_BAD_SLOT        : u64 = 0xFFFFEC49
  pub let NVMEC_WRONG_KIND      : u64 = 0xFFFFEC48
  pub let NVMEC_REVOKE_ALREADY  : u64 = 0xFFFFEC47
  pub let NVMEC_BRINGUP_FAILED  : u64 = 0xFFFFEC46
  pub let NVMEC_IDENTIFY_FAILED : u64 = 0xFFFFEC45
  pub let NVMEC_NEGOTIATE_FAILED: u64 = 0xFFFFEC44
  pub let NVMEC_BAD_TRANSITION  : u64 = 0xFFFFEC43
  pub let NVMEC_PROBE_ENOSPC    : u64 = 0xFFFFEC42

  pub let NVMEC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let NVMEC_ROW_NONE   : u64 = 0xFF

  // Ceiling.  Matches BLK_CAP_CTRL_MAX (blkdev_cap.pdx) and
  // NVME_MAX_DEVS (nvme/probe.pdx).
  pub let NVMEC_MAX        : u64 = 8
  pub let NVMEC_ROW_BYTES  : u64 = 64
  // 8 rows * 64 bytes = 512 bytes = 64 u64.
  pub let mut _nvme_controller_table : [u64; 64] = uninit @align(64)
  pub let mut _nvme_controller_stats : [u64; 16] = uninit @align(64)

  pub let NVMEC_ST_MINTS       : u64 = 0
  pub let NVMEC_ST_REVOKES     : u64 = 1
  pub let NVMEC_ST_QUERIES     : u64 = 2
  pub let NVMEC_ST_REFUSED     : u64 = 3
  pub let NVMEC_ST_PROBES      : u64 = 4
  pub let NVMEC_ST_BRINGUPS    : u64 = 5
  pub let NVMEC_ST_IDENTIFIES  : u64 = 6
  pub let NVMEC_ST_NEGOTIATES  : u64 = 7
  pub let NVMEC_ST_MAX         : u64 = 16

  pub let nvmec_dbg_msg : [u8; 15] = "NVME CTRL ROW\0\0"

  // ==========================================================================
  // nvme_ctrl_table_reset() -> ()
  //
  // Clear every row and every counter.  Boot and teardown only.  Two
  // separate loops (rows / stats) mirror kind_tty's shape: the arrays
  // have different lengths and one loop over the total would encode
  // their .bss adjacency as a fact code depends on.
  // ==========================================================================
  pub let nvme_ctrl_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): clear every row and every counter. Boot and teardown only. Labels prefixed nvmec_rs_.",
      block: {
        lea r10, [rip + _nvme_controller_table];
        xor rax, rax;
        xor rcx, rcx;
      nvmec_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  nvmec_rs_rows;

        lea r10, [rip + _nvme_controller_stats];
        xor rcx, rcx;
      nvmec_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  nvmec_rs_stats;
        ret
      }
    }

  pub let nvme_ctrl_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): bounded increment; out-of-range no-op. Labels prefixed nvmec_nt_.",
      block: {
        cmp rdi, 16;
        jae nvmec_nt_out;
        lea r10, [rip + _nvme_controller_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      nvmec_nt_out:
        ret
      }
    }

  pub let nvme_ctrl_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): bounded read; out-of-range returns 0. Labels prefixed nvmec_st_.",
      block: {
        cmp rdi, 16;
        jae nvmec_st_zero;
        lea r10, [rip + _nvme_controller_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      nvmec_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let nvme_ctrl_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M1-001 (#1633): subset test against R_NVMEC_ALL = 0x61F. Labels prefixed nvmec_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x61F;
        and rax, r10;
        cmp rax, rdi;
        jne nvmec_rv_no;
        mov rax, 1;
        ret;
      nvmec_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let nvme_ctrl_idx_valid : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M1-001 (#1633): 1 iff idx < NVMEC_MAX = 8. Matches NVME_MAX_DEVS and BLK_CAP_CTRL_MAX. Labels prefixed nvmec_iv_.",
      block: {
        cmp rdi, 8;
        jae nvmec_iv_no;
        mov rax, 1;
        ret;
      nvmec_iv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // nvme_ctrl_check_parent_pci_dev(parent_slot) -> 1 | 0
  //
  // Derivation gate.  parent.kind == KIND_PCI_DEV (0x30) AND rights
  // carry RIGHT_MINT (0x200).  Per design/hardware/nvme-and-disk-
  // substrate.md §2.4: a driver process holds a KIND_PCI_DEV for the
  // NVMe function; deriving KIND_NVME_CONTROLLER over it is what
  // acquires reset authority for that function.  The kind check
  // discriminates the class of the parent (PCI vs. any other device
  // family) and MINT authorises the derivation.
  // ==========================================================================
  pub let nvme_ctrl_check_parent_pci_dev : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M1-001 (#1633): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_PCI_DEV (0x30) AND (rights & RIGHT_MINT 0x200) != 0. Same shape as kind_battery / kind_thermal_zone (which check kind == 10 KIND_DEVICE) but tighter: an NVMe controller derivation MUST come from a PCI descriptor, not any KIND_DEVICE; a network card cannot mint an NVMe controller cap. Pure read. Labels prefixed nvmec_cpp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae nvmec_cpp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x30;                   // KIND_PCI_DEV
        cmp r10, r11;
        jne nvmec_cpp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  nvmec_cpp_no;

        mov rax, 1;
        ret;

      nvmec_cpp_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | state[15:8] | ctrl_idx[7:0].
  // Callers pack via nvme_ctrl_hdr_pack(ctrl_idx, state).
  pub let nvme_ctrl_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (ctrl_idx: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M1-001 (#1633): canonical header encoder. Validates ctrl_idx in [0..NVMEC_MAX-1] and state in [1..4]. Bits [63:56] MUST leave this function zero (in_use is set by tail_alloc under the same write that claims the row). Labels prefixed nvmec_hp_.",
      block: {
        cmp rdi, 8;                      // NVMEC_MAX
        jae nvmec_hp_bad;
        cmp rsi, 1;
        jb  nvmec_hp_bad;
        mov r10, 4;                      // NVMEC_STATE_MAX
        cmp rsi, r10;
        ja  nvmec_hp_bad;
        mov rax, rdi;                    // ctrl_idx in [7:0]
        mov r11, rsi;
        shl r11, 8;
        or  rax, r11;                    // state in [15:8]
        ret;
      nvmec_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // tail_alloc(hdr, bar0_pa) -> row_id | NVMEC_TAIL_*.
  // Sets admin_ctx_pa / mdts / oncs / nn / num_io_queues / reserved
  // to 0 -- populated by the bring-up + identify + set_features
  // wrappers as they land.
  pub let nvme_ctrl_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (bar0_pa: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): claim one controller row. THE ONLY WRITER of _nvme_controller_table; tools/build.sh confines it via ec_confine_one. Gates: hdr in_use pre-set -> BAD_ARG (pre-set in_use would hand back a row the free scan skips forever); hdr reserved [55:16] non-zero -> BAD_ARG; bar0_pa == 0 -> MINT_BAD_BAR0 (a controller with no MMIO base is not addressable). Low-first scan over 8 rows of 64 bytes.  Four callee-save pushes leave rsp%16 == 0. Labels prefixed nvmec_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // bar0_pa

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne nvmec_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne nvmec_ta_bad;

        // bar0_pa != 0.
        cmp r13, 0;
        je  nvmec_ta_bad_bar0;

        xor rbx, rbx;                    // row_id
      nvmec_ta_scan:
        cmp rbx, 8;                      // NVMEC_MAX
        jae nvmec_ta_enospc;

        lea r10, [rip + _nvme_controller_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  nvmec_ta_claim;

        add rbx, 1;
        jmp nvmec_ta_scan;

      nvmec_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header + in_use
        mov [r10 + 8],  r13;             // bar0_pa
        xor rax, rax;
        mov [r10 + 16], rax;             // admin_ctx_pa = 0
        mov [r10 + 24], rax;             // mdts = 0
        mov [r10 + 32], rax;             // oncs = 0
        mov [r10 + 40], rax;             // nn = 0
        mov [r10 + 48], rax;             // num_io_queues = 0
        mov [r10 + 56], rax;             // reserved = 0
        mov rax, rbx;
        jmp nvmec_ta_out;

      nvmec_ta_enospc:
        mov rax, 0xFFFFEC4F;             // NVMEC_TAIL_ENOSPC
        jmp nvmec_ta_out;
      nvmec_ta_bad_bar0:
        mov rax, 0xFFFFEC4A;             // NVMEC_MINT_BAD_BAR0
        jmp nvmec_ta_out;
      nvmec_ta_bad:
        mov rax, 0xFFFFEC4E;             // NVMEC_TAIL_BAD_ARG

      nvmec_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let nvme_ctrl_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): 1 iff row_id < NVMEC_MAX and in_use byte set. Labels prefixed nvmec_tv_.",
      block: {
        cmp rdi, 8;
        jae nvmec_tv_no;
        lea r10, [rip + _nvme_controller_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  nvmec_tv_no;
        mov rax, 1;
        ret;
      nvmec_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let nvme_ctrl_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): scrub row (all eight words). Labels prefixed nvmec_tf_.",
      block: {
        cmp rdi, 8;
        jae nvmec_tf_out;
        lea r10, [rip + _nvme_controller_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      nvmec_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors.  Each returns NVMEC_DECODE_BAD when the row is not
  // live.  Shape mirrors pdxfs_txn_row_* / tty_row_* one-for-one so a
  // regression in one member of the family surfaces the same way in
  // the others.
  // -------------------------------------------------------------------

  pub let nvme_ctrl_row_bar0 : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): bar0_pa, or NVMEC_DECODE_BAD. Labels prefixed nvmec_rb_.",
      block: {
        push r12;
        mov r12, rdi;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_rb_bad;
        lea r10, [rip + _nvme_controller_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp nvmec_rb_out;
      nvmec_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      nvmec_rb_out:
        pop r12;
        ret
      }
    }

  pub let nvme_ctrl_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M1-001 (#1633): state byte, or NVMEC_DECODE_BAD. Labels prefixed nvmec_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call nvme_ctrl_tail_valid;
        cmp rax, 0;
        je  nvmec_rst_bad;
        lea r10, [rip + _nvme_controller_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp nvmec_rst_out;
      nvmec_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      nvmec_rst_out:
        pop r12;
        ret
      }
    }

