// src/kernel/core/cap/kind_display_plane.pdx — R36.M4-001 (#1249)
//
// KIND_DISPLAY_PLANE = 0x173, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// One display plane: the plane's identifying key, the KIND_MEMORY slot
// whose byte range holds the pixel buffer this plane will scan out of,
// the plane class (primary / overlay / cursor), a z-order for compositor
// ordering, a pixel format (fourcc-lite), and the plane's width and
// height in pixels.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A KIND_DISPLAY_OUTPUT names WHICH panel; a KIND_DISPLAY_MODE names
// WHAT TIMING will be programmed; and a KIND_DISPLAY_PLANE names WHICH
// PIXELS scan onto that panel at that timing. Naming the plane as a
// capability -- rather than as arguments to the atomic commit -- prevents
// three things that would otherwise be expressible: (1) a caller writing
// a plane bank whose scan-out buffer belongs to another process ("plane
// address forging"); (2) a caller stamping a plane at a z-order the
// compositor has already granted to another plane ("z-order aliasing");
// (3) a caller re-parenting a plane between the modeset transaction's
// SET_PLANE and COMMIT phases ("plane bait-and-switch").
//
// The KIND_MEMORY parent is the record of the byte range those pixels
// are scanned out of. The kernel never trusts a ring-3 plane blob
// directly; it trusts the KIND_MEMORY holder that had authority over
// those bytes.
//
// =============================================================================
// §1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The gate demands `kind == KIND_MEMORY (4)` carrying RIGHT_MINT. A
// mint additionally requires:
//
//   (a) plane_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) memory_slot names a live KIND_MEMORY (4) with RIGHT_MINT
//       (NO_MEMORY); the slot is stashed on the row so a later
//       revocation of the memory chases every plane row that scans out
//       of it (cascade landed in a later round; the field is recorded
//       here so the cascade has something to walk)
//   (c) plane_type in {DPP_TYPE_PRIMARY, DPP_TYPE_OVERLAY,
//       DPP_TYPE_CURSOR} (BAD_TYPE); the closed three-enum matches the
//       Xe1 plane taxonomy per bspec §14
//   (d) zorder in [0, 255] (BAD_ZORDER); the driver-side gate refines
//       per plane class (primary always 0, overlay 1..15, cursor
//       driver-managed) -- the kind holds the field but does not
//       enforce the class-specific rule, so the compositor can still
//       reason about a plane's z-order before the driver has been
//       consulted
//   (e) format in {XRGB8888, NV12, YUYV, RGBA8888, P010} (BAD_FORMAT);
//       fourcc-lite ordinals rather than the four-byte fourcc so the
//       field fits u16 and per-class format restrictions belong to the
//       driver, not this kind
//   (f) width in (0, u16 max] and height in (0, u16 max] (BAD_DIM);
//       zero refused as a bring-up bug rather than a legal empty
//       plane
//   (g) rights subset of R_DISPLAY_PLANE_ALL
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  plane_key (u64)
//   [+16] body1:   memory_slot[31:0] | plane_type[39:32]
//                | zorder[47:40] | format[63:48]
//   [+24] body2:   width[15:0] | height[31:16]
//
// =============================================================================
// §3  LEAF OF THE PLANE LATTICE
// =============================================================================
//
// R_DISPLAY_PLANE_MINT (0x200) is DELIBERATELY ABSENT from
// R_DISPLAY_PLANE_ALL: no cap in this tree derives from a
// KIND_DISPLAY_PLANE. The three driver modules (plane_primary,
// plane_overlay, plane_cursor) consume the row through row accessors
// rather than by minting children.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF6E0..0xFFFFF6EF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: mode_enum
// 0xFFFFF6F0..FF; adjacent free bands below: plane_primary
// 0xFFFFF6D0..DF).

module KindDisplayPlane = structure {

  pub let KIND_DISPLAY_PLANE        : u64 = 0x173
  pub let DISPLAY_PLANE_PARENT_KIND : u64 = 4           // = KIND_MEMORY

  // Plane classes (§1c).
  pub let DPP_TYPE_PRIMARY : u64 = 0
  pub let DPP_TYPE_OVERLAY : u64 = 1
  pub let DPP_TYPE_CURSOR  : u64 = 2
  pub let DPP_TYPE_MAX     : u64 = 2

  // Format ordinals (§1e). Ordering matches the plane driver modules'
  // acceptance sets: primary admits 0/3, overlay admits 1/2/4, cursor
  // admits 3 only. The kind does not enforce the class-specific
  // subset; the driver modules do.
  pub let DPP_FORMAT_XRGB8888 : u64 = 0
  pub let DPP_FORMAT_NV12     : u64 = 1
  pub let DPP_FORMAT_YUYV     : u64 = 2
  pub let DPP_FORMAT_RGBA8888 : u64 = 3
  pub let DPP_FORMAT_P010     : u64 = 4
  pub let DPP_FORMAT_MAX      : u64 = 4

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_DISPLAY_PLANE_READ    : u64 = 0x001
  pub let R_DISPLAY_PLANE_INVOKE  : u64 = 0x008
  pub let R_DISPLAY_PLANE_REVOKE  : u64 = 0x010
  pub let R_DISPLAY_PLANE_OBSERVE : u64 = 0x400
  pub let R_DISPLAY_PLANE_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let DPP_OP_QUERY_KEY    : u64 = 0
  pub let DPP_OP_QUERY_MEMORY : u64 = 1
  pub let DPP_OP_QUERY_TYPE   : u64 = 2
  pub let DPP_OP_QUERY_ZORDER : u64 = 3
  pub let DPP_OP_QUERY_FORMAT : u64 = 4
  pub let DPP_OP_QUERY_W      : u64 = 5
  pub let DPP_OP_QUERY_H      : u64 = 6
  pub let DPP_OP_DEBUG_PRINT  : u64 = 7
  pub let DPP_OP_MAX          : u64 = 7

  // Failure taxonomy — 0xFFFFF6E0..0xFFFFF6EF.
  pub let DPP_OK              : u64 = 0
  pub let DPP_TAIL_ENOSPC     : u64 = 0xFFFFF6EF
  pub let DPP_TAIL_BAD_ARG    : u64 = 0xFFFFF6EE
  pub let DPP_MINT_BAD_PARENT : u64 = 0xFFFFF6ED
  pub let DPP_MINT_BAD_RIGHTS : u64 = 0xFFFFF6EC
  pub let DPP_MINT_BAD_TYPE   : u64 = 0xFFFFF6EB
  pub let DPP_MINT_BAD_ZORDER : u64 = 0xFFFFF6EA
  pub let DPP_MINT_BAD_FORMAT : u64 = 0xFFFFF6E9
  pub let DPP_MINT_BAD_DIM    : u64 = 0xFFFFF6E8
  pub let DPP_MINT_NO_MEMORY  : u64 = 0xFFFFF6E7
  pub let DPP_MINT_NO_KEY     : u64 = 0xFFFFF6E6
  pub let DPP_MINT_ENOSPC     : u64 = 0xFFFFF6E5
  pub let DPP_MINT_IN_USE     : u64 = 0xFFFFF6E4
  pub let DPP_BAD_SLOT        : u64 = 0xFFFFF6E3
  pub let DPP_WRONG_KIND      : u64 = 0xFFFFF6E2
  pub let DPP_REVOKE_ALREADY  : u64 = 0xFFFFF6E1

  pub let DPP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPP_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride — total 512 bytes as [u64; 64]. Sixteen is
  // enough for the Xe1 concurrent-plane budget (3 pipes * up to 5
  // planes each = 15 with headroom).
  pub let DPP_MAX       : u64 = 16
  pub let DPP_ROW_BYTES : u64 = 32

  pub let mut _display_plane_table : [u64; 64] = uninit @align(64)
  pub let mut _display_plane_stats : [u64; 4]  = uninit @align(64)

  pub let DPP_ST_MINTS   : u64 = 0
  pub let DPP_ST_REVOKES : u64 = 1
  pub let DPP_ST_IN_USE  : u64 = 2
  pub let DPP_ST_REFUSED : u64 = 3

  pub let dpp_dbg_msg : [u8; 17] = "DISPLAY PLANE ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let display_plane_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): clear the DISPLAY PLANE row table and its counters. Boot and teardown only. Labels prefixed dpp_rs_.",
      block: {
        lea r10, [rip + _display_plane_table];
        xor rax, rax;
        xor rcx, rcx;
      dpp_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  dpp_rs_rows;

        lea r10, [rip + _display_plane_stats];
        xor rcx, rcx;
      dpp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dpp_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpp_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): 1 iff t <= DPP_TYPE_MAX (2). Labels prefixed dpp_tv_.",
      block: {
        cmp rdi, 2;
        ja  dpp_tv_no;
        mov rax, 1;
        ret;
      dpp_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpp_zorder_valid : (u64) -> u64 !{} @{} =
    fn (z: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): 1 iff z <= 0xFF. Labels prefixed dpp_zv_.",
      block: {
        cmp rdi, 0xFF;
        ja  dpp_zv_no;
        mov rax, 1;
        ret;
      dpp_zv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpp_format_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): 1 iff f <= DPP_FORMAT_MAX (4). Labels prefixed dpp_fv_.",
      block: {
        cmp rdi, 4;
        ja  dpp_fv_no;
        mov rax, 1;
        ret;
      dpp_fv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpp_dim_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): 1 iff 0 < d <= 0xFFFF. Labels prefixed dpp_dv_.",
      block: {
        cmp rdi, 0;
        je  dpp_dv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpp_dv_no;
        mov rax, 1;
        ret;
      dpp_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpp_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): subset test against R_DISPLAY_PLANE_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask -- leaf (§3). Labels prefixed dpp_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne dpp_rgv_no;
        mov rax, 1;
        ret;
      dpp_rgv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let dpp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): counter bump. Labels prefixed dpp_nt_.",
      block: {
        cmp rdi, 4;
        jae dpp_nt_out;
        lea r10, [rip + _display_plane_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpp_nt_out:
        ret
      }
    } @no_frame

  pub let dpp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): counter read. Labels prefixed dpp_st_.",
      block: {
        cmp rdi, 4;
        jae dpp_st_zero;
        lea r10, [rip + _display_plane_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpp_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: parent must be live KIND_MEMORY (4) with RIGHT_MINT.
  // ==========================================================================

  pub let dpp_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): §1 gate. parent must be live KIND_MEMORY (4) with RIGHT_MINT. Labels prefixed dpp_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpp_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne dpp_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  dpp_cp_no;

        mov rax, 1;
        ret;
      dpp_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let dpp_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): (parent_slot << 8). Labels prefixed dpp_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae dpp_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      dpp_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let dpp_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (memory_slot: u64) (plane_type: u64) (zorder: u64) (format: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): pack memory_slot[31:0] | plane_type[39:32] | zorder[47:40] | format[63:48]. Refuses out-of-range fields. Labels prefixed dpp_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dpp_b1_bad;
        cmp rsi, 0xFF;
        ja  dpp_b1_bad;
        cmp rdx, 0xFF;
        ja  dpp_b1_bad;
        mov r10, 0xFFFF;
        cmp rcx, r10;
        ja  dpp_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      dpp_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let dpp_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (width: u64) (height: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-001 (#1249): pack width[15:0] | height[31:16]. Refuses out-of-range fields. Labels prefixed dpp_b2_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpp_b2_bad;
        cmp rsi, r10;
        ja  dpp_b2_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      dpp_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc / valid / free — THE ONE WRITER of _display_plane_table.
  // ==========================================================================

  pub let dpp_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (plane_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): claim one DISPLAY PLANE row. THE ONE WRITER of _display_plane_table. Gates: hdr in_use pre-set -> BAD_ARG; plane_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 16 rows of 32 bytes. Labels prefixed dpp_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne dpp_ta_bad;

        cmp r13, 0;
        je  dpp_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  dpp_ta_bad;
        cmp r15, r10;
        je  dpp_ta_bad;

        xor rbx, rbx;
      dpp_ta_scan:
        cmp rbx, 16;
        jae dpp_ta_enospc;

        lea r10, [rip + _display_plane_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpp_ta_claim;

        add rbx, 1;
        jmp dpp_ta_scan;

      dpp_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp dpp_ta_out;

      dpp_ta_enospc:
        mov rax, 0xFFFFF6EF;
        jmp dpp_ta_out;
      dpp_ta_bad:
        mov rax, 0xFFFFF6EE;

      dpp_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dpp_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): 1 iff row_id < MAX and in_use. Labels prefixed dpp_tvr_.",
      block: {
        cmp rdi, 16;
        jae dpp_tvr_no;
        lea r10, [rip + _display_plane_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpp_tvr_no;
        mov rax, 1;
        ret;
      dpp_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpp_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): scrub one row. Labels prefixed dpp_tf_.",
      block: {
        cmp rdi, 16;
        jae dpp_tf_out;
        lea r10, [rip + _display_plane_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      dpp_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let dpp_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): plane_key. Labels prefixed dpp_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rk_bad;
        lea r10, [rip + _display_plane_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp dpp_rk_out;
      dpp_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpp_rk_out:
        pop r12;
        ret
      }
    }

  pub let dpp_row_memory : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): memory_slot. Labels prefixed dpp_rmem_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rmem_bad;
        lea r10, [rip + _display_plane_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp dpp_rmem_out;
      dpp_rmem_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpp_rmem_out:
        pop r12;
        ret
      }
    }

  pub let dpp_row_type : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): plane_type. Labels prefixed dpp_rty_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rty_bad;
        lea r10, [rip + _display_plane_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFF;
        jmp dpp_rty_out;
      dpp_rty_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpp_rty_out:
        pop r12;
        ret
      }
    }

  pub let dpp_row_zorder : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): zorder. Labels prefixed dpp_rz_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rz_bad;
        lea r10, [rip + _display_plane_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 40;
        and rax, 0xFF;
        jmp dpp_rz_out;
      dpp_rz_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpp_rz_out:
        pop r12;
        ret
      }
    }

  pub let dpp_row_format : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): format. Labels prefixed dpp_rf_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rf_bad;
        lea r10, [rip + _display_plane_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFFFF;
        jmp dpp_rf_out;
      dpp_rf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpp_rf_out:
        pop r12;
        ret
      }
    }

  pub let dpp_row_width : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): width. Labels prefixed dpp_rw_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rw_bad;
        lea r10, [rip + _display_plane_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFF;
        jmp dpp_rw_out;
      dpp_rw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpp_rw_out:
        pop r12;
        ret
      }
    }

  pub let dpp_row_height : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): height. Labels prefixed dpp_rh_.",
      block: {
        push r12;
        mov r12, rdi;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rh_bad;
        lea r10, [rip + _display_plane_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp dpp_rh_out;
      dpp_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpp_rh_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let dpp_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (plane_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-001 (#1249): live row holding this plane_key, or ROW_NONE. Refuses to match 0. Labels prefixed dpp_fk_.",
      block: {
        cmp rdi, 0;
        je  dpp_fk_none;
        xor rcx, rcx;
      dpp_fk_scan:
        cmp rcx, 16;
        jae dpp_fk_none;
        lea r10, [rip + _display_plane_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpp_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  dpp_fk_hit;
      dpp_fk_next:
        add rcx, 1;
        jmp dpp_fk_scan;
      dpp_fk_hit:
        mov rax, rcx;
        ret;
      dpp_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let dpp_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): slot -> row_id, gated on live KIND_DISPLAY_PLANE. Labels prefixed dpp_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae dpp_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x173;
        cmp r10, r11;
        jne dpp_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_ros_none;

        mov rax, r12;
        jmp dpp_ros_out;

      dpp_ros_none:
        mov rax, 0xFF;
      dpp_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Seven args (slot, parent_slot, rights, plane_key, memory_slot,
  // packed_class, packed_dim).
  //
  //   packed_class encoding:
  //     [7:0]   plane_type
  //     [15:8]  zorder
  //     [31:16] format
  //   packed_dim encoding:
  //     [15:0]  width
  //     [31:16] height
  //
  // (Six SysV args plus the seventh through r9 which paideia-as still
  // accepts.  We use the two-packed convention to keep the mint under
  // the register-pass ceiling elsewhere in this tree.)
  // ==========================================================================

  pub let display_plane_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (plane_key: u64) (memory_slot: u64) (packed_all: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): mint KIND_DISPLAY_PLANE over KIND_MEMORY. Six args; packed_all encoding: [7:0] plane_type | [15:8] zorder | [31:16] format | [47:32] width | [63:48] height. The single packed argument keeps the ABI within the paideia-as SysV pass ceiling used elsewhere in this tree. Labels prefixed dpp_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // plane_key
        mov r15, r8;                     // memory_slot
        mov rbp, r9;                     // packed_all

        mov r10, 256;
        cmp rbx, r10;
        jae dpp_mi_bad_slot;

        mov rdi, r12;
        call dpp_check_parent;
        cmp rax, 0;
        je  dpp_mi_bad_parent;

        mov rdi, r13;
        call dpp_rights_valid;
        cmp rax, 0;
        je  dpp_mi_bad_rights;

        // Unpack + validate plane_type.
        mov rdi, rbp;
        and rdi, 0xFF;
        call dpp_type_valid;
        cmp rax, 0;
        je  dpp_mi_bad_type;

        // Unpack + validate zorder.
        mov rdi, rbp;
        shr rdi, 8;
        and rdi, 0xFF;
        call dpp_zorder_valid;
        cmp rax, 0;
        je  dpp_mi_bad_zorder;

        // Unpack + validate format.
        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFFFF;
        call dpp_format_valid;
        cmp rax, 0;
        je  dpp_mi_bad_format;

        // Unpack + validate width.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFF;
        call dpp_dim_valid;
        cmp rax, 0;
        je  dpp_mi_bad_dim;

        // Unpack + validate height.
        mov rdi, rbp;
        shr rdi, 48;
        and rdi, 0xFFFF;
        call dpp_dim_valid;
        cmp rax, 0;
        je  dpp_mi_bad_dim;

        cmp r14, 0;
        je  dpp_mi_no_key;

        mov rdi, r14;
        call dpp_find_by_key;
        cmp rax, 0xFF;
        jne dpp_mi_in_use;

        // Body1 pack: (memory_slot, plane_type, zorder, format).
        mov rdi, r15;
        mov rsi, rbp;
        and rsi, 0xFF;                   // plane_type
        mov rdx, rbp;
        shr rdx, 8;
        and rdx, 0xFF;                   // zorder
        mov rcx, rbp;
        shr rcx, 16;
        and rcx, 0xFFFF;                 // format
        call dpp_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpp_mi_bad_format;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack: (width, height).
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFF;                 // width
        mov rsi, rbp;
        shr rsi, 48;
        and rsi, 0xFFFF;                 // height
        call dpp_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpp_mi_bad_dim;
        mov r15, rax;                    // body2
        push r11;
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call dpp_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpp_mi_bad_parent;

        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call dpp_tail_alloc;

        mov r10, 0xFFFFF6EF;
        cmp rax, r10;
        je  dpp_mi_enospc;
        mov r10, 0xFFFFF6EE;
        cmp rax, r10;
        je  dpp_mi_bad_format;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x173;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call dpp_note;

        xor rax, rax;
        jmp dpp_mi_out;

      dpp_mi_bad_slot:
        mov rax, 0xFFFFF6E3;
        jmp dpp_mi_out;
      dpp_mi_bad_parent:
        mov rax, 0xFFFFF6ED;
        jmp dpp_mi_out;
      dpp_mi_bad_rights:
        mov rax, 0xFFFFF6EC;
        jmp dpp_mi_out;
      dpp_mi_bad_type:
        mov rax, 0xFFFFF6EB;
        jmp dpp_mi_out;
      dpp_mi_bad_zorder:
        mov rax, 0xFFFFF6EA;
        jmp dpp_mi_out;
      dpp_mi_bad_format:
        mov rax, 0xFFFFF6E9;
        jmp dpp_mi_out;
      dpp_mi_bad_dim:
        mov rax, 0xFFFFF6E8;
        jmp dpp_mi_out;
      dpp_mi_no_key:
        mov rax, 0xFFFFF6E6;
        jmp dpp_mi_out;
      dpp_mi_in_use:
        mov rdi, 2;
        call dpp_note;
        mov rax, 0xFFFFF6E4;
        jmp dpp_mi_out;
      dpp_mi_enospc:
        mov rdi, 3;
        call dpp_note;
        mov rax, 0xFFFFF6E5;

      dpp_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_plane_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (plane_key: u64) (memory_slot: u64) (packed_all: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call display_plane_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x173;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let display_plane_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): revoke KIND_DISPLAY_PLANE. Labels prefixed dpp_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae dpp_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  dpp_rvk_already;

        mov r11, 0x173;
        cmp r10, r11;
        jne dpp_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call dpp_tail_valid;
        cmp rax, 0;
        je  dpp_rvk_clear;

        mov rdi, r13;
        call dpp_tail_free;

      dpp_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call dpp_note;

        xor rax, rax;
        jmp dpp_rvk_out;

      dpp_rvk_bad_slot:
        mov rax, 0xFFFFF6E3;
        jmp dpp_rvk_out;
      dpp_rvk_wrong_kind:
        mov rax, 0xFFFFF6E2;
        jmp dpp_rvk_out;
      dpp_rvk_already:
        mov rax, 0xFFFFF6E1;

      dpp_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_plane_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call display_plane_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x173;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_display_plane : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M4-001 (#1249): KIND_DISPLAY_PLANE dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed dpp_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_display_plane_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne dpp_hn_res;

        cmp rbp, 7;
        ja  dpp_hn_unsup;

        cmp rbp, 7;
        je  dpp_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  dpp_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  dpp_hn_k;
        cmp rbp, 1;
        je  dpp_hn_m;
        cmp rbp, 2;
        je  dpp_hn_t;
        cmp rbp, 3;
        je  dpp_hn_z;
        cmp rbp, 4;
        je  dpp_hn_f;
        cmp rbp, 5;
        je  dpp_hn_w;
        call dpp_row_height;
        jmp dpp_hn_out;

      dpp_hn_k:
        call dpp_row_key;
        jmp dpp_hn_out;
      dpp_hn_m:
        call dpp_row_memory;
        jmp dpp_hn_out;
      dpp_hn_t:
        call dpp_row_type;
        jmp dpp_hn_out;
      dpp_hn_z:
        call dpp_row_zorder;
        jmp dpp_hn_out;
      dpp_hn_f:
        call dpp_row_format;
        jmp dpp_hn_out;
      dpp_hn_w:
        call dpp_row_width;
        jmp dpp_hn_out;

      dpp_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  dpp_hn_denied;
        xor rax, rax;
        jmp dpp_hn_out;

      dpp_hn_res:
        mov rax, 0xFFFFF6EE;
        jmp dpp_hn_out;
      dpp_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp dpp_hn_out;
      dpp_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      dpp_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
