  pub let display_engine_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (engine_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): live row holding this engine_key, or ROW_NONE. Refuses to match 0. Labels prefixed dpe_fk_.",
      block: {
        cmp rdi, 0;
        je  dpe_fk_none;
        xor rcx, rcx;
      dpe_fk_scan:
        cmp rcx, 8;
        jae dpe_fk_none;
        lea r10, [rip + _display_engine_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpe_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  dpe_fk_hit;
      dpe_fk_next:
        add rcx, 1;
        jmp dpe_fk_scan;
      dpe_fk_hit:
        mov rax, rcx;
        ret;
      dpe_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let display_engine_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): slot -> row_id, gated on live KIND_DISPLAY_ENGINE. Labels prefixed dpe_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae dpe_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x16F;
        cmp r10, r11;
        jne dpe_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call display_engine_tail_valid;
        cmp rax, 0;
        je  dpe_ros_none;

        mov rax, r12;
        jmp dpe_ros_out;

      dpe_ros_none:
        mov rax, 0xFF;
      dpe_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let display_engine_key_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): engine_key. ARITY ONE. Labels prefixed dpe_kos_.",
      block: {
        push r12; push r13; push r14;
        call display_engine_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  dpe_kos_bad;
        mov rdi, r12;
        call display_engine_row_key;
        jmp dpe_kos_out;
      dpe_kos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpe_kos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, engine_key, device_slot,
  // packed_ident). packed_ident encoding:
  //   [15:0]  pci_bdf
  //   [23:16] gpu_gen
  //   [31:24] power_state
  //   [63:32] cdclk_khz
  // ==========================================================================

  pub let display_engine_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (engine_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): mint KIND_DISPLAY_ENGINE over KIND_DEVICE. Six args (slot, parent, rights, key, device_slot, packed). packed = pci_bdf[15:0] | gpu_gen[23:16] | power_state[31:24] | cdclk_khz[63:32]. Sequence: slot<256; check_parent; parent_key non-zero (NO_DEVICE); rights_valid; unpack + validate bdf/gen/state/cdclk; engine_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body1_pack; body2_pack; tail_alloc; cap_mint_write. Labels prefixed dpe_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // engine_key
        mov r15, r8;                     // device_slot
        mov rbp, r9;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae dpe_mi_bad_slot;

        mov rdi, r12;
        call display_engine_check_parent;
        cmp rax, 0;
        je  dpe_mi_bad_parent;

        mov rdi, r12;
        call display_engine_parent_key;
        cmp rax, 0;
        je  dpe_mi_no_device;

        mov rdi, r13;
        call display_engine_rights_valid;
        cmp rax, 0;
        je  dpe_mi_bad_rights;

        // Validate pci_bdf.
        mov rdi, rbp;
        and rdi, 0xFFFF;
        call display_engine_bdf_valid;
        cmp rax, 0;
        je  dpe_mi_bad_bdf;

        // Validate gpu_gen.
        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFF;
        call display_engine_gen_valid;
        cmp rax, 0;
        je  dpe_mi_bad_gen;

        // Validate power_state.
        mov rdi, rbp;
        shr rdi, 24;
        and rdi, 0xFF;
        call display_engine_power_valid;
        cmp rax, 0;
        je  dpe_mi_bad_state;

        // Validate cdclk_khz.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFFFFFF;
        call display_engine_cdclk_valid;
        cmp rax, 0;
        je  dpe_mi_bad_cdclk;

        cmp r14, 0;
        je  dpe_mi_no_key;

        mov rdi, r14;
        call display_engine_find_by_key;
        cmp rax, 0xFF;
        jne dpe_mi_in_use;

        // Body1 pack args: (device_slot, pci_bdf, gpu_gen, power_state).
        mov rdi, r15;                    // device_slot
        mov rsi, rbp;
        and rsi, 0xFFFF;                 // pci_bdf
        mov rdx, rbp;
        shr rdx, 16;
        and rdx, 0xFF;                   // gpu_gen
        mov rcx, rbp;
        shr rcx, 24;
        and rcx, 0xFF;                   // power_state
        call display_engine_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpe_mi_bad_bdf;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack: cdclk_khz.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFFFFFF;
        call display_engine_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpe_mi_bad_cdclk;
        mov r15, rax;                    // body2 in r15
        push r11;                        // body1
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call display_engine_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dpe_mi_bad_parent;

        // tail_alloc(hdr, engine_key, body1, body2).
        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // engine_key
        mov rdx, r11;                    // body1
        mov rcx, r15;                    // body2
        call display_engine_tail_alloc;

        mov r10, 0xFFFFF7CF;             // ENOSPC
        cmp rax, r10;
        je  dpe_mi_enospc;
        mov r10, 0xFFFFF7CE;             // BAD_ARG
        cmp rax, r10;
        je  dpe_mi_bad_bdf;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x16F;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call display_engine_note;

        xor rax, rax;
        jmp dpe_mi_out;

      dpe_mi_bad_slot:
        mov rax, 0xFFFFF7C3;
        jmp dpe_mi_out;
      dpe_mi_bad_parent:
        mov rax, 0xFFFFF7CD;
        jmp dpe_mi_out;
      dpe_mi_bad_rights:
        mov rax, 0xFFFFF7CC;
        jmp dpe_mi_out;
      dpe_mi_bad_bdf:
        mov rax, 0xFFFFF7CB;
        jmp dpe_mi_out;
      dpe_mi_bad_gen:
        mov rax, 0xFFFFF7CA;
        jmp dpe_mi_out;
      dpe_mi_bad_state:
        mov rax, 0xFFFFF7C9;
        jmp dpe_mi_out;
      dpe_mi_bad_cdclk:
        mov rax, 0xFFFFF7C8;
        jmp dpe_mi_out;
      dpe_mi_no_device:
        mov rax, 0xFFFFF7C7;
        jmp dpe_mi_out;
      dpe_mi_no_key:
        mov rax, 0xFFFFF7C6;
        jmp dpe_mi_out;
      dpe_mi_in_use:
        mov rdi, 2;
        call display_engine_note;
        mov rax, 0xFFFFF7C4;
        jmp dpe_mi_out;
      dpe_mi_enospc:
        mov rdi, 3;
        call display_engine_note;
        mov rax, 0xFFFFF7C5;

      dpe_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_engine_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (engine_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call display_engine_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x16F;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let display_engine_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): revoke KIND_DISPLAY_ENGINE. Labels prefixed dpe_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae dpe_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  dpe_rvk_already;

        mov r11, 0x16F;
        cmp r10, r11;
        jne dpe_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call display_engine_tail_valid;
        cmp rax, 0;
        je  dpe_rvk_clear;

        mov rdi, r13;
        call display_engine_tail_free;

      dpe_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call display_engine_note;

        xor rax, rax;
        jmp dpe_rvk_out;

      dpe_rvk_bad_slot:
        mov rax, 0xFFFFF7C3;
        jmp dpe_rvk_out;
      dpe_rvk_wrong_kind:
        mov rax, 0xFFFFF7C2;
        jmp dpe_rvk_out;
      dpe_rvk_already:
        mov rax, 0xFFFFF7C1;

      dpe_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_engine_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call display_engine_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x16F;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_display_engine : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): KIND_DISPLAY_ENGINE dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed dpe_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_display_engine_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne dpe_hn_res;

        cmp rbp, 7;
        ja  dpe_hn_unsup;

        cmp rbp, 7;
        je  dpe_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  dpe_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  dpe_hn_key;
        cmp rbp, 1;
        je  dpe_hn_dev;
        cmp rbp, 2;
        je  dpe_hn_bdf;
        cmp rbp, 3;
        je  dpe_hn_gen;
        cmp rbp, 4;
        je  dpe_hn_pwr;
        cmp rbp, 5;
        je  dpe_hn_clk;
        call display_engine_row_parent;
        jmp dpe_hn_out;

      dpe_hn_key:
        call display_engine_row_key;
        jmp dpe_hn_out;
      dpe_hn_dev:
        call display_engine_row_device;
        jmp dpe_hn_out;
      dpe_hn_bdf:
        call display_engine_row_bdf;
        jmp dpe_hn_out;
      dpe_hn_gen:
        call display_engine_row_gen;
        jmp dpe_hn_out;
      dpe_hn_pwr:
        call display_engine_row_power;
        jmp dpe_hn_out;
      dpe_hn_clk:
        call display_engine_row_cdclk;
        jmp dpe_hn_out;

      dpe_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  dpe_hn_denied;
        xor rax, rax;
        jmp dpe_hn_out;

      dpe_hn_res:
        mov rax, 0xFFFFF7CE;
        jmp dpe_hn_out;
      dpe_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp dpe_hn_out;
      dpe_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      dpe_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
