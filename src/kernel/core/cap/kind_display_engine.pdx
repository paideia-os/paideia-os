// src/kernel/core/cap/kind_display_engine.pdx — R36.M1-004 (#1238)
//
// KIND_DISPLAY_ENGINE = 0x16F, derived over KIND_DEVICE (10).
//
// The authority to hold ONE Intel Iris Xe display engine's static
// identity — its inherited engine_key, the cap_table slot of its
// parent KIND_DEVICE (device_slot), the PCIe bus:dev:func the engine
// is anchored on, its GPU generation (Xe1 / Xe2 / Xe3), its current
// power state (off / on / suspend), and the current CDCLK setpoint
// in kHz.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A display engine is the root of a display pipeline: every downstream
// authority (backlight, pipe, plane, transcoder, DP link, HDMI DDI,
// panel enablement, colour LUT programming) is scoped by the engine
// the pipe sits inside. Two Iris Xe engines on the same machine host
// two disjoint pipelines (rare on the T14 G4, universal on
// dual-GPU workstations), so the capability that names "this display
// tile" has to be per-engine rather than per-controller. This kind is
// the record of one such engine.
//
// =============================================================================
// §1  DERIVATION OVER KIND_DEVICE
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`.
// Like KIND_TB_DOMAIN, KIND_FP_SENSOR, KIND_HID_DEVICE and every
// other KIND_DEVICE-derived kind, THE KIND HALF OF THE GATE
// DISCRIMINATES NOTHING on its own — every PCI function in the
// machine is a KIND_DEVICE — so the mint additionally requires:
//
//   (a) engine_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE with RIGHT_MINT
//       (NO_DEVICE)
//   (c) pci_bdf fits in u16 (BAD_BDF)
//   (d) gpu_gen in {1, 2, 3} — Xe1 / Xe2 / Xe3 (BAD_GEN); 0 is
//       reserved as "unknown", which is not a live engine
//   (e) power_state in {0, 1, 2} — OFF / ON / SUSPEND (BAD_STATE);
//       every engine starts OFF at mint and is transitioned by the
//       power-well driver
//   (f) cdclk_khz within [CDCLK_MIN_KHZ, CDCLK_MAX_KHZ]
//       (BAD_CDCLK); 0 is refused because a live engine at zero
//       clock is not a live engine
//   (g) rights subset of R_DISPLAY_ENGINE_ALL
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
// engine_key, device_slot, pci_bdf, gpu_gen are ROW IDENTITY, frozen
// at mint. power_state and cdclk_khz are dynamic and reflect the most
// recent report from the power-wells driver (pwr_wells.pdx) and the
// display-clock configuration path (dpclk_config.pdx). Neither
// transition primitive is on this kind: kind_display_engine exposes
// only ROW ACCESSORS and a COUNTER.
//
// =============================================================================
// §3  LEAF OF THE DISPLAY LATTICE
// =============================================================================
//
// R_DISPLAY_ENGINE_MINT (0x200) is DELIBERATELY ABSENT from
// R_DISPLAY_ENGINE_ALL: nothing derives from a display-engine cap
// in this milestone. Same discipline KIND_TB_DOMAIN / KIND_FP_SENSOR
// applied for the same reason — a future pipe / plane / transcoder
// kind can be added as a separate derived kind that consults this
// one at mint.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF7C0..0xFFFFF7CF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dpclk_config 0xFFFFF790..9F,
// pwr_wells 0xFFFFF7A0..AF, iris_xe_probe 0xFFFFF7B0..BF; adjacent
// used band above: dp_altmode 0xFFFFF7D0..DF).

module KindDisplayEngine = structure {

  pub let KIND_DISPLAY_ENGINE         : u64 = 0x16F
  pub let DISPLAY_ENGINE_PARENT_KIND  : u64 = 10          // = KIND_DEVICE

  // GPU generation ordinals (§1). 0 is reserved as "unknown" and
  // refused at mint (BAD_GEN).
  pub let DPY_GEN_XE1 : u64 = 1
  pub let DPY_GEN_XE2 : u64 = 2
  pub let DPY_GEN_XE3 : u64 = 3
  pub let DPY_GEN_MAX : u64 = 3

  // Power state ordinals (§2).
  pub let DPY_PWR_OFF     : u64 = 0
  pub let DPY_PWR_ON      : u64 = 1
  pub let DPY_PWR_SUSPEND : u64 = 2
  pub let DPY_PWR_MAX     : u64 = 2

  // CDCLK plausibility window, in kHz (§1). Xe1/Xe2/Xe3 CDCLK
  // setpoints per bspec fall in [172800, 819200] kHz; the window is
  // widened slightly to admit both extremes without clipping.
  pub let CDCLK_MIN_KHZ : u64 = 100000
  pub let CDCLK_MAX_KHZ : u64 = 1000000

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_DISPLAY_ENGINE_READ    : u64 = 0x001
  pub let R_DISPLAY_ENGINE_INVOKE  : u64 = 0x008
  pub let R_DISPLAY_ENGINE_REVOKE  : u64 = 0x010
  pub let R_DISPLAY_ENGINE_OBSERVE : u64 = 0x400
  pub let R_DISPLAY_ENGINE_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let DPY_ENG_OP_QUERY_KEY      : u64 = 0
  pub let DPY_ENG_OP_QUERY_DEVICE   : u64 = 1
  pub let DPY_ENG_OP_QUERY_BDF      : u64 = 2
  pub let DPY_ENG_OP_QUERY_GEN      : u64 = 3
  pub let DPY_ENG_OP_QUERY_POWER    : u64 = 4
  pub let DPY_ENG_OP_QUERY_CDCLK    : u64 = 5
  pub let DPY_ENG_OP_QUERY_PARENT   : u64 = 6
  pub let DPY_ENG_OP_DEBUG_PRINT    : u64 = 7
  pub let DPY_ENG_OP_MAX            : u64 = 7

  // Failure taxonomy — 0xFFFFF7C0..0xFFFFF7CF.
  pub let DPY_ENG_OK                 : u64 = 0
  pub let DPY_ENG_TAIL_ENOSPC        : u64 = 0xFFFFF7CF
  pub let DPY_ENG_TAIL_BAD_ARG       : u64 = 0xFFFFF7CE
  pub let DPY_ENG_MINT_BAD_PARENT    : u64 = 0xFFFFF7CD
  pub let DPY_ENG_MINT_BAD_RIGHTS    : u64 = 0xFFFFF7CC
  pub let DPY_ENG_MINT_BAD_BDF       : u64 = 0xFFFFF7CB
  pub let DPY_ENG_MINT_BAD_GEN       : u64 = 0xFFFFF7CA
  pub let DPY_ENG_MINT_BAD_STATE     : u64 = 0xFFFFF7C9
  pub let DPY_ENG_MINT_BAD_CDCLK     : u64 = 0xFFFFF7C8
  pub let DPY_ENG_MINT_NO_DEVICE     : u64 = 0xFFFFF7C7
  pub let DPY_ENG_MINT_NO_KEY        : u64 = 0xFFFFF7C6
  pub let DPY_ENG_MINT_ENOSPC        : u64 = 0xFFFFF7C5
  pub let DPY_ENG_MINT_IN_USE        : u64 = 0xFFFFF7C4
  pub let DPY_ENG_BAD_SLOT           : u64 = 0xFFFFF7C3
  pub let DPY_ENG_WRONG_KIND         : u64 = 0xFFFFF7C2
  pub let DPY_ENG_REVOKE_ALREADY     : u64 = 0xFFFFF7C1

  pub let DPY_ENG_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPY_ENG_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride — total 256 bytes as [u64; 32].
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  engine_key
  //   [+16] body word 1: device_slot[31:0] | pci_bdf[47:32]
  //                     | gpu_gen[55:48] | power_state[63:56]
  //   [+24] body word 2: cdclk_khz[31:0] | reserved[63:32]
  //
  // 32B = engine_key(8) + device_slot(4) + pci_bdf(2) + gpu_gen(1)
  //     + power_state(1) + cdclk_khz(4) + hdr(8) + reserved(4) = 32.
  pub let DPY_ENGINE_MAX       : u64 = 8
  pub let DPY_ENGINE_ROW_BYTES : u64 = 32

  pub let mut _display_engine_table : [u64; 32] = uninit @align(64)
  pub let mut _display_engine_stats : [u64; 4]  = uninit @align(64)

  pub let DPY_ENG_ST_MINTS   : u64 = 0
  pub let DPY_ENG_ST_REVOKES : u64 = 1
  pub let DPY_ENG_ST_IN_USE  : u64 = 2
  pub let DPY_ENG_ST_ENOSPC  : u64 = 3

  pub let dpy_eng_dbg_msg : [u8; 18] = "DISPLAY ENGINE ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let display_engine_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): clear the DISPLAY ENGINE row table and its counters. Boot and teardown only. Labels prefixed dpe_rs_.",
      block: {
        lea r10, [rip + _display_engine_table];
        xor rax, rax;
        xor rcx, rcx;
      dpe_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  dpe_rs_rows;

        lea r10, [rip + _display_engine_stats];
        xor rcx, rcx;
      dpe_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dpe_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let display_engine_bdf_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): 1 iff b fits in u16 (bus:dev:func packed as bus[15:8] dev[7:3] func[2:0]). Labels prefixed dpe_bv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dpe_bv_no;
        mov rax, 1;
        ret;
      dpe_bv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_engine_gen_valid : (u64) -> u64 !{} @{} =
    fn (g: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): 1 iff g in {1,2,3} (Xe1/Xe2/Xe3). 0 is reserved as unknown and refused. Labels prefixed dpe_gv_.",
      block: {
        cmp rdi, 1;
        jb  dpe_gv_no;
        cmp rdi, 3;
        ja  dpe_gv_no;
        mov rax, 1;
        ret;
      dpe_gv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_engine_power_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): 1 iff p in {0,1,2} (OFF/ON/SUSPEND). Labels prefixed dpe_pv_.",
      block: {
        cmp rdi, 2;
        ja  dpe_pv_no;
        mov rax, 1;
        ret;
      dpe_pv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_engine_cdclk_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): 1 iff CDCLK_MIN_KHZ <= c <= CDCLK_MAX_KHZ. 0 is below the floor and refused. Labels prefixed dpe_cv_.",
      block: {
        mov r10, 100000;                 // CDCLK_MIN_KHZ
        cmp rdi, r10;
        jb  dpe_cv_no;
        mov r10, 1000000;                // CDCLK_MAX_KHZ
        cmp rdi, r10;
        ja  dpe_cv_no;
        mov rax, 1;
        ret;
      dpe_cv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_engine_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): subset test against R_DISPLAY_ENGINE_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — this kind is a leaf (§3). Labels prefixed dpe_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne dpe_rgv_no;
        mov rax, 1;
        ret;
      dpe_rgv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let display_engine_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): counter bump. Labels prefixed dpe_nt_.",
      block: {
        cmp rdi, 4;
        jae dpe_nt_out;
        lea r10, [rip + _display_engine_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpe_nt_out:
        ret
      }
    } @no_frame

  pub let display_engine_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): counter read. Labels prefixed dpe_st_.",
      block: {
        cmp rdi, 4;
        jae dpe_st_zero;
        lea r10, [rip + _display_engine_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpe_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: parent must be live KIND_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let display_engine_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): §1 gate. parent must be live KIND_DEVICE (10) with RIGHT_MINT. Kind check alone discriminates NOTHING; the mint's additional gates cover the rest. Labels prefixed dpe_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpe_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne dpe_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  dpe_cp_no;

        mov rax, 1;
        ret;
      dpe_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let display_engine_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M1-004 (#1238): parent KIND_DEVICE target_ptr = its identity key. 0 if bad slot or wrong kind — the mint refuses NO_DEVICE for 0. Labels prefixed dpe_pk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae dpe_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne dpe_pk_no;

        mov rax, [rax + 16];
        ret;
      dpe_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let display_engine_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): (parent_slot << 8). Labels prefixed dpe_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae dpe_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      dpe_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let display_engine_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (pci_bdf: u64) (gpu_gen: u64) (power_state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): pack device_slot[31:0] | pci_bdf[47:32] | gpu_gen[55:48] | power_state[63:56]. Refuses out-of-range fields. Labels prefixed dpe_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dpe_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  dpe_b1_bad;
        cmp rdx, 0xFF;
        ja  dpe_b1_bad;
        cmp rcx, 0xFF;
        ja  dpe_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      dpe_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let display_engine_body2_pack : (u64) -> u64 !{} @{} =
    fn (cdclk_khz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-004 (#1238): pack cdclk_khz[31:0]. Reserved [63:32] left zero. Refuses out-of-range cdclk. Labels prefixed dpe_b2_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dpe_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        ret;
      dpe_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc/valid/free.
  //
  // THE ONE WRITER of _display_engine_table. tools/build.sh confines
  // relocations against `_display_engine_table` to this object.
  // ==========================================================================

  pub let display_engine_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (engine_key: u64) (body1_packed: u64) (body2_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): claim one DISPLAY ENGINE row. THE ONE WRITER of _display_engine_table. Gates: hdr in_use pre-set -> BAD_ARG; engine_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows of 32 bytes. Labels prefixed dpe_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // engine_key
        mov r14, rdx;                    // body1
        mov r15, rcx;                    // body2

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne dpe_ta_bad;

        cmp r13, 0;
        je  dpe_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  dpe_ta_bad;
        cmp r15, r10;
        je  dpe_ta_bad;

        xor rbx, rbx;
      dpe_ta_scan:
        cmp rbx, 8;
        jae dpe_ta_enospc;

        lea r10, [rip + _display_engine_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpe_ta_claim;

        add rbx, 1;
        jmp dpe_ta_scan;

      dpe_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp dpe_ta_out;

      dpe_ta_enospc:
        mov rax, 0xFFFFF7CF;
        jmp dpe_ta_out;
      dpe_ta_bad:
        mov rax, 0xFFFFF7CE;

      dpe_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let display_engine_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): 1 iff row_id < MAX and in_use. Labels prefixed dpe_tvr_.",
      block: {
        cmp rdi, 8;
        jae dpe_tvr_no;
        lea r10, [rip + _display_engine_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dpe_tvr_no;
        mov rax, 1;
        ret;
      dpe_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let display_engine_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): scrub one row. Labels prefixed dpe_tf_.",
      block: {
        cmp rdi, 8;
        jae dpe_tf_out;
        lea r10, [rip + _display_engine_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      dpe_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let display_engine_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): engine_key. Labels prefixed dpe_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call display_engine_tail_valid;
        cmp rax, 0;
        je  dpe_rk_bad;
        lea r10, [rip + _display_engine_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp dpe_rk_out;
      dpe_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpe_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let display_engine_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-004 (#1238): device_slot. Labels prefixed dpe_rd_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call display_engine_tail_valid;
        cmp rax, 0;
        je  dpe_rd_bad;
        lea r10, [rip + _display_engine_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp dpe_rd_out;
      dpe_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      dpe_rd_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let display_engine_row_bdf : (u64) -> u64 !{mem} @{} =
