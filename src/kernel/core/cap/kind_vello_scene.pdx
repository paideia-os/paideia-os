        mov r12, rdi;
        call vs_tail_valid;
        cmp rax, 0;
        je  vs_rf_bad;
        lea r10, [rip + _vello_scene_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
