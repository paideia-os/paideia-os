  // Rewrite the flags field on a live row.
  pub let vs_row_set_flags : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): rewrite flags[47:32] on header. Row valid + flags subset of VS_FL_ALL. Three pushes to keep rsp aligned across calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r13;
        call vs_flags_valid;
        cmp rax, 0;
        je  vs_sf_bad;

        mov rdi, r12;
        call vs_tail_valid;
        cmp rax, 0;
        je  vs_sf_bad;

        lea r10, [rip + _vello_scene_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, 0xFFFF;
        shl r11, 32;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFFFF;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 0], rax;

        mov rdi, 4;
        call vs_note;

        xor rax, rax;
        jmp vs_sf_out;

      vs_sf_bad:
        mov rax, 0xFFFFEDB3;

      vs_sf_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vs_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (scene_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): live row with this scene_key, or ROW_NONE.",
      block: {
        cmp rdi, 0;
        je  vs_fk_none;
        xor rcx, rcx;
      vs_fk_scan:
        cmp rcx, 16;
        jae vs_fk_none;
        lea r10, [rip + _vello_scene_table];
        mov r11, rcx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vs_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  vs_fk_hit;
      vs_fk_next:
        add rcx, 1;
        jmp vs_fk_scan;
      vs_fk_hit:
        mov rax, rcx;
        ret;
      vs_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let vs_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G4.M1-002 (#1476): slot -> row_id, gated on live KIND_VELLO_SCENE.",
      block: {
        push r12;
        mov r11, 256;
        cmp rdi, r11;
        jae vs_ros_none;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x18D;
        cmp r10, r11;
        jne vs_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call vs_tail_valid;
        cmp rax, 0;
        je  vs_ros_none;
        mov rax, r12;
        jmp vs_ros_out;
      vs_ros_none:
        mov rax, 0xFF;
      vs_ros_out:
        pop r12;
        ret
      }
    }

  pub let cap_handler_vello_scene : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G4.M1-002 (#1476): KIND_VELLO_SCENE dispatch. QUERY ops arity ONE.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_vello_scene_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne vs_hn_res;

        cmp rbp, 6;
        ja  vs_hn_unsup;
        cmp rbp, 6;
        je  vs_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  vs_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  vs_hn_key;
        cmp rbp, 1;
        je  vs_hn_bo;
        cmp rbp, 2;
        je  vs_hn_paths;
        cmp rbp, 3;
        je  vs_hn_bytes;
        cmp rbp, 4;
        je  vs_hn_samps;
        call vs_row_flags;
        jmp vs_hn_out;

      vs_hn_key:
        call vs_row_key;
        jmp vs_hn_out;
      vs_hn_bo:
        call vs_row_bo;
        jmp vs_hn_out;
      vs_hn_paths:
        call vs_row_paths;
        jmp vs_hn_out;
      vs_hn_bytes:
        call vs_row_bytes;
        jmp vs_hn_out;
      vs_hn_samps:
        call vs_row_samples;
        jmp vs_hn_out;

      vs_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  vs_hn_denied;
        xor rax, rax;
        jmp vs_hn_out;

      vs_hn_res:
        mov rax, 0xFFFFEDBE;
        jmp vs_hn_out;
      vs_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp vs_hn_out;
      vs_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      vs_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
