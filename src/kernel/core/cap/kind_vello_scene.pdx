// src/kernel/core/cap/kind_vello_scene.pdx -- G4.M1-002 (#1476)
//
// KIND_VELLO_SCENE = 0x18D, derived over KIND_GPU_BO (0x174), whose
// runtime base is KIND_MEMORY (= KIND_PAGE, 4).
//
// One encoded Vello scene -- the compute-based 2D rasterizer's
// input, a sort-middle piet-gpu-lineage stream of encoded path,
// stroke, fill, and clip records living in a GPU-visible buffer
// object. The scene is the ONE input a KIND_VELLO_RENDERER consumes;
// a compositor building a frame encodes ONE scene per swapchain
// image and hands the pair (scene, renderer) to the render channel.
//
// =============================================================================
// SECTION 0  WHY THIS KIND IS DERIVED OVER KIND_GPU_BO
// =============================================================================
//
// The scene bytes live in the SAME buffer object the compute-shader
// pipelines read from. Splitting the encoding step from the buffer
// object would either force one extra copy (encoder writes to CPU
// memory, then a DMA into a BO) or lose the invariant that the
// scene bytes and the BO the renderer binds are the same bytes.
//
// Deriving from KIND_GPU_BO fixes both: minting a KIND_VELLO_SCENE
// pins the parent BO through its RIGHT_MINT authority, and every
// subsequent renderer submission binds the exact BO the encoder
// wrote into.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_GPU_BO
// =============================================================================
//
// The kind half of the gate demands `kind == KIND_GPU_BO (0x174)`
// carrying RIGHT_MINT. The mint additionally requires:
//
//   (a) scene_key non-zero and unique among live rows
//   (b) path_count in [0, VS_MAX_PATHS = 65535] (u16 field)
//   (c) encoded_bytes non-zero and a multiple of VS_ALIGN = 64
//       (G4.M1-005 alignment: WGSL storage-buffer minimum stride)
//   (d) encoded_bytes <= VS_MAX_BYTES = 16 MiB (one scene fits in
//       a single BO reasonably)
//   (e) sample_count in {1, 2, 4, 8, 16} (MSAA modes; caller-side
//       validated to power-of-two <= 16)
//   (f) rights subset of R_VS_ALL (R_MINT PRESENT -- a renderer
//       submission mints a KIND_VELLO_RENDER_SUBMIT row that
//       carries the (scene, renderer) pair)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 40 BYTES (FIVE u64 WORDS)
// =============================================================================
//
//   [+0]  header: in_use[63:56] | flags[47:32] | parent_slot[15:8]
//   [+8]  scene_key (u64)
//   [+16] body1: bo_slot[15:0] | path_count[31:16]
//              | sample_count[39:32] | reserved[63:40]
//   [+24] encoded_bytes (u64)
//   [+32] reserved (u64)
//
// THE ONE WRITER of _vello_scene_table is vs_tail_alloc / vs_tail_free
// / vs_set_flags. Every read is a peer.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEDB0..0xFFFFEDBF
// =============================================================================

module KindVelloScene = structure {

  pub let KIND_VELLO_SCENE  : u64 = 0x18D
  pub let VS_PARENT_KIND    : u64 = 0x174        // KIND_GPU_BO

  // Rights. R_MINT PRESENT -- a render submission derives from a scene.
  pub let R_VS_READ    : u64 = 0x001
  pub let R_VS_INVOKE  : u64 = 0x008
  pub let R_VS_REVOKE  : u64 = 0x010
  pub let R_VS_MINT    : u64 = 0x200
  pub let R_VS_OBSERVE : u64 = 0x400
  pub let R_VS_ALL     : u64 = 0x619

  // Ops. Every op arity ONE.
  pub let VS_OP_QUERY_KEY     : u64 = 0
  pub let VS_OP_QUERY_BO      : u64 = 1
  pub let VS_OP_QUERY_PATHS   : u64 = 2
  pub let VS_OP_QUERY_BYTES   : u64 = 3
  pub let VS_OP_QUERY_SAMPLES : u64 = 4
  pub let VS_OP_QUERY_FLAGS   : u64 = 5
  pub let VS_OP_DEBUG_PRINT   : u64 = 6
  pub let VS_OP_MAX           : u64 = 6

  // Scene flags (16 bits).
  pub let VS_FL_HAS_GRADIENTS : u64 = 0x0001
  pub let VS_FL_HAS_BLUR      : u64 = 0x0002
  pub let VS_FL_HAS_PATH_FX   : u64 = 0x0004
  pub let VS_FL_TILED_COARSE  : u64 = 0x0008
  pub let VS_FL_ALL           : u64 = 0x000F

  // Bounds.
  pub let VS_MAX_PATHS    : u64 = 65535
  pub let VS_MAX_BYTES    : u64 = 16777216     // 16 MiB
  pub let VS_ALIGN        : u64 = 64
  pub let VS_MAX_SAMPLES  : u64 = 16

  // Failure taxonomy -- 0xFFFFEDB0..0xFFFFEDBF.
  pub let VS_OK              : u64 = 0
  pub let VS_TAIL_ENOSPC     : u64 = 0xFFFFEDBF
  pub let VS_TAIL_BAD_ARG    : u64 = 0xFFFFEDBE
  pub let VS_MINT_BAD_PARENT : u64 = 0xFFFFEDBD
  pub let VS_MINT_BAD_RIGHTS : u64 = 0xFFFFEDBC
  pub let VS_MINT_BAD_PATHS  : u64 = 0xFFFFEDBB
  pub let VS_MINT_BAD_BYTES  : u64 = 0xFFFFEDBA
  pub let VS_MINT_BAD_ALIGN  : u64 = 0xFFFFEDB9
  pub let VS_MINT_BAD_SAMPS  : u64 = 0xFFFFEDB8
  pub let VS_MINT_NO_KEY     : u64 = 0xFFFFEDB7
  pub let VS_MINT_ENOSPC     : u64 = 0xFFFFEDB6
  pub let VS_BAD_SLOT        : u64 = 0xFFFFEDB5
  pub let VS_WRONG_KIND      : u64 = 0xFFFFEDB4
  pub let VS_BAD_STATE       : u64 = 0xFFFFEDB3

  pub let VS_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let VS_ROW_NONE   : u64 = 0xFF

  pub let VS_MAX       : u64 = 16
  pub let VS_ROW_BYTES : u64 = 40

  // THE ONE STATE CELL. Confined by tools/build.sh. 16 rows * 5 u64 = 80 slots.
  pub let mut _vello_scene_table : [u64; 80] = uninit @align(64)
  pub let mut _vello_scene_stats : [u64; 8]  = uninit @align(64)

  pub let VS_STA_MINTS   : u64 = 0
  pub let VS_STA_REVOKES : u64 = 1
  pub let VS_STA_REFUSED : u64 = 2
  pub let VS_STA_QUERIES : u64 = 3
  pub let VS_STA_FLAGSET : u64 = 4

  pub let vs_dbg_msg : [u8; 16] = "VELLO SCENE ROW\0"

  pub let vs_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): clear row table + counters.",
      block: {
        lea r10, [rip + _vello_scene_table];
        xor rax, rax;
        xor rcx, rcx;
      vs_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 80;
        jb  vs_rs_rows;

        lea r10, [rip + _vello_scene_stats];
        xor rcx, rcx;
      vs_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vs_rs_stats;
        ret
      }
    }

  pub let vs_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): counter bump.",
      block: {
        cmp rdi, 8;
        jae vs_nt_out;
        lea r10, [rip + _vello_scene_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vs_nt_out:
        ret
      }
    }

  pub let vs_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): counter read.",
      block: {
        cmp rdi, 8;
        jae vs_st_zero;
        lea r10, [rip + _vello_scene_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vs_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vs_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-002 (#1476): subset test against R_VS_ALL = 0x619.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne vs_rv_no;
        mov rax, 1;
        ret;
      vs_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vs_bytes_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-002 (#1476): 1 iff 0 < n <= VS_MAX_BYTES AND aligned to VS_ALIGN = 64.",
      block: {
        cmp rdi, 0;
        je  vs_bv_no;
        mov r10, 16777216;
        cmp rdi, r10;
        ja  vs_bv_no;
        // alignment: (n & 63) == 0.
        mov r10, rdi;
        and r10, 63;
        cmp r10, 0;
        jne vs_bv_no;
        mov rax, 1;
        ret;
      vs_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vs_paths_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-002 (#1476): 1 iff n <= VS_MAX_PATHS = 65535.",
      block: {
        mov r10, 65535;
        cmp rdi, r10;
        ja  vs_pv_no;
        mov rax, 1;
        ret;
      vs_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vs_samples_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-002 (#1476): 1 iff n in {1,2,4,8,16}.",
      block: {
        cmp rdi, 1;
        je  vs_sv_yes;
        cmp rdi, 2;
        je  vs_sv_yes;
        cmp rdi, 4;
        je  vs_sv_yes;
        cmp rdi, 8;
        je  vs_sv_yes;
        cmp rdi, 16;
        je  vs_sv_yes;
        xor rax, rax;
        ret;
      vs_sv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let vs_flags_valid : (u64) -> u64 !{} @{} =
    fn (fl: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-002 (#1476): subset test against VS_FL_ALL = 0xF.",
      block: {
        mov rax, rdi;
        mov r10, 0x000F;
        and rax, r10;
        cmp rax, rdi;
        jne vs_fv_no;
        mov rax, 1;
        ret;
      vs_fv_no:
        xor rax, rax;
        ret
      }
    }

  // body1: bo_slot[15:0] | path_count[31:16] | sample_count[39:32]
  pub let vs_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (bo: u64) (paths: u64) (samps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-002 (#1476): body1 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vs_b1_bad;
        cmp rsi, r10;
        ja  vs_b1_bad;
        mov r10, 0xFF;
        cmp rdx, r10;
        ja  vs_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      vs_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // header: in_use[63:56] | flags[47:32] | parent_slot[15:8]
  pub let vs_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (parent_slot: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-002 (#1476): (parent_slot << 8) | (flags << 32).",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vs_hp_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  vs_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      vs_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vs_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (scene_key: u64) (body1: u64) (encoded_bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): claim one VELLO_SCENE row. THE ONE WRITER of _vello_scene_table.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne vs_ta_bad;
        cmp r13, 0;
        je  vs_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  vs_ta_bad;

        xor rbx, rbx;
      vs_ta_scan:
        cmp rbx, 16;
        jae vs_ta_enospc;
        lea r10, [rip + _vello_scene_table];
        mov r11, rbx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vs_ta_claim;
        add rbx, 1;
        jmp vs_ta_scan;

      vs_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        xor rax, rax;
        mov [r10 + 32], rax;
        mov rax, rbx;
        jmp vs_ta_out;

      vs_ta_enospc:
        mov rax, 0xFFFFEDBF;
        jmp vs_ta_out;
      vs_ta_bad:
        mov rax, 0xFFFFEDBE;

      vs_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vs_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): 1 iff row_id < VS_MAX and in_use.",
      block: {
        cmp rdi, 16;
        jae vs_tv_no;
        lea r10, [rip + _vello_scene_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vs_tv_no;
        mov rax, 1;
        ret;
      vs_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vs_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): scrub one row.",
      block: {
        cmp rdi, 16;
        jae vs_tf_out;
        lea r10, [rip + _vello_scene_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
      vs_tf_out:
        ret
      }
    }

  pub let vs_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): scene_key.",
      block: {
        push r12;
        mov r12, rdi;
        call vs_tail_valid;
        cmp rax, 0;
        je  vs_rk_bad;
        lea r10, [rip + _vello_scene_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp vs_rk_out;
      vs_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vs_rk_out:
        pop r12;
        ret
      }
    }

  pub let vs_row_bo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-002 (#1476): bo_slot at body1[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call vs_tail_valid;
        cmp rax, 0;
        je  vs_rb_bad;
        lea r10, [rip + _vello_scene_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp vs_rb_out;
      vs_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vs_rb_out:
        pop r12;
        ret
      }
    }

  pub let vs_row_paths : (u64) -> u64 !{mem} @{} =
