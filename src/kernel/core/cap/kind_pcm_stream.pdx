  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let pcm_stream_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (stream_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): live row holding this stream_key, or ROW_NONE. Labels prefixed pcm_fk_.",
      block: {
        cmp rdi, 0;
        je  pcm_fk_none;
        xor rcx, rcx;
      pcm_fk_scan:
        cmp rcx, 8;
        jae pcm_fk_none;
        lea r10, [rip + _pcm_stream_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pcm_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  pcm_fk_hit;
      pcm_fk_next:
        add rcx, 1;
        jmp pcm_fk_scan;
      pcm_fk_hit:
        mov rax, rcx;
        ret;
      pcm_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // pcm_stream_find_conflicting_ring_clock(ring_bo_key, audio_clock_slot)
  //   -> row | ROW_NONE
  //
  // §3 CROSS-CAP INVARIANT — #1151. Scan all live rows; if any has the
  // SAME ring_bo_key AND a DIFFERENT audio_clock_slot, return its row.
  // Same key + same clock is not a conflict. Refuses a zero ring_bo_key
  // outright.
  // ==========================================================================

  pub let pcm_stream_find_conflicting_ring_clock : (u64, u64) -> u64 !{mem} @{} =
    fn (ring_bo_key: u64, audio_clock_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-005 (#1151): live row that would violate the same-ring-different-clock invariant, or ROW_NONE. This is the ONLY consultation of the cross-cap invariant §3 documents; the mint refuses on a hit. Refuses ring_bo_key=0 outright (zero ring is the tail_alloc refusal value). Labels prefixed pcm_fx_.",
      block: {
        cmp rdi, 0;
        je  pcm_fx_none;
        xor rcx, rcx;
      pcm_fx_scan:
        cmp rcx, 8;
        jae pcm_fx_none;
        lea r10, [rip + _pcm_stream_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pcm_fx_next;
        mov rax, [r10 + 24];             // ring_bo_key
        cmp rax, rdi;
        jne pcm_fx_next;
        mov rax, [r10 + 16];             // audio_clock_slot
        cmp rax, rsi;
        je  pcm_fx_next;                 // same ring + same clock -> ok
        mov rax, rcx;
        ret;
      pcm_fx_next:
        add rcx, 1;
        jmp pcm_fx_scan;
      pcm_fx_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let pcm_stream_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): slot -> row_id. ARITY ONE. Labels prefixed pcm_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae pcm_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x15f;                  // KIND_PCM_STREAM
        cmp r10, r11;
        jne pcm_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call pcm_stream_tail_valid;
        cmp rax, 0;
        je  pcm_ros_none;

        mov rax, r12;
        jmp pcm_ros_out;

      pcm_ros_none:
        mov rax, 0xFF;
      pcm_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let pcm_stream_clock_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): audio_clock_slot of the stream this cap names. ARITY ONE. Labels prefixed pcm_kos_.",
      block: {
        push r12; push r13; push r14;
        call pcm_stream_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  pcm_kos_bad;
        mov rdi, r12;
        call pcm_stream_row_clock;
        jmp pcm_kos_out;
      pcm_kos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pcm_kos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let pcm_stream_ring_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): ring_bo_key of the stream this cap names. ARITY ONE. Labels prefixed pcm_grs_.",
      block: {
        push r12; push r13; push r14;
        call pcm_stream_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  pcm_grs_bad;
        mov rdi, r12;
        call pcm_stream_row_ring;
        jmp pcm_grs_out;
      pcm_grs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pcm_grs_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let pcm_stream_position_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): position of the stream. ARITY ONE. Labels prefixed pcm_pos_.",
      block: {
        push r12; push r13; push r14;
        call pcm_stream_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  pcm_pos_bad;
        mov rdi, r12;
        call pcm_stream_row_position;
        jmp pcm_pos_out;
      pcm_pos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pcm_pos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // pcm_stream_position_advance(slot, delta) -> OK | BAD_SLOT | BAD_ARG
  //
  // ARITY TWO — a capability and one delta. Labels prefixed pcm_pa_.
  // ==========================================================================

  pub let pcm_stream_position_advance : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (delta: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): position += delta. ARITY TWO. Delta bounded to 2^40 (samples over a stream lifetime that a single advance may legitimately report) so a report can never overflow the counter more than once. Labels prefixed pcm_pa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // delta

        call pcm_stream_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  pcm_pa_bad_slot;

        mov r10, 1;
        shl r10, 40;                     // 2^40 cap
        cmp r12, r10;
        ja  pcm_pa_bad_arg;

        lea r10, [rip + _pcm_stream_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 40];
        add rax, r12;
        mov [r10 + 40], rax;

        mov rdi, 1;                      // ST_ADVANCES
        call pcm_stream_note;

        xor rax, rax;
        jmp pcm_pa_out;

      pcm_pa_bad_slot:
        mov rax, 0xFFFFFEC2;
        jmp pcm_pa_out;
      pcm_pa_bad_arg:
        mov rax, 0xFFFFFECE;

      pcm_pa_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six arguments fit SysV six-register limit — the seventh
  // (stream_key session ordinal) is computed from the parent endpoint
  // id and the passed session ordinal, itself derived from the caller.
  //
  // pcm_stream_cap_mint_inner(slot, parent_slot, rights,
  //                            audio_clock_slot, ring_bo_key, frc_packed)
  // ==========================================================================

  pub let pcm_stream_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (audio_clock_slot: u64) (ring_bo_key: u64) (frc_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147) + #1151: mint a KIND_PCM_STREAM over KIND_IPC_ENDPOINT. Sequence: (1) slot < 256 else BAD_SLOT. (2) check_parent -> BAD_PARENT. (3) rights_valid -> BAD_RIGHTS. (4) audio_clock_slot < 256 and pcm_stream_clock_valid -> BAD_CLOCK. (5) ring_bo_key non-zero -> BAD_RING. (6) frc_packed != DECODE_BAD -> validators packed inside. (7) INHERIT endpoint_id -> NO_ENDPOINT if zero. (8) UNIQUENESS: find_by_key on stream_key (endpoint_id | slot << 32) must return NONE -> IN_USE. (9) CROSS-CAP INVARIANT §3: find_conflicting_ring_clock must return NONE -> XCLOCK_CONFLICT counted separately (ST_XCLOCK). (10) hdr_pack + tail_alloc. (11) cap_mint_write. Labels prefixed pcm_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // audio_clock_slot
        mov r15, r8;                     // ring_bo_key
        mov rbp, r9;                     // frc_packed

        mov r10, 256;
        cmp rbx, r10;
        jae pcm_mi_bad_slot;

        mov rdi, r12;
        call pcm_stream_check_parent;
        cmp rax, 0;
        je  pcm_mi_bad_parent;

        mov rdi, r13;
        call pcm_stream_rights_valid;
        cmp rax, 0;
        je  pcm_mi_bad_rights;

        mov r10, 256;
        cmp r14, r10;
        jae pcm_mi_bad_clock;
        mov rdi, r14;
        call pcm_stream_clock_valid;
        cmp rax, 0;
        je  pcm_mi_bad_clock;

        cmp r15, 0;
        je  pcm_mi_bad_ring;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rbp, r10;
        je  pcm_mi_bad_fmt;

        mov rdi, r12;
        call pcm_stream_parent_eid;
        cmp rax, 0;
        je  pcm_mi_no_endpoint;

        // Compose stream_key = endpoint_id | (slot << 32). Stashed on
        // the stack for the uniqueness and mint-write phases.
        mov r10, rbx;
        shl r10, 32;
        or  r10, rax;                    // r10 = stream_key
        push r10;
        sub rsp, 8;

        mov rdi, r10;
        call pcm_stream_find_by_key;
        add rsp, 8;
        pop r10;
        cmp rax, 0xFF;
        jne pcm_mi_in_use_note;

        // Cross-cap invariant check (#1151).
        push r10;
        sub rsp, 8;
        mov rdi, r15;                    // ring_bo_key
        mov rsi, r14;                    // audio_clock_slot
        call pcm_stream_find_conflicting_ring_clock;
        add rsp, 8;
        pop r10;
        cmp rax, 0xFF;
        jne pcm_mi_xclock_note;

        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call pcm_stream_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  pcm_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // stream_key
        mov rdx, r14;                    // audio_clock_slot
        mov rcx, r15;                    // ring_bo_key
        mov r8,  rbp;                    // frc_packed
        call pcm_stream_tail_alloc;

        mov r10, 0xFFFFFECF;
        cmp rax, r10;
        je  pcm_mi_enospc;
        mov r10, 0xFFFFFECE;
        cmp rax, r10;
        je  pcm_mi_bad_ring;

        mov r14, rax;
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x15f;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;

        mov rdi, 0;                      // ST_MINTS
        call pcm_stream_note;

        xor rax, rax;
        jmp pcm_mi_out;

      pcm_mi_in_use_note:
        mov rdi, 3;                      // ST_IN_USE
        call pcm_stream_note;
        mov rax, 0xFFFFFEC4;
        jmp pcm_mi_out;

      pcm_mi_xclock_note:
        mov rdi, 2;                      // ST_XCLOCK
        call pcm_stream_note;
        mov rax, 0xFFFFFEC3;
        jmp pcm_mi_out;

      pcm_mi_bad_slot:
        mov rax, 0xFFFFFEC2;
        jmp pcm_mi_out;
      pcm_mi_bad_parent:
        mov rax, 0xFFFFFECD;
        jmp pcm_mi_out;
      pcm_mi_bad_rights:
        mov rax, 0xFFFFFECC;
        jmp pcm_mi_out;
      pcm_mi_bad_clock:
        mov rax, 0xFFFFFECB;
        jmp pcm_mi_out;
      pcm_mi_bad_ring:
        mov rax, 0xFFFFFECA;
        jmp pcm_mi_out;
      pcm_mi_bad_fmt:
        mov rax, 0xFFFFFEC9;
        jmp pcm_mi_out;
      pcm_mi_no_endpoint:
        mov rax, 0xFFFFFEC6;
        jmp pcm_mi_out;
      pcm_mi_enospc:
        mov rdi, 4;                      // ST_ENOSPC
        call pcm_stream_note;
        mov rax, 0xFFFFFEC5;

      pcm_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pcm_stream_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (audio_clock_slot: u64) (ring_bo_key: u64) (frc_packed: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call pcm_stream_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x15f;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let pcm_stream_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): revoke a KIND_PCM_STREAM. Labels prefixed pcm_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae pcm_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  pcm_rvk_already;

        mov r11, 0x15f;
        cmp r10, r11;
        jne pcm_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call pcm_stream_tail_valid;
        cmp rax, 0;
        je  pcm_rvk_clear;

        mov rdi, r13;
        call pcm_stream_tail_free;

      pcm_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 5;                      // ST_REVOKES
        call pcm_stream_note;

        xor rax, rax;
        jmp pcm_rvk_out;

      pcm_rvk_bad_slot:
        mov rax, 0xFFFFFEC2;
        jmp pcm_rvk_out;
      pcm_rvk_wrong_kind:
        mov rax, 0xFFFFFEC1;
        jmp pcm_rvk_out;
      pcm_rvk_already:
        mov rax, 0xFFFFFEC0;

      pcm_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pcm_stream_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call pcm_stream_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x15f;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch.
  // ==========================================================================

  pub let cap_handler_pcm_stream : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): KIND_PCM_STREAM dispatch handler. row_id = target_ptr[15:0], slot = target_ptr[31:16]; op = op_arg[7:0]. QUERY_* need INVOKE; DEBUG_PRINT needs OBSERVE; ADVANCE needs REPORT. Queries take no operand; ADVANCE packs delta in [47:8] with reserved [63:48]=0. Labels prefixed pcm_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_pcm_stream_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op

        cmp rbp, 9;
        ja  pcm_hn_unsup;

        cmp rbp, 9;
        je  pcm_hn_advance_gate;

        cmp rbp, 8;
        je  pcm_hn_dbg;

        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne pcm_hn_res;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  pcm_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  pcm_hn_key;
        cmp rbp, 1;
        je  pcm_hn_clk;
        cmp rbp, 2;
        je  pcm_hn_rng;
        cmp rbp, 3;
        je  pcm_hn_fmt;
        cmp rbp, 4;
        je  pcm_hn_rat;
        cmp rbp, 5;
        je  pcm_hn_chn;
        cmp rbp, 6;
        je  pcm_hn_pos;
        call pcm_stream_row_parent;
        jmp pcm_hn_out;

      pcm_hn_advance_gate:
        mov r11, r14;
        shr r11, 48;
        cmp r11, 0;
        jne pcm_hn_res;

        mov r11, r14;
        shr r11, 8;
        mov r10, 0xFFFFFFFFFF;           // 40 bits
        and r11, r10;
        mov r15, r11;

        mov r10, r12;
        and r10, 0x002;
        cmp r10, 0;
        je  pcm_hn_denied;

        mov rdi, rbx;
        mov rsi, r15;
        call pcm_stream_position_advance;
        jmp pcm_hn_out;

      pcm_hn_key:
        call pcm_stream_row_key;
        jmp pcm_hn_out;
      pcm_hn_clk:
        call pcm_stream_row_clock;
        jmp pcm_hn_out;
      pcm_hn_rng:
        call pcm_stream_row_ring;
        jmp pcm_hn_out;
      pcm_hn_fmt:
        call pcm_stream_row_frc;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pcm_hn_out;
        and rax, 0xFF;                   // fmt
        jmp pcm_hn_out;
      pcm_hn_rat:
        call pcm_stream_row_frc;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pcm_hn_out;
        shr rax, 16;
        mov r10, 0xFFFFFF;
        and rax, r10;
        jmp pcm_hn_out;
      pcm_hn_chn:
        call pcm_stream_row_frc;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  pcm_hn_out;
        shr rax, 40;
        and rax, 0xFF;
        jmp pcm_hn_out;
      pcm_hn_pos:
        call pcm_stream_row_position;
        jmp pcm_hn_out;

      pcm_hn_dbg:
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne pcm_hn_res;
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  pcm_hn_denied;
        xor rax, rax;
        jmp pcm_hn_out;

      pcm_hn_res:
        mov rax, 0xFFFFFECE;
        jmp pcm_hn_out;
      pcm_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp pcm_hn_out;
      pcm_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      pcm_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
