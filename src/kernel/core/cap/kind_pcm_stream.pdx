// src/kernel/core/cap/kind_pcm_stream.pdx — R33.M3-001 (#1147) + R33.M3-005 (#1151)
//
// KIND_PCM_STREAM = 0x15f, derived over KIND_IPC_ENDPOINT (5).
//
// The authority to name ONE PCM stream (a session key over an endpoint,
// bound to ONE audio-clock cap slot, ONE ring buffer object, ONE sample
// format, ONE sample rate, ONE channel count). LINEAR — once minted,
// this cap cannot be re-parented; every identity field is set once and
// no primitive changes it.
//
// =============================================================================
// §0  UNITS: THE ROW IS A STREAM CONTRACT, NOT A SAMPLE STORE
// =============================================================================
//
// stream_key, audio_clock_slot, ring_bo_key, sample_format, sample_rate,
// channels and position — a stream's CONTRACT. It does NOT carry PCM
// samples: those live in the ring buffer that ring_bo_key names, and the
// producer/consumer contract for that buffer lives in
// design/ipc/pcm-ring-channel-schema.md.
//
// A ROW WHOSE audio_clock_slot COULD CHANGE would let a stream that
// was minted against HDA_BCLK be silently re-pointed at PCH_GEN — same
// samples, different phase relationship to the physical wall clock, no
// downstream consumer able to detect the change. §1 makes this
// unrepresentable: audio_clock_slot is set once at mint.
//
// =============================================================================
// §1  LINEAR — STATIC IDENTITY IS AT MINT
// =============================================================================
//
// Same discipline as `kind_audio_controller.pdx` §1 with one addition:
// this kind is a LINEAR CAPABILITY. Six fields are set once at mint and
// there is no primitive in this module that changes them; only the
// dynamic `position` counter moves, and only through
// pcm_stream_position_advance (arity ONE, capability in, one delta in,
// nothing else).
//
// The six identity fields:
//
//   * stream_key       — u64, non-zero. INHERITED from the parent
//                        endpoint's target_ptr[15:0] combined with a
//                        supplied session ordinal (bits 47:16).
//   * audio_clock_slot — u8 (cap slot 0..255). MUST name a live
//                        KIND_AUDIO_CLOCK at mint time. Consumers use
//                        this to compute presentation time; a change
//                        would silently retime a live stream.
//   * ring_bo_key      — u64, non-zero. Opaque handle to a ring
//                        buffer object.
//   * sample_format    — 1..PCM_FORMAT_MAX (see §4).
//   * sample_rate      — [PCM_CLOCK_HZ_MIN, PCM_CLOCK_HZ_MAX] Hz.
//   * channels         — 1..PCM_CHANNELS_MAX.
//
// One dynamic field:
//
//   * position         — u64, sample index. Only writer is
//                        pcm_stream_position_advance.
//
// =============================================================================
// §2  DERIVATION OVER KIND_IPC_ENDPOINT — EMPTY GATE FOR THE FIFTH TIME
// =============================================================================
//
// FIRST HALF: `cap_table[parent_slot].kind == KIND_IPC_ENDPOINT (5)`
// carrying RIGHT_MINT. Discriminates NOTHING on its own.
//
// SECOND HALF: (a) inherited endpoint id from parent target_ptr[15:0]
// must be non-zero; (b) audio_clock_slot must name a live
// KIND_AUDIO_CLOCK; (c) ring_bo_key must be non-zero; (d)
// sample_format valid; (e) sample_rate valid; (f) channels valid.
//
// UNIQUENESS: stream_key (a 64-bit hash of endpoint_id | session_id)
// must not already be held by a live row.
//
// =============================================================================
// §3  CROSS-CAP INVARIANT — #1151
// =============================================================================
//
// The same ring_bo_key MUST NOT be attached to two live KIND_PCM_STREAM
// rows whose audio_clock_slot values name DIFFERENT KIND_AUDIO_CLOCK
// capabilities. A ring buffer written by two producers at two different
// clock domains loses phase alignment silently — the samples are still
// bytes, so no lower layer refuses; the consumer sees glitches whose
// cause is invisible upstream.
//
// Enforced at mint via pcm_stream_find_conflicting_ring_clock: linear
// scan of the rows table; refuse if any live row holds the same
// ring_bo_key AND a different audio_clock_slot. Refused with
// PCM_STREAM_MINT_XCLOCK_CONFLICT (distinct code so an operator sees
// "two streams tried to share a buffer at different clocks" rather
// than a generic in-use).
//
// SAME ring, SAME clock is LEGAL — that is what stream splitting is.
//
// =============================================================================
// §4  ENUMERATIONS
// =============================================================================
//
//   sample_format:
//     0 UNKNOWN — refused
//     1 S16_LE
//     2 S24_LE_IN_32
//     3 S32_LE
//     4 F32_LE
//
// =============================================================================
// §5  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================

module KindPcmStream = structure {

  pub let KIND_PCM_STREAM : u64 = 0x15f
  pub let PCM_STREAM_PARENT_KIND : u64 = 5  // = KIND_IPC_ENDPOINT

  pub let PCM_FORMAT_UNKNOWN      : u64 = 0
  pub let PCM_FORMAT_S16_LE       : u64 = 1
  pub let PCM_FORMAT_S24_LE_IN_32 : u64 = 2
  pub let PCM_FORMAT_S32_LE       : u64 = 3
  pub let PCM_FORMAT_F32_LE       : u64 = 4
  pub let PCM_FORMAT_MAX          : u64 = 4

  pub let PCM_CHANNELS_MAX : u64 = 8       // stereo through 7.1
  pub let PCM_RATE_HZ_MIN  : u64 = 8000
  pub let PCM_RATE_HZ_MAX  : u64 = 192000

  pub let R_PCM_STREAM_READ    : u64 = 0x001
  pub let R_PCM_STREAM_REPORT  : u64 = 0x002
  pub let R_PCM_STREAM_INVOKE  : u64 = 0x008
  pub let R_PCM_STREAM_REVOKE  : u64 = 0x010
  pub let R_PCM_STREAM_OBSERVE : u64 = 0x400
  pub let R_PCM_STREAM_ALL     : u64 = 0x41B

  // Ops:
  //   0 QUERY_KEY      INVOKE   stream_key
  //   1 QUERY_CLOCK    INVOKE   audio_clock_slot
  //   2 QUERY_RING     INVOKE   ring_bo_key
  //   3 QUERY_FORMAT   INVOKE   sample_format
  //   4 QUERY_RATE     INVOKE   sample_rate
  //   5 QUERY_CHANNELS INVOKE   channels
  //   6 QUERY_POSITION INVOKE   position
  //   7 QUERY_PARENT   INVOKE   parent slot
  //   8 DEBUG_PRINT    OBSERVE
  //   9 ADVANCE        REPORT   pos += delta (packed [47:8])
  pub let PCM_STREAM_OP_QUERY_KEY      : u64 = 0
  pub let PCM_STREAM_OP_QUERY_CLOCK    : u64 = 1
  pub let PCM_STREAM_OP_QUERY_RING     : u64 = 2
  pub let PCM_STREAM_OP_QUERY_FORMAT   : u64 = 3
  pub let PCM_STREAM_OP_QUERY_RATE     : u64 = 4
  pub let PCM_STREAM_OP_QUERY_CHANNELS : u64 = 5
  pub let PCM_STREAM_OP_QUERY_POSITION : u64 = 6
  pub let PCM_STREAM_OP_QUERY_PARENT   : u64 = 7
  pub let PCM_STREAM_OP_DEBUG_PRINT    : u64 = 8
  pub let PCM_STREAM_OP_ADVANCE        : u64 = 9
  pub let PCM_STREAM_OP_MAX            : u64 = 9

  // Failure taxonomy — 0xFFFFFEC0..0xFFFFFECF.
  pub let PCM_STREAM_OK                   : u64 = 0
  pub let PCM_STREAM_TAIL_ENOSPC          : u64 = 0xFFFFFECF
  pub let PCM_STREAM_TAIL_BAD_ARG         : u64 = 0xFFFFFECE
  pub let PCM_STREAM_MINT_BAD_PARENT      : u64 = 0xFFFFFECD
  pub let PCM_STREAM_MINT_BAD_RIGHTS      : u64 = 0xFFFFFECC
  pub let PCM_STREAM_MINT_BAD_CLOCK       : u64 = 0xFFFFFECB
  pub let PCM_STREAM_MINT_BAD_RING        : u64 = 0xFFFFFECA
  pub let PCM_STREAM_MINT_BAD_FORMAT      : u64 = 0xFFFFFEC9
  pub let PCM_STREAM_MINT_BAD_RATE        : u64 = 0xFFFFFEC8
  pub let PCM_STREAM_MINT_BAD_CHANNELS    : u64 = 0xFFFFFEC7
  pub let PCM_STREAM_MINT_NO_ENDPOINT     : u64 = 0xFFFFFEC6
  pub let PCM_STREAM_MINT_ENOSPC          : u64 = 0xFFFFFEC5
  pub let PCM_STREAM_MINT_IN_USE          : u64 = 0xFFFFFEC4
  pub let PCM_STREAM_MINT_XCLOCK_CONFLICT : u64 = 0xFFFFFEC3
  pub let PCM_STREAM_BAD_SLOT             : u64 = 0xFFFFFEC2
  pub let PCM_STREAM_WRONG_KIND           : u64 = 0xFFFFFEC1
  pub let PCM_STREAM_REVOKE_ALREADY       : u64 = 0xFFFFFEC0

  pub let PCM_STREAM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PCM_STREAM_ROW_NONE : u64 = 0xFF

  // ==========================================================================
  // Table sizing and row layout — 8 rows of 64 bytes.
  //
  //   [+0]  header word (in_use[63:56], parent_slot[15:8], rest zero)
  //   [+8]  stream_key
  //   [+16] audio_clock_slot (u64 low byte used)
  //   [+24] ring_bo_key
  //   [+32] sample_format (low byte) | sample_rate (bits [39:16]) | channels (bits [47:40])
  //   [+40] position
  //   [+48] reserved
  //   [+56] reserved
  //
  // Packing bits [39:16] as sample_rate (24-bit) fits 192000. channels
  // occupies [47:40] (fits 8). This lets one word carry all three fixed
  // small fields; individual accessors mask+shift.
  // ==========================================================================

  pub let PCM_STREAM_MAX       : u64 = 8
  pub let PCM_STREAM_ROW_BYTES : u64 = 64

  pub let mut _pcm_stream_table : [u64; 64] = uninit @align(64)

  pub let mut _pcm_stream_stats : [u64; 8] = uninit @align(64)

  pub let PCM_STREAM_ST_MINTS       : u64 = 0
  pub let PCM_STREAM_ST_ADVANCES    : u64 = 1
  pub let PCM_STREAM_ST_XCLOCK      : u64 = 2
  pub let PCM_STREAM_ST_IN_USE      : u64 = 3
  pub let PCM_STREAM_ST_ENOSPC      : u64 = 4
  pub let PCM_STREAM_ST_REVOKES     : u64 = 5
  pub let PCM_STREAM_ST_MAX         : u64 = 8

  pub let pcm_dbg_msg : [u8; 16] = "PCM STREAM ROW\n\0"
  pub let pcm_k_row : [u8; 4] = "row\0"
  pub let pcm_k_key : [u8; 4] = "key\0"
  pub let pcm_k_clk : [u8; 4] = "clk\0"
  pub let pcm_k_rng : [u8; 4] = "rng\0"
  pub let pcm_k_fmt : [u8; 4] = "fmt\0"
  pub let pcm_k_rat : [u8; 5] = "rate\0"

  // ==========================================================================
  // pcm_stream_table_reset()
  // ==========================================================================

  pub let pcm_stream_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): reset rows and counters. Labels prefixed pcm_rs_.",
      block: {
        lea r10, [rip + _pcm_stream_table];
        xor rax, rax;
        xor rcx, rcx;
      pcm_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  pcm_rs_rows;

        lea r10, [rip + _pcm_stream_stats];
        xor rcx, rcx;
      pcm_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pcm_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let pcm_stream_format_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): 1 iff f in [1, PCM_FORMAT_MAX]. UNKNOWN refused. Labels prefixed pcm_fv_.",
      block: {
        cmp rdi, 0;
        je  pcm_fv_no;
        mov r10, 4;                      // PCM_FORMAT_MAX
        cmp rdi, r10;
        ja  pcm_fv_no;
        mov rax, 1;
        ret;
      pcm_fv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pcm_stream_rate_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): 1 iff r in [PCM_RATE_HZ_MIN, PCM_RATE_HZ_MAX]. Labels prefixed pcm_rv_.",
      block: {
        mov r10, 8000;
        cmp rdi, r10;
        jb  pcm_rv_no;
        mov r10, 192000;
        cmp rdi, r10;
        ja  pcm_rv_no;
        mov rax, 1;
        ret;
      pcm_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pcm_stream_channels_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): 1 iff c in [1, PCM_CHANNELS_MAX]. Labels prefixed pcm_cv_.",
      block: {
        cmp rdi, 0;
        je  pcm_cv_no;
        mov r10, 8;                      // PCM_CHANNELS_MAX
        cmp rdi, r10;
        ja  pcm_cv_no;
        mov rax, 1;
        ret;
      pcm_cv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pcm_stream_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): subset test. Labels prefixed pcm_rvv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne pcm_rvv_no;
        mov rax, 1;
        ret;
      pcm_rvv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let pcm_stream_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): increment counter. Labels prefixed pcm_nt_.",
      block: {
        cmp rdi, 8;
        jae pcm_nt_out;
        lea r10, [rip + _pcm_stream_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pcm_nt_out:
        ret
      }
    } @no_frame

  pub let pcm_stream_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): read counter. Labels prefixed pcm_st_.",
      block: {
        cmp rdi, 8;
        jae pcm_st_zero;
        lea r10, [rip + _pcm_stream_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pcm_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Derivation gate.
  // ==========================================================================

  pub let pcm_stream_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): parent must be live KIND_IPC_ENDPOINT with RIGHT_MINT. Labels prefixed pcm_cp_.",
      block: {
        cmp rdi, 256;
        jae pcm_cp_no;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne pcm_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  pcm_cp_no;

        mov rax, 1;
        ret;
      pcm_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcm_stream_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): endpoint_id from parent target_ptr[15:0]. Zero on failure. Labels prefixed pcm_pei_.",
      block: {
        cmp rdi, 256;
        jae pcm_pei_zero;
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne pcm_pei_zero;

        mov rax, [rax + 16];
        mov r11, 0xFFFF;
        and rax, r11;
        ret;
      pcm_pei_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // pcm_stream_clock_valid(audio_clock_slot) -> 1 | 0
  //
  // Delegates to audio_clock_row_of_slot; NONE means the slot is not a
  // live KIND_AUDIO_CLOCK. Refuses raw KIND_AUDIO_CONTROLLER, KIND_HW,
  // KIND_DEVICE and every other kind — the whole point is that a stream
  // is bound to a CLOCK, not a controller or a raw hardware handle.
  // ==========================================================================

  pub let pcm_stream_clock_valid : (u64) -> u64 !{mem} @{cap} =
    fn (audio_clock_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-001 (#1147): 1 iff audio_clock_slot names a live KIND_AUDIO_CLOCK. Labels prefixed pcm_kv_.",
      block: {
        push r12;
        push r13;
        push r14;
        call audio_clock_row_of_slot;
        cmp rax, 0xFF;
        je  pcm_kv_no;
        mov rax, 1;
        jmp pcm_kv_out;
      pcm_kv_no:
        xor rax, rax;
      pcm_kv_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let pcm_stream_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): pack (parent_slot << 8). Labels prefixed pcm_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae pcm_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      pcm_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_stream_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): parent_slot from bits [15:8].",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    } @no_frame

  // ==========================================================================
  // Encoded packed word (fmt + rate + channels).
  // ==========================================================================

  pub let pcm_stream_frc_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (fmt: u64, rate: u64, channels: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): pack fmt[7:0] | rate[39:16] | channels[47:40]. Refuses out-of-range values. Labels prefixed pcm_fp_.",
      block: {
        cmp rdi, 0;
        je  pcm_fp_bad;
        mov r10, 4;                      // PCM_FORMAT_MAX
        cmp rdi, r10;
        ja  pcm_fp_bad;

        mov r10, 8000;
        cmp rsi, r10;
        jb  pcm_fp_bad;
        mov r10, 192000;
        cmp rsi, r10;
        ja  pcm_fp_bad;

        cmp rdx, 0;
        je  pcm_fp_bad;
        mov r10, 8;
        cmp rdx, r10;
        ja  pcm_fp_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        shl r10, 40;
        or  rax, r10;
        ret;
      pcm_fp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let pcm_stream_frc_fmt : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): fmt from packed word bits [7:0].",
      block: { mov rax, rdi; and rax, 0xFF; ret }
    } @no_frame

  pub let pcm_stream_frc_rate : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): rate from packed word bits [39:16].",
      block: { mov rax, rdi; shr rax, 16; mov r10, 0xFFFFFF; and rax, r10; ret }
    } @no_frame

  pub let pcm_stream_frc_channels : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-001 (#1147): channels from packed word bits [47:40].",
      block: { mov rax, rdi; shr rax, 40; and rax, 0xFF; ret }
    } @no_frame

  // ==========================================================================
  // Tail alloc / free.
  // ==========================================================================

  pub let pcm_stream_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (stream_key: u64) (audio_clock_slot: u64) (ring_bo_key: u64) (frc_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): claim one PCM stream row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A STREAM'S static identity. Gates: hdr wellformed; stream_key non-zero; ring_bo_key non-zero; frc_packed != DECODE_BAD; audio_clock_slot < 256. Sets position = 0. Labels prefixed pcm_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // stream_key
        mov r14, rdx;                    // audio_clock_slot
        mov r15, rcx;                    // ring_bo_key
        // frc_packed stays in r8

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne pcm_ta_bad;

        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne pcm_ta_bad;

        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        jne pcm_ta_bad;

        cmp r13, 0;
        je  pcm_ta_bad;
        cmp r15, 0;
        je  pcm_ta_bad;

        mov r10, 256;
        cmp r14, r10;
        jae pcm_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r8, r10;
        je  pcm_ta_bad;

        xor rbx, rbx;
      pcm_ta_scan:
        cmp rbx, 8;                      // PCM_STREAM_MAX
        jae pcm_ta_enospc;

        lea r10, [rip + _pcm_stream_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pcm_ta_claim;

        add rbx, 1;
        jmp pcm_ta_scan;

      pcm_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // stream_key
        mov [r10 + 16], r14;             // audio_clock_slot
        mov [r10 + 24], r15;             // ring_bo_key
        mov [r10 + 32], r8;              // frc_packed
        xor rax, rax;
        mov [r10 + 40], rax;             // position = 0
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov rax, rbx;
        jmp pcm_ta_out;

      pcm_ta_enospc:
        mov rax, 0xFFFFFECF;             // TAIL_ENOSPC
        jmp pcm_ta_out;
      pcm_ta_bad:
        mov rax, 0xFFFFFECE;             // TAIL_BAD_ARG

      pcm_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pcm_stream_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): 1 iff row_id < PCM_STREAM_MAX and in_use. Labels prefixed pcm_tv_.",
      block: {
        cmp rdi, 8;
        jae pcm_tv_no;
        lea r10, [rip + _pcm_stream_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pcm_tv_no;
        mov rax, 1;
        ret;
      pcm_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pcm_stream_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-001 (#1147): scrub one row. Labels prefixed pcm_tf_.",
      block: {
        cmp rdi, 8;
        jae pcm_tf_out;
        lea r10, [rip + _pcm_stream_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      pcm_tf_out:
        ret
      }
    } @no_frame

