      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call pcm_stream_tail_valid;
        cmp rax, 0;
        je  pcm_rk_bad;
        lea r10, [rip + _pcm_stream_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp pcm_rk_out;
      pcm_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pcm_rk_out:
