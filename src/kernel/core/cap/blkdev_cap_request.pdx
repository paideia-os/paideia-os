// src/kernel/core/cap/blkdev_cap_request.pdx -- R51.M8-001 (#1675).
//
// Mount syscall wire-through for KIND_BLKDEV.
//
// Design context
// --------------
// design/hardware/nvme-ahci-tail-milestones.md §2.M8 #1675 (anchor:
// substrate §7.M8-001; softarch companion §3.1). R51.M8-001's
// responsibility is narrowly the KIND_BLKDEV half of the mount wire:
//
//   userspace mount tool
//     -> blkdev_cap_request(bdev_id)                    (THIS FILE)
//       -> supervisor mints a fresh KIND_BLKDEV cap in the caller's
//          cspace, contingent on the target device's attestation
//          posture (substrate §5.4)
//     -> R52 mount syscall MOUNT_BACKEND_PDXFS_BLOCK    (R52.M5-005,
//        not this repo's concern -- softarch owns everything past
//        the cap handoff)
//       -> R52 probe.pdx opens block-0 via BDEV_OP_READ_LBA
//       -> R52 volume_registry indexes by UUID
//
// `bdev_id` is an opaque u64 the design doc explicitly leaves
// "R52 owns the shape" of (substrate/tail-milestones §2.M8 #1675
// "New file" bullet). This file treats it as an arbitrary non-zero
// key resolved through a small registration table
// (`_blkdev_index_table`, 16 rows) rather than parsing any UUID
// structure itself.
//
// Upstream landing state at this commit (2026-08-23)
// ----------------------------------------------------
// R51.M7-001 (#1669), M7-002 (#1670), M7-003 (#1671) are landed.
// M7-004 (#1672, unified cap_handler_blkdev family dispatch) is
// ALREADY functionally present in cap_handler_blkdev.pdx (folded in
// incrementally across M6-004/M6-005/M7-002, see that file's own
// header) even though no commit carries the #1672 number explicitly.
// M7-005 (#1673, pdxfs/nvme_write.pdx -> bdev_write.pdx rename) and
// M7-006 (#1674, cross-family witness) have NOT landed as of this
// commit -- src/kernel/core/fs/pdxfs/nvme_write.pdx still exists
// under its R42 name. Per the issuing task's explicit guidance, this
// file does not depend on either: #1673 is an FS-layer rename that
// never touches the cap layer this file lives in, and #1674 is a
// witness-only issue. Both are orthogonal to the KIND_BLKDEV mint
// wire below.
//
// Residual gaps (flagged, not closed, by this commit)
// -----------------------------------------------------
// (1) Nothing yet CALLS `blkdev_index_register` at boot. The design
//     doc describes the index as "populated at mint time from the
//     parent controller's identify-serial" -- that requires touching
//     kind_nvme_namespace.pdx's `nvme_ns_dual_kind_mint` and
//     kind_ahci_port.pdx's `ahci_port_dual_kind_mint` call sites,
//     which design/hardware/nvme-ahci-tail-milestones.md §5.1's file
//     layout table does NOT list as extended by M8-001 (only the new
//     file in §5.2 is claimed). Left for a follow-up issue, matching
//     this codebase's own precedent of landing a narrower slice than
//     the design sketch and documenting the gap explicitly (e.g.
//     blkdev_cap.pdx's own header on #1671's narrower scope relative
//     to the design doc's `blkdev_cap_mint_from_{nvme,ahci}` sketch).
// (2) Every KIND_NVME_NAMESPACE / KIND_AHCI_PORT row minted today
//     stamps `attest_key = 0` unconditionally (kind_nvme_namespace.pdx
//     nvme_ns_cap_mint_inner, kind_ahci_port.pdx's mirror) -- the
//     KIND_DMA_ATTESTATION consent gate substrate §5.4 describes is
//     not yet wired into either mint path. Consequence: today, EVERY
//     device fails `blkdev_cap_request` with MOUNTW_ATTEST_MISSING
//     once registered -- that is the CORRECT behavior given the
//     current attestation posture, not a bug in this file.
// (3) MOUNTW_ELEVATE_REFUSED is defined (design doc's exact value)
//     but not yet gated on anything: no founder/non-founder identity
//     concept exists anywhere in the kernel yet (no TCB field, no
//     elevate-broker integration reachable from this cap-request
//     path). Reserved for when that substrate lands, matching the
//     many "reserved, unused-yet" failure slots elsewhere in this
//     codebase (e.g. BDEVU_TAIL_ENOSPC in kind_blkdev.pdx).
//
// Failure taxonomy (design §7: 0xFFFFECE0..0xFFFFECEF, MOUNTW band --
// M8-001..M8-003, M8-005; M8-004/M8-006 claim 0xFFFFECF0..FF
// separately). This file claims the three M8-001 codes the design
// doc names verbatim, plus three extra codes within the SAME
// declared band for the index-table plumbing the design doc doesn't
// itself number (mirrors BDEV_ERR_BAD_FAMILY being added within an
// already-declared band at M7-004):
//
//   MOUNTW_BAD_BDEV_ID     0xFFFFECE0  design-named (§2.M8 #1675)
//   MOUNTW_ATTEST_MISSING  0xFFFFECE1  design-named
//   MOUNTW_ELEVATE_REFUSED 0xFFFFECE2  design-named (reserved, see gap 3)
//   MOUNTW_INDEX_BAD_ARG   0xFFFFECE7  this commit (register: bdev_id==0
//                                       or family outside {1,2})
//   MOUNTW_INDEX_ENOSPC    0xFFFFECE8  this commit (16-row table full)
//   -ENFILE (0xFFFFFFFFFFFFFFDF)       cap_table free-slot scan
//                                       exhausted -- matches
//                                       sys_pdxfs_txn_open_body's own
//                                       precedent for the identical
//                                       256-slot scan.
//
// _blkdev_index_table layout (16 rows x 2 u64 words, 256 bytes)
// -----------------------------------------------------------------
//   +0  bdev_id     (u64, opaque, non-zero when in_use)
//   +8  packed      bit63 = in_use
//                   bits[23:16] = family (1=NVME, 2=AHCI)
//                   bits[15:0]  = row_id into _nvme_namespace_table
//                                 or _ahci_port_table
// The low 24 bits of the packed word are DELIBERATELY the same shape
// as a KIND_BLKDEV cap descriptor's own target_ptr (row_id[15:0] |
// family[23:16], cap_handler_blkdev.pdx §Family-byte demux) so a
// successful lookup's return value feeds directly into
// kind_blkdev.pdx's `blkdev_row_attest_key` with no re-packing.
//
// blkdev_cap_request sequence
// -----------------------------------------------------------------
//   (1) blkdev_index_lookup(bdev_id) -> packed target_ptr or
//       MOUNTW_BAD_BDEV_ID.
//   (2) blkdev_row_attest_key(packed) -> attest_key. BDEVU_DECODE_BAD
//       (defensive; register() already refuses family outside {1,2})
//       maps to MOUNTW_BAD_BDEV_ID; attest_key == 0 maps to
//       MOUNTW_ATTEST_MISSING (see gap 2 above).
//   (3) Free-slot scan over the 256-slot cap_table (verbatim copy of
//       sys_pdxfs_txn_open.pdx Step (2)'s shift-add slot*24 idiom, no
//       imul) -> free slot or -ENFILE.
//   (4) family==2 (AHCI) -> blkdev_cap_mint_ahci(slot, R_BLK_ALL,
//       row_id); else -> blkdev_cap_mint_nvme(slot, R_BLK_ALL,
//       row_id). R_BLK_ALL (0x1F, blkdev_cap.pdx) is the design doc's
//       "R_BLK_ALL_R51" -- the actual landed constant name is
//       R_BLK_ALL since R51.M4-001 (#1651) widened it in place rather
//       than introducing a parallel name; reconciled here the same
//       way #1671's header reconciles other design-vs-code naming
//       drift.
//   (5) Return the cap slot.
//
// paideia-as encoder-gap posture (v0.22.x)
// ----------------------------------------
//   G1: no sub-8-byte field access in this file -- every table field
//       is a plain 64-bit word; mov_b is not needed.
//   G4: every sentinel comparison against a value with bit 63 or bit
//       31 set is staged through `mov r1x, <imm>; cmp reg, r1x`
//       rather than `cmp reg, <imm>` directly (imm32 operands to cmp
//       sign-extend; matches cap_handler_blkdev.pdx's own documented
//       posture).
//
// Arity <= 6 throughout (blkdev_index_register takes 3; blkdev_cap_
// request takes 1). Reserved-label discipline: every label in this
// file is prefixed `bcr_`.

module BlkdevCapRequest = structure {

  // ============================================================================
  // Failure taxonomy (design §7, MOUNTW band 0xFFFFECE0..0xFFFFECEF)
  // ============================================================================

  pub let MOUNTW_BAD_BDEV_ID     : u64 = 0xFFFFECE0
  pub let MOUNTW_ATTEST_MISSING  : u64 = 0xFFFFECE1
  pub let MOUNTW_ELEVATE_REFUSED : u64 = 0xFFFFECE2
  pub let MOUNTW_INDEX_BAD_ARG   : u64 = 0xFFFFECE7
  pub let MOUNTW_INDEX_ENOSPC    : u64 = 0xFFFFECE8

  // ============================================================================
  // _blkdev_index_table: 16 rows x 2 u64 words (256 bytes).
  // ============================================================================

  pub let BLKDEV_IDX_MAX : u64 = 16
  pub let mut _blkdev_index_table : [u64; 32] = uninit @align(64)

  // ============================================================================
  // blkdev_index_table_reset() -> ()
  // ============================================================================
  pub let blkdev_index_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M8-001 (#1675): zero every row of _blkdev_index_table (32 u64 words = 16 rows x 2 words). Matches elevate_channel_table_reset's own loop shape (kind_elevate_channel.pdx). No nested calls -- no alignment discipline needed. Labels prefixed bcr_rs_.",
      block: {
        lea r10, [rip + _blkdev_index_table];
        xor rax, rax;
        xor rcx, rcx;
      bcr_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  bcr_rs_loop;
        ret
      }
    }

  // ============================================================================
  // blkdev_index_register(bdev_id, family, row_id) -> slot | MOUNTW_INDEX_*
  // ============================================================================
  //
  // THE ONLY WRITER of _blkdev_index_table. Not yet called from any
  // boot-time mint path (see module header, residual gap (1)) --
  // exists so a future patch (or a synth fixture) can populate the
  // table without touching this file again.
  pub let blkdev_index_register : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (bdev_id: u64) (family: u64) (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M8-001 (#1675): claim one _blkdev_index_table row. Gates: bdev_id == 0 -> MOUNTW_INDEX_BAD_ARG; family outside {1,2} -> MOUNTW_INDEX_BAD_ARG (defensive -- only NVME(1)/AHCI(2) dual-kind mints ever produce a KIND_BLKDEV row worth indexing; LEGACY_NVME(0) rides the R24 compat-shim mint, which has no row worth resolving this way). Low-first scan over 16 rows, table full -> MOUNTW_INDEX_ENOSPC. Four callee-save pushes (rbx=bdev_id, r12=family, r13=row_id, r14=scan idx) preserve all three args + the scan counter; this function makes no nested `call`, so the SysV 16-byte stack-alignment-at-call rule does not apply here (no padding needed regardless of push count). Labels prefixed bcr_ir_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // bdev_id
        mov r12, rsi;                    // family
        mov r13, rdx;                    // row_id

        cmp rbx, 0;
        je  bcr_ir_bad;

        cmp r12, 1;
        je  bcr_ir_family_ok;
        cmp r12, 2;
        jne bcr_ir_bad;
      bcr_ir_family_ok:

        xor r14, r14;                    // scan idx
      bcr_ir_scan:
        cmp r14, 16;
        jae bcr_ir_enospc;

        lea r10, [rip + _blkdev_index_table];
        mov r11, r14;
        shl r11, 4;                      // row * 16 bytes
        add r10, r11;

        mov rax, [r10 + 8];
        shr rax, 63;
        cmp rax, 0;
        je  bcr_ir_claim;

        add r14, 1;
        jmp bcr_ir_scan;

      bcr_ir_claim:
        mov [r10 + 0], rbx;              // bdev_id
        mov rax, 1;
        shl rax, 63;                     // in_use
        mov r11, r12;
        and r11, 0xFF;
        shl r11, 16;
        or  rax, r11;                    // | family << 16
        mov r11, r13;
        and r11, 0xFFFF;
        or  rax, r11;                    // | row_id
        mov [r10 + 8], rax;
        mov rax, r14;
        jmp bcr_ir_out;

      bcr_ir_enospc:
        mov rax, 0xFFFFECE8;             // MOUNTW_INDEX_ENOSPC
        jmp bcr_ir_out;

      bcr_ir_bad:
        mov rax, 0xFFFFECE7;             // MOUNTW_INDEX_BAD_ARG

      bcr_ir_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // blkdev_index_lookup(bdev_id) -> packed_target_ptr | MOUNTW_BAD_BDEV_ID
  // ============================================================================
  //
  // packed_target_ptr low 24 bits = family[23:16] | row_id[15:0] --
  // the same shape as a KIND_BLKDEV cap descriptor's target_ptr, so
  // the caller can feed the result straight into kind_blkdev.pdx's
  // blkdev_row_* accessors.
  pub let blkdev_index_lookup : (u64) -> u64 !{mem} @{} =
    fn (bdev_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M8-001 (#1675): low-first scan over 16 rows; a row counts as a hit only when in_use (bit 63 of word+8) is set AND word+0 == bdev_id. Returns the packed family|row_id (low 24 bits of word+8) on hit, MOUNTW_BAD_BDEV_ID on miss. Two callee-save pushes (rbx=bdev_id, r12=scan idx); no nested calls. Labels prefixed bcr_lu_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // bdev_id
        xor r12, r12;                    // scan idx

      bcr_lu_scan:
        cmp r12, 16;
        jae bcr_lu_miss;

        lea r10, [rip + _blkdev_index_table];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;

        mov rax, [r10 + 8];              // packed word
        mov rcx, rax;
        shr rcx, 63;
        cmp rcx, 0;
        je  bcr_lu_next;

        mov rcx, [r10 + 0];              // bdev_id at this row
        cmp rcx, rbx;
        jne bcr_lu_next;

        // Hit: return low 24 bits of the packed word (family|row_id).
        mov r11, 0xFFFFFF;
        and rax, r11;
        jmp bcr_lu_out;

      bcr_lu_next:
        add r12, 1;
        jmp bcr_lu_scan;

      bcr_lu_miss:
        mov rax, 0xFFFFECE0;             // MOUNTW_BAD_BDEV_ID

      bcr_lu_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // blkdev_cap_request(bdev_id) -> cap_slot | MOUNTW_* | -ENFILE
  // ============================================================================
  //
  // The ring-3-facing (via the syscall dispatch shim, see
  // src/kernel/core/syscall/dispatch.pdx sysno 74) KIND_BLKDEV
  // constructor for a mount tool. See module header for the full
  // sequence + residual-gap posture.
  pub let blkdev_cap_request : (u64) -> u64 !{mem} @{cap} =
    fn (bdev_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M8-001 (#1675): compose blkdev_index_lookup + blkdev_row_attest_key + a cap_table free-slot scan (verbatim shift-add shape from sys_pdxfs_txn_open_body, cap/kind_pdxfs_txn.pdx's sibling syscall body) + blkdev_cap_mint_{nvme,ahci} into a single mount-facing entry point. Five callee-save pushes (r12=packed target_ptr, r13=free slot idx, r14=row_id, r15=family, rbp=bdev_id) leave rsp%16 == 0 (entry rsp%16==8 -> 8+40=48, %16==0 -- no extra pad needed, matching the '5-push' idiom). Mint-side row lookup errors (MOUNTW_BAD_BDEV_ID, MOUNTW_ATTEST_MISSING) propagate as 0xFFFFECEx sentinels per the design doc's own MOUNTW band; cap_table exhaustion returns -ENFILE (-33) matching sys_pdxfs_txn_open_body's identical scan. Rights hard-coded to R_BLK_ALL (0x1F) -- the design doc's 'R_BLK_ALL_R51' is this constant under its actual landed name (blkdev_cap.pdx, widened in place at R51.M4-001/#1651 rather than given a parallel name). MOUNTW_ELEVATE_REFUSED is NOT gated here -- no founder/non-founder identity substrate exists yet to gate on (module header residual gap 3); the constant is reserved for when that lands. Labels prefixed bcr_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbp, rdi;                    // bdev_id

        // ---- Step (1): resolve bdev_id -> packed target_ptr. ----
        mov rdi, rbp;
        call blkdev_index_lookup;
        mov r10, 0xFFFFECE0;             // MOUNTW_BAD_BDEV_ID
        cmp rax, r10;
        je  bcr_out;                     // propagate verbatim

        mov r12, rax;                    // packed target_ptr

        // ---- Step (2): attestation gate. ----
        mov rdi, r12;
        call blkdev_row_attest_key;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // BDEVU_DECODE_BAD (defensive)
        cmp rax, r10;
        je  bcr_bad_bdev;
        cmp rax, 0;
        je  bcr_attest_missing;

        // ---- Step (3): free-slot scan over cap_table (256 slots). ----
        xor r13, r13;                    // slot idx
      bcr_scan:
        mov r10, 256;
        cmp r13, r10;
        jae bcr_enfile;
        mov r10, r13;
        shl r10, 3;
        mov r11, r13;
        shl r11, 4;
        add r10, r11;                    // slot * 24
        lea rax, [rip + cap_table];
        add rax, r10;
        mov rcx, [rax + 0];              // kind (u64)
        cmp rcx, 0;                      // KIND_NULL
        je  bcr_slot_found;
        add r13, 1;
        jmp bcr_scan;

      bcr_slot_found:
        // ---- Step (4): dispatch mint by family. ----
        mov r14, r12;
        and r14, 0xFFFF;                 // row_id
        mov r15, r12;
        shr r15, 16;
        and r15, 0xFF;                   // family

        cmp r15, 2;                      // family == AHCI?
        je  bcr_mint_ahci;

        mov rdi, r13;                    // slot
        mov rsi, 0x1F;                   // R_BLK_ALL
        mov rdx, r14;                    // row_id
        call blkdev_cap_mint_nvme;
        jmp bcr_mint_done;

      bcr_mint_ahci:
        mov rdi, r13;                    // slot
        mov rsi, 0x1F;                   // R_BLK_ALL
        mov rdx, r14;                    // row_id
        call blkdev_cap_mint_ahci;

      bcr_mint_done:
        mov rax, r13;                    // cap slot
        jmp bcr_out;

      bcr_attest_missing:
        mov rax, 0xFFFFECE1;             // MOUNTW_ATTEST_MISSING
        jmp bcr_out;

      bcr_bad_bdev:
        mov rax, 0xFFFFECE0;             // MOUNTW_BAD_BDEV_ID
        jmp bcr_out;

      bcr_enfile:
        mov rax, 0xFFFFFFFFFFFFFFDF;     // -ENFILE

      bcr_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
