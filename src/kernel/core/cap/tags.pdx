  // KIND_IPC_ENDPOINT -- the shell's stdout included -- so per-session
  // events would be drowned in generic endpoint chatter otherwise.
  pub let cap_mbim_session_msg : [u8; 58] = "MBIM session invocation [legacy: CAP INVOKE MBIM_SESSION]\0"

  // R39.M1-002 (#1324): KIND_BT_ADAPTER dispatch chatter.  Its own tag
