  // ordinary PCI configuration access -- most KIND_DEVICE traffic is
  // one of those, and BT adapter events fire on a per-adapter timeline
  // whose signal is drowned in device chatter otherwise.
  pub let cap_bt_adapter_msg : [u8; 61] = "Bluetooth adapter invocation [legacy: CAP INVOKE BT_ADAPTER]\0"

  // R39.M1-003 (#1325): KIND_BT_HCI_CHANNEL dispatch chatter.  Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because an operator debugging an HCI transport bring-up (which
  // channel was minted, at what direction / packet_type, bound to
  // which adapter) needs a trace that separates HCI-channel-capability
