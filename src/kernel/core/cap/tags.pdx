  pub let cap_vello_renderer_msg : [u8; 62] = "Vello renderer invocation [legacy: CAP INVOKE VELLO_RENDERER]\0"

  // G6.M1-001 (#1509): KIND_COLOR_PROFILE dispatch chatter. Its own
  // tag rather than sharing the KIND_MEMORY one it derives from,
  // because an operator debugging color-management regressions
  // (wrong CICP triplet, ICC profile mismatch, gamut clipping) needs
  // a per-profile trace separate from generic page-authority chatter.
  pub let cap_color_profile_msg : [u8; 60] = "color profile invocation [legacy: CAP INVOKE COLOR_PROFILE]\0"

  // R48.M1-001 (#1517): KIND_USER dispatch chatter. Its own tag
  // rather than sharing the KIND_HW one it derives from, because an
  // operator debugging identity regressions (a delegation refused, a
  // cascade that reached too far, a quota query returning nonsense)
  // needs a per-user trace separate from generic hardware-cap
  // chatter.
  pub let cap_user_msg : [u8; 51] = "user identity invocation [legacy: CAP INVOKE USER]\0"

  // R48b substrate-prep (#1626): KIND_ELEVATE_CHANNEL dispatch
  // chatter. Its own tag rather than sharing the KIND_IPC one it
  // derives from, because an operator debugging elevation regressions
  // (a request refused, an approve that reached the wrong kind, an
  // expiry timer that fired early) needs a per-channel trace separate
  // from generic endpoint chatter.
  pub let cap_elevate_channel_msg : [u8; 57] = "elevate channel invocation [legacy: CAP INVOKE ELV CHAN]\0"

  // R48b substrate-prep (#1623): KIND_PDXFS_FILE dispatch chatter.
  // Its own tag rather than sharing the KIND_PAGE one it derives
  // from, because an operator debugging file-authority regressions
  // (an inode revoke that reached too far, a length query returning
  // stale bytes) needs a per-file trace separate from generic page
  // chatter.
  pub let cap_pdxfs_file_msg : [u8; 54] = "PDXFS file invocation [legacy: CAP INVOKE PDXFS FILE]\0"

  // R48b substrate-prep (#1624): KIND_PDXFS_TXN dispatch chatter.
  // Its own tag rather than sharing the KIND_PAGE one it derives
  // from, because an operator debugging transaction regressions
  // (a commit that landed against the wrong WAL group, an abort
  // that leaked bytes) needs a per-txn trace separate from generic
  // page chatter.
  pub let cap_pdxfs_txn_msg : [u8; 52] = "PDXFS txn invocation [legacy: CAP INVOKE PDXFS TXN]\0"

  // R30-PREP (#1631): KIND_TTY dispatch chatter.  Its own tag rather
  // than sharing the KIND_IPC one it derives from, because an
  // operator debugging shell / cat / ls output regressions (a write
  // ack dropped, a rows/cols query returning stale dimensions after
  // a resize) needs a per-sink trace separate from generic endpoint
  // chatter.
  pub let cap_tty_msg : [u8; 40] = "tty invocation [legacy: CAP INVOKE TTY]\0"

  // R51.M1-001 (#1633): KIND_NVME_CONTROLLER dispatch chatter.  Its
  // own tag rather than sharing the KIND_DEVICE one it derives from,
  // because an operator debugging NVMe substrate regressions (a
  // controller mint refused, a bring-up timeout, an IDENTIFY that
  // returned zero namespaces on a drive that visibly has some) needs
  // a per-controller trace separate from generic device chatter.
  pub let cap_nvme_controller_msg : [u8; 58] = "NVMe controller invocation [legacy: CAP INVOKE NVME CTRL]\0"

  // R51.M2-001 (#1639): KIND_NVME_NAMESPACE dispatch chatter.  Its
  // own tag rather than sharing cap_nvme_controller_msg (which names
  // the PARENT authority) or cap_mem_msg (which both KIND_BLKDEV and
  // KIND_NVME_NAMESPACE inherit from as base slot 4), because an
  // operator debugging namespace substrate regressions -- a mint
  // refused because the parent controller had no MINT_NS, a dual-
  // kind mint that stamped only one of the two descriptors, a
  // cascade revoke that reached the wrong controller's namespaces --
  // needs a per-namespace trace separate from generic controller /
  // page chatter.  Companion to cap_nvme_controller_msg for the M2
  // milestone.
  pub let cap_nvme_namespace_msg : [u8; 55] = "NVMe namespace invocation [legacy: CAP INVOKE NVME NS]\0"
}
