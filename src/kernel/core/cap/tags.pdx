// src/kernel/core/cap/tags.pdx — R12 dispatch architecture tag strings
//
// Thirteen .rodata tag symbols used as the `tag_ptr` argument to
// klog_s1(level, subsys, tag) by the per-kind cap-invoke handlers
// (kind_page.pdx, kind_ipc.pdx, kind_ipc_port.pdx, kind_sched.pdx, kind_dev.pdx, kind_thread.pdx, kind_timer.pdx, kind_notification.pdx, kind_interrupt.pdx, kind_reply.pdx, kind_process.pdx)
// and by cap_dispatch_smoke's success path (m5-001). Each string is
// NUL-terminated because klog_emit_core copies bytes until NUL (see
// src/kernel/core/klog/emit.pdx step 9); the emitter appends its own
// newline after the tag. Trailing `\n` was stripped and every array size
// shrunk by 1 during M7-001 (#698); do NOT re-add the `\n`.
//
// Byte counts (NUL-inclusive, post-M7-001):
//   cap_mem_msg          15   "CAP INVOKE MEM\0"
//   cap_ipc_msg          15   "CAP INVOKE IPC\0"
//   cap_port_msg         16   "CAP INVOKE PORT\0"
//   cap_dev_msg          15   "CAP INVOKE DEV\0"
//   cap_sched_msg        17   "CAP INVOKE SCHED\0"
//   cap_thread_msg       18   "CAP INVOKE THREAD\0"
//   cap_timer_msg        17   "CAP INVOKE TIMER\0"
//   cap_notif_msg        17   "CAP INVOKE NOTIF\0"
//   cap_int_msg          15   "CAP INVOKE INT\0"
//   cap_reply_msg        17   "CAP INVOKE REPLY\0"
//   cap_proc_msg         16   "CAP INVOKE PROC\0"
//   cap_dispatch_ok_msg  16   "CAP DISPATCH OK\0"
//   cap_denied_msg       11   "CAP DENIED\0"
//   cap_dmesg_msg        17   "CAP INVOKE DMESG\0"     (logging-m9-001 #708)
//   cap_hw_int_msg       18   "CAP INVOKE HW_INT\0"    (R29.M1-001 #1019)
//   cap_hw_msix_msg      19   "CAP INVOKE HW_MSIX\0"   (R29.M1-004 #1022)
//   cap_dma_dom_msg      22   "CAP INVOKE DMA_DOMAIN\0" (R29.M5-001 #1036)
//   cap_opreg_msg        21   "CAP INVOKE OP_REGION\0"  (R30.M3-001 #1061)
//
// Handlers reference symbols as flat globals: `lea rdi, [rip + cap_X_msg]`.
//
// History: fallback B (strings in tools/boot_stub.S) was applied for
// r12-m1-002 because paideia-as v0.11.0+19 dropped the IrKind::StringLiteral
// branch in cmd_build.rs's Let-RHS data-table cascade. Fixed by paideia-as
// #910 (commit 26ba157); tags.pdx reverted to inline form here.
//
// Audit: design/audit/entries/r12-m1-002-dispatch-arch.md
//        design/audit/entries/r12-m1-003-tags-fallback-b.md (resolved)
//        design/audit/entries/r13-m6-006-kind-interrupt-notification.md

module Tags = structure {
  pub let cap_mem_msg : [u8; 15] = "CAP INVOKE MEM\0"
  pub let cap_ipc_msg : [u8; 15] = "CAP INVOKE IPC\0"
  pub let cap_port_msg : [u8; 16] = "CAP INVOKE PORT\0"
  pub let cap_dev_msg : [u8; 15] = "CAP INVOKE DEV\0"
  pub let cap_sched_msg : [u8; 17] = "CAP INVOKE SCHED\0"
  pub let cap_thread_msg : [u8; 18] = "CAP INVOKE THREAD\0"
  pub let cap_timer_msg : [u8; 17] = "CAP INVOKE TIMER\0"
  pub let cap_notif_msg : [u8; 17] = "CAP INVOKE NOTIF\0"
  pub let cap_int_msg : [u8; 15] = "CAP INVOKE INT\0"
  pub let cap_reply_msg : [u8; 17] = "CAP INVOKE REPLY\0"
  pub let cap_proc_msg : [u8; 16] = "CAP INVOKE PROC\0"
  pub let cap_dispatch_ok_msg : [u8; 16] = "CAP DISPATCH OK\0"
  pub let cap_denied_msg : [u8; 11] = "CAP DENIED\0"
  // logging-m9-001 (#708): KIND_DMESG dispatch chatter.
  pub let cap_dmesg_msg : [u8; 17] = "CAP INVOKE DMESG\0"
  // R29.M1-001 (#1019): KIND_HW_INTERRUPT dispatch chatter. Distinct
  // from cap_int_msg (=15 bytes "CAP INVOKE INT\0") which belongs to
  // the pre-R29 slot-9 KIND_INTERRUPT legacy stub (kind_interrupt.pdx,
  // preserved as compatibility alias until R30 open per
  // design/architecture/next-wave-derived-kinds.md §KIND_HW_INTERRUPT).
  pub let cap_hw_int_msg : [u8; 18] = "CAP INVOKE HW_INT\0"
  // R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR dispatch chatter. Distinct
  // from cap_hw_int_msg to keep the parent (KIND_HW_INTERRUPT) and
  // child (KIND_HW_MSIX_VECTOR) invocations telemetrically separable
  // in the boot log — the two share the KIND_HW base slot 14 but have
  // separate derived-kind tags (0x140 vs 0x141) and separate handlers.
  pub let cap_hw_msix_msg : [u8; 19] = "CAP INVOKE HW_MSIX\0"
  // R29.M5-001 (#1036): KIND_DMA_DOMAIN dispatch chatter. Distinct from
  // cap_mem_msg ("CAP INVOKE MEM") even though both caps share base slot
  // 4 (KIND_MEMORY = KIND_PAGE): the base kind is the derivation root,
  // but a DMA-domain invocation and a plain page invocation are
  // different authority events and must stay telemetrically separable.
  // The per-field record printed by dma_domain_debug_print uses its own
  // tag ("DMA DOMAIN ROW", declared in kind_dma_domain.pdx) so dispatch
  // chatter and field dumps never interleave under one tag.
  pub let cap_dma_dom_msg : [u8; 22] = "CAP INVOKE DMA_DOMAIN\0"
  // R30.M3-001 (#1061): KIND_OP_REGION dispatch chatter. This kind is
  // the one whose invocations an operator most wants to be able to grep
  // for in isolation — it is the handle that authorises touching a
  // physical address — so it gets its own tag rather than sharing
  // cap_mem_msg or cap_ipc_port_msg with the base kinds it derives over.
  // The per-field record printed by opregion_debug_print uses its own
  // tag ("OP REGION ROW", declared in kind_op_region.pdx) so dispatch
  // chatter and row dumps never interleave under one tag.
  pub let cap_opreg_msg : [u8; 21] = "CAP INVOKE OP_REGION\0"

  // R30.M4-003 (#1068): KIND_ACPI_EVENT dispatch chatter. Its own tag
  // rather than sharing cap_opreg_msg or the KIND_HW_INTERRUPT tag it
  // derives from, for the same reason KIND_OP_REGION has one: this is
  // the handle that authorises being told about platform events and
  // acknowledging them — which re-enables hardware sources — and an
  // operator reconstructing why a GPE was unmasked needs to grep for
  // exactly these invocations without the parent kind's traffic mixed
  // in. The row dump uses its own tag ("ACPI EVENT ROW", declared in
  // kind_acpi_event.pdx) so dispatch chatter and row dumps never
  // interleave under one label.
  pub let cap_acpi_evt_msg : [u8; 22] = "CAP INVOKE ACPI_EVENT\0"

  // R30.M5-001 (#1070): KIND_I2C_BUS dispatch chatter. Its own tag
  // rather than sharing the KIND_DEVICE tag it derives over, because
  // the two authorities answer different questions: the device
  // capability is "may this component touch the controller's
  // registers", the bus capability is "may this component hand out
  // reach to the devices behind it". An operator reconstructing how a
  // driver came to be talking to a peripheral needs the second trace
  // without the first mixed in. The row dump uses its own tag
  // ("I2C BUS ROW", declared in kind_i2c_bus.pdx) so dispatch chatter
  // and row dumps never interleave under one label.
  pub let cap_i2c_bus_msg : [u8; 19] = "CAP INVOKE I2C_BUS\0"

  // R30.M5-002 (#1071): KIND_I2C_SLAVE dispatch chatter. Separate from
  // cap_i2c_bus_msg for the reason the whole milestone exists: I2C is a
  // shared bus, and "which capability invoked" is the only record that
  // distinguishes the touchpad driver addressing the touchpad from the
  // touchpad driver addressing the fingerprint reader. Folding the two
  // kinds under one tag would erase exactly the distinction the
  // per-device capability was introduced to create. Row dumps use
  // "I2C SLAVE ROW", declared in kind_i2c_slave.pdx.
  pub let cap_i2c_slave_msg : [u8; 21] = "CAP INVOKE I2C_SLAVE\0"

  // R30.M6-001 (#1075): KIND_GPIO_LINE dispatch chatter. Its own tag for
  // the same reason the I2C pair have theirs, with the stakes raised: a
  // pad controller owns every pin on the package, so "which line
  // capability invoked" is the only record that distinguishes a driver
  // touching the pin it owns from a driver touching a device reset, a
  // rail enable or a write-protect strap. Nothing else in the machine
  // will report the difference -- a pin has no acknowledgement and no
  // error path -- so this trace is the whole of the forensic record.
  // Row dumps use "GPIO LINE ROW", declared in kind_gpio_line.pdx.
  pub let cap_gpio_line_msg : [u8; 21] = "CAP INVOKE GPIO_LINE\0"

  // R31.M1-002 (#1090): KIND_EC_QUERY dispatch chatter. Its own tag
  // rather than sharing the KIND_ACPI_EVENT one it feeds, because the
  // two answer different questions and an operator needs them apart. The
  // event capability's trace says "somebody drained the platform event
  // stream"; this one says "somebody interrogated or narrowed a standing
  // subscription to an embedded controller". On this device the second
  // is the interesting line: a subscription that quietly stops wanting
  // the lid event is indistinguishable, from the stream's side, from a
  // lid that stopped firing, and the only record that separates them is
  // the one made when the narrowing happened. Row dumps use
  // "EC QUERY ROW", declared in kind_ec_query.pdx, so dispatch chatter
  // and row dumps never interleave under one label.
  pub let cap_ec_query_msg : [u8; 20] = "CAP INVOKE EC_QUERY\0"

  // R31.M2-001 (#1094): KIND_THERMAL_ZONE dispatch chatter. Its own tag
  // rather than sharing the KIND_DEVICE one it derives from, for the
  // reason cap_i2c_slave_msg gives: folding a derived kind under its
  // parent's label erases exactly the distinction the derived kind was
  // introduced to create. Here the distinction is sharper than usual --
  // "somebody read a PCI function's configuration" and "somebody
  // submitted a temperature against a critical threshold" are not the
  // same event, and only the second one can end with the machine off.
  // Row dumps use "THERMAL ZONE ROW", declared in kind_thermal_zone.pdx,
  // so dispatch chatter and row dumps never interleave under one label.
  pub let cap_thermal_zone_msg : [u8; 24] = "CAP INVOKE THERMAL_ZONE\0"

  // R31.M3-001 (#1099): KIND_BATTERY dispatch chatter. Its own tag
  // rather than sharing the KIND_DEVICE one it derives from, for the
  // reason cap_thermal_zone_msg has one: folding a derived kind under
  // its parent's label erases exactly the distinction the derived kind
  // was introduced to create. Here the distinction is "somebody read a
  // PCI function's configuration" versus "somebody pushed a new
  // percent, voltage and state for the pack whose static identity this
  // row holds", and only the second event has the shape a future
  // shutdown consumer will filter on. Row dumps use "BATTERY ROW",
  // declared in kind_battery.pdx, so dispatch chatter and row dumps
  // never interleave under one label.
  pub let cap_battery_msg : [u8; 19] = "CAP INVOKE BATTERY\0"

  // R31.M4-001 (#1103): KIND_COOLING_DEVICE dispatch chatter. Its own
  // tag rather than sharing the KIND_DEVICE one it derives from, for
  // the reason cap_battery_msg has one: folding a derived kind under
  // its parent's label erases exactly the distinction the derived
  // kind was introduced to create. Here the distinction is "somebody
  // read a PCI function's configuration" versus "somebody pushed a
  // new state ordinal for the actuator whose static identity this
  // row holds", and only the second event has the shape a future
  // cooling policy consumer will filter on. Row dumps use
  // "COOLING ROW", declared in kind_cooling_device.pdx.
  pub let cap_cooling_msg : [u8; 19] = "CAP INVOKE COOLING\0"

  // R31.M5-001 (#1106): KIND_BACKLIGHT dispatch chatter. Its own tag
  // rather than sharing the KIND_DEVICE one it derives from, for the
  // reason cap_cooling_msg has one: folding a derived kind under its
  // parent's label erases exactly the distinction the derived kind
  // was introduced to create. Here the distinction is "somebody read
  // a PCI function's configuration" versus "somebody pushed a new
  // brightness ordinal for the panel whose static identity this row
  // holds", and only the second event has the shape a future
  // compositor consumer will filter on. Row dumps use
  // "BACKLIGHT ROW", declared in kind_backlight.pdx.
  pub let cap_backlight_msg : [u8; 21] = "CAP INVOKE BACKLIGHT\0"

  // R32.M3-001 (#1125): KIND_HID_DEVICE dispatch chatter. Its own tag
  // rather than sharing the KIND_DEVICE one it derives from, for the
  // reason cap_backlight_msg has one: folding a derived kind under its
  // parent's label erases exactly the distinction the derived kind
  // was introduced to create. Here the distinction is "somebody read
  // a PCI function's configuration" versus "somebody noted that the
  // class driver for the HID device this row names installed one
  // report", and only the second event has the shape a future
  // input-policy consumer will filter on. Row dumps use
  // "HID DEV ROW", declared in kind_hid_device.pdx.
  pub let cap_hid_device_msg : [u8; 22] = "CAP INVOKE HID_DEVICE\0"

  // R32.M3-002 (#1126): KIND_HID_EVENT dispatch chatter. Its own tag
  // rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // for the reason cap_ec_query_msg has one -- and the reason is
  // sharper here than for any other endpoint-derived kind: the
  // subscription is what a router will consult to decide whether an
  // event is delivered to a process, and an operator reconstructing
  // "which subscriber was told about which class during this boot"
  // needs a trace that separates subscription events from ordinary
  // IPC traffic. Row dumps use "HID EVT ROW", declared in
  // kind_hid_event.pdx.
  pub let cap_hid_event_msg : [u8; 21] = "CAP INVOKE HID_EVENT\0"

  // R32.M5-001 (#1133): KIND_SENSOR_CHANNEL dispatch chatter. Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // for the reason cap_hid_event_msg has one: the subscription is what
  // a driver will consult to decide whether one sensor sample is
  // intended for this row, and an operator reconstructing "which
  // subscriber was told about which sensor class during this boot"
  // needs a trace that separates sensor subscription events from
  // ordinary IPC traffic. Row dumps use "SENSOR ROW", declared in
  // kind_sensor_channel.pdx.
  pub let cap_sensor_channel_msg : [u8; 26] = "CAP INVOKE SENSOR_CHANNEL\0"

  // R33.M1-005 (#1141): KIND_AUDIO_CONTROLLER dispatch chatter. Its
  // own tag rather than sharing the KIND_DEVICE one it derives from,
  // for the reason cap_backlight_msg has one: folding a derived kind
  // under its parent's label erases exactly the distinction the
  // derived kind was introduced to create. Here the distinction is
  // "somebody read a PCI function's configuration" versus "somebody
  // pushed a new codec-count report for the HDA controller whose
  // static identity this row holds", and only the second event has
  // the shape a future audio-supervisor consumer will filter on.
  // Row dumps use "AUDIO CTRL ROW", declared in
  // kind_audio_controller.pdx.
  pub let cap_audio_ctrl_msg : [u8; 22] = "CAP INVOKE AUDIO_CTRL\0"

  // R33.M3-001 (#1147): KIND_PCM_STREAM dispatch chatter. Its own tag
  // rather than sharing the KIND_IPC_ENDPOINT one it derives from, for
  // the reason cap_hid_event_msg has one -- and sharper here than for
  // any other endpoint-derived kind: the PCM stream is what a
  // compositor-adjacent audio server will consult to decide whether
  // one frame period reaches an amplifier, and an operator
  // reconstructing "which stream had audio deferred at frame N" needs
  // a trace that separates PCM invocations from ordinary IPC traffic.
  // Row dumps use "PCM STREAM ROW", declared in kind_pcm_stream.pdx.
  pub let cap_pcm_stream_msg : [u8; 21] = "CAP INVOKE PCM_STREAM\0"

  // R33.M3-003 (#1149): KIND_AUDIO_CLOCK dispatch chatter. Its own
  // tag rather than sharing the KIND_HW one it derives from, for the
  // reason cap_pcm_stream_msg has one: the audio clock is what a
  // stream consults to compute presentation time, and an operator
  // reconstructing "which clock drifted between frame N and N+1"
  // needs a trace that separates clock invocations from generic HW.
  // Row dumps use "AUDIO CLOCK ROW", declared in kind_audio_clock.pdx.
  pub let cap_audio_clock_msg : [u8; 22] = "CAP INVOKE AUDIO_CLOCK\0"

  // R33.M5-002 (#1158): KIND_AUDIO_ROUTE dispatch chatter. Its own tag
  // rather than sharing the KIND_IPC_ENDPOINT one it derives from, for
  // the same reason cap_pcm_stream_msg has one: an operator
  // reconstructing which producer's samples reached which consumer at
  // what mixer level needs a trace that separates route invocations
  // from ordinary IPC traffic. Row dumps use "AUDIO ROUTE ROW",
  // declared in kind_audio_route.pdx.
  pub let cap_audio_route_msg : [u8; 22] = "CAP INVOKE AUDIO_ROUTE\0"

  // R34.M1-003 (#1169): KIND_USB_DEVICE dispatch chatter. Its own tag
  // rather than sharing the KIND_DEVICE one it derives from, for the
  // same reason cap_hid_device_msg has one: an operator reconstructing
  // "which USB device the class driver noted after enumeration" needs
  // a trace that separates USB device invocations from ordinary
  // KIND_DEVICE traffic. Row dumps use "USB DEV ROW", declared in
  // kind_usb_device.pdx.
  pub let cap_usb_device_msg : [u8; 22] = "CAP INVOKE USB_DEVICE\0"

  // R34.M1-003 (#1169): KIND_USB_HUB dispatch chatter. Its own tag
  // rather than sharing the KIND_USB_DEVICE one it derives from, for
  // the reason cap_hid_event_msg has one: a hub is what the topology
  // channel narrates attach/detach events against, and an operator
  // reconstructing "which port on which hub reported which device"
  // needs a trace that separates hub invocations from ordinary USB
  // device traffic. Row dumps use "USB HUB ROW", declared in
  // kind_usb_hub.pdx.
  pub let cap_usb_hub_msg : [u8; 19] = "CAP INVOKE USB_HUB\0"

  // R34.M2-001 (#1172): KIND_USB_INTERFACE dispatch chatter. Its own
  // tag rather than sharing the KIND_USB_DEVICE one it derives from,
  // for the reason cap_usb_hub_msg has one: an operator reconstructing
  // "which interface the class-driver-selection bound to which driver"
  // needs a trace that separates interface invocations from ordinary
  // USB device traffic.
  pub let cap_usb_interface_msg : [u8; 25] = "CAP INVOKE USB_INTERFACE\0"

  // R34.M2-004 (#1175): KIND_USB_ENDPOINT dispatch chatter. Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because a USB endpoint is the transfer pipe for one interface and
  // an operator reconstructing which pipe was addressed needs a trace
  // that separates USB endpoint invocations from ordinary IPC traffic.
  pub let cap_usb_endpoint_msg : [u8; 24] = "CAP INVOKE USB_ENDPOINT\0"

  // R34.M3-001 (#1176): KIND_MSC_LUN dispatch chatter. Separate from
  // cap_usb_interface_msg because a per-LUN authority and a per-
  // interface authority answer different questions: the interface
  // capability is "may this component bind a class driver to this
  // function"; the LUN capability is "may this component issue SCSI
  // commands against THIS logical unit". Folding under the interface
  // tag would erase the distinction the LUN kind was introduced to
  // create on a device that presents several LUNs.
  pub let cap_msc_lun_msg : [u8; 19] = "CAP INVOKE MSC_LUN\0"

  // R34.M3-003 (#1178): KIND_SCSI_DEVICE dispatch chatter. Separate
  // from cap_msc_lun_msg for the same reason: a SCSI-layer invocation
  // (READ block N) is not a LUN-layer invocation (query LUN state),
  // and an operator debugging which stream reached which media at
  // frame N needs the two traces apart.
  pub let cap_scsi_device_msg : [u8; 23] = "CAP INVOKE SCSI_DEVICE\0"

  // R34.M3-004 (#1179): KIND_USB_URB dispatch chatter. Its own tag
  // rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because a URB is one queued transfer and an operator wanting to
  // reconstruct which URB was cancelled or polled needs a trace that
  // separates URB invocations from ordinary IPC traffic.
  pub let cap_usb_urb_msg : [u8; 19] = "CAP INVOKE USB_URB\0"

  // R34.M5-001 (#1186): KIND_ISOCH_STREAM dispatch chatter. Separate
  // from cap_usb_endpoint_msg because an isochronous stream reservation
  // and a raw endpoint invocation answer different questions: the
  // endpoint capability is "may this component transfer over this
  // pipe"; the stream capability is "may this component hold a
  // bandwidth reservation of THIS many bytes at THIS service
  // interval". Folding under the endpoint tag would erase exactly the
  // distinction the derived kind was introduced to create on a bus
  // where every isoch stream competes for a shared microframe budget.
  pub let cap_isoch_stream_msg : [u8; 24] = "CAP INVOKE ISOCH_STREAM\0"

  // R34.M6-001 (#1194): KIND_FP_SENSOR dispatch chatter. Separate
  // from the parent KIND_DEVICE tag for the reason every derived-
  // over-KIND_DEVICE tag in this file has one: an operator debugging
  // an authentication decision needs a trace that separates
  // fingerprint sensor invocations (enrollment / verify) from
  // ordinary PCI configuration accesses. Row dumps use
  // "FP SENSOR ROW", declared in kind_fp_sensor.pdx.
  pub let cap_fp_sensor_msg : [u8; 21] = "CAP INVOKE FP_SENSOR\0"

  // R35.M1-002 (#1196): KIND_PCIE_HOTPLUG_EVENT dispatch chatter.
  // Its own tag rather than sharing the KIND_IPC_ENDPOINT one it
  // derives from, because an operator debugging a hotplug event
  // (a PCIe root port raising a Slot Status change) needs a trace
  // that separates hotplug subscriptions from ordinary IPC traffic
  // over the same endpoint fabric — most endpoints in the machine
  // carry request/reply, and hotplug events are a one-way stream
  // whose accounting an operator needs apart from the rest.
  pub let cap_pcie_hp_evt_msg : [u8; 28] = "CAP INVOKE PCIE_HOTPLUG_EVT\0"

  // R35.M2-003 (#1203): KIND_TB_DOMAIN dispatch chatter. Its own tag
  // rather than sharing the KIND_DEVICE one it derives from, because
  // an operator debugging Thunderbolt bring-up (NHI probe, CM ring
  // submit, router walk) needs a trace that separates TB4 domain
  // capability invocations from ordinary PCI configuration access —
  // most KIND_DEVICE traffic is one of those, and TB4 events are
  // rare, bursty and load-bearing.
  pub let cap_tb_domain_msg : [u8; 21] = "CAP INVOKE TB_DOMAIN\0"

  // R35.M3-004 (#1208): KIND_TB_ROUTE dispatch chatter. Its own tag
  // rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because an operator debugging TB4 tunnel establishment needs to
  // separate tunnel-lifecycle events (tunnel appeared/torn/state
  // change) from ordinary IPC traffic — the endpoint the events
  // arrive on is also the endpoint the compositor listens to for
  // display-add / display-remove, and untangling the two after the
  // fact is a lost cause without the per-invocation trace.
  pub let cap_tb_route_msg : [u8; 20] = "CAP INVOKE TB_ROUTE\0"

  // R35.M4-001 (#1210): KIND_DMA_ATTESTATION dispatch chatter. Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because an operator debugging a DMA consent decision needs to
  // separate attestation queries (dock_id / state / hash reads) from
  // ordinary IPC traffic on the endpoint the consent dialog arrived
  // on — the same endpoint carries both the dialog RPC and the
  // dock supervisor's regular telemetry, and untangling the two
  // after the fact without a per-invocation trace is a lost cause.
  pub let cap_dma_attest_msg : [u8; 22] = "CAP INVOKE DMA_ATTEST\0"

  // R36.M1-004 (#1238): KIND_DISPLAY_ENGINE dispatch chatter. Its own
  // tag rather than sharing the KIND_DEVICE one it derives from,
  // because an operator debugging Iris Xe bring-up (probe, power-
  // well enable, CDCLK setpoint, DP link PLL lock) needs a trace
  // that separates display engine invocations from ordinary PCI
  // configuration access — most KIND_DEVICE traffic is one of those,
  // and display events are rare, bursty and load-bearing.
  pub let cap_display_engine_msg : [u8; 26] = "CAP INVOKE DISPLAY_ENGINE\0"

  // R36.M2-003 (#1241): KIND_DISPLAY_OUTPUT dispatch chatter. Its own
  // tag rather than sharing the KIND_DEVICE one it derives from,
  // because an operator debugging DDI-to-panel routing (HDMI vs DP,
  // DP-MST branching, connected transitions) needs a trace that
  // separates output invocations from ordinary PCI configuration
  // access — most KIND_DEVICE traffic is one of those, and output
  // events fire on a per-panel timeline no engine trace correlates
  // with directly.
  pub let cap_display_output_msg : [u8; 26] = "CAP INVOKE DISPLAY_OUTPUT\0"

  // R36.M3-001 (#1244): KIND_MODESET_TXN dispatch chatter. Its own tag
  // rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because an operator debugging atomic modeset (BEGIN_TXN / SET_MODE
  // / SET_PLANE / COMMIT / ABORT transitions on one panel) needs a
  // trace that separates modeset traffic from ordinary IPC — most
  // KIND_IPC_ENDPOINT traffic is one of a dozen other conversations,
  // and modeset events fire in bursts on a per-panel timeline.
  pub let cap_modeset_txn_msg : [u8; 23] = "CAP INVOKE MODESET_TXN\0"

  // R36.M3-004 (#1247): KIND_DISPLAY_MODE dispatch chatter. Its own
  // tag rather than sharing the KIND_MEMORY one it derives from,
  // because an operator debugging a modeset (which mode did the
  // arbiter pick, at what pixel clock, what refresh) needs a trace
  // that separates mode queries from ordinary memory operations —
  // most KIND_MEMORY traffic is page allocation / mapping, and mode
  // events are rare and diagnostic.
  pub let cap_display_mode_msg : [u8; 24] = "CAP INVOKE DISPLAY_MODE\0"

  // R36.M4-001 (#1249): KIND_DISPLAY_PLANE dispatch chatter. Its own
  // tag rather than sharing the KIND_MEMORY one it derives from,
  // because an operator debugging a compositor pipeline (which plane
  // did the compositor bind, at what z-order, what format, what
  // subsampled stride) needs a trace that separates plane queries
  // from ordinary memory operations — most KIND_MEMORY traffic is
  // page allocation / mapping, and plane events fire on a per-frame
  // timeline whose signal is drowned in memory chatter otherwise.
  pub let cap_display_plane_msg : [u8; 25] = "CAP INVOKE DISPLAY_PLANE\0"

  // R37.M3-001 (#1262): KIND_GPU_BO dispatch chatter. Its own tag
  // rather than sharing the KIND_MEMORY one it derives from, because
  // an operator debugging a compositor / driver BO exchange (which
  // BO was allocated, at what size class, at what tiling, at what
  // cache policy) needs a trace that separates BO events from
  // ordinary memory operations -- most KIND_MEMORY traffic is page
  // allocation / mapping, and BO events fire on a per-frame timeline
  // whose signal is drowned in memory chatter otherwise.
  pub let cap_gpu_bo_msg : [u8; 18] = "CAP INVOKE GPU_BO\0"

  // R37.M4-001 (#1267): KIND_GPU_VM dispatch chatter.  Its own tag
  // rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because an operator debugging a GPU-address-space session (which
  // VM was minted, at what PML4 root, at what ASID, in what FSM state)
  // needs a trace that separates VM events from ordinary IPC endpoint
  // traffic -- endpoint events are per-message and pool events fire
  // per-bind, and the two mix badly in one channel.
  pub let cap_gpu_vm_msg : [u8; 18] = "CAP INVOKE GPU_VM\0"

  // R37.M5-001 (#1272): KIND_GPU_CONTEXT dispatch chatter.  Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT or KIND_GPU_VM one
  // it borrows names from, because an operator debugging a submission
  // context (which context was minted, at what engine, at what
  // priority, in what FSM state, over which VM) needs a trace that
  // separates CONTEXT events from ordinary IPC endpoint / VM traffic
  // -- endpoint events are per-message, VM events are per-bind, and
  // context events are per-submission, and the three mix badly in one
  // channel.
  pub let cap_gpu_context_msg : [u8; 23] = "CAP INVOKE GPU_CONTEXT\0"

  // R37.M6-001 (#1276): KIND_GPU_SUBMIT dispatch chatter.  Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT or KIND_GPU_CONTEXT
  // one it borrows names from, because an operator debugging a
  // submission (which submit was minted, at what state, over which
  // context / BO) needs a trace that separates SUBMIT events from
  // ordinary IPC endpoint / CONTEXT traffic -- endpoint events are
  // per-message, context events are per-scheduling-tick, and submit
  // events fire per-batch, and the three mix badly in one channel.
  pub let cap_gpu_submit_msg : [u8; 22] = "CAP INVOKE GPU_SUBMIT\0"
}
