  // minted, at which vendor/product, at what form-factor and power
  // state) needs a trace that separates WWAN-modem-capability
  // invocations from ordinary PCI configuration access -- most
  // KIND_DEVICE traffic is one of those, and modem events fire on a
  // per-modem timeline whose signal is drowned in device chatter
  // otherwise.
  pub let cap_wwan_modem_msg : [u8; 54] = "WWAN modem invocation [legacy: CAP INVOKE WWAN_MODEM]\0"

  // R40.M4-004 (#1362): KIND_MBIM_SESSION dispatch chatter.  Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT one it derives
  // from, because an operator debugging an MBIM session bring-up
  // (which session was minted, bound to which modem, in what FSM
