  // KIND_IPC_ENDPOINT -- the shell's stdout included -- so per-channel
  // events would be drowned in generic endpoint chatter otherwise.
  pub let cap_bt_l2cap_chan_msg : [u8; 70] = "Bluetooth L2CAP channel invocation [legacy: CAP INVOKE BT_L2CAP_CHAN]\0"

  // G1.M1-001 (#1427): KIND_DISPLAY_TIMELINE dispatch chatter. Its own
  // tag rather than sharing the KIND_HW one it derives from, because
  // an operator debugging explicit-sync bring-up (which timeline was
  // signalled, at what monotone value, at what vblank) needs a trace
  // that separates timeline events from generic hardware chatter.
  pub let cap_display_timeline_msg : [u8; 66] = "display timeline invocation [legacy: CAP INVOKE DISPLAY_TIMELINE]\0"

  // G1.M2-002 (#1433): KIND_VRR_RANGE dispatch chatter. Its own tag
  // rather than sharing the KIND_MEMORY one it derives from, because
  // an operator debugging adaptive-sync arming (which output's range
  // was probed, at what min/max refresh) needs a trace that separates
  // VRR queries from generic memory operations.
  pub let cap_vrr_range_msg : [u8; 52] = "VRR range invocation [legacy: CAP INVOKE VRR_RANGE]\0"

  // R47.M1-003 (#1414): KIND_VMD_ENDPOINT dispatch chatter.  Its own
  // tag rather than sharing the KIND_DEVICE one it derives from,
  // because an operator debugging VMD bring-up (which endpoint was
  // minted, at what vbdf / class, bound to which VMD controller)
  // needs a trace that separates VMD-endpoint invocations from
  // ordinary PCI configuration access -- most KIND_DEVICE traffic
