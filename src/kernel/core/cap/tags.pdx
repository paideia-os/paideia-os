  pub let cap_vmd_endpoint_msg : [u8; 58] = "VMD endpoint invocation [legacy: CAP INVOKE VMD_ENDPOINT]\0"

  // G2.M1-001 (#1443): KIND_SCANOUT_LEASE dispatch chatter.  Its own
  // tag rather than sharing the KIND_DISPLAY_PLANE one it derives
  // from, because an operator debugging a direct-scanout bring-up
  // (which plane was leased, at what output / timeline / expiry,
  // whether the lease reached REVOKED or EXPIRED and when) needs a
  // trace that separates lease-capability invocations from ordinary
  // plane-programming traffic.  A P8 refusal against the reserved
  // plane in particular MUST show up separately from a routine
  // plane query so an operator can distinguish a policy refusal
  // from a bad plane_slot.
  pub let cap_scanout_lease_msg : [u8; 60] = "scanout lease invocation [legacy: CAP INVOKE SCANOUT_LEASE]\0"

  // G3.M1-001 (#1457): KIND_VK_SURFACE dispatch chatter. Its own tag
  // rather than sharing the KIND_IPC one it derives from, because an
  // operator debugging swapchain bring-up needs a trace that separates
  // surface events from generic endpoint chatter.
  pub let cap_vk_surface_msg : [u8; 58] = "Vulkan surface invocation [legacy: CAP INVOKE VK_SURFACE]\0"

  // G3.M2-001 (#1462): KIND_VK_SWAPCHAIN_IMAGE dispatch chatter. Its
  // own tag rather than sharing the KIND_MEMORY one it derives from
  // (via KIND_GPU_BO), because an operator debugging present timing
  // needs a per-image acquire/present trace separate from generic
  // GPU-BO chatter.
  pub let cap_vk_swapchain_image_msg : [u8; 74] = "Vulkan swapchain image invocation [legacy: CAP INVOKE VK_SWAPCHAIN_IMAGE]\0"

  // G5.M1-002 (#1492): KIND_FONT_ATLAS dispatch chatter. Its own tag
  // rather than sharing the KIND_MEMORY one it derives from (via
  // KIND_GPU_BO), because an operator debugging font-cache pressure
  // needs a per-atlas trace separate from generic GPU-BO chatter.
  pub let cap_font_atlas_msg : [u8; 54] = "font atlas invocation [legacy: CAP INVOKE FONT_ATLAS]\0"

  // G5.M2-002 (#1497): KIND_TEXT_SHAPE dispatch chatter. Its own tag
  // rather than sharing the KIND_MEMORY one it derives from, because
  // an operator debugging shaping regressions (BiDi / Indic /
  // ligature clusters) needs a per-shape trace separate from generic
  // page-authority chatter.
  pub let cap_text_shape_msg : [u8; 54] = "text shape invocation [legacy: CAP INVOKE TEXT_SHAPE]\0"

  // G4.M1-002 (#1476): KIND_VELLO_SCENE dispatch chatter. Its own tag
  // rather than sharing the KIND_MEMORY one it derives from (via
  // KIND_GPU_BO), because an operator debugging compute-render
