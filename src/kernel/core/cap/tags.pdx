  // shell's stdout included -- so per-channel events would be drowned
  // in generic endpoint chatter otherwise.
  pub let cap_bt_hci_chan_msg : [u8; 66] = "Bluetooth HCI channel invocation [legacy: CAP INVOKE BT_HCI_CHAN]\0"

  // R39.M2-003 (#1329): KIND_BT_L2CAP_CHANNEL dispatch chatter.  Its own
  // tag rather than sharing the KIND_IPC_ENDPOINT one it derives from,
  // because an operator debugging an L2CAP dynamic-channel bring-up
  // (which channel was minted, at what cid / psm / mtu / credits, bound
  // to which HCI transport slice) needs a trace that separates
  // L2CAP-channel-capability invocations from ordinary endpoint traffic
