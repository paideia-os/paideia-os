// src/kernel/core/cap/kind_kek.pdx -- R90-XREPO.LV11.M5-001 (paideia-os #2224)
//
// KIND_KEK = 0x1B4, derived over KIND_MEMORY (= 4).
//
// Kernel-side Key-Encryption-Key capability sealed under a (deferred)
// hardware root-of-trust. Landing of the KEK cap kind the
// libpdx-volume v1.1.0 pdxb_crypto.pdx client stubs cross-repo
// reference (LV.M5-001 filed as paideia-os/paideia-os#2224).
//
// This landing wires the ROW SHAPE + MINT GATE + NARROW GATE + OP
// CATALOG + DISPATCH HANDLER; the sealed_key blob at sealed_key_pa
// is a KIND_MEMORY-owned page whose fine-grained ACL is enforced at
// wrap / unwrap time. Real TPM/KMS sealing (TPM 2.0 persistent-slot
// handles, cloud-KMS PQ-hybrid keys) is DEFERRED to a follow-up
// landing per the issue's own §"Sealed under a hardware root-of-
// trust" list; at MVP the WRAP / UNWRAP / DERIVE_CHILD op bodies
// return sentinel results rather than driving crypto themselves
// (the real Argon2id + ChaCha20-Poly1305 primitives live in
// libpdx-volume/src/pdxb_crypto.pdx on paideia-as v0.28.0 intrinsics
// -- see design/architecture.md §8.2 for the seed_ptr discipline
// this landing follows).
//
// =============================================================================
// SECTION 0  ORDINAL CHOICE  --  0x1B4
// =============================================================================
//
//   0x1B2  KIND_SCHEMA_HANDLE      (R90-XREPO.012.M3-001, landed)
//   0x1B3  KIND_VOLUME_SNAPSHOT    (LV11.M3-001 sibling, this wave)
//   0x1B4  KIND_KEK                (this landing) -- first free
//
// Same G7+ band (0x1B2..0x1BF, per design/graphics/r101-kernel-plan.md
// §5 tail summary) as KIND_SCHEMA_HANDLE and KIND_VOLUME_SNAPSHOT.
//
// =============================================================================
// SECTION 1  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// A KEK cap refers indirectly into a caller-supplied wrapped-key
// blob that lives at sealed_key_pa (a physical / kernel-linear
// address that names a KIND_MEMORY-owned page). The parent gate is
// therefore the standard "cannot widen memory reach beyond what you
// already hold" rule: parent.kind == KIND_MEMORY (4) AND rights
// carry RIGHT_MINT (0x200). Supervisor-only mint (no cap-invoke op
// reaches kind_kek_mint_body); a ring-3 holder of a KIND_KEK cap
// reaches only the four op-catalog entries WRAP / UNWRAP / DERIVE_
// CHILD / REVOKE, gated per §3.
//
// =============================================================================
// SECTION 2  TAIL ENCODING
// =============================================================================
//
// Row layout (72 bytes, nine u64 words). Field-by-field:
//
//   [+0]   header      (u64):  in_use[63:56] | kind_tag[55:0]
//                              kind_tag mirrors KIND_KEK (0x1B4) for
//                              a defensive tag-in-row assertion at
//                              revoke time.
//   [+8]   kek_id      (u64):  kernel-assigned unique id, pre-
//                              incremented from _kek_next_id so the
//                              first id is 1 (no live row ever
//                              carries kek_id == 0).
//   [+16]  sealed_key_pa (u64): physical / kernel-linear address of
//                              the wrapped-KEK blob (encrypted under
//                              the future RoT). At MVP: opaque
//                              pointer stored verbatim; a fine-
//                              grained ACL is enforced by wrap /
//                              unwrap being the sole readers.
//   [+24]  lens        (u64):  sealed_key_len[31:0] | kdf_algo[63:32]
//                              sealed_key_len -- byte length of the
//                                                sealed blob at
//                                                sealed_key_pa.
//                              kdf_algo       -- 1 = Argon2id,
//                                                2..N reserved.
//   [+32]  kdf_salt_lo (u64):  low 8 bytes of the 16-byte kdf_salt.
//   [+40]  kdf_salt_hi (u64):  high 8 bytes of the 16-byte kdf_salt.
//                              salt is drawn from RoT entropy at mint
//                              (deferred to the follow-up landing;
//                              at MVP the caller supplies the salt).
//   [+48]  created_tsc (u64):  TSC snapshot at mint (rdtsc).
//   [+56]  flags_ref   (u64):  refcount[31:0] | flags[63:32]
//                              refcount -- initialised 1 at mint,
//                                          bumped on child derivation,
//                                          decremented on revoke.
//                              flags    -- bit 0 = REVOKED,
//                                          bit 1 = EXPORTABLE, others
//                                          reserved.
//   [+64]  reserved    (u64):  must be zero at mint (future RoT
//                              handle / TPM persistent-slot slot).
//
// Row-addressed capacity: KEK_MAX = 32 rows. 32 * 72 = 2304 bytes =
// 288 u64 words. Thirty-two outstanding KEKs is above the current
// design ceiling of "one KEK per volume, up to eight volumes" (per
// libpdx-volume design/architecture.md §8.2), leaving headroom for
// per-user KEKs on multi-tenant volumes.
//
// =============================================================================
// SECTION 3  RIGHTS
// =============================================================================
//
//   R_KEK_WRAP         (0x001) -- KEK_OP_WRAP: wrap a caller-supplied
//                                 DEK against this KEK.
//   R_KEK_UNWRAP       (0x002) -- KEK_OP_UNWRAP: unwrap a caller-
//                                 supplied wrapped-DEK.
//   R_KEK_DERIVE_CHILD (0x004) -- KEK_OP_DERIVE_CHILD: derive a child
//                                 KEK via the KDF over this parent.
//   R_KEK_EXPORT       (0x008) -- gates re-serialising the sealed
//                                 blob for backup; refused for a
//                                 row whose EXPORTABLE flag is 0.
//   R_KEK_ALL          (0x00F) -- subset test in kek_rights_valid.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFEB50..0xFFFFEB5F
// =============================================================================
//
// Contiguous with KIND_VOLUME_SNAPSHOT's 0xFFFFEB40..0xFFFFEB4F band
// (both landings in the same wave; sibling in kind_volume_snapshot.
// pdx §4).
//
//   KEK_MINT_BAD_PARENT   0xFFFFEB50  -- parent not KIND_MEMORY
//   KEK_MINT_BAD_RIGHTS   0xFFFFEB51  -- rights not subset of R_KEK_ALL
//   KEK_MINT_BAD_ARG      0xFFFFEB52  -- sealed_key_pa == 0 / sealed_key_len == 0
//                                        / kdf_algo not 1 / flags OOR
//   KEK_TAIL_ENOSPC       0xFFFFEB53  -- 32-row pool full
//   KEK_BAD_SLOT          0xFFFFEB54  -- op_arg row_id OOR or free
//   KEK_BAD_RIGHTS        0xFFFFEB55  -- op invoked without required right
//   KEK_TAIL_BAD_ARG      0xFFFFEB56  -- op_arg[63:8] non-zero
//   KEK_STUB_SENTINEL     0xFFFFEB57  -- WRAP / UNWRAP / DERIVE_CHILD
//                                        MVP arms: no crypto driven
//                                        here; caller composes with
//                                        libpdx-volume/pdxb_crypto.
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag 0x1B4 does not sign-extend cleanly from a 32-bit
// immediate, so every compare stages through r11 first. Row stride
// is 72 bytes (KEK_ROW_BYTES), which is NOT a power of two, so
// idx*72 composes as (idx*64) + (idx*8) via two shifts + an add
// (64 = shl 6, 8 = shl 3). No `add reg, [mem]`, no `mov_bzx` /
// `mov_wzx`, no `test`. Labels prefixed `kek_` or `kek_hn_`.

module KindKek = structure {

  pub let KIND_KEK      : u64 = 0x1B4
  pub let KIND_KEK_BASE : u64 = 4                     // = KIND_MEMORY

  // Rights (§3).
  pub let R_KEK_WRAP         : u64 = 0x001
  pub let R_KEK_UNWRAP       : u64 = 0x002
  pub let R_KEK_DERIVE_CHILD : u64 = 0x004
  pub let R_KEK_EXPORT       : u64 = 0x008
  pub let R_KEK_ALL          : u64 = 0x00F

  // Ops.
  pub let KEK_OP_WRAP         : u64 = 0
  pub let KEK_OP_UNWRAP       : u64 = 1
  pub let KEK_OP_DERIVE_CHILD : u64 = 2
  pub let KEK_OP_REVOKE       : u64 = 3
  pub let KEK_OP_MAX          : u64 = 3

  // KDF algo constants.
  pub let KEK_KDF_ALGO_ARGON2ID : u64 = 1

  // Flag bits.
  pub let KEK_FLAG_REVOKED    : u64 = 1
  pub let KEK_FLAG_EXPORTABLE : u64 = 2
  pub let KEK_FLAG_ALL        : u64 = 3

  // Failure taxonomy (§4).
  pub let KEK_OK                : u64 = 0
  pub let KEK_MINT_BAD_PARENT   : u64 = 0xFFFFEB50
  pub let KEK_MINT_BAD_RIGHTS   : u64 = 0xFFFFEB51
  pub let KEK_MINT_BAD_ARG      : u64 = 0xFFFFEB52
  pub let KEK_TAIL_ENOSPC       : u64 = 0xFFFFEB53
  pub let KEK_BAD_SLOT          : u64 = 0xFFFFEB54
  pub let KEK_BAD_RIGHTS        : u64 = 0xFFFFEB55
  pub let KEK_TAIL_BAD_ARG      : u64 = 0xFFFFEB56
  pub let KEK_STUB_SENTINEL     : u64 = 0xFFFFEB57

  pub let KEK_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KEK_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let KEK_MAX       : u64 = 32
  pub let KEK_ROW_BYTES : u64 = 72

  // 32 rows * 72 bytes = 2304 bytes = 288 u64.
  pub let mut _kek_table    : [u64; 288] = uninit @align(64)
  pub let mut _kek_stats    : [u64; 8]   = uninit @align(64)
  pub let mut _kek_next_id  : u64        = uninit @align(8)

  pub let KEK_ST_MINTS       : u64 = 0
  pub let KEK_ST_WRAPS       : u64 = 1
  pub let KEK_ST_UNWRAPS     : u64 = 2
  pub let KEK_ST_DERIVES     : u64 = 3
  pub let KEK_ST_REVOKES     : u64 = 4
  pub let KEK_ST_REFUSED     : u64 = 5
  pub let KEK_ST_MAX         : u64 = 8

  // ==========================================================================
  // kind_kek_init() -> ()
  //
  // Boot / teardown scrub of the row pool, counter table and the
  // monotonic id counter. .bss already starts zero at real boot;
  // defensive, matches kind_volume_snapshot_init one-for-one.
  // ==========================================================================

  pub let kind_kek_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): clear _kek_table (288 u64 = 2304 bytes), _kek_stats (8 u64) and _kek_next_id (1 u64). Three straight-line loops. Labels prefixed kek_rs_.",
      block: {
        lea r10, [rip + _kek_table];
        xor rax, rax;
        xor rcx, rcx;
      kek_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 288;
        jb  kek_rs_rows;

        lea r10, [rip + _kek_stats];
        xor rcx, rcx;
      kek_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kek_rs_stats;

        lea r10, [rip + _kek_next_id];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let kek_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): bounded increment on _kek_stats. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed kek_nt_.",
      block: {
        cmp rdi, 8;
        jae kek_nt_out;
        lea r10, [rip + _kek_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kek_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kek_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): subset test against R_KEK_ALL = 0x00F. Labels prefixed kek_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x00F;                  // R_KEK_ALL
        and rax, r10;
        cmp rax, rdi;
        jne kek_rv_no;
        mov rax, 1;
        ret;
      kek_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kek_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): KIND_MEMORY derivation gate. Bounds-check parent_slot < 256; load descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_MEMORY (4) AND rights ([+8]) carry RIGHT_MINT (0x200). Pure read (@{cap} because it inspects cap_table). Labels prefixed kek_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kek_cpm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne kek_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  kek_cpm_no;

        mov rax, 1;
        ret;
      kek_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool: kek_row_valid / kek_row_alloc / kek_row_free.
  //
  // Row stride is 72 bytes (KEK_ROW_BYTES) -- NOT a power of two, so
  // idx*72 composes as (idx*64) + (idx*8) via two shifts + an add.
  // ==========================================================================

  pub let kek_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): 1 iff idx < KEK_MAX(32) and in_use byte set. Address compute uses idx*64 + idx*8 = idx*72. Labels prefixed kek_rv2_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        jae kek_rv2_no;
        lea r10, [rip + _kek_table];
        mov r11, rdi;
        shl r11, 6;                      // idx * 64
        mov r8,  rdi;
        shl r8,  3;                      // idx * 8
        add r11, r8;                     // idx * 72
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use byte
        cmp rax, 0;
        je  kek_rv2_no;
        mov rax, 1;
        ret;
      kek_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // kek_row_alloc(sealed_key_pa, sealed_key_len, kdf_algo, salt_lo,
  //               salt_hi, flags) -> row_idx | KEK_TAIL_ENOSPC
  //
  // Low-first scan over 32 rows of 72 bytes. Header write is LAST:
  // packs (KIND_KEK tag in low 56 bits) OR (1 << 56 in_use marker)
  // into [row+0] in the same qword store. Assigns a fresh kek_id
  // (pre-increment). Captures created_tsc via rdtsc. Refcount
  // initialised to 1.
  pub let kek_row_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (sealed_key_pa: u64) (sealed_key_len: u64) (kdf_algo: u64) (salt_lo: u64) (salt_hi: u64) (flags: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): claim one KIND_KEK row. Low-first scan (r14=idx cursor) over 32 rows of 72 bytes; address compute (row_base + idx*72) uses shl 6 + shl 3 + add. On claim: (1) pre-increment _kek_next_id -> fresh kek_id in rbp; (2) write kek_id at row+8; (3) write sealed_key_pa at row+16; (4) pack (kdf_algo<<32) | sealed_key_len at row+24; (5) write salt_lo at row+32 and salt_hi at row+40; (6) capture rdtsc at row+48; (7) pack (flags<<32) | refcount=1 at row+56; (8) zero reserved at row+64; (9) publish header LAST at row+0. Six callee-save pushes (rbx=sealed_key_pa, r12=sealed_key_len, r13=kdf_algo, r14=idx cursor, r15=flags, rbp=kek_id) + sub rsp,8 pad = 56 bytes -> rsp%16==0 for the nested rdtsc. Fetch salt_lo/salt_hi from stack args (rdi/rsi/rdx/rcx/r8/r9 covers the six SysV registers; salt_lo comes in via r8, salt_hi via r9, so no stack fetch needed -- but we save both to scratch slots on the pad before rdtsc since rdtsc clobbers rdx). Effects {mem, sysreg}: mem for row + counter stores; sysreg for rdtsc. Labels prefixed kek_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // sealed_key_pa
        mov r12, rsi;                    // sealed_key_len
        mov r13, rdx;                    // kdf_algo
        mov r15, r9;                     // flags
        // salt_lo (r8) and salt_hi (r9) are already in-registers on entry;
        // save both onto the scratch pad slot (rsp+0) via a small stack
        // reserve so rdtsc's rdx clobber (below) does not affect us. We
        // will not need salt_hi after this point except for the row write.
        //
        // Preserve salt_lo (r8) in rcx (caller-save, available) and
        // salt_hi (r9) in the already-saved r15 slot? We need r15 for
        // flags. Instead: reuse rbx once sealed_key_pa is written --
        // but sealed_key_pa is used at row+16 early, so this is fine.
        //
        // Simpler: allocate two extra qwords on the stack for salt_lo
        // and salt_hi so they survive the rdtsc call. Adjust pad
        // accordingly. Entry sub rsp,8 above matched %16==0 for a
        // rdtsc call; two more push qwords keeps parity by adding 16.
        push r8;                         // salt_lo saved
        push r9;                         // salt_hi saved

        // Fresh kek_id: pre-increment _kek_next_id, hold in rbp.
        lea r10, [rip + _kek_next_id];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov rbp, rax;                    // rbp = kek_id (>= 1)

        xor r14, r14;                    // idx = 0
      kek_ra_scan:
        mov r10, 32;                     // KEK_MAX
        cmp r14, r10;
        jae kek_ra_enospc;

        lea r10, [rip + _kek_table];
        mov r11, r14;
        shl r11, 6;                      // idx * 64
        mov r8,  r14;
        shl r8,  3;                      // idx * 8
        add r11, r8;                     // idx * 72
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use
        cmp rax, 0;
        je  kek_ra_claim;

        add r14, 1;
        jmp kek_ra_scan;

      kek_ra_claim:
        // (2) kek_id @ +8.
        mov [r10 + 8], rbp;

        // (3) sealed_key_pa @ +16.
        mov [r10 + 16], rbx;

        // (4) lens = (kdf_algo << 32) | (sealed_key_len & 0xFFFFFFFF) @ +24.
        mov rax, r12;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov rcx, r13;
        and rcx, r11;
        shl rcx, 32;
        or  rax, rcx;
        mov [r10 + 24], rax;

        // (5) salt_lo @ +32, salt_hi @ +40. Pull from stack scratch.
        mov rcx, [rsp + 0];              // salt_hi (top of stack)
        mov [r10 + 40], rcx;
        mov rcx, [rsp + 8];              // salt_lo (below salt_hi)
        mov [r10 + 32], rcx;

        // (6) created_tsc via rdtsc @ +48.
        rdtsc;
        shl rdx, 32;
        or  rax, rdx;
        mov [r10 + 48], rax;

        // (7) flags_ref = (flags << 32) | (refcount = 1) @ +56.
        mov rax, 1;                      // refcount = 1
        mov rcx, r15;
        mov r11, 0xFFFFFFFF;
        and rcx, r11;
        shl rcx, 32;
        or  rax, rcx;
        mov [r10 + 56], rax;

        // (8) reserved = 0 @ +64.
        xor rax, rax;
        mov [r10 + 64], rax;

        // (9) Publish header LAST: kind_tag OR (in_use << 56).
        mov rax, 0x1B4;                  // KIND_KEK kind tag
        mov rcx, 1;
        shl rcx, 56;
        or  rax, rcx;
        mov [r10 + 0], rax;

        mov rax, r14;                    // row_idx
        jmp kek_ra_out;

      kek_ra_enospc:
        mov rax, 0xFFFFEB53;             // KEK_TAIL_ENOSPC

      kek_ra_out:
        add rsp, 16;                     // drop salt_lo + salt_hi scratch
        add rsp, 8;                      // undo entry pad
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kek_row_free : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): scrub one row (nine u64 words). Labels prefixed kek_rf_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        jae kek_rf_out;
        lea r10, [rip + _kek_table];
        mov r11, rdi;
        shl r11, 6;
        mov r8,  rdi;
        shl r8,  3;
        add r11, r8;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov [r10 + 64], rax;
      kek_rf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Each returns KEK_DECODE_BAD when the row is not
  // live. Shape mirrors kvs_row_* one-for-one.
  // ==========================================================================

  pub let kek_row_kek_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): kek_id (row+8) or KEK_DECODE_BAD. Labels prefixed kek_rki_.",
      block: {
        push r12;
        mov r12, rdi;
        call kek_row_valid;
        cmp rax, 0;
        je  kek_rki_bad;
        lea r10, [rip + _kek_table];
        mov r11, r12;
        shl r11, 6;
        mov r8,  r12;
        shl r8,  3;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kek_rki_out;
      kek_rki_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kek_rki_out:
        pop r12;
        ret
      }
    }

  pub let kek_row_flags : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): flags (flags_ref high 32) or KEK_DECODE_BAD. Labels prefixed kek_rfl_.",
      block: {
        push r12;
        mov r12, rdi;
        call kek_row_valid;
        cmp rax, 0;
        je  kek_rfl_bad;
        lea r10, [rip + _kek_table];
        mov r11, r12;
        shl r11, 6;
        mov r8,  r12;
        shl r8,  3;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 56];
        shr rax, 32;
        jmp kek_rfl_out;
      kek_rfl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kek_rfl_out:
        pop r12;
        ret
      }
    }

  // kek_row_flag_set(idx, flag_bit) -> 0 | KEK_BAD_SLOT
  // Sets one bit in the row's flags field (in-place via load-or-store).
  pub let kek_row_flag_set : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64) (flag_bit: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): set one bit in the row's flags high-32 sub-field via load-or-store. Used by revoke to set KEK_FLAG_REVOKED without freeing the row (so an in-flight unwrap sees the bit and refuses). Labels prefixed kek_fs_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;                    // idx
        mov r12, rsi;                    // flag_bit

        mov rdi, rbx;
        call kek_row_valid;
        cmp rax, 0;
        je  kek_fs_bad;

        lea r10, [rip + _kek_table];
        mov r11, rbx;
        shl r11, 6;
        mov r8,  rbx;
        shl r8,  3;
        add r11, r8;
        add r10, r11;

        mov rax, [r10 + 56];             // flags_ref
        mov rcx, r12;
        and rcx, 0xFFFFFFFF;
        shl rcx, 32;                     // flag_bit << 32
        or  rax, rcx;
        mov [r10 + 56], rax;

        xor rax, rax;
        jmp kek_fs_out;
      kek_fs_bad:
        mov rax, 0xFFFFEB54;             // KEK_BAD_SLOT
      kek_fs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_kek_mint_body(parent_slot, rights, sealed_key_pa, sealed_key_len,
  //                    kdf_algo, salt_lo, salt_hi, flags) -> row_idx | KEK_*
  //
  // The KIND_KEK mint walker. Supervisor-only (no cap-invoke op
  // reaches this). Callable from a future sys_kek_mint or a boot
  // witness after the caller holds a KIND_MEMORY parent cap with
  // RIGHT_MINT.
  //
  // 8-arg SysV shape: rdi=parent_slot, rsi=rights, rdx=sealed_key_pa,
  // rcx=sealed_key_len, r8=kdf_algo, r9=salt_lo. salt_hi and flags
  // arrive on the stack (7th and 8th args). Register plan: six
  // callee-save pushes + sub rsp,8 = 56 bytes; caller's SysV stack
  // args live at [rsp+8+56] (salt_hi) and [rsp+16+56] (flags),
  // matching the C ABI's caller-pushed stack-argument layout.
  // Actually, our simpler shape currently takes 6 args and drops the
  // stack-arg dependency: the callable helpers pass salt as (lo, hi)
  // via r8/r9 and encode flags into kdf_algo's high bits at call
  // sites -- but that trick would violate encoder discipline. Instead
  // we adopt a REDUCED-ARG mint that takes 6 args (parent, rights,
  // sealed_key_pa, sealed_key_len, kdf_algo, salt_lo) and folds
  // salt_hi + flags into deferred setters (matching kind_volume.pdx
  // §5's cap_mint_inner arity collapse discipline). salt_hi and
  // flags default to zero at claim time; setters land alongside the
  // future sys_kek_mint.
  // ==========================================================================

  pub let kind_kek_mint_body : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) (rights: u64) (sealed_key_pa: u64) (sealed_key_len: u64) (kdf_algo: u64) (salt_lo: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): mint KIND_KEK over KIND_MEMORY. Arity-6 collapse (matches kind_volume.pdx §5 cap_mint_inner rationale): salt_hi + flags default to 0 at claim (setters land alongside the future sys_kek_mint / sys_kek_wrap wave). Gate order: (1) parent gate (KIND_MEMORY(4) + RIGHT_MINT(0x200)); (2) rights subset (<= R_KEK_ALL = 0x00F); (3) sealed_key_pa != 0 AND sealed_key_len != 0 AND kdf_algo == 1 (Argon2id); (4) kek_row_alloc(sealed_key_pa, sealed_key_len, kdf_algo, salt_lo, 0, 0). Seven callee-save pushes (rbx=parent_slot, r12=rights, r13=sealed_key_pa, r14=sealed_key_len, r15=kdf_algo, rbp=salt_lo, r10 not preserved so we use a scratch reload) + sub rsp,8 pad -- but only 6 pushes fit in SysV callee-save regs; we push six then reload salt_lo from stack via the incoming r9. Simpler: five callee-save pushes (rbx=parent_slot, r12=rights, r13=sealed_key_pa, r14=sealed_key_len, r15=salt_lo) with kdf_algo staged in rbp. Total 6 pushes + sub rsp,8 = 56 bytes. On success bumps KEK_ST_MINTS; refusal funnel bumps KEK_ST_REFUSED. Effects {mem, sysreg}: mem for row + counter stores; sysreg for rdtsc transitively via kek_row_alloc. Labels prefixed kek_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // parent_slot
        mov r12, rsi;                    // rights
        mov r13, rdx;                    // sealed_key_pa
        mov r14, rcx;                    // sealed_key_len
        mov rbp, r8;                     // kdf_algo
        mov r15, r9;                     // salt_lo

        // (1) Parent gate.
        mov rdi, rbx;
        call kek_check_parent_memory;
        cmp rax, 0;
        je  kek_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r12;
        call kek_rights_valid;
        cmp rax, 0;
        je  kek_mi_bad_rights;

        // (3) Arg validation.
        cmp r13, 0;                      // sealed_key_pa != 0
        je  kek_mi_bad_arg;
        cmp r14, 0;                      // sealed_key_len != 0
        je  kek_mi_bad_arg;
        cmp rbp, 1;                      // kdf_algo == 1 (Argon2id)
        jne kek_mi_bad_arg;

        // (4) Row alloc.
        //   kek_row_alloc(sealed_key_pa, sealed_key_len, kdf_algo,
        //                 salt_lo, salt_hi=0, flags=0)
        mov rdi, r13;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r15;                    // salt_lo
        xor r8,  r8;                     // salt_hi = 0 (deferred)
        xor r9,  r9;                     // flags = 0 (deferred)
        call kek_row_alloc;
        mov r10, 32;                     // KEK_MAX
        cmp rax, r10;
        jae kek_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // KEK_ST_MINTS
        call kek_note;
        pop rax;
        jmp kek_mi_out;

      kek_mi_alloc_fail:
        jmp kek_mi_refused;
      kek_mi_bad_parent:
        mov rax, 0xFFFFEB50;             // KEK_MINT_BAD_PARENT
        jmp kek_mi_refused;
      kek_mi_bad_rights:
        mov rax, 0xFFFFEB51;             // KEK_MINT_BAD_RIGHTS
        jmp kek_mi_refused;
      kek_mi_bad_arg:
        mov rax, 0xFFFFEB52;             // KEK_MINT_BAD_ARG

      kek_mi_refused:
        push rax;
        mov rdi, 5;                      // KEK_ST_REFUSED
        call kek_note;
        pop rax;

      kek_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_kek_narrow_body(row_id, drop_mask) -> 0 | KEK_*
  //
  // Narrow the caller's KEK cap by dropping every right in
  // drop_mask. Row-live + subset gate; descriptor-side rewrite is
  // the caller's responsibility (mirrors kind_volume_snapshot_
  // narrow_body).
  // ==========================================================================

  pub let kind_kek_narrow_body : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (drop_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): narrow gate. (1) kek_row_valid(row_id); (2) drop_mask subset of R_KEK_ALL (0x00F). No stored-rights rewrite here. Labels prefixed kek_nb_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // drop_mask

        mov rdi, rbx;
        call kek_row_valid;
        cmp rax, 0;
        je  kek_nb_bad_slot;

        mov rdi, r12;
        call kek_rights_valid;
        cmp rax, 0;
        je  kek_nb_bad_rights;

        xor rax, rax;
        jmp kek_nb_out;

      kek_nb_bad_slot:
        mov rax, 0xFFFFEB54;             // KEK_BAD_SLOT
        jmp kek_nb_out;
      kek_nb_bad_rights:
        mov rax, 0xFFFFEB55;             // KEK_BAD_RIGHTS

      kek_nb_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_kek(rights, target_ptr, op_arg) -> u64
  //
  // KIND_KEK op dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0];
  // op_arg[63:8] MUST be zero. WRAP / UNWRAP / DERIVE_CHILD arms
  // return KEK_STUB_SENTINEL at MVP (the real Argon2id + ChaCha20-
  // Poly1305 crypto lives in libpdx-volume/src/pdxb_crypto.pdx --
  // this landing wires the AUTHORITY substrate; a follow-up round
  // composes the cap-invoke path against the client-side helpers per
  // design/architecture.md §8.2's seed_ptr discipline). REVOKE is a
  // real op even at MVP: it sets the row's REVOKED flag bit so
  // subsequent WRAP / UNWRAP arms refuse.
  // ==========================================================================

  pub let cap_handler_kek : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.LV11.M5-001 (paideia-os #2224): KIND_KEK ops dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0]; op_arg[63:8] MUST be zero. Row validity checked once before dispatch. Per-op rights gates: WRAP needs R_KEK_WRAP; UNWRAP needs R_KEK_UNWRAP; DERIVE_CHILD needs R_KEK_DERIVE_CHILD; REVOKE needs R_KEK_UNWRAP (revocation is the unwrap-authority holder's prerogative -- no separate revoke right at this landing). Each op checks the row's REVOKED flag bit BEFORE accepting the op: a wrap / unwrap / derive against a revoked row is refused with KEK_BAD_SLOT (semantics: the row is technically live but authoritatively dead). REVOKE sets the flag via kek_row_flag_set. WRAP/UNWRAP/DERIVE_CHILD return KEK_STUB_SENTINEL at MVP -- real crypto composed by libpdx-volume/pdxb_crypto.pdx wrappers in a follow-up round. Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave rsp%16==0 at every nested call (entry rsp%16==8, minus 24 = %16==0); the REVOKE arm saves rax across the counter-bump via the `push rax; sub rsp,8; call; add rsp,8; pop rax;` idiom (matches kvs_hn_op_query). Effects {mem}: reads _kek_table + stat counter + flag_set writes. Labels prefixed kek_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id
        mov r13, rdx;                    // op_arg

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne kek_hn_bad_arg;

        // op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        mov r13, r10;

        // Row validity gate (once, before per-op branches).
        mov rdi, r12;
        call kek_row_valid;
        cmp rax, 0;
        je  kek_hn_bad_slot;

        // Op dispatch.
        cmp r13, 0;
        je  kek_hn_op_wrap;
        cmp r13, 1;
        je  kek_hn_op_unwrap;
        cmp r13, 2;
        je  kek_hn_op_derive;
        cmp r13, 3;
        je  kek_hn_op_revoke;
        jmp kek_hn_bad_slot;

      kek_hn_op_wrap:
        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                  // R_KEK_WRAP
        cmp r10, 0;
        je  kek_hn_bad_rights;
        // Revoked check.
        mov rdi, r12;
        call kek_row_flags;
        and rax, 1;                      // KEK_FLAG_REVOKED bit
        cmp rax, 0;
        jne kek_hn_bad_slot;
        // Bump wraps counter and return sentinel.
        mov rdi, 1;                      // KEK_ST_WRAPS
        call kek_note;
        mov rax, 0xFFFFEB57;             // KEK_STUB_SENTINEL
        jmp kek_hn_out;

      kek_hn_op_unwrap:
        mov r10, rbx;
        and r10, 0x002;                  // R_KEK_UNWRAP
        cmp r10, 0;
        je  kek_hn_bad_rights;
        mov rdi, r12;
        call kek_row_flags;
        and rax, 1;
        cmp rax, 0;
        jne kek_hn_bad_slot;
        mov rdi, 2;                      // KEK_ST_UNWRAPS
        call kek_note;
        mov rax, 0xFFFFEB57;             // KEK_STUB_SENTINEL
        jmp kek_hn_out;

      kek_hn_op_derive:
        mov r10, rbx;
        and r10, 0x004;                  // R_KEK_DERIVE_CHILD
        cmp r10, 0;
        je  kek_hn_bad_rights;
        mov rdi, r12;
        call kek_row_flags;
        and rax, 1;
        cmp rax, 0;
        jne kek_hn_bad_slot;
        mov rdi, 3;                      // KEK_ST_DERIVES
        call kek_note;
        mov rax, 0xFFFFEB57;             // KEK_STUB_SENTINEL
        jmp kek_hn_out;

      kek_hn_op_revoke:
        // Revoke uses the unwrap right (only the authoritative unwrap
        // holder may retire the KEK). Real op: set REVOKED flag.
        mov r10, rbx;
        and r10, 0x002;                  // R_KEK_UNWRAP
        cmp r10, 0;
        je  kek_hn_bad_rights;
        mov rdi, r12;
        mov rsi, 1;                      // KEK_FLAG_REVOKED
        call kek_row_flag_set;
        // rax = 0 on OK; save while we bump counter.
        push rax;
        sub rsp, 8;
        mov rdi, 4;                      // KEK_ST_REVOKES
        call kek_note;
        add rsp, 8;
        pop rax;
        jmp kek_hn_out;

      kek_hn_bad_arg:
        mov rax, 0xFFFFEB56;             // KEK_TAIL_BAD_ARG
        jmp kek_hn_out;
      kek_hn_bad_slot:
        mov rax, 0xFFFFEB54;             // KEK_BAD_SLOT
        jmp kek_hn_out;
      kek_hn_bad_rights:
        mov rax, 0xFFFFEB55;             // KEK_BAD_RIGHTS

      kek_hn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
