  pub let volume_row_mount_slot_set : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (new_mount_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): stamp mount_slot (header bits [55:40]) on a live row for #1707 (mount.pdx). tail_valid gate; new_mount_slot > 0xFFFF or dead row is a no-op. Labels prefixed vol_rms_s_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov r10, 0xFFFF;
        cmp r13, r10;
        ja  vol_rms_s_out;

        mov rdi, r12;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_rms_s_out;

        lea r10, [rip + _volume_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        mov r11, 0xFF0000FFFFFFFFFF;     // clear bits [55:40]
        and rax, r11;
        mov r11, r13;
        shl r11, 40;
        or  rax, r11;
        mov [r10 + 0], rax;

        push rax;
        mov rdi, 4;                      // VOL_ST_REFRESHES
        call volume_note;
        pop rax;

      vol_rms_s_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // Slot -> row_id, gated on the descriptor being a live KIND_VOLUME.
  // Kind constant 0x1A0 staged in r11 (§4).
  pub let volume_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): slot -> row_id gated on KIND_VOLUME. THE ONLY ROUTE IN THE KERNEL FROM A CAP SLOT TO A VOLUME ROW. Labels prefixed vol_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae vol_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1A0;                  // KIND_VOLUME
        cmp r10, r11;
        jne vol_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_ros_none;

        mov rax, r12;
        jmp vol_ros_out;

      vol_ros_none:
        mov rax, 0xFF;                   // VOL_ROW_NONE
      vol_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // volume_cap_revoke(row_id) -> VOL_OK | VOL_BAD_SLOT
  // ==========================================================================
  pub let volume_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): scrub one row via volume_tail_free and bump REVOKES. Refuses out-of-range OR already-dead rows with the same VOL_BAD_SLOT code (the M5-001 registration round does not distinguish 'never existed' from 'already gone' -- basic mint/revoke scope per the design brief; #1706/#1707 may split this later if a caller needs the distinction). Two callee-save pushes leave rsp%16 == 0. Labels prefixed vol_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 16;
        jae vol_cr_bad_slot;

        mov rdi, r12;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_cr_bad_slot;

        mov rdi, r12;
        call volume_tail_free;
        mov rdi, 1;                      // VOL_ST_REVOKES
        call volume_note;
        xor rax, rax;                    // VOL_OK
        jmp vol_cr_out;

      vol_cr_bad_slot:
        mov rax, 0xFFFFED23;             // VOL_BAD_SLOT

      vol_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // volume_cap_mint_inner(parent_slot, rights, hdr, uuid_lo, uuid_hi)
  //   -> row_id | VOL_MINT_*
  //
  // §5: hdr is PRE-PACKED by the caller via volume_hdr_pack; root_inode
  // / mount_gen / inode_count / free_blocks / sig_key_slot are NOT
  // mint-time args (deferred to setters, §1). Gate sequence: (1) parent
  // (KIND_MEMORY + RIGHT_MINT); (2) rights subset; (3) tail_alloc (hdr,
  // uuid_lo, uuid_hi). Five callee-save pushes + sub rsp, 8 = 48 bytes,
  // mirroring inode_handle_cap_mint_inner's shape. Refusal paths bump
  // VOL_ST_REFUSED.
  // ==========================================================================
  pub let volume_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (hdr: u64) (uuid_lo: u64) (uuid_hi: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): the KIND_VOLUME mint walker. Gate sequence: parent (KIND_MEMORY + RIGHT_MINT), rights subset, tail_alloc (hdr, uuid_lo, uuid_hi). Five callee-save pushes + sub rsp, 8 = 48 bytes: post-prologue rsp%16 == 0 for every nested call, mirroring inode_handle_cap_mint_inner. Refusal paths bump VOL_ST_REFUSED. Labels prefixed vol_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov rbx, rdx;                    // hdr
        mov r14, rcx;                    // uuid_lo
        mov r15, r8;                     // uuid_hi

        // (1) Parent gate.
        mov rdi, r12;
        call volume_check_parent_memory;
        cmp rax, 0;
        je  vol_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call volume_rights_valid;
        cmp rax, 0;
        je  vol_mi_bad_rights;

        // (3) tail_alloc (hdr, uuid_lo, uuid_hi).
        mov rdi, rbx;
        mov rsi, r14;
        mov rdx, r15;
        call volume_tail_alloc;
        mov r10, 16;                     // VOL_MAX
        cmp rax, r10;
        jae vol_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // VOL_ST_MINTS
        call volume_note;
        pop rax;
        jmp vol_mi_out;

      vol_mi_alloc_fail:
        jmp vol_mi_refused;
      vol_mi_bad_parent:
        mov rax, 0xFFFFED20;             // VOL_MINT_BAD_PARENT
        jmp vol_mi_refused;
      vol_mi_bad_rights:
        mov rax, 0xFFFFED21;             // VOL_MINT_BAD_RIGHTS

      vol_mi_refused:
        push rax;
        mov rdi, 3;                      // VOL_ST_REFUSED
        call volume_note;
        pop rax;

      vol_mi_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_volume(rights, target_ptr, op_arg) -> ...
  //
  // Wired into cap_invoke_dispatch on `cmp rcx, 0x1A0; je call_kind_volume`.
  // ==========================================================================
  pub let cap_handler_volume : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): KIND_VOLUME dispatch. RIGHTS TESTED PER OP -- QUERY_* need R_VOL_INVOKE; DEBUG_PRINT needs R_VOL_OBSERVE. op_arg[63:8] MUST be zero -- a smuggled second value on an op reaching a volume field is refused rather than masked. Labels prefixed vol_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id in low 16
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne vol_hn_res;

        cmp rbp, 9;                      // VOL_OP_MAX
        ja  vol_hn_unsup;

        cmp rbp, 9;                      // DEBUG_PRINT?
        je  vol_hn_dbg;

        // Query ops need R_VOL_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  vol_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  vol_hn_device_slot;
        cmp rbp, 1;
        je  vol_hn_mount_slot;
        cmp rbp, 2;
        je  vol_hn_uuid_lo;
        cmp rbp, 3;
        je  vol_hn_uuid_hi;
        cmp rbp, 4;
        je  vol_hn_root_inode;
        cmp rbp, 5;
        je  vol_hn_mount_gen;
        cmp rbp, 6;
        je  vol_hn_inode_count;
        cmp rbp, 7;
        je  vol_hn_free_blocks;
        call volume_row_sig_key_slot;    // op == 8
        jmp vol_hn_count;

      vol_hn_device_slot:
        call volume_row_device_slot;
        jmp vol_hn_count;
      vol_hn_mount_slot:
        call volume_row_mount_slot;
        jmp vol_hn_count;
      vol_hn_uuid_lo:
        call volume_row_uuid_lo;
        jmp vol_hn_count;
      vol_hn_uuid_hi:
        call volume_row_uuid_hi;
        jmp vol_hn_count;
      vol_hn_root_inode:
        call volume_row_root_inode;
        jmp vol_hn_count;
      vol_hn_mount_gen:
        call volume_row_mount_gen;
        jmp vol_hn_count;
      vol_hn_inode_count:
        call volume_row_inode_count;
        jmp vol_hn_count;
      vol_hn_free_blocks:
        call volume_row_free_blocks;
        jmp vol_hn_count;

      vol_hn_count:
        push rax;
        mov rdi, 2;                      // VOL_ST_QUERIES
        call volume_note;
        pop rax;
        jmp vol_hn_out;

      vol_hn_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_VOL_OBSERVE
        cmp r10, 0;
        je  vol_hn_denied;
        xor rax, rax;
        jmp vol_hn_out;

      vol_hn_res:
        mov rax, 0xFFFFED22;             // VOL_TAIL_BAD_ARG
        jmp vol_hn_out;
      vol_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp vol_hn_out;
      vol_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      vol_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
