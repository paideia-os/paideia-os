// src/kernel/core/cap/kind_volume.pdx -- R52.M5-001 (#1703)
//
// KIND_VOLUME = 0x1A0, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// The runtime authority for ONE mounted PdxFS-on-block v1 volume: the
// bdev + superblock-cache + journal-state identity that every later
// R52.M5 module (journal_ondisk.pdx #1704, volume_registry.pdx +
// probe.pdx #1706, mount.pdx's MOUNT_BACKEND_PDXFS_BLOCK arm #1707)
// reaches for.  This file registers the ordinal + the basic mint/
// revoke/row-table substrate only (per design/filesystem/
// r52-implementation-plan.md's #1703 scope); the FS-layer probe/mount
// walkers that actually POPULATE a row's superblock-derived fields
// (root_inode, mount_gen, inode_count, free_blocks, sig_key_slot) land
// at #1706/#1707 and use this module's row-setter exports (SECTION 1)
// to do so -- exactly the KIND_PDXFS_FILE precedent (volume_slot /
// inode_lba defaulted to sentinels at #1623's mint, the real values
// wired in at #1697/#1698+).
//
// =============================================================================
// SECTION 0  WHY KIND_VOLUME DERIVES OVER KIND_MEMORY
// =============================================================================
//
// design/filesystem/volume-fs-substrate.md §6.1 names KIND_MEMORY (4)
// -- not a narrower kind -- as KIND_VOLUME's base: "One mounted
// volume; carries device_slot, uuid, root_inode, mount_gen."  A volume
// is not itself a refinement of another derived-kind authority; it is
// the ROOT of the whole PdxFS-on-block authority tree (every
// KIND_PDXFS_FILE, and every KIND_INODE_HANDLE beneath it, ultimately
// traces its volume_slot back to a KIND_VOLUME row).  The derivation
// gate is therefore the same "cannot widen memory reach beyond what
// you already hold" rule KIND_PDXFS_FILE itself uses
// (pdxfs_file_check_parent_memory, kind_pdxfs_file.pdx §0): parent.kind
// == KIND_MEMORY (4) AND rights carry RIGHT_MINT (0x200).
//
// §6.1 also folds a would-be KIND_SUPERBLOCK into KIND_VOLUME
// ("the superblock is a per-volume artefact whose lifetime matches the
// volume mount; a separate cap would have zero use sites"), so this
// row's inode_count / free_blocks fields ARE the superblock summary
// query surface (VOL_OP_QUERY_INODE_COUNT / VOL_OP_QUERY_FREE_BLOCKS
// per §6.1's op list); there is no separate superblock cap.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words):
//
//   [+0]   header: in_use[63:56] | mount_slot[55:40] | device_slot[39:24]
//                  | reserved[23:0]
//   [+8]   uuid_lo         (u64)  -- low 64 bits of the volume's 128-bit UUID
//   [+16]  uuid_hi         (u64)  -- high 64 bits
//   [+24]  root_inode      (u64)  -- 0 at mint; vol_row_root_inode_set
//                                    populates it once the superblock is read
//   [+32]  mount_gen       (u64)  -- 0 at mint; vol_row_mount_gen_set
//   [+40]  inode_count     (u64)  -- 0 at mint; vol_row_inode_count_set
//   [+48]  free_blocks     (u64)  -- 0 at mint; vol_row_free_blocks_set
//   [+56]  sig_key_slot    (u64)  -- VOL_ROW_NONE (0xFF) at mint; the
//                                    KIND_SIG_KEY cap slot bound to this
//                                    volume, vol_row_sig_key_slot_set
//
// device_slot (the KIND_BLKDEV / KIND_NVME_NAMESPACE / KIND_AHCI_PORT
// cap slot backing this volume) and mount_slot (the FS mount-table
// slot, or 0xFFFF while unmounted) are the two small fields known at
// mint time; they pack into the header alongside in_use, matching the
// KIND_INODE_HANDLE header-packing discipline (kind_inode_handle.pdx
// §1).  uuid_lo/uuid_hi are also essential-at-mint identity (the probe
// walker, #1706, reads them straight off the superblock at mint time)
// so they are direct tail_alloc args, not deferred.  Every OTHER wide
// field is a superblock-derived fact the M5-001 registration round has
// no walker to produce yet -- deferred to setters, per the file header
// note above.
//
// Row-addressed capacity: 16 rows x 64 bytes = 1024 bytes, matching
// the volume_registry's own 16-row ceiling (design/filesystem/
// volume-fs-substrate.md §3.4) and the KIND_PDXFS_FILE / KIND_PDXFS_TXN
// 16-row convention.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
//   R_VOL_READ     (0x001) -- read volume-scoped content through the mount
//   R_VOL_WRITE    (0x002) -- reserved; mutating ops arrive through
//                              KIND_PDXFS_TXN, not this cap, but the bit is
//                              held for symmetry with the KIND_PDXFS_FILE /
//                              KIND_INODE_HANDLE family
//   R_VOL_INVOKE   (0x008) -- QUERY ops (device_slot/mount_slot/uuid/
//                              root_inode/mount_gen/inode_count/
//                              free_blocks/sig_key_slot)
//   R_VOL_REVOKE   (0x010) -- teardown the row (volume unmount)
//   R_VOL_REFRESH  (0x020) -- gates the row-setter exports (§1) that
//                              #1706/#1707 use to populate superblock-
//                              derived fields post-mint
//   R_VOL_OBSERVE  (0x400) -- debug printer
//   R_VOL_ALL      (0x43B)
//
// No R_VOL_MINT: nothing derives directly over KIND_VOLUME per §6.1's
// table (KIND_INODE_HANDLE derives over KIND_PDXFS_FILE, not this).
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFED20..0xFFFFED27  (R52.M5 band)
// =============================================================================
//
// design/filesystem/r52-implementation-plan.md §4 assigns the WHOLE
// 8-code M5 band 0xFFFFED20..0xFFFFED27 to the milestone, naming two
// codes for THIS file's domain (VOL_MOUNT_KEY_MISMATCH, VOL_REGISTRY_
// FULL) and leaving four journal codes (JNL_*, owned by
// journal_ondisk.pdx / journal_replay.pdx at #1704/#1705) and two mount
// codes (MOUNT_ROOT_AMBIGUOUS / MOUNT_BACKEND_UNKNOWN, owned by
// mount.pdx at #1707).  This file is the FIRST M5 module to land, so it
// claims the band and defines the two volume-scoped generic cap-
// primitive codes this module's own mint/revoke path needs alongside
// the two design-named ones (VOL_REGISTRY_FULL doubles as this row
// table's ENOSPC -- "16-row table full" is exactly what that name
// means).  JNL_MAGIC_BAD / JNL_CSUM_BAD / JNL_CHECKPOINT_BEYOND_HEAD /
// JNL_SEQ_OUT_OF_ORDER and MOUNT_ROOT_AMBIGUOUS / MOUNT_BACKEND_UNKNOWN
// are declared here as forward-reserved constants (unused by any code
// path in this file) so #1704/#1705/#1707 land against fixed values
// rather than re-deriving the band from the design doc a second time.
//
// This band is DISJOINT from the KIND_INODE_HANDLE cap-primitives band
// (0xFFFFEC60..0xFFFFEC6F) and from every EC-page kind_*.pdx band
// audited at #1699 -- by 2026-08-23 the entire 0xFFFFEC00..0xFFFFECFF
// page is band-claimed end to end (KIND_ELEVATE_CHANNEL through the
// R51.M7/M8 MOUNTW + BDEVFS + KIND_BLKDEV bands), so this M5 registration
// round uses its own explicitly-designed ED-page slice instead of
// hunting for EC-page scraps.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
// Kind-tag constant 0x1A0 (KIND_VOLUME) does not sign-extend cleanly
// from a 32-bit immediate for `cmp reg, imm` forms (same 0x100..0xFFF
// band note as kind_inode_handle.pdx §4); every compare against it
// stages through r11 first.  KIND_MEMORY (4) needs no staging (small
// immediate, matches kind_pdxfs_file.pdx's pdxfs_file_check_parent_memory
// which compares directly).  No mov_b / mov_w / mov_d anywhere in this
// file -- every sub-field is packed/unpacked in full 64-bit registers
// via shift + mask.  No `test` instruction; bit checks use `and` +
// `cmp`.  Labels prefixed `vol_`.
//
// =============================================================================
// SECTION 5  ARITY -- THE cap_mint_inner COLLAPSE
// =============================================================================
//
// A naive `volume_cap_mint_inner(parent_slot, rights, device_slot,
// mount_slot, uuid_lo, uuid_hi, root_inode, mount_gen)` is EIGHT args
// -- impossible.  Design choice made up front, mirroring §1's setter
// deferral: (1) the caller packs device_slot + mount_slot into one
// header word via volume_hdr_pack; (2) root_inode / mount_gen / inode_
// count / free_blocks / sig_key_slot are NOT mint-time args at all --
// they default at claim and are populated later via row setters. That
// reduces cap_mint_inner to (parent_slot, rights, hdr, uuid_lo, uuid_hi)
// = five args, the same shape as kind_inode_handle.pdx's cap_mint_inner.

module KindVolume = structure {

  pub let KIND_VOLUME      : u64 = 0x1A0
  pub let KIND_VOLUME_BASE : u64 = 4       // = KIND_MEMORY (LAM-hint slot)

  pub let R_VOL_READ    : u64 = 0x001
  pub let R_VOL_WRITE   : u64 = 0x002
  pub let R_VOL_INVOKE  : u64 = 0x008
  pub let R_VOL_REVOKE  : u64 = 0x010
  pub let R_VOL_REFRESH : u64 = 0x020
  pub let R_VOL_OBSERVE : u64 = 0x400
  pub let R_VOL_ALL     : u64 = 0x43B

  // Ops. Every op ARITY ONE -- op_arg high bits refused (matches
  // KIND_INODE_HANDLE / KIND_PDXFS_FILE discipline).
  pub let VOL_OP_QUERY_DEVICE_SLOT  : u64 = 0
  pub let VOL_OP_QUERY_MOUNT_SLOT   : u64 = 1
  pub let VOL_OP_QUERY_UUID_LO      : u64 = 2
  pub let VOL_OP_QUERY_UUID_HI      : u64 = 3
  pub let VOL_OP_QUERY_ROOT_INODE   : u64 = 4
  pub let VOL_OP_QUERY_MOUNT_GEN    : u64 = 5
  pub let VOL_OP_QUERY_INODE_COUNT  : u64 = 6
  pub let VOL_OP_QUERY_FREE_BLOCKS  : u64 = 7
  pub let VOL_OP_QUERY_SIG_KEY_SLOT : u64 = 8
  pub let VOL_OP_DEBUG_PRINT        : u64 = 9
  pub let VOL_OP_MAX                : u64 = 9

  // Failure taxonomy. 0xFFFFED20..0xFFFFED27, the whole R52.M5 band
  // (design/filesystem/r52-implementation-plan.md §4). See §3 above.
  pub let VOL_OK                     : u64 = 0
  pub let VOL_MINT_BAD_PARENT        : u64 = 0xFFFFED20
  pub let VOL_MINT_BAD_RIGHTS        : u64 = 0xFFFFED21
  pub let VOL_TAIL_BAD_ARG           : u64 = 0xFFFFED22
  pub let VOL_BAD_SLOT               : u64 = 0xFFFFED23
  pub let VOL_MOUNT_KEY_MISMATCH     : u64 = 0xFFFFED24  // reserved for #1706/#1707
  pub let VOL_REGISTRY_FULL          : u64 = 0xFFFFED25  // this table's ENOSPC
  pub let MOUNT_ROOT_AMBIGUOUS       : u64 = 0xFFFFED26  // reserved for #1707
  pub let MOUNT_BACKEND_UNKNOWN      : u64 = 0xFFFFED27  // reserved for #1707

  // Reserved for #1704/#1705 (journal_ondisk.pdx / journal_replay.pdx).
  // Declared here (not there) because this file lands first and claims
  // the M5 band; #1704/#1705 import these names rather than re-deriving
  // them.  Unused by any code path in this file.
  pub let JNL_MAGIC_BAD              : u64 = 0xFFFFED20
  pub let JNL_CSUM_BAD               : u64 = 0xFFFFED21
  pub let JNL_CHECKPOINT_BEYOND_HEAD : u64 = 0xFFFFED22
  pub let JNL_SEQ_OUT_OF_ORDER       : u64 = 0xFFFFED23

  pub let VOL_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let VOL_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let VOL_MAX       : u64 = 16
  pub let VOL_ROW_BYTES : u64 = 64
  // 16 rows * 64 bytes = 1024 bytes = 128 u64.
  pub let mut _volume_table : [u64; 128] = uninit @align(64)
  pub let mut _volume_stats : [u64; 8]   = uninit @align(64)

  pub let VOL_ST_MINTS     : u64 = 0
  pub let VOL_ST_REVOKES   : u64 = 1
  pub let VOL_ST_QUERIES   : u64 = 2
  pub let VOL_ST_REFUSED   : u64 = 3
  pub let VOL_ST_REFRESHES : u64 = 4
  pub let VOL_ST_MAX       : u64 = 8

  pub let volume_dbg_msg : [u8; 13] = "VOLUME ROW\0\0\0"

  // ==========================================================================
  // volume_table_reset() -> ()
  //
  // Clear every row and every counter. Boot and teardown only. Two
  // separate loops mirror kind_inode_handle's shape.
  // ==========================================================================
  pub let volume_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): clear every row and every counter. Boot and teardown only. Labels prefixed vol_rs_.",
      block: {
        lea r10, [rip + _volume_table];
        xor rax, rax;
        xor rcx, rcx;
      vol_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  vol_rs_rows;

        lea r10, [rip + _volume_stats];
        xor rcx, rcx;
      vol_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vol_rs_stats;
        ret
      }
    }

  pub let volume_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): bounded increment; out-of-range no-op. Labels prefixed vol_nt_.",
      block: {
        cmp rdi, 8;
        jae vol_nt_out;
        lea r10, [rip + _volume_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vol_nt_out:
        ret
      }
    }

  pub let volume_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): bounded read; out-of-range returns 0. Labels prefixed vol_st_.",
      block: {
        cmp rdi, 8;
        jae vol_st_zero;
        lea r10, [rip + _volume_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vol_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let volume_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M5-001 (#1703): subset test against R_VOL_ALL = 0x43B. Labels prefixed vol_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x43B;
        and rax, r10;
        cmp rax, rdi;
        jne vol_rv_no;
        mov rax, 1;
        ret;
      vol_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // volume_check_parent_memory(parent_slot) -> 1 | 0
  //
  // Derivation gate. parent.kind == KIND_MEMORY (4) AND rights carry
  // RIGHT_MINT (0x200). Mirrors pdxfs_file_check_parent_memory exactly
  // -- KIND_VOLUME is a second root-of-authority cap over bare memory,
  // same as KIND_PDXFS_FILE (§0). Pure read.
  // ==========================================================================
  pub let volume_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M5-001 (#1703): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_MEMORY (4) AND (rights & RIGHT_MINT 0x200) != 0. Mirrors kind_pdxfs_file.pdx's pdxfs_file_check_parent_memory one-for-one -- KIND_MEMORY(4) is a small immediate, no r11 staging needed. Pure read. Labels prefixed vol_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae vol_cpm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne vol_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  vol_cpm_no;

        mov rax, 1;
        ret;

      vol_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // volume_hdr_pack(device_slot, mount_slot) -> hdr | VOL_DECODE_BAD
  //
  // device_slot must fit 16 bits (bits [39:24]); mount_slot must fit 16
  // bits (bits [55:40], caller passes 0xFFFF for "not yet mounted").
  // Bits [63:56] MUST leave this function zero -- that byte belongs to
  // the allocator's in_use flag.
  // ==========================================================================
  pub let volume_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (mount_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R52.M5-001 (#1703): canonical header encoder. device_slot fits [39:24] (< 0x10000), mount_slot fits [55:40] (< 0x10000). Bits [63:56] left zero for the allocator's in_use flag. Labels prefixed vol_hp_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vol_hp_bad;

        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  vol_hp_bad;

        mov rax, rdi;
        shl rax, 24;                     // device_slot in [39:24]
        mov r11, rsi;
        shl r11, 40;                     // mount_slot in [55:40]
        or  rax, r11;
        ret;

      vol_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // volume_tail_alloc(hdr, uuid_lo, uuid_hi) -> row_id | VOL_TAIL_* | VOL_REGISTRY_FULL
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A VOLUME ROW;
  // tools/build.sh confines relocations against _volume_table to this
  // object. Gates: hdr in_use pre-set -> VOL_TAIL_BAD_ARG. uuid_lo ==
  // uuid_hi == 0 is refused (the all-zero UUID is never a valid PdxFS
  // volume identity -- mkfs generates a random one, superblock.pdx §2.1).
  // root_inode / mount_gen / inode_count / free_blocks default to 0;
  // sig_key_slot defaults to VOL_ROW_NONE (0xFF). Low-first scan over
  // 16 rows of 64 bytes (power-of-2 stride: row_id << 6). Four
  // callee-save pushes mirror inode_handle_tail_alloc's shape.
  // ==========================================================================
  pub let volume_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (uuid_lo: u64) (uuid_hi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): claim one volume row. THE ONLY WRITER of _volume_table; tools/build.sh confines it via ec_confine_one. Gates: hdr in_use pre-set -> VOL_TAIL_BAD_ARG; uuid_lo == uuid_hi == 0 -> VOL_TAIL_BAD_ARG. Low-first scan over 16 rows of 64 bytes. Labels prefixed vol_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // uuid_lo
        mov r14, rdx;                    // uuid_hi

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne vol_ta_bad;

        // uuid all-zero refused.
        mov rax, r13;
        or  rax, r14;
        cmp rax, 0;
        je  vol_ta_bad;

        xor rbx, rbx;                    // row_id
      vol_ta_scan:
        cmp rbx, 16;                     // VOL_MAX
        jae vol_ta_enospc;

        lea r10, [rip + _volume_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vol_ta_claim;

        add rbx, 1;
        jmp vol_ta_scan;

      vol_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header + in_use
        mov [r10 + 8],  r13;             // uuid_lo
        mov [r10 + 16], r14;             // uuid_hi
        xor rax, rax;
        mov [r10 + 24], rax;             // root_inode = 0
        mov [r10 + 32], rax;             // mount_gen = 0
        mov [r10 + 40], rax;             // inode_count = 0
        mov [r10 + 48], rax;             // free_blocks = 0
        mov rax, 0xFF;
        mov [r10 + 56], rax;             // sig_key_slot = VOL_ROW_NONE
        mov rax, rbx;
        jmp vol_ta_out;

      vol_ta_enospc:
        mov rax, 0xFFFFED25;             // VOL_REGISTRY_FULL
        jmp vol_ta_out;
      vol_ta_bad:
        mov rax, 0xFFFFED22;             // VOL_TAIL_BAD_ARG

      vol_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let volume_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): 1 iff row_id < VOL_MAX and in_use byte set. Labels prefixed vol_tv_.",
      block: {
        cmp rdi, 16;
        jae vol_tv_no;
        lea r10, [rip + _volume_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vol_tv_no;
        mov rax, 1;
        ret;
      vol_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let volume_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): scrub row (all eight words). Labels prefixed vol_tf_.",
      block: {
        cmp rdi, 16;
        jae vol_tf_out;
        lea r10, [rip + _volume_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      vol_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors. Each returns VOL_DECODE_BAD when the row is not
  // live. Shape mirrors inode_handle_row_* / pdxfs_file_row_* one-for-
  // one.
  // -------------------------------------------------------------------

  pub let volume_row_device_slot : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): device_slot (header bits [39:24]), or VOL_DECODE_BAD. Labels prefixed vol_rds_.",
      block: {
        push r12;
        mov r12, rdi;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_rds_bad;
        lea r10, [rip + _volume_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 24;
        mov r10, 0xFFFF;
        and rax, r10;
        jmp vol_rds_out;
      vol_rds_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vol_rds_out:
        pop r12;
        ret
      }
    }

  pub let volume_row_mount_slot : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): mount_slot (header bits [55:40]), or VOL_DECODE_BAD. Labels prefixed vol_rms_.",
      block: {
        push r12;
        mov r12, rdi;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_rms_bad;
        lea r10, [rip + _volume_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 40;
        mov r10, 0xFFFF;
        and rax, r10;
        jmp vol_rms_out;
      vol_rms_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vol_rms_out:
        pop r12;
        ret
      }
    }

