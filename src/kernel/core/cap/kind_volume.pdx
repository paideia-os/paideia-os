  pub let volume_row_sig_key_slot_set : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (new_sig_key_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): stamp sig_key_slot on a live row for #1706/#1707. tail_valid gate; dead row is a no-op. Labels prefixed vol_rsk_s_.",
      block: {
        push r12;
        mov r12, rdi;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_rsk_s_out;
        lea r10, [rip + _volume_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 56], rsi;
        push rax;
        mov rdi, 4;                      // VOL_ST_REFRESHES
        call volume_note;
        pop rax;
      vol_rsk_s_out:
