  // ==========================================================================
  // Row setters. Internal exports for #1706 (probe.pdx) / #1707
  // (mount.pdx) to populate superblock-derived fields once they walk a
  // live volume -- NOT wired into cap_handler_volume's op dispatch
  // (mirrors inode_handle_row_cached_gen_set's precedent: a mutator
  // called directly by trusted FS-layer code, not reachable through
  // cap_invoke). tail_valid-gated; dead row is a silent no-op.
  // ==========================================================================

  pub let volume_row_root_inode_set : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (new_root_inode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): stamp root_inode on a live row for #1706/#1707. tail_valid gate; dead row is a no-op. Labels prefixed vol_rri_s_.",
      block: {
        push r12;
        mov r12, rdi;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_rri_s_out;
        lea r10, [rip + _volume_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 24], rsi;
        push rax;
        mov rdi, 4;                      // VOL_ST_REFRESHES
        call volume_note;
        pop rax;
      vol_rri_s_out:
        pop r12;
        ret
      }
    }

  pub let volume_row_mount_gen_set : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (new_mount_gen: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-001 (#1703): stamp mount_gen on a live row for #1706/#1707. tail_valid gate; dead row is a no-op. Labels prefixed vol_rmg_s_.",
      block: {
        push r12;
        mov r12, rdi;
        call volume_tail_valid;
        cmp rax, 0;
        je  vol_rmg_s_out;
        lea r10, [rip + _volume_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 32], rsi;
        push rax;
        mov rdi, 4;                      // VOL_ST_REFRESHES
        call volume_note;
        pop rax;
      vol_rmg_s_out:
        pop r12;
        ret
      }
    }

