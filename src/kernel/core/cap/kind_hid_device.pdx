      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_device_row_hdr;
        mov r13, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  hidd_rpa_bad;
        mov rdi, r13;
