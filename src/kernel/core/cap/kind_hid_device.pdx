  // ==========================================================================
  // hid_device_find_by_key(hid_key) -> row_id | HID_ROW_NONE
  // ==========================================================================

  pub let hid_device_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (hid_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): the live row holding this device key, or HID_ROW_NONE (0xFF). Linear scan over 8 rows. THE UNIQUENESS TEST §2's second gate needs: two live HID capabilities over one device means two class drivers claiming its report stream and the one that installs last decides. Refuses to match a hid_key of 0 at all, so a fabricated parent cannot collide with, or be found by, the sentinel hid_device_parent_key returns for a bad slot. Sentinel is 0xFF because row 0 is a legitimate answer. Leaf. Labels prefixed hidd_fk_.",
      block: {
        cmp rdi, 0;
        je  hidd_fk_none;
        xor rcx, rcx;
      hidd_fk_scan:
        cmp rcx, 8;                      // HID_MAX
        jae hidd_fk_none;
        lea r10, [rip + _hid_device_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hidd_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  hidd_fk_hit;
      hidd_fk_next:
        add rcx, 1;
        jmp hidd_fk_scan;
      hidd_fk_hit:
        mov rax, rcx;
        ret;
      hidd_fk_none:
        mov rax, 0xFF;                   // HID_ROW_NONE
        ret
      }
    }

  // ==========================================================================
  // hid_device_row_of_slot(slot) -> row_id | HID_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let hid_device_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): slot -> row_id, gated on the descriptor being a live KIND_HID_DEVICE. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A HID DEVICE ROW, and ARITY ONE so the row a caller reaches is the row its capability names. Every function below that touches a report_id_count or an identity goes through it. Returns HID_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Pure read. Labels prefixed hidd_ros_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae hidd_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x15b;                  // KIND_HID_DEVICE
        cmp r10, r11;
        jne hidd_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call hid_device_tail_valid;
        cmp rax, 0;
        je  hidd_ros_none;

        mov rax, r12;
        jmp hidd_ros_out;

      hidd_ros_none:
        mov rax, 0xFF;                   // HID_ROW_NONE
      hidd_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Slot-arity-one resolvers. ARITY ONE, pinned by tools/build.sh.
  // ==========================================================================

  pub let hid_device_rid_count_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): report_id_count of the HID device this capability names. ARITY ONE, PINNED BY tools/build.sh. A second parameter -- any second parameter -- is how a caller-supplied count would reach the row: `rid_count_of_slot(slot, default_count)` reads as a convenience and is a way to widen a device's advertised report table; neither is expressible against a one-argument signature. Labels prefixed hidd_rcs_.",
      block: {
        push r12;
        push r13;
        push r14;
        call hid_device_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  hidd_rcs_bad;
        mov rdi, r12;
        call hid_device_row_rid_count;
        jmp hidd_rcs_out;
      hidd_rcs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hidd_rcs_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_device_vendor_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): vendor_id ordinal, or HID_DECODE_BAD. ARITY ONE for the same reason rid_count_of_slot is. Labels prefixed hidd_vos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call hid_device_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  hidd_vos_bad;
        mov rdi, r12;
        call hid_device_row_vendor;
        jmp hidd_vos_out;
      hidd_vos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hidd_vos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_device_product_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): product_id ordinal, or HID_DECODE_BAD. ARITY ONE. Labels prefixed hidd_pos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call hid_device_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  hidd_pos_bad;
        mov rdi, r12;
        call hid_device_row_product;
        jmp hidd_pos_out;
      hidd_pos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hidd_pos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_device_transport_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): transport ordinal, or HID_DECODE_BAD. ARITY ONE. Labels prefixed hidd_tos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call hid_device_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  hidd_tos_bad;
        mov rdi, r12;
        call hid_device_row_transport;
        jmp hidd_tos_out;
      hidd_tos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hidd_tos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hid_device_report_install(slot) -> HID_OK | ...
  //
  // §3. THE ONE COUNTER PRIMITIVE. ARITY ONE.
  // ==========================================================================

  pub let hid_device_report_install : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): note that one report was installed against the class driver for the device this capability names. ARITY ONE AND NO MORE: a capability, and nothing else. A second argument would be a report byte, or a report id, or a pointer to one, and every one of those is a way for the caller to feed the class driver's next parse from an address of its choosing. Not expressible against a one-argument signature -- which is why §3 exists and why this signature is pinned by tools/build.sh. Gates: (1) the slot must name a live KIND_HID_DEVICE -> HID_BAD_SLOT / HID_WRONG_KIND via hid_device_row_of_slot, reusing the checks every other path uses rather than restating them. (2) install: increment the state-word report count in place and HID_ST_REPORTS overall. NOTHING DRIVES A TRANSPORT and NOTHING ROUTES A REPORT: this is §4's design decision, stated once in the file header. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed hidd_rin_.",
      block: {
        push rbx;
        push r12;
        push r13;

        call hid_device_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;                   // HID_ROW_NONE
        je  hidd_rin_bad_slot;

        // Load row base for the counter update.
        lea r10, [rip + _hid_device_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        // state word: reports in bits [63:32]; low 32 stay reserved-zero.
        mov rax, [r10 + 56];
        mov r11, rax;
        shr r11, 32;
        add r11, 1;
        mov r12, 0xFFFFFFFF;             // low-32 mask
        and rax, r12;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 56], rax;

        // Global counter.
        mov rdi, 0;                      // HID_ST_REPORTS
        call hid_device_note;

        xor rax, rax;                    // HID_OK
        jmp hidd_rin_out;

      hidd_rin_bad_slot:
        mov rax, 0xFFFFFE84;             // HID_BAD_SLOT

      hidd_rin_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_device_cap_mint_inner(slot, parent_slot, rights, index,
  //                           transport, ids_and_rid)
  //
  // `ids_and_rid` packs vendor in [15:0], product in [31:16], and
  // report_id_count in [47:32]. Bits [63:48] reserved zero.
  // ==========================================================================

  pub let hid_device_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (transport: u64) (ids_and_rid: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): mint a KIND_HID_DEVICE over a KIND_DEVICE. `ids_and_rid` packs vendor_id in bits [15:0], product_id in bits [31:16] and report_id_count in bits [47:32] -- a compact encoding that stays within the SysV six-register limit and, more importantly, keeps the three device-identity fields indivisible on the control path. Reserved bits [63:48] MUST be zero. Gates, in order: (1) slot < 256 -> HID_BAD_SLOT. (2) hid_device_check_parent_device -> HID_MINT_BAD_PARENT (the half that discriminates NOTHING, §2). (3) hid_device_rights_valid -> HID_MINT_BAD_RIGHTS. (4) index < HID_INDEX_MAX -> HID_MINT_BAD_INDEX. (5) transport in [1, HID_TRANSPORT_MAX] -> HID_MINT_BAD_TRANSPORT (UNKNOWN refused per §5). (6) ids_and_rid reserved [63:48] non-zero -> HID_MINT_BAD_IDS; vendor == 0 AND product == 0 -> HID_MINT_BAD_IDS (the USB reserved placeholder). (7) rid_count > HID_REPORT_ID_MAX -> HID_MINT_BAD_RID_COUNT. (8) INHERIT the identity: hid_device_parent_key(parent_slot); 0 -> HID_MINT_NO_DEVICE. (9) UNIQUENESS: hid_device_find_by_key must answer HID_ROW_NONE -> HID_MINT_IN_USE. Two capabilities over one device means two class drivers stamping report_install into one counter. (10) hdr_pack(parent_slot) then tail_alloc -> HID_MINT_ENOSPC on exhaustion. (11) cap_mint_write(slot, KIND_HID_DEVICE, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed hidd_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // index
        mov r15, r8;                     // transport
        mov rbp, r9;                     // ids_and_rid

        mov r10, 256;
        cmp rbx, r10;
        jae hidd_mi_bad_slot;

        mov rdi, r12;
        call hid_device_check_parent_device;
        cmp rax, 0;
        je  hidd_mi_bad_parent;

        mov rdi, r13;
        call hid_device_rights_valid;
        cmp rax, 0;
        je  hidd_mi_bad_rights;

        mov r10, 16;                     // HID_INDEX_MAX
        cmp r14, r10;
        jae hidd_mi_bad_index;

        mov rdi, r15;
        call hid_device_transport_valid;
        cmp rax, 0;
        je  hidd_mi_bad_transport;

        // Reserved bits [63:48] of ids_and_rid.
        mov rax, rbp;
        shr rax, 48;
        cmp rax, 0;
        jne hidd_mi_bad_ids;

        // Unpack vendor, product, rid_count.
        mov r10, rbp;
        mov r11, 0xFFFF;
        and r10, r11;                    // vendor
        mov rax, rbp;
        shr rax, 16;
        and rax, r11;                    // product
        mov rcx, rbp;
        shr rcx, 32;
        mov r11, 0xFFFF;
        and rcx, r11;                    // rid_count (16 bits worth, we know it <= 256)

        // Refuse 0000:0000.
        mov r11, r10;
        or  r11, rax;
        cmp r11, 0;
        je  hidd_mi_bad_ids;

        // rid_count bound.
        mov r11, 256;                    // HID_REPORT_ID_MAX
        cmp rcx, r11;
        ja  hidd_mi_bad_rid_count;

        // Stash the trio; we still need parent_slot in r12 for the
        // key lookup and hdr pack. Pack ids for tail_alloc as
        // (vendor | product << 16), which is the shape it consumes.
        push r10;                        // save vendor for later
        push rax;                        // save product for later
        push rcx;                        // save rid_count for later

        mov rdi, r12;
        call hid_device_parent_key;
        cmp rax, 0;
        je  hidd_mi_no_device_pop3;

        // Stash the key.
        push rax;
        sub rsp, 8;                      // keep rsp%16 == 0
        mov rdi, rax;
        call hid_device_find_by_key;
        add rsp, 8;
        pop r10;                         // r10 = hid_key
        cmp rax, 0xFF;                   // HID_ROW_NONE
        jne hidd_mi_in_use_pop3;

        // hdr_pack.
        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call hid_device_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  hidd_mi_bad_parent_pop3;

        // Retrieve rid_count/product/vendor from earlier pushes.
        // Stack layout at this point: [rsp+0] = rid_count,
        // [rsp+8] = product, [rsp+16] = vendor.
        mov r9, [rsp + 0];               // rid_count -> r9
        mov r11, [rsp + 8];              // product
        mov rcx, [rsp + 16];             // vendor
        // Build ids arg for tail_alloc: vendor | (product << 16).
        shl r11, 16;
        or  rcx, r11;                    // ids
        // Now call tail_alloc:
        //   rdi = hdr (in rax currently)
        //   rsi = hid_key (r10)
        //   rdx = index (r14)
        //   rcx = transport (r15) -- BUT rcx holds ids now
        //   r8  = ids (currently in rcx)
        //   r9  = rid_count (already there)
        // Wait — tail_alloc signature is:
        //   (hdr, hid_key, index, transport, ids, rid_count)
        // So: rdi=hdr, rsi=hid_key, rdx=index, rcx=transport, r8=ids, r9=rid_count.
        // Move: rdi = rax; rsi = r10; rdx = r14; then rcx=r15; r8 = ids-in-rcx.
        // Do it in an order that doesn't clobber source before use.
        mov r8, rcx;                     // r8 = ids
        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // hid_key
        mov rdx, r14;                    // index
        mov rcx, r15;                    // transport
        call hid_device_tail_alloc;

        // Pop the three save slots.
        add rsp, 24;

        mov r10, 0xFFFFFE8F;             // HID_TAIL_ENOSPC
        cmp rax, r10;
        je  hidd_mi_enospc;
        mov r10, 0xFFFFFE8E;             // HID_TAIL_BAD_ARG
        cmp rax, r10;
        je  hidd_mi_bad_ids;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x15b;                  // KIND_HID_DEVICE
        mov rdx, r13;                    // rights
        mov rcx, r14;
        call cap_mint_write;

        xor rax, rax;                    // HID_OK
        jmp hidd_mi_out;

      hidd_mi_no_device_pop3:
        add rsp, 24;
        jmp hidd_mi_no_device;
      hidd_mi_in_use_pop3:
        add rsp, 24;
        jmp hidd_mi_in_use;
      hidd_mi_bad_parent_pop3:
        add rsp, 24;
        jmp hidd_mi_bad_parent;

      hidd_mi_bad_slot:
        mov rax, 0xFFFFFE84;
        jmp hidd_mi_out;
      hidd_mi_bad_parent:
        mov rax, 0xFFFFFE8D;
        jmp hidd_mi_out;
      hidd_mi_bad_rights:
        mov rax, 0xFFFFFE8C;
        jmp hidd_mi_out;
      hidd_mi_bad_index:
        mov rax, 0xFFFFFE8B;
        jmp hidd_mi_out;
      hidd_mi_bad_transport:
        mov rax, 0xFFFFFE8A;
        jmp hidd_mi_out;
      hidd_mi_bad_ids:
        mov rax, 0xFFFFFE89;
        jmp hidd_mi_out;
      hidd_mi_bad_rid_count:
        mov rax, 0xFFFFFE88;
        jmp hidd_mi_out;
      hidd_mi_no_device:
        mov rax, 0xFFFFFE87;
        jmp hidd_mi_out;
      hidd_mi_enospc:
        mov rax, 0xFFFFFE86;
        jmp hidd_mi_out;
      hidd_mi_in_use:
        mov rax, 0xFFFFFE85;

      hidd_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hid_device_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (transport: u64) (ids_and_rid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): audited mint. Same shape as backlight_cap_mint. Putting emission in the wrapper means a second mint path cannot exist without being audited. Four pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call hid_device_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x15b;                  // KIND_HID_DEVICE
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hid_device_cap_revoke_inner(slot) -> HID_OK | ...
  // ==========================================================================

  pub let hid_device_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): revoke a KIND_HID_DEVICE. (1) slot < 256 -> HID_BAD_SLOT. (2) kind == 0 -> HID_REVOKE_ALREADY, idempotent and distinct so a caller can tell 'nothing to do' from 'done'. (3) kind != 0x15b -> HID_WRONG_KIND, which is what stops a HID-device revoke from freeing another kind's row through a coincidentally-shaped target_ptr and is what makes it safe for the owner-column sweep to call this blindly. (4) row_id from target_ptr[15:0]; if live, hid_device_tail_free scrubs it, which is what makes the device RE-MINTABLE. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0) rather than three raw stores, per #1579. NOTHING DRIVES A TRANSPORT. Revoking authority over a device leaves the transport itself untouched; that is deliberate. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed hidd_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae hidd_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  hidd_rvk_already;

        mov r11, 0x15b;                  // KIND_HID_DEVICE
        cmp r10, r11;
        jne hidd_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call hid_device_tail_valid;
        cmp rax, 0;
        je  hidd_rvk_clear;

        mov rdi, r13;
        call hid_device_tail_free;

      hidd_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // HID_OK
        jmp hidd_rvk_out;

      hidd_rvk_bad_slot:
        mov rax, 0xFFFFFE84;
        jmp hidd_rvk_out;
      hidd_rvk_wrong_kind:
        mov rax, 0xFFFFFE83;
        jmp hidd_rvk_out;
      hidd_rvk_already:
        mov rax, 0xFFFFFE82;

      hidd_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hid_device_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS, so a process death leaves the same audit trail a deliberate teardown would. NO cascade: nothing in this tree derives from a HID device capability (KIND_HID_EVENT is a separate lineage rooted at KIND_IPC_ENDPOINT). Three pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call hid_device_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x15b;                  // KIND_HID_DEVICE
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // hid_device_debug_print(row_id) -> HID_OK | HID_TAIL_BAD_ARG
  // ==========================================================================

  pub let hid_device_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R32.M3-001 (#1125): canonical printer for one HID device row. Refuses a dead or out-of-range row with HID_TAIL_BAD_ARG rather than printing zeroes: a freed row renders as {idx 0, transport 0 (UNKNOWN), vendor 0, product 0, rid_count 0, reports 0}, which is a plausible-looking device with no reports declared -- the most misleading six values this module could emit. Six KV lines. r12 holds row_id across the calls; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed hidd_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call hid_device_tail_valid;
        cmp rax, 0;
        je  hidd_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hidd_dbg_msg];
        lea rcx, [rip + hidd_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call hid_device_row_index;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hidd_dbg_msg];
        lea rcx, [rip + hidd_k_idx];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call hid_device_row_transport;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hidd_dbg_msg];
        lea rcx, [rip + hidd_k_trp];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call hid_device_row_vendor;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hidd_dbg_msg];
        lea rcx, [rip + hidd_k_ven];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call hid_device_row_product;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hidd_dbg_msg];
        lea rcx, [rip + hidd_k_prd];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call hid_device_row_rid_count;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hidd_dbg_msg];
        lea rcx, [rip + hidd_k_rid];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // HID_OK
        jmp hidd_dp_out;

      hidd_dp_bad:
        mov rax, 0xFFFFFE8E;             // HID_TAIL_BAD_ARG

      hidd_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_hid_device(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_hid_device : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): KIND_HID_DEVICE dispatch handler. Emits cap_hid_device_msg on entry. row_id = target_ptr[15:0] and slot = target_ptr[31:16], both from the DESCRIPTOR (which only cap_mint_write writes); op = op_arg[7:0]. RIGHTS PER OP: QUERY_INDEX / QUERY_TRANSPORT / QUERY_VENDOR / QUERY_PRODUCT / QUERY_RID_COUNT / QUERY_REPORTS / QUERY_PARENT require R_HID_INVOKE; DEBUG_PRINT requires R_HID_OBSERVE; REPORT_INSTALL requires R_HID_REPORT. THE OP THAT IS ABSENT is any setter for report_id_count, vendor, product or transport: nothing in this handler can raise or lower a static field, and R_HID_MINT is consequently a right this handler never reads. OPS 0..7 TAKE NO OPERAND. OP 8 (REPORT_INSTALL) takes NO OPERAND either — the whole op_arg[63:8] is REFUSED with HID_TAIL_BAD_ARG rather than masked. The reason: this op has arity ONE precisely because a payload would be a report byte or a pointer to one (§3), and admitting op_arg[63:8] as anything but zero would be re-opening that door under the dispatch instead of under the primitive. Unknown op -> INVOKE_UNSUPPORTED; rights failure -> INVOKE_DENIED. Every query returns HID_DECODE_BAD for a dead row and never a plausible zero, because 0 is a legitimate index and a legitimate report count. r12=rights, r13=row_id, rbx=slot, r14=op; six pushes leave rsp%16 == 0 at every nested call. Labels prefixed hidd_h_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot   = target_ptr[31:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_hid_device_msg];
        call klog_s1;

        // Decode op and reserved.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov r11, r14;
        shr r11, 8;                      // reserved bits [63:8]
        mov r14, r10;                    // r14 = op from here on

        cmp r14, 8;                      // HID_OP_MAX
        ja  hidd_h_unsup;

        cmp r14, 8;                      // HID_OP_REPORT_INSTALL
        je  hidd_h_report_gate;

        cmp r14, 7;                      // HID_OP_DEBUG_PRINT
        je  hidd_h_dbg;

        // Ops 0..6: all INVOKE.
        mov r10, r12;
        and r10, 0x008;                  // R_HID_INVOKE
        cmp r10, 0;
        je  hidd_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  hidd_h_idx;
        cmp r14, 1;
        je  hidd_h_trp;
        cmp r14, 2;
        je  hidd_h_ven;
        cmp r14, 3;
        je  hidd_h_prd;
        cmp r14, 4;
        je  hidd_h_ric;
        cmp r14, 5;
        je  hidd_h_rep;
        call hid_device_row_parent;
        jmp hidd_h_out;

      hidd_h_report_gate:
        // REPORT_INSTALL takes NO OPERAND: op_arg[63:8] MUST be zero.
        cmp r11, 0;
        jne hidd_h_res;

        mov r10, r12;
        and r10, 0x002;                  // R_HID_REPORT
        cmp r10, 0;
        je  hidd_h_denied;

        mov rdi, rbx;                    // slot
        call hid_device_report_install;
        jmp hidd_h_out;

      hidd_h_idx:
        call hid_device_row_index;
        jmp hidd_h_out;
      hidd_h_trp:
        call hid_device_row_transport;
        jmp hidd_h_out;
      hidd_h_ven:
        call hid_device_row_vendor;
        jmp hidd_h_out;
      hidd_h_prd:
        call hid_device_row_product;
        jmp hidd_h_out;
      hidd_h_ric:
        call hid_device_row_rid_count;
        jmp hidd_h_out;
      hidd_h_rep:
        call hid_device_row_reports;
        jmp hidd_h_out;

      hidd_h_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_HID_OBSERVE
        cmp r10, 0;
        je  hidd_h_denied;
        mov rdi, r13;
        call hid_device_debug_print;
        jmp hidd_h_out;

      hidd_h_res:
        mov rax, 0xFFFFFE8E;             // HID_TAIL_BAD_ARG
        jmp hidd_h_out;
      hidd_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp hidd_h_out;
      hidd_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      hidd_h_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
