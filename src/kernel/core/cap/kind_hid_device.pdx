// src/kernel/core/cap/kind_hid_device.pdx — R32.M3-001 (#1125)
//
// KIND_HID_DEVICE = 0x15b, derived over KIND_DEVICE (10).
//
// The authority to hold ONE HID device's static identity — index,
// transport (I2C/USB/BT/UNKNOWN), USB-shaped {vendor_id, product_id}
// pair, and how many distinct report IDs its report descriptor
// declares — and to be told, monotonically, that its owner installed
// one report against the class driver.
//
// =============================================================================
// §0  UNITS: EVERY FIELD IS AN ORDINAL, NOT A HANDLE
// =============================================================================
//
// HID devices are named to the class driver by DEVICE IDENTITY
// (vendor:product), reached through a TRANSPORT (i2c-hid, usb-hid, an
// hci-bt hid profile), and speak to it via REPORTS whose ids are
// declared in the descriptor the transport already fetched (see
// src/kernel/core/drivers/hid/report_parser.pdx §0). This row stores
// exactly those five values, plus its lifetime install count. There is
// no pointer, no MMIO base, no interrupt vector, and no i2c address:
// what makes a report reach the wire is the transport capability, and
// where it lands in a subscriber is the KIND_HID_EVENT subscription
// (#1126) that sits alongside this one. This kind is the AUTHORITY to
// name a device to those two, and its whole surface is queries plus
// one no-payload counter.
//
// The one silent failure a shape like this is prone to is IDENTITY
// SUBSTITUTION: a row that could be re-stamped in place with a
// different vendor:product would let one policy decision act as if it
// were about another device. §1 states the discipline that makes it
// unrepresentable: vendor, product, transport and index are ROW
// IDENTITY, set once at mint, and there is no primitive anywhere in
// this module that changes them.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS INSTALLED
// =============================================================================
//
// Same discipline as `kind_backlight.pdx` §1 and `kind_battery.pdx`
// §1. `index`, `transport`, `vendor_id`, `product_id` and
// `report_id_count` are ROW IDENTITY — they name the physical device
// and the shape of its report stream — and are refused to a mint that
// supplies implausible values. The dynamic field (lifetime report
// count) starts at zero and is bumped by `hid_device_report_install`,
// REACHABLE ONLY THROUGH THE ROUTED ASSESSMENT: capability in, nothing
// else, out.
//
// WHAT `brightness_max` IS TO A BACKLIGHT, `report_id_count` IS TO A
// HID DEVICE. It is set once by the mint and there is no primitive
// anywhere that changes it. A count that could be raised by a caller
// would let a device appear to expose reports the firmware descriptor
// never declared (silently authorising a class driver to read past the
// buffer any legitimate report parser sized); a count that could be
// lowered would let a legitimate report id become unreachable and its
// data never routed.
//
// =============================================================================
// §2  DERIVATION OVER KIND_DEVICE — THE SEVENTH TIME THE KIND HALF PROVES
//     NOTHING
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`.
// As with KIND_THERMAL_ZONE, KIND_BATTERY, KIND_COOLING_DEVICE and
// KIND_BACKLIGHT, that half discriminates NOTHING on its own: every
// PCI function in the machine is a KIND_DEVICE, and "this device is a
// HID input peripheral" is a fact about a descriptor byte stream this
// ring may not read (design/acpi/no-aml-in-kernel.md's discipline
// generalises: firmware / descriptor identification stays in ring 3).
// The kernel enforces exactly what it can:
//
//   * The inherited device key must be NON-ZERO
//     (`HID_MINT_NO_DEVICE`).
//   * NO OTHER LIVE ROW MAY HOLD THAT KEY (`HID_MINT_IN_USE`). One
//     physical device, one capability -- two capabilities for one
//     device means two class drivers claiming its report stream and
//     the one that installs last decides.
//   * The static identity is plausible: index < HID_INDEX_MAX,
//     transport in the small enumeration in §5, report_id_count in
//     0..HID_REPORT_ID_MAX. Vendor and product are u16 values with no
//     enumeration — the space is open, so §5 makes explicit that
//     "0000:0000" is refused (it is the USB spec's reserved
//     placeholder and a real device never advertises it).
//
// The discrimination this gate does not perform is performed by the
// ring-3 HID class driver that walked the descriptor and decided the
// stream was HID input, and the capability is the record of ITS
// decision.
//
// =============================================================================
// §3  REPORT_INSTALL IS A COUNTER, NOT A ROUTE
// =============================================================================
//
// `hid_device_report_install(slot)` takes ONE argument, a capability,
// and no payload. It exists to let the class driver record "I pushed
// one report to my subscriber, and the device this capability names
// was the source". The REPORT ITSELF flows through the KIND_HID_EVENT
// subscription that sits alongside this row; nothing in this kind
// carries a byte of the report bytes, and nothing here reaches a
// KIND_HID_EVENT row at all -- the two kinds are DISJOINT storage
// (§KIND_HID_EVENT is derived from KIND_IPC_ENDPOINT, this one from
// KIND_DEVICE) and the router that would connect them is R32.M4's.
//
// So this op is a per-device counter of "an install happened", and
// the lifetime count survives revocation in `_hid_device_stats` for
// the reason cooling / battery / thermal counters do: "this device
// keeps having reports installed but the sensor stream shows none" is
// a diagnostic about the sensor pipeline that must outlive any one
// capability.
//
// The op has arity ONE because a payload would be a report byte, or a
// pointer to one, and either is a way for the caller to feed the
// class driver's next parse from an address of its choosing. Not
// expressible against a one-argument signature.
//
// =============================================================================
// §4  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
//   * NOTHING DRIVES A TRANSPORT. `hid_device_report_install` returns
//     HID_OK for any live capability; there is no i2c write, no USB
//     control transfer and no bluetooth ACL byte in this module at
//     all. Which report id renders as which class-driver call is
//     transport-and-descriptor knowledge held by the ring-3 HID class
//     driver.
//   * NOTHING ROUTES A REPORT TO A SUBSCRIBER. Routing is
//     KIND_HID_EVENT's (#1126), and the plumbing between the two is
//     R32.M4's.
//   * NOTHING INTERPRETS AN ORDINAL. §0.
//
// =============================================================================
// §5  ENUMERATIONS: TRANSPORT
// =============================================================================
//
//   0 UNKNOWN     transport not classified — refused for legitimate
//                 mints, present so the ordinal 0 is a real answer
//                 rather than a decode error
//   1 I2C         i²c-hid (LPSS i²c bus with a HID slave)
//   2 USB         usb-hid (a USB device with a HID interface descriptor)
//   3 BT          bluetooth HID (HCI ACL carrying the HID profile)
//
// A mint with transport = 0 is refused (`HID_MINT_BAD_TRANSPORT`) --
// UNKNOWN is a decoder answer, not a legitimate parent state. Refused
// rather than mapped to another value so 'the class driver could not
// identify the transport' and 'the class driver has not called yet'
// stay different facts.
//
// =============================================================================
// §6  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// This module contains no `in`/`out` and no firmware-bytecode
// identifier. `tools/lint-no-kernel-aml.sh` refuses any kernel
// identifier matching `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`, `\_SB_`
// or `\_SB.`. KIND_HID_DEVICE, hid_device_* and _hid_device_table
// match none of the six.
//
// =============================================================================

module KindHidDevice = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_HID_DEVICE        : u64 = 0x15b  // derived-kind tag (347)
  pub let HID_DEVICE_PARENT_KIND : u64 = 10     // = KIND_DEVICE

  // ==========================================================================
  // §0 / §1 bounds.
  // ==========================================================================

  pub let HID_INDEX_MAX     : u64 = 16    // 0..15 (a T14 G4 declares three)
  pub let HID_REPORT_ID_MAX : u64 = 256   // 0..255 (HID spec §6.2.2.7)

  // ==========================================================================
  // §5 transport enumeration.
  // ==========================================================================

  pub let HID_TRANSPORT_UNKNOWN : u64 = 0
  pub let HID_TRANSPORT_I2C     : u64 = 1
  pub let HID_TRANSPORT_USB     : u64 = 2
  pub let HID_TRANSPORT_BT      : u64 = 3
  pub let HID_TRANSPORT_MAX     : u64 = 3

  // ==========================================================================
  // Rights.
  //
  // R_HID_READ and R_HID_REPORT are the two halves that matter. A
  // monitor needs READ forever; the class driver that pushes report-
  // install notes needs REPORT as well. RIGHT_MINT (0x200) is OUTSIDE
  // the mask: this kind is a leaf. Nothing in the tree derives from a
  // HID device capability -- KIND_HID_EVENT (#1126) is a SEPARATE
  // subscription kind whose parent is a KIND_IPC_ENDPOINT, not this
  // row, and the two are DISJOINT storage on purpose (see §3).
  // ==========================================================================

  pub let R_HID_READ    : u64 = 0x001
  pub let R_HID_REPORT  : u64 = 0x002
  pub let R_HID_INVOKE  : u64 = 0x008
  pub let R_HID_REVOKE  : u64 = 0x010
  pub let R_HID_OBSERVE : u64 = 0x400
  pub let R_HID_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each requires.
  //
  //   0 QUERY_INDEX           INVOKE   the row's own HID index
  //   1 QUERY_TRANSPORT       INVOKE   transport ordinal
  //   2 QUERY_VENDOR          INVOKE   vendor_id (u16)
  //   3 QUERY_PRODUCT         INVOKE   product_id (u16)
  //   4 QUERY_REPORT_ID_COUNT INVOKE   number of declared report ids
  //   5 QUERY_REPORTS         INVOKE   lifetime install count
  //   6 QUERY_PARENT          INVOKE   parent KIND_DEVICE slot
  //   7 DEBUG_PRINT           OBSERVE  canonical row dump
  //   8 REPORT_INSTALL        REPORT   arity-one "one report happened"
  //
  // REPORT_INSTALL takes NO OPERAND. The whole op_arg field beyond the
  // low byte is REFUSED with HID_TAIL_BAD_ARG rather than masked, for
  // the reason KIND_BACKLIGHT's REPORT reserved is refused rather than
  // masked: fifty-six free bits on an op that reaches the row's
  // counter is where a payload would be smuggled, and this op is
  // deliberately payload-less (§3).
  // ==========================================================================

  pub let HID_OP_QUERY_INDEX     : u64 = 0
  pub let HID_OP_QUERY_TRANSPORT : u64 = 1
  pub let HID_OP_QUERY_VENDOR    : u64 = 2
  pub let HID_OP_QUERY_PRODUCT   : u64 = 3
  pub let HID_OP_QUERY_RID_COUNT : u64 = 4
  pub let HID_OP_QUERY_REPORTS   : u64 = 5
  pub let HID_OP_QUERY_PARENT    : u64 = 6
  pub let HID_OP_DEBUG_PRINT     : u64 = 7
  pub let HID_OP_REPORT_INSTALL  : u64 = 8
  pub let HID_OP_MAX             : u64 = 8

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE80..0xFFFFFE8F.
  //
  // Sixteen-wide, disjoint from KIND_BACKLIGHT (0xFFFFFE70..7F),
  // KIND_COOLING_DEVICE (0xFFFFFE50..5F), KIND_BATTERY
  // (0xFFFFFE40..4F), KIND_THERMAL_ZONE (0xFFFFFE30..3F), owner
  // (0xFFFFFE2B..2F), thermal policy (0xFFFFFE20..2A), KIND_FW_SESSION
  // (0xFFFFFE10..1F), KIND_EC_QUERY (0xFFFFFE00..0F) and
  // battery_monitor (0xFFFFFE60..6F). Disjointness is what lets a u64
  // threaded up through the mint, the row allocator and the dispatch
  // handler still name the gate that refused it.
  // ==========================================================================

  pub let HID_OK                  : u64 = 0
  pub let HID_TAIL_ENOSPC         : u64 = 0xFFFFFE8F
  pub let HID_TAIL_BAD_ARG        : u64 = 0xFFFFFE8E
  pub let HID_MINT_BAD_PARENT     : u64 = 0xFFFFFE8D
  pub let HID_MINT_BAD_RIGHTS     : u64 = 0xFFFFFE8C
  pub let HID_MINT_BAD_INDEX      : u64 = 0xFFFFFE8B
  pub let HID_MINT_BAD_TRANSPORT  : u64 = 0xFFFFFE8A
  pub let HID_MINT_BAD_IDS        : u64 = 0xFFFFFE89
  pub let HID_MINT_BAD_RID_COUNT  : u64 = 0xFFFFFE88
  pub let HID_MINT_NO_DEVICE      : u64 = 0xFFFFFE87
  pub let HID_MINT_ENOSPC         : u64 = 0xFFFFFE86
  pub let HID_MINT_IN_USE         : u64 = 0xFFFFFE85
  pub let HID_BAD_SLOT            : u64 = 0xFFFFFE84
  pub let HID_WRONG_KIND          : u64 = 0xFFFFFE83
  pub let HID_REVOKE_ALREADY      : u64 = 0xFFFFFE82

  // The decoders' contract for a dead or out-of-range row.
  pub let HID_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // `hid_device_find_by_key`'s "no row holds this key". 0xFF rather
  // than 0, because row 0 is a legitimate answer.
  pub let HID_ROW_NONE : u64 = 0xFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // EIGHT ROWS, sized by HID DEVICES A T14 G4 DECLARES. A modern
  // laptop pins a touchpad, a trackpoint and a keyboard-controller
  // HID interface (three), and a docked workstation adds a wired
  // keyboard, a mouse and up to a couple of BT peripherals. Eight
  // covers the workstation.
  //
  // Sixty-four bytes per row so the index is a `shl 6`; paideia-as
  // has no `mul`.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot  cap_table slot of the parent
  //                                     KIND_DEVICE at mint; audit and
  //                                     query only
  //           bits [55:16] reserved, must be zero
  //           bits [63:56] in_use       allocator flag
  //   [+8]  hid_key          INHERITED from the parent descriptor's
  //                          target_ptr. Non-zero. The uniqueness key.
  //   [+16] index            0..HID_INDEX_MAX-1
  //   [+24] transport        1..HID_TRANSPORT_MAX (0 refused at mint)
  //   [+32] vendor_id        u16
  //   [+40] product_id       u16
  //   [+48] report_id_count  0..HID_REPORT_ID_MAX (255 is the largest
  //                          legal ID; count is one past it)
  //   [+56] state word
  //           bits [31:0]  reserved, must be zero
  //           bits [63:32] reports     lifetime install count
  //
  // `tools/build.sh` asserts by `objdump -r` that no object other
  // than `core/cap/kind_hid_device.o` relocates against
  // `_hid_device_table`. The table is the only place in the kernel
  // where a device's report_id_count and identity live, and a second
  // writer could raise the count with no capability involved and no
  // refusal recorded.
  // ==========================================================================

  pub let HID_MAX       : u64 = 8
  pub let HID_ROW_BYTES : u64 = 64

  pub let mut _hid_device_table : [u64; 64] = uninit @align(64)

  // Counters. Deliberately NOT in the row: they survive a revoke, so
  // "this device keeps having reports installed but the sensor stream
  // shows none" is evidence about a pipeline and outlives any one
  // capability over the device.
  //
  //   +0  reports   installs that succeeded
  pub let mut _hid_device_stats : [u64; 8] = uninit @align(64)

  pub let HID_ST_REPORTS : u64 = 0
  pub let HID_ST_MAX     : u64 = 8

  // Local klog keys and tags.
  pub let hidd_dbg_msg : [u8; 15] = "HID DEV ROW\n\0\0\0"
  pub let hidd_k_row   : [u8; 4]  = "row\0"
  pub let hidd_k_idx   : [u8; 4]  = "idx\0"
  pub let hidd_k_trp   : [u8; 5]  = "tran\0"
  pub let hidd_k_ven   : [u8; 4]  = "ven\0"
  pub let hidd_k_prd   : [u8; 4]  = "prd\0"
  pub let hidd_k_rid   : [u8; 4]  = "rid\0"
  pub let hidd_k_rep   : [u8; 4]  = "rep\0"

  // Dispatch chatter tag (imported from cap/tags.pdx as
  // cap_hid_device_msg).

  // ==========================================================================
  // hid_device_table_reset() -> ()
  // ==========================================================================

  pub let hid_device_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring backlight/cooling/battery/thermal table_reset: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Bounded by immediate compares, 64 iterations for the row table and 8 for the counters. Leaf. Labels prefixed hidd_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _hid_device_table];
        xor rax, rax;
        xor rcx, rcx;
      hidd_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  hidd_rs_rows;

        lea r10, [rip + _hid_device_stats];
        xor rcx, rcx;
      hidd_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hidd_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // hid_device_transport_valid(t) -> 1 | 0
  // ==========================================================================

  pub let hid_device_transport_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-001 (#1125): 1 iff t in [1, HID_TRANSPORT_MAX]. UNKNOWN (0) is REFUSED for a legitimate mint per §5: it is a decoder answer, not a parent state, and a mint that admitted it would let a class driver record 'I could not identify how this device speaks' as a legitimate row and then never notice the failure. Refused rather than mapped to another value so 'the class driver could not identify the transport' and 'the class driver has not called yet' stay different facts. Pure leaf. Labels prefixed hidd_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  hidd_tv_no;                  // UNKNOWN refused
        mov r10, 3;                      // HID_TRANSPORT_MAX
        cmp rdi, r10;
        ja  hidd_tv_no;
        mov rax, 1;
        ret;
      hidd_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_device_note(which) -> ()
  // hid_device_stat(which) -> count
  // ==========================================================================

  pub let hid_device_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): increment one counter; silent no-op on out-of-range. Same shape as backlight_note / cooling_note: every caller inside this module passes a constant, and the bound is here so the array cannot be walked past if that ever stops being true. Leaf. Labels prefixed hidd_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_ST_MAX
        jae hidd_nt_out;
        lea r10, [rip + _hid_device_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hidd_nt_out:
        ret
      }
    }

  pub let hid_device_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): bounds-checked read of one counter; out of range returns 0. This is what makes a stalled pipeline DIAGNOSABLE: a device whose class driver keeps calling report_install while its KIND_HID_EVENT subscriber sees no delivery looks, from a subscriber's vantage point, exactly like a device that never fired. The lifetime install counter is the only place the difference is visible. Leaf. Labels prefixed hidd_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_ST_MAX
        jae hidd_st_zero;
        lea r10, [rip + _hid_device_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hidd_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_device_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let hid_device_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-001 (#1125): 1 iff (rights & R_HID_ALL) == rights. R_HID_ALL = 0x41B (READ|REPORT|INVOKE|REVOKE|OBSERVE). A subset test, and RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf of the lattice, and a MINT bit no gate reads is authority that later acquires a meaning nobody audited. The subset shape (not equality) lets a monitor hold R_HID_READ alone while the class driver holds READ|REPORT. Pure leaf. Labels prefixed hidd_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;                  // R_HID_ALL
        and rax, r10;
        cmp rax, rdi;
        jne hidd_rv_no;
        mov rax, 1;
        ret;
      hidd_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_device_check_parent_device(parent_slot) -> 1 | 0
  //
  // §2. The first half of the derivation gate. Discriminates NOTHING
  // on its own; the second half is in hid_device_cap_mint_inner.
  // ==========================================================================

  pub let hid_device_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): the first half of the KIND_HID_DEVICE derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_DEVICE (10) AND (rights & RIGHT_MINT 0x200) != 0. THIS HALF DISCRIMINATES NOTHING and the mint does not treat it as though it did -- every PCI function in the machine is a KIND_DEVICE, which is #1075's lesson stated for the seventh time in this file family. 'This device is a HID input peripheral' is a fact about a descriptor byte stream this ring may not read (the class-driver-in-ring-3 half of the argument in design/acpi/no-aml-in-kernel.md generalises), so the second half is what the kernel CAN enforce (non-zero inherited key, one device per key, plausible index / transport / vendor:product / report_id_count). Pure read. Labels prefixed hidd_cpd_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae hidd_cpd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne hidd_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  hidd_cpd_no;

        mov rax, 1;
        ret;

      hidd_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_device_parent_key(parent_slot) -> hid_key | 0
  // ==========================================================================

  pub let hid_device_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-001 (#1125): read the parent KIND_DEVICE descriptor's target_ptr, which for a device capability is its identity key. THE ONLY SOURCE OF A HID DEVICE CAPABILITY'S IDENTITY: the mint has no device argument, so the physical device whose static identity a row holds is the part its parent capability names and no other. A mint that took the key as an argument would let a holder attach one device's vendor:product to a different device -- and every future report_install thereafter would be confidently wrong about which device the class driver's stream was acting on. Same shape as backlight_parent_key / cooling_parent_key / battery_parent_key. Returns 0 for a bad slot or a non-KIND_DEVICE descriptor, and hid_device_cap_mint_inner refuses 0 with HID_MINT_NO_DEVICE. Pure read. Labels prefixed hidd_pk_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae hidd_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne hidd_pk_no;

        mov rax, [rax + 16];             // target_ptr = device identity key
        ret;

      hidd_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_device_hdr_pack(parent_slot) -> hdr | HID_DECODE_BAD
  // ==========================================================================

  pub let hid_device_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-001 (#1125): canonical header-word encoder. Validates parent_slot < 256 then packs (parent_slot << 8), leaving bits [7:0], [55:16] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero, which is the whole reason the encoder exists rather than a shift at the call site: a header arriving with in_use pre-set hands back a row the free scan skips forever, and on this kind the leaked row holds a report_id_count, so the next legitimate mint of that device is refused IN_USE by a ghost that is still the only record of the device's report shape. Pure leaf. Labels prefixed hidd_hp_ per reserved-label discipline.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae hidd_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        ret;

      hidd_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let hid_device_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M3-001 (#1125): parent_slot from header bits [15:8]. Named accessor rather than a shift at each call site, so a future header field cannot silently change what a caller reads. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    }

  // ==========================================================================
  // hid_device_tail_alloc(hdr, hid_key, index, transport, ids, rid_count)
  //   -> row_id | HID_TAIL_*
  //
  // `ids` packs vendor_id in [15:0] and product_id in [31:16], with
  // bits [63:32] reserved zero. Six SysV registers, six fields.
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A HID DEVICE ROW.
  // ==========================================================================

  pub let hid_device_tail_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (hid_key: u64) (index: u64) (transport: u64) (ids: u64) (rid_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A HID DEVICE'S report_id_count OR IDENTITY, which is why tools/build.sh confines relocations against _hid_device_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (the allocator's in_use flag); hdr reserved bits [7:0] or [55:16] non-zero -> TAIL_BAD_ARG; hid_key == 0 -> TAIL_BAD_ARG (0 is hid_device_parent_key's refusal value); index >= HID_INDEX_MAX -> TAIL_BAD_ARG; transport not in [1, HID_TRANSPORT_MAX] -> TAIL_BAD_ARG (UNKNOWN=0 is refused for the mint per §5); ids reserved bits [63:32] non-zero -> TAIL_BAD_ARG; vendor == 0 AND product == 0 -> TAIL_BAD_ARG (USB reserved placeholder; a real device never advertises it, and admitting it would leave one legal spelling of an unidentified device in the table); rid_count > HID_REPORT_ID_MAX -> TAIL_BAD_ARG. rid_count = 0 IS ADMITTED: a device with a single un-numbered report has zero declared report IDs per HID §6.2.2.7, and refusing 0 would rule out the common boot-mouse shape the R32.M2 parser targets. THE VENDOR:PRODUCT AND TRANSPORT CHECKS ARE HERE AS WELL AS IN THE MINT, deliberately: the mint's versions produce specific codes an installer needs (MINT_BAD_TRANSPORT / MINT_BAD_IDS / MINT_BAD_RID_COUNT), while this makes it impossible for ANY future second caller of the allocator to create a row without them. A row with vendor:product 0000:0000 would be a device that every future policy decision treats as 'unknown' and every future audit trail names as 'that hid device'. Low-first scan over 8 rows of 64 bytes, free iff byte 7 of [row+0] is zero. Claim writes all eight words, so a reused row cannot inherit the previous device's counter or identity. Six pushes leave rsp%16 == 0 at every nested call site (there are none in this leaf). Labels prefixed hidd_ta_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // hid_key
        mov r14, rdx;                    // index
        mov r15, rcx;                    // transport
        mov rbp, r8;                     // ids
        // rid_count stays in r9

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne hidd_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne hidd_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne hidd_ta_bad;

        cmp r13, 0;
        je  hidd_ta_bad;

        mov r10, 16;                     // HID_INDEX_MAX
        cmp r14, r10;
        jae hidd_ta_bad;

        cmp r15, 0;                      // UNKNOWN refused
        je  hidd_ta_bad;
        mov r10, 3;                      // HID_TRANSPORT_MAX
        cmp r15, r10;
        ja  hidd_ta_bad;

        // ids reserved bits [63:32].
        mov rax, rbp;
        shr rax, 32;
        cmp rax, 0;
        jne hidd_ta_bad;

        // Unpack vendor / product and refuse 0000:0000.
        mov rax, rbp;
        mov r10, 0xFFFF;
        and rax, r10;                    // vendor
        mov r11, rbp;
        shr r11, 16;
        and r11, r10;                    // product
        // We need vendor & product in ALU-friendly regs after this;
        // stash them together as (vendor | product << 16) again for
        // storage — but it is easier to keep vendor in rax_stash and
        // product in r11 for the writes. Push both.
        push rax;                        // vendor
        push r11;                        // product
        or  rax, r11;                    // 0 iff both are zero
        cmp rax, 0;
        je  hidd_ta_bad_pop2;

        mov r10, 256;                    // HID_REPORT_ID_MAX
        cmp r9, r10;
        ja  hidd_ta_bad_pop2;

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      hidd_ta_scan:
        cmp rbx, 8;                      // HID_MAX
        jae hidd_ta_enospc_pop2;

        lea r10, [rip + _hid_device_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hidd_ta_claim;

        add rbx, 1;
        jmp hidd_ta_scan;

      hidd_ta_claim:
        // Pop vendor/product back.
        pop r11;                         // product
        pop rax;                         // vendor

        mov rcx, r12;                    // save hdr
        mov r12, 1;
        shl r12, 56;
        or  rcx, r12;                    // in_use = 1
        mov r12, rcx;                    // restore hdr with in_use
        mov [r10 + 0],  r12;
        mov [r10 + 8],  r13;             // hid_key
        mov [r10 + 16], r14;             // index
        mov [r10 + 24], r15;             // transport
        mov [r10 + 32], rax;             // vendor_id
        mov [r10 + 40], r11;             // product_id
        mov [r10 + 48], r9;              // report_id_count
        xor rax, rax;
        mov [r10 + 56], rax;             // state word
        mov rax, rbx;                    // row_id
        jmp hidd_ta_out;

      hidd_ta_enospc_pop2:
        add rsp, 16;
        jmp hidd_ta_enospc;
      hidd_ta_bad_pop2:
        add rsp, 16;
        jmp hidd_ta_bad;

      hidd_ta_enospc:
        mov rax, 0xFFFFFE8F;             // HID_TAIL_ENOSPC
        jmp hidd_ta_out;
      hidd_ta_bad:
        mov rax, 0xFFFFFE8E;             // HID_TAIL_BAD_ARG

      hidd_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hid_device_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): 1 iff row_id < HID_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers HID_DECODE_BAD rather than the zeroes it was scrubbed to. On this kind that matters for report_id_count: a scrubbed row renders as a device with no reports declared, which every legitimate report_install would then appear to be pushing past. Leaf. Labels prefixed hidd_tv2_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_MAX
        jae hidd_tv2_no;
        lea r10, [rip + _hid_device_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hidd_tv2_no;
        mov rax, 1;
        ret;
      hidd_tv2_no:
        xor rax, rax;
        ret
      }
    }

  pub let hid_device_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): scrub one row to zero, which clears in_use and returns it to the free scan. ALL EIGHT WORDS, including the report counter: a revoke is the point at which somebody has decided this device's history no longer applies, and a row that kept its counter across a re-mint would report a device as having been installed against on the strength of a capability that no longer exists. Scrubbing the KEY is what makes the device re-mintable. No-op on an out-of-range row. Leaf. Labels prefixed hidd_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // HID_MAX
        jae hidd_tf_out;
        lea r10, [rip + _hid_device_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      hidd_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Every one returns HID_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let hid_device_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): raw header word of a live row, or HID_DECODE_BAD. Labels prefixed hidd_rh_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_device_tail_valid;
        cmp rax, 0;
        je  hidd_rh_bad;
        lea r10, [rip + _hid_device_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp hidd_rh_out;
      hidd_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hidd_rh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_device_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): inherited device identity key of a live row, or HID_DECODE_BAD. Labels prefixed hidd_rk_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_device_tail_valid;
        cmp rax, 0;
        je  hidd_rk_bad;
        lea r10, [rip + _hid_device_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp hidd_rk_out;
      hidd_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hidd_rk_out:
