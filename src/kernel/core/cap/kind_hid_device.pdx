  pub let hid_device_row_transport : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-001 (#1125): transport ordinal of a live row, or HID_DECODE_BAD. Read-only; the only writer is hid_device_tail_alloc, so transport is set once and 'the transport changed at runtime' is unrepresentable. That property matters more here than in the backlight case: a subscriber that filters KIND_HID_EVENT deliveries by transport class must be told the truth about which bus a device speaks on, and a subscription indexed against a transport that later moved would silently miss its device. Labels prefixed hidd_rt_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call hid_device_tail_valid;
        cmp rax, 0;
        je  hidd_rt_bad;
        lea r10, [rip + _hid_device_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp hidd_rt_out;
      hidd_rt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      hidd_rt_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let hid_device_row_vendor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
