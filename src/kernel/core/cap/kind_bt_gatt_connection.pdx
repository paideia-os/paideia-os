// src/kernel/core/cap/kind_bt_gatt_connection.pdx — R39.M3-003 (#1333)
//
// KIND_BT_GATT_CONNECTION = 0x17C, derived over KIND_IPC_ENDPOINT (5).
//
// One live Bluetooth GATT (Generic Attribute Profile) connection: a
// conn_key naming the connection, the KIND_IPC_ENDPOINT the client
// drives GATT RPCs over (read_char / write_char / subscribe / notify),
// the 48-bit BD_ADDR of the remote peer, the negotiated ATT MTU, an
// FSM state ordinal (disconnected / connecting / connected /
// encrypted), and a security_level ordinal (0=none, 1=unauthenticated,
// 2=authenticated, 3=authenticated-with-secure-connections).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A GATT connection names ONE ATT session over an L2CAP fixed channel
// (CID 0x0004 for BR/EDR, 0x0004 for LE) with ONE remote BD_ADDR at
// ONE MTU.  The bt_gatt_channel RPCs (btgc_read_char / btgc_write_char
// / btgc_subscribe / btgc_notify) address a connection by its slot; a
// server that dispatches without a KIND_BT_GATT_CONNECTION-shaped
// authority could:
//
//   (1) Route a read_char against a handle that belongs to a different
//       peer's attribute database ("peer swap"): the conn_key + remote
//       BD_ADDR pair is FROZEN at mint and no op below mutates either.
//   (2) Send a write past the negotiated ATT MTU ("mtu forge"): mtu is
//       frozen at mint and the bt_gatt_channel packer bounds-checks
//       against it before framing.
//   (3) Speak GATT over a peer connection that has not passed the
//       required security check ("unauthenticated-write bypass"): the
//       security_level is written at mint by the pairing supervisor
//       and no reachable op advances it upward -- a demote to
//       DISCONNECTED is legal on tear-down, an upgrade is not.
//
// The KIND_IPC_ENDPOINT parent is the endpoint the GATT server accepts
// RPCs over.  Like every KIND_IPC_ENDPOINT-derived kind in this tree
// (KIND_WIFI_VIF, KIND_GPU_SUBMIT, KIND_MODESET_TXN, ...), the parent
// kind alone discriminates NOTHING; the mint gates below cover the
// rest.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// A mint additionally requires:
//
//   (a) conn_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (this is the parent_slot itself)
//   (c) remote_addr[47:0] non-zero (BAD_ADDR) -- the all-zero BD_ADDR
//       is reserved by BT §1.2 and never a live peer
//   (d) mtu in [23, 517] per BT §3.2.9 (BAD_MTU) -- 23 is the ATT
//       default MTU, 517 is the maximum for LE
//   (e) initial state is always STATE_DISCONNECTED (0) (BAD_STATE)
//   (f) security_level in {0, 1, 2, 3} (BAD_SEC)
//   (g) rights subset of R_KBGC_ALL (R_MINT ABSENT from the mask)
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  conn_key    (u64)
//   [+16] body1:   endpoint_slot[31:0] | mtu[47:32]
//                | state[55:48] | security_level[63:56]
//   [+24] body2:   remote_addr[47:0] | reserved[63:48]
//
// state is the ONE mutable field: kbgc_row_transition (called only by
// the GATT connection FSM path and the revoke helper) is the sole
// mutator.  Every other identity field is FROZEN at mint.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF320..0xFFFFF32F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (R38's lowest band is rekey 0xFFFFF330..0xFFFFF33F;
// adjacent free bands below: gatt driver 0xFFFFF310..0xFFFFF31F,
// bt_gatt_channel 0xFFFFF300..0xFFFFF30F).

module KindBtGattConnection = structure {

  pub let KIND_BT_GATT_CONNECTION : u64 = 0x17C
  pub let KBGC_PARENT_KIND        : u64 = 5           // = KIND_IPC_ENDPOINT

  // FSM state ordinals.
  pub let KBGC_STATE_DISCONNECTED : u64 = 0
  pub let KBGC_STATE_CONNECTING   : u64 = 1
  pub let KBGC_STATE_CONNECTED    : u64 = 2
  pub let KBGC_STATE_ENCRYPTED    : u64 = 3
  pub let KBGC_STATE_MAX          : u64 = 3

  // Security-level ordinals (BT §5.2.4).
  pub let KBGC_SEC_NONE               : u64 = 0
  pub let KBGC_SEC_UNAUTHENTICATED    : u64 = 1
  pub let KBGC_SEC_AUTHENTICATED      : u64 = 2
  pub let KBGC_SEC_AUTHENTICATED_SC   : u64 = 3
  pub let KBGC_SEC_MAX                : u64 = 3

  // ATT MTU bounds (BT §3.2.9).
  pub let KBGC_MTU_MIN : u64 = 23
  pub let KBGC_MTU_MAX : u64 = 517

  // Rights.  R_MINT (0x200) NOT in the mask.
  pub let R_KBGC_READ    : u64 = 0x001
  pub let R_KBGC_WRITE   : u64 = 0x002
  pub let R_KBGC_INVOKE  : u64 = 0x008
  pub let R_KBGC_REVOKE  : u64 = 0x010
  pub let R_KBGC_OBSERVE : u64 = 0x400
  pub let R_KBGC_ALL     : u64 = 0x41B

  // Ops.  Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KBGC_OP_QUERY_KEY       : u64 = 0
  pub let KBGC_OP_QUERY_ENDPOINT  : u64 = 1
  pub let KBGC_OP_QUERY_ADDR_HI   : u64 = 2
  pub let KBGC_OP_QUERY_ADDR_LO   : u64 = 3
  pub let KBGC_OP_QUERY_MTU       : u64 = 4
  pub let KBGC_OP_QUERY_STATE     : u64 = 5
  pub let KBGC_OP_QUERY_SEC       : u64 = 6
  pub let KBGC_OP_DEBUG_PRINT     : u64 = 7
  pub let KBGC_OP_MAX             : u64 = 7

  // Failure taxonomy -- 0xFFFFF320..0xFFFFF32F.
  pub let KBGC_OK                 : u64 = 0
  pub let KBGC_TAIL_ENOSPC        : u64 = 0xFFFFF32F
  pub let KBGC_TAIL_BAD_ARG       : u64 = 0xFFFFF32E
  pub let KBGC_MINT_BAD_PARENT    : u64 = 0xFFFFF32D
  pub let KBGC_MINT_BAD_RIGHTS    : u64 = 0xFFFFF32C
  pub let KBGC_MINT_BAD_ADDR      : u64 = 0xFFFFF32B
  pub let KBGC_MINT_BAD_MTU       : u64 = 0xFFFFF32A
  pub let KBGC_MINT_BAD_STATE     : u64 = 0xFFFFF329
  pub let KBGC_MINT_BAD_SEC       : u64 = 0xFFFFF328
  pub let KBGC_MINT_NO_KEY        : u64 = 0xFFFFF327
  pub let KBGC_MINT_ENOSPC        : u64 = 0xFFFFF326
  pub let KBGC_MINT_IN_USE        : u64 = 0xFFFFF325
  pub let KBGC_BAD_SLOT           : u64 = 0xFFFFF324
  pub let KBGC_WRONG_KIND         : u64 = 0xFFFFF323
  pub let KBGC_REVOKE_ALREADY     : u64 = 0xFFFFF322
  pub let KBGC_BAD_TRANSITION     : u64 = 0xFFFFF321
  pub let KBGC_RESERVED_ZERO      : u64 = 0xFFFFF320

  pub let KBGC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KBGC_ROW_NONE   : u64 = 0xFF

  pub let KBGC_MAX       : u64 = 8
  pub let KBGC_ROW_BYTES : u64 = 32

  pub let mut _bt_gatt_conn_table : [u64; 32] = uninit @align(64)
  pub let mut _bt_gatt_conn_stats : [u64; 4]  = uninit @align(64)

  pub let KBGC_ST_MINTS       : u64 = 0
  pub let KBGC_ST_REVOKES     : u64 = 1
  pub let KBGC_ST_TRANSITIONS : u64 = 2
  pub let KBGC_ST_REFUSED     : u64 = 3

  pub let kbgc_dbg_msg : [u8; 20] = "BT GATT CONN ROW\0\0\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bt_gatt_conn_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): clear KIND_BT_GATT_CONNECTION row table + counters. Boot and teardown only. Labels prefixed kbgc_rs_.",
      block: {
        lea r10, [rip + _bt_gatt_conn_table];
        xor rax, rax;
        xor rcx, rcx;
      kbgc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kbgc_rs_rows;

        lea r10, [rip + _bt_gatt_conn_stats];
        xor rcx, rcx;
      kbgc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kbgc_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kbgc_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): subset test against R_KBGC_ALL = 0x41B. R_MINT (0x200) OUTSIDE the mask. Labels prefixed kbgc_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne kbgc_rv_no;
        mov rax, 1;
        ret;
      kbgc_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kbgc_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): 1 iff s <= STATE_MAX (3). Labels prefixed kbgc_sv_.",
      block: {
        cmp rdi, 3;
        ja  kbgc_sv_no;
        mov rax, 1;
        ret;
      kbgc_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kbgc_sec_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): 1 iff s <= SEC_MAX (3). Labels prefixed kbgc_secv_.",
      block: {
        cmp rdi, 3;
        ja  kbgc_secv_no;
        mov rax, 1;
        ret;
      kbgc_secv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kbgc_mtu_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): 1 iff m in [23, 517] (ATT MTU bounds per BT §3.2.9). Labels prefixed kbgc_mv_.",
      block: {
        cmp rdi, 23;
        jb  kbgc_mv_no;
        cmp rdi, 517;
        ja  kbgc_mv_no;
        mov rax, 1;
        ret;
      kbgc_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kbgc_addr_valid : (u64) -> u64 !{} @{} =
    fn (addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): 1 iff addr fits 48 bits AND is non-zero (BT reserves all-zero BD_ADDR). Labels prefixed kbgc_av_.",
      block: {
        cmp rdi, 0;
        je  kbgc_av_no;
        mov r10, 0xFFFFFFFFFFFF;
        mov rax, rdi;
        and rax, r10;
        cmp rax, rdi;
        jne kbgc_av_no;
        mov rax, 1;
        ret;
      kbgc_av_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kbgc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): counter bump. Labels prefixed kbgc_nt_.",
      block: {
        cmp rdi, 4;
        jae kbgc_nt_out;
        lea r10, [rip + _bt_gatt_conn_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kbgc_nt_out:
        ret
      }
    }

  pub let kbgc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): counter read. Labels prefixed kbgc_stt_.",
      block: {
        cmp rdi, 4;
        jae kbgc_stt_zero;
        lea r10, [rip + _bt_gatt_conn_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kbgc_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let kbgc_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M3-003 (#1333): §1b gate. Parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed kbgc_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kbgc_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne kbgc_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kbgc_cp_no;

        mov rax, 1;
        ret;
      kbgc_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kbgc_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): (parent_slot << 8). Labels prefixed kbgc_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kbgc_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kbgc_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kbgc_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (mtu: u64) (state: u64) (sec: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): pack endpoint_slot[31:0] | mtu[47:32] | state[55:48] | security_level[63:56]. Labels prefixed kbgc_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kbgc_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  kbgc_b1_bad;
        cmp rdx, 3;
        ja  kbgc_b1_bad;
        cmp rcx, 3;
        ja  kbgc_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      kbgc_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kbgc_body2_pack : (u64) -> u64 !{} @{} =
    fn (remote_addr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-003 (#1333): pack remote_addr[47:0] | reserved[63:48]=0. Labels prefixed kbgc_b2_.",
      block: {
        mov r10, 0xFFFFFFFFFFFF;
        cmp rdi, r10;
        ja  kbgc_b2_bad;
        mov rax, rdi;
        and rax, r10;
        ret;
      kbgc_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _bt_gatt_conn_table.
  // ==========================================================================

  pub let kbgc_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (conn_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): claim one BT GATT CONNECTION row. THE ONE WRITER. Labels prefixed kbgc_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kbgc_ta_bad;

        cmp r13, 0;
        je  kbgc_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kbgc_ta_bad;
        cmp r15, r10;
        je  kbgc_ta_bad;

        xor rbx, rbx;
      kbgc_ta_scan:
        cmp rbx, 8;
        jae kbgc_ta_enospc;

        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbgc_ta_claim;

        add rbx, 1;
        jmp kbgc_ta_scan;

      kbgc_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kbgc_ta_out;

      kbgc_ta_enospc:
        mov rax, 0xFFFFF32F;
        jmp kbgc_ta_out;
      kbgc_ta_bad:
        mov rax, 0xFFFFF32E;

      kbgc_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kbgc_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): 1 iff row_id<MAX and in_use. Labels prefixed kbgc_tvr_.",
      block: {
        cmp rdi, 8;
        jae kbgc_tvr_no;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbgc_tvr_no;
        mov rax, 1;
        ret;
      kbgc_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let kbgc_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): scrub one row. Labels prefixed kbgc_tf_.",
      block: {
        cmp rdi, 8;
        jae kbgc_tf_out;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kbgc_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kbgc_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): conn_key. Labels prefixed kbgc_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_rk_bad;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kbgc_rk_out;
      kbgc_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbgc_rk_out:
        pop r12;
        ret
      }
    }

  pub let kbgc_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): endpoint_slot (body1[31:0]). Labels prefixed kbgc_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_re_bad;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kbgc_re_out;
      kbgc_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbgc_re_out:
        pop r12;
        ret
      }
    }

  pub let kbgc_row_mtu : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): mtu (body1[47:32]). Labels prefixed kbgc_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_rm_bad;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp kbgc_rm_out;
      kbgc_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbgc_rm_out:
        pop r12;
        ret
      }
    }

  pub let kbgc_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): state (body1[55:48]). Labels prefixed kbgc_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_rst_bad;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp kbgc_rst_out;
      kbgc_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbgc_rst_out:
        pop r12;
        ret
      }
    }

  pub let kbgc_row_sec : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): security_level (body1[63:56]). Labels prefixed kbgc_rsec_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_rsec_bad;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        and rax, 0xFF;
        jmp kbgc_rsec_out;
      kbgc_rsec_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbgc_rsec_out:
        pop r12;
        ret
      }
    }

  pub let kbgc_row_addr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): remote_addr (body2[47:0]). Labels prefixed kbgc_ra_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_ra_bad;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        mov r11, 0xFFFFFFFFFFFF;
        and rax, r11;
        jmp kbgc_ra_out;
      kbgc_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbgc_ra_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kbgc_row_transition(row_id, new_state) — the ONE MUTATOR of state.
  // Legal edges: DISCONNECTED->CONNECTING, CONNECTING->CONNECTED,
  // CONNECTED->ENCRYPTED, ENCRYPTED->CONNECTED (unencrypt on demote),
  // any state -> DISCONNECTED (tear-down / revoke).
  // ==========================================================================

  pub let kbgc_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): mutate state field on one row. Legal FSM edges enumerated. Labels prefixed kbgc_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_rt_bad;

        mov rdi, r13;
        call kbgc_state_valid;
        cmp rax, 0;
        je  kbgc_rt_bad;

        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;

        // Any state -> DISCONNECTED (0) is legal.
        cmp r13, 0;
        je  kbgc_rt_apply;
        // DISCONNECTED (0) -> CONNECTING (1)
        cmp rax, 0;
        je  kbgc_rt_from0;
        // CONNECTING (1) -> CONNECTED (2)
        cmp rax, 1;
        je  kbgc_rt_from1;
        // CONNECTED (2) -> ENCRYPTED (3)
        cmp rax, 2;
        je  kbgc_rt_from2;
        // ENCRYPTED (3) -> CONNECTED (2)
        cmp rax, 3;
        je  kbgc_rt_from3;
        jmp kbgc_rt_bad;

      kbgc_rt_from0:
        cmp r13, 1;
        je  kbgc_rt_apply;
        jmp kbgc_rt_bad;
      kbgc_rt_from1:
        cmp r13, 2;
        je  kbgc_rt_apply;
        jmp kbgc_rt_bad;
      kbgc_rt_from2:
        cmp r13, 3;
        je  kbgc_rt_apply;
        jmp kbgc_rt_bad;
      kbgc_rt_from3:
        cmp r13, 2;
        je  kbgc_rt_apply;
        jmp kbgc_rt_bad;

      kbgc_rt_apply:
        mov rax, [r10 + 16];
        mov r11, 0xFF;
        shl r11, 48;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 48;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov rdi, 2;
        call kbgc_note;
        xor rax, rax;
        jmp kbgc_rt_out;

      kbgc_rt_bad:
        mov rax, 0xFFFFF321;

      kbgc_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kbgc_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (conn_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-003 (#1333): live row holding conn_key, or ROW_NONE. Refuses to match 0. Labels prefixed kbgc_fk_.",
      block: {
        cmp rdi, 0;
        je  kbgc_fk_none;
        xor rcx, rcx;
      kbgc_fk_scan:
        cmp rcx, 8;
        jae kbgc_fk_none;
        lea r10, [rip + _bt_gatt_conn_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbgc_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kbgc_fk_hit;
      kbgc_fk_next:
        add rcx, 1;
        jmp kbgc_fk_scan;
      kbgc_fk_hit:
        mov rax, rcx;
        ret;
      kbgc_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let kbgc_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M3-003 (#1333): slot -> row_id, gated on live KIND_BT_GATT_CONNECTION. Labels prefixed kbgc_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kbgc_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x17C;
        cmp r10, r11;
        jne kbgc_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_ros_none;

        mov rax, r12;
        jmp kbgc_ros_out;

      kbgc_ros_none:
        mov rax, 0xFF;
      kbgc_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, conn_key, packed_v, addr).
  //
  //   packed_v encoding:
  //     [15:0]   mtu
  //     [23:16]  state (must be 0 at mint)
  //     [31:24]  security_level
  //     [63:32]  reserved (must be zero)
  //
  //  addr carries the 48-bit BD_ADDR of the remote peer.
  // ==========================================================================

  pub let bt_gatt_conn_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (conn_key: u64) (packed_v: u64) (addr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M3-003 (#1333): mint KIND_BT_GATT_CONNECTION over KIND_IPC_ENDPOINT. Six-arg form because BD_ADDR needs 48 bits it cannot share with mtu / state / sec. Labels prefixed kbgc_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // conn_key
        mov r15, r8;                     // packed_v
        mov rbp, r9;                     // addr

        mov r10, 256;
        cmp rbx, r10;
        jae kbgc_mi_bad_slot;

        mov rdi, r12;
        call kbgc_check_parent;
        cmp rax, 0;
        je  kbgc_mi_bad_parent;

        mov rdi, r13;
        call kbgc_rights_valid;
        cmp rax, 0;
        je  kbgc_mi_bad_rights;

        // Reserved [63:32] must be zero.
        mov r10, r15;
        shr r10, 32;
        cmp r10, 0;
        jne kbgc_mi_reserved;

        // mtu valid.
        mov r10, r15;
        and r10, 0xFFFF;
        push r10;                        // mtu on stack
        mov rdi, r10;
        call kbgc_mtu_valid;
        cmp rax, 0;
        je  kbgc_mi_bad_mtu_pop;

        // state must be 0 at mint (DISCONNECTED).
        mov r10, r15;
        shr r10, 16;
        and r10, 0xFF;
        cmp r10, 0;
        jne kbgc_mi_bad_state_pop;

        // sec valid.
        mov r10, r15;
        shr r10, 24;
        and r10, 0xFF;
        push r10;                        // sec on stack
        mov rdi, r10;
        call kbgc_sec_valid;
        cmp rax, 0;
        je  kbgc_mi_bad_sec_pop2;

        // addr valid.
        mov rdi, rbp;
        call kbgc_addr_valid;
        cmp rax, 0;
        je  kbgc_mi_bad_addr_pop2;

        cmp r14, 0;
        je  kbgc_mi_no_key_pop2;

        mov rdi, r14;
        call kbgc_find_by_key;
        cmp rax, 0xFF;
        jne kbgc_mi_in_use_pop2;

        // Body1 pack (endpoint_slot=parent_slot, mtu, state=0, sec).
        mov rdi, r12;
        mov rsi, [rsp + 8];              // mtu
        mov rdx, 0;                      // state = DISCONNECTED
        mov rcx, [rsp + 0];              // sec
        call kbgc_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbgc_mi_bad_state_pop2;
        push rax;                        // body1 on stack (top)

        // Body2 pack (remote_addr).
        mov rdi, rbp;
        call kbgc_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbgc_mi_bad_addr_pop3;
        push rax;                        // body2 on stack (top)

        // Header pack.
        mov rdi, r12;
        call kbgc_hdr_pack;
        pop r15;                         // body2 -> r15
        pop rbp;                         // body1 -> rbp
        add rsp, 16;                     // discard sec + mtu
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbgc_mi_bad_parent;

        // tail_alloc(hdr, conn_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r15;
        call kbgc_tail_alloc;

        mov r10, 0xFFFFF32F;
        cmp rax, r10;
        je  kbgc_mi_enospc;
        mov r10, 0xFFFFF32E;
        cmp rax, r10;
        je  kbgc_mi_bad_state;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x17C;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kbgc_note;

        xor rax, rax;
        jmp kbgc_mi_out;

      kbgc_mi_bad_mtu_pop:
        add rsp, 8;
        jmp kbgc_mi_bad_mtu;
      kbgc_mi_bad_state_pop:
        add rsp, 8;
        jmp kbgc_mi_bad_state;
      kbgc_mi_bad_sec_pop2:
        add rsp, 16;
        jmp kbgc_mi_bad_sec;
      kbgc_mi_bad_addr_pop2:
        add rsp, 16;
        jmp kbgc_mi_bad_addr;
      kbgc_mi_no_key_pop2:
        add rsp, 16;
        jmp kbgc_mi_no_key;
      kbgc_mi_in_use_pop2:
        add rsp, 16;
        jmp kbgc_mi_in_use;
      kbgc_mi_bad_state_pop2:
        add rsp, 16;
        jmp kbgc_mi_bad_state;
      kbgc_mi_bad_addr_pop3:
        add rsp, 24;
        jmp kbgc_mi_bad_addr;

      kbgc_mi_bad_slot:
        mov rax, 0xFFFFF324;
        jmp kbgc_mi_out;
      kbgc_mi_bad_parent:
        mov rax, 0xFFFFF32D;
        jmp kbgc_mi_out;
      kbgc_mi_bad_rights:
        mov rax, 0xFFFFF32C;
        jmp kbgc_mi_out;
      kbgc_mi_bad_addr:
        mov rax, 0xFFFFF32B;
        jmp kbgc_mi_out;
      kbgc_mi_bad_mtu:
        mov rax, 0xFFFFF32A;
        jmp kbgc_mi_out;
      kbgc_mi_bad_state:
        mov rax, 0xFFFFF329;
        jmp kbgc_mi_out;
      kbgc_mi_bad_sec:
        mov rax, 0xFFFFF328;
        jmp kbgc_mi_out;
      kbgc_mi_no_key:
        mov rax, 0xFFFFF327;
        jmp kbgc_mi_out;
      kbgc_mi_in_use:
        mov rdi, 3;
        call kbgc_note;
        mov rax, 0xFFFFF325;
        jmp kbgc_mi_out;
      kbgc_mi_enospc:
        mov rdi, 3;
        call kbgc_note;
        mov rax, 0xFFFFF326;
        jmp kbgc_mi_out;
      kbgc_mi_reserved:
        mov rax, 0xFFFFF320;

      kbgc_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let bt_gatt_conn_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M3-003 (#1333): revoke KIND_BT_GATT_CONNECTION. Labels prefixed kbgc_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kbgc_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kbgc_rvk_already;

        mov r11, 0x17C;
        cmp r10, r11;
        jne kbgc_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kbgc_tail_valid;
        cmp rax, 0;
        je  kbgc_rvk_clear;

        mov rdi, r13;
        call kbgc_tail_free;

      kbgc_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kbgc_note;

        xor rax, rax;
        jmp kbgc_rvk_out;

      kbgc_rvk_bad_slot:
        mov rax, 0xFFFFF324;
        jmp kbgc_rvk_out;
      kbgc_rvk_wrong_kind:
        mov rax, 0xFFFFF323;
        jmp kbgc_rvk_out;
      kbgc_rvk_already:
        mov rax, 0xFFFFF322;

      kbgc_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_bt_gatt_conn : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R39.M3-003 (#1333): KIND_BT_GATT_CONNECTION dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kbgc_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_bt_gatt_conn_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kbgc_hn_res;

        cmp rbp, 7;
        ja  kbgc_hn_unsup;

        cmp rbp, 7;
        je  kbgc_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kbgc_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kbgc_hn_key;
        cmp rbp, 1;
        je  kbgc_hn_ep;
        cmp rbp, 2;
        je  kbgc_hn_addr_hi;
        cmp rbp, 3;
        je  kbgc_hn_addr_lo;
        cmp rbp, 4;
        je  kbgc_hn_mtu;
        cmp rbp, 5;
        je  kbgc_hn_st;
        call kbgc_row_sec;
        jmp kbgc_hn_out;

      kbgc_hn_key:
        call kbgc_row_key;
        jmp kbgc_hn_out;
      kbgc_hn_ep:
        call kbgc_row_endpoint;
        jmp kbgc_hn_out;
      kbgc_hn_addr_hi:
        call kbgc_row_addr;
        shr rax, 24;                     // upper 24 bits of BD_ADDR
        and rax, 0xFFFFFF;
        jmp kbgc_hn_out;
      kbgc_hn_addr_lo:
        call kbgc_row_addr;
        and rax, 0xFFFFFF;               // lower 24 bits of BD_ADDR
        jmp kbgc_hn_out;
      kbgc_hn_mtu:
        call kbgc_row_mtu;
        jmp kbgc_hn_out;
      kbgc_hn_st:
        call kbgc_row_state;
        jmp kbgc_hn_out;

      kbgc_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kbgc_hn_denied;
        xor rax, rax;
        jmp kbgc_hn_out;

      kbgc_hn_res:
        mov rax, 0xFFFFF32E;
        jmp kbgc_hn_out;
      kbgc_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kbgc_hn_out;
      kbgc_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kbgc_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
