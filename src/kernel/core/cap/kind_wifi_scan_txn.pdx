// src/kernel/core/cap/kind_wifi_scan_txn.pdx — R38.M3-003 (#1303)
//
// KIND_WIFI_SCAN_TXN = 0x17A, derived over KIND_IPC_ENDPOINT (5).  LINEAR.
//
// One in-flight WiFi scan transaction: a scan_key naming the scan,
// the KIND_IPC_ENDPOINT the supervisor drives commands over, the
// KIND_WIFI_VIF slot the scan runs on, a small FSM state
// (pending / running / done / canceled), a result_count and a
// linear_flag frozen at 1.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A scan is an atomic bounded conversation with the firmware.  Without
// a capability naming the pairing (vif, scan) a caller could:
//
//   (1) Retarget a scan to a different vif mid-flight ("vif swap"):
//       vif_slot is frozen at mint; no op mutates it.
//   (2) Duplicate a live scan to run twice concurrently ("scan clone"):
//       LINEAR discipline -- R_MINT is ABSENT from R_WSCN_ALL AND the
//       mint gate carries an EXPLICIT refuse (WSCN_MINT_REFUSED_MINT)
//       that fires before the subset check.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// A mint additionally requires:
//
//   (a) scan_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//   (c) vif_slot names a live KIND_WIFI_VIF (0x179) (BAD_VIF); the row
//       records the KIND_WIFI_VIF cap slot so downstream consumers can
//       reach the vif's phy/mac/mode without holding the vif cap
//   (d) initial state is always STATE_PENDING; a caller cannot mint
//       into RUNNING / DONE / CANCELED
//   (e) result_count starts at 0
//   (f) linear_flag frozen at 1 (row-level LINEAR fingerprint)
//   (g) rights subset of R_WSCN_ALL, AND rights & R_MINT == 0
//       (LINEAR: §2 explicit gate)
//
// =============================================================================
// §2  LINEAR TRIPLE-CHECK (STRONGER THAN LEAF)
// =============================================================================
//
// (1) R_WSCN_MINT (0x200) is ABSENT from R_WSCN_ALL (0x41B).  A mint
//     request with R_MINT set fails the subset test.
// (2) The mint gate carries an EXPLICIT refuse
//     (WSCN_MINT_REFUSED_MINT) that fires BEFORE the subset check.
//     Legibility: an operator can distinguish a LINEAR trip from an
//     ordinary rights-mask trip.
// (3) The row itself carries linear_flag = 1 in body2[23:16] so a
//     downstream consumer walking the row through wscn_row_linear can
//     assert LINEAR without re-reading rights.
//
// =============================================================================
// §3  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  scan_key    (u64)
//   [+16] body1:   endpoint_slot[31:0] | vif_slot[63:32]
//   [+24] body2:   state[7:0] | result_count[15:8] | linear_flag[23:16]
//                | reserved[63:24]     (linear_flag == 1)
//
// state and result_count are the ONLY mutable fields: wscn_row_transition
// and wscn_row_bump_results are the sole mutators.  linear_flag is
// frozen at 1 by wscn_body2_pack and no path in this module rewrites
// the linear-flag byte.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF450..0xFFFFF45F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: KIND_WIFI_VIF
// 0xFFFFF460..6F; adjacent free band below: wifi_control_channel
// 0xFFFFF440..4F).

module KindWifiScanTxn = structure {

  pub let KIND_WIFI_SCAN_TXN   : u64 = 0x17A
  pub let WSCN_PARENT_KIND     : u64 = 5           // = KIND_IPC_ENDPOINT
  pub let WSCN_VIF_KIND        : u64 = 0x179       // = KIND_WIFI_VIF

  // FSM state ordinals (§1d).
  pub let WSCN_STATE_PENDING  : u64 = 0
  pub let WSCN_STATE_RUNNING  : u64 = 1
  pub let WSCN_STATE_DONE     : u64 = 2
  pub let WSCN_STATE_CANCELED : u64 = 3
  pub let WSCN_STATE_MAX      : u64 = 3

  // Rights.  LINEAR: R_MINT (0x200) NOT in the mask AND explicit refuse.
  pub let R_WSCN_READ    : u64 = 0x001
  pub let R_WSCN_WRITE   : u64 = 0x002
  pub let R_WSCN_INVOKE  : u64 = 0x008
  pub let R_WSCN_REVOKE  : u64 = 0x010
  pub let R_WSCN_OBSERVE : u64 = 0x400
  pub let R_WSCN_ALL     : u64 = 0x41B
  pub let R_WSCN_MINT    : u64 = 0x200             // LINEAR gate refuses

  // Ops.  All arity ONE -- op_arg[63:8] REFUSED.
  pub let WSCN_OP_QUERY_KEY      : u64 = 0
  pub let WSCN_OP_QUERY_ENDPOINT : u64 = 1
  pub let WSCN_OP_QUERY_VIF      : u64 = 2
  pub let WSCN_OP_QUERY_STATE    : u64 = 3
  pub let WSCN_OP_QUERY_RESULTS  : u64 = 4
  pub let WSCN_OP_QUERY_LINEAR   : u64 = 5
  pub let WSCN_OP_DEBUG_PRINT    : u64 = 6
  pub let WSCN_OP_MAX            : u64 = 6

  // Failure taxonomy -- 0xFFFFF450..0xFFFFF45F.
  pub let WSCN_OK                 : u64 = 0
  pub let WSCN_TAIL_ENOSPC        : u64 = 0xFFFFF45F
  pub let WSCN_TAIL_BAD_ARG       : u64 = 0xFFFFF45E
  pub let WSCN_MINT_BAD_PARENT    : u64 = 0xFFFFF45D
  pub let WSCN_MINT_BAD_RIGHTS    : u64 = 0xFFFFF45C
  pub let WSCN_MINT_BAD_VIF       : u64 = 0xFFFFF45B
  pub let WSCN_MINT_BAD_STATE     : u64 = 0xFFFFF45A
  pub let WSCN_MINT_NO_ENDPOINT   : u64 = 0xFFFFF459
  pub let WSCN_MINT_NO_KEY        : u64 = 0xFFFFF458
  pub let WSCN_MINT_ENOSPC        : u64 = 0xFFFFF457
  pub let WSCN_MINT_IN_USE        : u64 = 0xFFFFF456
  pub let WSCN_BAD_SLOT           : u64 = 0xFFFFF455
  pub let WSCN_WRONG_KIND         : u64 = 0xFFFFF454
  pub let WSCN_REVOKE_ALREADY     : u64 = 0xFFFFF453
  pub let WSCN_BAD_TRANSITION     : u64 = 0xFFFFF452
  pub let WSCN_RESULTS_OVERFLOW   : u64 = 0xFFFFF451
  pub let WSCN_MINT_REFUSED_MINT  : u64 = 0xFFFFF450    // LINEAR explicit

  pub let WSCN_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let WSCN_ROW_NONE   : u64 = 0xFF

  pub let WSCN_MAX       : u64 = 8
  pub let WSCN_ROW_BYTES : u64 = 32

  pub let mut _wifi_scan_table : [u64; 32] = uninit @align(64)
  pub let mut _wifi_scan_stats : [u64; 4]  = uninit @align(64)

  pub let WSCN_ST_MINTS       : u64 = 0
  pub let WSCN_ST_REVOKES     : u64 = 1
  pub let WSCN_ST_TRANSITIONS : u64 = 2
  pub let WSCN_ST_REFUSED     : u64 = 3

  pub let wscn_dbg_msg : [u8; 14] = "WIFI SCAN ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let wifi_scan_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): clear KIND_WIFI_SCAN_TXN row table and counters. Labels prefixed wscn_rs_.",
      block: {
        lea r10, [rip + _wifi_scan_table];
        xor rax, rax;
        xor rcx, rcx;
      wscn_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  wscn_rs_rows;

        lea r10, [rip + _wifi_scan_stats];
        xor rcx, rcx;
      wscn_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  wscn_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let wscn_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-003 (#1303): 1 iff s <= WSCN_STATE_MAX. Labels prefixed wscn_sv_.",
      block: {
        cmp rdi, 3;
        ja  wscn_sv_no;
        mov rax, 1;
        ret;
      wscn_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let wscn_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-003 (#1303): subset test against R_WSCN_ALL = 0x41B. R_MINT (0x200) OUTSIDE the mask -- LINEAR (§2 gate 1). Labels prefixed wscn_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne wscn_rgv_no;
        mov rax, 1;
        ret;
      wscn_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let wscn_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): counter bump. Labels prefixed wscn_nt_.",
      block: {
        cmp rdi, 4;
        jae wscn_nt_out;
        lea r10, [rip + _wifi_scan_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wscn_nt_out:
        ret
      }
    }

  pub let wscn_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): counter read. Labels prefixed wscn_stt_.",
      block: {
        cmp rdi, 4;
        jae wscn_stt_zero;
        lea r10, [rip + _wifi_scan_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wscn_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent + VIF gates.
  // ==========================================================================

  pub let wscn_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed wscn_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wscn_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne wscn_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  wscn_cp_no;

        mov rax, 1;
        ret;
      wscn_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let wscn_check_vif : (u64) -> u64 !{mem} @{cap} =
    fn (vif_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): vif_slot must name a live KIND_WIFI_VIF (0x179). Labels prefixed wscn_cv_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wscn_cv_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x179;
        cmp r10, r11;
        jne wscn_cv_no;

        mov rax, 1;
        ret;
      wscn_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let wscn_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-003 (#1303): (parent_slot << 8). Labels prefixed wscn_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae wscn_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      wscn_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wscn_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (vif_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-003 (#1303): pack endpoint_slot[31:0] | vif_slot[63:32]. Labels prefixed wscn_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  wscn_b1_bad;
        cmp rsi, r10;
        ja  wscn_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      wscn_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wscn_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (state: u64) (result_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-003 (#1303): pack state[7:0] | result_count[15:8] | linear_flag[23:16]=1. LINEAR §2 gate 3: linear_flag is FROZEN at 1 by this packer. Labels prefixed wscn_b2_.",
      block: {
        cmp rdi, 3;
        ja  wscn_b2_bad;
        cmp rsi, 0xFF;
        ja  wscn_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        // linear_flag frozen at 1 in [23:16].
        mov r10, 1;
        shl r10, 16;
        or  rax, r10;
        ret;
      wscn_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _wifi_scan_table.
  // ==========================================================================

  pub let wscn_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (scan_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): claim one SCAN row. THE ONE WRITER. Labels prefixed wscn_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne wscn_ta_bad;

        cmp r13, 0;
        je  wscn_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  wscn_ta_bad;
        cmp r15, r10;
        je  wscn_ta_bad;

        xor rbx, rbx;
      wscn_ta_scan:
        cmp rbx, 8;
        jae wscn_ta_enospc;

        lea r10, [rip + _wifi_scan_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wscn_ta_claim;

        add rbx, 1;
        jmp wscn_ta_scan;

      wscn_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp wscn_ta_out;

      wscn_ta_enospc:
        mov rax, 0xFFFFF45F;
        jmp wscn_ta_out;
      wscn_ta_bad:
        mov rax, 0xFFFFF45E;

      wscn_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let wscn_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): 1 iff row_id<MAX and in_use. Labels prefixed wscn_tvr_.",
      block: {
        cmp rdi, 8;
        jae wscn_tvr_no;
        lea r10, [rip + _wifi_scan_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wscn_tvr_no;
        mov rax, 1;
        ret;
      wscn_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let wscn_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): scrub one row. Labels prefixed wscn_tf_.",
      block: {
        cmp rdi, 8;
        jae wscn_tf_out;
        lea r10, [rip + _wifi_scan_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      wscn_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let wscn_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): scan_key. Labels prefixed wscn_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_rk_bad;
        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp wscn_rk_out;
      wscn_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wscn_rk_out:
        pop r12;
        ret
      }
    }

  pub let wscn_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): endpoint_slot (body1[31:0]). Labels prefixed wscn_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_re_bad;
        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp wscn_re_out;
      wscn_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wscn_re_out:
        pop r12;
        ret
      }
    }

  pub let wscn_row_vif : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): vif_slot (body1[63:32]). Labels prefixed wscn_rv_.",
      block: {
        push r12;
        mov r12, rdi;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_rv_bad;
        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp wscn_rv_out;
      wscn_rv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wscn_rv_out:
        pop r12;
        ret
      }
    }

  pub let wscn_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): state (body2[7:0]). Labels prefixed wscn_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_rst_bad;
        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp wscn_rst_out;
      wscn_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wscn_rst_out:
        pop r12;
        ret
      }
    }

  pub let wscn_row_results : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): result_count (body2[15:8]). Labels prefixed wscn_rrs_.",
      block: {
        push r12;
        mov r12, rdi;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_rrs_bad;
        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 8;
        and rax, 0xFF;
        jmp wscn_rrs_out;
      wscn_rrs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wscn_rrs_out:
        pop r12;
        ret
      }
    }

  pub let wscn_row_linear : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): linear_flag (body2[23:16]). LINEAR §2 gate 3: frozen at 1 at mint. Labels prefixed wscn_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_rl_bad;
        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        and rax, 0xFF;
        jmp wscn_rl_out;
      wscn_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wscn_rl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // wscn_row_transition -- the ONE MUTATOR of the state field.  Legal
  // edges: PENDING -> RUNNING, RUNNING -> DONE, RUNNING -> CANCELED,
  // PENDING -> CANCELED.
  // ==========================================================================

  pub let wscn_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): mutate state field on one row. Preserves result_count and linear_flag. Labels prefixed wscn_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_rt_bad;

        mov rdi, r13;
        call wscn_state_valid;
        cmp rax, 0;
        je  wscn_rt_bad;

        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;

        cmp rax, 0;
        je  wscn_rt_from_pending;
        cmp rax, 1;
        je  wscn_rt_from_running;
        jmp wscn_rt_bad;
      wscn_rt_from_pending:
        cmp r13, 1;
        je  wscn_rt_apply;
        cmp r13, 3;
        je  wscn_rt_apply;
        jmp wscn_rt_bad;
      wscn_rt_from_running:
        cmp r13, 2;
        je  wscn_rt_apply;
        cmp r13, 3;
        je  wscn_rt_apply;
        jmp wscn_rt_bad;

      wscn_rt_apply:
        mov rax, [r10 + 24];
        mov r11, 0xFF;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        or  rax, r11;
        mov [r10 + 24], rax;

        mov rdi, 2;
        call wscn_note;
        xor rax, rax;
        jmp wscn_rt_out;

      wscn_rt_bad:
        mov rax, 0xFFFFF452;

      wscn_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // wscn_row_bump_results -- monotonic result_count increment (bounded by
  // 0xFF; overflow returns RESULTS_OVERFLOW rather than wrapping).
  // ==========================================================================

  pub let wscn_row_bump_results : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): +1 to result_count; refuses at 0xFF rather than wrapping. Preserves state and linear_flag. Labels prefixed wscn_bmp_.",
      block: {
        push r12;
        mov r12, rdi;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_bmp_bad;

        lea r10, [rip + _wifi_scan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        mov r11, rax;
        shr r11, 8;
        and r11, 0xFF;
        cmp r11, 0xFF;
        jae wscn_bmp_ovf;
        add r11, 1;
        mov r9, 0xFF;
        shl r9, 8;
        not r9;
        and rax, r9;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 24], rax;
        xor rax, rax;
        jmp wscn_bmp_out;

      wscn_bmp_ovf:
        mov rax, 0xFFFFF451;
        jmp wscn_bmp_out;
      wscn_bmp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      wscn_bmp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let wscn_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (scan_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-003 (#1303): live row holding scan_key, or ROW_NONE. Labels prefixed wscn_fk_.",
      block: {
        cmp rdi, 0;
        je  wscn_fk_none;
        xor rcx, rcx;
      wscn_fk_scan:
        cmp rcx, 8;
        jae wscn_fk_none;
        lea r10, [rip + _wifi_scan_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wscn_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  wscn_fk_hit;
      wscn_fk_next:
        add rcx, 1;
        jmp wscn_fk_scan;
      wscn_fk_hit:
        mov rax, rcx;
        ret;
      wscn_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let wscn_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): slot -> row_id, gated on live KIND_WIFI_SCAN_TXN. Labels prefixed wscn_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae wscn_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x17A;
        cmp r10, r11;
        jne wscn_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_ros_none;

        mov rax, r12;
        jmp wscn_ros_out;

      wscn_ros_none:
        mov rax, 0xFF;
      wscn_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Four args (slot, parent_slot, rights, scan_key, vif_slot).
  // ==========================================================================

  pub let wifi_scan_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (scan_key: u64) (vif_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): mint KIND_WIFI_SCAN_TXN. LINEAR TRIPLE-CHECK -- gate 1: R_MINT ABSENT from R_WSCN_ALL; gate 2: rights & R_MINT is EXPLICITLY refused (WSCN_MINT_REFUSED_MINT) BEFORE the subset check; gate 3: linear_flag frozen at 1 in the row body. Sequence: slot<256; explicit R_MINT refuse; check_parent; rights_valid; check_vif; scan_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed wscn_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // scan_key
        mov rbp, r8;                     // vif_slot

        mov r10, 256;
        cmp rbx, r10;
        jae wscn_mi_bad_slot;

        // LINEAR gate 2 (§2): rights & R_MINT must be zero.
        mov r10, r13;
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        jne wscn_mi_refused_mint;

        mov rdi, r12;
        call wscn_check_parent;
        cmp rax, 0;
        je  wscn_mi_bad_parent;

        mov rdi, r13;
        call wscn_rights_valid;
        cmp rax, 0;
        je  wscn_mi_bad_rights;

        mov rdi, rbp;
        call wscn_check_vif;
        cmp rax, 0;
        je  wscn_mi_bad_vif;

        cmp r14, 0;
        je  wscn_mi_no_key;

        mov rdi, r14;
        call wscn_find_by_key;
        cmp rax, 0xFF;
        jne wscn_mi_in_use;

        // Body1 pack: (endpoint_slot=parent_slot, vif_slot).
        mov rdi, r12;
        mov rsi, rbp;
        call wscn_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wscn_mi_bad_state;
        push rax;                        // body1 on stack

        // Body2 pack: (state=PENDING, result_count=0) -- linear_flag frozen 1.
        mov rdi, 0;                      // PENDING
        mov rsi, 0;                      // result_count
        call wscn_body2_pack;
        pop r11;                         // body1 -> r11
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wscn_mi_bad_state;
        push rax;                        // body2 on stack (top)
        push r11;                        // body1 on stack (next)

        // Header.
        mov rdi, r12;
        call wscn_hdr_pack;
        pop r11;                         // body1
        pop r15;                         // body2
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wscn_mi_bad_parent;

        // tail_alloc(hdr, scan_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call wscn_tail_alloc;

        mov r10, 0xFFFFF45F;
        cmp rax, r10;
        je  wscn_mi_enospc;
        mov r10, 0xFFFFF45E;
        cmp rax, r10;
        je  wscn_mi_bad_state;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x17A;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call wscn_note;

        xor rax, rax;
        jmp wscn_mi_out;

      wscn_mi_bad_slot:
        mov rax, 0xFFFFF455;
        jmp wscn_mi_out;
      wscn_mi_refused_mint:
        mov rdi, 3;
        call wscn_note;
        mov rax, 0xFFFFF450;
        jmp wscn_mi_out;
      wscn_mi_bad_parent:
        mov rax, 0xFFFFF45D;
        jmp wscn_mi_out;
      wscn_mi_bad_rights:
        mov rax, 0xFFFFF45C;
        jmp wscn_mi_out;
      wscn_mi_bad_vif:
        mov rax, 0xFFFFF45B;
        jmp wscn_mi_out;
      wscn_mi_bad_state:
        mov rax, 0xFFFFF45A;
        jmp wscn_mi_out;
      wscn_mi_no_key:
        mov rax, 0xFFFFF458;
        jmp wscn_mi_out;
      wscn_mi_in_use:
        mov rdi, 3;
        call wscn_note;
        mov rax, 0xFFFFF456;
        jmp wscn_mi_out;
      wscn_mi_enospc:
        mov rdi, 3;
        call wscn_note;
        mov rax, 0xFFFFF457;

      wscn_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let wifi_scan_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): revoke KIND_WIFI_SCAN_TXN. Advances state to CANCELED before scrubbing. Labels prefixed wscn_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae wscn_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  wscn_rvk_already;

        mov r11, 0x17A;
        cmp r10, r11;
        jne wscn_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call wscn_tail_valid;
        cmp rax, 0;
        je  wscn_rvk_clear;

        mov rdi, r13;
        call wscn_tail_free;

      wscn_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call wscn_note;

        xor rax, rax;
        jmp wscn_rvk_out;

      wscn_rvk_bad_slot:
        mov rax, 0xFFFFF455;
        jmp wscn_rvk_out;
      wscn_rvk_wrong_kind:
        mov rax, 0xFFFFF454;
        jmp wscn_rvk_out;
      wscn_rvk_already:
        mov rax, 0xFFFFF453;

      wscn_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_wifi_scan_txn : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R38.M3-003 (#1303): KIND_WIFI_SCAN_TXN dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed wscn_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_wifi_scan_txn_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne wscn_hn_res;

        cmp rbp, 6;
        ja  wscn_hn_unsup;

        cmp rbp, 6;
        je  wscn_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  wscn_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  wscn_hn_key;
        cmp rbp, 1;
        je  wscn_hn_ep;
        cmp rbp, 2;
        je  wscn_hn_vif;
        cmp rbp, 3;
        je  wscn_hn_st;
        cmp rbp, 4;
        je  wscn_hn_res_ct;
        call wscn_row_linear;
        jmp wscn_hn_out;

      wscn_hn_key:
        call wscn_row_key;
        jmp wscn_hn_out;
      wscn_hn_ep:
        call wscn_row_endpoint;
        jmp wscn_hn_out;
      wscn_hn_vif:
        call wscn_row_vif;
        jmp wscn_hn_out;
      wscn_hn_st:
        call wscn_row_state;
        jmp wscn_hn_out;
      wscn_hn_res_ct:
        call wscn_row_results;
        jmp wscn_hn_out;

      wscn_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  wscn_hn_denied;
        xor rax, rax;
        jmp wscn_hn_out;

      wscn_hn_res:
        mov rax, 0xFFFFF45E;
        jmp wscn_hn_out;
      wscn_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp wscn_hn_out;
      wscn_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      wscn_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
