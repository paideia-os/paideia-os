// src/kernel/core/cap/kind_session.pdx -- R113.M5-022 (paideia-os #2402)
//
// KIND_SESSION = 0x1BC kernel-side substrate (row pool + mint + destroy +
// attach-seat + set-state).
//
// PURPOSE.  A user session capability that names the login-screen /
// user-shell / lock-screen lifecycle for one physical user.  Sits above
// KIND_SEAT (which names the input-device collection bound to a
// physical seat) and coordinates the state a display manager, a
// desktop shell, and a lock-screen agent all need to agree on:
//
//   LOGIN  = 1  -- greeter is active, no user shell yet running
//   ACTIVE = 2  -- user shell is up and receiving events
//   LOCKED = 3  -- screen locked; lock-screen agent brokers events
//   EXITED = 4  -- session ended; row is a tombstone until destroy
//
// A session owns zero or more seats (a multi-seat login-multiplexing
// kiosk chain has one session per user, each attached to its own
// physical seat; a typical desktop is one session, one seat).  The
// seat-ownership relation lives on the session row as a u64 bitmap
// keyed by seat_slot (0..63); the SEAT_MAX ceiling of 8 leaves 56
// bits of headroom before this kind has to bump its bitmap width.
//
// IDENTITY CHOICE -- session_id == row_id (slot).  This landing takes
// the surface_kind precedent: the internal slot index IS the caller-
// visible session_id.  A monotonic-counter identity was considered
// (distinct session_id + row_id, id survives slot reuse via a lookup
// helper) and rejected: (a) LAM generation on row+0 already invalidates
// stale handles to a reused slot without a second identity space,
// (b) callers holding sid=<n> after destroy learn about the destroy
// via SESSION_DESTROY_ALREADY / SESSION_BAD_SLOT on the next op, same
// as row_id-based callers do, (c) removing the lookup helper saves
// the O(SESSION_ROW_MAX=16) scan on every attach/set_state call.  The
// fingerprint's `sid=<n>` therefore emits the slot index.
//
// SCOPE OF THIS LANDING (per issue #2402):
//   * Substrate: row pool (SESSION_ROW_MAX = 16 rows * 64 bytes = 1 KiB),
//     _session_stats[8], and the init leaf that scrubs both.
//   * Ops: session_mint(owner_task) -> session_id | error,
//          session_destroy(session_id),
//          session_attach_seat(session_id, seat_slot),
//          session_set_state(session_id, new_state).
//   * Fingerprint: `SESSION MINT OK sid=<n> owner=<n>` via klog_s1_x2
//     (two-KV tag).  Destroy/attach/set-state DO NOT emit fingerprints
//     -- the mint tag is the only R113.M5-022 boot-witness anchor per
//     the issue's fingerprint contract.
//   * Row accessors (session_row_valid / session_row_addr /
//     session_row_state_get / session_row_seats_get) as pure leaves
//     for consumers in the follow-on session-manager landings.
//
// DERIVED-KIND POSITIONING.  KIND_SESSION derives from KIND_IPC_
// ENDPOINT (= 5) in the abstract graph -- a session is a rendez-vous
// point between the display manager, the shell, and the lock-screen
// agent, all of which communicate over the endpoint the session names.
// The concrete substrate parent is nil (this kind is the root of the
// session sub-graph; seats attach TO a session via the bitmap, they do
// not derive FROM it).
//
// KIND-ID SLOT ALLOCATION -- 0x1BC.
//   0x1B0  KIND_PAGE_FLIP           (R104.M4-001)
//   0x1B1  KIND_HOTPLUG_CHANNEL     (R105.M4-001)
//   0x1B2  KIND_SCHEMA_HANDLE       (R90-XREPO.012.M3-001)
//   0x1B3  KIND_VOLUME_SNAPSHOT     (LV11.M3-001)
//   0x1B4  KIND_KEK                 (LV11.M5-001)
//   0x1B5  KIND_HDR_METADATA        (user G6 Batch-1)
//   0x1B6  KIND_TONEMAP_LUT         (user G6 Batch-1)
//   0x1B7  KIND_REFERENCE_DISPLAY   (user G6 Batch-1)
//   0x1B8  KIND_SURFACE             (R113.M1-001)
//   0x1B9  KIND_SURFACE_COMMIT      (user G6 Batch-2)
//   0x1BA  KIND_SUBSURFACE          (user subsurface_sync.pdx)
//   0x1BB  reserved (next-free run below KIND_SESSION)
//   0x1BC  KIND_SESSION             (THIS LANDING, R113.M5-022)
//   0x1BD..0x1BF  free (next fresh slots for follow-on M5 rows)
//
// The three user-side files that mention 0x1BC (src/samples/editor/
// buffer.pdx:119, src/user/compositor/popup_positioning.pdx:90/94,
// src/user/compositor/window_kind.pdx:11/52) name it only in reserved-
// range comments; none declares a KIND_* constant at 0x1BC.  Grep
// against src/**/*.pdx for `= 0x1BC` returns zero declarations before
// this landing.
//
// FAILURE BAND -- 0xFFFFE270..0xFFFFE27F.  Verified free by tree-wide
// grep against src/**/*.pdx (empty match); allocated per the issue's
// pre-assigned band directive.
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+):
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- row-offset math uses `shl r, 6` for *64.
//   * No `and reg, imm64` -- the 56-bit gen mask (0x00FFFFFFFFFFFFFF)
//     is staged through `mov r9, imm64` then `and r11, r9`.  The 32-bit
//     mask 0xFFFFFFFF is safe as an immediate per the kind_surface /
//     kind_tui_canvas precedent.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement form `[reg + 8N]`
//     used throughout; register-scaled `[reg + rcx * 8]` (SIB-legal
//     scale) is used only in the stats bumpers and init scrub.
//   * Reserved-keyword labels avoided (loop/if/let/while/for/match/pub/
//     mod/use/fn/struct/enum/impl/trait/type/where/move/mut/ref).
//     Label prefixes:  sess_init_  sess_bm_  sess_bd_ sess_br_
//                      sess_ba_    sess_bs_  sess_m_  sess_d_
//                      sess_a_     sess_s_   sess_rv_ sess_ra_
//                      sess_rst_   sess_rsb_
//
// STACK DISCIPLINE (mint path calls klog_s1_x2 with a v2 stack push).
// The v2-push idiom is lifted verbatim from src/kernel/core/fs/pdxfs/
// wal.pdx wal_fs_bdev_flush (L1058-1061):
//     sub rsp, 8;      // pad to keep rsp%16==0 after the push
//     push <v2>;       // seventh klog arg
//     call klog_s1_x2;
//     add rsp, 16;     // undo pad + push in one shot
// The prologue lands rsp%16 == 0 before the sub/push pair.

module KindSession = structure {

  // ==========================================================================
  // SECTION 1 -- IDENTITY + PARENT + POOL CEILING
  // ==========================================================================

  pub let KIND_SESSION_ID    : u64 = 0x1BC
  pub let KIND_SESSION_BASE  : u64 = 5           // = KIND_IPC_ENDPOINT

  // Pool ceiling.  16 concurrent sessions covers: (a) typical desktop
  // (1 session, ACTIVE), (b) locked desktop (1 session, LOCKED), (c)
  // fast-user-switch chain (2-3 sessions, one ACTIVE + rest LOCKED),
  // (d) multi-seat kiosk (up to 8 seats, one session each), (e) 8
  // additional headroom for a chained login-multiplexing scenario or
  // a session-restore replay pass.  16 * 64 = 1024 bytes -- one quarter
  // page slab, matches the kind_surface SURFACE_ROW_MAX one-for-one.
  pub let SESSION_ROW_MAX   : u64 = 16
  pub let SESSION_ROW_BYTES : u64 = 64
  pub let SESSION_ROW_WORDS : u64 = 8

  // ==========================================================================
  // SECTION 2 -- RIGHTS
  // ==========================================================================
  //
  // Rights split so a lock-screen agent (holds SET_STATE) is distinct
  // from a display manager (holds ATTACH_SEAT + MINT) is distinct from
  // a session-close hook (holds DESTROY).  R_SESSION_READ / _OBSERVE
  // are the introspection rights the shell holds for status-bar
  // widgets (session name, active seats).
  //
  //   R_SESSION_READ         -- read session_id, owner, state
  //   R_SESSION_ATTACH_SEAT  -- add a seat to the seat_slot_bitmap
  //   R_SESSION_SET_STATE    -- transition LOGIN/ACTIVE/LOCKED/EXITED
  //   R_SESSION_DESTROY      -- revoke the session row
  //   R_SESSION_MINT         -- derive a child session (future)
  //   R_SESSION_OBSERVE      -- introspection (seat bitmap enumeration)

  pub let R_SESSION_READ         : u64 = 0x001
  pub let R_SESSION_ATTACH_SEAT  : u64 = 0x008
  pub let R_SESSION_SET_STATE    : u64 = 0x010
  pub let R_SESSION_DESTROY      : u64 = 0x020
  pub let R_SESSION_MINT         : u64 = 0x200
  pub let R_SESSION_OBSERVE      : u64 = 0x400
  pub let R_SESSION_ALL          : u64 = 0x639
    // 0x001 | 0x008 | 0x010 | 0x020 | 0x200 | 0x400 = 0x639

  // ==========================================================================
  // SECTION 3 -- ROW LAYOUT OFFSETS + STATE CONSTANTS
  // ==========================================================================
  //
  //   +0   hdr        in_use[63:56] | generation[55:0]  (56-bit LAM ABA)
  //   +8   ident      session_id  (u64; == row_id, mirrored for legibility)
  //   +16  owner      owner_task_id (u64)
  //   +24  state      session_state (u64; LOGIN=1 / ACTIVE=2 / LOCKED=3 /
  //                                       EXITED=4; 0 is not a legal state,
  //                                       it is the pre-mint zero-init value
  //                                       and is only reachable inside a row
  //                                       whose in_use byte is clear)
  //   +32  seats      seat_slot_bitmap (u64; bit N == seat N owned)
  //   +40  reserved   (future: parent_session_id for delegated sessions)
  //   +48  reserved   (future: created_tsc for accounting)
  //   +56  reserved   (future: auth_kind_id for pluggable auth)
  //
  // The reserved words are zero-init at mint and MUST NOT be touched
  // by attach-seat / set-state / destroy -- follow-on landings that
  // widen the row consume these slots in a single grep-verify sweep.

  pub let SESSION_OFF_HDR        : u64 = 0
  pub let SESSION_OFF_SID        : u64 = 8
  pub let SESSION_OFF_OWNER      : u64 = 16
  pub let SESSION_OFF_STATE      : u64 = 24
  pub let SESSION_OFF_SEATS      : u64 = 32
  pub let SESSION_OFF_RESERVED1  : u64 = 40
  pub let SESSION_OFF_RESERVED2  : u64 = 48
  pub let SESSION_OFF_RESERVED3  : u64 = 56

  // Session lifecycle states (per issue #2402 contract: LOGIN=1,
  // ACTIVE=2, LOCKED=3, EXITED=4).  0 is not a legal state ordinal;
  // it is the pre-mint zero-init value and only reachable in a row
  // whose in_use byte is clear.  set_state's gate rejects new_state == 0
  // alongside new_state > EXITED to keep the state field always-legal
  // post-mint.
  pub let SESSION_STATE_LOGIN    : u64 = 1
  pub let SESSION_STATE_ACTIVE   : u64 = 2
  pub let SESSION_STATE_LOCKED   : u64 = 3
  pub let SESSION_STATE_EXITED   : u64 = 4
  pub let SESSION_STATE_MAX      : u64 = 4     // last legal state ordinal
  pub let SESSION_STATE_MIN      : u64 = 1     // first legal state ordinal

  // Seat-slot bitmap width.  A u64 bitmap covers seat_slot in [0,63]
  // (bit N == seat N owned).  SEAT_MAX = 8 leaves 56 bits of headroom
  // before this kind has to bump its bitmap width; the gate below
  // rejects seat_slot >= 64 rather than seat_slot >= SEAT_MAX so a
  // future SEAT_MAX bump under 64 does not need to touch this kind.
  pub let SESSION_SEAT_SLOT_MAX  : u64 = 64

  // ==========================================================================
  // SECTION 4 -- FAILURE TAXONOMY -- 0xFFFFE270..0xFFFFE27F
  // ==========================================================================
  //
  // Verified free by tree-wide grep for 0xFFFFE27* against src/**/*.pdx
  // (empty match) at landing time.

  pub let SESSION_OK                       : u64 = 0
  pub let SESSION_TAIL_ENOSPC              : u64 = 0xFFFFE27F
  pub let SESSION_MINT_BAD_OWNER           : u64 = 0xFFFFE27E
  pub let SESSION_MINT_BAD_RIGHTS          : u64 = 0xFFFFE27D
  pub let SESSION_BAD_SLOT                 : u64 = 0xFFFFE27C
  pub let SESSION_DESTROY_ALREADY          : u64 = 0xFFFFE27B
  pub let SESSION_ATTACH_BAD_SEAT          : u64 = 0xFFFFE27A
  pub let SESSION_ATTACH_ALREADY           : u64 = 0xFFFFE279
  pub let SESSION_STATE_BAD                : u64 = 0xFFFFE278
  pub let SESSION_STATE_TERMINAL           : u64 = 0xFFFFE277
  pub let SESSION_GEN_MISMATCH             : u64 = 0xFFFFE276
  pub let SESSION_BAD_ARG                  : u64 = 0xFFFFE275
  pub let SESSION_WRONG_KIND               : u64 = 0xFFFFE274
  pub let SESSION_UNSUP_OP                 : u64 = 0xFFFFE273
  pub let SESSION_BAD_RIGHTS               : u64 = 0xFFFFE272
  pub let SESSION_ROW_NONE                 : u64 = 0xFFFFE271
  pub let SESSION_DECODE_BAD               : u64 = 0xFFFFE270

  // ==========================================================================
  // SECTION 5 -- POOL SUBSTRATE
  // ==========================================================================
  //
  // 16 rows * 64 bytes = 1024 bytes = 128 u64 words.  Stats table sized
  // to 8 slots to leave headroom for follow-on landings (attach/set-
  // state bumpers, seat-detach in a future M5 revision).  Pool named
  // `_sessions` per issue #2402 contract (kind_surface's parallel
  // pool is `_surface_table`; the naming difference is intentional
  // and follows the seat_kind precedent).

  pub let mut _sessions        : [u64; 128] = uninit @align(64)  // 16 * 8
  pub let mut _session_stats   : [u64; 8]   = uninit @align(64)

  pub let SESSION_ST_MINTS         : u64 = 0
  pub let SESSION_ST_DESTROYS      : u64 = 1
  pub let SESSION_ST_REFUSED       : u64 = 2
  pub let SESSION_ST_ATTACH_SEAT   : u64 = 3
  pub let SESSION_ST_SET_STATE     : u64 = 4
  pub let SESSION_ST_MAX           : u64 = 8

  // ==========================================================================
  // SECTION 6 -- FINGERPRINT TAG + KV KEY NAMES
  // ==========================================================================
  //
  // Only the mint tag is emitted by this landing (per issue #2402's
  // fingerprint contract).  Byte counts verified by hand:
  //
  //   "session mint ok [legacy: SESSION MINT OK]\0" = 42 bytes
  //     - "session mint ok"                    = 15
  //     - " [legacy: SESSION MINT OK]"         = 26
  //     - NUL                                  = 1
  //     -------------------------------------------
  //     - total                                = 42
  //
  // KV keys ("sid" + "own"): both 4 bytes including NUL.

  pub let session_mint_ok_msg : [u8; 42] = "session mint ok [legacy: SESSION MINT OK]\0"
  pub let session_k_sid       : [u8; 4]  = "sid\0"
  pub let session_k_own       : [u8; 4]  = "own\0"

  // ==========================================================================
  // SECTION 7 -- STATS BUMPERS (narrow writers)
  // ==========================================================================
  //
  // Narrow writers per the kind_surface / kind_tui_canvas discipline:
  // one leaf per stats slot, load-inc-store, no `add reg, [mem]`.
  // The ONLY writers of _session_stats.

  pub let session_stats_bump_mints : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): bump _session_stats[SESSION_ST_MINTS=0]. Load-inc-store leaf, no `add reg, [mem]`. Called from session_mint success tail only. Labels prefixed sess_bm_.",
      block: {
        lea r10, [rip + _session_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let session_stats_bump_destroys : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): bump _session_stats[SESSION_ST_DESTROYS=1]. Load-inc-store leaf. Called from session_destroy success tail only. Labels prefixed sess_bd_.",
      block: {
        lea r10, [rip + _session_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let session_stats_bump_refused : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): bump _session_stats[SESSION_ST_REFUSED=2]. Load-inc-store leaf. Called from every refusal funnel across mint/destroy/attach/set-state -- matches kind_surface's surface_stats_bump_refused broad scope (any op refusal counts toward the meter). Labels prefixed sess_br_.",
      block: {
        lea r10, [rip + _session_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  pub let session_stats_bump_attach : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): bump _session_stats[SESSION_ST_ATTACH_SEAT=3]. Load-inc-store leaf. Called from session_attach_seat success tail only. Labels prefixed sess_ba_.",
      block: {
        lea r10, [rip + _session_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        ret
      }
    }

  pub let session_stats_bump_set_state : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): bump _session_stats[SESSION_ST_SET_STATE=4]. Load-inc-store leaf. Called from session_set_state success tail only. Labels prefixed sess_bs_.",
      block: {
        lea r10, [rip + _session_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- BOOT INIT (kind_session_init)
  // ==========================================================================
  //
  // Zeroes _sessions (128 u64 words = 1 KiB) and _session_stats (8 u64
  // = 64 B).  Defensive re-scrub matching kind_surface_init /
  // kind_kek_init / kind_volume_snapshot_init one-for-one.  .bss is
  // zero at real boot; this leaf gives a future chaos-restart witness
  // (and any repeat call to the init sequence) a clean re-scrub point.

  pub let kind_session_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): zero _sessions (128 u64) and _session_stats (8 u64). Defensive boot-time re-scrub, mirrors kind_surface_init / kind_kek_init one-for-one. Two straight-line loops. Labels prefixed sess_init_.",
      block: {
        lea r10, [rip + _sessions];
        xor rax, rax;
        xor rcx, rcx;
      sess_init_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  sess_init_rows;

        lea r10, [rip + _session_stats];
        xor rcx, rcx;
      sess_init_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sess_init_stats;

        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- ROW ACCESSORS (pure leaves)
  // ==========================================================================
  //
  // Every accessor takes a session_id (== row_id / slot);
  // return-shape sentinels use SESSION_BAD_SLOT = 0xFFFFE27C.

  // session_row_valid(session_id) -> 1 iff session_id < SESSION_ROW_MAX
  // and the row's in_use byte (top byte of hdr) is nonzero.
  pub let session_row_valid : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): 1 iff session_id < SESSION_ROW_MAX(16) and in_use set. Inlined address compute (session_id*64 via shl 6). Labels prefixed sess_rv_.",
      block: {
        mov r10, [rip + SESSION_ROW_MAX];
        cmp rdi, r10;
        jae sess_rv_no;
        lea r10, [rip + _sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_rv_no;
        mov rax, 1;
        ret;
      sess_rv_no:
        xor rax, rax;
        ret
      }
    }

  // session_row_addr(session_id) -> &_sessions[session_id*64] iff live; 0 else.
  pub let session_row_addr : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): row base pointer post-liveness. Returns 0 on invalid slot (out-of-range OR in_use==0). Exported for follow-on session-manager landings that perform multi-field atomic updates no typed getter can express. Labels prefixed sess_ra_.",
      block: {
        mov r10, [rip + SESSION_ROW_MAX];
        cmp rdi, r10;
        jae sess_ra_no;
        lea r10, [rip + _sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_ra_no;
        mov rax, r10;
        ret;
      sess_ra_no:
        xor rax, rax;
        ret
      }
    }

  // session_row_state_get(session_id) -> state | SESSION_BAD_SLOT.
  pub let session_row_state_get : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): raw state load from row+24. Labels prefixed sess_rst_.",
      block: {
        mov r10, [rip + SESSION_ROW_MAX];
        cmp rdi, r10;
        jae sess_rst_bad;
        lea r10, [rip + _sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_rst_bad;
        mov rax, [r10 + 24];
        ret;
      sess_rst_bad:
        mov rax, 0xFFFFE27C;
        ret
      }
    }

  // session_row_seats_get(session_id) -> seat_slot_bitmap | SESSION_BAD_SLOT.
  pub let session_row_seats_get : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-022 (#2402): raw seat_slot_bitmap load from row+32. Labels prefixed sess_rsb_.",
      block: {
        mov r10, [rip + SESSION_ROW_MAX];
        cmp rdi, r10;
        jae sess_rsb_bad;
        lea r10, [rip + _sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_rsb_bad;
        mov rax, [r10 + 32];
        ret;
      sess_rsb_bad:
        mov rax, 0xFFFFE27C;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- session_mint(owner_task) -> session_id | error
  // ==========================================================================
  //
  // Gate order:
  //   (1) owner_task != 0        -> else SESSION_MINT_BAD_OWNER
  //   (2) low-first free-slot scan over SESSION_ROW_MAX(16) rows
  //                              -> else SESSION_TAIL_ENOSPC
  //   (3) LAM header bump: low-56 gen+1, OR in 1<<56 in_use marker
  //   (4) row stamp per §3:
  //         +8   session_id (= row_id, mirrored for legibility)
  //         +16  owner_task
  //         +24  state = SESSION_STATE_LOGIN (1)
  //         +32  seat_slot_bitmap = 0
  //         +40/+48/+56  reserved = 0
  //   (5) bump stats.mints
  //   (6) emit SESSION MINT OK sid=<session_id> own=<owner> via klog_s1_x2
  //   (7) return session_id (== row_id)
  //
  // Register plan: rbx=session_id (survives klog call), r12=owner_task
  // (needed at fingerprint).  Two callee-save pushes = 16 bytes; entry
  // rsp%16==8 -> (8+16)%16 = 8.  sub rsp,8 pad -> rsp%16==0 for the
  // pre-klog nested call (session_stats_bump_mints).  The klog_s1_x2
  // v2-push idiom (sub rsp,8; push v2; call; add rsp,16) then adds a
  // net 16 bytes during the call, preserving rsp%16 == 0.  add rsp,8
  // at exit undoes the initial pad.

  pub let session_mint : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (owner_task: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M5-022 (#2402): mint KIND_SESSION. Gate order: (1) owner!=0 else BAD_OWNER; (2) low-first scan over 16 rows else TAIL_ENOSPC; (3) LAM header bump; (4) row stamp per §3 (session_id=row_id mirrored at +8, state=LOGIN=1, seats=0, reserved zero); (5) stats.mints++; (6) klog SESSION MINT OK sid=<row_id> own=<owner> via klog_s1_x2 with v2-push idiom lifted verbatim from wal.pdx wal_fs_bdev_flush L1058-1061; (7) return row_id. Two callee-save pushes (rbx=session_id, r12=owner_task) plus a sub rsp,8 pad leave rsp%16==0 for every nested call. klog_s1_x2 preserves callee-saves per SysV. Refusal funnel bumps stats.refused. Effects {mem, sysreg}: mem for row + counter stores; sysreg for the klog path (serial writes). Capabilities {cap}: this is the substrate mint for a capability kind. Labels prefixed sess_m_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov r12, rdi;                        // owner_task

        // Gate 1: owner_task != 0
        cmp r12, 0;
        je  sess_m_bad_owner;

        // Gate 2: low-first scan over 16 rows for in_use == 0
        xor rcx, rcx;                        // idx = 0
      sess_m_scan:
        mov r10, [rip + SESSION_ROW_MAX];
        cmp rcx, r10;
        jae sess_m_enospc;

        lea r10, [rip + _sessions];
        mov r11, rcx;
        shl r11, 6;                          // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_m_claim;

        add rcx, 1;
        jmp sess_m_scan;

      sess_m_claim:
        // rcx = free slot idx; r10 = row base pointer.
        mov rbx, rcx;                        // save session_id in callee-save

        // (3) LAM: hdr = ((old_gen + 1) & 0x00FFFFFFFFFFFFFF) | (1<<56)
        mov r11, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;                         // r11 = old low-56 gen
        add r11, 1;
        and r11, r9;                         // clip to 56 bits
        mov r8, 1;
        shl r8, 56;                          // r8 = 1<<56 (in_use marker)
        or  r11, r8;
        mov [r10 + 0], r11;                  // write new hdr

        // (4a) session_id (== row_id, mirrored at +8 for legibility)
        mov [r10 + 8], rbx;

        // (4b) owner_task
        mov [r10 + 16], r12;

        // (4c) state = SESSION_STATE_LOGIN (= 1)
        mov rax, 1;
        mov [r10 + 24], rax;

        // (4d) seat_slot_bitmap = 0
        xor rax, rax;
        mov [r10 + 32], rax;

        // (4e) reserved words = 0
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        // (5) stats.mints++
        call session_stats_bump_mints;

        // (6) klog_s1_x2(LEVEL_INFO=3, SUBSYS_CAP_, session_mint_ok_msg,
        //                session_k_sid, sid=rbx (session_id),
        //                session_k_own, own=r12 (owner_task))
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + session_mint_ok_msg];
        lea rcx, [rip + session_k_sid];
        mov r8, rbx;                         // v1 = session_id
        lea r9, [rip + session_k_own];
        sub rsp, 8;
        push r12;                            // v2 = owner_task
        call klog_s1_x2;
        add rsp, 16;

        mov rax, rbx;                        // return session_id (row_id)
        jmp sess_m_out;

      sess_m_bad_owner:
        mov rax, 0xFFFFE27E;
        jmp sess_m_refused;
      sess_m_enospc:
        mov rax, 0xFFFFE27F;

      sess_m_refused:
        // Shared refusal funnel: bump stats.refused, preserving the
        // sentinel across the call (bumper clobbers rax as scratch).
        push rax;
        call session_stats_bump_refused;
        pop rax;

      sess_m_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11 -- session_destroy(session_id) -> 0 | error
  // ==========================================================================
  //
  // Bumps generation (so a stale handle to the same slot is invalidated)
  // and clears the in_use marker byte.  Row payload is left intact
  // (a chaos-restart witness reading the tombstone sees the pre-destroy
  // owner + state + seats -- useful for post-mortem).  No fingerprint
  // emit per issue #2402's contract.
  //
  // Register plan: r12=session_id (survives the bumper call).  One
  // callee-save push = 8 bytes; entry rsp%16==8 -> (8+8)%16 = 0 for
  // the nested bumper call.

  pub let session_destroy : (u64) -> u64 !{mem} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M5-022 (#2402): destroy KIND_SESSION row. session_id >= SESSION_ROW_MAX(16) -> SESSION_BAD_SLOT; row not in_use -> SESSION_DESTROY_ALREADY; else bump generation + clear in_use byte + stats.destroys++. No fingerprint (per issue #2402's contract; only mint emits). One callee-save push (r12) aligns rsp to 16 for the nested bumper call. Refusal funnel bumps stats.refused. Labels prefixed sess_d_.",
      block: {
        push r12;

        mov r12, rdi;                        // session_id

        mov r10, [rip + SESSION_ROW_MAX];
        cmp r12, r10;
        jae sess_d_bad_slot;

        lea r10, [rip + _sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_d_already;

        // Bump generation and clear in_use in one write.
        mov r11, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        add r11, 1;
        and r11, r9;
        mov [r10 + 0], r11;                  // in_use now 0; gen bumped

        call session_stats_bump_destroys;

        xor rax, rax;                        // SESSION_OK
        jmp sess_d_out;

      sess_d_bad_slot:
        mov rax, 0xFFFFE27C;
        jmp sess_d_refused;
      sess_d_already:
        mov rax, 0xFFFFE27B;

      sess_d_refused:
        push rax;
        call session_stats_bump_refused;
        pop rax;

      sess_d_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12 -- session_attach_seat(session_id, seat_slot) -> 0 | error
  // ==========================================================================
  //
  // Sets bit `seat_slot` in the row's seat_slot_bitmap at +32.
  //
  // Gate order:
  //   (1) session_id < SESSION_ROW_MAX && row in_use  -> else SESSION_BAD_SLOT
  //   (2) seat_slot  < SESSION_SEAT_SLOT_MAX(64)      -> else SESSION_ATTACH_BAD_SEAT
  //   (3) bitmap bit not already set                  -> else SESSION_ATTACH_ALREADY
  //   (4) or-in mask (1 << seat_slot); write back
  //   (5) bump stats.attach_seat
  //
  // Register plan: r12=session_id, r13=seat_slot (survive the bumper
  // call).  Two callee-save pushes = 16 bytes; entry rsp%16==8 ->
  // (8+16)%16 = 8.  sub rsp,8 pad -> rsp%16==0 for nested call.
  // add rsp,8 undoes pad at exit.

  pub let session_attach_seat : (u64, u64) -> u64 !{mem} @{cap} =
    fn (session_id: u64) (seat_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M5-022 (#2402): set bit `seat_slot` in the row's seat_slot_bitmap. Gate order: (1) session_id valid + in_use else BAD_SLOT; (2) seat_slot < 64 else ATTACH_BAD_SEAT (bitmap-width gate; SEAT_MAX=8 leaves 56 bits of headroom for growth); (3) bit not already set else ATTACH_ALREADY; (4) or-in (1<<seat_slot) and write back; (5) stats.attach_seat++. Mask compute uses `mov rcx, seat_slot; mov rax, 1; shl rax, cl` -- rcx holds the shift count in cl. Two callee-save pushes + sub rsp,8 align rsp for the bumper call. Refusal funnel bumps stats.refused. Labels prefixed sess_a_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // session_id
        mov r13, rsi;                        // seat_slot

        // Gate 1: session_id < SESSION_ROW_MAX
        mov r10, [rip + SESSION_ROW_MAX];
        cmp r12, r10;
        jae sess_a_bad_slot;

        // Row base + in_use check
        lea r10, [rip + _sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_a_bad_slot;

        // Gate 2: seat_slot < SESSION_SEAT_SLOT_MAX (= 64)
        mov r11, [rip + SESSION_SEAT_SLOT_MAX];
        cmp r13, r11;
        jae sess_a_bad_seat;

        // Compute mask = 1 << seat_slot
        //   rcx must hold shift count in cl for `shl reg, cl`.
        mov rcx, r13;
        mov rax, 1;
        shl rax, cl;                         // rax = mask

        // Gate 3: bit not already set
        mov r11, [r10 + 32];                 // r11 = current bitmap
        mov r8, r11;
        and r8, rax;                         // r8 = current & mask
        cmp r8, 0;
        jne sess_a_already;

        // (4) or-in and write back
        or  r11, rax;
        mov [r10 + 32], r11;

        // (5) stats.attach_seat++
        call session_stats_bump_attach;

        xor rax, rax;                        // SESSION_OK
        jmp sess_a_out;

      sess_a_bad_slot:
        mov rax, 0xFFFFE27C;
        jmp sess_a_refused;
      sess_a_bad_seat:
        mov rax, 0xFFFFE27A;
        jmp sess_a_refused;
      sess_a_already:
        mov rax, 0xFFFFE279;

      sess_a_refused:
        push rax;
        call session_stats_bump_refused;
        pop rax;

      sess_a_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 13 -- session_set_state(session_id, new_state) -> 0 | error
  // ==========================================================================
  //
  // Writes state at row+24.
  //
  // Gate order:
  //   (1) session_id < SESSION_ROW_MAX && row in_use  -> else SESSION_BAD_SLOT
  //   (2) new_state in [LOGIN(1), EXITED(4)]          -> else SESSION_STATE_BAD
  //          (0 is illegal -- that is the pre-mint zero-init value)
  //   (3) current state != EXITED                     -> else SESSION_STATE_TERMINAL
  //          (EXITED is a one-way terminal; only destroy leaves it)
  //   (4) write new_state to row+24
  //   (5) bump stats.set_state
  //
  // No fingerprint (per issue #2402's contract).
  //
  // Register plan: r12=session_id, r13=new_state.  Two callee-save
  // pushes + sub rsp,8 align rsp for the bumper call, identical shape
  // to session_attach_seat.

  pub let session_set_state : (u64, u64) -> u64 !{mem} @{cap} =
    fn (session_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M5-022 (#2402): transition state at row+24. Gate order: (1) session_id valid + in_use else BAD_SLOT; (2) new_state in [LOGIN(1), EXITED(4)] else STATE_BAD (0 is the pre-mint zero-init value and not a legal caller-supplied state); (3) current != EXITED else STATE_TERMINAL (EXITED is one-way, only destroy leaves it); (4) write; (5) stats.set_state++. NB: this landing does NOT enforce a directed state graph (LOGIN->ACTIVE->LOCKED cycle); a follow-on session-manager landing may layer that policy on top. The one hard invariant is the EXITED terminal, which is checked here so a subsequent set-state on an exited session cannot silently revive it. Two callee-save pushes + sub rsp,8 align rsp for the bumper call. Refusal funnel bumps stats.refused. Labels prefixed sess_s_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // session_id
        mov r13, rsi;                        // new_state

        // Gate 1: session_id < SESSION_ROW_MAX
        mov r10, [rip + SESSION_ROW_MAX];
        cmp r12, r10;
        jae sess_s_bad_slot;

        // Row base + in_use check
        lea r10, [rip + _sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sess_s_bad_slot;

        // Gate 2a: new_state != 0 (0 is pre-mint sentinel, not legal)
        cmp r13, 0;
        je  sess_s_bad_state;

        // Gate 2b: new_state <= SESSION_STATE_MAX (= 4)
        mov r11, [rip + SESSION_STATE_MAX];
        cmp r13, r11;
        ja  sess_s_bad_state;

        // Gate 3: current state != EXITED
        mov rax, [r10 + 24];
        mov r11, [rip + SESSION_STATE_EXITED];
        cmp rax, r11;
        je  sess_s_terminal;

        // (4) write new_state
        mov [r10 + 24], r13;

        // (5) stats.set_state++
        call session_stats_bump_set_state;

        xor rax, rax;                        // SESSION_OK
        jmp sess_s_out;

      sess_s_bad_slot:
        mov rax, 0xFFFFE27C;
        jmp sess_s_refused;
      sess_s_bad_state:
        mov rax, 0xFFFFE278;
        jmp sess_s_refused;
      sess_s_terminal:
        mov rax, 0xFFFFE277;

      sess_s_refused:
        push rax;
        call session_stats_bump_refused;
        pop rax;

      sess_s_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }
}
