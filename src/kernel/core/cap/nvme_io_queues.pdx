// src/kernel/core/cap/nvme_io_queues.pdx -- R51.M3-001 (#1645).
//
// Per-controller / per-CPU NVMe I/O queue-pair substrate.  This file is
// NOT a KIND cap: it carries no KIND tag of its own.  I/O pairs are
// shared infrastructure consulted by KIND_NVME_CONTROLLER (0x198, which
// owns the admin queue and triggers bring-up) and by the KIND_BLKDEV /
// KIND_NVME_NAMESPACE dispatch route (which submits READ/WRITE).  See
// design/hardware/nvme-io-queues.md §1 for the file-split rationale.
//
// R51.M3-001 (#1645, landed) lands the skeleton: the per-controller/
// per-CPU pair table, its row accessors, and the MSI-X vector batch
// allocator/revoker (§3.1, §4).
//
// R51.M3-002 (#1646, landed) lands CREATE_IO_CQ + CREATE_IO_SQ:
// nvme_io_create_pair (one (ctrl_row_id, cpu_idx) pair) and
// nvme_io_bring_up_all (loop over cpu_idx, all-or-nothing rollback),
// plus the NVMEC_OP_BRING_UP_IO wiring on kind_nvme_controller.pdx's
// dispatch handler (design §3.2, §3.6).
//
// R51.M3-003 (this commit, #1647) lands nvme_io_submit_rw (design §3.3)
// -- one entry point for BOTH BDEV_OP_READ_LBA and BDEV_OP_WRITE_LBA,
// distinguished by the opcode arg -- plus its two decomposed helpers
// (nvme_iox_sqe_submit: SQE build + PRP encode + doorbell ring;
// nvme_iod_completion_drain: phase-tag poll + CQ doorbell) and the new
// cap/cap_handler_blkdev.pdx dispatcher that calls into it.
// nvme_io_pick_pair (round-robin fallback) is #1649's file-scope, not
// this commit's -- nvme_io_submit_rw calls it by name on the
// assumption a sibling commit lands it; see the file-header gap note
// below.  R51.M3-005/006 (#1649/#1650) still land after this commit.
//
// Design-doc gaps resolved in this commit (see justification blocks
// below for the in-context rationale):
//   - §3.6 speced NVMEC_OP_BRING_UP_IO = 7, colliding with the already-
//     landed NVMEC_OP_DEBUG_PRINT = 7 (R51.M1). Assigned op value 8.
//   - §3.6 sketches nvme_io_bring_up_all(ctrl_row) calling
//     nvme_io_msix_alloc_for_ctrl internally, but that allocator needs
//     hw_int_parent_slot + slot_base, which the arity-one controller-op
//     ABI (rights, target_ptr, op_arg) cannot carry alongside ncpu.
//     nvme_io_bring_up_all(ctrl_row_id, ncpu) therefore assumes MSI-X
//     vectors were already minted (nvme_io_msix_alloc_for_ctrl ran
//     separately, e.g. by the supervisor at driver-attach) -- every
//     targeted pair row must already be in state MSIX.
//   - §2.1's doorbells field packing ("sq_tdbl_off[31:0] |
//     cq_hdbl_off[31:16] | dstrd[7:0]") overlaps all three sub-fields
//     in bits 0-31. nvme_io_create_pair instead packs bits[15:0] =
//     sq_tdbl_off, bits[31:16] = cq_hdbl_off, bits[39:32] = dstrd
//     (non-overlapping; sufficient for every realistic DSTRD per
//     doorbell.pdx's own commodity-hardware assumption). No consumer
//     reads this field yet -- doorbell.pdx's nvme_ring_sq/nvme_ring_cq
//     (the submit path, #1647) re-derive DSTRD from BAR0.CAP
//     statelessly and don't need it.
//   - §5 commit 3 speced landing a "fast-path only" nvme_io_pick_pair
//     alongside submit_rw, with the round-robin fallback deferred to
//     commit 5 (#1649).  The R51.M3-003 issue text this commit
//     implements instead reserves ALL of nvme_io_pick_pair for a
//     sibling #1649 agent running concurrently on this same file.
//     nvme_io_submit_rw therefore calls nvme_io_pick_pair(ctrl_row_id)
//     by name without defining it here; the two commits are expected
//     to land independently and merge (via git pull --rebase) before
//     either build is exercised together.
//   - §3.3's SQE-builder decomposition ("two 6-push helpers") is named
//     nvme_iox_sqe_submit here (not nvme_ios_*, which is reserved for
//     nvme_io_submit_rw's own labels per §7.1's prefix table) to avoid
//     a label collision between the outer function and its helper.
//   - §3.3 step 3's "NVMEIO_SUBMIT_CQE_ERR with a distinguishing status
//     of 0xE001 / 0xE002" and the preamble's "bad opcode returns
//     NVMEIO_SUBMIT_CQE_ERR with bytes=0xEEEE" are implemented as
//     nvme_io_submit_rw literally returning 0xE001 / 0xE002 / 0xEEEE
//     (not the NVMEIO_SUBMIT_CQE_ERR constant) for those three specific
//     validation failures, matching the literal "bytes = <value>"
//     phrasing; a real non-zero CQE completion status instead returns
//     the fixed NVMEIO_SUBMIT_CQE_ERR (0xFFFFEC57) sentinel rather than
//     passing the raw controller status through (the design's "bytes =
//     status_field" note is honored one level up: cap_handler_blkdev
//     writes nvme_io_submit_rw's raw return into the descriptor page's
//     status_out field regardless of which of these paths fired).
//   - §4.4's msix_tail_valid revalidation-on-every-submit (guarding the
//     "MSI-X vector revoked but pair still SQ_LIVE" race) is NOT
//     implemented in this commit -- out of #1647's assigned scope.
//     The state re-check against NVME_IOP_STATE_SQ_LIVE (step 2) still
//     runs; only the deeper msix_row_id liveness cross-check is
//     deferred (no issue currently tracks it -- flagged here for
//     R51.M4 triage).
//
// =============================================================================
// SECTION 1  PAIR-TABLE TAIL ENCODING (design/hardware/nvme-io-queues.md §2.1)
// =============================================================================
//
// Indexed directly (no tail-alloc scan -- there is no mint/derivation
// gate on this table; capacity is fixed and the index is computable
// from (ctrl_row_id, cpu_idx)):
//
//   _nvme_io_pair_table[ctrl_row_id * NVME_IO_MAX_CPUS + cpu_idx]
//
// Row layout (64 bytes, eight u64 words):
//
//   [+0]   header:    in_use[63:56] | state[15:8] | qid[7:0]
//   [+8]   sq_pa                 (u64)   physical addr of SQ page
//   [+16]  cq_pa                 (u64)   physical addr of CQ page
//   [+24]  doorbells             (u64)   sq_tdbl_off[31:0] | cq_hdbl_off[31:16] | dstrd[7:0]
//   [+32]  cursors               (u64)   sq_tail[47:32] | cq_head[31:16] | cq_phase[7:0]
//   [+40]  msix_row_id           (u64)   row_id in _hw_msix_vector_table
//   [+48]  owning_cpu            (u64)   cpu_idx, or 0xFF if unbound
//   [+56]  reserved              (u64)
//
// State byte values (header bits [15:8]):
//   NVME_IOP_STATE_FREE      = 0   slot never used or teardown complete
//   NVME_IOP_STATE_MSIX      = 1   MSI-X vector minted, no CQ yet
//   NVME_IOP_STATE_CQ_LIVE   = 2   CREATE_IO_CQ acked           (#1646)
//   NVME_IOP_STATE_SQ_LIVE   = 3   CREATE_IO_SQ acked; usable   (#1646)
//   NVME_IOP_STATE_QUIESCED  = 4   reserved, R51.M4 queue-reset path
//
// qid (bits [7:0]) = cpu_idx + 1 (admin queue is qid=0 by convention).
//
// Capacity: NVMEC_MAX (8, kind_nvme_controller.pdx) * NVME_IO_MAX_CPUS
// (8) * 64 B = 4 KiB -- one .bss page, zero-init preserving the
// in_use=0 / state=FREE invariant across boots.  This commit does NOT
// wire a build.sh one-writer confinement check for this table; the
// sole writers are nvme_io_msix_alloc_for_ctrl, nvme_io_msix_revoke_for_ctrl,
// and nvme_iop_pair_table_reset below.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY  0xFFFFEC50..0xFFFFEC5F
// =============================================================================
//
// One band past KIND_NVME_CONTROLLER's 0xFFFFEC40..0xFFFFEC4F.  This
// commit's functions return only NVMEIO_MSIX_ENOSPC / NVMEIO_MSIX_EPARENT;
// the remaining codes are declared here (whole-module taxonomy, per the
// kind_nvme_controller.pdx precedent of declaring the full band up
// front) for #1646-#1650 to consume without a second failure-code file.
//
// =============================================================================
// SECTION 3  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: sized loads via xor <reg>,<reg>; mov_b <reg>,[mem] for
//       sub-8-byte fields (zero-extension is NOT automatic on mov_b --
//       the destination must be cleared first).  No mov_b store is
//       needed in this commit: the header word is packed in a GPR and
//       committed with one 8-byte mov.
//   G4: full-register compares (values are zero-extended via the mov_b
//       idiom above before any cmp).
//
// r10/r11 used freely as scratch.  All constants in this file fit
// imm32 (KIND-adjacent state/error values < 0x100000000); the two
// full-imm64 sentinels (NVMEIO_DECODE_BAD, all-ones) are loaded via a
// plain `mov reg, imm64` -- that opcode form (unlike cmp/and/add)
// accepts a full 64-bit immediate, matching NVMEC_DECODE_BAD's
// existing use in kind_nvme_controller.pdx.
//
// Labels prefixed per function (reserved-label discipline, `loop`/`if`
// etc. are keywords):
//   nvme_iopa_  -> nvme_iop_row_addr
//   nvme_iops_  -> nvme_iop_row_state
//   nvme_iomr_  -> nvme_iop_row_msix_row_id
//   nvme_ioq_   -> nvme_iop_row_qid
//   nvme_iotr_  -> nvme_iop_pair_table_reset
//   nvme_iom_   -> nvme_io_msix_alloc_for_ctrl
//   nvme_iov_   -> nvme_io_msix_revoke_for_ctrl
//   nvme_ioc_   -> nvme_io_create_pair       (#1646)
//   nvme_iob_   -> nvme_io_bring_up_all      (#1646)
//   nvme_ios_   -> nvme_io_submit_rw         (#1647)
//   nvme_iox_   -> nvme_iox_sqe_submit       (#1647, submit_rw's SQE-build helper)
//   nvme_iod_   -> nvme_io_completion_drain  (#1647)

module NvmeIoQueues = structure {

  pub let NVME_IO_MAX_CPUS      : u64 = 8
  pub let NVME_IO_PAIR_ROW_BYTES: u64 = 64
  pub let NVME_IO_PAIR_ROWS     : u64 = 64     // NVMEC_MAX (8) * NVME_IO_MAX_CPUS (8)
  pub let NVME_IO_PAIR_WORDS    : u64 = 512    // NVME_IO_PAIR_ROWS * 8 u64-words/row

  pub let NVME_IOP_STATE_FREE     : u64 = 0
  pub let NVME_IOP_STATE_MSIX     : u64 = 1
  pub let NVME_IOP_STATE_CQ_LIVE  : u64 = 2
  pub let NVME_IOP_STATE_SQ_LIVE  : u64 = 3
  pub let NVME_IOP_STATE_QUIESCED : u64 = 4

  pub let NVMEIO_OK             : u64 = 0
  pub let NVMEIO_MSIX_ENOSPC    : u64 = 0xFFFFEC50
  pub let NVMEIO_MSIX_EPARENT   : u64 = 0xFFFFEC51
  pub let NVMEIO_CQ_FAILED      : u64 = 0xFFFFEC52
  pub let NVMEIO_SQ_FAILED      : u64 = 0xFFFFEC53
  pub let NVMEIO_STATE_BAD      : u64 = 0xFFFFEC54
  pub let NVMEIO_SUBMIT_ENOROOM : u64 = 0xFFFFEC55
  pub let NVMEIO_SUBMIT_TIMEOUT : u64 = 0xFFFFEC56
  pub let NVMEIO_SUBMIT_CQE_ERR : u64 = 0xFFFFEC57
  pub let NVMEIO_PICK_NONE      : u64 = 0xFFFFEC58
  pub let NVMEIO_BAD_ARG        : u64 = 0xFFFFEC59
  pub let NVMEIO_BAD_OP         : u64 = 0xFFFFEC5A

  pub let NVMEIO_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _nvme_io_pair_table : [u64; 512] = uninit @align(64)

  // ==========================================================================
  // nvme_iop_row_addr(ctrl_row_id, cpu_idx) -> u64
  //
  // Address of the pair row, or NVMEIO_DECODE_BAD if either index is
  // out of range.  ctrl_row_id < 8 (NVMEC_MAX); cpu_idx < 8
  // (NVME_IO_MAX_CPUS).  Row index = ctrl_row_id * 8 + cpu_idx; row
  // address = &_nvme_io_pair_table + index * 64.
  // ==========================================================================
  pub let nvme_iop_row_addr : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_row_id: u64) (cpu_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M3-001 (#1645): compute the pair-table row address for (ctrl_row_id, cpu_idx). Bounds-check both indices against 8 (NVMEC_MAX, NVME_IO_MAX_CPUS) before any arithmetic. Index = ctrl_row_id*8 + cpu_idx; address = &_nvme_io_pair_table + index*64 (shl 3 then shl 6, matching the shl-3/shl-6 idiom used throughout kind_nvme_controller.pdx / kind_nvme_namespace.pdx for row addressing). Pure; no writes. Labels prefixed nvme_iopa_.",
      block: {
        cmp rdi, 8;                       // NVMEC_MAX
        jae nvme_iopa_bad;
        cmp rsi, 8;                       // NVME_IO_MAX_CPUS
        jae nvme_iopa_bad;

        mov r10, rdi;
        shl r10, 3;                       // ctrl_row_id * 8
        add r10, rsi;                     // + cpu_idx
        shl r10, 6;                       // * 64 (row bytes)
        lea rax, [rip + _nvme_io_pair_table];
        add rax, r10;
        ret;

      nvme_iopa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // nvme_iop_row_state(ctrl_row_id, cpu_idx) -> u64
  //
  // State byte (header bits [15:8]), or NVMEIO_DECODE_BAD.
  // ==========================================================================
  pub let nvme_iop_row_state : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_row_id: u64) (cpu_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M3-001 (#1645): read the state byte (header [15:8], i.e. byte offset +1) out of the pair row for (ctrl_row_id, cpu_idx). Zero-push leaf that pads the stack (sub rsp,8) before the nested nvme_iop_row_addr call to satisfy SysV 16-byte alignment (entry rsp%16==8, 0 pushes -> 8, pad restores 0), then restores it (add rsp,8) before reading the byte. G1 workaround: xor rax,rax then mov_b rax,[addr+1] to zero-extend explicitly -- mov_b does not zero-extend on its own. Labels prefixed nvme_iops_.",
      block: {
        sub rsp, 8;
        call nvme_iop_row_addr;
        add rsp, 8;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_iops_bad;

        mov r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 1];             // state byte, zero-extended
        ret;

      nvme_iops_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // nvme_iop_row_qid(ctrl_row_id, cpu_idx) -> u64
  //
  // qid byte (header bits [7:0], i.e. byte offset +0), or NVMEIO_DECODE_BAD.
  // ==========================================================================
  pub let nvme_iop_row_qid : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_row_id: u64) (cpu_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M3-001 (#1645): read the qid byte (header [7:0], byte offset +0) out of the pair row. Same zero-push + pad shape as nvme_iop_row_state; same G1 zero-extension idiom. Labels prefixed nvme_ioq_.",
      block: {
        sub rsp, 8;
        call nvme_iop_row_addr;
        add rsp, 8;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ioq_bad;

        mov r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 0];             // qid byte, zero-extended
        ret;

      nvme_ioq_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // nvme_iop_row_msix_row_id(ctrl_row_id, cpu_idx) -> u64
  //
  // msix_row_id field (+40, full u64), or NVMEIO_DECODE_BAD.
  // ==========================================================================
  pub let nvme_iop_row_msix_row_id : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_row_id: u64) (cpu_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M3-001 (#1645): read the msix_row_id field (+40, full 8-byte word -- no G1 sizing needed) out of the pair row. Same zero-push + pad shape as the sibling accessors. Labels prefixed nvme_iomr_.",
      block: {
        sub rsp, 8;
        call nvme_iop_row_addr;
        add rsp, 8;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_iomr_bad;

        mov rax, [rax + 40];
        ret;

      nvme_iomr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // nvme_iop_pair_table_reset() -> ()
  //
  // Clear every row of _nvme_io_pair_table.  Boot and teardown only.
  // Mirrors nvme_ctrl_table_reset (kind_nvme_controller.pdx).
  // ==========================================================================
  pub let nvme_iop_pair_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M3-001 (#1645): zero all 512 u64 words (64 rows * 8 words/row = 4 KiB) of _nvme_io_pair_table. Leaf, no nested call, no alignment concern. Labels prefixed nvme_iotr_.",
      block: {
        lea r10, [rip + _nvme_io_pair_table];
        xor rax, rax;
        xor rcx, rcx;
      nvme_iotr_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;                     // NVME_IO_PAIR_WORDS
        jb  nvme_iotr_loop;
        ret
      }
    }

  // ==========================================================================
  // nvme_io_msix_alloc_for_ctrl(ctrl_row_id, hw_int_parent_slot,
  //                              slot_base, ncpu) -> u64
  //
  // design/hardware/nvme-io-queues.md §3.1, §4.  For cpu_idx in
  // 0..min(ncpu, NVME_IO_MAX_CPUS): mint a KIND_HW_MSIX_VECTOR at
  // cap_table[slot_base + cpu_idx] via msix_cap_mint, table_offset =
  // cpu_idx*16, msix_data = cpu_idx.  On success, stamp the pair row's
  // msix_row_id (+40) from the freshly-minted descriptor's target_ptr
  // low 16 bits, pack the header (qid = cpu_idx+1, state = MSIX,
  // in_use = 1). On any mint failure, roll back every prior mint
  // (msix_cap_revoke + pair row reset to FREE) and return
  // NVMEIO_MSIX_EPARENT (mint's parent-gate refusal, MSIX_MINT_BAD_PARENT
  // = 0xFFFFFFED) or NVMEIO_MSIX_ENOSPC (every other mint failure:
  // MSIX_MINT_BAD_RIGHTS/ENOSPC/BAD_ARG -- the two NVMEIO_MSIX_* codes
  // this commit defines do not have a one-to-one slot for all four
  // underlying causes, so the non-parent causes collapse to ENOSPC,
  // the "cannot proceed" catch-all).
  // ==========================================================================
  pub let nvme_io_msix_alloc_for_ctrl : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) (hw_int_parent_slot: u64) (slot_base: u64) (ncpu: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M3-001 (#1645): batch MSI-X vector allocator, one KIND_HW_MSIX_VECTOR per CPU. Five-push callee-save prologue (rbx=ctrl_row_id, r12=cpu_idx, r13=ncpu clamped to NVME_IO_MAX_CPUS, r14=slot_base, r15=hw_int_parent_slot) = 40 B; entry rsp%16==8 -> 48, %16==0 -- matches design doc §3.1's stated register plan and leaves rsp%16==0 at the msix_cap_mint call site with zero padding. Per iteration: pack msix_cap_mint's 5 args (slot=slot_base+cpu_idx, parent_slot, rights=R_MSIX_ALL=0x218, table_offset=cpu_idx*16, msix_data=cpu_idx), call it. Non-zero return -> classify (BAD_PARENT=0xFFFFFFED -> NVMEIO_MSIX_EPARENT; anything else -> NVMEIO_MSIX_ENOSPC), then roll back every already-minted vector in [0, cpu_idx) via msix_cap_revoke + reset that pair row to FREE, and return the classified code. Zero return -> re-read cap_table[slot].target_ptr (24-byte descriptor stride: slot*8 + slot*16) low 16 bits for the freshly-allocated row_id, stamp pair row +40 (msix_row_id) and +0 (header = in_use<<56 | MSIX<<8 | qid, qid=cpu_idx+1), advance cpu_idx. All registers rax/r9/r10/r11/rdi/rsi/rdx/rcx/r8 are caller-save scratch across the calls; msix_cap_mint/msix_cap_revoke preserve rbx/r12-r15 per SysV so the loop state survives. Returns 0 (NVMEIO_OK) once every cpu_idx in range is minted.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                         // 5 pushes -> rsp%16 == 0

        mov rbx, rdi;                      // ctrl_row_id
        mov r15, rsi;                      // hw_int_parent_slot
        mov r14, rdx;                      // slot_base
        mov r13, rcx;                      // ncpu (to be clamped)

        mov r10, 8;                        // NVME_IO_MAX_CPUS
        cmp r13, r10;
        jbe nvme_iom_ncpu_ok;
        mov r13, r10;
      nvme_iom_ncpu_ok:

        xor r12, r12;                      // cpu_idx = 0

      nvme_iom_loop:
        cmp r12, r13;
        jae nvme_iom_done;

        mov rdi, r14;
        add rdi, r12;                      // slot = slot_base + cpu_idx
        mov rsi, r15;                      // parent_slot
        mov rdx, 0x218;                    // R_MSIX_ALL
        mov rcx, r12;
        shl rcx, 4;                        // table_offset = cpu_idx * 16
        mov r8, r12;                       // msix_data = cpu_idx
        call msix_cap_mint;

        cmp rax, 0;
        jne nvme_iom_fail;

        // Success: re-read cap_table[slot].target_ptr[15:0] -> row_id.
        mov r9, r14;
        add r9, r12;                       // slot
        mov r10, cap_table;
        mov r11, r9;
        shl r11, 3;
        add r10, r11;
        mov r11, r9;
        shl r11, 4;
        add r10, r11;                      // r10 = &cap_table[slot]
        mov r9, [r10 + 16];                // target_ptr
        and r9, 0xFFFF;                    // row_id

        // pair_row = &_nvme_io_pair_table + (ctrl_row_id*8 + cpu_idx)*64
        mov r10, rbx;
        shl r10, 3;
        add r10, r12;
        shl r10, 6;
        lea r11, [rip + _nvme_io_pair_table];
        add r11, r10;

        mov [r11 + 40], r9;                // msix_row_id

        mov r10, r12;
        add r10, 1;                        // qid = cpu_idx + 1
        mov r9, 1;
        shl r9, 8;
        or  r10, r9;                       // | state(MSIX=1) << 8
        mov r9, 1;
        shl r9, 56;
        or  r10, r9;                       // | in_use = 1
        mov [r11 + 0], r10;                // header

        add r12, 1;
        jmp nvme_iom_loop;

      nvme_iom_fail:
        mov r10, 0xFFFFFFED;               // MSIX_MINT_BAD_PARENT
        cmp rax, r10;
        je  nvme_iom_err_eparent;
        mov r15, 0xFFFFEC50;               // NVMEIO_MSIX_ENOSPC
        jmp nvme_iom_rollback;
      nvme_iom_err_eparent:
        mov r15, 0xFFFFEC51;               // NVMEIO_MSIX_EPARENT

      nvme_iom_rollback:
        // r15 (hw_int_parent_slot, no longer needed) now stashes the
        // classified error code across the rollback loop below. r13
        // (ncpu, no longer needed) is reused as the rollback cursor k.
        xor r13, r13;                      // k = 0
      nvme_iom_rb_loop:
        cmp r13, r12;
        jae nvme_iom_rb_done;

        mov rdi, r14;
        add rdi, r13;                      // slot = slot_base + k
        call msix_cap_revoke;

        mov r10, rbx;
        shl r10, 3;
        add r10, r13;
        shl r10, 6;
        lea r11, [rip + _nvme_io_pair_table];
        add r11, r10;
        xor r9, r9;
        mov [r11 + 0], r9;                 // header -> FREE
        mov [r11 + 40], r9;                // msix_row_id -> 0

        add r13, 1;
        jmp nvme_iom_rb_loop;

      nvme_iom_rb_done:
        mov rax, r15;
        jmp nvme_iom_out;

      nvme_iom_done:
        xor rax, rax;                      // NVMEIO_OK

      nvme_iom_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_io_msix_revoke_for_ctrl(ctrl_row_id, slot_base, ncpu) -> u64
  //
  // Cleanup path, companion to nvme_io_msix_alloc_for_ctrl.  For
  // cpu_idx in 0..min(ncpu, NVME_IO_MAX_CPUS): revoke the
  // KIND_HW_MSIX_VECTOR cap at cap_table[slot_base + cpu_idx]
  // (msix_cap_revoke is idempotent -- MSIX_REVOKE_ALREADY on an
  // already-clear slot is not an error here) and reset that pair row
  // to FREE (header = 0, msix_row_id = 0) unconditionally.  Always
  // returns 0: revoke is a best-effort scrub, not a state machine the
  // caller needs to inspect per-CPU (design/hardware/nvme-io-queues.md
  // §5 commit 1 witness stage 14 asserts a plain 0 return).
  // ==========================================================================
  pub let nvme_io_msix_revoke_for_ctrl : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) (slot_base: u64) (ncpu: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M3-001 (#1645): revoke every MSI-X vector nvme_io_msix_alloc_for_ctrl minted for this controller and scrub the matching pair rows. Four-push callee-save prologue (rbx=ctrl_row_id, r12=cpu_idx, r13=ncpu clamped, r14=slot_base) = 32 B; entry rsp%16==8 -> 40 (%16==8), so a sub rsp,8 pad is added before the loop's msix_cap_revoke call and undone before the final ret, per the k=4 row of the SysV alignment table (design/hardware/nvme-io-queues.md §7.4). Per iteration: msix_cap_revoke(slot_base+cpu_idx) (idempotent; return value ignored -- an already-clear slot is not a fault in a cleanup path), then unconditionally zero the pair row's header (+0) and msix_row_id (+40). Always returns NVMEIO_OK (0).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;                        // 4 pushes -> rsp%16==8; pad to 0

        mov rbx, rdi;                      // ctrl_row_id
        mov r14, rsi;                      // slot_base
        mov r13, rdx;                      // ncpu (to be clamped)

        mov r10, 8;                        // NVME_IO_MAX_CPUS
        cmp r13, r10;
        jbe nvme_iov_ncpu_ok;
        mov r13, r10;
      nvme_iov_ncpu_ok:

        xor r12, r12;                      // cpu_idx = 0

      nvme_iov_loop:
        cmp r12, r13;
        jae nvme_iov_done;

        mov rdi, r14;
        add rdi, r12;                      // slot = slot_base + cpu_idx
        call msix_cap_revoke;

        mov r10, rbx;
        shl r10, 3;
        add r10, r12;
        shl r10, 6;
        lea r11, [rip + _nvme_io_pair_table];
        add r11, r10;
        xor r9, r9;
        mov [r11 + 0], r9;                 // header -> FREE
        mov [r11 + 40], r9;                // msix_row_id -> 0

        add r12, 1;
        jmp nvme_iov_loop;

      nvme_iov_done:
        xor rax, rax;                      // NVMEIO_OK

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_io_create_pair(ctrl_row_id, cpu_idx) -> u64
  //
  // design/hardware/nvme-io-queues.md §3.2. Requires the pair row already
  // in state MSIX (nvme_io_msix_alloc_for_ctrl must have run for this
  // (ctrl_row_id, cpu_idx) first) -- else NVMEIO_STATE_BAD. Issues the R24
  // admin Create-IO-CQ then Create-IO-SQ commands (drivers/nvme/io_queue.pdx
  // nvme_create_io_cq / nvme_create_io_sq) against the backing pages that
  // R24 module already reserves (_nvme_io_cq_buffers / _nvme_io_sq_buffers,
  // one 4 KiB page per cpu_idx), zeroing each page first. On CQ failure, no
  // state change (nothing was written yet) -> NVMEIO_CQ_FAILED. On SQ
  // failure, the just-created CQ is torn down via nvme_delete_io_cq and the
  // row state reverts to MSIX -> NVMEIO_SQ_FAILED. On full success the row
  // reaches SQ_LIVE and the function returns NVMEIO_OK (0).
  // ==========================================================================
  pub let nvme_io_create_pair : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) (cpu_idx: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M3-002 (#1646): CREATE_IO_CQ + CREATE_IO_SQ for one (ctrl_row_id, cpu_idx) pair. Six-push callee-save prologue (rbx=ctrl_row_id, rbp=cpu_idx, r12=pair_row_addr, r13=bar0, r14=admin_ctx, r15=vector) = 48 B; entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0 -- matches design doc §3.2's stated register plan exactly, so every nested call in this body executes at rsp%16==0. vector = cpu_idx per §3.1's table_offset=cpu_idx*16 / msix_data=cpu_idx convention (the device-side MSI-X vector index equals the table entry index, which equals cpu_idx -- no KIND_HW_MSIX_VECTOR row re-read needed). Bounds-check both indices against 8 (NVMEC_MAX, NVME_IO_MAX_CPUS), then require the pair row's state byte (+1) == NVME_IOP_STATE_MSIX (G1: xor+mov_b zero-extension before the compare); any failure here, or a DECODE_BAD (0xFFFFFFFFFFFFFFFF) bar0/admin_ctx read from the controller row, returns NVMEIO_STATE_BAD. Zero the CQ page (512 u64 stores in a plain loop -- no nested call mid-loop, so no alignment concern), build CDW11=(vector<<16)|3 (IEN=1,PC=1), call nvme_create_io_cq(bar0, admin_ctx, qid=cpu_idx+1, cq_pa, size=64, cdw11); non-zero status -> NVMEIO_CQ_FAILED with no state change (nothing was written to the row yet). On success, stamp cq_pa (+16); read CAP.DSTRD from bar0 (nvme_reg_u64(bar0,0), bits [35:32]) and pack the doorbell-offset cache (+24) as bits[15:0]=sq_tdbl_off, bits[31:16]=cq_hdbl_off, bits[39:32]=dstrd (see file-header note on the corrected, non-overlapping layout), using the identical (2+dstrd)-shift formula drivers/nvme/doorbell.pdx's nvme_ring_sq/nvme_ring_cq already use; stamp initial cursors (+32, cq_phase=1/cq_head=0/sq_tail=0 == literal 1); advance header state -> CQ_LIVE (mask bits[15:8] to 0 then OR in 2<<8, preserving in_use/qid). Then zero the SQ page, build CDW11=(qid<<16)|1 (cqid=qid matched pair per R24 convention, qprio=0, PC=1), call nvme_create_io_sq(bar0, admin_ctx, qid, sq_pa, size=64, cdw11); non-zero status -> roll back via nvme_delete_io_cq(bar0, admin_ctx, qid) (return ignored, best-effort teardown), revert the row's header state back to MSIX and clear cq_pa/doorbells/cursors (msix_row_id/qid/in_use untouched), return NVMEIO_SQ_FAILED. On success, stamp sq_pa (+8), advance state -> SQ_LIVE, return NVMEIO_OK (0). All mov_b uses are base+immediate-displacement (not base+index), so G1's `[reg+reg]` restriction does not apply.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                        // 6 pushes -> rsp%16==8; pad to 0

        mov rbx, rdi;                      // ctrl_row_id
        mov rbp, rsi;                      // cpu_idx

        cmp rbx, 8;                        // NVMEC_MAX
        jae nvme_ioc_bad_state;
        cmp rbp, 8;                        // NVME_IO_MAX_CPUS
        jae nvme_ioc_bad_state;

        // pair_row_addr = &_nvme_io_pair_table + (ctrl_row_id*8+cpu_idx)*64
        mov r10, rbx;
        shl r10, 3;
        add r10, rbp;
        shl r10, 6;
        lea r11, [rip + _nvme_io_pair_table];
        add r11, r10;
        mov r12, r11;                      // pair_row_addr

        xor rax, rax;
        mov_b rax, [r12 + 1];              // state byte, zero-extended
        cmp rax, 1;                        // NVME_IOP_STATE_MSIX
        jne nvme_ioc_bad_state;

        mov r15, rbp;                      // vector = cpu_idx

        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ioc_bad_state;
        mov r13, rax;                      // bar0

        mov rdi, rbx;
        call nvme_ctrl_row_admin_ctx;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ioc_bad_state;
        mov r14, rax;                      // admin_ctx

        // ---- Zero the CQ page (4 KiB = 512 u64 words). ----
        mov r10, rbp;
        shl r10, 12;
        lea r11, [rip + _nvme_io_cq_buffers];
        add r10, r11;                      // r10 = cq_pa
        xor rax, rax;
        xor rcx, rcx;
      nvme_ioc_zcq_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  nvme_ioc_zcq_loop;

        // ---- Build + submit Create-IO-CQ. ----
        mov rdi, r13;                      // bar0
        mov rsi, r14;                      // admin_ctx
        mov rdx, rbp;
        add rdx, 1;                        // qid = cpu_idx + 1
        mov rcx, r10;                      // cq_pa
        mov r8, 64;                        // size
        mov r9, r15;
        shl r9, 16;
        or  r9, 3;                         // cdw11 = (vector<<16)|IEN(1)|PC(1)
        call nvme_create_io_cq;

        cmp rax, 0;
        jne nvme_ioc_cq_failed;

        // ---- CQ live: stamp cq_pa, doorbells, cursors; state -> CQ_LIVE. ----
        mov r10, rbp;
        shl r10, 12;
        lea r11, [rip + _nvme_io_cq_buffers];
        add r10, r11;
        mov [r12 + 16], r10;               // cq_pa

        mov rdi, r13;                      // bar0
        xor rsi, rsi;                      // CAP register offset (0)
        call nvme_reg_u64;
        shr rax, 32;
        and rax, 0xF;                      // dstrd (CAP[35:32])
        mov r9, rax;

        mov rcx, r9;
        add rcx, 2;                        // shift = 2 + dstrd
        mov rax, rbp;
        add rax, 1;                        // qid
        shl rax, 1;                        // qid * 2
        shl rax, cl;                       // (qid*2) << (2+dstrd)
        add rax, 0x1000;                   // sq_tdbl_off
        mov r10, rax;
        and r10, 0xFFFF;

        mov rcx, r9;
        add rcx, 2;
        mov rax, rbp;
        add rax, 1;
        shl rax, 1;
        or  rax, 1;                        // (qid*2 + 1)
        shl rax, cl;
        add rax, 0x1000;                   // cq_hdbl_off
        and rax, 0xFFFF;
        shl rax, 16;
        or  r10, rax;

        mov rax, r9;
        and rax, 0xFF;
        shl rax, 32;
        or  r10, rax;                      // | dstrd << 32
        mov [r12 + 24], r10;               // doorbells

        mov rax, 1;                        // cq_phase=1, cq_head=0, sq_tail=0
        mov [r12 + 32], rax;               // cursors

        mov rax, [r12 + 0];
        mov r10, 0xFFFFFFFFFFFF00FF;
        and rax, r10;
        mov r10, 2;                        // NVME_IOP_STATE_CQ_LIVE
        shl r10, 8;
        or  rax, r10;
        mov [r12 + 0], rax;

        // ---- Zero the SQ page (4 KiB = 512 u64 words). ----
        mov r10, rbp;
        shl r10, 12;
        lea r11, [rip + _nvme_io_sq_buffers];
        add r10, r11;                      // r10 = sq_pa
        xor rax, rax;
        xor rcx, rcx;
      nvme_ioc_zsq_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  nvme_ioc_zsq_loop;

        // ---- Build + submit Create-IO-SQ. ----
        mov rdi, r13;                      // bar0
        mov rsi, r14;                      // admin_ctx
        mov rdx, rbp;
        add rdx, 1;                        // qid
        mov rcx, r10;                      // sq_pa
        mov r8, 64;                        // size
        mov r9, rbp;
        add r9, 1;
        shl r9, 16;
        or  r9, 1;                         // cdw11 = (cqid<<16)|PC(1), qprio=0
        call nvme_create_io_sq;

        cmp rax, 0;
        jne nvme_ioc_sq_failed;

        // ---- SQ live: stamp sq_pa; state -> SQ_LIVE. ----
        mov r10, rbp;
        shl r10, 12;
        lea r11, [rip + _nvme_io_sq_buffers];
        add r10, r11;
        mov [r12 + 8], r10;                // sq_pa

        mov rax, [r12 + 0];
        mov r10, 0xFFFFFFFFFFFF00FF;
        and rax, r10;
        mov r10, 3;                        // NVME_IOP_STATE_SQ_LIVE
        shl r10, 8;
        or  rax, r10;
        mov [r12 + 0], rax;

        xor rax, rax;                      // NVMEIO_OK
        jmp nvme_ioc_out;

      nvme_ioc_sq_failed:
        mov rdi, r13;
        mov rsi, r14;
        mov rdx, rbp;
        add rdx, 1;
        call nvme_delete_io_cq;            // best-effort, return ignored

        mov rax, [r12 + 0];
        mov r10, 0xFFFFFFFFFFFF00FF;
        and rax, r10;
        mov r10, 1;                        // NVME_IOP_STATE_MSIX
        shl r10, 8;
        or  rax, r10;
        mov [r12 + 0], rax;

        xor rax, rax;
        mov [r12 + 16], rax;               // cq_pa
        mov [r12 + 24], rax;               // doorbells
        mov [r12 + 32], rax;               // cursors

        mov rax, 0xFFFFEC53;               // NVMEIO_SQ_FAILED
        jmp nvme_ioc_out;

      nvme_ioc_cq_failed:
        mov rax, 0xFFFFEC52;               // NVMEIO_CQ_FAILED
        jmp nvme_ioc_out;

      nvme_ioc_bad_state:
        mov rax, 0xFFFFEC54;               // NVMEIO_STATE_BAD

      nvme_ioc_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_io_bring_up_all(ctrl_row_id, ncpu) -> u64
  //
  // design/hardware/nvme-io-queues.md §3.6 (op-arity resolution noted at
  // the file header). Precondition: nvme_io_msix_alloc_for_ctrl has
  // already minted MSI-X vectors for cpu_idx in [0, ncpu) on this
  // controller row (every targeted pair row must already be in state
  // MSIX). Loops cpu_idx = 0..min(ncpu, NVME_IO_MAX_CPUS), calling
  // nvme_io_create_pair for each. On the first failure, rolls back every
  // already-SQ_LIVE pair (cpu_idx in [0, failing_idx)) via
  // nvme_delete_io_sq + nvme_delete_io_cq (SQ before CQ, NVMe §5.7) and
  // resets those rows' state back to MSIX (msix_row_id / qid / in_use
  // preserved -- only the queue-create side is undone), then returns 0.
  // On full success, returns the clamped ncpu (count of pairs that
  // reached SQ_LIVE).
  // ==========================================================================
  pub let nvme_io_bring_up_all : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) (ncpu: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M3-002 (#1646): bring-up aggregate over nvme_io_create_pair. Six-push callee-save prologue (rbx=ctrl_row_id, rbp=rollback cursor k, r12=cpu_idx / failing-index marker, r13=ncpu clamped to NVME_IO_MAX_CPUS, r14=bar0, r15=admin_ctx) = 48 B; entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0 (rbp is used only during the rollback phase; its garbage value during the main loop is never read there, and rbp is callee-saved so it must still be pushed/popped even though the main loop leaves it unused). bar0/admin_ctx are read once via nvme_ctrl_row_bar0/nvme_ctrl_row_admin_ctx; a DECODE_BAD row aborts immediately returning 0 (no pairs to create without a live controller row). Main loop calls nvme_io_create_pair(ctrl_row_id, cpu_idx); a non-zero return jumps to rollback. Rollback walks k=0..cpu_idx (exclusive of the failing index -- nvme_io_create_pair already leaves the failing pair itself out of SQ_LIVE on every one of its own failure paths, so only strictly-earlier indices need unwinding): nvme_delete_io_sq then nvme_delete_io_cq (SQ-before-CQ per NVMe §5.7; return values ignored, best-effort teardown -- k is kept in the callee-saved rbp specifically so it survives these two calls without relying on any caller-saved register being incidentally untouched), then the pair row's header state is forced back to MSIX (preserving qid/in_use/msix_row_id) and sq_pa/cq_pa/doorbells/cursors are zeroed. Returns 0 after a full rollback (all-or-nothing, matching nvme_io_msix_alloc_for_ctrl's own rollback shape). Success path returns r13 (clamped ncpu) -- the count of pairs reaching SQ_LIVE.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                        // 6 pushes -> rsp%16==8; pad to 0

        mov rbx, rdi;                      // ctrl_row_id
        mov r13, rsi;                      // ncpu (to be clamped)

        mov r10, 8;                        // NVME_IO_MAX_CPUS
        cmp r13, r10;
        jbe nvme_iob_ncpu_ok;
        mov r13, r10;
      nvme_iob_ncpu_ok:

        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_iob_zero;
        mov r14, rax;                      // bar0

        mov rdi, rbx;
        call nvme_ctrl_row_admin_ctx;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_iob_zero;
        mov r15, rax;                      // admin_ctx

        xor r12, r12;                      // cpu_idx = 0

      nvme_iob_loop:
        cmp r12, r13;
        jae nvme_iob_done;

        mov rdi, rbx;
        mov rsi, r12;
        call nvme_io_create_pair;

        cmp rax, 0;
        jne nvme_iob_rollback;

        add r12, 1;
        jmp nvme_iob_loop;

      nvme_iob_rollback:
        xor rbp, rbp;                      // k = 0
      nvme_iob_rb_loop:
        cmp rbp, r12;
        jae nvme_iob_rb_done;

        mov rdi, r14;                      // bar0
        mov rsi, r15;                      // admin_ctx
        mov rdx, rbp;
        add rdx, 1;                        // qid
        call nvme_delete_io_sq;            // best-effort, return ignored

        mov rdi, r14;
        mov rsi, r15;
        mov rdx, rbp;
        add rdx, 1;
        call nvme_delete_io_cq;            // best-effort, return ignored

        // Reset pair row (ctrl_row_id=rbx, cpu_idx=rbp) back to MSIX.
        mov r10, rbx;
        shl r10, 3;
        add r10, rbp;
        shl r10, 6;
        lea r11, [rip + _nvme_io_pair_table];
        add r11, r10;

        mov rax, [r11 + 0];
        mov r10, 0xFFFFFFFFFFFF00FF;
        and rax, r10;
        mov r10, 1;                        // NVME_IOP_STATE_MSIX
        shl r10, 8;
        or  rax, r10;
        mov [r11 + 0], rax;

        xor rax, rax;
        mov [r11 + 8],  rax;               // sq_pa
        mov [r11 + 16], rax;               // cq_pa
        mov [r11 + 24], rax;               // doorbells
        mov [r11 + 32], rax;               // cursors

        add rbp, 1;
        jmp nvme_iob_rb_loop;

      nvme_iob_rb_done:
        xor rax, rax;                      // full rollback -> 0
        jmp nvme_iob_out;

      nvme_iob_done:
        mov rax, r13;                      // success -> clamped ncpu
        jmp nvme_iob_out;

      nvme_iob_zero:
        xor rax, rax;

      nvme_iob_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_iox_sqe_submit(pair_row, bar0, packed_nsid_op, lba,
  //                      packed_nb_bytelen, dma_iova) -> u64
  //
  // design/hardware/nvme-io-queues.md §3.3 steps 4-6 (SQE build, PRP
  // encode, doorbell ring).  Private helper for nvme_io_submit_rw --
  // NOT part of the public API surface (no `pub`), but paideia-as does
  // not gate visibility so it is reachable by name like everything
  // else in this module; the design doc's own §3.3 posture note calls
  // for exactly this decomposition ("two 6-push helpers").
  //
  // Packed args (arity-6 ceiling forces two u64s to each carry a pair
  // of logical fields):
  //   packed_nsid_op    = nsid[31:0] | (opcode[7:0] << 32)
  //   packed_nb_bytelen = nblocks[15:0] | (byte_len[47:0] << 16)
  //
  // Returns the CID used (== the old sq_tail value, 0..63) on success,
  // or NVMEIO_DECODE_BAD (0xFFFFFFFFFFFFFFFF) if PRP encoding failed
  // (nvme_prp_encode_small / _large returned non-zero).
  //
  // sqe_addr is deliberately recomputed from `pair_row` (rbx, callee-
  // save) after every nested call rather than cached across calls --
  // every other value this function touches (qid, sq_pa, sq_tail) is
  // similarly re-derived on demand instead of spilled to the stack,
  // since pair_row's fields are not mutated until the final doorbell-
  // ring step.  Six callee-save pushes (rbx=pair_row, rbp=bar0,
  // r12=packed_nsid_op, r13=lba, r14=packed_nb_bytelen, r15=dma_iova)
  // + sub rsp,8 pad = 56 B; entry rsp%16==8 -> 64, %16==0.
  // ==========================================================================
  let nvme_iox_sqe_submit : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (pair_row: u64) (bar0: u64) (packed_nsid_op: u64) (lba: u64) (packed_nb_bytelen: u64) (dma_iova: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M3-003 (#1647): build one NVMe READ/WRITE SQE at the pair's current sq_tail slot, encode its PRP1/PRP2 (small <=2-page path via nvme_prp_encode_small, falling back to a PRP-list page via nvme_prp_list_alloc + nvme_prp_encode_large on NVME_PRP_ERR_TOO_LARGE), advance sq_tail (mod 64) in the row's cursors word (+32, preserving cq_head/cq_phase), and ring SQyTDBL via nvme_ring_sq(bar0, qid, new_sq_tail). Six callee-save pushes (rbx=pair_row, rbp=bar0, r12=packed_nsid_op, r13=lba, r14=packed_nb_bytelen, r15=dma_iova) + sub rsp,8 pad = 56 B; entry rsp%16==8 -> 64, %16==0 -- every nested call (nvme_prp_encode_small/_large, nvme_prp_list_alloc, nvme_ring_sq) executes at rsp%16==0. sqe_addr = sq_pa(+8) + sq_tail*64 is recomputed via rbx after every nested call rather than cached in a caller-save register (rbx itself is the only value that must survive the calls, and it is callee-save). dword0 (OPC|CID<<16) and NSID (u32@+4) are stored via mov_d (G1: plain `mov [mem], r32`-shaped stores widen to 8 bytes). CDW10/CDW11 (u32@+40/+44) split lba's low/high 32 bits; CDW12 (u32@+48) = (nblocks-1)&0xFFFF, NLB is 0-based per NVMe §4.2. The old sq_tail value (== CID, since CID is assigned as the rolling sq_tail per design §3.3 step 5) is stashed at [rsp+0] (the alignment-pad slot, reused as genuine scratch) across the final nvme_ring_sq call so it survives to become this function's return value. Returns NVMEIO_DECODE_BAD (0xFFFFFFFFFFFFFFFF) if both PRP encode paths fail. Labels prefixed nvme_iox_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                     // pair_row
        mov rbp, rsi;                     // bar0
        mov r12, rdx;                     // packed_nsid_op
        mov r13, rcx;                     // lba
        mov r14, r8;                      // packed_nb_bytelen
        mov r15, r9;                      // dma_iova

        // ---- zero the 64-byte SQE at sq_pa + sq_tail*64 ----
        mov r10, [rbx + 32];              // cursors
        shr r10, 32;
        and r10, 0xFFFF;                  // sq_tail
        mov r11, [rbx + 8];               // sq_pa
        shl r10, 6;
        add r10, r11;                     // r10 = sqe_addr

        xor rax, rax;
        xor rcx, rcx;
      nvme_iox_zero_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  nvme_iox_zero_loop;

        // ---- dword0 = opcode | (cid << 16); cid == sq_tail ----
        mov r11, [rbx + 32];
        shr r11, 32;
        and r11, 0xFFFF;                  // sq_tail == cid
        mov rax, r12;
        shr rax, 32;
        and rax, 0xFF;                    // opcode
        mov rcx, r11;
        shl rcx, 16;
        or  rax, rcx;
        mov_d [r10 + 0], rax;

        // ---- NSID (u32 @+4) ----
        mov rax, r12;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov_d [r10 + 4], rax;

        // ---- CDW10/CDW11 (lba) ----
        mov rax, r13;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov_d [r10 + 40], rax;            // CDW10 = lba[31:0]
        mov rax, r13;
        shr rax, 32;
        mov_d [r10 + 44], rax;            // CDW11 = lba[63:32]

        // ---- CDW12 = (nblocks - 1) & 0xFFFF ----
        mov rax, r14;
        and rax, 0xFFFF;                  // nblocks
        sub rax, 1;
        and rax, 0xFFFF;
        mov_d [r10 + 48], rax;

        // ---- PRP encode (small path) ----
        mov rdi, r10;                     // sqe_ptr
        mov rsi, r15;                     // dma_iova
        mov rdx, r14;
        shr rdx, 16;                      // byte_len
        call nvme_prp_encode_small;

        cmp rax, 0;
        je  nvme_iox_prp_ok;
        cmp rax, 0x1002;                  // NVME_PRP_ERR_TOO_LARGE
        jne nvme_iox_fail;

        // ---- PRP encode (large path: allocate a PRP-list page) ----
        call nvme_prp_list_alloc;         // rax = list_pa (never fails: round-robin bump)
        mov r8, rax;                      // stash list_pa

        mov r10, [rbx + 32];              // recompute sqe_addr (r10 clobbered by the calls above)
        shr r10, 32;
        and r10, 0xFFFF;
        mov r11, [rbx + 8];
        shl r10, 6;
        add r10, r11;

        mov rdi, r10;                     // sqe_ptr
        mov rsi, r15;                     // dma_iova
        mov rdx, r14;
        shr rdx, 16;                      // byte_len
        mov rcx, r8;                      // list_pa
        call nvme_prp_encode_large;

        cmp rax, 0;
        jne nvme_iox_fail;

      nvme_iox_prp_ok:
        // ---- advance sq_tail (mod 64); rebuild cursors; stash cid ----
        mov r10, [rbx + 32];              // cursors (old)
        mov r11, r10;
        shr r11, 32;
        and r11, 0xFFFF;                  // old sq_tail == cid
        mov [rsp + 0], r11;               // stash cid across nvme_ring_sq below

        mov rax, r11;
        add rax, 1;
        and rax, 0x3F;                    // new sq_tail (NVME_IO_QUEUE_ENTRIES=64)

        mov r9, 0xFFFFFFFF;
        and r10, r9;                      // low32 (cq_head|cq_phase) preserved
        mov rcx, rax;
        shl rcx, 32;
        or  r10, rcx;                     // new cursors
        mov [rbx + 32], r10;              // write back

        xor rcx, rcx;
        mov_b rcx, [rbx + 0];             // qid, zero-extended

        mov rdi, rbp;                     // bar0
        mov rsi, rcx;                     // qid
        mov rdx, rax;                     // new_sq_tail
        call nvme_ring_sq;

        mov rax, [rsp + 0];               // rax = cid (return value)
        jmp nvme_iox_out;

      nvme_iox_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;      // NVMEIO_DECODE_BAD

      nvme_iox_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_io_completion_drain(pair_row, bar0, expected_cid, spin_max) -> u64
  //
  // design/hardware/nvme-io-queues.md §2.4, §3.3 step 7.  Polls the
  // pair's CQ at cq_head until a CQE with a matching Phase Tag AND a
  // matching CID appears, or spin_max iterations are exhausted.
  //
  // Returns:
  //   NVMEIO_DECODE_BAD (0xFFFFFFFFFFFFFFFF) on timeout (caller maps to
  //     NVMEIO_SUBMIT_TIMEOUT);
  //   else the matched CQE's status field with the Phase Tag bit
  //     masked out (status & 0xFFFE) -- 0 means OK, matching the R24
  //     `(status & 0xFFFE) == 0` success convention already used
  //     throughout drivers/nvme/*.pdx.
  // ==========================================================================
  pub let nvme_io_completion_drain : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (pair_row: u64) (bar0: u64) (expected_cid: u64) (spin_max: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R51.M3-003 (#1647): phase-tag completion poll, structurally identical to drivers/nvme/queue.pdx nvme_admin_submit_poll's poll half and drivers/nvme/irq.pdx's drain, adapted to read cq_head/cq_phase/sq_tail out of the pair row's packed cursors word (+32: sq_tail[63:32] | cq_head[31:16] | cq_phase[7:0]) instead of a dedicated ctx struct. Four callee-save pushes (rbx=pair_row, r12=bar0, r13=expected_cid, r14=spin_max-as-counter) + sub rsp,8 pad = 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for the terminal nvme_ring_cq call). Per iteration: compute cqe_addr = cq_pa(+16) + cq_head*16; read status u16 @+14 (zero-extended); phase = status & 1; if phase != the row's cq_phase -> not ready (decrement r14, loop; spin_max exhausted -> return NVMEIO_DECODE_BAD as a timeout sentinel). If phase matches, read CID u16 @+12; if it does not equal expected_cid -> also not-ready (single-outstanding-command invariant means a mismatch here should not occur in practice, but the check is cheap and matches design step 7's literal 'until CID matches'). On a full match: stash the raw status (masked to exclude phase, i.e. & 0xFFFE) at [rsp+0] before touching any more registers; recompute cq_head/cq_phase fresh from a reloaded cursors word, advance cq_head mod 64 (NVME_IO_QUEUE_ENTRIES=64), toggle cq_phase only on wrap (new cq_head == 0), rebuild cursors preserving sq_tail (bits[63:32]), write back, ring CQyHDBL via nvme_ring_cq(bar0, qid, new_cq_head), then reload the stashed status field as the return value. Reserved labels: nvme_iod_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                     // pair_row
        mov r12, rsi;                     // bar0
        mov r13, rdx;                     // expected_cid
        mov r14, rcx;                     // spin_max (counter)

      nvme_iod_poll_loop:
        cmp r14, 0;
        je  nvme_iod_timeout;

        mov r10, [rbx + 16];              // cq_pa
        mov r11, [rbx + 32];              // cursors
        mov rax, r11;
        shr rax, 16;
        and rax, 0xFFFF;                  // cq_head
        mov rcx, rax;
        shl rcx, 4;
        add r10, rcx;                     // r10 = cqe_addr

        xor rax, rax;
        mov_w rax, [r10 + 14];            // status (includes phase bit0)
        mov rdx, rax;
        and rdx, 1;                       // phase bit

        mov rcx, r11;
        and rcx, 0xFF;                    // expected cq_phase

        cmp rdx, rcx;
        jne nvme_iod_not_ready;

        xor rcx, rcx;
        mov_w rcx, [r10 + 12];            // cid field
        cmp rcx, r13;
        jne nvme_iod_not_ready;

        // ---- matched: stash status_field, then advance the CQ ----
        mov rdx, rax;
        and rdx, 0xFFFE;                  // status_field (phase bit cleared)
        mov [rsp + 0], rdx;

        mov r11, [rbx + 32];              // reload cursors (fresh)
        mov r10, r11;
        shr r10, 16;
        and r10, 0xFFFF;                  // old cq_head
        mov r9, r10;
        add r9, 1;
        and r9, 0x3F;                     // new cq_head (mod 64)

        mov r8, r11;
        and r8, 0xFF;                     // old cq_phase
        cmp r9, 0;
        jne nvme_iod_no_wrap;
        xor r8, 1;                        // toggle phase on wrap
      nvme_iod_no_wrap:

        mov rcx, r11;
        mov rdx, 0xFFFFFFFF00000000;
        and rcx, rdx;                     // keep sq_tail bits only
        mov rdx, r9;
        shl rdx, 16;
        or  rcx, rdx;                     // | new cq_head
        or  rcx, r8;                      // | new cq_phase
        mov [rbx + 32], rcx;              // write back

        xor rax, rax;
        mov_b rax, [rbx + 0];             // qid, zero-extended

        mov rdi, r12;                     // bar0
        mov rsi, rax;                     // qid
        mov rdx, r9;                      // new cq_head
        call nvme_ring_cq;

        mov rax, [rsp + 0];               // status_field
        jmp nvme_iod_out;

      nvme_iod_not_ready:
        sub r14, 1;
        jmp nvme_iod_poll_loop;

      nvme_iod_timeout:
        mov rax, 0xFFFFFFFFFFFFFFFF;      // NVMEIO_DECODE_BAD (timeout sentinel)

      nvme_iod_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_io_submit_rw(ctrl_row_id, ns_row, opcode, lba, nblocks, dma_iova) -> u64
  //
  // design/hardware/nvme-io-queues.md §3.3.  One entry point for both
  // BDEV_OP_READ_LBA (opcode=2, NVMe OPC) and BDEV_OP_WRITE_LBA
  // (opcode=1) -- #1647 lands the full path; #1648's witness exercises
  // the WRITE side of the same code.
  //
  // Returns bytes transferred (nblocks * lba_size) on success; else one
  // of NVMEIO_STATE_BAD / NVMEIO_SUBMIT_ENOROOM / NVMEIO_SUBMIT_TIMEOUT
  // / NVMEIO_SUBMIT_CQE_ERR / NVMEIO_PICK_NONE, or the literal
  // 0xE001 / 0xE002 / 0xEEEE sentinels for the three validation
  // failures the design doc calls out by exact value (see file-header
  // gap note).
  // ==========================================================================
  pub let nvme_io_submit_rw : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) (ns_row: u64) (opcode: u64) (lba: u64) (nblocks: u64) (dma_iova: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M3-003 (#1647): validate + pick a live pair + build/submit an SQE + drain its completion for one READ or WRITE. Six callee-save pushes (rbx=ctrl_row_id, rbp=ns_row, r12=opcode, r13=lba, r14=nblocks, r15=dma_iova) + sub rsp,40 = 88 B; entry rsp%16==8 -> 96, %16==0. The sub rsp,40 gives five 8-byte scratch slots ([rsp+0]=pair_row, [rsp+8]=bar0, [rsp+16]=lba_size, [rsp+24]=nsid, [rsp+32] unused) that survive the run of nested calls (nvme_io_pick_pair, nvme_ctrl_row_bar0, nvme_ns_row_lba_size, nvme_ns_row_nsid, nvme_ns_row_block_count, nvme_ctrl_row_mdts) because all six callee-save registers are already committed to the six input args -- pair_row/bar0/lba_size/nsid have nowhere else to live across that many calls, so they spill to the stack instead (block_count and mdts are consumed immediately after their own call and never need to survive a further call, so they stay in caller-save scratch). Sequence: (1) validate opcode in {1,2} else return 0xEEEE; (2) nvme_io_pick_pair(ctrl_row_id) -> pair_row, NVMEIO_PICK_NONE (0xFFFFEC58) forwarded verbatim on failure; (3) re-check pair_row's state byte (+1) == NVME_IOP_STATE_SQ_LIVE else NVMEIO_STATE_BAD; (4) bar0 via nvme_ctrl_row_bar0, DECODE_BAD -> NVMEIO_STATE_BAD; (5) lba_size via nvme_ns_row_lba_size; (6) nsid via nvme_ns_row_nsid; (7) block_count via nvme_ns_row_block_count, bound-check lba+nblocks <= block_count else return the literal 0xE001; (8) mdts via nvme_ctrl_row_mdts, mdts_bytes = 1 << (12+mdts), bound-check nblocks*lba_size (via imul, matching the fb_glyph.pdx / vk/bench.pdx imul precedent) <= mdts_bytes else return the literal 0xE002; (9) pack packed_nsid_op = nsid | (opcode<<32) and packed_nb_bytelen = nblocks | (byte_len<<16), call nvme_iox_sqe_submit(pair_row, bar0, packed_nsid_op, lba, packed_nb_bytelen, dma_iova) -> cid or NVMEIO_DECODE_BAD (mapped to NVMEIO_SUBMIT_ENOROOM, the closest-fit 'cannot submit' code -- see file-header gap note); (10) nvme_io_completion_drain(pair_row, bar0, cid, 50000000 /* NVME_SYNC_SPIN_MAX, drivers/nvme/sync.pdx */) -> NVMEIO_DECODE_BAD mapped to NVMEIO_SUBMIT_TIMEOUT, non-zero mapped to NVMEIO_SUBMIT_CQE_ERR, zero -> success, return nblocks*lba_size. Every sentinel comparison against a value with bit 31/63 set is staged through `mov r10, <imm>; cmp reg, r10` (imm32 cmp operands sign-extend). Labels prefixed nvme_ios_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        mov rbx, rdi;                     // ctrl_row_id
        mov rbp, rsi;                     // ns_row
        mov r12, rdx;                     // opcode
        mov r13, rcx;                     // lba
        mov r14, r8;                      // nblocks
        mov r15, r9;                      // dma_iova

        // ---- validate opcode ----
        cmp r12, 1;
        je  nvme_ios_op_ok;
        cmp r12, 2;
        je  nvme_ios_op_ok;
        mov rax, 0xEEEE;
        jmp nvme_ios_out;
      nvme_ios_op_ok:

        // ---- pick a pair ----
        mov rdi, rbx;
        call nvme_io_pick_pair;
        mov r10, 0xFFFFEC58;              // NVMEIO_PICK_NONE
        cmp rax, r10;
        je  nvme_ios_pick_fail;
        mov [rsp + 0], rax;               // pair_row

        // ---- state recheck ----
        mov r10, [rsp + 0];
        xor rax, rax;
        mov_b rax, [r10 + 1];
        cmp rax, 3;                       // NVME_IOP_STATE_SQ_LIVE
        jne nvme_ios_bad_state;

        // ---- bar0 ----
        mov rdi, rbx;
        call nvme_ctrl_row_bar0;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ios_bad_state;
        mov [rsp + 8], rax;               // bar0

        // ---- lba_size ----
        mov rdi, rbp;
        call nvme_ns_row_lba_size;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ios_bad_state;
        mov [rsp + 16], rax;              // lba_size

        // ---- nsid ----
        mov rdi, rbp;
        call nvme_ns_row_nsid;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ios_bad_state;
        mov [rsp + 24], rax;              // nsid

        // ---- block_count bound check ----
        mov rdi, rbp;
        call nvme_ns_row_block_count;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ios_bad_state;
        mov r11, r13;
        add r11, r14;                     // lba + nblocks
        cmp r11, rax;
        ja  nvme_ios_lba_oob;

        // ---- mdts bound check ----
        mov rdi, rbx;
        call nvme_ctrl_row_mdts;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ios_bad_state;
        mov rcx, rax;
        add rcx, 12;                      // shift = 12 + mdts
        mov rax, 1;
        shl rax, cl;                      // mdts_bytes
        mov r10, rax;

        mov rax, r14;                     // nblocks
        mov rcx, [rsp + 16];              // lba_size
        imul rax, rcx;                    // byte_len
        cmp rax, r10;
        ja  nvme_ios_mdts_oob;

        mov r9, rax;                      // byte_len (stash, no call yet)

        // ---- build packed helper args ----
        mov rax, [rsp + 24];              // nsid
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        mov rcx, r12;                     // opcode
        shl rcx, 32;
        or  rax, rcx;                     // packed_nsid_op
        mov r8, rax;

        mov rax, r14;                     // nblocks
        and rax, 0xFFFF;
        mov rcx, r9;                      // byte_len
        shl rcx, 16;
        or  rax, rcx;                     // packed_nb_bytelen
        mov r11, rax;

        mov rdi, [rsp + 0];               // pair_row
        mov rsi, [rsp + 8];               // bar0
        mov rdx, r8;                      // packed_nsid_op
        mov rcx, r13;                     // lba
        mov r8, r11;                      // packed_nb_bytelen
        mov r9, r15;                      // dma_iova
        call nvme_iox_sqe_submit;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ios_submit_fail;
        mov r8, rax;                      // cid

        // ---- drain ----
        mov rdi, [rsp + 0];               // pair_row
        mov rsi, [rsp + 8];               // bar0
        mov rdx, r8;                      // expected_cid
        mov rcx, 50000000;                // NVME_SYNC_SPIN_MAX (drivers/nvme/sync.pdx)
        call nvme_io_completion_drain;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvme_ios_timeout;

        cmp rax, 0;
        jne nvme_ios_cqe_err;

        // ---- success: bytes = nblocks * lba_size ----
        mov rax, r14;
        mov rcx, [rsp + 16];
        imul rax, rcx;
        jmp nvme_ios_out;

      nvme_ios_pick_fail:
        mov rax, 0xFFFFEC58;              // NVMEIO_PICK_NONE
        jmp nvme_ios_out;

      nvme_ios_bad_state:
        mov rax, 0xFFFFEC54;              // NVMEIO_STATE_BAD
        jmp nvme_ios_out;

      nvme_ios_lba_oob:
        mov rax, 0xE001;
        jmp nvme_ios_out;

      nvme_ios_mdts_oob:
        mov rax, 0xE002;
        jmp nvme_ios_out;

      nvme_ios_submit_fail:
        mov rax, 0xFFFFEC55;              // NVMEIO_SUBMIT_ENOROOM
        jmp nvme_ios_out;

      nvme_ios_timeout:
        mov rax, 0xFFFFEC56;              // NVMEIO_SUBMIT_TIMEOUT
        jmp nvme_ios_out;

      nvme_ios_cqe_err:
        mov rax, 0xFFFFEC57;              // NVMEIO_SUBMIT_CQE_ERR

      nvme_ios_out:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
