  // ==========================================================================
  // R51.M7-001 (#1669): unified KIND_BLKDEV tail accessors.  Every one
  // mirrors nvme_ns_row_family's shape one-for-one (tail_valid gate,
  // then a masked read at a fixed row offset). Consumed by
  // kind_blkdev.pdx's family-dispatching blkdev_row_* wrappers.
  // ==========================================================================

  pub let nvme_ns_row_features : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): features bitmap byte (meta [+32] bits [31:24]: FLUSH/TRIM/WRITE_ZEROES/WRITE_CACHE_PRESENT), or NVMEN_DECODE_BAD. Labels prefixed nvmen_rfe_.",
      block: {
        push r12;
        mov r12, rdi;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        je  nvmen_rfe_bad;
        lea r10, [rip + _nvme_namespace_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        shr rax, 24;
        and rax, 0xFF;
        jmp nvmen_rfe_out;
      nvmen_rfe_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      nvmen_rfe_out:
        pop r12;
        ret
      }
    }

  pub let nvme_ns_row_attest_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): attest_key (KIND_DMA_ATTESTATION.attest_key, [+40]), or NVMEN_DECODE_BAD. Labels prefixed nvmen_rak_.",
      block: {
