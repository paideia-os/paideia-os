  pub let nvme_ns_row_family : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-004 (#1642): family byte (1=NVME, 2=AHCI), or NVMEN_DECODE_BAD. Labels prefixed nvmen_rf_.",
      block: {
        push r12;
