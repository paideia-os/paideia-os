// src/kernel/core/cap/kind_nvme_namespace.pdx -- R51.M2-001 (#1639),
// R51.M2-002 (#1640), R51.M2-003 (#1641), R51.M2-004 (#1642),
// R51.M2-005 (#1643), R51.M2-006 (#1644).
//
// KIND_NVME_NAMESPACE = 0x199, derived over KIND_MEMORY (= 4).
//
// The runtime authority for ONE NVMe namespace: the (controller_row,
// nsid, lba_size, block_count) tuple the driver process holds as the
// per-namespace authority.  A KIND_NVME_NAMESPACE cap ALSO satisfies
// KIND_BLKDEV (0x42) via dual-kind mint (see nvme_ns_dual_kind_mint
// below and design/hardware/nvme-and-disk-substrate.md §4.4): the two
// caps -- one KIND_NVME_NAMESPACE for namespace-admin ops, one
// KIND_BLKDEV for BDEV_OP_* -- refer to the SAME `_nvme_namespace_table`
// row, so a mounter that only holds the KIND_BLKDEV cap cannot mint
// further namespaces but can still transact blocks.
//
// R51.M7-002 (#1670) widens `R_BLK_ALL_TAG` / `nvme_ns_blk_rights_valid`'s
// subset gate from 0x07 to 0x1F (adds R_BLK_FLUSH/R_BLK_TRIM), mirroring
// the same widening in kind_ahci_port.pdx's `ahci_port_blk_rights_valid`.
// This closes the residual gap #1651 flagged and left open: that commit
// widened blkdev_cap.pdx's own R_BLK_ALL to 0x1F but explicitly did not
// touch this namespace-mint-side gate, so a dual-kind KIND_BLKDEV cap
// minted through `nvme_ns_dual_kind_mint` could not request R_BLK_FLUSH/
// R_BLK_TRIM until now. No dispatch-path changes accompany this widening
// -- see design/hardware/nvme-ahci-tail-milestones.md §M7-002.
//
// R51.M8-004 (#1678) FIX: `nvme_ns_cascade_revoke_blkdev` gained a
// family-byte disambiguation check (target_ptr[23:16] != AHCIP_FAMILY_
// AHCI(2)), mirroring the check `ahci_port_cascade_revoke_blkdev`
// (kind_ahci_port.pdx) already had. Without it, revoking an NVMe
// namespace row also scrubbed any AHCI-family KIND_BLKDEV cap whose
// row_id happened to collide with the NVMe row_id (both
// `_nvme_namespace_table` and `_ahci_port_table` are independent
// low-first-scan allocators, so row 0 is the very first row either one
// hands out) -- an orphan-inducing cross-family cascade bug the M8-004
// cross-family soak witness (tests/kernel/nvme/
// bdev_cross_family_soak_synth.pdx) caught on its first iteration.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// An NVMe namespace is a set of logical blocks projected onto host
// pages via PRP transfers -- the same "memory-adjacent authority"
// posture KIND_BLKDEV (0x42, R24) took at its base slot 4 (KIND_PAGE
// = KIND_MEMORY).  Deriving KIND_NVME_NAMESPACE over KIND_MEMORY
// (rather than over KIND_DEVICE) is what lets the dual-kind mint
// share ONE row across two derived tags whose runtime base is the
// same slot -- cap_invoke_dispatch compares the FULL u64 kind field
// (not the LAM 4-bit slot), so BOTH 0x199 and 0x42 can coexist on
// slot-4 without ambiguity.  Same posture as KIND_OP_REGION which
// serves two base slots (kind_op_region.pdx §KIND_OP_REGION).
//
// The parent derivation check is against KIND_NVME_CONTROLLER (0x198,
// R51.M1) carrying R_NVMEC_MINT_NS (0x200), NOT against a raw
// KIND_DEVICE.  A driver that only holds a device cap cannot mint a
// namespace authority; only a driver that acquired controller-reset
// authority via nvme_ctrl_cap_mint_inner can (design/hardware/
// nvme-and-disk-substrate.md §6.2).
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words):
//
//   [+0]   header: in_use[63:56] | state[15:8] | ns_slot[7:0]
//   [+8]   nsid          (u64, low 32 bits)  -- NVMe namespace ID
//   [+16]  lba_size      (u64, low 32 bits)  -- bytes per LBA (typ. 512/4096)
//   [+24]  block_count   (u64)               -- NSZE (namespace size in blocks)
//   [+32]  packed:       bits [15:0]  = parent_ctrl_row (u16)
//                        bits [23:16] = family (1=NVME, 2=AHCI)
//                        bits [31:24] = features bitmap (FLUSH/TRIM/WZ/WCP)
//                        bits [47:32] = max_transfer_blocks (u16) -- R51.M7-001
//                                       (#1669): zeroed at mint; populated
//                                       from MDTS by M7-003's
//                                       blkdev_cap_mint_from_nvme
//                        bits [55:48] = dma_domain_slot (u8, 0..255 per
//                                       design/hardware/nvme-and-disk-
//                                       substrate.md §4.3's own stated
//                                       range) -- R51.M7-001 (#1669):
//                                       zeroed at mint (0 == unscoped);
//                                       populated at M7-003+
//                        bits [63:56] = reserved
//   [+40]  attest_key    (u64)               -- KIND_DMA_ATTESTATION.attest_key
//                                               (§5.4); 0 == no attestation cited
//                                               (permitted at M2; R51.M3+ tightens)
//   [+48]  reserved      (u64)
//   [+56]  reserved      (u64)
//
// R51.M7-001 (#1669) packs max_transfer_blocks / dma_domain_slot into
// the previously-unused meta-word high bits ([63:32] were reserved and
// always zero, per nvme_ns_tail_pack_meta) rather than the [+48]/[+56]
// words, because the AHCI-family row (kind_ahci_port.pdx) already
// repurposed ITS [+48]/[+56] words for cl_iova/ct_iova at R51.M6-001
// (#1663) -- reusing the meta word's spare bits keeps both families'
// KIND_BLKDEV tail fields at parallel bit-positions despite their
// [+48]/[+56] words diverging. Every KIND_BLKDEV descriptor reaches
// these via kind_blkdev.pdx's family-dispatching blkdev_row_
// max_transfer_blocks / blkdev_row_dma_domain_slot, keyed off the
// family byte at [+32] bits [23:16].
//
// State byte values (in header bits [15:8]):
//   NVMEN_STATE_MINTED     = 1  -- row allocated, geometry populated
//   NVMEN_STATE_IDENTIFIED = 2  -- reserved for M2+ (post-IDENTIFY confirm)
//
// ns_slot (bits [7:0]) is a per-row nominal index; assigned equal to
// the row_id at mint (0..NVMEN_MAX-1).  This keeps the header the same
// shape as KIND_NVME_CONTROLLER for cost-of-consistency.
//
// Row-addressed capacity: 32 rows x 64 bytes = 2048 bytes.  Matches
// the "32 slots per controller" ceiling declared at R51.M2-001 in
// design/hardware/nvme-and-disk-substrate.md §7 M2.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// Per design/hardware/nvme-and-disk-substrate.md §6.2 (adapted to
// the KIND_NVME_CONTROLLER rights shape for symmetry):
//
//   R_NVMEN_MINT_BLK (0x001) -- mint downstream KIND_BLKDEV children
//                               (the KIND_BLKDEV half of dual-kind mint)
//   R_NVMEN_ATTACH   (0x002) -- namespace-attach op
//   R_NVMEN_DETACH   (0x004) -- namespace-detach op
//   R_NVMEN_INVOKE   (0x008) -- QUERY ops (nsid/lba_size/block_count/etc.)
//   R_NVMEN_REVOKE   (0x010) -- teardown the row (cascades to KIND_BLKDEV)
//   R_NVMEN_OBSERVE  (0x400) -- debug printer
//   R_NVMEN_ALL      (0x41F)
//
// The MINT_BLK right is what enforces "namespace cap is not
// unconditionally a block cap" -- a supervisor holding
// KIND_NVME_NAMESPACE without R_NVMEN_MINT_BLK cannot hand a mounter
// the derived KIND_BLKDEV that authorises READ/WRITE traffic.  The
// R51 boot-time policy grants MINT_BLK to the NVMe supervisor; a
// downstream FS mounter receives ONLY the KIND_BLKDEV half.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEC50..0xFFFFEC5F
// =============================================================================
//
// Sixteen wide, disjoint from every previous R48b / R30-PREP / R51.M1
// band:
//   KIND_ELEVATE_CHANNEL   0xFFFFEC00..0xFFFFEC0F
//   KIND_PDXFS_TXN         0xFFFFEC10..0xFFFFEC1F
//   KIND_PDXFS_FILE        0xFFFFEC20..0xFFFFEC2F
//   KIND_TTY               0xFFFFEC30..0xFFFFEC3F
//   KIND_NVME_CONTROLLER   0xFFFFEC40..0xFFFFEC4F
//   KIND_NVME_NAMESPACE    0xFFFFEC50..0xFFFFEC5F   (this file)
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: sized stores via mov_b / mov_w / mov_d for sub-8-byte fields.
//   G4: full-register compares (zero-extend loads via prior xor).
//
// r11 scratch only for imm32-sized constants.  imm64 constants (BAD
// sentinel, > 0x7FFFFFFF) are staged into r10 before use.  All
// failure-taxonomy constants (0xFFFFEC5x) fit imm32 (< 0x7FFFFFFF is
// FALSE for these — they are > 0x7FFFFFFF), so cmp against them
// stages the constant into r10 first.  Labels prefixed
// `nvmen_` / `nvmenw_` per reserved-label discipline.

module KindNvmeNamespace = structure {

  pub let KIND_NVME_NAMESPACE      : u64 = 0x199
  pub let KIND_NVME_NAMESPACE_BASE : u64 = 4          // = KIND_MEMORY

  // KIND_BLKDEV is the dual-kind mint target; retained as a private
  // constant so the module does not have to import blkdev_cap.pdx just
  // to spell the tag.  Kept in sync with cap/blkdev_cap.pdx §KIND
  // (R24-M5-003 #905).
  pub let KIND_BLKDEV_TAG          : u64 = 0x42

  pub let R_NVMEN_MINT_BLK : u64 = 0x001
  pub let R_NVMEN_ATTACH   : u64 = 0x002
  pub let R_NVMEN_DETACH   : u64 = 0x004
  pub let R_NVMEN_INVOKE   : u64 = 0x008
  pub let R_NVMEN_REVOKE   : u64 = 0x010
  pub let R_NVMEN_OBSERVE  : u64 = 0x400
  pub let R_NVMEN_ALL      : u64 = 0x41F

  // KIND_BLKDEV rights (mirror of blkdev_cap.pdx §Rights, R24-M5-003).
  // Duplicated here to keep the dual-kind mint self-contained; the
  // R51.M2-004 mint gate accepts a blk_rights argument constrained by
  // this mask. R51.M7-002 (#1670) widens R_BLK_ALL_TAG from 0x07 to
  // 0x1F now that R_BLK_FLUSH/R_BLK_TRIM dispatch paths exist (this
  // was the flagged residual gap left open at #1651: the namespace-
  // mint-side gate had not been touched even though blkdev_cap.pdx's
  // own R_BLK_ALL was widened that same commit).
  pub let R_BLK_READ_TAG   : u64 = 0x01
  pub let R_BLK_WRITE_TAG  : u64 = 0x02
  pub let R_BLK_ADMIN_TAG  : u64 = 0x04
  pub let R_BLK_FLUSH_TAG  : u64 = 0x08
  pub let R_BLK_TRIM_TAG   : u64 = 0x10
  pub let R_BLK_ALL_TAG    : u64 = 0x1F

  pub let NVMEN_STATE_MINTED     : u64 = 1
  pub let NVMEN_STATE_IDENTIFIED : u64 = 2
  pub let NVMEN_STATE_MAX        : u64 = 2

  // Family bytes (mirror of design/hardware/nvme-and-disk-substrate.md
  // §4.3 tail: 0 = legacy R24 mint, 1 = NVMe, 2 = AHCI).  R51.M2
  // rows always stamp NVMEN_FAMILY_NVME.
  pub let NVMEN_FAMILY_NVME  : u64 = 1
  pub let NVMEN_FAMILY_AHCI  : u64 = 2

  // Every op ARITY ONE -- op_arg[63:8] REFUSED (mirrors
  // KIND_NVME_CONTROLLER / KIND_TTY / KIND_PDXFS_TXN discipline).
  pub let NVMEN_OP_QUERY_NSID        : u64 = 0
  pub let NVMEN_OP_QUERY_LBA_SIZE    : u64 = 1
  pub let NVMEN_OP_QUERY_BLOCK_COUNT : u64 = 2
  pub let NVMEN_OP_QUERY_PARENT      : u64 = 3
  pub let NVMEN_OP_QUERY_FAMILY      : u64 = 4
  pub let NVMEN_OP_QUERY_STATE       : u64 = 5
  pub let NVMEN_OP_QUERY_NS_SLOT     : u64 = 6
  pub let NVMEN_OP_DEBUG_PRINT       : u64 = 7
  pub let NVMEN_OP_MAX               : u64 = 7

  pub let NVMEN_OK               : u64 = 0
  pub let NVMEN_TAIL_ENOSPC      : u64 = 0xFFFFEC5F
  pub let NVMEN_TAIL_BAD_ARG     : u64 = 0xFFFFEC5E
  pub let NVMEN_MINT_BAD_PARENT  : u64 = 0xFFFFEC5D
  pub let NVMEN_MINT_BAD_RIGHTS  : u64 = 0xFFFFEC5C
  pub let NVMEN_MINT_BAD_NSID    : u64 = 0xFFFFEC5B
  pub let NVMEN_MINT_BAD_LBA     : u64 = 0xFFFFEC5A
  pub let NVMEN_MINT_BAD_BLOCKS  : u64 = 0xFFFFEC59
  pub let NVMEN_BAD_SLOT         : u64 = 0xFFFFEC58
  pub let NVMEN_WRONG_KIND       : u64 = 0xFFFFEC57
  pub let NVMEN_REVOKE_ALREADY   : u64 = 0xFFFFEC56
  pub let NVMEN_MINT_BAD_CTRL_ROW: u64 = 0xFFFFEC55
  pub let NVMEN_ENUM_FAILED      : u64 = 0xFFFFEC54
  pub let NVMEN_DUAL_BAD_SLOTS   : u64 = 0xFFFFEC53
  pub let NVMEN_MINT_BAD_BLK_RIGHTS : u64 = 0xFFFFEC52
  pub let NVMEN_BAD_FAMILY       : u64 = 0xFFFFEC51
  pub let NVMEN_MINT_BAD_ATTEST  : u64 = 0xFFFFEC50

  pub let NVMEN_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let NVMEN_ROW_NONE   : u64 = 0xFF

  // Ceiling.  32 slots matches design §7 M2-001; a 33rd namespace on
  // one controller exceeds every consumer/workstation drive to date.
  pub let NVMEN_MAX        : u64 = 32
  pub let NVMEN_ROW_BYTES  : u64 = 64
  // 32 rows * 64 bytes = 2048 bytes = 256 u64.
  pub let mut _nvme_namespace_table : [u64; 256] = uninit @align(64)
  pub let mut _nvme_namespace_stats : [u64; 16]  = uninit @align(64)

  pub let NVMEN_ST_MINTS       : u64 = 0
  pub let NVMEN_ST_REVOKES     : u64 = 1
  pub let NVMEN_ST_QUERIES     : u64 = 2
  pub let NVMEN_ST_REFUSED     : u64 = 3
  pub let NVMEN_ST_ENUMS       : u64 = 4
  pub let NVMEN_ST_DUAL_MINTS  : u64 = 5
  pub let NVMEN_ST_CASCADES    : u64 = 6
  pub let NVMEN_ST_IDENTIFIES  : u64 = 7
  pub let NVMEN_ST_MAX         : u64 = 16

  pub let nvmen_dbg_msg : [u8; 12] = "NVME NS ROW\0"

  // ==========================================================================
  // nvme_ns_table_reset() -> ()
  //
  // Clear every row and every counter.  Boot and teardown only.  Two
  // separate loops (rows / stats) mirror kind_tty / kind_nvme_controller
  // shape: the arrays have different lengths and one loop over the
  // total would encode their .bss adjacency as a fact code depends on.
  // ==========================================================================
  pub let nvme_ns_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): clear every row and every counter. Boot and teardown only. Labels prefixed nvmen_rs_.",
      block: {
        lea r10, [rip + _nvme_namespace_table];
        xor rax, rax;
        xor rcx, rcx;
      nvmen_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  nvmen_rs_rows;

        lea r10, [rip + _nvme_namespace_stats];
        xor rcx, rcx;
      nvmen_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  nvmen_rs_stats;
        ret
      }
    }

  pub let nvme_ns_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): bounded increment; out-of-range no-op. Labels prefixed nvmen_nt_.",
      block: {
        cmp rdi, 16;
        jae nvmen_nt_out;
        lea r10, [rip + _nvme_namespace_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      nvmen_nt_out:
        ret
      }
    }

  pub let nvme_ns_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): bounded read; out-of-range returns 0. Labels prefixed nvmen_st_.",
      block: {
        cmp rdi, 16;
        jae nvmen_st_zero;
        lea r10, [rip + _nvme_namespace_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      nvmen_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let nvme_ns_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M2-001 (#1639): subset test against R_NVMEN_ALL = 0x41F. Labels prefixed nvmen_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41F;
        and rax, r10;
        cmp rax, rdi;
        jne nvmen_rv_no;
        mov rax, 1;
        ret;
      nvmen_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_blk_rights_valid(rights) -> 1 | 0
  //
  // Companion validator for the KIND_BLKDEV half of a dual-kind mint.
  // Returns 1 iff (rights & R_BLK_ALL_TAG) == rights.  R51.M2 refused
  // KIND_BLKDEV rights outside {READ, WRITE, ADMIN} (0x07); R51.M7-002
  // (#1670) widens R_BLK_ALL_TAG to 0x1F now that FLUSH/TRIM ops exist
  // on both families -- this was the residual gap #1651 flagged and
  // left open (blkdev_cap.pdx's own R_BLK_ALL widened to 0x1F that
  // commit, but this namespace-mint-side gate did not).
  // ==========================================================================
  pub let nvme_ns_blk_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M2-004 (#1642) + R51.M7-002 (#1670): subset test for the KIND_BLKDEV half of dual-kind mint. R_BLK_ALL_TAG widened from 0x07 to 0x1F at #1670 (adds R_BLK_FLUSH/R_BLK_TRIM) now that FLUSH/TRIM dispatch exists for both families. Labels prefixed nvmen_brv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x1F;
        and rax, r10;
        cmp rax, rdi;
        jne nvmen_brv_no;
        mov rax, 1;
        ret;
      nvmen_brv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_nsid_valid(nsid) -> 1 iff nsid > 0 AND nsid < 0xFFFFFFFE.
  //
  // NVMe §3.1.14: NSID = 0 is a broadcast identifier reserved for
  // admin-context ops (never a real namespace); 0xFFFFFFFF is the
  // BROADCAST identifier for management commands.  R51.M2 refuses
  // both.  Callers that iterate _nvme_active_nsids can trust every
  // published entry is a real namespace.
  // ==========================================================================
  pub let nvme_ns_nsid_valid : (u64) -> u64 !{} @{} =
    fn (nsid: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M2-001 (#1639): NVMe NSID validation. Refuses 0 (broadcast admin) and >= 0xFFFFFFFE (reserved / global broadcast). Two callee-save pushes leave rsp%16 == 0 (no calls; kept minimal). Labels prefixed nvmen_iv_.",
      block: {
        cmp rdi, 0;
        je  nvmen_iv_no;
        mov r10, 0xFFFFFFFE;
        cmp rdi, r10;
        jae nvmen_iv_no;
        mov rax, 1;
        ret;
      nvmen_iv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_lba_valid(lba_size) -> 1 iff lba_size is a power of two in
  // [512, 4096].  Rejects anything else: R51 does not support 8 KiB LBA
  // formats (NVMe LBAF LBADS = 13) at first-boot.
  // ==========================================================================
  pub let nvme_ns_lba_valid : (u64) -> u64 !{} @{} =
    fn (lba_size: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M2-001 (#1639): accept only 512 or 4096 (the two LBA formats the T14 G4 smoke matrix uses). A future 8 KiB (LBADS=13) admission adds one branch. Labels prefixed nvmen_lv_.",
      block: {
        cmp rdi, 512;
        je  nvmen_lv_yes;
        mov r10, 4096;
        cmp rdi, r10;
        je  nvmen_lv_yes;
        xor rax, rax;
        ret;
      nvmen_lv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_blocks_valid(block_count) -> 1 iff block_count > 0.
  // ==========================================================================
  pub let nvme_ns_blocks_valid : (u64) -> u64 !{} @{} =
    fn (block_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M2-001 (#1639): non-zero block_count check. A namespace of zero blocks is not addressable. Labels prefixed nvmen_bv_.",
      block: {
        cmp rdi, 0;
        je  nvmen_bv_no;
        mov rax, 1;
        ret;
      nvmen_bv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_ctrl_row_valid(ctrl_row) -> 1 iff ctrl_row < NVMEC_MAX AND
  // nvme_ctrl_tail_valid(ctrl_row) == 1.
  //
  // Cross-module gate: refuses a namespace whose declared parent
  // controller row is not currently live.  Prevents a mint that would
  // dangle if the controller row is scrubbed before this row lands.
  // ==========================================================================
  pub let nvme_ns_ctrl_row_valid : (u64) -> u64 !{mem} @{} =
    fn (ctrl_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): cross-module liveness check on the parent controller row. Delegates to nvme_ctrl_tail_valid; NVMEC_MAX = 8 bound is enforced by the callee. Single callee-save push (r12) preserves rsp%16 across the delegate call. Labels prefixed nvmen_cv_.",
      block: {
        push r12;
        mov r12, rdi;
        mov rdi, r12;
        call nvme_ctrl_tail_valid;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_check_parent_ctrl(parent_slot) -> 1 | 0
  //
  // Derivation gate.  parent.kind == KIND_NVME_CONTROLLER (0x198)
  // AND rights carry R_NVMEC_MINT_NS (0x200).  Per design/hardware/
  // nvme-and-disk-substrate.md §6.2: only a controller cap that
  // explicitly carries MINT_NS may mint namespace children -- the
  // supervisor keeps this right; a downstream FS mounter never
  // receives it.
  // ==========================================================================
  pub let nvme_ns_check_parent_ctrl : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M2-001 (#1639): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_NVME_CONTROLLER (0x198) AND (rights & R_NVMEC_MINT_NS 0x200) != 0. Kind 0x198 fits imm32 and is staged in r11. Pure read. Labels prefixed nvmen_cpc_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae nvmen_cpc_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x198;                  // KIND_NVME_CONTROLLER
        cmp r10, r11;
        jne nvmen_cpc_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // R_NVMEC_MINT_NS
        and r10, r11;
        cmp r10, 0;
        je  nvmen_cpc_no;

        mov rax, 1;
        ret;

      nvmen_cpc_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | state[15:8] | ns_slot[7:0].
  // Callers pack via nvme_ns_hdr_pack(ns_slot, state).
  pub let nvme_ns_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (ns_slot: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M2-001 (#1639): canonical header encoder. Validates ns_slot in [0..NVMEN_MAX-1] and state in [1..NVMEN_STATE_MAX]. Bits [63:56] MUST leave this function zero (in_use is set by tail_alloc under the same write that claims the row). Labels prefixed nvmen_hp_.",
      block: {
        cmp rdi, 32;                     // NVMEN_MAX
        jae nvmen_hp_bad;
        cmp rsi, 1;
        jb  nvmen_hp_bad;
        mov r10, 2;                      // NVMEN_STATE_MAX
        cmp rsi, r10;
        ja  nvmen_hp_bad;
        mov rax, rdi;                    // ns_slot in [7:0]
        mov r11, rsi;
        shl r11, 8;
        or  rax, r11;                    // state in [15:8]
        ret;
      nvmen_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_tail_pack_meta(parent_ctrl_row, family, features) -> u64
  //
  // Pack the +32 word: bits [15:0]=parent_ctrl_row, [23:16]=family,
  // [31:24]=features, [63:32]=reserved (zero).
  // ==========================================================================
  pub let nvme_ns_tail_pack_meta : (u64, u64, u64) -> u64 !{} @{} =
    fn (parent_ctrl_row: u64) (family: u64) (features: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M2-001 (#1639): pack the meta word. parent_ctrl_row masked to 16 bits, family to 8 bits, features to 8 bits. No overflow: NVMEC_MAX=8 fits 16 bits; family in {1,2} fits 8; features bitmap fits 8. Labels prefixed nvmen_mp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;                 // parent_ctrl_row in [15:0]
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;                    // family in [23:16]
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;                    // features in [31:24]
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_tail_alloc(hdr, nsid, lba_size, block_count, meta) -> row_id
  //                                                              | NVMEN_TAIL_*.
  //
  // THE ONLY WRITER of _nvme_namespace_table; tools/build.sh confines
  // it via ec_confine_one.  Gates: hdr in_use pre-set -> BAD_ARG;
  // hdr reserved [55:16] non-zero -> BAD_ARG.  All value gates
  // (nsid/lba_size/block_count) are enforced by the mint walker
  // before we reach here.  attest_key + reserved words scrubbed to 0.
  // meta's [63:32] bits (max_transfer_blocks/dma_domain_slot, R51.M7-001
  // #1669) come in pre-zeroed via the caller's nvme_ns_tail_pack_meta
  // call -- no separate zeroing needed here.
  // Six-callee-save prologue + sub rsp, 8 = 56 bytes; post-prologue
  // rsp%16 == 0 (kept for future nested calls).
  // ==========================================================================
  pub let nvme_ns_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (nsid: u64) (lba_size: u64) (block_count: u64) (meta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): claim one namespace row. THE ONLY WRITER of _nvme_namespace_table; tools/build.sh confines it via ec_confine_one. Gates: hdr in_use pre-set -> BAD_ARG; hdr reserved [55:16] non-zero -> BAD_ARG. Low-first scan over 32 rows of 64 bytes.  Six callee-save pushes + sub rsp,8 = 56 bytes; entry rsp%16==8 -> post-prologue rsp%16 == 0. Labels prefixed nvmen_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // nsid
        mov r14, rdx;                    // lba_size
        mov r15, rcx;                    // block_count
        mov rbp, r8;                     // meta

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne nvmen_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne nvmen_ta_bad;

        xor rbx, rbx;                    // row_id cursor
      nvmen_ta_scan:
        cmp rbx, 32;                     // NVMEN_MAX
        jae nvmen_ta_enospc;

        lea r10, [rip + _nvme_namespace_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  nvmen_ta_claim;

        add rbx, 1;
        jmp nvmen_ta_scan;

      nvmen_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header + in_use
        mov [r10 + 8],  r13;             // nsid
        mov [r10 + 16], r14;             // lba_size
        mov [r10 + 24], r15;             // block_count
        mov [r10 + 32], rbp;             // meta (parent_ctrl_row|family|features)
        xor rax, rax;
        mov [r10 + 40], rax;             // attest_key = 0
        mov [r10 + 48], rax;             // reserved = 0
        mov [r10 + 56], rax;             // reserved = 0
        mov rax, rbx;
        jmp nvmen_ta_out;

      nvmen_ta_enospc:
        mov rax, 0xFFFFEC5F;             // NVMEN_TAIL_ENOSPC
        jmp nvmen_ta_out;
      nvmen_ta_bad:
        mov rax, 0xFFFFEC5E;             // NVMEN_TAIL_BAD_ARG

      nvmen_ta_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let nvme_ns_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): 1 iff row_id < NVMEN_MAX and in_use byte set. Labels prefixed nvmen_tv_.",
      block: {
        cmp rdi, 32;
        jae nvmen_tv_no;
        lea r10, [rip + _nvme_namespace_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  nvmen_tv_no;
        mov rax, 1;
        ret;
      nvmen_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let nvme_ns_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): scrub row (all eight words). Labels prefixed nvmen_tf_.",
      block: {
        cmp rdi, 32;
        jae nvmen_tf_out;
        lea r10, [rip + _nvme_namespace_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      nvmen_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors.  Each returns NVMEN_DECODE_BAD when the row is not
  // live.  Shape mirrors nvme_ctrl_row_* / tty_row_* one-for-one so a
  // regression in one member of the family surfaces the same way in
  // the others.
  // -------------------------------------------------------------------

  pub let nvme_ns_row_nsid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): nsid, or NVMEN_DECODE_BAD. Labels prefixed nvmen_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        je  nvmen_rid_bad;
        lea r10, [rip + _nvme_namespace_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp nvmen_rid_out;
      nvmen_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      nvmen_rid_out:
        pop r12;
        ret
      }
    }

  pub let nvme_ns_row_lba_size : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M2-001 (#1639): lba_size, or NVMEN_DECODE_BAD. Labels prefixed nvmen_rlb_.",
