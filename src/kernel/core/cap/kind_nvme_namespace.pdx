  pub let nvme_ns_row_max_transfer_blocks : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): max_transfer_blocks (meta [+32] bits [47:32], u16), or NVMEN_DECODE_BAD. Zero until M7-003 populates it from MDTS. Labels prefixed nvmen_rmt_.",
      block: {
        push r12;
        mov r12, rdi;
