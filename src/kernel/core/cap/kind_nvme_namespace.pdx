  pub let nvme_ns_row_dma_domain_slot : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): dma_domain_slot (meta [+32] bits [55:48], u8, 0..255 per design/hardware/nvme-and-disk-substrate.md §4.3), or NVMEN_DECODE_BAD. Zero (unscoped) until a driver process scopes this cap to a live KIND_DMA_DOMAIN. Labels prefixed nvmen_rds_.",
      block: {
        push r12;
        mov r12, rdi;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        je  nvmen_rds_bad;
