  // Slot -> row_id, gated on the descriptor being a live
  // KIND_NVME_NAMESPACE.  Kind constant 0x199 staged in r11.
  pub let nvme_ns_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M2-001 (#1639): slot -> row_id gated on KIND_NVME_NAMESPACE. Labels prefixed nvmen_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae nvmen_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x199;                  // KIND_NVME_NAMESPACE
        cmp r10, r11;
        jne nvmen_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        je  nvmen_ros_none;

        mov rax, r12;
        jmp nvmen_ros_out;

      nvmen_ros_none:
        mov rax, 0xFF;                   // NVMEN_ROW_NONE
      nvmen_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_cap_mint_inner(parent_slot, rights, nsid, lba_size,
  //                        block_count, parent_ctrl_row)
  //   -> row_id | NVMEN_MINT_BAD_*
  //
  // R51.M2-001 (#1639) + R51.M2-003 (#1641): the KIND_NVME_NAMESPACE
  // mint walker.  Gates in order:
  //   (1) parent gate (KIND_NVME_CONTROLLER + R_NVMEC_MINT_NS);
  //   (2) rights subset (R_NVMEN_ALL);
  //   (3) nsid_valid;
  //   (4) lba_valid;
  //   (5) blocks_valid;
  //   (6) ctrl_row_valid (parent controller row must be live);
  //   (7) hdr_pack (ns_slot = the row_id we're about to fill, state = MINTED);
  //   (8) meta pack + tail_alloc.
  //
  // Prologue: 6 callee-save pushes + sub rsp, 8 = 56 bytes; entry
  // rsp%16 == 8 -> post-prologue 64, %16 == 0 for every nested call.
  //
  // NOTE ON ns_slot: because we do a scan and don't know row_id until
  // tail_alloc returns, we pack the header with a placeholder ns_slot
  // = 0.  tail_alloc's layout uses only header bits [15:0] for our
  // ns_slot|state fields; the row_id ends up in bits [7:0] via the
  // tail's own scan cursor semantics.  A future "ns_slot != row_id"
  // variant would rewrite tail_alloc to accept a caller-supplied slot;
  // at M2 the invariant "ns_slot == row_id" is enforced by convention.
  // ==========================================================================
  pub let nvme_ns_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (nsid: u64) (lba_size: u64) (block_count: u64) (parent_ctrl_row: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M2-001 (#1639) / R51.M2-003 (#1641): the KIND_NVME_NAMESPACE mint walker. Six argument slots + spill room: four saved on stack ([rsp+0..24], one pad slot at [rsp+32]), two in callee-save registers (r12 = parent_slot, r13 = rights). Prologue: 6 callee-save pushes + sub rsp,40 = 88 bytes. Entry rsp%16==8 -> post-prologue rsp%16 == 0 (48-mod-16 = 0 for the pushes, then +40 mod 16 = +8, net +8 realigns to 0). Bumps NVMEN_ST_MINTS on success, NVMEN_ST_REFUSED on any BAD_* path. Labels prefixed nvmen_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 40;                     // 32 B spill (nsid/lba/blocks/ctrl_row) + 8 B align pad

        mov r12, rdi;                    // r12 = parent_slot
        mov r13, rsi;                    // r13 = rights
        mov [rsp + 0],  rdx;             // nsid
        mov [rsp + 8],  rcx;             // lba_size
        mov [rsp + 16], r8;              // block_count
        mov [rsp + 24], r9;              // parent_ctrl_row

        // (1) Parent gate.
        mov rdi, r12;
        call nvme_ns_check_parent_ctrl;
        cmp rax, 0;
        je  nvmen_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call nvme_ns_rights_valid;
        cmp rax, 0;
        je  nvmen_mi_bad_rights;

        // (3) nsid_valid.
        mov rdi, [rsp + 0];
        call nvme_ns_nsid_valid;
        cmp rax, 0;
        je  nvmen_mi_bad_nsid;

        // (4) lba_valid.
        mov rdi, [rsp + 8];
        call nvme_ns_lba_valid;
        cmp rax, 0;
        je  nvmen_mi_bad_lba;

        // (5) blocks_valid.
        mov rdi, [rsp + 16];
        call nvme_ns_blocks_valid;
        cmp rax, 0;
        je  nvmen_mi_bad_blocks;

        // (6) ctrl_row live.
        mov rdi, [rsp + 24];
        call nvme_ns_ctrl_row_valid;
        cmp rax, 0;
        je  nvmen_mi_bad_ctrl_row;

        // (7) Pack header with ns_slot = 0 placeholder, state = MINTED.
        // tail_alloc lays down the real header; ns_slot is a nominal
        // field surfaced through nvme_ns_row_ns_slot for callers that
        // want a stable per-row identifier separate from row_id.
        xor rdi, rdi;                    // ns_slot = 0
        mov rsi, 1;                      // NVMEN_STATE_MINTED
        call nvme_ns_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  nvmen_mi_bad_nsid;
        mov r14, rax;                    // r14 = hdr

        // (8) Meta pack: (parent_ctrl_row, family=NVME, features=0).
        mov rdi, [rsp + 24];             // parent_ctrl_row
        mov rsi, 1;                      // NVMEN_FAMILY_NVME
        xor rdx, rdx;                    // features = 0 (M2)
        call nvme_ns_tail_pack_meta;
        mov r15, rax;                    // r15 = meta

        // (9) tail_alloc(hdr, nsid, lba, blocks, meta).
        mov rdi, r14;                    // hdr
        mov rsi, [rsp + 0];              // nsid
        mov rdx, [rsp + 8];              // lba_size
        mov rcx, [rsp + 16];             // block_count
        mov r8,  r15;                    // meta
        call nvme_ns_tail_alloc;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae nvmen_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // NVMEN_ST_MINTS
        call nvme_ns_note;
        pop rax;
        jmp nvmen_mi_out;

      nvmen_mi_alloc_fail:
        jmp nvmen_mi_refused;
      nvmen_mi_bad_parent:
        mov rax, 0xFFFFEC5D;             // NVMEN_MINT_BAD_PARENT
        jmp nvmen_mi_refused;
      nvmen_mi_bad_rights:
        mov rax, 0xFFFFEC5C;             // NVMEN_MINT_BAD_RIGHTS
        jmp nvmen_mi_refused;
      nvmen_mi_bad_nsid:
        mov rax, 0xFFFFEC5B;             // NVMEN_MINT_BAD_NSID
        jmp nvmen_mi_refused;
      nvmen_mi_bad_lba:
        mov rax, 0xFFFFEC5A;             // NVMEN_MINT_BAD_LBA
        jmp nvmen_mi_refused;
      nvmen_mi_bad_blocks:
        mov rax, 0xFFFFEC59;             // NVMEN_MINT_BAD_BLOCKS
        jmp nvmen_mi_refused;
      nvmen_mi_bad_ctrl_row:
        mov rax, 0xFFFFEC55;             // NVMEN_MINT_BAD_CTRL_ROW

      nvmen_mi_refused:
        push rax;
        mov rdi, 3;                      // NVMEN_ST_REFUSED
        call nvme_ns_note;
        pop rax;

      nvmen_mi_out:
        add rsp, 40;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_cascade_revoke_blkdev(ns_row_id) -> u64
  //
  // R51.M2-005 (#1643): walk cap_table for KIND_BLKDEV descriptors
  // whose target_ptr[15:0] == ns_row_id, and scrub each in place.
  // Distinct from the KIND_NVME_NAMESPACE parent scrub (which the
  // caller performs) -- this ONLY zeros the dual-kind KIND_BLKDEV
  // children.
  //
  // Returns the count of KIND_BLKDEV children scrubbed.  Registers:
  //   rbx = slot cursor, r12 = target ns_row_id, r13 = count, rax/r10/r11
  //   = scratch. Four callee-save pushes leave rsp%16 == 0.
  //
  // Uses cap_mint_write(slot, 0, 0, 0) to scrub -- same shape as the
  // R30-PREP witness's nvmecw_clear loop and consistent with the
  // hw_msix cascade's use of the public cap_revoke path.
  // ==========================================================================
  pub let nvme_ns_cascade_revoke_blkdev : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ns_row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M2-005 (#1643): cascade-revoke KIND_BLKDEV dual-kind children of a KIND_NVME_NAMESPACE row.  Iterate slot in 0..256; load descriptor kind at cap_table + slot*24; skip if != KIND_BLKDEV_TAG (0x42). Extract target_ptr[15:0]; if it matches ns_row_id, scrub the descriptor via cap_mint_write(slot, 0, 0, 0) and increment the count. Preserves the ns_row_id in r12 and the count in r13 across every nested call. Cap_table stride 24 bytes. Kind constant 0x42 fits imm32; staged in r11. Four callee-save pushes leave rsp%16 == 0. Labels prefixed nvmen_cr_. R51.M8-004 (#1678) FIX: added a family disambiguation check (target_ptr[23:16] != AHCIP_FAMILY_AHCI(2)), mirroring ahci_port_cascade_revoke_blkdev's own check (kind_ahci_port.pdx) which this function never got when the family byte was introduced at R51.M5-006/#1662 -- without it, a row_id collision between the independent _nvme_namespace_table and _ahci_port_table (both allocate row 0 first, low-first scan) caused an NVMe namespace revoke to also scrub an unrelated AHCI-family KIND_BLKDEV cap sharing the same row_id, an orphan-inducing cross-family cascade bug the M8-004 soak witness (tests/kernel/nvme/bdev_cross_family_soak_synth.pdx) surfaced on its very first iteration.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        and r12, 0xFFFF;                 // target ns_row_id (u16)
        xor r13, r13;                    // count
        xor rbx, rbx;                    // slot cursor

      nvmen_cr_loop:
        cmp rbx, 256;
        jae nvmen_cr_done;

        mov rax, cap_table;
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r14, rax;                    // r14 = desc addr

        mov r10, [r14 + 0];
        mov r11, 0x42;                   // KIND_BLKDEV_TAG
        cmp r10, r11;
        jne nvmen_cr_skip;

        mov r10, [r14 + 16];
        and r10, 0xFFFF;
        cmp r10, r12;
        jne nvmen_cr_skip;

        // R51.M8-004 (#1678) FIX: family disambiguation -- skip any
        // KIND_BLKDEV descriptor whose family byte (target_ptr[23:16])
        // is AHCIP_FAMILY_AHCI (2). Without this, a row_id collision
        // against the independent _ahci_port_table (both tables
        // allocate row 0 first) causes this NVMe-side cascade to also
        // scrub an unrelated AHCI-family cap. Mirrors
        // ahci_port_cascade_revoke_blkdev's own family check.
        mov r10, [r14 + 16];
        shr r10, 16;
        and r10, 0xFF;
        cmp r10, 2;                      // AHCIP_FAMILY_AHCI
        je  nvmen_cr_skip;

        // Match: scrub descriptor.
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add r13, 1;

      nvmen_cr_skip:
        add rbx, 1;
        jmp nvmen_cr_loop;

      nvmen_cr_done:
        mov rdi, 6;                      // NVMEN_ST_CASCADES
        call nvme_ns_note;
        mov rax, r13;

        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_cap_revoke(row_id) -> u64
  //
  // R51.M2-005 (#1643): the KIND_NVME_NAMESPACE revoke.  Calls the
  // cascade first (so no dual-kind KIND_BLKDEV child outlives its
  // KIND_NVME_NAMESPACE parent), then scrubs the row and bumps
  // REVOKES.  Distinguishes never-existed (BAD_SLOT) from already-gone
  // (REVOKE_ALREADY).
  // ==========================================================================
  pub let nvme_ns_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M2-005 (#1643): scrub row + cascade to KIND_BLKDEV. Bumps REVOKES on success, distinguishes BAD_SLOT vs REVOKE_ALREADY vs OK. Cascade runs BEFORE tail_free so the KIND_BLKDEV walker can still resolve ns_row_id -> our row via the cap_table (cap_mint_write above scrubs the KIND_BLKDEV descriptors themselves; our row still lives until tail_free below). Two callee-save pushes leave rsp%16 == 0. Labels prefixed nvmen_rv_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 32;
        jae nvmen_rv_bad_slot;

        mov rdi, r12;
        call nvme_ns_tail_valid;
        cmp rax, 0;
        je  nvmen_rv_already;

        // Cascade first: scrub every KIND_BLKDEV whose target_ptr[15:0]
        // names this row.
        mov rdi, r12;
        call nvme_ns_cascade_revoke_blkdev;

        // Now scrub our own row.
        mov rdi, r12;
        call nvme_ns_tail_free;
        mov rdi, 1;                      // NVMEN_ST_REVOKES
        call nvme_ns_note;
        xor rax, rax;
        jmp nvmen_rv_out;

      nvmen_rv_bad_slot:
        mov rax, 0xFFFFEC58;             // NVMEN_BAD_SLOT
        jmp nvmen_rv_out;
      nvmen_rv_already:
        mov rax, 0xFFFFEC56;             // NVMEN_REVOKE_ALREADY

      nvmen_rv_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_cascade_revoke_by_ctrl(ctrl_row_id) -> u64
  //
  // R51.M2-005 (#1643): iterate _nvme_namespace_table for rows whose
  // parent_ctrl_row matches, and call nvme_ns_cap_revoke on each.
  // Used from the KIND_NVME_CONTROLLER revoke path (M1's M2-hook
  // comment) so tearing down a controller-cap cascades one level
  // deeper than M1 alone did.
  //
  // Returns the count of namespace rows revoked.  Register plan:
  //   rbx = row cursor, r12 = target ctrl_row_id, r13 = count.
  //   Four callee-save pushes leave rsp%16 == 0 for the nested
  //   nvme_ns_cap_revoke calls.
  // ==========================================================================
  pub let nvme_ns_cascade_revoke_by_ctrl : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M2-005 (#1643): walk _nvme_namespace_table for rows whose parent_ctrl_row matches, and revoke each (which itself cascades to KIND_BLKDEV children). Preserves ctrl_row_id in r12 and count in r13 across the inner revoke call. Bounds-checked; a row with in_use == 0 is skipped without touching. Four callee-save pushes leave rsp%16 == 0. Labels prefixed nvmen_cc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        and r12, 0xFFFF;                 // target ctrl_row
        xor r13, r13;                    // count
        xor rbx, rbx;                    // cursor

      nvmen_cc_loop:
        cmp rbx, 32;                     // NVMEN_MAX
        jae nvmen_cc_done;

        lea r10, [rip + _nvme_namespace_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        // Skip free rows (in_use == 0).
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  nvmen_cc_skip;

        // Compare parent_ctrl_row.
        mov rax, [r10 + 32];
        and rax, 0xFFFF;
        cmp rax, r12;
        jne nvmen_cc_skip;

        // Match: revoke this namespace (which cascades further to
        // KIND_BLKDEV children).
        mov rdi, rbx;
        call nvme_ns_cap_revoke;
        add r13, 1;

      nvmen_cc_skip:
        add rbx, 1;
        jmp nvmen_cc_loop;

      nvmen_cc_done:
        mov rax, r13;

        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_dual_kind_mint(ns_slot, blk_slot, parent_slot, ns_rights,
  //                        blk_rights, params_ptr)
  //   -> row_id | error sentinel
  //
  // R51.M2-004 (#1642): the dual-kind mint.  Sequence:
  //   (1) Refuse identical slots (a caller confusion).
  //   (2) Validate blk_rights against R_BLK_ALL_TAG.
  //   (3) Call nvme_ns_cap_mint_inner to allocate the shared row +
  //       enforce every value gate + rights subset for the namespace.
  //   (4) Write the KIND_NVME_NAMESPACE descriptor at ns_slot with
  //       target_ptr = row_id (bits [15:0]; upper bits zero).
  //   (5) Write the KIND_BLKDEV descriptor at blk_slot via
  //       blkdev_cap.pdx's blkdev_cap_mint_nvme(blk_slot, blk_rights,
  //       row_id) (R51.M7-003/#1671), which stamps target_ptr = row_id
  //       (bits [15:0]) OR (1 << 16) (family = BLK_CAP_FAMILY_NVME in
  //       bits [23:16]) so cap_invoke_dispatch on either kind lands at
  //       the SAME row AND cap_handler_blkdev's family demux routes it
  //       to the NVMe branch. Previously stamped target_ptr = row_id
  //       with no family bits at all -- the DESIGN-DOC GAP #1669's
  //       debugger flagged.
  //   (6) Bump DUAL_MINTS.
  //
  // params_ptr (arg 6, r9): pointer to a caller-owned 32-byte / 4-u64
  // block laid out as { nsid, lba_size, block_count, parent_ctrl_row }
  // at offsets 0/8/16/24.  P0276 fixup: this function's natural arity
  // is 9 primitive u64s, but paideia-as caps lambda arity at 6 SysV-
  // register args, so the trailing four value args are packed behind
  // one pointer instead.  See paideia-as issue "P0276 lambda arity cap
  // prevents >6-arg System-V ABI signatures" for the upstream
  // language-level gap (stack-spill for register overflow past 6
  // args). Callers build the block on their own stack (sub rsp, 32;
  // four stores; pass rsp) and tear it down after the call (add rsp,
  // 32); the callee only reads it and never retains the pointer past
  // this call.
  //
  // The dual-kind property is expressed structurally: the row lives in
  // _nvme_namespace_table and is reachable through either descriptor
  // by looking up target_ptr[15:0].  A future KIND_BLKDEV dispatch
  // handler (R51.M3) reads the same row shape via
  // nvme_ns_row_{nsid,lba_size,block_count,family}.
  //
  // Register plan: ns_slot/blk_slot/parent_slot/ns_rights/blk_rights/
  // params_ptr land in r12/r13/r14/r15/rbp/rbx respectively -- six
  // callee-save pushes, no stack spill needed (the 4-u64 block lives
  // in the CALLER's frame, not ours).  Prologue: 48 B pushes + sub
  // rsp,8 (align pad) = 56 bytes; entry rsp%16 == 8 -> post-prologue
  // rsp%16 == 0.
  // ==========================================================================
  pub let nvme_ns_dual_kind_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ns_slot: u64) (blk_slot: u64) (parent_slot: u64) (ns_rights: u64) (blk_rights: u64) (params_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M2-004 (#1642) + P0276 fixup + R51.M7-003 (#1671): dual-kind mint. Allocates one _nvme_namespace_table row via nvme_ns_cap_mint_inner, then stamps two descriptors: KIND_NVME_NAMESPACE at ns_slot via cap_mint_write directly, and KIND_BLKDEV at blk_slot via the shared blkdev_cap_mint_nvme helper (blkdev_cap.pdx, #1671), which stamps target_ptr = row_id | (BLK_CAP_FAMILY_NVME(1) << 16) -- factored out of this function at #1671 to fix the DESIGN-DOC GAP #1669's debugger flagged (this call previously stamped target_ptr = row_id with no family bits at all, an implicit family = 0 = LEGACY_NVME instead of the intended 1 = NVME) and to share the family-tag OR-in logic with ahci_port_dual_kind_mint's own blkdev_cap_mint_ahci call. Refuses ns_slot == blk_slot (NVMEN_DUAL_BAD_SLOTS), a blk_rights outside R_BLK_ALL_TAG (NVMEN_MINT_BAD_BLK_RIGHTS), and cascades every underlying nvme_ns_cap_mint_inner refusal. Reduced from 9 to 6 primitive args (paideia-as P0276: lambda arity capped at 6 SysV-register args) by packing nsid/lba_size/block_count/parent_ctrl_row behind params_ptr, a caller-owned 4-u64 stack block read-only for the duration of this call. Six callee-save pushes (ns_slot=r12, blk_slot=r13, parent_slot=r14, ns_rights=r15, blk_rights=rbp, params_ptr=rbx) + sub rsp,8 pad = 56 bytes; entry rsp%16 == 8 -> post-prologue %16 == 0 for every nested call. Bumps NVMEN_ST_DUAL_MINTS on success. Labels prefixed nvmen_dk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // ns_slot
        mov r13, rsi;                    // blk_slot
        mov r14, rdx;                    // parent_slot
        mov r15, rcx;                    // ns_rights
        mov rbp, r8;                     // blk_rights
        mov rbx, r9;                     // params_ptr

        // (1) Refuse identical slots.
        cmp r12, r13;
        je  nvmen_dk_bad_slots;

        // (2) blk_rights subset test.
        mov rdi, rbp;
        call nvme_ns_blk_rights_valid;
        cmp rax, 0;
        je  nvmen_dk_bad_blk_rights;

        // (3) Allocate the row via the namespace mint.  This is where
        // every value gate lives; we do NOT duplicate them here.
        mov rdi, r14;                    // parent_slot
        mov rsi, r15;                    // ns_rights
        mov rdx, [rbx + 0];              // nsid
        mov rcx, [rbx + 8];              // lba_size
        mov r8,  [rbx + 16];             // block_count
        mov r9,  [rbx + 24];             // parent_ctrl_row
        call nvme_ns_cap_mint_inner;
        mov r10, 32;                     // NVMEN_MAX
        cmp rax, r10;
        jae nvmen_dk_inner_fail;
        mov rbx, rax;                    // rbx = row_id (params_ptr no longer needed)

        // (4) Stamp KIND_NVME_NAMESPACE descriptor.
        mov rdi, r12;                    // slot
        mov rsi, 0x199;                  // KIND_NVME_NAMESPACE
        mov rdx, r15;                    // rights
        mov rcx, rbx;                    // target_ptr = row_id (bits [15:0])
        call cap_mint_write;

        // (5) Stamp KIND_BLKDEV descriptor with family = NVME (1) in
        // bits [23:16] via the shared blkdev_cap_mint_nvme helper
        // (R51.M7-003, #1671). Previously stamped target_ptr = row_id
        // directly here with no family bits at all (implicit family =
        // 0 = LEGACY_NVME instead of the intended 1 = NVME) -- the
        // DESIGN-DOC GAP #1669's debugger flagged.
        mov rdi, r13;                    // slot
        mov rsi, rbp;                    // rights
        mov rdx, rbx;                    // row_id
        call blkdev_cap_mint_nvme;

        // (6) Bump DUAL_MINTS + return row_id.
        mov rdi, 5;                      // NVMEN_ST_DUAL_MINTS
        call nvme_ns_note;
        mov rax, rbx;
        jmp nvmen_dk_out;

      nvmen_dk_bad_slots:
        mov rax, 0xFFFFEC53;             // NVMEN_DUAL_BAD_SLOTS
        jmp nvmen_dk_refused;
      nvmen_dk_bad_blk_rights:
        mov rax, 0xFFFFEC52;             // NVMEN_MINT_BAD_BLK_RIGHTS
        jmp nvmen_dk_refused;
      nvmen_dk_inner_fail:
        // rax already carries the inner sentinel; the inner mint
        // walker (nvme_ns_cap_mint_inner) already bumped
        // NVMEN_ST_REFUSED so skip our note to avoid double-counting.
        jmp nvmen_dk_out;

      nvmen_dk_refused:
        push rax;
        mov rdi, 3;                      // NVMEN_ST_REFUSED
        call nvme_ns_note;
        pop rax;

      nvmen_dk_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvme_ns_enumerate(parent_slot, parent_ctrl_row, ns_rights) -> u64
  //
  // R51.M2-002 (#1640) + R51.M2-003 (#1641): namespace enumeration.
  //   1. Read bar0 + admin_ctx from the parent controller row.
  //   2. Submit IDENTIFY(CNS=0x02) via nvme_ns_list -- populates
  //      _nvme_active_nsids[0..count].
  //   3. For each active NSID: submit IDENTIFY(CNS=0x00) via
  //      nvme_identify_ns -- populates _nvme_lba_size + _nvme_ns_blocks
  //      as side effects.
  //   4. For each: call nvme_ns_cap_mint_inner to allocate one row.
  //   5. Return count minted.  Bumps NVMEN_ST_ENUMS on success.
  //
  // Under BIOS/-kernel boot no controller exists, so callers pass a
  // synthetic parent_ctrl_row and this walker exercises the drain-
  // empty signature (nvme_ns_list finds no NSIDs, count = 0).
  // Wire-through-to-hardware lands at R51.M3+ under UEFI/OVMF.
  //
  // Register plan (5-push callee-save + 8 B pad):
  //   rbx = parent_slot, r12 = parent_ctrl_row, r13 = ns_rights,
  //   r14 = mint counter, r15 = active-nsid cursor.
  //   Five pushes + sub rsp,8 = 48 bytes; post-prologue rsp%16 == 0.
  //
  // Refuses (returns NVMEN_ENUM_FAILED) if the controller row is not
  // live OR the parent gate fails; every per-NSID mint failure is
  // silently skipped so a partial failure doesn't dead-stop the walker.
  // ==========================================================================
  pub let nvme_ns_enumerate : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot, cap} =
    fn (parent_slot: u64) (parent_ctrl_row: u64) (ns_rights: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "R51.M2-002 (#1640) + R51.M2-003 (#1641): namespace enumeration orchestrator. Reads bar0 + admin_ctx from the parent controller row via nvme_ctrl_row_bar0 / nvme_ctrl_row_admin_ctx; calls nvme_ns_list to populate _nvme_active_nsids; iterates NSIDs and calls nvme_identify_ns per NSID; parses _nvme_lba_size + _nvme_ns_blocks; calls nvme_ns_cap_mint_inner to allocate rows. Under BIOS/-kernel boot no controller exists, so callers hand a synthetic parent_ctrl_row and this drains empty (no NSIDs). Wire-through lands at R51.M3 under UEFI. Prologue: 5 callee-save pushes = 40 bytes; entry rsp%16 == 8 -> post-prologue rsp%16 == 0. All inner calls preserve alignment via explicit `sub rsp,8` pads around any single-word push (spill area at [rsp+0..15] carries the per-iteration nsid and bar0 across nested calls). Bumps NVMEN_ST_ENUMS on success. Labels prefixed nvmen_en_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                     // 16 B spill area, keeps rsp%16==0

        mov rbx, rdi;                    // parent_slot
        mov r12, rsi;                    // parent_ctrl_row
        mov r13, rdx;                    // ns_rights

        // Parent gate.
        mov rdi, rbx;
        call nvme_ns_check_parent_ctrl;
        cmp rax, 0;
        je  nvmen_en_fail;

        // Controller row live?
        mov rdi, r12;
        call nvme_ns_ctrl_row_valid;
        cmp rax, 0;
        je  nvmen_en_fail;

        // Read bar0 + admin_ctx from the controller row.
        mov rdi, r12;
        call nvme_ctrl_row_bar0;
        mov [rsp + 0], rax;              // spill bar0

        mov rdi, r12;
        call nvme_ctrl_row_admin_ctx;
        // rax = admin_ctx_pa; if 0, controller hasn't been brought up.
        // Under BIOS boot this is expected; nvme_ns_list would fault on
        // an unbrought-up controller, so short-circuit to drain-empty.
        cmp rax, 0;
        je  nvmen_en_drain_empty;

        // nvme_ns_list(bar0, ctx, &_nvme_ns_list_buf).
        mov rdi, [rsp + 0];              // bar0
        mov rsi, rax;                    // ctx
        lea rdx, [rip + _nvme_ns_list_buf];
        call nvme_ns_list;
        // Ignore returned status: nvme_ns_list publishes count into
        // _nvme_active_nsid_count regardless.

      nvmen_en_drain_empty:
        xor r14, r14;                    // r14 = minted count
        xor r15, r15;                    // r15 = cursor

      nvmen_en_loop:
        // Bound: cursor < _nvme_active_nsid_count AND < NVMEN_MAX.
        mov rax, [rip + _nvme_active_nsid_count];
        cmp r15, rax;
        jae nvmen_en_done;
        mov r10, 32;                     // NVMEN_MAX
        cmp r15, r10;
        jae nvmen_en_done;

        // Load nsid = _nvme_active_nsids[r15] (u32 slot); spill it.
        lea rax, [rip + _nvme_active_nsids];
        mov r8, r15;
        shl r8, 2;                       // *4 (u32 stride)
        add rax, r8;
        xor rcx, rcx;
        mov_d rcx, [rax];                // nsid
        mov [rsp + 8], rcx;              // spill nsid

        // Refresh bar0 + admin_ctx (fields may change if a supervisor
        // resets the controller between iterations).
        mov rdi, r12;
        call nvme_ctrl_row_bar0;
        mov [rsp + 0], rax;              // re-spill bar0
        mov rdi, r12;
        call nvme_ctrl_row_admin_ctx;
        // rax = ctx.  If ctx == 0 (synthetic / not brought up), skip
        // the wire submit; we STILL mint using _nvme_lba_size /
        // _nvme_ns_blocks the caller may have seeded.
        cmp rax, 0;
        je  nvmen_en_mint;

        // nvme_identify_ns(bar0, ctx, nsid, &_nvme_id_ns_buf).
        mov rdi, [rsp + 0];              // bar0
        mov rsi, rax;                    // ctx
        mov rdx, [rsp + 8];              // nsid
        lea rcx, [rip + _nvme_id_ns_buf];
        call nvme_identify_ns;
        // Side effect: populates _nvme_lba_size + _nvme_ns_blocks.

      nvmen_en_mint:
        // Read the discovered geometry.
        mov rax, [rip + _nvme_lba_size];
        mov r10, [rip + _nvme_ns_blocks];

        // Skip mint if geometry is degenerate (defensive; shouldn't
        // happen under a live identify).
        cmp rax, 0;
        je  nvmen_en_next;
        cmp r10, 0;
        je  nvmen_en_next;

        // nvme_ns_cap_mint_inner(parent_slot, ns_rights, nsid,
        //                        lba_size, block_count, parent_ctrl_row).
        // Six args: all in SysV regs (rdi/rsi/rdx/rcx/r8/r9).  No
        // stack args -> no alignment perturbation for the call.
        mov rdi, rbx;                    // parent_slot
        mov rsi, r13;                    // ns_rights
        mov rdx, [rsp + 8];              // nsid
        mov rcx, rax;                    // lba_size
        mov r8,  r10;                    // block_count
        mov r9,  r12;                    // parent_ctrl_row
        call nvme_ns_cap_mint_inner;

        // Success iff rax < NVMEN_MAX.
        mov r10, 32;
        cmp rax, r10;
        jae nvmen_en_next;
        add r14, 1;                      // one more minted

      nvmen_en_next:
        add r15, 1;
        jmp nvmen_en_loop;

      nvmen_en_done:
        mov rdi, 4;                      // NVMEN_ST_ENUMS
        call nvme_ns_note;
        mov rax, r14;
        jmp nvmen_en_out;

      nvmen_en_fail:
        mov rax, 0xFFFFEC54;             // NVMEN_ENUM_FAILED

      nvmen_en_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_nvme_namespace(rights, target_ptr, op_arg) -> u64
  //
  // KIND_NVME_NAMESPACE dispatch.  All ops arity-ONE
  // (op_arg[63:8] REFUSED).  QUERY ops need R_NVMEN_INVOKE (0x008);
  // DEBUG_PRINT needs R_NVMEN_OBSERVE (0x400).
  //
  //   NVMEN_OP_QUERY_NSID        -> nsid
  //   NVMEN_OP_QUERY_LBA_SIZE    -> lba_size
  //   NVMEN_OP_QUERY_BLOCK_COUNT -> block_count
  //   NVMEN_OP_QUERY_PARENT      -> parent_ctrl_row
  //   NVMEN_OP_QUERY_FAMILY      -> family byte
  //   NVMEN_OP_QUERY_STATE       -> state byte
  //   NVMEN_OP_QUERY_NS_SLOT     -> ns_slot byte
  //   NVMEN_OP_DEBUG_PRINT       -> 0
  // ==========================================================================
  pub let cap_handler_nvme_namespace : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M2-001 (#1639): KIND_NVME_NAMESPACE dispatch. QUERY ops need R_NVMEN_INVOKE; DEBUG_PRINT needs R_NVMEN_OBSERVE. op_arg[63:8] refused. Five callee-save pushes leave rsp%16 == 0. Labels prefixed nvmen_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id (low 16)
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne nvmen_hn_res;                // reserved bits set

        cmp rbp, 7;                      // NVMEN_OP_MAX
        ja  nvmen_hn_unsup;

        cmp rbp, 7;                      // DEBUG_PRINT
        je  nvmen_hn_dbg;

        // Ops 0..6 need R_NVMEN_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  nvmen_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  nvmen_hn_nsid;
        cmp rbp, 1;
        je  nvmen_hn_lba;
        cmp rbp, 2;
        je  nvmen_hn_bc;
        cmp rbp, 3;
        je  nvmen_hn_parent;
        cmp rbp, 4;
        je  nvmen_hn_family;
        cmp rbp, 5;
        je  nvmen_hn_state;
        // rbp == 6 (NS_SLOT)
        call nvme_ns_row_ns_slot;
        jmp nvmen_hn_count;

      nvmen_hn_nsid:
        call nvme_ns_row_nsid;
        jmp nvmen_hn_count;
      nvmen_hn_lba:
        call nvme_ns_row_lba_size;
        jmp nvmen_hn_count;
      nvmen_hn_bc:
        call nvme_ns_row_block_count;
        jmp nvmen_hn_count;
      nvmen_hn_parent:
        call nvme_ns_row_parent;
        jmp nvmen_hn_count;
      nvmen_hn_family:
        call nvme_ns_row_family;
        jmp nvmen_hn_count;
      nvmen_hn_state:
        call nvme_ns_row_state;
        jmp nvmen_hn_count;

      nvmen_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  nvmen_hn_denied;
        xor rax, rax;
        jmp nvmen_hn_out;

      nvmen_hn_count:
        push rax;
        mov rdi, 2;                      // NVMEN_ST_QUERIES
        call nvme_ns_note;
        pop rax;
        jmp nvmen_hn_out;

      nvmen_hn_res:
        mov rax, 0xFFFFEC5E;             // NVMEN_TAIL_BAD_ARG
        jmp nvmen_hn_out;
      nvmen_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp nvmen_hn_out;
      nvmen_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      nvmen_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
