// src/kernel/core/cap/cap_handler_tui_canvas.pdx — R89.M1-002 (#1989).
//
// KIND_TUI_CANVAS ops dispatch. Design authority: design/kernel/
// kind-tui-canvas.md §Ops. Row + mint gate landed at R89.M1-001
// (kind_tui_canvas.pdx, #1988); this file is the cap_invoke-reachable
// handler that gate consumes nothing from directly but the row pool
// it maintains.
//
// Mirrors cap_handler_tty (kind_tty.pdx) one-for-one: same three-u64
// ABI, same "mask target_ptr to a row id, dispatch on op, check a
// rights bit per op" shape. target_ptr[15:0] is the canvas row id per
// the same cap-descriptor convention cap_handler_tty's target_ptr
// uses; op_arg IS the op ordinal directly (no sub-fields — the design
// doc's op table takes no operand on any of the eight ops).
//
// R89.M1-002 (#1989) wired all eight ops; PRESENT (0) / RESIZE (5) /
// CLEAR (6) were STUBS returning 0 on a rights-checked, row-valid
// call. R89.M1-003 (#1990, this landing) makes PRESENT (0) real,
// dispatching into tui_present_body (core/tui/canvas_present.pdx);
// RESIZE (5) / CLEAR (6) remain stubs, their real bodies landing at
// R89.M1-004 (canvas_damage.pdx). QUERY_ROWS/QUERY_COLS/QUERY_ID/
// QUERY_TTY_ID/DEBUG_PRINT are real.
//
// Row validity is checked ONCE, before op dispatch, via
// tui_canvas_row_valid (kind_tui_canvas.pdx) — a dead or out-of-range
// row refuses every op with TUI_BAD_SLOT before any rights check
// runs. An unrecognized op ordinal also falls through to TUI_BAD_SLOT
// (the design doc names only TUI_BAD_SLOT/TUI_BAD_RIGHTS as this
// handler's own failure surface — the other TUI_* sentinels belong to
// mint/revoke, not dispatch).
//
// Wiring: cap/invoke.pdx's cap_invoke_dispatch cascade gains a
// KIND_TUI_CANVAS (0x1A6) arm — `mov r9, 0x1A6; cmp rcx, r9; je
// call_kind_tui_canvas` — alongside a `call_kind_tui_canvas: call
// cap_handler_tui_canvas; ret` landing pad, following the exact
// KIND_PDXFS_MOUNT_TABLE (0x1A5) precedent immediately above it.
//
// Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave
// rsp%16==0 for every nested call (entry rsp%16==8, -24 -> %16==0).
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `tuih_`.

module CapHandlerTuiCanvas = structure {

  pub let tuih_dbg_msg : [u8; 56] = "tui canvas debug print [legacy: TUI CANVAS DEBUG PRINT]\0"
  pub let tuih_k_slot  : [u8; 5]  = "slot\0"

  // cap_handler_tui_canvas(rights, target_ptr, op_arg) -> u64
  //
  // rights bits (kind_tui_canvas.pdx): R_TUI_PRESENT 0x002,
  // R_TUI_INVOKE 0x008, R_TUI_RESIZE 0x010, R_TUI_OBSERVE 0x400.
  //   op 0 PRESENT        R_TUI_PRESENT  -> tui_present_body(row_id) (R89.M1-003)
  //   op 1 QUERY_ROWS     R_TUI_INVOKE   -> rows (row+32[63:32])
  //   op 2 QUERY_COLS     R_TUI_INVOKE   -> cols (row+32[31:0])
  //   op 3 QUERY_ID       R_TUI_INVOKE   -> canvas_id (row+8)
  //   op 4 QUERY_TTY_ID   R_TUI_INVOKE   -> tty_row_id(row+24 tty_slot)
  //   op 5 RESIZE         R_TUI_RESIZE   -> 0 (stub, R89.M1-004)
  //   op 6 CLEAR          R_TUI_RESIZE   -> 0 (stub, R89.M1-004)
  //   op 7 DEBUG_PRINT    R_TUI_OBSERVE  -> klog_s1_x1 slot=row_id, 0
  //   else                               -> TUI_BAD_SLOT
  pub let cap_handler_tui_canvas : (u64, u64, u64) -> u64 !{mem, sysreg, PortIo} @{cap, paideia.port_io} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg, PortIo}, capabilities: {cap, paideia.port_io},
      justification: "R89.M1-002 (#1989) + R89.M1-003 (#1990): KIND_TUI_CANVAS ops dispatch, mirrors cap_handler_tty (kind_tty.pdx) one-for-one. row_id = target_ptr[15:0]; op = op_arg (no sub-fields, per design doc's no-operand op table). Row validity (tui_canvas_row_valid) is checked once before dispatch -- dead/out-of-range row or unrecognized op both fall to TUI_BAD_SLOT. PRESENT (#1990) dispatches into tui_present_body (core/tui/canvas_present.pdx), which resolves the row's memory_slot/tty_slot, diffs back vs. front buffer, and emits ANSI bytes; RESIZE/CLEAR remain rights-checked stubs returning 0 (real bodies land R89.M1-004); QUERY_ROWS/COLS/ID read the row directly via tui_canvas_slot; QUERY_TTY_ID forwards tty_slot into tty_row_id (kind_tty.pdx); DEBUG_PRINT emits klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, tuih_dbg_msg, tuih_k_slot, row_id). Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave rsp%16==0 at every nested call (entry rsp%16==8, -24 -> 0), including the new tui_present_body call, which needs no extra padding at this same depth. Effects/capabilities widened to {mem,sysreg,PortIo}/{cap,paideia.port_io}: tui_present_body transitively reaches uart_putc (core/tui/canvas_present.pdx's tui_emit_byte), which requires PortIo/paideia.port_io -- this function's own row must be a superset per this tree's effect-widening discipline. Labels prefixed tuih_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op

        mov rdi, r12;
        call tui_canvas_row_valid;
        cmp rax, 0;
        je  tuih_bad_slot;

        cmp r13, 0;
        je  tuih_op_present;
        cmp r13, 1;
        je  tuih_op_qrows;
        cmp r13, 2;
        je  tuih_op_qcols;
        cmp r13, 3;
        je  tuih_op_qid;
        cmp r13, 4;
        je  tuih_op_qttyid;
        cmp r13, 5;
        je  tuih_op_resize;
        cmp r13, 6;
        je  tuih_op_clear;
        cmp r13, 7;
        je  tuih_op_dbg;
        jmp tuih_bad_slot;

      tuih_op_present:
        mov r10, rbx;
        and r10, 0x002;                  // R_TUI_PRESENT
        cmp r10, 0;
        je  tuih_bad_rights;
        mov rdi, r12;                    // row_id
        call tui_present_body;           // R89.M1-003 (#1990): real body
        jmp tuih_out;

      tuih_op_qrows:
        mov r10, rbx;
        and r10, 0x008;                  // R_TUI_INVOKE
        cmp r10, 0;
        je  tuih_bad_rights;
        mov rdi, r12;
        call tui_canvas_slot;
        mov rax, [rax + 32];
        shr rax, 32;                     // rows[63:32]
        jmp tuih_out;

      tuih_op_qcols:
        mov r10, rbx;
        and r10, 0x008;                  // R_TUI_INVOKE
        cmp r10, 0;
        je  tuih_bad_rights;
        mov rdi, r12;
        call tui_canvas_slot;
        mov rax, [rax + 32];
        mov r10, 0xFFFFFFFF;
        and rax, r10;                    // cols[31:0]
        jmp tuih_out;

      tuih_op_qid:
        mov r10, rbx;
        and r10, 0x008;                  // R_TUI_INVOKE
        cmp r10, 0;
        je  tuih_bad_rights;
        mov rdi, r12;
        call tui_canvas_slot;
        mov rax, [rax + 8];              // canvas_id
        jmp tuih_out;

      tuih_op_qttyid:
        mov r10, rbx;
        and r10, 0x008;                  // R_TUI_INVOKE
        cmp r10, 0;
        je  tuih_bad_rights;
        mov rdi, r12;
        call tui_canvas_slot;
        mov r10, [rax + 24];             // tty_slot
        mov rdi, r10;
        call tty_row_id;
        jmp tuih_out;

      tuih_op_resize:
        mov r10, rbx;
        and r10, 0x010;                  // R_TUI_RESIZE
        cmp r10, 0;
        je  tuih_bad_rights;
        xor rax, rax;                    // stub: real body at R89.M1-004
        jmp tuih_out;

      tuih_op_clear:
        mov r10, rbx;
        and r10, 0x010;                  // R_TUI_RESIZE
        cmp r10, 0;
        je  tuih_bad_rights;
        xor rax, rax;                    // stub: real body at R89.M1-004
        jmp tuih_out;

      tuih_op_dbg:
        mov r10, rbx;
        and r10, 0x400;                  // R_TUI_OBSERVE
        cmp r10, 0;
        je  tuih_bad_rights;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tuih_dbg_msg];
        lea rcx, [rip + tuih_k_slot];
        mov r8, r12;                     // row_id
        call klog_s1_x1;
        xor rax, rax;
        jmp tuih_out;

      tuih_bad_slot:
        // R89.M1-004 (#1991): deliberately does NOT bump
        // _tui_stats.refused. kind_tty.pdx's own dispatch handler
        // (cap_handler_tty) never bumps TTY_ST_REFUSED from its
        // analogous deny arms (tty_hn_denied/tty_hn_unsup/tty_hn_res)
        // — that counter is scoped to MINT refusals only, in both
        // kinds. See kind_tui_canvas.pdx's tui_stats_bump_refused for
        // the full cross-reference.
        mov rax, 0xFFFFEB1A;             // TUI_BAD_SLOT
        jmp tuih_out;
      tuih_bad_rights:
        // R89.M1-004 (#1991): same non-bump rationale as tuih_bad_slot
        // above — this covers PRESENT's own rights-denied path too.
        mov rax, 0xFFFFEB19;             // TUI_BAD_RIGHTS

      tuih_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
