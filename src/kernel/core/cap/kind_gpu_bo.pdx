// src/kernel/core/cap/kind_gpu_bo.pdx — R37.M3-001 (#1262)
//
// KIND_GPU_BO = 0x174, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// One GPU Buffer Object (BO): a bo_key identifying the object, the
// KIND_MEMORY slot whose byte range backs it, the size in bytes, the
// on-GPU tiling encoding, the cache policy the CPU-visible mapping is
// programmed with, and a compositor-oriented format hint.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// The GPU allocator (bo_alloc.pdx) hands out memory-backed BOs to
// compositors and driver clients. Every BO must be named by a
// capability so:
//
//   (1) A caller cannot forge a scan-out address into a buffer owned
//       by another process ("BO address forging").
//   (2) A caller cannot re-tag the tiling of a live BO between the
//       compositor's SET_PLANE and COMMIT phases ("tiling bait-and-
//       switch") -- the fields are frozen at mint.
//   (3) A caller cannot claim a cache policy stronger than the one
//       the allocator granted at mint ("cache policy widening").
//
// The KIND_MEMORY parent is the record of the byte range those pixels
// live in. The kernel never trusts a ring-3 BO blob directly; it
// trusts the KIND_MEMORY holder that had authority over those bytes.
//
// =============================================================================
// §1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The gate demands `kind == KIND_MEMORY (4)` carrying RIGHT_MINT. A
// mint additionally requires:
//
//   (a) bo_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) memory_slot names a live KIND_MEMORY (4) with RIGHT_MINT
//       (NO_MEMORY); the slot is stashed on the row so a later
//       revocation of the memory chases every BO that scans out of it
//   (c) size_bytes non-zero and <= u32 max (BAD_SIZE); the allocator
//       (bo_alloc.pdx) refines to one of the six size classes, and
//       the kind holds the width but does not enforce the class
//       discipline -- clients that need a specific class ask the
//       allocator, not the kind
//   (d) tiling in {LINEAR, X, Y, TILE4, TILEF} (BAD_TILING); the
//       closed five-enum matches the Xe1/Xe2 tiling taxonomy per
//       tiling.pdx §1
//   (e) cache in {WB, WT, UC, WC} (BAD_CACHE); the closed four-enum
//       matches the CPU-visible cacheability policies mediated by
//       cache_policy.pdx §1
//   (f) format_hint in [0, u16 max]; NOT VALIDATED beyond width --
//       this is a compositor hint, not a fourcc, and the plane kind
//       (kind_display_plane.pdx) validates the acceptable fourcc
//       ordinals separately
//   (g) rights subset of R_GPU_BO_ALL
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  bo_key (u64)
//   [+16] body1:   memory_slot[31:0] | size_bytes[63:32]
//   [+24] body2:   tiling[7:0] | cache[15:8] | format_hint[31:16]
//                | reserved[63:32]
//
// =============================================================================
// §3  LEAF OF THE BO LATTICE
// =============================================================================
//
// R_GPU_BO_MINT (0x200) is DELIBERATELY ABSENT from R_GPU_BO_ALL: no
// cap in this tree derives from a KIND_GPU_BO. Allocator and channel
// modules consume the row through row accessors rather than by minting
// children. A future KIND_GPU_BO_VIEW (e.g. a sub-range view) would be
// a separate derived kind that consulted this one at mint.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF640..0xFFFFF64F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: guc_hs
// 0xFFFFF650..5F; adjacent free band below: bo_alloc
// 0xFFFFF630..3F).

module KindGpuBo = structure {

  pub let KIND_GPU_BO        : u64 = 0x174
  pub let GPU_BO_PARENT_KIND : u64 = 4           // = KIND_MEMORY

  // Tiling ordinals (§1d). Mirrors tiling.pdx TIL_FMT_*.
  pub let KGB_TIL_LINEAR : u64 = 0
  pub let KGB_TIL_X      : u64 = 1
  pub let KGB_TIL_Y      : u64 = 2
  pub let KGB_TIL_TILE4  : u64 = 3
  pub let KGB_TIL_TILEF  : u64 = 4
  pub let KGB_TIL_MAX    : u64 = 4

  // Cache ordinals (§1e). Mirrors cache_policy.pdx CPOL_*.
  pub let KGB_CACHE_WB : u64 = 0
  pub let KGB_CACHE_WT : u64 = 1
  pub let KGB_CACHE_UC : u64 = 2
  pub let KGB_CACHE_WC : u64 = 3
  pub let KGB_CACHE_MAX : u64 = 3

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_GPU_BO_READ    : u64 = 0x001
  pub let R_GPU_BO_WRITE   : u64 = 0x002
  pub let R_GPU_BO_INVOKE  : u64 = 0x008
  pub let R_GPU_BO_REVOKE  : u64 = 0x010
  pub let R_GPU_BO_OBSERVE : u64 = 0x400
  pub let R_GPU_BO_ALL     : u64 = 0x41B

  // Ops. Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KGB_OP_QUERY_KEY    : u64 = 0
  pub let KGB_OP_QUERY_MEMORY : u64 = 1
  pub let KGB_OP_QUERY_SIZE   : u64 = 2
  pub let KGB_OP_QUERY_TILING : u64 = 3
  pub let KGB_OP_QUERY_CACHE  : u64 = 4
  pub let KGB_OP_QUERY_FORMAT : u64 = 5
  pub let KGB_OP_DEBUG_PRINT  : u64 = 6
  pub let KGB_OP_MAX          : u64 = 6

  // Failure taxonomy -- 0xFFFFF640..0xFFFFF64F.
  pub let KGB_OK              : u64 = 0
  pub let KGB_TAIL_ENOSPC     : u64 = 0xFFFFF64F
  pub let KGB_TAIL_BAD_ARG    : u64 = 0xFFFFF64E
  pub let KGB_MINT_BAD_PARENT : u64 = 0xFFFFF64D
  pub let KGB_MINT_BAD_RIGHTS : u64 = 0xFFFFF64C
  pub let KGB_MINT_BAD_TILING : u64 = 0xFFFFF64B
  pub let KGB_MINT_BAD_CACHE  : u64 = 0xFFFFF64A
  pub let KGB_MINT_BAD_SIZE   : u64 = 0xFFFFF649
  pub let KGB_MINT_NO_MEMORY  : u64 = 0xFFFFF648
  pub let KGB_MINT_NO_KEY     : u64 = 0xFFFFF647
  pub let KGB_MINT_ENOSPC     : u64 = 0xFFFFF646
  pub let KGB_MINT_IN_USE     : u64 = 0xFFFFF645
  pub let KGB_BAD_SLOT        : u64 = 0xFFFFF644
  pub let KGB_WRONG_KIND      : u64 = 0xFFFFF643
  pub let KGB_REVOKE_ALREADY  : u64 = 0xFFFFF642

  pub let KGB_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KGB_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride -- total 512 bytes as [u64; 64].
  pub let KGB_MAX       : u64 = 16
  pub let KGB_ROW_BYTES : u64 = 32

  pub let mut _gpu_bo_table : [u64; 64] = uninit @align(64)
  pub let mut _gpu_bo_stats : [u64; 4]  = uninit @align(64)

  pub let KGB_ST_MINTS   : u64 = 0
  pub let KGB_ST_REVOKES : u64 = 1
  pub let KGB_ST_IN_USE  : u64 = 2
  pub let KGB_ST_REFUSED : u64 = 3

  pub let kgb_dbg_msg : [u8; 11] = "GPU BO ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let gpu_bo_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): clear the GPU BO row table and its counters. Boot and teardown only. Labels prefixed kgb_rs_.",
      block: {
        lea r10, [rip + _gpu_bo_table];
        xor rax, rax;
        xor rcx, rcx;
      kgb_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  kgb_rs_rows;

        lea r10, [rip + _gpu_bo_stats];
        xor rcx, rcx;
      kgb_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kgb_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kgb_tiling_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-001 (#1262): 1 iff t <= KGB_TIL_MAX (4). Labels prefixed kgb_tv_.",
      block: {
        cmp rdi, 4;
        ja  kgb_tv_no;
        mov rax, 1;
        ret;
      kgb_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgb_cache_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-001 (#1262): 1 iff c <= KGB_CACHE_MAX (3). Labels prefixed kgb_cv_.",
      block: {
        cmp rdi, 3;
        ja  kgb_cv_no;
        mov rax, 1;
        ret;
      kgb_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgb_size_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-001 (#1262): 1 iff 0 < s <= u32 max. Labels prefixed kgb_sv_.",
      block: {
        cmp rdi, 0;
        je  kgb_sv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kgb_sv_no;
        mov rax, 1;
        ret;
      kgb_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgb_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-001 (#1262): subset test against R_GPU_BO_ALL = 0x41B. RIGHT_MINT (0x200) is OUTSIDE the mask -- leaf (§3). Labels prefixed kgb_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne kgb_rgv_no;
        mov rax, 1;
        ret;
      kgb_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kgb_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): counter bump. Labels prefixed kgb_nt_.",
      block: {
        cmp rdi, 4;
        jae kgb_nt_out;
        lea r10, [rip + _gpu_bo_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kgb_nt_out:
        ret
      }
    }

  pub let kgb_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): counter read. Labels prefixed kgb_st_.",
      block: {
        cmp rdi, 4;
        jae kgb_st_zero;
        lea r10, [rip + _gpu_bo_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kgb_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate.
  // ==========================================================================

  pub let kgb_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): §1 gate. parent must be live KIND_MEMORY (4) with RIGHT_MINT. Labels prefixed kgb_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgb_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne kgb_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  kgb_cp_no;

        mov rax, 1;
        ret;
      kgb_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kgb_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-001 (#1262): (parent_slot << 8). Labels prefixed kgb_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kgb_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kgb_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kgb_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (memory_slot: u64) (size_bytes: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-001 (#1262): pack memory_slot[31:0] | size_bytes[63:32]. Refuses out-of-range fields. Labels prefixed kgb_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kgb_b1_bad;
        cmp rsi, r10;
        ja  kgb_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      kgb_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kgb_body2_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (tiling: u64) (cache: u64) (format_hint: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-001 (#1262): pack tiling[7:0] | cache[15:8] | format_hint[31:16]. Refuses out-of-range fields. Labels prefixed kgb_b2_.",
      block: {
        cmp rdi, 0xFF;
        ja  kgb_b2_bad;
        cmp rsi, 0xFF;
        ja  kgb_b2_bad;
        mov r10, 0xFFFF;
        cmp rdx, r10;
        ja  kgb_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        ret;
      kgb_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _gpu_bo_table.
  // ==========================================================================

  pub let kgb_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (bo_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): claim one GPU BO row. THE ONE WRITER of _gpu_bo_table. Gates: hdr in_use pre-set -> BAD_ARG; bo_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 16 rows of 32 bytes. Labels prefixed kgb_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kgb_ta_bad;

        cmp r13, 0;
        je  kgb_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kgb_ta_bad;
        cmp r15, r10;
        je  kgb_ta_bad;

        xor rbx, rbx;
      kgb_ta_scan:
        cmp rbx, 16;
        jae kgb_ta_enospc;

        lea r10, [rip + _gpu_bo_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgb_ta_claim;

        add rbx, 1;
        jmp kgb_ta_scan;

      kgb_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kgb_ta_out;

      kgb_ta_enospc:
        mov rax, 0xFFFFF64F;
        jmp kgb_ta_out;
      kgb_ta_bad:
        mov rax, 0xFFFFF64E;

      kgb_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kgb_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): 1 iff row_id < MAX and in_use. Labels prefixed kgb_tvr_.",
      block: {
        cmp rdi, 16;
        jae kgb_tvr_no;
        lea r10, [rip + _gpu_bo_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgb_tvr_no;
        mov rax, 1;
        ret;
      kgb_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgb_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): scrub one row. Labels prefixed kgb_tf_.",
      block: {
        cmp rdi, 16;
        jae kgb_tf_out;
        lea r10, [rip + _gpu_bo_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kgb_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kgb_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): bo_key. Labels prefixed kgb_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_rk_bad;
        lea r10, [rip + _gpu_bo_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kgb_rk_out;
      kgb_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgb_rk_out:
        pop r12;
        ret
      }
    }

  pub let kgb_row_memory : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): memory_slot. Labels prefixed kgb_rmem_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_rmem_bad;
        lea r10, [rip + _gpu_bo_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kgb_rmem_out;
      kgb_rmem_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgb_rmem_out:
        pop r12;
        ret
      }
    }

  pub let kgb_row_size : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): size_bytes. Labels prefixed kgb_rsz_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_rsz_bad;
        lea r10, [rip + _gpu_bo_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp kgb_rsz_out;
      kgb_rsz_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgb_rsz_out:
        pop r12;
        ret
      }
    }

  pub let kgb_row_tiling : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): tiling. Labels prefixed kgb_rtl_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_rtl_bad;
        lea r10, [rip + _gpu_bo_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp kgb_rtl_out;
      kgb_rtl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgb_rtl_out:
        pop r12;
        ret
      }
    }

  pub let kgb_row_cache : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): cache. Labels prefixed kgb_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_rc_bad;
        lea r10, [rip + _gpu_bo_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 8;
        and rax, 0xFF;
        jmp kgb_rc_out;
      kgb_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgb_rc_out:
        pop r12;
        ret
      }
    }

  pub let kgb_row_format : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): format_hint. Labels prefixed kgb_rf_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_rf_bad;
        lea r10, [rip + _gpu_bo_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp kgb_rf_out;
      kgb_rf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgb_rf_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kgb_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (bo_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-001 (#1262): live row holding this bo_key, or ROW_NONE. Refuses to match 0. Labels prefixed kgb_fk_.",
      block: {
        cmp rdi, 0;
        je  kgb_fk_none;
        xor rcx, rcx;
      kgb_fk_scan:
        cmp rcx, 16;
        jae kgb_fk_none;
        lea r10, [rip + _gpu_bo_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgb_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kgb_fk_hit;
      kgb_fk_next:
        add rcx, 1;
        jmp kgb_fk_scan;
      kgb_fk_hit:
        mov rax, rcx;
        ret;
      kgb_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let kgb_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): slot -> row_id, gated on live KIND_GPU_BO. Labels prefixed kgb_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kgb_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x174;
        cmp r10, r11;
        jne kgb_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_ros_none;

        mov rax, r12;
        jmp kgb_ros_out;

      kgb_ros_none:
        mov rax, 0xFF;
      kgb_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, bo_key, memory_slot,
  // packed_all).
  //
  //   packed_all encoding:
  //     [31:0]  size_bytes
  //     [39:32] tiling
  //     [47:40] cache
  //     [63:48] format_hint
  // ==========================================================================

  pub let gpu_bo_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (bo_key: u64) (memory_slot: u64) (packed_all: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): mint KIND_GPU_BO over KIND_MEMORY. Six args; packed_all encoding: [31:0] size_bytes | [39:32] tiling | [47:40] cache | [63:48] format_hint. The single packed argument keeps the ABI within the paideia-as SysV pass ceiling used elsewhere in this tree. Labels prefixed kgb_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // bo_key
        mov r15, r8;                     // memory_slot
        mov rbp, r9;                     // packed_all

        mov r10, 256;
        cmp rbx, r10;
        jae kgb_mi_bad_slot;

        mov rdi, r12;
        call kgb_check_parent;
        cmp rax, 0;
        je  kgb_mi_bad_parent;

        mov rdi, r13;
        call kgb_rights_valid;
        cmp rax, 0;
        je  kgb_mi_bad_rights;

        // Unpack + validate size.
        mov rdi, rbp;
        and rdi, 0xFFFFFFFF;
        call kgb_size_valid;
        cmp rax, 0;
        je  kgb_mi_bad_size;

        // Unpack + validate tiling.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFF;
        call kgb_tiling_valid;
        cmp rax, 0;
        je  kgb_mi_bad_tiling;

        // Unpack + validate cache.
        mov rdi, rbp;
        shr rdi, 40;
        and rdi, 0xFF;
        call kgb_cache_valid;
        cmp rax, 0;
        je  kgb_mi_bad_cache;

        cmp r14, 0;
        je  kgb_mi_no_key;

        mov rdi, r14;
        call kgb_find_by_key;
        cmp rax, 0xFF;
        jne kgb_mi_in_use;

        // Body1 pack: (memory_slot, size_bytes).
        mov rdi, r15;
        mov rsi, rbp;
        and rsi, 0xFFFFFFFF;             // size_bytes
        call kgb_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgb_mi_bad_size;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack: (tiling, cache, format_hint).
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFF;                   // tiling
        mov rsi, rbp;
        shr rsi, 40;
        and rsi, 0xFF;                   // cache
        mov rdx, rbp;
        shr rdx, 48;
        and rdx, 0xFFFF;                 // format_hint
        call kgb_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgb_mi_bad_tiling;
        mov r15, rax;                    // body2
        push r11;
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call kgb_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgb_mi_bad_parent;

        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call kgb_tail_alloc;

        mov r10, 0xFFFFF64F;
        cmp rax, r10;
        je  kgb_mi_enospc;
        mov r10, 0xFFFFF64E;
        cmp rax, r10;
        je  kgb_mi_bad_size;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x174;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kgb_note;

        xor rax, rax;
        jmp kgb_mi_out;

      kgb_mi_bad_slot:
        mov rax, 0xFFFFF644;
        jmp kgb_mi_out;
      kgb_mi_bad_parent:
        mov rax, 0xFFFFF64D;
        jmp kgb_mi_out;
      kgb_mi_bad_rights:
        mov rax, 0xFFFFF64C;
        jmp kgb_mi_out;
      kgb_mi_bad_tiling:
        mov rax, 0xFFFFF64B;
        jmp kgb_mi_out;
      kgb_mi_bad_cache:
        mov rax, 0xFFFFF64A;
        jmp kgb_mi_out;
      kgb_mi_bad_size:
        mov rax, 0xFFFFF649;
        jmp kgb_mi_out;
      kgb_mi_no_key:
        mov rax, 0xFFFFF647;
        jmp kgb_mi_out;
      kgb_mi_in_use:
        mov rdi, 2;
        call kgb_note;
        mov rax, 0xFFFFF645;
        jmp kgb_mi_out;
      kgb_mi_enospc:
        mov rdi, 3;
        call kgb_note;
        mov rax, 0xFFFFF646;

      kgb_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_bo_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (bo_key: u64) (memory_slot: u64) (packed_all: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call gpu_bo_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x174;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let gpu_bo_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): revoke KIND_GPU_BO. Labels prefixed kgb_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kgb_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kgb_rvk_already;

        mov r11, 0x174;
        cmp r10, r11;
        jne kgb_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kgb_tail_valid;
        cmp rax, 0;
        je  kgb_rvk_clear;

        mov rdi, r13;
        call kgb_tail_free;

      kgb_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kgb_note;

        xor rax, rax;
        jmp kgb_rvk_out;

      kgb_rvk_bad_slot:
        mov rax, 0xFFFFF644;
        jmp kgb_rvk_out;
      kgb_rvk_wrong_kind:
        mov rax, 0xFFFFF643;
        jmp kgb_rvk_out;
      kgb_rvk_already:
        mov rax, 0xFFFFF642;

      kgb_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_bo_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call gpu_bo_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x174;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_gpu_bo : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M3-001 (#1262): KIND_GPU_BO dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kgb_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_gpu_bo_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kgb_hn_res;

        cmp rbp, 6;
        ja  kgb_hn_unsup;

        cmp rbp, 6;
        je  kgb_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kgb_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kgb_hn_k;
        cmp rbp, 1;
        je  kgb_hn_m;
        cmp rbp, 2;
        je  kgb_hn_sz;
        cmp rbp, 3;
        je  kgb_hn_tl;
        cmp rbp, 4;
        je  kgb_hn_ca;
        call kgb_row_format;
        jmp kgb_hn_out;

      kgb_hn_k:
        call kgb_row_key;
        jmp kgb_hn_out;
      kgb_hn_m:
        call kgb_row_memory;
        jmp kgb_hn_out;
      kgb_hn_sz:
        call kgb_row_size;
        jmp kgb_hn_out;
      kgb_hn_tl:
        call kgb_row_tiling;
        jmp kgb_hn_out;
      kgb_hn_ca:
        call kgb_row_cache;
        jmp kgb_hn_out;

      kgb_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kgb_hn_denied;
        xor rax, rax;
        jmp kgb_hn_out;

      kgb_hn_res:
        mov rax, 0xFFFFF64E;
        jmp kgb_hn_out;
      kgb_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kgb_hn_out;
      kgb_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kgb_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
