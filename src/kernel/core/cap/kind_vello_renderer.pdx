        lea r10, [rip + _vello_renderer_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFF;
        jmp vr_rt_out;
      vr_rt_bad:
