  pub let vr_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G4.M1-003 (#1477): slot -> row_id, gated on live KIND_VELLO_RENDERER.",
