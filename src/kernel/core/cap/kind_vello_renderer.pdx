  // Monotone cursor advance. THE ONE WRITER of dispatch_cursor outside vr_tail_*.
  pub let vr_row_advance_cursor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): dispatch_cursor += 1. Returns new value or DECODE_BAD on bad row.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        call vr_tail_valid;
        cmp rax, 0;
        je  vr_ac_bad;

        lea r10, [rip + _vello_renderer_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rbx, rax;

        mov rdi, 4;
        call vr_note;

        mov rax, rbx;
        jmp vr_ac_out;

      vr_ac_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      vr_ac_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vr_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (renderer_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): live row with this renderer_key, or ROW_NONE.",
      block: {
        cmp rdi, 0;
        je  vr_fk_none;
        xor rcx, rcx;
      vr_fk_scan:
        cmp rcx, 8;
        jae vr_fk_none;
        lea r10, [rip + _vello_renderer_table];
        mov r11, rcx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vr_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  vr_fk_hit;
      vr_fk_next:
        add rcx, 1;
        jmp vr_fk_scan;
      vr_fk_hit:
        mov rax, rcx;
        ret;
      vr_fk_none:
        mov rax, 0xFF;
