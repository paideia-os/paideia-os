        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        mov r11, 0x18E;
        cmp r10, r11;
        jne vr_ros_none;
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;
        mov rdi, r12;
        call vr_tail_valid;
        cmp rax, 0;
        je  vr_ros_none;
        mov rax, r12;
        jmp vr_ros_out;
      vr_ros_none:
        mov rax, 0xFF;
      vr_ros_out:
        pop r12;
        ret
      }
    }

  pub let cap_handler_vello_renderer : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "G4.M1-003 (#1477): KIND_VELLO_RENDERER dispatch. QUERY ops arity ONE.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_vello_renderer_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne vr_hn_res;

        cmp rbp, 7;
        ja  vr_hn_unsup;
        cmp rbp, 7;
        je  vr_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  vr_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  vr_hn_key;
        cmp rbp, 1;
        je  vr_hn_ctx;
        cmp rbp, 2;
        je  vr_hn_tile;
        cmp rbp, 3;
        je  vr_hn_samps;
        cmp rbp, 4;
        je  vr_hn_coarse;
        cmp rbp, 5;
        je  vr_hn_cursor;
        call vr_row_caps;
        jmp vr_hn_out;

      vr_hn_key:
        call vr_row_key;
        jmp vr_hn_out;
      vr_hn_ctx:
        call vr_row_ctx;
        jmp vr_hn_out;
      vr_hn_tile:
        call vr_row_tile_size;
        jmp vr_hn_out;
      vr_hn_samps:
        call vr_row_samples;
        jmp vr_hn_out;
      vr_hn_coarse:
        call vr_row_coarse;
        jmp vr_hn_out;
      vr_hn_cursor:
        call vr_row_cursor;
        jmp vr_hn_out;

      vr_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  vr_hn_denied;
        xor rax, rax;
        jmp vr_hn_out;

      vr_hn_res:
        mov rax, 0xFFFFEDAE;
        jmp vr_hn_out;
      vr_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp vr_hn_out;
      vr_hn_unsup:
