// src/kernel/core/cap/kind_vello_renderer.pdx -- G4.M1-003 (#1477)
//
// KIND_VELLO_RENDERER = 0x18E, derived over KIND_GPU_CONTEXT (0x176),
// whose runtime base is KIND_IPC_ENDPOINT (=5).
//
// One Vello renderer -- a compute-shader submission context bound to
// ONE GPU context, holding the tile grid parameters (tile size,
// MSAA sample count, coarsening ceiling) the compute pipelines
// consume. A compositor mints ONE renderer per output at start of
// day; a scene is bound at render submission time (renderer +
// scene -> submission on vello_render_channel).
//
// =============================================================================
// SECTION 0  WHY THIS KIND IS DERIVED OVER KIND_GPU_CONTEXT
// =============================================================================
//
// Every compute submission goes through a GPU context (0x176) --
// the paideia analogue of a Vulkan queue / D3D command queue. A
// renderer is not a queue itself; it is a set of tile-grid + MSAA
// parameters bound to ONE queue, plus a dispatch cursor that
// coarsening + occupancy pipelines advance across the tile grid.
//
// Deriving from KIND_GPU_CONTEXT pins the parent context through
// RIGHT_MINT and makes "which queue does this Vello frame run on"
// visible in the cap graph -- the alternative (a free-floating
// renderer that names a context by handle at every submit) makes
// the audit answer to "which submissions ran on which queue"
// arbitrarily hard.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_GPU_CONTEXT
// =============================================================================
//
// The kind half of the gate demands `kind == KIND_GPU_CONTEXT
// (0x176)` carrying RIGHT_MINT. The mint additionally requires:
//
//   (a) renderer_key non-zero and unique among live rows
//   (b) tile_size in {8, 16, 32} (three tile-grid options; the
//       compute pipelines are compiled for these three widths)
//   (c) sample_count in {1, 2, 4, 8, 16} (MSAA modes)
//   (d) coarsening_level in [0, 3] (0 = no coarsening, 3 = 8x)
//   (e) rights subset of R_VR_ALL (R_MINT PRESENT -- a submission
//       derives from a renderer)
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 40 BYTES (FIVE u64 WORDS)
// =============================================================================
//
//   [+0]  header: in_use[63:56] | caps[47:32] | parent_slot[15:8]
//   [+8]  renderer_key (u64)
//   [+16] body1: ctx_slot[15:0] | tile_size[23:16]
//              | sample_count[31:24] | coarsening_level[39:32]
//              | reserved[63:40]
//   [+24] dispatch_cursor (u64)   -- monotone across submits
//   [+32] reserved (u64)
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEDA0..0xFFFFEDAF
// =============================================================================

module KindVelloRenderer = structure {

  pub let KIND_VELLO_RENDERER : u64 = 0x18E
  pub let VR_PARENT_KIND      : u64 = 0x176        // KIND_GPU_CONTEXT

  pub let R_VR_READ    : u64 = 0x001
  pub let R_VR_INVOKE  : u64 = 0x008
  pub let R_VR_REVOKE  : u64 = 0x010
  pub let R_VR_MINT    : u64 = 0x200
  pub let R_VR_OBSERVE : u64 = 0x400
  pub let R_VR_ALL     : u64 = 0x619

  pub let VR_OP_QUERY_KEY       : u64 = 0
  pub let VR_OP_QUERY_CTX       : u64 = 1
  pub let VR_OP_QUERY_TILE_SIZE : u64 = 2
  pub let VR_OP_QUERY_SAMPLES   : u64 = 3
  pub let VR_OP_QUERY_COARSE    : u64 = 4
  pub let VR_OP_QUERY_CURSOR    : u64 = 5
  pub let VR_OP_QUERY_CAPS      : u64 = 6
  pub let VR_OP_DEBUG_PRINT     : u64 = 7
  pub let VR_OP_MAX             : u64 = 7

  // Capability flags (16 bits).
  pub let VR_CAP_STROKE   : u64 = 0x0001
  pub let VR_CAP_FILL     : u64 = 0x0002
  pub let VR_CAP_BLEND    : u64 = 0x0004
  pub let VR_CAP_GRADIENT : u64 = 0x0008
  pub let VR_CAP_BLUR     : u64 = 0x0010
  pub let VR_CAP_PATH_FX  : u64 = 0x0020
  pub let VR_CAP_TILE_C   : u64 = 0x0040
  pub let VR_CAP_OCCUPANCY: u64 = 0x0080
  pub let VR_CAP_ALL      : u64 = 0x00FF

  // Bounds.
  pub let VR_COARSE_MAX : u64 = 3

  // Failure taxonomy -- 0xFFFFEDA0..0xFFFFEDAF.
  pub let VR_OK              : u64 = 0
  pub let VR_TAIL_ENOSPC     : u64 = 0xFFFFEDAF
  pub let VR_TAIL_BAD_ARG    : u64 = 0xFFFFEDAE
  pub let VR_MINT_BAD_PARENT : u64 = 0xFFFFEDAD
  pub let VR_MINT_BAD_RIGHTS : u64 = 0xFFFFEDAC
  pub let VR_MINT_BAD_TILE   : u64 = 0xFFFFEDAB
  pub let VR_MINT_BAD_SAMPS  : u64 = 0xFFFFEDAA
  pub let VR_MINT_BAD_COARSE : u64 = 0xFFFFEDA9
  pub let VR_MINT_BAD_CAPS   : u64 = 0xFFFFEDA8
  pub let VR_MINT_NO_KEY     : u64 = 0xFFFFEDA7
  pub let VR_MINT_ENOSPC     : u64 = 0xFFFFEDA6
  pub let VR_BAD_SLOT        : u64 = 0xFFFFEDA5
  pub let VR_WRONG_KIND      : u64 = 0xFFFFEDA4
  pub let VR_BAD_STATE       : u64 = 0xFFFFEDA3

  pub let VR_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let VR_ROW_NONE   : u64 = 0xFF

  pub let VR_MAX       : u64 = 8
  pub let VR_ROW_BYTES : u64 = 40

  pub let mut _vello_renderer_table : [u64; 40] = uninit @align(64)
  pub let mut _vello_renderer_stats : [u64; 8]  = uninit @align(64)

  pub let VR_STA_MINTS   : u64 = 0
  pub let VR_STA_REVOKES : u64 = 1
  pub let VR_STA_REFUSED : u64 = 2
  pub let VR_STA_QUERIES : u64 = 3
  pub let VR_STA_ADVANCE : u64 = 4

  pub let vr_dbg_msg : [u8; 20] = "VELLO RENDERER ROW\0\0"

  pub let vr_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): clear row table + counters.",
      block: {
        lea r10, [rip + _vello_renderer_table];
        xor rax, rax;
        xor rcx, rcx;
      vr_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 40;
        jb  vr_rs_rows;

        lea r10, [rip + _vello_renderer_stats];
        xor rcx, rcx;
      vr_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vr_rs_stats;
        ret
      }
    }

  pub let vr_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): counter bump.",
      block: {
        cmp rdi, 8;
        jae vr_nt_out;
        lea r10, [rip + _vello_renderer_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vr_nt_out:
        ret
      }
    }

  pub let vr_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): counter read.",
      block: {
        cmp rdi, 8;
        jae vr_st_zero;
        lea r10, [rip + _vello_renderer_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vr_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vr_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-003 (#1477): subset test against R_VR_ALL = 0x619.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne vr_rv_no;
        mov rax, 1;
        ret;
      vr_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vr_tile_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-003 (#1477): 1 iff t in {8, 16, 32}.",
      block: {
        cmp rdi, 8;
        je  vr_tv_yes;
        cmp rdi, 16;
        je  vr_tv_yes;
        cmp rdi, 32;
        je  vr_tv_yes;
        xor rax, rax;
        ret;
      vr_tv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let vr_samples_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-003 (#1477): 1 iff n in {1,2,4,8,16}.",
      block: {
        cmp rdi, 1;
        je  vr_sv_yes;
        cmp rdi, 2;
        je  vr_sv_yes;
        cmp rdi, 4;
        je  vr_sv_yes;
        cmp rdi, 8;
        je  vr_sv_yes;
        cmp rdi, 16;
        je  vr_sv_yes;
        xor rax, rax;
        ret;
      vr_sv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let vr_coarse_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-003 (#1477): 1 iff c <= VR_COARSE_MAX = 3.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  vr_cv_no;
        mov rax, 1;
        ret;
      vr_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vr_caps_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-003 (#1477): subset test against VR_CAP_ALL = 0xFF.",
      block: {
        mov rax, rdi;
        mov r10, 0x00FF;
        and rax, r10;
        cmp rax, rdi;
        jne vr_cpv_no;
        mov rax, 1;
        ret;
      vr_cpv_no:
        xor rax, rax;
        ret
      }
    }

  // body1: ctx_slot[15:0] | tile_size[23:16] | sample_count[31:24]
  //      | coarsening_level[39:32]
  pub let vr_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (ctx: u64) (tile: u64) (samps: u64) (coarse: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-003 (#1477): body1 pack.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  vr_b1_bad;
        mov r10, 0xFF;
        cmp rsi, r10;
        ja  vr_b1_bad;
        cmp rdx, r10;
        ja  vr_b1_bad;
        cmp rcx, r10;
        ja  vr_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      vr_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // header: in_use[63:56] | caps[47:32] | parent_slot[15:8]
  pub let vr_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (parent_slot: u64) (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-003 (#1477): (parent_slot << 8) | (caps << 32).",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae vr_hp_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  vr_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      vr_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vr_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (renderer_key: u64) (body1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): claim one VELLO_RENDERER row. THE ONE WRITER of _vello_renderer_table.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne vr_ta_bad;
        cmp r13, 0;
        je  vr_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  vr_ta_bad;

        xor rbx, rbx;
      vr_ta_scan:
        cmp rbx, 8;
        jae vr_ta_enospc;
        lea r10, [rip + _vello_renderer_table];
        mov r11, rbx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vr_ta_claim;
        add rbx, 1;
        jmp vr_ta_scan;

      vr_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov rax, rbx;
        jmp vr_ta_out;

      vr_ta_enospc:
        mov rax, 0xFFFFEDAF;
        jmp vr_ta_out;
      vr_ta_bad:
        mov rax, 0xFFFFEDAE;

      vr_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vr_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): 1 iff row_id < VR_MAX and in_use.",
      block: {
        cmp rdi, 8;
        jae vr_tv2_no;
        lea r10, [rip + _vello_renderer_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vr_tv2_no;
        mov rax, 1;
        ret;
      vr_tv2_no:
        xor rax, rax;
        ret
      }
    }

  pub let vr_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): scrub one row.",
      block: {
        cmp rdi, 8;
        jae vr_tf_out;
        lea r10, [rip + _vello_renderer_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
      vr_tf_out:
        ret
      }
    }

  pub let vr_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): renderer_key.",
      block: {
        push r12;
        mov r12, rdi;
        call vr_tail_valid;
        cmp rax, 0;
        je  vr_rk_bad;
        lea r10, [rip + _vello_renderer_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp vr_rk_out;
      vr_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vr_rk_out:
        pop r12;
        ret
      }
    }

  pub let vr_row_ctx : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): ctx_slot at body1[15:0].",
      block: {
        push r12;
        mov r12, rdi;
        call vr_tail_valid;
        cmp rax, 0;
        je  vr_rc_bad;
        lea r10, [rip + _vello_renderer_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp vr_rc_out;
      vr_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vr_rc_out:
        pop r12;
        ret
      }
    }

  pub let vr_row_tile_size : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-003 (#1477): tile_size at body1[23:16].",
