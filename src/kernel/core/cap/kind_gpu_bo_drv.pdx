// src/kernel/core/cap/kind_gpu_bo_drv.pdx -- Wave 59 G6 [R37] skeleton
// paideia-os #2543
//
// KIND_GPU_BO_DRV = 0x43, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// Kernel-side driver substrate for the GPU Buffer Object (BO) allocator.
// A BO is a contiguous host-physical page range plus mapping metadata
// (which GTT/PPGTT it is bound into) that can be scanned out, sampled,
// or submitted as a workload resource. Standard dmabuf-shape minus the
// cross-process sharing lifecycle; at this wave one BO = one owning cap.
//
// DISTINCT from KIND_GPU_BO (0x174 = 372, R37.M3-001 #1262,
// cap/kind_gpu_bo.pdx), which is the AUTHORITY-layer kind that names a
// BO identity by (bo_key, memory_slot, tiling, cache, format_hint) over
// a client-held KIND_MEMORY range. THIS kind is the DRIVER-layer kind
// that mints BOs from the kernel physical pool and binds them into
// GTT/PPGTT -- the two coexist for the same reason KIND_BATTERY_DRV
// (0x3D) and KIND_BATTERY (0x158) coexist (Wave 59 D9's precedent), and
// for the same reason KIND_THERMAL_ZONE_DRV (0x3E) and KIND_THERMAL_
// ZONE (0x157) coexist (Wave 59 D10's precedent): one surface per role,
// dispatched by full-u64 kind tag.
//
// =============================================================================
// SECTION 0  DERIVATION POSTURE
// =============================================================================
//
// KIND_GPU_BO_DRV derives over KIND_MEMORY (= KIND_PAGE, base slot 4)
// because the artefact a mint hands back is a kernel-owned, contiguous,
// physically-addressable byte range the GPU may dereference. Same
// posture as KIND_FIRMWARE_BLOB (0x3C), KIND_SIG_KEY (0x1A3), KIND_TLS_
// TRUST (0x1A7), KIND_SCHEMA_HANDLE (0x1B2): the kind field encodes the
// SEMANTIC (this is a GPU BO) and the LAM-hint base slot encodes the
// RUNTIME SHAPE (a memory region). Full-u64 kind compare means the
// dispatch arm at `cmp rcx, 0x43` coexists with the slot-4 KIND_PAGE
// handler without ambiguity.
//
// =============================================================================
// SECTION 1  SLOT ASSIGNMENT  --  0x43
// =============================================================================
//
// Numeric derived-kind tag KIND_GPU_BO_DRV = 0x43 (decimal 67). The
// Wave 75 task directive originally proposed 0x42 for this kind;
// landing-time audit (`grep -nE 'mov r9, 0x42|cmp rcx, 0x42' src/
// kernel/core/cap/invoke.pdx`) found 0x42 already claimed by
// KIND_BLKDEV (R51.M3-003 #1647, cap/cap_handler_blkdev.pdx) at
// invoke.pdx:1165. The adjacent slots the Wave 75 parallel landings
// take -- D11 fan at 0x40, G4 PCIe hotplug driver at 0x41 -- bracket
// the gap through 0x42; this landing takes 0x43 to preserve the
// adjacency the task directive intended (the 0x40..0x43 run names the
// Wave 75 driver-layer additions as a contiguous block above the Wave
// 74 KIND_PPGTT 0x3F terminator) while avoiding the pre-existing
// KIND_BLKDEV collision. 0x43 fits imm32 with bit 31 clear so no r9
// staging is required; dispatch is a direct `cmp rcx, 0x43`.
//
// Audit at landing time: `grep -nE '\b0x43\b' src/kernel/core/cap/`
// returned zero hits; no existing dispatch arm overwritten.
//
// =============================================================================
// SECTION 2  ROW LAYOUT  --  32 BYTES PER BO, 8 ROWS
// =============================================================================
//
// Per Wave 75 G6 task directive:
//
//   [+0]   host_pa                 (u64)   kernel-VA for the backing
//                                           contiguous page range (see
//                                           phys_alloc #658 VA-not-PA
//                                           contract -- the field holds
//                                           what phys_alloc returned)
//   [+8]   size_pages[31:0]        (u32)   requested page count
//          placement[63:32]        (u32)   GPU_BO_PLACEMENT_* ordinal
//                                           at mint time
//   [+16]  gpu_va                  (u64)   last gpu-virtual address a
//                                           map op installed (0 if
//                                           unmapped); the GPU view
//   [+24]  mapped_in               (u64)   bitfield --
//                                           bit 0 (0x1) = bound in GTT
//                                           bit 1 (0x2) = bound in PPGTT
//                                           0  = unmapped
//                                           3  = both
//
// Row size: 32 bytes = 4 u64. Row-addressed capacity: GPU_BO_MANIFEST_
// MAX rows -- 8 at this landing, matching the Wave 59 G6 task directive
// 8-row manifest. Growing by increasing GPU_BO_MANIFEST_MAX is a one-
// liner (the stride arithmetic is a single `shl rN, 5` so the manifest
// never pays an `imul` cost regardless of row count).
//
// host_pa == 0 marks an EMPTY ROW. The manifest scan skips zero slots
// and the gpu_bo_drv_table_reset / gpu_bo_substrate_init pair below
// respects this invariant.
//
// =============================================================================
// SECTION 3  PLACEMENT TAXONOMY
// =============================================================================
//
//   GPU_BO_PLACEMENT_SYSTEM        = 0   host RAM, accessed by the GPU
//                                        through PCIe (the only option
//                                        on a dGPU-less SKU)
//   GPU_BO_PLACEMENT_LOCAL         = 1   GSM (Graphics Stolen Memory)
//                                        on an iGPU, or VRAM on a dGPU
//                                        (not available at Wave 75 --
//                                        falls back to SYSTEM)
//   GPU_BO_PLACEMENT_PREFER_LOCAL  = 2   try LOCAL, fall back to SYSTEM
//
// At Wave 75 only SYSTEM is physically backed (phys_alloc from the
// kernel pool). LOCAL and PREFER_LOCAL route through the same
// phys_alloc path at skeleton level; the GSM-aware allocator the
// Wave 74 G5 modeset introduced lives in a follow-up slice.
//
// =============================================================================
// SECTION 4  RIGHTS
// =============================================================================
//
//   R_GPU_BO_DRV_READ   (0x001)  invoke row-accessor ops (QUERY_*)
//   R_GPU_BO_DRV_MAP    (0x002)  bind the BO into GTT / PPGTT
//   R_GPU_BO_DRV_REVOKE (0x010)  free pages + scrub cap row
//   R_GPU_BO_DRV_ALL             0x013
//
// RIGHT_MINT (0x200) is DELIBERATELY ABSENT: no cap in this tree
// derives from a KIND_GPU_BO_DRV. The authority-layer KIND_GPU_BO
// (0x174) is the shared-sub-range mint target when that follow-up
// lands; this driver-layer kind stays leaf.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY  --  0xFFFFFFF1..0xFFFFFFF5
// =============================================================================
//
// Per Wave 75 G6 task directive this module reserves five codes:
//
//   GPU_BO_BAD_PLACEMENT     = 0xFFFFFFF1  (placement > PREFER_LOCAL)
//   GPU_BO_SIZE_MISALIGNED   = 0xFFFFFFF2  (size_bytes not 4K multiple)
//   GPU_BO_OOM               = 0xFFFFFFF3  (phys_alloc or row/slab exhaust)
//   GPU_BO_MAPPING_LIVE      = 0xFFFFFFF4  (map op on already-live target)
//   GPU_BO_UNKNOWN_CAP       = 0xFFFFFFF5  (cap resolves to no live row)
//
// The task directive originally proposed 0xFFFFFFEA..EE for this band;
// landing-time audit (`grep -rn 0xFFFFFFEA src/kernel/core/`) found the
// EA..EE run already claimed by KIND_HW_MSIX_VECTOR (R29.M1-004 #1022,
// cap/kind_hw_msix_vector.pdx: MSIX_MINT_BAD_ARG=EA / _ENOSPC=EB /
// _BAD_RIGHTS=EC / _BAD_PARENT=ED / MSIX_TAIL_BAD_ARG=EE). This landing
// takes the next clean five-wide band at 0xFFFFFFF1..F5 (0xFFFFFFEF /
// F0 are kind_hw_msix_vector / kind_hw_interrupt tail codes; F7 / F8
// are used by hw_int_cap; F6 is free; F1..F5 are a clean five-wide
// band). Audit at landing time: `grep -rnE '0xFFFFFFF[1-5]' src/`
// returned zero hits.
//
// All five fit imm32 with bit 31 clear so `mov rax, imm32` is a 7-byte
// emit, not the 10-byte movabs form.
//
// =============================================================================
// SECTION 6  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x43 fits imm32, so every compare against it uses
// `cmp rcx, 0x43` directly (no r9/r11 staging). Error sentinels
// 0xFFFFFFF1..F5 also fit imm32 (sign-extend cleanly to u64). The one
// imm64 constant this module needs -- the 4K page-align mask
// 0xFFFFFFFFFFFFF000 -- is staged through r11 at every use (never
// `and r, imm64`, which the paideia-as encoder does not have an
// instruction encoding for). The row stride multiplication is 32
// (`shl rN, 5`) so no 2-op `imul r, imm` form is needed. The cap_table
// stride multiplication is 24 (`shl rN, 3; shl rM, 4; add`) following
// the firmware_blob / tls_trust precedent one-for-one. Liveness tests
// use `cmp rN, 0` (never `test rN, rN` 2-op). All `pub let` string
// declarations are on single lines. Module basename `KindGpuBoDrv`
// matches the file basename `kind_gpu_bo_drv.pdx`. Every label in this
// file is prefixed `gbd_` (reserved-word discipline -- `loop`/`if`/
// `let` are keywords).
//
// klog_s1_x2 convention per Wave 73 I7 regression memory: v2 lives at
// the caller's [rsp+0] AFTER sub rsp,16 (which becomes [rbp+16] inside
// the wrapper's `push rbp` prologue). The +8 slot the wrapper's
// docstring names is historical; firmware_blob_lookup / firmware_blob_
// slice both carry the PATCH to +0 and this file follows that
// discipline.
//
// Fingerprint tag `[u8; N]` string literals have N = string length + 1
// (the trailing NUL counts). Each tag's N is spelled next to the
// literal for audit.

module KindGpuBoDrv = structure {

  pub let KIND_GPU_BO_DRV      : u64 = 0x43
  pub let KIND_GPU_BO_DRV_BASE : u64 = 4         // = KIND_MEMORY (LAM-hint slot)

  // Placement ordinals (§3).
  pub let GPU_BO_PLACEMENT_SYSTEM        : u64 = 0
  pub let GPU_BO_PLACEMENT_LOCAL         : u64 = 1
  pub let GPU_BO_PLACEMENT_PREFER_LOCAL  : u64 = 2
  pub let GPU_BO_PLACEMENT_MAX           : u64 = 2

  // Rights (§4). RIGHT_MINT (0x200) deliberately absent (leaf).
  pub let R_GPU_BO_DRV_READ   : u64 = 0x001
  pub let R_GPU_BO_DRV_MAP    : u64 = 0x002
  pub let R_GPU_BO_DRV_REVOKE : u64 = 0x010
  pub let R_GPU_BO_DRV_ALL    : u64 = 0x013

  // Driver-default rights handed back by gpu_bo_alloc.
  pub let R_GPU_BO_DRV_DEFAULT : u64 = 0x013

  // mapped_in bitfield (§2).
  pub let GPU_BO_UNMAPPED    : u64 = 0
  pub let GPU_BO_MAPPED_GTT  : u64 = 1
  pub let GPU_BO_MAPPED_PPGTT : u64 = 2
  pub let GPU_BO_MAPPED_BOTH : u64 = 3

  // Ops (cap_handler_gpu_bo_drv dispatch).
  pub let GBD_OP_READ            : u64 = 0  // liveness probe -- row_id or 0
  pub let GBD_OP_QUERY_HOST_PA   : u64 = 1
  pub let GBD_OP_QUERY_SIZE_PAGES : u64 = 2
  pub let GBD_OP_QUERY_PLACEMENT : u64 = 3
  pub let GBD_OP_QUERY_GPU_VA    : u64 = 4
  pub let GBD_OP_QUERY_MAPPED_IN : u64 = 5
  pub let GBD_OP_MAX             : u64 = 5

  // Failure codes (§5). All five fit imm32 with bit 31 clear so
  // `mov rax, imm32` is a 7-byte emit.
  pub let GPU_BO_OK                : u64 = 0
  pub let GPU_BO_BAD_PLACEMENT     : u64 = 0xFFFFFFF1
  pub let GPU_BO_SIZE_MISALIGNED   : u64 = 0xFFFFFFF2
  pub let GPU_BO_OOM               : u64 = 0xFFFFFFF3
  pub let GPU_BO_MAPPING_LIVE      : u64 = 0xFFFFFFF4
  pub let GPU_BO_UNKNOWN_CAP       : u64 = 0xFFFFFFF5

  pub let GPU_BO_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let GPU_BO_ROW_NONE   : u64 = 0xFF

  // Standard cap_invoke sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Manifest + row ceilings.
  pub let GPU_BO_MANIFEST_MAX : u64 = 8      // row count at Wave 75
  pub let GPU_BO_ROW_BYTES    : u64 = 32     // 4 u64

  // 8 rows * 32 bytes = 256 bytes = 32 u64. .bss zero-init means every
  // row starts with host_pa == 0 (the EMPTY sentinel, §2), which is
  // the free-slot marker gpu_bo_row_alloc scans for.
  pub let mut _gpu_bo_drv_manifest : [u64; 32] = uninit @align(64)

  // Observability counters: alloc / revoke / map_gtt / map_ppgtt /
  // unmap totals. Bumped on each successful op, visible via a future
  // witness. Zero-init matches other kinds' discipline.
  pub let mut _gpu_bo_drv_stats : [u64; 8] = uninit @align(64)

  pub let GBD_ST_ALLOC      : u64 = 0
  pub let GBD_ST_REVOKE     : u64 = 1
  pub let GBD_ST_MAP_GTT    : u64 = 2
  pub let GBD_ST_MAP_PPGTT  : u64 = 3
  pub let GBD_ST_UNMAP      : u64 = 4
  pub let GBD_ST_REFUSED    : u64 = 5

  // Fingerprint tags + keys. Wire shape per Wave 75 G6 task directive:
  //
  //   `GPU_BO ALLOC cap=0x<16-hex> host_pa=0x<16-hex> size_pages=<dec>`
  //   `GPU_BO MAP_GTT cap=0x<16-hex> gpu_va=0x<16-hex>`     -- GTT bind
  //   `GPU_BO MAP_PPGTT cap=0x<16-hex> gpu_va=0x<16-hex>`   -- PPGTT bind
  //   `GPU_BO REVOKE cap=0x<16-hex>`                        -- cap teardown
  //
  // The task directive's single `GPU_BO MAP ... target=<gtt|ppgtt>`
  // tag is split into MAP_GTT and MAP_PPGTT because the klog wrapper
  // family carries hex and decimal KV types only -- no string KV --
  // and splitting the tag by target is strictly more legible in a
  // dmesg grep than encoding `target=0`/`target=1` as hex. The
  // consolidated golden lives alongside this file at tests/
  // fingerprints/gpu_bo.golden.
  //
  // String literal sizes include the trailing NUL. The following
  // explicit arithmetic appears next to every tag to keep the audit
  // trivial:
  //   "GPU_BO ALLOC\0"     = 12 chars + NUL = 13 bytes  -> [u8; 13]
  //   "GPU_BO MAP_GTT\0"   = 14 chars + NUL = 15 bytes  -> [u8; 15]
  //   "GPU_BO MAP_PPGTT\0" = 16 chars + NUL = 17 bytes  -> [u8; 17]
  //   "GPU_BO REVOKE\0"    = 13 chars + NUL = 14 bytes  -> [u8; 14]
  //   "KIND_GPU_BO_DRV dispatch inv\0" = 28 + 1 = 29    -> [u8; 29]
  pub let gbd_tag_alloc        : [u8; 13] = "GPU_BO ALLOC\0"
  pub let gbd_tag_map_gtt      : [u8; 15] = "GPU_BO MAP_GTT\0"
  pub let gbd_tag_map_ppgtt    : [u8; 17] = "GPU_BO MAP_PPGTT\0"
  pub let gbd_tag_revoke       : [u8; 14] = "GPU_BO REVOKE\0"
  pub let gbd_tag_handler_entry : [u8; 29] = "KIND_GPU_BO_DRV dispatch inv\0"

  // Key strings for the klog KV pairs. Each is len+1 for the NUL.
  //   "cap\0"        = 4
  //   "host_pa\0"    = 8
  //   "size_pages\0" = 11
  //   "gpu_va\0"     = 7
  pub let gbd_k_cap        : [u8; 4]  = "cap\0"
  pub let gbd_k_host_pa    : [u8; 8]  = "host_pa\0"
  pub let gbd_k_size_pages : [u8; 11] = "size_pages\0"
  pub let gbd_k_gpu_va     : [u8; 7]  = "gpu_va\0"

  // ==========================================================================
  // gpu_bo_drv_table_reset() -> ()
  //
  // Defensive clear. Zero the manifest (32 u64) and the stats array
  // (8 u64). .bss is already zero at real boot; this is belt-and-
  // braces per the firmware_blob / tls_trust / nic precedent.
  // ==========================================================================
  pub let gpu_bo_drv_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): clear every _gpu_bo_drv_manifest u64 (32 words) and every _gpu_bo_drv_stats u64 (8 words). Boot and teardown only. .bss is already zero at real boot; this is defensive. Matches firmware_blob_table_reset shape one-for-one. Labels prefixed gbd_tr_.",
      block: {
        lea r10, [rip + _gpu_bo_drv_manifest];
        xor rax, rax;
        xor rcx, rcx;
      gbd_tr_manifest:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  gbd_tr_manifest;

        lea r10, [rip + _gpu_bo_drv_stats];
        xor rcx, rcx;
      gbd_tr_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gbd_tr_stats;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_manifest_row_base(row_id) -> &_gpu_bo_drv_manifest[row_id*32]
  //
  // Row index -> row base pointer. Stride 32 = `shl rN, 5` -- no
  // `imul rN, imm` emitted. No bounds check by policy: every caller
  // validates row_id against GPU_BO_MANIFEST_MAX first.
  // ==========================================================================
  pub let gpu_bo_manifest_row_base : (u64) -> u64 !{} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): row_id -> &_gpu_bo_drv_manifest[row_id*32]. Stride 32 via `shl rN, 5` -- cheaper than `imul` and the paideia-as encoder has no 2-op `imul r,imm` anyway. No bounds check by policy, caller validates first. Labels prefixed gbd_rb_.",
      block: {
        lea rax, [rip + _gpu_bo_drv_manifest];
        mov r10, rdi;
        shl r10, 5;                      // row_id * 32
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_row_valid(row_id) -> 1 iff row_id < GPU_BO_MANIFEST_MAX AND
  //                                   host_pa != 0
  //
  // The host_pa == 0 sentinel marks an empty slot (§2), so an in-range
  // row_id whose host_pa is zero is NOT live.
  // ==========================================================================
  pub let gpu_bo_row_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): 1 iff row_id < GPU_BO_MANIFEST_MAX(8) and host_pa (word 0) != 0. Inlined address compute mirrors gpu_bo_manifest_row_base. Labels prefixed gbd_rv_.",
      block: {
        mov r10, 8;                      // GPU_BO_MANIFEST_MAX
        cmp rdi, r10;
        jae gbd_rv_no;
        lea r10, [rip + _gpu_bo_drv_manifest];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];              // host_pa
        cmp rax, 0;
        je  gbd_rv_no;
        mov rax, 1;
        ret;
      gbd_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_row_alloc() -> row_id | GPU_BO_ROW_NONE
  //
  // Linear scan for the first row whose host_pa (word 0) is zero.
  // Returns GPU_BO_ROW_NONE (0xFF) when the manifest is full.
  // ==========================================================================
  pub let gpu_bo_row_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): find first free manifest row (host_pa == 0). Returns row_id on success or GPU_BO_ROW_NONE (0xFF). Pure asm loop over _gpu_bo_drv_manifest. Labels prefixed gbd_ra_.",
      block: {
        xor rcx, rcx;                    // row_id cursor
      gbd_ra_scan:
        cmp rcx, 8;                      // GPU_BO_MANIFEST_MAX
        jae gbd_ra_none;
        lea r10, [rip + _gpu_bo_drv_manifest];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;                    // &manifest[rcx*32]
        mov rax, [r10 + 0];              // host_pa
        cmp rax, 0;
        je  gbd_ra_hit;
        add rcx, 1;
        jmp gbd_ra_scan;
      gbd_ra_hit:
        mov rax, rcx;
        ret;
      gbd_ra_none:
        mov rax, 0xFF;
        ret
      }
    }

  // Row-accessor family. Each returns GPU_BO_DECODE_BAD when the row
  // is not live, matching kind_firmware_blob / kind_tls_trust
  // discipline.
  pub let gpu_bo_row_host_pa : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): manifest[row_id].host_pa, or GPU_BO_DECODE_BAD. Labels prefixed gbd_rhp_.",
      block: {
        push r12;
        mov r12, rdi;
        call gpu_bo_row_valid;
        cmp rax, 0;
        je  gbd_rhp_bad;
        mov rdi, r12;
        call gpu_bo_manifest_row_base;
        mov rax, [rax + 0];
        jmp gbd_rhp_out;
      gbd_rhp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gbd_rhp_out:
        pop r12;
        ret
      }
    }

  pub let gpu_bo_row_size_pages : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): manifest[row_id].size_pages (low u32 of word +8), or GPU_BO_DECODE_BAD. Mask via r11 staging (0xFFFFFFFF fits imm32 but `and rax,0xFFFFFFFF` zero-extends via 32-bit op naturally; still stage through r11 for shape consistency with other row accessors). Labels prefixed gbd_rsz_.",
      block: {
        push r12;
        mov r12, rdi;
        call gpu_bo_row_valid;
        cmp rax, 0;
        je  gbd_rsz_bad;
        mov rdi, r12;
        call gpu_bo_manifest_row_base;
        mov rax, [rax + 8];
        mov r11, 0xFFFFFFFF;
        and rax, r11;                    // low u32 = size_pages
        jmp gbd_rsz_out;
      gbd_rsz_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gbd_rsz_out:
        pop r12;
        ret
      }
    }

  pub let gpu_bo_row_placement : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): manifest[row_id].placement (high u32 of word +8), or GPU_BO_DECODE_BAD. shr by 32 extracts the high half. Labels prefixed gbd_rpl_.",
      block: {
        push r12;
        mov r12, rdi;
        call gpu_bo_row_valid;
        cmp rax, 0;
        je  gbd_rpl_bad;
        mov rdi, r12;
        call gpu_bo_manifest_row_base;
        mov rax, [rax + 8];
        shr rax, 32;                     // high u32 = placement
        jmp gbd_rpl_out;
      gbd_rpl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gbd_rpl_out:
        pop r12;
        ret
      }
    }

  pub let gpu_bo_row_gpu_va : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): manifest[row_id].gpu_va, or GPU_BO_DECODE_BAD. Labels prefixed gbd_rgv_.",
      block: {
        push r12;
        mov r12, rdi;
        call gpu_bo_row_valid;
        cmp rax, 0;
        je  gbd_rgv_bad;
        mov rdi, r12;
        call gpu_bo_manifest_row_base;
        mov rax, [rax + 16];
        jmp gbd_rgv_out;
      gbd_rgv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gbd_rgv_out:
        pop r12;
        ret
      }
    }

  pub let gpu_bo_row_mapped_in : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): manifest[row_id].mapped_in, or GPU_BO_DECODE_BAD. Labels prefixed gbd_rmi_.",
      block: {
        push r12;
        mov r12, rdi;
        call gpu_bo_row_valid;
        cmp rax, 0;
        je  gbd_rmi_bad;
        mov rdi, r12;
        call gpu_bo_manifest_row_base;
        mov rax, [rax + 24];
        jmp gbd_rmi_out;
      gbd_rmi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gbd_rmi_out:
        pop r12;
        ret
      }
    }

  // Counter bump. `which` is a GBD_ST_* ordinal.
  pub let gbd_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G6 [R37] (#2543): counter bump. Range-checks which < 8 then increments _gpu_bo_drv_stats[which]. Labels prefixed gbd_nt_.",
      block: {
        cmp rdi, 8;
        jae gbd_nt_out;
        lea r10, [rip + _gpu_bo_drv_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      gbd_nt_out:
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_cap_resolve(cap) -> row_id | GPU_BO_ROW_NONE
  //
  // Cap-table lookup. Validates (cap < 256) and (descriptor.kind ==
  // KIND_GPU_BO_DRV); returns descriptor.target_ptr & 0xFFFF as the
  // row_id. The cap_table stride is 24 bytes computed as
  // shl r11, 3; shl rax, 4; add r11, rax (SAME idiom firmware_blob
  // uses one-for-one; the paideia-as encoder has no 2-op `imul r,imm`).
  // ==========================================================================
  pub let gpu_bo_cap_resolve : (u64) -> u64 !{mem} @{cap} =
    fn (cap: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Wave 59 G6 [R37] (#2543): cap_table lookup. Bounds (<256) + descriptor.kind == 0x43 KIND_GPU_BO_DRV + target_ptr & 0xFFFF -> row_id. Returns GPU_BO_ROW_NONE (0xFF) on any failure. Labels prefixed gbd_cr_.",
      block: {
        push rbx;
        mov rbx, rdi;                    // cap

        mov r10, 256;
        cmp rbx, r10;
        jae gbd_cr_none;

        lea r10, [rip + cap_table];
        mov r11, rbx;
        shl r11, 3;                      // cap * 8
        mov rax, rbx;
        shl rax, 4;                      // cap * 16
        add r11, rax;                    // cap * 24
        add r10, r11;                    // &cap_table[cap*24]
        mov rax, [r10 + 0];              // descriptor.kind
        mov r11, 0x43;                   // KIND_GPU_BO_DRV
        cmp rax, r11;
        jne gbd_cr_none;

        mov rax, [r10 + 16];             // descriptor.target_ptr
        mov r11, 0xFFFF;
        and rax, r11;                    // row_id = target_ptr[15:0]
        jmp gbd_cr_out;

      gbd_cr_none:
        mov rax, 0xFF;
      gbd_cr_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_alloc(size_bytes, placement) -> u64 (cap handle, or error)
  //
  // THE primary allocator entrypoint. Steps:
  //
  //   1. Validate size_bytes != 0 and 4K-aligned (low 12 bits zero).
  //      Fail -> GPU_BO_SIZE_MISALIGNED.
  //   2. Validate placement <= GPU_BO_PLACEMENT_MAX (2).
  //      Fail -> GPU_BO_BAD_PLACEMENT.
  //   3. size_pages = size_bytes >> 12. For the skeleton we allocate
  //      ONE page via phys_alloc(0) (the follow-up slice extends to a
  //      multi-page allocator; see §Boot wiring note at EOF).
  //   4. gpu_bo_row_alloc; on NONE -> GPU_BO_OOM.
  //   5. phys_alloc(0); on 0 -> GPU_BO_OOM (also roll back row by
  //      leaving host_pa == 0 which the row still carries).
  //   6. slab_alloc; on 256 -> GPU_BO_OOM (same roll-back).
  //   7. cap_mint_write(slot, KIND_GPU_BO_DRV=0x43, R_GPU_BO_DRV_
  //      DEFAULT, row_id).
  //   8. Stamp manifest row: host_pa + packed(size_pages, placement) +
  //      gpu_va = 0 + mapped_in = 0.
  //   9. Bump GBD_ST_ALLOC counter.
  //  10. Emit `GPU_BO ALLOC cap=0x<16-hex> host_pa=0x<16-hex>
  //      size_pages=<dec>` via klog_s1_d1_x2 (one dec + two hex);
  //      KV order is (size_pages decimal, cap hex, host_pa hex) to
  //      match the wrapper's shape -- the golden encodes that order.
  //  11. Return cap slot.
  //
  // Register plan: rbx=size_bytes, r12=placement, r13=size_pages,
  // r14=row_id, r15=cap_slot (host_pa reaches klog via r8 then is
  // handed off directly). Five callee-save pushes land rsp%16==0 at
  // the nested call sites (entry rsp%16==8, +40 -> 48, %16==0).
  // ==========================================================================
  pub let gpu_bo_alloc : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (size_bytes: u64) (placement: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 G6 [R37] (#2543): primary GPU BO allocator. Validate 4K-aligned non-zero size + placement <= PREFER_LOCAL; carve a manifest row; phys_alloc(0) for the backing page; slab_alloc for the cap slot; cap_mint_write(slot, 0x43, 0x013, row_id); stamp row (host_pa, packed size_pages|placement<<32, 0 gpu_va, 0 mapped_in); bump stats; emit `GPU_BO ALLOC size_pages=<dec> cap=0x<16-hex> host_pa=0x<16-hex>` via klog_s1_d1_x2 (v2=cap at caller [rsp+0], k3=host_pa_key at [rsp+8], v3=host_pa at [rsp+16]). Returns cap slot or GPU_BO_SIZE_MISALIGNED/BAD_PLACEMENT/OOM. Register plan: rbx=size_bytes, r12=placement, r13=size_pages, r14=row_id, r15=cap_slot. Five callee-save pushes land rsp%16==0 at every nested call. The 4K-align mask 0xFFFFFFFFFFFFF000 is an imm64 so stage via r11 ( `mov r11, imm64; and rax, r11` ); no `and rax, imm64` direct form. Labels prefixed gbd_al_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // size_bytes
        mov r12, rsi;                    // placement

        // Step 1: size_bytes != 0.
        cmp rbx, 0;
        je  gbd_al_bad_size;
        // Step 1b: 4K-aligned (low 12 bits zero). The mask
        // 0xFFFFFFFFFFFFF000 is imm64; stage through r11.
        mov rax, rbx;
        mov r11, 0xFFFFFFFFFFFFF000;
        and rax, r11;                    // zero low 12 bits
        cmp rax, rbx;
        jne gbd_al_bad_size;

        // Step 2: placement <= GPU_BO_PLACEMENT_MAX (2).
        mov r10, 2;
        cmp r12, r10;
        ja  gbd_al_bad_place;

        // Step 3: size_pages = size_bytes >> 12.
        mov r13, rbx;
        shr r13, 12;

        // Step 4: carve a row.
        call gpu_bo_row_alloc;
        mov r11, 0xFF;
        cmp rax, r11;
        je  gbd_al_oom;
        mov r14, rax;                    // row_id

        // Compose the row-pack word NOW while placement is still in
        // r12: r13 (currently size_pages) is extended into the full
        // packed form (size_pages[31:0] | placement[63:32]) so one
        // register carries both halves across the nested calls. This
        // frees r12 to hold the host_pa phys_alloc returns.
        mov r10, r12;
        shl r10, 32;                     // placement << 32
        or  r13, r10;                    // r13 = size_pages | placement<<32

        // Step 5: phys_alloc(0). Returns a kernel-VA (phys_alloc #658
        // VA-not-PA contract) which we store in host_pa; the GTT/
        // PPGTT bind path converts to a PA at the PTE boundary (see
        // ppgtt_walker.pdx / gtt_bind.pdx).
        xor rdi, rdi;                    // order = 0 (one page)
        call phys_alloc;
        cmp rax, 0;
        je  gbd_al_oom;
        mov r12, rax;                    // r12 = host_pa (placement now
                                         // folded into r13 above)

        // Step 6: slab_alloc.
        call slab_alloc;
        mov r11, 256;
        cmp rax, r11;
        jae gbd_al_oom;
        mov r15, rax;                    // cap_slot

        // Step 7: cap_mint_write(slot=r15, kind=0x43, rights=0x013,
        //                        target_ptr=row_id=r14).
        mov rdi, r15;
        mov rsi, 0x43;                   // KIND_GPU_BO_DRV
        mov rdx, 0x013;                  // R_GPU_BO_DRV_DEFAULT
        mov rcx, r14;                    // target_ptr = row_id
        call cap_mint_write;

        // Step 8: stamp manifest row.
        mov rdi, r14;
        call gpu_bo_manifest_row_base;
        // rax = &manifest[row_id*32]
        mov [rax + 0], r12;              // host_pa
        mov [rax + 8], r13;              // size_pages | placement<<32

        // gpu_va + mapped_in start zero (unmapped).
        xor r10, r10;
        mov [rax + 16], r10;             // gpu_va = 0
        mov [rax + 24], r10;             // mapped_in = 0

        // Step 9: bump GBD_ST_ALLOC counter.
        xor rdi, rdi;                    // GBD_ST_ALLOC
        call gbd_note;

        // Step 10: emit `GPU_BO ALLOC size_pages=<dec> cap=0x<16-hex>
        // host_pa=0x<16-hex>` via klog_s1_d1_x2. Stage 3 extra args
        // on the stack: [rsp+0]=vx1 (cap), [rsp+8]=kx2 (host_pa key),
        // [rsp+16]=vx2 (host_pa). sub rsp,32 reserves the slots and
        // keeps rsp%16==0 at the call site. r13 carries the packed
        // (size_pages | placement<<32) word; the klog decimal format
        // needs just size_pages in the low 32 bits, so stage through
        // r11 with a 0xFFFFFFFF mask (fits imm32, cmp posture).
        sub rsp, 32;
        mov [rsp + 0], r15;              // v2 = cap
        lea r10, [rip + gbd_k_host_pa];
        mov [rsp + 8], r10;              // k3 = &gbd_k_host_pa
        mov [rsp + 16], r12;             // v3 = host_pa
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gbd_tag_alloc];
        lea rcx, [rip + gbd_k_size_pages]; // k1 = &gbd_k_size_pages
        mov r8, r13;
        mov r11, 0xFFFFFFFF;
        and r8, r11;                     // v1 = size_pages (low 32 of r13)
        lea r9, [rip + gbd_k_cap];       // k2 = &gbd_k_cap
        call klog_s1_d1_x2;
        add rsp, 32;

        // Step 11: return cap slot.
        mov rax, r15;
        jmp gbd_al_out;

      gbd_al_bad_size:
        mov rax, 0xFFFFFFF2;             // GPU_BO_SIZE_MISALIGNED
        jmp gbd_al_out;
      gbd_al_bad_place:
        mov rax, 0xFFFFFFF1;             // GPU_BO_BAD_PLACEMENT
        jmp gbd_al_out;
      gbd_al_oom:
        mov rax, 0xFFFFFFF3;             // GPU_BO_OOM

      gbd_al_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_map_gtt(bo_cap, gpu_va) -> i32
  //
  // Resolve the cap to a row, call gtt_bind(gpu_va, host_pa, prot=0)
  // from drivers/gpu/gpu_gtt.pdx (Wave 74 G5). On success set
  // mapped_in |= GPU_BO_MAPPED_GTT, stash gpu_va, bump stats, emit
  // `GPU_BO MAP_GTT cap=0x<16-hex> gpu_va=0x<16-hex>` via klog_s1_x2
  // (v2=gpu_va at caller [rsp+0]).
  //
  // Returns GPU_BO_OK on success, GPU_BO_UNKNOWN_CAP on bad cap,
  // GPU_BO_MAPPING_LIVE if the row's mapped_in already names GTT,
  // or whatever gtt_bind returned (0xFFFFFFDB..DF band).
  // ==========================================================================
  pub let gpu_bo_map_gtt : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bo_cap: u64) (gpu_va: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 G6 [R37] (#2543): GTT bind orchestrator. Resolve cap -> row -> host_pa; call gtt_bind(gpu_va, host_pa, prot=0); on OK stamp (mapped_in |= 1, gpu_va); bump GBD_ST_MAP_GTT; emit `GPU_BO MAP_GTT cap=0x<16-hex> gpu_va=0x<16-hex>` via klog_s1_x2 with v2 at caller [rsp+0]. Returns GPU_BO_OK or GPU_BO_UNKNOWN_CAP / GPU_BO_MAPPING_LIVE / gtt_bind sentinels. Register plan: rbx=cap, r12=gpu_va, r13=row_id, r14=host_pa, r15=unused (pushed solely for alignment). Five callee-save pushes land rsp%16==0 at every nested call (entry rsp%16==8, +40 -> 48, %16==0; the firmware_blob five-push discipline). r15 is NOT used by the body but is pushed to achieve the five-push alignment -- four callee-save values would land rsp%16==8 and klog_s1_x2's own prologue would then misalign its nested klog_emit_core call. Labels prefixed gbd_mg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // bo_cap
        mov r12, rsi;                    // gpu_va

        // Resolve cap -> row_id.
        mov rdi, rbx;
        call gpu_bo_cap_resolve;
        mov r10, 0xFF;
        cmp rax, r10;
        je  gbd_mg_bad_cap;
        mov r13, rax;                    // row_id

        // Already mapped in GTT? mapped_in & 1.
        mov rdi, r13;
        call gpu_bo_row_mapped_in;
        mov r11, 1;                      // GPU_BO_MAPPED_GTT
        and rax, r11;
        cmp rax, 0;
        jne gbd_mg_live;

        // Fetch host_pa.
        mov rdi, r13;
        call gpu_bo_row_host_pa;
        mov r14, rax;                    // host_pa

        // Call gtt_bind(gpu_va=r12, host_pa=r14, prot=0).
        mov rdi, r12;
        mov rsi, r14;
        xor rdx, rdx;
        call gtt_bind;
        cmp rax, 0;
        jne gbd_mg_fwd;                  // propagate gtt_bind error

        // Stamp row: mapped_in |= 1, gpu_va = r12.
        mov rdi, r13;
        call gpu_bo_manifest_row_base;
        mov [rax + 16], r12;             // gpu_va
        mov r11, [rax + 24];
        or  r11, 1;                      // mapped_in |= GTT
        mov [rax + 24], r11;

        // Bump stats.
        mov rdi, 2;                      // GBD_ST_MAP_GTT
        call gbd_note;

        // Fingerprint: `GPU_BO MAP_GTT cap=0x<16-hex> gpu_va=0x<16-hex>`
        // via klog_s1_x2 (v2=gpu_va at caller [rsp+0]).
        sub rsp, 16;
        mov [rsp + 0], r12;              // v2 = gpu_va
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gbd_tag_map_gtt];
        lea rcx, [rip + gbd_k_cap];      // k1
        mov r8, rbx;                     // v1 = cap
        lea r9, [rip + gbd_k_gpu_va];    // k2
        call klog_s1_x2;
        add rsp, 16;

        xor rax, rax;                    // GPU_BO_OK
        jmp gbd_mg_out;

      gbd_mg_bad_cap:
        mov rax, 0xFFFFFFF5;             // GPU_BO_UNKNOWN_CAP
        jmp gbd_mg_out;
      gbd_mg_live:
        mov rax, 0xFFFFFFF4;             // GPU_BO_MAPPING_LIVE
        jmp gbd_mg_out;
      gbd_mg_fwd:
        // rax already carries the gtt_bind error (0xFFFFFFDB..DF band).

      gbd_mg_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_map_ppgtt(bo_cap, ppgtt_cap, gpu_va, prot) -> i32
  //
  // Resolve the BO cap to a row, call ppgtt_bind(ppgtt_cap, gpu_va,
  // host_pa, size_pages, prot) from drivers/gpu/gpu_gtt.pdx. On OK
  // stamp mapped_in |= GPU_BO_MAPPED_PPGTT (2), bump stats, emit
  // `GPU_BO MAP_PPGTT cap=0x<16-hex> gpu_va=0x<16-hex>`.
  // ==========================================================================
  pub let gpu_bo_map_ppgtt : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bo_cap: u64) (ppgtt_cap: u64) (gpu_va: u64) (prot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 G6 [R37] (#2543): PPGTT bind orchestrator. Resolve BO cap -> row -> host_pa + size_pages; call ppgtt_bind(ppgtt_cap, gpu_va, host_pa, size_pages, prot); on OK stamp (mapped_in |= 2, gpu_va); bump GBD_ST_MAP_PPGTT; emit `GPU_BO MAP_PPGTT cap=0x<16-hex> gpu_va=0x<16-hex>` via klog_s1_x2. Returns GPU_BO_OK or GPU_BO_UNKNOWN_CAP / GPU_BO_MAPPING_LIVE / ppgtt_bind sentinels. Register plan: rbx=bo_cap, r12=ppgtt_cap, r13=gpu_va, r14=prot, r15=row_id (host_pa + size_pages re-fetched for the ppgtt_bind call via r8/r9 stack args). Five callee-save pushes land rsp%16==0 at every nested call. ppgtt_bind takes 5 args which fit in rdi..r9 cleanly (no stack spill). Labels prefixed gbd_mp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // bo_cap
        mov r12, rsi;                    // ppgtt_cap
        mov r13, rdx;                    // gpu_va
        mov r14, rcx;                    // prot

        // Resolve bo_cap -> row_id.
        mov rdi, rbx;
        call gpu_bo_cap_resolve;
        mov r10, 0xFF;
        cmp rax, r10;
        je  gbd_mp_bad_cap;
        mov r15, rax;                    // row_id

        // Already mapped in PPGTT? mapped_in & 2.
        mov rdi, r15;
        call gpu_bo_row_mapped_in;
        mov r11, 2;                      // GPU_BO_MAPPED_PPGTT
        and rax, r11;
        cmp rax, 0;
        jne gbd_mp_live;

        // Fetch host_pa + size_pages for the ppgtt_bind call. host_pa
        // must survive the second nested call, so it goes onto the
        // stack (every GPR we have free is caller-save and WOULD be
        // clobbered by the nested call; all callee-save regs rbx /
        // r12..r15 already hold live state). The spill is a single
        // push/pop pair; alignment is preserved because the pair
        // nests entirely around a single call-site.
        mov rdi, r15;
        call gpu_bo_row_host_pa;
        push rax;                        // spill host_pa (stack ==
                                         // callee-save for free)
        sub rsp, 8;                      // realign (one push unbalanced
                                         // the 5-push 16-aligned frame)
        mov rdi, r15;
        call gpu_bo_row_size_pages;
        mov rcx, rax;                    // size_pages
        add rsp, 8;                      // undo realign
        pop r10;                         // r10 = host_pa (unspilled)

        // Call ppgtt_bind(ppgtt_cap=r12, gpu_va=r13, host_pa=r10,
        //                 size_pages=rcx, prot=r14).
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r10;
        mov r8, r14;
        call ppgtt_bind;
        cmp rax, 0;
        jne gbd_mp_fwd;                  // propagate ppgtt_bind error

        // Stamp row: mapped_in |= 2, gpu_va = r13.
        mov rdi, r15;
        call gpu_bo_manifest_row_base;
        mov [rax + 16], r13;             // gpu_va
        mov r11, [rax + 24];
        or  r11, 2;                      // mapped_in |= PPGTT
        mov [rax + 24], r11;

        // Bump stats.
        mov rdi, 3;                      // GBD_ST_MAP_PPGTT
        call gbd_note;

        // Fingerprint.
        sub rsp, 16;
        mov [rsp + 0], r13;              // v2 = gpu_va
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gbd_tag_map_ppgtt];
        lea rcx, [rip + gbd_k_cap];
        mov r8, rbx;                     // v1 = cap
        lea r9, [rip + gbd_k_gpu_va];
        call klog_s1_x2;
        add rsp, 16;

        xor rax, rax;                    // GPU_BO_OK
        jmp gbd_mp_out;

      gbd_mp_bad_cap:
        mov rax, 0xFFFFFFF5;             // GPU_BO_UNKNOWN_CAP
        jmp gbd_mp_out;
      gbd_mp_live:
        mov rax, 0xFFFFFFF4;             // GPU_BO_MAPPING_LIVE
        jmp gbd_mp_out;
      gbd_mp_fwd:
        // rax already carries the ppgtt_bind error.

      gbd_mp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_unmap(bo_cap) -> u64
  //
  // Clear BOTH GTT and PPGTT bindings for the BO. Resolve cap -> row;
  // for each live binding bit in mapped_in call the matching unbind
  // (gtt_unbind for bit 0; the PPGTT unbind is NOT yet implemented
  // at wave-74 level -- the row is scrubbed regardless and the
  // follow-up slice that wires ppgtt_unbind replaces the row scrub
  // with a real walker-driven invalidation). Scrub mapped_in and
  // gpu_va to zero; bump stats.
  //
  // No fingerprint at skeleton level (the per-target emit covers the
  // forward path; a dual-unmap emit would be noise at this layer).
  // ==========================================================================
  pub let gpu_bo_unmap : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bo_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 G6 [R37] (#2543): dual-unmap. Resolve cap -> row; if mapped_in & 1 call gtt_unbind(gpu_va); then zero the row's gpu_va + mapped_in; bump GBD_ST_UNMAP. The PPGTT unbind primitive lands in a follow-up (ppgtt_bind is a validation shim at Wave 74 so there is nothing to unwind at that layer today); the row scrub itself conservatively declares the mapping gone so a subsequent map op does not refuse on GPU_BO_MAPPING_LIVE. Returns GPU_BO_OK or GPU_BO_UNKNOWN_CAP. Register plan: rbx=cap, r12=row_id, r13=gpu_va snapshot. Three callee-save pushes land rsp%16==0 at every nested call. Labels prefixed gbd_un_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // cap

        // Resolve.
        mov rdi, rbx;
        call gpu_bo_cap_resolve;
        mov r10, 0xFF;
        cmp rax, r10;
        je  gbd_un_bad_cap;
        mov r12, rax;                    // row_id

        // Snapshot gpu_va for the gtt_unbind call.
        mov rdi, r12;
        call gpu_bo_row_gpu_va;
        mov r13, rax;                    // gpu_va snapshot

        // Was mapped in GTT?
        mov rdi, r12;
        call gpu_bo_row_mapped_in;
        mov r11, 1;
        and rax, r11;
        cmp rax, 0;
        je  gbd_un_skip_gtt;
        mov rdi, r13;
        call gtt_unbind;
        // Ignore gtt_unbind sentinel at skeleton level -- a failed
        // unbind leaves the GPU state in an undefined read posture
        // that only a follow-up slice can repair; the row scrub
        // below is conservative.
      gbd_un_skip_gtt:
        // PPGTT unbind -- deferred to follow-up (see justification).

        // Scrub row: gpu_va = 0, mapped_in = 0.
        mov rdi, r12;
        call gpu_bo_manifest_row_base;
        xor r11, r11;
        mov [rax + 16], r11;
        mov [rax + 24], r11;

        // Bump stats.
        mov rdi, 4;                      // GBD_ST_UNMAP
        call gbd_note;

        xor rax, rax;                    // GPU_BO_OK
        jmp gbd_un_out;

      gbd_un_bad_cap:
        mov rax, 0xFFFFFFF5;             // GPU_BO_UNKNOWN_CAP

      gbd_un_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpu_bo_revoke(bo_cap) -> u64
  //
  // Teardown + free pages. Resolve cap -> row; unmap first (reuses
  // gpu_bo_unmap internally); phys_free(host_pa, 0); zero the manifest
  // row (host_pa = 0 is the EMPTY sentinel -- the row returns to the
  // free pool); scrub cap descriptor via cap_mint_write(slot, 0, 0, 0);
  // bump GBD_ST_REVOKE; emit `GPU_BO REVOKE cap=0x<16-hex>` via
  // klog_s1_x1.
  //
  // Returns GPU_BO_OK or GPU_BO_UNKNOWN_CAP.
  // ==========================================================================
  pub let gpu_bo_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bo_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 G6 [R37] (#2543): cap revoke + page return. Resolve cap -> row; gpu_bo_unmap (dual-unbind); phys_free(host_pa, 0); zero the manifest row (host_pa=0 is the EMPTY sentinel); cap_mint_write(slot, 0, 0, 0); bump GBD_ST_REVOKE; emit `GPU_BO REVOKE cap=0x<16-hex>` via klog_s1_x1. Returns GPU_BO_OK or GPU_BO_UNKNOWN_CAP. Register plan: rbx=cap, r12=row_id, r13=host_pa snapshot. Three callee-save pushes land rsp%16==0 at every nested call. Labels prefixed gbd_rv_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // cap

        // Resolve.
        mov rdi, rbx;
        call gpu_bo_cap_resolve;
        mov r10, 0xFF;
        cmp rax, r10;
        je  gbd_rv2_bad_cap;
        mov r12, rax;                    // row_id

        // Snapshot host_pa before unmap (unmap does not touch it, but
        // we need it in a callee-save register for phys_free below).
        mov rdi, r12;
        call gpu_bo_row_host_pa;
        mov r13, rax;                    // host_pa

        // Unmap (dual-unbind + row-mapping scrub).
        mov rdi, rbx;
        call gpu_bo_unmap;

        // Free the backing page.
        mov rdi, r13;
        xor rsi, rsi;                    // order = 0
        call phys_free;

        // Zero the manifest row -- host_pa=0 is the EMPTY sentinel.
        mov rdi, r12;
        call gpu_bo_manifest_row_base;
        xor r11, r11;
        mov [rax + 0], r11;              // host_pa = 0 (EMPTY sentinel)
        mov [rax + 8], r11;
        mov [rax + 16], r11;
        mov [rax + 24], r11;

        // Scrub cap descriptor.
        mov rdi, rbx;
        xor rsi, rsi;                    // kind = 0
        xor rdx, rdx;                    // rights = 0
        xor rcx, rcx;                    // target_ptr = 0
        call cap_mint_write;

        // Bump stats.
        mov rdi, 1;                      // GBD_ST_REVOKE
        call gbd_note;

        // Fingerprint: `GPU_BO REVOKE cap=0x<16-hex>` via klog_s1_x1.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gbd_tag_revoke];
        lea rcx, [rip + gbd_k_cap];
        mov r8, rbx;                     // v1 = cap
        call klog_s1_x1;

        xor rax, rax;                    // GPU_BO_OK
        jmp gbd_rv2_out;

      gbd_rv2_bad_cap:
        mov rax, 0xFFFFFFF5;             // GPU_BO_UNKNOWN_CAP

      gbd_rv2_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_gpu_bo_drv(rights, target_ptr, op_arg) -> u64
  //
  // KIND_GPU_BO_DRV cap_invoke dispatch handler. Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x43; je
  // call_kind_gpu_bo_drv` arm added alongside this file. Thin op
  // router over the row accessors.
  //
  //   op 0 GBD_OP_READ            -> 1 iff row live, 0 else
  //   op 1 GBD_OP_QUERY_HOST_PA   -> host_pa
  //   op 2 GBD_OP_QUERY_SIZE_PAGES -> size_pages
  //   op 3 GBD_OP_QUERY_PLACEMENT -> placement
  //   op 4 GBD_OP_QUERY_GPU_VA    -> gpu_va
  //   op 5 GBD_OP_QUERY_MAPPED_IN -> mapped_in
  //   else                        -> INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_GPU_BO_DRV_READ. target_ptr IS
  // the row_id (gpu_bo_alloc stamped it that way during mint).
  // ==========================================================================
  pub let cap_handler_gpu_bo_drv : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 G6 [R37] (#2543): KIND_GPU_BO_DRV cap_invoke dispatch. Entry chatter (klog_s1 of gbd_tag_handler_entry). op_code = op_arg & 0xFF; rights gate against R_GPU_BO_DRV_READ (single up-front check); dispatch 0..5 to the matching gpu_bo_row_* accessor via cmp cascade; else INVOKE_UNSUPPORTED. target_ptr IS the row_id (16-bit mask applied in case a future layout widens the kind to carry sub-fields). Three callee-save pushes land rsp%16==0 at every nested call. Labels prefixed gbd_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op_arg
        mov r10, 0xFF;
        and r13, r10;                    // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + gbd_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                  // R_GPU_BO_DRV_READ
        cmp r10, 0;
        je  gbd_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  gbd_hd_op_read;
        cmp r13, 1;
        je  gbd_hd_op_host_pa;
        cmp r13, 2;
        je  gbd_hd_op_size;
        cmp r13, 3;
        je  gbd_hd_op_place;
        cmp r13, 4;
        je  gbd_hd_op_gva;
        cmp r13, 5;
        je  gbd_hd_op_mapped;
        jmp gbd_hd_unsup;

      gbd_hd_op_read:
        mov rdi, r12;
        call gpu_bo_row_valid;
        jmp gbd_hd_out;

      gbd_hd_op_host_pa:
        mov rdi, r12;
        call gpu_bo_row_host_pa;
        jmp gbd_hd_out;

      gbd_hd_op_size:
        mov rdi, r12;
        call gpu_bo_row_size_pages;
        jmp gbd_hd_out;

      gbd_hd_op_place:
        mov rdi, r12;
        call gpu_bo_row_placement;
        jmp gbd_hd_out;

      gbd_hd_op_gva:
        mov rdi, r12;
        call gpu_bo_row_gpu_va;
        jmp gbd_hd_out;

      gbd_hd_op_mapped:
        mov rdi, r12;
        call gpu_bo_row_mapped_in;
        jmp gbd_hd_out;

      gbd_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp gbd_hd_out;

      gbd_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      gbd_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx needs ONE new call alongside the Wave 74 ppgtt_bind_
  // reset / gpu_gtt_table_reset etc.:
  //
  //   call gpu_bo_drv_table_reset;    // defensive zero (optional at real
  //                               // boot: .bss zero-init already clears
  //                               // the manifest and the stats)
  //
  // Wiring is deferred to a follow-up slice to keep this skeleton PR
  // minimal (same discipline every other `*_table_reset` boot wiring
  // follows -- see e.g. firmware_blob_table_reset which was declared
  // in Wave 59 I7 and wired a slice later). At real boot .bss zero-
  // init leaves the manifest empty, so gpu_bo_alloc's first call still
  // mints row 0 correctly even without the wiring.
  // ==========================================================================
}
