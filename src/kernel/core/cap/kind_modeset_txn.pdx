// src/kernel/core/cap/kind_modeset_txn.pdx — R36.M3-001 (#1244)
//
// KIND_MODESET_TXN = 0x171, derived over KIND_IPC_ENDPOINT (5). LINEAR.
//
// One in-flight atomic modeset transaction: the endpoint the caller
// runs the session on, the KIND_DISPLAY_OUTPUT the transaction acts
// against, its FSM state, and (once set_mode has run) the
// KIND_DISPLAY_MODE the transaction will arm.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS, AND WHY LINEAR
// =============================================================================
//
// Atomic modeset is a MULTI-STEP protocol: begin_txn -> set_mode ->
// set_plane* -> (commit | abort). Every step reads and refines the row
// the previous one wrote. A capability whose ROW A CHILD COULD MINT
// against would let two holders drive the same transaction to two
// different terminal states -- one commits, one aborts, and the last
// register write wins. The row is the transaction; there must be no
// second holder.
//
// This is what LINEAR means here: R_MODESET_TXN_MINT (0x200) is
// DELIBERATELY absent from R_MODESET_TXN_ALL, which the mint's
// rights_valid gate enforces. A caller that attempts to re-parent (mint
// a fresh KIND_MODESET_TXN citing another as parent) fails
// mst_rights_valid and never reaches tail_alloc. §3 records the
// discipline plainly next to the mask.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// Like every KIND_IPC_ENDPOINT-derived kind in this tree (KIND_FW_SESSION,
// KIND_EC_QUERY, KIND_HID_EVENT, ...), THE KIND HALF OF THIS GATE
// DISCRIMINATES NOTHING -- every endpoint in the system is a
// KIND_IPC_ENDPOINT. The mint additionally requires:
//
//   (a) txn_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (NO_ENDPOINT); the endpoint id is INHERITED from the parent's
//       target_ptr[15:0] and stashed on the row for the fanout path
//   (c) output_slot fits in u32 -- the KIND_DISPLAY_OUTPUT the txn will
//       act against; the caller supplies this rather than an inherited
//       field because a modeset is not scoped to the endpoint of the
//       conversation, it is scoped to the panel being reprogrammed
//   (d) initial state is always MTX_STATE_OPEN (0); a caller cannot
//       mint into MODE_SET / PLANE_SET / COMMITTING / ABORTED
//   (e) mode_slot is 0 at mint (no mode chosen yet); set_mode is a
//       transition performed through modeset_channel, not at mint
//   (f) rights subset of R_MODESET_TXN_ALL (which excludes R_MINT)
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  txn_key  (u64)
//   [+16] body1:   endpoint_slot[31:0] | output_slot[63:32]
//   [+24] body2:   state[7:0]  | mode_slot[39:8] | linear_flag[47:40]
//
// linear_flag is stamped to 1 at mint by mst_body2_pack and is READ
// ONLY as a witness -- it is a documented invariant, not a runtime
// discriminator; the actual LINEAR enforcement is in rights_valid.
//
// state is the ONE mutable field: modeset_channel writes it through
// mst_row_transition (state-machine helper), NOT through any
// invocation on this kind. Every op reachable through cap_handler_
// modeset_txn is a QUERY.
//
// =============================================================================
// §3  LEAF, AND LINEAR
// =============================================================================
//
// R_MODESET_TXN_MINT (0x200) is DELIBERATELY ABSENT from
// R_MODESET_TXN_ALL. No cap in this tree derives from a KIND_MODESET_TXN.
// The absence is the LINEAR discipline: rights_valid enforces
// (rights & ~ALL) == 0, so a caller asking for R_MINT is refused
// BAD_RIGHTS before the row is claimed.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF730..0xFFFFF73F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: hpd_isr 0xFFFFF740..4F;
// adjacent free bands below: kind_display_mode 0xFFFFF720..2F).

module KindModesetTxn = structure {

  pub let KIND_MODESET_TXN            : u64 = 0x171
  pub let MODESET_TXN_PARENT_KIND     : u64 = 5           // = KIND_IPC_ENDPOINT

  // FSM state ordinals (§1). Mint is always into OPEN.
  pub let MTX_STATE_OPEN       : u64 = 0
  pub let MTX_STATE_MODE_SET   : u64 = 1
  pub let MTX_STATE_PLANE_SET  : u64 = 2
  pub let MTX_STATE_COMMITTING : u64 = 3
  pub let MTX_STATE_ABORTED    : u64 = 4
  pub let MTX_STATE_MAX        : u64 = 4

  // Rights. LEAF LINEAR — RIGHT_MINT (0x200) NOT in the mask (§3).
  pub let R_MODESET_TXN_READ    : u64 = 0x001
  pub let R_MODESET_TXN_INVOKE  : u64 = 0x008
  pub let R_MODESET_TXN_REVOKE  : u64 = 0x010
  pub let R_MODESET_TXN_OBSERVE : u64 = 0x400
  pub let R_MODESET_TXN_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let MTX_OP_QUERY_KEY      : u64 = 0
  pub let MTX_OP_QUERY_ENDPOINT : u64 = 1
  pub let MTX_OP_QUERY_OUTPUT   : u64 = 2
  pub let MTX_OP_QUERY_STATE    : u64 = 3
  pub let MTX_OP_QUERY_MODE     : u64 = 4
  pub let MTX_OP_DEBUG_PRINT    : u64 = 5
  pub let MTX_OP_MAX            : u64 = 5

  // Failure taxonomy — 0xFFFFF730..0xFFFFF73F.
  pub let MTX_OK                : u64 = 0
  pub let MTX_TAIL_ENOSPC       : u64 = 0xFFFFF73F
  pub let MTX_TAIL_BAD_ARG      : u64 = 0xFFFFF73E
  pub let MTX_MINT_BAD_PARENT   : u64 = 0xFFFFF73D
  pub let MTX_MINT_BAD_RIGHTS   : u64 = 0xFFFFF73C
  pub let MTX_MINT_BAD_STATE    : u64 = 0xFFFFF73B
  pub let MTX_MINT_NO_ENDPOINT  : u64 = 0xFFFFF73A
  pub let MTX_MINT_NO_KEY       : u64 = 0xFFFFF739
  pub let MTX_MINT_IN_USE       : u64 = 0xFFFFF738
  pub let MTX_MINT_ENOSPC       : u64 = 0xFFFFF737
  pub let MTX_BAD_SLOT          : u64 = 0xFFFFF736
  pub let MTX_WRONG_KIND        : u64 = 0xFFFFF735
  pub let MTX_REVOKE_ALREADY    : u64 = 0xFFFFF734
  pub let MTX_LINEAR_REFUSED    : u64 = 0xFFFFF733
  pub let MTX_BAD_TRANSITION    : u64 = 0xFFFFF732

  pub let MTX_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let MTX_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride — total 256 bytes as [u64; 32].
  pub let MTX_MAX       : u64 = 8
  pub let MTX_ROW_BYTES : u64 = 32

  pub let mut _modeset_txn_table : [u64; 32] = uninit @align(64)
  pub let mut _modeset_txn_stats : [u64; 4]  = uninit @align(64)

  pub let MTX_ST_MINTS       : u64 = 0
  pub let MTX_ST_REVOKES     : u64 = 1
  pub let MTX_ST_TRANSITIONS : u64 = 2
  pub let MTX_ST_REFUSED     : u64 = 3

  pub let mtx_dbg_msg : [u8; 15] = "MODESET TXN ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let modeset_txn_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): clear the MODESET TXN row table and its counters. Boot and teardown only. Labels prefixed mtx_rs_.",
      block: {
        lea r10, [rip + _modeset_txn_table];
        xor rax, rax;
        xor rcx, rcx;
      mtx_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  mtx_rs_rows;

        lea r10, [rip + _modeset_txn_stats];
        xor rcx, rcx;
      mtx_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  mtx_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let mtx_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-001 (#1244): 1 iff s <= MTX_STATE_MAX (4). Labels prefixed mtx_sv_.",
      block: {
        cmp rdi, 4;
        ja  mtx_sv_no;
        mov rax, 1;
        ret;
      mtx_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let mtx_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-001 (#1244): subset test against R_MODESET_TXN_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — LINEAR (§3). A caller asking for R_MINT trips this before reaching tail_alloc. Labels prefixed mtx_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne mtx_rgv_no;
        mov rax, 1;
        ret;
      mtx_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let mtx_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): counter bump. Labels prefixed mtx_nt_.",
      block: {
        cmp rdi, 4;
        jae mtx_nt_out;
        lea r10, [rip + _modeset_txn_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      mtx_nt_out:
        ret
      }
    }

  pub let mtx_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): counter read. Labels prefixed mtx_st_.",
      block: {
        cmp rdi, 4;
        jae mtx_st_zero;
        lea r10, [rip + _modeset_txn_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      mtx_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let mtx_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): §1 gate. parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Kind check alone discriminates NOTHING; additional mint gates cover the rest. Labels prefixed mtx_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae mtx_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne mtx_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  mtx_cp_no;

        mov rax, 1;
        ret;
      mtx_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let mtx_parent_endpoint_id : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): read endpoint id from parent's target_ptr[15:0]. 0 if bad slot or wrong kind. Labels prefixed mtx_pe_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae mtx_pe_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne mtx_pe_no;

        mov rax, [rax + 16];
        and rax, 0xFFFF;
        ret;
      mtx_pe_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let mtx_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-001 (#1244): (parent_slot << 8). Labels prefixed mtx_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae mtx_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      mtx_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let mtx_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (output_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-001 (#1244): pack endpoint_slot[31:0] | output_slot[63:32]. Refuses out-of-range. Labels prefixed mtx_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  mtx_b1_bad;
        cmp rsi, r10;
        ja  mtx_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      mtx_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let mtx_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (state: u64) (mode_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-001 (#1244): pack state[7:0] | mode_slot[39:8] | linear_flag[47:40]=1. Refuses out-of-range. Labels prefixed mtx_b2_.",
      block: {
        cmp rdi, 4;                      // MTX_STATE_MAX
        ja  mtx_b2_bad;
        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  mtx_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, 1;                      // linear_flag = 1
        shl r10, 40;
        or  rax, r10;
        ret;
      mtx_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free — THE ONE WRITER of _modeset_txn_table.
  // ==========================================================================

  pub let mtx_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (txn_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): claim one MODESET TXN row. THE ONE WRITER of _modeset_txn_table. Gates: hdr in_use pre-set -> BAD_ARG; txn_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows of 32 bytes. Labels prefixed mtx_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne mtx_ta_bad;

        cmp r13, 0;
        je  mtx_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  mtx_ta_bad;
        cmp r15, r10;
        je  mtx_ta_bad;

        xor rbx, rbx;
      mtx_ta_scan:
        cmp rbx, 8;
        jae mtx_ta_enospc;

        lea r10, [rip + _modeset_txn_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mtx_ta_claim;

        add rbx, 1;
        jmp mtx_ta_scan;

      mtx_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp mtx_ta_out;

      mtx_ta_enospc:
        mov rax, 0xFFFFF73F;
        jmp mtx_ta_out;
      mtx_ta_bad:
        mov rax, 0xFFFFF73E;

      mtx_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let mtx_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): 1 iff row_id < MAX and in_use. Labels prefixed mtx_tvr_.",
      block: {
        cmp rdi, 8;
        jae mtx_tvr_no;
        lea r10, [rip + _modeset_txn_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mtx_tvr_no;
        mov rax, 1;
        ret;
      mtx_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let mtx_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): scrub one row. Labels prefixed mtx_tf_.",
      block: {
        cmp rdi, 8;
        jae mtx_tf_out;
        lea r10, [rip + _modeset_txn_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      mtx_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let mtx_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): txn_key. Labels prefixed mtx_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_rk_bad;
        lea r10, [rip + _modeset_txn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp mtx_rk_out;
      mtx_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mtx_rk_out:
        pop r12;
        ret
      }
    }

  pub let mtx_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): endpoint_slot. Labels prefixed mtx_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_re_bad;
        lea r10, [rip + _modeset_txn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp mtx_re_out;
      mtx_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mtx_re_out:
        pop r12;
        ret
      }
    }

  pub let mtx_row_output : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): output_slot. Labels prefixed mtx_ro_.",
      block: {
        push r12;
        mov r12, rdi;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_ro_bad;
        lea r10, [rip + _modeset_txn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp mtx_ro_out;
      mtx_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mtx_ro_out:
        pop r12;
        ret
      }
    }

  pub let mtx_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): state ordinal. Labels prefixed mtx_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_rst_bad;
        lea r10, [rip + _modeset_txn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp mtx_rst_out;
      mtx_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mtx_rst_out:
        pop r12;
        ret
      }
    }

  pub let mtx_row_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): mode_slot. 0 until set_mode has run. Labels prefixed mtx_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_rm_bad;
        lea r10, [rip + _modeset_txn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 8;
        and rax, 0xFFFFFFFF;
        jmp mtx_rm_out;
      mtx_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      mtx_rm_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // mtx_row_transition(row_id, new_state, new_mode_slot) — the ONE MUTATOR
  // of state/mode fields. modeset_channel's FSM-arbitrated transitions
  // route through here; no invocation on this kind mutates state.
  // ==========================================================================

  pub let mtx_row_transition : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) (new_mode_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): mutate state (+/- mode_slot) on one row. modeset_channel's FSM validator is the only intended caller; this helper does NOT check FSM-legality (that is modeset_channel's job) but it DOES enforce state_valid + mode_slot fits u32. Labels prefixed mtx_rt_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_rt_bad;

        mov rdi, r13;
        call mtx_state_valid;
        cmp rax, 0;
        je  mtx_rt_bad;

        mov r10, 0xFFFFFFFF;
        cmp r14, r10;
        ja  mtx_rt_bad;

        // Rebuild body2 keeping linear_flag=1.
        mov rdi, r13;
        mov rsi, r14;
        call mtx_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  mtx_rt_bad;

        lea r10, [rip + _modeset_txn_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov [r10 + 24], rax;

        mov rdi, 2;                      // MTX_ST_TRANSITIONS
        call mtx_note;
        xor rax, rax;
        jmp mtx_rt_out;

      mtx_rt_bad:
        mov rax, 0xFFFFF732;             // BAD_TRANSITION
      mtx_rt_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let mtx_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (txn_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-001 (#1244): live row holding this txn_key, or ROW_NONE. Refuses to match 0. Labels prefixed mtx_fk_.",
      block: {
        cmp rdi, 0;
        je  mtx_fk_none;
        xor rcx, rcx;
      mtx_fk_scan:
        cmp rcx, 8;
        jae mtx_fk_none;
        lea r10, [rip + _modeset_txn_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mtx_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  mtx_fk_hit;
      mtx_fk_next:
        add rcx, 1;
        jmp mtx_fk_scan;
      mtx_fk_hit:
        mov rax, rcx;
        ret;
      mtx_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let mtx_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): slot -> row_id, gated on live KIND_MODESET_TXN. Labels prefixed mtx_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae mtx_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x171;
        cmp r10, r11;
        jne mtx_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_ros_none;

        mov rax, r12;
        jmp mtx_ros_out;

      mtx_ros_none:
        mov rax, 0xFF;
      mtx_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Five args (slot, parent_slot, rights, txn_key, output_slot).
  // Initial state is always OPEN; mode_slot is always 0 at mint.
  // ==========================================================================

  pub let modeset_txn_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (txn_key: u64) (output_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): mint KIND_MODESET_TXN over KIND_IPC_ENDPOINT. LINEAR — rights_valid refuses R_MINT. Sequence: slot<256; check_parent; parent_endpoint_id non-zero (NO_ENDPOINT); output_slot fits u32; rights_valid (R_MINT trip is LINEAR_REFUSED); txn_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed mtx_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // txn_key
        mov r15, r8;                     // output_slot

        mov r10, 256;
        cmp rbx, r10;
        jae mtx_mi_bad_slot;

        mov rdi, r12;
        call mtx_check_parent;
        cmp rax, 0;
        je  mtx_mi_bad_parent;

        mov rdi, r12;
        call mtx_parent_endpoint_id;
        cmp rax, 0;
        je  mtx_mi_no_endpoint;
        mov rbp, rax;                    // inherited endpoint id (kept in low u32)

        mov r10, 0xFFFFFFFF;
        cmp r15, r10;
        ja  mtx_mi_bad_slot;

        // LINEAR enforcement: a caller asking for R_MINT (0x200) fails
        // rights_valid because R_MINT is NOT in R_MODESET_TXN_ALL (0x419).
        mov r10, 0x200;
        and r10, r13;
        cmp r10, 0;
        jne mtx_mi_linear_refused;

        mov rdi, r13;
        call mtx_rights_valid;
        cmp rax, 0;
        je  mtx_mi_bad_rights;

        cmp r14, 0;
        je  mtx_mi_no_key;

        mov rdi, r14;
        call mtx_find_by_key;
        cmp rax, 0xFF;
        jne mtx_mi_in_use;

        // Body1 pack: (endpoint_id_low_u32, output_slot).
        mov rdi, rbp;
        mov rsi, r15;
        call mtx_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  mtx_mi_bad_state;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack: (state=OPEN, mode_slot=0).
        mov rdi, 0;
        mov rsi, 0;
        call mtx_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  mtx_mi_bad_state;
        mov r15, rax;                    // body2
        push r11;
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call mtx_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  mtx_mi_bad_parent;

        // tail_alloc(hdr, txn_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call mtx_tail_alloc;

        mov r10, 0xFFFFF73F;
        cmp rax, r10;
        je  mtx_mi_enospc;
        mov r10, 0xFFFFF73E;
        cmp rax, r10;
        je  mtx_mi_bad_state;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x171;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call mtx_note;

        xor rax, rax;
        jmp mtx_mi_out;

      mtx_mi_bad_slot:
        mov rax, 0xFFFFF736;
        jmp mtx_mi_out;
      mtx_mi_bad_parent:
        mov rax, 0xFFFFF73D;
        jmp mtx_mi_out;
      mtx_mi_bad_rights:
        mov rax, 0xFFFFF73C;
        jmp mtx_mi_out;
      mtx_mi_bad_state:
        mov rax, 0xFFFFF73B;
        jmp mtx_mi_out;
      mtx_mi_no_endpoint:
        mov rax, 0xFFFFF73A;
        jmp mtx_mi_out;
      mtx_mi_no_key:
        mov rax, 0xFFFFF739;
        jmp mtx_mi_out;
      mtx_mi_in_use:
        mov rdi, 3;
        call mtx_note;
        mov rax, 0xFFFFF738;
        jmp mtx_mi_out;
      mtx_mi_enospc:
        mov rdi, 3;
        call mtx_note;
        mov rax, 0xFFFFF737;
        jmp mtx_mi_out;
      mtx_mi_linear_refused:
        mov rdi, 3;
        call mtx_note;
        mov rax, 0xFFFFF733;

      mtx_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let modeset_txn_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (txn_key: u64) (output_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call modeset_txn_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x171;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let modeset_txn_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): revoke KIND_MODESET_TXN. Labels prefixed mtx_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae mtx_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  mtx_rvk_already;

        mov r11, 0x171;
        cmp r10, r11;
        jne mtx_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call mtx_tail_valid;
        cmp rax, 0;
        je  mtx_rvk_clear;

        mov rdi, r13;
        call mtx_tail_free;

      mtx_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call mtx_note;

        xor rax, rax;
        jmp mtx_rvk_out;

      mtx_rvk_bad_slot:
        mov rax, 0xFFFFF736;
        jmp mtx_rvk_out;
      mtx_rvk_wrong_kind:
        mov rax, 0xFFFFF735;
        jmp mtx_rvk_out;
      mtx_rvk_already:
        mov rax, 0xFFFFF734;

      mtx_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let modeset_txn_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call modeset_txn_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x171;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler. Queries only; state mutation is modeset_channel's
  // job through mtx_row_transition (arity-three, no operand slot).
  // ==========================================================================

  pub let cap_handler_modeset_txn : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M3-001 (#1244): KIND_MODESET_TXN dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed mtx_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_modeset_txn_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne mtx_hn_res;

        cmp rbp, 5;
        ja  mtx_hn_unsup;

        cmp rbp, 5;
        je  mtx_hn_dbg;

        // Ops 0..4: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  mtx_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  mtx_hn_key;
        cmp rbp, 1;
        je  mtx_hn_ep;
        cmp rbp, 2;
        je  mtx_hn_out;
        cmp rbp, 3;
        je  mtx_hn_st;
        call mtx_row_mode;
        jmp mtx_hn_out2;

      mtx_hn_key:
        call mtx_row_key;
        jmp mtx_hn_out2;
      mtx_hn_ep:
        call mtx_row_endpoint;
        jmp mtx_hn_out2;
      mtx_hn_out:
        call mtx_row_output;
        jmp mtx_hn_out2;
      mtx_hn_st:
        call mtx_row_state;
        jmp mtx_hn_out2;

      mtx_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  mtx_hn_denied;
        xor rax, rax;
        jmp mtx_hn_out2;

      mtx_hn_res:
        mov rax, 0xFFFFF73E;
        jmp mtx_hn_out2;
      mtx_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp mtx_hn_out2;
      mtx_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      mtx_hn_out2:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
