  // Slot -> row_id, gated on the descriptor being a live
  // KIND_AHCI_PORT.  Kind constant 0x19B staged in r11.
  pub let ahci_port_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M5-004 (#1660): slot -> row_id gated on KIND_AHCI_PORT. Labels prefixed ahcip_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae ahcip_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x19B;                  // KIND_AHCI_PORT
        cmp r10, r11;
        jne ahcip_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_ros_none;

        mov rax, r12;
        jmp ahcip_ros_out;

      ahcip_ros_none:
        mov rax, 0xFF;                   // AHCIP_ROW_NONE
      ahcip_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_cascade_revoke_blkdev(port_row_id) -> u64
  //
  // R51.M5-006 (#1662): walk cap_table for KIND_BLKDEV descriptors
  // whose target_ptr[15:0] == port_row_id AND target_ptr[23:16] ==
  // AHCIP_FAMILY_AHCI (2), and scrub each in place.  The family-byte
  // match (in addition to row_id) is REQUIRED here -- it is the one
  // place this cascade's shape differs from
  // nvme_ns_cascade_revoke_blkdev's: _ahci_port_table and
  // _nvme_namespace_table are SEPARATE tables that both index
  // 0..AHCIP_MAX-1 / 0..NVMEN_MAX-1, so a bare row_id number is
  // ambiguous across families -- without the family check this
  // cascade could scrub an unrelated NVMe-family KIND_BLKDEV
  // descriptor that happens to share the same numeric row_id in the
  // OTHER table (design §4.5's family byte exists precisely to make
  // this disambiguation possible).
  //
  // Returns the count of KIND_BLKDEV children scrubbed.  Registers:
  //   rbx = slot cursor, r12 = target port_row_id, r13 = count, r14 =
  //   scratch descriptor addr.  Four callee-save pushes leave
  //   rsp%16 == 0.
  // ==========================================================================
  pub let ahci_port_cascade_revoke_blkdev : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (port_row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M5-006 (#1662): cascade-revoke KIND_BLKDEV dual-kind children of a KIND_AHCI_PORT row. Iterate slot in 0..256; load descriptor kind at cap_table + slot*24; skip if != KIND_BLKDEV_TAG (0x42). Extract target_ptr[15:0] (row_id) AND target_ptr[23:16] (family); scrub only when row_id matches port_row_id AND family == AHCIP_FAMILY_AHCI (2) -- the family check disambiguates row_id collisions against the separate _nvme_namespace_table (mirrors nvme_ns_cascade_revoke_blkdev's shape, extended one field for the family disambiguation the NVMe cascade doesn't need). Scrub via cap_mint_write(slot, 0, 0, 0). Cap_table stride 24 bytes. Kind/family constants fit imm32; staged in r11. Four callee-save pushes leave rsp%16 == 0. Labels prefixed ahcip_crb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        and r12, 0xFFFF;                 // target port_row_id (u16)
        xor r13, r13;                    // count
        xor rbx, rbx;                    // slot cursor

      ahcip_crb_loop:
        cmp rbx, 256;
        jae ahcip_crb_done;

        mov rax, cap_table;
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r14, rax;                    // r14 = desc addr

        mov r10, [r14 + 0];
        mov r11, 0x42;                   // KIND_BLKDEV_TAG
        cmp r10, r11;
        jne ahcip_crb_skip;

        mov r10, [r14 + 16];
        mov r11, r10;
        and r11, 0xFFFF;                 // row_id
        cmp r11, r12;
        jne ahcip_crb_skip;

        mov r11, r10;
        shr r11, 16;
        and r11, 0xFF;                   // family
        cmp r11, 2;                      // AHCIP_FAMILY_AHCI
        jne ahcip_crb_skip;

        // Match: scrub descriptor.
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add r13, 1;

      ahcip_crb_skip:
        add rbx, 1;
        jmp ahcip_crb_loop;

      ahcip_crb_done:
        mov rdi, 6;                      // AHCIP_ST_CASCADES
        call ahci_port_note;
        mov rax, r13;

        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_cap_revoke(row_id) -> u64
  //
  // R51.M5-004 (#1660) + R51.M5-006 (#1662): scrub the row and bumps
  // REVOKES; distinguishes never-existed (BAD_SLOT) from already-gone
  // (REVOKE_ALREADY).
  //
  // REVOKE CASCADE POSTURE.  Per design/hardware/ahci-substrate.md §7
  // #1662 ("Every port revoke itself scrubs the dual-kind KIND_BLKDEV
  // descriptor that shares the row"), the cascade now runs BEFORE
  // tail_free (same ordering nvme_ns_cap_revoke uses): the KIND_BLKDEV
  // descriptors are scrubbed first via cap_mint_write, then this row
  // itself is freed.
  // ==========================================================================
  pub let ahci_port_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M5-004 (#1660) + R51.M5-006 (#1662): scrub row + bump REVOKES; distinguishes never-existed (BAD_SLOT) from already-gone (REVOKE_ALREADY). Cascades to the dual-kind KIND_BLKDEV child via ahci_port_cascade_revoke_blkdev BEFORE tail_free, matching nvme_ns_cap_revoke's own ordering; that helper's own cap_mint_write use brings the effects/capabilities up to {mem, sysreg} @{cap}. Two callee-save pushes leave rsp%16 == 0. Labels prefixed ahcip_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 32;
        jae ahcip_cr_bad_slot;

        mov rdi, r12;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_cr_already;

        // Cascade first: scrub every KIND_BLKDEV whose target_ptr
        // names this row (and carries family == AHCI).
        mov rdi, r12;
        call ahci_port_cascade_revoke_blkdev;

        // Now scrub our own row.
        mov rdi, r12;
        call ahci_port_tail_free;
        mov rdi, 1;                      // AHCIP_ST_REVOKES
        call ahci_port_note;
        xor rax, rax;
        jmp ahcip_cr_out;

      ahcip_cr_bad_slot:
        mov rax, 0xFFFFEC96;             // AHCIP_BAD_SLOT
        jmp ahcip_cr_out;
      ahcip_cr_already:
        mov rax, 0xFFFFEC97;             // AHCIP_REVOKE_ALREADY

      ahcip_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_cascade_revoke_by_ctrl(ctrl_row_id) -> u64
  //
  // R51.M5-006 (#1662): iterate _ahci_port_table for rows whose
  // parent_ctrl_row matches, and call ahci_port_cap_revoke on each
  // (which itself cascades one level deeper to the dual-kind
  // KIND_BLKDEV child).  Wired into ahci_ctrl_cap_revoke
  // (kind_ahci_controller.pdx) so tearing down a controller-cap
  // cascades two levels deep, mirroring nvme_ns_cascade_revoke_by_ctrl's
  // own wiring into nvme_ctrl_cap_revoke.
  //
  // Returns the count of port rows revoked.  Register plan:
  //   rbx = row cursor, r12 = target ctrl_row_id, r13 = count.  Four
  //   callee-save pushes leave rsp%16 == 0 for the nested
  //   ahci_port_cap_revoke calls.
  // ==========================================================================
  pub let ahci_port_cascade_revoke_by_ctrl : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (ctrl_row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M5-006 (#1662): walk _ahci_port_table for rows whose parent_ctrl_row matches, and revoke each (which itself cascades to the dual-kind KIND_BLKDEV child via ahci_port_cascade_revoke_blkdev). Preserves ctrl_row_id in r12 and count in r13 across the inner revoke call. Bounds-checked; a row with in_use == 0 is skipped without touching. Four callee-save pushes leave rsp%16 == 0. Mirrors nvme_ns_cascade_revoke_by_ctrl one-for-one (design §7 #1662). Labels prefixed ahcip_ccr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        and r12, 0xFFFF;                 // target ctrl_row
        xor r13, r13;                    // count
        xor rbx, rbx;                    // cursor

      ahcip_ccr_loop:
        cmp rbx, 32;                     // AHCIP_MAX
        jae ahcip_ccr_done;

        lea r10, [rip + _ahci_port_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        // Skip free rows (in_use == 0).
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ahcip_ccr_skip;

        // Compare parent_ctrl_row.
        mov rax, [r10 + 32];
        and rax, 0xFFFF;
        cmp rax, r12;
        jne ahcip_ccr_skip;

        // Match: revoke this port row (cascades further to
        // KIND_BLKDEV).
        mov rdi, rbx;
        call ahci_port_cap_revoke;
        add r13, 1;

      ahcip_ccr_skip:
        add rbx, 1;
        jmp ahcip_ccr_loop;

      ahcip_ccr_done:
        mov rax, r13;

        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_cap_mint_inner(parent_slot, rights, port_index,
  //                          sector_size, block_count, parent_ctrl_row)
  //   -> row_id | AHCIP_MINT_BAD_*
  //
  // R51.M5-004 (#1660): the KIND_AHCI_PORT mint walker.  Gates in
  // order:
  //   (1) parent gate (KIND_AHCI_CONTROLLER + R_AHCIC_MINT_PORT);
  //   (2) rights subset (R_AHCIP_ALL);
  //   (3) port_index_valid;
  //   (4) sector_valid;
  //   (5) blocks_valid;
  //   (6) ctrl_row_valid (parent controller row must be live);
  //   (7) hdr_pack (port_slot = 0 placeholder, state = MINTED);
  //   (8) meta pack (family baked in) + tail_alloc.
  //
  // Exactly six primitive args -- no params_ptr needed (contrast: the
  // M5-006 dual-kind mint, which needs one per design §4.1).  Six
  // callee-save pushes + sub rsp, 40 = 88 bytes; entry rsp%16==8 ->
  // post-prologue rsp%16 == 0.  Matches nvme_ns_cap_mint_inner's exact
  // register/stack-spill plan (design §1 row 8: "same shape").
  // ==========================================================================
  pub let ahci_port_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) (port_index: u64) (sector_size: u64) (block_count: u64) (parent_ctrl_row: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M5-004 (#1660): the KIND_AHCI_PORT mint walker. Gate sequence: parent (KIND_AHCI_CONTROLLER + R_AHCIC_MINT_PORT), rights subset, port_index bound, sector_size in {512,4096}, block_count > 0, parent_ctrl_row liveness, hdr_pack, meta pack, tail_alloc. Six argument slots: two in callee-save registers (r12=parent_slot, r13=rights), four spilled to [rsp+0..24] (port_index/sector_size/block_count/parent_ctrl_row) since only two callee-save registers are free once meta/hdr intermediates need r14/r15/rbp across the tail_alloc call. Prologue: 6 callee-save pushes + sub rsp,40 = 88 bytes; entry rsp%16==8 -> post-prologue rsp%16==0. Bumps AHCIP_ST_MINTS on success, AHCIP_ST_REFUSED on any BAD_* path. Labels prefixed ahcip_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 40;                     // 32 B spill + 8 B align pad

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov [rsp + 0],  rdx;             // port_index
        mov [rsp + 8],  rcx;             // sector_size
        mov [rsp + 16], r8;              // block_count
        mov [rsp + 24], r9;              // parent_ctrl_row

        // (1) Parent gate.
        mov rdi, r12;
        call ahci_port_check_parent_ctrl;
        cmp rax, 0;
        je  ahcip_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call ahci_port_rights_valid;
        cmp rax, 0;
        je  ahcip_mi_bad_rights;

        // (3) port_index_valid.
        mov rdi, [rsp + 0];
        call ahci_port_index_valid;
        cmp rax, 0;
        je  ahcip_mi_bad_port;

        // (4) sector_valid.
        mov rdi, [rsp + 8];
        call ahci_port_sector_valid;
        cmp rax, 0;
        je  ahcip_mi_bad_sector;

        // (5) blocks_valid.
        mov rdi, [rsp + 16];
        call ahci_port_blocks_valid;
        cmp rax, 0;
        je  ahcip_mi_bad_blocks;

        // (6) ctrl_row live.
        mov rdi, [rsp + 24];
        call ahci_port_ctrl_row_valid;
        cmp rax, 0;
        je  ahcip_mi_bad_ctrl_row;

        // (7) Pack header with port_slot = 0 placeholder, state = MINTED.
        xor rdi, rdi;                    // port_slot = 0
        mov rsi, 1;                      // AHCIP_STATE_MINTED
        call ahci_port_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahcip_mi_bad_port;
        mov r14, rax;                    // r14 = hdr

        // (8) Meta pack: (parent_ctrl_row); family/features baked in.
        mov rdi, [rsp + 24];             // parent_ctrl_row
        call ahci_port_tail_pack_meta;
        mov r15, rax;                    // r15 = meta

        // (9) tail_alloc(hdr, port_index, sector_size, block_count, meta).
        mov rdi, r14;                    // hdr
        mov rsi, [rsp + 0];              // port_index
        mov rdx, [rsp + 8];              // sector_size
        mov rcx, [rsp + 16];             // block_count
        mov r8,  r15;                    // meta
        call ahci_port_tail_alloc;
        mov r10, 32;                     // AHCIP_MAX
        cmp rax, r10;
        jae ahcip_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // AHCIP_ST_MINTS
        call ahci_port_note;
        pop rax;
        jmp ahcip_mi_out;

      ahcip_mi_alloc_fail:
        jmp ahcip_mi_refused;
      ahcip_mi_bad_parent:
        mov rax, 0xFFFFEC84;             // AHCIP_MINT_BAD_PARENT
        jmp ahcip_mi_refused;
      ahcip_mi_bad_rights:
        mov rax, 0xFFFFEC90;             // AHCIP_MINT_BAD_RIGHTS
        jmp ahcip_mi_refused;
      ahcip_mi_bad_port:
        mov rax, 0xFFFFEC83;             // AHCIP_MINT_BAD_PORT
        jmp ahcip_mi_refused;
      ahcip_mi_bad_sector:
        mov rax, 0xFFFFEC91;             // AHCIP_MINT_BAD_SECTOR
        jmp ahcip_mi_refused;
      ahcip_mi_bad_blocks:
        mov rax, 0xFFFFEC92;             // AHCIP_MINT_BAD_BLOCKS
        jmp ahcip_mi_refused;
      ahcip_mi_bad_ctrl_row:
        mov rax, 0xFFFFEC93;             // AHCIP_MINT_BAD_CTRL_ROW

      ahcip_mi_refused:
        push rax;
        mov rdi, 3;                      // AHCIP_ST_REFUSED
        call ahci_port_note;
        pop rax;

      ahcip_mi_out:
        add rsp, 40;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_blk_rights_valid(blk_rights) -> 1 | 0
  //
  // R51.M5-006 (#1662): subset test for the KIND_BLKDEV half of the
  // dual-kind mint.  Returns 1 iff (blk_rights & 0x07) == blk_rights.
  // 0x07 = R_BLK_READ (0x01) | R_BLK_WRITE (0x02) | R_BLK_ADMIN (0x04)
  // -- the same R_BLK_ALL_TAG value nvme_ns_blk_rights_valid enforces
  // (kind_nvme_namespace.pdx).  AHCI ports carry no FLUSH/TRIM support
  // at M5 (design §4.3: features bitmap all zero; M6 gates FLUSH/TRIM
  // on the identify-parsed write-cache/DRAT bits), so R_BLK_FLUSH
  // (0x08) / R_BLK_TRIM (0x10) are refused here exactly as they are
  // for the NVMe dual-kind mint today.
  // ==========================================================================
  pub let ahci_port_blk_rights_valid : (u64) -> u64 !{} @{} =
    fn (blk_rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M5-006 (#1662): subset test against 0x07 (R_BLK_READ|R_BLK_WRITE|R_BLK_ADMIN), mirroring nvme_ns_blk_rights_valid's posture -- AHCI ports carry no FLUSH/TRIM support at M5 (design §4.3: features all zero). Labels prefixed ahci_dbv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x7;
        and rax, r10;
        cmp rax, rdi;
        jne ahci_dbv_no;
        mov rax, 1;
        ret;
      ahci_dbv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ahci_io_submit_rw(ctrl_row, port_row, opcode, lba, nblocks,
  //                    dma_iova) -> u64
  //
  // R51.M5-006 (#1662) landed a placeholder here that always returned
  // 0xEEEE so cap_handler_blkdev's family demux would compile ahead of
  // the real I/O submit path.  R51.M6-002 (#1664) REMOVES that
  // placeholder: the real implementation now lives in the new
  // drivers/ahci/io_submit.pdx (design/hardware/nvme-ahci-tail-
  // milestones.md §2.M6 #1664) -- see that file's own header for the
  // Command Header/PRDT/H2D-FIS build, PxCI ring, completion poll, and
  // PxTFD check.  cap_handler_blkdev.pdx's hblk_do_rw_ahci branch calls
  // the same symbol name unchanged; only the definition site moved.
  // ==========================================================================

  // ==========================================================================
  // ahci_port_dual_kind_mint(port_slot, blk_slot, parent_slot,
  //                          port_rights, blk_rights, params_ptr)
  //   -> row_id | error sentinel
  //
  // R51.M5-006 (#1662): the dual-kind mint (design §4).  Sequence:
  //   (1) Refuse identical slots (a caller confusion).
  //   (2) Validate blk_rights against the 0x07 KIND_BLKDEV envelope
  //       (ahci_port_blk_rights_valid).
  //   (3) Call ahci_port_cap_mint_inner to allocate the shared row +
  //       enforce every value gate + rights subset for the port.
  //   (4) Write the KIND_AHCI_PORT descriptor at port_slot with
  //       target_ptr = row_id (bits [15:0]; upper bits zero).
  //   (5) Write the KIND_BLKDEV descriptor at blk_slot with
  //       target_ptr = row_id (bits [15:0]) OR (2 << 16) (family =
  //       AHCIP_FAMILY_AHCI in bits [23:16], design §4.5) so
  //       cap_handler_blkdev's family demux routes this row to the
  //       AHCI branch.
  //   (6) Bump AHCIP_ST_DUAL_MINTS.
  //
  // params_ptr (arg 6, r9): pointer to a caller-owned 32-byte / 4-u64
  // block laid out as { port_index, sector_size, block_count,
  // parent_ctrl_row } at offsets 0/8/16/24 (design §4.2).  This
  // function's natural arity is 9 primitive u64s; paideia-as caps
  // lambda arity at 6 SysV-register args (P0276), so the trailing
  // four value args are packed behind one pointer instead -- exactly
  // nvme_ns_dual_kind_mint's own post-P0276 shape (design §4.1:
  // "Exactly 6 args, matching nvme_ns_dual_kind_mint's post-P0276
  // signature word-for-word up to naming"). Callers build the block
  // on their own stack (sub rsp, 32; four stores; pass rsp) and tear
  // it down after the call (add rsp, 32); the callee only reads it
  // and never retains the pointer past this call.
  //
  // Register plan: port_slot/blk_slot/parent_slot/port_rights/
  // blk_rights/params_ptr land in r12/r13/r14/r15/rbp/rbx
  // respectively -- six callee-save pushes, no stack spill needed
  // (the 4-u64 block lives in the CALLER's frame). Prologue: 48 B
  // pushes + sub rsp,8 (align pad) = 56 bytes; entry rsp%16 == 8 ->
  // post-prologue rsp%16 == 0 (design §4.4, §8.6).
  // ==========================================================================
  pub let ahci_port_dual_kind_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (port_slot: u64) (blk_slot: u64) (parent_slot: u64) (port_rights: u64) (blk_rights: u64) (params_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M5-006 (#1662) + P0276 fixup: dual-kind mint. Allocates one _ahci_port_table row via ahci_port_cap_mint_inner, then stamps two descriptors: KIND_AHCI_PORT at port_slot and KIND_BLKDEV at blk_slot, the latter with target_ptr = row_id | (AHCIP_FAMILY_AHCI(2) << 16) per design §4.5's family-byte demux encoding. Refuses port_slot == blk_slot (AHCIP_DUAL_BAD_SLOTS), a blk_rights outside the 0x07 KIND_BLKDEV envelope (reuses AHCIP_MINT_BAD_RIGHTS -- design's own failure taxonomy (§6) lists no dedicated dual-kind blk-rights code distinct from the port mint's rights-subset failure, so this file's already-claimed AHCIP_MINT_BAD_RIGHTS is reused for both rather than spending one of the M6-reserved spillover codes 0xFFFFEC99..0xFFFFEC9F), and cascades every underlying ahci_port_cap_mint_inner refusal verbatim. Reduced from 9 to 6 primitive args (P0276: lambda arity capped at 6 SysV-register args) by packing port_index/sector_size/block_count/parent_ctrl_row behind params_ptr, a caller-owned 4-u64 stack block read-only for the duration of this call -- exact mirror of nvme_ns_dual_kind_mint. Six callee-save pushes (port_slot=r12, blk_slot=r13, parent_slot=r14, port_rights=r15, blk_rights=rbp, params_ptr=rbx) + sub rsp,8 pad = 56 bytes; entry rsp%16 == 8 -> post-prologue %16 == 0 for every nested call. Bumps AHCIP_ST_DUAL_MINTS on success. Labels prefixed ahci_dk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // port_slot
        mov r13, rsi;                    // blk_slot
        mov r14, rdx;                    // parent_slot
        mov r15, rcx;                    // port_rights
        mov rbp, r8;                     // blk_rights
        mov rbx, r9;                     // params_ptr

        // (1) Refuse identical slots.
        cmp r12, r13;
        je  ahci_dk_bad_slots;

        // (2) blk_rights subset test.
        mov rdi, rbp;
        call ahci_port_blk_rights_valid;
        cmp rax, 0;
        je  ahci_dk_bad_blk_rights;

        // (3) Allocate the row via the port mint.  This is where
        // every value gate lives; we do NOT duplicate them here.
        mov rdi, r14;                    // parent_slot
        mov rsi, r15;                    // port_rights
        mov rdx, [rbx + 0];              // port_index
        mov rcx, [rbx + 8];              // sector_size
        mov r8,  [rbx + 16];             // block_count
        mov r9,  [rbx + 24];             // parent_ctrl_row
        call ahci_port_cap_mint_inner;
        mov r10, 32;                     // AHCIP_MAX
        cmp rax, r10;
        jae ahci_dk_inner_fail;
        mov rbx, rax;                    // rbx = row_id (params_ptr no longer needed)

        // (4) Stamp KIND_AHCI_PORT descriptor.
        mov rdi, r12;                    // slot
        mov rsi, 0x19B;                  // KIND_AHCI_PORT
        mov rdx, r15;                    // rights
        mov rcx, rbx;                    // target_ptr = row_id (bits [15:0])
        call cap_mint_write;

        // (5) Stamp KIND_BLKDEV descriptor with family = AHCI (2) in
        // bits [23:16] (design §4.5).
        mov rdi, r13;                    // slot
        mov rsi, 0x42;                   // KIND_BLKDEV_TAG
        mov rdx, rbp;                    // rights
        mov rcx, rbx;                    // row_id
        mov r10, 2;                      // AHCIP_FAMILY_AHCI
        shl r10, 16;
        or  rcx, r10;                     // target_ptr = row_id | (family << 16)
        call cap_mint_write;

        // (6) Bump DUAL_MINTS + return row_id.
        mov rdi, 5;                      // AHCIP_ST_DUAL_MINTS
        call ahci_port_note;
        mov rax, rbx;
        jmp ahci_dk_out;

      ahci_dk_bad_slots:
        mov rax, 0xFFFFEC80;             // AHCIP_DUAL_BAD_SLOTS
        jmp ahci_dk_refused;
      ahci_dk_bad_blk_rights:
        mov rax, 0xFFFFEC90;             // AHCIP_MINT_BAD_RIGHTS (reused; see justification)
        jmp ahci_dk_refused;
      ahci_dk_inner_fail:
        // rax already carries the inner sentinel; the inner mint
        // walker (ahci_port_cap_mint_inner) already bumped
        // AHCIP_ST_REFUSED so skip our note to avoid double-counting.
        jmp ahci_dk_out;

      ahci_dk_refused:
        push rax;
        mov rdi, 3;                      // AHCIP_ST_REFUSED
        call ahci_port_note;
        pop rax;

      ahci_dk_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_ahci_port(rights, target_ptr, op_arg) -> u64
  //
  // KIND_AHCI_PORT dispatch.  All ops arity-ONE (op_arg[63:8]
  // REFUSED).  QUERY ops need R_AHCIP_INVOKE (0x008); DEBUG_PRINT
  // needs R_AHCIP_OBSERVE (0x400).
  //
  //   AHCIP_OP_QUERY_PORT_INDEX  -> port_index
  //   AHCIP_OP_QUERY_SECTOR_SIZE -> sector_size
  //   AHCIP_OP_QUERY_BLOCK_COUNT -> block_count
  //   AHCIP_OP_QUERY_PARENT      -> parent_ctrl_row
  //   AHCIP_OP_QUERY_FAMILY      -> family (always 2 = AHCI)
  //   AHCIP_OP_QUERY_STATE       -> state byte
  //   AHCIP_OP_QUERY_PORT_SLOT   -> port_slot
  //   AHCIP_OP_DEBUG_PRINT       -> 0 (observability only)
  //
  // WIRED INTO cap_invoke_dispatch (invoke.pdx) AS OF R51.M5-006
  // (#1662): `mov r9, 0x19B; cmp rcx, r9; je call_kind_ahci_port;`
  // added to invoke.pdx alongside the KIND_AHCI_CONTROLLER wire-in
  // (design/hardware/ahci-substrate.md §3's file-touch table does
  // not list invoke.pdx among the R51.M5 changes; wiring both AHCI
  // dispatch entries here is a design-doc gap fill -- see the #1662
  // commit report). NOT yet reflected in kind.pdx's documentation
  // block (deferred; no functional effect).
  // ==========================================================================
  pub let cap_handler_ahci_port : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M5-004 (#1660): KIND_AHCI_PORT dispatch. QUERY ops need R_AHCIP_INVOKE; DEBUG_PRINT needs R_AHCIP_OBSERVE. Ops 0..7 are arity ONE (op_arg[63:8] refused). Five callee-save pushes leave rsp%16 == 0. Labels prefixed ahcip_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;                    // target_ptr
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id (low 16)
        mov r14, rdx;                    // op_arg

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op

        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne ahcip_hn_res;                // reserved bits set

        cmp rbp, 7;                      // ops 0..7 valid
        ja  ahcip_hn_unsup;

        cmp rbp, 7;                      // DEBUG_PRINT
        je  ahcip_hn_dbg;

        // Ops 0..6 need R_AHCIP_INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  ahcip_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  ahcip_hn_pidx;
        cmp rbp, 1;
        je  ahcip_hn_sect;
        cmp rbp, 2;
        je  ahcip_hn_bc;
        cmp rbp, 3;
        je  ahcip_hn_parent;
        cmp rbp, 4;
        je  ahcip_hn_family;
        cmp rbp, 5;
        je  ahcip_hn_state;
        // rbp == 6 (PORT_SLOT)
        call ahci_port_row_port_slot;
        jmp ahcip_hn_count;

      ahcip_hn_pidx:
        call ahci_port_row_port_index;
        jmp ahcip_hn_count;
      ahcip_hn_sect:
        call ahci_port_row_sector_size;
        jmp ahcip_hn_count;
      ahcip_hn_bc:
        call ahci_port_row_block_count;
        jmp ahcip_hn_count;
      ahcip_hn_parent:
        call ahci_port_row_parent;
        jmp ahcip_hn_count;
      ahcip_hn_family:
        call ahci_port_row_family;
        jmp ahcip_hn_count;
      ahcip_hn_state:
        call ahci_port_row_state;
        jmp ahcip_hn_count;

      ahcip_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  ahcip_hn_denied;
        xor rax, rax;
        jmp ahcip_hn_out;

      ahcip_hn_count:
        push rax;
        mov rdi, 2;                      // AHCIP_ST_QUERIES
        call ahci_port_note;
        pop rax;
        jmp ahcip_hn_out;

      ahcip_hn_res:
        mov rax, 0xFFFFEC95;             // AHCIP_TAIL_BAD_ARG
        jmp ahcip_hn_out;
      ahcip_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp ahcip_hn_out;
      ahcip_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      ahcip_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_row_cl_phys(row_id) -> u64
  //
  // R51.M6-001 (#1663): cl_iova (row word +48, repurposed from
  // "reserved" -- SECTION 1), or AHCIP_DECODE_BAD when row_id is not
  // a live row. Same one-push shape as ahci_port_row_port_index.
  // ==========================================================================
  pub let ahci_port_row_cl_phys : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M6-001 (#1663): cl_iova, or AHCIP_DECODE_BAD. Labels prefixed ahcip_rcl_.",
      block: {
        push r12;
        mov r12, rdi;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_rcl_bad;
        lea r10, [rip + _ahci_port_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 48];
        jmp ahcip_rcl_out;
      ahcip_rcl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ahcip_rcl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_row_ct_phys(row_id) -> u64
  //
  // R51.M6-001 (#1663): ct_iova (row word +56, repurposed from
  // "reserved" -- SECTION 1), or AHCIP_DECODE_BAD.
  // ==========================================================================
  pub let ahci_port_row_ct_phys : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M6-001 (#1663): ct_iova, or AHCIP_DECODE_BAD. Labels prefixed ahcip_rct_.",
      block: {
        push r12;
        mov r12, rdi;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_rct_bad;
        lea r10, [rip + _ahci_port_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 56];
        jmp ahcip_rct_out;
      ahcip_rct_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ahcip_rct_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_row_write_cache_present(row_id) -> u64
  //
  // R51.M6-004 (#1666): 1 iff the row's features byte (word +32, bits
  // [31:24]) has AHCIP_FEATURE_WRITE_CACHE_PRESENT (bit 3) set; 0 if
  // clear; AHCIP_DECODE_BAD when row_id is not a live row. Every row
  // this table stamps carries the bit set by default (ahci_port_tail_
  // pack_meta, this commit) until identify.pdx learns to parse
  // IDENTIFY word 82 bit 5 and a mint-time caller threads a real value
  // through instead. Same one-push shape as ahci_port_row_port_index.
  // ==========================================================================
  pub let ahci_port_row_write_cache_present : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M6-004 (#1666): 1|0 from the features byte's bit 3 (AHCIP_FEATURE_WRITE_CACHE_PRESENT), or AHCIP_DECODE_BAD. Labels prefixed ahcip_rwcp_.",
      block: {
        push r12;
        mov r12, rdi;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_rwcp_bad;
        lea r10, [rip + _ahci_port_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        shr rax, 24;
        and rax, 0xFF;                   // features byte
        and rax, 0x8;                    // AHCIP_FEATURE_WRITE_CACHE_PRESENT
        shr rax, 3;                      // normalize to 0|1
        jmp ahcip_rwcp_out;
      ahcip_rwcp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ahcip_rwcp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_row_set_cmd_regions(row_id, cl_phys, ct_phys) -> u64
  //
  // R51.M6-001 (#1663): bind a live port row's Command List / Command
  // Table region addresses into the two words SECTION 1 reserves for
  // exactly this (+48/+56). NOT a violation of ahci_port_tail_alloc's
  // "THE ONLY WRITER of _ahci_port_table" posture: that function owns
  // the row's ALLOCATION fields (header/port_index/sector_size/
  // block_count/meta, words +0..+40, all written atomically at mint
  // time); this setter owns ONLY +48/+56, written once, after mint,
  // by drivers/ahci/cmd_alloc.pdx's ahci_port_cmd_regions_bind -- the
  // two writers never touch the same word. Returns AHCIP_OK (0) on
  // success, or 0xFFFFECA1 (AHCIIO_CMD_BIND_BAD_ROW -- cmd_alloc.pdx's
  // own failure band, #1663) on an invalid row, because the caller is
  // the M6-001 bind path rather than a KIND_AHCI_PORT mint/query op
  // and a KIND_AHCI_PORT-band code would misattribute the failure.
  // ==========================================================================
  pub let ahci_port_row_set_cmd_regions : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (cl_phys: u64) (ct_phys: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M6-001 (#1663): bounds/liveness-gated writer of ONLY row words +48 (cl_phys) and +56 (ct_phys). Three callee-save pushes (r12=row_id, r13=cl_phys, r14=ct_phys) leave rsp%16==0 (entry 8, 3*8=24, 8+24=32) before the ahci_port_tail_valid call. Labels prefixed ahcip_scr_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // cl_phys
        mov r14, rdx;                    // ct_phys

        mov rdi, r12;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_scr_bad;

        lea r10, [rip + _ahci_port_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 48], r13;
        mov [r10 + 56], r14;
        xor rax, rax;
        jmp ahcip_scr_out;

      ahcip_scr_bad:
        mov rax, 0xFFFFECA1;             // AHCIIO_CMD_BIND_BAD_ROW (cmd_alloc.pdx, #1663)

      ahcip_scr_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_row_state_set(row_id, new_state) -> u64
  //
  // R51.M5-005 (#1661): monotonic state advance MINTED (1) -> IDENTIFIED
  // (2), added by this issue's own bring-up orchestrator
  // (drivers/ahci/port.pdx's ahci_port_bring_up_and_identify) exactly
  // the way R51.M5-003/#1659 added ahci_ctrl_row_port_map_set to
  // kind_ahci_controller.pdx -- "one file owns all writes to this
  // table" stays true; the writer lives here, the orchestrator that
  // needs it lives in the driver split. Shape mirrors
  // ahci_ctrl_row_state_set (kind_ahci_controller.pdx) one-for-one:
  // tail_valid gate, strict new == current+1, range-checked against
  // AHCIP_STATE_MAX (2).
  //
  // DESIGN-DOC GAP (flagged to softarch/debugger review, see final
  // report): design/hardware/ahci-substrate.md §6's AHCIP failure
  // taxonomy has no dedicated "bad transition" code (unlike
  // AHCIC_BAD_TRANSITION = 0xFFFFEC85 for the controller kind) -- every
  // code in the design-allocated 0xFFFFEC80..EC84 band plus this
  // file's own EC90..EC98 spillover is already claimed for a specific
  // mint/tail/revoke failure, none of them "monotonic gate refused".
  // Rather than mint a brand-new code (this table's whole
  // 0xFFFFEC80..EC98 band is the one the task's own scope note calls
  // "the port + overflow band from #1660" -- fully spent), this
  // function reuses AHCIP_TAIL_BAD_ARG (0xFFFFEC95, "hdr encoding
  // invalid") for a refused transition: a monotonic-gate violation IS
  // an invalid header-encoding request in the same sense tail_alloc's
  // own BAD_ARG already covers (an attempt to write a state value the
  // header format does not allow at this row's current position in
  // its lifecycle). No new constant added.
  // ==========================================================================
  pub let ahci_port_row_state_set : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-005 (#1661): monotonic state advance MINTED(1) -> IDENTIFIED(2). Two callee-save pushes (r12=row_id, r13=new_state) leave rsp%16==0 for the one nested tail_valid call. Gate: new_state must equal current_state+1 AND new_state <= AHCIP_STATE_MAX (2) -- since AHCIP_STATE_MINTED=1 is the only valid 'current', this collapses to 'new_state must be exactly 2', but the codepath is written as a general current+1 check (mirrors ahci_ctrl_row_state_set) so a future third state extends by adding one more STATE_MAX bump, not a rewrite. On refusal, returns AHCIP_TAIL_BAD_ARG (0xFFFFEC95) -- see the file-header DESIGN-DOC GAP note on why this reuses an existing code rather than minting a new one. Labels prefixed ahcip_rss_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // new_state

        mov rdi, r12;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_rss_bad;

        // Range check: new_state in [2..AHCIP_STATE_MAX].
        cmp r13, 2;
        jb  ahcip_rss_no;
        mov r10, 2;                      // AHCIP_STATE_MAX
        cmp r13, r10;
        ja  ahcip_rss_no;

        lea r10, [rip + _ahci_port_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        mov rcx, rax;
        shr rcx, 8;
        and rcx, 0xFF;                   // current state

        mov r11, rcx;
        add r11, 1;
        cmp r13, r11;
        jne ahcip_rss_no;

        // Clear state byte (bits [15:8]), OR in new_state << 8.
        mov r11, 0xFFFFFFFFFFFF00FF;
        and rax, r11;
        mov r11, r13;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;                    // AHCIP_OK
        jmp ahcip_rss_out;

      ahcip_rss_no:
        mov rax, 0xFFFFEC95;             // AHCIP_TAIL_BAD_ARG (reused; see header note)
        jmp ahcip_rss_out;
      ahcip_rss_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // AHCIP_DECODE_BAD

      ahcip_rss_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
