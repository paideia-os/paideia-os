  // ==========================================================================
  // R51.M7-001 (#1669): unified KIND_BLKDEV tail accessors.  Every one
  // mirrors ahci_port_row_family's shape one-for-one (tail_valid gate,
  // then a masked read at a fixed row offset). Consumed by
  // kind_blkdev.pdx's family-dispatching blkdev_row_* wrappers.
  // ==========================================================================

  pub let ahci_port_row_features : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M7-001 (#1669): features bitmap byte (meta [+32] bits [31:24]: FLUSH/TRIM/WRITE_ZEROES/WRITE_CACHE_PRESENT), or AHCIP_DECODE_BAD. Labels prefixed ahcip_rfe_.",
      block: {
        push r12;
        mov r12, rdi;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_rfe_bad;
        lea r10, [rip + _ahci_port_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        shr rax, 24;
        and rax, 0xFF;
        jmp ahcip_rfe_out;
      ahcip_rfe_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ahcip_rfe_out:
        pop r12;
        ret
      }
    }

