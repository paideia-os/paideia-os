// src/kernel/core/cap/kind_ahci_port.pdx -- R51.M5-004 (#1660).
//
// KIND_AHCI_PORT = 0x19B, derived over KIND_MEMORY (= 4).
//
// The runtime authority for ONE AHCI port: the (parent_ctrl_row,
// port_index, sector_size, block_count) tuple a driver process holds
// once a port has been discovered on an AHCI HBA.  Design authority:
// design/hardware/ahci-substrate.md (commit 9f59498) §1 (NVMe-parallel
// structure row 8), §2.6 (IDENTIFY DEVICE geometry), §3 (file layout),
// §7 #1660 (this issue's own scope text).
//
// This file originally landed R51.M5-004 (#1660): mint gate
// (ahci_port_cap_mint_inner), row table (_ahci_port_table[256]), the
// two-state machine (MINTED / IDENTIFIED -- same shape as
// KIND_NVME_NAMESPACE), row accessors, a revoke primitive with a
// CASCADE STUB, the meta packer (family=AHCI baked in), rights, and
// the QUERY_PORT_INDEX / _SECTOR_SIZE / _BLOCK_COUNT / _PARENT /
// _FAMILY / _STATE / _PORT_SLOT / DEBUG_PRINT op dispatcher.
//
// R51.M6-001 (#1663) added the cl_iova/ct_iova row accessors + setter
// (SECTION "R51.M6-001" markers below).
//
// R51.M5-006 (#1662) added `ahci_port_dual_kind_mint` (the 6-arg
// dual-kind mint stamping KIND_AHCI_PORT + KIND_BLKDEV onto the same
// row, design §4), `ahci_port_blk_rights_valid` (the KIND_BLKDEV-half
// rights gate), and widened the revoke cascade: `ahci_port_cascade_
// revoke_blkdev` (scrubs the dual-kind KIND_BLKDEV child) is called
// from `ahci_port_cap_revoke`, and `ahci_port_cascade_revoke_by_ctrl`
// is wired into `ahci_ctrl_cap_revoke` (kind_ahci_controller.pdx).
// #1662 also landed a placeholder `ahci_io_submit_rw` (unconditional
// `0xEEEE`) so cap_handler_blkdev.pdx's family demux would compile
// ahead of the real I/O submit path landing.
//
// R51.M6-002 (#1664) REMOVES that placeholder: the real
// `ahci_io_submit_rw` now lives in the new drivers/ahci/io_submit.pdx
// (design/hardware/nvme-ahci-tail-milestones.md §2.M6 #1664) --
// Command Header + PRDT + H2D Register FIS (READ_DMA_EXT, 0x25) build,
// PxCI ring, completion poll, PxTFD error check.  Per-port bring-up +
// IDENTIFY DEVICE (M5-005/#1661) remains a separate, parallel issue;
// io_submit.pdx's own header documents why it can assume CLB/CLBU are
// already live at the HBA once a port reaches AHCIP_STATE_IDENTIFIED.
//
// R51.M6-004 (#1666) adds `ahci_port_row_write_cache_present` (reads
// the AHCIP_FEATURE_WRITE_CACHE_PRESENT bit this same commit teaches
// `ahci_port_tail_pack_meta` to bake into every newly-minted row by
// default) and widens SECTION 1's features-byte documentation
// accordingly; the real FLUSH_CACHE_EXT wire-up lives in the new
// drivers/ahci/reliability.pdx (`ahci_flush`), which this file's row
// accessors merely support.
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// An AHCI port projects logical blocks onto host pages via PRDT
// transfers -- the same "memory-adjacent authority" posture
// KIND_NVME_NAMESPACE (0x199) takes deriving over KIND_MEMORY (4).
// Sharing that base slot (rather than KIND_DEVICE) is what lets the
// eventual dual-kind mint (M5-006) stamp BOTH KIND_AHCI_PORT (0x19B)
// and KIND_BLKDEV (0x42) onto the same underlying row: cap_invoke_
// dispatch compares the FULL u64 kind field, not the LAM 4-bit slot
// hint, so 0x19B and 0x42 coexist on slot-4 without ambiguity, exactly
// as KIND_NVME_NAMESPACE / KIND_BLKDEV already do (design §1 row 8;
// design/hardware/nvme-and-disk-substrate.md §4.4).
//
// The parent derivation check is against KIND_AHCI_CONTROLLER (0x19A,
// R51.M5-001/#1657) carrying R_AHCIC_MINT_PORT (0x008), NOT a raw
// RIGHT_MINT (0x200) and NOT KIND_DEVICE directly -- per design §7
// #1660: "the port-mint authority is a first-class right on the
// controller cap (same shape as R_NVMEC_MINT_NS for M2)".  A driver
// that only holds controller-reset authority without R_AHCIC_MINT_PORT
// cannot mint port children.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words) -- mirrors
// _nvme_namespace_table one-for-one (design §1 row 8):
//
//   [+0]   header: in_use[63:56] | state[15:8] | port_slot[7:0]
//   [+8]   port_index    (u64, low bits) -- AHCI port index (0..31),
//                           from PI enumeration (M5-003/#1659)
//   [+16]  sector_size   (u64, low 32 bits) -- bytes/logical sector
//                           (512 or 4096), from IDENTIFY DEVICE (§2.6)
//   [+24]  block_count   (u64) -- LBA48 total sectors (§2.6)
//   [+32]  packed:       bits [15:0]  = parent_ctrl_row (u16)
//                        bits [23:16] = family (AHCIP_FAMILY_AHCI = 2,
//                                       baked in by ahci_port_tail_
//                                       pack_meta -- every row this
//                                       kind ever stamps is AHCI, so
//                                       there is no caller-supplied
//                                       family arg to get wrong)
//                        bits [31:24] = features bitmap (FLUSH/TRIM/
//                                       WRITE_ZEROES/WCP, AHCIP_FEATURE_*
//                                       above); all zero at M5-004
//                                       (§4.3). R51.M6-004 (#1666) bakes
//                                       WCP (bit 3) in by default at mint
//                                       time (ahci_port_tail_pack_meta);
//                                       FLUSH/TRIM bits remain clear,
//                                       for #1667+ to set once DRAT
//                                       parsing lands
//                        bits [47:32] = max_transfer_blocks (u16) --
//                                       R51.M7-001 (#1669): zeroed at
//                                       mint; populated from PRDTL_max
//                                       by M7-003's
//                                       blkdev_cap_mint_from_ahci
//                        bits [55:48] = dma_domain_slot (u8, 0..255 per
//                                       design/hardware/nvme-and-disk-
//                                       substrate.md §4.3's own stated
//                                       range) -- R51.M7-001 (#1669):
//                                       zeroed at mint (0 == unscoped);
//                                       populated at M7-003+
//                        bits [63:56] = reserved
//
// R51.M7-001 (#1669) packs max_transfer_blocks / dma_domain_slot into
// the meta word's high bits ([63:32] were unused by ahci_port_tail_
// pack_meta) rather than [+48]/[+56] -- those two words are ALREADY
// repurposed below for cl_iova/ct_iova (R51.M6-001, #1663), so the
// unified KIND_BLKDEV tail lands in the one place still free on both
// this table and _nvme_namespace_table, keeping the two families' new
// fields at identical bit-positions for kind_blkdev.pdx's family-
// dispatching blkdev_row_max_transfer_blocks / blkdev_row_dma_domain_
// slot accessors.
//   [+40]  attest_key    (u64) -- reserved for KIND_DMA_ATTESTATION
//                           wiring (parent §5.4); 0 at M5-004 (DESIGN-
//                           DOC GAP, see final report: the design intro
//                           states the M5 port mint "requires the same
//                           attestation-covers-this-domain check M2
//                           already enforces on KIND_NVME_NAMESPACE",
//                           but #1660's own per-issue breakdown (§7)
//                           lists no attestation gate among this
//                           issue's gates, and no KIND_DMA_ATTESTATION
//                           parent/slot argument is threaded through
//                           the 6-arg mint signature. Deferred; the
//                           field is reserved and zero-initialised so a
//                           future pass can wire the check without a
//                           row-layout change.)
//   [+48]  cl_iova       (u64) -- Command List region phys/IOVA base,
//                           set by ahci_port_row_set_cmd_regions
//                           (R51.M6-001/#1663); 0 until bound. Was
//                           "reserved" at M5-004; repurposed by M6-001
//                           because this is exactly the kind of future
//                           field this comment originally reserved
//                           space for.
//   [+56]  ct_iova       (u64) -- Command Table region phys/IOVA
//                           base, same setter, same repurposing;
//                           0 until bound.
//
// State byte values (in header bits [15:8]) -- two states, same shape
// as KIND_NVME_NAMESPACE (design §7 #1660: "same shape as
// kind_nvme_namespace"):
//   AHCIP_STATE_MINTED     = 1   -- row allocated, geometry populated
//   AHCIP_STATE_IDENTIFIED = 2   -- reserved for M5-005/#1661 (post-
//                                   IDENTIFY DEVICE confirm)
//
// port_slot (bits [7:0]) is a per-row nominal index; assigned equal to
// the row_id at mint (0..AHCIP_MAX-1), matching ns_slot's convention.
//
// Row-addressed capacity: 32 rows x 64 bytes = 2048 bytes = 256 u64.
// AHCIP_MAX = 32 per design §1 row 8 ("32 ports per controller matches
// AHCI 1.3 §3.1 CAP.NP field width") and §7 #1660 ("matches parent §7
// M5-004 sizing").
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
// Per design/hardware/ahci-substrate.md §7 #1660's own issue text,
// numerically identical to KIND_NVME_NAMESPACE's R_NVMEN_* rights
// (design §1 row 8 draws the mint as a direct structural analogue):
//
//   R_AHCIP_MINT_BLK (0x001) -- mint downstream KIND_BLKDEV children
//                               (the KIND_BLKDEV half of the M5-006
//                               dual-kind mint; unused by any function
//                               THIS pass lands)
//   R_AHCIP_ATTACH   (0x002) -- port-attach op (reserved; no ATTACH op
//                               is dispatched by this pass's handler)
//   R_AHCIP_DETACH   (0x004) -- port-detach op (reserved, ditto)
//   R_AHCIP_INVOKE   (0x008) -- QUERY ops (port_index/sector_size/
//                               block_count/parent/family/state/
//                               port_slot)
//   R_AHCIP_REVOKE   (0x010) -- teardown the row (cascades to
//                               KIND_BLKDEV once M5-006 lands)
//   R_AHCIP_OBSERVE  (0x400) -- debug printer
//   R_AHCIP_ALL      (0x41F)
//
// No rights-bit collision here (contrast: kind_ahci_controller.pdx
// SECTION 2's flagged R_AHCIC_INVOKE/MINT_PORT gap) -- design §7 #1660
// states these six bits and their 0x41F union directly, and they are
// mutually exclusive as listed.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEC80..0xFFFFEC84 (+ spillover)
// =============================================================================
//
// design/hardware/ahci-substrate.md §6 allocates the AHCI-family band
// 0xFFFFEC80..0xFFFFEC8F to BOTH KIND_AHCI_CONTROLLER (which claimed
// 0xFFFFEC85..0xFFFFEC8F, 11 codes, in kind_ahci_controller.pdx) and
// KIND_AHCI_PORT (0xFFFFEC80..0xFFFFEC84, 5 codes, claimed here):
//
//   AHCIP_DUAL_BAD_SLOTS   0xFFFFEC80   -- M5-006/#1662; unused here
//   AHCIP_MINT_BAD_SIG     0xFFFFEC81   -- M5-005/#1661; unused here
//   AHCIP_MINT_NO_LBA48    0xFFFFEC82   -- M5-005/#1661; unused here
//   AHCIP_MINT_BAD_PORT    0xFFFFEC83   -- port_index >= AHCIP_MAX
//   AHCIP_MINT_BAD_PARENT  0xFFFFEC84   -- parent-derivation gate fail
//
// DESIGN-DOC GAP (flagged to softarch/debugger review, see final
// report): five codes are not enough for this issue's actual scope.
// #1660's own per-issue text (design §7) asks this file to land the
// FULL apparatus KIND_NVME_NAMESPACE needed at its M2-001 -- mint
// gate, table, accessors, AND a revoke primitive -- and that sibling
// needed 15 distinct failure constants for exactly that scope (design
// §7's own comparison: "row table ... matches parent §7 M5-004
// sizing", "same shape as kind_nvme_namespace"). Concretely this file
// needs AHCIP-side constants for: rights-subset failure, sector_size
// validity, block_count validity, parent-ctrl-row liveness, tail-alloc
// ENOSPC / BAD_ARG, and revoke's BAD_SLOT / REVOKE_ALREADY -- none of
// which fit in the 5-code 0xFFFFEC80..0xFFFFEC84 allocation.
//
// Resolution taken here, using design §6's OWN stated overflow
// escape valve verbatim ("If M5 discovers it needs more than 16
// codes ... spill to 0xFFFFEC90..0xFFFFEC9F and defer M6 to
// 0xFFFFECA0..ECAF"): this file claims 0xFFFFEC90..0xFFFFEC98 (9
// codes) for the additional AHCIP_* constants below, leaving
// 0xFFFFEC99..0xFFFFEC9F (7 codes) plus the untouched
// 0xFFFFECA0..ECAF band for M6 (I/O submit + TFERR + hot-plug).
// Flag for design-doc correction: design/hardware/ahci-substrate.md
// §6 should record this spillover and adjust the M6 opening band
// note (it already anticipates exactly this contingency, just did
// not expect M5 itself to trigger it).
//
//   AHCIP_MINT_BAD_RIGHTS   0xFFFFEC90
//   AHCIP_MINT_BAD_SECTOR   0xFFFFEC91   -- sector_size not in {512,4096}
//   AHCIP_MINT_BAD_BLOCKS   0xFFFFEC92   -- block_count == 0
//   AHCIP_MINT_BAD_CTRL_ROW 0xFFFFEC93   -- parent_ctrl_row not live
//   AHCIP_TAIL_ENOSPC       0xFFFFEC94   -- table full (32 rows in use)
//   AHCIP_TAIL_BAD_ARG      0xFFFFEC95   -- hdr encoding invalid
//   AHCIP_BAD_SLOT          0xFFFFEC96   -- revoke: row_id never minted
//   AHCIP_REVOKE_ALREADY    0xFFFFEC97   -- revoke: row already gone
//   AHCIP_WRONG_KIND        0xFFFFEC98   -- claimed, unused this pass
//                                           (parity with AHCIC_WRONG_
//                                           KIND's "claim now, consume
//                                           later" posture)
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: sized stores via mov_b / mov_w / mov_d for sub-8-byte fields --
//       not needed in THIS file (only full-u64 tail packing here; the
//       FIS builder that needs mov_b lands in drivers/ahci/fis.pdx at
//       M5-005).
//   G4: full-register compares (zero-extend loads via prior xor / and)
//       -- used throughout the state-byte and header decode paths.
//
// r10/r11 scratch only for imm32-sized constants; every KIND / rights
// / state constant here fits imm32 EXCEPT the 0xFFFFEC8*/0xFFFFEC9*
// failure codes, which exceed 0x7FFFFFFF and are staged via
// `mov r10, <imm64>` before any cmp/mov-to-memory, per design §8.5.
// Labels prefixed `ahcip_` (design §8.2). `loop`, `if`, `port`,
// `reset`, `enum` are reserved keywords and never appear bare in a
// label.

module KindAhciPort = structure {

  pub let KIND_AHCI_PORT      : u64 = 0x19B
  pub let KIND_AHCI_PORT_BASE : u64 = 4          // = KIND_MEMORY

  pub let R_AHCIP_MINT_BLK : u64 = 0x001
  pub let R_AHCIP_ATTACH   : u64 = 0x002
  pub let R_AHCIP_DETACH   : u64 = 0x004
  pub let R_AHCIP_INVOKE   : u64 = 0x008
  pub let R_AHCIP_REVOKE   : u64 = 0x010
  pub let R_AHCIP_OBSERVE  : u64 = 0x400
  pub let R_AHCIP_ALL      : u64 = 0x41F

  pub let AHCIP_STATE_MINTED     : u64 = 1
  pub let AHCIP_STATE_IDENTIFIED : u64 = 2
  pub let AHCIP_STATE_MAX        : u64 = 2

  // Family byte (mirror of design §4.3 / §1 row 8: 0 = legacy R24
  // mint, 1 = NVME, 2 = AHCI). Every row this kind stamps is AHCI, so
  // the meta packer bakes this in rather than accepting it as an arg.
  pub let AHCIP_FAMILY_AHCI  : u64 = 2

  // R51.M6-004 (#1666): features byte (row word +32, bits [31:24] --
  // reserved by SECTION 1 since M5-004 for exactly this). Bit meaning
  // mirrors cap_handler_blkdev.pdx's BDEV_FEATURE_* layout one-for-one.
  // Only WRITE_CACHE_PRESENT is ever set by this pass (baked into
  // every newly-minted row by ahci_port_tail_pack_meta, defaulting to
  // 1 per design's own "if IDENTIFY missed it, default 1" -- IDENTIFY
  // word-82 bit-5 is not yet stashed anywhere by drivers/ahci/
  // identify.pdx); FLUSH_SUPPORTED/TRIM_SUPPORTED/WRITE_ZEROES_
  // SUPPORTED are claimed here for #1667+ to set, not consumed by any
  // function this pass lands (FLUSH_SUPPORTED is computed
  // unconditionally by cap_handler_blkdev's hblk_op_features_ahci
  // instead of read from this bit, per design §2.M6 #1666).
  pub let AHCIP_FEATURE_FLUSH_SUPPORTED        : u64 = 0x1
  pub let AHCIP_FEATURE_TRIM_SUPPORTED         : u64 = 0x2
  pub let AHCIP_FEATURE_WRITE_ZEROES_SUPPORTED : u64 = 0x4
  pub let AHCIP_FEATURE_WRITE_CACHE_PRESENT    : u64 = 0x8

  // Every op ARITY ONE -- op_arg[63:8] REFUSED (mirrors
  // KIND_NVME_NAMESPACE / KIND_AHCI_CONTROLLER discipline).
  pub let AHCIP_OP_QUERY_PORT_INDEX  : u64 = 0
  pub let AHCIP_OP_QUERY_SECTOR_SIZE : u64 = 1
  pub let AHCIP_OP_QUERY_BLOCK_COUNT : u64 = 2
  pub let AHCIP_OP_QUERY_PARENT      : u64 = 3
  pub let AHCIP_OP_QUERY_FAMILY      : u64 = 4
  pub let AHCIP_OP_QUERY_STATE       : u64 = 5
  pub let AHCIP_OP_QUERY_PORT_SLOT   : u64 = 6
  pub let AHCIP_OP_DEBUG_PRINT       : u64 = 7
  pub let AHCIP_OP_MAX               : u64 = 7

  pub let AHCIP_OK               : u64 = 0

  // Design-allocated band (§6): 0xFFFFEC80..0xFFFFEC84.
  pub let AHCIP_DUAL_BAD_SLOTS   : u64 = 0xFFFFEC80
  pub let AHCIP_MINT_BAD_SIG     : u64 = 0xFFFFEC81
  pub let AHCIP_MINT_NO_LBA48    : u64 = 0xFFFFEC82
  pub let AHCIP_MINT_BAD_PORT    : u64 = 0xFFFFEC83
  pub let AHCIP_MINT_BAD_PARENT  : u64 = 0xFFFFEC84

  // Spillover band (SECTION 3 gap note): 0xFFFFEC90..0xFFFFEC98.
  pub let AHCIP_MINT_BAD_RIGHTS   : u64 = 0xFFFFEC90
  pub let AHCIP_MINT_BAD_SECTOR   : u64 = 0xFFFFEC91
  pub let AHCIP_MINT_BAD_BLOCKS   : u64 = 0xFFFFEC92
  pub let AHCIP_MINT_BAD_CTRL_ROW : u64 = 0xFFFFEC93
  pub let AHCIP_TAIL_ENOSPC       : u64 = 0xFFFFEC94
  pub let AHCIP_TAIL_BAD_ARG      : u64 = 0xFFFFEC95
  pub let AHCIP_BAD_SLOT          : u64 = 0xFFFFEC96
  pub let AHCIP_REVOKE_ALREADY    : u64 = 0xFFFFEC97
  pub let AHCIP_WRONG_KIND        : u64 = 0xFFFFEC98

  pub let AHCIP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let AHCIP_ROW_NONE   : u64 = 0xFF

  // Ceiling.  Matches design §1 row 8 / §7 #1660 (AHCIP_MAX = 32).
  pub let AHCIP_MAX        : u64 = 32
  pub let AHCIP_ROW_BYTES  : u64 = 64
  // 32 rows * 64 bytes = 2048 bytes = 256 u64.
  pub let mut _ahci_port_table : [u64; 256] = uninit @align(64)
  pub let mut _ahci_port_stats : [u64; 16]  = uninit @align(64)

  pub let AHCIP_ST_MINTS      : u64 = 0
  pub let AHCIP_ST_REVOKES    : u64 = 1
  pub let AHCIP_ST_QUERIES    : u64 = 2
  pub let AHCIP_ST_REFUSED    : u64 = 3
  pub let AHCIP_ST_ENUMS      : u64 = 4
  pub let AHCIP_ST_DUAL_MINTS : u64 = 5
  pub let AHCIP_ST_CASCADES   : u64 = 6
  pub let AHCIP_ST_IDENTIFIES : u64 = 7
  pub let AHCIP_ST_MAX        : u64 = 16

  pub let ahcip_dbg_msg : [u8; 15] = "AHCI PORT ROW\0\0"

  // ==========================================================================
  // ahci_port_table_reset() -> ()
  //
  // Clear every row and every counter.  Boot and teardown only.  Two
  // separate loops (rows / stats) mirror nvme_ns_table_reset's shape.
  // ==========================================================================
  pub let ahci_port_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): clear every row and every counter. Boot and teardown only. Labels prefixed ahcip_rs_.",
      block: {
        lea r10, [rip + _ahci_port_table];
        xor rax, rax;
        xor rcx, rcx;
      ahcip_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  ahcip_rs_rows;

        lea r10, [rip + _ahci_port_stats];
        xor rcx, rcx;
      ahcip_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ahcip_rs_stats;
        ret
      }
    }

  pub let ahci_port_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): bounded increment; out-of-range no-op. Labels prefixed ahcip_nt_.",
      block: {
        cmp rdi, 16;
        jae ahcip_nt_out;
        lea r10, [rip + _ahci_port_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ahcip_nt_out:
        ret
      }
    }

  pub let ahci_port_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): bounded read; out-of-range returns 0. Labels prefixed ahcip_st_.",
      block: {
        cmp rdi, 16;
        jae ahcip_st_zero;
        lea r10, [rip + _ahci_port_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ahcip_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ahci_port_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M5-004 (#1660): subset test against R_AHCIP_ALL = 0x41F. Labels prefixed ahcip_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41F;
        and rax, r10;
        cmp rax, rdi;
        jne ahcip_rv_no;
        mov rax, 1;
        ret;
      ahcip_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_index_valid(port_index) -> 1 iff port_index < AHCIP_MAX.
  //
  // Bound-only gate.  Whether port_index is actually set in the parent
  // controller's PI bitmap (port_map) is a cross-module concern this
  // low-level walker deliberately does not check -- the future per-port
  // bring-up orchestrator (M5-005/#1661, ahci_port_bring_up_and_
  // identify) iterates the enumerated port_map and calls this mint
  // gate only for ports it already knows are PI-set, exactly the
  // relationship nvme_ns_cap_mint_inner has with nvme_ns_enumerate's
  // active-NSID iteration.
  // ==========================================================================
  pub let ahci_port_index_valid : (u64) -> u64 !{} @{} =
    fn (port_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M5-004 (#1660): 1 iff port_index < AHCIP_MAX = 32. PI-membership is a cross-module concern left to the future per-port bring-up orchestrator. Labels prefixed ahcip_iv_.",
      block: {
        cmp rdi, 32;
        jae ahcip_iv_no;
        mov rax, 1;
        ret;
      ahcip_iv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_sector_valid(sector_size) -> 1 iff sector_size is 512 or
  // 4096 (design §2.6: word 106 bit 12 flags >512 B sectors; R51
  // supports only the two common values at first-boot).
  // ==========================================================================
  pub let ahci_port_sector_valid : (u64) -> u64 !{} @{} =
    fn (sector_size: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M5-004 (#1660): accept only 512 or 4096, mirroring nvme_ns_lba_valid's posture for the sibling kind. Labels prefixed ahcip_sv_.",
      block: {
        cmp rdi, 512;
        je  ahcip_sv_yes;
        mov r10, 4096;
        cmp rdi, r10;
        je  ahcip_sv_yes;
        xor rax, rax;
        ret;
      ahcip_sv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_blocks_valid(block_count) -> 1 iff block_count > 0.
  // ==========================================================================
  pub let ahci_port_blocks_valid : (u64) -> u64 !{} @{} =
    fn (block_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M5-004 (#1660): non-zero block_count check. A port of zero blocks is not addressable. Labels prefixed ahcip_bv_.",
      block: {
        cmp rdi, 0;
        je  ahcip_bv_no;
        mov rax, 1;
        ret;
      ahcip_bv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_ctrl_row_valid(ctrl_row) -> 1 iff ahci_ctrl_tail_valid
  // (ctrl_row) == 1 (cross-module delegate into kind_ahci_controller.pdx,
  // R51.M5-001/#1657, already landed).
  // ==========================================================================
  pub let ahci_port_ctrl_row_valid : (u64) -> u64 !{mem} @{} =
    fn (ctrl_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): cross-module liveness check on the parent controller row. Delegates to ahci_ctrl_tail_valid (kind_ahci_controller.pdx, #1657); AHCIC_MAX = 4 bound enforced by the callee. Single callee-save push (r12) preserves rsp%16 across the delegate call. Labels prefixed ahcip_cv_.",
      block: {
        push r12;
        mov r12, rdi;
        mov rdi, r12;
        call ahci_ctrl_tail_valid;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_check_parent_ctrl(parent_slot) -> 1 | 0
  //
  // Derivation gate.  parent.kind == KIND_AHCI_CONTROLLER (0x19A) AND
  // rights carry R_AHCIC_MINT_PORT (0x008).  Per design/hardware/
  // ahci-substrate.md §7 #1660: "NOT RIGHT_MINT (0x200) -- because the
  // port-mint authority is a first-class right on the controller cap
  // (same shape as R_NVMEC_MINT_NS for M2)".
  // ==========================================================================
  pub let ahci_port_check_parent_ctrl : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R51.M5-004 (#1660): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_AHCI_CONTROLLER (0x19A) AND (rights & R_AHCIC_MINT_PORT 0x008) != 0. Both constants fit imm32; staged in r11. Pure read. Labels prefixed ahcip_cpp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae ahcip_cpp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x19A;                  // KIND_AHCI_CONTROLLER
        cmp r10, r11;
        jne ahcip_cpp_no;

        mov r10, [rax + 8];
        mov r11, 0x008;                  // R_AHCIC_MINT_PORT
        and r10, r11;
        cmp r10, 0;
        je  ahcip_cpp_no;

        mov rax, 1;
        ret;

      ahcip_cpp_no:
        xor rax, rax;
        ret
      }
    }

  // hdr layout: in_use[63:56] | state[15:8] | port_slot[7:0].
  // Callers pack via ahci_port_hdr_pack(port_slot, state).
  pub let ahci_port_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (port_slot: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M5-004 (#1660): canonical header encoder. Validates port_slot in [0..AHCIP_MAX-1] and state in [1..AHCIP_STATE_MAX]. Bits [63:56] MUST leave this function zero (in_use is set by tail_alloc under the same write that claims the row). Labels prefixed ahcip_hp_.",
      block: {
        cmp rdi, 32;                     // AHCIP_MAX
        jae ahcip_hp_bad;
        cmp rsi, 1;
        jb  ahcip_hp_bad;
        mov r10, 2;                      // AHCIP_STATE_MAX
        cmp rsi, r10;
        ja  ahcip_hp_bad;
        mov rax, rdi;                    // port_slot in [7:0]
        mov r11, rsi;
        shl r11, 8;
        or  rax, r11;                    // state in [15:8]
        ret;
      ahcip_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // ahci_port_tail_pack_meta(parent_ctrl_row) -> u64
  //
  // Pack the +32 word: bits [15:0]=parent_ctrl_row, [23:16]=family
  // (AHCIP_FAMILY_AHCI = 2, baked in -- every row this kind stamps is
  // AHCI), [31:24]=features (R51.M6-004/#1666: AHCIP_FEATURE_WRITE_
  // CACHE_PRESENT baked in by default -- design's own "if IDENTIFY
  // missed it, default 1"; FLUSH/TRIM_SUPPORTED bits left clear, for
  // #1667+ to set once DRAT parsing lands), [63:32]=reserved (zero).
  // ==========================================================================
  pub let ahci_port_tail_pack_meta : (u64) -> u64 !{} @{} =
    fn (parent_ctrl_row: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M5-004 (#1660) + R51.M6-004 (#1666): pack the meta word. parent_ctrl_row masked to 16 bits; family = AHCIP_FAMILY_AHCI (2) baked in, shifted to [23:16]; features [31:24] = AHCIP_FEATURE_WRITE_CACHE_PRESENT (0x8) baked in by default (#1666: drivers/ahci/identify.pdx does not yet stash IDENTIFY word 82, so every newly-minted port row defaults to write-cache-present per design's own sanctioned default -- 'SATA disks universally cache'), shifted to bit 27 (24+3) via `mov r10, 0x8; shl r10, 24`. No overflow: AHCIC_MAX=4 fits 16 bits. Labels prefixed ahcip_mp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;                 // parent_ctrl_row in [15:0]
        mov r10, 2;                      // AHCIP_FAMILY_AHCI
        shl r10, 16;
        or  rax, r10;                    // family in [23:16]
        mov r10, 0x8;                    // AHCIP_FEATURE_WRITE_CACHE_PRESENT
        shl r10, 24;                     // -> bit 27 (features byte bit 3)
        or  rax, r10;                    // features in [31:24]
        ret
      }
    }

  // ==========================================================================
  // ahci_port_tail_alloc(hdr, port_index, sector_size, block_count, meta)
  //   -> row_id | AHCIP_TAIL_*.
  //
  // THE ONLY WRITER of _ahci_port_table.  Gates: hdr in_use pre-set ->
  // BAD_ARG; hdr reserved [55:16] non-zero -> BAD_ARG.  All value
  // gates (port_index/sector_size/block_count) are enforced by the
  // mint walker before we reach here.  attest_key + reserved words
  // scrubbed to 0.  Six-callee-save prologue + sub rsp, 8 = 56 bytes;
  // entry rsp%16==8 -> post-prologue rsp%16 == 0.
  // ==========================================================================
  pub let ahci_port_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (port_index: u64) (sector_size: u64) (block_count: u64) (meta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): claim one port row. THE ONLY WRITER of _ahci_port_table. Gates: hdr in_use pre-set -> BAD_ARG (pre-set in_use would hand back a row the free scan skips forever); hdr reserved [55:16] non-zero -> BAD_ARG. Low-first scan over 32 rows of 64 bytes. Six callee-save pushes + sub rsp,8 = 56 bytes; entry rsp%16==8 -> post-prologue rsp%16 == 0. Labels prefixed ahcip_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // port_index
        mov r14, rdx;                    // sector_size
        mov r15, rcx;                    // block_count
        mov rbp, r8;                     // meta

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne ahcip_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne ahcip_ta_bad;

        xor rbx, rbx;                    // row_id cursor
      ahcip_ta_scan:
        cmp rbx, 32;                     // AHCIP_MAX
        jae ahcip_ta_enospc;

        lea r10, [rip + _ahci_port_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ahcip_ta_claim;

        add rbx, 1;
        jmp ahcip_ta_scan;

      ahcip_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;             // header + in_use
        mov [r10 + 8],  r13;             // port_index
        mov [r10 + 16], r14;             // sector_size
        mov [r10 + 24], r15;             // block_count
        mov [r10 + 32], rbp;             // meta (parent_ctrl_row|family|features)
        xor rax, rax;
        mov [r10 + 40], rax;             // attest_key = 0
        mov [r10 + 48], rax;             // reserved = 0
        mov [r10 + 56], rax;             // reserved = 0
        mov rax, rbx;
        jmp ahcip_ta_out;

      ahcip_ta_enospc:
        mov rax, 0xFFFFEC94;             // AHCIP_TAIL_ENOSPC
        jmp ahcip_ta_out;
      ahcip_ta_bad:
        mov rax, 0xFFFFEC95;             // AHCIP_TAIL_BAD_ARG

      ahcip_ta_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let ahci_port_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): 1 iff row_id < AHCIP_MAX and in_use byte set. Labels prefixed ahcip_tv_.",
      block: {
        cmp rdi, 32;
        jae ahcip_tv_no;
        lea r10, [rip + _ahci_port_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ahcip_tv_no;
        mov rax, 1;
        ret;
      ahcip_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ahci_port_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): scrub row (all eight words). Labels prefixed ahcip_tf_.",
      block: {
        cmp rdi, 32;
        jae ahcip_tf_out;
        lea r10, [rip + _ahci_port_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      ahcip_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors.  Each returns AHCIP_DECODE_BAD when the row is not
  // live.  Shape mirrors nvme_ns_row_* / ahci_ctrl_row_* one-for-one so
  // a regression in one member of the family surfaces the same way in
  // the others.
  // -------------------------------------------------------------------

  pub let ahci_port_row_port_index : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M5-004 (#1660): port_index, or AHCIP_DECODE_BAD. Labels prefixed ahcip_rpi_.",
      block: {
        push r12;
        mov r12, rdi;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahcip_rpi_bad;
        lea r10, [rip + _ahci_port_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp ahcip_rpi_out;
      ahcip_rpi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      ahcip_rpi_out:
        pop r12;
        ret
      }
    }

