// PaideiaOS Phase-2 Capability Mint Operation
// P2-009: cap_mint(kind, target_ptr, rights) -> handle
//
// Per design/capabilities/phase1-api.md:
// Mint new capabilities into the process's CSpace (capability space).
// The mint operation allocates a fresh descriptor slot, initializes the
// capability with the given kind, target_ptr, and rights, and returns
// a handle (LAM-tagged pointer or software fallback per P2-003).
//
// Function signature deferred to paideia-as Phase 7+:
//   cap_mint(kind: u64, target_ptr: u64, rights: u64) -> u64
//
// The function will:
// 1. Validate the kind against KIND_* enum (from kind.pdx)
// 2. Allocate a fresh descriptor slot from the slab
// 3. Initialize the descriptor with generation, kind, target_ptr, rights
// 4. Return the encoded handle, or MINT_HANDLE_INVALID on failure

module Mint = structure {

  // ============================================================================
  // Result codes for cap_mint()
  // ============================================================================

  let MINT_RESULT_OK : u64 = 0                // Mint succeeded; handle returned
  let MINT_RESULT_SLAB_FULL : u64 = 1         // Slab allocator exhausted (no free slots)
  let MINT_RESULT_INVALID_KIND : u64 = 2      // kind parameter not in KIND_* enum
  let MINT_RESULT_INVALID_RIGHTS : u64 = 3    // rights not allowed for this kind

  // ============================================================================
  // Invalid handle sentinel
  // ============================================================================

  let MINT_HANDLE_INVALID : u64 = 0xFFFFFFFFFFFFFFFF  // All-ones; indicates failure

  // ============================================================================
  // cap_mint(kind: u64, target_ptr: u64, rights: u64) -> u64
  // Mints a new capability and returns its handle.
  //
  // Implementation (Phase 2.5 PA7 surface):
  // 1. Validate kind against KIND_* enum (PA7-007 match on kind).
  // 2. Check if rights are allowed for kind (PA7-003 if-test on rights_table lookup).
  // 3. Call slab_alloc() to allocate descriptor slot (PA7-002 inter-fn call).
  // 4. Initialize the descriptor via cap_mint_write, which writes the THREE
  //    fields that have storage -- kind at +0, rights at +8, target_ptr at
  //    +16 -- and clears the owner column.
  //
  //    R31.M1-1589 (#1589): step 4 previously read "Initialize descriptor
  //    fields (kind, target_ptr, rights, generation, flags)". THERE IS NO
  //    generation AND NO flags. The backing array is 256 x 3 u64s and the
  //    stride is 24, so `generation` at its old struct offset of +24 is the
  //    KIND FIELD OF DESCRIPTOR N+1. Following the old instruction would
  //    have corrupted the adjacent capability's type, and since `kind` is
  //    the first thing every gate checks, the symptom would have appeared
  //    arbitrarily far from the cause. See cap/table.pdx and
  //    design/capabilities/ownership-and-lineage.md §4.
  // 5. Return the slot as the handle, or MINT_HANDLE_INVALID on failure.
  //    There is no generation to encode into it; handle reuse is not
  //    currently defended and that is recorded in §4.1 of the design doc
  //    rather than implied by a field that does not exist.
  //
  // PA7 constructs used:
  //   PA7-001: Multi-statement function body.
  //   PA7-002: Inter-function calls (slab_alloc, encode_handle).
  //   PA7-003: If-test on slab_alloc result and rights validation.
  //   PA7-006: Multi-argument function calls (capture kind, target_ptr, rights).
  //   PA7-007: Match on kind enum for validation.
  // ============================================================================

  // R12-m5-001 note: rewritten from pure-fn if-else to unsafe block per
  // paideia-as #913. Semantics preserved: slab_alloc a slot; on invalid
  // slot return MINT_HANDLE_INVALID; else write descriptor and return slot.
  // Currently dead code at runtime (smokes call cap_mint_write directly);
  // retained for future higher-level allocators that may consume it.
  pub let cap_mint : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (kind: u64) (target_ptr: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "P2-009 cap_mint MVP: slab_alloc + slot bounds check + cap_mint_write. Rewritten as unsafe block per paideia-as #913. Curried args: rdi=kind, rsi=target_ptr, rdx=rights.",
      block: {
        // Save incoming args across slab_alloc call.
        push rdi;
        push rsi;
        push rdx;
        call slab_alloc;
        pop rdx;
        pop rsi;
        pop rdi;
        // rax = slot; if rax >= 256, return MINT_HANDLE_INVALID.
        cmp rax, 256;
        jae mint_bad_slot;
        // cap_mint_write ABI: rdi=slot, rsi=kind, rdx=rights, rcx=target_ptr.
        // Currently: rdi=kind, rsi=target_ptr, rdx=rights, rax=slot.
        // Shuffle via r10 for kind, r11 for target_ptr.
        mov r10, rdi;         // r10 = kind
        mov r11, rsi;         // r11 = target_ptr
        mov rdi, rax;         // rdi = slot
        mov rsi, r10;         // rsi = kind
        mov rcx, r11;         // rcx = target_ptr
        // rdx (rights) is unchanged.
        push rax;             // save slot for the return value
        call cap_mint_write;
        pop rax;              // restore slot as return value
        ret;
        mint_bad_slot:
          // MINT_HANDLE_INVALID = 0xFFFFFFFFFFFFFFFF.
          mov rax, 0xFFFFFFFFFFFFFFFF;
          ret
      }
    }

  pub let cap_mint_write : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "B5-002 + R31.M1-1587 (#1587): write the 24-byte capability descriptor at cap_table + slot*24 -- kind at +0, rights at +8, target_ptr at +16 -- and then UNCONDITIONALLY clear the owner column at cap_owner[slot] to CAP_OWNER_NONE. The clear is not housekeeping; it is the whole of the stale-ownership argument. A mint is the ONLY moment a slot changes hands, so clearing here makes 'the new capability is still owned by the previous holder' unreachable BY CONSTRUCTION rather than by the diligence of every revoke path -- including the several paths in this tree that clear a descriptor with three zero stores and never call a revoke function at all. Getting that wrong would not leak authority, it would DESTROY LIVE authority: a later sweep for the dead previous holder would revoke a capability a running process is using, which design/drivers/process-death.md names as strictly worse than the leak #1587 exists to close. Ownership is stamped afterwards by cap_owner_claim, as a separate audited step. Bounds: the caller guarantees slot < CAP_SLOT_MAX -- cap_mint's own `cmp rax, 256 / jae` and every derived kind's mint gate -- and this function is deliberately not re-checking, because it has no failure channel (its return type is unit) and a silent no-op on a bad slot would be a mint that reports success and wrote nothing. r10/r11 are caller-save scratch, so no prologue is needed and the four incoming argument registers are untouched.",
      block: {
        // RDI=slot, RSI=kind, RDX=rights, RCX=target_ptr (curried).
        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;           // r8 = slot * 8
        mov r9, rdi;
        shl r9, 4;           // r9 = slot * 16
        add r8, r9;          // r8 = slot * 24
        add rax, r8;
        mov [rax + 0],  rsi;  // kind
        mov [rax + 8],  rdx;  // rights
        mov [rax + 16], rcx;  // target_ptr
        // R31.M1-1587: the owner column of a freshly minted slot is
        // CAP_OWNER_NONE. Always. See the justification above.
        lea r10, [rip + cap_owner];
        xor r11, r11;                    // CAP_OWNER_NONE
        mov [r10 + rdi*8], r11;
        ret
      }
    }

}
