// src/kernel/core/cap/device_cap.pdx — R22-M3-003 / #858
// KIND_PCI_DEV derived capability descriptor (per-function PCI device)
//
// Design context
// --------------
// The R22.M2 PCI bus enumerator (src/kernel/core/pci/enum.pdx)
// populates _pci_devices with one 32-byte record per enumerated
// function. Every subsequent access to that function's configuration
// space, BAR MMIO, or IRQ vectors from ring-3 must go through a
// capability invocation — no ring-3 code should manufacture a
// BDF-address and speak MMIO directly.
//
// This module registers the *derived* kind KIND_PCI_DEV. It rides
// KIND_PAGE (base kind 4) because the underlying resource is a
// physical page range (ECAM config space for the function's 4 KiB
// slot) plus zero or more BAR regions. The choice of KIND_PAGE over
// KIND_DRIVER matches the KIND_ACPI precedent (acpi_cap.pdx §KIND
// base assignment): rights over a byte-addressable MMIO region are
// modelled uniformly on top of KIND_PAGE.
//
// KIND base assignment
// --------------------
// The base-kind enum is closed at 16 slots (cap/kind.pdx §Kind).
// Kind.KIND_DEVICE (base 10) is already assigned to the legacy
// device-handler kind (kind_dev.pdx) — a wholly separate role from
// this derived-cap module. To avoid a naming clash the derived tag
// used here is called KIND_PCI_DEV (value 0x30, above the 4-bit base
// range and distinct from KIND_DRIVER=0x15 and KIND_ACPI=0x20).
//
// Rights discipline
// -----------------
// Five refinement rights are defined on a KIND_PCI_DEV capability.
// A capability minted with fewer bits is strictly weaker; the union
// R_DEV_ALL is the "root" cap only a boot-time supervisor should
// hold.
//
//   R_DEV_CONFIG_READ  (bit 0)  — pci_config_read_u{8,16,32}
//   R_DEV_CONFIG_WRITE (bit 1)  — pci_config_write_u32
//   R_DEV_BAR_MAP      (bit 2)  — request MMIO mapping for a BAR
//   R_DEV_IRQ_BIND     (bit 3)  — MSI / MSI-X vector allocation
//   R_DEV_ADMIN        (bit 4)  — hot-remove, power management
//
// The default publication rights (see pci_publish_caps in
// core/pci/publish.pdx) are the minimum-privilege choice
// R_DEV_CONFIG_READ — a driver hosting process asks the broker to
// mint a stronger cap when it needs BAR or IRQ access.
//
// Descriptor payload layout (24 bytes)
// ------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  class
//   +6    u8  subclass
//   +7    u8  _pad0
//   +8    u16 vendor_id
//   +10   u16 device_id
//   +12   u16 bar_kinds_bitmap        // mirror of _pci_devices[i].bar_kinds_bitmap
//   +14   u16 _pad1
//   +16   u32 rights
//   +20   u32 _pad2
//
// The seg/bus/dev/fn triple pins the capability to a specific PCI
// function; the vendor / device ID pair is cached to let the kernel
// invalidate the cap on hot-remove without a second config-space
// round-trip.
//
// Fixture posture at R22.M3
// -------------------------
// This module is *mint-gate only*, matching acpi_cap.pdx and
// driver_cap.pdx. The gate validates rights, but the descriptor slab
// write is deferred until cap_revoke has a real body (see
// cap/revoke.pdx §R12-m5-001). #859 pci_publish_caps runs the mint
// call for every enumerated function; each call currently returns
// PCI_DEV_MINT_OK (0) without allocating a descriptor. The publication
// wiring lands in the same R23+ userspace-server round that unblocks
// #820 acpi_supervisor.

module DeviceCap = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================
  //
  // Runtime base kind for a KIND_PCI_DEV capability. Rides KIND_PAGE
  // (=4) because the underlying resource is one or more page-aligned
  // MMIO regions (ECAM config slot + BARs). Same posture as KIND_ACPI.

  pub let KIND_PCI_DEV_BASE : u64 = 4

  // Derived-kind tag. Placed above the 4-bit base range so it cannot
  // collide with a LAM base-kind tag. Value 0x30 chosen distinct from
  // KIND_DRIVER (0x15) and KIND_ACPI (0x20).

  pub let KIND_PCI_DEV : u64 = 0x30

  // Derived-tag byte (fits in one u8 for slab-tail encoding).
  pub let KIND_PCI_DEV_TAG : u64 = 0x30

  // ============================================================================
  // Rights (subset legal on a KIND_PCI_DEV capability)
  // ============================================================================

  pub let R_DEV_CONFIG_READ  : u64 = 0x01
  pub let R_DEV_CONFIG_WRITE : u64 = 0x02
  pub let R_DEV_BAR_MAP      : u64 = 0x04
  pub let R_DEV_IRQ_BIND     : u64 = 0x08
  pub let R_DEV_ADMIN        : u64 = 0x10
  pub let R_DEV_ALL          : u64 = 0x1F   // 0x01|0x02|0x04|0x08|0x10

  // ============================================================================
  // Mint return codes (mirror of AcpiCap.ACPI_MINT_*)
  // ============================================================================

  pub let PCI_DEV_MINT_OK          : u64 = 0
  pub let PCI_DEV_MINT_BAD_RIGHTS  : u64 = 0xFFFFFFFF
  pub let PCI_DEV_MINT_BAD_BDF     : u64 = 0xFFFFFFFE

  // ============================================================================
  // bdf_pack(seg, bus, dev, fn) -> u64
  // ============================================================================
  //
  // Encode a (seg, bus, dev, fn) tuple into a single u64 "bdf_key".
  // Layout:
  //   bits  7:0    fn   (u8, though only 3 bits used)
  //   bits 15:8    dev  (u8, though only 5 bits used)
  //   bits 23:16   bus  (u8)
  //   bits 39:24   seg  (u16)
  //
  // The lower 8 bits hold `fn` so that a caller that only cares about
  // (bus, dev, fn) — the common ECAM-under-single-segment case — can
  // truncate to u32 without losing information.

  pub let bdf_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (seg: u64) (bus: u64) (dev: u64) (fnid: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R22-M3-003 (#858) helper. Pack (seg, bus, dev, fn) into a single u64 BDF key. Layout: fn[7:0] | dev[15:8] | bus[23:16] | seg[39:24]. Body: mask each field to its byte width, shift into place, OR into rax. No calls, no memory access; pure arithmetic. Written as unsafe block per paideia-as #913 (pure-fn if-else T0532) — the compiler can't infer the pack pattern from higher-level syntax.",
      block: {
        // rax = fn & 0xFF
        mov rax, rcx;
        and rax, 0xFF;

        // r10 = (dev & 0xFF) << 8
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 8;
        or rax, r10;

        // r10 = (bus & 0xFF) << 16
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or rax, r10;

        // r10 = (seg & 0xFFFF) << 24
        mov r10, rdi;
        and r10, 0xFFFF;
        shl r10, 24;
        or rax, r10;

        ret
      }
    }

  // ============================================================================
  // rights_valid(rights) -> u64
  // ============================================================================
  //
  // Returns 1 if rights is a subset of R_DEV_ALL (0x1F), else 0.
  // Same shape as AcpiCap.rights_valid and DriverCap.rights_valid.

  pub let rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R22-M3-003 (#858): KIND_PCI_DEV rights-subset validator. Returns 1 iff (rights & R_DEV_ALL) == rights; else 0. R_DEV_ALL = 0x1F (bits 0..4). Same encoder posture as AcpiCap.rights_valid / DriverCap.rights_valid — unsafe block per paideia-as #913 (pure-fn if-else T0532).",
      block: {
        // rax = rights & R_DEV_ALL
        mov rax, rdi;
        mov r10, 0x1F;
        and rax, r10;

        // if rax == rights (rdi), return 1; else 0.
        cmp rax, rdi;
        jne dev_rights_no;
        mov rax, 1;
        ret;
        dev_rights_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // device_cap_mint(bdf, rights) -> u64
  // ============================================================================
  //
  // Gate-only mint per the AcpiCap pattern (real slab_alloc +
  // descriptor write reuses cap_mint / cap_mint_write; wire-up deferred
  // pending revoke's real body — see module header §Fixture posture).
  //
  // SysV ABI:
  //   rdi = bdf (u64, encoded via bdf_pack)
  //   rsi = rights (u32 in low bits)
  //   -> rax = PCI_DEV_MINT_OK on success, or PCI_DEV_MINT_BAD_*
  //
  // Return codes:
  //   PCI_DEV_MINT_OK          = 0
  //   PCI_DEV_MINT_BAD_BDF     = 0xFFFFFFFE   (bdf == 0 — no such device)
  //   PCI_DEV_MINT_BAD_RIGHTS  = 0xFFFFFFFF   (rights outside R_DEV_ALL)
  //
  // Device-lookup discipline: the "look up device in _pci_devices" step
  // called out in #858 is elided at M3 because the scaffolding mint
  // does not yet write a descriptor. Once the real cap_mint_write
  // wire-up lands (paired with cap_revoke's real body), the lookup
  // will translate `bdf` into a pointer to the matching
  // _pci_devices[i] record and stamp it into the descriptor payload's
  // seg/bus/dev/fn/vendor/device fields. Callers (pci_publish_caps)
  // guarantee `bdf != 0` for legitimate publications; a zero-bdf caller
  // trips PCI_DEV_MINT_BAD_BDF as a defensive-programming signal.

  pub let device_cap_mint : (u64, u64) -> u64 !{} @{} =
    fn (bdf: u64) (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R22-M3-003 (#858) KIND_PCI_DEV mint gate. Sequence: bdf != 0, then rights_valid(rights). On any failure return the corresponding PCI_DEV_MINT_BAD_*. Real slab_alloc + cap_mint_write wire-up deferred until cap_revoke has a real body (see cap/revoke.pdx §R12-m5-001) so that a KIND_PCI_DEV revoke-→-EPERM acceptance fixture can round-trip. Same structural posture as AcpiCap.acpi_cap_mint. Preserves rights (rsi) across the rights_valid call by shuffling it into rdi and back. Written as unsafe block per paideia-as #913.",
      block: {
        // Zero-bdf gate.
        cmp rdi, 0;
        je pci_dev_mint_bad_bdf;

        // rights_valid expects rights in rdi.
        mov rdi, rsi;
        call rights_valid;
        cmp rax, 0;
        je pci_dev_mint_bad_rights;

        // OK path — return PCI_DEV_MINT_OK (0). Real descriptor write
        // deferred (see module header §Fixture posture).
        mov rax, 0;
        ret;

        pci_dev_mint_bad_bdf:
          // PCI_DEV_MINT_BAD_BDF = 0xFFFFFFFE
          mov rax, 0xFFFFFFFE;
          ret;
        pci_dev_mint_bad_rights:
          // PCI_DEV_MINT_BAD_RIGHTS = 0xFFFFFFFF
          mov rax, 0xFFFFFFFF;
          ret
      }
    }
}
