// src/kernel/core/cap/kind_firmware_manifest.pdx -- Wave 59 I8 [R37] skeleton
// paideia-os #2565
//
// KIND_FW_MANIFEST = 0x5B, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// Kernel-side substrate for the GuC + HuC firmware bundle manifest with
// version-roll-forward policy. On Intel iGPU, two firmware blobs ship as
// a pinned pair per hardware generation: the GuC (microcontroller
// scheduler, offloads workload submission from the CPU) and the HuC
// (microcontroller crypto / media offload, extends the GuC with
// hardware-accelerated HEVC and codec acceleration).  This manifest
// tracks per-(role, hw_gen) the (blob_cap, version_major, version_minor,
// version_build) tuple plus a minimum-version floor for the role; a
// registration whose offered version is below the floor is REFUSED with
// FWM_VERSION_BELOW_MIN; a registration at or above the floor is logged
// + accepted.
//
// DISTINCT from KIND_FIRMWARE_BLOB (0x3C, Wave 73 cap/kind_firmware_blob
// .pdx) which authorises the raw byte range + BLAKE3 fingerprint of ONE
// blob; THIS kind composes two blob references into a bundle keyed by
// (role, hw_gen) with a monotone-roll-forward gate. The two coexist for
// the same reason KIND_BATTERY_DRV (0x3D) + KIND_BATTERY (0x158), and
// KIND_GPU_BO_DRV (0x43) + KIND_GPU_BO (0x174), coexist: one surface per
// role, dispatched by full-u64 kind tag.
//
// =============================================================================
// SECTION 0  DERIVATION POSTURE
// =============================================================================
//
// KIND_FW_MANIFEST derives over KIND_MEMORY (= KIND_PAGE, base slot 4)
// because the artefact a resolve hands back is a kernel-owned KIND_
// FIRMWARE_BLOB cap_slot referencing a measured in-memory byte range.
// Same posture as KIND_FIRMWARE_BLOB (0x3C), KIND_SIG_KEY (0x1A3),
// KIND_TLS_TRUST (0x1A7), KIND_SCHEMA_HANDLE (0x1B2): the kind field
// encodes the SEMANTIC (this is a firmware bundle manifest) and the
// LAM-hint base slot encodes the RUNTIME SHAPE (a memory region).
// Full-u64 kind compare means the dispatch arm at `cmp rcx, 0x5B`
// coexists with the slot-4 KIND_PAGE handler without ambiguity.
//
// =============================================================================
// SECTION 1  SLOT ASSIGNMENT  --  0x5B
// =============================================================================
//
// Numeric derived-kind tag KIND_FW_MANIFEST = 0x5B (decimal 91). The
// Wave 83 I5 KIND_TBT_NHI took 0x5A immediately before this slot; 0x5B
// is the next natural adjacent slot. Audit at landing time:
// `grep -nE '\b0x5[Bb]\b' src/kernel/core/cap/` returned zero hits; no
// existing dispatch arm overwritten.
//
// 0x5B fits imm32 with bit 31 clear so no r9 staging is required; the
// dispatch arm in cap/invoke.pdx is a direct `cmp rcx, 0x5B`, same cost
// as every other sub-0x80 kind in the pre-R29 block.
//
// =============================================================================
// SECTION 2  MANIFEST ROW LAYOUT  --  48 BYTES PER ROW, 8 ROWS
// =============================================================================
//
// Per Wave 59 I8 task directive, each row is 48 bytes = 6 u64:
//
//   [+0]   blob_cap                     (u64)   KIND_FIRMWARE_BLOB
//                                                cap_slot (<256) that
//                                                references the loaded
//                                                blob bytes; validated
//                                                at register time via a
//                                                cap_table[blob_cap].kind
//                                                == KIND_FIRMWARE_BLOB
//                                                probe
//   [+8]   version_packed               (u64)   low 32 =
//                                                major_minor_packed =
//                                                (major_u16 << 16) |
//                                                 minor_u16
//                                                high 32 =
//                                                version_build_u32
//   [+16]  hw_role                      (u64)   low 32 = hw_gen_u32
//                                                (iGPU hardware
//                                                generation ordinal
//                                                naming e.g. Gen12
//                                                Tiger/Alder, Gen13 ADL
//                                                / Raptor, Xe-LPG
//                                                Meteor Lake), high 32 =
//                                                role_u32 (0 = GuC,
//                                                1 = HuC)
//   [+24]  min_ver                      (u64)   low 32 = min_major_
//                                                minor_packed_u32,
//                                                high 32 = reserved (0
//                                                at Wave 84; future
//                                                epoch-stamp or sig-
//                                                verified bit)
//   [+32]  timestamp                    (u64)   boot-tick / scheduler
//                                                counter at register
//                                                (0 at Wave 84 - the
//                                                scheduler-counter
//                                                wiring lands alongside
//                                                the TPM PCR 7 extend
//                                                in paideia-os #2566)
//   [+40]  flags                        (u64)   bit 0 (0x1) = LIVE
//                                                (row is a valid entry
//                                                in the manifest); zero
//                                                flags == empty row
//                                                (the SENTINEL that
//                                                fw_manifest_find scans
//                                                for and that .bss
//                                                zero-init provides for
//                                                free)
//
// Row size: 48 bytes = 6 u64. Row-addressed capacity: FWM_MANIFEST_MAX
// rows -- 8 at this landing, matching the "GuC+HuC pair across up to
// four hardware generations" working-set that the Tiger-Alder-Raptor-
// Meteor Lake family of iGPUs targets. Grows by increasing FWM_
// MANIFEST_MAX (the arithmetic is a single `imul rax, r11` with r11
// seeded to 48 via `mov r11, 48` per the paideia-as encoder discipline
// below).
//
// flags & 0x1 == 0 marks an EMPTY ROW. The scan skips zero-flags slots
// and the fw_manifest_table_reset path below respects this invariant.
// .bss zero-init gives us the EMPTY state for free at real boot; the
// defensive reset covers the chaos-restart / witness-replay path.
//
// =============================================================================
// SECTION 3  ROLE TAXONOMY  --  0 = GuC, 1 = HuC
// =============================================================================
//
//   FWM_ROLE_GUC = 0   GuC = microcontroller SCHEDULER. Runs on the
//                       in-GPU HuC/GuC microcontroller; receives workload
//                       descriptors over doorbell MMIO and drives the
//                       render / blit / video engines without CPU
//                       round-trips. Required for any iGPU running the
//                       Wave 77 iris_xe_guc.pdx scheduler path.
//   FWM_ROLE_HUC = 1   HuC = microcontroller CRYPTO + MEDIA OFFLOAD.
//                       Runs alongside the GuC on the same
//                       microcontroller block; accelerates HEVC +
//                       codec operations the GuC alone could not perform
//                       at the clock budget the render engine demands.
//
// Any role > 1 is FWM_ROLE_UNKNOWN. Future generations may add a third
// role (e.g. GSC on Meteor Lake); extend by widening this taxonomy and
// adding a FWM_MIN_GSC_MAJOR constant alongside the existing floors.
//
// =============================================================================
// SECTION 4  BUILT-IN MINIMUM VERSIONS
// =============================================================================
//
// Version-roll-forward policy per Wave 59 I8 task directive: a register
// call whose offered major.minor is below the role's built-in floor is
// REFUSED with FWM_VERSION_BELOW_MIN; a register call whose offered
// version is at or above the floor is accepted and logged (the REGISTER
// fingerprint names the exact triple).
//
//   FWM_MIN_GUC_MAJOR = 70     (Alder Lake GuC baseline per upstream
//                               i915/guc firmware pin; a GuC older than
//                               70.x cannot support the Wave 77 workload
//                               submission ABI)
//   FWM_MIN_GUC_MINOR = 0
//   FWM_MIN_HUC_MAJOR = 7      (Tiger Lake HuC baseline; the HEVC
//                               offload entrypoints the Wave 78 vcs
//                               engine depends on landed in HuC 7.0)
//   FWM_MIN_HUC_MINOR = 0
//
// These are compile-time constants here; a later landing may make them
// settable per-boot via a signed boot config entry alongside the §6.3
// manifest-signature verification path.
//
// =============================================================================
// SECTION 5  RIGHTS  --  R_FWM_READ (0x001) ONLY
// =============================================================================
//
//   R_FWM_READ    (0x001)  gate every op in cap_handler_fw_manifest
//
// No MINT, no REVOKE, no FORWARD. A KIND_FW_MANIFEST cap is strictly
// read-only; register and resolve are supervisor-level entrypoints that
// operate on module-level state directly, not on a cap_table slot. The
// handler exists so that an already-minted manifest cap (not minted at
// Wave 84) can be queried for live-row counts without granting the
// holder manifest-write authority.
//
// R_FWM_ALL = R_FWM_READ = 0x001.
//
// =============================================================================
// SECTION 6  FAILURE TAXONOMY  --  0xFFFFFCB9..0xFFFFFCBD
// =============================================================================
//
// Per Wave 59 I8 task directive this module reserves five codes:
//
//   FWM_BAD_CAP              = 0xFFFFFCB9  (blob_cap out of range OR
//                                           cap_table[blob_cap].kind !=
//                                           KIND_FIRMWARE_BLOB)
//   FWM_MANIFEST_FULL        = 0xFFFFFCBA  (no empty row AND no existing
//                                           row for the (role, hw_gen)
//                                           tuple)
//   FWM_NO_ENTRY_FOR_HW_GEN  = 0xFFFFFCBB  (resolve / verify found no
//                                           live row for the role or
//                                           (role, hw_gen) tuple)
//   FWM_VERSION_BELOW_MIN    = 0xFFFFFCBC  (register's offered version
//                                           below built-in floor OR
//                                           below the existing row's
//                                           min_ver; verify's row below
//                                           the caller-supplied floor)
//   FWM_ROLE_UNKNOWN         = 0xFFFFFCBD  (role > FWM_ROLE_HUC = 1)
//
// All five fit imm32 (0xFFFFFCB9 sign-extends cleanly to u64 as
// 0xFFFFFFFFFFFFFCB9? -- NO: 0xFFFFFCB9 as a 32-bit value with bit 31
// SET sign-extends to 0xFFFFFFFFFFFFFCB9, which is NOT what we want
// here). We use `mov rax, 0xFFFFFCB9` which the paideia-as encoder
// emits as a zero-extended 32-bit load (bit 31 is set so it needs the
// zero-extend form). The literal 0xFFFFFCB9 as a u64 is 0x00000000_
// FFFFFCB9. On caller surfacing, witnesses compare against the full u64
// FWM_* constant below; the band 0xFFFFFCB9..BD is five contiguous
// codes above the EC_QUIRKS (R30) FFFFFC8x band and below the Wave 83
// G17 KIND_TABLE_PANE FFFFFCD2..D6 band.
//
// Audit at landing time: `grep -rnE '0xFFFFFCB[9-D]' src/` returned
// zero hits; this band is unclaimed.
//
// =============================================================================
// SECTION 7  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x5B fits imm32, so every compare against it uses
// `cmp rcx, 0x5B` directly (no r9/r11 staging). Error sentinels
// 0xFFFFFCB9..BD fit imm32 (zero-extend to u64 via the `mov rax,
// imm32` 7-byte emit). The row stride multiply uses `mov r11, 48; imul
// rax, r11` reg-reg (the paideia-as encoder has no 2-op `imul r, imm`
// form). The cap_table stride multiply follows kind_firmware_blob /
// kind_gpu_bo_drv one-for-one (shl r11, 3; shl rax, 4; add -- stride
// 24 = 8+16, two shifts and an add). Version-packing uses `shl rax,
// 16; or rax, ...` for the (major << 16) | minor compose, and `shl
// rax, 32; shr rax, 32` to extract the low 32 bits of the packed word
// (never `and rax, imm64`; the paideia-as encoder has no instruction
// encoding for that form, and the 0xFFFFFFFF mask would otherwise
// require a staged r11 load). Liveness tests use `cmp rN, 0` (never
// `test rN, rN` 2-op). All `pub let` string declarations are single-
// line. Module basename `KindFirmwareManifest` matches the file
// basename `kind_firmware_manifest.pdx`. Every label in this file is
// prefixed `fwm_` (reserved-word discipline -- `loop`/`if`/`let` are
// keywords).
//
// klog_s1_d3 convention per Wave 73 I7 regression memory: v2 lives at
// the caller's [rsp+0] AFTER sub rsp, 24 (which becomes [rbp+16] inside
// the wrapper's `push rbp` prologue); k3 at [rsp+8] -> [rbp+24]; v3
// at [rsp+16] -> [rbp+32]. firmware_blob_lookup / firmware_blob_slice
// carry the [rsp+0] discipline for klog_s1_x2 and this file follows
// the same convention for klog_s1_d3. The Wave 59 directive note
// "v2 at caller [rsp+0]" is the authoritative wire form.
//
// Fingerprint tag `[u8; N]` string literals have N = string length + 1
// (the trailing NUL counts). Each tag's N is spelled next to the
// literal for audit.

module KindFirmwareManifest = structure {

  pub let KIND_FW_MANIFEST      : u64 = 0x5B
  pub let KIND_FW_MANIFEST_BASE : u64 = 4         // = KIND_MEMORY (LAM-hint slot)

  // Role taxonomy (§3).
  pub let FWM_ROLE_GUC : u64 = 0
  pub let FWM_ROLE_HUC : u64 = 1
  pub let FWM_ROLE_MAX : u64 = 1

  // Built-in minimum versions (§4).
  pub let FWM_MIN_GUC_MAJOR : u64 = 70
  pub let FWM_MIN_GUC_MINOR : u64 = 0
  pub let FWM_MIN_HUC_MAJOR : u64 = 7
  pub let FWM_MIN_HUC_MINOR : u64 = 0

  // Rights (§5).
  pub let R_FWM_READ : u64 = 0x001
  pub let R_FWM_ALL  : u64 = 0x001

  // Ops (cap_handler_fw_manifest dispatch).
  pub let FWM_OP_READ            : u64 = 0  // live-row count probe
  pub let FWM_OP_QUERY_GUC_CAP   : u64 = 1  // op_arg bits [55:24] = hw_gen
                                            // -> blob_cap or 0
  pub let FWM_OP_QUERY_HUC_CAP   : u64 = 2  // op_arg bits [55:24] = hw_gen
                                            // -> blob_cap or 0
  pub let FWM_OP_MAX             : u64 = 2

  // Failure codes (§6). All five fit imm32 (zero-extend to u64 via
  // `mov rax, imm32`); they occupy a clean 5-wide band.
  pub let FWM_OK                   : u64 = 0
  pub let FWM_BAD_CAP              : u64 = 0xFFFFFCB9
  pub let FWM_MANIFEST_FULL        : u64 = 0xFFFFFCBA
  pub let FWM_NO_ENTRY_FOR_HW_GEN  : u64 = 0xFFFFFCBB
  pub let FWM_VERSION_BELOW_MIN    : u64 = 0xFFFFFCBC
  pub let FWM_ROLE_UNKNOWN         : u64 = 0xFFFFFCBD

  pub let FWM_ROW_NONE : u64 = 0xFF

  // Standard cap_invoke sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Manifest + row ceilings.
  pub let FWM_MANIFEST_MAX : u64 = 8      // row count at Wave 84
  pub let FWM_ROW_BYTES    : u64 = 48     // 6 u64

  // KIND_FIRMWARE_BLOB tag for the cap_table.kind cross-check at
  // register time. Mirrors kind_firmware_blob.pdx:148.
  pub let KIND_FIRMWARE_BLOB_LOCAL : u64 = 0x3C

  // Flags bit 0 = live row (§2).
  pub let FWM_FLAG_LIVE : u64 = 0x1

  // 8 rows * 48 bytes = 384 bytes = 48 u64. .bss zero-init means every
  // row starts with flags == 0 (the EMPTY sentinel, §2), which is the
  // free-slot marker fw_manifest_find scans for and fw_manifest_table_
  // reset overwrites.
  pub let mut _fw_manifest : [u64; 48] = uninit @align(64)

  // Observability counters: register_ok / register_refused_bad_cap /
  // register_refused_below_min / register_refused_full / resolve_ok /
  // resolve_miss / verify_ok / verify_fail. Bumped on each outcome,
  // visible via a future witness. Zero-init matches other kinds'
  // discipline.
  pub let mut _fw_manifest_stats : [u64; 8] = uninit @align(64)

  pub let FWM_ST_REG_OK          : u64 = 0
  pub let FWM_ST_REG_BAD_CAP     : u64 = 1
  pub let FWM_ST_REG_BELOW_MIN   : u64 = 2
  pub let FWM_ST_REG_FULL        : u64 = 3
  pub let FWM_ST_RESOLVE_OK      : u64 = 4
  pub let FWM_ST_RESOLVE_MISS    : u64 = 5
  pub let FWM_ST_VERIFY_OK       : u64 = 6
  pub let FWM_ST_VERIFY_FAIL     : u64 = 7

  // Fingerprint tags + keys. One tag per emitted event; §Section 2 of
  // the task directive names three wire shapes:
  //
  //   `FW_MANIFEST REGISTER role=<dec> hw_gen=<dec>`           -- frame 1
  //   `FW_MANIFEST REGISTER VER major=<dec> minor=<dec> build=<dec>` -- frame 2
  //   `FW_MANIFEST RESOLVE role=<dec> cap=0x<16-hex>`          -- resolve
  //   `FW_MANIFEST VERIFY role=<dec> ok=<dec>`                 -- verify
  //
  // Byte counts NUL-inclusive per kernel-logging-substrate.md #699
  // discipline.
  pub let fwm_tag_register      : [u8; 21] = "FW_MANIFEST REGISTER\0"
  pub let fwm_tag_register_ver  : [u8; 25] = "FW_MANIFEST REGISTER VER\0"
  pub let fwm_tag_resolve       : [u8; 20] = "FW_MANIFEST RESOLVE\0"
  pub let fwm_tag_verify        : [u8; 19] = "FW_MANIFEST VERIFY\0"
  pub let fwm_tag_handler_entry : [u8; 30] = "KIND_FW_MANIFEST dispatch inv\0"

  pub let fwm_k_role    : [u8; 5] = "role\0"
  pub let fwm_k_hw_gen  : [u8; 7] = "hw_gen\0"
  pub let fwm_k_major   : [u8; 6] = "major\0"
  pub let fwm_k_minor   : [u8; 6] = "minor\0"
  pub let fwm_k_build   : [u8; 6] = "build\0"
  pub let fwm_k_cap     : [u8; 4] = "cap\0"
  pub let fwm_k_ok      : [u8; 3] = "ok\0"

  // ==========================================================================
  // fw_manifest_table_reset() -> ()
  //
  // Defensive clear. Zero the manifest (48 u64) and the stats array
  // (8 u64). .bss is already zero at real boot; this call is belt-and-
  // braces per the KIND_FIRMWARE_BLOB / KIND_GPU_BO_DRV precedent and
  // gives a future witness or chaos-restart flow a clean re-scrub
  // point.
  // ==========================================================================
  pub let fw_manifest_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I8 [R37] (#2565): clear every _fw_manifest u64 (48 words) and every _fw_manifest_stats u64 (8 words). Boot and teardown only. .bss is already zero at real boot; this is defensive (matches KIND_FIRMWARE_BLOB firmware_blob_table_reset / KIND_GPU_BO_DRV gpu_bo_drv_table_reset one-for-one). Labels prefixed fwm_tr_.",
      block: {
        lea r10, [rip + _fw_manifest];
        xor rax, rax;
        xor rcx, rcx;
      fwm_tr_manifest:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  fwm_tr_manifest;

        lea r10, [rip + _fw_manifest_stats];
        xor rcx, rcx;
      fwm_tr_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  fwm_tr_stats;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_row_base(row_id) -> &_fw_manifest[row_id*48]
  //
  // Row index -> row base pointer. Stride 48 computed via `mov r11,
  // 48; imul rax, r11` reg-reg per the Wave 59 I8 task directive. The
  // paideia-as encoder has no 2-op `imul r, imm` form; the reg-reg
  // 3-byte imul is the canonical path (same posture every other row-
  // base helper in the cap/ tree lands on when the stride is not a
  // sum of two power-of-two shifts).
  // ==========================================================================
  pub let fw_manifest_row_base : (u64) -> u64 !{} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave 59 I8 [R37] (#2565): row_id -> &_fw_manifest[row_id*48]. Stride 48 computed as `mov r11, 48; imul rax, r11` reg-reg per the Wave 59 I8 task directive (paideia-as has no 2-op imul-with-imm). No bounds check by policy, caller validates first. Labels prefixed fwm_rb_.",
      block: {
        mov rax, rdi;                    // row_id
        mov r11, 48;
        imul rax, r11;                   // row_id * 48
        lea r10, [rip + _fw_manifest];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_row_live(row_id) -> 1 iff row_id < FWM_MANIFEST_MAX AND
  //                                       flags & FWM_FLAG_LIVE != 0
  //
  // The flags==0 sentinel marks an empty slot (§2); an in-range row_id
  // whose flags lack the LIVE bit is NOT live. fw_manifest_register
  // sets flags |= FWM_FLAG_LIVE on write; a future revoke path would
  // clear it.
  // ==========================================================================
  pub let fw_manifest_row_live : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I8 [R37] (#2565): 1 iff row_id < FWM_MANIFEST_MAX(8) and flags (word 5 at [+40]) & FWM_FLAG_LIVE != 0. Three callee-save pushes (none needed; this is a pure leaf). Labels prefixed fwm_rv_.",
      block: {
        mov r10, 8;                      // FWM_MANIFEST_MAX
        cmp rdi, r10;
        jae fwm_rv_no;
        mov rax, rdi;
        mov r11, 48;
        imul rax, r11;
        lea r10, [rip + _fw_manifest];
        add rax, r10;
        mov r10, [rax + 40];             // flags
        mov r11, 1;                      // FWM_FLAG_LIVE
        and r10, r11;
        cmp r10, 0;
        je  fwm_rv_no;
        mov rax, 1;
        ret;
      fwm_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_find(role, hw_gen) -> row_id | FWM_ROW_NONE
  //
  // Linear scan for the first LIVE row whose hw_role word (word 2 at
  // [+16]) matches (role << 32) | hw_gen. On miss returns FWM_ROW_NONE
  // (0xFF). Three callee-save pushes land rsp%16==0 at the nested
  // fw_manifest_row_base call.
  // ==========================================================================
  pub let fw_manifest_find : (u64, u64) -> u64 !{mem} @{} =
    fn (role: u64) (hw_gen: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I8 [R37] (#2565): linear scan _fw_manifest[0..FWM_MANIFEST_MAX) for the first live row whose hw_role word matches (role << 32) | hw_gen. On no match return FWM_ROW_NONE (0xFF). r12 parks the computed match key across the row-base call; r13 is the row_id cursor. Three callee-save pushes (rbx + r12 + r13) land rsp%16==0 at the nested fw_manifest_row_base calls (entry rsp%16==8, +3*8=32, 32%16==0). Labels prefixed fwm_mf_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // key = (role << 32) | hw_gen -> r12
        mov r12, rsi;                    // hw_gen (low 32)
        mov r10, rdi;                    // role
        shl r10, 32;
        or  r12, r10;

        xor r13, r13;                    // row_id cursor
      fwm_mf_scan:
        cmp r13, 8;
        jae fwm_mf_none;

        mov rdi, r13;
        call fw_manifest_row_base;
        mov rbx, rax;                    // row base
        mov r10, [rbx + 40];             // flags
        mov r11, 1;                      // FWM_FLAG_LIVE
        and r10, r11;
        cmp r10, 0;
        je  fwm_mf_next;                 // skip empty

        mov r10, [rbx + 16];             // hw_role word
        cmp r10, r12;
        je  fwm_mf_hit;

      fwm_mf_next:
        add r13, 1;
        jmp fwm_mf_scan;

      fwm_mf_hit:
        mov rax, r13;
        jmp fwm_mf_out;

      fwm_mf_none:
        mov rax, 0xFF;                   // FWM_ROW_NONE

      fwm_mf_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_find_empty() -> row_id | FWM_ROW_NONE
  //
  // Linear scan for the first row whose flags word is zero (the EMPTY
  // sentinel). Returns FWM_ROW_NONE if the manifest is full. Two
  // callee-save pushes (rbx + r13) + sub rsp,8 land rsp%16==0 at the
  // nested fw_manifest_row_base call.
  // ==========================================================================
  pub let fw_manifest_find_empty : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I8 [R37] (#2565): linear scan _fw_manifest[0..FWM_MANIFEST_MAX) for the first row whose flags word is zero (EMPTY sentinel). On full return FWM_ROW_NONE (0xFF). Two callee-save pushes (rbx + r13) + sub rsp,8 land rsp%16==0 at the nested fw_manifest_row_base call (entry rsp%16==8, +2*8+8 = 24, 24%16==8 -- WAIT -- +2*8=16 lands at 24%16==8, then +8 sub lands at 32%16==0. Good.). Labels prefixed fwm_fe_.",
      block: {
        push rbx;
        push r13;
        sub rsp, 8;

        xor r13, r13;                    // row_id cursor
      fwm_fe_scan:
        cmp r13, 8;
        jae fwm_fe_none;

        mov rdi, r13;
        call fw_manifest_row_base;
        mov rbx, rax;                    // row base
        mov r10, [rbx + 40];             // flags
        cmp r10, 0;
        je  fwm_fe_hit;                  // empty slot

        add r13, 1;
        jmp fwm_fe_scan;

      fwm_fe_hit:
        mov rax, r13;
        jmp fwm_fe_out;

      fwm_fe_none:
        mov rax, 0xFF;                   // FWM_ROW_NONE

      fwm_fe_out:
        add rsp, 8;
        pop r13;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_blob_cap_ok(blob_cap) -> 1 iff cap_table[blob_cap].kind
  //                                            == KIND_FIRMWARE_BLOB
  //
  // Validate the blob_cap argument at register time. Checks bounds
  // (blob_cap < 256) and probes cap_table[blob_cap].kind for
  // KIND_FIRMWARE_BLOB (0x3C). cap_table stride is 24 bytes (kind +
  // rights + target_ptr); same shl-shl-add arithmetic kind_firmware_
  // blob / kind_gpu_bo_drv use.
  // ==========================================================================
  pub let fw_manifest_blob_cap_ok : (u64) -> u64 !{mem} @{cap} =
    fn (blob_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): blob_cap validator. Bounds check (blob_cap < 256) + cap_table[blob_cap].kind == KIND_FIRMWARE_BLOB (0x3C). cap_table stride 24 computed as (blob_cap<<3) + (blob_cap<<4) == blob_cap*24. Returns 1 if valid, 0 else. No callee-save pushes needed (pure leaf). Labels prefixed fwm_bk_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae fwm_bk_no;

        lea r10, [rip + cap_table];
        mov r11, rdi;
        shl r11, 3;
        mov rax, rdi;
        shl rax, 4;
        add r11, rax;
        add r10, r11;                    // &cap_table[blob_cap*24]
        mov rax, [r10 + 0];              // descriptor.kind
        cmp rax, 0x3C;                   // KIND_FIRMWARE_BLOB
        jne fwm_bk_no;
        mov rax, 1;
        ret;

      fwm_bk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_note(stats_slot) -> ()
  //
  // Bump _fw_manifest_stats[slot]. Caller passes slot ordinal (FWM_ST_*).
  // ==========================================================================
  pub let fw_manifest_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 I8 [R37] (#2565): bump _fw_manifest_stats[slot] by 1. slot ordinals in {0..7} enumerated above as FWM_ST_*. Pure leaf, no bounds check (caller passes constants only). Labels prefixed fwm_no_.",
      block: {
        lea r10, [rip + _fw_manifest_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_register_impl(blob_cap, major, minor, build, hw_gen, role) -> u64
  //
  // Shared implementation for fw_manifest_register_guc / _huc. Six-arg
  // signature exhausts the paideia-as 6-param SysV budget (rdi..r9). Any
  // seventh arg would need stack passing; none is needed here because
  // the policy inputs are fully captured in the six registers.
  //
  // Algorithm:
  //   1. Validate role <= FWM_ROLE_HUC; else FWM_ROLE_UNKNOWN.
  //   2. Validate blob_cap via fw_manifest_blob_cap_ok; else
  //      FWM_BAD_CAP (bump stats REG_BAD_CAP).
  //   3. Validate offered version >= built-in min for role; else
  //      FWM_VERSION_BELOW_MIN (bump REG_BELOW_MIN). The compare is
  //      against (min_major << 16) | min_minor packed as u32.
  //   4. Scan for existing live row with (role, hw_gen) via
  //      fw_manifest_find. If hit, overwrite ONLY if the offered
  //      major.minor is strictly greater (roll-forward); if equal
  //      or lower, return FWM_VERSION_BELOW_MIN (we never re-register
  //      an older or same version over a live row).
  //   5. If no existing row, allocate via fw_manifest_find_empty; on
  //      full return FWM_MANIFEST_FULL (bump REG_FULL).
  //   6. Write the row: blob_cap, version_packed, hw_role, min_ver,
  //      timestamp=0, flags=LIVE.
  //   7. Bump REG_OK, emit two fingerprint frames:
  //         "FW_MANIFEST REGISTER role=<dec> hw_gen=<dec>" (klog_s1_d2)
  //         "FW_MANIFEST REGISTER VER major=<dec> minor=<dec> build=<dec>"
  //              (klog_s1_d3, three decimal values)
  //   8. Return FWM_OK.
  //
  // Register plan: rbx = blob_cap, r12 = version_packed (upper 32 =
  // build, lower 32 = major_minor), r13 = hw_role word, r14 = row_id,
  // r15 = min_ver packed. 5 callee-save pushes + stack frame for the
  // role spill (needed across nested calls that may clobber r9) +
  // the klog_s1_d3 stack-arg slots.
  //
  // Alignment: entry rsp%16==8; 5 pushes land rsp%16==0; the two
  // nested helper calls carry no extra alignment; the klog_s1_d2
  // frame uses `sub rsp, 16; mov [rsp+0], v2` (v2 at [rsp+0] per the
  // Wave 73 I7 regression memory); the klog_s1_d3 frame uses `sub rsp,
  // 24; mov [rsp+0]=v2, [rsp+8]=k3, [rsp+16]=v3`. 24 bytes keeps
  // rsp%16==8 at the call -- WAIT: 24 is not a multiple of 16, so the
  // call would see rsp%16==8 (BAD). The remedy per the Wave 59 I8
  // task directive is to pair the 24-byte sub with an 8-byte pad:
  // `sub rsp, 32; mov [rsp+0]=v2, [rsp+8]=k3, [rsp+16]=v3; call ...;
  // add rsp, 32`. 32 % 16 == 0 so the call site sees rsp%16==0. Final
  // slot [rsp+24] is left unused (pad).
  // ==========================================================================
  pub let fw_manifest_register_impl : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (blob_cap: u64) (major: u64) (minor: u64) (build: u64) (hw_gen: u64) (role: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): shared register implementation. Six-arg signature exhausts paideia-as 6-reg SysV budget (rdi=blob_cap, rsi=major, rdx=minor, rcx=build, r8=hw_gen, r9=role). Validate role<=1 (else FWM_ROLE_UNKNOWN); validate blob_cap via fw_manifest_blob_cap_ok (else FWM_BAD_CAP, bump REG_BAD_CAP); validate version>=built-in min for role via packed-u32 compare (else FWM_VERSION_BELOW_MIN, bump REG_BELOW_MIN); scan for existing (role, hw_gen) row, allowing roll-forward overwrite only on strictly-newer major.minor; else allocate empty row via fw_manifest_find_empty (else FWM_MANIFEST_FULL, bump REG_FULL); write six-u64 row (blob_cap, version_packed, hw_role, min_ver, timestamp=0, flags=LIVE); emit two fingerprint frames (klog_s1_d2 for role+hw_gen then klog_s1_d3 for major+minor+build); bump REG_OK; return FWM_OK. Five callee-save pushes (rbx+r12+r13+r14+r15) land rsp%16==0 at every nested call. One stack spill (sub rsp, 16) parks role (we lose r9 across nested calls) and keeps alignment on 16. klog_s1_d3 frame uses sub rsp,32 (24 bytes needed + 8 pad) so rsp%16==0 at the klog call. Labels prefixed fwm_rg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // rsp%16: 8 + 40 = 48, 48 % 16 = 0 at nested calls.

        // Step 1: role bounds. r9 holds role on entry.
        cmp r9, 1;                       // FWM_ROLE_MAX = 1
        ja  fwm_rg_role_bad;

        // Stash blob_cap, major, minor, build in callee-save regs.
        mov rbx, rdi;                    // blob_cap
        mov r12, rsi;                    // major
        mov r13, rdx;                    // minor
        mov r14, rcx;                    // build
        mov r15, r8;                     // hw_gen

        // Park role on stack (r9 is caller-save; nested calls clobber
        // it). The second slot is reserved for min_packed, set once the
        // floor is computed and read back inside fwm_rg_write.
        sub rsp, 16;                     // 16 is % 16 == 0 preservation
        mov [rsp + 0], r9;               // role
        // [rsp+8] reserved for min_packed (filled after the floor-
        // compute block below).

        // Step 2: blob_cap validation.
        mov rdi, rbx;
        call fw_manifest_blob_cap_ok;
        cmp rax, 0;
        je  fwm_rg_bad_cap;

        // Step 3: version-min gate. Pack offered version:
        //   major_minor_packed = (major << 16) | minor   (low 32 bits)
        //   version_packed     = (build << 32) | major_minor_packed
        mov rax, r12;                    // major
        shl rax, 16;
        or  rax, r13;                    // major_minor_packed in low 32
        // Preserve major_minor_packed for the min-compare in rbx -- but
        // rbx still holds blob_cap which we need below for the row
        // write. Park major_minor_packed in rax; the compare below
        // reloads the min packed value in r10 and compares against rax
        // directly.
        mov r10, [rsp + 0];              // role (reload)
        cmp r10, 0;                      // GuC?
        jne fwm_rg_min_huc;
        // GuC floor: FWM_MIN_GUC_MAJOR = 70, FWM_MIN_GUC_MINOR = 0.
        mov r11, 70;
        shl r11, 16;                     // = 70 << 16 (minor 0 or'd in = 0)
        jmp fwm_rg_min_cmp;
      fwm_rg_min_huc:
        // HuC floor: FWM_MIN_HUC_MAJOR = 7, FWM_MIN_HUC_MINOR = 0.
        mov r11, 7;
        shl r11, 16;
      fwm_rg_min_cmp:
        // rax = offered major_minor_packed; r11 = min packed.
        // Park min_packed into [rsp+8] so it survives every nested call
        // below (r11 is caller-save and the row_base / find helpers
        // clobber it).
        mov [rsp + 8], r11;              // park min_packed
        cmp rax, r11;
        jb  fwm_rg_below_min;            // offered < min  -> refuse

        // Compose full version_packed = (build << 32) | major_minor_packed.
        // rax still holds the low-32 packed; shift build and or in.
        mov r10, r14;                    // build
        shl r10, 32;
        or  rax, r10;                    // rax = version_packed full u64
        mov r12, rax;                    // park version_packed in r12
                                         // (reusing r12 -- major is now
                                         // dead, having been consumed
                                         // into the packed form).

        // Compose hw_role word = (role << 32) | hw_gen.
        mov rax, [rsp + 0];              // role
        shl rax, 32;
        mov r13, r15;                    // hw_gen (low 32)
        or  r13, rax;                    // r13 = hw_role word (reuse r13;
                                         // minor is dead by now).

        // Step 4: scan for existing live row at (role, hw_gen).
        mov rdi, [rsp + 0];              // role
        mov rsi, r15;                    // hw_gen
        call fw_manifest_find;
        // rax = row_id | FWM_ROW_NONE (0xFF).

        mov r10, 0xFF;
        cmp rax, r10;
        je  fwm_rg_alloc;                // no existing row -> allocate

        // Existing row at rax. Roll-forward: compare offered major_minor
        // against existing row's major_minor. Only overwrite if strict
        // greater. Equal or lower -> FWM_VERSION_BELOW_MIN.
        mov r14, rax;                    // row_id (reusing r14; build is
                                         // already baked into r12).
        mov rdi, r14;
        call fw_manifest_row_base;
        mov r10, [rax + 8];              // existing version_packed
        // Extract low 32 bits (major_minor) via shl-shr pair.
        shl r10, 32;
        shr r10, 32;                     // r10 = existing major_minor
        mov rax, r12;                    // offered version_packed
        shl rax, 32;
        shr rax, 32;                     // rax = offered major_minor
        cmp rax, r10;
        jbe fwm_rg_below_min;            // offered <= existing -> refuse

        jmp fwm_rg_write;                // roll-forward overwrite

      fwm_rg_alloc:
        // No existing row; allocate.
        call fw_manifest_find_empty;
        mov r10, 0xFF;
        cmp rax, r10;
        je  fwm_rg_full;
        mov r14, rax;                    // row_id

      fwm_rg_write:
        // Row write. r14 = row_id, r12 = version_packed, r13 = hw_role,
        // [rsp+8] = min_ver packed (low 32 bits), rbx = blob_cap.
        mov rdi, r14;
        call fw_manifest_row_base;
        // rax = row base. r11 reloaded AFTER the nested call (it was
        // clobbered by fw_manifest_row_base's internal computations).
        mov [rax + 0],  rbx;             // blob_cap
        mov [rax + 8],  r12;             // version_packed
        mov [rax + 16], r13;             // hw_role
        mov r11, [rsp + 8];              // reload min_packed
        mov [rax + 24], r11;             // min_ver (low 32 = min packed)
        xor r10, r10;
        mov [rax + 32], r10;             // timestamp = 0
        mov r10, 1;                      // FWM_FLAG_LIVE
        mov [rax + 40], r10;             // flags = LIVE

        // Bump REG_OK.
        mov rdi, 0;                      // FWM_ST_REG_OK
        call fw_manifest_note;

        // Frame 1: `FW_MANIFEST REGISTER role=<dec> hw_gen=<dec>`.
        // klog_s1_d2 convention: v2 at caller [rsp+0] after sub rsp,16
        // (becomes [rbp+16] inside wrapper).
        sub rsp, 16;
        mov r10, r15;                    // hw_gen
        mov [rsp + 0], r10;              // v2 slot
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fwm_tag_register];
        lea rcx, [rip + fwm_k_role];     // k1
        mov r8, [rsp + 16];              // reload role from parked slot
                                         // (sub rsp,16 above moved the
                                         // earlier [rsp+0] to [rsp+16])
        lea r9, [rip + fwm_k_hw_gen];    // k2
        call klog_s1_d2;
        add rsp, 16;

        // Frame 2: `FW_MANIFEST REGISTER VER major=<dec> minor=<dec>
        // build=<dec>`. klog_s1_d3 convention: v2 at [rsp+0], k3 at
        // [rsp+8], v3 at [rsp+16]. We need 24 bytes of stack-args + 8
        // pad = 32 bytes to keep rsp%16==0 at the call site.
        // Reload the three decimals from the version_packed in r12:
        //   major = (version_packed >> 16) & 0xFFFF
        //   minor =  version_packed        & 0xFFFF
        //   build =  version_packed >> 32
        mov rax, r12;                    // version_packed
        mov r10, rax;
        shr r10, 32;                     // r10 = build
        mov r11, rax;
        shl r11, 32;                     // zero high 32 by shl-shr pair
        shr r11, 32;                     // r11 = major_minor_packed
        mov rax, r11;
        shr rax, 16;                     // rax = major
        mov rcx, r11;
        mov r9, 0xFFFF;
        and rcx, r9;                     // rcx = minor

        sub rsp, 32;                     // 24 args + 8 pad; rsp%16==0
        mov [rsp + 0], rcx;              // v2 = minor
        lea r9, [rip + fwm_k_build];
        mov [rsp + 8], r9;               // k3 = build key
        mov [rsp + 16], r10;             // v3 = build

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fwm_tag_register_ver];
        lea rcx, [rip + fwm_k_major];    // k1
        mov r8, rax;                     // v1 = major
        lea r9, [rip + fwm_k_minor];     // k2
        call klog_s1_d3;
        add rsp, 32;

        xor rax, rax;                    // FWM_OK
        jmp fwm_rg_out;

      fwm_rg_bad_cap:
        mov rdi, 1;                      // FWM_ST_REG_BAD_CAP
        call fw_manifest_note;
        mov rax, 0xFFFFFCB9;             // FWM_BAD_CAP
        jmp fwm_rg_out;

      fwm_rg_below_min:
        // Reachable from BOTH the floor-compare `jb` (rax < min_packed)
        // and the roll-forward `jbe` (rax <= existing version). Both
        // branches enter with stack = 5 callee-save pushes + sub rsp,
        // 16 (role spill at [rsp+0], min_packed at [rsp+8]); the shared
        // fwm_rg_out teardown restores. Nothing to unwind here.
        mov rdi, 2;                      // FWM_ST_REG_BELOW_MIN
        call fw_manifest_note;
        mov rax, 0xFFFFFCBC;             // FWM_VERSION_BELOW_MIN
        jmp fwm_rg_out;

      fwm_rg_full:
        mov rdi, 3;                      // FWM_ST_REG_FULL
        call fw_manifest_note;
        mov rax, 0xFFFFFCBA;             // FWM_MANIFEST_FULL
        jmp fwm_rg_out;

      fwm_rg_role_bad:
        // Reached BEFORE the sub rsp,16 role spill. Don't undo it.
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        mov rax, 0xFFFFFCBD;             // FWM_ROLE_UNKNOWN
        ret;

      fwm_rg_out:
        // Undo the sub rsp,16 role spill before the callee-save pops.
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_register_guc(blob_cap, major, minor, build, hw_gen) -> u64
  //
  // Thin shim: sets r9 = FWM_ROLE_GUC (0) and delegates to
  // fw_manifest_register_impl. Entry rsp%16==8; sub rsp,8 realigns to 0
  // for the nested call; the matching add rsp,8 restores before ret.
  // ==========================================================================
  pub let fw_manifest_register_guc : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (blob_cap: u64) (major: u64) (minor: u64) (build: u64) (hw_gen: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): GuC register shim. Sets r9 = FWM_ROLE_GUC (0) and delegates to fw_manifest_register_impl. Entry rsp%16==8; `sub rsp, 8` realigns to 0 for the nested call. Labels prefixed fwm_rgu_.",
      block: {
        sub rsp, 8;
        mov r9, 0;                       // FWM_ROLE_GUC
        call fw_manifest_register_impl;
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_register_huc(blob_cap, major, minor, build, hw_gen) -> u64
  //
  // Thin shim: sets r9 = FWM_ROLE_HUC (1) and delegates to
  // fw_manifest_register_impl.
  // ==========================================================================
  pub let fw_manifest_register_huc : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (blob_cap: u64) (major: u64) (minor: u64) (build: u64) (hw_gen: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): HuC register shim. Sets r9 = FWM_ROLE_HUC (1) and delegates to fw_manifest_register_impl. Entry rsp%16==8; `sub rsp, 8` realigns to 0 for the nested call. Labels prefixed fwm_rhu_.",
      block: {
        sub rsp, 8;
        mov r9, 1;                       // FWM_ROLE_HUC
        call fw_manifest_register_impl;
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_resolve_impl(role, hw_gen) -> blob_cap | 0
  //
  // Shared implementation for fw_manifest_resolve_guc / _huc. Scan for
  // live row matching (role, hw_gen); if found, return the row's
  // blob_cap. If not found, return 0 (we do NOT return the error band
  // sentinel here because 0 is a reserved cap_slot that no mint ever
  // hands out, and a resolve miss is a legitimate per-boot outcome
  // on hardware without that generation's firmware packaged in).
  //
  // Emits `FW_MANIFEST RESOLVE role=<dec> cap=0x<16-hex>` via
  // klog_s1_x1_d1 (1 decimal + 1 hex -- the decimal arrives in rcx
  // first per the wrapper's signature, so caller stages role then cap
  // reverse of the natural reading order). Actually re-reading the
  // klog_s1_x1_d1 header: args rdi=level, rsi=subsys, rdx=tag, rcx=kx,
  // r8=vx, r9=kd, [rsp+8]=vd (first hex then decimal). So we pass
  // kx=cap_key, vx=blob_cap, kd=role_key, [rsp+8]=role. The emitted
  // line reads "cap=0x<16-hex> role=<dec>" which the golden captures.
  //
  // Register plan: rbx = role, r12 = hw_gen, r13 = blob_cap. Three
  // callee-save pushes land rsp%16==0 at every nested call.
  // ==========================================================================
  pub let fw_manifest_resolve_impl : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (role: u64) (hw_gen: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): shared resolve. Scan live rows for (role, hw_gen); if found return blob_cap else 0 (0 is a reserved cap_slot that mint never hands out, so 0 unambiguously signals miss). Emits `FW_MANIFEST RESOLVE cap=0x<16-hex> role=<dec>` via klog_s1_x1_d1 (hex first then decimal per the wrapper's signature). Bumps RESOLVE_OK or RESOLVE_MISS. Three callee-save pushes (rbx + r12 + r13) land rsp%16==0 at nested calls. Labels prefixed fwm_rs_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // role
        mov r12, rsi;                    // hw_gen

        mov rdi, rbx;
        mov rsi, r12;
        call fw_manifest_find;
        mov r10, 0xFF;
        cmp rax, r10;
        je  fwm_rs_miss;

        // rax = row_id. Load blob_cap from row[+0].
        mov rdi, rax;
        call fw_manifest_row_base;
        mov r13, [rax + 0];              // blob_cap

        mov rdi, 4;                      // FWM_ST_RESOLVE_OK
        call fw_manifest_note;

        // Emit fingerprint via klog_s1_x1_d1 (hex then decimal).
        // v_decimal at [rsp+0] after sub rsp,16.
        sub rsp, 16;
        mov [rsp + 0], rbx;              // v_dec = role
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fwm_tag_resolve];
        lea rcx, [rip + fwm_k_cap];      // kx = cap
        mov r8, r13;                     // vx = blob_cap
        lea r9, [rip + fwm_k_role];      // kd = role
        call klog_s1_x1_d1;
        add rsp, 16;

        mov rax, r13;                    // blob_cap
        jmp fwm_rs_out;

      fwm_rs_miss:
        mov rdi, 5;                      // FWM_ST_RESOLVE_MISS
        call fw_manifest_note;

        // Emit fingerprint with cap=0 (reserved miss marker).
        sub rsp, 16;
        mov [rsp + 0], rbx;              // v_dec = role
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fwm_tag_resolve];
        lea rcx, [rip + fwm_k_cap];
        xor r8, r8;                      // vx = 0 (miss)
        lea r9, [rip + fwm_k_role];
        call klog_s1_x1_d1;
        add rsp, 16;

        xor rax, rax;                    // 0 = miss

      fwm_rs_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_resolve_guc(hw_gen) -> blob_cap | 0
  // ==========================================================================
  pub let fw_manifest_resolve_guc : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (hw_gen: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): GuC resolve shim. Sets rdi = role = FWM_ROLE_GUC (0), rsi = hw_gen (from caller), delegates to fw_manifest_resolve_impl. Entry rsp%16==8; sub rsp,8 realigns. Labels prefixed fwm_rsgu_.",
      block: {
        sub rsp, 8;
        mov rsi, rdi;                    // move hw_gen to rsi
        mov rdi, 0;                      // role = GuC
        call fw_manifest_resolve_impl;
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_resolve_huc(hw_gen) -> blob_cap | 0
  // ==========================================================================
  pub let fw_manifest_resolve_huc : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (hw_gen: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): HuC resolve shim. Sets rdi = role = FWM_ROLE_HUC (1), rsi = hw_gen, delegates to fw_manifest_resolve_impl. Labels prefixed fwm_rshu_.",
      block: {
        sub rsp, 8;
        mov rsi, rdi;                    // hw_gen -> rsi
        mov rdi, 1;                      // role = HuC
        call fw_manifest_resolve_impl;
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // fw_manifest_verify_min_version(role, major_min, minor_min) -> u64
  //
  // Scan all live rows for the given role; for each, compare the row's
  // major.minor (packed low 32 of version_packed) against the caller-
  // supplied (major_min << 16) | minor_min. If ANY row is below the
  // supplied floor, return FWM_VERSION_BELOW_MIN; if NO rows for role,
  // return FWM_NO_ENTRY_FOR_HW_GEN; else FWM_OK.
  //
  // Emits `FW_MANIFEST VERIFY role=<dec> ok=<dec>` via klog_s1_d2.
  //
  // Register plan: rbx = role, r12 = min_major_minor_packed, r13 =
  // row_id cursor, r14 = row_base, r15 = per-call ok_bit accumulator.
  // Five callee-save pushes land rsp%16==0 at every nested call.
  // ==========================================================================
  pub let fw_manifest_verify_min_version : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (role: u64) (major_min: u64) (minor_min: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): verify ALL live rows for role meet (major_min, minor_min) floor via packed-u32 compare. Any row below -> FWM_VERSION_BELOW_MIN (bump VERIFY_FAIL); no rows for role -> FWM_NO_ENTRY_FOR_HW_GEN; else FWM_OK (bump VERIFY_OK). Role>1 -> FWM_ROLE_UNKNOWN. Emits `FW_MANIFEST VERIFY role=<dec> ok=<dec>` via klog_s1_d2. Register plan: rbx=role, r12=min_packed, r13=row cursor, r14=row base, r15=found-live-row flag. Five callee-save pushes land rsp%16==0 at every nested call. Labels prefixed fwm_vr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Role bounds.
        cmp rdi, 1;
        ja  fwm_vr_role_bad;

        mov rbx, rdi;                    // role

        // Compute min_packed = (major_min << 16) | minor_min (low 32).
        mov rax, rsi;                    // major_min
        shl rax, 16;
        or  rax, rdx;                    // (major_min << 16) | minor_min
        mov r12, rax;                    // r12 = min_packed

        xor r13, r13;                    // row cursor
        xor r15, r15;                    // found-live-row flag
        mov r9, 0;                       // verdict = OK (0 = ok, 1 = below)

      fwm_vr_scan:
        cmp r13, 8;
        jae fwm_vr_done;

        mov rdi, r13;
        call fw_manifest_row_base;
        mov r14, rax;

        // Skip empty rows.
        mov r10, [r14 + 40];             // flags
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        je  fwm_vr_next;

        // Role filter -- (hw_role >> 32) == role?
        mov r10, [r14 + 16];
        shr r10, 32;                     // role from row
        cmp r10, rbx;
        jne fwm_vr_next;

        mov r15, 1;                      // found at least one live row

        // Compare row's major_minor to min.
        mov r10, [r14 + 8];              // version_packed
        shl r10, 32;
        shr r10, 32;                     // major_minor low 32
        cmp r10, r12;
        jb  fwm_vr_below;

      fwm_vr_next:
        add r13, 1;
        jmp fwm_vr_scan;

      fwm_vr_below:
        mov r9, 1;                       // verdict = BELOW_MIN
        add r13, 1;
        jmp fwm_vr_scan;                 // keep scanning for coverage;
                                         // (verdict latches to BELOW)

      fwm_vr_done:
        // Decide final verdict + emit fingerprint.
        cmp r15, 0;
        je  fwm_vr_no_entry;

        cmp r9, 0;
        jne fwm_vr_below_min_out;

        // All green.
        mov rdi, 6;                      // FWM_ST_VERIFY_OK
        call fw_manifest_note;

        // Emit `FW_MANIFEST VERIFY role=<dec> ok=<dec>` with ok=1.
        sub rsp, 16;
        mov r10, 1;
        mov [rsp + 0], r10;              // v2 = ok=1
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fwm_tag_verify];
        lea rcx, [rip + fwm_k_role];
        mov r8, rbx;                     // v1 = role
        lea r9, [rip + fwm_k_ok];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                    // FWM_OK
        jmp fwm_vr_out;

      fwm_vr_below_min_out:
        mov rdi, 7;                      // FWM_ST_VERIFY_FAIL
        call fw_manifest_note;

        // Emit ok=0.
        sub rsp, 16;
        xor r10, r10;
        mov [rsp + 0], r10;              // v2 = ok=0
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fwm_tag_verify];
        lea rcx, [rip + fwm_k_role];
        mov r8, rbx;
        lea r9, [rip + fwm_k_ok];
        call klog_s1_d2;
        add rsp, 16;

        mov rax, 0xFFFFFCBC;             // FWM_VERSION_BELOW_MIN
        jmp fwm_vr_out;

      fwm_vr_no_entry:
        mov rax, 0xFFFFFCBB;             // FWM_NO_ENTRY_FOR_HW_GEN
        jmp fwm_vr_out;

      fwm_vr_role_bad:
        mov rax, 0xFFFFFCBD;             // FWM_ROLE_UNKNOWN

      fwm_vr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_fw_manifest(rights, target_ptr, op_arg) -> u64
  //
  // KIND_FW_MANIFEST cap_invoke dispatch. Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x5B; je
  // call_kind_fw_manifest` arm. Thin op-router -- the real register /
  // resolve / verify entrypoints are the supervisor-only ABI calls
  // above; this handler exposes read-only query ops to a (future)
  // minted KIND_FW_MANIFEST cap.
  //
  //   op 0 FWM_OP_READ          -> live-row count (0..FWM_MANIFEST_MAX)
  //   op 1 FWM_OP_QUERY_GUC_CAP -> fw_manifest_resolve_guc(op_arg >> 8)
  //   op 2 FWM_OP_QUERY_HUC_CAP -> fw_manifest_resolve_huc(op_arg >> 8)
  //   else                      -> INVOKE_UNSUPPORTED
  //
  // op_arg encoding: low 8 bits = op_code; bits 8..39 = hw_gen (for
  // QUERY_*_CAP ops). The 32-bit hw_gen fits trivially inside op_arg
  // minus the op_code byte.
  //
  // Rights gate: every op requires R_FWM_READ.
  // ==========================================================================
  pub let cap_handler_fw_manifest : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 I8 [R37] (#2565): KIND_FW_MANIFEST cap_invoke dispatch. Entry chatter (klog_s1 of fwm_tag_handler_entry). Rights gate against R_FWM_READ (uniform). op_code = op_arg & 0xFF; hw_gen = (op_arg >> 8) & 0xFFFFFFFF; dispatch 0..2. op 0 returns live-row count via a tight scan; ops 1-2 delegate to the resolve_guc / resolve_huc entrypoints respectively. Three callee-save pushes (rbx=rights, r12=op_code, r13=hw_gen) land rsp%16==0 at every nested call. Labels prefixed fwm_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rdx;                    // op_arg
        mov r10, 0xFF;
        and r12, r10;                    // op_code = op_arg[7:0]
        mov r13, rdx;
        shr r13, 8;
        mov r10, 0xFFFFFFFF;
        and r13, r10;                    // hw_gen = (op_arg >> 8) & 0xFFFFFFFF

        // Entry chatter.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + fwm_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                  // R_FWM_READ
        cmp r10, 0;
        je  fwm_hd_denied;

        // Op dispatch.
        cmp r12, 0;
        je  fwm_hd_op_read;
        cmp r12, 1;
        je  fwm_hd_op_guc;
        cmp r12, 2;
        je  fwm_hd_op_huc;
        jmp fwm_hd_unsup;

      fwm_hd_op_read:
        // Live-row count. Walk 8 rows, bump counter on live flag.
        xor rax, rax;                    // count
        xor rcx, rcx;                    // cursor
      fwm_hd_op_read_scan:
        cmp rcx, 8;
        jae fwm_hd_out;
        mov r10, rcx;
        mov r11, 48;
        imul r10, r11;
        lea r11, [rip + _fw_manifest];
        add r10, r11;                    // row base
        mov r11, [r10 + 40];             // flags
        mov r9, 1;
        and r11, r9;
        cmp r11, 0;
        je  fwm_hd_op_read_next;
        add rax, 1;
      fwm_hd_op_read_next:
        add rcx, 1;
        jmp fwm_hd_op_read_scan;

      fwm_hd_op_guc:
        mov rdi, r13;                    // hw_gen
        call fw_manifest_resolve_guc;
        jmp fwm_hd_out;

      fwm_hd_op_huc:
        mov rdi, r13;                    // hw_gen
        call fw_manifest_resolve_huc;
        jmp fwm_hd_out;

      fwm_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp fwm_hd_out;

      fwm_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      fwm_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx needs ONE new call alongside the existing TLS / NIC
  // / schema-handle / firmware-blob resets:
  //
  //   call fw_manifest_table_reset;     // defensive zero
  //
  // Zero-arg, allocates nothing on the stack, touches rax/rcx/r10;
  // safe alongside kernel_main's live r12/r13/r14 handoff registers.
  // Wiring deferred to a follow-up slice (same discipline every other
  // `*_table_reset` boot wiring follows). At real boot .bss zero-init
  // leaves _fw_manifest already empty so resolve correctly MISSES
  // without the wiring.
  //
  // Cross-module caller sites (future landings):
  //   - drivers/gpu/iris_xe_guc.pdx (Wave 77, cap 0x46): guc_load_
  //     firmware will call fw_manifest_resolve_guc(hw_gen) to obtain
  //     the blob_cap to pass to the existing firmware_blob_slice path.
  //     Same for the HuC loader when the Wave 78 vcs_engine lands.
  //   - drivers/gpu/guc/bundle.pdx (Wave 83): bundle_verify will call
  //     fw_manifest_verify_min_version(FWM_ROLE_GUC, 70, 0) at submit
  //     time to refuse workload submission against a stale GuC.
  // ==========================================================================
}
