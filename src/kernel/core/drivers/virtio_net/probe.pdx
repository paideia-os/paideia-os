// src/kernel/core/drivers/virtio_net/probe.pdx — R91.M3-001 (paideia-os #2019)
//
// virtio-net PCI probe + modern/legacy BAR discovery.
//
// After pci_enumerate_all (src/kernel/core/pci/enum.pdx) populates
// _pci_devices with one 32-byte record per enumerated function, the
// virtio-net probe filters that list for the PCI vendor triple that
// identifies a virtio-net controller in either its transitional
// (legacy) or modern (virtio 1.0+) presentation:
//
//   vendor_id  = 0x1AF4 (Red Hat / virtio)
//   device_id  = 0x1041                (modern virtio-net — DID 0x1040 +
//                                       virtio_id 0x01) — the QEMU
//                                       virtio-net-pci default since
//                                       QEMU 4.0.
//   device_id  = 0x1000 AND
//   subsys_id  = 0x0001                (transitional virtio-net — the
//                                       legacy DID range 0x1000..0x103F
//                                       uses subsystem_id to select the
//                                       device class; 1 = network card)
//
// vendor_id and device_id live at _pci_devices record +8/+10 (enum.pdx
// §"pci_device_record layout"). subsys_id lives at PCI config offset
// 0x2E — not published in the enum record, so the transitional path
// reads it directly via pci_config_read_u16.
//
// This landing is BAR-discovery only. The tx / rx / virtqueue / common_
// cfg accessors follow in R91.M3-002..R91.M3-005 (paideia-os #2020,
// #2021, #2022, #2023). The probe records enough state per matched
// device for those follow-ups to bring the ring plane up without
// re-walking the PCI capability chain: BAR0 (legacy), BAR4 (modern),
// and — per virtio 1.1 §4.1.4 — the (bar_idx, offset) tuple for each
// of the four modern configuration structures (COMMON, NOTIFY, ISR,
// DEVICE), plus the NOTIFY cap's notify_off_multiplier. The MSI-X
// capability offset is also captured up-front so R91.M3-005's ISR does
// not need a second pci_find_cap pass on the vector-arm path.
//
// -----------------------------------------------------------------------------
// _virtio_net_devices record layout (64 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  is_modern             // 1 iff device_id == 0x1041; 0 iff transitional
//   +6    u16 device_id             // recorded for R91.M3-002 feature-neg gates
//   +8    u64 bar0_pa               // BAR0 base (legacy MMIO or IO-port);
//                                   //   0 if BAR0 is unused / unmapped
//   +16   u64 bar4_pa               // BAR4 base (modern virtio-pci config
//                                   //   carrier; conventionally holds all
//                                   //   four cfg structures under QEMU);
//                                   //   0 if BAR4 is unused / unmapped
//   +24   u16 common_cfg_off        // byte offset within common_cfg_bar
//   +26   u16 notify_off            // byte offset within notify_bar
//   +28   u16 isr_off               // byte offset within isr_bar
//   +30   u16 device_cfg_off        // byte offset within device_cfg_bar
//   +32   u8  common_cfg_bar        // BAR index (0..5) carrying COMMON_CFG
//   +33   u8  notify_bar
//   +34   u8  isr_bar
//   +35   u8  device_cfg_bar
//   +36   u32 notify_off_multiplier // NOTIFY cap extension (virtio 1.1 §4.1.4.4)
//   +40   u16 cap_msix_off          // MSI-X cap header offset; 0 iff absent
//   +42   u16 _pad0
//   +44   u32 _pad1
//   +48   u64 _pad2                 // reserved for feature-select cache
//   +56   u64 mac                   // populated by R91.M3-006 (mac.pdx);
//                                   //   6 bytes packed low, high 2 B unused
//   +64   end
//
// Layout is byte-for-byte compatible with _e1000e_devices on the
// (seg, bus, dev, fn, _, cap_msix_off, bar_pa) shared prefix idea, but
// the stride is 64 rather than 32 because modern virtio carries FOUR
// per-cfg BAR/offset pairs plus notify_off_multiplier — none of which
// have an e1000e analog. Overflow slots beyond VIRTIO_NET_MAX_DEVS are
// silently dropped (observable via the fingerprint count).
//
// -----------------------------------------------------------------------------
// VIRTIO_NET_MAX_DEVS = 4
// -----------------------------------------------------------------------------
//
// QEMU tolerates -device virtio-net-pci repeated up to the PCIe slot
// budget; developer boot lines rarely exceed four. Bare-metal servers
// with more than four virtio-net NICs are a niche the R91 MVP does not
// address — a fifth+ candidate is silently dropped and the overflow is
// observable via the fingerprint count. Same posture as e1000e's
// E1000E_MAX_DEVS = 2.
//
// -----------------------------------------------------------------------------
// Modern (cap-walk) vs legacy (fixed) BAR discovery
// -----------------------------------------------------------------------------
//
// Modern virtio-pci (virtio 1.1 §4.1.4) publishes four vendor-specific
// PCI capability headers (cap_id = 0x09), each carrying a `cfg_type`
// byte at cap+3 selecting which of {COMMON=1, NOTIFY=2, ISR=3,
// DEVICE=4, PCI_CFG=5} it describes, plus (bar, offset) at cap+4 and
// cap+8..cap+11 respectively pointing into the BAR where that cfg
// structure lives. The NOTIFY cap has one extension field:
// `notify_off_multiplier` at cap+16..cap+19, which the notify path
// multiplies by the negotiated queue's notify offset to synthesize
// the doorbell address (virtio 1.1 §4.1.4.4). The probe walks the cap
// chain via the same idiom as pci_find_cap (pci/cap.pdx §"pci_find_
// cap"): mask cap_ptr @ config 0x34 with 0xFC, then follow next_ptr @
// each cap+1 with the same mask, bounding the walk at 48 visits to
// tolerate corrupt chains — same bound cap.pdx §pci_find_cap uses.
//
// Legacy (transitional) virtio-pci uses a fixed BAR0-based I/O-port or
// MMIO layout with no vendor caps. The probe records bar0_pa for those
// devices; the per-cfg (bar, offset) slots stay zero and the future
// R91.M3-002 accessors branch on is_modern to compute effective
// addresses via the legacy fixed layout (queue_select at bar0+14,
// queue_size at bar0+12, etc.) instead of via common_cfg_bar/offset.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.24.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` narrow store widens -> use `mov_d` / `mov_w`
//       / `mov_b` for sized stores into the record.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `vn_pb_` to avoid the
// paideia-as reserved names (`loop`, `if`, `next`, ...).

module Probe = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let VIRTIO_VENDOR_ID           : u64 = 0x1AF4   // Red Hat / virtio
  pub let VIRTIO_NET_DID_MODERN      : u64 = 0x1041   // modern virtio-net (QEMU default)
  pub let VIRTIO_NET_DID_LEGACY      : u64 = 0x1000   // transitional virtio (subsys selects class)
  pub let VIRTIO_NET_SUBSYS_ID       : u64 = 0x0001   // subsystem_id for network class

  pub let VIRTIO_NET_MAX_DEVS        : u64 = 4
  pub let VIRTIO_NET_DEV_REC_SIZE    : u64 = 64

  // virtio 1.1 §4.1.4 vendor-specific cfg_type discriminants.
  pub let VIRTIO_PCI_CAP_COMMON_CFG  : u64 = 1
  pub let VIRTIO_PCI_CAP_NOTIFY_CFG  : u64 = 2
  pub let VIRTIO_PCI_CAP_ISR_CFG     : u64 = 3
  pub let VIRTIO_PCI_CAP_DEVICE_CFG  : u64 = 4

  // Vendor-specific PCI capability ID (PCI 3.0 §H.4).
  pub let VIRTIO_PCI_VENDOR_CAP_ID   : u64 = 0x09

  // ============================================================================
  // Canonical static slots — .bss, @align(8)
  // ============================================================================
  //
  //   _virtio_net_devices        : 4 x 64 B = 256 B = 32 x u64
  //   _virtio_net_device_count   : populated by virtio_net_probe

  pub let mut _virtio_net_devices      : [u64; 32] = uninit @align(8)
  pub let mut _virtio_net_device_count : u64      = 0

  // ============================================================================
  // virtio_net_probe() -> u64
  // ============================================================================
  //
  // SysV: () -> u64
  //   Returns rax = number of virtio-net devices discovered (0..VIRTIO_NET_MAX_DEVS=4).
  //
  // Register plan (mirrors e1000e_probe with an added cap-walk cursor):
  //   rbx = i (loop index into _pci_devices)
  //   r12 = _pci_device_count (loaded once)
  //   r13 = j (virtio-net write index into _virtio_net_devices)
  //   r14 = &_pci_devices[i] (recomputed each iter)
  //   r15 = &_virtio_net_devices[j] (recomputed on match; also spilled to
  //         [rsp+48] so pci_config_read_u* calls that clobber it via caller-
  //         save reload paths don't drop the record ptr — even though r15
  //         is callee-save under SysV, the reload cost is one MOV and
  //         defensively removes a ledger the future me has to maintain)
  //   rbp = cap-walk cursor (callee-save; survives every pci_config_read_u* call)
  //
  //   Scratch slots (88 B; entry rsp%16==8, 6 pushes = 48 -> rsp%16==8,
  //   sub rsp,88 -> rsp%16==0 aligned for every nested SysV call):
  //     [rsp+0]  = seg (u64 zero-extended)
  //     [rsp+8]  = bus (u64)
  //     [rsp+16] = dev (u64)
  //     [rsp+24] = fn  (u64)
  //     [rsp+32] = bar0_pa (u64)
  //     [rsp+40] = bar4_pa (u64)
  //     [rsp+48] = record_ptr spill (u64)
  //     [rsp+56] = cap-walk visit counter (u64; survives nested reads)
  //     [rsp+64] = cap-walk cfg_type spill (u64; survives cap+4 / cap+8 reads)
  //     [rsp+72] = cap-walk bar_idx spill  (u64; survives cap+8 offset read,
  //                                         which clobbers r10 as caller-save)
  //     [rsp+80] = pad / spare (keeps sub rsp,88 aligned; %16==8 else)

  pub let virtio_net_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R91.M3-001 (paideia-os #2019). virtio-net PCI probe + modern/legacy BAR discovery. Structurally e1000e_probe (drivers/e1000e/probe.pdx L172) with the vendor + device match retargeted to (0x1AF4, {0x1041 modern | 0x1000+subsys=1 transitional}) and — for modern devices — an inline vendor-specific capability walk (cap_id 0x09) capturing per-cfg_type (bar_idx, offset) tuples plus notify_off_multiplier. Body: (1) 6-push callee-save prologue (rbx, rbp, r12, r13, r14, r15) = 48 B; entry rsp%16==8 -> 56 (%16==8); sub rsp,88 -> rsp%16==0 aligned for every nested SysV call. Scratch layout [rsp+0..24] for seg/bus/dev/fn; [rsp+32] for bar0_pa; [rsp+40] for bar4_pa; [rsp+48] for record_ptr spill; [rsp+56] for cap-walk visit counter; [rsp+64] for cap-walk cfg_type spill; [rsp+72] for cap-walk bar_idx spill (both survive the pci_config_read_u32 offset read at cap+8, which clobbers r10/r11 as caller-save). (2) Init j=r13=0; load _pci_device_count into r12; init i=rbx=0. (3) Per-iteration bounds check: cmp rbx, r12; jae done. (4) Compute r14 = &_pci_devices[i] = _pci_devices + (i << 5) — record stride 32 = shl 5. (5) Load vendor_id (u16 @ r14+8); if != 0x1AF4 -> skip. (6) Load device_id (u16 @ r14+10) into rax. Modern check: if == 0x1041 -> jump to vn_pb_matched_modern (records BDF via the same block the legacy path uses, then falls to vn_pb_matched_common). Otherwise, if == 0x1000 -> proceed to the transitional path; else skip. (7) Transitional path: stash BDF from r14 into [rsp+0..24] and read subsystem_id via pci_config_read_u16(seg, bus, dev, fn, 0x2E); if != 0x0001 -> skip. Fall through to vn_pb_matched_common. (8) Overflow guard: if r13 >= VIRTIO_NET_MAX_DEVS (=4), skip (silent drop — observable via fingerprint count). (9) Zero-init bar0_pa/bar4_pa scratch. (10) Read BAR0 lo via pci_config_read_u32(seg, bus, dev, fn, 0x10). Bit 0 = 1 -> I/O BAR: bar0_pa = raw & ~0x3 (mask I/O type bits). Bit 0 == 0 -> MEM BAR; bits [2:1] == 10 -> 64-bit: read BAR0 hi at 0x14, compose bar0_pa = (hi<<32) | (lo & ~0xF); else -> 32-bit: bar0_pa = lo & ~0xF. (11) Read BAR4 lo via pci_config_read_u32(seg, bus, dev, fn, 0x20). BAR4 == 0 -> no modern config (legacy-only device); leave bar4_pa = 0 and skip to bar_done. Bit 0 == 1 (I/O in BAR4 is nonstandard for virtio modern) -> skip. Bits [2:1] handling mirrors BAR0. (12) Compute r15 = &_virtio_net_devices[j] = base + (j << 6); zero the 64-byte record (8 x mov [r15+N], 0); spill r15 to [rsp+48]. (13) Populate scalar fields: seg u16 @+0, bus/dev/fn u8s @+2/+3/+4, is_modern u8 @+5 (1 iff device_id==0x1041), device_id u16 @+6, bar0_pa u64 @+8, bar4_pa u64 @+16. (14) Walk vendor caps to fill per-cfg_type slots. Read cap_ptr u8 @ config 0x34, mask & 0xFC into rbp. Init visit counter [rsp+56] = 0. Loop: (a) end-of-list guard rbp==0; (b) visit-count guard >=48; (c) read cap_id u8 @ cursor+0; (d) if != 0x09 -> advance; (e) vendor cap: read cfg_type u8 @ cursor+3; if not in [1..4] -> advance; spill cfg_type to [rsp+64]; read bar_idx u8 @ cursor+4 into r10; read offset u32 @ cursor+8 into rax; reload r15 from [rsp+48] and cfg_type from [rsp+64]; switch on cfg_type: COMMON -> u16 @+24 = offset, u8 @+32 = bar_idx; NOTIFY -> u16 @+26 = offset, u8 @+33 = bar_idx, then read notify_off_multiplier u32 @ cursor+16 and store u32 @+36; ISR -> u16 @+28 = offset, u8 @+34 = bar_idx; DEVICE -> u16 @+30 = offset, u8 @+35 = bar_idx; (f) advance: read next_ptr u8 @ cursor+1, mask 0xFC into rbp, bump visit counter, loop. (15) After cap-walk: pci_find_cap(seg, bus, dev, fn, 0x11 MSI-X) -> u16 cap_msix_off; reload r15 from [rsp+48]; u16 @+40 = cap_msix_off. (16) j += 1; advance i; loop. (17) On loop exit: publish _virtio_net_device_count = r13. (18) Emit klog_s1_d1(LEVEL_INFO=3, SUBSYS_NET_, tag_virtio_probe_ok, k_count, r13) -- always emits so the no-virtio-device path (count=0) is grep-assertable. (19) Return r13 in rax. Reserved-label posture: labels prefixed `vn_pb_`. All nested callees (pci_config_read_u{8,16,32}, pci_find_cap, klog_s1_d1) preserve rbx/rbp/r12-r15 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 88;

        // Init counters.
        xor r13, r13;                             // j = 0 (virtio-net write index)
        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;                             // i = 0

      vn_pb_loop:
        cmp rbx, r12;
        jae vn_pb_done;

        // r14 = &_pci_devices[i]
        mov rax, rbx;
        shl rax, 5;                               // record stride 32 = shl 5
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // vendor_id (u16 @+8)
        xor rax, rax;
        mov_w rax, [r14 + 8];
        cmp rax, 0x1AF4;                          // VIRTIO_VENDOR_ID
        jne vn_pb_next;

        // device_id (u16 @+10) into rax
        xor rax, rax;
        mov_w rax, [r14 + 10];

        // Modern (0x1041) is the fast path — no subsystem check needed.
        cmp rax, 0x1041;                          // VIRTIO_NET_DID_MODERN
        je  vn_pb_matched_modern;

        // Legacy / transitional (0x1000) — needs subsystem_id gate.
        cmp rax, 0x1000;                          // VIRTIO_NET_DID_LEGACY
        jne vn_pb_next;

        // Stash BDF into scratch (transitional path — reused by matched_common).
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;                       // seg
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;                       // bus
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;                      // dev
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;                      // fn

        // Read subsystem_id (u16 @ config 0x2E). Transitional virtio uses
        // the subsystem_id to select the device class; 1 = network.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x2E;
        call pci_config_read_u16;
        and rax, 0xFFFF;
        cmp rax, 0x0001;                          // VIRTIO_NET_SUBSYS_ID
        jne vn_pb_next;

        jmp vn_pb_matched_common;

      vn_pb_matched_modern:
        // Stash BDF into scratch (modern path).
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;                       // seg
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;                       // bus
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;                      // dev
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;                      // fn

      vn_pb_matched_common:
        // Overflow guard.
        cmp r13, 4;                               // VIRTIO_NET_MAX_DEVS
        jae vn_pb_next;

        // Zero the BAR scratch slots (defaults for missing BARs).
        xor rax, rax;
        mov [rsp + 32], rax;
        mov [rsp + 40], rax;

        // ============================================================
        // Read BAR0 (offset 0x10) — legacy MMIO / I/O port carrier.
        // ============================================================
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x10;
        call pci_config_read_u32;

        mov r10, rax;                             // preserve bar0_lo
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne vn_pb_bar0_io;

        // MEM BAR. Bits [2:1]: 00 = 32-bit, 10 = 64-bit.
        mov r11, r10;
        shr r11, 1;
        and r11, 3;
        cmp r11, 2;
        je  vn_pb_bar0_64;

        // MEM32: bar0_pa = bar0_lo & ~0xF
        mov r15, r10;
        and r15, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 32], r15;
        jmp vn_pb_bar4;

      vn_pb_bar0_io:
        // I/O BAR: bar0_pa = bar0_lo & ~0x3 (mask I/O type bits).
        mov r15, r10;
        and r15, 0xFFFFFFFFFFFFFFFC;
        mov [rsp + 32], r15;
        jmp vn_pb_bar4;

      vn_pb_bar0_64:
        // Save bar0_lo across the hi-word read.
        mov [rsp + 32], r10;

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x14;
        call pci_config_read_u32;

        shl rax, 32;
        mov r10, [rsp + 32];
        and r10, 0xFFFFFFFFFFFFFFF0;
        or  rax, r10;
        mov [rsp + 32], rax;

      vn_pb_bar4:
        // ============================================================
        // Read BAR4 (offset 0x20) — modern virtio-pci cfg carrier.
        // ============================================================
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x20;
        call pci_config_read_u32;

        mov r10, rax;
        // BAR4 == 0 -> legacy-only or non-conforming device; skip.
        cmp r10, 0;
        je  vn_pb_bar_done;

        // I/O in BAR4 is nonstandard for virtio modern -> skip.
        mov r11, r10;
        and r11, 1;
        cmp r11, 0;
        jne vn_pb_bar_done;

        // MEM check bits [2:1].
        mov r11, r10;
        shr r11, 1;
        and r11, 3;
        cmp r11, 2;
        je  vn_pb_bar4_64;

        // MEM32: bar4_pa = bar4_lo & ~0xF
        mov r15, r10;
        and r15, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 40], r15;
        jmp vn_pb_bar_done;

      vn_pb_bar4_64:
        mov [rsp + 40], r10;                      // stash bar4_lo

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x24;
        call pci_config_read_u32;

        shl rax, 32;
        mov r10, [rsp + 40];
        and r10, 0xFFFFFFFFFFFFFFF0;
        or  rax, r10;
        mov [rsp + 40], rax;

      vn_pb_bar_done:
        // ============================================================
        // Populate the record. r15 = &_virtio_net_devices[j].
        // ============================================================
        mov r11, r13;
        shl r11, 6;                               // record stride 64 = shl 6
        lea r15, [rip + _virtio_net_devices];
        add r15, r11;

        // Zero the 64-byte record (8 x u64).
        xor r10, r10;
        mov [r15 + 0], r10;
        mov [r15 + 8], r10;
        mov [r15 + 16], r10;
        mov [r15 + 24], r10;
        mov [r15 + 32], r10;
        mov [r15 + 40], r10;
        mov [r15 + 48], r10;
        mov [r15 + 56], r10;

        // Spill record_ptr so cap-walk reloads it after each nested read.
        mov [rsp + 48], r15;

        // u16 seg @+0
        mov r10, [rsp + 0];
        mov_w [r15 + 0], r10;
        // u8 bus @+2
        mov r10, [rsp + 8];
        mov_b [r15 + 2], r10;
        // u8 dev @+3
        mov r10, [rsp + 16];
        mov_b [r15 + 3], r10;
        // u8 fn @+4
        mov r10, [rsp + 24];
        mov_b [r15 + 4], r10;

        // u16 device_id @+6 — reload from _pci_devices[i]+10.
        xor r10, r10;
        mov_w r10, [r14 + 10];
        mov_w [r15 + 6], r10;

        // u8 is_modern @+5: 1 iff device_id == 0x1041.
        cmp r10, 0x1041;
        je  vn_pb_set_modern;
        xor r10, r10;
        mov_b [r15 + 5], r10;
        jmp vn_pb_after_modern_flag;

      vn_pb_set_modern:
        mov r10, 1;
        mov_b [r15 + 5], r10;

      vn_pb_after_modern_flag:
        // u64 bar0_pa @+8
        mov r10, [rsp + 32];
        mov [r15 + 8], r10;
        // u64 bar4_pa @+16
        mov r10, [rsp + 40];
        mov [r15 + 16], r10;

        // ============================================================
        // Vendor-cap walk — populate per-cfg_type (bar, offset).
        // ============================================================
        // Read cap_ptr u8 @ config 0x34.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x34;
        call pci_config_read_u8;

        and rax, 0xFC;                            // dword-aligned per spec
        mov rbp, rax;                             // rbp = cursor

        // Init visit counter.
        xor rax, rax;
        mov [rsp + 56], rax;

      vn_pb_cap_loop:
        cmp rbp, 0;
        je  vn_pb_cap_done;

        mov rax, [rsp + 56];
        cmp rax, 48;                              // pci/cap.pdx safety bound
        jae vn_pb_cap_done;

        // Read cap_id u8 @ cursor+0.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        call pci_config_read_u8;

        cmp rax, 0x09;                            // VIRTIO_PCI_VENDOR_CAP_ID
        jne vn_pb_cap_advance;

        // Read cfg_type u8 @ cursor+3.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 3;
        call pci_config_read_u8;

        // Only handle types 1..4 (COMMON, NOTIFY, ISR, DEVICE).
        cmp rax, 1;
        jb  vn_pb_cap_advance;
        cmp rax, 4;
        ja  vn_pb_cap_advance;

        // Spill cfg_type for reload after cap+4 / cap+8 reads.
        mov [rsp + 64], rax;

        // Read bar_idx u8 @ cursor+4.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 4;
        call pci_config_read_u8;
        // Spill bar_idx into [rsp+72] — r10 is caller-save, and the
        // pci_config_read_u32 call for offset immediately below can
        // clobber it. rax is likewise not durable across the next call.
        mov [rsp + 72], rax;

        // Read offset u32 @ cursor+8.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 8;
        call pci_config_read_u32;
        // rax = offset (u32; upper bits zero from pci_config_read_u32).

        // Reload record_ptr, cfg_type, and bar_idx (r10).
        mov r15, [rsp + 48];
        mov r11, [rsp + 64];
        mov r10, [rsp + 72];

        // Dispatch on cfg_type.
        cmp r11, 1;
        je  vn_pb_cap_common;
        cmp r11, 2;
        je  vn_pb_cap_notify;
        cmp r11, 3;
        je  vn_pb_cap_isr;
        cmp r11, 4;
        je  vn_pb_cap_device;
        jmp vn_pb_cap_advance;

      vn_pb_cap_common:
        mov_w [r15 + 24], rax;                    // common_cfg_off
        mov_b [r15 + 32], r10;                    // common_cfg_bar
        jmp vn_pb_cap_advance;

      vn_pb_cap_notify:
        mov_w [r15 + 26], rax;                    // notify_off
        mov_b [r15 + 33], r10;                    // notify_bar

        // Read notify_off_multiplier u32 @ cursor+16.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 16;
        call pci_config_read_u32;

        mov r15, [rsp + 48];                      // reload record_ptr
        mov_d [r15 + 36], rax;                    // notify_off_multiplier u32 @+36
        jmp vn_pb_cap_advance;

      vn_pb_cap_isr:
        mov_w [r15 + 28], rax;                    // isr_off
        mov_b [r15 + 34], r10;                    // isr_bar
        jmp vn_pb_cap_advance;

      vn_pb_cap_device:
        mov_w [r15 + 30], rax;                    // device_cfg_off
        mov_b [r15 + 35], r10;                    // device_cfg_bar

      vn_pb_cap_advance:
        // Read next_ptr u8 @ cursor+1.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 1;
        call pci_config_read_u8;

        and rax, 0xFC;                            // dword-aligned per spec
        mov rbp, rax;

        // Increment visit counter.
        mov rax, [rsp + 56];
        add rax, 1;
        mov [rsp + 56], rax;

        jmp vn_pb_cap_loop;

      vn_pb_cap_done:
        // pci_find_cap(seg, bus, dev, fn, MSI-X=0x11) -> cap_msix_off.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x11;
        call pci_find_cap;

        mov r15, [rsp + 48];                      // reload record_ptr
        mov_w [r15 + 40], rax;                    // cap_msix_off u16 @+40

        // j += 1
        add r13, 1;

      vn_pb_next:
        add rbx, 1;
        jmp vn_pb_loop;

      vn_pb_done:
        // Publish device count.
        mov [rip + _virtio_net_device_count], r13;

        // R91.M3-002 (paideia-os #2019 debugger-fix): populate
        // _virtio_net_common_cfg_pa for slot 0 (the single-active-NIC
        // MVP), so virtio_net_init_handshake in common_cfg.pdx can
        // clear its NO_BAR gate. Without this write the handshake is
        // permanent dead code. Compute PA = (bar_idx==4 ? bar4_pa :
        // bar0_pa) + common_cfg_off. If device_count==0 or the record's
        // common_cfg_bar is neither 0 nor 4, leave the slot at 0 (the
        // handshake will then correctly report NO_BAR).
        cmp r13, 0;
        je  vn_pb_ccpa_done;
        lea r15, [rip + _virtio_net_devices];   // r15 = &record[0]
        xor rax, rax;
        mov_b rax, [r15 + 32];                  // common_cfg_bar (u8)
        cmp rax, 4;
        je  vn_pb_ccpa_bar4;
        cmp rax, 0;
        je  vn_pb_ccpa_bar0;
        jmp vn_pb_ccpa_done;                    // unsupported bar_idx
      vn_pb_ccpa_bar4:
        mov r10, [r15 + 16];                    // bar4_pa (u64)
        jmp vn_pb_ccpa_add;
      vn_pb_ccpa_bar0:
        mov r10, [r15 + 8];                     // bar0_pa (u64)
      vn_pb_ccpa_add:
        xor rax, rax;
        mov_w rax, [r15 + 24];                  // common_cfg_off (u16)
        add r10, rax;
        mov [rip + _virtio_net_common_cfg_pa], r10;
      vn_pb_ccpa_done:

        // Fingerprint: klog_s1_d1(LEVEL_INFO=3, SUBSYS_NET_,
        //   tag_virtio_probe_ok, k_count, count). Emitted unconditionally
        //   so the no-virtio-device path (count=0) is grep-assertable in
        //   the boot log — same posture as e1000e_probe_ok (probe.pdx L502).
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + tag_virtio_probe_ok];
        lea rcx, [rip + k_count];
        mov r8, r13;                              // v1 = count
        call klog_s1_d1;

        mov rax, r13;                             // return count

        add rsp, 88;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
