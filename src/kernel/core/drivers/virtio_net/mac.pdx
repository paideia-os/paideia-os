// src/kernel/core/drivers/virtio_net/mac.pdx -- R91.M3-006 (paideia-os #2024)
//
// virtio-net MAC read from the DEVICE cfg region (virtio 1.0 §5.1.4)
// with a locally-administered address (LAA) fallback, plus link-status
// query.  Both entries operate on the first-active virtio-net device
// (single-active-NIC MVP scope, design/networking/r91-plan.md §4.1).
//
// =============================================================================
// SECTION 0  COUPLING WITH R91.M3-001 (probe.pdx) AND -002 (common_cfg.pdx)
// =============================================================================
//
// probe.pdx (R91.M3-001, paideia-os #2019) discovers the four modern
// virtio-pci cfg structures via a vendor-cap walk and records the
// (bar_idx, offset) tuple for the DEVICE cfg at record+35 (u8, `device_
// cfg_bar`) and record+30 (u16, `device_cfg_off`).  common_cfg.pdx
// (R91.M3-002, paideia-os #2020) is the SOLE writer of `_virtio_net_
// common_cfg_pa`; a non-zero value there means probe ran AND the
// COMMON cfg region was locatable in BAR0/4 -- a robust proxy for
// "the handshake could have run".  This module uses that same gate:
// if `_virtio_net_common_cfg_pa == 0` we synthesise an LAA rather
// than reading from a possibly-unmapped BAR.
//
// The handshake in common_cfg.pdx already ACKs both VIRTIO_NET_F_MAC
// (bit 5) and VIRTIO_NET_F_STATUS (bit 16) via VNET_F_ACK_LO_MASK
// (0x00010020) -- so whenever the handshake returned OK, the DEVICE
// cfg's `mac` (bytes 0..5) and `status` (u16 @ 6) fields are
// guaranteed present by virtio 1.0 §5.1.4.  This module does not
// re-check the ACK'd feature mask; the presence proxy is sufficient
// at the R91.M3 MVP scope.
//
// =============================================================================
// SECTION 1  virtio_net_config LAYOUT (virtio 1.0 §5.1.4, DEVICE region)
// =============================================================================
//
//   +0  u8[6]  mac                    (present iff F_MAC negotiated)
//   +6  u16    status                 (present iff F_STATUS negotiated)
//                                        bit 0 = VIRTIO_NET_S_LINK_UP
//                                        bit 1 = VIRTIO_NET_S_ANNOUNCE
//   +8  u16    max_virtqueue_pairs    (present iff F_MQ)
//   +10 u16    mtu                    (present iff F_MTU)
//
// Only mac and status are consumed here; the other two fields are not
// negotiated at R91.M3 (VNET_F_ACK_LO_MASK deliberately does not ACK
// F_MQ or F_MTU).
//
// =============================================================================
// SECTION 2  RECORD FIELD OFFSETS CONSUMED (probe.pdx §"record layout")
// =============================================================================
//
//   +0    u16   seg                    // LAA-mix input
//   +2    u8    bus                    // LAA-mix input
//   +3    u8    dev                    // LAA-mix input
//   +4    u8    fn                     // LAA-mix input
//   +6    u16   device_id              // LAA-mix input
//   +8    u64   bar0_pa                // fallback for legacy device_cfg_bar==0
//   +16   u64   bar4_pa                // primary for modern device_cfg_bar==4
//   +30   u16   device_cfg_off         // DEVICE cfg region offset in BAR
//   +35   u8    device_cfg_bar         // BAR index (0 or 4 supported)
//   +42   u64   mac                    // WRITTEN by this issue (low 48 bits)
//
// The write at +56 stores the packed u64 (little-endian, MAC[0] in
// low byte, MAC[5] at bit 40).  Consumers (nic_dispatch, L2 send
// paths) unpack via bare byte loads from that offset.  Overlaps
// prior _pad0/_pad1/half-of-_pad2 slots that no reader touches at
// this milestone.
//
// =============================================================================
// SECTION 3  MMIO ORDERING + ENCODER DISCIPLINE
// =============================================================================
//
// The DEVICE cfg region is UC MMIO; every byte / word load runs
// inside an mfence envelope (SDM Vol 3A §11.3.1) matching the
// vn_cc_read_u8 / _u16 shape in common_cfg.pdx.  Sized loads use
// `xor rax, rax; mov_b/w rax, [reg + off]` -- paideia-as has no
// mov_bzx / mov_wzx and the encoder's dst-load pattern here is
// exactly xhci_cap_u8 (drivers/xhci/regs.pdx §xhci_cap_u8).  Full-
// width GP register stores to BSS (the mac slot at record+56) go
// through bare `mov [reg + disp], reg64` -- 64-bit store form,
// paideia-as encodes disp8 correctly regardless of natural alignment.
//
// Encoder-conservative shapes only: no `add reg, [mem]`; every
// two-operand op with a memory side goes reg-only after loading
// through rax.  Immediate widths on `and` are chosen so sign-
// extension of imm32 does not corrupt the intended mask -- the LAA
// mix uses bit-shifts that produce a ceiling of bit 39 in the
// scratch, so no explicit mask is needed there.
//
// Every label prefixed `vn_mac_` (read_mac body) / `vn_lnk_` (link_
// status body) per paideia-as reserved-label discipline (`loop`,
// `if`, `next`, ... are keywords).

module Mac = structure {

  // ============================================================================
  // DEVICE cfg field offsets (§1 above).  Byte offsets from the DEVICE
  // cfg region base = (bar_pa) + device_cfg_off.
  // ============================================================================

  pub let VNET_DEV_OFF_MAC       : u64 = 0
  pub let VNET_DEV_OFF_STATUS    : u64 = 6

  pub let VNET_S_LINK_UP         : u64 = 1     // bit 0 of status u16

  // ============================================================================
  // Fingerprint tags.  ONE-line PDX_STR form (verify-fingerprint-coverage.sh
  // §PDX_STR L803-805).  Both carry an "OK" token in the bracketed legacy
  // suffix and are allowlisted alongside the sibling virtio-net probe /
  // handshake tags in tools/verify-fingerprint-coverage.sh.
  //
  //   "virtio-net mac ok [legacy: VIRTIO NET MAC OK]"
  //     len = 45 chars + NUL = 46
  //   "virtio-net link ok [legacy: VIRTIO NET LINK OK]"
  //     len = 47 chars + NUL = 48
  // ============================================================================

  pub let virtio_net_mac_ok_msg  : [u8; 46] = "virtio-net mac ok [legacy: VIRTIO NET MAC OK]\0"
  pub let virtio_net_link_ok_msg : [u8; 48] = "virtio-net link ok [legacy: VIRTIO NET LINK OK]\0"

  // ============================================================================
  // virtio_net_read_mac_body() -> u64
  //
  // Read the 6-byte MAC from the DEVICE cfg region of _virtio_net_devices[0]
  // when the region is reachable (proxy: _virtio_net_common_cfg_pa != 0
  // AND device_cfg_bar in {0, 4} AND the corresponding BAR is non-zero).
  // Otherwise synthesise a locally-administered address (LAA) with bit 1
  // of the first octet set and bit 0 clear (unicast LAA, IEEE 802.3
  // §3.2.3), with the lower 40 bits derived from (seg, bus, dev, fn,
  // device_id) via a simple shift-and-XOR mix.
  //
  // Either way, the resulting u64 is stored at _virtio_net_devices[0]+56
  // and returned in rax.  The fingerprint is emitted on BOTH paths so a
  // boot line always attests the value written to the record slot.
  //
  // Register plan (4-push callee-save + sub rsp,8):
  //   r12 = packed MAC accumulator (survives klog_s1_d1 -> return via rax)
  //   r13 = DEVICE_pa (destroyed once six bytes read)
  //   r14 = LAA-mix accumulator (synth path only)
  //   r15 = &_virtio_net_devices[0]
  //
  //   4 pushes = 32 B; entry rsp%16==8 -> 40, %16==8.  sub rsp,8 -> 48,
  //   %16==0 (aligned for every nested klog_s1_d1 call).
  //
  // Labels prefixed `vn_mac_`.
  // ============================================================================

  pub let virtio_net_read_mac_body : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R91.M3-006 (paideia-os #2024). Read 6-byte MAC from virtio-net DEVICE cfg region for slot 0, IFF the DEVICE region is reachable; else synthesise LAA (bit 1 of octet 0 set, bit 0 clear) with 40-bit residue mixed from (seg, bus, dev, fn, device_id) at record+0/+2/+3/+4/+6. Gate: _virtio_net_common_cfg_pa != 0 proxies 'handshake could have run' (VNET_F_ACK_LO_MASK 0x00010020 = F_MAC(5)|F_STATUS(16) is unconditionally ACK'd by common_cfg.pdx's handshake, so a handshake-OK boot guarantees mac/status are present per virtio 1.0 §5.1.4). Body: (1) 4-push (r12=MAC accumulator surviving klog; r13=DEVICE_pa; r14=LAA-mix; r15=&record[0]) + sub rsp,8 -> 48 B; entry rsp%16==8 -> 48, %16==0 (aligned for nested klog_s1_d1). (2) Load _virtio_net_common_cfg_pa; if 0 -> vn_mac_synth. (3) Compute DEVICE_pa = (device_cfg_bar==4 ? bar4_pa : device_cfg_bar==0 ? bar0_pa : synth) + device_cfg_off. If chosen BAR is 0 -> synth. (4) Read six bytes via mfence-enveloped `xor rax,rax; mov_b rax, [r13+N]; mfence` (paideia-as has no mov_bzx; xhci_cap_u8 pattern), shifted by (N*8) and OR'd into r12. (5) jmp vn_mac_store. (6) LAA synth: r12 = 0x02 (LAA bit + unicast bit clear). r14 accumulates 40-bit mix: seg (u16 @+0) XOR into r14; bus (u8 @+2) shl 16 XOR; dev (u8 @+3) shl 24 XOR; fn (u8 @+4) shl 32 XOR; device_id (u16 @+6) XOR into low. Ceiling bit is 39 (fn @ shl 32 spans bits 32..39), so no explicit mask needed. shl r14, 8 to occupy octets 1..5 (bits 8..47); or into r12. (7) Store: `mov [r15+42], r12` (64-bit store; disp8=42 is not 8-aligned but paideia-as encodes disp8 regardless and x86-64 tolerates unaligned WB writes). (8) Emit fingerprint: klog_s1_d1(3, SUBSYS_NET_, virtio_net_mac_ok_msg, k_mac, r12). r12 is callee-save and survives the call. (9) mov rax, r12; teardown. Reserved-label discipline: labels prefixed vn_mac_. Every nested callee (klog_s1_d1) preserves r12/r13/r14/r15 per SysV.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 8;

        // ------------------------------------------------------------
        // (2) Gate: _virtio_net_common_cfg_pa != 0 proxies "handshake
        //     could have run".  Zero -> synth LAA.
        // ------------------------------------------------------------
        mov  rax, [rip + _virtio_net_common_cfg_pa];
        cmp  rax, 0;
        je   vn_mac_synth;

        // ------------------------------------------------------------
        // (3) Compute DEVICE_pa = (bar==4 ? bar4_pa : bar==0 ? bar0_pa
        //     : synth) + device_cfg_off.
        // ------------------------------------------------------------
        lea  r15, [rip + _virtio_net_devices];
        xor  rax, rax;
        mov_b rax, [r15 + 35];                  // device_cfg_bar (u8)
        cmp  rax, 4;
        je   vn_mac_bar4;
        cmp  rax, 0;
        je   vn_mac_bar0;
        jmp  vn_mac_synth;                       // unsupported bar_idx

      vn_mac_bar4:
        mov  r13, [r15 + 16];                    // bar4_pa (u64)
        jmp  vn_mac_off;

      vn_mac_bar0:
        mov  r13, [r15 + 8];                     // bar0_pa (u64)

      vn_mac_off:
        cmp  r13, 0;
        je   vn_mac_synth;                       // BAR unmapped
        xor  rax, rax;
        mov_w rax, [r15 + 30];                   // device_cfg_off (u16)
        add  r13, rax;                           // r13 = DEVICE_pa

        // ------------------------------------------------------------
        // (4) Read the six MAC bytes little-endian.  Each read: mfence
        //     -> xor rax,rax; mov_b rax, [r13+N] -> mfence; shift; or.
        // ------------------------------------------------------------
        xor  r12, r12;

        // MAC[0]
        mfence;
        xor  rax, rax;
        mov_b rax, [r13 + 0];
        mfence;
        or   r12, rax;

        // MAC[1] << 8
        mfence;
        xor  rax, rax;
        mov_b rax, [r13 + 1];
        mfence;
        shl  rax, 8;
        or   r12, rax;

        // MAC[2] << 16
        mfence;
        xor  rax, rax;
        mov_b rax, [r13 + 2];
        mfence;
        shl  rax, 16;
        or   r12, rax;

        // MAC[3] << 24
        mfence;
        xor  rax, rax;
        mov_b rax, [r13 + 3];
        mfence;
        shl  rax, 24;
        or   r12, rax;

        // MAC[4] << 32
        mfence;
        xor  rax, rax;
        mov_b rax, [r13 + 4];
        mfence;
        shl  rax, 32;
        or   r12, rax;

        // MAC[5] << 40
        mfence;
        xor  rax, rax;
        mov_b rax, [r13 + 5];
        mfence;
        shl  rax, 40;
        or   r12, rax;

        jmp  vn_mac_store;

      vn_mac_synth:
        // ------------------------------------------------------------
        // (6) Synthesise LAA.  Octet 0 = 0x02 (LAA bit set, multicast
        //     bit clear -> locally-administered unicast).  Octets
        //     1..5 = 40-bit residue from (seg, bus, dev, fn, device_id).
        // ------------------------------------------------------------
        lea  r15, [rip + _virtio_net_devices];
        xor  r12, r12;
        or   r12, 0x02;                          // LAA + unicast in octet 0

        xor  r14, r14;

        // seg (u16 @+0) -> bits 0..15 of the residue
        xor  rax, rax;
        mov_w rax, [r15 + 0];
        xor  r14, rax;

        // bus (u8 @+2) -> bits 16..23
        xor  rax, rax;
        mov_b rax, [r15 + 2];
        shl  rax, 16;
        xor  r14, rax;

        // dev (u8 @+3) -> bits 24..31
        xor  rax, rax;
        mov_b rax, [r15 + 3];
        shl  rax, 24;
        xor  r14, rax;

        // fn (u8 @+4) -> bits 32..39 (ceiling; below the u48 MAC cap
        // after the shl 8 below)
        xor  rax, rax;
        mov_b rax, [r15 + 4];
        shl  rax, 32;
        xor  r14, rax;

        // device_id (u16 @+6) -> XOR into low bits for extra entropy
        xor  rax, rax;
        mov_w rax, [r15 + 6];
        xor  r14, rax;

        // Shift residue into octets 1..5 (bits 8..47).  Ceiling bit 39
        // + 8 = 47, still within the u48 MAC domain.
        shl  r14, 8;
        or   r12, r14;

      vn_mac_store:
        // ------------------------------------------------------------
        // (7) Store the packed u64 at _virtio_net_devices[0]+56.
        //     64-bit store to unaligned WB memory; x86-64 tolerates.
        // ------------------------------------------------------------
        lea  r15, [rip + _virtio_net_devices];
        mov  [r15 + 56], r12;

        // ------------------------------------------------------------
        // (8) Emit fingerprint.
        // ------------------------------------------------------------
        mov  rdi, 3;                             // LEVEL_INFO
        lea  rsi, [rip + SUBSYS_NET_];
        lea  rdx, [rip + virtio_net_mac_ok_msg];
        lea  rcx, [rip + k_mac];
        mov  r8, r12;
        call klog_s1_d1;

        // ------------------------------------------------------------
        // (9) Return.
        // ------------------------------------------------------------
        mov  rax, r12;

        add  rsp, 8;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        ret
      }
    }

  // ============================================================================
  // virtio_net_link_status() -> u64
  //
  // Return 1 if the DEVICE cfg's status u16 bit 0 (VIRTIO_NET_S_LINK_UP)
  // is set, 0 otherwise.  If the DEVICE region is not reachable
  // (_virtio_net_common_cfg_pa == 0, or device_cfg_bar not in {0,4},
  // or BAR unmapped), return 1 (safe default matching typical QEMU
  // virtio-net behaviour: link is up by default when the device
  // model is present but the driver simply cannot ask).
  //
  // The status u16 field is present in the DEVICE region iff VIRTIO_
  // NET_F_STATUS (bit 16) was negotiated during handshake; common_cfg.
  // pdx's VNET_F_ACK_LO_MASK ACKs that bit unconditionally, so a
  // reachable DEVICE region implies the field is meaningful.
  //
  // Fingerprint emitted on all paths so the value returned is always
  // grep-assertable at boot.
  //
  // Register plan (2-push callee-save + sub rsp,8):
  //   rbx = &_virtio_net_devices[0] (base scratch, doubles as MMIO pa)
  //   r12 = link-up result (0 or 1); survives klog_s1_d1 -> return
  //
  //   2 pushes = 16 B; entry rsp%16==8 -> 24, %16==8.  sub rsp,8 -> 32,
  //   %16==0 (aligned for nested klog_s1_d1 call).
  //
  // Labels prefixed `vn_lnk_`.
  // ============================================================================

  pub let virtio_net_link_status : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R91.M3-006 (paideia-os #2024). Read DEVICE cfg status u16 @+6 for slot 0 (virtio 1.0 §5.1.4); return bit 0 (VIRTIO_NET_S_LINK_UP). If DEVICE region unreachable (_virtio_net_common_cfg_pa == 0, or device_cfg_bar not in {0,4}, or BAR unmapped), return 1 (safe default matching typical QEMU behaviour). Body: (1) 2-push (rbx=&record[0]/DEVICE_pa scratch, r12=link result surviving klog) + sub rsp,8 -> 32 B; entry rsp%16==8 -> 32, %16==0 (aligned for nested klog_s1_d1). (2) Gate: _virtio_net_common_cfg_pa != 0. Zero -> jump to vn_lnk_up_default. (3) Compute DEVICE_pa: rbx = &record[0]; read device_cfg_bar u8 @+35; if not in {0,4} -> up_default; else load bar4_pa (@+16) or bar0_pa (@+8) into r12; if 0 -> up_default; else add device_cfg_off (u16 @+30) -> r12 = DEVICE_pa. (4) Read status u16 @ DEVICE+6 via mfence-enveloped `xor rax,rax; mov_w rax, [r12+6]; mfence`. and rax, 1 -> isolate LINK_UP bit; result 0 or 1 in rax. jmp vn_lnk_emit. (5) up_default: mov rax, 1. (6) Emit: preserve result in r12 (callee-save survives klog); klog_s1_d1(3, SUBSYS_NET_, virtio_net_link_ok_msg, k_link_up, r12). (7) mov rax, r12; teardown. Reserved-label discipline: labels prefixed vn_lnk_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        // ------------------------------------------------------------
        // (2) Gate: _virtio_net_common_cfg_pa != 0 proxy.
        // ------------------------------------------------------------
        mov  rax, [rip + _virtio_net_common_cfg_pa];
        cmp  rax, 0;
        je   vn_lnk_up_default;

        // ------------------------------------------------------------
        // (3) Compute DEVICE_pa.
        // ------------------------------------------------------------
        lea  rbx, [rip + _virtio_net_devices];
        xor  rax, rax;
        mov_b rax, [rbx + 35];                   // device_cfg_bar (u8)
        cmp  rax, 4;
        je   vn_lnk_bar4;
        cmp  rax, 0;
        je   vn_lnk_bar0;
        jmp  vn_lnk_up_default;                  // unsupported bar_idx

      vn_lnk_bar4:
        mov  r12, [rbx + 16];                    // bar4_pa
        jmp  vn_lnk_off;

      vn_lnk_bar0:
        mov  r12, [rbx + 8];                     // bar0_pa

      vn_lnk_off:
        cmp  r12, 0;
        je   vn_lnk_up_default;                  // BAR unmapped
        xor  rax, rax;
        mov_w rax, [rbx + 30];                   // device_cfg_off (u16)
        add  r12, rax;                           // r12 = DEVICE_pa

        // ------------------------------------------------------------
        // (4) Read status u16 @ DEVICE+6 and isolate LINK_UP (bit 0).
        // ------------------------------------------------------------
        mfence;
        xor  rax, rax;
        mov_w rax, [r12 + 6];
        mfence;
        and  rax, 1;                             // VNET_S_LINK_UP
        jmp  vn_lnk_emit;

      vn_lnk_up_default:
        mov  rax, 1;                             // safe default = up

      vn_lnk_emit:
        // ------------------------------------------------------------
        // (6) Preserve result across klog and emit fingerprint.
        // ------------------------------------------------------------
        mov  r12, rax;

        mov  rdi, 3;                             // LEVEL_INFO
        lea  rsi, [rip + SUBSYS_NET_];
        lea  rdx, [rip + virtio_net_link_ok_msg];
        lea  rcx, [rip + k_link_up];
        mov  r8, r12;
        call klog_s1_d1;

        // ------------------------------------------------------------
        // (7) Return.
        // ------------------------------------------------------------
        mov  rax, r12;

        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
