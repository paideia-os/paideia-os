// src/kernel/core/drivers/virtio_net/common_cfg.pdx -- R91.M3-002 (paideia-os #2020)
//
// Modern virtio 1.0 (v1.1) common configuration structure accessors +
// device init handshake (RESET -> ACK -> DRIVER -> FEATURES -> FEATURES_OK
// -> DRIVER_OK) for the from-scratch virtio-net driver landed by R91.M3.
//
// Spec references:
//   * virtio 1.1 §4.1.4.3 -- Common configuration structure layout
//     (all bytes are little-endian; MMIO transactions are naturally
//     aligned to the field width, i.e. u8 at aligned byte offsets,
//     u16 at 2-byte offsets, u32 at 4-byte offsets, u64 at 8-byte
//     offsets).
//   * virtio 1.1 §3.1.1 -- Driver initialization sequence.
//   * virtio 1.1 §5.1.3 -- virtio-net feature bits (VIRTIO_NET_F_MAC=5,
//     VIRTIO_NET_F_STATUS=16).
//   * virtio 1.1 §6      -- VIRTIO_F_VERSION_1 (bit 32) is mandatory
//     for a modern (non-transitional) driver; the device MUST offer it
//     for the driver to accept the negotiation.
//
// =============================================================================
// SECTION 0  COUPLING WITH R91.M3-001 (paideia-os #2019, virtio-net probe)
// =============================================================================
//
// R91.M3-001 (probe.pdx, not yet landed at the time of this file) walks
// the modern virtio PCI capability list (VIRTIO_PCI_CAP_COMMON_CFG,
// cfg_type = 1) and resolves the (BAR, offset) that names the common
// configuration MMIO region for the first-found virtio-net device. The
// single-active-NIC MVP scope (design/networking/r91-plan.md §4.1) pins
// this to _virtio_net_devices[0]; probe writes the flattened physical
// address of that region into `_virtio_net_common_cfg_pa` below.
//
// This file is the SOLE READER of `_virtio_net_common_cfg_pa`; probe is
// the SOLE WRITER. If probe has not yet landed (or a boot supplies no
// virtio-net device), the .bss slot stays 0 and `virtio_net_init_handshake`
// short-circuits with `VNET_CC_ERR_NO_BAR`. The dedicated .bss slot lives
// in this file rather than probe.pdx so that this module remains buildable
// and inspectable ahead of #2019's landing -- probe.pdx (once it lands)
// merely writes into the symbol declared here, exactly the shape
// nic_dispatch.pdx's `_active_nic_kind` slot takes for its own writer/
// reader split.
//
// =============================================================================
// SECTION 1  COMMON CONFIG LAYOUT (virtio 1.1 §4.1.4.3, offsets from region base)
// =============================================================================
//
//   +0x00  u32  device_feature_select   (RW)
//   +0x04  u32  device_feature          (RO)
//   +0x08  u32  driver_feature_select   (RW)
//   +0x0C  u32  driver_feature          (RW)
//   +0x10  u16  msix_config             (RW)
//   +0x12  u16  num_queues              (RO)
//   +0x14  u8   device_status           (RW; §2.1 -- writes are additive
//                                        for non-zero values; writing 0
//                                        resets the device)
//   +0x15  u8   config_generation       (RO)
//   +0x16  u16  queue_select            (RW)
//   +0x18  u16  queue_size              (RW)
//   +0x1A  u16  queue_msix_vector       (RW)
//   +0x1C  u16  queue_enable            (RW)
//   +0x1E  u16  queue_notify_off        (RO)
//   +0x20  u64  queue_desc              (RW)
//   +0x28  u64  queue_driver            (RW)
//   +0x30  u64  queue_device            (RW)
//
// The u16/u32 queue_* fields (queue_select through queue_notify_off) and
// the u64 queue_{desc,driver,device} triple are declared here for later
// R91.M3-003 (virtqueue) consumption; this file only exercises the
// header (device_feature_select/_feature, driver_feature_select/_feature,
// device_status). The offsets are the useful published surface either
// way.
//
// =============================================================================
// SECTION 2  FEATURE BITS NEGOTIATED (R91.M3 v1 minimal set)
// =============================================================================
//
// Feature bits are 64 wide; the common config exposes them as a 2-word
// register: driver writes feature_select (0 = low 32 bits, 1 = high 32
// bits) then reads (device_feature) / writes (driver_feature) that
// half. The driver ACKs exactly what it understands; anything the
// device offers but the driver has not ACKed is dropped.
//
//   Bit  5  VIRTIO_NET_F_MAC     -- device provides a valid MAC in
//                                   device_cfg. Without this, the driver
//                                   must synthesize a locally-administered
//                                   MAC (R91.M3-006 mac.pdx handles
//                                   both arms).
//   Bit 16  VIRTIO_NET_F_STATUS  -- device reports link status in
//                                   device_cfg's u16 `status` field.
//   Bit 32  VIRTIO_F_VERSION_1   -- modern (non-transitional). MANDATORY:
//                                   virtio 1.1 §6 requires a modern
//                                   driver to fail negotiation if the
//                                   device does not offer this bit.
//
// Any other bit the device offers (VIRTIO_NET_F_CTRL_VQ, _MRG_RXBUF,
// _CSUM, _GSO family, _MQ, ...) is deliberately dropped at this
// milestone. Later R91.M3 milestones (virtqueue, tx/rx, mac) may
// negotiate additional bits; each such addition lands as a new bit in
// VNET_F_ACK_LO_MASK / VNET_F_ACK_HI_MASK here plus a corresponding
// consumer in the module that needs it.
//
// =============================================================================
// SECTION 3  INIT HANDSHAKE (virtio 1.1 §3.1.1)
// =============================================================================
//
//   (1) RESET       -- write 0 to device_status; poll for read-back of 0.
//   (2) ACK         -- OR ACKNOWLEDGE (bit 0, value 1) into device_status.
//   (3) DRIVER      -- OR DRIVER (bit 1, value 2) into device_status.
//   (4) FEATURES    -- for each half (select=0 then select=1):
//                        read device_feature; ACK the offered subset that
//                        matches VNET_F_ACK_{LO,HI}_MASK; write it back
//                        to driver_feature.
//                      Verify the device offers VIRTIO_F_VERSION_1 in the
//                      hi half (bit 0 of select=1); if not, mark FAILED
//                      and return VNET_CC_ERR_NO_VERSION_1.
//   (5) FEATURES_OK -- OR FEATURES_OK (bit 3, value 8) into device_status;
//                      re-read; if FEATURES_OK did not stick the device
//                      rejected our subset -- mark FAILED and return
//                      VNET_CC_ERR_FEATURES_OK.
//   (6) DRIVER_OK   -- OR DRIVER_OK (bit 2, value 4) into device_status.
//
// PRODUCTION-CAVEAT: virtio 1.1 §3.1.1 step 7 (perform device-specific
// setup: virtqueue configuration, MAC read, MSI-X arming) belongs
// BETWEEN FEATURES_OK and DRIVER_OK. R91.M3-003 (virtqueue) and R91.M3-005
// (rx/isr) land those bodies; a future integration edit here will
// EITHER split this handshake into two entry points (init_handshake_pre_setup
// / init_handshake_post_setup) OR let the caller sequence them
// explicitly. The R91.M3-002 issue directive spells out the DRIVER_OK
// tail as part of THIS body, so we ship it that way and note the caveat.
// No device I/O is issued between FEATURES_OK and DRIVER_OK today, so
// the ordering violation is harmless at this milestone.
//
// =============================================================================
// SECTION 4  MMIO ORDERING + ENCODER DISCIPLINE
// =============================================================================
//
// The common config lives in a UC MMIO region. Every read and write in
// this module goes through the {mfence, address compute, sized load or
// store, mfence} envelope (the same shape e1000e_reg_u32 and xhci_op_u32
// take) so a WB store that immediately precedes an MMIO transaction on
// the same CPU cannot outrun it per SDM Vol 3A §11.3.1.
//
// Sized stores go through `mov_b` / `mov_w` / `mov_d`; the bare `mov
// [addr], reg` widens to REX.W and would write 8 bytes into a 1/2/4 byte
// slot -- the same G1 encoder gap that e1000e_reg_write_u32 and
// xhci_op_write_u32 stage around. Byte and word loads use the
// `xor rax,rax; mov_b/w rax, [addr]` dst-load form (xhci_cap_u8 pattern
// at drivers/xhci/regs.pdx §xhci_cap_u8).
//
// All negotiated masks fit trivially in a 32-bit immediate. Error
// return sentinels are full 64-bit constants (sign-extension of small
// negatives) and stage through `mov rax, imm64` -- paideia-as's
// canonical form for a full-width immediate (see nic_dispatch.pdx
// NIC_ENOSYS handling at drivers/net/nic_dispatch.pdx §nic_dispatch_tx).
//
// Every label in this file is prefixed `vn_cc_` per reserved-word
// discipline (paideia-as treats `loop`, `if`, `next` as keywords).

module CommonCfg = structure {

  // ==========================================================================
  // Common config field offsets (§1 above). All are byte offsets from
  // `_virtio_net_common_cfg_pa`.
  // ==========================================================================

  pub let VNET_CC_OFF_DEV_FEAT_SEL : u64 = 0x00
  pub let VNET_CC_OFF_DEV_FEAT     : u64 = 0x04
  pub let VNET_CC_OFF_DRV_FEAT_SEL : u64 = 0x08
  pub let VNET_CC_OFF_DRV_FEAT     : u64 = 0x0C
  pub let VNET_CC_OFF_MSIX_CONFIG  : u64 = 0x10
  pub let VNET_CC_OFF_NUM_QUEUES   : u64 = 0x12
  pub let VNET_CC_OFF_DEV_STATUS   : u64 = 0x14
  pub let VNET_CC_OFF_CFG_GEN      : u64 = 0x15
  pub let VNET_CC_OFF_QUEUE_SEL    : u64 = 0x16
  pub let VNET_CC_OFF_QUEUE_SIZE   : u64 = 0x18
  pub let VNET_CC_OFF_QUEUE_MSIX   : u64 = 0x1A
  pub let VNET_CC_OFF_QUEUE_EN     : u64 = 0x1C
  pub let VNET_CC_OFF_QUEUE_NOTIFY : u64 = 0x1E
  pub let VNET_CC_OFF_QUEUE_DESC   : u64 = 0x20
  pub let VNET_CC_OFF_QUEUE_DRV    : u64 = 0x28
  pub let VNET_CC_OFF_QUEUE_DEV    : u64 = 0x30

  // ==========================================================================
  // device_status bit values (virtio 1.1 §2.1).
  // ==========================================================================

  pub let VNET_STATUS_RESET        : u64 = 0
  pub let VNET_STATUS_ACK          : u64 = 1
  pub let VNET_STATUS_DRIVER       : u64 = 2
  pub let VNET_STATUS_DRIVER_OK    : u64 = 4
  pub let VNET_STATUS_FEATURES_OK  : u64 = 8
  pub let VNET_STATUS_NEEDS_RESET  : u64 = 64
  pub let VNET_STATUS_FAILED       : u64 = 128

  // ==========================================================================
  // Feature-select halves and negotiated masks (§2 above).
  //
  //   VNET_F_ACK_LO_MASK  =  (1 << 5) | (1 << 16)
  //                       = 0x00000020 | 0x00010000
  //                       = 0x00010020
  //     -- VIRTIO_NET_F_MAC (bit 5) | VIRTIO_NET_F_STATUS (bit 16).
  //
  //   VNET_F_ACK_HI_MASK  = (1 << (32 - 32))
  //                       = 0x00000001
  //     -- VIRTIO_F_VERSION_1 (bit 32, i.e. bit 0 of the hi half).
  //
  //   VNET_F_VERSION_1_HI = 0x00000001 (same mask, kept separately so
  //     the "must be offered" check reads by name).
  // ==========================================================================

  pub let VNET_F_SEL_LO            : u64 = 0
  pub let VNET_F_SEL_HI            : u64 = 1

  pub let VNET_F_ACK_LO_MASK       : u64 = 0x00010020
  pub let VNET_F_ACK_HI_MASK       : u64 = 0x00000001
  pub let VNET_F_VERSION_1_HI      : u64 = 0x00000001

  // ==========================================================================
  // Return codes for virtio_net_init_handshake().
  //
  //   VNET_CC_OK                  =  0
  //   VNET_CC_ERR_NO_BAR          = -19 (-ENODEV, common cfg addr is 0)
  //   VNET_CC_ERR_NO_VERSION_1    = -95 (-ENOTSUP, device is legacy)
  //   VNET_CC_ERR_FEATURES_OK     = -5  (-EIO, device rejected our subset)
  //
  // Encoded as full 64-bit sign-extended immediates (canonical
  // paideia-as form; see nic_dispatch.pdx NIC_ENOSYS at
  // drivers/net/nic_dispatch.pdx L170). Caller compares against 0 for
  // success; any non-zero return is a failure whose value distinguishes
  // the cause. On any error the device_status has been written to
  // include FAILED before return.
  // ==========================================================================

  pub let VNET_CC_OK               : u64 = 0
  pub let VNET_CC_ERR_NO_BAR       : u64 = 0xFFFFFFFFFFFFFFED
  pub let VNET_CC_ERR_NO_VERSION_1 : u64 = 0xFFFFFFFFFFFFFFA1
  pub let VNET_CC_ERR_FEATURES_OK  : u64 = 0xFFFFFFFFFFFFFFFB

  // ==========================================================================
  // _virtio_net_common_cfg_pa: canonical .bss slot for the physical
  // address of the common configuration MMIO region of the first-active
  // virtio-net device. .bss = 0 at boot; R91.M3-001 (paideia-os #2019,
  // probe.pdx) is the SOLE writer, this module the SOLE reader (§0).
  // ==========================================================================

  pub let mut _virtio_net_common_cfg_pa : u64 = 0

  // ==========================================================================
  // Fingerprint tags for the init handshake (ONE-line pdx string literal
  // form per the verify-fingerprint-coverage.sh PDX_STR regex --
  // tools/verify-fingerprint-coverage.sh L759-763). The OK variant will
  // need an allowlist entry against the coverage gate until R91.M5-003
  // lands the virtio-net boot witness that pins the exact line; the FAIL
  // variant has no OK token and needs no allowlist.
  //
  //   "virtio-net init handshake ok [legacy: VIRTIO INIT OK]"
  //     len = 53 chars + NUL = 54
  //   "virtio-net init handshake fail [legacy: VIRTIO INIT FAIL]"
  //     len = 57 chars + NUL = 58
  // ==========================================================================

  pub let virtio_net_init_ok_msg   : [u8; 54] = "virtio-net init handshake ok [legacy: VIRTIO INIT OK]\0"
  pub let virtio_net_init_fail_msg : [u8; 58] = "virtio-net init handshake fail [legacy: VIRTIO INIT FAIL]\0"

  // ==========================================================================
  // vn_cc_read_u8 -- 8-bit MMIO read from common_cfg_pa + offset.
  //
  // SysV: (base: u64, offset: u64) -> u64
  //   rdi = _virtio_net_common_cfg_pa (caller pre-loaded)
  //   rsi = field offset (VNET_CC_OFF_* constant)
  //
  // Returns rax = 8-bit value zero-extended to u64. Leaf, no prologue.
  // ==========================================================================

  pub let vn_cc_read_u8 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). virtio 1.1 common config 8-bit MMIO read. Mirrors xhci_cap_u8 (drivers/xhci/regs.pdx §xhci_cap_u8): mfence -> address compute in r10 (bare `mov rax,[rax]` form conflicts with the dst-load pattern) -> zero-extend via `xor rax,rax; mov_b rax, [r10]` -> mfence. Leaf, no prologue. rdi = common_cfg_pa, rsi = field offset.",
      block: {
        mfence;
        mov r10, rdi;
        add r10, rsi;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        ret
      }
    }

  // ==========================================================================
  // vn_cc_write_u8 -- 8-bit MMIO write to common_cfg_pa + offset.
  //
  // SysV: (base: u64, offset: u64, val: u64) -> ()
  //   rdi = common_cfg_pa, rsi = offset, rdx = value (low 8 bits stored).
  // ==========================================================================

  pub let vn_cc_write_u8 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). virtio 1.1 common config 8-bit MMIO write. Sized store via mov_b (bare `mov [addr], rdx` widens to REX.W and would write 8 bytes into a 1-byte slot -- same G1 encoder-gap that e1000e_reg_write_u32 stages around). Leaf. rdi = common_cfg_pa, rsi = offset, rdx = value.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_b [rax], rdx;
        mfence;
        ret
      }
    }

  // ==========================================================================
  // vn_cc_read_u16 -- 16-bit MMIO read from common_cfg_pa + offset.
  // ==========================================================================

  pub let vn_cc_read_u16 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). virtio 1.1 common config 16-bit MMIO read. Mirrors xhci_cap_u16. Zero-extend via `xor rax,rax; mov_w rax, [r10]`. Leaf.",
      block: {
        mfence;
        mov r10, rdi;
        add r10, rsi;
        xor rax, rax;
        mov_w rax, [r10];
        mfence;
        ret
      }
    }

  // ==========================================================================
  // vn_cc_write_u16 -- 16-bit MMIO write to common_cfg_pa + offset.
  // ==========================================================================

  pub let vn_cc_write_u16 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). virtio 1.1 common config 16-bit MMIO write. Sized store via mov_w. Leaf.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_w [rax], rdx;
        mfence;
        ret
      }
    }

  // ==========================================================================
  // vn_cc_read_u32 -- 32-bit MMIO read from common_cfg_pa + offset.
  // ==========================================================================

  pub let vn_cc_read_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). virtio 1.1 common config 32-bit MMIO read. Mirrors e1000e_reg_u32 (drivers/e1000e/regs.pdx §e1000e_reg_u32): `mov eax, [addr]` zero-extends into the upper 32 bits of rax per SDM Vol 2A §3.4.1.1. Leaf.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    }

  // ==========================================================================
  // vn_cc_write_u32 -- 32-bit MMIO write to common_cfg_pa + offset.
  // ==========================================================================

  pub let vn_cc_write_u32 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). virtio 1.1 common config 32-bit MMIO write. Mirrors e1000e_reg_write_u32. Sized store via mov_d. Leaf.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_d [rax], rdx;
        mfence;
        ret
      }
    }

  // ==========================================================================
  // virtio_net_read_device_status() -> u64
  //
  // Read device_status (u8 at VNET_CC_OFF_DEV_STATUS from the common
  // config region of the first-active virtio-net device). Returns 0 if
  // _virtio_net_common_cfg_pa has not been populated yet (no probe run,
  // or no virtio-net device present) -- distinguishable from a genuine
  // status=0 read (which means "device is reset") only by the caller
  // that owns the probe lifecycle. The init_handshake caller checks
  // _virtio_net_common_cfg_pa first via the NO_BAR gate below and never
  // observes this ambiguity.
  //
  // Leaf-ish: calls vn_cc_read_u8 which is a plain-MMIO leaf. Callee-
  // save preservation is unnecessary because we do not need any state
  // across the single call.
  // ==========================================================================

  pub let virtio_net_read_device_status : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). Load _virtio_net_common_cfg_pa into rdi; if zero return 0 (unpopulated -- probe has not run or no virtio-net device); else call vn_cc_read_u8(base, VNET_CC_OFF_DEV_STATUS) which returns the u8 value zero-extended in rax. Labels prefixed vn_cc_rds_.",
      block: {
        mov rdi, [rip + _virtio_net_common_cfg_pa];
        cmp rdi, 0;
        je  vn_cc_rds_none;
        mov rsi, 0x14;                       // VNET_CC_OFF_DEV_STATUS
        call vn_cc_read_u8;
        ret;
      vn_cc_rds_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // virtio_net_write_device_status(status) -> ()
  //
  // Write `status` (low 8 bits) to device_status. Per virtio 1.1 §2.1
  // writes are additive for non-zero values (the device ORs the written
  // byte into its current status latch), and writing 0 resets the device.
  // The init_handshake caller either sequences ORed values itself
  // (RESET+ACK+DRIVER+... layering) or writes 0 to trigger the reset arm.
  //
  // No-op if _virtio_net_common_cfg_pa is 0. rdi carries the incoming
  // status; we preserve it across the base-load by re-materializing
  // through the caller-save arithmetic form (rdx <- rdi before the
  // base-address load into rdi).
  // ==========================================================================

  pub let virtio_net_write_device_status : (u64) -> () !{sysreg, mem} @{boot} =
    fn (status: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). Save incoming status in rdx (SysV arg 3 slot for the vn_cc_write_u8 call), load _virtio_net_common_cfg_pa into rdi, no-op if zero, else call vn_cc_write_u8(base, VNET_CC_OFF_DEV_STATUS, status). Labels prefixed vn_cc_wds_.",
      block: {
        mov rdx, rdi;                        // status -> arg3 slot
        mov rdi, [rip + _virtio_net_common_cfg_pa];
        cmp rdi, 0;
        je  vn_cc_wds_none;
        mov rsi, 0x14;                       // VNET_CC_OFF_DEV_STATUS
        call vn_cc_write_u8;
      vn_cc_wds_none:
        ret
      }
    }

  // ==========================================================================
  // virtio_net_read_device_features(feature_select) -> u64
  //
  // Program device_feature_select with the caller's half selector (0 =
  // low 32 bits, 1 = high 32 bits) then read the paired device_feature
  // register. Returns the u32 value zero-extended in rax; returns 0 if
  // _virtio_net_common_cfg_pa is unpopulated (no probe run) -- same
  // convention as read_device_status.
  //
  // The two-register (select, then read) protocol is what the virtio 1.1
  // §4.1.4.3 wire actually is; the two MMIO transactions are ordered by
  // the mfence pair each vn_cc_* leaf already emits.
  //
  // Register plan: 1-push callee-save (rbx = feature_select through the
  // select-write, since vn_cc_write_u32 clobbers our arg registers).
  // Entry rsp%16==8 -> push rbx -> %16==0 (aligned for nested vn_cc_*
  // calls without pre-align pad).
  // ==========================================================================

  pub let virtio_net_read_device_features : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (feature_select: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). Preserve feature_select in rbx across the vn_cc_write_u32 (which clobbers arg regs). Body: (1) push rbx; entry rsp%16==8 -> 16, %16==0 (aligned for nested calls). (2) mov rbx, rdi. (3) Load base = _virtio_net_common_cfg_pa; if 0 return 0. (4) vn_cc_write_u32(base, VNET_CC_OFF_DEV_FEAT_SEL, feature_select). (5) vn_cc_read_u32(base, VNET_CC_OFF_DEV_FEAT) -> rax. (6) pop rbx; ret. Labels prefixed vn_cc_rdf_.",
      block: {
        push rbx;
        mov rbx, rdi;                        // feature_select
        mov rdi, [rip + _virtio_net_common_cfg_pa];
        cmp rdi, 0;
        je  vn_cc_rdf_none;
        // (4) write device_feature_select
        mov rsi, 0x00;                       // VNET_CC_OFF_DEV_FEAT_SEL
        mov rdx, rbx;
        call vn_cc_write_u32;
        // (5) read device_feature
        mov rdi, [rip + _virtio_net_common_cfg_pa];
        mov rsi, 0x04;                       // VNET_CC_OFF_DEV_FEAT
        call vn_cc_read_u32;
        pop rbx;
        ret;
      vn_cc_rdf_none:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // virtio_net_write_driver_features(feature_select, feature_lo) -> ()
  //
  // Program driver_feature_select with the caller's half selector then
  // write the ACKed subset to driver_feature. This is the driver's side
  // of the two-word negotiation register -- the device latches the
  // written u32 as the ACK for whichever half feature_select names.
  //
  // No-op if _virtio_net_common_cfg_pa is 0.
  //
  // Register plan: 2-push callee-save (rbx = feature_select, r12 =
  // feature_lo) so both survive across nested vn_cc_write_u32 calls.
  // Entry rsp%16==8 -> push rbx + push r12 -> %16==0 (aligned).
  // ==========================================================================

  pub let virtio_net_write_driver_features : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (feature_select: u64, feature_lo: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). Preserve feature_select in rbx and feature_lo in r12 across the two nested vn_cc_write_u32 calls. Body: (1) push rbx; push r12; entry rsp%16==8 -> 24, %16==8 -- unaligned; canonical fix is to align via an extra push of a scratch (or a sub rsp,8). Chosen form: push rbx; push r12; sub rsp, 8 -> 32, %16==0 (aligned). (2) mov rbx, rdi; mov r12, rsi. (3) Load base into rdi; if 0 -> teardown + ret. (4) vn_cc_write_u32(base, VNET_CC_OFF_DRV_FEAT_SEL, feature_select). (5) vn_cc_write_u32(base, VNET_CC_OFF_DRV_FEAT, feature_lo). (6) add rsp, 8; pop r12; pop rbx; ret. Labels prefixed vn_cc_wdf_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;
        mov  rbx, rdi;                       // feature_select
        mov  r12, rsi;                       // feature_lo
        mov  rdi, [rip + _virtio_net_common_cfg_pa];
        cmp  rdi, 0;
        je   vn_cc_wdf_none;
        // (4) write driver_feature_select
        mov  rsi, 0x08;                      // VNET_CC_OFF_DRV_FEAT_SEL
        mov  rdx, rbx;
        call vn_cc_write_u32;
        // (5) write driver_feature (low half of the ACK subset)
        mov  rdi, [rip + _virtio_net_common_cfg_pa];
        mov  rsi, 0x0C;                      // VNET_CC_OFF_DRV_FEAT
        mov  rdx, r12;
        call vn_cc_write_u32;
      vn_cc_wdf_none:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // virtio_net_init_handshake() -> u64
  //
  // The full modern virtio 1.0/1.1 §3.1.1 initialization sequence for
  // the first-active virtio-net device. See §3 header for the step-by-
  // step decomposition and the DRIVER_OK production-caveat.
  //
  // Return: VNET_CC_OK (0) on success; VNET_CC_ERR_NO_BAR if probe has
  // not populated _virtio_net_common_cfg_pa; VNET_CC_ERR_NO_VERSION_1 if
  // the device does not offer VIRTIO_F_VERSION_1 (bit 32); VNET_CC_ERR_
  // FEATURES_OK if the device did not latch FEATURES_OK after our
  // write. On any error, the device_status has been written to include
  // FAILED (bit 7) before this returns.
  //
  // Fingerprints (both emitted at the tail of the corresponding path,
  // via klog_s1 for the terminal shape shared with e1000e_reset's tail):
  //   virtio_net_init_ok_msg    "virtio-net init handshake ok ..."
  //   virtio_net_init_fail_msg  "virtio-net init handshake fail ..."
  //
  // Register plan (2-push callee-save):
  //   rbx = accumulated device_status value (the OR-in ladder)
  //   r12 = scratch across handshake reads (feature snapshots, status
  //         re-read after FEATURES_OK)
  //   Entry rsp%16==8 -> push rbx, push r12 -> %16==8 -- add sub rsp,8
  //   to reach %16==0. Total frame 24 B, aligned for every nested call.
  //
  // Labels prefixed vn_cc_hs_.
  // ==========================================================================

  pub let virtio_net_init_handshake : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M3-002 (paideia-os #2020). Modern virtio 1.0/1.1 §3.1.1 driver initialization sequence for the first-active virtio-net device. Body: (1) 2-push callee-save (rbx = accumulated device_status, r12 = scratch for the feature/status snapshots that survive across handshake sub-calls); sub rsp,8 to reach %16==0. (2) Gate: load _virtio_net_common_cfg_pa; if 0 -> emit FAIL fingerprint, return VNET_CC_ERR_NO_BAR (0xFFFFFFFFFFFFFFED). No status write here -- there is no device to mark FAILED. (3) RESET: virtio_net_write_device_status(0). Init rbx = 0. (4) ACK: rbx |= VNET_STATUS_ACK (1); virtio_net_write_device_status(rbx). (5) DRIVER: rbx |= VNET_STATUS_DRIVER (2); virtio_net_write_device_status(rbx). (6) FEATURES lo: r12 = virtio_net_read_device_features(VNET_F_SEL_LO=0); r12 &= VNET_F_ACK_LO_MASK (0x00010020); virtio_net_write_driver_features(0, r12). (7) FEATURES hi: r12 = virtio_net_read_device_features(VNET_F_SEL_HI=1); check r12 & VNET_F_VERSION_1_HI (0x00000001) -- if zero the device is legacy, set FAILED via virtio_net_write_device_status(rbx | VNET_STATUS_FAILED=128), emit FAIL fingerprint, return VNET_CC_ERR_NO_VERSION_1 (0xFFFFFFFFFFFFFFA1). Otherwise r12 &= VNET_F_ACK_HI_MASK (0x00000001); virtio_net_write_driver_features(1, r12). (8) FEATURES_OK: rbx |= VNET_STATUS_FEATURES_OK (8); virtio_net_write_device_status(rbx); re-read status via virtio_net_read_device_status -> r12; if (r12 & 8) == 0 the device rejected our subset -- set FAILED, emit FAIL fingerprint, return VNET_CC_ERR_FEATURES_OK (0xFFFFFFFFFFFFFFFB). (9) DRIVER_OK (§3 production-caveat: queue setup would normally land between FEATURES_OK and DRIVER_OK; R91.M3-003+ integration edits will interleave here): rbx |= VNET_STATUS_DRIVER_OK (4); virtio_net_write_device_status(rbx). (10) Emit OK fingerprint via klog_s1(LEVEL_INFO=3, SUBSYS_NET_, virtio_net_init_ok_msg). Return VNET_CC_OK (0). All error branches converge on vn_cc_hs_fail which emits the FAIL fingerprint and returns the error code stashed in rax by the branch. Every nested callee preserves rbx/r12 per SysV. Labels prefixed vn_cc_hs_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;                         // rsp%16==0 for nested calls

        // ---------- (2) Gate on _virtio_net_common_cfg_pa ----------
        mov  rax, [rip + _virtio_net_common_cfg_pa];
        cmp  rax, 0;
        jne  vn_cc_hs_reset;
        mov  rax, 0xFFFFFFFFFFFFFFED;        // VNET_CC_ERR_NO_BAR
        jmp  vn_cc_hs_fail;

      vn_cc_hs_reset:
        // ---------- (3) RESET: write 0 to device_status ----------
        xor  rdi, rdi;
        call virtio_net_write_device_status;
        xor  rbx, rbx;                       // accumulated status = 0

        // ---------- (4) ACK ----------
        or   rbx, 1;                         // VNET_STATUS_ACK
        mov  rdi, rbx;
        call virtio_net_write_device_status;

        // ---------- (5) DRIVER ----------
        or   rbx, 2;                         // VNET_STATUS_DRIVER
        mov  rdi, rbx;
        call virtio_net_write_device_status;

        // ---------- (6) FEATURES lo (select=0) ----------
        xor  rdi, rdi;                       // VNET_F_SEL_LO
        call virtio_net_read_device_features;
        mov  r12, rax;
        and  r12, 0x00010020;                // VNET_F_ACK_LO_MASK
        xor  rdi, rdi;                       // select_lo
        mov  rsi, r12;                       // ack subset
        call virtio_net_write_driver_features;

        // ---------- (7) FEATURES hi (select=1), VERSION_1 required ----------
        mov  rdi, 1;                         // VNET_F_SEL_HI
        call virtio_net_read_device_features;
        mov  r12, rax;                       // preserve full hi word
        and  rax, 1;                         // VNET_F_VERSION_1_HI
        cmp  rax, 0;
        jne  vn_cc_hs_hi_ok;
        // Device does not offer VIRTIO_F_VERSION_1: mark FAILED + fail.
        mov  rdi, rbx;
        or   rdi, 128;                       // VNET_STATUS_FAILED
        call virtio_net_write_device_status;
        mov  rax, 0xFFFFFFFFFFFFFFA1;        // VNET_CC_ERR_NO_VERSION_1
        jmp  vn_cc_hs_fail;

      vn_cc_hs_hi_ok:
        and  r12, 1;                         // VNET_F_ACK_HI_MASK
        mov  rdi, 1;                         // select_hi
        mov  rsi, r12;                       // ack subset
        call virtio_net_write_driver_features;

        // ---------- (8) FEATURES_OK ----------
        or   rbx, 8;                         // VNET_STATUS_FEATURES_OK
        mov  rdi, rbx;
        call virtio_net_write_device_status;
        // Re-read and verify FEATURES_OK stuck.
        call virtio_net_read_device_status;
        mov  r12, rax;
        and  r12, 8;                         // FEATURES_OK bit
        cmp  r12, 0;
        jne  vn_cc_hs_feats_ok;
        // Device rejected our subset: mark FAILED + fail.
        mov  rdi, rbx;
        or   rdi, 128;                       // VNET_STATUS_FAILED
        call virtio_net_write_device_status;
        mov  rax, 0xFFFFFFFFFFFFFFFB;        // VNET_CC_ERR_FEATURES_OK
        jmp  vn_cc_hs_fail;

      vn_cc_hs_feats_ok:
        // ---------- (9) DRIVER_OK (see §3 caveat re: queue setup) ----------
        or   rbx, 4;                         // VNET_STATUS_DRIVER_OK
        mov  rdi, rbx;
        call virtio_net_write_device_status;

        // ---------- (10) OK fingerprint + return VNET_CC_OK ----------
        mov  rdi, 3;                         // LEVEL_INFO
        lea  rsi, [rip + SUBSYS_NET_];
        lea  rdx, [rip + virtio_net_init_ok_msg];
        call klog_s1;
        xor  rax, rax;                       // VNET_CC_OK
        jmp  vn_cc_hs_done;

      vn_cc_hs_fail:
        // Common fail tail: rax already holds the error code. Emit the
        // FAIL fingerprint (rax survives across klog_s1 because we stash
        // it in r12 first -- klog_s1 is caller-save on rax) then return.
        mov  r12, rax;
        mov  rdi, 3;                         // LEVEL_INFO
        lea  rsi, [rip + SUBSYS_NET_];
        lea  rdx, [rip + virtio_net_init_fail_msg];
        call klog_s1;
        mov  rax, r12;

      vn_cc_hs_done:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
