// src/kernel/core/drivers/ec/ec_access.pdx — R31.M1-001 (#1089)
//
// The kernel's half of the embedded-controller access path: bind to the
// operation region that describes the controller, confine every
// transaction to it, and leave a sealed record of each one.
//
// =============================================================================
// R31.M6-#1580 CLOSED HERE: THE ARBITRATION ADDRESSES ARE PLUMBED, AND
// THE PIN THAT MADE THIS MODULE HONEST HAS FLIPPED
// =============================================================================
//
// The ACPI Global Lock — the protocol that stops this OS and System
// Management Mode driving the controller's registers at the same time —
// is implemented and correct in `src/user/aml/aml_glk.pdx` (R30.M8-#1082),
// and had been INERT IN A REAL BOOT until this milestone because the
// three addresses the protocol needs were never carried out of the FADT.
// Specifically:
//
//   * `src/kernel/acpi/fadt.pdx` declared `FADT_OFFSET_FIRMWARE_CTRL` and
//     never dereferenced it, so the FACS host VA never left the parser
//     even though it was a labelled offset in the header comment.
//   * `X_FIRMWARE_CTRL` (u64 @ FADT+132), the 64-bit superseding form,
//     was similarly declared-and-dropped.
//   * `PM1a_EVT_BLK` was not extracted at all — only the CNT block was
//     — so the release-signal side of PM1 (STS bit 5 = GBL_STS) had no
//     port carried out of the parser either.
//
// R31.M6-#1580 does three things and stops there:
//
//   1. `fadt_parse` now emits `facs_addr` at fadt_info+32, `pm1a_evt_port`
//      at fadt_info+40, `pm1b_evt_port` at fadt_info+42, and `pm1_evt_len`
//      at fadt_info+44. See src/kernel/acpi/fadt.pdx for the field ranges
//      and the length gate on `X_FIRMWARE_CTRL`.
//
//   2. This module adds `ec_access_bind_arbitration(facs, pm1_cnt,
//      pm1_sts)`, the ring-0 primitive that records the three addresses
//      into `_ec_access_state`, checks the FACS signature ("FACS" at
//      offset 0), and flips `arbitrated` at +40 from 0 to 1. It refuses
//      any zero argument for the same reason `ec_access_bind` does: a
//      default here would be a compare-exchange against a guessed word
//      and a doorbell delivered to port 0, both failures that look like
//      success from in here.
//
//   3. A dedicated boot witness in tests/kernel/acpi/global_lock_synth.pdx
//      exercises the whole chain end-to-end against a fabricated FADT +
//      synthetic FACS: parse the FADT, read the three fields out of
//      fadt_info, hand them to `ec_access_bind_arbitration`, and assert
//      that `ec_access_arbitrated()` returns 1. It emits `R31 GLOBAL LOCK
//      OK`.
//
// WHAT R31.M6-#1580 DELIBERATELY DOES NOT DO. The ring-3
// `src/user/acpi_supervisor.pdx` is still a stub (its dispatch loop
// returns count=0 for every op), and the KIND_ACPI capability that would
// map the FACS into ring 3 is not yet bound to a real range (R34
// userspace bubble). So on real hardware `aml_glk_attach` in ring 3 is
// still not called at boot, and the ring-3 half of the Global Lock is
// still inert. What has changed is that the plumbing gap between the
// FADT parser and the kernel-side arbitration record is closed, so the
// remaining work is a userspace-integration issue rather than a
// kernel-side-address-resolution issue. `ec_access_arbitrated()`
// therefore reports the kernel-side arbitration record — "the addresses
// are known, non-zero, and the FACS signature checks out" — which is a
// necessary but not sufficient condition for the ring-3 lock to be
// live. See design/acpi/global-lock.md for the ring-3 side.
//
// The pin at stage 35 of tests/kernel/cap/ec_query_synth.pdx has been
// updated to assert `ec_access_arbitrated() == 1` accordingly, and the
// wording in this comment moved from "NOTHING IN THIS TREE SETS IT" to
// "the addresses are plumbed" in the same commit. That is the same
// device #1065 used to keep the EC gate honest while it was shut, run
// in reverse: the fingerprint that failed when the plumbing landed
// forces the milestone to rewrite the statement that said it had not.
//
// =============================================================================
// WHAT THIS MODULE IS, AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS NOT THE REGISTER HANDSHAKE. `RD_EC` / `WR_EC` / `QR_EC`, the
// `IBF`/`OBF` polling, the bounded timeouts, the transaction claim and
// the `_Qxx` episode all live in `src/user/aml/aml_ec.pdx`, in ring 3,
// because `_Qxx` dispatch is firmware-bytecode evaluation and
// `design/acpi/no-aml-in-kernel.md` forbids that in ring 0.
// `design/acpi/embedded-controller.md` §3 is the argument. Rebuilding
// any of it here would be a duplicate of a mechanism whose entire design
// rationale is that it is not here, and `tools/lint-no-kernel-aml.sh`
// would refuse the file besides.
//
// IT IS THE PART THAT CANNOT LIVE THERE. The bubble is untrusted: it
// runs firmware bytecode. Two things therefore cannot be left to it, and
// this module is both of them.
//
//   THE EXTENT. The controller's address space is whatever the firmware
//   OpRegion declares, and that declaration is authority the kernel
//   granted as a `KIND_OP_REGION`. `ec_access_bind` takes that capability
//   and INHERITS the base and length from its row; `ec_access_audit`
//   refuses any address outside it. There is no base parameter and no
//   length parameter anywhere in this module — the same confined footing
//   #1075/#1076 put the GPIO pad path on, and the reason the signatures
//   are pinned in `tools/build.sh`.
//
//   THE RECORD. `design/acpi/embedded-controller.md` §2: a stray write to
//   an undocumented EC offset can change charge thresholds or fan curves
//   that persist across a reboot, and the register space outside what
//   firmware declares is vendor-undocumented — there is no specification
//   saying what does not happen. When a machine comes back with a
//   40%-charge ceiling nobody set, the only thing that can answer "did we
//   write that, and where" is a record made at the time. It goes into the
//   sealed `driver_audit_channel` ring (#1040/#1041) rather than a
//   private log, because that ring is tamper-evident and already
//   reconciled after a driver restart.
//
// =============================================================================
// REFUSE, NEVER CLAMP — AND A DISTINCT CODE PER CAUSE
// =============================================================================
//
// Every refusal below has its own code and its own counter. That is the
// same discipline the ring-3 driver follows and for the same reason: a
// latched code is overwritten by the next success, so "did the refusal
// happen at all" must stay assertable independently of "what was the
// last one".
//
// Clamping is never an option here. An out-of-range EC address is not a
// request to be repaired into the nearest legal one; the destructive
// case in §2 is precisely a write landing somewhere the caller did not
// intend, and clamping manufactures exactly that.
//
// =============================================================================
// THE RANGE IS CHECKED HERE EVEN THOUGH IT IS CHECKED TWICE ALREADY
// =============================================================================
//
// `design/acpi/embedded-controller.md` §6.1 enumerates three independent
// range checks, and this is a fourth. It is not redundant with any of
// them, because all three of the others are inside the bubble:
//
//   1. bind time, in `aml_region.pdx`  — trusts the binding row
//   2. access time, in `aml_region.pdx` — trusts the binding row
//   3. transaction time, in `aml_ec.pdx` — the last ring-3 statement
//
// A compromised or simply wrong bubble passes all three by construction.
// This one is made against the capability the KERNEL issued, in ring 0,
// where the bubble cannot reach it.

module EcAccess = structure {

  // ==========================================================================
  // The one address space this path will bind, and its extent.
  // ==========================================================================

  pub let EC_ACCESS_SPACE     : u64 = 0x03   // = OPREG_SPACE_EC
  pub let EC_ACCESS_SPACE_MAX : u64 = 256    // ACPI 6.5 §12.2
  pub let EC_ACCESS_REGION_KIND : u64 = 0x150 // = KIND_OP_REGION

  // Operations. Mirrors the ring-3 driver's AML_EC_OP_READ / _WRITE so a
  // transaction crossing the boundary keeps one number, not two.
  pub let EC_ACCESS_OP_READ  : u64 = 1
  pub let EC_ACCESS_OP_WRITE : u64 = 2

  // ==========================================================================
  // Return codes — 0xFFFFFDC0..CF, a band disjoint from every other in
  // tree (registry_v2 owns 0xFFFFFD0x; 0xFFFFFD2x/4x/5x/6x/8x/Ax are
  // taken; the router in core/acpi/ec_route.pdx owns 0xFFFFFDEx).
  // ==========================================================================

  pub let EC_ACCESS_OK            : u64 = 0
  pub let EC_ACCESS_BIND_BAD_SLOT : u64 = 0xFFFFFDCF
  pub let EC_ACCESS_BIND_BAD_KIND : u64 = 0xFFFFFDCE
  pub let EC_ACCESS_BIND_BAD_SPACE: u64 = 0xFFFFFDCD
  pub let EC_ACCESS_BIND_BAD_LEN  : u64 = 0xFFFFFDCC
  pub let EC_ACCESS_BIND_ALREADY  : u64 = 0xFFFFFDCB
  pub let EC_ACCESS_UNBOUND       : u64 = 0xFFFFFDCA
  pub let EC_ACCESS_RANGE         : u64 = 0xFFFFFDC9
  pub let EC_ACCESS_BAD_OP        : u64 = 0xFFFFFDC8
  pub let EC_ACCESS_BAD_VALUE     : u64 = 0xFFFFFDC7
  // R31.M6-#1580 arbitration codes. Distinct per cause so an operator
  // reading a failure can tell "the parser did not resolve the FACS
  // address" (BAD_FACS with signature check failing) apart from "a caller
  // passed zero for one of the two PM1 ports" (BAD_PM1). Rebinding is
  // refused rather than silently accepted: the FACS address is a system
  // fact and a second bind naming a different one is a caller bug, not a
  // routine event.
  pub let EC_ACCESS_ARB_BAD_FACS  : u64 = 0xFFFFFDC6
  pub let EC_ACCESS_ARB_BAD_PM1   : u64 = 0xFFFFFDC5
  pub let EC_ACCESS_ARB_ALREADY   : u64 = 0xFFFFFDC4

  // ACPI 6.5 FACS signature — "FACS" as u32 LE.
  pub let EC_ACCESS_FACS_SIG      : u64 = 0x53434146

  // ==========================================================================
  // State.
  //
  //   +0   bound          1 once ec_access_bind has succeeded
  //   +8   region_slot    the capability that authorised the binding
  //   +16  region_row     its row id — the stable key
  //   +24  base           INHERITED from the region row
  //   +32  len            INHERITED from the region row
  //   +40  arbitrated     0 until ec_access_bind_arbitration succeeds,
  //                       1 after. See the R31.M6-#1580 header block:
  //                       the pin at stage 35 of ec_query_synth is now
  //                       inverted (asserts 1, not 0).
  //   +48  permitted      transactions the gate allowed
  //   +56  reads          of which, reads
  //   +64  writes         of which, writes
  //   +72  ref_unbound    refusals: no binding
  //   +80  ref_range      refusals: address outside the region
  //   +88  ref_badop      refusals: neither a read nor a write
  //   +96  ref_value      refusals: a write value wider than a byte
  //   +104 last_addr      the address of the last attempt
  //   +112 last_op        the op of the last attempt
  //   +120 last_code      the outcome of the last attempt
  //   +128 facs_addr      R31.M6-#1580: FACS host VA (Global Lock @ +0x10)
  //   +136 pm1_cnt_port   R31.M6-#1580: PM1_CNT port for the GBL_RLS doorbell
  //   +144 pm1_sts_port   R31.M6-#1580: PM1_STS port for the GBL_STS release signal
  //   +152 arb_ref_zero   refusals: bind_arbitration with a zero argument
  //
  // The binding survives ec_access_reset for the reason aml_ec_reset
  // leaves the ring-3 driver's ports alone: where the controller is does
  // not change between diagnostic windows, and a reset that forgot it
  // would make every counter sampled after a sweep read as UNBOUND
  // rather than as zero. The ARBITRATION binding at +128..+152
  // similarly survives, and for a stronger reason: where the platform's
  // FACS is is a boot-time fact, and a reset that forgot it would make
  // ec_access_arbitrated() read 0 in the window after a diagnostic
  // sweep -- indistinguishable from #1580 being un-plumbed again.
  // ==========================================================================

  pub let mut _ec_access_state : [u64; 20] = uninit @align(64)

  pub let EC_ACCESS_ST_BOUND       : u64 = 0
  pub let EC_ACCESS_ST_REGION_SLOT : u64 = 1
  pub let EC_ACCESS_ST_REGION_ROW  : u64 = 2
  pub let EC_ACCESS_ST_BASE        : u64 = 3
  pub let EC_ACCESS_ST_LEN         : u64 = 4
  pub let EC_ACCESS_ST_ARBITRATED  : u64 = 5
  pub let EC_ACCESS_ST_PERMITTED   : u64 = 6
  pub let EC_ACCESS_ST_READS       : u64 = 7
  pub let EC_ACCESS_ST_WRITES      : u64 = 8
  pub let EC_ACCESS_ST_REF_UNBOUND : u64 = 9
  pub let EC_ACCESS_ST_REF_RANGE   : u64 = 10
  pub let EC_ACCESS_ST_REF_BADOP   : u64 = 11
  pub let EC_ACCESS_ST_REF_VALUE   : u64 = 12
  pub let EC_ACCESS_ST_LAST_ADDR   : u64 = 13
  pub let EC_ACCESS_ST_LAST_OP     : u64 = 14
  pub let EC_ACCESS_ST_LAST_CODE   : u64 = 15
  pub let EC_ACCESS_ST_FACS        : u64 = 16
  pub let EC_ACCESS_ST_PM1_CNT     : u64 = 17
  pub let EC_ACCESS_ST_PM1_STS     : u64 = 18
  pub let EC_ACCESS_ST_ARB_REF     : u64 = 19

  // ==========================================================================
  // ec_access_reset() -> ()
  // ==========================================================================

  pub let ec_access_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-001 (#1089), amended R31.M6-#1580: clear the counters and the last-attempt fields, LEAVING BOTH BINDINGS INTACT -- the region binding at +0..+32 for the reason aml_ec_reset leaves the ring-3 driver's ports alone, and the ARBITRATION binding at +40 and +128..+152 for a stronger reason. Where the platform's FACS is is a boot-time fact, and a reset that cleared arbitrated from 1 back to 0 would make ec_access_arbitrated() report the exact state #1580 was closed to eliminate -- 'the addresses are not plumbed' -- from within a window that had them the whole time. Pre-#1580 this store cleared +40 defensively, on the argument that nothing ever set it and so clearing it was a no-op that would matter once something did. Now something does. The stale-claim hazard the earlier justification named is subsumed by ec_access_bind_arbitration refusing to rebind with EC_ACCESS_ARB_ALREADY, so a mistaken second bind is refused loudly rather than silently accepted after a reset. Also skips +128..+152 (facs, pm1_cnt, pm1_sts, arb_ref counter) for the same reason. Leaf, a fixed-length store run. Labels prefixed ec_acc_r_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _ec_access_state];
        xor rax, rax;
        mov [r10 + 48],  rax;
        mov [r10 + 56],  rax;
        mov [r10 + 64],  rax;
        mov [r10 + 72],  rax;
        mov [r10 + 80],  rax;
        mov [r10 + 88],  rax;
        mov [r10 + 96],  rax;
        mov [r10 + 104], rax;
        mov [r10 + 112], rax;
        mov [r10 + 120], rax;
        ret
      }
    }

  // ==========================================================================
  // ec_access_unbind() -> ()
  // ==========================================================================

  pub let ec_access_unbind : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-001 (#1089): drop the binding, scrubbing the region slot, the row id, the base and the length in the same store sequence that clears the bound flag. Scrubbing rather than merely clearing the flag, because a retained base and length are a retained STATEMENT ABOUT WHERE A DEVICE IS, and a subsequent bind that failed partway would otherwise leave the previous controller's extent in place behind a flag that says nothing is bound. Separate from ec_access_reset because unbinding is a lifecycle event and resetting is a measurement one; folding them would mean no caller could sample a window without dropping the capability that produced it. Leaf. Labels prefixed ec_acc_u_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _ec_access_state];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        ret
      }
    }

  // ==========================================================================
  // ec_access_stat(index) -> value
  // ==========================================================================

  pub let ec_access_stat : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-001 (#1089), amended R31.M6-#1580: bounds-checked counter read; an index >= 20 returns 0 rather than reading past the array. The bound moved from 16 to 20 when arbitration binding at indices 16..19 landed. An observation channel with no authority behind it, so zero is a safe out-of-range answer. Leaf. Labels prefixed ec_acc_s_ per reserved-label discipline.",
      block: {
        cmp rdi, 20;
        jae ec_acc_s_zero;
        lea r10, [rip + _ec_access_state];
        mov r8, rdi;
        shl r8, 3;
        add r8, r10;
        mov rax, [r8 + 0];
        ret;
      ec_acc_s_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ec_access_bound() -> 1 | 0
  // ==========================================================================

  pub let ec_access_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-001 (#1089): 1 once a region capability has been bound. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // ec_access_arbitrated() -> 1 | 0
  //
  // THE HONESTY FUNCTION, R31.M6-#1580 flipped. Returns 1 iff
  // ec_access_bind_arbitration has bound a FACS address whose signature
  // is "FACS" and both PM1 ports are non-zero. See the module header for
  // what a 1 means and does NOT mean: it means the kernel-side plumbing
  // is complete, not that ring 3 has attached the lock to the actual
  // ring-3 aml_glk yet.
  // ==========================================================================

  pub let ec_access_arbitrated : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-001 (#1089), amended R31.M6-#1580: report whether transactions authorised through this path are arbitrated against System Management Mode -- specifically, whether ec_access_bind_arbitration has succeeded. Pre-#1580 this always returned 0 by construction; the FADT parser dropped FIRMWARE_CTRL and PM1a_EVT, so the addresses aml_glk needed had never left ring 0. #1580 added the parser fields (fadt.pdx) and this module's ec_access_bind_arbitration, and the boot witness at tests/kernel/acpi/global_lock_synth.pdx now drives the whole chain and asserts 1. The pin at stage 35 of ec_query_synth was inverted in the same commit -- from 'assert 0' to 'assert 1' -- so a regression that broke the plumbing again would fail both fingerprints on the pre-push matrix. A 1 here means the addresses are known and the FACS signature checks out; the ring-3 half (acpi_supervisor is still a stub, KIND_ACPI does not yet map the FACS into ring 3) is R34's -- see the module header block. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let ec_access_base : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-001 (#1089): the controller base this path is bound to, 0 when unbound. Inherited from the region row at bind and never written elsewhere. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let ec_access_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M1-001 (#1089): the declared extent this path is bound to, 0 when unbound. THIS IS THE ONLY DEFINITION OF HOW BIG THE CONTROLLER'S ADDRESS SPACE IS THAT RING 0 WILL ACT ON, and it is inherited from the capability rather than accepted from a caller. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  // ==========================================================================
  // ec_access_facs() -> u64
  // ec_access_pm1_cnt() -> u64
  // ec_access_pm1_sts() -> u64
  //
  // R31.M6-#1580 accessors. Return the bound arbitration addresses, 0
  // when ec_access_bind_arbitration has not been called (or was refused).
  // Read-only observation channels for the boot witness and for the
  // eventual ring-3 acpi_supervisor upgrade that will pass them across to
  // aml_glk_attach.
  // ==========================================================================

  pub let ec_access_facs : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-#1580: the FACS host VA bound by ec_access_bind_arbitration, 0 when unbound. The Global Lock word lives at this address + 0x10 and the Flags word at +0x14 (see design/acpi/global-lock.md §3). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 128];
        ret
      }
    }

  pub let ec_access_pm1_cnt : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-#1580: the PM1_CNT port bound by ec_access_bind_arbitration, 0 when unbound. This is the port aml_glk_signal writes the GBL_RLS doorbell to (masked read-modify-write, per design/acpi/global-lock.md §5). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 136];
        ret
      }
    }

  pub let ec_access_pm1_sts : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-#1580: the PM1_STS port bound by ec_access_bind_arbitration, 0 when unbound. This is the port aml_glk_signalled reads to check GBL_STS (bit 5) -- the release signal firmware raises when it drops a lock we marked Pending. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 144];
        ret
      }
    }

  // ==========================================================================
  // ec_access_bind_arbitration(facs_va, pm1_cnt_port, pm1_sts_port)
  //   -> EC_ACCESS_OK | EC_ACCESS_ARB_*
  //
  // R31.M6-#1580: the primitive that closes the gap between fadt_parse
  // (which now emits facs_addr / pm1a_evt_port / pm1a_cnt_port) and the
  // ring-3 aml_glk (which needs all three as arguments to aml_glk_attach).
  //
  // NO DEFAULTS, and the refusal of a zero argument is the point. A zero
  // FACS address would compare-exchange against virtual address 0x10; a
  // zero PM1_CNT would send the doorbell to port 0 and never wake the
  // firmware waiting for it; a zero PM1_STS would leave the wait polling
  // a port that reads back garbage. Both are failures that look like
  // success from in here -- the same refusal aml_glk_attach applies to
  // its own three arguments (src/user/aml/aml_glk.pdx §aml_glk_attach).
  //
  // THE FACS SIGNATURE IS CHECKED, and that check is load-bearing. A
  // caller could otherwise hand this function any u64 they liked and
  // arbitrated would flip to 1 against a compare-exchange target that had
  // nothing to do with the platform's Global Lock. The check reads the
  // u32 at facs_va + 0 and requires it to be "FACS" (0x53434146 LE) --
  // the ACPI 6.5 §5.2.10 fixed signature -- before recording anything.
  //
  // Rebinding is refused with EC_ACCESS_ARB_ALREADY rather than silently
  // accepted, for the reason ec_access_bind refuses re-binding: the FACS
  // address is a boot-time system fact, and a second bind naming a
  // different one is a caller bug rather than a legitimate re-plumbing.
  //
  // Sets `arbitrated` (u64 @ +40) LAST, after all three addresses are in
  // place, so no observer can see a half-built arbitration record. The
  // three addresses go into +128, +136, +144.
  //
  // Effects: {mem}. This does not itself write a port -- it only records
  // where the ports are -- so no {portio} or {sysreg}. The actual doorbell
  // write happens later in ring 3 through aml_glk_signal.
  // ==========================================================================

  pub let ec_access_bind_arbitration : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (facs_va: u64) (pm1_cnt_port: u64) (pm1_sts_port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M6-#1580: bind the three addresses the ACPI Global Lock protocol needs -- FACS host VA (compare-exchange target), PM1_CNT port (GBL_RLS doorbell), PM1_STS port (GBL_STS release signal) -- and flip ec_access_arbitrated() from 0 to 1. Refuses any zero argument with EC_ACCESS_ARB_BAD_PM1 (both port args) or EC_ACCESS_ARB_BAD_FACS (facs_va == 0 or its signature word is not 'FACS'), for the reason aml_glk_attach refuses a zero: a default here is a compare-exchange against a guessed address and a doorbell to port 0, both failures that look like success from the caller. THE SIGNATURE CHECK IS LOAD-BEARING and is done BEFORE any store: the caller supplies the pointer, and this module reading the u32 at [facs_va + 0] and requiring 0x53434146 is what stops the arbitrated flag turning on against a target that has nothing to do with a real FACS. Rebinding is refused with EC_ACCESS_ARB_ALREADY rather than silently replacing the addresses -- the FACS is a system fact and a second bind naming a different one is a caller bug, not a routine event. Sets `arbitrated` at +40 LAST, after all three addresses are in +128/+136/+144, so a concurrent reader of ec_access_arbitrated cannot observe a half-built binding. The +40 -> 1 transition is what stage 35 of ec_query_synth now asserts and what the R31 GLOBAL LOCK OK fingerprint reports. Failed-argument refusals bump +152 (arb_ref counter) so 'the refusal happened at all' stays assertable independently of the last outcome. Register plan: r12 = facs_va, r13 = pm1_cnt, r14 = pm1_sts across the single memory read of the signature. Four pushes (rbx, r12, r13, r14) from entry rsp%16 == 8 leave rsp%16 == 8; leaf-call-free -- no nested call -- so alignment is irrelevant. Labels prefixed ec_acc_ba_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // facs_va
        mov r13, rsi;                    // pm1_cnt
        mov r14, rdx;                    // pm1_sts

        // ---- Refuse zero PM1 arguments ----
        cmp r13, 0;
        je  ec_acc_ba_bad_pm1;
        cmp r14, 0;
        je  ec_acc_ba_bad_pm1;

        // ---- Refuse zero FACS ----
        cmp r12, 0;
        je  ec_acc_ba_bad_facs;

        // ---- Check the FACS signature (u32 @ facs_va + 0 == "FACS") ----
        mov eax, [r12 + 0];              // 32-bit load, zero-extends
        mov r11, 0x53434146;             // EC_ACCESS_FACS_SIG
        cmp rax, r11;
        jne ec_acc_ba_bad_facs;

        // ---- Refuse rebinding ----
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 40];
        cmp rax, 0;
        jne ec_acc_ba_already;

        // ---- Record the addresses first ----
        mov [r10 + 128], r12;            // facs_va
        mov [r10 + 136], r13;            // pm1_cnt
        mov [r10 + 144], r14;            // pm1_sts

        // ---- THEN set arbitrated. LAST. ----
        mov rax, 1;
        mov [r10 + 40], rax;

        xor rax, rax;                    // EC_ACCESS_OK
        jmp ec_acc_ba_out;

      ec_acc_ba_bad_pm1:
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 152];
        add rax, 1;
        mov [r10 + 152], rax;
        mov rax, 0xFFFFFDC5;             // EC_ACCESS_ARB_BAD_PM1
        jmp ec_acc_ba_out;

      ec_acc_ba_bad_facs:
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 152];
        add rax, 1;
        mov [r10 + 152], rax;
        mov rax, 0xFFFFFDC6;             // EC_ACCESS_ARB_BAD_FACS
        jmp ec_acc_ba_out;

      ec_acc_ba_already:
        mov rax, 0xFFFFFDC4;             // EC_ACCESS_ARB_ALREADY

      ec_acc_ba_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ec_access_bind(region_slot) -> EC_ACCESS_OK | EC_ACCESS_BIND_*
  //
  // ARITY ONE. There is no base parameter and no length parameter; both
  // are read out of the capability's own row.
  // ==========================================================================

  pub let ec_access_bind : (u64) -> u64 !{mem} @{cap} =
    fn (region_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M1-001 (#1089): bind this path to the operation region that describes the embedded controller. ARITY ONE, AND PINNED IN tools/build.sh: a base or length parameter would let a caller declare an extent the capability does not name, and every range refusal below would then be enforcing the caller's claim rather than the kernel's grant -- which is the entire confinement property inverted. Sequence: region_slot < 256 else BIND_BAD_SLOT; cap_table[region_slot].kind == 0x150 else BIND_BAD_KIND (a KIND_OP_REGION, not a raw KIND_IO_PORT: what must be established is that firmware DECLARED a region here, which only the derived capability proves); row_id from target_ptr[15:0]; opregion_row_space(row) == 0x03 else BIND_BAD_SPACE -- binding a SystemMemory region would confine transactions to an extent that has nothing to do with the controller while every check below still passed; opregion_row_len(row) in 1..256 else BIND_BAD_LEN, where a length of ZERO is refused as loudly as an oversized one because a zero-length region admits no address at all and a path bound to it would refuse every legitimate transaction as out of range; then opregion_row_base(row) for the base. Rebinding is refused with BIND_ALREADY rather than silently replacing the extent: a second bind while transactions are in flight would retroactively change which addresses were legal, and the audit trail would then record refusals and permissions against two different definitions of the same device with nothing in the record to say which. A caller that means to move the binding calls ec_access_unbind first, which is a separate and visible act. Both row accessors are checked for the all-ones decode sentinel BEFORE their values are compared, so a row that died between two calls cannot pass by having an all-ones length compare below the bound. THE BOUND FLAG IS SET LAST, after every field is in place, so no transaction can observe a half-built binding. Four pushes (rbx, r12, r13, r14) hold the slot, the row id, the length and the base across the three nested calls; entry rsp%16 == 8, four pushes take it to 8 as well, so a fifth push (r15, unused) restores the 0 SysV requires. Labels prefixed ec_acc_b_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // region_slot

        cmp rbx, 256;
        jae ec_acc_b_bad_slot;

        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne ec_acc_b_already;

        lea rax, [rip + cap_table];
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x150;                  // KIND_OP_REGION
        cmp r10, r11;
        jne ec_acc_b_bad_kind;

        mov r12, [rax + 16];
        mov r11, 0xFFFF;
        and r12, r11;                    // region row id

        // ---- the space must be EmbeddedControl ----
        mov rdi, r12;
        call opregion_row_space;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ec_acc_b_bad_space;
        mov r11, 0x03;                   // EC_ACCESS_SPACE
        cmp rax, r11;
        jne ec_acc_b_bad_space;

        // ---- the extent must be in 1..256 ----
        mov rdi, r12;
        call opregion_row_len;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ec_acc_b_bad_len;
        cmp rax, 0;
        je  ec_acc_b_bad_len;
        mov r11, 256;                    // EC_ACCESS_SPACE_MAX
        cmp rax, r11;
        ja  ec_acc_b_bad_len;
        mov r13, rax;                    // len

        // ---- the base ----
        mov rdi, r12;
        call opregion_row_base;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  ec_acc_b_bad_space;
        mov r14, rax;                    // base

        lea r10, [rip + _ec_access_state];
        mov [r10 + 8],  rbx;             // region_slot
        mov [r10 + 16], r12;             // region_row
        mov [r10 + 24], r14;             // base
        mov [r10 + 32], r13;             // len
        mov rax, 1;
        mov [r10 + 0],  rax;             // bound, LAST

        xor rax, rax;                    // EC_ACCESS_OK
        jmp ec_acc_b_out;

      ec_acc_b_bad_slot:
        mov rax, 0xFFFFFDCF;
        jmp ec_acc_b_out;
      ec_acc_b_bad_kind:
        mov rax, 0xFFFFFDCE;
        jmp ec_acc_b_out;
      ec_acc_b_bad_space:
        mov rax, 0xFFFFFDCD;
        jmp ec_acc_b_out;
      ec_acc_b_bad_len:
        mov rax, 0xFFFFFDCC;
        jmp ec_acc_b_out;
      ec_acc_b_already:
        mov rax, 0xFFFFFDCB;

      ec_acc_b_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ec_access_audit(op, addr, value) -> EC_ACCESS_OK | EC_ACCESS_*
  //
  // THE GATE, AND THE RECORD. Called once per transaction, before the
  // bytes go on the wire.
  // ==========================================================================

  pub let ec_access_audit : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (op: u64, addr: u64, value: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R31.M1-001 (#1089): authorise one embedded-controller transaction against the bound region, and record it either way. Gates, in order, each with its own code and its own counter: (1) bound, else EC_ACCESS_UNBOUND -- a transaction with no capability behind it is refused before the address is even looked at, because with no binding there is no definition of what 'in range' would mean. (2) op is READ (1) or WRITE (2), else EC_ACCESS_BAD_OP; the operation is checked BEFORE the range so that a malformed op on a legal address is reported as a malformed op, which is the fault a caller can actually fix. (3) for a write, value <= 0xFF, else EC_ACCESS_BAD_VALUE: the controller's data port is one byte wide, and a wider value means the caller has computed something other than what it thinks. Refused and not masked -- masking would put a byte on the wire that no caller asked for, on the one device in this tree where the written value can outlive the boot. (4) addr < the region's declared length, else EC_ACCESS_RANGE. THIS IS THE FOURTH INDEPENDENT RANGE CHECK ON THIS PATH and it is not redundant with the other three: all three of those are inside the ring-3 bubble (design/acpi/embedded-controller.md sec 6.1), a bubble that is wrong or compromised passes them by construction, and this one is made in ring 0 against the extent the KERNEL granted. The bound is the region's LENGTH and not the 256-byte space maximum, because a region declaring 32 bytes is a statement that only 32 exist, and admitting the other 224 would confine to the specification rather than to the grant. REFUSE, NEVER CLAMP: an out-of-range address is not a request to be repaired into the nearest legal one, and repairing it manufactures precisely the stray write the whole module exists to prevent. Every path, permitted or refused, records last_addr / last_op / last_code and then emits ONE drv_audit_emit record with event DRV_AUDIT_EV_EC_XACT, subject = the address, principal = (op << 32) | (value & 0xFF), outcome = the code. Emission covers refusals as well as permissions because an attempt on an address outside the region is the single most important thing this module can ever see, and a record made only on success would omit it. The emission is the LAST thing before the return, after every counter has moved, so a record and the counters it describes cannot disagree. Five pushes (rbx, r12, r13, r14, r15): rbx = op, r12 = addr, r13 = value, r14 = outcome code, r15 = the packed principal. Entry rsp%16 == 8 and five pushes return it to 0 at the nested emit. Labels prefixed ec_acc_a_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // op
        mov r12, rsi;                    // addr
        mov r13, rdx;                    // value

        lea r10, [rip + _ec_access_state];
        mov [r10 + 104], r12;            // last_addr
        mov [r10 + 112], rbx;            // last_op

        // ---- (1) a binding ----
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ec_acc_a_unbound;

        // ---- (2) a real operation ----
        cmp rbx, 1;                      // EC_ACCESS_OP_READ
        je  ec_acc_a_op_ok;
        cmp rbx, 2;                      // EC_ACCESS_OP_WRITE
        jne ec_acc_a_badop;

        // ---- (3) a byte-wide value, for a write ----
        mov r11, 0xFF;
        cmp r13, r11;
        ja  ec_acc_a_badvalue;

      ec_acc_a_op_ok:
        // ---- (4) inside the region the capability granted ----
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 32];             // len
        cmp r12, rax;
        jae ec_acc_a_range;

        // Permitted.
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;             // permitted
        cmp rbx, 2;
        je  ec_acc_a_note_write;
        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;             // reads
        jmp ec_acc_a_ok;
      ec_acc_a_note_write:
        mov rax, [r10 + 64];
        add rax, 1;
        mov [r10 + 64], rax;             // writes

      ec_acc_a_ok:
        xor r14, r14;                    // EC_ACCESS_OK
        jmp ec_acc_a_emit;

      ec_acc_a_unbound:
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 72];
        add rax, 1;
        mov [r10 + 72], rax;
        mov r14, 0xFFFFFDCA;             // EC_ACCESS_UNBOUND
        jmp ec_acc_a_emit;

      ec_acc_a_badop:
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 88];
        add rax, 1;
        mov [r10 + 88], rax;
        mov r14, 0xFFFFFDC8;             // EC_ACCESS_BAD_OP
        jmp ec_acc_a_emit;

      ec_acc_a_badvalue:
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 96];
        add rax, 1;
        mov [r10 + 96], rax;
        mov r14, 0xFFFFFDC7;             // EC_ACCESS_BAD_VALUE
        jmp ec_acc_a_emit;

      ec_acc_a_range:
        lea r10, [rip + _ec_access_state];
        mov rax, [r10 + 80];
        add rax, 1;
        mov [r10 + 80], rax;
        mov r14, 0xFFFFFDC9;             // EC_ACCESS_RANGE

      ec_acc_a_emit:
        lea r10, [rip + _ec_access_state];
        mov [r10 + 120], r14;            // last_code

        // principal = (op << 32) | (value & 0xFF)
        mov r15, rbx;
        shl r15, 32;
        mov r11, r13;
        mov r10, 0xFF;
        and r11, r10;
        or  r15, r11;

        mov rdi, 7;                      // DRV_AUDIT_EV_EC_XACT
        xor rsi, rsi;                    // kind = 0: not a cap transition
        mov rdx, r12;                    // subject = EC-space address
        mov rcx, r15;                    // principal = op and value
        mov r8,  r14;                    // outcome
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
