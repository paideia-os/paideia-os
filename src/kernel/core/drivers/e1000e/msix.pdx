// src/kernel/core/drivers/e1000e/msix.pdx — R27-M2-004 (#979)
//
// Intel e1000e / i219 MSI-X vector allocation + entry programming +
// device-side unmask. Single-vector MVP: entry 0 covers RX + TX + LSC
// via IMS.OTHER for M2. Multi-queue steering (RSS / per-queue vectors)
// lands at R27.M4 alongside the send-path substrate.
//
// -----------------------------------------------------------------------------
// IMS bit map (82574 §13.4.20 / e1000e ICR/IMS/IMC symmetric)
// -----------------------------------------------------------------------------
//
//   bit  0  TXDW   — Transmit Descriptor Written back (RS=1 completion)
//   bit  1  TXQE   — Transmit Queue Empty
//   bit  2  LSC    — Link Status Change
//   bit  3  RXSEQ  — Receive Sequence Error
//   bit  4  RXDMT0 — Receive Descriptor Minimum Threshold (queue 0)
//   bit  6  RXO    — Receiver Overrun
//   bit  7  RXT0   — Receiver Timer (queue 0)  — RX completion source
//   bit 16  OTHER  — MSI-X OTHER (aggregates ICS.RXCFG, LSC on MSI-X)
//
// The single-vector MVP arms TXDW | LSC | RXT0 | OTHER = 0x10085. RXO
// is deliberately omitted at M2 — overflow requires the buffer refill
// path to be running and is a coldpath alert at bring-up (the M2
// substrate returns every completed frame to the pool synchronously,
// so overrun cannot occur under the M2 workload).
//
// -----------------------------------------------------------------------------
// R27.M2 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// e1000e_msix_setup is a callable symbol at M2 but is NOT wired into
// kernel_main.pdx. Under BIOS/`-kernel` boot the PCI enumerator
// returns 0 devices and there is no _e1000e_devices[i] to hand in.
// R27.M3 driver-attach calls it after e1000e_reset succeeds and the
// RX/TX rings are programmed.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sub-8B loads/stores via mov_b / mov_w.
//
// Reserved-label discipline: labels prefixed `e1kmx_`.

module Msix = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let E1000E_IMS_TXDW           : u64 = 0x00000001
  pub let E1000E_IMS_LSC            : u64 = 0x00000004
  pub let E1000E_IMS_RXO            : u64 = 0x00000040
  pub let E1000E_IMS_RXT0           : u64 = 0x00000080
  pub let E1000E_IMS_OTHER          : u64 = 0x00010000

  // MVP mask: RX-timer + TX-done + link change + OTHER aggregate.
  pub let E1000E_IMS_MVP_MASK       : u64 = 0x00010085

  // MSI-X info scratch — matches msix_table_info layout (24 B).
  //   +0  u64  table_pa
  //   +8  u16  table_size
  //   +10 u8   bir
  //   +11 u8   _pad
  //   +12 u32  _pad
  //   +16 u64  pba_pa
  pub let mut _e1000e_msix_info     : [u64; 3] = uninit @align(8)

  // Return sentinels.
  pub let E1000E_MSIX_ERR_NO_CAP    : u64 = 0xFF
  pub let E1000E_MSIX_ERR_EXHAUST   : u64 = 0xFE

  // ============================================================================
  // e1000e_msix_setup(dev_ptr) -> u64
  // ============================================================================
  //
  // SysV: (dev_ptr: u64) -> u64
  //   rdi = pointer to a 32-byte _e1000e_devices record populated by
  //         e1000e_probe (see core/drivers/e1000e/probe.pdx L54).
  //
  // Returns rax = allocated MSI-X vector (0x60..0xEF) on success, or
  // one of:
  //   E1000E_MSIX_ERR_NO_CAP   (0xFF) — MSI-X capability not found on device
  //   E1000E_MSIX_ERR_EXHAUST  (0xFE) — per-CPU MSI-X vector pool exhausted
  //
  // Body:
  //   (1) Load {seg, bus, dev, fn, bar0} from *dev_ptr.
  //   (2) msix_map_table(seg, bus, dev, fn, &_e1000e_msix_info).
  //       On 0 return (no cap), bail with E1000E_MSIX_ERR_NO_CAP.
  //   (3) Load table_pa (u64 @ scratch+0).
  //   (4) vector_alloc_for_cpu(cpu=0) → vector. On 0xFF bail.
  //   (5) msix_program_entry(table_pa, entry_idx=0, vector, dest=0, mask=0).
  //   (6) Write IMS = E1000E_IMS_MVP_MASK via e1000e_reg_write_u32.
  //   (7) msix_enable_device(seg, bus, dev, fn).
  //   (8) Emit fingerprint "E1000E MSIX vec=<vector>".
  //   (9) Return vector.
  //
  // Register plan (6-push callee-save + 8-B align + 8-B vector scratch):
  //   rbx = bar0
  //   rbp = seg (loaded once, reused for msix_enable_device)
  //         Or: reused as table_pa scratch after msix_map_table returns —
  //         we shadow-load seg into r12 for the map/enable calls.
  //   r12 = seg
  //   r13 = bus
  //   r14 = dev
  //   r15 = fn
  //   [rsp+0] = vector scratch
  //
  //   6 pushes = 48 B; entry rsp%16==8 -> 8 + 48 = 56, %16==8. sub rsp,8
  //   -> 64, %16==0 (aligned for every nested call).

  pub let e1000e_msix_setup : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (dev_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M2-004 (#979). Single-vector MSI-X wire-up for the e1000e/i219 NIC. Body: (1) 6-push callee-save prologue (rbx=bar0, rbp=table_pa, r12=seg, r13=bus, r14=dev, r15=fn) + `sub rsp,8` scratch — 48 + 8 = 56; entry rsp%16==8 -> 64, %16==0 (aligned for every nested call). (2) Load {seg (u16 @+0), bus (u8 @+2), dev (u8 @+3), fn (u8 @+4), bar0 (u64 @+8)} from dev_ptr via zero-extended mov_w/mov_b + plain mov. (3) Call msix_map_table(seg, bus, dev, fn, &_e1000e_msix_info) — returns 1 on success, 0 if MSI-X cap absent. On 0 return E1000E_MSIX_ERR_NO_CAP (0xFF). (4) Load table_pa from scratch @+0 into rbp. (5) Call vector_alloc_for_cpu(0) — R27.M2 pins the vector on the BSP; multi-CPU steering deferred to R27.M4. On 0xFF (pool exhausted) return E1000E_MSIX_ERR_EXHAUST (0xFE). Save vector at [rsp+0]. (6) Call msix_program_entry(table_pa, entry_idx=0, vector, dest_apic_id=0, mask=0). dest=0 matches the BSP under the identity APIC-ID mapping paideia-os uses (see vector_pool.pdx L289). (7) Write IMS = E1000E_IMS_MVP_MASK (0x10085 = TXDW | LSC | RXT0 | OTHER) via e1000e_reg_write_u32(bar0, 0xD0, 0x10085). IMS is W1S (write-1-to-set); a subsequent driver-side IMC write must be used to disable. (8) Call msix_enable_device(seg, bus, dev, fn) — sets msg_control.msix_enable (bit 15) and clears function_mask (bit 14) in the device's PCI cap. This is the final gate: individual entry programming from step (6) must precede it, else the LAPIC IRR could latch a spurious assert. (9) Emit klog_s1_d1(INFO, E1KE, tag_e1000e_msix, k_vec, vector). (10) Return the vector in rax. Reserved labels: `e1kmx_`. Every nested callee preserves rbx/rbp/r12-r15 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                              // [rsp+0] = vector scratch

        // ============================================================
        // (2) Load {seg, bus, dev, fn, bar0} from dev_ptr.
        // ============================================================
        // seg (u16 @+0)
        xor rax, rax;
        mov_w rax, [rdi + 0];
        mov r12, rax;

        // bus (u8 @+2)
        xor rax, rax;
        mov_b rax, [rdi + 2];
        mov r13, rax;

        // dev (u8 @+3)
        xor rax, rax;
        mov_b rax, [rdi + 3];
        mov r14, rax;

        // fn (u8 @+4)
        xor rax, rax;
        mov_b rax, [rdi + 4];
        mov r15, rax;

        // bar0 (u64 @+8)
        mov rbx, [rdi + 8];

        // ============================================================
        // (3) msix_map_table(seg, bus, dev, fn, &_e1000e_msix_info)
        // ============================================================
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        lea r8, [rip + _e1000e_msix_info];
        call msix_map_table;

        cmp rax, 0;
        je e1kmx_no_cap;

        // ============================================================
        // (4) table_pa = _e1000e_msix_info[0]
        // ============================================================
        mov rbp, [rip + _e1000e_msix_info];

        // ============================================================
        // (5) vector_alloc_for_cpu(0)
        // ============================================================
        xor rdi, rdi;
        call vector_alloc_for_cpu;

        cmp rax, 0xFF;
        je e1kmx_no_vec;

        mov [rsp + 0], rax;                      // save vector

        // ============================================================
        // (6) msix_program_entry(table_pa, 0, vector, dest=0, mask=0)
        // ============================================================
        mov rdi, rbp;                            // table_pa
        xor rsi, rsi;                            // entry_idx = 0
        mov rdx, [rsp + 0];                      // vector
        xor rcx, rcx;                            // dest_apic_id = 0
        xor r8, r8;                              // mask = 0
        call msix_program_entry;

        // ============================================================
        // (7) Program IMS = MVP mask.
        // ============================================================
        mov rdi, rbx;                            // bar0
        mov rsi, 0xD0;                           // E1000E_REG_IMS
        mov rdx, 0x00010085;                     // TXDW | LSC | RXT0 | OTHER
        call e1000e_reg_write_u32;

        // ============================================================
        // (8) msix_enable_device(seg, bus, dev, fn)
        // ============================================================
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call msix_enable_device;

        // ============================================================
        // (9) Emit fingerprint.
        // ============================================================
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_E1KE];
        lea rdx, [rip + tag_e1000e_msix];
        lea rcx, [rip + k_vec];
        mov r8, [rsp + 0];
        call klog_s1_d1;

        // ============================================================
        // (10) Return vector.
        // ============================================================
        mov rax, [rsp + 0];
        jmp e1kmx_done;

      e1kmx_no_cap:
        mov rax, 0xFF;                           // E1000E_MSIX_ERR_NO_CAP
        jmp e1kmx_done;

      e1kmx_no_vec:
        mov rax, 0xFE;                           // E1000E_MSIX_ERR_EXHAUST

      e1kmx_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
