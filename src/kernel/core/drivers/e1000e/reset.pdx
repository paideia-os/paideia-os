// src/kernel/core/drivers/e1000e/reset.pdx — R27-M1-003 (#973)
//
// Intel e1000e / i219 device reset sequence.
//
// Per 82574 datasheet §5.6.1 the software controller-reset flow is:
//
//   (1) Mask ALL interrupts before reset:   IMC = 0xFFFFFFFF.
//       Interrupts routed to a still-installed MSI-X vector during
//       reset can wedge the LAPIC IRR line (spurious asserts of
//       already-cleared MSI-X entries), so the mask MUST be armed
//       before CTRL.RST asserts. IMC is write-1-to-clear on IMS.
//
//   (2) Assert CTRL.RST (bit 26). The bit is self-clearing once the
//       controller has completed its internal reset. 82574 §5.6.1
//       recommends spacing the write from any preceding CTRL RMW by
//       ~1µs; we insert a small settle delay before polling.
//
//   (3) Poll CTRL.RST until it clears. Datasheet does not mandate a
//       timeout; commodity silicon completes in well under 1ms. We
//       use a fixed count-based spin (2_000_000 iterations ~= 60ms
//       at 30 ns per e1000e_reg_u32 read on a 3 GHz core), which is
//       ~60x margin over any healthy controller. R27.M2 will replace
//       this with a tsc/hpet deadline once time.pdx is wired to the
//       driver-attach path.
//
//   (4) Re-mask interrupts after reset — some silicon resets IMS to
//       an implementation-defined value that may or may not include
//       previously-cleared bits. Re-assert IMC = 0xFFFFFFFF as a
//       defensive measure.
//
//   (5) Read-to-clear ICR — reset may latch spurious interrupt cause
//       bits. Discard the read result; the register is RC/W1C.
//
// -----------------------------------------------------------------------------
// R27.M1 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// e1000e_reset is a callable symbol at M1 but IS NOT wired into
// kernel_main.pdx. Under BIOS/`-kernel` boot the PCI enumerator
// returns 0 devices, e1000e_probe returns 0 NICs, and there is no
// bar0 to hand to e1000e_reset. Real activation lands at R27.M2
// driver-attach after Rx/Tx ring / MSI-X vector allocation.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: u32 MMIO writes route through e1000e_reg_write_u32 (mov_d internally).
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `e1kr_` to avoid the
// paideia-as reserved names (`loop`, `if`, ...).

module Reset = structure {

  // ============================================================================
  // Return codes
  // ============================================================================

  pub let E1000E_RESET_OK          : u64 = 0
  pub let E1000E_RESET_ERR_RST     : u64 = 1     // CTRL.RST never cleared

  // ============================================================================
  // Timeouts + settle
  // ============================================================================
  //
  // 2_000_000 iterations of {mfence, MMIO u32 read, mfence, and, cmp,
  // sub, cmp, jne} ~= 60ms on a 3 GHz core. Well above the 82574's
  // sub-millisecond reset budget yet short enough that a wedged
  // controller produces a boot-time fault witness rather than a
  // UX-visible stall.
  //
  // E1000E_RESET_SETTLE is a short pre-poll spin (~1000 no-ops via
  // decrement loop) to give the controller room to sample the reset
  // request before we poll — matches 82574 §5.6.1's implicit "small
  // delay" note.

  pub let E1000E_RESET_SPIN_MAX    : u64 = 2000000
  pub let E1000E_RESET_SETTLE      : u64 = 1000

  // ============================================================================
  // e1000e_reset(bar0) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base (MMIO physical address, page-aligned).
  //
  // Returns rax = E1000E_RESET_OK (0) on success, or
  // E1000E_RESET_ERR_RST on timeout waiting for CTRL.RST to clear.
  //
  // Register plan (3-push callee-save):
  //   rbx = bar0
  //   r12 = spin counter (reused for settle then reset-poll)
  //   r13 = scratch for CTRL RMW / IMC value
  //
  //   3 pushes = 24 B; entry rsp%16==8 → 24+8=32, %16==0 (aligned
  //   for every nested e1000e_reg_* call without extra pad).

  pub let e1000e_reset : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M1-003 (#973). Intel e1000e / i219 device reset per 82574 datasheet §5.6.1. Body: (1) 3-push callee-save prologue (rbx, r12, r13) — 24 B; entry rsp%16==8 → 24+8=32, %16==0 (aligned for every nested e1000e_reg_write_u32 / e1000e_reg_u32 call without pre-align pad). rbx = bar0. (2) Pre-reset interrupt mask: e1000e_reg_write_u32(bar0, IMC=0xD8, 0xFFFFFFFF). Using imm64 0xFFFFFFFF fits in mov rdx, imm32 zero-extended. (3) Read CTRL (offset 0x0000) via e1000e_reg_u32(bar0, 0) → rax. Set CTRL.RST (bit 26 = 0x04000000) via `or rax, imm32`. Write back via e1000e_reg_write_u32(bar0, 0, new_ctrl). (4) Settle spin: init r12 = E1000E_RESET_SETTLE; `e1kr_settle: sub r12,1; cmp r12,0; jne e1kr_settle` — gives the controller ~1000-cycle window to sample the RST assertion before we start polling. (5) Poll CTRL.RST clear: init r12 = E1000E_RESET_SPIN_MAX. Loop { ctrl = e1000e_reg_u32(bar0, 0); r13 = ctrl & 0x04000000; cmp r13, 0; je reset_done; dec r12; if r12 == 0 → return E1000E_RESET_ERR_RST }. (6) Re-mask interrupts: e1000e_reg_write_u32(bar0, IMC=0xD8, 0xFFFFFFFF). Some silicon resets IMS state to an implementation-defined value; re-asserting IMC is defensive per 82574 §13.4.20 note. (7) Read-to-clear ICR (offset 0xC0) via e1000e_reg_u32(bar0, 0xC0); discard result — the register is RC/W1C and reset may latch spurious cause bits. (8) Return 0 (OK). Reserved-label posture: labels prefixed `e1kr_`. Every e1000e_reg_* callee preserves rbx/r12/r13 per SysV.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                            // rbx = bar0

        // ================================================================
        // (2) Mask all interrupts pre-reset — IMC = 0xFFFFFFFF.
        // ================================================================
        mov rdi, rbx;
        mov rsi, 0xD8;                           // E1000E_REG_IMC
        mov rdx, 0xFFFFFFFF;
        call e1000e_reg_write_u32;

        // ================================================================
        // (3) Read CTRL, set CTRL.RST (bit 26), write back.
        // ================================================================
        mov rdi, rbx;
        mov rsi, 0x0000;                         // E1000E_REG_CTRL
        call e1000e_reg_u32;

        or rax, 0x04000000;                      // CTRL.RST bit 26

        mov rdi, rbx;
        mov rsi, 0x0000;
        mov rdx, rax;
        call e1000e_reg_write_u32;

        // ================================================================
        // (4) Settle — small delay before polling.
        // ================================================================
        mov r12, 1000;                           // E1000E_RESET_SETTLE
      e1kr_settle:
        sub r12, 1;
        cmp r12, 0;
        jne e1kr_settle;

        // ================================================================
        // (5) Poll CTRL.RST clear.
        // ================================================================
        mov r12, 2000000;                        // E1000E_RESET_SPIN_MAX

      e1kr_wait_rst:
        mov rdi, rbx;
        mov rsi, 0x0000;                         // CTRL
        call e1000e_reg_u32;

        mov r13, rax;
        and r13, 0x04000000;                     // isolate CTRL.RST
        cmp r13, 0;
        je e1kr_reset_done;

        sub r12, 1;
        cmp r12, 0;
        je e1kr_err_rst;
        jmp e1kr_wait_rst;

      e1kr_reset_done:

        // ================================================================
        // (6) Re-mask interrupts (defensive).
        // ================================================================
        mov rdi, rbx;
        mov rsi, 0xD8;                           // IMC
        mov rdx, 0xFFFFFFFF;
        call e1000e_reg_write_u32;

        // ================================================================
        // (7) Read-to-clear ICR.
        // ================================================================
        mov rdi, rbx;
        mov rsi, 0xC0;                           // ICR
        call e1000e_reg_u32;

        // ================================================================
        // (8) Emit "E1000E RESET" and return OK.
        // ================================================================
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_E1KE];
        lea rdx, [rip + tag_e1000e_reset];
        call klog_s1;

        xor rax, rax;                            // E1000E_RESET_OK
        jmp e1kr_done;

      e1kr_err_rst:
        mov rax, 1;                              // E1000E_RESET_ERR_RST

      e1kr_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
