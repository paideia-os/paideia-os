// src/kernel/core/drivers/e1000e/regs.pdx — R27-M1-002 (#972)
//
// Intel e1000e / i219 controller MMIO register map + 32-bit accessors.
//
// The e1000e family exposes a single ~128 KiB MMIO window at BAR0
// whose register layout is fixed by the Intel 82574 Gigabit Ethernet
// Controller Family datasheet §10 (revisions since 82574 have added
// vendor-specific windows past 0x8000 but the core control / status /
// receive / transmit blocks are unchanged from 82574 through i219).
//
// This file publishes:
//   * the canonical register-offset constants used across the driver,
//   * bitfield masks for the CTRL / STATUS / RCTL / TCTL / MDIC / EERD
//     control fields exercised by the reset / MAC-read / PHY-access
//     paths at R27.M1, and
//   * the plain-MMIO 32-bit read / write accessors.
//
// -----------------------------------------------------------------------------
// Register offsets (bytes from BAR0)  — 82574 datasheet §10.2
// -----------------------------------------------------------------------------
//
//   0x0000  CTRL       u32   Device Control
//                             bit  0  FD        — Full Duplex
//                             bit  3  LRST      — Link Reset
//                             bit  6  SLU       — Set Link Up
//                             bit  7  ILOS      — Invert Loss-of-Signal
//                             bits [9:8]  SPEED — 00=10, 01=100, 10=1000
//                             bit 11  FRCSPD    — Force Speed
//                             bit 12  FRCDPLX   — Force Duplex
//                             bit 20  ADVD3WUC  — Advance D3 Wake-Up Cap
//                             bit 26  RST       — Device Reset (self-clearing)
//                             bit 31  PHY_RST   — PHY Reset
//
//   0x0008  STATUS     u32   Device Status  (RO)
//                             bit  0  FD        — Full Duplex
//                             bit  1  LU        — Link Up
//                             bits [3:2]  FUNC_ID
//                             bit  4  TXOFF     — Transmission Paused
//                             bit  5  TBIMODE
//                             bits [7:6]  SPEED
//                             bits [9:8]  ASDV   — Auto-Speed Detect Value
//                             bit 10  MPD       — Manageability PHY Disabled
//
//   0x0010  EEC        u32   EEPROM / OTP control
//   0x0014  EERD       u32   EEPROM Read
//                             bit    0  START
//                             bit    1  DONE
//                             bits [15:2]  ADDR (word address)
//                             bits [31:16] DATA (u16 result)
//
//   0x0018  CTRL_EXT   u32   Extended Device Control
//
//   0x0020  MDIC       u32   MDI Interface Control (PHY register access)
//                             bits [15:0]  DATA
//                             bits [20:16] REGADDR
//                             bits [25:21] PHYADDR
//                             bits [27:26] OP     — 01=write, 10=read
//                             bit    28  READY
//                             bit    29  INTERRUPT
//                             bit    30  ERROR
//
//   0x00C0  ICR        u32   Interrupt Cause Read (RC/W1C)
//   0x00D0  IMS        u32   Interrupt Mask Set/Read (W1S)
//   0x00D8  IMC        u32   Interrupt Mask Clear (W1C)
//
//   0x0100  RCTL       u32   Receive Control
//                             bit  1  EN        — Receiver Enable
//                             bit  2  SBP       — Store Bad Packets
//                             bit  3  UPE       — Unicast Promiscuous
//                             bit  4  MPE       — Multicast Promiscuous
//                             bit  5  LPE       — Long Packet Enable
//                             bit 15  BAM       — Broadcast Accept Mode
//                             bits [17:16] BSIZE — Receive Buffer Size
//                             bit 25  BSEX      — Buffer Size Extension
//                             bit 26  SECRC     — Strip Ethernet CRC
//
//   0x0400  TCTL       u32   Transmit Control
//                             bit  1  EN        — Transmit Enable
//                             bit  3  PSP       — Pad Short Packets
//                             bits [11:4]  CT   — Collision Threshold
//                             bits [21:12] COLD — Collision Distance
//                             bit 22  SWXOFF    — Software XOFF
//
//   0x2800  RDBAL      u32   Rx Descriptor Ring Base Low
//   0x2804  RDBAH      u32   Rx Descriptor Ring Base High
//   0x2808  RDLEN      u32   Rx Descriptor Ring Length (bytes; 128 B mult)
//   0x2810  RDH        u32   Rx Descriptor Ring Head
//   0x2818  RDT        u32   Rx Descriptor Ring Tail
//
//   0x3800  TDBAL      u32   Tx Descriptor Ring Base Low
//   0x3804  TDBAH      u32   Tx Descriptor Ring Base High
//   0x3808  TDLEN      u32   Tx Descriptor Ring Length
//   0x3810  TDH        u32   Tx Descriptor Ring Head
//   0x3818  TDT        u32   Tx Descriptor Ring Tail
//
//   0x5200..0x53FC   MTA[0..127]  u32   Multicast Table Array
//   0x5400..0x543F   RAL/RAH[0..15]     Receive Address filter table
//                                       (each entry: RAL @ base+idx*8,
//                                        RAH @ base+idx*8+4)
//
// -----------------------------------------------------------------------------
// R27.M1 posture: no boot-time e1000e MMIO
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` boot QEMU q35 does not expose PCI devices to
// the PCI enumerator (MCFG-absent path). e1000e_probe consequently
// returns 0 controllers and the reset / MAC-read / PHY paths are
// never invoked at M1. The accessors below are dormant symbols at
// M1 — real invocations land at R27.M2 driver-attach after Rx/Tx ring
// allocation from phys_alloc + MSI-X vector programming.
//
// -----------------------------------------------------------------------------
// MMIO ordering discipline
// -----------------------------------------------------------------------------
//
// All accessors bracket the MMIO transaction with `mfence` — same
// posture as core/drivers/nvme/regs.pdx / core/drivers/xhci/regs.pdx:
//   (a) mfence-BEFORE: earlier WB stores retire before the UC MMIO
//       transaction begins (SDM Vol 3A §11.3.1 — WB→UC not ordered).
//   (b) mfence-AFTER: the MMIO transaction publishes / completes
//       before downstream code observes side-effects.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 MMIO stores.
//       32-bit MMIO reads use `mov eax, [addr]` (auto-zero-extends per
//       SDM Vol 2A §3.4.1.1) so no sized-load workaround is required.

module Regs = structure {

  // ============================================================================
  // Register offsets (bytes from BAR0)
  // ============================================================================

  pub let E1000E_REG_CTRL          : u64 = 0x0000
  pub let E1000E_REG_STATUS        : u64 = 0x0008
  pub let E1000E_REG_EEC           : u64 = 0x0010
  pub let E1000E_REG_EERD          : u64 = 0x0014
  pub let E1000E_REG_CTRL_EXT      : u64 = 0x0018
  pub let E1000E_REG_MDIC          : u64 = 0x0020

  pub let E1000E_REG_ICR           : u64 = 0x00C0
  pub let E1000E_REG_IMS           : u64 = 0x00D0
  pub let E1000E_REG_IMC           : u64 = 0x00D8

  pub let E1000E_REG_RCTL          : u64 = 0x0100
  pub let E1000E_REG_TCTL          : u64 = 0x0400

  pub let E1000E_REG_RDBAL         : u64 = 0x2800
  pub let E1000E_REG_RDBAH         : u64 = 0x2804
  pub let E1000E_REG_RDLEN         : u64 = 0x2808
  pub let E1000E_REG_RDH           : u64 = 0x2810
  pub let E1000E_REG_RDT           : u64 = 0x2818

  pub let E1000E_REG_TDBAL         : u64 = 0x3800
  pub let E1000E_REG_TDBAH         : u64 = 0x3804
  pub let E1000E_REG_TDLEN         : u64 = 0x3808
  pub let E1000E_REG_TDH           : u64 = 0x3810
  pub let E1000E_REG_TDT           : u64 = 0x3818

  pub let E1000E_REG_MTA_BASE      : u64 = 0x5200
  pub let E1000E_REG_RAL_BASE      : u64 = 0x5400
  pub let E1000E_REG_RAH_BASE      : u64 = 0x5404
  pub let E1000E_RAR_ENTRY_STRIDE  : u64 = 8       // RAL/RAH pair per entry

  // ============================================================================
  // CTRL bit definitions (82574 §10.2.1.1)
  // ============================================================================

  pub let E1000E_CTRL_FD           : u64 = 0x00000001
  pub let E1000E_CTRL_LRST         : u64 = 0x00000008
  pub let E1000E_CTRL_SLU          : u64 = 0x00000040
  pub let E1000E_CTRL_ILOS         : u64 = 0x00000080
  pub let E1000E_CTRL_FRCSPD       : u64 = 0x00000800
  pub let E1000E_CTRL_FRCDPLX      : u64 = 0x00001000
  pub let E1000E_CTRL_ADVD3WUC     : u64 = 0x00100000
  pub let E1000E_CTRL_RST          : u64 = 0x04000000    // bit 26
  pub let E1000E_CTRL_PHY_RST      : u64 = 0x80000000    // bit 31

  // ============================================================================
  // STATUS bit definitions (§10.2.1.2)
  // ============================================================================

  pub let E1000E_STATUS_FD         : u64 = 0x00000001
  pub let E1000E_STATUS_LU         : u64 = 0x00000002
  pub let E1000E_STATUS_TXOFF      : u64 = 0x00000010
  pub let E1000E_STATUS_TBIMODE    : u64 = 0x00000020

  // ============================================================================
  // EERD bit definitions (§10.2.3.2)
  // ============================================================================

  pub let E1000E_EERD_START        : u64 = 0x00000001    // bit 0
  pub let E1000E_EERD_DONE         : u64 = 0x00000002    // bit 1
  pub let E1000E_EERD_ADDR_SHIFT   : u64 = 2             // bits [15:2]
  pub let E1000E_EERD_DATA_SHIFT   : u64 = 16            // bits [31:16]

  // ============================================================================
  // MDIC bit definitions (§10.2.3.1)
  // ============================================================================

  pub let E1000E_MDIC_REGADDR_SHIFT : u64 = 16           // bits [20:16]
  pub let E1000E_MDIC_PHYADDR_SHIFT : u64 = 21           // bits [25:21]
  pub let E1000E_MDIC_OP_SHIFT      : u64 = 26           // bits [27:26]
  pub let E1000E_MDIC_OP_WRITE      : u64 = 1            // OP = 01
  pub let E1000E_MDIC_OP_READ       : u64 = 2            // OP = 10
  pub let E1000E_MDIC_READY         : u64 = 0x10000000   // bit 28
  pub let E1000E_MDIC_ERROR         : u64 = 0x40000000   // bit 30

  // ============================================================================
  // RCTL bit definitions (§10.2.5.1)
  // ============================================================================

  pub let E1000E_RCTL_EN           : u64 = 0x00000002    // bit 1
  pub let E1000E_RCTL_SBP          : u64 = 0x00000004
  pub let E1000E_RCTL_UPE          : u64 = 0x00000008
  pub let E1000E_RCTL_MPE          : u64 = 0x00000010
  pub let E1000E_RCTL_LPE          : u64 = 0x00000020
  pub let E1000E_RCTL_BAM          : u64 = 0x00008000
  pub let E1000E_RCTL_BSEX         : u64 = 0x02000000
  pub let E1000E_RCTL_SECRC        : u64 = 0x04000000

  // ============================================================================
  // TCTL bit definitions (§10.2.6.1)
  // ============================================================================

  pub let E1000E_TCTL_EN           : u64 = 0x00000002    // bit 1
  pub let E1000E_TCTL_PSP          : u64 = 0x00000008    // bit 3
  pub let E1000E_TCTL_SWXOFF       : u64 = 0x00400000    // bit 22

  // ============================================================================
  // RAH bit definitions (§10.2.7.4)
  // ============================================================================
  //
  // RAH[idx] layout:
  //   bits [15:0]  MAC high 2 bytes (bytes 4, 5)
  //   bits [17:16] ASEL (Address Select — 00 = destination address)
  //   bit    31    AV (Address Valid — must be set to enable filter)

  pub let E1000E_RAH_AV            : u64 = 0x80000000    // bit 31

  // ============================================================================
  // e1000e_reg_u32 — 32-bit MMIO read from bar0 + offset
  // ============================================================================
  //
  // SysV: (bar0: u64, offset: u64) -> u64
  //   rdi = BAR0 base (MMIO physical address, page-aligned per 82574 §10.1)
  //   rsi = register offset (E1000E_REG_* constant)
  //
  // Returns rax = 32-bit register value, zero-extended to 64 bits per
  // SDM Vol 2A §3.4.1.1.
  //
  // Leaf function. mfence brackets the MMIO transaction.

  pub let e1000e_reg_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M1-002 (#972). Intel e1000e / i219 32-bit MMIO read. Structural sibling to nvme_reg_u32 (core/drivers/nvme/regs.pdx L173) and xhci_op_u32 (core/drivers/xhci/regs.pdx L304). rdi = BAR0 base (page-aligned per 82574 §10.1), rsi = register offset (E1000E_REG_* constant). Body: (1) mfence — earlier WB stores retire before this UC MMIO transaction (SDM Vol 3A §11.3.1: WB→UC on same CPU is not TSO-ordered). (2) Compute effective address = bar0 + offset via `mov rax, rdi; add rax, rsi`. (3) mov eax, [rax] — 32-bit MMIO load; zero-extends into upper 32 bits of rax per SDM Vol 2A §3.4.1.1. (4) mfence — result must complete before downstream code observes side-effects. Leaf function, no prologue. Every e1000e register in the M1 register map is naturally 4-byte-aligned so the load never straddles a UC line.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    } @no_frame

  // ============================================================================
  // e1000e_reg_write_u32 — 32-bit MMIO write to bar0 + offset
  // ============================================================================
  //
  // SysV: (bar0: u64, offset: u64, val: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = register offset
  //   rdx = value (low 32 bits stored; high bits ignored)

  pub let e1000e_reg_write_u32 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, offset: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M1-002 (#972). Intel e1000e / i219 32-bit MMIO write. Structural sibling to nvme_reg_write_u32 (core/drivers/nvme/regs.pdx L197) and xhci_op_write_u32 (core/drivers/xhci/regs.pdx L325). rdi = BAR0 base, rsi = register offset, rdx = value (low 32 bits stored). Body: (1) mfence — bracket earlier WB stores. (2) Compute effective address = bar0 + offset. (3) mov_d [rax], rdx — 32-bit MMIO store (G1: sized-32-bit form; bare `mov [rax], rdx` widens to REX.W and writes 8 bytes into a 4-byte register slot, corrupting the neighbouring register slot). (4) mfence — value must publish before downstream observation. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_d [rax], rdx;
        mfence;
        ret
      }
    } @no_frame
}
