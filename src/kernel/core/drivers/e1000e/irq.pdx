// src/kernel/core/drivers/e1000e/irq.pdx — R27-M2-005 (#980)
//
// Intel e1000e / i219 interrupt-cause walker.
//
// -----------------------------------------------------------------------------
// Contract
// -----------------------------------------------------------------------------
//
// e1000e_irq_handler(bar0) is the single-vector ISR body for the MSI-X
// entry programmed by e1000e_msix_setup. Per the M2 mask (TXDW | LSC |
// RXT0 | OTHER = 0x10085) the handler serves three cause groups:
//
//   * RXT0 / RXO   — RX-side completions or overruns; walk the descriptor
//                    ring from the driver-side `_e1000e_rx_next` cursor
//                    while status.DD=1, count and clear each completed
//                    descriptor, then advance RDT to hand the drained
//                    slots back to hardware.
//   * TXDW         — TX-side descriptor writebacks (RS=1 completion);
//                    walk the TX ring from `_e1000e_tx_head` while
//                    STA.DD=1 and clear each STA byte so the slot is
//                    reusable by the transmit path.
//   * LSC          — Link-status change; re-read STATUS.LU and emit a
//                    "E1000E LINK" fingerprint so a photograph of a
//                    boot-time link event is unambiguous.
//
// ICR is Read-to-Clear / Write-1-to-Clear per 82574 §13.4.17 — reading
// it consumes the pending cause bits atomically, so the handler must
// snapshot the value once and dispatch off the snapshot rather than
// re-reading ICR per cause.
//
// -----------------------------------------------------------------------------
// M2 posture: symbol-only
// -----------------------------------------------------------------------------
//
// The IDT wire that would route an MSI-X vector to this handler is
// R23+ hardening work (design/kernel/driver-plane.md §"IDT slot for
// driver-side ISR trampoline"). At M2 the handler is a callable
// symbol whose semantics are witnessed via a synthetic call from
// driver-attach; real IRQ delivery lands with #983 (R27.M3).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: descriptor-status u8 loads/stores via mov_b.
//
// Reserved-label discipline: labels prefixed `e1kih_`.

module Irq = structure {

  // ============================================================================
  // Constants — ICR cause bits
  // ============================================================================

  pub let E1000E_ICR_TXDW           : u64 = 0x00000001
  pub let E1000E_ICR_TXQE           : u64 = 0x00000002
  pub let E1000E_ICR_LSC            : u64 = 0x00000004
  pub let E1000E_ICR_RXO            : u64 = 0x00000040
  pub let E1000E_ICR_RXT0           : u64 = 0x00000080
  pub let E1000E_ICR_OTHER          : u64 = 0x00010000

  // Combined RX-completion cause set (RXT0 | RXO).
  pub let E1000E_ICR_RX_MASK        : u64 = 0x000000C0

  // ============================================================================
  // e1000e_irq_handler(bar0) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base
  //
  // Returns rax = number of RX descriptors consumed on this IRQ (0 on
  // spurious / TX-only / LSC-only IRQs).
  //
  // Body:
  //   (1) Snapshot ICR (read-to-clear).
  //   (2) If ICR == 0: spurious IRQ — return 0.
  //   (3) If ICR & (RXT0 | RXO): walk RX ring from _e1000e_rx_next while
  //       status.DD=1. For each: bump count, clear status/errors, advance
  //       cursor mod 128. On loop exit persist cursor + bump
  //       _e1000e_rx_pkts + write RDT = (cursor - 1) & 127 + emit
  //       "E1000E RX N=<total_pkts>" fingerprint.
  //   (4) If ICR & TXDW: walk TX ring from _e1000e_tx_head while
  //       STA.DD=1. For each: clear STA byte, advance cursor. Persist
  //       cursor.
  //   (5) If ICR & LSC: read STATUS, extract LU (bit 1), emit
  //       "E1000E LINK n=<lu>".
  //   (6) Return this-IRQ RX count in rax.
  //
  // Register plan (5-push callee-save; 5 pushes = 40 B; entry rsp%16==8
  // -> 48, %16==0 — aligned for every nested call without a sub-rsp
  // pad):
  //   rbx = bar0                    (survives nested calls)
  //   rbp = ICR snapshot            (survives nested calls)
  //   r12 = this-IRQ RX count
  //   r13 = ring cursor (RX then TX reuse)
  //   r14 = current-descriptor address scratch

  pub let e1000e_irq_handler : (u64) -> u64 !{sysreg, mem} @{} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R27-M2-005 (#980). e1000e/i219 single-vector ISR body. Body: (1) 5-push callee-save prologue (rbx=bar0, rbp=ICR snapshot, r12=rx count, r13=ring cursor, r14=desc addr scratch) — 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every nested call, no sub-rsp pad needed). rbx = bar0; init r12 = 0. (2) Read ICR via e1000e_reg_u32(bar0, 0xC0) — the read atomically consumes pending cause bits (RC/W1C per 82574 §13.4.17), so snapshot the returned value in rbp and dispatch from the snapshot. (3) Spurious guard: if rbp == 0 -> jump to done (return 0). (4) RX cause: rax = rbp & 0xC0 (RXT0 | RXO); if 0 -> skip. Load r13 = _e1000e_rx_next. Walk loop `e1kih_rx_loop`: desc = &_e1000e_rx_ring + cursor*16 via `mov rax,r13; shl rax,4; lea r14,[rip+_e1000e_rx_ring]; add r14,rax`. Load status (u8 @+12) via `xor rax,rax; mov_b rax,[r14+12]`; isolate DD bit via `and rax,1`; if 0 -> break. Bump r12; clear status/errors via `xor rax,rax; mov_b [r14+12],rax; mov_b [r14+13],rax`. Advance cursor: `add r13,1; and r13,127`; loop. On break: if r12==0 skip RDT write. Otherwise: persist cursor to _e1000e_rx_next; add r12 to _e1000e_rx_pkts and store back; write RDT = (cursor-1)&127 via e1000e_reg_write_u32(bar0, 0x2818, new_rdt) — RDT points at the last SW-owned slot; the range (RDT, RDH] returns to HW. Emit klog_s1_d1(INFO, E1KE, tag_e1000e_rx, k_n, _e1000e_rx_pkts). (5) TX cause: rax = rbp & 1 (TXDW); if 0 -> skip. Load r13 = _e1000e_tx_head. Walk loop `e1kih_tx_loop`: desc = &_e1000e_tx_ring + cursor*16. Load sta_rsv (u8 @+12); STA.DD is bit 0; if 0 -> break. Clear STA byte to 0; advance cursor mod 128. Persist cursor to _e1000e_tx_head. (6) LSC cause: rax = rbp & 4; if 0 -> skip. Read STATUS via e1000e_reg_u32(bar0, 0x08); mask LU bit (0x02); emit klog_s1_d1(INFO, E1KE, tag_e1000e_link, k_n, lu_bit). (7) Return r12 (this-IRQ RX count) in rax. Reserved labels: `e1kih_`. Every nested callee preserves rbx/rbp/r12-r14 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // rbx = bar0
        xor r12, r12;                            // count = 0

        // ============================================================
        // (1) Snapshot ICR (RC/W1C).
        // ============================================================
        mov rdi, rbx;
        mov rsi, 0xC0;                           // E1000E_REG_ICR
        call e1000e_reg_u32;
        mov rbp, rax;                            // rbp = ICR snapshot

        // ============================================================
        // (2) Spurious guard.
        // ============================================================
        cmp rbp, 0;
        je e1kih_done;

        // ============================================================
        // (3) RX cause: RXT0 (bit 7) | RXO (bit 6).
        // ============================================================
        mov rax, rbp;
        and rax, 0xC0;
        cmp rax, 0;
        je e1kih_after_rx;

        // Load next-to-clean cursor.
        mov r13, [rip + _e1000e_rx_next];

      e1kih_rx_loop:
        // desc = &_e1000e_rx_ring + cursor*16
        mov rax, r13;
        shl rax, 4;
        lea r14, [rip + _e1000e_rx_ring];
        add r14, rax;

        // status (u8 @+12) & DD
        xor rax, rax;
        mov_b rax, [r14 + 12];
        and rax, 1;
        cmp rax, 0;
        je e1kih_rx_break;

        // R91.M1-004 (paideia-os #2014) — L2 receive dispatch, routed.
        // For each descriptor with STA.DD=1, hand the frame body to
        // the generic nic_dispatch_rx_dispatch shim (which pass-
        // through-calls l2_rx_handle for the e1000e arm) before
        // clearing the status byte. The shim exists so that virtio-
        // net (R91.M3) and rtl8139 (R91.M4) ISRs can reach the same
        // L2 rx path via the same call site shape (only the
        // NIC_KIND_* immediate differs). buffer_addr = u64 @+0,
        // frame_len = u16 @+8 (HW-written on completion; already
        // excludes the stripped 4-byte FCS). r14 (desc pointer) and
        // r13 (cursor) are callee-save-preserved across the nested
        // call (nic_dispatch_rx_dispatch preserves them, and
        // l2_rx_handle beneath it preserves them per SysV).
        //
        // SysV: nic_dispatch_rx_dispatch(nic_kind=rdi, packet_ptr=rsi,
        //                                packet_len=rdx).
        mov rsi, [r14 + 0];                      // rsi = packet_ptr
        xor rdx, rdx;
        mov_w rdx, [r14 + 8];                    // rdx = packet_len (u16, zero-ext)
        mov rdi, 1;                              // NIC_KIND_E1000E
        call nic_dispatch_rx_dispatch;

        // Count and clear.
        add r12, 1;
        xor rax, rax;
        mov_b [r14 + 12], rax;                   // status = 0
        mov_b [r14 + 13], rax;                   // errors = 0

        add r13, 1;
        and r13, 127;
        jmp e1kih_rx_loop;

      e1kih_rx_break:
        cmp r12, 0;
        je e1kih_after_rx;

        // Persist cursor.
        mov [rip + _e1000e_rx_next], r13;

        // Bump persistent counter.
        mov rax, [rip + _e1000e_rx_pkts];
        add rax, r12;
        mov [rip + _e1000e_rx_pkts], rax;

        // RDT = (cursor - 1) & 127.
        mov rax, r13;
        sub rax, 1;
        and rax, 127;
        mov rdi, rbx;
        mov rsi, 0x2818;                         // E1000E_REG_RDT
        mov rdx, rax;
        call e1000e_reg_write_u32;

        // Fingerprint: "E1000E RX N=<total>".
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_E1KE];
        lea rdx, [rip + tag_e1000e_rx];
        lea rcx, [rip + k_n];
        mov r8, [rip + _e1000e_rx_pkts];
        call klog_s1_d1;

      e1kih_after_rx:
        // ============================================================
        // (4) TX cause: TXDW (bit 0).
        // ============================================================
        mov rax, rbp;
        and rax, 1;
        cmp rax, 0;
        je e1kih_after_tx;

        mov r13, [rip + _e1000e_tx_head];

      e1kih_tx_loop:
        // desc = &_e1000e_tx_ring + cursor*16
        mov rax, r13;
        shl rax, 4;
        lea r14, [rip + _e1000e_tx_ring];
        add r14, rax;

        // sta_rsv (u8 @+12) & STA.DD (bit 0)
        xor rax, rax;
        mov_b rax, [r14 + 12];
        and rax, 1;
        cmp rax, 0;
        je e1kih_tx_break;

        // Clear STA byte so slot is reusable.
        xor rax, rax;
        mov_b [r14 + 12], rax;

        add r13, 1;
        and r13, 127;
        jmp e1kih_tx_loop;

      e1kih_tx_break:
        mov [rip + _e1000e_tx_head], r13;

      e1kih_after_tx:
        // ============================================================
        // (5) LSC cause: bit 2.
        // ============================================================
        mov rax, rbp;
        and rax, 4;
        cmp rax, 0;
        je e1kih_done;

        // Read STATUS, isolate LU (bit 1).
        mov rdi, rbx;
        mov rsi, 0x08;                           // E1000E_REG_STATUS
        call e1000e_reg_u32;

        and rax, 2;                              // LU bit

        // "E1000E LINK n=<lu>"
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_E1KE];
        lea rdx, [rip + tag_e1000e_link];
        lea rcx, [rip + k_n];
        mov r8, rax;
        call klog_s1_d1;

      e1kih_done:
        // (6) Return this-IRQ RX count.
        mov rax, r12;

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
