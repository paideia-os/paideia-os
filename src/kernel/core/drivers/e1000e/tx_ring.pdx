// src/kernel/core/drivers/e1000e/tx_ring.pdx — R27-M2-003 (#978)
//
// Intel e1000e / i219 legacy Transmit descriptor ring.
//
// -----------------------------------------------------------------------------
// Legacy TX descriptor layout (82574 §7.2.5, 16 B total)
// -----------------------------------------------------------------------------
//
//   +0    u64  buffer_addr      // physical address of the frame buffer
//   +8    u16  length           // byte length of this fragment
//   +10   u8   cso              // checksum-offload start byte
//   +11   u8   cmd
//                bit 0  EOP   — End of Packet
//                bit 1  IFCS  — Insert FCS (hardware appends 4-B FCS)
//                bit 2  IC    — Insert Checksum (offload)
//                bit 3  RS    — Report Status (HW writes back STA.DD)
//                bit 4  RPS   — Report Packet Sent (82544-legacy)
//                bit 5  DEXT  — Descriptor Extension (0 = legacy)
//                bit 6  VLE   — VLAN Enable
//                bit 7  IDE   — Interrupt Delay Enable
//   +12   u8   sta_rsv         // low nibble = STA (DD/EC/LC/reserved),
//                              // high nibble = reserved
//   +13   u8   css             // checksum-offload start position
//   +14   u16  special         // 802.1Q VLAN tag + PRI
//
// -----------------------------------------------------------------------------
// Ring shape
// -----------------------------------------------------------------------------
//
// 128 descriptors × 16 B = 2048 B. Symmetric with the RX ring so the
// same 4 KiB-aligned .bss substrate applies. TDLEN must be a multiple
// of 128 per 82574 §13.4.35 — 2048 = 16 * 128, conformant.
//
// -----------------------------------------------------------------------------
// Head/tail semantics (mirror of RX with roles swapped)
// -----------------------------------------------------------------------------
//
//   TDBAL   (0x3800)  = ring_pa & 0xFFFFFFFF
//   TDBAH   (0x3804)  = ring_pa >> 32
//   TDLEN   (0x3808)  = 2048
//   TDH     (0x3810)  = 0        (HW-managed cursor of next descriptor
//                                  the controller will transmit)
//   TDT     (0x3818)  = 0        (SW-owned; advanced on send-request)
//
// SW owns [TDH, TDT); HW owns [TDT, TDH). TDH == TDT means the ring
// is empty (all frames drained). The initial (TDH=TDT=0) empty state
// is the correct M2 posture — real transmit lands at R27.M4 when the
// send path grows an SKB substrate.
//
// -----------------------------------------------------------------------------
// R27.M2 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// e1000e_tx_ring_init is a callable symbol at M2 but is NOT wired
// into kernel_main.pdx. R27.M3 driver-attach calls it after
// e1000e_rx_ring_init + e1000e_rx_refill and before RCTL.EN /
// TCTL.EN are asserted.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: u32 MMIO writes route via e1000e_reg_write_u32.
//
// Reserved-label discipline: labels prefixed `e1ktx_`.

module TxRing = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let E1000E_TX_RING_DESCS      : u64 = 128
  pub let E1000E_TX_DESC_SIZE       : u64 = 16
  pub let E1000E_TX_RING_BYTES      : u64 = 2048        // 128 * 16

  // TX descriptor CMD-byte bits (byte @+11).
  pub let E1000E_TXD_CMD_EOP        : u64 = 0x01        // End of Packet
  pub let E1000E_TXD_CMD_IFCS       : u64 = 0x02        // Insert FCS
  pub let E1000E_TXD_CMD_IC         : u64 = 0x04        // Insert Checksum
  pub let E1000E_TXD_CMD_RS         : u64 = 0x08        // Report Status
  pub let E1000E_TXD_CMD_RPS        : u64 = 0x10
  pub let E1000E_TXD_CMD_DEXT       : u64 = 0x20        // 0 = legacy descriptor
  pub let E1000E_TXD_CMD_VLE        : u64 = 0x40
  pub let E1000E_TXD_CMD_IDE        : u64 = 0x80

  // TX descriptor STA-nibble bits (low 4 bits of byte @+12).
  pub let E1000E_TXD_STA_DD         : u64 = 0x01        // Descriptor Done

  // ============================================================================
  // Canonical .bss slots
  // ============================================================================
  //
  //   _e1000e_tx_ring   : 256 x u64 = 2048 B (128 descriptors x 16 B)
  //   _e1000e_tx_tail   : driver-side TDT shadow (0..127)
  //   _e1000e_tx_head   : driver-side "next-to-clean" cursor (0..127) —
  //                       IRQ path advances this as it observes STA.DD.

  pub let mut _e1000e_tx_ring       : [u64; 256] = uninit @align(4096)
  pub let mut _e1000e_tx_tail       : u64        = 0
  pub let mut _e1000e_tx_head       : u64        = 0

  // ============================================================================
  // e1000e_tx_ring_init(bar0, ring_pa) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64, ring_pa: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = physical address of the 2048-byte TX descriptor ring
  //
  // Body:
  //   (1) rep_stosb-zero the 2048-byte ring at ring_pa.
  //   (2) Program TDBAL / TDBAH / TDLEN.
  //   (3) Program TDH = 0, TDT = 0 (empty).
  //   (4) Zero the driver-side shadow cursors.
  //
  // Register plan (2-push callee-save):
  //   rbx = bar0
  //   rbp = ring_pa
  //
  //   2 pushes = 16 B; entry rsp%16==8 -> 24, sub rsp,8 -> 32, %16==0
  //   (aligned for every nested e1000e_reg_write_u32).

  pub let e1000e_tx_ring_init : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, ring_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M2-003 (#978). Program the e1000e Transmit-Descriptor-Ring base/length registers and zero the 2048-byte descriptor block. Body: (1) 2-push callee-save prologue (rbx=bar0, rbp=ring_pa) + `sub rsp,8` — 16 + 8 = 24; entry rsp%16==8 -> 32, %16==0 (aligned for every nested e1000e_reg_write_u32). (2) rep_stosb-zero 2048 bytes at ring_pa: rdi=ring_pa, rcx=2048, rax=0, cld, rep_stosb. Fresh-zero descriptors have STA.DD=0, so if the caller re-inits a warm ring the HW will not observe stale DD bits on its next scan of the ring. (3) TDBAL = ring_pa & 0xFFFFFFFF via e1000e_reg_write_u32(bar0, 0x3800, ring_pa_lo). (4) TDBAH = ring_pa >> 32 via e1000e_reg_write_u32(bar0, 0x3804, ring_pa_hi) — hi via `mov rax, rbp; shr rax, 32`. (5) TDLEN = 2048 via e1000e_reg_write_u32(bar0, 0x3808, 2048). Byte count, multiple of 128 per 82574 §13.4.35. (6) TDH = 0 via e1000e_reg_write_u32(bar0, 0x3810, 0). (7) TDT = 0 via e1000e_reg_write_u32(bar0, 0x3818, 0). Ring starts empty; send path advances TDT. (8) Reset driver-side shadow cursors: `_e1000e_tx_tail = _e1000e_tx_head = 0` via two u64 stores. (9) Fingerprint klog_s1(INFO, E1KE, tag_e1000e_tx_ring). Reserved labels: `e1ktx_`. Every nested callee preserves rbx/rbp per SysV.",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = ring_pa

        // ============================================================
        // (2) Zero the 2048-byte descriptor ring.
        // ============================================================
        mov rdi, rbp;
        xor rax, rax;
        mov rcx, 2048;
        cld;
        rep_stosb;

        // ============================================================
        // (3) TDBAL = ring_pa & 0xFFFFFFFF.
        // ============================================================
        mov rdi, rbx;
        mov rsi, 0x3800;                         // E1000E_REG_TDBAL
        mov rdx, rbp;
        call e1000e_reg_write_u32;

        // ============================================================
        // (4) TDBAH = ring_pa >> 32.
        // ============================================================
        mov rax, rbp;
        shr rax, 32;
        mov rdi, rbx;
        mov rsi, 0x3804;                         // E1000E_REG_TDBAH
        mov rdx, rax;
        call e1000e_reg_write_u32;

        // ============================================================
        // (5) TDLEN = 2048.
        // ============================================================
        mov rdi, rbx;
        mov rsi, 0x3808;                         // E1000E_REG_TDLEN
        mov rdx, 2048;
        call e1000e_reg_write_u32;

        // ============================================================
        // (6) TDH = 0.
        // ============================================================
        mov rdi, rbx;
        mov rsi, 0x3810;                         // E1000E_REG_TDH
        xor rdx, rdx;
        call e1000e_reg_write_u32;

        // ============================================================
        // (7) TDT = 0.
        // ============================================================
        mov rdi, rbx;
        mov rsi, 0x3818;                         // E1000E_REG_TDT
        xor rdx, rdx;
        call e1000e_reg_write_u32;

        // ============================================================
        // (8) Reset driver-side shadow cursors.
        // ============================================================
        xor rax, rax;
        mov [rip + _e1000e_tx_tail], rax;
        mov [rip + _e1000e_tx_head], rax;

        // ============================================================
        // (9) Fingerprint.
        // ============================================================
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_E1KE];
        lea rdx, [rip + tag_e1000e_tx_ring];
        call klog_s1;

        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
