// src/kernel/core/drivers/e1000e/mac.pdx — R27-M1-004 (#974)
//
// Intel e1000e / i219 MAC address read from EEPROM / OTP + MAC-filter
// Receive-Address-Register (RAR) programming.
//
// -----------------------------------------------------------------------------
// EEPROM word layout on i217+/i218/i219 silicon (§10.2.3 / §6.1.2)
// -----------------------------------------------------------------------------
//
// The NIC's factory-programmed MAC address lives in the first three
// u16 words of the SPI EEPROM (i217+) or the on-die OTP array (i219,
// which does not require a physical SPI part but presents the same
// EEPROM read window through EERD).
//
//   word 0  = MAC bytes 0, 1   (little-endian: byte0 in low u8, byte1 in high u8)
//   word 1  = MAC bytes 2, 3
//   word 2  = MAC bytes 4, 5
//
// -----------------------------------------------------------------------------
// RAR (Receive Address Register) programming (§10.2.7.4)
// -----------------------------------------------------------------------------
//
// The RAR table holds up to 16 unicast MAC-filter entries. Entry 0
// (index 0) is the NIC's own primary MAC — this is what the
// receive-hardware compares against the incoming Ethernet destination
// address to admit frames destined for us. Entries 1..15 are
// available for additional filters (VLAN aliases, multicast, etc.).
//
// Each entry is 8 bytes:
//   RAL[idx] = bar0 + 0x5400 + idx*8   u32   MAC bytes 0..3 (little-endian u32)
//   RAH[idx] = bar0 + 0x5404 + idx*8   u32
//                bits [15:0]  MAC bytes 4, 5 (little-endian u16)
//                bits [17:16] ASEL — 00 = destination address match
//                bit    31    AV — Address Valid (must be set to enable)
//
// -----------------------------------------------------------------------------
// R27.M1 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// Both fns are callable at M1 but are NOT wired into kernel_main.
// R27.M2 driver-attach calls e1000e_read_mac(bar0, &_e1000e_devices[i].mac)
// after e1000e_reset succeeds, then e1000e_program_rar(bar0, 0, mac)
// before enabling the receiver (RCTL.EN).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: byte MAC stores use `mov_b [ptr], reg`.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `e1km_`.

module Mac = structure {

  // ============================================================================
  // EEPROM timeout budget
  // ============================================================================
  //
  // A single EEPROM read typically completes in a few hundred
  // microseconds on real i219 silicon (SPI clock ~1 MHz, 32 bits
  // transferred). QEMU responds in a single MMIO round-trip. A
  // 200_000 iteration spin (~6 ms wall-time) is ~10x margin over
  // the slowest hardware pathway. R27.M2 will replace this with a
  // tsc-derived deadline.

  pub let E1000E_EEPROM_SPIN_MAX   : u64 = 200000

  pub let E1000E_EEPROM_OK         : u64 = 0
  pub let E1000E_EEPROM_ERR_TIMEO  : u64 = 1

  // ============================================================================
  // e1000e_eeprom_read(bar0, word_addr) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, word_addr: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = EEPROM word address (0..16383)
  //
  // Returns rax = 16-bit EEPROM data (bits 0..15 of return value)
  // on success. On timeout returns 0xFFFF_FFFF_FFFF_FFFF (all-ones,
  // distinguishable from any legitimate 16-bit value at the u64
  // callsite by the upper-32-bit high pattern).
  //
  // Register plan (3-push callee-save):
  //   rbx = bar0
  //   r12 = spin counter
  //   r13 = eerd value staging

  pub let e1000e_eeprom_read : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, word_addr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M1-004 (#974). EEPROM / OTP word read via the EERD MMIO window. Body: (1) 3-push callee-save (rbx=bar0, r12=spin, r13=eerd) — 24 B; entry rsp%16==8 → 24+8=32, %16==0 (aligned for every nested e1000e_reg_* call without pre-align pad). rbx = bar0; stash word_addr in r13 momentarily. (2) Compose EERD: r13 = word_addr; shl r13, 2 (E1000E_EERD_ADDR_SHIFT = 2 — spec §10.2.3.2 places ADDR at bits [15:2]); or r13, 1 (START bit 0). (3) Write EERD via e1000e_reg_write_u32(bar0, 0x14, r13). (4) Poll EERD.DONE (bit 1 = 0x02): init r12 = E1000E_EEPROM_SPIN_MAX. Loop { rax = e1000e_reg_u32(bar0, 0x14); test bit 1; if set → break; dec r12; if r12 == 0 → return 0xFFFFFFFFFFFFFFFF }. (5) Extract DATA (bits [31:16]) via `shr rax, 16` — leaves the u16 result in rax bits [15:0], upper bits zero (SDM Vol 2A §3.4.1.1 already zero-extended the 32-bit load). (6) Return rax. Reserved-label posture: labels prefixed `e1km_`. Every e1000e_reg_* callee preserves rbx/r12/r13 per SysV.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                            // rbx = bar0

        // (2) Compose EERD = (word_addr << 2) | START.
        mov r13, rsi;
        shl r13, 2;                              // ADDR at bits [15:2]
        or r13, 1;                               // START bit 0

        // (3) Write EERD.
        mov rdi, rbx;
        mov rsi, 0x14;                           // E1000E_REG_EERD
        mov rdx, r13;
        call e1000e_reg_write_u32;

        // (4) Poll EERD.DONE (bit 1).
        mov r12, 200000;                         // E1000E_EEPROM_SPIN_MAX

      e1km_wait_done:
        mov rdi, rbx;
        mov rsi, 0x14;                           // EERD
        call e1000e_reg_u32;

        mov r13, rax;
        and r13, 2;                              // isolate DONE
        cmp r13, 0;
        jne e1km_done_ok;                        // DONE set

        sub r12, 1;
        cmp r12, 0;
        je e1km_done_err;
        jmp e1km_wait_done;

      e1km_done_ok:
        // (5) Extract DATA bits [31:16] into rax bits [15:0].
        shr rax, 16;
        jmp e1km_ret;

      e1km_done_err:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      e1km_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // e1000e_read_mac(bar0, out_mac) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64, out_mac: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = pointer to 6-byte destination buffer
  //
  // Reads EEPROM words 0, 1, 2 and writes the six MAC bytes to
  // out_mac[0..5] in wire order (byte 0 = OUI[0], byte 5 = NIC-suffix
  // low byte).
  //
  // Register plan (4-push callee-save + scratch slot):
  //   rbx = bar0
  //   r12 = out_mac pointer
  //   r13 = per-word eeprom result (u16 in low bits)
  //   r14 = scratch (byte extract)
  //
  //   4 pushes = 32 B; entry rsp%16==8 → 32+8=40, %16==8. Add sub
  //   rsp,8 to align for the nested e1000e_eeprom_read calls → 48,
  //   %16==0.

  pub let e1000e_read_mac : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, out_mac: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M1-004 (#974). Read the six MAC bytes from EEPROM/OTP words 0/1/2 into a caller-provided 6-byte buffer. Body: (1) 4-push callee-save (rbx=bar0, r12=out_ptr, r13=word, r14=scratch) — 32 B + sub rsp,8 → 40 B; entry rsp%16==8 → 48, %16==0 (aligned for every nested e1000e_eeprom_read call without extra pad). (2) Word 0: rax = e1000e_eeprom_read(bar0, 0); r13 = rax; mov_b [r12+0], r13 (low byte = MAC byte 0); shr r13, 8; mov_b [r12+1], r13 (high byte = MAC byte 1). (3) Word 1: same shape into [r12+2] / [r12+3]. (4) Word 2: same shape into [r12+4] / [r12+5]. (5) Emit fingerprint klog_s1_x1_d1(INFO, E1KE, tag_e1000e_mac, k_mac_lo, mac_lo_u32, k_mac_hi, mac_hi_u16) — mac_lo is bytes[3..0] packed as u32 little-endian (already the raw word0|word1 concatenation), mac_hi is word2. Actually simpler at M1: only emit klog_s1(INFO, E1KE, tag_e1000e_mac) — the MAC bytes are visible in the record and the extra KV formatting adds nothing at boot when the fn is dormant. Return. Reserved-label posture: labels prefixed `e1km_` (shared with eeprom_read module; label linkage is scoped per fn). Every e1000e_eeprom_read callee preserves rbx/r12/r13/r14 per SysV — out_ptr survives across all three EEPROM reads.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;                              // align for nested calls

        mov rbx, rdi;                            // rbx = bar0
        mov r12, rsi;                            // r12 = out_mac

        // Word 0 -> bytes 0, 1
        mov rdi, rbx;
        mov rsi, 0;
        call e1000e_eeprom_read;
        mov r13, rax;
        mov_b [r12 + 0], r13;                    // MAC[0] = word0 & 0xFF
        shr r13, 8;
        mov_b [r12 + 1], r13;                    // MAC[1] = word0 >> 8

        // Word 1 -> bytes 2, 3
        mov rdi, rbx;
        mov rsi, 1;
        call e1000e_eeprom_read;
        mov r13, rax;
        mov_b [r12 + 2], r13;
        shr r13, 8;
        mov_b [r12 + 3], r13;

        // Word 2 -> bytes 4, 5
        mov rdi, rbx;
        mov rsi, 2;
        call e1000e_eeprom_read;
        mov r13, rax;
        mov_b [r12 + 4], r13;
        shr r13, 8;
        mov_b [r12 + 5], r13;

        // Fingerprint — bare "E1000E MAC" line at M1 (byte-level values
        // in the caller record are already accessible; KV formatting
        // for a 6-byte value adds no boot signal when the fn is
        // dormant).
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_E1KE];
        lea rdx, [rip + tag_e1000e_mac];
        call klog_s1;

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // e1000e_program_rar(bar0, index, mac) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64, index: u64, mac: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = RAR entry index (0..15)
  //   rdx = pointer to 6-byte MAC buffer
  //
  // Writes:
  //   RAL[index] (u32) = mac[0..3] as little-endian u32
  //   RAH[index] (u32) = mac[4..5] as u16 | AV(bit 31)
  //
  // Register plan (4-push callee-save):
  //   rbx = bar0
  //   r12 = index
  //   r13 = mac_ptr
  //   r14 = staged u32 value (RAL then RAH)
  //
  //   4 pushes = 32 B; entry rsp%16==8 → 40, %16==8. Add sub rsp,8
  //   to align for nested e1000e_reg_write_u32 → 48, %16==0.

  pub let e1000e_program_rar : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, index: u64, mac: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R27-M1-004 (#974). Program a RAR (Receive Address Register) entry with a 6-byte MAC, setting AV. Body: (1) 4-push callee-save (rbx=bar0, r12=index, r13=mac_ptr, r14=staged) — 32 B + sub rsp,8 = 40; entry rsp%16==8 → 48, %16==0 (aligned for nested e1000e_reg_write_u32). (2) Compose RAL = mac[0] | (mac[1]<<8) | (mac[2]<<16) | (mac[3]<<24). All shifts are on r14 via `shl r14, N; or r14, byte` using a temporary rax for each byte load: xor rax,rax; mov_b rax,[r13+N]; shl rax, (N*8); or r14, rax. (3) Compute RAL MMIO offset: E1000E_REG_RAL_BASE + index * 8. rsi = 0x5400 + (r12 << 3). Write via e1000e_reg_write_u32(bar0, offset, r14). (4) Compose RAH = mac[4] | (mac[5]<<8) | AV(0x80000000). Reuse r14. (5) Compute RAH offset: 0x5404 + (r12 << 3). Write via e1000e_reg_write_u32. Reserved-label posture: labels prefixed `e1km_`. Every e1000e_reg_write_u32 callee preserves rbx/r12/r13/r14 per SysV.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                            // rbx = bar0
        mov r12, rsi;                            // r12 = index
        mov r13, rdx;                            // r13 = mac_ptr

        // ============================================================
        // Compose RAL = mac[0] | (mac[1]<<8) | (mac[2]<<16) | (mac[3]<<24)
        // ============================================================
        xor r14, r14;

        // MAC[0]
        xor rax, rax;
        mov_b rax, [r13 + 0];
        or r14, rax;

        // MAC[1] << 8
        xor rax, rax;
        mov_b rax, [r13 + 1];
        shl rax, 8;
        or r14, rax;

        // MAC[2] << 16
        xor rax, rax;
        mov_b rax, [r13 + 2];
        shl rax, 16;
        or r14, rax;

        // MAC[3] << 24
        xor rax, rax;
        mov_b rax, [r13 + 3];
        shl rax, 24;
        or r14, rax;

        // Write RAL[index] = r14. Offset = 0x5400 + index*8.
        mov rdi, rbx;
        mov rsi, r12;
        shl rsi, 3;
        add rsi, 0x5400;                         // E1000E_REG_RAL_BASE
        mov rdx, r14;
        call e1000e_reg_write_u32;

        // ============================================================
        // Compose RAH = mac[4] | (mac[5]<<8) | AV(0x80000000)
        // ============================================================
        xor r14, r14;

        // MAC[4]
        xor rax, rax;
        mov_b rax, [r13 + 4];
        or r14, rax;

        // MAC[5] << 8
        xor rax, rax;
        mov_b rax, [r13 + 5];
        shl rax, 8;
        or r14, rax;

        // AV (bit 31)
        or r14, 0x80000000;

        // Write RAH[index] = r14. Offset = 0x5404 + index*8.
        mov rdi, rbx;
        mov rsi, r12;
        shl rsi, 3;
        add rsi, 0x5404;                         // E1000E_REG_RAH_BASE
        mov rdx, r14;
        call e1000e_reg_write_u32;

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
