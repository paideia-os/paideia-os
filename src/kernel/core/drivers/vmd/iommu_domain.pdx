// src/kernel/core/drivers/vmd/iommu_domain.pdx — R47.M4-001 (#1421)
//
// Per-endpoint IOMMU domain under VMD.  Every KIND_VMD_ENDPOINT
// receives its OWN IOMMU domain id so DMA reach originating from
// endpoint E cannot alias the memory reach any other endpoint holds.
// The domain id here is the R29 KIND_DMA_DOMAIN row this endpoint
// binds to; this module holds only the (endpoint_row -> dma_domain_id)
// ownership table so the granularity invariant "one endpoint, one
// domain" is enforced structurally.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the OWNERSHIP LEDGER.  It does NOT program IOMMU context
// entries (that lives in the R22 VT-d substrate + R29 dma_domain
// mint), does NOT allocate DMA pages, and does NOT flush the IOTLB.
// It records ONE domain per endpoint so the R29.M5 cascade -- which
// revokes an endpoint's DMA reach when the endpoint is revoked --
// has a unique domain to walk.
//
// vmd_iommu_domain_arbitrated returns 0 until a live VT-d driver
// binds this ledger to real IOMMU context programming.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_iommu_owners + _vmd_iommu_stats are written only by helpers
// in this module.  tools/build.sh confines relocations against each
// symbol to `core/drivers/vmd/iommu_domain.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFDD0..0xFFFFFDD4 (SHARED BAND; iommu_switch =
//    D5..D9; iommu_adversarial = DA..DF).
// =============================================================================

module VmdIommuDomain = structure {

  pub let VMD_IOMMU_MAX_DOMAINS : u64 = 16

  pub let VMD_IOMMU_OK              : u64 = 0
  pub let VMD_IOMMU_BAD_ARG         : u64 = 0xFFFFFDD4
  pub let VMD_IOMMU_BAD_ENDPOINT    : u64 = 0xFFFFFDD3
  pub let VMD_IOMMU_TABLE_FULL      : u64 = 0xFFFFFDD2
  pub let VMD_IOMMU_ALREADY_ASSIGNED: u64 = 0xFFFFFDD1
  pub let VMD_IOMMU_NOT_ASSIGNED    : u64 = 0xFFFFFDD0

  // Row: 16 bytes -- {endpoint_row[15:0] | dma_domain_id[47:16] | in_use[63:56], reserved}.
  pub let mut _vmd_iommu_owners : [u64; 32] = uninit @align(64)
  pub let mut _vmd_iommu_stats  : [u64; 4]  = uninit @align(64)

  pub let VMD_IOMMU_ST_ASSIGNS  : u64 = 0
  pub let VMD_IOMMU_ST_RELEASES : u64 = 1
  pub let VMD_IOMMU_ST_REJECTS  : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_iommu_domain_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-001 (#1421): clear owners + stats. Labels prefixed vid_rs_.",
      block: {
        lea r10, [rip + _vmd_iommu_owners];
        xor rax, rax;
        xor rcx, rcx;
      vid_rs_ow:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  vid_rs_ow;

        lea r10, [rip + _vmd_iommu_stats];
        xor rcx, rcx;
      vid_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vid_rs_st;
        ret
      }
    }

  pub let vmd_iommu_domain_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M4-001 (#1421): honesty pin.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_iommu_domain_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-001 (#1421): counter read.",
      block: {
        cmp rdi, 4;
        jae vid_st_zero;
        lea r10, [rip + _vmd_iommu_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vid_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_iommu_domain_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-001 (#1421): counter bump. Labels prefixed vid_nt_.",
      block: {
        cmp rdi, 4;
        jae vid_nt_out;
        lea r10, [rip + _vmd_iommu_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vid_nt_out:
        ret
      }
    }

  // ==========================================================================
  // vmd_iommu_assign(endpoint_row, dma_domain_id) -> 0 / err
  //
  // Refuses if endpoint already has a domain (ALREADY_ASSIGNED).
  // ==========================================================================

  pub let vmd_iommu_assign : (u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) (dma_domain_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-001 (#1421): assign one dma_domain to endpoint_row. Refuses double-assignment structurally.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        mov r10, 0xFFFF;
        cmp rbx, r10;
        ja  vid_as_bad_ep;

        // Duplicate scan.
        xor rcx, rcx;
      vid_as_scan:
        cmp rcx, 16;
        jae vid_as_alloc;
        lea r10, [rip + _vmd_iommu_owners];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vid_as_next;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, rbx;
        je  vid_as_already;
      vid_as_next:
        add rcx, 1;
        jmp vid_as_scan;

      vid_as_alloc:
        xor rcx, rcx;
      vid_as_alloc_scan:
        cmp rcx, 16;
        jae vid_as_full;
        lea r10, [rip + _vmd_iommu_owners];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vid_as_claim;
        add rcx, 1;
        jmp vid_as_alloc_scan;

      vid_as_claim:
        mov rax, rbx;
        and rax, 0xFFFF;
        mov r11, r12;
        and r11, 0xFFFFFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;
        mov [r10 + 8], rax;

        mov rdi, 0;
        call vmd_iommu_domain_note;
        xor rax, rax;
        jmp vid_as_out;

      vid_as_bad_ep:
        mov rdi, 2;
        call vmd_iommu_domain_note;
        mov rax, 0xFFFFFDD3;
        jmp vid_as_out;
      vid_as_full:
        mov rdi, 2;
        call vmd_iommu_domain_note;
        mov rax, 0xFFFFFDD2;
        jmp vid_as_out;
      vid_as_already:
        mov rdi, 2;
        call vmd_iommu_domain_note;
        mov rax, 0xFFFFFDD1;

      vid_as_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // vmd_iommu_lookup(endpoint_row) -> dma_domain_id / NOT_ASSIGNED
  pub let vmd_iommu_lookup : (u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-001 (#1421): dma_domain for endpoint_row.",
      block: {
        push rbx;
        mov rbx, rdi;
        xor rcx, rcx;
      vid_lk_scan:
        cmp rcx, 16;
        jae vid_lk_none;
        lea r10, [rip + _vmd_iommu_owners];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vid_lk_next;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, rbx;
        je  vid_lk_hit;
      vid_lk_next:
        add rcx, 1;
        jmp vid_lk_scan;
      vid_lk_hit:
        shr rax, 16;
        and rax, 0xFFFFFFFF;
        pop rbx;
        ret;
      vid_lk_none:
        mov rax, 0xFFFFFDD0;
        pop rbx;
        ret
      }
    }
}
