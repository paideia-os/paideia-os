// src/kernel/core/drivers/vmd/hotplug.pdx — R47.M2-003 (#1417)
//
// Intel VMD hot-plug support: sequences the attach and detach of a
// child endpoint under a VMD virtual root complex.  Attach records a
// new endpoint in the enumeration table; detach transitions the
// KIND_VMD_ENDPOINT row through DETACHED and clears any live
// MSI-X translations for it.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the STATE-MACHINE half of hot-plug bookkeeping.  It does NOT
// probe the VMD hotplug slot register (that lives above, in a live
// MSI-X source), does NOT quiesce driver rings on its own (that is
// the driver's release path), and does NOT revoke the KIND_VMD_ENDPOINT
// capability -- it drives the state transition so a cap revoke and
// the driver's release path stay in agreement.
//
// vmd_hotplug_arbitrated returns 0 until the seam is wired to a
// live VMD hotplug event source.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_hotplug_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/vmd/hotplug.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFD70..0xFFFFFD77 (SHARED BAND -- second half
//    of the band belongs to vmd_config_channel schema below).
// =============================================================================

module VmdHotplug = structure {

  pub let VMD_HP_EV_ATTACH : u64 = 1
  pub let VMD_HP_EV_DETACH : u64 = 2

  pub let VMD_HP_OK              : u64 = 0
  pub let VMD_HP_BAD_ARG         : u64 = 0xFFFFFD77
  pub let VMD_HP_BAD_EVENT       : u64 = 0xFFFFFD76
  pub let VMD_HP_BAD_ENDPOINT    : u64 = 0xFFFFFD75
  pub let VMD_HP_BAD_STATE       : u64 = 0xFFFFFD74
  pub let VMD_HP_ATTACH_REFUSED  : u64 = 0xFFFFFD73
  pub let VMD_HP_DETACH_REFUSED  : u64 = 0xFFFFFD72

  pub let mut _vmd_hotplug_stats : [u64; 4] = uninit @align(64)
  pub let VMD_HP_ST_ATTACHES : u64 = 0
  pub let VMD_HP_ST_DETACHES : u64 = 1
  pub let VMD_HP_ST_REJECTS  : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_hotplug_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-003 (#1417): clear stats. Labels prefixed vhp_rs_.",
      block: {
        lea r10, [rip + _vmd_hotplug_stats];
        xor rax, rax;
        xor rcx, rcx;
      vhp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vhp_rs_loop;
        ret
      }
    }

  pub let vmd_hotplug_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M2-003 (#1417): honesty pin. Returns 0 until wired to a live VMD hotplug interrupt source.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_hotplug_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-003 (#1417): counter read.",
      block: {
        cmp rdi, 4;
        jae vhp_st_zero;
        lea r10, [rip + _vmd_hotplug_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vhp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_hotplug_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-003 (#1417): counter bump. Labels prefixed vhp_nt_.",
      block: {
        cmp rdi, 4;
        jae vhp_nt_out;
        lea r10, [rip + _vmd_hotplug_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vhp_nt_out:
        ret
      }
    }

  pub let vmd_hotplug_event_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M2-003 (#1417): 1 iff ev in {ATTACH, DETACH}. Labels prefixed vhp_ev_.",
      block: {
        cmp rdi, 1;
        je  vhp_ev_yes;
        cmp rdi, 2;
        je  vhp_ev_yes;
        xor rax, rax;
        ret;
      vhp_ev_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // vmd_hotplug_sequence(endpoint_row, event) -> 0 / err
  //
  // ATTACH: transitions the KIND_VMD_ENDPOINT row from DETACHED (3)
  //         back to ATTACHED (0), or leaves an already-ATTACHED row
  //         unchanged (idempotent for re-plug races).
  // DETACH: transitions the row from any state to DETACHED (3).
  //
  // The cap-side revoke is a SEPARATE step the consumer takes.  This
  // module owns only the state stamp so a detach and a revoke cannot
  // race in a way that leaves a still-ATTACHED row with no cap.
  // ==========================================================================

  pub let vmd_hotplug_sequence : (u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) (event: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-003 (#1417): drive one hotplug transition. Labels prefixed vhp_sq_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, r12;
        call vmd_hotplug_event_valid;
        cmp rax, 0;
        je  vhp_sq_bad_ev;

        // event=ATTACH => new_state=0; event=DETACH => new_state=3.
        cmp r12, 1;
        je  vhp_sq_attach;
        // detach path:
        mov rdi, rbx;
        mov rsi, 3;
        call kve_row_transition;
        cmp rax, 0;
        jne vhp_sq_detach_refused;
        mov rdi, 1;
        call vmd_hotplug_note;
        xor rax, rax;
        jmp vhp_sq_out;

      vhp_sq_attach:
        // Read current state; if already ATTACHED (0) the transition
        // is a no-op success (idempotent).
        mov rdi, rbx;
        call kve_row_state;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  vhp_sq_bad_ep;
        cmp rax, 0;
        je  vhp_sq_already_attached;
        mov rdi, rbx;
        mov rsi, 0;                      // ATTACHED
        call kve_row_transition;
        cmp rax, 0;
        jne vhp_sq_attach_refused;
      vhp_sq_already_attached:
        mov rdi, 0;
        call vmd_hotplug_note;
        xor rax, rax;
        jmp vhp_sq_out;

      vhp_sq_bad_ev:
        mov rdi, 2;
        call vmd_hotplug_note;
        mov rax, 0xFFFFFD76;
        jmp vhp_sq_out;
      vhp_sq_bad_ep:
        mov rdi, 2;
        call vmd_hotplug_note;
        mov rax, 0xFFFFFD75;
        jmp vhp_sq_out;
      vhp_sq_attach_refused:
        mov rdi, 2;
        call vmd_hotplug_note;
        mov rax, 0xFFFFFD73;
        jmp vhp_sq_out;
      vhp_sq_detach_refused:
        mov rdi, 2;
        call vmd_hotplug_note;
        mov rax, 0xFFFFFD72;

      vhp_sq_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
