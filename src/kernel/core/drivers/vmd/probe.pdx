// src/kernel/core/drivers/vmd/probe.pdx — R47.M1-001 (#1412)
//
// Intel VMD (Volume Management Device) PCIe probe + BAR mapping
// scaffold.  Recognises the Intel VMD PCI class code (0x01 0x04 0x00
// -- Mass Storage / RAID / VMD prog-if), filters candidates by vendor
// (Intel 0x8086), and decodes the VMD capability window into a
// virtual root-complex config-space aperture + MSI-X translation
// window through a synthetic seam.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNISE + RECORD half of a VMD bring-up.  A PCIe
// function whose class/subclass/prog-if triple is (0x01, 0x04, 0x00)
// AND whose vendor is 0x8086 (Intel) is a VMD controller; this
// scaffold's job is to match that shape, distill the vendor/device
// pair the enumerator saw, and stash the two VMD capability values a
// later round consults when it wires the virtual root-complex.
//
// IT DOES NOT TOUCH REAL MMIO.  The VMD capability register (member
// count at VMD_CAP_0[7:0], config offset at VMD_CAP_0[31:8]) is read
// through a seam whose default backing is caller-supplied register
// snapshots.  A later round wires that seam to the BAR0 window.
//
// IT DOES NOT DERIVE A KIND_OP_REGION.  That is the mint gate the
// bring-up path takes once the BARs are measured through a live
// memory authority; this scaffold records the EXTENT so that mint can
// containment-check its request without asking the firmware again.
//
// vmd_probe_arbitrated() returns 0 until that binding lands.
//
// =============================================================================
// §1  PCI CLASSIFICATION (Intel VMD spec)
// =============================================================================
//
//   base class 0x01  Mass Storage Controller
//   subclass  0x04  RAID Controller
//   prog if   0x00  (VMD-specific; distinguished by vendor+device id)
//
// Vendor filter: 0x8086 (Intel) -- VMD is Intel-only silicon at this
// milestone.  Accepted device ids include Skylake-SP (0x201D),
// Ice Lake-SP (0x28C0), Sapphire Rapids (0x09AB) and Raptor Lake
// (0xA77F), but the probe does not hard-code them: the vendor gate is
// sufficient; per-device quirks land in vmd_endpoint_enum.
//
// BAR0 alignment: 2 MiB is the Intel-mandated minimum for a VMD
// config-space window (Intel VMD spec §3.1).  The probe refuses a
// BAR whose masked base is not 2 MiB aligned as MISALIGNED rather
// than clipping it.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_probe_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/vmd/probe.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFBD0..0xFFFFFBDF
// =============================================================================

module VmdProbe = structure {

  // PCI classification (§1).
  pub let PCI_CLASS_MASS_STORAGE : u64 = 0x01
  pub let PCI_SUBCLASS_RAID      : u64 = 0x04
  pub let PCI_PROGIF_VMD         : u64 = 0x00

  // Class triple packed as (class << 16) | (subclass << 8) | progif.
  pub let PCI_CLASS_TRIPLE_VMD : u64 = 0x010400

  // Accepted vendor set.
  pub let VMD_VENDOR_INTEL : u64 = 0x8086

  // Alignment (§1).
  pub let VMD_BAR_ALIGN_LOG2 : u64 = 21         // 2 MiB
  pub let VMD_BAR_ALIGN_MASK : u64 = 0x1FFFFF

  // VMD capability layout (Intel VMD spec §3.1).
  pub let VMD_CAP0_MEMBER_MASK  : u64 = 0x000000FF
  pub let VMD_CAP0_CFGOFF_MASK  : u64 = 0xFFFFFF00
  pub let VMD_CAP0_CFGOFF_SHIFT : u64 = 8

  // BAR extent minimum (2 MiB).
  pub let VMD_BAR_MIN_LEN : u64 = 0x200000

  // Failure taxonomy -- 0xFFFFFBD0..0xFFFFFBDF.
  pub let VMD_PROBE_OK          : u64 = 0
  pub let VMD_PROBE_BAD_ARG     : u64 = 0xFFFFFBDF
  pub let VMD_PROBE_BAD_CLASS   : u64 = 0xFFFFFBDE
  pub let VMD_PROBE_BAD_VENDOR  : u64 = 0xFFFFFBDD
  pub let VMD_PROBE_BAD_BAR     : u64 = 0xFFFFFBDC
  pub let VMD_PROBE_MISALIGNED  : u64 = 0xFFFFFBDB
  pub let VMD_PROBE_BAD_CAP0    : u64 = 0xFFFFFBDA
  pub let VMD_PROBE_NO_MEMBERS  : u64 = 0xFFFFFBD9
  pub let VMD_PROBE_BAD_CFGOFF  : u64 = 0xFFFFFBD8

  pub let mut _vmd_probe_stats : [u64; 8] = uninit @align(64)

  pub let VMD_PROBE_ST_ATTEMPTS : u64 = 0
  pub let VMD_PROBE_ST_MATCHED  : u64 = 1
  pub let VMD_PROBE_ST_REJECTS  : u64 = 2
  pub let VMD_PROBE_ST_ALIGNED  : u64 = 3
  pub let VMD_PROBE_ST_MEMBERS  : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_probe_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-001 (#1412): clear stats. Labels prefixed vmp_rs_.",
      block: {
        lea r10, [rip + _vmd_probe_stats];
        xor rax, rax;
        xor rcx, rcx;
      vmp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vmp_rs_loop;
        ret
      }
    }

  pub let vmd_probe_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-001 (#1412): honesty pin. Returns 0 until a later round binds this against a live PCIe VMD BAR window.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_probe_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-001 (#1412): counter read.",
      block: {
        cmp rdi, 8;
        jae vmp_st_zero;
        lea r10, [rip + _vmd_probe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vmp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_probe_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-001 (#1412): counter bump. Labels prefixed vmp_nt_.",
      block: {
        cmp rdi, 8;
        jae vmp_nt_out;
        lea r10, [rip + _vmd_probe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vmp_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let vmd_probe_class_valid : (u64) -> u64 !{} @{} =
    fn (class_triple: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-001 (#1412): 1 iff class_triple == 0x010400 (Mass Storage/RAID/VMD). Labels prefixed vmp_cv_.",
      block: {
        mov r10, 0x010400;
        cmp rdi, r10;
        jne vmp_cv_no;
        mov rax, 1;
        ret;
      vmp_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_probe_vendor_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-001 (#1412): 1 iff v in {0x8086 Intel}. Labels prefixed vmp_vv_.",
      block: {
        cmp rdi, 0x8086;
        je  vmp_vv_yes;
        xor rax, rax;
        ret;
      vmp_vv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let vmd_probe_bar_aligned : (u64) -> u64 !{} @{} =
    fn (bar_base: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-001 (#1412): 1 iff (bar_base & 0x1FFFFF) == 0 (2 MiB alignment). Labels prefixed vmp_ba_.",
      block: {
        mov rax, rdi;
        mov r10, 0x1FFFFF;
        and rax, r10;
        cmp rax, 0;
        jne vmp_ba_no;
        mov rax, 1;
        ret;
      vmp_ba_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Decode VMD capability word.
  //
  //   cap0[7:0]     member count
  //   cap0[31:8]    config-space offset
  //
  // A cap0 with zero members is a controller with no child endpoints;
  // refused as NO_MEMBERS rather than recorded.
  // ==========================================================================

  pub let vmd_probe_decode_members : (u64) -> u64 !{} @{} =
    fn (cap0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-001 (#1412): decode member count from cap0[7:0].",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let vmd_probe_decode_cfgoff : (u64) -> u64 !{} @{} =
    fn (cap0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-001 (#1412): decode config-space offset from cap0[31:8].",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // vmd_probe_recognise(class_triple, vendor, bar_base, bar_len, cap0)
  //                    -> members[7:0] | cfgoff[31:8] | err
  // ==========================================================================

  pub let vmd_probe_recognise : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (class_triple: u64) (vendor: u64) (bar_base: u64) (bar_len: u64) (cap0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-001 (#1412): recognise a VMD controller. Sequence: class; vendor; bar_base>0 + bar_len>=2MiB; alignment; cap0!=0; members>0. Returns members[7:0] | (cfgoff << 8). Labels prefixed vmp_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // class_triple
        mov r12, rsi;                    // vendor
        mov r13, rdx;                    // bar_base
        mov r14, rcx;                    // bar_len
        mov r15, r8;                     // cap0

        mov rdi, 0;                      // ATTEMPTS
        call vmd_probe_note;

        mov rdi, rbx;
        call vmd_probe_class_valid;
        cmp rax, 0;
        je  vmp_rc_bad_class;

        mov rdi, r12;
        call vmd_probe_vendor_valid;
        cmp rax, 0;
        je  vmp_rc_bad_vendor;

        cmp r13, 0;
        je  vmp_rc_bad_bar;
        mov r10, 0x200000;               // 2 MiB
        cmp r14, r10;
        jb  vmp_rc_bad_bar;

        mov rdi, r13;
        call vmd_probe_bar_aligned;
        cmp rax, 0;
        je  vmp_rc_misaligned;
        mov rdi, 3;                      // ALIGNED
        call vmd_probe_note;

        cmp r15, 0;
        je  vmp_rc_bad_cap0;

        mov rdi, r15;
        call vmd_probe_decode_members;
        cmp rax, 0;
        je  vmp_rc_no_members;
        mov rbx, rax;                    // members
        mov rdi, 4;                      // MEMBERS
        call vmd_probe_note;

        mov rdi, r15;
        call vmd_probe_decode_cfgoff;
        mov r12, rax;                    // cfgoff

        // MATCHED.
        mov rdi, 1;
        call vmd_probe_note;

        mov rax, rbx;
        and rax, 0xFF;
        mov r10, r12;
        and r10, 0xFFFFFF;
        shl r10, 8;
        or  rax, r10;
        jmp vmp_rc_out;

      vmp_rc_bad_class:
        mov rdi, 2;
        call vmd_probe_note;
        mov rax, 0xFFFFFBDE;
        jmp vmp_rc_out;
      vmp_rc_bad_vendor:
        mov rdi, 2;
        call vmd_probe_note;
        mov rax, 0xFFFFFBDD;
        jmp vmp_rc_out;
      vmp_rc_bad_bar:
        mov rdi, 2;
        call vmd_probe_note;
        mov rax, 0xFFFFFBDC;
        jmp vmp_rc_out;
      vmp_rc_misaligned:
        mov rdi, 2;
        call vmd_probe_note;
        mov rax, 0xFFFFFBDB;
        jmp vmp_rc_out;
      vmp_rc_bad_cap0:
        mov rdi, 2;
        call vmd_probe_note;
        mov rax, 0xFFFFFBDA;
        jmp vmp_rc_out;
      vmp_rc_no_members:
        mov rdi, 2;
        call vmd_probe_note;
        mov rax, 0xFFFFFBD9;

      vmp_rc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
