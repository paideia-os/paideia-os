// src/kernel/core/drivers/vmd/bios_off_fallback.pdx — R47.M5-001 (#1424)
//
// Regression scaffold for the "VMD disabled in BIOS" configuration.
//
// R22..R46 shipped with the operator recipe "toggle Intel VMD
// Controller to Disabled in BIOS Setup" because no VMD driver
// existed.  R47 lifts that requirement (the VMD driver LANDS in R47).
// This module carries the ASSERTION that the pre-R47 code path --
// NVMe visible directly on the primary PCI hierarchy when VMD is
// disabled -- STILL WORKS.  A future user who leaves the BIOS toggle
// on Disabled must observe the same behaviour they did in R24..R46.
//
// The scaffold takes a small (vmd_present, direct_nvme_count) tuple
// and returns 0 when the tuple represents the LEGAL joint states:
//   * vmd_present=0, direct_nvme_count>0   -- BIOS-off, NVMe found directly
//   * vmd_present=1, direct_nvme_count==0  -- BIOS-on, NVMe behind VMD
//   * vmd_present=0, direct_nvme_count==0  -- neither (no NVMe machine)
// It refuses the illegal joint state (both non-zero at the same
// address) as VMD_FALLBACK_BOTH_PATHS, which would indicate a probe
// bug -- one NVMe controller cannot be simultaneously behind VMD and
// on the primary hierarchy.
//
// =============================================================================
// §0  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_fallback_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/vmd/bios_off_fallback.o`.
//
// =============================================================================
// §1  ERROR CODES 0xFFFFFDDA..0xFFFFFDDF (shared band; vmd_iommu_adversarial
//    is elsewhere -- see §2 vmd_iommu_switch header).
// =============================================================================

module BiosOffFallback = structure {

  pub let VMD_FB_OK          : u64 = 0
  pub let VMD_FB_BOTH_PATHS  : u64 = 0xFFFFFDDF
  pub let VMD_FB_BAD_ARG     : u64 = 0xFFFFFDDE

  pub let mut _vmd_fallback_stats : [u64; 4] = uninit @align(64)
  pub let VMD_FB_ST_BIOS_OFF : u64 = 0
  pub let VMD_FB_ST_BIOS_ON  : u64 = 1
  pub let VMD_FB_ST_NEITHER  : u64 = 2
  pub let VMD_FB_ST_REJECTS  : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_bios_off_fallback_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M5-001 (#1424): clear stats. Labels prefixed vfb_rs_.",
      block: {
        lea r10, [rip + _vmd_fallback_stats];
        xor rax, rax;
        xor rcx, rcx;
      vfb_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vfb_rs_loop;
        ret
      }
    }

  pub let vmd_bios_off_fallback_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M5-001 (#1424): counter read.",
      block: {
        cmp rdi, 4;
        jae vfb_st_zero;
        lea r10, [rip + _vmd_fallback_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vfb_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_bios_off_fallback_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M5-001 (#1424): counter bump. Labels prefixed vfb_nt_.",
      block: {
        cmp rdi, 4;
        jae vfb_nt_out;
        lea r10, [rip + _vmd_fallback_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vfb_nt_out:
        ret
      }
    }

  // ==========================================================================
  // vmd_bios_off_fallback_check(vmd_present, direct_nvme_count) -> 0/err
  // ==========================================================================

  pub let vmd_bios_off_fallback_check : (u64, u64) -> u64 !{mem} @{} =
    fn (vmd_present: u64) (direct_nvme_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M5-001 (#1424): assert the vmd_present + direct_nvme joint state is legal. Labels prefixed vfb_ck_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        // vmd_present must be 0 or 1.
        cmp rbx, 1;
        ja  vfb_ck_bad_arg;

        // BIOS-off case: vmd_present == 0.
        cmp rbx, 0;
        jne vfb_ck_bios_on;

        // vmd_present == 0.
        cmp r12, 0;
        jne vfb_ck_bios_off_hit;
        // BIOS-off with zero NVMe = NEITHER (empty machine).
        mov rdi, 2;
        call vmd_bios_off_fallback_note;
        xor rax, rax;
        jmp vfb_ck_out;

      vfb_ck_bios_off_hit:
        mov rdi, 0;
        call vmd_bios_off_fallback_note;
        xor rax, rax;
        jmp vfb_ck_out;

      vfb_ck_bios_on:
        // vmd_present == 1.  direct_nvme_count MUST be 0 (no other
        // path); a non-zero direct count in this state indicates
        // both paths saw the same controller.
        cmp r12, 0;
        jne vfb_ck_both;
        mov rdi, 1;
        call vmd_bios_off_fallback_note;
        xor rax, rax;
        jmp vfb_ck_out;

      vfb_ck_both:
        mov rdi, 3;
        call vmd_bios_off_fallback_note;
        mov rax, 0xFFFFFDDF;
        jmp vfb_ck_out;
      vfb_ck_bad_arg:
        mov rdi, 3;
        call vmd_bios_off_fallback_note;
        mov rax, 0xFFFFFDDE;

      vfb_ck_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
