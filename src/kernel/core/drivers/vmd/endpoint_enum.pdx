// src/kernel/core/drivers/vmd/endpoint_enum.pdx — R47.M1-002 (#1413)
//
// Intel VMD endpoint enumeration.  Walks the virtual bus/dev/fn
// address space that lives BEHIND a recognised VMD controller and
// records every function whose vendor field is not 0xFFFF as a child
// endpoint candidate.  Consumers of this scaffold mint one
// KIND_VMD_ENDPOINT per recorded child through
// vmd_endpoint_cap_mint_inner.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNISE + RECORD half of enumeration; it does NOT mint
// capabilities on its own, does NOT touch the platform's primary PCI
// hierarchy, and does NOT dereference the child's config space beyond
// the vendor-id probe that decides whether the function is present.
//
// The child's vbdf is packed as bus[15:8] | dev[7:3] | fn[2:0], matching
// the encoding KIND_VMD_ENDPOINT records in its row.  Bus range is
// 0..255 (VMD spec §3.2), dev 0..31, fn 0..7.
//
// The scaffold's default backing for the config-space read is a
// caller-supplied snapshot table (16 entries, one per candidate);
// vmd_endpoint_enum_arbitrated returns 0 until a live root-complex
// binding lands.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_enum_children + _vmd_enum_stats are written only by helpers
// in this module.  tools/build.sh confines relocations against each
// symbol to `core/drivers/vmd/endpoint_enum.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFBE0..0xFFFFFBEF
// =============================================================================

module EndpointEnum = structure {

  // vbdf field bounds.
  pub let VMD_ENUM_BUS_MAX : u64 = 0xFF
  pub let VMD_ENUM_DEV_MAX : u64 = 0x1F
  pub let VMD_ENUM_FN_MAX  : u64 = 0x7

  // Placeholder VENDOR_INVALID (0xFFFF returned by config-read on absent).
  pub let VMD_ENUM_VENDOR_INVALID : u64 = 0xFFFF

  // Failure taxonomy 0xFFFFFBE0..0xFFFFFBEF.
  pub let VMD_ENUM_OK           : u64 = 0
  pub let VMD_ENUM_BAD_ARG      : u64 = 0xFFFFFBEF
  pub let VMD_ENUM_BAD_BUS      : u64 = 0xFFFFFBEE
  pub let VMD_ENUM_BAD_DEV      : u64 = 0xFFFFFBED
  pub let VMD_ENUM_BAD_FN       : u64 = 0xFFFFFBEC
  pub let VMD_ENUM_ABSENT       : u64 = 0xFFFFFBEB
  pub let VMD_ENUM_TABLE_FULL   : u64 = 0xFFFFFBEA
  pub let VMD_ENUM_DUPLICATE    : u64 = 0xFFFFFBE9

  // Child record: {vbdf:u64, vendor:u64, device:u64, class_code:u64}.
  pub let VMD_ENUM_MAX_CHILDREN : u64 = 8
  pub let mut _vmd_enum_children : [u64; 32] = uninit @align(64)

  pub let mut _vmd_enum_stats : [u64; 4] = uninit @align(64)
  pub let VMD_ENUM_ST_RECORDED : u64 = 0
  pub let VMD_ENUM_ST_ABSENT   : u64 = 1
  pub let VMD_ENUM_ST_REJECTS  : u64 = 2
  pub let VMD_ENUM_ST_DUP      : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_endpoint_enum_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): clear the enum children table + stats. Labels prefixed vme_rs_.",
      block: {
        lea r10, [rip + _vmd_enum_children];
        xor rax, rax;
        xor rcx, rcx;
      vme_rs_ch:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  vme_rs_ch;

        lea r10, [rip + _vmd_enum_stats];
        xor rcx, rcx;
      vme_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vme_rs_st;
        ret
      }
    }

  pub let vmd_endpoint_enum_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-002 (#1413): honesty pin. Returns 0 until root-complex config-space read is bound to live MMIO.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_endpoint_enum_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): counter read.",
      block: {
        cmp rdi, 4;
        jae vme_st_zero;
        lea r10, [rip + _vmd_enum_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vme_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_endpoint_enum_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): counter bump. Labels prefixed vme_nt_.",
      block: {
        cmp rdi, 4;
        jae vme_nt_out;
        lea r10, [rip + _vmd_enum_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vme_nt_out:
        ret
      }
    }

  // ==========================================================================
  // vbdf pack + unpack.
  // ==========================================================================

  pub let vmd_enum_vbdf_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (bus: u64) (dev: u64) (fn_num: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-002 (#1413): pack bus[15:8] | dev[7:3] | fn[2:0]. Refuses out-of-range fields. Labels prefixed vme_vp_.",
      block: {
        cmp rdi, 0xFF;
        ja  vme_vp_bad;
        cmp rsi, 0x1F;
        ja  vme_vp_bad;
        cmp rdx, 0x7;
        ja  vme_vp_bad;
        mov rax, rdi;
        and rax, 0xFF;
        shl rax, 8;
        mov r10, rsi;
        and r10, 0x1F;
        shl r10, 3;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0x7;
        or  rax, r10;
        ret;
      vme_vp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // vmd_enum_record(bus, dev, fn, vendor, device, class_code) -> row_id / err
  //
  // Refuses absent (vendor == 0xFFFF) with VMD_ENUM_ABSENT.
  // Refuses duplicate vbdf with VMD_ENUM_DUPLICATE.
  // Refuses on table full with VMD_ENUM_TABLE_FULL.
  // ==========================================================================

  pub let vmd_enum_record : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bus: u64) (dev: u64) (fn_num: u64) (vendor: u64) (device: u64) (class_code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): record one probed child. r8 (device) is unused in the row -- only vbdf, vendor, class_code are stored -- but the arg is kept in the signature for future R47.M2 driver-match extensions. Labels prefixed vme_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // bus
        mov r12, rsi;                    // dev
        mov r13, rdx;                    // fn
        mov r14, rcx;                    // vendor
        mov rbp, r9;                     // class_code (r9 = arg 6)

        // Absent gate.
        mov r10, 0xFFFF;
        cmp r14, r10;
        je  vme_rc_absent;

        // Pack vbdf.  Callee-save regs (rbx/r12-r15/rbp) survive; r8/r9
        // are clobber-set but we already saved class_code in rbp.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call vmd_enum_vbdf_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  vme_rc_bad_arg;
        mov r15, rax;                    // vbdf now in r15

        // Duplicate scan.
        xor rcx, rcx;
      vme_rc_dupscan:
        cmp rcx, 8;
        jae vme_rc_alloc;
        lea r10, [rip + _vmd_enum_children];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];              // slot 1 = vendor (0 if empty)
        cmp rax, 0;
        je  vme_rc_dup_next;
        mov rax, [r10 + 0];              // vbdf
        cmp rax, r15;
        je  vme_rc_dup;
      vme_rc_dup_next:
        add rcx, 1;
        jmp vme_rc_dupscan;

      vme_rc_alloc:
        xor rcx, rcx;
      vme_rc_alloc_scan:
        cmp rcx, 8;
        jae vme_rc_full;
        lea r10, [rip + _vmd_enum_children];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];              // vendor slot (0 = empty)
        cmp rax, 0;
        je  vme_rc_claim;
        add rcx, 1;
        jmp vme_rc_alloc_scan;

      vme_rc_claim:
        mov [r10 + 0],  r15;             // vbdf
        mov [r10 + 8],  r14;             // vendor
        xor rax, rax;
        mov [r10 + 16], rax;             // reserved
        mov [r10 + 24], rbp;             // class_code

        push rcx;                        // preserve row_id across note call
        mov rdi, 0;
        call vmd_endpoint_enum_note;
        pop rax;                         // recovered row_id
        jmp vme_rc_out;

      vme_rc_absent:
        mov rdi, 1;
        call vmd_endpoint_enum_note;
        mov rax, 0xFFFFFBEB;
        jmp vme_rc_out;
      vme_rc_dup:
        mov rdi, 3;
        call vmd_endpoint_enum_note;
        mov rax, 0xFFFFFBE9;
        jmp vme_rc_out;
      vme_rc_full:
        mov rdi, 2;
        call vmd_endpoint_enum_note;
        mov rax, 0xFFFFFBEA;
        jmp vme_rc_out;
      vme_rc_bad_arg:
        mov rdi, 2;
        call vmd_endpoint_enum_note;
        mov rax, 0xFFFFFBEF;

      vme_rc_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let vmd_enum_row_vbdf : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): vbdf accessor.",
      block: {
        cmp rdi, 8;
        jae vme_rvb_bad;
        lea r10, [rip + _vmd_enum_children];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];              // vendor slot (0 = empty)
        cmp rax, 0;
        je  vme_rvb_bad;
        mov rax, [r10 + 0];
        ret;
      vme_rvb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vmd_enum_row_vendor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): vendor accessor.",
      block: {
        cmp rdi, 8;
        jae vme_rvn_bad;
        lea r10, [rip + _vmd_enum_children];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        cmp rax, 0;
        je  vme_rvn_bad;
        ret;
      vme_rvn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vmd_enum_row_class : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): class_code accessor.",
      block: {
        cmp rdi, 8;
        jae vme_rcc_bad;
        lea r10, [rip + _vmd_enum_children];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        cmp rax, 0;
        je  vme_rcc_bad;
        mov rax, [r10 + 24];
        ret;
      vme_rcc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let vmd_enum_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-002 (#1413): populated child count. Labels prefixed vme_ct_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      vme_ct_scan:
        cmp rcx, 8;
        jae vme_ct_out;
        lea r10, [rip + _vmd_enum_children];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov r11, [r10 + 8];
        cmp r11, 0;
        je  vme_ct_next;
        add rax, 1;
      vme_ct_next:
        add rcx, 1;
        jmp vme_ct_scan;
      vme_ct_out:
        ret
      }
    }
}
