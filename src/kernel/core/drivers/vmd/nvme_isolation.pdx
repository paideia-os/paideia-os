// src/kernel/core/drivers/vmd/nvme_isolation.pdx — R47.M3-002 (#1419)
//
// NVMe queue-pair per-endpoint isolation.  Every KIND_VMD_ENDPOINT
// running the NVMe path owns its own admin + I/O submission /
// completion queue-pairs; this module holds the (endpoint_row, qp_id)
// ownership table + the invariant "no queue-pair belongs to two
// endpoints".
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the OWNERSHIP LEDGER.  It does NOT create queue-pairs (the
// NVMe driver does that against the controller's admin queue), does
// NOT ring doorbells, does NOT submit or complete I/O -- it enforces
// that the driver's per-endpoint accounting cannot silently share a
// qp id across two endpoints, which is what would let one endpoint's
// completion touch another endpoint's DMA payload.
//
// vmd_nvme_isolation_arbitrated returns 0 until a live nvme_supervisor
// uses this ledger to bind its per-qp bookkeeping.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_qp_owners + _vmd_iso_stats are written only by helpers in this
// module.  tools/build.sh confines relocations against each symbol to
// `core/drivers/vmd/nvme_isolation.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFD98..0xFFFFFD9F (SHARED BAND -- lower half is
//    vmd_nvme_bridge).
// =============================================================================

module VmdNvmeIsolation = structure {

  pub let VMD_ISO_MAX_QPS       : u64 = 16
  pub let VMD_ISO_QPID_MAX      : u64 = 65535

  pub let VMD_ISO_OK            : u64 = 0
  pub let VMD_ISO_BAD_ARG       : u64 = 0xFFFFFD9F
  pub let VMD_ISO_BAD_ENDPOINT  : u64 = 0xFFFFFD9E
  pub let VMD_ISO_BAD_QPID      : u64 = 0xFFFFFD9D
  pub let VMD_ISO_TABLE_FULL    : u64 = 0xFFFFFD9C
  pub let VMD_ISO_OWNED_BY_OTHER: u64 = 0xFFFFFD9B
  pub let VMD_ISO_NOT_OWNED     : u64 = 0xFFFFFD9A

  // Row: {endpoint_row_id | qp_id[47:16] | in_use[63:56], reserved}.
  pub let mut _vmd_qp_owners : [u64; 32] = uninit @align(64)
  pub let mut _vmd_iso_stats : [u64; 4]  = uninit @align(64)

  pub let VMD_ISO_ST_CLAIMS   : u64 = 0
  pub let VMD_ISO_ST_RELEASES : u64 = 1
  pub let VMD_ISO_ST_REJECTS  : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_nvme_isolation_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-002 (#1419): clear owners + stats. Labels prefixed vni_rs_.",
      block: {
        lea r10, [rip + _vmd_qp_owners];
        xor rax, rax;
        xor rcx, rcx;
      vni_rs_ow:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  vni_rs_ow;

        lea r10, [rip + _vmd_iso_stats];
        xor rcx, rcx;
      vni_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vni_rs_st;
        ret
      }
    }

  pub let vmd_nvme_isolation_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M3-002 (#1419): honesty pin.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_nvme_isolation_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-002 (#1419): counter read.",
      block: {
        cmp rdi, 4;
        jae vni_st_zero;
        lea r10, [rip + _vmd_iso_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vni_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_nvme_isolation_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-002 (#1419): counter bump. Labels prefixed vni_nt_.",
      block: {
        cmp rdi, 4;
        jae vni_nt_out;
        lea r10, [rip + _vmd_iso_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vni_nt_out:
        ret
      }
    }

  // ==========================================================================
  // vmd_iso_qp_claim(endpoint_row, qp_id) -> 0 / err
  //
  // Refuses if qp_id is already owned by ANOTHER endpoint (OWNED_BY_OTHER),
  // or already owned by THIS endpoint (idempotent success, no counter bump).
  // ==========================================================================

  pub let vmd_iso_qp_claim : (u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) (qp_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-002 (#1419): claim ownership of one qp_id for endpoint_row. Labels prefixed vni_cl_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        mov r10, 0xFFFF;
        cmp rbx, r10;
        ja  vni_cl_bad_ep;

        mov r10, 65535;
        cmp r12, r10;
        ja  vni_cl_bad_qp;

        // Scan for existing owner.
        xor rcx, rcx;
      vni_cl_scan:
        cmp rcx, 16;
        jae vni_cl_alloc;
        lea r10, [rip + _vmd_qp_owners];
        mov r11, rcx;
        shl r11, 4;                      // 16 bytes per row
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vni_cl_scan_next;
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFFFFFF;
        cmp r11, r12;
        jne vni_cl_scan_next;
        // qp_id matches; check endpoint.
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, rbx;
        je  vni_cl_already;              // same endpoint => idempotent
        jmp vni_cl_other;                // different endpoint => refused
      vni_cl_scan_next:
        add rcx, 1;
        jmp vni_cl_scan;

      vni_cl_alloc:
        xor rcx, rcx;
      vni_cl_alloc_scan:
        cmp rcx, 16;
        jae vni_cl_full;
        lea r10, [rip + _vmd_qp_owners];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vni_cl_claim;
        add rcx, 1;
        jmp vni_cl_alloc_scan;

      vni_cl_claim:
        mov rax, rbx;
        and rax, 0xFFFF;
        mov r11, r12;
        and r11, 0xFFFFFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;
        mov [r10 + 8], rax;              // reserved

        mov rdi, 0;
        call vmd_nvme_isolation_note;
        xor rax, rax;
        jmp vni_cl_out;

      vni_cl_already:
        // Idempotent -- return 0 without bumping.
        xor rax, rax;
        jmp vni_cl_out;
      vni_cl_bad_ep:
        mov rdi, 2;
        call vmd_nvme_isolation_note;
        mov rax, 0xFFFFFD9E;
        jmp vni_cl_out;
      vni_cl_bad_qp:
        mov rdi, 2;
        call vmd_nvme_isolation_note;
        mov rax, 0xFFFFFD9D;
        jmp vni_cl_out;
      vni_cl_other:
        mov rdi, 2;
        call vmd_nvme_isolation_note;
        mov rax, 0xFFFFFD9B;
        jmp vni_cl_out;
      vni_cl_full:
        mov rdi, 2;
        call vmd_nvme_isolation_note;
        mov rax, 0xFFFFFD9C;

      vni_cl_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // vmd_iso_qp_owner(qp_id) -> endpoint_row / NOT_OWNED
  pub let vmd_iso_qp_owner : (u64) -> u64 !{mem} @{} =
    fn (qp_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-002 (#1419): find owning endpoint for qp_id.",
      block: {
        push rbx;
        mov rbx, rdi;
        xor rcx, rcx;
      vni_ow_scan:
        cmp rcx, 16;
        jae vni_ow_none;
        lea r10, [rip + _vmd_qp_owners];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vni_ow_next;
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFFFFFF;
        cmp r11, rbx;
        je  vni_ow_hit;
      vni_ow_next:
        add rcx, 1;
        jmp vni_ow_scan;
      vni_ow_hit:
        and rax, 0xFFFF;
        pop rbx;
        ret;
      vni_ow_none:
        mov rax, 0xFFFFFD9A;
        pop rbx;
        ret
      }
    }
}
