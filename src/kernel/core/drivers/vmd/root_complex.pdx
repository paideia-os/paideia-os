// src/kernel/core/drivers/vmd/root_complex.pdx — R47.M2-001 (#1415)
//
// Virtual root-complex config-space aperture under an Intel VMD
// controller.  Given a VMD BAR window recognised by vmd_probe.pdx,
// this scaffold synthesises the ECAM-style read path a consumer uses
// to fetch a child endpoint's PCI configuration bytes WITHOUT
// reaching primary-hierarchy config space.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It computes the aperture OFFSET from (vbdf, cfg_addr) and gates the
// consumer's request against the (bar_len, cfgoff) window recorded at
// probe time.  It does NOT hold the BAR base, it does NOT dereference
// the returned offset -- the actual MMIO read is issued through a
// KIND_OP_REGION the consumer holds separately -- and it does NOT
// mint capabilities.
//
// vmd_root_complex_arbitrated returns 0 until a live BAR mapping
// wires this into the R30 op-region substrate.
//
// =============================================================================
// §1  APERTURE MATH (Intel VMD spec §3.2)
// =============================================================================
//
// A child endpoint at (bus, dev, fn) with a config-space register
// offset `off` (0..4095) maps to BAR-relative aperture offset:
//
//   apoff = cfgoff + (bus << 20) + (dev << 15) + (fn << 12) + off
//
// The scaffold refuses apoff >= bar_len as OUT_OF_RANGE rather than
// wrapping.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_root_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/vmd/root_complex.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFD10..0xFFFFFD1F
// =============================================================================

module RootComplex = structure {

  pub let VMD_RC_CFG_MAX_OFFSET : u64 = 4095      // PCIe extended config = 4 KiB

  // Bit shifts (§1).
  pub let VMD_RC_BUS_SHIFT : u64 = 20
  pub let VMD_RC_DEV_SHIFT : u64 = 15
  pub let VMD_RC_FN_SHIFT  : u64 = 12

  // Failure taxonomy 0xFFFFFD10..0xFFFFFD1F.
  pub let VMD_RC_OK             : u64 = 0
  pub let VMD_RC_BAD_ARG        : u64 = 0xFFFFFD1F
  pub let VMD_RC_BAD_VBDF       : u64 = 0xFFFFFD1E
  pub let VMD_RC_BAD_OFFSET     : u64 = 0xFFFFFD1D
  pub let VMD_RC_OUT_OF_RANGE   : u64 = 0xFFFFFD1C
  pub let VMD_RC_BAD_ALIGN      : u64 = 0xFFFFFD1B

  pub let mut _vmd_root_stats : [u64; 4] = uninit @align(64)
  pub let VMD_RC_ST_READS   : u64 = 0
  pub let VMD_RC_ST_REJECTS : u64 = 1

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_root_complex_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): clear stats. Labels prefixed vrc_rs_.",
      block: {
        lea r10, [rip + _vmd_root_stats];
        xor rax, rax;
        xor rcx, rcx;
      vrc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vrc_rs_loop;
        ret
      }
    }

  pub let vmd_root_complex_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M2-001 (#1415): honesty pin. Returns 0 until BAR mapping wires this into the R30 op-region substrate.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_root_complex_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): counter read.",
      block: {
        cmp rdi, 4;
        jae vrc_st_zero;
        lea r10, [rip + _vmd_root_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vrc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_root_complex_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): counter bump. Labels prefixed vrc_nt_.",
      block: {
        cmp rdi, 4;
        jae vrc_nt_out;
        lea r10, [rip + _vmd_root_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vrc_nt_out:
        ret
      }
    }

  // ==========================================================================
  // vmd_root_complex_offset(vbdf, cfg_off, cfgoff_base, bar_len)
  //                       -> apoff / err
  // ==========================================================================

  pub let vmd_root_complex_offset : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vbdf: u64) (cfg_off: u64) (cfgoff_base: u64) (bar_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-001 (#1415): compute aperture offset. Refuses cfg_off > 4095 (BAD_OFFSET), cfg_off & 3 (BAD_ALIGN), or apoff >= bar_len (OUT_OF_RANGE). Labels prefixed vrc_of_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // vbdf
        mov r12, rsi;                    // cfg_off
        mov r13, rdx;                    // cfgoff_base
        mov r14, rcx;                    // bar_len

        // vbdf must fit 16 bits.
        mov r10, 0xFFFF;
        cmp rbx, r10;
        ja  vrc_of_bad_vbdf;

        // cfg_off must be <= 4095.
        mov r10, 4095;
        cmp r12, r10;
        ja  vrc_of_bad_off;

        // cfg_off must be 4-byte aligned.
        mov r10, r12;
        and r10, 3;
        cmp r10, 0;
        jne vrc_of_bad_align;

        // Decompose vbdf: bus[15:8], dev[7:3], fn[2:0].
        mov r10, rbx;
        shr r10, 8;
        and r10, 0xFF;
        shl r10, 20;                     // bus << 20
        mov r11, rbx;
        shr r11, 3;
        and r11, 0x1F;
        shl r11, 15;                     // dev << 15
        or  r10, r11;
        mov r11, rbx;
        and r11, 0x7;
        shl r11, 12;                     // fn << 12
        or  r10, r11;

        // apoff = cfgoff_base + r10 + cfg_off
        add r10, r13;
        add r10, r12;

        // Bounds.
        cmp r10, r14;
        jae vrc_of_oor;

        mov rax, r10;

        push rax;
        mov rdi, 0;
        call vmd_root_complex_note;
        pop rax;
        jmp vrc_of_out;

      vrc_of_bad_vbdf:
        mov rdi, 1;
        call vmd_root_complex_note;
        mov rax, 0xFFFFFD1E;
        jmp vrc_of_out;
      vrc_of_bad_off:
        mov rdi, 1;
        call vmd_root_complex_note;
        mov rax, 0xFFFFFD1D;
        jmp vrc_of_out;
      vrc_of_bad_align:
        mov rdi, 1;
        call vmd_root_complex_note;
        mov rax, 0xFFFFFD1B;
        jmp vrc_of_out;
      vrc_of_oor:
        mov rdi, 1;
        call vmd_root_complex_note;
        mov rax, 0xFFFFFD1C;

      vrc_of_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
