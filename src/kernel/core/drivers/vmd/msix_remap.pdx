// src/kernel/core/drivers/vmd/msix_remap.pdx — R47.M2-002 (#1416)
//
// Intel VMD interrupt remapping: MSI-X vector translation from a
// child endpoint's per-vector table entry to a VMD-owned host
// interrupt.  VMD virtualises its children's MSI-X namespace so the
// host IOMMU + IRQ remapping engine sees a SINGLE originator (the
// VMD controller) rather than N per-endpoint originators.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It maintains a small translation table of (endpoint_row_id,
// child_vector) -> (host_vector, cpu_target) mappings, gated at
// install time on the endpoint being live and the vector index being
// in range.  It does NOT write to the child's MSI-X table BAR (that
// belongs to the child driver), does NOT program the host IOAPIC /
// APIC LAPIC (that belongs to R29 KIND_HW_INTERRUPT +
// KIND_HW_MSIX_VECTOR), and does NOT deliver interrupts.
//
// vmd_msix_remap_arbitrated returns 0 until a live driver binds the
// translation to real hardware.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_msix_map + _vmd_msix_stats are written only by helpers in
// this module.  tools/build.sh confines relocations against each
// symbol to `core/drivers/vmd/msix_remap.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFD30..0xFFFFFD3F
// =============================================================================

module VmdMsixRemap = structure {

  pub let VMD_MSIX_MAP_MAX      : u64 = 16
  pub let VMD_MSIX_VECTOR_MAX   : u64 = 2047      // per PCIe §6.8.2 (11-bit)
  pub let VMD_MSIX_HOST_VEC_MAX : u64 = 254       // host IDT vector cap
  pub let VMD_MSIX_CPU_MAX      : u64 = 255

  // Failure taxonomy 0xFFFFFD30..0xFFFFFD3F.
  pub let VMD_MSIX_OK           : u64 = 0
  pub let VMD_MSIX_BAD_ARG      : u64 = 0xFFFFFD3F
  pub let VMD_MSIX_BAD_ENDPOINT : u64 = 0xFFFFFD3E
  pub let VMD_MSIX_BAD_VEC      : u64 = 0xFFFFFD3D
  pub let VMD_MSIX_BAD_HOST_VEC : u64 = 0xFFFFFD3C
  pub let VMD_MSIX_BAD_CPU      : u64 = 0xFFFFFD3B
  pub let VMD_MSIX_TABLE_FULL   : u64 = 0xFFFFFD3A
  pub let VMD_MSIX_DUPLICATE    : u64 = 0xFFFFFD39
  pub let VMD_MSIX_NOT_MAPPED   : u64 = 0xFFFFFD38

  // Row layout (4 u64s = 32 bytes):
  //   [+0] endpoint_row_id[15:0] | child_vec[31:16] | host_vec[47:32] | cpu[55:48] | in_use[63:56]
  //   [+8..24] reserved
  pub let mut _vmd_msix_map   : [u64; 64] = uninit @align(64)   // 16 * 4
  pub let mut _vmd_msix_stats : [u64; 4]  = uninit @align(64)

  pub let VMD_MSIX_ST_INSTALLS : u64 = 0
  pub let VMD_MSIX_ST_REMOVES  : u64 = 1
  pub let VMD_MSIX_ST_REJECTS  : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_msix_remap_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-002 (#1416): clear map + stats. Labels prefixed vmx_rs_.",
      block: {
        lea r10, [rip + _vmd_msix_map];
        xor rax, rax;
        xor rcx, rcx;
      vmx_rs_map:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  vmx_rs_map;

        lea r10, [rip + _vmd_msix_stats];
        xor rcx, rcx;
      vmx_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vmx_rs_st;
        ret
      }
    }

  pub let vmd_msix_remap_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M2-002 (#1416): honesty pin. Returns 0 until a live driver wires this against R29 KIND_HW_MSIX_VECTOR.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_msix_remap_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-002 (#1416): counter read.",
      block: {
        cmp rdi, 4;
        jae vmx_st_zero;
        lea r10, [rip + _vmd_msix_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vmx_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_msix_remap_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-002 (#1416): counter bump. Labels prefixed vmx_nt_.",
      block: {
        cmp rdi, 4;
        jae vmx_nt_out;
        lea r10, [rip + _vmd_msix_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vmx_nt_out:
        ret
      }
    }

  // ==========================================================================
  // vmd_msix_install(endpoint_row, child_vec, host_vec, cpu) -> row / err
  // ==========================================================================

  pub let vmd_msix_install : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) (child_vec: u64) (host_vec: u64) (cpu: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-002 (#1416): install one translation. Refuses out-of-range vectors and duplicates. Labels prefixed vmx_in_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // endpoint_row
        mov r12, rsi;                    // child_vec
        mov r13, rdx;                    // host_vec
        mov r14, rcx;                    // cpu

        mov r10, 0xFFFF;
        cmp rbx, r10;
        ja  vmx_in_bad_ep;

        mov r10, 2047;
        cmp r12, r10;
        ja  vmx_in_bad_vec;

        mov r10, 254;
        cmp r13, r10;
        ja  vmx_in_bad_host;
        cmp r13, 0;
        je  vmx_in_bad_host;

        mov r10, 255;
        cmp r14, r10;
        ja  vmx_in_bad_cpu;

        // Duplicate scan on (endpoint_row, child_vec).
        xor rcx, rcx;
      vmx_in_dup_scan:
        cmp rcx, 16;
        jae vmx_in_alloc;
        lea r10, [rip + _vmd_msix_map];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vmx_in_dup_next;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, rbx;
        jne vmx_in_dup_next;
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFF;
        cmp r11, r12;
        je  vmx_in_dup;
      vmx_in_dup_next:
        add rcx, 1;
        jmp vmx_in_dup_scan;

      vmx_in_alloc:
        xor rcx, rcx;
      vmx_in_alloc_scan:
        cmp rcx, 16;
        jae vmx_in_full;
        lea r10, [rip + _vmd_msix_map];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vmx_in_claim;
        add rcx, 1;
        jmp vmx_in_alloc_scan;

      vmx_in_claim:
        // Pack row.
        mov rax, rbx;
        and rax, 0xFFFF;
        mov r11, r12;
        and r11, 0xFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, r13;
        and r11, 0xFFFF;
        shl r11, 32;
        or  rax, r11;
        mov r11, r14;
        and r11, 0xFF;
        shl r11, 48;
        or  rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;

        push rcx;
        mov rdi, 0;
        call vmd_msix_remap_note;
        pop rax;
        jmp vmx_in_out;

      vmx_in_bad_ep:
        mov rdi, 2;
        call vmd_msix_remap_note;
        mov rax, 0xFFFFFD3E;
        jmp vmx_in_out;
      vmx_in_bad_vec:
        mov rdi, 2;
        call vmd_msix_remap_note;
        mov rax, 0xFFFFFD3D;
        jmp vmx_in_out;
      vmx_in_bad_host:
        mov rdi, 2;
        call vmd_msix_remap_note;
        mov rax, 0xFFFFFD3C;
        jmp vmx_in_out;
      vmx_in_bad_cpu:
        mov rdi, 2;
        call vmd_msix_remap_note;
        mov rax, 0xFFFFFD3B;
        jmp vmx_in_out;
      vmx_in_full:
        mov rdi, 2;
        call vmd_msix_remap_note;
        mov rax, 0xFFFFFD3A;
        jmp vmx_in_out;
      vmx_in_dup:
        mov rdi, 2;
        call vmd_msix_remap_note;
        mov rax, 0xFFFFFD39;
        jmp vmx_in_out;
      vmx_in_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // vmd_msix_lookup(endpoint_row, child_vec) -> row / NOT_MAPPED
  pub let vmd_msix_lookup : (u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) (child_vec: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M2-002 (#1416): lookup translation.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;
        mov r12, rsi;
        xor rcx, rcx;
      vmx_lk_scan:
        cmp rcx, 16;
        jae vmx_lk_none;
        lea r10, [rip + _vmd_msix_map];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vmx_lk_next;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, rbx;
        jne vmx_lk_next;
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFF;
        cmp r11, r12;
        je  vmx_lk_hit;
      vmx_lk_next:
        add rcx, 1;
        jmp vmx_lk_scan;
      vmx_lk_hit:
        mov rax, rcx;
        pop r12;
        pop rbx;
        ret;
      vmx_lk_none:
        mov rax, 0xFFFFFD38;
        pop r12;
        pop rbx;
        ret
      }
    }
}
