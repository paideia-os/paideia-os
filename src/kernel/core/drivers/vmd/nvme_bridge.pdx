// src/kernel/core/drivers/vmd/nvme_bridge.pdx — R47.M3-001 (#1418)
//
// NVMe-over-VMD bridge: the seam that lets the R24 NVMe driver treat
// a KIND_VMD_ENDPOINT-hosted controller as if it lived on the primary
// PCI hierarchy.  This module maps a VMD endpoint row that classifies
// as (0x01, 0x08, 0x02) -- Mass Storage / NVM Express / NVMe -- to
// a driver-visible NVMe controller handle without duplicating the
// R24 initialisation state machine.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ADAPTER between (VMD endpoint identity, KIND_OP_REGION
// naming the endpoint's config-space slice) and (nvme_probe / nvme_init).
// It does NOT reimplement the NVMe admin queue substrate, does NOT
// touch the child's config-space directly, and does NOT allocate DMA
// buffers.  All it does at this milestone is record the binding.
//
// vmd_nvme_bridge_arbitrated returns 0 until nvme_probe is bound to
// the VMD endpoint accessor.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_nvme_bindings + _vmd_nvme_stats are written only by helpers
// in this module.  tools/build.sh confines relocations against each
// symbol to `core/drivers/vmd/nvme_bridge.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFD90..0xFFFFFD97 (SHARED BAND -- upper half is
//    vmd_nvme_isolation).
// =============================================================================

module NvmeBridge = structure {

  // PCI classification recognised as NVMe (Mass Storage / NVMe subclass 8 / progif 2).
  pub let PCI_CLASS_TRIPLE_NVME : u64 = 0x010802

  pub let VMD_NVME_MAX_BINDINGS : u64 = 8

  pub let VMD_NVMB_OK               : u64 = 0
  pub let VMD_NVMB_BAD_ARG          : u64 = 0xFFFFFD97
  pub let VMD_NVMB_BAD_ENDPOINT     : u64 = 0xFFFFFD96
  pub let VMD_NVMB_NOT_NVME         : u64 = 0xFFFFFD95
  pub let VMD_NVMB_TABLE_FULL       : u64 = 0xFFFFFD94
  pub let VMD_NVMB_DUPLICATE        : u64 = 0xFFFFFD93

  // Row: {endpoint_row_id, opregion_slot, ctrl_handle, in_use}.
  pub let mut _vmd_nvme_bindings : [u64; 32] = uninit @align(64)
  pub let mut _vmd_nvme_stats    : [u64; 4]  = uninit @align(64)

  pub let VMD_NVMB_ST_BINDS   : u64 = 0
  pub let VMD_NVMB_ST_UNBINDS : u64 = 1
  pub let VMD_NVMB_ST_REJECTS : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_nvme_bridge_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-001 (#1418): clear bindings + stats. Labels prefixed vnb_rs_.",
      block: {
        lea r10, [rip + _vmd_nvme_bindings];
        xor rax, rax;
        xor rcx, rcx;
      vnb_rs_bd:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  vnb_rs_bd;

        lea r10, [rip + _vmd_nvme_stats];
        xor rcx, rcx;
      vnb_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vnb_rs_st;
        ret
      }
    }

  pub let vmd_nvme_bridge_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M3-001 (#1418): honesty pin. Returns 0 until nvme_probe wires this seam.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_nvme_bridge_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-001 (#1418): counter read.",
      block: {
        cmp rdi, 4;
        jae vnb_st_zero;
        lea r10, [rip + _vmd_nvme_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vnb_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_nvme_bridge_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-001 (#1418): counter bump. Labels prefixed vnb_nt_.",
      block: {
        cmp rdi, 4;
        jae vnb_nt_out;
        lea r10, [rip + _vmd_nvme_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vnb_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Class predicate: 1 iff class_code == PCI_CLASS_TRIPLE_NVME.
  // ==========================================================================

  pub let vmd_nvme_class_valid : (u64) -> u64 !{} @{} =
    fn (class_code: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M3-001 (#1418): recognise NVMe (0x010802).",
      block: {
        mov r10, 0x010802;
        cmp rdi, r10;
        jne vnb_cv_no;
        mov rax, 1;
        ret;
      vnb_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // vmd_nvme_bind(endpoint_row, class_code, opregion_slot, ctrl_handle)
  //             -> binding_id / err
  // ==========================================================================

  pub let vmd_nvme_bind : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) (class_code: u64) (opregion_slot: u64) (ctrl_handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-001 (#1418): bind one NVMe controller.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        mov r10, 0xFFFF;
        cmp rbx, r10;
        ja  vnb_bd_bad_ep;

        // Class must be NVMe.
        mov rdi, r12;
        call vmd_nvme_class_valid;
        cmp rax, 0;
        je  vnb_bd_not_nvme;

        // Duplicate scan on endpoint_row.
        xor rcx, rcx;
      vnb_bd_dup_scan:
        cmp rcx, 8;
        jae vnb_bd_alloc;
        lea r10, [rip + _vmd_nvme_bindings];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];             // in_use
        cmp rax, 0;
        je  vnb_bd_dup_next;
        mov rax, [r10 + 0];              // endpoint_row
        cmp rax, rbx;
        je  vnb_bd_dup;
      vnb_bd_dup_next:
        add rcx, 1;
        jmp vnb_bd_dup_scan;

      vnb_bd_alloc:
        xor rcx, rcx;
      vnb_bd_alloc_scan:
        cmp rcx, 8;
        jae vnb_bd_full;
        lea r10, [rip + _vmd_nvme_bindings];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        cmp rax, 0;
        je  vnb_bd_claim;
        add rcx, 1;
        jmp vnb_bd_alloc_scan;

      vnb_bd_claim:
        mov [r10 + 0],  rbx;             // endpoint_row
        mov [r10 + 8],  r13;             // opregion_slot
        mov [r10 + 16], r14;             // ctrl_handle
        mov rax, 1;
        mov [r10 + 24], rax;             // in_use

        push rcx;
        mov rdi, 0;
        call vmd_nvme_bridge_note;
        pop rax;
        jmp vnb_bd_out;

      vnb_bd_bad_ep:
        mov rdi, 2;
        call vmd_nvme_bridge_note;
        mov rax, 0xFFFFFD96;
        jmp vnb_bd_out;
      vnb_bd_not_nvme:
        mov rdi, 2;
        call vmd_nvme_bridge_note;
        mov rax, 0xFFFFFD95;
        jmp vnb_bd_out;
      vnb_bd_dup:
        mov rdi, 2;
        call vmd_nvme_bridge_note;
        mov rax, 0xFFFFFD93;
        jmp vnb_bd_out;
      vnb_bd_full:
        mov rdi, 2;
        call vmd_nvme_bridge_note;
        mov rax, 0xFFFFFD94;
        jmp vnb_bd_out;
      vnb_bd_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vmd_nvme_binding_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M3-001 (#1418): live binding count.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      vnb_ct_scan:
        cmp rcx, 8;
        jae vnb_ct_out;
        lea r10, [rip + _vmd_nvme_bindings];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov r11, [r10 + 24];
        cmp r11, 0;
        je  vnb_ct_next;
        add rax, 1;
      vnb_ct_next:
        add rcx, 1;
        jmp vnb_ct_scan;
      vnb_ct_out:
        ret
      }
    }
}
