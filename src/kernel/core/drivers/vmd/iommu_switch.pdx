// src/kernel/core/drivers/vmd/iommu_switch.pdx — R47.M4-002 (#1422)
//
// IOMMU domain switching under VMD.  Records the "current active"
// IOMMU domain from the perspective of a given VMD endpoint's DMA
// path so an in-flight request cannot bleed onto a domain the
// endpoint no longer holds (e.g. mid-way through a quiesce).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It maintains a per-endpoint "active_domain" cell + a switch counter.
// A switch is expressed as (endpoint_row, from_domain, to_domain);
// the module refuses a switch whose from_domain does not match the
// currently-recorded active domain (STALE) so a delayed request
// cannot silently overwrite a domain that was already retired.
//
// It does NOT perform an IOTLB flush (that lives in the R22 VT-d
// driver), does NOT touch the R29 KIND_DMA_DOMAIN row, and does NOT
// mint capabilities.
//
// vmd_iommu_switch_arbitrated returns 0 until a live driver wires
// its per-endpoint transition path to this ledger.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _vmd_iommu_active + _vmd_switch_stats are written only by helpers
// in this module.  tools/build.sh confines relocations against each
// symbol to `core/drivers/vmd/iommu_switch.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFDD5..0xFFFFFDD9 (SHARED BAND with iommu_domain
//    D0..D4 and iommu_adversarial DA..DF).
// =============================================================================

module VmdIommuSwitch = structure {

  pub let VMD_IOMMU_SW_MAX_ENDPOINTS : u64 = 16

  pub let VMD_ISW_OK           : u64 = 0
  pub let VMD_ISW_BAD_ARG      : u64 = 0xFFFFFDD9
  pub let VMD_ISW_BAD_ENDPOINT : u64 = 0xFFFFFDD8
  pub let VMD_ISW_STALE        : u64 = 0xFFFFFDD7
  pub let VMD_ISW_TABLE_FULL   : u64 = 0xFFFFFDD6
  pub let VMD_ISW_NOT_TRACKED  : u64 = 0xFFFFFDD5

  // Row: {endpoint_row[15:0] | active_domain[47:16] | in_use[63:56], generation}.
  pub let mut _vmd_iommu_active : [u64; 32] = uninit @align(64)
  pub let mut _vmd_switch_stats : [u64; 4]  = uninit @align(64)

  pub let VMD_ISW_ST_SWITCHES : u64 = 0
  pub let VMD_ISW_ST_STALES   : u64 = 1
  pub let VMD_ISW_ST_REJECTS  : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let vmd_iommu_switch_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-002 (#1422): clear active + stats. Labels prefixed vis_rs_.",
      block: {
        lea r10, [rip + _vmd_iommu_active];
        xor rax, rax;
        xor rcx, rcx;
      vis_rs_a:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  vis_rs_a;

        lea r10, [rip + _vmd_switch_stats];
        xor rcx, rcx;
      vis_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vis_rs_st;
        ret
      }
    }

  pub let vmd_iommu_switch_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M4-002 (#1422): honesty pin.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vmd_iommu_switch_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-002 (#1422): counter read.",
      block: {
        cmp rdi, 4;
        jae vis_st_zero;
        lea r10, [rip + _vmd_switch_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vis_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vmd_iommu_switch_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-002 (#1422): counter bump. Labels prefixed vis_nt_.",
      block: {
        cmp rdi, 4;
        jae vis_nt_out;
        lea r10, [rip + _vmd_switch_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vis_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Helpers to scan/find/claim a row for an endpoint.
  // ==========================================================================

  // vmd_iommu_switch_active(endpoint_row) -> active_domain / NOT_TRACKED
  pub let vmd_iommu_switch_active : (u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-002 (#1422): read the recorded active domain for an endpoint.",
      block: {
        push rbx;
        mov rbx, rdi;
        xor rcx, rcx;
      vis_ac_scan:
        cmp rcx, 16;
        jae vis_ac_none;
        lea r10, [rip + _vmd_iommu_active];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vis_ac_next;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, rbx;
        je  vis_ac_hit;
      vis_ac_next:
        add rcx, 1;
        jmp vis_ac_scan;
      vis_ac_hit:
        shr rax, 16;
        and rax, 0xFFFFFFFF;
        pop rbx;
        ret;
      vis_ac_none:
        mov rax, 0xFFFFFDD5;
        pop rbx;
        ret
      }
    }

  // vmd_iommu_switch_do(endpoint_row, from_domain, to_domain) -> 0 / err
  //
  // Semantics:
  //   * If the endpoint has no recorded active domain, the switch INSTALLS
  //     to_domain (from_domain must equal 0 to opt in to install; otherwise
  //     STALE).
  //   * If the endpoint has an active domain matching from_domain, the
  //     switch replaces it with to_domain and bumps SWITCHES.
  //   * Otherwise STALE (bumps STALES).
  pub let vmd_iommu_switch_do : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_row: u64) (from_domain: u64) (to_domain: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M4-002 (#1422): perform one switch. Labels prefixed vis_do_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // endpoint_row
        mov r12, rsi;                    // from_domain
        mov r13, rdx;                    // to_domain

        mov r10, 0xFFFF;
        cmp rbx, r10;
        ja  vis_do_bad_ep;

        // Find existing row.
        xor rcx, rcx;
      vis_do_scan:
        cmp rcx, 16;
        jae vis_do_install;
        lea r10, [rip + _vmd_iommu_active];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  vis_do_next;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, rbx;
        je  vis_do_replace;
      vis_do_next:
        add rcx, 1;
        jmp vis_do_scan;

      vis_do_replace:
        // Existing row found.  Verify from_domain matches recorded active.
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFFFFFF;
        cmp r11, r12;
        jne vis_do_stale;
        // Overwrite active_domain slice.
        mov rax, rbx;
        and rax, 0xFFFF;
        mov r11, r13;
        and r11, 0xFFFFFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;
        // Bump generation.
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        mov rdi, 0;
        call vmd_iommu_switch_note;
        xor rax, rax;
        jmp vis_do_out;

      vis_do_install:
        // No existing row.  Require from_domain == 0.
        cmp r12, 0;
        jne vis_do_stale;
        xor rcx, rcx;
      vis_do_install_scan:
        cmp rcx, 16;
        jae vis_do_full;
        lea r10, [rip + _vmd_iommu_active];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  vis_do_install_claim;
        add rcx, 1;
        jmp vis_do_install_scan;

      vis_do_install_claim:
        mov rax, rbx;
        and rax, 0xFFFF;
        mov r11, r13;
        and r11, 0xFFFFFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov rax, 1;
        mov [r10 + 8], rax;              // generation 1
        mov rdi, 0;
        call vmd_iommu_switch_note;
        xor rax, rax;
        jmp vis_do_out;

      vis_do_bad_ep:
        mov rdi, 2;
        call vmd_iommu_switch_note;
        mov rax, 0xFFFFFDD8;
        jmp vis_do_out;
      vis_do_stale:
        mov rdi, 1;
        call vmd_iommu_switch_note;
        mov rax, 0xFFFFFDD7;
        jmp vis_do_out;
      vis_do_full:
        mov rdi, 2;
        call vmd_iommu_switch_note;
        mov rax, 0xFFFFFDD6;

      vis_do_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
