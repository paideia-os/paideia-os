// src/kernel/core/drivers/ahci/reset.pdx -- R51.M5-003 (#1659)
//
// AHCI HBA reset + PI (Ports Implemented) enumeration.
//
// Design authority: design/hardware/ahci-substrate.md (commit 9f59498)
// §2.2 (controller bring-up + state machine), §7 #1659 (this issue's
// design + debugger hints). Depends on R51.M5-001 (#1657,
// cap/kind_ahci_controller.pdx -- mint gate, row table, three-state
// machine, ahci_ctrl_row_abar / ahci_ctrl_row_state_set accessors) and
// R51.M5-002 (#1658, drivers/ahci/probe.pdx + ahci_ctrl_probe_and_mint
// -- rows are minted with abar_pa populated before this file ever runs).
//
// This file lands three functions, mirroring the abar_pa-parameterized
// register-level / row_id-parameterized orchestrator split design §7
// #1659 specifies:
//
//   ahci_hba_reset(abar_pa)    -- §2.2 steps 3-5: GHC.AE=1, GHC.HR=1,
//                                  TSC-bounded 1 s poll for HR to clear,
//                                  re-set GHC.AE=1.
//   ahci_pi_enumerate(abar_pa) -- §2.2 step 6: read PI, defensively
//                                  masked to the CAP.NP+1 advertised
//                                  port range.
//   ahci_ctrl_bring_up(row_id) -- orchestrator: resolves abar_pa from
//                                  the row, calls both of the above,
//                                  stashes port_map into the row, and
//                                  advances the row's state machine
//                                  MINTED -> RESET_DONE -> PI_ENUMERATED.
//
// -----------------------------------------------------------------------------
// DESIGN-DOC GAP -- port_map row offset
// -----------------------------------------------------------------------------
//
// design/hardware/ahci-substrate.md §7 #1659's issue text says
// "`ahci_ctrl_bring_up(row_id)` calls both, stashes `port_map` into row
// `[+40]`". This conflicts with the row layout §1657 ACTUALLY landed
// (cap/kind_ahci_controller.pdx SECTION 1): `[+16] port_map`, with
// `[+24]/[+32]/[+40]` all documented as `reserved`, and the pre-existing
// read accessor `ahci_ctrl_row_port_map` (kind_ahci_controller.pdx)
// already reads from `[+16]`. Writing to `[+40]` instead would leave
// that accessor permanently returning 0 (the .bss-zeroed reserved
// value) and would never surface a real PI bitmap to any consumer --
// a silent functional bug, not a stylistic difference. This
// implementation follows the LANDED #1657 row layout and writes
// port_map to `[+16]`, matching `ahci_ctrl_row_port_map`'s read side.
// Flagged for design-doc correction: §7 #1659's "[+40]" should read
// "[+16]".
//
// -----------------------------------------------------------------------------
// DESIGN-DOC GAP -- new row mutator required
// -----------------------------------------------------------------------------
//
// cap/kind_ahci_controller.pdx's own SECTION 1 header note says
// "port_map's setter is added by ahci_ctrl_bring_up's own commit
// (M5-003/#1659)" -- i.e. this issue's commit is expected to add a
// port_map row-mutator to kind_ahci_controller.pdx, since that file's
// existing "Row mutators" section (SECTION labelled in-file) documents
// itself as the SOLE writer of _ahci_controller_table (every existing
// mutator -- ahci_ctrl_tail_alloc / _tail_free / _row_state_set --
// carries that same "THE ONLY WRITER" invariant). This pass therefore
// adds ONE new one-function mutator, `ahci_ctrl_row_port_map_set`, to
// kind_ahci_controller.pdx -- the minimum edit that preserves the
// "one file owns all writes to this table" invariant while letting
// ahci_ctrl_bring_up (this file) do the PI-enumeration write. No other
// change lands in that file.
//
// -----------------------------------------------------------------------------
// TSC-bounded 1 s poll
// -----------------------------------------------------------------------------
//
// Design §2.2 step 4: "Poll GHC.HR == 0 with a bounded TSC deadline
// (parent §3.2 gives no timeout; adopt 1 s conservatively)." Per R21
// discipline (core/time/tsc.pdx's tsc_ns_to_ticks), the deadline is
// computed once as `rdtsc-now + tsc_ns_to_ticks(1_000_000_000)` and
// compared against a fresh rdtsc-now sample every iteration -- the same
// rdtsc-reconstruct idiom used throughout apic/tsc_deadline.pdx and
// cap/nvme_recovery.pdx (`rdtsc; shl rdx,32; or rax,rdx`).
//
// -----------------------------------------------------------------------------
// CAP.NP is 0-based
// -----------------------------------------------------------------------------
//
// Design §7 #1659 debugger hint (d): "advertised NP in CAP is 0-based
// (NP+1 = actual port count) -- the M5-003 walker must add 1."
// ahci_pi_enumerate adds 1 to the extracted NP field before deriving
// the `(1 << (NP+1)) - 1` mask it defensively ANDs against the raw PI
// read -- clamping any garbage bits a non-conformant HBA might report
// above its advertised port count. The per-port bring-up WALK itself
// (iterating individual set bits in port_map to drive per-port CLB/FB
// programming) is R51.M5-005 (#1661) scope, not this issue's.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: all MMIO stores route through regs.pdx's abar_reg_u32_set,
//       which uses mov_d internally -- no direct sub-8-byte store in
//       this file.
//   G4: full-register compares -- and/cmp sequences throughout.
//
// r10/r11 scratch for imm32-sized constants. AHCIC_RESET_TIMEOUT
// (0xFFFFEC86) and AHCIC_DECODE_BAD (0xFFFFFFFFFFFFFFFF) exceed
// 0x7FFFFFFF but are only ever the TARGET of a `mov r64, imm64` (which
// natively encodes a full 64-bit immediate, no sign-extension hazard)
// -- never a `cmp`/`or` immediate operand -- so no r10/r11 staging is
// needed for them here, matching the precedent already landed in
// kind_ahci_controller.pdx's own `ahci_ctrl_tail_alloc` (`mov rax,
// 0xFFFFEC8F` used directly). Labels prefixed `ahci_rst_` (ahci_hba_reset)
// and `ahci_r_` (ahci_pi_enumerate / ahci_ctrl_bring_up), per this
// issue's reserved-label assignment; `loop`, `if`, `port`, `reset`,
// `enum` never appear bare in a label.

module Reset = structure {

  // ============================================================================
  // Return / error codes
  // ============================================================================

  pub let AHCI_RESET_OK          : u64 = 0

  // ============================================================================
  // ahci_hba_reset(abar_pa: u64) -> u64
  // ============================================================================
  //
  // Design §2.2 steps 3-5:
  //   (3) GHC.AE = 1 -- enable AHCI mode (legacy IDE emulation off).
  //   (4) GHC.HR = 1 -- HBA reset; poll GHC.HR == 0 with a 1 s TSC-
  //       bounded deadline. Bails with AHCIC_RESET_TIMEOUT (0xFFFFEC86)
  //       if HR never clears.
  //   (5) Re-set GHC.AE = 1 (HR cleared it).
  //
  // Returns AHCI_RESET_OK (0) on success, AHCIC_RESET_TIMEOUT
  // (0xFFFFEC86) on timeout.
  //
  // Register plan (2-push callee-save + sub rsp,8 -- mirrors
  // drivers/nvme/enable.pdx's nvme_reset_controller_soft exactly):
  //   rbx = abar_pa (preserved across every nested call)
  //   r12 = deadline (absolute TSC tick value)
  //   2 pushes = 16 B; entry rsp%16==8 -> 24, sub rsp,8 -> 32, %16==0.

  pub let ahci_hba_reset : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (abar_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R51.M5-003 (#1659). AHCI HBA reset per design/hardware/ahci-substrate.md §2.2 steps 3-5. Two callee-save pushes (rbx=abar_pa, r12=deadline) + sub rsp,8 = 32 B; entry rsp%16==8 -> 32, %16==0 for every nested call (mirrors drivers/nvme/enable.pdx's nvme_reset_controller_soft prologue shape one-for-one). Body: (1) rbx = abar_pa. (2) GHC.AE=1: abar_reg_u32(rbx, 0x04) -> rax; `or rax, 0x80000000` (AE, bit 31 -- imm32 sign-extends to set rax[63:32], but only the low 32 bits are ever stored by abar_reg_u32_set, so the garbage upper bits are harmless, same accepted idiom as bt_pairing_channel.pdx L374 / pci/msix.pdx L526); abar_reg_u32_set(rbx, 0x04, rax). (3) GHC.HR=1: fresh abar_reg_u32(rbx, 0x04) -> rax (re-read to pick up the AE=1 just written); `or rax, 1` (HR, bit 0); abar_reg_u32_set(rbx, 0x04, rax). (4) Compute the 1 s TSC deadline: tsc_ns_to_ticks(1_000_000_000) -> rax (ticks for 1 s); stash in r12; rdtsc; shl rdx,32; or rax,rdx -> rax = now (the standard rdtsc-reconstruct idiom used throughout apic/tsc_deadline.pdx and cap/nvme_recovery.pdx); add r12, rax -> r12 = deadline. (5) Poll loop ahci_rst_poll: abar_reg_u32(rbx, 0x04) -> rax; `and rax, 1` (HR bit); if clear, break to ahci_rst_clear. Else rdtsc-reconstruct now into rax; `cmp rax, r12; jae ahci_rst_timeout` (deadline reached, r12 held in a register so no r10-staging is needed for this register-register compare); else loop. (6) ahci_rst_clear: re-set GHC.AE=1 (step 5) via a fresh read/or/write triplet identical to step (2) -- HR's self-clear does not disturb AE, but re-asserting matches the design's explicit step 5 and costs one extra MMIO round trip. `xor rax, rax` (AHCI_RESET_OK) and fall through to done. (7) ahci_rst_timeout: `mov rax, 0xFFFFEC86` (AHCIC_RESET_TIMEOUT -- a direct 64-bit mov immediate, not a cmp/or operand, so no r10 staging is required per design §8.5's own carve-out for plain register-immediate moves). (8) ahci_rst_done: add rsp,8; pop r12; pop rbx; ret. Reserved-label posture: labels prefixed `ahci_rst_`. Every abar_reg_u32(_set) / tsc_ns_to_ticks callee preserves rbx/r12 per SysV.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                    // abar_pa

        // ----------------------------------------------------------
        // (3) GHC.AE = 1.
        // ----------------------------------------------------------
        mov rdi, rbx;
        mov rsi, 0x04;                   // AHCI_REG_GHC
        call abar_reg_u32;

        or rax, 0x80000000;              // AHCI_GHC_AE

        mov rdi, rbx;
        mov rsi, 0x04;
        mov rdx, rax;
        call abar_reg_u32_set;

        // ----------------------------------------------------------
        // (4) GHC.HR = 1.
        // ----------------------------------------------------------
        mov rdi, rbx;
        mov rsi, 0x04;
        call abar_reg_u32;

        or rax, 1;                       // AHCI_GHC_HR

        mov rdi, rbx;
        mov rsi, 0x04;
        mov rdx, rax;
        call abar_reg_u32_set;

        // Compute the 1 s TSC-bounded deadline.
        mov rdi, 1000000000;             // 1 s in ns
        call tsc_ns_to_ticks;
        mov r12, rax;                    // r12 = ticks-for-1s

        rdtsc;
        shl rdx, 32;
        or rax, rdx;                     // rax = now

        add r12, rax;                    // r12 = deadline = now + ticks

      ahci_rst_poll:
        mov rdi, rbx;
        mov rsi, 0x04;                   // AHCI_REG_GHC
        call abar_reg_u32;

        and rax, 1;                      // AHCI_GHC_HR
        cmp rax, 0;
        je ahci_rst_clear;

        rdtsc;
        shl rdx, 32;
        or rax, rdx;                     // rax = now

        cmp rax, r12;
        jae ahci_rst_timeout;
        jmp ahci_rst_poll;

      ahci_rst_clear:
        // ----------------------------------------------------------
        // (5) Re-set GHC.AE = 1 (HR self-clear does not disturb it,
        // but the design explicitly calls out re-asserting it).
        // ----------------------------------------------------------
        mov rdi, rbx;
        mov rsi, 0x04;
        call abar_reg_u32;

        or rax, 0x80000000;              // AHCI_GHC_AE

        mov rdi, rbx;
        mov rsi, 0x04;
        mov rdx, rax;
        call abar_reg_u32_set;

        xor rax, rax;                    // AHCI_RESET_OK
        jmp ahci_rst_done;

      ahci_rst_timeout:
        mov rax, 0xFFFFEC86;             // AHCIC_RESET_TIMEOUT

      ahci_rst_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // ahci_pi_enumerate(abar_pa: u64) -> u64
  // ============================================================================
  //
  // Design §2.2 step 6 + §7 #1659 debugger hint (d): read PI, defensively
  // masked to the advertised CAP.NP+1 port range (CAP.NP is 0-based).
  //
  // Returns the masked PI bitmap (low 32 bits meaningful; high bits 0).
  //
  // Register plan (1-push callee-save -- single nested call after the
  // shift, mirrors kind_ahci_controller.pdx's ahci_ctrl_row_abar exactly):
  //   rbx = abar_pa preserved across both abar_reg_u32 calls.
  //   1 push = 8 B; entry rsp%16==8 -> 16, %16==0.

  pub let ahci_pi_enumerate : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (abar_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R51.M5-003 (#1659). PI (Ports Implemented) enumeration per design §2.2 step 6, with the §7 #1659 debugger-hint (d) NP+1 clamp. One callee-save push (rbx=abar_pa) = 8 B; entry rsp%16==8 -> 16, %16==0 for each of the two sequential (non-nested) abar_reg_u32 calls. Body: (1) rbx = abar_pa. (2) abar_reg_u32(rbx, 0x00) -> rax = CAP; `and rax, 0x1F` extracts NP (bits [4:0], 0-based); `add rax, 1` -> actual port count. (3) mov rcx, rax (shift amount, CL-only per x86 variable-shift encoding); `mov r10, 1; shl r10, cl; sub r10, 1` -> r10 = (1 << (NP+1)) - 1, the same `1 << N; sub 1` idiom used in core/smp/topology.pdx's thread-mask computation. (4) abar_reg_u32(rbx, 0x0C) -> rax = raw PI. (5) `and rax, r10` clamps PI to the advertised port range, defending against a non-conformant HBA reporting garbage bits above CAP.NP+1 (the per-bit port walk that actually iterates port_map's set bits to drive per-port bring-up is R51.M5-005 (#1661) scope -- this function only produces the clamped bitmap the row stores). Return rax. Reserved-label posture: this function has no labels (straight-line). Every abar_reg_u32 callee preserves rbx per SysV.",
      block: {
        push rbx;

        mov rbx, rdi;                    // abar_pa

        // CAP.NP (bits [4:0], 0-based) -> actual port count = NP + 1.
        mov rdi, rbx;
        mov rsi, 0x00;                   // AHCI_REG_CAP
        call abar_reg_u32;

        and rax, 0x1F;                   // AHCI_CAP_NP_MASK
        add rax, 1;                      // actual port count

        mov rcx, rax;                    // shift amount (CL)
        mov r10, 1;
        shl r10, cl;
        sub r10, 1;                      // mask = (1 << (NP+1)) - 1

        // Read PI, clamp to advertised range.
        mov rdi, rbx;
        mov rsi, 0x0C;                   // AHCI_REG_PI
        call abar_reg_u32;

        and rax, r10;

        pop rbx;
        ret
      }
    }

  // ============================================================================
  // ahci_ctrl_bring_up(row_id: u64) -> u64
  // ============================================================================
  //
  // Orchestrator: resolves abar_pa from the KIND_AHCI_CONTROLLER row,
  // runs ahci_hba_reset + ahci_pi_enumerate, stashes port_map into the
  // row, and advances the row state machine MINTED -> RESET_DONE ->
  // PI_ENUMERATED (kind_ahci_controller.pdx's ahci_ctrl_row_state_set
  // enforces the monotonic +1 transition gate; this function never
  // writes the state byte directly).
  //
  // Returns AHCIC_OK (0) on full success, or the first error
  // encountered: AHCIC_DECODE_BAD (row not live / bad abar), the
  // AHCIC_RESET_TIMEOUT ahci_hba_reset propagates, or an
  // AHCIC_BAD_TRANSITION / AHCIC_DECODE_BAD ahci_ctrl_row_state_set or
  // the new ahci_ctrl_row_port_map_set propagates.
  //
  // Register plan (3-push callee-save, no pad -- mirrors
  // drivers/nvme/enable.pdx's nvme_reset exactly: 3 pushes = 24 B;
  // entry rsp%16==8 -> 32, %16==0 already, no extra sub rsp,8 needed):
  //   rbx = row_id
  //   r12 = abar_pa
  //   r13 = port_map

  pub let ahci_ctrl_bring_up : (u64) -> u64 !{sysreg, mem} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { cap },
      justification: "R51.M5-003 (#1659). Controller bring-up orchestrator. Three callee-save pushes (rbx=row_id, r12=abar_pa, r13=port_map) = 24 B; entry rsp%16==8 -> 32, %16==0 already (mirrors drivers/nvme/enable.pdx's nvme_reset prologue shape one-for-one -- no extra sub rsp,8 needed). Body: (1) rbx = row_id. (2) ahci_ctrl_row_abar(rbx) -> rax; if AHCIC_DECODE_BAD (0xFFFFFFFFFFFFFFFF) -> return it unchanged (row not live or never minted with an abar_pa). Else r12 = abar_pa. (3) ahci_hba_reset(r12) -> rax; if nonzero (AHCIC_RESET_TIMEOUT) -> return it, state left at MINTED (no partial transition on a failed reset -- matches the monotonic-only-on-success posture ahci_ctrl_row_state_set itself enforces). (4) ahci_ctrl_row_state_set(rbx, 2) [AHCIC_STATE_RESET_DONE] -> rax; if nonzero -> return it (propagates AHCIC_BAD_TRANSITION or AHCIC_DECODE_BAD; should not happen in the single-caller MINTED path but the gate is not bypassed). (5) ahci_pi_enumerate(r12) -> rax; r13 = port_map. (6) ahci_ctrl_row_port_map_set(rbx, r13) -- NEW row mutator this issue adds to kind_ahci_controller.pdx (see file header DESIGN-DOC GAP note) -> rax; if nonzero -> return it. (7) ahci_ctrl_row_state_set(rbx, 3) [AHCIC_STATE_PI_ENUMERATED] -> rax; if nonzero -> return it. (8) ahci_ctrl_note(5) [AHCIC_ST_BRINGUPS] to record the successful bring-up (the stat slot kind_ahci_controller.pdx's M5-001 commit reserved but never populated -- 'claim now, consume later', now consumed). `xor rax, rax` (AHCIC_OK) and return. Reserved-label posture: labels prefixed `ahci_r_`. Every ahci_ctrl_* / ahci_hba_reset / ahci_pi_enumerate callee preserves rbx/r12/r13 per SysV.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // row_id

        mov rdi, rbx;
        call ahci_ctrl_row_abar;
        mov r10, 0xFFFFFFFFFFFFFFFF;      // AHCIC_DECODE_BAD
        cmp rax, r10;
        je ahci_r_bu_out;                 // rax already carries AHCIC_DECODE_BAD

        mov r12, rax;                     // abar_pa

        mov rdi, r12;
        call ahci_hba_reset;
        cmp rax, 0;
        jne ahci_r_bu_out;                // propagate AHCIC_RESET_TIMEOUT

        mov rdi, rbx;
        mov rsi, 2;                        // AHCIC_STATE_RESET_DONE
        call ahci_ctrl_row_state_set;
        cmp rax, 0;
        jne ahci_r_bu_out;

        mov rdi, r12;
        call ahci_pi_enumerate;
        mov r13, rax;                      // port_map

        mov rdi, rbx;
        mov rsi, r13;
        call ahci_ctrl_row_port_map_set;
        cmp rax, 0;
        jne ahci_r_bu_out;

        mov rdi, rbx;
        mov rsi, 3;                        // AHCIC_STATE_PI_ENUMERATED
        call ahci_ctrl_row_state_set;
        cmp rax, 0;
        jne ahci_r_bu_out;

        mov rdi, 5;                        // AHCIC_ST_BRINGUPS
        call ahci_ctrl_note;
        xor rax, rax;                      // AHCIC_OK

      ahci_r_bu_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
