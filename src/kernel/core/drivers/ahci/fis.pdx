// src/kernel/core/drivers/ahci/fis.pdx -- R51.M5-005 (#1661).
//
// H2D (Host-to-Device) Register FIS builder.  Design authority:
// design/hardware/ahci-substrate.md (commit 9f59498) §2.5 (FIS
// discipline), §7 #1661 ("ahci_fis_h2d_build(buf_va, cmd_op, lba48,
// count, device): populate 20-byte FIS in host memory ... C bit = 1").
//
// This file lands ONLY the H2D Register FIS builder.  The D2H
// (completion) FIS is never *built* by software -- the device writes
// it into the port's FIS receive area -- so there is nothing to
// construct on that side; drivers/ahci/identify.pdx reads the status
// byte directly out of the FIS receive area at the fixed offset
// design §2.5 names (fb_va + 0x42) rather than through a "builder"
// that would have no writer-side counterpart.
//
// =============================================================================
// SECTION 0  H2D REGISTER FIS LAYOUT (design §2.5, 20 bytes)
// =============================================================================
//
//   +0  u8  fis_type    = 0x27
//   +1  u8  pmport[3:0] | C[7]=1           -- C=1: this FIS carries a command
//   +2  u8  command                        -- 0xEC for IDENTIFY DEVICE
//   +3  u8  features_lo = 0
//   +4  u8  lba0  (lba48[7:0])
//   +5  u8  lba1  (lba48[15:8])
//   +6  u8  lba2  (lba48[23:16])
//   +7  u8  device
//   +8  u8  lba3  (lba48[31:24])
//   +9  u8  lba4  (lba48[39:32])
//   +10 u8  lba5  (lba48[47:40])
//   +11 u8  features_hi = 0
//   +12 u16 count (low 16 bits of the count arg)
//   +14 u8  icc = 0
//   +15 u8  control = 0
//   +16 u32 reserved = 0
//
// M5 calls this builder with (cmd_op=0xEC, lba48=0, count=0, device=0)
// for IDENTIFY DEVICE -- every LBA/count/device field is zero for that
// command.  Per design §2.5's own forward-compat note, the builder
// accepts the full (cmd_op, lba48, count, device) tuple so a future
// READ_DMA_EXT / WRITE_DMA_EXT / FLUSH_CACHE_EXT builder (R51.M6+)
// reuses this exact function unchanged.
//
// =============================================================================
// SECTION 1  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: every field narrower than 8 bytes is written via a sized store
//       (`mov_b` for the 13 byte fields, `mov_w` for the 2-byte count
//       field) -- a bare `mov [buf+N], reg` would widen to a 4- or
//       8-byte store and corrupt adjacent FIS bytes.  Two `mov [buf+N],
//       rax` 8-byte stores zero-fill bytes 0..15 up front (bytes 3/11/
//       14/15 are left at that zero and never explicitly overwritten);
//       one `mov_d [buf+16], rax` zero-fills the trailing reserved
//       dword (bytes 16..19).
//   G4: not applicable -- this file only ever WRITES sub-word fields
//       (via `shr` + sized store), it never reads one back for a
//       compare.
//   Arity: one function, 5 args (buf_va, cmd_op, lba48, count, device)
//       -- comfortably under the 6-arg SysV ceiling (design §8.1).
//   Reserved-label discipline: no labels in this file -- the builder
//       is straight-line (no branches), so there is no reserved-name
//       collision risk and no label prefix is needed. Per the task's
//       own scope note, `ahci_fis_` would have been the assigned
//       prefix, but is moot here since the file never introduces one;
//       see drivers/ahci/port.pdx's header for the parallel note on
//       why THAT file uses `ahci_pt_` instead of the task's suggested
//       `ahci_pr_` (a landed collision with drivers/ahci/probe.pdx).
//
// =============================================================================

module AhciFis = structure {

  pub let AHCI_FIS_TYPE_H2D  : u64 = 0x27
  pub let AHCI_FIS_H2D_BYTES : u64 = 20

  // ==========================================================================
  // ahci_fis_h2d_build(buf_va, cmd_op, lba48, count, device) -> ()
  //
  // Populate a 20-byte H2D Register FIS at buf_va (the caller's Command
  // Table Command-FIS slot, cmd_alloc.pdx's ct_phys+0).  Pure memory
  // writer; no MMIO, no cap-table reach -- effects {mem}, capabilities
  // {}.  Leaf function (no nested calls, no callee-save prologue
  // needed -- every SysV arg register used directly).
  //   rdi = buf_va
  //   rsi = cmd_op   (e.g. 0xEC for IDENTIFY DEVICE)
  //   rdx = lba48    (48-bit LBA, zero for IDENTIFY DEVICE)
  //   rcx = count    (sector count, zero for IDENTIFY DEVICE)
  //   r8  = device   (device/head byte, zero for IDENTIFY DEVICE)
  // ==========================================================================
  pub let ahci_fis_h2d_build : (u64, u64, u64, u64, u64) -> () !{mem} @{} =
    fn (buf_va: u64) (cmd_op: u64) (lba48: u64) (count: u64) (device: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R51.M5-005 (#1661). H2D Register FIS builder (design §2.5). Leaf: no nested calls, so no callee-save prologue is required -- every SysV integer arg (rdi/rsi/rdx/rcx/r8) is consumed directly. Body: (1) Zero bytes 0..15 via two 8-byte `mov [rdi+0/8], rax` stores (rax pre-zeroed) -- this pre-clears bytes 3 (features_lo), 11 (features_hi), 14 (icc), 15 (control), which are never explicitly written again. (2) Zero the trailing reserved dword (bytes 16..19) via `mov_d [rdi+16], rax` (G1 sized store -- a bare `mov` would write 8 bytes and read past the 20-byte FIS). (3) `mov_b [rdi+0], <0x27>` -- fis_type. (4) `mov_b [rdi+1], <0x80>` -- pmport=0, C(bit7)=1 (command bit; AHCI 1.3.1 §10.3.4 requires this set for the HBA to treat the FIS as an outbound command). (5) `mov_b [rdi+2], rsi` -- command = cmd_op (rsi's low byte; upper bits of cmd_op are never set by any M5 caller). (6) lba0..2 (bytes 4..6): for each, `mov rax, rdx; shr rax, {0,8,16}; mov_b [rdi+{4,5,6}], rax` -- rdx (lba48) is never destroyed, so all three extractions re-read the same preserved source. (7) `mov_b [rdi+7], r8` -- device. (8) lba3..5 (bytes 8..10): same shr-then-store idiom at shift amounts {24,32,40}. (9) count (bytes 12..13): `mov_w [rdi+12], rcx` -- G1 sized 16-bit store (count's low 16 bits; IDENTIFY DEVICE always passes 0). (10) ret. Every byte extraction reads a fresh copy of the 64-bit source register via `mov rax, <src>; shr rax, N` rather than mutating the source in place, so lba48/count/device remain intact for the whole function (not that anything re-reads them after -- this is purely a defensive-clarity choice matching the codebase's existing FIS/PRDT builder idiom precedent, e.g. core/hda_stream_program's H-format setup design §8.3 cites). Encoder: mov / mov_b / mov_w / mov_d / shr -- all pre-existing, no new opcodes.",
      block: {
        // (1) Zero bytes 0..15.
        xor rax, rax;
        mov [rdi + 0], rax;
        mov [rdi + 8], rax;

        // (2) Zero the trailing reserved dword (bytes 16..19).
        mov_d [rdi + 16], rax;

        // (3) fis_type = 0x27.
        mov rax, 0x27;
        mov_b [rdi + 0], rax;

        // (4) pmport=0 | C(bit7)=1.
        mov rax, 0x80;
        mov_b [rdi + 1], rax;

        // (5) command = cmd_op.
        mov_b [rdi + 2], rsi;

        // (6) lba0..2 (bits [23:0] of lba48).
        mov rax, rdx;
        mov_b [rdi + 4], rax;             // lba0 = lba48[7:0]
        mov rax, rdx;
        shr rax, 8;
        mov_b [rdi + 5], rax;             // lba1 = lba48[15:8]
        mov rax, rdx;
        shr rax, 16;
        mov_b [rdi + 6], rax;             // lba2 = lba48[23:16]

        // (7) device.
        mov_b [rdi + 7], r8;

        // (8) lba3..5 (bits [47:24] of lba48).
        mov rax, rdx;
        shr rax, 24;
        mov_b [rdi + 8], rax;             // lba3 = lba48[31:24]
        mov rax, rdx;
        shr rax, 32;
        mov_b [rdi + 9], rax;             // lba4 = lba48[39:32]
        mov rax, rdx;
        shr rax, 40;
        mov_b [rdi + 10], rax;            // lba5 = lba48[47:40]

        // (9) count (u16, bytes 12..13).
        mov_w [rdi + 12], rcx;

        ret
      }
    }
}
