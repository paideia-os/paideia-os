// src/kernel/core/drivers/ahci/regs.pdx -- R51.M5-003 (#1659)
//
// AHCI HBA Generic Host Control register accessors.
//
// Every AHCI HBA function exposes a page-sized MMIO window at ABAR
// (BAR5, captured as abar_pa in _ahci_devices[] by drivers/ahci/probe.pdx
// and stashed into the KIND_AHCI_CONTROLLER row by
// kind_ahci_controller.pdx's ahci_ctrl_cap_mint_inner). The Generic Host
// Control register block occupies the first 0x2C bytes of that window
// per Intel AHCI 1.3.1 Table 3-1 / design/hardware/ahci-substrate.md
// §2.1 (commit 9f59498).
//
// -----------------------------------------------------------------------------
// Register layout (offsets from abar_pa) -- Generic Host Control only
// -----------------------------------------------------------------------------
//
//   0x00  CAP      u32  HBA Capabilities:
//                         [4:0]   NP    -- number of ports (0-based; actual
//                                          port count = NP + 1)
//                         [12:8]  NCS   -- number of command slots (0-based)
//                         [30]    SNCQ  -- NCQ supported
//                         [31]    S64A  -- 64-bit addressing supported
//   0x04  GHC      u32  Global HBA Control:
//                         [0]  HR    -- HBA reset (write 1, HW clears when done)
//                         [1]  IE    -- global interrupt enable
//                         [2]  MRSM  -- MSI revert to single message
//                         [31] AE    -- AHCI enable
//   0x08  IS       u32  Interrupt Status (per-port bitmap; M6 IRQ drain)
//   0x0C  PI       u32  Ports Implemented -- bitmask of live port indices
//   0x10  VS       u32  Version (informational)
//   0x14  CCC_CTL  u32  Command Completion Coalescing control (unused at R51)
//   0x18  CCC_PORTS u32 (unused at R51)
//   0x1C  EM_LOC   u32  Enclosure Management location (unused at R51)
//   0x20  EM_CTL   u32  (unused at R51)
//   0x24  CAP2     u32  (unused at R51)
//   0x28  BOHC     u32  BIOS/OS Handoff Control and Status (read-only
//                       observed at M5 -- design §2.2 step 2 targets
//                       OVMF/no-legacy-ROM boot, so no BOHC race is
//                       driven here; a future ROM-support round owns it)
//
// This file lands the CAP / GHC / PI / VS accessors design §2.1's table
// calls out as the M5-003 read set. IS / CCC_* / EM_* / CAP2 / BOHC
// offsets are documented above for completeness but have no accessor
// here -- they are unused until M6 (IS) or never (the rest, at R51).
//
// -----------------------------------------------------------------------------
// R51.M5 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` boot QEMU q35 does not expose PCI devices to the
// PCI enumerator (MCFG-absent path), so ahci_probe (drivers/ahci/probe.pdx)
// returns 0 and no abar_pa is ever minted into a KIND_AHCI_CONTROLLER row.
// The accessors below are dormant symbols at R51.M5 -- real invocations
// land once a driver-attach path calls ahci_ctrl_bring_up (reset.pdx)
// after MCFG-backed PCI enumeration is available.
//
// -----------------------------------------------------------------------------
// MMIO ordering discipline
// -----------------------------------------------------------------------------
//
// Same posture as drivers/nvme/regs.pdx / core/iommu/vtd_regs.pdx /
// core/apic/ioapic.pdx: every accessor brackets its MMIO transaction
// with `mfence` --
//   (a) mfence-BEFORE: earlier WB stores retire before the UC MMIO
//       transaction begins (SDM Vol 3A §11.3.1 -- WB->UC not ordered).
//   (b) mfence-AFTER: the MMIO transaction publishes / completes before
//       downstream code observes side-effects.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` widens -> `mov_d` for the u32 MMIO store.
//       Every register in this file's read set is naturally 4-byte
//       aligned (CAP/GHC/IS/PI/VS all at 4-byte-aligned offsets), so no
//       load ever straddles a UC line.
//   G4: not applicable here -- the accessors return a raw zero-extended
//       u32 with no compare against a sub-register-width field; callers
//       (reset.pdx) perform the G4-disciplined compares on the returned
//       value.
//
// Reserved-label discipline: this file is straight-line (no labels) --
// no reserved-name collision risk.

module Regs = structure {

  // ============================================================================
  // Register offsets (bytes from abar_pa) -- Generic Host Control
  // ============================================================================

  pub let AHCI_REG_CAP       : u64 = 0x00
  pub let AHCI_REG_GHC       : u64 = 0x04
  pub let AHCI_REG_IS        : u64 = 0x08
  pub let AHCI_REG_PI        : u64 = 0x0C
  pub let AHCI_REG_VS        : u64 = 0x10
  pub let AHCI_REG_CCC_CTL   : u64 = 0x14
  pub let AHCI_REG_CCC_PORTS : u64 = 0x18
  pub let AHCI_REG_EM_LOC    : u64 = 0x1C
  pub let AHCI_REG_EM_CTL    : u64 = 0x20
  pub let AHCI_REG_CAP2      : u64 = 0x24
  pub let AHCI_REG_BOHC      : u64 = 0x28

  // ============================================================================
  // CAP bit definitions (Intel AHCI 1.3.1 §3.1.1)
  // ============================================================================

  pub let AHCI_CAP_NP_MASK   : u64 = 0x0000001F   // [4:0], 0-based port count
  pub let AHCI_CAP_NCS_SHIFT : u64 = 8
  pub let AHCI_CAP_NCS_MASK  : u64 = 0x00001F00
  pub let AHCI_CAP_SNCQ      : u64 = 0x40000000   // bit 30
  pub let AHCI_CAP_S64A      : u64 = 0x80000000   // bit 31

  // ============================================================================
  // GHC bit definitions (Intel AHCI 1.3.1 §3.1.2)
  // ============================================================================

  pub let AHCI_GHC_HR        : u64 = 0x00000001   // bit 0 -- HBA reset
  pub let AHCI_GHC_IE        : u64 = 0x00000002   // bit 1 -- global IRQ enable
  pub let AHCI_GHC_MRSM      : u64 = 0x00000004   // bit 2 -- MSI revert single msg
  pub let AHCI_GHC_AE        : u64 = 0x80000000   // bit 31 -- AHCI enable

  // ============================================================================
  // abar_reg_u32(abar_pa: u64, offset: u64) -> u64
  // ============================================================================
  //
  // 32-bit MMIO read from abar_pa + offset.
  //   rdi = abar_pa (MMIO base, page-aligned)
  //   rsi = register offset (AHCI_REG_* constant)
  //
  // Returns rax = 32-bit register value, zero-extended to 64 bits per
  // SDM Vol 2A §3.4.1.1. Leaf function; mfence brackets the transaction.

  pub let abar_reg_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (abar_pa: u64) (offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R51.M5-003 (#1659). AHCI HBA 32-bit MMIO read. Structural sibling to nvme_reg_u32 (drivers/nvme/regs.pdx) and vtd_read_u32 (core/iommu/vtd_regs.pdx). rdi = abar_pa (page-aligned per AHCI 1.3.1 §3.1), rsi = register offset (AHCI_REG_* constant). Body: (1) mfence -- earlier WB stores retire before this UC MMIO transaction begins (SDM Vol 3A §11.3.1: WB->UC on the same CPU is not TSO-ordered). (2) Compute effective address = abar_pa + offset. (3) mov eax, [rax] -- 32-bit MMIO load; zero-extends into the upper 32 bits of rax per SDM Vol 2A §3.4.1.1. (4) mfence -- result must complete before downstream code observes side-effects. Leaf function, no prologue. Every M5-003 register (CAP/GHC/IS/PI/VS) is naturally 4-byte aligned so the load never straddles a UC line. Encoder: mov / add / mfence / ret -- all pre-existing.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    }

  // ============================================================================
  // abar_reg_u32_set(abar_pa: u64, offset: u64, val: u64) -> ()
  // ============================================================================
  //
  // 32-bit MMIO write to abar_pa + offset.
  //   rdi = abar_pa
  //   rsi = register offset
  //   rdx = value (low 32 bits stored; high bits ignored)

  pub let abar_reg_u32_set : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (abar_pa: u64) (offset: u64) (val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R51.M5-003 (#1659). AHCI HBA 32-bit MMIO write. Structural sibling to nvme_reg_write_u32 (drivers/nvme/regs.pdx). rdi = abar_pa, rsi = register offset, rdx = value (low 32 bits stored). Body: (1) mfence -- bracket earlier WB stores. (2) Compute effective address = abar_pa + offset. (3) mov_d [rax], rdx -- 32-bit MMIO store (G1: sized-32-bit form; a bare `mov [rax], rdx` would widen to REX.W and write 8 bytes, corrupting the neighbouring register). This is also why callers may freely `or`/`and` a full 64-bit rax against imm32 GHC/CAP bit constants before calling this accessor -- any upper-32 garbage introduced by an imm32 sign-extend (e.g. `or rax, 0x80000000` per AHCI_GHC_AE) is discarded here since only the low 32 bits are stored. (4) mfence -- value must publish before downstream observation. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_d [rax], rdx;
        mfence;
        ret
      }
    }
}
