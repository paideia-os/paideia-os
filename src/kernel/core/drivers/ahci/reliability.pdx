// src/kernel/core/drivers/ahci/reliability.pdx -- R51.M6-004 (#1666) +
// R51.M6-005 (#1667).
//
// AHCI FLUSH: BDEV_OP_FLUSH end-to-end via ATA FLUSH_CACHE_EXT
// (0xEA).  Design authority: design/hardware/nvme-ahci-tail-
// milestones.md (commit 2d6ab82) §2.M6 #1666; substrate anchor
// design/hardware/ahci-substrate.md §3.6 (FLUSH_CACHE_EXT), §4.2
// (rights).  Peer of the NVMe-side cap/nvme_reliability.pdx
// (nvme_io_submit_flush, R51.M4-001/#1651) and structural analogue of
// this same directory's io_submit.pdx (ahci_io_submit_rw, R51.M6-002/
// #1664) -- same per-port register accessors, same Command
// Header/Command Table/H2D-FIS build, same doorbell-ring/poll/TFD-
// check tail, but a single-arg signature (`ahci_flush(port_row_id)`,
// design's own name) since FLUSH carries no LBA/nblocks/dma_iova and
// resolves its parent controller (for abar_pa) internally rather than
// requiring the caller to pre-resolve it the way hblk_do_rw_ahci does
// for READ/WRITE (cap_handler_blkdev.pdx's hblk_op_flush_ahci branch,
// this same commit, calls this function with just the port row_id).
//
// R51.M6-005 (#1667) ADDENDUM: this file now also lands `ahci_trim`
// (design/hardware/nvme-ahci-tail-milestones.md §2.M6 #1667) --
// BDEV_OP_TRIM via ATA DATA SET MANAGEMENT (0x06, TRIM bit set in
// FEATURES), gated on the DRAT bit IDENTIFY word 169 stashed at
// #1661 (drivers/ahci/identify.pdx's `ahci_id_scratch_drat` accessor
// -- already landed at M5-005, confirmed by inspection at this
// commit: SECTION 1 of that file's own header documents "[+24] drat"
// on the per-row scratch struct, populated by `ahci_identify_parse`
// step (2)). Unlike `ahci_flush`, `ahci_trim` takes a 3-arg signature
// (`ahci_trim(port_row_id, lba_range_iova, range_count)`, design's own
// name) -- the DSM range-descriptor page address and range count the
// caller (cap_handler_blkdev.pdx's new `hblk_op_trim_ahci` branch,
// this same commit) has already staged, mirroring
// `ahci_io_submit_rw`'s own "caller pre-resolves the DMA IOVA" posture
// rather than `ahci_flush`'s zero-payload shape. See SECTION 0b for
// the wire layout and SECTION 1b for the DRAT-gate placement.
//
// =============================================================================
// SECTION 0  WIRE LAYOUT (design §2.M6 #1666, ahci-substrate.md §3.6)
// =============================================================================
//
// H2D Register FIS (fis_type 0x27), written into the port's bound
// Command Table (`ahci_port_row_ct_phys`) at offset 0 -- identical
// byte layout to io_submit.pdx's own H2D FIS, but every field beyond
// fis_type/C/command/device is zero (FLUSH_CACHE_EXT carries no LBA,
// no sector count):
//
//   +0  u8  fis_type    = 0x27
//   +1  u8  C=1,PMP=0   = 0x80
//   +2  u8  command     = 0xEA (FLUSH_CACHE_EXT)
//   +3  u8  features_lo = 0
//   +4  u8  lba[7:0]    = 0
//   +5  u8  lba[15:8]   = 0
//   +6  u8  lba[23:16]  = 0
//   +7  u8  device      = 0x40 (LBA mode; per design's own wire note)
//   +8  u8  lba[31:24]  = 0
//   +9  u8  lba[39:32]  = 0
//   +10 u8  lba[47:40]  = 0
//   +11 u8  features_hi = 0
//   +12 u8  count_lo (NSECTOR[7:0])  = 0
//   +13 u8  count_hi (NSECTOR[15:8]) = 0
//   +14 u8  icc = 0
//   +15 u8  control = 0
//   +16 u32 reserved = 0
//
// No PRDT entry (design: "No PRDT (PRDTL = 0)") -- FLUSH_CACHE_EXT
// moves no data.  Command header (slot 0, at the port's bound Command
// List -- `ahci_port_row_cl_phys`):
//
//   DW0 = CFL(5, dword count of the 20 B H2D FIS) | W(0, read) |
//         PRDTL(0)<<16  = 0x00000005
//   DW1 = PRDBC, cleared to 0 before issue
//   DW2 = CTBA  (low 32 bits of the Command Table address)
//   DW3 = CTBAU (high 32 bits)
//   DW4..DW7 = reserved, cleared to 0
//
// Submit / completion / TFD-check sequence is identical to
// io_submit.pdx's own (PxCI ring via ahci_port_reg_u32_set, poll PxCI
// bit 0 via ahci_port_reg_u32 bounded by AHCI_IO_SPIN_MAX, PxTFD
// BSY(0x80)|DRQ(0x08)|ERR(0x01) check on completion).
//
// =============================================================================
// SECTION 0b  WIRE LAYOUT -- ahci_trim (design §2.M6 #1667)
// =============================================================================
//
// H2D Register FIS (fis_type 0x27), written into the port's bound
// Command Table at offset 0 -- same shape as ahci_flush's own FIS
// above, but command = DATA SET MANAGEMENT (0x06), features_lo = 0x01
// (TRIM bit), and NSECTOR = 1 (one 512 B block of range descriptors):
//
//   +0  u8  fis_type    = 0x27
//   +1  u8  C=1,PMP=0   = 0x80
//   +2  u8  command     = 0x06 (DATA SET MANAGEMENT)
//   +3  u8  features_lo = 0x01 (TRIM bit set, per design's own note)
//   +4  u8  lba[7:0]    = 0
//   +5  u8  lba[15:8]   = 0
//   +6  u8  lba[23:16]  = 0
//   +7  u8  device      = 0x40 (LBA mode)
//   +8  u8  lba[31:24]  = 0
//   +9  u8  lba[39:32]  = 0
//   +10 u8  lba[47:40]  = 0
//   +11 u8  features_hi = 0
//   +12 u8  count_lo (NSECTOR[7:0])  = 1 -- one 512 B block of range
//                       descriptors (design: "R51.M6 caps at one 512 B
//                       page = 64 ranges per op")
//   +13 u8  count_hi (NSECTOR[15:8]) = 0
//   +14 u8  icc = 0
//   +15 u8  control = 0
//   +16 u32 reserved = 0
//
// One PRDT entry at Command Table offset AHCI_CT_HDR_BYTES (128,
// cmd_alloc.pdx), pointing at the caller-supplied range-descriptor
// page (`lba_range_iova` -- design §2.M6 #1667's "range descriptor"
// note: 8 B per range, LBA[47:0] + count[15:0], up to 64 ranges per
// 512 B sector; the caller populates this page, `ahci_trim` only
// wires the FIS/PRDT/header pointing at it, exactly as
// `ahci_io_submit_rw` never populates the data buffer it points a
// PRDT entry at either):
//
//   +0  u32 DBA  (low 32 bits of lba_range_iova)
//   +4  u32 DBAU (high 32 bits)
//   +8  u32 reserved = 0
//   +12 u32 DBC[21:0] = 511 (512 B - 1), bit31 (I) set -- the only/
//                       last entry.
//
// Command header (slot 0): DW0 = CFL(5) | W(1)<<6 | PRDTL(1)<<16 =
// 0x00010045 -- W=1 because DATA SET MANAGEMENT moves the range list
// FROM host TO device (a "write" transfer in AHCI's own W-bit sense,
// identical direction to WRITE_DMA_EXT in io_submit.pdx). DW1=PRDBC=0,
// DW2/DW3=CTBA/CTBAU, DW4..DW7=0 -- otherwise identical to
// ahci_flush's own header-build shape.
//
// =============================================================================
// SECTION 1b  DRAT GATE (design §2.M6 #1667)
// =============================================================================
//
// design names the gate as reading a `_ahci_port_table.drat` bit
// derived from IDENTIFY word 169 ("`ahci_port_row_word169 : u16`;
// `_ahci_port_table.drat` bit is `word169 & 1`"). By THIS commit,
// drivers/ahci/identify.pdx (#1661, landed) already parses word 169
// bit 0 during `ahci_identify_parse` and stores it at the per-row
// scratch's `[+24]` field (confirmed by inspection: that file's own
// SECTION 1 table lists "Word 169 (byte 338): bit 0 = DRAT ... Stashed
// but not acted on at M5 (M6 gates TRIM on it)" -- this commit IS that
// M6 act-on-it step), readable via the existing
// `ahci_id_scratch_drat(row_id)` accessor. `ahci_trim` therefore reads
// THAT accessor rather than a new `_ahci_port_table.drat`/`word169`
// field -- no new row field or accessor is needed, unlike the
// `write_cache_present` field #1666's own SECTION 1 had to bake into
// the port row tail because no #1661-landed accessor existed for it.
// If `ahci_id_scratch_drat` returns 0 (DRAT clear), `ahci_trim` returns
// `AHCIREL_TRIM_UNSUP` (0xFFFFECB2) BEFORE any wire touch (no FIS,
// PRDT, or command header is written, no doorbell rung) -- exactly the
// "before wire touch" placement design's own text specifies. A
// DECODE_BAD from the accessor (row never IDENTIFIED, or an
// out-of-range row_id) maps to `AHCIIO_SUBMIT_BAD_ROW`, matching every
// other row-accessor failure in this file/io_submit.pdx.
//
// =============================================================================
// SECTION 1  QUERY_FEATURES SURFACE (design §2.M6 #1666)
// =============================================================================
//
// design names a `write_cache_present` field on the AHCI port row
// ("from IDENTIFY word-82 bit-5 at M5-005; if IDENTIFY missed it,
// default 1 -- SATA disks universally cache").  drivers/ahci/
// identify.pdx does NOT currently stash IDENTIFY word 82 anywhere
// (confirmed by inspection at this commit) -- so this issue takes the
// design's own explicitly-sanctioned default path rather than reading
// a field that does not exist yet: cap/kind_ahci_port.pdx's
// `ahci_port_tail_pack_meta` (this commit) bakes
// AHCIP_FEATURE_WRITE_CACHE_PRESENT (bit 3 of the already-reserved
// features byte at row word +32 bits [31:24], design §1 row 8 /
// ahci-substrate.md §3) into every newly-minted port row's meta word,
// and the new `ahci_port_row_write_cache_present` accessor
// (kind_ahci_port.pdx) reads it back.  A future pass that teaches
// identify.pdx to parse word 82 bit 5 can flip this default without
// touching either the accessor or cap_handler_blkdev.pdx's caller
// (DESIGN-DOC GAP, flagged to softarch/debugger review).
//
// cap_handler_blkdev.pdx's `hblk_op_features_ahci` (this commit)
// packs BDEV_FEATURE_FLUSH_SUPPORTED (bit 0) unconditionally --
// FLUSH_CACHE_EXT is ATA/ACS-2 mandatory, so every SATA device this
// driver can IDENTIFY successfully supports it -- and
// BDEV_FEATURE_WRITE_CACHE_PRESENT (bit 3) from the row accessor
// above, exactly as design §2.M6 #1666 specifies.
//
// =============================================================================
// SECTION 2  RESIDUAL GAP -- AHCI dual-kind mint gate still refuses
//            R_BLK_FLUSH
// =============================================================================
//
// cap/kind_ahci_port.pdx's `ahci_port_blk_rights_valid` (R51.M5-006/
// #1662) still enforces `(blk_rights & 0x07) == blk_rights`, so an
// AHCI-family KIND_BLKDEV cap can never carry R_BLK_FLUSH (0x08) --
// `hblk_op_flush`'s existing rights check (design/M4-001, unchanged)
// therefore denies EVERY AHCI-family FLUSH request before this file's
// `ahci_flush` is ever reached, exactly mirroring the same residual
// gap R51.M4-001/#1651 flagged for the NVMe dual-kind mint gate at
// its own landing. This is NOT a bug introduced by this commit: design/
// hardware/nvme-ahci-tail-milestones.md §7 #1670 (R51.M7-002, "Rights
// extension R_BLK_FLUSH + R_BLK_TRIM") is the explicitly-scoped future
// milestone that widens this gate; #1666's own file-touch list does
// not include kind_ahci_port.pdx's rights gate. `ahci_flush` and its
// cap_handler_blkdev.pdx call site are landed and correct NOW so that
// #1670 only has to touch the mint-gate subset check, not invent the
// dispatch path too -- exactly the layering #1651/#1652 already
// established for the NVMe side.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY
// =============================================================================
//
// design/hardware/nvme-ahci-tail-milestones.md §2.M6 #1666 names two
// FLUSH-specific codes directly:
//
//   AHCIREL_FLUSH_TIMEOUT  0xFFFFECB0 -- design-named. PxCI bit 0
//                            never cleared within AHCI_IO_SPIN_MAX
//                            iterations.
//   AHCIREL_FLUSH_TFD_ERR  0xFFFFECB1 -- design-named. PxTFD had
//                            BSY|DRQ|ERR set after CI cleared.
//
// Every other failure mode this function can hit (bad/not-live row,
// port not yet IDENTIFIED, slot 0 already busy) is mechanically
// IDENTICAL to io_submit.pdx's own READ/WRITE path, so this file
// reuses that file's AHCIIO_* codes verbatim rather than minting
// redundant FLUSH-specific duplicates (design's own instruction:
// "reuse #1664's AHCIIO band or extend" -- this issue does both,
// extending only where the design doc names a new code):
//
//   AHCIIO_SUBMIT_NO_SLOT  0xFFFFECA2 (io_submit.pdx) -- slot 0
//                            already has a command in flight.
//   AHCIIO_PORT_NOT_READY  0xFFFFECA6 (io_submit.pdx) -- port row
//                            state != AHCIP_STATE_IDENTIFIED.
//   AHCIIO_SUBMIT_BAD_ROW  0xFFFFECA9 (io_submit.pdx) -- any
//                            DECODE_BAD from a port/ctrl row
//                            accessor, or an unbound (zero)
//                            cl_phys/ct_phys.
//
// R51.M6-005 (#1667) ADDENDUM: design §2.M6 #1667 names three new
// codes directly for `ahci_trim`:
//
//   AHCIREL_TRIM_UNSUP       0xFFFFECB2 -- design-named. DRAT bit
//                              (SECTION 1b) clear.
//   AHCIREL_TRIM_BAD_RANGES  0xFFFFECB3 -- design-named. range_count
//                              is 0 or exceeds 64 (one 512 B page's
//                              worth of 8 B range descriptors).
//   AHCIREL_TRIM_TIMEOUT     0xFFFFECB4 -- design-named. PxCI bit 0
//                              never cleared within AHCI_IO_SPIN_MAX
//                              iterations.
//
// design does not name a TRIM-specific TFD-error code (unlike FLUSH's
// own AHCIREL_FLUSH_TFD_ERR) -- `ahci_trim` therefore reuses
// io_submit.pdx's `AHCIIO_SUBMIT_TFD_ERR` (0xFFFFECA4) for that path,
// following the same "reuse io_submit.pdx's band where design does
// not mint a new code" posture `ahci_flush` itself already
// established for NO_SLOT/PORT_NOT_READY/BAD_ROW above.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: every FIS byte field and command-header dword field uses
//       mov_b / mov_d sized stores -- a bare `mov [mem], reg` would
//       widen to a REX.W 8-byte store and stomp the adjacent field.
//   G4: every sentinel comparison against a value with bit 31/63 set
//       (AHCIREL_*, AHCIIO_*, AHCIP_DECODE_BAD) is staged through
//       `mov r10, <imm64>; cmp reg, r10` rather than `cmp reg, <imm>`
//       directly.
//   No `test`: every flag check is `and reg, mask; cmp reg, 0; jne/je`.
//   Every memory operand in this file is `[base + disp]` -- never
//       `[base + index]` -- so the "mov_b [reg+reg] must be written
//       [reg + reg*1]" SIB gap never arises here.
//   Arity: `ahci_flush` takes exactly 1 arg; `ahci_trim` (#1667) takes
//       exactly 3 (port_row_id, lba_range_iova, range_count) -- both
//       well within the SysV 6-register ceiling.
//
// Reserved-label discipline: every `ahci_flush` label in this file is
// prefixed `ahciio_f_` (this issue's own task text); every `ahci_trim`
// label (#1667) is prefixed `ahci_rel_trim_` (this issue's own task
// text) -- no collision with `loop`, `if`, `port`, `reset`, or any
// other paideia-as keyword, and no collision between the two
// functions' own label sets.

module Reliability = structure {

  pub let AHCIREL_FLUSH_TIMEOUT : u64 = 0xFFFFECB0
  pub let AHCIREL_FLUSH_TFD_ERR : u64 = 0xFFFFECB1

  // R51.M6-005 (#1667).
  pub let AHCIREL_TRIM_UNSUP       : u64 = 0xFFFFECB2
  pub let AHCIREL_TRIM_BAD_RANGES  : u64 = 0xFFFFECB3
  pub let AHCIREL_TRIM_TIMEOUT     : u64 = 0xFFFFECB4

  pub let ATA_CMD_FLUSH_CACHE_EXT : u64 = 0xEA

  // R51.M6-005 (#1667).
  pub let ATA_CMD_DATA_SET_MANAGEMENT : u64 = 0x06
  pub let ATA_DSM_FEATURE_TRIM        : u64 = 0x01
  pub let AHCI_TRIM_MAX_RANGES        : u64 = 64   // one 512 B page / 8 B per range

  // ==========================================================================
  // ahci_flush(port_row_id) -> u64
  //
  // design/hardware/nvme-ahci-tail-milestones.md §2.M6 #1666.
  // Resolves the port's parent controller (for abar_pa) internally;
  // builds the H2D Register FIS (0x27, command 0xEA FLUSH_CACHE_EXT,
  // no PRDT) + command header (slot 0, PRDTL=0), rings PxCI, polls for
  // completion, checks PxTFD.  Returns 0 on success, else one of
  // AHCIREL_FLUSH_TIMEOUT / AHCIREL_FLUSH_TFD_ERR / io_submit.pdx's
  // AHCIIO_SUBMIT_NO_SLOT / AHCIIO_PORT_NOT_READY / AHCIIO_SUBMIT_BAD_ROW.
  // ==========================================================================
  pub let ahci_flush : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (port_row: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M6-004 (#1666): FLUSH_CACHE_EXT (0xEA), no PRDT. One callee-save push (rbx=port_row_id, the only value that must survive every nested accessor call) + sub rsp,48 = 56 B; entry rsp%16==8 -> after push, rsp%16==0; sub rsp,48 (multiple of 16) keeps rsp%16==0 for every nested call. Six memory scratch slots ([rsp+0]=abar_pa, [rsp+8]=port_index, [rsp+16]=cl_phys, [rsp+24]=ct_phys, [rsp+32]=spin-poll counter, [rsp+40] unused pad) hold every intermediate value across the run of nested calls exactly as io_submit.pdx's ahci_io_submit_rw does for the same reason (r10/r11/rax/rcx are caller-save and cannot be trusted to survive the repeated ahci_port_reg_u32(_set) calls). Sequence: (1) ahci_port_tail_valid(port_row) else AHCIIO_SUBMIT_BAD_ROW; (2) ahci_port_row_state(port_row) must equal AHCIP_STATE_IDENTIFIED (2) else AHCIIO_PORT_NOT_READY (DECODE_BAD also maps to AHCIIO_SUBMIT_BAD_ROW); (3) ahci_port_row_parent(port_row) -> ctrl_row_id, DECODE_BAD -> AHCIIO_SUBMIT_BAD_ROW; (4) ahci_ctrl_row_abar(ctrl_row_id) -> abar_pa, DECODE_BAD -> AHCIIO_SUBMIT_BAD_ROW, stashed at [rsp+0]; (5) ahci_port_row_port_index(port_row), stashed at [rsp+8]; (6) ahci_port_row_cl_phys/ahci_port_row_ct_phys(port_row) -- DECODE_BAD or 0 (unbound) both map to AHCIIO_SUBMIT_BAD_ROW, stashed at [rsp+16]/[rsp+24]; (7) ahci_port_reg_u32(abar_pa, port_index, 0x38) to read PxCI; bit 0 set -> AHCIIO_SUBMIT_NO_SLOT, else the raw value is preserved in r9 for the OR-in at doorbell-ring time (no intervening call clobbers r9 before that OR); (8) write the 20 B H2D FIS at ct_phys+0 (SECTION 0 byte layout: fis_type=0x27, C=0x80, command=0xEA, device=0x40, every other byte zero -- all mov_b/mov_d sized stores); (9) write the command header at cl_phys+0 (DW0=0x00000005 fixed CFL=5/W=0/PRDTL=0 -- no PRDT entry is ever written, matching design's 'No PRDT (PRDTL=0)'; DW1 PRDBC=0; DW2/DW3=ct_phys low/high; DW4..DW7=0); (10) sfence, then ahci_port_reg_u32_set(abar_pa, port_index, 0x38, raw_ci|1) to ring the doorbell (slot 0); (11) poll loop ahciio_f_poll: ahci_port_reg_u32(abar_pa, port_index, 0x38), bit 0 clear -> proceed, else decrement the [rsp+32] counter and loop, exhausted -> AHCIREL_FLUSH_TIMEOUT; (12) ahci_port_reg_u32(abar_pa, port_index, 0x20) to read PxTFD; any of BSY(0x80)|DRQ(0x08)|ERR(0x01) set -> AHCIREL_FLUSH_TFD_ERR; (13) success: return 0 (FLUSH has no byte-length concept, unlike ahci_io_submit_rw's byte_len return -- mirrors nvme_io_submit_flush's own 0-on-success shape). Every sentinel compare against a bit-31/63-set value is staged via `mov r10, <imm64>; cmp reg, r10` per G4. Labels prefixed ahciio_f_.",
      block: {
        push rbx;
        sub rsp, 48;

        mov rbx, rdi;                      // port_row

        // ---- (1) port row liveness ----
        mov rdi, rbx;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahciio_f_bad_row;

        // ---- (2) port state must be READY (IDENTIFIED) ----
        mov rdi, rbx;
        call ahci_port_row_state;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahciio_f_bad_row;
        cmp rax, 2;                        // AHCIP_STATE_IDENTIFIED
        jne ahciio_f_not_ready;

        // ---- (3) parent ctrl_row ----
        mov rdi, rbx;
        call ahci_port_row_parent;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahciio_f_bad_row;

        // ---- (4) abar_pa via ctrl_row ----
        mov rdi, rax;
        call ahci_ctrl_row_abar;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahciio_f_bad_row;
        mov [rsp + 0], rax;                // abar_pa

        // ---- (5) port_index ----
        mov rdi, rbx;
        call ahci_port_row_port_index;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahciio_f_bad_row;
        mov [rsp + 8], rax;                // port_index

        // ---- (6) cl_phys / ct_phys ----
        mov rdi, rbx;
        call ahci_port_row_cl_phys;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahciio_f_bad_row;
        cmp rax, 0;
        je  ahciio_f_bad_row;              // unbound: cmd_regions_bind never ran
        mov [rsp + 16], rax;               // cl_phys

        mov rdi, rbx;
        call ahci_port_row_ct_phys;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahciio_f_bad_row;
        cmp rax, 0;
        je  ahciio_f_bad_row;
        mov [rsp + 24], rax;               // ct_phys

        // ---- (7) slot-0 busy check ----
        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x38;                     // AHCI_PORT_REG_CI (regs.pdx)
        call ahci_port_reg_u32;
        mov r10, rax;
        and r10, 1;
        cmp r10, 0;
        jne ahciio_f_no_slot;
        mov r9, rax;                       // raw CI value (expected 0), preserved to doorbell ring

        // ---- (8) H2D Register FIS at ct_phys+0 ----
        mov r10, [rsp + 24];               // ct_phys

        mov r11, 0x27;
        mov_b [r10 + 0], r11;              // fis_type

        mov r11, 0x80;
        mov_b [r10 + 1], r11;              // C=1, PMP=0

        mov r11, 0xEA;
        mov_b [r10 + 2], r11;              // command = FLUSH_CACHE_EXT

        xor r11, r11;
        mov_b [r10 + 3], r11;              // features_lo
        mov_b [r10 + 4], r11;              // lba[7:0]  = 0
        mov_b [r10 + 5], r11;              // lba[15:8] = 0
        mov_b [r10 + 6], r11;              // lba[23:16] = 0

        mov r11, 0x40;
        mov_b [r10 + 7], r11;              // device = LBA mode

        xor r11, r11;
        mov_b [r10 + 8], r11;              // lba[31:24] = 0
        mov_b [r10 + 9], r11;              // lba[39:32] = 0
        mov_b [r10 + 10], r11;             // lba[47:40] = 0
        mov_b [r10 + 11], r11;             // features_hi
        mov_b [r10 + 12], r11;             // count_lo (NSECTOR = 0)
        mov_b [r10 + 13], r11;             // count_hi
        mov_b [r10 + 14], r11;             // icc
        mov_b [r10 + 15], r11;             // control
        mov_d [r10 + 16], r11;             // reserved dword

        // ---- (9) command header at cl_phys+0 (slot 0), PRDTL=0 ----
        mov r10, [rsp + 16];               // cl_phys

        mov r11, 0x5;                      // CFL=5, W=0, PRDTL=0
        mov_d [r10 + 0], r11;

        xor r11, r11;
        mov_d [r10 + 4], r11;              // PRDBC = 0

        mov rax, [rsp + 24];               // ct_phys
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov_d [r10 + 8], rax;              // CTBA

        mov rax, [rsp + 24];
        shr rax, 32;
        mov_d [r10 + 12], rax;             // CTBAU

        xor rax, rax;
        mov_d [r10 + 16], rax;
        mov_d [r10 + 20], rax;
        mov_d [r10 + 24], rax;
        mov_d [r10 + 28], rax;             // reserved DW4..DW7

        // ---- (10) publish + ring doorbell ----
        sfence;

        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x38;                     // AHCI_PORT_REG_CI
        mov rcx, r9;                       // raw CI (0)
        mov r10, 1;
        or  rcx, r10;
        call ahci_port_reg_u32_set;

        // ---- (11) poll for completion ----
        mov r10, 50000000;                 // AHCI_IO_SPIN_MAX (io_submit.pdx)
        mov [rsp + 32], r10;
      ahciio_f_poll:
        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x38;                     // AHCI_PORT_REG_CI
        call ahci_port_reg_u32;
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        je  ahciio_f_poll_done;
        mov r10, [rsp + 32];
        sub r10, 1;
        mov [rsp + 32], r10;
        cmp r10, 0;
        jne ahciio_f_poll;
        mov rax, 0xFFFFECB0;               // AHCIREL_FLUSH_TIMEOUT
        jmp ahciio_f_out;
      ahciio_f_poll_done:

        // ---- (12) TFD error check ----
        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x20;                     // AHCI_PORT_REG_TFD
        call ahci_port_reg_u32;
        mov r10, rax;
        and r10, 0x89;                     // BSY(0x80)|DRQ(0x08)|ERR(0x01)
        cmp r10, 0;
        jne ahciio_f_tfd_err;

        // ---- (13) success ----
        xor rax, rax;
        jmp ahciio_f_out;

      ahciio_f_tfd_err:
        mov rax, 0xFFFFECB1;               // AHCIREL_FLUSH_TFD_ERR
        jmp ahciio_f_out;

      ahciio_f_no_slot:
        mov rax, 0xFFFFECA2;               // AHCIIO_SUBMIT_NO_SLOT (io_submit.pdx)
        jmp ahciio_f_out;

      ahciio_f_not_ready:
        mov rax, 0xFFFFECA6;               // AHCIIO_PORT_NOT_READY (io_submit.pdx)
        jmp ahciio_f_out;

      ahciio_f_bad_row:
        mov rax, 0xFFFFECA9;               // AHCIIO_SUBMIT_BAD_ROW (io_submit.pdx)

      ahciio_f_out:
        add rsp, 48;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ahci_trim(port_row_id, lba_range_iova, range_count) -> u64
  //
  // design/hardware/nvme-ahci-tail-milestones.md §2.M6 #1667. DRAT-
  // gated ATA DATA SET MANAGEMENT (0x06, TRIM bit set) -- see SECTION
  // 0b (wire layout) and SECTION 1b (DRAT gate). Resolves the port's
  // parent controller (for abar_pa) internally, exactly as ahci_flush
  // does; the range-descriptor page (lba_range_iova) is caller-
  // populated -- this function only wires the FIS/PRDT/header
  // pointing at it, never its contents. Returns 0 on success, else one
  // of AHCIREL_TRIM_UNSUP / AHCIREL_TRIM_BAD_RANGES /
  // AHCIREL_TRIM_TIMEOUT / io_submit.pdx's AHCIIO_SUBMIT_TFD_ERR /
  // AHCIIO_SUBMIT_NO_SLOT / AHCIIO_PORT_NOT_READY /
  // AHCIIO_SUBMIT_BAD_ROW.
  // ==========================================================================
  pub let ahci_trim : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (port_row: u64) (lba_range_iova: u64) (range_count: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M6-005 (#1667): DATA SET MANAGEMENT (0x06, features=0x01 TRIM) with one PRDT entry pointing at the caller-supplied range-descriptor page, DRAT-gated. Three callee-save pushes (rbx=port_row, r12=lba_range_iova, r13=range_count -- all three must survive every nested accessor call) + sub rsp,48 = 72 B; entry rsp%16==8 -> after 3 pushes (24 B), rsp%16==0; sub rsp,48 (multiple of 16) keeps rsp%16==0 for every nested call, same shape ahci_flush establishes for its own single push. Six memory scratch slots ([rsp+0]=abar_pa, [rsp+8]=port_index, [rsp+16]=cl_phys, [rsp+24]=ct_phys, [rsp+32]=spin-poll counter, [rsp+40] unused pad) hold every intermediate value across the run of nested calls, identical in shape/purpose to ahci_flush's own scratch layout. Sequence: (1) range_count (r13) == 0 or > AHCI_TRIM_MAX_RANGES (64) -> AHCIREL_TRIM_BAD_RANGES, checked first (no row access needed yet); (2) ahci_port_tail_valid(port_row) else AHCIIO_SUBMIT_BAD_ROW; (3) ahci_port_row_state(port_row) must equal AHCIP_STATE_IDENTIFIED (2) else AHCIIO_PORT_NOT_READY (DECODE_BAD also maps to AHCIIO_SUBMIT_BAD_ROW); (4) DRAT gate (SECTION 1b): ahci_id_scratch_drat(port_row) -> DECODE_BAD maps to AHCIIO_SUBMIT_BAD_ROW, else 0 -> AHCIREL_TRIM_UNSUP (before any wire touch -- no FIS/PRDT/header written, no doorbell rung); (5) ahci_port_row_parent(port_row) -> ctrl_row_id, DECODE_BAD -> AHCIIO_SUBMIT_BAD_ROW; (6) ahci_ctrl_row_abar(ctrl_row_id) -> abar_pa, DECODE_BAD -> AHCIIO_SUBMIT_BAD_ROW, stashed at [rsp+0]; (7) ahci_port_row_port_index(port_row), stashed at [rsp+8]; (8) ahci_port_row_cl_phys/ahci_port_row_ct_phys(port_row) -- DECODE_BAD or 0 (unbound) both map to AHCIIO_SUBMIT_BAD_ROW, stashed at [rsp+16]/[rsp+24]; (9) ahci_port_reg_u32(abar_pa, port_index, 0x38) to read PxCI; bit 0 set -> AHCIIO_SUBMIT_NO_SLOT, else the raw value is preserved in r9 for the OR-in at doorbell-ring time; (10) write the 20 B H2D FIS at ct_phys+0 (SECTION 0b byte layout: fis_type=0x27, C=0x80, command=0x06 DATA_SET_MANAGEMENT, features_lo=0x01 TRIM, device=0x40, count_lo=1 (one 512 B block of range descriptors), every other byte zero -- all mov_b/mov_d sized stores); (11) write the PRDT entry at ct_phys+128 (AHCI_CT_HDR_BYTES, cmd_alloc.pdx): DBA/DBAU from lba_range_iova (r12), DBC=511 (512 B - 1) with bit31 (I) set -- the only/last entry; (12) write the command header at cl_phys+0 (DW0=0x00010045 fixed CFL=5/W=1/PRDTL=1 -- W=1 because DSM moves the range list host-to-device, same direction WRITE_DMA_EXT uses in io_submit.pdx; DW1 PRDBC=0; DW2/DW3=ct_phys low/high; DW4..DW7=0); (13) sfence, then ahci_port_reg_u32_set(abar_pa, port_index, 0x38, raw_ci|1) to ring the doorbell (slot 0); (14) poll loop ahci_rel_trim_poll: ahci_port_reg_u32(abar_pa, port_index, 0x38), bit 0 clear -> proceed, else decrement the [rsp+32] counter and loop, exhausted -> AHCIREL_TRIM_TIMEOUT; (15) ahci_port_reg_u32(abar_pa, port_index, 0x20) to read PxTFD; any of BSY(0x80)|DRQ(0x08)|ERR(0x01) set -> AHCIIO_SUBMIT_TFD_ERR (io_submit.pdx's code, reused -- design names no TRIM-specific TFD code); (16) success: return 0. Every sentinel compare against a bit-31/63-set value is staged via `mov r10, <imm64>; cmp reg, r10` per G4. Labels prefixed ahci_rel_trim_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 48;

        mov rbx, rdi;                      // port_row
        mov r12, rsi;                      // lba_range_iova
        mov r13, rdx;                      // range_count

        // ---- (1) range_count bounds (no row access needed yet) ----
        cmp r13, 0;
        je  ahci_rel_trim_bad_ranges;
        mov r10, 64;                       // AHCI_TRIM_MAX_RANGES
        cmp r13, r10;
        ja  ahci_rel_trim_bad_ranges;

        // ---- (2) port row liveness ----
        mov rdi, rbx;
        call ahci_port_tail_valid;
        cmp rax, 0;
        je  ahci_rel_trim_bad_row;

        // ---- (3) port state must be READY (IDENTIFIED) ----
        mov rdi, rbx;
        call ahci_port_row_state;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahci_rel_trim_bad_row;
        cmp rax, 2;                        // AHCIP_STATE_IDENTIFIED
        jne ahci_rel_trim_not_ready;

        // ---- (4) DRAT gate (SECTION 1b) ----
        mov rdi, rbx;
        call ahci_id_scratch_drat;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahci_rel_trim_bad_row;
        cmp rax, 0;
        je  ahci_rel_trim_unsup;

        // ---- (5) parent ctrl_row ----
        mov rdi, rbx;
        call ahci_port_row_parent;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahci_rel_trim_bad_row;

        // ---- (6) abar_pa via ctrl_row ----
        mov rdi, rax;
        call ahci_ctrl_row_abar;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahci_rel_trim_bad_row;
        mov [rsp + 0], rax;                // abar_pa

        // ---- (7) port_index ----
        mov rdi, rbx;
        call ahci_port_row_port_index;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahci_rel_trim_bad_row;
        mov [rsp + 8], rax;                // port_index

        // ---- (8) cl_phys / ct_phys ----
        mov rdi, rbx;
        call ahci_port_row_cl_phys;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahci_rel_trim_bad_row;
        cmp rax, 0;
        je  ahci_rel_trim_bad_row;         // unbound: cmd_regions_bind never ran
        mov [rsp + 16], rax;               // cl_phys

        mov rdi, rbx;
        call ahci_port_row_ct_phys;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  ahci_rel_trim_bad_row;
        cmp rax, 0;
        je  ahci_rel_trim_bad_row;
        mov [rsp + 24], rax;               // ct_phys

        // ---- (9) slot-0 busy check ----
        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x38;                     // AHCI_PORT_REG_CI (regs.pdx)
        call ahci_port_reg_u32;
        mov r10, rax;
        and r10, 1;
        cmp r10, 0;
        jne ahci_rel_trim_no_slot;
        mov r9, rax;                       // raw CI value (expected 0), preserved to doorbell ring

        // ---- (10) H2D Register FIS at ct_phys+0 ----
        mov r10, [rsp + 24];               // ct_phys

        mov r11, 0x27;
        mov_b [r10 + 0], r11;              // fis_type

        mov r11, 0x80;
        mov_b [r10 + 1], r11;              // C=1, PMP=0

        mov r11, 0x06;
        mov_b [r10 + 2], r11;              // command = DATA_SET_MANAGEMENT

        mov r11, 0x01;
        mov_b [r10 + 3], r11;              // features_lo = TRIM bit

        xor r11, r11;
        mov_b [r10 + 4], r11;              // lba[7:0]  = 0
        mov_b [r10 + 5], r11;              // lba[15:8] = 0
        mov_b [r10 + 6], r11;              // lba[23:16] = 0

        mov r11, 0x40;
        mov_b [r10 + 7], r11;              // device = LBA mode

        xor r11, r11;
        mov_b [r10 + 8], r11;              // lba[31:24] = 0
        mov_b [r10 + 9], r11;              // lba[39:32] = 0
        mov_b [r10 + 10], r11;             // lba[47:40] = 0
        mov_b [r10 + 11], r11;             // features_hi

        mov r11, 0x01;
        mov_b [r10 + 12], r11;             // count_lo (NSECTOR = 1 block)

        xor r11, r11;
        mov_b [r10 + 13], r11;             // count_hi
        mov_b [r10 + 14], r11;             // icc
        mov_b [r10 + 15], r11;             // control
        mov_d [r10 + 16], r11;             // reserved dword

        // ---- (11) PRDT entry at ct_phys+128 ----
        mov rax, r12;                      // lba_range_iova
        mov r11, rax;
        mov r10, 0xFFFFFFFF;
        and r11, r10;
        mov r10, [rsp + 24];               // ct_phys
        mov_d [r10 + 128 + 0], r11;        // DBA

        mov r11, rax;
        shr r11, 32;
        mov_d [r10 + 128 + 4], r11;        // DBAU

        xor r11, r11;
        mov_d [r10 + 128 + 8], r11;        // reserved

        mov rax, 511;                      // DBC = 512 - 1
        mov r11, 0x80000000;               // I (interrupt on completion)
        or  rax, r11;
        mov_d [r10 + 128 + 12], rax;

        // ---- (12) command header at cl_phys+0 (slot 0), PRDTL=1, W=1 ----
        mov r10, [rsp + 16];               // cl_phys

        mov r11, 0x10045;                  // CFL=5, W=1, PRDTL=1
        mov_d [r10 + 0], r11;

        xor r11, r11;
        mov_d [r10 + 4], r11;              // PRDBC = 0

        mov rax, [rsp + 24];               // ct_phys
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov_d [r10 + 8], rax;              // CTBA

        mov rax, [rsp + 24];
        shr rax, 32;
        mov_d [r10 + 12], rax;             // CTBAU

        xor rax, rax;
        mov_d [r10 + 16], rax;
        mov_d [r10 + 20], rax;
        mov_d [r10 + 24], rax;
        mov_d [r10 + 28], rax;             // reserved DW4..DW7

        // ---- (13) publish + ring doorbell ----
        sfence;

        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x38;                     // AHCI_PORT_REG_CI
        mov rcx, r9;                       // raw CI (0)
        mov r10, 1;
        or  rcx, r10;
        call ahci_port_reg_u32_set;

        // ---- (14) poll for completion ----
        mov r10, 50000000;                 // AHCI_IO_SPIN_MAX (io_submit.pdx)
        mov [rsp + 32], r10;
      ahci_rel_trim_poll:
        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x38;                     // AHCI_PORT_REG_CI
        call ahci_port_reg_u32;
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        je  ahci_rel_trim_poll_done;
        mov r10, [rsp + 32];
        sub r10, 1;
        mov [rsp + 32], r10;
        cmp r10, 0;
        jne ahci_rel_trim_poll;
        mov rax, 0xFFFFECB4;               // AHCIREL_TRIM_TIMEOUT
        jmp ahci_rel_trim_out;
      ahci_rel_trim_poll_done:

        // ---- (15) TFD error check ----
        mov rdi, [rsp + 0];                // abar_pa
        mov rsi, [rsp + 8];                // port_index
        mov rdx, 0x20;                     // AHCI_PORT_REG_TFD
        call ahci_port_reg_u32;
        mov r10, rax;
        and r10, 0x89;                     // BSY(0x80)|DRQ(0x08)|ERR(0x01)
        cmp r10, 0;
        jne ahci_rel_trim_tfd_err;

        // ---- (16) success ----
        xor rax, rax;
        jmp ahci_rel_trim_out;

      ahci_rel_trim_tfd_err:
        mov rax, 0xFFFFECA4;               // AHCIIO_SUBMIT_TFD_ERR (io_submit.pdx, reused)
        jmp ahci_rel_trim_out;

      ahci_rel_trim_no_slot:
        mov rax, 0xFFFFECA2;               // AHCIIO_SUBMIT_NO_SLOT (io_submit.pdx)
        jmp ahci_rel_trim_out;

      ahci_rel_trim_not_ready:
        mov rax, 0xFFFFECA6;               // AHCIIO_PORT_NOT_READY (io_submit.pdx)
        jmp ahci_rel_trim_out;

      ahci_rel_trim_unsup:
        mov rax, 0xFFFFECB2;               // AHCIREL_TRIM_UNSUP
        jmp ahci_rel_trim_out;

      ahci_rel_trim_bad_ranges:
        mov rax, 0xFFFFECB3;               // AHCIREL_TRIM_BAD_RANGES
        jmp ahci_rel_trim_out;

      ahci_rel_trim_bad_row:
        mov rax, 0xFFFFECA9;               // AHCIIO_SUBMIT_BAD_ROW (io_submit.pdx)

      ahci_rel_trim_out:
        add rsp, 48;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
