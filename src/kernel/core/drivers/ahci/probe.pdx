// src/kernel/core/drivers/ahci/probe.pdx -- R51.M5-002 (#1658)
//
// AHCI HBA (controller) device probe.
//
// After pci_enumerate_all (src/kernel/core/pci/enum.pdx) populates
// _pci_devices with one 32-byte record per enumerated function, this
// probe filters that list for the PCI class code triple that
// identifies an AHCI 1.0 HBA (Intel AHCI 1.3.1 §2.2):
//
//   class_code = 0x01 (mass storage)
//   subclass   = 0x06 (SATA)
//   prog_if    = 0x01 (AHCI 1.0)
//
// The class/subclass pair lives in the enum-published _pci_devices
// record at offsets +6/+7; prog_if is NOT stored in the compact record
// so it is read back via pci_config_read_u8 for each candidate slot --
// same shape as drivers/nvme/probe.pdx.
//
// For every match the probe records a compact 32-byte descriptor into
// _ahci_devices.  Under the -kernel/BIOS boot path where MCFG is
// absent, _pci_device_count is 0 -> the probe drains the empty loop
// and _ahci_device_count stays 0 -- the same dormant-at-boot posture
// as R24's nvme_probe.
//
// Design authority: design/hardware/ahci-substrate.md (commit
// 9f59498) §3 (file layout), §7 #1658 (this issue's design + debugger
// hints).
//
// -----------------------------------------------------------------------------
// _ahci_devices record layout (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  _pad0
//   +6    u16 cap_msix_off      // 0 if MSI-X capability absent
//   +8    u64 abar_pa           // controller ABAR (BAR5) physical base
//   +16   u16 cap_msi_off       // 0 if MSI capability absent
//   +18   u16 _pad1
//   +20   u32 _pad2
//   +24   u64 _reserved
//   +32   end
//
// This is the SAME byte layout as drivers/nvme/probe.pdx's
// _nvme_devices record (bar0_pa <-> abar_pa at the identical +8
// offset) so kind_ahci_controller.pdx's ahci_ctrl_probe_and_mint can
// reuse nvme_ctrl_probe_and_mint's exact iteration shape one-for-one
// (design §1 row 6).
//
// -----------------------------------------------------------------------------
// ABAR (BAR5) decode
// -----------------------------------------------------------------------------
//
// Per Intel AHCI 1.3.1 §2.2, the AHCI PCI function's ABAR is BAR5 --
// the LAST base-address register in a type-0 header (config offset
// 0x24; five 4-byte BARs precede it starting at 0x10).  Unlike NVMe's
// BAR0, ABAR is architecturally a 32-bit-only memory BAR: BAR5 is the
// final BAR slot, so there is no BAR6 to pair with it for a 64-bit
// MEM64 decode (a type-0 header has exactly six 4-byte BAR dwords,
// 0x10..0x24).  This probe therefore reads ONLY the 32-bit form:
//
//   abar_pa = BAR5[+0x24] & ~0xF   (bits [2:1] MUST read 00 -- 32-bit
//                                    MEM; bit 0 MUST read 0 -- MEM not
//                                    I/O)
//
// DESIGN-DOC GAP: design/hardware/ahci-substrate.md §2.1 line 122
// describes "BAR5 (32-bit) or BAR5/BAR6 pair (64-bit MEM BAR)" -- a
// standard PCI type-0 header has no BAR6 (only BAR0..BAR5 at config
// offsets 0x10..0x24; offset 0x28 is the CardBus CIS Pointer, not a
// BAR), so a 64-bit ABAR pairing is not representable in the standard
// header this probe walks.  Flagged for design-doc correction; this
// implementation follows Intel AHCI 1.3.1 (ABAR is 32-bit-only) and
// QEMU/real-HW AHCI HBA behavior, and defensively refuses (skips) any
// candidate whose BAR5 reads as an I/O BAR (bit 0 set) or a 64-bit-
// type BAR (bits [2:1] == 10, which would require a nonexistent BAR6
// high dword and must not be misread from the CardBus CIS Pointer
// register).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` narrow store widens -> use `mov_d` / `mov_w`
//       / `mov_b` for sized stores into the record.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `ahci_pr_` to avoid
// reserved names (`loop`, `if`, ...) per design §8.2.

module Probe = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let AHCI_CLASS_CODE     : u64 = 0x01   // mass storage
  pub let AHCI_SUBCLASS       : u64 = 0x06   // SATA
  pub let AHCI_PROG_IF        : u64 = 0x01   // AHCI 1.0 interface

  pub let AHCI_MAX_DEVS       : u64 = 4      // matches KindAhciController.AHCIC_MAX
  pub let AHCI_DEV_REC_SIZE   : u64 = 32

  // ============================================================================
  // Canonical static slots -- .bss, @align(8)
  // ============================================================================
  //
  //   _ahci_devices          : 4 x 32 B = 128 B = 16 x u64
  //   _ahci_device_count     : populated by ahci_probe

  pub let mut _ahci_devices        : [u64; 16] = uninit @align(8)
  pub let mut _ahci_device_count   : u64       = 0

  // ============================================================================
  // ahci_probe() -> u64
  // ============================================================================
  //
  // SysV: () -> u64
  //   Returns rax = number of AHCI HBAs discovered (0..4).
  //
  // Register plan (6-push callee-save + 40 B scratch):
  //   rbx = i (loop index into _pci_devices)
  //   r12 = _pci_device_count (loaded once)
  //   r13 = j (ahci write index into _ahci_devices)
  //   r14 = &_pci_devices[i] (recomputed each iter)
  //   r15 = &_ahci_devices[j] (recomputed on match)
  //   rbp = scratch (cap_msix_off preserved across pci_find_cap calls)
  //
  //   Scratch slots (per candidate device):
  //     [rsp+0]  = seg  (u64, zero-extended)
  //     [rsp+8]  = bus  (u64)
  //     [rsp+16] = dev  (u64)
  //     [rsp+24] = fn   (u64)
  //     [rsp+32] = abar_pa (u64, preserved across the pci_find_cap calls)

  pub let ahci_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R51.M5-002 (#1658). AHCI HBA device probe -- mirrors drivers/nvme/probe.pdx one-for-one with the class/subclass/prog-if triple and BAR index substituted (BAR5 @ config +0x24 instead of BAR0 @ +0x10). Body: (1) 6-push callee-save prologue (rbx, rbp, r12-r15) = 48 B; entry rsp%16==8 -> 56, %16==8; sub rsp,40 (32 scratch + 8 pad) -> 96, %16==0. Scratch layout [rsp+0..31] + [rsp+32] for abar_pa preservation across pci_find_cap. (2) Init j=r13=0; load _pci_device_count into r12; init i=rbx=0. (3) Per-iteration bounds check: cmp rbx, r12; jae done. (4) Compute r14 = &_pci_devices[i] = _pci_devices + (i << 5) -- record stride 32 = shl 5 (matches core/pci/publish.pdx). (5) Load class_code (u8 @ r14+6) and subclass (u8 @ r14+7); if class != 0x01 or subclass != 0x06 -> skip. Zero-extend via `xor rax,rax; mov_b rax, [r14+N]`. (6) Class+subclass matched: read seg (u16 @+0), bus (u8 @+2), dev (u8 @+3), fn (u8 @+4) into scratch [rsp+0..24]. (7) Call pci_config_read_u8(seg, bus, dev, fn, 0x09) -> rax = prog_if. If prog_if != 0x01, skip (SATA subclass matched but not an AHCI 1.0 interface -- could be a legacy IDE-mapped SATA controller). (8) Overflow guard: if r13 >= AHCI_MAX_DEVS (4), skip. (9) Read BAR5 lo via pci_config_read_u32(seg, bus, dev, fn, 0x24). Check bit 0 (0=MEM,1=IO): I/O BAR -> skip (ABAR must be MMIO). Check bits [2:1]: only 00 (32-bit MEM) is valid for a standard-header BAR5 -- 10 (64-bit) would require a nonexistent BAR6 high dword (see file header DESIGN-DOC GAP note) so it is treated as malformed and skipped defensively. abar_pa = bar_lo & ~0xF. (10) Call pci_find_cap(seg, bus, dev, fn, 0x11 MSI-X) -> cap_msix_off (rax), preserved in rbp. Call pci_find_cap(seg, bus, dev, fn, 0x05 MSI) -> cap_msi_off (rax). (11) Compute r15 = &_ahci_devices[j] = base + (j << 5). Populate the 32-byte record: u16 seg @+0, u8 bus/dev/fn @+2/+3/+4, u8 pad=0 @+5, u16 cap_msix_off @+6, u64 abar_pa @+8, u16 cap_msi_off @+16, zero the tail (18..32). (12) Increment r13 (j). Fall through to advance i. (13) Advance i, loop. (14) On loop exit: publish _ahci_device_count = r13; return count. Callee-save discipline: pci_config_read_u8/u32 and pci_find_cap all preserve rbx/rbp/r12..r15 per SysV. Scratch slots survive across every nested call. Reserved-label posture: all labels prefixed `ahci_pr_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;                             // 32 scratch + 8 align

        // Init counters.
        xor r13, r13;                            // j = 0 (ahci count)
        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;                            // i = 0

      ahci_pr_loop:
        cmp rbx, r12;
        jae ahci_pr_done;

        // r14 = &_pci_devices[i]
        mov rax, rbx;
        shl rax, 5;
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // class_code (u8 @+6)
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x01;                           // AHCI_CLASS_CODE
        jne ahci_pr_next;

        // subclass (u8 @+7)
        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x06;                           // AHCI_SUBCLASS
        jne ahci_pr_next;

        // Class + subclass match. Load BDF into scratch slots.
        // seg (u16 @+0)
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;

        // bus (u8 @+2)
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;

        // dev (u8 @+3)
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;

        // fn (u8 @+4)
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;

        // pci_config_read_u8(seg, bus, dev, fn, 0x09) -> prog_if
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x09;
        call pci_config_read_u8;
        cmp rax, 0x01;                           // AHCI_PROG_IF
        jne ahci_pr_next;

        // Overflow guard.
        cmp r13, 4;                              // AHCI_MAX_DEVS
        jae ahci_pr_next;

        // Read BAR5 lo (u32 @ config +0x24).
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x24;
        call pci_config_read_u32;

        // rax = bar_lo. Check bit 0 (0 = MEM, 1 = IO).
        mov r10, rax;                            // r10 = bar_lo (preserve across next check)
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne ahci_pr_next;                        // I/O BAR -- not AHCI-conformant

        // Check bits [2:1]: only 00 (32-bit MEM) is valid for BAR5.
        mov r11, r10;
        shr r11, 1;
        and r11, 3;
        cmp r11, 0;
        jne ahci_pr_next;                        // 64-bit-type BAR5 -- malformed, skip

        // MEM32: abar_pa = bar_lo & ~0xF
        mov r15, r10;
        and r15, 0xFFFFFFFFFFFFFFF0;

        // Save abar_pa across the pci_find_cap calls.
        mov [rsp + 32], r15;

        // pci_find_cap(seg, bus, dev, fn, MSI-X=0x11) -> cap_msix_off
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x11;
        call pci_find_cap;
        mov rbp, rax;                            // rbp = cap_msix_off

        // pci_find_cap(seg, bus, dev, fn, MSI=0x05) -> cap_msi_off
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x05;
        call pci_find_cap;

        // Now populate _ahci_devices[j]. r15 = &_ahci_devices[j]
        mov r11, r13;
        shl r11, 5;
        lea r15, [rip + _ahci_devices];
        add r15, r11;

        // rax = cap_msi_off; rbp = cap_msix_off; [rsp+32] = abar_pa;
        // scratch [rsp+0..24] = seg/bus/dev/fn.

        // u16 seg @+0
        mov r10, [rsp + 0];
        mov_w [r15 + 0], r10;

        // u8 bus @+2
        mov r10, [rsp + 8];
        mov_b [r15 + 2], r10;

        // u8 dev @+3
        mov r10, [rsp + 16];
        mov_b [r15 + 3], r10;

        // u8 fn @+4
        mov r10, [rsp + 24];
        mov_b [r15 + 4], r10;

        // u8 pad0 = 0 @+5
        xor r10, r10;
        mov_b [r15 + 5], r10;

        // u16 cap_msix_off @+6
        mov_w [r15 + 6], rbp;

        // u64 abar_pa @+8
        mov r10, [rsp + 32];
        mov [r15 + 8], r10;

        // u16 cap_msi_off @+16
        mov_w [r15 + 16], rax;

        // u16 pad1 = 0 @+18, u32 pad2 = 0 @+20, u64 reserved = 0 @+24.
        xor r10, r10;
        mov_w [r15 + 18], r10;
        mov_d [r15 + 20], r10;
        mov [r15 + 24], r10;

        // j += 1
        add r13, 1;

      ahci_pr_next:
        add rbx, 1;
        jmp ahci_pr_loop;

      ahci_pr_done:
        // Publish device count.
        mov [rip + _ahci_device_count], r13;

        mov rax, r13;                            // return count

        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
