// src/kernel/core/drivers/backlight_pwm.pdx — R31.M5-003 (#1108)
//
// The kernel's PWM-backend scaffold for a KIND_BACKLIGHT with backend =
// BACKLIGHT_BACKEND_PWM. Registers, bind flag, refusal taxonomy and a
// honest DEFERRED_HARDWARE sentinel — but no MMIO store lands in this
// tree.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE INTEL BXT PWM BACKLIGHT CONTROLLER'S KERNEL-SIDE HALF, IN
// SCAFFOLD FORM. When the MMIO capability wiring lands, the write path
// programs three registers -- BLC_PWM_CTL1, BLC_PWM_FREQ1, BLC_PWM_DUTY1
// -- to enable the backlight and drive its duty cycle. Today it programs
// none: no MMIO capability exists in this tree that reaches this
// controller, and the honest sentinel this module returns for
// `backlight_pwm_write` on a bound driver is BACKLIGHT_PWM_DEFERRED_HARDWARE.
//
// IT IS NOT A LIVE DRIVER. Same discipline as ec_access.pdx's
// unarbitrated statement (#1580): the write path is stated as a
// SCAFFOLD, and the pin `backlight_pwm_arbitrated() == 0` -- an
// assertion that FAILS when a future milestone plumbs a real MMIO
// capability -- forces the design doc to be updated at that time. See
// §4 for the deferrals list.
//
// IT REGISTERS A KIND_BACKLIGHT INSTANCE WITH BACKEND=PWM. That
// registration happens through the same `backlight_cap_mint` route
// every other backlight capability arrives on; this module does NOT
// mint capabilities and does NOT touch _backlight_table.
// `kind_backlight.pdx` §5 documents the enumeration.
//
// =============================================================================
// §1  REGISTER LAYOUT (INTEL BXT eDP BLC)
// =============================================================================
//
// The three MMIO offsets, into the eDP display controller's register
// window at BAR0:
//
//   0xC8250  BLC_PWM_CTL1     enable + polarity + phase
//   0xC8254  BLC_PWM_FREQ1    period register (drives the frequency)
//   0xC8258  BLC_PWM_DUTY1    duty-cycle register (drives the level)
//
// BLC_PWM_ENABLE (bit 31 of CTL1) is the master enable. A future write
// path enables the bit at bind, writes FREQ1 once (from a firmware-
// advertised default), and writes DUTY1 per `backlight_pwm_write` call.
// TODAY NONE OF THESE STORES RUN.
//
// =============================================================================
// §2  ONE WRITER OF THE BIND FLAG
// =============================================================================
//
// Same discipline as ec_access_bind / battery_monitor_threshold_install:
// `backlight_pwm_bind` is the ONE writer of `_backlight_pwm_bound`. A
// second writer would be a second path claiming this driver is
// initialised without any capability check, and when the MMIO capability
// wires up (§4) the bind decision becomes load-bearing -- a stray write
// that pretended the driver was bound would then let the write path
// touch registers no capability authorised.
//
// tools/build.sh confines relocations against `_backlight_pwm_bound`
// and `_backlight_pwm_stats` to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Same discipline as kind_backlight.pdx §3. A level outside 16 bits is
// BAD_LEVEL and nothing is silently truncated. A write against an
// unbound driver is NOT_BOUND. A DEFERRED_HARDWARE outcome on a bound
// driver is the honest sentinel that says: this milestone did not take
// the MMIO capability, and the write you asked for did not happen; a
// caller that treats the sentinel as success has invented a claim this
// module does not carry.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO MMIO STORE runs from this module. The three register writes
//     that would program BLC_PWM_CTL1/FREQ1/DUTY1 are absent, because
//     no MMIO capability in this tree names the eDP display window
//     BAR0. A gated:hardware milestone plumbs a KIND_MMIO_WINDOW-
//     shaped capability through backlight_pwm_bind (arity TWO at that
//     point; this milestone leaves the seam at arity ZERO so a caller
//     cannot pretend a window is there).
//
//   * NO ARBITRATION against a firmware-owned display path. The BXT
//     display controller can be reached by SMM and by the
//     graphics-driver PSR (Panel Self-Refresh) subsystem, and neither
//     is coordinated with this driver today. backlight_pwm_arbitrated
//     returns 0; the boot witness pins it. When arbitration wires up,
//     the pin fails and the statement above is rewritten in the same
//     commit -- same device #1580 uses for the EC path.
//
//   * NO PANEL-SPECIFIC FREQUENCY. The FREQ1 write would take a
//     compositor-supplied period; today no compositor supplies one.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFE90..0xFFFFFE9F
// =============================================================================

module BacklightPwm = structure {

  // ==========================================================================
  // §1 register offsets. Constants, not written to memory anywhere in
  // this module -- they are the addresses a future write path would use.
  // ==========================================================================

  pub let BXT_BLC_PWM_CTL1_OFF   : u64 = 0xC8250
  pub let BXT_BLC_PWM_FREQ1_OFF  : u64 = 0xC8254
  pub let BXT_BLC_PWM_DUTY1_OFF  : u64 = 0xC8258
  pub let BXT_BLC_PWM_ENABLE_BIT : u64 = 0x80000000

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let BACKLIGHT_PWM_OK                : u64 = 0
  pub let BACKLIGHT_PWM_NOT_BOUND         : u64 = 0xFFFFFE9F
  pub let BACKLIGHT_PWM_BAD_LEVEL         : u64 = 0xFFFFFE9E
  pub let BACKLIGHT_PWM_BAD_MMIO          : u64 = 0xFFFFFE9D
  pub let BACKLIGHT_PWM_DEFERRED_HARDWARE : u64 = 0xFFFFFE9C

  // ==========================================================================
  // State.
  //
  //   _backlight_pwm_bound : 0 (unbound) or 1 (bound).
  //   _backlight_pwm_stats : counters, laid out as:
  //     +0  binds       binds accepted
  //     +8  writes      deferred-hardware refusals returned to callers
  //     +16 bad_level   refusals: level > 16 bits
  //     +24 not_bound   refusals: write before bind
  // ==========================================================================

  pub let mut _backlight_pwm_bound : u64 = 0
  pub let mut _backlight_pwm_stats : [u64; 8] = uninit @align(64)

  pub let BACKLIGHT_PWM_ST_BINDS     : u64 = 0
  pub let BACKLIGHT_PWM_ST_WRITES    : u64 = 1
  pub let BACKLIGHT_PWM_ST_BAD_LEVEL : u64 = 2
  pub let BACKLIGHT_PWM_ST_NOT_BOUND : u64 = 3
  pub let BACKLIGHT_PWM_ST_MAX       : u64 = 8

  // ==========================================================================
  // backlight_pwm_bind() -> BACKLIGHT_PWM_OK
  //
  // Set the bound flag. ARITY ZERO on purpose: a real bind takes an
  // MMIO capability, and the seam is left empty so a caller cannot
  // pretend a capability is there. When #4's gated:hardware milestone
  // lands, the seam becomes arity TWO ({mmio_slot, freq}) and the
  // confinement pin in tools/build.sh is updated in the same commit.
  // ==========================================================================

  pub let backlight_pwm_bind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-003 (#1108): mark the PWM backend scaffold bound. ARITY ZERO -- deliberately, because a real bind takes an MMIO capability and no such capability exists in this tree. Leaving the seam empty means a caller cannot forge a bind that claims a window it does not have; when the gated:hardware milestone lands, the arity moves to two and the confinement pin in tools/build.sh moves with it in the same commit. Increments _backlight_pwm_stats[0]. Leaf. Labels prefixed blpwm_bd_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _backlight_pwm_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _backlight_pwm_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // BACKLIGHT_PWM_OK
        ret
      }
    }

  // ==========================================================================
  // backlight_pwm_bound() -> 1 | 0
  // ==========================================================================

  pub let backlight_pwm_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-003 (#1108): 1 once backlight_pwm_bind has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _backlight_pwm_bound];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // backlight_pwm_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device ec_access_arbitrated uses (§4,
  // ec_access.pdx module header, #1580): a value a boot witness can
  // pin so that a future milestone plumbing a real coordination path
  // cannot land without breaking the pin and rewriting the claim.
  // ==========================================================================

  pub let backlight_pwm_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-003 (#1108): report whether writes through this backend are arbitrated against SMM and the graphics-driver PSR. IT RETURNS 0, because nothing in this tree coordinates the eDP display window with a firmware-owned or graphics-owned actor. The boot witness pins the result at 0 for the same reason ec_access_arbitrated is pinned: a claim in a comment rots silently, a value a test asserts on does not, and the milestone that closes the coordination gap cannot land without rewriting the statement that says it has not been closed. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // backlight_pwm_write(level) -> code
  //
  // The write seam. Validates 16-bit level, requires bind, returns
  // DEFERRED_HARDWARE on the happy path (no MMIO store in this tree).
  // ==========================================================================

  pub let backlight_pwm_write : (u64) -> u64 !{mem} @{} =
    fn (level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-003 (#1108): the write seam. Gates, in order: (1) level fits 16 bits (kind_backlight LEVEL_UPPER = 65535), else BAD_LEVEL and counted -- refused, not clamped, because a clamped level silently substitutes 0xFFFF for whatever the caller computed and hides the arithmetic bug that produced the wide value. (2) driver bound, else NOT_BOUND and counted. (3) the happy path returns DEFERRED_HARDWARE (an honest sentinel per §3), counted in the writes cell. NO REAL MMIO STORE RUNS: the gated:hardware milestone (§4) plumbs the KIND_MMIO_WINDOW capability that reaches BAR0, and until then a caller treating this outcome as success has invented a claim the module does not carry. Leaf. Labels prefixed blpwm_wr_ per reserved-label discipline.",
      block: {
        // (1) level fits 16 bits.
        mov r10, 0xFFFF;                 // BACKLIGHT_LEVEL_UPPER
        cmp rdi, r10;
        ja  blpwm_wr_bad_level;

        // (2) bound?
        lea r10, [rip + _backlight_pwm_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  blpwm_wr_not_bound;

        // (3) DEFERRED_HARDWARE.
        lea r10, [rip + _backlight_pwm_stats];
        mov rax, [r10 + 8];              // writes
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFE9C;             // BACKLIGHT_PWM_DEFERRED_HARDWARE
        ret;

      blpwm_wr_bad_level:
        lea r10, [rip + _backlight_pwm_stats];
        mov rax, [r10 + 16];             // bad_level
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFE9E;             // BACKLIGHT_PWM_BAD_LEVEL
        ret;

      blpwm_wr_not_bound:
        lea r10, [rip + _backlight_pwm_stats];
        mov rax, [r10 + 24];             // not_bound
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFE9F;             // BACKLIGHT_PWM_NOT_BOUND
        ret
      }
    }

  // ==========================================================================
  // backlight_pwm_writes() -> count
  // ==========================================================================

  pub let backlight_pwm_writes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-003 (#1108): read the count of deferred-hardware outcomes returned to callers. The counter is the only place a diagnostic can observe that this seam was exercised without a real bus transaction landing; when a bug reports has to answer 'did we ever try to write?' the counter says how many times, and no MMIO record exists to disagree with it. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _backlight_pwm_stats];
        mov rax, [r10 + 8];
        ret
      }
    }
}
