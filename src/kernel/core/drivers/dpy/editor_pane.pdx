  // Five leaf getters so a boot-witness programme can assert
  // (init_ct, set_text_ct, set_cursor_ct, apply_syntax_ct, present_ct)
  // without touching the _ed_*_ct symbols directly.
  // ==========================================================================

  pub let editor_init_ct : () -> u64 !{mem} @{} =
