  // ==========================================================================
  // §N  cap_handler_editor(rights, target_ptr, op_arg) -> u64
  //
  // KIND_EDITOR_PANE (0x58) cap_invoke dispatch handler. Reachable
  // from cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x58;
  // je call_kind_editor_pane` arm added alongside this file.
  //
  // The five main entrypoints each take more arguments than cap_
  // invoke's (rights, target_ptr, op_arg) slot admits (init takes 3,
  // set_text takes 3 including a pointer, set_cursor takes 2,
  // apply_syntax takes 1, present takes 0). apply_syntax and present
  // fit -- but at skeleton stage the handler is QUERY-ONLY to parallel
  // the direct_scanout / damage_plane / sdf_atlas / scrollback_pane
  // posture for a first slice. Eight ops:
  //
  //     op 0  ED_OP_QUERY_INITED           -> _ed_state[48]
  //     op 1  ED_OP_QUERY_INIT_CT          -> _ed_init_ct
  //     op 2  ED_OP_QUERY_SET_TEXT_CT      -> _ed_set_text_ct
  //     op 3  ED_OP_QUERY_SET_CURSOR_CT    -> _ed_set_cursor_ct
  //     op 4  ED_OP_QUERY_APPLY_SYNTAX_CT  -> _ed_apply_syntax_ct
  //     op 5  ED_OP_QUERY_PRESENT_CT       -> _ed_present_ct
  //     op 6  ED_OP_QUERY_SYNTAX_ID        -> _ed_state[40]
  //     op 7  ED_OP_QUERY_CURSOR_LINE      -> _ed_state[24]
  //     op 8  ED_OP_QUERY_CURSOR_COL       -> _ed_state[32]
  //     else                                  INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_ED_READ (0x001). target_ptr is
  // ignored at skeleton stage; a future per-pane layout would use it
  // as a pane cap selector (today there is one global pane).
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg.
  // Stack recipe: 3 callee-save pushes (rbx = rights, r12 = target_
  //   ptr, r13 = op_code).
  // ==========================================================================

  pub let R_ED_READ : u64 = 0x001

  pub let ED_OP_QUERY_INITED          : u64 = 0
  pub let ED_OP_QUERY_INIT_CT         : u64 = 1
  pub let ED_OP_QUERY_SET_TEXT_CT     : u64 = 2
  pub let ED_OP_QUERY_SET_CURSOR_CT   : u64 = 3
  pub let ED_OP_QUERY_APPLY_SYNTAX_CT : u64 = 4
  pub let ED_OP_QUERY_PRESENT_CT      : u64 = 5
  pub let ED_OP_QUERY_SYNTAX_ID       : u64 = 6
  pub let ED_OP_QUERY_CURSOR_LINE     : u64 = 7
  pub let ED_OP_QUERY_CURSOR_COL      : u64 = 8

  pub let cap_handler_editor : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 83 G16 (paideia-os#2553) skeleton: KIND_EDITOR_PANE (0x58) cap_invoke dispatch. Entry chatter (klog_s1 of ed_tag_handler_entry). op_code = op_arg & 0xFF; rights gate against R_ED_READ (single up-front check); dispatch 0..8 to the matching getter (editor_inited / editor_init_ct / editor_set_text_ct / editor_set_cursor_ct / editor_apply_syntax_ct / editor_present_ct / editor_syntax_id / editor_cursor_line / editor_cursor_col); else INVOKE_UNSUPPORTED. target_ptr is masked to its low byte on entry as a defensive bound for a future per-pane layout widen (today there is one global pane). Three callee-save pushes land rsp%16==0 at every nested call. The mutating ops (init / set_text / set_cursor / apply_syntax / present) are deferred to a follow-up slice. Labels prefixed ed_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rights
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                       // target = target_ptr[7:0]
        mov r13, rdx;                       // op_arg
        and r13, r10;                       // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ed_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                     // R_ED_READ
        cmp r10, 0;
        je  ed_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  ed_hd_op_inited;
        cmp r13, 1;
        je  ed_hd_op_init_ct;
        cmp r13, 2;
        je  ed_hd_op_st_ct;
        cmp r13, 3;
        je  ed_hd_op_sc_ct;
        cmp r13, 4;
        je  ed_hd_op_ap_ct;
        cmp r13, 5;
        je  ed_hd_op_pres_ct;
        cmp r13, 6;
        je  ed_hd_op_syntax;
        cmp r13, 7;
        je  ed_hd_op_curline;
        cmp r13, 8;
        je  ed_hd_op_curcol;
        jmp ed_hd_unsup;

      ed_hd_op_inited:
        call editor_inited;
        jmp ed_hd_out;

      ed_hd_op_init_ct:
        call editor_init_ct;
        jmp ed_hd_out;

      ed_hd_op_st_ct:
        call editor_set_text_ct;
        jmp ed_hd_out;

      ed_hd_op_sc_ct:
        call editor_set_cursor_ct;
        jmp ed_hd_out;

      ed_hd_op_ap_ct:
        call editor_apply_syntax_ct;
        jmp ed_hd_out;

      ed_hd_op_pres_ct:
        call editor_present_ct;
        jmp ed_hd_out;

      ed_hd_op_syntax:
        call editor_syntax_id;
        jmp ed_hd_out;

      ed_hd_op_curline:
        call editor_cursor_line;
        jmp ed_hd_out;

      ed_hd_op_curcol:
        call editor_cursor_col;
        jmp ed_hd_out;

      ed_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;        // INVOKE_DENIED
        jmp ed_hd_out;
      ed_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;        // INVOKE_UNSUPPORTED

      ed_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  Boot wiring note
  // ----------------
  // kernel_main.pdx does NOT need a dedicated reset entry: .bss zero-
  // init leaves _ed_state empty (bo_cap=0, cols=0, rows=0, cursor_
  // line=0, cursor_col=0, syntax_id=0, inited=0, so set_text /
  // set_cursor / apply_syntax / present all refuse until init is
  // called) and the five counters at zero. A follow-up slice may mint
  // a defensive `editor_reset` for parity with the other dpy drivers'
  // reset entries, but the skeleton gets by on .bss alone.
  //
  // invoke.pdx picks up the KIND_EDITOR_PANE (0x58) dispatch arm in
  // the same slice as this file -- the arm is pure plumbing and self-
  // standing (handler returns INVOKE_UNSUPPORTED for every mutating
  // op at skeleton stage, which is observable but harmless).
  //
  // No new klog wrapper is minted; the four fingerprints ride klog_
  // s1_d2 (INIT, SET_TEXT, CURSOR) and klog_s1_d1 (SYNTAX), both
  // pre-existing in klog/wrappers.pdx.
  //
  // Follow-up slices (G17 and later):
  //   - UTF-8 decode loop in editor_set_text against the Wave 59 I7
  //     utf8 primitives at core/text/utf8.pdx.
  //   - Tokenizer modules at core/text/syntax_pdx.pdx /
  //     syntax_markdown.pdx / syntax_rust.pdx, driven from editor_
  //     apply_syntax.
  //   - SDF glyph quad stamper in editor_present: for each cell,
  //     look up atlas tile via sdf_atlas_lookup(codepoint), apply
  //     the per-syntax palette, stamp into the cell's quad.
  //   - direct_scanout_arm plumbing in editor_present (behind an
  //     eligibility gate on bo_cap for pipe 0).
  //   - Dirty-row bitmap + damage_plane_submit integration.
  //   - cap_handler extension for the mutating ops once cap_invoke
  //     gains a 4-register slot variant OR the editor is willing to
  //     pack arguments into target_ptr/op_arg.
  //   - gpu_bo_alloc multi-page carve so a full 256*2048 pane fits
  //     in a single BO.
  // ==========================================================================
}
