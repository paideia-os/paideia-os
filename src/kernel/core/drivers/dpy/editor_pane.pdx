// src/kernel/core/drivers/dpy/editor_pane.pdx -- Wave 83 G16 [G8] (#2553)
//
// Syntax-highlighted editor-pane bind-up SKELETON for Wave 83 G16. A
// code-aware editor surface (paideia-edit) wants to render a 2-D grid
// of 24-byte text cells (codepoint + fg + bg + token_class + attr +
// reserved), where each cell carries a per-token classification that
// a shader (or a CPU color-table pass) uses to colour the glyph. The
// pane is a sibling of the Wave 82 G15 scrollback pane (scrollback_
// pane.pdx, #2552) and shares its backbone: a GPU BO holds the cell
// grid; the SDF atlas (sdf_atlas.pdx, Wave 79 G11, #2548) supplies the
// glyph tiles stamped at render time; a direct-scanout flip
// (direct_scanout.pdx, Wave 78 G8, #2545) delivers the finished tile
// to the panel. The editor adds ONE axis over the scrollback: a per-
// cell token_class field that lets a syntax highlighter steer per-
// glyph foreground colour from a table (per-syntax palette) rather
// than from a hard-coded fg_rgb written by the writer.
//
// This file sits beside direct_scanout.pdx (Wave 78 G8, #2545) which
// hands PLANE_SURF to a client-owned BO, damage_plane.pdx (Wave 79
// G9, #2546) which restricts the per-vblank DRAM read to the dirty
// subregion, sdf_atlas.pdx (Wave 79 G11, #2548) which holds the
// signed-distance-field glyph pack the shader samples at render time,
// and scrollback_pane.pdx (Wave 82 G15, #2552) which handles the
// scrollback half of the terminal story. editor_pane is a CLIENT of
// GPU BO (via a cap handed to editor_init), SDF atlas (for glyph
// tiles), and direct-scanout (for pipe arm at present time).
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// Posture: EVERY body here is a STUB per the Wave 83 G16 skeleton
// directive. The cell layout, pane sizing constants, error taxonomy,
// token-class enumeration, syntax-id enumeration, and fingerprint
// shapes are FROZEN at this skeleton stage so a follow-up slice can
// land the real body (UTF-8 decode, token classification via a tree-
// sitter-like parser, SDF glyph quad emission, direct-scanout commit)
// against the same ABI without churn. The static state block, the
// fingerprint tags, and the counter bumps are real; no GPU memory is
// written yet, no UTF-8 bytes are decoded, no tokens are classified,
// no PLANE_SURF is stamped.
//
// On the Wave 83 G16 skeleton, every entrypoint:
//   (1) range-checks its inputs and refuses with the matching
//       ED_ERR_* sentinel (0xFFFFFCB1..0xFFFFFCB5) on the first
//       failing rule;
//   (2) consults the G6 (KIND_GPU_BO_DRV, #2543) row accessors
//       (gpu_bo_row_size_pages) for the capacity gate on init;
//   (3) records the request into the single-pane state block;
//   (4) bumps the per-op counter so an operator can see the entry
//       on a boot-witness programme;
//   (5) emits a fingerprint so init / set_text / set_cursor /
//       apply_syntax events show up on the klog wire (present is
//       intentionally silent at skeleton stage -- the follow-up
//       slice minting the real MMIO body adds an `EDITOR PRESENT
//       pipe=<dec>` line alongside the direct_scanout_arm call).
//
// =============================================================================
// SECTION 1  CELL LAYOUT (24 bytes per cell)
// =============================================================================
//
// Each editor cell is a 24-byte record:
//
//     +0   codepoint     u32   -- Unicode scalar after UTF-8 decode
//                                (0 = blank; ASCII fits in low 7 bits;
//                                BMP in low 16; full plane in low 21)
//     +4   fg_rgb        u32   -- foreground colour (0x00RRGGBB; high
//                                byte reserved for a future alpha).
//                                Overridden by the per-token palette
//                                when token_class != PLAIN.
//     +8   bg_rgb        u32   -- background colour (same encoding)
//     +12  token_class   u32   -- syntax classification (0..8, see
//                                §2 below); the shader uses this to
//                                index the per-syntax colour table
//     +16  attr          u32   -- attribute byte in bits 0..7 (bold /
//                                italic / underline / inverse / strike
//                                / dim / blink / reserved); upper 24
//                                bits reserved for a future extension
//                                (link id, OSC-8 anchor, braille cell
//                                flags)
//     +20  reserved      u32   -- reserved for a future per-cell
//                                field (fold-group id, breakpoint
//                                flags, gutter marker, etc.)
//
// Fixed per-pane: 256 cols × 2048 rows × 24 B = 12 MiB max. Default
// row count is 1024, i.e. 256 × 1024 × 24 = 6 MiB. Addressable as a
// flat [u8; ED_CELLS_BYTES] array laid out in row-major order:
// cell(c, r) sits at base + (r * cols + c) * 24.
//
// Row-stride discipline: 24 is NOT a power of two, so the pdx encoder
// cannot admit `imul rax, 24` directly (two-operand `imul r, imm` is
// forbidden by the parser -- the "pdx encoder pitfalls" standing
// checklist calls this out). The admitted form is `mov r11, 24; imul
// rax, r11` (reg-reg); precedent at drivers/acpi/ec_quirks.pdx L510,
// L623, L684 for the 48-byte row stride (same shape, different magic
// number).
//
// Size reality check: 12 MiB is LARGER than the Wave 82 scrollback's
// 16 MiB (identical phys_alloc ceiling: Wave 75 phys_alloc currently
// backs ONE 4-KiB page per bo_alloc; G6 §Admission in kind_gpu_bo_
// drv.pdx §Design). The pane therefore CANNOT be backed by a single
// Wave 75 BO today -- the caller is expected to hand a BO whose size_
// pages is large enough for the (cols, rows) tuple, or editor_init
// will refuse. At skeleton stage, the init gate R4 compares the BO
// size against (cols * rows * 24) and refuses with ED_ERR_BAD_DIMS
// when insufficient -- so a caller handing a 4-KiB BO (the Wave 75
// maximum) can only ever drive a 170-col × 1-row pane (170 cells × 24
// B = 4080 bytes). A follow-up slice extends gpu_bo_alloc to carve a
// run of pages, at which point 256 × 512 (3 MiB) or 256 × 2048 (12
// MiB) become feasible. The ABI promises the limits (ED_MAX_COLS =
// 256, ED_MAX_ROWS = 2048); the actual achievable row count is
// whatever (bo_size_pages * 4096) / (cols * 24) tolerates.
//
// =============================================================================
// SECTION 2  TOKEN CLASSES (9 slots, 0..8)
// =============================================================================
//
// Each cell's token_class field is a u32 drawn from a frozen 9-entry
// enumeration. Follow-up slices add richer sub-classes under the
// same u32 (e.g. a per-language KEYWORD subclass for `fn` vs
// `return`); the skeleton locks the top-level taxonomy so the shader
// can treat token_class as a direct palette index.
//
//     0  TOK_PLAIN       -- unclassified text (default; falls back
//                           to the cell's own fg_rgb)
//     1  TOK_KEYWORD     -- language keyword (`fn`, `let`, `if`,
//                           `return`, `match`, ...)
//     2  TOK_STRING      -- string literal (including escapes, raw
//                           strings, and template-string content)
//     3  TOK_NUMBER      -- numeric literal (integer, float, hex,
//                           binary, octal; also unit suffixes if the
//                           language has them)
//     4  TOK_COMMENT     -- comment (line or block; doc-comments
//                           are a sub-class in follow-up slices)
//     5  TOK_IDENT       -- identifier (variable, function, type
//                           reference that is not itself a definition
//                           site)
//     6  TOK_OPERATOR    -- operator or punctuation (`+`, `->`,
//                           `::`, `?.`, braces, brackets, parens)
//     7  TOK_TYPE        -- type name (either in a type position or
//                           at a definition site like `type Foo = ...`)
//     8  TOK_ERROR       -- parse/lex error (unknown token, unclosed
//                           string, invalid escape); rendered in a
//                           high-contrast colour by convention
//
// =============================================================================
// SECTION 3  SYNTAX IDs (4 slots, 0..3)
// =============================================================================
//
// editor_apply_syntax switches the highlighter in place. The skeleton
// reserves four IDs; follow-up slices land the actual parsers.
//
//     0  SYNTAX_PLAIN    -- no highlighting; every cell stamped with
//                           token_class = TOK_PLAIN
//     1  SYNTAX_PDX      -- paideia-as .pdx source (reserved
//                           keywords from reference/paideia-as-
//                           reserved-labels.md; the pdx tokenizer is
//                           the follow-up slice's own file)
//     2  SYNTAX_MARKDOWN -- CommonMark + a few GFM extensions
//                           (tables, task-lists, fenced code blocks)
//     3  SYNTAX_RUST     -- Rust source (for paideia-as tooling and
//                           the handful of external bindings)
//
// A syntax_id outside 0..3 is refused with ED_ERR_BAD_SYNTAX_ID.
// Follow-up slices extend the enumeration by appending (slot 4 =
// TOML, slot 5 = JSON, etc.); never by renumbering the existing
// slots.
//
// =============================================================================
// SECTION 4  SET_TEXT SEMANTICS (overwrite a line; UTF-8 decode deferred)
// =============================================================================
//
// editor_set_text(line, text_ptr, len) overwrites row `line` with the
// UTF-8-encoded content at (text_ptr, len). Real body (follow-up slice):
//
//   (1) range-check line < rows (ED_ERR_BAD_LINE if not);
//   (2) zero the cells in row `line` (write 24 × cols zero bytes);
//   (3) decode (text_ptr, len) via core/text/utf8.pdx (Wave 59 I7,
//       not yet landed at Wave 83) one code point at a time;
//   (4) for each decoded code point: write the cell's codepoint field,
//       set token_class to TOK_PLAIN (the apply_syntax follow-up slice
//       re-classifies on the next tokenizer pass), leave fg/bg at the
//       pane default (follow-up: a per-syntax palette provides these
//       automatically from token_class);
//   (5) stop at min(len, cols) code points (over-long input is
//       truncated silently; the follow-up slice may add a soft-wrap
//       mode gate).
//
// At skeleton stage, this body:
//   (1) refuses if the pane is not inited (inited == 0 -> ED_ERR_BAD_BO);
//   (2) refuses if line >= rows (ED_ERR_BAD_LINE);
//   (3) refuses if text_ptr == 0 (null pointer -> ED_ERR_BAD_BO);
//   (4) bumps _ed_set_text_ct;
//   (5) emits `EDITOR SET_TEXT line=<dec> bytes=<dec>` via klog_s1_d2.
//
// No cell is written at skeleton stage. UTF-8 decode is deferred;
// token classification is deferred.
//
// =============================================================================
// SECTION 5  APPLY_SYNTAX SEMANTICS (re-tokenize deferred)
// =============================================================================
//
// editor_apply_syntax(syntax_id) switches the highlighter and
// (follow-up) re-walks every row's text through the new tokenizer,
// updating each cell's token_class in place. Real body (follow-up):
//
//   (1) validate syntax_id ∈ [0..3] (ED_ERR_BAD_SYNTAX_ID if not);
//   (2) if syntax_id == SYNTAX_PLAIN, zero every cell's token_class
//       in bulk (write 4 × cells zero bytes to the token_class field,
//       or memset the whole token_class column via a strided write);
//   (3) otherwise invoke the matching tokenizer (follow-up module
//       core/text/syntax_<lang>.pdx) over each row's codepoints,
//       writing each cell's token_class from the returned stream;
//   (4) record syntax_id in _ed_state[40] for present-time reads.
//
// At skeleton stage, this body:
//   (1) refuses if the pane is not inited (inited == 0 -> ED_ERR_BAD_BO);
//   (2) refuses if syntax_id > 3 (ED_ERR_BAD_SYNTAX_ID);
//   (3) records syntax_id into _ed_state[40];
//   (4) bumps _ed_apply_syntax_ct;
//   (5) emits `EDITOR SYNTAX id=<dec>` via klog_s1_d1.
//
// No re-tokenization is performed; every cell's token_class is
// untouched (and starts at TOK_PLAIN from the init path's
// zero-fill, or from whatever the follow-up set_text wrote).
//
// =============================================================================
// SECTION 6  CURSOR SEMANTICS (line, col; coarse clamp only)
// =============================================================================
//
// editor_set_cursor(line, col) moves the visible cursor to (line, col)
// in cell coordinates. Both axes are refused if out of range -- the
// skeleton clamps NEITHER; a caller handing (rows, 0) sees ED_ERR_BAD_
// LINE rather than a silent clamp to (rows - 1, 0). Follow-up slices
// may add a BIG_WARP mode that admits (0..rows, 0..cols) and clamps.
//
// Gates in order:
//   (R1) inited == 0           -> ED_ERR_BAD_BO
//   (R2) line >= rows          -> ED_ERR_BAD_LINE
//   (R3) col  >= cols          -> ED_ERR_BAD_COL
//
// Admission records (line, col) at (_ed_state[24], _ed_state[32]),
// bumps _ed_set_cursor_ct, emits `EDITOR CURSOR line=<dec> col=<dec>`
// via klog_s1_d2.
//
// =============================================================================
// SECTION 7  PRESENT SEMANTICS (direct_scanout_arm on primary pipe)
// =============================================================================
//
// editor_present() flips the finished tile to the panel. Real body
// (follow-up slice):
//
//   (1) Compute host_pa from gpu_bo_row_host_pa(bo_cap).
//   (2) Validate direct_scanout_eligibility(bo_cap, 0, cols*8, rows*16)
//       (glyph cell is 8 × 16 at SDF atlas default scale -- the
//       scale knob is a follow-up extension).
//   (3) For every cell with non-zero codepoint: look up the atlas
//       tile via sdf_atlas_lookup(codepoint); apply fg colour from
//       the per-syntax palette indexed by token_class (if syntax
//       != PLAIN) or from cell.fg_rgb (if syntax == PLAIN); stamp
//       the SDF tile into the cell's quad in the BO.
//   (4) Call direct_scanout_arm(bo_cap, 0) to stamp PLANE_SURF.
//   (5) Mark cells as clean (follow-up adds a dirty-row bitmap).
//
// Gate: inited == 0 -> ED_ERR_BAD_BO.
//
// The skeleton stops at the gate + counter bump; it does NOT call
// direct_scanout_arm (doing so at skeleton stage would record a
// never-cleared armed state on pipe 0 in direct_scanout.pdx's per-
// pipe state block, surfacing in direct_scanout_arm_ct and
// direct_scanout_armed_bo as if editor had a live scanout --
// misleading on a boot-witness programme that lands this slice
// alone). The present counter (_ed_present_ct) is still bumped so
// the entry is visible; no fingerprint is emitted (per the Wave 83
// G16 task directive, which lists INIT / SET_TEXT / CURSOR / SYNTAX
// only).
//
// =============================================================================
// SECTION 8  FAILURE TAXONOMY -- 0xFFFFFCB1..0xFFFFFCB5
// =============================================================================
//
// Five codes reserved for this module. The task directive asked for
// 0xFFFFFCAA..AE; that band is CLAIMED at Wave 83 landing:
//   - 0xFFFFFCAB..0xFFFFFCAF taken by core/ipc/audio_routing_channel.
//     pdx (AUDIO_ROUTING_BAD_RESERVED / BAD_MUTE / BAD_GAIN / BAD_SLOT
//     / BAD_OP), leaving only 0xFFFFFCAA free of the requested quintet
//     -- insufficient.
//   - The sub-page 0xFFFFFCB1..0xFFFFFCB9 was free at landing time
//     (`grep -rln '0xFFFFFCB[1-9]' src/kernel/` returned ZERO hits),
//     so this file takes 0xFFFFFCB1..0xFFFFFCB5. Same posture as
//     Wave 82 G15 scrollback_pane.pdx, which also had to shift its
//     band one quintet when the task-directive band was pre-claimed.
//
// Values:
//
//     0xFFFFFCB1  ED_ERR_BAD_BO         -- bo_cap == 0, text_ptr == 0,
//                                          or set_text / set_cursor /
//                                          apply_syntax / present
//                                          called on a pane whose
//                                          inited slot is 0 (never-
//                                          initialised)
//     0xFFFFFCB2  ED_ERR_BAD_DIMS       -- cols == 0, cols > 256,
//                                          rows == 0, rows > 2048, or
//                                          bo_size_bytes < cols*rows*24
//                                          (BO too small to back the
//                                          requested cell count)
//     0xFFFFFCB3  ED_ERR_BAD_LINE       -- line >= rows (out of range
//                                          for set_text or set_cursor)
//     0xFFFFFCB4  ED_ERR_BAD_COL        -- col >= cols (out of range
//                                          for set_cursor)
//     0xFFFFFCB5  ED_ERR_BAD_SYNTAX_ID  -- syntax_id > 3 (out of range
//                                          for apply_syntax)
//
// =============================================================================
// SECTION 9  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized stores): the real body's cell writes use mov_d for the
//      per-u32 field stores (codepoint / fg / bg / token_class / attr
//      / reserved are 32-bit each). The static state block slots are
//      u64 so plain REX.W `mov` is correct for every slot access.
//   G4 (full-register compares): every cmp here is on a 64-bit
//      register; no `cmp al, imm`, no `cmp eax, imm` short-form.
//   No `test rN, rN` -- equality-against-zero is `cmp rN, 0`.
//   No `and rN, imm64` -- all mask constants fit imm8 (0xFF for byte
//      extracts in the cap handler) and use the direct form.
//   No two-operand `imul r, imm` -- cell_bytes = cols * rows * 24 is
//      `imul rax, r13` (cols*rows) followed by `mov r11, 24; imul rax,
//      r11` (reg-reg form, admitted; see ec_quirks.pdx L510 precedent
//      for the ×48 row-stride on an identical shape).
//   64-bit immediates -- the return-code constants (0xFFFFFCB1..B5)
//      fit imm32 with bit 31 set, so the pdx encoder emits them via
//      the full REX.W `mov r64, imm64` form; proven form across
//      every FD/FC-band driver (direct_scanout.pdx, damage_plane.pdx,
//      scrollback_pane.pdx).
//   Multiline `pub let ="..."` is forbidden by the pdx parser; every
//      tag below is a single line.
//   Module basename matches filename basename:
//      editor_pane.pdx -> module EditorPane.
//   Reserved labels -- every label in this file is prefixed `ed_` so
//      none collides with the ds_/dp_/ixc_/plpr_/kbd_/tp_/sb_ labels
//      of the sibling dpy and input drivers, and none accidentally
//      spells `loop`, `if`, or `let` (paideia-as reserved keywords).
//   klog wrapper discipline -- the four fingerprints each ride an
//      EXISTING wrapper to avoid gratuitous klog mint churn:
//        INIT     cols=<dec> rows=<dec>  -> klog_s1_d2
//        SET_TEXT line=<dec> bytes=<dec> -> klog_s1_d2
//        CURSOR   line=<dec> col=<dec>   -> klog_s1_d2
//        SYNTAX   id=<dec>               -> klog_s1_d1
//      klog_s1_d2 caller contract (1 stack arg = v2 at caller [rsp+0];
//      wrapper reads at [rbp+16] after its push rbp): `sub rsp, 16;
//      mov [rsp+0], vd; CALL; add rsp, 16`. Writing vd at [rsp+8]
//      lands it at [rbp+24] inside the wrapper and the real value
//      never reaches the fingerprint -- the klog_s1_d2 caller trap
//      that has burned 5+ softarchs this session. klog_s1_d1 fits
//      all 5 args in rdi..r8 and takes no stack arg.
//   Fingerprint tag length -- each [u8; N] tag's N is strlen + 1
//      (NUL terminator); tag_len off-by-one is a build-time error
//      the pdx encoder catches.
//
// =============================================================================
// SECTION 10  STACK + REGISTER PLAN
// =============================================================================
//
// Six entrypoints (plus the cap handler):
//
//   editor_init           (bo_cap, cols, rows)              -> u64
//   editor_set_text       (line, text_ptr, len)             -> u64
//   editor_set_cursor     (line, col)                       -> u64
//   editor_apply_syntax   (syntax_id)                       -> u64
//   editor_present        ()                                -> u64
//   cap_handler_editor    (rights, target_ptr, op_arg)      -> u64
//
// All seven are non-leaf (nested calls into gpu_bo_row_size_pages /
// klog_* / sibling getters). Each uses the standard callee-save
// prologue:
//
//   push rbx; push r12; push r13;              // 3-push, 24 B
//   -- entry rsp%16 == 8; after 3 pushes rsp%16 == 0 (pre-CALL)
//
//   push rbx; push r12; push r13; push r14; push r15;  // 5-push, 40 B
//   -- entry rsp%16 == 8; after 5 pushes rsp%16 == 0 (pre-CALL)
//
// editor_init uses 5 pushes (rbx=bo_cap, r12=cols, r13=rows, r14=
// cell_bytes_need, r15=state_base_or_have_bytes). Then `sub rsp, 16;
// mov [rsp+0], r13` to stage v2=rows for klog_s1_d2 (scrollback
// precedent, §E). `add rsp, 16` reclaims.
//
// editor_set_text uses 5 pushes (rbx=line, r12=text_ptr, r13=len,
// r14=rows_cached, r15=scratch). `sub rsp, 16; mov [rsp+0], r13` to
// stage v2=len for klog_s1_d2. `add rsp, 16` reclaims.
//
// editor_set_cursor uses 5 pushes (rbx=line, r12=col, r13=scratch,
// r14=rows_cached, r15=cols_cached). `sub rsp, 16; mov [rsp+0], r12`
// to stage v2=col for klog_s1_d2. `add rsp, 16` reclaims.
//
// editor_apply_syntax uses 3 pushes (rbx=syntax_id, r12=scratch,
// r13=scratch). klog_s1_d1 takes 5 reg args only; no stack staging
// needed.
//
// editor_present uses 3 pushes (rbx=scratch, r12=scratch, r13=
// scratch). No fingerprint; no stack staging.
//
// cap_handler_editor uses 3 pushes (rbx=rights, r12=target_ptr,
// r13=op_code). klog_s1 entry chatter needs 3 reg args only (no stack).
//
// =============================================================================
// SECTION 11  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file compiles
// alongside the kernel because tools/build.sh recurses through
// src/kernel/core/drivers/dpy/ with a single `find`, so a new .pdx
// in that directory is picked up automatically; no build.sh edit
// required.
//
// invoke.pdx gets ONE new dispatch arm (0x58 -> cap_handler_editor)
// landed alongside this file (see invoke.pdx §Wave 83 G16 arm) so the
// kind is reachable from cap_invoke the moment this skeleton lands.
// Audit at landing time: `grep -nE 'cmp rcx, 0x58\b' src/kernel/core/
// cap/invoke.pdx` returned ZERO existing dispatch arms; the Wave 82
// I4 KIND_NTB_PROBE (0x57) arm immediately above and the Wave 82 G15
// KIND_SCROLLBACK (0x56) arm two slots up leave 0x58 as the next
// natural slot. 0x58 fits imm32 bit 31 clear (sign-extend-safe);
// direct `cmp rcx, 0x58` form, no r9 staging, same posture as every
// other sub-0x80 kind in this block.
//
// No new klog wrapper is minted; the four fingerprints ride klog_s1_
// d2 (INIT, SET_TEXT, CURSOR) and klog_s1_d1 (SYNTAX), both pre-
// existing in klog/wrappers.pdx.
//
// No caller invokes editor_* yet. A follow-up slice adds a boot-
// witness programme at tests/kernel/drivers/wit_editor_pane.pdx
// that:
//   (1) editor_init(bo, 80, 24) -> ED_OK (small pane that fits in a
//       4-KiB Wave 75 BO: 80*24*24 = 46080 bytes, 12 pages);
//   (2) editor_set_text(0, "fn main()", 9) -> ED_OK;
//   (3) editor_set_cursor(0, 2) -> ED_OK;
//   (4) editor_apply_syntax(1) -> ED_OK (SYNTAX_PDX);
//   (5) editor_present() -> ED_OK;
// and asserts the INIT / SET_TEXT / CURSOR / SYNTAX fingerprints
// land on the klog wire.
//
// =============================================================================
// SECTION 12  FOLLOW-UP SLICES
// =============================================================================
//
//   - Real UTF-8 decode loop in editor_set_text against core/text/
//     utf8.pdx (I7, not yet landed at Wave 83).
//   - Real tokenizer modules at core/text/syntax_pdx.pdx / syntax_
//     markdown.pdx / syntax_rust.pdx; invoked from editor_apply_
//     syntax to re-walk every row and update token_class per cell.
//     The tree-sitter-like design (incremental re-parse keyed on a
//     dirty-row bitmap) is deferred.
//   - Real SDF glyph quad stamper in editor_present: for each cell
//     at (line, col) in [0..rows, 0..cols), look up atlas tile via
//     sdf_atlas_lookup(codepoint), apply per-token-class fg colour
//     from the syntax palette (SYNTAX_PDX / SYNTAX_MARKDOWN /
//     SYNTAX_RUST each ship their own 9-entry palette), copy the
//     SDF tile into the cell's quad in the BO.
//   - Real direct_scanout_arm plumbing in editor_present (behind
//     an eligibility gate on bo_cap for pipe 0).
//   - Dirty-row bitmap + damage_plane_submit integration (only re-
//     stamp the rows that changed since the last present; a
//     set_text invalidates one row; apply_syntax invalidates all).
//   - cap_handler extension: ops to query cursor_line / cursor_col /
//     syntax_id; the mutating ops (init / set_text / set_cursor /
//     apply_syntax / present) ride supervisor callers because their
//     arg counts exceed the cap_invoke (rights, target_ptr, op_arg)
//     slot.
//   - gpu_bo_alloc multi-page carve so a full 256*2048 pane fits in
//     a single BO; today's Wave 75 BO backs ≤ 170 cells.
//   - Soft-wrap mode in editor_set_text (overflow spills to the
//     next row with a continuation marker in the cell.reserved
//     field).
//   - Selection + search highlights overlay via a second token_class
//     column (reserved bit in cell.attr marks "selection active"
//     without clobbering the per-syntax colour).
// =============================================================================

module EditorPane = structure {

  // ==========================================================================
  // §A  Pane geometry constants
  // ==========================================================================

  pub let ED_MAX_COLS       : u64 = 256
  pub let ED_MAX_ROWS       : u64 = 2048
  pub let ED_CELL_BYTES     : u64 = 24

  // The default row count paideia-edit asks for on T14 G4 once multi-
  // page BO carves land. Documented so a reviewer sees the target
  // without reading the task directive.
  pub let ED_DEFAULT_ROWS   : u64 = 1024

  // Cell field offsets (within one 24-byte cell).
  pub let ED_CELL_CODEPOINT_OFF   : u64 = 0
  pub let ED_CELL_FG_OFF          : u64 = 4
  pub let ED_CELL_BG_OFF          : u64 = 8
  pub let ED_CELL_TOKEN_CLASS_OFF : u64 = 12
  pub let ED_CELL_ATTR_OFF        : u64 = 16
  pub let ED_CELL_RESERVED_OFF    : u64 = 20

  // ==========================================================================
  // §B  Token class enumeration (see §2 of the file header)
  //
  // Per-cell token_class field values. The shader (or CPU palette
  // pass) uses these as direct indices into the per-syntax 9-entry
  // colour table.
  // ==========================================================================

  pub let TOK_PLAIN     : u64 = 0
  pub let TOK_KEYWORD   : u64 = 1
  pub let TOK_STRING    : u64 = 2
  pub let TOK_NUMBER    : u64 = 3
  pub let TOK_COMMENT   : u64 = 4
  pub let TOK_IDENT     : u64 = 5
  pub let TOK_OPERATOR  : u64 = 6
  pub let TOK_TYPE      : u64 = 7
  pub let TOK_ERROR     : u64 = 8

  pub let TOK_MAX       : u64 = 8

  // ==========================================================================
  // §C  Syntax id enumeration (see §3 of the file header)
  //
  // The highlighter selector passed to editor_apply_syntax. A follow-
  // up slice extends this enumeration by appending; existing slot
  // numbers never renumber.
  // ==========================================================================

  pub let SYNTAX_PLAIN    : u64 = 0
  pub let SYNTAX_PDX      : u64 = 1
  pub let SYNTAX_MARKDOWN : u64 = 2
  pub let SYNTAX_RUST     : u64 = 3

  pub let SYNTAX_MAX      : u64 = 3

  // ==========================================================================
  // §D  Failure taxonomy -- band 0xFFFFFCB1..0xFFFFFCB5
  //
  // See §8 of the file header for the band provenance (task directive
  // asked for 0xFFFFFCAA..AE; that quintet is CLAIMED by audio_routing_
  // channel.pdx at 0xFFFFFCAB..AF, so this file takes a free quintet
  // at 0xFFFFFCB1..B5).
  // ==========================================================================

  pub let ED_OK                  : u64 = 0
  pub let ED_ERR_BAD_BO          : u64 = 0xFFFFFCB1
  pub let ED_ERR_BAD_DIMS        : u64 = 0xFFFFFCB2
  pub let ED_ERR_BAD_LINE        : u64 = 0xFFFFFCB3
  pub let ED_ERR_BAD_COL         : u64 = 0xFFFFFCB4
  pub let ED_ERR_BAD_SYNTAX_ID   : u64 = 0xFFFFFCB5

  // ==========================================================================
  // §E  Pane state -- 7 u64 slots for the single global pane.
  //
  // Layout (56 bytes total):
  //   +0   bo_cap          -- GPU BO cap backing the cell grid
  //                           (0 before init; non-zero after)
  //   +8   cols            -- columns admitted at init time
  //                           (0 if never inited)
  //   +16  rows            -- rows admitted at init time
  //   +24  cursor_line     -- current cursor row (0..rows-1)
  //   +32  cursor_col      -- current cursor column (0..cols-1)
  //   +40  syntax_id       -- active highlighter (0..3)
  //   +48  inited          -- 1 iff editor_init succeeded
  //
  // Single pane per editor at Wave 83 (not per-pipe) because paideia-
  // edit is a single-focus surface. A follow-up slice promotes this
  // to a slab (one row per pane cap) once split-pane editors land.
  // ==========================================================================

  pub let mut _ed_state : [u64; 7] = uninit @align(64)

  // Per-op stats (bumped once per successful entry). Visible via the
  // getter quintet in §L.
  pub let mut _ed_init_ct          : u64 = 0
  pub let mut _ed_set_text_ct      : u64 = 0
  pub let mut _ed_set_cursor_ct    : u64 = 0
  pub let mut _ed_apply_syntax_ct  : u64 = 0
  pub let mut _ed_present_ct       : u64 = 0

  // ==========================================================================
  // §F  Fingerprint tags + keys
  //
  // Four tags, one per observable entrypoint (present is silent at
  // skeleton stage per the Wave 83 G16 task directive). Each is a
  // single-line string literal (the multiline `pub let ="..."` form
  // is forbidden by the pdx parser). Tag length is `strlen + 1` (NUL
  // terminator) so a tag_len off-by-one is a build-time error.
  //
  // Fingerprints on the wire:
  //   EDITOR INIT cols=<dec> rows=<dec>
  //   EDITOR SET_TEXT line=<dec> bytes=<dec>
  //   EDITOR CURSOR line=<dec> col=<dec>
  //   EDITOR SYNTAX id=<dec>
  //
  // Matches tests/fingerprints/editor_pane.golden pattern.
  // ==========================================================================

  pub let ed_tag_init     : [u8; 12] = "EDITOR INIT\0"
  pub let ed_tag_set_text : [u8; 16] = "EDITOR SET_TEXT\0"
  pub let ed_tag_cursor   : [u8; 14] = "EDITOR CURSOR\0"
  pub let ed_tag_syntax   : [u8; 14] = "EDITOR SYNTAX\0"

  pub let ed_k_cols  : [u8; 5] = "cols\0"
  pub let ed_k_rows  : [u8; 5] = "rows\0"
  pub let ed_k_line  : [u8; 5] = "line\0"
  pub let ed_k_bytes : [u8; 6] = "bytes\0"
  pub let ed_k_col   : [u8; 4] = "col\0"
  pub let ed_k_id    : [u8; 3] = "id\0"

  // Handler-entry chatter tag (for the cap-handler path).
  pub let ed_tag_handler_entry : [u8; 21] = "EDITOR handler entry\0"

  // ==========================================================================
  // §G  editor_init(bo_cap, cols, rows) -> u64
  //
  // Initialise the global editor pane: validate (cols, rows) against
  // the fixed limits, validate bo_cap is nonzero AND its backing
  // memory is large enough for (cols * rows * 24) bytes, then record
  // the geometry + bo_cap + reset the cursor + syntax_id.
  //
  // Gates in order:
  //   (R1) cols == 0 || cols > ED_MAX_COLS   -> ED_ERR_BAD_DIMS
  //   (R2) rows == 0 || rows > ED_MAX_ROWS   -> ED_ERR_BAD_DIMS
  //   (R3) bo_cap == 0                       -> ED_ERR_BAD_BO
  //   (R4) gpu_bo_row_size_pages(bo_cap) * 4096 < cols * rows * 24
  //                                          -> ED_ERR_BAD_DIMS
  //
  // On admission the body:
  //   (a) writes bo_cap   to _ed_state[0];
  //   (b) writes cols     to _ed_state[8];
  //   (c) writes rows     to _ed_state[16];
  //   (d) writes 0        to _ed_state[24] (cursor_line);
  //   (e) writes 0        to _ed_state[32] (cursor_col);
  //   (f) writes 0        to _ed_state[40] (syntax_id = SYNTAX_PLAIN);
  //   (g) writes 1        to _ed_state[48] (inited);
  //   (h) bumps _ed_init_ct;
  //   (i) emits `EDITOR INIT cols=<dec> rows=<dec>` via klog_s1_d2.
  //
  // No fingerprint on the gate-failing paths -- the error code in rax
  // is the only observable, same posture as direct_scanout and
  // damage_plane and scrollback_pane.
  //
  // SysV: rdi = bo_cap, rsi = cols, rdx = rows.
  // Stack recipe: 5 callee-save pushes (rbx = bo_cap, r12 = cols,
  //   r13 = rows, r14 = cell_bytes_need, r15 = state base or scratch).
  // ==========================================================================

  pub let editor_init : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (bo_cap: u64, cols: u64, rows: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 83 G16 (paideia-os#2553) skeleton: validation gate chain over (bo_cap, cols, rows). Rules in order: (R1) cols == 0 || cols > ED_MAX_COLS(256) -> ED_ERR_BAD_DIMS (0xFFFFFCB2); (R2) rows == 0 || rows > ED_MAX_ROWS(2048) -> ED_ERR_BAD_DIMS; (R3) bo_cap == 0 -> ED_ERR_BAD_BO (0xFFFFFCB1); (R4) gpu_bo_row_size_pages(bo_cap) * 4096 < cols*rows*24 -> ED_ERR_BAD_DIMS (BO too small). Admission records (bo_cap, cols, rows, 0, 0, 0, 1) at _ed_state + bumps _ed_init_ct + emits `EDITOR INIT cols=<dec> rows=<dec>` via klog_s1_d2 (v2=rows at caller [rsp+0]). Register plan: rbx = bo_cap (saved), r12 = cols (saved), r13 = rows (saved), r14 = cell-bytes-need, r15 = _ed_state base or have-bytes scratch. Five callee-save pushes land rsp%16==0 at every nested call (entry %16==8, +40 -> 48, %16==0; the firmware_blob five-push discipline). klog_s1_d2 caller contract: `sub rsp, 16; mov [rsp+0], r13` writes v2=rows to caller [rsp+0]. 24-byte cell stride uses `mov r11, 24; imul rax, r11` (reg-reg form; the pdx encoder forbids 2-op `imul r, imm` but admits reg-reg; see ec_quirks.pdx L510 for the ×48 precedent). Labels prefixed ed_init_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = bo_cap (saved)
        mov r12, rsi;                       // r12 = cols (saved)
        mov r13, rdx;                       // r13 = rows (saved)

        // --- Gate (R1): cols in (0, ED_MAX_COLS].
        cmp r12, 0;
        je  ed_init_bad_dims;
        mov r10, 256;                       // ED_MAX_COLS
        cmp r12, r10;
        ja  ed_init_bad_dims;

        // --- Gate (R2): rows in (0, ED_MAX_ROWS].
        cmp r13, 0;
        je  ed_init_bad_dims;
        mov r10, 2048;                      // ED_MAX_ROWS
        cmp r13, r10;
        ja  ed_init_bad_dims;

        // --- Gate (R3): bo_cap != 0.
        cmp rbx, 0;
        je  ed_init_bad_bo;

        // --- Gate (R4): size check.
        //     need_bytes = cols * rows * 24.
        //     have_bytes = size_pages * 4096 = size_pages << 12.
        //     if have_bytes < need_bytes -> ED_ERR_BAD_DIMS.
        mov rdi, rbx;
        call gpu_bo_row_size_pages;
        // rax = size_pages (or GPU_BO_DECODE_BAD = 0xFFFFFFFFFFFFFFFF).
        // On DECODE_BAD, shl rax, 12 saturates high and the size-
        // compare below treats the row as "large enough" by false-
        // positive; the real-body slice intercepts DECODE_BAD
        // explicitly. At skeleton stage, DECODE_BAD on R3-passing
        // (bo_cap != 0) implies a bogus cap, and the admission is
        // harmless because no cell is written.
        shl rax, 12;                        // rax = have_bytes
        mov r15, rax;                       // r15 = have_bytes (temp)

        //     need_bytes = (cols * rows) * 24.
        mov rax, r12;                       // rax = cols
        imul rax, r13;                      // rax = cols * rows
        mov r11, 24;                        // 24-byte cell stride
        imul rax, r11;                      // rax = cols * rows * 24
        mov r14, rax;                       // r14 = need_bytes

        cmp r15, r14;                       // have vs need
        jb  ed_init_bad_dims;

        // --- Admitted. Compute _ed_state base.
        lea r15, [rip + _ed_state];

        // --- Record state.
        mov [r15 + 0],  rbx;                // bo_cap
        mov [r15 + 8],  r12;                // cols
        mov [r15 + 16], r13;                // rows
        xor rax, rax;
        mov [r15 + 24], rax;                // cursor_line = 0
        mov [r15 + 32], rax;                // cursor_col  = 0
        mov [r15 + 40], rax;                // syntax_id   = SYNTAX_PLAIN
        mov rax, 1;
        mov [r15 + 48], rax;                // inited = 1

        // --- Count the init (bump BEFORE fingerprint so a crash
        //     mid-fingerprint still records the entry).
        mov rax, [rip + _ed_init_ct];
        add rax, 1;
        mov [rip + _ed_init_ct], rax;

        // --- klog_s1_d2(level=3, SUBSYS_DRV_, tag_init, k_cols,
        //                cols, k_rows, [v2=rows]).
        //
        // After 5 callee-save pushes rsp%16==0 (entry %16==8, +40 =
        // 48, %16==0). `sub rsp, 16` reserves the v2 slot AND keeps
        // alignment; the wrapper reads v2 at [rbp+16] after its own
        // `push rbp` (which is exactly what caller [rsp+0] + CALL
        // (-8) + push rbp (-8) resolves to).
        sub rsp, 16;
        mov [rsp + 0], r13;                 // v2 = rows (caller [rsp+0])
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ed_tag_init];
        lea rcx, [rip + ed_k_cols];
        mov r8, r12;                        // v1 = cols
        lea r9, [rip + ed_k_rows];
        call klog_s1_d2;
        add rsp, 16;                        // reclaim pad + v2 slot

        xor rax, rax;                       // ED_OK
        jmp ed_init_out;

      ed_init_bad_dims:
        mov rax, 0xFFFFFCB2;                // ED_ERR_BAD_DIMS
        jmp ed_init_out;
      ed_init_bad_bo:
        mov rax, 0xFFFFFCB1;                // ED_ERR_BAD_BO

      ed_init_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  editor_set_text(line, text_ptr, len) -> u64
  //
  // Overwrite row `line` with the UTF-8-encoded content at (text_ptr,
  // len). The real body decodes each code point via core/text/utf8.
  // pdx (I7, not yet landed at Wave 83) and writes the codepoint field
  // of each cell at (line, 0..min(len, cols)); token_class is left at
  // TOK_PLAIN (the apply_syntax follow-up re-classifies).
  //
  // Gates in order:
  //   (R1) inited == 0           -> ED_ERR_BAD_BO
  //   (R2) text_ptr == 0         -> ED_ERR_BAD_BO
  //   (R3) line >= rows          -> ED_ERR_BAD_LINE
  //
  // At skeleton stage no cell is written; the counter is bumped and
  // the fingerprint `EDITOR SET_TEXT line=<dec> bytes=<dec>` is emitted
  // via klog_s1_d2 with v2=len.
  //
  // SysV: rdi = line, rsi = text_ptr, rdx = len.
  // Stack recipe: 5 callee-save pushes (rbx = line, r12 = text_ptr,
  //   r13 = len, r14 = rows_cached, r15 = scratch).
  // ==========================================================================

  pub let editor_set_text : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (line: u64, text_ptr: u64, len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 83 G16 (paideia-os#2553) skeleton: refuses if _ed_state[48] (inited) == 0 (ED_ERR_BAD_BO 0xFFFFFCB1), if text_ptr == 0 (also ED_ERR_BAD_BO, treating a null byte pointer as a bad input), or if line >= _ed_state[16] (rows) (ED_ERR_BAD_LINE 0xFFFFFCB3). On admission bumps _ed_set_text_ct + emits `EDITOR SET_TEXT line=<dec> bytes=<dec>` via klog_s1_d2 (v2=len at caller [rsp+0]). UTF-8 decode and cell writes are DEFERRED to the follow-up slice that lands core/text/utf8.pdx; skeleton does not touch cell memory. Register plan: rbx = line (saved), r12 = text_ptr (saved), r13 = len (saved), r14 = rows cached from _ed_state[16], r15 = scratch for inited load. Five callee-save pushes land rsp%16==0 at every nested call. klog_s1_d2 caller contract: `sub rsp, 16; mov [rsp+0], r13` writes v2=len to caller [rsp+0]. Labels prefixed ed_st_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = line (saved)
        mov r12, rsi;                       // r12 = text_ptr (saved)
        mov r13, rdx;                       // r13 = len (saved)

        // --- Gate (R1): inited == 0 -> ED_ERR_BAD_BO.
        lea r15, [rip + _ed_state];
        mov rax, [r15 + 48];                // rax = inited
        cmp rax, 0;
        je  ed_st_bad_bo;

        // --- Gate (R2): text_ptr == 0 -> ED_ERR_BAD_BO.
        cmp r12, 0;
        je  ed_st_bad_bo;

        // --- Gate (R3): line >= rows -> ED_ERR_BAD_LINE.
        mov r14, [r15 + 16];                // r14 = rows
        cmp rbx, r14;
        jae ed_st_bad_line;

        // --- UTF-8 decode + cell stamping DEFERRED. Skeleton
        //     proceeds to counter bump + fingerprint without touching
        //     the cell grid.

        // --- Count the set_text.
        mov rax, [rip + _ed_set_text_ct];
        add rax, 1;
        mov [rip + _ed_set_text_ct], rax;

        // --- klog_s1_d2(level=3, SUBSYS_DRV_, tag_set_text, k_line,
        //                line, k_bytes, [v2=len]).
        sub rsp, 16;
        mov [rsp + 0], r13;                 // v2 = len (caller [rsp+0])
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ed_tag_set_text];
        lea rcx, [rip + ed_k_line];
        mov r8, rbx;                        // v1 = line
        lea r9, [rip + ed_k_bytes];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                       // ED_OK
        jmp ed_st_out;

      ed_st_bad_bo:
        mov rax, 0xFFFFFCB1;                // ED_ERR_BAD_BO
        jmp ed_st_out;
      ed_st_bad_line:
        mov rax, 0xFFFFFCB3;                // ED_ERR_BAD_LINE

      ed_st_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  editor_set_cursor(line, col) -> u64
  //
  // Move the visible cursor to (line, col) in cell coordinates. The
  // skeleton clamps nothing; a caller handing (rows, 0) sees ED_ERR_
  // BAD_LINE rather than a silent clamp.
  //
  // Gates in order:
  //   (R1) inited == 0           -> ED_ERR_BAD_BO
  //   (R2) line >= rows          -> ED_ERR_BAD_LINE
  //   (R3) col  >= cols          -> ED_ERR_BAD_COL
  //
  // Admission records (line, col) at (_ed_state[24], _ed_state[32]),
  // bumps _ed_set_cursor_ct, emits `EDITOR CURSOR line=<dec> col=<dec>`
  // via klog_s1_d2 (v2=col at caller [rsp+0]).
  //
  // SysV: rdi = line, rsi = col.
  // Stack recipe: 5 callee-save pushes (rbx = line, r12 = col,
  //   r13 = scratch, r14 = rows_cached, r15 = cols_cached_or_state_base).
  // ==========================================================================

  pub let editor_set_cursor : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (line: u64, col: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 83 G16 (paideia-os#2553) skeleton: refuses if _ed_state[48] (inited) == 0 (ED_ERR_BAD_BO 0xFFFFFCB1), if line >= _ed_state[16] (rows) (ED_ERR_BAD_LINE 0xFFFFFCB3), or if col >= _ed_state[8] (cols) (ED_ERR_BAD_COL 0xFFFFFCB4). On admission records (line, col) at (_ed_state[24], _ed_state[32]), bumps _ed_set_cursor_ct, and emits `EDITOR CURSOR line=<dec> col=<dec>` via klog_s1_d2 (v2=col at caller [rsp+0]). Register plan: rbx = line (saved), r12 = col (saved), r13 = scratch, r14 = rows cached, r15 = cols cached and later state base. Five callee-save pushes land rsp%16==0 at every nested call. Labels prefixed ed_sc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = line (saved)
        mov r12, rsi;                       // r12 = col (saved)

        // --- Gate (R1): inited == 0 -> ED_ERR_BAD_BO.
        lea r15, [rip + _ed_state];
        mov rax, [r15 + 48];                // rax = inited
        cmp rax, 0;
        je  ed_sc_bad_bo;

        // --- Gate (R2): line >= rows -> ED_ERR_BAD_LINE.
        mov r14, [r15 + 16];                // r14 = rows
        cmp rbx, r14;
        jae ed_sc_bad_line;

        // --- Gate (R3): col >= cols -> ED_ERR_BAD_COL.
        mov r13, [r15 + 8];                 // r13 = cols
        cmp r12, r13;
        jae ed_sc_bad_col;

        // --- Admitted. Record cursor.
        mov [r15 + 24], rbx;                // cursor_line
        mov [r15 + 32], r12;                // cursor_col

        // --- Count the set_cursor.
        mov rax, [rip + _ed_set_cursor_ct];
        add rax, 1;
        mov [rip + _ed_set_cursor_ct], rax;

        // --- klog_s1_d2(level=3, SUBSYS_DRV_, tag_cursor, k_line,
        //                line, k_col, [v2=col]).
        sub rsp, 16;
        mov [rsp + 0], r12;                 // v2 = col (caller [rsp+0])
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ed_tag_cursor];
        lea rcx, [rip + ed_k_line];
        mov r8, rbx;                        // v1 = line
        lea r9, [rip + ed_k_col];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                       // ED_OK
        jmp ed_sc_out;

      ed_sc_bad_bo:
        mov rax, 0xFFFFFCB1;                // ED_ERR_BAD_BO
        jmp ed_sc_out;
      ed_sc_bad_line:
        mov rax, 0xFFFFFCB3;                // ED_ERR_BAD_LINE
        jmp ed_sc_out;
      ed_sc_bad_col:
        mov rax, 0xFFFFFCB4;                // ED_ERR_BAD_COL

      ed_sc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  editor_apply_syntax(syntax_id) -> u64
  //
  // Switch the active highlighter and (follow-up) re-walk every row
  // through the new tokenizer, updating each cell's token_class.
  //
  // Gates in order:
  //   (R1) inited == 0                 -> ED_ERR_BAD_BO
  //   (R2) syntax_id > SYNTAX_MAX (3)  -> ED_ERR_BAD_SYNTAX_ID
  //
  // Admission records syntax_id into _ed_state[40], bumps _ed_apply_
  // syntax_ct, and emits `EDITOR SYNTAX id=<dec>` via klog_s1_d1 (all
  // 5 args fit in rdi..r8; no stack staging needed).
  //
  // The real body re-tokenizes every row; the skeleton does not touch
  // cell memory.
  //
  // SysV: rdi = syntax_id.
  // Stack recipe: 3 callee-save pushes (rbx = syntax_id, r12/r13 =
  //   scratch).
  // ==========================================================================

  pub let editor_apply_syntax : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (syntax_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 83 G16 (paideia-os#2553) skeleton: refuses if _ed_state[48] (inited) == 0 (ED_ERR_BAD_BO 0xFFFFFCB1), or if syntax_id > SYNTAX_MAX(3) (ED_ERR_BAD_SYNTAX_ID 0xFFFFFCB5). On admission records syntax_id into _ed_state[40], bumps _ed_apply_syntax_ct, and emits `EDITOR SYNTAX id=<dec>` via klog_s1_d1 (level=3, SUBSYS_DRV_, tag_syntax, k_id, syntax_id -- all 5 reg args fit in rdi..r8, no stack staging needed). Re-tokenization DEFERRED to the follow-up slice that lands core/text/syntax_pdx.pdx and siblings. Register plan: rbx = syntax_id (saved), r12/r13 = scratch for state slot access. Three callee-save pushes land rsp%16==0 at every nested call (entry %16==8, +24 = 32, %16==0). Labels prefixed ed_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = syntax_id (saved)

        // --- Gate (R1): inited == 0 -> ED_ERR_BAD_BO.
        lea r13, [rip + _ed_state];
        mov rax, [r13 + 48];                // rax = inited
        cmp rax, 0;
        je  ed_ap_bad_bo;

        // --- Gate (R2): syntax_id > SYNTAX_MAX -> ED_ERR_BAD_SYNTAX_ID.
        mov r10, 3;                         // SYNTAX_MAX
        cmp rbx, r10;
        ja  ed_ap_bad_syntax;

        // --- Admitted. Record syntax_id.
        mov [r13 + 40], rbx;                // syntax_id

        // --- Count the apply_syntax.
        mov rax, [rip + _ed_apply_syntax_ct];
        add rax, 1;
        mov [rip + _ed_apply_syntax_ct], rax;

        // --- klog_s1_d1(level=3, SUBSYS_DRV_, tag_syntax, k_id,
        //                syntax_id).  All 5 args fit in rdi..r8.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ed_tag_syntax];
        lea rcx, [rip + ed_k_id];
        mov r8, rbx;                        // v = syntax_id
        call klog_s1_d1;

        xor rax, rax;                       // ED_OK
        jmp ed_ap_out;

      ed_ap_bad_bo:
        mov rax, 0xFFFFFCB1;                // ED_ERR_BAD_BO
        jmp ed_ap_out;
      ed_ap_bad_syntax:
        mov rax, 0xFFFFFCB5;                // ED_ERR_BAD_SYNTAX_ID

      ed_ap_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  editor_present() -> u64
  //
  // Flip the finished pane tile to the panel via the Wave 78 G8
  // direct-scanout path. Real body (follow-up slice):
  //
  //   (1) For every cell with non-zero codepoint, look up atlas tile
  //       and stamp it into the cell's quad (fg colour from the per-
  //       syntax palette indexed by token_class, or from cell.fg_rgb
  //       when syntax_id == SYNTAX_PLAIN).
  //   (2) Call direct_scanout_eligibility(bo_cap, 0, cols*8, rows*16).
  //       If not DS_OK, return the sentinel verbatim.
  //   (3) Call direct_scanout_arm(bo_cap, 0) to stamp PLANE_SURF.
  //   (4) Clear dirty-row bitmap (follow-up).
  //
  // Gate (R1): inited == 0 -> ED_ERR_BAD_BO.
  //
  // At skeleton stage the body gate-checks and bumps _ed_present_ct
  // only. It does NOT call direct_scanout_arm because doing so would
  // record a never-cleared armed state on pipe 0 in direct_scanout's
  // per-pipe state block, polluting direct_scanout_arm_ct and
  // direct_scanout_armed_bo for any boot-witness programme that
  // lands this slice alone. No fingerprint is emitted (per the Wave
  // 83 G16 task directive, which lists INIT / SET_TEXT / CURSOR /
  // SYNTAX only).
  //
  // SysV: no args.
  // Stack recipe: 3 callee-save pushes (rbx/r12/r13 scratch).
  // ==========================================================================

  pub let editor_present : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 83 G16 (paideia-os#2553) skeleton: refuses if _ed_state[48] (inited) == 0 (ED_ERR_BAD_BO 0xFFFFFCB1). On admission bumps _ed_present_ct and returns ED_OK. The real body (follow-up) stamps SDF glyph quads + calls direct_scanout_eligibility + direct_scanout_arm; the skeleton omits those calls because arming the pipe would surface in direct_scanout_arm_ct / direct_scanout_armed_bo on a boot-witness programme as if the editor had a live scanout. No fingerprint per the Wave 83 G16 task directive (INIT / SET_TEXT / CURSOR / SYNTAX only). Register plan: rbx = scratch for state slot. Three callee-save pushes land rsp%16==0 (entry %16==8, +24 = 32, %16==0) in case the follow-up slice adds nested calls (direct_scanout_arm) without reshaping the prologue. Labels prefixed ed_pres_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate (R1): inited == 0 -> ED_ERR_BAD_BO.
        lea rbx, [rip + _ed_state];
        mov rbx, [rbx + 48];                // rbx = inited
        cmp rbx, 0;
        je  ed_pres_bad_bo;

        // --- direct_scanout_arm call DEFERRED (see justification).
        //     Skeleton bumps the counter and returns ED_OK.

        mov rax, [rip + _ed_present_ct];
        add rax, 1;
        mov [rip + _ed_present_ct], rax;

        xor rax, rax;                       // ED_OK
        jmp ed_pres_out;

      ed_pres_bad_bo:
        mov rax, 0xFFFFFCB1;                // ED_ERR_BAD_BO

      ed_pres_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  Pane state getters
  //
  // Leaf getters so a boot-witness programme can assert the pane's
  // state without touching the _ed_state symbol directly.
  // ==========================================================================

  pub let editor_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 83 G16 (paideia-os#2553) skeleton: single mov load from _ed_state[48] (inited). Leaf.",
      block: {
        lea rax, [rip + _ed_state];
        mov rax, [rax + 48];
        ret
      }
    }

  pub let editor_cols : () -> u64 !{mem} @{} =
