// src/kernel/core/drivers/dpy/timeline.pdx -- G1.M1-003 (#1429) +
// G1.M1-004 (#1430)
//
// Vblank -> KIND_DISPLAY_TIMELINE signal path AND the wait
// primitive that consumes it. Both live in the same driver file
// because the wait polls the same _display_timeline_table cell
// the signal advances, and confining them to one object is what
// lets tools/build.sh pin exactly two writers of that cell (this
// file plus kind_display_timeline.o).
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the R36 display substrate calls when a vblank
// interrupt fires: dpy_timeline_vblank_signal(engine_id, output_id)
// scans _display_timeline_table for the row whose (engine_id,
// output_id) match, increments its last_scanout_value, and returns.
// It is ALSO the SEAM the display_sync_channel calls to wait for
// a specific value: dpy_timeline_wait_le(row_id, want_value,
// timeout_ns) polls the row's last_scanout_value with the wraparound
// comparison from kind_display_timeline.pdx §3.
//
// It is NOT the vblank ISR itself (that lives in the display engine
// driver -- iris_xe_probe.pdx et al. -- and calls this seam), NOT
// the mint gate (that lives in kind_display_timeline.pdx), and NOT
// the RPC schema (that lives in ipc/display_sync_channel.pdx).
//
// =============================================================================
// SECTION 1  THE VBLANK SEAM (G1.M1-003 #1429)
// =============================================================================
//
// A display engine's vblank ISR reduces to a single call:
//
//     dpy_timeline_vblank_signal(engine_id, output_id)
//
// which looks up the matching row and advances its last_scanout_
// value by one. The scan is O(DPT_MAX) = O(8) -- the T14 G4 has at
// most 3 concurrently active outputs (eDP + 2 x DP/HDMI) so the
// linear scan beats a hash lookup at every cost model.
//
// A row that does not exist for the (engine, output) pair is a
// timeline that was never minted -- the ISR is not the mint gate,
// and reporting DPT_TL_NO_ROW rather than mutating anything is what
// keeps the seam idempotent under ISR re-entry.
//
// A signal that races the mint (row observed live but freed before
// the increment lands) is a rare shape at runtime and is caught by
// dpt_row_signal's own tail_valid check inside kind_display_timeline
// .pdx -- the seam does not need a second lock.
//
// =============================================================================
// SECTION 2  THE WAIT PRIMITIVE (G1.M1-004 #1430)
// =============================================================================
//
// wait_scanout(timeline, value, timeout_ns) polls the row's
// last_scanout_value until it is >= value (signed compare, per §3
// of kind_display_timeline.pdx to admit near-wrap arithmetic
// without spurious timeouts) or the deadline elapses.
//
// The polling loop is deliberately a spin. A blocking wait would
// require a wait-queue per timeline and a wakeup path from the
// vblank ISR, and both add dependencies (the ISR would need cap
// authority to run wake_all) that would leak into the P1 argument.
// A spin bounded by timeout_ns is what the R44 GUI paint loop uses
// today; the R43+ scheduler will replace the spin with a wait-queue
// as a separate change confined by tools/build.sh.
//
// The deadline is compared against hpet_now_ns rather than TSC to
// avoid the R42+ TSC-invariant-per-package issue that has bitten
// the storage supervisor. A deadline of 0 means "no timeout" and
// polls forever; the caller is responsible for arming a watchdog.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFF680..0xFFFFF68F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band. Adjacent used band above: KIND_DISPLAY_
// TIMELINE 0xFFFFF6A0..AF; adjacent free band below: vrr
// 0xFFFFF670..7F.

module Timeline = structure {

  pub let DPY_TL_OK          : u64 = 0
  pub let DPY_TL_NO_ROW      : u64 = 0xFFFFF68F
  pub let DPY_TL_TIMEOUT     : u64 = 0xFFFFF68E
  pub let DPY_TL_BAD_SLOT    : u64 = 0xFFFFF68D
  pub let DPY_TL_BAD_TIMEOUT : u64 = 0xFFFFF68C
  pub let DPY_TL_ARG_RESVD   : u64 = 0xFFFFF68B

  // Per-driver stats. Confined to this object.
  pub let mut _dpy_timeline_stats : [u64; 4] = uninit @align(64)

  pub let DPY_TL_ST_SIGNALS : u64 = 0
  pub let DPY_TL_ST_NOROW   : u64 = 1
  pub let DPY_TL_ST_WAITS   : u64 = 2
  pub let DPY_TL_ST_TIMEOUT : u64 = 3

  pub let dpy_timeline_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-003 (#1429): clear driver counters. Labels prefixed dtls_rs_.",
      block: {
        lea r10, [rip + _dpy_timeline_stats];
        xor rax, rax;
        xor rcx, rcx;
      dtls_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dtls_rs_loop;
        ret
      }
    }

  pub let dpy_timeline_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-003 (#1429): counter read.",
      block: {
        cmp rdi, 4;
        jae dtls_st_zero;
        lea r10, [rip + _dpy_timeline_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dtls_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dpy_timeline_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-003 (#1429): counter bump. Labels prefixed dtln_.",
      block: {
        cmp rdi, 4;
        jae dtln_out;
        lea r10, [rip + _dpy_timeline_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dtln_out:
        ret
      }
    }

  // ==========================================================================
  // NOTE: dpy_timeline_find_row LIVES IN kind_display_timeline.pdx as
  // `dpt_find_by_engine_output`. Keeping the walker inside the kind
  // file is what lets tools/build.sh confine _display_timeline_table
  // to a SINGLE owner object (core/cap/kind_display_timeline.o); the
  // driver only relocates against the exported selector symbol, not
  // the table directly. Same discipline as EC / other multi-consumer
  // row tables in the tree.
  //
  // A shim is kept here so the module's synth witness can call it by
  // its historical driver-side name; the shim is a thin one-line
  // forwarder.
  // ==========================================================================
  pub let dpy_timeline_find_row : (u64, u64) -> u64 !{mem} @{} =
    fn (engine_id: u64) (output_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-003 (#1429): thin forwarder to dpt_find_by_engine_output (which OWNS the walk over _display_timeline_table so the table stays single-owner-confined). Labels prefixed dtlf_.",
      block: {
        call dpt_find_by_engine_output;
        ret
      }
    }

  // ==========================================================================
  // dpy_timeline_vblank_signal(engine_id, output_id) -> u64
  //
  // The SEAM the vblank ISR calls. Returns OK on advance, NO_ROW on
  // no timeline yet minted for that pair. Idempotent under re-entry
  // -- a second signal for the same value is a no-op inside
  // dpt_row_signal (the signal helper uses unsigned max).
  // ==========================================================================
  pub let dpy_timeline_vblank_signal : (u64, u64) -> u64 !{mem} @{} =
    fn (engine_id: u64) (output_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M1-003 (#1429): find the row for (engine_id, output_id); if none, note NO_ROW and return; else read the current value, compute (v+1), call dpt_row_signal (idempotent via unsigned max). Bumps DPY_TL_ST_SIGNALS on success. Labels prefixed dtlv_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // engine_id
        mov r13, rsi;                    // output_id

        mov rdi, r12;
        mov rsi, r13;
        call dpy_timeline_find_row;
        cmp rax, 0xFF;
        je  dtlv_norow;
        mov rbx, rax;                    // row_id

        mov rdi, rbx;
        call dpt_row_value;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dtlv_norow;
        add rax, 1;

        mov rdi, rbx;
        mov rsi, rax;
        call dpt_row_signal;
        cmp rax, 0;
        jne dtlv_out;                    // pass through the signal error

        mov rdi, 0;                      // DPY_TL_ST_SIGNALS
        call dpy_timeline_note;

        xor rax, rax;
        jmp dtlv_out;

      dtlv_norow:
        mov rdi, 1;                      // DPY_TL_ST_NOROW
        call dpy_timeline_note;
        mov rax, 0xFFFFF68F;

      dtlv_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Wraparound-safe comparison.
  //
  // Returns 1 iff (current - want) considered as signed i64 is >= 0.
  // Handles the near-wrap case documented in kind_display_timeline
  // .pdx §3 without spurious timeouts.
  // ==========================================================================
  pub let dpy_timeline_reached : (u64, u64) -> u64 !{} @{} =
    fn (current: u64) (want: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M1-004 (#1430): wraparound-safe compare. Returns 1 iff (current - want) considered as signed >= 0. Handles G1.M3-003 (#1439) wrap discipline. Labels prefixed dtlr_.",
      block: {
        mov rax, rdi;
        sub rax, rsi;
        cmp rax, 0;
        js  dtlr_no;
        mov rax, 1;
        ret;
      dtlr_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dpy_timeline_wait_le(row_id, want_value, timeout_ns) -> u64
  //
  // The wait primitive. Polls the row's last_scanout_value with the
  // wraparound compare above; returns OK on reach, TIMEOUT on
  // deadline expiry, BAD_SLOT on bad row. timeout_ns=0 means poll
  // forever (caller supplies watchdog).
  //
  // Return value on OK is the presented_at_ns from hpet_now_ns at
  // the moment the reach was detected (per issue #1430's contract
  // "wait_scanout(...) -> presented_at_ns"). On failure the return
  // is one of the DPY_TL_* error codes.
  // ==========================================================================
  pub let dpy_timeline_wait_le : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) (want_value: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "G1.M1-004 (#1430): poll the row's last_scanout_value with dpy_timeline_reached; if reached return hpet_now_ns; if deadline expired return DPY_TL_TIMEOUT. Deadline is (start + timeout_ns) unless timeout_ns==0 (poll forever). Labels prefixed dtlw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // want_value
        mov r14, rdx;                    // timeout_ns

        mov rdi, r12;
        call dpt_tail_valid;
        cmp rax, 0;
        je  dtlw_bad_slot;

        mov rdi, 2;                      // DPY_TL_ST_WAITS
        call dpy_timeline_note;

        // Compute deadline. If timeout_ns == 0, r15 = 0 (sentinel for
        // "poll forever"). Otherwise r15 = start + timeout_ns.
        xor r15, r15;
        cmp r14, 0;
        je  dtlw_loop;
        call hpet_now_ns;
        add rax, r14;
        mov r15, rax;

      dtlw_loop:
        mov rdi, r12;
        call dpt_row_value;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  dtlw_bad_slot;

        mov rdi, rax;
        mov rsi, r13;
        call dpy_timeline_reached;
        cmp rax, 0;
        jne dtlw_hit;

        cmp r15, 0;
        je  dtlw_loop;

        call hpet_now_ns;
        cmp rax, r15;
        jae dtlw_timeout;

        pause;
        jmp dtlw_loop;

      dtlw_hit:
        call hpet_now_ns;
        jmp dtlw_out;

      dtlw_timeout:
        mov rdi, 3;                      // DPY_TL_ST_TIMEOUT
        call dpy_timeline_note;
        mov rax, 0xFFFFF68E;
        jmp dtlw_out;

      dtlw_bad_slot:
        mov rax, 0xFFFFF68D;

      dtlw_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
