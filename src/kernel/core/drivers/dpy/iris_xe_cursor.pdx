// src/kernel/core/drivers/dpy/iris_xe_cursor.pdx -- Wave 59 G3 [R36] (#2540)
//
// Intel Iris Xe HW cursor plane bring-up SKELETON for Wave 59 G3. On
// Gen 12 (Alder/Raptor Lake iGPU) the mouse cursor is a dedicated
// hardware overlay plane programmed through the CURCNTR / CURPOS /
// CURBASE register trio on each of the three display pipes
// (A / B / C). The three pipes carry independent cursor state so a
// multi-head session can show three cursors without any CPU
// composition.
//
// This file sits beside iris_xe_modeset.pdx (Wave 59 G2, #2539)
// which brought pipe A up to native panel timing + plane-1 scanout;
// the cursor is the OVERLAY on top of that. It is also distinct
// from plane_cursor.pdx (R36.M4-004, #1252) which holds the
// cap/kind plane-lattice cursor-role class on top of
// KIND_DISPLAY_PLANE -- that file DECIDES which memory row holds a
// cursor bitmap and in what format; THIS file is the register-level
// programming layer that actually WRITES the hardware cursor plane
// to show it. The two coexist because plane_cursor.pdx has no
// knowledge of CURCNTR / CURPOS / CURBASE addresses or pipe stride.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// Posture: EVERY body here is a STUB per the Wave 59 G3 skeleton
// directive. The register offsets, cursor-mode constants, and error
// taxonomy are FROZEN at this skeleton stage so the follow-up slice
// can land the real MMIO bodies against the same ABI and constants
// without churn. The static per-pipe state, the fingerprint tags,
// and the counter bumps are real; no live MMIO is written yet
// (QEMU: no Iris Xe BAR0; T14 G4: BAR0 is wired by R104.M1-003 but
// consumed only by iris_xe_modeset today).
//
// On the Wave 59 G3 skeleton, every entrypoint:
//   (1) range-checks pipe in {0,1,2} and refuses with
//       IXC_ERR_BAD_PIPE (0xFFFFFFCB) otherwise;
//   (2) range-checks the bitmap size (set_bitmap only) against the
//       enumerated set {64, 128, 256} per CURCNTR mode-select;
//   (3) records the request into the per-pipe state block;
//   (4) bumps the per-op counter so an operator can see the entry
//       on a boot-witness programme;
//   (5) emits a fingerprint (move / hide only) so the cursor-move
//       and cursor-hide calls show up on the klog wire.
//
// =============================================================================
// SECTION 1  REGISTER MAP (Intel Iris Xe / Alder-Lake / Raptor-Lake)
// =============================================================================
//
// Source: Intel bspec "Register Reference -> Display Registers -> ADL
// -> Pipe/Cursor". The three CURSOR_* registers sit at a 0x1000 pipe
// stride (A at 0x70000, B at 0x71000, C at 0x72000 base). Each CURSOR
// register's offset INSIDE its pipe band is:
//
//   CURCNTR      +0x080   -- cursor control (mode select, enables)
//   CURBASE      +0x084   -- cursor surface base address (GTT PA)
//   CURPOS       +0x088   -- cursor position (y<<16 | x, both i16)
//   CURSURFLIVE  +0x0AC   -- live-surface readback (pipe A only;
//                              B/C derive via the atomic commit path)
//
// Resolving CURCNTR_A = 0x70080, CURCNTR_B = 0x71080, CURCNTR_C =
// 0x72080; CURPOS_A/B/C = 0x70088/0x71088/0x72088; CURBASE_A/B/C =
// 0x70084/0x71084/0x72084; CURSURFLIVE_A = 0x700AC.
//
// All accesses are 32-bit per Intel bspec §14 ("any wider or
// narrower access is undefined"). The real body in the follow-up
// slice uses mov_d (G1 sized store) for every CURCNTR / CURBASE /
// CURPOS write; this skeleton emits none of them.
//
// =============================================================================
// SECTION 2  CURCNTR FIELD ENCODING
// =============================================================================
//
// CURCNTR[5:0] is the CURSOR_MODE_SELECT. The three ARGB (per-pixel
// alpha) sizes the Xe1 cursor supports are:
//
//     0x22  -- 64 x 64 ARGB
//     0x02  -- 128 x 128 ARGB
//     0x03  -- 256 x 256 ARGB
//
// (0x22 is the irregular small-cursor value held over from Haswell;
// bspec documents it alongside the 128 / 256 values rather than at
// a lower numeric encoding.) Other mode-select values -- disabled
// (0x00), 32x32 ARGB (0x05 on older GPUs) -- are REFUSED by
// iris_xe_cursor_set_bitmap below with IXC_ERR_BAD_BITMAP_SIZE.
//
// CURCNTR[24]  CURSOR_PIPE_CSC_ENABLE   -- cursor goes through the
//                                          pipe's color-space-conversion
//                                          matrix; held OFF at
//                                          skeleton stage so cursor
//                                          renders in the panel's
//                                          native space.
// CURCNTR[26]  CURSOR_GAMMA_ENABLE      -- cursor LUT; held OFF.
//
// The per-collision policy says prefix shared register-field names
// with the module tag; this file uses the `IXC_` (Iris Xe Cursor)
// prefix on every register, mode, bit, and error constant.
//
// =============================================================================
// SECTION 3  CAPABILITY DISPATCH SLOT -- OPEN QUESTION
// =============================================================================
//
// Grep of src/kernel/core/cap/invoke.pdx shows NO reserved slot for
// a KIND_GPU_CURSOR capability. The adjacent 0x18x derived-kind
// block (G3.M1-001 KIND_VK_SURFACE 0x189, G3.M2-001
// KIND_VK_SWAPCHAIN_IMAGE 0x18A) and the 0x17x GPU-adjacent block
// (R37.M3-001 KIND_GPU_BO 0x174, R37.M4-001 KIND_GPU_VM 0x175,
// R37.M5-001 KIND_GPU_CONTEXT 0x176, R37.M6-001 KIND_GPU_SUBMIT
// 0x177) carry nothing for a hardware-cursor capability. The task
// hint predicted "slot ~47, tag ~0x3B" but no such slot is reserved
// yet.
//
// Decision: this skeleton does NOT touch invoke.pdx. The follow-up
// slice that lands the real MMIO body + a dedicated kernel-side
// kind row + mint path + handler will claim a derived-kind tag
// adjacent to KIND_DISPLAY_PLANE (0x173) -- the natural parent --
// at that time, together with a per-pipe dispatch arm.
//
// =============================================================================
// SECTION 4  INTERACTION WITH plane_cursor.pdx (R36.M4-004 #1252)
// =============================================================================
//
// plane_cursor.pdx holds the capability-side cursor-plane state:
// which KIND_DISPLAY_PLANE row is a cursor, which memory row holds
// its ARGB bitmap, which square size (64 / 128 / 256) it owns, and
// an immediate (x, y). It REFUSES wrong formats, sizes, and plane
// types but it DOES NOT TOUCH REAL MMIO -- its plcur_arbitrated()
// helper returns 0 explicitly and the file's §0 header pins that
// honesty.
//
// This file is the OTHER half: given a (pipe, bitmap_pa, size, x,
// y) decision already made upstream (by plane_cursor's bind), it
// knows exactly which three register offsets to write and in which
// order. The follow-up slice wires the two together: a
// plane_cursor PLCUR_DEFERRED_HARDWARE return in the real body will
// become a call through this module's iris_xe_cursor_set_bitmap +
// iris_xe_cursor_move pair.
//
// =============================================================================
// SECTION 5  ERROR CODES -- 0xFFFFFFCB..0xFFFFFFCE
// =============================================================================
//
// Four codes reserved for this module. Disjoint from:
//
//   PLCUR_*         0xFFFFF6B0..BF (plane_cursor.pdx)
//   LPG_D7_*        0xFFFFFE70..7F (lpss_gpio.pdx W59 D7)
//   LPSS_I2C_*      0xFFFFFF40..5F
//   KFB_*           0xFFFFFF80..9F  (kind_framebuffer)
//
// The 0xFFFFFFCB..CE band is module-scoped for the Wave 59 G3 Iris Xe
// HW cursor. The same byte values appear in iommu/domain_switch.pdx
// (IOMMU_SW_ERR_*) and cap/kind_op_region.pdx (OPREG_TAIL_BAD_ARG =
// 0xFFFFFFCE) — those are return values that never leave their own
// modules, so collision is harmless. Values here:
//
//     0xFFFFFFCB  IXC_ERR_BAD_PIPE          -- pipe not in {0, 1, 2}
//     0xFFFFFFCC  IXC_ERR_BAD_BITMAP_SIZE   -- size not in {64, 128, 256}
//     0xFFFFFFCD  IXC_ERR_PLANE_DISABLED    -- show/hide/move on a
//                                              pipe whose cursor
//                                              plane was never
//                                              armed with a bitmap
//     0xFFFFFFCE  IXC_ERR_PIPE_UNCONFIGURED -- the pipe itself was
//                                              never brought up
//                                              (no modeset_eDP
//                                              completed on it)
//
// IXC_ERR_PIPE_UNCONFIGURED is retained in the taxonomy even though
// the skeleton does not yet consult modeset state; the follow-up
// slice cross-checks pipe A against iris_xe_modeset's post-
// condition before touching CURBASE.
//
// =============================================================================
// SECTION 6  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized stores): every u32 store in the follow-up slice uses
//      mov_d (CURCNTR / CURBASE / CURPOS are all 32-bit per bspec).
//      This skeleton emits no MMIO writes; the per-pipe state slots
//      are u64 so plain REX.W `mov` is correct.
//   G4 (full-register compares): every cmp here is on a 64-bit
//      register; no `cmp al, imm`, no `cmp eax, imm` short-form.
//   No `test rN, rN` -- equality-against-zero is `cmp rN, 0`.
//   No `and rN, imm64` -- this skeleton emits no `and` at all; the
//      real body's PIPE_CSC/GAMMA mask fits imm32.
//   No two-operand `imul r, imm` -- pipe * stride is folded with
//      `shl r, 12` because the stride is 0x1000 (a power of two).
//      Per-pipe state offset is `pipe * 32` folded to `shl r, 5`.
//   64-bit immediates -- IXC_PIPE_STRIDE (0x1000) is loaded via
//      mov r64, 0x1000 (imm32 sign-extended via REX.W; proven form)
//      and never used as an and-mask.
//   Multiline `pub let ="..."` is forbidden by the pdx parser;
//      every tag below is a single line.
//   Module basename matches filename basename:
//      iris_xe_cursor.pdx -> module IrisXeCursor.
//   Reserved labels -- every label in this file is prefixed `ixc_`
//      (Iris Xe Cursor) so none collides with the ixm_ labels of
//      iris_xe_modeset.pdx or the plcur_ labels of plane_cursor.pdx,
//      and none accidentally spells `loop`, `if`, or `let`.
//
// =============================================================================
// SECTION 7  STACK + REGISTER PLAN
// =============================================================================
//
// Four entry shapes:
//
//   iris_xe_cursor_init          (pipe)                 -> u64
//   iris_xe_cursor_set_bitmap    (pipe, bitmap_pa, size)-> u64
//   iris_xe_cursor_move          (pipe, x, y)           -> u64
//   iris_xe_cursor_show          (pipe)                 -> u64
//   iris_xe_cursor_hide          (pipe)                 -> u64
//
// Leaf (no nested CALL): iris_xe_cursor_init / set_bitmap / show.
//   -> no callee-save pushes, body operates on rax/rcx/r10 scratch.
// Non-leaf (nested klog_s1 / klog_s1_x3): iris_xe_cursor_move /
// iris_xe_cursor_hide. Both use the modeset.pdx recipe:
//
//   push rbx; push r12; push r13;    // 3-push, 24 B
//   -- entry rsp%16 == 8; after 3 pushes rsp%16 == 0 (pre-CALL)
//
//   iris_xe_cursor_move additionally pushes v2 + k3 + v3 for the
//   klog_s1_x3 7th-9th args, with a leading `sub rsp, 8` pad --
//   recipe duplicates klog_s1_x3's caller contract per
//   src/kernel/acpi/madt.pdx L1024 (m_iso_fp_).
//
// =============================================================================
// SECTION 8  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file
// compiles alongside the kernel because tools/build.sh recurses
// through src/kernel/core/drivers/dpy/ with a single `find`, so a
// new .pdx in that directory is picked up automatically; no
// build.sh edit required.
//
// No caller invokes iris_xe_cursor_* yet. A follow-up slice adds a
// boot-witness programme at
// tests/kernel/drivers/wit_iris_xe_cursor_init.pdx that:
//   (1) iris_xe_cursor_init(0);
//   (2) iris_xe_cursor_set_bitmap(0, dummy_pa, 64);
//   (3) iris_xe_cursor_move(0, 100, 200);
//   (4) iris_xe_cursor_hide(0);
// and asserts the two fingerprints land on the klog wire plus the
// counter getters report (1, 1, 1, 0, 1).

module IrisXeCursor = structure {

  // ==========================================================================
  // §A  Register offsets -- CURCNTR / CURBASE / CURPOS / CURSURFLIVE
  // ==========================================================================
  //
  // Per Intel bspec "Register Reference -> Display Registers -> ADL"
  // (Alder Lake / Raptor Lake). Pipe stride is 0x1000.

  pub let IXC_CURCNTR_A        : u64 = 0x70080
  pub let IXC_CURCNTR_B        : u64 = 0x71080
  pub let IXC_CURCNTR_C        : u64 = 0x72080

  pub let IXC_CURBASE_A        : u64 = 0x70084
  pub let IXC_CURBASE_B        : u64 = 0x71084
  pub let IXC_CURBASE_C        : u64 = 0x72084

  pub let IXC_CURPOS_A         : u64 = 0x70088
  pub let IXC_CURPOS_B         : u64 = 0x71088
  pub let IXC_CURPOS_C         : u64 = 0x72088

  pub let IXC_CURSURFLIVE_A    : u64 = 0x700AC

  pub let IXC_PIPE_STRIDE      : u64 = 0x1000

  // ==========================================================================
  // §B  CURCNTR field encodings
  // ==========================================================================
  //
  // CURSOR_MODE_SELECT lives in CURCNTR[5:0]; the three ARGB sizes
  // the Xe1 cursor plane admits are the only values this driver
  // ever writes. CURSOR_PIPE_CSC_ENABLE (bit 24) and
  // CURSOR_GAMMA_ENABLE (bit 26) are held OFF at skeleton + first
  // real-body landings; a later HDR / color-managed path flips the
  // CSC bit when the compositor's output profile is non-sRGB.

  pub let IXC_CURCNTR_MODE_64_ARGB   : u64 = 0x22
  pub let IXC_CURCNTR_MODE_128_ARGB  : u64 = 0x02
  pub let IXC_CURCNTR_MODE_256_ARGB  : u64 = 0x03
  pub let IXC_CURCNTR_MODE_DISABLED  : u64 = 0x00

  pub let IXC_CURCNTR_PIPE_CSC_ENABLE : u64 = 0x01000000  // bit 24
  pub let IXC_CURCNTR_GAMMA_ENABLE    : u64 = 0x04000000  // bit 26

  // Admitted bitmap sizes (square). Follows plane_cursor.pdx
  // PLCUR_SIZE_* enumeration; the sizes themselves live here as
  // public u64 constants so witness programmes can refer to them
  // without pulling plane_cursor's symbols.

  pub let IXC_SIZE_64   : u64 = 64
  pub let IXC_SIZE_128  : u64 = 128
  pub let IXC_SIZE_256  : u64 = 256

  // Pipe identifiers. Public so a caller can read-aloud the pipe
  // argument rather than hard-code 0/1/2 at the call site.
  pub let IXC_PIPE_A : u64 = 0
  pub let IXC_PIPE_B : u64 = 1
  pub let IXC_PIPE_C : u64 = 2
  pub let IXC_PIPE_COUNT : u64 = 3

  // ==========================================================================
  // §C  Failure taxonomy -- band 0xFFFFFFCB..0xFFFFFFCE
  // ==========================================================================

  pub let IXC_OK                    : u64 = 0
  pub let IXC_ERR_BAD_PIPE          : u64 = 0xFFFFFFCB
  pub let IXC_ERR_BAD_BITMAP_SIZE   : u64 = 0xFFFFFFCC
  pub let IXC_ERR_PLANE_DISABLED    : u64 = 0xFFFFFFCD
  pub let IXC_ERR_PIPE_UNCONFIGURED : u64 = 0xFFFFFFCE

  // ==========================================================================
  // §D  Per-pipe state -- 4 u64 slots per pipe * 3 pipes = 12 u64s.
  //
  // Layout per pipe (32 bytes stride, pipe * 32 = `shl r, 5`):
  //   +0  bitmap_pa      -- GTT PA of the ARGB cursor bitmap (0 = none)
  //   +8  cursor_size    -- 64 / 128 / 256 (0 = not yet armed)
  //   +16 mode           -- IXC_CURCNTR_MODE_* value (0 = disabled)
  //   +24 enabled        -- 0 = hidden, 1 = visible
  //
  // Position is NOT stored in the state block: on real hardware CUR_POS
  // is immediate-effect (next VBLANK) and we don't need the kernel
  // mirror; a caller that cares passes the position it wants again
  // on the next iris_xe_cursor_move call.
  // ==========================================================================

  pub let mut _ixc_pipe_state : [u64; 12] = uninit @align(64)

  // Per-op stats (bumped once per successful entry). Visible via the
  // getter trio in §K.
  pub let mut _ixc_init_ct       : u64 = 0
  pub let mut _ixc_set_bitmap_ct : u64 = 0
  pub let mut _ixc_move_ct       : u64 = 0
  pub let mut _ixc_show_ct       : u64 = 0
  pub let mut _ixc_hide_ct       : u64 = 0

  // ==========================================================================
  // §E  Fingerprint tags + keys
  //
  // CURSOR SET per-pipe tag text bakes `pipe=<a|b|c>` into the tag
  // literal and leaves mode / x / y to klog_s1_x3 as three hex KVs.
  // CURSOR HIDE per-pipe tag text bakes `pipe=<a|b|c>` and takes no
  // KVs (klog_s1).
  //
  // Fingerprint on the wire, pipe A:
  //   CURSOR SET pipe=a mode=0x<hex> x=0x<hex> y=0x<hex>
  //   CURSOR HIDE pipe=a
  //
  // Matches tests/fingerprints/iris_xe_cursor.golden pattern.
  // ==========================================================================

  pub let ixc_tag_set_a  : [u8; 18] = "CURSOR SET pipe=a\0"
  pub let ixc_tag_set_b  : [u8; 18] = "CURSOR SET pipe=b\0"
  pub let ixc_tag_set_c  : [u8; 18] = "CURSOR SET pipe=c\0"

  pub let ixc_tag_hide_a : [u8; 19] = "CURSOR HIDE pipe=a\0"
  pub let ixc_tag_hide_b : [u8; 19] = "CURSOR HIDE pipe=b\0"
  pub let ixc_tag_hide_c : [u8; 19] = "CURSOR HIDE pipe=c\0"

  pub let ixc_k_mode : [u8; 5] = "mode\0"
  pub let ixc_k_x    : [u8; 2] = "x\0"
  pub let ixc_k_y    : [u8; 2] = "y\0"

  // ==========================================================================
  // §F  iris_xe_cursor_init(pipe) -> u64
  //
  // Zero the per-pipe state block for `pipe`, bump the init counter,
  // return IXC_OK. Returns IXC_ERR_BAD_PIPE on pipe > 2.
  //
  // No fingerprint (init is quiet; it is the move/hide calls that
  // emit lines so the compositor can trace cursor activity).
  //
  // SysV: rdi = pipe. Leaf.
  // ==========================================================================

  pub let iris_xe_cursor_init : (u64) -> u64 !{mem} @{boot} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: zero the 32-byte per-pipe state slot for `pipe` (bitmap_pa + cursor_size + mode + enabled), bump _ixc_init_ct, return IXC_OK. Gate: pipe > 2 -> IXC_ERR_BAD_PIPE (0xFFFFFFCB). Per-pipe stride is 32 bytes (4 u64 slots); offset = pipe << 5 (shl r, 5) which avoids the 2-op `imul r, imm` encoder gap. The state slots are u64 for alignment; a REX.W `mov` writes 8 bytes exact so no mov_d needed on the zero-stores. Register plan: rax = scratch, r10 = base of per-pipe row. Leaf, no callee-save pushes. Labels prefixed ixc_init_.",
      block: {
        // --- Gate: pipe in {0, 1, 2}.
        cmp rdi, 2;
        ja  ixc_init_badpipe;

        // --- Compute per-pipe row base: &_ixc_pipe_state + pipe * 32.
        lea r10, [rip + _ixc_pipe_state];
        mov rax, rdi;
        shl rax, 5;                           // pipe * 32
        add r10, rax;

        // --- Zero the four slots.
        xor rax, rax;
        mov [r10 + 0],  rax;                  // bitmap_pa
        mov [r10 + 8],  rax;                  // cursor_size
        mov [r10 + 16], rax;                  // mode
        mov [r10 + 24], rax;                  // enabled

        // --- Count the init.
        mov rax, [rip + _ixc_init_ct];
        add rax, 1;
        mov [rip + _ixc_init_ct], rax;

        xor rax, rax;                         // IXC_OK
        ret;

      ixc_init_badpipe:
        mov rax, 0xFFFFFFCB;                  // IXC_ERR_BAD_PIPE
        ret
      }
    }

  // ==========================================================================
  // §G  iris_xe_cursor_set_bitmap(pipe, bitmap_pa, size) -> u64
  //
  // Record (bitmap_pa, size) and the derived CURCNTR mode value into
  // the per-pipe state slot. The real body (follow-up slice) writes
  // CURBASE (= bitmap_pa) and CURCNTR (= mode | PIPE_CSC_ENABLE off |
  // GAMMA_ENABLE off) via mov_d; this skeleton stops at the gate +
  // state-record + counter bump so the ordering witness fires.
  //
  // Gates in order:
  //   (1) pipe > 2             -> IXC_ERR_BAD_PIPE
  //   (2) size not in {64,128,256} -> IXC_ERR_BAD_BITMAP_SIZE
  //
  // bitmap_pa == 0 is NOT refused: a caller mapping cursor memory
  // lazily may validly set the base to 0 and arm it later via
  // iris_xe_cursor_show; the real body will refuse a CURBASE write
  // of 0 at show-time rather than here.
  //
  // SysV: rdi = pipe, rsi = bitmap_pa, rdx = size. Leaf.
  // ==========================================================================

  pub let iris_xe_cursor_set_bitmap : (u64, u64, u64) -> u64 !{mem} @{boot} =
    fn (pipe: u64, bitmap_pa: u64, size: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: validate pipe + bitmap size, record (bitmap_pa, size, mode) into the per-pipe state slot, bump _ixc_set_bitmap_ct, return IXC_OK. Gates: (1) pipe > 2 -> IXC_ERR_BAD_PIPE. (2) size not in {64, 128, 256} -> IXC_ERR_BAD_BITMAP_SIZE: the three admitted CURSOR_MODE_SELECT values on Xe1 are 0x22 (64), 0x02 (128), 0x03 (256) per Intel bspec §14; a non-matching size is REFUSED rather than clamped to the nearest admitted size because clamping would silently rewrite the caller's bitmap format expectation and show junk once the real body lands. Size-to-mode decoding is a 3-way compare chain (no table lookup) so the skeleton remains leaf-free of memory indirection. Encoder posture: `shl r, 5` for pipe * 32 (no 2-op imul); every store is REX.W mov (slots are u64). Labels prefixed ixc_sb_.",
      block: {
        // --- Gate (1): pipe in {0, 1, 2}.
        cmp rdi, 2;
        ja  ixc_sb_badpipe;

        // --- Gate (2): size in {64, 128, 256}; derive mode.
        //     rcx = derived CURCNTR mode value.
        cmp rdx, 64;
        je  ixc_sb_mode_64;
        cmp rdx, 128;
        je  ixc_sb_mode_128;
        cmp rdx, 256;
        je  ixc_sb_mode_256;
        jmp ixc_sb_badsize;

      ixc_sb_mode_64:
        mov rcx, 0x22;                        // IXC_CURCNTR_MODE_64_ARGB
        jmp ixc_sb_record;
      ixc_sb_mode_128:
        mov rcx, 0x02;                        // IXC_CURCNTR_MODE_128_ARGB
        jmp ixc_sb_record;
      ixc_sb_mode_256:
        mov rcx, 0x03;                        // IXC_CURCNTR_MODE_256_ARGB
        jmp ixc_sb_record;

      ixc_sb_record:
        // --- Compute per-pipe row base + record (bitmap_pa, size, mode).
        //     Row base in r10; new fields in rsi (bitmap_pa), rdx (size),
        //     rcx (mode).
        lea r10, [rip + _ixc_pipe_state];
        mov rax, rdi;
        shl rax, 5;                           // pipe * 32
        add r10, rax;

        mov [r10 + 0],  rsi;                  // bitmap_pa
        mov [r10 + 8],  rdx;                  // cursor_size
        mov [r10 + 16], rcx;                  // mode

        // --- Count the attempt.
        mov rax, [rip + _ixc_set_bitmap_ct];
        add rax, 1;
        mov [rip + _ixc_set_bitmap_ct], rax;

        xor rax, rax;                         // IXC_OK
        ret;

      ixc_sb_badpipe:
        mov rax, 0xFFFFFFCB;                  // IXC_ERR_BAD_PIPE
        ret;
      ixc_sb_badsize:
        mov rax, 0xFFFFFFCC;                  // IXC_ERR_BAD_BITMAP_SIZE
        ret
      }
    }

  // ==========================================================================
  // §H  iris_xe_cursor_move(pipe, x, y) -> u64
  //
  // Validate `pipe`, bump the move counter, emit the per-pipe
  // `CURSOR SET pipe=<a|b|c> mode=0x<h> x=0x<h> y=0x<h>` INFO
  // fingerprint. The real body (follow-up slice) writes CURPOS at
  // the computed register offset with (y << 16) | (x & 0xFFFF); the
  // skeleton stops at the fingerprint so the ordering witness
  // observes the entry.
  //
  // x and y are passed as i16-sized values widened to u64 (natural
  // sign-extension on the system calling convention); CURPOS packs
  // them as two i16 halves. The skeleton emits them as hex KVs
  // because paideia-as klog has an x3 wrapper for 3 hex KVs but no
  // x1_d2 (1 hex + 2 decimals) wrapper -- a follow-up klog landing
  // mints that variant and the x/y rendering flips to decimal
  // without a signature change here.
  //
  // Gates:
  //   (1) pipe > 2       -> IXC_ERR_BAD_PIPE
  //   (2) cursor_size==0 -> IXC_ERR_PLANE_DISABLED
  //
  // SysV: rdi = pipe, rsi = x, rdx = y.
  // Stack recipe: 3-push callee-save prologue (rbx, r12, r13 = 24 B;
  // entry rsp%16 == 8 flips to 0 after 3 pushes, pre-CALL aligned).
  // For the klog_s1_x3 7th/8th/9th args (v2 = x, k3 = ixc_k_y,
  // v3 = y) we do `sub rsp, 8` pad + three pushes = 32 B total, body
  // rsp%16 == 0 at the CALL. `add rsp, 32` on cleanup reclaims
  // everything.
  // ==========================================================================

  pub let iris_xe_cursor_move : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64, x: u64, y: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: validate pipe + cursor armed state, bump _ixc_move_ct, emit per-pipe CURSOR SET fingerprint via klog_s1_x3 (mode/x/y as hex KVs — follow-up klog mint for x1_d2 flips x/y to decimal). Gates: (1) pipe > 2 -> IXC_ERR_BAD_PIPE. (2) per-pipe cursor_size slot == 0 -> IXC_ERR_PLANE_DISABLED (the plane was never armed via iris_xe_cursor_set_bitmap). Pipe stride is 0x1000 at the register layer and 32 bytes at the state layer; both are powers of two so `shl r, 12` / `shl r, 5` suffice (no 2-op imul). The real body here does CURPOS write ((y&0xFFFF)<<16 | (x&0xFFFF)) via mov_d, then returns. Register plan: rbx = pipe (saved for use after the klog call), r12 = x (saved), r13 = y (saved). Entry rsp%16==8; 3 pushes land rsp%16==0; sub rsp,8 pads; three pushes (v3=y, k3=ixc_k_y, v2=x) stage the klog_s1_x3 7th/8th/9th args and leave rsp%16==0 pre-CALL. add rsp,32 reclaims pad + three args. Labels prefixed ixc_mv_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                         // rbx = pipe (saved)
        mov r12, rsi;                         // r12 = x (saved)
        mov r13, rdx;                         // r13 = y (saved)

        // --- Gate (1): pipe in {0, 1, 2}.
        cmp rbx, 2;
        ja  ixc_mv_badpipe;

        // --- Gate (2): per-pipe cursor_size must be nonzero (armed).
        lea rax, [rip + _ixc_pipe_state];
        mov rcx, rbx;
        shl rcx, 5;                           // pipe * 32
        add rax, rcx;
        mov rcx, [rax + 8];                   // cursor_size slot
        cmp rcx, 0;
        je  ixc_mv_disabled;

        // --- Count the move (bump before fingerprint so a crash
        //     mid-fingerprint still records the entry).
        mov rax, [rip + _ixc_move_ct];
        add rax, 1;
        mov [rip + _ixc_move_ct], rax;

        // --- Reload mode (hex v1 to klog) from the state slot.
        //     The real body already has it in a reg from the gate
        //     path above but the skeleton reloads for clarity.
        lea rax, [rip + _ixc_pipe_state];
        mov rcx, rbx;
        shl rcx, 5;
        add rax, rcx;
        mov r8, [rax + 16];                   // v1 = mode

        // --- Select the per-pipe CURSOR SET tag.
        //     rbx == 0 -> tag_set_a; 1 -> tag_set_b; 2 -> tag_set_c.
        cmp rbx, 0;
        je  ixc_mv_tag_a;
        cmp rbx, 1;
        je  ixc_mv_tag_b;
        lea rdx, [rip + ixc_tag_set_c];
        jmp ixc_mv_tag_done;
      ixc_mv_tag_a:
        lea rdx, [rip + ixc_tag_set_a];
        jmp ixc_mv_tag_done;
      ixc_mv_tag_b:
        lea rdx, [rip + ixc_tag_set_b];
      ixc_mv_tag_done:

        // --- klog_s1_x3(level=3, SUBSYS_DRV_, tag, k_mode, mode,
        //                k_x, [v2=x], k_y, [v3=y])
        //
        // SysV reg args (rdi..r9 slots used): level, subsys, tag,
        // k_mode, mode, k_x. Stack args pushed in reverse order:
        // v3=y, k3=ixc_k_y, v2=x (so after `call` they land at
        // [rsp+8], [rsp+16], [rsp+24] inside the wrapper).
        mov rdi, 3;                           // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        // rdx = tag (already set above)
        lea rcx, [rip + ixc_k_mode];
        // r8 = mode (already loaded above)
        lea r9, [rip + ixc_k_x];

        sub rsp, 8;                           // pad
        mov rax, r13;                         // v3 = y
        push rax;
        lea rax, [rip + ixc_k_y];             // k3
        push rax;
        mov rax, r12;                         // v2 = x
        push rax;
        call klog_s1_x3;
        add rsp, 32;                          // reclaim pad + 3 args

        xor rax, rax;                         // IXC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ixc_mv_badpipe:
        mov rax, 0xFFFFFFCB;                  // IXC_ERR_BAD_PIPE
        pop r13;
        pop r12;
        pop rbx;
        ret;
      ixc_mv_disabled:
        mov rax, 0xFFFFFFCD;                  // IXC_ERR_PLANE_DISABLED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  iris_xe_cursor_show(pipe) -> u64
  //
  // Flip the per-pipe `enabled` slot to 1 (bumping the show counter).
  // Real body: CURCNTR = (mode | enables); plane goes live at next
  // VBLANK. Skeleton stops at state record + counter bump.
  //
  // Gates:
  //   (1) pipe > 2        -> IXC_ERR_BAD_PIPE
  //   (2) cursor_size==0  -> IXC_ERR_PLANE_DISABLED (never armed)
  //
  // SysV: rdi = pipe. Leaf.
  // ==========================================================================

  pub let iris_xe_cursor_show : (u64) -> u64 !{mem} @{boot} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: flip per-pipe `enabled` slot to 1, bump _ixc_show_ct, return IXC_OK. Gates: (1) pipe > 2 -> IXC_ERR_BAD_PIPE. (2) cursor_size == 0 -> IXC_ERR_PLANE_DISABLED (the plane must be armed via set_bitmap first; showing a never-armed plane would issue a CURCNTR enable write with cursor_mode == 0 which is UB on Xe1 and renders as scrambled garbage). The real body writes CURCNTR = (mode | CURSOR_PIPE_CSC_ENABLE==0 | CURSOR_GAMMA_ENABLE==0) at skeleton stage; a later HDR path flips the CSC bit. Leaf. Labels prefixed ixc_sh_.",
      block: {
        // --- Gate (1): pipe in {0, 1, 2}.
        cmp rdi, 2;
        ja  ixc_sh_badpipe;

        // --- Row base.
        lea r10, [rip + _ixc_pipe_state];
        mov rax, rdi;
        shl rax, 5;
        add r10, rax;

        // --- Gate (2): cursor_size must be nonzero.
        mov rax, [r10 + 8];
        cmp rax, 0;
        je  ixc_sh_disabled;

        // --- Flip enabled.
        mov rax, 1;
        mov [r10 + 24], rax;

        // --- Count the show.
        mov rax, [rip + _ixc_show_ct];
        add rax, 1;
        mov [rip + _ixc_show_ct], rax;

        xor rax, rax;                         // IXC_OK
        ret;

      ixc_sh_badpipe:
        mov rax, 0xFFFFFFCB;                  // IXC_ERR_BAD_PIPE
        ret;
      ixc_sh_disabled:
        mov rax, 0xFFFFFFCD;                  // IXC_ERR_PLANE_DISABLED
        ret
      }
    }

  // ==========================================================================
  // §J  iris_xe_cursor_hide(pipe) -> u64
  //
  // Flip the per-pipe `enabled` slot to 0, bump the hide counter,
  // emit the per-pipe `CURSOR HIDE pipe=<a|b|c>` INFO fingerprint.
  // Real body: CURCNTR = 0 (CURSOR_MODE_SELECT disabled); plane
  // vanishes at next VBLANK. Skeleton stops at state record + stat
  // bump + fingerprint.
  //
  // Gate:
  //   (1) pipe > 2 -> IXC_ERR_BAD_PIPE
  //
  // No "plane never armed" refusal on hide: hide-of-an-unarmed-plane
  // is a legitimate no-op (idempotent); refusing it would make a
  // teardown sequence more fragile than it needs to be.
  //
  // SysV: rdi = pipe. 3-push callee-save prologue to shield rbx
  // across the klog_s1 call.
  // ==========================================================================

  pub let iris_xe_cursor_hide : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: validate pipe, clear per-pipe `enabled`, bump _ixc_hide_ct, emit CURSOR HIDE fingerprint via klog_s1 (no KVs; the pipe is baked into the tag text). Gate: pipe > 2 -> IXC_ERR_BAD_PIPE. Idempotent on an unarmed plane -- hide-of-nothing is a VALID teardown step. Register plan: rbx = pipe (saved for tag selection after state clear). Entry rsp%16==8; after 3 pushes rsp%16==0 which is the klog_s1 pre-CALL requirement (klog_s1 wrapper itself takes zero stack args). The real body writes CURCNTR = 0 via mov_d; the skeleton stops at the state + fingerprint. Labels prefixed ixc_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                         // rbx = pipe (saved)

        // --- Gate: pipe in {0, 1, 2}.
        cmp rbx, 2;
        ja  ixc_hd_badpipe;

        // --- Row base + clear `enabled`.
        lea r10, [rip + _ixc_pipe_state];
        mov rax, rbx;
        shl rax, 5;
        add r10, rax;
        xor rax, rax;
        mov [r10 + 24], rax;                  // enabled = 0

        // --- Count the hide.
        mov rax, [rip + _ixc_hide_ct];
        add rax, 1;
        mov [rip + _ixc_hide_ct], rax;

        // --- Select the per-pipe CURSOR HIDE tag.
        cmp rbx, 0;
        je  ixc_hd_tag_a;
        cmp rbx, 1;
        je  ixc_hd_tag_b;
        lea rdx, [rip + ixc_tag_hide_c];
        jmp ixc_hd_tag_done;
      ixc_hd_tag_a:
        lea rdx, [rip + ixc_tag_hide_a];
        jmp ixc_hd_tag_done;
      ixc_hd_tag_b:
        lea rdx, [rip + ixc_tag_hide_b];
      ixc_hd_tag_done:

        // --- klog_s1(level=3, SUBSYS_DRV_, tag).  Zero KVs.
        mov rdi, 3;                           // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        // rdx = tag (already loaded above)
        call klog_s1;

        xor rax, rax;                         // IXC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ixc_hd_badpipe:
        mov rax, 0xFFFFFFCB;                  // IXC_ERR_BAD_PIPE
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  Stat accessors -- single-load leaf getters for witness callers.
  //
  // Five getters so a boot-witness programme can assert the entries
  // bumped past zero without reaching into the module's statics
  // directly. Each is a single-load leaf; signatures stay stable
  // when the follow-up slice re-shapes the storage.
  // ==========================================================================

  pub let iris_xe_cursor_init_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: single-load getter for _ixc_init_ct. Witness-side assertion anchor. Leaf.",
      block: { mov rax, [rip + _ixc_init_ct]; ret }
    }

  pub let iris_xe_cursor_set_bitmap_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: single-load getter for _ixc_set_bitmap_ct. Pair for iris_xe_cursor_init_count. Leaf.",
      block: { mov rax, [rip + _ixc_set_bitmap_ct]; ret }
    }

  pub let iris_xe_cursor_move_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: single-load getter for _ixc_move_ct. Pair for iris_xe_cursor_init_count. Leaf.",
      block: { mov rax, [rip + _ixc_move_ct]; ret }
    }

  pub let iris_xe_cursor_show_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: single-load getter for _ixc_show_ct. Pair for iris_xe_cursor_init_count. Leaf.",
      block: { mov rax, [rip + _ixc_show_ct]; ret }
    }

  pub let iris_xe_cursor_hide_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G3 (paideia-os#2540) skeleton: single-load getter for _ixc_hide_ct. Pair for iris_xe_cursor_init_count. Leaf.",
      block: { mov rax, [rip + _ixc_hide_ct]; ret }
    }
}
