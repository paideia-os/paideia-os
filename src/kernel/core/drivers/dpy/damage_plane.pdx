// src/kernel/core/drivers/dpy/damage_plane.pdx -- Wave 79 G9 [G7] (#2546)
//
// Intel Iris Xe damage-driven partial-plane update bind-up SKELETON for
// Wave 79 G9. When the compositor can compute the per-frame dirty sub-
// region of a plane (say, only the clock widget changed on an otherwise
// static desktop), the display engine does NOT need to re-fetch the
// full plane: PLANE_SURFLIVE + PLANE_SRC + per-pipe scissor can restrict
// the next vblank's DRAM read to only the damaged bytes. Saves power
// linearly with (1 - damage_area / plane_area); for a 4K panel with a
// 128x32 dirty strip (a cursor row and a clock update) that is ~ 99.9%
// of the per-frame DRAM read eliminated.
//
// This file sits beside direct_scanout.pdx (Wave 78 G8, #2545) which
// handed the pipe PLANE_SURF directly from a client BO; direct-scanout
// is the WHO-OWNS-THE-PRIMARY-PLANE question, damage-plane is the HOW-
// MUCH-OF-IT-TO-REFETCH question. The two paths compose: a direct-
// scanout plane with a damage rect fetches only the dirty subregion of
// the client BO at the next flip. It is also distinct from plane_
// primary.pdx (R36.M4-002, 484 LOC) which holds the cap/kind plane-
// lattice primary-role class on top of KIND_DISPLAY_PLANE -- that
// file DECIDES which memory row a primary plane is reading from;
// THIS file schedules the per-pipe scissor so the display engine's
// read is restricted to the damaged subregion.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// Posture: EVERY body here is a STUB per the Wave 79 G9 skeleton
// directive. The register offsets, per-pipe damage state, error
// taxonomy, and fingerprint shape are FROZEN at this skeleton stage
// so a follow-up slice can land the real MMIO bodies against the same
// ABI without churn. The static per-pipe state, the fingerprint tags,
// and the counter bumps are real; no live MMIO is written yet (QEMU:
// no Iris Xe BAR0; T14 G4: BAR0 is wired by R104.M1-003 but consumed
// only by iris_xe_modeset today).
//
// On the Wave 79 G9 skeleton, every entrypoint:
//   (1) range-checks pipe in {0,1,2} and refuses with
//       DP_ERR_UNKNOWN_PIPE (0xFFFFFD49) otherwise;
//   (2) validates its inputs (bo_cap != 0, w > 0, h > 0, armed_flag
//       as applicable);
//   (3) records (or reads) the per-pipe damage state block;
//   (4) bumps the per-op counter so an operator can see the entry
//       on a boot-witness programme;
//   (5) emits a fingerprint so submit / commit / get_rect events
//       show up on the klog wire.
//
// =============================================================================
// SECTION 1  REGISTER MAP (Intel Iris Xe / Alder-Lake / Raptor-Lake)
// =============================================================================
//
// Source: Intel bspec "Register Reference -> Display Registers -> ADL
// -> Pipe/Plane 1 (PRIMARY)". Each PRIMARY plane register sits at a
// 0x1000 pipe stride (A at 0x70000, B at 0x71000, C at 0x72000 base).
// For the damage-driven partial-update path, the five registers that
// the real body in the follow-up slice touches are:
//
//   PLANE_SURF       +0x19C   -- double-buffered plane base (writes
//                                queued for next vblank)
//   PLANE_SURFLIVE   +0x1AC   -- currently-scanning base (read-only
//                                to host; the real body uses this to
//                                detect whether the previous flip has
//                                already consumed before stamping SURF
//                                again)
//   PLANE_SRC        +0x18C   -- source rectangle inside the plane
//                                buffer (width-1 | height-1 << 16);
//                                the per-pipe scissor the display
//                                engine applies on the DRAM read
//   PLANE_POS        +0x188   -- plane position on pipe (xpos | ypos
//                                << 16); the plane's placement over
//                                PIPE_SRCSZ coordinates
//   PIPE_SRCSZ       +0x001C  -- pipe source size (base 0x60000 for A,
//                                0x61000 for B, 0x62000 for C); the
//                                outer frame bounds against which the
//                                per-plane PLANE_SRC rectangle is
//                                validated
//
// Resolving for all three pipes:
//   PLANE_SURF_A/B/C      = 0x7019C / 0x7119C / 0x7219C
//   PLANE_SURFLIVE_A/B/C  = 0x701AC / 0x711AC / 0x721AC
//   PLANE_SRC_A/B/C       = 0x7018C / 0x7118C / 0x7218C
//   PLANE_POS_A/B/C       = 0x70188 / 0x71188 / 0x71288  // see cross-ref
//   PIPE_SRCSZ_A/B/C      = 0x6001C / 0x6101C / 0x6201C
//
// Cross-reference with direct_scanout.pdx (Wave 78 G8, §A): that file
// names 0x7018C as DS_PLANE_POS_A and 0x70188 as DS_PLANE_STRIDE_A --
// a different Intel bspec revision's naming of the SAME register
// numeric slots. The follow-up MMIO slice reconciles the two names
// against Intel's current ADL bspec once a live scanout write is
// performed; at the skeleton stage no PLANE_* register is actually
// WRITTEN here, so the constants are documentation only and the
// naming divergence is harmless. The real body in the follow-up
// collapses the two files' register tables into a shared constants
// module.
//
// All accesses are 32-bit per Intel bspec §14 ("any wider or narrower
// access is undefined"). The real body in the follow-up slice uses
// mov_d (G1 sized store) for every PLANE_SURF / PLANE_SRC / PLANE_POS
// write; this skeleton emits none of them.
//
// =============================================================================
// SECTION 2  PARTIAL-UPDATE SEQUENCE (real body sketch)
// =============================================================================
//
// Dirty-rect compositor path per Intel's "Display Engine" §Partial-
// Plane-Update App Note (bspec):
//
//   t0: client renders into its BO; dirties sub-rect (x, y, w, h).
//   t1: compositor calls damage_plane_submit(pipe, bo_cap, x, y, w, h).
//       Skeleton records the rect; real body stashes host_pa too.
//   t2: compositor calls damage_plane_commit(pipe) when it is ready
//       to kick a flip.
//       Real body sequence:
//         (a) read PLANE_SURFLIVE -- if non-zero and != pending base
//             then previous flip is still in flight; the commit MUST
//             return DP_ERR_NOT_ARMED (treat the previous arm as stale).
//         (b) PLANE_SRC[pipe]  = (w-1) | (h-1 << 16)
//         (c) PLANE_POS[pipe]  = x | (y << 16)
//         (d) PLANE_SURF[pipe] = host_pa  (ARMD latches on vblank)
//         (e) armed_flag cleared (the arm was consumed).
//   t3: at the next vblank the display engine reads only the damaged
//       sub-rect from PLANE_SURF, saving (plane_area - dirty_area) /
//       plane_area of the frame's DRAM bandwidth.
//
// The skeleton stops at the state-record + counter bump + fingerprint;
// no PLANE_* write happens here. damage_plane_commit's skeleton
// behaviour is: refuse if armed_flag == 0 (DP_ERR_NOT_ARMED), else
// clear armed_flag and emit the COMMIT fingerprint.
//
// =============================================================================
// SECTION 3  VALIDATION RULES (damage_plane_submit)
// =============================================================================
//
// A (pipe, bo_cap, x, y, w, h) submission is admitted iff:
//
//   (R1) pipe in {0, 1, 2}            -> else DP_ERR_UNKNOWN_PIPE
//   (R2) bo_cap != 0                  -> else DP_ERR_BAD_BO
//   (R3) w > 0 && h > 0               -> else DP_ERR_BAD_DIMS
//   (R4) [DEFERRED] x + w <= PIPE_SRCSZ.width
//        && y + h <= PIPE_SRCSZ.height  -> else DP_ERR_RECT_OUT_PLANE
//
// (R4) is reserved for the follow-up slice that reads PIPE_SRCSZ live
// from MMIO; the skeleton has no mode geometry to validate against
// (the plane's recorded dimensions live in the modeset path, not here).
// The error code 0xFFFFFD4B DP_ERR_RECT_OUT_PLANE is minted at skeleton
// stage so a reviewer finding the rule retire does not have to re-plumb
// an error path; the real body uses it the moment PIPE_SRCSZ comes
// live.
//
// The submission entrypoint checks (R1) -> (R2) -> (R3) in that order
// and returns the first failing rule's code. It does NOT emit a
// fingerprint on the failing path (nothing was recorded, nothing to
// signal) -- the error code in rax is the only observable.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFFD49..0xFFFFFD4D
// =============================================================================
//
// Five codes reserved for this module. The band 0xFFFFFD44..0xFFFFFD48
// is already claimed by drivers/acpi/ec_discovery.pdx (Wave 78 I6,
// paideia-os#2563); the band 0xFFFFFD50..0xFFFFFD51 is claimed by
// driver/registry_snapshot.pdx; 0xFFFFFD40..0xFFFFFD43 by driver/
// registry_lookup.pdx. The sub-page 0xFFFFFD49..0xFFFFFD4F was free
// at landing time (grep across `src/kernel/` returned ZERO hits on
// 0xFFFFFD49..4F), so this file takes 0xFFFFFD49..0xFFFFFD4D -- the
// natural neighbour of ec_discovery's 0xFFFFFD44..48 above. Values:
//
//     0xFFFFFD49  DP_ERR_UNKNOWN_PIPE   -- pipe not in {0, 1, 2}
//     0xFFFFFD4A  DP_ERR_BAD_BO         -- bo_cap == 0 (no BO handed
//                                          to the submit path)
//     0xFFFFFD4B  DP_ERR_RECT_OUT_PLANE -- reserved for the follow-up
//                                          slice's PIPE_SRCSZ-check
//                                          (skeleton never emits)
//     0xFFFFFD4C  DP_ERR_NOT_ARMED      -- damage_plane_commit called
//                                          on a pipe whose armed_flag
//                                          is 0 (no submit sits
//                                          pending)
//     0xFFFFFD4D  DP_ERR_BAD_DIMS       -- w == 0 or h == 0
//
// =============================================================================
// SECTION 5  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized stores): the real body's PLANE_SRC / PLANE_POS /
//      PLANE_SURF writes use mov_d (32-bit sized store). The damage-
//      rect-to-out-buffer u32 writes in damage_plane_get_rect use
//      mov_d too. State slots are u64 so plain REX.W `mov` is correct
//      for the per-pipe state block.
//   G4 (full-register compares): every cmp here is on a 64-bit
//      register; no `cmp al, imm`, no `cmp eax, imm` short-form.
//   No `test rN, rN` -- equality-against-zero is `cmp rN, 0`.
//   No `and rN, imm64` -- the low-32 extraction uses `shl 32; shr 32`
//      (unambiguous, no sign-extension question) rather than
//      `and r, 0xFFFFFFFF`. High-32 extraction uses `shr r, 32`.
//      Masks that fit imm8 (never used in this file) would be fine.
//   No two-operand `imul r, imm` -- the per-pipe row stride is 32,
//      folded as `shl r, 5`.
//   64-bit immediates -- the return-code constants (0xFFFFFD49..4D)
//      fit imm32 with bit 31 set, so the pdx encoder emits them via
//      the full REX.W `mov r64, imm64` form; proven form across
//      ec_discovery.pdx and every other FD-band driver.
//   Multiline `pub let ="..."` is forbidden by the pdx parser; every
//      tag below is a single line.
//   Module basename matches filename basename:
//      damage_plane.pdx -> module DamagePlane.
//   Reserved labels -- every label in this file is prefixed `dp_`
//      so none collides with the ds_/ixc_/ixm_/plpr_ labels of the
//      sibling dpy drivers, and none accidentally spells `loop`,
//      `if`, or `let`.
//   klog wrapper discipline -- the three fingerprints each ride an
//      EXISTING wrapper to avoid gratuitous klog mint churn:
//        SUBMIT  bo=0x<hex> pipe=<dec>        -> klog_s1_x1_d1
//        COMMIT  pipe=<dec> armed=<dec>       -> klog_s1_d2
//        RECT    pipe=<dec> x=<dec> y=<dec>
//                           w=<dec> h=<dec>   -> klog_s1_d5
//      SUBMIT reorders bo/pipe (hex first, decimal second) to reuse
//      klog_s1_x1_d1 verbatim -- the same ordering the Wave 78
//      DIRECT_SCANOUT ARMED fingerprint uses. A future unification
//      slice can mint klog_s1_d1_x1 (decimal first, hex second) and
//      flip SUBMIT's order back; the skeleton stays additive and
//      reuses the proven klog_s1_x1_d1 caller recipe (sub rsp, 16;
//      mov [rsp+0], vd; CALL; add rsp, 16) that burned 5+ softarchs
//      earlier in this session when they wrote vd at [rsp+8] instead.
//   Fingerprint tag length -- each [u8; N] tag's N is strlen + 1
//      (NUL terminator); tag_len off-by-one is a build-time error
//      the pdx encoder catches.
//
// =============================================================================
// SECTION 6  STACK + REGISTER PLAN
// =============================================================================
//
// Four entrypoints:
//
//   damage_plane_submit   (pipe, bo_cap, x, y, w, h)      -> u64
//   damage_plane_commit   (pipe)                          -> u64
//   damage_plane_get_rect (pipe, out_rect_ptr)            -> u64
//   cap_handler_damage_plane (rights, target_ptr, op_arg) -> u64
//
// All four are non-leaf (nested calls into klog_* / sibling getters).
// All four use the modeset.pdx 3-/5-push callee-save prologue:
//
//   push rbx; push r12; push r13;              // 3-push, 24 B
//   -- entry rsp%16 == 8; after 3 pushes rsp%16 == 0 (pre-CALL)
//
//   push rbx; push r12; push r13; push r14; push r15;  // 5-push, 40 B
//   -- entry rsp%16 == 8; after 5 pushes rsp%16 == 0 (pre-CALL)
//
// damage_plane_submit uses 5 pushes (needs rbx = bo_cap, r12 = pipe,
// r13 = packed x_y, r14 = packed w_h, r15 = scratch for state writes
// and inline rect-is-nonzero gate).  Then `sub rsp, 16; mov [rsp+0],
// r12` to stage vd=pipe for klog_s1_x1_d1 (direct_scanout_arm
// precedent, §G); `add rsp, 16` reclaims.
//
// damage_plane_commit uses 3 pushes (rbx = pipe, r12 = row base,
// r13 = scratch).  Then `sub rsp, 16; mov [rsp+0], rax` stages
// vd=armed_flag_before_clear for klog_s1_d2.  Pre-CALL rsp%16==0.
//
// damage_plane_get_rect uses 5 pushes (rbx = pipe, r12 = out_rect_
// ptr, r13 = row base, r14 = packed x_y, r15 = packed w_h).  Then
// `sub rsp, 64` reserves 7 u64 stack-arg slots (v2/k3/v3/k4/v4/k5/v5
// = 56 bytes) + 8-byte pad for 16B alignment, for klog_s1_d5.  Pre-
// CALL rsp%16==0.
//
// cap_handler_damage_plane uses 3 pushes (rbx = rights, r12 = pipe,
// r13 = op_code).  klog_s1 entry chatter needs 3 reg args only (no
// stack).
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file compiles
// alongside the kernel because tools/build.sh recurses through
// src/kernel/core/drivers/dpy/ with a single `find`, so a new .pdx in
// that directory is picked up automatically; no build.sh edit required.
//
// invoke.pdx gets ONE new dispatch arm (0x4C -> cap_handler_damage_
// plane) landed alongside this file (see invoke.pdx §Wave 79 G9 arm)
// so the kind is reachable from cap_invoke the moment this skeleton
// lands.
//
// No new klog wrapper is minted -- the three fingerprints ride
// klog_s1_x1_d1 (SUBMIT), klog_s1_d2 (COMMIT), and klog_s1_d5 (RECT),
// all already in klog/wrappers.pdx.
//
// No caller invokes damage_plane_* yet. A follow-up slice adds a
// boot-witness programme at tests/kernel/drivers/wit_damage_plane.pdx
// that:
//   (1) damage_plane_submit(0, bo, 32, 32, 128, 32) -> DP_OK;
//   (2) damage_plane_commit(0) -> DP_OK;
//   (3) damage_plane_commit(0) -> DP_ERR_NOT_ARMED (idempotency);
//   (4) damage_plane_get_rect(0, &out) -> DP_OK;
// and asserts the SUBMIT / COMMIT / RECT fingerprints land on the
// klog wire.

module DamagePlane = structure {

  // ==========================================================================
  // §A  Register offsets -- PLANE_SURF / PLANE_SURFLIVE / PLANE_SRC /
  //                        PLANE_POS / PIPE_SRCSZ
  // ==========================================================================
  //
  // Per Intel bspec "Register Reference -> Display Registers -> ADL"
  // (Alder Lake / Raptor Lake). Pipe stride is 0x1000. See §1 header
  // for the per-register semantics and the direct_scanout.pdx naming
  // cross-reference.

  pub let DP_PLANE_SURF_A      : u64 = 0x7019C
  pub let DP_PLANE_SURF_B      : u64 = 0x7119C
  pub let DP_PLANE_SURF_C      : u64 = 0x7219C

  pub let DP_PLANE_SURFLIVE_A  : u64 = 0x701AC
  pub let DP_PLANE_SURFLIVE_B  : u64 = 0x711AC
  pub let DP_PLANE_SURFLIVE_C  : u64 = 0x721AC

  pub let DP_PLANE_SRC_A       : u64 = 0x7018C
  pub let DP_PLANE_SRC_B       : u64 = 0x7118C
  pub let DP_PLANE_SRC_C       : u64 = 0x7218C

  pub let DP_PLANE_POS_A       : u64 = 0x70188
  pub let DP_PLANE_POS_B       : u64 = 0x71188
  pub let DP_PLANE_POS_C       : u64 = 0x72188

  pub let DP_PIPE_SRCSZ_A      : u64 = 0x6001C
  pub let DP_PIPE_SRCSZ_B      : u64 = 0x6101C
  pub let DP_PIPE_SRCSZ_C      : u64 = 0x6201C

  pub let DP_PIPE_STRIDE       : u64 = 0x1000

  // Pipe identifiers. Public so a caller can read-aloud the pipe
  // argument rather than hard-code 0/1/2 at the call site.
  pub let DP_PIPE_A : u64 = 0
  pub let DP_PIPE_B : u64 = 1
  pub let DP_PIPE_C : u64 = 2
  pub let DP_PIPE_COUNT : u64 = 3

  // armed_flag values. Documented so the follow-up slice (and the
  // boot-witness programme referenced in §7) can read these aloud
  // instead of hard-coding 0/1.
  pub let DP_UNARMED : u64 = 0
  pub let DP_ARMED   : u64 = 1

  // ==========================================================================
  // §B  Failure taxonomy -- band 0xFFFFFD49..0xFFFFFD4D
  //
  // See §4 of the file header for the band provenance (natural neighbour
  // of ec_discovery.pdx's 0xFFFFFD44..48 band).
  // ==========================================================================

  pub let DP_OK                      : u64 = 0
  pub let DP_ERR_UNKNOWN_PIPE        : u64 = 0xFFFFFD49
  pub let DP_ERR_BAD_BO              : u64 = 0xFFFFFD4A
  pub let DP_ERR_RECT_OUT_PLANE      : u64 = 0xFFFFFD4B
  pub let DP_ERR_NOT_ARMED           : u64 = 0xFFFFFD4C
  pub let DP_ERR_BAD_DIMS            : u64 = 0xFFFFFD4D

  // ==========================================================================
  // §C  Per-pipe damage state -- 4 u64 slots per pipe * 3 pipes = 12 u64s.
  //
  // Layout per pipe (32 bytes stride, pipe * 32 = `shl r, 5`):
  //   +0   bo_cap          -- client BO cap backing the damaged plane
  //                            (0 on an unarmed pipe)
  //   +8   x_y_packed      -- x | (y << 32), each u32
  //   +16  w_h_packed      -- w | (h << 32), each u32
  //   +24  armed_flag      -- 0 idle, 1 damage armed awaiting commit
  //
  // The packed layout mirrors the Intel bspec's PLANE_POS encoding of
  // two u16s per register (x | y << 16), only widened to u32 each so a
  // 4K-wide panel's full-row dirty is representable. The follow-up MMIO
  // slice narrows (x, y, w, h) back to u16 at the PLANE_POS / PLANE_SRC
  // write time (truncation is safe because max pipe_srcsz on Iris Xe
  // is 7680x4320 and all four fit in u16).
  // ==========================================================================

  pub let mut _damage_state : [u64; 12] = uninit @align(64)

  // Per-op stats (bumped once per successful entry). Visible via the
  // getter trio in §J.
  pub let mut _dp_submit_ct   : u64 = 0
  pub let mut _dp_commit_ct   : u64 = 0
  pub let mut _dp_rect_ct     : u64 = 0

  // ==========================================================================
  // §D  Fingerprint tags + keys
  //
  // Three tags, one per entrypoint. Each is a single-line string
  // literal (the multiline `pub let ="..."` form is forbidden by the
  // pdx parser). Tag length is `strlen + 1` (NUL terminator) so a
  // tag_len off-by-one is a build-time error.
  //
  // Fingerprints on the wire:
  //   DAMAGE SUBMIT bo=0x<hex> pipe=<dec>
  //   DAMAGE COMMIT pipe=<dec> armed=<dec>
  //   DAMAGE RECT pipe=<dec> x=<dec> y=<dec> w=<dec> h=<dec>
  //
  // Matches tests/fingerprints/damage_plane.golden pattern.
  // ==========================================================================

  pub let dp_tag_submit : [u8; 14] = "DAMAGE SUBMIT\0"
  pub let dp_tag_commit : [u8; 14] = "DAMAGE COMMIT\0"
  pub let dp_tag_rect   : [u8; 12] = "DAMAGE RECT\0"

  pub let dp_k_pipe  : [u8; 5] = "pipe\0"
  pub let dp_k_bo    : [u8; 3] = "bo\0"
  pub let dp_k_armed : [u8; 6] = "armed\0"
  pub let dp_k_x     : [u8; 2] = "x\0"
  pub let dp_k_y     : [u8; 2] = "y\0"
  pub let dp_k_w     : [u8; 2] = "w\0"
  pub let dp_k_h     : [u8; 2] = "h\0"

  // Handler-entry chatter tag (for the cap-handler path).
  pub let dp_tag_handler_entry : [u8; 21] = "DAMAGE handler entry\0"

  // ==========================================================================
  // §E  damage_plane_submit(pipe, bo_cap, x, y, w, h) -> u64
  //
  // Record a damage rect for `pipe` + arm it for a subsequent
  // damage_plane_commit flip. Returns DP_OK on admission, else one of
  // the DP_ERR_* sentinels (0xFFFFFD49..4D) on the first failing rule.
  //
  // Gates in order:
  //   (R1) pipe > 2                         -> DP_ERR_UNKNOWN_PIPE
  //   (R2) bo_cap == 0                      -> DP_ERR_BAD_BO
  //   (R3) w == 0 || h == 0                 -> DP_ERR_BAD_DIMS
  //   (R4) [DEFERRED] x+w > PIPE_SRCSZ.w ||
  //        y+h > PIPE_SRCSZ.h               -> DP_ERR_RECT_OUT_PLANE
  //
  // On admission the body:
  //   (a) writes bo_cap to _damage_state[pipe*32 + 0];
  //   (b) writes (x | y << 32) to +8;
  //   (c) writes (w | h << 32) to +16;
  //   (d) writes 1 (DP_ARMED) to +24;
  //   (e) bumps _dp_submit_ct;
  //   (f) emits `DAMAGE SUBMIT bo=0x<hex> pipe=<dec>` via klog_s1_x1_d1.
  //
  // No fingerprint is emitted on the gate-failing paths -- the error
  // code in rax is the only observable, same posture as direct_scanout
  // _arm's bad-pipe path (§G of that file).
  //
  // SysV: rdi = pipe, rsi = bo_cap, rdx = x, rcx = y, r8 = w, r9 = h.
  // Stack recipe: 5 callee-save pushes (rbx = bo_cap, r12 = pipe,
  //   r13 = x | y<<32, r14 = w | h<<32, r15 = scratch).
  // ==========================================================================

  pub let damage_plane_submit : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64, bo_cap: u64, x: u64, y: u64, w: u64, h: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: validation gate chain over (pipe, bo_cap, x, y, w, h). Rules in order: (R1) pipe > 2 -> DP_ERR_UNKNOWN_PIPE (0xFFFFFD49); (R2) bo_cap == 0 -> DP_ERR_BAD_BO (0xFFFFFD4A); (R3) w == 0 || h == 0 -> DP_ERR_BAD_DIMS (0xFFFFFD4D). (R4) rect-out-of-plane via PIPE_SRCSZ is reserved for the follow-up MMIO slice and emits 0xFFFFFD4B when live. Admission records (bo_cap, x|y<<32, w|h<<32, armed_flag=1) at _damage_state[pipe*32] + bumps _dp_submit_ct + emits `DAMAGE SUBMIT bo=0x<hex> pipe=<dec>` via klog_s1_x1_d1. SUBMIT fingerprint reorders bo/pipe (hex first, decimal second) to reuse klog_s1_x1_d1 verbatim rather than mint klog_s1_d1_x1 -- same ordering the Wave 78 DIRECT_SCANOUT ARMED fingerprint uses, see direct_scanout.pdx §G. Register plan: rbx = bo_cap (saved), r12 = pipe (saved), r13 = x | y<<32 (saved), r14 = w | h<<32 (saved for state write + inline w/h extraction), r15 = scratch for row-base and dim-zero gates. Five callee-save pushes land rsp%16==0 at every nested call (entry %16==8, +40 -> 48, %16==0; the firmware_blob five-push discipline). klog_s1_x1_d1 caller contract: `sub rsp, 16; mov [rsp+0], r12` writes vd=pipe to caller [rsp+0] -- which the wrapper reads at [rbp+16] after its own `push rbp`. Writing vd at [rsp+8] would land it at [rbp+24] inside the wrapper and the real pipe value never reaches the fingerprint (the klog_s1_x1_d1 caller trap called out in the Wave 79 G9 task directive, which has burned 5+ softarchs this session). `add rsp, 16` reclaims pad + vd slot. Low-32 / high-32 extraction uses `shl 32; shr 32` and `shr r, 32` (unambiguous; no sign-extension question on `mov r, 0xFFFFFFFF`). Pack order of x|y and w|h matches §C per-pipe state layout. Labels prefixed dp_sub_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;                       // rbx = bo_cap (saved)
        mov r12, rdi;                       // r12 = pipe (saved)

        // Pack x_y = (x | y<<32) into r13 (saved for state write).
        mov r13, rcx;                       // r13 = y (low)
        shl r13, 32;                        // r13 = y << 32
        or  r13, rdx;                       // r13 = x | (y << 32)

        // Pack w_h = (w | h<<32) into r14 (saved for state write +
        // inline w==0 / h==0 gate).
        mov r14, r9;                        // r14 = h (low)
        shl r14, 32;                        // r14 = h << 32
        or  r14, r8;                        // r14 = w | (h << 32)

        // --- Gate (R1): pipe in {0, 1, 2}.
        cmp r12, 2;
        ja  dp_sub_bad_pipe;

        // --- Gate (R2): bo_cap != 0.
        cmp rbx, 0;
        je  dp_sub_bad_bo;

        // --- Gate (R3): w > 0 && h > 0.
        //     Extract w (low 32) via shl 32; shr 32 (unambiguous).
        mov r15, r14;
        shl r15, 32;
        shr r15, 32;                        // r15 = w
        cmp r15, 0;
        je  dp_sub_bad_dims;
        //     Extract h (high 32) via shr 32.
        mov r15, r14;
        shr r15, 32;                        // r15 = h
        cmp r15, 0;
        je  dp_sub_bad_dims;

        // --- Admitted. Compute per-pipe row base: &_damage_state +
        //     pipe * 32.
        lea r15, [rip + _damage_state];
        mov rax, r12;
        shl rax, 5;                         // pipe * 32
        add r15, rax;

        // --- Record state.
        mov [r15 + 0],  rbx;                // bo_cap
        mov [r15 + 8],  r13;                // x | y<<32
        mov [r15 + 16], r14;                // w | h<<32
        mov rax, 1;                         // DP_ARMED
        mov [r15 + 24], rax;                // armed_flag

        // --- Count the submission (bump BEFORE fingerprint so a
        //     crash mid-fingerprint still records the entry).
        mov rax, [rip + _dp_submit_ct];
        add rax, 1;
        mov [rip + _dp_submit_ct], rax;

        // --- klog_s1_x1_d1(level=3, SUBSYS_DRV_, tag_submit,
        //                   k_bo, bo_cap, k_pipe, [vd=pipe])
        //
        // After 5 callee-save pushes rsp%16==0 (entry %16==8, +40 =
        // 48, %16==0). A plain `push rax` to stage vd would land
        // rsp%16==8 pre-CALL and the wrapper's `push rbp; sub rsp,
        // 48` recipe would then nest its own klog_emit_core call at
        // %16==8 (misaligned). The idiom is `sub rsp, 16; mov
        // [rsp+0], val` -- 16 bytes reserves the vd slot AND keeps
        // alignment; the wrapper reads vd at [rbp+16] after its own
        // `push rbp`, which is exactly what caller [rsp+0] + CALL
        // (-8) + push rbp (-8) resolves to. Writing vd at [rsp+8]
        // would land it at [rbp+24] inside the wrapper (the
        // klog_s1_x1_d1 caller trap called out in the Wave 79 G9
        // task directive).
        sub rsp, 16;
        mov [rsp + 0], r12;                 // vd = pipe (caller [rsp+0])
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + dp_tag_submit];
        lea rcx, [rip + dp_k_bo];
        mov r8, rbx;                        // v1 = bo_cap
        lea r9, [rip + dp_k_pipe];
        call klog_s1_x1_d1;
        add rsp, 16;                        // reclaim pad + vd slot

        xor rax, rax;                       // DP_OK
        jmp dp_sub_out;

      dp_sub_bad_pipe:
        mov rax, 0xFFFFFD49;                // DP_ERR_UNKNOWN_PIPE
        jmp dp_sub_out;
      dp_sub_bad_bo:
        mov rax, 0xFFFFFD4A;                // DP_ERR_BAD_BO
        jmp dp_sub_out;
      dp_sub_bad_dims:
        mov rax, 0xFFFFFD4D;                // DP_ERR_BAD_DIMS

      dp_sub_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §F  damage_plane_commit(pipe) -> u64
  //
  // Kick a partial-plane flip for `pipe`. Real body (follow-up slice):
  //
  //   (1) Read PLANE_SURFLIVE[pipe]; if non-zero and != pending base,
  //       the previous flip is still in flight -- return DP_ERR_NOT_
  //       ARMED (the arm is treated as stale).
  //   (2) MMIO: PLANE_SRC[pipe]  = (w-1) | (h-1 << 16)  (via mov_d).
  //   (3) MMIO: PLANE_POS[pipe]  = x | (y << 16)         (via mov_d).
  //   (4) MMIO: PLANE_SURF[pipe] = host_pa(bo_cap)       (via mov_d).
  //   (5) Clear armed_flag; the next vblank consumes the arm.
  //
  // This skeleton stops at the armed_flag check + clear + counter bump
  // + fingerprint. It does NOT issue any PLANE_* MMIO write; the per-
  // pipe damage state is observed by callers via damage_plane_get_rect
  // and (for the armed flag alone) via the cap_handler query op 0.
  //
  // Gates:
  //   (R1) pipe > 2            -> DP_ERR_UNKNOWN_PIPE
  //   (R2) armed_flag == 0     -> DP_ERR_NOT_ARMED (idempotent)
  //
  // SysV: rdi = pipe.
  // Stack recipe: 3 callee-save pushes (rbx = pipe, r12 = row base,
  //   r13 = armed_flag snapshot for the fingerprint).
  // ==========================================================================

  pub let damage_plane_commit : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: read armed_flag at _damage_state[pipe*32+24]; if 0 -> DP_ERR_NOT_ARMED (0xFFFFFD4C); else clear + bump _dp_commit_ct + emit `DAMAGE COMMIT pipe=<dec> armed=<dec>` via klog_s1_d2 (armed=1 on the successful commit, snapshotting the pre-clear value). Gate: pipe > 2 -> DP_ERR_UNKNOWN_PIPE (0xFFFFFD49). The real body (follow-up) stamps PLANE_SRC / PLANE_POS / PLANE_SURF via mov_d after a PLANE_SURFLIVE readback; this skeleton records only the state-slot clear. Register plan: rbx = pipe (saved), r12 = per-pipe row base, r13 = armed_flag snapshot (threaded to the fingerprint). Three callee-save pushes land rsp%16==0 at every nested call (entry %16==8, +24 = 32, %16==0). klog_s1_d2 caller contract: `sub rsp, 16; mov [rsp+0], val` writes v2=armed to caller [rsp+0] -- the wrapper reads v2 at [rbp+16] after its own `push rbp`. `add rsp, 16` reclaims pad + v2 slot. The NOT_ARMED path (R2) refuses WITHOUT a counter bump or a fingerprint; the error code in rax is the only observable, same posture as damage_plane_submit's gate-failing paths. Labels prefixed dp_com_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = pipe (saved)

        // --- Gate (R1): pipe in {0, 1, 2}.
        cmp rbx, 2;
        ja  dp_com_bad_pipe;

        // --- Compute per-pipe row base.
        lea r12, [rip + _damage_state];
        mov rax, rbx;
        shl rax, 5;                         // pipe * 32
        add r12, rax;

        // --- Gate (R2): armed_flag == 0 -> DP_ERR_NOT_ARMED.
        mov r13, [r12 + 24];                // r13 = armed_flag (snapshot)
        cmp r13, 0;
        je  dp_com_not_armed;

        // --- Clear armed_flag (the arm is consumed).
        xor rax, rax;
        mov [r12 + 24], rax;

        // --- Count the commit.
        mov rax, [rip + _dp_commit_ct];
        add rax, 1;
        mov [rip + _dp_commit_ct], rax;

        // --- klog_s1_d2(level=3, SUBSYS_DRV_, tag_commit, k_pipe,
        //                pipe, k_armed, [v2=armed]).
        //
        // Pre-CALL rsp%16==0 (3 pushes land %16==0; sub rsp,16 keeps
        // %16==0). Wrapper reads v2 at [rbp+16] = caller [rsp+0]
        // after sub rsp,16.
        sub rsp, 16;
        mov [rsp + 0], r13;                 // v2 = armed_flag snapshot
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + dp_tag_commit];
        lea rcx, [rip + dp_k_pipe];
        mov r8, rbx;                        // v1 = pipe
        lea r9, [rip + dp_k_armed];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                       // DP_OK
        jmp dp_com_out;

      dp_com_bad_pipe:
        mov rax, 0xFFFFFD49;                // DP_ERR_UNKNOWN_PIPE
        jmp dp_com_out;
      dp_com_not_armed:
        mov rax, 0xFFFFFD4C;                // DP_ERR_NOT_ARMED

      dp_com_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §G  damage_plane_get_rect(pipe, out_rect_ptr) -> u64
  //
  // Read the per-pipe damage rect into a caller-owned 4-u32 buffer
  // laid out as {x, y, w, h}. Returns DP_OK after the write.
  //
  // Writes exactly 16 bytes (4 u32s) at out_rect_ptr via mov_d (G1
  // sized store). The caller is responsible for the buffer's
  // kernel-visibility; the skeleton does NOT fault-check out_rect_ptr.
  // A null out_rect_ptr yields a page-fault at the first store, which
  // is the same posture every other getter-into-caller-buffer entry
  // on the dpy branch takes (direct_scanout_eligibility,
  // iris_xe_vbt_lookup_*).
  //
  // Gate:
  //   (R1) pipe > 2            -> DP_ERR_UNKNOWN_PIPE
  //
  // SysV: rdi = pipe, rsi = out_rect_ptr.
  // Stack recipe: 5 callee-save pushes (rbx = pipe, r12 = out_rect
  //   _ptr, r13 = row base, r14 = packed x_y, r15 = packed w_h).
  // ==========================================================================

  pub let damage_plane_get_rect : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64, out_rect_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: load _damage_state[pipe*32 + 8] (packed x|y<<32) and [+16] (packed w|h<<32); write 4 u32s to out_rect_ptr as {x,y,w,h} via mov_d; bump _dp_rect_ct; emit `DAMAGE RECT pipe=<dec> x=<dec> y=<dec> w=<dec> h=<dec>` via klog_s1_d5. Gate: pipe > 2 -> DP_ERR_UNKNOWN_PIPE (0xFFFFFD49). out_rect_ptr fault-checking is the caller's responsibility (same posture as direct_scanout_eligibility, iris_xe_vbt_lookup_*). Register plan: rbx = pipe (saved), r12 = out_rect_ptr (saved), r13 = row base, r14 = packed x_y (saved for the fingerprint's x/y extraction), r15 = packed w_h (saved for the fingerprint's w/h extraction). Five callee-save pushes land rsp%16==0; `sub rsp, 64` reserves 7 u64 stack-arg slots (v2 at [rsp+0], k3/v3/k4/v4/k5/v5 at [rsp+8..48]) + 8-byte pad for klog_s1_d5. Pre-CALL rsp%16==0. Low-32 extraction uses `shl 32; shr 32`; high-32 extraction uses `shr r, 32`. mov_d emits 32-bit sized stores for the out buffer (G1 posture; same form fb_glyph.pdx uses). Labels prefixed dp_gr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = pipe (saved)
        mov r12, rsi;                       // r12 = out_rect_ptr (saved)

        // --- Gate: pipe in {0, 1, 2}.
        cmp rbx, 2;
        ja  dp_gr_bad_pipe;

        // --- Compute per-pipe row base.
        lea r13, [rip + _damage_state];
        mov rax, rbx;
        shl rax, 5;                         // pipe * 32
        add r13, rax;

        // --- Load packed x_y and w_h.
        mov r14, [r13 + 8];                 // r14 = x | y<<32
        mov r15, [r13 + 16];                // r15 = w | h<<32

        // --- Write out_rect_ptr as 4 u32s: {x, y, w, h}.
        //     x = r14 low 32  (shl 32; shr 32 for unambiguous mask).
        mov rax, r14;
        shl rax, 32;
        shr rax, 32;
        mov_d [r12 + 0], rax;               // u32 x at offset 0
        //     y = r14 high 32 (shr r, 32).
        mov rax, r14;
        shr rax, 32;
        mov_d [r12 + 4], rax;               // u32 y at offset 4
        //     w = r15 low 32.
        mov rax, r15;
        shl rax, 32;
        shr rax, 32;
        mov_d [r12 + 8], rax;               // u32 w at offset 8
        //     h = r15 high 32.
        mov rax, r15;
        shr rax, 32;
        mov_d [r12 + 12], rax;              // u32 h at offset 12

        // --- Count the read.
        mov rax, [rip + _dp_rect_ct];
        add rax, 1;
        mov [rip + _dp_rect_ct], rax;

        // --- klog_s1_d5(level=3, SUBSYS_DRV_, tag_rect, k_pipe, pipe,
        //                k_x, [v2=x], [k3=k_y], [v3=y],
        //                [k4=k_w], [v4=w], [k5=k_h], [v5=h])
        //
        // 7 u64 stack slots (56 bytes) + 8-byte pad = 64 bytes.
        // Pre-CALL rsp%16==0 (5 pushes land %16==0; sub rsp,64 keeps
        // %16==0). Wrapper reads v2 at [rbp+16] = caller [rsp+0];
        // k3 at [rbp+24] = caller [rsp+8]; and so on through v5 at
        // [rbp+64] = caller [rsp+48].
        sub rsp, 64;

        //     v2 = x (r14 low 32).
        mov rax, r14;
        shl rax, 32;
        shr rax, 32;
        mov [rsp + 0], rax;

        //     k3 = dp_k_y.
        lea rax, [rip + dp_k_y];
        mov [rsp + 8], rax;

        //     v3 = y (r14 high 32).
        mov rax, r14;
        shr rax, 32;
        mov [rsp + 16], rax;

        //     k4 = dp_k_w.
        lea rax, [rip + dp_k_w];
        mov [rsp + 24], rax;

        //     v4 = w (r15 low 32).
        mov rax, r15;
        shl rax, 32;
        shr rax, 32;
        mov [rsp + 32], rax;

        //     k5 = dp_k_h.
        lea rax, [rip + dp_k_h];
        mov [rsp + 40], rax;

        //     v5 = h (r15 high 32).
        mov rax, r15;
        shr rax, 32;
        mov [rsp + 48], rax;

        //     6 reg args: level, subsys, tag, k_pipe, pipe, k_x.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + dp_tag_rect];
        lea rcx, [rip + dp_k_pipe];
        mov r8, rbx;                        // v1 = pipe
        lea r9, [rip + dp_k_x];
        call klog_s1_d5;

        add rsp, 64;                        // reclaim

        xor rax, rax;                       // DP_OK
        jmp dp_gr_out;

      dp_gr_bad_pipe:
        mov rax, 0xFFFFFD49;                // DP_ERR_UNKNOWN_PIPE

      dp_gr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  Per-pipe armed-flag getter
  //
  // Returns the armed_flag for `pipe` (0 idle, 1 damage armed), or 0
  // if `pipe` is out of range. Leaf; no fingerprint.
  //
  // SysV: rdi = pipe. Leaf.
  // ==========================================================================

  pub let damage_plane_armed : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: pipe > 2 -> 0; else return _damage_state[pipe * 32 + 24] (armed_flag slot). Leaf, no callee-save prologue. Labels prefixed dp_arm_.",
      block: {
        cmp rdi, 2;
        ja  dp_arm_zero;

        lea rax, [rip + _damage_state];
        mov rcx, rdi;
        shl rcx, 5;                         // pipe * 32
        add rax, rcx;
        mov rax, [rax + 24];                // armed_flag slot
        ret;

      dp_arm_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // §I  Per-pipe armed-bo getter
  //
  // Returns the bo_cap armed as damage source for `pipe`, or 0 if the
  // pipe is unarmed (or `pipe` is out of range). Leaf; no fingerprint.
  //
  // SysV: rdi = pipe. Leaf.
  // ==========================================================================

  pub let damage_plane_armed_bo : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: pipe > 2 -> 0; else return _damage_state[pipe * 32 + 0] (bo_cap slot). Leaf. Labels prefixed dp_abo_.",
      block: {
        cmp rdi, 2;
        ja  dp_abo_zero;

        lea rax, [rip + _damage_state];
        mov rcx, rdi;
        shl rcx, 5;                         // pipe * 32
        add rax, rcx;
        mov rax, [rax + 0];                 // bo_cap slot
        ret;

      dp_abo_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // §J  Per-op counter getters
  //
  // Three leaf getters so a boot-witness programme can assert
  // (submit_ct, commit_ct, rect_ct) without touching the _dp_*_ct
  // symbols directly.
  // ==========================================================================

  pub let damage_plane_submit_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: single mov load from _dp_submit_ct. Leaf.",
      block: {
        mov rax, [rip + _dp_submit_ct];
        ret
      }
    }

  pub let damage_plane_commit_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: single mov load from _dp_commit_ct. Leaf.",
      block: {
        mov rax, [rip + _dp_commit_ct];
        ret
      }
    }

  pub let damage_plane_rect_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: single mov load from _dp_rect_ct. Leaf.",
      block: {
        mov rax, [rip + _dp_rect_ct];
        ret
      }
    }

  // ==========================================================================
  // §K  cap_handler_damage_plane(rights, target_ptr, op_arg) -> u64
  //
  // KIND_DAMAGE_PLANE (0x4C) cap_invoke dispatch handler. Reachable
  // from cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x4C;
  // je call_kind_damage_plane` arm added alongside this file.
  //
  // The three main entrypoints each take more than three arguments
  // (submit: 6, get_rect: 2 but one is an out-pointer, commit: 1), so
  // cap_invoke -- which hands the handler only (rights, target_ptr,
  // op_arg) -- cannot plumb the submit path directly without a packed
  // op_arg or an extended cap_invoke signature. The handler is
  // therefore QUERY-ONLY at skeleton stage, exactly like iris_xe_
  // hotplug / kind_gpu_bo_drv / direct_scanout do for their first
  // slice. Three ops:
  //
  //     op 0 DP_OP_QUERY_ARMED      -> armed_flag for `pipe`
  //                                    (target_ptr[7:0])
  //     op 1 DP_OP_QUERY_SUBMIT_CT  -> _dp_submit_ct (ignores target)
  //     op 2 DP_OP_QUERY_COMMIT_CT  -> _dp_commit_ct (ignores target)
  //     else                           INVOKE_UNSUPPORTED
  //
  // The mutating primitives (submit / commit / get_rect) ride super-
  // visor callers above the generic cap_invoke syscall ABI; a follow-
  // up slice either extends cap_invoke with a 4-register slot variant
  // or packs (bo_cap, x, y, w, h) into target_ptr/op_arg for the
  // submit path (bo_cap would come from a sibling cap on the caller
  // process, x/y/w/h fit in 16 bits each and pack into one u64).
  //
  // Rights gate: every op requires R_DP_READ (0x001). target_ptr IS
  // the pipe id (0..2) for op 0, ignored for ops 1-2; masked to its
  // low byte on entry as a defensive bound for a future layout widen.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg.
  // Stack recipe: 3 callee-save pushes (rbx = rights, r12 = pipe,
  //   r13 = op_code).
  // ==========================================================================

  pub let R_DP_READ : u64 = 0x001

  pub let DP_OP_QUERY_ARMED     : u64 = 0
  pub let DP_OP_QUERY_SUBMIT_CT : u64 = 1
  pub let DP_OP_QUERY_COMMIT_CT : u64 = 2

  pub let cap_handler_damage_plane : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 79 G9 (paideia-os#2546) skeleton: KIND_DAMAGE_PLANE (0x4C) cap_invoke dispatch. Entry chatter (klog_s1 of dp_tag_handler_entry). op_code = op_arg & 0xFF; rights gate against R_DP_READ (single up-front check); dispatch 0..2 to the matching reader (damage_plane_armed / damage_plane_submit_ct / damage_plane_commit_ct); else INVOKE_UNSUPPORTED. target_ptr IS the pipe id for op 0, masked to its low byte as a defensive bound. Three callee-save pushes land rsp%16==0 at every nested call. The mutating ops (submit / commit / get_rect -- all take >1 non-rights arg or an out-pointer) are deferred to a follow-up slice that either extends cap_invoke with a 4-register slot variant or packs (bo_cap, x, y, w, h) into target_ptr/op_arg. Labels prefixed dp_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rights
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                       // pipe = target_ptr[7:0]
        mov r13, rdx;                       // op_arg
        and r13, r10;                       // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + dp_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                     // R_DP_READ
        cmp r10, 0;
        je  dp_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  dp_hd_op_armed;
        cmp r13, 1;
        je  dp_hd_op_sub_ct;
        cmp r13, 2;
        je  dp_hd_op_com_ct;
        jmp dp_hd_unsup;

      dp_hd_op_armed:
        mov rdi, r12;
        call damage_plane_armed;
        jmp dp_hd_out;

      dp_hd_op_sub_ct:
        call damage_plane_submit_ct;
        jmp dp_hd_out;

      dp_hd_op_com_ct:
        call damage_plane_commit_ct;
        jmp dp_hd_out;

      dp_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;        // INVOKE_DENIED
        jmp dp_hd_out;
      dp_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;        // INVOKE_UNSUPPORTED

      dp_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  Boot wiring note
  // ----------------
  // kernel_main.pdx does NOT need a dedicated reset entry: .bss zero-
  // init leaves _damage_state empty (all four slots per pipe = 0, so
  // every pipe starts unarmed) and the three counters at zero, which
  // is exactly the never-armed starting state the submit / commit /
  // get_rect paths expect. A follow-up slice may mint a defensive
  // `damage_plane_reset` for parity with the other dpy drivers'
  // reset entries (iris_xe_cursor_reset, direct_scanout_reset-to-be
  // are the local precedents), but the skeleton gets by on .bss alone.
  //
  // invoke.pdx picks up the KIND_DAMAGE_PLANE (0x4C) dispatch arm in
  // the same slice as this file -- the arm is pure plumbing and self-
  // standing (handler returns INVOKE_UNSUPPORTED for every mutating
  // op at skeleton stage, which is observable but harmless).
  //
  // No new klog wrapper is minted; the three fingerprints ride
  // klog_s1_x1_d1 (SUBMIT), klog_s1_d2 (COMMIT), and klog_s1_d5
  // (RECT), all pre-existing in klog/wrappers.pdx.
  //
  // Follow-up slices (G10 and later):
  //   - Real MMIO body for damage_plane_commit (PLANE_SURFLIVE
  //     readback + PLANE_SRC / PLANE_POS / PLANE_SURF writes).
  //   - PIPE_SRCSZ-live gate for damage_plane_submit (R4: rect-out-
  //     of-plane -> DP_ERR_RECT_OUT_PLANE, 0xFFFFFD4B).
  //   - cap_handler extension for the submit / commit / get_rect ops
  //     (packed target_ptr + op_arg for the submit path, or a
  //     4-register cap_invoke slot variant).
  //   - Register-table unification with direct_scanout.pdx §A
  //     (shared Intel bspec constants module).
  // ==========================================================================
}
