// src/kernel/core/drivers/dpy/present_fence.pdx -- Wave 80 G7 (#2547)
//
// Vblank-aligned present-fence delivery SKELETON for Wave 80 G7.
// A client submits a frame + requests "fire a KIND_HW_TIMELINE
// increment on the next vblank"; the compositor armed the plane flip
// before the vblank, the display engine completes the flip at vblank,
// and the host fires the paired KIND_NOTIFICATION to wake the waiting
// client with its presented frame's timestamp. This is the "present
// fence" primitive underlying Wayland `wp_presentation` + Metal's
// `MTLDrawable.presentedTime`.
//
// This file sits beside direct_scanout.pdx (Wave 78 G8, #2545) which
// handed the pipe PLANE_SURF directly from a client BO, and damage_
// plane.pdx (Wave 79 G9, #2546) which scheduled the per-pipe scissor
// so the display engine's DRAM read is restricted to the dirty
// subregion. The present-fence primitive composes above both: a
// direct-scanout plane with a damage rect + an armed present-fence
// gives the client a cycle-accurate "when was my frame on glass"
// callback for 60 Hz / 90 Hz / 120 Hz adaptive-sync panels.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// Posture: EVERY body here is a STUB per the Wave 80 G7 skeleton
// directive. The MMIO register map, the per-pipe fence queue, the
// error taxonomy, the fence-token encoding, and the fingerprint shape
// are FROZEN at this skeleton stage so a follow-up slice can land the
// real ISR + KIND_HW_TIMELINE increment path against the same ABI
// without churn. The static per-pipe fence queue, the fingerprint
// tags, and the counter bumps are real; no live MMIO is read or
// written yet (QEMU: no Iris Xe BAR0; T14 G4: BAR0 is wired by
// R104.M1-003 but consumed only by iris_xe_modeset today).
//
// On the Wave 80 G7 skeleton, every entrypoint:
//   (1) range-checks pipe in {0,1,2} (or decodes it from the fence
//       token for the poll path) and refuses with PF_ERR_BAD_PIPE
//       (0xFFFFFD5D) on an out-of-range pipe;
//   (2) validates its inputs (timeline_cap != 0 for arm; token
//       decodes to a valid (pipe, slot) for poll; ISR body is a
//       no-op refuse on bad pipe without touching the fence queue);
//   (3) records (or walks) the per-pipe fence queue block;
//   (4) bumps the per-op counter so an operator can see the entry
//       on a boot-witness programme;
//   (5) emits a fingerprint so arm / fired / poll events show up on
//       the klog wire.
//
// =============================================================================
// SECTION 1  REGISTER MAP (Intel Iris Xe / Alder-Lake / Raptor-Lake)
// =============================================================================
//
// Source: Intel bspec "Register Reference -> Display Registers -> ADL
// -> DE Pipe Interrupt Registers". Per-pipe interrupt registers sit
// at a 0x1000 pipe stride (A at 0x44400, B at 0x44410, C at 0x44420
// base per DE_PIPE_INTR table). The two frame counters sit in the
// per-pipe plane register band (A at 0x70000, B at 0x71000, C at
// 0x72000). For the present-fence path, the real body in the
// follow-up slice touches:
//
//   PIPE_FRMCOUNT_A    +0x70040  -- increments each vblank; the real
//                                   body reads this to timestamp
//                                   fired fences with the vblank
//                                   counter rather than TSC (TSC
//                                   drifts across sleep states;
//                                   FRMCOUNT is monotonic across
//                                   screen-off / PSR entry).
//   PIPE_FLIPCOUNT_A   +0x70044  -- increments each surface-flip
//                                   completion; the real body
//                                   consults it to distinguish
//                                   "vblank fired but no flip
//                                   completed" (compositor missed
//                                   the deadline; fence waits a
//                                   second vblank) from a real
//                                   flip-complete vblank.
//   DE_PIPE_INTR_IIR_A +0x44400  -- vblank bit 0, vsync bit 1;
//                                   written to clear (RW1C).
//   DE_PIPE_INTR_IER_A +0x44408  -- vblank enable; set at pipe
//                                   enable time, cleared at pipe
//                                   disable time (G4 hotplug infra).
//
// Resolving for all three pipes (0x1000 pipe stride):
//   PIPE_FRMCOUNT_A/B/C      = 0x70040 / 0x71040 / 0x72040
//   PIPE_FLIPCOUNT_A/B/C     = 0x70044 / 0x71044 / 0x72044
//   DE_PIPE_INTR_IIR_A/B/C   = 0x44400 / 0x44410 / 0x44420
//   DE_PIPE_INTR_IER_A/B/C   = 0x44408 / 0x44418 / 0x44428
//
// Note that the DE_PIPE_INTR_* band uses a 0x10 (16-byte) stride per
// pipe, not the 0x1000 plane-band stride. The real body in the
// follow-up slice uses two different pipe-indexing helpers for the
// two bands; this skeleton emits no MMIO so the asymmetry is
// documentation only.
//
// All accesses are 32-bit per Intel bspec §14. The real body uses
// mov_d (G1 sized store) for every DE_PIPE_INTR_IIR / IER write;
// the FRMCOUNT / FLIPCOUNT reads are 32-bit MOVs with REX.W cleared
// (one more mov_d placement for the follow-up). This skeleton emits
// none of them.
//
// =============================================================================
// SECTION 2  PRESENT-FENCE SEQUENCE (real body sketch)
// =============================================================================
//
// Per Wayland wp_presentation + Metal MTLDrawable.presentedTime:
//
//   t0: client renders into its BO; damage_plane_submit records the
//       dirty rect; direct_scanout_arm (or compositor-side blit)
//       hands the pipe PLANE_SURF.
//   t1: client calls present_fence_arm(pipe, timeline_cap, client_
//       token). Skeleton: look up a free fence slot in the pipe's
//       16-entry fence queue, record (timeline_cap, client_token,
//       state=ARMED, ts=0), return fence_token = (pipe<<16 | slot).
//       Real body: additionally pin timeline_cap in the generation
//       table so the slot's KIND_HW_TIMELINE row stays alive even
//       if the client's reference drops before the vblank fires.
//   t2: compositor arms the plane flip for the next vblank
//       (iris_xe_page_flip or damage_plane_commit).
//   t3: display engine latches the new PLANE_SURF at next vblank.
//   t4: DE pipe interrupt fires (DE_PIPE_INTR_IIR bit 0 = vblank);
//       the G4 hotplug ISR dispatches to present_fence_vblank_isr
//       (which this file provides). The ISR body:
//         (a) reads PIPE_FRMCOUNT[pipe] + PIPE_FLIPCOUNT[pipe];
//             if FLIPCOUNT did not advance, treat as a "vblank
//             without flip" (compositor missed the deadline) and
//             leave the fence slots armed for the next vblank.
//         (b) if FLIPCOUNT advanced, walk the pipe's fence queue:
//               for each slot with state == ARMED:
//                 - call cap_timeline_signal(timeline_cap, ts) to
//                   advance the KIND_HW_TIMELINE row to a
//                   monotonically-non-decreasing value;
//                 - record the vblank frame counter into the slot's
//                   ts field;
//                 - transition state ARMED -> FIRED.
//         (c) write RW1C to DE_PIPE_INTR_IIR to clear the vblank
//             bit (per Intel bspec).
//   t5: client calls present_fence_poll(fence_token, out_ts_ptr).
//       Skeleton: decode (pipe, slot) from fence_token, look up the
//       slot, if state == FIRED write ts to *out_ts_ptr and return
//       1; if state == ARMED return 0; if slot free / mismatched
//       return PF_ERR_BAD_TOKEN. After a successful poll of a FIRED
//       slot the state is cleared to FREE so the slot is reusable.
//
// The skeleton stops at the per-pipe fence-queue state transitions +
// counter bumps + fingerprints + a cap_timeline_signal call per fired
// slot (the KIND_HW_TIMELINE primitive currently returns INVOKE_
// UNSUPPORTED at skeleton stage per cap/kind_hw_timeline.pdx L295-306;
// the call links cleanly and no-ops at runtime, which is the right
// skeleton semantic -- the signal becomes real once that file's body
// lands). No PIPE_FRMCOUNT / FLIPCOUNT read happens here. The ISR
// entry does its state-walk + state transitions but synthesizes a
// monotonically-increasing timestamp from a module-local counter
// rather than from PIPE_FRMCOUNT. Enables deterministic fingerprint
// fixtures that land before the real MMIO slice.
//
// =============================================================================
// SECTION 3  FENCE QUEUE LAYOUT
// =============================================================================
//
// 3 pipes x 16 slots per pipe x 32 bytes per slot = 1536 B = 192 u64.
// Per-pipe stride: 16 * 32 = 512 B. Per-slot row layout:
//
//     +0   timeline_cap   -- the KIND_HW_TIMELINE row id the ISR
//                            will signal on vblank (0 on a free slot).
//                            The ISR invokes cap_timeline_signal(
//                            timeline_cap, ts) which SETS the row's
//                            counter to the vblank ts (monotonically
//                            non-decreasing semantic matches the
//                            KIND_HW_TIMELINE signal contract).
//     +8   client_token   -- opaque userspace handle; carried in
//                            the FIRED fingerprint so an operator
//                            can trace which client's frame got
//                            presented
//     +16  fired_flag     -- 0 = FREE, 1 = ARMED, 2 = FIRED (see §C
//                            below for the state-machine)
//     +24  timestamp      -- synthesized monotonic tick at skeleton
//                            stage; PIPE_FRMCOUNT snapshot in the
//                            real body
//
// Fence-token encoding returned by present_fence_arm (and consumed
// by present_fence_poll):
//
//     fence_token = (pipe << 16) | slot
//
// 16-bit pipe field + 16-bit slot field. pipe is in {0, 1, 2};
// slot is in {0..15}. A fence_token of 0 is reserved for "invalid"
// so a caller zero-initializing a fence handle sees a benign BAD_
// TOKEN rather than an unintended match on slot 0 of pipe 0 (the
// skeleton's arm path returns a nonzero sentinel in that case; see
// §G body).
//
// State machine for the fired_flag field:
//
//     FREE (0)  --[arm]-->  ARMED (1)  --[isr+flip]-->  FIRED (2)
//                                                        |
//                                                        | poll
//                                                        v
//                                                       FREE (0)
//
// A slot in ARMED can be re-armed only by poll-and-free; a second
// arm on the same (pipe, slot) is admitted by picking a different
// free slot (open-addressed, first-free in-row search). An ISR body
// that walks an all-FREE pipe is a no-op (count the vblank, no
// fingerprint). A poll on an ARMED slot returns 0 (pending) without
// freeing. A poll on a FREE slot (or a slot whose timeline_cap does
// not match the token encoding by pipe<<16|slot indexing) returns
// PF_ERR_BAD_TOKEN.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFFD5D..0xFFFFFD6D
// =============================================================================
//
// Five codes reserved for this module.  The adjacent bands:
//
//   0xFFFFFD44..0xFFFFFD48 -- drivers/acpi/ec_discovery.pdx (Wave 78 I6)
//   0xFFFFFD49..0xFFFFFD4D -- drivers/dpy/damage_plane.pdx (Wave 79 G9)
//   0xFFFFFD50..0xFFFFFD51 -- driver/registry_snapshot.pdx
//   0xFFFFFD53..0xFFFFFD57 -- drivers/tpm/tpm_crb.pdx (Wave 79 I9)
//   0xFFFFFD58..0xFFFFFD5C -- drivers/dpy/sdf_atlas.pdx (Wave 79 G11)
//
// The sub-page 0xFFFFFD5D..0xFFFFFD6D is contiguous with sdf_atlas
// and (per the task directive) free at landing time.  Values:
//
//     0xFFFFFD5D  PF_ERR_BAD_PIPE          -- pipe not in {0, 1, 2}
//     0xFFFFFD5E  PF_ERR_QUEUE_FULL        -- all 16 slots of the
//                                             pipe's fence queue are
//                                             armed (compositor is
//                                             >= 16 frames behind;
//                                             the oldest slots are
//                                             picked up by the next
//                                             vblank ISR but no new
//                                             arm can land until
//                                             one of them polls out)
//     0xFFFFFD5F  PF_ERR_BAD_TOKEN         -- fence_token decodes to
//                                             an out-of-range pipe
//                                             or slot, OR the slot
//                                             is FREE (and so does
//                                             not correspond to any
//                                             outstanding arm)
//     0xFFFFFD6C  PF_ERR_BAD_TL_CAP        -- timeline_cap == 0 on
//                                             the arm path; a 0 cap
//                                             cannot be
//                                             cap_timeline_signal-
//                                             ed, so there is
//                                             nothing for the ISR
//                                             to tick
//     0xFFFFFD6D  PF_ERR_PIPE_NOT_ARMED    -- reserved for the
//                                             follow-up slice that
//                                             consults the G4
//                                             hotplug infra's
//                                             per-pipe "pipe is
//                                             enabled" state; a
//                                             fence arm on a pipe
//                                             whose vblank
//                                             interrupt line is
//                                             disabled would never
//                                             fire. The skeleton
//                                             assumes every pipe
//                                             is armed by default
//                                             and never emits this
//                                             code; the real body
//                                             gates on it.
//
// The arm / poll entrypoints return these codes directly in rax.
// The vblank ISR is best-effort: it refuses only on PF_ERR_BAD_PIPE
// (and returns the error in rax); every other error path is a
// counter-bumped no-op because an ISR cannot propagate an error to
// a userspace caller.
//
// =============================================================================
// SECTION 5  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized stores): the real body's DE_PIPE_INTR_IIR writes use
//      mov_d (32-bit sized store, bspec says RW1C). The FRMCOUNT /
//      FLIPCOUNT reads are 32-bit MOV. The fence queue slots are u64
//      so plain REX.W `mov` is correct for the per-slot state block.
//      This skeleton emits no MMIO.
//   G4 (full-register compares): every cmp here is on a 64-bit
//      register; no `cmp al, imm`, no `cmp eax, imm` short-form.
//   No `test rN, rN` -- equality-against-zero is `cmp rN, 0`.
//   No `and rN, imm64` -- the fence-token masks (0xFFFF for pipe
//      field extraction after `shr r, 16`, 0xFFFF for slot
//      extraction) fit imm16/imm8 and need no r11 staging.
//   No two-operand `imul r, imm` -- the per-slot row stride is 32
//      (`shl r, 5`); the per-pipe stride is 512 (`shl r, 9`); the
//      slot_idx * 32 + pipe * 512 fold is two shifts + one add.
//   64-bit immediates -- the return-code constants (0xFFFFFD5D..61)
//      fit imm32 with bit 31 set, so the pdx encoder emits them via
//      the full REX.W `mov r64, imm64` form; proven form across
//      ec_discovery.pdx / damage_plane.pdx / sdf_atlas.pdx.
//   Multiline `pub let ="..."` is forbidden by the pdx parser; every
//      tag below is a single line.
//   Module basename matches filename basename:
//      present_fence.pdx -> module PresentFence.
//   Reserved labels -- every label in this file is prefixed `pf_`
//      so none collides with the dp_/ds_/ixc_/ixm_/plpr_ labels of
//      the sibling dpy drivers, and none accidentally spells `loop`,
//      `if`, or `let`.
//   klog wrapper discipline -- the three fingerprints each ride the
//      proven `klog_s1_x1_d1` wrapper (hex + decimal) and the
//      proven `klog_s1_d1` wrapper (decimal only). The task directive
//      proposed a 3-value fingerprint shape (pipe=<dec>
//      tl_cap=0x<hex> token=0x<hex>) that would need a new
//      klog_s1_d1_x2 wrapper mint; the skeleton takes the damage_
//      plane precedent of reusing existing wrappers to avoid
//      gratuitous klog churn and emits a 2-value shape with the
//      most operator-useful fields (tl_cap / token on arm, token /
//      ts on fired, token / fired-flag on poll). A follow-up slice
//      can mint klog_s1_d1_x2 and widen the shape; the frozen
//      state-machine and ABI do not change.
//      Caller recipe for klog_s1_x1_d1: `sub rsp, 16; mov [rsp+0],
//      vd; CALL; add rsp, 16`. Writing vd to [rsp+8] is the trap
//      called out in the Wave 80 G7 task directive (which has
//      burned 5+ softarchs this session).
//   Fingerprint tag `[u8; N]` length is `strlen(string) + 1` (NUL
//      terminator); a tag_len off-by-one is a build-time error.
//
// =============================================================================
// SECTION 6  STACK + REGISTER PLAN
// =============================================================================
//
// Four @abi entrypoints (plus the cap handler + the leaf getters):
//
//   present_fence_arm         (pipe, timeline_cap, client_token) -> u64
//   present_fence_vblank_isr  (pipe)                             -> u64
//   present_fence_poll        (fence_token, out_timestamp_ptr)   -> u64
//   cap_handler_present_fence (rights, target_ptr, op_arg)       -> u64
//
// All four are non-leaf (nested calls into klog_* / sibling getters).
// All four use the damage_plane.pdx 3-/5-push callee-save prologue:
//
//   push rbx; push r12; push r13;              // 3-push, 24 B
//   -- entry rsp%16 == 8; after 3 pushes rsp%16 == 0 (pre-CALL)
//
//   push rbx; push r12; push r13; push r14; push r15;  // 5-push, 40 B
//   -- entry rsp%16 == 8; after 5 pushes rsp%16 == 0 (pre-CALL)
//
// present_fence_arm uses 5 pushes (rbx = pipe, r12 = timeline_cap,
// r13 = client_token, r14 = slot_idx (free slot), r15 = row base).
// Then `sub rsp, 16; mov [rsp+0], r12` stages vd=tl_cap for the
// klog_s1_x1_d1 call (ARM fingerprint: `PRESENT_FENCE ARM
// tl_cap=0x<hex> pipe=<dec>`). `add rsp, 16` reclaims.
//
// present_fence_vblank_isr uses 5 pushes (rbx = pipe, r12 = pipe row
// base, r13 = per-slot cursor, r14 = armed_count (slots transitioned
// this ISR), r15 = synthesized ts snapshot). The per-slot loop walks
// 16 slots; each FIRED-transition slot emits one klog_s1_x1_d1
// fingerprint (`PRESENT_FENCE FIRED token=0x<hex> pipe=<dec>`).
//
// present_fence_poll uses 3 pushes (rbx = fence_token, r12 = out_ts
// _ptr, r13 = row base). klog_s1_x1_d1 fingerprint:
// `PRESENT_FENCE POLL token=0x<hex> fired=<dec>`.
//
// cap_handler_present_fence uses 3 pushes (rbx = rights, r12 =
// target_ptr, r13 = op_code).
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file compiles
// alongside the kernel because tools/build.sh recurses through
// src/kernel/core/drivers/dpy/ with a single `find`, so a new .pdx in
// that directory is picked up automatically; no build.sh edit required.
//
// invoke.pdx (`src/kernel/core/cap/invoke.pdx`) gets ONE new
// dispatch arm (0x4F -> cap_handler_present_fence) to be landed in
// a sibling slice (not touched by this skeleton to avoid the
// parallel-wave conflict pattern Wave 79's three softarchs hit when
// all three tried to edit invoke.pdx in the same batch). Slot 0x4F
// is free: `grep -nE 'cmp rcx, 0x4F' src/kernel/core/cap/invoke.pdx`
// returns ONLY three hits -- all inside comments at L523/L545/L547
// documenting 0x4F as unassigned -- and NO actual dispatch arm
// exists. Adjacent arms: 0x4A (direct_scanout, L428), 0x4B (ec_
// discovery, L448), 0x4C (damage_plane, L471), 0x4D (sdf_atlas,
// L489), 0x4E (tpm_crb, L508), 0x50 (osc, L533), 0x51 (ec_quirks,
// L554).
//
// No new klog wrapper is minted at skeleton stage. The three
// fingerprints all ride klog_s1_x1_d1, which is proven across the
// Wave 59-79 drivers (direct_scanout_arm, damage_plane_submit, etc.).
// A follow-up slice may mint klog_s1_d1_x2 / klog_s1_d2_x1 to widen
// the fingerprint shapes without changing the ABI.
//
// No caller invokes present_fence_* yet. The G4 hotplug ISR hands
// the vblank interrupt to present_fence_vblank_isr once a follow-up
// slice wires the IDT entry. A follow-up slice also adds a boot-
// witness programme at tests/kernel/drivers/wit_present_fence.pdx
// that:
//   (1) present_fence_arm(0, tl_cap, client_token) -> fence_token;
//   (2) present_fence_vblank_isr(0) -> PF_OK (fires the arm);
//   (3) present_fence_poll(fence_token, &out_ts) -> 1, out_ts != 0;
//   (4) present_fence_poll(fence_token, &out_ts) -> PF_ERR_BAD_TOKEN
//       (idempotency: fired-and-polled slots are freed);
// and asserts the ARM / FIRED / POLL fingerprints land on the klog
// wire.

module PresentFence = structure {

  // ==========================================================================
  // §A  Register offsets -- PIPE_FRMCOUNT / PIPE_FLIPCOUNT /
  //                        DE_PIPE_INTR_IIR / DE_PIPE_INTR_IER
  // ==========================================================================
  //
  // Per Intel bspec "Register Reference -> Display Registers -> ADL"
  // (Alder Lake / Raptor Lake). Plane-band pipe stride is 0x1000; the
  // DE_PIPE_INTR_* band uses a 0x10 stride per pipe.

  pub let PF_PIPE_FRMCOUNT_A     : u64 = 0x70040
  pub let PF_PIPE_FRMCOUNT_B     : u64 = 0x71040
  pub let PF_PIPE_FRMCOUNT_C     : u64 = 0x72040

  pub let PF_PIPE_FLIPCOUNT_A    : u64 = 0x70044
  pub let PF_PIPE_FLIPCOUNT_B    : u64 = 0x71044
  pub let PF_PIPE_FLIPCOUNT_C    : u64 = 0x72044

  pub let PF_DE_PIPE_INTR_IIR_A  : u64 = 0x44400
  pub let PF_DE_PIPE_INTR_IIR_B  : u64 = 0x44410
  pub let PF_DE_PIPE_INTR_IIR_C  : u64 = 0x44420

  pub let PF_DE_PIPE_INTR_IER_A  : u64 = 0x44408
  pub let PF_DE_PIPE_INTR_IER_B  : u64 = 0x44418
  pub let PF_DE_PIPE_INTR_IER_C  : u64 = 0x44428

  pub let PF_PIPE_STRIDE_MMIO    : u64 = 0x1000
  pub let PF_PIPE_STRIDE_INTR    : u64 = 0x10

  // DE pipe interrupt bits (shared across pipes).
  pub let PF_DE_INTR_VBLANK_BIT  : u64 = 0x1
  pub let PF_DE_INTR_VSYNC_BIT   : u64 = 0x2

  // Pipe identifiers. Public so a caller can read-aloud the pipe
  // argument rather than hard-code 0/1/2 at the call site.
  pub let PF_PIPE_A              : u64 = 0
  pub let PF_PIPE_B              : u64 = 1
  pub let PF_PIPE_C              : u64 = 2
  pub let PF_PIPE_COUNT          : u64 = 3

  // ==========================================================================
  // §B  Fence queue geometry
  //
  // 3 pipes x 16 slots per pipe x 32 bytes per slot = 1536 B = 192 u64.
  // Per-pipe stride: 512 B (= `shl r, 9`). Per-slot stride: 32 B (= `shl r, 5`).
  // ==========================================================================

  pub let PF_SLOTS_PER_PIPE      : u64 = 16
  pub let PF_ROW_BYTES           : u64 = 32
  pub let PF_PIPE_STRIDE_B       : u64 = 512
  pub let PF_QUEUE_BYTES         : u64 = 1536

  // Byte offsets within a slot (u64 fields).
  pub let PF_ROW_OFF_TL_CAP      : u64 = 0
  pub let PF_ROW_OFF_CLIENT_TOK  : u64 = 8
  pub let PF_ROW_OFF_FIRED_FLAG  : u64 = 16
  pub let PF_ROW_OFF_TIMESTAMP   : u64 = 24

  // fired_flag states.
  pub let PF_STATE_FREE          : u64 = 0
  pub let PF_STATE_ARMED         : u64 = 1
  pub let PF_STATE_FIRED         : u64 = 2

  // Fence-token encoding masks.
  pub let PF_TOKEN_PIPE_SHIFT    : u64 = 16
  pub let PF_TOKEN_SLOT_MASK     : u64 = 0xFFFF

  // ==========================================================================
  // §C  Failure taxonomy -- band 0xFFFFFD5D..0xFFFFFD6D
  //
  // See §4 of the file header for the band provenance (natural
  // neighbour of sdf_atlas.pdx's FD58..FD5C).
  // ==========================================================================

  pub let PF_OK                       : u64 = 0
  pub let PF_ERR_BAD_PIPE             : u64 = 0xFFFFFD5D
  pub let PF_ERR_QUEUE_FULL           : u64 = 0xFFFFFD5E
  pub let PF_ERR_BAD_TOKEN            : u64 = 0xFFFFFD5F
  pub let PF_ERR_BAD_TL_CAP           : u64 = 0xFFFFFD6C
  pub let PF_ERR_PIPE_NOT_ARMED       : u64 = 0xFFFFFD6D

  // ==========================================================================
  // §D  Per-pipe fence queue
  //
  // 192 u64 total = 1536 B.  Zero-init in .bss leaves every slot FREE
  // (fired_flag == 0), timeline_cap == 0, client_token == 0,
  // timestamp == 0; which is exactly the never-armed starting state
  // the arm / isr / poll paths expect.
  // ==========================================================================

  pub let mut _pf_fence_queue : [u64; 192] = uninit @align(64)

  // Synthesized vblank timestamp counter (one u64 across all pipes).
  // Incremented by every present_fence_vblank_isr call that transitions
  // at least one fence slot ARMED -> FIRED. The real body in the
  // follow-up slice reads PIPE_FRMCOUNT instead; the skeleton's
  // monotonic counter is deterministic for fingerprint fixtures.
  pub let mut _pf_mono_ts    : u64 = 0

  // Per-op stats (bumped once per entry on successful + ISR paths).
  // Visible via the getter trio in §K.
  pub let mut _pf_arm_ct     : u64 = 0
  pub let mut _pf_isr_ct     : u64 = 0
  pub let mut _pf_fired_ct   : u64 = 0
  pub let mut _pf_poll_ct    : u64 = 0

  // ==========================================================================
  // §E  Fingerprint tags + keys
  //
  // Three tags, one per @abi entrypoint. Each is a single-line string
  // literal (the multiline `pub let ="..."` form is forbidden by the
  // pdx parser). Tag length is `strlen + 1` (NUL terminator) so a
  // tag_len off-by-one is a build-time error.
  //
  // Fingerprints on the wire (klog_s1_x1_d1-shaped, see §5 header for
  // the klog mint deferment note):
  //   PRESENT_FENCE ARM tl_cap=0x<hex> pipe=<dec>
  //   PRESENT_FENCE FIRED token=0x<hex> pipe=<dec>
  //   PRESENT_FENCE POLL token=0x<hex> fired=<dec>
  //
  // Matches tests/fingerprints/present_fence.golden pattern.
  // ==========================================================================

  pub let pf_tag_arm   : [u8; 18] = "PRESENT_FENCE ARM\0"
  pub let pf_tag_fired : [u8; 20] = "PRESENT_FENCE FIRED\0"
  pub let pf_tag_poll  : [u8; 19] = "PRESENT_FENCE POLL\0"

  pub let pf_k_pipe    : [u8; 5] = "pipe\0"
  pub let pf_k_tl_cap  : [u8; 7] = "tl_cap\0"
  pub let pf_k_token   : [u8; 6] = "token\0"
  pub let pf_k_ts      : [u8; 3] = "ts\0"
  pub let pf_k_fired   : [u8; 6] = "fired\0"

  // Handler-entry chatter tag (for the cap-handler path).
  pub let pf_tag_handler_entry : [u8; 28] = "PRESENT_FENCE handler entry\0"

  // ==========================================================================
  // §F  present_fence_arm(pipe, timeline_cap, client_token) -> u64
  //
  // Register a fence to fire on the next vblank for `pipe`. Returns
  // the fence_token = (pipe << 16) | slot on admission, else one of
  // the PF_ERR_* sentinels (0xFFFFFD5D..60) on the first failing rule.
  //
  // Gates in order:
  //   (R1) pipe > 2                   -> PF_ERR_BAD_PIPE
  //   (R2) timeline_cap == 0          -> PF_ERR_BAD_TL_CAP
  //   (R3) all 16 pipe slots armed    -> PF_ERR_QUEUE_FULL
  //   (R4) [DEFERRED] pipe vblank
  //        interrupt line disabled    -> PF_ERR_PIPE_NOT_ARMED
  //
  // (R4) is reserved for the follow-up slice that consults the G4
  // hotplug infra's per-pipe "pipe is enabled" state (reads
  // DE_PIPE_INTR_IER[pipe] & VBLANK_BIT). The skeleton assumes every
  // pipe is armed by default.
  //
  // On admission the body:
  //   (a) finds first slot in {0..15} with fired_flag == FREE;
  //   (b) writes timeline_cap to _pf_fence_queue[row + 0];
  //   (c) writes client_token to +8;
  //   (d) writes PF_STATE_ARMED (1) to +16;
  //   (e) leaves +24 (timestamp) at zero (set by ISR on fire);
  //   (f) bumps _pf_arm_ct;
  //   (g) emits `PRESENT_FENCE ARM tl_cap=0x<hex> pipe=<dec>` via
  //       klog_s1_x1_d1;
  //   (h) returns fence_token = (pipe << 16) | slot_idx.
  //
  // No fingerprint is emitted on the gate-failing paths -- the error
  // code in rax is the only observable, same posture as damage_plane_
  // submit's bad-pipe / bad-bo / bad-dims paths.
  //
  // SysV: rdi = pipe, rsi = timeline_cap, rdx = client_token.
  // Stack recipe: 5 callee-save pushes (rbx = pipe, r12 = timeline_cap,
  //   r13 = client_token, r14 = slot_idx, r15 = row base).
  // ==========================================================================

  pub let present_fence_arm : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64, timeline_cap: u64, client_token: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 80 G7 (paideia-os#2547) skeleton: validation gate chain over (pipe, timeline_cap, client_token). Rules in order: (R1) pipe > 2 -> PF_ERR_BAD_PIPE (0xFFFFFD5D); (R2) timeline_cap == 0 -> PF_ERR_BAD_TL_CAP (0xFFFFFD6C); (R3) all 16 slots armed -> PF_ERR_QUEUE_FULL (0xFFFFFD5E). (R4) pipe-not-armed via DE_PIPE_INTR_IER readback is reserved for the follow-up MMIO slice and emits 0xFFFFFD6D. Admission records (timeline_cap, client_token, PF_STATE_ARMED, ts=0) at _pf_fence_queue[(pipe * 512) + (slot_idx * 32)] + bumps _pf_arm_ct + emits ARM fingerprint via klog_s1_x1_d1. Register plan: rbx = pipe (saved), r12 = timeline_cap (saved for fingerprint hex field), r13 = client_token (saved for row write), r14 = slot_idx (scan output + fence_token composition), r15 = row base (saved for the 4 slot writes). Five callee-save pushes land rsp%16==0 at every nested call (entry %16==8, +40 -> 48, %16==0; the firmware_blob five-push discipline). klog_s1_x1_d1 caller contract: `sub rsp, 16; mov [rsp+0], rbx` writes vd=pipe to caller [rsp+0] -- which the wrapper reads at [rbp+16] after its own `push rbp`. Writing vd at [rsp+8] would land it at [rbp+24] inside the wrapper and the real pipe value never reaches the fingerprint (the klog_s1_x1_d1 caller trap called out in the Wave 80 G7 task directive, which has burned 5+ softarchs this session). `add rsp, 16` reclaims pad + vd slot. The 16-slot scan loop uses `cmp` / `je pf_arm_use_slot` / `inc r14` / `jmp pf_arm_scan` with no imm64 (slot bound 16 fits imm8). Labels prefixed pf_arm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = pipe (saved)
        mov r12, rsi;                       // r12 = timeline_cap (saved)
        mov r13, rdx;                       // r13 = client_token (saved)

        // --- Gate (R1): pipe in {0, 1, 2}.
        cmp rbx, 2;
        ja  pf_arm_bad_pipe;

        // --- Gate (R2): timeline_cap != 0.
        cmp r12, 0;
        je  pf_arm_bad_tl_cap;

        // --- Compute pipe row base: &_pf_fence_queue + pipe * 512.
        lea r15, [rip + _pf_fence_queue];
        mov rax, rbx;
        shl rax, 9;                         // pipe * 512
        add r15, rax;                       // r15 = &pipe_row[0]

        // --- Scan slots {0..15} for first fired_flag == FREE.
        xor r14, r14;                       // r14 = slot_idx
      pf_arm_scan:
        cmp r14, 16;
        jae pf_arm_queue_full;
        // row = r15 + r14 * 32.
        mov rax, r14;
        shl rax, 5;                         // slot_idx * 32
        mov rcx, r15;
        add rcx, rax;                       // rcx = &slot
        mov rax, [rcx + 16];                // fired_flag slot
        cmp rax, 0;                         // PF_STATE_FREE
        je  pf_arm_use_slot;
        inc r14;
        jmp pf_arm_scan;

      pf_arm_use_slot:
        // rcx holds &slot. Record state.
        mov [rcx + 0],  r12;                // timeline_cap
        mov [rcx + 8],  r13;                // client_token
        mov rax, 1;                         // PF_STATE_ARMED
        mov [rcx + 16], rax;                // fired_flag
        xor rax, rax;
        mov [rcx + 24], rax;                // timestamp = 0 (set by ISR)

        // --- Count the arm (bump BEFORE fingerprint so a crash
        //     mid-fingerprint still records the entry).
        mov rax, [rip + _pf_arm_ct];
        add rax, 1;
        mov [rip + _pf_arm_ct], rax;

        // --- klog_s1_x1_d1(level=3, SUBSYS_DRV_, pf_tag_arm,
        //                   pf_k_tl_cap, timeline_cap,
        //                   pf_k_pipe, [vd=pipe])
        //
        // After 5 callee-save pushes rsp%16==0.  Idiom is `sub rsp,
        // 16; mov [rsp+0], val` -- 16 bytes reserves the vd slot AND
        // keeps alignment; wrapper reads vd at [rbp+16] after its own
        // `push rbp`, which is exactly what caller [rsp+0] + CALL
        // (-8) + push rbp (-8) resolves to.
        sub rsp, 16;
        mov [rsp + 0], rbx;                 // vd = pipe (caller [rsp+0])
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pf_tag_arm];
        lea rcx, [rip + pf_k_tl_cap];
        mov r8, r12;                        // v1 = timeline_cap (hex)
        lea r9, [rip + pf_k_pipe];
        call klog_s1_x1_d1;
        add rsp, 16;                        // reclaim pad + vd slot

        // --- Return fence_token = (pipe << 16) | slot_idx.
        mov rax, rbx;
        shl rax, 16;
        or  rax, r14;
        jmp pf_arm_out;

      pf_arm_bad_pipe:
        mov rax, 0xFFFFFD5D;                // PF_ERR_BAD_PIPE
        jmp pf_arm_out;
      pf_arm_bad_tl_cap:
        mov rax, 0xFFFFFD6C;                // PF_ERR_BAD_TL_CAP
        jmp pf_arm_out;
      pf_arm_queue_full:
        mov rax, 0xFFFFFD5E;                // PF_ERR_QUEUE_FULL

      pf_arm_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §G  present_fence_vblank_isr(pipe) -> u64
  //
  // ISR body called from the G4 hotplug infra on vblank interrupt for
  // `pipe`. Walks the pipe's 16-slot fence queue; for each slot in
  // state ARMED, transitions to FIRED, writes the synthesized ts into
  // the slot's timestamp field, calls kind_hw_timeline_increment on
  // the slot's timeline_cap, and emits a FIRED fingerprint. Returns
  // PF_OK on normal completion (even if zero slots fired), or
  // PF_ERR_BAD_PIPE on out-of-range pipe.
  //
  // The real body in the follow-up slice:
  //   (a) reads PIPE_FRMCOUNT[pipe] + PIPE_FLIPCOUNT[pipe]; if
  //       FLIPCOUNT did not advance since the last ISR invocation,
  //       returns PF_OK without transitioning fences (compositor
  //       missed the deadline).
  //   (b) RW1C-writes DE_PIPE_INTR_IIR to clear the vblank bit per
  //       Intel bspec.
  //   (c) threads PIPE_FRMCOUNT into the slot's timestamp field
  //       rather than the synthesized counter.
  //
  // The skeleton synthesizes the timestamp from the module-local
  // _pf_mono_ts counter and emits no MMIO.
  //
  // Gates:
  //   (R1) pipe > 2            -> PF_ERR_BAD_PIPE
  //
  // SysV: rdi = pipe.
  // Stack recipe: 5 callee-save pushes (rbx = pipe, r12 = pipe row
  //   base, r13 = per-slot cursor index, r14 = synthesized ts
  //   snapshot, r15 = slot row base inside the loop).
  // ==========================================================================

  pub let present_fence_vblank_isr : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 80 G7 (paideia-os#2547) skeleton: walk the pipe's 16-slot fence queue; transition every ARMED slot to FIRED + stash synthesized ts (from _pf_mono_ts); call cap_timeline_signal(timeline_cap, ts) on each fired slot; emit `PRESENT_FENCE FIRED token=0x<hex> pipe=<dec>` fingerprint per slot fired. Returns PF_OK on normal completion. Gate: pipe > 2 -> PF_ERR_BAD_PIPE (0xFFFFFD5D). The real body (follow-up) reads PIPE_FRMCOUNT + PIPE_FLIPCOUNT to decide whether to fire (compositor-missed-deadline detection), RW1C-clears DE_PIPE_INTR_IIR, and threads PIPE_FRMCOUNT into the slot timestamp. Register plan: rbx = pipe (saved for fingerprint pipe field), r12 = pipe row base (= &_pf_fence_queue + pipe * 512), r13 = slot cursor (0..16), r14 = synthesized ts snapshot (shared across all fired slots in this ISR), r15 = per-slot row base inside the loop. Five callee-save pushes land rsp%16==0 at every nested call. klog_s1_x1_d1 caller contract per slot: `sub rsp, 16; mov [rsp+0], rbx` writes vd=pipe to caller [rsp+0] (which the wrapper reads at [rbp+16] after its own `push rbp`); `add rsp, 16` reclaims pad + vd slot. cap_timeline_signal call: rdi = timeline_cap (loaded from the slot before state transition), rsi = ts (synthesized monotonic counter in r14); stack is already %16==0 (5 pushes); no extra pad needed. The symbol currently returns INVOKE_UNSUPPORTED per cap/kind_hw_timeline.pdx skeleton stage; the call links and no-ops. Labels prefixed pf_isr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = pipe (saved)

        // --- Gate (R1): pipe in {0, 1, 2}.
        cmp rbx, 2;
        ja  pf_isr_bad_pipe;

        // --- Compute pipe row base.
        lea r12, [rip + _pf_fence_queue];
        mov rax, rbx;
        shl rax, 9;                         // pipe * 512
        add r12, rax;

        // --- Bump _pf_mono_ts BEFORE the slot walk so every slot
        //     fired by this ISR invocation shares the same ts
        //     (every slot latched at the same vblank).
        mov rax, [rip + _pf_mono_ts];
        add rax, 1;
        mov [rip + _pf_mono_ts], rax;
        mov r14, rax;                       // r14 = synthesized ts

        // --- Count the ISR entry (bump BEFORE slot walk).
        mov rax, [rip + _pf_isr_ct];
        add rax, 1;
        mov [rip + _pf_isr_ct], rax;

        // --- Walk slots {0..15}.
        xor r13, r13;                       // r13 = slot cursor
      pf_isr_scan:
        cmp r13, 16;
        jae pf_isr_done;
        // row = r12 + r13 * 32.
        mov rax, r13;
        shl rax, 5;                         // slot_idx * 32
        mov r15, r12;
        add r15, rax;                       // r15 = &slot
        // Check fired_flag == ARMED.
        mov rax, [r15 + 16];
        cmp rax, 1;                         // PF_STATE_ARMED
        jne pf_isr_next_slot;

        // --- Transition ARMED -> FIRED. Stash ts.
        mov rax, 2;                         // PF_STATE_FIRED
        mov [r15 + 16], rax;                // fired_flag
        mov [r15 + 24], r14;                // timestamp

        // --- Signal the timeline cap with the synthesized ts.
        //     cap_timeline_signal(cap_slot, value) SETS the row's
        //     counter to `value` with a monotonic-non-decreasing
        //     contract; using r14 (= _pf_mono_ts snapshot for this
        //     ISR invocation) threads a single consistent timeline
        //     tick across every fence slot fired by this vblank.
        //     The symbol currently returns INVOKE_UNSUPPORTED per
        //     cap/kind_hw_timeline.pdx skeleton stage; the call
        //     links at this slice and no-ops at runtime, which is
        //     the right skeleton semantic -- the signal becomes
        //     real once that file's body lands.
        mov rdi, [r15 + 0];                 // rdi = timeline_cap
        mov rsi, r14;                       // rsi = ts snapshot
        call cap_timeline_signal;
        // rax = INVOKE_UNSUPPORTED today; the ISR does not act on
        // the return. The real body in the follow-up slice may log
        // a klog_s1_d1 warning on a failed signal; the skeleton
        // simply counts the fired slot regardless.

        // --- Count the fire.
        mov rax, [rip + _pf_fired_ct];
        add rax, 1;
        mov [rip + _pf_fired_ct], rax;

        // --- klog_s1_x1_d1(level=3, SUBSYS_DRV_, pf_tag_fired,
        //                   pf_k_token, slot_token,
        //                   pf_k_pipe, [vd=pipe])
        //
        // slot_token = (pipe << 16) | slot_idx. Caller recipe `sub
        // rsp, 16; mov [rsp+0], rbx` keeps rsp%16==0 pre-CALL and
        // writes vd=pipe to the slot the klog_s1_x1_d1 wrapper reads
        // at [rbp+16]. Note: we recompute slot_token here from (rbx,
        // r13) rather than preserving it across the increment call;
        // the increment call does not touch r13 (callee-save) but
        // may clobber rax, rdi, rcx, etc.
        mov r8, rbx;                        // temp build slot_token
        shl r8, 16;
        or  r8, r13;                        // r8 = (pipe << 16) | slot
        sub rsp, 16;
        mov [rsp + 0], rbx;                 // vd = pipe
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pf_tag_fired];
        lea rcx, [rip + pf_k_token];
        // r8 already holds slot_token (hex)
        lea r9, [rip + pf_k_pipe];
        call klog_s1_x1_d1;
        add rsp, 16;

      pf_isr_next_slot:
        inc r13;
        jmp pf_isr_scan;

      pf_isr_done:
        xor rax, rax;                       // PF_OK
        jmp pf_isr_out;

      pf_isr_bad_pipe:
        mov rax, 0xFFFFFD5D;                // PF_ERR_BAD_PIPE

      pf_isr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  present_fence_poll(fence_token, out_timestamp_ptr) -> u64
  //
  // Client-side readback. Decode (pipe, slot) from fence_token; look
  // up the slot's fired_flag:
  //   FIRED -> write slot's ts into *out_timestamp_ptr, transition
  //            slot to FREE (so the slot is reusable), return 1.
  //   ARMED -> return 0 (pending; do not touch the slot).
  //   FREE  -> return PF_ERR_BAD_TOKEN (slot not armed; the token
  //            does not correspond to any outstanding arm).
  //
  // Gates:
  //   (R1) token's pipe field > 2        -> PF_ERR_BAD_TOKEN
  //   (R2) token's slot field >= 16      -> PF_ERR_BAD_TOKEN
  //   (R3) out_timestamp_ptr == 0 on
  //        a FIRED slot                  -> PF_ERR_BAD_TOKEN
  //   (R4) slot's fired_flag == FREE     -> PF_ERR_BAD_TOKEN
  //
  // Fingerprint: `PRESENT_FENCE POLL token=0x<hex> fired=<dec>` via
  // klog_s1_x1_d1, where fired = 1 (FIRED path) or 0 (ARMED path).
  // Error paths emit no fingerprint; the error in rax is the
  // observable.
  //
  // SysV: rdi = fence_token, rsi = out_timestamp_ptr.
  // Stack recipe: 3 callee-save pushes (rbx = fence_token, r12 =
  //   out_timestamp_ptr, r13 = slot row base).
  // ==========================================================================

  pub let present_fence_poll : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (fence_token: u64, out_timestamp_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 80 G7 (paideia-os#2547) skeleton: decode fence_token = (pipe << 16) | slot; range-check pipe/slot (-> PF_ERR_BAD_TOKEN on out-of-range); look up slot's fired_flag; on FIRED, write slot's timestamp into *out_timestamp_ptr (if non-null), zero the slot (back to FREE for reuse), return 1; on ARMED, return 0; on FREE, return PF_ERR_BAD_TOKEN (0xFFFFFD5F). Emits `PRESENT_FENCE POLL token=0x<hex> fired=<dec>` via klog_s1_x1_d1 on both FIRED and ARMED paths; no fingerprint on error. Bump _pf_poll_ct on FIRED / ARMED paths. Register plan: rbx = fence_token (saved for fingerprint hex field), r12 = out_timestamp_ptr (saved for the FIRED-path store), r13 = slot row base. Three callee-save pushes land rsp%16==0 at every nested call. klog_s1_x1_d1 caller contract: `sub rsp, 16; mov [rsp+0], fired_flag` writes vd=fired to caller [rsp+0] (which the wrapper reads at [rbp+16] after its own `push rbp`). `add rsp, 16` reclaims pad + vd slot. Labels prefixed pf_poll_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = fence_token (saved)
        mov r12, rsi;                       // r12 = out_ts_ptr (saved)

        // --- Decode (pipe, slot) from fence_token.
        //     pipe = token >> 16; slot = token & 0xFFFF.
        mov rax, rbx;
        shr rax, 16;                        // rax = pipe
        cmp rax, 2;
        ja  pf_poll_bad_token;
        mov rcx, rbx;
        and rcx, 0xFFFF;                    // rcx = slot
        cmp rcx, 16;
        jae pf_poll_bad_token;

        // --- Compute slot row base: &_pf_fence_queue + pipe * 512 +
        //     slot * 32.  rax holds pipe, rcx holds slot.
        lea r13, [rip + _pf_fence_queue];
        shl rax, 9;                         // pipe * 512
        add r13, rax;
        mov rax, rcx;
        shl rax, 5;                         // slot * 32
        add r13, rax;                       // r13 = &slot

        // --- Inspect fired_flag.
        mov rax, [r13 + 16];
        cmp rax, 0;                         // FREE
        je  pf_poll_bad_token;
        cmp rax, 2;                         // FIRED
        je  pf_poll_fired;
        // Fall through: ARMED (state == 1); return 0 (pending).

        // --- ARMED path: bump counter + fingerprint + return 0.
        mov rax, [rip + _pf_poll_ct];
        add rax, 1;
        mov [rip + _pf_poll_ct], rax;

        xor r9, r9;                         // scratch: fired = 0
        sub rsp, 16;
        mov [rsp + 0], r9;                  // vd = fired = 0
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pf_tag_poll];
        lea rcx, [rip + pf_k_token];
        mov r8, rbx;                        // v1 = fence_token (hex)
        lea r9, [rip + pf_k_fired];
        call klog_s1_x1_d1;
        add rsp, 16;

        xor rax, rax;                       // return 0 (pending)
        jmp pf_poll_out;

      pf_poll_fired:
        // --- FIRED path. Write ts to *out_ts_ptr (if non-null),
        //     clear the slot, bump counter, emit fingerprint,
        //     return 1.
        cmp r12, 0;
        je  pf_poll_fired_no_store;
        mov rax, [r13 + 24];                // slot's ts
        mov [r12 + 0], rax;                 // *out_ts_ptr = ts
      pf_poll_fired_no_store:
        // Clear the slot back to FREE for reuse.
        xor rax, rax;
        mov [r13 + 0],  rax;                // timeline_cap = 0
        mov [r13 + 8],  rax;                // client_token = 0
        mov [r13 + 16], rax;                // fired_flag = FREE
        mov [r13 + 24], rax;                // timestamp = 0

        mov rax, [rip + _pf_poll_ct];
        add rax, 1;
        mov [rip + _pf_poll_ct], rax;

        mov r9, 1;                          // scratch: fired = 1
        sub rsp, 16;
        mov [rsp + 0], r9;                  // vd = fired = 1
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pf_tag_poll];
        lea rcx, [rip + pf_k_token];
        mov r8, rbx;                        // v1 = fence_token (hex)
        lea r9, [rip + pf_k_fired];
        call klog_s1_x1_d1;
        add rsp, 16;

        mov rax, 1;                         // return 1 (fired)
        jmp pf_poll_out;

      pf_poll_bad_token:
        mov rax, 0xFFFFFD5F;                // PF_ERR_BAD_TOKEN

      pf_poll_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  Per-pipe armed-count getter
  //
  // Returns the number of ARMED slots on `pipe` (0..16), or 0 if the
  // pipe is out of range. Leaf; no fingerprint. Used by a boot
  // witness programme to assert queue depth after a sequence of arms.
  //
  // SysV: rdi = pipe. Leaf.
  // ==========================================================================

  pub let present_fence_armed_count : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 80 G7 (paideia-os#2547) skeleton: pipe > 2 -> 0; else walk 16 slots at _pf_fence_queue[pipe * 512], count slots where fired_flag == PF_STATE_ARMED, return count. Leaf, no callee-save prologue needed (rax, rcx, rdx scratch only). Labels prefixed pf_ac_.",
      block: {
        cmp rdi, 2;
        ja  pf_ac_zero;

        // Compute pipe row base.
        lea rax, [rip + _pf_fence_queue];
        mov rcx, rdi;
        shl rcx, 9;                         // pipe * 512
        add rax, rcx;                       // rax = &pipe_row[0]

        xor rcx, rcx;                       // rcx = slot cursor
        xor rdx, rdx;                       // rdx = count
      pf_ac_loop:
        cmp rcx, 16;
        jae pf_ac_done;
        mov r8, rcx;
        shl r8, 5;                          // slot * 32
        mov r9, rax;
        add r9, r8;
        mov r8, [r9 + 16];                  // fired_flag
        cmp r8, 1;                          // PF_STATE_ARMED
        jne pf_ac_skip;
        inc rdx;
      pf_ac_skip:
        inc rcx;
        jmp pf_ac_loop;

      pf_ac_done:
        mov rax, rdx;                       // return count
        ret;

      pf_ac_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // §J  Monotonic timestamp getter
  //
  // Returns the current value of the synthesized _pf_mono_ts counter.
  // Leaf; no fingerprint.
  // ==========================================================================

  pub let present_fence_mono_ts : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 80 G7 (paideia-os#2547) skeleton: single mov load from _pf_mono_ts. Leaf.",
      block: {
        mov rax, [rip + _pf_mono_ts];
        ret
      }
    }

  // ==========================================================================
  // §K  Per-op counter getters
  //
  // Four leaf getters so a boot-witness programme can assert
  // (arm_ct, isr_ct, fired_ct, poll_ct) without touching the
  // _pf_*_ct symbols directly.
  // ==========================================================================

