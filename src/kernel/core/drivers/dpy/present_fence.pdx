  // ==========================================================================
  // §L  cap_handler_present_fence(rights, target_ptr, op_arg) -> u64
  //
  // KIND_PRESENT_FENCE (0x4F) cap_invoke dispatch handler. Reachable
  // from cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x4F;
  // je call_kind_present_fence` arm, which lands in a sibling slice
  // (not touched by this file to avoid the parallel-wave invoke.pdx
  // conflict pattern Wave 79's three softarchs hit when all three
  // tried to edit invoke.pdx in the same batch).
  //
  // The three main entrypoints take more than three arguments
  // (arm: 3, isr: 1, poll: 2 but one is an out-pointer), so
  // cap_invoke -- which hands the handler only (rights, target_ptr,
  // op_arg) -- cannot plumb the mutating paths without a packed
  // op_arg or an extended cap_invoke signature. The handler is
  // therefore QUERY-ONLY at skeleton stage, exactly like direct_
  // scanout / damage_plane / sdf_atlas do for their first slice.
  // Five ops:
  //
  //     op 0 PF_OP_QUERY_ARMED_CT  -> _pf_arm_ct
  //     op 1 PF_OP_QUERY_ISR_CT    -> _pf_isr_ct
  //     op 2 PF_OP_QUERY_FIRED_CT  -> _pf_fired_ct
  //     op 3 PF_OP_QUERY_POLL_CT   -> _pf_poll_ct
  //     op 4 PF_OP_QUERY_MONO_TS   -> _pf_mono_ts
  //     else                          INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_PF_READ (0x001). target_ptr is
  // ignored at skeleton stage.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg.
  // Stack recipe: 3 callee-save pushes (rbx = rights, r12 = target,
  //   r13 = op_code).
  // ==========================================================================

  pub let R_PF_READ : u64 = 0x001

  pub let PF_OP_QUERY_ARMED_CT  : u64 = 0
  pub let PF_OP_QUERY_ISR_CT    : u64 = 1
  pub let PF_OP_QUERY_FIRED_CT  : u64 = 2
  pub let PF_OP_QUERY_POLL_CT   : u64 = 3
  pub let PF_OP_QUERY_MONO_TS   : u64 = 4

  pub let cap_handler_present_fence : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 80 G7 (paideia-os#2547) skeleton: KIND_PRESENT_FENCE (0x4F) cap_invoke dispatch. Entry chatter (klog_s1 of pf_tag_handler_entry). op_code = op_arg & 0xFF; rights gate against R_PF_READ (single up-front check); dispatch 0..4 to the matching reader (present_fence_arm_ct / isr_ct / fired_ct / poll_ct / mono_ts); else INVOKE_UNSUPPORTED. target_ptr ignored at skeleton stage. Three callee-save pushes land rsp%16==0 at every nested call. The mutating ops (arm / isr / poll -- all take >1 non-rights arg or an out-pointer) are deferred to a follow-up slice that either extends cap_invoke with a 4-register slot variant or packs (timeline_cap, client_token) into target_ptr/op_arg for the arm path. Labels prefixed pf_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rights
        mov r12, rsi;                       // target_ptr
        mov r13, rdx;                       // op_arg
        and r13, 0xFF;                      // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pf_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                     // R_PF_READ
        cmp r10, 0;
        je  pf_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  pf_hd_op_arm_ct;
        cmp r13, 1;
        je  pf_hd_op_isr_ct;
        cmp r13, 2;
        je  pf_hd_op_fired_ct;
        cmp r13, 3;
        je  pf_hd_op_poll_ct;
        cmp r13, 4;
        je  pf_hd_op_mono_ts;
        jmp pf_hd_unsup;

      pf_hd_op_arm_ct:
        call present_fence_arm_ct;
        jmp pf_hd_out;
      pf_hd_op_isr_ct:
        call present_fence_isr_ct;
        jmp pf_hd_out;
      pf_hd_op_fired_ct:
        call present_fence_fired_ct;
        jmp pf_hd_out;
      pf_hd_op_poll_ct:
        call present_fence_poll_ct;
        jmp pf_hd_out;
      pf_hd_op_mono_ts:
        call present_fence_mono_ts;
        jmp pf_hd_out;

      pf_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;        // INVOKE_DENIED
        jmp pf_hd_out;
      pf_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;        // INVOKE_UNSUPPORTED

      pf_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  Boot wiring note
  // ----------------
  // kernel_main.pdx does NOT need a dedicated reset entry: .bss zero-
  // init leaves _pf_fence_queue empty (every slot's fired_flag = 0,
  // every slot FREE), the four counters at zero, and _pf_mono_ts at
  // zero, which is exactly the never-armed starting state the arm /
  // isr / poll paths expect. A follow-up slice may mint a defensive
  // `present_fence_reset` for parity with the other dpy drivers'
  // reset entries (iris_xe_cursor_reset is the local precedent), but
  // the skeleton gets by on .bss alone.
  //
  // invoke.pdx picks up the KIND_PRESENT_FENCE (0x4F) dispatch arm in
  // a sibling slice -- NOT in this file, to avoid the parallel-wave
  // invoke.pdx edit conflict pattern. The sibling slice is pure
  // plumbing (cmp rcx, 0x4F; je call_kind_present_fence) and self-
  // standing (the handler already lands here and returns INVOKE_
  // UNSUPPORTED for every mutating op; wiring is observable but
  // harmless until a user programme invokes it).
  //
  // The G4 hotplug ISR dispatcher picks up the per-pipe vblank arm
  // (dispatch into present_fence_vblank_isr) in the same follow-up
  // slice that reads PIPE_FRMCOUNT / PIPE_FLIPCOUNT. The skeleton's
  // ISR body is callable now from a boot witness programme but does
  // not land on the real IDT entry yet.
  //
  // No new klog wrapper is minted at skeleton stage. The three
  // fingerprints all ride klog_s1_x1_d1 (proven across the Wave 59-
  // 79 drivers). A follow-up slice may mint klog_s1_d1_x2 (1 dec +
  // 2 hex) and klog_s1_d2_x1 (2 dec + 1 hex) to widen the ARM / FIRED
  // fingerprint shapes to carry three fields each (pipe + tl_cap +
  // token on arm; pipe + token + ts on fired) without changing the
  // frozen ABI.
  //
  // Follow-up slices (G8 and later):
  //   - Real ISR body: PIPE_FRMCOUNT + PIPE_FLIPCOUNT reads;
  //     RW1C-write to DE_PIPE_INTR_IIR; PIPE_FRMCOUNT threaded into
  //     slot timestamp field instead of _pf_mono_ts synthesis.
  //   - DE_PIPE_INTR_IER-live gate for present_fence_arm (R4: pipe
  //     vblank interrupt disabled -> PF_ERR_PIPE_NOT_ARMED,
  //     0xFFFFFD6D).
  //   - cap_handler extension for the mutating ops (arm / isr /
  //     poll -- packed target_ptr + op_arg for the arm path, or a
  //     4-register cap_invoke slot variant).
  //   - klog_s1_d1_x2 / klog_s1_d2_x1 mints in klog/wrappers.pdx so
  //     the fingerprint shapes can carry the full 3-field content
  //     the task directive described.
  //   - IDT entry wiring in g4 hotplug ISR dispatcher so the vblank
  //     interrupt actually calls present_fence_vblank_isr.
  // ==========================================================================
}
