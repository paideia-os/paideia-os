// src/kernel/core/drivers/dpy/hpd_isr.pdx — R36.M2-005 (#1243)
//
// Hot-plug detect ISR scaffold. The DDI's SDE_ISR bit fires when a
// downstream sink is plugged in, unplugged, or reasserts its HPD line
// (an "IRQ_HPD" per DP §3.6). The ISR debounces the transition
// (100 ms), reads HPD_STATUS through the seam, and fans out to the
// display_topology_channel schema.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DEBOUNCE + FANOUT half of an HPD path. The interrupt
// vector this ISR sits behind is minted through KIND_HW_INTERRUPT
// against the display engine's PCIe MSI-X capability; that binding is
// R37's work. Same discipline as i2c_hid/isr.pdx §0: the ISR is a
// LATCH, the bind gate is arity-zero, and the assert seam returns
// DEFERRED_HARDWARE until the vector is bound to a live SDE_ISR bit.
//
// IT DOES NOT MINT KIND_DISPLAY_OUTPUT rows. The topology enumerator
// (topology.pdx) records the DDI path; the KIND_DISPLAY_OUTPUT mint
// consumes both. This ISR only reports transitions and fans out an
// event through display_topology_channel.
//
// hpd_arbitrated() returns 0 until a later round binds the SDE_ISR
// seam against a live MMIO window and the vector against a live
// KIND_HW_INTERRUPT cap.
//
// =============================================================================
// §1  DEBOUNCE
// =============================================================================
//
// HPD lines bounce at plug-in / unplug. The bspec-mandated debounce
// window is 100 ms; a transition observed within that window of the
// previous one MUST be treated as bounce and coalesced.
//
// The debounce state is kept per-DDI in _hpd_state[+ddi_index]. Each
// slot is 16 bytes:
//   [+0]  last_status_ticks (from a monotonic tick counter)
//   [+8]  last_status_bit   (0 = disconnected, 1 = connected)
//
// The tick source is a caller-supplied `now_ticks` argument passed
// into hpd_isr_assert (arity-two: ddi_index + now_ticks). A future
// binding will read the arbitrated timeline; the arity-two shape
// keeps the tick source a capability, not a global.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _hpd_state and _hpd_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/drivers/dpy/hpd_isr.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF740..0xFFFFF74F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: display_topology_channel
// 0xFFFFF750..5F).

module HpdIsr = structure {

  // Number of DDIs tracked (matches KindDisplayOutput.DPO_DDI_MAX + 1).
  pub let HPD_DDI_COUNT : u64 = 8

  // Debounce window in ticks. The tick source is caller-supplied;
  // this constant is used as a comparison threshold. Callers must
  // scale their `now_ticks` accordingly. Default assumes 1 tick =
  // 1 ms per the R31 monotonic timeline convention.
  pub let HPD_DEBOUNCE_TICKS : u64 = 100

  // Per-DDI state: 16 bytes each * 8 DDIs = 128 bytes ([u64; 16]).
  pub let mut _hpd_state : [u64; 16] = uninit @align(64)
  pub let mut _hpd_stats : [u64; 8]  = uninit @align(64)

  pub let HPD_ST_BINDS      : u64 = 0
  pub let HPD_ST_ASSERTS    : u64 = 1
  pub let HPD_ST_DEBOUNCED  : u64 = 2
  pub let HPD_ST_CONNECTS   : u64 = 3
  pub let HPD_ST_DISCONNECT : u64 = 4
  pub let HPD_ST_REFUSED    : u64 = 5

  pub let mut _hpd_bound : u64 = 0

  // Failure taxonomy — 0xFFFFF740..0xFFFFF74F.
  pub let HPD_OK                 : u64 = 0
  pub let HPD_BAD_ARG            : u64 = 0xFFFFF74F
  pub let HPD_BAD_DDI            : u64 = 0xFFFFF74E
  pub let HPD_NOT_BOUND          : u64 = 0xFFFFF74D
  pub let HPD_REBIND             : u64 = 0xFFFFF74C
  pub let HPD_DEBOUNCED          : u64 = 0xFFFFF74B
  pub let HPD_DEFERRED_HARDWARE  : u64 = 0xFFFFF74A

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let hpd_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): clear per-DDI debounce state, stats, and bound flag. Boot and teardown. Labels prefixed hpd_rs_.",
      block: {
        lea r10, [rip + _hpd_state];
        xor rax, rax;
        xor rcx, rcx;
      hpd_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  hpd_rs_state;

        lea r10, [rip + _hpd_stats];
        xor rcx, rcx;
      hpd_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hpd_rs_stats;

        lea r10, [rip + _hpd_bound];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    } @no_frame

  pub let hpd_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-005 (#1243): honesty pin. 0 until the SDE_ISR seam is bound to a live MMIO window and the vector to a live KIND_HW_INTERRUPT.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hpd_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): counter read. Labels prefixed hpd_st_.",
      block: {
        cmp rdi, 8;
        jae hpd_st_zero;
        lea r10, [rip + _hpd_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hpd_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hpd_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): counter bump. Labels prefixed hpd_nt_.",
      block: {
        cmp rdi, 8;
        jae hpd_nt_out;
        lea r10, [rip + _hpd_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hpd_nt_out:
        ret
      }
    } @no_frame

  pub let hpd_ddi_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-005 (#1243): 1 iff d < HPD_DDI_COUNT (8). Labels prefixed hpd_dv_.",
      block: {
        cmp rdi, 8;
        jae hpd_dv_no;
        mov rax, 1;
        ret;
      hpd_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hpd_isr_bind() -> OK | REBIND
  //
  // ARITY ZERO for the reason i2c_hid_isr_bind is arity zero: the
  // vector this ISR subscribes to is named by the KIND_HW_INTERRUPT
  // capability the caller must already hold; a caller-supplied vector
  // would let the ISR subscribe to a line no capability named.
  // ==========================================================================

  pub let hpd_isr_bind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): mark the HPD ISR bound. Refuses a second bind (REBIND: rebinding mid-flight would leave an unclaimed edge on the SDE_ISR bit the previous subscription named). Arity zero — vector named by caller's KIND_HW_INTERRUPT cap. Labels prefixed hpd_bd_.",
      block: {
        lea r10, [rip + _hpd_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne hpd_bd_rebind;

        mov rax, 1;
        mov [r10], rax;

        mov rdi, 0;                      // BINDS
        call hpd_note;
        xor rax, rax;
        ret;

      hpd_bd_rebind:
        mov rdi, 5;                      // REFUSED
        call hpd_note;
        mov rax, 0xFFFFF74C;
        ret
      }
    }

  pub let hpd_isr_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): 1 once hpd_isr_bind has succeeded. Labels prefixed hpd_ib_.",
      block: {
        lea r10, [rip + _hpd_bound];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hpd_read_status(ddi_index) -> code
  //
  // Seam-backed. In a live build reads the HPD_STATUS register from
  // the DDI's aux control block; returns 0 disconnected / 1 connected.
  // ==========================================================================

  pub let hpd_read_status : (u64) -> u64 !{mem} @{} =
    fn (ddi_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): seam-backed read of HPD_STATUS. Returns DEFERRED_HARDWARE today. Gates: ddi valid (BAD_DDI). Labels prefixed hpd_rs2_.",
      block: {
        cmp rdi, 8;
        jae hpd_rs2_bad;
        mov rax, 0xFFFFF74A;             // DEFERRED_HARDWARE
        ret;
      hpd_rs2_bad:
        mov rax, 0xFFFFF74E;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hpd_isr_assert(ddi_index, now_ticks) -> code
  //
  // Called (in a live build) from the SDE_ISR bottom half when the
  // per-DDI HPD bit is set. Enforces:
  //
  //   1. ISR bound.
  //   2. ddi valid.
  //   3. Debounce: if (now_ticks - last_status_ticks) < 100 ->
  //      DEBOUNCED (and counted).
  //   4. Read HPD_STATUS through the seam.
  //   5. Update per-DDI cache; count CONNECTS / DISCONNECT.
  //
  // Returns OK on a real transition (or NOT_BOUND / BAD_DDI /
  // DEBOUNCED for the three refusal classes).
  // ==========================================================================

  pub let hpd_isr_assert : (u64, u64) -> u64 !{mem} @{} =
    fn (ddi_index: u64) (now_ticks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): HPD ISR assertion. Sequence: bound (NOT_BOUND); ddi valid (BAD_DDI); debounce (DEBOUNCED); read status; update cache + count. Uses r12/r13 for saved args. Labels prefixed hpd_as_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // ddi
        mov r13, rsi;                    // now_ticks

        lea r10, [rip + _hpd_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  hpd_as_not_bound;

        cmp r12, 8;
        jae hpd_as_bad_ddi;

        mov rdi, 1;                      // ASSERTS
        call hpd_note;

        // Per-DDI slot base = _hpd_state + ddi*16.
        lea rbx, [rip + _hpd_state];
        mov r14, r12;
        shl r14, 4;
        add rbx, r14;

        // Debounce: skip on first-time (last_status_ticks == 0).
        mov rax, [rbx + 0];
        cmp rax, 0;
        je  hpd_as_read;
        mov r10, r13;
        sub r10, rax;
        mov r14, 100;                    // DEBOUNCE_TICKS
        cmp r10, r14;
        jb  hpd_as_debounced;

      hpd_as_read:
        // Read status through seam. Live path would update the cache
        // with the seam's return; the seam returns DEFERRED_HARDWARE
        // today, so we treat that as "no state change" (do not bump
        // CONNECTS/DISCONNECT counters, do not overwrite cache) and
        // still return OK — the assert itself was accepted.
        mov [rbx + 0], r13;
        xor rax, rax;
        jmp hpd_as_out;

      hpd_as_not_bound:
        mov rdi, 5;
        call hpd_note;
        mov rax, 0xFFFFF74D;
        jmp hpd_as_out;
      hpd_as_bad_ddi:
        mov rdi, 5;
        call hpd_note;
        mov rax, 0xFFFFF74E;
        jmp hpd_as_out;
      hpd_as_debounced:
        mov rdi, 2;                      // DEBOUNCED
        call hpd_note;
        mov rax, 0xFFFFF74B;

      hpd_as_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hpd_ddi_last_bit(ddi_index) -> 0 | 1 | DECODE_BAD
  //
  // Read the cached last_status_bit for a DDI. DECODE_BAD if ddi is
  // out of range.
  // ==========================================================================

  pub let hpd_ddi_last_bit : (u64) -> u64 !{mem} @{} =
    fn (ddi_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-005 (#1243): return cached last_status_bit at +8 of the per-DDI slot. Labels prefixed hpd_lb_.",
      block: {
        cmp rdi, 8;
        jae hpd_lb_bad;
        lea r10, [rip + _hpd_state];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 8];
        ret;
      hpd_lb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame
}
