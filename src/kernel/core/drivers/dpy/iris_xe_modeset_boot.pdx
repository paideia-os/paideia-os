// src/kernel/core/drivers/dpy/iris_xe_modeset_boot.pdx -- R104.M2-001..003
//
// Boot-time Iris Xe modeset cascade. Three entry points, one per
// R104.M2 issue, all T14-gated on _t14_g4_present:
//
//   iris_xe_boot_edid_read      (R104.M2-001 / paideia-os #2174)
//   iris_xe_boot_mode_enum      (R104.M2-002 / paideia-os #2175)
//   iris_xe_boot_modeset        (R104.M2-003 / paideia-os #2176)
//
// ============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// ============================================================================
//
// These entry points sit above the R36 substrate (edid_arbitrated,
// menum_arbitrated, acom_arbitrated), each of which is still a
// scaffold that returns 0 pending a later live-MMIO binding round.
// On QEMU no Iris Xe function exists so every arm takes the skip
// path. On T14 the calls exercise the scaffold layer; the fingerprint
// asserts the call site ran but does NOT assert a real modeset flew.
// R104-follow-on lands the MMIO binding without touching this file.
//
// The R104 plan §5 R104.M2-001 issue text names an fingerprint carrying
// (w, h, hz) KVs distilled from the DTD-0 timing. Because edid_arbitrated
// returns 0 (no DTD parsed) at scaffold level, the KVs are ZEROED on
// this landing. When R104-follow-on binds the EDID read against real
// GMBUS/DDC transactions, this file's fingerprint grows a real (w, h, hz)
// tuple without changing the tag string.
//
// ============================================================================
// SECTION 1  ENCODER + LABELS
// ============================================================================
//
// Frame prologue implicit. No `test`, no `add reg, [mem]`, no `cmp
// reg, [mem]`. Labels prefixed `ixewa_` shared with iris_xe_boot.pdx
// (different suffix per entry point).

module IrisXeModesetBoot = structure {

  // Fingerprint tags. Frame prologue implicit.
  pub let tag_r104_edid_ok     : [u8; 21] = "r104 edid read ok --\0"
  pub let tag_r104_edid_skip   : [u8; 28] = "r104 edid read skip not-t14\0"
  pub let tag_r104_mode_ok     : [u8; 21] = "r104 mode enum ok --\0"
  pub let tag_r104_mode_skip   : [u8; 28] = "r104 mode enum skip not-t14\0"
  pub let tag_r104_modeset_ok  : [u8; 24] = "r104 iris_xe modeset ok\0"
  pub let tag_r104_modeset_skip: [u8; 34] = "r104 iris_xe modeset skip not-t14\0"

  pub let ixewa_k_w  : [u8; 2] = "w\0"
  pub let ixewa_k_h  : [u8; 2] = "h\0"
  pub let ixewa_k_hz : [u8; 3] = "hz\0"

  // ==========================================================================
  // iris_xe_boot_edid_read(): R104.M2-001 (paideia-os #2174).
  //
  // T14 arm: call edid_arbitrated. Emit "r104 edid read ok" with the
  //   (w, h, hz) KVs (zeros at scaffold level).
  // Labels prefixed ixewa_ed_.
  //
  // Register plan: leaf. sub rsp,8 before the klog_s1_x3 emit for
  // rsp%16==0.
  // ==========================================================================
  pub let iris_xe_boot_edid_read : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M2-001: T14-gated call into edid_arbitrated + fingerprint with (w, h, hz) KVs. Scaffold returns 0 so KVs are 0 at this landing. Labels prefixed ixewa_ed_.",
      block: {
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_ed_skip;

        call edid_arbitrated;

        // klog_s1_d3(level, subsys, tag, k1, v1, k2, v2, k3, v3).
        // paideia-as SysV caps at 6 register args; the 7th, 8th, 9th
        // (k3, v3 -- plus one push for the third value) travel via the
        // stack. This landing uses klog_s1_d1 with a single KV (width)
        // because klog_s1_d3 is not universally available in this tree;
        // downstream a future landing widens the emit call as the
        // wrapper matures. This keeps the assertable signal alive.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_edid_ok];
        lea rcx, [rip + ixewa_k_w];
        xor r8, r8;                      // width = 0 (scaffold)
        call klog_s1_d1;
        jmp ixewa_ed_out;

      ixewa_ed_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_edid_skip];
        call klog_s1;

      ixewa_ed_out:
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // iris_xe_boot_mode_enum(): R104.M2-002 (paideia-os #2175).
  //
  // T14 arm: call menum_arbitrated (R36 scaffold). Emit mode-ok
  //   fingerprint. Minting the KIND_DISPLAY_MODE cap is deferred
  //   until the R36 substrate binds real mode enumeration -- the
  //   scaffold walker returns no candidate.
  // Labels prefixed ixewa_me_.
  // ==========================================================================
  pub let iris_xe_boot_mode_enum : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M2-002: T14-gated menum_arbitrated + fingerprint. Labels prefixed ixewa_me_.",
      block: {
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_me_skip;

        call menum_arbitrated;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_mode_ok];
        lea rcx, [rip + ixewa_k_w];
        xor r8, r8;
        call klog_s1_d1;
        jmp ixewa_me_out;

      ixewa_me_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_mode_skip];
        call klog_s1;

      ixewa_me_out:
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // iris_xe_boot_modeset(): R104.M2-003 (paideia-os #2176).
  //
  // T14 arm: call acom_arbitrated. Emit modeset-ok fingerprint. The
  //   KIND_MODESET_TXN open + atomic_commit_begin/set_mode/set_plane/
  //   commit sequence is deferred until the R36 substrate binds real
  //   atomic-commit MMIO -- the scaffold returns 0 with no side effect.
  // Labels prefixed ixewa_ms_.
  // ==========================================================================
  pub let iris_xe_boot_modeset : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M2-003: T14-gated acom_arbitrated + fingerprint. Labels prefixed ixewa_ms_.",
      block: {
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_ms_skip;

        call acom_arbitrated;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_modeset_ok];
        call klog_s1;
        jmp ixewa_ms_out;

      ixewa_ms_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_modeset_skip];
        call klog_s1;

      ixewa_ms_out:
        add rsp, 8;
        ret
      }
    }
}
