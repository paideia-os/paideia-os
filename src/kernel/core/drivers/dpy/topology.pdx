// src/kernel/core/drivers/dpy/topology.pdx — R36.M2-001 (#1239)
//
// Intel Iris Xe display topology scaffold. Enumerates DDI paths (up
// to 4 per engine on Xe1), fields native DP AUX requests, and walks
// DP-MST branch topology. MMIO / AUX transactions are stubbed
// through a synthetic seam this milestone.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WHICH-DDI-IS-ATTACHED-TO-WHAT half of a display bring-up.
// A pipeline consumer that wants to drive a sink needs to know:
//
//   1. Which DDIs the engine exposes (up to 4 on Xe1; 4 on Xe2/Xe3).
//   2. For each DDI, what wire protocol (HDMI / DP / eDP / DP-MST).
//   3. For DP-MST, which branch devices sit under the root.
//
// This scaffold answers those three questions through:
//
//   * dtopo_path_record(engine_slot, ddi_index, wire_type) — one row
//     per DDI-path
//   * dtopo_aux_request(port, address, len, is_write) — one DP AUX
//     transaction through the seam
//   * dtopo_mst_walk_root(root_port) — enumerate branch devices under
//     a DP-MST root
//
// IT DOES NOT TOUCH REAL MMIO OR AUX. Every register access and
// every AUX transaction goes through a seam whose default backing is
// caller-supplied snapshots.
//
// IT DOES NOT MINT KIND_DISPLAY_OUTPUT. That is a separate gate the
// pipeline consumer takes once it has both an engine cap and a valid
// path record; this scaffold populates the path table the mint will
// later consult.
//
// dtopo_arbitrated() returns 0 until a later round binds this against
// live MMIO + AUX windows.
//
// =============================================================================
// §1  DDI PATHS PER ENGINE
// =============================================================================
//
// Xe1 exposes up to 4 DDIs per engine (DDI_A..DDI_D). Xe2/Xe3 add
// USB-C/TB4 DDIs at higher indices; the field admits every DDI a
// shipping Xe part exposes (0..7).
//
// A path row is 16 bytes:
//   [+0]  header (in_use[7:0] | engine_slot[31:8])
//   [+8]  ddi_index[7:0] | wire_type[15:8] | reserved[63:16]
//
// =============================================================================
// §2  DP AUX TRANSPORT
// =============================================================================
//
// Native DP AUX request/response over the AUX channel:
//   * Address: 20-bit DPCD offset.
//   * Length: 1..16 bytes (AUX_MAX_LEN); DPCD reads longer than 16
//     require multiple transactions (deferred).
//   * Direction: 0 read / 1 write.
//
// The seam returns DEFERRED_HARDWARE today.
//
// =============================================================================
// §3  DP-MST BRANCH WALK
// =============================================================================
//
// dtopo_mst_walk_root(root_port) walks the branch descriptor at
// root_port through DPCD 0x02200 (LINK_ADDRESS reply). One walk per
// root; bounded to DTOPO_MST_MAX_BRANCH_DEV (16) devices per root.
//
// =============================================================================
// §4  ONE WRITER OF THE STATE
// =============================================================================
//
// _dtopo_paths and _dtopo_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/drivers/dpy/topology.o`.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFF770..0xFFFFF77F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: kind_display_output
// 0xFFFFF780..8F; adjacent free band below: edid 0xFFFFF760..6F).

module Topology = structure {

  // DDI cap.
  pub let DTOPO_DDI_MAX : u64 = 7

  // Wire types (matches KindDisplayOutput.DPO_TYPE_*).
  pub let DTOPO_WIRE_HDMI   : u64 = 0
  pub let DTOPO_WIRE_DP     : u64 = 1
  pub let DTOPO_WIRE_EDP    : u64 = 2
  pub let DTOPO_WIRE_DP_MST : u64 = 3
  pub let DTOPO_WIRE_MAX    : u64 = 3

  // AUX limits.
  pub let DTOPO_AUX_MAX_LEN     : u64 = 16
  pub let DTOPO_AUX_ADDR_MAX    : u64 = 0xFFFFF

  // MST bounds.
  pub let DTOPO_MST_MAX_BRANCH_DEV : u64 = 16

  // Path table sized 8 rows * 16 bytes = 128 bytes ([u64; 16]).
  pub let DTOPO_PATH_MAX       : u64 = 8
  pub let DTOPO_PATH_ROW_BYTES : u64 = 16

  pub let mut _dtopo_paths : [u64; 16] = uninit @align(64)
  pub let mut _dtopo_stats : [u64; 8]  = uninit @align(64)

  pub let DTOPO_ST_RECORDS   : u64 = 0
  pub let DTOPO_ST_AUX_REQS  : u64 = 1
  pub let DTOPO_ST_MST_WALKS : u64 = 2
  pub let DTOPO_ST_REFUSED   : u64 = 3

  // Failure taxonomy — 0xFFFFF770..0xFFFFF77F.
  pub let DTOPO_OK                 : u64 = 0
  pub let DTOPO_BAD_ARG            : u64 = 0xFFFFF77F
  pub let DTOPO_BAD_DDI            : u64 = 0xFFFFF77E
  pub let DTOPO_BAD_WIRE           : u64 = 0xFFFFF77D
  pub let DTOPO_BAD_ENGINE         : u64 = 0xFFFFF77C
  pub let DTOPO_BAD_AUX_ADDR       : u64 = 0xFFFFF77B
  pub let DTOPO_BAD_AUX_LEN        : u64 = 0xFFFFF77A
  pub let DTOPO_BAD_MST_ROOT       : u64 = 0xFFFFF779
  pub let DTOPO_ENOSPC             : u64 = 0xFFFFF778
  pub let DTOPO_DUPLICATE          : u64 = 0xFFFFF777
  pub let DTOPO_DEFERRED_HARDWARE  : u64 = 0xFFFFF776

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dtopo_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): clear paths + stats. Boot and teardown. Labels prefixed dtopo_rs_.",
      block: {
        lea r10, [rip + _dtopo_paths];
        xor rax, rax;
        xor rcx, rcx;
      dtopo_rs_paths:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  dtopo_rs_paths;

        lea r10, [rip + _dtopo_stats];
        xor rcx, rcx;
      dtopo_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dtopo_rs_stats;
        ret
      }
    } @no_frame

  pub let dtopo_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-001 (#1239): honesty pin. 0 until a later round binds this against live MMIO + AUX windows.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dtopo_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): counter read. Labels prefixed dtopo_st_.",
      block: {
        cmp rdi, 8;
        jae dtopo_st_zero;
        lea r10, [rip + _dtopo_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dtopo_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dtopo_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): counter bump. Labels prefixed dtopo_nt_.",
      block: {
        cmp rdi, 8;
        jae dtopo_nt_out;
        lea r10, [rip + _dtopo_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dtopo_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dtopo_ddi_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-001 (#1239): 1 iff d <= DDI_MAX (7). Labels prefixed dtopo_dv_.",
      block: {
        cmp rdi, 7;
        ja  dtopo_dv_no;
        mov rax, 1;
        ret;
      dtopo_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dtopo_wire_valid : (u64) -> u64 !{} @{} =
    fn (w: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-001 (#1239): 1 iff w in {0..3}. Labels prefixed dtopo_wv_.",
      block: {
        cmp rdi, 3;
        ja  dtopo_wv_no;
        mov rax, 1;
        ret;
      dtopo_wv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dtopo_aux_addr_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-001 (#1239): 1 iff a fits 20 bits (DPCD offset). Labels prefixed dtopo_av_.",
      block: {
        mov r10, 0xFFFFF;
        cmp rdi, r10;
        ja  dtopo_av_no;
        mov rax, 1;
        ret;
      dtopo_av_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dtopo_aux_len_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-001 (#1239): 1 iff 1 <= l <= AUX_MAX_LEN (16). Zero-length transactions are refused. Labels prefixed dtopo_lv_.",
      block: {
        cmp rdi, 1;
        jb  dtopo_lv_no;
        cmp rdi, 16;
        ja  dtopo_lv_no;
        mov rax, 1;
        ret;
      dtopo_lv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Path table — ONE WRITER of _dtopo_paths.
  // ==========================================================================

  pub let dtopo_path_find : (u64, u64) -> u64 !{mem} @{} =
    fn (engine_slot: u64) (ddi_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): live row matching (engine_slot, ddi_index) or 0xFF. Labels prefixed dtopo_pf_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        mov r13, rsi;
        xor rcx, rcx;
      dtopo_pf_scan:
        cmp rcx, 8;
        jae dtopo_pf_none;
        lea r10, [rip + _dtopo_paths];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, 0xFF;
        and r11, rax;
        cmp r11, 0;
        je  dtopo_pf_next;
        // Header: [in_use 7:0 | engine_slot 31:8].
        mov r11, rax;
        shr r11, 8;
        and r11, 0xFFFFFF;
        cmp r11, r12;
        jne dtopo_pf_next;
        mov r11, [r10 + 8];
        and r11, 0xFF;
        cmp r11, r13;
        jne dtopo_pf_next;
        mov rax, rcx;
        jmp dtopo_pf_out;
      dtopo_pf_next:
        add rcx, 1;
        jmp dtopo_pf_scan;
      dtopo_pf_none:
        mov rax, 0xFF;
      dtopo_pf_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let dtopo_path_record : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (engine_slot: u64) (ddi_index: u64) (wire_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): record one DDI path. Gates: ddi valid, wire valid, engine_slot fits 24 bits, no duplicate (engine, ddi). Low-first free scan. Labels prefixed dtopo_pr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // engine_slot
        mov r12, rsi;                    // ddi_index
        mov r13, rdx;                    // wire_type

        mov rdi, r12;
        call dtopo_ddi_valid;
        cmp rax, 0;
        je  dtopo_pr_bad_ddi;

        mov rdi, r13;
        call dtopo_wire_valid;
        cmp rax, 0;
        je  dtopo_pr_bad_wire;

        mov r10, 0xFFFFFF;
        cmp rbx, r10;
        ja  dtopo_pr_bad_engine;

        // Duplicate?
        mov rdi, rbx;
        mov rsi, r12;
        call dtopo_path_find;
        cmp rax, 0xFF;
        jne dtopo_pr_dup;

        xor rcx, rcx;
      dtopo_pr_scan:
        cmp rcx, 8;
        jae dtopo_pr_enospc;
        lea r10, [rip + _dtopo_paths];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        cmp rax, 0;
        je  dtopo_pr_claim;
        add rcx, 1;
        jmp dtopo_pr_scan;

      dtopo_pr_claim:
        mov rax, 1;
        mov r11, rbx;
        and r11, 0xFFFFFF;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;

        mov rax, r12;
        and rax, 0xFF;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 8], rax;

        mov rdi, 0;
        call dtopo_note;
        mov rax, rcx;
        jmp dtopo_pr_out;

      dtopo_pr_bad_ddi:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF77E;
        jmp dtopo_pr_out;
      dtopo_pr_bad_wire:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF77D;
        jmp dtopo_pr_out;
      dtopo_pr_bad_engine:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF77C;
        jmp dtopo_pr_out;
      dtopo_pr_dup:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF777;
        jmp dtopo_pr_out;
      dtopo_pr_enospc:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF778;

      dtopo_pr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dtopo_path_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): live path count. Labels prefixed dtopo_pc_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      dtopo_pc_scan:
        cmp rcx, 8;
        jae dtopo_pc_out;
        lea r10, [rip + _dtopo_paths];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov r11, [r10 + 0];
        and r11, 0xFF;
        cmp r11, 0;
        je  dtopo_pc_next;
        add rax, 1;
      dtopo_pc_next:
        add rcx, 1;
        jmp dtopo_pc_scan;
      dtopo_pc_out:
        ret
      }
    } @no_frame

  pub let dtopo_path_wire : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): wire_type at row_id, or DECODE_BAD. Labels prefixed dtopo_pw_.",
      block: {
        cmp rdi, 8;
        jae dtopo_pw_bad;
        lea r10, [rip + _dtopo_paths];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        cmp rax, 0;
        je  dtopo_pw_bad;
        mov rax, [r10 + 8];
        shr rax, 8;
        and rax, 0xFF;
        ret;
      dtopo_pw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // DP AUX transport — seam-backed.
  //
  // Every AUX request goes through this function. The seam returns
  // DEFERRED_HARDWARE today; a live implementation will drive the
  // AUX channel through the DDI's aux register set.
  // ==========================================================================

  pub let dtopo_aux_request : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ddi_index: u64) (address: u64) (len: u64) (is_write: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): DP AUX request. Gates: ddi valid, address fits 20 bits, len in 1..16, is_write in {0,1}. All refusals return typed codes; happy path counts + returns DEFERRED_HARDWARE. Labels prefixed dtopo_ar_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        mov rdi, rbx;
        call dtopo_ddi_valid;
        cmp rax, 0;
        je  dtopo_ar_bad_ddi;

        mov rdi, r12;
        call dtopo_aux_addr_valid;
        cmp rax, 0;
        je  dtopo_ar_bad_addr;

        mov rdi, r13;
        call dtopo_aux_len_valid;
        cmp rax, 0;
        je  dtopo_ar_bad_len;

        cmp r14, 1;
        ja  dtopo_ar_bad_ddi;            // is_write out of {0,1}

        mov rdi, 1;
        call dtopo_note;                 // AUX_REQS
        mov rax, 0xFFFFF776;             // DEFERRED_HARDWARE
        jmp dtopo_ar_out;

      dtopo_ar_bad_ddi:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF77E;
        jmp dtopo_ar_out;
      dtopo_ar_bad_addr:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF77B;
        jmp dtopo_ar_out;
      dtopo_ar_bad_len:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF77A;

      dtopo_ar_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // DP-MST branch walk.
  // ==========================================================================

  pub let dtopo_mst_walk_root : (u64) -> u64 !{mem} @{} =
    fn (root_port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-001 (#1239): walk MST branch descriptors at root_port. Gates: root_port is a DDI (0..7). Bounded to MST_MAX_BRANCH_DEV. Counts the walk; returns DEFERRED_HARDWARE (no live AUX yet). Labels prefixed dtopo_mw_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call dtopo_ddi_valid;
        cmp rax, 0;
        je  dtopo_mw_bad_root;

        mov rdi, 2;
        call dtopo_note;                 // MST_WALKS
        mov rax, 0xFFFFF776;             // DEFERRED_HARDWARE
        pop r12;
        ret;

      dtopo_mw_bad_root:
        mov rdi, 3;
        call dtopo_note;
        mov rax, 0xFFFFF779;
        pop r12;
        ret
      }
    }
}
