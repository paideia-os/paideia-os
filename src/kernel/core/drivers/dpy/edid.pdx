// src/kernel/core/drivers/dpy/edid.pdx — R36.M2-002 (#1240)
//
// EDID (Extended Display Identification Data) reader + parser scaffold.
// Reads the 128-byte base block via DDC (DP AUX I²C at 0x50 or HDMI
// I²C), parses manufacturer, product, detailed timing descriptors
// (DTD 0..3) and monitor descriptors. Parses CEA-861 extension block
// (SVDs / VSDBs / HDR static metadata) when block 1 is present.
// Parses DisplayID timings I..VII when block N is a DisplayID block.
// Every block is checksummed and its revision validated.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the READ + VALIDATE + DECODE half of EDID handling. It DOES
// NOT drive DDC transactions itself — the base-block read is done
// through the seam edid_read_block(port, block_num, dst_ptr), whose
// default backing returns DEFERRED_HARDWARE. A caller with a fabricated
// EDID array can hand it directly to edid_parse_base for validation
// and decode, which is what the boot witness exercises.
//
// IT DOES NOT MINT A KIND_DISPLAY_OUTPUT. edid_hash is a field the
// mint takes; this module computes it from the parsed bytes.
//
// edid_arbitrated() returns 0 until a later round binds the read
// seam against a live DP AUX / HDMI I²C window.
//
// =============================================================================
// §1  BASE BLOCK (128 BYTES)
// =============================================================================
//
// Structure per VESA E-EDID §3:
//
//   [0..7]   header: 00 FF FF FF FF FF FF 00
//   [8..9]   manufacturer id (3x 5-bit PnP codes, big-endian)
//   [10..11] product code (LE u16)
//   [12..15] serial (LE u32)
//   [16..17] week / year of manufacture
//   [18..19] EDID version / revision
//   [54..71] DTD 0 (18B)
//   [72..89] DTD 1 or monitor descriptor
//   [90..107] DTD 2 or monitor descriptor
//   [108..125] DTD 3 or monitor descriptor
//   [126]    extension block count
//   [127]    checksum (sum of [0..127] must be 0 mod 256)
//
// =============================================================================
// §2  CEA-861 EXTENSION (BLOCK 1+)
// =============================================================================
//
// Header per CEA-861 §7:
//   [0]     tag = 0x02 (CEA)
//   [1]     revision (>= 3)
//   [2]     dtd_offset (offset of first DTD in block, or 0)
//   [3]     bit flags (underscan / audio / YCbCr)
//   [4..dtd_offset-1] data-block collection (SVDs, VSDBs, HDR)
//   [dtd_offset..126] DTDs
//   [127]   checksum
//
// SVD (Short Video Descriptor) encodes VIC + native flag; VSDB
// (Vendor-Specific Data Block) carries HDMI 3D + HDR static metadata
// per HDMI 2.0 §8.3 / CTA-861-G §7.5.13.
//
// =============================================================================
// §3  DisplayID (BLOCK N)
// =============================================================================
//
// Structure per VESA DisplayID §5:
//   [0]     version
//   [1]     bytes_present
//   [2]     product_type
//   [3]     extension_count
//   [4..]   data blocks: type + revision + length + payload
//   [end-1] checksum (sum of [1..end-1] must be 0 mod 256)
//
// Types I..VII cover detailed timings (I/II/III), formula-based (V/VI),
// video-parameter blocks (IV) and range limits (VII).
//
// =============================================================================
// §4  CHECKSUM + REVISION DISCIPLINE
// =============================================================================
//
// Every block's checksum is asserted before any field is read from it.
// A block whose checksum does not sum to zero is refused with
// BAD_CHECKSUM; a block whose revision is below the parser's floor is
// refused with BAD_REVISION. Neither is silently repaired — an EDID
// that will not validate is one the panel emitted incorrectly and
// downstream logic MUST NOT assume any of its fields.
//
// =============================================================================
// §5  ONE WRITER OF THE STATE
// =============================================================================
//
// _edid_state (a 128-byte scratch mirror + parsed field cache) and
// _edid_stats are written only by helpers in this module.
// tools/build.sh confines relocations against each to
// `core/drivers/dpy/edid.o`.
//
// =============================================================================
// §6  ERROR CODES 0xFFFFF760..0xFFFFF76F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: topology 0xFFFFF770..7F;
// adjacent free band below: display_topology_channel 0xFFFFF750..5F).

module Edid = structure {

  pub let EDID_BLOCK_BYTES : u64 = 128

  // Base-block signature bytes.
  pub let EDID_HEADER_B0 : u64 = 0x00
  pub let EDID_HEADER_B1 : u64 = 0xFF
  pub let EDID_HEADER_B7 : u64 = 0x00

  // Extension tags (§2, §3).
  pub let EDID_EXT_TAG_CEA        : u64 = 0x02
  pub let EDID_EXT_TAG_DISPLAY_ID : u64 = 0x70

  // Revision floors.
  pub let EDID_BASE_MIN_MAJOR : u64 = 1
  pub let EDID_BASE_MIN_MINOR : u64 = 3
  pub let EDID_CEA_MIN_REV    : u64 = 3
  pub let EDID_DID_MIN_VER    : u64 = 0x12       // DisplayID v1.2

  // Failure taxonomy — 0xFFFFF760..0xFFFFF76F.
  pub let EDID_OK                : u64 = 0
  pub let EDID_BAD_ARG           : u64 = 0xFFFFF76F
  pub let EDID_BAD_HEADER        : u64 = 0xFFFFF76E
  pub let EDID_BAD_CHECKSUM      : u64 = 0xFFFFF76D
  pub let EDID_BAD_REVISION      : u64 = 0xFFFFF76C
  pub let EDID_BAD_BLOCK_NUM     : u64 = 0xFFFFF76B
  pub let EDID_BAD_EXT_TAG       : u64 = 0xFFFFF76A
  pub let EDID_BAD_DTD_INDEX     : u64 = 0xFFFFF769
  pub let EDID_NOT_READ          : u64 = 0xFFFFF768
  pub let EDID_DEFERRED_HARDWARE : u64 = 0xFFFFF767

  pub let EDID_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // 128 bytes = 16 words for the scratch mirror; 4 words for parsed cache.
  pub let mut _edid_state : [u64; 24] = uninit @align(64)
  pub let mut _edid_stats : [u64; 8]  = uninit @align(64)

  // Parsed-cache layout in _edid_state[16..23]:
  //   [16]  bound flag (1 iff a base block has been parsed)
  //   [17]  manufacturer_id (u16)
  //   [18]  product_code (u16)
  //   [19]  edid_hash (u32) — CRC-like over base block
  //   [20]  ext_count (u8)
  //   [21]  base_major, base_minor, cea_rev, did_ver (packed 4x u8)
  //   [22]  reserved
  //   [23]  reserved

  pub let EDID_ST_READS      : u64 = 0
  pub let EDID_ST_PARSES     : u64 = 1
  pub let EDID_ST_CEA_PARSES : u64 = 2
  pub let EDID_ST_DID_PARSES : u64 = 3
  pub let EDID_ST_REFUSED    : u64 = 4

  pub let edid_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): clear scratch, parsed cache, and stats. Boot and teardown. Labels prefixed edid_rs_.",
      block: {
        lea r10, [rip + _edid_state];
        xor rax, rax;
        xor rcx, rcx;
      edid_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 24;
        jb  edid_rs_state;

        lea r10, [rip + _edid_stats];
        xor rcx, rcx;
      edid_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  edid_rs_stats;
        ret
      }
    } @no_frame

  pub let edid_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M2-002 (#1240): honesty pin. 0 until the read seam is bound to real DDC.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let edid_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): counter read. Labels prefixed edid_st_.",
      block: {
        cmp rdi, 8;
        jae edid_st_zero;
        lea r10, [rip + _edid_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      edid_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let edid_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): counter bump. Labels prefixed edid_nt_.",
      block: {
        cmp rdi, 8;
        jae edid_nt_out;
        lea r10, [rip + _edid_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      edid_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // edid_checksum_ok(base_ptr) -> 1 | 0
  //
  // Sums 128 bytes at base_ptr; returns 1 iff sum & 0xFF == 0.
  // ==========================================================================

  pub let edid_checksum_ok : (u64) -> u64 !{mem} @{} =
    fn (base_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): sum 128 bytes at base_ptr; 1 iff (sum & 0xFF) == 0. Refused on null base_ptr. Labels prefixed edid_ck_.",
      block: {
        cmp rdi, 0;
        je  edid_ck_no;

        xor rax, rax;
        xor rcx, rcx;
      edid_ck_loop:
        cmp rcx, 128;
        jae edid_ck_check;
        mov r10, [rdi + rcx * 1];
        and r10, 0xFF;
        add rax, r10;
        add rcx, 1;
        jmp edid_ck_loop;

      edid_ck_check:
        and rax, 0xFF;
        cmp rax, 0;
        jne edid_ck_no;
        mov rax, 1;
        ret;

      edid_ck_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // edid_header_ok(base_ptr) -> 1 | 0
  //
  // Header bytes must be 00 FF FF FF FF FF FF 00.
  // ==========================================================================

  pub let edid_header_ok : (u64) -> u64 !{mem} @{} =
    fn (base_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): 1 iff bytes [0..7] == {0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00}. Refused on null. Labels prefixed edid_hk_.",
      block: {
        cmp rdi, 0;
        je  edid_hk_no;

        mov rax, [rdi + 0];
        and rax, 0xFF;
        cmp rax, 0;
        jne edid_hk_no;
        mov rax, [rdi + 7];
        and rax, 0xFF;
        cmp rax, 0;
        jne edid_hk_no;

        mov rcx, 1;
      edid_hk_loop:
        cmp rcx, 7;
        jae edid_hk_yes;
        mov rax, [rdi + rcx * 1];
        and rax, 0xFF;
        cmp rax, 0xFF;
        jne edid_hk_no;
        add rcx, 1;
        jmp edid_hk_loop;

      edid_hk_yes:
        mov rax, 1;
        ret;
      edid_hk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // edid_hash_compute(base_ptr) -> u32
  //
  // Compute a 32-bit rolling hash over the 128 bytes. Used as the
  // edid_hash field of KIND_DISPLAY_OUTPUT. Not a CRC — a simple
  // Fletcher-style rolling sum sufficient to detect a panel swap.
  // ==========================================================================

  pub let edid_hash_compute : (u64) -> u64 !{mem} @{} =
    fn (base_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): Fletcher-style 32-bit rolling sum over 128 bytes. Not a CRC; sufficient to detect panel swaps. 0 on null base_ptr. Labels prefixed edid_hc_.",
      block: {
        cmp rdi, 0;
        je  edid_hc_zero;

        xor rax, rax;                    // acc_a
        xor r8,  r8;                     // acc_b
        xor rcx, rcx;
      edid_hc_loop:
        cmp rcx, 128;
        jae edid_hc_out;
        mov r10, [rdi + rcx * 1];
        and r10, 0xFF;
        add rax, r10;
        mov r10, 65535;
        cmp rax, r10;
        jbe edid_hc_a_ok;
        sub rax, r10;
        sub rax, 1;
      edid_hc_a_ok:
        add r8, rax;
        cmp r8, r10;
        jbe edid_hc_b_ok;
        sub r8, r10;
        sub r8, 1;
      edid_hc_b_ok:
        add rcx, 1;
        jmp edid_hc_loop;

      edid_hc_out:
        shl r8, 16;
        or  rax, r8;
        ret;

      edid_hc_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // edid_parse_base(base_ptr) -> code
  //
  // Validate header + checksum + revision; extract manufacturer/product;
  // count DTDs; record ext_count. Populates the parsed-field cache.
  //
  // ARITY ONE. Every gate refuses rather than repairs.
  // ==========================================================================

  pub let edid_parse_base : (u64) -> u64 !{mem} @{} =
    fn (base_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): parse a base EDID block. Sequence: null check; header signature (BAD_HEADER); checksum (BAD_CHECKSUM); revision floor 1.3 (BAD_REVISION); extract manufacturer[8..9], product[10..11], ext_count[126]. Records cache in _edid_state[16..23]. Labels prefixed edid_pb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;

        cmp rbx, 0;
        je  edid_pb_bad_arg;

        mov rdi, rbx;
        call edid_header_ok;
        cmp rax, 0;
        je  edid_pb_bad_header;

        mov rdi, rbx;
        call edid_checksum_ok;
        cmp rax, 0;
        je  edid_pb_bad_checksum;

        // Revision: [18] major, [19] minor. Require major >= 1 and
        // if major == 1 then minor >= 3.
        mov r12, [rbx + 18];
        and r12, 0xFF;
        mov r13, [rbx + 19];
        and r13, 0xFF;
        cmp r12, 1;
        jb  edid_pb_bad_rev;
        cmp r12, 1;
        jne edid_pb_rev_ok;
        cmp r13, 3;
        jb  edid_pb_bad_rev;

      edid_pb_rev_ok:
        // Compute hash first (call clobbers r10/r11) then load
        // remaining fields directly from the fixture with rbx (which
        // is callee-saved) into the state table.
        mov rdi, rbx;
        call edid_hash_compute;
        mov r14, rax;                    // save hash in r14 (callee-saved)

        lea rdi, [rip + _edid_state];
        mov rcx, 1;
        mov [rdi + 128], rcx;            // bound

        // Manufacturer id BE u16 from [rbx + 8..9].
        mov rax, [rbx + 8];
        and rax, 0xFF;
        shl rax, 8;
        mov r10, [rbx + 9];
        and r10, 0xFF;
        or  rax, r10;
        mov [rdi + 136], rax;            // manuf

        // Product code LE u16 from [rbx + 10..11].
        mov rax, [rbx + 11];
        and rax, 0xFF;
        shl rax, 8;
        mov r10, [rbx + 10];
        and r10, 0xFF;
        or  rax, r10;
        mov [rdi + 144], rax;            // product

        // Hash.
        mov [rdi + 152], r14;

        // ext_count [126].
        mov rax, [rbx + 126];
        and rax, 0xFF;
        mov [rdi + 160], rax;

        // Pack revs at +168: major | (minor << 8).
        mov rcx, r12;
        and rcx, 0xFF;
        mov r8, r13;
        and r8, 0xFF;
        shl r8, 8;
        or  rcx, r8;
        mov [rdi + 168], rcx;

        mov rdi, 1;
        call edid_note;                  // PARSES
        xor rax, rax;
        jmp edid_pb_out;

      edid_pb_bad_arg:
        mov rax, 0xFFFFF76F;
        jmp edid_pb_out;
      edid_pb_bad_header:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76E;
        jmp edid_pb_out;
      edid_pb_bad_checksum:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76D;
        jmp edid_pb_out;
      edid_pb_bad_rev:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76C;

      edid_pb_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let edid_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): 1 iff a base block has been parsed. Labels prefixed edid_bd_.",
      block: {
        lea r10, [rip + _edid_state];
        mov rax, [r10 + 128];
        ret
      }
    } @no_frame

  pub let edid_manufacturer : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): cached manufacturer id or DECODE_BAD. Labels prefixed edid_mf_.",
      block: {
        lea r10, [rip + _edid_state];
        mov rax, [r10 + 128];
        cmp rax, 0;
        je  edid_mf_bad;
        mov rax, [r10 + 136];
        ret;
      edid_mf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let edid_product : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): cached product code or DECODE_BAD. Labels prefixed edid_pd_.",
      block: {
        lea r10, [rip + _edid_state];
        mov rax, [r10 + 128];
        cmp rax, 0;
        je  edid_pd_bad;
        mov rax, [r10 + 144];
        ret;
      edid_pd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let edid_hash : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): cached hash or 0. Labels prefixed edid_hh_.",
      block: {
        lea r10, [rip + _edid_state];
        mov rax, [r10 + 128];
        cmp rax, 0;
        je  edid_hh_zero;
        mov rax, [r10 + 152];
        ret;
      edid_hh_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let edid_ext_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): cached extension-block count or 0. Labels prefixed edid_ec_.",
      block: {
        lea r10, [rip + _edid_state];
        mov rax, [r10 + 128];
        cmp rax, 0;
        je  edid_ec_zero;
        mov rax, [r10 + 160];
        ret;
      edid_ec_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // edid_parse_cea(ext_ptr) -> code
  //
  // Parse a CEA-861 extension block. Gates checksum + tag (0x02) +
  // revision (>= 3). Body walk (SVDs / VSDBs / HDR) is a bounded loop
  // over data-block collection; deferred to a later round.
  // ==========================================================================

  pub let edid_parse_cea : (u64) -> u64 !{mem} @{} =
    fn (ext_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): parse a CEA-861 extension. Sequence: null; checksum (BAD_CHECKSUM); tag 0x02 (BAD_EXT_TAG); revision >= 3 (BAD_REVISION). Body walk deferred. Labels prefixed edid_pc_.",
      block: {
        push rbx;
        mov rbx, rdi;

        cmp rbx, 0;
        je  edid_pc_bad_arg;

        mov rdi, rbx;
        call edid_checksum_ok;
        cmp rax, 0;
        je  edid_pc_bad_checksum;

        mov rax, [rbx + 0];
        and rax, 0xFF;
        cmp rax, 0x02;
        jne edid_pc_bad_tag;

        mov rax, [rbx + 1];
        and rax, 0xFF;
        cmp rax, 3;
        jb  edid_pc_bad_rev;

        // Cache CEA rev in state[168] byte 2.
        lea r10, [rip + _edid_state];
        mov rcx, [r10 + 168];
        and rcx, 0xFFFFFFFFFFFF00FF;
        mov r8, [rbx + 1];
        and r8, 0xFF;
        shl r8, 16;
        or  rcx, r8;
        mov [r10 + 168], rcx;

        mov rdi, 2;
        call edid_note;                  // CEA_PARSES
        xor rax, rax;
        pop rbx;
        ret;

      edid_pc_bad_arg:
        mov rax, 0xFFFFF76F;
        pop rbx;
        ret;
      edid_pc_bad_checksum:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76D;
        pop rbx;
        ret;
      edid_pc_bad_tag:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76A;
        pop rbx;
        ret;
      edid_pc_bad_rev:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76C;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // edid_parse_displayid(ext_ptr) -> code
  //
  // Parse a DisplayID block. Gates checksum + tag (0x70) + version
  // (>= 0x12). Timing-block walk deferred.
  // ==========================================================================

  pub let edid_parse_displayid : (u64) -> u64 !{mem} @{} =
    fn (ext_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): parse a DisplayID block. Sequence: null; checksum (BAD_CHECKSUM); tag 0x70 (BAD_EXT_TAG); version >= 0x12 (BAD_REVISION). Timing-block walk deferred. Labels prefixed edid_pd2_.",
      block: {
        push rbx;
        mov rbx, rdi;

        cmp rbx, 0;
        je  edid_pd2_bad_arg;

        mov rdi, rbx;
        call edid_checksum_ok;
        cmp rax, 0;
        je  edid_pd2_bad_checksum;

        mov rax, [rbx + 0];
        and rax, 0xFF;
        cmp rax, 0x70;
        jne edid_pd2_bad_tag;

        mov rax, [rbx + 1];
        and rax, 0xFF;
        cmp rax, 0x12;
        jb  edid_pd2_bad_rev;

        mov rdi, 3;
        call edid_note;                  // DID_PARSES
        xor rax, rax;
        pop rbx;
        ret;

      edid_pd2_bad_arg:
        mov rax, 0xFFFFF76F;
        pop rbx;
        ret;
      edid_pd2_bad_checksum:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76D;
        pop rbx;
        ret;
      edid_pd2_bad_tag:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76A;
        pop rbx;
        ret;
      edid_pd2_bad_rev:
        mov rdi, 4;
        call edid_note;
        mov rax, 0xFFFFF76C;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // edid_read_block(port, block_num, dst_ptr) -> code
  //
  // Read one EDID block via DDC. Seam-backed: returns
  // DEFERRED_HARDWARE today.
  // ==========================================================================

  pub let edid_read_block : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (port: u64) (block_num: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M2-002 (#1240): DDC read. Gates: port <= 7 (BAD_ARG); block_num <= 255 (BAD_BLOCK_NUM); dst_ptr non-null (BAD_ARG). Bumps READS on success; returns DEFERRED_HARDWARE. Labels prefixed edid_rd_.",
      block: {
        cmp rdi, 7;
        ja  edid_rd_bad_arg;
        cmp rsi, 0xFF;
        ja  edid_rd_bad_block;
        cmp rdx, 0;
        je  edid_rd_bad_arg;

        push rdi;
        mov rdi, 0;
        call edid_note;                  // READS
        pop rdi;
        mov rax, 0xFFFFF767;             // DEFERRED_HARDWARE
        ret;

      edid_rd_bad_arg:
        mov rax, 0xFFFFF76F;
        ret;
      edid_rd_bad_block:
        mov rax, 0xFFFFF76B;
        ret
      }
    }
}
