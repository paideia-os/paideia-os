// src/kernel/core/drivers/dpy/vrr.pdx -- G1.M2-001 (#1432) +
// G1.M2-004 (#1435)
//
// VRR capability probe (from DPCD 0x00080 + EDID range descriptor)
// and adaptive-sync arming on the modeset transaction. Both live
// in the same driver file so tools/build.sh can pin the (probe,
// arm) pair as the two writers of _vrr_range_table (through the
// KIND_VRR_RANGE mint) plus the arming state cell.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the display substrate calls to (1) synthesize the
// (min_refresh_mhz, max_refresh_mhz) pair from a panel's DPCD and
// EDID advertisements and mint a KIND_VRR_RANGE, and (2) accept
// a VRR opt-in on an atomic modeset transaction (arm the pipe for
// adaptive-sync SDP emission on COMMIT).
//
// It is NOT the DPCD reader (that lives in the DPAUX transport
// substrate, which today is a stub -- iris_xe_probe returns synth
// values -- and will be the real reader in R38+), NOT the EDID
// parser (that lives in drivers/dpy/edid.pdx and already exists),
// NOT the pipe programmer (that lives in drivers/dpy/atomic_commit
// .pdx). The three seams are called in sequence by
// vrr_capability_probe.
//
// =============================================================================
// SECTION 1  DPCD 0x00080 (DP §3.5.2.6 Adaptive-Sync SDP)
// =============================================================================
//
// The DP standard advertises adaptive-sync capability at DPCD
// register 0x00080 (bit 6 of DPCD_EDP_GENERAL_CAP_1). If the bit
// is set, DPCD 0x00081..0x00082 carry the (min_refresh_mhz,
// max_refresh_mhz) advertised range in raw hex (each field is a
// u16 in units of Hz -- we multiply by 1000 to get mHz).
//
// The probe DOES NOT read DPCD directly in this milestone: the
// DPAUX transport is a stub. It accepts probed values from an
// upstream driver (real in R38+) and validates them against the
// EDID range descriptor. Divergence between the two sources is a
// firmware inconsistency and refused rather than silently trusting
// one over the other.
//
// =============================================================================
// SECTION 2  EDID RANGE DESCRIPTOR (E-EDID §3.10.3.5.6)
// =============================================================================
//
// EDID descriptor block 0xFD carries the panel's supported refresh
// range in Hz (integer-only), pixel-clock cap in 10 MHz units, and
// GTF/CVT support flags. drivers/dpy/edid.pdx already parses this;
// the VRR probe reads (min_hz, max_hz) from the descriptor and
// cross-checks against the DPCD advertisement.
//
// =============================================================================
// SECTION 3  ADAPTIVE-SYNC ARMING (G1.M2-004 #1435)
// =============================================================================
//
// A modeset transaction that names a KIND_VRR_RANGE cap opts into
// adaptive-sync: on COMMIT, atomic_commit programs the pipe's SDP
// (Secondary Data Packet) block to emit Adaptive-Sync SDPs at the
// panel's cadence. The arming is a per-output boolean, stashed in
// _vrr_armed_bits, one bit per DDI (up to 16 DDIs, fits u16).
//
// The arming is done at MODESET COMMIT time; the disarm happens
// at MODESET ABORT or the next non-VRR modeset. atomic_commit
// consults _vrr_armed_bits before deciding whether to emit the SDP.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFF660..0xFFFFF66F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band. Adjacent free band above: vrr_channel
// 0xFFFFF650..5F; adjacent used band below: vrr_range 0xFFFFF670..7F.

module DpyVrr = structure {

  pub let DPY_VRR_OK           : u64 = 0
  pub let DPY_VRR_NOT_ADAPTIVE : u64 = 0xFFFFF66F
  pub let DPY_VRR_RANGE_MISMATCH : u64 = 0xFFFFF66E
  pub let DPY_VRR_BAD_DDI      : u64 = 0xFFFFF66D
  pub let DPY_VRR_ALREADY_ARMED : u64 = 0xFFFFF66C
  pub let DPY_VRR_NOT_ARMED    : u64 = 0xFFFFF66B
  pub let DPY_VRR_MINT_FAILED  : u64 = 0xFFFFF66A
  pub let DPY_VRR_BAD_SOURCE   : u64 = 0xFFFFF669

  // Per-DDI arming bitmap. Bit i = 1 iff DDI i is armed for VRR.
  pub let mut _vrr_armed_bits : u64 = 0
  pub let mut _vrr_probe_stats : [u64; 4] = uninit @align(64)

  pub let DPY_VRR_ST_PROBES : u64 = 0
  pub let DPY_VRR_ST_ARMS   : u64 = 1
  pub let DPY_VRR_ST_DISARM : u64 = 2
  pub let DPY_VRR_ST_REJECT : u64 = 3

  pub let DPY_VRR_MAX_DDI : u64 = 16

  pub let dpy_vrr_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-001 (#1432) + G1.M2-004 (#1435): clear driver state + counters. Boot and teardown only. Labels prefixed dvr_rs_.",
      block: {
        lea r10, [rip + _vrr_armed_bits];
        xor rax, rax;
        mov [r10], rax;

        lea r10, [rip + _vrr_probe_stats];
        xor rcx, rcx;
      dvr_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dvr_rs_loop;
        ret
      }
    }

  pub let dpy_vrr_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-001 (#1432): counter bump. Labels prefixed dvrn_.",
      block: {
        cmp rdi, 4;
        jae dvrn_out;
        lea r10, [rip + _vrr_probe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dvrn_out:
        ret
      }
    }

  pub let dpy_vrr_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-001 (#1432): counter read.",
      block: {
        cmp rdi, 4;
        jae dvrs_zero;
        lea r10, [rip + _vrr_probe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dvrs_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dpy_vrr_probe_cross_check(dpcd_min_hz, dpcd_max_hz, edid_min_hz,
  //                          edid_max_hz) -> OK | RANGE_MISMATCH | NOT_ADAPTIVE
  //
  // The core of the probe. Cross-checks the DPCD-advertised range
  // against the EDID range descriptor. Both sources report Hz;
  // divergence beyond 1 Hz on either endpoint is a firmware
  // inconsistency and refused.
  //
  // dpcd_min_hz == 0 signals "DPCD did not advertise adaptive-sync"
  // and returns NOT_ADAPTIVE regardless of EDID (the standard is
  // that adaptive-sync capability lives on the DPCD register; EDID
  // range descriptors exist for CRT-era refresh advertisements too).
  // ==========================================================================
  pub let dpy_vrr_probe_cross_check : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dpcd_min_hz: u64) (dpcd_max_hz: u64) (edid_min_hz: u64) (edid_max_hz: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-001 (#1432): cross-check DPCD-advertised range against EDID range descriptor. dpcd_min_hz==0 -> NOT_ADAPTIVE. Any divergence > 1 Hz on either endpoint -> RANGE_MISMATCH. Bumps DPY_VRR_ST_PROBES or DPY_VRR_ST_REJECT. Labels prefixed dvrx_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // dpcd_min_hz
        mov r13, rsi;                    // dpcd_max_hz
        mov rbx, rdx;                    // edid_min_hz

        cmp r12, 0;
        je  dvrx_not_adapt;

        // |dpcd_min - edid_min| <= 1, computed as max-min branch.
        mov rax, r12;
        cmp r12, rbx;
        jae dvrx_min_ge;
        mov rax, rbx;
        sub rax, r12;
        jmp dvrx_min_test;
      dvrx_min_ge:
        sub rax, rbx;
      dvrx_min_test:
        cmp rax, 1;
        ja  dvrx_mismatch;

        // |dpcd_max - edid_max| <= 1, same shape.
        mov rax, r13;
        cmp r13, rcx;
        jae dvrx_max_ge;
        mov rax, rcx;
        sub rax, r13;
        jmp dvrx_max_test;
      dvrx_max_ge:
        sub rax, rcx;
      dvrx_max_test:
        cmp rax, 1;
        ja  dvrx_mismatch;

        mov rdi, 0;                      // DPY_VRR_ST_PROBES
        call dpy_vrr_note;

        xor rax, rax;
        jmp dvrx_out;

      dvrx_not_adapt:
        mov rdi, 3;                      // DPY_VRR_ST_REJECT
        call dpy_vrr_note;
        mov rax, 0xFFFFF66F;
        jmp dvrx_out;

      dvrx_mismatch:
        mov rdi, 3;
        call dpy_vrr_note;
        mov rax, 0xFFFFF66E;

      dvrx_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpy_vrr_ddi_valid(ddi) -> 1 | 0
  //
  // DDI id fits DPY_VRR_MAX_DDI (16 bits of the arming bitmap).
  // ==========================================================================
  pub let dpy_vrr_ddi_valid : (u64) -> u64 !{} @{} =
    fn (ddi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G1.M2-004 (#1435): 1 iff ddi < 16. Labels prefixed dvrdv_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae dvrdv_no;
        mov rax, 1;
        ret;
      dvrdv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dpy_vrr_arm(ddi) -> OK | BAD_DDI | ALREADY_ARMED
  //
  // Set the arming bit for one DDI. Called by atomic_commit on
  // COMMIT of a modeset transaction that named a KIND_VRR_RANGE
  // cap. Refuses if already armed -- a compositor must go through
  // disarm+arm to change the range (which is a policy on the mint).
  // ==========================================================================
  pub let dpy_vrr_arm : (u64) -> u64 !{mem} @{} =
    fn (ddi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-004 (#1435): set bit `ddi` in _vrr_armed_bits. Refuses ALREADY_ARMED. Bumps DPY_VRR_ST_ARMS on set. Labels prefixed dvra_.",
      block: {
        push r12;
        mov r12, rdi;

        call dpy_vrr_ddi_valid;
        cmp rax, 0;
        je  dvra_bad;

        lea r10, [rip + _vrr_armed_bits];
        mov rax, [r10];
        mov r11, 1;
        mov rcx, r12;
        shl r11, cl;
        test rax, r11;
        jnz dvra_already;
        or  rax, r11;
        mov [r10], rax;

        mov rdi, 1;                      // DPY_VRR_ST_ARMS
        call dpy_vrr_note;

        xor rax, rax;
        jmp dvra_out;

      dvra_bad:
        mov rax, 0xFFFFF66D;
        jmp dvra_out;
      dvra_already:
        mov rax, 0xFFFFF66C;

      dvra_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // dpy_vrr_disarm(ddi) -> OK | BAD_DDI | NOT_ARMED
  //
  // Clear the arming bit for one DDI. Called by atomic_commit on
  // ABORT or on the next non-VRR modeset for the same DDI.
  // ==========================================================================
  pub let dpy_vrr_disarm : (u64) -> u64 !{mem} @{} =
    fn (ddi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-004 (#1435): clear bit `ddi` in _vrr_armed_bits. Refuses NOT_ARMED. Bumps DPY_VRR_ST_DISARM on clear. Labels prefixed dvrd_.",
      block: {
        push r12;
        mov r12, rdi;

        call dpy_vrr_ddi_valid;
        cmp rax, 0;
        je  dvrd_bad;

        lea r10, [rip + _vrr_armed_bits];
        mov rax, [r10];
        mov r11, 1;
        mov rcx, r12;
        shl r11, cl;
        test rax, r11;
        jz  dvrd_notarmed;
        not r11;
        and rax, r11;
        mov [r10], rax;

        mov rdi, 2;                      // DPY_VRR_ST_DISARM
        call dpy_vrr_note;

        xor rax, rax;
        jmp dvrd_out;

      dvrd_bad:
        mov rax, 0xFFFFF66D;
        jmp dvrd_out;
      dvrd_notarmed:
        mov rax, 0xFFFFF66B;

      dvrd_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // dpy_vrr_is_armed(ddi) -> 1 | 0
  //
  // atomic_commit consults this before deciding whether to emit
  // an Adaptive-Sync SDP for the pipe.
  // ==========================================================================
  pub let dpy_vrr_is_armed : (u64) -> u64 !{mem} @{} =
    fn (ddi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G1.M2-004 (#1435): 1 iff bit `ddi` set in _vrr_armed_bits. Returns 0 for BAD_DDI (arms cannot be set on those). Labels prefixed dvri_.",
      block: {
        push r12;
        mov r12, rdi;

        call dpy_vrr_ddi_valid;
        cmp rax, 0;
        je  dvri_no;

        lea r10, [rip + _vrr_armed_bits];
        mov rax, [r10];
        mov r11, 1;
        mov rcx, r12;
        shl r11, cl;
        test rax, r11;
        jz  dvri_no;
        mov rax, 1;
        jmp dvri_out;

      dvri_no:
        xor rax, rax;

      dvri_out:
        pop r12;
        ret
      }
    }
}
