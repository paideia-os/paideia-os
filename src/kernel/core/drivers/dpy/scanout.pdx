// src/kernel/core/drivers/dpy/scanout.pdx -- G2.M1-003..005 (#1445-#1447)
//                                            + G2.M2-001..004 (#1448-#1451)
//                                            + G2.M3-001..004 (#1453-#1456)
//
// Direct-scanout driver: the compositor-side grant / present / revoke
// / expiry seams that manipulate KIND_SCANOUT_LEASE row state and
// program the display plane. Also the format matrix, HDR metadata
// pass-through, and the tearing-prevention arbiter.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the scanout_lease_channel calls to (1) grant a
// direct-scanout lease against a plane/output/timeline triple,
// (2) present a buffer through that lease with a VRR frame-latch
// target, and (3) revoke the lease when another client takes
// foreground or when the expiry safety-net fires.
//
// It is NOT the plane programmer (that lives in
// drivers/dpy/plane_primary.pdx and plane_overlay.pdx), NOT the
// vblank/timeline signal path (drivers/dpy/timeline.pdx), NOT the
// mint gate (kind_scanout_lease.pdx). This module owns only the
// grant/revoke policy, the format matrix, the reserved-plane
// invariant, and the small state cells that back them.
//
// =============================================================================
// SECTION 1  GRANT POLICY (G2.M1-003 #1445)
// =============================================================================
//
// Grant algorithm:
//   (1) Refuse if plane_slot is reserved (P8 -- pipe 0 primary).
//   (2) Refuse if plane_slot already has a live lease (kind's
//       sl_find_by_plane).
//   (3) Find a free cap slot in the grant-slot pool (rows
//       SL_GRANT_SLOT_BASE .. SL_GRANT_SLOT_BASE + SL_MAX - 1).
//   (4) Mint KIND_SCANOUT_LEASE with (plane_slot, output_slot,
//       timeline_slot, expiry_ns).
//   (5) Audit the grant (mint_note + hpet timestamp).
//
// The grant-slot pool is a compile-time constant range; a real
// compositor supplies the slot from its own cap_table view when the
// R44 GUI wires this in (deferred to G3 per softarch §4 G3).
//
// =============================================================================
// SECTION 2  FORMAT MATRIX (G2.M2-003 #1450)
// =============================================================================
//
// Which KIND_GPU_BO formats can go direct-scanout on which output?
// The matrix is a static table indexed by (format, output_kind) --
// primary planes on eDP admit XRGB8888 + RGBA8888 + NV12 (video
// overlay), overlay planes admit YUYV/P010 for HDR video, cursor
// admits RGBA8888 only. A format outside the admitted set for a
// given output returns SCN_BAD_FORMAT rather than falling back to
// composited path, so an operator debugging a rejected direct-scanout
// sees which cell of the matrix refused rather than "silently
// composited".
//
// =============================================================================
// SECTION 3  HDR METADATA PASS-THROUGH (G2.M2-004 #1451)
// =============================================================================
//
// A direct-scanout lease that names an HDR-capable output may attach
// HDR10 static metadata (max_cll, max_fall, mastering primaries) to
// each present. The metadata is a per-present record kept in
// _scanout_hdr_pending until the vblank latches it into the pipe's
// SDP block; this bridges to G6 (color pipeline) where the full
// tone-mapping seam lands.
//
// =============================================================================
// SECTION 4  VRR FRAME-LATCH (G2.M2-001 #1448) + TEARING PREVENTION
// (G2.M2-002 #1449)
// =============================================================================
//
// Under VRR, the per-frame timeline value IS the target scanout
// value. scanout_present's target_value arg is written to the
// display timeline row's next_latch cell; the vblank ISR reads it
// and only latches the buffer when the current scanout advances to
// >= target_value. This gives per-frame VRR without double
// buffering: at most ONE buffer is in flight per lease, enforced by
// _scanout_in_flight[lease_row] being a single-slot lock.
//
// =============================================================================
// SECTION 5  RESERVED PLANE (P8, G2.M1-005 #1447)
// =============================================================================
//
// Pipe 0's primary plane is reserved for the recovery console. The
// scanout_grant seam refuses any plane_slot equal to
// SL_RESERVED_PLANE_SLOT (a hard constant in kind_scanout_lease.pdx).
// The refusal is documented in the row-table's SL_MINT_RESERVED
// (0xFFFFF615) so an operator inspecting the code sees the P8 rule
// as the refuser rather than a generic BAD_PLANE.
//
// =============================================================================
// SECTION 6  EXPIRY + FALLBACK (G2.M3-001 #1453, G2.M3-002 #1454)
// =============================================================================
//
// The compositor calls scanout_expiry_sweep(hpet_now_ns) periodically
// (from the same frame-loop tick that reads present-feedback). Any
// live lease whose lease_ns_expiry <= hpet_now_ns transitions to
// SL_STATE_EXPIRED, and the driver:
//   (a) programs the plane back to the compositor's own framebuffer
//       (the "fallback path"),
//   (b) audits the expiry.
// The client can no longer present against the lease; its next
// scanout_present returns SLC_NOT_GRANTED and the compositor is
// visually restored.
//
// =============================================================================
// SECTION 7  FAILURE TAXONOMY 0xFFFFF631..0xFFFFF638 (SHARED SUB-BAND)
// =============================================================================
//
// Shared with drivers/gpu/bo_alloc.pdx (which owns
// 0xFFFFF639..0xFFFFF63F + 0xFFFFF630 as its band-declaration
// markers). Scanout takes 0xFFFFF631..0xFFFFF638 -- see
// kind_scanout_lease.pdx §4 for the shared-band pattern.

module Scanout = structure {

  pub let SCN_OK              : u64 = 0
  pub let SCN_ALREADY_LEASED  : u64 = 0xFFFFF638
  pub let SCN_ENOSPC          : u64 = 0xFFFFF637
  pub let SCN_BAD_FORMAT      : u64 = 0xFFFFF636
  pub let SCN_BAD_HDR         : u64 = 0xFFFFF635
  pub let SCN_NOT_GRANTED     : u64 = 0xFFFFF634
  pub let SCN_IN_FLIGHT       : u64 = 0xFFFFF633
  pub let SCN_MINT_FAILED     : u64 = 0xFFFFF632
  pub let SCN_BAD_ARG         : u64 = 0xFFFFF631

  // Grant-slot pool: contiguous cap-table range used to hold minted
  // KIND_SCANOUT_LEASE caps. Real compositor supplies caller-owned
  // slots; this pool exists so the boot witness has somewhere to
  // exercise the grant path.
  pub let SL_GRANT_SLOT_BASE : u64 = 232
  pub let SL_GRANT_SLOT_LAST : u64 = 239                 // BASE + SL_MAX - 1

  // Format matrix.  Format ordinals as in kind_display_plane.pdx.
  pub let SCN_FMT_XRGB8888 : u64 = 0
  pub let SCN_FMT_NV12     : u64 = 1
  pub let SCN_FMT_YUYV     : u64 = 2
  pub let SCN_FMT_RGBA8888 : u64 = 3
  pub let SCN_FMT_P010     : u64 = 4
  pub let SCN_FMT_MAX      : u64 = 4

  // Output-kind ordinals (small enumeration; real output-kind lives
  // in KIND_DISPLAY_OUTPUT row).
  pub let SCN_OUT_EDP  : u64 = 0
  pub let SCN_OUT_DP   : u64 = 1
  pub let SCN_OUT_HDMI : u64 = 2
  pub let SCN_OUT_MAX  : u64 = 2

  // Plane-class ordinals.
  pub let SCN_PLANE_PRIMARY : u64 = 0
  pub let SCN_PLANE_OVERLAY : u64 = 1
  pub let SCN_PLANE_CURSOR  : u64 = 2

  // HDR metadata (per-present, stashed until vblank latches).
  //   [+0] u64: max_cll[15:0] | max_fall[31:16] | flags[63:32]
  //   [+8] u64: mastering primary R.x + primary R.y (packed q16)
  // The rest of the metadata is deferred to G6.
  pub let mut _scanout_hdr_pending : [u64; 16] = uninit @align(64)   // 8 rows * 16 bytes

  // In-flight tracker: one slot per lease row, non-zero iff a present
  // is pending vblank-latch. Enforces the single-buffer discipline
  // (G2.M2-002 #1449).
  pub let mut _scanout_in_flight : [u64; 8] = uninit @align(64)

  // Counters. Confined to this object.
  pub let mut _scanout_stats : [u64; 8] = uninit @align(64)

  pub let SCN_ST_GRANTS       : u64 = 0
  pub let SCN_ST_REVOKES      : u64 = 1
  pub let SCN_ST_PRESENTS     : u64 = 2
  pub let SCN_ST_EXPIRIES     : u64 = 3
  pub let SCN_ST_REFUSED      : u64 = 4
  pub let SCN_ST_FALLBACKS    : u64 = 5
  pub let SCN_ST_HDR_ATTACHED : u64 = 6
  pub let SCN_ST_RESERVED_HIT : u64 = 7

  pub let scanout_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-003 (#1445): clear scanout driver state + counters. Boot and teardown only. Labels prefixed scn_rs_.",
      block: {
        lea r10, [rip + _scanout_stats];
        xor rax, rax;
        xor rcx, rcx;
      scn_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  scn_rs_stats;

        lea r10, [rip + _scanout_in_flight];
        xor rcx, rcx;
      scn_rs_infl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  scn_rs_infl;

        lea r10, [rip + _scanout_hdr_pending];
        xor rcx, rcx;
      scn_rs_hdr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  scn_rs_hdr;
        ret
      }
    }

  pub let scanout_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-003 (#1445): counter bump. Labels prefixed scnn_.",
      block: {
        cmp rdi, 8;
        jae scnn_out;
        lea r10, [rip + _scanout_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      scnn_out:
        ret
      }
    }

  pub let scanout_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M1-003 (#1445): counter read.",
      block: {
        cmp rdi, 8;
        jae scns_zero;
        lea r10, [rip + _scanout_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      scns_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // scanout_format_admits(format, output_kind, plane_class) -> 1 | 0
  //
  // The format matrix (G2.M2-003 #1450). Each cell answers "may a
  // buffer with this format go direct-scanout to a plane of this
  // class on an output of this kind?"
  //
  //   primary  eDP:   XRGB8888, RGBA8888, NV12
  //   primary  DP:    XRGB8888, RGBA8888, NV12, P010
  //   primary  HDMI:  XRGB8888, RGBA8888, NV12
  //   overlay  any:   YUYV, P010, NV12
  //   cursor   any:   RGBA8888
  //
  // The matrix is compact enough to encode as a branch chain; a
  // future R44+ change may replace it with a bitmap once the format
  // set grows.
  // ==========================================================================
  pub let scanout_format_admits : (u64, u64, u64) -> u64 !{} @{} =
    fn (format: u64) (output_kind: u64) (plane_class: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G2.M2-003 (#1450): per-output, per-plane-class format-admits matrix. Returns 1 iff the (format, output, class) triple is in the direct-scanout set; 0 otherwise. Labels prefixed scnfm_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // format
        mov r12, rsi;                    // output_kind
        mov r13, rdx;                    // plane_class

        cmp rbx, 4;
        ja  scnfm_no;
        cmp r12, 2;
        ja  scnfm_no;
        cmp r13, 2;
        ja  scnfm_no;

        cmp r13, 2;                      // CURSOR
        je  scnfm_cursor;
        cmp r13, 1;                      // OVERLAY
        je  scnfm_overlay;
        // PRIMARY.
        cmp rbx, 0;                      // XRGB8888 admitted on any output
        je  scnfm_yes;
        cmp rbx, 3;                      // RGBA8888 admitted on any output
        je  scnfm_yes;
        cmp rbx, 1;                      // NV12 admitted on any output primary
        je  scnfm_yes;
        cmp rbx, 4;                      // P010 admitted only on DP primary
        jne scnfm_no;
        cmp r12, 1;
        jne scnfm_no;
        jmp scnfm_yes;

      scnfm_overlay:
        cmp rbx, 2;                      // YUYV
        je  scnfm_yes;
        cmp rbx, 4;                      // P010
        je  scnfm_yes;
        cmp rbx, 1;                      // NV12
        je  scnfm_yes;
        jmp scnfm_no;

      scnfm_cursor:
        cmp rbx, 3;                      // RGBA8888 only
        jne scnfm_no;

      scnfm_yes:
        mov rax, 1;
        jmp scnfm_out;
      scnfm_no:
        xor rax, rax;

      scnfm_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // scanout_grant(plane_slot, output_slot, timeline_slot, expiry_ns)
  //     -> lease_slot | err
  //
  // The compositor-side grant seam. Enforces P8 (reserved plane),
  // per-plane linear ownership, mints the KIND_SCANOUT_LEASE, and
  // audits the grant. Returns the cap_table slot the freshly minted
  // lease occupies.
  // ==========================================================================
  pub let scanout_grant : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (plane_slot: u64) (output_slot: u64) (timeline_slot: u64) (expiry_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-003 (#1445) + G2.M1-005 (#1447): grant a direct-scanout lease. Sequence: reserved-plane refuse (P8, via kind's sl_reserved_plane); per-plane linear check (sl_find_by_plane); free-slot search in [SL_GRANT_SLOT_BASE, SL_GRANT_SLOT_LAST]; sl_cap_mint_inner. Labels prefixed scng_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // plane_slot
        mov r13, rsi;                    // output_slot
        mov r14, rdx;                    // timeline_slot
        mov r15, rcx;                    // expiry_ns

        // P8: refuse reserved plane. Bumps a dedicated counter so a
        // witness can prove the refusal path fired.
        mov rdi, r12;
        call sl_reserved_plane;
        cmp rax, 1;
        jne scng_not_reserved;
        mov rdi, 7;                      // SCN_ST_RESERVED_HIT
        call scanout_note;
        mov rdi, 4;                      // SCN_ST_REFUSED
        call scanout_note;
        mov rax, 0xFFFFF615;
        jmp scng_out;
      scng_not_reserved:

        // Per-plane linear check.
        mov rdi, r12;
        call sl_find_by_plane;
        cmp rax, 0xFF;
        jne scng_leased;

        // Free-slot search in the grant pool.
        mov rbx, 232;                    // SL_GRANT_SLOT_BASE
      scng_scan:
        cmp rbx, 240;                    // BASE + SL_MAX
        jae scng_enospc;
        lea rax, [rip + cap_table];
        mov r8, rbx;
        shl r8, 3;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r10, [rax + 0];
        cmp r10, 0;
        je  scng_claim;
        add rbx, 1;
        jmp scng_scan;

      scng_claim:
        // Pack slots into packed_slots u64: output[7:0] |
        // timeline[15:8] | plane[47:32].
        mov rbp, r13;
        and rbp, 0xFF;                   // output_slot
        mov r10, r14;
        and r10, 0xFF;
        shl r10, 8;
        or  rbp, r10;
        mov r10, r12;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rbp, r10;

        // Derive a lease_key from (plane_slot, hpet_now_ns) tick;
        // any non-zero value serves.  We use (plane_slot << 32) |
        // (row_id + 1) style key.
        mov r10, r12;
        shl r10, 32;
        or  r10, rbx;
        add r10, 1;                      // ensure non-zero

        mov rdi, rbx;                    // slot
        mov rsi, r12;                    // parent_slot = plane_slot
        mov rdx, 0x419;                  // rights = R_SL_ALL (leaf)
        mov rcx, r10;                    // lease_key
        mov r8, rbp;                     // packed_slots
        mov r9, r15;                     // expiry_ns
        call sl_cap_mint_inner;
        cmp rax, 0;
        jne scng_mint_failed;

        mov rdi, 0;                      // SCN_ST_GRANTS
        call scanout_note;
        mov rax, rbx;                    // return lease_slot
        jmp scng_out;

      scng_leased:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF638;
        jmp scng_out;
      scng_enospc:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF637;
        jmp scng_out;
      scng_mint_failed:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF632;

      scng_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // scanout_present(lease_slot, bo_slot, target_value) -> OK | err
  //
  // Direct-scanout present. Enforces:
  //   (1) lease is GRANTED (kind_scanout_lease.pdx state ordinal),
  //   (2) at most one buffer in-flight per lease (tearing prevention
  //       under VRR, G2.M2-002 #1449),
  //   (3) writes the target_value into the display timeline row
  //       (VRR frame-latch, G2.M2-001 #1448) via
  //       dpt_row_signal_target -- the vblank ISR reads it and
  //       latches when scanout reaches the target.
  //
  // The buffer itself is NOT copied here; the plane's next-buffer
  // register is programmed from bo_slot's KIND_GPU_BO row. That
  // seam lives in drivers/dpy/plane_primary.pdx and is called by
  // the vblank latch path.
  // ==========================================================================
  pub let scanout_present : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (lease_slot: u64) (bo_slot: u64) (target_value: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M2-001 (#1448) + G2.M2-002 (#1449): direct-scanout present. Resolves lease row, checks state == GRANTED, checks in-flight = 0, marks in-flight = target_value. The vblank ISR clears in-flight when scanout reaches target. Labels prefixed scnp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        call sl_row_of_slot;
        cmp rax, 0xFF;
        je  scnp_no_lease;
        mov rbx, rax;                    // row_id

        mov rdi, rbx;
        call sl_row_state;
        cmp rax, 1;                      // GRANTED
        jne scnp_not_granted;

        // At-most-one in-flight per lease.
        lea r10, [rip + _scanout_in_flight];
        mov rax, [r10 + rbx * 8];
        cmp rax, 0;
        jne scnp_inflight;

        // Arm the frame-latch: stash target_value in in-flight cell.
        cmp r14, 0;
        je  scnp_bad_arg;
        mov [r10 + rbx * 8], r14;

        mov rdi, 2;                      // SCN_ST_PRESENTS
        call scanout_note;
        xor rax, rax;
        jmp scnp_out;

      scnp_no_lease:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF631;
        jmp scnp_out;
      scnp_not_granted:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF634;
        jmp scnp_out;
      scnp_inflight:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF633;
        jmp scnp_out;
      scnp_bad_arg:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF631;

      scnp_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // scanout_latch(lease_row) -> ()
  //
  // Called by the vblank ISR when scanout reaches the target value.
  // Clears the in-flight cell so the next present may arm the latch.
  // Also the seam the ISR uses to know a present completed (the
  // return of an in-flight cell to zero is the latched-frame signal
  // the R44 GUI observes when it wires present-feedback).
  // ==========================================================================
  pub let scanout_latch : (u64) -> () !{mem} @{} =
    fn (lease_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M2-001 (#1448): clear _scanout_in_flight[lease_row] to signal the current frame latched. Labels prefixed scnl_.",
      block: {
        cmp rdi, 8;
        jae scnl_out;
        lea r10, [rip + _scanout_in_flight];
        xor rax, rax;
        mov [r10 + rdi * 8], rax;
      scnl_out:
        ret
      }
    }

  // ==========================================================================
  // scanout_hdr_attach(lease_row, max_cll, max_fall, flags) -> OK | err
  //
  // Attach HDR10 static metadata to a pending present (G2.M2-004
  // #1451). The compositor calls this AFTER scanout_present but
  // BEFORE the vblank latches; the metadata rides the same latch and
  // is written to the pipe's SDP block by the ISR. On an output that
  // does not advertise HDR-capable, returns SCN_BAD_HDR (the caller
  // is expected to fall back to tone-mapped composited path, wired
  // in G6).
  // ==========================================================================
  pub let scanout_hdr_attach : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (lease_row: u64) (max_cll: u64) (max_fall: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M2-004 (#1451): attach HDR10 static metadata to pending present. Refuses if lease_row invalid or max_cll/max_fall out of u16. Labels prefixed scnh_.",
      block: {
        push r12;
        mov r12, rdi;

        cmp r12, 8;
        jae scnh_bad;
        cmp rsi, 0xFFFF;
        ja  scnh_bad;
        cmp rdx, 0xFFFF;
        ja  scnh_bad;

        mov rdi, r12;
        call sl_tail_valid;
        cmp rax, 0;
        je  scnh_bad;

        // Pack row: max_cll[15:0] | max_fall[31:16] | flags[63:32].
        lea r10, [rip + _scanout_hdr_pending];
        mov r11, r12;
        shl r11, 4;                      // 16 bytes per row
        add r10, r11;
        mov rax, rsi;
        and rax, 0xFFFF;
        mov r11, rdx;
        and r11, 0xFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, rcx;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 0], rax;
        xor rax, rax;
        mov [r10 + 8], rax;              // primaries deferred to G6

        mov rdi, 6;                      // SCN_ST_HDR_ATTACHED
        call scanout_note;
        xor rax, rax;
        jmp scnh_out;

      scnh_bad:
        mov rax, 0xFFFFF635;

      scnh_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // scanout_revoke(lease_slot) -> OK | err
  //
  // The compositor-side revocation seam (G2.M1-004 #1446). Called
  // when another client comes to foreground, when the expiry sweep
  // fires, or when a channel-release event arrives. Transitions the
  // row to REVOKED, programs the plane back to the compositor's own
  // buffer (fallback, G2.M3-001 #1453), and bumps the counter.
  // ==========================================================================
  pub let scanout_revoke : (u64) -> u64 !{mem} @{cap} =
    fn (lease_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M1-004 (#1446) + G2.M3-001 (#1453): revoke a lease, transition to REVOKED, fall back to compositor buffer. Labels prefixed scnr_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call sl_row_of_slot;
        cmp rax, 0xFF;
        je  scnr_no_lease;
        mov rbx, rax;

        mov rdi, rbx;
        mov rsi, 2;                      // SL_STATE_REVOKED
        call sl_row_transition;
        cmp rax, 0;
        jne scnr_bad_txn;

        // Clear in-flight so a lingering present cannot fire after
        // revocation.
        mov rdi, rbx;
        call scanout_latch;

        // Fallback: bump the fallback counter; the actual plane
        // reprogramming lives in plane_primary.pdx and is called
        // from the vblank ISR the next tick.
        mov rdi, 5;                      // SCN_ST_FALLBACKS
        call scanout_note;

        mov rdi, 1;                      // SCN_ST_REVOKES
        call scanout_note;
        xor rax, rax;
        jmp scnr_out;

      scnr_no_lease:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF631;
        jmp scnr_out;
      scnr_bad_txn:
        mov rdi, 4;
        call scanout_note;
        mov rax, 0xFFFFF631;

      scnr_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // scanout_expiry_sweep(hpet_now_ns) -> u64 (count expired)
  //
  // Safety-net auto-revoke (G2.M3-002 #1454). Called from the
  // compositor frame-loop tick. Iterates every live lease row; any
  // row whose lease_ns_expiry <= hpet_now_ns is transitioned to
  // EXPIRED and the fallback path fires. Returns the count of
  // expired rows this tick.
  //
  // hpet_now_ns == 0 is treated as "no time" and skips the sweep;
  // that avoids a boot-time nonsense sweep before HPET is armed.
  // ==========================================================================
  pub let scanout_expiry_sweep : (u64) -> u64 !{mem} @{} =
    fn (hpet_now_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2.M3-002 (#1454): auto-revoke expired leases. Labels prefixed scne_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // hpet_now_ns
        cmp r12, 0;
        je  scne_none;

        xor rbx, rbx;                    // row_id
        xor r13, r13;                    // expired count

      scne_scan:
        cmp rbx, 8;
        jae scne_out;

        mov rdi, rbx;
        call sl_tail_valid;
        cmp rax, 0;
        je  scne_next;

        // Only GRANTED rows are candidates; already REVOKED /
        // EXPIRED are inert.
        mov rdi, rbx;
        call sl_row_state;
        cmp rax, 1;
        jne scne_next;

        mov rdi, rbx;
        call sl_row_expiry;
        cmp rax, r12;
        ja  scne_next;                   // expiry > now, not expired

        // Expired: transition + fallback + latch clear.
        mov rdi, rbx;
        mov rsi, 3;                      // SL_STATE_EXPIRED
        call sl_row_transition;

        mov rdi, rbx;
        call scanout_latch;

        mov rdi, 3;                      // SCN_ST_EXPIRIES
        call scanout_note;
        mov rdi, 5;                      // SCN_ST_FALLBACKS
        call scanout_note;

        add r13, 1;

      scne_next:
        add rbx, 1;
        jmp scne_scan;

      scne_none:
        xor r13, r13;

      scne_out:
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // scanout_default_for_fullscreen(plane_slot, output_slot,
  //                                timeline_slot) -> lease_slot | err
  //
  // The P7 acceptance path (G2.M3-004 #1456): direct-scanout is the
  // DEFAULT for fullscreen, not an opt-in. The compositor calls this
  // when a client goes fullscreen; internally it just calls
  // scanout_grant with a compositor-supplied "long enough" expiry
  // (5 seconds -- the safety-net still fires if the client hangs).
  // A fullscreen client that does NOT specifically REFUSE direct-
  // scanout gets it.
  //
  // The 5-second constant (5_000_000_000 ns) is codified here as
  // SCN_DEFAULT_EXPIRY_NS so an operator debugging expiry sees the
  // number rather than a naked literal in three places.
  // ==========================================================================
  pub let SCN_DEFAULT_EXPIRY_NS : u64 = 5000000000

  // ==========================================================================
  // scanout_arm_for_witness(row_id, target_value)
  // scanout_readback_for_witness(row_id) -> in_flight_value
  //
  // Witness-only seams. Used by the boot fixture in
  // tests/kernel/drivers/dpy/scanout_synth.pdx to poke / observe the
  // in-flight cell without opening a second-writer path -- this
  // module remains the sole writer of _scanout_in_flight, and the
  // build's ec_confine_one assertion on that symbol stays clean.
  // Neither seam is called by production paths.
  // ==========================================================================
  pub let scanout_arm_for_witness : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2 witness helper: set _scanout_in_flight[row_id] = val. Labels prefixed scnaw_.",
      block: {
        cmp rdi, 8;
        jae scnaw_out;
        lea r10, [rip + _scanout_in_flight];
        mov [r10 + rdi * 8], rsi;
      scnaw_out:
        ret
      }
    }

  pub let scanout_readback_for_witness : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G2 witness helper: read _scanout_in_flight[row_id]. Labels prefixed scnrw_.",
      block: {
        cmp rdi, 8;
        jae scnrw_none;
        lea r10, [rip + _scanout_in_flight];
        mov rax, [r10 + rdi * 8];
        ret;
      scnrw_none:
        xor rax, rax;
        ret
      }
    }

  pub let scanout_default_for_fullscreen : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (plane_slot: u64) (output_slot: u64) (timeline_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G2.M3-004 (#1456) + P7: direct-scanout by default for fullscreen. Just calls scanout_grant with SCN_DEFAULT_EXPIRY_NS. Labels prefixed scnd_.",
      block: {
        mov rcx, 5000000000;
        call scanout_grant;
        ret
      }
    }
}
