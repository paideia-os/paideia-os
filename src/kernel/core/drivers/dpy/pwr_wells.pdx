// src/kernel/core/drivers/dpy/pwr_wells.pdx — R36.M1-002 (#1236)
//
// Intel Iris Xe display engine power-wells + CDCLK setpoint driver
// scaffold. Power wells PG1 / PG2 / per-DDI per bspec §14; enable
// order PG1 -> PG2 -> per-DDI on demand; CDCLK setpoints per gen
// (300 / 500 / 540 / 650 MHz typical). MMIO registers PG_STATUS,
// CDCLK_CTL are read/written through a synthetic seam this
// milestone.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the STATE-MACHINE + SETPOINT half of an Iris Xe display
// bring-up. Every access to a DDI, a pipe, a plane, a transcoder
// or a DP link requires its power well to be enabled and its
// display clock to be at a valid setpoint per bspec §14; this
// scaffold's job is to gate those preconditions in one place.
//
// IT DOES NOT TOUCH REAL MMIO. PG_STATUS and CDCLK_CTL are read /
// written through a seam whose default backing is caller-supplied
// register snapshots.
//
// IT DOES NOT DECIDE WHICH DDI TO ENABLE. That is the display
// pipeline's authority; this scaffold answers "is DDI n's well up".
//
// pwr_wells_arbitrated() returns 0 until a later round binds this
// against a live MMIO window.
//
// =============================================================================
// §1  POWER-WELL ORDERING PER BSPEC §14
// =============================================================================
//
// PG1 is the sequencer / DMC / display-audio well. It powers up
// first and stays up as long as any pipe is enabled.
//
// PG2 is the pipe / transcoder / plane well. It comes up after PG1
// and stays up while any pipe drives output.
//
// Per-DDI wells (PG_DDI_A..PG_DDI_E) come up on demand when the
// pipeline claims a DDI; each is independent and idempotent.
//
// The enable order PG1 -> PG2 -> DDI is enforced by
// pwr_well_enable: a request to enable PG2 without PG1 up refuses
// BAD_ORDER; a request to enable a DDI without PG2 up refuses
// BAD_ORDER.
//
// =============================================================================
// §2  CDCLK SETPOINTS PER GEN
// =============================================================================
//
// The core-display clock (CDCLK) drives the pipe, plane and DP
// link rate. Only a small set of setpoints is valid per gen per
// bspec §14:
//
//   Xe1: 172_800 / 307_200 / 326_400 / 556_800 / 652_800 kHz
//   Xe2: 172_800 / 480_000 / 540_000 / 652_800 / 819_200 kHz
//   Xe3: 307_200 / 480_000 / 540_000 / 652_800 / 819_200 kHz
//
// A setpoint outside its gen's small set is refused BAD_SETPOINT
// rather than clamped; a wrong CDCLK on a live pipe causes visual
// tearing and DP link retrain storms.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _pwr_well_state and _pwr_cdclk_khz are written only by helpers
// in this module. tools/build.sh confines relocations against each
// to `core/drivers/dpy/pwr_wells.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF7A0..0xFFFFF7AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dpclk_config 0xFFFFF790..9F;
// adjacent used bands above: iris_xe_probe 0xFFFFF7B0..BF, kind_
// display_engine 0xFFFFF7C0..CF).

module PwrWells = structure {

  // Well identifiers (§1).
  pub let PWR_WELL_PG1   : u64 = 0
  pub let PWR_WELL_PG2   : u64 = 1
  pub let PWR_WELL_DDI_A : u64 = 2
  pub let PWR_WELL_DDI_B : u64 = 3
  pub let PWR_WELL_DDI_C : u64 = 4
  pub let PWR_WELL_DDI_D : u64 = 5
  pub let PWR_WELL_DDI_E : u64 = 6
  pub let PWR_WELL_MAX   : u64 = 6

  // Well count including sentinel — table is [u64; 8], indexed by id.
  pub let PWR_WELL_COUNT : u64 = 8

  // Gen ordinals (matches kind_display_engine DPY_GEN_*).
  pub let PWR_GEN_XE1 : u64 = 1
  pub let PWR_GEN_XE2 : u64 = 2
  pub let PWR_GEN_XE3 : u64 = 3
  pub let PWR_GEN_MAX : u64 = 3

  // MMIO register offsets (bspec §14). Read/written through the
  // synthetic seam this milestone.
  pub let PWR_REG_PG_STATUS : u64 = 0x45400
  pub let PWR_REG_CDCLK_CTL : u64 = 0x46000

  // Failure taxonomy — 0xFFFFF7A0..0xFFFFF7AF.
  pub let PWR_OK             : u64 = 0
  pub let PWR_BAD_ARG        : u64 = 0xFFFFF7AF
  pub let PWR_BAD_WELL       : u64 = 0xFFFFF7AE
  pub let PWR_BAD_ORDER      : u64 = 0xFFFFF7AD
  pub let PWR_ALREADY_ON     : u64 = 0xFFFFF7AC
  pub let PWR_ALREADY_OFF    : u64 = 0xFFFFF7AB
  pub let PWR_BAD_GEN        : u64 = 0xFFFFF7AA
  pub let PWR_BAD_SETPOINT   : u64 = 0xFFFFF7A9
  pub let PWR_NOT_ENABLED    : u64 = 0xFFFFF7A8

  // Per-well state: 0 off, 1 on. .bss zero-init means every well
  // is off at boot.
  pub let mut _pwr_well_state : [u64; 8] = uninit @align(64)

  // The current CDCLK setpoint in kHz; 0 = not configured.
  pub let mut _pwr_cdclk_khz : [u64; 1] = uninit @align(64)

  // Counters.
  pub let mut _pwr_wells_stats : [u64; 8] = uninit @align(64)

  pub let PWR_ST_ENABLES  : u64 = 0
  pub let PWR_ST_DISABLES : u64 = 1
  pub let PWR_ST_REFUSED  : u64 = 2
  pub let PWR_ST_SETPOINT : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let pwr_wells_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): clear state, cdclk, and stats. Boot and teardown only. Labels prefixed pwr_rs_.",
      block: {
        lea r10, [rip + _pwr_well_state];
        xor rax, rax;
        xor rcx, rcx;
      pwr_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pwr_rs_state;

        lea r10, [rip + _pwr_cdclk_khz];
        mov [r10 + 0], rax;

        lea r10, [rip + _pwr_wells_stats];
        xor rcx, rcx;
      pwr_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pwr_rs_stats;
        ret
      }
    } @no_frame

  pub let pwr_wells_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-002 (#1236): honesty pin. Returns 0 until a later round binds this against a live MMIO window.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pwr_wells_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): counter read. Labels prefixed pwr_st_.",
      block: {
        cmp rdi, 8;
        jae pwr_st_zero;
        lea r10, [rip + _pwr_wells_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pwr_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pwr_wells_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): counter bump. Labels prefixed pwr_nt_.",
      block: {
        cmp rdi, 8;
        jae pwr_nt_out;
        lea r10, [rip + _pwr_wells_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pwr_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Well validators + readers.
  // ==========================================================================

  pub let pwr_well_id_valid : (u64) -> u64 !{} @{} =
    fn (well: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-002 (#1236): 1 iff well <= PWR_WELL_MAX (6). Labels prefixed pwr_wv_.",
      block: {
        cmp rdi, 6;
        ja  pwr_wv_no;
        mov rax, 1;
        ret;
      pwr_wv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pwr_well_is_on : (u64) -> u64 !{mem} @{} =
    fn (well: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): 1 iff well is enabled, 0 otherwise or out-of-range. Labels prefixed pwr_io_.",
      block: {
        cmp rdi, 6;
        ja  pwr_io_no;
        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + rdi * 8];
        cmp rax, 0;
        je  pwr_io_no;
        mov rax, 1;
        ret;
      pwr_io_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // pwr_well_enable(well) -> PWR_OK | error
  //
  // Per §1's PG1 -> PG2 -> DDI ordering. THE ONE WRITER of
  // _pwr_well_state's on transitions; tools/build.sh confines that
  // symbol to this object.
  // ==========================================================================

  pub let pwr_well_enable : (u64) -> u64 !{mem} @{} =
    fn (well: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): enable one well, gated on §1's ordering. PG1 has no predecessor; PG2 requires PG1 on; DDI_* require PG2 on. Idempotent enable of an already-on well refuses ALREADY_ON so a caller cannot confuse 'already up' with 'just brought up'. Labels prefixed pwr_en_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        cmp r12, 6;
        ja  pwr_en_bad_well;

        // If already on, refuse.
        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + r12 * 8];
        cmp rax, 0;
        jne pwr_en_already_on;

        // PG1: no predecessor.
        cmp r12, 0;
        je  pwr_en_do;

        // PG2: PG1 must be on.
        cmp r12, 1;
        jne pwr_en_ddi;
        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  pwr_en_bad_order;
        jmp pwr_en_do;

      pwr_en_ddi:
        // DDI_*: PG2 must be on.
        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + 8];              // PG2 at index 1
        cmp rax, 0;
        je  pwr_en_bad_order;

      pwr_en_do:
        lea r10, [rip + _pwr_well_state];
        mov rax, 1;
        mov [r10 + r12 * 8], rax;
        mov rdi, 0;                      // ENABLES
        call pwr_wells_note;
        xor rax, rax;
        jmp pwr_en_out;

      pwr_en_bad_well:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7AE;
        jmp pwr_en_out;
      pwr_en_bad_order:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7AD;
        jmp pwr_en_out;
      pwr_en_already_on:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7AC;

      pwr_en_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pwr_well_disable(well) -> PWR_OK | error
  //
  // Disable ordering is the reverse: a DDI may disable freely; PG2
  // may disable only after every DDI is off; PG1 may disable only
  // after PG2 is off.
  // ==========================================================================

  pub let pwr_well_disable : (u64) -> u64 !{mem} @{} =
    fn (well: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): disable one well. DDI_* disable freely; PG2 requires every DDI off; PG1 requires PG2 off. ALREADY_OFF refused for the same reason enable refuses ALREADY_ON. Labels prefixed pwr_di_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        cmp r12, 6;
        ja  pwr_di_bad_well;

        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + r12 * 8];
        cmp rax, 0;
        je  pwr_di_already_off;

        // PG1: PG2 must be off.
        cmp r12, 0;
        jne pwr_di_check_pg2;
        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + 8];              // PG2 at index 1
        cmp rax, 0;
        jne pwr_di_bad_order;
        jmp pwr_di_do;

      pwr_di_check_pg2:
        // PG2: every DDI (indices 2..6) must be off.
        cmp r12, 1;
        jne pwr_di_do;                   // DDI_* — no dependents
        mov r13, 2;
      pwr_di_ddi_scan:
        cmp r13, 7;
        jae pwr_di_do;
        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + r13 * 8];
        cmp rax, 0;
        jne pwr_di_bad_order;
        add r13, 1;
        jmp pwr_di_ddi_scan;

      pwr_di_do:
        lea r10, [rip + _pwr_well_state];
        xor rax, rax;
        mov [r10 + r12 * 8], rax;
        mov rdi, 1;                      // DISABLES
        call pwr_wells_note;
        xor rax, rax;
        jmp pwr_di_out;

      pwr_di_bad_well:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7AE;
        jmp pwr_di_out;
      pwr_di_bad_order:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7AD;
        jmp pwr_di_out;
      pwr_di_already_off:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7AB;

      pwr_di_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // CDCLK setpoint gate.
  //
  // pwr_cdclk_setpoint_valid(gen, khz) -> 1 | 0
  // pwr_cdclk_set(gen, khz)            -> PWR_OK | error
  //
  // §2's per-gen legal setpoint set. A setpoint outside the small
  // set is refused rather than clamped.
  // ==========================================================================

  pub let pwr_cdclk_setpoint_valid : (u64, u64) -> u64 !{} @{} =
    fn (gen: u64) (khz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-002 (#1236): 1 iff khz is in gen's small legal set (§2). A gen outside {1,2,3} refuses. Labels prefixed pwr_sv_.",
      block: {
        // Gen 1 (Xe1): 172800 / 307200 / 326400 / 556800 / 652800.
        cmp rdi, 1;
        jne pwr_sv_xe2_q;
        mov r10, 172800;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 307200;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 326400;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 556800;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 652800;
        cmp rsi, r10;
        je  pwr_sv_yes;
        jmp pwr_sv_no;

      pwr_sv_xe2_q:
        // Gen 2 (Xe2): 172800 / 480000 / 540000 / 652800 / 819200.
        cmp rdi, 2;
        jne pwr_sv_xe3_q;
        mov r10, 172800;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 480000;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 540000;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 652800;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 819200;
        cmp rsi, r10;
        je  pwr_sv_yes;
        jmp pwr_sv_no;

      pwr_sv_xe3_q:
        // Gen 3 (Xe3): 307200 / 480000 / 540000 / 652800 / 819200.
        cmp rdi, 3;
        jne pwr_sv_no;
        mov r10, 307200;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 480000;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 540000;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 652800;
        cmp rsi, r10;
        je  pwr_sv_yes;
        mov r10, 819200;
        cmp rsi, r10;
        je  pwr_sv_yes;

      pwr_sv_no:
        xor rax, rax;
        ret;
      pwr_sv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let pwr_cdclk_set : (u64, u64) -> u64 !{mem} @{} =
    fn (gen: u64) (khz: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): set CDCLK setpoint. Refuses if PG1 is not up (a CDCLK change with the sequencer down is a lost transition); refuses if gen or setpoint is out of range. THE ONE WRITER of _pwr_cdclk_khz. Labels prefixed pwr_cs_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;

        // PG1 must be up.
        lea r10, [rip + _pwr_well_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  pwr_cs_not_enabled;

        // Gen bound.
        cmp r12, 1;
        jb  pwr_cs_bad_gen;
        cmp r12, 3;
        ja  pwr_cs_bad_gen;

        // Setpoint valid?
        mov rdi, r12;
        mov rsi, r13;
        call pwr_cdclk_setpoint_valid;
        cmp rax, 0;
        je  pwr_cs_bad_setpoint;

        lea r10, [rip + _pwr_cdclk_khz];
        mov [r10 + 0], r13;
        mov rdi, 3;                      // SETPOINT
        call pwr_wells_note;
        xor rax, rax;
        jmp pwr_cs_out;

      pwr_cs_not_enabled:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7A8;
        jmp pwr_cs_out;
      pwr_cs_bad_gen:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7AA;
        jmp pwr_cs_out;
      pwr_cs_bad_setpoint:
        mov rdi, 2;
        call pwr_wells_note;
        mov rax, 0xFFFFF7A9;

      pwr_cs_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pwr_cdclk_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-002 (#1236): current CDCLK setpoint in kHz, 0 if not configured. Labels prefixed pwr_cg_.",
      block: {
        lea r10, [rip + _pwr_cdclk_khz];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame
}
