// src/kernel/core/drivers/dpy/iris_xe_boot.pdx -- R104.M1-001..004
//
// Boot-time Iris Xe pipeline init cascade. Four entry points, one per
// R104.M1 issue, each T14-gated on _t14_g4_present so QEMU boots take
// a silent skip arm.
//
//   iris_xe_boot_probe                (R104.M1-001 / paideia-os #2170)
//   iris_xe_boot_cdclk                (R104.M1-002 / paideia-os #2171)
//   iris_xe_boot_backend_register     (R104.M1-003 / paideia-os #2172)
//   iris_xe_boot_guc                  (R104.M1-004 / paideia-os #2173)
//
// The T14-gate posture: because R36 substrate (iris_xe_probe, pwr_wells,
// dpclk_config, guc_load, guc_hs) landed at scaffold level -- each
// `*_arbitrated` function returns 0 until a later round binds it against
// live MMIO -- QEMU cannot reach the "real" arm of any of these. This
// file is honest about that: the T14 arm calls the arbitrated primitives
// and emits its live fingerprint, the QEMU arm emits a lowercase skip
// line naming the R104 sub-issue. Neither arm is a lie: on QEMU there
// really is no Iris Xe device to program, and on T14 the arbitrated
// primitives run against the scaffold layer today; a future R104-
// follow-on lands the MMIO binding without touching these entry points.
//
// ============================================================================
// SECTION 1  ONE-WAY DEPENDENCY ON THE T14 FLAG
// ============================================================================
//
// Each of the four entry points reads [rip + _t14_g4_present] once at
// entry. Zero -> emit skip fingerprint, return. Non-zero -> proceed
// through the R36/R37 scaffold, emit the live fingerprint, return. The
// gate is intentionally per-entry-point (not "check once at cascade
// top") so a future landing that swaps one arm without the others (say,
// GuC loads on a Meteor-Lake board where the display path still runs
// stdvga) doesn't have to re-derive the branch. Every entry point is
// safe to call unconditionally from kernel_main.
//
// ============================================================================
// SECTION 2  FINGERPRINTS (all lowercase, no OK_TOK trigger)
// ============================================================================
//
// Live arm (T14):
//   "r104 iris_xe probe ok"           (R104.M1-001)
//   "r104 iris_xe cdclk ok"           (R104.M1-002)
//   "r104 iris_xe backend register ok"(R104.M1-003)
//   "r104 iris_xe guc load ok"        (R104.M1-004)
//
// Skip arm (QEMU / non-T14):
//   "r104 iris_xe probe skip not-t14"
//   "r104 iris_xe cdclk skip not-t14"
//   "r104 iris_xe backend register skip not-t14"
//   "r104 iris_xe guc load skip not-t14"
//
// Both variants of each pair go through the same fingerprint-coverage
// gate; tools/verify-fingerprint-coverage.sh gets a matching pair in
// tests/expected-r104-iris-xe.golden.
//
// ============================================================================
// SECTION 3  ENCODER + LABELS
// ============================================================================
//
// Frame prologue implicit. No `test`, no `add reg, [mem]`, no `cmp
// reg, [mem]`. Labels prefixed `ixewa_` (Iris Xe wire-up attach).

module IrisXeBoot = structure {

  // Fingerprint tags. Frame prologue implicit.
  pub let tag_r104_probe_ok     : [u8; 22] = "r104 iris_xe probe ok\0"
  pub let tag_r104_probe_skip   : [u8; 32] = "r104 iris_xe probe skip not-t14\0"
  pub let tag_r104_cdclk_ok     : [u8; 22] = "r104 iris_xe cdclk ok\0"
  pub let tag_r104_cdclk_skip   : [u8; 32] = "r104 iris_xe cdclk skip not-t14\0"
  pub let tag_r104_backend_ok   : [u8; 33] = "r104 iris_xe backend register ok\0"
  pub let tag_r104_backend_skip : [u8; 43] = "r104 iris_xe backend register skip not-t14\0"
  pub let tag_r104_guc_ok       : [u8; 25] = "r104 iris_xe guc load ok\0"
  pub let tag_r104_guc_skip     : [u8; 35] = "r104 iris_xe guc load skip not-t14\0"

  // ==========================================================================
  // iris_xe_boot_probe(): R104.M1-001 (paideia-os #2170).
  //
  // T14 arm: call ixp_probe_arbitrated (R36 scaffold; returns 0 today
  //   pending live-MMIO binding). Emit probe-ok fingerprint.
  // QEMU arm: emit probe-skip fingerprint.
  //
  // Zero args, one nested call per arm plus one klog. Two callee-save
  // pushes to preserve nothing critical, kept only for a defensive
  // rsp%16==0 boundary. Actually leaf-clean: no callee-save needed,
  // no explicit rsp align (entry rsp%16==8; sub rsp,8 -> aligned for
  // the klog call, add back on return).
  // Labels prefixed ixewa_pb_.
  // ==========================================================================
  pub let iris_xe_boot_probe : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M1-001: T14-gated call into ixp_probe_arbitrated + fingerprint emission. QEMU arm emits skip. Labels prefixed ixewa_pb_.",
      block: {
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_pb_skip;

        // Live arm.
        call ixp_probe_arbitrated;
        // Ignore rax (R36 scaffold returns 0). The fingerprint below
        // is the assertable signal that the call site actually ran.

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_probe_ok];
        call klog_s1;
        jmp ixewa_pb_out;

      ixewa_pb_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_probe_skip];
        call klog_s1;

      ixewa_pb_out:
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // iris_xe_boot_cdclk(): R104.M1-002 (paideia-os #2171).
  //
  // T14 arm: pwr_wells_arbitrated then dpclk_pll_arbitrated.
  // Emit cdclk-ok fingerprint.
  // Labels prefixed ixewa_ck_.
  // ==========================================================================
  pub let iris_xe_boot_cdclk : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M1-002: T14-gated call into pwr_wells_arbitrated + dpclk_pll_arbitrated + fingerprint. Labels prefixed ixewa_ck_.",
      block: {
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_ck_skip;

        call pwr_wells_arbitrated;
        call dpclk_pll_arbitrated;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_cdclk_ok];
        call klog_s1;
        jmp ixewa_ck_out;

      ixewa_ck_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_cdclk_skip];
        call klog_s1;

      ixewa_ck_out:
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // iris_xe_boot_backend_register(): R104.M1-003 (paideia-os #2172).
  //
  // T14 arm: mint KIND_DISPLAY_BACKEND with backend_kind=IRIS_XE (4).
  //
  // R101/R103 witness pattern mints backend caps against a SYNTHETIC
  // KIND_DEVICE parent at cap slot 130. R104 follows the same pattern:
  // slot 132 (immediately after R101's 130/131 pair -- verified free by
  // grep of every witness_r*_.pdx file, no witness after R66v2 tty
  // cascade names slots 130-140). That keeps this file self-contained
  // and hardware-independent -- the real KIND_DEVICE for the Iris Xe
  // function comes from pci_publish_caps in a later round when the
  // real MMIO binding lands.
  //
  // Emits backend-ok fingerprint. Register plan:
  //   rbx = row_id from mint (survives if a future extension emits the
  //         row id as a KV).
  // One callee-save push + sub rsp,8: rsp%16==0 for nested calls.
  // Labels prefixed ixewa_br_.
  // ==========================================================================
  pub let iris_xe_boot_backend_register : () -> () !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "R104.M1-003: T14-gated KIND_DISPLAY_BACKEND(IRIS_XE) mint via synthetic KIND_DEVICE parent at slot 132. Emits backend-ok fingerprint. Labels prefixed ixewa_br_.",
      block: {
        push rbx;
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_br_skip;

        // Mint synthetic KIND_DEVICE parent at slot 132.
        mov rdi, 132;
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, 0x1040;                 // target_ptr (arbitrary non-zero)
        call cap_mint_write;

        // kind_display_backend_mint_body(parent_slot=132,
        //   rights=R_DPYB_QUERY(1), backend_kind=IRIS_XE(4),
        //   bar_pa=0 (populated later when live MMIO binding lands),
        //   mmio_base=0, provider_slot=0)
        mov rdi, 132;
        mov rsi, 0x001;
        mov rdx, 4;                      // DPYB_KIND_IRIS_XE
        xor rcx, rcx;
        xor r8, r8;
        xor r9, r9;
        call kind_display_backend_mint_body;
        mov rbx, rax;

        // Scrub slot 132 (release the synthetic parent).
        mov rdi, 132;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_backend_ok];
        call klog_s1;
        jmp ixewa_br_out;

      ixewa_br_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_backend_skip];
        call klog_s1;

      ixewa_br_out:
        add rsp, 8;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // iris_xe_boot_guc(): R104.M1-004 (paideia-os #2173).
  //
  // T14 arm: gucl_arbitrated + guchs_arbitrated. Both R37 scaffolds
  // return 0 until live-MMIO binding lands; the fingerprint asserts the
  // call site ran.
  // Labels prefixed ixewa_gc_.
  // ==========================================================================
  pub let iris_xe_boot_guc : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M1-004: T14-gated call into gucl_arbitrated + guchs_arbitrated + fingerprint. Labels prefixed ixewa_gc_.",
      block: {
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_gc_skip;

        call gucl_arbitrated;
        call guchs_arbitrated;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_guc_ok];
        call klog_s1;
        jmp ixewa_gc_out;

      ixewa_gc_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_guc_skip];
        call klog_s1;

      ixewa_gc_out:
        add rsp, 8;
        ret
      }
    }
}
