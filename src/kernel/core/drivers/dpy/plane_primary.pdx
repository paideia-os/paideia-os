// src/kernel/core/drivers/dpy/plane_primary.pdx — R36.M4-002 (#1250)
//
// Primary-plane composition for Intel Iris Xe. Consumes a
// KIND_DISPLAY_PLANE row with plane_type == DPP_TYPE_PRIMARY and
// resolves it to a per-pipe binding: memory row (buffer bind), z-order
// (must be 0 for a primary on Xe1), pixel format (XRGB8888 or
// RGBA8888 only), stride discipline (cache-line aligned) and tile
// format ordinal (LINEAR / X_TILED / Y_F_TILED per bspec §14).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// This is the CLASS-SPECIFIC HALF of the plane lattice for the primary
// role. kind_display_plane.pdx holds the row and does the generic
// mint/revoke gates; this module rejects a row whose class-specific
// fields do not match the primary role, records a binding decision in
// the per-pipe state, and returns the honest DEFERRED_HARDWARE sentinel
// where a live driver would ARM the plane.
//
// It DOES NOT TOUCH REAL MMIO. The GTT binding, stride register write
// and format-descriptor stamp all happen through the atomic_commit seam
// which is arbitrated=0 this milestone. plpri_arbitrated() returns 0
// until a later round binds the seam against a live window.
//
// It DOES NOT CHOOSE A Z-ORDER, A FORMAT OR A TILE FORMAT. The
// compositor (or its stand-in in this milestone -- the witness) does.
// This module ENFORCES the primary-role constraints on those choices.
//
// =============================================================================
// §1  THE PRIMARY-ROLE GATES
// =============================================================================
//
//   (a) plane_type == DPP_TYPE_PRIMARY (WRONG_TYPE)
//   (b) zorder     == 0 on Xe1 (BAD_ZORDER)
//   (c) format     in {XRGB8888, RGBA8888} (BAD_FORMAT); YUV formats
//       belong to the overlay class -- a primary that scanned NV12 out
//       would need chroma-upsampling in the pipe, which Xe1 primaries
//       do not do
//   (d) stride     >= 64 && stride % 64 == 0 (BAD_STRIDE); bspec §14
//       cache-line alignment for the plane fetch scheduler
//   (e) tile_format in {LINEAR, X_TILED, Y_F_TILED} (BAD_TILE)
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _plane_primary_state is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/dpy/plane_primary.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF6D0..0xFFFFF6DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: kind_display_plane
// 0xFFFFF6E0..EF; adjacent free bands below: plane_overlay
// 0xFFFFF6C0..CF).

module PlanePrimary = structure {

  // Format ordinals accepted by primary (mirroring kind_display_plane).
  pub let PLPRI_FORMAT_XRGB8888 : u64 = 0
  pub let PLPRI_FORMAT_RGBA8888 : u64 = 3

  // Tile format ordinals (bspec §14).
  pub let PLPRI_TILE_LINEAR   : u64 = 0
  pub let PLPRI_TILE_X_TILED  : u64 = 1
  pub let PLPRI_TILE_Y_F_TILED: u64 = 2
  pub let PLPRI_TILE_MAX      : u64 = 2

  pub let PLPRI_STRIDE_ALIGN  : u64 = 64
  pub let PLPRI_STRIDE_MIN    : u64 = 64

  // Number of pipes tracked. Same shape as atomic_commit.
  pub let PLPRI_PIPE_COUNT    : u64 = 4

  // Per-pipe binding state, 8 u64 slots per pipe * 4 pipes = 32 u64s.
  //   [+0]  bound         0 = fresh, 1 = a bind ran
  //   [+8]  plane_slot    KIND_DISPLAY_PLANE cap slot
  //   [+16] memory_slot   KIND_MEMORY row bound (buffer bind record)
  //   [+24] format        pixel format ordinal
  //   [+32] stride        stride the caller committed
  //   [+40] tile_format   tile format ordinal
  //   [+48] reserved
  //   [+56] reserved
  pub let mut _plane_primary_state : [u64; 32] = uninit @align(64)
  pub let mut _plane_primary_stats : [u64; 8]  = uninit @align(64)

  pub let PLPRI_ST_BINDS   : u64 = 0
  pub let PLPRI_ST_REFUSED : u64 = 1

  // Failure taxonomy — 0xFFFFF6D0..0xFFFFF6DF.
  pub let PLPRI_OK                : u64 = 0
  pub let PLPRI_BAD_ARG           : u64 = 0xFFFFF6DF
  pub let PLPRI_BAD_PIPE          : u64 = 0xFFFFF6DE
  pub let PLPRI_WRONG_TYPE        : u64 = 0xFFFFF6DD
  pub let PLPRI_BAD_ZORDER        : u64 = 0xFFFFF6DC
  pub let PLPRI_BAD_FORMAT        : u64 = 0xFFFFF6DB
  pub let PLPRI_BAD_STRIDE        : u64 = 0xFFFFF6DA
  pub let PLPRI_BAD_TILE          : u64 = 0xFFFFF6D9
  pub let PLPRI_NO_PLANE_ROW      : u64 = 0xFFFFF6D8
  pub let PLPRI_DEFERRED_HARDWARE : u64 = 0xFFFFF6D7

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let plane_primary_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): clear per-pipe binding state and stats. Boot and teardown. Labels prefixed plpri_rs_.",
      block: {
        lea r10, [rip + _plane_primary_state];
        xor rax, rax;
        xor rcx, rcx;
      plpri_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  plpri_rs_state;

        lea r10, [rip + _plane_primary_stats];
        xor rcx, rcx;
      plpri_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  plpri_rs_stats;
        ret
      }
    }

  pub let plpri_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-002 (#1250): honesty pin. Returns 0 until a later round binds the atomic_commit seam against a live MMIO window.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let plpri_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): counter bump. Labels prefixed plpri_nt_.",
      block: {
        cmp rdi, 8;
        jae plpri_nt_out;
        lea r10, [rip + _plane_primary_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      plpri_nt_out:
        ret
      }
    }

  pub let plpri_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): counter read. Labels prefixed plpri_st_.",
      block: {
        cmp rdi, 8;
        jae plpri_st_zero;
        lea r10, [rip + _plane_primary_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      plpri_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators (§1).
  // ==========================================================================

  pub let plpri_pipe_valid : (u64) -> u64 !{} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-002 (#1250): 1 iff pipe < PLPRI_PIPE_COUNT (4). Labels prefixed plpri_pv_.",
      block: {
        cmp rdi, 4;
        jae plpri_pv_no;
        mov rax, 1;
        ret;
      plpri_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let plpri_zorder_valid : (u64) -> u64 !{} @{} =
    fn (z: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-002 (#1250): 1 iff z == 0 (primary is bottom on Xe1). Labels prefixed plpri_zv_.",
      block: {
        cmp rdi, 0;
        jne plpri_zv_no;
        mov rax, 1;
        ret;
      plpri_zv_no:
        xor rax, rax;
        ret
      }
    }

  pub let plpri_format_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-002 (#1250): 1 iff f in {XRGB8888(0), RGBA8888(3)}. Labels prefixed plpri_fv_.",
      block: {
        cmp rdi, 0;
        je  plpri_fv_yes;
        cmp rdi, 3;
        je  plpri_fv_yes;
        xor rax, rax;
        ret;
      plpri_fv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let plpri_stride_valid : (u64) -> u64 !{} @{} =
    fn (stride: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-002 (#1250): 1 iff stride >= 64 && stride % 64 == 0 -- bspec §14 alignment. Labels prefixed plpri_sv_.",
      block: {
        cmp rdi, 64;
        jb  plpri_sv_no;
        mov rax, rdi;
        mov r10, 63;
        and rax, r10;
        cmp rax, 0;
        jne plpri_sv_no;
        mov rax, 1;
        ret;
      plpri_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let plpri_tile_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-002 (#1250): 1 iff t <= PLPRI_TILE_MAX (2). Labels prefixed plpri_tv_.",
      block: {
        cmp rdi, 2;
        ja  plpri_tv_no;
        mov rax, 1;
        ret;
      plpri_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Binding. plane_primary_bind(pipe, plane_slot, stride, tile_format)
  //
  // Resolves plane_slot to a KIND_DISPLAY_PLANE row (via dpp_row_of_slot),
  // enforces the primary-role gates, records the binding and returns
  // DEFERRED_HARDWARE (honesty pin) where a live driver would ARM.
  // ==========================================================================

  pub let plane_primary_bind : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (pipe: u64) (plane_slot: u64) (stride: u64) (tile_format: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M4-002 (#1250): bind KIND_DISPLAY_PLANE (primary) to a pipe. Enforces §1 gates. Records the buffer bind (memory_slot from the plane row) and stride / tile format. Returns DEFERRED_HARDWARE while the seam is unbound. Labels prefixed plpri_bd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // pipe
        mov r12, rsi;                    // plane_slot
        mov r13, rdx;                    // stride
        mov r14, rcx;                    // tile_format

        mov rdi, rbx;
        call plpri_pipe_valid;
        cmp rax, 0;
        je  plpri_bd_bad_pipe;

        mov rdi, r13;
        call plpri_stride_valid;
        cmp rax, 0;
        je  plpri_bd_bad_stride;

        mov rdi, r14;
        call plpri_tile_valid;
        cmp rax, 0;
        je  plpri_bd_bad_tile;

        // Resolve plane_slot -> row_id (validates live KIND_DISPLAY_PLANE).
        mov rdi, r12;
        call dpp_row_of_slot;
        mov r11, 0xFF;
        cmp rax, r11;
        je  plpri_bd_no_row;
        mov r15, rax;                    // row_id

        // Type must be PRIMARY.
        mov rdi, r15;
        call dpp_row_type;
        cmp rax, 0;                      // DPP_TYPE_PRIMARY
        jne plpri_bd_wrong_type;

        // Z-order must be 0.
        mov rdi, r15;
        call dpp_row_zorder;
        mov rdi, rax;
        call plpri_zorder_valid;
        cmp rax, 0;
        je  plpri_bd_bad_zorder;

        // Format must be XRGB8888 or RGBA8888.
        mov rdi, r15;
        call dpp_row_format;
        mov rbp, rax;                    // stash format for record
        mov rdi, rbp;
        call plpri_format_valid;
        cmp rax, 0;
        je  plpri_bd_bad_format;

        // Read memory_slot (buffer bind record).
        mov rdi, r15;
        call dpp_row_memory;
        mov r15, rax;                    // memory_slot

        // Stamp per-pipe state.
        lea r10, [rip + _plane_primary_state];
        mov r11, rbx;
        shl r11, 6;                      // pipe * 64
        add r10, r11;

        mov rax, 1;
        mov [r10 + 0],  rax;             // bound
        mov [r10 + 8],  r12;             // plane_slot
        mov [r10 + 16], r15;             // memory_slot
        mov [r10 + 24], rbp;             // format
        mov [r10 + 32], r13;             // stride
        mov [r10 + 40], r14;             // tile_format

        mov rdi, 0;                      // PLPRI_ST_BINDS
        call plpri_note;

        mov rax, 0xFFFFF6D7;             // DEFERRED_HARDWARE (honesty)
        jmp plpri_bd_out;

      plpri_bd_bad_pipe:
        mov rdi, 1;
        call plpri_note;
        mov rax, 0xFFFFF6DE;
        jmp plpri_bd_out;
      plpri_bd_bad_stride:
        mov rdi, 1;
        call plpri_note;
        mov rax, 0xFFFFF6DA;
        jmp plpri_bd_out;
      plpri_bd_bad_tile:
        mov rdi, 1;
        call plpri_note;
        mov rax, 0xFFFFF6D9;
        jmp plpri_bd_out;
      plpri_bd_no_row:
        mov rdi, 1;
        call plpri_note;
        mov rax, 0xFFFFF6D8;
        jmp plpri_bd_out;
      plpri_bd_wrong_type:
        mov rdi, 1;
        call plpri_note;
        mov rax, 0xFFFFF6DD;
        jmp plpri_bd_out;
      plpri_bd_bad_zorder:
        mov rdi, 1;
        call plpri_note;
        mov rax, 0xFFFFF6DC;
        jmp plpri_bd_out;
      plpri_bd_bad_format:
        mov rdi, 1;
        call plpri_note;
        mov rax, 0xFFFFF6DB;

      plpri_bd_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors — read the recorded binding for one pipe.
  // ==========================================================================

  pub let plpri_bound : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): 1 iff pipe has a recorded bind. Labels prefixed plpri_bnd_.",
      block: {
        cmp rdi, 4;
        jae plpri_bnd_no;
        lea r10, [rip + _plane_primary_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        ret;
      plpri_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let plpri_memory_of : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): bound memory slot. Labels prefixed plpri_mo_.",
      block: {
        cmp rdi, 4;
        jae plpri_mo_no;
        lea r10, [rip + _plane_primary_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        ret;
      plpri_mo_no:
        xor rax, rax;
        ret
      }
    }

  pub let plpri_stride_of : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): bound stride. Labels prefixed plpri_so_.",
      block: {
        cmp rdi, 4;
        jae plpri_so_no;
        lea r10, [rip + _plane_primary_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        ret;
      plpri_so_no:
        xor rax, rax;
        ret
      }
    }

  pub let plpri_tile_of : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-002 (#1250): bound tile format. Labels prefixed plpri_to_.",
      block: {
        cmp rdi, 4;
        jae plpri_to_no;
        lea r10, [rip + _plane_primary_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        ret;
      plpri_to_no:
        xor rax, rax;
        ret
      }
    }
}
