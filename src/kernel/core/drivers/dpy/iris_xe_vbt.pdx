// src/kernel/core/drivers/dpy/iris_xe_vbt.pdx — Wave 59 G1 (paideia-os#2538)
//
// Implements: design/graphics/iris-xe-vbt.md (Wave 60).
//
// Intel Iris Xe VBT (Video BIOS Table) parser body — walks the
// firmware-published Video BIOS Table out of the GPU's OpRegion and
// surrenders a settled VbtTopology struct the downstream modesetter
// (G2), DP-AUX stack (G3), hotplug IRQ mapper (G4), and backlight
// controller (D12) consume read-only.
//
// =============================================================================
// §0  SCOPE AND INTENT
// =============================================================================
//
// This module is one of three code paths that read firmware blobs on
// the first-boot critical path (the other two are MCFG + MADT under
// src/kernel/core/acpi/*.pdx). Posture: trust the OEM BIOS no more
// than any first-party firmware, decline malformed input without
// panicking, surface validation gates per design/graphics/iris-xe-vbt.md
// §9 so a diagnostic engineer can tell which gate refused a given
// board.
//
// =============================================================================
// §1  DISCOVERY PATH (per design doc §2)
// =============================================================================
//
//   OpRegion phys base = PCI config @ 0xFC (ASLS) with low 12 bits masked.
//   OpRegion is 32 KiB; header at +0x00; MBOX4 (inline VBT) at +0x400.
//   If RVDA pointer at HEADER+0x70 is non-zero, VBT lives at that
//   phys addr with length at HEADER+0x74 instead of inline MBOX4.
//
// The _DSM fallback described in design doc §2.3 is reserved for a
// later wave once the AML evaluator is far enough along to invoke it;
// this body returns 0 from vbt_discover_opregion if ASLS is unset so
// the caller takes the fallback branch (currently: refuse-graphics).
//
// =============================================================================
// §2  OUTPUT: VbtTopology byte layout
// =============================================================================
//
// VbtTopology is a 240-byte, @align(8) record (30 × u64 slots). All
// numeric fields are stored little-endian native. The slot is
// zero-initialised at the top of vbt_parse before any decoding so a
// malformed VBT leaves every count at zero rather than at the previous
// parser invocation's residue.
//
//   HEADER (bytes 0..56)
//     +0    u16  vbt_version          — raw VBT version (231..257 window)
//     +2    u8   panel_present        — 1 iff Block 42 populated a DTD
//     +3    u8   n_ports              — count of valid port entries (<=8)
//     +4    u8   backlight_type       — 0=PWM, 1=AUX, 2=combo
//     +5    u8   backlight_pol        — 0=active-high, 1=active-low
//     +6    u16  pwm_freq_hz          — target PWM frequency
//     +8    u8   bl_min_pct           — brightness floor
//     +9    u8   bl_default_pct       — startup brightness
//     +10   u8[10] bl_curve           — 10 anchor points, 0..255
//     +20   u8[32] _reserved_hdr      — sbios_version slot (not populated in G1)
//     +52   u8[4]  _reserved_hdr2     — vbios_version slot (not populated in G1)
//
//   PANEL (bytes 56..112)
//     +56   u8   ddi_port             — DDI (0=A on T14 G4)
//     +57   u8   bpp                  — decoded bits per pixel (18/24/30/36/48)
//     +58   u8   edp_link_rate        — 0..3 enum (1.62/2.7/5.4/8.1 Gbps)
//     +59   u8   edp_lane_count       — 1, 2, or 4 (raw+1 adjusted)
//     +60   u8   h_sync_pol           — 0=neg, 1=pos
//     +61   u8   v_sync_pol           — 0=neg, 1=pos
//     +62   u16  edp_hz               — integer refresh (pclk / (htot*vtot))
//     +64   u16  native_hres
//     +66   u16  native_vres
//     +68   u16  h_total
//     +70   u16  v_total
//     +72   u16  h_sync_pos
//     +74   u16  h_sync_width
//     +76   u16  v_sync_pos
//     +78   u16  v_sync_width
//     +80   u16  pps_t1_t2            — power sequence delays (0.1 ms units)
//     +82   u16  pps_t3
//     +84   u16  pps_t4
//     +86   u16  pps_t5_t6
//     +88   u16  pps_cycle
//     +90   u16  _pad
//     +92   u32  pixel_clock_khz
//     +96   u8[16] _reserved_panel
//
//   PORTS (bytes 112..240; 8 slots × 16 bytes)
//     per port:
//     +0    u8   ddi                   — 0..5 (A..F); 0xFF = unused slot
//     +1    u8   aux_channel
//     +2    u8   hpd_pin
//     +3    u8   lane_count            — raw+1 adjusted
//     +4    u8   gmbus_pin
//     +5    u8   i2c_slave
//     +6    u8   is_internal           — device_type bit 12
//     +7    u8   is_edp                — device_type bit 13
//     +8    u8   is_dp                 — device_type bit 4
//     +9    u8   is_hdmi               — device_type bit 2
//     +10   u8   is_mipi               — device_type bit 14
//     +11   u8   _pad
//     +12   u16  device_type           — raw Block-2 bitmask
//     +14   u16  edid_ptr
//
// =============================================================================
// §3  KIND SLOT (design doc §13)
// =============================================================================
//
//   KIND_VBT_TOPOLOGY = 0x3A0
//
// Parent kind is KIND_PCI_DEV (0x30) — the GPU PCI config handle.
// This slot MUST be added to .plans/kind-reservations.md by the
// substrate-freeze commit before any derivation gate consumes it.
// At the time of this file's landing kind-reservations.md does not
// yet exist in-tree; the constant below is therefore PROVISIONAL
// until that file is created and the collision check runs.
//
// =============================================================================
// §4  paideia-as encoder-gap posture (v0.36.81)
// =============================================================================
//
//   G1 (sized stores): every u8 store uses mov_b, u16 uses mov_w,
//      u32 uses mov_d so field widths do not silently widen.
//   G4 (compare discipline): every compare is on a full 64-bit
//      register — no cmp al,imm anywhere in this file.
//   Reserved labels: `loop`, `if`, `let` cannot be labels. All
//      labels in this file are `vbt_`-prefixed.
//   Unaligned reads: OpRegion is 4 KiB aligned but the VBT inside
//      MBOX4 starts at offset 0x400 and child-device table entries
//      are 40 bytes each starting at odd offsets. Every multi-byte
//      load is treated as unaligned per SDM Vol.3 §7.1.1 (same
//      posture as xsdt.pdx L109, mcfg.pdx L203, crs.pdx L240). u8
//      via xor+mov_b, u16 via xor+mov_w, u32 via xor + mov r32,[...]
//      (zero-extends per SDM Vol.1 §3.4.1.1), u64 via plain mov.
//   No `and r11, imm64`: every mask here fits in imm32 (0xFF, 0xFFF,
//      0x7F, 0x1FFF). The one near-imm64 constant (ASLS mask ~0xFFF)
//      is staged into r10 as imm32-safe 0xFFFFF000 first.
//   No `test rN,rN`: equality against zero uses cmp rN, 0.
//
// =============================================================================
// §5  Register plan (vbt_parse, 5-push callee-save prologue)
// =============================================================================
//
//   Prologue: push rbx, r12, r13, r14, r15 (40 B → rsp%16==0 at loop).
//   rbx = block cursor (advances by 3 + block_size per iteration).
//   r12 = block-stream end (BDB header + bdb_size).
//   r13 = VBT base pointer (preserved for later field reads).
//   r14 = BDB header base.
//   r15 = out pointer (VbtTopology base).

module IrisXeVbt = structure {

  // ==========================================================================
  // §A  Constants
  // ==========================================================================

  // PCI config offset carrying ASLS (OpRegion phys base, 4 KiB aligned).
  pub let VBT_PCI_CFG_ASLS         : u64 = 0xFC

  // OpRegion HEADER field offsets (per IGD OpRegion spec r2.4 §2.1).
  pub let VBT_OPR_OFF_SIGNATURE    : u64 = 0x00    // 16 bytes
  pub let VBT_OPR_OFF_SIZE         : u64 = 0x10    // u32 (KiB count)
  pub let VBT_OPR_OFF_VERSION      : u64 = 0x14    // u32 packed
  pub let VBT_OPR_OFF_MAILBOXES    : u64 = 0x58    // u32 bitmask
  pub let VBT_OPR_OFF_RVDA_PHYS    : u64 = 0x70    // u64
  pub let VBT_OPR_OFF_RVDA_LEN     : u64 = 0x78    // u32

  pub let VBT_OPR_MBOX4_OFFSET     : u64 = 0x400   // inline VBT start
  pub let VBT_OPR_MBOX4_MAX_LEN    : u64 = 0x1C00  // inline cap (7 KiB)
  pub let VBT_OPR_MBOX4_BIT        : u64 = 0x10    // mailboxes bit 4

  // VBT header field offsets.
  pub let VBT_HDR_OFF_SIGNATURE    : u64 = 0x00    // "$VBT " (5 bytes significant)
  pub let VBT_HDR_OFF_VERSION      : u64 = 0x14    // u16
  pub let VBT_HDR_OFF_HEADER_SIZE  : u64 = 0x16    // u16
  pub let VBT_HDR_OFF_VBT_SIZE     : u64 = 0x18    // u16
  pub let VBT_HDR_OFF_BDB_OFFSET   : u64 = 0x1C    // u32

  // BDB header field offsets.
  pub let VBT_BDB_OFF_SIGNATURE    : u64 = 0x00    // "BIOS_DATA_BLOCK "
  pub let VBT_BDB_OFF_VERSION      : u64 = 0x10    // u16
  pub let VBT_BDB_OFF_HEADER_SIZE  : u64 = 0x12    // u16
  pub let VBT_BDB_OFF_BDB_SIZE     : u64 = 0x14    // u16

  // Accepted VBT version window (design doc §1).
  pub let VBT_VER_MIN              : u64 = 231
  pub let VBT_VER_MAX              : u64 = 257

  // Block IDs the parser consumes.
  pub let VBT_BLK_GENERAL_DEFS     : u64 = 2
  pub let VBT_BLK_EDP_DATA         : u64 = 27
  pub let VBT_BLK_LFP_PANEL_INFO   : u64 = 42
  pub let VBT_BLK_LFP_BL_POWER     : u64 = 43
  pub let VBT_BLK_LFP_BL_CONTROL   : u64 = 44

  // Child-device entry sizes (design doc §6.2).
  pub let VBT_CDS_V33              : u64 = 33
  pub let VBT_CDS_V38              : u64 = 38
  pub let VBT_CDS_V40              : u64 = 40
  pub let VBT_CDS_V41              : u64 = 41

  // Hard cap on ports surfaced into the topology (slot array).
  pub let VBT_MAX_PORTS            : u64 = 8

  // Block 42 panel DTD size on VBT 254 (bytes).
  pub let VBT_PDTD_SIZE_V254       : u64 = 70

  // VbtTopology field offsets.
  pub let VBT_TOPO_OFF_VERSION         : u64 = 0
  pub let VBT_TOPO_OFF_PANEL_PRESENT   : u64 = 2
  pub let VBT_TOPO_OFF_N_PORTS         : u64 = 3
  pub let VBT_TOPO_OFF_BL_TYPE         : u64 = 4
  pub let VBT_TOPO_OFF_BL_POL          : u64 = 5
  pub let VBT_TOPO_OFF_PWM_FREQ_HZ     : u64 = 6
  pub let VBT_TOPO_OFF_BL_MIN_PCT      : u64 = 8
  pub let VBT_TOPO_OFF_BL_DEFAULT_PCT  : u64 = 9
  pub let VBT_TOPO_OFF_BL_CURVE        : u64 = 10

  pub let VBT_TOPO_OFF_PANEL_DDI       : u64 = 56
  pub let VBT_TOPO_OFF_PANEL_BPP       : u64 = 57
  pub let VBT_TOPO_OFF_PANEL_EDP_RATE  : u64 = 58
  pub let VBT_TOPO_OFF_PANEL_EDP_LANES : u64 = 59
  pub let VBT_TOPO_OFF_PANEL_HSPOL     : u64 = 60
  pub let VBT_TOPO_OFF_PANEL_VSPOL     : u64 = 61
  pub let VBT_TOPO_OFF_PANEL_EDP_HZ    : u64 = 62
  pub let VBT_TOPO_OFF_PANEL_HRES      : u64 = 64
  pub let VBT_TOPO_OFF_PANEL_VRES      : u64 = 66
  pub let VBT_TOPO_OFF_PANEL_HTOT      : u64 = 68
  pub let VBT_TOPO_OFF_PANEL_VTOT      : u64 = 70
  pub let VBT_TOPO_OFF_PANEL_HSOFF     : u64 = 72
  pub let VBT_TOPO_OFF_PANEL_HSWIDTH   : u64 = 74
  pub let VBT_TOPO_OFF_PANEL_VSOFF     : u64 = 76
  pub let VBT_TOPO_OFF_PANEL_VSWIDTH   : u64 = 78
  pub let VBT_TOPO_OFF_PANEL_PCLK_KHZ  : u64 = 92

  pub let VBT_TOPO_OFF_PORTS           : u64 = 112
  pub let VBT_TOPO_PORT_STRIDE         : u64 = 16

  pub let VBT_TOPO_SIZE                : u64 = 240
  pub let VBT_TOPO_U64_SLOTS           : u64 = 30

  // Reserved kind slot (design doc §13). PROVISIONAL until
  // .plans/kind-reservations.md adds the entry.
  pub let KIND_VBT_TOPOLOGY        : u64 = 0x3A0

  // ==========================================================================
  // §B  Canonical static VbtTopology slot
  // ==========================================================================
  //
  // Populated by vbt_parse once at boot; consumers (G2 modeset,
  // G3 DP-AUX, G4 hotplug, D12 backlight) read it through
  // vbt_topology_slot_va(). Zero-fill is a valid "no VBT discovered"
  // signal — n_ports == 0 means consumers treat the GPU as headless.

  pub let mut _vbt_topology : [u64; 30] = uninit @align(8)

  pub let vbt_topology_slot_va : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "Wave 59 G1 (paideia-os#2538). Returns the kernel VA of the canonical _vbt_topology slot so consumers (G2 modeset, D12 backlight) can read-only reference the parsed topology without threading an out pointer through every call site. Leaf, no-frame. Labels prefixed vbt_sv_.",
      block: {
        lea rax, [rip + _vbt_topology];
        ret
      }
    }

  // ==========================================================================
  // §C  vbt_discover_opregion(pci_cfg_base: u64) -> u64
  // ==========================================================================
  //
  // Reads ASLS at pci_cfg_base + 0xFC, masks the low 12 bits, and
  // returns the OpRegion physical base address. Returns 0 if the
  // register reads as all-zero or all-ones (firmware did not populate
  // OpRegion; caller falls back to _DSM or refuses graphics).
  //
  // The pci_cfg_base argument is the mapped kernel VA of the GPU's
  // ECAM config window (as installed by mcfg_ecam_va_for_segment);
  // the caller must have validated that mapping before calling.

  pub let vbt_discover_opregion : (u64) -> u64 !{mem} @{} =
    fn (pci_cfg_base: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Reads 4 bytes at pci_cfg_base + VBT_PCI_CFG_ASLS (0xFC) via `mov eax, [rdi + 0xFC]` (32-bit MOV zero-extends per SDM Vol.1 §3.4.1.1); treats 0 and 0xFFFFFFFF as 'OpRegion absent' and returns 0 so the caller takes the _DSM fallback. Otherwise masks the low 12 bits via `and rax, 0xFFFFF000` (imm32-safe) and returns the OpRegion phys base. Leaf; no callee-save. Labels prefixed vbt_do_.",
      block: {
        // ASLS = u32 at pci_cfg_base + 0xFC (zero-extended into rax).
        xor rax, rax;
        mov eax, [rdi + 0xFC];

        // Reject 0 (not populated).
        cmp rax, 0;
        je  vbt_do_absent;

        // Reject 0xFFFFFFFF (firmware default sentinel).
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je  vbt_do_absent;

        // Mask low 12 bits (reserved per spec, read-as-zero per OEM
        // discipline but we strip defensively).
        mov r10, 0xFFFFF000;
        and rax, r10;
        ret;

      vbt_do_absent:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // §D  vbt_locate_phys(opregion: u64) -> u64
  //
  //     Returns the physical/VA base of the VBT (inline MBOX4 or RVDA).
  //
  //     If HEADER+0x70 (RVDA phys) is non-zero → return RVDA.
  //     Else → return opregion + 0x400 (inline MBOX4 base).
  //
  //     If MBOX4 bit of HEADER+0x58 is clear → return 0 (refuse).
  // ==========================================================================

  pub let vbt_locate_phys : (u64) -> u64 !{mem} @{} =
    fn (opregion: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Mailbox-4-present gate: load u32 @ HEADER+0x58 (zero-ext mov eax,[...]), test bit 4 via `and rax, 0x10; cmp rax,0; je vbt_lp_absent`. Non-zero → inspect RVDA pointer (u64 @ HEADER+0x70, plain mov r64,[...]); if non-zero return it (RVDA path), else return opregion + 0x400 (inline MBOX4). Leaf; no callee-save. Labels prefixed vbt_lp_.",
      block: {
        // Load mailboxes bitmask (u32 @ opregion + 0x58).
        xor rax, rax;
        mov eax, [rdi + 0x58];
        and rax, 0x10;
        cmp rax, 0;
        je  vbt_lp_absent;

        // RVDA phys (u64 @ opregion + 0x70, unaligned-tolerant).
        mov rax, [rdi + 0x70];
        cmp rax, 0;
        je  vbt_lp_inline;

        // RVDA populated — use it.
        ret;

      vbt_lp_inline:
        // Inline VBT starts at opregion + 0x400.
        mov rax, rdi;
        add rax, 0x400;
        ret;

      vbt_lp_absent:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // §E  vbt_locate_size(opregion: u64) -> u64
  //
  //     Returns the mapped length of the VBT region:
  //        RVDA path → u32 at HEADER+0x78
  //        inline    → VBT_OPR_MBOX4_MAX_LEN (0x1C00)
  // ==========================================================================

  pub let vbt_locate_size : (u64) -> u64 !{mem} @{} =
    fn (opregion: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). RVDA length lookup: if u64 @ opregion+0x70 is non-zero, return u32 @ opregion+0x78 (zero-ext mov eax,[...]); else return the inline MBOX4 cap VBT_OPR_MBOX4_MAX_LEN. Leaf; no callee-save. Labels prefixed vbt_ls_.",
      block: {
        mov rax, [rdi + 0x70];
        cmp rax, 0;
        je  vbt_ls_inline;

        // RVDA length (u32 @ opregion + 0x78).
        xor rax, rax;
        mov eax, [rdi + 0x78];
        ret;

      vbt_ls_inline:
        mov rax, 0x1C00;
        ret
      }
    }

  // ==========================================================================
  // §F  vbt_parse(vbt_ptr: u64, vbt_size: u64, out: u64) -> u64
  // ==========================================================================
  //
  // Decodes the VBT at vbt_ptr (vbt_size bytes long) into the
  // caller-allocated VbtTopology record at `out`. Returns 1 on
  // success, 0 on malformed. The record is zero-initialised at the
  // top of this function so a 0 return leaves every count field
  // at zero rather than at a prior invocation's residue.
  //
  // Flow:
  //   (a) Zero-init out (30 u64 slots).
  //   (b) Validate VBT header: signature, version window, size.
  //   (c) Validate BDB header: signature, size within VBT.
  //   (d) Walk the block stream until bdb_size consumed; dispatch:
  //         Block 2  → vbt_decode_block2  (child-device table)
  //         Block 27 → vbt_decode_block27 (eDP electrical)
  //         Block 42 → vbt_decode_block42 (LFP panel timing)
  //         Block 43 → vbt_decode_block43 (backlight power + curve)
  //         Block 44 → vbt_decode_block44 (backlight control override)
  //   (e) Return 1.
  //
  // On validation failure the parser leaves the topology partially
  // populated and returns 0; downstream mint-gates refuse to produce
  // a KIND_VBT_TOPOLOGY from a zero-return record.

  pub let vbt_parse : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (vbt_ptr: u64, vbt_size: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Parse the VBT at (vbt_ptr, vbt_size) into VbtTopology at `out`. 5-push callee-save prologue (rbx, r12-r15) → rsp%16==0. Zero-init 30 × u64 at `out`. Validate VBT header: `$VBT ` signature (5-byte prefix compare via two u32 + one u8 loads), VBT version in [231,257], vbt_size <= caller-declared length, bdb_offset + 32 <= vbt_size. Validate BDB header: `BIOS_DATA_BLOCK ` signature prefix (first 8 bytes), bdb_size + bdb_offset <= vbt_size. Store u16 vbt_version at out+0 via mov_w (G1). Walk the block stream: cursor starts at bdb_header + bdb_header_size, end = bdb_header + bdb_size. Per iteration: require 3 remaining bytes for a block header → read block_id (u8 @ cursor, xor+mov_b), block_size (u16 @ cursor+1, xor+mov_w), require cursor + 3 + block_size <= end. Dispatch on block_id to vbt_decode_block{2,27,42,43,44}; unknown IDs are silently advanced over for forward compatibility. Advance cursor += 3 + block_size. On stream exhaustion return 1. Encoder: unaligned reads tolerated per SDM Vol.3 §7.1.1; u8 via xor+mov_b, u16 via xor+mov_w, u32 via xor + mov r32,[...]; u64 via plain mov r64,[...]. All compares on full 64-bit registers (G4). All u8/u16/u32 stores sized (G1). Reserved labels: every label prefixed vbt_. No `and r11, imm64` (every mask fits imm32). No `test rN,rN` (equality against zero via `cmp rN, 0`). No `imul r,imm` two-operand form (block-size × 1 is a direct add).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Preserve args across nested calls.
        mov r13, rdi;                        // r13 = vbt base
        mov r15, rdx;                        // r15 = out

        // ---- (a) Zero-init 30 × u64 at out ----
        xor rax, rax;
        xor rcx, rcx;
      vbt_zero_top:
        cmp rcx, 30;
        jae vbt_zero_done;
        mov [r15 + rcx * 8], rax;
        add rcx, 1;
        jmp vbt_zero_top;
      vbt_zero_done:

        // ---- (b) Validate VBT header ----

        // Signature: first 5 bytes must be `$`, `V`, `B`, `T`, ` ` (space).
        // Compare the first 4 bytes as a packed u32: '$' | ('V'<<8) | ('B'<<16) | ('T'<<24)
        //   = 0x24 | 0x56<<8 | 0x42<<16 | 0x54<<24 = 0x54424256 | 0x00000024 = 0x54425624.
        xor rax, rax;
        mov eax, [r13 + 0];
        mov r10, 0x54425624;                 // "$VBT" little-endian u32
        cmp rax, r10;
        jne vbt_parse_fail;

        // 5th byte must be ' ' (0x20).
        xor rax, rax;
        mov_b rax, [r13 + 4];
        cmp rax, 0x20;
        jne vbt_parse_fail;

        // VBT version (u16 @ VBT_HDR_OFF_VERSION = 0x14).
        xor rax, rax;
        mov_w rax, [r13 + 0x14];
        // Range check: 231 <= ver <= 257.
        cmp rax, 231;
        jb  vbt_parse_fail;
        cmp rax, 257;
        ja  vbt_parse_fail;

        // Record version at out+0.
        mov_w [r15 + 0], rax;

        // vbt_size (u16 @ VBT_HDR_OFF_VBT_SIZE = 0x18) must be <= caller-declared len.
        xor rax, rax;
        mov_w rax, [r13 + 0x18];
        cmp rax, rsi;
        ja  vbt_parse_fail;

        // bdb_offset (u32 @ VBT_HDR_OFF_BDB_OFFSET = 0x1C).
        xor rbx, rbx;
        mov ebx, [r13 + 0x1C];
        // Require bdb_offset + 32 <= vbt_size for a complete BDB header.
        mov r10, rbx;
        add r10, 32;
        cmp r10, rsi;
        ja  vbt_parse_fail;

        // r14 = BDB header base.
        mov r14, r13;
        add r14, rbx;

        // ---- (c) Validate BDB header ----

        // Signature: first 8 bytes = "BIOS_DAT" (first half of "BIOS_DATA_BLOCK ").
        // Packed u64 LE: 'B' | 'I'<<8 | 'O'<<16 | 'S'<<24 | '_'<<32 | 'D'<<40 | 'A'<<48 | 'T'<<56
        //   = 0x5441445F534F4942.
        mov rax, [r14 + 0];
        mov r10, 0x5441445F534F4942;
        cmp rax, r10;
        jne vbt_parse_fail;

        // bdb_header_size (u16 @ +0x12).
        xor rbx, rbx;
        mov_w rbx, [r14 + 0x12];

        // bdb_size (u16 @ +0x14).
        xor rcx, rcx;
        mov_w rcx, [r14 + 0x14];

        // bdb_size must fit the containing region.
        xor rax, rax;
        mov_w rax, [r13 + 0x18];             // vbt_size again
        mov r10, rbx;                        // reuse r10
        // bdb_offset already in r14 - r13; derive again from (r14 - r13).
        mov r10, r14;
        sub r10, r13;                        // r10 = bdb_offset
        add r10, rcx;                        // r10 = bdb_offset + bdb_size
        cmp r10, rax;
        ja  vbt_parse_fail;

        // Walk cursor = r14 + bdb_header_size; end = r14 + bdb_size.
        mov r12, r14;
        add r12, rcx;                        // r12 = end
        mov rbx, r14;
        add rbx, 0;                          // rbx = cursor (loaded below)
        // Load bdb_header_size into rax, then cursor = r14 + header_size.
        xor rax, rax;
        mov_w rax, [r14 + 0x12];
        mov rbx, r14;
        add rbx, rax;

        // ---- (d) Walk blocks ----

      vbt_walk_top:
        // Need 3 bytes for a block header.
        mov rax, rbx;
        add rax, 3;
        cmp rax, r12;
        ja  vbt_parse_ok;                    // ran off end cleanly

        // block_id (u8 @ cursor+0) → r9 (callee-saved not required; this
        // dispatch does not survive the per-block call, we just need the
        // compare chain below).
        xor r9, r9;
        mov_b r9, [rbx + 0];

        // block_size (u16 @ cursor+1) → rcx (scratch; also stashed in
        // r14 as `advance` so we survive the call clobber).
        xor rcx, rcx;
        mov_w rcx, [rbx + 1];

        // r14 = advance = 3 + block_size (survives nested callee-save
        // callers per SysV).
        mov r14, rcx;
        add r14, 3;

        // Bounds-check cursor + advance <= end.
        mov rax, rbx;
        add rax, r14;
        cmp rax, r12;
        ja  vbt_parse_ok;                    // truncated final block — stop

        // Dispatch on block_id (r9).

        cmp r9, 2;
        jne vbt_walk_check_27;
        mov rdi, rbx;
        add rdi, 3;
        mov rsi, rcx;
        mov rdx, r15;
        call vbt_decode_block2;
        jmp vbt_walk_advance;

      vbt_walk_check_27:
        cmp r9, 27;
        jne vbt_walk_check_42;
        mov rdi, rbx;
        add rdi, 3;
        mov rsi, rcx;
        mov rdx, r15;
        call vbt_decode_block27;
        jmp vbt_walk_advance;

      vbt_walk_check_42:
        cmp r9, 42;
        jne vbt_walk_check_43;
        mov rdi, rbx;
        add rdi, 3;
        mov rsi, rcx;
        mov rdx, r15;
        call vbt_decode_block42;
        jmp vbt_walk_advance;

      vbt_walk_check_43:
        cmp r9, 43;
        jne vbt_walk_check_44;
        mov rdi, rbx;
        add rdi, 3;
        mov rsi, rcx;
        mov rdx, r15;
        call vbt_decode_block43;
        jmp vbt_walk_advance;

      vbt_walk_check_44:
        cmp r9, 44;
        jne vbt_walk_advance;
        mov rdi, rbx;
        add rdi, 3;
        mov rsi, rcx;
        mov rdx, r15;
        call vbt_decode_block44;
        // fallthrough

      vbt_walk_advance:
        // cursor += advance (3 + block_size); r14 survives the call per
        // SysV callee-save convention.
        add rbx, r14;
        jmp vbt_walk_top;

      vbt_parse_ok:
        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      vbt_parse_fail:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §G  vbt_decode_block2(payload, len, out) -> ()
  //
  //     Child Device Table decoder. Reads child_dev_size at payload+8,
  //     iterates array at payload+9 up to (len-9)/stride entries; emits
  //     one 16-byte vbt_port_t per entry into the ports slot at
  //     out+VBT_TOPO_OFF_PORTS, bumping out+VBT_TOPO_OFF_N_PORTS by 1
  //     per emitted entry. Caps at VBT_MAX_PORTS; over-count ports are
  //     silently dropped (design doc §6.2 forward-compatibility rule).
  //
  //     Supported child_dev_size values: 33, 38, 40, 41. All four share
  //     the same six-field extraction offsets (device_type @ +2,
  //     dvo_port @ +0x0E, i2c_pin @ +0x0F, slave_addr @ +0x10,
  //     ddc_pin @ +0x11, edid_ptr @ +0x12, lane_count @ +0x16,
  //     hpd_pin @ +0x17, aux_channel @ +0x18) because the per-size
  //     deltas appear in the reserved trailing bytes.
  // ==========================================================================

  pub let vbt_decode_block2 : (u64, u64, u64) -> () !{mem} @{} =
    fn (payload: u64, payload_len: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Block 2 decoder — Child Device Table. Reads child_dev_size (u8 @ payload+8) via xor+mov_b; validates in {33, 38, 40, 41}; else returns silently (unknown layout). Computes array_bytes = payload_len - 9; iterates i while i*stride + stride <= array_bytes. Per entry: load device_type (u16 @ entry+2) via xor+mov_w into rbx; dvo_port (u8 @ entry+0x0E), aux_channel (u8 @ +0x18), hpd_pin (u8 @ +0x17), lane_count (u8 @ +0x16) via xor+mov_b; emit a vbt_port_t at out + 112 + n_ports*16: write ddi (dvo_port) at +0 via mov_b, aux_channel +1, hpd_pin +2, lane_count+1 +3 (raw+1 adjusted), gmbus_pin +4, i2c_slave +5, is_internal (bit 12) +6, is_edp (bit 13) +7, is_dp (bit 4) +8, is_hdmi (bit 2) +9, is_mipi (bit 14) +10, _pad +11, device_type +12 via mov_w, edid_ptr +14 via mov_w. Bump n_ports (u8 @ out+3) via mov_b; stop if n_ports == VBT_MAX_PORTS (silent cap). Encoder: all compares on 64-bit registers (G4). All stores sized (G1). Reserved labels prefixed vbt_db2_. Leaf-ish — one call-less walk. 5-push callee-save prologue.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // r12 = payload
        mov r13, rsi;                        // r13 = payload_len
        mov r15, rdx;                        // r15 = out

        // Require at least 9 bytes (static header).
        cmp r13, 9;
        jb  vbt_db2_out;

        // child_dev_size (u8 @ payload+8).
        xor rax, rax;
        mov_b rax, [r12 + 8];

        // Must be in {33, 38, 40, 41}.
        cmp rax, 33;
        je  vbt_db2_size_ok;
        cmp rax, 38;
        je  vbt_db2_size_ok;
        cmp rax, 40;
        je  vbt_db2_size_ok;
        cmp rax, 41;
        je  vbt_db2_size_ok;
        jmp vbt_db2_out;

      vbt_db2_size_ok:
        mov r14, rax;                        // r14 = stride

        // array_bytes = payload_len - 9
        mov rcx, r13;
        sub rcx, 9;

        // entry cursor starts at payload+9.
        mov rbx, r12;
        add rbx, 9;

      vbt_db2_entry_top:
        // Need stride more bytes beyond cursor-vs-array-end.
        // remaining = array_bytes - (cursor - (payload+9))
        mov rax, rbx;
        mov r10, r12;
        add r10, 9;
        sub rax, r10;                        // rax = bytes consumed
        mov r11, rcx;
        sub r11, rax;                        // r11 = remaining
        cmp r11, r14;
        jb  vbt_db2_out;

        // Check port cap: n_ports (u8 @ out+3) < VBT_MAX_PORTS.
        xor rax, rax;
        mov_b rax, [r15 + 3];
        cmp rax, 8;                          // VBT_MAX_PORTS
        jae vbt_db2_out;

        // slot_off = 112 + n_ports * 16
        mov r9, rax;
        shl r9, 4;                           // n_ports * 16
        add r9, 112;                         // + VBT_TOPO_OFF_PORTS
        mov r10, r15;
        add r10, r9;                         // r10 = port slot VA

        // device_type (u16 @ entry+2) → rbx-scratch; also written at port+12.
        xor rdx, rdx;
        mov_w rdx, [rbx + 2];
        mov_w [r10 + 12], rdx;

        // dvo_port (u8 @ entry+0x0E) → port+0.
        xor r11, r11;
        mov_b r11, [rbx + 0x0E];
        mov_b [r10 + 0], r11;

        // i2c_pin (u8 @ entry+0x0F) → port+4 (gmbus_pin).
        xor r11, r11;
        mov_b r11, [rbx + 0x0F];
        mov_b [r10 + 4], r11;

        // slave_addr (u8 @ entry+0x10) → port+5 (i2c_slave).
        xor r11, r11;
        mov_b r11, [rbx + 0x10];
        mov_b [r10 + 5], r11;

        // edid_ptr (u16 @ entry+0x12) → port+14.
        xor r11, r11;
        mov_w r11, [rbx + 0x12];
        mov_w [r10 + 14], r11;

        // lane_count (u8 @ entry+0x16) → port+3 (raw+1 adjusted).
        xor r11, r11;
        mov_b r11, [rbx + 0x16];
        add r11, 1;
        mov_b [r10 + 3], r11;

        // hpd_pin (u8 @ entry+0x17) → port+2.
        xor r11, r11;
        mov_b r11, [rbx + 0x17];
        mov_b [r10 + 2], r11;

        // aux_channel (u8 @ entry+0x18) → port+1.
        xor r11, r11;
        mov_b r11, [rbx + 0x18];
        mov_b [r10 + 1], r11;

        // device_type bitmask decode → is_internal/is_edp/is_dp/is_hdmi/is_mipi.
        // is_hdmi: bit 2 (0x04) → port+9.
        mov r11, rdx;
        shr r11, 2;
        and r11, 1;
        mov_b [r10 + 9], r11;

        // is_dp: bit 4 (0x10) → port+8.
        mov r11, rdx;
        shr r11, 4;
        and r11, 1;
        mov_b [r10 + 8], r11;

        // is_internal: bit 12 (0x1000) → port+6.
        mov r11, rdx;
        shr r11, 12;
        and r11, 1;
        mov_b [r10 + 6], r11;

        // is_edp: bit 13 → port+7.
        mov r11, rdx;
        shr r11, 13;
        and r11, 1;
        mov_b [r10 + 7], r11;

        // is_mipi: bit 14 → port+10.
        mov r11, rdx;
        shr r11, 14;
        and r11, 1;
        mov_b [r10 + 10], r11;

        // Bump n_ports.
        xor rax, rax;
        mov_b rax, [r15 + 3];
        add rax, 1;
        mov_b [r15 + 3], rax;

        // Advance entry cursor.
        add rbx, r14;
        jmp vbt_db2_entry_top;

      vbt_db2_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  vbt_decode_block27(payload, len, out) -> ()
  //
  //     eDP electrical data. Three parallel 16-slot arrays:
  //       link_rate[16]   @ payload + 0
  //       lane_count[16]  @ payload + 16
  //       vswing_pre[16]  @ payload + 32 (not consumed in G1)
  //
  //     Reads slot[0] (the T14 G4 panel index) and populates
  //     out+VBT_TOPO_OFF_PANEL_EDP_RATE / _EDP_LANES. Validates:
  //       link_rate in {0..3} else leave default 0.
  //       lane_count raw in {0, 1, 3} (meaning 1, 2, 4 lanes).
  // ==========================================================================

  pub let vbt_decode_block27 : (u64, u64, u64) -> () !{mem} @{} =
    fn (payload: u64, payload_len: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Block 27 decoder — eDP electrical. Reads link_rate (u8 @ payload+0) and lane_count (u8 @ payload+16) for panel index 0 (the T14 G4 shape); validates link_rate in {0..3} and lane_count_raw in {0,1,3}; writes link_rate at out+58 and lane_count+1 at out+59 via mov_b (G1). On length < 17 the block is skipped silently. Encoder: xor+mov_b for the two reads; all compares on 64-bit registers (G4). Reserved labels prefixed vbt_db27_. Leaf; no callee-save.",
      block: {
        // Need at least 17 bytes (one slot each for link_rate + lane_count[0]).
        cmp rsi, 17;
        jb  vbt_db27_out;

        // link_rate[0] (u8 @ payload+0)
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 3;
        ja  vbt_db27_out;
        mov_b [rdx + 58], rax;

        // lane_count[0] (u8 @ payload+16)
        xor rax, rax;
        mov_b rax, [rdi + 16];
        and rax, 0xF;
        // Accept raw in {0, 1, 3} (1/2/4 lanes).
        cmp rax, 0;
        je  vbt_db27_lanes_ok;
        cmp rax, 1;
        je  vbt_db27_lanes_ok;
        cmp rax, 3;
        je  vbt_db27_lanes_ok;
        jmp vbt_db27_out;

      vbt_db27_lanes_ok:
        add rax, 1;                          // raw+1 → nominal lane count
        mov_b [rdx + 59], rax;

      vbt_db27_out:
        ret
      }
    }

  // ==========================================================================
  // §I  vbt_decode_block42(payload, len, out) -> ()
  //
  //     LFP panel info. Reads lvds_panel_type (u8 @ payload+0) and
  //     dereferences panel_dtd_t[lvds_panel_type] starting at
  //     payload + 2 + lvds_panel_type * 70. Decodes DTD fields into the
  //     panel section of the topology.
  //
  //     Reads bpp (u8 @ dtd+0x12), validates in {0..4}, maps enum to
  //     18/24/30/36/48 bits-per-pixel at out+57.
  //
  //     Computes edp_hz = (pixel_clock_khz * 1000) / (h_total * v_total)
  //     via a 64-bit mul + div-less approximation (we actually mul
  //     then shift — see justification). Written to out+62 as u16.
  // ==========================================================================

  pub let vbt_decode_block42 : (u64, u64, u64) -> () !{mem} @{} =
    fn (payload: u64, payload_len: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Block 42 decoder — LFP Panel Info. Reads lvds_panel_type (u8 @ payload+0); validates < 16; computes dtd_off = 2 + idx*70 via shl+add. Validates (dtd_off + 32) <= payload_len; else skip. Reads from DTD: pixel_clock_khz_div_10 (u16 @ dtd+0), h_active_lo (u8 @ +2), h_blank_lo (u8 @ +3), h_active_hi_blank_hi (u8 @ +4 → upper nibble = h_active high 4, lower = h_blank high 4), v_active_lo (u8 @ +5), v_blank_lo (u8 @ +6), v_active_hi_blank_hi (u8 @ +7), h_sync_offset_lo (u8 @ +8), h_sync_width_lo (u8 @ +9), flags (u8 @ +0x11), bpp_enum (u8 @ +0x12). Reconstructs full scalars by shift-combine. bpp decode: 0→18, 1→24, 2→30, 3→36, 4→48; else leave panel_present at 0 and return. Writes native_hres @ out+64, native_vres @ out+66, h_total @ out+68, v_total @ out+70, h_sync_pos @ out+72, h_sync_width @ out+74, bpp @ out+57, panel_present @ out+2 (set to 1), pixel_clock_khz (u32) @ out+92 (mov_d, G1), edp_hz @ out+62 as u16 computed via mul rcx (sets rdx:rax) then div rcx — we restrict operands to fit a single-register div (h_total * v_total <= 2^32 for any sane panel). On any out-of-range field the panel section is left zero and panel_present remains 0. Encoder: all loads unaligned-tolerant; u8 via xor+mov_b; u16 via xor+mov_w; u16/u32/u8 stores sized. Compares on 64-bit regs (G4). Reserved labels prefixed vbt_db42_. No `imul r,imm` 2-op (we use `mul r64` which produces rdx:rax). 5-push callee-save prologue.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // r12 = payload
        mov r13, rsi;                        // r13 = payload_len
        mov r15, rdx;                        // r15 = out

        // Need at least 2 bytes for lvds_panel_type + reserved.
        cmp r13, 2;
        jb  vbt_db42_out;

        // lvds_panel_type (u8 @ payload+0).
        xor rax, rax;
        mov_b rax, [r12 + 0];
        cmp rax, 16;
        jae vbt_db42_out;

        // dtd_off = 2 + idx*70 (via two-operand imul; idx*70 <= 1050 so
        // the low-64 result from imul rax,rcx is byte-exact).
        mov rcx, 70;
        imul rax, rcx;                       // rax = idx*70
        mov r14, rax;
        add r14, 2;                          // r14 = dtd_off

        // Require dtd_off + 32 <= payload_len (full DTD core + bpp byte).
        mov r10, r14;
        add r10, 32;
        cmp r10, r13;
        ja  vbt_db42_out;

        // dtd base = payload + dtd_off.
        mov rbx, r12;
        add rbx, r14;                        // rbx = dtd base

        // pixel_clock_khz_div_10 (u16 @ dtd+0).
        xor rax, rax;
        mov_w rax, [rbx + 0];
        cmp rax, 0;
        je  vbt_db42_out;                    // zero → headless; leave panel absent

        // pixel_clock_khz = pclk_div_10 * 10 (two-op imul; max ~500 kHz
        // for a 5 GHz pixel clock, well within imul r64,r64 truncation).
        mov rcx, 10;
        imul rax, rcx;                       // rax = pclk_khz
        mov r14, rax;                        // r14 = pixel_clock_khz

        // Store pixel_clock_khz as u32 @ out+92 (G1).
        mov_d [r15 + 92], r14;

        // h_active = h_active_lo | ((h_active_hi_blank_hi >> 4) << 8)
        xor rax, rax;
        mov_b rax, [rbx + 2];                // h_active_lo
        xor rcx, rcx;
        mov_b rcx, [rbx + 4];                // h_active_hi_blank_hi
        mov r10, rcx;
        shr r10, 4;                          // upper nibble
        shl r10, 8;
        or  rax, r10;                        // rax = h_active
        mov_w [r15 + 64], rax;               // native_hres
        mov r9, rax;                         // r9 = h_active

        // h_blank = h_blank_lo | ((h_active_hi_blank_hi & 0x0F) << 8)
        xor rax, rax;
        mov_b rax, [rbx + 3];                // h_blank_lo
        and rcx, 0x0F;
        shl rcx, 8;
        or  rax, rcx;
        add r9, rax;                         // r9 = h_total
        mov_w [r15 + 68], r9;                // h_total

        // v_active = v_active_lo | ((v_active_hi_blank_hi >> 4) << 8)
        xor rax, rax;
        mov_b rax, [rbx + 5];                // v_active_lo
        xor rcx, rcx;
        mov_b rcx, [rbx + 7];                // v_active_hi_blank_hi
        mov r10, rcx;
        shr r10, 4;
        shl r10, 8;
        or  rax, r10;
        mov_w [r15 + 66], rax;               // native_vres
        mov r11, rax;                        // r11 = v_active

        // v_blank = v_blank_lo | ((v_active_hi_blank_hi & 0x0F) << 8)
        xor rax, rax;
        mov_b rax, [rbx + 6];                // v_blank_lo
        and rcx, 0x0F;
        shl rcx, 8;
        or  rax, rcx;
        add r11, rax;                        // r11 = v_total
        mov_w [r15 + 70], r11;               // v_total

        // h_sync_pos = h_sync_offset_lo (u8 @ dtd+8); ignore high bits in G1.
        xor rax, rax;
        mov_b rax, [rbx + 8];
        mov_w [r15 + 72], rax;

        // h_sync_width = h_sync_width_lo (u8 @ dtd+9); same simplification.
        xor rax, rax;
        mov_b rax, [rbx + 9];
        mov_w [r15 + 74], rax;

        // v_sync offset/width packed byte @ dtd+0x0A — split nibbles.
        xor rax, rax;
        mov_b rax, [rbx + 0x0A];
        mov r10, rax;
        shr r10, 4;                          // v_sync_off_lo (upper nibble)
        and r10, 0x0F;
        mov_w [r15 + 76], r10;
        mov r10, rax;
        and r10, 0x0F;                       // v_sync_width_lo (lower nibble)
        mov_w [r15 + 78], r10;

        // flags (u8 @ dtd+0x11) — h_sync_pol = bit 1, v_sync_pol = bit 2.
        xor rax, rax;
        mov_b rax, [rbx + 0x11];
        mov r10, rax;
        shr r10, 1;
        and r10, 1;
        mov_b [r15 + 60], r10;               // h_sync_pol
        mov r10, rax;
        shr r10, 2;
        and r10, 1;
        mov_b [r15 + 61], r10;               // v_sync_pol

        // bpp decode (u8 @ dtd+0x12): 0→18, 1→24, 2→30, 3→36, 4→48.
        xor rax, rax;
        mov_b rax, [rbx + 0x12];
        cmp rax, 0;
        je  vbt_db42_bpp_18;
        cmp rax, 1;
        je  vbt_db42_bpp_24;
        cmp rax, 2;
        je  vbt_db42_bpp_30;
        cmp rax, 3;
        je  vbt_db42_bpp_36;
        cmp rax, 4;
        je  vbt_db42_bpp_48;
        jmp vbt_db42_out;                    // invalid → panel_present stays 0

      vbt_db42_bpp_18:
        mov rax, 18;
        jmp vbt_db42_bpp_store;
      vbt_db42_bpp_24:
        mov rax, 24;
        jmp vbt_db42_bpp_store;
      vbt_db42_bpp_30:
        mov rax, 30;
        jmp vbt_db42_bpp_store;
      vbt_db42_bpp_36:
        mov rax, 36;
        jmp vbt_db42_bpp_store;
      vbt_db42_bpp_48:
        mov rax, 48;
        jmp vbt_db42_bpp_store;

      vbt_db42_bpp_store:
        mov_b [r15 + 57], rax;

        // panel_present = 1 (u8 @ out+2).
        mov rax, 1;
        mov_b [r15 + 2], rax;

        // ddi_port — fill later from Block 2 (0=A on T14 G4). Leave 0.

        // edp_hz = (pixel_clock_khz * 1000) / (h_total * v_total)
        //
        // Guard against h_total or v_total == 0.
        xor rax, rax;
        mov_w rax, [r15 + 68];               // h_total
        cmp rax, 0;
        je  vbt_db42_out;
        xor rcx, rcx;
        mov_w rcx, [r15 + 70];               // v_total
        cmp rcx, 0;
        je  vbt_db42_out;

        // htot * vtot (both <= 2^16, so product <= 2^32; two-op imul low 64).
        imul rax, rcx;                       // rax = h_total * v_total
        mov r11, rax;                        // r11 = htot*vtot (fits in 32 bits)

        // pixel_clock_hz = pixel_clock_khz * 1000 (pclk_khz <= ~500k so
        // the product fits comfortably in u64).
        mov rax, r14;                        // r14 = pixel_clock_khz
        mov rcx, 1000;
        imul rax, rcx;                       // rax = pclk_hz

        // Divide rdx:rax by r11; rax = edp_hz, rdx = remainder.
        xor rdx, rdx;                        // zero high half for div
        div r11;                             // rax = edp_hz

        // Store as u16.
        mov_w [r15 + 62], rax;

      vbt_db42_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  vbt_decode_block43(payload, len, out) -> ()
  //
  //     Backlight power. Reads entry_size (u8 @ payload+0), then
  //     entry[0] (the T14 G4 shape) starting at payload+1. Fields:
  //       backlight_type (u8 @ entry+0)
  //       polarity       (u8 @ entry+1)
  //       pwm_frequency  (u16 @ entry+2)
  //       min_brightness (u8 @ entry+4)
  //       default_bright (u8 @ entry+5)
  //       brightness_curve (u8[10] @ entry+6)
  // ==========================================================================

  pub let vbt_decode_block43 : (u64, u64, u64) -> () !{mem} @{} =
    fn (payload: u64, payload_len: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Block 43 decoder — LFP Backlight Power. Reads entry_size (u8 @ payload+0), validates >= 16 and payload_len >= 1+16; reads entry[0]: backlight_type → out+4, polarity → out+5, pwm_frequency_hz → out+6 (mov_w, G1), min_brightness_pct → out+8, default_brightness_pct → out+9. Copies 10-byte brightness_curve byte-by-byte into out+10..19 via a small loop. All writes sized (G1); all compares on 64-bit regs (G4). Reserved labels prefixed vbt_db43_. 5-push callee-save prologue.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // r12 = payload
        mov r13, rsi;                        // r13 = payload_len
        mov r15, rdx;                        // r15 = out

        // Need at least 17 bytes (1 header + 16 entry).
        cmp r13, 17;
        jb  vbt_db43_out;

        // entry_size (u8 @ payload+0).
        xor rax, rax;
        mov_b rax, [r12 + 0];
        cmp rax, 16;
        jb  vbt_db43_out;                    // smaller entries not supported

        // entry = payload + 1.
        mov rbx, r12;
        add rbx, 1;

        // backlight_type (u8 @ entry+0) → out+4.
        xor rax, rax;
        mov_b rax, [rbx + 0];
        mov_b [r15 + 4], rax;

        // polarity (u8 @ entry+1) → out+5.
        xor rax, rax;
        mov_b rax, [rbx + 1];
        mov_b [r15 + 5], rax;

        // pwm_frequency_hz (u16 @ entry+2) → out+6 (mov_w).
        xor rax, rax;
        mov_w rax, [rbx + 2];
        mov_w [r15 + 6], rax;

        // min_brightness_pct (u8 @ entry+4) → out+8.
        xor rax, rax;
        mov_b rax, [rbx + 4];
        mov_b [r15 + 8], rax;

        // default_brightness_pct (u8 @ entry+5) → out+9.
        xor rax, rax;
        mov_b rax, [rbx + 5];
        mov_b [r15 + 9], rax;

        // brightness_curve: copy 10 bytes @ entry+6 → out+10.
        xor rcx, rcx;
      vbt_db43_curve_top:
        cmp rcx, 10;
        jae vbt_db43_out;
        mov r9, rbx;
        add r9, 6;
        add r9, rcx;
        mov r10, r15;
        add r10, 10;
        add r10, rcx;
        xor rax, rax;
        mov_b rax, [r9];
        mov_b [r10], rax;
        add rcx, 1;
        jmp vbt_db43_curve_top;

      vbt_db43_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  vbt_decode_block44(payload, len, out) -> ()
  //
  //     Backlight control override. Block 44 pins the controller:
  //       0 → PWM only
  //       1 → DP-AUX ("backlight over AUX")
  //       2 → combo (PWM for level, AUX for enable)
  //
  //     Open-question Q6 (design doc §15): Block 44 schema has two
  //     dialects — v1 (single byte per panel index) and v2 (richer
  //     16-byte entries carrying PWM min/max freq). This body
  //     implements the v1 shape (byte 0 of payload = controller type
  //     for panel index 0) and leaves the min/max frequency bounds
  //     check for v2 as a follow-up. The parser's Block 43 reading
  //     already seeded backlight_type from the richer v2 field, so
  //     a v1 override here is a redundant write for forward
  //     compatibility on firmwares that only publish Block 44.
  // ==========================================================================

  pub let vbt_decode_block44 : (u64, u64, u64) -> () !{mem} @{} =
    fn (payload: u64, payload_len: u64, out: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "Wave 59 G1 (paideia-os#2538). Block 44 decoder — LFP Backlight Control override. v1 shape: byte 0 of payload is the controller type for panel index 0 (0=PWM, 1=AUX, 2=combo). If payload_len < 1 the block is skipped. Writes override at out+4 (backlight_type) via mov_b (G1). All compares on 64-bit regs (G4). Reserved labels prefixed vbt_db44_. Leaf; no callee-save.",
      block: {
        cmp rsi, 1;
        jb  vbt_db44_out;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 2;
        ja  vbt_db44_out;                    // reject out-of-range types
        mov_b [rdx + 4], rax;
      vbt_db44_out:
        ret
      }
    }
}
