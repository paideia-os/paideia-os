// src/kernel/core/drivers/dpy/font_cascade.pdx -- Wave 82 G12 [G4] (#2549)
//
// Font fallback cascade SKELETON for Wave 82 G12. Modern text pipelines
// register a priority-ordered chain of fonts: the primary (e.g. a Latin
// text face), followed by secondaries that cover scripts the primary
// does not (CJK via Noto CJK, emoji via a colour-font fallback, legacy
// box-drawing via a monospace stage). Resolve walks the chain and
// returns the first font whose coverage bitmap carries the requested
// codepoint. The pattern is standard in DirectWrite's IDWriteFontFallback
// (MSDN "Font fallback" §Font fallback mapping), fontconfig's FcSort
// (fontconfig(3)) and HarfBuzz / FreeType's shaping chain; the paideia-
// os port keeps the shape -- priority walk + per-font coverage bitset
// gate -- while cutting every runtime-pluggable policy (no fontconfig
// XML, no language-tag heuristics) so the entire fallback step is
// O(fonts) with no scan structure past this file.
//
// Each cascade slot binds (A) a GPU-BO handle holding the font's SDF
// atlas tiles (Wave 79 G11 KIND_SDF_ATLAS, #2548), (B) a side u64
// pointer to a per-font coverage bitmap (one bit per codepoint across
// a configurable BMP range; default 0x0000..0xFFFF, 8 KiB), and (C) a
// priority u64 that orders candidates when more than one font covers
// the same codepoint. Registration APPENDS into the next free row;
// resolve TRAVERSES in descending priority order and returns the
// first covering font's cap. Unregister clears a row by font_cap.
//
// This file sits above drivers/dpy/sdf_atlas.pdx (Wave 79 G11, #2548)
// which handles the atlas-side glyph-rect lookup once the covering
// font is chosen. The cascade decides WHICH font owns a codepoint;
// the atlas then returns the (u, v, w, h) atlas rect at which the
// glyph's SDF tile is resident. This is the standard two-stage split
// in modern text pipelines: shape (per-codepoint font selection,
// per-codepoint glyph index) then layout (per-glyph atlas rect +
// quad stamp). The shape stage lives here; the layout stage lives
// in sdf_atlas. The real shape stage will later consume paideia-as-
// unicode's complex-shaping output (fingerprint: Harfbuzz-style
// glyph-cluster post-reordering); the skeleton short-circuits that
// to a 1-to-1 codepoint-to-font map so the ABI + state shape freeze
// at this layer without the complex-shaping dependency.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// Posture: EVERY body here is a STUB per the Wave 82 G12 skeleton
// directive. The cascade capacity (8 fonts), the row shape (6 u64 per
// row = 48 bytes), the coverage bitmap shape (one bit per codepoint
// in a configurable BMP range, default 0x0000..0xFFFF with an 8 KiB
// bitmap), the error taxonomy (0xFFFFFD16..1A), the fingerprint tags,
// and the invoke slot (0x55) are FROZEN at this skeleton stage so a
// follow-up slice can land the real resolve-with-complex-shaping path
// against the same ABI + constants without churn. The static state
// blocks, the fingerprint tags, and the counter bumps are real; the
// resolve path's coverage-bitmap gate IS wired (reads a bit from the
// caller-provided bitmap pointer if non-zero; treats a zero bitmap_ptr
// as "covers all" so a skeleton consumer that passes a bare font_cap
// without a bitmap still gets a return value).
//
// On the Wave 82 G12 skeleton, every entrypoint:
//   (1) range-checks its inputs against the frozen cascade / bitmap
//       geometry (see §4 for the error taxonomy);
//   (2) consults the module-level _cascade_table state block;
//   (3) records the request into the state block (register / unregister
//       mutate; resolve is read-only);
//   (4) bumps the per-op counter so an operator can see the entry
//       on a boot-witness programme;
//   (5) emits a fingerprint on register / resolve so init-stage events
//       show up on the klog wire (unregister is counter-only to keep
//       the wire quiet during steady-state cascade churn).
//
// =============================================================================
// SECTION 1  CASCADE GEOMETRY
// =============================================================================
//
// Capacity: 8 fonts, chosen because (a) the DirectWrite default system
// fallback has 7 entries (Latin + Chinese + Japanese + Korean + Arabic +
// Hebrew + Symbol per the IDWriteFontFallbackBuilder MSDN example) and
// 8 leaves one slot for the colour-emoji font the T14 G4 panel renders;
// (b) a tighter cap would clip the realistic Latin+CJK+emoji+legacy
// workload; (c) a larger cap grows the state block without a measured
// consumer and the follow-up slice can bump FC_MAX_SLOTS cleanly if
// multi-cluster shaping ever uses it.
//
// Row stride: 6 u64 = 48 bytes. Field offsets within a 48-byte row:
//
//     +0    font_cap                 -- the KIND_SDF_ATLAS cap row id
//                                        (G11 Wave 79) or any cap the
//                                        downstream glyph resolver can
//                                        key off. 0 means EMPTY SLOT
//                                        (sentinel; a valid font cap
//                                        is never 0 because row 0 of
//                                        the cap manifest is reserved
//                                        for KIND_NULL across the tree)
//     +8    priority                 -- u64, higher value tried first
//                                        in the resolve walk. The
//                                        skeleton does not canonicalise
//                                        priority (two slots may share
//                                        a value, in which case the
//                                        resolve walk returns the
//                                        lower-indexed slot's cap --
//                                        stable ordering)
//     +16   coverage_bitmap_ptr      -- u64, PA of a bit-per-codepoint
//                                        bitmap. 0 means NO BITMAP
//                                        PROVIDED, which the skeleton
//                                        treats as "covers all" so the
//                                        resolve path still returns a
//                                        valid font_cap. A follow-up
//                                        slice may upgrade this to
//                                        REFUSE a 0 bitmap once the
//                                        real font-loading path mints
//                                        bitmaps at register time
//     +24   coverage_bitmap_len      -- u64 byte count, 8 KiB default
//                                        (0x2000). Only consulted by
//                                        the follow-up slice's bounds-
//                                        check on the bitmap byte load;
//                                        the skeleton reads a single
//                                        byte at (codepoint >> 3) with
//                                        no range gate since the default
//                                        BMP range (0..0xFFFF) always
//                                        fits
//     +32   flags                    -- u64, per-font flags (bit 0 =
//                                        active; bit 1 = colour font;
//                                        bit 2..63 reserved for the
//                                        follow-up slice). The skeleton
//                                        sets flags=0 on register and
//                                        does not consult it on resolve
//     +40   reserved                 -- u64, padding to 48 bytes. 0 at
//                                        skeleton stage; the follow-up
//                                        slice may claim this for a
//                                        secondary coverage field (e.g.
//                                        a per-font ligature table ptr
//                                        or a per-font ascent delta)
//
// Total state: 48 bytes/row x 8 rows = 384 bytes. Aligned 64 so the
// row stride does not straddle a cacheline boundary mid-row.
//
// =============================================================================
// SECTION 2  COVERAGE BITMAP SHAPE
// =============================================================================
//
// Default range: 0x0000..0xFFFF (BMP = Basic Multilingual Plane, the
// first 65536 codepoints). One bit per codepoint = 65536 bits = 8 KiB
// per font. For a cascade of 8 fonts the aggregate bitmap state is
// 64 KiB -- small enough to keep resident while a follow-up slice
// matures the real loader.
//
// Lookup arithmetic (as spelled in the task directive):
//
//     byte_offset = codepoint >> 3
//     bit_mask    = 1 << (codepoint & 7)
//     covered     = *(coverage_bitmap_ptr + byte_offset) & bit_mask
//
// The skeleton reads ONE byte at (bitmap_ptr + byte_offset) via
// `mov_b` and tests the mask bit via `and r, imm8`. No multi-byte
// read; no range-check against coverage_bitmap_len (the default BMP
// range always fits). The follow-up slice adds the range gate once
// non-default (supplementary-plane, 0x10000+) bitmaps start minting.
//
// Supplementary planes (codepoints > 0xFFFF) are REFUSED at the
// resolve entrypoint with FC_ERR_BAD_CODEPOINT (0xFFFFFD19). A later
// slice extends the bitmap to a two-level trie (plane header + per-
// plane 8 KiB chunks) without churning the cascade row shape.
//
// =============================================================================
// SECTION 3  RESOLVE WALK
// =============================================================================
//
// Priority-ordered walk, O(FC_MAX_SLOTS) = O(8). The skeleton scans
// all 8 rows and tracks the (best_priority, best_font_cap) pair of
// the covering slot with the highest priority. One linear sweep
// delivers the answer without a sort pass -- fontconfig's FcSort
// does the same under a comparator; DirectWrite's fallback mapper
// does an identical priority-max walk under its ranges-per-run
// scaffolding. For 8 rows a sort would amortise over nothing.
//
// Walk shape (pseudocode):
//
//     best_cap  = 0
//     best_pri  = 0
//     for i in 0..8:
//         row = _cascade_table + i * 48
//         fc  = row[+0]
//         if fc == 0: continue          # empty slot
//         pri = row[+8]
//         bmp = row[+16]
//         if bmp == 0:
//             # skeleton: no bitmap means "covers all"
//             covered = 1
//         else:
//             byte_off = codepoint >> 3
//             bit_mask = 1 << (codepoint & 7)
//             covered  = *(bmp + byte_off) & bit_mask
//         if covered == 0: continue
//         if best_cap == 0 or pri > best_pri:
//             best_cap = fc
//             best_pri = pri
//     return best_cap != 0 ? best_cap : FC_ERR_NO_FONT_COVERS
//
// Tie-break: higher priority wins. Equal priority: lower slot index
// wins (the walk visits rows in index order and only replaces on
// STRICTLY greater priority). The skeleton makes this stable so a
// follow-up slice can rely on it when it mints a tie-break policy.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFFD16..0xFFFFFD1A
// =============================================================================
//
// Five codes reserved for this module from the free band the Wave 81
// pstate.pdx header set aside (its §4 names 0xFFFFFD16..1A as "reserved
// for the follow-up slice's handle-expiry / walker-not-ready / bad-
// cap-arg plumbing" -- a comment-only reservation that no code claims).
// Audit at landing time: `grep -rnE '0xFFFFFD1[6-9A]\b' src/` returned
// ONE hit, pstate.pdx L174 (the comment above). The band fits imm32
// bit 31 clear (sign-extend-safe) so each sentinel loads via plain
// `mov r64, 0xFFFFFD1X` without r11 staging. Natural neighbour of the
// pstate band (0xFFFFFD11..15) one notch below, the vmd/root_complex
// band (0xFFFFFD1B..1F) one notch above, and the ec_discovery band
// (0xFFFFFD44..48) further up.
//
// Disjoint from:
//   PSTATE_*          (0xFFFFFD11..15, drivers/acpi/pstate.pdx)
//   VMD_RC_*          (0xFFFFFD1B..1F, drivers/vmd/root_complex.pdx)
//   ECD_*             (0xFFFFFD44..48, drivers/acpi/ec_discovery.pdx)
//   DP_*              (0xFFFFFD49..4D, drivers/dpy/damage_plane.pdx)
//   SDF_ATLAS_*       (0xFFFFFD58..5C, drivers/dpy/sdf_atlas.pdx)
//
//     0xFFFFFD16  FC_ERR_BAD_FONT_CAP     -- font_cap argument is 0
//                                            (register / unregister
//                                            paths). 0 is the empty-
//                                            slot sentinel so a 0 cap
//                                            cannot be stored
//     0xFFFFFD17  FC_ERR_CASCADE_FULL     -- register could not find
//                                            an empty slot in 0..7
//                                            (all 8 rows have a non-
//                                            zero font_cap)
//     0xFFFFFD18  FC_ERR_UNKNOWN_FONT     -- unregister did not find
//                                            a row whose font_cap
//                                            matches the argument
//     0xFFFFFD19  FC_ERR_BAD_CODEPOINT    -- resolve codepoint is
//                                            outside the BMP range
//                                            (> 0xFFFF). Supplementary
//                                            planes are refused at
//                                            this layer; a follow-up
//                                            slice extends to a two-
//                                            level bitmap trie
//     0xFFFFFD1A  FC_ERR_NO_FONT_COVERS   -- resolve walked the full
//                                            cascade and no slot's
//                                            coverage bitmap carried
//                                            the requested codepoint
//                                            (also returned when the
//                                            cascade is entirely
//                                            empty)
//
// =============================================================================
// SECTION 5  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized stores): the row writes land as 64-bit `mov [reg + imm],
//      r64` which the paideia-as encoder renders as REX.W mov m64, r64
//      -- no byte-sized stores here.
//   G4 (full-register compares): every cmp is on a 64-bit register;
//      no `cmp al, imm`, no `cmp eax, imm` short-form.
//   No `test rN, rN` -- equality-against-zero is `cmp rN, 0`.
//   No `and rN, imm64` -- the bit-mask shift (1 << (codepoint & 7))
//      stages through rcx (variable shift), and the three BMP range
//      masks (0xFFFF for codepoint ceiling, 7 for the mod-8 bit index,
//      0x1 for the covered-bit test) all fit imm8.
//   No two-operand `imul r, imm` -- row stride 48 folds through
//      `mov r11, 48; imul rax, r11` (reg-reg form) per the task
//      directive's pdx-encoder-pitfalls memo. The alternative
//      `shl rax, 5; mov r11, rax; shr r11, 1; add rax, r11` (48 =
//      32 + 16) also fits paideia-as's imm8 shl + reg-reg add
//      repertoire, but the reg-reg imul form is simpler to audit.
//   64-bit immediates -- FC_MAX_SLOTS (8), FC_ROW_STRIDE_BYTES (48),
//      FC_BMP_RANGE_MAX (0xFFFF) all fit imm32 bit 31 clear. The error
//      sentinels (0xFFFFFD16..1A) also fit imm32 with bit 31 clear so
//      the paideia-as encoder emits them via plain `mov r64, imm32`
//      sign-extended by REX.W -- same posture as the pstate band
//      above and the sdf_atlas band below.
//   Multiline `pub let ="..."` is forbidden by the pdx parser; every
//      tag below is a single line.
//   Module basename matches filename basename:
//      font_cascade.pdx -> module FontCascade.
//   Reserved labels -- every label in this file is prefixed `fc_`
//      with a sub-prefix per entrypoint (`fc_rg_` for register,
//      `fc_rs_` for resolve, `fc_ur_` for unregister, `fc_hd_` for
//      the handler) so none collides with the ds_/ixc_/sdf_/dp_
//      labels of the sibling dpy drivers, and none spells `loop`,
//      `if`, or `let`.
//   klog wrapper discipline -- both fingerprints use klog_s1_x1_d1
//      (one hex + one decimal KV). The RESOLVE fingerprint is
//      ORDERED cap=<hex> cp=<dec> rather than the task-directive-
//      spelled cp=<dec> cap=<hex> because the klog wrapper repertoire
//      has no klog_s1_d1_x1 (dec-then-hex) shape, and information-
//      preserving re-ordering is the scope-appropriate answer (same
//      posture as sdf_atlas.pdx §E for its INIT line's compound
//      value and r111.M6-024 fw/loader.pdx §justification). Caller
//      pushes vd at caller [rsp+0] (which the wrapper reads at
//      [rbp+16] after its own `push rbp`); writing vd to [rsp+8] is
//      the klog_s1_x1_d1 caller trap called out in the Wave 82
//      directive which has burned 7+ softarchs this session. Stack
//      recipe for klog_s1_x1_d1 at a 5-push callsite: `sub rsp, 16;
//      mov [rsp+0], <vd>; call klog_s1_x1_d1; add rsp, 16`.
//   Fingerprint tag `[u8; N]` length is `strlen + 1` (NUL terminator);
//      a tag_len off-by-one is a build-time error.
//
// =============================================================================
// SECTION 6  STACK + REGISTER PLAN
// =============================================================================
//
// Four entry shapes (plus the cap handler + four leaf getters):
//
//   font_cascade_register(font_cap, priority) -> u64
//   font_cascade_resolve(codepoint) -> u64
//   font_cascade_unregister(font_cap) -> u64
//   cap_handler_font_cascade(rights, target_ptr, op_arg) -> u64
//
// REGISTER (5-push + klog_s1_x1_d1 1-stack-arg): rbx = font_cap, r12 =
// priority, r13 = loop idx, r14 = row base ptr, r15 = chosen slot_idx.
// Entry rsp%16==8; after 5 pushes rsp%16==0. klog recipe: `sub rsp, 16;
// mov [rsp+0], r12 (priority as vd); call klog_s1_x1_d1; add rsp, 16`
// which keeps rsp%16==0 pre-CALL and reclaims the pad + vd slot.
//
// RESOLVE (5-push + klog_s1_x1_d1 1-stack-arg): rbx = codepoint, r12 =
// best_font_cap (initially 0), r13 = best_priority (initially 0), r14 =
// loop idx, r15 = row base ptr. Same alignment and klog recipe as
// REGISTER; vd = codepoint (rbx) since the fingerprint renders cp as
// decimal and the hex kv is best_font_cap (r12).
//
// UNREGISTER (3-push, no klog): rbx = font_cap, r12 = loop idx, r13 =
// row base ptr. Entry rsp%16==8; after 3 pushes rsp%16==0.
//
// cap_handler (3-push + klog_s1 chatter): rbx = rights, r12 = scratch,
// r13 = op_code. Entry rsp%16==8; after 3 pushes rsp%16==0.
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file compiles
// alongside the kernel because tools/build.sh recurses through src/
// kernel/ with `find -name '*.pdx' | compile-one.sh`, so a new .pdx
// in src/kernel/core/drivers/dpy/ is picked up automatically; no
// build.sh edit required.
//
// invoke.pdx gets ONE new dispatch arm (0x55 -> cap_handler_font_cascade)
// landed alongside this file (see invoke.pdx §Wave 82 G12 arm). Slot
// 0x55 is free per `grep -nE 'cmp rcx, 0x55\b' src/kernel/core/cap/
// invoke.pdx` returning no hits; the sibling Wave 81 arms claim 0x52
// (KIND_KBD_ROUTE), 0x53 (KIND_TP_ROUTE), and 0x54 (KIND_PSTATE),
// leaving 0x55 as the next natural slot.
//
// klog/wrappers.pdx needs no new mints: klog_s1_x1_d1 landed in M1-004
// (#686) and klog_s1 landed in R0 (bringup); both are proven callers
// at this point.
//
// No caller invokes font_cascade_* yet. A follow-up slice adds a boot-
// witness programme at tests/kernel/drivers/wit_font_cascade.pdx that:
//   (1) font_cascade_register(latin_cap=0x1111, priority=100) -> 0;
//   (2) font_cascade_register(cjk_cap=0x2222, priority=50)   -> 1;
//   (3) font_cascade_resolve(U+0041 'A') -> latin_cap (bitmap_ptr=0
//       skeleton short-circuit treats every slot as "covers all" so
//       the max-priority slot wins);
//   (4) font_cascade_unregister(latin_cap) -> 0;
// and asserts the two fingerprints land on the klog wire.

module FontCascade = structure {

  // ==========================================================================
  // §A  Cascade geometry
  //
  // 8 slots, 6 u64 per slot = 384 bytes total. Aligned 64 so a row
  // never straddles a cacheline boundary. See SECTION 1 for the row
  // field layout and SECTION 2 for the bitmap arithmetic.
  // ==========================================================================

  pub let FC_MAX_SLOTS            : u64 = 8
  pub let FC_ROW_STRIDE_BYTES     : u64 = 48

  // Byte offsets within a 48-byte row.
  pub let FC_ROW_OFF_FONT_CAP     : u64 = 0
  pub let FC_ROW_OFF_PRIORITY     : u64 = 8
  pub let FC_ROW_OFF_BMP_PTR      : u64 = 16
  pub let FC_ROW_OFF_BMP_LEN      : u64 = 24
  pub let FC_ROW_OFF_FLAGS        : u64 = 32
  pub let FC_ROW_OFF_RESERVED     : u64 = 40

  // ==========================================================================
  // §B  Coverage bitmap geometry
  //
  // Default range 0x0000..0xFFFF (BMP). 65536 bits = 8 KiB per font.
  // Supplementary-plane codepoints (> 0xFFFF) are refused at the
  // resolve entrypoint with FC_ERR_BAD_CODEPOINT.
  // ==========================================================================

  pub let FC_BMP_RANGE_MAX        : u64 = 0xFFFF
  pub let FC_BMP_DEFAULT_BYTES    : u64 = 0x2000     // 8 KiB

  // ==========================================================================
  // §C  Failure taxonomy -- band 0xFFFFFD16..0xFFFFFD1A
  //
  // See §4 of the file header for the full band derivation. Summary:
  // the Wave 81 pstate.pdx header set 0xFFFFFD16..1A aside as a
  // comment-only reservation; this file claims that band because the
  // pstate "follow-up slice's handle-expiry" use case lives one layer
  // down (in the cap layer, not the driver layer) and has not materi-
  // alised across the paideia-as debt loop.
  // ==========================================================================

  pub let FC_OK                        : u64 = 0
  pub let FC_ERR_BAD_FONT_CAP          : u64 = 0xFFFFFD16
  pub let FC_ERR_CASCADE_FULL          : u64 = 0xFFFFFD17
  pub let FC_ERR_UNKNOWN_FONT          : u64 = 0xFFFFFD18
  pub let FC_ERR_BAD_CODEPOINT         : u64 = 0xFFFFFD19
  pub let FC_ERR_NO_FONT_COVERS        : u64 = 0xFFFFFD1A

  // ==========================================================================
  // §D  Module state
  //
  // Cascade table (8 slots x 6 u64 per slot = 48 u64 = 384 bytes).
  // Zero-init in .bss leaves every font_cap slot at 0 (= empty) until
  // a register call lands a nonzero cap.
  // ==========================================================================

  pub let mut _cascade_table : [u64; 48] = uninit @align(64)

  // Per-op counters (bumped once per successful entry). Visible via
  // the getter trio in §J.
  pub let mut _fc_register_ct    : u64 = 0
  pub let mut _fc_resolve_ct     : u64 = 0
  pub let mut _fc_unregister_ct  : u64 = 0

  // ==========================================================================
  // §E  Fingerprint tags + keys
  //
  // Two fingerprints: REGISTER (one per register call) and RESOLVE
  // (one per resolve call -- noisy; a follow-up slice may demote it
  // to LEVEL_DEBUG once a steady-state text-render workload exists).
  // Each tag is a single-line string literal (the multiline `pub let
  // ="..."` form is forbidden by the pdx parser). Tag length is
  // `strlen + 1` (NUL terminator) so a tag_len off-by-one is a build-
  // time error.
  //
  // Fingerprints on the wire:
  //   FONT_CASCADE REGISTER cap=0x<16-hex> priority=<dec>
  //   FONT_CASCADE RESOLVE cap=0x<16-hex> cp=<dec>
  //
  // RESOLVE's KV order is REVERSED from the task directive (which
  // spelled `cp=<dec> cap=0x<hex>`) because the klog wrapper
  // repertoire has no klog_s1_d1_x1 shape. The two renderings carry
  // the same information; the fingerprint golden file matches this
  // file's shape verbatim.
  //
  // Matches tests/fingerprints/font_cascade.golden pattern.
  // ==========================================================================

  pub let fc_tag_register  : [u8; 22] = "FONT_CASCADE REGISTER\0"
  pub let fc_tag_resolve   : [u8; 21] = "FONT_CASCADE RESOLVE\0"

  pub let fc_k_cap         : [u8; 4]  = "cap\0"
  pub let fc_k_priority    : [u8; 9]  = "priority\0"
  pub let fc_k_cp          : [u8; 3]  = "cp\0"

  // Handler-entry chatter tag (for the cap-handler path).
  pub let fc_tag_handler_entry : [u8; 27] = "FONT_CASCADE handler entry\0"

  // ==========================================================================
  // §F  font_cascade_register(font_cap, priority) -> u64
  //
  // Append a (font_cap, priority) pair into the first empty row of
  // the cascade. Returns the chosen slot_idx (0..7) on success, an
  // FC_ERR_* sentinel on failure.
  //
  // Gates in order:
  //   (1) font_cap == 0            -> FC_ERR_BAD_FONT_CAP
  //   (2) scan rows 0..7 for first slot with row[+0] == 0;
  //       none found              -> FC_ERR_CASCADE_FULL
  //
  // On insert:
  //   row[+0]  = font_cap
  //   row[+8]  = priority
  //   row[+16] = 0  (bmp_ptr -- skeleton leaves unset; follow-up slice
  //                             mints bitmaps at font-load time)
  //   row[+24] = 0  (bmp_len)
  //   row[+32] = 0  (flags)
  //   row[+40] = 0  (reserved)
  //
  // Fingerprint: `FONT_CASCADE REGISTER cap=0x<hex> priority=<dec>`
  // via klog_s1_x1_d1 (vd = priority at caller [rsp+0]).
  //
  // SysV: rdi = font_cap, rsi = priority.
  // Stack recipe: 5 callee-save pushes (rbx = font_cap, r12 = priority,
  // r13 = loop idx, r14 = row base ptr, r15 = chosen slot_idx) +
  // sub rsp, 16 + mov [rsp+0], r12 for the klog_s1_x1_d1 vd arg.
  // ==========================================================================

  pub let font_cascade_register : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (font_cap: u64, priority: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 82 G12 (paideia-os#2549) skeleton: append (font_cap, priority) into first empty row of _cascade_table[0..7]. Gates: (1) font_cap == 0 -> FC_ERR_BAD_FONT_CAP (0xFFFFFD16); (2) all 8 rows filled -> FC_ERR_CASCADE_FULL (0xFFFFFD17). On insert: write row[+0]=font_cap, row[+8]=priority, row[+16..+40]=0 (bmp_ptr / bmp_len / flags / reserved all skeleton-zero; follow-up slice mints bitmaps at font-load time). Bump _fc_register_ct. Emit `FONT_CASCADE REGISTER cap=0x<hex> priority=<dec>` via klog_s1_x1_d1 (vd=priority at caller [rsp+0] per the pdx-encoder-pitfalls memo -- NOT [rsp+8]; the wrapper reads it at [rbp+16] after its own `push rbp`). Row stride is 48 bytes via the reg-reg imul form (`mov r11, 48; imul rax, r11`) per the directive's forbidden-form guardrail against 2-operand `imul r, imm`. Return value: slot_idx (0..7) on success -- disjoint from the 0xFFFFFxxx error band so a caller can `cmp rax, 8; jae error`. Register plan: rbx=font_cap (saved for row write + fingerprint), r12=priority (saved for row write + fingerprint + klog vd), r13=loop idx, r14=row base ptr, r15=chosen slot_idx. Five callee-save pushes land rsp%16==0 at every nested CALL (entry %16==8, +40 -> 48, %16==0). klog_s1_x1_d1 caller contract: `sub rsp, 16; mov [rsp+0], r12; call klog_s1_x1_d1; add rsp, 16` -- same recipe as drivers/dpy/direct_scanout.pdx L683 and drivers/acpi/ec_discovery.pdx L828. Labels prefixed fc_rg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = font_cap (saved)
        mov r12, rsi;                       // r12 = priority (saved)

        // --- Gate (1): font_cap != 0.
        cmp rbx, 0;
        je  fc_rg_bad_cap;

        // --- Scan rows 0..7 for first empty slot.
        xor r13, r13;                       // r13 = loop idx = 0

      fc_rg_head:
        cmp r13, 8;                         // FC_MAX_SLOTS
        jae fc_rg_full;

        // row = _cascade_table + idx * 48
        mov rax, r13;
        mov r11, 48;
        imul rax, r11;                      // reg-reg form; NOT 2-op imul r,imm
        lea r14, [rip + _cascade_table];
        add r14, rax;                       // r14 = row base

        // if row.font_cap == 0 -> empty slot, use it
        mov rax, [r14 + 0];
        cmp rax, 0;
        je  fc_rg_fill;

        add r13, 1;
        jmp fc_rg_head;

      fc_rg_fill:
        mov r15, r13;                       // r15 = chosen slot_idx

        // Row writes.
        mov [r14 + 0],  rbx;                // font_cap
        mov [r14 + 8],  r12;                // priority
        xor rax, rax;
        mov [r14 + 16], rax;                // coverage_bitmap_ptr = 0
        mov [r14 + 24], rax;                // coverage_bitmap_len = 0
        mov [r14 + 32], rax;                // flags = 0
        mov [r14 + 40], rax;                // reserved = 0

        // --- Count the register (bump BEFORE fingerprint).
        mov rax, [rip + _fc_register_ct];
        add rax, 1;
        mov [rip + _fc_register_ct], rax;

        // --- klog_s1_x1_d1(LEVEL_INFO, SUBSYS_DRV_, fc_tag_register,
        //                   fc_k_cap, font_cap,
        //                   fc_k_priority, [vd=priority])
        //
        // SysV reg args: rdi, rsi, rdx, rcx, r8, r9. Stack arg (vd =
        // priority) at caller [rsp+0] right before CALL; 16-byte
        // reserve = 1 arg slot (8B) + 1 pad (8B) keeps rsp%16==0.
        sub rsp, 16;
        mov [rsp + 0], r12;                 // vd = priority (decimal)
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + fc_tag_register];
        lea rcx, [rip + fc_k_cap];
        mov r8, rbx;                        // vx = font_cap (hex)
        lea r9, [rip + fc_k_priority];
        call klog_s1_x1_d1;
        add rsp, 16;

        // --- Return value: slot_idx.
        mov rax, r15;
        jmp fc_rg_out;

      fc_rg_bad_cap:
        mov rax, 0xFFFFFD16;                // FC_ERR_BAD_FONT_CAP
        jmp fc_rg_out;
      fc_rg_full:
        mov rax, 0xFFFFFD17;                // FC_ERR_CASCADE_FULL

      fc_rg_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §G  font_cascade_resolve(codepoint) -> u64
  //
  // Walk the cascade in priority order and return the font_cap of the
  // highest-priority slot whose coverage bitmap carries `codepoint`.
  // Returns FC_ERR_NO_FONT_COVERS when no slot covers the codepoint
  // (which includes the empty-cascade case).
  //
  // Gates:
  //   (1) codepoint > 0xFFFF        -> FC_ERR_BAD_CODEPOINT
  //
  // Walk (single linear sweep, O(8)):
  //   best_cap = 0, best_pri = 0
  //   for i in 0..8:
  //       row = _cascade_table + i * 48
  //       fc  = row[+0]; if fc == 0 continue
  //       pri = row[+8]
  //       bmp = row[+16]
  //       covered = (bmp == 0) ? 1 : (*(bmp + cp>>3) & (1 << (cp & 7)))
  //       if covered == 0 continue
  //       if best_cap == 0 or pri > best_pri:
  //           best_cap = fc; best_pri = pri
  //
  // Return best_cap or FC_ERR_NO_FONT_COVERS.
  //
  // Fingerprint: `FONT_CASCADE RESOLVE cap=0x<hex> cp=<dec>` via
  // klog_s1_x1_d1 (vd = codepoint at caller [rsp+0]). KV order is
  // REVERSED from the task directive's cp=<dec> cap=<hex> spelling
  // because the klog wrapper repertoire has no klog_s1_d1_x1 shape;
  // information-preserving.
  //
  // SysV: rdi = codepoint.
  // Stack recipe: 5 callee-save pushes (rbx = codepoint, r12 =
  // best_font_cap, r13 = best_priority, r14 = loop idx, r15 = row
  // base ptr) + sub rsp, 16 + mov [rsp+0], rbx for the klog_s1_x1_d1
  // vd arg.
  // ==========================================================================

  pub let font_cascade_resolve : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (codepoint: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 82 G12 (paideia-os#2549) skeleton: priority-ordered walk across _cascade_table[0..7], return highest-priority covering slot's font_cap. Gate: codepoint > 0xFFFF -> FC_ERR_BAD_CODEPOINT (0xFFFFFD19). Walk: single linear sweep tracking (best_font_cap, best_priority); for each row with nonzero font_cap, test coverage via byte load at `[bmp_ptr + (cp >> 3)] & (1 << (cp & 7))` (if bmp_ptr == 0, skeleton treats as 'covers all' so a bare-cap registration still resolves). Strict `>` on the priority replace clause so a tie keeps the earlier-scanned (lower-index) slot. Return best_font_cap or FC_ERR_NO_FONT_COVERS (0xFFFFFD1A) when nothing covered. Bump _fc_resolve_ct. Emit `FONT_CASCADE RESOLVE cap=0x<hex> cp=<dec>` via klog_s1_x1_d1 (vd=codepoint at caller [rsp+0]; wrapper reads [rbp+16] after its own push rbp). KV order reversed from directive's cp=<dec> cap=<hex> because klog wrapper repertoire has no klog_s1_d1_x1 shape; same posture as drivers/dpy/sdf_atlas.pdx §E for its compound-value INIT line. Row stride 48 via reg-reg imul (`mov r11, 48; imul rax, r11`); bit mask 1 << (cp & 7) staged through rcx (variable shift). Byte load uses `xor rax, rax; mov_b rax, [bmp + off]` canonical zero-extension pattern. Register plan: rbx=codepoint (saved for coverage test + fingerprint), r12=best_font_cap (initially 0; final return value + klog vx), r13=best_priority (initially 0), r14=loop idx, r15=row base ptr. Five callee-save pushes land rsp%16==0 at every nested CALL. klog_s1_x1_d1 caller contract: `sub rsp, 16; mov [rsp+0], rbx; call klog_s1_x1_d1; add rsp, 16`. Labels prefixed fc_rs_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = codepoint (saved)

        // --- Gate (1): codepoint <= 0xFFFF (BMP range).
        mov rax, 0xFFFF;
        cmp rbx, rax;
        ja  fc_rs_bad_cp;

        // --- Initialise best_cap / best_pri.
        xor r12, r12;                       // r12 = best_font_cap = 0
        xor r13, r13;                       // r13 = best_priority = 0

        // --- Scan rows 0..7.
        xor r14, r14;                       // r14 = loop idx = 0

      fc_rs_head:
        cmp r14, 8;                         // FC_MAX_SLOTS
        jae fc_rs_done;

        // row = _cascade_table + idx * 48
        mov rax, r14;
        mov r11, 48;
        imul rax, r11;                      // reg-reg form
        lea r15, [rip + _cascade_table];
        add r15, rax;                       // r15 = row base

        // Skip empty slot: row[+0] == 0.
        mov rax, [r15 + 0];                 // font_cap
        cmp rax, 0;
        je  fc_rs_next;

        // Coverage test. Load bmp_ptr; if 0 -> treat as "covers all".
        mov r10, [r15 + 16];                // bmp_ptr
        cmp r10, 0;
        je  fc_rs_covered;

        // byte_off = codepoint >> 3
        mov r9, rbx;
        shr r9, 3;
        // bit_mask = 1 << (codepoint & 7)
        mov rcx, rbx;
        and rcx, 7;                         // fits imm8; mod-8 bit index
        mov rdx, 1;
        shl rdx, cl;                        // rdx = 1 << (cp & 7)
        // *(bmp + byte_off) & bit_mask
        add r10, r9;                        // r10 = bmp + byte_off
        xor r8, r8;
        mov_b r8, [r10 + 0];                // zero-extended byte load
        and r8, rdx;                        // mask with bit
        cmp r8, 0;
        je  fc_rs_next;                     // bit clear -> not covered

      fc_rs_covered:
        // Candidate covers. Replace iff best_cap == 0 OR pri > best_pri.
        mov r9, [r15 + 0];                  // r9 = this slot's font_cap
        mov r8, [r15 + 8];                  // r8 = this slot's priority

        cmp r12, 0;                         // best_cap == 0?
        je  fc_rs_replace;
        cmp r8, r13;                        // pri > best_pri?
        jbe fc_rs_next;

      fc_rs_replace:
        mov r12, r9;                        // best_font_cap = fc
        mov r13, r8;                        // best_priority = pri

      fc_rs_next:
        add r14, 1;
        jmp fc_rs_head;

      fc_rs_done:
        // --- Count the resolve (bump BEFORE fingerprint).
        mov rax, [rip + _fc_resolve_ct];
        add rax, 1;
        mov [rip + _fc_resolve_ct], rax;

        // --- klog_s1_x1_d1(LEVEL_INFO, SUBSYS_DRV_, fc_tag_resolve,
        //                   fc_k_cap, best_font_cap,
        //                   fc_k_cp, [vd=codepoint])
        //
        // vd = codepoint (rbx) at caller [rsp+0]; the wrapper reads
        // it at [rbp+16] after its own push rbp.
        sub rsp, 16;
        mov [rsp + 0], rbx;                 // vd = codepoint (decimal)
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + fc_tag_resolve];
        lea rcx, [rip + fc_k_cap];
        mov r8, r12;                        // vx = best_font_cap (hex, 0 on miss)
        lea r9, [rip + fc_k_cp];
        call klog_s1_x1_d1;
        add rsp, 16;

        // --- Return value: best_font_cap or FC_ERR_NO_FONT_COVERS.
        cmp r12, 0;
        je  fc_rs_no_cover;
        mov rax, r12;
        jmp fc_rs_out;

      fc_rs_no_cover:
        mov rax, 0xFFFFFD1A;                // FC_ERR_NO_FONT_COVERS
        jmp fc_rs_out;

      fc_rs_bad_cp:
        mov rax, 0xFFFFFD19;                // FC_ERR_BAD_CODEPOINT

      fc_rs_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  font_cascade_unregister(font_cap) -> u64
  //
  // Clear the row whose font_cap matches `font_cap`. Returns FC_OK on
  // success, FC_ERR_UNKNOWN_FONT when no row matches. No fingerprint
  // is emitted so steady-state cascade churn (e.g. a font-manager
  // reshuffle under GUI theme change) does not spam the klog wire;
  // _fc_unregister_ct is still bumped so a boot-witness programme can
  // observe the mutation.
  //
  // Gates:
  //   (1) font_cap == 0            -> FC_ERR_BAD_FONT_CAP
  //   (2) no row matches           -> FC_ERR_UNKNOWN_FONT
  //
  // SysV: rdi = font_cap.
  // Stack recipe: 3 callee-save pushes (rbx = font_cap, r12 = loop idx,
  // r13 = row base ptr).
  // ==========================================================================

  pub let font_cascade_unregister : (u64) -> u64 !{mem} @{boot} =
    fn (font_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "Wave 82 G12 (paideia-os#2549) skeleton: scan _cascade_table[0..7] for row whose font_cap matches, zero its six u64 fields on hit. Gates: (1) font_cap == 0 -> FC_ERR_BAD_FONT_CAP (0xFFFFFD16); (2) no match -> FC_ERR_UNKNOWN_FONT (0xFFFFFD18). No fingerprint (steady-state cascade churn would otherwise spam the klog wire); _fc_unregister_ct still bumped so a boot-witness programme can observe the mutation. Row stride 48 via reg-reg imul (`mov r11, 48; imul rax, r11`). Register plan: rbx=font_cap (saved for scan key), r12=loop idx, r13=row base ptr. Three callee-save pushes land rsp%16==0 at every nested CALL (none in this body today; the push triplet is kept for parity with the register / resolve paths so a follow-up body can land without touching the prologue). Labels prefixed fc_ur_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = font_cap (saved)

        // --- Gate (1): font_cap != 0.
        cmp rbx, 0;
        je  fc_ur_bad_cap;

        // --- Scan rows 0..7.
        xor r12, r12;                       // r12 = loop idx = 0

      fc_ur_head:
        cmp r12, 8;                         // FC_MAX_SLOTS
        jae fc_ur_not_found;

        // row = _cascade_table + idx * 48
        mov rax, r12;
        mov r11, 48;
        imul rax, r11;                      // reg-reg form
        lea r13, [rip + _cascade_table];
        add r13, rax;                       // r13 = row base

        // Match: row[+0] == font_cap?
        mov rax, [r13 + 0];
        cmp rax, rbx;
        je  fc_ur_clear;

        add r12, 1;
        jmp fc_ur_head;

      fc_ur_clear:
        // Zero the six u64 fields.
        xor rax, rax;
        mov [r13 + 0],  rax;                // font_cap
        mov [r13 + 8],  rax;                // priority
        mov [r13 + 16], rax;                // bmp_ptr
        mov [r13 + 24], rax;                // bmp_len
        mov [r13 + 32], rax;                // flags
        mov [r13 + 40], rax;                // reserved

        // Bump unregister counter.
        mov rax, [rip + _fc_unregister_ct];
        add rax, 1;
        mov [rip + _fc_unregister_ct], rax;

        xor rax, rax;                       // FC_OK
        jmp fc_ur_out;

      fc_ur_bad_cap:
        mov rax, 0xFFFFFD16;                // FC_ERR_BAD_FONT_CAP
        jmp fc_ur_out;
      fc_ur_not_found:
        mov rax, 0xFFFFFD18;                // FC_ERR_UNKNOWN_FONT

      fc_ur_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  Per-op counter getters
  //
  // Three leaf getters so a boot-witness programme can assert
  // (register_ct, resolve_ct, unregister_ct) without touching the
  // _fc_*_ct symbols directly.
  // ==========================================================================

  pub let font_cascade_register_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 82 G12 (paideia-os#2549) skeleton: single mov load from _fc_register_ct. Leaf.",
      block: {
        mov rax, [rip + _fc_register_ct];
        ret
      }
    }

  pub let font_cascade_resolve_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 82 G12 (paideia-os#2549) skeleton: single mov load from _fc_resolve_ct. Leaf.",
      block: {
        mov rax, [rip + _fc_resolve_ct];
        ret
      }
    }

  pub let font_cascade_unregister_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 82 G12 (paideia-os#2549) skeleton: single mov load from _fc_unregister_ct. Leaf.",
      block: {
        mov rax, [rip + _fc_unregister_ct];
        ret
      }
    }

  // ==========================================================================
  // §J  cap_handler_font_cascade(rights, target_ptr, op_arg) -> u64
  //
  // KIND_FONT_CASCADE (0x55) cap_invoke dispatch handler. Reachable
  // from cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x55;
  // je call_kind_font_cascade` arm added alongside this file.
  //
  // The three mutating entrypoints (register / resolve / unregister)
  // take more than three arguments only when combined (register
  // takes 2, resolve takes 1, unregister takes 1), but cap_invoke
  // hands the handler only (rights, target_ptr, op_arg). resolve +
  // unregister fit the one-argument slot through op_arg[63:8] (the
  // low byte carries the op_code); register's two arguments would
  // need either a packed op_arg or a second cap-invoke slot variant.
  // The handler is therefore QUERY-ONLY at skeleton stage, exactly
  // like drivers/dpy/sdf_atlas.pdx does for its first slice. Three
  // ops:
  //
  //     op 0 FC_OP_QUERY_REGISTER_CT    -> _fc_register_ct
  //     op 1 FC_OP_QUERY_RESOLVE_CT     -> _fc_resolve_ct
  //     op 2 FC_OP_QUERY_UNREGISTER_CT  -> _fc_unregister_ct
  //     else                              INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_FC_READ (0x001). target_ptr is
  // ignored at skeleton stage; the mutating ops will interpret it
  // (font_cap for unregister; codepoint for resolve) in a follow-up
  // slice that extends cap_invoke with a packed op_arg scheme.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg.
  // Stack recipe: 3 callee-save pushes (rbx = rights, r12 = scratch,
  // r13 = op_code).
  // ==========================================================================

  pub let R_FC_READ : u64 = 0x001

  pub let FC_OP_QUERY_REGISTER_CT    : u64 = 0
  pub let FC_OP_QUERY_RESOLVE_CT     : u64 = 1
  pub let FC_OP_QUERY_UNREGISTER_CT  : u64 = 2

  pub let cap_handler_font_cascade : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 82 G12 (paideia-os#2549) skeleton: KIND_FONT_CASCADE (0x55) cap_invoke dispatch. Entry chatter (klog_s1 of fc_tag_handler_entry). op_code = op_arg & 0xFF; rights gate against R_FC_READ (0x001); dispatch 0..2 to the matching reader (font_cascade_register_ct / resolve_ct / unregister_ct); else INVOKE_UNSUPPORTED. target_ptr ignored at skeleton stage; the mutating ops (register / resolve / unregister) are deferred to a follow-up slice that either extends cap_invoke with a 4-register slot variant or packs multiple args into op_arg. Three callee-save pushes land rsp%16==0 at every nested CALL. Labels prefixed fc_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = rights (saved)
        mov r13, rdx;                       // r13 = op_arg
        and r13, 0xFF;                      // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + fc_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                     // R_FC_READ
        cmp r10, 0;
        je  fc_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  fc_hd_op_register_ct;
        cmp r13, 1;
        je  fc_hd_op_resolve_ct;
        cmp r13, 2;
        je  fc_hd_op_unregister_ct;
        jmp fc_hd_unsup;

      fc_hd_op_register_ct:
        call font_cascade_register_ct;
        jmp fc_hd_out;
      fc_hd_op_resolve_ct:
        call font_cascade_resolve_ct;
        jmp fc_hd_out;
      fc_hd_op_unregister_ct:
        call font_cascade_unregister_ct;
        jmp fc_hd_out;

      fc_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;        // INVOKE_DENIED
        jmp fc_hd_out;
      fc_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;        // INVOKE_UNSUPPORTED

      fc_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  Boot wiring note
  // ------------------
  // kernel_main.pdx does NOT need a dedicated reset entry: .bss zero-
  // init leaves _cascade_table empty (every row's font_cap at 0 = empty
  // slot sentinel) and the three counters at zero, which is exactly
  // the never-registered starting state the resolve / unregister paths
  // expect. A follow-up slice may mint a defensive `font_cascade_reset`
  // for parity with the other dpy drivers' reset entries, but the
  // skeleton gets by on .bss alone.
  //
  // invoke.pdx picks up the KIND_FONT_CASCADE (0x55) dispatch arm in
  // the same slice as this file -- the arm is pure plumbing and self-
  // standing (handler returns INVOKE_UNSUPPORTED for every mutating
  // op at skeleton stage, which is observable but harmless).
  //
  // Follow-up slices (G13 and later):
  //   - Real font loader: mint a (font_cap, bitmap_ptr, bitmap_len)
  //     triple from a TTF/OTF font blob by walking the cmap table
  //     (Microsoft OTF Spec §cmap) and setting the bits for each
  //     glyph-mapped codepoint.
  //   - Supplementary-plane bitmap trie (two-level: plane header +
  //     per-plane 8 KiB chunk) so codepoints > 0xFFFF resolve.
  //   - cap_handler extension for the mutating ops (register /
  //     resolve / unregister via a packed op_arg scheme or a cap-
  //     invoke 4-register slot variant).
  //   - Complex-shaping integration: once paideia-as-unicode's
  //     Harfbuzz-style glyph-cluster post-reordering lands, resolve
  //     reads the post-shaped glyph index rather than the raw
  //     codepoint for its cascade walk.
  // ==========================================================================
}
