// src/kernel/core/drivers/dpy/mode_enum.pdx — R36.M3-005 (#1248)
//
// Mode enumeration from EDID detailed timing descriptors (DTDs) plus
// the display engine's declared limits (KIND_DISPLAY_ENGINE bspec
// caps). Filters out modes whose pixel clock exceeds the engine's
// per-DDI limit or whose lane-bandwidth-times-encoding demand exceeds
// what the DP link + engine can sustain, then bumps counters so a
// witness can observe admission / rejection reasons.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ADMISSION half of an Iris Xe mode list: given a panel's
// EDID DTD (h/v/refresh/pclk) and the engine's KIND_DISPLAY_ENGINE
// row (bspec-derived pixel_clock max, lane count, per-lane rate), it
// decides which of the panel's advertised timings this engine can
// actually drive.
//
// This scaffold DOES NOT PROGRAM THE PLL, DOES NOT RUN LINK TRAINING,
// AND DOES NOT COMMIT A MODE. That is the atomic_commit path's
// authority. It also DOES NOT WALK EDID BYTES — edid.pdx (R36.M2-002)
// owns that job and this module reads its cached DTD fields via
// caller-supplied tuples this milestone.
//
// menum_arbitrated() returns 0 until edid.pdx and
// kind_display_engine are populated by a live probe.
//
// =============================================================================
// §1  THE FILTER
// =============================================================================
//
// A DTD advertised by a panel is admitted IFF all of:
//
//   (a) DPM_PCLK_MIN_KHZ <= pixel_clock_khz <= min(DPM_PCLK_MAX_KHZ,
//       engine_max_pclk_khz)                          (BAD_MODE /
//                                                     BAD_ENGINE_PCLK)
//   (b) h_active in (0, 0xFFFF], v_active in (0, 0xFFFF] (BAD_MODE)
//   (c) refresh_hz in (0, DPM_REFRESH_MAX]              (BAD_MODE)
//   (d) required lane bandwidth (pixel_clock_khz * BPP_BYTES * 10)
//       <= lane_count * per_lane_rate_kbps * 8         (BAD_LANES)
//
// The 10/8 arithmetic on the LHS is 8b/10b encoding overhead
// (10 line bits per 8 data bits); RHS's *8 converts bytes/lane to
// bits/lane so both sides are in the same units.
//
// A REJECTED timing bumps MENUM_ST_REJECTED plus a per-category
// counter so an operator can distinguish "engine cannot" from
// "panel lied".
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _menum_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/dpy/mode_enum.o`. This module owns no row table —
// KIND_DISPLAY_MODE rows live in _display_mode_table (whose own
// one-writer discipline is enforced by kind_display_mode.pdx §3).
//
// =============================================================================
// §3  ARITY DISCIPLINE
// =============================================================================
//
// The public predicate takes FIVE u64 arguments — pclk_khz,
// packed_mode (h|v|refresh), engine_max_pclk_khz, lane_count, and
// per_lane_rate_kbps — because paideia-as elsewhere in this tree
// caps the SysV register pass at six (r9), and folding the three
// mode fields into a packed u64 leaves headroom for a future flags
// argument without going through the stack. The pack layout matches
// KIND_DISPLAY_MODE's body2 exactly (h[15:0] | v[31:16] |
// refresh[47:32]) so a caller can pass the same packed value it
// intends to hand to display_mode_cap_mint_inner.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF6F0..0xFFFFF6FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: atomic_commit
// 0xFFFFF700..0F).

module ModeEnum = structure {

  // §1's constants. Iris Xe (Xe1 as on the T14 G4) tops out at
  // 1_188_000 kHz pixel clock per DDI (DP HBR3 with 4 lanes,
  // uncompressed 8-bit RGB).
  pub let MENUM_ENGINE_PCLK_MAX_DEFAULT : u64 = 1188000
  pub let MENUM_BPP_BYTES               : u64 = 3

  pub let mut _menum_stats : [u64; 8] = uninit @align(64)

  pub let MENUM_ST_ADMITTED   : u64 = 0
  pub let MENUM_ST_REJECTED   : u64 = 1
  pub let MENUM_ST_MINT_FAIL  : u64 = 2
  pub let MENUM_ST_BAD_ENG    : u64 = 3
  pub let MENUM_ST_BAD_MODE   : u64 = 4
  pub let MENUM_ST_BAD_LANES  : u64 = 5

  // Failure taxonomy — 0xFFFFF6F0..0xFFFFF6FF.
  pub let MENUM_OK                : u64 = 0
  pub let MENUM_BAD_ARG           : u64 = 0xFFFFF6FF
  pub let MENUM_BAD_MODE          : u64 = 0xFFFFF6FE
  pub let MENUM_BAD_ENGINE_PCLK   : u64 = 0xFFFFF6FD
  pub let MENUM_BAD_LANES         : u64 = 0xFFFFF6FC
  pub let MENUM_MINT_FAILED       : u64 = 0xFFFFF6FB
  pub let MENUM_DEFERRED_HARDWARE : u64 = 0xFFFFF6FA
  pub let MENUM_BAD_ENGINE        : u64 = 0xFFFFF6F9

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let mode_enum_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-005 (#1248): clear counters. Boot and teardown. Labels prefixed menum_rs_.",
      block: {
        lea r10, [rip + _menum_stats];
        xor rax, rax;
        xor rcx, rcx;
      menum_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  menum_rs_stats;
        ret
      }
    }

  pub let menum_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-005 (#1248): honesty pin. 0 until a live probe populates the EDID cache and the engine row.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let menum_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-005 (#1248): counter bump. Labels prefixed menum_nt_.",
      block: {
        cmp rdi, 8;
        jae menum_nt_out;
        lea r10, [rip + _menum_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      menum_nt_out:
        ret
      }
    }

  pub let menum_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-005 (#1248): counter read. Labels prefixed menum_st_.",
      block: {
        cmp rdi, 8;
        jae menum_st_zero;
        lea r10, [rip + _menum_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      menum_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // menum_pack_mode(h_active, v_active, refresh_hz) -> u64
  //
  // Layout matches KIND_DISPLAY_MODE's body2:
  //   [15:0]  h_active
  //   [31:16] v_active
  //   [47:32] refresh_hz
  //   [63:48] reserved
  // ==========================================================================

  pub let menum_pack_mode : (u64, u64, u64) -> u64 !{} @{} =
    fn (h_active: u64) (v_active: u64) (refresh_hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-005 (#1248): pack mode fields for the admission predicate; layout matches KIND_DISPLAY_MODE body2. Refuses out-of-range. Labels prefixed menum_pm_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  menum_pm_bad;
        cmp rsi, r10;
        ja  menum_pm_bad;
        cmp rdx, r10;
        ja  menum_pm_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;

      menum_pm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // menum_admit_check(pclk_khz, packed_mode, engine_max_pclk_khz,
  //                    lane_count, per_lane_rate_kbps) -> MENUM_*
  //
  // Pure predicate. Does not touch any table. Same field checks
  // display_mode_cap_mint_inner performs, plus the engine-limit and
  // lane-bandwidth checks that KIND_DISPLAY_MODE cannot itself know.
  // ==========================================================================

  pub let menum_admit_check : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (pclk_khz: u64) (packed_mode: u64) (engine_max_pclk_khz: u64) (lane_count: u64) (per_lane_rate_kbps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M3-005 (#1248): §1's admission predicate. Five args (all in registers). Refuses out-of-range fields (BAD_MODE), pclk over engine cap (BAD_ENGINE_PCLK), and lane bandwidth over budget (BAD_LANES). All arithmetic in u64; overflow-safe for pclk in kHz and per-lane rates in kbps. Labels prefixed menum_ac_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // pclk_khz
        mov r12, rsi;                    // packed_mode
        mov r13, rdx;                    // engine_max_pclk_khz
        mov r14, rcx;                    // lane_count
        mov r15, r8;                     // per_lane_rate_kbps

        // (a1) pclk >= DPM_PCLK_MIN_KHZ (25000)
        mov rax, 25000;
        cmp rbx, rax;
        jb  menum_ac_bad_mode;

        // (a2) pclk <= DPM_PCLK_MAX_KHZ (defence in depth)
        mov rax, 1188000;
        cmp rbx, rax;
        ja  menum_ac_bad_mode;

        // (a3) pclk <= engine cap
        cmp rbx, r13;
        ja  menum_ac_bad_eng_pclk;

        // (b) h > 0, h <= 0xFFFF
        mov rax, r12;
        and rax, 0xFFFF;
        cmp rax, 0;
        je  menum_ac_bad_mode;

        // v > 0
        mov rax, r12;
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, 0;
        je  menum_ac_bad_mode;

        // (c) refresh_hz > 0, <= 240
        mov rax, r12;
        shr rax, 32;
        and rax, 0xFFFF;
        cmp rax, 0;
        je  menum_ac_bad_mode;
        cmp rax, 240;
        ja  menum_ac_bad_mode;

        // (d) LHS = pclk_khz * 30 (BPP_BYTES=3, encoding factor 10)
        mov rax, rbx;
        mov r10, 30;
        imul rax, r10;
        mov rcx, rax;                    // rcx = LHS

        // RHS = lane_count * per_lane_rate_kbps * 8
        mov rax, r14;
        imul rax, r15;
        mov r10, 8;
        imul rax, r10;                   // rax = RHS

        cmp rcx, rax;
        ja  menum_ac_bad_lanes;

        xor rax, rax;
        jmp menum_ac_out;

      menum_ac_bad_mode:
        mov rax, 0xFFFFF6FE;
        jmp menum_ac_out;
      menum_ac_bad_eng_pclk:
        mov rax, 0xFFFFF6FD;
        jmp menum_ac_out;
      menum_ac_bad_lanes:
        mov rax, 0xFFFFF6FC;

      menum_ac_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // menum_admit_one — wrap the check with per-category counter bumps
  // so a witness can observe which admission arm rejected a candidate.
  // ==========================================================================

  pub let menum_admit_one : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (pclk_khz: u64) (packed_mode: u64) (engine_max_pclk_khz: u64) (lane_count: u64) (per_lane_rate_kbps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M3-005 (#1248): wrapper over menum_admit_check that bumps counters. Labels prefixed menum_ao_.",
      block: {
        push rbx;

        call menum_admit_check;
        mov rbx, rax;

        cmp rbx, 0;
        jne menum_ao_reject;
        mov rdi, 0;
        call menum_note;
        jmp menum_ao_out;

      menum_ao_reject:
        mov rdi, 1;
        call menum_note;
        mov r10, 0xFFFFF6FE;
        cmp rbx, r10;
        jne menum_ao_ck_eng;
        mov rdi, 4;
        call menum_note;
        jmp menum_ao_out;
      menum_ao_ck_eng:
        mov r10, 0xFFFFF6FD;
        cmp rbx, r10;
        jne menum_ao_ck_ln;
        mov rdi, 3;
        call menum_note;
        jmp menum_ao_out;
      menum_ao_ck_ln:
        mov r10, 0xFFFFF6FC;
        cmp rbx, r10;
        jne menum_ao_out;
        mov rdi, 5;
        call menum_note;

      menum_ao_out:
        mov rax, rbx;
        pop rbx;
        ret
      }
    }
}
