// src/kernel/core/drivers/dpy/plane_cursor.pdx — R36.M4-004 (#1252)
//
// Cursor-plane composition for Intel Iris Xe. Consumes a
// KIND_DISPLAY_PLANE row with plane_type == DPP_TYPE_CURSOR and
// resolves it to a per-pipe binding: memory row, square cursor size
// (one of {64, 128, 256}), RGBA8888 alpha-per-pixel format, and an
// immediate (x, y) hot-spot position that lives OUTSIDE the atomic
// commit flow.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// The class-specific half of the plane lattice for the cursor role.
// kind_display_plane.pdx holds the row and does the generic mint/revoke
// gates; this module rejects a row whose class-specific fields do not
// match the cursor role, records a binding decision in per-pipe state,
// exposes an immediate-effect position setter, and returns
// DEFERRED_HARDWARE where a live driver would ARM the plane.
//
// It DOES NOT TOUCH REAL MMIO. plcur_arbitrated() returns 0 until a
// later round binds the seam against a live window.
//
// =============================================================================
// §1  THE CURSOR-ROLE GATES
// =============================================================================
//
//   (a) plane_type == DPP_TYPE_CURSOR (WRONG_TYPE)
//   (b) width == height and value in {64, 128, 256} (BAD_SIZE); bspec
//       §14 gives three cursor sizes on Xe1
//   (c) format == RGBA8888 (BAD_FORMAT); a cursor without a per-pixel
//       alpha channel would show the desktop under it as sharp,
//       squared edges. XRGB / YUV are refused
//
// =============================================================================
// §2  POSITION UPDATE IS IMMEDIATE
// =============================================================================
//
// Cursor position -- CUR_POS on the register block -- is programmed
// with an IMMEDIATE-EFFECT write on real hardware: the cursor moves at
// the next VBLANK regardless of any atomic-commit ARM cycle. Naming
// this discipline on the API is what stops a caller waiting on
// modeset FSM state to move the cursor.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _plane_cursor_state is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/dpy/plane_cursor.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF6B0..0xFFFFF6BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: plane_overlay
// 0xFFFFF6C0..CF).

module PlaneCursor = structure {

  pub let PLCUR_SIZE_64  : u64 = 64
  pub let PLCUR_SIZE_128 : u64 = 128
  pub let PLCUR_SIZE_256 : u64 = 256

  // Only RGBA8888 is admitted (per-pixel alpha).
  pub let PLCUR_FORMAT_RGBA8888 : u64 = 3

  // Number of pipes tracked. Same shape as atomic_commit / primary.
  pub let PLCUR_PIPE_COUNT : u64 = 4

  // Per-pipe binding state, 8 u64 slots per pipe * 4 pipes = 32 u64s.
  //   [+0]  bound         0 = fresh, 1 = a bind ran
  //   [+8]  plane_slot    KIND_DISPLAY_PLANE cap slot
  //   [+16] memory_slot   KIND_MEMORY row bound
  //   [+24] size          square cursor size in pixels
  //   [+32] pos_x         current x position (u16 in [0, 0xFFFF])
  //   [+40] pos_y         current y position
  //   [+48] reserved
  //   [+56] reserved
  pub let mut _plane_cursor_state : [u64; 32] = uninit @align(64)
  pub let mut _plane_cursor_stats : [u64; 8]  = uninit @align(64)

  pub let PLCUR_ST_BINDS   : u64 = 0
  pub let PLCUR_ST_MOVES   : u64 = 1
  pub let PLCUR_ST_REFUSED : u64 = 2

  // Failure taxonomy — 0xFFFFF6B0..0xFFFFF6BF.
  pub let PLCUR_OK                : u64 = 0
  pub let PLCUR_BAD_ARG           : u64 = 0xFFFFF6BF
  pub let PLCUR_BAD_PIPE          : u64 = 0xFFFFF6BE
  pub let PLCUR_WRONG_TYPE        : u64 = 0xFFFFF6BD
  pub let PLCUR_BAD_SIZE          : u64 = 0xFFFFF6BC
  pub let PLCUR_BAD_FORMAT        : u64 = 0xFFFFF6BB
  pub let PLCUR_BAD_POS           : u64 = 0xFFFFF6BA
  pub let PLCUR_NO_PLANE_ROW      : u64 = 0xFFFFF6B9
  pub let PLCUR_NOT_BOUND         : u64 = 0xFFFFF6B8
  pub let PLCUR_DEFERRED_HARDWARE : u64 = 0xFFFFF6B7

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let plane_cursor_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): clear per-pipe binding state and stats. Boot and teardown. Labels prefixed plcur_rs_.",
      block: {
        lea r10, [rip + _plane_cursor_state];
        xor rax, rax;
        xor rcx, rcx;
      plcur_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  plcur_rs_state;

        lea r10, [rip + _plane_cursor_stats];
        xor rcx, rcx;
      plcur_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  plcur_rs_stats;
        ret
      }
    }

  pub let plcur_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-004 (#1252): honesty pin. Returns 0 until a later round binds the atomic_commit seam against a live MMIO window.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let plcur_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): counter bump. Labels prefixed plcur_nt_.",
      block: {
        cmp rdi, 8;
        jae plcur_nt_out;
        lea r10, [rip + _plane_cursor_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      plcur_nt_out:
        ret
      }
    }

  pub let plcur_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): counter read. Labels prefixed plcur_st_.",
      block: {
        cmp rdi, 8;
        jae plcur_st_zero;
        lea r10, [rip + _plane_cursor_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      plcur_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators (§1).
  // ==========================================================================

  pub let plcur_pipe_valid : (u64) -> u64 !{} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-004 (#1252): 1 iff pipe < PLCUR_PIPE_COUNT (4). Labels prefixed plcur_pv_.",
      block: {
        cmp rdi, 4;
        jae plcur_pv_no;
        mov rax, 1;
        ret;
      plcur_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let plcur_size_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-004 (#1252): 1 iff s in {64, 128, 256}. Labels prefixed plcur_sv_.",
      block: {
        cmp rdi, 64;
        je  plcur_sv_yes;
        cmp rdi, 128;
        je  plcur_sv_yes;
        cmp rdi, 256;
        je  plcur_sv_yes;
        xor rax, rax;
        ret;
      plcur_sv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let plcur_format_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-004 (#1252): 1 iff f == RGBA8888 (3). Alpha-per-pixel required. Labels prefixed plcur_fv_.",
      block: {
        cmp rdi, 3;
        jne plcur_fv_no;
        mov rax, 1;
        ret;
      plcur_fv_no:
        xor rax, rax;
        ret
      }
    }

  pub let plcur_pos_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M4-004 (#1252): 1 iff v <= 0xFFFF. Labels prefixed plcur_ppv_.",
      block: {
        cmp rdi, 0xFFFF;
        ja  plcur_ppv_no;
        mov rax, 1;
        ret;
      plcur_ppv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Binding. plane_cursor_bind(pipe, plane_slot)
  // ==========================================================================

  pub let plane_cursor_bind : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (pipe: u64) (plane_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R36.M4-004 (#1252): bind KIND_DISPLAY_PLANE (cursor) to a pipe. Enforces §1 gates, records the binding, returns DEFERRED_HARDWARE while the seam is unbound. Labels prefixed plcur_bd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // pipe
        mov r12, rsi;                    // plane_slot

        mov rdi, rbx;
        call plcur_pipe_valid;
        cmp rax, 0;
        je  plcur_bd_bad_pipe;

        // Resolve plane_slot -> row_id.
        mov rdi, r12;
        call dpp_row_of_slot;
        mov r11, 0xFF;
        cmp rax, r11;
        je  plcur_bd_no_row;
        mov r13, rax;                    // row_id

        // Type must be CURSOR.
        mov rdi, r13;
        call dpp_row_type;
        cmp rax, 2;                      // DPP_TYPE_CURSOR
        jne plcur_bd_wrong_type;

        // Format must be RGBA8888.
        mov rdi, r13;
        call dpp_row_format;
        mov rdi, rax;
        call plcur_format_valid;
        cmp rax, 0;
        je  plcur_bd_bad_format;

        // Width == Height and in {64, 128, 256}.
        mov rdi, r13;
        call dpp_row_width;
        mov r14, rax;                    // width
        mov rdi, r13;
        call dpp_row_height;
        cmp rax, r14;
        jne plcur_bd_bad_size;
        mov rdi, r14;
        call plcur_size_valid;
        cmp rax, 0;
        je  plcur_bd_bad_size;

        // Read memory_slot.
        mov rdi, r13;
        call dpp_row_memory;
        mov r15, rax;                    // memory_slot

        // Stamp per-pipe state.
        lea r10, [rip + _plane_cursor_state];
        mov r11, rbx;
        shl r11, 6;                      // pipe * 64
        add r10, r11;

        mov rax, 1;
        mov [r10 + 0],  rax;             // bound
        mov [r10 + 8],  r12;             // plane_slot
        mov [r10 + 16], r15;             // memory_slot
        mov [r10 + 24], r14;             // size
        xor rax, rax;
        mov [r10 + 32], rax;             // pos_x reset
        mov [r10 + 40], rax;             // pos_y reset

        mov rdi, 0;                      // PLCUR_ST_BINDS
        call plcur_note;

        mov rax, 0xFFFFF6B7;             // DEFERRED_HARDWARE
        jmp plcur_bd_out;

      plcur_bd_bad_pipe:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6BE;
        jmp plcur_bd_out;
      plcur_bd_no_row:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6B9;
        jmp plcur_bd_out;
      plcur_bd_wrong_type:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6BD;
        jmp plcur_bd_out;
      plcur_bd_bad_format:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6BB;
        jmp plcur_bd_out;
      plcur_bd_bad_size:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6BC;

      plcur_bd_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Immediate-effect position update (§2). Requires a prior bind.
  // ==========================================================================

  pub let plane_cursor_position_set : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (pipe: u64) (x: u64) (y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): set cursor (x, y) IMMEDIATELY -- outside the atomic-commit ARM cycle (§2). Requires a prior plane_cursor_bind on this pipe. Labels prefixed plcur_ps_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // pipe
        mov r12, rsi;                    // x
        mov r13, rdx;                    // y

        mov rdi, rbx;
        call plcur_pipe_valid;
        cmp rax, 0;
        je  plcur_ps_bad_pipe;

        mov rdi, r12;
        call plcur_pos_valid;
        cmp rax, 0;
        je  plcur_ps_bad_pos;
        mov rdi, r13;
        call plcur_pos_valid;
        cmp rax, 0;
        je  plcur_ps_bad_pos;

        // Must be bound.
        lea r10, [rip + _plane_cursor_state];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 1;
        jne plcur_ps_not_bound;

        mov [r10 + 32], r12;             // pos_x
        mov [r10 + 40], r13;             // pos_y

        mov rdi, 1;                      // PLCUR_ST_MOVES
        call plcur_note;

        xor rax, rax;
        jmp plcur_ps_out;

      plcur_ps_bad_pipe:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6BE;
        jmp plcur_ps_out;
      plcur_ps_bad_pos:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6BA;
        jmp plcur_ps_out;
      plcur_ps_not_bound:
        mov rdi, 2;
        call plcur_note;
        mov rax, 0xFFFFF6B8;

      plcur_ps_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let plcur_bound : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): 1 iff pipe has a recorded bind. Labels prefixed plcur_bnd_.",
      block: {
        cmp rdi, 4;
        jae plcur_bnd_no;
        lea r10, [rip + _plane_cursor_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        ret;
      plcur_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let plcur_size_of : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): bound size. Labels prefixed plcur_so_.",
      block: {
        cmp rdi, 4;
        jae plcur_so_no;
        lea r10, [rip + _plane_cursor_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];
        ret;
      plcur_so_no:
        xor rax, rax;
        ret
      }
    }

  pub let plcur_pos_x_of : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): pos_x. Labels prefixed plcur_pxo_.",
      block: {
        cmp rdi, 4;
        jae plcur_pxo_no;
        lea r10, [rip + _plane_cursor_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        ret;
      plcur_pxo_no:
        xor rax, rax;
        ret
      }
    }

  pub let plcur_pos_y_of : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M4-004 (#1252): pos_y. Labels prefixed plcur_pyo_.",
      block: {
        cmp rdi, 4;
        jae plcur_pyo_no;
        lea r10, [rip + _plane_cursor_state];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        ret;
      plcur_pyo_no:
        xor rax, rax;
        ret
      }
    }
}
