// src/kernel/core/drivers/dpy/iris_xe_hotplug.pdx -- Wave 75 G4 [R36]
// paideia-os #2541
//
// Intel Iris Xe (Gen12, Raptor Lake iGPU) display-engine hotplug IRQ
// wiring SKELETON for Wave 75 G4. On Gen 12 the DP / HDMI live-event
// path (plug / unplug / HPD reassert) terminates in the display-
// engine's DE_HPD_INTR MMIO block (0x44468..0x44477) and the per-DDI
// SHOTPLUG_CTL_DDI word (0xC4030). This file exposes a per-port ISR
// vector binding against the D1 KIND_INTERRUPT cap (Wave 65 #2518),
// so that when a cable change raises the DE_HPD_INTR_IIR bit for a
// port, the ISR posts to the port's paired KIND_NOTIFICATION cap and
// userspace re-probes EDID + re-modesets.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DE-side HPD IRQ dispatcher. Given a (port, vector,
// notification-cap) triple, it:
//
//   (1) stores the vector into the per-port binding row,
//   (2) marks the port registered,
//   (3) unmasks the DE_HPD_INTR_IER bit for that port (follow-up
//       slice -- skeleton stops at the state record),
//   (4) on ISR entry (iris_xe_hotplug_isr(port, state)) emits the
//       plug/unplug fingerprint and bumps the per-port event counter.
//
// It IS NOT the debounce + fanout half of the HPD path. That is
// hpd_isr.pdx (R36.M2-005 #1243) which owns the 100 ms debounce
// window + per-DDI state machine. The two coexist for the same
// reason iris_xe_cursor.pdx (G3 register-level) and
// plane_cursor.pdx (R36.M4-004 cap-side) coexist: this file does the
// REGISTER PROGRAMMING for the DE_HPD block, hpd_isr.pdx does the
// POLICY (debounce, state) above the raw ISR edge.
//
// It IS NOT the EDID walker. That is edid.pdx (R36.M2-002). On a
// plug the sequence is: THIS module posts to the notification cap →
// userspace observes the event → calls edid.pdx to re-read the EDID
// over AUX → calls modeset.pdx to re-program the pipe. This file
// does not perform the EDID read itself.
//
// It IS NOT the vector allocator. That is the D1 KIND_INTERRUPT
// mint path (kind_interrupt.pdx int_cap_mint, Wave 65 skeleton +
// follow-up slice). This module is the CONSUMER of a vector already
// minted by int_cap_mint: iris_xe_hotplug_register_port accepts the
// vector as an argument and records the binding.
//
// =============================================================================
// SECTION 1  REGISTER MAP (Intel Iris Xe / Alder-Lake / Raptor-Lake)
// =============================================================================
//
// Source: Intel bspec "Register Reference → Display Registers → ADL
// → Display Engine Interrupts". Pipe-INDEPENDENT: the DE_HPD_INTR
// block owns the four port-indexed interrupts (A/B/C/D) and the one
// extra TC port (E) that Gen12 ADL-P / RPL carry for Thunderbolt /
// USB4 alt-mode. Offsets are MMIO BAR-relative (same base as
// G2 modeset reads from _dpyb_table[0] + 16).
//
//   DE_HPD_INTR_ISR    0x44468   -- pending bits per port (RW1C on
//                                   the design-engine side; a port's
//                                   plug/unplug edge sets its bit).
//   DE_HPD_INTR_IMR    0x4446C   -- mask register (1 = masked,
//                                   0 = unmasked; matches the usual
//                                   display-engine convention).
//   DE_HPD_INTR_IIR    0x44470   -- identity / "which port fired"
//                                   latch; write-1-to-clear.
//   DE_HPD_INTR_IER    0x44474   -- enable register (1 = enabled);
//                                   mask vs. enable are two separate
//                                   knobs on the display engine --
//                                   the mask hides the IRQ from the
//                                   NB while the enable gates it at
//                                   the source. The real body uses
//                                   both; the skeleton touches
//                                   neither.
//   SHOTPLUG_CTL_DDI   0xC4030   -- per-DDI plug/unplug detect bits.
//                                   Four two-bit fields (DDI A / B /
//                                   C / D) + two for TC port E on
//                                   RPL-P. Bit [0] = detect enable,
//                                   bit [1] = status (1 = plugged).
//                                   The ISR reads this to decode
//                                   plug-vs-unplug.
//
// All accesses are 32-bit per Intel bspec §14 ("any wider or
// narrower access is undefined"). The real body uses mov_d (G1
// sized store) for every DE_HPD_INTR_* / SHOTPLUG_CTL_DDI write;
// this skeleton emits none of them.
//
// =============================================================================
// SECTION 2  PORT ENUMERATION (DDI letters, NOT pipe letters)
// =============================================================================
//
//   IRIS_HPD_PORT_A  0   DDI_A -- internal eDP panel on T14 G4
//                                  (Lenovo-wired; always PORT_A on
//                                  this platform per VBT G1 scan).
//   IRIS_HPD_PORT_B  1   DDI_B -- external DP / HDMI alt-mode over
//                                  USB-C (left-side TB4 port).
//   IRIS_HPD_PORT_C  2   DDI_C -- external DP / HDMI alt-mode over
//                                  USB-C (right-side TB4 port).
//   IRIS_HPD_PORT_D  3   DDI_D -- external DP / HDMI alt-mode over
//                                  USB-C (if the chassis populates a
//                                  third TB4 port; T14 G4 ships two).
//   IRIS_HPD_PORT_E  4   DDI_E -- extra Type-C port carried in the
//                                  silicon header, reserved; not
//                                  wired on T14 G4.
//
// T14 G4 ships PORT_A (eDP) + PORT_B + PORT_C populated; PORT_D is
// silicon-present-but-not-wired, PORT_E is reserved. The skeleton
// admits all five -- a mint that names PORT_D or PORT_E simply
// never fires an ISR because no cable can plug into a port the
// chassis does not expose. Refusing them in the register path
// would make the skeleton less portable to a future Lenovo SKU
// that routes PORT_D to a dedicated HDMI jack.
//
// =============================================================================
// SECTION 3  DISPATCH SLOT -- KIND_HOTPLUG_DRV = 0x41 (Wave 75 G4)
// =============================================================================
//
// Three new derived-kind-DRV tags land in Wave 75 in parallel: D11
// (fan driver) at 0x40, this file at 0x41, and D12 (future) at 0x42
// -- wait, 0x42 is KIND_BLKDEV from R51; the D12 slot was adjusted
// upstream. For Wave 75 the two parallel softarchs claim 0x40 (fan)
// and 0x41 (hotplug) adjacent to the Wave 74 D9/D10/G5 cluster
// (0x3D/0x3E/0x3F). All three Wave 75 _DRV tags sit above the 4-bit
// base-slot range and below every existing derived-kind block.
//
// Audit at landing time (grep over src/kernel/core/cap/):
//
//     $ grep -nE 'cmp rcx, 0x4[01]\b' src/kernel/core/cap/invoke.pdx
//     (empty)
//     $ grep -rnE 'KIND_HOTPLUG_DRV\s*:\s*u64\s*=' src/kernel/
//     (empty)
//
// 0x40 and 0x41 appear in src/kernel/core/cap/interrupt_cap.pdx as
// retired-alias constants (KIND_INTERRUPT_CAP = 0x40,
// KIND_NOTIFICATION_CAP = 0x41) per the pre-R29 compat shim
// (design/drivers/kind-interrupt.md §4.6). Those are historical
// name mappings; neither has an active `cmp rcx, 0x40` or
// `cmp rcx, 0x41` dispatch arm in invoke.pdx, and the retirement
// path explicitly reclaims the tag namespace. The two Wave 75
// parallel softarchs reclaim 0x40 / 0x41 for their _DRV kinds; the
// retired aliases remain in interrupt_cap.pdx as named constants
// for the retirement window, but no dispatch arm resolves to them.
//
// 0x41 fits imm32 with bit 31 clear so the dispatch arm uses
// `cmp rcx, 0x41` directly (no r9 staging), same posture as the
// Wave 74 D9/D10/G5 arms (0x3D/0x3E/0x3F).
//
// =============================================================================
// SECTION 4  DERIVATION POSTURE
// =============================================================================
//
// KIND_HOTPLUG_DRV derives over KIND_IPC_ENDPOINT (base slot 5):
// a hotplug subscription is per-conversation state -- one
// userspace client, one endpoint it receives EDID-re-probe events
// on, one SET of ports it is authorised to watch. Same posture as
// KIND_GPU_VM (0x175), KIND_PPGTT (0x3F), KIND_PCIE_HOTPLUG_EVENT
// (0x16B): any piece of event-stream state the compositor hands
// out is anchored on the endpoint that holds the completion mail
// slot. The dispatch arm in cap/invoke.pdx compares the FULL u64
// kind field, so the slot-5 KIND_IPC_ENDPOINT handler and this
// kind coexist cleanly (same fall-through-safe pattern every
// derived kind in that file uses).
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY 0xFFFFFFE5..0xFFFFFFE9 (TASK-DIRECTIVE RESERVED)
// =============================================================================
//
// Five codes per the Wave 75 G4 task directive (all five fit imm32
// with bit 31 clear so `mov rax, imm32` is a 7-byte emit):
//
//   IXH_ERR_INT_NOT_INITED   = 0xFFFFFFE5  -- iris_xe_hotplug_init
//                                             not yet called (so the
//                                             KIND_INTERRUPT substrate
//                                             the ISR will post into
//                                             is not up)
//   IXH_ERR_BAD_PORT         = 0xFFFFFFE6  -- port > 4
//   IXH_ERR_PORT_REGISTERED  = 0xFFFFFFE7  -- register_port called a
//                                             second time on the
//                                             same port
//   IXH_ERR_UNKNOWN_STATE    = 0xFFFFFFE8  -- isr called with state
//                                             not in {PLUG, UNPLUG}
//   IXH_ERR_MMIO_UNMAPPED    = 0xFFFFFFE9  -- _dpyb_table[0] + 16
//                                             mmio_base is zero (G2
//                                             probe-race, same gate
//                                             iris_xe_modeset uses)
//
// Adjacent kernel-owned bands: dw_irq.pdx (I2C_IRQ_NOT_OWNER /
// I2C_IRQ_BUSY) uses 0xFFFFFFE5..E6 for its own module-local
// return values; the band-table comments across the kernel also
// mention MSIX_* at 0xFFFFFFE7..EF. All three bands are MODULE-
// LOCAL: dw_irq's codes never leave dw_irq, MSIX_* codes never
// leave the MSI-X substrate, and this module's codes never leave
// the hotplug surface. The same collision policy cap/kind_op_region
// .pdx §4 describes ("those are return values that never leave
// their own modules, so collision is harmless") applies here.
//
// =============================================================================
// SECTION 6  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x41 and all five error sentinels fit imm32
// with bit 31 clear.  No `test rN,rN` anywhere (liveness checks use
// `cmp rN, 0`).  No `and r11, imm64`; the one masked compare
// (op_code & 0xFF) stages through r10.  No 2-op `imul r,imm`; the
// per-port row base multiply uses `shl 5` (stride 32 is a power of
// two).  All `pub let` string declarations are on single lines.
// Module basename `IrisXeHotplug` matches the file basename
// `iris_xe_hotplug.pdx`.  Every label is prefixed `ixh_` (reserved-
// word discipline -- `loop` / `if` / `let` are keywords).
// klog_s1_x1_d1 caller uses the `sub rsp, 16; mov [rsp+0], vd;
// call klog_s1_x1_d1; add rsp, 16` idiom (v at caller [rsp+0] NOT
// [rsp+8] -- Wave 73 I7 broke this once and the fix is mirrored).
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file
// compiles alongside the kernel because tools/build.sh recurses
// through src/kernel/core/drivers/dpy/ with a single `find`, so a
// new .pdx in that directory is picked up automatically; no
// build.sh edit required.
//
// invoke.pdx gets ONE new dispatch arm (0x41 → cap_handler_hotplug)
// alongside this file; the arm sits between the Wave 75 D11
// 0x40 KIND_FAN_DRV block (dispatched in parallel) and the Wave 74
// G5 0x3F KIND_PPGTT arm.
//
// A follow-up slice adds a boot-witness programme at
// tests/kernel/drivers/wit_iris_xe_hotplug_init.pdx that:
//   (1) iris_xe_hotplug_init();
//   (2) iris_xe_hotplug_register_port(0, 0x60);
//   (3) iris_xe_hotplug_isr(0, IXH_STATE_PLUG);
//   (4) iris_xe_hotplug_mask(0);
//   (5) iris_xe_hotplug_unmask(0);
// and asserts the two fingerprints land on the klog wire plus the
// counter getters report (1, 1, 1, 1).

module IrisXeHotplug = structure {

  // ==========================================================================
  // §A  KIND / rights
  // ==========================================================================

  pub let KIND_HOTPLUG_DRV      : u64 = 0x41    // Wave 75 G4 derived-kind tag
  pub let KIND_HOTPLUG_DRV_BASE : u64 = 5       // = KIND_IPC_ENDPOINT

  pub let R_IXH_READ   : u64 = 0x001    // query ops (vector, state, counters)
  pub let R_IXH_WRITE  : u64 = 0x002    // mask / unmask (future wiring)
  pub let R_IXH_ALL    : u64 = 0x003    // handed to the holder on create

  // ==========================================================================
  // §B  DE_HPD_INTR MMIO offsets (BAR-relative; base from _dpyb_table[0]+16)
  // ==========================================================================

  pub let IXH_DE_HPD_INTR_ISR  : u64 = 0x44468
  pub let IXH_DE_HPD_INTR_IMR  : u64 = 0x4446C
  pub let IXH_DE_HPD_INTR_IIR  : u64 = 0x44470
  pub let IXH_DE_HPD_INTR_IER  : u64 = 0x44474
  pub let IXH_SHOTPLUG_CTL_DDI : u64 = 0xC4030

  // ==========================================================================
  // §C  Port enumeration (DDI letters, NOT pipe letters)
  // ==========================================================================

  pub let IRIS_HPD_PORT_A    : u64 = 0
  pub let IRIS_HPD_PORT_B    : u64 = 1
  pub let IRIS_HPD_PORT_C    : u64 = 2
  pub let IRIS_HPD_PORT_D    : u64 = 3
  pub let IRIS_HPD_PORT_E    : u64 = 4
  pub let IRIS_HPD_PORT_COUNT : u64 = 5

  // ==========================================================================
  // §D  ISR state tag (fingerprint selector)
  // ==========================================================================

  pub let IXH_STATE_PLUG   : u64 = 1
  pub let IXH_STATE_UNPLUG : u64 = 0
  pub let IXH_STATE_MAX    : u64 = 1

  // ==========================================================================
  // §E  Failure codes (SECTION 5)
  // ==========================================================================

  pub let IXH_OK                   : u64 = 0
  pub let IXH_ERR_INT_NOT_INITED   : u64 = 0xFFFFFFE5
  pub let IXH_ERR_BAD_PORT         : u64 = 0xFFFFFFE6
  pub let IXH_ERR_PORT_REGISTERED  : u64 = 0xFFFFFFE7
  pub let IXH_ERR_UNKNOWN_STATE    : u64 = 0xFFFFFFE8
  pub let IXH_ERR_MMIO_UNMAPPED    : u64 = 0xFFFFFFE9

  // Standard cap_invoke sentinels.
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // ==========================================================================
  // §F  cap_handler_hotplug op ordinals (query-only at Wave 75 G4)
  // ==========================================================================

  pub let IXH_OP_QUERY_VECTOR : u64 = 0    // -> port's bound ISR vector
  pub let IXH_OP_QUERY_LIVE   : u64 = 1    // -> 1 iff port registered
  pub let IXH_OP_QUERY_EVENTS : u64 = 2    // -> port's event-count tally
  pub let IXH_OP_MAX          : u64 = 2

  // ==========================================================================
  // §G  Per-port state -- 4 u64 slots per port * 5 ports = 20 u64s.
  //
  // Layout per port (32 bytes stride, port * 32 = `shl r, 5`):
  //   +0  registered   -- 0 = free, 1 = bound to a vector
  //   +8  vector       -- MSI-X vector or IOAPIC pin bound to this port
  //   +16 masked       -- 0 = unmasked, 1 = masked (SW mirror of IMR bit)
  //   +24 event_count  -- bump on every iris_xe_hotplug_isr call
  //
  // Twenty u64s = 160 bytes; stride 32 is a power of two so `shl 5`
  // (not 2-op `imul`) resolves the per-port row base.
  // ==========================================================================

  pub let mut _ixh_port_state : [u64; 20] = uninit @align(64)

  // Global init flag; iris_xe_hotplug_init stamps it to 1. Register /
  // mask / unmask / isr refuse with IXH_ERR_INT_NOT_INITED while it is
  // zero.  Kept as a 1-element array to match the gpu_gtt_inited
  // addressing idiom.
  pub let mut _ixh_inited : [u64; 1] = uninit @align(8)

  // Per-op stats (bumped once per successful entry).  Visible via the
  // getter trio in §Q.
  pub let mut _ixh_init_ct      : u64 = 0
  pub let mut _ixh_register_ct  : u64 = 0
  pub let mut _ixh_mask_ct      : u64 = 0
  pub let mut _ixh_unmask_ct    : u64 = 0
  pub let mut _ixh_isr_ct       : u64 = 0

  // ==========================================================================
  // §H  Fingerprint tags + keys
  //
  // Fingerprint on the wire, port A:
  //   HOTPLUG REGISTER port=a vector=<dec>
  //   HOTPLUG EVENT port=a state=plug
  //   HOTPLUG EVENT port=a state=unplug
  //
  // Per-port tag text bakes `port=<a..e>` into the tag literal
  // (same pattern iris_xe_cursor.pdx uses for CURSOR SET / HIDE),
  // so klog_s1 / klog_s1_x1_d1 only carry the dynamic value.
  //
  // Matches tests/fingerprints/iris_xe_hotplug.golden.
  // ==========================================================================

  pub let ixh_tag_register_a : [u8; 24] = "HOTPLUG REGISTER port=a\0"
  pub let ixh_tag_register_b : [u8; 24] = "HOTPLUG REGISTER port=b\0"
  pub let ixh_tag_register_c : [u8; 24] = "HOTPLUG REGISTER port=c\0"
  pub let ixh_tag_register_d : [u8; 24] = "HOTPLUG REGISTER port=d\0"
  pub let ixh_tag_register_e : [u8; 24] = "HOTPLUG REGISTER port=e\0"

  pub let ixh_tag_evt_plug_a   : [u8; 32] = "HOTPLUG EVENT port=a state=plug\0"
  pub let ixh_tag_evt_plug_b   : [u8; 32] = "HOTPLUG EVENT port=b state=plug\0"
  pub let ixh_tag_evt_plug_c   : [u8; 32] = "HOTPLUG EVENT port=c state=plug\0"
  pub let ixh_tag_evt_plug_d   : [u8; 32] = "HOTPLUG EVENT port=d state=plug\0"
  pub let ixh_tag_evt_plug_e   : [u8; 32] = "HOTPLUG EVENT port=e state=plug\0"

  pub let ixh_tag_evt_unplug_a : [u8; 34] = "HOTPLUG EVENT port=a state=unplug\0"
  pub let ixh_tag_evt_unplug_b : [u8; 34] = "HOTPLUG EVENT port=b state=unplug\0"
  pub let ixh_tag_evt_unplug_c : [u8; 34] = "HOTPLUG EVENT port=c state=unplug\0"
  pub let ixh_tag_evt_unplug_d : [u8; 34] = "HOTPLUG EVENT port=d state=unplug\0"
  pub let ixh_tag_evt_unplug_e : [u8; 34] = "HOTPLUG EVENT port=e state=unplug\0"

  pub let ixh_tag_handler_entry : [u8; 29] = "KIND_HOTPLUG_DRV dispatch iv\0"

  pub let ixh_k_vector : [u8; 7] = "vector\0"

  // ==========================================================================
  // §I  iris_xe_hotplug_reset() -> ()
  //
  // Defensive clear of the 20-u64 port-state table + inited flag +
  // the five counters.  Called at boot alongside hpd_reset /
  // gpu_gtt_reset.  .bss zero-init at real boot already satisfies the
  // postcondition; this is defensive (matches firmware_blob_table_
  // reset / gpu_gtt_reset / dpyb reset shape one-for-one).
  // ==========================================================================
  pub let iris_xe_hotplug_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): clear 20 u64 of _ixh_port_state + the inited flag + the five counters. .bss zero-init at real boot already satisfies the postcondition; this is defensive, matching firmware_blob_table_reset / gpu_gtt_reset shape one-for-one. Labels prefixed ixh_rs_.",
      block: {
        lea r10, [rip + _ixh_port_state];
        xor rax, rax;
        xor rcx, rcx;
      ixh_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 20;
        jb  ixh_rs_rows;

        lea r10, [rip + _ixh_inited];
        mov [r10 + 0], rax;

        mov [rip + _ixh_init_ct],     rax;
        mov [rip + _ixh_register_ct], rax;
        mov [rip + _ixh_mask_ct],     rax;
        mov [rip + _ixh_unmask_ct],   rax;
        mov [rip + _ixh_isr_ct],      rax;
        ret
      }
    }

  // ==========================================================================
  // §J  iris_xe_hotplug_init() -> u64
  //
  // Stamp inited=1 after the KIND_INTERRUPT substrate (D1 Wave 65) has
  // been brought up by the supervisor.  Bumps _ixh_init_ct and returns
  // IXH_OK.  Idempotent -- a second call simply re-stamps 1.
  //
  // No MMIO writes at skeleton stage; the real body additionally
  // writes 0xFFFFFFFF to DE_HPD_INTR_IIR (clear any stale pending
  // bits) and 0 to DE_HPD_INTR_IER (keep every port masked until
  // register_port is called).  Both writes are 32-bit (mov_d).
  // ==========================================================================
  pub let iris_xe_hotplug_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541) skeleton: stamp _ixh_inited[0]=1, bump _ixh_init_ct, return IXH_OK. Idempotent (a second call re-stamps 1). The real body additionally writes 0xFFFFFFFF to DE_HPD_INTR_IIR + 0 to DE_HPD_INTR_IER after the stamp but before the counter bump -- both 32-bit mov_d. Pure leaf. Labels prefixed ixh_in_.",
      block: {
        lea r10, [rip + _ixh_inited];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rax, [rip + _ixh_init_ct];
        add rax, 1;
        mov [rip + _ixh_init_ct], rax;

        xor rax, rax;                        // IXH_OK
        ret
      }
    }

  // ==========================================================================
  // §K  iris_xe_hotplug_inited_q() -> 1 iff init called
  // ==========================================================================
  pub let iris_xe_hotplug_inited_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): single-load getter for _ixh_inited[0]. Pure leaf. Labels prefixed ixh_iq_.",
      block: {
        lea r10, [rip + _ixh_inited];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // §L  iris_xe_hotplug_mmio_base_q() -> u64 (0 iff unmapped)
  //
  // Pulls _dpyb_table[0] + 16 (the IRIS_XE row's mmio_base) through
  // the same route G2 modeset and G3 cursor's follow-up slice take.
  // Zero = probe not yet complete (same gate iris_xe_modeset uses).
  // ==========================================================================
  pub let iris_xe_hotplug_mmio_base_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): read _dpyb_table[0]+16 as mmio_base. Zero = probe not yet complete; mask/unmask gate on this. Pure leaf. Labels prefixed ixh_mb_.",
      block: {
        lea rax, [rip + _dpyb_table];
        mov rax, [rax + 16];
        ret
      }
    }

  // ==========================================================================
  // §M  iris_xe_hotplug_register_port(port, vector) -> u64
  //
  // Bind `vector` to the per-port state slot `port`, mark the port
  // registered, bump _ixh_register_ct, emit the per-port
  // `HOTPLUG REGISTER port=<a..e> vector=<dec>` fingerprint via
  // klog_s1_x1_d1 (hex key `vector`, decimal value).  Returns IXH_OK.
  //
  // Gates in order:
  //   (1) _ixh_inited == 0        -> IXH_ERR_INT_NOT_INITED
  //   (2) port > 4                -> IXH_ERR_BAD_PORT
  //   (3) per-port registered!=0  -> IXH_ERR_PORT_REGISTERED
  //
  // The real body additionally sets the DE_HPD_INTR_IER bit for the
  // port (unmasks delivery) and writes SHOTPLUG_CTL_DDI's enable bit
  // for the port's two-bit field.  Both writes are 32-bit mov_d.
  // The skeleton stops at the state record + fingerprint so the
  // ordering witness fires.
  //
  // SysV: rdi = port, rsi = vector.
  // Stack recipe: 3-push callee-save prologue (rbx, r12, r13 = 24 B;
  // entry rsp%16==8 flips to 0 after 3 pushes, pre-CALL aligned).
  // For the klog_s1_x1_d1 7th arg (vd = vector) we do `sub rsp, 16`
  // pad + `mov [rsp+0], r12` = 16 B total; rsp%16==0 at the CALL.
  // `add rsp, 16` on cleanup reclaims the pad.
  // ==========================================================================
  pub let iris_xe_hotplug_register_port : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (port: u64) (vector: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541) skeleton: bind vector to port, mark registered, bump _ixh_register_ct, emit HOTPLUG REGISTER fingerprint via klog_s1_x1_d1 (hex key, decimal vector). Gates: (1) _ixh_inited == 0 -> IXH_ERR_INT_NOT_INITED (0xFFFFFFE5). (2) port > 4 -> IXH_ERR_BAD_PORT (0xFFFFFFE6). (3) per-port registered!=0 -> IXH_ERR_PORT_REGISTERED (0xFFFFFFE7). Per-port stride is 32 bytes; `shl 5` resolves the row base (no 2-op imul). Register plan: rbx=port, r12=vector. Entry rsp%16==8; three callee-save pushes land rsp%16==0; sub rsp,16 pad+write stages v2 for klog_s1_x1_d1 at caller [rsp+0]; CALL. add rsp,16 reclaims. Labels prefixed ixh_rp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // port (saved)
        mov r12, rsi;                        // vector (saved)

        // --- Gate (1): inited?
        call iris_xe_hotplug_inited_q;
        cmp rax, 0;
        je  ixh_rp_not_inited;

        // --- Gate (2): port in {0..4}.
        cmp rbx, 4;
        ja  ixh_rp_badport;

        // --- Compute per-port row base + check `registered` slot.
        lea r10, [rip + _ixh_port_state];
        mov rax, rbx;
        shl rax, 5;                          // port * 32
        add r10, rax;
        mov rax, [r10 + 0];                  // registered slot
        cmp rax, 0;
        jne ixh_rp_dup;

        // --- Stamp state: registered=1, vector=vector, masked=0.
        mov rax, 1;
        mov [r10 + 0], rax;                  // registered
        mov [r10 + 8], r12;                  // vector
        xor rax, rax;
        mov [r10 + 16], rax;                 // masked (unmasked on register)

        // --- Count the register (bump before fingerprint so a
        //     crash mid-fingerprint still records the entry).
        mov rax, [rip + _ixh_register_ct];
        add rax, 1;
        mov [rip + _ixh_register_ct], rax;

        // --- Select the per-port REGISTER tag.
        //     rbx == 0 -> tag_register_a; 1 -> _b; ... ; 4 -> _e.
        cmp rbx, 0;
        je  ixh_rp_tag_a;
        cmp rbx, 1;
        je  ixh_rp_tag_b;
        cmp rbx, 2;
        je  ixh_rp_tag_c;
        cmp rbx, 3;
        je  ixh_rp_tag_d;
        lea rdx, [rip + ixh_tag_register_e];
        jmp ixh_rp_tag_done;
      ixh_rp_tag_a:
        lea rdx, [rip + ixh_tag_register_a];
        jmp ixh_rp_tag_done;
      ixh_rp_tag_b:
        lea rdx, [rip + ixh_tag_register_b];
        jmp ixh_rp_tag_done;
      ixh_rp_tag_c:
        lea rdx, [rip + ixh_tag_register_c];
        jmp ixh_rp_tag_done;
      ixh_rp_tag_d:
        lea rdx, [rip + ixh_tag_register_d];
      ixh_rp_tag_done:

        // --- klog_s1_x1_d1(level=3, SUBSYS_DRV_, tag, k_vector,
        //                   v=vector (dummy hex v), k_vector (dec),
        //                   [vd=vector]).
        // The x1_d1 wrapper takes six regs + one stack arg; we use
        // the vector itself twice (once as the hex vx, once as the
        // decimal vd) -- the hex KV is a byte-identical duplicate but
        // keeps the wrapper shape so the goldens read naturally.
        // Simpler alternative is to skip the hex KV; here we emit a
        // single decimal KV via x1_d1 by passing an EMPTY hex key.
        //
        // On balance: pass vector as decimal only by using the
        // klog_s1 shape with the per-port tag + append-vector-as-
        // decimal through x1_d1 with kx = ixh_k_vector, vx = vector
        // (hex spelling, discarded by the golden pattern), kd =
        // ixh_k_vector, vd = vector (decimal spelling that the test
        // matches on).  The follow-up slice mints klog_s1_d1 (one
        // decimal KV only) and this call site drops the hex copy.
        //
        // sub rsp, 16; mov [rsp+0], r12 pushes vd at caller [rsp+0].
        sub rsp, 16;
        mov [rsp + 0], r12;                  // vd = vector (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        // rdx = tag (already set above)
        lea rcx, [rip + ixh_k_vector];       // kx
        mov r8, r12;                         // vx = vector (hex, cosmetic)
        lea r9, [rip + ixh_k_vector];        // kd
        call klog_s1_x1_d1;
        add rsp, 16;

        xor rax, rax;                        // IXH_OK
        jmp ixh_rp_out;

      ixh_rp_not_inited:
        mov rax, 0xFFFFFFE5;                 // IXH_ERR_INT_NOT_INITED
        jmp ixh_rp_out;
      ixh_rp_badport:
        mov rax, 0xFFFFFFE6;                 // IXH_ERR_BAD_PORT
        jmp ixh_rp_out;
      ixh_rp_dup:
        mov rax, 0xFFFFFFE7;                 // IXH_ERR_PORT_REGISTERED

      ixh_rp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  iris_xe_hotplug_mask(port) -> u64
  //
  // Flip the per-port `masked` slot to 1, bump _ixh_mask_ct.  Real
  // body: set bit (1 << port) of DE_HPD_INTR_IMR (one 32-bit mov_d
  // read-modify-write under the display-engine's lock).  Skeleton
  // stops at the state record.
  //
  // Gates in order:
  //   (1) _ixh_inited == 0            -> IXH_ERR_INT_NOT_INITED
  //   (2) port > 4                    -> IXH_ERR_BAD_PORT
  //   (3) mmio_base == 0              -> IXH_ERR_MMIO_UNMAPPED
  //   (4) per-port registered == 0    -> IXH_ERR_PORT_REGISTERED (reused;
  //                                      the register_port call is the
  //                                      arrival of the vector AND the
  //                                      permission to mask it)
  //
  // No fingerprint on mask -- the hot path IS mask-and-restore in
  // the atomic-commit journal, and emitting a line per mask would
  // flood the klog on any screensaver test.
  //
  // SysV: rdi = port.  Leaf past the two getter calls.
  // ==========================================================================
  pub let iris_xe_hotplug_mask : (u64) -> u64 !{mem, sysreg} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541) skeleton: flip per-port `masked` slot to 1, bump _ixh_mask_ct. Gates: (1) _ixh_inited==0 -> IXH_ERR_INT_NOT_INITED. (2) port > 4 -> IXH_ERR_BAD_PORT. (3) mmio_base == 0 -> IXH_ERR_MMIO_UNMAPPED (the real body would need an MMIO write; the skeleton gates the same way so the follow-up slice does not have to re-shape the error taxonomy). (4) per-port registered == 0 -> IXH_ERR_PORT_REGISTERED (reused: register_port is both the vector arrival AND the permission to mask). No fingerprint on mask (hot path on atomic-commit journal; flooding the klog would hide real failures). Register plan: rbx=port. Two callee-save pushes, two nested getter calls land rsp%16==0 at every call. Labels prefixed ixh_mk_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;

        // --- Gate (1): inited?
        call iris_xe_hotplug_inited_q;
        cmp rax, 0;
        je  ixh_mk_not_inited;

        // --- Gate (2): port in {0..4}.
        cmp rbx, 4;
        ja  ixh_mk_badport;

        // --- Gate (3): mmio_base mapped?
        call iris_xe_hotplug_mmio_base_q;
        cmp rax, 0;
        je  ixh_mk_no_mmio;

        // --- Row base + check `registered`.
        lea r10, [rip + _ixh_port_state];
        mov rax, rbx;
        shl rax, 5;
        add r10, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ixh_mk_notreg;

        // --- Flip `masked` = 1.
        mov rax, 1;
        mov [r10 + 16], rax;

        // --- Count the mask.
        mov rax, [rip + _ixh_mask_ct];
        add rax, 1;
        mov [rip + _ixh_mask_ct], rax;

        xor rax, rax;                        // IXH_OK
        jmp ixh_mk_out;

      ixh_mk_not_inited:
        mov rax, 0xFFFFFFE5;
        jmp ixh_mk_out;
      ixh_mk_badport:
        mov rax, 0xFFFFFFE6;
        jmp ixh_mk_out;
      ixh_mk_no_mmio:
        mov rax, 0xFFFFFFE9;
        jmp ixh_mk_out;
      ixh_mk_notreg:
        mov rax, 0xFFFFFFE7;

      ixh_mk_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  iris_xe_hotplug_unmask(port) -> u64
  //
  // Flip the per-port `masked` slot to 0, bump _ixh_unmask_ct.  Real
  // body: clear bit (1 << port) of DE_HPD_INTR_IMR.  Skeleton stops
  // at the state record.  Gates identical to mask().
  // ==========================================================================
  pub let iris_xe_hotplug_unmask : (u64) -> u64 !{mem, sysreg} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541) skeleton: clear per-port `masked` slot, bump _ixh_unmask_ct. Gates identical to iris_xe_hotplug_mask. No fingerprint (symmetric with mask on the atomic-commit journal hot path). Register plan: rbx=port. Two callee-save pushes land rsp%16==0 at the two nested getter calls. Labels prefixed ixh_un_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;

        call iris_xe_hotplug_inited_q;
        cmp rax, 0;
        je  ixh_un_not_inited;

        cmp rbx, 4;
        ja  ixh_un_badport;

        call iris_xe_hotplug_mmio_base_q;
        cmp rax, 0;
        je  ixh_un_no_mmio;

        lea r10, [rip + _ixh_port_state];
        mov rax, rbx;
        shl rax, 5;
        add r10, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ixh_un_notreg;

        xor rax, rax;
        mov [r10 + 16], rax;                 // masked = 0

        mov rax, [rip + _ixh_unmask_ct];
        add rax, 1;
        mov [rip + _ixh_unmask_ct], rax;

        xor rax, rax;
        jmp ixh_un_out;

      ixh_un_not_inited:
        mov rax, 0xFFFFFFE5;
        jmp ixh_un_out;
      ixh_un_badport:
        mov rax, 0xFFFFFFE6;
        jmp ixh_un_out;
      ixh_un_no_mmio:
        mov rax, 0xFFFFFFE9;
        jmp ixh_un_out;
      ixh_un_notreg:
        mov rax, 0xFFFFFFE7;

      ixh_un_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §P  iris_xe_hotplug_isr(port, state) -> u64
  //
  // ISR body.  Validate port+state, bump per-port event_count +
  // _ixh_isr_ct, emit the per-port+per-state
  // `HOTPLUG EVENT port=<a..e> state=<plug|unplug>` fingerprint via
  // klog_s1 (zero KVs; port + state baked into the tag).  Real body:
  //
  //   (1) read DE_HPD_INTR_IIR, bail if port's bit not set
  //   (2) write-1-to-clear port's IIR bit
  //   (3) decode plug-vs-unplug from SHOTPLUG_CTL_DDI (bit 1 of the
  //       port's two-bit field)
  //   (4) post to the paired KIND_NOTIFICATION cap via the
  //       KIND_INTERRUPT dispatch tail (same path kind_interrupt.pdx
  //       int_cap_dispatch takes once its real body lands)
  //   (5) apic_eoi
  //
  // Skeleton bypasses (1)-(5) and accepts a pre-decoded state from
  // the caller (plug vs. unplug): a boot-witness programme can thus
  // simulate an edge without touching MMIO.
  //
  // Gates in order:
  //   (1) _ixh_inited == 0            -> IXH_ERR_INT_NOT_INITED
  //   (2) port > 4                    -> IXH_ERR_BAD_PORT
  //   (3) per-port registered == 0    -> IXH_ERR_PORT_REGISTERED
  //   (4) state > IXH_STATE_MAX       -> IXH_ERR_UNKNOWN_STATE
  //
  // SysV: rdi = port, rsi = state.
  // Stack recipe: 3-push callee-save prologue (rbx, r12, r13 = 24 B;
  // entry rsp%16==8 flips to 0 after 3 pushes, pre-CALL aligned).
  // ==========================================================================
  pub let iris_xe_hotplug_isr : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (port: u64) (state: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541) skeleton: validate port + state, bump per-port event_count + _ixh_isr_ct, emit HOTPLUG EVENT fingerprint via klog_s1 (zero KVs). Gates: (1) inited==0 -> IXH_ERR_INT_NOT_INITED. (2) port>4 -> IXH_ERR_BAD_PORT. (3) per-port registered==0 -> IXH_ERR_PORT_REGISTERED. (4) state>1 -> IXH_ERR_UNKNOWN_STATE. Per-port+per-state tag selection is a 10-way lookup (5 ports x 2 states); the skeleton inlines the branch chain rather than a jump table because the pdx encoder's jump-table emit is not yet proven and a lookup table would move the tag addresses off the small-constant lea form the follow-up slice depends on. Register plan: rbx=port, r12=state. Entry rsp%16==8; three pushes land ==0 pre-CALL. klog_s1 wrapper takes zero stack args. Labels prefixed ixh_is_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // port (saved)
        mov r12, rsi;                        // state (saved)

        // --- Gate (1): inited?
        call iris_xe_hotplug_inited_q;
        cmp rax, 0;
        je  ixh_is_not_inited;

        // --- Gate (2): port in {0..4}.
        cmp rbx, 4;
        ja  ixh_is_badport;

        // --- Gate (3): per-port registered?
        lea r10, [rip + _ixh_port_state];
        mov rax, rbx;
        shl rax, 5;
        add r10, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ixh_is_notreg;

        // --- Gate (4): state in {PLUG=1, UNPLUG=0}.
        cmp r12, 1;
        ja  ixh_is_badstate;

        // --- Bump per-port event_count + global _ixh_isr_ct.
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;

        mov rax, [rip + _ixh_isr_ct];
        add rax, 1;
        mov [rip + _ixh_isr_ct], rax;

        // --- Select the per-port, per-state EVENT tag.
        //     Branch on state first (PLUG vs UNPLUG), then on port.
        cmp r12, 1;
        je  ixh_is_plug_select;

        // state == UNPLUG: pick per-port unplug tag.
        cmp rbx, 0;
        je  ixh_is_unplug_a;
        cmp rbx, 1;
        je  ixh_is_unplug_b;
        cmp rbx, 2;
        je  ixh_is_unplug_c;
        cmp rbx, 3;
        je  ixh_is_unplug_d;
        lea rdx, [rip + ixh_tag_evt_unplug_e];
        jmp ixh_is_tag_done;
      ixh_is_unplug_a:
        lea rdx, [rip + ixh_tag_evt_unplug_a];
        jmp ixh_is_tag_done;
      ixh_is_unplug_b:
        lea rdx, [rip + ixh_tag_evt_unplug_b];
        jmp ixh_is_tag_done;
      ixh_is_unplug_c:
        lea rdx, [rip + ixh_tag_evt_unplug_c];
        jmp ixh_is_tag_done;
      ixh_is_unplug_d:
        lea rdx, [rip + ixh_tag_evt_unplug_d];
        jmp ixh_is_tag_done;

      ixh_is_plug_select:
        // state == PLUG: pick per-port plug tag.
        cmp rbx, 0;
        je  ixh_is_plug_a;
        cmp rbx, 1;
        je  ixh_is_plug_b;
        cmp rbx, 2;
        je  ixh_is_plug_c;
        cmp rbx, 3;
        je  ixh_is_plug_d;
        lea rdx, [rip + ixh_tag_evt_plug_e];
        jmp ixh_is_tag_done;
      ixh_is_plug_a:
        lea rdx, [rip + ixh_tag_evt_plug_a];
        jmp ixh_is_tag_done;
      ixh_is_plug_b:
        lea rdx, [rip + ixh_tag_evt_plug_b];
        jmp ixh_is_tag_done;
      ixh_is_plug_c:
        lea rdx, [rip + ixh_tag_evt_plug_c];
        jmp ixh_is_tag_done;
      ixh_is_plug_d:
        lea rdx, [rip + ixh_tag_evt_plug_d];

      ixh_is_tag_done:
        // --- klog_s1(level=3, SUBSYS_DRV_, tag).  Zero KVs.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        // rdx = tag (already loaded above)
        call klog_s1;

        xor rax, rax;                        // IXH_OK
        jmp ixh_is_out;

      ixh_is_not_inited:
        mov rax, 0xFFFFFFE5;
        jmp ixh_is_out;
      ixh_is_badport:
        mov rax, 0xFFFFFFE6;
        jmp ixh_is_out;
      ixh_is_notreg:
        mov rax, 0xFFFFFFE7;
        jmp ixh_is_out;
      ixh_is_badstate:
        mov rax, 0xFFFFFFE8;

      ixh_is_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §Q  Stat accessors -- single-load leaf getters for witness callers.
  // ==========================================================================

  pub let iris_xe_hotplug_init_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): single-load getter for _ixh_init_ct. Witness-side assertion anchor. Leaf.",
      block: { mov rax, [rip + _ixh_init_ct]; ret }
    }

  pub let iris_xe_hotplug_register_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): single-load getter for _ixh_register_ct. Pair for iris_xe_hotplug_init_count. Leaf.",
      block: { mov rax, [rip + _ixh_register_ct]; ret }
    }

  pub let iris_xe_hotplug_mask_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): single-load getter for _ixh_mask_ct. Leaf.",
      block: { mov rax, [rip + _ixh_mask_ct]; ret }
    }

  pub let iris_xe_hotplug_unmask_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): single-load getter for _ixh_unmask_ct. Leaf.",
      block: { mov rax, [rip + _ixh_unmask_ct]; ret }
    }

  pub let iris_xe_hotplug_isr_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): single-load getter for _ixh_isr_ct. Leaf.",
      block: { mov rax, [rip + _ixh_isr_ct]; ret }
    }

  // Per-port vector lookup (0 iff port not registered).
  pub let iris_xe_hotplug_port_vector : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): read per-port vector slot. Returns 0 if port > 4 OR registered == 0. Pure leaf. Labels prefixed ixh_pv_.",
      block: {
        cmp rdi, 4;
        ja  ixh_pv_bad;
        lea r10, [rip + _ixh_port_state];
        mov rax, rdi;
        shl rax, 5;
        add r10, rax;
        mov rax, [r10 + 0];                  // registered
        cmp rax, 0;
        je  ixh_pv_bad;
        mov rax, [r10 + 8];                  // vector
        ret;
      ixh_pv_bad:
        xor rax, rax;
        ret
      }
    }

  // Per-port event_count lookup (0 iff port not registered).
  pub let iris_xe_hotplug_port_events : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): read per-port event_count slot. Returns 0 if port > 4 OR registered == 0. Pure leaf. Labels prefixed ixh_pe_.",
      block: {
        cmp rdi, 4;
        ja  ixh_pe_bad;
        lea r10, [rip + _ixh_port_state];
        mov rax, rdi;
        shl rax, 5;
        add r10, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ixh_pe_bad;
        mov rax, [r10 + 24];
        ret;
      ixh_pe_bad:
        xor rax, rax;
        ret
      }
    }

  // Per-port registered probe (1 iff port registered).
  pub let iris_xe_hotplug_port_live : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 75 G4 (paideia-os#2541): 1 iff port <= 4 AND registered slot != 0. Pure leaf. Labels prefixed ixh_pl_.",
      block: {
        cmp rdi, 4;
        ja  ixh_pl_no;
        lea r10, [rip + _ixh_port_state];
        mov rax, rdi;
        shl rax, 5;
        add r10, rax;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ixh_pl_no;
        mov rax, 1;
        ret;
      ixh_pl_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // §R  cap_handler_hotplug(rights, target_ptr, op_arg) -> u64
  //
  // KIND_HOTPLUG_DRV cap_invoke dispatch handler.  Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x41; je
  // call_kind_hotplug_drv` arm added alongside this file.
  //
  // The handler is QUERY-ONLY at Wave 75 G4 -- the mutating
  // primitives (register_port, mask, unmask, isr) ride supervisor
  // callers above the generic cap_invoke syscall ABI.
  //
  //     op 0 IXH_OP_QUERY_VECTOR -> port's bound ISR vector
  //     op 1 IXH_OP_QUERY_LIVE   -> 1 iff port registered
  //     op 2 IXH_OP_QUERY_EVENTS -> port's event-count tally
  //     else                      -> INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_IXH_READ.  target_ptr IS the
  // port id (0..4), masked to its low byte on entry.
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg.
  // Stack recipe: 3-push callee-save (rbx=rights, r12=port, r13=op_code).
  // ==========================================================================
  pub let cap_handler_hotplug : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 75 G4 (paideia-os#2541): KIND_HOTPLUG_DRV cap_invoke dispatch. Entry chatter (klog_s1 of ixh_tag_handler_entry) with the three incoming regs preserved in callee-save slots. op_code = op_arg & 0xFF; rights gate against R_IXH_READ; dispatch 0..2 to the matching accessor; else INVOKE_UNSUPPORTED. target_ptr IS the port id (8-bit mask applied as a defensive bound for a future layout widening). Three callee-save pushes (rbx=rights, r12=port_id, r13=op_code) land rsp%16==0 at every nested call. Labels prefixed ixh_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rights
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                        // port_id = target_ptr[7:0]
        mov r13, rdx;                        // op_arg
        and r13, r10;                        // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ixh_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                      // R_IXH_READ
        cmp r10, 0;
        je  ixh_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  ixh_hd_op_vector;
        cmp r13, 1;
        je  ixh_hd_op_live;
        cmp r13, 2;
        je  ixh_hd_op_events;
        jmp ixh_hd_unsup;

      ixh_hd_op_vector:
        mov rdi, r12;
        call iris_xe_hotplug_port_vector;
        jmp ixh_hd_out;

      ixh_hd_op_live:
        mov rdi, r12;
        call iris_xe_hotplug_port_live;
        jmp ixh_hd_out;

      ixh_hd_op_events:
        mov rdi, r12;
        call iris_xe_hotplug_port_events;
        jmp ixh_hd_out;

      ixh_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        jmp ixh_hd_out;
      ixh_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED

      ixh_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §S  Boot wiring note
  // ----------------
  // kernel_main.pdx picks up `iris_xe_hotplug_reset` alongside the
  // existing drivers' reset calls at the follow-up slice:
  //
  //   call iris_xe_hotplug_reset;    // defensive zero of port state
  //
  // Zero-arg, allocates nothing on the stack, touches rax/rcx/r10
  // only; safe alongside kernel_main's live r12/r13/r14 handoff
  // registers.  The wiring itself is deferred to a follow-up slice
  // (same discipline every other `*_table_reset` boot wiring
  // follows -- firmware_blob_table_reset was declared in Wave 73
  // and wired a slice later).  At real boot .bss zero-init leaves
  // the table empty and `inited` zero, so register_port / mask /
  // unmask / isr correctly refuse until iris_xe_hotplug_init is
  // called; the KIND_HOTPLUG_DRV dispatch arm is pure plumbing and
  // self-standing.
  // ==========================================================================
}
