// src/kernel/core/drivers/dpy/iris_xe_page_flip.pdx -- R104.M4-004 (#2183)
//
// Iris Xe backend page-flip driver.
//
// Signature: iris_xe_backend_page_flip(pgfl_row_id, target_fb_slot) -> u64
//
// Called by graphics/backend_dispatch.pdx :: backend_page_flip when
// _active_backend_kind == DPYB_KIND_IRIS_XE (4). Body:
//
//   (1) T14 gate. If _t14_g4_present == 0, this function is a no-op
//       returning 0 -- an Iris Xe backend without T14 iGPU is a
//       misconfiguration but should not panic; the sim-vblank path
//       still drives the KIND_DISPLAY_TIMELINE and the caller sees a
//       clean 0-return.
//
//   (2) Resolve the flip row's OUTPUT via pgfl_row_output (returns
//       cap_table slot). This is the display-output cap the flip cap
//       was minted against. The output cap's row records the ENGINE
//       cap slot, which in turn carries the MMIO BAR the SURF_LIVE
//       register write must target.
//
//   (3) SURF_LIVE MMIO write. Per Intel bspec §14, the primary plane's
//       scan-out surface address is programmed via SURF register at
//       offset PIPE_A_SURFLIVE = 0x7019C (pipe A; pipes B/C at
//       +0x1000/+0x2000 -- deferred to multi-pipe follow-on). Writing
//       to SURF_LIVE arms the address latch; hardware latches the new
//       address at the NEXT vblank, giving atomic-w.r.t.-vblank
//       flip semantics without software intervention.
//
//       The BAR0 address is stashed in the KIND_DISPLAY_BACKEND's
//       mmio_base tail field at offset +16 (see cap/kind_display_
//       backend.pdx §SECTION 1). Because the mint at R104.M1-003 today
//       populates mmio_base = 0 (live-MMIO binding is a follow-on --
//       see iris_xe_boot.pdx §0), this landing takes an honest arm:
//       it resolves mmio_base, verifies non-zero, then either writes
//       the register (real T14 with live binding) or short-circuits
//       (bmio_base still 0). The fingerprint from the composed caller
//       remains the assertable signal.
//
// ============================================================================
// SECTION 1  WHY THIS FILE DOES NOT DRIVE SEQ_COMPLETED
// ============================================================================
//
// The vblank ISR in iris_xe_vblank_isr.pdx drives dpy_timeline_vblank
// _signal, which drives dpt_row_signal. The KIND_PAGE_FLIP's seq_
// completed is bumped by pgfl_deliver_vblank, called from that same
// ISR path. Layering: the ISR is the ONE writer of the completion
// side; this file is the ONE writer of the submit-side MMIO. Keeping
// them separate means a flip whose SURF_LIVE write completed but
// whose vblank did not yet fire is correctly modeled as "submitted
// but not completed" -- exactly the state pgfl_query returns 0 for.
//
// ============================================================================
// SECTION 2  ENCODER + LABELS
// ============================================================================
//
// Frame prologue implicit. No `test`, no `add reg, [mem]`, no `cmp
// reg, [mem]`. Labels prefixed `ixewa_pf_`.

module IrisXePageFlip = structure {

  // Iris Xe pipe A SURF register offset (bspec §14). Widens to
  // per-pipe (+0x1000 * pipe_idx) once multi-pipe iteration lands.
  pub let IXP_REG_PIPE_A_SURFLIVE : u64 = 0x7019C

  // ==========================================================================
  // iris_xe_backend_page_flip(pgfl_row_id, target_fb_slot) -> u64
  //
  // Register plan: r12=pgfl_row_id, r13=target_fb_slot, rbx=mmio_base.
  // Three callee-save pushes + sub rsp,8: entry rsp%16==8, +24+8=32,
  //   rsp%16==0 for nested-call boundary.
  // Labels prefixed ixewa_pf_.
  // ==========================================================================
  pub let iris_xe_backend_page_flip : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (pgfl_row_id: u64) (target_fb_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R104.M4-004 (#2183): T14-gated SURF_LIVE MMIO write for Iris Xe page flip. Returns 0 on QEMU (no T14 hardware) or when mmio_base is unbound; returns 0 on success on T14 with live binding. Labels prefixed ixewa_pf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                    // pgfl_row_id
        mov r13, rsi;                    // target_fb_slot

        // T14 gate.
        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  ixewa_pf_out_zero;

        // Look up the backend cap's mmio_base. At R104 the tie-in path
        // from a page-flip row to its engine's BAR passes through the
        // KIND_DISPLAY_BACKEND row minted at R104.M1-003 (backend
        // dispatch reaches the ONLY-live-backend via _active_backend
        // _kind; there's exactly one KIND_DISPLAY_BACKEND row live at a
        // time until compositor-driven multi-backend arrives). Row 0 of
        // _dpyb_table carries the IRIS_XE row when it is live.
        //
        // Because kind_display_backend.pdx does not export a public
        // accessor for `mmio_base at row 0`, and R104.M1-003 populates
        // that field with 0 today (live-MMIO binding is a follow-on),
        // the honest branch is: read via a straight table walk that
        // returns 0 if the field is 0, and short-circuit.
        lea rax, [rip + _dpyb_table];
        mov rbx, [rax + 16];             // _dpyb_table[0].mmio_base @+16
        cmp rbx, 0;
        je  ixewa_pf_out_zero;

        // Live path: write SURF_LIVE. The address written is the
        // scan-out PA. In this landing we do not have a resolved
        // per-fb-slot PA to hand the MMIO write; the KIND_FRAMEBUFFER
        // row's lfb_pa field carries it, but the accessor is not
        // exported from kind_framebuffer.pdx today. Emit the MMIO
        // write against the target_fb_slot value itself as a placeholder
        // -- a future landing routes fb_slot -> lfb_pa via a
        // fb_row_lfb_pa accessor and writes the resolved PA here.
        // The register write shape is proven; the value is a placeholder.
        //
        // MMIO writes to Iris Xe display registers are 32-bit per bspec
        // §14 (any wider access is undefined). mov_d for the sized store.
        mov rax, rbx;
        mov r10, 0x7019C;                // IXP_REG_PIPE_A_SURFLIVE
        add rax, r10;
        mov rcx, r13;
        mov_d [rax + 0], rcx;

        // Success. seq_completed is bumped by the vblank ISR when it
        // fires, not here.
        xor rax, rax;
        jmp ixewa_pf_out;

      ixewa_pf_out_zero:
        xor rax, rax;

      ixewa_pf_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
