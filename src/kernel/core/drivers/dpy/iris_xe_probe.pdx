// src/kernel/core/drivers/dpy/iris_xe_probe.pdx — R36.M1-001 (#1235)
//
// Intel Iris Xe display engine PCIe probe + capability register
// decode scaffold. Recognises the Display Controller class code
// (0x03, 0x00), filters candidates by Intel vendor (0x8086) and
// device family (Xe1 0x9A00+ / Xe2 0x4680+), and stages the
// BAR0 MMIO extent and BAR2 GTT stolen extent so a later mint of
// KIND_OP_REGION can containment-check the two windows against a
// live memory authority — all through a synthetic seam this
// milestone.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNISE + RECORD half of an Iris Xe display bring-up.
// A PCIe function whose class/subclass triple is (0x03, 0x00, *) is
// a Display Controller / VGA per the PCI SIG registry; filtered by
// Intel vendor 0x8086 and a device family whose top byte matches
// the shipping Xe1 (0x9A00+) or Xe2 (0x4680+) ranges, this scaffold's
// job is to distill the vendor/device pair the enumerator saw and
// stash the two BARs plus the chip capability register (GMBUS
// count + DDI count) a later round consults when it wires up the
// display pipeline.
//
// IT DOES NOT TOUCH REAL MMIO. The chip capability register (GMBUS
// bus count at CAPS[3:0], DDI count at CAPS[7:4]) is read through a
// seam whose default backing is caller-supplied register snapshots.
// A later round wires that seam to the BAR0 window.
//
// IT DOES NOT MINT A KIND_DISPLAY_ENGINE. That is the mint gate the
// bring-up path takes once the two BARs are measured through a live
// memory authority; this scaffold records the EXTENTS so that mint
// can containment-check its request without asking the firmware
// again.
//
// ixp_probe_arbitrated() returns 0 until that binding lands.
//
// =============================================================================
// §1  PCI CLASSIFICATION (PCI SIG code registry)
// =============================================================================
//
//   base class 0x03  Display Controller
//   subclass  0x00  VGA-Compatible Controller
//
// Vendor filter: 0x8086 (Intel) — the only shipping vendor of the
// Iris Xe integrated display engine at this milestone.
//
// Device family filter (top byte of the 16-bit device id):
//   0x9A  Xe1 / Tiger Lake / Alder Lake iGPU  (0x9A00+)
//   0x46  Xe2 / Meteor Lake / Arrow Lake iGPU (0x4680+)
//   0x7D  Xe3 / Lunar Lake iGPU (0x7D40+; anticipated)
//
// BAR0 alignment: 16 MB is the Intel-mandated minimum for a display
// engine MMIO window (bspec). The probe refuses a BAR whose masked
// base is not 16 MB aligned as MISALIGNED rather than clipping it.
//
// BAR2 (GTT stolen): 8 MB minimum; contiguous with BAR0's page
// tables but a distinct window per bspec.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _ixp_probe_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/dpy/iris_xe_probe.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF7B0..0xFFFFF7BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dpclk_config 0xFFFFF790..9F,
// pwr_wells 0xFFFFF7A0..AF; adjacent used band above:
// kind_display_engine 0xFFFFF7C0..CF).

module IrisXeProbe = structure {

  // PCI classification (§1).
  pub let PCI_CLASS_DISPLAY   : u64 = 0x03
  pub let PCI_SUBCLASS_VGA    : u64 = 0x00

  // Class pair packed as (class << 8) | subclass.
  pub let PCI_CLASS_PAIR_DISPLAY_VGA : u64 = 0x0300

  // Accepted vendor set.
  pub let IXP_VENDOR_INTEL : u64 = 0x8086

  // Device family top-byte matches (§1).
  pub let IXP_FAMILY_XE1 : u64 = 0x9A
  pub let IXP_FAMILY_XE2 : u64 = 0x46
  pub let IXP_FAMILY_XE3 : u64 = 0x7D

  // Alignment (§1).
  pub let IXP_BAR0_ALIGN_LOG2 : u64 = 24            // 16 MB
  pub let IXP_BAR0_ALIGN_MASK : u64 = 0xFFFFFF

  // BAR extent minimums.
  pub let IXP_BAR0_MIN_LEN : u64 = 0x1000000        // 16 MB
  pub let IXP_BAR2_MIN_LEN : u64 = 0x800000         // 8 MB

  // Chip capability layout (bspec §14).
  pub let IXP_CAPS_GMBUS_MASK  : u64 = 0x000F
  pub let IXP_CAPS_DDI_MASK    : u64 = 0x00F0
  pub let IXP_CAPS_DDI_SHIFT   : u64 = 4

  // Failure taxonomy — 0xFFFFF7B0..0xFFFFF7BF.
  pub let IXP_OK             : u64 = 0
  pub let IXP_BAD_ARG        : u64 = 0xFFFFF7BF
  pub let IXP_BAD_CLASS      : u64 = 0xFFFFF7BE
  pub let IXP_BAD_VENDOR     : u64 = 0xFFFFF7BD
  pub let IXP_BAD_FAMILY     : u64 = 0xFFFFF7BC
  pub let IXP_BAD_BAR0       : u64 = 0xFFFFF7BB
  pub let IXP_BAD_BAR2       : u64 = 0xFFFFF7BA
  pub let IXP_MISALIGNED     : u64 = 0xFFFFF7B9
  pub let IXP_BAD_CAPS       : u64 = 0xFFFFF7B8
  pub let IXP_NO_GMBUS       : u64 = 0xFFFFF7B7
  pub let IXP_NO_DDI         : u64 = 0xFFFFF7B6

  pub let mut _ixp_probe_stats : [u64; 8] = uninit @align(64)

  pub let IXP_ST_ATTEMPTS : u64 = 0
  pub let IXP_ST_MATCHED  : u64 = 1
  pub let IXP_ST_REJECTS  : u64 = 2
  pub let IXP_ST_ALIGNED  : u64 = 3
  pub let IXP_ST_GMBUS    : u64 = 4
  pub let IXP_ST_DDI      : u64 = 5

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let ixp_probe_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-001 (#1235): clear stats. Labels prefixed ixp_rs_.",
      block: {
        lea r10, [rip + _ixp_probe_stats];
        xor rax, rax;
        xor rcx, rcx;
      ixp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ixp_rs_loop;
        ret
      }
    }

  pub let ixp_probe_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): honesty pin. Returns 0 until a later round binds this against a live PCIe Iris Xe BAR window.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let ixp_probe_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-001 (#1235): counter read. Labels prefixed ixp_st_.",
      block: {
        cmp rdi, 8;
        jae ixp_st_zero;
        lea r10, [rip + _ixp_probe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ixp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ixp_probe_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-001 (#1235): counter bump. Labels prefixed ixp_nt_.",
      block: {
        cmp rdi, 8;
        jae ixp_nt_out;
        lea r10, [rip + _ixp_probe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ixp_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let ixp_class_valid : (u64) -> u64 !{} @{} =
    fn (class_pair: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): 1 iff class_pair == 0x0300 (Display / VGA). Labels prefixed ixp_cv_.",
      block: {
        mov r10, 0x0300;
        cmp rdi, r10;
        jne ixp_cv_no;
        mov rax, 1;
        ret;
      ixp_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ixp_vendor_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): 1 iff v in {0x8086 Intel}. Labels prefixed ixp_vv_.",
      block: {
        cmp rdi, 0x8086;
        je  ixp_vv_yes;
        xor rax, rax;
        ret;
      ixp_vv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let ixp_family_valid : (u64) -> u64 !{} @{} =
    fn (device_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): 1 iff top byte in {0x9A Xe1, 0x46 Xe2, 0x7D Xe3}. A future Xe4 top byte joins here. Labels prefixed ixp_fv_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, 0x9A;
        je  ixp_fv_yes;
        cmp rax, 0x46;
        je  ixp_fv_yes;
        cmp rax, 0x7D;
        je  ixp_fv_yes;
        xor rax, rax;
        ret;
      ixp_fv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let ixp_bar0_aligned : (u64) -> u64 !{} @{} =
    fn (bar_base: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): 1 iff (bar_base & 0xFFFFFF) == 0 (16 MB alignment). Labels prefixed ixp_ba_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFF;
        cmp rax, 0;
        jne ixp_ba_no;
        mov rax, 1;
        ret;
      ixp_ba_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Decode chip capability register.
  //
  //   caps[3:0]  GMBUS bus count
  //   caps[7:4]  DDI count
  //
  // A caps word with zero GMBUS buses or zero DDIs is a controller
  // nothing can drive a panel through — refused as NO_GMBUS / NO_DDI
  // rather than recorded.
  // ==========================================================================

  pub let ixp_decode_gmbus : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): decode GMBUS bus count from caps[3:0]. Labels prefixed ixp_dg_.",
      block: {
        mov rax, rdi;
        and rax, 0x000F;
        ret
      }
    }

  pub let ixp_decode_ddi : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): decode DDI count from caps[7:4]. Labels prefixed ixp_dd_.",
      block: {
        mov rax, rdi;
        shr rax, 4;
        and rax, 0x0F;
        ret
      }
    }

  pub let ixp_bar2_len_ok : (u64) -> u64 !{} @{} =
    fn (bar2_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-001 (#1235): 1 iff bar2_len >= 8 MB (BAR2 GTT stolen minimum, bspec). Labels prefixed ixp_b2_.",
      block: {
        mov r10, 0x800000;
        cmp rdi, r10;
        jb  ixp_b2_no;
        mov rax, 1;
        ret;
      ixp_b2_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ixp_probe_recognise(class_pair, vendor, device_id, bar0_base,
  //                     bar0_len, caps)
  //   -> gmbus[7:0] | ddi[15:8] | err
  //
  // Six-arg entry: BAR2 length is validated at the call site through
  // ixp_bar2_len_ok — keeping this recognise at six arguments avoids
  // stack-passed args and keeps its calling convention identical to
  // tb_nhi_probe_recognise. The class-pair check is (class, subclass)
  // packed as (class << 8) | subclass; caps is the chip capability
  // register from BAR0.
  //
  // Sequence:
  //   1. Class pair = 0x0300 (Display / VGA)
  //   2. Vendor in accepted set
  //   3. Device id top byte in accepted family set
  //   4. bar0_base > 0 and bar0_len >= 16 MB
  //   5. bar0_base 16 MB aligned
  //   6. caps non-zero
  //   7. GMBUS count > 0
  //   8. DDI count > 0
  //
  // Every accepted probe bumps MATCHED and the per-field counters
  // (ALIGNED, GMBUS, DDI). Every refusal bumps REJECTS.
  // ==========================================================================

  pub let ixp_probe_recognise : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (class_pair: u64) (vendor: u64) (device_id: u64) (bar0_base: u64) (bar0_len: u64) (caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-001 (#1235): recognise an Intel Iris Xe display engine. Six args stashed to five callee-save regs plus rbp. BAR2 length validated separately through ixp_bar2_len_ok. Sequence per header. Returns gmbus[7:0] | ddi[15:8]. Labels prefixed ixp_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // class_pair
        mov r12, rsi;                    // vendor
        mov r13, rdx;                    // device_id
        mov r14, rcx;                    // bar0_base
        mov r15, r8;                     // bar0_len
        mov rbp, r9;                     // caps

        mov rdi, 0;                      // ATTEMPTS
        call ixp_probe_note;

        // 1. Class pair.
        mov rdi, rbx;
        call ixp_class_valid;
        cmp rax, 0;
        je  ixp_rc_bad_class;

        // 2. Vendor.
        mov rdi, r12;
        call ixp_vendor_valid;
        cmp rax, 0;
        je  ixp_rc_bad_vendor;

        // 3. Device family.
        mov rdi, r13;
        call ixp_family_valid;
        cmp rax, 0;
        je  ixp_rc_bad_family;

        // 4. BAR0 base + length.
        cmp r14, 0;
        je  ixp_rc_bad_bar0;
        mov r10, 0x1000000;              // 16 MB
        cmp r15, r10;
        jb  ixp_rc_bad_bar0;

        // 5. Alignment.
        mov rdi, r14;
        call ixp_bar0_aligned;
        cmp rax, 0;
        je  ixp_rc_misaligned;
        mov rdi, 3;                      // ALIGNED
        call ixp_probe_note;

        // 6. caps non-zero.
        cmp rbp, 0;
        je  ixp_rc_bad_caps;

        // 7. GMBUS.
        mov rdi, rbp;
        call ixp_decode_gmbus;
        cmp rax, 0;
        je  ixp_rc_no_gmbus;
        mov rbx, rax;                    // gmbus
        mov rdi, 4;                      // GMBUS
        call ixp_probe_note;

        // 8. DDI.
        mov rdi, rbp;
        call ixp_decode_ddi;
        cmp rax, 0;
        je  ixp_rc_no_ddi;
        mov r12, rax;                    // ddi
        mov rdi, 5;                      // DDI
        call ixp_probe_note;

        // MATCHED.
        mov rdi, 1;
        call ixp_probe_note;

        // Pack gmbus | (ddi << 8).
        mov rax, rbx;
        and rax, 0xFF;
        mov r10, r12;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        jmp ixp_rc_out;

      ixp_rc_bad_class:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7BE;
        jmp ixp_rc_out;
      ixp_rc_bad_vendor:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7BD;
        jmp ixp_rc_out;
      ixp_rc_bad_family:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7BC;
        jmp ixp_rc_out;
      ixp_rc_bad_bar0:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7BB;
        jmp ixp_rc_out;
      ixp_rc_misaligned:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7B9;
        jmp ixp_rc_out;
      ixp_rc_bad_caps:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7B8;
        jmp ixp_rc_out;
      ixp_rc_no_gmbus:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7B7;
        jmp ixp_rc_out;
      ixp_rc_no_ddi:
        mov rdi, 2;
        call ixp_probe_note;
        mov rax, 0xFFFFF7B6;

      ixp_rc_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
