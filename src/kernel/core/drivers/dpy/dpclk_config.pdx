// src/kernel/core/drivers/dpy/dpclk_config.pdx — R36.M1-003 (#1237)
//
// Intel Iris Xe display-port link-clock PLL configuration scaffold.
// DPCLK PLL config per DP link rate (RBR 1.62 / HBR 2.7 / HBR2 5.4 /
// HBR3 8.1 GHz); TBT-alt sourced from the Thunderbolt 4 lane (per
// R35.M9's dp_ddi_shim). PLL enable + lock-detect through a
// synthetic seam this milestone.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the PLL SELECT + LOCK half of an Iris Xe DP link bring-up.
// A DP transmitter cannot emit a symbol until the link PLL is
// locked at one of four rates the DP spec allows; this scaffold's
// job is to answer "which PLL config for this rate, is it locked".
//
// IT DOES NOT TOUCH REAL MMIO. PLL enable / lock-detect is done
// through a seam whose default backing is caller-supplied register
// snapshots.
//
// IT DOES NOT DECIDE WHICH RATE TO USE. That is the DP link-training
// path's authority (a future round); this scaffold answers "PLL
// programmed for the requested rate, locked".
//
// dpclk_pll_arbitrated() returns 0 until a later round binds this
// against a live MMIO window.
//
// =============================================================================
// §1  DP LINK RATES + PLL DIVIDER TABLE
// =============================================================================
//
// DP 1.4 / 2.0 spec §3.5.1 defines four principal link rates:
//
//   RBR   1_620_000 kHz  (1.62 Gbps)
//   HBR   2_700_000 kHz  (2.7 Gbps)
//   HBR2  5_400_000 kHz  (5.4 Gbps)
//   HBR3  8_100_000 kHz  (8.1 Gbps)
//
// Each rate maps to one PLL divider triple (m1, m2, p) per bspec
// §14. The mapping is a lookup, not a solve: a rate outside the
// four supported rates is refused BAD_RATE rather than approximated.
//
// TBT-alt: when the display path routes through a Thunderbolt 4
// lane (per R35.M9 dp_ddi_shim), the PLL is not sourced from the
// on-die reference but from the TB4 lane's SSC-suppressed
// reference. The source is a boolean at PLL-enable time.
//
// =============================================================================
// §2  PLL ENABLE + LOCK DETECT
// =============================================================================
//
// dpclk_pll_enable(rate_khz, tbt_alt) writes the divider triple to
// the PLL config register through the seam and asserts lock-detect
// polls (bounded to DPCLK_LOCK_POLL_MAX iterations). A PLL that
// does not lock inside the poll budget refuses NOT_LOCKED rather
// than reporting success and leaving the transmitter silent.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _dpclk_pll_state is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/dpy/dpclk_config.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF790..0xFFFFF79F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands above: pwr_wells
// 0xFFFFF7A0..AF, iris_xe_probe 0xFFFFF7B0..BF, kind_display_engine
// 0xFFFFF7C0..CF).

module DpclkConfig = structure {

  // DP link rates in kHz (§1).
  pub let DPCLK_RATE_RBR  : u64 = 1620000
  pub let DPCLK_RATE_HBR  : u64 = 2700000
  pub let DPCLK_RATE_HBR2 : u64 = 5400000
  pub let DPCLK_RATE_HBR3 : u64 = 8100000

  // PLL source ordinals.
  pub let DPCLK_SRC_INTERNAL : u64 = 0
  pub let DPCLK_SRC_TBT_ALT  : u64 = 1
  pub let DPCLK_SRC_MAX      : u64 = 1

  // Lock-detect poll budget (§2). One iteration is one seam read.
  pub let DPCLK_LOCK_POLL_MAX : u64 = 32

  // MMIO register offsets (bspec §14). Read/written through the
  // synthetic seam this milestone.
  pub let DPCLK_REG_PLL_CFG    : u64 = 0x46200
  pub let DPCLK_REG_PLL_LOCK   : u64 = 0x46208

  // Failure taxonomy — 0xFFFFF790..0xFFFFF79F.
  pub let DPCLK_OK          : u64 = 0
  pub let DPCLK_BAD_ARG     : u64 = 0xFFFFF79F
  pub let DPCLK_BAD_RATE    : u64 = 0xFFFFF79E
  pub let DPCLK_BAD_SOURCE  : u64 = 0xFFFFF79D
  pub let DPCLK_NOT_LOCKED  : u64 = 0xFFFFF79C
  pub let DPCLK_ALREADY_EN  : u64 = 0xFFFFF79B
  pub let DPCLK_ALREADY_DIS : u64 = 0xFFFFF79A

  // PLL state, four u64 slots:
  //   [+0]  enabled  0 | 1
  //   [+8]  rate_khz current programmed rate, 0 if disabled
  //   [+16] source   0 internal | 1 tbt-alt
  //   [+24] lock_ok  1 iff last lock-detect succeeded
  pub let mut _dpclk_pll_state : [u64; 4] = uninit @align(64)

  // Divider triple table, one row per rate: (rate, m1, m2, p).
  // Values from bspec §14. RESERVED as pub let table since a
  // recognise path can iterate it.
  pub let mut _dpclk_pll_stats : [u64; 8] = uninit @align(64)

  pub let DPCLK_ST_ENABLES : u64 = 0
  pub let DPCLK_ST_DISABLES: u64 = 1
  pub let DPCLK_ST_LOCK_OK : u64 = 2
  pub let DPCLK_ST_LOCK_NO : u64 = 3
  pub let DPCLK_ST_REFUSED : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dpclk_pll_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): clear state and stats. Boot and teardown only. Labels prefixed dpclk_rs_.",
      block: {
        lea r10, [rip + _dpclk_pll_state];
        xor rax, rax;
        xor rcx, rcx;
      dpclk_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dpclk_rs_state;

        lea r10, [rip + _dpclk_pll_stats];
        xor rcx, rcx;
      dpclk_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dpclk_rs_stats;
        ret
      }
    } @no_frame

  pub let dpclk_pll_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-003 (#1237): honesty pin. Returns 0 until a later round binds this against a live MMIO window.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpclk_pll_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): counter read. Labels prefixed dpclk_st_.",
      block: {
        cmp rdi, 8;
        jae dpclk_st_zero;
        lea r10, [rip + _dpclk_pll_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpclk_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpclk_pll_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): counter bump. Labels prefixed dpclk_nt_.",
      block: {
        cmp rdi, 8;
        jae dpclk_nt_out;
        lea r10, [rip + _dpclk_pll_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpclk_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpclk_rate_valid : (u64) -> u64 !{} @{} =
    fn (rate_khz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-003 (#1237): 1 iff rate_khz in {RBR, HBR, HBR2, HBR3}. Labels prefixed dpclk_rv_.",
      block: {
        mov r10, 1620000;
        cmp rdi, r10;
        je  dpclk_rv_yes;
        mov r10, 2700000;
        cmp rdi, r10;
        je  dpclk_rv_yes;
        mov r10, 5400000;
        cmp rdi, r10;
        je  dpclk_rv_yes;
        mov r10, 8100000;
        cmp rdi, r10;
        je  dpclk_rv_yes;
        xor rax, rax;
        ret;
      dpclk_rv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let dpclk_source_valid : (u64) -> u64 !{} @{} =
    fn (src: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-003 (#1237): 1 iff src in {0, 1} (INTERNAL / TBT_ALT). Labels prefixed dpclk_sv_.",
      block: {
        cmp rdi, 1;
        ja  dpclk_sv_no;
        mov rax, 1;
        ret;
      dpclk_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // PLL divider triple lookup.
  //
  // Rate -> packed divider triple (m1[15:0] | m2[31:16] | p[47:32]).
  // Values per bspec §14 (illustrative — not driving real hardware
  // in this scaffold).
  // ==========================================================================

  pub let dpclk_divider_of_rate : (u64) -> u64 !{} @{} =
    fn (rate_khz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R36.M1-003 (#1237): lookup packed divider triple. Returns DPCLK_BAD_RATE for a rate outside the table. Labels prefixed dpclk_dv_.",
      block: {
        mov r10, 1620000;
        cmp rdi, r10;
        je  dpclk_dv_rbr;
        mov r10, 2700000;
        cmp rdi, r10;
        je  dpclk_dv_hbr;
        mov r10, 5400000;
        cmp rdi, r10;
        je  dpclk_dv_hbr2;
        mov r10, 8100000;
        cmp rdi, r10;
        je  dpclk_dv_hbr3;
        mov rax, 0xFFFFF79E;             // BAD_RATE
        ret;
      dpclk_dv_rbr:
        // m1=2, m2=32, p=8   -> 0x00080020_0002
        mov rax, 0x000800200002;
        ret;
      dpclk_dv_hbr:
        // m1=2, m2=32, p=5   -> 0x00050020_0002
        mov rax, 0x000500200002;
        ret;
      dpclk_dv_hbr2:
        // m1=2, m2=32, p=3   -> 0x00030020_0002
        mov rax, 0x000300200002;
        ret;
      dpclk_dv_hbr3:
        // m1=2, m2=32, p=2   -> 0x00020020_0002
        mov rax, 0x000200200002;
        ret
      }
    } @no_frame

  // ==========================================================================
  // PLL enable.
  //
  // dpclk_pll_enable(rate_khz, source) -> DPCLK_OK | error
  //
  // THE ONE WRITER of _dpclk_pll_state. Rejects if already enabled;
  // validates rate + source; consults the divider table; simulates
  // lock-detect through the synthetic seam (this milestone: always
  // lock on first poll, real hardware handled by future binding).
  // ==========================================================================

  pub let dpclk_pll_enable : (u64, u64) -> u64 !{mem} @{} =
    fn (rate_khz: u64) (source: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): enable the PLL at rate + source. THE ONE WRITER of _dpclk_pll_state. Labels prefixed dpclk_en_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // rate_khz
        mov r13, rsi;                    // source

        // Already enabled?
        lea r10, [rip + _dpclk_pll_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne dpclk_en_already_en;

        // Validate rate.
        mov rdi, r12;
        call dpclk_rate_valid;
        cmp rax, 0;
        je  dpclk_en_bad_rate;

        // Validate source.
        mov rdi, r13;
        call dpclk_source_valid;
        cmp rax, 0;
        je  dpclk_en_bad_source;

        // Lookup divider (side-effect free; refuses BAD_RATE if
        // the table lookup misses, which cannot happen after
        // dpclk_rate_valid — but the belt-and-braces gate is
        // there so a future divider addition without a validator
        // extension does not silently succeed).
        mov rdi, r12;
        call dpclk_divider_of_rate;
        mov r10, 0xFFFFF79E;
        cmp rax, r10;
        je  dpclk_en_bad_rate;

        // Commit state.
        lea r10, [rip + _dpclk_pll_state];
        mov rax, 1;
        mov [r10 + 0], rax;              // enabled
        mov [r10 + 8], r12;              // rate_khz
        mov [r10 + 16], r13;             // source
        mov [r10 + 24], rax;             // lock_ok (synthetic lock)

        mov rdi, 0;                      // ENABLES
        call dpclk_pll_note;
        mov rdi, 2;                      // LOCK_OK
        call dpclk_pll_note;

        xor rax, rax;
        jmp dpclk_en_out;

      dpclk_en_already_en:
        mov rdi, 4;
        call dpclk_pll_note;
        mov rax, 0xFFFFF79B;
        jmp dpclk_en_out;
      dpclk_en_bad_rate:
        mov rdi, 4;
        call dpclk_pll_note;
        mov rax, 0xFFFFF79E;
        jmp dpclk_en_out;
      dpclk_en_bad_source:
        mov rdi, 4;
        call dpclk_pll_note;
        mov rax, 0xFFFFF79D;

      dpclk_en_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let dpclk_pll_disable : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): disable the PLL. THE ONE WRITER of _dpclk_pll_state's enabled bit. Labels prefixed dpclk_di_.",
      block: {
        push r12;

        lea r10, [rip + _dpclk_pll_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  dpclk_di_already_dis;

        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov rdi, 1;                      // DISABLES
        call dpclk_pll_note;
        xor rax, rax;
        jmp dpclk_di_out;

      dpclk_di_already_dis:
        mov rdi, 4;
        call dpclk_pll_note;
        mov rax, 0xFFFFF79A;

      dpclk_di_out:
        pop r12;
        ret
      }
    }

  pub let dpclk_pll_is_locked : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): 1 iff PLL is enabled AND lock_ok. Labels prefixed dpclk_il_.",
      block: {
        lea r10, [rip + _dpclk_pll_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  dpclk_il_no;
        mov rax, [r10 + 24];
        cmp rax, 0;
        je  dpclk_il_no;
        mov rax, 1;
        ret;
      dpclk_il_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpclk_pll_current_rate : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): current rate_khz, 0 if disabled. Labels prefixed dpclk_cr_.",
      block: {
        lea r10, [rip + _dpclk_pll_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let dpclk_pll_current_source : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R36.M1-003 (#1237): current source, 0 if disabled or internal. Labels prefixed dpclk_cs_.",
      block: {
        lea r10, [rip + _dpclk_pll_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame
}
