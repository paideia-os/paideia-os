// src/kernel/core/drivers/dpy/direct_scanout.pdx -- Wave 59 G8 [R37] (#2545)
//
// Intel Iris Xe zero-copy direct-scanout bind-up SKELETON for Wave 59
// G8. When a fullscreen client already owns a Buffer Object that
// covers the pipe's active area exactly (same stride, same mode
// width/height, admitted ARGB format, GTT-bound), the Iris Xe display
// engine can SCAN DIRECTLY out of that BO's physical memory -- the
// compositor-side blit from client BO to compositor BO is bypassed
// entirely. The latency win is one frame plus whatever the blit
// would cost; the bandwidth win is one full-frame copy per refresh.
//
// This file sits beside iris_xe_modeset.pdx (Wave 71 G2, #2539) which
// brought pipe A up to native panel timing + plane-1 scanout against
// a COMPOSITOR-held BO; direct-scanout is the alternate PRIMARY plane
// binding where the compositor instead stamps PLANE_SURF with the
// CLIENT's BO. It is also distinct from plane_primary.pdx (R36.M4-
// 002, 484 LOC) which holds the cap/kind plane-lattice primary-role
// class on top of KIND_DISPLAY_PLANE -- that file DECIDES which
// memory row a primary plane is reading from and in what format;
// THIS file is the register-level programming layer that WRITES
// PLANE_SURF / PLANE_STRIDE / PLANE_SIZE / PLANE_CTL / PLANE_POS to
// make the pipe actually scan out of client memory.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// Posture: EVERY body here is a STUB per the Wave 59 G8 skeleton
// directive. The register offsets, format constants, pipe stride,
// and error taxonomy are FROZEN at this skeleton stage so a follow-
// up slice can land the real MMIO bodies against the same ABI and
// constants without churn. The static per-pipe state, the finger-
// print tags, and the counter bumps are real; no live MMIO is
// written yet (QEMU: no Iris Xe BAR0; T14 G4: BAR0 is wired by
// R104.M1-003 but consumed only by iris_xe_modeset today).
//
// On the Wave 59 G8 skeleton, every entrypoint:
//   (1) range-checks pipe in {0,1,2} and refuses with
//       DS_ERR_UNKNOWN_PIPE (0xFFFFFE2F) otherwise;
//   (2) consults the G6 (KIND_GPU_BO_DRV, #2543) row accessors
//       (gpu_bo_row_mapped_in / gpu_bo_row_size_pages) for the
//       eligibility gate;
//   (3) records the request into the per-pipe state block;
//   (4) bumps the per-op counter so an operator can see the entry
//       on a boot-witness programme;
//   (5) emits a fingerprint so eligibility / arm / release events
//       show up on the klog wire.
//
// =============================================================================
// SECTION 1  REGISTER MAP (Intel Iris Xe / Alder-Lake / Raptor-Lake)
// =============================================================================
//
// Source: Intel bspec "Register Reference -> Display Registers -> ADL
// -> Pipe/Plane 1 (PRIMARY)". Each PRIMARY plane register sits at a
// 0x1000 pipe stride (A at 0x70000, B at 0x71000, C at 0x72000 base).
// Each PLANE_* register's offset INSIDE its pipe band is:
//
//   PLANE_CTL     +0x180   -- plane control: bit 31 ENABLE,
//                             bits 29:24 SOURCE_FORMAT,
//                             bits 11:10 TILED_SURFACE (00 LINEAR,
//                             01 X-tiled, 10 Y-tiled legacy, 11 Yf)
//   PLANE_STRIDE  +0x188   -- plane line stride in bytes
//   PLANE_POS     +0x18C   -- plane position: xpos | (ypos << 16)
//   PLANE_SIZE    +0x190   -- plane size:  (width - 1) | ((height - 1) << 16)
//   PLANE_SURF    +0x19C   -- primary plane surface base (GTT offset,
//                             lower 32 bits -- the full 40-bit GTT
//                             address lives in PLANE_SURFLIVE at +0x1AC
//                             which the real body consults only during
//                             a tear-down readback)
//
// Resolving PLANE_CTL_A = 0x70180, PLANE_CTL_B = 0x71180, PLANE_CTL_C =
// 0x72180; PLANE_STRIDE_A/B/C = 0x70188/0x71188/0x72188; PLANE_POS_A/
// B/C = 0x7018C/0x7118C/0x7218C; PLANE_SIZE_A/B/C = 0x70190/0x71190/
// 0x72190; PLANE_SURF_A/B/C = 0x7019C/0x7119C/0x7219C.
//
// All accesses are 32-bit per Intel bspec §14 ("any wider or narrower
// access is undefined"). The real body in the follow-up slice uses
// mov_d (G1 sized store) for every PLANE_SURF / PLANE_STRIDE /
// PLANE_SIZE / PLANE_CTL / PLANE_POS write; this skeleton emits none
// of them.
//
// =============================================================================
// SECTION 2  PLANE_CTL FORMAT ENCODING
// =============================================================================
//
// PLANE_CTL[29:24] is the SOURCE_PIXEL_FORMAT (SPF). The ARGB-ish
// formats the Xe1 primary plane admits at skeleton level are:
//
//     0x01  -- 32bpp A8R8G8B8   (ARGB, alpha in high byte)
//     0x02  -- 32bpp A8B8G8R8   (ABGR; alpha in high byte, swizzled)
//     0x04  -- 32bpp X8R8G8B8   (XRGB, ignore-alpha)
//     0x08  -- 32bpp X8B8G8R8   (XBGR, ignore-alpha)
//
// (The full SPF table also admits YUV 4:2:2, YUV 4:2:0 planar, F16/F32
// hdr, and RGB10A2 wide-gamut encodings for the HDR/P010 paths; those
// are REFUSED by direct_scanout_eligibility below with DS_ERR_BAD_
// FORMAT at skeleton stage because the compositor-side blit path's
// color-space-conversion matrix is where any non-sRGB BO acquires its
// pipe-local calibration today, and direct scanout bypasses that path.
// A later HDR direct-scanout slice adds RGB10A2 + F16 to the admitted
// set once the compositor stamps the pipe CSC matrix directly.)
//
// PLANE_CTL[31]      PLANE_ENABLE                 -- flip high when
//                                                   the plane goes
//                                                   live
// PLANE_CTL[11:10]   TILED_SURFACE                -- 00 LINEAR
//                                                   (direct-scanout
//                                                   only admits
//                                                   LINEAR BOs at
//                                                   skeleton stage;
//                                                   X-tiled is G6
//                                                   placement
//                                                   dependent and a
//                                                   follow-up slice
//                                                   decodes it)
// PLANE_CTL[22]      ROTATE                       -- held OFF
// PLANE_CTL[21]      TRICKLE_FEED_ENABLE          -- held OFF
//
// This skeleton admits ONLY SPF 0x01 (A8R8G8B8 LINEAR). The follow-up
// adds 0x02 / 0x04 / 0x08 once the format-selector in plane_primary
// decides which one the client is handing us.
//
// =============================================================================
// SECTION 3  ELIGIBILITY RULES (fullscreen direct-scanout)
// =============================================================================
//
// A BO is direct-scanout eligible for (pipe, mode_w, mode_h) iff:
//
//   (R1) BO is GTT-bound:
//        gpu_bo_row_mapped_in(bo_cap) & GPU_BO_MAPPED_GTT (0x01).
//        A BO that is only PPGTT-mapped (bit 1) is NOT scan-outable:
//        the display engine's PLANE_SURF read goes through the Global
//        GTT exclusively.
//
//   (R2) BO size fits the frame:
//        size_pages * 4096  >=  stride * mode_h.
//        The caller derives stride from (mode_w * bytes_per_pixel +
//        align_slack) and passes it on the eligibility query -- or
//        at skeleton stage, we fold `stride = mode_w * 4` for the
//        32bpp admitted format and compare against size_pages * 4096.
//
//   (R3) Stride alignment:
//        stride is a multiple of 64 bytes. The Iris Xe plane engine
//        rejects strides not aligned to the cacheline width; a mis-
//        aligned stride produces scrambled scanout.
//
//   (R4) Format admitted:
//        At skeleton stage only A8R8G8B8 (SPF 0x01). The eligibility
//        query takes NO format arg -- it is implicitly 0x01 until a
//        follow-up extends the signature. A caller that wants to know
//        whether a different format is admitted uses a sentinel return
//        from the planned direct_scanout_eligibility_v2 (arrives with
//        the format extension slice).
//
// The eligibility entrypoint checks (R1) -> (R2) -> (R3) in that order
// and returns the first failure's code; it does NOT check (R4) at
// skeleton stage because the format argument hasn't been minted yet.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFFE2B..0xFFFFFE2F
// =============================================================================
//
// Five codes reserved for this module. The byte values 0xFFFFFE2B..2F
// are also claimed by cap/owner.pdx (CAP_OWNER_ALREADY = 0xFFFFFE2B,
// CAP_OWNER_NO_TASK = 0xFFFFFE2C, CAP_OWNER_BAD_GEN = 0xFFFFFE2D,
// CAP_OWNER_BAD_PID = 0xFFFFFE2E, CAP_OWNER_BAD_SLOT = 0xFFFFFE2F)
// for the capability ownership layer. The collision is HARMLESS by
// construction because:
//
//   (a) direct_scanout_* return values are consumed only by direct-
//       scanout callers (iris_xe_modeset's compositor coordinator and
//       user/compositor via cap_handler_direct_scanout). They never
//       reach cap/owner.pdx callers because the two cap kinds
//       (KIND_DIRECT_SCANOUT = 0x4A vs the ownership overlay) do not
//       share a dispatch arm.
//   (b) cap/owner.pdx error values are consumed only by cap-ownership
//       callers (clone/exec/exit). They never reach direct-scanout
//       callers.
//
// Same precedent as iris_xe_cursor.pdx (Wave 59 G3) at band 0xFFFFFFCB
// ..CE, which collides with iommu/domain_switch.pdx and cap/kind_op_
// region.pdx on the same byte values and is likewise harmless. Values
// here:
//
//     0xFFFFFE2B  DS_ERR_BO_NOT_GTT        -- BO is not GTT-bound
//                                             (mapped_in & 0x01 == 0)
//     0xFFFFFE2C  DS_ERR_BAD_FORMAT        -- format not in admitted
//                                             set (reserved for the
//                                             format-extension slice;
//                                             skeleton never emits)
//     0xFFFFFE2D  DS_ERR_STRIDE_MISALIGN   -- stride & 63 != 0
//     0xFFFFFE2E  DS_ERR_SIZE_TOO_SMALL    -- size_pages * 4096
//                                             < stride * mode_h
//     0xFFFFFE2F  DS_ERR_UNKNOWN_PIPE      -- pipe not in {0, 1, 2}
//
// The eligibility entrypoint returns these codes directly (not as a
// boolean); a caller that wants the simple 1/0 answer the task
// prototype promises checks `rax == DS_OK`. The arm / release
// entrypoints are stricter: they return DS_OK or a specific failure,
// not an eligibility sentinel.
//
// =============================================================================
// SECTION 5  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized stores): every u32 store in the follow-up slice uses
//      mov_d (PLANE_* are all 32-bit per bspec). This skeleton emits
//      no MMIO writes; the per-pipe state slots are u64 so plain
//      REX.W `mov` is correct.
//   G4 (full-register compares): every cmp here is on a 64-bit
//      register; no `cmp al, imm`, no `cmp eax, imm` short-form.
//   No `test rN, rN` -- equality-against-zero is `cmp rN, 0`.
//   No `and rN, imm64` -- the admitted mask (0x3F for the 64-byte
//      stride check) fits imm8; the mapped_in-&-GTT mask (0x01) fits
//      imm8; neither needs an r11 staging.
//   No two-operand `imul r, imm` -- pipe * stride is folded with
//      `shl r, 12` (DS_PIPE_STRIDE = 0x1000 = 2^12). Per-pipe state
//      offset is `pipe * 32` folded to `shl r, 5`. The size check
//      `size_pages * 4096` is `shl r, 12` and `stride * mode_h` uses
//      the `mul rN` single-operand form (writes rdx:rax).
//   64-bit immediates -- DS_PIPE_STRIDE (0x1000) is loaded via `mov
//      r64, 0x1000` (imm32 sign-extended via REX.W; proven form) and
//      used only as a stride constant, never as a mask.
//   Multiline `pub let ="..."` is forbidden by the pdx parser; every
//      tag below is a single line.
//   Module basename matches filename basename:
//      direct_scanout.pdx -> module DirectScanout.
//   Reserved labels -- every label in this file is prefixed `ds_`
//      so none collides with the ixc_/ixm_/plpr_ labels of the
//      sibling dpy drivers, and none accidentally spells `loop`,
//      `if`, or `let`.
//   klog wrapper discipline -- klog_s1_x1_d2 is minted in Wave 59
//      G8 alongside this file (klog/wrappers.pdx §klog_s1_x1_d2);
//      caller pushes [rsp+8]=vd1, [rsp+16]=kd2, [rsp+24]=vd2 right
//      before CALL. Pushing vd1 at [rsp+0] (expecting a shadow slot)
//      is the klog_s1_x1_d1/d2 caller trap that has burned 4+
//      softarchs in prior slices; this file threads vd1 at [rsp+8]
//      per the wrapper's `mov rax, [rbp + 16]` read.
//
// =============================================================================
// SECTION 6  STACK + REGISTER PLAN
// =============================================================================
//
// Three entry shapes (plus the cap handler):
//
//   direct_scanout_eligibility (bo_cap, pipe, mode_w, mode_h) -> u64
//   direct_scanout_arm         (bo_cap, pipe)                 -> u64
//   direct_scanout_release     (pipe)                         -> u64
//   cap_handler_direct_scanout (rights, target_ptr, op_arg)   -> u64
//
// All four are non-leaf (nested calls into gpu_bo_row_* / klog_*).
// All four use the modeset.pdx 3-push callee-save prologue:
//
//   push rbx; push r12; push r13;    // 3-push, 24 B
//   -- entry rsp%16 == 8; after 3 pushes rsp%16 == 0 (pre-CALL)
//
// Entries that fire klog_s1_x1_d1 (ARM) do `sub rsp, 16; mov [rsp+0],
// vd` instead of `push rax` -- plain push would land rsp%16==8 pre-
// CALL (3 callee-save pushes end at %16==0, one more push flips to
// 8) and the wrapper's `push rbp; sub rsp, 48` would then nest its
// klog_emit_core call at %16==8 (misaligned). The 16-byte reserve +
// slot-0 write keeps alignment AND threads vd into caller [rsp+0],
// which the wrapper reads at [rbp+16] after its own `push rbp`
// (iris_xe_hotplug.pdx §M L580 precedent). `add rsp, 16` reclaims.
// Entries that fire klog_s1_x1_d2 (ELIGIBILITY) do `sub rsp, 8` pad
// + 3 pushes (vd2, kd2, vd1 in that order) = 32 B total; after a 5-
// push callee-save prologue the pre-CALL alignment is %16==0, `add
// rsp, 32` reclaims pad + 3 args.  Entries that fire klog_s1_d1
// (RELEASE) do zero stack args (klog_s1_d1 has 5 reg args that fit
// rdi..r8 without spill).
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file
// compiles alongside the kernel because tools/build.sh recurses
// through src/kernel/core/drivers/dpy/ with a single `find`, so a
// new .pdx in that directory is picked up automatically; no
// build.sh edit required.
//
// invoke.pdx gets ONE new dispatch arm (0x4A -> cap_handler_direct_
// scanout) landed alongside this file (see invoke.pdx §Wave 59 G8
// arm) so the kind is reachable from cap_invoke the moment this
// skeleton lands.
//
// klog/wrappers.pdx gets ONE new wrapper mint (klog_s1_x1_d2) landed
// alongside this file for the DIRECT_SCANOUT ELIGIBLE 1-hex + 2-
// decimal fingerprint.
//
// No caller invokes direct_scanout_* yet. A follow-up slice adds a
// boot-witness programme at
// tests/kernel/drivers/wit_direct_scanout.pdx that:
//   (1) direct_scanout_eligibility(bo_cap, 0, 1920, 1200) -> fails
//       until gpu_bo_map_gtt lands;
//   (2) direct_scanout_arm(bo_cap, 0) -> DS_OK;
//   (3) direct_scanout_release(0) -> DS_OK;
// and asserts the three fingerprints land on the klog wire.

module DirectScanout = structure {

  // ==========================================================================
  // §A  Register offsets -- PLANE_SURF / PLANE_STRIDE / PLANE_SIZE /
  //                        PLANE_CTL / PLANE_POS
  // ==========================================================================
  //
  // Per Intel bspec "Register Reference -> Display Registers -> ADL"
  // (Alder Lake / Raptor Lake). Pipe stride is 0x1000.

  pub let DS_PLANE_CTL_A       : u64 = 0x70180
  pub let DS_PLANE_CTL_B       : u64 = 0x71180
  pub let DS_PLANE_CTL_C       : u64 = 0x72180

  pub let DS_PLANE_STRIDE_A    : u64 = 0x70188
  pub let DS_PLANE_STRIDE_B    : u64 = 0x71188
  pub let DS_PLANE_STRIDE_C    : u64 = 0x72188

  pub let DS_PLANE_POS_A       : u64 = 0x7018C
  pub let DS_PLANE_POS_B       : u64 = 0x7118C
  pub let DS_PLANE_POS_C       : u64 = 0x7218C

  pub let DS_PLANE_SIZE_A      : u64 = 0x70190
  pub let DS_PLANE_SIZE_B      : u64 = 0x71190
  pub let DS_PLANE_SIZE_C      : u64 = 0x72190

  pub let DS_PLANE_SURF_A      : u64 = 0x7019C
  pub let DS_PLANE_SURF_B      : u64 = 0x7119C
  pub let DS_PLANE_SURF_C      : u64 = 0x7219C

  pub let DS_PIPE_STRIDE       : u64 = 0x1000

  // ==========================================================================
  // §B  PLANE_CTL encoding
  // ==========================================================================

  pub let DS_PLANE_CTL_ENABLE          : u64 = 0x80000000  // bit 31
  pub let DS_PLANE_CTL_FMT_SHIFT       : u64 = 24           // bits 29:24
  pub let DS_PLANE_CTL_TILE_LINEAR     : u64 = 0            // bits 11:10 = 00

  pub let DS_SPF_A8R8G8B8  : u64 = 0x01     // 32bpp ARGB (admitted)
  pub let DS_SPF_A8B8G8R8  : u64 = 0x02     // 32bpp ABGR (deferred)
  pub let DS_SPF_X8R8G8B8  : u64 = 0x04     // 32bpp XRGB (deferred)
  pub let DS_SPF_X8B8G8R8  : u64 = 0x08     // 32bpp XBGR (deferred)

  pub let DS_BPP_ARGB32    : u64 = 4         // bytes per pixel for the
                                             // admitted format

  pub let DS_STRIDE_ALIGN  : u64 = 64        // plane engine cacheline

  // Pipe identifiers. Public so a caller can read-aloud the pipe
  // argument rather than hard-code 0/1/2 at the call site.
  pub let DS_PIPE_A : u64 = 0
  pub let DS_PIPE_B : u64 = 1
  pub let DS_PIPE_C : u64 = 2
  pub let DS_PIPE_COUNT : u64 = 3

  // Mapped-in bit mirrored from kind_gpu_bo_drv.pdx §B. Mirrored
  // rather than imported because the pdx module system has no
  // cross-module constant import; the symbol itself (gpu_bo_row_
  // mapped_in) is link-time global.
  pub let DS_MAPPED_GTT    : u64 = 1

  // ==========================================================================
  // §C  Failure taxonomy -- band 0xFFFFFE2B..0xFFFFFE2F
  //
  // See §4 of the file header for the collision note (CAP_OWNER_*
  // claims the same byte values; the collision is harmless because
  // the two kinds do not share a dispatch arm).
  // ==========================================================================

  pub let DS_OK                    : u64 = 0
  pub let DS_ERR_BO_NOT_GTT        : u64 = 0xFFFFFE2B
  pub let DS_ERR_BAD_FORMAT        : u64 = 0xFFFFFE2C
  pub let DS_ERR_STRIDE_MISALIGN   : u64 = 0xFFFFFE2D
  pub let DS_ERR_SIZE_TOO_SMALL    : u64 = 0xFFFFFE2E
  pub let DS_ERR_UNKNOWN_PIPE      : u64 = 0xFFFFFE2F

  // ==========================================================================
  // §D  Per-pipe state -- 4 u64 slots per pipe * 3 pipes = 12 u64s.
  //
  // Layout per pipe (32 bytes stride, pipe * 32 = `shl r, 5`):
  //   +0  bo_cap         -- armed BO cap (0 = no direct scanout active)
  //   +8  stride_bytes   -- plane line stride at arm time
  //   +16 mode_width     -- active frame width at arm time (pixels)
  //   +24 mode_height    -- active frame height at arm time (pixels)
  //
  // mode_width / mode_height are stored at ARM time so a later release
  // or eligibility re-check can refuse an incoming BO whose size does
  // not match what the pipe is currently programmed for without having
  // to re-read PIPE_SRCSZ.
  // ==========================================================================

  pub let mut _ds_pipe_state : [u64; 12] = uninit @align(64)

  // Per-op stats (bumped once per successful entry). Visible via the
  // getter trio in §J.
  pub let mut _ds_elig_ct    : u64 = 0
  pub let mut _ds_arm_ct     : u64 = 0
  pub let mut _ds_release_ct : u64 = 0

  // ==========================================================================
  // §E  Fingerprint tags + keys
  //
  // Three tags, one per entrypoint. Each is a single-line string
  // literal (the multiline `pub let ="..."` form is forbidden by the
  // pdx parser). Tag length is `strlen + 1` (NUL terminator) so a
  // tag_len off-by-one is a build-time error.
  //
  // Fingerprints on the wire:
  //   DIRECT_SCANOUT ELIGIBLE bo=0x<hex> pipe=<dec> ok=<dec>
  //   DIRECT_SCANOUT ARMED bo=0x<hex> pipe=<dec>
  //   DIRECT_SCANOUT RELEASED pipe=<dec>
  //
  // Matches tests/fingerprints/direct_scanout.golden pattern.
  // ==========================================================================

  pub let ds_tag_eligible : [u8; 24] = "DIRECT_SCANOUT ELIGIBLE\0"
  pub let ds_tag_armed    : [u8; 21] = "DIRECT_SCANOUT ARMED\0"
  pub let ds_tag_released : [u8; 24] = "DIRECT_SCANOUT RELEASED\0"

  pub let ds_k_bo    : [u8; 3] = "bo\0"
  pub let ds_k_pipe  : [u8; 5] = "pipe\0"
  pub let ds_k_ok    : [u8; 3] = "ok\0"

  // Handler-entry chatter tag (for the cap-handler path).
  pub let ds_tag_handler_entry : [u8; 29] = "DIRECT_SCANOUT handler entry\0"

  // ==========================================================================
  // §F  direct_scanout_eligibility(bo_cap, pipe, mode_width, mode_height)
  //       -> u64
  //
  // Returns DS_OK (= 0) if (bo_cap, pipe) is admissible as a direct-
  // scanout source for the given mode geometry, or one of the DS_ERR_*
  // sentinels (0xFFFFFE2B..2F) on the first failing rule.
  //
  // The task prompt's prototype says this returns 1 iff eligible, 0
  // otherwise; the DS_OK = 0 encoding carries MORE information (a 1/0
  // caller just checks `rax == 0`) while still being compatible with a
  // boolean reinterpretation downstream, same convention every other
  // *_err / *_ok primitive on the dpy branch follows.
  //
  // The fingerprint `DIRECT_SCANOUT ELIGIBLE bo=0x<hex> pipe=<dec>
  // ok=<dec>` fires AFTER the gate chain so a caller sees exactly one
  // ELIGIBLE line per eligibility query, with ok = 1 (admitted) or
  // ok = 0 (any gate failed); the specific sentinel is in rax.
  //
  // SysV: rdi = bo_cap, rsi = pipe, rdx = mode_width, rcx = mode_height.
  // Stack recipe: 3 callee-save pushes (rbx = bo_cap, r12 = pipe, r13
  // = packed (mode_w | mode_h<<32) so both survive the gpu_bo_row_
  // mapped_in + gpu_bo_row_size_pages calls). sub rsp, 8 pad + 3 push
  // for klog_s1_x1_d2 stack args.
  // ==========================================================================

  pub let direct_scanout_eligibility : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (bo_cap: u64, pipe: u64, mode_width: u64, mode_height: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: eligibility gate chain over (bo_cap, pipe, mode_width, mode_height). Rules in order: (1) pipe > 2 -> DS_ERR_UNKNOWN_PIPE (0xFFFFFE2F); (2) gpu_bo_row_mapped_in(bo_cap) & DS_MAPPED_GTT == 0 -> DS_ERR_BO_NOT_GTT (0xFFFFFE2B); (3) stride & 0x3F != 0 -> DS_ERR_STRIDE_MISALIGN (0xFFFFFE2D) where stride is folded at skeleton stage as mode_width*4 (bytes-per-pixel for the single admitted A8R8G8B8 format); (4) size_pages*4096 < stride*mode_height -> DS_ERR_SIZE_TOO_SMALL (0xFFFFFE2E). Returns DS_OK on all gates passing. Fingerprint `DIRECT_SCANOUT ELIGIBLE bo=0x<hex> pipe=<dec> ok=<dec>` fires at the end of the body, after the counter bump; ok = (gate chain returned DS_OK). Register plan: rbx = bo_cap (saved), r12 = pipe (saved), r13 = packed (mode_w | mode_h<<32) so both survive the two nested gpu_bo_row_* calls, r14 = stride (recomputed from r13 low 32), r15 = ok flag (0 or 1) carried into the klog_s1_x1_d2 call. Five callee-save pushes land rsp%16==0 at every nested call (entry rsp%16==8, +40 -> 48, %16==0; the firmware_blob five-push discipline). klog_s1_x1_d2 caller contract: pad 8 + push vd2(ok) + push kd2(ds_k_ok) + push vd1(pipe), add rsp, 32 to reclaim. Labels prefixed ds_elig_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = bo_cap (saved)
        mov r12, rsi;                       // r12 = pipe (saved)

        // Pack (mode_w | mode_h<<32) into r13 so one register
        // survives the two nested calls. The upper 32 bits of each
        // are presumed 0 at the ABI boundary; a mode > 2^32 is nonsense
        // for a display pipe.
        mov r13, rcx;                       // r13 = mode_height (low)
        shl r13, 32;                        // r13 = mode_height << 32
        or  r13, rdx;                       // r13 = mode_w | (mode_h << 32)

        // --- Gate (1): pipe in {0, 1, 2}.
        cmp r12, 2;
        ja  ds_elig_bad_pipe;

        // --- Gate (2): BO is GTT-bound.
        mov rdi, rbx;                       // rdi = bo_cap -> row_id
        call gpu_bo_row_mapped_in;
        // rax now holds the mapped_in word (or GPU_BO_DECODE_BAD on a
        // dead row; GPU_BO_DECODE_BAD = 0xFFFFFFFFFFFFFFFF so masking
        // with 0x01 yields 1 and this skeleton treats the dead-row
        // case as "eligible on R1" -- gate R2 then refuses on size
        // because size_pages is also DECODE_BAD and `shl 12` saturates
        // high, so size*4096 > stride*mode_h is false. A follow-up
        // slice intercepts the DECODE_BAD sentinel explicitly.)
        mov r10, 1;                         // DS_MAPPED_GTT
        and rax, r10;
        cmp rax, 0;
        je  ds_elig_not_gtt;

        // --- Gate (3): stride alignment.
        //     Fold stride = mode_w * DS_BPP_ARGB32 (= mode_w << 2).
        //     stride & 0x3F != 0 -> misalign.
        mov r14, r13;
        mov r10, 0xFFFFFFFF;
        and r14, r10;                       // r14 = mode_w (low 32)
        shl r14, 2;                         // r14 = stride_bytes
        mov r10, r14;
        and r10, 63;                        // r10 = stride & 0x3F
        cmp r10, 0;
        jne ds_elig_bad_stride;

        // --- Gate (4): size check.
        //     size_pages = gpu_bo_row_size_pages(bo_cap).
        //     size_bytes = size_pages * 4096 = size_pages << 12.
        //     need = stride_bytes * mode_h.
        //     if size_bytes < need -> too small.
        mov rdi, rbx;
        call gpu_bo_row_size_pages;
        // rax = size_pages (or GPU_BO_DECODE_BAD).
        shl rax, 12;                        // rax = size_bytes
        mov r11, rax;                       // r11 = size_bytes

        //     need = stride * mode_h via two-operand `imul reg, reg`
        //     (the pdx encoder forbids 2-op `imul r, imm` but admits
        //     reg-reg; see src/kernel/core/time/tsc.pdx L275 and
        //     core/tui/canvas_present.pdx L765 for the precedent).
        //     Operand A = rax (stride_bytes); operand B = rcx (mode_h,
        //     re-extracted from r13 high).
        mov rax, r14;                       // rax = stride_bytes
        mov rcx, r13;
        shr rcx, 32;                        // rcx = mode_h
        imul rax, rcx;                      // rax = stride * mode_h (low 64)
        //     We assume mode_h <= 65535 and stride <= 2^20, so
        //     product < 2^36; the imul low-64 result holds the full
        //     answer. The follow-up slice adds an overflow refuse
        //     (`jo ds_elig_too_big`); the skeleton trusts the caller
        //     for a sane mode.
        cmp r11, rax;                       // size_bytes vs need
        jb  ds_elig_too_small;

        // --- All gates passed.
        mov r15, 1;                         // ok = 1 (admitted)
        jmp ds_elig_fingerprint;

      ds_elig_bad_pipe:
        mov r15, 0;                         // ok = 0 (any gate failed)
        mov r10, 0xFFFFFE2F;                // DS_ERR_UNKNOWN_PIPE
        mov [rip + _ds_elig_last_err], r10;
        jmp ds_elig_fingerprint;

      ds_elig_not_gtt:
        mov r15, 0;
        mov r10, 0xFFFFFE2B;                // DS_ERR_BO_NOT_GTT
        mov [rip + _ds_elig_last_err], r10;
        jmp ds_elig_fingerprint;

      ds_elig_bad_stride:
        mov r15, 0;
        mov r10, 0xFFFFFE2D;                // DS_ERR_STRIDE_MISALIGN
        mov [rip + _ds_elig_last_err], r10;
        jmp ds_elig_fingerprint;

      ds_elig_too_small:
        mov r15, 0;
        mov r10, 0xFFFFFE2E;                // DS_ERR_SIZE_TOO_SMALL
        mov [rip + _ds_elig_last_err], r10;

      ds_elig_fingerprint:
        // --- Count the query (bump BEFORE fingerprint so a crash
        //     mid-fingerprint still records the entry).
        mov rax, [rip + _ds_elig_ct];
        add rax, 1;
        mov [rip + _ds_elig_ct], rax;

        // --- klog_s1_x1_d2(level=3, SUBSYS_DRV_, tag, k_bo, bo,
        //                   k_pipe, [vd1=pipe], k_ok, [vd2=ok])
        //
        // SysV reg args (rdi..r9 slots used): level, subsys, tag,
        // k_bo, bo_cap, k_pipe. Stack args pushed in reverse order
        // (vd2 first = farthest from rsp, vd1 last = closest to rsp):
        //   push vd2=ok  -> lands at [rbp+32] inside the wrapper
        //   push kd2=k_ok -> lands at [rbp+24]
        //   push vd1=pipe -> lands at [rbp+16]
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ds_tag_eligible];
        lea rcx, [rip + ds_k_bo];
        mov r8, rbx;                        // v1 = bo_cap
        lea r9, [rip + ds_k_pipe];

        sub rsp, 8;                         // pad
        mov rax, r15;                       // vd2 = ok
        push rax;
        lea rax, [rip + ds_k_ok];           // kd2
        push rax;
        mov rax, r12;                       // vd1 = pipe
        push rax;
        call klog_s1_x1_d2;
        add rsp, 32;                        // reclaim pad + 3 args

        // --- Return value: DS_OK if ok==1, else the stashed sentinel.
        cmp r15, 1;
        je  ds_elig_ret_ok;
        mov rax, [rip + _ds_elig_last_err];
        jmp ds_elig_out;

      ds_elig_ret_ok:
        xor rax, rax;                       // DS_OK

      ds_elig_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Per-pipe last-error stash (one u64, overwritten by each
  // eligibility call). The stash exists so the ok=0 case can carry
  // the specific sentinel into the return path without threading it
  // through the fingerprint register plan. A caller that cares which
  // gate tripped reads rax directly on the ok=0 return; the stash is
  // belt-and-suspenders for a future per-pipe-stat accumulator.
  pub let mut _ds_elig_last_err : u64 = 0

  // ==========================================================================
  // §G  direct_scanout_arm(bo_cap, pipe) -> u64
  //
  // Bind `bo_cap` as the PRIMARY plane framebuffer for `pipe`. Real
  // body (follow-up slice):
  //
  //   (1) MMIO: PLANE_SURF[pipe]   = host_pa of bo_cap   (via mov_d)
  //   (2) MMIO: PLANE_STRIDE[pipe] = stride_bytes        (via mov_d)
  //   (3) MMIO: PLANE_SIZE[pipe]   = (w-1) | (h-1 << 16) (via mov_d)
  //   (4) MMIO: PLANE_CTL[pipe]    = ENABLE | SPF_A8R8G8B8 | LINEAR
  //   (5) Wait for next VBLANK -> plane goes live.
  //
  // This skeleton stops at the state-record + counter bump + finger-
  // print. It does NOT re-run the eligibility gate; a caller MUST
  // call direct_scanout_eligibility first and act on its sentinel.
  // The real body (follow-up) adds a defensive eligibility re-check
  // because MMIO is live and a wrong PLANE_SURF stamps garbage onto
  // the panel.
  //
  // Gates in order:
  //   (1) pipe > 2 -> DS_ERR_UNKNOWN_PIPE
  //
  // SysV: rdi = bo_cap, rsi = pipe.
  // Stack recipe: 3 callee-save pushes.
  // ==========================================================================

  pub let direct_scanout_arm : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (bo_cap: u64, pipe: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: record (bo_cap, pipe) into the per-pipe state block + bump _ds_arm_ct + emit `DIRECT_SCANOUT ARMED bo=0x<hex> pipe=<dec>` via klog_s1_x1_d1. Gate: pipe > 2 -> DS_ERR_UNKNOWN_PIPE. The real body (follow-up) stamps PLANE_SURF / PLANE_STRIDE / PLANE_SIZE / PLANE_CTL via mov_d; this skeleton records only the state slot so a direct_scanout_release can tell whether the pipe is armed. mode_w / mode_h / stride_bytes slots are left zero at the skeleton stage (the eligibility caller does not pass them to arm; the real body re-queries PIPE_SRCSZ to populate them). Register plan: rbx = bo_cap (saved), r12 = pipe (saved), r13 = pipe * 32 (per-pipe row offset, computed once). Three callee-save pushes land rsp%16==0 at every nested call. klog_s1_x1_d1 caller contract: `sub rsp, 16; mov [rsp+0], r12` writes vd=pipe to caller [rsp+0] (which the wrapper reads at [rbp+16] after its own `push rbp`); plain `push rax` would land rsp%16==8 pre-CALL and the wrapper's `push rbp; sub rsp, 48` recipe would then nest its own klog_emit_core call at %16==8. `add rsp, 16` reclaims the pad + vd slot. Labels prefixed ds_arm_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = bo_cap (saved)
        mov r12, rsi;                       // r12 = pipe (saved)

        // --- Gate: pipe in {0, 1, 2}.
        cmp r12, 2;
        ja  ds_arm_bad_pipe;

        // --- Compute per-pipe row base: &_ds_pipe_state + pipe * 32.
        lea r13, [rip + _ds_pipe_state];
        mov rax, r12;
        shl rax, 5;                         // pipe * 32
        add r13, rax;

        // --- Record (bo_cap). Other slots (stride_bytes / mode_width
        //     / mode_height) are left zero at skeleton stage; the
        //     real body in the follow-up slice fills them from the
        //     eligibility query the caller just performed (passed via
        //     an extended signature or re-queried from PIPE_SRCSZ).
        mov [r13 + 0], rbx;                 // bo_cap

        // --- Count the arm (bump before fingerprint).
        mov rax, [rip + _ds_arm_ct];
        add rax, 1;
        mov [rip + _ds_arm_ct], rax;

        // --- klog_s1_x1_d1(level=3, SUBSYS_DRV_, tag, k_bo, bo_cap,
        //                   k_pipe, [vd=pipe])
        //
        // After 3 callee-save pushes rsp%16==0 (entry %16==8, +24 =
        // 32, %16==0).  A plain `push rax` to stage vd would land
        // rsp%16==8 pre-CALL and the wrapper's `push rbp; sub rsp,
        // 48` recipe would then nest its own klog_emit_core call at
        // %16==8 (misaligned).  The idiom is `sub rsp, 16; mov
        // [rsp+0], val` -- 16 bytes reserves the vd slot AND keeps
        // alignment; the wrapper reads vd at [rbp+16] after its own
        // `push rbp`, which is exactly what caller [rsp+0] + CALL (-8)
        // + push rbp (-8) resolves to.  Writing vd at [rsp+8] would
        // land it at [rbp+24] inside the wrapper and the real pipe
        // value never reaches the fingerprint (the klog_s1_x1_d1 /
        // _x1_d2 caller trap called out in the Wave 59 G8 task).
        sub rsp, 16;
        mov [rsp + 0], r12;                 // vd = pipe (caller [rsp+0])
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ds_tag_armed];
        lea rcx, [rip + ds_k_bo];
        mov r8, rbx;                        // v1 = bo_cap
        lea r9, [rip + ds_k_pipe];
        call klog_s1_x1_d1;
        add rsp, 16;                        // reclaim pad + vd slot

        xor rax, rax;                       // DS_OK
        jmp ds_arm_out;

      ds_arm_bad_pipe:
        mov rax, 0xFFFFFE2F;                // DS_ERR_UNKNOWN_PIPE

      ds_arm_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  direct_scanout_release(pipe) -> u64
  //
  // Detach the client BO from `pipe` and revert to the compositor's
  // own BO. Real body (follow-up slice):
  //
  //   (1) Readback compositor BO's host_pa (passed via a cap or
  //       recorded in a sibling slot).
  //   (2) MMIO: PLANE_SURF[pipe]  = compositor_host_pa (via mov_d).
  //   (3) MMIO: PLANE_CTL[pipe]  &= ~ENABLE until VBLANK, then flip
  //       ENABLE back on with the compositor's SPF.
  //
  // This skeleton zeroes the per-pipe state slot and emits the
  // RELEASED fingerprint. A release on a pipe that was never armed
  // is NOT a failure -- it's idempotent, consistent with the plane_
  // primary.pdx "detach-is-idempotent" semantics.
  //
  // Gates:
  //   (1) pipe > 2 -> DS_ERR_UNKNOWN_PIPE
  //
  // SysV: rdi = pipe.
  // Stack recipe: 3 callee-save pushes.
  // ==========================================================================

  pub let direct_scanout_release : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pipe: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: zero the per-pipe state slot + bump _ds_release_ct + emit `DIRECT_SCANOUT RELEASED pipe=<dec>` via klog_s1_d1. Gate: pipe > 2 -> DS_ERR_UNKNOWN_PIPE. The real body (follow-up) rewrites PLANE_SURF to the compositor's BO; this skeleton records only the zeroed state slot. Release on an un-armed pipe is idempotent (returns DS_OK) consistent with the plane_primary.pdx detach semantics. Register plan: rbx = pipe (saved), r12 = per-pipe row base. Three callee-save pushes land rsp%16==0 at every nested call. klog_s1_d1 caller contract: fit in 5 reg args (rdi..r8); no stack arg. Labels prefixed ds_rel_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = pipe (saved)

        // --- Gate: pipe in {0, 1, 2}.
        cmp rbx, 2;
        ja  ds_rel_bad_pipe;

        // --- Compute per-pipe row base + zero the four slots.
        lea r12, [rip + _ds_pipe_state];
        mov rax, rbx;
        shl rax, 5;                         // pipe * 32
        add r12, rax;

        xor rax, rax;
        mov [r12 + 0],  rax;                // bo_cap = 0
        mov [r12 + 8],  rax;                // stride_bytes
        mov [r12 + 16], rax;                // mode_width
        mov [r12 + 24], rax;                // mode_height

        // --- Count the release.
        mov rax, [rip + _ds_release_ct];
        add rax, 1;
        mov [rip + _ds_release_ct], rax;

        // --- klog_s1_d1(level=3, SUBSYS_DRV_, tag, k_pipe, pipe).
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ds_tag_released];
        lea rcx, [rip + ds_k_pipe];
        mov r8, rbx;                        // v = pipe
        call klog_s1_d1;

        xor rax, rax;                       // DS_OK
        jmp ds_rel_out;

      ds_rel_bad_pipe:
        mov rax, 0xFFFFFE2F;                // DS_ERR_UNKNOWN_PIPE

      ds_rel_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  Per-pipe armed-BO getter
  //
  // Returns the bo_cap currently armed as direct scanout for `pipe`,
  // or 0 if the pipe is not armed (or `pipe` is out of range -- same
  // return as "not armed" because the handler op demux is a thin
  // query reader that treats bad pipe as "not armed, don't crash").
  //
  // SysV: rdi = pipe. Leaf.
  // ==========================================================================

  pub let direct_scanout_armed_bo : (u64) -> u64 !{mem} @{} =
    fn (pipe: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: pipe > 2 -> 0; else return _ds_pipe_state[pipe * 32 + 0] (bo_cap slot). Leaf, no callee-save prologue. Labels prefixed ds_abo_.",
      block: {
        cmp rdi, 2;
        ja  ds_abo_zero;

        lea rax, [rip + _ds_pipe_state];
        mov rcx, rdi;
        shl rcx, 5;                         // pipe * 32
        add rax, rcx;
        mov rax, [rax + 0];                 // bo_cap slot
        ret;

      ds_abo_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // §J  Per-op counter getters
  //
  // Three leaf getters so a boot-witness programme can assert
  // (eligibility_ct, arm_ct, release_ct) without touching the
  // _ds_*_ct symbols directly.
  // ==========================================================================

  pub let direct_scanout_eligibility_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: single mov load from _ds_elig_ct. Leaf.",
      block: {
        mov rax, [rip + _ds_elig_ct];
        ret
      }
    }

  pub let direct_scanout_arm_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: single mov load from _ds_arm_ct. Leaf.",
      block: {
        mov rax, [rip + _ds_arm_ct];
        ret
      }
    }

  pub let direct_scanout_release_ct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: single mov load from _ds_release_ct. Leaf.",
      block: {
        mov rax, [rip + _ds_release_ct];
        ret
      }
    }

  // ==========================================================================
  // §K  cap_handler_direct_scanout(rights, target_ptr, op_arg) -> u64
  //
  // KIND_DIRECT_SCANOUT (0x4A) cap_invoke dispatch handler. Reachable
  // from cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x4A;
  // je call_kind_direct_scanout` arm added alongside this file.
  //
  // The three main entrypoints (eligibility / arm / release) each
  // take more than three arguments, so cap_invoke -- which hands
  // the handler only (rights, target_ptr, op_arg) -- cannot plumb
  // them directly without an extended cap_invoke signature or a
  // packed op_arg. The handler is therefore QUERY-ONLY at skeleton
  // stage, exactly like iris_xe_hotplug / kind_gpu_bo_drv do for
  // their first slice. Three ops:
  //
  //     op 0 DS_OP_QUERY_ARMED_BO -> bo_cap armed on `pipe` (target_
  //                                  ptr[7:0]), or 0 if not armed
  //     op 1 DS_OP_QUERY_ARM_CT   -> _ds_arm_ct (ignores target_ptr)
  //     op 2 DS_OP_QUERY_REL_CT   -> _ds_release_ct (ignores target_ptr)
  //     else                        INVOKE_UNSUPPORTED
  //
  // The mutating primitives (arm / release) ride supervisor callers
  // above the generic cap_invoke syscall ABI; a follow-up slice
  // either extends cap_invoke with a 4-register slot variant or
  // packs (bo_cap<<32 | pipe) into op_arg for the arm path.
  //
  // Rights gate: every op requires R_DS_READ (0x001). target_ptr IS
  // the pipe id (0..2) for op 0, ignored for ops 1-2; masked to its
  // low byte on entry as a defensive bound for a future layout widen.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg.
  // Stack recipe: 3 callee-save pushes (rbx = rights, r12 = target,
  // r13 = op_code).
  // ==========================================================================

  pub let R_DS_READ : u64 = 0x001

  pub let DS_OP_QUERY_ARMED_BO : u64 = 0
  pub let DS_OP_QUERY_ARM_CT   : u64 = 1
  pub let DS_OP_QUERY_REL_CT   : u64 = 2

  pub let cap_handler_direct_scanout : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 59 G8 (paideia-os#2545) skeleton: KIND_DIRECT_SCANOUT (0x4A) cap_invoke dispatch. Entry chatter (klog_s1 of ds_tag_handler_entry). op_code = op_arg & 0xFF; rights gate against R_DS_READ (single up-front check); dispatch 0..2 to the matching reader (direct_scanout_armed_bo / direct_scanout_arm_ct / direct_scanout_release_ct); else INVOKE_UNSUPPORTED. target_ptr IS the pipe id for op 0, masked to its low byte as a defensive bound. Three callee-save pushes land rsp%16==0 at every nested call. The mutating ops (arm / release / eligibility -- all take >1 non-rights arg) are deferred to a follow-up slice that either extends cap_invoke with a 4-register slot variant or packs (bo_cap<<32 | pipe) into op_arg. Labels prefixed ds_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rights
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                       // pipe = target_ptr[7:0]
        mov r13, rdx;                       // op_arg
        and r13, r10;                       // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ds_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                     // R_DS_READ
        cmp r10, 0;
        je  ds_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  ds_hd_op_armed;
        cmp r13, 1;
        je  ds_hd_op_arm_ct;
        cmp r13, 2;
        je  ds_hd_op_rel_ct;
        jmp ds_hd_unsup;

      ds_hd_op_armed:
        mov rdi, r12;
        call direct_scanout_armed_bo;
        jmp ds_hd_out;

      ds_hd_op_arm_ct:
        call direct_scanout_arm_ct;
        jmp ds_hd_out;

      ds_hd_op_rel_ct:
        call direct_scanout_release_ct;
        jmp ds_hd_out;

      ds_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;        // INVOKE_DENIED
        jmp ds_hd_out;
      ds_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;        // INVOKE_UNSUPPORTED

      ds_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  Boot wiring note
  // ----------------
  // kernel_main.pdx does NOT need a dedicated reset entry: .bss zero-
  // init leaves _ds_pipe_state empty and the three counters at zero,
  // which is exactly the never-armed starting state the eligibility
  // and arm paths expect. A follow-up slice may mint a defensive
  // `direct_scanout_reset` for parity with the other dpy drivers'
  // reset entries (iris_xe_cursor_reset is the local precedent), but
  // the skeleton gets by on .bss alone.
  //
  // invoke.pdx picks up the KIND_DIRECT_SCANOUT (0x4A) dispatch arm
  // in the same slice as this file -- the arm is pure plumbing and
  // self-standing (handler returns INVOKE_UNSUPPORTED for every
  // mutating op at skeleton stage, which is observable but harmless).
  //
  // klog/wrappers.pdx picks up the klog_s1_x1_d2 mint in the same
  // slice. The wrapper is byte-for-byte klog_s1_x3 with fmt letters
  // 'x', 'd', 'd' (vs 'x', 'x', 'x'); the single-slice landing keeps
  // the eligibility fingerprint's 1-hex + 2-decimal shape honest.
  //
  // Follow-up slices (D16 and later):
  //   - Real MMIO body for direct_scanout_arm (PLANE_SURF / STRIDE /
  //     SIZE / CTL / POS writes) once the pipe-stride multiplication
  //     is folded into the mod-pipe-row-reader.
  //   - Format extension (SPF 0x02/0x04/0x08) + eligibility gate R4.
  //   - overflow refuse on stride*mode_h (gate R2).
  //   - cap_handler extension for the arm/release/eligibility ops
  //     (packed op_arg or a 4-register cap_invoke slot variant).
  // ==========================================================================
}
