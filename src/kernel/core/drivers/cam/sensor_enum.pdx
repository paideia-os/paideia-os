// src/kernel/core/drivers/cam/sensor_enum.pdx — R40.M2-003 (#1353)
//
// Camera-sensor DRIVER-ENUMERATION scaffold.  Walks a synthetic ACPI
// namespace snapshot and, for each device node, extracts the _CID
// (compatibility identifier) that platform firmware uses to describe
// the sensor (Windows/Linux camera stacks match sensors this way).
// Matching _CIDs bind the caller-nominated driver name / KIND_CSI_CAMERA
// row hint pair into a small internal table so a later mint step
// (R40.M3+) can walk from a device node to the KIND_CSI_CAMERA row
// its driver will admit.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the LOOKUP + RECORD half of sensor bring-up.  It does NOT
// program the sensor (that is R40.M2-004 / sensor_init), it does NOT
// mint KIND_CSI_CAMERA (that is R40.M3+ once the driver has read the
// sensor's identity registers through the CSI-2 receiver), and it
// does NOT touch a real ACPI namespace either -- the namespace it
// walks is a synthetic snapshot the witness populates.  The seam is
// a bounded (id, row_hint) table this module owns.
//
// The recognised _CIDs are:
//
//   INT33BE (OmniVision OV5693,  Surface-family sensor)
//   OVTI2680 (OmniVision OV2680)
//   OVTI5670 (OmniVision OV5670, T14 G4 mainboard sensor)
//
// Any other _CID rejects with SEN_BAD_CID.  A driver whose _CID is
// not in the accepted set has no code path yet: R40.M2-004 will bind
// each admitted _CID to its per-sensor init sequence, and the mint
// step will refuse to admit a sensor whose driver is not present.
//
// sen_arbitrated() returns 0 until a later round wires this against
// a live ACPI namespace walker.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _sen_bind_table + _sen_bind_count + _sen_stats are written only by
// helpers in this module.  tools/build.sh confines relocations
// against each to `core/drivers/cam/sensor_enum.o`.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF210..0xFFFFF21F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: csi_phy 0xFFFFF220..2F,
// R40.M2-002; adjacent free band below: sensor_init 0xFFFFF200..0F,
// R40.M2-004).

module SensorEnum = structure {

  // Compatibility IDs (§0).  Encoded as u64 identifiers: the caller
  // packs the ACPI _CID string into an integer through a small helper
  // callers agree on (a live walker would compare byte-for-byte
  // against the namespace string; this scaffold's ordinals stand in
  // for those bytes at test time).
  pub let SEN_CID_INT33BE  : u64 = 0x1                    // OV5693
  pub let SEN_CID_OVTI2680 : u64 = 0x2                    // OV2680
  pub let SEN_CID_OVTI5670 : u64 = 0x3                    // OV5670

  pub let SEN_CID_MAX      : u64 = 3

  // Bounded table -- one row is (cid, row_hint), 16 bytes each,
  // MAX = 8 rows.
  pub let SEN_BIND_MAX     : u64 = 8
  pub let SEN_ROW_BYTES    : u64 = 16

  // Failure taxonomy — 0xFFFFF210..0xFFFFF21F.
  pub let SEN_OK              : u64 = 0
  pub let SEN_BAD_CID         : u64 = 0xFFFFF21F
  pub let SEN_BAD_ROW         : u64 = 0xFFFFF21E
  pub let SEN_ENOSPC          : u64 = 0xFFFFF21D
  pub let SEN_ALREADY_BOUND   : u64 = 0xFFFFF21C
  pub let SEN_NOT_FOUND       : u64 = 0xFFFFF21B
  pub let SEN_BAD_ARG         : u64 = 0xFFFFF21A

  pub let mut _sen_bind_table  : [u64; 16] = uninit @align(64)
  pub let mut _sen_bind_count  : [u64; 1]  = uninit @align(64)
  pub let mut _sen_stats       : [u64; 8]  = uninit @align(64)

  pub let SEN_ST_ATTEMPTS : u64 = 0
  pub let SEN_ST_MATCHED  : u64 = 1
  pub let SEN_ST_REJECTS  : u64 = 2
  pub let SEN_ST_UNBINDS  : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let sen_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-003 (#1353): clear bind table, count, and stats. Boot + teardown. Labels prefixed sen_rs_.",
      block: {
        lea r10, [rip + _sen_bind_table];
        xor rax, rax;
        xor rcx, rcx;
      sen_rs_tbl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  sen_rs_tbl;

        lea r10, [rip + _sen_bind_count];
        xor rax, rax;
        mov [r10 + 0], rax;

        lea r10, [rip + _sen_stats];
        xor rcx, rcx;
      sen_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sen_rs_stats;
        ret
      }
    }

  pub let sen_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-003 (#1353): honesty pin. Returns 0 until a later round wires against a live ACPI namespace walker.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let sen_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-003 (#1353): counter bump. Labels prefixed sen_nt_.",
      block: {
        cmp rdi, 8;
        jae sen_nt_out;
        lea r10, [rip + _sen_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sen_nt_out:
        ret
      }
    }

  pub let sen_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-003 (#1353): counter read. Labels prefixed sen_st_.",
      block: {
        cmp rdi, 8;
        jae sen_st_zero;
        lea r10, [rip + _sen_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sen_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let sen_cid_valid : (u64) -> u64 !{} @{} =
    fn (cid: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-003 (#1353): 1 iff cid in accepted set (INT33BE / OVTI2680 / OVTI5670). Labels prefixed sen_cv_.",
      block: {
        cmp rdi, 1;
        je  sen_cv_yes;
        cmp rdi, 2;
        je  sen_cv_yes;
        cmp rdi, 3;
        je  sen_cv_yes;
        xor rax, rax;
        ret;
      sen_cv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let sen_row_of_slot_valid : (u64) -> u64 !{} @{} =
    fn (row: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-003 (#1353): 1 iff row in [0, 8). Bounds are the CCAM_MAX row cap. Labels prefixed sen_rv_.",
      block: {
        cmp rdi, 8;
        jae sen_rv_no;
        mov rax, 1;
        ret;
      sen_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sen_bind_count_of() -> u64
  // ==========================================================================

  pub let sen_bind_count_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-003 (#1353): number of live binds. Labels prefixed sen_bc_.",
      block: {
        lea r10, [rip + _sen_bind_count];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // sen_lookup_cid(cid) -> row_hint | SEN_NOT_FOUND
  //
  // Linear scan.  Returns the row_hint of the first bind whose cid
  // matches, or SEN_NOT_FOUND (0xFFFFF21B) if none.
  // ==========================================================================

  pub let sen_lookup_cid : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-003 (#1353): linear scan of _sen_bind_table for cid. Labels prefixed sen_lk_.",
      block: {
        lea r10, [rip + _sen_bind_count];
        mov r11, [r10 + 0];
        cmp r11, 0;
        je  sen_lk_none;

        lea r10, [rip + _sen_bind_table];
        xor rcx, rcx;
      sen_lk_scan:
        cmp rcx, r11;
        jae sen_lk_none;
        mov r9, rcx;
        shl r9, 4;                       // stride 16
        mov r8, r10;
        add r8, r9;                      // r8 = row base
        mov rax, [r8 + 0];               // cid
        cmp rax, rdi;
        je  sen_lk_hit;
        add rcx, 1;
        jmp sen_lk_scan;

      sen_lk_hit:
        mov rax, [r8 + 8];               // row_hint
        ret;
      sen_lk_none:
        mov rax, 0xFFFFF21B;
        ret
      }
    }

  // ==========================================================================
  // sen_bind(cid, row_hint) -> SEN_OK | error
  //
  // Sequence:
  //   1. cid_valid; refuse SEN_BAD_CID on mismatch.
  //   2. row_of_slot_valid; refuse SEN_BAD_ROW on out-of-range.
  //   3. sen_lookup_cid; refuse SEN_ALREADY_BOUND if already present.
  //   4. capacity check; refuse SEN_ENOSPC at 8 rows.
  //   5. append (cid, row_hint) at _sen_bind_table[count]; bump count.
  //   6. bump ATTEMPTS + MATCHED.
  // ==========================================================================

  pub let sen_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (cid: u64) (row_hint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-003 (#1353): bind (cid, row_hint) into _sen_bind_table. Guards per §5 in header. Three pushes (rbx/r12/r13) keep SysV rsp%16==0 at every nested call boundary; r13 is preserved but unused. Labels prefixed sen_b_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // cid
        mov r12, rsi;                    // row_hint

        mov rdi, 0;                      // ATTEMPTS
        call sen_note;

        mov rdi, rbx;
        call sen_cid_valid;
        cmp rax, 0;
        je  sen_b_bad_cid;

        mov rdi, r12;
        call sen_row_of_slot_valid;
        cmp rax, 0;
        je  sen_b_bad_row;

        mov rdi, rbx;
        call sen_lookup_cid;
        mov r11, 0xFFFFF21B;             // SEN_NOT_FOUND -- ok
        cmp rax, r11;
        jne sen_b_already;

        lea r10, [rip + _sen_bind_count];
        mov r11, [r10 + 0];
        mov r9, 8;
        cmp r11, r9;
        jae sen_b_enospc;

        lea r10, [rip + _sen_bind_table];
        mov r9, r11;
        shl r9, 4;                       // stride 16
        add r10, r9;                     // r10 = row base
        mov [r10 + 0], rbx;
        mov [r10 + 8], r12;

        lea r10, [rip + _sen_bind_count];
        add r11, 1;
        mov [r10 + 0], r11;

        mov rdi, 1;                      // MATCHED
        call sen_note;
        xor rax, rax;
        jmp sen_b_out;

      sen_b_bad_cid:
        mov rdi, 2;
        call sen_note;
        mov rax, 0xFFFFF21F;
        jmp sen_b_out;
      sen_b_bad_row:
        mov rdi, 2;
        call sen_note;
        mov rax, 0xFFFFF21E;
        jmp sen_b_out;
      sen_b_already:
        mov rdi, 2;
        call sen_note;
        mov rax, 0xFFFFF21C;
        jmp sen_b_out;
      sen_b_enospc:
        mov rdi, 2;
        call sen_note;
        mov rax, 0xFFFFF21D;

      sen_b_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // sen_unbind(cid) -> SEN_OK | SEN_NOT_FOUND
  //
  // Removes the row whose cid matches; compacts the tail one slot
  // down so the table stays dense.  Returns SEN_NOT_FOUND when
  // cid is not bound.
  // ==========================================================================

  pub let sen_unbind : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-003 (#1353): remove cid from _sen_bind_table with tail compaction. Labels prefixed sen_u_.",
      block: {
        push rbx;

        lea r10, [rip + _sen_bind_count];
        mov r11, [r10 + 0];
        cmp r11, 0;
        je  sen_u_not_found;

        lea r10, [rip + _sen_bind_table];
        xor rbx, rbx;
      sen_u_scan:
        cmp rbx, r11;
        jae sen_u_not_found;
        mov r9, rbx;
        shl r9, 4;
        mov r8, r10;
        add r8, r9;
        mov rax, [r8 + 0];
        cmp rax, rdi;
        je  sen_u_hit;
        add rbx, 1;
        jmp sen_u_scan;

      sen_u_hit:
        // Compact: shift rows [rbx+1 .. r11) down by one.
      sen_u_shift:
        mov r9, rbx;
        add r9, 1;
        cmp r9, r11;
        jae sen_u_shift_done;

        // src = table + r9*16
        mov r8, r10;
        mov rax, r9;
        shl rax, 4;
        add r8, rax;
        mov rcx, [r8 + 0];
        mov rax, [r8 + 8];

        // dst = table + rbx*16
        mov r8, r10;
        mov r9, rbx;
        shl r9, 4;
        add r8, r9;
        mov [r8 + 0], rcx;
        mov [r8 + 8], rax;

        add rbx, 1;
        jmp sen_u_shift;

      sen_u_shift_done:
        // Zero the last row.
        mov r9, r11;
        sub r9, 1;
        shl r9, 4;
        mov r8, r10;
        add r8, r9;
        xor rax, rax;
        mov [r8 + 0], rax;
        mov [r8 + 8], rax;

        lea r10, [rip + _sen_bind_count];
        sub r11, 1;
        mov [r10 + 0], r11;

        mov rdi, 3;                      // UNBINDS
        call sen_note;

        xor rax, rax;
        jmp sen_u_out;

      sen_u_not_found:
        mov rax, 0xFFFFF21B;

      sen_u_out:
        pop rbx;
        ret
      }
    }
}
