// src/kernel/core/drivers/cam/ipu6_pipeline.pdx — R40.M3-001 (#1355)
//
// IPU6 IMAGING PIPELINE STAGES.
//
// The IPU6 processes each captured MIPI-CSI frame through a chain of
// hardware stages before delivering NV12/YUYV/RAW10 payload to the
// capture channel.  This module scaffolds the three stages the
// capture supervisor requires:
//
//   1. IPP2_STAGE_DENOISE    per-frame temporal + spatial denoise
//   2. IPP2_STAGE_ISP        image signal processing (demosaic, 3A)
//   3. IPP2_STAGE_FORMAT     Bayer -> NV12/YUYV/RAW10 conversion
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the STAGE DESCRIPTOR TABLE + PER-FRAME CHAIN EXECUTOR.  It
// does NOT program IPU6 MMIO (that will be a later round's driver),
// does NOT allocate GPU BOs (KIND_GPU_BO already handles that at
// R37), and does NOT touch the CSI receiver (R40.M2 owns that).  It
// records per-stage entry / exit counts and the format ordinal a
// completed frame carries; the scaffolded execution is a compile-time
// pass through the three stages that a live driver replaces with an
// IPU6 DMA descriptor issue.
//
// The stage table is small and enumerated: any future stage
// (portrait-mode blur, HDR fusion) is a visible extension of
// IPP2_STAGE_MAX rather than a silent widening.
//
// =============================================================================
// §1  CTRL BANK
// =============================================================================
//
//   [0]  CTRL_STREAM_KEY     stream this pipeline is bound to
//   [1]  CTRL_FORMAT         target output format (NV12/YUYV/RAW10)
//   [2]  CTRL_WIDTH          frame width
//   [3]  CTRL_HEIGHT         frame height
//   [4]  CTRL_FRAMES_IN      running total of frames admitted
//   [5]  CTRL_FRAMES_OUT     running total of frames completed
//   [6]  CTRL_LAST_STAGE     last stage the chain advanced past
//   [7]  CTRL_LAST_RC        return code of the last chain call
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _ipp2_ctrl, _ipp2_state, _ipp2_stage_counts, and _ipp2_stats are
// written only by helpers in this module.  tools/build.sh confines
// relocations against each to `core/drivers/cam/ipu6_pipeline.o`.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF1E0..0xFFFFF1EF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: KIND_IPU6_STREAM
// 0xFFFFF1F0..FF, R40.M3-002; adjacent free band below: camera
// capture channel 0xFFFFF1D0..DF, R40.M3-003).

module Ipu6Pipeline = structure {

  // Stage ordinals.
  pub let IPP2_STAGE_DENOISE : u64 = 1
  pub let IPP2_STAGE_ISP     : u64 = 2
  pub let IPP2_STAGE_FORMAT  : u64 = 3
  pub let IPP2_STAGE_MAX     : u64 = 3

  // Output format ordinals -- must MATCH kind_ipu6_stream.pdx.
  pub let IPP2_FMT_NV12   : u64 = 1
  pub let IPP2_FMT_YUYV   : u64 = 2
  pub let IPP2_FMT_RAW10  : u64 = 3

  // CTRL bank slot indices.
  pub let IPP2_CTRL_STREAM_KEY  : u64 = 0
  pub let IPP2_CTRL_FORMAT      : u64 = 1
  pub let IPP2_CTRL_WIDTH       : u64 = 2
  pub let IPP2_CTRL_HEIGHT      : u64 = 3
  pub let IPP2_CTRL_FRAMES_IN   : u64 = 4
  pub let IPP2_CTRL_FRAMES_OUT  : u64 = 5
  pub let IPP2_CTRL_LAST_STAGE  : u64 = 6
  pub let IPP2_CTRL_LAST_RC     : u64 = 7

  // Failure taxonomy — 0xFFFFF1E0..0xFFFFF1EF.
  pub let IPP2_OK              : u64 = 0
  pub let IPP2_BAD_STAGE       : u64 = 0xFFFFF1EF
  pub let IPP2_BAD_FORMAT      : u64 = 0xFFFFF1EE
  pub let IPP2_BAD_DIM         : u64 = 0xFFFFF1ED
  pub let IPP2_NOT_CONFIGURED  : u64 = 0xFFFFF1EC
  pub let IPP2_ALREADY_CONFIGURED : u64 = 0xFFFFF1EB
  pub let IPP2_BAD_ARG         : u64 = 0xFFFFF1EA
  pub let IPP2_STAGE_FAILED    : u64 = 0xFFFFF1E9

  pub let mut _ipp2_ctrl         : [u64; 8] = uninit @align(64)
  pub let mut _ipp2_state        : [u64; 1] = uninit @align(64)
  pub let mut _ipp2_stage_counts : [u64; 8] = uninit @align(64)
  pub let mut _ipp2_stats        : [u64; 8] = uninit @align(64)

  pub let IPP2_ST_CHAIN_OK      : u64 = 0
  pub let IPP2_ST_CHAIN_REFUSED : u64 = 1
  pub let IPP2_ST_STAGE_FAILED  : u64 = 2
  pub let IPP2_ST_TEARDOWNS     : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let ipp2_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): clear CTRL bank, configured flag, stage counters, and stats. Boot + teardown. Labels prefixed ipp2_rs_.",
      block: {
        lea r10, [rip + _ipp2_ctrl];
        xor rax, rax;
        xor rcx, rcx;
      ipp2_rs_ctrl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ipp2_rs_ctrl;

        lea r10, [rip + _ipp2_state];
        xor rax, rax;
        mov [r10 + 0], rax;

        lea r10, [rip + _ipp2_stage_counts];
        xor rcx, rcx;
      ipp2_rs_scounts:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ipp2_rs_scounts;

        lea r10, [rip + _ipp2_stats];
        xor rcx, rcx;
      ipp2_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ipp2_rs_stats;
        ret
      }
    } @no_frame

  pub let ipp2_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-001 (#1355): honesty pin. Returns 0 until a later round wires this against live IPU6 MMIO DMA descriptors.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ipp2_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): stats counter bump. Labels prefixed ipp2_nt_.",
      block: {
        cmp rdi, 8;
        jae ipp2_nt_out;
        lea r10, [rip + _ipp2_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ipp2_nt_out:
        ret
      }
    } @no_frame

  pub let ipp2_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): stats counter read. Labels prefixed ipp2_st_.",
      block: {
        cmp rdi, 8;
        jae ipp2_st_zero;
        lea r10, [rip + _ipp2_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ipp2_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ipp2_stage_count : (u64) -> u64 !{mem} @{} =
    fn (stage: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): per-stage entry count read. Bounds refuse with 0. Labels prefixed ipp2_sc_.",
      block: {
        cmp rdi, 8;
        jae ipp2_sc_zero;
        lea r10, [rip + _ipp2_stage_counts];
        mov rax, [r10 + rdi * 8];
        ret;
      ipp2_sc_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let ipp2_stage_valid : (u64) -> u64 !{} @{} =
    fn (stage: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-001 (#1355): 1 iff stage in {DENOISE, ISP, FORMAT}. Labels prefixed ipp2_sv_.",
      block: {
        cmp rdi, 1;
        je  ipp2_sv_yes;
        cmp rdi, 2;
        je  ipp2_sv_yes;
        cmp rdi, 3;
        je  ipp2_sv_yes;
        xor rax, rax;
        ret;
      ipp2_sv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let ipp2_format_valid : (u64) -> u64 !{} @{} =
    fn (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-001 (#1355): 1 iff fmt in {NV12, YUYV, RAW10}. Matches KIND_IPU6_STREAM's format ordinals. Labels prefixed ipp2_fv_.",
      block: {
        cmp rdi, 1;
        je  ipp2_fv_yes;
        cmp rdi, 2;
        je  ipp2_fv_yes;
        cmp rdi, 3;
        je  ipp2_fv_yes;
        xor rax, rax;
        ret;
      ipp2_fv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let ipp2_dim_valid : (u64) -> u64 !{} @{} =
    fn (dim: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M3-001 (#1355): 1 iff dim in [1, 8192]. Labels prefixed ipp2_dv_.",
      block: {
        cmp rdi, 0;
        je  ipp2_dv_no;
        mov r10, 8192;
        cmp rdi, r10;
        ja  ipp2_dv_no;
        mov rax, 1;
        ret;
      ipp2_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // CTRL accessors.
  // ==========================================================================

  pub let ipp2_ctrl_read : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): read a CTRL bank slot; bounds refuse with 0. Labels prefixed ipp2_cr_.",
      block: {
        cmp rdi, 8;
        jae ipp2_cr_zero;
        lea r10, [rip + _ipp2_ctrl];
        mov rax, [r10 + rdi * 8];
        ret;
      ipp2_cr_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ipp2_is_configured : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): 1 iff pipeline has been configured this boot. Labels prefixed ipp2_ic_.",
      block: {
        lea r10, [rip + _ipp2_state];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  // ==========================================================================
  // ipp2_configure(stream_key, format, width, height) -> IPP2_OK | error
  //
  // Sequence:
  //   1. Refuse ALREADY_CONFIGURED.
  //   2. Validate format, width, height individually.
  //   3. stream_key non-zero (BAD_ARG).
  //   4. Stamp CTRL_STREAM_KEY / FORMAT / WIDTH / HEIGHT.
  //   5. Zero the running counters + LAST_STAGE + LAST_RC.
  //   6. Set configured flag.
  // ==========================================================================

  pub let ipp2_configure : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (stream_key: u64) (fmt: u64) (width: u64) (height: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): configure pipeline binding. Labels prefixed ipp2_cf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // stream_key
        mov r12, rsi;                    // fmt
        mov r13, rdx;                    // width
        mov r14, rcx;                    // height

        // 1. Not-already.
        lea r10, [rip + _ipp2_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne ipp2_cf_already;

        // 2. Format.
        mov rdi, r12;
        call ipp2_format_valid;
        cmp rax, 0;
        je  ipp2_cf_bad_format;

        // Width.
        mov rdi, r13;
        call ipp2_dim_valid;
        cmp rax, 0;
        je  ipp2_cf_bad_dim;

        // Height.
        mov rdi, r14;
        call ipp2_dim_valid;
        cmp rax, 0;
        je  ipp2_cf_bad_dim;

        // 3. stream_key non-zero.
        cmp rbx, 0;
        je  ipp2_cf_bad_arg;

        // 4. Stamp CTRL bank.
        lea r10, [rip + _ipp2_ctrl];
        mov [r10 + 0],  rbx;             // STREAM_KEY
        mov [r10 + 8],  r12;             // FORMAT
        mov [r10 + 16], r13;             // WIDTH
        mov [r10 + 24], r14;             // HEIGHT

        // 5. Zero running counters.
        xor rax, rax;
        mov [r10 + 32], rax;             // FRAMES_IN
        mov [r10 + 40], rax;             // FRAMES_OUT
        mov [r10 + 48], rax;             // LAST_STAGE
        mov [r10 + 56], rax;             // LAST_RC

        // 6. Set configured.
        lea r10, [rip + _ipp2_state];
        mov rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;
        jmp ipp2_cf_out;

      ipp2_cf_already:
        mov rax, 0xFFFFF1EB;
        jmp ipp2_cf_out;
      ipp2_cf_bad_format:
        mov rax, 0xFFFFF1EE;
        jmp ipp2_cf_out;
      ipp2_cf_bad_dim:
        mov rax, 0xFFFFF1ED;
        jmp ipp2_cf_out;
      ipp2_cf_bad_arg:
        mov rax, 0xFFFFF1EA;

      ipp2_cf_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ipp2_run_stage(stage) -> IPP2_OK | error
  //
  // Bump the per-stage entry count, stamp LAST_STAGE + LAST_RC.  A
  // live driver replaces this with the IPU6 DMA descriptor issue.
  // Refuses NOT_CONFIGURED / BAD_STAGE.
  // ==========================================================================

  pub let ipp2_run_stage : (u64) -> u64 !{mem} @{} =
    fn (stage: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): synthetic single-stage execution. Labels prefixed ipp2_rn_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;

        lea r10, [rip + _ipp2_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ipp2_rn_not_cfg;

        mov rdi, rbx;
        call ipp2_stage_valid;
        cmp rax, 0;
        je  ipp2_rn_bad;

        // Bump per-stage entry count.
        lea r10, [rip + _ipp2_stage_counts];
        mov rax, [r10 + rbx * 8];
        add rax, 1;
        mov [r10 + rbx * 8], rax;

        // Stamp LAST_STAGE + LAST_RC=OK.
        lea r10, [rip + _ipp2_ctrl];
        mov [r10 + 48], rbx;             // LAST_STAGE
        xor rax, rax;
        mov [r10 + 56], rax;             // LAST_RC = OK

        xor rax, rax;
        jmp ipp2_rn_out;

      ipp2_rn_not_cfg:
        mov rax, 0xFFFFF1EC;
        jmp ipp2_rn_out;
      ipp2_rn_bad:
        mov rax, 0xFFFFF1EF;

      ipp2_rn_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ipp2_process_frame() -> IPP2_OK | error
  //
  // Chain DENOISE -> ISP -> FORMAT.  Bumps FRAMES_IN on entry (after
  // the configured check); FRAMES_OUT only after the chain completes.
  // ==========================================================================

  pub let ipp2_process_frame : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): chain the three stages per-frame. Bumps FRAMES_IN before the chain and FRAMES_OUT only after the last stage completes. Labels prefixed ipp2_pf_.",
      block: {
        push rbx;
        push r12;

        lea r10, [rip + _ipp2_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ipp2_pf_not_cfg;

        // FRAMES_IN += 1.
        lea r10, [rip + _ipp2_ctrl];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;

        // DENOISE.
        mov rdi, 1;
        call ipp2_run_stage;
        cmp rax, 0;
        jne ipp2_pf_stage_fail;

        // ISP.
        mov rdi, 2;
        call ipp2_run_stage;
        cmp rax, 0;
        jne ipp2_pf_stage_fail;

        // FORMAT.
        mov rdi, 3;
        call ipp2_run_stage;
        cmp rax, 0;
        jne ipp2_pf_stage_fail;

        // FRAMES_OUT += 1.
        lea r10, [rip + _ipp2_ctrl];
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;

        mov rdi, 0;                      // CHAIN_OK
        call ipp2_note;

        xor rax, rax;
        jmp ipp2_pf_out;

      ipp2_pf_not_cfg:
        mov rdi, 1;                      // CHAIN_REFUSED
        call ipp2_note;
        mov rax, 0xFFFFF1EC;
        jmp ipp2_pf_out;
      ipp2_pf_stage_fail:
        mov rdi, 2;                      // STAGE_FAILED
        call ipp2_note;
        // Stamp LAST_RC = STAGE_FAILED.
        lea r10, [rip + _ipp2_ctrl];
        mov r11, 0xFFFFF1E9;
        mov [r10 + 56], r11;
        mov rax, 0xFFFFF1E9;

      ipp2_pf_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ipp2_teardown() -> IPP2_OK | IPP2_NOT_CONFIGURED
  //
  // Clears CTRL fields; leaves the stage-count counters in place for
  // post-mortem audit.
  // ==========================================================================

  pub let ipp2_teardown : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M3-001 (#1355): teardown. Refuses NOT_CONFIGURED. Labels prefixed ipp2_td_.",
      block: {
        push rbx;

        lea r10, [rip + _ipp2_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ipp2_td_not_cfg;

        lea r10, [rip + _ipp2_ctrl];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        lea r10, [rip + _ipp2_state];
        xor rax, rax;
        mov [r10 + 0], rax;

        mov rdi, 3;                      // TEARDOWNS
        call ipp2_note;

        xor rax, rax;
        jmp ipp2_td_out;

      ipp2_td_not_cfg:
        mov rax, 0xFFFFF1EC;

      ipp2_td_out:
        pop rbx;
        ret
      }
    }
}
