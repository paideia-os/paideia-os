// src/kernel/core/drivers/cam/sensor_init.pdx — R40.M2-004 (#1354)
//
// Per-sensor INIT SEQUENCE scaffold.  For each _CID sensor_enum
// (R40.M2-003) admits, this module carries a compile-time table of
// supported (mode, resolution, fps) triples and a small register
// sequence that would be shifted onto the sensor's I²C control bus
// to program that mode.  The register sequence itself is modelled as
// a compile-time byte count and a synthetic execution counter -- a
// live driver replaces the counter with the DesignWare I²C engine's
// write completion signal.
//
// Supported modes:
//
//   SINIT_MODE_STILL     one-shot capture
//   SINIT_MODE_PREVIEW   low-latency preview
//   SINIT_MODE_VIDEO     sustained streaming
//
// Supported (width, height, fps) settings per mode:
//
//   1920x1080 @ 30 fps  (video / preview)
//   1280x720  @ 60 fps  (preview / video)
//   2592x1944 @ 15 fps  (still, OV5670 native)
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the MODE-SELECTOR + PROGRAM half of sensor bring-up.  It does
// NOT open the I²C bus to the sensor (that is the R30.M5 LPSS I²C
// controller's job) and it does NOT decode the CSI-2 payload (that
// is R40.M3+ work).  It does record the caller-requested mode/geometry/
// fps triple, refuses anything outside the supported set, and stages
// the register count that a live driver would shift onto the wire.
//
// sinit_arbitrated() returns 0 until a later round wires this against
// a live LPSS I²C engine.
//
// =============================================================================
// §1  CTRL REGISTER MAP (synthetic; per-sensor names differ)
// =============================================================================
//
//   [0]  CTRL_MODE       one of SINIT_MODE_{STILL,PREVIEW,VIDEO}
//   [1]  CTRL_WIDTH      programmed width
//   [2]  CTRL_HEIGHT     programmed height
//   [3]  CTRL_FPS        programmed frame rate
//   [4]  CTRL_REG_BYTES  running total of register bytes issued
//   [5]  CTRL_PROG_SEQ   program sequence counter
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _sinit_ctrl, _sinit_state, and _sinit_stats are written only by
// helpers in this module.  tools/build.sh confines relocations
// against each to `core/drivers/cam/sensor_init.o`.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF200..0xFFFFF20F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: sensor_enum
// 0xFFFFF210..1F, R40.M2-003; adjacent free band below: unused at
// R40.M2).

module SensorInit = structure {

  // Mode ordinals.
  pub let SINIT_MODE_STILL   : u64 = 1
  pub let SINIT_MODE_PREVIEW : u64 = 2
  pub let SINIT_MODE_VIDEO   : u64 = 3
  pub let SINIT_MODE_MAX     : u64 = 3

  // Supported (width, height, fps) triples.
  pub let SINIT_W_1920 : u64 = 1920
  pub let SINIT_H_1080 : u64 = 1080
  pub let SINIT_W_1280 : u64 = 1280
  pub let SINIT_H_720  : u64 = 720
  pub let SINIT_W_2592 : u64 = 2592
  pub let SINIT_H_1944 : u64 = 1944

  pub let SINIT_FPS_15 : u64 = 15
  pub let SINIT_FPS_30 : u64 = 30
  pub let SINIT_FPS_60 : u64 = 60

  // Register byte counts (per-sensor scaffolds keep a small constant
  // here; a live driver would derive these from an embedded init
  // table).  Kept internal so tools/build.sh can confine changes.
  pub let SINIT_REG_BYTES_STILL   : u64 = 128
  pub let SINIT_REG_BYTES_PREVIEW : u64 = 96
  pub let SINIT_REG_BYTES_VIDEO   : u64 = 192

  // §1: CTRL bank slot indices.
  pub let SINIT_CTRL_MODE      : u64 = 0
  pub let SINIT_CTRL_WIDTH     : u64 = 1
  pub let SINIT_CTRL_HEIGHT    : u64 = 2
  pub let SINIT_CTRL_FPS       : u64 = 3
  pub let SINIT_CTRL_REG_BYTES : u64 = 4
  pub let SINIT_CTRL_PROG_SEQ  : u64 = 5

  // Failure taxonomy — 0xFFFFF200..0xFFFFF20F.
  pub let SINIT_OK              : u64 = 0
  pub let SINIT_BAD_MODE        : u64 = 0xFFFFF20F
  pub let SINIT_BAD_RES         : u64 = 0xFFFFF20E
  pub let SINIT_BAD_FPS         : u64 = 0xFFFFF20D
  pub let SINIT_BAD_TRIPLE      : u64 = 0xFFFFF20C
  pub let SINIT_ALREADY_PROG    : u64 = 0xFFFFF20B
  pub let SINIT_NOT_PROG        : u64 = 0xFFFFF20A
  pub let SINIT_BAD_ARG         : u64 = 0xFFFFF209

  pub let mut _sinit_ctrl  : [u64; 8] = uninit @align(64)
  pub let mut _sinit_state : [u64; 1] = uninit @align(64)
  pub let mut _sinit_stats : [u64; 8] = uninit @align(64)

  pub let SINIT_ST_PROGRAMS : u64 = 0
  pub let SINIT_ST_REFUSED  : u64 = 1
  pub let SINIT_ST_TEARDOWNS: u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let sinit_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-004 (#1354): clear CTRL bank, prog flag, and stats. Boot + teardown. Labels prefixed sinit_rs_.",
      block: {
        lea r10, [rip + _sinit_ctrl];
        xor rax, rax;
        xor rcx, rcx;
      sinit_rs_ctrl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sinit_rs_ctrl;

        lea r10, [rip + _sinit_state];
        xor rax, rax;
        mov [r10 + 0], rax;

        lea r10, [rip + _sinit_stats];
        xor rcx, rcx;
      sinit_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sinit_rs_stats;
        ret
      }
    } @no_frame

  pub let sinit_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-004 (#1354): honesty pin. Returns 0 until a later round wires this against a live LPSS I²C engine.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sinit_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-004 (#1354): counter bump. Labels prefixed sinit_nt_.",
      block: {
        cmp rdi, 8;
        jae sinit_nt_out;
        lea r10, [rip + _sinit_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sinit_nt_out:
        ret
      }
    } @no_frame

  pub let sinit_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-004 (#1354): counter read. Labels prefixed sinit_st_.",
      block: {
        cmp rdi, 8;
        jae sinit_st_zero;
        lea r10, [rip + _sinit_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sinit_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let sinit_mode_valid : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-004 (#1354): 1 iff mode in {STILL, PREVIEW, VIDEO}. Labels prefixed sinit_mv_.",
      block: {
        cmp rdi, 1;
        je  sinit_mv_yes;
        cmp rdi, 2;
        je  sinit_mv_yes;
        cmp rdi, 3;
        je  sinit_mv_yes;
        xor rax, rax;
        ret;
      sinit_mv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let sinit_res_valid : (u64, u64) -> u64 !{} @{} =
    fn (width: u64) (height: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-004 (#1354): 1 iff (width, height) is one of the three supported extents. Labels prefixed sinit_rv_.",
      block: {
        // 1920x1080
        mov r10, 1920;
        cmp rdi, r10;
        jne sinit_rv_not_1080;
        mov r10, 1080;
        cmp rsi, r10;
        je  sinit_rv_yes;
      sinit_rv_not_1080:
        // 1280x720
        mov r10, 1280;
        cmp rdi, r10;
        jne sinit_rv_not_720;
        mov r10, 720;
        cmp rsi, r10;
        je  sinit_rv_yes;
      sinit_rv_not_720:
        // 2592x1944
        mov r10, 2592;
        cmp rdi, r10;
        jne sinit_rv_no;
        mov r10, 1944;
        cmp rsi, r10;
        je  sinit_rv_yes;
      sinit_rv_no:
        xor rax, rax;
        ret;
      sinit_rv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let sinit_fps_valid : (u64) -> u64 !{} @{} =
    fn (fps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-004 (#1354): 1 iff fps in {15, 30, 60}. Labels prefixed sinit_fv_.",
      block: {
        cmp rdi, 15;
        je  sinit_fv_yes;
        cmp rdi, 30;
        je  sinit_fv_yes;
        cmp rdi, 60;
        je  sinit_fv_yes;
        xor rax, rax;
        ret;
      sinit_fv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // sinit_triple_supported(mode, width, height, fps) -> u64
  //
  // The joint-support table -- some (w, h) admit at a given fps only
  // in a specific mode.
  //
  //   STILL   2592x1944 @ 15  |  1920x1080 @ 15/30
  //   PREVIEW 1280x720 @ 30/60 | 1920x1080 @ 30
  //   VIDEO   1920x1080 @ 30 | 1280x720 @ 60
  // ==========================================================================

  pub let sinit_triple_supported : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (mode: u64) (width: u64) (height: u64) (fps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-004 (#1354): compile-time joint-support matrix. Returns 1 iff the (mode, width, height, fps) tuple is in the accepted set. Labels prefixed sinit_ts_.",
      block: {
        // Dispatch on mode.
        cmp rdi, 1;
        je  sinit_ts_still;
        cmp rdi, 2;
        je  sinit_ts_preview;
        cmp rdi, 3;
        je  sinit_ts_video;
        xor rax, rax;
        ret;

      sinit_ts_still:
        // 2592x1944 @ 15
        mov r10, 2592;
        cmp rsi, r10;
        jne sinit_ts_still_a;
        mov r10, 1944;
        cmp rdx, r10;
        jne sinit_ts_still_a;
        cmp rcx, 15;
        je  sinit_ts_yes;
      sinit_ts_still_a:
        // 1920x1080 @ 15 or 30
        mov r10, 1920;
        cmp rsi, r10;
        jne sinit_ts_no;
        mov r10, 1080;
        cmp rdx, r10;
        jne sinit_ts_no;
        cmp rcx, 15;
        je  sinit_ts_yes;
        cmp rcx, 30;
        je  sinit_ts_yes;
        jmp sinit_ts_no;

      sinit_ts_preview:
        // 1280x720 @ 30 or 60
        mov r10, 1280;
        cmp rsi, r10;
        jne sinit_ts_preview_a;
        mov r10, 720;
        cmp rdx, r10;
        jne sinit_ts_preview_a;
        cmp rcx, 30;
        je  sinit_ts_yes;
        cmp rcx, 60;
        je  sinit_ts_yes;
        jmp sinit_ts_no;
      sinit_ts_preview_a:
        // 1920x1080 @ 30
        mov r10, 1920;
        cmp rsi, r10;
        jne sinit_ts_no;
        mov r10, 1080;
        cmp rdx, r10;
        jne sinit_ts_no;
        cmp rcx, 30;
        je  sinit_ts_yes;
        jmp sinit_ts_no;

      sinit_ts_video:
        // 1920x1080 @ 30
        mov r10, 1920;
        cmp rsi, r10;
        jne sinit_ts_video_a;
        mov r10, 1080;
        cmp rdx, r10;
        jne sinit_ts_video_a;
        cmp rcx, 30;
        je  sinit_ts_yes;
      sinit_ts_video_a:
        // 1280x720 @ 60
        mov r10, 1280;
        cmp rsi, r10;
        jne sinit_ts_no;
        mov r10, 720;
        cmp rdx, r10;
        jne sinit_ts_no;
        cmp rcx, 60;
        je  sinit_ts_yes;
        jmp sinit_ts_no;

      sinit_ts_no:
        xor rax, rax;
        ret;
      sinit_ts_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Reg-byte count from mode.
  // ==========================================================================

  pub let sinit_reg_bytes_of : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M2-004 (#1354): the per-mode register byte count. Labels prefixed sinit_rb_.",
      block: {
        cmp rdi, 1;
        je  sinit_rb_still;
        cmp rdi, 2;
        je  sinit_rb_preview;
        cmp rdi, 3;
        je  sinit_rb_video;
        xor rax, rax;
        ret;
      sinit_rb_still:
        mov rax, 128;
        ret;
      sinit_rb_preview:
        mov rax, 96;
        ret;
      sinit_rb_video:
        mov rax, 192;
        ret
      }
    } @no_frame

  // ==========================================================================
  // CTRL accessors + status.
  // ==========================================================================

  pub let sinit_ctrl_read : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-004 (#1354): read a CTRL bank slot; bounds refuse with 0. Labels prefixed sinit_cr_.",
      block: {
        cmp rdi, 8;
        jae sinit_cr_zero;
        lea r10, [rip + _sinit_ctrl];
        mov rax, [r10 + rdi * 8];
        ret;
      sinit_cr_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sinit_is_programmed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-004 (#1354): 1 iff sensor has been programmed this boot. Labels prefixed sinit_ip_.",
      block: {
        lea r10, [rip + _sinit_state];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  // ==========================================================================
  // sinit_program(mode, width, height, fps) -> SINIT_OK | error
  //
  // Sequence:
  //   1. Refuse ALREADY_PROG.
  //   2. Validate mode / fps individually.
  //   3. Validate (width, height) individually.
  //   4. Joint support: refuse BAD_TRIPLE if the four fields are
  //      individually valid but not accepted together.
  //   5. Stamp CTRL_MODE/WIDTH/HEIGHT/FPS/REG_BYTES; verify echoes.
  //   6. Bump CTRL_PROG_SEQ, set programmed flag, bump PROGRAMS.
  // ==========================================================================

  pub let sinit_program : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (mode: u64) (width: u64) (height: u64) (fps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-004 (#1354): program per-sensor init sequence FSM. Labels prefixed sinit_p_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // mode
        mov r12, rsi;                    // width
        mov r13, rdx;                    // height
        mov r14, rcx;                    // fps

        // 1. Not-already-programmed.
        lea r10, [rip + _sinit_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne sinit_p_already;

        // 2. Mode.
        mov rdi, rbx;
        call sinit_mode_valid;
        cmp rax, 0;
        je  sinit_p_bad_mode;

        // FPS.
        mov rdi, r14;
        call sinit_fps_valid;
        cmp rax, 0;
        je  sinit_p_bad_fps;

        // 3. Resolution.
        mov rdi, r12;
        mov rsi, r13;
        call sinit_res_valid;
        cmp rax, 0;
        je  sinit_p_bad_res;

        // 4. Joint support.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        call sinit_triple_supported;
        cmp rax, 0;
        je  sinit_p_bad_triple;

        // 5. Program CTRL bank.
        lea r10, [rip + _sinit_ctrl];
        mov [r10 + 0], rbx;              // CTRL_MODE
        mov [r10 + 8], r12;              // CTRL_WIDTH
        mov [r10 + 16], r13;             // CTRL_HEIGHT
        mov [r10 + 24], r14;             // CTRL_FPS

        // Reg-byte count for mode.
        mov rdi, rbx;
        call sinit_reg_bytes_of;
        mov r15, rax;
        lea r10, [rip + _sinit_ctrl];
        mov [r10 + 32], r15;             // CTRL_REG_BYTES

        // Verify echoes.
        mov rax, [r10 + 0];
        cmp rax, rbx;
        jne sinit_p_bad_arg;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne sinit_p_bad_arg;
        mov rax, [r10 + 16];
        cmp rax, r13;
        jne sinit_p_bad_arg;
        mov rax, [r10 + 24];
        cmp rax, r14;
        jne sinit_p_bad_arg;
        mov rax, [r10 + 32];
        cmp rax, r15;
        jne sinit_p_bad_arg;

        // 6. Bump prog seq, set programmed flag.
        mov rax, [r10 + 40];             // CTRL_PROG_SEQ
        add rax, 1;
        mov [r10 + 40], rax;

        lea r10, [rip + _sinit_state];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // PROGRAMS
        call sinit_note;
        xor rax, rax;
        jmp sinit_p_out;

      sinit_p_bad_mode:
        mov rdi, 1;
        call sinit_note;
        mov rax, 0xFFFFF20F;
        jmp sinit_p_out;
      sinit_p_bad_res:
        mov rdi, 1;
        call sinit_note;
        mov rax, 0xFFFFF20E;
        jmp sinit_p_out;
      sinit_p_bad_fps:
        mov rdi, 1;
        call sinit_note;
        mov rax, 0xFFFFF20D;
        jmp sinit_p_out;
      sinit_p_bad_triple:
        mov rdi, 1;
        call sinit_note;
        mov rax, 0xFFFFF20C;
        jmp sinit_p_out;
      sinit_p_already:
        mov rdi, 1;
        call sinit_note;
        mov rax, 0xFFFFF20B;
        jmp sinit_p_out;
      sinit_p_bad_arg:
        mov rdi, 1;
        call sinit_note;
        mov rax, 0xFFFFF209;

      sinit_p_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // sinit_teardown() -> SINIT_OK | SINIT_NOT_PROG
  //
  // Clears CTRL_MODE/WIDTH/HEIGHT/FPS/REG_BYTES.  Leaves the PROG_SEQ
  // counter in place.
  // ==========================================================================

  pub let sinit_teardown : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M2-004 (#1354): teardown. Refuses NOT_PROG if programmed flag is clear. One push rbx keeps SysV rsp%16==0 at the sinit_note call. Labels prefixed sinit_td_.",
      block: {
        push rbx;

        lea r10, [rip + _sinit_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  sinit_td_not_prog;

        lea r10, [rip + _sinit_ctrl];
        xor rax, rax;
        mov [r10 + 0], rax;              // CTRL_MODE
        mov [r10 + 8], rax;              // CTRL_WIDTH
        mov [r10 + 16], rax;             // CTRL_HEIGHT
        mov [r10 + 24], rax;             // CTRL_FPS
        mov [r10 + 32], rax;             // CTRL_REG_BYTES

        lea r10, [rip + _sinit_state];
        xor rax, rax;
        mov [r10 + 0], rax;

        mov rdi, 2;                      // TEARDOWNS
        call sinit_note;

        xor rax, rax;
        jmp sinit_td_out;

      sinit_td_not_prog:
        mov rax, 0xFFFFF20A;

      sinit_td_out:
        pop rbx;
        ret
      }
    }
}
