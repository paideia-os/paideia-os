// src/kernel/core/drivers/cam/ipu6_verify.pdx — R40.M1-002 (#1348)
//
// Intel IPU6 firmware DUAL-SIGNATURE verifier.  Refuses to accept
// an IPU6 firmware image whose vendor (RSA-2048) signature slot is
// empty OR whose paideia (Dilithium-2) re-sign slot is empty.  Fails
// closed on EITHER miss -- the dual-signature discipline mandated by
// design/roadmap/next-wave-synthesis.md §10 D1.a for a foreign blob
// run in ring 0.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ADMISSION GATE for an IPU6 firmware image.  ipu6_probe
// (#1347) recognises the PCI function; ipu6_load (#1349) is the
// byte-mover that shovels the firmware into on-chip SRAM and waits
// for BOOT_READY; this module answers "may we run this image at
// all?".  A load call that skipped this gate would silently ship
// vendor firmware into a ring-0-adjacent execution context without
// paideia having taken responsibility for the shipment -- the exact
// failure mode D1.a exists to make impossible.
//
// The IPU6 firmware ships as a single monolithic image (unlike the
// AX211 UMAC+MVM split): one code section plus a boot descriptor.
// This module accepts a bundle descriptor naming the code section
// and verifies the pair of signatures together; a bundle whose
// code section extent walks past the blob is refused as BAD_SECTION.
// A live driver mints one firmware object the ipu6_load path then
// uploads; this scaffold's contract with ipu6_load is "the bundle
// admitted here is ipv_bundle_of(), the code section's offset and
// size come out of ipv_code_off_of() / ipv_code_len_of()".
//
// IT DOES NOT PERFORM REAL RSA-2048 OR DILITHIUM-2 SIGNATURE
// ARITHMETIC.  Both signature slots are checked STRUCTURALLY this
// milestone: the slot is present and the slot's payload is
// non-empty.  The real cryptographic verifier lands under
// KIND_HASH_SESSION (R32 wave-2 scope).  Substituting the real
// verifier at that seam does not change any caller: ipv_verify()
// keeps the same signature and the same "fails closed on either
// miss" semantic -- the byte pattern the check accepts narrows from
// "any non-zero" to "algebraically valid", and every existing
// refusal path stays intact.
//
// ipv_arbitrated() returns 0 until R32 wave-2 binds the seam to a
// live KIND_HASH_SESSION verifier.
//
// =============================================================================
// §1  BUNDLE HEADER LAYOUT
// =============================================================================
//
//   Offset  Field                Size  Notes
//   ----------------------------------------------------------------------
//   0x00    magic                u32   'IPU6' (LE: 0x36555049)
//   0x04    body_size            u32   bytes of firmware body past
//                                      the header (informational; the
//                                      body is not hashed here).
//   0x08    vendor_sig[0..8)     u64   RSA-2048 signature slot (word 0)
//   0x10    vendor_sig[8..16)    u64   (word 1). A slot with BOTH
//                                      words zero is REFUSED.
//   0x18    paideia_sig[0..8)    u64   Dilithium-2 re-sign slot (w 0)
//   0x20    paideia_sig[8..16)   u64   (word 1). A slot with BOTH
//                                      words zero is REFUSED.
//   0x28    code_off             u32   byte offset of code section
//                                      within blob (u32, from base).
//                                      Must be >= header size and
//                                      + code_len must fit blob_len.
//   0x2C    code_len             u32   length of code section (bytes).
//                                      Must be > 0.
//   0x30    body...              u32*N sections + body (opaque here).
//
// Header size = 0x30 (48 bytes).  A blob shorter than the header is
// REFUSED as TOO_SMALL -- a caller cannot pretend a 16-byte trace of
// magic + one signature was a valid image.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _ipv_blob_ptr, _ipv_blob_len, _ipv_verified, _ipv_code_off,
// _ipv_code_len and _ipv_stats are written only by helpers in this
// module.  tools/build.sh confines relocations against each to
// `core/drivers/cam/ipu6_verify.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF250..0xFFFFF25F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: ipu6_probe
// 0xFFFFF260..6F, R40.M1-001; adjacent free band below: ipu6_load
// 0xFFFFF240..4F, R40.M1-003).

module Ipu6Verify = structure {

  // §1: header layout.
  pub let IPV_MAGIC             : u64 = 0x36555049           // 'IPU6' LE
  pub let IPV_HDR_SIZE          : u64 = 0x30
  pub let IPV_OFF_MAGIC         : u64 = 0x00
  pub let IPV_OFF_BODY_SIZE     : u64 = 0x04
  pub let IPV_OFF_VENDOR_LO     : u64 = 0x08
  pub let IPV_OFF_VENDOR_HI     : u64 = 0x10
  pub let IPV_OFF_PAIDEIA_LO    : u64 = 0x18
  pub let IPV_OFF_PAIDEIA_HI    : u64 = 0x20
  pub let IPV_OFF_CODE_OFF      : u64 = 0x28
  pub let IPV_OFF_CODE_LEN      : u64 = 0x2C

  // Failure taxonomy — 0xFFFFF250..0xFFFFF25F.
  pub let IPV_OK                : u64 = 0
  pub let IPV_BAD_ARG           : u64 = 0xFFFFF25F
  pub let IPV_TOO_SMALL         : u64 = 0xFFFFF25E
  pub let IPV_BAD_MAGIC         : u64 = 0xFFFFF25D
  pub let IPV_BAD_VENDOR_SIG    : u64 = 0xFFFFF25C
  pub let IPV_BAD_PAIDEIA_SIG   : u64 = 0xFFFFF25B
  pub let IPV_NULL_BLOB         : u64 = 0xFFFFF25A
  pub let IPV_BAD_SECTION       : u64 = 0xFFFFF259

  // Recorded bundle descriptor after a successful verify.
  pub let mut _ipv_blob_ptr : [u64; 1] = uninit @align(64)
  pub let mut _ipv_blob_len : [u64; 1] = uninit @align(64)
  pub let mut _ipv_verified : [u64; 1] = uninit @align(64)
  pub let mut _ipv_code_off : [u64; 1] = uninit @align(64)
  pub let mut _ipv_code_len : [u64; 1] = uninit @align(64)

  // Counters.
  pub let mut _ipv_stats : [u64; 8] = uninit @align(64)

  pub let IPV_ST_VERIFIED     : u64 = 0
  pub let IPV_ST_VENDOR_MISS  : u64 = 1
  pub let IPV_ST_PAIDEIA_MISS : u64 = 2
  pub let IPV_ST_REFUSED      : u64 = 3
  pub let IPV_ST_SECTION_MISS : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let ipv_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): clear bundle record, verified flag, section extents, and stats. Boot and teardown. Labels prefixed ipv_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _ipv_blob_ptr];
        mov [r10 + 0], rax;
        lea r10, [rip + _ipv_blob_len];
        mov [r10 + 0], rax;
        lea r10, [rip + _ipv_verified];
        mov [r10 + 0], rax;
        lea r10, [rip + _ipv_code_off];
        mov [r10 + 0], rax;
        lea r10, [rip + _ipv_code_len];
        mov [r10 + 0], rax;

        lea r10, [rip + _ipv_stats];
        xor rcx, rcx;
      ipv_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ipv_rs_stats;
        ret
      }
    } @no_frame

  pub let ipv_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-002 (#1348): honesty pin. Returns 0 until R32 wave-2 KIND_HASH_SESSION binds this to a live RSA-2048 + Dilithium-2 verifier.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ipv_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): counter bump. Labels prefixed ipv_nt_.",
      block: {
        cmp rdi, 8;
        jae ipv_nt_out;
        lea r10, [rip + _ipv_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ipv_nt_out:
        ret
      }
    } @no_frame

  pub let ipv_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): counter read. Labels prefixed ipv_st_.",
      block: {
        cmp rdi, 8;
        jae ipv_st_zero;
        lea r10, [rip + _ipv_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ipv_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ipv_verify_vendor(blob_ptr, blob_len) -> IPV_OK | BAD_VENDOR_SIG
  //
  // The RSA-2048 slot half of §1.  A slot with BOTH words zero is
  // BAD_VENDOR_SIG.  A live verifier will run the RSA-PKCS#1-v1_5
  // check against paideia's pinned Intel-IPU6 public key over the
  // firmware body; the substitution point is here, unchanged for
  // the caller.
  //
  // PRE: the shape/size checks in ipv_verify() have already passed.
  // ==========================================================================

  pub let ipv_verify_vendor : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): vendor (RSA-2048) sig slot check. §1 offsets. Labels prefixed ipv_vv_.",
      block: {
        mov rax, [rdi + 8];              // vendor_sig[0]
        mov rcx, [rdi + 16];             // vendor_sig[1]
        or  rax, rcx;
        cmp rax, 0;
        je  ipv_vv_bad;
        xor rax, rax;
        ret;
      ipv_vv_bad:
        mov rax, 0xFFFFF25C;             // BAD_VENDOR_SIG
        ret
      }
    } @no_frame

  // ==========================================================================
  // ipv_verify_paideia(blob_ptr, blob_len) -> IPV_OK | BAD_PAIDEIA_SIG
  //
  // The Dilithium-2 re-sign half of §1.  A slot with BOTH words zero
  // is BAD_PAIDEIA_SIG.
  // ==========================================================================

  pub let ipv_verify_paideia : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): paideia (Dilithium-2) re-sign slot check. §1 offsets. Labels prefixed ipv_vp_.",
      block: {
        mov rax, [rdi + 24];             // paideia_sig[0]
        mov rcx, [rdi + 32];             // paideia_sig[1]
        or  rax, rcx;
        cmp rax, 0;
        je  ipv_vp_bad;
        xor rax, rax;
        ret;
      ipv_vp_bad:
        mov rax, 0xFFFFF25B;             // BAD_PAIDEIA_SIG
        ret
      }
    } @no_frame

  // ==========================================================================
  // ipv_verify_section(blob_ptr, blob_len) -> IPV_OK | BAD_SECTION
  //
  // Checks the single code section extent:
  //   * code_off >= header size AND (code_off + code_len) <= blob_len
  //   * code_len > 0
  //
  // A bundle whose code section is absent, or whose extent walks past
  // blob_len, is REFUSED.  This catches a truncated bundle before
  // ipu6_load tries to upload it.
  // ==========================================================================

  pub let ipv_verify_section : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): code section extent check per §1. Fails BAD_SECTION. Labels prefixed ipv_vs_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;                    // blob_ptr
        mov r12, rsi;                    // blob_len

        xor rax, rax;
        mov eax, [rbx + 40];             // code_off (u32)
        cmp rax, 0x30;                   // header size
        jb  ipv_vs_bad;
        xor rcx, rcx;
        mov ecx, [rbx + 44];             // code_len (u32)
        cmp rcx, 0;
        je  ipv_vs_bad;
        add rax, rcx;
        cmp rax, r12;
        ja  ipv_vs_bad;

        xor rax, rax;
        jmp ipv_vs_out;
      ipv_vs_bad:
        mov rax, 0xFFFFF259;             // BAD_SECTION
      ipv_vs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ipv_verify(blob_ptr, blob_len) -> IPV_OK | error
  //
  // §0: THE ONE ENTRY POINT for IPU6 firmware admission.  Order:
  //   1. NULL blob refused (NULL_BLOB).
  //   2. Undersized blob refused (TOO_SMALL).
  //   3. Wrong magic refused (BAD_MAGIC).
  //   4. Vendor sig slot empty refused (BAD_VENDOR_SIG).
  //   5. Paideia sig slot empty refused (BAD_PAIDEIA_SIG).
  //   6. Section extent malformed refused (BAD_SECTION).
  //   7. On OK: record {blob_ptr, blob_len, code_off, code_len,
  //      verified=1}; bump VERIFIED counter; return 0.
  //
  // BOTH signature checks ALWAYS run.  Neither short-circuits on the
  // other's success -- the failure taxonomy tells the caller which
  // half refused so an operator sees whether the vendor blob or the
  // paideia re-sign is the missing half.
  //
  // A second call with an ALREADY-VERIFIED image is idempotent iff
  // the pair {blob_ptr, blob_len} matches; a swap is refused as
  // BAD_ARG.  That mirrors wfv_verify's swap-refusal.
  // ==========================================================================

  pub let ipv_verify : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): DUAL-SIGNATURE verify (D1.a). Vendor and paideia sig slots BOTH checked; section extent validated; fails closed on any miss. Idempotent under identity; refuses BAD_ARG on a swap. Labels prefixed ipv_v_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // blob_ptr
        mov r12, rsi;                    // blob_len

        // 1. NULL blob.
        cmp rbx, 0;
        je  ipv_v_null;

        // 2. Undersized.
        cmp r12, 0x30;
        jb  ipv_v_too_small;

        // 3. Magic.
        mov eax, [rbx + 0];
        mov r13d, 0x36555049;            // 'IPU6' LE
        cmp eax, r13d;
        jne ipv_v_bad_magic;

        // Idempotent under identity swap-check.
        lea r10, [rip + _ipv_verified];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ipv_v_do;

        lea r10, [rip + _ipv_blob_ptr];
        mov rax, [r10 + 0];
        cmp rax, rbx;
        jne ipv_v_bad_arg;
        lea r10, [rip + _ipv_blob_len];
        mov rax, [r10 + 0];
        cmp rax, r12;
        jne ipv_v_bad_arg;
        xor rax, rax;                    // already verified, same bundle
        jmp ipv_v_out;

      ipv_v_do:
        // 4. Vendor.
        mov rdi, rbx;
        mov rsi, r12;
        call ipv_verify_vendor;
        cmp rax, 0;
        jne ipv_v_vendor_bad;

        // 5. Paideia.
        mov rdi, rbx;
        mov rsi, r12;
        call ipv_verify_paideia;
        cmp rax, 0;
        jne ipv_v_paideia_bad;

        // 6. Section.
        mov rdi, rbx;
        mov rsi, r12;
        call ipv_verify_section;
        cmp rax, 0;
        jne ipv_v_section_bad;

        // 7. Record.
        lea r10, [rip + _ipv_blob_ptr];
        mov [r10 + 0], rbx;
        lea r10, [rip + _ipv_blob_len];
        mov [r10 + 0], r12;

        // Code extents.
        xor rax, rax;
        mov eax, [rbx + 40];
        lea r10, [rip + _ipv_code_off];
        mov [r10 + 0], rax;
        xor rax, rax;
        mov eax, [rbx + 44];
        lea r10, [rip + _ipv_code_len];
        mov [r10 + 0], rax;

        lea r10, [rip + _ipv_verified];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // VERIFIED
        call ipv_note;
        xor rax, rax;
        jmp ipv_v_out;

      ipv_v_null:
        mov rdi, 3;
        call ipv_note;
        mov rax, 0xFFFFF25A;
        jmp ipv_v_out;
      ipv_v_too_small:
        mov rdi, 3;
        call ipv_note;
        mov rax, 0xFFFFF25E;
        jmp ipv_v_out;
      ipv_v_bad_magic:
        mov rdi, 3;
        call ipv_note;
        mov rax, 0xFFFFF25D;
        jmp ipv_v_out;
      ipv_v_bad_arg:
        mov rdi, 3;
        call ipv_note;
        mov rax, 0xFFFFF25F;
        jmp ipv_v_out;
      ipv_v_vendor_bad:
        mov rdi, 1;                      // VENDOR_MISS
        call ipv_note;
        mov rdi, 3;
        call ipv_note;
        mov rax, 0xFFFFF25C;
        jmp ipv_v_out;
      ipv_v_paideia_bad:
        mov rdi, 2;                      // PAIDEIA_MISS
        call ipv_note;
        mov rdi, 3;
        call ipv_note;
        mov rax, 0xFFFFF25B;
        jmp ipv_v_out;
      ipv_v_section_bad:
        mov rdi, 4;                      // SECTION_MISS
        call ipv_note;
        mov rdi, 3;
        call ipv_note;
        mov rax, 0xFFFFF259;

      ipv_v_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let ipv_is_verified : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): 1 iff a bundle has been verified this boot. Labels prefixed ipv_iv_.",
      block: {
        lea r10, [rip + _ipv_verified];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let ipv_blob_ptr_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): recorded bundle pointer or 0. Labels prefixed ipv_bp_.",
      block: {
        lea r10, [rip + _ipv_blob_ptr];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let ipv_blob_len_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): recorded bundle length or 0. Labels prefixed ipv_bl_.",
      block: {
        lea r10, [rip + _ipv_blob_len];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let ipv_code_off_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): recorded code offset or 0. Labels prefixed ipv_co_.",
      block: {
        lea r10, [rip + _ipv_code_off];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let ipv_code_len_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-002 (#1348): recorded code length or 0. Labels prefixed ipv_cl_.",
      block: {
        lea r10, [rip + _ipv_code_len];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame
}
