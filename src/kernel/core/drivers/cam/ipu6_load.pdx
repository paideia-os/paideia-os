// src/kernel/core/drivers/cam/ipu6_load.pdx — R40.M1-003 (#1349)
//
// Intel IPU6 firmware LOAD SEQUENCE -- upload the code section
// admitted by ipu6_verify (#1348) via DMA into on-chip SRAM, release
// the IPU6 CPU reset via CTRL_RESET, and wait for the BOOT_READY
// notification by polling the CTRL_STATUS status bit.  Refuses the
// load unless ipu6_verify has admitted a bundle this boot.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the BYTE-MOVER + BRING-UP FSM of R40.M1.  ipu6_verify (#1348)
// answers "may we run this bundle at all?"; this module is what
// happens AFTER the refuse-gate passes: it shovels the code section
// into on-chip SRAM through a DMA seam, releases the CPU reset by
// clearing CTRL_RESET.CPU_HALT, and polls the BOOT_READY bit of
// CTRL_STATUS with a bounded wait.  Without this module the verified
// bundle is inert.
//
// IT DOES NOT PERFORM REAL DMA.  The upload is modelled as one write
// into a small synthetic register bank (§3), whose destination
// address is the code section's on-chip SRAM offset and whose value
// is a caller-verifiable digest.  A live driver replaces the write
// with a real DMA engine that shovels the section into the IPU6's
// on-chip SRAM; the substitution point is here, unchanged for the
// caller.
//
// IT DOES NOT MINT KIND_IPU6_STREAM.  The firmware descriptor a live
// load path would receive belongs to R40.M3 -- this module takes a
// caller-verified bundle out of ipu6_verify's row accessors.
//
// ipl_arbitrated() returns 0 until a later round wires the seam to
// a live IPU6 DMA engine and interrupt line.
//
// =============================================================================
// §1  CTRL REGISTER MAP (synthetic; IPU6 BSPEC names)
// =============================================================================
//
// A tiny register bank inside this module models the IPU6 control
// window.  Layout (u32 each, packed at u64 slots for alignment):
//
//   [0]  CTRL_RESET       bit 0 = CPU_HALT (asserted by hardware
//                        after power-on; the load path releases it
//                        after the code section has been staged).
//   [1]  CTRL_STATUS      bit 0 = BOOT_READY (hardware writes this
//                        once the firmware's boot handshake is
//                        complete).
//   [2]  CTRL_CHIP_REV    copy of the caller-supplied chip revision.
//   [3]  CTRL_CODE_ADDR   destination-SRAM address the code section
//                        was written to (echo of the DMA descriptor).
//   [4]  CTRL_CODE_DIGEST digest of the code section (u64 xor of the
//                        two words at offsets 0 and 8; a live driver
//                        replaces this with the DMA engine's
//                        completion status word).
//   [5]  CTRL_UPLOAD_SEQ  the load path's upload count (bumped once
//                        per successful load; a live driver replaces
//                        this with the hardware SEQ register).
//
// The BAR-relative offset a live driver would use is documented in
// the IPU6 BSPEC; the offsets here are internal and do not need to
// match the shipping ones -- ipu6_load's contract with the rest of
// the system is through ipl_load(), not through the offsets.
//
// =============================================================================
// §2  TIMEOUT BOUND
// =============================================================================
//
// A live IPU6 driver polls CTRL_STATUS.BOOT_READY with a 2 s
// timeout.  In this scaffold the wait is a bounded loop of 2 s /
// tick-quantum iterations; the iteration count is exposed as
// IPL_READY_MAX_ITERS so a witness can prove the timeout path
// without waiting a real 2 s.
//
// A load whose BOOT_READY bit is not set inside the bound returns
// IPL_READY_TIMEOUT.  On timeout the CPU is halted again (a live
// driver would re-assert CTRL_RESET.CPU_HALT so the chip does not
// execute a partially-uploaded image), the recorded bundle is left
// in place for post-mortem, and the loaded flag stays 0.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _ipl_ctrl, _ipl_loaded, _ipl_ready_iters, and _ipl_stats are
// written only by helpers in this module.  tools/build.sh confines
// relocations against each to `core/drivers/cam/ipu6_load.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF240..0xFFFFF24F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: ipu6_verify
// 0xFFFFF250..5F, R40.M1-002; adjacent free band below: 0xFFFFF230
// ..3F unused at R40.M1).

module Ipu6Load = structure {

  // §1: synthetic CTRL bank slot indices.
  pub let IPL_CTRL_RESET       : u64 = 0
  pub let IPL_CTRL_STATUS      : u64 = 1
  pub let IPL_CTRL_CHIP_REV    : u64 = 2
  pub let IPL_CTRL_CODE_ADDR   : u64 = 3
  pub let IPL_CTRL_CODE_DIGEST : u64 = 4
  pub let IPL_CTRL_UPLOAD_SEQ  : u64 = 5

  pub let IPL_RESET_CPU_HALT   : u64 = 0x1
  pub let IPL_STATUS_BOOT_READY: u64 = 0x1

  // On-chip SRAM destination address (BSPEC §3; scaffold constant --
  // live driver reads it from the firmware bundle header instead of
  // pinning here).
  pub let IPL_SRAM_CODE_BASE   : u64 = 0x200000

  // §2: bounded wait for BOOT_READY.
  pub let IPL_READY_MAX_ITERS  : u64 = 0x100000       // 2^20 iterations

  // Failure taxonomy — 0xFFFFF240..0xFFFFF24F.
  pub let IPL_OK               : u64 = 0
  pub let IPL_BAD_ARG          : u64 = 0xFFFFF24F
  pub let IPL_NOT_VERIFIED     : u64 = 0xFFFFF24E
  pub let IPL_CODE_UPLOAD_FAIL : u64 = 0xFFFFF24D
  pub let IPL_RESET_STUCK      : u64 = 0xFFFFF24C
  pub let IPL_READY_TIMEOUT    : u64 = 0xFFFFF24B
  pub let IPL_ALREADY_LOADED   : u64 = 0xFFFFF24A

  // §3: synthetic CTRL bank (6 u32-in-u64 slots) + loaded flag +
  // observed ready-wait iteration count.
  pub let mut _ipl_ctrl         : [u64; 8] = uninit @align(64)
  pub let mut _ipl_loaded       : [u64; 1] = uninit @align(64)
  pub let mut _ipl_ready_iters  : [u64; 1] = uninit @align(64)

  // Counters.
  pub let mut _ipl_stats : [u64; 8] = uninit @align(64)

  pub let IPL_ST_LOADS     : u64 = 0
  pub let IPL_ST_TIMEOUTS  : u64 = 1
  pub let IPL_ST_REFUSED   : u64 = 2

  // ==========================================================================
  // Reset.
  //
  // Clears the CTRL bank to power-on state (CPU_HALT asserted,
  // BOOT_READY clear, all other slots zero), clears the loaded flag
  // and the ready-iters counter, and zeros the stats vector.
  // ==========================================================================

  pub let ipl_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): clear CTRL bank to power-on state (CPU_HALT set), clear loaded flag, ready-iters counter, and stats. Boot and teardown. Labels prefixed ipl_rs_.",
      block: {
        lea r10, [rip + _ipl_ctrl];
        xor rax, rax;
        xor rcx, rcx;
      ipl_rs_ctrl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ipl_rs_ctrl;

        // Set CTRL_RESET.CPU_HALT (slot 0, bit 0).
        lea r10, [rip + _ipl_ctrl];
        mov rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;
        lea r10, [rip + _ipl_loaded];
        mov [r10 + 0], rax;
        lea r10, [rip + _ipl_ready_iters];
        mov [r10 + 0], rax;

        lea r10, [rip + _ipl_stats];
        xor rcx, rcx;
      ipl_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ipl_rs_stats;
        ret
      }
    } @no_frame

  pub let ipl_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-003 (#1349): honesty pin. Returns 0 until a later round wires the upload/wait seams to a live IPU6 DMA engine and interrupt line.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ipl_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): counter bump. Labels prefixed ipl_nt_.",
      block: {
        cmp rdi, 8;
        jae ipl_nt_out;
        lea r10, [rip + _ipl_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ipl_nt_out:
        ret
      }
    } @no_frame

  pub let ipl_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): counter read. Labels prefixed ipl_st_.",
      block: {
        cmp rdi, 8;
        jae ipl_st_zero;
        lea r10, [rip + _ipl_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ipl_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Synthetic CTRL accessors (witness surface).
  //
  // ipl_ctrl_read(slot)              -> u64
  // ipl_ctrl_stamp_ready()           -> ()   pre-writes CTRL_STATUS bit 0
  // ipl_ctrl_stamp_chip_rev(rev)     -> ()   pre-writes CTRL_CHIP_REV
  //
  // A witness uses stamp_ready to model the "firmware is up" edge
  // between the reset release and the BOOT_READY poll; stamp_chip_rev
  // seeds the chip id register so a future compat gate can consume
  // it through the loaded flag path.
  // ==========================================================================

  pub let ipl_ctrl_read : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): read a CTRL bank slot. Bounds-check refuses out-of-range with 0. Labels prefixed ipl_cr_.",
      block: {
        cmp rdi, 8;
        jae ipl_cr_zero;
        lea r10, [rip + _ipl_ctrl];
        mov rax, [r10 + rdi * 8];
        ret;
      ipl_cr_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let ipl_ctrl_stamp_ready : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): witness surface -- stamp CTRL_STATUS.BOOT_READY. Labels prefixed ipl_sr_.",
      block: {
        lea r10, [rip + _ipl_ctrl];
        mov rax, [r10 + 8];              // CTRL_STATUS
        or  rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    } @no_frame

  pub let ipl_ctrl_stamp_chip_rev : (u64) -> () !{mem} @{} =
    fn (rev: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): witness surface -- stamp CTRL_CHIP_REV. Labels prefixed ipl_sh_.",
      block: {
        lea r10, [rip + _ipl_ctrl];
        mov [r10 + 16], rdi;             // CTRL_CHIP_REV
        ret
      }
    } @no_frame

  pub let ipl_is_loaded : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): 1 iff IPU6 firmware has been loaded this boot. Labels prefixed ipl_il_.",
      block: {
        lea r10, [rip + _ipl_loaded];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let ipl_ready_iters_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): recorded BOOT_READY poll iteration count. Labels prefixed ipl_ri_.",
      block: {
        lea r10, [rip + _ipl_ready_iters];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  // ==========================================================================
  // ipl_load(chip_rev) -> IPL_OK | error
  //
  // §0: THE ONE ENTRY POINT for IPU6 firmware bring-up.  Order:
  //   1. Precondition: ipu6_verify has admitted a bundle this boot.
  //   2. Not-already-loaded (a re-load without a scrub is refused;
  //      an operator that wants to reload runs ipl_reset first).
  //   3. Upload code section: write section pointer to CTRL_CODE_ADDR
  //      and section digest to CTRL_CODE_DIGEST.
  //   4. Release CPU reset: clear CTRL_RESET.CPU_HALT.  Refuses
  //      RESET_STUCK if the pre-write reset bit was somehow already
  //      clear.
  //   5. Poll CTRL_STATUS.BOOT_READY with the bounded wait §2 sets.
  //      Records the observed iteration count in _ipl_ready_iters
  //      so a witness can prove the poll actually ran.  Refuses
  //      READY_TIMEOUT on expiry (also re-asserts CPU_HALT).
  //   6. Bump CTRL_UPLOAD_SEQ, stamp CTRL_CHIP_REV with caller's
  //      chip_rev, set loaded=1, bump LOADS.
  // ==========================================================================

  pub let ipl_load : (u64) -> u64 !{mem} @{} =
    fn (chip_rev: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-003 (#1349): IPU6 firmware bring-up FSM. Verifies precondition gate, uploads code section via CTRL seam, releases CPU reset, polls BOOT_READY with bounded wait, records. Labels prefixed ipl_l_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // chip_rev

        // 1. Verified.
        call ipv_is_verified;
        cmp rax, 1;
        jne ipl_l_not_verified;

        // 2. Not-already-loaded.
        lea r10, [rip + _ipl_loaded];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne ipl_l_already;

        // 3. Upload code.
        //    Compute a tiny digest = word0 XOR word1 of the code
        //    section as it lives inside the blob.
        call ipv_blob_ptr_of;
        mov r12, rax;                    // blob_ptr

        call ipv_code_off_of;
        add rax, r12;                    // blob_ptr + code_off
        mov r10, rax;
        mov rax, [r10 + 0];
        mov rcx, [r10 + 8];
        xor rax, rcx;                    // digest

        lea r10, [rip + _ipl_ctrl];
        mov rcx, 0x200000;               // IPL_SRAM_CODE_BASE
        mov [r10 + 24], rcx;             // CTRL_CODE_ADDR
        mov [r10 + 32], rax;             // CTRL_CODE_DIGEST

        // Verify echo -- catches a broken write path (a live driver
        // would compare the DMA completion status word here).
        mov rcx, [r10 + 24];
        cmp rcx, 0x200000;
        jne ipl_l_code_fail;

        // 4. Release CPU reset.  Refuses RESET_STUCK if CPU_HALT was
        //    already clear (a live driver would treat this as
        //    "someone else already released; refuse to race").
        lea r10, [rip + _ipl_ctrl];
        mov rax, [r10 + 0];              // CTRL_RESET
        mov rcx, rax;
        and rcx, 1;
        cmp rcx, 0;
        je  ipl_l_reset_stuck;
        and rax, 0xFFFFFFFFFFFFFFFE;     // clear bit 0
        mov [r10 + 0], rax;

        // 5. Poll BOOT_READY.
        xor r12, r12;                    // iteration counter
      ipl_l_poll:
        lea r10, [rip + _ipl_ctrl];
        mov rax, [r10 + 8];              // CTRL_STATUS
        mov rcx, rax;
        and rcx, 1;
        cmp rcx, 0;
        jne ipl_l_ready_seen;
        add r12, 1;
        mov r10, 0x100000;               // IPL_READY_MAX_ITERS
        cmp r12, r10;
        jb  ipl_l_poll;

        // Timeout: re-assert CPU_HALT, record iters, refuse.
        lea r10, [rip + _ipl_ctrl];
        mov rax, [r10 + 0];
        or  rax, 1;
        mov [r10 + 0], rax;
        lea r10, [rip + _ipl_ready_iters];
        mov [r10 + 0], r12;
        jmp ipl_l_timeout;

      ipl_l_ready_seen:
        lea r10, [rip + _ipl_ready_iters];
        mov [r10 + 0], r12;

        // 6. Bump upload seq, stamp chip rev, set loaded.
        lea r10, [rip + _ipl_ctrl];
        mov rax, [r10 + 40];             // CTRL_UPLOAD_SEQ
        add rax, 1;
        mov [r10 + 40], rax;

        lea r10, [rip + _ipl_ctrl];
        mov [r10 + 16], rbx;             // CTRL_CHIP_REV := chip_rev

        lea r10, [rip + _ipl_loaded];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // LOADS
        call ipl_note;
        xor rax, rax;
        jmp ipl_l_out;

      ipl_l_not_verified:
        mov rdi, 2;
        call ipl_note;
        mov rax, 0xFFFFF24E;
        jmp ipl_l_out;
      ipl_l_already:
        mov rdi, 2;
        call ipl_note;
        mov rax, 0xFFFFF24A;
        jmp ipl_l_out;
      ipl_l_code_fail:
        mov rdi, 2;
        call ipl_note;
        mov rax, 0xFFFFF24D;
        jmp ipl_l_out;
      ipl_l_reset_stuck:
        mov rdi, 2;
        call ipl_note;
        mov rax, 0xFFFFF24C;
        jmp ipl_l_out;
      ipl_l_timeout:
        mov rdi, 1;                      // TIMEOUTS
        call ipl_note;
        mov rdi, 2;
        call ipl_note;
        mov rax, 0xFFFFF24B;

      ipl_l_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
