// src/kernel/core/drivers/cam/ipu6_probe.pdx — R40.M1-001 (#1347)
//
// Intel IPU6 (Image Processing Unit, 6th gen) PCI PROBE + BAR
// mapping scaffold.  Opens R40.M1 (T14 G4 webcam bring-up via
// MIPI-CSI + IPU6 firmware blob).  Recognises the Multimedia
// Controller class code (0x04, 0x80), filters candidates by Intel
// vendor (0x8086) and the IPU6 device family (0x9A19 for Tiger Lake,
// 0x462E for Meteor / Raptor Lake), refuses a BAR0 whose extent is
// less than 8 MB or misaligned, and stages the caller-supplied
// chip-revision word so a later mint of KIND_IPU6_STREAM (R40.M3+)
// can containment-check the window without re-consulting firmware.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNISE + RECORD half of an IPU6 bring-up.  A PCIe
// function whose class/subclass triple is (0x04, 0x80, *) is a
// Multimedia / Other Multimedia Controller per the PCI SIG registry;
// filtered by Intel vendor 0x8086 and one of the IPU6 device ids,
// this scaffold distills the vendor/device pair the enumerator saw,
// validates the BAR0 window (8 MB minimum, 64 KiB aligned per the
// IPU6 BSPEC's own MMIO extent expectation), and stashes the chip
// id/revision decoded from a caller-supplied CHIP_REV word.
//
// IT DOES NOT TOUCH REAL MMIO.  The chip revision word arrives
// through the parameter list this milestone.  R40.M3 wires the seam
// to a live BAR0 read; the substitution is a one-line change here
// (the recognise entry takes a caps snapshot exactly as
// ax211_probe / iris_xe_probe do).
//
// IT DOES NOT MINT KIND_CSI_CAMERA OR KIND_IPU6_STREAM.  Those mints
// belong to the R40.M3+ bring-up path once the BAR is measured
// through a live memory authority; this scaffold records the EXTENTS
// so that mint can containment-check its request without re-asking
// the firmware.
//
// ipp_probe_arbitrated() returns 0 until R40.M3 binds a live BAR
// read against this seam.
//
// =============================================================================
// §1  PCI CLASSIFICATION (PCI SIG code registry)
// =============================================================================
//
//   base class 0x04  Multimedia Controller
//   subclass  0x80  Other Multimedia Controller  (Intel IPU cores)
//
// Class pair packed as (class << 8) | subclass = 0x0480.
//
// Vendor filter: 0x8086 (Intel).  Device ids the IPU6 family
// enumerates on shipping T14 G4 boards:
//
//   0x9A19  IPU6 (Tiger Lake integrated ISP)
//   0x462E  IPU6EP (Meteor / Raptor Lake integrated ISP)
//
// Every other device id under the Intel ISP range is REFUSED as
// BAD_FAMILY rather than optimistically accepted -- an IPU3 or an
// IPU7 uses a different firmware family and a probe that admitted
// it would ship a mismatched image the fw_verify gate would only
// catch after fw_load had already tried to move bytes.
//
// BAR0 alignment: 64 KiB minimum (the IPU6 driver expects an 8 MB
// window whose base is 64 KiB aligned; larger alignments are
// accepted, smaller are refused as MISALIGNED).
//
// BAR0 length: 8 MB minimum.  A shorter window cannot hold the ISP
// MMIO register block plus scratch SRAM the firmware handshake
// (R40.M1-003) writes into.
//
// =============================================================================
// §2  CHIP_REV LAYOUT (IPU6 BSPEC §2.1 "Chip Revision Register")
// =============================================================================
//
//   IPP_CHIP_TYPE_MASK       0x000FFF00   ("chip type" nibble)
//   IPP_CHIP_STEP_MASK       0x0000000C   ("stepping" -- A0, B0, ...)
//   IPP_CHIP_DASH_MASK       0x00000003   ("dash" revision)
//
// A caps word of zero refuses as BAD_CAPS (the caller either did
// not read the register or read it before the chip finished
// bringing up its rev block); a chip-type nibble of zero refuses as
// BAD_HW_TYPE for the same reason.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _ipp_probe_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/cam/ipu6_probe.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF260..0xFFFFF26F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: le_audio
// 0xFFFFF270..7F, R39.M6-003; adjacent free band below: ipu6_verify
// 0xFFFFF250..5F, R40.M1-002).

module Ipu6Probe = structure {

  // PCI classification (§1).
  pub let IPP_PCI_CLASS_MULTIMEDIA    : u64 = 0x04
  pub let IPP_PCI_SUBCLASS_OTHER_MM   : u64 = 0x80
  pub let IPP_PCI_CLASS_PAIR          : u64 = 0x0480

  // Accepted vendor set.
  pub let IPP_VENDOR_INTEL : u64 = 0x8086

  // Accepted device ids (§1).
  pub let IPP_DEV_9A19 : u64 = 0x9A19          // IPU6 TGL
  pub let IPP_DEV_462E : u64 = 0x462E          // IPU6EP MTL/RPL

  // BAR0 shape (§1).
  pub let IPP_BAR0_ALIGN_MASK : u64 = 0xFFFF        // 64 KiB align
  pub let IPP_BAR0_MIN_LEN    : u64 = 0x800000      // 8 MB

  // CHIP_REV decode (§2).
  pub let IPP_HW_TYPE_MASK  : u64 = 0x000FFF00
  pub let IPP_HW_TYPE_SHIFT : u64 = 8
  pub let IPP_HW_STEP_MASK  : u64 = 0x0000000C
  pub let IPP_HW_STEP_SHIFT : u64 = 2
  pub let IPP_HW_DASH_MASK  : u64 = 0x00000003

  // Failure taxonomy — 0xFFFFF260..0xFFFFF26F.
  pub let IPP_OK             : u64 = 0
  pub let IPP_BAD_ARG        : u64 = 0xFFFFF26F
  pub let IPP_BAD_CLASS      : u64 = 0xFFFFF26E
  pub let IPP_BAD_VENDOR     : u64 = 0xFFFFF26D
  pub let IPP_BAD_FAMILY     : u64 = 0xFFFFF26C
  pub let IPP_BAD_BAR0       : u64 = 0xFFFFF26B
  pub let IPP_MISALIGNED     : u64 = 0xFFFFF26A
  pub let IPP_BAD_CAPS       : u64 = 0xFFFFF269
  pub let IPP_BAD_HW_TYPE    : u64 = 0xFFFFF268

  pub let mut _ipp_probe_stats : [u64; 8] = uninit @align(64)

  pub let IPP_ST_ATTEMPTS : u64 = 0
  pub let IPP_ST_MATCHED  : u64 = 1
  pub let IPP_ST_REJECTS  : u64 = 2
  pub let IPP_ST_ALIGNED  : u64 = 3
  pub let IPP_ST_TYPE     : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let ipp_probe_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-001 (#1347): clear stats. Labels prefixed ipp_rs_.",
      block: {
        lea r10, [rip + _ipp_probe_stats];
        xor rax, rax;
        xor rcx, rcx;
      ipp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ipp_rs_loop;
        ret
      }
    }

  pub let ipp_probe_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): honesty pin. Returns 0 until R40.M3 binds this against a live PCIe IPU6 BAR window.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let ipp_probe_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-001 (#1347): counter read. Labels prefixed ipp_st_.",
      block: {
        cmp rdi, 8;
        jae ipp_st_zero;
        lea r10, [rip + _ipp_probe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ipp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ipp_probe_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-001 (#1347): counter bump. Labels prefixed ipp_nt_.",
      block: {
        cmp rdi, 8;
        jae ipp_nt_out;
        lea r10, [rip + _ipp_probe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ipp_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let ipp_class_valid : (u64) -> u64 !{} @{} =
    fn (class_pair: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): 1 iff class_pair == 0x0480 (Multimedia / Other). Labels prefixed ipp_cv_.",
      block: {
        mov r10, 0x0480;
        cmp rdi, r10;
        jne ipp_cv_no;
        mov rax, 1;
        ret;
      ipp_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ipp_vendor_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): 1 iff v == 0x8086 Intel. Labels prefixed ipp_vv_.",
      block: {
        cmp rdi, 0x8086;
        je  ipp_vv_yes;
        xor rax, rax;
        ret;
      ipp_vv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let ipp_family_valid : (u64) -> u64 !{} @{} =
    fn (device_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): 1 iff device_id in {0x9A19, 0x462E}. Labels prefixed ipp_fv_.",
      block: {
        cmp rdi, 0x9A19;
        je  ipp_fv_yes;
        cmp rdi, 0x462E;
        je  ipp_fv_yes;
        xor rax, rax;
        ret;
      ipp_fv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let ipp_bar0_aligned : (u64) -> u64 !{} @{} =
    fn (bar_base: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): 1 iff (bar_base & 0xFFFF) == 0 (64 KiB alignment). Labels prefixed ipp_ba_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        cmp rax, 0;
        jne ipp_ba_no;
        mov rax, 1;
        ret;
      ipp_ba_no:
        xor rax, rax;
        ret
      }
    }

  pub let ipp_bar0_len_ok : (u64) -> u64 !{} @{} =
    fn (bar_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): 1 iff bar_len >= 8 MB. Labels prefixed ipp_bl_.",
      block: {
        mov r10, 0x800000;
        cmp rdi, r10;
        jb  ipp_bl_no;
        mov rax, 1;
        ret;
      ipp_bl_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Decode CHIP_REV (§2).
  // ==========================================================================

  pub let ipp_decode_hw_type : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): extract chip-type nibble (caps[19:8]) shifted right. Labels prefixed ipp_dt_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFF;
        ret
      }
    }

  pub let ipp_decode_hw_step : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): extract stepping bits (caps[3:2]). Labels prefixed ipp_ds_.",
      block: {
        mov rax, rdi;
        shr rax, 2;
        and rax, 0x3;
        ret
      }
    }

  pub let ipp_decode_hw_dash : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M1-001 (#1347): extract dash bits (caps[1:0]). Labels prefixed ipp_dd_.",
      block: {
        mov rax, rdi;
        and rax, 0x3;
        ret
      }
    }

  // ==========================================================================
  // ipp_probe_recognise(class_pair, vendor, device_id, bar0_base,
  //                     bar0_len, caps)
  //   -> hw_type[15:0] | (step << 16) | (dash << 24) | err
  //
  // Six-arg entry, calling convention identical to axp_probe_recognise
  // (three integer args pass in registers, three stashed to callee-save
  // through rbp).  Sequence:
  //   1. class pair == 0x0480
  //   2. vendor in accepted set
  //   3. device id in accepted family set
  //   4. bar0_base > 0, bar0_len >= 8 MB
  //   5. bar0_base 64 KiB aligned
  //   6. caps non-zero
  //   7. chip type non-zero
  //
  // Every accepted probe bumps MATCHED + ALIGNED + TYPE.  Every
  // refusal bumps REJECTS.
  // ==========================================================================

  pub let ipp_probe_recognise : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (class_pair: u64) (vendor: u64) (device_id: u64) (bar0_base: u64) (bar0_len: u64) (caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M1-001 (#1347): recognise an Intel IPU6 image processor. Six args stashed to five callee-save regs plus rbp. Sequence per header. Returns hw_type | (step << 16) | (dash << 24). Labels prefixed ipp_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // class_pair
        mov r12, rsi;                    // vendor
        mov r13, rdx;                    // device_id
        mov r14, rcx;                    // bar0_base
        mov r15, r8;                     // bar0_len
        mov rbp, r9;                     // caps

        mov rdi, 0;                      // ATTEMPTS
        call ipp_probe_note;

        // 1. class pair.
        mov rdi, rbx;
        call ipp_class_valid;
        cmp rax, 0;
        je  ipp_rc_bad_class;

        // 2. vendor.
        mov rdi, r12;
        call ipp_vendor_valid;
        cmp rax, 0;
        je  ipp_rc_bad_vendor;

        // 3. device family.
        mov rdi, r13;
        call ipp_family_valid;
        cmp rax, 0;
        je  ipp_rc_bad_family;

        // 4. BAR0 base + length.
        cmp r14, 0;
        je  ipp_rc_bad_bar0;
        mov rdi, r15;
        call ipp_bar0_len_ok;
        cmp rax, 0;
        je  ipp_rc_bad_bar0;

        // 5. Alignment.
        mov rdi, r14;
        call ipp_bar0_aligned;
        cmp rax, 0;
        je  ipp_rc_misaligned;
        mov rdi, 3;                      // ALIGNED
        call ipp_probe_note;

        // 6. caps non-zero.
        cmp rbp, 0;
        je  ipp_rc_bad_caps;

        // 7. hw type non-zero.
        mov rdi, rbp;
        call ipp_decode_hw_type;
        cmp rax, 0;
        je  ipp_rc_bad_hw_type;
        mov rbx, rax;                    // hw_type (stashed)
        mov rdi, 4;                      // TYPE
        call ipp_probe_note;

        // Decode step + dash for packing.
        mov rdi, rbp;
        call ipp_decode_hw_step;
        mov r12, rax;                    // step

        mov rdi, rbp;
        call ipp_decode_hw_dash;
        mov r13, rax;                    // dash

        // MATCHED.
        mov rdi, 1;
        call ipp_probe_note;

        // Pack hw_type | (step << 16) | (dash << 24).
        mov rax, rbx;
        and rax, 0xFFFF;
        mov r10, r12;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, r13;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        jmp ipp_rc_out;

      ipp_rc_bad_class:
        mov rdi, 2;
        call ipp_probe_note;
        mov rax, 0xFFFFF26E;
        jmp ipp_rc_out;
      ipp_rc_bad_vendor:
        mov rdi, 2;
        call ipp_probe_note;
        mov rax, 0xFFFFF26D;
        jmp ipp_rc_out;
      ipp_rc_bad_family:
        mov rdi, 2;
        call ipp_probe_note;
        mov rax, 0xFFFFF26C;
        jmp ipp_rc_out;
      ipp_rc_bad_bar0:
        mov rdi, 2;
        call ipp_probe_note;
        mov rax, 0xFFFFF26B;
        jmp ipp_rc_out;
      ipp_rc_misaligned:
        mov rdi, 2;
        call ipp_probe_note;
        mov rax, 0xFFFFF26A;
        jmp ipp_rc_out;
      ipp_rc_bad_caps:
        mov rdi, 2;
        call ipp_probe_note;
        mov rax, 0xFFFFF269;
        jmp ipp_rc_out;
      ipp_rc_bad_hw_type:
        mov rdi, 2;
        call ipp_probe_note;
        mov rax, 0xFFFFF268;

      ipp_rc_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
