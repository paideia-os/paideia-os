// src/kernel/core/drivers/i2c/synaptics.pdx -- Wave 77 D14 [R32]
// paideia-os#2531
//
// Synaptics Precision Touchpad (PTP) gesture driver SKELETON --
// consumes HID input reports from the Wave 76 D13 I2C-HID transport
// (`drivers/i2c/i2c_hid.pdx`) and decodes them into gesture primitives
// (tap, double-tap, two-finger-scroll, three-finger-swipe, pinch).
//
// Modern Synaptics touchpads (post-2015, Windows Precision Touchpad
// certification) emit a HID collection whose Report ID 0x05 carries a
// fixed 24-byte top-level input report: {report_id, contact_count,
// 5 x contact_entry, scan_time}.  Each contact_entry packs
// {tip_switch 1b, in_range 1b, contact_id 4b, x 12b, y 12b} into 4
// bytes little-endian.  The follow-up slice walks the report-byte
// array and populates a running fingertip-track table; this skeleton
// records the SHAPE of that walk (what entrypoints exist, what state
// is caught, what the klog wire sees) without pulling in the arithmetic
// of the per-finger geometry filter yet.
//
// Every entrypoint is a STRUCTURAL STUB -- it emits a klog witness
// recording what it was called with, records a bounded fragment of
// the arguments into module-local state so a follow-up slice can
// stitch the real body in without reshaping the ABI, and returns
// either OK or the matching failure code from the task-directive-
// reserved 0xFFFFFEE5..E9 band.  The real body is deferred for the
// same reason i2c_hid's stubs defer their work: the lpss_i2c
// transfer state machine (`dw_xfer.pdx`) is not yet reachable through
// a KIND_I2C_SLAVE capability, so `i2c_hid_read_input_report` itself
// returns I2C_HID_OK against an empty scratch at Wave 76/77.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND IS DELIBERATELY NOT
// =============================================================================
//
// It IS the gesture-decode layer above the Wave 76 D13 I2C-HID
// transport.  It owns:
//
//   * the 24-byte Precision Touchpad input-report decode,
//   * the 5-slot contact table (per-finger {tip_switch, in_range,
//     contact_id, x, y}),
//   * the single-tap + two-finger-scroll detector,
//   * the GESTURE_* code domain the shell / event-plane consumes.
//
// It IS NOT the HID transport, which lives in `i2c_hid.pdx` --
// `i2c_hid_read_input_report(report_id)` fetches a 24-byte input
// report and the follow-up slice copies it into _syn_ptp_report
// before decoding.
//
// It IS NOT the pointer-event broadcast substrate.  A Wave 78+ slice
// mints a KIND_POINTER_SINK that this driver POSTS a decoded
// {dx, dy, buttons, gesture} record into; at Wave 77 skeleton stage
// that sink does not exist and the decoded gesture is retrievable
// only via `synaptics_get_gesture()` as a module-wide last-value
// read.
//
// It IS NOT the mint path.  `cap_handler_synaptics` is query-only at
// Wave 77 D14 -- the mint of a KIND_SYNAPTICS cap from a scan hit
// rides supervisor callers above the cap_invoke syscall ABI.
//
// =============================================================================
// SECTION 1  PTP INPUT REPORT LAYOUT (24 bytes, little-endian)
// =============================================================================
//
// Per Microsoft Precision Touchpad specification v1.0 (Windows HID
// specification, PTP collection) + Synaptics vendor supplement:
//
//   offset  width  field
//   ------  -----  -------------------------------------------------
//   0x00    u8     report_id            (always 0x05 for PTP top-level)
//   0x01    u8     contact_count        (1..5 valid; 0 = release)
//   0x02    4 B    contact[0]           see below
//   0x06    4 B    contact[1]
//   0x0A    4 B    contact[2]
//   0x0E    4 B    contact[3]
//   0x12    4 B    contact[4]
//   0x16    u8     scan_time            (100 us ticks, saturating)
//   0x17    u8     reserved             (set to 0 by firmware)
//
// Each 4-byte contact_entry packs little-endian:
//
//   bits [31:20]  y          (12-bit, 0..4095 panel-pixel space)
//   bits [19:8]   x          (12-bit, 0..4095 panel-pixel space)
//   bits [7:4]    contact_id (4-bit, 0..15; stable across frames)
//   bit  [1]      in_range   (finger over panel, not necessarily down)
//   bit  [0]      tip_switch (finger pressing panel)
//
// A compact 32-bit view with tip_switch at bit 0 lets the real body
// mask + shift via `(entry >> 20) & 0xFFF` for y, `(entry >> 8) &
// 0xFFF` for x, `(entry >> 4) & 0x0F` for contact_id, with a single
// 24-bit constant staged through r11 (0xFFFF00) for x+y combined.
// At skeleton level the walk is deferred.
//
// All multi-byte fields are little-endian.  The real body composes
// u16 reads via `(hi << 8) | lo` using `shl r, 8` + `or r, lo` so
// no `and r11, imm64` is needed (pdx-encoder pitfall).
//
// =============================================================================
// SECTION 2  GESTURE DECODER (bounded, skeleton)
// =============================================================================
//
// The gesture decoder consumes the sequence of PTP reports:
//
//   history[t-N..t] = [report_t-N, ..., report_t]
//
// and classifies each incoming frame against a bounded fingertip-
// track table.  At skeleton level only TWO gestures are implemented:
//
//   TAP (GESTURE_TAP = 1):
//     - contact_count transitions 1 -> 0 within 150 ms (1500 x 100 us
//       ticks), AND
//     - the fingertip Euclidean displacement during that window is
//       < 5 mm (= 100 panel units at 20 units/mm, within the Synaptics
//       small-displacement threshold).
//
//   TWO-FINGER SCROLL (GESTURE_SCROLL = 3):
//     - contact_count held at 2 across the window, AND
//     - both fingertips moved in the SAME DIRECTION by >10 mm
//       (= 200 panel units) along the Y axis (vertical scroll),
//     - OR along the X axis (horizontal scroll).  The sign of the
//       cumulative Y delta (or X delta) selects scroll-up vs scroll-
//       down (or scroll-left vs scroll-right); the sign is NOT
//       surfaced through synaptics_get_gesture's return value at
//       skeleton stage -- the follow-up slice adds a `_syn_last_dy`
//       / `_syn_last_dx` pair.
//
// The following gestures are DECLARED but not implemented at
// skeleton stage:
//
//   GESTURE_DOUBLE_TAP = 2  two TAPs within 300 ms of each other
//   GESTURE_SWIPE_3F   = 4  contact_count held at 3, cumulative
//                           Y displacement > 15 mm (navigation gesture)
//   GESTURE_PINCH      = 5  contact_count held at 2, PAIR distance
//                           grew or shrank by > 25% from initial frame
//
// At skeleton level every poll leaves `_syn_last_gesture` at
// GESTURE_NONE (0) regardless of the empty 24-byte buffer.  A
// follow-up slice lands the real walk; this file documents the
// GESTURE_* code domain so the pointer-event broadcast substrate
// (Wave 78+) can be minted against a stable ordinal set.
//
// =============================================================================
// SECTION 3  DISPATCH SLOT -- KIND_SYNAPTICS = 0x47
// =============================================================================
//
// Wave 77 populates 0x46..0x48 as the three parallel-landing driver
// kinds above the Wave 76 KIND_I2C_HID_DRV (0x45) terminator:
//
//   0x45 KIND_I2C_HID_DRV    (Wave 76 D13, drivers/i2c/i2c_hid.pdx)
//   0x46 (parallel landing, G7)
//   0x47 KIND_SYNAPTICS      (THIS FILE, Wave 77 D14)
//   0x48 (parallel landing, D15)
//
// Audit at landing time (grep over `src/kernel/core/cap/` +
// `src/kernel/core/drivers/`):
//
//   $ grep -nE 'cmp rcx, 0x47\b|mov r9, 0x47\b' \
//         src/kernel/core/cap/invoke.pdx
//   (empty)
//   $ grep -rnE 'KIND_SYNAPTICS\b' src/kernel/
//   (empty)
//
// 0x46 and 0x48 are dispatched in parallel by sibling Wave 77
// softarch landings; this file takes 0x47 to preserve adjacency
// across the three-wave run.  0x47 fits imm32 with bit 31 clear so
// the dispatch arm uses `cmp rcx, 0x47` directly (no r9 staging).
//
// =============================================================================
// SECTION 4  DERIVATION POSTURE
// =============================================================================
//
// KIND_SYNAPTICS derives over KIND_I2C_HID_DRV (0x45): one touchpad
// instance names exactly one I2C-HID transport binding, and the
// gesture decoder cannot operate without the underlying report
// stream.  Same two-layer derivation shape every HID-class driver in
// this cap-table uses (keyboard, touchscreen, pen will mint parallel
// kinds over 0x45 in follow-up waves).
//
// The dispatch arm in `cap/invoke.pdx` compares the FULL u64 kind
// field, so the slot-10 KIND_DEVICE handler and this kind coexist
// cleanly with KIND_I2C_HID_DRV (same fall-through-safe pattern
// every derived kind in that file uses).
//
// target_ptr encoding (follow-up slice): the hid_cap passed to
// `synaptics_init` is itself a KIND_I2C_HID_DRV cap descriptor
// pointer; follow-up slice decodes it to recover (bus_slot, i2c_addr)
// via the row-indirection the Wave 76 i2c_hid follow-up adds.  At
// skeleton stage target_ptr is passed through to the query dispatch
// without decoding -- the dispatch is query-only and reads the
// single module-wide last-polled state (last_contact_count /
// last_gesture / last_hid_cap) rather than a per-device row.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY 0xFFFFFEE5..E9 (TASK-DIRECTIVE RESERVED)
// =============================================================================
//
// Five codes per the Wave 77 D14 task directive.  Each is a 32-bit
// value with bit 31 set (sentinel-band shape); emitting
// `mov eax, 0xFFFFFEE5` zero-extends into rax as the paideia-as
// encoder's standard 5-byte form for a 32-bit immediate.  No
// collision with the standard cap_invoke sentinels
// (0xFFFFFFFFFFFFFFFC..FE) because the two live in disjoint bands
// and the module always returns the 32-bit form (upper half zero).
//
//   SYN_ERR_HID_CAP_BAD    = 0xFFFFFEE5  -- hid_cap == 0 or does not
//                                           match the last-attached cap
//   SYN_ERR_REPORT_MALF    = 0xFFFFFEE6  -- i2c_hid_read_input_report
//                                           returned nonzero or the
//                                           report_id byte != 0x05
//   SYN_ERR_CONTACT_OOB    = 0xFFFFFEE7  -- contact_count > 5 (spec
//                                           bound; firmware bug or
//                                           desync)
//   SYN_ERR_NO_GESTURE_YET = 0xFFFFFEE8  -- synaptics_get_gesture
//                                           called before any poll
//                                           has run (inited == 0)
//   SYN_ERR_RESET_FAILED   = 0xFFFFFEE9  -- the HID RESET command
//                                           (via i2c_hid_reset) was
//                                           refused
//
// Module-local collision policy per cap/kind_op_region.pdx §4:
// these codes never leave the synaptics surface, so collision with
// the standard cap_invoke sentinels (0xFFFFFFFFFFFFFFFC..FE) is
// observable only when a caller does a cast that this module
// explicitly does not perform.  Every entrypoint returns a u32-
// shaped value; a caller zero-extends via `mov eax, eax` before
// comparing against a 64-bit sentinel.
//
// =============================================================================
// SECTION 6  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag 0x47 and all five error sentinels emit as `mov eax,
// imm32`.  No `test rN,rN` anywhere (liveness checks use
// `cmp rN, 0`).  No `and r11, imm64`; the two masked compares
// (op_code & 0xFF, hid_cap_lo & 0xFF) stage through r10 as an imm32
// (0xFF fits imm8 for `and r/m64, imm8` sign-extended; 0xFFF for
// 12-bit extracts stages through r11 as `mov r11, 0xFFF`).  No
// 2-op `imul r,imm`; the per-contact-row stride multiply uses
// `shl 2` (stride 4 is a power of two).  All `pub let` string
// declarations are on single lines.  Module basename `Synaptics`
// matches the file basename `synaptics.pdx`.  Every label is
// prefixed `syn_` (reserved-word discipline -- `loop` / `if` /
// `let` are keywords).  Fingerprint tag sizes equal literal
// length + 1 (null terminator) exactly.
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage.  The file
// compiles alongside the kernel because tools/build.sh recurses
// through src/kernel/core/drivers/i2c/ with a single `find`
// (tools/build.sh:574), so a new .pdx in that directory is picked
// up automatically; no build.sh edit required.
//
// invoke.pdx gets ONE new dispatch arm (0x47 -> cap_handler_synaptics)
// alongside this file; the arm sits between the Wave 77 G7 (0x46)
// and the Wave 77 D15 (likely 0x48) arms added in parallel.
//
// A follow-up slice adds a boot-witness programme at
// tests/kernel/drivers/wit_synaptics_poll.pdx that:
//   (1) i2c_hid_probe(bus=0, addr=0x15, hid_desc_offset=0x0020);
//   (2) synaptics_init(hid_cap=<cap from i2c_hid probe>);
//   (3) synaptics_poll_report();
//   (4) synaptics_get_gesture();
//   (5) synaptics_tp_reset(hid_cap);
// and asserts the two fingerprints land on the klog wire plus
// the four counter getters report (1, 1, 1, 1).

module Synaptics = structure {

  // ==========================================================================
  // §A  KIND / rights
  // ==========================================================================

  pub let KIND_SYNAPTICS      : u64 = 0x47    // Wave 77 D14 derived-kind tag
  pub let KIND_SYNAPTICS_BASE : u64 = 10      // = KIND_DEVICE (derived further over KIND_I2C_HID_DRV at the authority layer)

  pub let R_SYN_READ   : u64 = 0x001         // query ops (get_gesture, counters)
  pub let R_SYN_WRITE  : u64 = 0x002         // poll + reset
  pub let R_SYN_ALL    : u64 = 0x003         // handed to the holder on create

  // ==========================================================================
  // §B  PTP Input Report field offsets (section 1 above)
  // ==========================================================================

  pub let SYN_OFF_REPORT_ID       : u64 = 0x00
  pub let SYN_OFF_CONTACT_COUNT   : u64 = 0x01
  pub let SYN_OFF_CONTACT_0       : u64 = 0x02
  pub let SYN_OFF_CONTACT_1       : u64 = 0x06
  pub let SYN_OFF_CONTACT_2       : u64 = 0x0A
  pub let SYN_OFF_CONTACT_3       : u64 = 0x0E
  pub let SYN_OFF_CONTACT_4       : u64 = 0x12
  pub let SYN_OFF_SCAN_TIME       : u64 = 0x16

  pub let SYN_PTP_REPORT_ID       : u64 = 0x05    // the only PTP top-level report id
  pub let SYN_REPORT_BYTES        : u64 = 24      // fixed 24-byte PTP input report
  pub let SYN_MAX_CONTACTS        : u64 = 5       // spec upper bound
  pub let SYN_CONTACT_STRIDE      : u64 = 4       // bytes per contact entry

  // ==========================================================================
  // §C  Gesture code domain (SECTION 2 above)
  // ==========================================================================

  pub let GESTURE_NONE        : u64 = 0
  pub let GESTURE_TAP         : u64 = 1
  pub let GESTURE_DOUBLE_TAP  : u64 = 2
  pub let GESTURE_SCROLL      : u64 = 3
  pub let GESTURE_SWIPE_3F    : u64 = 4
  pub let GESTURE_PINCH       : u64 = 5

  // Decoder thresholds (follow-up slice consumes these).
  pub let SYN_TAP_WINDOW_TICKS    : u64 = 1500   // 150 ms at 100 us/tick
  pub let SYN_TAP_MAX_DELTA_UNITS : u64 = 100    // ~5 mm at 20 u/mm
  pub let SYN_SCROLL_MIN_DELTA    : u64 = 200    // ~10 mm at 20 u/mm
  pub let SYN_SWIPE_MIN_DELTA     : u64 = 300    // ~15 mm at 20 u/mm
  pub let SYN_PINCH_RATIO_PCT     : u64 = 25     // 25% change in pair distance

  // ==========================================================================
  // §D  Failure codes (SECTION 5 above)
  // ==========================================================================

  pub let SYN_TP_OK                      : u64 = 0
  pub let SYN_ERR_HID_CAP_BAD         : u64 = 0xFFFFFEE5
  pub let SYN_ERR_REPORT_MALF         : u64 = 0xFFFFFEE6
  pub let SYN_ERR_CONTACT_OOB         : u64 = 0xFFFFFEE7
  pub let SYN_ERR_NO_GESTURE_YET      : u64 = 0xFFFFFEE8
  pub let SYN_ERR_RESET_FAILED        : u64 = 0xFFFFFEE9

  // Standard cap_invoke sentinels (full 64-bit).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // ==========================================================================
  // §E  cap_handler_synaptics op ordinals (query-only at Wave 77 D14)
  // ==========================================================================

  pub let SYN_OP_QUERY_LAST_GESTURE   : u64 = 0   // -> last decoded gesture
  pub let SYN_OP_QUERY_CONTACT_COUNT  : u64 = 1   // -> last contact_count seen
  pub let SYN_OP_QUERY_LAST_HID_CAP   : u64 = 2   // -> last attached hid_cap
  pub let SYN_OP_QUERY_INITED         : u64 = 3   // -> 1 if init has run, 0 otherwise
  pub let SYN_OP_MAX                  : u64 = 3

  // ==========================================================================
  // §F  Module-local state
  //
  // _syn_ptp_report      -- 24-byte PTP input-report scratch (fixed size).
  // _syn_contact_x       -- 5-slot per-finger X cache (12-bit values widened to u64).
  // _syn_contact_y       -- 5-slot per-finger Y cache (12-bit values widened to u64).
  // _syn_contact_id      -- 5-slot per-finger contact_id cache (4-bit widened).
  // The scalars below cache the last decode's top-of-report scalars
  // and the running counters.  All counters are single u64 to match
  // the i2c_hid / fan / hotplug witness discipline (one bump per
  // successful entry).
  // ==========================================================================

  pub let mut _syn_ptp_report      : [u8;  32]   = uninit @align(32)
  pub let mut _syn_contact_x       : [u64; 5]    = uninit @align(64)
  pub let mut _syn_contact_y       : [u64; 5]    = uninit @align(64)
  pub let mut _syn_contact_id      : [u64; 5]    = uninit @align(64)

  pub let mut _syn_last_hid_cap    : u64 = 0
  pub let mut _syn_last_contact_ct : u64 = 0
  pub let mut _syn_last_x0         : u64 = 0
  pub let mut _syn_last_y0         : u64 = 0
  pub let mut _syn_last_gesture    : u64 = 0
  pub let mut _syn_last_scan_time  : u64 = 0
  pub let mut _syn_inited          : u64 = 0

  // Per-entrypoint stats, bumped once per successful entry.
  pub let mut _syn_init_ct         : u64 = 0
  pub let mut _syn_poll_ct         : u64 = 0
  pub let mut _syn_gesture_ct      : u64 = 0
  pub let mut _syn_reset_ct        : u64 = 0

  // ==========================================================================
  // §G  Fingerprint tags + keys
  //
  // On the wire:
  //   SYNAPTICS CONTACTS n=<dec> x0=<dec> y0=<dec>
  //   SYNAPTICS GESTURE id=<dec>
  //
  // The CONTACTS emission uses `klog_s1_d3` -- three decimal KVs
  // (n, x0, y0) directly matches the directive-specified shape.
  // Caller stack recipe: `sub rsp, 32; mov [rsp+0], x0; mov
  // [rsp+8], k_y0; mov [rsp+16], y0; call klog_s1_d3` (the wrapper
  // reads v2/k3/v3 from [rbp+16]/+24/+32 after its own push rbp;
  // from the CALLER view before the CALL instruction those map to
  // [rsp+0]/+8/+16 -- the Wave 73 I7 pitfall was writing v2 to the
  // caller's [rsp+8] slot, which the wrapper then reads as k3 and
  // the fingerprint lands with a pointer in the n-slot).
  //
  // The GESTURE emission uses `klog_s1_d1` (single decimal KV);
  // no stack args.  Its on-wire shape matches the golden exactly.
  //
  // Matches tests/fingerprints/synaptics.golden.
  // ==========================================================================

  pub let syn_tag_contacts : [u8; 19] = "SYNAPTICS CONTACTS\0"
  pub let syn_tag_gesture  : [u8; 18] = "SYNAPTICS GESTURE\0"

  pub let syn_tag_handler_entry : [u8; 27] = "KIND_SYNAPTICS dispatch iv\0"

  pub let syn_k_n     : [u8; 2] = "n\0"
  pub let syn_k_x0    : [u8; 3] = "x0\0"
  pub let syn_k_y0    : [u8; 3] = "y0\0"
  pub let syn_k_id    : [u8; 3] = "id\0"

  // ==========================================================================
  // §H  synaptics_module_reset() -> ()  (defensive clear; NOT HID RESET)
  //
  // Clear the 32-byte PTP report scratch (24 used, 8 pad), the 3 x
  // 5-slot contact arrays (120 bytes), the seven scalar cache slots,
  // and the four counters.  Called defensively at boot before the
  // first poll.  .bss zero-init at real boot already satisfies the
  // postcondition; this is defensive (matches firmware_blob_table_
  // reset / i2c_hid_module_reset / iris_xe_hotplug_reset shape).
  //
  // Name is `_module_reset` so the task-directive-mandated
  // `synaptics_tp_reset(hid_cap)` entrypoint (which issues the HID RESET
  // via `i2c_hid_reset`) does not shadow it.
  // ==========================================================================
  pub let synaptics_module_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): defensive clear of _syn_ptp_report (32 B), _syn_contact_x/_y/_id (3 x 5 u64 = 120 B), the seven scalar cache slots, and the four entry counters. .bss zero-init at real boot already satisfies the postcondition; this is defensive, matching i2c_hid_module_reset shape. Named `_module_reset` so the ABI-mandated `synaptics_tp_reset(hid_cap)` (which issues the HID RESET) does not shadow it. Labels prefixed syn_mr_.",
      block: {
        lea r10, [rip + _syn_ptp_report];
        xor rax, rax;
        xor rcx, rcx;
      syn_mr_report:
        mov [r10 + rcx], al;
        add rcx, 1;
        cmp rcx, 32;
        jb  syn_mr_report;

        lea r10, [rip + _syn_contact_x];
        xor rcx, rcx;
      syn_mr_cx:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 5;
        jb  syn_mr_cx;

        lea r10, [rip + _syn_contact_y];
        xor rcx, rcx;
      syn_mr_cy:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 5;
        jb  syn_mr_cy;

        lea r10, [rip + _syn_contact_id];
        xor rcx, rcx;
      syn_mr_cid:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 5;
        jb  syn_mr_cid;

        mov [rip + _syn_last_hid_cap],    rax;
        mov [rip + _syn_last_contact_ct], rax;
        mov [rip + _syn_last_x0],         rax;
        mov [rip + _syn_last_y0],         rax;
        mov [rip + _syn_last_gesture],    rax;
        mov [rip + _syn_last_scan_time],  rax;
        mov [rip + _syn_inited],          rax;

        mov [rip + _syn_init_ct],         rax;
        mov [rip + _syn_poll_ct],         rax;
        mov [rip + _syn_gesture_ct],      rax;
        mov [rip + _syn_reset_ct],        rax;
        ret
      }
    }

  // ==========================================================================
  // §I  synaptics_init(hid_cap: u64) -> u64
  //
  // Attach to an I2C-HID handle (`KIND_I2C_HID_DRV` cap) produced by
  // `i2c_hid_probe`.  Caches the cap for subsequent polls and marks
  // the module inited.
  //
  // The real body:
  //   (1) Decodes hid_cap into (bus_slot, i2c_addr) via the
  //       KIND_I2C_HID_DRV row table (Wave 76 follow-up slice).
  //   (2) Calls i2c_hid_read_report_descriptor to confirm the device
  //       descriptor advertises Report ID 0x05 (the PTP collection).
  //   (3) Calls i2c_hid_reset to put the touchpad into a known state.
  //
  // The skeleton bypasses (1)-(3) and records only hid_cap +
  // inited=1.  Gate: hid_cap == 0 -> SYN_ERR_HID_CAP_BAD.
  //
  // No fingerprint at init -- init runs once per boot and the
  // interesting wire witness is the CONTACTS line that poll emits.
  // (Same discipline iris_xe_hotplug_init / fan_init follow.)
  //
  // SysV: rdi = hid_cap.
  // Register plan: rbx = hid_cap.  One push lands rsp%16==0 at any
  // nested call (none at skeleton stage).  Labels prefixed syn_in_.
  // ==========================================================================
  pub let synaptics_init : (u64) -> u64 !{mem} @{boot, cap} =
    fn (hid_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {boot, cap},
      justification: "Wave 77 D14 (paideia-os#2531) skeleton: gate hid_cap != 0, cache _syn_last_hid_cap, stamp _syn_inited=1, bump _syn_init_ct, return SYN_TP_OK. Real body decodes hid_cap to (bus_slot, i2c_addr) via the KIND_I2C_HID_DRV row table (Wave 76 follow-up), confirms the device advertises Report ID 0x05, and issues the HID RESET; all deferred because the KIND_I2C_HID_DRV row table does not exist at Wave 77 and i2c_hid_* skeleton stubs do not perform real transfers. No fingerprint (init runs once per boot; the interesting witness is poll's CONTACTS line). Register plan: one push rbx leaves rsp%16==0. Labels prefixed syn_in_.",
      block: {
        push rbx;

        mov rbx, rdi;                        // hid_cap

        // --- Gate: hid_cap == 0 -> bad.
        cmp rbx, 0;
        je  syn_in_bad;

        // --- Record state: last_hid_cap, inited=1.
        mov [rip + _syn_last_hid_cap], rbx;
        mov rax, 1;
        mov [rip + _syn_inited],       rax;

        // --- Bump init counter.
        mov rax, [rip + _syn_init_ct];
        add rax, 1;
        mov [rip + _syn_init_ct], rax;

        xor rax, rax;                        // SYN_TP_OK
        jmp syn_in_out;

      syn_in_bad:
        mov rax, 0xFFFFFEE5;                 // SYN_ERR_HID_CAP_BAD

      syn_in_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  synaptics_poll_report() -> u64
  //
  // Reads one 24-byte PTP input report from the attached I2C-HID
  // transport (via `i2c_hid_read_input_report(SYN_PTP_REPORT_ID)`)
  // and decodes it:
  //
  //   (1) Validate report[0] == 0x05 (PTP top-level).
  //   (2) Validate report[1] <= 5 (contact_count bound).
  //   (3) For i in 0..contact_count:
  //         entry = u32_le(report + 2 + i*4)
  //         tip_switch = entry & 1
  //         contact_id = (entry >> 4) & 0x0F
  //         x          = (entry >> 8) & 0xFFF
  //         y          = (entry >> 20) & 0xFFF
  //         _syn_contact_{x,y,id}[i] = {x, y, contact_id}
  //   (4) Update _syn_last_contact_ct, _syn_last_x0, _syn_last_y0.
  //   (5) Run the gesture classifier (SECTION 2) over the delta
  //       against the previous frame; stamp _syn_last_gesture.
  //
  // At skeleton level steps (1)-(5) are deferred.  The skeleton:
  //   (a) Gates on _syn_inited != 0 (SYN_ERR_HID_CAP_BAD if not).
  //   (b) Zeros the 24-byte scratch (defensive; the real body
  //       overwrites it with i2c_hid_read_input_report's output).
  //   (c) Stamps _syn_last_contact_ct = 0 (no decode).
  //   (d) Stamps _syn_last_gesture = GESTURE_NONE (0).
  //   (e) Emits `SYNAPTICS CONTACTS n=0 x0=0 y0=0` via klog_s1_d3.
  //   (f) Bumps _syn_poll_ct.
  //   (g) Returns SYN_TP_OK.
  //
  // Gates in order:
  //   (1) _syn_inited == 0                  -> SYN_ERR_HID_CAP_BAD
  //
  // (The real body also surfaces SYN_ERR_REPORT_MALF on bad
  // report_id and SYN_ERR_CONTACT_OOB on contact_count > 5; neither
  // reached at skeleton stage because the scratch is all zero and
  // the gates do not fire against an empty buffer.)
  //
  // SysV: no args.
  // Register plan: three callee-save pushes (rbx, r12, r13) land
  // rsp%16==0; klog_s1_d3 7th/8th/9th args ride caller stack at
  // [rsp+0]/+8/+16 (v2=x0, k3=k_y0, v3=y0 -- the Wave 73 I7 trap
  // was writing v2 to [rsp+8] from the caller view, which the
  // wrapper then reads as the k3 slot and the fingerprint matches
  // on garbage).  Labels prefixed syn_po_.
  // ==========================================================================
  pub let synaptics_poll_report : () -> u64 !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 77 D14 (paideia-os#2531) skeleton: gate on _syn_inited, stamp zero contact-count / zero last_gesture, emit `SYNAPTICS CONTACTS n=0 x0=0 y0=0` via klog_s1_d3, bump _syn_poll_ct, return SYN_TP_OK. Real body reads a 24-byte PTP report via i2c_hid_read_input_report(SYN_PTP_REPORT_ID), decodes report[0]==0x05 + report[1]<=5 + per-contact {tip,id,x,y} via 12-bit extracts staged through r11 (`mov r11, 0xFFF`), stamps the running contact table, and runs the TAP + SCROLL classifier (SECTION 2). All deferred because i2c_hid_read_input_report stops at the gate check at Wave 76 D13. klog_s1_d3 caller stack recipe: three callee-save pushes land rsp%16==0; `sub rsp, 32; mov [rsp+0], x0; mov [rsp+8], k_y0; mov [rsp+16], y0` places v2/k3/v3 at caller [rsp+0]/+8/+16 which the wrapper reads from [rbp+16]/+24/+32 after its own push rbp -- the Wave 73 I7 pitfall was writing v2 to [rsp+8] from the caller view (one slot too high). Register plan: rbx = scratch for last_contact_ct (unused at skeleton), r12 = x0, r13 = y0. Labels prefixed syn_po_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate (1): inited?
        mov rax, [rip + _syn_inited];
        cmp rax, 0;
        je  syn_po_notinit;

        // --- Record state: zero contact-count, zero gesture.
        xor rax, rax;
        mov [rip + _syn_last_contact_ct], rax;
        mov [rip + _syn_last_x0],         rax;
        mov [rip + _syn_last_y0],         rax;
        mov [rip + _syn_last_gesture],    rax;

        // --- Pull x0, y0 for the fingerprint (both 0 at skeleton stage).
        mov r12, [rip + _syn_last_x0];       // x0
        mov r13, [rip + _syn_last_y0];       // y0

        // --- Bump poll counter (before fingerprint).
        mov rax, [rip + _syn_poll_ct];
        add rax, 1;
        mov [rip + _syn_poll_ct], rax;

        // --- Emit CONTACTS fingerprint:
        //       klog_s1_d3(level=3, SUBSYS_DRV_, syn_tag_contacts,
        //                  k1=k_n,  v1=last_contact_ct,
        //                  k2=k_x0, v2=x0,
        //                  k3=k_y0, v3=y0).
        //     paideia-as 6-param ABI: last three (v2, k3, v3) ride
        //     caller stack at [rsp+0]/+8/+16 (NOT [rsp+8]/+16/+24
        //     -- that was the Wave 73 I7 trap; the wrapper's push
        //     rbp shifts them UP to [rbp+16]/+24/+32 which the
        //     wrapper then reads).
        sub rsp, 32;                                   // align + 3 slots + pad
        mov [rsp + 0],  r12;                           // v2 = x0 (caller [rsp+0])
        lea rax, [rip + syn_k_y0];
        mov [rsp + 8],  rax;                           // k3 = k_y0 ptr
        mov [rsp + 16], r13;                           // v3 = y0

        mov rdi, 3;                                    // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + syn_tag_contacts];
        lea rcx, [rip + syn_k_n];                      // k1
        mov rax, [rip + _syn_last_contact_ct];
        mov r8,  rax;                                  // v1 = n = 0
        lea r9,  [rip + syn_k_x0];                     // k2
        call klog_s1_d3;
        add rsp, 32;

        xor rax, rax;                                  // SYN_TP_OK
        jmp syn_po_out;

      syn_po_notinit:
        mov rax, 0xFFFFFEE5;                           // SYN_ERR_HID_CAP_BAD

      syn_po_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  synaptics_get_gesture() -> u64
  //
  // Returns the last decoded gesture code (GESTURE_NONE..GESTURE_PINCH)
  // and emits the GESTURE fingerprint.
  //
  // Gates in order:
  //   (1) _syn_inited == 0   -> SYN_ERR_NO_GESTURE_YET
  //
  // At skeleton stage `_syn_last_gesture` is always GESTURE_NONE (0)
  // because the real decoder is deferred; the entrypoint still fires
  // the GESTURE fingerprint and bumps the counter, which the
  // follow-up slice's smoke witness asserts.
  //
  // SysV: no args.
  // Register plan: one push (rbx) leaves rsp%16==0 at the klog
  // call.  Labels prefixed syn_ge_.
  // ==========================================================================
  pub let synaptics_get_gesture : () -> u64 !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 77 D14 (paideia-os#2531) skeleton: gate on _syn_inited, emit `SYNAPTICS GESTURE id=<dec>` via klog_s1_d1, bump _syn_gesture_ct, return _syn_last_gesture (always GESTURE_NONE=0 at skeleton stage because the real decoder is deferred -- see SECTION 2). Follow-up slice: TAP (contact_count 1->0 within 150 ms + <5 mm displacement) and TWO-FINGER SCROLL (contact_count held at 2, both fingertips moving >10 mm in same direction) are the two decoded gestures at skeleton level; DOUBLE_TAP / SWIPE_3F / PINCH are declared but unimplemented. Register plan: one callee-save push (rbx) leaves rsp%16==0 at the klog_s1_d1 CALL. Labels prefixed syn_ge_.",
      block: {
        push rbx;

        // --- Gate (1): inited?
        mov rax, [rip + _syn_inited];
        cmp rax, 0;
        je  syn_ge_notinit;

        // --- Bump gesture counter.
        mov rax, [rip + _syn_gesture_ct];
        add rax, 1;
        mov [rip + _syn_gesture_ct], rax;

        // --- Emit GESTURE fingerprint:
        //       klog_s1_d1(level=3, SUBSYS_DRV_, syn_tag_gesture,
        //                  k_id, _syn_last_gesture).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + syn_tag_gesture];
        lea rcx, [rip + syn_k_id];
        mov rax, [rip + _syn_last_gesture];
        mov r8,  rax;
        call klog_s1_d1;

        // --- Return last gesture.
        mov rax, [rip + _syn_last_gesture];
        jmp syn_ge_out;

      syn_ge_notinit:
        mov rax, 0xFFFFFEE8;                 // SYN_ERR_NO_GESTURE_YET

      syn_ge_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  synaptics_tp_reset(hid_cap: u64) -> u64
  //
  // Re-issues the HID RESET command sequence through the attached
  // I2C-HID transport.  Returns SYN_TP_OK on success, SYN_ERR_HID_CAP_BAD
  // if the cap mismatches the init-cached one, SYN_ERR_RESET_FAILED
  // if the underlying `i2c_hid_reset` refuses.
  //
  // Gates in order:
  //   (1) hid_cap == 0                            -> SYN_ERR_HID_CAP_BAD
  //   (2) _syn_inited == 0                        -> SYN_ERR_HID_CAP_BAD
  //   (3) _syn_last_hid_cap != hid_cap            -> SYN_ERR_HID_CAP_BAD
  //
  // The real body additionally fails with SYN_ERR_RESET_FAILED
  // (0xFFFFFEE9) if the underlying i2c_hid_reset returns nonzero.
  // At skeleton stage the fail path is not reached (i2c_hid_reset
  // skeleton returns I2C_HID_OK), and the entrypoint returns OK once
  // the three gates pass.
  //
  // Also clears _syn_last_gesture back to GESTURE_NONE so a stale
  // gesture does not survive a reset.
  //
  // No fingerprint at reset -- reset is a cold-start operation whose
  // wire witness is i2c_hid_reset's own `I2C_HID RESET` line one
  // layer down.
  //
  // SysV: rdi=hid_cap.
  // Register plan: rbx=hid_cap.  One callee-save push leaves rsp%16==0.
  // Labels prefixed syn_rs_.
  // ==========================================================================
  pub let synaptics_tp_reset : (u64) -> u64 !{mem} @{boot, cap} =
    fn (hid_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {boot, cap},
      justification: "Wave 77 D14 (paideia-os#2531) skeleton: gate (hid_cap != 0 AND _syn_inited AND _syn_last_hid_cap == hid_cap), clear _syn_last_gesture, bump _syn_reset_ct, return SYN_TP_OK. Real body chains into i2c_hid_reset (Wave 76 D13 `drivers/i2c/i2c_hid.pdx:i2c_hid_reset`) over the cached (bus, addr) from the hid_cap row; failure propagates as SYN_ERR_RESET_FAILED (0xFFFFFEE9). The three-gate shape mirrors i2c_hid_reset exactly (probed AND same bus AND same addr -> NOT_INITED). No fingerprint -- reset's wire witness is i2c_hid's own `I2C_HID RESET` line one layer down. Register plan: rbx = hid_cap, one callee-save push leaves rsp%16==0. Labels prefixed syn_rs_.",
      block: {
        push rbx;

        mov rbx, rdi;                        // hid_cap

        // --- Gate (1): hid_cap != 0?
        cmp rbx, 0;
        je  syn_rs_bad;

        // --- Gate (2): inited?
        mov rax, [rip + _syn_inited];
        cmp rax, 0;
        je  syn_rs_bad;

        // --- Gate (3): cap matches init-cached one?
        mov rax, [rip + _syn_last_hid_cap];
        cmp rax, rbx;
        jne syn_rs_bad;

        // --- Clear last gesture (defensive -- a stale value should not
        //     survive a reset).
        xor rax, rax;
        mov [rip + _syn_last_gesture], rax;

        // --- Bump reset counter.
        mov rax, [rip + _syn_reset_ct];
        add rax, 1;
        mov [rip + _syn_reset_ct], rax;

        xor rax, rax;                        // SYN_TP_OK
        jmp syn_rs_out;

      syn_rs_bad:
        mov rax, 0xFFFFFEE5;                 // SYN_ERR_HID_CAP_BAD

      syn_rs_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  Stat accessors + state getters -- single-load leaf getters.
  // ==========================================================================

  pub let synaptics_init_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_init_ct. Witness-side assertion anchor. Leaf.",
      block: { mov rax, [rip + _syn_init_ct]; ret }
    }

  pub let synaptics_poll_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_poll_ct. Pair for init_count. Leaf.",
      block: { mov rax, [rip + _syn_poll_ct]; ret }
    }

  pub let synaptics_gesture_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_gesture_ct. Leaf.",
      block: { mov rax, [rip + _syn_gesture_ct]; ret }
    }

  pub let synaptics_reset_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_reset_ct. Leaf.",
      block: { mov rax, [rip + _syn_reset_ct]; ret }
    }

  pub let synaptics_last_gesture_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_last_gesture. Pair for the KIND_SYNAPTICS QUERY_LAST_GESTURE op. Leaf.",
      block: { mov rax, [rip + _syn_last_gesture]; ret }
    }

  pub let synaptics_last_contact_count_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_last_contact_ct. Pair for the KIND_SYNAPTICS QUERY_CONTACT_COUNT op. Leaf.",
      block: { mov rax, [rip + _syn_last_contact_ct]; ret }
    }

  pub let synaptics_last_hid_cap_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_last_hid_cap. Pair for the KIND_SYNAPTICS QUERY_LAST_HID_CAP op. Leaf.",
      block: { mov rax, [rip + _syn_last_hid_cap]; ret }
    }

  pub let synaptics_inited_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D14 (paideia-os#2531): single-load getter for _syn_inited. Pair for the KIND_SYNAPTICS QUERY_INITED op. Leaf.",
      block: { mov rax, [rip + _syn_inited]; ret }
    }

  // ==========================================================================
  // §N  cap_handler_synaptics(rights, target_ptr, op_arg) -> u64
  //
  // KIND_SYNAPTICS cap_invoke dispatch handler.  Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x47; je
  // call_kind_synaptics` arm added alongside this file.
  //
  // The handler is QUERY-ONLY at Wave 77 D14 -- the mutating
  // primitives (init, poll, reset) ride supervisor callers above the
  // generic cap_invoke syscall ABI, same shape every drv/authority
  // split in this cap-table uses.
  //
  //     op 0 QUERY_LAST_GESTURE   -> last decoded gesture code
  //     op 1 QUERY_CONTACT_COUNT  -> last contact_count seen
  //     op 2 QUERY_LAST_HID_CAP   -> last attached hid_cap
  //     op 3 QUERY_INITED         -> 1 if init has run, 0 otherwise
  //     else                      -> INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_SYN_READ.
  // target_ptr is unused at skeleton stage (query is module-wide,
  // not per-device; follow-up slice adds the per-device row table
  // + per-ptr dispatch).
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg.
  // Stack recipe: 3-push callee-save (rbx=rights, r12=target_ptr,
  // r13=op_code).  Labels prefixed syn_hd_.
  // ==========================================================================
  pub let cap_handler_synaptics : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 77 D14 (paideia-os#2531): KIND_SYNAPTICS cap_invoke dispatch. Entry chatter (klog_s1 of syn_tag_handler_entry) with the three incoming regs preserved in callee-save slots. op_code = op_arg & 0xFF; rights gate against R_SYN_READ; dispatch 0..3 to the matching accessor; else INVOKE_UNSUPPORTED. target_ptr is unused at skeleton stage (query is module-wide); follow-up slice adds per-device row table + per-ptr dispatch. Three callee-save pushes (rbx=rights, r12=target_ptr, r13=op_code) land rsp%16==0 at every nested call. The 8-bit op_code mask stages through r10 to sidestep `and r11, imm64`. Labels prefixed syn_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rights
        mov r12, rsi;                        // target_ptr (unused at skeleton)
        mov r13, rdx;                        // op_arg
        mov r10, 0xFF;
        and r13, r10;                        // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + syn_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                      // R_SYN_READ
        cmp r10, 0;
        je  syn_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  syn_hd_op_gest;
        cmp r13, 1;
        je  syn_hd_op_ccnt;
        cmp r13, 2;
        je  syn_hd_op_hcap;
        cmp r13, 3;
        je  syn_hd_op_init;
        jmp syn_hd_unsup;

      syn_hd_op_gest:
        call synaptics_last_gesture_q;
        jmp syn_hd_out;

      syn_hd_op_ccnt:
        call synaptics_last_contact_count_q;
        jmp syn_hd_out;

      syn_hd_op_hcap:
        call synaptics_last_hid_cap_q;
        jmp syn_hd_out;

      syn_hd_op_init:
        call synaptics_inited_q;
        jmp syn_hd_out;

      syn_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        jmp syn_hd_out;
      syn_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED

      syn_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  Boot wiring note
  // ----------------
  // kernel_main.pdx picks up `synaptics_module_reset` alongside the
  // existing drivers' reset calls at the follow-up slice:
  //
  //   call synaptics_module_reset;   // defensive zero of report + state
  //
  // Zero-arg, allocates nothing on the stack, touches rax/rcx/r10
  // only; safe alongside kernel_main's live r12/r13/r14 handoff
  // registers.  The wiring itself is deferred to a follow-up slice
  // (same discipline every other `*_module_reset` boot wiring
  // follows -- i2c_hid_module_reset was declared in Wave 76 and
  // wired a slice later).  At real boot .bss zero-init leaves the
  // scratch empty + _syn_inited zero, so every entrypoint except
  // synaptics_init refuses with SYN_ERR_HID_CAP_BAD; the
  // KIND_SYNAPTICS dispatch arm is pure plumbing and self-standing.
  // ==========================================================================
}
