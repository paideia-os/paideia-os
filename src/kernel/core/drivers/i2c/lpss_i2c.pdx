// src/kernel/core/drivers/i2c/lpss_i2c.pdx — paideia-os#2523 (Wave 59 D6)
//
// Intel LPSS I²C controller top-level skeleton: register offsets exposed
// under the `LPSS_I2C_*` namespace, four MMIO entrypoints
// (`lpss_i2c_init`, `lpss_i2c_scan`, `lpss_i2c_read`, `lpss_i2c_write`)
// and a bus-scan fingerprint. Bodies are STUBS -- every entrypoint
// emits a klog witness and returns INVOKE_UNSUPPORTED, pending the
// Wave 60 real-body slice that lands FIFO push/pop, IRQ wiring (through
// KIND_INTERRUPT) and the probe-driven address scan.
//
// -----------------------------------------------------------------------------
// WHERE THIS FILE SITS IN THE LPSS I²C STACK
// -----------------------------------------------------------------------------
//
// The LPSS I²C family already lives in this directory:
//
//   dw_regs.pdx       -- DesignWare register offset constants (DW_IC_*)
//                        and the SCL-divider arithmetic.
//   dw_io.pdx         -- the capability-guarded MMIO seam
//                        (`dw_io_read32` / `dw_io_write32`), the ONLY
//                        path from this driver to physical registers.
//   dw_init.pdx       -- bring-up (identify + enable).
//   dw_isr.pdx        -- interrupt service routine.
//   dw_irq.pdx        -- IRQ delivery plumbing.
//   dw_xfer.pdx       -- transfer state machine (write-then-read).
//   lpss_probe.pdx    -- PCI probe + per-controller row table.
//
// This file is the TOP-LEVEL seam that external callers (userspace
// drivers, the I2C-HID transport, the sensor hub) will later reach to
// start a transfer. It therefore names its entrypoints in the shape
// paideia-os#2523 asked for -- `mmio_base` is the first argument of
// every function -- even though the real body will route the base
// through the `KIND_OP_REGION` window the probe bound, NOT through a
// bare physical address. Taking the base as a parameter in the
// stub-level signature keeps the ABI stable for the follow-up slice,
// and the stub refuses the call (INVOKE_UNSUPPORTED) so no caller can
// accidentally bypass the capability check.
//
// -----------------------------------------------------------------------------
// REGISTER MAP RE-EXPOSED UNDER LPSS_I2C_* NAMES
// -----------------------------------------------------------------------------
//
// `dw_regs.pdx` already carries every DesignWare offset constant. Those
// constants are the ones the real body will read. The paideia-os#2523
// spec asks that this skeleton name a specific subset under the
// `LPSS_I2C_*` prefix; those names re-publish the same offsets so a
// caller that knows the LPSS block can reach them without transitively
// depending on `DwRegs`. Both names resolve to the same byte offset
// into BAR0 -- there is no second register map.
//
// -----------------------------------------------------------------------------
// WHY STUBS
// -----------------------------------------------------------------------------
//
// A real body needs three things that are not here yet:
//
//   1. IRQ WIRING. The transfer engine is interrupt-driven -- TX_EMPTY
//      refills the FIFO, RX_FULL drains it, STOP_DET and TX_ABRT end
//      the transfer. The KIND_INTERRUPT skeleton landed in Wave 65
//      (#2518); binding a vector to the LPSS controller requires an
//      MSI-X setup step this driver has not grown yet.
//   2. BUS-LEVEL SCAN. Address probing (writing a zero-length transfer
//      to each address 0x08..0x77 and watching for a NACK via
//      IC_TX_ABRT_SOURCE) depends on `dw_xfer`'s state machine being
//      reachable through a `KIND_I2C_BUS` capability. The capability
//      path exists (`kind_i2c_bus.pdx::cap_handler_i2c_bus`), but it
//      offers only QUERY ops -- the mint of a per-slave capability
//      from a scan hit is a kernel-side operation that is still queued.
//   3. ACPI _CRS CONSUMPTION. The real scan should not probe blindly;
//      it should iterate the `_SB.PCI0.I2Cn._CRS` package to learn
//      which slave addresses the firmware actually declared, and probe
//      only those. The ACPI _CRS parser landed as part of Wave 59 D5
//      (#2522) but the method evaluator remains a stub, so the real
//      scan has nothing to iterate.
//
// Deferring these three dependencies into one follow-up slice keeps
// the ABI of this file stable in a world where #2518, #2521 (driver
// registry v2) and #2522 are still skeletons. The INVOKE_UNSUPPORTED
// return turns every would-be premature caller into a named refusal,
// which is strictly better than a dangling symbol or a partial
// transfer that corrupts a bus whose capability nobody minted.
//
// -----------------------------------------------------------------------------
// FINGERPRINT
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/lpss_i2c.golden
//
//   I2C BUS SCAN OK n_responders=<n> addrs=0x<hex-list>
//
// Seeded with the format placeholder; the real emitter in the Wave 60
// follow-up will substitute the measured responder count and the
// address bitmap. This matches `aml_walker.golden`'s format-anchor
// discipline.
//
// -----------------------------------------------------------------------------
// paideia-as v0.36.81 posture
// -----------------------------------------------------------------------------
//
//   G1  -- every u32 MMIO store uses `mov_d`. There are none in this
//          file (stubs do not write registers), but the writer's note
//          is here so the follow-up does not reintroduce a bare `mov`.
//   G4  -- every compare is on a full 64-bit register. `test rN,rN`
//          is NOT used; `cmp rN, 0; je/jne` is used instead per the
//          pdx-encoder-pitfalls memory.
//   Reserved labels -- all labels prefixed `lpi2c_` to avoid clashing
//                      with `loop` / `if` / `let` keywords, and to
//                      stay distinct from `lpi_` (lpss_probe) and
//                      `dwi_` (dw_init).
//   Module basename  -- `LpssI2c` matches file basename `lpss_i2c`.

module LpssI2c = structure {

  // ==========================================================================
  // Register offsets -- re-published from dw_regs.pdx under LPSS_I2C_*
  //
  // Each constant equals its DW_IC_* counterpart. Two names for one
  // offset is deliberate: a top-level caller should not have to know
  // the controller is a DesignWare core to find the FIFO port, and the
  // LPSS-generation code in the probe should not have to say "DW_" to
  // refer to a register that is PART of the Intel LPSS block from its
  // point of view. The constants are literal integers rather than
  // aliases because paideia-as v0.36.81 does not allow a `pub let`
  // right-hand side to reference another identifier.
  // ==========================================================================

  pub let LPSS_I2C_IC_CON          : u64 = 0x00
  pub let LPSS_I2C_IC_TAR          : u64 = 0x04
  pub let LPSS_I2C_IC_SAR          : u64 = 0x08
  pub let LPSS_I2C_IC_DATA_CMD     : u64 = 0x10
  pub let LPSS_I2C_IC_SS_SCL_HCNT  : u64 = 0x14
  pub let LPSS_I2C_IC_SS_SCL_LCNT  : u64 = 0x18
  pub let LPSS_I2C_IC_FS_SCL_HCNT  : u64 = 0x1C
  pub let LPSS_I2C_IC_FS_SCL_LCNT  : u64 = 0x20
  pub let LPSS_I2C_IC_INTR_STAT    : u64 = 0x2C
  pub let LPSS_I2C_IC_INTR_MASK    : u64 = 0x30
  pub let LPSS_I2C_IC_RAW_INTR     : u64 = 0x34
  pub let LPSS_I2C_IC_RX_TL        : u64 = 0x38
  pub let LPSS_I2C_IC_TX_TL        : u64 = 0x3C
  pub let LPSS_I2C_IC_CLR_INTR     : u64 = 0x40
  pub let LPSS_I2C_IC_CLR_TX_ABRT  : u64 = 0x54
  pub let LPSS_I2C_IC_CLR_STOP_DET : u64 = 0x60
  pub let LPSS_I2C_IC_ENABLE       : u64 = 0x6C
  pub let LPSS_I2C_IC_STATUS       : u64 = 0x70
  pub let LPSS_I2C_IC_TXFLR        : u64 = 0x74
  pub let LPSS_I2C_IC_RXFLR        : u64 = 0x78
  pub let LPSS_I2C_IC_SDA_HOLD     : u64 = 0x7C
  pub let LPSS_I2C_IC_TX_ABRT_SRC  : u64 = 0x80
  pub let LPSS_I2C_IC_DMA_CR       : u64 = 0x88
  pub let LPSS_I2C_IC_ENABLE_STS   : u64 = 0x9C
  pub let LPSS_I2C_IC_COMP_PARAM_1 : u64 = 0xF4
  pub let LPSS_I2C_IC_COMP_TYPE    : u64 = 0xFC

  // Window the probe mints over BAR0, in bytes. One page.
  pub let LPSS_I2C_WINDOW_BYTES    : u64 = 0x1000

  // ==========================================================================
  // Standard I²C address range -- the 7-bit space the scanner probes.
  //
  //   0x00..0x07   reserved by the specification (CBUS, Hs master code,
  //                general call, start byte, 10-bit addressing prefix).
  //   0x08..0x77   the general-purpose address range the scanner walks.
  //   0x78..0x7F   reserved -- 10-bit addressing extension prefixes.
  //
  // Narrowing the scan to [0x08, 0x77] is NOT a correctness choice; it
  // is a specification-of-intent choice. Writing a zero-length transfer
  // to a reserved address can confuse a slave that reads the reserved
  // prefix as a mode switch, and the T14 G4's touchpad is one such
  // slave on at least one firmware revision.
  // ==========================================================================

  pub let LPSS_I2C_SCAN_LO         : u64 = 0x08
  pub let LPSS_I2C_SCAN_HI         : u64 = 0x77

  // ==========================================================================
  // Speed codes -- the four rates kind_i2c_bus.pdx::i2c_bus_speed_valid
  // admits at the capability boundary.
  // ==========================================================================

  pub let LPSS_I2C_SPEED_STD       : u64 = 100000      // 100 kHz
  pub let LPSS_I2C_SPEED_FAST      : u64 = 400000      // 400 kHz
  pub let LPSS_I2C_SPEED_FAST_PLUS : u64 = 1000000     // 1 MHz
  pub let LPSS_I2C_SPEED_HIGH      : u64 = 3400000     // 3.4 MHz

  // ==========================================================================
  // Return codes
  //
  // Shares the LPSS_I2C_* band 0xFFFFFF40..0xFFFFFF5F defined in
  // `lpss_probe.pdx`; the two files are co-owners of this band and
  // never overlap. The entry here that is NOT in `lpss_probe.pdx` is
  // the generic INVOKE_UNSUPPORTED, re-exposed under the family's own
  // name so callers do not have to transitively depend on `cap/invoke`
  // just to read one return code.
  // ==========================================================================

  pub let LPSS_I2C_OK              : u64 = 0
  pub let LPSS_I2C_INVOKE_UNSUP    : u64 = 0xFFFFFFFFFFFFFFFC

  // ==========================================================================
  // Log tags.
  //
  // One tag per entrypoint. Each tag is a single-line string literal to
  // sidestep the paideia-as v0.36.81 pitfall where a `pub let x = "..."`
  // split across lines is parsed as two declarations.
  // ==========================================================================

  pub let lpi2c_tag_init  : [u8; 17] = "LPSS I2C INIT ST\0"
  pub let lpi2c_tag_scan  : [u8; 17] = "LPSS I2C SCAN ST\0"
  pub let lpi2c_tag_rd    : [u8; 17] = "LPSS I2C READ ST\0"
  pub let lpi2c_tag_wr    : [u8; 17] = "LPSS I2C WRIT ST\0"
  pub let lpi2c_k_base    : [u8; 5]  = "base\0"
  pub let lpi2c_k_speed   : [u8; 6]  = "speed\0"
  pub let lpi2c_k_slave   : [u8; 6]  = "slave\0"
  pub let lpi2c_k_len     : [u8; 4]  = "len\0"

  // ==========================================================================
  // lpss_i2c_init(mmio_base, speed) -> rc
  //
  // STUB. The real body will:
  //   1. open the KIND_OP_REGION window keyed on `mmio_base`;
  //   2. clear IC_ENABLE and poll IC_ENABLE_STATUS until 0
  //      (via `dw_i2c_wait_enable(0)`);
  //   3. program IC_CON for `speed`, 7-bit master, RESTART_EN,
  //      SLAVE_DISABLE (via `dw_i2c_con_for_speed`);
  //   4. program the SCL high/low counts and IC_SDA_HOLD at ic_clk;
  //   5. set IC_TX_TL = 0 and IC_RX_TL = 0 so EVERY FIFO transition
  //      raises a line (the interrupt engine deals with the storm);
  //   6. clear every latched source via IC_CLR_INTR;
  //   7. set IC_ENABLE and poll IC_ENABLE_STATUS until 1.
  //
  // Today it emits a witness line carrying the base address and the
  // requested speed and returns INVOKE_UNSUPPORTED. The arguments are
  // CAPTURED into the witness, not ignored -- a caller that reaches
  // here with a bad base learns which base was refused.
  //
  // Register plan: three pushes (rbx, r12, r13) leave rsp % 16 == 0 at
  // the klog_s1_x2 call site. r12=base, r13=speed carried across the
  // klog call because klog clobbers rcx/r8 per wrappers.pdx §5.1.
  // Labels prefixed `lpi2c_in_`.
  // ==========================================================================

  pub let lpss_i2c_init : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (mmio_base: u64) (speed: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "paideia-os#2523 (Wave 59 D6): LPSS I2C controller init stub. The REAL body is deferred to the follow-up slice because the disable/enable poll on IC_ENABLE_STATUS, the IC_CON write and the SCL count programming all need the capability-protected seam -- `dw_io_write32` and the KIND_OP_REGION window bound by `lpss_i2c_bind_window` -- and the signature paideia-os#2523 asked for takes a BARE physical base, which the capability seam does not accept. Returning INVOKE_UNSUPPORTED keeps the ABI stable for the follow-up (every caller stays named) and makes a would-be premature invocation a named refusal rather than a write through an unminted path -- the same discipline `cap_handler_i2c_bus` applies at the capability boundary. The arguments are RECORDED in a witness line (base, speed) rather than dropped: a caller that reaches here with the wrong base learns which base was refused, which is the information a bring-up log needs. Three pushes (rbx, r12, r13) leave rsp%16 == 0 at the klog_s1_x2 call site; r12=base, r13=speed are preserved across klog, which clobbers rcx/r8 per wrappers.pdx §5.1. Labels prefixed `lpi2c_in_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // mmio_base
        mov r13, rsi;                    // speed

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpi2c_tag_init];
        lea rcx, [rip + lpi2c_k_base];
        mov r8, r12;
        lea r9, [rip + lpi2c_k_speed];
        push r13;                        // 7th arg: speed value
        sub rsp, 8;                      // align
        call klog_s1_x2;
        add rsp, 16;

        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_i2c_scan(mmio_base, buf, buf_len) -> n_responders | fault
  //
  // STUB. The real body will:
  //   1. require the controller READY (`lpss_i2c_ctrl_state(idx) == 4`);
  //   2. ensure IC_ENABLE_STATUS reports enabled;
  //   3. for each a in [LPSS_I2C_SCAN_LO .. LPSS_I2C_SCAN_HI]:
  //        a. write IC_TAR = a (while disabled -- the LPSS instance
  //           lacks dynamic TAR update);
  //        b. re-enable;
  //        c. push a zero-length write: IC_DATA_CMD = STOP | 0;
  //        d. poll IC_RAW_INTR_STAT for STOP_DET or TX_ABRT;
  //        e. on STOP_DET without TX_ABRT -> responder; append `a` to
  //           `buf` (bounded by `buf_len`);
  //        f. on TX_ABRT -> read IC_CLR_TX_ABRT to release the FIFO
  //           and move on;
  //        g. disable, loop.
  //   4. emit the fingerprint line via `klog_s1_d1_x2` with
  //      key `n_responders` (decimal) and key `addrs` (hex-list word).
  //   5. return the responder count.
  //
  // Today it emits a witness line and returns INVOKE_UNSUPPORTED. The
  // scan's RETURN TYPE is a count (not an rc) by paideia-os#2523 spec;
  // for the stub, INVOKE_UNSUPPORTED is observationally a count whose
  // high bits are 1 so a caller that treats it as a count sees an
  // obviously-wrong 2^64-ish value rather than a plausible one. The
  // real body will return 0..LPSS_I2C_SCAN_HI - LPSS_I2C_SCAN_LO + 1.
  //
  // Register plan: four pushes (rbx, r12, r13, r14) leave rsp%16 == 0
  // at the klog_s1_x1 call site. r12=base is preserved across klog.
  // Labels prefixed `lpi2c_sc_`.
  // ==========================================================================

  pub let lpss_i2c_scan : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (mmio_base: u64) (buf: u64) (buf_len: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "paideia-os#2523 (Wave 59 D6): LPSS I2C controller bus-level address scan stub. The REAL body walks addresses 0x08..0x77 posting a zero-length write to each and classifying the outcome by IC_RAW_INTR_STAT, which depends on both the transfer state machine (`dw_xfer.pdx`) being reachable through a KIND_I2C_BUS capability AND on the KIND_INTERRUPT skeleton from Wave 65 (#2518) having been linked to a real MSI-X vector. Neither is present today, so the scan body is deferred. The signature matches paideia-os#2523's spec (base, buf, buf_len -> count); the stub returns INVOKE_UNSUPPORTED whose two's-complement form is 2^64-4, an obviously-wrong count that a caller treating this as a probe-count sees as a refusal rather than a plausible value. A witness line records the base; buf and buf_len are not reached because a stub cannot populate the buffer. The fingerprint line format `I2C BUS SCAN OK n_responders=<n> addrs=0x<hex-list>` is seeded in tests/fingerprints/lpss_i2c.golden as a FORMAT ANCHOR, same discipline as `aml_walker.golden`; the Wave 60 follow-up emits it with measured counts via `klog_s1_d1_x1`. Four pushes (rbx, r12, r13, r14) hold base, buf, buf_len across klog, which clobbers rcx/r8 per wrappers.pdx §5.1; rsp%16 == 0 at the nested call. Labels prefixed `lpi2c_sc_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // mmio_base
        mov r13, rsi;                    // buf
        mov r14, rdx;                    // buf_len

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpi2c_tag_scan];
        lea rcx, [rip + lpi2c_k_base];
        mov r8, r12;
        call klog_s1_x1;

        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_i2c_read(mmio_base, slave_addr, reg, len, buf) -> rc
  //
  // STUB. The real body will:
  //   1. program IC_TAR with `slave_addr`;
  //   2. push a one-byte write of `reg` (IC_DATA_CMD with no STOP);
  //   3. push `len` read commands (IC_DATA_CMD with CMD=READ, last
  //      one tagged STOP);
  //   4. poll IC_STATUS.RFNE / IC_RAW_INTR_STAT until `len` bytes have
  //      been popped from IC_DATA_CMD into `buf`;
  //   5. honour TX_ABRT -- read IC_CLR_TX_ABRT, return a specific code.
  //
  // Today it emits a witness line carrying slave_addr and len and
  // returns INVOKE_UNSUPPORTED.
  //
  // Register plan: four pushes leave rsp%16 == 0 at the klog_s1_x2
  // call site. Labels prefixed `lpi2c_rd_`.
  // ==========================================================================

  pub let lpss_i2c_read : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (mmio_base: u64) (slave_addr: u64) (reg: u64) (len: u64) (buf: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "paideia-os#2523 (Wave 59 D6): LPSS I2C register read stub. The real body is a combined write-then-read: push `reg` as a one-byte write, then push `len` read commands, polling IC_STATUS.RFNE between pops. Both halves share one START/STOP envelope through IC_CON.RESTART_EN -- without that bit set the transfer would degrade into write-STOP, read-START, which releases the bus mid-transfer and lets another master interleave. The real body is deferred because it needs the dw_xfer state machine reachable through a KIND_I2C_SLAVE capability (minting slave capabilities from a scan hit is still queued, see `lpss_i2c_scan`'s justification). The witness emits slave_addr and len so a caller debugging a bring-up transfer sees WHICH slave was addressed. Four pushes (rbx, r12, r13, r14) hold slave_addr and len across klog; rsp%16 == 0 at the klog_s1_x2 call site via one extra push + align sub. Labels prefixed `lpi2c_rd_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rsi;                    // slave_addr
        mov r13, rcx;                    // len

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpi2c_tag_rd];
        lea rcx, [rip + lpi2c_k_slave];
        mov r8, r12;
        lea r9, [rip + lpi2c_k_len];
        push r13;                        // 7th arg
        sub rsp, 8;                      // align
        call klog_s1_x2;
        add rsp, 16;

        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_i2c_write(mmio_base, slave_addr, reg, len, buf) -> rc
  //
  // STUB. The real body will:
  //   1. program IC_TAR with `slave_addr`;
  //   2. push a one-byte write of `reg` (IC_DATA_CMD, no STOP);
  //   3. push `len` write bytes from `buf`, last one tagged STOP;
  //   4. poll IC_STATUS.TFE | IC_RAW_INTR_STAT.STOP_DET;
  //   5. honour TX_ABRT -- read IC_CLR_TX_ABRT.
  //
  // Today: witness + INVOKE_UNSUPPORTED. Labels prefixed `lpi2c_wr_`.
  // ==========================================================================

  pub let lpss_i2c_write : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (mmio_base: u64) (slave_addr: u64) (reg: u64) (len: u64) (buf: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "paideia-os#2523 (Wave 59 D6): LPSS I2C register write stub. Companion to `lpss_i2c_read` with the direction bit cleared on every pushed command. The real body is a single sequence of (reg, byte0, byte1, ..., byteN-1 | STOP) commands and shares IC_CON.RESTART_EN handling with the read path -- the two bodies cannot diverge because the state machine that services them is one. Deferred for the same reason as the read: the slave capability -> controller join is not minted yet. The witness emits slave_addr and len so a caller can tell which write was refused. Four pushes leave rsp%16 == 0 at the klog_s1_x2 call site. Labels prefixed `lpi2c_wr_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rsi;                    // slave_addr
        mov r13, rcx;                    // len

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpi2c_tag_wr];
        lea rcx, [rip + lpi2c_k_slave];
        mov r8, r12;
        lea r9, [rip + lpi2c_k_len];
        push r13;                        // 7th arg
        sub rsp, 8;                      // align
        call klog_s1_x2;
        add rsp, 16;

        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // NOTE on `cap_handler_i2c_bus`
  //
  // The IPC entrypoint `cap_handler_i2c_bus` already EXISTS at
  //   `src/kernel/core/cap/kind_i2c_bus.pdx` line 1286
  // and is dispatched by `cap/invoke.pdx` line 1400. The paideia-os#2523
  // spec asked that we add one here only IF an existing slot is not
  // present; it is, so we deliberately DO NOT define a second one.
  // Shadowing would produce a duplicate-symbol link error and would
  // moreover divide the handler's authority between two files, each of
  // which would be a plausible place to look for a bug. The existing
  // handler is the canonical one.
  //
  // The real-body slice of this file will REACH the capability layer
  // through the standard mint path (`i2c_bus_cap_mint`), not through a
  // handler of its own. The bus handle a userspace caller holds is
  // minted from a `KIND_DEVICE` carrying `RIGHT_MINT`; its target_ptr
  // carries the bus row id this file's probe-join wrote.
  // ==========================================================================

