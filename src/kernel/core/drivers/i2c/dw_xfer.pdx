// src/kernel/core/drivers/i2c/dw_xfer.pdx — R30.M5-004 (#1073)
//
// The I²C transfer engine: the kernel primitives the
// `i2c_transfer_channel` opcodes decode onto.
//
// -----------------------------------------------------------------------------
// 1. THE ADDRESS COMES FROM THE CAPABILITY. ALWAYS. ONLY.
// -----------------------------------------------------------------------------
//
// Every entry point here takes a `slave_slot` and no address:
//
//   i2c_xfer_write      (slave_slot, buf, len, budget)
//   i2c_xfer_read       (slave_slot, buf, len, budget)
//   i2c_xfer_write_read (slave_slot, wbuf, wlen, rbuf, rlen, budget)
//   i2c_smbus_op        (slave_slot, proto, command, buf, budget)
//
// The address, the addressing mode, and the bus the device sits on are
// all obtained from the capability row by three arity-one resolvers —
// `i2c_slave_addr_of_slot`, `i2c_slave_mode_of_slot`,
// `i2c_slave_bus_row_of_slot` — whose literal signatures
// `tools/build.sh` pins. All four entry points above are pinned too.
//
// So "address a device other than the one my capability names" is not a
// refused request here. It is an unphrasable one: there is nowhere to
// put the address. That is the property `KIND_I2C_SLAVE` was built to
// have and the property this file must not spend.
//
// The bus row matters as much as the address. Address 0x1A on the
// touchpad controller and 0x1A on the sensor hub are two devices on two
// pairs of wires; #1071 deliberately scoped its uniqueness key to the
// bus so both can be minted. If the transfer path took the controller
// from its caller, that permission at mint would become a confusion at
// transfer. It takes the bus row from the row instead, and finds the
// controller through `lpss_i2c_find_by_bus_row`, which is the only join
// between the capability world and the hardware world.
//
// -----------------------------------------------------------------------------
// 2. RIGHTS ARE CHECKED PER DIRECTION
// -----------------------------------------------------------------------------
//
// `R_I2C_SLAVE_ALL` reserved READ (0x001) and WRITE (0x002) in #1071
// with nothing consuming them, specifically so that a capability minted
// before this landing would be REFUSED a transfer rather than silently
// acquiring one on the day the op appeared. This file consumes them:
//
//   write        INVOKE | WRITE
//   read         INVOKE | READ
//   write_read   INVOKE | READ | WRITE
//   smbus        INVOKE plus whatever the sub-protocol needs
//
// with three distinct refusals (`NO_INVOKE`, `NO_READ_RIGHT`,
// `NO_WRITE_RIGHT`), because "may not transact at all", "is read-only"
// and "is write-only" are three different operator problems.
//
// `write_read` needs WRITE even when the caller thinks of it as a read.
// The command byte moves the device's internal register pointer, which
// is a state change the device is still in afterwards; a read-only
// holder must not be able to leave a shared part pointed somewhere its
// owner did not choose. "It is only a register pointer" is exactly the
// argument by which a device gets reconfigured by a component that was
// supposed to be looking at it.
//
// -----------------------------------------------------------------------------
// 3. IC_TAR IS PROGRAMMED EVERY TRANSFER, AND IS NEVER CACHED
// -----------------------------------------------------------------------------
//
// DesignWare will not accept a new target address while enabled, so
// retargeting is disable, write IC_TAR, enable — two more bounded waits
// per transfer. Caching the last programmed address and skipping the
// sequence when it is unchanged would remove them.
//
// It is not done, and the reason is not performance. A cached target is
// a claim about the controller's state that survives every event that
// can invalidate it: a bus recovery, a re-run of bring-up, a second
// driver selecting the same controller, a controller that reset itself.
// When the cache is wrong, the transfer goes to the WRONG DEVICE at
// full speed with no error anywhere — and "the wrong device on this
// bus" is the single failure the whole capability pair exists to
// prevent. A cache that is right 99.9% of the time buys two register
// writes and sells the milestone's only guarantee.
//
// -----------------------------------------------------------------------------
// 4. EVERY WAIT IS BOUNDED, WITH ITS OWN CODE
// -----------------------------------------------------------------------------
//
// I²C hangs are ordinary. A peripheral stretches SCL past anyone's
// patience; a part is absent; a part NACKs mid-message; a driver dies
// holding the bus. Every wait in this file therefore counts iterations
// against a caller-supplied budget and returns a DISTINCT code:
//
//   I2C_XFER_TIMEOUT_TXFIFO  no room to push a command
//   I2C_XFER_TIMEOUT_RXFIFO  a byte never arrived
//   I2C_XFER_TIMEOUT_STOP    the STOP never appeared
//
// The third is the one that means the bus is probably still held, which
// is why it is not folded into the others.
//
// Same fuel-budget discipline as the interpreter R30.M1 built, for the
// same reason: an unbounded loop over an external input is a hang, and
// a hang at boot is indistinguishable from a dead machine.
//
// -----------------------------------------------------------------------------
// 5. A NACK IS AN OUTCOME, NOT A FAULT
// -----------------------------------------------------------------------------
//
// No device at an address is a normal thing to discover. It must return
// a clean, actionable error and leave the controller usable.
//
// DesignWare makes that easy to get wrong. On an abort it raises
// IC_RAW_INTR_STAT.TX_ABRT, latches a reason in IC_TX_ABRT_SOURCE, and
// FLUSHES AND HOLDS THE TX FIFO — and it stays that way until
// IC_CLR_TX_ABRT is READ. A transfer path that returns the error
// without that read leaves the next transfer, by any driver, facing a
// latched abort it did not cause. The controller looks broken; the
// customary fix is a reset that takes every other device on the bus
// down with it.
//
// So `dw_xfer_check_abort` reads IC_CLR_TX_ABRT on EVERY abort path,
// before returning anything, and the witness asserts both halves: the
// error surfaces, and a subsequent transfer on the same controller
// succeeds.
//
// The reason is decoded into three codes — address NACK, data NACK,
// arbitration lost — because they are three different facts about the
// world (nothing is there; something is there but rejected a byte;
// another master won). The raw source word is kept in
// `_i2c_xfer_abort_src` for the reply record, so the sixteen reasons
// the core distinguishes are not thrown away.
//
// -----------------------------------------------------------------------------
// 6. A WEDGED BUS — WHAT IS IMPLEMENTED AND WHAT IS DEFERRED
// -----------------------------------------------------------------------------
//
// A peripheral that was mid-byte when its driver died can hold SDA low
// forever. The bus is then unusable by everyone on it, and no amount of
// controller configuration fixes it.
//
// TIER 1 — IMPLEMENTED. `i2c_bus_recover` sets IC_ENABLE.ABORT, which
// makes the core drive a STOP and terminate whatever it was doing,
// waits (bounded) for the resulting TX_ABRT, clears it, and cycles the
// controller disabled/enabled. This recovers every case where the
// MASTER is the stuck party — our own aborted transfer, a controller
// left mid-transaction by a driver that died, a transfer abandoned by a
// timeout above.
//
// TIER 2 — DEFERRED, AND THE REASON IS A MISSING AUTHORITY, NOT A
// MISSING IDEA. Freeing a peripheral that latched SDA low requires
// pulsing SCL up to nine times with the controller detached from the
// pins, so the device finishes the byte it thinks it is in and releases
// the line. That is a PIN operation. It requires mux control of the SCL
// pad, which is `KIND_GPIO_LINE` — R30.M6, the next milestone. This
// driver holds no pin authority, and manufacturing one here would mean
// a second unguarded path to hardware of exactly the kind the window
// capability exists to prevent.
//
// So the wedged state is HANDLED rather than unhandled, and handled
// means four specific things:
//
//   * it is DETECTED behaviourally — three consecutive failed tier-1
//     recoveries, not one, because a single failed abort can be a
//     transient arbitration loss against a peer master and taking a
//     recoverable machine down on the first one is not conservative;
//   * it is LATCHED in the controller row, so it survives;
//   * every entry point checks the latch FIRST and fails fast with
//     `I2C_XFER_BUS_WEDGED`, so one stuck peripheral does not convert
//     into N drivers each burning a full timeout budget;
//   * it has a NAMED EXIT — `lpss_i2c_unwedge`, whose intended caller
//     is R30.M6's pin-level recovery. The state is not terminal; it is
//     waiting for an authority this milestone does not have.
//
// -----------------------------------------------------------------------------
// 7. ONE OWNER PER CONTROLLER — R30.M5-005 (#1074)
// -----------------------------------------------------------------------------
//
// This file shipped in #1073 with no mutual exclusion at all. Two CPUs
// could enter `i2c_xfer_write` for the same controller, both program
// IC_TAR, and interleave their IC_DATA_CMD writes into one FIFO — one
// device's bytes delivered under another device's address, with no
// error raised anywhere. R18 landed SMP and nothing had closed it; it
// went unnoticed because the only caller so far is a single-threaded
// boot witness.
//
// #1074 closed it with the claim the interrupt engine needed anyway.
// The three entry points here take `dw_irq_claim` immediately after
// `i2c_xfer_resolve` — after every refusal that needs no register, and
// before the first register write — and release it on EVERY exit past
// that point, success and failure alike. A second caller is refused
// `I2C_IRQ_BUSY` rather than queued: a queue in a driver with no wait
// channel is a spin, and "the bus is busy" is a fact a caller can act
// on.
//
// Because it is the SAME claim `dw_irq.pdx` takes, a polled transfer
// and an interrupt-driven transfer can never be in flight on one wire
// either — which matters more than the polled-versus-polled case, since
// the interrupt engine's service routine writes IC_DATA_CMD from
// interrupt context and would otherwise interleave with a polled loop
// that has no idea it exists.
//
// `i2c_smbus_op` does NOT claim: it delegates to the three primitives
// above and inherits theirs. Claiming here as well would be a second,
// non-recursive acquisition of a non-recursive claim, i.e. a refusal of
// every SMBus transfer.
//
// `i2c_bus_recover` does NOT claim either, and that one is deliberate
// rather than incidental. It is the escape hatch for a controller whose
// owner has stopped making progress, and an escape hatch that requires
// the thing it is escaping from is not one.
//
//   Reserved-label discipline: labels prefixed `dwx_`.

module DwXfer = structure {

  // ==========================================================================
  // Module state
  // ==========================================================================
  //
  // The raw IC_TX_ABRT_SOURCE of the most recent abort, for the reply
  // record. Confined to this object by tools/build.sh: it is a
  // single-writer diagnostic, and a second writer would make "why did
  // the last transfer abort" a race between two callers.

  pub let mut _i2c_xfer_abort_src : u64 = 0

  pub let i2c_xfer_last_abort : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-004 (#1073): the raw IC_TX_ABRT_SOURCE word of the most recent abort. Kept because the core distinguishes sixteen reasons and the three codes this driver returns collapse them; a caller debugging an unfamiliar part wants to know it was ABRT_HS_ACKDET and not merely 'aborted'. Cleared to zero at the start of every transfer so a stale value cannot be read as this transfer's, which matters more than it looks: a successful transfer that reported a previous transfer's abort source would send someone hunting a fault that had already been handled. Leaf load.",
      block: {
        lea r10, [rip + _i2c_xfer_abort_src];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // i2c_xfer_resolve(slave_slot, need_rights) -> ctrl_idx | error
  // ==========================================================================

  pub let i2c_xfer_resolve : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slave_slot: u64, need_rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-004 (#1073): resolve a slave capability to the controller that owns its wire, checking every gate on the way and touching no register. Order: slot < 256 (BAD_SLOT) -> kind == KIND_I2C_SLAVE 0x153 (WRONG_KIND) -> RIGHT_INVOKE (NO_INVOKE) -> the direction bits, READ then WRITE, each with its OWN code -> the slave row is live (BUS_LOST) -> its parent BUS row is live (BUS_LOST) -> a controller is attached to that bus row (NO_CONTROLLER) -> the controller is not wedged (BUS_WEDGED) -> the controller is READY (NOT_READY). Kind before rights, because a slot whose slave capability was revoked and reused for an unrelated kind would otherwise have that kind's rights word tested for READ and could pass. The wedged check sits BEFORE the READY check and before any register access so a held bus costs one table read rather than a full timeout budget per caller. THE BUS ROW COMES FROM THE ROW, via arity-one i2c_slave_bus_row_of_slot, never from the caller: #1071 scoped address uniqueness to the bus so 0x1A can exist on two controllers, and a caller-supplied controller would turn that permission into a way to transact a bus-A capability on bus B. cap_table stride 24. Five pushes (rbx, r12-r15) leave rsp%16 == 0 at every nested call. Labels prefixed dwx_rs_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slave_slot
        mov r13, rsi;                    // need_rights

        cmp r12, 256;
        jae dwx_rs_badslot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x153;                  // KIND_I2C_SLAVE
        cmp r10, r11;
        jne dwx_rs_kind;

        mov r14, [rax + 8];              // rights

        mov r10, r14;
        and r10, 0x008;                  // R_I2C_SLAVE_INVOKE
        cmp r10, 0;
        je  dwx_rs_noinv;

        mov r10, r13;
        and r10, 0x001;                  // wanted READ?
        cmp r10, 0;
        je  dwx_rs_chk_write;
        mov r10, r14;
        and r10, 0x001;
        cmp r10, 0;
        je  dwx_rs_noread;

      dwx_rs_chk_write:
        mov r10, r13;
        and r10, 0x002;                  // wanted WRITE?
        cmp r10, 0;
        je  dwx_rs_rows;
        mov r10, r14;
        and r10, 0x002;
        cmp r10, 0;
        je  dwx_rs_nowrite;

      dwx_rs_rows:
        mov rdi, r12;
        call i2c_slave_bus_row_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_rs_lost;
        mov rbx, rax;                    // bus_row

        mov rdi, rbx;
        call i2c_bus_tail_valid;
        cmp rax, 1;
        jne dwx_rs_lost;

        mov rdi, rbx;
        call lpss_i2c_find_by_bus_row;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_rs_noctrl;
        mov r15, rax;                    // ctrl idx

        mov rdi, r15;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 0;
        jne dwx_rs_wedged;

        mov rdi, r15;
        call lpss_i2c_ctrl_state;
        cmp rax, 4;                      // LPSS_I2C_STATE_READY
        jne dwx_rs_notready;

        mov rax, r15;
        jmp dwx_rs_out;

      dwx_rs_badslot:
        mov rax, 0xFFFFFF6F;
        jmp dwx_rs_out;
      dwx_rs_kind:
        mov rax, 0xFFFFFF6E;
        jmp dwx_rs_out;
      dwx_rs_noinv:
        mov rax, 0xFFFFFF6D;
        jmp dwx_rs_out;
      dwx_rs_noread:
        mov rax, 0xFFFFFF6C;
        jmp dwx_rs_out;
      dwx_rs_nowrite:
        mov rax, 0xFFFFFF6B;
        jmp dwx_rs_out;
      dwx_rs_lost:
        mov rax, 0xFFFFFF6A;
        jmp dwx_rs_out;
      dwx_rs_noctrl:
        mov rax, 0xFFFFFF69;
        jmp dwx_rs_out;
      dwx_rs_notready:
        mov rax, 0xFFFFFF68;
        jmp dwx_rs_out;
      dwx_rs_wedged:
        mov rax, 0xFFFFFF60;

      dwx_rs_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_xfer_set_target(ctrl_idx, slave_slot) -> rc
  // ==========================================================================

  pub let i2c_xfer_set_target : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (ctrl_idx: u64, slave_slot: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): point the controller at the ONE device this capability names. The address and the addressing mode both come from arity-one resolvers over the capability slot -- there is no parameter for either and no way to supply one. IC_TAR is only writable while the core is disabled (the LPSS instances are not synthesised with dynamic TAR update), so the sequence is disable, poll IC_ENABLE_STATUS to 0, write IC_TAR, enable, poll to 1 -- the same asynchronous-enable discipline as bring-up, reusing dw_i2c_wait_enable and therefore its two distinct bounded-timeout codes. Reusing LPSS_I2C_INIT_{DISABLE,ENABLE}_TIMEOUT rather than minting a third pair is deliberate: it is the identical operation failing for the identical reason, and a separate code would fragment the taxonomy without adding a fact. IC_TAR bit 12 selects 10-bit master addressing and is set from the row's mode, because a 7-bit device at 0x1A and a 10-bit device at 0x01A are different byte sequences on the wire. Finally IC_CLR_INTR is read, dropping anything a previous transfer or the firmware latched, so this transfer's first abort check cannot see somebody else's abort. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed dwx_st_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // ctrl
        mov r13, rsi;                    // slave slot

        mov rdi, r13;
        call i2c_slave_addr_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_st_lost;
        mov r14, rax;                    // addr

        mov rdi, r13;
        call i2c_slave_mode_of_slot;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_st_lost;
        mov r15, rax;                    // mode

        mov rdi, r12;
        call dw_i2c_select;
        cmp rax, 0;
        jne dwx_st_out;

        mov rdi, 0x6C;                   // IC_ENABLE
        xor rsi, rsi;
        call dw_i2c_poke;
        cmp rax, 0;
        jne dwx_st_out;

        xor rdi, rdi;
        call dw_i2c_wait_enable;
        cmp rax, 0;
        jne dwx_st_out;

        mov rbx, r14;
        mov r11, 0x3FF;                  // DW_TAR_ADDR_MASK
        and rbx, r11;
        cmp r15, 0;
        je  dwx_st_write_tar;
        mov r11, 0x1000;                 // DW_TAR_10BIT_MASTER
        or  rbx, r11;

      dwx_st_write_tar:
        mov rdi, 0x04;                   // IC_TAR
        mov rsi, rbx;
        call dw_i2c_poke;
        cmp rax, 0;
        jne dwx_st_out;

        mov rdi, 0x6C;
        mov rsi, 1;
        call dw_i2c_poke;
        cmp rax, 0;
        jne dwx_st_out;

        mov rdi, 1;
        call dw_i2c_wait_enable;
        cmp rax, 0;
        jne dwx_st_out;

        mov rdi, 0x40;                   // IC_CLR_INTR (read to clear)
        call dw_io_read32;

        xor rax, rax;
        jmp dwx_st_out;

      dwx_st_lost:
        mov rax, 0xFFFFFF6A;             // I2C_XFER_BUS_LOST

      dwx_st_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dw_xfer_check_abort() -> 0 | error
  // ==========================================================================

  pub let dw_xfer_check_abort : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): test for a transfer abort and, if there is one, LEAVE THE CONTROLLER USABLE. Reads IC_RAW_INTR_STAT; if TX_ABRT (bit 6) is clear, returns 0 having done nothing else. If it is set: reads IC_TX_ABRT_SOURCE, records it for the reply, and THEN READS IC_CLR_TX_ABRT -- which is not bookkeeping, it is the operation that releases the TX FIFO from the flush-held state the core entered on the abort. A path that returns the error without this read leaves the next transfer, by any driver, facing a latched abort it did not cause; the controller then looks broken and the customary fix is a reset that takes every other device on the bus with it. The read happens before any decoding, so no decode branch can skip it. Decoding: source bits [2:0] are the three address-NACK cases -> NACK_ADDR (nothing is there); bit 3 is a data NACK -> NACK_DATA (something is there and rejected a byte); bit 12 is arbitration lost -> ARB_LOST (another master won); anything else -> LPSS_I2C_ABORT_OTHER with the raw word retrievable. Three facts about the world, three codes. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed dwx_ca_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rdi, 0x34;                   // IC_RAW_INTR_STAT
        call dw_io_read32;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_ca_io;
        mov r12, rax;
        and r12, 0x40;                   // DW_INTR_TX_ABRT
        cmp r12, 0;
        je  dwx_ca_none;

        mov rdi, 0x80;                   // IC_TX_ABRT_SOURCE
        call dw_io_read32;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_ca_io;
        mov r13, rax;
        lea r10, [rip + _i2c_xfer_abort_src];
        mov [r10 + 0], r13;

        // MANDATORY: releases the flush-held TX FIFO.
        mov rdi, 0x54;                   // IC_CLR_TX_ABRT
        call dw_io_read32;

        mov r10, r13;
        and r10, 0x007;                  // DW_ABRT_ADDR_NOACK_ANY
        cmp r10, 0;
        jne dwx_ca_naddr;
        mov r10, r13;
        and r10, 0x008;                  // DW_ABRT_TXDATA_NOACK
        cmp r10, 0;
        jne dwx_ca_ndata;
        mov r10, r13;
        mov r11, 0x1000;                 // DW_ABRT_ARB_LOST
        and r10, r11;
        cmp r10, 0;
        jne dwx_ca_arb;
        mov rax, 0xFFFFFF4B;             // LPSS_I2C_ABORT_OTHER
        jmp dwx_ca_out;

      dwx_ca_naddr:
        mov rax, 0xFFFFFF63;             // I2C_XFER_NACK_ADDR
        jmp dwx_ca_out;
      dwx_ca_ndata:
        mov rax, 0xFFFFFF62;             // I2C_XFER_NACK_DATA
        jmp dwx_ca_out;
      dwx_ca_arb:
        mov rax, 0xFFFFFF61;             // I2C_XFER_ARB_LOST
        jmp dwx_ca_out;
      dwx_ca_io:
        mov rax, 0xFFFFFF50;             // LPSS_I2C_IO_FAULT
        jmp dwx_ca_out;
      dwx_ca_none:
        xor rax, rax;

      dwx_ca_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dw_xfer_push(cmd, budget) -> 0 | error
  // ==========================================================================

  pub let dw_xfer_push : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (cmd: u64, budget: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): push one IC_DATA_CMD entry, waiting bounded for TX FIFO room. Each iteration checks for an abort BEFORE checking for room, which is the order that matters: an aborted core flushes and HOLDS its TX FIFO, so TFNF never rises again, and a loop that only looked at TFNF would spend its whole budget waiting for space that the abort had already made unavailable -- turning a NACK, which should be an immediate clean error, into a timeout. Bounded by the caller's budget with I2C_XFER_TIMEOUT_TXFIFO on exhaustion, distinct from the RX and STOP timeouts because a stall here means the core is not draining, which is a different fault from a device that never answered. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed dwx_ps_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // cmd
        mov r13, rsi;                    // budget
        xor r14, r14;                    // iterations

      dwx_ps_next:
        cmp r14, r13;
        jae dwx_ps_timeout;

        call dw_xfer_check_abort;
        cmp rax, 0;
        jne dwx_ps_out;

        mov rdi, 0x70;                   // IC_STATUS
        call dw_io_read32;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_ps_io;
        mov r15, rax;
        and r15, 0x02;                   // DW_STATUS_TFNF
        cmp r15, 0;
        jne dwx_ps_go;

        add r14, 1;
        jmp dwx_ps_next;

      dwx_ps_go:
        mov rdi, 0x10;                   // IC_DATA_CMD
        mov rsi, r12;
        call dw_io_write32;
        cmp rax, 0;
        jne dwx_ps_io;
        xor rax, rax;
        jmp dwx_ps_out;

      dwx_ps_timeout:
        mov rax, 0xFFFFFF66;             // I2C_XFER_TIMEOUT_TXFIFO
        jmp dwx_ps_out;
      dwx_ps_io:
        mov rax, 0xFFFFFF50;             // LPSS_I2C_IO_FAULT

      dwx_ps_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dw_xfer_pop(budget) -> byte | error
  // ==========================================================================

  pub let dw_xfer_pop : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (budget: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): pop one received byte, waiting bounded for IC_STATUS.RFNE. Abort is checked first each iteration for the same reason as the push path: a device that NACKs the address will never deliver a byte, and a loop that only watched RFNE would convert an immediate, actionable 'nothing is there' into a timeout that says only 'something took too long'. Returns the byte masked to eight bits, so a caller can distinguish it from a code with one compare against I2C_XFER_ERR_FLOOR. I2C_XFER_TIMEOUT_RXFIFO on exhaustion. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed dwx_pp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r13, rdi;                    // budget
        xor r14, r14;

      dwx_pp_next:
        cmp r14, r13;
        jae dwx_pp_timeout;

        call dw_xfer_check_abort;
        cmp rax, 0;
        jne dwx_pp_out;

        mov rdi, 0x70;                   // IC_STATUS
        call dw_io_read32;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_pp_io;
        mov r15, rax;
        and r15, 0x08;                   // DW_STATUS_RFNE
        cmp r15, 0;
        jne dwx_pp_go;

        add r14, 1;
        jmp dwx_pp_next;

      dwx_pp_go:
        mov rdi, 0x10;                   // IC_DATA_CMD
        call dw_io_read32;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_pp_io;
        and rax, 0xFF;
        jmp dwx_pp_out;

      dwx_pp_timeout:
        mov rax, 0xFFFFFF65;             // I2C_XFER_TIMEOUT_RXFIFO
        jmp dwx_pp_out;
      dwx_pp_io:
        mov rax, 0xFFFFFF50;

      dwx_pp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dw_xfer_wait_stop(budget) -> 0 | error
  // ==========================================================================

  pub let dw_xfer_wait_stop : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (budget: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): wait bounded for IC_RAW_INTR_STAT.STOP_DET, then clear it by reading IC_CLR_STOP_DET. The clear is not optional: STOP_DET is level-latched, and a leftover bit would make the NEXT transfer's wait return immediately having observed the PREVIOUS transfer's stop -- a transfer that reports success before its own bytes have reached the wire. Abort is checked first each iteration; an aborted transfer never produces a STOP, so without that check every NACK would cost a full budget here after already having been diagnosed. I2C_XFER_TIMEOUT_STOP on exhaustion, and this is the timeout that means the bus is probably still held, which is why it is not shared with the other two. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed dwx_ws_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r13, rdi;
        xor r14, r14;

      dwx_ws_next:
        cmp r14, r13;
        jae dwx_ws_timeout;

        call dw_xfer_check_abort;
        cmp rax, 0;
        jne dwx_ws_out;

        mov rdi, 0x34;                   // IC_RAW_INTR_STAT
        call dw_io_read32;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  dwx_ws_io;
        mov r15, rax;
        mov r11, 0x200;                  // DW_INTR_STOP_DET
        and r15, r11;
        cmp r15, 0;
        jne dwx_ws_go;

        add r14, 1;
        jmp dwx_ws_next;

      dwx_ws_go:
        mov rdi, 0x60;                   // IC_CLR_STOP_DET
        call dw_io_read32;
        xor rax, rax;
        jmp dwx_ws_out;

      dwx_ws_timeout:
        mov rax, 0xFFFFFF64;             // I2C_XFER_TIMEOUT_STOP
        jmp dwx_ws_out;
      dwx_ws_io:
        mov rax, 0xFFFFFF50;

      dwx_ws_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_xfer_write(slave_slot, buf, len, budget) -> rc
  // ==========================================================================

  pub let i2c_xfer_write : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slave_slot: u64, buf: u64, len: u64, budget: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): an addressed write of len bytes terminated by a STOP. THE PARAMETER LIST HAS NO ADDRESS and tools/build.sh pins this literal signature line, so a mutant that adds one fails the build rather than the review; the device addressed is whichever one the capability in slave_slot names, resolved inside i2c_xfer_set_target. Requires INVOKE|WRITE (0x00A) -- a read-only capability is refused I2C_XFER_NO_WRITE_RIGHT before any register is touched. Length is validated in [1, I2C_XFER_MAX_LEN]: zero is refused rather than treated as a no-op, because address-plus-STOP is the SMBus Quick command this driver does not emit, and an unbounded upper end would make the per-wait budgets meaningless. The STOP flag rides on the LAST command word rather than being a separate operation, which is how DesignWare expresses it and is why the trace can be asked 'how many pushed commands carried STOP' and must answer one. A zero budget takes the channel default. Six pushes (48 B) + sub rsp, 8 gives rsp%16 == 0 at every nested call. Labels prefixed dwx_wr_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                    // slave_slot
        mov rbp, rsi;                    // buf
        mov r12, rdx;                    // len
        mov r13, rcx;                    // budget
        cmp r13, 0;
        jne dwx_wr_budget_ok;
        mov r13, 4096;                   // I2C_XFER_BUDGET_DEFAULT
      dwx_wr_budget_ok:

        lea r10, [rip + _i2c_xfer_abort_src];
        xor rax, rax;
        mov [r10 + 0], rax;

        mov rdi, r12;
        call i2c_xfer_len_valid;
        cmp rax, 1;
        jne dwx_wr_badlen;

        mov rdi, rbx;
        mov rsi, 0x00A;                  // INVOKE | WRITE
        call i2c_xfer_resolve;
        mov r11, 0xFFFFFF30;             // I2C_XFER_ERR_FLOOR
        cmp rax, r11;
        jae dwx_wr_out;
        mov r15, rax;                    // ctrl

        // R30.M5-005 (#1074): ONE OWNER PER CONTROLLER, ACROSS BOTH
        // ENGINES. Until this claim existed, two CPUs could run polled
        // transfers against one controller and interleave their
        // IC_DATA_CMD writes into a single FIFO -- one device's bytes
        // delivered to another's address, with no error anywhere. R18
        // landed SMP and nothing had closed that. It is the same claim
        // the interrupt engine takes, so a polled transfer and an
        // interrupt-driven one can never be in flight on the same wire
        // either.
        mov rdi, r15;
        call dw_irq_claim;
        cmp rax, 0;
        jne dwx_wr_out;

        mov rdi, r15;
        mov rsi, rbx;
        call i2c_xfer_set_target;
        cmp rax, 0;
        jne dwx_wr_rel;

        xor r14, r14;                    // i

      dwx_wr_next:
        cmp r14, r12;
        jae dwx_wr_stop;

        mov r10, rbp;
        add r10, r14;
        xor rdi, rdi;
        mov_b rdi, [r10 + 0];
        and rdi, 0xFF;

        mov r10, r12;
        sub r10, 1;
        cmp r14, r10;
        jne dwx_wr_send;
        mov r11, 0x200;                  // DW_CMD_STOP on the last byte
        or  rdi, r11;

      dwx_wr_send:
        mov rsi, r13;
        call dw_xfer_push;
        cmp rax, 0;
        jne dwx_wr_rel;

        add r14, 1;
        jmp dwx_wr_next;

      dwx_wr_stop:
        mov rdi, r13;
        call dw_xfer_wait_stop;

        // Every exit past the claim releases it, success and failure
        // alike. A claim held past a failed transfer would convert one
        // stuck device into a controller nobody can ever use again;
        // that is what the wedge latch is for, and it is reached
        // deliberately rather than by leaking a claim.
      dwx_wr_rel:
        mov [rsp + 0], rax;
        mov rdi, r15;
        call dw_irq_release;
        mov rax, [rsp + 0];
        jmp dwx_wr_out;

      dwx_wr_badlen:
        mov rax, 0xFFFFFF67;             // I2C_XFER_BAD_LEN

      dwx_wr_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_xfer_read(slave_slot, buf, len, budget) -> rc
  // ==========================================================================

  pub let i2c_xfer_read : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slave_slot: u64, buf: u64, len: u64, budget: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): an addressed read of len bytes terminated by a STOP. No address parameter; signature pinned. Requires INVOKE|READ (0x009) -- a write-only capability is refused I2C_XFER_NO_READ_RIGHT. Each byte is a pushed read COMMAND followed by a popped byte, interleaved rather than pushing all commands first and draining afterwards. Interleaving is slower and is chosen anyway: batch-pushing requires the driver to model the core's RX FIFO depth, and a driver that models a depth wrong overruns the FIFO and loses bytes with no error -- the depth is a synthesis parameter that varies between instances of the same IP. Interleaved, the transfer is correct on an instance with a one-entry FIFO. Six pushes + sub rsp, 8 gives rsp%16 == 0 at every nested call. Labels prefixed dwx_rd_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;
        mov rbp, rsi;
        mov r12, rdx;
        mov r13, rcx;
        cmp r13, 0;
        jne dwx_rd_budget_ok;
        mov r13, 4096;
      dwx_rd_budget_ok:

        lea r10, [rip + _i2c_xfer_abort_src];
        xor rax, rax;
        mov [r10 + 0], rax;

        mov rdi, r12;
        call i2c_xfer_len_valid;
        cmp rax, 1;
        jne dwx_rd_badlen;

        mov rdi, rbx;
        mov rsi, 0x009;                  // INVOKE | READ
        call i2c_xfer_resolve;
        mov r11, 0xFFFFFF30;
        cmp rax, r11;
        jae dwx_rd_out;
        mov r15, rax;

        mov rdi, r15;
        call dw_irq_claim;               // see i2c_xfer_write
        cmp rax, 0;
        jne dwx_rd_out;

        mov rdi, r15;
        mov rsi, rbx;
        call i2c_xfer_set_target;
        cmp rax, 0;
        jne dwx_rd_rel;

        xor r14, r14;

      dwx_rd_next:
        cmp r14, r12;
        jae dwx_rd_stop;

        mov rdi, 0x100;                  // DW_CMD_READ
        mov r10, r12;
        sub r10, 1;
        cmp r14, r10;
        jne dwx_rd_send;
        mov r11, 0x200;
        or  rdi, r11;

      dwx_rd_send:
        mov rsi, r13;
        call dw_xfer_push;
        cmp rax, 0;
        jne dwx_rd_rel;

        mov rdi, r13;
        call dw_xfer_pop;
        mov r11, 0xFFFFFF30;
        cmp rax, r11;
        jae dwx_rd_rel;

        mov r10, rbp;
        add r10, r14;
        mov_b [r10 + 0], rax;

        add r14, 1;
        jmp dwx_rd_next;

      dwx_rd_stop:
        mov rdi, r13;
        call dw_xfer_wait_stop;

      dwx_rd_rel:
        mov [rsp + 0], rax;
        mov rdi, r15;
        call dw_irq_release;
        mov rax, [rsp + 0];
        jmp dwx_rd_out;

      dwx_rd_badlen:
        mov rax, 0xFFFFFF67;

      dwx_rd_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_xfer_write_read(slave_slot, wbuf, wlen, rbuf, rlen, budget) -> rc
  //
  // REPEATED START. The reason this is one operation and not two.
  // ==========================================================================

  pub let i2c_xfer_write_read : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slave_slot: u64, wbuf: u64, wlen: u64, rbuf: u64, rlen: u64, budget: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): write wlen bytes, then REPEATED START, then read rlen bytes, then STOP. No address parameter; signature pinned. THE REPEATED START IS THE WHOLE POINT. Nearly every register read on an I2C part is 'write the register pointer, then read', and the two halves must not be separated by a STOP: a STOP releases the bus, at which point another master may take it or the part may time out its own pointer, and the read that follows returns a different register's contents with no error anywhere. So NO write-phase command carries DW_CMD_STOP, the FIRST read command carries DW_CMD_RESTART, and only the LAST read command carries DW_CMD_STOP -- which is exactly the claim the witness checks from the trace, by counting how many IC_DATA_CMD writes had each flag: one RESTART, one STOP, and the STOP on a read command rather than a write one. Expressing this as two calls would push the atomicity onto the caller, who cannot supply it because it does not own the bus between them. Requires INVOKE|READ|WRITE (0x00B): the write half is a write however short, and a read-only holder must not leave a shared part pointed somewhere its owner did not choose. Both lengths are validated. Six pushes + sub rsp, 24; entry rsp%16 == 8, 48 pushed -> 56, sub 24 -> 80, %16 == 0. Scratch: [rsp+0] rbuf, [rsp+8] rlen, [rsp+16] ctrl. Labels prefixed dwx_wrr_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        mov rbx, rdi;                    // slave_slot
        mov rbp, rsi;                    // wbuf
        mov r12, rdx;                    // wlen
        mov [rsp + 0], rcx;              // rbuf
        mov [rsp + 8], r8;               // rlen
        mov r13, r9;                     // budget
        cmp r13, 0;
        jne dwx_wrr_budget_ok;
        mov r13, 4096;
      dwx_wrr_budget_ok:

        lea r10, [rip + _i2c_xfer_abort_src];
        xor rax, rax;
        mov [r10 + 0], rax;

        mov rdi, r12;
        call i2c_xfer_len_valid;
        cmp rax, 1;
        jne dwx_wrr_badlen;
        mov rdi, [rsp + 8];
        call i2c_xfer_len_valid;
        cmp rax, 1;
        jne dwx_wrr_badlen;

        mov rdi, rbx;
        mov rsi, 0x00B;                  // INVOKE | READ | WRITE
        call i2c_xfer_resolve;
        mov r11, 0xFFFFFF30;
        cmp rax, r11;
        jae dwx_wrr_out;
        mov [rsp + 16], rax;

        mov rdi, [rsp + 16];
        call dw_irq_claim;               // see i2c_xfer_write
        cmp rax, 0;
        jne dwx_wrr_out;

        mov rdi, [rsp + 16];
        mov rsi, rbx;
        call i2c_xfer_set_target;
        cmp rax, 0;
        jne dwx_wrr_rel;

        // ---- write phase: NO command carries STOP ----
        xor r14, r14;
      dwx_wrr_wnext:
        cmp r14, r12;
        jae dwx_wrr_rphase;

        mov r10, rbp;
        add r10, r14;
        xor rdi, rdi;
        mov_b rdi, [r10 + 0];
        and rdi, 0xFF;
        mov rsi, r13;
        call dw_xfer_push;
        cmp rax, 0;
        jne dwx_wrr_rel;
        add r14, 1;
        jmp dwx_wrr_wnext;

        // ---- read phase: first carries RESTART, last carries STOP ----
      dwx_wrr_rphase:
        xor r14, r14;
      dwx_wrr_rnext:
        mov r15, [rsp + 8];
        cmp r14, r15;
        jae dwx_wrr_stop;

        mov rdi, 0x100;                  // DW_CMD_READ
        cmp r14, 0;
        jne dwx_wrr_notfirst;
        mov r11, 0x400;                  // DW_CMD_RESTART
        or  rdi, r11;
      dwx_wrr_notfirst:
        mov r10, r15;
        sub r10, 1;
        cmp r14, r10;
        jne dwx_wrr_send;
        mov r11, 0x200;                  // DW_CMD_STOP
        or  rdi, r11;

      dwx_wrr_send:
        mov rsi, r13;
        call dw_xfer_push;
        cmp rax, 0;
        jne dwx_wrr_rel;

        mov rdi, r13;
        call dw_xfer_pop;
        mov r11, 0xFFFFFF30;
        cmp rax, r11;
        jae dwx_wrr_rel;

        mov r10, [rsp + 0];
        add r10, r14;
        mov_b [r10 + 0], rax;

        add r14, 1;
        jmp dwx_wrr_rnext;

      dwx_wrr_stop:
        mov rdi, r13;
        call dw_xfer_wait_stop;

      dwx_wrr_rel:
        mov [rsp + 24], rax;
        mov rdi, [rsp + 16];
        call dw_irq_release;
        mov rax, [rsp + 24];
        jmp dwx_wrr_out;

      dwx_wrr_badlen:
        mov rax, 0xFFFFFF67;

      dwx_wrr_out:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_smbus_op(slave_slot, proto, command, buf, budget) -> rc
  // ==========================================================================

  pub let i2c_smbus_op : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slave_slot: u64, proto: u64, command: u64, buf: u64, budget: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): the SMBus protocols, expressed on top of the three I2C primitives rather than beside them. No address parameter; signature pinned. Each supported protocol is a delegation: BYTE_WRITE is a one-byte write of the command; BYTE_READ is a one-byte read; BYTE_DATA_WRITE and WORD_DATA_WRITE are two- and three-byte writes assembled in stack scratch; BYTE_DATA_READ and WORD_DATA_READ are combined write-then-read transfers, which is what gives them their repeated START for free -- and they NEED it, because an SMBus register read separated by a STOP is the exact transaction that returns a neighbouring register's contents on a part that times out its pointer. Delegation rather than a parallel implementation is the point: the rights checks, the bounded waits, the abort handling and the repeated-START discipline exist once, so an SMBus transfer cannot acquire a bug the I2C path does not have. QUICK and the two BLOCK forms are refused LPSS_I2C_SMBUS_UNSUPPORTED with reasons recorded in xfer_schema.pdx -- Quick because DesignWare cannot emit an address-only transaction, BLOCK because its length arrives from the device mid-transfer and a device-chosen length into a caller's buffer is not something this schema expresses. The refusal is loud and early, before any bus state is touched. Six pushes + sub rsp, 24; scratch [rsp+0..7] is the assembled command buffer. Labels prefixed dwx_sm_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                    // slave_slot
        mov rbp, rsi;                    // proto
        mov r12, rdx;                    // command
        mov r13, rcx;                    // buf
        mov r14, r8;                     // budget

        mov rdi, rbp;
        call i2c_smbus_proto_rights;
        cmp rax, 0;
        je  dwx_sm_unsup;

        // Assemble the outgoing bytes into scratch.
        mov r10, rsp;
        mov_b [r10 + 0], r12;            // command byte

        cmp rbp, 1;                      // BYTE_WRITE
        je  dwx_sm_w1;
        cmp rbp, 2;                      // BYTE_READ
        je  dwx_sm_r1;
        cmp rbp, 3;                      // BYTE_DATA_WRITE
        je  dwx_sm_w2;
        cmp rbp, 4;                      // BYTE_DATA_READ
        je  dwx_sm_wr1;
        cmp rbp, 5;                      // WORD_DATA_WRITE
        je  dwx_sm_w3;
        cmp rbp, 6;                      // WORD_DATA_READ
        je  dwx_sm_wr2;
        jmp dwx_sm_unsup;

      dwx_sm_w1:
        mov rdi, rbx;
        mov rsi, rsp;
        mov rdx, 1;
        mov rcx, r14;
        call i2c_xfer_write;
        jmp dwx_sm_out;

      dwx_sm_r1:
        mov rdi, rbx;
        mov rsi, r13;
        mov rdx, 1;
        mov rcx, r14;
        call i2c_xfer_read;
        jmp dwx_sm_out;

      dwx_sm_w2:
        mov r10, rsp;
        xor rax, rax;
        mov_b rax, [r13 + 0];
        mov_b [r10 + 1], rax;
        mov rdi, rbx;
        mov rsi, rsp;
        mov rdx, 2;
        mov rcx, r14;
        call i2c_xfer_write;
        jmp dwx_sm_out;

      dwx_sm_w3:
        mov r10, rsp;
        xor rax, rax;
        mov_b rax, [r13 + 0];
        mov_b [r10 + 1], rax;
        xor rax, rax;
        mov_b rax, [r13 + 1];
        mov_b [r10 + 2], rax;
        mov rdi, rbx;
        mov rsi, rsp;
        mov rdx, 3;
        mov rcx, r14;
        call i2c_xfer_write;
        jmp dwx_sm_out;

      dwx_sm_wr1:
        mov rdi, rbx;
        mov rsi, rsp;
        mov rdx, 1;
        mov rcx, r13;
        mov r8,  1;
        mov r9,  r14;
        call i2c_xfer_write_read;
        jmp dwx_sm_out;

      dwx_sm_wr2:
        mov rdi, rbx;
        mov rsi, rsp;
        mov rdx, 1;
        mov rcx, r13;
        mov r8,  2;
        mov r9,  r14;
        call i2c_xfer_write_read;
        jmp dwx_sm_out;

      dwx_sm_unsup:
        mov rax, 0xFFFFFF4C;             // LPSS_I2C_SMBUS_UNSUPPORTED

      dwx_sm_out:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // i2c_bus_recover(ctrl_idx) -> rc
  //
  // TIER 1: the controller-side escape. See the file header for what
  // tier 2 is and why it is deferred.
  // ==========================================================================

  pub let i2c_bus_recover : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (ctrl_idx: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-004 (#1073): tier-1 bus recovery. Sets IC_ENABLE.ABORT, which makes the core drive a STOP and terminate whatever transaction it was in; waits bounded for the resulting TX_ABRT; clears it through dw_xfer_check_abort, which also reads IC_CLR_TX_ABRT and so releases the flush-held TX FIFO; then cycles the controller disabled and enabled, each with its own bounded wait. That recovers every case where the MASTER is the stuck party. It does NOT recover a peripheral holding SDA low -- that needs SCL pulsed with the controller off the pins, which is pin authority this driver does not hold and R30.M6's KIND_GPIO_LINE will. Failure is counted, not merely returned: three CONSECUTIVE failures latch the wedged bit, after which every transfer on this bus fails fast with I2C_XFER_BUS_WEDGED instead of each caller burning a full budget. Three and not one, because a single failed abort can be a transient arbitration loss against a peer master and declaring a recoverable machine dead on the first one is not the conservative choice. A success clears the counter but deliberately does NOT clear the latch; the exit from wedged is lpss_i2c_unwedge, whose caller is the tier-2 recovery. Note the expected TX_ABRT here carries ABRT_USER_ABRT -- our own abort coming back -- so check_abort's decode lands on LPSS_I2C_ABORT_OTHER, which is the RIGHT answer and is why success is judged by the enable cycle rather than by that code. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed dwx_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // ctrl

        mov rdi, r12;
        call dw_i2c_select;
        cmp rax, 0;
        jne dwx_rc_fail;

        mov rdi, 0x6C;                   // IC_ENABLE
        mov rsi, 0x3;                    // ENABLE | ABORT
        call dw_i2c_poke;
        cmp rax, 0;
        jne dwx_rc_fail;

        // Bounded wait for the abort to be reported.
        xor r14, r14;
      dwx_rc_next:
        cmp r14, 1000;                   // DW_ENABLE_POLL_MAX
        jae dwx_rc_timeout;
        call dw_xfer_check_abort;
        cmp rax, 0;
        jne dwx_rc_cycled;
        add r14, 1;
        jmp dwx_rc_next;

      dwx_rc_cycled:
        mov rdi, 0x6C;
        xor rsi, rsi;
        call dw_i2c_poke;
        cmp rax, 0;
        jne dwx_rc_fail;
        xor rdi, rdi;
        call dw_i2c_wait_enable;
        cmp rax, 0;
        jne dwx_rc_fail;

        mov rdi, 0x6C;
        mov rsi, 1;
        call dw_i2c_poke;
        cmp rax, 0;
        jne dwx_rc_fail;
        mov rdi, 1;
        call dw_i2c_wait_enable;
        cmp rax, 0;
        jne dwx_rc_fail;

        mov rdi, r12;
        call lpss_i2c_note_recover_ok;
        xor rax, rax;
        jmp dwx_rc_out;

      dwx_rc_timeout:
        mov rdi, r12;
        call lpss_i2c_note_recover_fail;
        mov rdi, r12;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 0;
        jne dwx_rc_wedged;
        mov rax, 0xFFFFFF4F;             // LPSS_I2C_RECOVER_TIMEOUT
        jmp dwx_rc_out;

      dwx_rc_fail:
        mov rdi, r12;
        call lpss_i2c_note_recover_fail;
        mov rdi, r12;
        call lpss_i2c_ctrl_wedged;
        cmp rax, 0;
        jne dwx_rc_wedged;
        mov rax, 0xFFFFFF4E;             // LPSS_I2C_RECOVER_FAILED
        jmp dwx_rc_out;

      dwx_rc_wedged:
        mov rax, 0xFFFFFF60;             // I2C_XFER_BUS_WEDGED

      dwx_rc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
