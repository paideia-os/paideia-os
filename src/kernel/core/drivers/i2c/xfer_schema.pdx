// src/kernel/core/drivers/i2c/xfer_schema.pdx — R30.M5-004 (#1073)
//
// `i2c_transfer_channel` — the session-typed RPC schema over which a
// device driver performs I²C transactions.
//
// Wire specification: `design/drivers/i2c-transfer-schema.md`.
// This file is the single source of truth for the numeric constants.
//
// -----------------------------------------------------------------------------
// THE SHAPE OF THE SESSION
// -----------------------------------------------------------------------------
//
// A session is opened by presenting a `Cap<KIND_I2C_SLAVE>`. The
// capability is bound at open and every request on the session carries
// its handle. What the session does NOT carry, anywhere, in any
// revision, is a device address.
//
// This is the point of the milestone expressed at the protocol layer.
// `KIND_I2C_SLAVE` exists because I²C is a shared bus on which a
// controller can address every peripheral; a capability that names one
// address is only isolation if the address cannot come from anywhere
// else. A request record with an `addr` field would make "address a
// device other than the one my capability names" a well-formed
// request — refused by a check, perhaps, and therefore refusable only
// as long as someone remembers to keep the check.
//
// Instead:
//
//   * the request record has no address field;
//   * the two reserved fields are `must be zero`, so a later revision
//     cannot quietly repurpose one without a version bump that a
//     decoder will reject;
//   * the kernel primitives the opcodes decode onto
//     (`i2c_xfer_write`, `i2c_xfer_read`, `i2c_xfer_write_read`,
//     `i2c_smbus_op`) all take a capability slot and NO address, and
//     `tools/build.sh` pins their literal signatures so a mutant that
//     adds one fails the build;
//   * the resolvers those primitives use — `i2c_slave_addr_of_slot`,
//     `i2c_slave_mode_of_slot`, `i2c_slave_bus_row_of_slot` — are all
//     arity one and pinned as well.
//
// -----------------------------------------------------------------------------
// OPCODES (v1)
// -----------------------------------------------------------------------------
//
//   0x01  WRITE        n bytes, addressed write, STOP at the end
//   0x02  READ         n bytes, addressed read, STOP at the end
//   0x03  WRITE_READ   m bytes written, REPEATED START, n bytes read
//   0x04  SMBUS        one of the SMBus protocols below
//
// Replies carry the request opcode with bit 7 set (0x81..0x84), the
// convention `ipc/frame.pdx` and `driver_lifecycle_channel` already use.
//
// WRITE_READ is not a convenience wrapper over WRITE followed by READ,
// and the difference is the whole reason it is a distinct opcode. Nearly
// every register read on an I²C part is "write the register pointer,
// then read" — and the two halves must not be separated by a STOP. A
// STOP releases the bus, at which point another master may take it, or
// the part may time out its own internal pointer, and the read that
// follows returns a different register's contents with no error
// anywhere. The repeated START keeps the bus held across the turnaround.
// Expressing it as two requests would make the atomicity the caller's
// problem, and the caller cannot solve it: it does not own the bus
// between them.
//
// -----------------------------------------------------------------------------
// SMBUS PROTOCOLS
// -----------------------------------------------------------------------------
//
//   0x01  BYTE_WRITE        write {command}
//   0x02  BYTE_READ         read 1
//   0x03  BYTE_DATA_WRITE   write {command, data0}
//   0x04  BYTE_DATA_READ    write {command} : read 1
//   0x05  WORD_DATA_WRITE   write {command, data0, data1}
//   0x06  WORD_DATA_READ    write {command} : read 2
//
// Refused, each for a stated reason rather than silently absent:
//
//   0x00  QUICK             The SMBus Quick command is address plus the
//                           R/W bit and NOTHING ELSE. A DesignWare
//                           transaction begins when an entry is pushed
//                           into IC_DATA_CMD, and there is no entry that
//                           means "start and stop with no data byte", so
//                           the core cannot emit it. Refusing is honest;
//                           substituting a one-byte write would be a
//                           different transaction on the wire, and on
//                           parts that use Quick as an on/off switch it
//                           would write a byte into whatever register the
//                           part's pointer happened to hold.
//   0x07  BLOCK_WRITE
//   0x08  BLOCK_READ        SMBus block transfers carry their length in
//                           the first byte, so a block READ must read one
//                           byte, learn the length, and continue — a
//                           length discovered mid-transfer. The bounded
//                           buffer contract here has the caller declare
//                           the length up front, and a schema that let a
//                           device choose how many bytes to write into a
//                           caller's buffer is a schema with a
//                           device-controlled length. Deferred until the
//                           session grows an explicit two-phase form.
//
// -----------------------------------------------------------------------------
// BOUNDS
// -----------------------------------------------------------------------------
//
// `I2C_XFER_MAX_LEN` caps each direction. An unbounded length would
// make the per-transfer wait budget meaningless: a transfer of
// unbounded length has unbounded duration however tightly each
// individual wait is bounded, and "every wait is bounded" would then be
// true and useless.
//
//   Reserved-label discipline: labels prefixed `ixs_`.

module XferSchema = structure {

  // ==========================================================================
  // Opcodes
  // ==========================================================================

  pub let I2C_XFER_OP_WRITE      : u64 = 0x01
  pub let I2C_XFER_OP_READ       : u64 = 0x02
  pub let I2C_XFER_OP_WRITE_READ : u64 = 0x03
  pub let I2C_XFER_OP_SMBUS      : u64 = 0x04
  pub let I2C_XFER_OP_MAX        : u64 = 0x04

  pub let I2C_XFER_REPLY_BIT     : u64 = 0x80

  // ==========================================================================
  // Record sizes and field offsets
  // ==========================================================================
  //
  // I2cXferReq — 24 bytes fixed
  //   +0  u16 slave_cap      cap_table slot of the Cap<KIND_I2C_SLAVE>
  //   +2  u8  op
  //   +3  u8  smbus_proto    (op == SMBUS only; 0 otherwise)
  //   +4  u8  smbus_command  (op == SMBUS only; 0 otherwise)
  //   +5  u8  flags          reserved, MUST BE ZERO
  //   +6  u16 wr_len
  //   +8  u16 rd_len
  //   +10 u16 _reserved      MUST BE ZERO
  //   +12 u32 budget         bounded-wait iteration budget; 0 = default
  //   +16 u64 buf_offset     offset into the session's shared buffer
  //
  // There is no address field, and the two MUST-BE-ZERO fields are the
  // reason a later revision cannot add one without a decoder noticing.
  //
  // I2cXferRep — 16 bytes fixed
  //   +0  u16 slave_cap      echoed
  //   +2  u8  op | 0x80
  //   +3  u8  _pad
  //   +4  u32 rc
  //   +8  u16 rd_len_actual
  //   +10 u16 _pad2
  //   +12 u32 abort_source   raw IC_TX_ABRT_SOURCE on an abort, else 0

  pub let I2C_XFER_REQ_SIZE : u64 = 24
  pub let I2C_XFER_REP_SIZE : u64 = 16

  pub let I2C_XFER_REQ_OFF_SLAVE_CAP : u64 = 0
  pub let I2C_XFER_REQ_OFF_OP        : u64 = 2
  pub let I2C_XFER_REQ_OFF_PROTO     : u64 = 3
  pub let I2C_XFER_REQ_OFF_COMMAND   : u64 = 4
  pub let I2C_XFER_REQ_OFF_FLAGS     : u64 = 5
  pub let I2C_XFER_REQ_OFF_WR_LEN    : u64 = 6
  pub let I2C_XFER_REQ_OFF_RD_LEN    : u64 = 8
  pub let I2C_XFER_REQ_OFF_RSVD      : u64 = 10
  pub let I2C_XFER_REQ_OFF_BUDGET    : u64 = 12
  pub let I2C_XFER_REQ_OFF_BUF       : u64 = 16

  pub let I2C_XFER_REP_OFF_SLAVE_CAP : u64 = 0
  pub let I2C_XFER_REP_OFF_OP        : u64 = 2
  pub let I2C_XFER_REP_OFF_RC        : u64 = 4
  pub let I2C_XFER_REP_OFF_RD_LEN    : u64 = 8
  pub let I2C_XFER_REP_OFF_ABORT     : u64 = 12

  // ==========================================================================
  // SMBus protocols
  // ==========================================================================

  pub let I2C_SMBUS_QUICK            : u64 = 0x00
  pub let I2C_SMBUS_BYTE_WRITE       : u64 = 0x01
  pub let I2C_SMBUS_BYTE_READ        : u64 = 0x02
  pub let I2C_SMBUS_BYTE_DATA_WRITE  : u64 = 0x03
  pub let I2C_SMBUS_BYTE_DATA_READ   : u64 = 0x04
  pub let I2C_SMBUS_WORD_DATA_WRITE  : u64 = 0x05
  pub let I2C_SMBUS_WORD_DATA_READ   : u64 = 0x06
  pub let I2C_SMBUS_BLOCK_WRITE      : u64 = 0x07
  pub let I2C_SMBUS_BLOCK_READ       : u64 = 0x08

  // ==========================================================================
  // Bounds
  // ==========================================================================

  pub let I2C_XFER_MAX_LEN        : u64 = 256
  pub let I2C_XFER_BUDGET_DEFAULT : u64 = 4096

  // ==========================================================================
  // Failure taxonomy — band 0xFFFFFF60..0xFFFFFF6F
  //
  // Sixteen codes, the exact width of the band. Disjoint from
  // DW_IO_* (0xFFFFFF30..3F), LPSS_I2C_* (0xFFFFFF40..5F),
  // I2C_SLAVE_* (0xFFFFFF70..7F), I2C_BUS_* (0xFFFFFF83..8F) and every
  // other kind's band.
  //
  // The three refusal codes that carry the milestone's meaning are
  // NO_INVOKE, NO_READ_RIGHT and NO_WRITE_RIGHT, and they are three and
  // not one on purpose: "you may not transact at all", "this capability
  // is write-only" and "this capability is read-only" are three
  // different sentences, and a sensor that a driver may read but must
  // never program is a real and common arrangement whose enforcement
  // should be legible when it fires.
  //
  // The three timeout codes are likewise separate. A transfer that
  // stalls waiting for TX FIFO space, one that stalls waiting for a
  // byte to arrive, and one that stalls waiting for the STOP to appear
  // have failed at three different points in the transaction, and only
  // the third of them means the bus is likely still held.
  // ==========================================================================

  pub let I2C_XFER_OK              : u64 = 0
  pub let I2C_XFER_BAD_SLOT        : u64 = 0xFFFFFF6F
  pub let I2C_XFER_WRONG_KIND      : u64 = 0xFFFFFF6E
  pub let I2C_XFER_NO_INVOKE       : u64 = 0xFFFFFF6D
  pub let I2C_XFER_NO_READ_RIGHT   : u64 = 0xFFFFFF6C
  pub let I2C_XFER_NO_WRITE_RIGHT  : u64 = 0xFFFFFF6B
  pub let I2C_XFER_BUS_LOST        : u64 = 0xFFFFFF6A
  pub let I2C_XFER_NO_CONTROLLER   : u64 = 0xFFFFFF69
  pub let I2C_XFER_NOT_READY       : u64 = 0xFFFFFF68
  pub let I2C_XFER_BAD_LEN         : u64 = 0xFFFFFF67
  pub let I2C_XFER_TIMEOUT_TXFIFO  : u64 = 0xFFFFFF66
  pub let I2C_XFER_TIMEOUT_RXFIFO  : u64 = 0xFFFFFF65
  pub let I2C_XFER_TIMEOUT_STOP    : u64 = 0xFFFFFF64
  pub let I2C_XFER_NACK_ADDR       : u64 = 0xFFFFFF63
  pub let I2C_XFER_NACK_DATA       : u64 = 0xFFFFFF62
  pub let I2C_XFER_ARB_LOST        : u64 = 0xFFFFFF61
  pub let I2C_XFER_BUS_WEDGED      : u64 = 0xFFFFFF60

  // Every code this driver family can return is >= this value, and no
  // valid length, byte or row id is. One compare distinguishes an
  // outcome from a refusal.
  pub let I2C_XFER_ERR_FLOOR       : u64 = 0xFFFFFF30

  // ==========================================================================
  // i2c_xfer_op_valid(op) -> 1 | 0
  // ==========================================================================

  pub let i2c_xfer_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-004 (#1073): 1 iff op is one of the four v1 opcodes. Written as a range because the four are contiguous by construction and a gap would be a mistake in the table above rather than a deliberate reservation; if v2 adds a non-contiguous opcode this becomes a compare chain. Pure leaf. Reserved labels: ixs_ov_.",
      block: {
        cmp rdi, 1;
        jb  ixs_ov_no;
        cmp rdi, 4;
        ja  ixs_ov_no;
        mov rax, 1;
        ret;
      ixs_ov_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_xfer_op_rights(op) -> required slave rights mask
  // ==========================================================================

  pub let i2c_xfer_op_rights : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-004 (#1073): the slave rights an opcode requires, INVOKE plus the per-direction bits. WRITE needs 0x00A (INVOKE|WRITE); READ needs 0x009 (INVOKE|READ); WRITE_READ needs 0x00B (both), because it genuinely does both -- a capability that may read a sensor but not program it must be refused a combined register read, since the write half is a write however short it is, and 'it is only a register pointer' is precisely the argument by which a device gets reconfigured by a component that was only supposed to look at it. SMBUS returns 0x00B for the same reason: the sub-protocol decides the real requirement, and demanding the union up front would refuse a legitimate read-only BYTE_READ, so the SMBus path re-derives its own mask per protocol and this value is only the entry gate. Unknown ops return 0, which no rights word satisfies as a REQUIREMENT -- but the caller checks i2c_xfer_op_valid first, so 0 is unreachable rather than permissive. Pure leaf. Reserved labels: ixs_or_.",
      block: {
        cmp rdi, 1;                      // WRITE
        je  ixs_or_w;
        cmp rdi, 2;                      // READ
        je  ixs_or_r;
        cmp rdi, 3;                      // WRITE_READ
        je  ixs_or_rw;
        cmp rdi, 4;                      // SMBUS
        je  ixs_or_rw;
        xor rax, rax;
        ret;
      ixs_or_w:
        mov rax, 0x00A;
        ret;
      ixs_or_r:
        mov rax, 0x009;
        ret;
      ixs_or_rw:
        mov rax, 0x00B;
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_smbus_proto_rights(proto) -> required rights | 0 when unsupported
  // ==========================================================================

  pub let i2c_smbus_proto_rights : (u64) -> u64 !{} @{} =
    fn (proto: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-004 (#1073): the rights an SMBus sub-protocol requires, or 0 for one this driver refuses. The read-type protocols that begin by writing a command byte (BYTE_DATA_READ, WORD_DATA_READ) require WRITE as well as READ, and that is not pedantry: the command byte moves the device's internal register pointer, which is a state change the device will still be in after the transfer, and a component holding a read-only capability must not be able to leave a shared part pointed somewhere its owner did not choose. BYTE_READ requires only READ because it writes nothing. QUICK and the two BLOCK forms return 0 -- refused, with the reasons in the file header, and refused HERE rather than deeper so a caller learns 'unsupported' before any bus state is touched. Pure leaf. Reserved labels: ixs_sr_.",
      block: {
        cmp rdi, 1;                      // BYTE_WRITE
        je  ixs_sr_w;
        cmp rdi, 2;                      // BYTE_READ
        je  ixs_sr_r;
        cmp rdi, 3;                      // BYTE_DATA_WRITE
        je  ixs_sr_w;
        cmp rdi, 4;                      // BYTE_DATA_READ
        je  ixs_sr_rw;
        cmp rdi, 5;                      // WORD_DATA_WRITE
        je  ixs_sr_w;
        cmp rdi, 6;                      // WORD_DATA_READ
        je  ixs_sr_rw;
        xor rax, rax;
        ret;
      ixs_sr_w:
        mov rax, 0x00A;
        ret;
      ixs_sr_r:
        mov rax, 0x009;
        ret;
      ixs_sr_rw:
        mov rax, 0x00B;
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_xfer_len_valid(len) -> 1 | 0
  // ==========================================================================

  pub let i2c_xfer_len_valid : (u64) -> u64 !{} @{} =
    fn (len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-004 (#1073): 1 iff len is in [1, I2C_XFER_MAX_LEN]. Zero is refused rather than treated as a no-op: a zero-length I2C transfer is address-plus-STOP, which is the SMBus Quick command this driver refuses to emit, so accepting a zero length would mean silently doing nothing where a caller asked for a presence probe. The upper bound is what makes 'every wait is bounded' worth stating -- an unbounded length has unbounded duration however tightly each individual wait is bounded. Pure leaf. Reserved labels: ixs_lv_.",
      block: {
        cmp rdi, 1;
        jb  ixs_lv_no;
        mov r10, 256;                    // I2C_XFER_MAX_LEN
        cmp rdi, r10;
        ja  ixs_lv_no;
        mov rax, 1;
        ret;
      ixs_lv_no:
        xor rax, rax;
        ret
      }
    } @no_frame
}
