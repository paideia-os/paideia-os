// src/kernel/core/drivers/i2c/dw_io.pdx — R30.M5-003 (#1072)
//
// THE register-access seam for the LPSS I²C controller.
//
// Two things live here and nowhere else: the capability check that
// stands between this driver and the controller's registers, and the
// ordered access trace that makes the bring-up ordering checkable.
//
// -----------------------------------------------------------------------------
// 1. THE BAR IS REACHED THROUGH A CAPABILITY, NOT AN ADDRESS
// -----------------------------------------------------------------------------
//
// `dw_io_read32(off)` and `dw_io_write32(off, val)` take an OFFSET.
// There is no entry point in this module that accepts a physical
// address, and there is no way to obtain one from it. The base comes
// from a bound `KIND_OP_REGION` capability, resolved on EVERY access
// through `opregion_row_base` / `opregion_row_len` — which, because
// `tools/build.sh` confines `_op_region_table` to `kind_op_region.o`,
// are the only functions in the kernel that can produce it.
//
// Four consequences, each of which is the point:
//
//   * Revoking the window capability stops register access immediately.
//     The row goes dead, `opregion_row_base` returns OPREG_DECODE_BAD,
//     and every subsequent access is refused DW_IO_DEAD_ROW. There is
//     no cached base to go stale into a still-working pointer.
//   * A window minted READ-only refuses writes (DW_IO_NO_WRITE). The
//     rights live in the descriptor and are re-read per access, so a
//     later narrowing takes effect without anything having to notice.
//   * An offset outside the window is REFUSED, not wrapped or clamped
//     (DW_IO_RANGE). The Intel private bank at BAR0+0x200 and the
//     DesignWare bank at BAR0+0x000 are both inside a 4 KiB window; an
//     offset past it is a bug in this driver, and clamping it would
//     turn that bug into a write to whichever register happened to sit
//     at the clamped offset.
//   * There is no SECOND path. R30.M3 spent an issue establishing that
//     a firmware-declared region cannot reach an address nobody granted
//     it; opening an unguarded `lpss_reg_u32(bar0, off)` here would
//     re-create exactly that hole one layer down, for the same physical
//     addresses. `tools/build.sh` asserts by `objdump -r` that no other
//     object under `core/drivers/i2c/` relocates against
//     `opregion_row_base`.
//
// The checks run in BOTH modes. Only the final load or store differs.
// If the capability check were skipped under the synthetic window, the
// rights assertions in the witness would be assertions about nothing.
//
// -----------------------------------------------------------------------------
// 2. THE ORDERED ACCESS TRACE
// -----------------------------------------------------------------------------
//
// The claims worth making about a DesignWare bring-up are ORDERING
// claims — the controller was disabled before its configuration
// registers were touched, and re-enabled after — and an ordering claim
// cannot be checked from final state, because both orderings reach the
// same final state. It can only be checked by observing the sequence.
//
// Same device as `core/acpi/gpe_io.pdx`, same reasoning, same
// saturate-rather-than-wrap discipline: a wrapped trace can present a
// configuration write as preceding a disable it in fact followed, which
// silently inverts the strongest assertion in the milestone.
//
// Record: 3 qwords, 24 B — `+0 op`, `+8 offset`, `+16 value`.
//
// -----------------------------------------------------------------------------
// 3. THE SYNTHETIC WINDOW IS A DEVICE MODEL, NOT A RAM BUFFER
// -----------------------------------------------------------------------------
//
// A plain RAM window would make most of the transfer state machine
// untestable, because the interesting DesignWare registers are not
// storage:
//
//   * IC_CLR_TX_ABRT (0x54) is READ-TO-CLEAR. Reading it is what
//     releases the TX FIFO from the flush-held state after an abort —
//     which is precisely the "a NACK must not wedge the controller"
//     property. Against a RAM cell that property is unobservable, so
//     the model implements the clear: a read of 0x54 clears TX_ABRT in
//     IC_RAW_INTR_STAT and zeroes IC_TX_ABRT_SOURCE. A transfer path
//     that forgets the read then really does leave the next transfer
//     looking at a latched abort, in the fixture as on the metal.
//   * IC_CLR_STOP_DET (0x60) and IC_CLR_INTR (0x40) likewise.
//   * IC_DATA_CMD (0x10) is a FIFO port. Reads pop a queue seeded by
//     `dw_io_synth_push_rx`, and IC_STATUS.RFNE falls when it empties.
//     Against a RAM cell every read of a four-byte register read would
//     return the same byte and the length handling would be untested.
//   * IC_ENABLE (0x6C) writes propagate to IC_ENABLE_STATUS (0x9C),
//     because the real core's enable is asynchronous and the bring-up
//     polls the status rather than the request.
//
// R30.M5-005 (#1074) extended the model with the three register
// behaviours an INTERRUPT-driven engine depends on, rather than
// building a second harness beside it:
//
//   * IC_INTR_STAT (0x2C) is IC_RAW_INTR_STAT ANDed with IC_INTR_MASK,
//     not a cell. It is the register that stands for "is the line
//     asserted", so it is the only place the mask becomes observable —
//     and the mask is the whole of the TX_EMPTY storm argument.
//   * TX_EMPTY (raw bit 4) is raised when IC_ENABLE turns the core on
//     and dropped when it turns it off, and NOTHING ELSE CLEARS IT.
//     That is faithful: TX_EMPTY is a level against IC_TX_TL (= 0 from
//     bring-up), this model consumes a pushed command immediately so
//     TXFLR is always 0, and the condition therefore holds forever. A
//     driver that unmasks TX_EMPTY and leaves it unmasked past its last
//     byte takes an interrupt per EOI until the machine stops, here as
//     on the metal.
//   * RX_FULL (raw bit 2) follows the RX queue: raised by
//     dw_io_synth_push_rx, dropped when the last byte is popped.
//
// So a level-triggered delivery pump — read IC_INTR_STAT, call the ISR
// if non-zero, repeat — is a faithful model of an IOAPIC line, and the
// number of times it goes round is a real measurement of interrupt
// load rather than a fixture parameter.
//
// And one knob that models the failure the driver must survive:
// `dw_io_synth_set_stuck(1)` suppresses the IC_ENABLE -> IC_ENABLE_STATUS
// propagation, which is what a controller looks like when the bus is
// held and it cannot change enable state. Every bounded wait in the
// driver is exercised against it.
//
// The model lives on the SYNTH side only. In DW_IO_MODE_MMIO the
// hardware is the model.
//
// -----------------------------------------------------------------------------
// 4. paideia-as posture
// -----------------------------------------------------------------------------
//
//   paideia-as#1312 (port I/O carries no effect-row or capability
//   coupling) DOES NOT APPLY HERE. This module performs no port I/O.
//   MMIO is the case R29.M2-002 already closed: `!{Mmio}` requires a
//   matching `paideia.mmio` capability at elaboration. The seam is
//   still the right shape for a second reason — the trace — and the
//   capability check here is a check on a PaideiaOS `KIND_OP_REGION`,
//   which is a finer object than the language-level capability.
//
//   G1: `mov [mem], reg32` widens to 8 bytes — every 32-bit MMIO store
//   uses `mov_d`. 32-bit loads via `mov eax, [rax]` zero-extend and
//   need no workaround (SDM Vol 2A §3.4.1.1).
//
//   Reserved-label discipline: labels prefixed `dwio_`.

module DwIo = structure {

  // ==========================================================================
  // Modes
  // ==========================================================================

  pub let DW_IO_MODE_MMIO  : u64 = 0
  pub let DW_IO_MODE_SYNTH : u64 = 1

  // ==========================================================================
  // Trace
  // ==========================================================================

  pub let DW_TRACE_MAX       : u64 = 256
  pub let DW_TRACE_OP_READ   : u64 = 1
  pub let DW_TRACE_OP_WRITE  : u64 = 2
  pub let DW_TRACE_NOT_FOUND : u64 = 0xFFFFFFFFFFFFFFFF

  // Field indices for dw_io_trace_field.
  pub let DW_TRACE_F_OP    : u64 = 0
  pub let DW_TRACE_F_OFF   : u64 = 1
  pub let DW_TRACE_F_VALUE : u64 = 2

  // ==========================================================================
  // Synthetic window geometry
  // ==========================================================================

  pub let DW_SYNTH_BYTES  : u64 = 0x1000
  pub let DW_SYNTH_RX_CAP : u64 = 32

  // R30.M5-005 (#1074): how many OBSERVATIONS OF THE INTERRUPT STATUS
  // separate a commanded STOP from the STOP_DET that reports it.
  //
  // The model has no clock, and until #1074 it had no need of one: it
  // raised STOP_DET on the same write that commanded the STOP, which is
  // fine for a polled engine that is about to go and look for it. It is
  // NOT fine for an interrupt-driven one, because the whole TX_EMPTY
  // storm lives in the interval between "the last byte is queued" and
  // "the STOP has been seen". With a zero-length interval a driver that
  // never masks TX_EMPTY is indistinguishable from one that does, and
  // the storm assertion would be an assertion about nothing.
  //
  // So the STOP is armed as a countdown and modelled time advances on
  // every read of IC_INTR_STAT or IC_RAW_INTR_STAT — i.e. every time
  // somebody asks whether the line is asserted, which is precisely the
  // thing the polled engine and the interrupt engine both do while they
  // wait. 24 is chosen to be a clear order of magnitude above the two
  // or three service events a correct transfer needs, so "bounded" and
  // "storming" cannot be confused for one another.
  pub let DW_SYNTH_STOP_LATENCY : u64 = 24

  // ==========================================================================
  // Failure taxonomy — band 0xFFFFFF30..0xFFFFFF3F
  //
  // Disjoint from I2C_XFER_* (0xFFFFFF60..6F), LPSS_I2C_* (0xFFFFFF40..5F),
  // I2C_SLAVE_* (0xFFFFFF70..7F), I2C_BUS_* (0xFFFFFF83..8F) and every
  // other kind's band. A seam refusal and a transfer refusal must never
  // be confusable: one says "you were not allowed to touch that
  // register", the other says "the device did not answer".
  // ==========================================================================

  pub let DW_IO_OK         : u64 = 0
  pub let DW_IO_UNBOUND    : u64 = 0xFFFFFF3F
  pub let DW_IO_WRONG_KIND : u64 = 0xFFFFFF3E
  pub let DW_IO_DEAD_ROW   : u64 = 0xFFFFFF3D
  pub let DW_IO_NO_READ    : u64 = 0xFFFFFF3C
  pub let DW_IO_NO_WRITE   : u64 = 0xFFFFFF3B
  pub let DW_IO_RANGE      : u64 = 0xFFFFFF3A
  pub let DW_IO_BAD_ARG    : u64 = 0xFFFFFF39

  // A failed read returns this. It cannot collide with a real value:
  // every DesignWare register is 32 bits wide and this is 64 bits set.
  pub let DW_IO_FAULT      : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Module storage. Confined to this object; tools/build.sh asserts it.
  // ==========================================================================

  pub let mut _dw_io_mode       : u64 = 0
  pub let mut _dw_io_win_slot   : u64 = 0     // 0 = unbound; slot 0 is never a window
  pub let mut _dw_io_bound      : u64 = 0
  pub let mut _dw_io_trace_n    : u64 = 0
  pub let mut _dw_io_synth_stuck: u64 = 0
  pub let mut _dw_io_synth_nack : u64 = 0
  pub let mut _dw_io_nack_skip  : u64 = 0
  pub let mut _dw_io_stop_pend  : u64 = 0
  pub let mut _dw_io_rx_head    : u64 = 0
  pub let mut _dw_io_rx_tail    : u64 = 0
  pub let mut _dw_io_synth_ram  : [u64; 512] = uninit @align(64)
  pub let mut _dw_io_trace      : [u64; 768] = uninit @align(64)
  pub let mut _dw_io_rx_q       : [u64; 32]  = uninit @align(64)

  // ==========================================================================
  // dw_io_trace_reset() -> ()
  // ==========================================================================

  pub let dw_io_trace_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): drop the ordering trace to empty. Only the record count is reset; bytes past the count are unreachable through dw_io_trace_field, which bounds every read against the count. Leaf. Labels prefixed dwio_tr_reset_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _dw_io_trace_n];
        xor rax, rax;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let dw_io_trace_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072) / R30.M5-005 (#1074): number of accesses recorded since the last reset, saturating at DW_TRACE_MAX. #1074 made the append reservation an atomic fetch-and-add, so the raw cell can CLIMB PAST 256 while the records stop at 256 -- the reservation counts attempts, the array holds what fitted. Clamping here (and in the three readers below) is what keeps the OBSERVABLE count saturating rather than wrapping, which is the property the ordering assertions depend on: a witness that expected N records and sees 256 reports a count mismatch, whereas a witness that saw a wrapped index would compare positions that no longer mean what they say. Leaf load. Labels prefixed dwio_tc_.",
      block: {
        lea r10, [rip + _dw_io_trace_n];
        mov rax, [r10 + 0];
        cmp rax, 256;
        jbe dwio_tc_out;
        mov rax, 256;
      dwio_tc_out:
        ret
      }
    }

  // ==========================================================================
  // dw_io_trace_field(idx, field) -> value, or 0 out of range
  // ==========================================================================

  pub let dw_io_trace_field : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): bounds-checked read into the ordering trace. Guards precede all address arithmetic: field < 3 and idx < the live record count, so no byte past the written prefix is read. Offset = idx*24 + field*8, with idx*24 formed as idx*8 + idx*16 because the encoder has no 24 stride in its scaled-index forms. Leaf, read-only. Labels prefixed dwio_tf_.",
      block: {
        cmp rsi, 3;
        jae dwio_tf_zero;
        lea r10, [rip + _dw_io_trace_n];
        mov r10, [r10 + 0];
        cmp r10, 256;
        jbe dwio_tf_have;
        mov r10, 256;
      dwio_tf_have:
        cmp rdi, r10;
        jae dwio_tf_zero;

        mov rax, rdi;
        shl rax, 3;
        mov r11, rdi;
        shl r11, 4;
        add rax, r11;
        mov r11, rsi;
        shl r11, 3;
        add rax, r11;

        lea r10, [rip + _dw_io_trace];
        add r10, rax;
        mov rax, [r10 + 0];
        ret;

      dwio_tf_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dw_io_trace_append(op, off, value) -> ()
  // ==========================================================================

  pub let dw_io_trace_append : (u64, u64, u64) -> () !{mem} @{} =
    fn (op: u64, off: u64, value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072) / R30.M5-005 (#1074): append one access record, SATURATING rather than wrapping at DW_TRACE_MAX. Saturation is the deliberate choice, exactly as in gpe_io_trace_append: a wrapped ordering trace can present a configuration write as preceding the disable it in fact followed, which silently inverts the strongest assertion in this milestone. A saturated trace instead reports fewer records than expected, which the witness detects as a count mismatch and reports as a failure. #1074 MADE THE INDEX RESERVATION ATOMIC and that is not a refinement, it is a correctness fix the interrupt engine forces: dw_i2c_isr_body reaches registers through this same seam, so under a bound vector an interrupt can land between a thread's read of the record count and its write-back, and the read-modify-write form loses one record and OVERWRITES another -- producing a trace in which two accesses share a position, which is precisely the form of corruption that makes an ordering assertion say the opposite of the truth. lock_xadd_q reserves a slot in one indivisible step; the reserving CPU then fills ITS slot and nobody else's, so records may be dropped past the end but never aliased. The counter therefore counts ATTEMPTS and can exceed 256; dw_io_trace_count and the three readers clamp, which is what preserves the saturating observable. Leaf. Labels prefixed dwio_ta_.",
      block: {
        lea r10, [rip + _dw_io_trace_n];
        mov rax, 1;
        lock_xadd_q [r10], rax;          // rax = the slot reserved for us
        cmp rax, 256;
        jae dwio_ta_full;

        mov r11, rax;
        shl r11, 3;
        mov r9, rax;
        shl r9, 4;
        add r11, r9;

        lea r9, [rip + _dw_io_trace];
        add r9, r11;
        mov [r9 + 0],  rdi;
        mov [r9 + 8],  rsi;
        mov [r9 + 16], rdx;
        ret;

      dwio_ta_full:
        ret
      }
    }

  // ==========================================================================
  // dw_io_trace_find(op, off, from) -> idx | DW_TRACE_NOT_FOUND
  // ==========================================================================

  pub let dw_io_trace_find : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (op: u64, off: u64, from: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): first record at index >= from whose op and register offset both match. Returns the INDEX and not a boolean, which is what lets the witness state its assertions as inequalities between positions -- disable_idx < con_idx < enable_idx -- the only form in which an ordering claim is checkable. Bounded by the live record count. Leaf, read-only. Labels prefixed dwio_tfd_.",
      block: {
        lea r10, [rip + _dw_io_trace_n];
        mov r10, [r10 + 0];
        cmp r10, 256;
        jbe dwio_tfd_have;
        mov r10, 256;
      dwio_tfd_have:
        mov rax, rdx;

      dwio_tfd_next:
        cmp rax, r10;
        jae dwio_tfd_miss;

        mov r9, rax;
        shl r9, 3;
        mov r11, rax;
        shl r11, 4;
        add r9, r11;
        lea r11, [rip + _dw_io_trace];
        add r11, r9;

        mov r9, [r11 + 0];
        cmp r9, rdi;
        jne dwio_tfd_bump;
        mov r9, [r11 + 8];
        cmp r9, rsi;
        jne dwio_tfd_bump;
        ret;

      dwio_tfd_bump:
        add rax, 1;
        jmp dwio_tfd_next;

      dwio_tfd_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // dw_io_trace_count_bit(op, off, bit) -> how many matching records had
  // that bit set in their value
  // ==========================================================================

  pub let dw_io_trace_count_bit : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (op: u64, off: u64, bit: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): count records matching (op, off) whose value has `bit` set. This is the shape the repeated-START assertion needs in #1073: 'exactly one IC_DATA_CMD write in this transfer carried the STOP flag, and it was the last one' is a statement about how many records had bit 9 set, which a find-first cannot express. Bounded by the live record count. Leaf, read-only. Labels prefixed dwio_tcb_.",
      block: {
        lea r10, [rip + _dw_io_trace_n];
        mov r10, [r10 + 0];
        cmp r10, 256;
        jbe dwio_tcb_have;
        mov r10, 256;
      dwio_tcb_have:
        xor rax, rax;                    // count
        xor r8, r8;                      // cursor

      dwio_tcb_next:
        cmp r8, r10;
        jae dwio_tcb_done;

        mov r9, r8;
        shl r9, 3;
        mov r11, r8;
        shl r11, 4;
        add r9, r11;
        lea r11, [rip + _dw_io_trace];
        add r11, r9;

        mov r9, [r11 + 0];
        cmp r9, rdi;
        jne dwio_tcb_bump;
        mov r9, [r11 + 8];
        cmp r9, rsi;
        jne dwio_tcb_bump;
        mov r9, [r11 + 16];
        and r9, rdx;
        cmp r9, 0;
        je  dwio_tcb_bump;
        add rax, 1;

      dwio_tcb_bump:
        add r8, 1;
        jmp dwio_tcb_next;

      dwio_tcb_done:
        ret
      }
    }

  // ==========================================================================
  // Window binding
  //
  // dw_io_bind(win_slot) -> DW_IO_OK | error
  //
  // Records WHICH CAPABILITY SLOT the seam speaks through. It does not
  // record, and cannot compute, an address: every access re-resolves the
  // slot, so a revoked window stops working with no cache to go stale.
  // ==========================================================================

  pub let dw_io_bind : (u64) -> u64 !{mem} @{cap} =
    fn (win_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-003 (#1072): bind the seam to a KIND_OP_REGION capability slot. Validates slot < 256 and kind == 0x150 at bind time as an early, legible refusal, but the check is REPEATED on every access and the bind-time one is therefore not load-bearing -- which is deliberate. A bind-time-only check would be a time-of-check-to-time-of-use hole exactly the width of a revoke: the window could be revoked, its slot reused for something else, and the seam would still be writing to what it believed was a controller. Storing the slot rather than the base is what closes it. cap_table stride is 24 (kind at +0, rights at +8, target_ptr at +16). Leaf, no nested calls. Labels prefixed dwio_bd_.",
      block: {
        cmp rdi, 256;
        jae dwio_bd_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x150;                  // KIND_OP_REGION
        cmp r10, r11;
        jne dwio_bd_kind;

        lea r10, [rip + _dw_io_win_slot];
        mov [r10 + 0], rdi;
        lea r10, [rip + _dw_io_bound];
        mov r11, 1;
        mov [r10 + 0], r11;
        xor rax, rax;
        ret;

      dwio_bd_kind:
        mov rax, 0xFFFFFF3E;             // DW_IO_WRONG_KIND
        ret;
      dwio_bd_bad:
        mov rax, 0xFFFFFF39;             // DW_IO_BAD_ARG
        ret
      }
    }

  pub let dw_io_unbind : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): detach the seam from any window. Every subsequent access is refused DW_IO_UNBOUND. Called on every fixture exit so a witness failure cannot leave the seam pointed at a capability the next boot stage will reuse. Leaf.",
      block: {
        lea r10, [rip + _dw_io_bound];
        xor rax, rax;
        mov [r10 + 0], rax;
        lea r10, [rip + _dw_io_win_slot];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let dw_io_window_slot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): the currently bound window capability slot, or 0 when unbound. Observability only; nothing in the access path reads it through this function. Leaf load.",
      block: {
        lea r10, [rip + _dw_io_bound];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  dwio_ws_none;
        lea r10, [rip + _dw_io_win_slot];
        mov rax, [r10 + 0];
        ret;
      dwio_ws_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dw_io_check(want_right) -> row_id | error
  //
  // THE GATE. Resolves the bound slot to a live KIND_OP_REGION row after
  // checking the requested direction right. Called by both accessors and
  // by nothing else.
  // ==========================================================================

  pub let dw_io_check : (u64) -> u64 !{mem} @{cap} =
    fn (want_right: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M5-003 (#1072): re-resolve the bound window capability and check the direction right, returning the live row id. Order matters and is: bound -> slot in range -> kind == KIND_OP_REGION (0x150) -> rights contain want_right -> row live. Kind before rights, because a slot whose window was revoked and reused for a KIND_THREAD would otherwise have its unrelated rights word tested against R_OPREG_WRITE and could pass. Row liveness last, via opregion_tail_valid, because that is the one check that requires a call and the cheap refusals should not pay for it. want_right is 0x001 (READ) or 0x002 (WRITE) -- the seam never asks for both, so a window minted read-only is refused on the write path specifically and with its own code rather than being refused entry. One push (rbx, carrying the row id across the nested call) leaves rsp%16 == 0 at that call. Labels prefixed dwio_ck_.",
      block: {
        push rbx;

        lea r10, [rip + _dw_io_bound];
        mov r10, [r10 + 0];
        cmp r10, 0;
        je  dwio_ck_unbound;

        lea r10, [rip + _dw_io_win_slot];
        mov r10, [r10 + 0];
        cmp r10, 256;
        jae dwio_ck_unbound;

        mov rax, cap_table;
        mov r8, r10;
        shl r8, 3;
        mov r9, r10;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r11, [rax + 0];
        mov r9, 0x150;                   // KIND_OP_REGION
        cmp r11, r9;
        jne dwio_ck_kind;

        mov r11, [rax + 8];              // rights
        and r11, rdi;
        cmp r11, rdi;
        jne dwio_ck_right;

        mov rbx, [rax + 16];
        mov r9, 0xFFFF;
        and rbx, r9;                     // row_id

        mov rdi, rbx;
        call opregion_tail_valid;
        cmp rax, 1;
        jne dwio_ck_dead;

        mov rax, rbx;
        pop rbx;
        ret;

      dwio_ck_right:
        // Which right was refused is knowable from the argument, and the
        // two codes are distinct because "this window is read-only" and
        // "this window is write-only" are different operator problems.
        cmp rdi, 2;
        je  dwio_ck_nowrite;
        mov rax, 0xFFFFFF3C;             // DW_IO_NO_READ
        pop rbx;
        ret;
      dwio_ck_nowrite:
        mov rax, 0xFFFFFF3B;             // DW_IO_NO_WRITE
        pop rbx;
        ret;
      dwio_ck_kind:
        mov rax, 0xFFFFFF3E;             // DW_IO_WRONG_KIND
        pop rbx;
        ret;
      dwio_ck_dead:
        mov rax, 0xFFFFFF3D;             // DW_IO_DEAD_ROW
        pop rbx;
        ret;
      dwio_ck_unbound:
        mov rax, 0xFFFFFF3F;             // DW_IO_UNBOUND
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Synthetic window primitives — raw 32-bit cells, untraced.
  // ==========================================================================

  pub let dw_io_synth_load : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): raw untraced 32-bit load from the synthetic window. Offsets are validated by the caller (the accessor has already bounds-checked against the capability's own length); this function additionally refuses off >= DW_SYNTH_BYTES so it is total on its own, and returns 0 there rather than reading past a 4096-byte object. Leaf. Labels prefixed dwio_sl_.",
      block: {
        mov rax, 0x1000;
        cmp rdi, rax;
        jae dwio_sl_zero;
        lea r10, [rip + _dw_io_synth_ram];
        add r10, rdi;
        xor rax, rax;
        mov eax, [r10];
        ret;
      dwio_sl_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dw_io_synth_store : (u64, u64) -> () !{mem} @{} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): raw untraced 32-bit store into the synthetic window. G1: mov_d, because a bare mov [mem], reg widens to REX.W and would write eight bytes over the neighbouring register cell -- the exact corruption this driver must not commit against real registers either. Out-of-window offsets are dropped. Leaf. Labels prefixed dwio_ss_.",
      block: {
        mov rax, 0x1000;
        cmp rdi, rax;
        jae dwio_ss_out;
        lea r10, [rip + _dw_io_synth_ram];
        add r10, rdi;
        mov_d [r10], rsi;
      dwio_ss_out:
        ret
      }
    }

  // dw_io_synth_poke / _peek — the fixture's untraced back door for
  // seeding and inspecting registers without polluting the trace.
  pub let dw_io_synth_poke : (u64, u64) -> () !{mem} @{} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): seed a synthetic register WITHOUT appending to the trace. Untraced deliberately: the ordering assertions read the trace as a record of what the DRIVER did, and a fixture that seeded registers through the traced path would have to subtract its own setup from every position it compares. One push (rbx, unused for value) restores rsp%16 to 0 at the nested call. Labels prefixed dwio_pk_.",
      block: {
        push rbx;
        call dw_io_synth_store;
        pop rbx;
        ret
      }
    }

  pub let dw_io_synth_peek : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): untraced 32-bit load from the synthetic window, for fixture assertions about final register state. One push (rbx) restores rsp%16 to 0 at the nested call. Labels prefixed dwio_pe_.",
      block: {
        push rbx;
        call dw_io_synth_load;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Synthetic RX queue — what IC_DATA_CMD reads pop.
  // ==========================================================================

  pub let dw_io_synth_push_rx : (u64) -> u64 !{mem} @{} =
    fn (byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): queue one byte for a subsequent IC_DATA_CMD read, and raise IC_STATUS.RFNE. This is what makes a multi-byte read a real test: against a plain RAM cell every read of a device's four-byte register would return the same byte and the length handling of the transfer engine would be exercised by nothing. Returns 1 on accept, 0 when the 32-entry queue is full -- a full queue is a fixture bug and must not silently drop, because a dropped seed byte would make the transfer engine look like it lost data. Leaf. Labels prefixed dwio_px_.",
      block: {
        lea r10, [rip + _dw_io_rx_tail];
        mov r11, [r10 + 0];
        cmp r11, 32;
        jae dwio_px_full;

        lea r9, [rip + _dw_io_rx_q];
        mov rax, rdi;
        and rax, 0xFF;
        mov [r9 + r11 * 8], rax;
        add r11, 1;
        mov [r10 + 0], r11;

        // IC_STATUS.RFNE (bit 3) becomes true.
        mov rax, 0x70;
        lea r9, [rip + _dw_io_synth_ram];
        add r9, rax;
        xor rax, rax;
        mov eax, [r9];
        or  rax, 0x08;
        mov_d [r9], rax;

        // R30.M5-005 (#1074): and so does IC_RAW_INTR_STAT.RX_FULL (bit
        // 2). The core raises RX_FULL whenever RXFLR exceeds IC_RX_TL,
        // and bring-up programs IC_RX_TL to 0, so "any byte present" is
        // exactly the condition. Without it the interrupt-driven read
        // path would have no RX event to service and would be tested by
        // nothing.
        lea r9, [rip + _dw_io_synth_ram];
        add r9, 0x34;
        xor rax, rax;
        mov eax, [r9];
        or  rax, 0x04;
        mov_d [r9], rax;

        mov rax, 1;
        ret;

      dwio_px_full:
        xor rax, rax;
        ret
      }
    }

  pub let dw_io_synth_rx_pending : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): bytes still queued for IC_DATA_CMD reads. Lets a fixture assert that a read of length N consumed exactly N and not N-1 or N+1. Leaf.",
      block: {
        lea r10, [rip + _dw_io_rx_tail];
        mov rax, [r10 + 0];
        lea r10, [rip + _dw_io_rx_head];
        mov r11, [r10 + 0];
        cmp rax, r11;
        jbe dwio_rp_none;
        sub rax, r11;
        ret;
      dwio_rp_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Synth mode control
  // ==========================================================================

  pub let dw_io_synth_enable : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): point the seam at the 4096-byte RAM device model. Zeroes the window, the trace, the RX queue and the stuck flag so a fixture always starts from a known state -- a fixture that inherited a previous one's IC_ENABLE_STATUS would see a bring-up succeed for the wrong reason. The mode defaults to DW_IO_MODE_MMIO from .bss zero-init, so a kernel that never calls this behaves exactly as if the synthetic side did not exist. Leaf; the 512-qword clear is a counted loop. Labels prefixed dwio_se_.",
      block: {
        lea r10, [rip + _dw_io_synth_ram];
        xor rax, rax;
        xor rcx, rcx;
      dwio_se_clear:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  dwio_se_clear;

        lea r10, [rip + _dw_io_rx_q];
        xor rcx, rcx;
      dwio_se_rxclear:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  dwio_se_rxclear;

        lea r10, [rip + _dw_io_rx_head];
        mov [r10 + 0], rax;
        lea r10, [rip + _dw_io_rx_tail];
        mov [r10 + 0], rax;
        lea r10, [rip + _dw_io_trace_n];
        mov [r10 + 0], rax;
        lea r10, [rip + _dw_io_synth_stuck];
        mov [r10 + 0], rax;
        lea r10, [rip + _dw_io_synth_nack];
        mov [r10 + 0], rax;
        lea r10, [rip + _dw_io_nack_skip];
        mov [r10 + 0], rax;
        lea r10, [rip + _dw_io_stop_pend];
        mov [r10 + 0], rax;

        lea r10, [rip + _dw_io_mode];
        mov r11, 1;                      // DW_IO_MODE_SYNTH
        mov [r10 + 0], r11;
        ret
      }
    }

  pub let dw_io_synth_disable : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): return the seam to real MMIO. Called by the fixture on BOTH its success and its failure exits, so a witness failure cannot leave the kernel addressing a RAM buffer in place of a controller. Leaf.",
      block: {
        lea r10, [rip + _dw_io_mode];
        xor rax, rax;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let dw_io_mode : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): current seam mode. Leaf load.",
      block: {
        lea r10, [rip + _dw_io_mode];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let dw_io_synth_set_stuck : (u64) -> () !{mem} @{} =
    fn (v: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): model a controller that will not change enable state. With the flag set, an IC_ENABLE write no longer propagates to IC_ENABLE_STATUS, which is what a DesignWare core looks like while a peripheral holds SCL low and it cannot complete the transition. This is the ONLY way to reach the bounded-wait failure paths, and reaching them is not optional: an unbounded spin in a driver is indistinguishable from a bounded one until the day the bus is held, and on that day the difference is a hung boot. Leaf.",
      block: {
        lea r10, [rip + _dw_io_synth_stuck];
        mov [r10 + 0], rdi;
        ret
      }
    }

  // ==========================================================================
  // The device model — synth side only.
  // ==========================================================================

  pub let dw_io_model_read : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072): apply the DesignWare read-side semantics that are not storage. IC_CLR_TX_ABRT (0x54) clears IC_RAW_INTR_STAT.TX_ABRT and zeroes IC_TX_ABRT_SOURCE -- modelling read-to-clear is what makes 'a NACK must not wedge the controller' an observable property rather than a comment, because a transfer path that omits the read really does leave the next transfer facing a latched abort, here as on the metal. IC_CLR_STOP_DET (0x60) clears bit 9. IC_CLR_INTR (0x40) clears the whole raw status and the abort source. IC_DATA_CMD (0x10) pops the RX queue and drops IC_STATUS.RFNE when it empties. Everything else is a plain cell. Four pushes plus the return address would misalign the nested calls; the body uses none and reaches the window through _dw_io_synth_ram directly, which it may because it IS the seam object. Labels prefixed dwio_mr_.",
      block: {
        lea r9, [rip + _dw_io_synth_ram];

        // ---- the model clock (R30.M5-005 #1074) ----
        //
        // An observation of the interrupt status is what makes modelled
        // time pass. That is not an arbitrary choice of tick source: the
        // polled engine's dw_xfer_wait_stop and the interrupt engine's
        // dw_i2c_isr_body both spend their waiting time reading exactly
        // these two registers, so it is the one event both paths
        // generate at a rate proportional to how long they have waited.
        // When the countdown armed by a commanded STOP reaches zero,
        // STOP_DET appears -- which is the ONLY way it appears.
        cmp rdi, 0x2C;                   // IC_INTR_STAT
        je  dwio_mr_tick;
        cmp rdi, 0x34;                   // IC_RAW_INTR_STAT
        jne dwio_mr_disp;

      dwio_mr_tick:
        lea r10, [rip + _dw_io_stop_pend];
        mov r11, [r10 + 0];
        cmp r11, 0;
        je  dwio_mr_disp;
        sub r11, 1;
        mov [r10 + 0], r11;
        cmp r11, 0;
        jne dwio_mr_disp;
        mov r10, r9;
        add r10, 0x34;
        xor rax, rax;
        mov eax, [r10];
        mov r11, 0x200;                  // DW_INTR_STOP_DET
        or  rax, r11;
        mov_d [r10], rax;

      dwio_mr_disp:
        cmp rdi, 0x54;                   // IC_CLR_TX_ABRT
        je  dwio_mr_clr_abrt;
        cmp rdi, 0x60;                   // IC_CLR_STOP_DET
        je  dwio_mr_clr_stop;
        cmp rdi, 0x40;                   // IC_CLR_INTR
        je  dwio_mr_clr_all;
        cmp rdi, 0x10;                   // IC_DATA_CMD
        je  dwio_mr_pop;
        cmp rdi, 0x2C;                   // IC_INTR_STAT
        je  dwio_mr_istat;

        mov rax, 0x1000;
        cmp rdi, rax;
        jae dwio_mr_zero;
        add r9, rdi;
        xor rax, rax;
        mov eax, [r9];
        ret;

      dwio_mr_istat:
        // IC_INTR_STAT is not storage: it is IC_RAW_INTR_STAT ANDed with
        // IC_INTR_MASK. Modelling it as a cell would make the mask
        // unobservable, and the mask is the whole of the TX_EMPTY storm
        // argument -- "the line is quiet after the last byte is queued"
        // is a statement about (raw & mask) and about nothing else. With
        // a plain cell, a driver that never masked TX_EMPTY would look
        // identical to one that did.
        mov r10, r9;
        add r10, 0x30;                   // IC_INTR_MASK
        xor rax, rax;
        mov eax, [r10];
        mov r11, rax;
        mov r10, r9;
        add r10, 0x34;                   // IC_RAW_INTR_STAT
        xor rax, rax;
        mov eax, [r10];
        and rax, r11;
        ret;

      dwio_mr_clr_abrt:
        mov r10, r9;
        add r10, 0x34;                   // IC_RAW_INTR_STAT
        xor rax, rax;
        mov eax, [r10];
        mov r11, 0xFFFFFFBF;             // ~TX_ABRT (bit 6)
        and rax, r11;
        mov_d [r10], rax;
        mov r10, r9;
        add r10, 0x80;                   // IC_TX_ABRT_SOURCE
        xor rax, rax;
        mov_d [r10], rax;
        // ... and THIS READ IS WHAT RELEASES THE TX FIFO. The core
        // flushed and held it on the abort; TFNF comes back here and
        // nowhere else, which is what makes "a transfer path that does
        // not read IC_CLR_TX_ABRT leaves the next transfer facing a
        // FIFO that never accepts anything" a fact the fixture can
        // observe rather than a warning in a comment.
        mov r10, r9;
        add r10, 0x70;                   // IC_STATUS
        xor rax, rax;
        mov eax, [r10];
        or  rax, 0x02;                   // DW_STATUS_TFNF
        mov_d [r10], rax;
        xor rax, rax;
        ret;

      dwio_mr_clr_stop:
        mov r10, r9;
        add r10, 0x34;
        xor rax, rax;
        mov eax, [r10];
        mov r11, 0xFFFFFDFF;             // ~STOP_DET (bit 9)
        and rax, r11;
        mov_d [r10], rax;
        xor rax, rax;
        ret;

      dwio_mr_clr_all:
        mov r10, r9;
        add r10, 0x80;                   // IC_TX_ABRT_SOURCE
        xor rax, rax;
        mov_d [r10], rax;
        lea r10, [rip + _dw_io_stop_pend];
        mov [r10 + 0], rax;

        // R30.M5-005 (#1074): raw status is REBUILT from the level
        // conditions rather than zeroed. TX_EMPTY and RX_FULL are not
        // latches -- they are comparisons against IC_TX_TL / IC_RX_TL
        // that hold for as long as the FIFOs say so -- and a core that
        // reported them clear while their condition still held would
        // make an interrupt-driven engine wait forever for an event
        // whose cause never went away. This matters on a real path, not
        // a hypothetical one: i2c_xfer_set_target reads IC_CLR_INTR as
        // its LAST act before every transfer.
        xor rcx, rcx;
        mov r10, r9;
        add r10, 0x9C;                   // IC_ENABLE_STATUS
        xor rax, rax;
        mov eax, [r10];
        and rax, 1;
        cmp rax, 0;
        je  dwio_mr_clr_rx;
        or  rcx, 0x10;                   // TX_EMPTY: TXFLR (always 0) <= TX_TL
      dwio_mr_clr_rx:
        lea r10, [rip + _dw_io_rx_head];
        mov r10, [r10 + 0];
        lea r11, [rip + _dw_io_rx_tail];
        mov r11, [r11 + 0];
        cmp r10, r11;
        jae dwio_mr_clr_store;
        or  rcx, 0x04;                   // RX_FULL: a byte is queued
      dwio_mr_clr_store:
        mov r10, r9;
        add r10, 0x34;
        mov_d [r10], rcx;
        xor rax, rax;
        ret;

      dwio_mr_pop:
        lea r10, [rip + _dw_io_rx_head];
        mov r11, [r10 + 0];
        lea rcx, [rip + _dw_io_rx_tail];
        mov rcx, [rcx + 0];
        cmp r11, rcx;
        jae dwio_mr_pop_empty;

        lea rax, [rip + _dw_io_rx_q];
        mov rax, [rax + r11 * 8];
        add r11, 1;
        mov [r10 + 0], r11;

        // If the queue is now empty, IC_STATUS.RFNE falls.
        cmp r11, rcx;
        jb  dwio_mr_pop_out;
        mov r10, r9;
        add r10, 0x70;                   // IC_STATUS
        mov rcx, rax;                    // preserve popped byte
        xor rax, rax;
        mov eax, [r10];
        mov r11, 0xFFFFFFF7;             // ~RFNE (bit 3)
        and rax, r11;
        mov_d [r10], rax;
        // ... and with the FIFO empty, RXFLR no longer exceeds IC_RX_TL
        // (which bring-up programs to 0), so RX_FULL de-asserts too.
        // R30.M5-005 (#1074): without this the RX_FULL line would stay
        // asserted after the last byte was drained and an interrupt-
        // driven read would take an interrupt per EOI forever -- the RX
        // twin of the TX_EMPTY storm.
        mov r10, r9;
        add r10, 0x34;                   // IC_RAW_INTR_STAT
        xor rax, rax;
        mov eax, [r10];
        mov r11, 0xFFFFFFFB;             // ~RX_FULL (bit 2)
        and rax, r11;
        mov_d [r10], rax;
        mov rax, rcx;

      dwio_mr_pop_out:
        ret;

      dwio_mr_pop_empty:
        xor rax, rax;
        ret;

      dwio_mr_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dw_io_model_write : (u64, u64) -> () !{mem} @{} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-003 (#1072) / R30.M5-004 (#1073): apply the DesignWare write-side semantics that are not storage. (a) IC_ENABLE (0x6C): the low bit propagates to IC_ENABLE_STATUS (0x9C) UNLESS the stuck flag is set. The real core's enable is asynchronous -- the status lags the request by up to twenty-five bus cycles -- which is exactly why the bring-up polls the status and not the request, and why the model must hold the two as separate cells; suppressing the propagation is what produces a controller that never completes the transition, i.e. the bounded-wait failure the driver must survive. (b) IC_DATA_CMD (0x10): if a NACK is armed, raise IC_RAW_INTR_STAT.TX_ABRT and latch IC_TX_ABRT_SOURCE, one-shot -- a device that did not answer. Otherwise, if the command carried the STOP flag (bit 9), raise IC_RAW_INTR_STAT.STOP_DET, which is what lets a transfer's terminating wait complete for the RIGHT reason: because a STOP was actually commanded, not because a fixture poked a bit. An aborted command does NOT raise STOP_DET, matching the core, and that asymmetry is what makes a driver which returns from a NACK without clearing the abort visibly wrong here rather than accidentally fine. G1: mov_d for every 32-bit store. Labels prefixed dwio_mw_.",
      block: {
        lea r9, [rip + _dw_io_synth_ram];

        mov rax, 0x1000;
        cmp rdi, rax;
        jae dwio_mw_out;

        mov r10, r9;
        add r10, rdi;
        mov_d [r10], rsi;

        cmp rdi, 0x6C;                   // IC_ENABLE
        je  dwio_mw_enable;
        cmp rdi, 0x10;                   // IC_DATA_CMD
        je  dwio_mw_cmd;
        ret;

      dwio_mw_enable:
        // IC_ENABLE.ABORT (bit 1) makes the core drive a STOP and
        // terminate the transaction, reporting the result as a TX_ABRT
        // whose source is ABRT_USER_ABRT. Modelled here rather than
        // omitted because it is the ONLY mechanism tier-1 bus recovery
        // has, and an unexercised recovery path is a recovery path that
        // has never worked. Independent of the stuck flag: the abort is
        // reported even by a core whose enable will not transition,
        // which is exactly the case recovery is invoked for.
        mov rax, rsi;
        and rax, 0x2;                    // DW_ENABLE_ABORT
        cmp rax, 0;
        je  dwio_mw_en_state;
        mov r11, r9;
        add r11, 0x80;                   // IC_TX_ABRT_SOURCE
        mov rax, 0x10000;                // DW_ABRT_USER_ABRT
        mov_d [r11], rax;
        mov r11, r9;
        add r11, 0x34;                   // IC_RAW_INTR_STAT
        xor rax, rax;
        mov eax, [r11];
        or  rax, 0x40;                   // TX_ABRT
        mov_d [r11], rax;

      dwio_mw_en_state:
        lea r10, [rip + _dw_io_synth_stuck];
        mov r10, [r10 + 0];
        cmp r10, 0;
        jne dwio_mw_out;
        mov rax, rsi;
        and rax, 1;
        mov r10, r9;
        add r10, 0x9C;                   // IC_ENABLE_STATUS
        mov_d [r10], rax;

        // R30.M5-005 (#1074): TX_EMPTY tracks the enable transition.
        //
        // TX_EMPTY is not an event, it is a LEVEL: the core asserts it
        // whenever TXFLR <= IC_TX_TL, and bring-up programs IC_TX_TL to
        // 0. This model consumes an IC_DATA_CMD write immediately, so
        // TXFLR is always zero and the condition is always true while
        // the core is enabled -- which is not a simplification, it is
        // the WORST CASE, and it is the case that matters. A core whose
        // TX_EMPTY never de-asserts is exactly what produces the
        // interrupt storm at end-of-transmit, and the ONLY thing that
        // can stop it is the driver masking TX_EMPTY when it has
        // nothing left to send. Modelling TX_EMPTY as anything less
        // persistent would let a driver that never masks it pass.
        //
        // A disabled core drives nothing, so the bit is dropped on the
        // way down.
        mov r11, r9;
        add r11, 0x34;                   // IC_RAW_INTR_STAT
        mov r10, rax;                    // enable bit, preserved
        xor rax, rax;
        mov eax, [r11];
        cmp r10, 0;
        je  dwio_mw_en_off;
        or  rax, 0x10;                   // DW_INTR_TX_EMPTY
        mov_d [r11], rax;
        ret;
      dwio_mw_en_off:
        mov r10, 0xFFFFFFEF;             // ~TX_EMPTY (bit 4)
        and rax, r10;
        mov_d [r11], rax;
        ret;

      dwio_mw_cmd:
        lea r11, [rip + _dw_io_synth_nack];
        mov r10, [r11 + 0];
        cmp r10, 0;
        je  dwio_mw_stop;

        // R30.M5-005 (#1074): an armed abort may be told to let N
        // commands through first. That is what makes a DATA NACK
        // reachable at all -- until #1074 the abort always fired on the
        // first command, i.e. always at the address phase, so "how many
        // bytes actually landed" had only one possible answer and the
        // count could not be wrong.
        lea r11, [rip + _dw_io_nack_skip];
        mov rax, [r11 + 0];
        cmp rax, 0;
        je  dwio_mw_cmd_fire;
        sub rax, 1;
        mov [r11 + 0], rax;
        jmp dwio_mw_stop;

      dwio_mw_cmd_fire:
        // One-shot abort: latch the source, raise TX_ABRT, disarm.
        lea r11, [rip + _dw_io_synth_nack];
        xor rax, rax;
        mov [r11 + 0], rax;
        mov r11, r9;
        add r11, 0x80;                   // IC_TX_ABRT_SOURCE
        mov_d [r11], r10;
        mov r11, r9;
        add r11, 0x34;                   // IC_RAW_INTR_STAT
        xor rax, rax;
        mov eax, [r11];
        or  rax, 0x40;                   // TX_ABRT
        mov_d [r11], rax;

        // R30.M5-005 (#1074): AND THE TX FIFO IS FLUSHED AND HELD.
        // dw_regs.pdx and dw_xfer.pdx have both said since #1072 that
        // this is what an aborted DesignWare core does and that reading
        // IC_CLR_TX_ABRT is what releases it -- but the model did not
        // do it, so a driver could keep pushing into a FIFO the core
        // had closed and nothing would notice. It matters for more than
        // fidelity: the count of bytes a device acknowledged before a
        // data NACK is derived from how many commands were accepted,
        // and a model that accepts commands after the abort inflates it.
        mov r11, r9;
        add r11, 0x70;                   // IC_STATUS
        xor rax, rax;
        mov eax, [r11];
        mov r10, 0xFFFFFFFD;             // ~TFNF (bit 1)
        and rax, r10;
        mov_d [r11], rax;
        ret;

      dwio_mw_stop:
        mov rax, rsi;
        mov r11, 0x200;                  // DW_CMD_STOP
        and rax, r11;
        cmp rax, 0;
        je  dwio_mw_out;
        // R30.M5-005 (#1074): ARM the STOP rather than reporting it. A
        // STOP has to reach the wire before the core can detect it, and
        // the interval between the two is exactly where an unmasked
        // TX_EMPTY becomes an interrupt storm. Raising STOP_DET on the
        // commanding write collapses that interval to nothing and makes
        // the storm untestable; see DW_SYNTH_STOP_LATENCY.
        lea r11, [rip + _dw_io_stop_pend];
        mov rax, 24;                     // DW_SYNTH_STOP_LATENCY
        mov [r11 + 0], rax;

      dwio_mw_out:
        ret
      }
    }

  // ==========================================================================
  // dw_io_synth_arm_nack(abrt_source) -> ()
  // ==========================================================================

  pub let dw_io_synth_arm_nack : (u64) -> () !{mem} @{} =
    fn (abrt_source: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-004 (#1073): arm the model so the NEXT IC_DATA_CMD write aborts with the given IC_TX_ABRT_SOURCE value. This is how 'no device answered at that address' is produced, and producing it is not optional: a NACK is the ordinary outcome of talking to a bus you do not fully own -- an absent part, a part still in reset, a part whose driver died -- and a transfer path whose NACK branch has never executed is a guess. Arming rather than pre-poking the status register is what makes it reachable at all: the transfer path reads IC_CLR_INTR while retargeting, which would wipe a pre-poked abort before the first byte was pushed. One-shot: the flag clears when it fires, so a fixture gets exactly the abort it asked for and the transfer AFTER it is clean -- which is the half of the property that says a NACK does not wedge the controller. Leaf.",
      block: {
        lea r10, [rip + _dw_io_synth_nack];
        mov [r10 + 0], rdi;
        lea r10, [rip + _dw_io_nack_skip];
        xor rax, rax;
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // dw_io_synth_arm_nack_after(skip, abrt_source) -> ()
  // ==========================================================================

  pub let dw_io_synth_arm_nack_after : (u64, u64) -> () !{mem} @{} =
    fn (skip: u64, abrt_source: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-005 (#1074): arm the model so the abort fires on the (skip+1)-th IC_DATA_CMD write rather than the first. THIS IS WHAT MAKES A DATA NACK A DIFFERENT TEST FROM AN ADDRESS NACK. With dw_io_synth_arm_nack alone the abort always lands on the very first command, which is the address phase, so 'how many bytes did the device acknowledge before it gave up' had exactly one possible answer -- zero -- and an implementation that always answered zero, or always answered 'all of them', would have passed identically. Skipping two commands of a four-byte write produces the real case: two bytes acknowledged, the third NACKed, the fourth never accepted because the abort flushed and held the FIFO. The expected answer is two, and two is a number only a correct computation produces. Leaf.",
      block: {
        lea r10, [rip + _dw_io_synth_nack];
        mov [r10 + 0], rsi;
        lea r10, [rip + _dw_io_nack_skip];
        mov [r10 + 0], rdi;
        ret
      }
    }

  // ==========================================================================
  // dw_io_synth_line() -> masked interrupt status, untraced
  //
  // "Is the controller asserting its interrupt line right now?"
  // ==========================================================================

  pub let dw_io_synth_line : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-005 (#1074): the modelled interrupt line -- IC_RAW_INTR_STAT ANDed with IC_INTR_MASK -- observed WITHOUT appending to the ordering trace. This is what makes a faithful level-triggered delivery pump possible: an IOAPIC calls the handler exactly while (raw & mask) is non-zero, so a loop that asks this question and dispatches on the answer measures REAL INTERRUPT LOAD rather than counting how many times a fixture chose to call something. A traced read would not do: the pump's own polling would then be indistinguishable, in the trace, from work the driver did. It goes through dw_io_model_read rather than reading the cells directly so that it shares the model clock -- an observation of the line is an observation of the line whoever makes it, and a pump that did not advance modelled time would wait forever for a STOP it had itself prevented. One push (rbx) restores rsp%16 to 0 at the nested call. Labels prefixed dwio_ln_.",
      block: {
        push rbx;
        mov rdi, 0x2C;                   // IC_INTR_STAT
        call dw_io_model_read;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dw_io_synth_arm_stop(ticks) -> ()
  // ==========================================================================

  pub let dw_io_synth_arm_stop : (u64) -> () !{mem} @{} =
    fn (ticks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-005 (#1074): set the pending-STOP countdown directly. Two uses, and both are about not letting one sub-test's leftovers decide another's outcome. Zero CANCELS a STOP that a transfer armed and then abandoned -- a read that timed out waiting for a byte has already pushed its terminating command, so its STOP is still in flight, and the next assertion about a STOP that never arrives would otherwise watch that one arrive instead. A non-zero value seeds the countdown for a test that wants to control the interval directly. Leaf.",
      block: {
        lea r10, [rip + _dw_io_stop_pend];
        mov [r10 + 0], rdi;
        ret
      }
    }

  pub let dw_io_synth_stop_pending : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M5-005 (#1074): observations remaining before a commanded STOP is reported. Lets a fixture assert that a completed transfer consumed its STOP rather than leaving one armed for the next one. Leaf load.",
      block: {
        lea r10, [rip + _dw_io_stop_pend];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // dw_io_read32(off) -> value | DW_IO_FAULT
  //
  // THE read. Every controller register this driver observes comes
  // through here.
  // ==========================================================================

  pub let dw_io_read32 : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (off: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-003 (#1072): 32-bit read of a controller register, THROUGH THE WINDOW CAPABILITY. Sequence, identical in both modes up to the final access: (1) dw_io_check(R_OPREG_READ = 1) re-resolves the bound slot and returns a live row id or a refusal; (2) opregion_row_base / opregion_row_len give the window extent -- these two are the ONLY functions in the kernel that can produce a base, because _op_region_table is confined to kind_op_region.o, and tools/build.sh asserts no other object under core/drivers/i2c/ relocates against them; (3) off + 4 <= len, refused rather than clamped; (4) in MMIO mode, mfence / mov eax,[base+off] / mfence -- the WB-to-UC ordering bracket every accessor in this tree uses (SDM Vol 3A 11.3.1); in SYNTH mode, dw_io_model_read; (5) append a DW_TRACE_OP_READ record with the value actually returned. A REFUSAL IS NOT TRACED: the trace is a record of accesses that reached the device, and a refused access reached nothing -- tracing it would let a driver that is being denied every register look, in the trace, exactly like one that is working. Five pushes (rbx, r12..r15) leave rsp%16 == 0 at every nested call. Labels prefixed dwio_r32_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // off

        mov rdi, 1;                      // R_OPREG_READ
        call dw_io_check;
        mov r11, 0xFFFFFF30;
        cmp rax, r11;
        jae dwio_r32_fault;              // any code in the seam band
        mov rbx, rax;                    // row_id

        mov rdi, rbx;
        call opregion_row_base;
        mov r13, rax;

        mov rdi, rbx;
        call opregion_row_len;
        mov r14, rax;

        // off + 4 <= len, formed without overflow (off < 2^32 always,
        // it is a register offset this driver produced).
        mov rax, r12;
        add rax, 4;
        cmp rax, r14;
        ja  dwio_r32_fault;

        lea r10, [rip + _dw_io_mode];
        mov r10, [r10 + 0];
        cmp r10, 1;
        je  dwio_r32_synth;

        mfence;
        mov rax, r13;
        add rax, r12;
        mov eax, [rax];
        mfence;
        mov r15, rax;
        jmp dwio_r32_emit;

      dwio_r32_synth:
        mov rdi, r12;
        call dw_io_model_read;
        mov r15, rax;

      dwio_r32_emit:
        mov rdi, 1;                      // DW_TRACE_OP_READ
        mov rsi, r12;
        mov rdx, r15;
        call dw_io_trace_append;
        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      dwio_r32_fault:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // DW_IO_FAULT
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dw_io_write32(off, val) -> DW_IO_OK | error
  // ==========================================================================

  pub let dw_io_write32 : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M5-003 (#1072): 32-bit write of a controller register, through the window capability. Same sequence as dw_io_read32 with dw_io_check(R_OPREG_WRITE = 2), so a window minted without WRITE is refused DW_IO_NO_WRITE and NOTHING IS STORED -- which is the property that makes a read-only mapping of a device's registers a real thing rather than a naming convention. Returns the refusal code rather than a sentinel, because unlike a read there is no in-band value to be confused with one. G1: mov_d for the MMIO store; a bare mov widens to eight bytes and would write over the neighbouring register. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed dwio_w32_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // off
        mov r15, rsi;                    // val (32-bit)
        mov r11, 0xFFFFFFFF;
        and r15, r11;

        mov rdi, 2;                      // R_OPREG_WRITE
        call dw_io_check;
        mov r11, 0xFFFFFF30;
        cmp rax, r11;
        jae dwio_w32_err;
        mov rbx, rax;

        mov rdi, rbx;
        call opregion_row_base;
        mov r13, rax;

        mov rdi, rbx;
        call opregion_row_len;
        mov r14, rax;

        mov rax, r12;
        add rax, 4;
        cmp rax, r14;
        ja  dwio_w32_range;

        lea r10, [rip + _dw_io_mode];
        mov r10, [r10 + 0];
        cmp r10, 1;
        je  dwio_w32_synth;

        mfence;
        mov rax, r13;
        add rax, r12;
        mov_d [rax], r15;
        mfence;
        jmp dwio_w32_emit;

      dwio_w32_synth:
        mov rdi, r12;
        mov rsi, r15;
        call dw_io_model_write;

      dwio_w32_emit:
        mov rdi, 2;                      // DW_TRACE_OP_WRITE
        mov rsi, r12;
        mov rdx, r15;
        call dw_io_trace_append;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      dwio_w32_range:
        mov rax, 0xFFFFFF3A;             // DW_IO_RANGE
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      dwio_w32_err:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
