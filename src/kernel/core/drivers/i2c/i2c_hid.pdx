  // ==========================================================================
  // §P  cap_handler_i2c_hid(rights, target_ptr, op_arg) -> u64
  //
  // KIND_I2C_HID_DRV cap_invoke dispatch handler.  Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x45; je
  // call_kind_i2c_hid_drv` arm added alongside this file.
  //
  // The handler is QUERY-ONLY at Wave 76 D13 -- the mutating
  // primitives (probe, read_report_descriptor, compile, reset,
  // read_input_report) ride supervisor callers above the generic
  // cap_invoke syscall ABI.
  //
  //     op 0 QUERY_REPORT_LEN -> last Report Desc length
  //     op 1 QUERY_N_REPORTS  -> rows populated in the table
  //     op 2 QUERY_LAST_BUS   -> last probed bus_slot
  //     op 3 QUERY_LAST_ADDR  -> last probed i2c_addr
  //     else                   -> INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_I2CHID_READ.
  // target_ptr is unused at skeleton stage (query is module-wide,
  // not per-device; follow-up slice adds the per-device row table
  // + per-ptr dispatch).
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg.
  // Stack recipe: 3-push callee-save (rbx=rights, r12=target_ptr,
  // r13=op_code).  Labels prefixed i2hid_hd_.
  // ==========================================================================
  pub let cap_handler_i2c_hid : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 76 D13 (paideia-os#2530): KIND_I2C_HID_DRV cap_invoke dispatch. Entry chatter (klog_s1 of i2hid_tag_handler_entry) with the three incoming regs preserved in callee-save slots. op_code = op_arg & 0xFF; rights gate against R_I2CHID_READ; dispatch 0..3 to the matching accessor; else INVOKE_UNSUPPORTED. target_ptr is unused at skeleton stage (query is module-wide); follow-up slice adds per-device row table + per-ptr dispatch. Three callee-save pushes (rbx=rights, r12=target_ptr, r13=op_code) land rsp%16==0 at every nested call. The 8-bit op_code mask stages through r10 to sidestep `and r11, imm64`. Labels prefixed i2hid_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rights
        mov r12, rsi;                        // target_ptr (unused at skeleton)
        mov r13, rdx;                        // op_arg
        mov r10, 0xFF;
        and r13, r10;                        // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + i2hid_tag_handler_entry];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                      // R_I2CHID_READ
        cmp r10, 0;
        je  i2hid_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  i2hid_hd_op_rlen;
        cmp r13, 1;
        je  i2hid_hd_op_nrep;
        cmp r13, 2;
        je  i2hid_hd_op_lbus;
        cmp r13, 3;
        je  i2hid_hd_op_laddr;
        jmp i2hid_hd_unsup;

      i2hid_hd_op_rlen:
        call i2c_hid_desc_len_q;
        jmp i2hid_hd_out;

      i2hid_hd_op_nrep:
        call i2c_hid_report_count_q;
        jmp i2hid_hd_out;

      i2hid_hd_op_lbus:
        call i2c_hid_last_bus_q;
        jmp i2hid_hd_out;

      i2hid_hd_op_laddr:
        call i2c_hid_last_addr_q;
        jmp i2hid_hd_out;

      i2hid_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        jmp i2hid_hd_out;
      i2hid_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED

      i2hid_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §Q  Boot wiring note
  // ----------------
  // kernel_main.pdx picks up `i2c_hid_module_reset` alongside the
  // existing drivers' reset calls at the follow-up slice:
  //
  //   call i2c_hid_module_reset;   // defensive zero of scratch + state
  //
  // Zero-arg, allocates nothing on the stack, touches rax/rcx/r10
  // only; safe alongside kernel_main's live r12/r13/r14 handoff
  // registers.  The wiring itself is deferred to a follow-up slice
  // (same discipline every other `*_table_reset` boot wiring
  // follows -- firmware_blob_table_reset was declared in Wave 73
  // and wired a slice later).  At real boot .bss zero-init leaves
  // the scratch empty + _i2c_hid_probed zero, so every entrypoint
  // except i2c_hid_probe (and compile, which runs on an empty
  // scratch) refuses with I2C_HID_ERR_NOT_INITED; the
  // KIND_I2C_HID_DRV dispatch arm is pure plumbing and
  // self-standing.
  // ==========================================================================
}
