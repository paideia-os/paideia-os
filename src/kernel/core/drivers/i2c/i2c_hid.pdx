      effects: {mem}, capabilities: {},
      justification: "Wave 76 D13 (paideia-os#2530): single-load getter for _i2c_hid_probe_ct. Witness-side assertion anchor. Leaf.",
      block: { mov rax, [rip + _i2c_hid_probe_ct]; ret }
