// src/kernel/core/drivers/i2c/i2c_hid.pdx -- Wave 76 D13 [R32]
// paideia-os#2530
//
// Intel/Microsoft I2C-HID transport (specification v1.0) + HID
// Report-Descriptor compiler SKELETON.
//
// I2C-HID lets a HID peripheral (touchpad, touchscreen, pen,
// convertible-sensor) ride on an LPSS I2C bus instead of USB.  Each
// I2C-HID device exposes a 30-byte HID Descriptor at a register
// offset the firmware reports via an ACPI _DSM; the HID Descriptor
// in turn points at a Report Descriptor; the Report Descriptor is a
// HID 1.11 item stream the host compiles into a per-report-ID map of
// {input_bits, output_bits, feature_bits} the IRQ hot path then
// uses to size each input report read.
//
// This file is the TOP-LEVEL seam that:
//
//   (1) reads the HID Descriptor at the firmware-reported offset,
//   (2) reads the Report Descriptor into a 1024-byte scratch buffer,
//   (3) compiles the Report Descriptor into an 8-row usage table,
//   (4) exposes a per-report-ID "read input report" primitive, and
//   (5) issues the HID RESET command.
//
// Every entrypoint is a STRUCTURAL STUB -- it emits a klog witness
// recording what it was called with, records a bounded fragment of
// the arguments into module-local state so a follow-up slice can
// stitch the real body in without reshaping the ABI, and returns
// either OK or the matching failure code from the task-directive-
// reserved band (0xFFFFFFFB..FF).  The real body is deferred for
// the same reason lpss_i2c's stubs defer their work: the LPSS I2C
// transfer state machine (`dw_xfer.pdx`) is not yet reachable
// through a KIND_I2C_SLAVE capability, and `lpss_i2c_read` /
// `lpss_i2c_write` themselves still return INVOKE_UNSUPPORTED at
// paideia-as v0.36.82.  See `lpss_i2c.pdx` §WHY STUBS.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND IS DELIBERATELY NOT
// =============================================================================
//
// It IS the transport-layer glue between the LPSS I2C controller
// (D6, Wave 72, `drivers/i2c/lpss_i2c.pdx`) and the eventual D14
// Synaptics touchpad driver.  It owns:
//
//   * the 30-byte HID-Descriptor read + decode,
//   * the Report-Descriptor read into a module-owned 1024-byte
//     scratch,
//   * a bounded (max 8 report IDs) item-stream compiler,
//   * the HID RESET command sequence (SET_POWER = ON + RESET).
//
// It IS NOT the authority-layer HID event delivery substrate.
// That is the R32 cluster that already lives under
// `src/kernel/core/drivers/hid/` + `src/kernel/core/drivers/i2c_hid/`
// (collection_walker.pdx, report_parser.pdx, usage.pdx, isr.pdx,
// reset_wake.pdx, quirks.pdx, descriptor.pdx, transport.pdx -- the
// Wave 59 D13 R32.M1..M3 slice from the paideia-as era).  Those
// files are the policy / HID-protocol half of the stack above the
// raw I2C transport; this file is the transport-primitive half
// below it.  The two coexist for the same reason iris_xe_cursor.pdx
// (G3 register-level) and plane_cursor.pdx (R36.M4-004 cap-side)
// coexist: this file does the LPSS I2C-level work, the i2c_hid/
// cluster does the HID-protocol-level work above it.  Symbol
// namespaces are disjoint (this file's entrypoints end in `_probe`,
// `_read_report_descriptor`, `_compile_report_descriptor`,
// `_read_input_report`, `_reset`; the i2c_hid/ cluster uses
// `_transport_*`, `_descriptor_*`, `_isr_*`, `_reset_*`).
//
// It IS NOT the mint path.  `cap_handler_i2c_hid` is query-only at
// Wave 76 D13 -- the mint of a KIND_I2C_HID_DRV cap from a scan hit
// rides supervisor callers above the cap_invoke syscall ABI.
//
// =============================================================================
// SECTION 1  HID DESCRIPTOR LAYOUT (30 bytes, little-endian)
// =============================================================================
//
// Per I2C-HID specification v1.0 §5.1 (Microsoft):
//
//   offset  width  field
//   ------  -----  -------------------------------------------------
//   0x00    u16    wHIDDescLength       (always 30 for v1.0)
//   0x02    u16    bcdVersion           (BCD, usually 0x0100)
//   0x04    u16    wReportDescLength    (length of the Report Desc)
//   0x06    u16    wReportDescRegister  (register to read it from)
//   0x08    u16    wInputRegister       (register for input reports)
//   0x0A    u16    wMaxInputLength      (max input-report size + 2)
//   0x0C    u16    wOutputRegister      (register for output reports)
//   0x0E    u16    wMaxOutputLength     (max output-report size + 2)
//   0x10    u16    wCommandRegister     (register for commands)
//   0x12    u16    wDataRegister        (register for command data)
//   0x14    u16    wVendorID
//   0x16    u16    wProductID
//   0x18    u16    wVersionID
//   0x1A    4 B    reserved             (set to 0 by firmware)
//
// All multi-byte fields are little-endian.  The real body composes
// u16 reads via `(hi << 8) | lo` using `shl r, 8` + `or r, lo` so
// no `and r11, imm64` is needed (pdx-encoder pitfall).
//
// =============================================================================
// SECTION 2  REPORT DESCRIPTOR COMPILER (bounded, skeleton)
// =============================================================================
//
// A HID 1.11 Report Descriptor is a stream of items, each one byte
// of prefix + 0..4 bytes of data.  The prefix byte encodes:
//
//   bits [1:0]  size      (bSize: 0..3 -> 0, 1, 2, 4 bytes)
//   bits [3:2]  type      (bType: 0 main, 1 global, 2 local)
//   bits [7:4]  tag       (bTag:  item identifier)
//
// At skeleton level this module parses ONLY the six items I2C-HID
// top-level touchpad descriptors need:
//
//   0x05  Usage Page   (global, 1-byte data)
//   0x85  Report ID    (global, 1-byte data) -- selects the row
//   0x81  Input        (main,   1-byte data) -- bumps input_bits of
//                                               the current row
//   0x91  Output       (main,   1-byte data) -- bumps output_bits
//   0xB1  Feature      (main,   1-byte data) -- bumps feature_bits
//   0xA1  Collection   (main,   1-byte data) -- tracked, no bits
//
// Report-size + report-count tracking (Global tags 0x75 / 0x95) is
// INTENTIONALLY DEFERRED to the follow-up slice.  At skeleton level
// each Input / Output / Feature item simply bumps the corresponding
// row by 8 bits (one byte): the real body multiplies the current
// bSize * bCount pair.  Deferring the arithmetic keeps the skeleton
// strictly bounded (one branch per item type, no running state) and
// means a would-be premature caller gets a USABLE-SHAPE table
// (nonzero bit counts per report ID) that is observably wrong rather
// than a plausible but incorrect one.
//
// Table layout:  `_i2c_hid_report_table : [u64; 32]`
//
//   Row i (0..7) occupies u64[i*4 .. i*4 + 3]:
//     +0  report_id        (u64, 0 = unused)
//     +8  input_size_bits
//     +16 output_size_bits
//     +24 feature_size_bits
//
//   Stride 32 bytes = 4 u64 = `shl 5` (no 2-op `imul`).
//
// Overflow: a 9th distinct report ID returns I2C_HID_ERR_COMPILE_OF
// (0xFFFFFFFD) and the table is NOT truncated past row 7 -- the
// first 8 rows reflect what fit.  A follow-up slice can mint a
// larger table once the compile frontier moves.
//
// =============================================================================
// SECTION 3  DISPATCH SLOT -- KIND_I2C_HID_DRV = 0x45
// =============================================================================
//
// Wave 75 and Wave 76 together populate the 0x40..0x45 driver-kind
// run above the Wave 74 KIND_PPGTT (0x3F) terminator:
//
//   0x40 KIND_FAN_DRV           (Wave 75 D11, drivers/acpi/fan.pdx)
//   0x41 KIND_HOTPLUG_DRV       (Wave 75 G4,  drivers/dpy/iris_xe_hotplug.pdx)
//   0x42 KIND_BLKDEV            (R51 pre-existing)
//   0x43 KIND_GPU_BO_DRV        (Wave 75 G6,  drivers/gpu/kind_gpu_bo_drv.pdx)
//   0x44 KIND_BACKLIGHT_DRV     (Wave 76 D12, parallel landing, drivers/.../backlight)
//   0x45 KIND_I2C_HID_DRV       (THIS FILE, Wave 76 D13)
//
// Audit at landing time (grep over `src/kernel/core/cap/`):
//
//   $ grep -nE 'cmp rcx, 0x45\b|mov r9, 0x45\b' \
//         src/kernel/core/cap/invoke.pdx
//   (empty)
//   $ grep -rnE 'KIND_I2C_HID\b|KIND_I2C_HID_DRV\b' src/kernel/
//   (empty)
//
// 0x44 is dispatched in parallel by the Wave 76 D12 (backlight)
// softarch landing; this file takes 0x45 to preserve adjacency with
// that run.  0x45 fits imm32 with bit 31 clear so the dispatch arm
// uses `cmp rcx, 0x45` directly (no r9 staging).
//
// =============================================================================
// SECTION 4  DERIVATION POSTURE
// =============================================================================
//
// KIND_I2C_HID_DRV derives over KIND_DEVICE (base slot 10): one
// (bus_slot, i2c_addr) pair names one slave on one controller --
// exactly the shape KIND_DEVICE already carries for every
// non-virtual peripheral the kernel addresses.  Same posture as
// KIND_BATTERY_DRV (0x3D over KIND_DEVICE), KIND_THERMAL_ZONE_DRV
// (0x3E over KIND_DEVICE), KIND_FAN_DRV (0x40 over KIND_DEVICE).
// The dispatch arm in cap/invoke.pdx compares the FULL u64 kind
// field, so the slot-10 KIND_DEVICE handler and this kind coexist
// cleanly (same fall-through-safe pattern every derived kind in
// that file uses).
//
// target_ptr encoding (follow-up slice): [31:24] bus_slot,
// [23:16] i2c_addr, [15:0] reserved.  At the Wave 76 skeleton stage
// target_ptr is passed through to the query dispatch without
// decoding -- the dispatch is query-only and reads the single
// module-wide last-probed state (last_bus / last_addr) rather than
// a per-device row.  A follow-up slice adds the per-device row
// table + mint path alongside KIND_BATTERY_DRV / KIND_FAN_DRV.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY 0xFFFFFFFB..FF (TASK-DIRECTIVE RESERVED)
// =============================================================================
//
// Five codes per the Wave 76 D13 task directive (all five fit imm32
// with bit 31 clear so `mov rax, imm32` is a 7-byte emit):
//
//   I2C_HID_ERR_NOT_INITED   = 0xFFFFFFFB  -- lpss_i2c_init not yet
//                                             called for bus_slot
//   I2C_HID_ERR_BAD_HID_DESC = 0xFFFFFFFC  -- hid_desc_offset_u16
//                                             rejected by firmware or
//                                             HID Desc read failed
//   I2C_HID_ERR_COMPILE_OF   = 0xFFFFFFFD  -- >8 report IDs seen
//                                             during compile
//   I2C_HID_ERR_RESET        = 0xFFFFFFFE  -- RESET command refused
//                                             (ACK timeout at the
//                                             data register)
//   I2C_HID_ERR_TRANSPORT    = 0xFFFFFFFF  -- bare transport error --
//                                             lpss_i2c_read /
//                                             lpss_i2c_write refused
//                                             the transfer
//
// Module-local collision policy per cap/kind_op_region.pdx §4:
// these codes never leave the i2c_hid surface, so collision with
// the standard cap_invoke sentinels (0xFFFFFFFFFFFFFFFC..FE) is
// observable only when a caller does a cast that this module
// explicitly does not perform.  Every entrypoint returns a u32-
// shaped value; a caller zero-extends via `mov eax, eax` before
// comparing against a 64-bit sentinel.
//
// =============================================================================
// SECTION 6  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag 0x45 and all five error sentinels fit imm32 with bit 31
// clear.  No `test rN,rN` anywhere (liveness checks use
// `cmp rN, 0`).  No `and r11, imm64`; the two masked compares
// (op_code & 0xFF, i2c_addr & 0xFF) stage through r10 as an imm32.
// No 2-op `imul r,imm`; the per-report-row stride multiply uses
// `shl 5` (stride 32 is a power of two).  All `pub let` string
// declarations are on single lines.  Module basename `I2cHid`
// matches the file basename `i2c_hid.pdx`.  Every label is
// prefixed `i2hid_` (reserved-word discipline -- `loop` / `if` /
// `let` are keywords).  Fingerprint tag sizes equal literal
// length + 1 (null terminator) exactly.
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage.  The file
// compiles alongside the kernel because tools/build.sh recurses
// through src/kernel/core/drivers/i2c/ with a single `find`
// (tools/build.sh:574), so a new .pdx in that directory is picked
// up automatically; no build.sh edit required.
//
// invoke.pdx gets ONE new dispatch arm (0x45 -> cap_handler_i2c_hid)
// alongside this file; the arm sits between the Wave 75 G6 0x43
// KIND_GPU_BO_DRV arm and (eventually) the parallel-landing D12
// 0x44 KIND_BACKLIGHT_DRV arm.  Landing order between the two
// parallel waves is first-come first-served: whichever softarch
// lands first takes the first inserted arm, the second takes the
// adjacent slot.  Both are independent file edits.
//
// A follow-up slice adds a boot-witness programme at
// tests/kernel/drivers/wit_i2c_hid_probe.pdx that:
//   (1) lpss_i2c_init(mmio_base, SPEED_FAST);  // Wave 60 real body
//   (2) i2c_hid_probe(bus=0, addr=0x15, hid_desc_offset=0x0020);
//   (3) i2c_hid_read_report_descriptor(bus=0, addr=0x15);
//   (4) i2c_hid_compile_report_descriptor();
//   (5) i2c_hid_read_input_report(report_id=1);
//   (6) i2c_hid_reset(bus=0, addr=0x15);
// and asserts the three fingerprints land on the klog wire plus
// the five counter getters report (1, 1, 1, 1, 1).

module I2cHid = structure {

  // ==========================================================================
  // §A  KIND / rights
  // ==========================================================================

  pub let KIND_I2C_HID_DRV      : u64 = 0x45    // Wave 76 D13 derived-kind tag
  pub let KIND_I2C_HID_DRV_BASE : u64 = 10      // = KIND_DEVICE

  pub let R_I2CHID_READ   : u64 = 0x001         // query ops
  pub let R_I2CHID_WRITE  : u64 = 0x002         // RESET + compile
  pub let R_I2CHID_ALL    : u64 = 0x003         // handed to the holder on create

  // ==========================================================================
  // §B  HID Descriptor field offsets (section 1 above)
  // ==========================================================================

  pub let I2C_HID_OFF_HID_DESC_LEN     : u64 = 0x00
  pub let I2C_HID_OFF_BCD_VERSION      : u64 = 0x02
  pub let I2C_HID_OFF_REPORT_DESC_LEN  : u64 = 0x04
  pub let I2C_HID_OFF_REPORT_DESC_REG  : u64 = 0x06
  pub let I2C_HID_OFF_INPUT_REG        : u64 = 0x08
  pub let I2C_HID_OFF_MAX_INPUT_LEN    : u64 = 0x0A
  pub let I2C_HID_OFF_OUTPUT_REG       : u64 = 0x0C
  pub let I2C_HID_OFF_MAX_OUTPUT_LEN   : u64 = 0x0E
  pub let I2C_HID_OFF_COMMAND_REG      : u64 = 0x10
  pub let I2C_HID_OFF_DATA_REG         : u64 = 0x12
  pub let I2C_HID_OFF_VENDOR_ID        : u64 = 0x14
  pub let I2C_HID_OFF_PRODUCT_ID       : u64 = 0x16
  pub let I2C_HID_OFF_VERSION_ID       : u64 = 0x18

  pub let I2C_HID_DESC_BYTES           : u64 = 30     // v1.0 fixed length
  pub let I2C_HID_SCRATCH_BYTES        : u64 = 1024   // Report Desc ceiling
  pub let I2C_HID_MAX_REPORTS          : u64 = 8      // table row cap

  // ==========================================================================
  // §C  HID 1.11 item-stream prefixes (section 2 above)
  // ==========================================================================

  pub let I2C_HID_ITEM_USAGE_PAGE : u64 = 0x05
  pub let I2C_HID_ITEM_USAGE      : u64 = 0x09
  pub let I2C_HID_ITEM_COLLECTION : u64 = 0xA1
  pub let I2C_HID_ITEM_END_COLL   : u64 = 0xC0
  pub let I2C_HID_ITEM_REPORT_ID  : u64 = 0x85
  pub let I2C_HID_ITEM_INPUT      : u64 = 0x81
  pub let I2C_HID_ITEM_OUTPUT     : u64 = 0x91
  pub let I2C_HID_ITEM_FEATURE    : u64 = 0xB1

  // ==========================================================================
  // §D  I2C-HID command codes (data register, section 7 in the spec)
  // ==========================================================================

  pub let I2C_HID_CMD_RESET       : u64 = 0x0100   // 1 byte opcode = 0x01
  pub let I2C_HID_CMD_SET_POWER   : u64 = 0x0800   // 0x08 opcode, bits [3:0] = state
  pub let I2C_HID_POWER_ON        : u64 = 0x00
  pub let I2C_HID_POWER_SLEEP     : u64 = 0x01

  // ==========================================================================
  // §E  Failure codes (SECTION 5 above)
  // ==========================================================================

  pub let I2C_HID_OK                   : u64 = 0
  pub let I2C_HID_ERR_NOT_INITED       : u64 = 0xFFFFFFFB
  pub let I2C_HID_ERR_BAD_HID_DESC     : u64 = 0xFFFFFFFC
  pub let I2C_HID_ERR_COMPILE_OF       : u64 = 0xFFFFFFFD
  pub let I2C_HID_ERR_RESET            : u64 = 0xFFFFFFFE
  pub let I2C_HID_ERR_TRANSPORT        : u64 = 0xFFFFFFFF

  // Standard cap_invoke sentinels (full 64-bit).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // ==========================================================================
  // §F  cap_handler_i2c_hid op ordinals (query-only at Wave 76 D13)
  // ==========================================================================

  pub let I2C_HID_OP_QUERY_REPORT_LEN  : u64 = 0   // -> last Report Desc len
  pub let I2C_HID_OP_QUERY_N_REPORTS   : u64 = 1   // -> rows populated in table
  pub let I2C_HID_OP_QUERY_LAST_BUS    : u64 = 2   // -> last probed bus_slot
  pub let I2C_HID_OP_QUERY_LAST_ADDR   : u64 = 3   // -> last probed i2c_addr
  pub let I2C_HID_OP_MAX               : u64 = 3

  // ==========================================================================
  // §G  Module-local state
  //
  // _i2c_hid_scratch     -- 1024-byte Report Descriptor scratch.
  // _i2c_hid_desc        -- 32-byte HID Descriptor cache (30 used).
  // _i2c_hid_report_table-- 8 rows of 4 u64 (report_id, in_bits,
  //                          out_bits, feat_bits), stride 32 B.
  // The scalars below cache the last probe's HID-Desc fields so
  // the follow-up slice's input-report path can issue reads to
  // the right register without re-probing.  All counters are
  // single u64 to match the firmware_blob / fan / hotplug witness
  // discipline (one bump per successful entry).
  // ==========================================================================

  pub let mut _i2c_hid_scratch        : [u8;  1024] = uninit @align(64)
  pub let mut _i2c_hid_desc           : [u8;  32]   = uninit @align(8)
  pub let mut _i2c_hid_report_table   : [u64; 32]   = uninit @align(64)

  pub let mut _i2c_hid_desc_len       : u64 = 0
  pub let mut _i2c_hid_desc_reg       : u64 = 0
  pub let mut _i2c_hid_input_reg      : u64 = 0
  pub let mut _i2c_hid_output_reg     : u64 = 0
  pub let mut _i2c_hid_cmd_reg        : u64 = 0
  pub let mut _i2c_hid_data_reg       : u64 = 0
  pub let mut _i2c_hid_max_input      : u64 = 0

  pub let mut _i2c_hid_last_bus       : u64 = 0
  pub let mut _i2c_hid_last_addr      : u64 = 0
  pub let mut _i2c_hid_report_count   : u64 = 0
  pub let mut _i2c_hid_probed         : u64 = 0

  // Per-entrypoint stats, bumped once per successful entry.
  pub let mut _i2c_hid_probe_ct       : u64 = 0
  pub let mut _i2c_hid_read_rd_ct     : u64 = 0
  pub let mut _i2c_hid_compile_ct     : u64 = 0
  pub let mut _i2c_hid_input_ct       : u64 = 0
  pub let mut _i2c_hid_reset_ct       : u64 = 0

  // ==========================================================================
  // §H  Fingerprint tags + keys
  //
  // On the wire:
  //   I2C_HID PROBE bus=<dec> addr=0x<2-hex> report_len=<dec>
  //   I2C_HID COMPILE n_reports=<dec>
  //   I2C_HID RESET bus=<dec> addr=0x<2-hex>
  //
  // The PROBE emission uses `klog_s1_d2_x1` -- the available wrapper
  // closest to the directive's shape (2 decimal + 1 hex KVs).  The
  // KV order on the wire lands (bus=dec)(report_len=dec)(addr=hex);
  // the golden file is seeded with the directive-specified text
  // (bus, addr, report_len) as a FORMAT ANCHOR.  Same discipline
  // lpss_i2c.golden uses (`I2C BUS SCAN OK n_responders=<n>
  // addrs=0x<hex-list>` where the stub emits only `base=0x<hex>`):
  // the golden anchors the follow-up slice's real emission, not the
  // skeleton's witness line.  A follow-up slice mints
  // `klog_s1_d1_x1_d1` (dec, hex, dec) and this call site drops
  // the gymnastics.
  //
  // The RESET emission uses `klog_s1_x1_d1` (hex + dec), emitting
  // (addr=hex)(bus=dec); the golden anchors (bus=dec)(addr=hex) per
  // the directive.
  //
  // The COMPILE emission uses `klog_s1_d1` (one decimal KV); its
  // on-wire shape matches the golden exactly.
  //
  // Matches tests/fingerprints/i2c_hid.golden.
  // ==========================================================================

  pub let i2hid_tag_probe   : [u8; 14] = "I2C_HID PROBE\0"
  pub let i2hid_tag_compile : [u8; 16] = "I2C_HID COMPILE\0"
  pub let i2hid_tag_reset   : [u8; 14] = "I2C_HID RESET\0"

  pub let i2hid_tag_handler_entry : [u8; 30] = "KIND_I2C_HID_DRV dispatch iv\0"

  pub let i2hid_k_bus        : [u8; 4]  = "bus\0"
  pub let i2hid_k_addr       : [u8; 5]  = "addr\0"
  pub let i2hid_k_report_len : [u8; 11] = "report_len\0"
  pub let i2hid_k_n_reports  : [u8; 10] = "n_reports\0"

  // ==========================================================================
  // §I  i2c_hid_module_reset() -> ()  (defensive clear; NOT the HID RESET)
  //
  // Clear the 1024-byte scratch, the 32-byte HID-Desc cache, the
  // 32 u64 of the report-table, the ten scalar cache slots + the
  // five counters.  Called defensively at boot before the first
  // probe.  .bss zero-init at real boot already satisfies the
  // postcondition; this is defensive (matches firmware_blob_table_
  // reset / gpu_gtt_reset / iris_xe_hotplug_reset shape).
  //
  // Name is `_module_reset` so the task-directive-mandated
  // `i2c_hid_reset(bus, addr)` entrypoint (the HID RESET command)
  // does not shadow it.
  // ==========================================================================
  pub let i2c_hid_module_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 76 D13 (paideia-os#2530): defensive clear of _i2c_hid_scratch (1024 B), _i2c_hid_desc (32 B), _i2c_hid_report_table (32 u64), the ten scalar cache slots, and the five entry counters. .bss zero-init at real boot already satisfies the postcondition; this is defensive, matching firmware_blob_table_reset / iris_xe_hotplug_reset shape. Named `_module_reset` so the ABI-mandated `i2c_hid_reset(bus, addr)` (the HID RESET command) does not shadow it. Labels prefixed i2hid_mr_.",
      block: {
        lea r10, [rip + _i2c_hid_scratch];
        xor rax, rax;
        xor rcx, rcx;
      i2hid_mr_scratch:
        mov [r10 + rcx], al;
        add rcx, 1;
        cmp rcx, 1024;
        jb  i2hid_mr_scratch;

        lea r10, [rip + _i2c_hid_desc];
        xor rcx, rcx;
      i2hid_mr_desc:
        mov [r10 + rcx], al;
        add rcx, 1;
        cmp rcx, 32;
        jb  i2hid_mr_desc;

        lea r10, [rip + _i2c_hid_report_table];
        xor rcx, rcx;
      i2hid_mr_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  i2hid_mr_rows;

        mov [rip + _i2c_hid_desc_len],    rax;
        mov [rip + _i2c_hid_desc_reg],    rax;
        mov [rip + _i2c_hid_input_reg],   rax;
        mov [rip + _i2c_hid_output_reg],  rax;
        mov [rip + _i2c_hid_cmd_reg],     rax;
        mov [rip + _i2c_hid_data_reg],    rax;
        mov [rip + _i2c_hid_max_input],   rax;
        mov [rip + _i2c_hid_last_bus],    rax;
        mov [rip + _i2c_hid_last_addr],   rax;
        mov [rip + _i2c_hid_report_count], rax;
        mov [rip + _i2c_hid_probed],      rax;

        mov [rip + _i2c_hid_probe_ct],    rax;
        mov [rip + _i2c_hid_read_rd_ct],  rax;
        mov [rip + _i2c_hid_compile_ct],  rax;
        mov [rip + _i2c_hid_input_ct],    rax;
        mov [rip + _i2c_hid_reset_ct],    rax;
        ret
      }
    }

  // ==========================================================================
  // §J  i2c_hid_probe(bus_slot, i2c_addr, hid_desc_offset_u16) -> u32
  //
  // Reads the 30-byte HID Descriptor at `hid_desc_offset_u16` on
  // (bus_slot, i2c_addr), caches its ten decoded fields into the
  // module-local scalar slots, stamps _i2c_hid_probed = 1 and
  // _i2c_hid_last_bus / _i2c_hid_last_addr, bumps _i2c_hid_probe_ct,
  // emits the PROBE fingerprint via klog_s1_d2_x1 and returns
  // I2C_HID_OK.
  //
  // The real body:
  //   (1) Builds a 2-byte little-endian register-offset buffer
  //       {lo = offset[7:0], hi = offset[15:8]}.
  //   (2) Calls lpss_i2c_write(mmio_base, i2c_addr, reg=offset_lo,
  //       len=1, buf=&hi) with RESTART_EN -- the firmware-reported
  //       HID-Desc register uses a 2-byte register address, which
  //       on DesignWare I2C requires one 2-byte "address write"
  //       pushed as two IC_DATA_CMD writes with RESTART_EN set,
  //       followed by the read in step (3).
  //   (3) Calls lpss_i2c_read(mmio_base, i2c_addr, reg=0 (continued),
  //       len=30, buf=&_i2c_hid_desc).
  //   (4) Decodes the 15 little-endian u16 fields via (hi<<8)|lo.
  //   (5) Validates wHIDDescLength == 30; if not, returns
  //       I2C_HID_ERR_BAD_HID_DESC.
  //
  // The skeleton bypasses (1)-(5) and records the three arguments
  // + the WRITE/READ fingerprint intent.  The lpss_i2c_* stubs
  // return INVOKE_UNSUPPORTED today, so attempting a real transfer
  // would surface INVOKE_UNSUPPORTED rather than usable bytes;
  // waiting on Wave 60 is the correct discipline.  The skeleton's
  // RETURN of I2C_HID_OK (NOT INVOKE_UNSUPPORTED) is deliberate --
  // a caller debugging the invocation path sees the module-local
  // state transition cleanly and can test the compile / reset
  // paths against stubbed values.  The follow-up slice flips the
  // return to the real-body's rc.
  //
  // Gates in order:
  //   (1) hid_desc_offset_u16 == 0        -> I2C_HID_ERR_BAD_HID_DESC
  //   (2) hid_desc_offset_u16 > 0xFFFF    -> I2C_HID_ERR_BAD_HID_DESC
  //
  // SysV: rdi=bus_slot (u32 widened), rsi=i2c_addr (u8 widened),
  //       rdx=hid_desc_offset_u16 (u32 widened).
  // Register plan: rbx=bus, r12=addr, r13=offset.
  // Entry rsp%16==8; 3 pushes land ==0.  klog_s1_d2_x1 has three
  // stack args at [rsp+8]/+16/+24 (vd2, kx, vx); we `sub rsp, 32`
  // (keeps alignment: 32 is 16-aligned) + stage them + CALL.
  // Labels prefixed i2hid_pr_.
  // ==========================================================================
  pub let i2c_hid_probe : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot, cap} =
    fn (bus_slot: u64) (i2c_addr: u64) (hid_desc_offset_u16: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 76 D13 (paideia-os#2530) skeleton: cache (bus, addr, offset), stamp _i2c_hid_probed=1, bump _i2c_hid_probe_ct, emit `I2C_HID PROBE bus=<dec> addr=0x<hex> report_len=<dec>` via klog_s1_d2_x1 (2 dec + 1 hex KVs). The report_len value is 0 at skeleton stage (the real body decodes wReportDescLength from the HID-Desc read); emitting it here keeps the KV shape the follow-up slice needs. Gates: (1) hid_desc_offset_u16 == 0 -> I2C_HID_ERR_BAD_HID_DESC (0xFFFFFFFC). (2) hid_desc_offset_u16 > 0xFFFF -> I2C_HID_ERR_BAD_HID_DESC. The real body additionally performs a two-step lpss_i2c write-then-read (RESTART_EN) + decodes the 15 u16 fields + validates wHIDDescLength == 30; all deferred to the follow-up slice (lpss_i2c_* still returns INVOKE_UNSUPPORTED at paideia-as v0.36.82). The u8 mask on i2c_addr stages through r10 as imm32 to avoid the `and r11, imm64` pdx-encoder pitfall. Register plan: rbx=bus_slot, r12=i2c_addr, r13=hid_desc_offset. Entry rsp%16==8; three callee-save pushes land ==0; `sub rsp, 32` pad + stage {vd2, kx, vx} at [rsp+8]/+16/+24 + CALL; `add rsp, 32` cleanup. Labels prefixed i2hid_pr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // bus_slot
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                        // i2c_addr = low 8 bits
        mov r13, rdx;                        // hid_desc_offset

        // --- Gate (1): offset == 0 -> bad.
        cmp r13, 0;
        je  i2hid_pr_bad;

        // --- Gate (2): offset > 0xFFFF -> bad.
        //     0xFFFF fits imm32 with bit 31 clear so `cmp r/m64,
        //     imm32` sign-extends correctly.
        cmp r13, 0xFFFF;
        ja  i2hid_pr_bad;

        // --- Record state: last_bus, last_addr, probed=1.
        mov [rip + _i2c_hid_last_bus],  rbx;
        mov [rip + _i2c_hid_last_addr], r12;
        mov rax, 1;
        mov [rip + _i2c_hid_probed],    rax;

        // --- Bump probe counter (before fingerprint).
        mov rax, [rip + _i2c_hid_probe_ct];
        add rax, 1;
        mov [rip + _i2c_hid_probe_ct], rax;

        // --- Emit PROBE fingerprint:
        //       klog_s1_d2_x1(level=3, SUBSYS_DRV_, i2hid_tag_probe,
        //                     kd1=k_bus, vd1=bus_slot,
        //                     kd2=k_report_len, vd2=report_len,
        //                     kx =k_addr, vx =i2c_addr).
        //     paideia-as 6-param ABI: last three (vd2, kx, vx) ride
        //     caller stack at [rsp+8]/+16/+24 (not [rbp+16]/+24/+32,
        //     because we have no rbp frame -- the wrapper itself does
        //     push rbp, so from the WRAPPER view they are at
        //     [rbp+16]/+24/+32; from the CALLER view at this call
        //     site they are at [rsp+8]/+16/+24).
        sub rsp, 32;                                   // align + 3 slots
        mov rax, [rip + _i2c_hid_desc_len];
        mov [rsp + 0],  rax;                           // vd2 = report_len (caller [rsp+0], I7)
        lea rax, [rip + i2hid_k_addr];
        mov [rsp + 8],  rax;                           // kx
        mov [rsp + 16], r12;                           // vx = i2c_addr

        mov rdi, 3;                                    // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + i2hid_tag_probe];
        lea rcx, [rip + i2hid_k_bus];                  // kd1
        mov r8,  rbx;                                  // vd1 = bus_slot
        lea r9,  [rip + i2hid_k_report_len];           // kd2
        call klog_s1_d2_x1;
        add rsp, 32;

        xor rax, rax;                                  // I2C_HID_OK
        jmp i2hid_pr_out;

      i2hid_pr_bad:
        mov rax, 0xFFFFFFFC;                           // I2C_HID_ERR_BAD_HID_DESC

      i2hid_pr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  i2c_hid_read_report_descriptor(bus_slot, i2c_addr) -> u32
  //
  // Reads the Report Descriptor from the device named by the last
  // successful probe into `_i2c_hid_scratch` (up to 1024 bytes).
  //
  // Gates in order:
  //   (1) _i2c_hid_probed == 0            -> I2C_HID_ERR_NOT_INITED
  //   (2) _i2c_hid_last_bus  != bus_slot  -> I2C_HID_ERR_NOT_INITED
  //   (3) _i2c_hid_last_addr != i2c_addr  -> I2C_HID_ERR_NOT_INITED
  //
  // Rationale for gating on exact bus+addr match: the probe binds
  // the HID-Desc register addresses (`_i2c_hid_desc_reg`) to one
  // specific slave; reading the report descriptor from a different
  // slave than the one just probed would mix descriptor-reg context
  // across slaves and compile the wrong report.  Mismatched = not
  // inited for THIS slave.
  //
  // The real body:
  //   (1) Builds a 2-byte LE write of _i2c_hid_desc_reg.
  //   (2) Calls lpss_i2c_read(mmio_base, i2c_addr,
  //       reg=_i2c_hid_desc_reg_lo, len=min(_i2c_hid_desc_len,
  //       1024), buf=&_i2c_hid_scratch).
  //   (3) On short read: zero the tail (the compiler reads up to
  //       _i2c_hid_desc_len bytes and the scratch MUST not carry
  //       stale state from a previous slave).
  //
  // The skeleton stops at the state record + counter bump + no
  // fingerprint (the task directive asks for PROBE + COMPILE +
  // RESET fingerprints only; the report-descriptor READ is a
  // transport step without a separate wire witness).  Returns
  // I2C_HID_OK unconditionally once the three gates pass.
  //
  // SysV: rdi=bus_slot, rsi=i2c_addr.
  // Register plan: rbx=bus, r12=addr.  Two pushes land rsp%16==0.
  // Labels prefixed i2hid_rr_.
  // ==========================================================================
  pub let i2c_hid_read_report_descriptor : (u64, u64) -> u64 !{mem} @{boot, cap} =
    fn (bus_slot: u64) (i2c_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {boot, cap},
      justification: "Wave 76 D13 (paideia-os#2530) skeleton: bind-check (probed AND last_bus == bus_slot AND last_addr == i2c_addr) then bump _i2c_hid_read_rd_ct and return OK. Mismatched bus/addr = NOT_INITED for THIS slave (reading the report desc from a slave the probe did not bind would compile the wrong report). Real body: lpss_i2c_read into _i2c_hid_scratch at _i2c_hid_desc_reg with the ACK-wait pattern specific to I2C-HID (byte-wait: the slave latches the read until data ready); on short-read, zero the tail. The lpss_i2c_* stubs return INVOKE_UNSUPPORTED today, so the real transfer stays deferred. The u8 mask on i2c_addr stages through r10 as imm32 to sidestep `and r11, imm64`. Register plan: rbx=bus, r12=addr. Two callee-save pushes land rsp%16==0 at any nested call. Labels prefixed i2hid_rr_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                        // i2c_addr low 8 bits

        // --- Gate (1): probed?
        mov rax, [rip + _i2c_hid_probed];
        cmp rax, 0;
        je  i2hid_rr_notinit;

        // --- Gate (2): same bus?
        mov rax, [rip + _i2c_hid_last_bus];
        cmp rax, rbx;
        jne i2hid_rr_notinit;

        // --- Gate (3): same addr?
        mov rax, [rip + _i2c_hid_last_addr];
        cmp rax, r12;
        jne i2hid_rr_notinit;

        // --- Bump counter.
        mov rax, [rip + _i2c_hid_read_rd_ct];
        add rax, 1;
        mov [rip + _i2c_hid_read_rd_ct], rax;

        xor rax, rax;                        // I2C_HID_OK
        jmp i2hid_rr_out;

      i2hid_rr_notinit:
        mov rax, 0xFFFFFFFB;                 // I2C_HID_ERR_NOT_INITED

      i2hid_rr_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  i2c_hid_compile_report_descriptor() -> u32
  //
  // Parses `_i2c_hid_scratch` (up to _i2c_hid_desc_len bytes) into
  // `_i2c_hid_report_table` as described in SECTION 2.
  //
  // At skeleton level the compile is a NAMED REFUSAL: with
  // _i2c_hid_desc_len == 0 (no bytes read into scratch) the
  // compiler visits zero items, writes zero rows, and returns
  // I2C_HID_OK with _i2c_hid_report_count == 0.  The COMPILE
  // fingerprint fires with n_reports = 0.  A follow-up slice
  // lands the real walk:
  //
  //     ptr = scratch_base
  //     while ptr < scratch_base + desc_len:
  //         prefix = *ptr
  //         bSize  = prefix & 0x03
  //         data_len = bSize == 3 ? 4 : bSize
  //         match prefix:
  //             0x85 (Report ID):
  //                 rid = *(ptr+1)
  //                 if rid not in table and n_reports < 8:
  //                     table[n_reports++] = { rid, 0, 0, 0 }
  //                 elif n_reports == 8 and rid not in table:
  //                     return I2C_HID_ERR_COMPILE_OF
  //                 current_row = row for rid
  //             0x81 (Input):   current_row.in_bits   += 8
  //             0x91 (Output):  current_row.out_bits  += 8
  //             0xB1 (Feature): current_row.feat_bits += 8
  //         ptr += 1 + data_len
  //
  // (The 8-bit-per-item fudge is intentional at skeleton stage,
  // SECTION 2.  The real body consults the Global tags 0x75
  // report-size and 0x95 report-count that precede each main item.)
  //
  // Returns:
  //   I2C_HID_OK            -- compile completed, table reflects
  //                            scratch (empty scratch -> empty table).
  //   I2C_HID_ERR_COMPILE_OF-- >8 distinct report IDs encountered.
  //
  // SysV: no args.  Register plan: single push for alignment at the
  // klog call (rbx scratched for future use).  Labels i2hid_co_.
  // ==========================================================================
  pub let i2c_hid_compile_report_descriptor : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 76 D13 (paideia-os#2530) skeleton: zero rows at skeleton stage (scratch is empty), stamp _i2c_hid_report_count=0, bump _i2c_hid_compile_ct, emit `I2C_HID COMPILE n_reports=<dec>` via klog_s1_d1. Real body walks the HID 1.11 item stream in _i2c_hid_scratch (SECTION 2 above) populating up to I2C_HID_MAX_REPORTS=8 rows of {report_id, input_bits, output_bits, feature_bits}; the 9th distinct report ID returns I2C_HID_ERR_COMPILE_OF (0xFFFFFFFD). At skeleton stage every call sees desc_len==0 and compile is a named no-op. Register plan: one callee-save push (rbx) leaves rsp%16==0 at klog_s1_d1 CALL. Labels prefixed i2hid_co_.",
      block: {
        push rbx;

        // --- Zero report-count (table rows are untouched at skeleton stage).
        xor rax, rax;
        mov [rip + _i2c_hid_report_count], rax;

        // --- Bump compile counter.
        mov rax, [rip + _i2c_hid_compile_ct];
        add rax, 1;
        mov [rip + _i2c_hid_compile_ct], rax;

        // --- Emit COMPILE fingerprint:
        //       klog_s1_d1(level=3, SUBSYS_DRV_, i2hid_tag_compile,
        //                  k_n_reports, 0).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + i2hid_tag_compile];
        lea rcx, [rip + i2hid_k_n_reports];
        mov rax, [rip + _i2c_hid_report_count];
        mov r8,  rax;
        call klog_s1_d1;

        xor rax, rax;                        // I2C_HID_OK
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  i2c_hid_read_input_report(report_id) -> u32
  //
  // Issues a byte-wait transaction that returns the next input
  // report for `report_id`.  On I2C-HID this is a single
  // byte-wait read against `_i2c_hid_input_reg`: the slave latches
  // the read until the report is ready, at which point the host
  // sees {total_len_lo, total_len_hi, report_id, payload...}.
  //
  // Gates in order:
  //   (1) _i2c_hid_probed == 0   -> I2C_HID_ERR_NOT_INITED
  //   (2) report_id > 0xFF       -> I2C_HID_ERR_TRANSPORT
  //                                 (a report ID outside the HID 1.11
  //                                  single-byte range cannot have
  //                                  come from a compiled scratch;
  //                                  treating it as a transport
  //                                  misuse per the error-band
  //                                  intent).
  //
  // The skeleton stops at the state check + counter bump; no
  // fingerprint (the input-report hot path fires at every edge
  // and would flood the klog on a touchpad test, same reason
  // iris_xe_hotplug_mask has no fingerprint).  Returns I2C_HID_OK
  // once the gates pass.
  //
  // SysV: rdi = report_id.
  // Register plan: one push for callee-save discipline (no nested
  // call at skeleton stage).  Labels prefixed i2hid_in_.
  // ==========================================================================
  pub let i2c_hid_read_input_report : (u64) -> u64 !{mem} @{boot, cap} =
    fn (report_id: u64) -> unsafe {
      effects: {mem}, capabilities: {boot, cap},
      justification: "Wave 76 D13 (paideia-os#2530) skeleton: validate probed + report_id, bump _i2c_hid_input_ct, return OK (or I2C_HID_ERR_NOT_INITED / I2C_HID_ERR_TRANSPORT). No fingerprint -- the input-report hot path fires at every ISR edge, flooding the klog would hide real failures (same discipline iris_xe_hotplug_mask / fan_apply_policy follow). Real body: lpss_i2c_read(mmio_base, last_addr, _i2c_hid_input_reg, max_input, buf) with byte-wait (slave latches the read until ready). The scratch buffer serves as the per-call payload sink until the follow-up slice adds per-report-id ring buffers. Register plan: one push (rbx) leaves rsp%16==0 at any nested call (none at skeleton stage; the push is prophylactic for the follow-up slice's lpss_i2c_read). Labels prefixed i2hid_in_.",
      block: {
        push rbx;

        mov rbx, rdi;                        // report_id

        // --- Gate (1): probed?
        mov rax, [rip + _i2c_hid_probed];
        cmp rax, 0;
        je  i2hid_in_notinit;

        // --- Gate (2): report_id in 1-byte range?
        //     0xFF fits imm8; `cmp r/m64, imm8` sign-extends.
        cmp rbx, 0xFF;
        ja  i2hid_in_transport;

        // --- Bump counter.
        mov rax, [rip + _i2c_hid_input_ct];
        add rax, 1;
        mov [rip + _i2c_hid_input_ct], rax;

        xor rax, rax;                        // I2C_HID_OK
        jmp i2hid_in_out;

      i2hid_in_notinit:
        mov rax, 0xFFFFFFFB;                 // I2C_HID_ERR_NOT_INITED
        jmp i2hid_in_out;
      i2hid_in_transport:
        mov rax, 0xFFFFFFFF;                 // I2C_HID_ERR_TRANSPORT

      i2hid_in_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  i2c_hid_reset(bus_slot, i2c_addr) -> u32
  //
  // Issues the HID RESET command sequence per I2C-HID v1.0 §7.2:
  //
  //   (1) Write 2-byte LE address of _i2c_hid_cmd_reg to the slave.
  //   (2) Write 1-byte opcode = I2C_HID_CMD_RESET = 0x01, followed
  //       by 1 byte of reportType=0 / reportId=0.
  //   (3) Wait for the slave to signal reset-complete by reading
  //       zero-length input (ACK on input_reg == 0x00 0x00).
  //   (4) Issue SET_POWER = ON (opcode 0x08, state 0) to leave the
  //       slave armed.
  //
  // Gates in order (identical to i2c_hid_read_report_descriptor):
  //   (1) _i2c_hid_probed == 0            -> I2C_HID_ERR_NOT_INITED
  //   (2) _i2c_hid_last_bus  != bus_slot  -> I2C_HID_ERR_NOT_INITED
  //   (3) _i2c_hid_last_addr != i2c_addr  -> I2C_HID_ERR_NOT_INITED
  //
  // The real body additionally fails with I2C_HID_ERR_RESET
  // (0xFFFFFFFE) if either lpss_i2c_write refuses the command
  // bytes or the reset-complete ACK fails to arrive within the
  // spec's 1-second window.  At skeleton stage the fail path is
  // not reached (lpss_i2c_* stubs do not run), and the entrypoint
  // returns OK once the three gates pass.
  //
  // Emits the RESET fingerprint via klog_s1_x1_d1 (addr=hex,
  // bus=dec).
  //
  // SysV: rdi=bus_slot, rsi=i2c_addr.
  // Register plan: three callee-save pushes (rbx, r12, r13) land
  // rsp%16==0; klog_s1_x1_d1 7th arg (vd=bus_slot) via
  // `sub rsp, 16; mov [rsp+0], vd; call; add rsp, 16` idiom
  // (v2 at caller [rsp+0], NOT [rsp+8] -- Wave 73 I7 pitfall).
  // Labels prefixed i2hid_rs_.
  // ==========================================================================
  pub let i2c_hid_reset : (u64, u64) -> u64 !{mem, sysreg} @{boot, cap} =
    fn (bus_slot: u64) (i2c_addr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 76 D13 (paideia-os#2530) skeleton: gate (probed AND same bus AND same addr), bump _i2c_hid_reset_ct, emit `I2C_HID RESET bus=<dec> addr=0x<hex>` via klog_s1_x1_d1 (hex key `addr`, decimal key `bus`). Real body issues the two-step CMD_RESET + SET_POWER=ON sequence over lpss_i2c_write and waits for the reset-complete zero-length input ACK; a timeout returns I2C_HID_ERR_RESET (0xFFFFFFFE). All deferred because lpss_i2c_write at paideia-as v0.36.82 returns INVOKE_UNSUPPORTED. The u8 mask on i2c_addr stages through r10 as imm32. klog_s1_x1_d1 caller stack recipe: `sub rsp, 16; mov [rsp+0], r12 (vd)` places vd at caller [rsp+0] -- the Wave 73 I7 trap was writing to [rsp+8] from the caller view, which the wrapper then reads as the k2 slot and the test matches on garbage. Register plan: rbx=bus, r12=addr, r13=unused scratch. Three callee-save pushes land rsp%16==0; +16 pad places us ==0 at the CALL. Labels prefixed i2hid_rs_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // bus_slot
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                        // i2c_addr low 8 bits

        // --- Gate (1): probed?
        mov rax, [rip + _i2c_hid_probed];
        cmp rax, 0;
        je  i2hid_rs_notinit;

        // --- Gate (2): same bus?
        mov rax, [rip + _i2c_hid_last_bus];
        cmp rax, rbx;
        jne i2hid_rs_notinit;

        // --- Gate (3): same addr?
        mov rax, [rip + _i2c_hid_last_addr];
        cmp rax, r12;
        jne i2hid_rs_notinit;

        // --- Bump reset counter.
        mov rax, [rip + _i2c_hid_reset_ct];
        add rax, 1;
        mov [rip + _i2c_hid_reset_ct], rax;

        // --- Emit RESET fingerprint:
        //       klog_s1_x1_d1(level=3, SUBSYS_DRV_, i2hid_tag_reset,
        //                     kx=k_addr, vx=i2c_addr,
        //                     kd=k_bus,  vd=bus_slot).
        //     The wrapper reads vd from caller [rsp+0] (NOT [rsp+8]).
        sub rsp, 16;
        mov [rsp + 0], rbx;                  // vd = bus_slot (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + i2hid_tag_reset];
        lea rcx, [rip + i2hid_k_addr];       // kx
        mov r8,  r12;                        // vx = i2c_addr (hex)
        lea r9,  [rip + i2hid_k_bus];        // kd
        call klog_s1_x1_d1;
        add rsp, 16;

        xor rax, rax;                        // I2C_HID_OK
        jmp i2hid_rs_out;

      i2hid_rs_notinit:
        mov rax, 0xFFFFFFFB;                 // I2C_HID_ERR_NOT_INITED

      i2hid_rs_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  Stat accessors + state getters -- single-load leaf getters.
  // ==========================================================================

