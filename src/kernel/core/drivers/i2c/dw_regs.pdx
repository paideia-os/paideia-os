// src/kernel/core/drivers/i2c/dw_regs.pdx — R30.M5-003 (#1072)
//
// Synopsys DesignWare APB I²C (DW_apb_i2c) register map, Intel LPSS
// private-space map, and the SCL divider derivation.
//
// This file contains NO register access. It is constants plus pure
// arithmetic, and that separation is deliberate: the divider derivation
// is the part of this milestone that is worth testing, and it is only
// testable in isolation if it never touches a bus.
//
// -----------------------------------------------------------------------------
// WHY THE CONTROLLER IS A SYNOPSYS CORE AND NOT AN INTEL ONE
// -----------------------------------------------------------------------------
//
// Intel's LPSS ("Low Power Sub-System") I²C controllers are not Intel
// designs. They are licensed Synopsys DW_apb_i2c instances with an
// Intel wrapper bolted in front of them: a PCI function header, a
// reset/clock private register block at BAR0 + 0x200, and an integrated
// DMA engine. Everything from BAR0 + 0x000 to BAR0 + 0x0FF is the
// Synopsys databook's register map, unchanged.
//
// That fact is the identification strategy of this milestone; see
// lpss_probe.pdx. It also means the register offsets below are stable
// across every Intel PCH generation that has shipped LPSS, and across
// the non-Intel SoCs that license the same core.
//
// -----------------------------------------------------------------------------
// REGISTER MAP — offsets from BAR0, all 32-bit
// -----------------------------------------------------------------------------
//
//   0x00  IC_CON             Control. Master mode, speed, restart-enable,
//                            slave-disable, 10-bit master addressing.
//   0x04  IC_TAR             Target address. [9:0] TAR, bit 12 selects
//                            10-bit master addressing. WRITABLE ONLY
//                            WHILE THE CONTROLLER IS DISABLED (unless
//                            the IP was configured with dynamic TAR
//                            update, which the LPSS instances are not).
//   0x08  IC_SAR             Slave address (we are never a slave).
//   0x10  IC_DATA_CMD        The FIFO port. Write = push a command;
//                            read = pop a received byte.
//                              [7:0] DAT     data byte (write direction)
//                              [8]   CMD     1 = read, 0 = write
//                              [9]   STOP    issue STOP after this byte
//                              [10]  RESTART issue RESTART before it
//   0x14  IC_SS_SCL_HCNT     Standard-mode SCL high count
//   0x18  IC_SS_SCL_LCNT     Standard-mode SCL low count
//   0x1C  IC_FS_SCL_HCNT     Fast / Fast-plus SCL high count
//   0x20  IC_FS_SCL_LCNT     Fast / Fast-plus SCL low count
//   0x24  IC_HS_SCL_HCNT     High-speed SCL high count
//   0x28  IC_HS_SCL_LCNT     High-speed SCL low count
//   0x2C  IC_INTR_STAT       Masked interrupt status
//   0x30  IC_INTR_MASK       Interrupt mask (1 = delivered)
//   0x34  IC_RAW_INTR_STAT   Unmasked interrupt status — the register
//                            the polled transfer engine actually reads.
//   0x38  IC_RX_TL           RX FIFO threshold
//   0x3C  IC_TX_TL           TX FIFO threshold
//   0x40  IC_CLR_INTR        Read-to-clear: clears every combined
//                            interrupt. Read only; the value is junk.
//   0x54  IC_CLR_TX_ABRT     Read-to-clear: clears TX_ABRT **and
//                            releases the TX FIFO from the flush-held
//                            state**. Not reading it after an abort is
//                            what wedges a DesignWare controller.
//   0x60  IC_CLR_STOP_DET    Read-to-clear: STOP_DET
//   0x6C  IC_ENABLE          [0] ENABLE, [1] ABORT, [2] TX_CMD_BLOCK
//   0x70  IC_STATUS          [0] ACTIVITY, [1] TFNF, [2] TFE,
//                            [3] RFNE, [4] RFF, [5] MST_ACTIVITY,
//                            [6] SLV_ACTIVITY
//   0x74  IC_TXFLR           TX FIFO level
//   0x78  IC_RXFLR           RX FIFO level
//   0x7C  IC_SDA_HOLD        SDA hold time, [15:0] TX, [23:16] RX
//   0x80  IC_TX_ABRT_SOURCE  Why the last transfer aborted. Latched
//                            until IC_CLR_TX_ABRT is read.
//   0x88  IC_DMA_CR          DMA control — written 0, we are PIO.
//   0x9C  IC_ENABLE_STATUS   [0] IC_EN — the ACTUAL enable state, which
//                            lags IC_ENABLE by up to 25 bus cycles.
//                            Polling this, not IC_ENABLE, is what makes
//                            "disabled before configuring" true rather
//                            than merely requested.
//   0xA0  IC_FS_SPKLEN       Fast-mode spike-suppression length
//   0xA4  IC_HS_SPKLEN       High-speed spike-suppression length
//   0xF4  IC_COMP_PARAM_1    Synthesis parameters (FIFO depths)
//   0xF8  IC_COMP_VERSION    Core version, ASCII-ish BCD
//   0xFC  IC_COMP_TYPE       Constant 0x44570140 in every DW_apb_i2c
//                            ever synthesised. THE IDENTIFICATION.
//
// -----------------------------------------------------------------------------
// INTEL LPSS PRIVATE SPACE — offsets from BAR0
// -----------------------------------------------------------------------------
//
//   0x200 + 0x04  = 0x204   RESETS
//                            [0] iDMA reset release (bit 0)
//                            [1] iDMA reset release (bit 1)
//                            [2] function (I²C core) reset release
//                           All three must be SET to bring the block out
//                           of reset. Value 0x7. Until this is written,
//                           every DesignWare register reads back zero —
//                           including IC_COMP_TYPE, which is why the
//                           identification read must happen AFTER the
//                           reset release and not before.
//   0x200 + 0x800 = 0xA00   CLOCK PARAMS. Not written: the LPSS clock
//                           gate defaults to the SoC's fixed source and
//                           the divider fields are only meaningful on
//                           parts that expose a fractional divider. See
//                           the clock-provenance section below.
//
// -----------------------------------------------------------------------------
// THE DIVIDER, AND WHERE THE INPUT CLOCK COMES FROM
// -----------------------------------------------------------------------------
//
// DesignWare does not take a bit rate. It takes SCL high and low counts
// measured in periods of the core's input clock (ic_clk), and derives
// the bit rate from them. So programming a rate means answering two
// questions, and the second one is the dangerous one:
//
//   1. What high/low times does the I²C specification require at this
//      rate? — a table, in the standard, reproduced below.
//   2. What is ic_clk? — NOT DISCOVERABLE FROM ANY REGISTER.
//
// There is no register in the DesignWare core, in the Intel LPSS
// wrapper, or in PCI configuration space that reports ic_clk. It is a
// property of the SoC's clock tree, fixed at silicon design time. The
// three values Intel has shipped are 100 MHz (Sunrise Point through
// Raptor Lake, i.e. the T14 G4), 120 MHz (Broxton/Apollo Lake) and
// 133 MHz (a small number of Atom parts).
//
// PROVENANCE LADDER, best first:
//
//   (a) FIRMWARE-SUPPLIED COUNTS. The platform's firmware carries
//       per-controller methods (conventionally named SSCN, FMCN, FPCN,
//       HSCN) that return the HCNT/LCNT pair the board designer
//       validated, with that board's pull-up resistors and trace
//       capacitance already folded in. This is strictly better than
//       anything computable here, because the rise/fall times are
//       properties of the board and not of the part. Evaluating them
//       requires the interpreter session R30.M1..M3 built, and the
//       supervisor-to-kernel hop that carries the result does not exist
//       yet. DEFERRED, and named as deferred: dw_i2c_bringup takes the
//       counts as arguments precisely so that path, when it lands, is a
//       different caller and not a different bring-up.
//
//   (b) COMPUTED FROM A KNOWN ic_clk. What this file implements. The
//       clock is an EXPLICIT ARGUMENT to bring-up, drawn from a closed
//       domain of the three shipped values, and validated
//       (dw_i2c_clk_valid). It is never a hidden constant: nothing in
//       this file defaults to 100 MHz.
//
//   (c) UNKNOWN. Refused. dw_i2c_bringup returns
//       LPSS_I2C_INIT_CLK_UNKNOWN and leaves the controller DISABLED.
//       It does not guess, and it does not fall back to (b) with an
//       assumed value.
//
// The reason (c) is a refusal and not a default is the failure mode. A
// wrong divider does not produce an error. It produces a bus that
// clocks at the wrong rate, which works perfectly against a fast device
// on a short trace at room temperature and fails against a slow device
// on a long trace on a cold boot. That is a bug that reproduces on the
// customer's desk and not on ours. A controller that refuses to come up
// is a bug that reproduces immediately.
//
// -----------------------------------------------------------------------------
// THE FORMULA
// -----------------------------------------------------------------------------
//
// Counts are computed from the specification's symbol times, in the
// form the DesignWare databook gives and the reference driver uses:
//
//   hcnt = (ic_clk_khz * (t_high_ns + t_fall_ns) + 500000) / 1000000 - 3
//   lcnt = (ic_clk_khz * (t_low_ns  + t_fall_ns) + 500000) / 1000000 - 1
//
// The +500000 before the divide is round-to-nearest, not a fudge: at
// 100 MHz one count is 10 ns, and truncating instead of rounding costs
// up to a full count, which at Fast-mode-plus is 4% of the high time.
//
// The -3 and -1 are the core's own internal pipeline: DesignWare adds
// three ic_clk periods to the programmed high count and one to the low
// count before driving the pin.
//
// t_fall_ns is the board's SCL/SDA fall time. It is zero here, because
// (a) above is where a real value would come from and (a) is deferred.
// Zero is the OPTIMISTIC direction — it makes SCL slightly faster than
// the true worst case — which is why the FALL-TIME ALLOWANCE is stated
// here rather than silently omitted: a board with heavy capacitance
// needs path (a).
//
// Specification symbol times (I²C-bus specification Rev. 7, Table 10):
//
//   rate          t_high      t_low
//   100 kHz       4000 ns     4700 ns
//   400 kHz        600 ns     1300 ns
//   1 MHz          260 ns      500 ns
//   3.4 MHz         60 ns      120 ns
//
// Worked values at ic_clk = 100 MHz (100000 kHz), t_fall = 0:
//
//   100 kHz   hcnt = 400500000/1000000 - 3 = 400 - 3 = 397
//             lcnt = 470500000/1000000 - 1 = 470 - 1 = 469
//   400 kHz   hcnt =  60500000/1000000 - 3 =  60 - 3 =  57
//             lcnt = 130500000/1000000 - 1 = 130 - 1 = 129
//   1 MHz     hcnt =  26500000/1000000 - 3 =  26 - 3 =  23
//             lcnt =  50500000/1000000 - 1 =  50 - 1 =  49
//   3.4 MHz   hcnt =   6500000/1000000 - 3 =   6 - 3 =   3
//             lcnt =  12500000/1000000 - 1 =  12 - 1 =  11
//
// The last row is the interesting one. DesignWare requires hcnt >= 6;
// 3 is below the minimum, and programming it produces a High-speed
// clock the core cannot actually generate. THAT is why
// dw_i2c_counts_valid exists and why bring-up refuses rather than
// clamping: clamping would produce a controller that reports success
// and runs at a rate nobody asked for.
//
// (High-speed mode is refused at bring-up for a second, independent
// reason — it requires a master-code preamble and arbitration sequence
// this milestone does not implement. Both refusals are distinct codes.)
//
// -----------------------------------------------------------------------------
// paideia-as posture
// -----------------------------------------------------------------------------
//
//   `imul r64, r64` and `div r64` are both proven encoder paths
//   (core/time/tsc.pdx L190/L192). The products here are tiny —
//   133000 * 4700 = 6.25e8 — so the 64-bit truncated product is exact.
//
//   Reserved-label discipline: labels prefixed `dwr_`.

module DwRegs = structure {

  // ==========================================================================
  // DesignWare register offsets (bytes from BAR0)
  // ==========================================================================

  pub let DW_IC_CON            : u64 = 0x00
  pub let DW_IC_TAR            : u64 = 0x04
  pub let DW_IC_SAR            : u64 = 0x08
  pub let DW_IC_DATA_CMD       : u64 = 0x10
  pub let DW_IC_SS_SCL_HCNT    : u64 = 0x14
  pub let DW_IC_SS_SCL_LCNT    : u64 = 0x18
  pub let DW_IC_FS_SCL_HCNT    : u64 = 0x1C
  pub let DW_IC_FS_SCL_LCNT    : u64 = 0x20
  pub let DW_IC_HS_SCL_HCNT    : u64 = 0x24
  pub let DW_IC_HS_SCL_LCNT    : u64 = 0x28
  pub let DW_IC_INTR_STAT      : u64 = 0x2C
  pub let DW_IC_INTR_MASK      : u64 = 0x30
  pub let DW_IC_RAW_INTR_STAT  : u64 = 0x34
  pub let DW_IC_RX_TL          : u64 = 0x38
  pub let DW_IC_TX_TL          : u64 = 0x3C
  pub let DW_IC_CLR_INTR       : u64 = 0x40
  pub let DW_IC_CLR_TX_ABRT    : u64 = 0x54
  pub let DW_IC_CLR_STOP_DET   : u64 = 0x60
  pub let DW_IC_ENABLE         : u64 = 0x6C
  pub let DW_IC_STATUS         : u64 = 0x70
  pub let DW_IC_TXFLR          : u64 = 0x74
  pub let DW_IC_RXFLR          : u64 = 0x78
  pub let DW_IC_SDA_HOLD       : u64 = 0x7C
  pub let DW_IC_TX_ABRT_SOURCE : u64 = 0x80
  pub let DW_IC_DMA_CR         : u64 = 0x88
  pub let DW_IC_ENABLE_STATUS  : u64 = 0x9C
  pub let DW_IC_FS_SPKLEN      : u64 = 0xA0
  pub let DW_IC_HS_SPKLEN      : u64 = 0xA4
  pub let DW_IC_COMP_PARAM_1   : u64 = 0xF4
  pub let DW_IC_COMP_VERSION   : u64 = 0xF8
  pub let DW_IC_COMP_TYPE      : u64 = 0xFC

  // The whole window this driver ever touches: the DesignWare bank
  // (0x000..0x0FF) plus the Intel private bank (0x200..0xA03). Rounded
  // to a page because the window capability is minted over memory.
  pub let DW_REG_WINDOW_BYTES  : u64 = 0x1000

  // ==========================================================================
  // Intel LPSS private space
  // ==========================================================================

  pub let LPSS_PRIV_BASE       : u64 = 0x200
  pub let LPSS_PRIV_RESETS     : u64 = 0x204
  pub let LPSS_RESETS_RELEASE  : u64 = 0x7      // iDMA[1:0] | FUNC[2]

  // ==========================================================================
  // IC_COMP_TYPE — the Synopsys signature
  // ==========================================================================
  //
  // Constant in every DW_apb_i2c instance regardless of synthesis
  // parameters, vendor wrapper or SoC generation. Reading this value
  // back from a window is proof that (a) the window really is mapped,
  // (b) the block is out of reset, and (c) the thing behind it is the
  // core whose register map the rest of this file describes.

  pub let DW_COMP_TYPE_MAGIC   : u64 = 0x44570140

  // ==========================================================================
  // IC_CON bits
  // ==========================================================================

  pub let DW_CON_MASTER_MODE   : u64 = 0x001    // bit 0
  pub let DW_CON_SPEED_STD     : u64 = 0x002    // bits [2:1] = 1
  pub let DW_CON_SPEED_FAST    : u64 = 0x004    // bits [2:1] = 2
  pub let DW_CON_SPEED_HIGH    : u64 = 0x006    // bits [2:1] = 3
  pub let DW_CON_SPEED_MASK    : u64 = 0x006
  pub let DW_CON_10BIT_SLAVE   : u64 = 0x008    // bit 3
  pub let DW_CON_10BIT_MASTER  : u64 = 0x010    // bit 4
  pub let DW_CON_RESTART_EN    : u64 = 0x020    // bit 5
  pub let DW_CON_SLAVE_DISABLE : u64 = 0x040    // bit 6

  // ==========================================================================
  // IC_TAR bits
  // ==========================================================================

  pub let DW_TAR_ADDR_MASK     : u64 = 0x3FF    // bits [9:0]
  pub let DW_TAR_10BIT_MASTER  : u64 = 0x1000   // bit 12

  // ==========================================================================
  // IC_DATA_CMD bits
  // ==========================================================================

  pub let DW_CMD_DATA_MASK     : u64 = 0x0FF    // bits [7:0]
  pub let DW_CMD_READ          : u64 = 0x100    // bit 8
  pub let DW_CMD_STOP          : u64 = 0x200    // bit 9
  pub let DW_CMD_RESTART       : u64 = 0x400    // bit 10

  // ==========================================================================
  // IC_ENABLE / IC_ENABLE_STATUS bits
  // ==========================================================================

  pub let DW_ENABLE_ENABLE     : u64 = 0x1      // bit 0
  pub let DW_ENABLE_ABORT      : u64 = 0x2      // bit 1
  pub let DW_ENABLE_TX_BLOCK   : u64 = 0x4      // bit 2
  pub let DW_ENABLE_STATUS_EN  : u64 = 0x1      // bit 0 of IC_ENABLE_STATUS

  // ==========================================================================
  // IC_STATUS bits
  // ==========================================================================

  pub let DW_STATUS_ACTIVITY   : u64 = 0x01     // bit 0
  pub let DW_STATUS_TFNF       : u64 = 0x02     // bit 1 — TX FIFO not full
  pub let DW_STATUS_TFE        : u64 = 0x04     // bit 2 — TX FIFO empty
  pub let DW_STATUS_RFNE       : u64 = 0x08     // bit 3 — RX FIFO not empty
  pub let DW_STATUS_RFF        : u64 = 0x10     // bit 4 — RX FIFO full
  pub let DW_STATUS_MST_ACT    : u64 = 0x20     // bit 5 — master active

  // ==========================================================================
  // IC_RAW_INTR_STAT bits
  // ==========================================================================

  pub let DW_INTR_RX_UNDER     : u64 = 0x0001
  pub let DW_INTR_RX_OVER      : u64 = 0x0002
  pub let DW_INTR_RX_FULL      : u64 = 0x0004
  pub let DW_INTR_TX_OVER      : u64 = 0x0008
  pub let DW_INTR_TX_EMPTY     : u64 = 0x0010
  pub let DW_INTR_TX_ABRT      : u64 = 0x0040   // bit 6 — THE NACK SIGNAL
  pub let DW_INTR_RX_DONE      : u64 = 0x0080
  pub let DW_INTR_ACTIVITY     : u64 = 0x0100
  pub let DW_INTR_STOP_DET     : u64 = 0x0200   // bit 9
  pub let DW_INTR_START_DET    : u64 = 0x0400

  // ==========================================================================
  // IC_TX_ABRT_SOURCE bits — WHY the transfer aborted
  // ==========================================================================
  //
  // The first four are the ordinary, expected outcomes of talking to a
  // bus you do not fully control. ARB_LOST is a multi-master fact.
  // USER_ABRT is our own IC_ENABLE.ABORT coming back to us, which is
  // how recovery confirms it worked.

  pub let DW_ABRT_7B_ADDR_NOACK  : u64 = 0x00001   // bit 0
  pub let DW_ABRT_10ADDR1_NOACK  : u64 = 0x00002   // bit 1
  pub let DW_ABRT_10ADDR2_NOACK  : u64 = 0x00004   // bit 2
  pub let DW_ABRT_TXDATA_NOACK   : u64 = 0x00008   // bit 3
  pub let DW_ABRT_GCALL_NOACK    : u64 = 0x00010   // bit 4
  pub let DW_ABRT_MASTER_DIS     : u64 = 0x00800   // bit 11
  pub let DW_ABRT_ARB_LOST       : u64 = 0x01000   // bit 12
  pub let DW_ABRT_USER_ABRT      : u64 = 0x10000   // bit 16

  // Any address NACK, in either addressing mode.
  pub let DW_ABRT_ADDR_NOACK_ANY : u64 = 0x00007

  // ==========================================================================
  // Core limits
  // ==========================================================================
  //
  // HCNT_MIN / LCNT_MIN are the DesignWare databook minima. They are
  // not advisory: below them the core cannot meet its own internal
  // setup requirements and the generated clock is not the programmed
  // one. HCNT_MAX / LCNT_MAX are the register widths.

  pub let DW_HCNT_MIN          : u64 = 6
  pub let DW_LCNT_MIN          : u64 = 8
  pub let DW_CNT_MAX           : u64 = 0xFFFF

  // FIFO depth on every Intel LPSS instance shipped to date. Used only
  // as the TX burst bound; the transfer engine re-reads IC_STATUS.TFNF
  // before every push, so an instance with a shallower FIFO is correct,
  // merely slower.
  pub let DW_FIFO_DEPTH        : u64 = 64

  pub let DW_TX_TL_DEFAULT     : u64 = 0
  pub let DW_RX_TL_DEFAULT     : u64 = 0

  // Spike-suppression lengths. 1 is the reset value and the value the
  // count formula above assumes (the databook's -3 term already folds
  // in a SPKLEN of 1).
  pub let DW_SPKLEN_DEFAULT    : u64 = 1

  // ==========================================================================
  // ic_clk — the closed domain
  // ==========================================================================

  pub let DW_CLK_100MHZ        : u64 = 100000000
  pub let DW_CLK_120MHZ        : u64 = 120000000
  pub let DW_CLK_133MHZ        : u64 = 133000000

  // ==========================================================================
  // I²C specification symbol times, nanoseconds
  // ==========================================================================

  pub let I2C_T_HIGH_STD       : u64 = 4000
  pub let I2C_T_LOW_STD        : u64 = 4700
  pub let I2C_T_HIGH_FAST      : u64 = 600
  pub let I2C_T_LOW_FAST       : u64 = 1300
  pub let I2C_T_HIGH_FASTPLUS  : u64 = 260
  pub let I2C_T_LOW_FASTPLUS   : u64 = 500
  pub let I2C_T_HIGH_HIGHSPEED : u64 = 60
  pub let I2C_T_LOW_HIGHSPEED  : u64 = 120

  // Board fall-time allowance, nanoseconds. Zero, and named, per the
  // header: a non-zero value belongs to the board and reaches us only
  // through provenance path (a).
  pub let I2C_T_FALL_DEFAULT   : u64 = 0

  pub let DW_COUNT_BAD         : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // dw_i2c_clk_valid(clk_hz) -> 1 | 0
  // ==========================================================================

  pub let dw_i2c_clk_valid : (u64) -> u64 !{} @{} =
    fn (clk_hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-003 (#1072): 1 iff clk_hz is one of the three ic_clk frequencies Intel has shipped on LPSS I2C (100/120/133 MHz). A CLOSED DOMAIN, for the same reason i2c_bus_speed_valid closes the rate domain one level up: the clock is a divisor, an unvalidated divisor is an unvalidated divider, and a wrong divider does not refuse -- it produces out-of-spec bus timing that passes on a warm bench and fails on a cold boot. Adding a fourth frequency is a one-line change here plus a documented worked example, which is the correct amount of friction for a claim about silicon nobody in this repository can measure. Written as an explicit compare chain, not a range, because the set is genuinely three points and a range would admit values between them that no part uses. Pure leaf. Reserved labels: dwr_cv_.",
      block: {
        mov rax, 100000000;
        cmp rdi, rax;
        je  dwr_cv_yes;
        mov rax, 120000000;
        cmp rdi, rax;
        je  dwr_cv_yes;
        mov rax, 133000000;
        cmp rdi, rax;
        je  dwr_cv_yes;
        xor rax, rax;
        ret;
      dwr_cv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // dw_i2c_scl_hcnt(ic_clk_khz, t_high_ns, t_fall_ns) -> count
  //
  //   hcnt = (ic_clk_khz * (t_high_ns + t_fall_ns) + 500000) / 1000000 - 3
  // ==========================================================================

  pub let dw_i2c_scl_hcnt : (u64, u64, u64) -> u64 !{} @{} =
    fn (ic_clk_khz: u64, t_high_ns: u64, t_fall_ns: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-003 (#1072): SCL high count in ic_clk periods. Body: t = t_high_ns + t_fall_ns; p = ic_clk_khz * t (64-bit truncated product via imul r64,r64 -- exact here, the largest product this driver ever forms is 133000 * 4700 = 6.25e8); p += 500000 (round to nearest, NOT a fudge: at 100 MHz one count is 10 ns and truncation costs up to a full count, which is 4% of the Fast-mode-plus high time); q = p / 1000000 via xor rdx,rdx + div r64 -- rdx MUST be zeroed first, an unzeroed rdx makes div a 128/64 divide and faults or returns nonsense; result = q - 3, the core's own three-ic_clk internal pipeline on the high phase. UNDERFLOW IS RETURNED AS DW_COUNT_BAD rather than wrapping: q < 3 means the requested high time is under three clock periods, and a wrapped 2^64-ish count programmed into a 16-bit register would silently truncate to a plausible-looking value. The caller that matters (dw_i2c_counts_valid) would catch the wrap too, but a function that can return a wrong number for a wrong input is a function whose test cannot distinguish the two. Pure leaf; div clobbers rdx which is caller-save. Reserved labels: dwr_hc_.",
      block: {
        mov rax, rsi;
        add rax, rdx;                    // t_high + t_fall
        imul rax, rdi;                   // * ic_clk_khz
        mov r10, 500000;
        add rax, r10;
        xor rdx, rdx;
        mov r10, 1000000;
        div r10;                         // rax = quotient
        cmp rax, 3;
        jb  dwr_hc_bad;
        sub rax, 3;
        ret;
      dwr_hc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // dw_i2c_scl_lcnt(ic_clk_khz, t_low_ns, t_fall_ns) -> count
  //
  //   lcnt = (ic_clk_khz * (t_low_ns + t_fall_ns) + 500000) / 1000000 - 1
  // ==========================================================================

  pub let dw_i2c_scl_lcnt : (u64, u64, u64) -> u64 !{} @{} =
    fn (ic_clk_khz: u64, t_low_ns: u64, t_fall_ns: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-003 (#1072): SCL low count in ic_clk periods. Identical shape to dw_i2c_scl_hcnt with the core's one-period low-phase pipeline instead of three. The two are separate functions rather than one with an offset parameter because the offsets are not a caller's choice -- they are facts about the silicon -- and a parameter would invite a caller to supply a different one. Underflow returns DW_COUNT_BAD. Pure leaf. Reserved labels: dwr_lc_.",
      block: {
        mov rax, rsi;
        add rax, rdx;
        imul rax, rdi;
        mov r10, 500000;
        add rax, r10;
        xor rdx, rdx;
        mov r10, 1000000;
        div r10;
        cmp rax, 1;
        jb  dwr_lc_bad;
        sub rax, 1;
        ret;
      dwr_lc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // dw_i2c_t_high(speed_hz) -> ns | DW_COUNT_BAD
  // dw_i2c_t_low(speed_hz)  -> ns | DW_COUNT_BAD
  //
  // The specification table, as two total functions over the four rates
  // KIND_I2C_BUS already validated at mint.
  // ==========================================================================

  pub let dw_i2c_t_high : (u64) -> u64 !{} @{} =
    fn (speed_hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-003 (#1072): I2C specification t_HIGH for one of the four rates, in nanoseconds. Domain is exactly the four rates kind_i2c_bus.pdx admits, so this is total on every value that can reach it through a bus capability; DW_COUNT_BAD on anything else keeps it total on the values that cannot. Pure leaf. Reserved labels: dwr_th_.",
      block: {
        mov r10, 100000;
        cmp rdi, r10;
        je  dwr_th_std;
        mov r10, 400000;
        cmp rdi, r10;
        je  dwr_th_fast;
        mov r10, 1000000;
        cmp rdi, r10;
        je  dwr_th_fplus;
        mov r10, 3400000;
        cmp rdi, r10;
        je  dwr_th_high;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      dwr_th_std:
        mov rax, 4000;
        ret;
      dwr_th_fast:
        mov rax, 600;
        ret;
      dwr_th_fplus:
        mov rax, 260;
        ret;
      dwr_th_high:
        mov rax, 60;
        ret
      }
    }

  pub let dw_i2c_t_low : (u64) -> u64 !{} @{} =
    fn (speed_hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-003 (#1072): I2C specification t_LOW for one of the four rates, in nanoseconds. Companion to dw_i2c_t_high; see that function. Pure leaf. Reserved labels: dwr_tl_.",
      block: {
        mov r10, 100000;
        cmp rdi, r10;
        je  dwr_tl_std;
        mov r10, 400000;
        cmp rdi, r10;
        je  dwr_tl_fast;
        mov r10, 1000000;
        cmp rdi, r10;
        je  dwr_tl_fplus;
        mov r10, 3400000;
        cmp rdi, r10;
        je  dwr_tl_high;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      dwr_tl_std:
        mov rax, 4700;
        ret;
      dwr_tl_fast:
        mov rax, 1300;
        ret;
      dwr_tl_fplus:
        mov rax, 500;
        ret;
      dwr_tl_high:
        mov rax, 120;
        ret
      }
    }

  // ==========================================================================
  // dw_i2c_counts_valid(hcnt, lcnt) -> 1 | 0
  // ==========================================================================

  pub let dw_i2c_counts_valid : (u64, u64) -> u64 !{} @{} =
    fn (hcnt: u64, lcnt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-003 (#1072): 1 iff both counts are inside the DesignWare databook's usable range -- hcnt in [6, 65535], lcnt in [8, 65535]. This is the guard that turns 'High-speed mode at a 100 MHz ic_clk' from a silently wrong divider into a refusal: its computed hcnt is 3, below the core's minimum, and a core programmed with 3 does not generate a 3.4 MHz clock, it generates something else and reports nothing. The upper bound is the register width; a count above it truncates on the way in, which is the same class of silent wrongness at the other end. DW_COUNT_BAD from the count functions fails the upper bound and is therefore caught here too, which is why this check comes before any register write and not after. Pure leaf. Reserved labels: dwr_ok_.",
      block: {
        cmp rdi, 6;
        jb  dwr_ok_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  dwr_ok_no;
        cmp rsi, 8;
        jb  dwr_ok_no;
        cmp rsi, r10;
        ja  dwr_ok_no;
        mov rax, 1;
        ret;
      dwr_ok_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dw_i2c_con_for_speed(speed_hz, ten_bit) -> IC_CON value | DW_COUNT_BAD
  // ==========================================================================

  pub let dw_i2c_con_for_speed : (u64, u64) -> u64 !{} @{} =
    fn (speed_hz: u64, ten_bit: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M5-003 (#1072): the IC_CON word for a rate. Always MASTER_MODE | RESTART_EN | SLAVE_DISABLE, plus the two-bit speed field, plus 10BIT_MASTER when the capability's addressing mode says so. RESTART_EN is not optional and not a tuning knob: without it the core cannot emit a repeated START, and the combined write-then-read that #1073 builds -- which is how essentially every I2C register read on this machine works -- would degrade into STOP followed by START, releasing the bus between the two halves and letting another master interleave. SLAVE_DISABLE is set because a controller that also answers as a slave can be addressed by a peer master, which on a bus whose isolation story is per-device capabilities would be an authority nobody minted. Fast-plus (1 MHz) uses the FAST speed encoding and the FS count registers -- the core has no separate Fast-plus field, only faster counts. Pure leaf. Reserved labels: dwr_cs_.",
      block: {
        mov r11, 0x61;                   // MASTER_MODE | RESTART_EN | SLAVE_DISABLE
        cmp rsi, 0;
        je  dwr_cs_speed;
        or  r11, 0x10;                   // 10BIT_MASTER
      dwr_cs_speed:
        mov r10, 100000;
        cmp rdi, r10;
        je  dwr_cs_std;
        mov r10, 400000;
        cmp rdi, r10;
        je  dwr_cs_fast;
        mov r10, 1000000;
        cmp rdi, r10;
        je  dwr_cs_fast;
        mov r10, 3400000;
        cmp rdi, r10;
        je  dwr_cs_high;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      dwr_cs_std:
        mov rax, r11;
        or  rax, 0x2;
        ret;
      dwr_cs_fast:
        mov rax, r11;
        or  rax, 0x4;
        ret;
      dwr_cs_high:
        mov rax, r11;
        or  rax, 0x6;
        ret
      }
    }
}
