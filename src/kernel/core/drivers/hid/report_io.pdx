// src/kernel/core/drivers/hid/report_io.pdx — R32.M2-005 (#1124)
//
// HID-over-I²C GET_REPORT + SET_REPORT command dispatch. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE COMMAND-LEVEL FEATURE/OUTPUT REPORT ROUND-TRIP for a HID
// device behind the I²C-HID transport. In Microsoft's HID-over-I²C v1.0
// §7.2:
//
//   GET_REPORT (opcode 0x02) -- host fetches the current value of a
//                               named report (feature, input or output)
//                               from the device. The host writes a
//                               command frame to wCommandRegister
//                               naming the report type and id, then
//                               reads the payload from wDataRegister.
//
//   SET_REPORT (opcode 0x03) -- host writes a new value into a named
//                               report on the device (feature or
//                               output). Same command frame shape,
//                               opposite direction on wDataRegister.
//
// The command frame packs the report type (2 bits, one of INPUT=0x01 /
// OUTPUT=0x02 / FEATURE=0x03) into the high nibble and the report id
// (4 bits) into the low nibble of the first payload byte, followed by
// the opcode byte. This module composes those bytes and dispatches
// against wCommandRegister via the transport write seam.
//
// IT IS NOT A LIVE COMMAND. Same discipline as reset_wake.pdx §0 and
// transport.pdx §4: the write seam returns DEFERRED_HARDWARE, this
// module propagates that sentinel, and the pin
// `hid_report_get_arbitrated() == 0` / `hid_report_set_arbitrated() == 0`
// -- assertions that FAIL the moment a future milestone plumbs a real
// DesignWare transfer through this transport -- force the design doc
// to be updated at that time.
//
// IT USES THE TRANSPORT WRITE SEAM AT ITS DECLARED ARITY. The transport
// carries {reg_index, byte}, matching the SET_REPORT byte-poke shape.
// Widening the seam to accept a multi-byte payload would let a caller
// reach bytes no capability named, exactly what §2 of ec_access.pdx
// exists to prevent. This scaffold therefore issues the OPCODE byte at
// wCommandRegister; the full three-byte command frame (report-type/id
// prefix + opcode + optional data-register redirect) is composed by the
// live DesignWare transfer helper R32.M3 will land alongside the class
// driver.
//
// GET_REPORT'S READ HALF likewise uses the transport read seam at its
// declared arity: hid_report_get() dispatches the command WRITE, then
// dispatches the payload READ against wDataRegister with want_len == 1.
// A live driver reads the enumerated report length; the scaffold pins
// the minimum-valid want_len (1) so the read seam's own gates (see
// transport.pdx §4) still fire and the propagated DEFERRED_HARDWARE
// carries the honest "no transfer ran" meaning.
//
// =============================================================================
// §1  ONE WRITER OF THE COMPLETION LATCHES
// =============================================================================
//
// Same discipline as reset_wake.pdx §1: exactly one writer of
// _hid_report_get_stats (this module's GET seam) and one writer of
// _hid_report_set_stats (this module's SET seam). tools/build.sh
// confines both to this object. A stray writer would be a second path
// counting a round-trip that never issued.
//
// =============================================================================
// §2  REFUSE, NEVER CLAMP
// =============================================================================
//
// GET_REPORT / SET_REPORT report_type outside {INPUT=1, OUTPUT=2,
// FEATURE=3} -> BAD_TYPE (refused, not coerced). A GET on an OUTPUT
// report is spec-legal but rarely useful; this scaffold accepts all
// three and lets the device refuse.
//
// report_id outside 0..15 -> BAD_ID (refused, not truncated). HID
// report ids fit 4 bits by construction (HID 1.11 §6.2.2.7); the
// truncation would silently reroute a request.
//
// SET_REPORT byte outside 0..255 -> propagated from the transport's
// own BAD_LEN gate (transport.pdx §3). The scaffold trusts the
// transport's refusal rather than duplicating it.
//
// Any dispatch before transport bind -> propagates NOT_BOUND from the
// transport write/read seam.
//
// =============================================================================
// §3  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO MULTI-BYTE PAYLOAD. §0 explains why -- the transport seam is
//     arity 2 today. A live class driver will widen the composition
//     path (not the transport seam) alongside R32.M3.
//
//   * NO wDataRegister REDIRECT. The spec's report-length prefix and
//     the data-register indirection both live on the wire portion of
//     the transfer; neither is composed at this level yet.
//
//   * NO POST-DISPATCH WAIT FOR IRQ ASSERTION. GET_REPORT on an input
//     report needs the device to pull IRQ before the read fires;
//     isr.pdx §3 has no live IRQ subscription yet.
//
//   * NO ARBITRATION. Same shape as reset_wake.pdx §0.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFC30..0xFFFFFC3F
// =============================================================================

module ReportIo = structure {

  // ==========================================================================
  // §4 return codes -- but the module PROPAGATES the transport's return
  // whenever it dispatches, so a happy-path caller sees DEFERRED_HARDWARE
  // (0xFFFFFEBC), a not-yet-bound transport surfaces NOT_BOUND
  // (0xFFFFFEBF), etc. The codes below are for gates this module ITSELF
  // decides (report_type, report_id).
  // ==========================================================================

  pub let HID_RI_OK       : u64 = 0
  pub let HID_RI_BAD_TYPE : u64 = 0xFFFFFC30
  pub let HID_RI_BAD_ID   : u64 = 0xFFFFFC31

  // ==========================================================================
  // Spec constants -- HID-over-I²C v1.0 §7.2 report I/O.
  //
  // wCommandRegister and wDataRegister indices match reset_wake.pdx's
  // choice of 0x0000 for the command register; the data register is
  // pinned to 0x0002 in this scaffold per the task specification. A
  // live driver would derive both from the parsed HID descriptor's
  // wCommandRegister and wDataRegister fields.
  // ==========================================================================

  pub let HID_RI_CMD_REG           : u64 = 0x0000
  pub let HID_RI_DATA_REG          : u64 = 0x0002
  pub let HID_RI_OPCODE_GET_REPORT : u64 = 0x02
  pub let HID_RI_OPCODE_SET_REPORT : u64 = 0x03

  pub let HID_RI_TYPE_INPUT   : u64 = 0x01
  pub let HID_RI_TYPE_OUTPUT  : u64 = 0x02
  pub let HID_RI_TYPE_FEATURE : u64 = 0x03

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // Two disjoint stats arrays -- one per seam -- so a GET that never
  // ran cannot be counted by the SET seam, and vice versa.
  // ==========================================================================

  pub let mut _hid_report_get_stats : [u64; 4] = uninit @align(64)
  pub let mut _hid_report_set_stats : [u64; 4] = uninit @align(64)

  pub let HID_RI_ST_CALLS    : u64 = 0
  pub let HID_RI_ST_REFUSED  : u64 = 1
  pub let HID_RI_ST_DEFERRED : u64 = 2
  pub let HID_RI_ST_MAX      : u64 = 4

  // ==========================================================================
  // hid_report_get_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as reset_wake.pdx §0: pinned at
  // 0 by the boot witness so a future milestone plumbing a real
  // DesignWare transfer cannot land without rewriting the claim.
  // ==========================================================================

  pub let hid_report_get_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M2-005 (#1124): report whether the GET_REPORT seam issues a real command today. IT RETURNS 0, because nothing in this tree wires the transport to dw_xfer.pdx. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_report_set_arbitrated() -> 0
  // ==========================================================================

  pub let hid_report_set_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M2-005 (#1124): report whether the SET_REPORT seam issues a real command today. IT RETURNS 0, same reason as hid_report_get_arbitrated. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_report_get(report_type, report_id) -> code
  //
  // Composes the GET_REPORT command frame: writes the OPCODE byte to
  // wCommandRegister (via the transport write seam), then dispatches a
  // one-byte READ from wDataRegister (via the transport read seam). The
  // return propagates: if the write refused (BAD_REG / BAD_LEN /
  // NOT_BOUND), the read is not attempted and the write's error is
  // returned; if the write returned DEFERRED_HARDWARE, the read runs
  // and its own return is propagated (which will also be
  // DEFERRED_HARDWARE on the happy path).
  //
  // Counts CALLS in stats[0] on every entry. Counts REFUSED in stats[1]
  // when this module's own gates (BAD_TYPE / BAD_ID) fire. Counts
  // DEFERRED in stats[2] on the happy path (both nested calls returned
  // DEFERRED_HARDWARE).
  //
  // Register plan: two nested calls, both to arity-2 transport seams,
  // so we need to preserve report_type / report_id across the first
  // call (bounds-check them before, then only use the register values
  // to dispatch). rbx used as the saved report_type for optional
  // sanity around the read; three-push prologue keeps rsp%16 == 0 at
  // both call sites (entry rsp%16 == 8, +3 pushes -> rsp%16 == 0, and
  // the callees are no-frame + do not perturb it).
  // ==========================================================================

  pub let hid_report_get : (u64, u64) -> u64 !{mem} @{} =
    fn (report_type: u64, report_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-005 (#1124): dispatch the HID-over-I²C GET_REPORT round-trip. Gates, in order: (1) report_type in {INPUT=1, OUTPUT=2, FEATURE=3} else BAD_TYPE (refused, not coerced -- an OUT-of-set value is not a HID report type). (2) report_id in 0..15 else BAD_ID (refused, not truncated -- HID 1.11 §6.2.2.7 fits report id in 4 bits by construction). (3) Count CALLS. (4) transport_write(wCommandRegister, OPCODE_GET_REPORT). Propagate its return unchanged if not DEFERRED_HARDWARE. (5) transport_read(wDataRegister, want_len=1). Propagate its return; count DEFERRED if it succeeded. NO REAL I²C TRANSFER RUNS: both transport seams are scaffolds (transport.pdx §4). Five-push prologue keeps rsp%16 == 0 across both nested calls. Reserved labels: prefixed hid_ri_g_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) report_type in {1, 2, 3}.
        cmp rdi, 1;
        jb  hid_ri_g_bad_type;
        cmp rdi, 3;
        ja  hid_ri_g_bad_type;

        // (2) report_id in 0..15.
        cmp rsi, 15;
        ja  hid_ri_g_bad_id;

        // (3) count CALLS.
        lea r10, [rip + _hid_report_get_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        // (4) transport_write(wCommandRegister, OPCODE_GET_REPORT).
        //     The composition of {report_type, report_id} into the
        //     command payload lives on the DesignWare transfer helper
        //     R32.M3 will land; today the opcode alone reaches the
        //     command register.
        mov rdi, 0x0000;                  // HID_RI_CMD_REG
        mov rsi, 0x02;                    // HID_RI_OPCODE_GET_REPORT
        call i2c_hid_transport_write;

        // Propagate write error unchanged (BAD_REG, BAD_LEN, NOT_BOUND).
        mov r10, 0xFFFFFEBC;              // DEFERRED_HARDWARE
        cmp rax, r10;
        jne hid_ri_g_out;

        // (5) transport_read(wDataRegister, want_len=1).
        mov rdi, 0x0002;                  // HID_RI_DATA_REG
        mov rsi, 1;                       // minimum-valid want_len
        call i2c_hid_transport_read;

        // If the read propagates DEFERRED_HARDWARE, count DEFERRED.
        mov r10, 0xFFFFFEBC;
        cmp rax, r10;
        jne hid_ri_g_out;

        lea r10, [rip + _hid_report_get_stats];
        mov r11, [r10 + 16];              // slot 2 = DEFERRED
        add r11, 1;
        mov [r10 + 16], r11;

        mov rax, 0xFFFFFEBC;              // return DEFERRED_HARDWARE
        jmp hid_ri_g_out;

      hid_ri_g_bad_type:
        lea r10, [rip + _hid_report_get_stats];
        mov rax, [r10 + 8];               // slot 1 = REFUSED
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFC30;              // BAD_TYPE
        jmp hid_ri_g_out;

      hid_ri_g_bad_id:
        lea r10, [rip + _hid_report_get_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFC31;              // BAD_ID

      hid_ri_g_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_report_set(report_type, report_id, byte) -> code
  //
  // Composes the SET_REPORT command: writes the OPCODE byte to
  // wCommandRegister (transport write seam), then writes the payload
  // byte to wDataRegister (transport write seam). Same propagation and
  // counter shape as hid_report_get.
  //
  // Payload byte outside 0..255 is refused by the transport's own
  // BAD_LEN gate; §2 documents that this module trusts that refusal
  // rather than duplicating it.
  // ==========================================================================

  pub let hid_report_set : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (report_type: u64, report_id: u64, byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-005 (#1124): dispatch the HID-over-I²C SET_REPORT round-trip. Same gate order as hid_report_get: (1) report_type in {1, 2, 3}, (2) report_id in 0..15. (3) Count CALLS. (4) transport_write(wCommandRegister, OPCODE_SET_REPORT). Propagate write error unchanged. (5) transport_write(wDataRegister, byte). Propagate its return; count DEFERRED on success. NO REAL I²C TRANSFER RUNS. rbx saves the payload byte across the first nested call. Five-push prologue keeps rsp%16 == 0 across both nested calls. Reserved labels: prefixed hid_ri_s_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Save the payload byte in rbx across the two nested calls.
        mov rbx, rdx;

        // (1) report_type in {1, 2, 3}.
        cmp rdi, 1;
        jb  hid_ri_s_bad_type;
        cmp rdi, 3;
        ja  hid_ri_s_bad_type;

        // (2) report_id in 0..15.
        cmp rsi, 15;
        ja  hid_ri_s_bad_id;

        // (3) count CALLS.
        lea r10, [rip + _hid_report_set_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        // (4) transport_write(wCommandRegister, OPCODE_SET_REPORT).
        mov rdi, 0x0000;                  // HID_RI_CMD_REG
        mov rsi, 0x03;                    // HID_RI_OPCODE_SET_REPORT
        call i2c_hid_transport_write;

        mov r10, 0xFFFFFEBC;              // DEFERRED_HARDWARE
        cmp rax, r10;
        jne hid_ri_s_out;

        // (5) transport_write(wDataRegister, byte).
        //     The payload byte is BOUNDED BY THE TRANSPORT'S OWN
        //     BAD_LEN gate (transport.pdx §3): a byte outside 0..255
        //     is refused there. We do not duplicate that gate here.
        mov rdi, 0x0002;                  // HID_RI_DATA_REG
        mov rsi, rbx;                     // payload byte
        call i2c_hid_transport_write;

        mov r10, 0xFFFFFEBC;
        cmp rax, r10;
        jne hid_ri_s_out;

        lea r10, [rip + _hid_report_set_stats];
        mov r11, [r10 + 16];              // slot 2 = DEFERRED
        add r11, 1;
        mov [r10 + 16], r11;

        mov rax, 0xFFFFFEBC;
        jmp hid_ri_s_out;

      hid_ri_s_bad_type:
        lea r10, [rip + _hid_report_set_stats];
        mov rax, [r10 + 8];               // slot 1 = REFUSED
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFC30;              // BAD_TYPE
        jmp hid_ri_s_out;

      hid_ri_s_bad_id:
        lea r10, [rip + _hid_report_set_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFC31;              // BAD_ID

      hid_ri_s_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_report_get_count() -> count
  // hid_report_set_count() -> count
  //
  // Read-only CALLS accessors used by the witness to prove the seams
  // counted. The REFUSED / DEFERRED counts are exposed via
  // hid_report_get_deferred / hid_report_set_deferred for the witness
  // to distinguish a happy-path count from a refusal count.
  // ==========================================================================

  pub let hid_report_get_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-005 (#1124): count of hid_report_get invocations (slot 0). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_report_get_stats];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hid_report_set_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-005 (#1124): count of hid_report_set invocations (slot 0). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_report_set_stats];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hid_report_get_deferred : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-005 (#1124): count of hid_report_get round-trips that reached DEFERRED_HARDWARE (slot 2). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_report_get_stats];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let hid_report_set_deferred : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-005 (#1124): count of hid_report_set round-trips that reached DEFERRED_HARDWARE (slot 2). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_report_set_stats];
        mov rax, [r10 + 16];
        ret
      }
    }
}
