// src/kernel/core/drivers/hid/usage.pdx — R32.M2-002 (#1121)
//
// HID usage-page + usage-id enumeration table. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE (usage_page, usage_id) -> KIND CLASSIFIER that the HID class
// driver in R32.M3 will consult when it needs to decide what a raw HID
// field IS, once report_parser.pdx has stored the (page, id) pair in the
// parsed schema. The pages covered here are the four the T14 G4 stack
// actually touches:
//
//   0x01  Generic Desktop -- pointers, keyboards, mice, joysticks, X/Y/Z/wheel
//   0x07  Keyboard/Keypad -- USB HID keyboard usage IDs
//   0x09  Button          -- generic 1..N button set (mouse buttons live here)
//   0x0C  Consumer        -- media keys, volume, brightness (hot-key surface)
//
// These are the pages the parser output for a touchpad, a trackpoint, a
// consumer-control hot-key set and a keyboard reduces to. Any other page
// number reads back as UNKNOWN, and a caller that treats UNKNOWN as
// "route it anyway" has misread the contract: the whole point of the
// classifier is that a page nobody vetted has no interpretation.
//
// IT IS NOT A LIVE DECISION POINT. Same discipline as quirks.pdx §0 and
// transport.pdx §4: no bring-up sequence exists in this milestone that
// keys off the returned kind. The pin `hid_usage_consumed() == 0` --
// an assertion that FAILS the moment the R32.M3 class driver calls the
// classifier for real -- forces the design doc to be updated at that
// time. The report parser (R32.M2-001) does NOT call this classifier;
// it stores raw (page, id) pairs in the schema and leaves interpretation
// to a later stage.
//
// =============================================================================
// §1  MATCH KEY: PACKED (page << 16 | id)
// =============================================================================
//
// The classifier takes (page, id) as two arguments AT THE SEAM but packs
// them into a single 32-bit key for the linear scan. The two-argument
// shape is load-bearing: a caller that passed one packed key would have
// to have already packed it, which is the packing step this module
// exists to own. The internal packing is (page << 16 | id), the same
// shape the report parser will store per-field and the same shape the
// quirk table uses for (vendor, product).
//
// PAGE-WILDCARD ENTRIES. A table entry with id = 0x0000 matches EVERY id
// on that page and returns the page's default kind (POINTER for Generic
// Desktop, KEY for Keyboard, BUTTON for Button, CONSUMER_CTL for
// Consumer). A specific-id entry always wins over the page's wildcard:
// specific rows are scanned first, wildcards on miss. This lets the
// classifier answer "what family does this field belong to" for an id
// the table does not spell out, without hiding a spec-defined id that
// the table DOES spell out behind a broader category.
//
// =============================================================================
// §2  ONE WRITER OF THE TABLE
// =============================================================================
//
// Same discipline as quirks.pdx §2: the table is COMPILE-TIME CONSTANT
// in .rodata, its length lives beside it, and there is no runtime
// mutator. tools/build.sh confines `_hid_usage_table`, `_hid_usage_count`
// and `_hid_usage_consumers` to this object. A stray writer would be a
// second path installing a usage classification the review never looked
// at, and a downstream router keyed off the result would send a report
// somewhere no capability named.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Unknown (page, id) -> returns HID_USAGE_KIND_UNKNOWN (0). A caller
// that reads 0 as "route it anyway" has misread the contract: 0 means
// "this field has no vetted interpretation", and the correct downstream
// action is to drop the field rather than guess.
//
// Unknown page -> hid_usage_page_known returns 0. The same information
// is exposed as its own gate because a parser that wants to REFUSE a
// whole descriptor whose usage page it does not know can ask the cheap
// question without paying the two-pass scan.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFEA0..0xFFFFFEAF -- reserved, not used yet
// =============================================================================

module Usage = structure {

  // ==========================================================================
  // §4 page-id constants (task specification).
  // ==========================================================================

  pub let HID_USAGE_PAGE_UNKNOWN         : u64 = 0x0000
  pub let HID_USAGE_PAGE_GENERIC_DESKTOP : u64 = 0x0001
  pub let HID_USAGE_PAGE_KEYBOARD        : u64 = 0x0007
  pub let HID_USAGE_PAGE_BUTTON          : u64 = 0x0009
  pub let HID_USAGE_PAGE_CONSUMER        : u64 = 0x000C

  // ==========================================================================
  // Kind classification -- what family does the (page, id) belong to.
  // ==========================================================================

  pub let HID_USAGE_KIND_UNKNOWN      : u64 = 0
  pub let HID_USAGE_KIND_POINTER      : u64 = 1
  pub let HID_USAGE_KIND_MOUSE        : u64 = 2
  pub let HID_USAGE_KIND_KEYBOARD     : u64 = 3
  pub let HID_USAGE_KIND_KEYPAD       : u64 = 4
  pub let HID_USAGE_KIND_JOYSTICK     : u64 = 5
  pub let HID_USAGE_KIND_X_AXIS       : u64 = 6
  pub let HID_USAGE_KIND_Y_AXIS       : u64 = 7
  pub let HID_USAGE_KIND_Z_AXIS       : u64 = 8
  pub let HID_USAGE_KIND_WHEEL        : u64 = 9
  pub let HID_USAGE_KIND_BUTTON       : u64 = 10
  pub let HID_USAGE_KIND_CONSUMER_CTL : u64 = 11
  pub let HID_USAGE_KIND_KEY          : u64 = 12

  // ==========================================================================
  // §1 the table.
  //
  // Row layout is TWO u64 per entry: {packed_key = (page<<16|id), kind}.
  // Stride 16 bytes. id == 0 in a key means "wildcard for this page" (§1).
  // Rows ordered SPECIFIC-FIRST, WILDCARDS-LAST: the two-pass scan below
  // walks specifics on pass 1 (returning on the first specific hit) and
  // wildcards on pass 2 (returning on the first wildcard hit); a wildcard
  // that shadowed a later specific would silently misclassify a spec-defined
  // id.
  //
  // Generic Desktop specifics enumerated from HID Usage Tables 1.12 §4:
  //   0x01 Pointer, 0x02 Mouse, 0x04 Joystick, 0x06 Keyboard, 0x07 Keypad,
  //   0x30 X, 0x31 Y, 0x32 Z, 0x38 Wheel.
  //
  // The Keyboard/Keypad, Button and Consumer pages have hundreds of ids
  // each; the scaffold enumerates ONE specific per page (as a plausibility
  // pin) and relies on the wildcard row for the rest. #1121 sizes the
  // table to what the parser exercises and the class driver will consume;
  // future issues extend it as consumers land.
  // ==========================================================================

  pub let _hid_usage_table : [u64; 30] = [
    // ---- Generic Desktop specifics (page = 0x01) --------------------------
    0x00010001u64,  1u64,                     // Pointer          -> POINTER
    0x00010002u64,  2u64,                     // Mouse            -> MOUSE
    0x00010004u64,  5u64,                     // Joystick         -> JOYSTICK
    0x00010006u64,  3u64,                     // Keyboard         -> KEYBOARD
    0x00010007u64,  4u64,                     // Keypad           -> KEYPAD
    0x00010030u64,  6u64,                     // X                -> X_AXIS
    0x00010031u64,  7u64,                     // Y                -> Y_AXIS
    0x00010032u64,  8u64,                     // Z                -> Z_AXIS
    0x00010038u64,  9u64,                     // Wheel            -> WHEEL
    // ---- Keyboard specifics (page = 0x07) ---------------------------------
    0x00070029u64, 12u64,                     // Keyboard Escape  -> KEY
    // ---- Consumer specifics (page = 0x0C) ---------------------------------
    0x000C00E9u64, 11u64,                     // Volume Increment -> CONSUMER_CTL
    // ---- Page wildcards (id = 0) ------------------------------------------
    0x00010000u64,  1u64,                     // Generic Desktop  -> POINTER
    0x00070000u64, 12u64,                     // Keyboard/Keypad  -> KEY
    0x00090000u64, 10u64,                     // Button           -> BUTTON
    0x000C0000u64, 11u64                      // Consumer         -> CONSUMER_CTL
  ]

  pub let _hid_usage_count : u64 = 15

  // The wildcard rows begin at index 11; pass 1 scans [0, 11) and pass 2
  // scans [11, 15). Kept explicit rather than derived because a mis-count
  // would either miss a specific (pass 1 too short) or shadow a specific
  // with its own wildcard (pass 1 too long) and both failure modes are
  // silent under a coarse "does the lookup return something" test.
  pub let _hid_usage_specific_end : u64 = 11

  // ==========================================================================
  // Consumer-count latch. Pinned at 0 today; a future class driver that
  // calls the classifier for real will flip it, and the boot witness
  // assertion `hid_usage_consumed() == 0` fails at that point -- forcing
  // the module header to be rewritten with the live consumer's shape.
  // ==========================================================================

  pub let mut _hid_usage_consumers : u64 = 0

  pub let hid_usage_consumed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-002 (#1121): honesty pin -- 0 while no class driver calls the classifier for real. Report parser stores raw (page, id) and never asks kind, so parsing a descriptor does not trip this counter. When R32.M3 wires the class driver, the count flips and this witness assertion fails. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_usage_consumers];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hid_usage_row_count() -> row count of the table
  // ==========================================================================

  pub let hid_usage_row_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-002 (#1121): return the number of rows in _hid_usage_table. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_usage_count];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hid_usage_page_known(page) -> 1 | 0
  //
  // Cheap pre-filter for a parser that wants to REFUSE a whole descriptor
  // whose usage page is not one of the four this build knows how to route.
  // Does NOT walk the table -- the four pages are a compile-time set.
  // ==========================================================================

  pub let hid_usage_page_known : (u64) -> u64 !{} @{} =
    fn (page: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M2-002 (#1121): is the page one of the four this build knows -- Generic Desktop (0x01), Keyboard (0x07), Button (0x09), Consumer (0x0C). Cheap because the set is compile-time. Returns 1 on match, 0 otherwise. Leaf, no memory access. Labels prefixed hid_us_pk_ per reserved-label discipline.",
      block: {
        cmp rdi, 0x0001;
        je  hid_us_pk_yes;
        cmp rdi, 0x0007;
        je  hid_us_pk_yes;
        cmp rdi, 0x0009;
        je  hid_us_pk_yes;
        cmp rdi, 0x000C;
        je  hid_us_pk_yes;
        xor rax, rax;
        ret;

      hid_us_pk_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // hid_usage_id_kind(page, id) -> kind
  //
  // ARITY TWO by design (§1). Packs internally into (page << 16 | id) and
  // runs a two-pass linear scan: pass 1 hits specific rows (id != 0),
  // pass 2 hits wildcard rows (id == 0). Returns the first hit's kind, or
  // HID_USAGE_KIND_UNKNOWN if neither pass matches.
  // ==========================================================================

  pub let hid_usage_id_kind : (u64, u64) -> u64 !{mem} @{} =
    fn (page: u64, id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-002 (#1121): look up the KIND classification of a (page, id) pair. Two-pass linear scan of _hid_usage_table: pass 1 walks rows [0, _hid_usage_specific_end) matching the packed (page<<16|id) key exactly (returns on hit); pass 2 walks rows [_hid_usage_specific_end, _hid_usage_count) matching the (page<<16|0) wildcard key (returns on hit). A wildcard that returned during pass 1 would shadow a later specific and silently misclassify a spec-defined id; the two-pass discipline makes that a REPRESENTATION error rather than a scan bug. Table is bounded by _hid_usage_count (15), so linear is the right shape. Uses r12/r13/r14/r15/rbx across loops; five-push prologue keeps ret alignment intact. Labels prefixed hid_us_ik_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Pack key = (page << 16) | id. Both inputs assumed <= 0xFFFF; a
        // caller passing a larger id would produce a key that shifts into
        // the page nibble, which will not match any row and return UNKNOWN.
        mov r12, rdi;                     // r12 = page
        shl r12, 16;
        or  r12, rsi;                     // r12 = packed specific key

        // Wildcard key = (page << 16) | 0.
        mov r13, rdi;
        shl r13, 16;                      // r13 = packed wildcard key

        lea r14, [rip + _hid_usage_table];
        lea r10, [rip + _hid_usage_specific_end];
        mov r15, [r10];                   // r15 = specific rows count

        // Pass 1: specific match.
        xor rbx, rbx;
      hid_us_ik_sp_top:
        cmp rbx, r15;
        jae hid_us_ik_wild_start;
        mov rax, rbx;
        shl rax, 4;
        add rax, r14;                     // row address
        mov rcx, [rax];
        cmp rcx, r12;
        je  hid_us_ik_hit;
        add rbx, 1;
        jmp hid_us_ik_sp_top;

        // Pass 2: wildcard match.
      hid_us_ik_wild_start:
        lea r10, [rip + _hid_usage_count];
        mov r15, [r10];                   // r15 = total rows
      hid_us_ik_wd_top:
        cmp rbx, r15;
        jae hid_us_ik_none;
        mov rax, rbx;
        shl rax, 4;
        add rax, r14;
        mov rcx, [rax];
        cmp rcx, r13;
        je  hid_us_ik_hit;
        add rbx, 1;
        jmp hid_us_ik_wd_top;

      hid_us_ik_hit:
        mov rax, rbx;
        shl rax, 4;
        add rax, r14;
        mov rax, [rax + 8];               // kind
        jmp hid_us_ik_out;

      hid_us_ik_none:
        xor rax, rax;                     // UNKNOWN

      hid_us_ik_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
