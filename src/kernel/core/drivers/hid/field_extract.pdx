// src/kernel/core/drivers/hid/field_extract.pdx — R32.M2-004 (#1123)
//
// HID field extractor -- reads a value out of a raw report buffer using
// the geometry the parser (R32.M2-001) stored in _hid_report_schema.
// SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE FIELD-LEVEL DECODER between the raw bytes an input report
// carries and the numeric values a routing consumer eventually acts on.
// A HID field is defined by three parser-emitted quantities per row
// (report_parser.pdx §1):
//
//   report_size   -- the WIDTH IN BITS of one packed field (1..32 in this
//                    build; larger widths do not occur on the touchpad,
//                    trackpoint, keyboard or consumer-control pages the
//                    R32 stack routes).
//
//   report_count  -- the NUMBER of packed fields that share this row
//                    (e.g. three button bits under one INPUT item).
//
//   aux flags     -- the item flag byte (Data/Constant, Array/Variable,
//                    Abs/Rel, ...). The Array/Variable bit decides how a
//                    field is INTERPRETED: a variable field is a packed
//                    value; an array field is an INDEX into the
//                    usage-min..usage-max range.
//
// This module gives that interpretation three explicit seams -- one per
// mode the task names. Each takes the (report_ptr, report_len) pair
// from the caller (transport-fetched report bytes) plus the geometry
// arguments the mode needs. No seam consults _hid_report_schema
// directly: byte/bit offsets within a report are DERIVED from a walk
// over the schema in a class driver R32.M3 will land, and threading the
// schema into the extractor would let a caller reach a field the walk
// never traversed.
//
// IT IS NOT A LIVE DECISION POINT. Same discipline as usage.pdx §0 and
// collection_walker.pdx §0: no consumer keys off the extractor today.
// The pin `hid_field_extract_consumed() == 0` -- an assertion that
// FAILS the moment R32.M3 wires the class driver -- forces the module
// header to be rewritten with the live consumer's shape.
//
// =============================================================================
// §1  THREE EXTRACTION MODES
// =============================================================================
//
// BIT mode (report_size < 8, or > 8 not a multiple of 8, or spanning a
// byte boundary): hid_field_extract_bits reads report_size BITS
// starting at bit_offset within the report, returns them as an unsigned
// u64 in the low bits. Widths 1..32 are supported; a width outside
// that range is REFUSED with HID_FE_BAD_WIDTH, never truncated.
//
// SIGNED BYTE mode (report_size in {8, 16, 32}, aux flag says Data --
// e.g. mouse X/Y deltas): hid_field_extract_signed reads the same bit
// range and SIGN-EXTENDS the result across the full u64 using the
// top-bit of report_size. A caller that needs unsigned bytes stays on
// hid_field_extract_bits; a caller that needs signed integers uses
// this one -- the two seams are separate so a live driver cannot pick
// the wrong interpretation by passing an argument.
//
// ARRAY mode (aux flag Variable=0): hid_field_extract_array reads the
// index-th element of a byte-aligned array field. Each element is one
// BYTE (the widest HID array-index the R32 pages need is USB HID
// keyboard's 8-bit key code). A caller that needs a wider array
// element widens the seam, rather than the seam silently truncating.
//
// =============================================================================
// §2  ONE WRITER OF THE HONESTY PIN
// =============================================================================
//
// Same discipline as usage.pdx §2, quirks.pdx §2 and
// collection_walker.pdx §1: exactly one writer of
// _hid_field_extract_consumers -- this module, and only when a live
// consumer lands. tools/build.sh confines it. A stray writer would
// flip the pin without R32.M3 landing, and the boot witness assertion
// (0 today) would silently invert its meaning.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// BIT WIDTH outside 1..32 -> HID_FE_BAD_WIDTH. A width of 0 is not a
// field, and widths above 32 are not exercised by any T14 G4 report
// in this build; a caller that needed 64 would widen the seam. Neither
// is silently repaired.
//
// (bit_offset + bit_width) > report_len * 8 -> HID_FE_BAD_RANGE. A
// short report cannot be padded with zeros -- the parser stored
// report_size assuming a full report, and a truncated one is a
// transport-side truncation the caller MUST resolve.
//
// ARRAY (byte_offset + index) >= report_len -> HID_FE_BAD_RANGE. Same
// argument.
//
// Error codes are large enough (>= 0xFFFFFC20 > 2^32) that they never
// collide with a legitimate field value at any width in 1..32.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (deferred)
// =============================================================================
//
//   * NO SCHEMA CONSULTATION. §0 explains why -- the class driver walks
//     the schema; this module is called with the geometry it derives.
//   * NO LOGICAL MIN/MAX RESCALING. A field's raw bits are returned;
//     a consumer that needs the physical value applies the scale.
//   * NO UNIT / UNIT EXPONENT REPRESENTATION. Same reason.
//   * NO WIDTH > 32. §3 documents the refusal.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC20..0xFFFFFC2F
// =============================================================================

module FieldExtract = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HID_FE_OK        : u64 = 0
  pub let HID_FE_BAD_RANGE : u64 = 0xFFFFFC20
  pub let HID_FE_BAD_WIDTH : u64 = 0xFFFFFC21

  // ==========================================================================
  // Honesty pin. 0 until R32.M3 wires the class driver.
  // ==========================================================================

  pub let mut _hid_field_extract_consumers : u64 = 0

  pub let hid_field_extract_consumed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-004 (#1123): honesty pin -- 0 while no class driver decodes report fields for real. Boot witness asserts 0; a live consumer flips it and the assertion fails, forcing the doc to be rewritten. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_field_extract_consumers];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_field_extract_bits(report_ptr, report_len, bit_offset, bit_width)
  //     -> value | HID_FE_BAD_WIDTH | HID_FE_BAD_RANGE
  //
  // BIT mode (§1). Extracts bit_width bits starting at bit_offset within
  // the little-endian report buffer at report_ptr, returns them as an
  // unsigned u64. Widths 1..32 supported.
  //
  // Algorithm: byte-by-byte accumulate up to 5 bytes into a u64 (the
  // maximum touched by a 32-bit field at any bit alignment: 7-bit prefix
  // + 32 bits + 1-bit suffix = 40 bits = ceil(40/8) = 5 bytes), shift
  // right by the bit position within the starting byte, mask with
  // (1 << bit_width) - 1. The bounds check in step (2) proves the loaded
  // range is entirely within report_len bytes, so the per-byte guard is
  // belt-and-braces rather than load-bearing.
  //
  // Register plan (5-push prologue keeps ret-alignment intact even though
  // the function makes no nested call):
  //   rdi = report_ptr (preserved)
  //   rsi = report_len (preserved)
  //   rdx = bit_offset (consumed early)
  //   rcx = bit_width  (consumed early; saved to r15)
  //   rbx = byte_offset (bit_offset / 8)
  //   r12 = bit_pos     (bit_offset % 8)
  //   r13 = current byte counter (0..5)
  //   r14 = current shift amount (0, 8, 16, 24, 32)
  //   r15 = bit_width  (saved)
  //   rax = accumulator across load loop, then value
  //   r10, r11 = scratch
  // ==========================================================================

  pub let hid_field_extract_bits : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (report_ptr: u64, report_len: u64, bit_offset: u64, bit_width: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-004 (#1123): extract bit_width bits from a HID report buffer. Gates, in order: (1) bit_width in 1..32 -- else BAD_WIDTH, refused not clamped (a width of 0 is not a field, and widths above 32 are not exercised by any T14 G4 report in this build). (2) bit_offset + bit_width <= report_len * 8 -- else BAD_RANGE (a truncated report is transport-side, not smoothed here). (3) Accumulate up to 5 bytes into rax little-endian starting at byte_offset = bit_offset/8. (4) Shift right by bit_pos = bit_offset % 8 using cl (paideia-as encoding is `48 d3`, which uefi_phys_seed.pdx exercises at line 327). (5) Mask with (1 << bit_width) - 1; a width of 32 uses the 0xFFFFFFFF literal instead of the shift-then-sub to avoid the shl rax, 32 -> undefined-if-count-eq-64 edge (irrelevant at width 32 but pinned to keep the mask a compile-time constant path). Error codes are >= 0xFFFFFC20 > 2^32 so they never collide with a legitimate width-32 value. Reserved labels: prefixed hid_fe_eb_ (extract bits). Five-push prologue is present even though the function makes no nested call -- callee-saved regs r12..r15/rbx are load-bearing across the loop and must be restored for the caller.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) bit_width in 1..32.
        cmp rcx, 0;
        je  hid_fe_eb_bad_width;
        cmp rcx, 32;
        ja  hid_fe_eb_bad_width;

        // Save bit_width in r15 -- rcx is about to be used as the shift.
        mov r15, rcx;

        // (2) bit_offset + bit_width <= report_len * 8.
        //     report_len * 8 = rsi << 3; overflow at rsi >= 2^61 is not a
        //     concern for a HID report (max input report is O(1 KiB)).
        mov rax, rsi;
        shl rax, 3;
        mov r10, rdx;
        add r10, r15;
        cmp r10, rax;
        ja  hid_fe_eb_bad_range;

        // (3) byte_offset = bit_offset / 8; bit_pos = bit_offset % 8.
        mov rbx, rdx;
        shr rbx, 3;                      // byte_offset
        mov r12, rdx;
        and r12, 7;                      // bit_pos

        // (4) Accumulate up to 5 bytes at report_ptr[byte_offset + i]
        //     shifted left by i*8. Byte guard: stop early if
        //     byte_offset + i >= report_len (the bounds check in step 2
        //     proves this cannot fire for i < ceil((bit_pos + bit_width)/8),
        //     but the guard costs nothing and keeps the load restricted).
        xor rax, rax;                    // accumulator
        xor r13, r13;                    // i = 0
        xor r14, r14;                    // shift = 0

      hid_fe_eb_load_top:
        cmp r13, 5;
        jae hid_fe_eb_load_done;

        // (byte_offset + i) < report_len ?
        mov r10, rbx;
        add r10, r13;
        cmp r10, rsi;
        jae hid_fe_eb_load_done;

        // Compute byte address in r10 (paideia-as `mov_b` accepts
        // base+displacement only -- no base+index -- so we fold the
        // sum into a single register first).
        add r10, rdi;

        // Load byte, zero-extended (per madt.pdx line 226 pattern).
        xor r11, r11;
        mov_b r11, [r10];
        and r11, 0xff;

        // r11 <<= r14 (using cl).
        mov rcx, r14;
        shl r11, cl;

        or  rax, r11;

        add r13, 1;
        add r14, 8;
        jmp hid_fe_eb_load_top;

      hid_fe_eb_load_done:

        // (5) Shift right by bit_pos (r12).
        mov rcx, r12;
        shr rax, cl;

        // (6) Mask with (1 << bit_width) - 1. Widths 1..31 use the shift;
        //     width 32 uses the constant 0xFFFFFFFF to keep the mask a
        //     compile-time constant path and side-step the shl-count-32
        //     undefined-behaviour on 32-bit register operands (irrelevant
        //     on our 64-bit rax operand, but pinned for review-symmetry).
        cmp r15, 32;
        je  hid_fe_eb_mask32;

        mov rcx, r15;
        mov r10, 1;
        shl r10, cl;
        sub r10, 1;
        and rax, r10;
        jmp hid_fe_eb_out;

      hid_fe_eb_mask32:
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        jmp hid_fe_eb_out;

      hid_fe_eb_bad_width:
        mov rax, 0xFFFFFC21;
        jmp hid_fe_eb_out;

      hid_fe_eb_bad_range:
        mov rax, 0xFFFFFC20;

      hid_fe_eb_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_field_extract_signed(report_ptr, report_len, bit_offset, bit_width)
  //     -> sign-extended value | HID_FE_BAD_WIDTH | HID_FE_BAD_RANGE
  //
  // SIGNED BYTE mode (§1). Extracts the same bit range as
  // hid_field_extract_bits, then SIGN-EXTENDS the result across the full
  // u64 using the top bit of report_size. A width of 8 with value 0x81
  // returns 0xFFFFFFFFFFFFFF81 (i.e. -127 in two's complement);
  // width 32 with 0x80000000 returns 0xFFFFFFFF80000000.
  //
  // Implementation: call hid_field_extract_bits, check the top bit of
  // the width, sign-extend via arithmetic shift left/right on rax.
  //
  // Register plan: single-push prologue (rbx), only two nested calls to
  // hid_field_extract_bits and the mask helpers -- one push atop entry
  // rsp%16 == 8 delivers rsp%16 == 0 at the call.
  // ==========================================================================

  pub let hid_field_extract_signed : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (report_ptr: u64, report_len: u64, bit_offset: u64, bit_width: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-004 (#1123): extract bit_width bits and sign-extend across u64. Dispatch shape: call hid_field_extract_bits (same 4 args, same gates), inspect the top bit of the width, sign-extend by shl/sar on rax. Error codes are propagated unchanged: hid_field_extract_bits returns BAD_WIDTH / BAD_RANGE as values >= 0xFFFFFC20 which the top-bit test (bit r15-1) reads as SET on a legal width, but the range guard we duplicate before the call refuses those widths first. That duplication is deliberate: a live driver reading the error code as a signed value would flip its sign in ways impossible to distinguish from a truly-signed extreme without a separate error channel, and we do not build a separate channel here -- we refuse before extraction. rbx preserved (saves bit_width across the nested call). Reserved labels: prefixed hid_fe_es_.",
      block: {
        push rbx;

        // Duplicate the width gate before the call so a BAD_WIDTH is
        // never sign-extended into a value the caller cannot distinguish
        // from a negative field.
        cmp rcx, 0;
        je  hid_fe_es_bad_width;
        cmp rcx, 32;
        ja  hid_fe_es_bad_width;

        // Save width for the sign-extend step.
        mov rbx, rcx;

        // call hid_field_extract_bits(rdi, rsi, rdx, rcx).
        call hid_field_extract_bits;

        // Bounds error propagated unchanged.
        mov r10, 0xFFFFFC20;
        cmp rax, r10;
        je  hid_fe_es_out;

        // Sign-extend: shift left by (64 - width) then arithmetic-shift-right
        // by the same amount. Uses cl.
        mov rcx, 64;
        sub rcx, rbx;
        shl rax, cl;
        sar rax, cl;
        jmp hid_fe_es_out;

      hid_fe_es_bad_width:
        mov rax, 0xFFFFFC21;

      hid_fe_es_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_field_extract_array(report_ptr, report_len, byte_offset, index)
  //     -> byte value | HID_FE_BAD_RANGE
  //
  // ARRAY mode (§1). Returns the byte at report_ptr[byte_offset + index],
  // zero-extended into u64. A caller that reads the third pressed-key
  // slot of a USB HID keyboard input report (offset 2 into the 6-slot
  // array at report byte offset 2) calls with byte_offset=2, index=2.
  //
  // Element width is fixed at ONE BYTE. A widened element crosses spec
  // categories (USB HID keyboard = 8-bit; consumer-control usage arrays
  // are also 8-bit for the pages this build routes), so a caller that
  // needs a wider element widens the seam instead of the seam silently
  // truncating.
  // ==========================================================================

  pub let hid_field_extract_array : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (report_ptr: u64, report_len: u64, byte_offset: u64, index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-004 (#1123): read the index-th byte of a byte-aligned array field. Gate: (byte_offset + index) < report_len -- else BAD_RANGE (refused, not smoothed). Load ONE zero-extended byte. Leaf. Reserved labels: prefixed hid_fe_ea_.",
      block: {
        // addr = byte_offset + index; require addr < report_len.
        mov r10, rdx;
        add r10, rcx;
        cmp r10, rsi;
        jae hid_fe_ea_bad_range;

        // Fold report_ptr + addr into r10 (paideia-as `mov_b` accepts
        // base+displacement only -- no base+index -- so we compute the
        // sum in one register first).
        add r10, rdi;

        // Load byte, zero-extended.
        xor rax, rax;
        mov_b rax, [r10];
        and rax, 0xff;
        ret;

      hid_fe_ea_bad_range:
        mov rax, 0xFFFFFC20;
        ret
      }
    } @no_frame
}
