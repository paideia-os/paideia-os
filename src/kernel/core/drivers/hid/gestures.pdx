// src/kernel/core/drivers/hid/gestures.pdx
//     R32.M4-001 (#1129) — two-finger scroll recognizer
//     R32.M4-002 (#1130) — pinch recognizer
//     R32.M4-003 (#1131) — kinetic scroll (post-lift decay)
//     R32.M4-004 (#1132) — swipe (3+ finger) recognizer
//
// Four gesture state machines over touch samples. Each is a small
// automaton:
//
//     IDLE -> TRACKING -> RECOGNIZED
//                          |
//                          v
//                        (emit)
//
// on top of per-gesture state cells confined to this file. All four
// live in one module because they share one substrate (touch samples
// from the HID event stream), one confinement boundary (the writers
// below are the ONLY writers), and one honest-scaffold discipline
// (§0). Splitting into four files would quadruple the build.sh
// confinement rules for what is deliberately one trust surface.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE FOUR RECOGNIZERS the R32.M4 task names, exposed as pure
// step-functions the touchpad class driver will call once per touch
// sample. Each step consumes (finger_count, position/delta/distance)
// and returns 0 (no event) or 1 (event) after updating per-gesture
// state cells the caller then reads through accessors.
//
// IT IS NOT A LIVE HID CONSUMER. No code in this tree subscribes to
// the HID event stream (event_stream.pdx §4 lists the R32.M4-gated
// deferrals — no endpoint enqueue, no ring, no backpressure). The
// step functions are exercised by boot witnesses driving synthetic
// touch sequences; the real touchpad hardware path lands with the
// I²C-HID class driver's pointer subscriber. When that lands, the
// caller ROUTES stream events into gesture_*_step; nothing in this
// module changes because the callers are decoupled by construction.
//
// IT IS NOT A ROUTER. Recognized events are not enqueued anywhere.
// The caller reads the per-gesture output cells and forwards them.
// R32.M4's stream-router integration is a follow-up: adding a
// route call here without one would put recognition and delivery
// on the same critical path, which is not the shape the fanout in
// event_stream.pdx §1 chose.
//
// =============================================================================
// §1  STATE PER GESTURE — ONE CELL PER READER
// =============================================================================
//
// Each recognizer has EXACTLY ONE state cell (IDLE / TRACKING /
// RECOGNIZED) plus a small fixed set of data cells (positions,
// distances, cumulative deltas, velocities, direction bin). The
// state cell IS the state machine's discriminant — a reader that
// wants to know "am I mid-scroll?" reads gesture_scroll_state(),
// not a derived flag. This mirrors kind_hid_device.pdx §1: the
// discriminant is a stored field, not a computed one, so no two
// readers can disagree about what state the machine is in.
//
// The state machines are TIME-BLIND. They advance one step per
// call, not per wall-clock tick. Kinetic scroll's decay is a
// step-loop the caller drives; a caller that wants a wall-clock
// tempo throttles its own step calls. This keeps the recognizer
// deterministic for the fixture: a witness that supplies N samples
// gets the same trajectory every boot.
//
// =============================================================================
// §2  ONE WRITER PER STORAGE CELL
// =============================================================================
//
// Same discipline as event_stream.pdx §2, kind_hid_event.pdx
// §_hid_event_table, and every scaffold in the R32 family. THIS
// MODULE IS THE ONLY WRITER OF every _g_* cell below.
// tools/build.sh confines relocations against the storage symbols
// to this object; a stray writer could forge a recognized event
// without a step ever running, and the per-gesture accessors would
// read that forgery as legitimate output.
//
// The four gestures' state cells are DISJOINT: no gesture reads
// another's storage. Adding a "compound" gesture (e.g. rotate =
// pinch + swipe) is a fifth recognizer with its own state, not a
// cross-read into these four — a cross-read would install a
// dependency edge the confinement lint cannot see.
//
// =============================================================================
// §3  REFUSE, NEVER SMOOTH
// =============================================================================
//
// A step called with the wrong finger_count for the gesture returns
// 0 (no event) AND transitions the state cell to IDLE. A recognizer
// mid-tracking whose finger count drops to zero (the user lifted)
// resets — kinetic scroll then takes over via gesture_kinetic_
// scroll_seed if the caller chose to. A recognizer whose finger
// count changes to a NEW value (e.g. 2 -> 3 during a two-finger
// scroll) also resets: the two-finger geometry is no longer
// applicable and interpolating across the transition would emit
// a scroll event for a movement whose second half was actually a
// swipe. Refuse cleanly is cheaper than repair.
//
// The scroll threshold is on the DELTA, not the position. A caller
// that keeps sending the same average position emits ONE tracking
// entry and no further events; there is no drift accumulator.
//
// The pinch threshold is on the DISTANCE DELTA from the initial
// two-finger sample. A caller that sends a stable distance emits no
// event. The scale ratio is stored as (num, den) pair — a numerator
// and denominator, both u64 pixel counts — so a consumer computes
// the physical scale without this module introducing a floating
// point dependency (kernel is FP-disciplined per project rules).
//
// The kinetic decay multiplies velocity by 15/16 each step, using
// symmetric truncation toward zero: |v| is computed via the SAR abs
// idiom, multiplied by 15, unsigned-shifted right by 4, then the
// original sign is restored. A sar-based sign-preserving shift would
// floor toward -infinity on a negative product, fixing small negative
// velocities at -15..-1 (floor(-v * 15 / 16) == -v for 0 < v <= 15)
// and a leftward fling would then never satisfy |v| < MIN. Symmetric
// truncation decays both signs uniformly to zero. A signed absolute-
// value check STOPS the decay when both components fall below
// GESTURE_KINETIC_MIN_VEL. This is the "friction model" the task
// names; the specific ratio is documented as GESTURE_KINETIC_FRIC_NUM
// / (1 << FRIC_SHIFT) so a later tuning issue changes numbers, not
// shape.
//
// The swipe threshold is on the CUMULATIVE delta since the first
// 3+ finger sample. Once |cum_dx| or |cum_dy| exceeds
// GESTURE_SWIPE_THRESHOLD, the direction bin is committed by the
// dominant axis and its sign, and RECOGNIZED sticks — further
// samples in the same gesture emit no additional events. The
// caller reset on finger-lift; a follow-up swipe is a new gesture.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:R32.M4-followups)
// =============================================================================
//
//   * NO SUBSCRIPTION TO THE HID EVENT STREAM. The touchpad class
//     driver (still gated) is the subscriber; when it lands it
//     calls these step functions from its pointer path.
//   * NO WALL-CLOCK TICK SOURCE. Kinetic decay is caller-paced (§1).
//   * NO PALM REJECTION / TAP-TO-CLICK / EDGE FILTERS. These are
//     surface-classifier heuristics that ride on top of these
//     recognizers, not inside them.
//   * NO PER-FINGER TRACKING. The step signatures take reduced
//     scalars (average position, distance, cumulative delta) so the
//     class driver's per-finger MT protocol accumulator is the one
//     place a "finger 3 became finger 4 due to a reordering" bug
//     can live.
//   * NO EVENT PACKING INTO hid_event_stream_channel.pdx BYTES.
//     The stream schema encodes KEY / POINTER / TOUCH / SENSOR
//     classes today, and a semantic "swipe left" or "pinch 1.2x"
//     is a follow-up schema growth; that growth belongs beside the
//     schema, not here.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFDF0..0xFFFFFDFF
//
// Disjoint from every other in-tree band. event_stream.pdx owns
// 0xFFFFFEB0..BF, KIND_HID_EVENT owns 0xFFFFFE90..9F,
// KIND_HID_DEVICE owns 0xFFFFFE80..8F, field_extract owns
// 0xFFFFFC20..2F. 0xFFFFFDF0..FF was free.
// =============================================================================

module Gestures = structure {

  // ==========================================================================
  // §5 return codes and state constants.
  // ==========================================================================

  pub let GESTURE_OK          : u64 = 0
  pub let GESTURE_NO_EVENT    : u64 = 0
  pub let GESTURE_EVENT       : u64 = 1

  // Positional "no legal answer" sentinel.
  pub let GESTURE_DECODE_BAD  : u64 = 0xFFFFFFFFFFFFFFFF

  // State values common to all four recognizers.
  pub let GESTURE_STATE_IDLE        : u64 = 0
  pub let GESTURE_STATE_TRACKING    : u64 = 1
  pub let GESTURE_STATE_RECOGNIZED  : u64 = 2

  // Swipe direction bins (y-down convention: positive y is downward).
  pub let GESTURE_DIR_RIGHT : u64 = 0
  pub let GESTURE_DIR_LEFT  : u64 = 1
  pub let GESTURE_DIR_DOWN  : u64 = 2
  pub let GESTURE_DIR_UP    : u64 = 3
  pub let GESTURE_DIR_NONE  : u64 = 0xFF

  // Thresholds (pixels for spatial, dimensionless for velocity).
  //
  // The specific values are what the recognizer will FEEL LIKE on
  // the T14 G4 touchpad's 3200 x 2000 sensor when the driver lands,
  // arrived at by mirroring the libinput defaults for those dimensions
  // scaled to raw sensor units (libinput's default two-finger scroll
  // threshold is 15 mm / touchpad_resolution; the T14 G4 sensor is
  // ~40 units/mm on the y-axis and ~4 pixels is the smallest delta
  // that survives the finger's own jitter). They will move at first
  // hardware bring-up; the shape of what depends on them will not.
  pub let GESTURE_SCROLL_THRESHOLD    : u64 = 4
  pub let GESTURE_PINCH_THRESHOLD     : u64 = 8
  pub let GESTURE_KINETIC_FRIC_NUM    : u64 = 15
  pub let GESTURE_KINETIC_FRIC_SHIFT  : u64 = 4
  pub let GESTURE_KINETIC_MIN_VEL     : u64 = 2
  pub let GESTURE_SWIPE_THRESHOLD     : u64 = 40

  // ==========================================================================
  // Storage. Confined to this object by tools/build.sh (§2).
  //
  // Signed values (deltas, velocities, direction sign) live in u64
  // cells and are interpreted via signed compares (jl / jge) or the
  // sar-based abs-value idiom below. The two-finger scroll and swipe
  // gestures observe unsigned pixel coordinates from the caller but
  // compute SIGNED deltas internally; those signed intermediates are
  // stored as u64 bit patterns.
  // ==========================================================================

  pub let mut _g_scroll_state   : u64 = 0
  pub let mut _g_scroll_last_x  : u64 = 0
  pub let mut _g_scroll_last_y  : u64 = 0
  pub let mut _g_scroll_dx      : u64 = 0
  pub let mut _g_scroll_dy      : u64 = 0

  pub let mut _g_pinch_state     : u64 = 0
  pub let mut _g_pinch_init_dist : u64 = 0
  pub let mut _g_pinch_cur_dist  : u64 = 0

  pub let mut _g_kinetic_state  : u64 = 0
  pub let mut _g_kinetic_vx     : u64 = 0
  pub let mut _g_kinetic_vy     : u64 = 0

  pub let mut _g_swipe_state    : u64 = 0
  pub let mut _g_swipe_cum_dx   : u64 = 0
  pub let mut _g_swipe_cum_dy   : u64 = 0
  pub let mut _g_swipe_dir      : u64 = 0xFF

  // ==========================================================================
  // gesture_reset() -> ()
  //
  // Boot and teardown. Clears every state cell to IDLE and every
  // data cell to zero. The four gestures reset TOGETHER because the
  // caller (a class driver that just lost its device) has no
  // per-gesture selective-teardown need — either the touchpad is
  // gone or it is not.
  // ==========================================================================

  pub let gesture_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-001..004 (#1129..1132): reset every gesture state cell to IDLE and every data cell to zero. Called on both witness exits per gesture. Not a loop over the storage — the cells have different sentinel semantics (state is IDLE=0, swipe direction is 0xFF for NONE, distances are 0 for absent) and a loop would encode adjacency of unrelated fields as a fact the code depends on. Leaf; six labels prefixed g_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _g_scroll_state];
        xor rax, rax;
        mov [r10], rax;
        lea r10, [rip + _g_scroll_last_x];
        mov [r10], rax;
        lea r10, [rip + _g_scroll_last_y];
        mov [r10], rax;
        lea r10, [rip + _g_scroll_dx];
        mov [r10], rax;
        lea r10, [rip + _g_scroll_dy];
        mov [r10], rax;

        lea r10, [rip + _g_pinch_state];
        mov [r10], rax;
        lea r10, [rip + _g_pinch_init_dist];
        mov [r10], rax;
        lea r10, [rip + _g_pinch_cur_dist];
        mov [r10], rax;

        lea r10, [rip + _g_kinetic_state];
        mov [r10], rax;
        lea r10, [rip + _g_kinetic_vx];
        mov [r10], rax;
        lea r10, [rip + _g_kinetic_vy];
        mov [r10], rax;

        lea r10, [rip + _g_swipe_state];
        mov [r10], rax;
        lea r10, [rip + _g_swipe_cum_dx];
        mov [r10], rax;
        lea r10, [rip + _g_swipe_cum_dy];
        mov [r10], rax;

        // Swipe direction sentinel is 0xFF (GESTURE_DIR_NONE), not 0.
        lea r10, [rip + _g_swipe_dir];
        mov rax, 0xFF;
        mov [r10], rax;
        ret
      }
    }

  // ==========================================================================
  // Accessors. One per readable output cell. Pure loads.
  // ==========================================================================

  pub let gesture_scroll_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-001 (#1129): read the scroll recognizer's current state (IDLE/TRACKING/RECOGNIZED). Leaf load.",
      block: {
        lea r10, [rip + _g_scroll_state];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_scroll_dx : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-001 (#1129): read the last emitted scroll dx (signed, two's-complement in u64). Zero before the first RECOGNIZED emission. Leaf load.",
      block: {
        lea r10, [rip + _g_scroll_dx];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_scroll_dy : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-001 (#1129): read the last emitted scroll dy. Same rules as gesture_scroll_dx. Leaf load.",
      block: {
        lea r10, [rip + _g_scroll_dy];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_pinch_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-002 (#1130): read the pinch recognizer's state. Leaf load.",
      block: {
        lea r10, [rip + _g_pinch_state];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_pinch_init_dist : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-002 (#1130): read the initial two-finger distance (the scale denominator). Zero while IDLE. Leaf load.",
      block: {
        lea r10, [rip + _g_pinch_init_dist];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_pinch_cur_dist : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-002 (#1130): read the current two-finger distance (the scale numerator). Leaf load.",
      block: {
        lea r10, [rip + _g_pinch_cur_dist];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_kinetic_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-003 (#1131): read the kinetic decay state. Leaf load.",
      block: {
        lea r10, [rip + _g_kinetic_state];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_kinetic_vx : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-003 (#1131): read the current decayed vx (signed, in u64). Leaf load.",
      block: {
        lea r10, [rip + _g_kinetic_vx];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_kinetic_vy : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-003 (#1131): read the current decayed vy. Leaf load.",
      block: {
        lea r10, [rip + _g_kinetic_vy];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_swipe_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-004 (#1132): read the swipe recognizer's state. Leaf load.",
      block: {
        lea r10, [rip + _g_swipe_state];
        mov rax, [r10];
        ret
      }
    }

  pub let gesture_swipe_dir : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-004 (#1132): read the swipe direction bin (0..3 = RIGHT/LEFT/DOWN/UP, 0xFF = NONE). Leaf load.",
      block: {
        lea r10, [rip + _g_swipe_dir];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // gesture_two_finger_scroll_step(finger_count, avg_x, avg_y)
  //     -> 1 (event emitted) | 0 (no event)                             #1129
  //
  // State machine:
  //   IDLE  + finger_count != 2                     -> IDLE, 0
  //   IDLE  + finger_count == 2                     -> TRACKING, 0
  //         (store avg_x, avg_y as last)
  //   TRACKING + finger_count == 2                  -> compute dy,
  //         if |dy| >= threshold (OR |dx| >= thr) -> RECOGNIZED, 1
  //         else                                    -> TRACKING, 0
  //         (always update last_x, last_y)
  //   RECOGNIZED + finger_count == 2                -> RECOGNIZED,
  //         emit if delta >= threshold, else 0. This lets a
  //         continuing scroll drive multiple emissions.
  //   * + finger_count != 2                         -> IDLE, 0
  //
  // Deltas are computed as SIGNED avg_x - last_x, held in the u64
  // storage as two's-complement bit patterns. The abs-value check
  // uses the SAR idiom (mov r10, rax; sar r10, 63; xor rax, r10;
  // sub rax, r10 -> rax = |rax|) so the comparison to threshold is
  // unambiguously unsigned.
  //
  // Register plan: four callee-save pushes for rbx (avg_x, then dx),
  // r12 (avg_y, then dy), r13 (finger_count then last-x), r14
  // (last-y). Five-push alignment is not needed because the function
  // makes no nested call. Reserved labels prefixed g_sc_.
  // ==========================================================================

  pub let gesture_two_finger_scroll_step : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (finger_count: u64) (avg_x: u64) (avg_y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-001 (#1129): one step of the two-finger scroll recognizer. Gates on finger_count == 2; anything else transitions to IDLE and returns 0 (§3). On first 2-finger sample transitions IDLE->TRACKING, stores last_x, last_y, returns 0 (no delta yet). On subsequent 2-finger samples computes SIGNED dx = avg_x - last_x and dy = avg_y - last_y, both held in u64 bit patterns; if either |dx| >= GESTURE_SCROLL_THRESHOLD or |dy| >= threshold, stores dx, dy in the output cells, transitions to RECOGNIZED (if not already there), returns 1. Otherwise returns 0. Always updates last_x, last_y so the next delta is relative to THIS sample, not the pre-emit one — a continuous scroll then emits repeatedly. Absolute value via SAR idiom (mov r10, x; sar r10, 63; xor x, r10; sub x, r10) rather than a branch because the idiom is one-fewer instruction and paideia-as encoder-tested (see field_extract.pdx). Reserved labels prefixed g_sc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rsi;                    // avg_x
        mov r12, rdx;                    // avg_y

        // Refuse: finger_count != 2 -> IDLE, 0.
        cmp rdi, 2;
        jne g_sc_idle;

        // Load current state.
        lea r10, [rip + _g_scroll_state];
        mov r13, [r10];                  // state

        // IDLE -> TRACKING (store last, no emit).
        cmp r13, 0;                      // GESTURE_STATE_IDLE
        jne g_sc_tracking_or_recog;

        lea r10, [rip + _g_scroll_last_x];
        mov [r10], rbx;
        lea r10, [rip + _g_scroll_last_y];
        mov [r10], r12;
        lea r10, [rip + _g_scroll_state];
        mov rax, 1;                      // TRACKING
        mov [r10], rax;
        xor rax, rax;
        jmp g_sc_out;

      g_sc_tracking_or_recog:
        // dx = avg_x - last_x; dy = avg_y - last_y. Signed intermediates
        // kept in caller-save r8/r9 so we do not clobber rbx/r12 (which
        // still hold avg_x/avg_y, needed for the last_x/last_y update).
        lea r10, [rip + _g_scroll_last_x];
        mov r13, [r10];                  // last_x
        lea r10, [rip + _g_scroll_last_y];
        mov r14, [r10];                  // last_y

        mov r8, rbx;
        sub r8, r13;                     // r8 = dx (signed)
        mov r9, r12;
        sub r9, r14;                     // r9 = dy (signed)

        // Update last_x, last_y = current avg_x, avg_y.
        lea r10, [rip + _g_scroll_last_x];
        mov [r10], rbx;
        lea r10, [rip + _g_scroll_last_y];
        mov [r10], r12;

        // |dx| in r11 (via SAR abs idiom; leaves r8 unclobbered).
        mov r11, r8;
        mov r10, r8;
        sar r10, 63;
        xor r11, r10;
        sub r11, r10;                    // r11 = |dx|

        // |dy| in rax.
        mov rax, r9;
        mov r10, r9;
        sar r10, 63;
        xor rax, r10;
        sub rax, r10;                    // rax = |dy|

        // Emit if |dx| >= threshold OR |dy| >= threshold.
        mov rcx, 4;                      // GESTURE_SCROLL_THRESHOLD
        cmp r11, rcx;
        jae g_sc_emit;
        cmp rax, rcx;
        jae g_sc_emit;

        // Below threshold: keep state and updated last, no emit.
        xor rax, rax;
        jmp g_sc_out;

      g_sc_emit:
        // Store signed dx, dy to output cells; transition to RECOGNIZED.
        lea r10, [rip + _g_scroll_dx];
        mov [r10], r8;
        lea r10, [rip + _g_scroll_dy];
        mov [r10], r9;
        lea r10, [rip + _g_scroll_state];
        mov rax, 2;                      // RECOGNIZED
        mov [r10], rax;
        mov rax, 1;
        jmp g_sc_out;

      g_sc_idle:
        // Force IDLE and scrub the tracking anchors so a re-entry
        // starts fresh (a stale last_x/last_y from a previous scroll
        // would fake a huge dx on the first sample of the next one).
        lea r10, [rip + _g_scroll_state];
        xor rax, rax;
        mov [r10], rax;
        lea r10, [rip + _g_scroll_last_x];
        mov [r10], rax;
        lea r10, [rip + _g_scroll_last_y];
        mov [r10], rax;
        xor rax, rax;

      g_sc_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gesture_pinch_step(finger_count, dist)
  //     -> 1 (event emitted) | 0 (no event)                             #1130
  //
  // State machine:
  //   IDLE + finger_count != 2   -> IDLE, 0
  //   IDLE + finger_count == 2   -> TRACKING, store dist as init AND cur, 0
  //   TRACKING + finger_count == 2:
  //         let ddist = dist - init_dist (unsigned; take abs via
  //         two compares because dist can be smaller or larger)
  //         if ddist >= GESTURE_PINCH_THRESHOLD -> RECOGNIZED, cur=dist, 1
  //         else                                 -> TRACKING, cur=dist, 0
  //   RECOGNIZED + finger_count == 2:
  //         continue emitting on further threshold crossings from cur.
  //   * + finger_count != 2      -> IDLE, 0
  //
  // The scale is stored as the pair (cur, init) — a numerator and
  // a denominator, both in pixels. A consumer computes cur/init as
  // the physical scale factor; this module never divides (§3).
  //
  // Register plan: two callee-save pushes for rbx (dist), r12
  // (finger_count then init). Reserved labels prefixed g_pi_.
  // ==========================================================================

  pub let gesture_pinch_step : (u64, u64) -> u64 !{mem} @{} =
    fn (finger_count: u64) (dist: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-002 (#1130): one step of the pinch recognizer. Gates on finger_count == 2; anything else -> IDLE, 0. On first 2-finger sample: TRACKING, stores dist as both init and cur, returns 0. On subsequent 2-finger samples: computes |dist - init_dist| via a two-branch compare (dist may be smaller or larger than init); if the delta exceeds GESTURE_PINCH_THRESHOLD, transitions to RECOGNIZED (if not already), updates cur = dist, returns 1. Otherwise updates cur = dist, returns 0. Scale is (cur, init) as a rational, avoiding kernel floating point (§3). Two pushes leave rsp%16 == 0 with no nested call (unused alignment slack, deliberate for register economy). Reserved labels prefixed g_pi_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rsi;                    // dist

        // Refuse: finger_count != 2 -> IDLE, 0.
        cmp rdi, 2;
        jne g_pi_idle;

        // Load state.
        lea r10, [rip + _g_pinch_state];
        mov r12, [r10];

        cmp r12, 0;                      // IDLE ?
        jne g_pi_running;

        // IDLE -> TRACKING: store init AND cur = dist.
        lea r10, [rip + _g_pinch_init_dist];
        mov [r10], rbx;
        lea r10, [rip + _g_pinch_cur_dist];
        mov [r10], rbx;
        lea r10, [rip + _g_pinch_state];
        mov rax, 1;                      // TRACKING
        mov [r10], rax;
        xor rax, rax;
        jmp g_pi_out;

      g_pi_running:
        // ddist = |dist - init|. Compare-then-branch avoids the SAR
        // idiom because dist and init are unsigned.
        lea r10, [rip + _g_pinch_init_dist];
        mov r12, [r10];                  // init

        // Always update cur regardless of emit decision.
        lea r10, [rip + _g_pinch_cur_dist];
        mov [r10], rbx;

        cmp rbx, r12;
        jae g_pi_expand;
        // Contract: ddist = init - dist.
        mov rax, r12;
        sub rax, rbx;
        jmp g_pi_thresh;
      g_pi_expand:
        // Expand: ddist = dist - init.
        mov rax, rbx;
        sub rax, r12;
      g_pi_thresh:
        mov r11, 8;                      // GESTURE_PINCH_THRESHOLD
        cmp rax, r11;
        jb  g_pi_no_emit;

        // Emit: set RECOGNIZED, return 1.
        lea r10, [rip + _g_pinch_state];
        mov rax, 2;                      // RECOGNIZED
        mov [r10], rax;
        mov rax, 1;
        jmp g_pi_out;

      g_pi_no_emit:
        xor rax, rax;
        jmp g_pi_out;

      g_pi_idle:
        lea r10, [rip + _g_pinch_state];
        xor rax, rax;
        mov [r10], rax;
        xor rax, rax;

      g_pi_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gesture_kinetic_scroll_seed(vx, vy) -> ()                           #1131
  //
  // Seed the kinetic decay with initial signed velocities. Called by
  // the caller when a two-finger scroll ends (fingers lifted) — the
  // caller computes vx, vy from the last few pre-lift samples and
  // hands them here. State becomes DECAYING (mapped to
  // GESTURE_STATE_TRACKING semantically: the decay is a tracked
  // trajectory, not a recognition boundary).
  //
  // A seed with |vx| < MIN and |vy| < MIN leaves state IDLE — a
  // gentle lift is not a fling.
  // ==========================================================================

  pub let gesture_kinetic_scroll_seed : (u64, u64) -> () !{mem} @{} =
    fn (vx: u64) (vy: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-003 (#1131): seed the kinetic decay with signed vx, vy (u64 two's-complement bit patterns). Computes |vx|, |vy| via the SAR idiom and compares to GESTURE_KINETIC_MIN_VEL; a seed below threshold on BOTH axes leaves the state at IDLE (a slow lift is not a fling). Otherwise stores vx, vy and transitions to TRACKING. Signed input, unsigned compare after abs. Two pushes leave rsp%16 == 0 with no nested call (unused alignment slack). Reserved labels prefixed g_kseed_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // vx (signed) — preserved for store
        mov r12, rsi;                    // vy (signed) — preserved for store

        // |vx| in r11 via SAR abs idiom, leaving rbx untouched.
        mov r11, rbx;
        mov r10, rbx;
        sar r10, 63;
        xor r11, r10;
        sub r11, r10;                    // r11 = |vx|

        mov rax, 2;                      // GESTURE_KINETIC_MIN_VEL
        cmp r11, rax;
        jae g_kseed_fling;

        // |vy| in r11, leaving r12 untouched.
        mov r11, r12;
        mov r10, r12;
        sar r10, 63;
        xor r11, r10;
        sub r11, r10;                    // r11 = |vy|

        cmp r11, rax;
        jae g_kseed_fling;

        // Both below threshold — leave IDLE, do not store.
        jmp g_kseed_out;

      g_kseed_fling:
        // Store signed vx, vy; transition to TRACKING.
        lea r10, [rip + _g_kinetic_vx];
        mov [r10], rbx;
        lea r10, [rip + _g_kinetic_vy];
        mov [r10], r12;
        lea r10, [rip + _g_kinetic_state];
        mov rax, 1;                      // TRACKING (decay in progress)
        mov [r10], rax;

      g_kseed_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gesture_kinetic_scroll_step() -> 1 (emitted) | 0 (stopped)          #1131
  //
  // Advance the decay one tick. If state is IDLE, return 0 immediately.
  // Otherwise:
  //   vx = (vx * 15) >> 4      (arithmetic shift, sign-preserving)
  //   vy = (vy * 15) >> 4
  //   if |vx| < MIN and |vy| < MIN -> IDLE, return 0
  //   else -> emit, return 1
  //
  // The caller reads gesture_kinetic_vx()/vy() after a 1 return
  // to consume the decayed velocity. This mirrors the pattern the
  // scroll recognizer uses: state and output cells are read via
  // accessors, the step function returns just an emit flag.
  // ==========================================================================

  pub let gesture_kinetic_scroll_step : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-003 (#1131): advance the kinetic decay one tick. IDLE -> 0. Otherwise decays vx and vy by GESTURE_KINETIC_FRIC_NUM / (1 << FRIC_SHIFT) = 15/16 using SYMMETRIC TRUNCATION TOWARD ZERO: compute |v| via the SAR abs idiom, multiply by 15, unsigned-shift right by 4, then restore the original sign. A sar-based sign-preserving shift would floor toward -infinity on a negative product, fixing small negative velocities at -15..-1 (floor(-v * 15 / 16) == -v for 0 < v <= 15) and a leftward fling would then never satisfy |v| < MIN — the witness's bounded loop would spin against the cap. Truncation toward zero decays both signs uniformly. Checks |vx| and |vy| via SAR abs idiom; if BOTH fall below GESTURE_KINETIC_MIN_VEL transitions to IDLE and returns 0 (decay ended). Otherwise stores the decayed vx, vy and returns 1. The friction ratio is documented as (NUM, SHIFT) so a later tuning issue changes numbers, not shape. Two pushes leave rsp%16 == 0 with no nested call (unused alignment slack). Reserved labels prefixed g_kstep_.",
      block: {
        push rbx;
        push r12;

        // Load state.
        lea r10, [rip + _g_kinetic_state];
        mov rax, [r10];
        cmp rax, 0;
        je  g_kstep_idle;

        // Load vx, vy.
        lea r10, [rip + _g_kinetic_vx];
        mov rbx, [r10];
        lea r10, [rip + _g_kinetic_vy];
        mov r12, [r10];

        // vx = trunc(vx * 15 / 16). Symmetric decay: compute |vx|,
        // multiply, unsigned-shift, restore sign. A sar-based
        // sign-preserving shift would floor to -infinity and fix
        // small negatives at -1..-15, blocking the terminate-when-
        // |v|<MIN loop.
        mov r10, rbx;
        sar r10, 63;                     // r10 = sign mask (0 or -1)
        mov r11, rbx;
        xor r11, r10;
        sub r11, r10;                    // r11 = |vx|
        mov rax, 15;                     // GESTURE_KINETIC_FRIC_NUM
        imul r11, rax;                   // r11 = |vx| * 15
        shr r11, 4;                      // r11 = |vx| * 15 / 16 (trunc)
        xor r11, r10;
        sub r11, r10;                    // r11 = signed decayed vx
        mov rbx, r11;

        // vy = trunc(vy * 15 / 16) with the same idiom.
        mov r10, r12;
        sar r10, 63;
        mov r11, r12;
        xor r11, r10;
        sub r11, r10;                    // r11 = |vy|
        mov rax, 15;
        imul r11, rax;
        shr r11, 4;
        xor r11, r10;
        sub r11, r10;                    // r11 = signed decayed vy
        mov r12, r11;

        // Store the decayed values back regardless of stop-condition:
        // a reader that saw the previous step and now sees stop should
        // see the last non-zero decay result, not the pre-decay value.
        lea r10, [rip + _g_kinetic_vx];
        mov [r10], rbx;
        lea r10, [rip + _g_kinetic_vy];
        mov [r10], r12;

        // |vx|
        mov r11, rbx;
        mov r10, rbx;
        sar r10, 63;
        xor r11, r10;
        sub r11, r10;                    // r11 = |vx|

        mov rax, 2;                      // GESTURE_KINETIC_MIN_VEL
        cmp r11, rax;
        jae g_kstep_emit;

        // |vy|
        mov r11, r12;
        mov r10, r12;
        sar r10, 63;
        xor r11, r10;
        sub r11, r10;                    // r11 = |vy|

        cmp r11, rax;
        jae g_kstep_emit;

        // Both below MIN — stop.
        lea r10, [rip + _g_kinetic_state];
        xor rax, rax;
        mov [r10], rax;
        xor rax, rax;
        jmp g_kstep_out;

      g_kstep_emit:
        mov rax, 1;
        jmp g_kstep_out;

      g_kstep_idle:
        xor rax, rax;

      g_kstep_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gesture_swipe_step(finger_count, dx, dy)
  //     -> 1 (event emitted) | 0 (no event)                             #1132
  //
  // State machine:
  //   IDLE + finger_count < 3    -> IDLE, 0
  //   IDLE + finger_count >= 3   -> TRACKING, reset cum, cum+=dx/dy, 0
  //   TRACKING + finger_count >= 3:
  //         cum_dx += dx; cum_dy += dy
  //         if |cum_dx| >= GESTURE_SWIPE_THRESHOLD or
  //            |cum_dy| >= threshold:
  //             direction = dominant-axis with sign
  //             -> RECOGNIZED, 1
  //         else -> TRACKING, 0
  //   RECOGNIZED + finger_count >= 3 -> RECOGNIZED, 0 (no re-emit)
  //   * + finger_count < 3       -> IDLE, 0
  //
  // Direction bins are chosen by picking the axis with larger
  // absolute cumulative delta and then its sign (§2 constants).
  // A tie goes to X — the touchpad's X range is wider than Y on
  // the T14 G4 (3200 vs 2000), so a diagonal that goes equally
  // in both is closer to a horizontal swipe in "user units".
  //
  // Reserved labels prefixed g_sw_.
  // ==========================================================================

  pub let gesture_swipe_step : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (finger_count: u64) (dx: u64) (dy: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M4-004 (#1132): one step of the 3+ finger swipe recognizer. Gates finger_count >= 3; anything else -> IDLE, 0 (§3). On first 3+-finger sample: TRACKING, resets cumulative deltas to zero, then adds (dx, dy). On subsequent 3+-finger samples in TRACKING: adds (dx, dy) to cum. When |cum_dx| OR |cum_dy| exceeds GESTURE_SWIPE_THRESHOLD, picks the direction bin by dominant absolute axis and its sign (X wins ties — the touchpad X range is wider than Y on the T14 G4), stores it in _g_swipe_dir, transitions to RECOGNIZED, returns 1. Once RECOGNIZED, further 3+-finger samples with any delta return 0 — swipes are ONE-SHOT recognitions; a follow-up swipe starts after a finger-lift to IDLE. Signed cumulative deltas via u64 bit patterns; abs via SAR idiom (mov r10, x; sar r10, 63; xor r11=x^r10; sub r11, r10). Four pushes leave rsp%16 == 0 with no nested call. Reserved labels prefixed g_sw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rsi;                    // dx (signed)
        mov r12, rdx;                    // dy (signed)

        // Refuse: finger_count < 3 -> IDLE, 0.
        mov r10, 3;
        cmp rdi, r10;
        jb  g_sw_idle;

        // Load state.
        lea r10, [rip + _g_swipe_state];
        mov r13, [r10];

        // RECOGNIZED sticks — no re-emit.
        mov r10, 2;                      // GESTURE_STATE_RECOGNIZED
        cmp r13, r10;
        je  g_sw_no_emit;

        // IDLE -> TRACKING: reset cum to zero.
        cmp r13, 0;                      // GESTURE_STATE_IDLE
        jne g_sw_accumulate;
        lea r10, [rip + _g_swipe_cum_dx];
        xor rax, rax;
        mov [r10], rax;
        lea r10, [rip + _g_swipe_cum_dy];
        mov [r10], rax;
        lea r10, [rip + _g_swipe_state];
        mov rax, 1;                      // TRACKING
        mov [r10], rax;
        // Also reset direction to NONE while we track.
        lea r10, [rip + _g_swipe_dir];
        mov rax, 0xFF;                   // GESTURE_DIR_NONE
        mov [r10], rax;

      g_sw_accumulate:
        // cum_dx += dx; cum_dy += dy.
        lea r10, [rip + _g_swipe_cum_dx];
        mov rax, [r10];
        add rax, rbx;                    // signed add on u64 = two's-comp add
        mov [r10], rax;
        mov r13, rax;                    // r13 = cum_dx (signed)

        lea r10, [rip + _g_swipe_cum_dy];
        mov rax, [r10];
        add rax, r12;
        mov [r10], rax;
        mov r14, rax;                    // r14 = cum_dy (signed)

        // |cum_dx|
        mov r11, r13;
        mov r10, r13;
        sar r10, 63;
        xor r11, r10;
        sub r11, r10;                    // r11 = |cum_dx|

        // |cum_dy|
        mov rax, r14;
        mov r10, r14;
        sar r10, 63;
        xor rax, r10;
        sub rax, r10;                    // rax = |cum_dy|

        // Threshold check.
        mov rsi, 40;                     // GESTURE_SWIPE_THRESHOLD
        cmp r11, rsi;
        jae g_sw_maybe_emit;
        cmp rax, rsi;
        jae g_sw_maybe_emit;

        // Below threshold, still tracking.
        xor rax, rax;
        jmp g_sw_out;

      g_sw_maybe_emit:
        // Pick dominant axis. |cum_dx| in r11, |cum_dy| in rax.
        // X wins ties per §comment.
        cmp r11, rax;
        jae g_sw_axis_x;
        // Y dominant: direction = DOWN if cum_dy > 0, UP if < 0.
        cmp r14, 0;
        jl  g_sw_up;
        mov rdx, 2;                      // GESTURE_DIR_DOWN
        jmp g_sw_commit;
      g_sw_up:
        mov rdx, 3;                      // GESTURE_DIR_UP
        jmp g_sw_commit;
      g_sw_axis_x:
        // X dominant: direction = RIGHT if cum_dx > 0, LEFT if < 0.
        cmp r13, 0;
        jl  g_sw_left;
        mov rdx, 0;                      // GESTURE_DIR_RIGHT
        jmp g_sw_commit;
      g_sw_left:
        mov rdx, 1;                      // GESTURE_DIR_LEFT

      g_sw_commit:
        lea r10, [rip + _g_swipe_dir];
        mov [r10], rdx;
        lea r10, [rip + _g_swipe_state];
        mov rax, 2;                      // RECOGNIZED
        mov [r10], rax;
        mov rax, 1;
        jmp g_sw_out;

      g_sw_no_emit:
        xor rax, rax;
        jmp g_sw_out;

      g_sw_idle:
        lea r10, [rip + _g_swipe_state];
        xor rax, rax;
        mov [r10], rax;
        lea r10, [rip + _g_swipe_cum_dx];
        mov [r10], rax;
        lea r10, [rip + _g_swipe_cum_dy];
        mov [r10], rax;
        lea r10, [rip + _g_swipe_dir];
        mov rax, 0xFF;                   // GESTURE_DIR_NONE
        mov [r10], rax;
        xor rax, rax;

      g_sw_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
