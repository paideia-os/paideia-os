// src/kernel/core/drivers/hid/event_stream.pdx — R32.M3-003 (#1127)
//
// The unified HID event stream: the fanout point between HID PRODUCERS
// (a USB HID class instance, an I²C-HID touchpad, a Bluetooth HID
// keyboard) and HID SUBSCRIBERS (a compositor, an input router, a
// security monitor) named by their KIND_HID_EVENT slot.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE ONE FANOUT POINT for HID events in the kernel. A USB HID
// producer, an I²C-HID producer, and a future Bluetooth HID producer
// all publish through hid_event_stream_publish. Each subscriber holds
// a KIND_HID_EVENT capability (cap/kind_hid_event.pdx) whose row
// records its event_type_mask; publish walks the stream's subscriber
// table and delivers to exactly those whose mask matches the published
// event's class.
//
// IT IS NOT A LIVE ENDPOINT ROUTER. cap/kind_hid_event.pdx §3 says
// "NOTHING ROUTES AN EVENT. Routing is R32.M4's; this kind is the
// record of a subscription that a router will consult." This module
// is the SCAFFOLD of that router — the walk, the mask filter, the
// per-subscriber delivery counter — but the byte that would land in
// the subscriber's KIND_IPC_ENDPOINT queue is not enqueued in this
// tree. R32.M4 wires the delivery in the same commit that plumbs the
// endpoint transport for HID; until then, the honest sentinel that
// says "the fanout ran and matched N subscribers, no bytes crossed a
// process boundary" is the per-subscriber `delivered` counter this
// module maintains.
//
// IT IS THE ONE SEQUENCE ORIGIN. Every published event, matched or
// not, consumes one number from a monotonic `_hid_evt_stream_seq`
// counter. A subscriber whose per-subscriber `delivered` count is 12
// and whose next observed sequence is 40 knows it missed the events
// between its high-water mark and 40 — the same #1059 discipline the
// ACPI event stream carries, translated to a fanout without a ring.
//
// =============================================================================
// §1  MULTI-TRANSPORT MERGE — WHY THE STREAM IS SINGULAR
// =============================================================================
//
// The T14 G4 has three transports that generate HID events: USB (the
// user's keyboard and mouse), I²C-HID (the built-in touchpad and
// trackpoint on LPSS-I²C), and a future Bluetooth HID (a wireless
// mouse). A subscriber whose job is "translate scancodes into
// characters" does not care which transport generated a key-press,
// only that a key-press happened. Routing three streams would force
// every such subscriber to subscribe three times, and would let a
// keyboard hot-plug (USB removed, Bluetooth attached) silently drop
// events during the transition.
//
// So the fanout is ONE table, keyed on the SUBSCRIBER's KIND_HID_EVENT
// slot, and PER-SOURCE tagging happens INSIDE the payload the
// schema packs (design/ipc/hid-event-stream-session.md §3). The
// stream itself sees only (event_class, payload); the producer's
// transport identity is a §3 payload field.
//
// =============================================================================
// §2  ONE WRITER OF THE SUBSCRIBER TABLE
// =============================================================================
//
// Same discipline as kind_hid_event.pdx's _hid_event_table:
// _hid_evt_stream_subs and _hid_evt_stream_delivered are written only
// by this module. tools/build.sh confines relocations against both
// symbols and the counter cell to this object; a second writer could
// forge a subscription (deliveries to a KIND_HID_EVENT slot no
// subscriber holds, or none-delivery to a slot every subscriber holds)
// with no gate involved and no counter moving.
//
// The subscribe/unsubscribe primitives are the only path in. They
// validate the caller's slot through hid_event_row_of_slot — the
// single arity-one route between a capability and a subscription row
// — so a subscribe call that names a slot of any other kind fails
// with WRONG_KIND rather than installing a fabricated subscription.
//
// =============================================================================
// §3  REFUSE, NEVER FANOUT SILENTLY
// =============================================================================
//
// Same discipline as backlight_pwm.pdx §3 and every other scaffold in
// this file family. A publish whose event_type is not exactly one of
// the four HID event classes (KEY, POINTER, TOUCH, SENSOR) is BAD_TYPE
// and counted; a publish with no matching subscriber returns
// delivered=0 and counts an unrouted offer. THE SEQUENCE COUNTER
// ADVANCES ON EVERY OFFER, matched or not, so a subscriber joining
// mid-stream can compute its own start.
//
// The stream treats `payload` as OPAQUE. It does not decode the
// packed word -- that is the schema's (design/ipc/hid-event-stream-
// session.md / ipc/hid_event_stream_channel.pdx). Producers are
// expected to have passed the payload through the schema's packers
// BEFORE publishing, and receivers unpack through the schema's
// unpackers. Coupling the stream to the schema's per-event reserved-
// bits layout would make a schema growth (a new event type, an added
// field) require a stream change too, and one of the whole points of
// the fanout is to be schema-agnostic.
//
// A subscribe on a slot that is not KIND_HID_EVENT is WRONG_KIND. A
// subscribe on a slot already subscribed is ALREADY. A subscribe when
// the subscriber table is full is ENOSPC. An unsubscribe on a slot
// nobody subscribed is NOT_SUBSCRIBED.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware / gated:M4)
// =============================================================================
//
//   * NO ENDPOINT ENQUEUE. The subscriber's KIND_HID_EVENT row records
//     an endpoint_channel_key, but this module does not call any IPC
//     enqueue on it. R32.M4 wires the enqueue in the same commit that
//     plumbs the endpoint transport for HID. hid_event_stream_delivered
//     is the honest counter that says "the fanout ran and matched a
//     subscriber; no byte crossed a process boundary".
//
//   * NO PER-SOURCE MONOTONE MERGE. The stream's monotone seq is
//     GLOBAL: two producers publishing simultaneously each consume one
//     number from the same counter. A future refinement that carries
//     a per-transport sequence beside the global one is a §3 payload
//     field, not a change to this module.
//
//   * NO BACKPRESSURE. The scaffold has no ring — it counts and returns.
//     R32.M4 lands the ring, its depth, and the tail-drop counters the
//     ACPI event stream carries (evt_stream.pdx).
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFEB0..0xFFFFFEBF
//
// Disjoint from every other in-tree band. KIND_HID_EVENT owns
// 0xFFFFFE90..9F, KIND_HID_DEVICE owns 0xFFFFFE80..8F, PWM backlight
// 0xFFFFFE90..9F was cleared for HID_EVT before the driver moved.
// 0xFFFFFEB0..0xFFFFFEBF was free.
// =============================================================================

module EventStream = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HID_EVT_STREAM_OK              : u64 = 0
  pub let HID_EVT_STREAM_BAD_SLOT        : u64 = 0xFFFFFEBF
  pub let HID_EVT_STREAM_WRONG_KIND      : u64 = 0xFFFFFEBE
  pub let HID_EVT_STREAM_ALREADY         : u64 = 0xFFFFFEBD
  pub let HID_EVT_STREAM_ENOSPC          : u64 = 0xFFFFFEBC
  pub let HID_EVT_STREAM_NOT_SUBSCRIBED  : u64 = 0xFFFFFEBB
  pub let HID_EVT_STREAM_BAD_TYPE        : u64 = 0xFFFFFEBA

  // Positional "no legal answer" sentinel.
  pub let HID_EVT_STREAM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Geometry.
  //
  // SIXTEEN SUBSCRIBER SLOTS. Twice KIND_HID_EVENT's HID_EVT_MAX (8),
  // because the stream is the FANOUT POINT: a supervisor plus a
  // compositor plus two class-driver monitors plus a keymap translator
  // plus a security auditor is five subscribers; sixteen leaves room
  // for a second WM and per-class monitors that split KEY / POINTER /
  // TOUCH / SENSOR into separate subscribers.
  //
  // Each entry is one u64 — the KIND_HID_EVENT slot. Zero is a valid
  // slot in the cap table, so an empty entry is HID_EVT_STREAM_EMPTY
  // (0xFF, disjoint from every legal slot 0..255).
  // ==========================================================================

  pub let HID_EVT_STREAM_MAX_SUBS : u64 = 16
  pub let HID_EVT_STREAM_EMPTY    : u64 = 0xFF

  // ==========================================================================
  // Storage.
  //
  //   _hid_evt_stream_subs      : 16 KIND_HID_EVENT slots, or EMPTY
  //   _hid_evt_stream_delivered : per-subscriber matched-and-delivered count
  //   _hid_evt_stream_stats     : global counters (see indices below)
  //   _hid_evt_stream_seq       : monotone sequence, advances on every offer
  //
  // Confined to this object by tools/build.sh (§2).
  // ==========================================================================

  pub let mut _hid_evt_stream_subs      : [u64; 16] = uninit @align(64)
  pub let mut _hid_evt_stream_delivered : [u64; 16] = uninit @align(64)
  pub let mut _hid_evt_stream_stats     : [u64; 8]  = uninit @align(64)
  pub let mut _hid_evt_stream_seq       : u64       = 0

  // Stat indices.
  pub let HID_EVT_STREAM_ST_SUBS        : u64 = 0
  pub let HID_EVT_STREAM_ST_UNSUBS      : u64 = 1
  pub let HID_EVT_STREAM_ST_PUBLISHES   : u64 = 2
  pub let HID_EVT_STREAM_ST_UNROUTED    : u64 = 3
  pub let HID_EVT_STREAM_ST_BAD_TYPE    : u64 = 4
  pub let HID_EVT_STREAM_ST_MAX         : u64 = 8

  // ==========================================================================
  // hid_event_stream_reset() -> ()
  //
  // Boot and teardown only. Clears the subscriber table (to EMPTY),
  // the per-subscriber deliveries, the stats, and the seq. Two loops
  // rather than one over the sum, mirroring the reset shape every
  // storage-owning module in this family uses.
  // ==========================================================================

  pub let hid_event_stream_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): clear every subscriber entry (to HID_EVT_STREAM_EMPTY = 0xFF, not 0, because 0 is a legal cap_table slot) and every counter. Boot and teardown only. Three store runs rather than one over the sum: subs and delivered have the same length but different fill values (EMPTY vs 0), and stats has a different length; a single loop would encode adjacency of unrelated arrays as a fact the code depends on. Bounded by immediate compares. Leaf. Labels prefixed hes_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _hid_evt_stream_subs];
        mov rax, 0xFF;
        xor rcx, rcx;
      hes_rs_subs:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  hes_rs_subs;

        lea r10, [rip + _hid_evt_stream_delivered];
        xor rax, rax;
        xor rcx, rcx;
      hes_rs_del:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  hes_rs_del;

        lea r10, [rip + _hid_evt_stream_stats];
        xor rax, rax;
        xor rcx, rcx;
      hes_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hes_rs_stats;

        lea r10, [rip + _hid_evt_stream_seq];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_note(which) -> ()
  // ==========================================================================

  pub let hid_event_stream_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): increment one stats counter; silent no-op on out-of-range. Same shape as hid_event_note, hid_device_note. Every caller inside this module passes a compile-time constant, and the bound is here so the array cannot be walked past if that ever stops being true. Leaf. Labels prefixed hes_nt_.",
      block: {
        cmp rdi, 8;                      // HID_EVT_STREAM_ST_MAX
        jae hes_nt_out;
        lea r10, [rip + _hid_evt_stream_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hes_nt_out:
        ret
      }
    } @no_frame

  pub let hid_event_stream_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): bounds-checked read of one counter. Out of range returns 0. Leaf. Labels prefixed hes_st_.",
      block: {
        cmp rdi, 8;
        jae hes_st_zero;
        lea r10, [rip + _hid_evt_stream_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hes_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hid_event_stream_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): read the monotone offer sequence. Every publish, matched or not, advances it; the read is a plain load so a subscriber joining mid-stream can pin its start without contending with the writer. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_evt_stream_seq];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_find(slot) -> index | HID_EVT_STREAM_EMPTY
  //
  // Linear scan for the entry naming `slot`. Sentinel is 0xFF because
  // every legal index 0..15 is a hit.
  // ==========================================================================

  pub let hid_event_stream_find : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): linear scan of _hid_evt_stream_subs for an entry whose value equals `slot`. Skips entries equal to HID_EVT_STREAM_EMPTY (0xFF) so an empty entry cannot spuriously match a caller who passed 0xFF as a slot (0xFF is not a legal cap_table slot, so this is a defence in depth). Returns the first matching INDEX, or HID_EVT_STREAM_EMPTY if no entry names the slot. Refuses to match on `slot == HID_EVT_STREAM_EMPTY` outright, so the empty sentinel cannot be mistaken for a subscription. Pure leaf. Labels prefixed hes_fd_.",
      block: {
        mov r10, 0xFF;                   // HID_EVT_STREAM_EMPTY
        cmp rdi, r10;
        je  hes_fd_none;
        xor rcx, rcx;
      hes_fd_scan:
        cmp rcx, 16;
        jae hes_fd_none;
        lea r10, [rip + _hid_evt_stream_subs];
        mov rax, [r10 + rcx * 8];
        cmp rax, 0xFF;
        je  hes_fd_next;
        cmp rax, rdi;
        je  hes_fd_hit;
      hes_fd_next:
        add rcx, 1;
        jmp hes_fd_scan;
      hes_fd_hit:
        mov rax, rcx;
        ret;
      hes_fd_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_subscribe(slot) -> HID_EVT_STREAM_OK | code
  //
  // Register a KIND_HID_EVENT slot as an active subscriber. Gates:
  //   (1) slot < 256 -> BAD_SLOT.
  //   (2) hid_event_row_of_slot(slot) != HID_EVT_ROW_NONE -> WRONG_KIND
  //       (the same arity-one gate every kind_hid_event consumer uses).
  //   (3) not already subscribed -> ALREADY.
  //   (4) a free entry exists -> ENOSPC.
  //
  // The slot is stored, the deliveries counter for the entry is set to
  // zero (a re-subscribe after unsubscribe gets a fresh count), and
  // ST_SUBS is bumped.
  // ==========================================================================

  pub let hid_event_stream_subscribe : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-003 (#1127): register a KIND_HID_EVENT slot as a subscriber. Gates, in order: (1) slot < 256 else HID_EVT_STREAM_BAD_SLOT. (2) hid_event_row_of_slot(slot) reachable -- returns HID_EVT_ROW_NONE (0xFF) for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. This is THE ONE ROUTE from a capability slot to a row (cap/kind_hid_event.pdx §hid_event_row_of_slot), so a subscribe that named a KIND_IPC_ENDPOINT or a KIND_BACKLIGHT gets HID_EVT_STREAM_WRONG_KIND. Reusing the existing gate rather than checking the descriptor's kind directly means a future refinement of the arity-one route (say a stricter dead-row check) automatically tightens what this module admits. (3) hid_event_stream_find(slot) must return EMPTY else HID_EVT_STREAM_ALREADY -- a subscriber listed twice would double every delivery it received. (4) an EMPTY entry must exist else HID_EVT_STREAM_ENOSPC. Clears the entry's delivery counter on install so a re-subscribe does not read the previous subscriber's count. Bumps ST_SUBS on success. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed hes_sb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // slot

        // (1) slot bounds.
        mov r10, 256;
        cmp rbx, r10;
        jae hes_sb_bad_slot;

        // (2) valid KIND_HID_EVENT.
        mov rdi, rbx;
        call hid_event_row_of_slot;
        mov r10, 0xFF;                   // HID_EVT_ROW_NONE
        cmp rax, r10;
        je  hes_sb_wrong_kind;

        // (3) not already subscribed.
        mov rdi, rbx;
        call hid_event_stream_find;
        mov r10, 0xFF;
        cmp rax, r10;
        jne hes_sb_already;

        // (4) find an empty entry.
        xor r12, r12;                    // index
      hes_sb_scan:
        cmp r12, 16;
        jae hes_sb_enospc;
        lea r10, [rip + _hid_evt_stream_subs];
        mov rax, [r10 + r12 * 8];
        cmp rax, 0xFF;
        je  hes_sb_claim;
        add r12, 1;
        jmp hes_sb_scan;

      hes_sb_claim:
        lea r10, [rip + _hid_evt_stream_subs];
        mov [r10 + r12 * 8], rbx;        // install slot
        lea r10, [rip + _hid_evt_stream_delivered];
        xor rax, rax;
        mov [r10 + r12 * 8], rax;        // zero the deliveries

        mov rdi, 0;                      // ST_SUBS
        call hid_event_stream_note;

        xor rax, rax;                    // HID_EVT_STREAM_OK
        jmp hes_sb_out;

      hes_sb_bad_slot:
        mov rax, 0xFFFFFEBF;
        jmp hes_sb_out;
      hes_sb_wrong_kind:
        mov rax, 0xFFFFFEBE;
        jmp hes_sb_out;
      hes_sb_already:
        mov rax, 0xFFFFFEBD;
        jmp hes_sb_out;
      hes_sb_enospc:
        mov rax, 0xFFFFFEBC;

      hes_sb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_event_stream_unsubscribe(slot) -> HID_EVT_STREAM_OK | code
  //
  // Reverse of subscribe. Gates:
  //   (1) slot < 256 -> BAD_SLOT.
  //   (2) find(slot) != EMPTY -> NOT_SUBSCRIBED.
  //
  // The entry is cleared to EMPTY; the delivery counter is scrubbed
  // (so a later subscriber on that index gets a clean count). ST_UNSUBS
  // is bumped.
  // ==========================================================================

  pub let hid_event_stream_unsubscribe : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): drop a subscriber. Two gates: (1) slot bounds, (2) hid_event_stream_find must locate the entry. Scrubs both the slot cell AND the delivery counter so a future subscriber landing on the same index cannot inherit the previous subscriber's count -- the same discipline hid_event_tail_free uses on the KIND_HID_EVENT row itself. Bumps ST_UNSUBS on success. This function is REACHABLE INDEPENDENT OF the capability being revoked; a subscription can be dropped from the stream without the capability being torn down. R32.M4's router owner-column sweep will call this on process death. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed hes_ub_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // slot

        mov r10, 256;
        cmp rbx, r10;
        jae hes_ub_bad_slot;

        mov rdi, rbx;
        call hid_event_stream_find;
        mov r10, 0xFF;
        cmp rax, r10;
        je  hes_ub_not_sub;

        mov r12, rax;                    // index

        lea r10, [rip + _hid_evt_stream_subs];
        mov rax, 0xFF;                   // EMPTY
        mov [r10 + r12 * 8], rax;
        lea r10, [rip + _hid_evt_stream_delivered];
        xor rax, rax;
        mov [r10 + r12 * 8], rax;

        mov rdi, 1;                      // ST_UNSUBS
        call hid_event_stream_note;

        xor rax, rax;
        jmp hes_ub_out;

      hes_ub_bad_slot:
        mov rax, 0xFFFFFEBF;
        jmp hes_ub_out;
      hes_ub_not_sub:
        mov rax, 0xFFFFFEBB;

      hes_ub_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_event_stream_sub_count() -> live_count
  //
  // Number of entries currently naming a slot (i.e. not EMPTY).
  // ==========================================================================

  pub let hid_event_stream_sub_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): count live subscriber entries. Linear scan over the fixed-size table. Used by the boot witness to prove subscribe/unsubscribe transitions and by a debug dump. Leaf. Labels prefixed hes_sc_.",
      block: {
        xor rax, rax;                    // count
        xor rcx, rcx;
      hes_sc_scan:
        cmp rcx, 16;
        jae hes_sc_done;
        lea r10, [rip + _hid_evt_stream_subs];
        mov r11, [r10 + rcx * 8];
        cmp r11, 0xFF;
        je  hes_sc_next;
        add rax, 1;
      hes_sc_next:
        add rcx, 1;
        jmp hes_sc_scan;
      hes_sc_done:
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_event_stream_delivered_by(slot) -> count | HID_EVT_STREAM_DECODE_BAD
  //
  // The per-subscriber matched-and-delivered count for one slot.
  // ==========================================================================

  pub let hid_event_stream_delivered_by : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M3-003 (#1127): the per-subscriber delivery count for the entry naming `slot`. This is the honest counter the module maintains in lieu of a real endpoint enqueue (§4): when R32.M4 wires the enqueue, this counter's meaning tightens from 'the fanout matched this subscriber N times' to 'N bytes crossed a process boundary bound for this subscriber', without the signature or the callers changing. Returns HID_EVT_STREAM_DECODE_BAD for a slot no entry names. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed hes_dv_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // slot

        mov rdi, rbx;
        call hid_event_stream_find;
        mov r10, 0xFF;
        cmp rax, r10;
        je  hes_dv_bad;

        mov r12, rax;                    // index

        lea r10, [rip + _hid_evt_stream_delivered];
        mov rax, [r10 + r12 * 8];
        jmp hes_dv_out;

      hes_dv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      hes_dv_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_event_stream_publish(event_type, payload) -> delivered_count | code
  //
  // The producer entry point. `event_type` is EXACTLY ONE of the four
  // HID event class bits from kind_hid_event.pdx (HID_EVT_KEY 0x01,
  // HID_EVT_POINTER 0x02, HID_EVT_TOUCH 0x04, HID_EVT_SENSOR 0x08).
  // Zero, any bit outside MASK_ALL, and any combination of more than one
  // bit are all REFUSED with BAD_TYPE -- an event belongs to exactly
  // one class, and admitting a combined type would let a producer force
  // a delivery into a subscriber that only asked for one of the classes.
  //
  // The payload is opaque to the stream. This module does not decode
  // it -- that is design/ipc/hid-event-stream-session.md's job. The
  // schema's packers/unpackers are what a producer runs before publish
  // and what a subscriber runs on receive; the stream is deliberately
  // schema-agnostic so a schema growth (a new event type, an added
  // field) does not require a stream change.
  //
  // The seq counter advances on EVERY offer, matched or not. Successful
  // matches bump the entry's delivered counter. Returns the number of
  // subscribers matched (0 if none).
  // ==========================================================================

  pub let hid_event_stream_publish : (u64, u64) -> u64 !{mem} @{cap} =
    fn (event_type: u64) (payload: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M3-003 (#1127): publish one event to every subscriber whose mask intersects `event_type`. Gate: event_type is one of HID_EVT_KEY (0x01), HID_EVT_POINTER (0x02), HID_EVT_TOUCH (0x04), HID_EVT_SENSOR (0x08) -- EXACTLY ONE bit set, and the bit within HID_EVT_MASK_ALL. Refuses zero (a publish with no class is a payload nobody could subscribe to). Refuses combined types (e.g. KEY|POINTER = 0x03) because a subscriber that asked only for KEY would see a POINTER byte and count it as a KEY. Refuses bits outside MASK_ALL (e.g. 0x10) because they name a class that does not exist. All three failures land in BAD_TYPE and bump ST_BAD_TYPE. Payload is OPAQUE to the stream (§0); validation is the schema's on both packer and unpacker side. THE SEQ COUNTER ADVANCES ONLY ON A VALID PUBLISH -- refused publishes (BAD_TYPE) do not consume a sequence number, because they never became an offer. Iterates _hid_evt_stream_subs: for each live entry, reads the subscriber's mask through hid_event_mask_of_slot (which returns HID_EVT_DECODE_BAD for a stale entry -- treated as no-match, defence in depth), tests (mask & event_type) != 0, and on a hit bumps the per-entry delivered counter. Returns the match count. A match count of 0 with a well-formed publish is counted as ST_UNROUTED and returned as 0 (not an error -- a stream with no subscribers is not a failure of the producer). ST_PUBLISHES is bumped on every valid publish, regardless of match count. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed hes_pb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // event_type
        mov r12, rsi;                    // payload (opaque -- §0)

        // (1a) event_type non-zero.
        cmp rbx, 0;
        je  hes_pb_bad_type;

        // (1b) event_type within HID_EVT_MASK_ALL (0x0F).
        mov rax, rbx;
        mov r10, 0x0F;
        and rax, r10;
        cmp rax, rbx;
        jne hes_pb_bad_type;

        // (1c) EXACTLY ONE bit set: event_type & (event_type - 1) == 0.
        mov rax, rbx;
        sub rax, 1;
        and rax, rbx;
        cmp rax, 0;
        jne hes_pb_bad_type;

        // Advance seq: this is now an offer.
        lea r10, [rip + _hid_evt_stream_seq];
        mov rax, [r10];
        add rax, 1;
        mov [r10], rax;

        mov rdi, 2;                      // ST_PUBLISHES
        call hid_event_stream_note;

        // Fanout.
        xor r13, r13;                    // matches
        xor r14, r14;                    // index
      hes_pb_scan:
        cmp r14, 16;
        jae hes_pb_done;
        lea r10, [rip + _hid_evt_stream_subs];
        mov r15, [r10 + r14 * 8];        // subscriber slot
        cmp r15, 0xFF;
        je  hes_pb_next;

        // mask = hid_event_mask_of_slot(slot). HID_EVT_DECODE_BAD
        // (all-ones) treated as no-match by the AND with event_type
        // being non-zero but subscriber's real mask needing to also
        // fit within MASK_ALL -- defence in depth is the explicit
        // compare below.
        mov rdi, r15;
        call hid_event_mask_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hes_pb_next;

        // mask & event_type != 0 -> hit.
        and rax, rbx;
        cmp rax, 0;
        je  hes_pb_next;

        lea r10, [rip + _hid_evt_stream_delivered];
        mov rax, [r10 + r14 * 8];
        add rax, 1;
        mov [r10 + r14 * 8], rax;
        add r13, 1;

      hes_pb_next:
        add r14, 1;
        jmp hes_pb_scan;

      hes_pb_done:
        cmp r13, 0;
        jne hes_pb_matched;
        mov rdi, 3;                      // ST_UNROUTED
        call hid_event_stream_note;
      hes_pb_matched:
        mov rax, r13;                    // return match count
        jmp hes_pb_out;

      hes_pb_bad_type:
        mov rdi, 4;                      // ST_BAD_TYPE
        call hid_event_stream_note;
        mov rax, 0xFFFFFEBA;

      hes_pb_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
