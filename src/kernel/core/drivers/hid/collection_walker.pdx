// src/kernel/core/drivers/hid/collection_walker.pdx — R32.M2-003 (#1122)
//
// HID collection walker -- iterates the nested-collection structure the
// report parser lays down in _hid_report_schema. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE READ SIDE OF THE PARSER'S SCHEMA. report_parser.pdx emits
// rows in the exact order the descriptor's item stream visits them, and
// each row carries the collection nesting DEPTH at which it lives (§2 of
// report_parser.pdx). That means the collection structure is not a
// separate tree the walker has to rebuild -- it is already the schema
// in-order-traversal. This module gives that traversal a callback-driven
// shape and exposes the collection-level projections the HID class
// driver in R32.M3 will need to route reports to the right handler.
//
// Callback contract (SysV, 6 register args):
//
//   cb(row_idx: u64,       // rdi -- 0-based schema row index
//      kind: u64,          // rsi -- HID_RP_KIND_INPUT/OUTPUT/FEATURE/
//                          //        COLL_BEGIN/COLL_END
//      depth: u64,         // rdx -- collection nesting depth at emission
//      aux: u64,           // rcx -- item flags / collection type
//      usage_page: u64,    // r8  -- current usage page at emission
//      usage_id: u64)      // r9  -- local Usage at emission (0 if unset)
//     -> unit
//
// A callback that clobbers rbx/r12..r15 breaks the walk (paideia-as
// register-allocates those across the loop, matching the vops dispatch
// contract). §4 documents the same rule the vops dispatcher documents.
//
// IT IS NOT A LIVE DECISION POINT. Same discipline as quirks.pdx §0,
// usage.pdx §0 and report_parser.pdx §5: no consumer keys off the walk
// today. The pin `hid_collection_walker_consumed() == 0` -- an
// assertion that FAILS the moment R32.M3 wires the class driver -- forces
// the module header to be rewritten with the live consumer's shape.
//
// =============================================================================
// §1  READ-ONLY VIEW OF THE PARSER'S SCHEMA
// =============================================================================
//
// This module NEVER writes _hid_report_schema, _hid_report_count or
// _hid_report_valid. tools/build.sh confines those to report_parser.o.
// A stray write from this module would let a walker mutate the schema
// under a consumer that is walking it -- exactly the failure mode §3 of
// report_parser.pdx exists to prevent.
//
// The walker's own state is one honesty-pin counter, confined to this
// object.
//
// =============================================================================
// §2  DEPTH SEMANTICS -- MATCHING BEGIN/END BY DEPTH
// =============================================================================
//
// The parser's depth convention (report_parser.pdx §2):
//
//   COLL_BEGIN emitted at depth D; then depth becomes D+1
//   COLL_END emitted at depth D after the counter decremented FROM D+1
//   INPUT/OUTPUT/FEATURE emitted at whatever depth the counter holds
//
// Under this convention BEGIN and its matching END emit at the SAME
// depth. hid_collection_type_at / hid_collection_depth_at index into
// the COLL_BEGIN rows only (in order of emission); a consumer that
// wants to pair a specific BEGIN with its END walks the schema forward
// from the BEGIN until it finds a COLL_END at the same depth. That
// pairing loop is not in this module -- the class driver will emit its
// own dispatch and there is nothing this module could offer beyond the
// primitives.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// idx >= collection_count -> HID_CW_BAD_IDX (accessors).
// Walking an invalid or empty schema -> returns 0 rows walked and does
// NOT invoke cb (the callback would receive fabricated zeros).
//
// =============================================================================
// §4  CALLBACK REGISTER CONTRACT
// =============================================================================
//
// The walker preserves rbx, r12, r13, r14, r15 across the whole walk
// (5-push prologue). The callback runs at each row with:
//
//   rbx = current schema row index (mirrored into rdi as cb arg)
//   r14 = &_hid_report_schema (constant)
//   r15 = count of rows to visit (constant)
//   r12 = current row base pointer
//
// If the callback clobbers rbx/r12/r14/r15 the loop bounds go wrong. The
// vops dispatcher documents the same rule (core/fs/vops.pdx line 47);
// this module inherits it verbatim. The callback may freely use r8/r9/
// r10/r11 and the SysV volatile-arg registers -- the loop reloads them
// on each iteration from the row storage.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC10..0xFFFFFC1F
// =============================================================================

module CollectionWalker = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HID_CW_OK      : u64 = 0
  pub let HID_CW_BAD_IDX : u64 = 0xFFFFFC10

  // ==========================================================================
  // Honesty pin. 0 until R32.M3 wires the class driver.
  // ==========================================================================

  pub let mut _hid_collection_walker_consumers : u64 = 0

  pub let hid_collection_walker_consumed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-003 (#1122): honesty pin -- 0 while no class driver walks the schema for real. Boot witness asserts 0; a live consumer flips it and the assertion fails, forcing the doc to be rewritten. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hid_collection_walker_consumers];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hid_collection_count() -> number of COLL_BEGIN rows in the schema
  // ==========================================================================

  pub let hid_collection_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-003 (#1122): count schema rows with kind == HID_RP_KIND_COLL_BEGIN (4). Walks _hid_report_schema linearly using _hid_report_count as the bound. Reads _hid_report_schema (owned by report_parser.o) but does NOT write it (§1). Uses r10/rax/rcx across the loop; leaf, no callee-save preserved beyond SysV defaults. Labels prefixed hid_cw_cc_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // r13 = count (upper bound), r14 unused, r12 = current index,
        // rbx = accumulator.
        lea r10, [rip + _hid_report_count];
        mov r13, [r10];
        xor rbx, rbx;                     // accumulator
        xor r12, r12;                     // index

      hid_cw_cc_top:
        cmp r12, r13;
        jae hid_cw_cc_done;
        mov rax, r12;
        shl rax, 6;                       // *64
        lea r10, [rip + _hid_report_schema];
        add rax, r10;
        mov rax, [rax + 0];               // kind
        cmp rax, 4;                       // HID_RP_KIND_COLL_BEGIN
        jne hid_cw_cc_next;
        add rbx, 1;
      hid_cw_cc_next:
        add r12, 1;
        jmp hid_cw_cc_top;

      hid_cw_cc_done:
        mov rax, rbx;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_collection_max_depth() -> max depth observed
  //
  // Walks the schema and returns the largest depth value stored in any
  // row (whether COLL_BEGIN or INPUT/OUTPUT/FEATURE). Returns 0 for an
  // empty or field-free schema.
  // ==========================================================================

  pub let hid_collection_max_depth : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-003 (#1122): return max row.depth across the schema (0 if count == 0). Uses rbx=max, r12=index, r13=count; three-push prologue. Reads _hid_report_schema; never writes. Labels prefixed hid_cw_md_.",
      block: {
        push rbx;
        push r12;
        push r13;

        lea r10, [rip + _hid_report_count];
        mov r13, [r10];
        xor rbx, rbx;                     // max
        xor r12, r12;                     // index

      hid_cw_md_top:
        cmp r12, r13;
        jae hid_cw_md_done;
        mov rax, r12;
        shl rax, 6;
        lea r10, [rip + _hid_report_schema];
        add rax, r10;
        mov rax, [rax + 56];              // depth
        cmp rax, rbx;
        jbe hid_cw_md_next;
        mov rbx, rax;
      hid_cw_md_next:
        add r12, 1;
        jmp hid_cw_md_top;

      hid_cw_md_done:
        mov rax, rbx;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_collection_type_at(idx) -> collection type of the idx-th
  // COLL_BEGIN row (in order of emission).
  //
  // idx is 0-based over BEGIN rows, not schema row indices. A schema
  // with three COLL_BEGIN rows has valid idx in {0, 1, 2}.
  // ==========================================================================

  pub let hid_collection_type_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-003 (#1122): idx-th COLL_BEGIN row's collection type (row.aux). Refuses out-of-range idx with HID_CW_BAD_IDX. Walks the schema counting BEGIN rows until it hits the idx-th; a scaffold-scale linear scan is right for the touchpad-sized schemas the parser produces (a real class driver may build a small array of BEGIN row pointers if the walk becomes hot). Uses rbx=target idx, r12=schema index, r13=count, r14=matches seen; four-push prologue. Labels prefixed hid_cw_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                     // target idx
        lea r10, [rip + _hid_report_count];
        mov r13, [r10];
        xor r12, r12;                     // schema idx
        xor r14, r14;                     // begins seen

      hid_cw_ta_top:
        cmp r12, r13;
        jae hid_cw_ta_oob;
        mov rax, r12;
        shl rax, 6;
        lea r10, [rip + _hid_report_schema];
        add rax, r10;
        mov rcx, [rax + 0];               // kind
        cmp rcx, 4;
        jne hid_cw_ta_next;
        // BEGIN row.
        cmp r14, rbx;
        je  hid_cw_ta_hit;
        add r14, 1;
      hid_cw_ta_next:
        add r12, 1;
        jmp hid_cw_ta_top;

      hid_cw_ta_hit:
        mov rax, [rax + 8];               // aux = coll_type
        jmp hid_cw_ta_out;

      hid_cw_ta_oob:
        mov rax, 0xFFFFFC10;              // BAD_IDX

      hid_cw_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_collection_depth_at(idx) -> nesting depth of the idx-th
  // COLL_BEGIN row (in order of emission).
  // ==========================================================================

  pub let hid_collection_depth_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-003 (#1122): idx-th COLL_BEGIN row's nesting depth (row.depth). Same walk shape as type_at; the two accessors are separate rather than a single (type, depth)-returning fn because u64 return is one value and packing would let a caller misread the depth as a type. Refuses OOB with HID_CW_BAD_IDX. Labels prefixed hid_cw_da_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;
        lea r10, [rip + _hid_report_count];
        mov r13, [r10];
        xor r12, r12;
        xor r14, r14;

      hid_cw_da_top:
        cmp r12, r13;
        jae hid_cw_da_oob;
        mov rax, r12;
        shl rax, 6;
        lea r10, [rip + _hid_report_schema];
        add rax, r10;
        mov rcx, [rax + 0];
        cmp rcx, 4;
        jne hid_cw_da_next;
        cmp r14, rbx;
        je  hid_cw_da_hit;
        add r14, 1;
      hid_cw_da_next:
        add r12, 1;
        jmp hid_cw_da_top;

      hid_cw_da_hit:
        mov rax, [rax + 56];              // depth
        jmp hid_cw_da_out;

      hid_cw_da_oob:
        mov rax, 0xFFFFFC10;

      hid_cw_da_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_collection_walk(cb) -> rows visited
  //
  // Iterates every schema row in order and invokes cb(row_idx, kind,
  // depth, aux, usage_page, usage_id). Returns the number of callbacks
  // dispatched. Refuses to invoke cb if the schema is invalid or empty
  // (returns 0 in either case -- a caller can gate on the return to
  // distinguish "no rows to walk" from "we walked and cb was called").
  //
  // cb is passed in rdi. The dispatch shape is `call rax`, matching the
  // vops.pdx and xsdt.pdx precedent. Callback contract: preserve
  // rbx/r12/r13/r14/r15; free use of rax/rcx/rdx/rsi/rdi/r8/r9/r10/r11.
  // ==========================================================================

  pub let hid_collection_walk : (u64) -> u64 !{mem} @{} =
    fn (cb: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M2-003 (#1122): callback-driven walk of the schema. Register plan: r15 = cb function pointer (saved across nested call), r14 = schema base, r13 = count, r12 = current row base, rbx = row idx. Five-push prologue: entry rsp%16 == 8, +5 pushes -> rsp%16 == 0, then `sub rsp, 8` before each `call rax` and `add rsp, 8` after, delivering rsp%16 == 8 at cb entry per the SysV ABI (same discipline as the vops dispatcher in core/fs/vops.pdx). Gates on _hid_report_valid: an invalid schema returns 0 without invoking cb, so a caller cannot receive fabricated zeros for rows the parser never wrote. Reads _hid_report_schema/_valid/_count; never writes them. Labels prefixed hid_cw_wk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r15, rdi;                     // cb pointer

        // Refuse invalid schema.
        lea r10, [rip + _hid_report_valid];
        mov rax, [r10];
        cmp rax, 0;
        je  hid_cw_wk_none;

        lea r10, [rip + _hid_report_count];
        mov r13, [r10];
        cmp r13, 0;
        je  hid_cw_wk_none;

        lea r14, [rip + _hid_report_schema];
        xor rbx, rbx;                     // idx

      hid_cw_wk_top:
        cmp rbx, r13;
        jae hid_cw_wk_done;

        mov rax, rbx;
        shl rax, 6;
        add rax, r14;
        mov r12, rax;                     // row base

        // Marshal 6 SysV args.
        mov rdi, rbx;                     // row_idx
        mov rsi, [r12 + 0];               // kind
        mov rdx, [r12 + 56];              // depth
        mov rcx, [r12 + 8];               // aux
        mov r8,  [r12 + 16];              // usage_page
        mov r9,  [r12 + 24];              // usage_id

        // Dispatch: `call r15`. rsp%16 == 0 pre-call (5 pushes atop entry
        // rsp%16 == 8); a bare `call r15` would deliver rsp%16 == 8 to
        // the callee, which is exactly the SysV requirement -- no pad
        // needed. See vops.pdx for the mirror-image case where entry
        // rsp%16 == 8 needed a pad.
        mov rax, r15;
        call rax;

        add rbx, 1;
        jmp hid_cw_wk_top;

      hid_cw_wk_done:
        mov rax, rbx;                     // rows visited
        jmp hid_cw_wk_out;

      hid_cw_wk_none:
        xor rax, rax;

      hid_cw_wk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
