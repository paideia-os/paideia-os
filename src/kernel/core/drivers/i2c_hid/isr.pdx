// src/kernel/core/drivers/i2c_hid/isr.pdx — R32.M1-003 (#1117)
//
// The interrupt handler stub for HID-over-I²C: when the device asserts
// its interrupt line, the host reads the input report from the register
// enumerated in the HID descriptor. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE ISR STUB for a HID-over-I²C device. In the Microsoft spec
// §7, the sequence on a device-asserted interrupt is:
//
//   1. Device pulls IRQ line low (edge trigger).
//   2. GPIO controller latches the edge (R30.M6 path) and dispatches
//      to the subscriber this ISR registers.
//   3. Host reads the input register (i2c_hid_descriptor_input_reg()),
//      which returns a 2-byte length followed by up to
//      i2c_hid_descriptor_max_input() bytes of report data.
//   4. The report is dispatched to the HID class driver (R32.M3).
//
// IT IS NOT A LIVE ISR. Same discipline as transport.pdx §4:
//
//   * The GPIO line the touchpad uses is described by ACPI's
//     _CRS/GpioInt block, and the KIND_GPIO_LINE cap slot that names
//     it is not bound to this ISR in this milestone. Arity of
//     i2c_hid_isr_bind is ZERO for this reason (a caller-supplied
//     line number would let the ISR subscribe to a pad no capability
//     named -- exactly what §2 of gpio_pad.pdx exists to prevent).
//
//   * The input-report read is deferred: i2c_hid_isr_assert calls
//     the transport's read seam, which returns DEFERRED_HARDWARE, and
//     the ISR propagates the sentinel to its counter. A live ISR
//     dispatches the read to a bottom-half handler on a work-queue
//     endpoint; that endpoint does not exist yet.
//
//   * arbitrated() returns 0. When the R30.M6 pad-driver edge
//     subscription is wired to this ISR through KIND_HW_INTERRUPT,
//     the pin fails and the design doc gets rewritten in the same
//     commit -- same device as ec_access.pdx (#1580).
//
// =============================================================================
// §1  ONE WRITER OF THE BOUND FLAG
// =============================================================================
//
// Same discipline as transport.pdx §2: exactly one writer of
// `_i2c_hid_isr_bound`. tools/build.sh confines
// `_i2c_hid_isr_bound` and `_i2c_hid_isr_stats` to this object.
//
// =============================================================================
// §2  REFUSE, NEVER CLAMP
// =============================================================================
//
// Assert before bind -> NOT_BOUND (and counted; an unbound ISR that
// silently absorbed asserts would hide a lost first report every time
// the R30.M6 subscription raced this bind). Assert without a valid
// descriptor -> NO_DESC (the ISR cannot read the input register
// because it does not know which register that is; refused, not
// papered over with a default). Bind on top of a bound ISR -> REBIND
// (the ISR is a LATCH; changing the subscription mid-flight would
// leave an unclaimed edge on the pad the previous subscription named).
//
// =============================================================================
// §3  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL SUBSCRIPTION to a GPIO edge. gpio_pad_edge_subscribe
//     wires an edge to a subscriber id; this ISR does not call it.
//     R32.M2 wires the KIND_GPIO_LINE cap through this bind.
//
//   * NO BOTTOM-HALF DISPATCH. The input-report bytes have nowhere
//     to go -- the HID class driver's endpoint does not exist yet.
//     R32.M3 delivers KIND_HID_EVENT.
//
//   * NO ARBITRATION. Same pin as transport_arbitrated().
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFED0..0xFFFFFEDF
// =============================================================================

module Isr = structure {

  // ==========================================================================
  // §4 return codes.
  // ==========================================================================

  pub let I2C_HID_ISR_OK                : u64 = 0
  pub let I2C_HID_ISR_NOT_BOUND         : u64 = 0xFFFFFEDF
  pub let I2C_HID_ISR_NO_DESC           : u64 = 0xFFFFFEDE
  pub let I2C_HID_ISR_REBIND            : u64 = 0xFFFFFEDD
  pub let I2C_HID_ISR_DEFERRED_HARDWARE : u64 = 0xFFFFFEDC

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _i2c_hid_isr_bound : u64 = 0
  pub let mut _i2c_hid_isr_stats : [u64; 8] = uninit @align(64)

  pub let I2C_HID_ISR_ST_BINDS     : u64 = 0
  pub let I2C_HID_ISR_ST_ASSERTS   : u64 = 1
  pub let I2C_HID_ISR_ST_NOT_BOUND : u64 = 2
  pub let I2C_HID_ISR_ST_NO_DESC   : u64 = 3
  pub let I2C_HID_ISR_ST_REBIND    : u64 = 4
  pub let I2C_HID_ISR_ST_MAX       : u64 = 8

  // ==========================================================================
  // i2c_hid_isr_bind() -> OK | REBIND
  //
  // ARITY ZERO: the subscription binds to the GPIO line NAMED by the
  // capability the caller must already hold; a caller-supplied line
  // would let the ISR subscribe to a pad no capability named. This
  // milestone stops at flipping the bound flag.
  // ==========================================================================

  pub let i2c_hid_isr_bind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-003 (#1117): mark the I²C-HID ISR bound. Refuses a second bind with REBIND (the ISR is a LATCH: rebinding mid-flight would leave an unclaimed edge on the pad the previous subscription named). ARITY ZERO for the reason gpio_pad_edge_subscribe pins its subscription arity: a caller-supplied line number would let the ISR subscribe to a pad no capability named. Increments _i2c_hid_isr_stats[0]. Leaf. Labels prefixed i2chid_isr_bd_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _i2c_hid_isr_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne i2chid_isr_bd_rebind;

        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _i2c_hid_isr_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // OK
        ret;

      i2chid_isr_bd_rebind:
        lea r10, [rip + _i2c_hid_isr_stats];
        mov rax, [r10 + 32];             // slot 4 = REBIND
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFEDD;             // REBIND
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_isr_bound() -> 1 | 0
  // ==========================================================================

  pub let i2c_hid_isr_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-003 (#1117): 1 once i2c_hid_isr_bind has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_isr_bound];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_isr_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as transport_arbitrated.
  // ==========================================================================

  pub let i2c_hid_isr_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M1-003 (#1117): report whether the ISR is subscribed to a real GPIO edge. IT RETURNS 0, because no gpio_pad_edge_subscribe call runs in this tree. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_isr_assert() -> code
  //
  // Called when the device pulls its IRQ line. Reads the input register
  // via the transport (which returns DEFERRED_HARDWARE today). Requires
  // ISR bound AND a valid descriptor (else NO_DESC, because the input
  // register index is enumerated FROM the descriptor).
  // ==========================================================================

  pub let i2c_hid_isr_assert : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-003 (#1117): the input-report read seam. Gates, in order: (1) ISR bound, else NOT_BOUND (an unbound ISR that silently absorbed asserts would hide a lost first report on any subscription race); (2) descriptor valid, else NO_DESC (the ISR cannot read the input register because it does not know which register that is -- refused, not defaulted); (3) read max_input bytes at input_reg via the transport, whose return is propagated. Counts the assert in stats[1] on the happy path. Uses r12 for the saved reg-index and transport return; push/pop preserves the callee-saved register across nested calls. Reserved labels: none.",
      block: {
        push rbp;
        push r12;

        // (1) ISR bound?
        lea r10, [rip + _i2c_hid_isr_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  i2chid_isr_as_not_bound;

        // (2) descriptor valid?
        call i2c_hid_descriptor_valid;
        cmp rax, 0;
        je  i2chid_isr_as_no_desc;

        // Read the input register.
        call i2c_hid_descriptor_input_reg;
        mov r12, rax;                    // save reg
        call i2c_hid_descriptor_max_input;
        mov rsi, rax;                    // want_len = max_input
        mov rdi, r12;                    // reg
        call i2c_hid_transport_read;
        mov r12, rax;                    // save return

        // Count the assert.
        lea r10, [rip + _i2c_hid_isr_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;

        mov rax, r12;
        pop r12;
        pop rbp;
        ret;

      i2chid_isr_as_not_bound:
        lea r10, [rip + _i2c_hid_isr_stats];
        mov rax, [r10 + 16];             // slot 2 = NOT_BOUND
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFEDF;             // NOT_BOUND
        pop r12;
        pop rbp;
        ret;

      i2chid_isr_as_no_desc:
        lea r10, [rip + _i2c_hid_isr_stats];
        mov rax, [r10 + 24];             // slot 3 = NO_DESC
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFEDE;             // NO_DESC
        pop r12;
        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_isr_asserts() -> count
  // ==========================================================================

  pub let i2c_hid_isr_asserts : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-003 (#1117): count of ISR asserts that reached the transport (deferred-hardware outcomes). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_isr_stats];
        mov rax, [r10 + 8];
        ret
      }
    }
}
