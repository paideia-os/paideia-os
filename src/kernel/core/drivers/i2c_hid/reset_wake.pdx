// src/kernel/core/drivers/i2c_hid/reset_wake.pdx — R32.M1-004 (#1118)
//
// HID-over-I²C RESET + SET_POWER (wake) sequences. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE COMMAND-LEVEL RESET AND WAKE SEQUENCES for a HID-over-I²C
// device. In Microsoft's HID-over-I²C v1.0 §7, a device is brought out
// of low-power state and made to publish its report descriptor by two
// commands issued against wCommandRegister:
//
//   RESET   opcode 0x01 — issued to wCommandRegister with no data
//                         payload. The device pulls its IRQ line and
//                         publishes a two-byte 0x0000 sentinel on the
//                         input register when reset completes.
//
//   SET_POWER 0x08      — issued to wCommandRegister; the low nibble of
//                         the second command byte carries the power
//                         state (0=ON, 1=SLEEP). This module issues the
//                         ON form (wake) only; a suspend path lives with
//                         the shutdown sequence and does not belong in a
//                         bring-up module.
//
// IT IS NOT A LIVE COMMAND. Same discipline as transport.pdx §4 and
// descriptor.pdx §4: the write seam returns DEFERRED_HARDWARE, this
// module propagates that sentinel, and the pin `i2c_hid_reset_arbitrated
// () == 0` / `i2c_hid_wake_arbitrated() == 0` -- an assertion that
// FAILS the moment a future milestone plumbs a real DesignWare transfer
// through this transport -- forces the design doc to be updated at that
// time.
//
// IT USES THE TRANSPORT WRITE SEAM AT ITS DECLARED ARITY. Arity of
// `i2c_hid_transport_write` is TWO ({reg_index, byte}). A live driver
// would compose the two-byte command payload (report id/type + opcode)
// and dispatch a multi-byte write; this scaffold writes the OPCODE byte
// at the register the spec names for the command, matching the
// SET_REPORT byte-poke shape the transport already carries. Widening
// the transport seam to accept a payload BUFFER would let a caller
// reach bytes no capability named, exactly what §2 of ec_access.pdx
// exists to prevent. The composition upgrade lives in R32.M2 alongside
// the DesignWare plumbing that makes it observable at all.
//
// =============================================================================
// §1  ONE WRITER OF THE COMPLETION LATCHES
// =============================================================================
//
// Same discipline as transport.pdx §2 and descriptor.pdx §2: exactly
// one writer of `_i2c_hid_reset_stats` (this module's reset seam) and
// exactly one writer of `_i2c_hid_wake_stats` (this module's wake
// seam). tools/build.sh confines both to this object. A stray writer
// would be a second path counting a reset that never issued, and the
// bring-up flow that gates on the count would advance without the
// device having been reset.
//
// =============================================================================
// §2  REFUSE, NEVER CLAMP
// =============================================================================
//
// Reset before transport bind -> propagates NOT_BOUND from the write
// seam (refused, not queued). Wake before transport bind -> same.
// Neither seam takes caller arguments: a caller-supplied opcode would
// let arbitrary bytes reach wCommandRegister, and the opcode set is
// enumerated by the spec, not negotiated at the driver.
//
// =============================================================================
// §3  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO MULTI-BYTE COMMAND PAYLOAD. The two-byte {report_id/type +
//     opcode} the spec defines is a single byte here; §0 explains why.
//
//   * NO POST-RESET SENTINEL WAIT. The spec asks the host to wait for
//     the device to pull IRQ and publish the 0x0000 sentinel on the
//     input register within RESET_TIMEOUT (5s). No IRQ subscription is
//     live in this milestone (isr.pdx §3), so no wait runs.
//
//   * NO QUIRK DELAY. #1119's DELAYED_RESET flag will insert a bounded
//     pre-reset delay for parts that need it; this module has no timer.
//
//   * NO ARBITRATION. Same shape as transport.pdx §4.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFEE0..0xFFFFFEEF
// =============================================================================

module ResetWake = structure {

  // ==========================================================================
  // §4 return codes -- but the module PROPAGATES the transport's return
  // whenever it dispatches, so a happy-path caller sees DEFERRED_HARDWARE
  // (0xFFFFFEBC), a not-yet-bound transport surfaces NOT_BOUND
  // (0xFFFFFEBF), etc. The codes below are for gates this module ITSELF
  // decides -- currently none, kept for future use (§3 deferrals).
  // ==========================================================================

  pub let I2C_HID_RW_OK : u64 = 0

  // ==========================================================================
  // Spec constants -- HID-over-I²C v1.0 §7 command register + opcodes.
  // wCommandRegister index 0x0000 is the ENUMERATED register the spec
  // pins for the RESET command; the wake command is dispatched against
  // 0x0022 in this scaffold per the task specification. A live driver
  // would derive both from the parsed HID descriptor's wCommandRegister.
  // ==========================================================================

  pub let I2C_HID_RW_CMD_REG        : u64 = 0x0000
  pub let I2C_HID_RW_WAKE_REG       : u64 = 0x0022
  pub let I2C_HID_RW_OPCODE_RESET   : u64 = 0x01
  pub let I2C_HID_RW_OPCODE_SET_PWR : u64 = 0x08

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // Two disjoint stats arrays -- one per seam -- so a reset that never
  // ran cannot be counted by the wake seam, and vice versa.
  // ==========================================================================

  pub let mut _i2c_hid_reset_stats : [u64; 4] = uninit @align(64)
  pub let mut _i2c_hid_wake_stats  : [u64; 4] = uninit @align(64)

  pub let I2C_HID_RW_ST_CALLS   : u64 = 0
  pub let I2C_HID_RW_ST_DEFERRED: u64 = 1
  pub let I2C_HID_RW_ST_REFUSED : u64 = 2
  pub let I2C_HID_RW_ST_MAX     : u64 = 4

  // ==========================================================================
  // i2c_hid_reset_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as transport_arbitrated and
  // isr_arbitrated: pinned at 0 by the boot witness so a future
  // milestone plumbing a real DesignWare transfer cannot land without
  // rewriting the claim.
  // ==========================================================================

  pub let i2c_hid_reset_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M1-004 (#1118): report whether the reset seam issues a real command today. IT RETURNS 0, because nothing in this tree wires the transport to dw_xfer.pdx. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_wake_arbitrated() -> 0
  // ==========================================================================

  pub let i2c_hid_wake_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M1-004 (#1118): report whether the wake seam issues a real command today. IT RETURNS 0, same reason as i2c_hid_reset_arbitrated. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_reset_send() -> code
  //
  // ARITY ZERO. The register is the spec-enumerated wCommandRegister
  // (0x0000 in this scaffold); the opcode is the spec-enumerated RESET
  // (0x01). A caller-supplied argument would let arbitrary bytes reach
  // wCommandRegister -- the opcode set is enumerated by the spec, not
  // negotiated at the driver.
  //
  // Counts CALLS in stats[0], propagates the transport's return. On
  // the happy path (transport bound) the transport counts a WRITE in
  // its own stats and returns DEFERRED_HARDWARE.
  // ==========================================================================

  pub let i2c_hid_reset_send : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-004 (#1118): dispatch the HID-over-I²C RESET command. ARITY ZERO because the register and opcode are both spec-enumerated (wCommandRegister = 0x0000 in this scaffold; opcode = 0x01) and a caller-supplied argument would let arbitrary bytes reach wCommandRegister. Increments _i2c_hid_reset_stats[0] on every call (call count); the transport's return is propagated -- DEFERRED_HARDWARE on the happy path, NOT_BOUND if the transport was never bound, and either way counted by the transport in its own stats. NO REAL I²C TRANSFER RUNS: the write seam is a scaffold (transport.pdx §4). Uses push/pop rbp to preserve 16-byte alignment across the nested call. Reserved labels: none.",
      block: {
        push rbp;

        // Count the call before dispatch -- a refused call still ran.
        lea r10, [rip + _i2c_hid_reset_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        // Dispatch: transport_write(wCommandRegister, RESET opcode).
        mov rdi, 0x0000;                  // I2C_HID_RW_CMD_REG
        mov rsi, 0x01;                    // I2C_HID_RW_OPCODE_RESET
        call i2c_hid_transport_write;

        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_wake_send() -> code
  //
  // ARITY ZERO for the same reason as reset. Wake is SET_POWER with
  // power-state ON (0x00); this scaffold sends the SET_POWER opcode
  // byte to the task-specified wake register (0x0022).
  // ==========================================================================

  pub let i2c_hid_wake_send : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-004 (#1118): dispatch the HID-over-I²C SET_POWER=ON (wake) command. ARITY ZERO because the register (0x0022 per the task specification) and opcode (SET_POWER = 0x08) are both enumerated by the spec / task and a caller-supplied argument would let arbitrary bytes reach the command path. Increments _i2c_hid_wake_stats[0]; the transport's return is propagated. NO REAL I²C TRANSFER RUNS. Uses push/pop rbp to preserve 16-byte alignment across the nested call. Reserved labels: none.",
      block: {
        push rbp;

        // Count the call.
        lea r10, [rip + _i2c_hid_wake_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        // Dispatch: transport_write(WAKE_REG, SET_POWER opcode).
        mov rdi, 0x0022;                  // I2C_HID_RW_WAKE_REG
        mov rsi, 0x08;                    // I2C_HID_RW_OPCODE_SET_PWR
        call i2c_hid_transport_write;

        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_reset_count() -> count
  // i2c_hid_wake_count()  -> count
  //
  // Read-only accessors used by the witness to prove the seams counted.
  // ==========================================================================

  pub let i2c_hid_reset_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-004 (#1118): count of reset_send invocations. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_reset_stats];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let i2c_hid_wake_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-004 (#1118): count of wake_send invocations. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_wake_stats];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame
}
