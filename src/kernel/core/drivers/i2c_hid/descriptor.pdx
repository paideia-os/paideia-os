// src/kernel/core/drivers/i2c_hid/descriptor.pdx — R32.M1-002 (#1116)
//
// GET_HID_DESCRIPTOR command + the parsed HID descriptor structure.
// SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE PARSED HID-OVER-I²C DESCRIPTOR, and the sequence that
// fetches it. The Microsoft HID-over-I²C spec §5.1 defines a 30-byte
// structure at the ACPI-supplied HidDescRegister (little-endian):
//
//   0x00 (u16)  wHIDDescLength    total length (0x001E for v1.0)
//   0x02 (u16)  bcdVersion        BCD spec revision (0x0100)
//   0x04 (u16)  wReportDescLength length of the HID report descriptor
//   0x06 (u16)  wReportDescRegister
//   0x08 (u16)  wInputRegister    input-report register (ISR reads this)
//   0x0A (u16)  wMaxInputLength   maximum input-report length
//   0x0C (u16)  wOutputRegister
//   0x0E (u16)  wMaxOutputLength
//   0x10 (u16)  wCommandRegister
//   0x12 (u16)  wDataRegister
//   0x14 (u16)  wVendorID
//   0x16 (u16)  wProductID
//   0x18 (u16)  wVersionID
//   0x1A (u32)  reserved  MUST be zero
//
// The fetch is a two-step operation on the transport: write the two-
// byte HidDescRegister index, then read 30 bytes.
//
// IT IS NOT A LIVE FETCH. Same discipline as transport.pdx §4: the
// fetch calls i2c_hid_transport_read, which returns DEFERRED_HARDWARE
// today. The fetch propagates that sentinel. When R32.M2 wires the
// transport to dw_xfer.pdx, the same seam parses the returned bytes
// and installs the parsed structure via i2c_hid_descriptor_install.
//
// FOR TESTING AND SYNTH-WITNESS PURPOSES, i2c_hid_descriptor_install
// is exposed with arity FOUR ({report_desc_len, input_reg, max_input,
// vendor_product}) and validates each field against the HID-over-I²C
// spec. This is the same seam a live parser will call once dw_xfer.pdx
// returns the 30-byte descriptor bytes.
//
// =============================================================================
// §1  FIELDS THIS MODULE STORES
// =============================================================================
//
// The four fields the higher-level HID class driver actually consumes:
//
//   report_desc_len   — length of the report descriptor (needed to
//                       allocate the buffer that fetches it).
//   input_reg         — the register the ISR reads on line assertion
//                       (isr.pdx consumes this).
//   max_input_len     — the ceiling the ISR must honour (a longer read
//                       than this is refused rather than truncated).
//   vendor_product    — packed 32-bit (vendor << 16 | product) for the
//                       quirk-table lookup that #1119 will wire.
//
// The remaining fields (wHIDDescLength, bcdVersion, wOutputRegister,
// wMaxOutputLength, wCommandRegister, wDataRegister, wVersionID) are
// PARSED by a live driver but not stored here today: they either
// belong to the transport (command/data are its territory) or to the
// output-report path that #1117 does not exercise.
//
// =============================================================================
// §2  ONE WRITER OF THE VALID FLAG
// =============================================================================
//
// Same discipline as transport.pdx §2: exactly one writer of
// `_i2c_hid_desc_valid`. i2c_hid_descriptor_install is the writer.
// A second writer would be a second path claiming the descriptor was
// parsed without a fetch: when the quirk table (#1119) keys off
// (vendor, product) to reset the device, a spuriously-set valid flag
// would let the quirk lookup run against zeroed identifiers and
// misclassify the device. tools/build.sh confines
// `_i2c_hid_desc_valid`, `_i2c_hid_desc_report_len`,
// `_i2c_hid_desc_input_reg`, `_i2c_hid_desc_max_input` and
// `_i2c_hid_desc_vendor_product` to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// report_desc_len == 0 -> BAD_DESC (a HID device with no report
// descriptor is malformed; the spec disallows it). report_desc_len >
// 4096 -> BAD_DESC (the spec §5.1 gives an upper bound of ~4KiB on
// realistic report descriptors; refused, not truncated, because a
// larger claim is more likely a parsing error than a real device).
// input_reg outside 16 bits -> BAD_DESC. max_input_len == 0 or > 4096
// -> BAD_DESC. Second install -> REBIND (a descriptor is a LATCH once
// installed).
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL FETCH. i2c_hid_descriptor_fetch calls the transport's
//     read seam, which returns DEFERRED_HARDWARE, and the fetch
//     propagates the sentinel WITHOUT calling install. R32.M2 wires
//     the transport, at which point the fetch parses the returned
//     30 bytes and calls install itself.
//
//   * NO REPORT DESCRIPTOR CACHE. The HID report descriptor is a
//     separate, larger fetch keyed off wReportDescRegister; the HID
//     class driver (R32.M3) owns that cache.
//
//   * NO VERSION MISMATCH LOGIC. A live parser would refuse a
//     bcdVersion outside 0x0100..0x0101; the version field is not
//     stored in this milestone, so the refusal cannot land yet.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFEC0..0xFFFFFECF
// =============================================================================

module Descriptor = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let I2C_HID_DESC_OK                : u64 = 0
  pub let I2C_HID_DESC_NOT_BOUND         : u64 = 0xFFFFFECF
  pub let I2C_HID_DESC_BAD_DESC          : u64 = 0xFFFFFECE
  pub let I2C_HID_DESC_REBIND            : u64 = 0xFFFFFECD
  pub let I2C_HID_DESC_DEFERRED_HARDWARE : u64 = 0xFFFFFECC

  // ==========================================================================
  // Spec bounds (HID-over-I²C v1.0 §5.1).
  // ==========================================================================

  pub let I2C_HID_DESC_HDR_LEN        : u64 = 30
  pub let I2C_HID_DESC_MAX_REPORT_LEN : u64 = 4096
  pub let I2C_HID_DESC_MAX_INPUT_LEN  : u64 = 4096
  pub let I2C_HID_DESC_REG_UPPER      : u64 = 0xFFFF

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _i2c_hid_desc_valid          : u64 = 0
  pub let mut _i2c_hid_desc_report_len     : u64 = 0
  pub let mut _i2c_hid_desc_input_reg      : u64 = 0
  pub let mut _i2c_hid_desc_max_input      : u64 = 0
  pub let mut _i2c_hid_desc_vendor_product : u64 = 0

  // ==========================================================================
  // i2c_hid_descriptor_valid() -> 1 | 0
  // ==========================================================================

  pub let i2c_hid_descriptor_valid : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-002 (#1116): 1 once a descriptor has been installed. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_desc_valid];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_descriptor_report_len() -> length
  // ==========================================================================

  pub let i2c_hid_descriptor_report_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-002 (#1116): return the parsed wReportDescLength. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_desc_report_len];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_descriptor_input_reg() -> register index
  // ==========================================================================

  pub let i2c_hid_descriptor_input_reg : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-002 (#1116): return the parsed wInputRegister -- the register the ISR reads on line assertion. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_desc_input_reg];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_descriptor_max_input() -> ceiling
  // ==========================================================================

  pub let i2c_hid_descriptor_max_input : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-002 (#1116): return the parsed wMaxInputLength -- the ceiling isr.pdx enforces on input-report reads. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_desc_max_input];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_descriptor_vendor_product() -> packed (vendor << 16 | product)
  // ==========================================================================

  pub let i2c_hid_descriptor_vendor_product : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-002 (#1116): return the packed (vendor << 16 | product) key #1119's quirk table will look up. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_desc_vendor_product];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_descriptor_install(report_len, input_reg, max_input,
  //                            vendor_product) -> code
  //
  // ARITY FOUR by design (§1): the four fields the higher-level HID
  // path actually consumes today. A live parser will call this seam
  // after reading the 30-byte descriptor via the transport; the boot
  // witness calls it directly against a spec-shaped fixture.
  // ==========================================================================

  pub let i2c_hid_descriptor_install : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (report_len: u64, input_reg: u64, max_input: u64, vendor_product: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-002 (#1116): install a parsed HID descriptor. Gates, in order: (1) not already valid, else REBIND (a descriptor is a LATCH -- a second install would be a second path claiming the parse landed against different bytes, and when #1119's quirk table keys off (vendor, product), a spuriously-changed identifier would misclassify the device); (2) report_len in 1..4096, else BAD_DESC (a HID device with no report descriptor is malformed per spec §5.1; a value above the ~4KiB realistic ceiling is more likely a parse error than a real device -- refused, not truncated); (3) input_reg fits 16 bits, else BAD_DESC; (4) max_input in 1..4096, else BAD_DESC. Sets valid=1 on the happy path. Leaf. Labels prefixed i2chid_desc_in_ per reserved-label discipline.",
      block: {
        // (1) already valid?
        lea r10, [rip + _i2c_hid_desc_valid];
        mov rax, [r10];
        cmp rax, 0;
        jne i2chid_desc_in_rebind;

        // (2) report_len in 1..4096.
        cmp rdi, 0;
        je  i2chid_desc_in_bad;
        mov r10, 4096;
        cmp rdi, r10;
        ja  i2chid_desc_in_bad;

        // (3) input_reg fits 16 bits.
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  i2chid_desc_in_bad;

        // (4) max_input in 1..4096.
        cmp rdx, 0;
        je  i2chid_desc_in_bad;
        mov r10, 4096;
        cmp rdx, r10;
        ja  i2chid_desc_in_bad;

        // Install.
        lea r10, [rip + _i2c_hid_desc_report_len];
        mov [r10], rdi;
        lea r10, [rip + _i2c_hid_desc_input_reg];
        mov [r10], rsi;
        lea r10, [rip + _i2c_hid_desc_max_input];
        mov [r10], rdx;
        lea r10, [rip + _i2c_hid_desc_vendor_product];
        mov [r10], rcx;
        lea r10, [rip + _i2c_hid_desc_valid];
        mov rax, 1;
        mov [r10], rax;

        xor rax, rax;                    // OK
        ret;

      i2chid_desc_in_rebind:
        mov rax, 0xFFFFFECD;             // REBIND
        ret;

      i2chid_desc_in_bad:
        mov rax, 0xFFFFFECE;             // BAD_DESC
        ret
      }
    }

  // ==========================================================================
  // i2c_hid_descriptor_fetch() -> code
  //
  // The GET_HID_DESCRIPTOR command. Requires the transport to be bound
  // (else NOT_BOUND). Issues a read of I2C_HID_DESC_HDR_LEN bytes at
  // the transport's latched HidDescRegister via the transport's read
  // seam. Today the transport returns DEFERRED_HARDWARE and this fetch
  // propagates it; a live driver parses the returned bytes and calls
  // i2c_hid_descriptor_install itself.
  // ==========================================================================

  pub let i2c_hid_descriptor_fetch : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-002 (#1116): the GET_HID_DESCRIPTOR command. Requires transport bound (else NOT_BOUND); reads the transport's latched HidDescRegister via i2c_hid_transport_read for 30 bytes. The transport returns DEFERRED_HARDWARE and the fetch propagates -- no parse runs, no install is called, and the witness verifies both invariants (fetch returns DEFERRED_HARDWARE and valid() stays 0 across the call). Arity ZERO: the descriptor address is latched at transport bind, and a caller-supplied address would let the fetch reach a register no capability named. Reserved labels: none.",
      block: {
        push rbp;

        // Require bound transport.
        call i2c_hid_transport_bound;
        cmp rax, 0;
        je  i2chid_desc_ft_not_bound;

        // Fetch address from transport latch.
        call i2c_hid_transport_hid_desc_addr;
        mov rdi, rax;                     // reg index
        mov rsi, 30;                      // want_len = HDR_LEN
        call i2c_hid_transport_read;
        // rax now carries the transport's return; propagate.
        pop rbp;
        ret;

      i2chid_desc_ft_not_bound:
        mov rax, 0xFFFFFECF;              // NOT_BOUND
        pop rbp;
        ret
      }
    }
}
