// src/kernel/core/drivers/i2c_hid/quirks.pdx — R32.M1-005 (#1119)
//
// Per-vendor/product QUIRK TABLE for HID-over-I²C parts. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE {vendor_id, product_id} -> QUIRK FLAGS LOOKUP that the
// bring-up sequence in R32.M2 will consult before issuing reset and
// before subscribing the first-report ISR. The set of quirks is small
// and empirically stable across the HID-over-I²C parts commonly used
// as touchpads and touchscreens:
//
//   DELAYED_RESET       — the device silently drops the RESET command
//                         if it lands within a short window of power-up
//                         (observed on Synaptics touchpads). The
//                         bring-up sequence must insert a bounded delay
//                         before dispatch.
//
//   RESET_BEFORE_DESC   — the descriptor register returns stale bytes
//                         from a previous session until the device has
//                         been reset once (observed on ELAN parts). The
//                         bring-up sequence must reset first, then
//                         fetch the descriptor -- inverting the default
//                         order.
//
//   DROP_FIRST_REPORT   — the first input report after reset is a
//                         zero-value spurious frame the device
//                         publishes as part of its own bring-up; the
//                         ISR discards it rather than dispatching a
//                         phantom event.
//
//   NO_WAKE             — the device does not implement SET_POWER; a
//                         wake dispatch is a NOP for these parts and
//                         the bring-up sequence skips it.
//
// The bring-up sequence itself lives in R32.M2. This module is the
// TABLE and the LOOKUP -- the two facts on which that sequence's
// per-device branches will hang.
//
// IT IS NOT A LIVE DECISION POINT. Same discipline as transport.pdx §4
// and reset_wake.pdx §3: no bring-up sequence exists in this milestone,
// so no consumer keys off the returned flags. The pin
// `i2c_hid_quirks_consumed() == 0` -- an assertion that FAILS the
// moment a bring-up path calls the lookup for real -- forces the
// design doc to be updated at that time.
//
// =============================================================================
// §1  MATCH KEY: PACKED (vendor << 16 | product)
// =============================================================================
//
// The lookup takes the SAME 32-bit packed identifier the descriptor
// stores in _i2c_hid_desc_vendor_product (descriptor.pdx §1). A caller
// that supplies (vendor, product) as two arguments is offered a stray
// path to look up a device whose descriptor has not been parsed --
// exactly what §2 of descriptor.pdx exists to prevent -- so this seam
// takes the packed key and nothing else.
//
// PRODUCT-WILDCARD ENTRIES. A table entry with product = 0x0000 matches
// EVERY product from that vendor. This is the shape Synaptics's and
// ELAN's quirk lists take in practice: the quirk is a vendor-level
// property (the reset behaviour, the descriptor staleness) and does
// not vary per SKU. An exact-match entry (product != 0) always wins
// over a wildcard entry from the same vendor: the exact match is scanned
// first, and only on miss does the wildcard scan run. This lets a
// future issue add a per-SKU exception without touching the vendor
// wildcard.
//
// =============================================================================
// §2  ONE WRITER OF THE TABLE
// =============================================================================
//
// The quirk table is a COMPILE-TIME CONSTANT. Its bytes live in
// .rodata, its length lives beside it, and there is no runtime mutator.
// tools/build.sh confines `_i2c_hid_quirk_table` and
// `_i2c_hid_quirk_count` to this object -- a stray writer would be a
// second path installing a quirk row from somewhere the review never
// looked, and the bring-up sequence would branch on flags no vendor
// vetted. If a runtime mutator ever lands (e.g. a firmware-supplied
// override), it lives in this module and behind a capability that
// names the table specifically.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Unknown vendor/product -> returns I2C_HID_QUIRK_NONE (0). A caller
// that reads a returned 0 as "the lookup failed" has misread the
// contract: 0 means "no quirks apply", which is the correct action for
// a device the table does not name. There is no sentinel for "not
// found" because the two answers are the same instruction to the
// bring-up sequence (proceed with the default order, no delay, do not
// drop the first report).
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFEF0..0xFFFFFEFF -- reserved, not used yet
// =============================================================================

module Quirks = structure {

  // ==========================================================================
  // §0 quirk flag bits.
  // ==========================================================================

  pub let I2C_HID_QUIRK_NONE              : u64 = 0
  pub let I2C_HID_QUIRK_DELAYED_RESET     : u64 = 0x0000000000000001
  pub let I2C_HID_QUIRK_RESET_BEFORE_DESC : u64 = 0x0000000000000002
  pub let I2C_HID_QUIRK_DROP_FIRST_REPORT : u64 = 0x0000000000000004
  pub let I2C_HID_QUIRK_NO_WAKE           : u64 = 0x0000000000000008

  // ==========================================================================
  // §1 the table.
  //
  // Row layout is TWO u64 per entry: {vendor_product_key, flags}. Stride
  // is 16 bytes. Product == 0 in a key means "wildcard for this vendor"
  // (§1). Rows are ordered so that a future exact-match entry for the
  // same vendor can be inserted before its wildcard row without touching
  // the wildcard row itself.
  //
  // Vendor IDs are USB Implementers Forum assignments -- the same
  // registry HID devices use over I²C:
  //
  //   0x06CB = Synaptics
  //   0x04F3 = ELAN Microelectronics
  //
  // Initial policy (task specification):
  //
  //   Synaptics: DELAYED_RESET
  //             -- the reset command lands too early on some Synaptics
  //             touchpads and is silently dropped; the bring-up sequence
  //             inserts a bounded delay before dispatch.
  //   ELAN     : RESET_BEFORE_DESC | DROP_FIRST_REPORT
  //             -- ELAN's descriptor register returns stale bytes until
  //             the device has been reset once, and the first report
  //             after reset is a zero-value bring-up frame.
  //
  // These flags are per-vendor (product wildcard = 0). #1119 initialises
  // the table with two entries; future issues may add per-SKU exceptions.
  // ==========================================================================

  pub let _i2c_hid_quirk_table : [u64; 4] = [
    0x06CB0000,                           // Synaptics, product wildcard (vendor << 16 | 0)
    0x0000000000000001,                   // DELAYED_RESET
    0x04F30000,                           // ELAN Microelectronics, product wildcard
    0x0000000000000006                    // RESET_BEFORE_DESC | DROP_FIRST_REPORT
  ]

  pub let _i2c_hid_quirk_count : u64 = 2

  // ==========================================================================
  // Consumer-count latch. Pinned at 0 today; a future bring-up sequence
  // that calls the lookup for real can flip it, and the boot witness
  // assertion `i2c_hid_quirks_consumed() == 0` fails at that point --
  // forcing the module header to be rewritten with the live consumer's
  // shape.
  // ==========================================================================

  pub let mut _i2c_hid_quirk_consumers : u64 = 0

  pub let i2c_hid_quirks_consumed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-005 (#1119): honesty pin -- 0 while no bring-up sequence calls the lookup for real. When R32.M2 wires the sequence, the count flips, and this witness's assertion fails at that point (forcing the doc to be rewritten). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_quirk_consumers];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_quirk_count() -> row count
  // ==========================================================================

  pub let i2c_hid_quirk_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-005 (#1119): return the number of rows in _i2c_hid_quirk_table. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_quirk_count];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_quirk_lookup(vendor_product) -> flags
  //
  // ARITY ONE. Takes the packed (vendor << 16 | product) key the
  // descriptor already stores (§1). Returns the flag word for the first
  // matching row, else I2C_HID_QUIRK_NONE.
  //
  // Match order (§1): EXACT match first, then wildcard (product == 0)
  // match. The two passes are separate scans of the same table -- a
  // single-pass scan that returned on the first vendor match would let
  // a wildcard row shadow an exact row that happens to sit later.
  //
  // Table is small (bounded by _i2c_hid_quirk_count, currently 2), so
  // a linear scan is the right shape; a hash or sorted-scan would be
  // over-engineered for a table this size and would harden the layout
  // against the per-SKU insertion pattern §1 documents.
  // ==========================================================================

  pub let i2c_hid_quirk_lookup : (u64) -> u64 !{mem} @{} =
    fn (vendor_product: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-005 (#1119): look up quirk flags for a packed (vendor, product) key. Two-pass scan: (1) exact match against key -- returns immediately on hit; (2) wildcard match against (vendor << 16 | 0) -- returns on hit. Both passes iterate up to _i2c_hid_quirk_count rows at stride 16 bytes. No row visits beyond the count (leaks would let stale bytes past the table appear as quirks). Returns I2C_HID_QUIRK_NONE if neither pass hits. Uses r12/r13/r14/rbx across the loops; five-push prologue keeps the ret alignment intact. Labels prefixed i2chid_qk_lu_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // r12 = exact key, r13 = wildcard key (vendor << 16 | 0),
        // r14 = table base, r15 = row count, rbx = loop index.
        mov r12, rdi;                     // exact key

        // Compute wildcard = key & 0xFFFF0000 (mask off product bits).
        // Descriptor packs identifiers as (vendor << 16 | product) in
        // the low 32 bits (descriptor.pdx §1); the mask preserves the
        // vendor half and zeroes the product half.
        mov r13, rdi;
        mov rax, 0x00000000FFFF0000;
        and r13, rax;

        lea r14, [rip + _i2c_hid_quirk_table];
        lea r10, [rip + _i2c_hid_quirk_count];
        mov r15, [r10];

        // ================================================================
        // Pass 1: exact match.
        //
        // Row address computed as r14 + rbx*16 by `shl+add` into a temp
        // register (paideia-as encodes `[base+index+disp]` as SIB with
        // scale; the two-step precompute keeps every mov's memory
        // operand to `[reg]` or `[reg+disp]`, which the encoder handles
        // without SIB-friction).
        // ================================================================
        xor rbx, rbx;
      i2chid_qk_lu_ex_top:
        cmp rbx, r15;
        jae i2chid_qk_lu_wild_start;

        mov rax, rbx;
        shl rax, 4;
        add rax, r14;                     // rax = row address
        mov rcx, [rax];                   // row key
        cmp rcx, r12;
        je  i2chid_qk_lu_hit;

        add rbx, 1;
        jmp i2chid_qk_lu_ex_top;

        // ================================================================
        // Pass 2: wildcard match (row key == (key & 0xFFFF0000)).
        // ================================================================
      i2chid_qk_lu_wild_start:
        xor rbx, rbx;
      i2chid_qk_lu_wild_top:
        cmp rbx, r15;
        jae i2chid_qk_lu_none;

        mov rax, rbx;
        shl rax, 4;
        add rax, r14;
        mov rcx, [rax];                   // row key
        cmp rcx, r13;                     // matches wildcard?
        je  i2chid_qk_lu_hit;

        add rbx, 1;
        jmp i2chid_qk_lu_wild_top;

        // Hit: return row's flags (offset +8 in the row).
      i2chid_qk_lu_hit:
        mov rax, rbx;
        shl rax, 4;
        add rax, r14;
        mov rax, [rax + 8];               // flags
        jmp i2chid_qk_lu_out;

        // Miss: return NONE.
      i2chid_qk_lu_none:
        xor rax, rax;

      i2chid_qk_lu_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
