// src/kernel/core/drivers/i2c_hid/transport.pdx — R32.M1-001 (#1115)
//
// The kernel-side transport half of HID-over-I²C (Microsoft's
// HID-over-I2C Protocol Specification, "HID over I²C v1.0"). SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE FRAME-LEVEL TRANSPORT for a HID device that sits behind a
// DesignWare LPSS I²C controller. HID-over-I²C addresses a device by
// SLAVE ADDRESS (a 7-bit I²C address, supplied by ACPI) and reads or
// writes REGISTERS at that address; a register is named by a 16-bit
// LITTLE-ENDIAN INDEX that the host writes in a two-byte prefix before
// the read or write of the payload proper. There are two directions:
//
//   REGISTER READ  = HOST WRITE [reg_lo, reg_hi] then REPEATED START
//                    then HOST READ N bytes (N is fixed for the register
//                    or derived from the first two bytes of the response
//                    when the register is an input report).
//
//   REGISTER WRITE = HOST WRITE [reg_lo, reg_hi, payload...].
//
// The register set is enumerated by the HID descriptor (this module's
// descriptor.pdx sibling). Six of its fields are register-index values
// this transport shepherds transfers to:
//
//   wHIDDescRegister    — index of the descriptor itself (supplied via
//                         ACPI GetHidDescriptor, not read via the transport;
//                         the descriptor is fetched by ADDRESSING that
//                         register on this transport).
//   wReportDescRegister — index of the HID report descriptor.
//   wInputRegister      — index of the current input report (the ISR
//                         reads this on line assertion).
//   wOutputRegister     — index of the output report register.
//   wCommandRegister    — index of the command register.
//   wDataRegister       — index of the data register.
//
// IT IS NOT A LIVE DRIVER. Same discipline as ec_access.pdx (#1580),
// backlight_pwm.pdx §4 and backlight_dpaux.pdx §4: the transport frame
// is stated as a SCAFFOLD, and the pin `i2c_hid_transport_arbitrated()
// == 0` -- an assertion that FAILS the moment a future milestone plumbs
// a real DesignWare I²C write path through this transport -- forces
// the design doc to be updated at that time. See §4 for deferrals.
//
// IT ACCEPTS AN OPAQUE u64 BUS HANDLE. R30.M5 landed the DesignWare
// LPSS I²C controller registers and a KIND_I2C_BUS capability, but
// the interrupt-driven WRITE path from a client is not yet plumbed
// end-to-end -- the KIND_I2C_BUS mint exists, the transfer engine
// works from thread context, and no consumer holds a handle. This
// transport takes the bus handle as an OPAQUE u64: on the T14 G4 that
// handle is a cap slot; today it is an inert sentinel that the write
// seams observe and pass on to `deferred_hardware`. Widening the arity
// to receive a controller BASE or an EXTENT would let a caller reach
// registers no capability named -- exactly what §2 of ec_access.pdx
// exists to prevent -- so the seam is arity TWO ({bus_handle,
// hid_desc_addr}) at this milestone and stays there until R32.M2
// plumbs a real client-side transfer.
//
// =============================================================================
// §1  REGISTER-INDEX ENCODING
// =============================================================================
//
// The register index is a 16-bit LITTLE-ENDIAN value. All register-
// index arguments in this module are validated to fit 16 bits before
// any counting or refusal decision runs. A caller that asks for a
// register index of 0x10000 or more is refused with BAD_REG and
// counted -- refused, not truncated. Same discipline as
// backlight_pwm.pdx §3.
//
// The two-byte prefix that identifies the register on the wire is
// composed by the future DesignWare transfer helper (dw_xfer.pdx),
// which packs the prefix and the payload into a single interrupt-
// driven transfer. This module DOES NOT ISSUE the transfer today.
//
// =============================================================================
// §2  ONE WRITER OF THE BIND FLAG
// =============================================================================
//
// Same discipline as backlight_pwm.pdx §2 and ec_access.pdx: exactly
// one writer of `_i2c_hid_transport_bound`. tools/build.sh confines
// relocations against `_i2c_hid_transport_bound`,
// `_i2c_hid_transport_bus`, `_i2c_hid_transport_hid_desc_addr` and
// `_i2c_hid_transport_stats` to this object. The bus handle is a
// LATCH; once bound with a handle, the handle cannot be re-bound (a
// second bind returns REBIND). A future revoke path lands in R32.M2.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Register index outside 16 bits -> BAD_REG (refused, not truncated).
// Read length outside 1..255 -> BAD_LEN (refused, not clamped -- the
// HID input-report length is enumerated from the descriptor, never
// negotiated at the transport). Read/write before bind -> NOT_BOUND.
// Second bind -> REBIND. Happy path -> DEFERRED_HARDWARE, the honest
// sentinel a caller that treats as success has invented a claim this
// module does not carry.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL I²C TRANSFER. The DesignWare transfer path (dw_xfer.pdx)
//     is not called from this transport; the bus handle is inert and
//     the sentinel returned is DEFERRED_HARDWARE. R32.M2 wires the
//     KIND_I2C_BUS -> dw_xfer path through this transport.
//
//   * NO REPORT DESCRIPTOR CACHE. The transport does not memoise the
//     report descriptor -- that's descriptor.pdx's territory, one
//     step above this frame.
//
//   * NO QUIRK TABLE. #1119 lands the per-vendor/product quirk table
//     (delayed reset, reset-then-descriptor probe order, spurious-
//     first-report drop) above this transport.
//
//   * NO ARBITRATION against a firmware-owned I²C path. Same shape as
//     ec_access.pdx (#1580) and backlight_pwm.pdx §4: the pin
//     `i2c_hid_transport_arbitrated() == 0` is what the boot witness
//     asserts, and the assertion fails the moment coordination lands.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFEB0..0xFFFFFEBF
// =============================================================================

module Transport = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let I2C_HID_TRANSPORT_OK                : u64 = 0
  pub let I2C_HID_TRANSPORT_NOT_BOUND         : u64 = 0xFFFFFEBF
  pub let I2C_HID_TRANSPORT_BAD_REG           : u64 = 0xFFFFFEBE
  pub let I2C_HID_TRANSPORT_BAD_LEN           : u64 = 0xFFFFFEBD
  pub let I2C_HID_TRANSPORT_DEFERRED_HARDWARE : u64 = 0xFFFFFEBC
  pub let I2C_HID_TRANSPORT_REBIND            : u64 = 0xFFFFFEBB

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _i2c_hid_transport_bound         : u64 = 0
  pub let mut _i2c_hid_transport_bus           : u64 = 0
  pub let mut _i2c_hid_transport_hid_desc_addr : u64 = 0
  pub let mut _i2c_hid_transport_stats         : [u64; 8] = uninit @align(64)

  pub let I2C_HID_TRANSPORT_ST_BINDS     : u64 = 0
  pub let I2C_HID_TRANSPORT_ST_READS     : u64 = 1
  pub let I2C_HID_TRANSPORT_ST_WRITES    : u64 = 2
  pub let I2C_HID_TRANSPORT_ST_BAD_REG   : u64 = 3
  pub let I2C_HID_TRANSPORT_ST_BAD_LEN   : u64 = 4
  pub let I2C_HID_TRANSPORT_ST_NOT_BOUND : u64 = 5
  pub let I2C_HID_TRANSPORT_ST_REBIND    : u64 = 6
  pub let I2C_HID_TRANSPORT_ST_MAX       : u64 = 8

  // ==========================================================================
  // i2c_hid_transport_bind(bus_handle, hid_desc_addr) -> OK | REBIND
  //
  // ARITY TWO: the opaque bus handle (a future KIND_I2C_BUS cap slot,
  // an inert u64 today) and the ACPI-supplied HID descriptor register
  // index. A caller-supplied controller BASE or EXTENT would be a way
  // to reach registers no capability named -- exactly what §2 of
  // ec_access.pdx exists to prevent.
  // ==========================================================================

  pub let i2c_hid_transport_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (bus_handle: u64, hid_desc_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): bind the I²C-HID transport to a bus handle (opaque u64; a future KIND_I2C_BUS cap slot) and an ACPI-supplied HID descriptor register index. Refuses a second bind with REBIND -- the whole discipline rests on the bind being a LATCH: a stray relocation would be a second path claiming this transport is initialised to a different bus, and when R32.M2 plumbs the DesignWare transfer through this seam, a spuriously-set bus handle would reach registers the capability did not name. Increments _i2c_hid_transport_stats[0]. Leaf. Labels prefixed i2chid_tr_bd_ per reserved-label discipline.",
      block: {
        // Second bind?
        lea r10, [rip + _i2c_hid_transport_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne i2chid_tr_bd_rebind;

        // Latch bus handle and descriptor addr.
        lea r10, [rip + _i2c_hid_transport_bus];
        mov [r10], rdi;

        lea r10, [rip + _i2c_hid_transport_hid_desc_addr];
        mov [r10], rsi;

        lea r10, [rip + _i2c_hid_transport_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // OK
        ret;

      i2chid_tr_bd_rebind:
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 48];             // slot 6 = REBIND
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFEBB;             // REBIND
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_bound() -> 1 | 0
  // ==========================================================================

  pub let i2c_hid_transport_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): 1 once i2c_hid_transport_bind has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_transport_bound];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_bus() -> handle
  //
  // Read-only accessor for the bus handle latched at bind. Used by the
  // ISR (isr.pdx) to submit the input-report read against the same bus
  // the transport is bound to, and by the descriptor fetcher.
  // ==========================================================================

  pub let i2c_hid_transport_bus : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): return the opaque bus handle latched at bind. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_transport_bus];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_hid_desc_addr() -> reg_index
  // ==========================================================================

  pub let i2c_hid_transport_hid_desc_addr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): return the HID descriptor register index latched at bind (supplied by ACPI). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_transport_hid_desc_addr];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as ec_access_arbitrated,
  // backlight_pwm_arbitrated and backlight_dpaux_arbitrated: pinned
  // at 0 by the boot witness so a future milestone plumbing a real
  // transfer cannot land without rewriting the claim.
  // ==========================================================================

  pub let i2c_hid_transport_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M1-001 (#1115): report whether the transport issues real DesignWare transfers today. IT RETURNS 0, because nothing in this tree wires this transport to dw_xfer.pdx. The boot witness pins it at 0 for the same reason ec_access_arbitrated is pinned: a claim in a comment rots silently, a value a test asserts on does not. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_read(reg_index, want_len) -> code
  //
  // The read seam. Validates reg fits 16 bits, validates want_len in
  // 1..255, requires bind, returns DEFERRED_HARDWARE on the happy path.
  // No real transfer runs.
  // ==========================================================================

  pub let i2c_hid_transport_read : (u64, u64) -> u64 !{mem} @{} =
    fn (reg_index: u64, want_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): the read seam. Gates, in order: (1) reg fits 16 bits, else BAD_REG and counted -- refused, not truncated; (2) want_len in 1..255, else BAD_LEN and counted -- refused, not clamped, because HID input-report length is enumerated from the descriptor and never negotiated at the transport; (3) driver bound, else NOT_BOUND and counted; (4) the happy path returns DEFERRED_HARDWARE (an honest sentinel per §3), counted. NO REAL I²C TRANSFER RUNS: a live driver would submit a two-byte register-index prefix followed by a repeated-start read of want_len bytes against the DesignWare transfer engine, and none of that is in this milestone. Leaf. Labels prefixed i2chid_tr_rd_ per reserved-label discipline.",
      block: {
        // (1) reg fits 16 bits.
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  i2chid_tr_rd_bad_reg;

        // (2) want_len in 1..255.
        cmp rsi, 0;
        je  i2chid_tr_rd_bad_len;
        mov r10, 255;
        cmp rsi, r10;
        ja  i2chid_tr_rd_bad_len;

        // (3) bound?
        lea r10, [rip + _i2c_hid_transport_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  i2chid_tr_rd_not_bound;

        // (4) DEFERRED_HARDWARE.
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 8];              // slot 1 = READS
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFEBC;             // DEFERRED_HARDWARE
        ret;

      i2chid_tr_rd_bad_reg:
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 24];             // slot 3 = BAD_REG
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFEBE;             // BAD_REG
        ret;

      i2chid_tr_rd_bad_len:
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 32];             // slot 4 = BAD_LEN
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFEBD;             // BAD_LEN
        ret;

      i2chid_tr_rd_not_bound:
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 40];             // slot 5 = NOT_BOUND
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFEBF;             // NOT_BOUND
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_write(reg_index, byte) -> code
  //
  // The write seam. Validates reg fits 16 bits (the payload is a single
  // byte at this arity, matching the SET_REPORT byte-poke shape). No
  // real transfer runs.
  // ==========================================================================

  pub let i2c_hid_transport_write : (u64, u64) -> u64 !{mem} @{} =
    fn (reg_index: u64, byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): the write seam. Same gate order as read: reg fits 16 bits (BAD_REG), payload byte fits 8 bits (BAD_LEN, because a byte outside the low 8 bits is not a byte -- refused, not truncated), bound (NOT_BOUND), else DEFERRED_HARDWARE. NO REAL I²C TRANSFER RUNS. Leaf. Labels prefixed i2chid_tr_wr_ per reserved-label discipline.",
      block: {
        // (1) reg fits 16 bits.
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  i2chid_tr_wr_bad_reg;

        // (2) byte fits 8 bits.
        mov r10, 0xFF;
        cmp rsi, r10;
        ja  i2chid_tr_wr_bad_len;

        // (3) bound?
        lea r10, [rip + _i2c_hid_transport_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  i2chid_tr_wr_not_bound;

        // (4) DEFERRED_HARDWARE.
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 16];             // slot 2 = WRITES
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFEBC;             // DEFERRED_HARDWARE
        ret;

      i2chid_tr_wr_bad_reg:
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFEBE;             // BAD_REG
        ret;

      i2chid_tr_wr_bad_len:
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFEBD;             // BAD_LEN (byte overflow)
        ret;

      i2chid_tr_wr_not_bound:
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFEBF;             // NOT_BOUND
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_reads() -> count
  // ==========================================================================

  pub let i2c_hid_transport_reads : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): read the count of deferred-hardware outcomes on the read seam. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  // ==========================================================================
  // i2c_hid_transport_writes() -> count
  // ==========================================================================

  pub let i2c_hid_transport_writes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M1-001 (#1115): read the count of deferred-hardware outcomes on the write seam. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _i2c_hid_transport_stats];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame
}
