// src/kernel/core/drivers/usb/hub_fsm.pdx — R34.M1-002 (#1168)
//
// The kernel's PER-PORT USB PORT-STATUS FSM. Records, per port on
// per hub, the enumeration state observed by the class driver:
//
//   DISCONNECTED --(connect_event)--> CONNECTED
//   CONNECTED    --(reset_start)--> RESET
//   RESET        --(address_assigned)--> ADDRESSED
//   ADDRESSED    --(configure_complete)--> CONFIGURED
//   any-state    --(disconnect_event)--> DISCONNECTED
//
// The FSM does NOT drive the hub. Every transition is REPORTED to
// this module by the class driver (which owns the KIND_USB_DEVICE
// and hub authority); this module RECORDS it and refuses illegal
// transitions.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the STATE tracker for per-port enumeration. It stores the
// current state for up to HUB_FSM_MAX (16) (hub_row, port) pairs
// and refuses transitions that do not respect the state graph.
//
// IT IS NOT A DRIVER. Nothing in this module fetches a port-status
// register, arms a reset, or reads a device descriptor. Those are
// the class driver's authority; this module records what the class
// driver reports it observed.
//
// IT IS NOT A ROUTER. Port state changes that a subscriber sees
// through the hub_topology_channel (#1170) are published SEPARATELY
// by the class driver — hub_fsm.pdx neither knows nor cares who
// listens.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE TABLE
// =============================================================================
//
// hub_fsm_port_event is the ONE writer of _hub_fsm_state. A second
// writer would let a caller install a port state without passing
// the transition validator, and every future decision the class
// driver makes on the strength of a state (whether to issue a
// reset, whether to assign an address) would be one made against a
// state the FSM never blessed.
//
// tools/build.sh confines relocations against `_hub_fsm_state` and
// `_hub_fsm_stats` to this object.
//
// =============================================================================
// §2  REFUSE, NEVER CLAMP
// =============================================================================
//
// A port event whose (hub_row, port) is out of range is BAD_PORT;
// an event whose kind is not one of the five enumerated is BAD_EVENT;
// an event that does not respect the state graph is BAD_TRANSITION.
// Nothing "advances the state anyway".
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFCB0..0xFFFFFCBF
// =============================================================================

module HubFsm = structure {

  // State ordinals.
  pub let HUB_FSM_S_DISCONNECTED : u64 = 0
  pub let HUB_FSM_S_CONNECTED    : u64 = 1
  pub let HUB_FSM_S_RESET        : u64 = 2
  pub let HUB_FSM_S_ADDRESSED    : u64 = 3
  pub let HUB_FSM_S_CONFIGURED   : u64 = 4
  pub let HUB_FSM_S_MAX          : u64 = 4

  // Event ordinals.
  pub let HUB_FSM_E_CONNECT      : u64 = 1
  pub let HUB_FSM_E_RESET_START  : u64 = 2
  pub let HUB_FSM_E_ADDRESSED    : u64 = 3
  pub let HUB_FSM_E_CONFIGURED   : u64 = 4
  pub let HUB_FSM_E_DISCONNECT   : u64 = 5
  pub let HUB_FSM_E_MAX          : u64 = 5

  // Bounds. 16 rows, each 16 ports max — matches KIND_USB_HUB
  // PORT_MAX and USBH_MAX at 8, but sized larger to keep the FSM
  // independent (a downstream hub can be attached to any port).
  pub let HUB_FSM_MAX_ROWS   : u64 = 16
  pub let HUB_FSM_MAX_PORTS  : u64 = 16
  pub let HUB_FSM_ROW_BYTES  : u64 = 16    // 16 ports * 1 byte, then rounded

  pub let HUB_FSM_OK              : u64 = 0
  pub let HUB_FSM_BAD_PORT        : u64 = 0xFFFFFCBF
  pub let HUB_FSM_BAD_EVENT       : u64 = 0xFFFFFCBE
  pub let HUB_FSM_BAD_TRANSITION  : u64 = 0xFFFFFCBD
  pub let HUB_FSM_BAD_ROW         : u64 = 0xFFFFFCBC

  pub let HUB_FSM_DECODE_BAD      : u64 = 0xFFFFFFFFFFFFFFFF

  // _hub_fsm_state[row*16 + port] = state ordinal (0..4).
  pub let mut _hub_fsm_state : [u64; 256] = uninit @align(64)

  // Counters: transitions taken per event kind + refusals.
  pub let mut _hub_fsm_stats : [u64; 16] = uninit @align(64)

  pub let HUB_FSM_ST_CONNECT       : u64 = 0
  pub let HUB_FSM_ST_RESET_START   : u64 = 1
  pub let HUB_FSM_ST_ADDRESSED     : u64 = 2
  pub let HUB_FSM_ST_CONFIGURED    : u64 = 3
  pub let HUB_FSM_ST_DISCONNECT    : u64 = 4
  pub let HUB_FSM_ST_BAD_PORT      : u64 = 5
  pub let HUB_FSM_ST_BAD_EVENT     : u64 = 6
  pub let HUB_FSM_ST_BAD_TRANSITION: u64 = 7

  // ==========================================================================
  // hub_fsm_reset() — reset the state table and counters.
  // ==========================================================================

  pub let hub_fsm_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-002 (#1168): reset state table and counters. Labels prefixed hfsm_rs_.",
      block: {
        lea r10, [rip + _hub_fsm_state];
        xor rax, rax;
        xor rcx, rcx;
      hfsm_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  hfsm_rs_state;

        lea r10, [rip + _hub_fsm_stats];
        xor rcx, rcx;
      hfsm_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  hfsm_rs_stats;
        ret
      }
    }

  pub let hub_fsm_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-002 (#1168): counter bump. Labels prefixed hfsm_nt_.",
      block: {
        cmp rdi, 16;
        jae hfsm_nt_out;
        lea r10, [rip + _hub_fsm_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hfsm_nt_out:
        ret
      }
    }

  pub let hub_fsm_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-002 (#1168): counter read. Labels prefixed hfsm_st_.",
      block: {
        cmp rdi, 16;
        jae hfsm_st_zero;
        lea r10, [rip + _hub_fsm_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hfsm_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let hub_fsm_port_valid : (u64) -> u64 !{} @{} =
    fn (port: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-002 (#1168): 1 iff port < HUB_FSM_MAX_PORTS. Labels prefixed hfsm_pv_.",
      block: {
        cmp rdi, 16;
        jae hfsm_pv_no;
        mov rax, 1;
        ret;
      hfsm_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hub_fsm_row_valid : (u64) -> u64 !{} @{} =
    fn (row: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-002 (#1168): 1 iff row < HUB_FSM_MAX_ROWS. Labels prefixed hfsm_rv_.",
      block: {
        cmp rdi, 16;
        jae hfsm_rv_no;
        mov rax, 1;
        ret;
      hfsm_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hub_fsm_event_valid : (u64) -> u64 !{} @{} =
    fn (event: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-002 (#1168): 1 iff event in [E_CONNECT, E_DISCONNECT]. Labels prefixed hfsm_ev_.",
      block: {
        cmp rdi, 1;
        jb  hfsm_ev_no;
        cmp rdi, 5;
        ja  hfsm_ev_no;
        mov rax, 1;
        ret;
      hfsm_ev_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hub_fsm_get_state(row, port) -> state | BAD_*
  // ==========================================================================

  pub let hub_fsm_get_state : (u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-002 (#1168): read state for (row, port). Labels prefixed hfsm_gs_.",
      block: {
        cmp rdi, 16;
        jae hfsm_gs_bad_row;
        cmp rsi, 16;
        jae hfsm_gs_bad_port;

        // idx = row * 16 + port
        mov rax, rdi;
        shl rax, 4;
        add rax, rsi;
        lea r10, [rip + _hub_fsm_state];
        mov rax, [r10 + rax * 8];
        ret;

      hfsm_gs_bad_row:
        mov rax, 0xFFFFFCBC;
        ret;
      hfsm_gs_bad_port:
        mov rax, 0xFFFFFCBF;
        ret
      }
    }

  // ==========================================================================
  // hub_fsm_transition_valid(cur_state, event) -> 1 | 0
  //
  // The state graph. Explicit table.
  // ==========================================================================

  pub let hub_fsm_transition_valid : (u64, u64) -> u64 !{} @{} =
    fn (cur: u64, event: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-002 (#1168): 1 iff the (cur, event) transition is allowed. Legal transitions: DISCONNECTED->CONNECT->CONNECTED; CONNECTED->RESET_START->RESET; RESET->ADDRESSED->ADDRESSED; ADDRESSED->CONFIGURED->CONFIGURED; any->DISCONNECT->DISCONNECTED (idempotent from DISCONNECTED refused). Labels prefixed hfsm_tv_.",
      block: {
        // DISCONNECT is always legal from any state EXCEPT DISCONNECTED
        // (idempotent disconnect refused so a caller cannot silently
        // convert "already disconnected" into "fresh event").
        cmp rsi, 5;                      // E_DISCONNECT
        jne hfsm_tv_check_progression;
        cmp rdi, 0;                      // S_DISCONNECTED
        je  hfsm_tv_no;
        jmp hfsm_tv_yes;

      hfsm_tv_check_progression:
        // Progression: state N accepts event N+1 to go to N+1.
        // DISCONNECTED (0) + CONNECT (1) -> CONNECTED (1).
        // CONNECTED (1) + RESET_START (2) -> RESET (2).
        // RESET (2) + ADDRESSED (3) -> ADDRESSED (3).
        // ADDRESSED (3) + CONFIGURED (4) -> CONFIGURED (4).
        // In every case event == cur + 1.
        mov rax, rdi;
        add rax, 1;
        cmp rax, rsi;
        jne hfsm_tv_no;
        jmp hfsm_tv_yes;

      hfsm_tv_yes:
        mov rax, 1;
        ret;
      hfsm_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hub_fsm_next_state(cur, event) -> next state, assuming valid.
  // ==========================================================================

  pub let hub_fsm_next_state : (u64, u64) -> u64 !{} @{} =
    fn (cur: u64, event: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-002 (#1168): next state given (cur, event). Caller MUST have called hub_fsm_transition_valid first. Labels prefixed hfsm_ns_.",
      block: {
        cmp rsi, 5;                      // E_DISCONNECT
        je  hfsm_ns_disc;
        // Progression: next = event
        mov rax, rsi;
        ret;
      hfsm_ns_disc:
        xor rax, rax;                    // S_DISCONNECTED
        ret
      }
    }

  // ==========================================================================
  // hub_fsm_port_event(row, port, event) -> OK | BAD_*
  //
  // Sequence:
  //   (1) row_valid;
  //   (2) port_valid;
  //   (3) event_valid;
  //   (4) transition_valid on current state;
  //   (5) install next state; bump counter.
  // ==========================================================================

  pub let hub_fsm_port_event : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, port: u64, event: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-002 (#1168): install one port event. THE ONE WRITER of _hub_fsm_state (per §1). Refuses illegal transitions and bumps the appropriate refusal counter so 'this transition was rejected N times' is observable. Labels prefixed hfsm_pe_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // row
        mov r13, rsi;                    // port
        mov r14, rdx;                    // event

        cmp r12, 16;
        jae hfsm_pe_bad_row;
        cmp r13, 16;
        jae hfsm_pe_bad_port;

        mov rdi, r14;
        call hub_fsm_event_valid;
        cmp rax, 0;
        je  hfsm_pe_bad_event;

        // Compute idx = row * 16 + port; read current state.
        mov rax, r12;
        shl rax, 4;
        add rax, r13;
        mov rbx, rax;                    // idx (used for install)

        lea r10, [rip + _hub_fsm_state];
        mov r15, [r10 + rbx * 8];        // r15 = cur_state

        mov rdi, r15;
        mov rsi, r14;
        call hub_fsm_transition_valid;
        cmp rax, 0;
        je  hfsm_pe_bad_trans;

        mov rdi, r15;
        mov rsi, r14;
        call hub_fsm_next_state;
        mov rbp, rax;                    // next state

        lea r10, [rip + _hub_fsm_state];
        mov [r10 + rbx * 8], rbp;

        // Bump counter for the event kind. Event 1..5 maps to
        // stat index 0..4.
        mov rdi, r14;
        sub rdi, 1;
        call hub_fsm_note;

        xor rax, rax;
        jmp hfsm_pe_out;

      hfsm_pe_bad_row:
        mov rdi, 5;                      // ST_BAD_PORT (row treated as port class)
        call hub_fsm_note;
        mov rax, 0xFFFFFCBC;
        jmp hfsm_pe_out;
      hfsm_pe_bad_port:
        mov rdi, 5;
        call hub_fsm_note;
        mov rax, 0xFFFFFCBF;
        jmp hfsm_pe_out;
      hfsm_pe_bad_event:
        mov rdi, 6;
        call hub_fsm_note;
        mov rax, 0xFFFFFCBE;
        jmp hfsm_pe_out;
      hfsm_pe_bad_trans:
        mov rdi, 7;
        call hub_fsm_note;
        mov rax, 0xFFFFFCBD;

      hfsm_pe_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
