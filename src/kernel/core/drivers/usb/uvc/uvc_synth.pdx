// src/kernel/core/drivers/usb/uvc/uvc_synth.pdx — R34.M5-004 (#1189)
//
// USB Video Class 1.5 synth webcam driver: the VideoControl (VC)
// interface class 0x0E subclass 0x01 header validator, the payload-
// header parser (bmHeaderInfo, PTS, SCR), and the frame-assembly
// state machine that reconstructs a single video frame from a
// sequence of isochronous packets.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// A UVC device presents a VideoControl interface (class 0x0E,
// subclass 0x01 per USB Video Class 1.5 §2.4.1) plus one or more
// VideoStreaming interfaces (subclass 0x02). Each isochronous packet
// on a streaming endpoint begins with a PAYLOAD HEADER whose format
// UVC 1.5 §2.4.3 describes:
//
//   [+0]  bHeaderLength     (u8, 2..12; total header size in bytes)
//   [+1]  bmHeaderInfo      (u8, bitfield):
//                            bit 0  FID (frame ID toggle)
//                            bit 1  EOF (end of frame)
//                            bit 2  PTS (presentation-timestamp present)
//                            bit 3  SCR (source-clock-reference present)
//                            bit 4  RES (reserved, must be 0)
//                            bit 5  STI (still image)
//                            bit 6  ERR (error)
//                            bit 7  EOH (end of header)
//   [+2..5]   PTS           (u32, only present if bmHeaderInfo bit 2)
//   [+6..11]  SCR           (u48, only present if bmHeaderInfo bit 3;
//                            first u32 = STC, next u16 = SOF token)
//
// This module offers:
//   * uvc_class_valid(cls, sub) — 1 iff (0x0E, 0x01)
//   * uvc_header_length_valid(n) — 1 iff n in [2, 12]
//   * uvc_header_parse(buf, len) — returns packed (hdr_len | flags)
//                                 or an error
//   * uvc_header_pts(buf) / uvc_header_scr_stc(buf) / uvc_header_scr_sof(buf)
//   * uvc_frame_reset(), uvc_frame_append(payload, plen, flags)
//   * uvc_frame_bytes(), uvc_frames_delivered()
//
// FID (bit 0) toggles between frames; a payload whose FID differs
// from the current frame's FID means "new frame started" and the
// state machine resets its accumulator before appending. EOF (bit 1)
// signals the frame is complete; the state machine finalises the
// frame and bumps the delivered counter.
//
// IT DOES NOT TRANSFER BYTES. Payload bytes arrive through a
// KIND_ISOCH_STREAM path in a later round; this module records the
// FRAME-COUNTER state so a witness can inject a sequence and confirm
// the reassembly is correct.
//
// IT IS NOT A LIVE DRIVER. uvc_arbitrated() returns 0 until the
// class-driver-selection process binds this against a real UVC
// interface descriptor.
//
// =============================================================================
// §1  ERROR CODES 0xFFFFFA90..0xFFFFFA9F
// =============================================================================

module UvcSynth = structure {

  pub let UVC_INTERFACE_CLASS    : u64 = 0x0E
  pub let UVC_SUBCLASS_VC        : u64 = 0x01
  pub let UVC_SUBCLASS_VS        : u64 = 0x02

  pub let UVC_HDR_LEN_MIN : u64 = 2
  pub let UVC_HDR_LEN_MAX : u64 = 12

  pub let UVC_FLAG_FID : u64 = 0x01
  pub let UVC_FLAG_EOF : u64 = 0x02
  pub let UVC_FLAG_PTS : u64 = 0x04
  pub let UVC_FLAG_SCR : u64 = 0x08
  pub let UVC_FLAG_RES : u64 = 0x10
  pub let UVC_FLAG_STI : u64 = 0x20
  pub let UVC_FLAG_ERR : u64 = 0x40
  pub let UVC_FLAG_EOH : u64 = 0x80

  // A synth "frame" caps at 65536 bytes — enough for one small
  // MJPEG / uncompressed VGA frame in a witness, and small enough
  // to fit .bss without pressuring the kernel image.
  pub let UVC_FRAME_MAX_BYTES : u64 = 65536

  pub let UVC_OK             : u64 = 0
  pub let UVC_BAD_BUF        : u64 = 0xFFFFFA9F
  pub let UVC_BAD_LEN        : u64 = 0xFFFFFA9E
  pub let UVC_BAD_CLASS      : u64 = 0xFFFFFA9D
  pub let UVC_BAD_SUBCLASS   : u64 = 0xFFFFFA9C
  pub let UVC_BAD_HDR_LEN    : u64 = 0xFFFFFA9B
  pub let UVC_BAD_RESERVED   : u64 = 0xFFFFFA9A
  pub let UVC_ERR_BIT_SET    : u64 = 0xFFFFFA99
  pub let UVC_FRAME_OVERSIZE : u64 = 0xFFFFFA98
  pub let UVC_BAD_ARG        : u64 = 0xFFFFFA97

  // Frame-assembly state:
  //   [+0]  frame_bytes (u32) — accumulated bytes in current frame
  //   [+8]  frames_delivered (u64)
  //   [+16] current_fid (u8) — FID of the frame in progress
  //   [+24] in_progress (u8)  — 1 iff a frame is being assembled
  pub let mut _uvc_state : [u64; 4] = uninit @align(64)
  pub let mut _uvc_stats : [u64; 8] = uninit @align(64)

  pub let UVC_ST_HEADERS   : u64 = 0
  pub let UVC_ST_FRAMES    : u64 = 1
  pub let UVC_ST_APPENDS   : u64 = 2
  pub let UVC_ST_REJECTS   : u64 = 3
  pub let UVC_ST_ERR_BITS  : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let uvc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): clear _uvc_state and _uvc_stats. Labels prefixed uvc_rs_.",
      block: {
        lea r10, [rip + _uvc_state];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        lea r10, [rip + _uvc_stats];
        xor rcx, rcx;
      uvc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  uvc_rs_stats;
        ret
      }
    }

  pub let uvc_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-004 (#1189): honesty pin. Returns 0 until a class-driver-selection binds this against a real UVC descriptor.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let uvc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): counter read. Labels prefixed uvc_st_.",
      block: {
        cmp rdi, 8;
        jae uvc_st_zero;
        lea r10, [rip + _uvc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      uvc_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let uvc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): counter bump. Labels prefixed uvc_nt_.",
      block: {
        cmp rdi, 8;
        jae uvc_nt_out;
        lea r10, [rip + _uvc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      uvc_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Class-code + descriptor validators.
  // ==========================================================================

  pub let uvc_class_valid : (u64, u64) -> u64 !{} @{} =
    fn (cls: u64) (sub: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-004 (#1189): 1 iff cls == 0x0E AND sub in {0x01, 0x02}. Labels prefixed uvc_cv_.",
      block: {
        cmp rdi, 0x0E;
        jne uvc_cv_no;
        cmp rsi, 0x01;
        je  uvc_cv_yes;
        cmp rsi, 0x02;
        je  uvc_cv_yes;
      uvc_cv_no:
        xor rax, rax;
        ret;
      uvc_cv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let uvc_header_length_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-004 (#1189): 1 iff n in [2, 12]. Labels prefixed uvc_hv_.",
      block: {
        cmp rdi, 2;
        jb  uvc_hv_no;
        cmp rdi, 12;
        ja  uvc_hv_no;
        mov rax, 1;
        ret;
      uvc_hv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // uvc_header_parse(buf, len) -> (hdr_len | (flags << 8)) | error
  //
  // Reads buf[0] = hdr_len, buf[1] = flags, refuses buf == 0 || len < 2,
  // refuses hdr_len out of [2, 12], refuses reserved bit (0x10) set,
  // refuses len < hdr_len. Bumps ST_HEADERS on success; if ERR bit
  // (0x40) is set, additionally bumps ST_ERR_BITS and returns
  // UVC_ERR_BIT_SET (still after recording the header).
  // ==========================================================================

  pub let uvc_header_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): parse a UVC payload header. Labels prefixed uvc_hp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  uvc_hp_bad_buf;
        cmp r13, 2;
        jb  uvc_hp_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + 0];            // hdr_len
        mov rbx, rax;
        cmp rbx, 2;
        jb  uvc_hp_bad_hdr;
        cmp rbx, 12;
        ja  uvc_hp_bad_hdr;
        cmp r13, rbx;
        jb  uvc_hp_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + 1];            // flags
        mov rcx, rax;

        // Reserved bit (0x10) must be zero.
        mov r10, rax;
        and r10, 0x10;
        cmp r10, 0;
        jne uvc_hp_bad_res;

        mov rdi, 0;                      // ST_HEADERS
        call uvc_note;

        // ERR bit (0x40)?
        mov r10, rcx;
        and r10, 0x40;
        cmp r10, 0;
        jne uvc_hp_err;

        // Pack hdr_len | (flags << 8).
        mov rax, rbx;
        and rax, 0xFF;
        mov r11, rcx;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        jmp uvc_hp_out;

      uvc_hp_err:
        mov rdi, 4;                      // ST_ERR_BITS
        call uvc_note;
        mov rax, 0xFFFFFA99;
        jmp uvc_hp_out;
      uvc_hp_bad_buf:
        mov rdi, 3;
        call uvc_note;
        mov rax, 0xFFFFFA9F;
        jmp uvc_hp_out;
      uvc_hp_bad_len:
        mov rdi, 3;
        call uvc_note;
        mov rax, 0xFFFFFA9E;
        jmp uvc_hp_out;
      uvc_hp_bad_hdr:
        mov rdi, 3;
        call uvc_note;
        mov rax, 0xFFFFFA9B;
        jmp uvc_hp_out;
      uvc_hp_bad_res:
        mov rdi, 3;
        call uvc_note;
        mov rax, 0xFFFFFA9A;

      uvc_hp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // uvc_header_pts(buf) -> u32 PTS (assumes bit 2 already set)
  // ==========================================================================

  pub let uvc_header_pts : (u64) -> u64 !{mem} @{} =
    fn (buf: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): PTS at buf[+2..+6]. Caller must have confirmed PTS bit set. Labels prefixed uvc_pt_.",
      block: {
        cmp rdi, 0;
        je  uvc_pt_bad;
        xor rax, rax;
        mov eax, [rdi + 2];
        ret;
      uvc_pt_bad:
        mov rax, 0xFFFFFA9F;
        ret
      }
    }

  pub let uvc_header_scr_stc : (u64) -> u64 !{mem} @{} =
    fn (buf: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): SCR STC at buf[+6..+10]. Assumes PTS+SCR both present (offset 6). Labels prefixed uvc_sc_.",
      block: {
        cmp rdi, 0;
        je  uvc_sc_bad;
        xor rax, rax;
        mov eax, [rdi + 6];
        ret;
      uvc_sc_bad:
        mov rax, 0xFFFFFA9F;
        ret
      }
    }

  pub let uvc_header_scr_sof : (u64) -> u64 !{mem} @{} =
    fn (buf: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): SCR SOF-token at buf[+10..+12]. Labels prefixed uvc_ss_.",
      block: {
        cmp rdi, 0;
        je  uvc_ss_bad;
        xor rax, rax;
        mov ax, [rdi + 10];
        ret;
      uvc_ss_bad:
        mov rax, 0xFFFFFA9F;
        ret
      }
    }

  // ==========================================================================
  // Frame-assembly state.
  // ==========================================================================

  pub let uvc_frame_bytes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): accumulated bytes in the frame in progress. Labels prefixed uvc_fb_.",
      block: {
        lea r10, [rip + _uvc_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let uvc_frames_delivered : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): count of completed frames. Labels prefixed uvc_fd_.",
      block: {
        lea r10, [rip + _uvc_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let uvc_current_fid : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): FID of the frame in progress.",
      block: {
        lea r10, [rip + _uvc_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let uvc_in_progress : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): 1 iff a frame is being assembled.",
      block: {
        lea r10, [rip + _uvc_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  // ==========================================================================
  // uvc_frame_append(payload_bytes, flags) -> OK | error
  //
  // Adds `payload_bytes` (already-parsed body-bytes count) to the
  // current frame's accumulator. Refuses total > UVC_FRAME_MAX_BYTES.
  // A change of FID (frame-id toggle) implicitly starts a new frame:
  // the accumulator is reset before the append. EOF finalises: the
  // frame counter is bumped and the accumulator is reset for the next
  // frame.
  // ==========================================================================

  pub let uvc_frame_append : (u64, u64) -> u64 !{mem} @{} =
    fn (payload_bytes: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-004 (#1189): append body bytes to current frame; honour FID toggle and EOF. Labels prefixed uvc_fa_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // payload_bytes
        mov r13, rsi;                    // flags

        lea r10, [rip + _uvc_state];
        mov rax, [r10 + 16];             // current_fid
        mov r11, r13;
        and r11, 1;                      // new FID
        mov rcx, [r10 + 24];             // in_progress

        // If in_progress AND fid changed, we lost EOF for prior frame:
        // finalize implicitly, reset accumulator.
        cmp rcx, 0;
        je  uvc_fa_fresh;
        cmp rax, r11;
        je  uvc_fa_same_fid;

      uvc_fa_fresh:
        // Start new frame.
        xor rax, rax;
        mov [r10 + 0], rax;              // frame_bytes = 0
        mov [r10 + 16], r11;             // current_fid = new FID
        mov rax, 1;
        mov [r10 + 24], rax;             // in_progress = 1

      uvc_fa_same_fid:
        // Accumulate.
        mov rax, [r10 + 0];
        add rax, r12;
        mov rcx, 65536;
        cmp rax, rcx;
        ja  uvc_fa_oversize;
        mov [r10 + 0], rax;

        mov rdi, 2;                      // APPENDS
        call uvc_note;

        // EOF?
        lea r10, [rip + _uvc_state];
        mov rax, r13;
        and rax, 2;                      // EOF bit
        cmp rax, 0;
        je  uvc_fa_ok;

        // Finalize: bump delivered, reset accumulator + in_progress.
        mov rcx, [r10 + 8];
        add rcx, 1;
        mov [r10 + 8], rcx;
        xor rcx, rcx;
        mov [r10 + 0],  rcx;
        mov [r10 + 24], rcx;

        mov rdi, 1;                      // ST_FRAMES
        call uvc_note;

      uvc_fa_ok:
        xor rax, rax;
        jmp uvc_fa_out;

      uvc_fa_oversize:
        mov rdi, 3;
        call uvc_note;
        mov rax, 0xFFFFFA98;

      uvc_fa_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
