// src/kernel/core/drivers/usb/hub_driver.pdx — R34.M1-001 (#1167)
//
// The kernel's USB HUB CLASS DRIVER, in scaffold form. Decodes a
// STANDARD USB HUB DESCRIPTOR (USB 2.0 §11.23.2.1) supplied as a
// bytes buffer, and reports port count, hub characteristics, power-
// on-to-power-good delay, controller current requirement, and the
// per-port device-removable bitmask. NO USB CONTROL TRANSFER runs
// from this module.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DESCRIPTOR-DECODE half of the R34 USB HUB CLASS DRIVER.
// The T14 G4 wires two upstream root hubs (an xHCI USB2 root and a
// USB3 root) and holds a Thunderbolt 4 controller downstream of the
// PCH. When R34.M2 lands the USB2/USB3 root-hub descriptor fetches,
// this module DECODES their responses; the fetch itself is a
// KIND_USB_DEVICE control transfer that the class driver in ring 3
// issues, and its result — a bytes buffer — is what this module
// consumes.
//
// IT IS NOT A LIVE DRIVER. Same discipline as backlight_pwm.pdx §0.
// The seams are stated as SCAFFOLDS, the honesty pin
// `hub_driver_arbitrated() == 0` — an assertion the boot witness
// will one day break when a real xhci control transfer plumbs
// through — forces the design doc to be updated at that time.
//
// IT DOES NOT MINT CAPABILITIES. Hub capabilities arrive through
// kind_usb_hub.pdx's mint; this module decodes descriptor bytes.
//
// =============================================================================
// §1  STANDARD HUB DESCRIPTOR — USB 2.0 §11.23.2.1
// =============================================================================
//
// Offset  Field                       Size  Purpose
// ------  -------------------------   ----  ---------------------------
//   0     bLength                     1     descriptor length in bytes
//   1     bDescriptorType             1     0x29 (hub descriptor)
//   2     bNbrPorts                   1     downstream-facing port count
//                                           (1..15 per USB 2.0 spec)
//   3     wHubCharacteristics         2     Little-endian:
//                                           [1:0]  power-switching mode
//                                           [2]    compound device
//                                           [4:3]  over-current mode
//                                           [6:5]  TT think time
//                                           [7]    port indicators
//   5     bPwrOn2PwrGood              1     power-on delay in 2 ms units
//   6     bHubContrCurrent            1     controller current (mA)
//   7...  DeviceRemovable[]           N     one bit per port, LSB = port 1
//                                           bit set means port is
//                                           non-removable (i.e. built-in)
//
// Descriptor length is at LEAST 8 bytes for a 1..7-port hub, and one
// extra byte per additional 8 ports; the largest legitimate value is
// 9 bytes (15 ports). This module refuses a descriptor with:
//   * bLength < 8 or > 9 (out of the two legitimate sizes)
//   * bDescriptorType != 0x29
//   * bNbrPorts < 1 or > 15 (kind_usb_hub.pdx's PORT_MAX)
//
// =============================================================================
// §2  ONE WRITER OF THE COUNTERS
// =============================================================================
//
// Same discipline as sensor_hub §2: hub_driver_decode is the ONE
// writer of _hub_driver_stats. A second writer would be a second
// path claiming a descriptor was decoded without the length gate.
//
// tools/build.sh confines relocations against `_hub_driver_stats` to
// this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// A descriptor with a wrong length, wrong type byte, or an
// out-of-range bNbrPorts is REFUSED with a distinct code; nothing
// clamps a value the caller supplied.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO CONTROL TRANSFER runs from this module. The GET_DESCRIPTOR
//     (Hub) control transfer that fetches the descriptor from the
//     hub itself is a KIND_USB_DEVICE authority the ring-3 class
//     driver holds; this module consumes its output.
//
//   * NO PORT ENUMERATION. The FSM in hub_fsm.pdx tracks per-port
//     state; this module only decodes the descriptor.
//
//   * NO ARBITRATION against the platform's own hub firmware.
//     hub_driver_arbitrated() returns 0; the boot witness pins it.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCC0..0xFFFFFCCF
// =============================================================================

module HubDriver = structure {

  pub let HUB_DESC_TYPE           : u64 = 0x29
  pub let HUB_DESC_MIN_LEN        : u64 = 8
  pub let HUB_DESC_MAX_LEN        : u64 = 9

  pub let HUB_DRV_OK              : u64 = 0
  pub let HUB_DRV_BAD_LENGTH      : u64 = 0xFFFFFCCF
  pub let HUB_DRV_BAD_TYPE        : u64 = 0xFFFFFCCE
  pub let HUB_DRV_BAD_PORTS       : u64 = 0xFFFFFCCD
  pub let HUB_DRV_BAD_ARG         : u64 = 0xFFFFFCCC
  pub let HUB_DRV_NOT_BOUND       : u64 = 0xFFFFFCCB

  pub let HUB_DRV_DECODE_BAD      : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _hub_driver_bound : u64 = 0
  pub let mut _hub_driver_stats : [u64; 8] = uninit @align(64)

  pub let HUB_DRV_ST_DECODES     : u64 = 0
  pub let HUB_DRV_ST_BAD_LENGTH  : u64 = 1
  pub let HUB_DRV_ST_BAD_TYPE    : u64 = 2
  pub let HUB_DRV_ST_BAD_PORTS   : u64 = 3
  pub let HUB_DRV_ST_BINDS       : u64 = 4

  // ==========================================================================
  // hub_driver_reset() — teardown.
  // ==========================================================================

  pub let hub_driver_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-001 (#1167): clear bind flag and counters. Labels prefixed hdrv_rs_.",
      block: {
        lea r10, [rip + _hub_driver_bound];
        xor rax, rax;
        mov [r10], rax;
        lea r10, [rip + _hub_driver_stats];
        xor rcx, rcx;
      hdrv_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hdrv_rs_loop;
        ret
      }
    } @no_frame

  pub let hub_driver_bind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-001 (#1167): mark bound. ARITY ZERO — a real bind takes a KIND_USB_HUB. Labels prefixed hdrv_bd_.",
      block: {
        lea r10, [rip + _hub_driver_bound];
        mov rax, 1;
        mov [r10], rax;
        lea r10, [rip + _hub_driver_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hub_driver_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-001 (#1167): bound flag read. Labels: none.",
      block: {
        lea r10, [rip + _hub_driver_bound];
        mov rax, [r10];
        ret
      }
    } @no_frame

  pub let hub_driver_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): honesty pin — returns 0. Boot witness asserts on the value. Same device backlight_pwm_arbitrated uses.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hub_driver_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-001 (#1167): counter read. Labels prefixed hdrv_st_.",
      block: {
        cmp rdi, 8;
        jae hdrv_st_zero;
        lea r10, [rip + _hub_driver_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hdrv_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hub_driver_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-001 (#1167): counter bump. Labels prefixed hdrv_nt_.",
      block: {
        cmp rdi, 8;
        jae hdrv_nt_out;
        lea r10, [rip + _hub_driver_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hdrv_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // hub_driver_decode(buf_ptr, buf_len) -> packed | error
  //
  // buf_ptr is a caller-supplied byte pointer; buf_len is its
  // length in bytes. Returns a u64 packed as:
  //
  //   [7:0]    bNbrPorts
  //   [15:8]   bLength
  //   [23:16]  bDescriptorType (should be 0x29)
  //   [31:24]  bPwrOn2PwrGood (in 2 ms units)
  //   [39:32]  bHubContrCurrent (mA)
  //   [55:40]  wHubCharacteristics (16 bits)
  //   [63:56]  reserved
  //
  // On failure returns HUB_DRV_BAD_* in the same u64 (the failure
  // codes are all >= 0xFFFFFC00 and no valid decode packs bits
  // [63:56] non-zero, so bit patterns are disjoint).
  //
  // This is a PURE READ of the caller's buffer; it neither writes
  // memory outside _hub_driver_stats nor issues any transfer.
  // ==========================================================================

  pub let hub_driver_decode : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-001 (#1167): decode a standard USB hub descriptor. Gates: (1) len in [MIN_LEN, MAX_LEN] else BAD_LENGTH. (2) buf != 0 else BAD_ARG. (3) buf[0] == len else BAD_LENGTH (self-length check). (4) buf[1] == HUB_DESC_TYPE (0x29) else BAD_TYPE. (5) buf[2] in [1, 15] else BAD_PORTS. Pack the five fields. Labels prefixed hdrv_dc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // buf
        mov r13, rsi;                    // len

        cmp r12, 0;
        je  hdrv_dc_bad_arg;

        cmp r13, 8;
        jb  hdrv_dc_bad_length;
        cmp r13, 9;
        ja  hdrv_dc_bad_length;

        // buf[0] = bLength must equal `len` supplied by caller.
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, r13;
        jne hdrv_dc_bad_length;

        // buf[1] = bDescriptorType == 0x29.
        xor rax, rax;
        mov_b rax, [r12 + 1];
        cmp rax, 0x29;
        jne hdrv_dc_bad_type;

        // buf[2] = bNbrPorts in [1,15].
        xor rax, rax;
        mov_b rax, [r12 + 2];
        cmp rax, 1;
        jb  hdrv_dc_bad_ports;
        cmp rax, 15;
        ja  hdrv_dc_bad_ports;
        mov rbx, rax;                    // rbx = bNbrPorts

        // Pack.
        mov rax, rbx;
        and rax, 0xFF;                   // rax = ports [7:0]

        // Add bLength << 8.
        xor r10, r10;
        mov_b r10, [r12];
        shl r10, 8;
        or  rax, r10;

        // Add bDescriptorType << 16.
        xor r10, r10;
        mov_b r10, [r12 + 1];
        shl r10, 16;
        or  rax, r10;

        // Add bPwrOn2PwrGood << 24.
        xor r10, r10;
        mov_b r10, [r12 + 5];
        shl r10, 24;
        or  rax, r10;

        // Add bHubContrCurrent << 32.
        xor r10, r10;
        mov_b r10, [r12 + 6];
        shl r10, 32;
        or  rax, r10;

        // Add wHubCharacteristics [55:40] (little-endian pair at offsets 3,4).
        xor r10, r10;
        mov_b r10, [r12 + 3];
        xor r11, r11;
        mov_b r11, [r12 + 4];
        shl r11, 8;
        or  r10, r11;                    // r10 = 16-bit wHubCharacteristics
        shl r10, 40;
        or  rax, r10;

        mov r14, rax;                    // save packed value

        mov rdi, 0;                      // ST_DECODES
        call hub_driver_note;

        mov rax, r14;
        jmp hdrv_dc_out;

      hdrv_dc_bad_length:
        mov rdi, 1;
        call hub_driver_note;
        mov rax, 0xFFFFFCCF;
        jmp hdrv_dc_out;
      hdrv_dc_bad_type:
        mov rdi, 2;
        call hub_driver_note;
        mov rax, 0xFFFFFCCE;
        jmp hdrv_dc_out;
      hdrv_dc_bad_ports:
        mov rdi, 3;
        call hub_driver_note;
        mov rax, 0xFFFFFCCD;
        jmp hdrv_dc_out;
      hdrv_dc_bad_arg:
        mov rax, 0xFFFFFCCC;

      hdrv_dc_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Field accessors on a packed decode result.
  //
  //   hub_desc_ports(packed)  -> bNbrPorts
  //   hub_desc_length(packed) -> bLength
  //   hub_desc_type(packed)   -> bDescriptorType
  //   hub_desc_pwron(packed)  -> bPwrOn2PwrGood
  //   hub_desc_curr(packed)   -> bHubContrCurrent
  //   hub_desc_chars(packed)  -> wHubCharacteristics
  //   hub_desc_tt(packed)     -> 0/1 derived from wHubCharacteristics[6:5]
  //
  // Every accessor takes a packed value and does bitfield extraction.
  // Refuses a packed value whose high byte is non-zero (that is where
  // an error code would sit).
  // ==========================================================================

  pub let hub_desc_ok : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): 1 iff packed decode result is valid (bits [63:56] zero). Error codes are all >= 0xFFFFFC00 with bit patterns in the high bytes. Labels prefixed hdrv_ok_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne hdrv_ok_no;
        mov rax, 1;
        ret;
      hdrv_ok_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let hub_desc_ports : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): bits [7:0]. Labels: none.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hub_desc_length : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): bits [15:8].",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hub_desc_type : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): bits [23:16].",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hub_desc_pwron : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): bits [31:24]. Units are 2 ms per spec §11.23.2.1.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hub_desc_curr : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): bits [39:32]. Milliamperes.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hub_desc_chars : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): bits [55:40] — 16-bit wHubCharacteristics.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame

  pub let hub_desc_tt : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-001 (#1167): 1 iff wHubCharacteristics[6:5] non-zero (TT think time present). Labels prefixed hdrv_tt_.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFFFF;                 // wHubCharacteristics
        shr rax, 5;
        and rax, 0x3;
        cmp rax, 0;
        je  hdrv_tt_no;
        mov rax, 1;
        ret;
      hdrv_tt_no:
        xor rax, rax;
        ret
      }
    } @no_frame
}
