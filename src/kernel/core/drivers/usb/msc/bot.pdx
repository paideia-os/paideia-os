// src/kernel/core/drivers/usb/msc/bot.pdx — R34.M3-001 (#1176)
//
// USB Mass Storage Class BULK-ONLY TRANSPORT (BOT), per USB Mass
// Storage Class Bulk-Only Transport, rev 1.0.
//
// This module SCAFFOLDS BOT's Command Block Wrapper / Command Status
// Wrapper (§5.1/§5.2) and the two class-specific control requests
// (§3): Bulk-Only Mass Storage Reset (0xFF) and Get Max LUN (0xFE).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WIRE-FRAME half of BOT. Class drivers in ring 3 will use
// bot_cbw_pack to build a 31-byte CBW into a caller-supplied buffer,
// bot_csw_unpack to decode a 13-byte CSW returned by the device, and
// bot_class_request_valid to gate the two class-specific setup
// packets. IT DOES NOT ISSUE ANY BULK TRANSFER. Bulk transfer
// authority arrives through KIND_USB_ENDPOINT + KIND_USB_URB (R34.M3
// -004 #1179); this module produces the bytes those transfers carry.
//
// IT IS NOT A LIVE DRIVER. bot_arbitrated() returns 0 until R34.M3
// wires this into a class driver that consumes real xHCI completions.
//
// =============================================================================
// §1  CBW LAYOUT — USB MSC BOT §5.1
// =============================================================================
//
// 31 bytes, little-endian:
//   [+0]   dCBWSignature       u32 = 0x43425355 ('USBC')
//   [+4]   dCBWTag             u32 (echoed in CSW)
//   [+8]   dCBWDataTransferLength u32
//   [+12]  bmCBWFlags          u8  (bit 7 = direction: 1 = IN, 0 = OUT;
//                                    all other bits reserved-zero)
//   [+13]  bCBWLUN             u8  (low nibble, high nibble reserved-zero)
//   [+14]  bCBWCBLength        u8  (SCSI CDB length, 1..16)
//   [+15]  CBWCB[16]           16 bytes SCSI CDB
//
// =============================================================================
// §2  CSW LAYOUT — USB MSC BOT §5.2
// =============================================================================
//
// 13 bytes, little-endian:
//   [+0]   dCSWSignature       u32 = 0x53425355 ('USBS')
//   [+4]   dCSWTag             u32 (must match CBW tag)
//   [+8]   dCSWDataResidue     u32
//   [+12]  bCSWStatus          u8  (0 = OK, 1 = FAILED, 2 = PHASE_ERROR)
//
// =============================================================================
// §3  CLASS-SPECIFIC REQUESTS — USB MSC BOT §3
// =============================================================================
//
// Bulk-Only Mass Storage Reset: bRequest = 0xFF, wValue = 0,
//   wIndex = interface, wLength = 0.
// Get Max LUN:                    bRequest = 0xFE, wValue = 0,
//   wIndex = interface, wLength = 1.  Response: 1 byte, LUN 0..15.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFB50..0xFFFFFB5F
// =============================================================================

module Bot = structure {

  pub let BOT_CBW_SIG : u64 = 0x43425355     // 'USBC'
  pub let BOT_CSW_SIG : u64 = 0x53425355     // 'USBS'

  pub let BOT_CBW_LEN : u64 = 31
  pub let BOT_CSW_LEN : u64 = 13

  pub let BOT_DIR_OUT : u64 = 0
  pub let BOT_DIR_IN  : u64 = 1

  pub let BOT_STATUS_OK          : u64 = 0
  pub let BOT_STATUS_FAILED      : u64 = 1
  pub let BOT_STATUS_PHASE_ERROR : u64 = 2

  pub let BOT_REQ_RESET       : u64 = 0xFF
  pub let BOT_REQ_GET_MAX_LUN : u64 = 0xFE

  pub let BOT_CDB_LEN_MIN : u64 = 1
  pub let BOT_CDB_LEN_MAX : u64 = 16

  pub let BOT_LUN_MAX : u64 = 15

  pub let BOT_OK              : u64 = 0
  pub let BOT_BAD_BUF         : u64 = 0xFFFFFB5F
  pub let BOT_BAD_LEN         : u64 = 0xFFFFFB5E
  pub let BOT_BAD_SIG         : u64 = 0xFFFFFB5D
  pub let BOT_BAD_DIR         : u64 = 0xFFFFFB5C
  pub let BOT_BAD_LUN         : u64 = 0xFFFFFB5B
  pub let BOT_BAD_CDB_LEN     : u64 = 0xFFFFFB5A
  pub let BOT_BAD_STATUS      : u64 = 0xFFFFFB59
  pub let BOT_BAD_REQUEST     : u64 = 0xFFFFFB58
  pub let BOT_TAG_MISMATCH    : u64 = 0xFFFFFB57
  pub let BOT_BAD_RESERVED    : u64 = 0xFFFFFB56

  pub let mut _bot_stats : [u64; 8] = uninit @align(64)

  pub let BOT_ST_CBW_PACKS  : u64 = 0
  pub let BOT_ST_CSW_UNPACKS: u64 = 1
  pub let BOT_ST_REJECTS    : u64 = 2

  // ==========================================================================
  // bot_reset() — counters only; scaffold has no live state.
  // ==========================================================================

  pub let bot_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): clear bot stats. Labels prefixed bot_rs_.",
      block: {
        lea r10, [rip + _bot_stats];
        xor rax, rax;
        xor rcx, rcx;
      bot_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bot_rs_loop;
        ret
      }
    }

  pub let bot_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): honesty pin. Returns 0 until R34.M3 wires a class driver. Boot witness asserts on this value.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let bot_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): counter read. Labels prefixed bot_st_.",
      block: {
        cmp rdi, 8;
        jae bot_st_zero;
        lea r10, [rip + _bot_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bot_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let bot_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): counter bump. Labels prefixed bot_nt_.",
      block: {
        cmp rdi, 8;
        jae bot_nt_out;
        lea r10, [rip + _bot_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bot_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let bot_lun_valid : (u64) -> u64 !{} @{} =
    fn (lun: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): 1 iff lun <= 15. Labels prefixed bot_lv_.",
      block: {
        cmp rdi, 15;
        ja  bot_lv_no;
        mov rax, 1;
        ret;
      bot_lv_no:
        xor rax, rax;
        ret
      }
    }

  pub let bot_dir_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): 1 iff d <= 1. Labels prefixed bot_dv_.",
      block: {
        cmp rdi, 1;
        ja  bot_dv_no;
        mov rax, 1;
        ret;
      bot_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let bot_cdb_len_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): 1 iff l in [1, 16]. Labels prefixed bot_cv_.",
      block: {
        cmp rdi, 1;
        jb  bot_cv_no;
        cmp rdi, 16;
        ja  bot_cv_no;
        mov rax, 1;
        ret;
      bot_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let bot_status_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): 1 iff s <= 2. Labels prefixed bot_sv_.",
      block: {
        cmp rdi, 2;
        ja  bot_sv_no;
        mov rax, 1;
        ret;
      bot_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let bot_class_request_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-001 (#1176): 1 iff r in {0xFE, 0xFF}. Labels prefixed bot_rv_.",
      block: {
        cmp rdi, 0xFE;
        je  bot_rv_yes;
        cmp rdi, 0xFF;
        je  bot_rv_yes;
        xor rax, rax;
        ret;
      bot_rv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // bot_cbw_pack(buf, tag, dxfer_len, direction, lun, cdb_len) -> OK | error
  //
  // Writes fields [+0..+14] of the 31-byte CBW into buf. Caller
  // must fill CBWCB[0..cdb_len-1] itself starting at buf+15 — this
  // module does NOT touch CDB bytes because SCSI is a separate layer.
  // Bytes CBWCB[cdb_len..15] MUST be zero on the wire; caller is
  // responsible.
  // ==========================================================================

  pub let bot_cbw_pack : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (tag: u64) (dxfer_len: u64) (direction: u64) (lun: u64) (cdb_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): CBW header pack. Six args because SysV has six argument regs; CBW's own layout is longer but every non-header field is caller-supplied. Sequence: buf != 0; dir_valid; lun_valid; cdb_len_valid; write sig[+0], tag[+4], dxfer[+8], flags[+12], lun[+13], cdb_len[+14]. Labels prefixed bot_pk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;
        mov r15, r8;
        mov rbp, r9;

        cmp rbx, 0;
        je  bot_pk_bad_buf;

        mov rdi, r14;
        call bot_dir_valid;
        cmp rax, 0;
        je  bot_pk_bad_dir;

        mov rdi, r15;
        call bot_lun_valid;
        cmp rax, 0;
        je  bot_pk_bad_lun;

        mov rdi, rbp;
        call bot_cdb_len_valid;
        cmp rax, 0;
        je  bot_pk_bad_cdb_len;

        // sig
        mov rax, 0x43425355;
        mov [rbx + 0], eax;
        // tag
        mov rax, r12;
        mov [rbx + 4], eax;
        // dxfer_len
        mov rax, r13;
        mov [rbx + 8], eax;
        // flags: direction << 7
        xor rax, rax;
        mov r10, r14;
        and r10, 1;
        shl r10, 7;
        or  rax, r10;
        mov [rbx + 12], al;
        // lun
        mov rax, r15;
        and rax, 0x0F;
        mov [rbx + 13], al;
        // cdb_len
        mov rax, rbp;
        and rax, 0x1F;
        mov [rbx + 14], al;

        mov rdi, 0;
        call bot_note;

        xor rax, rax;
        jmp bot_pk_out;

      bot_pk_bad_buf:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB5F;
        jmp bot_pk_out;
      bot_pk_bad_dir:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB5C;
        jmp bot_pk_out;
      bot_pk_bad_lun:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB5B;
        jmp bot_pk_out;
      bot_pk_bad_cdb_len:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB5A;

      bot_pk_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bot_csw_unpack_status(buf, len, expected_tag) -> status | error
  //
  // Decodes a 13-byte CSW at buf. Refuses:
  //   len != 13     -> BAD_LEN
  //   buf == 0      -> BAD_BUF
  //   sig != USBS   -> BAD_SIG
  //   tag != expect -> TAG_MISMATCH
  //   status > 2    -> BAD_STATUS
  // Returns the status byte (0/1/2) on success.
  // ==========================================================================

  pub let bot_csw_unpack_status : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (expected_tag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): CSW decode, returns status byte on success. Labels prefixed bot_uk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  bot_uk_bad_buf;
        cmp r13, 13;
        jne bot_uk_bad_len;

        xor rax, rax;
        mov eax, [r12 + 0];
        mov r10, 0x53425355;
        cmp rax, r10;
        jne bot_uk_bad_sig;

        xor rax, rax;
        mov eax, [r12 + 4];
        mov r10, r14;
        and r10, 0xFFFFFFFF;
        cmp rax, r10;
        jne bot_uk_tag_mm;

        xor rax, rax;
        mov_b rax, [r12 + 12];
        cmp rax, 2;
        ja  bot_uk_bad_status;

        mov r10, rax;
        mov rdi, 1;
        call bot_note;
        mov rax, r10;
        jmp bot_uk_out;

      bot_uk_bad_buf:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB5F;
        jmp bot_uk_out;
      bot_uk_bad_len:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB5E;
        jmp bot_uk_out;
      bot_uk_bad_sig:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB5D;
        jmp bot_uk_out;
      bot_uk_tag_mm:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB57;
        jmp bot_uk_out;
      bot_uk_bad_status:
        mov rdi, 2;
        call bot_note;
        mov rax, 0xFFFFFB59;

      bot_uk_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bot_csw_unpack_residue(buf, len) -> residue | error
  // ==========================================================================

  pub let bot_csw_unpack_residue : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-001 (#1176): CSW residue field, gated on sig. Labels prefixed bot_ur_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  bot_ur_bad_buf;
        cmp r13, 13;
        jne bot_ur_bad_len;

        xor rax, rax;
        mov eax, [r12 + 0];
        mov r10, 0x53425355;
        cmp rax, r10;
        jne bot_ur_bad_sig;

        xor rax, rax;
        mov eax, [r12 + 8];
        jmp bot_ur_out;

      bot_ur_bad_buf:
        mov rax, 0xFFFFFB5F;
        jmp bot_ur_out;
      bot_ur_bad_len:
        mov rax, 0xFFFFFB5E;
        jmp bot_ur_out;
      bot_ur_bad_sig:
        mov rax, 0xFFFFFB5D;

      bot_ur_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
