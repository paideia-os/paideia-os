// src/kernel/core/drivers/usb/msc/uas.pdx — R34.M3-002 (#1177)
//
// USB Attached SCSI (UAS), per UAS revision 1.0.
//
// This module SCAFFOLDS UAS's five Information Units (IUs), the
// stream-ID tagging that runs across bulk-in / bulk-out / status
// endpoints, and the per-tag tracking of outstanding commands.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WIRE-FRAME half of UAS. Class drivers in ring 3 will use
// uas_command_iu_pack / uas_response_iu_unpack (etc.) to build and
// decode IUs against caller-supplied buffers, and use uas_stream_id_
// valid to gate the stream-ID a KIND_USB_ENDPOINT transfer names.
// IT DOES NOT ISSUE ANY BULK TRANSFER. Bulk transfer authority
// arrives through KIND_USB_ENDPOINT + KIND_USB_URB (R34.M3-004
// #1179); this module produces the bytes those transfers carry.
//
// IT IS NOT A LIVE DRIVER. uas_arbitrated() returns 0 until R34.M3
// wires this into a class driver that consumes real xHCI completions.
//
// UAS OVERLAPS BOT: a device that supports UAS also exposes BOT, and
// the class driver chooses which to use per interface alt-setting.
// This module and bot.pdx are DISJOINT — nothing here reads bot.pdx
// or its wire format.
//
// =============================================================================
// §1  IU LAYOUT — UAS §4.3
// =============================================================================
//
// Every IU shares a 4-byte header:
//   [+0]  IU Type            u8
//   [+1]  Reserved           u8 (must be zero)
//   [+2]  Task Tag           u16 big-endian (see §2)
//
// Command IU (§4.3.4, type = 0x01, min 32 bytes):
//   [+4]  Command Priority   u8 (bits [7:5] = priority, bits [4:0] = task attr)
//   [+5]  Reserved           u8
//   [+6]  Additional CDB len u8
//   [+7]  Reserved           u8
//   [+8]  LUN                8 bytes (SAM-4 LUN structure)
//   [+16] CDB[16]            16 bytes SCSI CDB
//   [+32] extended CDB       0..N bytes (matches Additional CDB len)
//
// Response IU (§4.3.5, type = 0x03, 8 bytes):
//   [+4]  Additional Response Info  3 bytes
//   [+7]  Response Code             u8
//
// Read Ready IU  (§4.3.10, type = 0x05, 4 bytes) — header only.
// Write Ready IU (§4.3.11, type = 0x06, 4 bytes) — header only.
//
// Sense IU (§4.3.6, type = 0x07, min 16 bytes):
//   [+4]  Status Qualifier   u16 big-endian
//   [+6]  Status             u8
//   [+7]  Reserved           u8
//   [+8]  Sense Data Length  u16 big-endian
//   [+10] Sense Data         N bytes (matches Sense Data Length)
//
// =============================================================================
// §2  STREAM-ID TAGGING
// =============================================================================
//
// UAS runs each outstanding command on its own bulk endpoint stream.
// The task tag in the IU header names the stream; xHCI's bulk-
// endpoint stream context routes completions per stream. Stream IDs
// are 1..N where N is negotiated at interface enable (typical 16..64
// for a mass-storage device). We refuse stream_id = 0 (reserved)
// and stream_id > UAS_STREAM_ID_MAX.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFB40..0xFFFFFB4F
// =============================================================================

module Uas = structure {

  pub let UAS_IU_TYPE_COMMAND      : u64 = 0x01
  pub let UAS_IU_TYPE_RESPONSE     : u64 = 0x03
  pub let UAS_IU_TYPE_TASK_MGMT    : u64 = 0x04
  pub let UAS_IU_TYPE_READ_READY   : u64 = 0x05
  pub let UAS_IU_TYPE_WRITE_READY  : u64 = 0x06
  pub let UAS_IU_TYPE_SENSE        : u64 = 0x07

  pub let UAS_IU_TYPE_MIN : u64 = 1
  pub let UAS_IU_TYPE_MAX : u64 = 7

  pub let UAS_IU_HDR_LEN         : u64 = 4
  pub let UAS_IU_COMMAND_MIN_LEN : u64 = 32
  pub let UAS_IU_RESPONSE_LEN    : u64 = 8
  pub let UAS_IU_READY_LEN       : u64 = 4
  pub let UAS_IU_SENSE_MIN_LEN   : u64 = 16

  pub let UAS_STREAM_ID_MIN : u64 = 1
  pub let UAS_STREAM_ID_MAX : u64 = 65535

  pub let UAS_OK              : u64 = 0
  pub let UAS_BAD_BUF         : u64 = 0xFFFFFB4F
  pub let UAS_BAD_LEN         : u64 = 0xFFFFFB4E
  pub let UAS_BAD_IU_TYPE     : u64 = 0xFFFFFB4D
  pub let UAS_BAD_STREAM_ID   : u64 = 0xFFFFFB4C
  pub let UAS_BAD_CDB_ADD_LEN : u64 = 0xFFFFFB4B
  pub let UAS_BAD_RESERVED    : u64 = 0xFFFFFB4A
  pub let UAS_BAD_SENSE_LEN   : u64 = 0xFFFFFB49
  pub let UAS_TAG_MISMATCH    : u64 = 0xFFFFFB48

  pub let mut _uas_stats : [u64; 8] = uninit @align(64)

  pub let UAS_ST_CMD_PACKS  : u64 = 0
  pub let UAS_ST_RSP_UNPACKS: u64 = 1
  pub let UAS_ST_READY_UNPACKS : u64 = 2
  pub let UAS_ST_SENSE_UNPACKS : u64 = 3
  pub let UAS_ST_REJECTS    : u64 = 4

  pub let uas_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): clear uas stats. Labels prefixed uas_rs_.",
      block: {
        lea r10, [rip + _uas_stats];
        xor rax, rax;
        xor rcx, rcx;
      uas_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  uas_rs_loop;
        ret
      }
    }

  pub let uas_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-002 (#1177): honesty pin. Returns 0 until R34.M3 wires a class driver.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let uas_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): counter read. Labels prefixed uas_st_.",
      block: {
        cmp rdi, 8;
        jae uas_st_zero;
        lea r10, [rip + _uas_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      uas_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let uas_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): counter bump. Labels prefixed uas_nt_.",
      block: {
        cmp rdi, 8;
        jae uas_nt_out;
        lea r10, [rip + _uas_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      uas_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let uas_iu_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-002 (#1177): 1 iff t in {1,3,4,5,6,7}. Labels prefixed uas_tv_.",
      block: {
        cmp rdi, 1;
        je  uas_tv_yes;
        cmp rdi, 3;
        je  uas_tv_yes;
        cmp rdi, 4;
        je  uas_tv_yes;
        cmp rdi, 5;
        je  uas_tv_yes;
        cmp rdi, 6;
        je  uas_tv_yes;
        cmp rdi, 7;
        je  uas_tv_yes;
        xor rax, rax;
        ret;
      uas_tv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let uas_stream_id_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-002 (#1177): 1 iff s in [1, 65535]. 0 is reserved. Labels prefixed uas_sv_.",
      block: {
        cmp rdi, 1;
        jb  uas_sv_no;
        cmp rdi, 65535;
        ja  uas_sv_no;
        mov rax, 1;
        ret;
      uas_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // uas_iu_hdr_pack(buf, iu_type, stream_id) -> OK | error
  //
  // Writes the 4-byte IU header. Caller writes payload bytes past +4.
  // Reserved byte at [+1] is zero.
  // ==========================================================================

  pub let uas_iu_hdr_pack : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (iu_type: u64) (stream_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): pack the 4-byte IU header. Labels prefixed uas_hp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  uas_hp_bad_buf;

        mov rdi, r13;
        call uas_iu_type_valid;
        cmp rax, 0;
        je  uas_hp_bad_type;

        mov rdi, r14;
        call uas_stream_id_valid;
        cmp rax, 0;
        je  uas_hp_bad_stream;

        mov rax, r13;
        and rax, 0xFF;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;
        // Big-endian stream_id at [+2:+3].
        mov rax, r14;
        shr rax, 8;
        and rax, 0xFF;
        mov [r12 + 2], al;
        mov rax, r14;
        and rax, 0xFF;
        mov [r12 + 3], al;

        xor rax, rax;
        jmp uas_hp_out;

      uas_hp_bad_buf:
        mov rax, 0xFFFFFB4F;
        jmp uas_hp_out;
      uas_hp_bad_type:
        mov rax, 0xFFFFFB4D;
        jmp uas_hp_out;
      uas_hp_bad_stream:
        mov rax, 0xFFFFFB4C;

      uas_hp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let uas_iu_hdr_type : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): read the IU type byte. Labels prefixed uas_ut_.",
      block: {
        cmp rdi, 0;
        je  uas_ut_bad;
        cmp rsi, 4;
        jb  uas_ut_bad;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        ret;
      uas_ut_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let uas_iu_hdr_stream : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): read the 16-bit big-endian stream id. Labels prefixed uas_us_.",
      block: {
        cmp rdi, 0;
        je  uas_us_bad;
        cmp rsi, 4;
        jb  uas_us_bad;
        xor rax, rax;
        mov_b rax, [rdi + 2];
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [rdi + 3];
        or  rax, r10;
        ret;
      uas_us_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // uas_command_iu_pack — writes the command header portion (bytes 4..7,
  // LUN 8..15 zero-initialised, then leaves CDB bytes 16..31 for the caller.
  // ==========================================================================

  pub let uas_command_iu_pack : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (stream_id: u64) (task_attr: u64) (add_cdb_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): Command IU header + attr fields. Refuses buf==0, bad stream_id, task_attr[7:5]=priority within [0,7], add_cdb_len (bytes past 16) must be a multiple of 4 and <= 224. Labels prefixed uas_cp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        cmp rbx, 0;
        je  uas_cp_bad_buf;

        mov rdi, r14;
        cmp rdi, 224;
        ja  uas_cp_bad_add;
        mov rax, rdi;
        and rax, 3;
        cmp rax, 0;
        jne uas_cp_bad_add;

        // Write IU header at buf[0..4].
        mov rdi, rbx;
        mov rsi, 1;                      // Command IU
        mov rdx, r12;
        call uas_iu_hdr_pack;
        cmp rax, 0;
        jne uas_cp_hdr_bad;

        // Byte 4 = task_attr (priority in [7:5], attr in [4:0])
        mov rax, r13;
        and rax, 0xFF;
        mov [rbx + 4], al;
        xor rax, rax;
        mov [rbx + 5], al;
        // Byte 6 = additional CDB length (as multiples of 4? spec: bytes)
        mov rax, r14;
        and rax, 0xFF;
        mov [rbx + 6], al;
        xor rax, rax;
        mov [rbx + 7], al;
        // Bytes 8..15 = LUN, zero-initialised (SAM-4 8-byte structure).
        xor rax, rax;
        mov [rbx + 8],  rax;

        mov rdi, 0;
        call uas_note;
        xor rax, rax;
        jmp uas_cp_out;

      uas_cp_bad_buf:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4F;
        jmp uas_cp_out;
      uas_cp_bad_add:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4B;
        jmp uas_cp_out;
      uas_cp_hdr_bad:
        mov rdi, 4;
        call uas_note;
        // Preserve the exact error from uas_iu_hdr_pack.
        jmp uas_cp_out;

      uas_cp_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // uas_response_iu_unpack(buf, len) -> response_code | error
  //   Verifies IU type = 0x03, len >= 8.
  // ==========================================================================

  pub let uas_response_iu_unpack : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): Response IU decode, returns response code. Labels prefixed uas_ru_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  uas_ru_bad_buf;
        cmp r13, 8;
        jb  uas_ru_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + 0];
        cmp rax, 3;
        jne uas_ru_bad_type;

        xor rax, rax;
        mov_b rax, [r12 + 7];
        mov r10, rax;

        mov rdi, 1;
        call uas_note;
        mov rax, r10;
        jmp uas_ru_out;

      uas_ru_bad_buf:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4F;
        jmp uas_ru_out;
      uas_ru_bad_len:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4E;
        jmp uas_ru_out;
      uas_ru_bad_type:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4D;

      uas_ru_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // uas_ready_iu_unpack(buf, len, expected_stream_id) -> iu_type | error
  //   Accepts Read Ready (0x05) or Write Ready (0x06); verifies stream_id.
  // ==========================================================================

  pub let uas_ready_iu_unpack : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (expected_stream: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): Read/Write Ready IU decode. Labels prefixed uas_dy_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  uas_dy_bad_buf;
        cmp r13, 4;
        jb  uas_dy_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + 0];
        cmp rax, 5;
        je  uas_dy_ok_type;
        cmp rax, 6;
        je  uas_dy_ok_type;
        jmp uas_dy_bad_type;

      uas_dy_ok_type:
        mov r10, rax;                    // saved iu_type
        xor rax, rax;
        mov_b rax, [r12 + 2];
        shl rax, 8;
        xor r11, r11;
        mov_b r11, [r12 + 3];
        or  rax, r11;
        cmp rax, r14;
        jne uas_dy_tag_mm;

        mov rdi, 2;
        call uas_note;
        mov rax, r10;
        jmp uas_dy_out;

      uas_dy_bad_buf:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4F;
        jmp uas_dy_out;
      uas_dy_bad_len:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4E;
        jmp uas_dy_out;
      uas_dy_bad_type:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4D;
        jmp uas_dy_out;
      uas_dy_tag_mm:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB48;

      uas_dy_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // uas_sense_iu_unpack_status(buf, len) -> status | error
  // ==========================================================================

  pub let uas_sense_iu_unpack_status : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-002 (#1177): Sense IU decode, returns SCSI status byte. Labels prefixed uas_su_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  uas_su_bad_buf;
        cmp r13, 16;
        jb  uas_su_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + 0];
        cmp rax, 7;
        jne uas_su_bad_type;

        xor rax, rax;
        mov_b rax, [r12 + 8];
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [r12 + 9];
        or  rax, r10;
        // sense_data_len must not exceed the buffer.
        mov r11, r13;
        sub r11, 10;
        cmp rax, r11;
        ja  uas_su_bad_slen;

        xor rax, rax;
        mov_b rax, [r12 + 6];            // status byte

        mov r10, rax;
        mov rdi, 3;
        call uas_note;
        mov rax, r10;
        jmp uas_su_out;

      uas_su_bad_buf:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4F;
        jmp uas_su_out;
      uas_su_bad_len:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4E;
        jmp uas_su_out;
      uas_su_bad_type:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB4D;
        jmp uas_su_out;
      uas_su_bad_slen:
        mov rdi, 4;
        call uas_note;
        mov rax, 0xFFFFFB49;

      uas_su_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
