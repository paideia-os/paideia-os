// src/kernel/core/drivers/usb/composite_bind.pdx — R34.M2-002 (#1173)
//
// The composite-device driver binding table. Records ONE
// (interface_slot, driver_slot) pair per row, enforcing the
// INTERFACE-PER-DRIVER rule: one class driver binds to one USB
// interface, and no two drivers can bind to the same interface.
//
// =============================================================================
// §0  WHY THIS MODULE EXISTS
// =============================================================================
//
// A USB DEVICE address may present SEVERAL interfaces (a composite
// device — the fingerprint reader plus its camera, a headset's audio
// plus its HID buttons). USB 2.0 §9.6.5 and the class-driver dispatch
// model both name the INTERFACE as the driver-binding unit: each
// class driver binds to one interface, distinguished by
// (bInterfaceClass, bInterfaceSubClass, bInterfaceProtocol). Binding
// at the DEVICE level would let a fingerprint driver receive camera
// completion events (or the reverse), because the two would share
// the same enumeration cascade.
//
// This module is the KERNEL-SIDE RECORD of the binding decision the
// class-driver-selection process (in ring 3) made. It answers "which
// driver owns this interface?" for the dispatch path, and refuses to
// let a second driver claim an interface that already has one.
//
// =============================================================================
// §1  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is a TABLE of (interface_slot, driver_slot) pairs, plus an add /
// get / remove API. The slot arguments are OPAQUE cap slot numbers;
// this module does not validate that they name live capabilities.
// That is the caller's job — the mint side of KIND_USB_INTERFACE
// already validated the interface at mint time; the driver side has
// its own registry (kind_driver_cap.pdx). This module is the JOIN.
//
// IT IS NOT A DRIVER DISPATCHER. The kernel does not dispatch driver
// operations here; it records the binding so a completion router (in
// R34.M3+) can consult "which driver was bound to the interface this
// completion belongs to". Fingerprint composite_bind_arbitrated()
// pinned at 0 until R34.M3 lands real class-driver dispatch.
//
// IT DOES NOT MINT ANYTHING. This module holds no authority — a live
// binding is the RECORD of two capabilities the caller ALREADY HELD,
// not a widening of them.
//
// =============================================================================
// §2  ONE WRITER OF THE TABLE
// =============================================================================
//
// composite_bind_add, composite_bind_remove and composite_bind_reset
// are the ONLY writers of _composite_bind_table. A second writer
// could add a duplicate binding without passing the ALREADY_BOUND
// check, letting two drivers "own" the same interface — which is
// exactly the interface-per-driver rule's inversion.
//
// tools/build.sh confines relocations against _composite_bind_table
// and _composite_bind_stats to this object.
//
// =============================================================================
// §3  REFUSE, NEVER OVERWRITE
// =============================================================================
//
// A re-bind (adding a second driver to an interface that already has
// one) is REFUSED with CBIND_ALREADY_BOUND, not silently replaced.
// Silent replacement would let a stale driver-selection race hand
// one interface to two drivers within the resolution window of the
// deduplication counter.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFB80..0xFFFFFB8F
// =============================================================================

module CompositeBind = structure {

  pub let CBIND_OK             : u64 = 0
  pub let CBIND_BAD_INTERFACE  : u64 = 0xFFFFFB8F
  pub let CBIND_BAD_DRIVER     : u64 = 0xFFFFFB8E
  pub let CBIND_ALREADY_BOUND  : u64 = 0xFFFFFB8D
  pub let CBIND_NOT_BOUND      : u64 = 0xFFFFFB8C
  pub let CBIND_ENOSPC         : u64 = 0xFFFFFB8B
  pub let CBIND_BAD_ARG        : u64 = 0xFFFFFB8A

  pub let CBIND_ROW_NONE : u64 = 0xFF

  pub let CBIND_MAX       : u64 = 16
  pub let CBIND_ROW_BYTES : u64 = 24

  //   [+0]  header: in_use[63:56] | interface_slot[15:8]
  //   [+8]  driver_slot
  //   [+16] reserved
  pub let mut _composite_bind_table : [u64; 48] = uninit @align(64)
  pub let mut _composite_bind_stats : [u64; 8]  = uninit @align(64)

  pub let CBIND_ST_BINDS          : u64 = 0
  pub let CBIND_ST_UNBINDS        : u64 = 1
  pub let CBIND_ST_REBIND_REFUSED : u64 = 2
  pub let CBIND_ST_ENOSPC         : u64 = 3

  // ==========================================================================
  // composite_bind_reset() — teardown.
  // ==========================================================================

  pub let composite_bind_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): clear the composite bind table and its counters. Boot and teardown only. Labels prefixed cbind_rs_.",
      block: {
        lea r10, [rip + _composite_bind_table];
        xor rax, rax;
        xor rcx, rcx;
      cbind_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  cbind_rs_rows;

        lea r10, [rip + _composite_bind_stats];
        xor rcx, rcx;
      cbind_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cbind_rs_stats;
        ret
      }
    } @no_frame

  pub let composite_bind_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-002 (#1173): honesty pin. Returns 0 until R34.M3 lands real class-driver dispatch. Boot witness will assert on this value.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let composite_bind_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): counter read. Labels prefixed cbind_st_.",
      block: {
        cmp rdi, 8;
        jae cbind_st_zero;
        lea r10, [rip + _composite_bind_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cbind_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let composite_bind_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): counter bump. Labels prefixed cbind_nt_.",
      block: {
        cmp rdi, 8;
        jae cbind_nt_out;
        lea r10, [rip + _composite_bind_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cbind_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // composite_bind_find(interface_slot) -> row_id | CBIND_ROW_NONE
  // ==========================================================================

  pub let composite_bind_find : (u64) -> u64 !{mem} @{} =
    fn (interface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): linear scan for the row whose interface_slot matches. Labels prefixed cbind_fd_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae cbind_fd_none;

        xor rcx, rcx;
      cbind_fd_scan:
        cmp rcx, 16;
        jae cbind_fd_none;
        lea r10, [rip + _composite_bind_table];
        mov r11, rcx;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;                     // rcx * 24
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cbind_fd_next;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;                   // interface_slot from header
        cmp rax, rdi;
        je  cbind_fd_hit;
      cbind_fd_next:
        add rcx, 1;
        jmp cbind_fd_scan;
      cbind_fd_hit:
        mov rax, rcx;
        ret;
      cbind_fd_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // composite_bind_add(interface_slot, driver_slot) -> row_id | error
  // ==========================================================================

  pub let composite_bind_add : (u64, u64) -> u64 !{mem} @{} =
    fn (interface_slot: u64) (driver_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): claim one binding row. THE ONE WRITER path for adds. Sequence: (1) both slots < 256. (2) find existing row for interface_slot -> ALREADY_BOUND. (3) scan for free row. (4) claim. Labels prefixed cbind_ad_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // interface_slot
        mov r13, rsi;                    // driver_slot

        mov r10, 256;
        cmp r12, r10;
        jae cbind_ad_bad_if;
        cmp r13, r10;
        jae cbind_ad_bad_drv;

        // Check for existing binding first.
        mov rdi, r12;
        call composite_bind_find;
        cmp rax, 0xFF;
        jne cbind_ad_already;

        xor rbx, rbx;
      cbind_ad_scan:
        cmp rbx, 16;
        jae cbind_ad_enospc;

        lea r10, [rip + _composite_bind_table];
        mov r11, rbx;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;                     // rbx * 24
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cbind_ad_claim;

        add rbx, 1;
        jmp cbind_ad_scan;

      cbind_ad_claim:
        // Header: (in_use << 56) | (interface_slot << 8).
        mov rax, r12;
        and rax, 0xFF;
        shl rax, 8;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        xor rax, rax;
        mov [r10 + 16], rax;

        mov rdi, 0;                      // ST_BINDS
        call composite_bind_note;

        mov rax, rbx;
        jmp cbind_ad_out;

      cbind_ad_bad_if:
        mov rax, 0xFFFFFB8F;
        jmp cbind_ad_out;
      cbind_ad_bad_drv:
        mov rax, 0xFFFFFB8E;
        jmp cbind_ad_out;
      cbind_ad_already:
        mov rdi, 2;                      // ST_REBIND_REFUSED
        call composite_bind_note;
        mov rax, 0xFFFFFB8D;
        jmp cbind_ad_out;
      cbind_ad_enospc:
        mov rdi, 3;                      // ST_ENOSPC
        call composite_bind_note;
        mov rax, 0xFFFFFB8B;

      cbind_ad_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // composite_bind_get(interface_slot) -> driver_slot | CBIND_NOT_BOUND
  // ==========================================================================

  pub let composite_bind_get : (u64) -> u64 !{mem} @{} =
    fn (interface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): driver_slot bound to this interface, or NOT_BOUND. Labels prefixed cbind_gt_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        call composite_bind_find;
        mov r13, rax;
        cmp r13, 0xFF;
        je  cbind_gt_none;

        lea r10, [rip + _composite_bind_table];
        mov r11, r13;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp cbind_gt_out;

      cbind_gt_none:
        mov rax, 0xFFFFFB8C;

      cbind_gt_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // composite_bind_remove(interface_slot) -> CBIND_OK | CBIND_NOT_BOUND
  // ==========================================================================

  pub let composite_bind_remove : (u64) -> u64 !{mem} @{} =
    fn (interface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): remove the binding for interface_slot, if any. Labels prefixed cbind_rm_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        call composite_bind_find;
        mov r13, rax;
        cmp r13, 0xFF;
        je  cbind_rm_none;

        lea r10, [rip + _composite_bind_table];
        mov r11, r13;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;

        mov rdi, 1;                      // ST_UNBINDS
        call composite_bind_note;

        xor rax, rax;
        jmp cbind_rm_out;

      cbind_rm_none:
        mov rax, 0xFFFFFB8C;

      cbind_rm_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // composite_bind_count() -> live row count
  // ==========================================================================

  pub let composite_bind_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-002 (#1173): live row count. Labels prefixed cbind_ct_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      cbind_ct_scan:
        cmp rcx, 16;
        jae cbind_ct_done;
        lea r10, [rip + _composite_bind_table];
        mov r11, rcx;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov r11, [r10 + 0];
        shr r11, 56;
        cmp r11, 0;
        je  cbind_ct_next;
        add rax, 1;
      cbind_ct_next:
        add rcx, 1;
        jmp cbind_ct_scan;
      cbind_ct_done:
        ret
      }
    } @no_frame
}
