// src/kernel/core/drivers/usb/interface_parser.pdx — R34.M2-003 (#1174)
//
// The kernel's USB INTERFACE DESCRIPTOR PARSER, in scaffold form.
// Decodes a STANDARD INTERFACE DESCRIPTOR (USB 2.0 §9.6.5) supplied
// as a bytes buffer, and reports interface_number, alt_setting,
// bNumEndpoints, class, subclass and protocol. Plus a single-
// descriptor alt-setting selection helper.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DESCRIPTOR-DECODE half of the R34 USB INTERFACE PARSER.
// A USB device advertises its interfaces through descriptors returned
// by GET_DESCRIPTOR(CONFIGURATION); the class-driver-in-ring-3 fetches
// the config descriptor and walks the interface / endpoint descriptor
// stream it contains. This module DECODES ONE interface descriptor
// at a time.
//
// IT IS NOT A LIVE PARSER OF A WHOLE CONFIG DESCRIPTOR. Real config
// descriptor parsing walks a byte stream containing several
// interfaces and their endpoints. This module handles ONE fixed-size
// interface record and its accessors; the surrounding config-
// descriptor walker is R34.M3 or beyond.
//
// IT IS NOT A LIVE DRIVER. Same discipline as backlight_pwm.pdx §0.
// ifparser_arbitrated() returns 0 until R34.M3 wires this into a
// real config descriptor walker.
//
// IT DOES NOT MINT CAPABILITIES. Interface capabilities arrive
// through kind_usb_interface.pdx's mint; this module decodes bytes.
//
// =============================================================================
// §1  STANDARD INTERFACE DESCRIPTOR — USB 2.0 §9.6.5
// =============================================================================
//
// Offset  Field                     Size  Purpose
// ------  -----------------------   ----  ---------------------------
//   0     bLength                   1     descriptor length (must be 9)
//   1     bDescriptorType           1     0x04 (INTERFACE)
//   2     bInterfaceNumber          1     0..31 (this file's cap)
//   3     bAlternateSetting         1     0..15 (this file's cap)
//   4     bNumEndpoints             1     count of endpoints on this
//                                         interface (excluding ep 0)
//   5     bInterfaceClass           1     USB-IF class code
//   6     bInterfaceSubClass        1     USB-IF subclass code
//   7     bInterfaceProtocol        1     USB-IF protocol code
//   8     iInterface                1     string-descriptor index
//
// This module refuses a descriptor with:
//   * bLength != 9
//   * bDescriptorType != 0x04
//   * bInterfaceNumber > 31
//   * bAlternateSetting > 15
//
// =============================================================================
// §2  ONE WRITER OF THE COUNTERS
// =============================================================================
//
// interface_parse is the ONE writer of _ifparser_stats. tools/build.sh
// confines relocations against `_ifparser_stats` to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// A descriptor with a wrong length, wrong type byte, or out-of-range
// ifnum/alt is REFUSED with a distinct code; nothing clamps a value
// the caller supplied.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFB90..0xFFFFFB9F
// =============================================================================

module InterfaceParser = structure {

  pub let IF_DESC_TYPE : u64 = 0x04
  pub let IF_DESC_LEN  : u64 = 9
  pub let IF_MAX_NUM   : u64 = 31
  pub let IF_MAX_ALT   : u64 = 15

  pub let IFPARSE_OK          : u64 = 0
  pub let IFPARSE_BAD_LENGTH  : u64 = 0xFFFFFB9F
  pub let IFPARSE_BAD_TYPE    : u64 = 0xFFFFFB9E
  pub let IFPARSE_BAD_IFNUM   : u64 = 0xFFFFFB9D
  pub let IFPARSE_BAD_ALT     : u64 = 0xFFFFFB9C
  pub let IFPARSE_BAD_ARG     : u64 = 0xFFFFFB9B
  pub let IFPARSE_NOT_FOUND   : u64 = 0xFFFFFB9A

  pub let IFPARSE_DECODE_BAD  : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _ifparser_stats : [u64; 8] = uninit @align(64)

  pub let IFPARSE_ST_PARSES      : u64 = 0
  pub let IFPARSE_ST_BAD_LENGTH  : u64 = 1
  pub let IFPARSE_ST_BAD_TYPE    : u64 = 2
  pub let IFPARSE_ST_BAD_IFNUM   : u64 = 3
  pub let IFPARSE_ST_BAD_ALT     : u64 = 4
  pub let IFPARSE_ST_ALT_SELECTS : u64 = 5

  // ==========================================================================
  // ifparser_reset() — teardown.
  // ==========================================================================

  pub let ifparser_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-003 (#1174): clear counters. Boot and teardown only. Labels prefixed ifp_rs_.",
      block: {
        lea r10, [rip + _ifparser_stats];
        xor rax, rax;
        xor rcx, rcx;
      ifp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ifp_rs_loop;
        ret
      }
    }

  pub let ifparser_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): honesty pin. Returns 0 until R34.M3 wires this into a real config-descriptor walker. Same discipline as hub_driver_arbitrated.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let ifparser_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-003 (#1174): counter read. Labels prefixed ifp_st_.",
      block: {
        cmp rdi, 8;
        jae ifp_st_zero;
        lea r10, [rip + _ifparser_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ifp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ifparser_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-003 (#1174): counter bump. Labels prefixed ifp_nt_.",
      block: {
        cmp rdi, 8;
        jae ifp_nt_out;
        lea r10, [rip + _ifparser_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ifp_nt_out:
        ret
      }
    }

  // ==========================================================================
  // interface_parse(buf_ptr, buf_len) -> u64 packed | error
  //
  // Packed layout on success:
  //   [7:0]    bInterfaceNumber
  //   [15:8]   bAlternateSetting
  //   [23:16]  bNumEndpoints
  //   [31:24]  bInterfaceClass
  //   [39:32]  bInterfaceSubClass
  //   [47:40]  bInterfaceProtocol
  //   [55:48]  bLength (always 9 for a valid parse)
  //   [63:56]  reserved (zero)
  //
  // Error codes are all >= 0xFFFFFB00 with bit patterns in the high
  // bytes, so bit patterns are disjoint from valid packs.
  // ==========================================================================

  pub let interface_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-003 (#1174): decode a standard USB interface descriptor. Gates: (1) buf != 0 else BAD_ARG. (2) len >= 9 else BAD_LENGTH. (3) buf[0] == 9 else BAD_LENGTH. (4) buf[1] == 0x04 else BAD_TYPE. (5) buf[2] <= 31 else BAD_IFNUM. (6) buf[3] <= 15 else BAD_ALT. Pack the six fields. Labels prefixed ifp_dc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // buf
        mov r13, rsi;                    // len

        cmp r12, 0;
        je  ifp_dc_bad_arg;

        cmp r13, 9;
        jb  ifp_dc_bad_length;

        // buf[0] = bLength must equal 9.
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 9;
        jne ifp_dc_bad_length;

        // buf[1] = bDescriptorType == 0x04.
        xor rax, rax;
        mov_b rax, [r12 + 1];
        cmp rax, 4;
        jne ifp_dc_bad_type;

        // buf[2] = bInterfaceNumber in [0,31].
        xor rax, rax;
        mov_b rax, [r12 + 2];
        cmp rax, 31;
        ja  ifp_dc_bad_ifnum;

        // buf[3] = bAlternateSetting in [0,15].
        xor rax, rax;
        mov_b rax, [r12 + 3];
        cmp rax, 15;
        ja  ifp_dc_bad_alt;

        // Pack.
        xor rax, rax;
        mov_b rax, [r12 + 2];            // ifnum
        and rax, 0xFF;                   // [7:0]

        xor r10, r10;
        mov_b r10, [r12 + 3];            // alt
        shl r10, 8;
        or  rax, r10;

        xor r10, r10;
        mov_b r10, [r12 + 4];            // bNumEndpoints
        shl r10, 16;
        or  rax, r10;

        xor r10, r10;
        mov_b r10, [r12 + 5];            // class
        shl r10, 24;
        or  rax, r10;

        xor r10, r10;
        mov_b r10, [r12 + 6];            // subclass
        shl r10, 32;
        or  rax, r10;

        xor r10, r10;
        mov_b r10, [r12 + 7];            // protocol
        shl r10, 40;
        or  rax, r10;

        xor r10, r10;
        mov_b r10, [r12];                // bLength
        shl r10, 48;
        or  rax, r10;

        mov r14, rax;

        mov rdi, 0;                      // ST_PARSES
        call ifparser_note;

        mov rax, r14;
        jmp ifp_dc_out;

      ifp_dc_bad_length:
        mov rdi, 1;
        call ifparser_note;
        mov rax, 0xFFFFFB9F;
        jmp ifp_dc_out;
      ifp_dc_bad_type:
        mov rdi, 2;
        call ifparser_note;
        mov rax, 0xFFFFFB9E;
        jmp ifp_dc_out;
      ifp_dc_bad_ifnum:
        mov rdi, 3;
        call ifparser_note;
        mov rax, 0xFFFFFB9D;
        jmp ifp_dc_out;
      ifp_dc_bad_alt:
        mov rdi, 4;
        call ifparser_note;
        mov rax, 0xFFFFFB9C;
        jmp ifp_dc_out;
      ifp_dc_bad_arg:
        mov rax, 0xFFFFFB9B;

      ifp_dc_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Field accessors on a packed decode result.
  // ==========================================================================

  pub let if_desc_ok : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): 1 iff packed value is valid (bits [63:56] zero). Labels prefixed ifp_ok_.",
      block: {
        mov rax, rdi;
        shr rax, 56;
        cmp rax, 0;
        jne ifp_ok_no;
        mov rax, 1;
        ret;
      ifp_ok_no:
        xor rax, rax;
        ret
      }
    }

  pub let if_desc_ifnum : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): bits [7:0].",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let if_desc_alt : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): bits [15:8].",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    }

  pub let if_desc_neps : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): bits [23:16] — bNumEndpoints.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    }

  pub let if_desc_class : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): bits [31:24].",
      block: {
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret
      }
    }

  pub let if_desc_subclass : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): bits [39:32].",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  pub let if_desc_protocol : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): bits [47:40].",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFF;
        ret
      }
    }

  pub let if_desc_length : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M2-003 (#1174): bits [55:48] — bLength.",
      block: {
        mov rax, rdi;
        shr rax, 48;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // interface_alt_select(buf_ptr, buf_len, target_ifnum, target_alt)
  //   -> IFPARSE_OK | IFPARSE_NOT_FOUND
  //
  // Single-descriptor alt-setting selection helper. Parses the given
  // descriptor and returns OK iff its (ifnum, alt) matches the target.
  // A REAL alt-selection walks a config descriptor stream looking for
  // the matching pair; this scaffold handles ONE descriptor.
  // ==========================================================================

  pub let interface_alt_select : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (target_ifnum: u64) (target_alt: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M2-003 (#1174): parse ONE interface descriptor and return OK iff its (ifnum, alt) match the target. Any parse error propagates (BAD_*). Non-match returns NOT_FOUND. Labels prefixed ifp_as_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rdi, r12;
        mov rsi, r13;
        call interface_parse;
        mov rbx, rax;

        // Check for parse error (high byte non-zero).
        mov rax, rbx;
        shr rax, 56;
        cmp rax, 0;
        jne ifp_as_prop;

        // Compare ifnum.
        mov rax, rbx;
        and rax, 0xFF;
        cmp rax, r14;
        jne ifp_as_nf;

        // Compare alt.
        mov rax, rbx;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, r15;
        jne ifp_as_nf;

        mov rdi, 5;                      // ST_ALT_SELECTS
        call ifparser_note;

        xor rax, rax;
        jmp ifp_as_out;

      ifp_as_prop:
        mov rax, rbx;                    // propagate parse error
        jmp ifp_as_out;
      ifp_as_nf:
        mov rax, 0xFFFFFB9A;

      ifp_as_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
