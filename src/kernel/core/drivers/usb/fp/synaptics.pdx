// src/kernel/core/drivers/usb/fp/synaptics.pdx — R34.M6-004 (#1193)
//
// Synaptics (vendor id 0x06CB) fingerprint sensor vendor driver.
// Synaptics VCS (Validity Command Set) common protocol.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// Synaptics VCS parts (VFS7xxx / VFS9xxx family) share a common
// command set over two bulk endpoints. Unlike Goodix, VCS carries a
// small 2-byte header ([opcode u16 LE]) followed by an opcode-specific
// payload; every reply begins with a 2-byte status word. The commands
// this scaffold gates are:
//
//   0x02  STATUS       (query sensor status)
//   0x08  CAPTURE      (capture one frame)
//   0x0F  TEMPLATE     (extract template from captured frames)
//
// This module produces the bulk-out header bytes and validates the
// bulk-in status word; the actual URB submission belongs to a live
// driver reached through KIND_USB_ENDPOINT + KIND_USB_URB.
//
// IT DOES NOT ISSUE ANY URB. Same discipline as goodix.pdx.
//
// IT IS NOT A LIVE DRIVER. synaptics_arbitrated() returns 0 until a
// later round binds it against a real Synaptics sensor.
//
// =============================================================================
// §1  ERROR CODES 0xFFFFFA40..0xFFFFFA4F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time.

module Synaptics = structure {

  pub let SYNAPTICS_VENDOR_ID : u64 = 0x06CB

  pub let SYN_OP_STATUS   : u64 = 0x02
  pub let SYN_OP_CAPTURE  : u64 = 0x08
  pub let SYN_OP_TEMPLATE : u64 = 0x0F

  // Header layout: [opcode u16 LE] = 2 bytes.
  pub let SYN_HDR_BYTES : u64 = 2

  // Status codes (subset of VCS response).
  pub let SYN_STATUS_OK       : u64 = 0
  pub let SYN_STATUS_BUSY     : u64 = 1
  pub let SYN_STATUS_NO_MATCH : u64 = 2
  pub let SYN_STATUS_TIMEOUT  : u64 = 3
  pub let SYN_STATUS_MAX      : u64 = 3

  // Capture bounds.
  pub let SYN_CAPTURE_MAX_BYTES : u64 = 65536

  pub let SYN_OK              : u64 = 0
  pub let SYN_BAD_BUF         : u64 = 0xFFFFFA4F
  pub let SYN_BAD_LEN         : u64 = 0xFFFFFA4E
  pub let SYN_BAD_OP          : u64 = 0xFFFFFA4D
  pub let SYN_BAD_STATUS      : u64 = 0xFFFFFA4C
  pub let SYN_BAD_RESP_LEN    : u64 = 0xFFFFFA4B
  pub let SYN_BAD_CAPTURE_LEN : u64 = 0xFFFFFA4A
  pub let SYN_BAD_ARG         : u64 = 0xFFFFFA49

  pub let mut _synaptics_stats : [u64; 8] = uninit @align(64)

  pub let SYN_ST_CMDS      : u64 = 0
  pub let SYN_ST_CAPTURES  : u64 = 1
  pub let SYN_ST_STATUS_Q  : u64 = 2
  pub let SYN_ST_TEMPLATES : u64 = 3
  pub let SYN_ST_REJECTS   : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let synaptics_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): clear stats. Labels prefixed syn_rs_.",
      block: {
        lea r10, [rip + _synaptics_stats];
        xor rax, rax;
        xor rcx, rcx;
      syn_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  syn_rs_loop;
        ret
      }
    }

  pub let synaptics_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-004 (#1193): honesty pin. Returns 0 until a later round binds this against a real Synaptics sensor.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let synaptics_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): counter read. Labels prefixed syn_st_.",
      block: {
        cmp rdi, 8;
        jae syn_st_zero;
        lea r10, [rip + _synaptics_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      syn_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let synaptics_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): counter bump. Labels prefixed syn_nt_.",
      block: {
        cmp rdi, 8;
        jae syn_nt_out;
        lea r10, [rip + _synaptics_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      syn_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let synaptics_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-004 (#1193): 1 iff op in {STATUS, CAPTURE, TEMPLATE}. Labels prefixed syn_ov_.",
      block: {
        cmp rdi, 0x02;
        je  syn_ov_yes;
        cmp rdi, 0x08;
        je  syn_ov_yes;
        cmp rdi, 0x0F;
        je  syn_ov_yes;
        xor rax, rax;
        ret;
      syn_ov_yes:
        mov rax, 1;
        ret
      }
    }

  pub let synaptics_status_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-004 (#1193): 1 iff s in [0, 3]. Labels prefixed syn_sv_.",
      block: {
        cmp rdi, 3;
        ja  syn_sv_no;
        mov rax, 1;
        ret;
      syn_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // synaptics_cmd_pack(buf, op) -> OK | error
  //
  // Writes the 2-byte bulk-OUT command header ([opcode u16 LE]).
  // ==========================================================================

  pub let synaptics_cmd_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (op: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): write the 2-byte Synaptics VCS bulk-OUT command header. Sequence: buf != 0; op_valid; store as u16 LE. Labels prefixed syn_pk_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  syn_pk_bad_buf;

        mov rdi, r13;
        call synaptics_op_valid;
        cmp rax, 0;
        je  syn_pk_bad_op;

        mov rax, r13;
        mov [r12 + 0], ax;

        mov rdi, 0;                      // CMDS
        call synaptics_note;

        xor rax, rax;
        jmp syn_pk_out;

      syn_pk_bad_buf:
        mov rdi, 4;
        call synaptics_note;
        mov rax, 0xFFFFFA4F;
        jmp syn_pk_out;
      syn_pk_bad_op:
        mov rdi, 4;
        call synaptics_note;
        mov rax, 0xFFFFFA4D;

      syn_pk_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // synaptics_resp_parse(buf, len) -> status | error
  //
  // Reads the 2-byte bulk-IN status word and validates it.
  // ==========================================================================

  pub let synaptics_resp_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): parse the 2-byte Synaptics VCS bulk-IN status word. Sequence: buf != 0; len >= 2; read status u16 LE; validate <= 3. Labels prefixed syn_rp_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  syn_rp_bad_buf;
        cmp r13, 2;
        jb  syn_rp_bad_len;

        xor rax, rax;
        mov ax, [r12 + 0];
        mov rcx, rax;

        mov rdi, rcx;
        call synaptics_status_valid;
        cmp rax, 0;
        je  syn_rp_bad_st;

        mov rax, rcx;
        jmp syn_rp_out;

      syn_rp_bad_buf:
        mov rdi, 4;
        call synaptics_note;
        mov rax, 0xFFFFFA4F;
        jmp syn_rp_out;
      syn_rp_bad_len:
        mov rdi, 4;
        call synaptics_note;
        mov rax, 0xFFFFFA4E;
        jmp syn_rp_out;
      syn_rp_bad_st:
        mov rdi, 4;
        call synaptics_note;
        mov rax, 0xFFFFFA4C;

      syn_rp_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // synaptics_query_status_pack(buf) -> OK | error
  // ==========================================================================

  pub let synaptics_query_status_pack : (u64) -> u64 !{mem} @{} =
    fn (buf: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): pack a STATUS query. Labels prefixed syn_qs_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        mov rsi, 0x02;
        call synaptics_cmd_pack;

        mov r10, rax;
        cmp r10, 0;
        jne syn_qs_out;
        mov rdi, 2;                      // STATUS_Q
        call synaptics_note;
        xor rax, rax;
      syn_qs_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // synaptics_capture_frame_pack(buf, capture_bytes) -> OK | error
  // ==========================================================================

  pub let synaptics_capture_frame_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (capture_bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): pack a CAPTURE request. Refuses capture_bytes > SYN_CAPTURE_MAX_BYTES. capture_bytes is caller-declared; a live driver reads that many bytes on the following bulk-in. Labels prefixed syn_cf_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov r10, 65536;
        cmp r13, r10;
        ja  syn_cf_bad;

        mov rdi, r12;
        mov rsi, 0x08;
        call synaptics_cmd_pack;

        mov r10, rax;
        cmp r10, 0;
        jne syn_cf_out;
        mov rdi, 1;                      // CAPTURES
        call synaptics_note;
        xor rax, rax;
        jmp syn_cf_out;

      syn_cf_bad:
        mov rdi, 4;
        call synaptics_note;
        mov rax, 0xFFFFFA4A;

      syn_cf_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // synaptics_template_extract_pack(buf) -> OK | error
  // ==========================================================================

  pub let synaptics_template_extract_pack : (u64) -> u64 !{mem} @{} =
    fn (buf: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-004 (#1193): pack a TEMPLATE extraction request. Labels prefixed syn_te_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        mov rsi, 0x0F;
        call synaptics_cmd_pack;

        mov r10, rax;
        cmp r10, 0;
        jne syn_te_out;
        mov rdi, 3;                      // TEMPLATES
        call synaptics_note;
        xor rax, rax;
      syn_te_out:
        pop r12;
        ret
      }
    }
}
