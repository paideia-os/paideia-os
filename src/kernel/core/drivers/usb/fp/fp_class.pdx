// src/kernel/core/drivers/usb/fp/fp_class.pdx — R34.M6-002 (#1191)
//
// USB fingerprint class driver: the vendor-agnostic surface a live
// driver exposes to ring 3 (init, enroll_start / enroll_add_frame /
// enroll_commit, verify, delete_template). Vendor code lives beside
// this file (goodix.pdx, synaptics.pdx); this module is the shared
// dispatch face.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WIRE-FRAME half of a USB fingerprint class driver. The
// vendor-specific bulk-in / bulk-out protocol implementations bind
// against this surface once a KIND_FP_SENSOR capability is minted for
// the part; the surface itself is a small state machine that names
// every transaction against a template_id (a 32-bit opaque handle the
// class driver hands back at enroll_commit) so a subsequent verify
// invocation cannot be confused about WHICH enrolment it is asked to
// match against.
//
// IT DOES NOT ISSUE ANY BULK TRANSFER. Bulk-out and bulk-in reach the
// wire through KIND_USB_ENDPOINT + KIND_USB_URB (R34.M3-004 #1179);
// this module records the STATE the class driver would drive and
// refuses malformed transitions.
//
// IT IS NOT A LIVE DRIVER. fp_class_arbitrated() returns 0 until a
// later round wires the vendor code against a real KIND_FP_SENSOR
// bound through composite_bind.
//
// =============================================================================
// §1  STATE MACHINE
// =============================================================================
//
// Each sensor moves through five ordered states:
//
//   FP_ST_INIT       -> initial; enroll_start allowed
//   FP_ST_ENROLLING  -> enroll_add_frame allowed; enroll_commit allowed
//   FP_ST_ENROLLED   -> verify / delete_template allowed
//   FP_ST_VERIFYING  -> verify_result allowed
//   FP_ST_ERROR      -> only reset() clears it
//
// A transition out of the accepted set is refused with FP_CLASS_BAD_STATE
// rather than silently reset to a plausible neighbour: a fingerprint
// class driver that "recovers" from an unexpected op by pretending it
// arrived after the right one is a class driver that will silently
// verify a template that was never committed.
//
// =============================================================================
// §2  TEMPLATE IDS ARE NEVER REUSED
// =============================================================================
//
// template_id is a monotonically increasing counter, minted on
// enroll_commit and never reissued after delete_template. A reissued
// id would let a subsequent verify hit a slot the delete had promised
// to remove — the security consequence is a match against a template
// that "does not exist".
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _fp_class_state and _fp_class_stats are written only by helpers in
// this module. tools/build.sh confines relocations against both
// symbols to `core/drivers/usb/fp/fp_class.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFA70..0xFFFFFA7F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent: kind_fp_sensor 0xFFFFFA80..8F,
// fp_capture_channel 0xFFFFFA60..6F, goodix 0xFFFFFA50..5F).

module FpClass = structure {

  pub let FP_ST_INIT      : u64 = 0
  pub let FP_ST_ENROLLING : u64 = 1
  pub let FP_ST_ENROLLED  : u64 = 2
  pub let FP_ST_VERIFYING : u64 = 3
  pub let FP_ST_ERROR     : u64 = 4
  pub let FP_ST_STATE_MAX : u64 = 4

  // Verify outcomes.
  pub let FP_VERIFY_MATCH    : u64 = 0
  pub let FP_VERIFY_NO_MATCH : u64 = 1
  pub let FP_VERIFY_TIMEOUT  : u64 = 2

  // Frame bounds: a sensor never asks for more than 8 frames per
  // enrolment, and never fewer than 3.
  pub let FP_ENROLL_FRAMES_MIN : u64 = 3
  pub let FP_ENROLL_FRAMES_MAX : u64 = 8

  // Template capacity: bookkeeping only; templates live in the vendor
  // driver's private store.
  pub let FP_TEMPLATE_MAX : u64 = 16

  pub let FP_CLASS_OK               : u64 = 0
  pub let FP_CLASS_BAD_ARG          : u64 = 0xFFFFFA7F
  pub let FP_CLASS_BAD_STATE        : u64 = 0xFFFFFA7E
  pub let FP_CLASS_BAD_TEMPLATE     : u64 = 0xFFFFFA7D
  pub let FP_CLASS_BAD_FRAMES       : u64 = 0xFFFFFA7C
  pub let FP_CLASS_ENOSPC           : u64 = 0xFFFFFA7B
  pub let FP_CLASS_NOT_ENROLLED     : u64 = 0xFFFFFA7A
  pub let FP_CLASS_ALREADY_ENROLLED : u64 = 0xFFFFFA79
  pub let FP_CLASS_NOT_INITIALISED  : u64 = 0xFFFFFA78

  // State cells:
  //   [+0]  cur_state (u8)
  //   [+8]  next_template_id (u32; monotone)
  //   [+16] template_count   (u32)
  //   [+24] frames_captured  (u32)
  //   [+32] active_template_id (u32; set on verify_start)
  pub let mut _fp_class_state : [u64; 8] = uninit @align(64)
  pub let mut _fp_class_stats : [u64; 8] = uninit @align(64)

  pub let FP_CLS_ST_ENROLLS  : u64 = 0
  pub let FP_CLS_ST_VERIFIES : u64 = 1
  pub let FP_CLS_ST_MATCHES  : u64 = 2
  pub let FP_CLS_ST_DELETES  : u64 = 3
  pub let FP_CLS_ST_REJECTS  : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let fp_class_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): clear state and stats; set next_template_id to 1 so the first commit hands out a non-zero id. Labels prefixed fpcls_rs_.",
      block: {
        lea r10, [rip + _fp_class_state];
        xor rax, rax;
        xor rcx, rcx;
      fpcls_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  fpcls_rs_st;

        mov rax, 1;
        mov [r10 + 8], rax;              // next_template_id = 1

        lea r10, [rip + _fp_class_stats];
        xor rax, rax;
        xor rcx, rcx;
      fpcls_rs_ss:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  fpcls_rs_ss;
        ret
      }
    }

  pub let fp_class_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-002 (#1191): honesty pin. Returns 0 until a later round binds the vendor driver against a real KIND_FP_SENSOR through composite_bind.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let fp_class_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): counter read. Labels prefixed fpcls_st_.",
      block: {
        cmp rdi, 8;
        jae fpcls_st_zero;
        lea r10, [rip + _fp_class_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      fpcls_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let fp_class_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): counter bump. Labels prefixed fpcls_nt_.",
      block: {
        cmp rdi, 8;
        jae fpcls_nt_out;
        lea r10, [rip + _fp_class_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      fpcls_nt_out:
        ret
      }
    }

  // ==========================================================================
  // State accessors.
  // ==========================================================================

  pub let fp_class_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): current state.",
      block: {
        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let fp_class_template_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): live template count.",
      block: {
        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let fp_class_frames_captured : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): frames captured in the current enrolment.",
      block: {
        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  // ==========================================================================
  // init(): moves ERROR -> INIT (no-op elsewhere).
  // ==========================================================================

  pub let fp_class_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): reset the state machine to INIT. Idempotent from INIT. Labels prefixed fpcls_in_.",
      block: {
        lea r10, [rip + _fp_class_state];
        xor rax, rax;
        mov [r10 + 0], rax;              // cur_state = INIT
        xor rax, rax;
        mov [r10 + 24], rax;             // frames_captured = 0
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // enroll_start(): INIT -> ENROLLING. Refuses otherwise.
  // ==========================================================================

  pub let fp_class_enroll_start : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): begin one enrolment. Refuses BAD_STATE if not INIT. Labels prefixed fpcls_es_.",
      block: {
        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 0];
        cmp rax, 0;                      // FP_ST_INIT
        jne fpcls_es_bad;
        mov rax, 1;
        mov [r10 + 0], rax;              // -> ENROLLING
        xor rax, rax;
        mov [r10 + 24], rax;             // frames_captured = 0
        xor rax, rax;
        ret;
      fpcls_es_bad:
        mov rax, 0xFFFFFA7E;
        ret
      }
    }

  // ==========================================================================
  // enroll_add_frame(): stays in ENROLLING; bumps frames_captured.
  // Refuses BAD_STATE outside ENROLLING and ENOSPC above FRAMES_MAX.
  // ==========================================================================

  pub let fp_class_enroll_add_frame : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): record one captured frame. Refuses BAD_STATE outside ENROLLING and ENOSPC above FRAMES_MAX. Labels prefixed fpcls_ea_.",
      block: {
        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 0];
        cmp rax, 1;                      // ENROLLING
        jne fpcls_ea_bad;

        mov rax, [r10 + 24];
        mov r11, 8;                      // FRAMES_MAX
        cmp rax, r11;
        jae fpcls_ea_enospc;

        add rax, 1;
        mov [r10 + 24], rax;
        xor rax, rax;
        ret;
      fpcls_ea_bad:
        mov rax, 0xFFFFFA7E;
        ret;
      fpcls_ea_enospc:
        mov rax, 0xFFFFFA7B;
        ret
      }
    }

  // ==========================================================================
  // enroll_commit(): ENROLLING -> ENROLLED; returns template_id (>0).
  // Refuses BAD_STATE outside ENROLLING and BAD_FRAMES if too few frames.
  // ==========================================================================

  pub let fp_class_enroll_commit : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): finalise one enrolment. Refuses BAD_STATE outside ENROLLING and BAD_FRAMES below FRAMES_MIN. Returns the new template_id on success (non-zero, monotone). Labels prefixed fpcls_ec_.",
      block: {
        push rbx;
        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 0];
        cmp rax, 1;                      // ENROLLING
        jne fpcls_ec_bad;

        mov rax, [r10 + 24];             // frames_captured
        mov r11, 3;                      // FRAMES_MIN
        cmp rax, r11;
        jb  fpcls_ec_short;

        mov rax, [r10 + 16];             // template_count
        mov r11, 16;                     // TEMPLATE_MAX
        cmp rax, r11;
        jae fpcls_ec_enospc;

        // Mint the next id and transition.
        mov rbx, [r10 + 8];              // next_template_id
        mov r11, rbx;
        add r11, 1;
        mov [r10 + 8], r11;              // next++

        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;             // template_count++

        mov rax, 2;
        mov [r10 + 0], rax;              // -> ENROLLED
        xor rax, rax;
        mov [r10 + 24], rax;             // frames = 0

        mov rdi, 0;                      // ENROLLS
        call fp_class_note;

        mov rax, rbx;                    // return template_id
        jmp fpcls_ec_out;

      fpcls_ec_bad:
        mov rax, 0xFFFFFA7E;
        jmp fpcls_ec_out;
      fpcls_ec_short:
        mov rax, 0xFFFFFA7C;             // BAD_FRAMES
        jmp fpcls_ec_out;
      fpcls_ec_enospc:
        mov rax, 0xFFFFFA7B;             // ENOSPC

      fpcls_ec_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // verify(template_id): ENROLLED -> VERIFYING then returns match|no_match|
  // timeout. In this scaffold, template_id validity is checked against
  // next_template_id (monotone bound): 0 < id < next_template_id.
  // The outcome ordinal is passed by caller (simulated); a live driver
  // would compute it.
  // ==========================================================================

  pub let fp_class_verify : (u64, u64) -> u64 !{mem} @{} =
    fn (template_id: u64) (outcome: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): verify against ONE template. Refuses NOT_ENROLLED outside ENROLLED and BAD_TEMPLATE for id 0 or >= next_template_id. On success returns the outcome ordinal (MATCH=0, NO_MATCH=1, TIMEOUT=2). Bumps VERIFIES and, on MATCH, MATCHES. Labels prefixed fpcls_vf_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // template_id
        mov r13, rsi;                    // outcome

        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 0];
        cmp rax, 2;                      // ENROLLED
        jne fpcls_vf_bad;

        cmp r12, 0;
        je  fpcls_vf_bad_tmpl;
        mov rax, [r10 + 8];              // next_template_id
        cmp r12, rax;
        jae fpcls_vf_bad_tmpl;

        cmp r13, 2;                      // outcome ordinal
        ja  fpcls_vf_bad_out;

        mov rdi, 1;                      // VERIFIES
        call fp_class_note;

        cmp r13, 0;                      // MATCH
        jne fpcls_vf_ret;
        mov rdi, 2;                      // MATCHES
        call fp_class_note;

      fpcls_vf_ret:
        mov rax, r13;
        jmp fpcls_vf_out;

      fpcls_vf_bad:
        mov rax, 0xFFFFFA7A;             // NOT_ENROLLED
        jmp fpcls_vf_out;
      fpcls_vf_bad_tmpl:
        mov rax, 0xFFFFFA7D;             // BAD_TEMPLATE
        jmp fpcls_vf_out;
      fpcls_vf_bad_out:
        mov rax, 0xFFFFFA7F;             // BAD_ARG

      fpcls_vf_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // delete_template(template_id): removes one template. Refuses if not
  // ENROLLED, if id 0 or >= next_template_id, or if template_count == 0.
  //
  // The scaffold does not maintain a per-id present bit — deleted ids
  // are simply refused by never being reused (§2). template_count is
  // decremented.
  // ==========================================================================

  pub let fp_class_delete_template : (u64) -> u64 !{mem} @{} =
    fn (template_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-002 (#1191): delete ONE template by id. Refuses NOT_ENROLLED outside ENROLLED, BAD_TEMPLATE for id 0 or >= next_template_id, ENOSPC (0 templates left). Deleted ids are never reused (§2). Labels prefixed fpcls_dt_.",
      block: {
        push r12;
        mov r12, rdi;

        lea r10, [rip + _fp_class_state];
        mov rax, [r10 + 0];
        cmp rax, 2;                      // ENROLLED
        jne fpcls_dt_bad;

        cmp r12, 0;
        je  fpcls_dt_bad_tmpl;
        mov rax, [r10 + 8];
        cmp r12, rax;
        jae fpcls_dt_bad_tmpl;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  fpcls_dt_enospc;
        sub rax, 1;
        mov [r10 + 16], rax;

        // If the last template was removed, drop back to INIT.
        cmp rax, 0;
        jne fpcls_dt_ok;
        xor rax, rax;
        mov [r10 + 0], rax;              // -> INIT

      fpcls_dt_ok:
        mov rdi, 3;                      // DELETES
        call fp_class_note;
        xor rax, rax;
        jmp fpcls_dt_out;

      fpcls_dt_bad:
        mov rax, 0xFFFFFA7A;             // NOT_ENROLLED
        jmp fpcls_dt_out;
      fpcls_dt_bad_tmpl:
        mov rax, 0xFFFFFA7D;             // BAD_TEMPLATE
        jmp fpcls_dt_out;
      fpcls_dt_enospc:
        mov rax, 0xFFFFFA7B;             // ENOSPC

      fpcls_dt_out:
        pop r12;
        ret
      }
    }
}
