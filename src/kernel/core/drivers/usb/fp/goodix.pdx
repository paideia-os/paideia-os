// src/kernel/core/drivers/usb/fp/goodix.pdx — R34.M6-003 (#1192)
//
// Goodix (vendor id 0x27C6) fingerprint sensor vendor driver.
// Common Goodix protocol: bulk-out command, bulk-in response.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// Goodix parts (GX5xxx, GX55xx family) ship a "common protocol" over
// two bulk endpoints: a bulk-OUT for the command header + payload
// (little-endian, 4-byte header: [cmd u16, len u16], then len bytes),
// and a bulk-IN for the response (same header, then payload). The
// commands this scaffold gates are:
//
//   0xA6  MCU_STATE      (query MCU firmware state)
//   0xA8  IMAGE_FRAME    (read one image frame)
//   0xB0  ENROLL_BEGIN   (open enroll transaction)
//   0xB1  ENROLL_ADD     (append one frame)
//   0xB2  ENROLL_COMMIT  (close enroll transaction; MCU returns tid)
//
// This module produces the bulk-out header bytes and validates the
// bulk-in response header; the actual URB submission belongs to a
// live driver reached through KIND_USB_ENDPOINT + KIND_USB_URB.
//
// IT DOES NOT ISSUE ANY URB. Same discipline as fp_class.pdx: the
// vendor driver is bound to a KIND_FP_SENSOR by the class driver's
// composite_bind pass; this scaffold records the WOULD-BE
// transactions and refuses malformed headers.
//
// IT IS NOT A LIVE DRIVER. goodix_arbitrated() returns 0 until a
// later round binds it against a real Goodix sensor.
//
// =============================================================================
// §1  ERROR CODES 0xFFFFFA50..0xFFFFFA5F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent: fp_capture_channel 0xFFFFFA60..6F,
// synaptics 0xFFFFFA40..4F).

module Goodix = structure {

  pub let GOODIX_VENDOR_ID : u64 = 0x27C6

  pub let GDX_CMD_MCU_STATE     : u64 = 0xA6
  pub let GDX_CMD_IMAGE_FRAME   : u64 = 0xA8
  pub let GDX_CMD_ENROLL_BEGIN  : u64 = 0xB0
  pub let GDX_CMD_ENROLL_ADD    : u64 = 0xB1
  pub let GDX_CMD_ENROLL_COMMIT : u64 = 0xB2

  // Header layout: [cmd u16][len u16] = 4 bytes.
  pub let GDX_HDR_BYTES : u64 = 4

  // Payload length caps per command (bytes). An enroll frame is at
  // most 65536 bytes; queries carry no payload.
  pub let GDX_PAYLOAD_MAX : u64 = 65536

  // MCU state codes (subset).
  pub let GDX_MCU_READY    : u64 = 0
  pub let GDX_MCU_BUSY     : u64 = 1
  pub let GDX_MCU_ERROR    : u64 = 2
  pub let GDX_MCU_STATE_MAX : u64 = 2

  pub let GDX_OK             : u64 = 0
  pub let GDX_BAD_BUF        : u64 = 0xFFFFFA5F
  pub let GDX_BAD_LEN        : u64 = 0xFFFFFA5E
  pub let GDX_BAD_CMD        : u64 = 0xFFFFFA5D
  pub let GDX_BAD_PAYLOAD    : u64 = 0xFFFFFA5C
  pub let GDX_BAD_RESP_LEN   : u64 = 0xFFFFFA5B
  pub let GDX_BAD_RESP_CMD   : u64 = 0xFFFFFA5A
  pub let GDX_BAD_MCU_STATE  : u64 = 0xFFFFFA59
  pub let GDX_BAD_ARG        : u64 = 0xFFFFFA58

  pub let mut _goodix_stats : [u64; 8] = uninit @align(64)

  pub let GDX_ST_CMDS      : u64 = 0
  pub let GDX_ST_FRAMES    : u64 = 1
  pub let GDX_ST_MCU_QRY   : u64 = 2
  pub let GDX_ST_ENROLLS   : u64 = 3
  pub let GDX_ST_REJECTS   : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let goodix_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): clear stats. Labels prefixed gdx_rs_.",
      block: {
        lea r10, [rip + _goodix_stats];
        xor rax, rax;
        xor rcx, rcx;
      gdx_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gdx_rs_loop;
        ret
      }
    }

  pub let goodix_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-003 (#1192): honesty pin. Returns 0 until a later round binds this against a real Goodix sensor.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let goodix_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): counter read. Labels prefixed gdx_st_.",
      block: {
        cmp rdi, 8;
        jae gdx_st_zero;
        lea r10, [rip + _goodix_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      gdx_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let goodix_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): counter bump. Labels prefixed gdx_nt_. Preserves r10 across the counter bump: goodix_query_mcu_state_pack stages the inner cmd_pack return in r10 across this call — the naked `lea r10, ...` below would clobber it.",
      block: {
        push r10;
        cmp rdi, 8;
        jae gdx_nt_out;
        lea r10, [rip + _goodix_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      gdx_nt_out:
        pop r10;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let goodix_cmd_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-003 (#1192): 1 iff c in the small set {0xA6, 0xA8, 0xB0, 0xB1, 0xB2}. Labels prefixed gdx_cv_.",
      block: {
        cmp rdi, 0xA6;
        je  gdx_cv_yes;
        cmp rdi, 0xA8;
        je  gdx_cv_yes;
        cmp rdi, 0xB0;
        je  gdx_cv_yes;
        cmp rdi, 0xB1;
        je  gdx_cv_yes;
        cmp rdi, 0xB2;
        je  gdx_cv_yes;
        xor rax, rax;
        ret;
      gdx_cv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // goodix_cmd_pack(buf, cmd, payload_len) -> OK | error
  //
  // Writes the 4-byte bulk-OUT header. The caller supplies the
  // payload separately; this scaffold only records the header.
  // Layout: [+0] cmd u16 LE, [+2] payload_len u16 LE.
  // ==========================================================================

  pub let goodix_cmd_pack : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (cmd: u64) (payload_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): write the 4-byte Goodix bulk-OUT command header. Sequence: buf != 0; cmd_valid; payload_len <= GDX_PAYLOAD_MAX; store cmd/len as u16 LE. Labels prefixed gdx_pk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        cmp rbx, 0;
        je  gdx_pk_bad_buf;

        mov rdi, r12;
        call goodix_cmd_valid;
        cmp rax, 0;
        je  gdx_pk_bad_cmd;

        mov r10, 65536;
        cmp r13, r10;
        ja  gdx_pk_bad_pl;

        mov rax, r12;
        mov [rbx + 0], ax;               // cmd u16
        mov rax, r13;
        mov [rbx + 2], ax;               // payload_len u16

        mov rdi, 0;                      // CMDS
        call goodix_note;

        xor rax, rax;
        jmp gdx_pk_out;

      gdx_pk_bad_buf:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA5F;
        jmp gdx_pk_out;
      gdx_pk_bad_cmd:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA5D;
        jmp gdx_pk_out;
      gdx_pk_bad_pl:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA5C;

      gdx_pk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // goodix_resp_parse(buf, len) -> (cmd | (payload_len << 16)) | error
  // ==========================================================================

  pub let goodix_resp_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): parse the 4-byte Goodix bulk-IN response header. Sequence: buf != 0; len >= 4; read cmd u16 (validate against gdx_cmd_valid); read payload_len u16; refuse (4 + payload_len > len). Returns cmd | (payload_len << 16). Labels prefixed gdx_rp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  gdx_rp_bad_buf;
        cmp r13, 4;
        jb  gdx_rp_bad_len;

        xor rax, rax;
        mov ax, [r12 + 0];
        mov rbx, rax;                    // cmd

        mov rdi, rbx;
        call goodix_cmd_valid;
        cmp rax, 0;
        je  gdx_rp_bad_cmd;

        xor rax, rax;
        mov ax, [r12 + 2];
        mov rcx, rax;                    // payload_len

        // check 4 + payload_len <= len
        mov r10, rcx;
        add r10, 4;
        cmp r10, r13;
        ja  gdx_rp_bad_rlen;

        mov rax, rbx;
        and rax, 0xFFFF;
        mov r10, rcx;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        jmp gdx_rp_out;

      gdx_rp_bad_buf:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA5F;
        jmp gdx_rp_out;
      gdx_rp_bad_len:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA5E;
        jmp gdx_rp_out;
      gdx_rp_bad_cmd:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA5A;
        jmp gdx_rp_out;
      gdx_rp_bad_rlen:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA5B;

      gdx_rp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // goodix_query_mcu_state_pack(buf) -> OK | error
  // ==========================================================================

  pub let goodix_query_mcu_state_pack : (u64) -> u64 !{mem} @{} =
    fn (buf: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): pack an MCU_STATE query. Labels prefixed gdx_qm_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        mov rsi, 0xA6;                   // MCU_STATE
        mov rdx, 0;
        call goodix_cmd_pack;

        mov r10, rax;
        mov rdi, 2;                      // MCU_QRY
        call goodix_note;
        mov rax, r10;

        pop r12;
        ret
      }
    }

  pub let goodix_mcu_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-003 (#1192): 1 iff s in {READY, BUSY, ERROR}.",
      block: {
        cmp rdi, 2;
        ja  gdx_mv_no;
        mov rax, 1;
        ret;
      gdx_mv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // goodix_image_frame_pack(buf, frame_bytes) -> OK | error
  // ==========================================================================

  pub let goodix_image_frame_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (frame_bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): pack an IMAGE_FRAME request. frame_bytes is the requested payload length. Labels prefixed gdx_if_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        mov rsi, 0xA8;
        mov rdx, r13;
        call goodix_cmd_pack;

        mov r10, rax;
        cmp r10, 0;
        jne gdx_if_out;
        mov rdi, 1;                      // FRAMES
        call goodix_note;
        xor rax, rax;
      gdx_if_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // goodix_enroll_pack(buf, phase) -> OK | error
  //   phase 0 -> ENROLL_BEGIN, 1 -> ENROLL_ADD, 2 -> ENROLL_COMMIT
  // ==========================================================================

  pub let goodix_enroll_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (phase: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-003 (#1192): pack one enroll transaction step. Refuses phase > 2. Labels prefixed gdx_en_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        cmp r13, 2;
        ja  gdx_en_bad;

        mov rax, 0xB0;
        add rax, r13;                    // 0xB0 + phase
        mov rdi, r12;
        mov rsi, rax;
        mov rdx, 0;
        call goodix_cmd_pack;

        mov r10, rax;
        cmp r10, 0;
        jne gdx_en_out;
        mov rdi, 3;                      // ENROLLS
        call goodix_note;
        xor rax, rax;
        jmp gdx_en_out;

      gdx_en_bad:
        mov rdi, 4;
        call goodix_note;
        mov rax, 0xFFFFFA58;

      gdx_en_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
