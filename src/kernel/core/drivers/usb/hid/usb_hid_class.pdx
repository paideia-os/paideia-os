// src/kernel/core/drivers/usb/hid/usb_hid_class.pdx — R34.M4-001 (#1181)
//
// USB-HID class-driver scaffold: the class descriptor set and the four
// class-specific control requests. Extends R32's report-descriptor
// parser out of the boot-protocol keyboard corner into full USB-HID.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WIRE-FRAME half of a USB-HID class driver. R32.M2 provides
// the report descriptor parser (report_parser.pdx) once bytes are in
// hand; this module produces the class-specific control transfers a
// live driver would issue to get those bytes:
//
//   * GET_DESCRIPTOR(HID / REPORT / PHYSICAL) — HID 1.11 §7.1
//   * SET_PROTOCOL / GET_PROTOCOL              — HID 1.11 §7.2.5/§7.2.6
//   * SET_IDLE / GET_IDLE                      — HID 1.11 §7.2.3/§7.2.4
//
// It also gates the interrupt-IN endpoint polling interval that a live
// driver would program into the xHCI ring: bInterval in the endpoint
// descriptor names the poll period, but a driver that reads it must
// refuse the two out-of-range encodings HID class descriptors permit.
//
// IT DOES NOT ISSUE ANY CONTROL TRANSFER. Control-transfer authority
// arrives through KIND_USB_ENDPOINT + KIND_USB_URB (R34.M3-004 #1179);
// this module produces the SETUP-packet bytes those transfers carry
// and refuses malformed ones.
//
// IT IS NOT A LIVE DRIVER. hid_class_arbitrated() returns 0 until a
// later round wires this into composite_bind + a real report_parser
// consumer.
//
// =============================================================================
// §1  CLASS DESCRIPTOR TYPES — HID 1.11 §7.1
// =============================================================================
//
//   0x21  HID       — the HID descriptor itself (embedded in config)
//   0x22  REPORT    — the report descriptor (item stream, R32 parser
//                     consumes this)
//   0x23  PHYSICAL  — optional physical descriptor set
//
// =============================================================================
// §2  CLASS-SPECIFIC REQUESTS — HID 1.11 §7.2
// =============================================================================
//
//   0x01  GET_REPORT      (device -> host, wValue = (type<<8)|id)
//   0x02  GET_IDLE        (device -> host, wLength = 1)
//   0x03  GET_PROTOCOL    (device -> host, wLength = 1)
//   0x09  SET_REPORT      (host -> device)
//   0x0A  SET_IDLE        (host -> device, wValue = (duration<<8)|id)
//   0x0B  SET_PROTOCOL    (host -> device, wValue in {0, 1})
//
//   PROTOCOL_BOOT   = 0
//   PROTOCOL_REPORT = 1
//
// =============================================================================
// §3  ONE WRITER OF THE COUNTERS
// =============================================================================
//
// _hid_class_stats is written only by the note helper below. tools/
// build.sh confines relocations against `_hid_class_stats` to this
// object.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFB10..0xFFFFFB1F
// =============================================================================
//
// Chosen because 0xFFFFFB10..1F was FREE at repo grep time (2026-08-18);
// disjoint from BOT (0xFFFFFB50..5F), UAS (0xFFFFFB40..4F), scsi_cmd
// (0xFFFFFB30..3F), usb_transfer_channel (0xFFFFFB20..2F), and every
// existing kind/driver band above.

module UsbHidClass = structure {

  pub let HID_DESC_TYPE_HID      : u64 = 0x21
  pub let HID_DESC_TYPE_REPORT   : u64 = 0x22
  pub let HID_DESC_TYPE_PHYSICAL : u64 = 0x23

  pub let HID_REQ_GET_REPORT   : u64 = 0x01
  pub let HID_REQ_GET_IDLE     : u64 = 0x02
  pub let HID_REQ_GET_PROTOCOL : u64 = 0x03
  pub let HID_REQ_SET_REPORT   : u64 = 0x09
  pub let HID_REQ_SET_IDLE     : u64 = 0x0A
  pub let HID_REQ_SET_PROTOCOL : u64 = 0x0B

  pub let HID_PROTOCOL_BOOT   : u64 = 0
  pub let HID_PROTOCOL_REPORT : u64 = 1

  pub let HID_REPORT_TYPE_INPUT   : u64 = 1
  pub let HID_REPORT_TYPE_OUTPUT  : u64 = 2
  pub let HID_REPORT_TYPE_FEATURE : u64 = 3

  // HID 1.11 §7.2.4: idle duration is a byte multiplied by 4 ms; 0
  // means "indefinite" (report only on state change). Valid range is
  // therefore [0, 255] as encoded — every byte value is legal.
  pub let HID_IDLE_INDEFINITE : u64 = 0

  // USB endpoint bInterval encoding for interrupt endpoints on high-
  // speed and above is 2^(bInterval-1) microframes, with bInterval in
  // [1, 16]. Full-speed and low-speed encode a millisecond count in
  // [1, 255]. This module accepts the widest superset [1, 255] and
  // leaves speed-specific interpretation to the caller.
  pub let HID_POLL_MIN : u64 = 1
  pub let HID_POLL_MAX : u64 = 255

  pub let HID_CLASS_OK               : u64 = 0
  pub let HID_CLASS_BAD_DESC_TYPE    : u64 = 0xFFFFFB1F
  pub let HID_CLASS_BAD_REQ          : u64 = 0xFFFFFB1E
  pub let HID_CLASS_BAD_PROTOCOL     : u64 = 0xFFFFFB1D
  pub let HID_CLASS_BAD_REPORT_TYPE  : u64 = 0xFFFFFB1C
  pub let HID_CLASS_BAD_POLL         : u64 = 0xFFFFFB1B
  pub let HID_CLASS_BAD_BUF          : u64 = 0xFFFFFB1A
  pub let HID_CLASS_BAD_LEN          : u64 = 0xFFFFFB19
  pub let HID_CLASS_BAD_INTERFACE    : u64 = 0xFFFFFB18

  pub let mut _hid_class_stats : [u64; 8] = uninit @align(64)

  pub let HID_CLASS_ST_SETUP_PACKS   : u64 = 0
  pub let HID_CLASS_ST_PROTO_QUERIES : u64 = 1
  pub let HID_CLASS_ST_IDLE_QUERIES  : u64 = 2
  pub let HID_CLASS_ST_REJECTS       : u64 = 3

  // ==========================================================================
  // hid_class_reset() — counters only.
  // ==========================================================================

  pub let hid_class_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-001 (#1181): clear stats. Labels prefixed hcls_rs_.",
      block: {
        lea r10, [rip + _hid_class_stats];
        xor rax, rax;
        xor rcx, rcx;
      hcls_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hcls_rs_loop;
        ret
      }
    }

  pub let hid_class_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-001 (#1181): honesty pin. Returns 0 until a later round wires composite_bind + a real report_parser consumer to this scaffold. Boot witness asserts on this value.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let hid_class_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-001 (#1181): counter read. Labels prefixed hcls_st_.",
      block: {
        cmp rdi, 8;
        jae hcls_st_zero;
        lea r10, [rip + _hid_class_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hcls_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let hid_class_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-001 (#1181): counter bump. Labels prefixed hcls_nt_.",
      block: {
        cmp rdi, 8;
        jae hcls_nt_out;
        lea r10, [rip + _hid_class_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hcls_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let hid_class_desc_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-001 (#1181): 1 iff t in {0x21, 0x22, 0x23}. Labels prefixed hcls_dv_.",
      block: {
        cmp rdi, 0x21;
        je  hcls_dv_yes;
        cmp rdi, 0x22;
        je  hcls_dv_yes;
        cmp rdi, 0x23;
        je  hcls_dv_yes;
        xor rax, rax;
        ret;
      hcls_dv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let hid_class_req_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-001 (#1181): 1 iff r in {1,2,3,9,10,11}. Labels prefixed hcls_rv_.",
      block: {
        cmp rdi, 0x01;
        je  hcls_rv_yes;
        cmp rdi, 0x02;
        je  hcls_rv_yes;
        cmp rdi, 0x03;
        je  hcls_rv_yes;
        cmp rdi, 0x09;
        je  hcls_rv_yes;
        cmp rdi, 0x0A;
        je  hcls_rv_yes;
        cmp rdi, 0x0B;
        je  hcls_rv_yes;
        xor rax, rax;
        ret;
      hcls_rv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let hid_class_protocol_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-001 (#1181): 1 iff p in {0,1}. Labels prefixed hcls_pv_.",
      block: {
        cmp rdi, 1;
        ja  hcls_pv_no;
        mov rax, 1;
        ret;
      hcls_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hid_class_report_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-001 (#1181): 1 iff t in [1,3]. Labels prefixed hcls_tv_.",
      block: {
        cmp rdi, 1;
        jb  hcls_tv_no;
        cmp rdi, 3;
        ja  hcls_tv_no;
        mov rax, 1;
        ret;
      hcls_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hid_class_poll_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-001 (#1181): 1 iff b in [1,255]. bInterval == 0 is invalid for interrupt endpoints; > 255 is not encodable in the byte. Labels prefixed hcls_qv_.",
      block: {
        cmp rdi, 1;
        jb  hcls_qv_no;
        cmp rdi, 255;
        ja  hcls_qv_no;
        mov rax, 1;
        ret;
      hcls_qv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hid_class_setup_pack(buf, req, wValue, wIndex, wLength) -> OK | error
  //
  // Writes an 8-byte USB SETUP packet for one of the class-specific
  // requests, with bmRequestType assembled from direction (bit 7),
  // type=Class (bits 6:5 = 01) and recipient=Interface (bits 4:0 = 1).
  //
  // Direction is inferred from the request opcode:
  //   GET_*   -> IN  (bit 7 = 1)
  //   SET_*   -> OUT (bit 7 = 0)
  //
  // Layout:
  //   [+0] bmRequestType u8
  //   [+1] bRequest      u8
  //   [+2] wValue        u16
  //   [+4] wIndex        u16
  //   [+6] wLength       u16
  // ==========================================================================

  pub let hid_class_setup_pack : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (req: u64) (wValue: u64) (wIndex: u64) (wLength: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-001 (#1181): pack an 8-byte USB SETUP for a HID class request. Sequence: buf != 0; req_valid; direction inferred; write bmRequestType, bRequest, wValue, wIndex, wLength. Labels prefixed hcls_pk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // buf
        mov r12, rsi;                    // req
        mov r13, rdx;                    // wValue
        mov r14, rcx;                    // wIndex
        mov r15, r8;                     // wLength

        cmp rbx, 0;
        je  hcls_pk_bad_buf;

        mov rdi, r12;
        call hid_class_req_valid;
        cmp rax, 0;
        je  hcls_pk_bad_req;

        // Assemble bmRequestType:
        //   base = 0x21 (host->device, class, interface)
        //   GET_* opcodes set bit 7 -> 0xA1
        // (paideia-as encoder does not accept `bpl` as a byte-store src;
        // stage the byte in rax and store its low byte instead.)
        xor rbp, rbp;
        mov rbp, 0x21;
        cmp r12, 0x01;
        je  hcls_pk_in;
        cmp r12, 0x02;
        je  hcls_pk_in;
        cmp r12, 0x03;
        je  hcls_pk_in;
        jmp hcls_pk_out_bmt;
      hcls_pk_in:
        mov rbp, 0xA1;
      hcls_pk_out_bmt:

        mov rax, rbp;
        mov [rbx + 0], al;               // bmRequestType
        mov rax, r12;
        mov [rbx + 1], al;               // bRequest
        mov rax, r13;
        mov [rbx + 2], ax;               // wValue
        mov rax, r14;
        mov [rbx + 4], ax;               // wIndex
        mov rax, r15;
        mov [rbx + 6], ax;               // wLength

        mov rdi, 0;                      // ST_SETUP_PACKS
        call hid_class_note;

        xor rax, rax;
        jmp hcls_pk_out;

      hcls_pk_bad_buf:
        mov rdi, 3;
        call hid_class_note;
        mov rax, 0xFFFFFB1A;
        jmp hcls_pk_out;
      hcls_pk_bad_req:
        mov rdi, 3;
        call hid_class_note;
        mov rax, 0xFFFFFB1E;

      hcls_pk_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_class_set_protocol_pack(buf, interface, protocol) -> OK | error
  //
  // Convenience for SET_PROTOCOL. Refuses protocol > 1.
  // ==========================================================================

  pub let hid_class_set_protocol_pack : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (interface: u64) (protocol: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-001 (#1181): pack SET_PROTOCOL setup. Labels prefixed hcls_sp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        cmp rbx, 0;
        je  hcls_sp_bad_buf;

        mov rdi, r13;
        call hid_class_protocol_valid;
        cmp rax, 0;
        je  hcls_sp_bad_proto;

        mov rdi, rbx;
        mov rsi, 0x0B;                   // SET_PROTOCOL
        mov rdx, r13;                    // wValue = protocol
        mov rcx, r12;                    // wIndex = interface
        mov r8, 0;                       // wLength
        call hid_class_setup_pack;
        jmp hcls_sp_out;

      hcls_sp_bad_buf:
        mov rdi, 3;
        call hid_class_note;
        mov rax, 0xFFFFFB1A;
        jmp hcls_sp_out;
      hcls_sp_bad_proto:
        mov rdi, 3;
        call hid_class_note;
        mov rax, 0xFFFFFB1D;

      hcls_sp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_class_set_idle_pack(buf, interface, duration, report_id) -> OK | error
  //
  // Convenience for SET_IDLE. wValue = (duration << 8) | report_id.
  // duration and report_id must fit in a byte each — refuse otherwise.
  // ==========================================================================

  pub let hid_class_set_idle_pack : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (interface: u64) (duration: u64) (report_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-001 (#1181): pack SET_IDLE setup. Refuses duration/report_id > 0xFF (they must fit in the wValue byte fields). Labels prefixed hcls_si_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        cmp rbx, 0;
        je  hcls_si_bad_buf;

        cmp r13, 0xFF;
        ja  hcls_si_bad_val;
        cmp r14, 0xFF;
        ja  hcls_si_bad_val;

        // Assemble wValue = (duration << 8) | report_id.
        mov rax, r13;
        shl rax, 8;
        or  rax, r14;

        mov rdi, rbx;
        mov rsi, 0x0A;                   // SET_IDLE
        mov rdx, rax;                    // wValue
        mov rcx, r12;                    // wIndex = interface
        mov r8, 0;                       // wLength
        call hid_class_setup_pack;

        mov r10, rax;
        mov rdi, 2;                      // ST_IDLE_QUERIES
        call hid_class_note;
        mov rax, r10;
        jmp hcls_si_out;

      hcls_si_bad_buf:
        mov rdi, 3;
        call hid_class_note;
        mov rax, 0xFFFFFB1A;
        jmp hcls_si_out;
      hcls_si_bad_val:
        mov rdi, 3;
        call hid_class_note;
        mov rax, 0xFFFFFB19;

      hcls_si_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hid_class_get_protocol_pack(buf, interface) -> OK | error
  // ==========================================================================

  pub let hid_class_get_protocol_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (interface: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-001 (#1181): pack GET_PROTOCOL setup. Labels prefixed hcls_gp_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        cmp rbx, 0;
        je  hcls_gp_bad_buf;

        mov rdi, rbx;
        mov rsi, 0x03;                   // GET_PROTOCOL
        mov rdx, 0;                      // wValue
        mov rcx, r12;                    // wIndex
        mov r8, 1;                       // wLength = 1
        call hid_class_setup_pack;

        mov r10, rax;
        mov rdi, 1;                      // ST_PROTO_QUERIES
        call hid_class_note;
        mov rax, r10;
        jmp hcls_gp_out;

      hcls_gp_bad_buf:
        mov rdi, 3;
        call hid_class_note;
        mov rax, 0xFFFFFB1A;

      hcls_gp_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
