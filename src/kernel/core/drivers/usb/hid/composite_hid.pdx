// src/kernel/core/drivers/usb/hid/composite_hid.pdx — R34.M4-005 (#1185)
//
// Composite HID: a single USB interface presenting multiple top-level
// collections (typically a keyboard + a mouse on one interrupt-IN
// endpoint), distinguished by a Report ID in the first byte of each
// report. This module owns the Report-ID -> class-dispatch decision.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// USB-HID lets one interrupt-IN endpoint carry reports for MULTIPLE
// top-level collections. When the descriptor sets a REPORT_ID for any
// collection, every input report on that endpoint is prefixed with a
// one-byte Report ID; the class driver must:
//   (1) read report[0] as the Report ID,
//   (2) look up which collection (kbd, mouse, other) the ID belongs to,
//   (3) dispatch the remainder of the report to that collection's
//       decoder (kbd_full or mouse_full).
//
// This module holds the routing table:
//   [+0]  in_use (u8) | report_id (u8) | class (u8) — packed header
//   [+8]  driver_slot (opaque, forwarded to composite_bind)
//   [+16] reserved
//
// class values: 1 = keyboard, 2 = mouse, 3 = other.
//
// Row cap is 8: a real composite descriptor rarely uses more than three
// or four Report IDs, but eight is generous and small enough to keep
// the storage under a cache line * 24 = 192 bytes.
//
// IT IS NOT A DRIVER DISPATCHER. Same discipline as composite_bind.pdx:
// this module records the ROUTE decision the class-driver-selection
// process made; a live dispatcher in a later round consults it to
// deliver report bodies to the right decoder.
//
// IT IS NOT A LIVE DRIVER. composite_hid_arbitrated() returns 0 until a
// later round wires this into real per-collection dispatch.
//
// =============================================================================
// §1  ONE WRITER OF THE TABLE
// =============================================================================
//
// composite_hid_add, composite_hid_remove and composite_hid_reset are
// the ONLY writers of _composite_hid_table. tools/build.sh confines
// relocations against `_composite_hid_table` and `_composite_hid_stats`
// to this object.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFAD0..0xFFFFFADF
// =============================================================================
//
// Chosen because 0xFFFFFAD0..DF was FREE at repo grep time.

module CompositeHid = structure {

  pub let CHID_CLASS_KEYBOARD : u64 = 1
  pub let CHID_CLASS_MOUSE    : u64 = 2
  pub let CHID_CLASS_OTHER    : u64 = 3

  pub let CHID_OK             : u64 = 0
  pub let CHID_BAD_REPORT_ID  : u64 = 0xFFFFFADF
  pub let CHID_BAD_CLASS      : u64 = 0xFFFFFADE
  pub let CHID_ALREADY_BOUND  : u64 = 0xFFFFFADD
  pub let CHID_NOT_BOUND      : u64 = 0xFFFFFADC
  pub let CHID_ENOSPC         : u64 = 0xFFFFFADB
  pub let CHID_BAD_BUF        : u64 = 0xFFFFFADA
  pub let CHID_BAD_LEN        : u64 = 0xFFFFFAD9
  pub let CHID_BAD_ARG        : u64 = 0xFFFFFAD8

  pub let CHID_ROW_NONE : u64 = 0xFF

  pub let CHID_MAX       : u64 = 8
  pub let CHID_ROW_BYTES : u64 = 24

  // Layout per row (24 bytes):
  //   [+0]  in_use[63:56] | class[47:40] | report_id[39:32]
  //   [+8]  driver_slot
  //   [+16] reserved
  pub let mut _composite_hid_table : [u64; 24] = uninit @align(64)
  pub let mut _composite_hid_stats : [u64; 8]  = uninit @align(64)

  pub let CHID_ST_ROUTES        : u64 = 0
  pub let CHID_ST_UNROUTES      : u64 = 1
  pub let CHID_ST_REBIND_REFUSE : u64 = 2
  pub let CHID_ST_ENOSPC        : u64 = 3
  pub let CHID_ST_DEMUX_HITS    : u64 = 4
  pub let CHID_ST_REJECTS       : u64 = 5

  // ==========================================================================
  // composite_hid_reset() — teardown.
  // ==========================================================================

  pub let composite_hid_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): clear the composite HID table + counters. Labels prefixed chid_rs_.",
      block: {
        lea r10, [rip + _composite_hid_table];
        xor rax, rax;
        xor rcx, rcx;
      chid_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 24;
        jb  chid_rs_rows;

        lea r10, [rip + _composite_hid_stats];
        xor rcx, rcx;
      chid_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  chid_rs_stats;
        ret
      }
    }

  pub let composite_hid_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-005 (#1185): honesty pin. Returns 0 until a later round wires real per-collection dispatch.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let composite_hid_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): counter read. Labels prefixed chid_st_.",
      block: {
        cmp rdi, 8;
        jae chid_st_zero;
        lea r10, [rip + _composite_hid_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      chid_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let composite_hid_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): counter bump. Labels prefixed chid_nt_.",
      block: {
        cmp rdi, 8;
        jae chid_nt_out;
        lea r10, [rip + _composite_hid_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      chid_nt_out:
        ret
      }
    }

  pub let chid_class_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-005 (#1185): 1 iff c in {1,2,3}. Labels prefixed chid_cv_.",
      block: {
        cmp rdi, 1;
        jb  chid_cv_no;
        cmp rdi, 3;
        ja  chid_cv_no;
        mov rax, 1;
        ret;
      chid_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // composite_hid_find(report_id) -> row_id | CHID_ROW_NONE
  // ==========================================================================

  pub let composite_hid_find : (u64) -> u64 !{mem} @{} =
    fn (report_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): linear scan for the row whose report_id matches. Labels prefixed chid_fd_.",
      block: {
        cmp rdi, 255;
        ja  chid_fd_none;

        xor rcx, rcx;
      chid_fd_scan:
        cmp rcx, 8;
        jae chid_fd_none;
        lea r10, [rip + _composite_hid_table];
        mov r11, rcx;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;                     // rcx * 24
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  chid_fd_next;
        mov rax, [r10 + 0];
        shr rax, 32;
        and rax, 0xFF;                   // report_id from header
        cmp rax, rdi;
        je  chid_fd_hit;
      chid_fd_next:
        add rcx, 1;
        jmp chid_fd_scan;
      chid_fd_hit:
        mov rax, rcx;
        ret;
      chid_fd_none:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // composite_hid_add(report_id, class, driver_slot) -> row_id | error
  // ==========================================================================

  pub let composite_hid_add : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (report_id: u64) (class: u64) (driver_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): claim one route row. Sequence: (1) report_id in [1,255]; (2) class in [1,3]; (3) already-bound refuses; (4) free-row scan; (5) claim. Labels prefixed chid_ad_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // report_id
        mov r13, rsi;                    // class
        mov r14, rdx;                    // driver_slot

        cmp r12, 1;
        jb  chid_ad_bad_rid;
        cmp r12, 255;
        ja  chid_ad_bad_rid;

        mov rdi, r13;
        call chid_class_valid;
        cmp rax, 0;
        je  chid_ad_bad_class;

        mov rdi, r12;
        call composite_hid_find;
        cmp rax, 0xFF;
        jne chid_ad_already;

        xor rbx, rbx;
      chid_ad_scan:
        cmp rbx, 8;
        jae chid_ad_enospc;

        lea r10, [rip + _composite_hid_table];
        mov r11, rbx;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;                     // rbx * 24
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  chid_ad_claim;

        add rbx, 1;
        jmp chid_ad_scan;

      chid_ad_claim:
        // header = (1 << 56) | ((class & 0xFF) << 40) | ((report_id & 0xFF) << 32)
        mov rax, r12;
        and rax, 0xFF;
        shl rax, 32;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 40;
        or  rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r14;
        xor rax, rax;
        mov [r10 + 16], rax;

        mov rdi, 0;                      // ST_ROUTES
        call composite_hid_note;

        mov rax, rbx;
        jmp chid_ad_out;

      chid_ad_bad_rid:
        mov rdi, 5;
        call composite_hid_note;
        mov rax, 0xFFFFFADF;
        jmp chid_ad_out;
      chid_ad_bad_class:
        mov rdi, 5;
        call composite_hid_note;
        mov rax, 0xFFFFFADE;
        jmp chid_ad_out;
      chid_ad_already:
        mov rdi, 2;                      // ST_REBIND_REFUSE
        call composite_hid_note;
        mov rax, 0xFFFFFADD;
        jmp chid_ad_out;
      chid_ad_enospc:
        mov rdi, 3;                      // ST_ENOSPC
        call composite_hid_note;
        mov rax, 0xFFFFFADB;

      chid_ad_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // composite_hid_remove(report_id) -> OK | NOT_BOUND
  // ==========================================================================

  pub let composite_hid_remove : (u64) -> u64 !{mem} @{} =
    fn (report_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): remove the route for report_id. Labels prefixed chid_rm_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        call composite_hid_find;
        mov r13, rax;
        cmp r13, 0xFF;
        je  chid_rm_none;

        lea r10, [rip + _composite_hid_table];
        mov r11, r13;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;

        mov rdi, 1;                      // ST_UNROUTES
        call composite_hid_note;

        xor rax, rax;
        jmp chid_rm_out;

      chid_rm_none:
        mov rax, 0xFFFFFADC;

      chid_rm_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // composite_hid_class_of(report_id) -> class | NOT_BOUND
  // ==========================================================================

  pub let composite_hid_class_of : (u64) -> u64 !{mem} @{} =
    fn (report_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): class assigned to report_id, or NOT_BOUND. Labels prefixed chid_co_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        call composite_hid_find;
        mov r13, rax;
        cmp r13, 0xFF;
        je  chid_co_none;

        lea r10, [rip + _composite_hid_table];
        mov r11, r13;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 40;
        and rax, 0xFF;
        jmp chid_co_out;

      chid_co_none:
        mov rax, 0xFFFFFADC;

      chid_co_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // composite_hid_driver_of(report_id) -> driver_slot | NOT_BOUND
  // ==========================================================================

  pub let composite_hid_driver_of : (u64) -> u64 !{mem} @{} =
    fn (report_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): driver_slot for report_id, or NOT_BOUND. Labels prefixed chid_do_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        call composite_hid_find;
        mov r13, rax;
        cmp r13, 0xFF;
        je  chid_do_none;

        lea r10, [rip + _composite_hid_table];
        mov r11, r13;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp chid_do_out;

      chid_do_none:
        mov rax, 0xFFFFFADC;

      chid_do_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // composite_hid_demux(buf, len) -> class | error
  //
  // Peeks buf[0] as Report ID and returns its bound class, refusing if
  // no route exists for that ID or if the buffer is invalid.
  // ==========================================================================

  pub let composite_hid_demux : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): peek Report ID at buf[0], look up its class. Labels prefixed chid_dx_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  chid_dx_bad_buf;
        cmp r13, 1;
        jb  chid_dx_bad_len;

        xor rax, rax;
        mov_b rax, [r12];
        mov rdi, rax;
        call composite_hid_class_of;

        // Non-fatal class miss propagates NOT_BOUND unchanged.
        push rax;
        mov rdi, 4;                      // ST_DEMUX_HITS
        call composite_hid_note;
        pop rax;
        jmp chid_dx_out;

      chid_dx_bad_buf:
        mov rdi, 5;
        call composite_hid_note;
        mov rax, 0xFFFFFADA;
        jmp chid_dx_out;
      chid_dx_bad_len:
        mov rdi, 5;
        call composite_hid_note;
        mov rax, 0xFFFFFAD9;

      chid_dx_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // composite_hid_count() -> live row count
  // ==========================================================================

  pub let composite_hid_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-005 (#1185): live row count. Labels prefixed chid_ct_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      chid_ct_scan:
        cmp rcx, 8;
        jae chid_ct_done;
        lea r10, [rip + _composite_hid_table];
        mov r11, rcx;
        mov r8, r11;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov r11, [r10 + 0];
        shr r11, 56;
        cmp r11, 0;
        je  chid_ct_next;
        add rax, 1;
      chid_ct_next:
        add rcx, 1;
        jmp chid_ct_scan;
      chid_ct_done:
        ret
      }
    }
}
