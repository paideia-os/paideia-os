// src/kernel/core/drivers/usb/hid/mouse_full.pdx — R34.M4-003 (#1183)
//
// USB-HID mouse beyond boot protocol. 12-bit signed X/Y coordinates,
// vertical wheel, horizontal (AC-Pan) scroll, high-res multiplier
// feature-report gating, and up to 8 buttons.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// The boot-protocol mouse report is fixed 3 bytes:
//   [+0] buttons (bits 0..2 = L,R,M)
//   [+1] dx      (s8)
//   [+2] dy      (s8)
//
// Real USB-HID mice use REPORT-PROTOCOL. A typical descriptor packs:
//   [+0] buttons u8 (bits 0..7)
//   [+1..+3] dx/dy as 12-bit signed values (three bytes total)
//   [+4] wheel u8 (s8, Y-scroll usage 0x38)
//   [+5] hwheel u8 (s8, AC-Pan usage 0x0238)
//
// High-resolution scroll uses a FEATURE report to set a multiplier
// (usage 0x048 on the Wheel Resolution Multiplier record) which,
// when non-zero, is applied to subsequent wheel deltas.
//
// This module offers:
//   * unpack 12-bit signed X and Y from a 3-byte payload
//   * s8 wheel and hwheel accessors
//   * button-mask accessor with configurable max-buttons gate
//   * high-res multiplier pack/unpack helpers with valid-range gate
//
// IT IS NOT A LIVE DRIVER. mouse_full_arbitrated() returns 0 until the
// class driver wires this into a live interrupt-IN completion loop.
//
// =============================================================================
// §1  ERROR CODES 0xFFFFFAF0..0xFFFFFAFF
// =============================================================================
//
// Chosen because 0xFFFFFAF0..FF was FREE at repo grep time.

module MouseFull = structure {

  // Usage page + IDs (HID Usage Tables 1.4 §4 Generic Desktop, §12 Consumer).
  pub let MOUSE_USAGE_PAGE_GD       : u64 = 0x01
  pub let MOUSE_USAGE_ID_X          : u64 = 0x30
  pub let MOUSE_USAGE_ID_Y          : u64 = 0x31
  pub let MOUSE_USAGE_ID_WHEEL      : u64 = 0x38
  pub let MOUSE_USAGE_PAGE_CONSUMER : u64 = 0x0C
  pub let MOUSE_USAGE_ID_AC_PAN     : u64 = 0x0238
  pub let MOUSE_USAGE_ID_RES_MULT   : u64 = 0x048

  // 12-bit signed range: [-2048, 2047].
  pub let MOUSE_XY_MIN : u64 = 0xFFFFFFFFFFFFF800    // -2048 sign-extended
  pub let MOUSE_XY_MAX : u64 = 0x00000000000007FF    //  2047

  // Resolution multiplier accepted values.
  pub let MOUSE_RESMULT_OFF : u64 = 0
  pub let MOUSE_RESMULT_ON  : u64 = 1
  pub let MOUSE_RESMULT_MAX : u64 = 15               // 4-bit field per HID UT

  pub let MOUSE_BUTTON_MAX : u64 = 8                 // 8 buttons in the byte

  pub let MOUSE_OK             : u64 = 0
  pub let MOUSE_BAD_BUF        : u64 = 0xFFFFFAFF
  pub let MOUSE_BAD_LEN        : u64 = 0xFFFFFAFE
  pub let MOUSE_BAD_MULT       : u64 = 0xFFFFFAFD
  pub let MOUSE_BAD_BUTTON     : u64 = 0xFFFFFAFC
  pub let MOUSE_BAD_ARG        : u64 = 0xFFFFFAFB

  pub let mut _mouse_full_stats : [u64; 8] = uninit @align(64)

  pub let MOUSE_ST_XY_UNPACKS  : u64 = 0
  pub let MOUSE_ST_WHEEL_READS : u64 = 1
  pub let MOUSE_ST_BTN_READS   : u64 = 2
  pub let MOUSE_ST_MULT_PACKS  : u64 = 3
  pub let MOUSE_ST_REJECTS     : u64 = 4

  // ==========================================================================
  // mouse_full_reset() — counters only.
  // ==========================================================================

  pub let mouse_full_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): clear mouse stats. Labels prefixed mus_rs_.",
      block: {
        lea r10, [rip + _mouse_full_stats];
        xor rax, rax;
        xor rcx, rcx;
      mus_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  mus_rs_loop;
        ret
      }
    }

  pub let mouse_full_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-003 (#1183): honesty pin. Returns 0 until composite_bind + usb_hid_class wire this into a live interrupt-IN completion loop.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let mouse_full_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): counter read. Labels prefixed mus_st_.",
      block: {
        cmp rdi, 8;
        jae mus_st_zero;
        lea r10, [rip + _mouse_full_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      mus_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let mouse_full_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): counter bump. Labels prefixed mus_nt_.",
      block: {
        cmp rdi, 8;
        jae mus_nt_out;
        lea r10, [rip + _mouse_full_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      mus_nt_out:
        ret
      }
    }

  // ==========================================================================
  // mouse_unpack_x12(buf, len) -> signed x (as u64, sign-extended)
  // mouse_unpack_y12(buf, len) -> signed y (as u64, sign-extended)
  //
  // Layout convention: three bytes at buf[0..3] carry X in bits [11:0]
  // and Y in bits [23:12] (little-endian nibble packing).
  //   X = (b0 | ((b1 & 0x0F) << 8))       — bits [11:0]
  //   Y = ((b1 >> 4) | (b2 << 4))         — bits [23:12]
  // Sign-extend the 12-bit result.
  // ==========================================================================

  pub let mouse_unpack_x12 : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): unpack 12-bit signed X from a 3-byte payload, sign-extended into a u64. Labels prefixed mus_ux_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  mus_ux_bad_buf;
        cmp r13, 3;
        jb  mus_ux_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + 0];            // b0
        xor r10, r10;
        mov_b r10, [r12 + 1];            // b1
        and r10, 0x0F;
        shl r10, 8;
        or  rax, r10;

        // Sign-extend from bit 11.
        mov r10, rax;
        and r10, 0x800;
        cmp r10, 0;
        je  mus_ux_pos;
        mov r10, 0xFFFFFFFFFFFFF000;
        or  rax, r10;
      mus_ux_pos:
        mov r10, rax;
        mov rdi, 0;                      // ST_XY_UNPACKS
        call mouse_full_note;
        mov rax, r10;
        jmp mus_ux_out;

      mus_ux_bad_buf:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFF;
        jmp mus_ux_out;
      mus_ux_bad_len:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFE;

      mus_ux_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let mouse_unpack_y12 : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): unpack 12-bit signed Y from a 3-byte payload, sign-extended into a u64. Labels prefixed mus_uy_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  mus_uy_bad_buf;
        cmp r13, 3;
        jb  mus_uy_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + 1];            // b1
        shr rax, 4;                      // low nibble is X-high; high nibble is Y-low
        xor r10, r10;
        mov_b r10, [r12 + 2];            // b2
        shl r10, 4;
        or  rax, r10;

        // Sign-extend from bit 11.
        mov r10, rax;
        and r10, 0x800;
        cmp r10, 0;
        je  mus_uy_pos;
        mov r10, 0xFFFFFFFFFFFFF000;
        or  rax, r10;
      mus_uy_pos:
        mov r10, rax;
        mov rdi, 0;                      // ST_XY_UNPACKS
        call mouse_full_note;
        mov rax, r10;
        jmp mus_uy_out;

      mus_uy_bad_buf:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFF;
        jmp mus_uy_out;
      mus_uy_bad_len:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFE;

      mus_uy_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // mouse_read_wheel(buf, len, offset) -> signed wheel delta
  //   (s8 at buf[offset], sign-extended)
  // ==========================================================================

  pub let mouse_read_wheel : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): read one signed byte at buf[offset], sign-extend. Serves both Y wheel (0x38) and AC-Pan hwheel (0x0238); layout offset is caller-supplied per the descriptor. Labels prefixed mus_wh_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  mus_wh_bad_buf;

        mov rcx, r14;
        add rcx, 1;
        cmp rcx, r13;
        ja  mus_wh_bad_len;

        xor rax, rax;
        mov_b rax, [r12 + r14 * 1];
        // Sign-extend from bit 7.
        mov r10, rax;
        and r10, 0x80;
        cmp r10, 0;
        je  mus_wh_pos;
        mov r10, 0xFFFFFFFFFFFFFF00;
        or  rax, r10;
      mus_wh_pos:
        mov r10, rax;
        mov rdi, 1;                      // ST_WHEEL_READS
        call mouse_full_note;
        mov rax, r10;
        jmp mus_wh_out;

      mus_wh_bad_buf:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFF;
        jmp mus_wh_out;
      mus_wh_bad_len:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFE;

      mus_wh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // mouse_read_buttons(buf, len, max_buttons) -> button mask | error
  //
  // Reads buf[0]. max_buttons in [1, 8] — a higher value would let a
  // caller advertise a wider button set than the byte can carry, so we
  // refuse rather than clamp.
  // ==========================================================================

  pub let mouse_read_buttons : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (max_buttons: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): read buttons byte; mask by (1<<max_buttons)-1. Labels prefixed mus_bt_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  mus_bt_bad_buf;
        cmp r13, 1;
        jb  mus_bt_bad_len;
        cmp r14, 1;
        jb  mus_bt_bad_btn;
        cmp r14, 8;
        ja  mus_bt_bad_btn;

        xor rax, rax;
        mov_b rax, [r12];

        // mask = (1 << max_buttons) - 1
        mov rcx, r14;
        mov r10, 1;
        shl r10, cl;
        sub r10, 1;
        and rax, r10;

        mov r10, rax;
        mov rdi, 2;                      // ST_BTN_READS
        call mouse_full_note;
        mov rax, r10;
        jmp mus_bt_out;

      mus_bt_bad_buf:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFF;
        jmp mus_bt_out;
      mus_bt_bad_len:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFE;
        jmp mus_bt_out;
      mus_bt_bad_btn:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFC;

      mus_bt_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // mouse_resmult_valid(m) -> 1 iff m in [0, 15]
  // ==========================================================================

  pub let mouse_resmult_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-003 (#1183): 1 iff m in [0,15] (4-bit multiplier field). Labels prefixed mus_mv_.",
      block: {
        cmp rdi, 15;
        ja  mus_mv_no;
        mov rax, 1;
        ret;
      mus_mv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // mouse_resmult_pack(buf, len, mult) -> OK | error
  //
  // Writes a 1-byte Resolution Multiplier FEATURE report at buf[0].
  // ==========================================================================

  pub let mouse_resmult_pack : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (mult: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-003 (#1183): pack multiplier byte. Labels prefixed mus_mp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  mus_mp_bad_buf;
        cmp r13, 1;
        jb  mus_mp_bad_len;

        mov rdi, r14;
        call mouse_resmult_valid;
        cmp rax, 0;
        je  mus_mp_bad_mult;

        mov rax, r14;
        mov [r12], al;

        mov rdi, 3;                      // ST_MULT_PACKS
        call mouse_full_note;

        xor rax, rax;
        jmp mus_mp_out;

      mus_mp_bad_buf:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFF;
        jmp mus_mp_out;
      mus_mp_bad_len:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFE;
        jmp mus_mp_out;
      mus_mp_bad_mult:
        mov rdi, 4;
        call mouse_full_note;
        mov rax, 0xFFFFFAFD;

      mus_mp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
