// src/kernel/core/drivers/usb/hid/gamepad.pdx — R34.M4-004 (#1184)
//
// USB-HID gamepad enumeration: Generic Desktop page (0x01), Game Pad
// usage (0x05), per-axis calibration event. Analog axes (X/Y/Z/Rx/Ry/
// Rz), hat switch (usage 0x39), and up to 32 buttons.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// A USB HID gamepad advertises its top-level collection with usage
// page 0x01 and usage id 0x05. Its report descriptor typically walks:
//   * Analog axes X (0x30), Y (0x31), Z (0x32), Rx (0x33), Ry (0x34), Rz (0x35)
//     — each an s16 or normalized u8 per the descriptor.
//   * Hat switch (0x39) — 4-bit field, values 0..7 = 8-way directions,
//     value 0x0F = null (no direction pressed).
//   * Buttons — Button page (0x09), one bit per button, up to 32.
//
// This module offers:
//   * gp_top_collection_valid(page, id) — 1 iff (0x01, 0x05)
//   * gp_axis_usage_valid(id) — 1 iff id in [0x30, 0x35]
//   * gp_axis_read_s16(buf, len, offset) — signed 16-bit axis sample
//   * gp_axis_normalize(sample, lmin, lmax) — map [lmin, lmax] -> [-32768, 32767]
//                                             with a refuse gate on lmin >= lmax
//   * gp_hat_decode(nibble) — decoded direction, or GP_HAT_NULL for 0x0F
//   * gp_buttons_read_u32(buf, len, offset) — up to 32 buttons packed LE
//
// IT IS NOT A LIVE DRIVER. gamepad_arbitrated() returns 0 until the
// class driver wires this into a live interrupt-IN completion loop.
//
// =============================================================================
// §1  ERROR CODES 0xFFFFFAE0..0xFFFFFAEF
// =============================================================================
//
// Chosen because 0xFFFFFAE0..EF was FREE at repo grep time.

module Gamepad = structure {

  pub let GP_USAGE_PAGE_GD       : u64 = 0x01
  pub let GP_USAGE_ID_GAMEPAD    : u64 = 0x05

  pub let GP_USAGE_ID_X          : u64 = 0x30
  pub let GP_USAGE_ID_Y          : u64 = 0x31
  pub let GP_USAGE_ID_Z          : u64 = 0x32
  pub let GP_USAGE_ID_RX         : u64 = 0x33
  pub let GP_USAGE_ID_RY         : u64 = 0x34
  pub let GP_USAGE_ID_RZ         : u64 = 0x35
  pub let GP_USAGE_ID_HAT        : u64 = 0x39

  pub let GP_USAGE_PAGE_BUTTON   : u64 = 0x09

  // Hat direction decode: 0 = N, 1 = NE, 2 = E, 3 = SE, 4 = S, 5 = SW,
  // 6 = W, 7 = NW, 15 = null. Any other nibble is a descriptor bug.
  pub let GP_HAT_N     : u64 = 0
  pub let GP_HAT_NE    : u64 = 1
  pub let GP_HAT_E     : u64 = 2
  pub let GP_HAT_SE    : u64 = 3
  pub let GP_HAT_S     : u64 = 4
  pub let GP_HAT_SW    : u64 = 5
  pub let GP_HAT_W     : u64 = 6
  pub let GP_HAT_NW    : u64 = 7
  pub let GP_HAT_NULL  : u64 = 0xFF                  // decoded null

  // Normalization target: signed 16-bit range.
  pub let GP_NORM_MIN : u64 = 0xFFFFFFFFFFFF8000     // -32768
  pub let GP_NORM_MAX : u64 = 0x0000000000007FFF     //  32767

  pub let GP_OK           : u64 = 0
  pub let GP_BAD_BUF      : u64 = 0xFFFFFAEF
  pub let GP_BAD_LEN      : u64 = 0xFFFFFAEE
  pub let GP_BAD_USAGE    : u64 = 0xFFFFFAED
  pub let GP_BAD_HAT      : u64 = 0xFFFFFAEC
  pub let GP_BAD_RANGE    : u64 = 0xFFFFFAEB

  pub let mut _gamepad_stats : [u64; 8] = uninit @align(64)

  pub let GP_ST_AXIS_READS   : u64 = 0
  pub let GP_ST_HAT_DECODES  : u64 = 1
  pub let GP_ST_BTN_READS    : u64 = 2
  pub let GP_ST_CALIBRATIONS : u64 = 3
  pub let GP_ST_REJECTS      : u64 = 4

  // ==========================================================================
  // gamepad_reset() — counters only.
  // ==========================================================================

  pub let gamepad_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-004 (#1184): clear gamepad stats. Labels prefixed gp_rs_.",
      block: {
        lea r10, [rip + _gamepad_stats];
        xor rax, rax;
        xor rcx, rcx;
      gp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gp_rs_loop;
        ret
      }
    }

  pub let gamepad_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-004 (#1184): honesty pin. Returns 0 until the class driver wires this into a real interrupt-IN completion loop.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let gamepad_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-004 (#1184): counter read. Labels prefixed gp_st_.",
      block: {
        cmp rdi, 8;
        jae gp_st_zero;
        lea r10, [rip + _gamepad_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      gp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let gamepad_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-004 (#1184): counter bump. Labels prefixed gp_nt_.",
      block: {
        cmp rdi, 8;
        jae gp_nt_out;
        lea r10, [rip + _gamepad_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      gp_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let gp_top_collection_valid : (u64, u64) -> u64 !{} @{} =
    fn (page: u64) (usage_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-004 (#1184): 1 iff (page, usage_id) == (0x01, 0x05). Labels prefixed gp_tv_.",
      block: {
        cmp rdi, 0x01;
        jne gp_tv_no;
        cmp rsi, 0x05;
        jne gp_tv_no;
        mov rax, 1;
        ret;
      gp_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let gp_axis_usage_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-004 (#1184): 1 iff id in [0x30, 0x35]. Labels prefixed gp_av_.",
      block: {
        cmp rdi, 0x30;
        jb  gp_av_no;
        cmp rdi, 0x35;
        ja  gp_av_no;
        mov rax, 1;
        ret;
      gp_av_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // gp_axis_read_s16(buf, len, offset) -> signed 16-bit axis sample
  //   (sign-extended into a u64)
  // ==========================================================================

  pub let gp_axis_read_s16 : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-004 (#1184): read s16 at buf[offset], sign-extend. Labels prefixed gp_ar_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  gp_ar_bad_buf;

        mov rcx, r14;
        add rcx, 2;
        cmp rcx, r13;
        ja  gp_ar_bad_len;

        xor rax, rax;
        mov ax, [r12 + r14 * 1];
        // Sign-extend from bit 15.
        mov r10, rax;
        and r10, 0x8000;
        cmp r10, 0;
        je  gp_ar_pos;
        mov r10, 0xFFFFFFFFFFFF0000;
        or  rax, r10;
      gp_ar_pos:
        mov r10, rax;
        mov rdi, 0;                      // ST_AXIS_READS
        call gamepad_note;
        mov rax, r10;
        jmp gp_ar_out;

      gp_ar_bad_buf:
        mov rdi, 4;
        call gamepad_note;
        mov rax, 0xFFFFFAEF;
        jmp gp_ar_out;
      gp_ar_bad_len:
        mov rdi, 4;
        call gamepad_note;
        mov rax, 0xFFFFFAEE;

      gp_ar_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // gp_axis_normalize(sample, lmin, lmax) -> normalized s16 sample
  //
  // Maps sample in [lmin, lmax] to [-32768, 32767] via a linear rescale.
  // sample, lmin, lmax are treated as signed 32-bit values. Refuses
  // lmin >= lmax (a descriptor with equal or inverted bounds is a bug
  // upstream; silently returning 0 would hide it).
  // ==========================================================================

  pub let gp_axis_normalize : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sample: u64) (lmin: u64) (lmax: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-004 (#1184): linear rescale sample in [lmin, lmax] to [-32768, 32767]. Sign-agnostic 64-bit arithmetic. Labels prefixed gp_nz_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // sample
        mov r13, rsi;                    // lmin
        mov r14, rdx;                    // lmax

        // Refuse lmin >= lmax (signed).
        mov rax, r13;
        mov rcx, r14;
        cmp rax, rcx;
        jge gp_nz_bad_range;

        // rspan = lmax - lmin
        mov rbx, r14;
        sub rbx, r13;

        // shifted = sample - lmin
        mov rax, r12;
        sub rax, r13;

        // scaled = shifted * 65535 / rspan
        // Product bound: shifted <= rspan; typical descriptor range is
        // <= 2^32-1 so shifted * 65535 <= ~2^48, comfortably in u64.
        // Use truncated imul (paideia-as has imul r64,r64 but no mul r64;
        // for the unsigned-fit case truncated imul yields the same bits).
        mov r10, 65535;
        imul rax, r10;                   // rax = shifted * 65535 (truncated)
        xor rdx, rdx;                    // clear high half for div
        div rbx;                         // rax = quotient

        // normalized = scaled - 32768
        sub rax, 32768;

        mov r10, rax;
        mov rdi, 3;                      // ST_CALIBRATIONS
        call gamepad_note;
        mov rax, r10;
        jmp gp_nz_out;

      gp_nz_bad_range:
        mov rdi, 4;
        call gamepad_note;
        mov rax, 0xFFFFFAEB;

      gp_nz_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gp_hat_decode(nibble) -> direction | GP_HAT_NULL | error
  //   0..7 -> direction; 0x0F -> GP_HAT_NULL; anything else -> BAD_HAT.
  // ==========================================================================

  pub let gp_hat_decode : (u64) -> u64 !{mem} @{} =
    fn (nibble: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-004 (#1184): decode hat-switch nibble. Labels prefixed gp_hd_.",
      block: {
        push r12;
        mov r12, rdi;

        cmp r12, 7;
        jbe gp_hd_ok_dir;
        cmp r12, 0x0F;
        je  gp_hd_null;
        jmp gp_hd_bad;

      gp_hd_ok_dir:
        mov r10, r12;
        mov rdi, 1;                      // ST_HAT_DECODES
        call gamepad_note;
        mov rax, r10;
        jmp gp_hd_out;

      gp_hd_null:
        mov rdi, 1;
        call gamepad_note;
        mov rax, 0xFF;
        jmp gp_hd_out;

      gp_hd_bad:
        mov rdi, 4;
        call gamepad_note;
        mov rax, 0xFFFFFAEC;

      gp_hd_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // gp_buttons_read_u32(buf, len, offset) -> u32 button mask
  //   Reads 4 bytes little-endian at buf[offset].
  // ==========================================================================

  pub let gp_buttons_read_u32 : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-004 (#1184): read 32-bit LE button mask at buf[offset]. Labels prefixed gp_br_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  gp_br_bad_buf;

        mov rcx, r14;
        add rcx, 4;
        cmp rcx, r13;
        ja  gp_br_bad_len;

        xor rax, rax;
        mov eax, [r12 + r14 * 1];

        mov r10, rax;
        mov rdi, 2;                      // ST_BTN_READS
        call gamepad_note;
        mov rax, r10;
        jmp gp_br_out;

      gp_br_bad_buf:
        mov rdi, 4;
        call gamepad_note;
        mov rax, 0xFFFFFAEF;
        jmp gp_br_out;
      gp_br_bad_len:
        mov rdi, 4;
        call gamepad_note;
        mov rax, 0xFFFFFAEE;

      gp_br_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
