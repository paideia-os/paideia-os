// src/kernel/core/drivers/usb/hid/kbd_full.pdx — R34.M4-002 (#1182)
//
// USB-HID keyboard beyond boot protocol. Variable-length input reports
// with N-key rollover (one byte per pressed key, not the 6-key cap of
// the boot protocol), plus LED output-report packing and the consumer-
// control usage page validators.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// The boot-protocol keyboard report is fixed 8 bytes:
//   [+0] modifiers  (bits: LCtrl, LShift, LAlt, LGUI, RCtrl, RShift, RAlt, RGUI)
//   [+1] reserved
//   [+2..+7] up to 6 usage IDs, 0 == none
//
// Real USB-HID keyboards use REPORT-PROTOCOL, where the descriptor
// says how the input report is laid out — typically:
//   [+0] modifiers (bitfield, 8 bits)
//   [+1..+n] a bitmap of pressed key usages (one bit per usage, N-key
//            rollover) OR a variable-length array of usage IDs.
//
// This module accepts BOTH forms and pins them to their contracts:
//   * modifier-byte extraction and validity gate
//   * bitmap decoder: count set bits ("how many keys down")
//   * bitmap decoder: probe a usage-id-in-bitmap query
//   * LED output-report pack (Num/Caps/Scroll/Compose/Kana)
//   * consumer-control page (0x0C) usage-id validity
//
// IT DOES NOT LISTEN ON AN INTERRUPT-IN ENDPOINT. Real report delivery
// arrives through hid_event_stream + usb_hid_class + KIND_USB_URB in a
// later round; this module decodes the bytes those transfers carry.
//
// IT IS NOT A LIVE DRIVER. kbd_full_arbitrated() returns 0 until the
// class driver wires this into a real interrupt-IN completion loop.
//
// =============================================================================
// §1  ERROR CODES 0xFFFFFB00..0xFFFFFB0F
// =============================================================================
//
// Chosen because 0xFFFFFB00..0F was FREE at repo grep time (the sole
// reference at 0xFFFFFB00 was a comment in interface_parser.pdx §4).
// Disjoint from every existing kind/driver band.

module KbdFull = structure {

  // Consumer control usage page and standard IDs (HID Usage Tables 1.4
  // §15). This is the page that carries media keys — play/pause, mute,
  // volume up/down, brightness, WWW keys, etc.
  pub let KBD_USAGE_PAGE_KEYBOARD : u64 = 0x07
  pub let KBD_USAGE_PAGE_CONSUMER : u64 = 0x0C

  // Modifier bit assignments (HID Usage Tables 1.4 §10, boot-protocol
  // ordering — kept for backward compatibility with the report-protocol
  // descriptors that reuse the same byte).
  pub let KBD_MOD_LCTRL  : u64 = 0x01
  pub let KBD_MOD_LSHIFT : u64 = 0x02
  pub let KBD_MOD_LALT   : u64 = 0x04
  pub let KBD_MOD_LGUI   : u64 = 0x08
  pub let KBD_MOD_RCTRL  : u64 = 0x10
  pub let KBD_MOD_RSHIFT : u64 = 0x20
  pub let KBD_MOD_RALT   : u64 = 0x40
  pub let KBD_MOD_RGUI   : u64 = 0x80

  // LED output-report bit assignments (HID Usage Tables 1.4 §11).
  pub let KBD_LED_NUM     : u64 = 0x01
  pub let KBD_LED_CAPS    : u64 = 0x02
  pub let KBD_LED_SCROLL  : u64 = 0x04
  pub let KBD_LED_COMPOSE : u64 = 0x08
  pub let KBD_LED_KANA    : u64 = 0x10
  pub let KBD_LED_MASK    : u64 = 0x1F

  // Report-protocol usage-ID range for the standard Keyboard page:
  // HID Usage Tables 1.4 §10 lists 0x00..0xE7 as assigned; 0x00 is
  // reserved ("no event indicated"). We accept 1..255 (the highest
  // encodable u8) as valid input to the bitmap probe — a live driver
  // would use hid_usage_id_kind to further classify.
  pub let KBD_USAGE_ID_MIN : u64 = 1
  pub let KBD_USAGE_ID_MAX : u64 = 255

  // Consumer-control usage IDs of interest, per HID UT 1.4 §15.
  // (Range gate is 1..0xFFFF; specific IDs below are for the witness.)
  pub let KBD_CONS_VOL_UP    : u64 = 0xE9
  pub let KBD_CONS_VOL_DOWN  : u64 = 0xEA
  pub let KBD_CONS_MUTE      : u64 = 0xE2
  pub let KBD_CONS_PLAY_PAUSE: u64 = 0xCD

  pub let KBD_OK              : u64 = 0
  pub let KBD_BAD_BUF         : u64 = 0xFFFFFB0F
  pub let KBD_BAD_LEN         : u64 = 0xFFFFFB0E
  pub let KBD_BAD_USAGE_ID    : u64 = 0xFFFFFB0D
  pub let KBD_BAD_LEDS        : u64 = 0xFFFFFB0C
  pub let KBD_BAD_PAGE        : u64 = 0xFFFFFB0B
  pub let KBD_NOT_FOUND       : u64 = 0xFFFFFB0A

  pub let mut _kbd_full_stats : [u64; 8] = uninit @align(64)

  pub let KBD_ST_MOD_READS   : u64 = 0
  pub let KBD_ST_KEY_COUNTS  : u64 = 1
  pub let KBD_ST_KEY_PROBES  : u64 = 2
  pub let KBD_ST_LED_PACKS   : u64 = 3
  pub let KBD_ST_REJECTS     : u64 = 4

  // ==========================================================================
  // kbd_full_reset() — counters only.
  // ==========================================================================

  pub let kbd_full_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-002 (#1182): clear kbd stats. Labels prefixed kbd_rs_.",
      block: {
        lea r10, [rip + _kbd_full_stats];
        xor rax, rax;
        xor rcx, rcx;
      kbd_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kbd_rs_loop;
        ret
      }
    }

  pub let kbd_full_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-002 (#1182): honesty pin. Returns 0 until composite_bind + usb_hid_class wire this into a live interrupt-IN completion loop.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let kbd_full_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-002 (#1182): counter read. Labels prefixed kbd_st_.",
      block: {
        cmp rdi, 8;
        jae kbd_st_zero;
        lea r10, [rip + _kbd_full_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kbd_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let kbd_full_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-002 (#1182): counter bump. Labels prefixed kbd_nt_. Preserves r10 across the counter bump: kbd_read_modifiers / kbd_count_bits / kbd_bitmap_probe stage their return value in r10 across this call — the naked `lea r10, ...` below would clobber it.",
      block: {
        push r10;
        cmp rdi, 8;
        jae kbd_nt_out;
        lea r10, [rip + _kbd_full_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kbd_nt_out:
        pop r10;
        ret
      }
    }

  // ==========================================================================
  // kbd_page_valid(page) -> u64
  // 1 iff page is Keyboard (0x07) or Consumer (0x0C).
  // ==========================================================================

  pub let kbd_page_valid : (u64) -> u64 !{} @{} =
    fn (page: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M4-002 (#1182): 1 iff page in {0x07, 0x0C}. Labels prefixed kbd_pv_.",
      block: {
        cmp rdi, 0x07;
        je  kbd_pv_yes;
        cmp rdi, 0x0C;
        je  kbd_pv_yes;
        xor rax, rax;
        ret;
      kbd_pv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // kbd_read_modifiers(buf, len) -> byte | error
  //
  // Reads buf[0]; refuses len < 1 or buf == 0. The modifier byte is a
  // bitfield the caller can AND with the KBD_MOD_* masks.
  // ==========================================================================

  pub let kbd_read_modifiers : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-002 (#1182): buf[0] extraction. Labels prefixed kbd_md_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  kbd_md_bad_buf;
        cmp r13, 1;
        jb  kbd_md_bad_len;

        xor rax, rax;
        mov_b rax, [r12];

        mov r10, rax;
        mov rdi, 0;                      // ST_MOD_READS
        call kbd_full_note;
        mov rax, r10;
        jmp kbd_md_out;

      kbd_md_bad_buf:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0F;
        jmp kbd_md_out;
      kbd_md_bad_len:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0E;

      kbd_md_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kbd_count_bits(buf, len) -> nset
  //
  // Popcount over buf[0..len). Sum-of-per-byte popcnt, so any u8 layout
  // works (bitmap N-key rollover produces one bit per pressed key).
  // Refuses buf == 0 or len == 0.
  // ==========================================================================

  pub let kbd_count_bits : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-002 (#1182): popcount over byte range. Labels prefixed kbd_cb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  kbd_cb_bad_buf;
        cmp r13, 1;
        jb  kbd_cb_bad_len;

        // Kernighan popcnt: for each byte, while (x) { x &= x-1; ++n }.
        // No popcnt mnemonic in paideia-as — mirrors uefi_phys_seed.pdx.
        xor rax, rax;                    // total
        xor rcx, rcx;                    // idx
      kbd_cb_loop:
        cmp rcx, r13;
        jae kbd_cb_done;
        xor rbx, rbx;
        mov_b rbx, [r12 + rcx * 1];
      kbd_cb_ker:
        cmp rbx, 0;
        je  kbd_cb_ker_done;
        mov r10, rbx;
        sub r10, 1;
        and rbx, r10;
        add rax, 1;
        jmp kbd_cb_ker;
      kbd_cb_ker_done:
        add rcx, 1;
        jmp kbd_cb_loop;
      kbd_cb_done:
        mov r10, rax;
        mov rdi, 1;                      // ST_KEY_COUNTS
        call kbd_full_note;
        mov rax, r10;
        jmp kbd_cb_out;

      kbd_cb_bad_buf:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0F;
        jmp kbd_cb_out;
      kbd_cb_bad_len:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0E;

      kbd_cb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kbd_bitmap_probe(buf, len, usage_id) -> 1 iff bit set, 0 iff clear,
  //                                        error iff usage-id out of range.
  //
  // Byte index = usage_id / 8, bit index = usage_id % 8.
  // Refuses usage_id < 1 or usage_id > len*8 - 1.
  // ==========================================================================

  pub let kbd_bitmap_probe : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (usage_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-002 (#1182): probe usage-id bit in an N-key-rollover bitmap. Sequence: buf != 0; len >= 1; usage_id in [1, len*8-1]; return the bit. Labels prefixed kbd_bp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  kbd_bp_bad_buf;
        cmp r13, 1;
        jb  kbd_bp_bad_len;

        cmp r14, 1;
        jb  kbd_bp_bad_usg;

        // byte_index = usage_id >> 3
        mov rcx, r14;
        shr rcx, 3;
        cmp rcx, r13;
        jae kbd_bp_bad_usg;

        xor rax, rax;
        mov_b rax, [r12 + rcx * 1];

        mov rcx, r14;
        and rcx, 7;
        shr rax, cl;
        and rax, 1;

        mov r10, rax;
        mov rdi, 2;                      // ST_KEY_PROBES
        call kbd_full_note;
        mov rax, r10;
        jmp kbd_bp_out;

      kbd_bp_bad_buf:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0F;
        jmp kbd_bp_out;
      kbd_bp_bad_len:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0E;
        jmp kbd_bp_out;
      kbd_bp_bad_usg:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0D;

      kbd_bp_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kbd_led_pack(buf, len, leds) -> OK | error
  //
  // Writes buf[0] with the LED output-report byte. Refuses leds &
  // ~KBD_LED_MASK != 0 — a bit outside the assigned five would be
  // silently transmitted otherwise, and no downstream stage could tell.
  // ==========================================================================

  pub let kbd_led_pack : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (leds: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M4-002 (#1182): write leds byte to buf[0]. Refuses bits outside KBD_LED_MASK. Labels prefixed kbd_lp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  kbd_lp_bad_buf;
        cmp r13, 1;
        jb  kbd_lp_bad_len;

        mov rax, r14;
        mov r10, 0x1F;
        not r10;
        and rax, r10;
        cmp rax, 0;
        jne kbd_lp_bad_leds;

        mov rax, r14;
        mov [r12], al;

        mov rdi, 3;                      // ST_LED_PACKS
        call kbd_full_note;

        xor rax, rax;
        jmp kbd_lp_out;

      kbd_lp_bad_buf:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0F;
        jmp kbd_lp_out;
      kbd_lp_bad_len:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0E;
        jmp kbd_lp_out;
      kbd_lp_bad_leds:
        mov rdi, 4;
        call kbd_full_note;
        mov rax, 0xFFFFFB0C;

      kbd_lp_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
