// src/kernel/core/drivers/usb/xhci/sof_timeline.pdx — R34.M5-002 (#1187)
//
// xHCI Start-of-Frame timeline: tracks the 11-bit USB Frame Number,
// resolves microframe indices for high-speed and above (8 microframes
// per 1 ms frame), and accounts per-SOF isoch bandwidth budget the
// scheduler (R34.M5-003 #1188) charges against.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// xHCI raises a Start-of-Frame event once per 1 ms bus frame. That
// event carries an 11-bit frame index (mod 2048) plus, for HS/SS
// devices, an implicit microframe index (0..7) within the frame. Isoch
// transfers reference the frame at which their next TRB is due through
// a Schedule Frame ID (SFI) field the driver sets before enqueue. If
// this module reports the wrong frame, the scheduler's SFI is stamped
// against a slot the controller has already passed and the packet is
// missed with no error path a caller sees.
//
// This module owns:
//   * A monotonic frame counter (u64) advanced by sof_advance()
//   * A microframe counter (u8, 0..7) advanced by sof_advance_uframe()
//   * A per-microframe bandwidth budget (u16, bytes; 0 means unused)
//   * A per-microframe charge accumulator (u16, bytes admitted)
//
// IT DOES NOT TOUCH XHCI MMIO. Reading the controller's SOF register
// belongs to a live xHCI driver over KIND_USB_ENDPOINT authority; this
// module is the STATE MACHINE that the driver updates on each SOF
// event, and the arbiter the scheduler consults before enqueue.
//
// IT IS NOT A LIVE DRIVER. sof_timeline_arbitrated() returns 0 until
// the R34.M5-003 scheduler wires this into isoch_ring enqueue.
//
// =============================================================================
// §1  BANDWIDTH BUDGETING (USB 2.0 §5.9)
// =============================================================================
//
// A high-speed microframe is 125 µs (1 ms / 8) with a wire budget of
// 60125 ns of bus time. In BYTES the practical reservation ceiling
// for isoch is 3 × 1024 = 3072 B per microframe (three ISOCH
// transactions of the maximum HS packet size), matching
// ISOCH_BANDWIDTH_MAX in kind_isoch_stream.pdx. Rather than encoding
// wire time, this module encodes the same byte-budget the cap kind
// records, so the two agree numerically and a mismatch cannot arise
// from unit conversion.
//
// admit(bytes): returns 1 if _budget_charge + bytes <= _budget_ceiling,
// bumps _budget_charge on success.
// yield_microframe(): resets _budget_charge, advances _uframe (mod 8),
// and, on wrap 7 -> 0, advances _frame_index (mod 2048).
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// tools/build.sh confines relocations against `_sof_state` and
// `_sof_stats` to this object.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFAB0..0xFFFFFABF
// =============================================================================
//
// Sixteen-wide band, verified disjoint at repo-grep time from every
// other kind/driver band.

module SofTimeline = structure {

  pub let SOF_FRAME_MAX      : u64 = 2048    // 11-bit wrap
  pub let SOF_UFRAME_MAX     : u64 = 8       // 0..7
  pub let SOF_BUDGET_MAX     : u64 = 3072    // bytes per microframe (HS ISOCH)

  pub let SOF_OK             : u64 = 0
  pub let SOF_BAD_ARG        : u64 = 0xFFFFFABF
  pub let SOF_OVERSUBSCRIBED : u64 = 0xFFFFFABE
  pub let SOF_BAD_BUDGET     : u64 = 0xFFFFFABD

  // State layout:
  //   [+0]  _frame_index (u16 in [0, 2048))
  //   [+8]  _uframe      (u8  in [0, 8))
  //   [+16] _budget_ceiling (u16, bytes)
  //   [+24] _budget_charge  (u16, bytes)
  pub let mut _sof_state : [u64; 4] = uninit @align(64)
  pub let mut _sof_stats : [u64; 8] = uninit @align(64)

  pub let SOF_ST_FRAMES     : u64 = 0
  pub let SOF_ST_UFRAMES    : u64 = 1
  pub let SOF_ST_ADMITS     : u64 = 2
  pub let SOF_ST_REJECTS    : u64 = 3
  pub let SOF_ST_WRAPS      : u64 = 4

  // ==========================================================================
  // sof_timeline_reset() — state + counters.
  // ==========================================================================

  pub let sof_timeline_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): clear _sof_state (frame/uframe/budget) and _sof_stats. Boot and teardown only. Sets budget_ceiling to SOF_BUDGET_MAX by default so admit() answers a real limit until a live driver overrides it. Labels prefixed sof_rs_.",
      block: {
        lea r10, [rip + _sof_state];
        xor rax, rax;
        mov [r10 + 0],  rax;             // frame_index
        mov [r10 + 8],  rax;             // uframe
        mov rax, 3072;
        mov [r10 + 16], rax;             // budget_ceiling = SOF_BUDGET_MAX
        xor rax, rax;
        mov [r10 + 24], rax;             // budget_charge

        lea r10, [rip + _sof_stats];
        xor rax, rax;
        xor rcx, rcx;
      sof_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sof_rs_stats;
        ret
      }
    } @no_frame

  pub let sof_timeline_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-002 (#1187): honesty pin. Returns 0 until R34.M5-003 wires this into isoch_ring's admit path. Boot witness asserts on this value.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sof_timeline_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): counter read. Labels prefixed sof_st_.",
      block: {
        cmp rdi, 8;
        jae sof_st_zero;
        lea r10, [rip + _sof_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sof_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sof_timeline_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): counter bump. Labels prefixed sof_nt_.",
      block: {
        cmp rdi, 8;
        jae sof_nt_out;
        lea r10, [rip + _sof_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sof_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Accessors.
  // ==========================================================================

  pub let sof_frame_index : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): current 11-bit frame index. Labels prefixed sof_fi_.",
      block: {
        lea r10, [rip + _sof_state];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let sof_uframe_index : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): current microframe index [0, 7]. Labels prefixed sof_ui_.",
      block: {
        lea r10, [rip + _sof_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let sof_budget_ceiling : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): microframe bandwidth ceiling in bytes.",
      block: {
        lea r10, [rip + _sof_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let sof_budget_charge : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): current microframe charge in bytes.",
      block: {
        lea r10, [rip + _sof_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  // ==========================================================================
  // sof_set_budget_ceiling(bytes) -> OK | BAD_BUDGET
  // ==========================================================================

  pub let sof_set_budget_ceiling : (u64) -> u64 !{mem} @{} =
    fn (bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): reset the microframe byte-ceiling. bytes > SOF_BUDGET_MAX is REFUSED with BAD_BUDGET rather than clamped: silent clamping would make a caller believe they had reserved bandwidth the arbiter later refuses. Labels prefixed sof_sb_.",
      block: {
        cmp rdi, 3072;
        ja  sof_sb_bad;
        lea r10, [rip + _sof_state];
        mov [r10 + 16], rdi;
        xor rax, rax;
        ret;
      sof_sb_bad:
        mov rax, 0xFFFFFABD;
        ret
      }
    } @no_frame

  // ==========================================================================
  // sof_admit(bytes) -> 1 (admitted) | 0 (oversubscribed)
  //
  // Bumps _budget_charge and returns 1 iff the sum stays within the
  // microframe ceiling. Never bumps beyond ceiling — the arithmetic
  // is checked BEFORE the store so a race with yield_microframe cannot
  // leave the counter above the ceiling.
  // ==========================================================================

  pub let sof_admit : (u64) -> u64 !{mem} @{} =
    fn (bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): the scheduler's per-microframe admit gate. Returns 1 iff charge+bytes <= ceiling. Zero-byte admits are legal (they still test whether the current microframe has capacity). Labels prefixed sof_ad_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;                    // bytes

        lea r10, [rip + _sof_state];
        mov rax, [r10 + 24];             // charge
        mov r13, rax;
        add rax, r12;
        mov rcx, [r10 + 16];             // ceiling
        cmp rax, rcx;
        ja  sof_ad_over;

        mov [r10 + 24], rax;             // charge += bytes
        mov rdi, 2;                      // SOF_ST_ADMITS
        call sof_timeline_note;
        mov rax, 1;
        jmp sof_ad_out;

      sof_ad_over:
        mov rdi, 3;                      // SOF_ST_REJECTS
        call sof_timeline_note;
        xor rax, rax;

      sof_ad_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sof_yield_microframe()
  //
  // Called by the xHCI driver on each SOF event (real HW) or once per
  // simulated microframe in the witness. Resets the byte charge for
  // the microframe just closed and advances _uframe (mod 8); on wrap
  // 7 -> 0 advances _frame_index (mod 2048) and bumps the frame stat.
  // ==========================================================================

  pub let sof_yield_microframe : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): close the current microframe. Reset charge; step uframe; on wrap step frame. Labels prefixed sof_ym_.",
      block: {
        push r12;

        lea r10, [rip + _sof_state];
        xor rax, rax;
        mov [r10 + 24], rax;             // charge = 0

        mov rdi, 1;                      // SOF_ST_UFRAMES
        call sof_timeline_note;

        lea r10, [rip + _sof_state];
        mov rax, [r10 + 8];              // uframe
        add rax, 1;
        cmp rax, 8;
        jb  sof_ym_no_wrap;

        xor rax, rax;
        mov [r10 + 8], rax;              // uframe = 0

        mov rcx, [r10 + 0];              // frame
        add rcx, 1;
        mov r11, 2048;
        cmp rcx, r11;
        jb  sof_ym_no_frame_wrap;
        xor rcx, rcx;                    // frame wrap 2047 -> 0
        mov rdi, 4;                      // SOF_ST_WRAPS
        call sof_timeline_note;
        lea r10, [rip + _sof_state];

      sof_ym_no_frame_wrap:
        mov [r10 + 0], rcx;
        mov rdi, 0;                      // SOF_ST_FRAMES
        call sof_timeline_note;
        jmp sof_ym_out;

      sof_ym_no_wrap:
        mov [r10 + 8], rax;

      sof_ym_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sof_frames_after(delta) -> frame index `delta` microframes from now,
  // wrapped mod 2048. Used by the isoch scheduler to stamp SFI (see
  // isoch_ring.pdx §2). Refuses delta > 2048 * 8 as SOF_BAD_ARG.
  // ==========================================================================

  pub let sof_frames_after : (u64) -> u64 !{mem} @{} =
    fn (delta_uframes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-002 (#1187): compute (now + delta_uframes) / 8 mod 2048. Refuses delta > 2048*8. Labels prefixed sof_fa_.",
      block: {
        mov r10, 16384;                  // 2048 * 8
        cmp rdi, r10;
        ja  sof_fa_bad;

        push r12;
        push r13;
        mov r12, rdi;

        lea r10, [rip + _sof_state];
        mov rax, [r10 + 0];              // frame
        mov rcx, [r10 + 8];              // uframe
        mov r11, 8;
        // total_uframes = frame*8 + uframe
        mov r13, rax;
        shl r13, 3;
        add r13, rcx;

        add r13, r12;                    // total_uframes + delta

        // divide by 8 -> shr 3
        mov rax, r13;
        shr rax, 3;
        mov r11, 2048;
        // rax = rax mod 2048 = rax & (2048-1)
        mov r10, 2047;
        and rax, r10;

        pop r13;
        pop r12;
        ret;

      sof_fa_bad:
        mov rax, 0xFFFFFABF;
        ret
      }
    }
}
