// src/kernel/core/drivers/nvme/probe.pdx — R24-M1-001 (#886)
//
// NVMe controller device probe.
//
// After pci_enumerate_all (src/kernel/core/pci/enum.pdx) populates
// _pci_devices with one 32-byte record per enumerated function, the
// NVMe probe filters that list for the PCI class code triple that
// identifies an NVM Express controller:
//
//   class_code = 0x01 (mass storage)
//   subclass   = 0x08 (non-volatile memory)
//   prog_if    = 0x02 (NVMe interface)
//
// The class/subclass pair lives in the enum-published _pci_devices
// record at offsets +6/+7; prog_if is NOT stored in the compact record
// so we read it back via pci_config_read_u8 for each candidate slot.
//
// For every match the probe records a compact 32-byte descriptor into
// _nvme_devices and emits one "NVME PROBE N=<count>" fingerprint.  In
// the -kernel/BIOS boot path where MCFG is absent, _pci_device_count
// is 0 → the probe drains the empty loop and emits "N=0".
//
// -----------------------------------------------------------------------------
// _nvme_devices record layout (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  _pad0
//   +6    u16 cap_msix_off      // 0 if MSI-X capability absent
//   +8    u64 bar0_pa           // controller register-set physical base
//   +16   u16 cap_msi_off       // 0 if MSI capability absent
//   +18   u16 _pad1
//   +20   u32 _pad2
//   +24   u64 _reserved
//   +32   end
//
// -----------------------------------------------------------------------------
// BAR0 decode
// -----------------------------------------------------------------------------
//
// Per NVMe Base Spec 2.0 §2.1.10, an NVMe controller's register set
// lives at PCI BAR0 as a 64-bit memory BAR (type bits [2:1] = 10).
// We defensively also accept 32-bit memory BARs (bits [2:1] = 00) so
// the probe survives on qemu-nvme prototypes that occasionally
// misreport.  I/O BARs (bit 0 = 1) are rejected — an NVMe controller
// must expose its register set via MMIO.
//
//   bar0_pa (MEM64) = (BAR[hi=+0x14] << 32) | (BAR[lo=+0x10] & ~0xF)
//   bar0_pa (MEM32) = BAR[lo=+0x10] & ~0xF
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` narrow store widens → use `mov_d` / `mov_w`
//       / `mov_b` for sized stores into the record.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `nvme_pr_` to avoid
// reserved names (`loop`, `if`, ...).

module Probe = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let NVME_CLASS_CODE     : u64 = 0x01   // mass storage
  pub let NVME_SUBCLASS       : u64 = 0x08   // non-volatile memory
  pub let NVME_PROG_IF        : u64 = 0x02   // NVM Express interface

  pub let NVME_MAX_DEVS       : u64 = 8
  pub let NVME_DEV_REC_SIZE   : u64 = 32

  // ============================================================================
  // Canonical static slots — .bss, @align(8)
  // ============================================================================
  //
  //   _nvme_devices          : 8 × 32 B = 256 B = 32 × u64
  //   _nvme_device_count     : populated by nvme_probe

  pub let mut _nvme_devices        : [u64; 32] = uninit @align(8)
  pub let mut _nvme_device_count   : u64       = 0

  // ============================================================================
  // nvme_probe() -> u64
  // ============================================================================
  //
  // SysV: () -> u64
  //   Returns rax = number of NVMe controllers discovered (0..8).
  //
  // Register plan (6-push callee-save + 32 B scratch):
  //   rbx = i (loop index into _pci_devices)
  //   r12 = _pci_device_count (loaded once)
  //   r13 = j (nvme write index into _nvme_devices)
  //   r14 = &_pci_devices[i] (recomputed each iter)
  //   r15 = &_nvme_devices[j] (recomputed on match)
  //   rbp = scratch (seg for callee-preservation across pci_config_read_u8)
  //
  //   Scratch slots (per candidate device):
  //     [rsp+0]  = seg  (u64, zero-extended)
  //     [rsp+8]  = bus  (u64)
  //     [rsp+16] = dev  (u64)
  //     [rsp+24] = fn   (u64)

  pub let nvme_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M1-001 (#886). NVMe controller device probe. Body: (1) 6-push callee-save prologue (rbx, rbp, r12-r15) — 48 B → rsp%16==8 (entry) + 48 = %16==8; sub rsp,32 (scratch) → 80 → %16==8; sub rsp,8 (pre-call pad) applied per-callsite as needed. Actually simpler: 6 pushes = 48 B; entry rsp%16==8 → 48+8=56, %16==8. To align for the nested calls we `sub rsp, 40` (32 scratch + 8 pad): 48+40=88, +8 entry = 96, %16==0. Scratch layout [rsp+0..31]. (2) Init j=r13=0; load _pci_device_count into r12; init i=rbx=0. (3) Per-iteration bounds check: cmp rbx, r12; jae done. (4) Compute r14 = &_pci_devices[i] = _pci_devices + (i << 5) — record stride 32 = shl 5 (matches core/pci/publish.pdx L83-86). (5) Load class_code (u8 @ r14+6) and subclass (u8 @ r14+7); if class != 0x01 or subclass != 0x08 → skip. Zero-extend via `xor rax,rax; mov_b rax, [r14+N]` pattern (proven in publish.pdx L94-101). (6) Class/subclass matched: read seg (u16 @ r14+0), bus (u8 @ +2), dev (u8 @ +3), fn (u8 @ +4) and stash into scratch slots [rsp+0..24]. (7) Call pci_config_read_u8(seg, bus, dev, fn, 0x09) → rax = prog_if. If prog_if != 0x02, skip (NVM subclass matched but not NVMe interface — could be AHCI-mapped-as-NVM or vendor-specific). (8) Overflow guard: if r13 >= NVME_MAX_DEVS, skip (silent drop — 8 NVMe controllers exceeds every consumer/workstation to date). (9) Read BAR0 lo via pci_config_read_u32(seg, bus, dev, fn, 0x10). Determine 64-bit vs 32-bit via bits [2:1]: if bits == 0x2 → read BAR0 hi via pci_config_read_u32(..., 0x14); compose bar0_pa = (hi << 32) | (lo & ~0xF). Else if bit 0 == 0 → 32-bit MEM BAR: bar0_pa = lo & ~0xF. Else (I/O BAR) → skip. (10) Call pci_find_cap(seg, bus, dev, fn, 0x11 MSI-X) → cap_msix_off (rax). Call pci_find_cap(..., 0x05 MSI) → cap_msi_off. (11) Compute r15 = &_nvme_devices[j] = base + (j << 5). Populate the 32-byte record: u16 seg @+0, u8 bus/dev/fn @+2/+3/+4, u8 pad=0 @+5, u16 cap_msix_off @+6, u64 bar0_pa @+8, u16 cap_msi_off @+16, zero the tail (18..32). (12) Increment r13 (j). Fall through to advance i. (13) Advance i, loop. (14) On loop exit: publish _nvme_device_count = r13; emit klog_s1_d1(INFO, NVME, tag_nvme_probe, k_n, count) fingerprint; return count. Callee-save discipline: pci_config_read_u8/u16/u32 and pci_find_cap all preserve rbx/rbp/r12..r15 per SysV. Scratch slots survive across every nested call. Reserved-label posture: all labels prefixed `nvme_pr_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;                             // 32 scratch + 8 align

        // Init counters.
        xor r13, r13;                            // j = 0 (nvme count)
        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;                            // i = 0

      nvme_pr_loop:
        cmp rbx, r12;
        jae nvme_pr_done;

        // r14 = &_pci_devices[i]
        mov rax, rbx;
        shl rax, 5;
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // class_code (u8 @+6)
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x01;                           // NVME_CLASS_CODE
        jne nvme_pr_next;

        // subclass (u8 @+7)
        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x08;                           // NVME_SUBCLASS
        jne nvme_pr_next;

        // Class + subclass match. Load BDF into scratch slots.
        // seg (u16 @+0)
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;

        // bus (u8 @+2)
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;

        // dev (u8 @+3)
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;

        // fn (u8 @+4)
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;

        // pci_config_read_u8(seg, bus, dev, fn, 0x09) → prog_if
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x09;
        call pci_config_read_u8;
        cmp rax, 0x02;                           // NVME_PROG_IF
        jne nvme_pr_next;

        // Overflow guard.
        cmp r13, 8;                              // NVME_MAX_DEVS
        jae nvme_pr_next;

        // Read BAR0 lo (u32 @ config +0x10).
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x10;
        call pci_config_read_u32;

        // rax = bar_lo. Check bit 0 (0 = MEM, 1 = IO).
        mov r10, rax;                            // r10 = bar_lo (preserve across next call)
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne nvme_pr_next;                        // I/O BAR — not NVMe-conformant

        // Check bits [2:1]: 00 = 32-bit, 10 = 64-bit.
        mov r11, r10;
        shr r11, 1;
        and r11, 3;
        cmp r11, 2;
        je nvme_pr_bar64;

        // MEM32: bar0_pa = bar_lo & ~0xF
        mov r15, r10;
        and r15, 0xFFFFFFFFFFFFFFF0;
        jmp nvme_pr_bar_done;

      nvme_pr_bar64:
        // Save bar_lo across the hi-word read.
        mov [rsp + 32], r10;

        // Read BAR0 hi (u32 @ config +0x14).
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x14;
        call pci_config_read_u32;

        // rax = bar_hi. bar0_pa = (bar_hi << 32) | (bar_lo & ~0xF)
        shl rax, 32;
        mov r10, [rsp + 32];
        and r10, 0xFFFFFFFFFFFFFFF0;
        or rax, r10;
        mov r15, rax;                            // r15 = bar0_pa

      nvme_pr_bar_done:
        // Save bar0_pa across the pci_find_cap calls.
        mov [rsp + 32], r15;

        // pci_find_cap(seg, bus, dev, fn, MSI-X=0x11) → cap_msix_off
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x11;
        call pci_find_cap;
        mov rbp, rax;                            // rbp = cap_msix_off

        // pci_find_cap(seg, bus, dev, fn, MSI=0x05) → cap_msi_off
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x05;
        call pci_find_cap;

        // Now populate _nvme_devices[j]. r15 = &_nvme_devices[j]
        mov r11, r13;
        shl r11, 5;
        lea r15, [rip + _nvme_devices];
        add r15, r11;

        // rax = cap_msi_off; rbp = cap_msix_off; [rsp+32] = bar0_pa;
        // scratch [rsp+0..24] = seg/bus/dev/fn.

        // u16 seg @+0
        mov r10, [rsp + 0];
        mov_w [r15 + 0], r10;

        // u8 bus @+2
        mov r10, [rsp + 8];
        mov_b [r15 + 2], r10;

        // u8 dev @+3
        mov r10, [rsp + 16];
        mov_b [r15 + 3], r10;

        // u8 fn @+4
        mov r10, [rsp + 24];
        mov_b [r15 + 4], r10;

        // u8 pad0 = 0 @+5
        xor r10, r10;
        mov_b [r15 + 5], r10;

        // u16 cap_msix_off @+6
        mov_w [r15 + 6], rbp;

        // u64 bar0_pa @+8
        mov r10, [rsp + 32];
        mov [r15 + 8], r10;

        // u16 cap_msi_off @+16
        mov_w [r15 + 16], rax;

        // u16 pad1 = 0 @+18, u32 pad2 = 0 @+20, u64 reserved = 0 @+24.
        xor r10, r10;
        mov_w [r15 + 18], r10;
        mov_d [r15 + 20], r10;
        mov [r15 + 24], r10;

        // j += 1
        add r13, 1;

      nvme_pr_next:
        add rbx, 1;
        jmp nvme_pr_loop;

      nvme_pr_done:
        // Publish device count.
        mov [rip + _nvme_device_count], r13;

        // Emit "NVME PROBE N=<count>".
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NVME];
        lea rdx, [rip + tag_nvme_probe];
        lea rcx, [rip + k_n];
        mov r8, r13;                             // v1 = count
        call klog_s1_d1;

        mov rax, r13;                            // return count

        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
