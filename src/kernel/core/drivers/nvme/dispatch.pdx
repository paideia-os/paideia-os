// src/kernel/core/drivers/nvme/dispatch.pdx — R24-M3-004 (#897)
//
// Per-CPU IO SQ/CQ selection at request-submission time.
//
// -----------------------------------------------------------------------------
// Contract
// -----------------------------------------------------------------------------
//
// The single-writer per-CPU queue partitioning established by
// nvme_create_all_io_cqs / nvme_create_all_io_sqs (io_queue.pdx) means
// this file's dispatch primitives have zero cross-CPU synchronisation:
// each CPU owns its (SQ, CQ) pair exclusively, and no lock is needed on
// the SQ tail cursor because only the current CPU writes it.
//
// -----------------------------------------------------------------------------
// R24.M3 posture: no completion polling
// -----------------------------------------------------------------------------
//
// nvme_submit_io_cmd enqueues the SQE and rings the SQ doorbell but does
// NOT wait for completion. IRQ-driven completion consumption lands at
// R24.M5. Callers that want a synchronous IO at M3 must poll the CQ
// themselves (using the descriptor's cq_head/cq_phase fields) or block
// on the request-slot future once M5 wires it up.
//
// -----------------------------------------------------------------------------
// gs:0 = &_percpu_cbs[cpu_idx] contract
// -----------------------------------------------------------------------------
//
// IA32_GS_BASE is programmed by gs_base_init_bsp / gs_base_init_ap to
// point at this CPU's per-CPU control block. The u32 at [gs:0]
// (PERCPU_OFF_CPU_IDX) holds the dense logical cpu_idx used to index
// _nvme_io_queues. Because paideia-as v0.22.x's [gs:disp32] no-base
// encoding is not yet supported (see gs_base.pdx L221-228), we sidestep
// by rdmsr'ing IA32_GS_BASE and dereferencing.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: SQE copy via rep_movsb (already width-safe).
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `nvme_di_` / `nvme_su_`.

module Dispatch = structure {

  // ============================================================================
  // nvme_dispatch_for_this_cpu() -> u64
  // ============================================================================
  //
  // SysV: () -> u64
  //
  // Returns rax = physical (== virtual under identity-map) address of
  // the io_queue_desc entry that belongs to the current CPU:
  //   rax = &_nvme_io_queues + cpu_idx * NVME_IO_DESC_SIZE
  //
  // Reads cpu_idx via rdmsr IA32_GS_BASE + u32 load at [CB + 0].
  //
  // Leaf function — no callee-save clobber, no frame.

  pub let nvme_dispatch_for_this_cpu : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R24-M3-004 (#897). Return &_nvme_io_queues[cpu_idx] for the CPU on which this call executes. Body: (1) rdmsr IA32_GS_BASE (0xC0000101) — EDX:EAX halves per SDM Vol 2C §5.2.9. (2) Reconstruct 64-bit CB VA: shl rdx, 32; or rax, rdx. Same idiom used across ipi/vectors.pdx L82, sched/pick_next.pdx L119, gs_base.pdx L237-243. (3) Load cpu_idx (u32 @+0 = PERCPU_OFF_CPU_IDX) via `mov ecx, [rax]` — 32-bit load zero-extends into rcx per SDM Vol 2A §3.4.1.1. (4) desc = &_nvme_io_queues + cpu_idx * NVME_IO_DESC_SIZE. NVME_IO_DESC_SIZE = 32 = 2^5, so `shl rcx, 5`. (5) rax = lea _nvme_io_queues; add rax, rcx. Leaf; no callee-save clobber. Encoder: rdmsr / shl / or / mov / lea / add / ret — all pre-existing.",
      block: {
        mov rcx, 0xC0000101;                     // IA32_GS_BASE
        rdmsr;
        shl rdx, 32;
        or  rax, rdx;                            // rax = CB VA

        // Load cpu_idx (u32 @+0). mov ecx, [rax] zero-extends.
        mov ecx, [rax];

        // desc_off = cpu_idx * 32.
        shl rcx, 5;

        lea rax, [rip + _nvme_io_queues];
        add rax, rcx;
        ret
      }
    }

  // ============================================================================
  // nvme_submit_io_cmd(sqe: *u8) -> u64
  // ============================================================================
  //
  // SysV: (sqe: u64) -> u64
  //   rdi = pointer to a caller-owned 64-byte SQE image.
  //
  // Returns rax = the SQ tail slot the SQE was written into (low 16
  // bits meaningful) — usable as a boot-line CID sentinel. Real CID
  // allocation lands at R24.M5.
  //
  // Body:
  //   (1) desc = nvme_dispatch_for_this_cpu().
  //   (2) sq_pa = desc[+8]; sq_tail = desc[+18]; qid = desc[+16].
  //   (3) dst = sq_pa + (sq_tail << 6).
  //   (4) rep_movsb 64 bytes from sqe → dst.
  //   (5) new_tail = (sq_tail + 1) & 63; store back @+18.
  //   (6) nvme_ring_sq(_nvme_current_bar0, qid, new_tail).
  //   (7) Return sq_tail (the slot we wrote into).
  //
  // Register plan (4-push callee-save):
  //   rbx = desc,  rbp = old sq_tail (return value),
  //   r12 = qid,   r13 = new sq_tail
  //   4 pushes = 32 B; entry rsp%16==8 → 40, sub rsp,8 → 48, %16==0
  //   (aligned for nested calls).

  pub let nvme_submit_io_cmd : (u64) -> u64 !{sysreg, mem} @{} =
    fn (sqe: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R24-M3-004 (#897). Enqueue one 64-byte SQE into the current CPU's IO SQ and ring the SQ doorbell. Body: (1) 4-push callee-save prologue (rbx, rbp, r12, r13) — 32 B; entry rsp%16==8 → 40, sub rsp,8 → 48, %16==0 (aligned for nvme_dispatch_for_this_cpu + nvme_ring_sq). Save rdi (sqe) in rbp temporarily, then move to r14 after prologue since rdi is caller-save and clobbered by the dispatch call. Actually simpler: push rdi's target sqe onto the stack scratch [rsp+0] since we only use it once for the memcpy. (2) rdi = sqe was passed in — stash at [rsp+0] before nvme_dispatch_for_this_cpu clobbers rdi. (3) Call nvme_dispatch_for_this_cpu() → rax = desc. Save in rbx. (4) sq_tail (u16 @+18) — zero-extend load into rbp (return value). qid (u16 @+16) — zero-extend load into r12. sq_pa (u64 @+8) — plain 64-bit load into rax. (5) dst = sq_pa + (sq_tail << 6): mov rcx, rbp; shl rcx, 6; add rax, rcx → rax = &sq[sq_tail]. (6) memcpy 64 B via rep_movsb: rdi = dst (from rax), rsi = sqe (from [rsp+0]), rcx = 64, cld. (7) new_tail = (rbp + 1) & 63; store back @+18 via mov_w [rbx+18], r13. (8) Ring SQ: nvme_ring_sq(_nvme_current_bar0, qid=r12, new_tail=r13). (9) rax = rbp (old sq_tail = slot the SQE occupies). Reserved labels: `nvme_su_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;                              // 16B align + sqe stash slot

        // Stash sqe pointer (rdi) in [rsp+0] before the dispatch call
        // clobbers rdi.
        mov [rsp + 0], rdi;

        // ================================================================
        // (3) desc = nvme_dispatch_for_this_cpu().
        // ================================================================
        call nvme_dispatch_for_this_cpu;
        mov rbx, rax;                            // rbx = desc

        // ================================================================
        // (4) Load sq_tail (u16 @+18), qid (u16 @+16), sq_pa (u64 @+8).
        // ================================================================
        xor rbp, rbp;
        mov_w rbp, [rbx + 18];                   // rbp = sq_tail

        xor r12, r12;
        mov_w r12, [rbx + 16];                   // r12 = qid

        mov rax, [rbx + 8];                      // rax = sq_pa

        // ================================================================
        // (5) dst = sq_pa + (sq_tail << 6).
        // ================================================================
        mov rcx, rbp;
        shl rcx, 6;                              // * 64 (SQE size)
        add rax, rcx;                            // rax = &sq[sq_tail]

        // ================================================================
        // (6) rep_movsb 64 B: rsi = sqe, rdi = dst, rcx = 64.
        // ================================================================
        mov rdi, rax;                            // dst
        mov rsi, [rsp + 0];                      // sqe (from stash)
        mov rcx, 64;
        cld;
        rep_movsb;

        // ================================================================
        // (7) new_tail = (sq_tail + 1) & 63; store back.
        // ================================================================
        mov r13, rbp;
        add r13, 1;
        and r13, 63;
        mov_w [rbx + 18], r13;

        // ================================================================
        // (8) nvme_ring_sq(_nvme_current_bar0, qid, new_tail).
        // ================================================================
        mov rdi, [rip + _nvme_current_bar0];
        mov rsi, r12;
        mov rdx, r13;
        call nvme_ring_sq;

        // ================================================================
        // (9) Return old sq_tail as CID sentinel.
        // ================================================================
        mov rax, rbp;

        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
