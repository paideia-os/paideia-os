// src/kernel/core/drivers/nvme/identify_ctrl.pdx -- R51.M1-004 (#1636)
//
// NVMe Admin IDENTIFY Controller (CNS=0x01) submit + parse.
//
// The R24 identify.pdx module lands the SQE builder
// (nvme_build_id_ctrl_cmd) and the 4 KiB response buffer
// (_nvme_id_ctrl_buf).  This module wires them end to end:
//
//   (a) nvme_identify_ctrl_submit_and_parse(bar0):
//       1. build SQE into _nvme_admin_sqe_scratch pointing PRP1 at
//          _nvme_id_ctrl_buf;
//       2. call nvme_admin_submit_poll(bar0, &_nvme_admin_ctx,
//          &_nvme_admin_sqe_scratch);
//       3. on non-zero completion status, return NVME_IDCTRL_FAILED;
//       4. otherwise parse MDTS (u8 @+77), ONCS (u16 @+520), NN
//          (u32 @+516) from _nvme_id_ctrl_buf;
//       5. return the packed triple {mdts:8 | oncs:16 | nn:32} in
//          the low 56 bits of rax.
//
// The offsets and field widths are from NVMe Base Spec 2.0
// §5.17.2.1 (Identify Controller data structure).  The M1 posture
// is dormant at BIOS/-kernel boot because no controller exists;
// the admin_submit_poll path is exercised only under UEFI/OVMF with
// a live BAR0.
//
// -----------------------------------------------------------------------------
// Packed return layout
// -----------------------------------------------------------------------------
//
// Callers (kind_nvme_controller.pdx `nvme_ctrl_identify`) unpack:
//   mdts = rax & 0xFF
//   oncs = (rax >> 8) & 0xFFFF
//   nn   = (rax >> 24) & 0xFFFFFFFF
//
// The packing avoids a struct-return convention and lets one 64-bit
// value carry all three cached fields.  Total: 8 + 16 + 32 = 56 bits,
// leaves bits [63:56] zero.  The failure sentinel 0xFFFFFFFFFFFFFFFF
// is disjoint from every legal encoding (a real IDENTIFY response
// would leave bits [63:56] zero).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sized byte / word / dword loads via mov_b / mov_w / mov_d.
//   G4: full-register compares.
//
// r11 scratch only.  Reserved-label discipline: labels prefixed
// `nvme_idc_`.

module IdentifyCtrl = structure {

  // Sentinel: nvme_admin_submit_poll returned non-zero (error status)
  // or the R24 build path is dormant.  Disjoint from the packed
  // {mdts, oncs, nn} triple which always leaves bits [63:56] clear.
  pub let NVME_IDCTRL_FAILED  : u64 = 0xFFFFFFFFFFFFFFFF

  // Identify Controller field offsets (mirror identify.pdx +
  // authoritative for the M1-004 wire).
  pub let NVME_IDCTRL_OFF_MDTS : u64 = 77    // u8
  pub let NVME_IDCTRL_OFF_NN   : u64 = 516   // u32
  pub let NVME_IDCTRL_OFF_ONCS : u64 = 520   // u16

  // ==========================================================================
  // nvme_identify_ctrl_submit_and_parse(bar0) -> u64
  // ==========================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base of the controller whose admin queue is up.
  //
  // Returns rax = packed {mdts:8 | oncs:16 | nn:32} in low 56 bits,
  //   or NVME_IDCTRL_FAILED (all ones) on submit failure.
  //
  // Register plan (3-push callee-save):
  //   rbx = bar0, r12 = admin_ctx ptr, r13 = packed result scratch
  //   3 pushes = 24 B; entry rsp%16==8 -> 32, %16==0.

  pub let nvme_identify_ctrl_submit_and_parse : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {boot},
      justification: "R51.M1-004 (#1636). Build IDENTIFY(CNS=0x01) SQE via nvme_build_id_ctrl_cmd(prp1_pa = &_nvme_id_ctrl_buf, sqe_pa = &_nvme_admin_sqe_scratch); submit via nvme_admin_submit_poll(bar0, &_nvme_admin_ctx, &_nvme_admin_sqe_scratch); on (status & 0xFFFE) != 0 return NVME_IDCTRL_FAILED sentinel; otherwise parse MDTS (u8 @+77), NN (u32 @+516), ONCS (u16 @+520) from _nvme_id_ctrl_buf and pack {mdts:8 | oncs:16 | nn:32} into rax. Three callee-save pushes (rbx, r12, r13) leave rsp%16 == 0 at every nested call. G1 sized loads via mov_b/mov_w/mov_d for the three sub-8-byte fields. Reserved labels: nvme_idc_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                            // bar0

        // (1) Build SQE.  nvme_build_id_ctrl_cmd(prp1_pa, sqe_pa).
        lea rdi, [rip + _nvme_id_ctrl_buf];      // prp1_pa
        lea rsi, [rip + _nvme_admin_sqe_scratch]; // sqe_pa
        call nvme_build_id_ctrl_cmd;

        // (2) Submit + poll.
        mov rdi, rbx;                            // bar0
        lea rsi, [rip + _nvme_admin_ctx];        // ctx
        lea rdx, [rip + _nvme_admin_sqe_scratch]; // sqe_bytes
        call nvme_admin_submit_poll;

        // (3) Success: (status & 0xFFFE) == 0.
        mov r10, rax;
        and r10, 0xFFFE;
        cmp r10, 0;
        jne nvme_idc_fail;

        // (4) Parse.  Load MDTS (u8 @+77) into r12 low byte.
        xor r12, r12;
        lea r13, [rip + _nvme_id_ctrl_buf];
        xor rax, rax;
        mov_b rax, [r13 + 77];                   // MDTS
        and rax, 0xFF;
        or  r12, rax;                            // bits [7:0]

        xor rax, rax;
        mov_w rax, [r13 + 520];                  // ONCS
        and rax, 0xFFFF;
        shl rax, 8;
        or  r12, rax;                            // bits [23:8]

        xor rax, rax;
        mov_d rax, [r13 + 516];                  // NN
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        shl rax, 24;
        or  r12, rax;                            // bits [55:24]

        mov rax, r12;
        jmp nvme_idc_out;

      nvme_idc_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;             // NVME_IDCTRL_FAILED

      nvme_idc_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
