// src/kernel/core/drivers/nvme/errors.pdx — R24-M5-005 / #907
//
// NVMe controller error paths — CSTS.CFS detection, timeout wait,
// Admin Abort command.
//
// -----------------------------------------------------------------------------
// CSTS bits (NVMe Base Spec 2.0 §3.1.6)
// -----------------------------------------------------------------------------
//
//   bit 0  RDY   — controller ready
//   bit 1  CFS   — controller fatal status (unrecoverable; requires reset)
//   bits 2..3  SHST — shutdown status
//   bit 4  NSSRO — NVM Subsystem Reset Occurred (persistent across reset)
//   bit 5  PP    — processing paused
//
// -----------------------------------------------------------------------------
// Admin Abort command (§5.1, OPC=0x08)
// -----------------------------------------------------------------------------
//
//   OPC   = 0x08
//   NSID  = 0
//   CDW10 = (sqid << 16) | cid
//   CDW11 = 0
//
// Response DW0 bit 0 == 0 → abort successful, 1 → abort failed (typical
// reason: the command has already completed or is uncoalescable).
//
// -----------------------------------------------------------------------------
// Fault fingerprint
// -----------------------------------------------------------------------------
//
// On CFS detection this module emits:
//
//   NVME FAULT csts=0x<hex>
//
// via klog_s1_x1(INFO, NVME, tag_nvme_fault, k_csts, csts_raw). The
// consumer is the smoke-boot log grep in tools/run-smoke.sh (dormant
// at M5 — the fingerprint is emitted only when nvme_csts_check runs
// against a real controller and the CFS bit is set).
//
// -----------------------------------------------------------------------------
// R24.M5 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// Under -kernel/BIOS boot the PCI enumerator returns 0 devices so
// no NVMe controller is attached and these functions are dormant
// symbols. Real activation happens on UEFI/OVMF boot with a real
// nvme controller, gated by the driver-attach path landing at R25+.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sized stores via mov_b / mov_w / mov_d.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `nvme_er_`, `nvme_tw_`,
// `nvme_ab_`.

module Errors = structure {

  // ============================================================================
  // CSTS bit masks (mirror regs.pdx)
  // ============================================================================

  pub let NVME_ERR_CSTS_RDY     : u64 = 0x00000001
  pub let NVME_ERR_CSTS_CFS     : u64 = 0x00000002
  pub let NVME_ERR_CSTS_NSSRO   : u64 = 0x00000010

  // ============================================================================
  // Wait-type discriminators for nvme_timeout_wait
  // ============================================================================
  //
  //   NVME_WAIT_RDY_SET     — wait until CSTS.RDY == 1
  //   NVME_WAIT_RDY_CLEAR   — wait until CSTS.RDY == 0
  //
  // Both terminate early on CSTS.CFS.

  pub let NVME_WAIT_RDY_SET     : u64 = 0
  pub let NVME_WAIT_RDY_CLEAR   : u64 = 1

  // ============================================================================
  // Return codes
  // ============================================================================

  pub let NVME_ERR_OK             : u64 = 0
  pub let NVME_ERR_CFS_SET        : u64 = 1
  pub let NVME_ERR_NSSRO_SET      : u64 = 2
  pub let NVME_ERR_TIMEOUT        : u64 = 0xFFFF
  pub let NVME_ERR_ABORT_FAILED   : u64 = 0xFFFE

  // ============================================================================
  // Admin Abort opcode
  // ============================================================================

  pub let NVME_ADMIN_OPC_ABORT    : u64 = 0x08

  // ============================================================================
  // Spin-poll budget for nvme_timeout_wait (dimensionless iteration
  // ceiling, matches queue.pdx §NVME_SUBMIT_SPIN_MAX rationale).
  //
  // On a 3 GHz core each nvme_reg_u32 read is ~30 ns; 50,000,000 iters
  // is ~1.5 s of wall-time. max_us caller-provided ceiling is *advisory*
  // at M5 — the actual bound is this iteration cap. TSC/HPET-derived
  // wall-time bracketing lands with the driver-attach path (R25+).
  // ============================================================================

  pub let NVME_ERR_SPIN_MAX       : u64 = 50000000

  // ============================================================================
  // nvme_csts_check(bar0) -> u16
  // ============================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base
  //
  // Reads CSTS. Return semantics:
  //   NVME_ERR_OK        (0)  — RDY set, CFS/NSSRO clear
  //   NVME_ERR_CFS_SET   (1)  — CFS bit set (controller fatal)
  //   NVME_ERR_NSSRO_SET (2)  — NSSRO bit set (subsystem reset occurred)
  //
  // On CFS: emits "NVME FAULT csts=0x<hex>" fingerprint before returning.
  //
  // Register plan (2-push callee-save):
  //   rbx = bar0    (preserved across nvme_reg_u32 + klog_s1_x1)
  //   rbp = csts    (preserved across klog_s1_x1)
  //
  //   2 pushes = 16 B; entry rsp%16==8 → 24, sub rsp,8 → 32, %16==0
  //   (aligned for nested calls).

  pub let nvme_csts_check : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M5-005 (#907). Read NVMe CSTS and classify. Body: (1) 2-push callee-save prologue (rbx=bar0, rbp=csts) — 16 B; entry rsp%16==8 → 24, sub rsp,8 → 32, %16==0 (aligned for nested nvme_reg_u32 / klog_s1_x1 calls). (2) rdi=bar0, rsi=0x1C; call nvme_reg_u32 → rax = csts. Save rax in rbp. (3) Test CFS (bit 1): mov r10, rbp; and r10, 2; cmp r10, 0; je no_cfs. Emit fingerprint via klog_s1_x1(INFO=3, SUBSYS_NVME, tag_nvme_fault, k_csts, csts). Then return NVME_ERR_CFS_SET (1). (4) Test NSSRO (bit 4): mov r10, rbp; and r10, 0x10; cmp r10, 0; je no_nssro. Return NVME_ERR_NSSRO_SET (2). (5) Otherwise return NVME_ERR_OK (0). Reserved labels: `nvme_er_`.",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;                              // 16B align

        mov rbx, rdi;                            // rbx = bar0

        // ================================================================
        // (2) csts = nvme_reg_u32(bar0, 0x1C).
        // ================================================================
        mov rdi, rbx;
        mov rsi, 0x1C;                           // NVME_REG_CSTS
        call nvme_reg_u32;

        mov rbp, rax;                            // rbp = csts

        // ================================================================
        // (3) Test CFS.
        // ================================================================
        mov r10, rbp;
        and r10, 2;                              // NVME_CSTS_CFS
        cmp r10, 0;
        je nvme_er_no_cfs;

        // Emit "NVME FAULT csts=0x<hex>".
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NVME];
        lea rdx, [rip + tag_nvme_fault];
        lea rcx, [rip + k_csts];
        mov r8, rbp;                             // v1 = csts (raw)
        call klog_s1_x1;

        mov rax, 1;                              // NVME_ERR_CFS_SET
        jmp nvme_er_done;

      nvme_er_no_cfs:
        // ================================================================
        // (4) Test NSSRO.
        // ================================================================
        mov r10, rbp;
        and r10, 0x10;                           // NVME_CSTS_NSSRO
        cmp r10, 0;
        je nvme_er_ok;

        mov rax, 2;                              // NVME_ERR_NSSRO_SET
        jmp nvme_er_done;

      nvme_er_ok:
        xor rax, rax;                            // NVME_ERR_OK

      nvme_er_done:
        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // nvme_timeout_wait(bar0, wait_type, max_us) -> u16
  // ============================================================================
  //
  // SysV: (bar0: u64, wait_type: u64, max_us: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = wait_type (NVME_WAIT_RDY_SET | NVME_WAIT_RDY_CLEAR)
  //   rdx = max_us (advisory ceiling at M5 — actual cap is NVME_ERR_SPIN_MAX)
  //
  // Busy-poll CSTS.RDY until it matches the target bit (0 for CLEAR,
  // 1 for SET). Aborts early with NVME_ERR_CFS_SET on CFS transition.
  //
  // Return codes:
  //   NVME_ERR_OK         (0)      — condition met
  //   NVME_ERR_CFS_SET    (1)      — CFS observed during wait
  //   NVME_ERR_TIMEOUT    (0xFFFF) — iteration ceiling exhausted
  //
  // Register plan (4-push callee-save):
  //   rbx = bar0                      (preserved across nvme_reg_u32)
  //   rbp = wait_type (0 or 1)        (preserved)
  //   r12 = spin counter              (dec on each iter)
  //   r13 = target-bit test (0 or 1)  (== wait_type inverted for CLEAR? no —
  //                                    wait_type=0 (SET) needs RDY==1; wait_type=1
  //                                    (CLEAR) needs RDY==0; so target_bit =
  //                                    1 - wait_type)
  //
  //   4 pushes = 32 B; entry rsp%16==8 → 40, %16==8, sub rsp,8 → 48, %16==0.

  pub let nvme_timeout_wait : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, wait_type: u64, max_us: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M5-005 (#907). Busy-wait on CSTS.RDY reaching the caller-selected value, aborting on CFS. Body: (1) 4-push callee-save prologue (rbx=bar0, rbp=wait_type, r12=spin, r13=target_bit) — 32 B; entry rsp%16==8 → 40, sub rsp,8 → 48, %16==0 (aligned for nested nvme_reg_u32 call). (2) target_bit = 1 - wait_type (wait_type 0 SET wants RDY==1; wait_type 1 CLEAR wants RDY==0). Compute via `mov r13, 1; sub r13, rbp`. (3) Init r12 = NVME_ERR_SPIN_MAX. max_us (rdx) is intentionally ignored at M5 — advisory only, real TSC/HPET-derived wall-time cap lands with driver-attach at R25+. Documented in module header §NVME_ERR_SPIN_MAX. (4) Poll loop `nvme_tw_poll`: csts = nvme_reg_u32(bar0, 0x1C); rdy_bit = csts & 1; if csts & 2 (CFS) → return NVME_ERR_CFS_SET; if rdy_bit == r13 → return NVME_ERR_OK; dec r12; if r12 == 0 → return NVME_ERR_TIMEOUT; loop. Reserved labels: `nvme_tw_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;                              // 16B align

        mov rbx, rdi;                            // bar0
        mov rbp, rsi;                            // wait_type

        // ================================================================
        // (2) target_bit = 1 - wait_type.
        // ================================================================
        mov r13, 1;
        sub r13, rbp;

        // ================================================================
        // (3) Init spin counter.
        // ================================================================
        mov r12, 50000000;                       // NVME_ERR_SPIN_MAX

      nvme_tw_poll:
        mov rdi, rbx;
        mov rsi, 0x1C;                           // CSTS
        call nvme_reg_u32;

        // CFS abort.
        mov r10, rax;
        and r10, 2;                              // CFS bit
        cmp r10, 0;
        jne nvme_tw_cfs;

        // rdy_bit == target?
        mov r10, rax;
        and r10, 1;
        cmp r10, r13;
        je nvme_tw_ok;

        sub r12, 1;
        cmp r12, 0;
        je nvme_tw_timeout;
        jmp nvme_tw_poll;

      nvme_tw_ok:
        xor rax, rax;                            // NVME_ERR_OK
        jmp nvme_tw_done;

      nvme_tw_cfs:
        mov rax, 1;                              // NVME_ERR_CFS_SET
        jmp nvme_tw_done;

      nvme_tw_timeout:
        mov rax, 0xFFFF;                         // NVME_ERR_TIMEOUT

      nvme_tw_done:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // nvme_abort_cmd(bar0, cid) -> u16
  // ============================================================================
  //
  // SysV: (bar0: u64, cid: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = cid (u16 semantics) — the CID of the outstanding command to abort
  //
  // Sends Admin Abort (OPC=0x08). CDW10 = (sqid << 16) | cid, where
  // sqid identifies which SQ the target command lives in. At M5 we
  // hardcode sqid=1 (the boot-line IO SQ) — the multi-queue-aware
  // Abort dispatch lands with the driver-attach path.
  //
  // Returns rax = 16-bit CQE status from the admin submit. Success
  // codes: (status & 0xFFFE) == 0 means the Abort was accepted; the
  // response DW0 bit 0 tells whether the target command was actually
  // aborted vs. already-completed. That bit is discarded at M5 since
  // the interpretation is caller-specific.
  //
  // Register plan (2-push callee-save):
  //   rbx = bar0, rbp = cid
  //
  //   2 pushes = 16 B; entry rsp%16==8 → 24, %16==8; sub rsp, 8 → 32,
  //   %16==0 (aligned for nvme_admin_submit_poll).

  pub let nvme_abort_cmd : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, cid: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M5-005 (#907). Build + submit Admin Abort (OPC=0x08) for an in-flight command per NVMe §5.1. Body: (1) 2-push callee-save prologue (rbx=bar0, rbp=cid) — 16 B; entry rsp%16==8 → 24, sub rsp,8 → 32, %16==0 (aligned for nvme_admin_submit_poll). (2) rep_stosb-zero the 64-byte _nvme_admin_sqe_scratch (rdi=lea scratch, rax=0, rcx=64, cld). rep_stosb clobbers rcx/rax/rdi but rbx/rbp survive. (3) Reload scratch base via lea into r10. (4) OPC (u8 @+0) = 0x08 via mov_b. (5) NSID (u32 @+4) = 0 (already zero from memset). (6) Compute CDW10 = (sqid=1 << 16) | cid. sqid=1 hardcoded at M5 — the multi-queue-aware dispatch lands with driver-attach (R25+). `mov rax, rbp; and rax, 0xFFFF; mov r11, 0x10000; add rax, r11` gives (1<<16) | (cid & 0xFFFF). Store via mov_d [scratch+40]. (7) Submit via nvme_admin_submit_poll(bar0=rbx, ctx=&_nvme_admin_ctx, sqe=scratch). Result in rax = raw 16-bit status. (8) Return rax. Reserved labels: `nvme_ab_`.",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;                              // 16B align

        mov rbx, rdi;                            // bar0
        mov rbp, rsi;                            // cid

        // ================================================================
        // (2) Zero the 64-byte SQE scratch.
        // ================================================================
        lea rdi, [rip + _nvme_admin_sqe_scratch];
        xor rax, rax;
        mov rcx, 64;
        cld;
        rep_stosb;

        // ================================================================
        // (3)-(6) Fill SQE fields.
        // ================================================================
        lea r10, [rip + _nvme_admin_sqe_scratch];

        // OPC (u8 @+0) = 0x08.
        mov rax, 8;
        mov_b [r10 + 0], rax;

        // NSID (u32 @+4) = 0 — already zero.

        // CDW10 (u32 @+40) = (sqid=1 << 16) | (cid & 0xFFFF).
        mov rax, rbp;
        and rax, 0xFFFF;
        mov r11, 0x10000;                        // sqid=1 shifted
        add rax, r11;
        mov_d [r10 + 40], rax;

        // ================================================================
        // (7) Submit.
        // ================================================================
        mov rdi, rbx;
        lea rsi, [rip + _nvme_admin_ctx];
        lea rdx, [rip + _nvme_admin_sqe_scratch];
        call nvme_admin_submit_poll;

        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
