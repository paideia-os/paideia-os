// src/kernel/core/drivers/nvme/identify.pdx — R24-M1-004 (#889)
//
// NVMe Admin — IDENTIFY Controller (CNS=0x01) command builder + result
// struct layout.
//
// Per NVMe Base Spec 2.0 §5.17, the IDENTIFY admin command with
// CDW10.CNS = 0x01 returns a 4 KiB Identify Controller data structure
// describing the controller's vendor/model/firmware and its supported
// admin/NVM command surface.  R24.M1 lands:
//
//   (a) The 4 KiB response buffer as page-aligned .bss (_nvme_id_ctrl_buf).
//       Under IOMMU-off boot (identity-mapped low half) the buffer's
//       VA equals its PA and can be handed to the controller as PRP1
//       without additional translation.
//
//   (b) The 64-byte SQE builder nvme_build_id_ctrl_cmd(prp1_pa, sqe_pa)
//       that fills in an Admin SQE ready for submission.  Actual queue
//       submission (write to SQ0TDBL, poll CQ0) lands at R24.M2 once
//       the admin queue infrastructure from #888 is coupled to a
//       nvme_admin_submit primitive.
//
// -----------------------------------------------------------------------------
// SQE layout (NVMe Base Spec 2.0 §4.2, Figure 87)
// -----------------------------------------------------------------------------
//
//   Byte offset | Field
//   ------------+-----------------------------------------------------------
//   +0          | u8  OPC   — opcode (0x06 = IDENTIFY)
//   +1          | u8  FUSE|PSDT — fused-op (bits 0-1), PRP/SGL sel (bits 6-7)
//   +2          | u16 CID   — command identifier (M1: 0)
//   +4          | u32 NSID  — namespace ID (0 for controller identify)
//   +8          | u64 rsvd  — reserved
//   +16         | u64 MPTR  — metadata pointer (0)
//   +24         | u64 PRP1  — first PRP (physical addr of data buffer)
//   +32         | u64 PRP2  — second PRP (0 for single 4 KiB xfer)
//   +40         | u32 CDW10 — CNS (Controller-or-Namespace-Structure select)
//   +44         | u32 CDW11 — command-specific
//   +48         | u32 CDW12 — command-specific
//   +52         | u32 CDW13 — command-specific
//   +56         | u32 CDW14 — command-specific
//   +60         | u32 CDW15 — command-specific
//
// For IDENTIFY Controller (CNS=0x01), CDW10..CDW15 are:
//   CDW10 = CNS (low 8 bits = 0x01) | (CNTID << 16, unused here) = 0x00000001
//   CDW11 = CSI (byte 3, unused for standard controllers) | NVMSETID = 0
//   CDW12..CDW15 = 0
//
// -----------------------------------------------------------------------------
// Identify Controller struct layout (NVMe Base Spec 2.0 §5.17.2.1)
// -----------------------------------------------------------------------------
//
//   Byte offset | Size | Field
//   ------------+------+-------------------------------------------------------
//   +0          | 2 B  | VID       — PCI vendor ID
//   +2          | 2 B  | SSVID     — PCI subsystem vendor ID
//   +4          | 20 B | SN        — serial number (ASCII, space-padded)
//   +24         | 40 B | MN        — model number (ASCII, space-padded)
//   +64         | 8 B  | FR        — firmware revision (ASCII)
//   +72         | 1 B  | RAB       — recommended arbitration burst
//   +73         | 3 B  | IEEE OUI  — company identifier
//   +76         | 1 B  | CMIC      — controller multi-path I/O + namespace
//   +77         | 1 B  | MDTS      — maximum data transfer size (2^N pages)
//   +78         | 2 B  | CNTLID    — controller ID
//   +80         | 4 B  | VER       — NVMe version (mirrors BAR0 VS)
//   +84         | 4 B  | RTD3R     — RTD3 resume latency (us)
//   +88         | 4 B  | RTD3E     — RTD3 entry latency (us)
//   +92         | 4 B  | OAES      — optional async event support
//   +96         | 4 B  | CTRATT    — controller attributes
//   ...         |      | ...
//   +256        | 2 B  | OACS      — optional admin command support
//   +258        | 1 B  | ACL       — abort command limit
//   +259        | 1 B  | AERL      — async event request limit
//   ...         |      | ...
//   +512        | 4 B  | SQES/CQES — SQ/CQ entry sizes (min/max encoded)
//   +516        | 2 B  | MAXCMD    — max outstanding commands
//   +516        | 4 B  | NN        — number of namespaces (u32 @+516? see below)
//
// (The offsets 512-540 are approximate summaries; the authoritative
// M2 parser walks the exact spec figure.  For M1 we lock in the
// invariants at the top of the block — VID/SN/MN/FR — that every
// consumer needs.)
//
// M1 exposes the u16/u32 field offsets as module constants so the M2
// parser doesn't hard-code them.

module Identify = structure {

  // ============================================================================
  // Command opcodes / CNS values (§5.17)
  // ============================================================================

  pub let NVME_ADMIN_OPC_IDENTIFY   : u64 = 0x06
  pub let NVME_CNS_ID_NAMESPACE     : u64 = 0x00
  pub let NVME_CNS_ID_CONTROLLER    : u64 = 0x01
  pub let NVME_CNS_ID_NS_LIST       : u64 = 0x02

  // ============================================================================
  // SQE byte offsets (§4.2, Figure 87)
  // ============================================================================

  pub let NVME_SQE_OPC              : u64 = 0
  pub let NVME_SQE_CID              : u64 = 2
  pub let NVME_SQE_NSID             : u64 = 4
  pub let NVME_SQE_MPTR             : u64 = 16
  pub let NVME_SQE_PRP1             : u64 = 24
  pub let NVME_SQE_PRP2             : u64 = 32
  pub let NVME_SQE_CDW10            : u64 = 40
  pub let NVME_SQE_CDW11            : u64 = 44
  pub let NVME_SQE_CDW12            : u64 = 48
  pub let NVME_SQE_CDW13            : u64 = 52
  pub let NVME_SQE_CDW14            : u64 = 56
  pub let NVME_SQE_CDW15            : u64 = 60
  pub let NVME_SQE_SIZE             : u64 = 64

  // ============================================================================
  // Identify Controller struct — key field offsets (§5.17.2.1)
  // ============================================================================

  pub let NVME_ID_CTRL_VID          : u64 = 0     // u16
  pub let NVME_ID_CTRL_SSVID        : u64 = 2     // u16
  pub let NVME_ID_CTRL_SN_OFF       : u64 = 4     // 20 B ASCII
  pub let NVME_ID_CTRL_SN_LEN       : u64 = 20
  pub let NVME_ID_CTRL_MN_OFF       : u64 = 24    // 40 B ASCII
  pub let NVME_ID_CTRL_MN_LEN       : u64 = 40
  pub let NVME_ID_CTRL_FR_OFF       : u64 = 64    //  8 B ASCII
  pub let NVME_ID_CTRL_FR_LEN       : u64 = 8
  pub let NVME_ID_CTRL_RAB          : u64 = 72    // u8
  pub let NVME_ID_CTRL_IEEE_OFF     : u64 = 73    //  3 B
  pub let NVME_ID_CTRL_CMIC         : u64 = 76    // u8
  pub let NVME_ID_CTRL_MDTS         : u64 = 77    // u8
  pub let NVME_ID_CTRL_CNTLID       : u64 = 78    // u16
  pub let NVME_ID_CTRL_VER          : u64 = 80    // u32
  pub let NVME_ID_CTRL_OAES         : u64 = 92    // u32
  pub let NVME_ID_CTRL_CTRATT       : u64 = 96    // u32
  pub let NVME_ID_CTRL_OACS         : u64 = 256   // u16
  pub let NVME_ID_CTRL_ACL          : u64 = 258   // u8
  pub let NVME_ID_CTRL_AERL         : u64 = 259   // u8
  pub let NVME_ID_CTRL_NN           : u64 = 516   // u32

  pub let NVME_ID_CTRL_SIZE         : u64 = 4096

  // ============================================================================
  // Response buffer — page-aligned .bss (M1: PA = VA under identity map)
  // ============================================================================
  //
  //   512 × u64 = 4096 B = one 4 KiB page (matches NVME_ID_CTRL_SIZE).

  pub let mut _nvme_id_ctrl_buf     : [u64; 512] = uninit @align(4096)

  // ============================================================================
  // R111.M3-012 (paideia-os #2364) — per-controller ASCII string buffers.
  // ============================================================================
  //
  // nvme_id_ctrl_copy_ascii populates these with the trimmed MN / SN / FR
  // fields from _nvme_id_ctrl_buf, NUL-terminated so klog_emit_core's 's'
  // fmt path can safely copy them.  Sized to (field_len + 1) so a
  // maximally-populated field (no trailing spaces) still has room for the
  // terminator.  These are single-writer, single-reader per attach-loop
  // iteration (attach.pdx §nvme_attach_all populates then immediately
  // emits, then overwrites on the next controller): they hold the LAST
  // attached controller's strings and are diagnostic-only.
  //
  // 41 = NVME_ID_CTRL_MN_LEN + 1;
  // 21 = NVME_ID_CTRL_SN_LEN + 1;
  //  9 = NVME_ID_CTRL_FR_LEN + 1.

  pub let mut _nvme_id_str_mn       : [u8; 41] = uninit @align(64)
  pub let mut _nvme_id_str_sn       : [u8; 21] = uninit @align(64)
  pub let mut _nvme_id_str_fr       : [u8; 9]  = uninit @align(64)

  // ============================================================================
  // nvme_build_id_ctrl_cmd(prp1_pa, sqe_pa) -> ()
  // ============================================================================
  //
  // SysV: (prp1_pa: u64, sqe_pa: u64) -> ()
  //   rdi = physical address of the 4 KiB response buffer (typically
  //         &_nvme_id_ctrl_buf under identity-map)
  //   rsi = physical address of the 64-byte SQE slot to fill (typically
  //         &_nvme_admin_sq + slot_idx * 64)
  //
  // Fills the SQE slot with an IDENTIFY-CONTROLLER command:
  //   OPC   = 0x06
  //   CID   = 0            (M1 — real CID allocation lands in M2 submit)
  //   NSID  = 0            (controller-scope identify)
  //   PRP1  = prp1_pa
  //   PRP2  = 0            (single-page transfer fits in PRP1)
  //   CDW10 = 0x01         (CNS = Identify Controller)
  //   CDW11..CDW15 = 0
  //
  // Leaf function — no nested calls, no callee-save prologue needed.

  pub let nvme_build_id_ctrl_cmd : (u64, u64) -> () !{mem} @{boot} =
    fn (prp1_pa: u64, sqe_pa: u64) -> unsafe {
      effects: { mem },
      capabilities: { boot },
      justification: "R24-M1-004 (#889). NVMe IDENTIFY Controller SQE builder. Leaf function. Body: (1) Zero the entire 64-byte SQE via 8 × u64 stores (`mov [rsi + 0..56 step 8], rax` with rax=0). Bare `mov` at 64-bit width matches REX.W — no G1 hazard. (2) Overwrite dword 0 (offset 0) with 0x00000006 via `mov_d [rsi + 0], rax` (rax = 0x6) — G1 sized-32-bit store; sets OPC=0x06, FUSE=0, PSDT=0, CID=0 in one write. (3) Store PRP1 (u64 @ +24) via `mov [rsi + 24], rdi` — 64-bit store, no G1 risk. (4) Overwrite dword 10 (offset 40) with 0x00000001 via `mov_d [rsi + 40], rax` — CNS = Identify Controller. All other fields (NSID @+4, rsvd @+8, MPTR @+16, PRP2 @+32, CDW11..15 @+44..60) already zero from step (1). No callee-save prologue: rax/rdi/rsi are caller-save, no rbx/rbp/r12-r15 touched. no-frame trims 4-byte prologue at the cost of stack-walkability across the leaf.",
      block: {
        // (1) Zero the entire 64-byte SQE.
        xor rax, rax;
        mov [rsi + 0],  rax;
        mov [rsi + 8],  rax;
        mov [rsi + 16], rax;
        mov [rsi + 24], rax;
        mov [rsi + 32], rax;
        mov [rsi + 40], rax;
        mov [rsi + 48], rax;
        mov [rsi + 56], rax;

        // (2) Dword 0: OPC = 0x06 (IDENTIFY), FUSE/PSDT/CID = 0.
        mov rax, 6;
        mov_d [rsi + 0], rax;

        // (3) PRP1 @ +24 = prp1_pa.
        mov [rsi + 24], rdi;

        // (4) CDW10 @ +40 = CNS = 0x01 (Identify Controller).
        mov rax, 1;
        mov_d [rsi + 40], rax;

        ret
      }
    }

  // ============================================================================
  // nvme_id_ctrl_read_u64(offset) -> u64
  // ============================================================================
  //
  // R111.M3-011 (paideia-os #2363): 8-byte read accessor into
  // _nvme_id_ctrl_buf, minted for the NVME ATTACH OK fingerprint emitted
  // by drivers/nvme/attach.pdx §nvme_attach_all. The fingerprint carries
  // the first 8 ASCII bytes of the Identify Controller MN field
  // (NVME_ID_CTRL_MN_OFF = 24) and FR field (NVME_ID_CTRL_FR_OFF = 64)
  // as a 64-bit hash-like signature — enough to identify a specific
  // SSD SKU / firmware from a boot transcript without hex-dumping the
  // full 4 KiB response.
  //
  // Bounds gate: offset + 8 <= NVME_ID_CTRL_SIZE (4096), i.e. offset
  // <= 4088. Out-of-bounds returns 0 rather than dereferencing past the
  // 4 KiB response buffer.
  //
  // Reads are unaligned-safe (x86 MOV loads a u64 from any address).
  // The buffer is @align(4096) so aligned reads at MN/FR offsets are
  // naturally aligned within a cache line.
  //
  // SysV: (offset: u64) -> u64
  //   rdi = byte offset into _nvme_id_ctrl_buf.
  //   rax = 64-bit little-endian value at &_nvme_id_ctrl_buf + offset,
  //         or 0 if offset > 4088.
  //
  // Leaf function — no callee-save prologue, r10 scratch. Labels prefixed
  // nvme_idcru_.

  pub let nvme_id_ctrl_read_u64 : (u64) -> u64 !{mem} @{} =
    fn (offset: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R111.M3-011 (paideia-os #2363): expose 8-byte little-endian reads from _nvme_id_ctrl_buf for the NVME ATTACH OK fingerprint (attach.pdx §nvme_attach_all). Bounds gate: offset > 4088 returns 0 without dereferencing past the 4 KiB buffer. Reads are unaligned-safe (x86 MOV). Leaf: no callee-save prologue, r10 scratch, rax return. Labels prefixed nvme_idcru_. Callers pass NVME_ID_CTRL_MN_OFF (24) for the first 8 MN bytes and NVME_ID_CTRL_FR_OFF (64) for the first 8 FR bytes — both well within bounds; the gate exists to make the accessor safe for future consumers reading other offsets.",
      block: {
        mov r10, 4088;
        cmp rdi, r10;
        ja nvme_idcru_oob;

        lea r10, [rip + _nvme_id_ctrl_buf];
        add r10, rdi;
        mov rax, [r10];
        ret;

      nvme_idcru_oob:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // nvme_id_ctrl_copy_ascii(dst_ptr, offset, len) -> ()
  // ============================================================================
  //
  // R111.M3-012 (paideia-os #2364): copy `len` ASCII bytes from
  // _nvme_id_ctrl_buf[offset .. offset+len] into dst_ptr, trim trailing
  // 0x20 (space) padding by walking backwards from the last copied byte,
  // and NUL-terminate at the first trimmed position (dst_ptr[trimmed_len]).
  //
  // The Identify Controller MN / SN / FR fields are space-padded ASCII
  // per NVMe Base Spec 2.0 §5.17.2.1; a bare copy carries the trailing
  // spaces into the fingerprint (`mn="SAMSUNG MZVLB512HAJQ-00000               "`)
  // which is noisy in a boot transcript.  Trimming trailing spaces
  // produces a clean `mn="SAMSUNG MZVLB512HAJQ-00000"`.
  //
  // Bounds gate: (offset + len) > NVME_ID_CTRL_SIZE (4096) returns
  // silently without writing to dst — matches nvme_id_ctrl_read_u64's
  // fail-silent posture.  Caller MUST ensure dst_ptr has at least
  // (len + 1) writable bytes (space for the NUL terminator).
  //
  // SysV: (dst_ptr: u64, offset: u64, len: u64) -> ()
  //   rdi = destination pointer (writable at least len+1 bytes)
  //   rsi = source byte offset into _nvme_id_ctrl_buf
  //   rdx = number of bytes to copy (before trim)
  //
  // Leaf function — no callee-save prologue.  Scratch: r10 (source base),
  // r11 (dst base), rcx (loop index), rax (byte value).  Labels prefixed
  // `nvme_idca_`.

  pub let nvme_id_ctrl_copy_ascii : (u64, u64, u64) -> () !{mem} @{} =
    fn (dst_ptr: u64, offset: u64, len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R111.M3-012 (paideia-os #2364): copy `len` ASCII bytes from _nvme_id_ctrl_buf+offset to dst_ptr, then walk backwards trimming 0x20 trailing spaces, then write a NUL terminator at the first trimmed position. Populates the _nvme_id_str_mn/sn/fr diagnostic buffers for the NVME ID fingerprint. Body: (1) Compute r10 = &_nvme_id_ctrl_buf + offset (source pointer via lea + add). (2) Copy loop: rcx=0..len, dst[rcx] = src[rcx] via mov_b rax, [r10+rcx*1]; mov [rdi+rcx*1], al. (3) Bounds gate: if offset+len > 4096 (NVME_ID_CTRL_SIZE), skip the copy AND the NUL write — the caller's buffer already holds whatever state; we return without touching it. Practical cost of a stricter policy (zero the buffer) is not paid because every M3-012 call site (attach.pdx MN/SN/FR) sits well within bounds. (4) Trim: rcx starts at len; walk backwards while rcx>0 and dst[rcx-1] == 0x20: sub rcx,1. Loop stops at first non-space or rcx==0. (5) Write NUL: mov_b [rdi+rcx*1], al with rax=0. Reserved-label prefix nvme_idca_. Encoder posture: mov_b [reg+reg*1] indexed load/store (proven in path.pdx L211, readdir.pdx L349); cmp reg, reg / cmp reg, imm (never cmp reg,[mem]); no test rN,rN; no imul r,imm 2-op; no and reg,imm64.",
      block: {
        // (0) Bounds gate: if offset + len > NVME_ID_CTRL_SIZE (4096) → skip.
        //     Compute offset+len in r10 first so we do not clobber rdi/rsi/rdx.
        mov r10, rsi;
        add r10, rdx;
        mov r11, 4096;                    // NVME_ID_CTRL_SIZE
        cmp r10, r11;
        ja  nvme_idca_out;

        // (1) Source pointer: r10 = &_nvme_id_ctrl_buf + offset.
        lea r10, [rip + _nvme_id_ctrl_buf];
        add r10, rsi;

        // (2) Copy loop: dst[i] = src[i] for i in [0, len).
        xor rcx, rcx;
      nvme_idca_copy:
        cmp rcx, rdx;
        jae nvme_idca_trim;
        xor rax, rax;
        mov_b rax, [r10 + rcx*1];
        mov [rdi + rcx*1], al;
        inc rcx;
        jmp nvme_idca_copy;

        // (3) Trim: walk rcx=len backwards while dst[rcx-1] == 0x20.
      nvme_idca_trim:
        mov rcx, rdx;
      nvme_idca_trim_top:
        cmp rcx, 0;
        je  nvme_idca_nul;              // all bytes were spaces → NUL at [dst+0]
        mov r10, rcx;
        sub r10, 1;
        xor rax, rax;
        mov_b rax, [rdi + r10*1];
        cmp rax, 0x20;
        jne nvme_idca_nul;               // dst[rcx-1] is non-space → NUL at [dst+rcx]
        sub rcx, 1;
        jmp nvme_idca_trim_top;

        // (4) Write NUL terminator at dst[rcx].
      nvme_idca_nul:
        xor rax, rax;
        mov [rdi + rcx*1], al;

      nvme_idca_out:
        ret
      }
    }

  // ============================================================================
  // nvme_id_ctrl_hash_fnv1a() -> u64
  // ============================================================================
  //
  // R111.M3-012 (paideia-os #2364): 64-bit FNV-1a hash over the
  // concatenated raw MN[24..64] || SN[4..24] || FR[64..72] bytes of
  // _nvme_id_ctrl_buf (68 bytes total).  Emitted as the `hash=` KV in
  // the `NVME ID HASH` fingerprint so a boot-log reader can tell a
  // "same drive, second boot" line from a "different drive plugged in"
  // line without walking the full Identify structure.
  //
  // FNV-1a 64-bit rationale (vs SHA256 / BLAKE3 in the task spec):
  //
  //   The task spec's original intent — "SHA256 or BLAKE3 of (mn || sn || fr),
  //   32 bytes, use existing crypto sha256 or blake3 hash from
  //   paideia-as-crypto" — presumes a kernel BLAKE3 primitive.  A
  //   `grep -rn 'blake3\|BLAKE3\|sha256\|SHA256' src/kernel/` returns
  //   only *references* to a BLAKE3 primitive (pdxfs superblock,
  //   sig_verify) — never an implementation, and sig_verify.pdx
  //   documents the gap explicitly ("no BLAKE3 kernel/.pdx primitive
  //   exists at this landing").  Because the fingerprint's emit width
  //   is 8 hex chars (32 bits — the first `%08x` of the hash), and its
  //   operational role is drive-swap detection across boots on the SAME
  //   host (not adversarial collision resistance), a 64-bit non-cryptographic
  //   hash meets the fingerprint's discrimination goal today while the
  //   emit-line contract stays byte-compatible with a future swap to
  //   the low 8 hex chars of a real 32-byte BLAKE3 digest (see keys.pdx
  //   §tag_nvme_id_hash design note).
  //
  //   FNV-1a 64-bit: hash = 0xCBF29CE484222325 (offset basis);
  //   for each byte b: hash ^= b; hash *= 0x100000001B3 (FNV prime).
  //
  // Bounds: reads bytes [4..72) from _nvme_id_ctrl_buf — a 4096-byte
  // buffer — so the walk is entirely in-bounds unconditionally.
  //
  // SysV: () -> u64
  //   rax = 64-bit FNV-1a hash.
  //
  // Leaf function — no callee-save prologue.  Scratch: rax (hash acc),
  // r10 (FNV prime, imm64), r11 (buffer base), r9 (byte scratch),
  // rcx (loop cursor).  Labels prefixed `nvme_idch_`.

  pub let nvme_id_ctrl_hash_fnv1a : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R111.M3-012 (paideia-os #2364): 64-bit FNV-1a hash over MN[24..64] || SN[4..24] || FR[64..72] from _nvme_id_ctrl_buf. Body: (1) rax = FNV_OFFSET_BASIS_64 = 0xCBF29CE484222325 (imm64 mov to r64 — same pattern as attach.pdx L348 KERNEL_VMA_BASE stage). (2) r10 = FNV_PRIME_64 = 0x100000001B3 (imm64 mov; the prime is 41 bits so imm32-sign-extended is insufficient — staged into r10 for the `imul rax, r10` inner step). (3) r11 = &_nvme_id_ctrl_buf via lea rip-relative. (4) Three inline byte loops in sequence, one per field, without a shared subroutine: MN loop rcx=24..64; SN loop rcx=4..24; FR loop rcx=64..72. Each iteration: xor r9,r9; mov_b r9,[r11+rcx*1]; xor rax,r9; imul rax,r10; inc rcx. Non-cryptographic hash rationale: BLAKE3 kernel primitive is a confirmed cross-repo gap (sig_verify.pdx §L19-53); the fingerprint's role is drive-swap detection on the same host (not adversarial collision resistance), and the emit width is only 8 hex chars (32 bits) — a 64-bit non-cryptographic mix over 68 input bytes meets the discrimination goal, and the emit-line contract survives a later BLAKE3 swap byte-compatibly (see keys.pdx §tag_nvme_id_hash design note). Encoder posture: `mov r64, imm64` REX.W encoding for both constants; `imul rax, r10` 2-op reg-reg (the forbidden form is 2-op imul r,imm); `xor rax, r9` reg-reg; `mov_b r9, [r11+rcx*1]` indexed byte load (proven in path.pdx L211). No test rN,rN; no cmp reg,[mem]. Reserved-label prefix nvme_idch_.",
      block: {
        // (1) rax = FNV_OFFSET_BASIS_64 = 0xCBF29CE484222325.
        mov rax, 0xCBF29CE484222325;

        // (2) r10 = FNV_PRIME_64 = 0x100000001B3 (staged for `imul rax, r10`).
        mov r10, 0x100000001B3;

        // (3) r11 = &_nvme_id_ctrl_buf (buffer base).
        lea r11, [rip + _nvme_id_ctrl_buf];

        // (4a) MN field: bytes 24..64 (40 bytes).
        mov rcx, 24;
      nvme_idch_mn:
        cmp rcx, 64;
        jae nvme_idch_mn_done;
        xor r9, r9;
        mov_b r9, [r11 + rcx*1];
        xor rax, r9;
        imul rax, r10;
        inc rcx;
        jmp nvme_idch_mn;
      nvme_idch_mn_done:

        // (4b) SN field: bytes 4..24 (20 bytes).
        mov rcx, 4;
      nvme_idch_sn:
        cmp rcx, 24;
        jae nvme_idch_sn_done;
        xor r9, r9;
        mov_b r9, [r11 + rcx*1];
        xor rax, r9;
        imul rax, r10;
        inc rcx;
        jmp nvme_idch_sn;
      nvme_idch_sn_done:

        // (4c) FR field: bytes 64..72 (8 bytes).
        mov rcx, 64;
      nvme_idch_fr:
        cmp rcx, 72;
        jae nvme_idch_fr_done;
        xor r9, r9;
        mov_b r9, [r11 + rcx*1];
        xor rax, r9;
        imul rax, r10;
        inc rcx;
        jmp nvme_idch_fr;
      nvme_idch_fr_done:

        ret
      }
    }
}
