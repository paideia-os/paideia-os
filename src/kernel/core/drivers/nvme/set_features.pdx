// src/kernel/core/drivers/nvme/set_features.pdx -- R51.M1-005 (#1637)
//
// NVMe Admin SET_FEATURES(FID=0x07) queue-count negotiation.
//
// Per NVMe Base Spec 2.0 §5.21.1.7 "Number of Queues (Feature
// Identifier 07h)", CDW11 encodes the request as:
//
//   CDW11[15:0]  NSQR  Number of I/O Submission Queues Requested   (0-based)
//   CDW11[31:16] NCQR  Number of I/O Completion Queues Requested   (0-based)
//
// The controller replies in the completion's CDW0:
//   CDW0[15:0]   NSQA  Number of I/O SQs Allocated                 (0-based)
//   CDW0[31:16]  NCQA  Number of I/O CQs Allocated                 (0-based)
//
// Both directions are 0-based: NSQR=3 requests four queues; NCQA=7
// means eight allocated.  The controller may return FEWER than
// requested; it never returns more.  The driver takes
// `min(NSQA + 1, NCQA + 1)` as the number of I/O queue PAIRS to
// create at R51.M3.
//
// This module ships:
//   (a) nvme_build_set_features_num_queues_cmd(sqe_pa, ncqr, nsqr)
//       SQE builder — same shape as identify.pdx's nvme_build_id_ctrl_cmd
//       but writes OPC=0x09 and CDW10=0x07, CDW11=(NCQR<<16)|NSQR.
//   (b) nvme_set_features_num_queues_submit(bar0, requested):
//       End-to-end wrapper: build SQE with NCQR=NSQR=requested-1,
//       submit via nvme_admin_submit_poll, return the completion's
//       CDW0 as u32 (or NVME_SET_FEATURES_FAILED sentinel).
//
// The M1 posture is dormant at BIOS/-kernel boot (no controller
// discovered).  Wire-up under UEFI/OVMF lands together with the R51.M3
// I/O queue substrate.
//
// -----------------------------------------------------------------------------
// SET_FEATURES SQE layout (§4.2 Figure 87 + §5.21 Figure 292)
// -----------------------------------------------------------------------------
//
//   +0    u8   OPC       0x09  (SET_FEATURES)
//   +1    u8   FUSE|PSDT 0
//   +2    u16  CID       0     (single-shot; M2 CID pool)
//   +4    u32  NSID      0     (feature is controller-scope)
//   +8    u64  rsvd      0
//   +16   u64  MPTR      0
//   +24   u64  PRP1      0     (Number-of-Queues is a Dword feature; no data)
//   +32   u64  PRP2      0
//   +40   u32  CDW10     0x07  (FID = Number of Queues; SV=0)
//   +44   u32  CDW11     (NCQR << 16) | NSQR
//   +48..+63 zero
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture
// -----------------------------------------------------------------------------
//
//   G1: mov_d for u32 stores into the SQE.
//   G4: full-register compares.
//
// r11 scratch only.  Reserved-label discipline: labels prefixed
// `nvme_sfb_` / `nvme_sfs_`.

module SetFeatures = structure {

  // Sentinel: nvme_admin_submit_poll returned non-zero completion
  // status or the R24 path was dormant.  Disjoint from any legal
  // 32-bit CDW0 payload (which fits in the low 32 bits).
  pub let NVME_SET_FEATURES_FAILED : u64 = 0xFFFFFFFFFFFFFFFF

  pub let NVME_ADMIN_OPC_SET_FEATURES : u64 = 0x09
  pub let NVME_FID_NUMBER_OF_QUEUES   : u64 = 0x07

  // ==========================================================================
  // nvme_build_set_features_num_queues_cmd(sqe_pa, ncqr, nsqr) -> ()
  // ==========================================================================
  //
  // SysV: (sqe_pa: u64, ncqr: u64, nsqr: u64) -> ()
  //   rdi = pointer to a 64-byte SQE slot to fill
  //   rsi = NCQR (0-based; 0..0xFFFF)
  //   rdx = NSQR (0-based; 0..0xFFFF)
  //
  // Leaf function.  Writes:
  //   +0  OPC = 0x09 (via mov_d at +0 with 0x00000009)
  //   +40 CDW10 = 0x07 (FID = Number of Queues)
  //   +44 CDW11 = (NCQR << 16) | NSQR
  //   every other u64 slot = 0.

  pub let nvme_build_set_features_num_queues_cmd : (u64, u64, u64) -> () !{mem} @{boot} =
    fn (sqe_pa: u64, ncqr: u64, nsqr: u64) -> unsafe {
      effects: {mem},
      capabilities: {boot},
      justification: "R51.M1-005 (#1637). SET_FEATURES(FID=0x07) SQE builder. Body: (1) Zero the 64-byte SQE via 8 x u64 stores (bare mov at REX.W width -- no G1 hazard). (2) Overwrite dword 0 (OPC=0x09, FUSE=0, PSDT=0, CID=0) via mov_d [sqe+0]. (3) Overwrite dword 10 (CDW10=0x07 = FID Number of Queues) via mov_d [sqe+40]. (4) Overwrite dword 11 (CDW11=(NCQR<<16)|NSQR) via mov_d [sqe+44]. Leaf, no callee-save. Args: rdi = sqe, rsi = ncqr, rdx = nsqr. Reserved labels: nvme_sfb_.",
      block: {
        // (1) Zero the 64-byte SQE.
        xor rax, rax;
        mov [rdi + 0],  rax;
        mov [rdi + 8],  rax;
        mov [rdi + 16], rax;
        mov [rdi + 24], rax;
        mov [rdi + 32], rax;
        mov [rdi + 40], rax;
        mov [rdi + 48], rax;
        mov [rdi + 56], rax;

        // (2) OPC = 0x09.
        mov rax, 9;
        mov_d [rdi + 0], rax;

        // (3) CDW10 = 0x07 (FID Number of Queues, SV = 0).
        mov rax, 7;
        mov_d [rdi + 40], rax;

        // (4) CDW11 = (NCQR << 16) | NSQR.  Clamp inputs to 16 bits.
        and rsi, 0xFFFF;
        and rdx, 0xFFFF;
        mov rax, rsi;
        shl rax, 16;
        or  rax, rdx;
        mov_d [rdi + 44], rax;

        ret
      }
    }

  // ==========================================================================
  // nvme_set_features_num_queues_submit(bar0, requested) -> u64
  // ==========================================================================
  //
  // SysV: (bar0: u64, requested: u64) -> u64
  //   rdi = BAR0 base of the controller
  //   rsi = requested number of I/O queue pairs (1..0x10000)
  //
  // Encodes NSQR=NCQR=requested-1 (0-based) into a SET_FEATURES SQE
  // via _nvme_admin_sqe_scratch, submits through nvme_admin_submit_poll,
  // and returns the completion's CDW0 field packed as u32 (bits
  // [31:0] = (NCQA << 16) | NSQA, both 0-based), or
  // NVME_SET_FEATURES_FAILED on non-zero status / timeout.
  //
  // Register plan (3-push callee-save):
  //   rbx = bar0, r12 = requested_0based
  //   3 pushes + sub rsp, 8 = 32 B; entry rsp%16==8 -> 40, %16==8;
  //   32 B scratch [rsp+0..31] would round to 64 but is unused here.
  //   Post-prologue 32; %16 == 0 (aligned for every nested call).

  pub let nvme_set_features_num_queues_submit : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, requested: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {boot},
      justification: "R51.M1-005 (#1637). End-to-end SET_FEATURES(FID=0x07) submit. Body: (1) Guard requested >= 1; else return FAILED (a request for zero queues is meaningless). (2) requested_0based = requested - 1; clamp to 0xFFFF. (3) Build SQE into _nvme_admin_sqe_scratch. (4) Submit via nvme_admin_submit_poll(bar0, &_nvme_admin_ctx, &_nvme_admin_sqe_scratch). (5) On (status & 0xFFFE) != 0, return NVME_SET_FEATURES_FAILED. (6) Read CDW0 from the just-completed CQE. This is the tricky bit: nvme_admin_submit_poll returned the 16-bit status but not CDW0; we recover CDW0 by reading &_nvme_admin_cq + (cq_head_prev * 16) + 0 as u32. Because nvme_admin_submit_poll advances cq_head AFTER capturing the status, the CDW0 lives at cq_head_current-1 (mod 64). Actually simpler: read cq_head (u16 @+18) from _nvme_admin_ctx, subtract 1 mod 64, index into _nvme_admin_cq at that slot's +0. Return the u32 in rax. Three callee-save pushes + sub rsp,8 = 32 bytes; post-prologue rsp%16 == 0 for every nested call. Reserved labels: nvme_sfs_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                            // bar0
        mov r12, rsi;                            // requested

        cmp r12, 1;
        jb  nvme_sfs_fail;

        // requested_0based = requested - 1, clamped to 0xFFFF.
        sub r12, 1;
        mov r11, 0xFFFF;
        cmp r12, r11;
        jbe nvme_sfs_ok_clamp;
        mov r12, r11;
      nvme_sfs_ok_clamp:

        // Build SQE.  ncqr = nsqr = r12.
        lea rdi, [rip + _nvme_admin_sqe_scratch];
        mov rsi, r12;                            // NCQR
        mov rdx, r12;                            // NSQR
        call nvme_build_set_features_num_queues_cmd;

        // Submit + poll.
        mov rdi, rbx;
        lea rsi, [rip + _nvme_admin_ctx];
        lea rdx, [rip + _nvme_admin_sqe_scratch];
        call nvme_admin_submit_poll;

        // Success iff (status & 0xFFFE) == 0.
        mov r10, rax;
        and r10, 0xFFFE;
        cmp r10, 0;
        jne nvme_sfs_fail;

        // Recover CDW0 from _nvme_admin_cq[(cq_head - 1) mod 64].
        // nvme_admin_submit_poll already advanced cq_head (u16 @+18);
        // the just-completed CQE lives one slot back.
        lea r13, [rip + _nvme_admin_ctx];
        xor rax, rax;
        mov_w rax, [r13 + 18];                   // cq_head (post-advance)
        // (cq_head - 1) mod 64
        add rax, 63;
        and rax, 63;
        shl rax, 4;                              // * 16 (CQE size)
        lea r10, [rip + _nvme_admin_cq];
        add r10, rax;
        xor rax, rax;
        mov_d rax, [r10 + 0];                    // CDW0 = (NCQA<<16)|NSQA
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        jmp nvme_sfs_out;

      nvme_sfs_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;             // NVME_SET_FEATURES_FAILED

      nvme_sfs_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
