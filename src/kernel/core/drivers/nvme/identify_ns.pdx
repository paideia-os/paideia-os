// src/kernel/core/drivers/nvme/identify_ns.pdx — R24-M2-003/004 (#892 / #893)
//
// NVMe Admin — IDENTIFY Namespace (CNS=0x00) + Namespace List
// (CNS=0x02). Coupled to the poll-mode submit primitive from
// queue.pdx (#891).
//
// -----------------------------------------------------------------------------
// Identify Namespace response layout (NVMe Base Spec 2.0 §5.17.2.2, 4 KiB)
// -----------------------------------------------------------------------------
//
//   Byte offset | Size | Field
//   ------------+------+---------------------------------------------------
//   +0          | 8 B  | NSZE     — namespace size in logical blocks
//   +8          | 8 B  | NCAP     — namespace capacity in blocks
//   +16         | 8 B  | NUSE     — namespace utilization in blocks
//   +24         | 1 B  | NSFEAT   — namespace features
//   +25         | 1 B  | NLBAF    — number of LBA formats supported (0-based)
//   +26         | 1 B  | FLBAS    — formatted LBA size (bits 0..3 = fmt index)
//   +27         | 1 B  | MC       — metadata capabilities
//   +28         | 1 B  | DPC      — end-to-end data protection capabilities
//   +29         | 1 B  | DPS      — end-to-end data protection type settings
//   +30         | 1 B  | NMIC     — namespace multi-path IO + sharing
//   +31         | 1 B  | RESCAP   — reservation capabilities
//   +32         | 1 B  | FPI      — format progress indicator
//   +33         | 1 B  | DLFEAT   — deallocate logical block features
//   ...         |      | ...
//   +128        | 4 B  | LBAF0    — LBA Format 0: MS(u16) | LBADS(u8) | RP(u8)
//   +132        | 4 B  | LBAF1
//   ...         |      | ...
//   +188        | 4 B  | LBAF15   — LBA Format 15 (last)
//
// Per §5.17.2.2, LBAF entries are 4 B:
//   MS    (u16 @+0)  — metadata size in bytes (0 if none)
//   LBADS (u8  @+2)  — data-size log2 (typical: 9 = 512 B, 12 = 4096 B)
//   RP    (u8  @+3)  — relative performance (0=best..3=degraded)
//
// The active LBA format index is FLBAS[3:0]. lba_size = 1 << LBADS.
//
// -----------------------------------------------------------------------------
// Namespace List response layout (§5.17.2.4, 4 KiB)
// -----------------------------------------------------------------------------
//
// An ordered list of up to 1024 4-byte namespace IDs is returned in
// ascending order. A zero entry terminates the list. Any entry after
// the first zero MUST be ignored.
//
// -----------------------------------------------------------------------------
// R24.M2 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// nvme_probe returns 0 under -kernel/BIOS boot (MCFG absent → PCI
// enumerator drains empty), so nvme_identify_ns / nvme_ns_list are
// dormant symbols at M2. Real activation lands with the UEFI/OVMF
// path plus driver-attach.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sized stores via mov_b / mov_w / mov_d.
//   G4: full-register compares (zero-extend loads via prior xor).
//
// Reserved-label discipline: labels prefixed `nvme_ns_` / `nvme_nl_`.

module IdentifyNs = structure {

  // ============================================================================
  // Identify Namespace struct field offsets
  // ============================================================================

  pub let NVME_ID_NS_NSZE           : u64 = 0     // u64 — size in logical blocks
  pub let NVME_ID_NS_NCAP           : u64 = 8     // u64 — capacity in logical blocks
  pub let NVME_ID_NS_NUSE           : u64 = 16    // u64 — utilization in logical blocks
  pub let NVME_ID_NS_NSFEAT         : u64 = 24    // u8
  pub let NVME_ID_NS_NLBAF          : u64 = 25    // u8
  pub let NVME_ID_NS_FLBAS          : u64 = 26    // u8
  pub let NVME_ID_NS_LBAF0          : u64 = 128   // start of LBAF table
  pub let NVME_ID_NS_LBAF_STRIDE    : u64 = 4     // per-format entry width
  pub let NVME_ID_NS_LBAF_LBADS_OFF : u64 = 2     // byte within LBAF entry
  pub let NVME_ID_NS_SIZE           : u64 = 4096

  // ============================================================================
  // Namespace list — max entries stored + terminator
  // ============================================================================

  pub let NVME_NS_LIST_MAX          : u64 = 16    // driver cap; spec allows 1024
  pub let NVME_NS_LIST_TERM         : u64 = 0     // zero entry ends the list

  // ============================================================================
  // Response buffers — page-aligned .bss (M2: PA = VA under identity map)
  // ============================================================================

  pub let mut _nvme_id_ns_buf       : [u64; 512] = uninit @align(4096)
  pub let mut _nvme_ns_list_buf     : [u64; 512] = uninit @align(4096)

  // ============================================================================
  // Discovered-namespace summary (populated by nvme_identify_ns)
  // ============================================================================

  pub let mut _nvme_lba_size        : u64 = 0
  pub let mut _nvme_ns_blocks       : u64 = 0

  // ============================================================================
  // Active NSID cache (populated by nvme_ns_list) — packed u32 slots.
  //
  //   8 × u64 = 64 B = 16 × u32 NSID slots.

  pub let mut _nvme_active_nsids    : [u64; 8] = uninit @align(8)
  pub let mut _nvme_active_nsid_count : u64   = 0

  // ============================================================================
  // nvme_identify_ns(bar0, ctx, nsid, out_buf_pa) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, ctx: u64, nsid: u64, out_buf_pa: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = ptr to admin_queue_ctx (must be initialized)
  //   rdx = namespace ID (u32 semantically, held in u64)
  //   rcx = physical address of a 4 KiB response buffer (typically
  //         &_nvme_id_ns_buf under identity-map)
  //
  // Returns rax = 16-bit CQE status. Success = (status & 0xFFFE) == 0.
  //
  // Body:
  //   (1) Zero _nvme_admin_sqe_scratch (64 B).
  //   (2) Fill SQE:
  //         OPC   = 0x06 (Identify)
  //         NSID  = nsid
  //         PRP1  = out_buf_pa
  //         CDW10 = 0x00 (CNS = Identify Namespace)
  //   (3) Call nvme_admin_submit_poll(bar0, ctx, &sqe).
  //   (4) On success: parse NSZE/FLBAS/LBAFn to derive lba_size + blocks.
  //   (5) Emit "NVME NS nsid=<n> lba_size=<sz> blocks=<count>" fingerprint.
  //   (6) Return status.
  //
  // Register plan (5-push callee-save + 0 pad):
  //   rbx = bar0
  //   rbp = ctx
  //   r12 = _nvme_admin_sqe_scratch base (LEA-computed)
  //   r13 = nsid
  //   r14 = out_buf_pa

  pub let nvme_identify_ns : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, ctx: u64, nsid: u64, out_buf_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M2-003 (#892). NVMe IDENTIFY Namespace (CNS=0x00) + LBA-size discovery. Body: (1) 5-push callee-save prologue (rbx=bar0, rbp=ctx, r12=sqe base, r13=nsid, r14=out_buf_pa) — 40 B; entry rsp%16==8 → 48, %16==0 (aligned for nvme_admin_submit_poll / klog_s1_x3). (2) rep_stosb-zero the 64-byte _nvme_admin_sqe_scratch (rdi = lea scratch, rax=0, rcx=64, cld). rep_stosb clobbers rcx/rax/rdi but rbp/r13/r14 survive per SysV. (3) Reload r12 = lea _nvme_admin_sqe_scratch. Fill OPC (u8 @+0) = 0x06 via mov_b, NSID (u32 @+4) = r13 via mov_d, PRP1 (u64 @+24) = r14 (plain 64-bit store), CDW10 (u32 @+40) = 0x00 already zero from step (2) so no write needed. (4) Submit via nvme_admin_submit_poll(bar0=rbx, ctx=rbp, sqe=r12). Result in rax = raw 16-bit status. (5) Save status in r12 (reused after sqe base no longer needed). (6) Skip parse on non-zero status (bits 1..15 non-zero == error). Success check: (status & 0xFFFE) == 0 — bit 0 is Phase Tag, always set on completion regardless of success. (7) Parse: NSZE (u64 @ out_buf+0) → _nvme_ns_blocks. FLBAS (u8 @+26) & 0xF → LBAF index. LBAF entry @ 128 + index*4; LBADS = byte @+2 within entry. lba_size = 1 << LBADS via `shl rax, cl`. Store to _nvme_lba_size. (8) Emit klog_s1_x3(INFO, NVME, tag_nvme_ns, k_nsid, nsid, k_lba_size, lba_size, k_blocks, blocks). Uses hex format (paideia-as klog wrappers ship 1-arity decimal but only 3-arity hex; the values are canonically inspected in hex anyway). Extended-args pushed right-to-left per klog_s1_x3 convention: [rsp+8]=v2=lba_size, [rsp+16]=k3=k_blocks, [rsp+24]=v3=blocks. Pre-pad with `sub rsp, 8` to preserve 16B alignment (3 pushes flips parity). (9) Return status in rax. Reserved labels: `nvme_ns_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = ctx
        mov r13, rdx;                            // r13 = nsid
        mov r14, rcx;                            // r14 = out_buf_pa

        // ================================================================
        // (2) Zero the 64-byte SQE scratch.
        // ================================================================
        lea rdi, [rip + _nvme_admin_sqe_scratch];
        xor rax, rax;
        mov rcx, 64;
        cld;
        rep_stosb;

        // ================================================================
        // (3) Fill SQE fields.
        // ================================================================
        lea r12, [rip + _nvme_admin_sqe_scratch];

        // OPC (u8 @+0) = 0x06.
        mov rax, 6;
        mov_b [r12 + 0], rax;

        // NSID (u32 @+4) = nsid.
        mov_d [r12 + 4], r13;

        // PRP1 (u64 @+24) = out_buf_pa.
        mov [r12 + 24], r14;

        // CDW10 (u32 @+40) = 0x00 — CNS=Identify Namespace. Already
        // zero from the memset in step (2); no explicit store.

        // ================================================================
        // (4) Submit the command.
        // ================================================================
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call nvme_admin_submit_poll;

        mov r12, rax;                            // r12 = status (raw u16)

        // ================================================================
        // (5) Skip parse on error.
        //     Success test: (status & 0xFFFE) == 0.
        // ================================================================
        mov rcx, r12;
        and rcx, 0xFFFE;
        cmp rcx, 0;
        jne nvme_ns_emit;

        // ================================================================
        // (6) Parse NSZE / FLBAS / LBAFn.
        // ================================================================

        // NSZE (u64 @+0) → _nvme_ns_blocks.
        mov rax, [r14 + 0];
        mov [rip + _nvme_ns_blocks], rax;

        // FLBAS (u8 @+26) & 0xF → LBAF index.
        xor rax, rax;
        mov_b rax, [r14 + 26];
        and rax, 0xF;

        // LBAF entry addr = out_buf + 128 + index * 4.
        shl rax, 2;
        add rax, 128;
        add rax, r14;

        // LBADS = u8 @ (LBAF entry + 2).
        xor rcx, rcx;
        mov_b rcx, [rax + 2];

        // lba_size = 1 << LBADS.
        mov rax, 1;
        shl rax, cl;

        mov [rip + _nvme_lba_size], rax;

      nvme_ns_emit:
        // ================================================================
        // (8) Emit fingerprint.
        //     klog_s1_x3(INFO, NVME, tag_nvme_ns,
        //                k_nsid, nsid,
        //                k_lba_size, [stack: lba_size],
        //                                     [stack: k_blocks],
        //                                     [stack: blocks])
        // ================================================================
        mov r13, [rip + _nvme_lba_size];         // r13 = lba_size
        mov r14, [rip + _nvme_ns_blocks];        // r14 = blocks

        sub rsp, 8;                              // align for klog (3 pushes odd)

        push r14;                                // v3 = blocks
        lea rax, [rip + k_blocks];
        push rax;                                // k3 = k_blocks
        push r13;                                // v2 = lba_size

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NVME];
        lea rdx, [rip + tag_nvme_ns];
        lea rcx, [rip + k_nsid];                 // k1

        // v1 = nsid. r13/r14 clobbered above; reload nsid from... nothing
        // saved. Re-derive: nsid was passed to us as rdx originally and
        // saved into r13 at entry, then r13 was overwritten with lba_size.
        // Restore nsid from the SQE scratch (u32 @+4) we filled earlier.
        xor r8, r8;
        mov_d r8, [rip + _nvme_admin_sqe_scratch + 4];

        lea r9, [rip + k_lba_size];              // k2

        call klog_s1_x3;

        add rsp, 24;                             // pop 3 pushed args
        add rsp, 8;                              // undo alignment pad

        mov rax, r12;                            // return raw status

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // nvme_ns_list(bar0, ctx, out_buf_pa) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, ctx: u64, out_buf_pa: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = ptr to admin_queue_ctx
  //   rdx = physical address of a 4 KiB response buffer (typically
  //         &_nvme_ns_list_buf under identity-map)
  //
  // Returns rax = 16-bit CQE status. Success = (status & 0xFFFE) == 0.
  //
  // Body:
  //   (1) Zero _nvme_admin_sqe_scratch (64 B).
  //   (2) Fill SQE:
  //         OPC   = 0x06 (Identify)
  //         NSID  = 0    (already zero from memset)
  //         PRP1  = out_buf_pa
  //         CDW10 = 0x02 (CNS = Active Namespace List)
  //   (3) Submit via nvme_admin_submit_poll.
  //   (4) On success: walk u32 entries in out_buf until zero terminator,
  //       copy the first NVME_NS_LIST_MAX into _nvme_active_nsids, and
  //       publish _nvme_active_nsid_count.
  //   (5) Emit "NVME NS LIST count=<n>" fingerprint.
  //   (6) Return status.
  //
  // Register plan (5-push callee-save):
  //   rbx = bar0
  //   rbp = ctx
  //   r12 = sqe base / walker cursor / status
  //   r13 = out_buf_pa (source of the u32 walk)
  //   r14 = discovered NSID count

  pub let nvme_ns_list : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, ctx: u64, out_buf_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M2-004 (#893). NVMe Active Namespace List (CNS=0x02) enumeration. Body: (1) 5-push callee-save prologue (rbx=bar0, rbp=ctx, r12=scratch, r13=out_buf, r14=count) — 40 B; entry rsp%16==8 → 48, %16==0 (aligned). (2) rep_stosb-zero the 64-byte _nvme_admin_sqe_scratch. NSID stays 0 (spec §5.17.1: NSID=0 for CNS=0x02). (3) Fill OPC (u8 @+0) = 0x06, PRP1 (u64 @+24) = r13 (out_buf_pa), CDW10 (u32 @+40) = 0x02 (CNS = Active NS List). (4) Submit via nvme_admin_submit_poll → r12 = raw status. (5) Skip parse on error ((status & 0xFFFE) != 0). (6) Walk u32 entries at out_buf: init r14=0 (dst count); init rcx=0 (src slot index 0..1023); loop { load nsid_u32 = mov_d [r13 + rcx*4]; if nsid == 0 → break; if r14 < NVME_NS_LIST_MAX → store mov_d [_nvme_active_nsids + r14*4], nsid; increment r14; increment rcx; if rcx == 1024 → break }. Encoder: `mov_d rax, [r13 + rcx*4]` — indexed sized load, matches existing G1 patterns; xor rax,rax prior for zero-extend into upper 32 bits. (7) Publish r14 → _nvme_active_nsid_count. (8) Emit klog_s1_d1(INFO, NVME, tag_nvme_ns_list, k_count, r14). (9) Return r12 (raw status). Reserved labels: `nvme_nl_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = ctx
        mov r13, rdx;                            // r13 = out_buf_pa

        // ================================================================
        // (2) Zero the 64-byte SQE scratch.
        // ================================================================
        lea rdi, [rip + _nvme_admin_sqe_scratch];
        xor rax, rax;
        mov rcx, 64;
        cld;
        rep_stosb;

        // ================================================================
        // (3) Fill SQE fields.
        // ================================================================
        lea r12, [rip + _nvme_admin_sqe_scratch];

        // OPC (u8 @+0) = 0x06.
        mov rax, 6;
        mov_b [r12 + 0], rax;

        // NSID (u32 @+4) = 0 — already zero from memset.

        // PRP1 (u64 @+24) = out_buf_pa.
        mov [r12 + 24], r13;

        // CDW10 (u32 @+40) = 0x02 (CNS = Active NS List).
        mov rax, 2;
        mov_d [r12 + 40], rax;

        // ================================================================
        // (4) Submit.
        // ================================================================
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call nvme_admin_submit_poll;

        mov r12, rax;                            // r12 = status

        // ================================================================
        // (5) Skip parse on error.
        // ================================================================
        mov rcx, r12;
        and rcx, 0xFFFE;
        cmp rcx, 0;
        jne nvme_nl_publish;

        // ================================================================
        // (6) Walk u32 entries; copy into _nvme_active_nsids until 0
        //     terminator or NVME_NS_LIST_MAX reached.
        //
        //     rcx = src slot index (0..1023)
        //     r14 = dst count
        // ================================================================
        xor r14, r14;                            // dst count = 0
        xor rcx, rcx;                            // src index = 0

      nvme_nl_walk:
        // Load nsid (u32 @ r13 + rcx*4).
        mov rax, rcx;
        shl rax, 2;                              // *4
        add rax, r13;
        xor rdx, rdx;
        mov_d rdx, [rax];

        // Zero entry terminates the list.
        cmp rdx, 0;
        je nvme_nl_publish;

        // If already at cap, skip store but continue advancing (or
        // break — spec allows early break since we're only enum'ing
        // for our cap).
        cmp r14, 16;                             // NVME_NS_LIST_MAX
        jae nvme_nl_next;

        // Store nsid → _nvme_active_nsids[r14].
        lea rax, [rip + _nvme_active_nsids];
        mov r8, r14;
        shl r8, 2;                               // *4
        add rax, r8;
        mov_d [rax], rdx;

        add r14, 1;

      nvme_nl_next:
        add rcx, 1;
        cmp rcx, 1024;                           // spec cap
        jae nvme_nl_publish;
        jmp nvme_nl_walk;

      nvme_nl_publish:
        // (7) Publish count.
        mov [rip + _nvme_active_nsid_count], r14;

        // ================================================================
        // (8) Emit "NVME NS LIST count=<n>".
        // ================================================================
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NVME];
        lea rdx, [rip + tag_nvme_ns_list];
        lea rcx, [rip + k_count];                // k1
        mov r8, r14;                             // v1 = count
        call klog_s1_d1;

        mov rax, r12;                            // return raw status

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
