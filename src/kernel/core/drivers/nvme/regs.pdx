// src/kernel/core/drivers/nvme/regs.pdx — R24-M1-002 (#887)
//
// NVMe controller-register MMIO accessors. Every NVMe controller
// exposes a page-sized MMIO window at BAR0 (typically 16 KiB) whose
// register layout is fixed by NVMe Base Spec 2.0 §3.1.  The offsets
// in this file match Figure 40 verbatim.
//
// -----------------------------------------------------------------------------
// Register layout (offsets from BAR0)
// -----------------------------------------------------------------------------
//
//   0x00  CAP    u64  Controller Capabilities:
//                       [15:0]   MQES     — max queue entries supported
//                       [16]     CQR      — contiguous queues required
//                       [18:17]  AMS      — arbitration mechanism supported
//                       [23:19]  reserved
//                       [31:24]  TO       — timeout (500 ms units)
//                       [35:32]  DSTRD    — doorbell stride (2^(2+DSTRD))
//                       [36]     NSSRS    — NSSR supported
//                       [44:37]  CSS      — command sets supported
//                       [45]     BPS      — boot partition support
//                       [47:46]  CPS      — controller power scope
//                       [51:48]  MPSMIN   — memory page size min
//                       [55:52]  MPSMAX   — memory page size max
//                       [63:56]  various
//
//   0x08  VS     u32  Version (major.minor.tertiary)
//   0x0C  INTMS  u32  Interrupt mask set (write-1-to-set)
//   0x10  INTMC  u32  Interrupt mask clear (write-1-to-clear)
//   0x14  CC     u32  Controller Configuration:
//                       [0]      EN       — controller enable
//                       [3:1]    reserved
//                       [6:4]    CSS      — command set selected
//                       [10:7]   MPS      — memory page size
//                       [13:11]  AMS      — arbitration mechanism
//                       [15:14]  SHN      — shutdown notification
//                       [19:16]  IOSQES   — I/O submission queue entry size (2^N)
//                       [23:20]  IOCQES   — I/O completion queue entry size (2^N)
//
//   0x1C  CSTS   u32  Controller Status:
//                       [0]      RDY      — controller ready
//                       [1]      CFS      — controller fatal status
//                       [3:2]    SHST     — shutdown status
//                       [4]      NSSRO    — NSSR occurred
//                       [5]      PP       — processing paused
//
//   0x20  NSSR   u32  NVM Subsystem Reset (write 0x4E564D65="NVMe" to reset)
//   0x24  AQA    u32  Admin Queue Attributes:
//                       [11:0]   ASQS     — admin SQ size - 1
//                       [27:16]  ACQS     — admin CQ size - 1
//
//   0x28  ASQ    u64  Admin Submission Queue base PA (4 KiB aligned)
//   0x30  ACQ    u64  Admin Completion Queue base PA (4 KiB aligned)
//
//   0x1000..    doorbells: SQnTDBL / CQnHDBL, stride = 2^(DSTRD + 2) bytes.
//               For DSTRD=0 (all commodity NVMe), stride = 4 bytes.
//
// -----------------------------------------------------------------------------
// R24.M1 posture: no boot-time NVMe I/O
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` boot QEMU q35 does not expose PCI devices to
// the PCI enumerator (MCFG-absent path), so nvme_probe returns 0 and
// the reset/enable path is never invoked. The accessors below are
// dormant symbols at M1 — real invocations land at M2 driver-attach
// after queue-page allocation via phys_alloc.
//
// -----------------------------------------------------------------------------
// MMIO ordering discipline
// -----------------------------------------------------------------------------
//
// All accessors bracket the MMIO transaction with `mfence` — same
// posture as core/iommu/vtd_regs.pdx / core/apic/ioapic.pdx:
//   (a) mfence-BEFORE: earlier WB stores retire before the UC MMIO
//       transaction begins (SDM Vol 3A §11.3.1 — WB→UC not ordered).
//   (b) mfence-AFTER: the MMIO transaction publishes / completes
//       before downstream code observes side-effects.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 MMIO stores.
//       64-bit MMIO stores are natural REX.W width so bare mov is safe.
//
// -----------------------------------------------------------------------------
// #887 blocker verdict
// -----------------------------------------------------------------------------
//
// #887 was labeled `cross-repo:paideia-as-blocked` on the premise that
// "bitfield struct helpers phase 2 (v0.22)" was required to decode
// CAP/CC/CSTS fields. Verdict: PAPER TIGER. The CAP/CC/CSTS fields
// decompose cleanly into `shr / and` sequences that every existing
// PCI/VT-d accessor already uses. 64-bit MMIO reads/writes are proven
// by vtd_read_u64 / vtd_write_u64 (R22.M4). No encoder gap blocks this
// module — the label is removed and M1 lands under standard discipline.

module Regs = structure {

  // ============================================================================
  // Register offsets (bytes from BAR0)
  // ============================================================================

  pub let NVME_REG_CAP              : u64 = 0x00
  pub let NVME_REG_VS               : u64 = 0x08
  pub let NVME_REG_INTMS            : u64 = 0x0C
  pub let NVME_REG_INTMC            : u64 = 0x10
  pub let NVME_REG_CC               : u64 = 0x14
  pub let NVME_REG_CSTS             : u64 = 0x1C
  pub let NVME_REG_NSSR             : u64 = 0x20
  pub let NVME_REG_AQA              : u64 = 0x24
  pub let NVME_REG_ASQ              : u64 = 0x28
  pub let NVME_REG_ACQ              : u64 = 0x30

  // ============================================================================
  // CC bit definitions (§3.1.5)
  // ============================================================================

  pub let NVME_CC_EN                : u64 = 0x00000001
  pub let NVME_CC_CSS_NVM_SHIFT     : u64 = 4
  pub let NVME_CC_MPS_SHIFT         : u64 = 7
  pub let NVME_CC_AMS_SHIFT         : u64 = 11
  pub let NVME_CC_SHN_SHIFT         : u64 = 14
  pub let NVME_CC_IOSQES_SHIFT      : u64 = 16
  pub let NVME_CC_IOCQES_SHIFT      : u64 = 20

  // Precomputed CC enable-value for boot-line NVM controllers:
  //   EN=1, CSS=0 (NVM), MPS=0 (4 KiB), AMS=0 (round-robin), SHN=0,
  //   IOSQES=6 (64 B), IOCQES=4 (16 B)
  //   = (0x4 << 20) | (0x6 << 16) | 0x1 = 0x00460001
  pub let NVME_CC_ENABLE_DEFAULT    : u64 = 0x00460001

  // ============================================================================
  // CSTS bit definitions (§3.1.6)
  // ============================================================================

  pub let NVME_CSTS_RDY             : u64 = 0x00000001
  pub let NVME_CSTS_CFS             : u64 = 0x00000002
  pub let NVME_CSTS_SHST_MASK       : u64 = 0x0000000C
  pub let NVME_CSTS_NSSRO           : u64 = 0x00000010
  pub let NVME_CSTS_PP              : u64 = 0x00000020

  // ============================================================================
  // AQA encoding — 64-entry admin queues (ASQS=ACQS=63, size=queue-1)
  // ============================================================================
  //
  // AQA = (ACQS << 16) | ASQS = (63 << 16) | 63 = 0x003F003F.

  pub let NVME_AQA_64_ENTRIES       : u64 = 0x003F003F

  // ============================================================================
  // Admin SQ/CQ entry counts (must match AQA programming)
  // ============================================================================

  pub let NVME_ADMIN_SQ_ENTRIES     : u64 = 64
  pub let NVME_ADMIN_CQ_ENTRIES     : u64 = 64
  pub let NVME_ADMIN_SQE_SIZE       : u64 = 64
  pub let NVME_ADMIN_CQE_SIZE       : u64 = 16

  // ============================================================================
  // nvme_reg_u32 — 32-bit MMIO read from bar0 + offset
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64) -> u64
  //   rdi = BAR0 (MMIO base, page-aligned)
  //   rsi = register offset (NVME_REG_* constant)
  //
  // Returns rax = 32-bit register value, zero-extended to 64 bits per
  // SDM Vol 2A §3.4.1.1.
  //
  // Leaf function. mfence brackets the MMIO transaction.

  pub let nvme_reg_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M1-002 (#887). NVMe controller 32-bit MMIO read. Structural sibling to vtd_read_u32 (core/iommu/vtd_regs.pdx L140). rdi = BAR0 base (page-aligned per NVMe §3.1), rsi = register offset (NVME_REG_* constant). Body: (1) mfence — earlier WB stores retire before this UC MMIO transaction (SDM Vol 3A §11.3.1: WB→UC on same CPU is not TSO-ordered). (2) Compute effective address = base + offset. (3) mov eax, [rax] — 32-bit MMIO load; zero-extends into upper 32 bits of rax per SDM Vol 2A §3.4.1.1. (4) mfence — result must complete before downstream code observes side-effects. Leaf function, no prologue. NVMe registers CAP/CC/CSTS/AQA are naturally 4-byte-aligned so the load never straddles a UC line.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    }

  // ============================================================================
  // nvme_reg_write_u32 — 32-bit MMIO write to bar0 + offset
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64, val: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = register offset
  //   rdx = value (low 32 bits stored; high bits ignored)

  pub let nvme_reg_write_u32 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M1-002 (#887). NVMe controller 32-bit MMIO write. Structural sibling to vtd_write_u32 (core/iommu/vtd_regs.pdx L165). rdi = BAR0 base, rsi = register offset, rdx = value (low 32 bits stored). Body: (1) mfence — bracket earlier WB stores. (2) Compute effective address = base + offset. (3) mov_d [rax], rdx — 32-bit MMIO store (G1: sized-32-bit form; bare `mov [rax], rdx` widens to REX.W and writes 8 bytes into a 4-byte register slot, corrupting the neighbouring register slot). (4) mfence — value must publish before downstream observation. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_d [rax], rdx;
        mfence;
        ret
      }
    }

  // ============================================================================
  // nvme_reg_u64 — 64-bit MMIO read (CAP, ASQ, ACQ)
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = register offset (must be 8-byte-aligned per NVMe §3.1)
  //
  // Returns rax = 64-bit register value.

  pub let nvme_reg_u64 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M1-002 (#887). NVMe controller 64-bit MMIO read (CAP @ 0x00, ASQ @ 0x28, ACQ @ 0x30 — all naturally 8-byte-aligned per NVMe §3.1). Structural sibling to vtd_read_u64 (core/iommu/vtd_regs.pdx L191). Body: mfence / lea addr / mov rax, [addr] (plain 64-bit load; the destination *is* rax so no encoder-gap risk) / mfence. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov rax, [rax];
        mfence;
        ret
      }
    }

  // ============================================================================
  // nvme_reg_write_u64 — 64-bit MMIO write (ASQ, ACQ)
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64, val: u64) -> ()

  pub let nvme_reg_write_u64 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M1-002 (#887). NVMe controller 64-bit MMIO write (ASQ / ACQ programming during controller enable). Structural sibling to vtd_write_u64 (core/iommu/vtd_regs.pdx L212). Body: mfence / lea addr / mov [addr], rdx (plain 64-bit store — no G1 risk since the source is a 64-bit register and the intended store width is 8 bytes, matching REX.W) / mfence. Leaf function.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov [rax], rdx;
        mfence;
        ret
      }
    }
}
