// src/kernel/core/drivers/nvme/doorbell.pdx — R24-M3-003 (#896)
//
// NVMe doorbell writes — SQnTDBL and CQnHDBL — with strong memory
// ordering.
//
// -----------------------------------------------------------------------------
// Doorbell layout (NVMe Base Spec 2.0 §3.1.14)
// -----------------------------------------------------------------------------
//
// Doorbells begin at BAR0 + 0x1000. Stride is 2^(2 + CAP.DSTRD) bytes.
// For DSTRD=0 (every commodity NVMe controller) stride = 4.
//
//   SQ0TDBL  @ BAR0 + 0x1000 + (2 * 0)     * stride  =  BAR0 + 0x1000
//   CQ0HDBL  @ BAR0 + 0x1000 + (2 * 0 + 1) * stride  =  BAR0 + 0x1004
//   SQnTDBL  @ BAR0 + 0x1000 + (2 * n)     * stride
//   CQnHDBL  @ BAR0 + 0x1000 + (2 * n + 1) * stride
//
// -----------------------------------------------------------------------------
// Ordering discipline
// -----------------------------------------------------------------------------
//
// Both doorbell writers bracket the MMIO transaction with a full mfence
// on each side (SDM Vol 3A §11.3.1 — WB→UC transactions on the same CPU
// are NOT TSO-ordered):
//
//   (a) mfence-BEFORE: earlier WB stores that populate the SQ / consume
//       the CQ must retire before the controller observes the doorbell
//       value. Without this the controller may fetch a stale SQE (its
//       DMA read races the CPU's store buffer drain) or acknowledge a
//       CQE we have not yet consumed.
//   (b) mfence-AFTER: the doorbell write must publish before any
//       downstream code observes side-effects (e.g. re-reading the CQ
//       for the returned completion in poll mode).
//
// -----------------------------------------------------------------------------
// Stride sourcing
// -----------------------------------------------------------------------------
//
// R24.M3 re-reads CAP.DSTRD from BAR0 on every doorbell to keep the
// primitive stateless. Cost: two mfences + one 8-byte UC MMIO read =
// ~60 ns per doorbell — acceptable at M3 (whole path is dormant).
// A later pass may hoist the stride into an `_nvme_dbl_stride` cache
// alongside the admin ctx once the driver-attach path is wired.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: nvme_reg_write_u32 already uses mov_d internally.
//   G4: full-register compares; shift amount via cl for shl-by-DSTRD.
//
// Reserved-label discipline: labels prefixed `nvme_db_`.

module Doorbell = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let NVME_DBL_BASE_OFFSET  : u64 = 0x1000

  // ============================================================================
  // nvme_ring_sq(bar0, qid, sq_tail) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64, qid: u64, sq_tail: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = queue identifier (0 = admin, 1..NVME_IO_MAX_QUEUES = IO)
  //   rdx = new SQ tail pointer (u16 semantics)
  //
  // Body:
  //   (1) Read CAP (u64 @ bar0+0x00) → extract DSTRD (bits 35..32).
  //   (2) stride = 4 << DSTRD.
  //   (3) offset = NVME_DBL_BASE_OFFSET + (qid * 2) * stride.
  //   (4) mfence; nvme_reg_write_u32(bar0, offset, sq_tail); mfence.
  //
  // Register plan (3-push callee-save):
  //   rbx = bar0, rbp = qid, r12 = sq_tail
  //   3 pushes = 24 B; entry rsp%16==8 → 32, %16==0 (aligned for the
  //   two nested calls).

  pub let nvme_ring_sq : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, qid: u64, sq_tail: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M3-003 (#896). SQnTDBL doorbell write per NVMe §3.1.14 with mfence bracketing. Body: (1) 3-push callee-save prologue (rbx=bar0, rbp=qid, r12=sq_tail) — 24 B; entry rsp%16==8 → 32, %16==0 (aligned for nested calls). (2) nvme_reg_u64(bar0, 0x00) → rax = CAP. (3) Extract DSTRD = (CAP >> 32) & 0xF. (4) stride = 4 << DSTRD: mov rax, 4; mov rcx, r13; shl rax, cl. r13 briefly holds DSTRD for the shift-by-cl. (5) offset = 0x1000 + (qid * 2) * stride = 0x1000 + (qid << 1) * stride. Compute in rax: mov rax, rbp; shl rax, 1; imul rax by stride — but imul with 64-bit reg is `imul rdx, rax` two-operand form; paideia-as encoder support for imul is verified in phys_alloc.pdx / sched sites. Simpler: since stride is 4 for DSTRD=0 (universal in QEMU + all commodity NVMe), and higher DSTRD only shifts left by (DSTRD) more bits, we compute offset = 0x1000 + ((qid << 1) << (2 + DSTRD)). i.e. shl by (2 + DSTRD). This avoids the imul entirely — variable-count shl (`shl rax, cl`) is already proven encoder-safe in phys_alloc.pdx L85 and vector_pool.pdx L158. (6) Explicit mfence (before) — nvme_reg_write_u32 already emits its own mfence but a paired mfence at this level makes the ordering promise visible at the call site. (7) nvme_reg_write_u32(bar0=rbx, offset, sq_tail=r12). (8) Explicit mfence (after). (9) Return. Encoder: shr / and / shl-by-cl / add / mov / mfence / call — all pre-existing. Reserved labels: `nvme_db_`.",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = qid
        mov r12, rdx;                            // r12 = sq_tail

        // ================================================================
        // (2)-(3) Read CAP, extract DSTRD.
        // ================================================================
        mov rdi, rbx;
        xor rsi, rsi;                            // offset 0 = CAP
        call nvme_reg_u64;

        shr rax, 32;
        and rax, 0xF;                            // rax = DSTRD

        // ================================================================
        // (4)-(5) offset = 0x1000 + (qid << 1) << (2 + DSTRD).
        // ================================================================
        mov rcx, rax;                            // cl = DSTRD
        add rcx, 2;                              // cl = 2 + DSTRD (shift amount)

        mov rax, rbp;                            // rax = qid
        shl rax, 1;                              // rax = qid * 2
        shl rax, cl;                             // rax = (qid*2) << (2+DSTRD)

        add rax, 0x1000;                         // offset = 0x1000 + ...

        // ================================================================
        // (6) mfence-before + (7) write + (8) mfence-after.
        // ================================================================
        mfence;

        mov rdi, rbx;
        mov rsi, rax;                            // offset
        mov rdx, r12;                            // sq_tail
        call nvme_reg_write_u32;

        mfence;

        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // nvme_ring_cq(bar0, qid, cq_head) -> ()
  // ============================================================================
  //
  // Structural twin of nvme_ring_sq with offset = 0x1000 + (2*qid + 1) * stride.

  pub let nvme_ring_cq : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, qid: u64, cq_head: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R24-M3-003 (#896). CQnHDBL doorbell write per NVMe §3.1.14 with mfence bracketing. Same shape as nvme_ring_sq; only the queue-slot offset differs: (2*qid + 1) instead of (2*qid). Compute: (qid << 1) | 1 then shl by (2 + DSTRD). The `| 1` sets the odd-slot bit (CQ vs SQ) before the DSTRD scaling — mathematically identical to computing (2*qid + 1) * stride because stride >= 4 so the low bit falls above the CQ/SQ discriminator when shifted left by 2+DSTRD. Reserved labels: `nvme_db_`.",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = qid
        mov r12, rdx;                            // r12 = cq_head

        // Read CAP → DSTRD.
        mov rdi, rbx;
        xor rsi, rsi;
        call nvme_reg_u64;

        shr rax, 32;
        and rax, 0xF;                            // DSTRD

        mov rcx, rax;
        add rcx, 2;                              // shift = 2 + DSTRD

        mov rax, rbp;
        shl rax, 1;                              // qid * 2
        or  rax, 1;                              // (2*qid + 1)
        shl rax, cl;                             // scale by stride

        add rax, 0x1000;                         // offset

        mfence;

        mov rdi, rbx;
        mov rsi, rax;
        mov rdx, r12;
        call nvme_reg_write_u32;

        mfence;

        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
