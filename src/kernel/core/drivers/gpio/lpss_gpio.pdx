// src/kernel/core/drivers/gpio/lpss_gpio.pdx — R30.M6-002 (#1076)
//
// Intel LPSS / PCH pad-controller PCI probe, BAR-to-capability binding,
// identification, and the COMMUNITY (bank) table that turns an
// ACPI-visible pin number into a register address.
//
// =============================================================================
// WHY THIS FILE IS THE DANGEROUS ONE
// =============================================================================
//
// A pad controller owns every pin on the package. On a T14 G4 those pins
// include device reset lines, rail enables, write-protect straps and
// firmware-flash control. Driving one wrong is not a data-corruption bug
// — it holds a device in reset, or drops a rail, or defeats a strap, and
// it does so SILENTLY, because a pad controller has no notion of a
// transaction that can fail. There is no NACK, no arbitration loss, no
// status bit that says "that was the wrong pin". The pin simply becomes
// whatever the last writer made it.
//
// So the single most important property in this milestone is that a
// register address derived for pin P really is pin P's, and the two
// facts that make it easy to get wrong live here.
//
// =============================================================================
// PIN NUMBERING IS NOT PAD INDEXING
// =============================================================================
//
// Intel pad controllers organise pads into COMMUNITIES. Each community
// has its OWN register window inside the controller's BAR, and its own
// PADCFG region inside that window. Two consequences:
//
//   * the pin number the platform hands you is ABSOLUTE across the
//     controller, but the index used to compute a register address is
//     COMMUNITY-RELATIVE:
//
//         community  = the c with c.pin_base <= pin < c.pin_base + c.npins
//         pad_index  = pin - community.pin_base
//         reg offset = community.reg_off + community.padbar
//                        + pad_index * stride
//
//   * for the FIRST community, pin_base is 0 and pad_index == pin. The
//     mapping is the identity there and nowhere else.
//
// That last sentence is the whole trap. A driver that forgets the
// community term — or forgets to subtract pin_base — works perfectly on
// every pin of community 0 and drives the WRONG PIN on every pin of
// every other community, with no error anywhere. A test that only
// exercises community 0 cannot tell the two implementations apart. The
// witness therefore asserts the mapping OUTSIDE community 0, against an
// independently computed expected offset, and reads the resulting
// register through the seam so that "we computed the right number" and
// "we touched the right register" are both checked.
//
// =============================================================================
// THE GEOMETRY IS ASKED FOR AND MEASURED — IT IS NOT GUESSED
// =============================================================================
//
// Three facts define a community. They come from three different places
// and this file is careful about which is which:
//
//   1. THE COMMUNITY'S REGISTER WINDOW OFFSET, its pin base and its pad
//      count. These are NOT readable from the part. On a real machine
//      they come from the platform's description of the controller,
//      which for R30 is consumed by the userspace supervisor; there is
//      no register that reports them and no SoC table in this kernel
//      that could. They are therefore ARGUMENTS to
//      `lpss_gpio_add_community`, and that function's job is to refuse
//      every description that cannot be true.
//
//      A per-SoC device-ID-to-geometry table was considered and
//      rejected for the reason `lpss_probe.pdx` rejected a device-ID
//      table: it is a claim about which silicon exists, it is wrong the
//      moment a machine ships that its author had not seen, and its
//      failure mode here is far worse than a dead device — a stale
//      table does not fail to find a controller, it finds one and gives
//      it the WRONG PIN MAP.
//
//   2. THE PADCFG REGION OFFSET within the community window. This IS
//      readable: PADBAR at community + 0x0C. It is read rather than
//      assumed, which is the same discipline `lpss_probe.pdx` applied
//      to IC_COMP_TYPE — the part is the authority on itself.
//
//   3. THE PADCFG STRIDE. Also derivable from the part: REVID's
//      revision field selects four PADCFG registers per pad on modern
//      PCH silicon and two on older, so the stride is 16 or 8 bytes
//      rather than a constant somebody has to remember to update.
//
// =============================================================================
// IDENTIFICATION: THE LPSS CLASS CODE DOES NOT SAY WHICH BLOCK THIS IS
// =============================================================================
//
// The candidate filter is the same two class/subclass pairs
// `lpss_probe.pdx` uses, and it is the same filter ON PURPOSE: LPSS
// blocks present as (0x0C, 0x80) or (0x11, 0x80) regardless of whether
// they are an I²C controller, a UART or a pad controller. The class code
// cannot distinguish them, so stage 2 must, and stage 2 asks the part:
//
//   * A DesignWare I²C core reads back IC_COMP_TYPE = 0x44570140 at
//     BAR0 + 0xFC. If that constant is there, this is the OTHER LPSS
//     block and the candidate is rejected with its own code
//     (LPSS_GPIO_ID_IS_I2C). "We found the I²C controller while looking
//     for the pad controller" is precisely the sentence somebody
//     debugging a new machine needs to read, and collapsing it into a
//     generic "not recognised" would throw it away.
//   * REVID must be neither 0 nor all-ones. A window that reads
//     all-ones has nothing behind it; a window that reads all-zeros is
//     not answering either.
//   * PADBAR must be non-zero, 4-byte aligned, and inside the BAR. A
//     PADCFG region that starts outside the window is not a community,
//     and accepting it would produce pad addresses outside the
//     capability — refused, not clipped.
//
// =============================================================================
// THE BAR IS REACHED THROUGH A CAPABILITY
// =============================================================================
//
// The probe learns BAR0's physical base and length. It does not hand
// that address to anyone. `lpss_gpio_bind_window` mints a
// `KIND_OP_REGION` root over the caller's `KIND_MEMORY` authority
// covering exactly the recorded {base, len}, and records the resulting
// CAPABILITY SLOT. Everything downstream reaches registers only through
// `gpio_io_read32` / `gpio_io_write32`, which re-resolve that slot per
// access.
//
// The base and length passed to the mint are the ROW'S OWN — inherited
// from what the probe measured, never arguments. If a caller could
// supply the base, a holder of memory authority could mint itself a
// window over any physical address and call it a pad controller.
//
// =============================================================================
// CONTROLLER ROW — `_lpss_gpio_ctrl[idx]`, 64 bytes
// =============================================================================
//
//   [+0]  u64  hdr
//               [7:0]   in_use   (0 = free, 1 = allocated)
//               [15:8]  bus
//               [23:16] dev
//               [31:24] function
//               [47:32] segment
//               [55:48] intel    (1 = PCI vendor was 0x8086)
//               [63:56] ncomm    (communities described so far)
//   [+8]  u64  bar0_pa       — physical base measured at probe
//   [+16] u64  bar0_len      — window length granted to the capability
//   [+24] u64  window_slot   — cap slot holding the KIND_OP_REGION, or 0
//   [+32] u64  state         — LPSS_GPIO_STATE_*
//   [+40] u64  controller_id — bdf_pack key. THE JOIN between the
//                              hardware world and the capability world:
//                              a KIND_GPIO_LINE row records this value,
//                              inherited from its parent KIND_DEVICE
//                              descriptor's target_ptr, and it is the
//                              cascade key.
//   [+48] u64  revid         — as read at identification, 0 before
//   [+56] u64  padcfg_stride — 16 or 8, derived from revid, 0 before
//
// COMMUNITY ROW — `_lpss_gpio_comm[k]`, 32 bytes, FLAT across controllers
//
//   [+0]  u64  hdr: in_use[7:0] | ctrl_idx[15:8] | comm_id[23:16]
//   [+8]  u64  reg_off  — the community's window offset within BAR0
//   [+16] u64  padbar   — PADCFG region offset within the community
//                         window, READ FROM THE PART
//   [+24] u64  geom: pin_base[15:0] | npins[31:16]
//
// The tables have exactly one writer object, asserted by `objdump -r` in
// `tools/build.sh`. There is no allocation cursor: `lpss_gpio_record`
// scans for a free row and `lpss_gpio_ctrl_count` counts live ones, so
// the number of controllers is a property of the table rather than a
// second fact that can drift from it — which is what makes
// `lpss_gpio_release` possible without leaving a hole nobody can reuse.
//
// =============================================================================
// paideia-as posture
// =============================================================================
//
//   G1: sized stores (`mov_d` / `mov_w` / `mov_b`).
//   G4: full-register compares.
//   Reserved-label discipline: labels prefixed `lpg_`.

module LpssGpio = structure {

  // ==========================================================================
  // Candidate filter — deliberately identical to lpss_probe.pdx's.
  // ==========================================================================

  pub let LPSS_GPIO_CLASS_SERIAL_BUS : u64 = 0x0C
  pub let LPSS_GPIO_CLASS_SIGNAL     : u64 = 0x11
  pub let LPSS_GPIO_SUBCLASS_OTHER   : u64 = 0x80
  pub let LPSS_GPIO_VENDOR_INTEL     : u64 = 0x8086

  // ==========================================================================
  // Table geometry
  // ==========================================================================

  pub let LPSS_GPIO_MAX_CTRL   : u64 = 4
  pub let LPSS_GPIO_ROW_BYTES  : u64 = 64
  pub let LPSS_GPIO_MAX_COMM   : u64 = 16
  pub let LPSS_GPIO_COMM_BYTES : u64 = 32
  pub let LPSS_GPIO_NOT_FOUND  : u64 = 0xFFFFFFFFFFFFFFFF

  // The absolute pin-number space of one controller. 512 is comfortably
  // above the ~300 pads a client PCH carries and is the bound the tail
  // encoder's 16-bit pin field is checked against, so a pin that cannot
  // be represented is refused at the door rather than truncated into a
  // DIFFERENT, VALID pin number further in.
  pub let GPIO_PIN_MAX         : u64 = 512

  // The largest pad count one community may claim. Real communities run
  // to a few tens of pads; 128 is generous and its purpose is to make a
  // garbled description fail here instead of consuming the whole pin
  // space and swallowing every later community.
  pub let GPIO_COMM_MAX_PINS   : u64 = 128

  // A pad controller's register window is at least one page. A BAR
  // smaller than that is not this part.
  pub let GPIO_MIN_WINDOW      : u64 = 0x1000

  // ==========================================================================
  // Community-relative register offsets, and the I²C discriminator.
  // ==========================================================================

  pub let GPIO_REG_REVID   : u64 = 0x00
  pub let GPIO_REG_CAPLIST : u64 = 0x04
  pub let GPIO_REG_PADBAR  : u64 = 0x0C

  // The DesignWare I²C component-type constant, at BAR0 + 0xFC on every
  // instance ever synthesised. Used here NEGATIVELY: a candidate that
  // reads it back is the LPSS I²C block, not the pad controller.
  pub let DW_IC_COMP_TYPE_OFF : u64 = 0xFC
  pub let DW_IC_COMP_TYPE_VAL : u64 = 0x44570140

  // REVID[23:16] is the revision. At 0x94 and above the part carries
  // four PADCFG registers per pad; below it, two. Deriving the stride
  // from the part rather than fixing it as a constant is what keeps this
  // driver correct across a generation boundary without an edit.
  pub let GPIO_REVID_NREGS4_MIN  : u64 = 0x94
  pub let GPIO_PADCFG_STRIDE_4   : u64 = 16
  pub let GPIO_PADCFG_STRIDE_2   : u64 = 8

  // ==========================================================================
  // States
  // ==========================================================================

  pub let LPSS_GPIO_STATE_FREE       : u64 = 0
  pub let LPSS_GPIO_STATE_CANDIDATE  : u64 = 1   // class matched, BAR sized
  pub let LPSS_GPIO_STATE_WINDOWED   : u64 = 2   // window capability bound
  pub let LPSS_GPIO_STATE_IDENTIFIED : u64 = 3   // REVID + PADBAR confirmed
  pub let LPSS_GPIO_STATE_REJECTED   : u64 = 4   // stage 2 said no

  // ==========================================================================
  // Failure taxonomy — band 0xFFFFFF20..0xFFFFFF2F
  //
  // Disjoint from GPIO_IO_* (0xFFFFFF08..0F), GPIO_LINE_* (0xFFFFFF10..1F),
  // DW_IO_* (0xFFFFFF30..3F), LPSS_I2C_* (0xFFFFFF40..5F) and every other
  // kind's band. A probe refusal, a seam refusal and a capability
  // refusal must never be confusable.
  // ==========================================================================

  pub let LPSS_GPIO_OK                  : u64 = 0
  pub let LPSS_GPIO_PROBE_ENOSPC        : u64 = 0xFFFFFF2F
  pub let LPSS_GPIO_BAD_IDX             : u64 = 0xFFFFFF2E
  pub let LPSS_GPIO_PROBE_NO_BAR        : u64 = 0xFFFFFF2D
  pub let LPSS_GPIO_WIN_BAD_PARENT      : u64 = 0xFFFFFF2C
  pub let LPSS_GPIO_WIN_ALREADY         : u64 = 0xFFFFFF2B
  pub let LPSS_GPIO_ID_NOT_WINDOWED     : u64 = 0xFFFFFF2A
  pub let LPSS_GPIO_ID_IS_I2C           : u64 = 0xFFFFFF29
  pub let LPSS_GPIO_ID_NO_PART          : u64 = 0xFFFFFF28
  pub let LPSS_GPIO_ID_BAD_PADBAR       : u64 = 0xFFFFFF27
  pub let LPSS_GPIO_ID_ALREADY          : u64 = 0xFFFFFF26
  pub let LPSS_GPIO_COMM_NOT_IDENTIFIED : u64 = 0xFFFFFF25
  pub let LPSS_GPIO_COMM_ENOSPC         : u64 = 0xFFFFFF24
  pub let LPSS_GPIO_COMM_BAD_GEOM       : u64 = 0xFFFFFF23
  pub let LPSS_GPIO_COMM_OVERLAP        : u64 = 0xFFFFFF22
  pub let LPSS_GPIO_COMM_WINDOW         : u64 = 0xFFFFFF21
  pub let LPSS_GPIO_IO_FAULT            : u64 = 0xFFFFFF20

  // Mapping sentinels. Two of them, and the distinction is load-bearing:
  // "there is no such controller" and "that pin belongs to no community
  // of this controller" are different operator problems, and collapsing
  // them would make a mistyped controller id look like a pin that the
  // platform simply does not route.
  pub let GPIO_MAP_NO_CTRL  : u64 = 0xFFFFFFFFFFFFFFFE
  pub let GPIO_MAP_UNMAPPED : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Storage. Confined to this object; tools/build.sh asserts it.
  // ==========================================================================

  pub let mut _lpss_gpio_ctrl : [u64; 32] = uninit @align(64)
  pub let mut _lpss_gpio_comm : [u64; 64] = uninit @align(64)

  // Log tags.
  pub let lpg_tag_probe  : [u8; 16] = "LPSS GPIO PROBE\0"
  pub let lpg_tag_reject : [u8; 17] = "LPSS GPIO REJECT\0"
  pub let lpg_k_n        : [u8; 2]  = "n\0"
  pub let lpg_k_bdf      : [u8; 4]  = "bdf\0"

  // ==========================================================================
  // lpss_gpio_table_reset() -> ()
  // ==========================================================================

  pub let lpss_gpio_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): return the controller table AND the community table to empty -- all 32 + 64 qwords zeroed. Both, always, and never one without the other: a community row records its owning controller by INDEX, so a community table that outlived a controller reset would re-attach itself to whatever controller the next probe put in that slot, and the pin map of one part would then be applied to another. Zeroing whole rows rather than just the in_use byte is the scrub discipline #1070 established, and it matters here because a freed row that kept its bar0_pa would let a later bind_window mint a window over an address the current probe never measured. Leaf; two counted loops. Labels prefixed lpg_tr_.",
      block: {
        lea r10, [rip + _lpss_gpio_ctrl];
        xor rax, rax;
        xor rcx, rcx;
      lpg_tr_ctrl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  lpg_tr_ctrl;

        lea r10, [rip + _lpss_gpio_comm];
        xor rcx, rcx;
      lpg_tr_comm:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  lpg_tr_comm;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_row(idx) -> address of the row, or 0 when idx is out of
  // range or the row is free.
  // ==========================================================================

  pub let lpss_gpio_row : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): resolve a controller index to the address of its 64-byte row, or 0 for an out-of-range index or a free row. Every accessor and mutator in this file goes through it, so the bounds check and the liveness check exist once and cannot drift apart. Returning an ADDRESS is safe here and not in the capability kinds, because this table is confined to this object -- no other object can hold the pointer, since no other object may relocate against the symbol. Leaf. Labels prefixed lpg_row_.",
      block: {
        cmp rdi, 4;                      // LPSS_GPIO_MAX_CTRL
        jae lpg_row_none;
        mov rax, rdi;
        shl rax, 6;                      // * 64
        lea r10, [rip + _lpss_gpio_ctrl];
        add rax, r10;
        mov r11, [rax + 0];
        and r11, 0xFF;
        cmp r11, 0;
        je  lpg_row_none;
        ret;
      lpg_row_none:
        xor rax, rax;
        ret
      }
    }

  pub let lpss_gpio_ctrl_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): number of LIVE controller rows, counted from the table rather than read from a cursor. There is deliberately no allocation counter: a counter and a table are two places the same fact lives, and lpss_gpio_release frees a row in the middle, which a bump cursor could not express without either leaking the slot or letting the count disagree with the table. Leaf, pure read. Labels prefixed lpg_cc_.",
      block: {
        lea r10, [rip + _lpss_gpio_ctrl];
        xor rcx, rcx;
        xor rax, rax;
      lpg_cc_next:
        cmp rcx, 4;
        jae lpg_cc_done;
        mov r11, [r10 + 0];
        and r11, 0xFF;
        cmp r11, 0;
        je  lpg_cc_bump;
        add rax, 1;
      lpg_cc_bump:
        add r10, 64;
        add rcx, 1;
        jmp lpg_cc_next;
      lpg_cc_done:
        ret
      }
    }

  // ==========================================================================
  // Row field readers
  // ==========================================================================

  pub let lpss_gpio_ctrl_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the controller's bdf_pack key -- fn[7:0] | dev[15:8] | bus[23:16] | seg[39:24]. bdf_pack form specifically, and not the header's own field order, because this is the value a KIND_DEVICE descriptor's target_ptr carries and therefore the value kind_gpio_line.pdx INHERITS as controller_id. It is the join between the two worlds and it must be one encoding, not two that are almost the same. Stored at mint rather than recomputed from the header on every call, because it is read by the pin resolver on the mint path and a re-derivation is a second place the encoding could drift. Returns 0 for a dead row. One push (rbx) for the nested call. Labels prefixed lpg_id_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_id_out;
        mov rax, [rax + 40];
        pop rbx;
        ret;
      lpg_id_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_ctrl_intel : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): 1 iff the PCI vendor was 0x8086. Recorded at probe rather than assumed. Nothing in this milestone is gated on it; it is here because a non-Intel part answering the Intel identification sequence is a fact worth being able to see in a bug report, and adding the field later would mean re-probing. One push. Labels prefixed lpg_in_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_in_out;
        mov r10, [rax + 0];
        shr r10, 48;
        and r10, 0xFF;
        mov rax, r10;
        pop rbx;
        ret;
      lpg_in_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_ctrl_bar_base : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the BAR0 physical base measured at probe. Read by lpss_gpio_bind_window and by the witness; NOT read by any access path -- the access path resolves the window capability instead, and this value exists so the mint can INHERIT rather than be argued. One push. Labels prefixed lpg_bb_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_bb_out;
        mov rax, [rax + 8];
        pop rbx;
        ret;
      lpg_bb_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_ctrl_bar_len : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the window length the probe will grant the capability, and the bound every community's register extent is checked against. One push. Labels prefixed lpg_bl_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_bl_out;
        mov rax, [rax + 16];
        pop rbx;
        ret;
      lpg_bl_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_ctrl_window : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the cap slot holding this controller's KIND_OP_REGION window, or 0 when unbound. One push. Labels prefixed lpg_win_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_win_out;
        mov rax, [rax + 24];
        pop rbx;
        ret;
      lpg_win_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_ctrl_state : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the controller's bring-up state. LPSS_GPIO_STATE_FREE for an out-of-range index or a free row, which is the honest answer: nothing is there. One push. Labels prefixed lpg_st_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_st_free;
        mov rax, [rax + 32];
        pop rbx;
        ret;
      lpg_st_free:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_ctrl_revid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): REVID as read at identification, 0 before. Recorded rather than re-read because it is the input to the stride decision, and 'which revision did we decide against' must be answerable after the fact -- a stride that is wrong by a factor of two puts every pad access on the wrong pad and the only evidence would be this number. One push. Labels prefixed lpg_rv_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_rv_out;
        mov rax, [rax + 48];
        pop rbx;
        ret;
      lpg_rv_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_ctrl_stride : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): bytes between one pad's PADCFG0 and the next's -- 16 on parts whose REVID revision is 0x94 or above, 8 below. 0 before identification, which is why lpss_gpio_add_community refuses on an unidentified controller: a community admitted with a zero stride would map every pad in it to the SAME register. One push. Labels prefixed lpg_sd_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_sd_out;
        mov rax, [rax + 56];
        pop rbx;
        ret;
      lpg_sd_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_comm_count : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): how many communities have been described for this controller, from header bits [63:56]. One push. Labels prefixed lpg_nc_.",
      block: {
        push rbx;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_nc_out;
        mov rax, [rax + 0];
        shr rax, 56;
        and rax, 0xFF;
        pop rbx;
        ret;
      lpg_nc_out:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_find_by_ctrl_id(controller_id) -> idx | LPSS_GPIO_NOT_FOUND
  // ==========================================================================

  pub let lpss_gpio_find_by_ctrl_id : (u64) -> u64 !{mem} @{} =
    fn (controller_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the controller index for a bdf_pack key, or LPSS_GPIO_NOT_FOUND. This is the lookup the KIND_GPIO_LINE mint performs on the identity it INHERITED from its parent KIND_DEVICE descriptor, which is what turns 'holds a device capability with MINT' into 'holds the device capability of a probed pad controller' -- a KIND_DEVICE for the network card passes the kind check and fails here. A zero key is refused up front rather than matched: a dead row reads back zero and matching it would hand every unprobed slot to the first caller. Linear over four rows, indexless because an index would be a second place the mapping lives. Leaf. Labels prefixed lpg_fb_.",
      block: {
        cmp rdi, 0;
        je  lpg_fb_miss;

        lea r10, [rip + _lpss_gpio_ctrl];
        xor rcx, rcx;
      lpg_fb_next:
        cmp rcx, 4;
        jae lpg_fb_miss;
        mov rax, rcx;
        shl rax, 6;
        add rax, r10;
        mov r9, [rax + 0];
        and r9, 0xFF;
        cmp r9, 0;
        je  lpg_fb_bump;
        mov r9, [rax + 40];
        cmp r9, rdi;
        je  lpg_fb_hit;
      lpg_fb_bump:
        add rcx, 1;
        jmp lpg_fb_next;
      lpg_fb_hit:
        mov rax, rcx;
        ret;
      lpg_fb_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Community table accessors.
  //
  // lpss_gpio_comm_row(ctrl_idx, comm_id) -> address | 0
  // ==========================================================================

  pub let lpss_gpio_comm_row : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_idx: u64, comm_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): resolve (controller index, community id) to the address of the 32-byte community row, or 0 if no live row matches. The community table is FLAT across controllers rather than a per-controller array, and the row carries its owner: a two-dimensional array would fix a per-controller community budget at compile time, and the real distribution is lopsided -- one controller with five communities and another with one is ordinary. A flat table with an owner field spends the budget where the machine needs it. Linear over sixteen rows. Leaf. Labels prefixed lpg_cr_.",
      block: {
        lea r10, [rip + _lpss_gpio_comm];
        xor rcx, rcx;
      lpg_cr_next:
        cmp rcx, 16;
        jae lpg_cr_none;
        mov rax, rcx;
        shl rax, 5;                      // * 32
        add rax, r10;
        mov r9, [rax + 0];
        mov r11, r9;
        and r11, 0xFF;
        cmp r11, 0;
        je  lpg_cr_bump;
        mov r11, r9;
        shr r11, 8;
        and r11, 0xFF;
        cmp r11, rdi;
        jne lpg_cr_bump;
        mov r11, r9;
        shr r11, 16;
        and r11, 0xFF;
        cmp r11, rsi;
        je  lpg_cr_hit;
      lpg_cr_bump:
        add rcx, 1;
        jmp lpg_cr_next;
      lpg_cr_hit:
        ret;
      lpg_cr_none:
        xor rax, rax;
        ret
      }
    }

  pub let lpss_gpio_comm_reg_off : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_idx: u64, comm_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the community's register-window offset within BAR0, or GPIO_MAP_UNMAPPED for an unknown community. Never a plausible zero for a missing community: zero is community 0's ordinary offset on every Intel part, so returning it for 'no such community' would hand back a real address for a thing that does not exist. One push. Labels prefixed lpg_cro_.",
      block: {
        push rbx;
        call lpss_gpio_comm_row;
        cmp rax, 0;
        je  lpg_cro_none;
        mov rax, [rax + 8];
        pop rbx;
        ret;
      lpg_cro_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_comm_padbar : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_idx: u64, comm_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the PADCFG region offset within the community window, AS READ FROM THE PART at description time. GPIO_MAP_UNMAPPED for an unknown community. One push. Labels prefixed lpg_cpb_.",
      block: {
        push rbx;
        call lpss_gpio_comm_row;
        cmp rax, 0;
        je  lpg_cpb_none;
        mov rax, [rax + 16];
        pop rbx;
        ret;
      lpg_cpb_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_comm_pin_base : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_idx: u64, comm_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the first ABSOLUTE pin number this community owns. This is the number the whole milestone turns on: pad_index = pin - pin_base, and it is 0 for community 0 and non-zero for every other, which is why an implementation that never subtracts it is correct on community 0 and wrong everywhere else. GPIO_MAP_UNMAPPED for an unknown community. One push. Labels prefixed lpg_cpn_.",
      block: {
        push rbx;
        call lpss_gpio_comm_row;
        cmp rax, 0;
        je  lpg_cpn_none;
        mov rax, [rax + 24];
        mov r10, 0xFFFF;
        and rax, r10;
        pop rbx;
        ret;
      lpg_cpn_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let lpss_gpio_comm_npins : (u64, u64) -> u64 !{mem} @{} =
    fn (ctrl_idx: u64, comm_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): how many pads this community owns. GPIO_MAP_UNMAPPED for an unknown community; never 0, which would read as an empty-but-present community and make an out-of-range pad look like an out-of-range community. One push. Labels prefixed lpg_cnp_.",
      block: {
        push rbx;
        call lpss_gpio_comm_row;
        cmp rax, 0;
        je  lpg_cnp_none;
        mov rax, [rax + 24];
        shr rax, 16;
        mov r10, 0xFFFF;
        and rax, r10;
        pop rbx;
        ret;
      lpg_cnp_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_add_community(ctrl_idx, reg_off, pin_base, npins)
  //   -> comm_id | error
  //
  // THE ONLY WRITER OF _lpss_gpio_comm, and therefore the only place a
  // pin map comes into existence. Every refusal below is a description
  // that could not be true, and every one of them is a REFUSAL rather
  // than a repair.
  // ==========================================================================

  pub let lpss_gpio_add_community : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (ctrl_idx: u64, reg_off: u64, pin_base: u64, npins: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-002 (#1076): describe one community of a probed, identified pad controller, and MEASURE the half of its geometry the part reports. Gates, in order, each with its own code because each is a different operator problem. (1) Controller live and state == IDENTIFIED, else LPSS_GPIO_COMM_NOT_IDENTIFIED: an unidentified controller has stride 0 and a community admitted against it would map every pad in it to the same register. (2) npins in 1..GPIO_COMM_MAX_PINS and pin_base + npins <= GPIO_PIN_MAX, else LPSS_GPIO_COMM_BAD_GEOM -- a community whose pin range leaves the representable pin space would produce line capabilities whose recorded pin is not the pin asked for. (3) NO OVERLAP with any community already described for THIS controller, else LPSS_GPIO_COMM_OVERLAP. Overlap is refused rather than resolved by first-match because an overlapping description means one absolute pin has two register addresses, and picking either silently is how a driver comes to drive a pin it did not mean to. Note that overlap is checked per CONTROLLER, not globally: two controllers each numbering their pins from 0 is the ordinary case and a global check would refuse the second machine-wide. ORDERING is deliberately NOT required -- a description that lists communities out of pin order is unusual but not wrong, and refusing it would be an unnecessary failure of exactly the kind #1071 declined to make when it scoped the I2C address key to the bus. (4) READ REVID at reg_off + 0x00 through the seam; 0 or all-ones -> LPSS_GPIO_ID_NO_PART, because a community window with nothing behind it is a described community that does not exist. (5) READ PADBAR at reg_off + 0x0C; zero, not 4-byte aligned, or reg_off+padbar outside the BAR -> LPSS_GPIO_ID_BAD_PADBAR. PADBAR is READ rather than assumed for the reason IC_COMP_TYPE is read in lpss_probe.pdx: the part is the authority on itself, and a hardcoded PADCFG offset is a per-SoC table wearing a different hat. (6) The community's full register extent, reg_off + padbar + npins*stride, must fit inside bar0_len, else LPSS_GPIO_COMM_WINDOW. Refused, not clipped: a clipped community would have pads whose registers fall outside the capability, and every access to them would be refused by the seam with a range error naming the wrong problem. (7) Allocate the first free community row; exhaustion -> LPSS_GPIO_COMM_ENOSPC. (8) Bump the controller's ncomm and return the new community id, which is the ordinal within this controller. Six-push prologue (48 B) + sub rsp, 24 -> entry 8 + 72 = 80, rsp%16 == 0 at every nested call. Frame: [rsp+0] padbar, [rsp+8] row address of the controller, [rsp+16] scratch. Labels prefixed lpg_ac_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov r12, rdi;                    // ctrl_idx
        mov r13, rsi;                    // reg_off
        mov r14, rdx;                    // pin_base
        mov r15, rcx;                    // npins

        // --- (1) controller live and identified ---
        mov rdi, r12;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_ac_notid;
        mov [rsp + 8], rax;
        mov rbx, rax;                    // controller row address
        mov rax, [rbx + 32];
        cmp rax, 3;                      // LPSS_GPIO_STATE_IDENTIFIED
        jne lpg_ac_notid;

        // --- (2) geometry sanity ---
        cmp r15, 0;
        je  lpg_ac_badgeom;
        mov r10, 128;                    // GPIO_COMM_MAX_PINS
        cmp r15, r10;
        ja  lpg_ac_badgeom;
        mov rax, r14;
        add rax, r15;
        mov r10, 512;                    // GPIO_PIN_MAX
        cmp rax, r10;
        ja  lpg_ac_badgeom;

        // --- (3) no overlap with this controller's existing communities ---
        //
        // Overlap iff  pin_base < other.end  AND  other.pin_base < end.
        lea r10, [rip + _lpss_gpio_comm];
        xor rcx, rcx;
      lpg_ac_ovl:
        cmp rcx, 16;
        jae lpg_ac_ovl_done;
        mov rax, rcx;
        shl rax, 5;
        add rax, r10;
        mov r9, [rax + 0];
        mov r11, r9;
        and r11, 0xFF;
        cmp r11, 0;
        je  lpg_ac_ovl_next;
        mov r11, r9;
        shr r11, 8;
        and r11, 0xFF;
        cmp r11, r12;                    // same controller?
        jne lpg_ac_ovl_next;

        mov r9, [rax + 24];
        mov r11, r9;
        mov rax, 0xFFFF;
        and r11, rax;                    // other.pin_base
        shr r9, 16;
        and r9, rax;                     // other.npins
        add r9, r11;                     // other.end

        cmp r14, r9;                     // pin_base < other.end ?
        jae lpg_ac_ovl_next;
        mov rax, r14;
        add rax, r15;                    // end
        cmp r11, rax;                    // other.pin_base < end ?
        jae lpg_ac_ovl_next;
        jmp lpg_ac_overlap;

      lpg_ac_ovl_next:
        add rcx, 1;
        lea r10, [rip + _lpss_gpio_comm];
        jmp lpg_ac_ovl;

      lpg_ac_ovl_done:
        // --- (4) REVID must answer ---
        mov rdi, r13;                    // reg_off + GPIO_REG_REVID (0x00)
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  lpg_ac_iofault;
        cmp rax, 0;
        je  lpg_ac_nopart;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je  lpg_ac_nopart;

        // --- (5) PADBAR, read from the part ---
        mov rdi, r13;
        add rdi, 0x0C;                   // GPIO_REG_PADBAR
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  lpg_ac_iofault;
        cmp rax, 0;
        je  lpg_ac_badpadbar;
        mov r10, rax;
        and r10, 3;
        cmp r10, 0;
        jne lpg_ac_badpadbar;             // not 4-byte aligned
        mov [rsp + 0], rax;               // padbar

        mov rbx, [rsp + 8];
        mov r10, [rbx + 16];              // bar0_len
        mov r11, r13;
        add r11, rax;                     // reg_off + padbar
        cmp r11, r10;
        jae lpg_ac_badpadbar;

        // --- (6) the whole PADCFG extent must fit in the window ---
        mov rax, [rbx + 56];              // stride
        mov r9, r15;                      // npins
      lpg_ac_mul:
        // npins * stride, formed by repeated addition of `stride`
        // because the encoder has no general 64x64 multiply form and
        // npins is bounded by 128. r11 already holds reg_off + padbar.
        cmp r9, 0;
        je  lpg_ac_mul_done;
        add r11, rax;
        sub r9, 1;
        jmp lpg_ac_mul;
      lpg_ac_mul_done:
        cmp r11, r10;
        ja  lpg_ac_window;

        // --- (7) allocate a community row ---
        lea r10, [rip + _lpss_gpio_comm];
        xor rcx, rcx;
      lpg_ac_scan:
        cmp rcx, 16;
        jae lpg_ac_enospc;
        mov rax, rcx;
        shl rax, 5;
        add rax, r10;
        mov r9, [rax + 0];
        and r9, 0xFF;
        cmp r9, 0;
        je  lpg_ac_found;
        add rcx, 1;
        jmp lpg_ac_scan;

      lpg_ac_found:
        mov rbx, [rsp + 8];
        mov r9, [rbx + 0];
        shr r9, 56;
        and r9, 0xFF;                    // comm_id = current ncomm
        mov [rsp + 16], r9;

        // hdr = 1 | ctrl_idx << 8 | comm_id << 16
        mov r11, 1;
        mov rcx, r12;
        and rcx, 0xFF;
        shl rcx, 8;
        or  r11, rcx;
        mov rcx, r9;
        and rcx, 0xFF;
        shl rcx, 16;
        or  r11, rcx;
        mov [rax + 0], r11;

        mov [rax + 8], r13;              // reg_off
        mov r11, [rsp + 0];
        mov [rax + 16], r11;             // padbar

        mov r11, r14;
        mov rcx, 0xFFFF;
        and r11, rcx;
        mov r9, r15;
        and r9, rcx;
        shl r9, 16;
        or  r11, r9;
        mov [rax + 24], r11;             // geom

        // --- (8) bump ncomm ---
        mov r9, [rbx + 0];
        mov r11, r9;
        shr r11, 56;
        and r11, 0xFF;
        add r11, 1;
        mov rcx, 0x00FFFFFFFFFFFFFF;
        and r9, rcx;
        shl r11, 56;
        or  r9, r11;
        mov [rbx + 0], r9;

        mov rax, [rsp + 16];
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      lpg_ac_notid:
        mov rax, 0xFFFFFF25;             // LPSS_GPIO_COMM_NOT_IDENTIFIED
        jmp lpg_ac_out;
      lpg_ac_badgeom:
        mov rax, 0xFFFFFF23;             // LPSS_GPIO_COMM_BAD_GEOM
        jmp lpg_ac_out;
      lpg_ac_overlap:
        mov rax, 0xFFFFFF22;             // LPSS_GPIO_COMM_OVERLAP
        jmp lpg_ac_out;
      lpg_ac_nopart:
        mov rax, 0xFFFFFF28;             // LPSS_GPIO_ID_NO_PART
        jmp lpg_ac_out;
      lpg_ac_badpadbar:
        mov rax, 0xFFFFFF27;             // LPSS_GPIO_ID_BAD_PADBAR
        jmp lpg_ac_out;
      lpg_ac_window:
        mov rax, 0xFFFFFF21;             // LPSS_GPIO_COMM_WINDOW
        jmp lpg_ac_out;
      lpg_ac_enospc:
        mov rax, 0xFFFFFF24;             // LPSS_GPIO_COMM_ENOSPC
        jmp lpg_ac_out;
      lpg_ac_iofault:
        mov rax, 0xFFFFFF20;             // LPSS_GPIO_IO_FAULT

      lpg_ac_out:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_resolve_pin(controller_id, pin)
  //   -> (community << 16) | pad_index
  //   |  GPIO_MAP_NO_CTRL | GPIO_MAP_UNMAPPED
  //
  // THE MAPPING. The one function in the kernel that turns an absolute
  // pin number into a community and a community-relative pad index.
  // ==========================================================================

  pub let lpss_gpio_resolve_pin : (u64, u64) -> u64 !{mem} @{} =
    fn (controller_id: u64, pin: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): map an ABSOLUTE pin number on a named controller to the (community, pad_index) pair its registers actually live at. Returns the two packed as community<<16 | pad_index, which keeps the pair indivisible -- a caller that received them as two separate answers could mix a community from one resolution with a pad index from another, and the result would be a valid-looking address for a pin nobody asked about. GPIO_MAP_NO_CTRL when the key names no probed controller, GPIO_MAP_UNMAPPED when it names one but no community of it covers the pin: two sentinels, because 'the wrong controller' and 'a pin this part does not route' are different problems and a single sentinel would make the first look like the second. NEITHER is a clamp. A clamp would pick SOME pin -- and on this part some pin is a device reset or a rail enable, so returning a nearby pin is categorically worse than returning nothing. pad_index = pin - community.pin_base, and that subtraction is the entire content of this function: it is the identity for community 0 and it is not the identity anywhere else, which is why an implementation that omits it passes every test written against community 0. Three pushes (rbx, r12, r13) leave rsp%16 == 0 at the nested call. Labels prefixed lpg_rp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rsi;                    // pin

        call lpss_gpio_find_by_ctrl_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  lpg_rp_noctrl;
        mov r13, rax;                    // ctrl_idx

        lea r10, [rip + _lpss_gpio_comm];
        xor rcx, rcx;
      lpg_rp_next:
        cmp rcx, 16;
        jae lpg_rp_unmapped;
        mov rax, rcx;
        shl rax, 5;
        add rax, r10;
        mov r9, [rax + 0];
        mov r11, r9;
        and r11, 0xFF;
        cmp r11, 0;
        je  lpg_rp_bump;
        mov r11, r9;
        shr r11, 8;
        and r11, 0xFF;
        cmp r11, r13;
        jne lpg_rp_bump;

        // geom: pin_base[15:0] | npins[31:16]
        mov r9, [rax + 24];
        mov rbx, r9;
        mov r11, 0xFFFF;
        and rbx, r11;                    // pin_base
        shr r9, 16;
        and r9, r11;                     // npins

        cmp r12, rbx;
        jb  lpg_rp_bump;                 // below this community
        mov r11, rbx;
        add r11, r9;
        cmp r12, r11;
        jae lpg_rp_bump;                 // at or past its end

        // Hit. community id from the header, pad = pin - pin_base.
        mov r11, [rax + 0];
        shr r11, 16;
        and r11, 0xFF;                   // community id
        shl r11, 16;
        mov rax, r12;
        sub rax, rbx;                    // pad_index
        or  rax, r11;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpg_rp_bump:
        add rcx, 1;
        lea r10, [rip + _lpss_gpio_comm];
        jmp lpg_rp_next;

      lpg_rp_unmapped:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // GPIO_MAP_UNMAPPED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpg_rp_noctrl:
        mov rax, 0xFFFFFFFFFFFFFFFE;     // GPIO_MAP_NO_CTRL
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_pad_off(controller_id, community, pad_index)
  //   -> byte offset of PADCFG0 within BAR0 | GPIO_MAP_UNMAPPED
  //
  // The OTHER half of the mapping, and the function that would be a hole
  // if anything could call it with numbers a caller chose. It is
  // confined by tools/build.sh to this object and to
  // core/cap/kind_gpio_line.o, so the only way any driver reaches a pad
  // address is gpio_line_pad_off_of_slot(slot) — arity one, capability
  // in, address out.
  // ==========================================================================

  pub let lpss_gpio_pad_off : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (controller_id: u64, community: u64, pad_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the byte offset of PADCFG0 for one pad, measured from BAR0. offset = community.reg_off + community.padbar + pad_index * controller.stride. Every term is read from the tables and none is a constant: reg_off and pin_base come from the platform description, padbar and stride were read from the part at description time, and the pad index came from a capability row. GPIO_MAP_UNMAPPED for an unknown controller, an unknown community, or a pad_index at or beyond the community's pad count -- the last of those REFUSED rather than wrapped, because a wrapped index lands on a real register belonging to a real pin. The multiply is repeated addition bounded by GPIO_COMM_MAX_PINS, the same shape lpss_gpio_add_community uses, because the encoder has no general 64x64 multiply form and a shift would hardcode one of the two strides. Four pushes plus a nested call would misalign; five (rbx, r12-r15) leave rsp%16 == 0. Labels prefixed lpg_po_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r13, rsi;                    // community
        mov r14, rdx;                    // pad_index

        call lpss_gpio_find_by_ctrl_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  lpg_po_none;
        mov r12, rax;                    // ctrl_idx

        mov rdi, r12;
        mov rsi, r13;
        call lpss_gpio_comm_row;
        cmp rax, 0;
        je  lpg_po_none;
        mov rbx, rax;                    // community row

        // pad_index must be inside the community.
        mov r9, [rbx + 24];
        shr r9, 16;
        mov r11, 0xFFFF;
        and r9, r11;                     // npins
        cmp r14, r9;
        jae lpg_po_none;

        mov rdi, r12;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_po_none;
        mov r15, [rax + 56];             // stride
        cmp r15, 0;
        je  lpg_po_none;

        mov r10, [rbx + 8];              // reg_off
        mov r11, [rbx + 16];             // padbar
        add r10, r11;

        mov r9, r14;                     // pad_index
      lpg_po_mul:
        cmp r9, 0;
        je  lpg_po_done;
        add r10, r15;
        sub r9, 1;
        jmp lpg_po_mul;

      lpg_po_done:
        mov rax, r10;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpg_po_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // GPIO_MAP_UNMAPPED
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_bar0(seg, bus, dev, fn, out) -> rc
  //
  // BAR0 discovery with the memory decoder correctly disabled across the
  // sizing write. `out` is a 32-byte bar_info buffer.
  // ==========================================================================

  pub let lpss_gpio_bar0 : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (seg: u64, bus: u64, dev: u64, fnid: u64, out: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M6-002 (#1076): size and decode BAR0 with the memory decoder disabled across the sizing write. Sequence: read COMMAND (config +0x04) and save it; write it back with bit 1 (memory space enable) cleared; pci_bar_size; read BAR0 low (+0x10) and high (+0x14); RESTORE the original COMMAND word; then decode. The disable is not ceremony -- pci_bar_size works by writing all-ones into the BAR, and a decoder left enabled across that write has the function claiming a window at 0xFFFFF000 for its duration, on top of whatever else is up there. The restore happens BEFORE any refusal path so a rejected BAR cannot leave the decoder off, which would take the device away from firmware as well as from us. Refusals: size 0, a BAR that is not MEM32/MEM64, or a decoded length below GPIO_MIN_WINDOW. The length check is a REFUSAL and not a clamp: a window shorter than a page means the BAR was misread or the part is not a pad controller, and both deserve to stop here rather than produce a capability that covers part of one. Six-push callee-save prologue (48 B), entry rsp%16 == 8 -> 56, sub rsp, 24 -> 80, %16 == 0 at every nested call. Scratch: [rsp+0] size, [rsp+8] bar_lo, [rsp+16] bar_hi. Labels prefixed lpg_bar_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        mov rbx, rdi;                    // seg
        mov rbp, rsi;                    // bus
        mov r12, rdx;                    // dev
        mov r13, rcx;                    // fn
        mov r14, r8;                     // out

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  0x04;
        call pci_config_read_u32;
        mov r15, rax;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  0x04;
        mov r9,  r15;
        mov r10, 0xFFFFFFFD;
        and r9,  r10;
        call pci_config_write_u32;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  0;
        call pci_bar_size;
        mov [rsp + 0], rax;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  0x10;
        call pci_config_read_u32;
        mov [rsp + 8], rax;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  0x14;
        call pci_config_read_u32;
        mov [rsp + 16], rax;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  0x04;
        mov r9,  r15;
        call pci_config_write_u32;

        mov rax, [rsp + 0];
        cmp rax, 0;
        je  lpg_bar_none;

        mov rdi, [rsp + 8];
        mov rsi, [rsp + 16];
        mov rdx, [rsp + 0];
        mov rcx, r14;
        call pci_bar_decode;

        xor rax, rax;
        mov_b rax, [r14 + 16];
        cmp rax, 2;
        jb  lpg_bar_none;
        cmp rax, 3;
        ja  lpg_bar_none;

        mov rax, [r14 + 8];
        mov r10, 0x1000;                 // GPIO_MIN_WINDOW
        cmp rax, r10;
        jb  lpg_bar_none;

        xor rax, rax;
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      lpg_bar_none:
        mov rax, 0xFFFFFF2D;             // LPSS_GPIO_PROBE_NO_BAR
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_record(bdf_key, intel, bar_pa, bar_len) -> idx | error
  //
  // THE ROW ALLOCATOR. Exported for the reason lpss_i2c_record is: the
  // boot witness must allocate rows through the SAME allocator the probe
  // uses, because a fixture that builds rows a different way tests a
  // shape the machine never has. A controller row confers NO REACH — it
  // records a BDF and a measured extent, and nothing in the access path
  // reads bar0_pa. The only thing that turns an extent into the ability
  // to touch memory is lpss_gpio_bind_window, which is gated on a
  // KIND_MEMORY capability carrying RIGHT_MINT.
  // ==========================================================================

  pub let lpss_gpio_record : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (bdf_key: u64, intel: u64, bar_pa: u64, bar_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): allocate one controller row from a bdf_pack key, the Intel-wrapper flag and a measured BAR extent. Refuses a zero key (a row whose controller_id is zero could never be found by lpss_gpio_find_by_ctrl_id, which treats zero as 'no controller', so the row would be permanently unreachable) and a window below GPIO_MIN_WINDOW, both as LPSS_GPIO_PROBE_NO_BAR. Scans for the FIRST FREE ROW rather than bumping a cursor, which is what lets lpss_gpio_release free a row in the middle without leaking the slot; exhaustion -> LPSS_GPIO_PROBE_ENOSPC. Stores the bdf key BOTH decomposed into the header (for the reject log line, which wants readable b/d/f) and whole at [+40] as controller_id (for the capability join, which wants the exact encoding a KIND_DEVICE target_ptr carries). Keeping the two distinct and converting once here is better than a header that is 'almost' a bdf key and gets read as one by mistake. Rows start CANDIDATE with no window, no revid and no stride, because every one of those is a later, separately gated step. Leaf; no nested calls. Labels prefixed lpg_rec_.",
      block: {
        cmp rdi, 0;
        je  lpg_rec_nobar;
        mov r10, 0x1000;                 // GPIO_MIN_WINDOW
        cmp rcx, r10;
        jb  lpg_rec_nobar;

        lea r10, [rip + _lpss_gpio_ctrl];
        xor r11, r11;
      lpg_rec_scan:
        cmp r11, 4;                      // LPSS_GPIO_MAX_CTRL
        jae lpg_rec_enospc;
        mov rax, r11;
        shl rax, 6;
        add rax, r10;
        mov r9, [rax + 0];
        and r9, 0xFF;
        cmp r9, 0;
        je  lpg_rec_found;
        add r11, 1;
        jmp lpg_rec_scan;

      lpg_rec_found:
        mov r9, rax;                     // row address

        // hdr = in_use | bus<<8 | dev<<16 | fn<<24 | seg<<32 | intel<<48
        mov rax, 1;
        mov r8, rdi;
        shr r8, 16;
        and r8, 0xFF;
        shl r8, 8;                       // bus
        or  rax, r8;
        mov r8, rdi;
        shr r8, 8;
        and r8, 0xFF;
        shl r8, 16;                      // dev
        or  rax, r8;
        mov r8, rdi;
        and r8, 0xFF;
        shl r8, 24;                      // fn
        or  rax, r8;
        mov r8, rdi;
        shr r8, 24;
        mov r10, 0xFFFF;
        and r8, r10;
        shl r8, 32;                      // seg
        or  rax, r8;
        mov r8, rsi;
        and r8, 0xFF;
        shl r8, 48;                      // intel
        or  rax, r8;
        mov [r9 + 0], rax;               // ncomm left zero

        mov [r9 + 8],  rdx;              // bar0_pa
        mov [r9 + 16], rcx;              // bar0_len
        xor rax, rax;
        mov [r9 + 24], rax;              // window_slot
        mov rax, 1;                      // LPSS_GPIO_STATE_CANDIDATE
        mov [r9 + 32], rax;
        mov [r9 + 40], rdi;              // controller_id
        xor rax, rax;
        mov [r9 + 48], rax;              // revid
        mov [r9 + 56], rax;              // padcfg_stride

        mov rax, r11;                    // idx
        ret;

      lpg_rec_nobar:
        mov rax, 0xFFFFFF2D;             // LPSS_GPIO_PROBE_NO_BAR
        ret;
      lpg_rec_enospc:
        mov rax, 0xFFFFFF2F;             // LPSS_GPIO_PROBE_ENOSPC
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_bind_window(idx, mem_parent_slot, win_slot, rights) -> rc
  // ==========================================================================

  pub let lpss_gpio_bind_window : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (idx: u64, mem_parent_slot: u64, win_slot: u64, rights: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): turn a measured BAR into a capability. Calls opregion_cap_mint_root(win_slot, mem_parent_slot, rights, OPREG_SPACE_PCI_BAR = 0x06, base, len) where BASE AND LEN ARE THE ROW'S OWN -- inherited from what the probe measured, not arguments. If the caller supplied the base, a holder of memory authority could mint itself a window over any physical address and call it a pad controller, which is the class of bug KIND_OP_REGION exists to remove, reintroduced by its own client. Space 0x06 is memory-like per opregion_space_base_kind, so the mint demands a KIND_MEMORY (4) parent carrying RIGHT_MINT and refuses anything else. The op-region refusal is mapped to LPSS_GPIO_WIN_BAD_PARENT rather than passed through, because a caller here is debugging driver wiring and wants 'the window mint was refused', with the op-region band's own code already in the audit record the mint wrapper emitted. Refuses LPSS_GPIO_WIN_ALREADY on a row that already has a window: re-binding would leave the previous capability live and pointing at the same registers, i.e. two authorities over every pin on the package with no revoke relationship between them. On success the state advances CANDIDATE -> WINDOWED. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed lpg_bw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // idx
        mov r13, rsi;                    // mem parent slot
        mov r14, rdx;                    // window slot
        mov r15, rcx;                    // rights

        mov rdi, r12;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_bw_badidx;
        mov rbx, rax;

        mov rax, [rbx + 24];
        cmp rax, 0;
        jne lpg_bw_already;

        mov rdi, r14;                    // subject slot
        mov rsi, r13;                    // parent (KIND_MEMORY)
        mov rdx, r15;                    // rights
        mov rcx, 0x06;                   // OPREG_SPACE_PCI_BAR
        mov r8,  [rbx + 8];              // base — INHERITED
        mov r9,  [rbx + 16];             // len  — INHERITED
        call opregion_cap_mint_root;
        cmp rax, 0;
        jne lpg_bw_refused;

        mov [rbx + 24], r14;
        mov rax, 2;                      // LPSS_GPIO_STATE_WINDOWED
        mov [rbx + 32], rax;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpg_bw_refused:
        mov rax, 0xFFFFFF2C;             // LPSS_GPIO_WIN_BAD_PARENT
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lpg_bw_already:
        mov rax, 0xFFFFFF2B;             // LPSS_GPIO_WIN_ALREADY
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lpg_bw_badidx:
        mov rax, 0xFFFFFF2E;             // LPSS_GPIO_BAD_IDX
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_identify(idx) -> rc
  //
  // STAGE 2. The seam must already be bound to this controller's window.
  // ==========================================================================

  pub let lpss_gpio_identify : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (idx: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-002 (#1076): confirm that a class candidate really is an Intel pad controller, by asking it, and derive the PADCFG stride from what it answers. (1) State must be WINDOWED, else LPSS_GPIO_ID_NOT_WINDOWED (nothing can be read without the capability) or LPSS_GPIO_ID_ALREADY on a controller already identified -- identifying twice would re-derive a stride that communities have already been described against. (2) Read BAR0 + 0xFC. If it reads 0x44570140 this is a DesignWare I2C core, and the candidate is rejected with LPSS_GPIO_ID_IS_I2C: the LPSS class code does not distinguish the two blocks, so this negative check is the only thing that keeps the pad-controller driver off the I2C controller's registers, and 'we found the I2C block' is a far more useful sentence than 'not recognised'. (3) Read REVID. 0 or all-ones -> LPSS_GPIO_ID_NO_PART: a window that answers with either has nothing behind it, and every subsequent read would be equally meaningless. (4) Derive the stride: REVID[23:16] >= 0x94 means four PADCFG registers per pad (16 bytes), below it two (8 bytes). Derived from the part rather than fixed as a constant, because a stride that is wrong by a factor of two puts EVERY pad access on the wrong pad and would be found on the machine rather than here. (5) Read PADBAR at 0x0C and require non-zero, 4-byte aligned and inside the BAR, else LPSS_GPIO_ID_BAD_PADBAR -- community 0's window starts at the BAR base on every Intel part, so this is community 0's own header and a controller whose first community is malformed is not one this driver will describe. (6) Record revid and stride, advance to IDENTIFIED. A read that faults (the seam refused it) is LPSS_GPIO_IO_FAULT and is NOT collapsed into NO_PART: 'we were not allowed to read' and 'we read and it was empty' are different problems. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed lpg_idf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // idx

        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_idf_badidx;
        mov rbx, rax;

        mov rax, [rbx + 32];
        cmp rax, 3;                      // already IDENTIFIED
        je  lpg_idf_already;
        cmp rax, 2;                      // LPSS_GPIO_STATE_WINDOWED
        jne lpg_idf_notwin;

        // (2) the DesignWare I²C discriminator.
        mov rdi, 0xFC;                   // DW_IC_COMP_TYPE_OFF
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  lpg_idf_iofault;
        mov r10, 0x44570140;             // DW_IC_COMP_TYPE_VAL
        cmp rax, r10;
        je  lpg_idf_isi2c;

        // (3) REVID must answer.
        mov rdi, 0;                      // GPIO_REG_REVID
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  lpg_idf_iofault;
        cmp rax, 0;
        je  lpg_idf_nopart;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je  lpg_idf_nopart;
        mov r13, rax;                    // revid

        // (4) stride from the revision field.
        mov rax, r13;
        shr rax, 16;
        and rax, 0xFF;
        mov r10, 0x94;                   // GPIO_REVID_NREGS4_MIN
        cmp rax, r10;
        jb  lpg_idf_stride2;
        mov r14, 16;                     // GPIO_PADCFG_STRIDE_4
        jmp lpg_idf_padbar;
      lpg_idf_stride2:
        mov r14, 8;                      // GPIO_PADCFG_STRIDE_2

      lpg_idf_padbar:
        // (5) PADBAR of community 0.
        mov rdi, 0x0C;                   // GPIO_REG_PADBAR
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  lpg_idf_iofault;
        cmp rax, 0;
        je  lpg_idf_badpadbar;
        mov r10, rax;
        and r10, 3;
        cmp r10, 0;
        jne lpg_idf_badpadbar;
        mov r10, [rbx + 16];             // bar0_len
        cmp rax, r10;
        jae lpg_idf_badpadbar;

        // (6) record and advance.
        mov [rbx + 48], r13;             // revid
        mov [rbx + 56], r14;             // padcfg_stride
        mov rax, 3;                      // LPSS_GPIO_STATE_IDENTIFIED
        mov [rbx + 32], rax;

        xor rax, rax;
        jmp lpg_idf_out;

      lpg_idf_notwin:
        mov rax, 0xFFFFFF2A;             // LPSS_GPIO_ID_NOT_WINDOWED
        jmp lpg_idf_out;
      lpg_idf_already:
        mov rax, 0xFFFFFF26;             // LPSS_GPIO_ID_ALREADY
        jmp lpg_idf_out;
      lpg_idf_isi2c:
        mov rax, 0xFFFFFF29;             // LPSS_GPIO_ID_IS_I2C
        jmp lpg_idf_out;
      lpg_idf_nopart:
        mov rax, 0xFFFFFF28;             // LPSS_GPIO_ID_NO_PART
        jmp lpg_idf_out;
      lpg_idf_badpadbar:
        mov rax, 0xFFFFFF27;             // LPSS_GPIO_ID_BAD_PADBAR
        jmp lpg_idf_out;
      lpg_idf_iofault:
        mov rax, 0xFFFFFF20;             // LPSS_GPIO_IO_FAULT
        jmp lpg_idf_out;
      lpg_idf_badidx:
        mov rax, 0xFFFFFF2E;             // LPSS_GPIO_BAD_IDX

      lpg_idf_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_reject(idx) -> rc
  //
  // Stage-2 failure. LOUD by construction.
  // ==========================================================================

  pub let lpss_gpio_reject : (u64) -> u64 !{mem, sysreg} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R30.M6-002 (#1076): move a candidate to LPSS_GPIO_STATE_REJECTED and EMIT A LOG LINE carrying its BDF. The emission is the point and is why this is a function rather than a state store: a class-matched device that failed identification is the single most informative event this driver can produce on a machine nobody has tried before -- 'something is at this address and it is not the pad controller we expected' is the sentence that turns an unexplained dead touchpad into a one-line bug report. A silent rejection is indistinguishable from never having probed. LEVEL_ERROR rather than INFO because a rejected candidate means a device the platform exposed is now unusable. Three pushes leave rsp%16 == 0 at both nested calls. Labels prefixed lpg_rj_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov rdi, r12;
        call lpss_gpio_ctrl_id;
        mov r13, rax;

        mov rdi, r12;
        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_rj_badidx;
        mov rbx, 4;                      // LPSS_GPIO_STATE_REJECTED
        mov [rax + 32], rbx;
        xor rbx, rbx;

      lpg_rj_emit:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpg_tag_reject];
        lea rcx, [rip + lpg_k_bdf];
        mov r8, r13;
        call klog_s1_x1;

        mov rax, rbx;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpg_rj_badidx:
        mov rbx, 0xFFFFFF2E;             // LPSS_GPIO_BAD_IDX
        jmp lpg_rj_emit
      }
    }

  // ==========================================================================
  // lpss_gpio_release(idx) -> rc
  //
  // CONTROLLER TEARDOWN, and the cascade root.
  // ==========================================================================

  pub let lpss_gpio_release : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (idx: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): tear a controller down, and take every KIND_GPIO_LINE derived from it with it. Order is not stylistic. (1) gpio_line_cascade_revoke_by_controller(controller_id) FIRST, while the controller row is still live, because a line capability that outlived its controller is a live handle to a pin on a part nobody owns -- and worse than in the I2C case, because the line's recorded controller_id could be re-used by a later probe and the surviving capability would then name a pin on DIFFERENT SILICON. (2) opregion_cap_revoke on the window slot, if any, so the register mapping dies with the controller and any seam still bound to it starts refusing GPIO_IO_DEAD_ROW on the next access -- which it will, because the seam stores the slot and re-resolves it rather than caching a base. (3) Zero this controller's community rows: a community row names its controller by INDEX, so one that outlived its controller would attach itself to whatever the next probe put in that slot and apply one part's pin map to another. (4) Zero the controller row itself, which is both the free and the scrub. The cascade count is deliberately NOT returned -- gpio_line_rows_live is the standing observable and a second count would be a second truth -- but a non-zero result from the window revoke IS returned, because a controller whose registers are still mapped after teardown is a fact nobody should have to infer. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed lpg_rel_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // idx

        call lpss_gpio_row;
        cmp rax, 0;
        je  lpg_rel_badidx;
        mov rbx, rax;                    // controller row
        xor r14, r14;                    // outcome

        // (1) cascade to the lines.
        mov rdi, [rbx + 40];             // controller_id
        call gpio_line_cascade_revoke_by_controller;

        // (2) the window.
        mov r13, [rbx + 24];
        cmp r13, 0;
        je  lpg_rel_comm;
        mov rdi, r13;
        call opregion_cap_revoke;
        mov r14, rax;

      lpg_rel_comm:
        // (3) this controller's community rows.
        lea r10, [rip + _lpss_gpio_comm];
        xor rcx, rcx;
      lpg_rel_cnext:
        cmp rcx, 16;
        jae lpg_rel_ctrl;
        mov rax, rcx;
        shl rax, 5;
        add rax, r10;
        mov r9, [rax + 0];
        mov r11, r9;
        and r11, 0xFF;
        cmp r11, 0;
        je  lpg_rel_cbump;
        mov r11, r9;
        shr r11, 8;
        and r11, 0xFF;
        cmp r11, r12;
        jne lpg_rel_cbump;
        xor r11, r11;
        mov [rax + 0],  r11;
        mov [rax + 8],  r11;
        mov [rax + 16], r11;
        mov [rax + 24], r11;
      lpg_rel_cbump:
        add rcx, 1;
        lea r10, [rip + _lpss_gpio_comm];
        jmp lpg_rel_cnext;

      lpg_rel_ctrl:
        // (4) the controller row: free and scrub in one.
        xor rax, rax;
        mov [rbx + 0],  rax;
        mov [rbx + 8],  rax;
        mov [rbx + 16], rax;
        mov [rbx + 24], rax;
        mov [rbx + 32], rax;
        mov [rbx + 40], rax;
        mov [rbx + 48], rax;
        mov [rbx + 56], rax;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lpg_rel_badidx:
        mov rax, 0xFFFFFF2E;             // LPSS_GPIO_BAD_IDX
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lpss_gpio_probe() -> number of candidate controllers recorded
  //
  // Stage 1. No MMIO, no capability, no identification: this walks the
  // enumerator's published device list, keeps the class candidates,
  // measures BAR0, and stops.
  //
  // A NOTE ON WHERE THE PAD CONTROLLER ACTUALLY LIVES. On the T14 G4 the
  // PCH pad controller is described by platform firmware rather than
  // enumerated as a PCI function; the consumer of that description is
  // R30's userspace supervisor and it is not this file. The PCI path
  // below is real for the LPSS blocks that ARE exposed as functions, and
  // it is the enumeration this milestone was scoped to. Both paths
  // converge on lpss_gpio_record, which is why that allocator is
  // exported: the description-driven path adds a caller, not a second
  // table.
  // ==========================================================================

  pub let lpss_gpio_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R30.M6-002 (#1076): walk _pci_devices (32-byte records, class_code at +6, subclass at +7, vendor at +8, seg/bus/dev/fn at +0/+2/+3/+4) and record every CLASS CANDIDATE for an Intel pad controller. The filter is (0x0C, 0x80) or (0x11, 0x80) -- deliberately the SAME filter lpss_probe.pdx uses, because the LPSS class code genuinely does not distinguish a pad controller from an I2C controller and pretending otherwise would mean inventing a discriminator that does not exist. Stage 2 (lpss_gpio_identify) is what tells them apart, and it does so by asking the part. No device-id table, for the reason lpss_probe.pdx gives at length: a device-id table's failure mode is a present, healthy, unprobed controller and a silent log. Vendor 0x8086 is RECORDED, not filtered on. Each candidate's BAR0 is measured through lpss_gpio_bar0 with the decoder disabled across the sizing write, and a BAR that is absent, is I/O, or is under a page drops the candidate rather than recording a window nobody can use. Overflow past LPSS_GPIO_MAX_CTRL drops silently but observably: the emitted count is the number RECORDED. Rows are left CANDIDATE with no window; binding one is a separate, capability-bearing step. Six-push prologue + sub rsp, 40 (32-byte bar_info at [rsp+0], tally at [rsp+32]); entry 8 + 48 + 40 = 96, %16 == 0. Labels prefixed lpg_pr_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        call lpss_gpio_table_reset;

        xor r13, r13;                    // recorded
        lea r10, [rip + _pci_device_count];
        mov r12, [r10 + 0];
        xor rbx, rbx;

      lpg_pr_next:
        cmp rbx, r12;
        jae lpg_pr_done;

        mov rax, rbx;
        shl rax, 5;
        lea r14, [rip + _pci_devices];
        add r14, rax;

        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x80;                   // LPSS_GPIO_SUBCLASS_OTHER
        jne lpg_pr_bump;
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x0C;
        je  lpg_pr_cand;
        cmp rax, 0x11;
        jne lpg_pr_bump;

      lpg_pr_cand:
        cmp r13, 4;                      // LPSS_GPIO_MAX_CTRL
        jae lpg_pr_bump;

        xor rdi, rdi;
        mov_w rdi, [r14 + 0];            // seg
        xor rsi, rsi;
        mov_b rsi, [r14 + 2];            // bus
        xor rdx, rdx;
        mov_b rdx, [r14 + 3];            // dev
        xor rcx, rcx;
        mov_b rcx, [r14 + 4];            // fn
        mov r8, rsp;                     // bar_info
        call lpss_gpio_bar0;
        cmp rax, 0;
        jne lpg_pr_bump;

        xor rdi, rdi;
        mov_w rdi, [r14 + 0];
        xor rsi, rsi;
        mov_b rsi, [r14 + 2];
        xor rdx, rdx;
        mov_b rdx, [r14 + 3];
        xor rcx, rcx;
        mov_b rcx, [r14 + 4];
        call bdf_pack;
        mov r15, rax;

        xor rbp, rbp;
        xor rax, rax;
        mov_w rax, [r14 + 8];            // vendor
        mov r10, 0x8086;
        cmp rax, r10;
        jne lpg_pr_nointel;
        mov rbp, 1;
      lpg_pr_nointel:

        mov rdi, r15;
        mov rsi, rbp;
        mov rdx, [rsp + 0];              // bar_info.base_pa
        mov rcx, [rsp + 8];              // bar_info.size
        call lpss_gpio_record;
        mov r10, 0xFFFFFF08;             // any code at or above the GPIO_IO band
        cmp rax, r10;
        jae lpg_pr_bump;

        add r13, 1;

      lpg_pr_bump:
        add rbx, 1;
        jmp lpg_pr_next;

      lpg_pr_done:
        mov [rsp + 32], r13;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lpg_tag_probe];
        lea rcx, [rip + lpg_k_n];
        mov r8, r13;
        call klog_s1_d1;

        mov rax, [rsp + 32];
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
