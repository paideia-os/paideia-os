// src/kernel/core/drivers/gpio/gpio_pad.pdx — R30.M6-004 (#1078)
//
// THE FIRST CODE IN THIS KERNEL THAT CHANGES PHYSICAL BOARD STATE.
//
// -----------------------------------------------------------------------------
// What is different about this file
// -----------------------------------------------------------------------------
//
// R30.M6-001 minted capabilities over pins. R30.M6-002 built the address
// path and drove nothing. Everything up to here could be wrong and the
// board would be unharmed, because nothing reached a pad.
//
// This file writes PADCFG0 and PADCFG1. A pad-controller register write
// changes a voltage on a physical net, and the categorical difference
// from every other driver in this tree is that THERE IS NO ERROR PATH. A
// mis-addressed I²C transfer gets a NACK. A mis-addressed MMIO read gets
// a fault. A pin that is driven wrong simply becomes what it was told,
// silently, and the first symptom appears in whatever hardware the pin
// controls — a rail that comes up early, a device held in reset, a flash
// write-protect strap released.
//
// Three consequences run through everything below.
//
// (1) NOTHING IS CLAMPED. Every out-of-range value is a distinct refusal
//     code. A clamped direction is an output; a clamped pull is a
//     resistor across a live net; a clamped trigger is an interrupt storm.
//
// (2) EVERY WRITE IS A READ-MODIFY-WRITE THAT PRESERVES WHAT IT DOES NOT
//     OWN. PADCFG0 holds direction, level, inversion, trigger, interrupt
//     routing, pad mode and a scatter of reserved and vendor bits in one
//     32-bit word. Computing a fresh word from the two fields a function
//     cares about zeroes the rest. Under QEMU that is invisible — there
//     is no pad controller, and the synthetic cell would just hold the
//     new value. On silicon it releases interrupt routing, changes pad
//     mode and clears vendor configuration nobody documented. So each
//     setter reads the word, clears exactly its own field, ORs its value
//     in, and writes back; and the fixture asserts the untouched bits
//     survived, which is an assertion only a seeded non-zero background
//     pattern can make.
//
// (3) A MISCONFIGURED EDGE IS A LIVELOCK, NOT A GLITCH. See gpio_isr.pdx.
//
// -----------------------------------------------------------------------------
// The authority split, and why pull is CONFIG
// -----------------------------------------------------------------------------
//
//   READ    sample the line
//   WRITE   drive a line THIS KERNEL ALREADY MADE AN OUTPUT
//   CONFIG  change what the pad IS: direction, pull, trigger
//
// Driving an output changes a voltage on a net this component holds.
// Turning an input into an output starts SOURCING CURRENT into a net that
// something else may already be driving; the pad controller will do it
// happily and the failure is thermal.
//
// Pull is on the CONFIG side of that line for a weaker version of the
// same reason, and the weakness does not move it: a pull-up on a line an
// external device drives low is a real current path from the rail,
// through the pad's termination resistor, into whatever is holding the
// net down. It is a fight, not a preference. A "hint" that can put a
// resistor across a live net is configuration authority.
//
// -----------------------------------------------------------------------------
// Confinement — unchanged from #1075, and NOT widened here
// -----------------------------------------------------------------------------
//
// Every function below takes a CAPABILITY SLOT and, at most, a two-bit
// configuration value. None takes a pin, a community or a pad index.
// Every pad address comes from gpio_line_pad_off_of_slot(slot), which
// tools/build.sh already proves is the only route in the kernel from
// anything to a pad register address. This file opens no second one: the
// interrupt-register helpers below derive their offsets from the
// COMMUNITY the capability's own row names, through the same accessors
// the pad address uses, and they are arity-one for the same reason.
//
// -----------------------------------------------------------------------------
// Interrupt registers
// -----------------------------------------------------------------------------
//
// Intel PCH pad controllers place the per-pad interrupt status and enable
// words at fixed offsets inside each COMMUNITY's register window, one
// 32-bit word per 32 pads:
//
//   GPI_IS  at community.reg_off + 0x100 + (pad_index / 32) * 4
//   GPI_IE  at community.reg_off + 0x120 + (pad_index / 32) * 4
//   bit      = pad_index % 32
//
// GPI_IS IS WRITE-1-TO-CLEAR. The part sets a bit when the configured
// edge arrives; software clears it by writing a 1 back to that position.
// Writing 0 does nothing and no write can set it. The synthetic register
// model in gpio_io.pdx models this properly (§_gpio_io_w1c) because a
// plain cell array cannot tell a correct acknowledgement from a missing
// one — both leave the cell holding the bit.
//
// The community window is per-community and the offsets are relative to
// it, so a line in community 1 acknowledges in community 1's status word
// — which is the same "pin numbering is not pad indexing" trap #1076
// closed for pad addresses, arriving again for interrupt registers.

module GpioPad = structure {

  // ==========================================================================
  // PADCFG0 / PADCFG1 field geometry
  // ==========================================================================

  pub let PADCFG1_DELTA         : u64 = 4

  pub let PADCFG0_TXSTATE_BIT   : u64 = 0x00000001   // [0]  output level
  pub let PADCFG0_RXSTATE_BIT   : u64 = 0x00000002   // [1]  input level
  pub let PADCFG0_TXDIS_BIT     : u64 = 0x00000100   // [8]  1 = driver off
  pub let PADCFG0_RXDIS_BIT     : u64 = 0x00000200   // [9]  1 = receiver off
  pub let PADCFG0_PMODE_MASK    : u64 = 0x00003C00   // [13:10] pad mode
  pub let PADCFG0_IOXAPIC_BIT   : u64 = 0x00100000   // [20] route to IOxAPIC
  pub let PADCFG0_RXINV_BIT     : u64 = 0x00800000   // [23] invert receiver
  pub let PADCFG0_RXEVCFG_MASK  : u64 = 0x06000000   // [26:25]

  pub let RXEVCFG_LEVEL         : u64 = 0
  pub let RXEVCFG_EDGE          : u64 = 1
  pub let RXEVCFG_DISABLED      : u64 = 2
  pub let RXEVCFG_BOTH          : u64 = 3

  pub let PADCFG1_TERM_MASK     : u64 = 0x00003C00   // [13:10]
  pub let TERM_NONE             : u64 = 0x0
  pub let TERM_DOWN_20K         : u64 = 0x4
  pub let TERM_UP_20K           : u64 = 0xC          // bit 13 = pull-up

  pub let GPIO_GPI_IS_OFF       : u64 = 0x100
  pub let GPIO_GPI_IE_OFF       : u64 = 0x120

  // ==========================================================================
  // Value spaces. Refused, never clamped.
  // ==========================================================================

  pub let GPIO_DIR_INPUT   : u64 = 0
  pub let GPIO_DIR_OUTPUT  : u64 = 1

  pub let GPIO_PULL_NONE   : u64 = 0
  pub let GPIO_PULL_DOWN   : u64 = 1
  pub let GPIO_PULL_UP     : u64 = 2

  pub let GPIO_TRIG_NONE    : u64 = 0
  pub let GPIO_TRIG_RISING  : u64 = 1
  pub let GPIO_TRIG_FALLING : u64 = 2
  pub let GPIO_TRIG_BOTH    : u64 = 3

  // ==========================================================================
  // Failure taxonomy — band 0xFFFFFEE0..0xFFFFFEEF
  //
  // A NEW band, disjoint from every band in the tree: GPIO_IO_*
  // (0xFFFFFF08..0F), GPIO_LINE_* (0xFFFFFF10..1F), LPSS_GPIO_*
  // (0xFFFFFF20..2F) and the rest listed in gpio_io.pdx. The three GPIO
  // bands stay separate because "the seam refused you", "the capability
  // refused you" and "the pad refused you" are three different operator
  // problems: the first is a rights or window fault, the second a
  // capability fault, the third a statement about the pin itself.
  // ==========================================================================

  pub let GPIO_PAD_OK          : u64 = 0
  pub let GPIO_PAD_BAD_SLOT    : u64 = 0xFFFFFEEF
  pub let GPIO_PAD_BAD_DIR     : u64 = 0xFFFFFEEE
  pub let GPIO_PAD_BAD_PULL    : u64 = 0xFFFFFEED
  pub let GPIO_PAD_BAD_TRIG    : u64 = 0xFFFFFEEC
  pub let GPIO_PAD_BAD_LEVEL   : u64 = 0xFFFFFEEB
  pub let GPIO_PAD_NOT_OUTPUT  : u64 = 0xFFFFFEEA
  pub let GPIO_PAD_NOT_INPUT   : u64 = 0xFFFFFEE9
  pub let GPIO_PAD_IO_FAULT    : u64 = 0xFFFFFEE8
  pub let GPIO_PAD_NO_COMM     : u64 = 0xFFFFFEE7
  pub let GPIO_PAD_SUB_FULL    : u64 = 0xFFFFFEE6
  pub let GPIO_PAD_ALREADY_SUB : u64 = 0xFFFFFEE5
  pub let GPIO_PAD_NOT_SUB     : u64 = 0xFFFFFEE4
  pub let GPIO_PAD_STORM       : u64 = 0xFFFFFEE3
  pub let GPIO_PAD_CFG_FAIL    : u64 = 0xFFFFFEE2
  pub let GPIO_PAD_NOT_GPIO    : u64 = 0xFFFFFEE1
  pub let GPIO_PAD_BAND_LOW    : u64 = 0xFFFFFEE0

  // ==========================================================================
  // Subscription registry — module storage, confined to this object and
  // read by gpio_isr.o only through the bounded accessors below.
  //
  // FOUR ENTRIES, each holding `slot + 1` so .bss zero means empty. The
  // registry holds SLOTS AND NOTHING ELSE: no cached register offset, no
  // cached bit mask, no cached base. That is the same discipline
  // gpio_io.pdx applies to the window capability and for the same reason
  // — a cached address survives a revoke, and an ISR walking a stale
  // pad address is an ISR writing to whatever now occupies it. Every
  // interrupt re-derives the offset from the capability.
  // ==========================================================================

  pub let GPIO_PAD_SUB_MAX : u64 = 4
  pub let mut _gpio_pad_sub : [u64; 4] = uninit @align(64)

  // ==========================================================================
  // gpio_pad_sub_reset() -> ()
  // ==========================================================================

  pub let gpio_pad_sub_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-004 (#1078): forget every edge subscription. Called by fixture setup and teardown so an interrupt registered against a capability the next boot stage will revoke cannot outlive it -- an ISR walking a subscription whose slot has been reused would re-derive an offset from a descriptor describing something else entirely. Leaf; four qword stores. Labels prefixed gpio_pad_sr_.",
      block: {
        lea r10, [rip + _gpio_pad_sub];
        xor rax, rax;
        xor rcx, rcx;
      gpio_pad_sr_clear:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  gpio_pad_sr_clear;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_pad_sub_slot(idx) -> slot | 0
  // ==========================================================================

  pub let gpio_pad_sub_slot : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-004 (#1078): the capability slot registered at subscription index idx, or 0 for an empty entry. Slot 0 is never a line capability in this kernel (slot 0 is the boot memory capability), so 0 is unambiguous as 'empty' -- the same reasoning gpio_io.pdx uses for _gpio_io_win_slot. One of the ISR's allowlisted callees: a bounds check and one load, no loop. Leaf. Labels prefixed gpio_pad_ss_.",
      block: {
        cmp rdi, 4;
        jae gpio_pad_ss_none;
        lea r10, [rip + _gpio_pad_sub];
        mov rax, [r10 + rdi * 8];
        cmp rax, 0;
        je  gpio_pad_ss_none;
        sub rax, 1;
        ret;
      gpio_pad_ss_none:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_pad_sub_find(slot) -> idx | GPIO_PAD_SUB_MAX
  // ==========================================================================

  pub let gpio_pad_sub_find : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-004 (#1078): index of the entry registered for `slot`, or GPIO_PAD_SUB_MAX (4) if none. Returns the out-of-range index rather than a sentinel in the failure band because every caller immediately compares against 4 anyway, and a band code here would have to be distinguished from the band codes the same callers are already checking. Leaf, four iterations. Labels prefixed gpio_pad_sf_.",
      block: {
        mov r9, rdi;
        add r9, 1;
        lea r10, [rip + _gpio_pad_sub];
        xor rcx, rcx;
      gpio_pad_sf_next:
        cmp rcx, 4;
        jae gpio_pad_sf_none;
        mov rax, [r10 + rcx * 8];
        cmp rax, r9;
        je  gpio_pad_sf_hit;
        add rcx, 1;
        jmp gpio_pad_sf_next;
      gpio_pad_sf_hit:
        mov rax, rcx;
        ret;
      gpio_pad_sf_none:
        mov rax, 4;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_pad_comm_base_of_slot(slot) -> community reg_off | GPIO_PAD_NO_COMM
  //
  // ARITY ONE. Pinned by tools/build.sh alongside the #1075 resolvers.
  // ==========================================================================

  pub let gpio_pad_comm_base_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): the byte offset, within BAR0, of the register WINDOW belonging to the community the capability's pin lives in. Composed strictly from the capability: gpio_line_ctrl_of_slot gives the controller identity the row inherited, lpss_gpio_find_by_ctrl_id turns it into a table index, gpio_line_community_of_slot gives the community the mint recorded, and lpss_gpio_comm_reg_off gives the window. GPIO_PAD_NO_COMM at every step rather than a plausible zero, because zero is community 0's ordinary offset on every Intel part and an interrupt register formed from it would be a real register belonging to a real pin. ARITY ONE for the same reason the five #1075 resolvers are: a caller-supplied community selects a different bank, and the interrupt status word of the wrong bank acknowledges somebody else's interrupt. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_cb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov rdi, r12;
        call gpio_line_ctrl_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_cb_none;
        cmp rax, 0;
        je  gpio_pad_cb_none;

        mov rdi, rax;
        call lpss_gpio_find_by_ctrl_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_cb_none;
        mov r13, rax;                    // ctrl_idx

        mov rdi, r12;
        call gpio_line_community_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_cb_none;
        mov r14, rax;                    // community

        mov rdi, r13;
        mov rsi, r14;
        call lpss_gpio_comm_reg_off;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // GPIO_MAP_UNMAPPED
        cmp rax, r10;
        je  gpio_pad_cb_none;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpio_pad_cb_none:
        mov rax, 0xFFFFFEE7;             // GPIO_PAD_NO_COMM
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_bit_of_slot(slot) -> 1 << (pad_index % 32) | 0
  // ==========================================================================

  pub let gpio_pad_bit_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): the bit this line occupies inside its community's 32-pad interrupt word. Derived from the pad INDEX the row recorded, never from the absolute pin: a community-relative index is what the interrupt word is indexed by, and using the absolute pin would acknowledge the wrong bit for every community whose pin_base is not zero -- the same off-by-a-community error #1076 exists to prevent, arriving in the interrupt path. Returns 0 (never a plausible mask) for a slot that does not resolve. The shift is a counted loop rather than a variable shift because the encoder has no shl-by-CL form wired; 32 iterations, bounded by construction. Two pushes leave rsp%16 == 0 at the nested call. ARITY ONE. Labels prefixed gpio_pad_bo_.",
      block: {
        push rbx;

        call gpio_line_pad_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_bo_none;

        and rax, 31;
        mov rcx, rax;
        mov rax, 1;
      gpio_pad_bo_shift:
        cmp rcx, 0;
        je  gpio_pad_bo_done;
        add rax, rax;
        sub rcx, 1;
        jmp gpio_pad_bo_shift;

      gpio_pad_bo_done:
        pop rbx;
        ret;

      gpio_pad_bo_none:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_is_off_of_slot(slot) -> GPI_IS offset | GPIO_PAD_NO_COMM
  // gpio_pad_ie_off_of_slot(slot) -> GPI_IE offset | GPIO_PAD_NO_COMM
  // ==========================================================================

  pub let gpio_pad_is_off_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): community.reg_off + 0x100 + (pad_index / 32) * 4 -- the interrupt STATUS word covering this line's pad. Both terms come from the capability and neither is a parameter. GPIO_PAD_NO_COMM if either does. ARITY ONE. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_io_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov rdi, r12;
        call gpio_pad_comm_base_of_slot;
        mov r10, 0xFFFFFEE7;
        cmp rax, r10;
        je  gpio_pad_io_none;
        mov r13, rax;                    // community window

        mov rdi, r12;
        call gpio_line_pad_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_io_none;

        shr rax, 5;                      // pad_index / 32
        shl rax, 2;                      // * 4 bytes
        add rax, r13;
        add rax, 0x100;                  // GPIO_GPI_IS_OFF

        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpio_pad_io_none:
        mov rax, 0xFFFFFEE7;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpio_pad_ie_off_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): community.reg_off + 0x120 + (pad_index / 32) * 4 -- the interrupt ENABLE word covering this line's pad. Kept separate from the status helper rather than parameterised on the base offset, because a shared helper taking an offset argument would be a function through which a caller could name ANY register in the community window, which is a second address route in everything but name. ARITY ONE. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_ie_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov rdi, r12;
        call gpio_pad_comm_base_of_slot;
        mov r10, 0xFFFFFEE7;
        cmp rax, r10;
        je  gpio_pad_ie_none;
        mov r13, rax;

        mov rdi, r12;
        call gpio_line_pad_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_ie_none;

        shr rax, 5;
        shl rax, 2;
        add rax, r13;
        add rax, 0x120;                  // GPIO_GPI_IE_OFF

        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpio_pad_ie_none:
        mov rax, 0xFFFFFEE7;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_set_dir(slot, dir) -> GPIO_PAD_OK | error       [CONFIG]
  //
  // THE READ-MODIFY-WRITE THAT MATTERS MOST.
  // ==========================================================================

  pub let gpio_pad_set_dir : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slot: u64) (dir: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): make the line an input or an output. dir outside {0,1} -> GPIO_PAD_BAD_DIR, refused not masked: a masked 2 is an output, and an output is a driver on a net. Address from gpio_line_pad_off_of_slot(slot) and nowhere else -> GPIO_PAD_BAD_SLOT. Reads PADCFG0, REFUSES a pad whose PMODE [13:10] is not 0 with GPIO_PAD_NOT_GPIO -- a pad in a native function is owned by a hardware block (an I2C SCL, a UART TX), and switching it to GPIO steals a signal from a live peripheral, so this is a refusal and not a forced mode change. Then clears EXACTLY bits [9:8] (GPIORXDIS, GPIOTXDIS) and ORs the new pair in: INPUT is receiver on, driver off; OUTPUT is receiver on AND driver on, the receiver staying enabled so a driven line can be read back. Every other bit of the word -- inversion, trigger, IOxAPIC routing, pad mode, reserved and vendor fields -- is carried through untouched, which is the difference between a driver that is correct on QEMU and one that is correct on silicon: a computed-from-scratch word releases interrupt routing and clears vendor configuration, and neither shows up in a synthetic cell. On success updates the row's cached direction, and ONLY then: the cache means 'this kernel made it an output', and a cache written before the register would let a failed write leave the capability believing it may drive. Six pushes plus a padding push keep rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_sd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // dir

        cmp r13, 1;
        ja  gpio_pad_sd_bad_dir;

        mov rdi, r12;
        call gpio_line_pad_off_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sd_bad_slot;
        mov r14, rax;                    // PADCFG0 offset

        mov rdi, r14;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sd_io;
        mov r15, rax;                    // PADCFG0

        // Refuse a pad that is not in GPIO mode.
        mov rax, r15;
        mov r10, 0x00003C00;             // PADCFG0_PMODE_MASK
        and rax, r10;
        cmp rax, 0;
        jne gpio_pad_sd_not_gpio;

        // Clear exactly [9:8], preserve everything else.
        mov rax, r15;
        mov r10, 0x00000300;             // TXDIS | RXDIS
        mov r11, 0xFFFFFFFFFFFFFFFF;
        xor r10, r11;
        and rax, r10;

        // Receiver always enabled (RXDIS stays 0). Driver enabled iff
        // dir == OUTPUT.
        cmp r13, 1;
        je  gpio_pad_sd_store;
        mov r10, 0x00000100;             // TXDIS = 1 -> input
        or  rax, r10;

      gpio_pad_sd_store:
        mov rdi, r14;
        mov rsi, rax;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_sd_io;

        // Cache the direction, preserving the other cfg fields.
        mov rdi, r12;
        call gpio_line_cfg_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sd_cfg;
        mov r10, 0x3E;                   // clear bit [0]
        and rax, r10;
        or  rax, r13;
        mov rdi, r12;
        mov rsi, rax;
        call gpio_line_set_cfg_of_slot;
        cmp rax, 0;
        jne gpio_pad_sd_cfg;

        xor rax, rax;                    // GPIO_PAD_OK
        jmp gpio_pad_sd_out;

      gpio_pad_sd_bad_dir:
        mov rax, 0xFFFFFEEE;
        jmp gpio_pad_sd_out;
      gpio_pad_sd_bad_slot:
        mov rax, 0xFFFFFEEF;
        jmp gpio_pad_sd_out;
      gpio_pad_sd_io:
        mov rax, 0xFFFFFEE8;
        jmp gpio_pad_sd_out;
      gpio_pad_sd_not_gpio:
        mov rax, 0xFFFFFEE1;
        jmp gpio_pad_sd_out;
      gpio_pad_sd_cfg:
        mov rax, 0xFFFFFEE2;

      gpio_pad_sd_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_set_pull(slot, pull) -> GPIO_PAD_OK | error     [CONFIG]
  // ==========================================================================

  pub let gpio_pad_set_pull : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slot: u64) (pull: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): set the pad's termination. pull outside {NONE, DOWN, UP} -> GPIO_PAD_BAD_PULL, refused not masked, because a masked value is a resistor and a resistor on the wrong net is a current path nobody intended. Writes PADCFG1, which is PADCFG0 + 4 -- the neighbouring register, which is exactly why gpio_io.pdx uses mov_d rather than a REX.W store. Clears EXACTLY the TERM field [13:10] and ORs the new encoding in (0 = none, 0x4 = 20K pull-down, 0xC = 20K pull-up, bit 13 selecting the direction), leaving every other bit of PADCFG1 -- debounce configuration, vendor and reserved fields -- as it found them. Requires CONFIG authority at the schema layer and not WRITE: a pull-up on a line an external device drives low is a fight, not a preference. On success updates the row's cached pull. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_sp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // pull

        cmp r13, 2;
        ja  gpio_pad_sp_bad_pull;

        mov rdi, r12;
        call gpio_line_pad_off_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sp_bad_slot;
        add rax, 4;                      // PADCFG1
        mov r14, rax;

        mov rdi, r14;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sp_io;
        mov r15, rax;

        // Clear exactly [13:10].
        mov rax, r15;
        mov r10, 0x00003C00;             // PADCFG1_TERM_MASK
        mov r11, 0xFFFFFFFFFFFFFFFF;
        xor r10, r11;
        and rax, r10;

        // Encode: NONE -> 0, DOWN -> 0x4, UP -> 0xC, shifted to [13:10].
        cmp r13, 0;
        je  gpio_pad_sp_store;
        mov r10, 0x4;
        cmp r13, 1;
        je  gpio_pad_sp_have_term;
        mov r10, 0xC;
      gpio_pad_sp_have_term:
        shl r10, 10;
        or  rax, r10;

      gpio_pad_sp_store:
        mov rdi, r14;
        mov rsi, rax;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_sp_io;

        mov rdi, r12;
        call gpio_line_cfg_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sp_cfg;
        mov r10, 0x39;                   // clear bits [2:1]
        and rax, r10;
        mov r11, r13;
        shl r11, 1;
        or  rax, r11;
        mov rdi, r12;
        mov rsi, rax;
        call gpio_line_set_cfg_of_slot;
        cmp rax, 0;
        jne gpio_pad_sp_cfg;

        xor rax, rax;
        jmp gpio_pad_sp_out;

      gpio_pad_sp_bad_pull:
        mov rax, 0xFFFFFEED;
        jmp gpio_pad_sp_out;
      gpio_pad_sp_bad_slot:
        mov rax, 0xFFFFFEEF;
        jmp gpio_pad_sp_out;
      gpio_pad_sp_io:
        mov rax, 0xFFFFFEE8;
        jmp gpio_pad_sp_out;
      gpio_pad_sp_cfg:
        mov rax, 0xFFFFFEE2;

      gpio_pad_sp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_get_level(slot) -> 0 | 1 | error                [READ]
  // ==========================================================================

  pub let gpio_pad_get_level : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slot: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): sample the line. Reads PADCFG0 through the seam and returns GPIORXSTATE [1] for a line this kernel configured as an input, GPIOTXSTATE [0] for one it configured as an output -- an output's receiver is left enabled by set_dir, but the meaningful answer for an output is what we are driving, and the two differ on a shorted net in a way that would make a readback silently disagree with the last set. GPIO_PAD_BAD_SLOT / GPIO_PAD_IO_FAULT are outside {0,1} so a refusal can never be read as a level. Requires READ and not INVOKE at the schema layer: sampling a line is observing the board. Four pushes plus one padding push leave rsp%16 == 0 at every nested call. ARITY ONE. Labels prefixed gpio_pad_gl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov rdi, r12;
        call gpio_line_pad_off_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_gl_bad_slot;
        mov r13, rax;

        mov rdi, r12;
        call gpio_line_cfg_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_gl_bad_slot;
        mov r14, rax;
        and r14, 1;                      // cached direction

        mov rdi, r13;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_gl_io;

        cmp r14, 1;
        je  gpio_pad_gl_tx;
        shr rax, 1;                      // GPIORXSTATE
        and rax, 1;
        jmp gpio_pad_gl_out;

      gpio_pad_gl_tx:
        and rax, 1;                      // GPIOTXSTATE
        jmp gpio_pad_gl_out;

      gpio_pad_gl_bad_slot:
        mov rax, 0xFFFFFEEF;
        jmp gpio_pad_gl_out;
      gpio_pad_gl_io:
        mov rax, 0xFFFFFEE8;

      gpio_pad_gl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_set_level(slot, level) -> GPIO_PAD_OK | error   [WRITE]
  // ==========================================================================

  pub let gpio_pad_set_level : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slot: u64) (level: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): drive an output. level outside {0,1} -> GPIO_PAD_BAD_LEVEL. THE REFUSAL THAT MATTERS: a line whose CACHED direction is not OUTPUT is refused GPIO_PAD_NOT_OUTPUT, and the cache is written only after a successful gpio_pad_set_dir, so 'drive a pin this kernel never configured as an output' is unreachable rather than merely discouraged. Deciding instead from a live PADCFG0 read would mean driving a net on the strength of a configuration platform firmware chose and nobody in this kernel audited. Read-modify-write clears exactly GPIOTXSTATE [0] and ORs the new level in; the direction bits, trigger, routing, pad mode and every reserved field survive -- a set_level that rebuilt the word would silently undo the set_dir that authorised it. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_sl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // level

        cmp r13, 1;
        ja  gpio_pad_sl_bad_level;

        mov rdi, r12;
        call gpio_line_cfg_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sl_bad_slot;
        mov r10, rax;
        and r10, 1;
        cmp r10, 1;
        jne gpio_pad_sl_not_out;

        mov rdi, r12;
        call gpio_line_pad_off_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sl_bad_slot;
        mov r14, rax;

        mov rdi, r14;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sl_io;
        mov r15, rax;

        mov rax, r15;
        mov r10, 0xFFFFFFFFFFFFFFFE;     // ~GPIOTXSTATE
        and rax, r10;
        or  rax, r13;

        mov rdi, r14;
        mov rsi, rax;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_sl_io;

        xor rax, rax;
        jmp gpio_pad_sl_out;

      gpio_pad_sl_bad_level:
        mov rax, 0xFFFFFEEB;
        jmp gpio_pad_sl_out;
      gpio_pad_sl_bad_slot:
        mov rax, 0xFFFFFEEF;
        jmp gpio_pad_sl_out;
      gpio_pad_sl_not_out:
        mov rax, 0xFFFFFEEA;
        jmp gpio_pad_sl_out;
      gpio_pad_sl_io:
        mov rax, 0xFFFFFEE8;

      gpio_pad_sl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_edge_subscribe(slot, trig) -> GPIO_PAD_OK | error   [CONFIG]
  //
  // The order of operations here IS the storm-prevention argument.
  // ==========================================================================

  pub let gpio_pad_edge_subscribe : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slot: u64) (trig: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): arm an edge interrupt on a line. trig outside {NONE, RISING, FALLING, BOTH} -> GPIO_PAD_BAD_TRIG, refused not masked: a masked trigger is some OTHER trigger, and the wrong trigger on a fast line is an interrupt storm. A line whose cached direction is OUTPUT -> GPIO_PAD_NOT_INPUT; subscribing to edges on a pin we are driving is asking to be interrupted by ourselves. A line already subscribed -> GPIO_PAD_ALREADY_SUB, and a full registry -> GPIO_PAD_SUB_FULL, never a silent drop -- a dropped subscription leaves the pad's interrupt ENABLED with nothing servicing it, which is the storm again with no evidence. THE ORDER IS LOAD-BEARING: (1) program PADCFG0's RXEVCFG/RXINV and route to IOxAPIC via read-modify-write, clearing exactly [26:25], [23] and [20]; (2) CLEAR ANY STALE STATUS by writing this pad's bit to the write-1-to-clear GPI_IS word; (3) only then set the pad's bit in GPI_IE. Enabling before clearing arms a line whose status bit may already be set from before we owned it, and the very first interrupt would be one the ISR services forever. NONE takes the opposite order -- disable in GPI_IE first, then set RXEVCFG to DISABLED -- so the window in which a configured edge has no enable is never the other way round. Both GPI_IS and GPI_IE are read-modify-written per bit, so a subscription on one pad never disturbs the other 31 in the same word. Five pushes plus a 32-byte frame keep rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_es_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // trig

        cmp r13, 3;
        ja  gpio_pad_es_bad_trig;

        mov rdi, r12;
        call gpio_line_cfg_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_es_bad_slot;
        mov [rsp + 0], rax;              // cfg

        // The direction gate applies only when ARMING. Quiescing a line
        // (trig == NONE) must be reachable from any state, including an
        // output: "make this pin stop interrupting" is never the request
        // to refuse.
        cmp r13, 0;
        je  gpio_pad_es_resolve;
        mov r10, rax;
        and r10, 1;
        cmp r10, 1;
        je  gpio_pad_es_not_in;

        mov rdi, r12;
        call gpio_pad_sub_find;
        cmp rax, 4;
        jb  gpio_pad_es_already;

      gpio_pad_es_resolve:
        mov rdi, r12;
        call gpio_line_pad_off_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_es_bad_slot;
        mov r14, rax;                    // PADCFG0 offset

        mov rdi, r12;
        call gpio_pad_is_off_of_slot;
        mov r10, 0xFFFFFEE7;
        cmp rax, r10;
        je  gpio_pad_es_no_comm;
        mov [rsp + 8], rax;              // GPI_IS offset

        mov rdi, r12;
        call gpio_pad_ie_off_of_slot;
        mov r10, 0xFFFFFEE7;
        cmp rax, r10;
        je  gpio_pad_es_no_comm;
        mov [rsp + 16], rax;             // GPI_IE offset

        mov rdi, r12;
        call gpio_pad_bit_of_slot;
        cmp rax, 0;
        je  gpio_pad_es_no_comm;
        mov r15, rax;                    // bit mask

        // -- Unsubscribe direction: disable first.
        cmp r13, 0;
        je  gpio_pad_es_disable;

        // -- (1) PADCFG0: trigger + inversion + IOxAPIC routing.
        mov rdi, r14;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_es_io;

        mov r10, 0x06900000;             // RXEVCFG | RXINV | IOXAPIC
        mov r11, 0xFFFFFFFFFFFFFFFF;
        xor r10, r11;
        and rax, r10;                    // clear exactly those three fields

        mov r10, 0x00100000;             // route to IOxAPIC
        or  rax, r10;

        cmp r13, 3;
        je  gpio_pad_es_both;
        // RISING and FALLING both use RXEVCFG = EDGE; FALLING inverts.
        mov r10, 1;                      // RXEVCFG_EDGE
        shl r10, 25;
        or  rax, r10;
        cmp r13, 2;
        jne gpio_pad_es_pad_store;
        mov r10, 0x00800000;             // RXINV
        or  rax, r10;
        jmp gpio_pad_es_pad_store;

      gpio_pad_es_both:
        mov r10, 3;                      // RXEVCFG_BOTH
        shl r10, 25;
        or  rax, r10;

      gpio_pad_es_pad_store:
        mov rdi, r14;
        mov rsi, rax;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_es_io;

        // -- (2) Clear any stale status. GPI_IS is write-1-to-clear, so
        //        writing the bit knocks it down and leaves the other 31
        //        alone without a read.
        mov rdi, [rsp + 8];
        mov rsi, r15;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_es_io;

        // -- (3) Enable, preserving the other 31 pads' enables.
        mov rdi, [rsp + 16];
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_es_io;
        or  rax, r15;
        mov rdi, [rsp + 16];
        mov rsi, rax;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_es_io;

        // Register the subscription and cache the trigger.
        mov rdi, r12;
        mov rsi, r13;
        call gpio_pad_sub_add;
        mov r10, 0xFFFFFEE6;
        cmp rax, r10;
        je  gpio_pad_es_full;

        xor rax, rax;
        jmp gpio_pad_es_out;

      gpio_pad_es_disable:
        // trig == NONE on a line that is not subscribed: nothing to do
        // beyond forcing RXEVCFG to DISABLED, which is a no-op refusal
        // rather than an error, so a caller can always reach a known
        // quiet state.
        mov rdi, [rsp + 16];
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_es_io;
        mov r10, r15;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        xor r10, r11;
        and rax, r10;
        mov rdi, [rsp + 16];
        mov rsi, rax;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_es_io;

        mov rdi, r14;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_es_io;
        mov r10, 0x06000000;             // RXEVCFG
        mov r11, 0xFFFFFFFFFFFFFFFF;
        xor r10, r11;
        and rax, r10;
        mov r10, 2;                      // RXEVCFG_DISABLED
        shl r10, 25;
        or  rax, r10;
        mov rdi, r14;
        mov rsi, rax;
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_pad_es_io;

        xor rax, rax;
        jmp gpio_pad_es_out;

      gpio_pad_es_bad_trig:
        mov rax, 0xFFFFFEEC;
        jmp gpio_pad_es_out;
      gpio_pad_es_bad_slot:
        mov rax, 0xFFFFFEEF;
        jmp gpio_pad_es_out;
      gpio_pad_es_not_in:
        mov rax, 0xFFFFFEE9;
        jmp gpio_pad_es_out;
      gpio_pad_es_already:
        mov rax, 0xFFFFFEE5;
        jmp gpio_pad_es_out;
      gpio_pad_es_full:
        mov rax, 0xFFFFFEE6;
        jmp gpio_pad_es_out;
      gpio_pad_es_no_comm:
        mov rax, 0xFFFFFEE7;
        jmp gpio_pad_es_out;
      gpio_pad_es_io:
        mov rax, 0xFFFFFEE8;

      gpio_pad_es_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_sub_add(slot, trig) -> GPIO_PAD_OK | GPIO_PAD_SUB_FULL
  // ==========================================================================

  pub let gpio_pad_sub_add : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (trig: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): claim a registry entry for `slot` and record the trigger and the subscribed flag in the row's cached configuration. Called only from gpio_pad_edge_subscribe and only after the hardware is already armed, so a full registry is reported (GPIO_PAD_SUB_FULL) with the pad left enabled and the caller expected to unsubscribe -- the alternative, silently not registering, is an enabled interrupt with no ISR entry servicing it. The trig value has already been range-checked by the caller and is masked to two bits here as belt and braces, not as a repair. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_sa_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // slot
        mov r13, rsi;
        and r13, 3;                      // trig

        mov r9, r12;
        add r9, 1;
        lea r10, [rip + _gpio_pad_sub];
        xor rcx, rcx;
      gpio_pad_sa_free:
        cmp rcx, 4;
        jae gpio_pad_sa_full;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  gpio_pad_sa_take;
        add rcx, 1;
        jmp gpio_pad_sa_free;

      gpio_pad_sa_take:
        mov [r10 + rcx * 8], r9;

        mov rdi, r12;
        call gpio_line_cfg_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sa_ok;
        mov r10, 0x07;                   // clear trigger [4:3] and sub [5]
        and rax, r10;
        mov r11, r13;
        shl r11, 3;
        or  rax, r11;
        mov r11, 1;
        shl r11, 5;
        or  rax, r11;                    // subscribed
        mov rdi, r12;
        mov rsi, rax;
        call gpio_line_set_cfg_of_slot;

      gpio_pad_sa_ok:
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpio_pad_sa_full:
        mov rax, 0xFFFFFEE6;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_edge_unsubscribe(slot) -> GPIO_PAD_OK | error   [CONFIG]
  // ==========================================================================

  pub let gpio_pad_edge_unsubscribe : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (slot: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): disarm a line. GPIO_PAD_NOT_SUB if it was never subscribed -- distinct from success, because 'it is already quiet' and 'I quietened it' differ when two components believe they own the same pin. Disables in GPI_IE FIRST and sets RXEVCFG to DISABLED second, the reverse of subscribe, so at no point is a configured edge left enabled with nothing servicing it. Clears the registry entry and the cached trigger and subscribed bits. ARITY ONE. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_eu_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov rdi, r12;
        call gpio_pad_sub_find;
        cmp rax, 4;
        jae gpio_pad_eu_not_sub;
        mov r13, rax;                    // registry index

        mov rdi, r12;
        mov rsi, 0;                      // GPIO_TRIG_NONE
        call gpio_pad_edge_subscribe;
        mov r10, 0xFFFFFEE0;             // GPIO_PAD_BAND_LOW
        cmp rax, r10;
        jae gpio_pad_eu_out;             // propagate the seam's refusal

        lea r10, [rip + _gpio_pad_sub];
        xor rax, rax;
        mov [r10 + r13 * 8], rax;

        mov rdi, r12;
        call gpio_line_cfg_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_eu_ok;
        mov r10, 0x07;                   // clear [5:3]
        and rax, r10;
        mov rdi, r12;
        mov rsi, rax;
        call gpio_line_set_cfg_of_slot;

      gpio_pad_eu_ok:
        xor rax, rax;
        jmp gpio_pad_eu_out;

      gpio_pad_eu_not_sub:
        mov rax, 0xFFFFFEE4;

      gpio_pad_eu_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_edge_count(slot) -> serviced edges | error      [OBSERVE]
  // gpio_pad_edge_storm(slot) -> 0 | 1 | error               [OBSERVE]
  // ==========================================================================

  pub let gpio_pad_edge_count : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): how many edges the ISR has serviced on this line, from [row+24][31:0]. GPIO_PAD_BAD_SLOT for a line that does not resolve; a live line that has seen no edges returns 0, which is why the failure answer must not also be 0. ARITY ONE. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed gpio_pad_ec_.",
      block: {
        push rbx;

        call gpio_line_edge_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_ec_bad;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        pop rbx;
        ret;

      gpio_pad_ec_bad:
        mov rax, 0xFFFFFEEF;
        pop rbx;
        ret
      }
    }

  pub let gpio_pad_edge_storm : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): 1 iff the ISR hit its per-line service bound on this line and masked it, from [row+24][32]. THE OBSERVABLE THE BOUND EXISTS FOR: a bound nothing can see is a bound nobody can test, and an interrupt that was silently masked is indistinguishable from one that never fired. GPIO_PAD_BAD_SLOT for a line that does not resolve. ARITY ONE. Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed gpio_pad_et_.",
      block: {
        push rbx;

        call gpio_line_edge_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_et_bad;
        shr rax, 32;
        and rax, 1;
        pop rbx;
        ret;

      gpio_pad_et_bad:
        mov rax, 0xFFFFFEEF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_pad_sub_bump(idx) -> ()   — ISR-facing, bounded
  // gpio_pad_sub_storm(idx) -> ()  — ISR-facing, bounded
  // ==========================================================================

  pub let gpio_pad_sub_bump : (u64) -> () !{mem} @{cap} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-004 (#1078): increment the serviced-edge count of the line registered at idx, saturating at 0xFFFFFFFF rather than wrapping into the storm flag one bit above it -- a counter that wraps into a neighbouring field is a counter that eventually reports a storm that did not happen. Bounded: two table reads, one compare, one store, no loop. Called from interrupt context and on the ISR's allowlist. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_sb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        call gpio_pad_sub_slot;
        cmp rax, 0;
        je  gpio_pad_sb_out;
        mov r12, rax;                    // slot

        mov rdi, r12;
        call gpio_line_edge_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_sb_out;
        mov r13, rax;

        mov r10, r13;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        cmp r10, r11;
        je  gpio_pad_sb_out;             // saturated
        add r13, 1;

        mov rdi, r12;
        mov rsi, r13;
        call gpio_line_set_edge_of_slot;

      gpio_pad_sb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpio_pad_sub_storm : (u64) -> () !{sysreg, mem} @{boot, cap} =
    fn (idx: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): THE STORM RESPONSE. Sets [row+24][32] and MASKS the line in GPI_IE. Masking is the only correct answer to a status bit that will not clear: the alternative is to return from the ISR with the condition still asserted, which re-enters immediately and forever -- a livelock, not a slow system, because the interrupt has higher priority than everything that could fix it. Deliberately does NOT clear the registry entry: the subscription is still owned by its capability and the operator-visible state must remain 'this line was masked because it stormed', not 'this line was never subscribed'. Bounded: one read-modify-write of GPI_IE and two row accesses, no loop. Four pushes plus one padding push leave rsp%16 == 0 at every nested call. Labels prefixed gpio_pad_st_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        call gpio_pad_sub_slot;
        cmp rax, 0;
        je  gpio_pad_st_out;
        mov r12, rax;                    // slot

        mov rdi, r12;
        call gpio_pad_ie_off_of_slot;
        mov r10, 0xFFFFFEE7;
        cmp rax, r10;
        je  gpio_pad_st_flag;
        mov r13, rax;

        mov rdi, r12;
        call gpio_pad_bit_of_slot;
        cmp rax, 0;
        je  gpio_pad_st_flag;
        mov r14, rax;

        mov rdi, r13;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_st_flag;
        mov r10, r14;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        xor r10, r11;
        and rax, r10;
        mov rdi, r13;
        mov rsi, rax;
        call gpio_io_write32;

      gpio_pad_st_flag:
        mov rdi, r12;
        call gpio_line_edge_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  gpio_pad_st_out;
        mov r10, 1;
        shl r10, 32;
        or  rax, r10;
        mov rdi, r12;
        mov rsi, rax;
        call gpio_line_set_edge_of_slot;

      gpio_pad_st_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
