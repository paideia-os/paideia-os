// src/kernel/core/drivers/gpio/gpio_io.pdx — R30.M6-002 (#1076)
//
// THE register-access seam for the Intel LPSS / PCH pad controller.
//
// Two things live here and nowhere else: the capability check that
// stands between this driver and the controller's registers, and the
// ordered access trace that makes the probe sequence checkable.
//
// This is `core/drivers/i2c/dw_io.pdx` applied to a second controller,
// deliberately and to the letter. A second harness STYLE would be worse
// than a second harness: the assertions this milestone needs are the
// same assertions — "the window capability was checked", "the register
// this driver touched was the one it meant to touch", "a revoked window
// stops access immediately" — and two shapes of answer to the same
// question is how one of them quietly stops being asked.
//
// -----------------------------------------------------------------------------
// 1. THE BAR IS REACHED THROUGH A CAPABILITY, NOT AN ADDRESS
// -----------------------------------------------------------------------------
//
// `gpio_io_read32(off)` and `gpio_io_write32(off, val)` take an OFFSET.
// There is no entry point in this module that accepts a physical
// address, and there is no way to obtain one from it. The base comes
// from a bound `KIND_OP_REGION` capability, resolved on EVERY access
// through `opregion_row_base` / `opregion_row_len` — which, because
// `tools/build.sh` confines `_op_region_table` to `kind_op_region.o`,
// are the only functions in the kernel that can produce it.
//
// The consequences are the ones #1072 spelled out for I²C, and they
// matter MORE here:
//
//   * Revoking the window capability stops register access immediately.
//     The row goes dead, `opregion_row_base` returns OPREG_DECODE_BAD,
//     and every subsequent access is refused GPIO_IO_DEAD_ROW. There is
//     no cached base to go stale into a still-working pointer.
//   * A window minted READ-only refuses writes (GPIO_IO_NO_WRITE). On a
//     pad controller that is not a nicety: a read-only mapping is the
//     difference between a component that may INSPECT pin state and one
//     that may CHANGE it, and pin state on this part includes device
//     resets and rail enables.
//   * An offset outside the window is REFUSED, not wrapped or clamped
//     (GPIO_IO_RANGE). Clamping an out-of-window offset would pick some
//     OTHER pad's configuration register, which is precisely the class
//     of accident R30.M6 exists to make unreachable.
//   * There is no SECOND path. `tools/build.sh` asserts by `objdump -r`
//     that no other object under `core/drivers/gpio/` relocates against
//     `opregion_row_base` or `opregion_row_len`.
//
// The checks run in BOTH modes. Only the final load or store differs.
// If the capability check were skipped under the synthetic window, the
// rights assertions in the witness would be assertions about nothing.
//
// -----------------------------------------------------------------------------
// 2. THE ORDERED ACCESS TRACE
// -----------------------------------------------------------------------------
//
// The claims worth making about a pad-controller probe are ORDERING and
// TARGETING claims:
//
//   * the community header was read BEFORE any pad register derived
//     from it — because the pad region's offset comes from PADBAR, and a
//     driver that computed a pad address before reading PADBAR computed
//     it from something else;
//   * the driver never WROTE a community header register — REVID,
//     CAPLIST and PADBAR are read-only on the part, and a RAM-backed
//     synthetic window would silently absorb such a write and then
//     answer with it;
//   * a read aimed at community 1 pad 5 landed on the offset community 1
//     pad 5 actually occupies, and not on community 0's.
//
// None of those is checkable from final state. The first is an ordering
// claim and both orderings reach the same final state; the second and
// third are claims about WHICH ADDRESS was touched, which final state
// cannot distinguish from a lucky value. They are checkable only by
// observing the sequence, which is what this trace is.
//
// Same device as `core/acpi/gpe_io.pdx` and `core/drivers/i2c/dw_io.pdx`,
// same saturate-rather-than-wrap discipline: a wrapped trace can present
// a pad access as preceding the PADBAR read it in fact followed, which
// silently inverts the strongest assertion in the milestone.
//
// Record: 3 qwords, 24 B — `+0 op`, `+8 offset`, `+16 value`.
//
// -----------------------------------------------------------------------------
// 3. THE SYNTHETIC WINDOW IS A PLAIN CELL ARRAY, AND THAT IS HONEST
// -----------------------------------------------------------------------------
//
// `dw_io.pdx` carries a device MODEL rather than a RAM buffer because
// the DesignWare registers it drives are not storage: read-to-clear
// abort status, a FIFO port, an asynchronous enable. Nothing this
// milestone touches on the pad controller is like that. REVID, CAPLIST
// and PADBAR are read-only identity registers; PADCFG0..3 are ordinary
// read/write configuration words. A cell array is a FAITHFUL model of
// all of them, and inventing behaviour they do not have would make the
// fixture test a device that does not exist.
//
// The first non-storage register on this part is GPI_IS — the interrupt
// status, which is write-1-to-clear — and it arrives with R30.M6-004
// (#1078), which is the issue that drives it. Modelling it now would be
// modelling a register nothing reads.
//
// What IS modelled, because the fixture depends on it: `gpio_io_synth_poke`
// seeds a cell WITHOUT appending to the trace, so the ordering and
// targeting assertions read the trace as a record of what the DRIVER did
// rather than of what the fixture arranged.
//
// -----------------------------------------------------------------------------
// 4. paideia-as posture
// -----------------------------------------------------------------------------
//
//   paideia-as#1312 (port I/O carries no effect-row or capability
//   coupling) DOES NOT APPLY HERE. This module performs no port I/O.
//   MMIO is the case R29.M2-002 already closed: `!{Mmio}` requires a
//   matching `paideia.mmio` capability at elaboration.
//
//   G1: `mov [mem], reg32` widens to 8 bytes — every 32-bit MMIO store
//   uses `mov_d`. 32-bit loads via `mov eax, [rax]` zero-extend and need
//   no workaround (SDM Vol 2A §3.4.1.1).
//
//   Reserved-label discipline: labels prefixed `gpio_io_`.

module GpioIo = structure {

  // ==========================================================================
  // Modes
  // ==========================================================================

  pub let GPIO_IO_MODE_MMIO  : u64 = 0
  pub let GPIO_IO_MODE_SYNTH : u64 = 1

  // ==========================================================================
  // Trace
  // ==========================================================================

  pub let GPIO_TRACE_MAX       : u64 = 256
  pub let GPIO_TRACE_OP_READ   : u64 = 1
  pub let GPIO_TRACE_OP_WRITE  : u64 = 2
  pub let GPIO_TRACE_NOT_FOUND : u64 = 0xFFFFFFFFFFFFFFFF

  pub let GPIO_TRACE_F_OP    : u64 = 0
  pub let GPIO_TRACE_F_OFF   : u64 = 1
  pub let GPIO_TRACE_F_VALUE : u64 = 2

  // ==========================================================================
  // Synthetic window geometry
  //
  // 8 KiB, which is what a two-community fixture needs: each community
  // has its OWN register window inside the BAR, so a fixture that fitted
  // both communities into one 4 KiB page would be a fixture in which the
  // community base offset barely varies — and "the mapping used the
  // right community base" is the assertion this milestone exists to
  // make. 0x2000 puts community 1 a whole page away from community 0,
  // so a driver that lost the community term produces an offset that is
  // wrong by a visible amount rather than by a plausible one.
  // ==========================================================================

  pub let GPIO_SYNTH_BYTES : u64 = 0x2000

  // ==========================================================================
  // Failure taxonomy — band 0xFFFFFF08..0xFFFFFF0F
  //
  // Disjoint from DRIVER_LIFECYCLE_* (0xFFFFFF00..07) directly below,
  // and from GPIO_LINE_* (0xFFFFFF10..1F), LPSS_GPIO_* (0xFFFFFF20..2F),
  // DW_IO_* (0xFFFFFF30..3F), LPSS_I2C_* (0xFFFFFF40..5F), I2C_XFER_*
  // (0xFFFFFF60..6F), I2C_SLAVE_* (0xFFFFFF70..7F), I2C_BUS_*
  // (0xFFFFFF80..8F), ACPI_EVT_* (0xFFFFFF90..9F), DRV_RESTART_*
  // (0xFFFFFFB5..BE), OPREG_* (0xFFFFFFC2..CF), DMA_* (0xFFFFFFD5..DF),
  // MSIX_* (0xFFFFFFE7..EF) and HW_INT_* (0xFFFFFFF7..FF).
  //
  // A seam refusal and a probe refusal must never be confusable: one
  // says "you were not allowed to touch that register", the other says
  // "the part is not what we expected".
  // ==========================================================================

  pub let GPIO_IO_OK         : u64 = 0
  pub let GPIO_IO_UNBOUND    : u64 = 0xFFFFFF0F
  pub let GPIO_IO_WRONG_KIND : u64 = 0xFFFFFF0E
  pub let GPIO_IO_DEAD_ROW   : u64 = 0xFFFFFF0D
  pub let GPIO_IO_NO_READ    : u64 = 0xFFFFFF0C
  pub let GPIO_IO_NO_WRITE   : u64 = 0xFFFFFF0B
  pub let GPIO_IO_RANGE      : u64 = 0xFFFFFF0A
  pub let GPIO_IO_BAD_ARG    : u64 = 0xFFFFFF09

  // R30.M6-004 (#1078): the W1C registry is full. Takes the band's last
  // free code, which is also its low edge — the accessors recognise any
  // refusal with `jae GPIO_IO_BAND_LOW`, so assigning the edge itself
  // keeps that one-compare test exact rather than off by one.
  pub let GPIO_IO_W1C_FULL   : u64 = 0xFFFFFF08

  // The low edge of the band, used by the accessors to recognise ANY
  // refusal the gate can return in one compare.
  pub let GPIO_IO_BAND_LOW   : u64 = 0xFFFFFF08

  // A failed read returns this. It cannot collide with a real value:
  // every pad-controller register is 32 bits wide and this is 64 bits set.
  pub let GPIO_IO_FAULT      : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Module storage. Confined to this object; tools/build.sh asserts it.
  // ==========================================================================

  pub let mut _gpio_io_mode     : u64 = 0
  pub let mut _gpio_io_win_slot : u64 = 0    // 0 = unbound; slot 0 is never a window
  pub let mut _gpio_io_bound    : u64 = 0
  pub let mut _gpio_io_trace_n  : u64 = 0
  pub let mut _gpio_io_synth_ram : [u64; 1024] = uninit @align(64)
  pub let mut _gpio_io_trace     : [u64; 768]  = uninit @align(64)

  // R30.M6-004 (#1078): WRITE-1-TO-CLEAR REGISTER SEMANTICS.
  //
  // Sixteen entries, each holding `offset + 1` so that .bss zero-init
  // means "empty" without stealing offset 0 from the address space.
  //
  // WHY THIS EXISTS AT ALL, since a synthetic register is "just RAM":
  //
  // R30.M6-002 shipped the synthetic side as a plain cell array and said
  // so explicitly, on the grounds that nothing in that milestone drove a
  // NON-STORAGE register. GPI_IS — the pad controller's per-pad
  // interrupt status word — is not storage. It is write-1-to-clear: the
  // part sets a bit when an edge arrives, and the only thing software
  // can do to that bit is write a 1 to the same position to knock it
  // down. Writing 0 does nothing. Writing 1 does not SET it.
  //
  // A cell array ABSORBS a W1C write and then answers with the value
  // written. So against a cell array:
  //
  //   * an ISR that writes the bit back (correct: clears the status), and
  //   * an ISR that never writes anything (broken: status stays set, the
  //     line re-interrupts forever),
  //
  // are DISTINGUISHABLE only by inspection, never by the test — the first
  // leaves the cell holding `bit`, the second leaves the cell holding
  // `bit`, and both re-enter. An edge-interrupt test written against that
  // model tests nothing about interrupt acknowledgement. That is why this
  // lands with #1078 and not after it: the clear path and its test arrive
  // together or the test is theatre.
  //
  // A registered offset therefore behaves as `cell &= ~value` on write.
  // An UNregistered offset keeps the old store-what-you-wrote behaviour,
  // which is correct for PADCFG0/PADCFG1 and every other read-write
  // register on the part.
  //
  // The registry is fixture-driven rather than baked in because the
  // community-relative offset of GPI_IS is a property of the platform
  // description, not of this file — see gpio_pad.pdx §Interrupt registers.
  pub let GPIO_IO_W1C_MAX : u64 = 16
  pub let mut _gpio_io_w1c : [u64; 16] = uninit @align(64)

  // ==========================================================================
  // gpio_io_trace_reset() -> ()
  // ==========================================================================

  pub let gpio_io_trace_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): drop the ordering trace to empty. Only the record count is reset; bytes past the count are unreachable through gpio_io_trace_field, which bounds every read against the count. Leaf. Labels prefixed gpio_io_trst_.",
      block: {
        lea r10, [rip + _gpio_io_trace_n];
        xor rax, rax;
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  pub let gpio_io_trace_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): number of accesses recorded since the last reset, SATURATING at GPIO_TRACE_MAX. The append reserves its slot with an atomic fetch-and-add, so the raw cell can climb past 256 while the records stop at 256 -- the reservation counts attempts, the array holds what fitted. Clamping here and in the three readers is what keeps the observable count saturating rather than wrapping, which is the property every ordering assertion depends on: a witness that expected N records and sees 256 reports a count mismatch, whereas a witness reading a wrapped index would compare positions that no longer mean what they say. Leaf load. Labels prefixed gpio_io_tc_.",
      block: {
        lea r10, [rip + _gpio_io_trace_n];
        mov rax, [r10 + 0];
        mov r11, 256;
        cmp rax, r11;
        jbe gpio_io_tc_out;
        mov rax, 256;
      gpio_io_tc_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_io_trace_field(idx, field) -> value, or 0 out of range
  // ==========================================================================

  pub let gpio_io_trace_field : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): bounds-checked read into the ordering trace. Guards precede all address arithmetic: field < 3 and idx < the live record count, so no byte past the written prefix is read. Offset = idx*24 + field*8, with idx*24 formed as idx*8 + idx*16 because the encoder has no 24 stride in its scaled-index forms. Leaf, read-only. Labels prefixed gpio_io_tf_.",
      block: {
        cmp rsi, 3;
        jae gpio_io_tf_zero;
        lea r10, [rip + _gpio_io_trace_n];
        mov r10, [r10 + 0];
        mov r11, 256;
        cmp r10, r11;
        jbe gpio_io_tf_have;
        mov r10, 256;
      gpio_io_tf_have:
        cmp rdi, r10;
        jae gpio_io_tf_zero;

        mov rax, rdi;
        shl rax, 3;
        mov r11, rdi;
        shl r11, 4;
        add rax, r11;
        mov r11, rsi;
        shl r11, 3;
        add rax, r11;

        lea r10, [rip + _gpio_io_trace];
        add r10, rax;
        mov rax, [r10 + 0];
        ret;

      gpio_io_tf_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_io_trace_append(op, off, value) -> ()
  // ==========================================================================

  pub let gpio_io_trace_append : (u64, u64, u64) -> () !{mem} @{} =
    fn (op: u64, off: u64, value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): append one access record, SATURATING rather than wrapping at GPIO_TRACE_MAX. Saturation is deliberate, exactly as in gpe_io_trace_append and dw_io_trace_append: a wrapped ordering trace can present a pad access as preceding the PADBAR read it in fact followed, which silently inverts the strongest assertion in this milestone. A saturated trace instead reports fewer records than expected, which the witness detects as a count mismatch and reports as a failure. The index reservation is an ATOMIC fetch-and-add rather than a read-modify-write, for the reason #1074 established for the I2C seam: once R30.M6-004 binds a pad-controller interrupt, the service routine reaches registers through this same seam, and an interrupt landing between a thread's read of the count and its write-back loses one record and OVERWRITES another -- producing a trace in which two accesses share a position, which is exactly the corruption that makes an ordering assertion say the opposite of the truth. lock_xadd_q reserves a slot in one indivisible step; the reserving CPU fills ITS slot and nobody else's, so records may be dropped past the end but never aliased. Leaf. Labels prefixed gpio_io_ta_.",
      block: {
        lea r10, [rip + _gpio_io_trace_n];
        mov rax, 1;
        lock_xadd_q [r10], rax;          // rax = the slot reserved for us
        mov r11, 256;
        cmp rax, r11;
        jae gpio_io_ta_full;

        mov r11, rax;
        shl r11, 3;
        mov r9, rax;
        shl r9, 4;
        add r11, r9;

        lea r9, [rip + _gpio_io_trace];
        add r9, r11;
        mov [r9 + 0],  rdi;
        mov [r9 + 8],  rsi;
        mov [r9 + 16], rdx;
        ret;

      gpio_io_ta_full:
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_io_trace_find(op, off, from) -> idx | GPIO_TRACE_NOT_FOUND
  // ==========================================================================

  pub let gpio_io_trace_find : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (op: u64, off: u64, from: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): first record at index >= from whose op and register offset both match. Returns the INDEX and not a boolean, which is what lets the witness state its assertions as inequalities between positions -- padbar_idx < pad_idx -- the only form in which an ordering claim is checkable. It is also the form in which a TARGETING claim is checkable: 'there is a read at 0x1750 and there is no read at 0x650' is two calls to this function, and no amount of final register state can distinguish those two cases. Bounded by the live record count. Leaf, read-only. Labels prefixed gpio_io_tfd_.",
      block: {
        lea r10, [rip + _gpio_io_trace_n];
        mov r10, [r10 + 0];
        mov r11, 256;
        cmp r10, r11;
        jbe gpio_io_tfd_have;
        mov r10, 256;
      gpio_io_tfd_have:
        mov rax, rdx;

      gpio_io_tfd_next:
        cmp rax, r10;
        jae gpio_io_tfd_miss;

        mov r9, rax;
        shl r9, 3;
        mov r11, rax;
        shl r11, 4;
        add r9, r11;
        lea r11, [rip + _gpio_io_trace];
        add r11, r9;

        mov r9, [r11 + 0];
        cmp r9, rdi;
        jne gpio_io_tfd_bump;
        mov r9, [r11 + 8];
        cmp r9, rsi;
        jne gpio_io_tfd_bump;
        ret;

      gpio_io_tfd_bump:
        add rax, 1;
        jmp gpio_io_tfd_next;

      gpio_io_tfd_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Window binding
  //
  // gpio_io_bind(win_slot) -> GPIO_IO_OK | error
  //
  // Records WHICH CAPABILITY SLOT the seam speaks through. It does not
  // record, and cannot compute, an address: every access re-resolves the
  // slot, so a revoked window stops working with no cache to go stale.
  // ==========================================================================

  pub let gpio_io_bind : (u64) -> u64 !{mem} @{cap} =
    fn (win_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): bind the seam to a KIND_OP_REGION capability slot. Validates slot < 256 and kind == 0x150 at bind time as an early, legible refusal, but the check is REPEATED on every access and the bind-time one is therefore not load-bearing -- which is deliberate. A bind-time-only check would be a time-of-check-to-time-of-use hole exactly the width of a revoke: the window could be revoked, its slot reused for something else, and the seam would still be writing to what it believed was a pad controller. Storing the SLOT rather than the base is what closes it. cap_table stride is 24 (kind at +0, rights at +8, target_ptr at +16). Leaf, no nested calls. Labels prefixed gpio_io_bd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae gpio_io_bd_bad;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x150;                  // KIND_OP_REGION
        cmp r10, r11;
        jne gpio_io_bd_kind;

        lea r10, [rip + _gpio_io_win_slot];
        mov [r10 + 0], rdi;
        lea r10, [rip + _gpio_io_bound];
        mov r11, 1;
        mov [r10 + 0], r11;
        xor rax, rax;
        ret;

      gpio_io_bd_kind:
        mov rax, 0xFFFFFF0E;             // GPIO_IO_WRONG_KIND
        ret;
      gpio_io_bd_bad:
        mov rax, 0xFFFFFF09;             // GPIO_IO_BAD_ARG
        ret
      }
    } @no_frame

  pub let gpio_io_unbind : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): detach the seam from any window. Every subsequent access is refused GPIO_IO_UNBOUND. Called on every fixture exit so a witness failure cannot leave the seam pointed at a capability the next boot stage will reuse. Leaf.",
      block: {
        lea r10, [rip + _gpio_io_bound];
        xor rax, rax;
        mov [r10 + 0], rax;
        lea r10, [rip + _gpio_io_win_slot];
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  pub let gpio_io_window_slot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): the currently bound window capability slot, or 0 when unbound. Observability only; nothing in the access path reads it through this function. Leaf load. Labels prefixed gpio_io_ws_.",
      block: {
        lea r10, [rip + _gpio_io_bound];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  gpio_io_ws_none;
        lea r10, [rip + _gpio_io_win_slot];
        mov rax, [r10 + 0];
        ret;
      gpio_io_ws_none:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_io_check(want_right) -> row_id | error
  //
  // THE GATE. Resolves the bound slot to a live KIND_OP_REGION row after
  // checking the requested direction right. Called by both accessors and
  // by nothing else.
  // ==========================================================================

  pub let gpio_io_check : (u64) -> u64 !{mem} @{cap} =
    fn (want_right: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M6-002 (#1076): re-resolve the bound window capability and check the direction right, returning the live row id. Order matters and is: bound -> slot in range -> kind == KIND_OP_REGION (0x150) -> rights contain want_right -> row live. Kind BEFORE rights, because a slot whose window was revoked and reused for a KIND_THREAD would otherwise have its unrelated rights word tested against R_OPREG_WRITE and could pass. Row liveness LAST, via opregion_tail_valid, because that is the one check requiring a call and the cheap refusals should not pay for it. want_right is 0x001 (READ) or 0x002 (WRITE) -- the seam never asks for both, so a window minted read-only is refused on the write path specifically and with its own code rather than being refused entry, which is what makes a read-only mapping of a pad controller a real authority rather than a naming convention. One push (rbx, carrying the row id across the nested call) leaves rsp%16 == 0 at that call. Labels prefixed gpio_io_ck_.",
      block: {
        push rbx;

        lea r10, [rip + _gpio_io_bound];
        mov r10, [r10 + 0];
        cmp r10, 0;
        je  gpio_io_ck_unbound;

        lea r10, [rip + _gpio_io_win_slot];
        mov r10, [r10 + 0];
        mov r9, 256;
        cmp r10, r9;
        jae gpio_io_ck_unbound;

        mov rax, cap_table;
        mov r8, r10;
        shl r8, 3;
        mov r9, r10;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r11, [rax + 0];
        mov r9, 0x150;                   // KIND_OP_REGION
        cmp r11, r9;
        jne gpio_io_ck_kind;

        mov r11, [rax + 8];              // rights
        and r11, rdi;
        cmp r11, rdi;
        jne gpio_io_ck_right;

        mov rbx, [rax + 16];
        mov r9, 0xFFFF;
        and rbx, r9;                     // row_id

        mov rdi, rbx;
        call opregion_tail_valid;
        cmp rax, 1;
        jne gpio_io_ck_dead;

        mov rax, rbx;
        pop rbx;
        ret;

      gpio_io_ck_right:
        // Which right was refused is knowable from the argument, and the
        // two codes are distinct because "this window is read-only" and
        // "this window is write-only" are different operator problems.
        cmp rdi, 2;
        je  gpio_io_ck_nowrite;
        mov rax, 0xFFFFFF0C;             // GPIO_IO_NO_READ
        pop rbx;
        ret;
      gpio_io_ck_nowrite:
        mov rax, 0xFFFFFF0B;             // GPIO_IO_NO_WRITE
        pop rbx;
        ret;
      gpio_io_ck_kind:
        mov rax, 0xFFFFFF0E;             // GPIO_IO_WRONG_KIND
        pop rbx;
        ret;
      gpio_io_ck_dead:
        mov rax, 0xFFFFFF0D;             // GPIO_IO_DEAD_ROW
        pop rbx;
        ret;
      gpio_io_ck_unbound:
        mov rax, 0xFFFFFF0F;             // GPIO_IO_UNBOUND
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Synthetic window primitives — raw 32-bit cells, untraced.
  // ==========================================================================

  pub let gpio_io_synth_load : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): raw untraced 32-bit load from the synthetic window. Offsets are validated by the caller (the accessor has already bounds-checked against the capability's own length); this function additionally refuses off >= GPIO_SYNTH_BYTES so it is total on its own, and returns 0 there rather than reading past an 8192-byte object. Leaf. Labels prefixed gpio_io_sl_.",
      block: {
        mov rax, 0x2000;
        cmp rdi, rax;
        jae gpio_io_sl_zero;
        lea r10, [rip + _gpio_io_synth_ram];
        add r10, rdi;
        xor rax, rax;
        mov eax, [r10];
        ret;
      gpio_io_sl_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gpio_io_synth_store_raw : (u64, u64) -> () !{mem} @{} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076), renamed by R30.M6-004 (#1078): raw untraced 32-bit store into the synthetic window, with NO register semantics applied -- the cell ends up holding exactly what was passed. G1: mov_d, because a bare mov [mem], reg widens to REX.W and would write eight bytes over the neighbouring register cell -- and on a pad controller the neighbouring cell of PADCFG0 is PADCFG1, i.e. the exact corruption this driver must not commit against real registers either. Out-of-window offsets are dropped. This is now the FIXTURE-SEEDING path only: it is what lets a fixture SET a write-1-to-clear status bit, which is a thing only the hardware can do and therefore a thing the driver-facing store must not be able to do. Leaf. Labels prefixed gpio_io_ss_.",
      block: {
        mov rax, 0x2000;
        cmp rdi, rax;
        jae gpio_io_ss_out;
        lea r10, [rip + _gpio_io_synth_ram];
        add r10, rdi;
        mov_d [r10], rsi;
      gpio_io_ss_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // W1C registry — see §_gpio_io_w1c above for why it exists.
  // ==========================================================================

  pub let gpio_io_synth_w1c_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-004 (#1078): forget every registered write-1-to-clear offset. Called by gpio_io_synth_enable so a fixture never inherits the previous one's register semantics -- a PADCFG0 that behaved as W1C because an earlier fixture had marked that offset for a different community would make every configuration write silently a no-op, which is precisely the class of failure this model exists to expose rather than create. Leaf; sixteen qword stores. Labels prefixed gpio_io_wr_.",
      block: {
        lea r10, [rip + _gpio_io_w1c];
        xor rax, rax;
        xor rcx, rcx;
      gpio_io_wr_clear:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  gpio_io_wr_clear;
        ret
      }
    } @no_frame

  pub let gpio_io_synth_w1c_mark : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-004 (#1078): declare that the synthetic register at `off` is write-1-to-clear. Refuses rather than repairs, three ways, each distinct: off >= GPIO_SYNTH_BYTES is GPIO_IO_RANGE (there is no such register); a misaligned off is GPIO_IO_BAD_ARG (every pad-controller register is a 32-bit dword at a dword-aligned offset, and a marked offset that straddles two cells would give one register two behaviours); a full registry is GPIO_IO_W1C_FULL, NOT a silent drop -- a dropped mark would leave the status register behaving as storage and the interrupt test would then be measuring the cell array again, which is the exact failure the registry exists to prevent, arriving silently. Re-marking an already-marked offset is idempotent GPIO_IO_OK. Entries hold off+1 so the .bss zero of an empty slot is unambiguous. Leaf, linear over sixteen. Labels prefixed gpio_io_wm_.",
      block: {
        mov rax, 0x2000;
        cmp rdi, rax;
        jae gpio_io_wm_range;

        mov rax, rdi;
        and rax, 3;
        cmp rax, 0;
        jne gpio_io_wm_bad;

        mov r9, rdi;
        add r9, 1;                       // stored form

        lea r10, [rip + _gpio_io_w1c];
        xor rcx, rcx;
      gpio_io_wm_scan:
        cmp rcx, 16;
        jae gpio_io_wm_place;
        mov rax, [r10 + rcx * 8];
        cmp rax, r9;
        je  gpio_io_wm_ok;               // already marked
        add rcx, 1;
        jmp gpio_io_wm_scan;

      gpio_io_wm_place:
        xor rcx, rcx;
      gpio_io_wm_free:
        cmp rcx, 16;
        jae gpio_io_wm_full;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  gpio_io_wm_take;
        add rcx, 1;
        jmp gpio_io_wm_free;

      gpio_io_wm_take:
        mov [r10 + rcx * 8], r9;

      gpio_io_wm_ok:
        xor rax, rax;                    // GPIO_IO_OK
        ret;

      gpio_io_wm_range:
        mov rax, 0xFFFFFF0A;             // GPIO_IO_RANGE
        ret;
      gpio_io_wm_bad:
        mov rax, 0xFFFFFF09;             // GPIO_IO_BAD_ARG
        ret;
      gpio_io_wm_full:
        mov rax, 0xFFFFFF08;             // GPIO_IO_W1C_FULL
        ret
      }
    } @no_frame

  pub let gpio_io_synth_is_w1c : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-004 (#1078): 1 iff `off` was registered write-1-to-clear. Compares against off+1 so an unmarked (zero) slot can never match offset 0. Leaf, linear over sixteen, pure read. Labels prefixed gpio_io_iw_.",
      block: {
        mov r9, rdi;
        add r9, 1;
        lea r10, [rip + _gpio_io_w1c];
        xor rcx, rcx;
      gpio_io_iw_scan:
        cmp rcx, 16;
        jae gpio_io_iw_no;
        mov rax, [r10 + rcx * 8];
        cmp rax, r9;
        je  gpio_io_iw_yes;
        add rcx, 1;
        jmp gpio_io_iw_scan;
      gpio_io_iw_yes:
        mov rax, 1;
        ret;
      gpio_io_iw_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gpio_io_synth_store : (u64, u64) -> () !{mem} @{} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-004 (#1078): the DRIVER-FACING synthetic store. For an ordinary offset it is gpio_io_synth_store_raw unchanged. For an offset registered write-1-to-clear it computes cell &= ~value and stores THAT -- so a 1 in the written value knocks the corresponding status bit down, a 0 leaves it alone, and no write can ever SET a status bit. The complement is formed by xor with 0xFFFFFFFF rather than a NOT so the 32-bit width is explicit at the instruction level; the surviving value is masked to 32 bits for the same reason. Two pushes (r12, r13) hold off and val across the is_w1c call and leave rsp%16 == 0 at it. Labels prefixed gpio_io_sw_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // off
        mov r13, rsi;                    // val
        mov r11, 0xFFFFFFFF;
        and r13, r11;

        mov rdi, r12;
        call gpio_io_synth_is_w1c;
        cmp rax, 0;
        je  gpio_io_sw_plain;

        // W1C: new = old & ~val, all within 32 bits.
        mov rdi, r12;
        call gpio_io_synth_load;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov r10, r13;
        xor r10, r11;                    // ~val (32-bit)
        and rax, r10;
        mov rdi, r12;
        mov rsi, rax;
        call gpio_io_synth_store_raw;
        pop r13;
        pop r12;
        ret;

      gpio_io_sw_plain:
        mov rdi, r12;
        mov rsi, r13;
        call gpio_io_synth_store_raw;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let gpio_io_synth_poke : (u64, u64) -> () !{mem} @{} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076), retargeted by R30.M6-004 (#1078): seed a synthetic register WITHOUT appending to the trace and WITHOUT register semantics. Untraced deliberately: the ordering and targeting assertions read the trace as a record of what the DRIVER did, and a fixture that seeded registers through the traced path would have to subtract its own setup from every position it compares -- and 'the driver read community 1 pad 5' would be indistinguishable from 'the fixture wrote community 1 pad 5'. Now calls gpio_io_synth_store_RAW rather than gpio_io_synth_store, and the distinction is the whole W1C model: a fixture seeding GPI_IS is standing in for the PART asserting an interrupt, and the part is the only thing that can set a write-1-to-clear bit. Routing the seed through the driver-facing store would make it impossible to arm the very condition the interrupt path is supposed to service. One push (rbx, unused) restores rsp%16 to 0 at the nested call. Labels prefixed gpio_io_pk_.",
      block: {
        push rbx;
        call gpio_io_synth_store_raw;
        pop rbx;
        ret
      }
    }

  pub let gpio_io_synth_peek : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): untraced 32-bit load from the synthetic window, for fixture assertions about final register state. One push (rbx) restores rsp%16 to 0 at the nested call. Labels prefixed gpio_io_pe_.",
      block: {
        push rbx;
        call gpio_io_synth_load;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Synth mode control
  // ==========================================================================

  pub let gpio_io_synth_enable : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): point the seam at the 8192-byte cell array. Zeroes the window and the trace so a fixture always starts from a known state -- a fixture that inherited a previous one's PADBAR would see a community accepted for the wrong reason. The mode defaults to GPIO_IO_MODE_MMIO from .bss zero-init, so a kernel that never calls this behaves exactly as if the synthetic side did not exist. Leaf; the 1024-qword clear is a counted loop. Labels prefixed gpio_io_se_.",
      block: {
        lea r10, [rip + _gpio_io_synth_ram];
        xor rax, rax;
        xor rcx, rcx;
      gpio_io_se_clear:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        mov r11, 1024;
        cmp rcx, r11;
        jb  gpio_io_se_clear;

        lea r10, [rip + _gpio_io_trace_n];
        mov [r10 + 0], rax;

        // R30.M6-004 (#1078): forget every registered W1C offset too.
        // Inlined rather than a call to gpio_io_synth_w1c_reset so this
        // function stays a leaf under @no_frame.
        lea r10, [rip + _gpio_io_w1c];
        xor rcx, rcx;
      gpio_io_se_w1c:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  gpio_io_se_w1c;

        lea r10, [rip + _gpio_io_mode];
        mov r11, 1;                      // GPIO_IO_MODE_SYNTH
        mov [r10 + 0], r11;
        ret
      }
    } @no_frame

  pub let gpio_io_synth_disable : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): return the seam to real MMIO. Called by every fixture on BOTH its success and its failure exits, so a witness failure cannot leave the kernel addressing a cell array in place of a pad controller. Leaf.",
      block: {
        lea r10, [rip + _gpio_io_mode];
        xor rax, rax;
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  pub let gpio_io_mode : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M6-002 (#1076): current seam mode. Leaf load.",
      block: {
        lea r10, [rip + _gpio_io_mode];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  // ==========================================================================
  // gpio_io_read32(off) -> value | GPIO_IO_FAULT
  //
  // THE read. Every pad-controller register this driver observes comes
  // through here.
  // ==========================================================================

  pub let gpio_io_read32 : (u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (off: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-002 (#1076): 32-bit read of a pad-controller register, THROUGH THE WINDOW CAPABILITY. Sequence, identical in both modes up to the final access: (1) gpio_io_check(R_OPREG_READ = 1) re-resolves the bound slot and returns a live row id or a refusal; (2) opregion_row_base / opregion_row_len give the window extent -- these two are the ONLY functions in the kernel that can turn a capability into a physical address, because _op_region_table is confined to kind_op_region.o, and tools/build.sh asserts no other object under core/drivers/gpio/ relocates against them; (3) off + 4 <= len, REFUSED rather than clamped, because a clamped offset selects some other pad's configuration register and the driver would then be configuring a pin nobody granted it; (4) in MMIO mode, mfence / mov eax,[base+off] / mfence -- the WB-to-UC ordering bracket every accessor in this tree uses (SDM Vol 3A 11.3.1); in SYNTH mode, gpio_io_synth_load; (5) append a GPIO_TRACE_OP_READ record with the value actually returned. A REFUSAL IS NOT TRACED: the trace is a record of accesses that reached the device, and a refused access reached nothing -- tracing it would let a driver being denied every register look, in the trace, exactly like one that is working. Five pushes (rbx, r12..r15) leave rsp%16 == 0 at every nested call. Labels prefixed gpio_io_r32_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // off

        mov rdi, 1;                      // R_OPREG_READ
        call gpio_io_check;
        mov r11, 0xFFFFFF08;             // GPIO_IO_BAND_LOW
        cmp rax, r11;
        jae gpio_io_r32_fault;
        mov rbx, rax;                    // row_id

        mov rdi, rbx;
        call opregion_row_base;
        mov r13, rax;

        mov rdi, rbx;
        call opregion_row_len;
        mov r14, rax;

        // off + 4 <= len, formed without overflow (off < 2^32 always,
        // it is a register offset this driver produced).
        mov rax, r12;
        add rax, 4;
        cmp rax, r14;
        ja  gpio_io_r32_fault;

        lea r10, [rip + _gpio_io_mode];
        mov r10, [r10 + 0];
        cmp r10, 1;
        je  gpio_io_r32_synth;

        mfence;
        mov rax, r13;
        add rax, r12;
        mov eax, [rax];
        mfence;
        mov r15, rax;
        jmp gpio_io_r32_emit;

      gpio_io_r32_synth:
        mov rdi, r12;
        call gpio_io_synth_load;
        mov r15, rax;

      gpio_io_r32_emit:
        mov rdi, 1;                      // GPIO_TRACE_OP_READ
        mov rsi, r12;
        mov rdx, r15;
        call gpio_io_trace_append;
        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpio_io_r32_fault:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // GPIO_IO_FAULT
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gpio_io_write32(off, val) -> GPIO_IO_OK | error
  // ==========================================================================

  pub let gpio_io_write32 : (u64, u64) -> u64 !{sysreg, mem} @{boot, cap} =
    fn (off: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-002 (#1076): 32-bit write of a pad-controller register, through the window capability. Same sequence as gpio_io_read32 with gpio_io_check(R_OPREG_WRITE = 2), so a window minted without WRITE is refused GPIO_IO_NO_WRITE and NOTHING IS STORED. That is worth more on this part than on any other in the tree: a read-only mapping of a pad controller is what separates a component that may look at pin state from one that may drive a device into reset. Returns the refusal code rather than a sentinel, because unlike a read there is no in-band value to be confused with one. G1: mov_d for the MMIO store; a bare mov widens to eight bytes and would write over PADCFG1 as well as PADCFG0. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed gpio_io_w32_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // off
        mov r15, rsi;                    // val (32-bit)
        mov r11, 0xFFFFFFFF;
        and r15, r11;

        mov rdi, 2;                      // R_OPREG_WRITE
        call gpio_io_check;
        mov r11, 0xFFFFFF08;             // GPIO_IO_BAND_LOW
        cmp rax, r11;
        jae gpio_io_w32_err;
        mov rbx, rax;

        mov rdi, rbx;
        call opregion_row_base;
        mov r13, rax;

        mov rdi, rbx;
        call opregion_row_len;
        mov r14, rax;

        mov rax, r12;
        add rax, 4;
        cmp rax, r14;
        ja  gpio_io_w32_range;

        lea r10, [rip + _gpio_io_mode];
        mov r10, [r10 + 0];
        cmp r10, 1;
        je  gpio_io_w32_synth;

        mfence;
        mov rax, r13;
        add rax, r12;
        mov_d [rax], r15;
        mfence;
        jmp gpio_io_w32_emit;

      gpio_io_w32_synth:
        mov rdi, r12;
        mov rsi, r15;
        call gpio_io_synth_store;

      gpio_io_w32_emit:
        mov rdi, 2;                      // GPIO_TRACE_OP_WRITE
        mov rsi, r12;
        mov rdx, r15;
        call gpio_io_trace_append;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpio_io_w32_range:
        mov rax, 0xFFFFFF0A;             // GPIO_IO_RANGE
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gpio_io_w32_err:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
