// src/kernel/core/drivers/gpio/gpio_isr.pdx — R30.M6-004 (#1078)
//
// The GPIO edge-interrupt service routine. EXACTLY ONE FUNCTION LIVES IN
// THIS FILE, and that is a build-system constraint, not a stylistic one:
// tools/build.sh checks the set of symbols this OBJECT relocates against,
// so anything else compiled into it would be checked as if it ran in
// interrupt context.
//
// -----------------------------------------------------------------------------
// §The allowlist
// -----------------------------------------------------------------------------
//
// A THIRD list, alongside SCI_ISR_ALLOWED and DW_ISR_ALLOWED, and
// deliberately not an extension of either. The three routines are bounded
// for different reasons, by different arguments, over different hardware;
// a shared list would let a symbol justified for the ACPI SCI appear,
// unexamined, in the pad-controller path. tools/build.sh says so in a
// comment and this file says so here so the two cannot drift.
//
// Every symbol on GPIO_ISR_ALLOWED is a bounded, non-blocking near-leaf:
//
//   gpio_pad_sub_slot        bounds check plus one load
//   gpio_pad_is_off_of_slot  capability resolve plus table reads; the one
//                            loop inside it (pad-index multiply) is
//                            bounded by GPIO_COMM_MAX_PINS
//   gpio_pad_bit_of_slot     capability resolve plus a shift loop bounded
//                            by 32
//   gpio_io_read32           window re-resolve plus one MMIO load
//   gpio_io_write32          window re-resolve plus one MMIO store
//   gpio_pad_sub_bump        two row accesses and a store, no loop
//   gpio_pad_sub_storm       one GPI_IE read-modify-write, no loop
//
// None allocates, none takes a lock, none can block, none reaches a
// scheduler, an IPC send, or a firmware-method interpreter.
//
// The list is checked with a VACUITY GUARD: if objdump finds NO
// relocations in this object at all, the build fails rather than passes.
// An ISR whose body was inlined away, gutted or renamed relocates against
// nothing, and "references nothing outside the allowlist" is trivially
// true of a function that references nothing. The guard is the difference
// between a check that passed and a check that ran.
//
// -----------------------------------------------------------------------------
// §Why an interrupt storm is a livelock and not a slow system
// -----------------------------------------------------------------------------
//
// A GPIO status bit is level-sticky. If the ISR returns with GPI_IS still
// asserted for an enabled pad, the interrupt controller re-raises
// immediately — before any task runs, because the interrupt outranks
// everything that could diagnose or fix it. There is no throttle and no
// backpressure. The machine does not get slower; it stops.
//
// Two ordinary mistakes produce exactly this:
//
//   * the wrong trigger — a level configuration where an edge was meant,
//     so the condition never goes away;
//   * enabling a pad whose status bit was already set by whatever owned
//     the pin before this kernel did, and never clearing it.
//
// gpio_pad_edge_subscribe closes the second by clearing GPI_IS before
// setting GPI_IE. This routine closes both from the other end, with a
// hard per-line service bound:
//
//   GPIO_ISR_LINE_BUDGET services per line per entry. On the (budget+1)th
//   consecutive assertion the line is MASKED in GPI_IE and its storm flag
//   is set, which is visible to a holder of OBSERVE through
//   gpio_pad_edge_storm.
//
// Masking is the only correct response. Returning with the condition
// still asserted is the livelock; leaving the loop running is the
// livelock with extra steps. The line is not unsubscribed — the
// capability still owns it, and the operator-visible state must read
// "masked because it stormed", not "never subscribed".
//
// THE BOUND IS WITNESSED, not merely written. The fixture arms a line
// whose status offset is registered write-1-to-clear and observes exactly
// one service and no storm; then arms one whose status offset is a plain
// storage cell — the standing-in-for-a-bit-that-will-not-clear case — and
// observes the budget reached, the storm flag set and GPI_IE cleared.
// Under the cell array R30.M6-002 shipped, BOTH cases would storm and the
// first assertion could not be made at all.

module GpioIsr = structure {

  // Per line, per entry. Small on purpose: an edge that is still asserted
  // after four acknowledgements is not a burst of traffic, it is a line
  // that will not clear, and the sooner that is turned into a masked line
  // and a flag the shorter the interval in which the machine is unusable.
  pub let GPIO_ISR_LINE_BUDGET : u64 = 4

  // ==========================================================================
  // gpio_pad_isr() -> number of edges serviced
  // ==========================================================================

  pub let gpio_pad_isr : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R30.M6-004 (#1078): the GPIO edge service routine. Walks the four subscription entries; for each live one, drains its pad's interrupt status bit at most GPIO_ISR_LINE_BUDGET times, acknowledging each by writing the bit back to the write-1-to-clear GPI_IS word and bumping the line's serviced count. A line still asserting after the budget is MASKED in GPI_IE and flagged, via gpio_pad_sub_storm -- see the header for why returning with the condition asserted is a livelock rather than a slowdown. Total work is bounded by 4 * 4 register round-trips with no loop whose count depends on anything the hardware controls. Every offset and bit mask is RE-DERIVED from the capability on every iteration and nothing is cached across entries: a cached pad address survives a revoke, and an ISR writing to a stale pad address is an ISR driving whatever now occupies it. Returns the number of edges serviced so a witness can assert the bound rather than assume it. Five pushes plus a 16-byte frame keep rsp%16 == 0 at every nested call; r12 = subscription index, r13 = slot, r14 = per-line service count, r15 = total serviced, rbx = GPI_IS offset, [rsp+0] = bit mask. Reserved labels: gpio_isr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        xor r15, r15;                    // serviced
        xor r12, r12;                    // subscription index

      gpio_isr_next_sub:
        cmp r12, 4;                      // GPIO_PAD_SUB_MAX
        jae gpio_isr_done;

        mov rdi, r12;
        call gpio_pad_sub_slot;
        cmp rax, 0;
        je  gpio_isr_bump_sub;
        mov r13, rax;                    // slot

        xor r14, r14;                    // per-line services this entry

      gpio_isr_drain:
        cmp r14, 4;                      // GPIO_ISR_LINE_BUDGET
        jae gpio_isr_storm;

        mov rdi, r13;
        call gpio_pad_is_off_of_slot;
        mov r10, 0xFFFFFEE7;             // GPIO_PAD_NO_COMM
        cmp rax, r10;
        je  gpio_isr_bump_sub;
        mov rbx, rax;

        mov rdi, r13;
        call gpio_pad_bit_of_slot;
        cmp rax, 0;
        je  gpio_isr_bump_sub;
        mov [rsp + 0], rax;              // bit mask

        mov rdi, rbx;
        call gpio_io_read32;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // GPIO_IO_FAULT
        cmp rax, r10;
        je  gpio_isr_bump_sub;

        mov r10, [rsp + 0];
        and rax, r10;
        cmp rax, 0;
        je  gpio_isr_bump_sub;           // nothing pending: this line is done

        // Acknowledge. GPI_IS is write-1-to-clear, so writing the single
        // bit knocks it down and leaves the other 31 pads' status alone
        // without a read-modify-write -- which is also why a plain-cell
        // model cannot tell this line from a missing one.
        mov rdi, rbx;
        mov rsi, [rsp + 0];
        call gpio_io_write32;
        cmp rax, 0;
        jne gpio_isr_bump_sub;

        mov rdi, r12;
        call gpio_pad_sub_bump;

        add r15, 1;
        add r14, 1;
        jmp gpio_isr_drain;

      gpio_isr_storm:
        mov rdi, r12;
        call gpio_pad_sub_storm;

      gpio_isr_bump_sub:
        add r12, 1;
        jmp gpio_isr_next_sub;

      gpio_isr_done:
        mov rax, r15;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
