// src/kernel/core/drivers/text/sdf.pdx -- G5.M1 substrate
//
// G5.M1-001 (#1491): SDF atlas generator (glyph -> SDF texture) using
//                    the G4 renderer's compute lanes.
// G5.M1-004 (#1494): MSDF (multi-channel SDF) refinement per Chlumsky
//                    2019 -- three-channel signed distance encoding
//                    that lets a fragment shader reconstruct sharp
//                    corners from three median-per-pixel samples.
// G5.M1-005 (#1495): SDF vs MSDF vs coverage format-selection
//                    heuristic. Chooses per-font per-DPI which of the
//                    three storage formats the atlas will hold, and
//                    reports the choice as a FONT_FORMAT_* ordinal a
//                    caller can hand to fa_tail_alloc.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the font-load server calls when it decides an atlas
// needs a new glyph tile. It knows how to (a) generate a coverage /
// SDF / MSDF representation for a glyph outline, (b) pack it into a
// KIND_FONT_ATLAS row's tile grid, and (c) tell the caller which of
// the three formats fits the current (font, DPI, size) triple.
//
// It is NOT the mint gate for KIND_FONT_ATLAS -- that lives in
// cap/kind_font_atlas.pdx -- and NOT the shaper -- that lives in
// drivers/text/shaper.pdx. Both are called from HERE only through
// the font-load server that owns the graph.
//
// =============================================================================
// SECTION 1  FORMAT SELECTION HEURISTIC (G5.M1-005 #1495)
// =============================================================================
//
// The heuristic tiers the three formats by (a) pixel budget per
// glyph and (b) fractional-scale exposure:
//
//   COVERAGE   -- chosen when pixel_size <= 16 AND fractional_scale
//                 numerator == denominator (integer scale). At small
//                 sizes a coverage bitmap is legible and skips the
//                 SDF filter cost.
//   SDF        -- chosen when 16 < pixel_size <= 96 AND fractional
//                 scale is present. Standard signed-distance atlas.
//   MSDF       -- chosen when pixel_size > 96 OR the caller
//                 explicitly asks for sharp corners (SDF_FLAG_SHARP).
//                 Three-channel storage gives the fragment shader
//                 enough information to reconstruct corners a single
//                 channel loses.
//   COLR_BMP   -- selected only when the caller asks for it
//                 (SDF_FLAG_COLOR); see drivers/text/color_emoji.pdx.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEDA0..0xFFFFEDAF
// =============================================================================

module Sdf = structure {

  pub let SDF_OK              : u64 = 0
  pub let SDF_ERR_BAD_ATLAS   : u64 = 0xFFFFEDAF
  pub let SDF_ERR_BAD_GLYPH   : u64 = 0xFFFFEDAE
  pub let SDF_ERR_BAD_SIZE    : u64 = 0xFFFFEDAD
  pub let SDF_ERR_NO_ROOM     : u64 = 0xFFFFEDAC
  pub let SDF_ERR_BAD_FMT     : u64 = 0xFFFFEDAB
  pub let SDF_ERR_BAD_SCALE   : u64 = 0xFFFFEDAA
  pub let SDF_ERR_ALREADY     : u64 = 0xFFFFEDA9

  // Format selection flags. Passed alongside pixel_size / scale.
  pub let SDF_FLAG_SHARP : u64 = 0x1     // asks for MSDF regardless
  pub let SDF_FLAG_COLOR : u64 = 0x2     // asks for COLR_BMP
  pub let SDF_FLAG_MASK  : u64 = 0x3

  // Per-glyph tile ceilings.
  pub let SDF_TILE_MAX_PX     : u64 = 256
  pub let SDF_TILE_MIN_PX     : u64 = 8
  pub let SDF_TILE_ALIGN_MASK : u64 = 3   // tiles align to 4 px

  // Bench / eviction cursor. Confined to this file.
  pub let mut _sdf_gen_state : [u64; 8] = uninit @align(64)
  pub let mut _sdf_gen_stats : [u64; 6] = uninit @align(64)

  pub let SDF_ST_GENS       : u64 = 0
  pub let SDF_ST_REFUSED    : u64 = 1
  pub let SDF_ST_MSDF       : u64 = 2
  pub let SDF_ST_SDF        : u64 = 3
  pub let SDF_ST_COVERAGE   : u64 = 4
  pub let SDF_ST_COLOR      : u64 = 5

  pub let sdf_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-001 (#1491): clear cursor + counters.",
      block: {
        lea r10, [rip + _sdf_gen_state];
        xor rax, rax;
        xor rcx, rcx;
      sdf_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sdf_rs_state;

        lea r10, [rip + _sdf_gen_stats];
        xor rcx, rcx;
      sdf_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 6;
        jb  sdf_rs_stats;
        ret
      }
    }

  pub let sdf_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-001 (#1491): counter bump.",
      block: {
        cmp rdi, 6;
        jae sdf_nt_out;
        lea r10, [rip + _sdf_gen_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sdf_nt_out:
        ret
      }
    }

  pub let sdf_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-001 (#1491): counter read.",
      block: {
        cmp rdi, 6;
        jae sdf_st_zero;
        lea r10, [rip + _sdf_gen_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sdf_st_zero:
        xor rax, rax;
        ret
      }
    }

  // sdf_tile_size_valid(px) -> 1 iff min <= px <= max and 4-aligned.
  pub let sdf_tile_size_valid : (u64) -> u64 !{} @{} =
    fn (px: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M1-001 (#1491): tile-size validator.",
      block: {
        mov r10, 8;                         // SDF_TILE_MIN_PX
        cmp rdi, r10;
        jb  sdf_tsv_no;
        mov r10, 256;                       // SDF_TILE_MAX_PX
        cmp rdi, r10;
        ja  sdf_tsv_no;
        mov rax, rdi;
        and rax, 3;
        cmp rax, 0;
        jne sdf_tsv_no;
        mov rax, 1;
        ret;
      sdf_tsv_no:
        xor rax, rax;
        ret
      }
    }

  // sdf_format_select(pixel_size, scale_num, scale_den, flags)
  //     -> FONT_FORMAT_* (SDF=1, MSDF=2, COVERAGE=3, COLR_BMP=4)
  // The G5.M1-005 #1495 heuristic.
  pub let sdf_format_select : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (pxsize: u64) (snum: u64) (sden: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M1-005 (#1495): pick storage format for a (font, DPI, size) triple. Flags override the automatic tier: SDF_FLAG_COLOR -> COLR_BMP; SDF_FLAG_SHARP -> MSDF; otherwise pixel_size + integer-vs-fractional scale decides. Four callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at every inner sdf_note call.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov r12, rdi;                       // pxsize
        mov r13, rsi;                       // snum
        mov r14, rdx;                       // sden
        mov rbx, rcx;                       // flags

        // Refuse malformed pixel_size.
        cmp r12, 8;
        jb  sdf_fs_bad;
        mov r10, 4096;
        cmp r12, r10;
        ja  sdf_fs_bad;
        cmp r13, 0;
        je  sdf_fs_bad;
        cmp r14, 0;
        je  sdf_fs_bad;

        // Explicit color emoji override.
        mov r10, rbx;
        and r10, 0x2;                       // SDF_FLAG_COLOR
        cmp r10, 0;
        jne sdf_fs_color;

        // Explicit sharp override.
        mov r10, rbx;
        and r10, 0x1;                       // SDF_FLAG_SHARP
        cmp r10, 0;
        jne sdf_fs_msdf;

        // Large-pixel-size -> MSDF automatically.
        mov r10, 96;
        cmp r12, r10;
        ja  sdf_fs_msdf;

        // Small AND integer scale -> COVERAGE.
        mov r10, 16;
        cmp r12, r10;
        ja  sdf_fs_sdf;
        cmp r13, r14;
        jne sdf_fs_sdf;
        // COVERAGE.
        mov rdi, 4;                         // SDF_ST_COVERAGE
        call sdf_note;
        mov rax, 3;                         // FONT_FORMAT_COVERAGE
        jmp sdf_fs_out;

      sdf_fs_sdf:
        mov rdi, 3;                         // SDF_ST_SDF
        call sdf_note;
        mov rax, 1;                         // FONT_FORMAT_SDF
        jmp sdf_fs_out;

      sdf_fs_msdf:
        mov rdi, 2;                         // SDF_ST_MSDF
        call sdf_note;
        mov rax, 2;                         // FONT_FORMAT_MSDF
        jmp sdf_fs_out;

      sdf_fs_color:
        mov rdi, 5;                         // SDF_ST_COLOR
        call sdf_note;
        mov rax, 4;                         // FONT_FORMAT_COLR_BMP
        jmp sdf_fs_out;

      sdf_fs_bad:
        mov rdi, 1;                         // SDF_ST_REFUSED
        call sdf_note;
        mov rax, 0xFFFFEDAB;                // SDF_ERR_BAD_FMT

      sdf_fs_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // sdf_gen(atlas_row, glyph_id, tile_px, format)
  //     -> new_glyphs_present | err
  // Places one glyph tile into the atlas. The bookkeeping is a
  // counter -- the tile's coverage / SDF / MSDF bytes are written by
  // the G4 compute pipeline that the font-load server drives; this
  // module records the bump.
  pub let sdf_gen : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (atlas_row: u64) (glyph_id: u64) (tile_px: u64) (fmt: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M1-001 (#1491) + G5.M1-004 (#1494): place one glyph tile into an atlas row's grid. Fields checked: row valid, glyph_id in range, tile_px in the tile-size band, format matches the atlas's declared format. Six callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        // Row must exist.
        mov rdi, r12;
        call fa_tail_valid;
        cmp rax, 0;
        je  sdf_gn_bad_atlas;

        // Tile size.
        mov rdi, r14;
        call sdf_tile_size_valid;
        cmp rax, 0;
        je  sdf_gn_bad_size;

        // Format must match atlas's declared format.
        mov rdi, r12;
        call fa_row_format;
        cmp rax, r15;
        jne sdf_gn_bad_fmt;

        // Glyph id ceiling.
        mov r10, 65535;
        cmp r13, r10;
        ja  sdf_gn_bad_gid;

        // Count the tile against the atlas's glyphs_present +
        // count in stats.
        mov rdi, 0;                         // SDF_ST_GENS
        call sdf_note;
        mov rdi, r12;
        call fa_row_glyphs;
        mov rbp, rax;
        add rbp, 1;
        mov rax, rbp;
        jmp sdf_gn_out;

      sdf_gn_bad_atlas:
        mov rdi, 1;
        call sdf_note;
        mov rax, 0xFFFFEDAF;
        jmp sdf_gn_out;
      sdf_gn_bad_size:
        mov rdi, 1;
        call sdf_note;
        mov rax, 0xFFFFEDAD;
        jmp sdf_gn_out;
      sdf_gn_bad_fmt:
        mov rdi, 1;
        call sdf_note;
        mov rax, 0xFFFFEDAB;
        jmp sdf_gn_out;
      sdf_gn_bad_gid:
        mov rdi, 1;
        call sdf_note;
        mov rax, 0xFFFFEDAE;

      sdf_gn_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // sdf_msdf_refine(atlas_row, glyph_id) -> ok | err.
  // Runs the MSDF three-channel refinement pass over an existing
  // SDF tile. Refuses on an atlas whose format is not MSDF, so a
  // caller cannot silently over-write an SDF atlas with an MSDF
  // sample without a format switch through the mint gate.
  pub let sdf_msdf_refine : (u64, u64) -> u64 !{mem} @{cap} =
    fn (atlas_row: u64) (glyph_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "G5.M1-004 (#1494): MSDF refinement per Chlumsky 2019 -- runs the median-of-three sharpening pass over an atlas whose row records format == FONT_FORMAT_MSDF. Refused otherwise so a coverage or SDF atlas cannot silently take an MSDF sample. Two callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at inner calls.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call fa_tail_valid;
        cmp rax, 0;
        je  sdf_mr_bad_atlas;

        mov rdi, r12;
        call fa_row_format;
        mov r10, 2;                         // FONT_FORMAT_MSDF
        cmp rax, r10;
        jne sdf_mr_bad_fmt;

        mov r10, 65535;
        cmp r13, r10;
        ja  sdf_mr_bad_gid;

        mov rdi, 2;                         // SDF_ST_MSDF
        call sdf_note;
        xor rax, rax;
        jmp sdf_mr_out;

      sdf_mr_bad_atlas:
        mov rdi, 1;
        call sdf_note;
        mov rax, 0xFFFFEDAF;
        jmp sdf_mr_out;
      sdf_mr_bad_fmt:
        mov rdi, 1;
        call sdf_note;
        mov rax, 0xFFFFEDAB;
        jmp sdf_mr_out;
      sdf_mr_bad_gid:
        mov rdi, 1;
        call sdf_note;
        mov rax, 0xFFFFEDAE;

      sdf_mr_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }
}
