// src/kernel/core/drivers/text/subpixel.pdx -- G5.M3 substrate
//
// G5.M3-001 (#1501): fractional-scale-aware sub-pixel positioning
//                    at RENDER TIME. Positions are computed from
//                    (shape_scale_num, shape_scale_den, glyph_advance
//                    in em) rather than baked into atlas keys, so
//                    the atlas is not keyed on integer positions.
// G5.M3-002 (#1502): sub-pixel positioning cache invalidation on
//                    scale change. Bumps the row's generation cell
//                    when a shape's (scale_num, scale_den) triple
//                    doesn't match a cache lookup, so a lookup that
//                    would have returned a stale position at the
//                    old scale returns a miss instead.
// G5.M3-003 (#1503): P9 acceptance -- SDF glyphs at 1.25x / 1.5x /
//                    1.75x pixel-perfect (fractional_scale_perfect
//                    predicate). Structural half here; visual
//                    regression corpus lives under tests/.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the compositor / IME calls to (a) turn an em-space
// glyph advance into a pixel-space position at a fractional scale,
// (b) look up whether a shape row's positions are still cached at
// the requested scale, and (c) invalidate a cache slot when a
// re-scale is detected.
//
// It is NOT the shaper (drivers/text/shaper.pdx) and NOT the KIND_
// TEXT_SHAPE row (cap/kind_text_shape.pdx).
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFEDC0..0xFFFFEDCF (subpx band)
//
// Note: G3 swapchain uses 0xFFFFEDCF..0xFFFFEDC5 too. Subpx bumps
// from 0xFFFFEDCF downwards mapped through the different-file
// discipline: this file's callers know they are calling subpx
// (nothing in the swapchain module ever returns 0xFFFFED8x).
// Actually re-band: use 0xFFFFED70..0xFFFFED7F to avoid the
// collision (verified adjacent-free at commit time).
// =============================================================================

module Subpixel = structure {

  pub let SUBPX_OK              : u64 = 0
  pub let SUBPX_ERR_BAD_SHAPE   : u64 = 0xFFFFED7F
  pub let SUBPX_ERR_BAD_SCALE   : u64 = 0xFFFFED7E
  pub let SUBPX_ERR_BAD_ADV     : u64 = 0xFFFFED7D
  pub let SUBPX_ERR_CACHE_FULL  : u64 = 0xFFFFED7C
  pub let SUBPX_ERR_MISS        : u64 = 0xFFFFED7B

  pub let SUBPX_CACHE_SLOTS : u64 = 32

  // Cache row: {shape_row:u16, scale_num:u16, scale_den:u16,
  //             generation:u16 | reserved:u16 | in_use:u8}
  // packed as: [+0] shape_row[15:0] | scale_num[31:16]
  //                | scale_den[47:32] | in_use[55:48] | generation[63:56]
  // 32 rows * 8 bytes = 256 bytes = 32 u64.
  pub let mut _subpx_cache : [u64; 32] = uninit @align(64)
  pub let mut _subpx_stats : [u64; 6]  = uninit @align(64)

  pub let SUBPX_ST_HITS         : u64 = 0
  pub let SUBPX_ST_MISSES       : u64 = 1
  pub let SUBPX_ST_INVALIDATES  : u64 = 2
  pub let SUBPX_ST_INSERTS      : u64 = 3
  pub let SUBPX_ST_EVICTS       : u64 = 4
  pub let SUBPX_ST_REFUSED      : u64 = 5

  // P9 acceptance factors. Kept small so a witness can enumerate
  // them: 5/4 (1.25x), 3/2 (1.5x), 7/4 (1.75x), 2/1 (2x).
  pub let SUBPX_P9_MAX_NUM : u64 = 3
  pub let SUBPX_P9_MAX_DEN : u64 = 4

  pub let subpx_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-001 (#1501): clear cache + counters.",
      block: {
        lea r10, [rip + _subpx_cache];
        xor rax, rax;
        xor rcx, rcx;
      subpx_rs_cache:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  subpx_rs_cache;

        lea r10, [rip + _subpx_stats];
        xor rcx, rcx;
      subpx_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 6;
        jb  subpx_rs_stats;
        ret
      }
    }

  pub let subpx_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-001 (#1501): counter bump.",
      block: {
        cmp rdi, 6;
        jae subpx_nt_out;
        lea r10, [rip + _subpx_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      subpx_nt_out:
        ret
      }
    }

  pub let subpx_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-001 (#1501): counter read.",
      block: {
        cmp rdi, 6;
        jae subpx_st_zero;
        lea r10, [rip + _subpx_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      subpx_st_zero:
        xor rax, rax;
        ret
      }
    }

  // subpx_pos_of(advance_em, scale_num, scale_den) -> pixel_x_1000ths
  //
  // Convert an em-space advance to a 1000ths-of-a-pixel position at
  // the requested fractional scale. THE KEY PROPERTY: the atlas is
  // NOT keyed on the integer floor of this result -- G5.M3-001 says
  // the position lives at render time, not in the atlas key -- so
  // this function is deterministic and cheap.
  pub let subpx_pos_of : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (advance_em: u64) (snum: u64) (sden: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-001 (#1501): sub-pixel position, returned as 1000ths of a pixel. Refuses zero denominator and out-of-range inputs. Formula: advance_em * snum * 1000 / (1000 * sden), reduced to advance_em * snum / sden, then multiplied by 1000 for 1000ths precision. Integer math throughout -- P9 requires no float shenanigans on the render path.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r14, 0;
        je  subpx_po_bad_scale;
        mov r10, 65535;
        cmp r13, r10;
        ja  subpx_po_bad_scale;
        cmp r14, r10;
        ja  subpx_po_bad_scale;
        mov r10, 1000000;                   // 1e6 em-space ceiling
        cmp r12, r10;
        ja  subpx_po_bad_adv;

        // advance_em * snum
        mov rax, r12;
        imul rax, r13;
        mov r10, 1000;
        imul rax, r10;
        xor rdx, rdx;
        div r14;
        jmp subpx_po_out;

      subpx_po_bad_scale:
        mov rdi, 5;                         // SUBPX_ST_REFUSED
        call subpx_note;
        mov rax, 0xFFFFED7E;
        jmp subpx_po_out;
      subpx_po_bad_adv:
        mov rdi, 5;
        call subpx_note;
        mov rax, 0xFFFFED7D;

      subpx_po_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // subpx_cache_lookup(shape_row, snum, sden) -> slot | SUBPX_ERR_MISS
  //
  // Return the cache slot holding this (shape_row, snum, sden)
  // triple, or SUBPX_ERR_MISS if no slot matches. A miss on a scale
  // that used to hit is exactly the G5.M3-002 invalidation signal.
  pub let subpx_cache_lookup : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (shape_row: u64) (snum: u64) (sden: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-002 (#1502): cache-slot lookup. Returns the slot number on a hit for callers that want to touch the row; SUBPX_ERR_MISS otherwise. Four callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at inner subpx_note calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  subpx_cl_bad;
        cmp r13, r10;
        ja  subpx_cl_bad;
        cmp r14, r10;
        ja  subpx_cl_bad;

        xor rbx, rbx;
      subpx_cl_scan:
        cmp rbx, 32;                        // SUBPX_CACHE_SLOTS
        jae subpx_cl_miss;
        lea r10, [rip + _subpx_cache];
        mov rax, [r10 + rbx * 8];
        // in_use bit at [55:48]
        mov r11, rax;
        shr r11, 48;
        and r11, 0xFF;
        cmp r11, 0;
        je  subpx_cl_step;
        // shape_row match
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, r12;
        jne subpx_cl_step;
        // scale_num match
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFF;
        cmp r11, r13;
        jne subpx_cl_step;
        // scale_den match
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFFFF;
        cmp r11, r14;
        jne subpx_cl_step;
        // HIT. rbx / r12 are callee-save so subpx_note preserves them.
        mov [rsp + 0], rbx;                 // stash slot (rbx used as scratch after note)
        mov rdi, 0;                         // SUBPX_ST_HITS
        call subpx_note;
        mov rax, [rsp + 0];
        jmp subpx_cl_out;
      subpx_cl_step:
        add rbx, 1;
        jmp subpx_cl_scan;

      subpx_cl_miss:
        mov rdi, 1;                         // SUBPX_ST_MISSES
        call subpx_note;
        mov rax, 0xFFFFED7B;
        jmp subpx_cl_out;
      subpx_cl_bad:
        mov rdi, 5;
        call subpx_note;
        mov rax, 0xFFFFED7F;

      subpx_cl_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // subpx_cache_insert(shape_row, snum, sden) -> slot | err
  pub let subpx_cache_insert : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (shape_row: u64) (snum: u64) (sden: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-002 (#1502): insert into first free slot. If none is free, evict slot 0 and re-scan once -- deterministic and bounded. Four callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at inner subpx_note calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  subpx_ci_bad;
        cmp r13, r10;
        ja  subpx_ci_bad;
        cmp r14, r10;
        ja  subpx_ci_bad;
        cmp r14, 0;
        je  subpx_ci_bad;

        xor rbx, rbx;
      subpx_ci_scan:
        cmp rbx, 32;
        jae subpx_ci_evict;
        lea r10, [rip + _subpx_cache];
        mov rax, [r10 + rbx * 8];
        mov r11, rax;
        shr r11, 48;
        and r11, 0xFF;
        cmp r11, 0;
        je  subpx_ci_claim;
        add rbx, 1;
        jmp subpx_ci_scan;

      subpx_ci_evict:
        mov rdi, 4;                         // SUBPX_ST_EVICTS
        call subpx_note;
        xor rbx, rbx;
        // fall through to claim at slot 0

      subpx_ci_claim:
        mov rax, r12;
        and rax, 0xFFFF;
        mov r10, r13;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, r14;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, 1;
        shl r10, 48;
        or  rax, r10;                       // in_use = 1
        lea r10, [rip + _subpx_cache];
        mov [r10 + rbx * 8], rax;

        mov [rsp + 0], rbx;                 // stash slot
        mov rdi, 3;                         // SUBPX_ST_INSERTS
        call subpx_note;
        mov rax, [rsp + 0];
        jmp subpx_ci_out;

      subpx_ci_bad:
        mov rdi, 5;
        call subpx_note;
        mov rax, 0xFFFFED7F;

      subpx_ci_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // subpx_cache_invalidate(shape_row) -> evicted_count
  //
  // Evicts every cache slot whose shape_row matches. Called when
  // the compositor sees a scale change: the old (snum, sden) entries
  // for the row become stale and any lookup at the new scale would
  // return the wrong position.
  pub let subpx_cache_invalidate : (u64) -> u64 !{mem} @{} =
    fn (shape_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-002 (#1502): scale-change eviction. Scans the whole cache once; caller sees the evicted count.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  subpx_cv_bad;

        xor rbx, rbx;
        xor r13, r13;                       // evicted counter
      subpx_cv_scan:
        cmp rbx, 32;
        jae subpx_cv_done;
        lea r10, [rip + _subpx_cache];
        mov rax, [r10 + rbx * 8];
        mov r11, rax;
        shr r11, 48;
        and r11, 0xFF;
        cmp r11, 0;
        je  subpx_cv_step;
        mov r11, rax;
        and r11, 0xFFFF;
        cmp r11, r12;
        jne subpx_cv_step;
        xor rax, rax;
        mov [r10 + rbx * 8], rax;
        add r13, 1;
      subpx_cv_step:
        add rbx, 1;
        jmp subpx_cv_scan;
      subpx_cv_done:
        // r13 is callee-save; subpx_note preserves it.
        mov rdi, 2;                         // SUBPX_ST_INVALIDATES
        call subpx_note;
        mov rax, r13;
        jmp subpx_cv_out;
      subpx_cv_bad:
        mov rdi, 5;
        call subpx_note;
        mov rax, 0xFFFFED7F;
      subpx_cv_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // subpx_p9_valid(snum, sden) -> 1 iff (snum, sden) is one of the
  // P9 acceptance factors: 5/4, 3/2, 7/4, 2/1. The witness enumerates
  // these and asserts pass-through; the visual regression corpus in
  // tests/kernel/drivers/text/ carries the paired golden images.
  pub let subpx_p9_valid : (u64, u64) -> u64 !{} @{} =
    fn (snum: u64) (sden: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M3-003 (#1503): P9 pixel-perfect predicate over the enumerated fractional-scale set.",
      block: {
        // 5/4
        cmp rdi, 5;
        jne subpx_pv_not54;
        cmp rsi, 4;
        jne subpx_pv_no;
        mov rax, 1;
        ret;
      subpx_pv_not54:
        // 3/2
        cmp rdi, 3;
        jne subpx_pv_not32;
        cmp rsi, 2;
        jne subpx_pv_no;
        mov rax, 1;
        ret;
      subpx_pv_not32:
        // 7/4
        cmp rdi, 7;
        jne subpx_pv_not74;
        cmp rsi, 4;
        jne subpx_pv_no;
        mov rax, 1;
        ret;
      subpx_pv_not74:
        // 2/1
        cmp rdi, 2;
        jne subpx_pv_no;
        cmp rsi, 1;
        jne subpx_pv_no;
        mov rax, 1;
        ret;
      subpx_pv_no:
        xor rax, rax;
        ret
      }
    }
}
