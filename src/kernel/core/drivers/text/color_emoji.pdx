// src/kernel/core/drivers/text/color_emoji.pdx -- G5.M4 substrate
//
// G5.M4-001 (#1505): color emoji COLR/CPAL support -- layered vector
//                    glyphs with a palette of solid colors, the
//                    OpenType-native form used by Noto Emoji.
// G5.M4-002 (#1506): color emoji SBIX (Apple bitmap) support --
//                    embedded PNG images at multiple strikes.
// G5.M4-003 (#1507): color emoji CBDT/CBLC (Google bitmap) support
//                    -- embedded PNG images with per-strike metadata.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the font-load server calls when it decides an atlas
// tile needs to hold a color emoji glyph rather than a monochrome
// signed-distance-field one. It knows how to (a) classify a font's
// color-glyph table (COLR / SBIX / CBDT / none), (b) select the
// appropriate strike for a requested pixel size, and (c) hand
// the mint the FONT_FORMAT_COLR_BMP ordinal.
//
// It is NOT the mint gate for KIND_FONT_ATLAS and NOT the SDF
// generator (drivers/text/sdf.pdx). It complements the SDF path
// by carrying the one glyph class the SDF pipeline cannot express.
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFED60..0xFFFFED6F
// =============================================================================

module ColorEmoji = structure {

  pub let CE_OK             : u64 = 0
  pub let CE_ERR_BAD_ATLAS  : u64 = 0xFFFFED6F
  pub let CE_ERR_BAD_KIND   : u64 = 0xFFFFED6E
  pub let CE_ERR_BAD_STRIKE : u64 = 0xFFFFED6D
  pub let CE_ERR_NO_STRIKE  : u64 = 0xFFFFED6C
  pub let CE_ERR_BAD_LAYER  : u64 = 0xFFFFED6B

  // Color-glyph kind ordinals -- which table a font uses.
  pub let CE_KIND_NONE : u64 = 0     // font has no color-glyph table
  pub let CE_KIND_COLR : u64 = 1     // OpenType COLR/CPAL
  pub let CE_KIND_SBIX : u64 = 2     // Apple SBIX (embedded PNG)
  pub let CE_KIND_CBDT : u64 = 3     // Google CBDT/CBLC (embedded PNG)
  pub let CE_KIND_MAX  : u64 = 3

  // Strike-selection band. Emoji fonts typically ship strikes at
  // 20 / 32 / 40 / 48 / 64 / 96 / 128 px; a request outside this
  // range falls back on the nearest strike rather than rasterising
  // fresh, so the ceiling is set to what real fonts carry.
  pub let CE_STRIKE_MIN : u64 = 16
  pub let CE_STRIKE_MAX : u64 = 256

  // COLR layer ceiling. Real fonts (Noto Color Emoji) cap at ~12
  // layers per glyph; 32 gives headroom without letting a hostile
  // font spend the atlas on one glyph.
  pub let CE_LAYER_MAX : u64 = 32

  pub let mut _ce_state : [u64; 8] = uninit @align(64)
  pub let mut _ce_stats : [u64; 6] = uninit @align(64)

  pub let CE_ST_STRIKES     : u64 = 0
  pub let CE_ST_REFUSED     : u64 = 1
  pub let CE_ST_COLR        : u64 = 2
  pub let CE_ST_SBIX        : u64 = 3
  pub let CE_ST_CBDT        : u64 = 4
  pub let CE_ST_LAYERS      : u64 = 5

  pub let ce_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M4-001 (#1505): clear color-emoji state + counters.",
      block: {
        lea r10, [rip + _ce_state];
        xor rax, rax;
        xor rcx, rcx;
      ce_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ce_rs_state;

        lea r10, [rip + _ce_stats];
        xor rcx, rcx;
      ce_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 6;
        jb  ce_rs_stats;
        ret
      }
    }

  pub let ce_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M4-001 (#1505): counter bump.",
      block: {
        cmp rdi, 6;
        jae ce_nt_out;
        lea r10, [rip + _ce_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ce_nt_out:
        ret
      }
    }

  pub let ce_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M4-001 (#1505): counter read.",
      block: {
        cmp rdi, 6;
        jae ce_st_zero;
        lea r10, [rip + _ce_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ce_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ce_kind_valid : (u64) -> u64 !{} @{} =
    fn (kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M4 (#1505/#1506/#1507): 1 iff kind in [0, CE_KIND_MAX=3].",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  ce_kv_no;
        mov rax, 1;
        ret;
      ce_kv_no:
        xor rax, rax;
        ret
      }
    }

  // ce_strike_select(kind, requested_px) -> chosen_px | err
  //
  // For a font of a given color kind and a requested pixel size,
  // return the strike the driver will use. Real emoji fonts ship
  // strikes at 20/32/40/48/64/96/128; we snap to the nearest by
  // dividing into decades and rounding.
  pub let ce_strike_select : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (px: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M4-001..003 (#1505/#1506/#1507): pick the strike that best fits requested_px. Discrete band -- 20/32/40/48/64/96/128 for typical Noto/Twemoji/Apple builds; the request is snapped to the closest match without floats. Two callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at every inner call, and [rsp+0] holds the chosen strike across the CE_ST_STRIKES counter bump.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;
        mov r12, rdi;
        mov r13, rsi;

        // kind valid.
        mov rdi, r12;
        call ce_kind_valid;
        cmp rax, 0;
        je  ce_ss_bad_kind;

        // kind == NONE -> refuse.
        cmp r12, 0;
        je  ce_ss_no_strike;

        // px in the strike band.
        mov r10, 16;                        // CE_STRIKE_MIN
        cmp r13, r10;
        jb  ce_ss_bad_strike;
        mov r10, 256;                       // CE_STRIKE_MAX
        cmp r13, r10;
        ja  ce_ss_bad_strike;

        // Bump per-kind counter. r12/r13 are callee-save; ce_note preserves.
        mov r10, r12;
        cmp r10, 1;
        jne ce_ss_not_colr;
        mov rdi, 2;                         // CE_ST_COLR
        call ce_note;
        jmp ce_ss_pick;
      ce_ss_not_colr:
        cmp r10, 2;
        jne ce_ss_not_sbix;
        mov rdi, 3;                         // CE_ST_SBIX
        call ce_note;
        jmp ce_ss_pick;
      ce_ss_not_sbix:
        mov rdi, 4;                         // CE_ST_CBDT
        call ce_note;
      ce_ss_pick:
        // Snap. band table: 20, 32, 40, 48, 64, 96, 128, 256.
        mov rax, 20;
        cmp r13, rax;
        jbe ce_ss_done;
        mov rax, 32;
        cmp r13, rax;
        jbe ce_ss_done;
        mov rax, 40;
        cmp r13, rax;
        jbe ce_ss_done;
        mov rax, 48;
        cmp r13, rax;
        jbe ce_ss_done;
        mov rax, 64;
        cmp r13, rax;
        jbe ce_ss_done;
        mov rax, 96;
        cmp r13, rax;
        jbe ce_ss_done;
        mov rax, 128;
        cmp r13, rax;
        jbe ce_ss_done;
        mov rax, 256;
      ce_ss_done:
        mov [rsp + 0], rax;                 // stash chosen strike
        mov rdi, 0;                         // CE_ST_STRIKES
        call ce_note;
        mov rax, [rsp + 0];
        jmp ce_ss_out;

      ce_ss_bad_kind:
        mov rdi, 1;
        call ce_note;
        mov rax, 0xFFFFED6E;
        jmp ce_ss_out;
      ce_ss_bad_strike:
        mov rdi, 1;
        call ce_note;
        mov rax, 0xFFFFED6D;
        jmp ce_ss_out;
      ce_ss_no_strike:
        mov rdi, 1;
        call ce_note;
        mov rax, 0xFFFFED6C;

      ce_ss_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ce_colr_layer_count(glyph_id, declared_layers) -> ok | err
  //
  // COLR-specific: validate that a glyph's declared layer count is
  // in the CE_LAYER_MAX band. A hostile font that declares 65535
  // layers over one emoji glyph is refused rather than allowed to
  // spend the atlas on one code point.
  pub let ce_colr_layer_count : (u64, u64) -> u64 !{mem} @{} =
    fn (glyph_id: u64) (declared: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M4-001 (#1505): COLR layer ceiling. Refuses declared > CE_LAYER_MAX. Two callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at inner ce_note calls.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;
        mov r12, rdi;
        mov r13, rsi;

        cmp r13, 0;
        je  ce_lc_bad;
        mov r10, 32;                        // CE_LAYER_MAX
        cmp r13, r10;
        ja  ce_lc_bad;

        // r13 is callee-save; ce_note preserves it.
        mov rdi, 5;                         // CE_ST_LAYERS
        call ce_note;
        mov rax, r13;
        jmp ce_lc_out;

      ce_lc_bad:
        mov rdi, 1;
        call ce_note;
        mov rax, 0xFFFFED6B;

      ce_lc_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }
}
