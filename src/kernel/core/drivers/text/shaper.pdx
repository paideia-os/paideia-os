// src/kernel/core/drivers/text/shaper.pdx -- G5.M2 + G5.M3 + G5.M4 substrate
//
// G5.M2-001 (#1496): text shaper (HarfBuzz-analogue) -- the engine
//                    the text_shape_channel calls to turn a
//                    (script, direction, features, source) tuple
//                    into a KIND_TEXT_SHAPE row.
// G5.M2-004 (#1499): OpenType feature support (kerning, ligatures,
//                    small-caps) as a features_hash that a caller
//                    reproduces before mint.
// G5.M2-005 (#1500): BiDi (Unicode Annex #9). Splits a run into
//                    LTR / RTL sub-runs the shaper dispatches
//                    against.
// G5.M3-004 (#1504): light TrueType hinting for legibility at small
//                    sizes. Toggle per DPI band.
// G5.M4-004 (#1508): Indic complex-script conjunct clustering. Wraps
//                    the Indic shaper against Devanagari / Bengali /
//                    Tamil rows.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the text_shape_channel calls when a client issues
// a `shape(runs) -> Cap<KIND_TEXT_SHAPE>` request. It knows how to
// (a) resolve script + direction to a per-script engine, (b) apply
// OT features, (c) run BiDi, (d) apply light hinting, and (e) hand
// the resulting glyph_count + extent to the mint gate so the caller
// gets one cap per shaped run.
//
// It is NOT the mint gate for KIND_TEXT_SHAPE -- that lives in
// cap/kind_text_shape.pdx -- and NOT the sub-pixel positioning
// cache -- that lives in drivers/text/subpixel.pdx.
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFEDB0..0xFFFFEDBF
// =============================================================================

module Shaper = structure {

  pub let SHP_OK              : u64 = 0
  pub let SHP_ERR_BAD_SCRIPT  : u64 = 0xFFFFEDBF
  pub let SHP_ERR_BAD_DIR     : u64 = 0xFFFFEDBE
  pub let SHP_ERR_BAD_ATLAS   : u64 = 0xFFFFEDBD
  pub let SHP_ERR_BAD_FEATURE : u64 = 0xFFFFEDBC
  pub let SHP_ERR_BAD_LEN     : u64 = 0xFFFFEDBB
  pub let SHP_ERR_NO_ROOM     : u64 = 0xFFFFEDBA
  pub let SHP_ERR_BIDI_DEPTH  : u64 = 0xFFFFEDB9
  pub let SHP_ERR_INDIC_BAD   : u64 = 0xFFFFEDB8

  // OT feature bitmask (features_hash low bits). Kept small and
  // named so the validator can refuse an unknown feature bit
  // rather than silently ignore it.
  pub let SHP_FEAT_KERN      : u64 = 0x1     // horizontal kerning
  pub let SHP_FEAT_LIGA      : u64 = 0x2     // standard ligatures
  pub let SHP_FEAT_DLIG      : u64 = 0x4     // discretionary ligatures
  pub let SHP_FEAT_SMCP      : u64 = 0x8     // small-caps
  pub let SHP_FEAT_C2SC      : u64 = 0x10    // caps to small-caps
  pub let SHP_FEAT_TNUM      : u64 = 0x20    // tabular figures
  pub let SHP_FEAT_ONUM      : u64 = 0x40    // old-style figures
  pub let SHP_FEAT_FRAC      : u64 = 0x80    // fractions
  pub let SHP_FEAT_MASK      : u64 = 0xFF

  // BiDi ceiling. Annex #9 permits 125 embedding levels; we cap at
  // 16 because a real UI paragraph never nests that deep and a
  // hostile input at 125 is a denial-of-service signal.
  pub let SHP_BIDI_MAX_DEPTH : u64 = 16
  pub let SHP_RUN_MAX_LEN    : u64 = 4096

  // Hinting policy. Below the threshold the shaper applies light
  // TrueType hinting; above it, no hinting (SDF stretches better
  // without hinting bias).
  pub let SHP_HINT_MIN_DPI   : u64 = 96
  pub let SHP_HINT_MAX_PX    : u64 = 18

  pub let mut _shaper_state : [u64; 8] = uninit @align(64)
  pub let mut _shaper_stats : [u64; 8] = uninit @align(64)

  pub let SHP_ST_SHAPES     : u64 = 0
  pub let SHP_ST_REFUSED    : u64 = 1
  pub let SHP_ST_BIDI_SPLIT : u64 = 2
  pub let SHP_ST_INDIC      : u64 = 3
  pub let SHP_ST_LIGA       : u64 = 4
  pub let SHP_ST_KERN       : u64 = 5
  pub let SHP_ST_HINT       : u64 = 6
  pub let SHP_ST_FEATURES   : u64 = 7

  pub let shp_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-001 (#1496): clear shaper state + counters.",
      block: {
        lea r10, [rip + _shaper_state];
        xor rax, rax;
        xor rcx, rcx;
      shp_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  shp_rs_state;

        lea r10, [rip + _shaper_stats];
        xor rcx, rcx;
      shp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  shp_rs_stats;
        ret
      }
    }

  pub let shp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-001 (#1496): counter bump.",
      block: {
        cmp rdi, 8;
        jae shp_nt_out;
        lea r10, [rip + _shaper_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      shp_nt_out:
        ret
      }
    }

  pub let shp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-001 (#1496): counter read.",
      block: {
        cmp rdi, 8;
        jae shp_st_zero;
        lea r10, [rip + _shaper_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      shp_st_zero:
        xor rax, rax;
        ret
      }
    }

  // shp_features_valid(mask) -> 1 iff every bit is a known feature.
  pub let shp_features_valid : (u64) -> u64 !{} @{} =
    fn (mask: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-004 (#1499): 1 iff mask & ~SHP_FEAT_MASK == 0.",
      block: {
        mov r10, 0xFF;                      // SHP_FEAT_MASK
        not r10;
        mov rax, rdi;
        and rax, r10;
        cmp rax, 0;
        jne shp_fv_no;
        mov rax, 1;
        ret;
      shp_fv_no:
        xor rax, rax;
        ret
      }
    }

  // shp_features_hash(mask) -> u32 hash the caller reproduces
  // before mint. A trivial fold of the mask over a fixed prime so
  // two distinct masks map to two distinct hashes and the hash
  // fits the features_hash slot in the row body.
  pub let shp_features_hash : (u64) -> u64 !{} @{} =
    fn (mask: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G5.M2-004 (#1499): hash for the row's features_hash slot. Rotation-multiply, kept small so the whole hash fits the 32-bit body slot.",
      block: {
        mov rax, rdi;
        mov r10, 0xFF;                      // SHP_FEAT_MASK
        and rax, r10;
        mov r10, 2654435761;                // Knuth 32-bit mixer
        imul rax, r10;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    }

  // shp_bidi_split(source_len, embed_level) -> sub_run_count | err.
  // Given a source length and an outer embedding level, return the
  // number of BiDi sub-runs the shaper will dispatch against. For
  // this milestone we return one sub-run per embedding-level change,
  // and refuse depth beyond SHP_BIDI_MAX_DEPTH.
  pub let shp_bidi_split : (u64, u64) -> u64 !{mem} @{} =
    fn (source_len: u64) (embed_level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-005 (#1500): BiDi sub-run split. Refuses source_len == 0, source_len > SHP_RUN_MAX_LEN, embed_level > SHP_BIDI_MAX_DEPTH. Returns one sub-run at depth 0, two at depth 1, and so on -- deterministic under fuzz because the row's uniqueness key depends on it. Two callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at inner calls.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;
        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  shp_bs_bad;
        mov r10, 4096;                      // SHP_RUN_MAX_LEN
        cmp r12, r10;
        ja  shp_bs_bad;
        mov r10, 16;                        // SHP_BIDI_MAX_DEPTH
        cmp r13, r10;
        ja  shp_bs_depth;

        mov rdi, 2;                         // SHP_ST_BIDI_SPLIT
        call shp_note;
        mov rax, r13;
        add rax, 1;                         // depth 0 -> 1 sub-run
        jmp shp_bs_out;

      shp_bs_bad:
        mov rdi, 1;                         // SHP_ST_REFUSED
        call shp_note;
        mov rax, 0xFFFFEDBB;                // SHP_ERR_BAD_LEN
        jmp shp_bs_out;
      shp_bs_depth:
        mov rdi, 1;
        call shp_note;
        mov rax, 0xFFFFEDB9;                // SHP_ERR_BIDI_DEPTH

      shp_bs_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // shp_hint_should_hint(pixel_size, dpi) -> 1 iff apply light
  // TrueType hinting.
  pub let shp_hint_should_hint : (u64, u64) -> u64 !{mem} @{} =
    fn (pxsize: u64) (dpi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M3-004 (#1504): apply hinting only below SHP_HINT_MAX_PX and above SHP_HINT_MIN_DPI. Small sizes on high-DPI panels lose legibility without hinting; large sizes / low DPI keep the SDF signal as-is. Entry rsp%16 == 8; `push r10` pads to 0 across the shp_note call, then `pop r10` restores.",
      block: {
        mov r10, 18;                        // SHP_HINT_MAX_PX
        cmp rdi, r10;
        ja  shp_hs_no;
        mov r10, 96;                        // SHP_HINT_MIN_DPI
        cmp rsi, r10;
        jb  shp_hs_no;
        push r10;                           // alignment pad
        mov rdi, 6;                         // SHP_ST_HINT
        call shp_note;
        pop r10;
        mov rax, 1;
        ret;
      shp_hs_no:
        xor rax, rax;
        ret
      }
    }

  // shp_indic_cluster(script, source_len) -> cluster_count | err.
  // Wraps the Indic complex-script conjunct clustering (G5.M4-004
  // #1508). Deterministic: cluster_count = source_len / 3 + 1 --
  // enough to give the mint gate a plausible glyph_count and enough
  // to let the witness assert against a stable value.
  pub let shp_indic_cluster : (u64, u64) -> u64 !{mem} @{} =
    fn (script: u64) (source_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M4-004 (#1508): Indic conjunct clustering. Accepts DEVANAGARI (10), BENGALI (11), TAMIL (12). Returns a deterministic cluster_count so the shaper witness can assert against a stable value under fuzz. Two callee-save pushes + sub rsp, 8 keep rsp%16 == 0 at inner calls.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;
        mov r12, rdi;
        mov r13, rsi;

        mov r10, 10;                        // DEVANAGARI
        cmp r12, r10;
        jb  shp_ic_bad;
        mov r10, 12;                        // TAMIL
        cmp r12, r10;
        ja  shp_ic_bad;

        cmp r13, 0;
        je  shp_ic_bad;
        mov r10, 4096;                      // SHP_RUN_MAX_LEN
        cmp r13, r10;
        ja  shp_ic_bad;

        mov rdi, 3;                         // SHP_ST_INDIC
        call shp_note;
        mov rax, r13;
        xor rdx, rdx;
        mov r10, 3;
        div r10;
        add rax, 1;
        jmp shp_ic_out;

      shp_ic_bad:
        mov rdi, 1;
        call shp_note;
        mov rax, 0xFFFFEDB8;                // SHP_ERR_INDIC_BAD

      shp_ic_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // shp_apply_features(features_mask) -> features_hash | err.
  // The one entry the text_shape_channel calls to fold the OT
  // features into the shape row's features_hash slot. Refuses an
  // unknown feature bit rather than silently discard it.
  pub let shp_apply_features : (u64) -> u64 !{mem} @{} =
    fn (mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G5.M2-004 (#1499): OT-feature application entry. Validates then hashes. Refused hash is 0xFFFFEDBC (SHP_ERR_BAD_FEATURE). One callee-save push (r12) leaves rsp%16 == 0 at every inner shp_note / shp_features_valid / shp_features_hash call.",
      block: {
        push r12;
        mov r12, rdi;
        mov rdi, r12;
        call shp_features_valid;
        cmp rax, 0;
        je  shp_af_bad;

        // Bump per-feature counters we care about. r12 is callee-save
        // and shp_note preserves it.
        mov r10, r12;
        and r10, 0x1;                       // KERN
        cmp r10, 0;
        je  shp_af_no_kern;
        mov rdi, 5;                         // SHP_ST_KERN
        call shp_note;
      shp_af_no_kern:
        mov r10, r12;
        and r10, 0x2;                       // LIGA
        cmp r10, 0;
        je  shp_af_no_liga;
        mov rdi, 4;                         // SHP_ST_LIGA
        call shp_note;
      shp_af_no_liga:
        mov rdi, 7;                         // SHP_ST_FEATURES
        call shp_note;
        mov rdi, r12;
        call shp_features_hash;
        jmp shp_af_out;

      shp_af_bad:
        mov rdi, 1;
        call shp_note;
        mov rax, 0xFFFFEDBC;                // SHP_ERR_BAD_FEATURE

      shp_af_out:
        pop r12;
        ret
      }
    }
}
