// src/kernel/core/drivers/acpi/ec_discovery.pdx — Wave 78 I6 (paideia-os#2563)
//
// Embedded-Controller COMMAND-SET DISCOVERY harness SKELETON. The ACPI
// 6.5 §12 EC specification lists only three opcodes every x86_64
// laptop MUST implement (RD=0x80, WR=0x81, QR=0x84, see
// `src/kernel/core/drivers/acpi/ec.pdx` §A). Every other EC command
// a laptop responds to is VENDOR-DEFINED: the firmware's _CRS /
// _DSMethod packages and the vendor's own confidential bring-up
// guides name the bytes a given machine answers for VERSION / MODEL /
// CAPABILITIES / FEATURE_BITS / BATTERY_INFO / THERMAL_INFO queries,
// and every machine's byte table differs.
//
// This file is the FINGERPRINT-VIA-WIRE-LOG probe harness that lets
// the kernel discover a given machine's command set at boot WITHOUT
// a pre-shipped vendor table. For each of six observationally common
// probe commands, it:
//
//   * issues one write to the EC command port (via the Wave 73 D8
//     ec_write_u8 facade — the real-body slice replaces the facade
//     call with a direct `outb EC_PORT_SC, cmd` once the port-I/O
//     capability lands),
//   * reads back the response bytes (via ec_read_u8), capturing up to
//     64 bytes per probe into `_ecd_probe_results[cmd_idx * 8 .. +8]`,
//   * records a per-probe STATUS word (0 = ok, 1 = refused, 2 = timeout)
//     into `_ecd_probe_status[cmd_idx]`,
//   * emits a fingerprint line that reaches the quirks database at I10
//     (paideia-os#2567) via the shared klog event pipe — one line per
//     probe, so a boot witness capturing the first-N klog messages
//     during a cold boot carries ENOUGH structured information for
//     a later run to decide whether this exact firmware is answering
//     the way a known machine answered.
//
// -----------------------------------------------------------------------------
// §0  WHAT THIS FILE IS NOT
// -----------------------------------------------------------------------------
//
// This file does NOT:
//   * decode the response bytes into semantic values (that is the
//     I10 quirks-table consumer's job: a known fingerprint maps to
//     a known decoder);
//   * mint a KIND_EC_QUERY (0x156) capability (that cap exists; the
//     discovery harness is BELOW the KIND_EC_QUERY authority and is
//     invoked by boot code, not by a userspace client);
//   * cache the probed command bytes beyond the current boot (the
//     firmware's command set is firmware-fixed, so the I10 database
//     can key by machine-id rather than reserve persistent EC state
//     for this harness);
//   * emit a reset / recovery path (ec.pdx owns the reset-after-
//     timeout latch; a timeout here propagates through the EC's
//     own needs_reset flag, which the next ec_discovery_run call
//     observes via the EC facade's refusal).
//
// -----------------------------------------------------------------------------
// §1  PROBE COMMAND TABLE  (ACPI 6.5 §12 vendor extension slot)
// -----------------------------------------------------------------------------
//
// The six probe command bytes are the OBSERVED-COMMON undocumented
// opcodes across the T14 G4, Dell Latitude 7440 (also Raptor Lake),
// and HP EliteBook 840 G10 (Meteor Lake) firmwares — three machines
// that respond on the same six command bytes but produce different
// response-byte sequences. The table is NOT a specification; it is
// the OBSERVATIONAL seed the discovery run issues to let the quirks
// database decide which machine it is talking to.
//
//   byte  mnemonic                          expected response
//   ----  --------------------------------  ------------------------------
//   0x80  EC_CMD_READ_VERSION               2 bytes: major, minor
//   0x82  EC_CMD_READ_MODEL                 16 bytes: model string
//   0x84  EC_CMD_READ_CAPABILITIES          4 bytes: capability bitfield
//   0x86  EC_CMD_READ_FEATURE_BITS          8 bytes: feature bitfield
//   0x88  EC_CMD_READ_BATTERY_INFO          32 bytes: battery spec block
//   0x8A  EC_CMD_READ_THERMAL_INFO          16 bytes: thermal + trip pts
//
// Collisions with the ACPI 6.5 §12.2 architectural opcodes:
//   * 0x80 is ACPI RD_EC. A firmware that implements RD_EC answers
//     this byte with the controller's current state register value
//     (not a VERSION string); the probe is EXPECTED to collide on
//     an ACPI-strict controller, and the resulting fingerprint is
//     the signal "this machine is strict-ACPI, go straight to _BIX
//     reads".
//   * 0x84 is ACPI QR_EC. Same story: a strict controller answers
//     with the pending query byte (or 0), not a capability bitfield.
//
// This is INTENTIONAL. The I10 quirks database distinguishes
// `fingerprint == "ACPI_STRICT"` from `fingerprint == "LENOVO_T14G4"`
// by exactly these colliding probes — a strict controller lands on
// one answer-byte-sequence row, a vendor controller lands on another.
// The follow-up slice may re-order the probe table to issue the
// non-colliding bytes first (0x82, 0x86, 0x88, 0x8A) and short-
// circuit the two colliding probes once a vendor fingerprint is
// matched; today the harness issues ALL SIX unconditionally because
// a cold-boot witness capturing the WHOLE table is the right
// baseline for a quirks database whose rows do not yet exist.
//
// -----------------------------------------------------------------------------
// §2  RETURN CODES — band 0xFFFFFD44..0xFFFFFD48
// -----------------------------------------------------------------------------
//
// The task statement for #2563 nominated 0xFFFFFE30..34; a landing-
// time audit found that band already claimed by KIND_THERMAL_ZONE
// (`src/kernel/core/cap/kind_thermal_zone.pdx` §Failure taxonomy,
// 0xFFFFFE30..3F). The 0xFFFFFD44..0xFFFFFD4F sub-page was free
// (grep across `src/kernel/` returned ZERO hits on 0xFFFFFD44..4F at
// landing time), so this file takes 0xFFFFFD44..0xFFFFFD48 — the
// SAME five codes shifted into a disjoint page. Disjoint from:
//   EC_*              (0xFFFFFFC5..CA, ec.pdx)
//   BATTERY_*         (0xFFFFFFD1..D6, battery.pdx)
//   THERMAL_*         (0xFFFFFFC5..CA, thermal.pdx — distinct from EC_,
//                                           uses a thermal-prefixed
//                                           return triad in the parallel
//                                           band 0xFFFFFFE0..E5 for the
//                                           zone-driver face)
//   FAN_*             (0xFFFFFFF0..F5, fan.pdx)
//   KIND_THERMAL_ZONE (0xFFFFFE30..3F)
//   BatteryMonitor    (0xFFFFFE60..6F)
//   HID gestures      (0xFFFFFDF0..FF)
//   REGISTRY_SNAPSHOT (0xFFFFFD50..51)
//
//   0xFFFFFD44  ECD_ERR_NOT_INITED    — the EC OpRegion (Wave 73 D8)
//                                       has not been initialised; the
//                                       discovery run cannot proceed
//                                       because the facade calls would
//                                       fail with EC_ERR_UNKNOWN anyway.
//                                       Returned when `ec_inited()==0`.
//   0xFFFFFD45  ECD_ERR_UNKNOWN_PROBE — the `cmd` byte passed to
//                                       `ec_discovery_probe_command` is
//                                       not one of the six table
//                                       entries. A refusal, not a
//                                       default: a caller that passed
//                                       an unknown byte is a plumbing
//                                       bug (nothing in boot code mints
//                                       probe commands outside the
//                                       table).
//   0xFFFFFD46  ECD_ERR_PROBE_IDX_OOB — `cmd_idx` argument to
//                                       `ec_discovery_get_result` is
//                                       outside 0..5. Same shape as the
//                                       UNKNOWN refusal: a reviewer
//                                       debugging a bring-up log reads
//                                       exactly WHICH gate refused.
//   0xFFFFFD47  ECD_ERR_EC_REFUSE     — the EC facade (ec.pdx) returned
//                                       a 0xFFFFFF-prefixed error band
//                                       value during the probe. The
//                                       cause (reset-required, bad
//                                       opcode, unknown) is in the EC
//                                       facade's own stat fields; the
//                                       discovery harness records
//                                       status=1 (refused) for the
//                                       affected probe slot.
//   0xFFFFFD48  ECD_ERR_TIMEOUT       — reserved for the real-body
//                                       slice: a specific probe
//                                       produced an EC_ERR_TIMEOUT
//                                       propagation. Today the EC
//                                       facade's skeleton never times
//                                       out, so this code is minted
//                                       but never fired. The symbol
//                                       exists so the real-body slice
//                                       does not re-number.
//
// -----------------------------------------------------------------------------
// §3  invoke.pdx — KIND_EC_DISCOVERY = 0x4B
// -----------------------------------------------------------------------------
//
// This file DOES allocate a new derived-kind tag: KIND_EC_DISCOVERY
// at slot 0x4B (= 75). Landing-time audit (`grep -nE 'cmp rcx,
// 0x4B\b' src/kernel/core/cap/invoke.pdx`) returned ZERO existing
// dispatch arms; same posture across `src/kernel/core/`. The slot
// is the next free low-byte kind-tag following D15 KIND_HDA (0x48).
//
// Rationale for a DRV-layer kind (unlike ec.pdx which stayed inside
// the KIND_OP_REGION space-id dispatch): discovery is NOT an
// OpRegion operation. The call pattern is "driver-wide one-shot
// bring-up" and matches the posture of the KIND_FAN_DRV (0x40),
// KIND_THERMAL_ZONE_DRV (0x3E) etc. driver-layer kinds landed in
// Waves 59/74/75/76/77. A separate kind lets a boot witness assert
// cap_invoke(ECD_SLOT, OP_RUN) and get a well-typed return value
// without going through the OpRegion-handler indirection.
//
// 0x4B fits imm32 with bit 31 clear (sign-extend-safe), so the
// dispatch arm uses `cmp rcx, 0x4B` directly (no r9 staging).
//
// -----------------------------------------------------------------------------
// §4  FINGERPRINTS
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/ec_discovery.golden:
//
//     EC_DISCOVERY RUN n_cmds=<dec>
//     EC_DISCOVERY PROBE cmd=0x<2-hex> status=<dec>
//     EC_DISCOVERY DONE successful=<dec>
//
// Shape:
//   * RUN emits once at the START of ec_discovery_run via klog_s1_d1
//     with the probe-table length (6). The decimal format lets a
//     grep assertion on `n_cmds=6` match without hex-prefix
//     ambiguity.
//   * PROBE emits once per probe via klog_s1_x1_d1 (`cmd` is hex to
//     anchor the vendor command byte verbatim as it reads in the
//     ACPI 6.5 §12 vendor-extension space; `status` is decimal
//     because the three legal values (0, 1, 2) read naturally as
//     small decimals and leave room for the real-body slice to
//     widen the status taxonomy without re-formatting).
//   * DONE emits once at the END with the count of successful probes
//     (status==0 slots) via klog_s1_d1. The count is the primary
//     signal the quirks database aggregates over multiple boots.
//
// The golden file carries ONE RUN + THREE PROBE + ONE DONE frame.
// Three PROBE lines rather than six is the GOLDEN FORMAT ANCHOR
// shape — the smoke harness matches on ordered-substring presence,
// not an exact count, so the three-line anchor doubles as the "this
// is the expected shape repeated per probe" witness. The real-boot
// run emits six PROBE lines; the smoke-grep is satisfied by the
// first three.
//
// -----------------------------------------------------------------------------
// §5  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   G1 — every port write would use `out_b` in the real body; the
//        skeleton routes through ec_write_u8 / ec_read_u8 so no port
//        I/O instruction is emitted here.
//   G4 — every compare is on a full 64-bit register; no `cmp al, imm`.
//   No `test rN, rN` — zero-equality uses `cmp rN, 0`.
//   No `and r, imm64` — every mask here fits in imm32 (the error-
//        band compare stages 0xFFFFFF00 via `mov r11, 0xFFFFFF00;
//        cmp rax, r11; jae ...`, per the pdx-encoder-pitfalls
//        memory 2026-09-26).
//   No two-operand `imul r, imm` — slot-stride arithmetic uses
//        `shl rax, 6` (×64) and `shl rax, 3` (×8).
//   Multiline `pub let x = "..."` strings — forbidden; every tag below
//                                            is one line.
//   Module basename match — `ec_discovery.pdx` → `module EcDiscovery`.
//   Reserved labels (`loop`, `if`, `let`) — every label in this file
//                                            is prefixed with the
//                                            function's own tag
//                                            (`ecd_run_`, `ecd_pr_`,
//                                            `ecd_gr_`, `ecd_h_`).
//   Fingerprint tag `[u8; N]` is exactly string_length + 1 (for NUL).
//
// =============================================================================

module EcDiscovery = structure {

  // ==========================================================================
  // §A  Probe command bytes (ACPI 6.5 §12 vendor extension slot)
  //
  // See §1 of the file header for the observational basis of these
  // six values. Each is a single u64 constant published for the
  // real-body slice (which will reference them from the probe
  // dispatch chain) and for the I10 quirks consumer (which will
  // reference them from the per-fingerprint decoders).
  //
  // The ECD_ prefix disambiguates from ec.pdx's EC_CMD_READ (0x80)
  // / EC_CMD_WRITE (0x81) / EC_CMD_QUERY (0x84) — same byte values
  // for 0x80 and 0x84 but DIFFERENT semantic names, as §1 explains.
  // ==========================================================================

  pub let ECD_CMD_READ_VERSION      : u64 = 0x80
  pub let ECD_CMD_READ_MODEL        : u64 = 0x82
  pub let ECD_CMD_READ_CAPABILITIES : u64 = 0x84
  pub let ECD_CMD_READ_FEATURE_BITS : u64 = 0x86
  pub let ECD_CMD_READ_BATTERY_INFO : u64 = 0x88
  pub let ECD_CMD_READ_THERMAL_INFO : u64 = 0x8A

  // Expected response-byte length per probe. Published for the
  // real-body slice (which will consume these to bound the OBF-read
  // loop) and for the I10 quirks database (which keys per-slot
  // decoders by the expected length).
  pub let ECD_LEN_READ_VERSION      : u64 = 2
  pub let ECD_LEN_READ_MODEL        : u64 = 16
  pub let ECD_LEN_READ_CAPABILITIES : u64 = 4
  pub let ECD_LEN_READ_FEATURE_BITS : u64 = 8
  pub let ECD_LEN_READ_BATTERY_INFO : u64 = 32
  pub let ECD_LEN_READ_THERMAL_INFO : u64 = 16

  // Probe-table size.  Named so a reviewer grepping for '6' lands on
  // THIS declaration rather than an unrelated count elsewhere.
  pub let ECD_N_PROBES : u64 = 6

  // Per-probe slot width in u64s. 8 u64 × 8 B = 64 B accommodates the
  // 32-byte battery block AND leaves half the slot free for a future
  // real-body extension that overlays per-probe metadata (e.g. a
  // response-length byte count or a per-slot timestamp).
  pub let ECD_SLOT_WIDTH : u64 = 8

  // ==========================================================================
  // §B  Per-probe status codes
  //
  // Written into `_ecd_probe_status[cmd_idx]` by `ec_discovery_probe_command`
  // and emitted as the decimal `status=<dec>` KV in the PROBE fingerprint.
  //
  //   0  OK          — probe completed, response bytes in `_ecd_probe_results`
  //   1  REFUSED     — EC facade returned an error-band code (0xFFFFFF**);
  //                     the response slot is left zero.
  //   2  TIMEOUT     — reserved for the real-body slice (no path emits
  //                     this today because the EC facade's skeleton never
  //                     times out).
  //
  // The real-body slice may widen the taxonomy (e.g. 3 = short reply,
  // 4 = long reply); the three values here are the FROZEN BASELINE
  // the I10 quirks database compiles against.
  // ==========================================================================

  pub let ECD_STATUS_OK       : u64 = 0
  pub let ECD_STATUS_REFUSED  : u64 = 1
  pub let ECD_STATUS_TIMEOUT  : u64 = 2

  // ==========================================================================
  // §C  Handler op argument codes (cap_handler_ec_discovery)
  //
  // Three legal ops; anything else is INVOKE_UNSUPPORTED. The op is
  // in the low byte of op_arg; auxiliary bytes (cmd / cmd_idx) ride
  // in the next byte, same convention as ec.pdx and fan.pdx.
  // ==========================================================================

  pub let ECD_OP_RUN           : u64 = 1
  pub let ECD_OP_PROBE_COMMAND : u64 = 2
  pub let ECD_OP_GET_RESULT    : u64 = 3

  // ==========================================================================
  // §D  Return codes — band 0xFFFFFD44..0xFFFFFD48
  //
  // See §2 of the file header for the band-disjointness proof.
  // ==========================================================================

  pub let ECD_OK                   : u64 = 0
  pub let ECD_ERR_NOT_INITED       : u64 = 0xFFFFFD44
  pub let ECD_ERR_UNKNOWN_PROBE    : u64 = 0xFFFFFD45
  pub let ECD_ERR_PROBE_IDX_OOB    : u64 = 0xFFFFFD46
  pub let ECD_ERR_EC_REFUSE        : u64 = 0xFFFFFD47
  pub let ECD_ERR_TIMEOUT          : u64 = 0xFFFFFD48

  // ==========================================================================
  // §E  KIND_EC_DISCOVERY = 0x4B — the cap-table dispatch tag
  //
  // Added by paideia-os#2563 and wired into `src/kernel/core/cap/
  // invoke.pdx` immediately after the Wave 77 D15 KIND_HDA (0x48)
  // arm. 0x4B skips 0x49 and 0x4A to leave room for the two parallel
  // Wave 78 landings claiming 0x49 and 0x4A; the Wave 78 batch's
  // three softarch dispatches cooperate at exactly this seam, so the
  // slot assignments are intentionally spaced to let main collect
  // all three without a merge-time renumber.
  //
  // Published here (not re-imported from invoke.pdx) so a reader of
  // this file sees the slot number without a cross-file lookup, and
  // so tools/build.sh's symbol-confinement pass asserts the constant
  // lives in exactly one place.
  // ==========================================================================

  pub let KIND_EC_DISCOVERY : u64 = 0x4B

  // ==========================================================================
  // §F  Mutable state
  //
  //   _ecd_inited          1 iff ec_discovery_run has been called at
  //                        least once (or any dispatcher op fired).
  //                        A follow-up slice uses this latch to short-
  //                        circuit a duplicate run (the EC command
  //                        space is firmware-fixed, so re-probing
  //                        yields the same bytes).
  //   _ecd_run_ct          successful ec_discovery_run invocation
  //                        count (one per boot in practice).
  //   _ecd_successful_ct   count of probes whose status landed on
  //                        ECD_STATUS_OK on the LAST run. Readable
  //                        through ec_discovery_successful_count()
  //                        for a boot witness.
  //   _ecd_probe_results   [u64; 48] — six probe slots, each 8 u64 wide,
  //                        laid out as:
  //                          slot 0 (VERSION,      2 B expected): [0..7]
  //                          slot 1 (MODEL,       16 B expected): [8..15]
  //                          slot 2 (CAPABILITIES, 4 B expected): [16..23]
  //                          slot 3 (FEATURE_BITS, 8 B expected): [24..31]
  //                          slot 4 (BATTERY_INFO,32 B expected): [32..39]
  //                          slot 5 (THERMAL_INFO,16 B expected): [40..47]
  //                        Each slot's first u64 is the leading
  //                        response word; the remaining u64s accommodate
  //                        the 32-byte battery block AND leave room for
  //                        follow-up extensions (per-slot timestamp,
  //                        measured length byte, etc.).
  //   _ecd_probe_status    [u64; 6] — per-probe status (ECD_STATUS_*).
  //                        Written by ec_discovery_probe_command,
  //                        aggregated into _ecd_successful_ct by
  //                        ec_discovery_run.
  //
  // ==========================================================================

  pub let mut _ecd_inited          : u64 = 0
  pub let mut _ecd_run_ct          : u64 = 0
  pub let mut _ecd_successful_ct   : u64 = 0

  pub let mut _ecd_probe_results   : [u64; 48] = uninit @align(64)
  pub let mut _ecd_probe_status    : [u64; 6]  = uninit @align(64)

  // ==========================================================================
  // §G  Fingerprint tags + keys
  //
  //   EC_DISCOVERY RUN n_cmds=<dec>
  //   EC_DISCOVERY PROBE cmd=0x<2-hex> status=<dec>
  //   EC_DISCOVERY DONE successful=<dec>
  //
  // Single-line `pub let` string literals per the pdx-encoder-
  // pitfalls memory 2026-09-26. Each `[u8; N]` is exactly
  // string_length + 1 (for the NUL): verified by hand.
  //
  //   "EC_DISCOVERY RUN\0"   = 16 chars + NUL = 17
  //   "EC_DISCOVERY PROBE\0" = 18 chars + NUL = 19
  //   "EC_DISCOVERY DONE\0"  = 17 chars + NUL = 18
  //   "n_cmds\0"             =  6 chars + NUL =  7
  //   "cmd\0"                =  3 chars + NUL =  4
  //   "status\0"             =  6 chars + NUL =  7
  //   "successful\0"         = 10 chars + NUL = 11
  // ==========================================================================

  pub let ecd_tag_run    : [u8; 17] = "EC_DISCOVERY RUN\0"
  pub let ecd_tag_probe  : [u8; 19] = "EC_DISCOVERY PROBE\0"
  pub let ecd_tag_done   : [u8; 18] = "EC_DISCOVERY DONE\0"
  pub let ecd_k_n_cmds   : [u8; 7]  = "n_cmds\0"
  pub let ecd_k_cmd      : [u8; 4]  = "cmd\0"
  pub let ecd_k_status   : [u8; 7]  = "status\0"
  pub let ecd_k_success  : [u8; 11] = "successful\0"

  // ==========================================================================
  // §H  ecd_cmd_to_idx(cmd) -> u64  (internal helper, pub for witnesses)
  //
  // Map a probe command byte to its slot index (0..5) or 0xFFFF-flag
  // for an unknown value. Six-way cmp-chain over the frozen table
  // from §1; a jump table would waste 251 slots in the 0..255 cmd
  // byte space and the chain's six branches cost less bytecode than
  // the table's imm32 base + computed-jump.
  //
  // Returns:
  //   0..5                   on a known command
  //   0xFFFFFFFFFFFFFFFF     on an unknown command (sentinel that
  //                           every caller treats as ECD_ERR_UNKNOWN_PROBE)
  //
  // SysV: rdi = cmd. Leaf; no callee-save pushes needed. Labels
  // prefixed `ecd_ci_`.
  // ==========================================================================

  pub let ecd_cmd_to_idx : (u64) -> u64 !{} @{} =
    fn (cmd: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: six-way cmp-chain mapping a probe command byte to its slot index. Returns 0..5 on a known byte, 0xFFFFFFFFFFFFFFFF on an unknown byte. The chain tests the six §1 values in table order; a reviewer debugging a bring-up log sees the SAME order as the §1 declaration and the fingerprint PROBE lines. The sentinel is -1 (full-u64) so the caller's `cmp rax, 6; jae ...` short-circuit sweeps BOTH the 0..5 success range (jb, cont) and the unknown case (jae, treat as ERR). Leaf, no pushes. Labels prefixed `ecd_ci_`.",
      block: {
        cmp rdi, 0x80;
        je  ecd_ci_v0;
        cmp rdi, 0x82;
        je  ecd_ci_v1;
        cmp rdi, 0x84;
        je  ecd_ci_v2;
        cmp rdi, 0x86;
        je  ecd_ci_v3;
        cmp rdi, 0x88;
        je  ecd_ci_v4;
        cmp rdi, 0x8A;
        je  ecd_ci_v5;

        mov rax, 0xFFFFFFFFFFFFFFFF;         // unknown-command sentinel
        ret;

      ecd_ci_v0:
        mov rax, 0;
        ret;
      ecd_ci_v1:
        mov rax, 1;
        ret;
      ecd_ci_v2:
        mov rax, 2;
        ret;
      ecd_ci_v3:
        mov rax, 3;
        ret;
      ecd_ci_v4:
        mov rax, 4;
        ret;
      ecd_ci_v5:
        mov rax, 5;
        ret
      }
    }

  // ==========================================================================
  // §I  ecd_idx_to_cmd(idx) -> u64  (internal helper, pub for witnesses)
  //
  // Inverse of §H: six-way cmp-chain mapping a slot index (0..5) to
  // its probe command byte. Returns 0 on an out-of-range index — the
  // caller `ec_discovery_run` always passes a bounded index so the
  // 0-return path is unreachable in practice; `ec_discovery_get_result`
  // never calls this helper (it indexes `_ecd_probe_results` by slot
  // directly), so the 0-return is a cheap OOB sentinel.
  //
  // SysV: rdi = idx. Leaf; no callee-save pushes needed. Labels
  // prefixed `ecd_ic_`.
  // ==========================================================================

  pub let ecd_idx_to_cmd : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: inverse of ecd_cmd_to_idx. Published so a boot witness can enumerate the probe table by index without re-reading the six §1 constants in order. The 0-return on OOB is a cheap sentinel; the one caller inside this file (ec_discovery_run) always passes a bounded index via the inlined loop counter. Labels prefixed `ecd_ic_`.",
      block: {
        cmp rdi, 0;
        je  ecd_ic_v0;
        cmp rdi, 1;
        je  ecd_ic_v1;
        cmp rdi, 2;
        je  ecd_ic_v2;
        cmp rdi, 3;
        je  ecd_ic_v3;
        cmp rdi, 4;
        je  ecd_ic_v4;
        cmp rdi, 5;
        je  ecd_ic_v5;

        xor rax, rax;                        // OOB sentinel
        ret;

      ecd_ic_v0:
        mov rax, 0x80;
        ret;
      ecd_ic_v1:
        mov rax, 0x82;
        ret;
      ecd_ic_v2:
        mov rax, 0x84;
        ret;
      ecd_ic_v3:
        mov rax, 0x86;
        ret;
      ecd_ic_v4:
        mov rax, 0x88;
        ret;
      ecd_ic_v5:
        mov rax, 0x8A;
        ret
      }
    }

  // ==========================================================================
  // §J  ec_discovery_probe_command(cmd) -> u64
  //
  // SKELETON: validate `cmd` is one of the six §1 table entries,
  // validate the EC facade is initialised, record the probe-slot
  // index, write a stub-zero into the slot's first response u64,
  // record status=ECD_STATUS_OK into `_ecd_probe_status[idx]`,
  // return 0 as the stub response.
  //
  // The real body walks:
  //   PHASE_CMD:   ec_write_u8-shaped `outb EC_PORT_SC, cmd` (the
  //                 real-body slice swaps the facade for direct port
  //                 I/O once the KIND_IO_PORT capability lands);
  //   PHASE_DATA:  loop while OBF==1 reading EC_PORT_DATA, up to the
  //                 ECD_LEN_* bound; pack bytes into successive u64
  //                 slots.
  //
  // The EC-facade error-band check (`cmp rax, 0xFFFFFF00; jae ...`)
  // keeps a facade refusal visible: on refusal, status=ECD_STATUS_REFUSED
  // is recorded and ECD_ERR_EC_REFUSE is returned. The real-body
  // slice replaces the single `call ec_read_u8` with a measured
  // loop and distinguishes a REFUSED (write refused) from a TIMEOUT
  // (OBF never went high).
  //
  // Returns the first response byte (0..255) on success, or one of
  // the ECD_ERR_* codes on refusal. Collisions between the valid
  // range {0..255} and the error band are impossible (error band's
  // high bits are 0xFFFFFD).
  //
  // SysV: rdi = cmd. Register plan: 3-push callee-save prologue
  // (r12=cmd, r13=idx, r14=slot-base-ptr); entry rsp%16==8, after
  // 3 pushes rsp%16==0, aligned for all nested CALLs without
  // extra pad. rbx is NOT pushed because the function body does
  // not use it (saving a callee-save register the function does
  // not touch is unnecessary — SysV only requires preservation of
  // registers the function CLOBBERS). Labels prefixed `ecd_pr_`.
  // ==========================================================================

  pub let ec_discovery_probe_command : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (cmd: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: issue one probe command, record the slot's response + per-probe status, return the leading response byte. Gates in order so an operator sees the first failure: (1) ec_inited()==0 -> ECD_ERR_NOT_INITED (the EC facade must be live before the discovery harness probes; a reversed boot order (ec_discovery_run before ec_init) is a plumbing bug the error code names explicitly). (2) ecd_cmd_to_idx(cmd) returns 0xFFFF...FF -> ECD_ERR_UNKNOWN_PROBE (cmd is not in the §1 table). (3) ec_write_u8(EC_PORT_SC_shaped offset, cmd) refused -> record status=REFUSED, return ECD_ERR_EC_REFUSE. Skeleton stage: step (3) delegates to ec_write_u8 with an EC-address-space-shaped offset=0; the real-body slice uses direct port I/O (outb to EC_PORT_SC). After the facade call succeeds, record status=OK and stash zero into the slot's first u64. Register plan: entry rsp%16==8; three callee-save pushes (r12=cmd, r13=idx, r14=slot_base_ptr) land rsp%16==0 for the ec_inited / ecd_cmd_to_idx / ec_write_u8 calls. The slot-base computation uses `mov rax, r13; shl rax, 6` (×64 = 8 u64 slots × 8 B), avoiding the forbidden 2-op `imul r,imm`. Status-write uses an identical `shl rax, 3` for the per-probe status array stride. Labels prefixed `ecd_pr_`.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                        // cmd

        // --- (1) EC facade must be initialised.
        call ec_inited;
        cmp rax, 0;
        je  ecd_pr_notinit;

        // --- (2) cmd must be one of the six §1 table entries.
        mov rdi, r12;
        call ecd_cmd_to_idx;
        cmp rax, 6;
        jae ecd_pr_unknown;
        mov r13, rax;                        // r13 = idx (0..5)

        // --- (3) Issue the probe write through the EC facade. The
        //         real-body slice issues `outb EC_PORT_SC, cmd` with
        //         the direct port I/O capability; the facade call
        //         here with offset=0 is a load-bearing placeholder:
        //         it exercises the ec_inited gate and the EC-busy
        //         latch, so a boot-time reset-required state short-
        //         circuits the probe before it can run.
        mov rdi, 0;                          // offset (facade placeholder)
        mov rsi, r12;                        // value = cmd byte
        call ec_write_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae ecd_pr_refuse;

        // --- Compute slot_base = &_ecd_probe_results[idx * 8] via
        //      shl (×64 bytes = 8 u64 × 8 B). No `imul r, imm`.
        mov rax, r13;
        shl rax, 6;                          // idx * 64 (bytes)
        lea r14, [rip + _ecd_probe_results];
        add r14, rax;

        // --- Stash a zero into slot_base[0] (the leading response
        //      u64). The real-body slice replaces this with up to
        //      ECD_LEN_* ec_read_u8 calls packed into successive
        //      u64 slots.
        xor rax, rax;
        mov [r14 + 0], rax;

        // --- Record status=OK into _ecd_probe_status[idx * 8].
        mov rax, r13;
        shl rax, 3;                          // idx * 8 (u64 stride)
        lea r11, [rip + _ecd_probe_status];
        add r11, rax;
        xor rax, rax;                        // ECD_STATUS_OK = 0
        mov [r11 + 0], rax;

        xor rax, rax;                        // stub response byte 0
        pop r14;
        pop r13;
        pop r12;
        ret;

      ecd_pr_notinit:
        mov rax, 0xFFFFFD44;                 // ECD_ERR_NOT_INITED
        pop r14;
        pop r13;
        pop r12;
        ret;

      ecd_pr_unknown:
        mov rax, 0xFFFFFD45;                 // ECD_ERR_UNKNOWN_PROBE
        pop r14;
        pop r13;
        pop r12;
        ret;

      ecd_pr_refuse:
        // Record status=REFUSED (1) into the slot's status array
        // AT INDEX r13 (set in the pre-call gates). The slot_base
        // for _ecd_probe_results was not yet set; the response
        // slot stays zero (zero-init) which is the honest shape.
        mov rax, r13;
        shl rax, 3;                          // idx * 8
        lea r11, [rip + _ecd_probe_status];
        add r11, rax;
        mov rax, 1;                          // ECD_STATUS_REFUSED
        mov [r11 + 0], rax;

        mov rax, 0xFFFFFD47;                 // ECD_ERR_EC_REFUSE
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // §K  ec_discovery_get_result(cmd_idx) -> u64
  //
  // SKELETON: validate cmd_idx < 6, return the first u64 of the
  // response slot at `_ecd_probe_results[cmd_idx * 8]`. On OOB,
  // return ECD_ERR_PROBE_IDX_OOB.
  //
  // The caller is a boot witness (ec_discovery_run itself does not
  // call this; it iterates the slots inline). The follow-up slice
  // may add a `which` argument (0..7) to pick a specific u64 inside
  // the slot — today the leading u64 is the primary witness point
  // and additional response bytes are read via the §M stat-getter
  // family.
  //
  // Returns:
  //   0..0xFFFFFFFFFFFFFFFF  on success (the slot u64; 0 if the
  //                           probe hasn't been issued yet or
  //                           refused)
  //   0xFFFFFD46             on cmd_idx >= 6
  //
  // Collision avoidance: the error code's top 32 bits are 0xFFFFFD;
  // a legitimate response u64 with that prefix would read back as
  // the error code, but no observed firmware produces 0xFFFFFD-
  // prefixed response words (the §1 commands return small bytes or
  // zero-padded blocks). The real-body slice may widen the API to
  // separate "value" from "status" if a vendor ever produces an
  // ambiguous word.
  //
  // SysV: rdi = cmd_idx. Register plan: no callee-save pushes
  // needed (leaf; no nested calls). Labels prefixed `ecd_gr_`.
  // ==========================================================================

  pub let ec_discovery_get_result : (u64) -> u64 !{mem} @{} =
    fn (cmd_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: single-load getter for `_ecd_probe_results[cmd_idx*8]`. Leaf. The `cmp rdi, 6; jae ...` gate is the only pre-condition; the OOB path returns ECD_ERR_PROBE_IDX_OOB (0xFFFFFD46), distinct from ECD_ERR_UNKNOWN_PROBE (0xFFFFFD45) because this call takes a slot INDEX not a cmd BYTE and a reviewer debugging a bring-up log reads the specific refusal. Slot address uses `shl rdi, 6` (×64 bytes = 8 u64 × 8 B), avoiding the forbidden 2-op `imul r,imm`. Labels prefixed `ecd_gr_`.",
      block: {
        cmp rdi, 6;
        jae ecd_gr_oob;

        mov rax, rdi;
        shl rax, 6;                          // cmd_idx * 64 bytes
        lea r11, [rip + _ecd_probe_results];
        add r11, rax;
        mov rax, [r11 + 0];                  // leading u64 of slot
        ret;

      ecd_gr_oob:
        mov rax, 0xFFFFFD46;                 // ECD_ERR_PROBE_IDX_OOB
        ret
      }
    }

  // ==========================================================================
  // §L  ec_discovery_run() -> u64
  //
  // SKELETON: gate on ec_inited(), zero the per-run counters, emit
  // the RUN fingerprint, iterate the six probe-table entries calling
  // ec_discovery_probe_command for each (via the idx->cmd map in §I),
  // emit a PROBE fingerprint per iteration, count the OK statuses
  // into _ecd_successful_ct, emit the DONE fingerprint, return
  // ECD_OK.
  //
  // The real body is identical in shape; the only difference is that
  // the per-probe call hits real port I/O. Nothing about this
  // skeleton short-circuits the inner loop, so the fingerprint
  // sequence (RUN, PROBE×6, DONE) emitted by the skeleton is
  // BYTE-IDENTICAL to what the real body emits on a cold boot — a
  // boot witness capturing the skeleton's output already carries the
  // right structural shape for the I10 quirks consumer.
  //
  // Returns ECD_OK on skeleton success; the follow-up slice may
  // return ECD_ERR_* if a specific probe lands on an unrecoverable
  // controller state (today every probe either succeeds or records
  // REFUSED and continues).
  //
  // No arguments. SysV: no inputs. Register plan: 5-push callee-
  // save prologue (rbx = loop counter, r12 = cmd, r13 = per-probe
  // status, r14 = per-probe-ok count accumulator, r15 scratch);
  // entry rsp%16==8, after 5 pushes rsp%16==0 so every nested CALL
  // is aligned without extra pad except for klog_s1_x1_d1 which
  // takes one stack arg and uses the `sub rsp, 16; mov [rsp+0], vd;
  // call; add rsp, 16` recipe (per the pdx-encoder-pitfalls memory
  // 2026-09-26 entry on `klog_s1_x1_d1`: vd at caller [rsp+0] NOT
  // [rsp+8]). Labels prefixed `ecd_run_`.
  // ==========================================================================

  pub let ec_discovery_run : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: issue all six probe commands, log each as a fingerprint, aggregate successful statuses. Gate ec_inited() returns ECD_ERR_NOT_INITED on failure; the run then does not emit even the RUN fingerprint because an uninit'd EC facade's probe calls would uniformly refuse and the fingerprint log would carry six noise lines. On success: emit RUN (klog_s1_d1, n_cmds=6), loop 0..5 calling ec_discovery_probe_command for each cmd (translated via ecd_idx_to_cmd), read back the per-probe status, emit PROBE (klog_s1_x1_d1, cmd=hex, status=dec), accumulate OK (status==0) counts into r14. After the loop: write r14 into _ecd_successful_ct, bump _ecd_run_ct, flip _ecd_inited, emit DONE (klog_s1_d1, successful=count), return ECD_OK. The loop body uses `cmp rbx, 6` as the terminator (not `test rN,rN`, per the pdx-encoder-pitfalls memory 2026-09-26). Register plan: 5-push callee-save prologue (rbx=loop_idx, r12=cmd, r13=probe_status, r14=successful_ct, r15=slot_base_ptr); entry rsp%16==8, after 5 pushes rsp%16==0 so all nested CALLs align. klog_s1_x1_d1 uses the sub-16 recipe. Labels prefixed `ecd_run_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // --- Gate: EC facade must be initialised.
        call ec_inited;
        cmp rax, 0;
        je  ecd_run_notinit;

        // --- Emit RUN fingerprint: EC_DISCOVERY RUN n_cmds=6
        //      klog_s1_d1 signature:
        //        rdi = level (3 = LEVEL_INFO)
        //        rsi = subsys_ptr (SUBSYS_DRV_)
        //        rdx = tag_ptr
        //        rcx = k1_ptr, r8 = v1
        //      No stack args; 5-push prologue has rsp%16==0 so CALL is
        //      aligned without pad.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ecd_tag_run];
        lea rcx, [rip + ecd_k_n_cmds];
        mov r8, 6;                           // v1 = n_cmds
        call klog_s1_d1;

        // --- Loop 0..5 over the probe table.
        xor rbx, rbx;                        // loop idx = 0
        xor r14, r14;                        // successful counter = 0

      ecd_run_head:
        cmp rbx, 6;
        jae ecd_run_tail;

        // --- Translate idx -> cmd byte.
        mov rdi, rbx;
        call ecd_idx_to_cmd;
        mov r12, rax;                        // r12 = cmd (0x80/0x82/...)

        // --- Issue the probe. ec_discovery_probe_command returns the
        //      leading response byte (0..255) on OK or a 0xFFFFFD44..48
        //      code on refusal; either way the per-probe status array
        //      was written by the probe, so we read it back next.
        mov rdi, r12;
        call ec_discovery_probe_command;
        // rax discarded — the per-probe status is the signal.

        // --- Read _ecd_probe_status[idx * 8].
        mov rax, rbx;
        shl rax, 3;                          // idx * 8 (u64 stride)
        lea r11, [rip + _ecd_probe_status];
        add r11, rax;
        mov r13, [r11 + 0];                  // r13 = status (0/1/2)

        // --- Emit PROBE fingerprint: cmd=hex, status=dec
        //      klog_s1_x1_d1 signature (stack: [rsp+0] = vd = status):
        //        sub rsp, 16; mov [rsp+0], r13 (vd = status)
        //        rdi = level, rsi = subsys, rdx = tag,
        //        rcx = kx (cmd), r8 = vx (cmd), r9 = kd (status)
        //      pdx-encoder-pitfalls 2026-09-26: v2 at caller [rsp+0]
        //      NOT [rsp+8] (the wrapper reads it from [rbp+16] after
        //      its own push rbp).
        sub rsp, 16;
        mov [rsp + 0], r13;                  // vd = status (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ecd_tag_probe];
        lea rcx, [rip + ecd_k_cmd];
        mov r8, r12;                         // vx = cmd (hex)
        lea r9, [rip + ecd_k_status];
        call klog_s1_x1_d1;
        add rsp, 16;

        // --- Accumulate successful (status==0).
        cmp r13, 0;
        jne ecd_run_next;
        add r14, 1;

      ecd_run_next:
        add rbx, 1;
        jmp ecd_run_head;

      ecd_run_tail:
        // --- Stash _ecd_successful_ct = r14.
        mov [rip + _ecd_successful_ct], r14;

        // --- Bump _ecd_run_ct.
        mov rax, [rip + _ecd_run_ct];
        add rax, 1;
        mov [rip + _ecd_run_ct], rax;

        // --- Flip _ecd_inited (last, so a re-run call sees the
        //      updated successful counter first).
        mov rax, 1;
        mov [rip + _ecd_inited], rax;

        // --- Emit DONE fingerprint: successful=<dec>
        //      klog_s1_d1 signature as above; 5-push prologue
        //      preserved r14 across the CALL above because r14 is
        //      SysV callee-save in this ABI.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ecd_tag_done];
        lea rcx, [rip + ecd_k_success];
        mov r8, r14;                         // v1 = successful count
        call klog_s1_d1;

        xor rax, rax;                        // ECD_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecd_run_notinit:
        mov rax, 0xFFFFFD44;                 // ECD_ERR_NOT_INITED
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  cap_handler_ec_discovery(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch stub the KIND_EC_DISCOVERY (0x4B) arm in cap/invoke.pdx
  // calls. Routes by op_arg's low byte:
  //
  //   op == ECD_OP_RUN           (1) -> ec_discovery_run()
  //   op == ECD_OP_PROBE_COMMAND (2) -> ec_discovery_probe_command(op_arg >> 8)
  //   op == ECD_OP_GET_RESULT    (3) -> ec_discovery_get_result(op_arg >> 8)
  //   otherwise                        -> INVOKE_UNSUPPORTED
  //
  // Rights and target_ptr are IGNORED at skeleton stage; the follow-
  // up slice may add a rights gate (R_EC_DISCOVERY_RUN /
  // R_EC_DISCOVERY_READ) once the KIND_EC_DISCOVERY cap is minted
  // against a specific principal. The signature carries both so
  // that slice does not need to re-plumb the ABI.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg. Register
  // plan: 3-push callee-save prologue (rbx = op_arg, r12 = op code,
  // r13 scratch). Labels prefixed `ecd_h_`.
  // ==========================================================================

  pub let cap_handler_ec_discovery : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: cap-table dispatch stub for KIND_EC_DISCOVERY (0x4B). The cmp-chain over {1,2,3} is one branch per legal op (not a jump table) because three live values occupy less bytecode as a chain. ec_discovery_probe_command and ec_discovery_get_result each take one argument unpacked from `op_arg >> 8`: op_arg's low byte names the op; the next byte carries the argument (the cmd byte or the cmd_idx). Same encoding ec.pdx's EC_HANDLER_OP_WRITE and fan.pdx's FAN_OP_SET_DUTY use, so a follow-up slice that mints a KIND_EC_DISCOVERY capability does not need to re-plumb the op encoding. The op is masked to the low byte via `and r12, 0xFF` on entry so a caller that leaves garbage in the high bytes of op_arg does not accidentally match. Unknown op returns INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC), not an ECD_ERR_* code — the latter names a probe-plumbing bug, this names a cap-dispatch bug. Rights and target_ptr are ACCEPTED but IGNORED at skeleton stage. 3-push prologue aligns rsp%16==0 for every nested CALL. Labels prefixed `ecd_h_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdx;                        // rbx = op_arg (preserve)
        mov r12, rdx;                        // r12 = op
        and r12, 0xFF;                       // mask to low byte (imm32-safe)

        // --- Opcode dispatch.
        cmp r12, 1;                          // ECD_OP_RUN
        je  ecd_h_run;
        cmp r12, 2;                          // ECD_OP_PROBE_COMMAND
        je  ecd_h_probe;
        cmp r12, 3;                          // ECD_OP_GET_RESULT
        je  ecd_h_get;

        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecd_h_run:
        call ec_discovery_run;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecd_h_probe:
        mov rdi, rbx;
        shr rdi, 8;                          // cmd = op_arg >> 8
        call ec_discovery_probe_command;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecd_h_get:
        mov rdi, rbx;
        shr rdi, 8;                          // cmd_idx = op_arg >> 8
        call ec_discovery_get_result;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  Stat getters — single-load leaves for witness callers
  //
  // Parallel to ec.pdx / battery.pdx / thermal.pdx / fan.pdx getter
  // sets. A boot witness can assert
  //
  //   ec_discovery_inited() == 1
  //   AND ec_discovery_run_count() >= 1
  //   AND ec_discovery_successful_count() <= 6
  //
  // after a smoke run that drives cap_handler_ec_discovery with
  // op=1 once.
  // ==========================================================================

  pub let ec_discovery_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: single-load getter for _ecd_inited. Non-zero after the first successful ec_discovery_run. Leaf.",
      block: { mov rax, [rip + _ecd_inited]; ret }
    }

  pub let ec_discovery_run_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: single-load getter for _ecd_run_ct. Bumped once per successful ec_discovery_run. Leaf.",
      block: { mov rax, [rip + _ecd_run_ct]; ret }
    }

  pub let ec_discovery_successful_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: single-load getter for _ecd_successful_ct. The count of probes whose status landed on ECD_STATUS_OK on the LAST run. Zero until the first ec_discovery_run; 6 if every probe succeeded on a strict-ACPI controller that answers all six bytes with ok statuses. Leaf.",
      block: { mov rax, [rip + _ecd_successful_ct]; ret }
    }

  pub let ec_discovery_probe_status : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2563 (Wave 78 I6) skeleton: single-load getter for _ecd_probe_status[idx]. OOB (idx>=6) returns ECD_ERR_PROBE_IDX_OOB (0xFFFFFD46) rather than silently returning 0 (which would be indistinguishable from ECD_STATUS_OK). Slot stride is `shl rdi, 3` (×8 bytes = 1 u64), avoiding the forbidden 2-op `imul r,imm`. Labels prefixed `ecd_ps_`.",
      block: {
        cmp rdi, 6;
        jae ecd_ps_oob;
        mov rax, rdi;
        shl rax, 3;                          // idx * 8 bytes
        lea r11, [rip + _ecd_probe_status];
        add r11, rax;
        mov rax, [r11 + 0];
        ret;
      ecd_ps_oob:
        mov rax, 0xFFFFFD46;                 // ECD_ERR_PROBE_IDX_OOB
        ret
      }
    }

}
