// src/kernel/core/drivers/acpi/pstate.pdx — Wave 81 I2 [R30] (paideia-os#2559)
//
// ACPI P-state (performance-state) probe skeleton — Raptor Lake hybrid.
//
// -----------------------------------------------------------------------------
// §0  WHAT THIS FILE IS
// -----------------------------------------------------------------------------
//
// ACPI 6.5 §8.4.4 defines a per-processor P-state (performance state)
// control surface the OS uses to transition each CPU through a bounded
// ladder of {core_freq, power, control_value, status_value} rungs. Each
// processor scope in the DSDT/SSDT exports:
//
//   _PSS  Performance Supported States — returns a Package of 6-field
//         sub-Packages, one per supported rung: {core_freq_mhz,
//         power_mw, trans_latency_us, bus_master_latency_us,
//         control_value, status_value}. The highest-freq rung is at
//         index 0 (ACPI 6.5 §8.4.4.1).
//
//   _PCT  Performance Control Register — returns two Generic Address
//         Structures: {control_reg, status_reg}. control_reg names the
//         MSR or I/O port the OS writes `control_value` to in order to
//         request the rung; status_reg names where the OS polls for the
//         rung's `status_value` to confirm the transition (ACPI 6.5
//         §8.4.4.2). Modern Intel platforms expose both as MSR
//         IA32_PERF_CTL (0x199) / IA32_PERF_STATUS (0x198).
//
// Raptor Lake is a HYBRID die: P-cores (Golden Cove-derived) and E-
// cores (Gracemont-derived) run two DIFFERENT _PSS tables because they
// occupy different frequency/power envelopes. T14 G4 ships 6 P-cores +
// 8 E-cores + two LPE-cores (low-power efficient, package-C deep
// residency). The firmware exports one _PSS/_PCT pair per LOGICAL CPU
// at the Processor scope level, but the SAME physical core-cluster
// (all 6 P-cores) returns bit-identical _PSS data. The kernel exploits
// this: it probes ONE P-core (cpu_idx=0, the P-core lead CPU) and ONE
// E-core (cpu_idx=1, the E-core lead CPU), and the per-core-cluster
// P-state driver (follow-up slice) replicates the matched table to
// every CPU in the cluster.
//
// A single probe step is:
//
//   1.  Kernel caller (early boot — the Phase-6 CPU driver's init
//       path, or the Wave 80 I1 _OSC post-grant hook) calls
//       `pstate_probe(cpu_idx)`.
//   2.  This file writes the CPU _OSC UUID + a single control dword
//       `(cpu_idx | PROBE_PSS_PCT_BIT)` into the Wave 80 I1 _OSC
//       walker request ring (`osc_evaluate`), records the handle in
//       `_pstate_last_handle`, and returns 0 on success.
//   3.  The user-space walker (D5 Wave 71, src/user/aml/aml_walker
//       .pdx) picks up the row, evaluates `_PSS` + `_PCT` at the
//       Processor scope for the named cpu, serialises the 6-field
//       sub-Packages into the control-dword buffer (one row of
//       `_pstate_scratch_dwords` per rung), writes the result_dword
//       field (= number of rungs), flips row.status to READY.
//   4.  Follow-up slice adds a `pstate_poll(handle)` that reads the
//       scratch buffer and copies into `_pstate_table`; today the
//       skeleton leaves `_pstate_n_pstates[cpu_idx]` at 0 since the
//       walker has not written any rungs yet.
//
// `pstate_set(cpu_idx, pstate_idx)` ARCHITECTURALLY writes
// `_pstate_table[cpu*16+idx].control_value` to IA32_PERF_CTL via
// WRMSR. At skeleton stage no MSR path is wired: the function returns
// PSTATE_ERR_TRANSITION_REFUSED (0xFFFFFD15) after validating args and
// emitting the SET fingerprint, so a boot witness that drives the
// Phase-6 post-boot CPU-governor init can observe the sequence.
//
// -----------------------------------------------------------------------------
// §1  WHAT THIS FILE IS NOT
// -----------------------------------------------------------------------------
//
// This file does NOT:
//   * run AML. The _PSS/_PCT evaluations happen in the user-space
//     walker (D5 Wave 71, aml_walker.pdx); the kernel merely queues
//     a request onto the Wave 80 I1 OSC ring and holds the handle.
//     The AML firewall tool/lint-no-kernel-aml.sh verifies no AML
//     opcode, DSDT/SSDT identifier, or acpica function names appear
//     below the sed-stripped comment layer.
//   * write to IA32_PERF_CTL. `pstate_set` is wired as a validate-and-
//     fingerprint shell; the actual WRMSR path lands in a follow-up
//     slice once the Wave 81+ MSR-via-cap seam is designed. A kernel
//     that treats this skeleton's return as authoritative will see
//     PSTATE_ERR_TRANSITION_REFUSED (0xFFFFFD15) on every call and
//     fall back to firmware-managed P-states, which is strictly
//     safer than racing a WRMSR against a half-plumbed cap gate.
//   * cover C-states or T-states. Both share the CPU _OSC UUID with
//     P-states but have separate processor-scope AML methods (_CST,
//     _TSS). The follow-up slice can mint sibling KIND_CSTATE and
//     KIND_TSTATE caps against the same ring pattern.
//   * cover more than one P-core cluster or one E-core cluster. T14
//     G4 has one of each; a 2-die Raptor Lake variant (not shipping
//     today) would need a wider `_pstate_table` and more lead-CPU
//     indices. Today's table is sized `[u64; 192]` (= 2 × 16 × 6 u64
//     = 32 × 48 B rows) which covers P-core lead cpu_idx=0 + E-core
//     lead cpu_idx=1.
//   * expose a bulk-copy of the whole P-state table in one call.
//     `pstate_get_entry` returns ONE 48-byte row at a time; a boot
//     witness that wants the whole table calls it in a loop. A
//     cap-arg packing that fits an entry pointer in op_arg would
//     need a dedicated KIND_PSTATE_READ cap (same posture as
//     KIND_OSC_SUBMIT, follow-up).
//
// -----------------------------------------------------------------------------
// §2  P-STATE ENTRY LAYOUT (6 u64 per rung, 16 rungs/CPU, 2 CPUs, 192 u64 total)
// -----------------------------------------------------------------------------
//
// `_pstate_table` is a flat `[u64; 192]`; the row for
// (cpu_idx, pstate_idx) lives at offset
// `(cpu_idx * 16 + pstate_idx) * 48` bytes, i.e. 6 u64s per rung
// times 16 rungs/CPU times 2 CPUs = 192 u64 = 1536 bytes. Columns
// of a single 48-byte row:
//
//   offset  size  field
//   ------  ----  --------------------------------------------------------
//   +0      4     core_freq_mhz        u32 (low  32 bits of u64[0])
//   +4      4     power_mw             u32 (high 32 bits of u64[0])
//   +8      4     trans_latency_us     u32 (low  32 bits of u64[1])
//   +12     4     bus_master_latency_us u32 (high 32 bits of u64[1])
//   +16     8     control_value        u64 (u64[2])
//   +24     8     status_value         u64 (u64[3])
//   +32     1     cpu_kind             u8  (low byte of u64[4])
//                 — 0 = P-core, 1 = E-core, 2 = LPE-core (Raptor Lake
//                   low-power efficient cores package-C deep residency)
//   +33     7     reserved             bytes 1..7 of u64[4]
//   +40     8     reserved             u64[5]
//
// Row-size derivation: 2 × u32 pairs (16 B) + 2 × u64 (16 B) + 2 × u64
// (16 B) = 48 B. The pairs-of-u32 packing for freq+power and lat+bml
// mirrors ACPI 6.5 §8.4.4.1's _PSS sub-Package layout: the four 32-bit
// fields come packed and the walker preserves that packing. The u64
// control_value is wider than the current spec's u32 to accommodate
// future vendor extensions (ACPI 6.5 §8.4.4.1 reserves bits 32..63 of
// the control-register field).
//
// Table dimensions. 16 rungs/CPU is the ACPI 6.5 §8.4.4.1 architectural
// maximum (the Package returned by _PSS has at most 16 sub-Packages).
// 2 CPUs covers T14 G4's two lead-CPU indices (cpu_idx=0 for the P-
// core cluster, cpu_idx=1 for the E-core cluster); a later follow-up
// may widen to 3 (adding LPE-core cluster lead cpu_idx=2) when the
// LPE-core enumeration path lands. The 192-u64 flat array uses .bss
// (via `uninit @align(64)`) so cold-boot cost is zero and image size
// stays unchanged.
//
// -----------------------------------------------------------------------------
// §3  CPU-KIND ENCODING
// -----------------------------------------------------------------------------
//
// The low byte of u64[4] in each row carries one of:
//
//   0  P-core      Golden Cove-derived (6 cores on T14 G4; up to 5.4
//                  GHz turbo on retail stepping B0)
//   1  E-core      Gracemont-derived (8 cores; up to 4.4 GHz turbo)
//   2  LPE-core    Low-power efficient core (2 cores on T14 G4; sit
//                  on the LP ring, enable package-C8/C10 deep
//                  residency; different voltage domain so a different
//                  _PSS table from the main E-cluster)
//
// At skeleton stage the probe does not populate this field (the
// walker reply has not arrived yet, so every row is zero and thus
// claims to be a P-core by default). The real-body slice fills it
// from the per-cluster probe's CPU-identification seam (follow-up
// uses CPUID.1A core-type field = 0x40 P / 0x20 E / 0x10 LPE).
//
// -----------------------------------------------------------------------------
// §4  RETURN CODES — band 0xFFFFFD11..0xFFFFFD15
// -----------------------------------------------------------------------------
//
// Audit at landing time: `grep -rnE '0xFFFFFD1[1-5]\b' src/kernel/`
// returned ZERO hits. 0xFFFFFD0A..0E (the task statement's first-
// pick band) is TAKEN by `cap/kind_ec_query.pdx`'s mint/tail codes
// (EC_QUERY_MINT_ENOSPC..EC_QUERY_TAIL_BAD_ARG, verified by the same
// audit), so the pstate band shifted up one hex-nibble into the free
// 0xFFFFFD11..1A block (0xFFFFFD10 taken, 0xFFFFFD1B..1F taken, leaving
// 11..1A free). The pstate band uses the low five of those ten slots;
// the remaining five (0xFFFFFD16..1A) are reserved for the follow-up
// slice's handle-expiry / walker-not-ready / bad-cap-arg plumbing.
//
// Disjoint from:
//   EC_*               (0xFFFFFFC5..CA, drivers/acpi/ec.pdx)
//   BATTERY_*          (0xFFFFFFD1..D6, drivers/acpi/battery.pdx)
//   FAN_*              (0xFFFFFFF0..F5, drivers/acpi/fan.pdx)
//   ECD_*              (0xFFFFFD44..48, drivers/acpi/ec_discovery.pdx)
//   TPM_*              (0xFFFFFD51..5B, drivers/tpm/tpm_crb.pdx)
//   EC_QUIRKS_*        (0xFFFFFD67..6B, drivers/acpi/ec_quirks.pdx)
//   OSC_*              (0xFFFFFDF5..F9, drivers/acpi/osc.pdx)
//   EC_QUERY_*         (0xFFFFFE0A..0F, cap/kind_ec_query.pdx)
//
//   0xFFFFFD11  PSTATE_ERR_AML_NOT_READY        — osc_evaluate returned
//                                                 an error code (any
//                                                 0xFFFFFD** OSC band
//                                                 value: WALKER_NOT_
//                                                 READY, BAD_UUID,
//                                                 NDWORDS_OOB). The
//                                                 OSC walker ring is
//                                                 the kernel's only
//                                                 AML seam, and a
//                                                 queue refusal means
//                                                 the probe cannot
//                                                 proceed. The kernel
//                                                 should either skip
//                                                 P-state management
//                                                 (defer to firmware)
//                                                 or retry after the
//                                                 walker registers.
//   0xFFFFFD12  PSTATE_ERR_BAD_CPU_IDX          — cpu_idx is outside
//                                                 the probed-CPU
//                                                 range {0, 1}. P-core
//                                                 lead cpu_idx=0;
//                                                 E-core lead cpu_
//                                                 idx=1. Any other
//                                                 value names a cap-
//                                                 dispatch bug (the
//                                                 caller is probing
//                                                 a CPU index the
//                                                 skeleton does not
//                                                 cover) rather than
//                                                 a hardware fault.
//   0xFFFFFD13  PSTATE_ERR_BAD_PSTATE_IDX       — pstate_idx is >= 16
//                                                 (ACPI 6.5 §8.4.4.1
//                                                 architectural max)
//                                                 OR pstate_idx is
//                                                 >= _pstate_n_pstates
//                                                 [cpu_idx] on a get_
//                                                 entry call (asking
//                                                 for a rung that was
//                                                 not populated by the
//                                                 last probe).
//   0xFFFFFD14  PSTATE_ERR_PCT_MISSING          — reserved for the
//                                                 follow-up slice: the
//                                                 walker reply carried
//                                                 _PSS data but not
//                                                 _PCT (the firmware
//                                                 exports _PSS at
//                                                 processor-scope but
//                                                 omits _PCT, e.g.
//                                                 some pre-Haswell
//                                                 server platforms).
//                                                 Minted but not fired
//                                                 at skeleton stage
//                                                 because the walker
//                                                 reply path is not
//                                                 yet wired.
//   0xFFFFFD15  PSTATE_ERR_TRANSITION_REFUSED   — pstate_set validated
//                                                 its args but the
//                                                 WRMSR to IA32_PERF_
//                                                 CTL was refused (at
//                                                 skeleton: NO MSR
//                                                 PATH, every call
//                                                 lands here after
//                                                 arg validation; at
//                                                 real-body: the
//                                                 KIND_MSR cap gate
//                                                 refused the write).
//
// -----------------------------------------------------------------------------
// §5  invoke.pdx — KIND_PSTATE = 0x54
// -----------------------------------------------------------------------------
//
// Audit at landing time: `grep -nE 'cmp rcx, 0x54\b' src/kernel/core/
// cap/invoke.pdx` returned ZERO existing dispatch arms. 0x52..0x53 are
// also empty (verified by the same audit), left free for sibling
// parallel-wave Wave 81 landings at coordinator discretion. 0x54 fits
// imm32 bit 31 clear (sign-extend-safe), so the dispatch arm uses `cmp
// rcx, 0x54` directly without r9 staging. Natural neighbour of the
// Wave 80 I10 KIND_EC_QUIRKS (0x51) arm — both are driver-layer caps
// that mediate ACPI-side state (quirks DB for the EC; P-state ladder
// for the CPU).
//
// cap_handler_pstate(rights, target_ptr, op_arg) routes op_arg's low
// byte, unpacking additional arguments from the higher bytes:
//
//   op == PSTATE_OP_PROBE      (1) -> pstate_probe((op_arg >> 8) & 0xFF)
//                                      cpu_idx in bits 8..15
//   op == PSTATE_OP_GET_COUNT  (2) -> pstate_get_count((op_arg >> 8) & 0xFF)
//                                      cpu_idx in bits 8..15
//   op == PSTATE_OP_GET_ENTRY  (3) -> INVOKE_UNSUPPORTED at skeleton
//                                      (three args including out_ptr do
//                                      not fit in op_arg's remaining
//                                      56 bits; follow-up slice adds a
//                                      KIND_PSTATE_READ cap whose row
//                                      carries the out_ptr — same
//                                      posture as drivers/acpi/osc.pdx
//                                      OSC_OP_EVAL)
//   op == PSTATE_OP_SET        (4) -> pstate_set((op_arg >> 8) & 0xFF,
//                                                (op_arg >> 16) & 0xFF)
//                                      cpu_idx in bits 8..15,
//                                      pstate_idx in bits 16..23
//   otherwise                      -> INVOKE_UNSUPPORTED
//
// -----------------------------------------------------------------------------
// §6  FINGERPRINTS
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/pstate.golden:
//
//     PSTATE PROBE cpu=<dec> n_pstates=<dec>
//     PSTATE SET cpu=<dec> idx=<dec> freq=<dec>
//
// Two frames, one per fingerprint-emitting call site:
//   * PROBE via klog_s1_d2 (cpu + n_pstates; both decimal)
//   * SET via klog_s1_d3 (cpu + idx + freq; three decimals)
//
// get_count and get_entry are LEAF getters and do NOT emit frames —
// a boot witness assembling a per-CPU table calls them in a loop and
// the per-call frame would flood the log. The PROBE frame marks the
// start of the sequence; the SET frame marks the attempted transition
// (which, at skeleton stage, every call refuses with
// PSTATE_ERR_TRANSITION_REFUSED after emitting). The smoke harness
// matches on ordered-substring presence; the real-boot path emits
// probe → set attempt in that order and matches the golden.
//
// -----------------------------------------------------------------------------
// §7  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   No `test rN, rN`                 (zero-equality uses `cmp rN, 0`).
//   No `and r, imm64`                (every mask here fits in imm32;
//                                     byte masks via `and rN, 0xFF`,
//                                     and the module-wide error-band
//                                     check via `mov r11, imm32; cmp
//                                     rax, r11; jae ...`).
//   No 2-op `imul r, imm`            (row stride ×48 uses reg-reg
//                                     `imul rax, r11` with r11 staged
//                                     from a `mov r11, 48` first; per
//                                     the pdx-encoder-pitfalls memory
//                                     2026-09-26).
//   No multiline `pub let x = "..."` (every tag below is one line).
//   Module basename match            `pstate.pdx` → `module Pstate`.
//   Reserved labels                  Every label prefixed `pst_` (and
//                                    a sub-prefix per function, e.g.
//                                    `pst_pb_`, `pst_ge_`); never
//                                    `loop`, `if`, `let`.
//   klog recipe                      `klog_s1_d2`: v2 at caller
//                                    [rsp+0] NOT [rsp+8]. The wrapper
//                                    reads it from [rbp+16] after its
//                                    own `push rbp`. `klog_s1_d3`:
//                                    v2 at caller [rsp+0], k3 at
//                                    [rsp+8], v3 at [rsp+16].
//   Fingerprint tag `[u8; N]`        exactly `string_length + 1` (for
//                                    the trailing NUL).
//   Error-band compare               staged `mov r11, 0xFFFFFD00; cmp
//                                    rax, r11; jae ...` for the osc_
//                                    evaluate return check (any OSC
//                                    error code is in the 0xFFFFFD**
//                                    band or above).
//
// Stack alignment summary. Entry rsp%16==8 (post-CALL from the caller).
// Each function's prologue brings rsp%16 to 0 so every nested CALL is
// aligned; the klog recipes `sub rsp, 16` (klog_s1_d2 at a 3-push
// site) and `sub rsp, 32` (klog_s1_d3 at a 3-push site, 24 B args + 8 B
// pad) keep rsp%16==0 at the klog CALL.
//
// =============================================================================

module Pstate = structure {

  // ==========================================================================
  // §A  Row-layout column byte offsets within a 48-byte row.
  //
  // Published as `pub let` constants so a reviewer reading the probe-
  // site arithmetic sees the symbolic offset without cross-referencing
  // this header. Each column fits either an aligned u32 (4 B) or an
  // aligned u64 (8 B); the two u32 pairs (freq+power, lat+bml) are
  // packed into u64[0] and u64[1] respectively, mirroring the ACPI
  // 6.5 §8.4.4.1 _PSS sub-Package layout.
  // ==========================================================================

  pub let PST_COL_FREQ_MHZ        : u64 = 0       // u32 low half of u64[0]
  pub let PST_COL_POWER_MW        : u64 = 4       // u32 high half of u64[0]
  pub let PST_COL_TRANS_LAT_US    : u64 = 8       // u32 low half of u64[1]
  pub let PST_COL_BML_US          : u64 = 12      // u32 high half of u64[1]
  pub let PST_COL_CONTROL_VALUE   : u64 = 16      // u64 at u64[2]
  pub let PST_COL_STATUS_VALUE    : u64 = 24      // u64 at u64[3]
  pub let PST_COL_CPU_KIND        : u64 = 32      // u8 at low byte of u64[4]
  pub let PST_COL_RESERVED_HI     : u64 = 40      // u64 at u64[5]

  pub let PST_ROW_STRIDE_BYTES    : u64 = 48
  pub let PST_N_RUNGS_MAX         : u64 = 16      // ACPI 6.5 §8.4.4.1
  pub let PST_N_CPUS_PROBED       : u64 = 2       // P-lead + E-lead

  // CPU-kind byte values (see §3 of the file header).
  pub let PST_CPU_KIND_P          : u64 = 0
  pub let PST_CPU_KIND_E          : u64 = 1
  pub let PST_CPU_KIND_LPE        : u64 = 2

  // ==========================================================================
  // §B  Fast-path control-dword encoding for the OSC walker request
  //
  // The CPU _OSC UUID is the WALKER'S routing key (it says "evaluate
  // the CPU-scope AML methods for this request"). The ONE control
  // dword in the buffer carries two fields:
  //
  //   bit 7     1 == probe mode (ask the walker to serialise _PSS
  //              and _PCT and write the rung count to result_dword);
  //              0 reserved for a future notify/subscribe mode
  //   bits 0..6 cpu_idx (0 = P-lead, 1 = E-lead; up to 127 slots of
  //              headroom for a wider follow-up SKU table)
  //
  // Encoded as `(cpu_idx & 0x7F) | 0x80` into _pstate_scratch_dwords[0]
  // before every osc_evaluate call.
  // ==========================================================================

  pub let PST_PROBE_MODE_BIT      : u64 = 0x80

  // ==========================================================================
  // §C  Op argument codes (cap_handler_pstate)
  //
  // Op in op_arg's low byte; cpu_idx rides in bits 8..15 (op=1,2,4);
  // pstate_idx rides in bits 16..23 (op=4). Same encoding ec_quirks.
  // pdx and osc.pdx use so the cap-dispatch recipe does not re-plumb.
  // ==========================================================================

  pub let PSTATE_OP_PROBE         : u64 = 1
  pub let PSTATE_OP_GET_COUNT     : u64 = 2
  pub let PSTATE_OP_GET_ENTRY     : u64 = 3
  pub let PSTATE_OP_SET           : u64 = 4

  // ==========================================================================
  // §D  Return codes — see §4 of the file header.
  // ==========================================================================

  pub let PSTATE_OK                        : u64 = 0
  pub let PSTATE_ERR_AML_NOT_READY         : u64 = 0xFFFFFD11
  pub let PSTATE_ERR_BAD_CPU_IDX           : u64 = 0xFFFFFD12
  pub let PSTATE_ERR_BAD_PSTATE_IDX        : u64 = 0xFFFFFD13
  pub let PSTATE_ERR_PCT_MISSING           : u64 = 0xFFFFFD14
  pub let PSTATE_ERR_TRANSITION_REFUSED    : u64 = 0xFFFFFD15

  // ==========================================================================
  // §E  KIND_PSTATE = 0x54 — the cap-table dispatch tag.
  //
  // Added by paideia-os#2559 and wired into `src/kernel/core/cap/
  // invoke.pdx` immediately after the Wave 80 I10 KIND_EC_QUIRKS
  // (0x51) arm. 0x52..0x53 are left free for sibling parallel-wave
  // Wave 81 landings at coordinator discretion.
  // ==========================================================================

  pub let KIND_PSTATE             : u64 = 0x54

  // ==========================================================================
  // §F  Mutable state
  //
  //   _pstate_inited        1 iff pstate_probe has been called at
  //                         least once with a non-error outcome.
  //   _pstate_probe_ct      total probe-call count (bumped at every
  //                         call that reaches the osc_evaluate seam,
  //                         including AML_NOT_READY outcomes).
  //   _pstate_set_ct        total pstate_set-call count (bumped at
  //                         every call that passes arg validation).
  //   _pstate_last_handle   handle from the most recent successful
  //                         osc_evaluate (zero before first probe).
  //   _pstate_n_pstates     per-CPU count of populated rungs. 0 at
  //                         skeleton stage for every CPU (the walker
  //                         reply path is not yet wired); the follow-
  //                         up slice's pstate_poll fills these from
  //                         the walker's result_dword.
  //   _pstate_table         [u64; 192] — the flat 2 CPU × 16 rung
  //                         table. .bss-zeroed at image load via
  //                         `uninit @align(64)`.
  //   _pstate_cpu_uuid_buf  [u64; 2] — the CPU _OSC UUID (ACPI 6.5
  //                         §8.4.4.2) in LE-u64 pair form; seeded at
  //                         image load so osc_evaluate reads it as
  //                         two plain movs.
  //   _pstate_scratch_dwords [u8; 16] — 4 × u32 control-dword slots
  //                         passed to osc_evaluate as the control-
  //                         dwords buffer. .bss-zeroed; the probe
  //                         writes slot 0 with the encoded cpu_idx |
  //                         PROBE_MODE_BIT before each call.
  // ==========================================================================

  pub let mut _pstate_inited        : u64 = 0
  pub let mut _pstate_probe_ct      : u64 = 0
  pub let mut _pstate_set_ct        : u64 = 0
  pub let mut _pstate_last_handle   : u64 = 0

  pub let mut _pstate_n_pstates     : [u64; 2]   = uninit @align(16)
  pub let mut _pstate_table         : [u64; 192] = uninit @align(64)
  pub let mut _pstate_scratch_dwords : [u8; 16]  = uninit @align(16)

  // CPU _OSC UUID, byte layout per drivers/acpi/osc.pdx §A (ACPI 6.5
  // §8.4.4.2): 4077A616-290C-47BE-9EBD-D87058713953.
  //   uuid_lo = 0x47BE290C4077A616
  //   uuid_hi = 0x5339715870D8BD9E
  pub let mut _pstate_cpu_uuid_buf : [u64; 2] = [
    0x47BE290C4077A616,
    0x5339715870D8BD9E
  ]

  // ==========================================================================
  // §G  Fingerprint tags + keys
  //
  //   PSTATE PROBE cpu=<dec> n_pstates=<dec>
  //   PSTATE SET cpu=<dec> idx=<dec> freq=<dec>
  //
  // Single-line `pub let` string literals per the pdx-encoder-pitfalls
  // memory 2026-09-26. Each `[u8; N]` is exactly string_length + 1
  // (for the NUL): verified by hand.
  //
  //   "PSTATE PROBE\0" = 12 chars + NUL = 13
  //   "PSTATE SET\0"   = 10 chars + NUL = 11
  //   "cpu\0"          =  3 chars + NUL =  4
  //   "n_pstates\0"    =  9 chars + NUL = 10
  //   "idx\0"          =  3 chars + NUL =  4
  //   "freq\0"         =  4 chars + NUL =  5
  // ==========================================================================

  pub let pst_tag_probe   : [u8; 13] = "PSTATE PROBE\0"
  pub let pst_tag_set     : [u8; 11] = "PSTATE SET\0"
  pub let pst_k_cpu       : [u8; 4]  = "cpu\0"
  pub let pst_k_n_pstates : [u8; 10] = "n_pstates\0"
  pub let pst_k_idx       : [u8; 4]  = "idx\0"
  pub let pst_k_freq      : [u8; 5]  = "freq\0"

  // ==========================================================================
  // §H  pstate_probe(cpu_idx: u64) -> u64
  //
  // SKELETON: validate cpu_idx < 2, encode the CPU-idx probe control
  // dword into `_pstate_scratch_dwords`, call osc_evaluate with the
  // CPU _OSC UUID + the 1-dword buffer, record the returned handle,
  // leave _pstate_n_pstates[cpu_idx] at its initial zero (the walker
  // reply is not yet wired), emit PROBE fingerprint, return 0.
  //
  // Gates in order so an operator sees the first failure:
  //   (1) cpu_idx >= PST_N_CPUS_PROBED -> PSTATE_ERR_BAD_CPU_IDX
  //       Only cpu_idx=0 (P-core lead) and cpu_idx=1 (E-core lead)
  //       are covered by this skeleton's table dimensions; a wider
  //       follow-up slice may extend to 3 (LPE lead).
  //   (2) osc_evaluate returns an error code (any value >= 0xFFFFFD00)
  //       -> PSTATE_ERR_AML_NOT_READY. The OSC band spans 0xFFFFFDF5
  //       ..F9, and the general "not-ready" posture also sweeps up
  //       0xFFFFFD** future codes. The probe COUNTER is still bumped
  //       on this path (so a boot witness can see that the probe was
  //       attempted) but n_pstates stays at 0.
  //
  // Register plan: entry rsp%16==8. 3 callee-save pushes (rbx =
  // cpu_idx preserved, r12 = handle from osc_evaluate, r13 =
  // n_pstates = 0 for fingerprint) land rsp%16==0 for every nested
  // CALL. The klog_s1_d2 recipe at a 3-push site uses `sub rsp, 16`
  // (v2 slot at [rsp+0] + 8 B pad).
  //
  // Labels prefixed `pst_pb_`.
  // ==========================================================================

  pub let pstate_probe : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (cpu_idx: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: queue a _PSS/_PCT probe request onto the Wave 80 I1 _OSC walker request ring using the CPU _OSC UUID (4077A616-290C-47BE-9EBD-D87058713953) and a single control dword that carries the CPU idx + PROBE_MODE_BIT. Gates: (1) cpu_idx < PST_N_CPUS_PROBED (2 at this skeleton — P-lead 0, E-lead 1) -> else PSTATE_ERR_BAD_CPU_IDX; (2) osc_evaluate return in the 0xFFFFFD00+ error band -> PSTATE_ERR_AML_NOT_READY. The walker reply path is NOT wired at skeleton stage so _pstate_n_pstates[cpu_idx] stays at 0 and get_entry returns PSTATE_ERR_BAD_PSTATE_IDX for every rung — honest skeleton posture. _pstate_last_handle is captured on success for the follow-up slice's pstate_poll to key against. Row stride ×48 is unused on this probe path (probe operates on scalars + the OSC ring, not the pstate table); the pattern lives in get_entry below. Error-band compare uses `mov r11, 0xFFFFFD00; cmp rax, r11; jae ...` which covers OSC's 0xFFFFFDF5..F9 band plus any wider future refusal in the same 0xFFFFFD** half-page. 3-push callee-save prologue (rbx=cpu_idx, r12=handle, r13=n_pstates) lands rsp%16==0 for every nested CALL; klog_s1_d2 uses the sub-16 recipe (v2 at caller [rsp+0]). Labels prefixed `pst_pb_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rbx = cpu_idx (preserve)

        // --- (1) cpu_idx bounds.
        cmp rbx, 2;                          // PST_N_CPUS_PROBED
        jae pst_pb_bad_cpu;

        // --- Encode probe control dword into scratch[0]:
        //      low 7 bits = cpu_idx, bit 7 = PROBE_MODE_BIT.
        mov rax, rbx;
        and rax, 0x7F;                       // mask to low 7 bits (imm8-safe)
        or  rax, 0x80;                       // set PROBE_MODE_BIT (imm8-safe)
        lea r11, [rip + _pstate_scratch_dwords];
        mov [r11 + 0], eax;                  // write u32 at slot 0

        // --- Bump probe counter (one bump per attempt, incl. errors).
        mov rax, [rip + _pstate_probe_ct];
        add rax, 1;
        mov [rip + _pstate_probe_ct], rax;

        // --- Call osc_evaluate(uuid_ptr, cdwords_ptr, n_dwords=1).
        lea rdi, [rip + _pstate_cpu_uuid_buf];
        lea rsi, [rip + _pstate_scratch_dwords];
        mov rdx, 1;
        call osc_evaluate;

        // --- Error-band check: any value >= 0xFFFFFD00 means refusal.
        mov r11, 0xFFFFFD00;
        cmp rax, r11;
        jae pst_pb_aml_err;

        // --- Success: capture handle, flip inited latch.
        mov [rip + _pstate_last_handle], rax;
        mov r12, rax;                        // r12 = handle (unused today;
                                             //        parked for the
                                             //        follow-up poll slice)
        mov rax, 1;
        mov [rip + _pstate_inited], rax;

        // --- n_pstates stays 0 until the walker reply arrives.
        xor r13, r13;

        // --- Emit PROBE fingerprint: cpu=<dec> n_pstates=<dec>
        //      klog_s1_d2 signature (v2 on caller stack at [rsp+0]):
        //        rdi = level, rsi = subsys, rdx = tag,
        //        rcx = k1 (cpu), r8 = v1 (cpu dec),
        //        r9  = k2 (n_pstates), [rsp+0] = v2 (n_pstates dec)
        sub rsp, 16;
        mov [rsp + 0], r13;                  // v2 = n_pstates
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pst_tag_probe];
        lea rcx, [rip + pst_k_cpu];
        mov r8, rbx;                         // v1 = cpu_idx
        lea r9, [rip + pst_k_n_pstates];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                        // PSTATE_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_pb_aml_err:
        // Still emit the fingerprint with n_pstates=0 — the attempt
        // itself is useful log data.
        xor r13, r13;
        sub rsp, 16;
        mov [rsp + 0], r13;                  // v2 = 0
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pst_tag_probe];
        lea rcx, [rip + pst_k_cpu];
        mov r8, rbx;                         // v1 = cpu_idx
        lea r9, [rip + pst_k_n_pstates];
        call klog_s1_d2;
        add rsp, 16;

        mov rax, 0xFFFFFD11;                 // PSTATE_ERR_AML_NOT_READY
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_pb_bad_cpu:
        mov rax, 0xFFFFFD12;                 // PSTATE_ERR_BAD_CPU_IDX
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  pstate_get_count(cpu_idx: u64) -> u64
  //
  // Leaf getter for `_pstate_n_pstates[cpu_idx]`. Returns the count
  // of populated rungs for the CPU (0 at skeleton stage until the
  // walker reply arrives). Refuses with PSTATE_ERR_BAD_CPU_IDX for
  // cpu_idx >= 2. No fingerprint (leaf, called in loops by witnesses).
  //
  // SysV: rdi = cpu_idx. No callee-save pushes needed. Labels
  // prefixed `pst_gc_`.
  // ==========================================================================

  pub let pstate_get_count : (u64) -> u64 !{mem} @{} =
    fn (cpu_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: single-load getter for _pstate_n_pstates[cpu_idx]. cpu_idx >= 2 refuses with PSTATE_ERR_BAD_CPU_IDX (same shape as pstate_probe's gate 1). At skeleton stage every count is 0 since the walker reply path is not yet wired; a boot witness grepping for 'count==0 OR probe_count==0' sees the honest no-rung posture. Index stride ×8 via `shl rax, 3` (u64 stride, imm8-safe). Leaf; no callee-save pushes needed. Labels prefixed `pst_gc_`.",
      block: {
        // --- Bound check.
        cmp rdi, 2;                          // PST_N_CPUS_PROBED
        jae pst_gc_bad_cpu;

        // --- Load _pstate_n_pstates[cpu_idx] (u64 stride = 8).
        mov rax, rdi;
        shl rax, 3;                          // cpu_idx * 8 (bytes)
        lea r11, [rip + _pstate_n_pstates];
        add r11, rax;
        mov rax, [r11];
        ret;

      pst_gc_bad_cpu:
        mov rax, 0xFFFFFD12;                 // PSTATE_ERR_BAD_CPU_IDX
        ret
      }
    }

  // ==========================================================================
  // §J  pstate_get_entry(cpu_idx: u64, pstate_idx: u64, out_entry_ptr: u64) -> u64
  //
  // SKELETON: validate cpu_idx < 2 and pstate_idx < min(16,
  // _pstate_n_pstates[cpu_idx]), compute row base at
  // `_pstate_table + (cpu_idx * 16 + pstate_idx) * 48`, copy 48
  // bytes to *out_entry_ptr. Returns 0 on success,
  // PSTATE_ERR_BAD_CPU_IDX / PSTATE_ERR_BAD_PSTATE_IDX on refusal.
  //
  // The 48-byte copy is six aligned u64 moves (no `rep movsb`:
  // paideia-as encoder expects explicit movs for small fixed-size
  // copies). The pstate_idx bound check uses `_pstate_n_pstates
  // [cpu_idx]` (populated count), NOT the architectural 16, so a
  // caller asking for a rung that was not populated by the probe
  // gets PSTATE_ERR_BAD_PSTATE_IDX rather than a zero-filled row.
  //
  // Row base = &_pstate_table[(cpu_idx * 16 + pstate_idx) * 6]
  //          = &_pstate_table + flat_idx * 48
  //   where flat_idx = cpu_idx * 16 + pstate_idx (0..31).
  //
  // Compute: `rax = (cpu_idx << 4) + pstate_idx; r11 = 48;
  //          imul rax, r11` (reg-reg; the forbidden form is 2-op
  //          imul r, imm).
  //
  // Register plan: entry rsp%16==8. 3 callee-save pushes (rbx =
  // cpu_idx, r12 = pstate_idx, r13 = out_entry_ptr). No nested
  // CALLs — leaf after the pushes — so no extra pad for alignment.
  //
  // SysV: rdi = cpu_idx, rsi = pstate_idx, rdx = out_entry_ptr.
  // Labels prefixed `pst_ge_`.
  // ==========================================================================

  pub let pstate_get_entry : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (cpu_idx: u64, pstate_idx: u64, out_entry_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: 48-byte row copier for the (cpu_idx, pstate_idx) rung. Flat index = (cpu_idx << 4) + pstate_idx (0..31); row stride ×48 via `mov r11, 48; imul rax, r11` (reg-reg form, the only one the paideia-as encoder accepts). pstate_idx bound check uses `_pstate_n_pstates[cpu_idx]` (populated count), NOT the architectural 16, so a request for a rung that was not populated by the last probe gets PSTATE_ERR_BAD_PSTATE_IDX rather than a zero-filled row — this preserves the invariant 'all returned rows carry walker-written data' which the follow-up MSR-write slice will depend on when it computes transition targets. The 48-byte copy is six aligned 8-byte movs through rax (not `rep movsb` because the paideia-as encoder prefers explicit movs for small fixed-size copies, same posture as drivers/acpi/battery.pdx's _BIF row-copy). 3-push callee-save prologue (rbx=cpu_idx, r12=pstate_idx, r13=out_entry_ptr); no nested CALLs so no alignment pad after the pushes. Labels prefixed `pst_ge_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rbx = cpu_idx
        mov r12, rsi;                        // r12 = pstate_idx
        mov r13, rdx;                        // r13 = out_entry_ptr

        // --- Gate 1: cpu_idx < 2.
        cmp rbx, 2;                          // PST_N_CPUS_PROBED
        jae pst_ge_bad_cpu;

        // --- Gate 2: pstate_idx < _pstate_n_pstates[cpu_idx].
        mov rax, rbx;
        shl rax, 3;                          // cpu_idx * 8 (u64 stride)
        lea r11, [rip + _pstate_n_pstates];
        add r11, rax;
        mov rax, [r11];                      // rax = n_pstates for this CPU
        cmp r12, rax;
        jae pst_ge_bad_idx;

        // --- Compute flat index + row base pointer.
        mov rax, rbx;
        shl rax, 4;                          // cpu_idx * 16
        add rax, r12;                        // flat = cpu*16 + pstate_idx
        mov r11, 48;
        imul rax, r11;                       // flat * 48 (reg-reg form)
        lea r11, [rip + _pstate_table];
        add r11, rax;                        // r11 = row base

        // --- Copy 6 u64 (= 48 B) from row base to *out_entry_ptr.
        //      Explicit 8-byte movs through rax; no rep movsb.
        mov rax, [r11 + 0];
        mov [r13 + 0], rax;
        mov rax, [r11 + 8];
        mov [r13 + 8], rax;
        mov rax, [r11 + 16];
        mov [r13 + 16], rax;
        mov rax, [r11 + 24];
        mov [r13 + 24], rax;
        mov rax, [r11 + 32];
        mov [r13 + 32], rax;
        mov rax, [r11 + 40];
        mov [r13 + 40], rax;

        xor rax, rax;                        // PSTATE_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_ge_bad_cpu:
        mov rax, 0xFFFFFD12;                 // PSTATE_ERR_BAD_CPU_IDX
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_ge_bad_idx:
        mov rax, 0xFFFFFD13;                 // PSTATE_ERR_BAD_PSTATE_IDX
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  pstate_set(cpu_idx: u64, pstate_idx: u64) -> u64
  //
  // SKELETON: validate cpu_idx + pstate_idx (same gates as get_entry),
  // bump _pstate_set_ct, LOAD core_freq_mhz from the row's u64[0]
  // low 32 bits (for the fingerprint), emit SET fingerprint, return
  // PSTATE_ERR_TRANSITION_REFUSED. The real-body slice adds the
  // IA32_PERF_CTL WRMSR path through a KIND_MSR cap.
  //
  // At skeleton stage freq read is zero (walker reply not wired),
  // so the fingerprint always shows freq=0 — a boot witness that
  // asserts 'freq == 0' after a probe-less set-attempt confirms the
  // honest no-walker posture; the real-body posture flips freq to
  // the matched rung's MHz.
  //
  // Register plan: entry rsp%16==8. 3 callee-save pushes (rbx =
  // cpu_idx, r12 = pstate_idx, r13 = freq_mhz for fingerprint).
  // After 3 pushes rsp%16==0. For the klog_s1_d3 recipe (3 KVs
  // = 24 B of caller-stack args: v2 at [rsp+0], k3 at [rsp+8],
  // v3 at [rsp+16]) `sub rsp, 32` reserves 24 B + 8 B pad, keeping
  // rsp%16==0 at CALL per SysV.
  //
  // SysV: rdi = cpu_idx, rsi = pstate_idx. Labels prefixed `pst_st_`.
  // ==========================================================================

  pub let pstate_set : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (cpu_idx: u64, pstate_idx: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: validate (cpu_idx < 2, pstate_idx < _pstate_n_pstates[cpu_idx]), LOAD the row's u64[0] low 32 bits (= core_freq_mhz) for the fingerprint, EMIT the SET fingerprint via klog_s1_d3, RETURN PSTATE_ERR_TRANSITION_REFUSED (0xFFFFFD15). The actual WRMSR to IA32_PERF_CTL (0x199) is DEFERRED to a follow-up slice that adds a KIND_MSR cap gate; a skeleton-stage set with a raw `wrmsr` would bypass the capability discipline and race the ring-0 MSR state against the Phase-6 CPU-driver's own init path. _pstate_set_ct is bumped on every args-valid call (including the TRANSITION_REFUSED path) so a boot witness can distinguish 'set never attempted' from 'set attempted but refused'. 3-push callee-save prologue (rbx=cpu_idx, r12=pstate_idx, r13=freq); the klog_s1_d3 recipe at a 3-push site uses `sub rsp, 32` to reserve 24 B args + 8 B pad, keeping rsp%16==0 at the klog CALL. The pdx-encoder-pitfalls memory 2026-09-26 names the 3-push + 16-pad recipe for klog_s1_d2 (2 KVs); 3 KVs need 8 more bytes of stack args, so pad up to 32. Labels prefixed `pst_st_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rbx = cpu_idx
        mov r12, rsi;                        // r12 = pstate_idx

        // --- Gate 1: cpu_idx < 2.
        cmp rbx, 2;                          // PST_N_CPUS_PROBED
        jae pst_st_bad_cpu;

        // --- Gate 2: pstate_idx < _pstate_n_pstates[cpu_idx].
        mov rax, rbx;
        shl rax, 3;                          // cpu * 8 (u64 stride)
        lea r11, [rip + _pstate_n_pstates];
        add r11, rax;
        mov rax, [r11];                      // rax = n_pstates for this CPU
        cmp r12, rax;
        jae pst_st_bad_idx;

        // --- Bump set counter (one bump per args-valid call).
        mov rax, [rip + _pstate_set_ct];
        add rax, 1;
        mov [rip + _pstate_set_ct], rax;

        // --- Load freq_mhz from row's u64[0] low 32 bits.
        mov rax, rbx;
        shl rax, 4;                          // cpu * 16
        add rax, r12;                        // flat_idx = cpu*16 + pstate_idx
        mov r11, 48;
        imul rax, r11;                       // flat * 48 (reg-reg form)
        lea r11, [rip + _pstate_table];
        add r11, rax;                        // r11 = row base
        mov eax, [r11 + 0];                  // 32-bit load zero-extends
        mov r13, rax;                        // r13 = freq_mhz for fingerprint

        // --- Emit SET fingerprint: cpu=<dec> idx=<dec> freq=<dec>
        //      klog_s1_d3 signature (3 KVs; caller stack carries 3 words):
        //        rdi = level, rsi = subsys, rdx = tag,
        //        rcx = k1 (cpu), r8 = v1 (cpu dec), r9 = k2 (idx),
        //        [rsp+0] = v2 (idx dec), [rsp+8] = k3 (freq),
        //        [rsp+16] = v3 (freq dec)
        sub rsp, 32;                         // 24 B args + 8 B pad; rsp%16==0
        mov [rsp + 0],  r12;                 // v2 = pstate_idx
        lea rax, [rip + pst_k_freq];
        mov [rsp + 8],  rax;                 // k3 = "freq"
        mov [rsp + 16], r13;                 // v3 = freq_mhz
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + pst_tag_set];
        lea rcx, [rip + pst_k_cpu];
        mov r8, rbx;                         // v1 = cpu_idx
        lea r9, [rip + pst_k_idx];
        call klog_s1_d3;
        add rsp, 32;

        mov rax, 0xFFFFFD15;                 // PSTATE_ERR_TRANSITION_REFUSED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_st_bad_cpu:
        mov rax, 0xFFFFFD12;                 // PSTATE_ERR_BAD_CPU_IDX
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_st_bad_idx:
        mov rax, 0xFFFFFD13;                 // PSTATE_ERR_BAD_PSTATE_IDX
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  cap_handler_pstate(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch stub the KIND_PSTATE (0x54) arm in cap/invoke.pdx calls.
  // Routes by op_arg's low byte, unpacking additional arguments from
  // the higher bytes:
  //
  //   op == PSTATE_OP_PROBE     (1) -> pstate_probe((op_arg >> 8) & 0xFF)
  //                                      cpu_idx in bits 8..15
  //   op == PSTATE_OP_GET_COUNT (2) -> pstate_get_count((op_arg >> 8) & 0xFF)
  //                                      cpu_idx in bits 8..15
  //   op == PSTATE_OP_GET_ENTRY (3) -> INVOKE_UNSUPPORTED at skeleton
  //                                      (out_ptr does not fit in
  //                                      op_arg's remaining 56 bits;
  //                                      follow-up slice adds a
  //                                      KIND_PSTATE_READ cap whose
  //                                      row carries the pointer —
  //                                      same posture as drivers/
  //                                      acpi/osc.pdx OSC_OP_EVAL)
  //   op == PSTATE_OP_SET       (4) -> pstate_set((op_arg >> 8) & 0xFF,
  //                                               (op_arg >> 16) & 0xFF)
  //                                      cpu_idx in bits 8..15,
  //                                      pstate_idx in bits 16..23
  //   otherwise                     -> INVOKE_UNSUPPORTED
  //
  // Rights and target_ptr are IGNORED at skeleton stage; the follow-
  // up slice may add a rights gate (R_PSTATE_READ / R_PSTATE_SET)
  // once KIND_PSTATE is minted against a specific principal.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg. Register
  // plan: 3-push callee-save prologue (rbx = op_arg preserved,
  // r12 = op code, r13 scratch); entry rsp%16==8, after 3 pushes
  // rsp%16==0. Labels prefixed `pst_h_`.
  // ==========================================================================

  pub let cap_handler_pstate : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: cap-table dispatch stub for KIND_PSTATE (0x54). The cmp-chain over {1..4} is one branch per legal op (not a jump table) because four live values occupy less bytecode as a chain, same posture as drivers/acpi/ec_quirks.pdx cap_handler_ec_quirks. Op in op_arg's low byte; op=1,2 unpack cpu_idx from bits 8..15; op=4 unpacks cpu_idx (bits 8..15) + pstate_idx (bits 16..23). Op is masked to the low byte via `and r12, 0xFF` on entry (imm8-safe) so a caller leaving garbage in op_arg's high bytes does not accidentally match. GET_ENTRY (op=3) refuses with INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC), NOT a PSTATE_ERR_* code — the latter names a pstate-plumbing bug, INVOKE_UNSUPPORTED names a cap-dispatch bug (follow-up KIND_PSTATE_READ cap will carry the out_ptr arg in its row). Rights and target_ptr are ACCEPTED but IGNORED at skeleton stage. 3-push prologue aligns rsp%16==0 for every nested CALL. Labels prefixed `pst_h_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdx;                        // rbx = op_arg (preserve)
        mov r12, rdx;                        // r12 = op code
        and r12, 0xFF;                       // mask to low byte (imm8-safe)

        // --- Opcode dispatch.
        cmp r12, 1;                          // PSTATE_OP_PROBE
        je  pst_h_probe;
        cmp r12, 2;                          // PSTATE_OP_GET_COUNT
        je  pst_h_count;
        cmp r12, 3;                          // PSTATE_OP_GET_ENTRY
        je  pst_h_entry;
        cmp r12, 4;                          // PSTATE_OP_SET
        je  pst_h_set;

        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_h_probe:
        mov rdi, rbx;
        shr rdi, 8;                          // cpu_idx = (op_arg >> 8)
        and rdi, 0xFF;                       // mask to byte (imm8-safe)
        call pstate_probe;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_h_count:
        mov rdi, rbx;
        shr rdi, 8;                          // cpu_idx = (op_arg >> 8)
        and rdi, 0xFF;
        call pstate_get_count;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_h_entry:
        // Three args (cpu_idx + pstate_idx + out_ptr) don't fit in
        // 56 bits; follow-up slice adds a dedicated KIND_PSTATE_READ.
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pst_h_set:
        mov rdi, rbx;
        shr rdi, 8;                          // cpu_idx = (op_arg >> 8)
        and rdi, 0xFF;
        mov rsi, rbx;
        shr rsi, 16;                         // pstate_idx = (op_arg >> 16)
        and rsi, 0xFF;
        call pstate_set;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  Stat getters — single-load leaves for witness callers
  //
  // Parallel to drivers/acpi/ec.pdx / drivers/acpi/osc.pdx / drivers/
  // acpi/ec_quirks.pdx getter sets. A boot witness can assert
  //
  //   pstate_inited()        == 1
  //   AND pstate_probe_count() >= 1
  //   AND pstate_last_handle() == 0 OR == some_small_counter
  //
  // after a smoke run that drives cap_handler_pstate with op=1,
  // cpu_idx=0. The last-handle slot is zero at cold boot (ring not
  // yet queued); after one successful osc_evaluate it holds the
  // handle for the follow-up pstate_poll slice to key against.
  // ==========================================================================

  pub let pstate_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: single-load getter for _pstate_inited. Non-zero after the first successful pstate_probe (even AML_NOT_READY leaves the latch cleared because that outcome records no handle; only an osc_evaluate-success path flips it). Leaf.",
      block: { mov rax, [rip + _pstate_inited]; ret }
    }

  pub let pstate_probe_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: single-load getter for _pstate_probe_ct. Bumped once per pstate_probe call that reaches the osc_evaluate seam (both success and AML_NOT_READY outcomes); the BAD_CPU_IDX gate 1 refuses before the bump, so a caller flooding with bad cpu_idx values does not inflate this counter. Leaf.",
      block: { mov rax, [rip + _pstate_probe_ct]; ret }
    }

  pub let pstate_set_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: single-load getter for _pstate_set_ct. Bumped once per pstate_set call that passes BOTH arg gates (cpu_idx + pstate_idx); the TRANSITION_REFUSED outcome still bumps because the attempt reached the (future) MSR write path. Leaf.",
      block: { mov rax, [rip + _pstate_set_ct]; ret }
    }

  pub let pstate_last_handle : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2559 (Wave 81 I2) skeleton: single-load getter for _pstate_last_handle. The osc_evaluate handle from the most recent successful probe (zero before first probe). The follow-up pstate_poll slice will consume this handle through osc_poll to retrieve the walker's _PSS/_PCT reply. Leaf.",
      block: { mov rax, [rip + _pstate_last_handle]; ret }
    }
}
