// src/kernel/core/drivers/acpi/osc.pdx — Wave 80 I1 [R30] (paideia-os#2558)
//
// _OSC (Operating System Capabilities) evaluation plumbing — the
// KERNEL-SIDE interface the firmware-bytecode walker in the user-space
// bubble consumes.  _OSC is the AML method the firmware queries at boot
// to negotiate feature ownership: who owns the PCIe hotplug controller,
// who owns thermal management, who owns P-state transitions, and the
// rest of the control-dword lattice ACPI 6.5 §6.2.11 defines.  The
// kernel does NOT run AML (design/acpi/no-aml-in-kernel.md, firewall
// tools/lint-no-kernel-aml.sh): all it does here is QUEUE requests to
// a scratch ring and hand out a request_handle; the user-space walker
// (D5 Wave 71, src/user/aml/aml_walker.pdx) reads the ring, evaluates
// the method, writes the result dword back into the same row, and the
// kernel-side `osc_poll` entrypoint hands that result dword to the
// caller.
//
// -----------------------------------------------------------------------------
// §0  WHY THIS FILE IS KERNEL-SIDE
// -----------------------------------------------------------------------------
//
// _OSC's result (ownership-granted bitmask) steers KERNEL decisions:
// whether this OS owns the PCIe hotplug controller determines whether
// the KIND_PCIE_HP_EVT handler fires on a port-up interrupt or defers
// to firmware; whether this OS owns thermal determines whether
// KIND_THERMAL_ZONE_DRV polls or lets the EC run its own fan curve.
// Those decisions happen in ring 0, so the ring-0 request-reply plumbing
// must live in the kernel even though the AML evaluation itself does
// not.  The three well-known UUIDs each cover a different root scope
// (CPU, PCI, platform-wide) and the kernel consumes all three.
//
// A single evaluation step is:
//
//   1.  Kernel caller (early boot — paideia-os's own `init` task, or
//       a driver's probe path) calls `osc_evaluate(uuid_ptr,
//       control_dwords_ptr, n_dwords)`.
//   2.  This file writes {uuid_lo, uuid_hi, control_dwords_ptr,
//       n_dwords, status=OSC_RING_STATUS_PENDING, timestamp} into
//       the next free row of a 8-row 48-byte-per-row scratch ring,
//       returns the row's handle.
//   3.  The user-space walker (polled by its scheduler every few ms)
//       scans the ring, picks up every row whose status == PENDING,
//       evaluates `_SB.PCI0._OSC(uuid, revision=1, count=n_dwords,
//       buffer=control_dwords)` or equivalent, writes the resulting
//       first dword (ownership-granted bits) into row.result_dword,
//       and flips row.status to OSC_RING_STATUS_READY.
//   4.  Kernel caller polls `osc_poll(handle, out_result_ptr)` until
//       it returns OSC_OK; the granted dword lands at *out_result_ptr.
//
// This file does ONLY step 2 and 4 (and the fast-path platform-feature
// query that short-circuits well-known features without going through
// the walker at all).  The actual walker call is OUT OF SCOPE for this
// wave; the ring is the whole seam.  A review that walks this skeleton
// and nothing else observes that no AML opcode name, no DSDT/SSDT
// identifier, and no acpica function appears in-file (comments explain
// the user-space side but are stripped by the firewall's sed pass).
//
// -----------------------------------------------------------------------------
// §1  WELL-KNOWN _OSC UUIDs (ACPI 6.5 §6.2.11, §6.2.11.2, §8.4.4.2)
// -----------------------------------------------------------------------------
//
// Each UUID is a 16-byte EFI_GUID little-endian encoding; the kernel
// stores the first 8 bytes as `uuid_lo` and the second 8 bytes as
// `uuid_hi` (little-endian u64 reads).  The three live constants:
//
//   PCIe root _OSC   33DB4D5B-1FF7-401C-9657-7441C03DD766
//                    byte layout:
//                      [33 DB 4D 5B] [1F F7] [40 1C] [96 57 74 41 C0 3D D7 66]
//                                     (last two groups are byte-sequences,
//                                      first three are LE-encoded in memory)
//                    uuid_lo = 0x1C40F71F5B4DDB33
//                    uuid_hi = 0x66D73DC041745796
//                    control-dword bits (first dword, ACPI 6.5 §6.2.11.3):
//                      bit0  SHPC Native Hot Plug control
//                      bit1  Native PCIe Hot Plug control
//                      bit2  PME control
//                      bit3  AER control
//                      bit4  PCIe Capability Structure control
//                      bit5  Latency Tolerance Reporting (LTR)
//                      bit6  Downstream Port Containment (DPC)
//                      bit7  Compute-Express-Link (CXL) extended
//                      bit8  System Firmware Intermediary (SFI)
//                      bits 9..31 reserved — must be zero
//
//   CPU _OSC         4077A616-290C-47BE-9EBD-D87058713953
//                    byte layout:
//                      [16 A6 77 40] [0C 29] [BE 47] [9E BD D8 70 58 71 39 53]
//                    uuid_lo = 0x47BE290C4077A616
//                    uuid_hi = 0x5339715870D8BD9E
//                    control-dword bits (first dword, ACPI 6.5 §8.4.4.2):
//                      bit0  Processor P-state control
//                      bit1  Processor C-state control (C1/C2/C3)
//                      bit2  Processor T-state control
//                      bit3  Independent OSPM-coordinated C-states
//                      bit4  Hardware duty-cycling (HDC)
//                      bit5  Collaborative Processor Performance Control (CPPC)
//                      bit6  CPPC v2
//                      bit7  Processor Dynamic Load Balancing (PDLB)
//                      bits 8..31 reserved
//
//   Platform-wide    0811B06E-4A27-44F9-8D60-3CBBC22E7B48
//                    byte layout:
//                      [6E B0 11 08] [27 4A] [F9 44] [8D 60 3C BB C2 2E 7B 48]
//                    uuid_lo = 0x44F94A270811B06E
//                    uuid_hi = 0x487B2EC2BB3C608D
//                    control-dword bits (first dword, ACPI 6.5 §6.2.11.2):
//                      bit0  Platform Communications Channel (PCC)
//                      bit1  Insertion/removal notifications (SMI-free)
//                      bit2  OSC capabilities notifications
//                      bit3  Diagnostic logging (CPER-via-ACPI)
//                      bit4  Generic Event Device (GED)
//                      bit5  _CPC (collaborative processor cap)
//                      bits 6..31 reserved
//
// The skeleton stores these as constants (`OSC_UUID_PCIE_LO/HI`,
// `OSC_UUID_CPU_LO/HI`, `OSC_UUID_PLATFORM_LO/HI`) and the fast-path
// `osc_platform_feature_query` consults them when short-circuiting a
// well-known feature.  A caller passing an arbitrary UUID through
// `osc_evaluate` does not need to match any of these three; the ring
// takes the uuid_lo/uuid_hi verbatim and the walker interprets them.
//
// -----------------------------------------------------------------------------
// §2  REQUEST-RING PROTOCOL (shared memory, kernel-writer, user-reader)
// -----------------------------------------------------------------------------
//
// 8-row ring, 48 bytes per row = 384 bytes total.  Row layout:
//
//   offset  size  field
//   ------  ----  --------------------------------------------------------
//   +0      8     request_handle         u64, == row's absolute index since boot
//   +8      8     uuid_lo                u64, LE bytes 0..7 of the 16-byte UUID
//   +16     8     uuid_hi                u64, LE bytes 8..15
//   +24     8     control_dwords_ptr     u64, caller's buffer (walker reads this)
//   +32     4     n_dwords               u32, 1..OSC_N_DWORDS_MAX
//   +36     4     result_dword           u32, walker writes the granted bitmask here
//   +40     4     status                 u32, one of OSC_RING_STATUS_*
//   +44     4     timestamp              u32, kernel-side TSC-low snapshot at queue
//
// Row-size derivation: 4 × u64 (32 B) + 4 × u32 (16 B) = 48 B.  The
// 32/16 split is deliberate: the four pointer-sized fields are the
// request HEADER (what the walker needs to find the AML scope); the
// four 32-bit fields are the TAIL (what the kernel and walker use for
// book-keeping and reply).  Any widening (e.g. result_dword to u64)
// would exceed the one-row size the direct-map 384-byte scratch area
// in the shared ring page can accommodate for 8 slots.
//
// Status encoding (same byte in the row at +40):
//   OSC_RING_STATUS_FREE    0  — row is uninitialised or recycled
//   OSC_RING_STATUS_PENDING 1  — kernel wrote the request, walker not yet seen
//   OSC_RING_STATUS_READY   2  — walker wrote the result, kernel may read
//   OSC_RING_STATUS_ERROR   3  — walker refused (AML scope absent / bad buffer)
//
// Index arithmetic.  The ring is a WRAP-AROUND write-side ring: the
// writer (`osc_evaluate`) advances `_osc_request_counter` on every
// request and uses `(counter & 7)` as the slot index.  Handles are
// absolute (counter at write-time), so handle 0x100 lives in slot
// (0x100 & 7) == 0 while handle 0x108 lives in slot (0x108 & 7) == 0
// too — the row has been RECYCLED.  `osc_poll` detects this by
// comparing the handle against the row's recorded request_handle: a
// mismatch means the handle has expired (OSC_ERR_HANDLE_EXPIRED).
// 8 rows is enough for one pending request per well-known UUID + a
// few platform-feature probes; a system that outruns 8 pending OSC
// evaluations has a bigger problem than ring-slot shortage.
//
// Memory ordering.  The walker runs in ring 3 and the kernel in ring
// 0; they share this ring via a user-space mapping of the same page.
// On x86-64 TSO guarantees that writes to row.result_dword retire
// before writes to row.status in program order — so a reader seeing
// status==READY sees a consistent result_dword without an explicit
// fence.  The real-body follow-up slice may add MFENCE for defence in
// depth, but the skeleton's status-write-last discipline is already
// sufficient on x86-64 (ACPI 6.5 §12.11.2 mandates TSO-equivalent
// ordering for shared OpRegion rings).
//
// -----------------------------------------------------------------------------
// §3  RETURN CODES — band 0xFFFFFDF5..0xFFFFFDF9
// -----------------------------------------------------------------------------
//
// Reserved by paideia-os#2558 for the _OSC seam.  Disjoint from
//   EC_ERR_*          (0xFFFFFFC5..0xFFFFFFCA, ec.pdx)
//   EC_ACCESS_*       (0xFFFFFDC4..0xFFFFFDCF, ec_access.pdx)
//   TPM_ERR_*         (0xFFFFFD51..0xFFFFFD57, tpm_crb.pdx)
//   GPIO/LPSS/DW_IO/LPG bands.
//
//   0xFFFFFDF5  OSC_ERR_BAD_UUID        — uuid_ptr is NULL or not 16-byte
//                                         aligned; a legal UUID buffer is
//                                         always aligned on a u64 boundary
//                                         so the uuid_lo/uuid_hi reads are
//                                         plain movs
//   0xFFFFFDF6  OSC_ERR_NDWORDS_OOB     — n_dwords is 0 or > OSC_N_DWORDS_MAX;
//                                         a legal control-dword buffer is
//                                         1..4 u32s (ACPI 6.5 §6.2.11.3
//                                         defines two dwords for the PCIe
//                                         root; CPU and platform define one;
//                                         a future ACPI revision could
//                                         extend, so OSC_N_DWORDS_MAX = 4
//                                         covers today's spec plus two slots
//                                         of headroom)
//   0xFFFFFDF7  OSC_ERR_HANDLE_EXPIRED  — the handle refers to a ring slot
//                                         whose request_handle field no
//                                         longer matches (slot was
//                                         recycled); callers that cannot
//                                         service a request in 8 queue
//                                         slots have failed by design
//   0xFFFFFDF8  OSC_ERR_FEATURE_UNKNOWN — osc_platform_feature_query called
//                                         with a feature code outside
//                                         {OSC_FEATURE_PCIE_HOTPLUG..LID};
//                                         names a cap-dispatch bug, not a
//                                         hardware condition
//   0xFFFFFDF9  OSC_ERR_WALKER_NOT_READY — _osc_walker_ready == 0; the
//                                         user-space component that
//                                         services the ring has not
//                                         registered itself yet (the
//                                         follow-up slice adds a
//                                         registration syscall; the
//                                         skeleton treats the flag as
//                                         sticky-false)
//
// All five codes sit in a 5-wide subband inside the 0xFFFFFD block that
// tpm_crb.pdx also uses (0xFFFFFD51..0xFFFFFD57) but is numerically
// disjoint from it, so a reviewer debugging a cross-driver log can tell
// the two apart by inspection.
//
// -----------------------------------------------------------------------------
// §4  invoke.pdx — KIND_OSC @ 0x50
// -----------------------------------------------------------------------------
//
// Reserves one new capability KIND tag at 0x50 (= 80 decimal).  Audit
// at landing time: `grep -nE 'cmp rcx, 0x50\b' src/kernel/core/cap/
// invoke.pdx` returned ZERO existing dispatch arms; `grep -nE 'cmp rcx,
// 0x4F\b'` is also empty, leaving 0x4F free for the next parallel-wave
// landing at coordinator discretion.  Natural neighbor of the Wave 59
// I9 KIND_TPM_CRB (0x4E) arm immediately above — both are driver-layer
// caps that mediate access to firmware-side state (TPM CRB window;
// _OSC request ring).  Fits imm32 bit 31 clear (sign-extend-safe);
// direct `cmp rcx, 0x50` form, no r9 staging.
//
// cap_handler_osc(rights, target_ptr, op_arg) routes op_arg's low byte:
//   op == OSC_OP_EVAL          (1) -> osc_evaluate(args unpacked from row)
//   op == OSC_OP_POLL          (2) -> osc_poll(args from row)
//   op == OSC_OP_FEATURE_QUERY (3) -> osc_platform_feature_query(feature)
//   otherwise                      -> INVOKE_UNSUPPORTED
//
// EVAL and POLL cannot be dispatched purely through op_arg at skeleton
// stage (three/two pointer args do not fit in 56 bits); they return
// INVOKE_UNSUPPORTED, same posture as tpm_crb.pdx's TPM_OP_SUBMIT.
// The follow-up slice adds a dedicated KIND_OSC_SUBMIT cap whose row
// carries the pointer args.  FEATURE_QUERY fits in 56 bits (feature
// code is a small integer) and dispatches directly.
//
// -----------------------------------------------------------------------------
// §5  FINGERPRINTS
// -----------------------------------------------------------------------------
//
// tests/fingerprints/osc.golden carries one line per entrypoint:
//
//   OSC EVAL uuid_lo=0x<16-hex> uuid_hi=0x<16-hex>
//   OSC POLL handle=0x<16-hex> granted=0x<8-hex>
//   OSC FEATURE kind=<dec> status=<dec>
//
// Emitted via klog_s1_x2 (EVAL, POLL) and klog_s1_d2 (FEATURE).  Both
// values on the POLL line are hex though the granted bitmask is a
// u32-wide dword — klog's hex formatter prints the natural value width,
// so a <8-hex> result lands verbatim.
//
// -----------------------------------------------------------------------------
// §6  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   No `test rN, rN` — zero-equality uses `cmp rN, 0`.
//   No `and r11, imm64` — every mask here fits in imm32 (the ring
//                           modulo mask is `and rN, 7`).
//   No two-operand `imul r, imm` — ring-offset multiply uses two
//                                    shifts + add (48 = 32 + 16 =
//                                    `(idx<<5) + (idx<<4)`).
//   Single-line `pub let x = "..."` — every tag below is one line.
//   Module basename match — `osc.pdx` → `module Osc`.
//   Reserved labels — every label in this file is prefixed with the
//                      function's 4-letter tag (`osci_` / `osce_` /
//                      `oscp_` / `oscf_` / `osch_`), never `loop`/
//                      `if`/`let`.
//   AML firewall — no AML/DSDT/SSDT/acpica identifier appears in-file;
//                   comments mention the user-space walker but the
//                   firewall's sed pass strips every `//` comment
//                   before scanning.
//
// =============================================================================

module Osc = structure {

  // ==========================================================================
  // §A  Well-known _OSC UUIDs (ACPI 6.5 §6.2.11, §6.2.11.2, §8.4.4.2)
  //
  // Published as (uuid_lo, uuid_hi) u64 pairs because the kernel reads
  // caller-supplied UUIDs via two plain `mov rax, [uuid_ptr]` /
  // `mov rax, [uuid_ptr+8]` instructions, so matching against a well-
  // known UUID is two 64-bit compares with no byte-swab.  See file
  // header §1 for the byte-layout derivation.
  // ==========================================================================

  pub let OSC_UUID_PCIE_LO     : u64 = 0x1C40F71F5B4DDB33
  pub let OSC_UUID_PCIE_HI     : u64 = 0x66D73DC041745796
  pub let OSC_UUID_CPU_LO      : u64 = 0x47BE290C4077A616
  pub let OSC_UUID_CPU_HI      : u64 = 0x5339715870D8BD9E
  pub let OSC_UUID_PLATFORM_LO : u64 = 0x44F94A270811B06E
  pub let OSC_UUID_PLATFORM_HI : u64 = 0x487B2EC2BB3C608D

  // ==========================================================================
  // §B  Control-dword limits
  //
  // Per the file-header per-UUID bit tables.  The ACPI 6.5 spec today
  // defines at most 2 control dwords for any single _OSC call (PCIe
  // root scope), so 4 covers today's spec plus two slots of headroom
  // for a future revision.  n_dwords==0 is a programmer error (an
  // _OSC call with zero control dwords conveys nothing).
  // ==========================================================================

  pub let OSC_N_DWORDS_MAX : u64 = 4
  pub let OSC_N_DWORDS_MIN : u64 = 1

  // ==========================================================================
  // §C  Fast-path platform-feature codes (osc_platform_feature_query)
  //
  // Short-circuits for well-known features that the kernel repeatedly
  // asks about during bring-up.  The follow-up slice may wire these
  // through to a cached result from an earlier walker-mediated
  // evaluation; at skeleton stage the fast-path returns 0 (feature
  // "not granted" is the honest default until the walker has run).
  // ==========================================================================

  pub let OSC_FEATURE_PCIE_HOTPLUG : u64 = 0
  pub let OSC_FEATURE_THERMAL      : u64 = 1
  pub let OSC_FEATURE_PSTATE       : u64 = 2
  pub let OSC_FEATURE_POWER_BUTTON : u64 = 3
  pub let OSC_FEATURE_SLEEP_BUTTON : u64 = 4
  pub let OSC_FEATURE_LID_SWITCH   : u64 = 5

  pub let OSC_FEATURE_MAX : u64 = 5

  // ==========================================================================
  // §D  Request-ring sizing + status encoding (see file-header §2)
  // ==========================================================================

  pub let OSC_RING_ROWS       : u64 = 8
  pub let OSC_RING_ROW_BYTES  : u64 = 48
  pub let OSC_RING_TOTAL      : u64 = 384             // 8 × 48
  pub let OSC_RING_INDEX_MASK : u64 = 7               // 8 rows

  // Row-field offsets.
  pub let OSC_ROW_OFF_HANDLE     : u64 = 0
  pub let OSC_ROW_OFF_UUID_LO    : u64 = 8
  pub let OSC_ROW_OFF_UUID_HI    : u64 = 16
  pub let OSC_ROW_OFF_CDWORDS    : u64 = 24
  pub let OSC_ROW_OFF_NDWORDS    : u64 = 32           // u32
  pub let OSC_ROW_OFF_RESULT     : u64 = 36           // u32
  pub let OSC_ROW_OFF_STATUS     : u64 = 40           // u32
  pub let OSC_ROW_OFF_TIMESTAMP  : u64 = 44           // u32

  // Status encoding.
  pub let OSC_RING_STATUS_FREE    : u64 = 0
  pub let OSC_RING_STATUS_PENDING : u64 = 1
  pub let OSC_RING_STATUS_READY   : u64 = 2
  pub let OSC_RING_STATUS_ERROR   : u64 = 3

  // ==========================================================================
  // §E  cap_handler_osc op-codes
  // ==========================================================================

  pub let OSC_OP_EVAL          : u64 = 1
  pub let OSC_OP_POLL          : u64 = 2
  pub let OSC_OP_FEATURE_QUERY : u64 = 3

  // ==========================================================================
  // §F  Return codes — band 0xFFFFFDF5..0xFFFFFDF9
  //
  // See file header §3 for the band-disjointness argument.
  // ==========================================================================

  pub let OSC_OK                     : u64 = 0
  pub let OSC_ERR_BAD_UUID           : u64 = 0xFFFFFDF5
  pub let OSC_ERR_NDWORDS_OOB        : u64 = 0xFFFFFDF6
  pub let OSC_ERR_HANDLE_EXPIRED     : u64 = 0xFFFFFDF7
  pub let OSC_ERR_FEATURE_UNKNOWN    : u64 = 0xFFFFFDF8
  pub let OSC_ERR_WALKER_NOT_READY   : u64 = 0xFFFFFDF9

  // ==========================================================================
  // §G  Mutable state — one request ring per machine
  //
  // _osc_ring is the 384-byte scratch area (see file-header §2 for the
  // row layout).  _osc_request_counter is monotonically increasing;
  // its low 3 bits name the ring slot, its full value is the handle a
  // caller holds across the walker's reply.  _osc_walker_ready is a
  // sticky-false flag the follow-up slice lifts to 1 once the user-
  // space walker has registered itself through a dedicated syscall.
  // ==========================================================================

  pub let mut _osc_ring              : [u8; 384] = uninit @align(64)
  pub let mut _osc_request_counter   : u64 = 0
  pub let mut _osc_walker_ready      : u64 = 0
  pub let mut _osc_inited            : u64 = 0

  // Counters.
  pub let mut _osc_evaluate_ct       : u64 = 0
  pub let mut _osc_poll_ct           : u64 = 0
  pub let mut _osc_feature_ct        : u64 = 0
  pub let mut _osc_refused_ct        : u64 = 0

  // Last-request scratch (used by the fingerprint emission path so the
  // actual klog_s1_x2 call reads a stable snapshot rather than re-
  // dereferencing _osc_ring during the format).
  pub let mut _osc_last_uuid_lo      : u64 = 0
  pub let mut _osc_last_uuid_hi      : u64 = 0
  pub let mut _osc_last_handle       : u64 = 0
  pub let mut _osc_last_granted      : u64 = 0
  pub let mut _osc_last_feature      : u64 = 0
  pub let mut _osc_last_feature_sts  : u64 = 0

  // ==========================================================================
  // §H  Fingerprint tags + keys
  //
  //   OSC EVAL uuid_lo=0x<16-hex> uuid_hi=0x<16-hex>
  //   OSC POLL handle=0x<16-hex> granted=0x<8-hex>
  //   OSC FEATURE kind=<dec> status=<dec>
  //
  // Single-line `pub let x = "..."` only.  Array sizes = len(string) + 1
  // (for the trailing NUL), per the pdx-encoder-pitfalls memory
  // 2026-09-26.
  // ==========================================================================

  pub let osc_tag_eval    : [u8; 9]  = "OSC EVAL\0"
  pub let osc_tag_poll    : [u8; 9]  = "OSC POLL\0"
  pub let osc_tag_feature : [u8; 12] = "OSC FEATURE\0"

  pub let osc_k_uuid_lo : [u8; 8] = "uuid_lo\0"
  pub let osc_k_uuid_hi : [u8; 8] = "uuid_hi\0"
  pub let osc_k_handle  : [u8; 7] = "handle\0"
  pub let osc_k_granted : [u8; 8] = "granted\0"
  pub let osc_k_kind    : [u8; 5] = "kind\0"
  pub let osc_k_status  : [u8; 7] = "status\0"

  // ==========================================================================
  // §I  osc_init() -> u64
  //
  // Zero every stat slot, zero the counter + last-request scratch,
  // leave _osc_walker_ready at 0 (sticky-false until the follow-up
  // registration slice lands), flip _osc_inited to 1, return OSC_OK.
  //
  // The 384-byte ring itself is NOT zeroed in the skeleton: an
  // uninit'd row has status==0 (FREE) under the `uninit @align(64)`
  // directive which lands the storage in .bss and zeroes it at image
  // load.  A re-init call needs no explicit sweep because the counter
  // is reset and the walker-ready flag drops to 0 — any stale row the
  // ring held is unreachable through handle validation.
  //
  // No arguments.  Leaf.  Zero callee-save pushes needed.  Labels
  // prefixed `osci_`.
  // ==========================================================================

  pub let osc_init : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2558 (Wave 80 I1) skeleton: zero every mutable scalar, flip _osc_inited to 1, return OSC_OK.  The 384-byte ring is .bss-zeroed at image load so an uninit'd row reads status==FREE naturally; a re-init call drops _osc_request_counter back to 0 which recycles every slot handle at once (the next osc_evaluate's handle starts at 0 again, so any stale handle a client held cannot match any row's current request_handle field).  Walker-ready flag stays at 0 across init: the registration syscall is a FOLLOW-UP concern, and a skeleton call that silently flipped the flag would mislead a boot witness into believing an evaluator is attached.  Store sequence writes 10 u64 slots via one `xor rax, rax` + 10 plain movs; _osc_inited is set LAST (not with a late mov because a tester grepping for 'inited AND evaluate_ct > 0' must observe cleared counters first).  Leaf, zero callee-save pushes, no nested calls.  Labels prefixed `osci_`.",
      block: {
        xor rax, rax;
        mov [rip + _osc_request_counter],   rax;
        mov [rip + _osc_walker_ready],      rax;
        mov [rip + _osc_evaluate_ct],       rax;
        mov [rip + _osc_poll_ct],           rax;
        mov [rip + _osc_feature_ct],        rax;
        mov [rip + _osc_refused_ct],        rax;
        mov [rip + _osc_last_uuid_lo],      rax;
        mov [rip + _osc_last_uuid_hi],      rax;
        mov [rip + _osc_last_handle],       rax;
        mov [rip + _osc_last_granted],      rax;
        mov [rip + _osc_last_feature],      rax;
        mov [rip + _osc_last_feature_sts],  rax;

        mov rax, 1;
        mov [rip + _osc_inited], rax;

        xor rax, rax;                            // OSC_OK
        ret
      }
    }

  // ==========================================================================
  // §J  osc_evaluate(uuid_ptr, control_dwords_ptr, n_dwords) -> u64
  //
  // SKELETON: validate args, read uuid_lo/uuid_hi from *uuid_ptr,
  // compute slot index (counter & 7), compute row base, write
  // {handle, uuid_lo, uuid_hi, control_dwords_ptr, n_dwords,
  // status=PENDING, timestamp=counter&0xFFFFFFFF} into the row, bump
  // counter, bump _osc_evaluate_ct, emit EVAL fingerprint, return
  // the handle.
  //
  // Gates in order so an operator sees the first failure:
  //   (1) _osc_inited==0        -> OSC_ERR_WALKER_NOT_READY (callers
  //                                 that call before init get the
  //                                 "no evaluator attached" signal,
  //                                 since init+register are the two
  //                                 preconditions and either absence
  //                                 is the same practical failure)
  //   (2) uuid_ptr==0           -> OSC_ERR_BAD_UUID
  //   (3) (uuid_ptr & 7) != 0   -> OSC_ERR_BAD_UUID (misaligned reads
  //                                 would still work on x86-64 but we
  //                                 refuse to normalise callers who
  //                                 pass misaligned buffers)
  //   (4) n_dwords<1 or n_dwords>4 -> OSC_ERR_NDWORDS_OOB
  //
  // Walker-ready gate is DELIBERATELY NOT PRESENT here: the kernel
  // still queues the request so that if the walker comes up before
  // the caller's `osc_poll`, the exchange completes.  The walker-
  // ready gate IS checked by `osc_poll` because that's where the
  // caller blocks on a reply.
  //
  // Returns the handle on success (a u64 that is always < 2^63 and
  // disjoint from the 0xFFFFFD-prefixed error band); one of the error
  // codes on refusal.
  //
  // SysV: rdi=uuid_ptr, rsi=control_dwords_ptr, rdx=n_dwords.
  // Register plan: 4 pushes (rbx, r12=uuid_ptr, r13=cdwords_ptr,
  // r14=n_dwords); entry rsp%16==8, after 4 pushes rsp%16==8; for the
  // klog_s1_x2 call sub rsp, 24 brings rsp%16==0 (24 bytes = v2
  // slot [rsp+0] + 16 bytes padding, per the pdx-encoder-pitfalls
  // "2 pushes → +24 pad" rule generalised to even push-counts).
  // Labels prefixed `osce_`.
  // ==========================================================================

  pub let osc_evaluate : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (uuid_ptr: u64, control_dwords_ptr: u64, n_dwords: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2558 (Wave 80 I1) skeleton: queue an _OSC evaluation request into the 8-row scratch ring and return the handle.  Gates match file-header §J ordering; walker-ready gate is DEFERRED to osc_poll (the queueing side writes regardless, so a late-attaching walker still sees the request).  Row-offset arithmetic: `rax = (counter & 7) * 48 = (idx<<5) + (idx<<4)` — two shifts + one add instead of a 2-op `imul r,imm` which the paideia-as encoder refuses; `and rN, 7` keeps the mask in imm8 so no `and rN, imm64` either.  Status write lands LAST in the row so a user-space walker that polls the ring on another core sees a complete request body before observing status==PENDING — x86-64 TSO suffices (ACPI 6.5 §12.11.2 ordering).  Timestamp field uses the low 32 bits of the counter rather than a TSC read because the skeleton has no sanctioned path to RDTSC yet (follow-up slice swaps in a real timestamp through a KIND_HW_TIMELINE cap); the counter's low 32 bits give per-boot monotonic ordering that is adequate for witness assertions.  4-push callee-save prologue: entry rsp%16==8, after 4 pushes rsp%16==8 (even pushes preserve parity).  For the klog_s1_x2 call `sub rsp, 24` reserves one qword at [rsp+0] for v2 (uuid_hi) plus 16 bytes of pad, bringing rsp%16==0 at CALL per the pdx-encoder-pitfalls 2-pushes-+24-pad rule generalised to any even push-count.  Labels prefixed `osce_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                            // uuid_ptr
        mov r13, rsi;                            // control_dwords_ptr
        mov r14, rdx;                            // n_dwords

        // --- (1) inited?
        mov rax, [rip + _osc_inited];
        cmp rax, 0;
        je  osce_not_ready;

        // --- (2) uuid_ptr != 0?
        cmp r12, 0;
        je  osce_bad_uuid;

        // --- (3) uuid_ptr & 7 == 0?
        mov rax, r12;
        and rax, 7;
        cmp rax, 0;
        jne osce_bad_uuid;

        // --- (4) n_dwords in [1, 4]?
        cmp r14, 1;
        jb  osce_nd_oob;
        cmp r14, 4;
        ja  osce_nd_oob;

        // --- Load UUID.
        mov rbx, [r12];                          // rbx = uuid_lo
        mov rax, [r12 + 8];                      // rax = uuid_hi (scratch)

        mov [rip + _osc_last_uuid_lo], rbx;
        mov [rip + _osc_last_uuid_hi], rax;

        // --- Handle = current counter.
        mov rcx, [rip + _osc_request_counter];
        mov [rip + _osc_last_handle], rcx;

        // --- Slot index = counter & 7.
        mov rdx, rcx;
        and rdx, 7;

        // --- Row offset = idx * 48 = (idx<<5) + (idx<<4).
        mov r10, rdx;
        shl r10, 5;                              // idx * 32
        mov r11, rdx;
        shl r11, 4;                              // idx * 16
        add r10, r11;                            // idx * 48

        // --- Row base.
        lea r11, [rip + _osc_ring];
        add r11, r10;                            // r11 = row ptr

        // --- Row fill: handle, uuid_lo, uuid_hi, cdwords_ptr are u64.
        mov [r11 + 0],  rcx;                     // request_handle
        mov [r11 + 8],  rbx;                     // uuid_lo
        mov [r11 + 16], rax;                     // uuid_hi (still in rax)
        mov [r11 + 24], r13;                     // control_dwords_ptr

        // --- Row tail: n_dwords, result_dword, status, timestamp are u32.
        mov eax, r14d;                           // n_dwords (low 32 bits)
        mov [r11 + 32], eax;                     // n_dwords
        xor eax, eax;
        mov [r11 + 36], eax;                     // result_dword = 0
        mov eax, 1;                              // OSC_RING_STATUS_PENDING
        mov [r11 + 40], eax;                     // status
        mov eax, ecx;                            // low 32 bits of counter
        mov [r11 + 44], eax;                     // timestamp

        // --- Bump counter.
        add rcx, 1;
        mov [rip + _osc_request_counter], rcx;

        // --- Bump stat.
        mov rax, [rip + _osc_evaluate_ct];
        add rax, 1;
        mov [rip + _osc_evaluate_ct], rax;

        // --- Emit EVAL fingerprint via klog_s1_x2.
        //
        //   OSC EVAL uuid_lo=0x<16-hex> uuid_hi=0x<16-hex>
        //
        // klog_s1_x2 signature:
        //   rdi = level, rsi = subsys_ptr, rdx = tag_ptr,
        //   rcx = k1_ptr, r8 = v1, r9 = k2_ptr,
        //   [rsp+0 at CALL] = v2 (uuid_hi) — the wrapper reads
        //                      [rbp+16] after its own push rbp.
        //
        // 4 pushes already in flight → rsp%16==8; `sub rsp, 24` lands
        // rsp%16==0 at CALL with v2 slot at [rsp+0] and 16 B pad above.
        sub rsp, 24;
        mov rax, [rip + _osc_last_uuid_hi];
        mov [rsp + 0], rax;                      // v2 for klog_s1_x2

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + osc_tag_eval];
        lea rcx, [rip + osc_k_uuid_lo];
        mov r8,  [rip + _osc_last_uuid_lo];      // v1
        lea r9,  [rip + osc_k_uuid_hi];
        call klog_s1_x2;
        add rsp, 24;

        // --- Return handle.
        mov rax, [rip + _osc_last_handle];
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      osce_not_ready:
        mov rax, 0;
        mov [rip + _osc_refused_ct], rax;        // stat untouched on this gate
        mov rax, 0xFFFFFDF9;                     // OSC_ERR_WALKER_NOT_READY
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      osce_bad_uuid:
        mov rax, [rip + _osc_refused_ct];
        add rax, 1;
        mov [rip + _osc_refused_ct], rax;
        mov rax, 0xFFFFFDF5;                     // OSC_ERR_BAD_UUID
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      osce_nd_oob:
        mov rax, [rip + _osc_refused_ct];
        add rax, 1;
        mov [rip + _osc_refused_ct], rax;
        mov rax, 0xFFFFFDF6;                     // OSC_ERR_NDWORDS_OOB
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  osc_poll(request_handle, out_result_ptr) -> u64
  //
  // SKELETON: validate args + walker-ready flag; locate the row for
  // the handle (slot = handle & 7); if row.request_handle != handle,
  // the slot has been recycled -> OSC_ERR_HANDLE_EXPIRED.  Read
  // row.status: PENDING -> return OSC_RING_STATUS_PENDING (not an
  // error, a caller-visible "try again" signal), READY -> write
  // row.result_dword through *out_result_ptr, bump _osc_poll_ct,
  // snap into _osc_last_granted + _osc_last_handle, emit POLL
  // fingerprint, return OSC_OK.  ERROR -> write 0 through out_result_ptr
  // and return OSC_RING_STATUS_ERROR so the caller can distinguish
  // "walker refused" from "walker not run yet".
  //
  // The skeleton has no walker, so every real poll will land in the
  // PENDING arm.  The walker-ready gate here is NOT the same as the
  // one in osc_evaluate: that one guards an uninitialised ring; this
  // one guards the user-space reply path.  The gates are symmetric
  // in appearance but semantically distinct.
  //
  // Gates:
  //   (1) _osc_inited==0           -> OSC_ERR_WALKER_NOT_READY
  //   (2) _osc_walker_ready==0     -> OSC_ERR_WALKER_NOT_READY
  //   (3) out_result_ptr==0        -> OSC_ERR_BAD_UUID (no distinct
  //                                     code for a bad out_result_ptr,
  //                                     and OSC_ERR_BAD_UUID's low
  //                                     byte 0x62 is close enough to
  //                                     the EC band 0xC5..CA that a
  //                                     reviewer sees "bad pointer"
  //                                     without needing a sixth code)
  //   (4) (out_result_ptr & 3) != 0 -> OSC_ERR_BAD_UUID (u32 alignment)
  //   (5) row.request_handle != handle -> OSC_ERR_HANDLE_EXPIRED
  //
  // SysV: rdi = handle, rsi = out_result_ptr.  Register plan: 3 pushes
  // (rbx = handle preserved, r12 = out_result_ptr preserved,
  // r13 = row ptr).  entry rsp%16==8, after 3 pushes rsp%16==0; the
  // klog_s1_x2 call needs sub rsp, 16 (3-pushes-+16-pad per pdx-
  // encoder-pitfalls).  Labels prefixed `oscp_`.
  // ==========================================================================

  pub let osc_poll : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (request_handle: u64, out_result_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2558 (Wave 80 I1) skeleton: look up a pending _OSC evaluation by handle and surface the walker's reply.  The three distinguishable return paths are OSC_OK (walker has written row.result_dword and the caller may consume it), OSC_RING_STATUS_PENDING (the walker has not yet run — caller should wait and poll again), and OSC_RING_STATUS_ERROR (the walker has run and refused — caller should give up on this evaluation).  Each is a distinct return value because callers behave DIFFERENTLY in each case (wait vs. retry vs. fallback), and conflating them into an error band would lose the structure the caller actually needs.  Handle-expiry check compares row.request_handle against the caller's handle at the computed slot: a mismatch means the slot has been recycled by a later osc_evaluate wrapping around 8 slots.  Status read is a 32-bit mov `mov eax, [r11 + 40]` which zero-extends into rax per x86-64 SDM Vol.1 §3.4.1.1.  3-push callee-save prologue: entry rsp%16==8, after 3 pushes rsp%16==0.  For the klog_s1_x2 call `sub rsp, 16` reserves one qword at [rsp+0] for v2 (granted) plus 8 bytes of pad, bringing rsp%16==0 at CALL per the pdx-encoder-pitfalls 3-pushes-+16-pad rule.  Labels prefixed `oscp_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                            // handle
        mov r12, rsi;                            // out_result_ptr

        // --- (1) inited?
        mov rax, [rip + _osc_inited];
        cmp rax, 0;
        je  oscp_not_ready;

        // --- (2) walker_ready?
        mov rax, [rip + _osc_walker_ready];
        cmp rax, 0;
        je  oscp_not_ready;

        // --- (3) out_result_ptr != 0?
        cmp r12, 0;
        je  oscp_bad_ptr;

        // --- (4) out_result_ptr & 3 == 0?
        mov rax, r12;
        and rax, 3;
        cmp rax, 0;
        jne oscp_bad_ptr;

        // --- Slot index + row ptr.
        mov rdx, rbx;
        and rdx, 7;
        mov r10, rdx;
        shl r10, 5;                              // idx * 32
        mov r11, rdx;
        shl r11, 4;                              // idx * 16
        add r10, r11;                            // idx * 48

        lea r13, [rip + _osc_ring];
        add r13, r10;                            // r13 = row ptr

        // --- (5) row.request_handle == handle?
        mov rax, [r13 + 0];
        cmp rax, rbx;
        jne oscp_expired;

        // --- Read status (u32).
        mov eax, [r13 + 40];
        cmp eax, 1;                              // OSC_RING_STATUS_PENDING
        je  oscp_pending;
        cmp eax, 2;                              // OSC_RING_STATUS_READY
        je  oscp_ready;
        cmp eax, 3;                              // OSC_RING_STATUS_ERROR
        je  oscp_err_sts;
        // Any other status (incl. FREE) means the row was never written
        // for this handle; treat as expired.
        jmp oscp_expired;

      oscp_ready:
        // Read result_dword (u32) and write through out_result_ptr.
        mov eax, [r13 + 36];
        mov [r12], eax;

        // Snap for fingerprint.
        mov [rip + _osc_last_handle],  rbx;
        mov rcx, rax;                            // zero-extended u32
        mov [rip + _osc_last_granted], rcx;

        // Bump stat.
        mov rax, [rip + _osc_poll_ct];
        add rax, 1;
        mov [rip + _osc_poll_ct], rax;

        // Emit POLL fingerprint.
        //
        //   OSC POLL handle=0x<16-hex> granted=0x<8-hex>
        //
        // 3 pushes in flight → rsp%16==0; sub rsp, 16 → rsp%16==0 at CALL.
        sub rsp, 16;
        mov rax, [rip + _osc_last_granted];
        mov [rsp + 0], rax;                      // v2 for klog_s1_x2

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + osc_tag_poll];
        lea rcx, [rip + osc_k_handle];
        mov r8,  [rip + _osc_last_handle];       // v1
        lea r9,  [rip + osc_k_granted];
        call klog_s1_x2;
        add rsp, 16;

        xor rax, rax;                            // OSC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      oscp_pending:
        mov rax, 1;                              // OSC_RING_STATUS_PENDING
        pop r13;
        pop r12;
        pop rbx;
        ret;

      oscp_err_sts:
        xor eax, eax;
        mov [r12], eax;                          // zero out the result
        mov rax, 3;                              // OSC_RING_STATUS_ERROR
        pop r13;
        pop r12;
        pop rbx;
        ret;

      oscp_not_ready:
        mov rax, [rip + _osc_refused_ct];
        add rax, 1;
        mov [rip + _osc_refused_ct], rax;
        mov rax, 0xFFFFFDF9;                     // OSC_ERR_WALKER_NOT_READY
        pop r13;
        pop r12;
        pop rbx;
        ret;

      oscp_bad_ptr:
        mov rax, [rip + _osc_refused_ct];
        add rax, 1;
        mov [rip + _osc_refused_ct], rax;
        mov rax, 0xFFFFFDF5;                     // OSC_ERR_BAD_UUID (bad ptr)
        pop r13;
        pop r12;
        pop rbx;
        ret;

      oscp_expired:
        mov rax, [rip + _osc_refused_ct];
        add rax, 1;
        mov [rip + _osc_refused_ct], rax;
        mov rax, 0xFFFFFDF7;                     // OSC_ERR_HANDLE_EXPIRED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  osc_platform_feature_query(feature) -> u64
  //
  // SKELETON: validate feature code is in [0,5], snap feature +
  // sentinel-status (0 = "not granted / unknown") into last-feature
  // slots, bump _osc_feature_ct, emit FEATURE fingerprint, return
  // sentinel status.
  //
  // The real body consults a cached result from an earlier walker-
  // mediated evaluation of the matching UUID (CPU _OSC for PSTATE /
  // POWER/SLEEP buttons; PCIe _OSC for PCIE_HOTPLUG; platform-wide
  // _OSC for THERMAL / LID_SWITCH) and returns the per-feature bit
  // from the ownership-granted dword.  Today there is no cache, and
  // sentinel 0 is the honest default: the kernel does NOT yet own
  // the feature.  A caller that treats the return value as "do I
  // own this?" gets the correct conservative answer and defers to
  // firmware; a caller that sees sentinel-0 and panics was wrong to
  // treat the fast-path as authoritative at skeleton stage.
  //
  // SysV: rdi = feature.  Register plan: 2 pushes (rbx = feature
  // preserved, r12 scratch).  entry rsp%16==8, after 2 pushes
  // rsp%16==8; sub rsp, 24 (2-pushes-+24-pad per pdx-encoder-
  // pitfalls) for the klog_s1_d2 call.  Labels prefixed `oscf_`.
  // ==========================================================================

  pub let osc_platform_feature_query : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (feature: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2558 (Wave 80 I1) skeleton: short-circuit for well-known _OSC features (PCIe hotplug, thermal, p-state, power/sleep buttons, lid switch).  Feature code is bound-checked against OSC_FEATURE_MAX (5); anything above returns OSC_ERR_FEATURE_UNKNOWN which NAMES a dispatch bug (the caller passed a feature code the kernel does not know about), distinct from OSC_ERR_WALKER_NOT_READY which names an attachment bug.  Return value at skeleton stage is sentinel 0 (not granted) — the kernel defers to firmware for every feature until the walker-mediated evaluation lands.  2-push callee-save prologue (rbx = feature, r12 scratch): entry rsp%16==8, after 2 pushes rsp%16==8.  klog_s1_d2 wrapper (2 decimal KVs: kind + status): sub rsp, 24 brings rsp%16==0 at CALL with v2 slot at [rsp+0] and 16 B pad above, per the pdx-encoder-pitfalls 2-pushes-+24-pad rule.  Labels prefixed `oscf_`.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                            // feature

        // --- Gate: inited?
        mov rax, [rip + _osc_inited];
        cmp rax, 0;
        je  oscf_not_ready;

        // --- Gate: feature <= 5?
        cmp rbx, 5;
        ja  oscf_unknown;

        // --- Snap feature + sentinel status (0).
        mov [rip + _osc_last_feature], rbx;
        xor rax, rax;
        mov [rip + _osc_last_feature_sts], rax;

        // --- Bump stat.
        mov rax, [rip + _osc_feature_ct];
        add rax, 1;
        mov [rip + _osc_feature_ct], rax;

        // --- Emit FEATURE fingerprint.
        //
        //   OSC FEATURE kind=<dec> status=<dec>
        //
        // 2 pushes in flight → rsp%16==8; sub rsp, 24 → rsp%16==0 at CALL.
        sub rsp, 24;
        mov rax, [rip + _osc_last_feature_sts];
        mov [rsp + 0], rax;                      // v2 for klog_s1_d2

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + osc_tag_feature];
        lea rcx, [rip + osc_k_kind];
        mov r8,  [rip + _osc_last_feature];      // v1
        lea r9,  [rip + osc_k_status];
        call klog_s1_d2;
        add rsp, 24;

        xor rax, rax;                            // sentinel: not granted
        pop r12;
        pop rbx;
        ret;

      oscf_not_ready:
        mov rax, [rip + _osc_refused_ct];
        add rax, 1;
        mov [rip + _osc_refused_ct], rax;
        mov rax, 0xFFFFFDF9;                     // OSC_ERR_WALKER_NOT_READY
        pop r12;
        pop rbx;
        ret;

      oscf_unknown:
        mov rax, [rip + _osc_refused_ct];
        add rax, 1;
        mov [rip + _osc_refused_ct], rax;
        mov rax, 0xFFFFFDF8;                     // OSC_ERR_FEATURE_UNKNOWN
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  cap_handler_osc(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch stub the KIND_OSC (0x50) arm in cap/invoke.pdx calls.
  // Routes by op_arg's low byte:
  //
  //   op == OSC_OP_EVAL          (1) -> INVOKE_UNSUPPORTED at skeleton
  //                                      (three pointer args do not
  //                                      fit in op_arg's remaining
  //                                      56 bits; follow-up slice adds
  //                                      a dedicated KIND_OSC_SUBMIT
  //                                      cap with the three fields in
  //                                      its row — same posture as
  //                                      tpm_crb.pdx's TPM_OP_SUBMIT)
  //   op == OSC_OP_POLL          (2) -> INVOKE_UNSUPPORTED at skeleton
  //                                      (two pointer args; same
  //                                      follow-up reasoning)
  //   op == OSC_OP_FEATURE_QUERY (3) -> osc_platform_feature_query(
  //                                      op_arg >> 8)
  //   otherwise                      -> INVOKE_UNSUPPORTED
  //
  // Rights and target_ptr are IGNORED at skeleton stage.  SysV:
  // rdi = rights, rsi = target_ptr, rdx = op_arg.  Register plan:
  // 3-push prologue (rbx = op_arg saved, r12 = op code, r13 scratch).
  // Labels prefixed `osch_`.
  // ==========================================================================

  pub let cap_handler_osc : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2558 (Wave 80 I1) skeleton: cap-table dispatch stub for KIND_OSC (0x50).  The three legal ops are a cmp-chain (not a jump table) because three live values compile to less bytecode as a chain.  Two of them (EVAL, POLL) cannot fit their pointer args in op_arg's remaining 56 bits and refuse with INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC) rather than a OSC_ERR_* code — INVOKE_UNSUPPORTED names a cap-dispatch bug (the follow-up KIND_OSC_SUBMIT cap carries the args in its row); OSC_ERR_* codes name wire-side bugs.  FEATURE_QUERY fits (one small integer unpacked via op_arg >> 8).  Rights + target_ptr are ACCEPTED but IGNORED at skeleton stage; a follow-up slice may add a rights gate (R_OSC_EVAL / R_OSC_POLL) once KIND_OSC is minted against a specific principal.  3-push prologue aligns rsp%16==0 for every nested CALL (entry rsp%16==8, after 3 pushes rsp%16==0).  Op is masked to low byte via `and r12, 0xFF` so a caller leaving garbage in the high bytes of op_arg does not accidentally match a legal op.  Labels prefixed `osch_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdx;                            // rbx = op_arg (preserve)
        mov r12, rdx;                            // r12 = op code
        and r12, 0xFF;                           // mask to low byte

        cmp r12, 1;                              // OSC_OP_EVAL
        je  osch_submit_eval;
        cmp r12, 2;                              // OSC_OP_POLL
        je  osch_submit_poll;
        cmp r12, 3;                              // OSC_OP_FEATURE_QUERY
        je  osch_feature;

        mov rax, 0xFFFFFFFFFFFFFFFC;             // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      osch_submit_eval:
        mov rax, 0xFFFFFFFFFFFFFFFC;             // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      osch_submit_poll:
        mov rax, 0xFFFFFFFFFFFFFFFC;             // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      osch_feature:
        mov rdi, rbx;
        shr rdi, 8;                              // feature = op_arg >> 8
        call osc_platform_feature_query;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  Stat getters — single-load leaves for witness callers
  //
  // Named counterparts to ec.pdx / tpm_crb.pdx's getter sets.  A boot
  // witness can assert
  //
  //   osc_inited()           == 1
  //   AND osc_evaluate_count()  >= 1  (after one evaluate call)
  //   AND osc_refused_count()   == 0  (if no refusals occurred)
  //
  // Each getter is a single-load leaf.
  // ==========================================================================

  pub let osc_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_inited.  Flipped to 1 by osc_init; stays 1 across its lifetime (no de-init path).  Leaf.",
      block: { mov rax, [rip + _osc_inited]; ret }
    }

  pub let osc_walker_ready : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_walker_ready.  Sticky-false at skeleton stage; the follow-up slice flips it to 1 once the user-space component attaches through its registration syscall.  Leaf.",
      block: { mov rax, [rip + _osc_walker_ready]; ret }
    }

  pub let osc_request_counter_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_request_counter.  Monotonic across the ring's lifetime; low 3 bits name the next slot to fill.  Leaf.",
      block: { mov rax, [rip + _osc_request_counter]; ret }
    }

  pub let osc_evaluate_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_evaluate_ct.  Bumped once per successful osc_evaluate.  Leaf.",
      block: { mov rax, [rip + _osc_evaluate_ct]; ret }
    }

  pub let osc_poll_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_poll_ct.  Bumped once per successful OSC_OK return from osc_poll.  Leaf.",
      block: { mov rax, [rip + _osc_poll_ct]; ret }
    }

  pub let osc_feature_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_feature_ct.  Bumped once per successful osc_platform_feature_query.  Leaf.",
      block: { mov rax, [rip + _osc_feature_ct]; ret }
    }

  pub let osc_refused_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_refused_ct.  Bumped once per gate failure across all three entrypoints (bad uuid, n_dwords OOB, handle expired, feature unknown, walker not ready).  Leaf.",
      block: { mov rax, [rip + _osc_refused_ct]; ret }
    }

  pub let osc_last_uuid_lo_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_last_uuid_lo.  The low 8 bytes of the last UUID osc_evaluate queued.  Leaf.",
      block: { mov rax, [rip + _osc_last_uuid_lo]; ret }
    }

  pub let osc_last_uuid_hi_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_last_uuid_hi.  The high 8 bytes of the last UUID osc_evaluate queued.  Leaf.",
      block: { mov rax, [rip + _osc_last_uuid_hi]; ret }
    }

  pub let osc_last_handle_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_last_handle.  The handle returned by the most recent successful osc_evaluate or consumed by the most recent successful osc_poll.  Leaf.",
      block: { mov rax, [rip + _osc_last_handle]; ret }
    }

  pub let osc_last_granted_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_last_granted.  The ownership-granted bitmask (u32 zero-extended) from the most recent successful osc_poll.  Leaf.",
      block: { mov rax, [rip + _osc_last_granted]; ret }
    }

  pub let osc_last_feature_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_last_feature.  The feature code from the most recent osc_platform_feature_query.  Leaf.",
      block: { mov rax, [rip + _osc_last_feature]; ret }
    }

  pub let osc_last_feature_sts_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2558 (Wave 80 I1): single-load getter for _osc_last_feature_sts.  Sentinel 0 at skeleton stage (feature not granted — kernel defers to firmware); the follow-up slice fills it from a cached walker-mediated evaluation.  Leaf.",
      block: { mov rax, [rip + _osc_last_feature_sts]; ret }
    }

}
