// src/kernel/core/drivers/acpi/fan.pdx — Wave 59 D11 (paideia-os#2528)
//
// ACPI fan PWM + tachometer driver SKELETON.  The T14 G4 chassis
// ships a single mechanical fan driven by the Embedded Controller:
// an 8-bit PWM duty slot (0..255) sets the drive, a 16-bit tach
// period in microseconds reads the current rotational speed, and a
// one-bit critical-override register forces the fan to full speed
// unconditionally (ignoring OS requests).  This driver speaks to all
// three fields through the D8 EC OpRegion handler
// (`src/kernel/core/drivers/acpi/ec.pdx`) via `ec_read_u8` and
// `ec_write_u8`, and binds the two-threshold passive-cooling policy
// landed in Wave 59 D10 (`thermal.pdx`) to a duty value via
// `fan_apply_policy`.
//
// -----------------------------------------------------------------------------
// §0  WHAT THIS FILE IS NOT
// -----------------------------------------------------------------------------
//
// `cap/kind_cooling_device.pdx` (R31.M4-001 #1103) owns the
// AUTHORITY-layer `KIND_COOLING_DEVICE = 0x159` for the cooling-
// device cap: the right to be TOLD that a cooling device changed
// state, held by a policy supervisor.  It does not read the EC and
// does not drive PWM.  THIS file is the DRIVER-layer surface — it
// reads/writes the EC bytes, computes the policy->duty mapping, and
// emits the on-wire fingerprints a boot witness grepss to confirm the
// seam fires.  The two kinds coexist for the same reason KIND_BATTERY
// (0x158) and KIND_BATTERY_DRV (0x3D) coexist (see §3 of
// `drivers/acpi/battery.pdx` for the orthogonality argument against
// collapsing authority and transport into one capability).
//
// -----------------------------------------------------------------------------
// §1  EC OFFSETS — PLACEHOLDERS, SAME DISCIPLINE AS D9/D10
// -----------------------------------------------------------------------------
//
// Four EC offsets are frozen as spec-architectural named symbols.
// On the T14 G4 the real DSDT values live inside an
// `OperationRegion(ECOR, EmbeddedControl, 0x00, 0x100)` block whose
// FanControl Field declaration a ring-3 AML walker (D5, follow-up)
// resolves to actual bytes; the skeleton picks values compatible
// with the layout dumped from BIOS 2026-07-04 and leaves a visible
// gap between the duty byte, the tach pair and the override byte so
// a reviewer scanning the EC map does not conflate them:
//
//     FAN_PWM_DUTY           0x30   // u8, drive 0..255
//     FAN_TACH_PERIOD_LO     0x32   // u16 LE, period in us (low)
//     FAN_TACH_PERIOD_HI     0x33   // u16 LE, period in us (high)
//     FAN_CRITICAL_OVERRIDE  0x34   // u8, bit 0 = force max
//
// A different-platform probe (follow-up slice) replaces each of the
// right-hand sides without touching any consumer symbol.
//
// -----------------------------------------------------------------------------
// §2  TACH -> HZ CONVERSION, AND WHY `div`-NOT-`idiv`
// -----------------------------------------------------------------------------
//
// The EC reports the time between tach-sense pulses as a 16-bit
// unsigned microsecond count.  Converting to Hz is a straight
// reciprocal:
//
//     hz = 1_000_000 / period_us
//
// (This is one tach pulse per rotation.  A standard 2-pulse-per-rev
// Hall-effect sensor would halve the result; the follow-up slice
// that lands the real tach wiring picks the sensor model and
// multiplies/divides accordingly.  Today the skeleton reports the
// unscaled quotient to keep the arithmetic honest and the
// fingerprint auditable.)
//
// Division uses the paideia-as `div r64` with `xor rdx, rdx` to
// zero-extend the dividend: `idiv` is NOT shipped in paideia-as
// v0.36.82 (`grep -rn '\bidiv\b' src/kernel/`, 2026-10-10, returns
// zero hits) and `period_us` is unsigned, so unsigned division is
// semantically correct — same discipline
// `kelvin_tenths_to_celsius_whole` uses in `drivers/acpi/thermal.pdx`
// §I.
//
// `period_us == 0` would divide-by-zero.  The guard checks the
// composed period against zero BEFORE the divide and returns
// FAN_ERR_TACH_STALL — the fan is stuck or the sense wire is
// disconnected.  The guard is named "stall" rather than "divide by
// zero" so the error-band code names the physical condition (a dead
// fan) rather than the arithmetic one.
//
// -----------------------------------------------------------------------------
// §3  POLICY <-> DUTY TABLE
// -----------------------------------------------------------------------------
//
// `fan_apply_policy` reads `thermal_last_state()` (Wave 59 D10, see
// `drivers/acpi/thermal.pdx` §M) and sets duty by the following
// table.  Both the duty value and the critical-override bit are
// written through the EC OpRegion:
//
//   THM_STATE_NORMAL   (0) -> duty 0   (fan off)
//                              critical_override = 0
//   THM_STATE_PASSIVE  (1) -> duty 128 (50%)
//                              critical_override = 0
//   THM_STATE_CRITICAL (2) -> duty 255 (100%, forced)
//                              critical_override = 1 (bit 0 set)
//
// Any other state value is a plumbing bug (thermal state is a 3-way
// enum landed in Wave 59 D10) and returns FAN_ERR_UNKNOWN_POLICY.
// The policy-apply path does NOT read duty back after the write —
// it emits the REQUESTED duty in the fingerprint so a tester can
// correlate the policy decision with the actuation.  A follow-up
// slice that lands tach-based verification will re-read the fan
// speed after a settle interval and refuse policies whose actuation
// did not take.
//
// -----------------------------------------------------------------------------
// §4  RETURN CODES — band 0xFFFFFFF0..F4
// -----------------------------------------------------------------------------
//
// Reserved by paideia-os#2528 for the fan driver.  The task
// directive named band 0xFFFFFFE0..E4; `grep -rE "0xFFFFFFE[0-6]"
// src/kernel/` showed the I2C_IRQ driver (`drivers/i2c/dw_irq.pdx`)
// already reserves 0xFFFFFFE0..E6 for its own FAILURE TAXONOMY
// (0xFFFFFFE3..E6 are presently in use for BAD_IDX / BAD_STATE /
// NOT_OWNER / BUSY; E0..E2 are reserved-for-future-use).  Keeping
// the fan codes disjoint from every other active band means picking
// an unoccupied one; `grep -rE "0xFFFFFFF[0-6]"` showed 0xFFFFFFF0
// is a GENERATION_EXHAUSTION_THRESHOLD CONSTANT (cap/generation.pdx,
// not a return code) and 0xFFFFFFF7..FF is HW_INT_* territory
// (cap/kind_hw_interrupt.pdx), so 0xFFFFFFF0..F4 is five free slots
// adjacent to no active band.
//
// Disjoint from:
//   EC_ERR_*            (0xFFFFFFC5..CA, drivers/acpi/ec.pdx)
//   BATTERY_ERR_*       (0xFFFFFFD1..D6, drivers/acpi/battery.pdx)
//   GPU_GTT_*           (0xFFFFFFDB..DF, drivers/gpu/gpu_gtt.pdx)
//   THERMAL_ERR_*       (0xFFFFFFD6..DA, drivers/acpi/thermal.pdx)
//   I2C_IRQ_*           (0xFFFFFFE0..E6, drivers/i2c/dw_irq.pdx)
//   MSIX_*              (0xFFFFFFE7..EF)
//   HW_INT_*            (0xFFFFFFFC..FF, cap/kind_hw_interrupt.pdx)
//
//   0xFFFFFFF0  FAN_ERR_EC_NOT_INIT       — either ec_init has not run
//                                             or fan_init has not run.
//                                             One code covers both:
//                                             the operator reads
//                                             `ec_inited()` and
//                                             `fan_inited()` to tell
//                                             them apart (same shape
//                                             as battery.pdx §2's
//                                             BATTERY_ERR_EC_NOT_INIT).
//   0xFFFFFFF1  FAN_ERR_BAD_DUTY          — fan_set_duty called with
//                                             a value > 255.  The EC
//                                             register is 8-bit; a
//                                             wider value would wrap
//                                             silently without this
//                                             gate.
//   0xFFFFFFF2  FAN_ERR_TACH_STALL        — the composed tach period
//                                             came back zero.  Either
//                                             the fan is stuck or the
//                                             sense wire is open; the
//                                             reciprocal cannot be
//                                             computed either way.
//   0xFFFFFFF3  FAN_ERR_UNKNOWN_POLICY    — thermal_last_state()
//                                             returned a value
//                                             outside {0,1,2}.  A
//                                             plumbing bug in D10
//                                             rather than a hardware
//                                             condition — the refusal
//                                             names the bug.
//   0xFFFFFFF4  FAN_ERR_EC_WRITE_FAILED   — ec_write_u8 returned a
//                                             code in the EC error
//                                             band (0xFFFFFF00..FF).
//                                             Collapsed into one fan
//                                             code so a consumer sees
//                                             exactly one error band
//                                             per layer.
//
// -----------------------------------------------------------------------------
// §5  invoke.pdx — KIND_FAN_DRV = 0x40
// -----------------------------------------------------------------------------
//
// This file adds one cap-table dispatch slot:
//
//     KIND_FAN_DRV = 0x40
//
// Immediately after KIND_PPGTT (0x3F, Wave 74 G5, paideia-os#2542).
// Audit at landing time: `grep -nE '\b0x40\b' src/kernel/core/cap/
// invoke.pdx` returned zero existing dispatch arms.  The symbol
// `KIND_INTERRUPT_CAP_ALIAS = 0x40` already lives in
// `cap/kind_interrupt.pdx` as a RETIRED alias (design §4.6 — the
// path reserving the slot so the retirement can land as a one-line
// alias change in a follow-up slice).  Reusing the value for the
// NEW driver-kind tag does not conflict because:
//
//   (a) no dispatch arm in invoke.pdx matches on 0x40 today — the
//       retired alias was declared but never wired, so the
//       collision is only at the symbolic value level,
//   (b) the symbol NAMES are disjoint (KIND_INTERRUPT_CAP_ALIAS
//       versus KIND_FAN_DRV) so link-time symbol confinement
//       suffers no clash,
//   (c) the retirement path's purpose was to RECLAIM 0x40 for a
//       future driver kind; this file is that reclamation.
//
// The design-doc note that will land with the real-body slice
// should mention that KIND_INTERRUPT_CAP_ALIAS can be safely retired
// in favour of KIND_FAN_DRV at the next cap-table reconciliation.
//
// -----------------------------------------------------------------------------
// §6  FINGERPRINTS
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/fan.golden:
//
//     FAN SET duty=<dec>
//     FAN READ duty=<dec> hz=<dec>
//     FAN POLICY state=<dec> duty=<dec>
//
// Emitted by `fan_set_duty` (klog_s1_d1), `fan_read_duty`
// (klog_s1_d2), `fan_apply_policy` (klog_s1_d2).  All three values
// are natural decimal magnitudes (duty is 0..255, hz is 0..~65535,
// state is 0..2) and NONE needs the hex wrapper.
//
// -----------------------------------------------------------------------------
// §7  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   G1 — every EC byte goes through ec_read_u8 / ec_write_u8
//        (ec.pdx), which the real-body slice will replace with
//        `in_b` / `out_b` instructions.  This file issues no port
//        I/O of its own.
//   G4 — every compare is on a full 64-bit register; no `cmp al,
//        imm`.  Each duty-upper-bound check (`cmp rN, 255`) fits
//        imm32.
//   No `test rN, rN` — zero-equality uses `cmp rN, 0`.
//   No `and r, imm64` — every mask here fits imm32.
//   No two-operand `imul r, imm` — only one divide (period->hz),
//        encoded as `div r64` after `xor rdx, rdx`.
//   Multiline `pub let x = "..."` strings — forbidden; every tag
//        below is one line.
//   Module basename match — `fan.pdx` -> `module Fan`.
//   Reserved labels (`loop`, `if`, `let`) — every label in this
//        file is prefixed with the function's own 3-letter tag
//        (`fan_init_`, `fan_sd_`, `fan_rd_`, `fan_rt_`, `fan_ap_`,
//        `fan_h_`).
//   Fingerprint tag [u8; N] = len(string) + 1 exactly:
//        "FAN SET\0"      =  7 chars + NUL  =  8
//        "FAN READ\0"     =  8 chars + NUL  =  9
//        "FAN POLICY\0"   = 10 chars + NUL  = 11
//        "duty\0"         =  4 chars + NUL  =  5
//        "hz\0"           =  2 chars + NUL  =  3
//        "state\0"        =  5 chars + NUL  =  6
//   EC-error-band compare uses the ec.pdx idiom
//        `mov r11, 0xFFFFFF00; cmp rax, r11; jae ...` NOT
//        `cmp rax, 0xFFFFFF00` directly, because imm32 with bit 31
//        set would be sign-extended by CMP r/m64, imm32 and compare
//        against 0xFFFFFFFFFFFFFF00 instead of 0xFFFFFF00 (pdx-
//        encoder-pitfalls memory 2026-09-26).
//   `klog_s1_d2` v2 stack convention: caller places v2 at `[rsp+0]`
//        BEFORE the CALL (the wrapper reads it as `[rbp+16]` after
//        its own `push rbp`) — Wave 73 I7 regression memory records
//        the trap; thermal.pdx §K lands correct, this file inherits
//        the pattern.
//
// =============================================================================

module Fan = structure {

  // ==========================================================================
  // §A  Dispatch tag (driver layer)
  //
  // See §5 for why this does not collide with KIND_INTERRUPT_CAP_ALIAS
  // (a retired-alias reservation of the same numeric value).
  // ==========================================================================

  pub let KIND_FAN_DRV      : u64 = 0x40
  pub let KIND_FAN_DRV_BASE : u64 = 10          // = KIND_DEVICE

  // ==========================================================================
  // §B  EC offsets (ACPI 6.5 §13.2) — PLACEHOLDERS, see §1
  // ==========================================================================

  pub let FAN_PWM_DUTY          : u64 = 0x30    //  8-bit, 0..255
  pub let FAN_TACH_PERIOD_LO    : u64 = 0x32    // 16-bit LE (low)
  pub let FAN_TACH_PERIOD_HI    : u64 = 0x33    // 16-bit LE (high)
  pub let FAN_CRITICAL_OVERRIDE : u64 = 0x34    //  8-bit, bit 0 = force

  // ==========================================================================
  // §C  Policy duty table (see §3)
  // ==========================================================================

  pub let FAN_DUTY_OFF      : u64 = 0           // THM_STATE_NORMAL
  pub let FAN_DUTY_PASSIVE  : u64 = 128         // THM_STATE_PASSIVE  (50%)
  pub let FAN_DUTY_CRITICAL : u64 = 255         // THM_STATE_CRITICAL (max)
  pub let FAN_DUTY_MAX      : u64 = 255

  pub let FAN_CRIT_OVERRIDE_SET   : u64 = 1
  pub let FAN_CRIT_OVERRIDE_CLEAR : u64 = 0

  // ==========================================================================
  // §D  Thermal state mirror (see thermal.pdx §C)
  //
  // Local copies of THM_STATE_* so the ladder read in fan_apply_policy
  // does not need to cross-import.  Values match thermal.pdx by
  // construction; the follow-up slice may collapse the pair into one
  // import once the paideia-as import graph lands.
  // ==========================================================================

  pub let FAN_THM_STATE_NORMAL   : u64 = 0
  pub let FAN_THM_STATE_PASSIVE  : u64 = 1
  pub let FAN_THM_STATE_CRITICAL : u64 = 2

  // ==========================================================================
  // §E  Operation codes (cap_handler_fan dispatch)
  //
  // op 0 is reserved (INVOKE_OP_NULL per invoke.pdx) and is NOT mapped
  // to any fan entrypoint.  Five values are legal; anything else is
  // INVOKE_UNSUPPORTED.
  // ==========================================================================

  pub let FAN_OP_INIT          : u64 = 1
  pub let FAN_OP_SET_DUTY      : u64 = 2
  pub let FAN_OP_READ_DUTY     : u64 = 3
  pub let FAN_OP_READ_TACH_HZ  : u64 = 4
  pub let FAN_OP_APPLY_POLICY  : u64 = 5

  // ==========================================================================
  // §F  Return codes — band 0xFFFFFFF0..F4 (see §4)
  // ==========================================================================

  pub let FAN_OK                     : u64 = 0
  pub let FAN_ERR_EC_NOT_INIT        : u64 = 0xFFFFFFF0
  pub let FAN_ERR_BAD_DUTY           : u64 = 0xFFFFFFF1
  pub let FAN_ERR_TACH_STALL         : u64 = 0xFFFFFFF2
  pub let FAN_ERR_UNKNOWN_POLICY     : u64 = 0xFFFFFFF3
  pub let FAN_ERR_EC_WRITE_FAILED    : u64 = 0xFFFFFFF4

  // ==========================================================================
  // §G  Mutable state — one fan per machine
  //
  // The T14 G4 case ships one fan; a multi-fan laptop (never observed
  // on x86_64 — the specification permits several zones but the
  // field has not seen a dual-fan ultraportable) would generalise
  // `[u64; N]`.
  //
  //   _fan_inited          1 iff fan_init has been called
  //   _fan_last_duty       last duty value written OR read (0..255)
  //   _fan_last_period_us  last composed tach period (microseconds)
  //   _fan_last_hz         last computed tach hz
  //   _fan_last_state      last thermal state fan_apply_policy saw
  //   _fan_set_ct          successful fan_set_duty count
  //   _fan_read_ct         successful fan_read_duty count
  //   _fan_tach_ct         successful fan_read_tach_hz count
  //   _fan_policy_ct       successful fan_apply_policy count
  // ==========================================================================

  pub let mut _fan_inited         : u64 = 0
  pub let mut _fan_last_duty      : u64 = 0
  pub let mut _fan_last_period_us : u64 = 0
  pub let mut _fan_last_hz        : u64 = 0
  pub let mut _fan_last_state     : u64 = 0

  pub let mut _fan_set_ct         : u64 = 0
  pub let mut _fan_read_ct        : u64 = 0
  pub let mut _fan_tach_ct        : u64 = 0
  pub let mut _fan_policy_ct      : u64 = 0

  // ==========================================================================
  // §H  Fingerprint tags + keys  (single-line, len+1 sized)
  //
  //   FAN SET duty=<dec>
  //   FAN READ duty=<dec> hz=<dec>
  //   FAN POLICY state=<dec> duty=<dec>
  // ==========================================================================

  pub let fan_tag_set    : [u8; 8]  = "FAN SET\0"
  pub let fan_tag_read   : [u8; 9]  = "FAN READ\0"
  pub let fan_tag_policy : [u8; 11] = "FAN POLICY\0"

  pub let fan_k_duty  : [u8; 5] = "duty\0"
  pub let fan_k_hz    : [u8; 3] = "hz\0"
  pub let fan_k_state : [u8; 6] = "state\0"

  // ==========================================================================
  // §I  fan_init() -> u64
  //
  // Zero every mutable-state slot, gate on `ec_inited()`, flip the
  // inited latch, return FAN_OK.
  //
  // Returns FAN_ERR_EC_NOT_INIT (0xFFFFFFF0) if ec_inited() == 0.
  // The expected boot order (`src/kernel/boot/stage3.pdx`) is
  // ec_init() -> thermal_init() -> fan_init(); a reversed order is a
  // plumbing bug the error code names.
  //
  // No arguments.  SysV: no inputs.  Register plan: 3-push callee-save
  // prologue (rbx, r12, r13) aligns rsp%16==0 for the one nested
  // CALL (ec_inited).  Labels prefixed `fan_init_`.
  // ==========================================================================

  pub let fan_init : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: zero every mutable state slot (last-duty, last-period, last-hz, last-state, four counters), gate on ec_inited(), flip the inited latch, return FAN_OK. The gate is RAISED BEFORE the zero sequence so a reversed boot order (fan_init before ec_init) leaves the module in exactly the state it had at module load -- zero everywhere -- rather than half-zeroed, same discipline as battery.pdx §H. ec_inited is `@{}` capability-wise so fan_init's `@{boot}` is a strict superset. Returning FAN_ERR_EC_NOT_INIT with no other side effect is the honest shape: there is no 'partial init' to roll back. 9 zero stores reach every mutable slot in §G; _fan_inited is flipped LAST so a re-init call sees cleared counters first (same tester-grep discipline ec_init / battery_init / thermal_init all use). 3-push callee-save prologue (rbx, r12, r13) aligns rsp%16==0 for the ec_inited CALL. Labels prefixed `fan_init_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: EC must be initialised.
        call ec_inited;
        cmp rax, 0;
        je  fan_init_ec_not_ready;

        // --- Zero every mutable slot.
        xor rax, rax;
        mov [rip + _fan_last_duty],      rax;
        mov [rip + _fan_last_period_us], rax;
        mov [rip + _fan_last_hz],        rax;
        mov [rip + _fan_last_state],     rax;
        mov [rip + _fan_set_ct],         rax;
        mov [rip + _fan_read_ct],        rax;
        mov [rip + _fan_tach_ct],        rax;
        mov [rip + _fan_policy_ct],      rax;

        // --- Flip the inited latch (last).
        mov rax, 1;
        mov [rip + _fan_inited], rax;

        xor rax, rax;                        // FAN_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_init_ec_not_ready:
        mov rax, 0xFFFFFFF0;                 // FAN_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  fan_set_duty(duty) -> u64
  //
  // Validate duty <= 255, write it to the EC at FAN_PWM_DUTY (0x30),
  // stash in _fan_last_duty, bump _fan_set_ct, emit the SET
  // fingerprint, return FAN_OK.
  //
  // Gates: (1) fan_inited, (2) duty <= 255 (BAD_DUTY), (3) ec write
  // failure (EC_WRITE_FAILED).
  //
  // SysV: rdi = duty.  Register plan: 3-push callee-save prologue
  // (rbx, r12 = duty, r13 scratch).  After prologue rsp%16==0,
  // aligned for the ec_write_u8 and klog_s1_d1 CALLs.  Labels prefixed
  // `fan_sd_`.
  // ==========================================================================

  pub let fan_set_duty : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (duty: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: EC-direct PWM-duty write with range gate and fingerprint emission. duty range check is `cmp r12, 255; ja fan_sd_bad_duty` -- unsigned above-255 is the only failure mode because the EC register is 8-bit; a wider value would silently truncate without this gate. r12 holds duty across the ec_write_u8 CALL (SysV callee-save). The ec_write_u8 refusal check uses the ec.pdx idiom `mov r11, 0xFFFFFF00; cmp rax, r11; jae ...` NOT `cmp rax, 0xFFFFFF00` directly (pdx-encoder-pitfalls 2026-09-26 — direct form sign-extends imm32 with bit 31 set). Fingerprint emits REQUESTED duty, not a read-back: the follow-up slice adds a settle-interval readback after the write; today's skeleton emits what we told the EC to do. 3-push prologue aligns rsp%16==0 for both nested CALLs. Labels prefixed `fan_sd_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                        // duty

        // --- Gate: fan module inited.
        mov rax, [rip + _fan_inited];
        cmp rax, 0;
        je  fan_sd_notinit;

        // --- Gate: duty <= 255 (unsigned).
        cmp r12, 255;
        ja  fan_sd_bad_duty;

        // --- Write duty byte to EC.
        mov rdi, 0x30;                       // FAN_PWM_DUTY
        mov rsi, r12;
        call ec_write_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae fan_sd_ec_err;

        // --- Stash + bump counter.
        mov [rip + _fan_last_duty], r12;
        mov rax, [rip + _fan_set_ct];
        add rax, 1;
        mov [rip + _fan_set_ct], rax;

        // --- Emit fingerprint: FAN SET duty=<dec>
        //
        // klog_s1_d1 signature:
        //   rdi = level, rsi = subsys_ptr, rdx = tag_ptr,
        //   rcx = k1_ptr, r8 = v1
        //
        // Zero stack args.  3 pushes leave rsp%16==0 so CALL is
        // aligned without any adjustment.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + fan_tag_set];
        lea rcx, [rip + fan_k_duty];
        mov r8,  r12;                        // v1 = duty
        call klog_s1_d1;

        xor rax, rax;                        // FAN_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_sd_notinit:
        mov rax, 0xFFFFFFF0;                 // FAN_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_sd_bad_duty:
        mov rax, 0xFFFFFFF1;                 // FAN_ERR_BAD_DUTY
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_sd_ec_err:
        mov rax, 0xFFFFFFF4;                 // FAN_ERR_EC_WRITE_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  fan_read_tach_hz() -> u64
  //
  // Read the 16-bit tach period as two consecutive EC bytes (lo at
  // FAN_TACH_PERIOD_LO=0x32, hi at ...HI=0x33, little-endian),
  // compose into microseconds, divide 1_000_000 / period_us to yield
  // hz, stash in _fan_last_hz, bump _fan_tach_ct, return hz.
  //
  // Gates: (1) fan_inited, (2) ec_read refusal, (3) period_us == 0
  // (TACH_STALL).
  //
  // No fingerprint of its own — the composite `fan_read_duty` call
  // emits the SET+READ frame with both duty and hz, and
  // `fan_apply_policy` does the same for its state+duty frame.
  // Emitting a per-tach fingerprint would double the on-wire chatter
  // for no new information.
  //
  // SysV: no inputs.  Register plan: 3-push callee-save prologue
  // (rbx, r12 = period scratch, r13 scratch).  Aligned rsp%16==0 for
  // both ec_read_u8 CALLs.  Labels prefixed `fan_rt_`.
  // ==========================================================================

  pub let fan_read_tach_hz : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: compose a 16-bit tach period from two EC bytes (lo at 0x32, hi at 0x33, little-endian), guard period==0 as TACH_STALL (dead-fan / open-sense-wire — refusing instead of divide-by-zero names the physical condition rather than the arithmetic one), compute hz = 1_000_000 / period_us via `div r64` after `xor rdx, rdx` (unsigned, `idiv` not shipped in paideia-as v0.36.82 — same shape kelvin_tenths_to_celsius_whole in thermal.pdx §I uses). The compose idiom is `mov r12, lo; shl rax(hi), 8; or r12, rax` matching bat_read_u16 in battery.pdx §I. EC-error-band check `mov r11, 0xFFFFFF00; cmp rax, r11; jae ...` NOT `cmp rax, 0xFFFFFF00` directly (sign-extend bug, pdx-encoder-pitfalls 2026-09-26). 3-push prologue aligns rsp%16==0 for both ec_read_u8 CALLs. Labels prefixed `fan_rt_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: fan module inited.
        mov rax, [rip + _fan_inited];
        cmp rax, 0;
        je  fan_rt_notinit;

        // --- Read tach period low byte.
        mov rdi, 0x32;                       // FAN_TACH_PERIOD_LO
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae fan_rt_ec_err;
        mov r12, rax;                        // r12 = lo

        // --- Read tach period high byte.
        mov rdi, 0x33;                       // FAN_TACH_PERIOD_HI
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae fan_rt_ec_err;

        // --- Compose: period_us = (hi << 8) | lo.
        shl rax, 8;
        or  r12, rax;                        // r12 = period_us
        mov [rip + _fan_last_period_us], r12;

        // --- Guard: period_us == 0 is a stall.
        cmp r12, 0;
        je  fan_rt_stall;

        // --- hz = 1_000_000 / period_us.
        //
        // paideia-as v0.36.82 ships `div r64` only (no `idiv`).
        // Zero-extend dividend: `xor rdx, rdx; mov rax, 1000000;
        // div r12`.  Quotient lands in rax, remainder in rdx; we
        // discard the remainder.
        mov rax, 1000000;
        xor rdx, rdx;
        div r12;

        // --- Stash hz + bump counter.
        mov [rip + _fan_last_hz], rax;
        mov r13, rax;                        // save hz across the store
        mov rax, [rip + _fan_tach_ct];
        add rax, 1;
        mov [rip + _fan_tach_ct], rax;

        // --- Return hz.
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_rt_notinit:
        mov rax, 0xFFFFFFF0;                 // FAN_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_rt_stall:
        mov rax, 0xFFFFFFF2;                 // FAN_ERR_TACH_STALL
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_rt_ec_err:
        mov rax, 0xFFFFFFF4;                 // FAN_ERR_EC_WRITE_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  fan_read_duty() -> u64
  //
  // Read the current duty byte from the EC at FAN_PWM_DUTY (0x30),
  // call fan_read_tach_hz for the current rotational speed, emit the
  // READ fingerprint (duty + hz), bump _fan_read_ct, return the duty
  // byte.
  //
  // Gates: (1) fan_inited, (2) ec_read_u8 refusal (EC_WRITE_FAILED --
  // reusing the write code because the band discipline is per-driver,
  // not per-direction).  A tach-side refusal from fan_read_tach_hz is
  // propagated verbatim (the stall code 0xFFFFFFF2 is in the fan
  // band; the EC-side code 0xFFFFFFF4 also is).
  //
  // SysV: no inputs.  Register plan: 3-push callee-save prologue
  // (rbx, r12 = duty, r13 = hz).  Aligned rsp%16==0 for the ec_read_u8
  // CALL, the fan_read_tach_hz CALL and the klog_s1_d2 CALL (which
  // takes one stack arg: v2=hz via `sub rsp,8` align + `push r13`).
  // Labels prefixed `fan_rd_`.
  // ==========================================================================

  pub let fan_read_duty : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: composite READ frame -- one duty byte via ec_read_u8 at 0x30, one hz via fan_read_tach_hz. The fingerprint emits BOTH fields in one line because a tester correlating a policy decision with its actuation reads duty-and-hz together as one observation; splitting them into two frames would force the tester to merge them by sample index. hz is PROPAGATED from fan_read_tach_hz verbatim: a TACH_STALL (0xFFFFFFF2) refusal here means the fan is dead and the entire read frame refuses, not just the hz field. The error-band check on fan_read_tach_hz's return uses the standard idiom `mov r11, 0xFFFFFF00; cmp rax, r11; jae ...` even though the fan-band values (0xFFFFFFF0..F4) are above the EC band -- `jae` catches both bands since they share the top 0xFFFFFF prefix. klog_s1_d2 stack arg v2 (=hz) is placed via `sub rsp, 8; push r13` -- rsp%16==0 at CALL per the pdx-encoder-pitfalls memory 2026-09-26's v2-at-[rsp+0] convention. 3-push prologue aligns rsp%16==0. Labels prefixed `fan_rd_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: fan module inited.
        mov rax, [rip + _fan_inited];
        cmp rax, 0;
        je  fan_rd_notinit;

        // --- Read duty byte at FAN_PWM_DUTY (0x30).
        mov rdi, 0x30;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae fan_rd_ec_err;
        mov r12, rax;                        // r12 = duty
        mov [rip + _fan_last_duty], r12;

        // --- Compute current tach hz.
        call fan_read_tach_hz;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae fan_rd_propagate;
        mov r13, rax;                        // r13 = hz

        // --- Bump counter.
        mov rax, [rip + _fan_read_ct];
        add rax, 1;
        mov [rip + _fan_read_ct], rax;

        // --- Emit fingerprint: FAN READ duty=<dec> hz=<dec>
        //
        // klog_s1_d2 signature (per wrappers.pdx §klog_s1_d2):
        //   rdi = level, rsi = subsys_ptr, rdx = tag_ptr,
        //   rcx = k1_ptr, r8 = v1, r9 = k2_ptr,
        //   [rsp+0] = v2 before CALL  (= [rbp+16] inside wrapper)
        //
        // Alignment: 3-push prologue leaves rsp%16==0.  `sub rsp, 8`
        // lands rsp%16==8, `push r13` lands rsp%16==0 for CALL, and
        // `add rsp, 16` after reclaims both.
        sub rsp, 8;                          // align-for-push
        push r13;                            // [rsp+0] = v2 = hz

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + fan_tag_read];
        lea rcx, [rip + fan_k_duty];
        mov r8,  r12;                        // v1 = duty
        lea r9,  [rip + fan_k_hz];
        call klog_s1_d2;
        add rsp, 16;                         // reclaim align + push

        // --- Return duty.
        mov rax, r12;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_rd_notinit:
        mov rax, 0xFFFFFFF0;                 // FAN_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_rd_ec_err:
        mov rax, 0xFFFFFFF4;                 // FAN_ERR_EC_WRITE_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_rd_propagate:
        // Propagate the fan_read_tach_hz refusal unchanged.  rax
        // already holds the fan-band code.
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  fan_apply_policy() -> u64
  //
  // Read the last-evaluated thermal state via `thermal_last_state()`
  // (Wave 59 D10), map to a duty value per the §3 table, write duty
  // via fan_set_duty, write the critical-override bit via
  // ec_write_u8 to FAN_CRITICAL_OVERRIDE (0x34), emit the POLICY
  // fingerprint (state + duty), bump _fan_policy_ct, return FAN_OK.
  //
  // Gates: (1) fan_inited, (2) state in {0,1,2} (UNKNOWN_POLICY),
  // (3) propagate fan_set_duty refusal, (4) propagate ec_write_u8
  // refusal on the override byte.
  //
  // SysV: no inputs.  Register plan: 3-push callee-save prologue
  // (rbx, r12 = state, r13 = duty).  Aligned rsp%16==0 for every
  // nested CALL (thermal_last_state, fan_set_duty, ec_write_u8,
  // klog_s1_d2).  klog_s1_d2 takes v2 (=duty) on the stack via the
  // standard `sub rsp,8; push r13` idiom.  Labels prefixed `fan_ap_`.
  // ==========================================================================

  pub let fan_apply_policy : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: read D10 thermal state via thermal_last_state(), map to a duty per the §3 table, write duty via fan_set_duty, write the critical-override bit via ec_write_u8 at 0x34, emit `FAN POLICY state=<dec> duty=<dec>`, bump counter, return FAN_OK. The policy->duty mapping is encoded as a cmp-chain over {0,1,2} rather than a jump table because three live values occupy less bytecode as a chain than a 256-slot table and the branch-mispredict cost is irrelevant on a path that fires at most once per TSP sample tick. Unknown state (any value > 2) returns FAN_ERR_UNKNOWN_POLICY -- a plumbing bug in D10's _thm_state slot, not a hardware condition. CRITICAL state always sets the override bit; NORMAL and PASSIVE always clear it, so the override write happens UNCONDITIONALLY after the duty write (not only on CRITICAL) -- otherwise a transition out of CRITICAL would leave the override latched and the fan stuck at max. fan_set_duty's refusal is propagated verbatim (same error band). ec_write_u8's refusal on the override byte is remapped to FAN_ERR_EC_WRITE_FAILED. Fingerprint emits the REQUESTED duty (what the policy chose), not a readback; the follow-up slice adds a settle-interval readback. 3-push prologue aligns rsp%16==0; klog_s1_d2's v2 (=duty) placed via `sub rsp, 8; push r13`. Labels prefixed `fan_ap_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: fan module inited.
        mov rax, [rip + _fan_inited];
        cmp rax, 0;
        je  fan_ap_notinit;

        // --- Read the last-evaluated thermal state.
        call thermal_last_state;
        mov r12, rax;                        // r12 = state
        mov [rip + _fan_last_state], r12;

        // --- Map state -> duty + override.
        cmp r12, 0;                          // FAN_THM_STATE_NORMAL
        je  fan_ap_normal;
        cmp r12, 1;                          // FAN_THM_STATE_PASSIVE
        je  fan_ap_passive;
        cmp r12, 2;                          // FAN_THM_STATE_CRITICAL
        je  fan_ap_critical;

        // Anything else is a D10 plumbing bug.
        mov rax, 0xFFFFFFF3;                 // FAN_ERR_UNKNOWN_POLICY
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_ap_normal:
        mov r13, 0;                          // FAN_DUTY_OFF
        mov rbx, 0;                          // FAN_CRIT_OVERRIDE_CLEAR
        jmp fan_ap_commit;

      fan_ap_passive:
        mov r13, 128;                        // FAN_DUTY_PASSIVE
        mov rbx, 0;                          // FAN_CRIT_OVERRIDE_CLEAR
        jmp fan_ap_commit;

      fan_ap_critical:
        mov r13, 255;                        // FAN_DUTY_CRITICAL
        mov rbx, 1;                          // FAN_CRIT_OVERRIDE_SET
        jmp fan_ap_commit;

      fan_ap_commit:
        // --- Write duty via fan_set_duty.
        mov rdi, r13;
        call fan_set_duty;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae fan_ap_propagate_duty;

        // --- Write critical-override bit (always, so a state
        //      transition out of CRITICAL clears a latched override).
        mov rdi, 0x34;                       // FAN_CRITICAL_OVERRIDE
        mov rsi, rbx;
        call ec_write_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae fan_ap_ec_err;

        // --- Bump counter.
        mov rax, [rip + _fan_policy_ct];
        add rax, 1;
        mov [rip + _fan_policy_ct], rax;

        // --- Emit fingerprint: FAN POLICY state=<dec> duty=<dec>
        //
        // klog_s1_d2 signature (same as fan_read_duty §L).
        //
        // Alignment: 3-push prologue leaves rsp%16==0.  `sub rsp, 8`
        // lands rsp%16==8, `push r13` (duty) lands rsp%16==0 for
        // CALL, `add rsp, 16` reclaims both.
        sub rsp, 8;                          // align-for-push
        push r13;                            // [rsp+0] = v2 = duty

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + fan_tag_policy];
        lea rcx, [rip + fan_k_state];
        mov r8,  r12;                        // v1 = state
        lea r9,  [rip + fan_k_duty];
        call klog_s1_d2;
        add rsp, 16;                         // reclaim align + push

        xor rax, rax;                        // FAN_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_ap_notinit:
        mov rax, 0xFFFFFFF0;                 // FAN_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_ap_propagate_duty:
        // Propagate fan_set_duty refusal (fan-band code already in rax).
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_ap_ec_err:
        mov rax, 0xFFFFFFF4;                 // FAN_ERR_EC_WRITE_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  cap_handler_fan(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch stub the KIND_FAN_DRV (0x40) arm in cap/invoke.pdx
  // calls.  Routes by op_arg to one of {fan_init, fan_set_duty,
  // fan_read_duty, fan_read_tach_hz, fan_apply_policy}; anything
  // else returns INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC).
  //
  // Rights and target_ptr are IGNORED at skeleton stage; the follow-
  // up slice adds a rights gate (R_FAN_READ / R_FAN_WRITE /
  // R_FAN_POLICY) and a target_ptr indirection for an N-fan system.
  // The signature carries both so that slice does not need to
  // re-plumb the ABI.
  //
  // fan_set_duty is the only leaf that needs an argument (the duty
  // byte).  The dispatcher reads it from `op_arg >> 8` so op_arg's
  // low byte names the op and the next byte carries the duty.  This
  // is the same encoding ec.pdx uses for EC_HANDLER_OP_WRITE.  The
  // follow-up slice may widen it to a full packed-args word if
  // additional ops take arguments.
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg.  Register plan:
  // 3-push callee-save prologue (rbx = op_arg, r12 = op code, r13
  // scratch).  Labels prefixed `fan_h_`.
  // ==========================================================================

  pub let cap_handler_fan : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: cap-table dispatch stub. The cmp-chain over {1..5} is one branch per legal op (not a jump table) because five live values occupy less bytecode as a chain than a 256-slot table and the branch-mispredict cost is irrelevant on a path that fires at most once per TSP sample tick. fan_set_duty's duty byte is unpacked from `op_arg >> 8` (op_arg's low byte names the op; the next byte carries the duty) -- same encoding ec.pdx's EC_HANDLER_OP_WRITE uses, so a follow-up slice that mints a KIND_FAN_DRV capability does not need to re-plumb the op encoding. The op is masked to the low byte via `and r12, 0xFF` on entry so a caller that leaves garbage in the high bytes of op_arg does not accidentally match. Unknown op returns INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC), not FAN_ERR_UNKNOWN_POLICY -- the latter names a thermal-state-plumbing bug, this names a cap-dispatch bug. Rights and target_ptr are ACCEPTED but IGNORED at skeleton stage. 3-push prologue aligns rsp%16==0 for every nested CALL. Labels prefixed `fan_h_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdx;                        // rbx = op_arg (preserve)
        mov r12, rdx;                        // r12 = op
        and r12, 0xFF;                       // mask to low byte

        // --- Opcode dispatch.
        cmp r12, 1;                          // FAN_OP_INIT
        je  fan_h_init;
        cmp r12, 2;                          // FAN_OP_SET_DUTY
        je  fan_h_set_duty;
        cmp r12, 3;                          // FAN_OP_READ_DUTY
        je  fan_h_read_duty;
        cmp r12, 4;                          // FAN_OP_READ_TACH_HZ
        je  fan_h_read_tach;
        cmp r12, 5;                          // FAN_OP_APPLY_POLICY
        je  fan_h_apply_policy;

        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_h_init:
        call fan_init;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_h_set_duty:
        // Unpack duty from op_arg >> 8.
        mov rdi, rbx;
        shr rdi, 8;
        call fan_set_duty;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_h_read_duty:
        call fan_read_duty;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_h_read_tach:
        call fan_read_tach_hz;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fan_h_apply_policy:
        call fan_apply_policy;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  Stat getters — single-load leaves for witness callers
  //
  // Parallel to battery.pdx and thermal.pdx getter sets.  A boot
  // witness can assert `fan_inited()==1 AND fan_policy_count() > 0`
  // after a smoke test that drives cap_handler_fan a known number of
  // times.
  // ==========================================================================

  pub let fan_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_inited. Leaf.",
      block: { mov rax, [rip + _fan_inited]; ret }
    }

  pub let fan_last_duty : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_last_duty -- the duty byte last written by fan_set_duty, last read by fan_read_duty, or last chosen by fan_apply_policy. Leaf.",
      block: { mov rax, [rip + _fan_last_duty]; ret }
    }

  pub let fan_last_period_us : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_last_period_us -- the composed tach period from the most recent fan_read_tach_hz. Zero until the first successful read. Leaf.",
      block: { mov rax, [rip + _fan_last_period_us]; ret }
    }

  pub let fan_last_hz : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_last_hz -- the computed tach frequency from the most recent fan_read_tach_hz. Zero until the first successful read. Leaf.",
      block: { mov rax, [rip + _fan_last_hz]; ret }
    }

  pub let fan_last_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_last_state -- the thermal state value fan_apply_policy last saw from thermal_last_state(). Zero until the first fan_apply_policy call. Leaf.",
      block: { mov rax, [rip + _fan_last_state]; ret }
    }

  pub let fan_set_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_set_ct. Bumped once per successful fan_set_duty. Leaf.",
      block: { mov rax, [rip + _fan_set_ct]; ret }
    }

  pub let fan_read_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_read_ct. Bumped once per successful fan_read_duty. Leaf.",
      block: { mov rax, [rip + _fan_read_ct]; ret }
    }

  pub let fan_tach_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_tach_ct. Bumped once per successful fan_read_tach_hz. Leaf.",
      block: { mov rax, [rip + _fan_tach_ct]; ret }
    }

  pub let fan_policy_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2528 (Wave 59 D11) skeleton: single-load getter for _fan_policy_ct. Bumped once per successful fan_apply_policy. Leaf.",
      block: { mov rax, [rip + _fan_policy_ct]; ret }
    }

}
