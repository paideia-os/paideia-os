// src/kernel/core/drivers/acpi/thermal.pdx — Wave 59 D10 (paideia-os#2527)
//
// ACPI thermal-zone probe + passive-cooling policy SKELETON. Lays
// down the ACPI 6.5 §11 Thermal-Zone surface area that every T14 G4
// warm-handling path eventually reaches:
//
//   * freezes the EC-OpRegion offset family (`_CRT`, `_HOT`, `_PSV`,
//     `_TC1`, `_TC2`, `_TSP`, and the 16-bit `_TMP` byte pair) as
//     PLACEHOLDER constants — the real T14 G4 DSDT offsets will
//     substitute these when the AML binding slice lands,
//   * freezes the three policy-state codes (NORMAL=0, PASSIVE=1,
//     CRITICAL=2) and emits the policy fingerprint on evaluate so a
//     boot witness can see the state latch fire without an
//     actuator wired up,
//   * freezes the error band 0xFFFFFFD6..DA so a skeleton refusal
//     and a real-body refusal share a code (§3),
//   * freezes the public entrypoints the OpRegion / kind dispatchers
//     will bind to (`thermal_init`, `thermal_read_tmp`,
//     `thermal_read_trip_points`, `thermal_evaluate_policy`,
//     `cap_handler_thermal`),
//   * emits the Wave 59 D10 fingerprint lines (TMP, TRIP, POLICY)
//     via `klog_s1_d2` / `klog_s1_d3` / `klog_s1_d1` so a boot
//     witness can SEE the seam fire even before the real-body
//     slice lands,
//   * confines the thermal-zone mutable state to this object (one
//     thermal zone per machine at skeleton stage — ACPI 6.5 §11.4
//     permits several, and the real body will generalise to
//     `[u64; THM_ZONE_MAX]` when the ring-3 DSDT walker enumerates
//     more than one).
//
// -----------------------------------------------------------------------------
// §0  WHY THIS FILE IS NOT ec.pdx
// -----------------------------------------------------------------------------
//
// `src/kernel/core/drivers/acpi/ec.pdx` (D8, Wave 59, paideia-os#2525)
// owns the SMBus-style FSM that services every ring-0 EC byte read.
// This file is the CONSUMER of that FSM — a thermal zone is one of
// several device-flavoured surfaces that project onto the EC's
// 256-byte space (battery, lid switch and fan tach are the others,
// landing in parallel D9/D11). Keeping the FSM separate from each
// consumer is deliberate: a reviewer debugging a thermal reading can
// re-read a trip point without being pulled through the EC port-I/O
// handshake, and a reviewer debugging a stuck EC can re-read any
// offset without being pulled through a per-domain decoder.
//
// Dispatch convention: `thermal_read_tmp` calls `ec_read_u8(offset)`
// twice (low byte then high byte, little-endian) and composes the
// 16-bit deci-Kelvin value. The skeleton re-raises any 0xFFFFFF-
// prefixed EC refusal as `THERMAL_ERR_EC_READ_FAIL` rather than
// leaking the EC's own error band through — a consumer that saw
// `EC_ERR_RESET_REQ` instead of `THERMAL_ERR_EC_READ_FAIL` would
// have to understand two error vocabularies to debug one thermal
// read.
//
// -----------------------------------------------------------------------------
// §1  EC OFFSETS ARE PLACEHOLDERS, AND WHY
// -----------------------------------------------------------------------------
//
// The six EC offsets below (`THM_EC_OFF_*`) are PLACEHOLDERS, not the
// T14 G4's real DSDT-declared addresses. The real offsets are
// discovered by the ring-3 AML walker (D5, paideia-os#2522)
// evaluating `_SB.PCI0.LPCB.EC0.TZ0._CRT`/`_HOT`/`_PSV`/`_TC1`/
// `_TC2`/`_TSP`/`_TMP` and pushing the resolved integer-constant
// bytes into THIS module's offset slots at wire-up time (the
// slot-install path lands with the real-body slice).
//
// The skeleton HAS to pick numbers. Three constraints shape the
// choice:
//
//   1. `_CRT`/`_HOT`/`_PSV` are 16-bit deci-Kelvin values, so they
//      occupy TWO consecutive bytes each.  Offsets 0x00..0x05 are
//      the natural landing.
//   2. `_TC1`/`_TC2` are 8-bit coefficients (ACPI 6.5 §11.4.11-12),
//      so they occupy one byte each at 0x06 and 0x07.
//   3. `_TSP` (sampling period, tenths of a second) is 8-bit at
//      0x08.
//
// `_TMP` the reading does NOT appear in that 0x00..0x08 trip-point
// block on any shipping laptop (the EC usually exposes the temp
// register separately, often at an EC-vendor-specific offset). The
// skeleton places `_TMP` at offsets 0x10..0x11, leaving a visible
// gap between the trip-point block and the reading register so a
// reviewer scanning the EC map does not conflate the two.
//
// The real-body slice replaces every one of these numbers with the
// AML-walker-resolved value and the module header no longer calls
// them placeholders. Until then, the fingerprint output carries the
// placeholder arithmetic, which is honest in the way a skeleton
// should be: a tester seeing `t_K10=2732` in a run that could not
// possibly have read the real EC knows exactly what happened.
//
// -----------------------------------------------------------------------------
// §2  TEMPERATURE UNIT — TENTHS OF A KELVIN, CONVERSION ON THE EDGE ONLY
// -----------------------------------------------------------------------------
//
// ACPI 6.5 §11.4.3 reports every temperature — `_TMP`, `_CRT`,
// `_HOT`, `_PSV` — in TENTHS OF A KELVIN. 3000 is 300.0 K
// ≈ 26.85 °C. This module stores every temperature in deci-Kelvin,
// compares every pair of temperatures in deci-Kelvin, and converts
// to Celsius IN ONE PLACE — the helper `kelvin_tenths_to_celsius_
// whole`, called by `thermal_read_tmp` purely for the fingerprint
// value. The policy evaluator never converts; it compares `_TMP`
// against `_PSV`/`_CRT` in deci-Kelvin where a unit mismatch cannot
// hide.
//
// The capability-layer file `cap/kind_thermal_zone.pdx` imposes the
// same discipline for the same reason (that file's §0): the two
// most dangerous failures a thermal subsystem can ship are a `_CRT`
// that is below every plausible reading (shuts down at boot) and a
// `_CRT` that is above every plausible reading (never fires). Both
// are unit-conversion failures.
//
// `kelvin_tenths_to_celsius_whole(k10) -> celsius_signed`:
//
//   * k10 >= 2732  ->  celsius = (k10 - 2732) / 10   (unsigned div)
//   * k10 <  2732  ->  celsius = -((2732 - k10) / 10) (2's complement)
//
// The signed return supports the cold-storage case (k10 < 2732
// means sub-zero Celsius) without introducing a signed-division
// opcode, since paideia-as v0.36.82 ships `div` but not `idiv`
// (confirmed by `grep -rn '\bidiv\b' src/kernel/`, 2026-10-10).
// The real-body slice lands `idiv` support alongside its first user
// if one needs it; the branch split here is sufficient for the
// skeleton.
//
// -----------------------------------------------------------------------------
// §3  RETURN CODES — band 0xFFFFFFD6..0xFFFFFFDA
// -----------------------------------------------------------------------------
//
// Reserved by paideia-os#2527 for the thermal-zone driver. Disjoint
// from:
//
//   EC_ERR_*          (0xFFFFFFC5..CA, drivers/acpi/ec.pdx)
//   KIND_FIRMWARE_BLOB_* (0xFFFFFF??, cap/kind_firmware_blob.pdx)
//   LPSS_I2C_*        (0xFFFFFF40..5F)
//   LPG_D7_*          (0xFFFFFE70..7F)
//   THERMAL_* (CAP)   (0xFFFFFE3?,  cap/kind_thermal_zone.pdx; see
//                      §4 of this file for the two-vocabulary split)
//
//   0xFFFFFFD6  THERMAL_ERR_EC_NOT_INITED
//                       — a thermal_read_* reached ec_read_u8 before
//                         ec_init had latched the EC. Returned
//                         instead of the EC's own EC_ERR_UNKNOWN so
//                         a consumer can tell "my thermal read
//                         failed because the EC was never ready"
//                         from "my thermal read failed because the
//                         EC gave up on this byte".
//   0xFFFFFFD7  THERMAL_ERR_NO_ZONE
//                       — a thermal_read_* was called before
//                         thermal_init.  The caller must call
//                         thermal_init first; the skeleton does not
//                         auto-init.
//   0xFFFFFFD8  THERMAL_ERR_BAD_TRIP
//                       — reserved for the real-body slice: an
//                         installed trip point was outside the
//                         plausible deci-Kelvin band (THERMAL_DK_MIN
//                         ..MAX from cap/kind_thermal_zone.pdx §4).
//                         Present at skeleton stage so the real
//                         body lands without re-numbering.
//   0xFFFFFFD9  THERMAL_ERR_EC_READ_FAIL
//                       — ec_read_u8 refused with any 0xFFFFFFC5..CA
//                         code.  Collapsed into one thermal code
//                         because a thermal consumer debugging a
//                         read does not need the EC's phase break-
//                         down; a boot witness can grep the ec_read
//                         fingerprint for the underlying EC phase.
//   0xFFFFFFDA  THERMAL_ERR_DEAD_ZONE
//                       — thermal_evaluate_policy ran against a
//                         zone whose trip points were never
//                         installed (`_thm_crt_k10 == 0`).  A policy
//                         evaluation with no critical threshold
//                         behind it is a boot-time programming bug,
//                         not a hardware state; the refusal names
//                         the bug rather than silently defaulting
//                         to NORMAL.
//
// -----------------------------------------------------------------------------
// §4  TWO VOCABULARIES — DRIVER (0x3E, THIS FILE) AND AUTHORITY (0x157)
// -----------------------------------------------------------------------------
//
// `cap/kind_thermal_zone.pdx` already defines `KIND_THERMAL_ZONE =
// 0x157` as the AUTHORITY-layer kind: the capability a ring-3
// supervisor holds to be told which side of a trip point a reading
// falls on. That kind's dispatch arm is at cap/invoke.pdx:0x157 and
// its handler is `cap_handler_thermal_zone`.
//
// This file reserves a DIFFERENT kind, `KIND_THERMAL_ZONE_DRV =
// 0x3E`, for the DRIVER-layer dispatch — the direct path a ring-0
// kernel-space caller takes to drive the hardware probe + policy
// evaluation. The two coexist for the same reason KIND_BLKDEV (0x42)
// and the per-controller derived kinds (KIND_AHCI_PORT 0x19B,
// KIND_NVME_NAMESPACE etc.) coexist in cap/invoke.pdx: one surface
// per role, dispatched by full-u64 kind tag.
//
// Grep audit (2026-10-10, pre-landing):
//   `grep -rE '\b0x3[DdEe]\b' src/kernel/core/cap/`  returned ZERO
//   hits for either 0x3D or 0x3E.  D9 Battery (paideia-os#2526)
//   dispatched in the SAME wave claims 0x3D, this file claims 0x3E;
//   see the Wave 59 D10 handback.
//
// -----------------------------------------------------------------------------
// §5  POLICY — PSV AND CRT ONLY AT SKELETON STAGE
// -----------------------------------------------------------------------------
//
// ACPI 6.5 §11.6.1 defines the passive-cooling equation
//
//   DP[k] = _TC1 * (T[k] - T[k-1]) + _TC2 * (T[k] - _PSV)
//
// as the amount by which the OS should throttle the CPU P-state on
// each thermal sample.  The real-body slice evaluates this when the
// zone is in PASSIVE and feeds DP[k] into the HWP driver.
//
// The skeleton evaluates a simpler two-threshold ladder:
//
//   _TMP >= _CRT   ->  state = THM_STATE_CRITICAL  (2)
//   _TMP >= _PSV   ->  state = THM_STATE_PASSIVE   (1)
//   otherwise      ->  state = THM_STATE_NORMAL    (0)
//
// `_TC1`/`_TC2`/`_TSP` are READ by `thermal_read_trip_points` and
// stashed in `_thm_tc1`/`_thm_tc2`/`_thm_tsp`, so the real-body
// slice has the coefficients ready when it wires in the DP[k]
// equation. `_HOT` is READ and stashed in `_thm_hot_k10` and
// stays unused in the ladder — this kernel cannot hibernate, same
// disposition as `cap/kind_thermal_zone.pdx` §1.  A stored value a
// later reader could believe is wired is itself a bug surface, so
// the real-body slice may remove `_HOT` entirely; the skeleton
// keeps it so the fingerprint carries three fields (`CRT`, `HOT`,
// `PSV`) matching the task spec.
//
// `_PSL` (passive-cooling CPU list) is NOT read at skeleton stage.
// The field is a reference-list of processor objects, not a
// deci-Kelvin trip point, and reading it meaningfully requires the
// ring-3 AML walker to resolve the referenced object paths. The
// real-body slice lands that path.
//
// Actuation (feeding DP[k] into HWP) is DEFERRED. The skeleton
// emits the policy state as a fingerprint and does not touch any
// MSR or CPU P-state register. D11 Fan PWM (next wave) and the
// HWP driver are the actuators.
//
// -----------------------------------------------------------------------------
// §6  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   G1 — this skeleton emits no port I/O (all EC reads delegate to
//        ec_read_u8); the real body inherits ec.pdx's `in_b` /
//        `out_b` posture.
//   G4 — every compare is on a full 64-bit register; no `cmp al,
//        imm`.
//   No `test rN, rN` — zero-equality uses `cmp rN, 0`.
//   No `and r, imm64` — every mask here (0xFF) fits imm32.
//   No two-operand `imul r, imm` — the skeleton has no multiplies;
//        the real-body DP[k] equation lands with its first user.
//   Multiline `pub let x = "..."` strings — forbidden; every tag
//        below is one line.
//   Fingerprint tag [u8; N] = len(string) + 1 exactly: "THERMAL
//        TMP\0" is 11 chars + 1 null = 12, "THERMAL TRIP\0" is 12
//        + 1 = 13, "THERMAL POLICY\0" is 14 + 1 = 15.
//   Module basename match — `thermal.pdx` → `module Thermal`.
//   Reserved labels (`loop`, `if`, `let`) — every label in this
//        file is prefixed with the function's own 3-letter tag
//        (`thm_init_`, `thm_rt_`, `thm_rtp_`, `thm_ep_`, `thm_ch_`,
//        `thm_ktc_`), per the pdx-encoder-pitfalls memory
//        2026-09-26.
//   `klog_s1_x2` / `klog_s1_d2` v2 is at [rsp+0] from the caller's
//        view before CALL (i.e. the pushed value lands at [rsp+0];
//        the wrapper reads it as [rbp+16] after its own push rbp),
//        per the pdx-encoder-pitfalls memory 2026-09-26 — the Wave
//        73 I7 regression that memory records lands correct here
//        by construction.
//
// =============================================================================

module Thermal = structure {

  // ==========================================================================
  // §A  Dispatch tag (driver layer)
  //
  // See §4 for why this is distinct from the 0x157 authority-layer
  // KIND_THERMAL_ZONE already in cap/kind_thermal_zone.pdx.
  // ==========================================================================

  pub let KIND_THERMAL_ZONE_DRV      : u64 = 0x3E
  pub let KIND_THERMAL_ZONE_DRV_BASE : u64 = 10         // = KIND_DEVICE

  // ==========================================================================
  // §B  EC offsets (ACPI 6.5 §11.4) — PLACEHOLDERS, see §1
  // ==========================================================================

  pub let THM_EC_OFF_CRT    : u64 = 0x00                // 16-bit deci-K
  pub let THM_EC_OFF_HOT    : u64 = 0x02                // 16-bit deci-K
  pub let THM_EC_OFF_PSV    : u64 = 0x04                // 16-bit deci-K
  pub let THM_EC_OFF_TC1    : u64 = 0x06                //  8-bit coeff
  pub let THM_EC_OFF_TC2    : u64 = 0x07                //  8-bit coeff
  pub let THM_EC_OFF_TSP    : u64 = 0x08                //  8-bit  sec/10

  pub let THM_EC_OFF_TMP_LO : u64 = 0x10                // 16-bit deci-K lo
  pub let THM_EC_OFF_TMP_HI : u64 = 0x11                // 16-bit deci-K hi

  // ==========================================================================
  // §C  Policy state codes
  // ==========================================================================

  pub let THM_STATE_NORMAL   : u64 = 0
  pub let THM_STATE_PASSIVE  : u64 = 1
  pub let THM_STATE_CRITICAL : u64 = 2

  // ==========================================================================
  // §D  Operation codes (cap_handler_thermal dispatch)
  // ==========================================================================

  pub let THERMAL_OP_INIT        : u64 = 0
  pub let THERMAL_OP_READ_TMP    : u64 = 1
  pub let THERMAL_OP_READ_TRIPS  : u64 = 2
  pub let THERMAL_OP_EVAL_POLICY : u64 = 3

  // ==========================================================================
  // §E  Return codes — band 0xFFFFFFD6..0xFFFFFFDA (see §3)
  // ==========================================================================

  pub let THERMAL_OK                : u64 = 0
  pub let THERMAL_ERR_EC_NOT_INITED : u64 = 0xFFFFFFD6
  pub let THERMAL_ERR_NO_ZONE       : u64 = 0xFFFFFFD7
  pub let THERMAL_ERR_BAD_TRIP      : u64 = 0xFFFFFFD8
  pub let THERMAL_ERR_EC_READ_FAIL  : u64 = 0xFFFFFFD9
  pub let THERMAL_ERR_DEAD_ZONE     : u64 = 0xFFFFFFDA

  // ==========================================================================
  // §F  Unit-conversion constants
  //
  //   273.15 K ≈ 0 °C.  In tenths of a Kelvin, 2731 (273.1 K) rounds
  //   down and 2732 (273.2 K) rounds up; the real-body slice uses
  //   2732 to match cap/kind_thermal_zone.pdx's THERMAL_DK_ZERO_C =
  //   2732 so the two files cannot disagree about where 0 °C is.
  // ==========================================================================

  pub let THM_DK_ZERO_C   : u64 = 2732

  // ==========================================================================
  // §G  Mutable state — one thermal zone per machine, confined to
  //      this object (tools/build.sh's `objdump -r` pass asserts no
  //      other object relocates against these symbols)
  //
  //   _thm_inited       1 iff thermal_init has been called
  //   _thm_tmp_k10      last successful _TMP reading (deci-Kelvin)
  //   _thm_crt_k10      installed _CRT (deci-Kelvin)
  //   _thm_hot_k10      installed _HOT (deci-Kelvin)
  //   _thm_psv_k10      installed _PSV (deci-Kelvin)
  //   _thm_tc1          installed _TC1 (8-bit coefficient)
  //   _thm_tc2          installed _TC2 (8-bit coefficient)
  //   _thm_tsp          installed _TSP (8-bit sampling period)
  //   _thm_state        last evaluated policy state (0/1/2)
  //   _thm_read_ct      successful thermal_read_tmp count
  //   _thm_trip_ct      successful thermal_read_trip_points count
  //   _thm_eval_ct      thermal_evaluate_policy count
  // ==========================================================================

  pub let mut _thm_inited  : u64 = 0
  pub let mut _thm_tmp_k10 : u64 = 0
  pub let mut _thm_crt_k10 : u64 = 0
  pub let mut _thm_hot_k10 : u64 = 0
  pub let mut _thm_psv_k10 : u64 = 0
  pub let mut _thm_tc1     : u64 = 0
  pub let mut _thm_tc2     : u64 = 0
  pub let mut _thm_tsp     : u64 = 0
  pub let mut _thm_state   : u64 = 0
  pub let mut _thm_read_ct : u64 = 0
  pub let mut _thm_trip_ct : u64 = 0
  pub let mut _thm_eval_ct : u64 = 0

  // ==========================================================================
  // §H  Fingerprint tags + keys (single-line `pub let` strings per
  //      the pdx-encoder-pitfalls memory 2026-09-26)
  //
  //   THERMAL TMP t_K10=<dec> t_C=<dec>
  //   THERMAL TRIP CRT=<dec> HOT=<dec> PSV=<dec>
  //   THERMAL POLICY state=<normal|passive|critical>
  //
  // The POLICY state value is rendered DECIMAL (0/1/2); the pipe-
  // separated enum in the golden file is the format anchor matching
  // the discipline ec.golden uses for `phase=<idle|cmd|status|data>`.
  // ==========================================================================

  pub let thm_tag_tmp    : [u8; 12] = "THERMAL TMP\0"
  pub let thm_tag_trip   : [u8; 13] = "THERMAL TRIP\0"
  pub let thm_tag_policy : [u8; 15] = "THERMAL POLICY\0"

  pub let thm_k_t_k10 : [u8; 6] = "t_K10\0"
  pub let thm_k_t_c   : [u8; 4] = "t_C\0"
  pub let thm_k_crt   : [u8; 4] = "CRT\0"
  pub let thm_k_hot   : [u8; 4] = "HOT\0"
  pub let thm_k_psv   : [u8; 4] = "PSV\0"
  pub let thm_k_state : [u8; 6] = "state\0"

  // ==========================================================================
  // §I  kelvin_tenths_to_celsius_whole(k10) -> celsius (signed i64)
  //
  // Pure leaf.  Branches on sign to avoid `idiv` (not shipped in
  // paideia-as v0.36.82).  See §2 for the formula.
  //
  // SysV: rdi = k10.  Zero pushes.  Labels prefixed `thm_ktc_`.
  // ==========================================================================

  pub let kelvin_tenths_to_celsius_whole : (u64) -> u64 !{} @{} =
    fn (k10: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: convert deci-Kelvin to whole Celsius, signed.  The sign branch at `cmp rdi, 2732; jb thm_ktc_below` avoids `idiv` (not shipped in paideia-as v0.36.82, confirmed by `grep -rn '\\bidiv\\b' src/kernel/`, 2026-10-10): the ABOVE branch computes `(k10 - 2732) / 10` with plain `div rcx` after a zero-extend `xor rdx, rdx`; the BELOW branch computes `(2732 - k10) / 10` the same way and then negates the result in 2's complement by `mov rdx, 0; sub rdx, rax; mov rax, rdx` (no `neg` because the pdx encoder's `neg` support is unaudited at skeleton stage and the two-step sub-from-zero form is byte-for-byte identical to what `neg` would emit).  Pure leaf, no callee-save pushes needed: entry rsp%16==8, no nested calls, the single `ret` leaves rsp%16==8 as SysV requires.  Reserved labels prefixed `thm_ktc_`.",
      block: {
        mov rax, rdi;
        cmp rax, 2732;
        jb  thm_ktc_below;

        // --- k10 >= 2732 : celsius = (k10 - 2732) / 10
        sub rax, 2732;
        xor rdx, rdx;
        mov rcx, 10;
        div rcx;
        ret;

      thm_ktc_below:
        // --- k10 < 2732 : celsius = -((2732 - k10) / 10)
        mov rcx, rax;                        // rcx = k10
        mov rax, 2732;
        sub rax, rcx;                        // rax = 2732 - k10 (positive)
        xor rdx, rdx;
        mov rcx, 10;
        div rcx;                             // rax = (2732 - k10) / 10
        mov rdx, 0;
        sub rdx, rax;                        // rdx = -rax (2's complement)
        mov rax, rdx;
        ret
      }
    }

  // ==========================================================================
  // §J  thermal_init() -> u64
  //
  // Zero every state slot (including the trip points — the
  // installer calls `thermal_read_trip_points` next), flip the
  // inited latch, return THERMAL_OK.
  //
  // No arguments.  SysV: no inputs.  Zero pushes; leaf.  Labels
  // prefixed `thm_init_`.
  // ==========================================================================

  pub let thermal_init : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2527 (Wave 59 D10): zero every thermal-zone mutable-state slot, flip the inited latch, return THERMAL_OK.  Same shape as ec_init (drivers/acpi/ec.pdx §H), same reasoning: there is no hardware probe at skeleton stage because the EC OpRegion handler (D8) is the real hardware surface, and this init only establishes the mutable-state baseline a subsequent `thermal_read_trip_points` can fill.  Zero sequence writes 11 u64 slots via one `xor rax, rax` + 11 `mov [rip + sym], rax` -- plain REX.W movs are 8-byte stores so no `mov_d` is needed.  Flip _thm_inited at the END (not with a late mov because a re-init call must see cleared counters first -- a tester grepping for 'inited AND read_ct > 0' would otherwise see a false YES across a re-init, same discipline ec_init uses).  Leaf, zero caller-save pushes, zero nested calls.  Labels prefixed `thm_init_`.",
      block: {
        xor rax, rax;
        mov [rip + _thm_tmp_k10], rax;
        mov [rip + _thm_crt_k10], rax;
        mov [rip + _thm_hot_k10], rax;
        mov [rip + _thm_psv_k10], rax;
        mov [rip + _thm_tc1],     rax;
        mov [rip + _thm_tc2],     rax;
        mov [rip + _thm_tsp],     rax;
        mov [rip + _thm_state],   rax;
        mov [rip + _thm_read_ct], rax;
        mov [rip + _thm_trip_ct], rax;
        mov [rip + _thm_eval_ct], rax;

        mov rax, 1;
        mov [rip + _thm_inited], rax;

        xor rax, rax;                        // THERMAL_OK
        ret
      }
    }

  // ==========================================================================
  // §K  thermal_read_tmp() -> u64
  //
  // Read the 16-bit deci-Kelvin `_TMP` as two consecutive EC bytes
  // (low at THM_EC_OFF_TMP_LO=0x10, high at ...HI=0x11, little-
  // endian), compose, stash in `_thm_tmp_k10`, compute the whole-
  // Celsius value, emit the TMP fingerprint, return the deci-Kelvin
  // reading.
  //
  // Gate order (first failure named):
  //   (1) _thm_inited == 0           -> THERMAL_ERR_NO_ZONE (0xFFFFFFD7)
  //   (2) ec_inited() == 0           -> THERMAL_ERR_EC_NOT_INITED (0xFFFFFFD6)
  //   (3) ec_read_u8 returns >= 0xFFFFFF00 (any EC error band code)
  //                                   -> THERMAL_ERR_EC_READ_FAIL  (0xFFFFFFD9)
  //
  // SysV: no inputs.  Register plan: 5 callee-save pushes (rbx, r12,
  // r13, r14, r15) leave rsp%16==0 for every nested call.
  // r12 = tmp_k10 composed, r13 = celsius, r14/r15/rbx align only.
  // klog_s1_d2 takes v2 (celsius) on the stack: one `sub rsp, 8`
  // align-for-push + one `push r13` places v2 at [rsp+0] before
  // CALL (= [rbp+16] inside the wrapper, matching klog_s1_d2's own
  // comment); post-call `add rsp, 16` reclaims both in one shot.
  // Labels prefixed `thm_rt_`.
  // ==========================================================================

  pub let thermal_read_tmp : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: read `_TMP` as two little-endian EC bytes (lo at 0x10, hi at 0x11), compose, stash in _thm_tmp_k10, convert to whole Celsius via kelvin_tenths_to_celsius_whole, emit `THERMAL TMP t_K10=<dec> t_C=<dec>` fingerprint, bump counter, return the deci-Kelvin reading.  Gates in order so an operator sees the first failure named: (1) _thm_inited==0 -> THERMAL_ERR_NO_ZONE (the thermal module itself was never brought up; distinct from the EC-not-ready case so a tester can tell them apart), (2) ec_inited()==0 -> THERMAL_ERR_EC_NOT_INITED (the EC OpRegion handler is the hardware surface and must come up first; this gate exists so the fingerprint cannot show a 0-byte reading mis-attributed to a cold-storage temperature), (3) either ec_read_u8 refusal (lo or hi) >= 0xFFFFFF00 collapses to THERMAL_ERR_EC_READ_FAIL -- the EC's own 0xFFFFFFC5..CA band is NOT leaked into the thermal vocabulary because a consumer debugging a thermal read should not have to understand two vocabularies to debug one logical operation (the EC's own fingerprint carries the phase breakdown).  Composition: tmp_k10 = (hi << 8) | lo, using `shl rax, 8; or r12, rax` on r12 which already holds `lo` from the first read.  Error-band compare uses the ec.pdx idiom `mov r11, 0xFFFFFF00; cmp rax, r11; jae ...` rather than `cmp rax, 0xFFFFFF00` directly because imm32 with bit 31 set would be sign-extended by CMP r/m64, imm32 and compare against 0xFFFFFFFFFFFFFF00 instead of the intended 0xFFFFFF00 -- the pdx-encoder-pitfalls memory records that trap.  Register plan: 5 callee-save pushes (rbx=align, r12=tmp_k10 composed, r13=celsius signed, r14=align, r15=align) leave rsp%16==0 at the body; every nested call (ec_inited, ec_read_u8 twice, kelvin_tenths_to_celsius_whole) is called with rsp%16==0 unchanged.  klog_s1_d2 takes its 7th arg (v2 = celsius) on the stack: ONE `sub rsp, 8` align-for-push lands rsp%16==8, then `push r13` lands rsp%16==0 for CALL, then `add rsp, 16` after the call reclaims both the align-sub and the push in one shot (same shape ec_handler_opregion uses for klog_s1_x3).  Labels prefixed `thm_rt_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // --- (1) thermal module inited?
        mov rax, [rip + _thm_inited];
        cmp rax, 0;
        je  thm_rt_no_zone;

        // --- (2) EC inited?
        call ec_inited;
        cmp rax, 0;
        je  thm_rt_ec_not_inited;

        // --- (3) read TMP low byte
        mov rdi, 0x10;                       // THM_EC_OFF_TMP_LO
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rt_ec_fail;
        mov r12, rax;                        // r12 = lo

        // --- (4) read TMP high byte
        mov rdi, 0x11;                       // THM_EC_OFF_TMP_HI
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rt_ec_fail;

        // --- Compose: tmp_k10 = (hi << 8) | lo
        shl rax, 8;
        or  r12, rax;                        // r12 = tmp_k10
        mov [rip + _thm_tmp_k10], r12;

        // --- (5) Convert to whole Celsius (signed)
        mov rdi, r12;
        call kelvin_tenths_to_celsius_whole;
        mov r13, rax;                        // r13 = celsius

        // --- (6) Emit fingerprint:
        //
        //   THERMAL TMP t_K10=<dec> t_C=<dec>
        //
        // klog_s1_d2 signature (per wrappers.pdx §klog_s1_d2):
        //   rdi = level (3 = LEVEL_INFO)
        //   rsi = subsys_ptr (SUBSYS_DRV_)
        //   rdx = tag_ptr
        //   rcx = k1_ptr, r8 = v1
        //   r9  = k2_ptr
        //   [rsp+0]  = v2        (just before CALL from caller's view;
        //                         the wrapper reads it at [rbp+16]
        //                         after its own push rbp)
        //
        // Alignment: 5 pushes above leave rsp%16==0.  One `sub rsp, 8`
        // lands rsp%16==8, then `push r13` places v2 at [rsp+0] and
        // lands rsp%16==0 for CALL.  `add rsp, 16` reclaims both.
        sub rsp, 8;                          // align-for-push
        push r13;                            // [rsp+0] = v2 before CALL

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + thm_tag_tmp];
        lea rcx, [rip + thm_k_t_k10];
        mov r8,  r12;                        // v1 = tmp_k10
        lea r9,  [rip + thm_k_t_c];
        call klog_s1_d2;
        add rsp, 16;                         // reclaim align + push

        // --- (7) Bump counter
        mov rax, [rip + _thm_read_ct];
        add rax, 1;
        mov [rip + _thm_read_ct], rax;

        // --- (8) Return tmp_k10 in rax
        mov rax, r12;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_rt_no_zone:
        mov rax, 0xFFFFFFD7;                 // THERMAL_ERR_NO_ZONE
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_rt_ec_not_inited:
        mov rax, 0xFFFFFFD6;                 // THERMAL_ERR_EC_NOT_INITED
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_rt_ec_fail:
        mov rax, 0xFFFFFFD9;                 // THERMAL_ERR_EC_READ_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  thermal_read_trip_points() -> u64
  //
  // Read `_CRT`/`_HOT`/`_PSV` (16-bit each, little-endian) and
  // `_TC1`/`_TC2`/`_TSP` (8-bit each) from the EC, stash in the
  // mutable-state slots, emit the TRIP fingerprint, return
  // THERMAL_OK.
  //
  // Gate order:
  //   (1) _thm_inited == 0  -> THERMAL_ERR_NO_ZONE
  //   (2) ec_inited() == 0  -> THERMAL_ERR_EC_NOT_INITED
  //   (3) any ec_read_u8 refusal -> THERMAL_ERR_EC_READ_FAIL
  //
  // SysV: no inputs.  Register plan: 5 callee-save pushes (rbx, r12,
  // r13, r14, r15) leave rsp%16==0 for every nested call.  r12 =
  // CRT (composed), r13 = HOT (composed), r14 = PSV (composed),
  // r15 = scratch (holds lo byte between the two reads of a 16-bit
  // value).  rbx is align only.  klog_s1_d3 takes three stack args:
  // one `sub rsp, 8` align-for-push + three LIFO pushes (v3, k3, v2)
  // place them at the wrapper's expected [rbp+16]/[rbp+24]/[rbp+32]
  // slots; post-call `add rsp, 32` reclaims align + 3 pushes.
  // Labels prefixed `thm_rtp_`.
  // ==========================================================================

  pub let thermal_read_trip_points : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: read six EC bytes for the three 16-bit trip points (_CRT/_HOT/_PSV at 0x00/0x02/0x04) plus three EC bytes for the three 8-bit coefficients (_TC1/_TC2/_TSP at 0x06/0x07/0x08), stash each in its mutable-state slot, emit `THERMAL TRIP CRT=<dec> HOT=<dec> PSV=<dec>` fingerprint (the three 16-bit deci-Kelvin trips are the ones a tester reads to confirm the zone is wired; the three coefficients land in state slots for the real-body DP[k] slice but are not fingerprinted at skeleton stage because the fingerprint is already a 3-field klog_s1_d3 and growing it to 6 fields would need klog_s1_d6 which does not exist).  Gates match thermal_read_tmp (§K).  Composition: each 16-bit trip is read lo-byte first (into r15), then hi-byte (left-shifted 8), then OR'd into the destination reg; this layout keeps the two reads adjacent in the source so a reviewer sees the little-endian discipline next to the offset literal.  Register plan: 5 callee-save pushes (rbx=align, r12=CRT composed, r13=HOT composed, r14=PSV composed, r15=lo-byte scratch across the two reads of each 16-bit field) leave rsp%16==0 for every nested call.  klog_s1_d3 takes three stack args (v2, k3, v3): ONE `sub rsp, 8` align-for-push lands rsp%16==8, then three 8-byte pushes LIFO (v3 first so it ends up deepest = [rbp+32] after the CALL+push-rbp pair, then k3_ptr = [rbp+24], then v2 = [rbp+16]) land rsp%16==0 for CALL, then `add rsp, 32` reclaims the align-sub + three pushes.  Labels prefixed `thm_rtp_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // --- (1) thermal inited?
        mov rax, [rip + _thm_inited];
        cmp rax, 0;
        je  thm_rtp_no_zone;

        // --- (2) EC inited?
        call ec_inited;
        cmp rax, 0;
        je  thm_rtp_ec_not_inited;

        // --- (3) read _CRT lo+hi, compose into r12
        mov rdi, 0x00;                       // THM_EC_OFF_CRT (lo)
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        mov r15, rax;                        // r15 = CRT lo

        mov rdi, 0x01;                       // THM_EC_OFF_CRT + 1 (hi)
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        shl rax, 8;
        mov r12, r15;
        or  r12, rax;                        // r12 = CRT
        mov [rip + _thm_crt_k10], r12;

        // --- (4) read _HOT lo+hi, compose into r13
        mov rdi, 0x02;                       // THM_EC_OFF_HOT (lo)
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        mov r15, rax;

        mov rdi, 0x03;                       // THM_EC_OFF_HOT + 1 (hi)
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        shl rax, 8;
        mov r13, r15;
        or  r13, rax;                        // r13 = HOT
        mov [rip + _thm_hot_k10], r13;

        // --- (5) read _PSV lo+hi, compose into r14
        mov rdi, 0x04;                       // THM_EC_OFF_PSV (lo)
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        mov r15, rax;

        mov rdi, 0x05;                       // THM_EC_OFF_PSV + 1 (hi)
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        shl rax, 8;
        mov r14, r15;
        or  r14, rax;                        // r14 = PSV
        mov [rip + _thm_psv_k10], r14;

        // --- (6) read _TC1 (8-bit) at 0x06
        mov rdi, 0x06;                       // THM_EC_OFF_TC1
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        mov [rip + _thm_tc1], rax;

        // --- (7) read _TC2 (8-bit) at 0x07
        mov rdi, 0x07;                       // THM_EC_OFF_TC2
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        mov [rip + _thm_tc2], rax;

        // --- (8) read _TSP (8-bit) at 0x08
        mov rdi, 0x08;                       // THM_EC_OFF_TSP
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae thm_rtp_ec_fail;
        mov [rip + _thm_tsp], rax;

        // --- (9) Emit fingerprint:
        //
        //   THERMAL TRIP CRT=<dec> HOT=<dec> PSV=<dec>
        //
        // klog_s1_d3 signature (per wrappers.pdx §klog_s1_d3):
        //   rdi = level (3 = LEVEL_INFO)
        //   rsi = subsys_ptr (SUBSYS_DRV_)
        //   rdx = tag_ptr
        //   rcx = k1_ptr, r8 = v1
        //   r9  = k2_ptr
        //   [rsp+0]  = v2        \
        //   [rsp+8]  = k3_ptr     > caller-pushed (LIFO: v3, k3, v2)
        //   [rsp+16] = v3        /
        //
        // Alignment: 5 pushes leave rsp%16==0.  `sub rsp, 8` lands
        // rsp%16==8, then three 8-byte pushes LIFO land rsp%16==0
        // for CALL.  `add rsp, 32` reclaims 8+24 in one shot.
        sub rsp, 8;                          // align-for-push
        push r14;                            // [rsp+16] after CALL = v3 (PSV)
        lea rax, [rip + thm_k_psv];
        push rax;                            // [rsp+8]  after CALL = k3_ptr
        push r13;                            // [rsp+0]  after CALL = v2 (HOT)

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + thm_tag_trip];
        lea rcx, [rip + thm_k_crt];
        mov r8,  r12;                        // v1 = CRT
        lea r9,  [rip + thm_k_hot];
        call klog_s1_d3;
        add rsp, 32;                         // reclaim align + 3 pushes

        // --- (10) Bump counter
        mov rax, [rip + _thm_trip_ct];
        add rax, 1;
        mov [rip + _thm_trip_ct], rax;

        xor rax, rax;                        // THERMAL_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_rtp_no_zone:
        mov rax, 0xFFFFFFD7;                 // THERMAL_ERR_NO_ZONE
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_rtp_ec_not_inited:
        mov rax, 0xFFFFFFD6;                 // THERMAL_ERR_EC_NOT_INITED
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_rtp_ec_fail:
        mov rax, 0xFFFFFFD9;                 // THERMAL_ERR_EC_READ_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  thermal_evaluate_policy() -> u64
  //
  // Evaluate the passive-cooling ladder against the cached
  // `_thm_tmp_k10` / `_thm_crt_k10` / `_thm_psv_k10` state:
  //
  //   tmp >= crt   ->  state = THM_STATE_CRITICAL  (2)
  //   tmp >= psv   ->  state = THM_STATE_PASSIVE   (1)
  //   otherwise    ->  state = THM_STATE_NORMAL    (0)
  //
  // Dead-zone gate: _thm_crt_k10 == 0 means trip points were never
  // installed; the ladder has no critical threshold behind it and
  // the refusal names the bug (THERMAL_ERR_DEAD_ZONE) rather than
  // defaulting to NORMAL.  See §5 for why actuation is deferred.
  //
  // SysV: no inputs.  Register plan: 3 callee-save pushes (rbx, r12,
  // r13) leave rsp%16==0 for the klog_s1_d1 call (zero stack args).
  // r12 = state (0/1/2).  rbx and r13 are align only.  Labels
  // prefixed `thm_ep_`.
  // ==========================================================================

  pub let thermal_evaluate_policy : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: evaluate the two-threshold ladder against the cached _thm_tmp_k10 / _thm_crt_k10 / _thm_psv_k10, stash the result in _thm_state, emit `THERMAL POLICY state=<dec>` fingerprint, bump counter, return the state.  The ladder reads cached state rather than calling thermal_read_tmp inline because the policy is intended to fire on a timed sample tick (D11's TSP-driven driver loop will drive the pair) and conflating the sample and the evaluation would prevent a tester from exercising just one of them.  Dead-zone gate: _thm_crt_k10 == 0 is the signal 'trip points were never installed' -- the installer sets _thm_crt_k10 from the EC's `_CRT` byte, which is nonzero on every shipping laptop (a zero `_CRT` would mean the firmware is asking the OS to shut down at 0 K, which is physically impossible); refusing instead of defaulting to NORMAL is the discipline cap/kind_thermal_zone.pdx's §2 recommends -- a policy that silently reports NORMAL on an uninstalled zone is a bug that only surfaces when the laptop catches fire.  Comparison order: _CRT first because CRITICAL is unconditional (ACPI 6.5 §11.5.1) and must shadow PASSIVE if both are met -- same comparison order cap/kind_thermal_zone.pdx's thermal_zone_assess uses, by design.  Register plan: 3 callee-save pushes (rbx=align, r12=state, r13=align) leave rsp%16==0 for the klog_s1_d1 call (zero stack args; the wrapper takes rcx=k1_ptr, r8=v1 only).  Labels prefixed `thm_ep_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- (1) thermal inited?
        mov rax, [rip + _thm_inited];
        cmp rax, 0;
        je  thm_ep_no_zone;

        // --- (2) Dead-zone: _CRT == 0?
        mov rax, [rip + _thm_crt_k10];
        cmp rax, 0;
        je  thm_ep_dead;

        // --- (3) Evaluate ladder.
        //
        // Load tmp into rax, crt into rcx, psv into r11.  Compare
        // tmp >= crt first (CRITICAL shadows PASSIVE when both hit).
        mov rax, [rip + _thm_tmp_k10];
        mov rcx, [rip + _thm_crt_k10];
        cmp rax, rcx;
        jae thm_ep_critical;

        mov rcx, [rip + _thm_psv_k10];
        cmp rax, rcx;
        jae thm_ep_passive;

        // Normal.
        mov r12, 0;                          // THM_STATE_NORMAL
        jmp thm_ep_emit;

      thm_ep_passive:
        mov r12, 1;                          // THM_STATE_PASSIVE
        jmp thm_ep_emit;

      thm_ep_critical:
        mov r12, 2;                          // THM_STATE_CRITICAL
        jmp thm_ep_emit;

      thm_ep_emit:
        // --- (4) Stash state.
        mov [rip + _thm_state], r12;

        // --- (5) Emit fingerprint:
        //
        //   THERMAL POLICY state=<normal|passive|critical>
        //
        // klog_s1_d1 signature (per wrappers.pdx §klog_s1_d1):
        //   rdi = level (3 = LEVEL_INFO)
        //   rsi = subsys_ptr (SUBSYS_DRV_)
        //   rdx = tag_ptr
        //   rcx = k1_ptr, r8 = v1
        //
        // Zero stack args.  3 pushes leave rsp%16==0 so CALL is
        // aligned without any adjustment.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + thm_tag_policy];
        lea rcx, [rip + thm_k_state];
        mov r8,  r12;                        // v1 = state (0/1/2)
        call klog_s1_d1;

        // --- (6) Bump counter.
        mov rax, [rip + _thm_eval_ct];
        add rax, 1;
        mov [rip + _thm_eval_ct], rax;

        // --- (7) Return state.
        mov rax, r12;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_ep_no_zone:
        mov rax, 0xFFFFFFD7;                 // THERMAL_ERR_NO_ZONE
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_ep_dead:
        mov rax, 0xFFFFFFDA;                 // THERMAL_ERR_DEAD_ZONE
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  cap_handler_thermal(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch stub the KIND_THERMAL_ZONE_DRV (0x3E) arm in
  // cap/invoke.pdx calls.  Masks op_arg to its low byte and routes
  // to one of {thermal_init, thermal_read_tmp,
  // thermal_read_trip_points, thermal_evaluate_policy}:
  //
  //   op == THERMAL_OP_INIT        (0) -> thermal_init
  //   op == THERMAL_OP_READ_TMP    (1) -> thermal_read_tmp
  //   op == THERMAL_OP_READ_TRIPS  (2) -> thermal_read_trip_points
  //   op == THERMAL_OP_EVAL_POLICY (3) -> thermal_evaluate_policy
  //   otherwise                        -> INVOKE_UNSUPPORTED
  //
  // Returns whatever the delegated entrypoint returned, or
  // INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC) on an unknown op.
  //
  // No fingerprint on dispatch — each delegate emits its own.  The
  // rights field is NOT checked at skeleton stage; the real-body
  // slice adds a R_THERMAL_* check against rights (same shape as
  // cap_handler_firmware_blob §4) when the mint path lands.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg.  Register
  // plan: 3 callee-save pushes (rbx=align, r12=op masked, r13=align)
  // leave rsp%16==0 for every nested call.  Labels prefixed
  // `thm_ch_`.
  // ==========================================================================

  pub let cap_handler_thermal : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: the dispatcher stub the KIND_THERMAL_ZONE_DRV (0x3E) arm in cap/invoke.pdx calls when the kind-tag compare hits.  Routes op_arg[7:0] to one of four leaf entrypoints via a cmp-chain (not a jump table) because op has 4 live values and a chain is one branch per case versus a table that would waste 252 slots.  Rejects op >= 4 with INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC, same code the fallthrough-safe default arm in cap_invoke_dispatch uses) rather than a thermal-vocabulary error code because an unknown op is a plumbing bug upstream (the dispatcher's op is a constant chosen by the ACPI subsystem, so an unknown value here means the dispatcher itself was passed a bad op) and the error name should say so.  Rights are NOT checked at skeleton stage: cap_handler_firmware_blob (§4) is the model for the real-body check (compare rdi against the per-op R_THERMAL_* bit, refuse with INVOKE_DENIED on miss); landing the check now would be dead-code until the mint path arrives.  Register plan: 3 callee-save pushes (rbx=align, r12=op masked, r13=align) leave rsp%16==0 for every nested call to one of the four entrypoints; each entrypoint's own prologue is 5 pushes (read_tmp/read_trips) or 3 pushes (evaluate_policy) or 0 pushes (init), all of which land internally without needing further alignment adjustment from this caller.  No `and r12, imm64` -- 0xFF fits imm8/imm32.  Labels prefixed `thm_ch_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Mask op_arg to its low byte.
        mov r12, rdx;
        and r12, 0xFF;

        cmp r12, 0;                          // THERMAL_OP_INIT
        je  thm_ch_init;
        cmp r12, 1;                          // THERMAL_OP_READ_TMP
        je  thm_ch_rtmp;
        cmp r12, 2;                          // THERMAL_OP_READ_TRIPS
        je  thm_ch_rtp;
        cmp r12, 3;                          // THERMAL_OP_EVAL_POLICY
        je  thm_ch_eval;
        jmp thm_ch_unsupp;

      thm_ch_init:
        call thermal_init;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_ch_rtmp:
        call thermal_read_tmp;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_ch_rtp:
        call thermal_read_trip_points;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_ch_eval:
        call thermal_evaluate_policy;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      thm_ch_unsupp:
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  Stat getters — single-load leaves for witness callers
  //
  // Pair for the EC D8 and firmware-blob I7 getter sets so a boot
  // witness can assert `thermal_inited()==1 AND thermal_read_count()
  // > 0` after a smoke that drives cap_handler_thermal a known
  // number of times.
  // ==========================================================================

  pub let thermal_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: single-load getter for _thm_inited.  Leaf.",
      block: { mov rax, [rip + _thm_inited]; ret }
    }

  pub let thermal_last_tmp_k10 : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: single-load getter for _thm_tmp_k10 (last successful _TMP in deci-Kelvin).  Zero until the first successful thermal_read_tmp.  Leaf.",
      block: { mov rax, [rip + _thm_tmp_k10]; ret }
    }

  pub let thermal_last_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: single-load getter for _thm_state (last evaluated policy state: 0=normal, 1=passive, 2=critical).  Zero until the first thermal_evaluate_policy.  Leaf.",
      block: { mov rax, [rip + _thm_state]; ret }
    }

  pub let thermal_read_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: single-load getter for _thm_read_ct.  Bumped once per successful thermal_read_tmp.  Leaf.",
      block: { mov rax, [rip + _thm_read_ct]; ret }
    }

  pub let thermal_trip_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: single-load getter for _thm_trip_ct.  Bumped once per successful thermal_read_trip_points.  Leaf.",
      block: { mov rax, [rip + _thm_trip_ct]; ret }
    }

  pub let thermal_eval_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2527 (Wave 59 D10) skeleton: single-load getter for _thm_eval_ct.  Bumped once per thermal_evaluate_policy call that reached the ladder (gated calls do not count).  Leaf.",
      block: { mov rax, [rip + _thm_eval_ct]; ret }
    }

}
