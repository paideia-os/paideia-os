// src/kernel/core/drivers/acpi/ec_quirks.pdx — Wave 80 I10 (paideia-os#2567)
//
// Embedded-Controller VERSION/REVISION probe + QUIRKS DATABASE skeleton.
//
// -----------------------------------------------------------------------------
// §0  WHAT THIS FILE IS
// -----------------------------------------------------------------------------
//
// Each T14 G4 Embedded-Controller firmware answers the Wave 78 I6
// discovery harness's six probe commands with a bit-identical reply
// shape, but with SUBTLE SEMANTIC DIFFERENCES in the downstream
// register layout (ACPI 6.5 §12 vendor-defined EC byte space). The
// three differences the OS-visible drivers care about today are:
//
//   * fan RPM scale factor — Lenovo T14 G4 initial-production units
//     ship with EC v1.3x where the fan speed register at EC offset
//     0x4C is a RAW count that the OS must MULTIPLY BY 2 to get the
//     actual RPM. T14 G4 EC v1.44+ (shipping since 2024-Q1) emits
//     already-scaled RPM at that offset. The quirks row carries the
//     scale factor (1 or 2) so the Wave 75 D11 fan driver's
//     fan_read_rpm getter can do `rpm_raw * row.fan_rpm_scale`.
//   * battery capacity unit — ACPI's _BIF.Capacity Granularity field
//     is NOT consulted by the vendor EC on the T14 G4; instead the
//     EC packs capacities (design, last-full, remaining, warn, low)
//     into either mWh (0) or µWh (1) depending on EC firmware
//     revision. The Wave 74 D9 battery driver's capacity getters
//     scale by `(row.battery_unit == 1) ? 1000 : 1` to normalise.
//   * thermal-zone slot ordering — the Wave 74 D10 thermal driver
//     reads four TRIP_POINT / TEMP registers at EC offsets 0x80..83;
//     the semantic mapping of each slot to {CPU, GPU, SSD, BATT}
//     is firmware-dependent. The quirks row packs the four slot-
//     to-sensor mappings into a single u32 (byte-per-slot).
//
// This file lets the Wave 74 D9 battery driver, Wave 74 D10 thermal
// driver, Wave 75 D11 fan driver, and Wave 76 D12 backlight driver
// query a SINGLE quirks row that was MATCHED AT BOOT against the
// EC's self-reported version/revision byte. The matched row is
// cached in `_ecq_matched_row` after the Wave 80 I10 probe runs
// (once per boot) and all four getters return field values from it.
//
// -----------------------------------------------------------------------------
// §1  WHAT THIS FILE IS NOT
// -----------------------------------------------------------------------------
//
// This file does NOT:
//   * decode EC version strings from Wave 78 I6's `_ecd_probe_results`
//     slot 0 (the VERSION probe response). The I6 harness is the
//     RICH fingerprint source (six probe bytes × up to 32 response
//     bytes); this file reads a SINGLE narrow version u16 directly
//     from the EC via `ec_read_u8` so a boot runs independently of
//     I6 having been issued yet. A follow-up slice may wire the
//     match through I6's slot-0 u64 instead, when the real-body I6
//     slice lands.
//   * mutate the quirks database at runtime. The DB is a frozen
//     table seeded in this file; the real-body slice replaces the
//     seed with a boot-provided image if a different vendor layout
//     is observed (e.g. a non-Lenovo T14 clone with a different EC).
//   * expose a per-row row-dump operation. The four getters each
//     return ONE field value; a boot witness that wants the whole
//     row calls the four of them in sequence. The follow-up slice
//     may add a bulk-row dump op if a quirks-schema debugger
//     witness lands.
//   * cover revisions beyond T14 G4. The 8-row database leaves
//     7 slots free for a follow-up slice to seed Dell Latitude
//     7440 / HP EliteBook 840 G10 rows (both of which the I6
//     harness observed on the same six probe bytes).
//
// -----------------------------------------------------------------------------
// §2  QUIRKS ROW LAYOUT  (6 u64 per row, 8 rows, 48 u64 total)
// -----------------------------------------------------------------------------
//
// The DB is a flat `[u64; 48]` array; row `r` lives at
// `_quirks_db[r * 6 .. r * 6 + 6]`. Columns:
//
//   u64[0]  ec_version_pattern   packed u16 ((major << 8) | minor), low 48
//                                bits reserved for a follow-up wider
//                                fingerprint. The sentinel 0 means
//                                "row unused" and is matched by nothing
//                                (the probe guards `pattern != 0` before
//                                comparing).
//   u64[1]  fan_rpm_scale        1 or 2 (dimensionless multiplier)
//   u64[2]  battery_unit         0 = mWh, 1 = µWh
//   u64[3]  thermal_zone_order   packed u32: byte0=slot0 sensor id,
//                                byte1=slot1, byte2=slot2, byte3=slot3.
//                                Sensor ids: 0=CPU, 1=GPU, 2=SSD, 3=BATT.
//                                T14 G4 v1.44 ships 0x03020100 (CPU,
//                                GPU, SSD, BATT in that slot order).
//   u64[4]  feature_bits         packed u32 of OS-visible features:
//                                bit 0 = pwm_fan_supported
//                                bit 1 = thermal_trip_crit_supported
//                                bit 2 = backlight_dpaux_supported
//                                bit 3 = battery_cycle_count_supported
//                                higher bits reserved.
//   u64[5]  reserved             zero at this landing; follow-up may
//                                carry a per-row EC-command-set bitmap.
//
// Row 0 is seeded with T14 G4 EC v1.44 (§7 for the exact bytes).
// Rows 1..7 are zero-filled; a probe miss leaves `_ecq_matched_row`
// set to the no-match sentinel 0xFF and each getter returns its
// architectural default (fan_scale=1, battery_unit=0, tz_order=
// 0x03020100, feature_bits=0).
//
// -----------------------------------------------------------------------------
// §3  EC VERSION PROBE OFFSET
// -----------------------------------------------------------------------------
//
// The task statement nominated "BAT_EC_OFF_LAST_FULL_HIGH-adjacent
// diagnostic slot". `BAT_EC_OFF_LAST_FULL` (`drivers/acpi/battery.pdx`
// §A at 0x14) is a u32 occupying 0x14..0x17, so its HIGH byte is 0x17.
// Byte 0x18 is `BAT_EC_OFF_DESIGN_V` (architectural), 0x1A..0x1F are
// the WARN_CAP / LOW_CAP / CYCLE_CT architectural u16s, 0x20..0x23 is
// PRES_RATE, 0x24..0x27 is REM_CAP — all architectural (ACPI 6.5
// §10.2.2.1). The FIRST byte past the architectural battery block
// is 0x28; that is the slot this file uses as the EC VERSION probe
// read. T14 G4 EC v1.44 writes `0x01` into 0x28 (major) and `0x44`
// into 0x29 (minor); the probe reads both and packs as `(major<<8)
// | minor` to compare against the ec_version_pattern column.
//
// 0x28..0x29 is INSIDE the EC's 256-byte architectural address
// space (ec.pdx §I gates `offset < 256`) and inside the
// vendor-reserved region per ACPI 6.5 §12 (the first 0x28 bytes
// are architectural, 0x28..0xFF are vendor-defined). The follow-up
// slice may read a wider fingerprint (e.g. 0x28..0x2B as a u32)
// if a vendor row demands finer-grained matching.
//
// -----------------------------------------------------------------------------
// §4  RETURN CODES — band 0xFFFFFD67..0xFFFFFD6B
// -----------------------------------------------------------------------------
//
// Audit at landing time (`grep -rnE '0xFFFFFD6[7-9]|0xFFFFFD6A|
// 0xFFFFFD6B' src/kernel/`) returned ZERO hits. Disjoint from:
//   EC_*              (0xFFFFFFC5..CA, ec.pdx)
//   BATTERY_*         (0xFFFFFFD1..D6, battery.pdx)
//   FAN_*             (0xFFFFFFF0..F5, fan.pdx)
//   ECD_*             (0xFFFFFD44..48, ec_discovery.pdx)
//   TPM_*             (0xFFFFFD56..5B, tpm_crb.pdx)
//
//   0xFFFFFD67  ECQ_ERR_NOT_INITED        — EC OpRegion facade
//                                           (`ec_inited()==0`) or
//                                           ec_quirks_probe has not
//                                           been called yet; a getter
//                                           consulted the matched-row
//                                           cache before the probe
//                                           populated it. Honest
//                                           default-return happens
//                                           alongside: the getter
//                                           returns the architectural
//                                           default so a caller that
//                                           ignores the error band
//                                           still gets safe values.
//   0xFFFFFD68  ECQ_ERR_UNKNOWN_VERSION   — the probe read a VERSION
//                                           pattern that matched no
//                                           seeded row. `_ecq_matched_
//                                           row` is set to 0xFF (no-
//                                           match sentinel) and every
//                                           getter returns its
//                                           architectural default.
//                                           Not fatal; the kernel
//                                           boots on default quirks.
//   0xFFFFFD69  ECQ_ERR_BAD_FEATURE_IDX   — `ec_quirks_get_feature_bit`
//                                           was called with an index
//                                           outside 0..31. Low-32
//                                           bits of `feature_bits`
//                                           are the only addressable
//                                           bits today.
//   0xFFFFFD6A  ECQ_ERR_DB_FULL           — reserved for the follow-
//                                           up slice: a boot-provided
//                                           quirks image that
//                                           overflows the 8-row DB
//                                           returns this. Today the
//                                           seed carries exactly one
//                                           row (row 0), so this code
//                                           is minted but never fired.
//   0xFFFFFD6B  ECQ_ERR_VERSION_MISMATCH  — reserved for the follow-
//                                           up slice: a probe that
//                                           read a well-formed
//                                           version but the version
//                                           did not match the
//                                           PREVIOUSLY matched row
//                                           (e.g. firmware hot-swap).
//                                           Today a single probe
//                                           runs at boot so this is
//                                           minted but never fired.
//
// -----------------------------------------------------------------------------
// §5  invoke.pdx — KIND_EC_QUIRKS = 0x51
// -----------------------------------------------------------------------------
//
// Landing-time audit (`grep -nE 'cmp rcx, 0x51\b' src/kernel/core/
// cap/invoke.pdx`) returned ZERO existing dispatch arms. 0x4F and
// 0x50 are also empty (also returned zero), left free for sibling
// parallel-wave Wave 80 landings. 0x51 fits imm32 with bit 31
// clear (sign-extend-safe), so the dispatch arm uses `cmp rcx,
// 0x51` directly without r9 staging.
//
// -----------------------------------------------------------------------------
// §6  FINGERPRINTS
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/ec_quirks.golden:
//
//     EC_QUIRKS PROBE version=0x<4-hex> match_row=<dec>
//     EC_QUIRKS FAN_SCALE row=<dec> scale=<dec>
//     EC_QUIRKS BATT_UNIT row=<dec> unit=<dec>
//
// Three frames, one per call site:
//   * PROBE via klog_s1_x1_d1 (hex version + decimal row)
//   * FAN_SCALE via klog_s1_d2 (two decimals)
//   * BATT_UNIT via klog_s1_d2 (two decimals)
//
// The smoke harness matches on ordered-substring presence, so one
// of each frame is sufficient; the real-boot path emits them in
// probe → fan-scale-read → battery-unit-read order which matches
// the golden.
//
// -----------------------------------------------------------------------------
// §7  SEED ROW — T14 G4 EC v1.44
// -----------------------------------------------------------------------------
//
//   _quirks_db[0..5]:
//     [0] = 0x0144         // ec_version_pattern = (1<<8)|0x44
//     [1] = 1              // fan_rpm_scale (EC pre-scales RPM)
//     [2] = 0              // battery_unit = mWh
//     [3] = 0x03020100     // thermal_zone_order: slot0=CPU, slot1=GPU,
//                          //                     slot2=SSD, slot3=BATT
//     [4] = 0x0001         // feature_bits: pwm_fan_supported = 1
//     [5] = 0              // reserved
//
// Rows 1..7 are zero-filled (ec_version_pattern == 0 => unused).
//
// -----------------------------------------------------------------------------
// §8  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   No `test rN, rN`                 (zero-equality uses `cmp rN, 0`).
//   No `and r, imm64`                (every mask here fits in imm32).
//   No 2-op `imul r, imm`            (row stride ×48 uses reg-reg
//                                     `imul rax, r11` with r11 staged
//                                     from a `mov r11, 48` first;
//                                     per the pdx-encoder-pitfalls
//                                     memory 2026-09-26).
//   No multiline `pub let x = "..."` (every tag below is one line).
//   Module basename match            `ec_quirks.pdx` → `module EcQuirks`.
//   Reserved labels                  Every label prefixed `ecq_`
//                                    (never `loop`, `if`, `let`).
//   klog recipe                      `klog_s1_x1_d1` and `klog_s1_d2`:
//                                    v2 at caller [rsp+0] NOT [rsp+8]
//                                    (the wrapper reads it from
//                                    [rbp+16] after its own push rbp).
//   Fingerprint tag `[u8; N]`        exactly string_length + 1 (for NUL).
//   Error-band compare               staged `mov r11, 0xFFFFFF00; cmp
//                                    rax, r11; jae ...`.
//
// Stack alignment: entry rsp%16==8. 3 pushes → %16==0 (uniform
// across every entrypoint in this file). klog_s1_x1_d1 /
// klog_s1_d2 recipe is `sub rsp, 16; mov [rsp+0], vd; call; add
// rsp, 16` at a 3-push site.
//
// =============================================================================

module EcQuirks = structure {

  // ==========================================================================
  // §A  Row-layout column offsets (bytes, within a 48-byte row).
  //
  // Each column is a u64 (×8-byte stride), so the byte offset of
  // column `c` within a row is `c * 8`. Published as `pub let`
  // constants so a reviewer reading the probe-site arithmetic
  // sees the symbolic offset without a cross-reference to this
  // header.
  // ==========================================================================

  pub let ECQ_COL_VERSION_PATTERN   : u64 = 0
  pub let ECQ_COL_FAN_RPM_SCALE     : u64 = 8
  pub let ECQ_COL_BATTERY_UNIT      : u64 = 16
  pub let ECQ_COL_THERMAL_ZONE_ORD  : u64 = 24
  pub let ECQ_COL_FEATURE_BITS      : u64 = 32
  pub let ECQ_COL_RESERVED          : u64 = 40

  pub let ECQ_ROW_STRIDE_BYTES      : u64 = 48
  pub let ECQ_N_ROWS                : u64 = 8

  // Sentinel for `_ecq_matched_row` when no row has matched (either
  // the probe has not run or no row's version_pattern matched the
  // read-back EC version). Chosen as 0xFF so a one-byte comparison
  // (`cmp r12, 0xFF`) is cheap and the value is OBVIOUSLY not a
  // legal 0..7 row index.
  pub let ECQ_NO_MATCH              : u64 = 0xFF

  // ==========================================================================
  // §B  Architectural defaults
  //
  // Returned by the four getters when `_ecq_matched_row == ECQ_NO_MATCH`.
  // The defaults are IDENTICAL to the seed row 0 field values; this
  // keeps a cold boot on an unrecognised machine running on T14 G4-
  // shaped quirks, which is strictly safer than refusing to boot
  // (the task statement's "default 1 / default 0" annotations in
  // the §scope block of #2567 drove this choice).
  // ==========================================================================

  pub let ECQ_DEFAULT_FAN_RPM_SCALE     : u64 = 1
  pub let ECQ_DEFAULT_BATTERY_UNIT      : u64 = 0
  pub let ECQ_DEFAULT_THERMAL_ZONE_ORD  : u64 = 0x03020100
  pub let ECQ_DEFAULT_FEATURE_BITS      : u64 = 0

  // ==========================================================================
  // §C  Probe-read EC offsets (vendor-defined region, 0x28..0xFF)
  //
  // Rationale in §3 of the file header. The two-byte read packs
  // `(major << 8) | minor`; the follow-up slice may widen to a
  // u32 fingerprint (e.g. 0x28..0x2B) if a vendor row demands
  // finer-grained matching.
  // ==========================================================================

  pub let ECQ_EC_OFF_VERSION_MAJOR  : u64 = 0x28
  pub let ECQ_EC_OFF_VERSION_MINOR  : u64 = 0x29

  // ==========================================================================
  // §D  Handler op argument codes (cap_handler_ec_quirks)
  //
  // Op in op_arg's low byte; the auxiliary byte (feature_bit index
  // for op=5) rides in `op_arg >> 8`. Same encoding ec.pdx
  // EC_HANDLER_OP_WRITE and ec_discovery.pdx ECD_OP_PROBE_COMMAND
  // use, so the cap-dispatch recipe does not re-plumb.
  // ==========================================================================

  pub let ECQ_OP_PROBE                   : u64 = 1
  pub let ECQ_OP_GET_FAN_RPM_SCALE       : u64 = 2
  pub let ECQ_OP_GET_BATTERY_UNIT        : u64 = 3
  pub let ECQ_OP_GET_THERMAL_ZONE_ORDER  : u64 = 4
  pub let ECQ_OP_GET_FEATURE_BIT         : u64 = 5

  // ==========================================================================
  // §E  Return codes — see §4 of the file header.
  // ==========================================================================

  pub let ECQ_OK                     : u64 = 0
  pub let ECQ_ERR_NOT_INITED         : u64 = 0xFFFFFD67
  pub let ECQ_ERR_UNKNOWN_VERSION    : u64 = 0xFFFFFD68
  pub let ECQ_ERR_BAD_FEATURE_IDX    : u64 = 0xFFFFFD69
  pub let ECQ_ERR_DB_FULL            : u64 = 0xFFFFFD6A
  pub let ECQ_ERR_VERSION_MISMATCH   : u64 = 0xFFFFFD6B

  // ==========================================================================
  // §F  KIND_EC_QUIRKS = 0x51 — the cap-table dispatch tag.
  //
  // Added by paideia-os#2567 and wired into `src/kernel/core/cap/
  // invoke.pdx` immediately after the Wave 59 I9 KIND_TPM_CRB
  // (0x4E) arm. 0x4F and 0x50 are left free for sibling parallel-
  // wave Wave 80 landings.
  // ==========================================================================

  pub let KIND_EC_QUIRKS : u64 = 0x51

  // ==========================================================================
  // §G  Mutable state
  //
  //   _ecq_inited        1 iff ec_quirks_probe has been called at
  //                      least once with a non-error outcome.
  //   _ecq_probe_ct      total probe-call count (incremented at
  //                      every call, including UNKNOWN_VERSION
  //                      outcomes).
  //   _ecq_matched_row   0..7 on a successful match, 0xFF
  //                      (ECQ_NO_MATCH) otherwise. Readable
  //                      through `ec_quirks_matched_row()` for
  //                      a boot witness.
  //   _ecq_last_version  the last u16 pattern read by the probe
  //                      ((major<<8)|minor), published for witness
  //                      inspection.
  //   _quirks_db         [u64; 48] — the 8-row quirks database.
  //                      Row 0 is the T14 G4 EC v1.44 seed (§7);
  //                      rows 1..7 are zero-filled (pattern==0 ⇒
  //                      row unused).
  // ==========================================================================

  pub let mut _ecq_inited        : u64 = 0
  pub let mut _ecq_probe_ct      : u64 = 0
  pub let mut _ecq_matched_row   : u64 = 0xFF
  pub let mut _ecq_last_version  : u64 = 0

  // Seeded in-line: row 0 carries the T14 G4 EC v1.44 fingerprint
  // (§7 of the file header). The ARRAY LITERAL form `= [ … ]` is
  // used so the 48 u64s are a frozen `.rodata`-like initialiser;
  // the `mut` is retained because the follow-up slice replaces
  // rows at runtime from a boot-provided quirks image.
  pub let mut _quirks_db : [u64; 48] = [
    // row 0 — T14 G4 EC v1.44
    0x0144, 1, 0, 0x03020100, 0x0001, 0,
    // row 1 — unused (pattern=0)
    0, 0, 0, 0, 0, 0,
    // row 2 — unused
    0, 0, 0, 0, 0, 0,
    // row 3 — unused
    0, 0, 0, 0, 0, 0,
    // row 4 — unused
    0, 0, 0, 0, 0, 0,
    // row 5 — unused
    0, 0, 0, 0, 0, 0,
    // row 6 — unused
    0, 0, 0, 0, 0, 0,
    // row 7 — unused
    0, 0, 0, 0, 0, 0
  ]

  // ==========================================================================
  // §H  Fingerprint tags + keys
  //
  //   EC_QUIRKS PROBE version=0x<4-hex> match_row=<dec>
  //   EC_QUIRKS FAN_SCALE row=<dec> scale=<dec>
  //   EC_QUIRKS BATT_UNIT row=<dec> unit=<dec>
  //
  // Single-line `pub let` string literals per the pdx-encoder-
  // pitfalls memory 2026-09-26. Each `[u8; N]` is exactly
  // string_length + 1 (for the NUL): verified by hand.
  //
  //   "EC_QUIRKS PROBE\0"     = 15 chars + NUL = 16
  //   "EC_QUIRKS FAN_SCALE\0" = 19 chars + NUL = 20
  //   "EC_QUIRKS BATT_UNIT\0" = 19 chars + NUL = 20
  //   "version\0"             =  7 chars + NUL =  8
  //   "match_row\0"           =  9 chars + NUL = 10
  //   "row\0"                 =  3 chars + NUL =  4
  //   "scale\0"               =  5 chars + NUL =  6
  //   "unit\0"                =  4 chars + NUL =  5
  // ==========================================================================

  pub let ecq_tag_probe   : [u8; 16] = "EC_QUIRKS PROBE\0"
  pub let ecq_tag_fan     : [u8; 20] = "EC_QUIRKS FAN_SCALE\0"
  pub let ecq_tag_batt    : [u8; 20] = "EC_QUIRKS BATT_UNIT\0"
  pub let ecq_k_version   : [u8; 8]  = "version\0"
  pub let ecq_k_match_row : [u8; 10] = "match_row\0"
  pub let ecq_k_row       : [u8; 4]  = "row\0"
  pub let ecq_k_scale     : [u8; 6]  = "scale\0"
  pub let ecq_k_unit      : [u8; 5]  = "unit\0"

  // ==========================================================================
  // §I  ec_quirks_probe() -> u64
  //
  // SKELETON: gate on ec_inited(), read the EC version u16 at
  // (ECQ_EC_OFF_VERSION_MAJOR, ECQ_EC_OFF_VERSION_MINOR), scan
  // rows 0..7 for a `_quirks_db[r*6 + 0] == version` match,
  // cache the matched row (or ECQ_NO_MATCH), emit the PROBE
  // fingerprint, return the matched row index on success or
  // ECQ_ERR_UNKNOWN_VERSION on no match.
  //
  // Register plan: entry rsp%16==8. 3 callee-save pushes (r12 =
  // packed version, r13 = matched_row, r14 = scan-loop counter)
  // land rsp%16==0, aligned for every nested CALL without extra
  // pad except the klog_s1_x1_d1 recipe (`sub rsp, 16; mov
  // [rsp+0], vd; call; add rsp, 16`).
  //
  // The scan over `_quirks_db` uses `mov r11, 48; imul rax, r11`
  // (reg-reg form, allowed; the forbidden form is 2-op `imul r,
  // imm`). The error-band check on ec_read_u8 uses the staged
  // `mov r11, 0xFFFFFF00; cmp rax, r11; jae ...` form.
  //
  // Labels prefixed `ecq_pb_`.
  // ==========================================================================

  pub let ec_quirks_probe : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: read EC version via two ec_read_u8 calls at offsets 0x28 (major) and 0x29 (minor), pack `(major<<8)|minor`, scan the 8-row quirks DB for a `_quirks_db[r*6+0] == version` match, cache the matched row index (or ECQ_NO_MATCH), emit the PROBE fingerprint, return the matched row or ECQ_ERR_UNKNOWN_VERSION. Gates in order so an operator sees the first failure: (1) ec_inited()==0 -> ECQ_ERR_NOT_INITED (facade is the hardware floor; a reversed boot order lands here). (2) ec_read_u8 refusal (error band 0xFFFFFF**) -> ECQ_ERR_NOT_INITED (the facade's own gates refused; propagated here as NOT_INITED because the EC-facade distinction between a facade-uninited state and a read-refused state is NOT visible to the quirks consumer — both mean 'no version to match'). (3) scan finds no row with matching pattern -> ECQ_ERR_UNKNOWN_VERSION, cache ECQ_NO_MATCH, FINGERPRINT STILL EMITTED (the version is still useful log data). Row stride ×48 uses `mov r11, 48; imul rax, r11` (reg-reg form; the forbidden form is 2-op `imul r, imm`). Error-band check uses `mov r11, 0xFFFFFF00; cmp rax, r11; jae ...`. 3-push callee-save prologue (r12=packed version, r13=matched_row, r14=scan loop idx) lands rsp%16==0 for every nested CALL; klog_s1_x1_d1 uses the sub-16 recipe. Labels prefixed `ecq_pb_`.",
      block: {
        push r12;
        push r13;
        push r14;

        // --- (1) EC facade must be initialised.
        call ec_inited;
        cmp rax, 0;
        je  ecq_pb_notinit;

        // --- (2a) Read major version byte at EC offset 0x28.
        mov rdi, 0x28;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae ecq_pb_notinit;
        mov r12, rax;                        // r12 = major byte

        // --- (2b) Read minor version byte at EC offset 0x29.
        mov rdi, 0x29;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae ecq_pb_notinit;

        // --- Pack version: r12 = (major << 8) | minor.
        shl r12, 8;
        or  r12, rax;

        // --- Stash _ecq_last_version.
        mov [rip + _ecq_last_version], r12;

        // --- Bump probe count.
        mov rax, [rip + _ecq_probe_ct];
        add rax, 1;
        mov [rip + _ecq_probe_ct], rax;

        // --- (3) Scan rows 0..7 for a pattern match.
        xor r14, r14;                        // r14 = row idx = 0

      ecq_pb_scan:
        cmp r14, 8;
        jae ecq_pb_nomatch;

        // row_base = &_quirks_db[r14 * 6]  (6 u64 per row = 48 B stride)
        mov rax, r14;
        mov r11, 48;
        imul rax, r11;                       // reg-reg form, allowed
        lea r11, [rip + _quirks_db];
        add r11, rax;
        // Read pattern = row_base[0].
        mov rax, [r11 + 0];
        // Skip unused rows (pattern == 0).
        cmp rax, 0;
        je  ecq_pb_scan_next;
        // Compare against the version just read.
        cmp rax, r12;
        je  ecq_pb_matched;

      ecq_pb_scan_next:
        add r14, 1;
        jmp ecq_pb_scan;

      ecq_pb_matched:
        // Cache the matched row index + flip the inited latch.
        mov [rip + _ecq_matched_row], r14;
        mov r13, r14;                        // r13 = matched_row for fingerprint
        mov rax, 1;
        mov [rip + _ecq_inited], rax;

        // --- Emit PROBE fingerprint: version=0x<hex> match_row=<dec>
        //      klog_s1_x1_d1 signature (vd on caller stack at [rsp+0]):
        //        rdi = level, rsi = subsys, rdx = tag,
        //        rcx = kx (version), r8 = vx (version u16),
        //        r9  = kd (match_row), [rsp+0] = vd (match_row dec)
        sub rsp, 16;
        mov [rsp + 0], r13;                  // vd = match_row
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ecq_tag_probe];
        lea rcx, [rip + ecq_k_version];
        mov r8, r12;                         // vx = packed version (hex)
        lea r9, [rip + ecq_k_match_row];
        call klog_s1_x1_d1;
        add rsp, 16;

        mov rax, r13;                        // return matched_row
        pop r14;
        pop r13;
        pop r12;
        ret;

      ecq_pb_nomatch:
        // No row matched. Cache the no-match sentinel, STILL emit the
        // fingerprint (the probe's version read is useful log data),
        // return ECQ_ERR_UNKNOWN_VERSION.
        mov rax, 0xFF;
        mov [rip + _ecq_matched_row], rax;
        mov r13, rax;                        // r13 = 0xFF for fingerprint

        sub rsp, 16;
        mov [rsp + 0], r13;                  // vd = 0xFF
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ecq_tag_probe];
        lea rcx, [rip + ecq_k_version];
        mov r8, r12;                         // vx = version (hex)
        lea r9, [rip + ecq_k_match_row];
        call klog_s1_x1_d1;
        add rsp, 16;

        mov rax, 0xFFFFFD68;                 // ECQ_ERR_UNKNOWN_VERSION
        pop r14;
        pop r13;
        pop r12;
        ret;

      ecq_pb_notinit:
        mov rax, 0xFFFFFD67;                 // ECQ_ERR_NOT_INITED
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // §J  ec_quirks_get_fan_rpm_scale() -> u64
  //
  // Returns `_quirks_db[matched_row*6 + 1]` (fan_rpm_scale column)
  // when `_ecq_matched_row != ECQ_NO_MATCH`; otherwise returns the
  // architectural default (ECQ_DEFAULT_FAN_RPM_SCALE = 1). Emits
  // the FAN_SCALE fingerprint on either path (the DEFAULT path
  // reports row=0xFF so a boot witness can see the no-match case).
  //
  // Register plan: entry rsp%16==8. 3 callee-save pushes (rbx =
  // scratch, r12 = matched_row, r13 = scale value) land rsp%16==0
  // for every nested CALL; klog_s1_d2 uses the sub-16 recipe
  // (v2 at caller [rsp+0]). Labels prefixed `ecq_fs_`.
  // ==========================================================================

  pub let ec_quirks_get_fan_rpm_scale : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: single-field getter for the fan_rpm_scale column (byte offset 8 within a row). Reads `_ecq_matched_row`; on ECQ_NO_MATCH (0xFF) returns ECQ_DEFAULT_FAN_RPM_SCALE (1). On a legal row, computes row_base via `mov r11, 48; imul rax, r11` (reg-reg form) and loads [row_base + 8]. Emits FAN_SCALE fingerprint (row=dec, scale=dec) via klog_s1_d2 at caller [rsp+0]. 3-push prologue (rbx dummy, r12=matched_row, r13=scale) lands rsp%16==0 for the klog CALL; sub-16 recipe keeps the stack-arg frame aligned. Labels prefixed `ecq_fs_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Load _ecq_matched_row into r12.
        mov r12, [rip + _ecq_matched_row];

        // --- No-match path -> default = 1.
        cmp r12, 0xFF;
        je  ecq_fs_default;

        // --- Legal row (r12 < 8); compute row_base + col_offset.
        mov rax, r12;
        mov r11, 48;
        imul rax, r11;                       // row * 48 (bytes); reg-reg
        lea r11, [rip + _quirks_db];
        add r11, rax;
        mov r13, [r11 + 8];                  // fan_rpm_scale at col offset 8
        jmp ecq_fs_emit;

      ecq_fs_default:
        mov r13, 1;                          // ECQ_DEFAULT_FAN_RPM_SCALE

      ecq_fs_emit:
        // --- Emit FAN_SCALE fingerprint: row=<dec> scale=<dec>
        //      klog_s1_d2 signature (v2 on caller stack at [rsp+0]):
        //        rdi = level, rsi = subsys, rdx = tag,
        //        rcx = k1 (row), r8 = v1 (row dec),
        //        r9  = k2 (scale), [rsp+0] = v2 (scale dec)
        sub rsp, 16;
        mov [rsp + 0], r13;                  // v2 = scale
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ecq_tag_fan];
        lea rcx, [rip + ecq_k_row];
        mov r8, r12;                         // v1 = matched_row (dec; 0xFF on default)
        lea r9, [rip + ecq_k_scale];
        call klog_s1_d2;
        add rsp, 16;

        mov rax, r13;                        // return scale
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  ec_quirks_get_battery_unit() -> u64
  //
  // Returns `_quirks_db[matched_row*6 + 2]` (battery_unit column) when
  // `_ecq_matched_row != ECQ_NO_MATCH`; otherwise returns the
  // architectural default (ECQ_DEFAULT_BATTERY_UNIT = 0 = mWh).
  // Emits BATT_UNIT fingerprint on either path.
  //
  // Register plan same as §J; labels prefixed `ecq_bu_`.
  // ==========================================================================

  pub let ec_quirks_get_battery_unit : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: single-field getter for the battery_unit column (byte offset 16 within a row). Same shape as §J for fan_rpm_scale. On ECQ_NO_MATCH, returns ECQ_DEFAULT_BATTERY_UNIT (0 = mWh). Row-stride ×48 via `mov r11, 48; imul rax, r11` (reg-reg). Emits BATT_UNIT fingerprint via klog_s1_d2. 3-push prologue + sub-16 klog recipe. Labels prefixed `ecq_bu_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, [rip + _ecq_matched_row];

        cmp r12, 0xFF;
        je  ecq_bu_default;

        mov rax, r12;
        mov r11, 48;
        imul rax, r11;                       // row * 48 (bytes)
        lea r11, [rip + _quirks_db];
        add r11, rax;
        mov r13, [r11 + 16];                 // battery_unit at col offset 16
        jmp ecq_bu_emit;

      ecq_bu_default:
        xor r13, r13;                        // ECQ_DEFAULT_BATTERY_UNIT = 0

      ecq_bu_emit:
        sub rsp, 16;
        mov [rsp + 0], r13;                  // v2 = unit
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ecq_tag_batt];
        lea rcx, [rip + ecq_k_row];
        mov r8, r12;                         // v1 = matched_row (dec)
        lea r9, [rip + ecq_k_unit];
        call klog_s1_d2;
        add rsp, 16;

        mov rax, r13;                        // return unit
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  ec_quirks_get_thermal_zone_order() -> u64
  //
  // Leaf: returns `_quirks_db[matched_row*6 + 3]` (thermal_zone_order
  // column) when `_ecq_matched_row != ECQ_NO_MATCH`; otherwise returns
  // ECQ_DEFAULT_THERMAL_ZONE_ORD (0x03020100). No fingerprint — this
  // getter is called from the Wave 74 D10 thermal driver's init path
  // which emits its own THERMAL_INIT frame; adding a frame here would
  // double-log.
  //
  // SysV: no args. Register plan: no callee-save pushes needed
  // (leaf; no nested calls). Labels prefixed `ecq_tz_`.
  // ==========================================================================

  pub let ec_quirks_get_thermal_zone_order : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: single-load getter for the thermal_zone_order column (byte offset 24 within a row). Leaf; no nested calls so no alignment pad. On ECQ_NO_MATCH, returns ECQ_DEFAULT_THERMAL_ZONE_ORD (0x03020100). Row-stride ×48 via `mov r11, 48; imul rax, r11` (reg-reg). No fingerprint emission because the Wave 74 D10 thermal driver's own THERMAL_INIT frame covers this read; a second frame would double-log. Labels prefixed `ecq_tz_`.",
      block: {
        mov rax, [rip + _ecq_matched_row];
        cmp rax, 0xFF;
        je  ecq_tz_default;

        // row_base = &_quirks_db[matched_row * 6]
        mov r11, 48;
        imul rax, r11;                       // row * 48 (bytes)
        lea r11, [rip + _quirks_db];
        add r11, rax;
        mov rax, [r11 + 24];                 // thermal_zone_order at col offset 24
        ret;

      ecq_tz_default:
        mov rax, 0x03020100;                 // ECQ_DEFAULT_THERMAL_ZONE_ORD
        ret
      }
    }

  // ==========================================================================
  // §M  ec_quirks_get_feature_bit(idx) -> u64
  //
  // Returns 0 or 1 — bit `idx` of the feature_bits column at
  // `_quirks_db[matched_row*6 + 4]`. The error 0xFFFFFD69
  // (ECQ_ERR_BAD_FEATURE_IDX) is returned for `idx >= 32` because
  // the feature_bits column is a u32 (the upper 32 bits of the
  // u64 are reserved for a follow-up extension).
  //
  // On ECQ_NO_MATCH, returns bit `idx` of ECQ_DEFAULT_FEATURE_BITS
  // (= 0) — i.e. uniformly 0 for every legal idx. No fingerprint.
  //
  // SysV: rdi = idx. Register plan: no callee-save pushes needed
  // (leaf). Labels prefixed `ecq_fb_`.
  // ==========================================================================

  pub let ec_quirks_get_feature_bit : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: bit-indexed getter for the feature_bits column (byte offset 32 within a row). The feature_bits column is a u32, so idx>=32 refuses with ECQ_ERR_BAD_FEATURE_IDX (0xFFFFFD69). On ECQ_NO_MATCH, returns bit `idx` of ECQ_DEFAULT_FEATURE_BITS (= 0), which is uniformly 0. Row-stride ×48 via `mov r11, 48; imul rax, r11` (reg-reg). Bit extraction via `shr feature_bits, idx; and feature_bits, 1`; idx uses rcx-via-cl so the `shr r,cl` form is encoded directly. Labels prefixed `ecq_fb_`.",
      block: {
        // --- idx bounds check: idx < 32.
        cmp rdi, 32;
        jae ecq_fb_badidx;

        // --- Load matched row.
        mov rax, [rip + _ecq_matched_row];
        cmp rax, 0xFF;
        je  ecq_fb_default;

        // row_base = &_quirks_db[matched_row * 6]
        mov r11, 48;
        imul rax, r11;                       // row * 48 (bytes)
        lea r11, [rip + _quirks_db];
        add r11, rax;
        mov rax, [r11 + 32];                 // feature_bits at col offset 32

        // --- Extract bit idx via shr rax, cl; and rax, 1.
        mov rcx, rdi;                        // cl = idx (low byte)
        shr rax, cl;
        and rax, 1;
        ret;

      ecq_fb_default:
        // ECQ_DEFAULT_FEATURE_BITS = 0; any bit of 0 is 0.
        xor rax, rax;
        ret;

      ecq_fb_badidx:
        mov rax, 0xFFFFFD69;                 // ECQ_ERR_BAD_FEATURE_IDX
        ret
      }
    }

  // ==========================================================================
  // §N  cap_handler_ec_quirks(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch stub the KIND_EC_QUIRKS (0x51) arm in cap/invoke.pdx
  // calls. Routes by op_arg's low byte:
  //
  //   op == ECQ_OP_PROBE                   (1) -> ec_quirks_probe()
  //   op == ECQ_OP_GET_FAN_RPM_SCALE       (2) -> ec_quirks_get_fan_rpm_scale()
  //   op == ECQ_OP_GET_BATTERY_UNIT        (3) -> ec_quirks_get_battery_unit()
  //   op == ECQ_OP_GET_THERMAL_ZONE_ORDER  (4) -> ec_quirks_get_thermal_zone_order()
  //   op == ECQ_OP_GET_FEATURE_BIT         (5) -> ec_quirks_get_feature_bit(op_arg >> 8)
  //   otherwise                                -> INVOKE_UNSUPPORTED
  //
  // Rights and target_ptr are IGNORED at skeleton stage; the follow-
  // up slice may add a rights gate (R_ECQ_READ) once the
  // KIND_EC_QUIRKS cap is minted against a specific principal.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg. Register
  // plan: 3-push callee-save prologue (rbx = op_arg, r12 = op
  // code, r13 scratch); entry rsp%16==8, after 3 pushes rsp%16==0.
  // Labels prefixed `ecq_h_`.
  // ==========================================================================

  pub let cap_handler_ec_quirks : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: cap-table dispatch stub for KIND_EC_QUIRKS (0x51). The cmp-chain over {1..5} is one branch per legal op (not a jump table) because five live values occupy less bytecode as a chain. Op in op_arg's low byte; op=5 (GET_FEATURE_BIT) unpacks a bit-index from `op_arg >> 8`. The op is masked to the low byte via `and r12, 0xFF` on entry so a caller that leaves garbage in the high bytes of op_arg does not accidentally match. Unknown op returns INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC), not an ECQ_ERR_* code — the latter names a quirks-plumbing bug, this names a cap-dispatch bug. Rights and target_ptr are ACCEPTED but IGNORED at skeleton stage. 3-push prologue aligns rsp%16==0 for every nested CALL. Labels prefixed `ecq_h_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdx;                        // rbx = op_arg (preserve)
        mov r12, rdx;                        // r12 = op
        and r12, 0xFF;                       // mask to low byte (imm32-safe)

        // --- Opcode dispatch.
        cmp r12, 1;                          // ECQ_OP_PROBE
        je  ecq_h_probe;
        cmp r12, 2;                          // ECQ_OP_GET_FAN_RPM_SCALE
        je  ecq_h_fan;
        cmp r12, 3;                          // ECQ_OP_GET_BATTERY_UNIT
        je  ecq_h_batt;
        cmp r12, 4;                          // ECQ_OP_GET_THERMAL_ZONE_ORDER
        je  ecq_h_tz;
        cmp r12, 5;                          // ECQ_OP_GET_FEATURE_BIT
        je  ecq_h_fb;

        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_h_probe:
        call ec_quirks_probe;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_h_fan:
        call ec_quirks_get_fan_rpm_scale;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_h_batt:
        call ec_quirks_get_battery_unit;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_h_tz:
        call ec_quirks_get_thermal_zone_order;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecq_h_fb:
        mov rdi, rbx;
        shr rdi, 8;                          // idx = op_arg >> 8
        call ec_quirks_get_feature_bit;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  Stat getters — single-load leaves for witness callers
  //
  // Parallel to ec.pdx / battery.pdx / thermal.pdx / fan.pdx getter
  // sets. A boot witness can assert
  //
  //   ec_quirks_inited()        == 1
  //   AND ec_quirks_matched_row() <= 7 OR == 0xFF (ECQ_NO_MATCH)
  //   AND ec_quirks_last_version() != 0
  //
  // after a smoke run that drives cap_handler_ec_quirks with op=1.
  // ==========================================================================

  pub let ec_quirks_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: single-load getter for _ecq_inited. Non-zero after the first successful ec_quirks_probe (even on UNKNOWN_VERSION the latch flips, because the probe RAN; the matched_row is the finer-grained signal). Leaf.",
      block: { mov rax, [rip + _ecq_inited]; ret }
    }

  pub let ec_quirks_matched_row : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: single-load getter for _ecq_matched_row. 0..7 on a successful match, 0xFF (ECQ_NO_MATCH) otherwise. Leaf.",
      block: { mov rax, [rip + _ecq_matched_row]; ret }
    }

  pub let ec_quirks_probe_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: single-load getter for _ecq_probe_ct. Bumped once per ec_quirks_probe call (including UNKNOWN_VERSION outcomes). Leaf.",
      block: { mov rax, [rip + _ecq_probe_ct]; ret }
    }

  pub let ec_quirks_last_version : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2567 (Wave 80 I10) skeleton: single-load getter for _ecq_last_version. The u16 version pattern read on the LAST probe call. Zero until the first probe. Leaf.",
      block: { mov rax, [rip + _ecq_last_version]; ret }
    }
}
