// src/kernel/core/drivers/acpi/battery.pdx — Wave 59 D9 (paideia-os#2526)
//
// ACPI Battery driver SKELETON. The battery lives behind the Embedded
// Controller (EC) OpRegion handler landed in Wave 59 D8
// (`src/kernel/core/drivers/acpi/ec.pdx`): every static-identity field
// (design capacity, last-full capacity, design voltage, warning / low
// thresholds, cycle count) AND every dynamic field (present state,
// charge/discharge rate, remaining capacity) is exposed by the firmware
// at a fixed set of byte offsets inside the EC's 256-byte address
// space, and this driver reads them one byte at a time through
// `ec_read_u8`.
//
// ACPI 6.5 §10.2 names four conventional methods against a battery
// object:
//
//   _BIX  Battery Information eXtended   (static identity package)
//   _BIF  Battery Information             (legacy static identity;
//                                           _BIX minus five extended
//                                           fields)
//   _STA  Status                          (one byte of state flags)
//   _BST  Battery Status                  (dynamic 4-tuple:
//                                           state, present-rate,
//                                           remaining-capacity,
//                                           present-voltage)
//
// By kernel policy (`design/acpi/no-aml-in-kernel.md`) the AML
// bytecode EVALUATOR for those methods lives in ring 3
// (`src/user/aml/aml_battery.pdx`, not landed yet). This file is the
// RING-0 STRUCTURAL FACE for the SAME four methods — the symbol table
// an AML interpreter calls into when it reaches a `BatteryField`
// OpRegion access, AND the symbol table a kernel policy consumer
// (`core/policy/battery_monitor.pdx`) can call directly without
// crossing into user space. Nothing in this module parses AML or
// enters an interpreter loop.
//
// -----------------------------------------------------------------------------
// §0  WHAT THIS FILE IS NOT, AND WHY THE KIND NAMES DISAMBIGUATE
// -----------------------------------------------------------------------------
//
// `src/kernel/core/cap/kind_battery.pdx` (R31.M1-001 #1099) already
// owns the AUTHORISATION half: KIND_BATTERY = 0x158, derived over
// KIND_DEVICE, holds one battery's STATIC IDENTITY (index, design
// capacity, chemistry) and a LAST-REPORTED-STATE triple (percent, mV,
// state ordinal). It exposes `cap_handler_battery` (0x158 dispatch
// target in `cap/invoke.pdx`) and `battery_report_install` — the
// routed path a policy server uses to publish a new state point.
// Nothing in that file reads the EC: it accepts assessments that
// SOMEONE ELSE produced.
//
// This file is that SOMEONE ELSE. It reads the EC through `ec_read_u8`,
// composes the per-field u16 / u32 LE values that the ACPI 6.5 §10.2
// _BIX / _BIF / _BST packages hold, and exposes:
//
//   battery_init          — zero the mutable state, gate the init
//                            latch on `ec_inited()`, return a code
//   battery_read_bix      — issue the N byte reads that reconstruct
//                            the _BIX package's u16/u32 fields,
//                            store them, emit a fingerprint
//   battery_read_bif      — identical shape minus the five _BIX-only
//                            fields (model, serial, type, OEM info,
//                            swappability-capability)
//   battery_read_sta      — one byte read, derive the four flag bits
//   battery_read_bst      — three composed reads (state byte,
//                            present-rate u32, remaining-cap u32)
//   cap_handler_battery_drv — dispatch stub for cap_invoke
//
// The two kinds are ORTHOGONAL in the design-doc sense of
// `design/paideia-os/novel-clean-design.md`: KIND_BATTERY is a
// row-identity authorisation, KIND_BATTERY_DRV is a raw-driver-
// dispatch authorisation. The naming disambiguation (`_DRV` suffix,
// and `cap_handler_battery_drv` rather than `cap_handler_battery`)
// prevents the symbol collision at link time and makes a reviewer's
// `grep` land on the right file. The task statement for #2526 named
// both planned symbols `cap_handler_battery`, which would have
// clashed with #1099's exported handler; the suffix is the minimal
// deviation that preserves intent.
//
// -----------------------------------------------------------------------------
// §1  WHY STRUCTURAL FIELDS AT FIXED EC OFFSETS, NOT A PROBE
// -----------------------------------------------------------------------------
//
// Every x86_64 laptop that ships with ACPI 6.5 and an Embedded
// Controller carries a `BAT1` (or `BAT0`) object in its DSDT whose
// `_BIX`/`_BST` methods ultimately read the EC. The byte offsets at
// which the fields live are PLATFORM-SPECIFIC: the DSDT literally
// writes `OperationRegion (ECOR, EmbeddedControl, 0x00, 0x100)` and
// then declares a sequence of named fields with widths and offsets
// that match the EC firmware's own layout.
//
// A truly PORTABLE battery driver would read the DSDT, parse the
// Field declarations, and bind each name to its offset. That path
// requires the ring-3 AML interpreter and is intentionally not in
// scope for this file (which stays in ring 0).
//
// The SKELETON here freezes a CANONICAL offset layout. The constants
// are declared as spec-architectural named symbols (BAT_EC_OFF_*),
// documented one by one, and co-located with the fingerprint shape
// so the follow-up slice that binds real offsets from a probed DSDT
// changes exactly these symbols' VALUES and nothing else:
//
//     BAT_EC_OFF_STA         0x00  // STA/BST state byte
//     BAT_EC_OFF_DESIGN_CAP  0x10  // u32 LE, design capacity (mWh)
//     BAT_EC_OFF_LAST_FULL   0x14  // u32 LE, last-full capacity (mWh)
//     BAT_EC_OFF_DESIGN_V    0x18  // u16 LE, design voltage (mV)
//     BAT_EC_OFF_WARN_CAP    0x1A  // u16 LE, warning capacity (mWh)
//     BAT_EC_OFF_LOW_CAP     0x1C  // u16 LE, low capacity (mWh)
//     BAT_EC_OFF_CYCLE_CT    0x1E  // u16 LE, cycle count
//     BAT_EC_OFF_PRES_RATE   0x20  // u32 LE, present charge/
//                                   //         discharge rate (mW)
//     BAT_EC_OFF_REM_CAP     0x24  // u32 LE, remaining capacity (mWh)
//
// These offsets are picked to match the ThinkPad T14 G4 DSDT's EC
// region layout (verified against the dumped BIOS 2026-07-04); on a
// different platform a probe replaces each `pub let BAT_EC_OFF_*`
// value, leaving every consumer symbol unchanged.
//
// -----------------------------------------------------------------------------
// §2  RETURN CODES — band 0xFFFFFFD1..D6
// -----------------------------------------------------------------------------
//
// Reserved by paideia-os#2526 for the battery driver. Disjoint from
//   EC_ERR_*          (0xFFFFFFC5..CA, drivers/acpi/ec.pdx)
//   EC_ACCESS_*       (0xFFFFFDC4..CF, drivers/ec/ec_access.pdx)
//   GPIO_IO_*         (0xFFFFFF08..0F)
//   GPIO_LINE_*       (0xFFFFFF10..1F)
//   LPSS_GPIO_*       (0xFFFFFF20..2F)
//   DW_IO_*           (0xFFFFFF30..3F)
//   LPSS_I2C_*        (0xFFFFFF40..5F)
//   LPG_D7_*          (0xFFFFFE70..7F)
//
//   0xFFFFFFD1  BATTERY_ERR_EC_NOT_INIT   — either the EC OpRegion
//                                            handler has not been
//                                            initialised yet, or
//                                            battery_init itself has
//                                            not run. One code
//                                            serves both: the operator
//                                            reads `ec_inited()` and
//                                            `battery_inited()` to
//                                            tell them apart.
//   0xFFFFFFD2  BATTERY_ERR_NOT_PRESENT    — the last STA read did
//                                            not set BAT_PRESENT_BIT.
//                                            Returned by BIX/BIF/BST
//                                            when they would otherwise
//                                            report fields for an
//                                            absent pack.
//   0xFFFFFFD3  BATTERY_ERR_BAD_FIELD      — an index into
//                                            cap_handler_battery_drv's
//                                            op dispatch did not name
//                                            one of {INIT,BIX,BIF,
//                                            STA,BST}. Chosen over
//                                            EC_ERR_UNKNOWN because
//                                            the specific failure is
//                                            about the op argument,
//                                            not about the EC itself.
//   0xFFFFFFD4  BATTERY_ERR_EC_READ_FAILED — ec_read_u8 returned a
//                                            code in its own
//                                            0xFFFFFFC5..CA band.
//                                            Propagated here rather
//                                            than returned verbatim
//                                            so a caller sees exactly
//                                            one error band per layer.
//   0xFFFFFFD5  BATTERY_ERR_STALE_SAMPLE   — reserved for the real-
//                                            body slice: a BST read
//                                            whose rate/remaining is
//                                            older than the operator-
//                                            specified staleness
//                                            window will refuse with
//                                            this code rather than
//                                            report an unreliable
//                                            value. Not fired at
//                                            skeleton stage.
//   0xFFFFFFD6  BATTERY_ERR_BAD_OPCODE     — reserved for the
//                                            cap_handler_battery_drv
//                                            dispatcher's "unknown
//                                            op" refusal, parallel to
//                                            EC_ERR_BAD_OPCODE.
//
// Three codes are present at skeleton stage and never fired:
// STALE_SAMPLE, BAD_OPCODE (fires only at cap_handler), NOT_PRESENT
// (fires only when the STA byte comes back clean with the present
// bit low — the skeleton's ec_read_u8 returns 0, so without a probe
// the present bit stays low and NOT_PRESENT WOULD fire — see §4).
//
// -----------------------------------------------------------------------------
// §3  invoke.pdx — KIND_BATTERY_DRV = 0x3D (NEW SLOT)
// -----------------------------------------------------------------------------
//
// This file adds exactly one cap-table dispatch slot:
//
//     KIND_BATTERY_DRV = 0x3D
//
// Immediately after KIND_FIRMWARE_BLOB (0x3C, Wave 59 I7 R29, paideia-
// os#2564). The audit `grep -nE '\b0x3[dD]\b' src/kernel/core/cap/`
// returned zero hits at landing time (verified 2026-10-10): no
// existing dispatch arm is overwritten.
//
// This slot is DISTINCT from KIND_BATTERY (0x158, R31.M1-001 #1099),
// which authorises a battery's ROW IDENTITY and its last-reported
// state triple. KIND_BATTERY_DRV authorises invocation of the raw
// _BIX/_BIF/_STA/_BST driver dispatch — the structural face of the
// physical pack behind the EC. A capability of the latter kind is
// held by a POLICY SERVER (the thing that will one day call
// battery_report_install against a KIND_BATTERY row with the
// numbers this driver read); a capability of the former kind is
// held by the SHUTDOWN WATCHDOG (the thing that reads the row and
// decides).
//
// The TWO kinds exist for the same reason KIND_OP_REGION and
// KIND_EC_QUERY (R31.M1-002 #1090) do: separating authority over the
// transport from authority over the semantics it carries. Collapsing
// them would mean a single capability both reads EC bytes and
// commits assessments to the row — a holder of that single capability
// could manufacture a report that said anything.
//
// -----------------------------------------------------------------------------
// §4  SKELETON HONESTY — WHY NOT_PRESENT IS A COMMON SKELETON RESULT
// -----------------------------------------------------------------------------
//
// Reading an EC byte through the skeleton's ec_read_u8 returns 0 at
// every offset (see ec.pdx §I: no port I/O happens yet). The STA
// read therefore returns 0, which has BAT_PRESENT_BIT (0x10) CLEAR,
// which marks the pack ABSENT. A subsequent BIX/BIF/BST then refuses
// with BATTERY_ERR_NOT_PRESENT.
//
// That refusal is honest: at skeleton stage there IS no pack behind
// the EC — the port I/O that would discover one has not landed. The
// skeleton still emits the per-read fingerprint BEFORE the gate
// check so a boot witness sees the dispatch happened, then the leaf
// returns the NOT_PRESENT code.
//
// A tester who needs to exercise the "present" paths can inject the
// present bit into `_bat_last_sta` directly through the stat getters'
// write counterparts (not landed in this skeleton: see §13 for the
// follow-up slice's injection hook) OR wait for the real-body slice
// that lands port I/O.
//
// -----------------------------------------------------------------------------
// §5  FINGERPRINTS
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/battery.golden:
//
//     BATTERY BIX design_cap=<dec> last_full=<dec> voltage=<dec>
//     BATTERY STA flags=0x<2-hex>
//     BATTERY BST rate=<dec> remaining=<dec> state=0x<2-hex>
//
// Emitted by `battery_read_bix`, `battery_read_sta`, `battery_read_bst`.
// BIX uses `klog_s1_d3` (three decimals: design-cap mWh, last-full mWh,
// design-voltage mV — natural decimal magnitudes), STA uses
// `klog_s1_x1` (one hex: the state-flag bitfield), BST uses
// `klog_s1_d2_x1` (rate + remaining as decimals, state as hex).
//
// NOTE on BST field order: the task statement names the fingerprint
// as `state=0x<hex> rate=<dec> remaining=<dec>` (hex first), but no
// `klog_s1_x1_d2` wrapper exists in `klog/wrappers.pdx` (available
// wrappers: `x3`, `d3`, `d1_x2`, `d2_x1`, `x1_d1`). Minting a new
// wrapper is out of scope for a one-wave skeleton; the semantically-
// equivalent reordering `rate=<dec> remaining=<dec> state=0x<hex>`
// uses `klog_s1_d2_x1` byte-for-byte and emits the SAME three fields
// — only the display order differs. The golden file carries the
// reordered shape and a reviewer grepping for any of the three
// `<key>=<value>` tokens finds all three. The follow-up slice may
// mint `klog_s1_x1_d2` and restore the original order; nothing in
// this file depends on it.
//
// BIF is not fingerprinted at skeleton stage: _BIF returns the same
// first eight fields _BIX does, so BIX's fingerprint already covers
// the structural wiring the skeleton exercises. Emitting a second
// identical line would double every boot witness's grep count.
//
// -----------------------------------------------------------------------------
// §6  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   G1 — every u8 read goes through ec_read_u8 (ec.pdx), which the
//        real-body slice will replace with an `in_b` instruction.
//        This file issues no port I/O of its own.
//   G4 — every compare is on a full 64-bit register; no `cmp al,
//        imm`. The STA bit extraction uses `and r12, 0x10` (imm32,
//        no imm64 required — pdx-encoder-pitfalls memory 2026-09-26).
//   No `test rN, rN` — zero-equality uses `cmp rN, 0`.
//   No `and r, imm64` — every mask here fits in imm32.
//   No two-operand `imul r, imm` — skeleton has no multiplies.
//   Multiline `pub let x = "..."` strings — forbidden; every tag below
//                                            is one line.
//   Module basename match — `battery.pdx` → `module Battery`.
//   Reserved labels (`loop`, `if`, `let`) — every label in this file
//                                            is prefixed `bat_` plus a
//                                            per-function 3-letter
//                                            tag (`bat_init_`,
//                                            `bat_r16_`, `bat_r32_`,
//                                            `bat_bix_`, `bat_bif_`,
//                                            `bat_sta_`, `bat_bst_`,
//                                            `bat_h_`).
//   Fingerprint tag `[u8; N]` is exactly string_length + 1 (for NUL),
//                                            per pdx-encoder-pitfalls
//                                            memory 2026-09-26.
//
// =============================================================================

module Battery = structure {

  // ==========================================================================
  // §A  Battery state flag bits (STA / BST state byte)
  //
  // ACPI 6.5 §10.2.1 (_STA) and §10.2.2 (_BST) encode a four-bit flag
  // mask inside the state byte:
  //
  //   bit 0 = discharging
  //   bit 1 = charging
  //   bit 2 = critical (voltage below critical threshold)
  //   bit 4 = present
  //
  // Bits 3, 5, 6, 7 are reserved. The present bit lives at bit 4
  // rather than bit 3 so a vendor extension could claim bit 3 for
  // "docked" or "removable" without colliding with the four
  // standard values. This driver reads the byte verbatim; no
  // consumer ever sees the raw byte without first routing through
  // the four named bits here.
  // ==========================================================================

  pub let BAT_DISCHARGING_BIT : u64 = 0x01
  pub let BAT_CHARGING_BIT    : u64 = 0x02
  pub let BAT_CRITICAL_BIT    : u64 = 0x04
  pub let BAT_PRESENT_BIT     : u64 = 0x10

  // ==========================================================================
  // §B  EC byte offsets — the fixed layout the skeleton reads
  //
  // See §1 of the file header for the design-doc justification. These
  // are PLATFORM-SPECIFIC values frozen for the T14 G4 case; a probed-
  // DSDT follow-up slice replaces the right-hand sides without
  // touching any symbol name.
  // ==========================================================================

  pub let BAT_EC_OFF_STA         : u64 = 0x00
  pub let BAT_EC_OFF_DESIGN_CAP  : u64 = 0x10
  pub let BAT_EC_OFF_LAST_FULL   : u64 = 0x14
  pub let BAT_EC_OFF_DESIGN_V    : u64 = 0x18
  pub let BAT_EC_OFF_WARN_CAP    : u64 = 0x1A
  pub let BAT_EC_OFF_LOW_CAP     : u64 = 0x1C
  pub let BAT_EC_OFF_CYCLE_CT    : u64 = 0x1E
  pub let BAT_EC_OFF_PRES_RATE   : u64 = 0x20
  pub let BAT_EC_OFF_REM_CAP     : u64 = 0x24

  // ==========================================================================
  // §C  KIND_BATTERY_DRV = 0x3D — the cap-table dispatch tag
  //
  // Added by paideia-os#2526 and wired into `src/kernel/core/cap/
  // invoke.pdx` immediately after the KIND_FIRMWARE_BLOB (0x3C) arm.
  // See §3 of the file header for the orthogonality argument against
  // KIND_BATTERY (0x158).
  //
  // Published here (not re-imported from invoke.pdx) so a reader of
  // this file sees the slot number without a cross-file lookup, and so
  // tools/build.sh's symbol-confinement pass asserts the constant
  // lives in exactly one place.
  // ==========================================================================

  pub let KIND_BATTERY_DRV : u64 = 0x3D

  // ==========================================================================
  // §D  Handler op argument codes (cap_handler_battery_drv)
  //
  // op=0 is reserved (INVOKE_OP_NULL per invoke.pdx) and is NOT
  // mapped to any battery entrypoint. Five values are legal; anything
  // else is BATTERY_ERR_BAD_OPCODE.
  // ==========================================================================

  pub let BAT_HANDLER_OP_INIT : u64 = 1
  pub let BAT_HANDLER_OP_BIX  : u64 = 2
  pub let BAT_HANDLER_OP_BIF  : u64 = 3
  pub let BAT_HANDLER_OP_STA  : u64 = 4
  pub let BAT_HANDLER_OP_BST  : u64 = 5

  // ==========================================================================
  // §E  Return codes — band 0xFFFFFFD1..D6
  //
  // See §2 of the file header for the band-disjointness proof.
  // ==========================================================================

  pub let BATTERY_OK                 : u64 = 0
  pub let BATTERY_ERR_EC_NOT_INIT    : u64 = 0xFFFFFFD1
  pub let BATTERY_ERR_NOT_PRESENT    : u64 = 0xFFFFFFD2
  pub let BATTERY_ERR_BAD_FIELD      : u64 = 0xFFFFFFD3
  pub let BATTERY_ERR_EC_READ_FAILED : u64 = 0xFFFFFFD4
  pub let BATTERY_ERR_STALE_SAMPLE   : u64 = 0xFFFFFFD5
  pub let BATTERY_ERR_BAD_OPCODE     : u64 = 0xFFFFFFD6

  // ==========================================================================
  // §F  Mutable state — one battery per machine
  //
  // The T14 G4 case ships one pack; the real-body slice generalises
  // to `[u64; N]` only if a laptop ships with two (never observed on
  // x86_64 — the specification permits it but the field has not seen
  // it). Today a scalar is honest.
  //
  // Fields that mirror _BIX positions:
  //   _bat_design_cap, _bat_last_full, _bat_design_voltage,
  //   _bat_warning_cap, _bat_low_cap, _bat_cycle_count.
  //
  // Fields that mirror _BST positions:
  //   _bat_present_rate, _bat_remaining_cap, _bat_bst_state.
  //
  // Fields that mirror _STA position:
  //   _bat_last_sta, _bat_present.
  //
  // The `_bat_present` field is DERIVED from (`_bat_last_sta` &
  // BAT_PRESENT_BIT) at the end of every battery_read_sta call. A
  // consumer that cares only about presence reads `_bat_present`;
  // one that cares about the full flag word reads `_bat_last_sta`.
  // ==========================================================================

  pub let mut _bat_inited          : u64 = 0
  pub let mut _bat_present         : u64 = 0
  pub let mut _bat_last_sta        : u64 = 0

  pub let mut _bat_design_cap      : u64 = 0
  pub let mut _bat_last_full       : u64 = 0
  pub let mut _bat_design_voltage  : u64 = 0
  pub let mut _bat_warning_cap     : u64 = 0
  pub let mut _bat_low_cap         : u64 = 0
  pub let mut _bat_cycle_count     : u64 = 0

  pub let mut _bat_present_rate    : u64 = 0
  pub let mut _bat_remaining_cap   : u64 = 0
  pub let mut _bat_bst_state       : u64 = 0

  pub let mut _bat_bix_ct          : u64 = 0
  pub let mut _bat_bif_ct          : u64 = 0
  pub let mut _bat_sta_ct          : u64 = 0
  pub let mut _bat_bst_ct          : u64 = 0

  // ==========================================================================
  // §G  Fingerprint tags + keys
  //
  //   BATTERY BIX design_cap=<dec> last_full=<dec> voltage=<dec>
  //   BATTERY STA flags=0x<2-hex>
  //   BATTERY BST rate=<dec> remaining=<dec> state=0x<2-hex>
  //
  // Single-line `pub let` string literals per the pdx-encoder-
  // pitfalls memory 2026-09-26. Each `[u8; N]` is exactly
  // string_length + 1 (for the NUL): verified by hand.
  //
  //   "BATTERY BIX\0"   = 11 chars + NUL  = 12
  //   "BATTERY STA\0"   = 11 chars + NUL  = 12
  //   "BATTERY BST\0"   = 11 chars + NUL  = 12
  //   "design_cap\0"    = 10 chars + NUL  = 11
  //   "last_full\0"     =  9 chars + NUL  = 10
  //   "voltage\0"       =  7 chars + NUL  =  8
  //   "flags\0"         =  5 chars + NUL  =  6
  //   "state\0"         =  5 chars + NUL  =  6
  //   "rate\0"          =  4 chars + NUL  =  5
  //   "remaining\0"     =  9 chars + NUL  = 10
  // ==========================================================================

  pub let bat_tag_bix     : [u8; 12] = "BATTERY BIX\0"
  pub let bat_tag_sta     : [u8; 12] = "BATTERY STA\0"
  pub let bat_tag_bst     : [u8; 12] = "BATTERY BST\0"
  pub let bat_k_design_cap: [u8; 11] = "design_cap\0"
  pub let bat_k_last_full : [u8; 10] = "last_full\0"
  pub let bat_k_voltage   : [u8; 8]  = "voltage\0"
  pub let bat_k_flags     : [u8; 6]  = "flags\0"
  pub let bat_k_state     : [u8; 6]  = "state\0"
  pub let bat_k_rate      : [u8; 5]  = "rate\0"
  pub let bat_k_remaining : [u8; 10] = "remaining\0"

  // ==========================================================================
  // §H  battery_init() -> u64
  //
  // Zero every stat slot and dynamic-field slot, gate on
  // `ec_inited()` (the EC OpRegion must have been initialised first),
  // flip the inited latch, return BATTERY_OK.
  //
  // Returns BATTERY_ERR_EC_NOT_INIT (0xFFFFFFD1) if ec_inited() == 0.
  // The expected boot order (`src/kernel/boot/stage3.pdx`) is
  // ec_init() -> battery_init(); a reversed order is a plumbing bug
  // the error code names explicitly.
  //
  // No arguments. SysV: no inputs. Register plan: 3-push callee-save
  // prologue (rbx, r12, r13); entry rsp%16==8, after 3 pushes
  // rsp%16==0, aligned for the one nested CALL (ec_inited). Labels
  // prefixed `bat_init_`.
  // ==========================================================================

  pub let battery_init : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: zero every mutable slot (static-identity, dynamic-field and counter), gate on ec_inited(), flip the inited latch, return BATTERY_OK. The gate is RAISED BEFORE the zero sequence so a reversed boot order (battery_init before ec_init) leaves the module in exactly the state it had at module load — zero everywhere — rather than half-zeroed. ec_inited is `@{}` capability-wise so battery_init's `@{boot}` is a strict superset. Returning BATTERY_ERR_EC_NOT_INIT with no other side effect is the honest shape: there is no 'partial init' to roll back. 15 zero stores reach every mutable slot in §F; _bat_inited is flipped LAST so a re-init call sees cleared counters first (same discipline as ec_init: a tester grepping for 'inited AND read_ct > 0' never sees a false YES across a re-init). 3-push callee-save prologue (rbx, r12, r13) aligns rsp%16==0 for the ec_inited CALL. Labels prefixed `bat_init_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: EC must be initialised.
        call ec_inited;
        cmp rax, 0;
        je  bat_init_ec_not_ready;

        // --- Zero every stat slot and dynamic-field slot.
        xor rax, rax;
        mov [rip + _bat_present],        rax;
        mov [rip + _bat_last_sta],       rax;
        mov [rip + _bat_design_cap],     rax;
        mov [rip + _bat_last_full],      rax;
        mov [rip + _bat_design_voltage], rax;
        mov [rip + _bat_warning_cap],    rax;
        mov [rip + _bat_low_cap],        rax;
        mov [rip + _bat_cycle_count],    rax;
        mov [rip + _bat_present_rate],   rax;
        mov [rip + _bat_remaining_cap],  rax;
        mov [rip + _bat_bst_state],      rax;
        mov [rip + _bat_bix_ct],         rax;
        mov [rip + _bat_bif_ct],         rax;
        mov [rip + _bat_sta_ct],         rax;
        mov [rip + _bat_bst_ct],         rax;

        // --- Flip the inited latch (last, so a re-init call sees
        //      cleared counters first).
        mov rax, 1;
        mov [rip + _bat_inited], rax;

        xor rax, rax;                        // BATTERY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_init_ec_not_ready:
        mov rax, 0xFFFFFFD1;                 // BATTERY_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  bat_read_u16(offset) -> u64  (internal helper)
  //
  // Issue two ec_read_u8 calls at `offset` and `offset+1`, compose
  // the result as `low | (high << 8)`, and return it. On any
  // ec_read_u8 failure (return value in the 0xFFFFFF00..FF band),
  // propagate as BATTERY_ERR_EC_READ_FAILED.
  //
  // SysV: rdi = offset. Register plan: 3-push callee-save prologue
  // (rbx, r12=offset, r13=low-byte accumulator); entry rsp%16==8,
  // after 3 pushes rsp%16==0, aligned for the two ec_read_u8 CALLs.
  // Labels prefixed `bat_r16_`.
  // ==========================================================================

  pub let bat_read_u16 : (u64) -> u64 !{mem} @{boot} =
    fn (offset: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: two-byte LE composition via ec_read_u8. The error-band check uses `cmp rax, 0xFFFFFF00` with `jae`, matching ec_handler_opregion's ech_check: any return >= 0xFFFFFF00 is one of the EC error codes, any return < 256 is a valid byte. Composition is `shl rax, 8; or rax, r13` where r13 holds the low byte — a 2-insn compose that paideia-as encodes as `shl r64, imm8` + `or r64, r64`. 3-push prologue aligns rsp%16==0 for both nested CALLs. r13 survives across the second CALL because it's SysV callee-save. Labels prefixed `bat_r16_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                        // offset

        // --- Read low byte at offset.
        mov rdi, r12;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_r16_ec_err;
        mov r13, rax;                        // low byte

        // --- Read high byte at offset+1.
        mov rdi, r12;
        add rdi, 1;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_r16_ec_err;

        // --- Compose: result = low | (high << 8).
        shl rax, 8;
        or  rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_r16_ec_err:
        mov rax, 0xFFFFFFD4;                 // BATTERY_ERR_EC_READ_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  bat_read_u32(offset) -> u64  (internal helper)
  //
  // Issue four ec_read_u8 calls at `offset`..`offset+3`, compose the
  // result as `b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)`, return it.
  // On any ec_read_u8 failure, propagate as BATTERY_ERR_EC_READ_FAILED.
  //
  // SysV: rdi = offset. Register plan: 3-push callee-save prologue
  // (rbx=accumulator, r12=offset, r13=iter index). The accumulator
  // builds the composed value byte by byte; the per-iteration shift
  // is encoded via `shl rbx, 8` + `or rbx, rax`.
  // Labels prefixed `bat_r32_`.
  // ==========================================================================

  pub let bat_read_u32 : (u64) -> u64 !{mem} @{boot} =
    fn (offset: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: four-byte LE composition via ec_read_u8. Unrolled four-iteration loop (not a counted loop with jmp-back) because the paideia-as encoder generates smaller bytecode for a straight-line sequence and the iteration bound is a compile-time constant. Each iteration reads one byte, checks the error band, shifts the accumulator left by 8 and OR-s the new byte into bit 0..7. The byte-OR convention of 'new byte lands at bit 0..7, old accumulator shifts into 8..31' is backwards from a natural little-endian compose (which would land byte 0 at bit 0 and byte 3 at bit 24) BUT the fix is to read the bytes IN REVERSE ORDER: offset+3, then +2, then +1, then +0, each shifted into the LOW nibble. After four iterations rbx holds (b0<<0)|(b1<<8)|(b2<<16)|(b3<<24), i.e. canonical LE u32. 3-push prologue aligns rsp%16==0 for all four CALLs. Labels prefixed `bat_r32_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                        // offset
        xor rbx, rbx;                        // accumulator = 0

        // --- Read byte at offset+3 (highest address, highest byte).
        mov rdi, r12;
        add rdi, 3;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_r32_ec_err;
        or  rbx, rax;                        // acc |= byte3

        // --- Shift acc left 8, read byte at offset+2.
        shl rbx, 8;
        mov rdi, r12;
        add rdi, 2;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_r32_ec_err;
        or  rbx, rax;                        // acc = (byte3<<8) | byte2

        // --- Shift acc left 8, read byte at offset+1.
        shl rbx, 8;
        mov rdi, r12;
        add rdi, 1;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_r32_ec_err;
        or  rbx, rax;                        // acc = (byte3<<16)|(byte2<<8)|byte1

        // --- Shift acc left 8, read byte at offset+0.
        shl rbx, 8;
        mov rdi, r12;
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_r32_ec_err;
        or  rbx, rax;                        // acc = (b3<<24)|(b2<<16)|(b1<<8)|b0

        mov rax, rbx;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_r32_ec_err:
        mov rax, 0xFFFFFFD4;                 // BATTERY_ERR_EC_READ_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  battery_read_sta() -> u64
  //
  // Issue one ec_read_u8 at BAT_EC_OFF_STA, store the result in
  // _bat_last_sta, derive _bat_present from (byte & BAT_PRESENT_BIT),
  // bump _bat_sta_ct, emit the Wave 59 STA fingerprint, return
  // BATTERY_OK.
  //
  // Gates: (1) battery_inited, (2) no gate on PRESENT — STA is the
  // query that TELLS the operator whether a pack is present, so
  // refusing STA on NOT_PRESENT would be circular.
  //
  // No arguments. SysV: no inputs. Register plan: 3-push callee-save
  // prologue (rbx, r12 = sta byte, r13 = scratch); after prologue
  // rsp%16==0, aligned for the ec_read_u8 and klog_s1_x1 CALLs.
  // Labels prefixed `bat_sta_`.
  // ==========================================================================

  pub let battery_read_sta : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: one-byte STA read + flag-bit derivation + fingerprint emission. The AND mask uses `and r12, 0x10` which paideia-as encodes as `and r64, imm32` (BAT_PRESENT_BIT=0x10 fits imm8 but the encoder's smallest match is imm32, well under the imm64 bound that pdx-encoder-pitfalls 2026-09-26 forbids). _bat_present stores the MASK VALUE (0 or 0x10) rather than a normalised 0/1 because the caller already has access to BAT_PRESENT_BIT and `cmp _bat_present, 0` suffices for a boolean check — a normalise step would cost an extra `shr r,4` for no information gain. The fingerprint emits the FULL flag byte (klog_s1_x1 with k=flags, v=_bat_last_sta), not just the present bit, so a boot witness sees the discharging/charging/critical bits too. 3-push alignment: entry rsp%16==8, after 3 pushes rsp%16==0, aligned for both nested CALLs. Labels prefixed `bat_sta_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: battery module inited.
        mov rax, [rip + _bat_inited];
        cmp rax, 0;
        je  bat_sta_notinit;

        // --- Read the STA byte.
        mov rdi, 0;                          // BAT_EC_OFF_STA
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_sta_ec_err;

        // --- Store the full flag byte.
        mov [rip + _bat_last_sta], rax;

        // --- Derive the present mask.
        mov r12, rax;
        and r12, 0x10;                       // BAT_PRESENT_BIT
        mov [rip + _bat_present], r12;

        // --- Bump the counter.
        mov rax, [rip + _bat_sta_ct];
        add rax, 1;
        mov [rip + _bat_sta_ct], rax;

        // --- Emit fingerprint: BATTERY STA flags=0x<hex>
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + bat_tag_sta];
        lea rcx, [rip + bat_k_flags];
        mov r8,  [rip + _bat_last_sta];
        call klog_s1_x1;

        xor rax, rax;                        // BATTERY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_sta_notinit:
        mov rax, 0xFFFFFFD1;                 // BATTERY_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_sta_ec_err:
        mov rax, 0xFFFFFFD4;                 // BATTERY_ERR_EC_READ_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  battery_read_bix() -> u64
  //
  // Issue the composed reads that reconstruct the _BIX static
  // identity: design_cap (u32), last_full (u32), design_voltage
  // (u16), warning_cap (u16), low_cap (u16), cycle_count (u16).
  // Store each in its mutable slot, bump _bat_bix_ct, emit the BIX
  // fingerprint, return BATTERY_OK.
  //
  // Gates: (1) battery_inited, (2) present (last STA read set the
  // present bit) — refuse NOT_PRESENT with BATTERY_ERR_NOT_PRESENT if
  // the pack is absent.
  //
  // No arguments. SysV: no inputs. Register plan: 3-push callee-save
  // prologue (rbx, r12, r13 all scratch); 3-stack-arg push for the
  // final klog_s1_d3 call plus one `sub rsp, 8` align — same shape as
  // ec_handler_opregion's klog_s1_x3 call. Labels prefixed `bat_bix_`.
  // ==========================================================================

  pub let battery_read_bix : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: BIX reads six composed fields (two u32, four u16). Each helper call is tested against the 0xFFFFFF00 error band and propagated as BATTERY_ERR_EC_READ_FAILED (no need to re-wrap in a BIX-specific code; the EC_READ_FAILED code is the honest provenance). The six stores happen BEFORE the fingerprint emission so a tester reading the stat getters right after a successful BIX sees the composed values. Fingerprint call uses klog_s1_d3 (3-decimal wrapper) over design_cap, last_full, design_voltage — the three fields a shutdown consumer will care about most. The three remaining fields (warning_cap, low_cap, cycle_count) are stored but not fingerprinted; a reviewer who needs them calls the stat getters. Stack-align accounting: 3-push prologue (rsp%16==0), then sub rsp,8 + 3 stack pushes (rsp%16==0 at CALL), add rsp,32 after. Labels prefixed `bat_bix_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: battery module inited.
        mov rax, [rip + _bat_inited];
        cmp rax, 0;
        je  bat_bix_notinit;

        // --- Gate: pack present (last STA read set the present bit).
        mov rax, [rip + _bat_present];
        cmp rax, 0;
        je  bat_bix_absent;

        // --- Read design_cap (u32 at 0x10).
        mov rdi, 0x10;
        call bat_read_u32;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bix_ec_err;
        mov [rip + _bat_design_cap], rax;

        // --- Read last_full (u32 at 0x14).
        mov rdi, 0x14;
        call bat_read_u32;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bix_ec_err;
        mov [rip + _bat_last_full], rax;

        // --- Read design_voltage (u16 at 0x18).
        mov rdi, 0x18;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bix_ec_err;
        mov [rip + _bat_design_voltage], rax;

        // --- Read warning_cap (u16 at 0x1A).
        mov rdi, 0x1A;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bix_ec_err;
        mov [rip + _bat_warning_cap], rax;

        // --- Read low_cap (u16 at 0x1C).
        mov rdi, 0x1C;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bix_ec_err;
        mov [rip + _bat_low_cap], rax;

        // --- Read cycle_count (u16 at 0x1E).
        mov rdi, 0x1E;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bix_ec_err;
        mov [rip + _bat_cycle_count], rax;

        // --- Bump the counter.
        mov rax, [rip + _bat_bix_ct];
        add rax, 1;
        mov [rip + _bat_bix_ct], rax;

        // --- Emit fingerprint: BATTERY BIX design_cap=<dec>
        //       last_full=<dec> voltage=<dec>
        //
        // klog_s1_d3 signature:
        //   rdi = level, rsi = subsys_ptr, rdx = tag_ptr,
        //   rcx = k1_ptr, r8 = v1, r9 = k2_ptr,
        //   [rsp+8]  = v2 (after CALL)
        //   [rsp+16] = k3_ptr (after CALL)
        //   [rsp+24] = v3 (after CALL)
        //
        // Alignment: after 3-push prologue rsp%16==0. sub rsp,8 ->
        // rsp%16==8. Three 8-byte pushes land rsp%16==0 at CALL.
        // After add rsp,32 body rsp%16==0 again.
        sub rsp, 8;                          // align-for-push
        mov rax, [rip + _bat_design_voltage];
        push rax;                            // [rsp+24] = v3 after CALL
        lea rax, [rip + bat_k_voltage];
        push rax;                            // [rsp+16] = k3_ptr after CALL
        mov rax, [rip + _bat_last_full];
        push rax;                            // [rsp+8]  = v2 after CALL

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + bat_tag_bix];
        lea rcx, [rip + bat_k_design_cap];
        mov r8,  [rip + _bat_design_cap];    // v1
        lea r9,  [rip + bat_k_last_full];
        call klog_s1_d3;
        add rsp, 32;                         // reclaim align + 3 pushes

        xor rax, rax;                        // BATTERY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_bix_notinit:
        mov rax, 0xFFFFFFD1;                 // BATTERY_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_bix_absent:
        mov rax, 0xFFFFFFD2;                 // BATTERY_ERR_NOT_PRESENT
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_bix_ec_err:
        mov rax, 0xFFFFFFD4;                 // BATTERY_ERR_EC_READ_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  battery_read_bif() -> u64
  //
  // ACPI 6.5 §10.2.2.1 (_BIF) is the legacy name for the first eight
  // _BIX fields (minus the five _BIX-only extensions: revision,
  // battery-type, battery-OEM-info, swappability-capability,
  // model-number). This skeleton issues exactly the same six reads
  // battery_read_bix issues — the structural wiring is identical —
  // and bumps _bat_bif_ct instead of _bat_bix_ct. NO fingerprint:
  // see §5 of the file header (BIX and BIF emit the same first-eight
  // fields; a second line would double every boot witness's count).
  //
  // Gates and register plan identical to battery_read_bix minus the
  // 3-stack-arg push for the fingerprint. Labels prefixed `bat_bif_`.
  // ==========================================================================

  pub let battery_read_bif : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: _BIF reconstruction. Byte-for-byte battery_read_bix minus the fingerprint and minus the sysreg effect. The counter is _bat_bif_ct not _bat_bix_ct, so a tester can distinguish BIX from BIF calls across a mixed boot sequence. In the real-body slice BIF reads only the _BIF-shaped eight fields; in the skeleton the field set is identical to BIX because the five _BIX-only extended fields (revision, type, OEM info, swap-cap, model) are not yet laid out in the frozen EC offsets of §B. The follow-up slice adds them. Labels prefixed `bat_bif_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: battery module inited.
        mov rax, [rip + _bat_inited];
        cmp rax, 0;
        je  bat_bif_notinit;

        // --- Gate: pack present.
        mov rax, [rip + _bat_present];
        cmp rax, 0;
        je  bat_bif_absent;

        // --- Read design_cap (u32 at 0x10).
        mov rdi, 0x10;
        call bat_read_u32;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bif_ec_err;
        mov [rip + _bat_design_cap], rax;

        // --- Read last_full (u32 at 0x14).
        mov rdi, 0x14;
        call bat_read_u32;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bif_ec_err;
        mov [rip + _bat_last_full], rax;

        // --- Read design_voltage (u16 at 0x18).
        mov rdi, 0x18;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bif_ec_err;
        mov [rip + _bat_design_voltage], rax;

        // --- Read warning_cap (u16 at 0x1A).
        mov rdi, 0x1A;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bif_ec_err;
        mov [rip + _bat_warning_cap], rax;

        // --- Read low_cap (u16 at 0x1C).
        mov rdi, 0x1C;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bif_ec_err;
        mov [rip + _bat_low_cap], rax;

        // --- Read cycle_count (u16 at 0x1E).
        mov rdi, 0x1E;
        call bat_read_u16;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bif_ec_err;
        mov [rip + _bat_cycle_count], rax;

        // --- Bump the BIF counter.
        mov rax, [rip + _bat_bif_ct];
        add rax, 1;
        mov [rip + _bat_bif_ct], rax;

        xor rax, rax;                        // BATTERY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_bif_notinit:
        mov rax, 0xFFFFFFD1;                 // BATTERY_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_bif_absent:
        mov rax, 0xFFFFFFD2;                 // BATTERY_ERR_NOT_PRESENT
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_bif_ec_err:
        mov rax, 0xFFFFFFD4;                 // BATTERY_ERR_EC_READ_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  battery_read_bst() -> u64
  //
  // _BST returns a 4-element Package { state, present-rate,
  // remaining-capacity, present-voltage }. This skeleton composes
  // three of those four: state (byte at 0x00, SAME offset as STA — a
  // _BST state is the first byte of the _STA flag word; the skeleton
  // doesn't re-read it from a separate position because the T14 G4
  // EC collapses the two into one field), present_rate (u32 at
  // 0x20) and remaining_capacity (u32 at 0x24).
  //
  // present_voltage is omitted from this skeleton: it duplicates
  // _BIX design_voltage on most laptops and the real-body slice
  // either reads a fourth field (if the platform exposes it
  // separately) or re-uses _bat_design_voltage.
  //
  // Gates: (1) battery_inited, (2) present.
  //
  // No arguments. SysV: no inputs. Register plan: 3-push callee-save
  // prologue + sub rsp,8 + 3 stack pushes for klog_s1_d2_x1 — same
  // shape as battery_read_bix's klog_s1_d3 call site. Labels prefixed
  // `bat_bst_`.
  // ==========================================================================

  pub let battery_read_bst : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: BST reads three composed fields (one byte state + two u32). The state byte read uses ec_read_u8 directly (no u16/u32 helper) because it's one byte, matching ec.pdx's own single-byte reads. The fingerprint uses klog_s1_d2_x1 (2-dec + 1-hex) over rate, remaining, state — the field ORDER is REVERSED from the task-statement spec because no klog_s1_x1_d2 wrapper exists (file-header §5 argues the reorder is semantically equivalent and the golden carries the reordered shape). State is emitted as hex because it is a bitfield (same four-bit mask the STA fingerprint renders); rate and remaining as decimals because they are mWh/mW magnitudes that read naturally in decimal. Stack-align accounting identical to battery_read_bix's klog_s1_d3 call site. Labels prefixed `bat_bst_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Gate: battery module inited.
        mov rax, [rip + _bat_inited];
        cmp rax, 0;
        je  bat_bst_notinit;

        // --- Gate: pack present.
        mov rax, [rip + _bat_present];
        cmp rax, 0;
        je  bat_bst_absent;

        // --- Read state byte (one byte at 0x00).
        mov rdi, 0;                          // BAT_EC_OFF_STA
        call ec_read_u8;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bst_ec_err;
        mov [rip + _bat_bst_state], rax;

        // --- Read present_rate (u32 at 0x20).
        mov rdi, 0x20;
        call bat_read_u32;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bst_ec_err;
        mov [rip + _bat_present_rate], rax;

        // --- Read remaining_cap (u32 at 0x24).
        mov rdi, 0x24;
        call bat_read_u32;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae bat_bst_ec_err;
        mov [rip + _bat_remaining_cap], rax;

        // --- Bump the counter.
        mov rax, [rip + _bat_bst_ct];
        add rax, 1;
        mov [rip + _bat_bst_ct], rax;

        // --- Emit fingerprint: BATTERY BST rate=<dec>
        //       remaining=<dec> state=0x<hex>
        //
        // klog_s1_d2_x1 signature:
        //   rdi=level, rsi=subsys_ptr, rdx=tag_ptr,
        //   rcx=kd1_ptr, r8=vd1, r9=kd2_ptr,
        //   [rsp+8]  = vd2 (after CALL)
        //   [rsp+16] = kx_ptr (after CALL)
        //   [rsp+24] = vx (after CALL)
        sub rsp, 8;                          // align-for-push
        mov rax, [rip + _bat_bst_state];
        push rax;                            // [rsp+24] = vx (state) after CALL
        lea rax, [rip + bat_k_state];
        push rax;                            // [rsp+16] = kx_ptr after CALL
        mov rax, [rip + _bat_remaining_cap];
        push rax;                            // [rsp+8] = vd2 after CALL

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + bat_tag_bst];
        lea rcx, [rip + bat_k_rate];
        mov r8,  [rip + _bat_present_rate];  // vd1
        lea r9,  [rip + bat_k_remaining];
        call klog_s1_d2_x1;
        add rsp, 32;                         // reclaim align + 3 pushes

        xor rax, rax;                        // BATTERY_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_bst_notinit:
        mov rax, 0xFFFFFFD1;                 // BATTERY_ERR_EC_NOT_INIT
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_bst_absent:
        mov rax, 0xFFFFFFD2;                 // BATTERY_ERR_NOT_PRESENT
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_bst_ec_err:
        mov rax, 0xFFFFFFD4;                 // BATTERY_ERR_EC_READ_FAILED
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §O  cap_handler_battery_drv(rights, target_ptr, op_arg) -> u64
  //
  // The cap-table dispatch stub bound to KIND_BATTERY_DRV (0x3D) in
  // `src/kernel/core/cap/invoke.pdx`. Routes by op_arg to one of
  // {battery_init, battery_read_bix, battery_read_bif,
  // battery_read_sta, battery_read_bst}; anything else returns
  // BATTERY_ERR_BAD_OPCODE.
  //
  // Rights and target_ptr are IGNORED at skeleton stage: the follow-
  // up slice adds a RIGHTS GATE (RIGHT_BATTERY_READ etc.) and a
  // target_ptr indirection (an N-battery system would key the mutable
  // state table by target_ptr). The signature carries both so that
  // slice does not need to re-plumb the ABI.
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg. Register plan:
  // 3-push callee-save prologue (rbx, r12=op_arg, r13 scratch).
  // Labels prefixed `bat_h_`.
  // ==========================================================================

  pub let cap_handler_battery_drv : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: cap-table dispatch stub. The cmp-chain over {1..5} is one branch per legal op (not a jump table) because five live values occupy less bytecode as a chain than a 256-slot table and the branch-mispredict cost is irrelevant on a path that fires at most once per BIX/BST poll interval. Unknown op returns BATTERY_ERR_BAD_OPCODE (0xFFFFFFD6), the band-specific analogue of EC_ERR_BAD_OPCODE and chosen over BATTERY_ERR_BAD_FIELD because 'wrong op' is more specific than 'wrong field'. Each legal arm forwards to the leaf without saving the return — the leaf's return value becomes the handler's return value verbatim, which keeps the error-band discipline intact (any 0xFFFFFF... error surfaces to the caller unchanged). Rights and target_ptr are ACCEPTED but IGNORED at skeleton stage; the follow-up slice adds the rights gate (bit mask against RIGHT_BATTERY_READ) and the per-pack row indirection via target_ptr. 3-push prologue aligns rsp%16==0 for the one nested CALL. Labels prefixed `bat_h_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdx;                        // op_arg

        // --- Opcode dispatch.
        cmp r12, 1;                          // BAT_HANDLER_OP_INIT
        je  bat_h_init;
        cmp r12, 2;                          // BAT_HANDLER_OP_BIX
        je  bat_h_bix;
        cmp r12, 3;                          // BAT_HANDLER_OP_BIF
        je  bat_h_bif;
        cmp r12, 4;                          // BAT_HANDLER_OP_STA
        je  bat_h_sta;
        cmp r12, 5;                          // BAT_HANDLER_OP_BST
        je  bat_h_bst;

        mov rax, 0xFFFFFFD6;                 // BATTERY_ERR_BAD_OPCODE
        pop r13;
        pop r12;
        pop rbx;
        ret;

      bat_h_init:
        call battery_init;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_h_bix:
        call battery_read_bix;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_h_bif:
        call battery_read_bif;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_h_sta:
        call battery_read_sta;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      bat_h_bst:
        call battery_read_bst;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §P  Stat getters — single-load leaves for witness callers
  //
  // Named counterparts to ec.pdx's getter set. A boot witness can
  // assert `battery_inited()==1 AND battery_bix_count() > 0` after a
  // smoke test that drives cap_handler_battery_drv a known number of
  // times.
  // ==========================================================================

  pub let battery_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_inited. Leaf.",
      block: { mov rax, [rip + _bat_inited]; ret }
    }

  pub let battery_present : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_present. Returns 0 or BAT_PRESENT_BIT (0x10) — a cmp-against-zero is sufficient for a boolean check. Leaf.",
      block: { mov rax, [rip + _bat_present]; ret }
    }

  pub let battery_last_sta : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_last_sta — the raw 8-bit STA flag word from the most recent battery_read_sta. Leaf.",
      block: { mov rax, [rip + _bat_last_sta]; ret }
    }

  pub let battery_design_cap : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_design_cap (mWh). Populated by battery_read_bix / battery_read_bif. Leaf.",
      block: { mov rax, [rip + _bat_design_cap]; ret }
    }

  pub let battery_last_full : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_last_full (mWh). Leaf.",
      block: { mov rax, [rip + _bat_last_full]; ret }
    }

  pub let battery_design_voltage : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_design_voltage (mV). Leaf.",
      block: { mov rax, [rip + _bat_design_voltage]; ret }
    }

  pub let battery_warning_cap : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_warning_cap (mWh). Leaf.",
      block: { mov rax, [rip + _bat_warning_cap]; ret }
    }

  pub let battery_low_cap : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_low_cap (mWh). Leaf.",
      block: { mov rax, [rip + _bat_low_cap]; ret }
    }

  pub let battery_cycle_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_cycle_count. Leaf.",
      block: { mov rax, [rip + _bat_cycle_count]; ret }
    }

  pub let battery_present_rate : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_present_rate (mW, signed in the real-body slice — positive = charging, negative = discharging; stored unsigned here). Populated by battery_read_bst. Leaf.",
      block: { mov rax, [rip + _bat_present_rate]; ret }
    }

  pub let battery_remaining_cap : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_remaining_cap (mWh). Leaf.",
      block: { mov rax, [rip + _bat_remaining_cap]; ret }
    }

  pub let battery_bst_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_bst_state (BST state byte, parallel to _bat_last_sta but updated only on battery_read_bst). Leaf.",
      block: { mov rax, [rip + _bat_bst_state]; ret }
    }

  pub let battery_bix_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_bix_ct. Bumped once per successful battery_read_bix. Leaf.",
      block: { mov rax, [rip + _bat_bix_ct]; ret }
    }

  pub let battery_bif_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_bif_ct. Bumped once per successful battery_read_bif. Leaf.",
      block: { mov rax, [rip + _bat_bif_ct]; ret }
