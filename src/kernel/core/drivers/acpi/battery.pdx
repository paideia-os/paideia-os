  pub let battery_sta_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2526 (Wave 59 D9) skeleton: single-load getter for _bat_sta_ct. Bumped once per successful battery_read_sta. Leaf.",
      block: { mov rax, [rip + _bat_sta_ct]; ret }
