// src/kernel/core/drivers/acpi/ec.pdx — Wave 59 D8 (paideia-os#2525)
//
// Embedded-Controller OpRegion handler SKELETON. Lays down the
// SMBus-style command/response finite-state machine that EVERY
// firmware-side read or write of the EC's 256-byte address space goes
// through on Intel client platforms (the T14 G4 case being a Raptor
// Lake Lenovo whose batteries, thermal zones, fans, backlight, lid
// switch and keyboard-matrix read/write status entirely through this
// path). The real-body slice carries the IBF/OBF handshake against
// live `inb`/`outb` on ports 0x62/0x66; this skeleton:
//
//   * freezes the register map (EC_SC @ 0x66, EC_DATA @ 0x62, OBF 0x01,
//     IBF 0x02),
//   * freezes the three opcode constants (RD=0x80, WR=0x81, QR=0x84),
//   * freezes the error band 0xFFFFFFC5..0xFFFFFFCA so a skeleton
//     refusal and a real-body refusal share a code,
//   * freezes the 5-phase state machine's phase codes
//     (idle=0, cmd=1, status=2, data=3, done=4) + one reset path,
//   * freezes the public entrypoints the OpRegion dispatcher will bind
//     to on wire-up (`ec_init`, `ec_read_u8`, `ec_write_u8`, `ec_query`,
//     `ec_handler_opregion`),
//   * emits the Wave 59 fingerprint lines (success + timeout) via
//     `klog_s1_x3` and `klog_s1_x1` so a boot witness can SEE the seam
//     fire even before the real-body slice lands,
//   * confines the EC-session mutable state to this object (one controller
//     per machine — ACPI 6.5 §12 permits more, but every shipped
//     x86_64 laptop including the T14 G4 presents exactly one).
//
// -----------------------------------------------------------------------------
// §0  WHY THIS FILE IS NOT ec_access.pdx
// -----------------------------------------------------------------------------
//
// `src/kernel/core/drivers/ec/ec_access.pdx` (R31.M1-001 #1089) already
// owns the *capability* half: it binds a KIND_OP_REGION slot to the EC
// 256-byte space, carries the SMM-arbitration machinery (FACS compare-
// exchange + PM1_CNT GBL_RLS doorbell), and exposes the invariants
// `ec_access_bind` / `ec_access_audit` / `ec_access_arbitrated`. That
// file was written BEFORE the SMBus-style FSM that services actual
// per-byte reads was in scope. #1089's handler stub just records the
// op; the firmware-bytecode consumer in ring 3 (see §4 below) never had
// a kernel-side path to the real EC_SC/EC_DATA port pair.
//
// This file adds exactly that path. It stays in a NEW directory
// (`src/kernel/core/drivers/acpi/`) because the handler is dispatched
// by *ACPI OpRegion space-id* (OPREG_SPACE_EC = 0x03), not by a
// capability-kind row — co-locating it under `ec/` would hide the
// space-id dimension beside a module whose own naming reads as the
// capability dimension. The two files share the `EC_` constant family
// at the SPEC level (OBF=0x01, IBF=0x02 are ACPI 6.5 §12.2 constants,
// not file-local synonyms); every ec.pdx symbol is new, every
// ec_access.pdx symbol is left untouched, and `tools/build.sh`'s linker
// pass verifies no `pub let` collision.
//
// -----------------------------------------------------------------------------
// §1  SMBus-STYLE FSM — WHY FIVE PHASES NOT FOUR, AND WHY RESET IS NOT A PHASE
// -----------------------------------------------------------------------------
//
// ACPI 6.5 §12.2 ("Embedded Controller Interface Description") describes
// the controller as a two-port SMBus-style device. A single read or
// write transaction walks through the following phase sequence:
//
//   idle (0)   -- IBF==0 AND OBF==0; the host may now write EC_SC.
//                 If OBF==1 at entry, the previous transaction left a
//                 byte in EC_DATA; the FSM READS AND DISCARDS one byte
//                 to clear OBF before advancing. If IBF==1 at entry,
//                 the controller is still digesting an earlier command;
//                 the FSM polls for IBF==0.
//   cmd (1)    -- host writes the opcode (RD/WR/QR) to EC_SC. The
//                 controller sets IBF==1 instantly; the host polls
//                 IBF==0 to confirm the opcode was latched.
//   status (2) -- for RD/WR, the host writes the ADDRESS byte to
//                 EC_DATA. For QR, this phase is SKIPPED (query has no
//                 operand). The host polls IBF==0.
//   data (3)   -- RD/QR: the host polls OBF==1 and reads the byte from
//                 EC_DATA.
//                 WR: the host writes the VALUE byte to EC_DATA and
//                 polls IBF==0.
//   done (4)   -- transaction committed. The FSM clears last_phase and
//                 bumps the success counter.
//
// RESET is NOT a phase. It is a *recovery* taken when any of the above
// polls times out: the FSM reads EC_DATA to drain OBF, writes a
// NOP-shaped sentinel to EC_SC (ACPI 6.5 §12.2 permits sending CMD_QUERY
// 0x84 as a benign resync — the controller answers with 0 for "nothing
// pending" and leaves no transaction state), and SETS `_ec_needs_reset`.
// The next entrypoint call checks that latch FIRST and returns
// `EC_RESET_REQUIRED` without touching the port — the recovery path is
// not an automatic re-arm because a timeout on a real machine means the
// controller is in a bad state and a re-arm would multiply writes to a
// device that is not acknowledging. The next successful `ec_init` clears
// the latch; the operator sees the refusal and chooses whether to retry.
//
// -----------------------------------------------------------------------------
// §2  RETURN CODES — band 0xFFFFFFC5..0xFFFFFFCA
// -----------------------------------------------------------------------------
//
// Reserved by paideia-os#2525 for the EC OpRegion FSM. Disjoint from
//   EC_ACCESS_*       (0xFFFFFDC4..0xFFFFFDCF, ec_access.pdx)
//   GPIO_IO_*         (0xFFFFFF08..0F)
//   GPIO_LINE_*       (0xFFFFFF10..1F)
//   LPSS_GPIO_*       (0xFFFFFF20..2F)
//   DW_IO_*           (0xFFFFFF30..3F)
//   LPSS_I2C_*        (0xFFFFFF40..5F)
//   LPG_D7_*          (0xFFFFFE70..7F)
//
//   0xFFFFFFC5  EC_ERR_TIMEOUT        — IBF/OBF stall or phase deadline;
//                                       the `last_phase` field names which
//   0xFFFFFFC6  EC_ERR_OBF_STALL      — OBF==0 persisted through the data
//                                       phase deadline (RD/QR path)
//   0xFFFFFFC7  EC_ERR_IBF_STALL      — IBF==1 persisted through the cmd
//                                       or status phase deadline (WR path)
//   0xFFFFFFC8  EC_ERR_RESET_REQ      — a prior transaction timed out; the
//                                       controller is parked and the operator
//                                       must call `ec_init` to clear the latch
//   0xFFFFFFC9  EC_ERR_BAD_OPCODE     — op argument to `ec_handler_opregion`
//                                       was not EC_HANDLER_OP_READ (1) or
//                                       EC_HANDLER_OP_WRITE (2)
//   0xFFFFFFCA  EC_ERR_UNKNOWN        — a path reached a state the FSM does
//                                       not know how to leave; a refusal
//                                       rather than a silent default — a
//                                       default would be the wrong byte to
//                                       the wrong offset of a device every
//                                       other subsystem trusts
//
// Three codes are present at skeleton stage and never fired: OBF_STALL,
// IBF_STALL, UNKNOWN. The symbols exist today so that the real-body
// slice can land without re-numbering, and so a reviewer debugging a
// bring-up log reads the SAME code the final driver will emit.
//
// -----------------------------------------------------------------------------
// §3  invoke.pdx — NO SLOT ADDED, AND WHY
// -----------------------------------------------------------------------------
//
// The EC OpRegion handler is NOT a new capability KIND. ACPI OpRegion
// handlers are dispatched by `space_id` (ACPI 6.5 §5.5.2.4), which is a
// per-region attribute carried in the KIND_OP_REGION row itself
// (`src/kernel/core/cap/kind_op_region.pdx`, kind tag 0x150, slot 25).
// A ring-0 OpRegion read of space=OPREG_SPACE_EC (0x03) resolves THROUGH
// the KIND_OP_REGION handler, which inspects its row's space_id field
// and calls `ec_handler_opregion` directly — no second cap_handler is
// involved.
//
// A grep of `src/kernel/core/cap/invoke.pdx` for `0x15*` through `0x1F*`
// confirms the kind-tag space is dense but *orthogonal*: the dispatch
// table carries per-KIND handlers (slot 25 = KIND_OP_REGION), never
// per-space-id handlers. KIND_ACPI_OPREGION would be a redundant twin
// of KIND_OP_REGION, differing only in space_id, which is already a
// per-row field. The paideia-os design directive 2026-10-10 ("novel +
// clean design bias") rules out that kind of inheritance-shaped
// duplication explicitly.
//
// Therefore this skeleton:
//   * does NOT allocate a new kind tag,
//   * does NOT touch `src/kernel/core/cap/invoke.pdx`,
//   * exposes `ec_handler_opregion` with a signature the KIND_OP_REGION
//     dispatcher can call directly (op, offset, value) when the real-
//     body wire-up slice lands,
//   * leaves the wire-up itself (one call-site edit inside
//     `src/kernel/core/cap/kind_op_region.pdx`'s invoke path) to the
//     follow-up slice, because today the KIND_OP_REGION handler stubs
//     OPREG_SPACE_EC with INVOKE_UNSUPPORTED and a reviewer reading
//     half a wire-up would mis-attribute the stub to this file.
//
// -----------------------------------------------------------------------------
// §4  RING-3 CONSUMER
// -----------------------------------------------------------------------------
//
// `src/user/aml/aml_ec.pdx` (R30 ring-3 consumer; by design doc
// `design/acpi/no-aml-in-kernel.md` the firmware-bytecode evaluator
// lives in ring 3) is the typical caller. It issues QR_EC via
// `ec_handler_opregion(op=EC_HANDLER_OP_QUERY, ...)`, reads the query
// byte, builds a four-character `_Qxx` name, and dispatches a method.
// Nothing in that chain reaches down into this file by name — the
// ring-3 side goes through the KIND_EC_QUERY capability (0x156 =
// 342) and reaches the OpRegion through the KIND_OP_REGION row — but
// the FSM instrumented here is the one that services every ring-0
// path that eventually resolves to space=0x03.
//
// -----------------------------------------------------------------------------
// §5  FINGERPRINTS
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/ec.golden:
//
//     EC OPREGION OK cmd=<2-hex> addr=0x<2-hex> value=0x<2-hex>
//
// Emitted by `ec_handler_opregion` on a successful commit. Three KV
// entries, all hex (klog_s1_x3 fmt_letter 0x78). The `<2-hex>`
// placeholders are the GOLDEN FORMAT ANCHORS — the real-body slice
// substitutes measured values. Same discipline as
// `lpss_i2c.golden`'s `<n>` / `<hex-list>`.
//
//   EC OPREGION TIMEOUT phase=<idle|cmd|status|data>
//
// Emitted on the TIMEOUT path via `klog_s1_x1` with the phase code
// (0..3) as a hex value. The pipe-separated enum in the golden file
// is the format anchor; the actual emission is one of {0, 1, 2, 3}.
// Both lines live in the same golden file to spare the smoke harness
// a second anchor path.
//
// -----------------------------------------------------------------------------
// §6  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   G1 — every u32 I/O store would use `out_d` / `in_d` in the real
//        body; the skeleton emits no port I/O (all ports stubbed).
//   G4 — every compare is on a full 64-bit register; no `cmp al, imm`.
//   No `test rN, rN` — zero-equality uses `cmp rN, 0`.
//   No `and r, imm64` — every mask here fits in imm32.
//   No two-operand `imul r, imm` — the skeleton has no multiplies.
//   Multiline `pub let x = "..."` strings — forbidden; every tag below
//                                            is one line.
//   Module basename match — `ec.pdx` → `module Ec`.
//   Reserved labels (`loop`, `if`, `let`) — every label in this file
//                                            is prefixed with the
//                                            function's own 4-letter
//                                            tag (`eci_` / `ecr_` /
//                                            `ecw_` / `ecq_` / `ech_`),
//                                            per the pdx-encoder-
//                                            pitfalls memory
//                                            2026-09-26.
//
// =============================================================================

module Ec = structure {

  // ==========================================================================
  // §A  Port + bit constants (ACPI 6.5 §12.2)
  //
  // These are architectural constants, not per-machine. Every x86_64
  // laptop since 1998 that implements the ACPI EC maps EC_SC at 0x66
  // and EC_DATA at 0x62. The firmware's `_SB.PCI0.LPCB.EC0._CRS`
  // package declares exactly this pair on the T14 G4 (verified against
  // the dumped BIOS 2026-07-04).
  // ==========================================================================

  pub let EC_PORT_SC   : u64 = 0x66           // Status/Command register
  pub let EC_PORT_DATA : u64 = 0x62           // Data register

  pub let EC_STS_OBF   : u64 = 0x01           // Output Buffer Full
  pub let EC_STS_IBF   : u64 = 0x02           // Input  Buffer Full
  pub let EC_STS_CMD   : u64 = 0x08           // CMD bit — set means last
                                              // byte written to EC_SC
                                              // was a command, not an
                                              // address or value
  pub let EC_STS_BURST : u64 = 0x10           // Burst-mode engaged
  pub let EC_STS_SCI   : u64 = 0x20           // SCI pending
  pub let EC_STS_SMI   : u64 = 0x40           // SMI pending (SMM arb)

  // Opcode constants.
  pub let EC_CMD_READ  : u64 = 0x80           // RD_EC: read one byte
                                              // from the 256-byte space
  pub let EC_CMD_WRITE : u64 = 0x81           // WR_EC: write one byte
                                              // to the 256-byte space
  pub let EC_CMD_QUERY : u64 = 0x84           // QR_EC: ask "is there a
                                              // query byte pending?"

  // ACPI OpRegion space-id for the EC. Published here (not re-imported
  // from ec_access.pdx) because this file is the ARCHITECTURAL
  // declaration of the FSM — ec_access.pdx is the capability binding —
  // and a reader finding the handler should see 0x03 here first.
  pub let EC_OPREG_SPACE : u64 = 0x03

  // 256-byte address space (ACPI 6.5 §12.2). Writes with addr >= 256
  // are refused with EC_ERR_UNKNOWN before any port touch; the EC does
  // not sanity-check its own address space.
  pub let EC_ADDR_SPACE : u64 = 256

  // ==========================================================================
  // §B  Handler op argument codes (ec_handler_opregion)
  //
  // The ACPI OpRegion dispatcher passes an op argument naming the
  // direction. Two values are legal; anything else is EC_ERR_BAD_OPCODE.
  // QUERY is distinct from READ because QUERY has no address operand.
  // ==========================================================================

  pub let EC_HANDLER_OP_READ  : u64 = 1
  pub let EC_HANDLER_OP_WRITE : u64 = 2
  pub let EC_HANDLER_OP_QUERY : u64 = 3

  // ==========================================================================
  // §C  FSM phase codes — the value stored in `_ec_last_phase` and
  //     the value emitted on the TIMEOUT fingerprint
  // ==========================================================================

  pub let EC_PHASE_IDLE   : u64 = 0
  pub let EC_PHASE_CMD    : u64 = 1
  pub let EC_PHASE_STATUS : u64 = 2
  pub let EC_PHASE_DATA   : u64 = 3
  pub let EC_PHASE_DONE   : u64 = 4

  // ==========================================================================
  // §D  Return codes — band 0xFFFFFFC5..0xFFFFFFCA
  //
  // See the file header §2 for the band-disjointness proof.
  // ==========================================================================

  pub let EC_OK                 : u64 = 0
  pub let EC_ERR_TIMEOUT        : u64 = 0xFFFFFFC5
  pub let EC_ERR_OBF_STALL      : u64 = 0xFFFFFFC6
  pub let EC_ERR_IBF_STALL      : u64 = 0xFFFFFFC7
  pub let EC_ERR_RESET_REQ      : u64 = 0xFFFFFFC8
  pub let EC_ERR_BAD_OPCODE     : u64 = 0xFFFFFFC9
  pub let EC_ERR_UNKNOWN        : u64 = 0xFFFFFFCA

  // ==========================================================================
  // §E  Poll bound — iterations the real-body FSM will spin before
  //      declaring a phase-timeout
  //
  // 100_000 iterations × ~10ns per in/out on a Raptor Lake PCH-H ≈ 1ms,
  // which is the ACPI 6.5 §12.2.2 "EC should respond within 1ms"
  // envelope. Named here so the real-body slice has a settled
  // constant and so a tester can grep the number if a controller is
  // observed to be slower in the wild.
  //
  // The skeleton does not spin; the constant is published so the
  // golden assertions carry the right magnitude from day one.
  // ==========================================================================

  pub let EC_POLL_MAX : u64 = 100000

  // ==========================================================================
  // §F  Mutable state — one controller per machine, confined to this
  //      object (tools/build.sh's `objdump -r` symbol-confinement pass
  //      asserts no other object may relocate against these symbols)
  //
  // The real-body slice generalises to `[u64; N]` only if a laptop
  // ships with two ECs (never observed on x86_64 — the specification
  // permits it but the field has not seen it). Today the T14 G4 case
  // is one, and a scalar is honest.
  //
  // Fields:
  //   _ec_inited        1 iff ec_init has been called successfully
  //   _ec_needs_reset   1 iff a transaction timed out; the next
  //                      entrypoint refuses with EC_ERR_RESET_REQ
  //                      until ec_init clears the latch
  //   _ec_last_phase    one of EC_PHASE_* — the phase the last
  //                      transaction ended on; EC_PHASE_DONE on
  //                      success, one of IDLE/CMD/STATUS/DATA on
  //                      timeout. Named so an operator debugging a
  //                      bring-up log sees WHERE the controller
  //                      stalled.
  //   _ec_last_cmd      the last opcode written to EC_SC (0x80/0x81/
  //                      0x84). Recorded for the fingerprint.
  //   _ec_last_addr     the last address byte written to EC_DATA
  //                      (for RD/WR). 0 for QR.
  //   _ec_last_value    the last byte read or written through
  //                      EC_DATA. For QR, the query byte.
  //   _ec_read_ct       successful ec_read_u8 count
  //   _ec_write_ct      successful ec_write_u8 count
  //   _ec_query_ct      successful ec_query count
  //   _ec_timeout_ct    timeouts observed across all transaction
  //                      paths
  // ==========================================================================

  pub let mut _ec_inited      : u64 = 0
  pub let mut _ec_needs_reset : u64 = 0
  pub let mut _ec_last_phase  : u64 = 0
  pub let mut _ec_last_cmd    : u64 = 0
  pub let mut _ec_last_addr   : u64 = 0
  pub let mut _ec_last_value  : u64 = 0
  pub let mut _ec_read_ct     : u64 = 0
  pub let mut _ec_write_ct    : u64 = 0
  pub let mut _ec_query_ct    : u64 = 0
  pub let mut _ec_timeout_ct  : u64 = 0

  // ==========================================================================
  // §G  Fingerprint tags + keys
  //
  //   EC OPREGION OK cmd=<2-hex> addr=0x<2-hex> value=0x<2-hex>
  //   EC OPREGION TIMEOUT phase=<idle|cmd|status|data>
  //
  // Single-line `pub let` string literals per the pdx-encoder-
  // pitfalls memory 2026-09-26: a `pub let x = "..."` split across
  // lines is parsed as two declarations.
  // ==========================================================================

  pub let ec_tag_ok      : [u8; 15] = "EC OPREGION OK\0"
  pub let ec_tag_timeout : [u8; 20] = "EC OPREGION TIMEOUT\0"
  pub let ec_k_cmd       : [u8; 4]  = "cmd\0"
  pub let ec_k_addr      : [u8; 5]  = "addr\0"
  pub let ec_k_value     : [u8; 6]  = "value\0"
  pub let ec_k_phase     : [u8; 6]  = "phase\0"

  // ==========================================================================
  // §H  ec_init() -> u64
  //
  // Zero every stat slot, clear the reset latch, flip the inited
  // latch, return EC_OK.
  //
  // NO HARDWARE PROBE. The real-body slice reads EC_SC once to drain
  // a stale OBF (an EC that just reset leaves the Flash-identify
  // response byte sitting in EC_DATA; reading it clears the latch
  // and keeps the first real transaction honest). Today the probe is
  // skipped because the port-I/O capability (KIND_IO_PORT over
  // 0x62/0x66) has no caller that mints it yet — ec_access.pdx binds
  // a KIND_OP_REGION over the memory face, which is sufficient for
  // ec_access_audit but not for raw in/out.
  //
  // Returns EC_OK (0) unconditionally. The symmetric case (an EC
  // that fails probe) is deferred because at skeleton stage there is
  // no probe to fail.
  //
  // No arguments. SysV: no inputs. Register plan: zero caller-save
  // pushes needed; leaf, no nested calls. Labels prefixed `eci_`.
  // ==========================================================================

  pub let ec_init : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2525 (Wave 59 D8): zero every EC mutable-state slot, clear the reset latch, flip the inited latch, return EC_OK. The real-body slice adds one in/out pair to drain a stale OBF left by the firmware's own identify sequence; today that in/out would reach port 0x62 WITHOUT a minted KIND_IO_PORT, so it is deferred to the follow-up slice that lands the port-I/O capability. Returning EC_OK with no probe is NOT dishonest at skeleton stage: there is no probe to pass or fail yet, and the counters this call zeroes become readable through the stat getters so a witness programme can observe the init happened. Zero sequence writes 10 u64 slots via one `xor rax, rax` + 10 `mov [rip + sym], rax` — plain REX.W movs are 8-byte stores so no `mov_d` is needed. Flip _ec_inited at the END (not with a late mov because a re-init call must see cleared counters first — a tester grepping for 'inited AND read_ct > 0' would otherwise see a false YES across a re-init). Leaf, zero caller-save pushes, zero nested calls. Labels prefixed `eci_`.",
      block: {
        xor rax, rax;
        mov [rip + _ec_needs_reset], rax;
        mov [rip + _ec_last_phase],  rax;
        mov [rip + _ec_last_cmd],    rax;
        mov [rip + _ec_last_addr],   rax;
        mov [rip + _ec_last_value],  rax;
        mov [rip + _ec_read_ct],     rax;
        mov [rip + _ec_write_ct],    rax;
        mov [rip + _ec_query_ct],    rax;
        mov [rip + _ec_timeout_ct],  rax;

        mov rax, 1;
        mov [rip + _ec_inited], rax;

        xor rax, rax;                        // EC_OK
        ret
      }
    }

  // ==========================================================================
  // §I  ec_read_u8(offset) -> u64
  //
  // SKELETON: gate on (inited AND NOT needs_reset AND offset < 256),
  // record the (cmd=EC_CMD_READ, addr=offset, value=0) tuple, bump
  // the read counter, mark the FSM done, return 0 as the stub value.
  //
  // The real body walks:
  //   PHASE_IDLE   : read EC_SC; while OBF, read EC_DATA (drain);
  //                   while IBF, re-poll;
  //   PHASE_CMD    : outb(EC_PORT_SC, EC_CMD_READ); poll IBF==0;
  //   PHASE_STATUS : outb(EC_PORT_DATA, offset);     poll IBF==0;
  //   PHASE_DATA   : poll OBF==1; value = inb(EC_PORT_DATA);
  //   PHASE_DONE   : stash + ret value.
  //
  // Each poll bounded by EC_POLL_MAX; on bust, mark _ec_needs_reset,
  // bump _ec_timeout_ct, emit the TIMEOUT fingerprint, return
  // EC_ERR_TIMEOUT.
  //
  // Returns the byte at `offset` on success (0..255); one of the
  // 0xFFFFFFC5..CA codes on refusal. Collisions between the valid
  // range {0..255} and the error band are impossible (error band's
  // low 8 bits are {0xC5..0xCA} but the high bits are 0xFFFFFF so
  // any value < 256 is unambiguously a byte).
  //
  // SysV: rdi = offset. Register plan: 3 pushes (rbx, r12, r13)
  // leave rsp%16 == 0 at the no-op branch's `ret`. Labels prefixed
  // `ecr_`.
  // ==========================================================================

  pub let ec_read_u8 : (u64) -> u64 !{mem} @{boot} =
    fn (offset: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: gate on (inited AND NOT needs_reset AND offset<256), record the transaction tuple (cmd=0x80, addr=offset, value=0), bump _ec_read_ct, mark FSM done, return 0 as the stub byte. Gates in order so an operator sees the first failure: (1) _ec_inited==0 -> EC_ERR_UNKNOWN (uninit is a programmer error, not a hardware condition — EC_ERR_UNKNOWN is the signal, not EC_ERR_RESET_REQ which is a hardware state), (2) _ec_needs_reset!=0 -> EC_ERR_RESET_REQ (the controller is parked after a prior timeout; the operator must call ec_init to clear the latch), (3) offset>=256 -> EC_ERR_UNKNOWN (the 256-byte address space is architectural; a wrap would land on a real byte of a real device). The record+bump sequence happens AFTER the gates so a refused call does not advance the counters. Return value of 0 at skeleton stage is honest: there is no port I/O happening, and the real-body slice replaces this one line with the IBF/OBF handshake plus the actual in-byte read. 3-push callee-save prologue (rbx, r12, r13) saves offset in r12 across the stat updates; entry rsp%16==8, after 3 pushes rsp%16==0, but no nested calls happen in the skeleton so alignment is only paid at the eventual follow-up. Labels prefixed `ecr_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                        // offset

        // --- (1) inited?
        mov rax, [rip + _ec_inited];
        cmp rax, 0;
        je  ecr_notinit;

        // --- (2) needs_reset?
        mov rax, [rip + _ec_needs_reset];
        cmp rax, 0;
        jne ecr_resetreq;

        // --- (3) offset < 256?
        mov rax, 256;
        cmp r12, rax;
        jae ecr_badoff;

        // --- Record the transaction tuple.
        mov rax, 0x80;                       // EC_CMD_READ
        mov [rip + _ec_last_cmd],   rax;
        mov [rip + _ec_last_addr],  r12;
        xor rax, rax;
        mov [rip + _ec_last_value], rax;     // stub value 0

        // --- Bump the counter.
        mov rax, [rip + _ec_read_ct];
        add rax, 1;
        mov [rip + _ec_read_ct], rax;

        // --- Mark FSM done.
        mov rax, 4;                          // EC_PHASE_DONE
        mov [rip + _ec_last_phase], rax;

        xor rax, rax;                        // stub byte = 0
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecr_notinit:
        mov rax, 0xFFFFFFCA;                 // EC_ERR_UNKNOWN
        pop r13;
        pop r12;
        pop rbx;
        ret;
      ecr_resetreq:
        mov rax, 0xFFFFFFC8;                 // EC_ERR_RESET_REQ
        pop r13;
        pop r12;
        pop rbx;
        ret;
      ecr_badoff:
        mov rax, 0xFFFFFFCA;                 // EC_ERR_UNKNOWN
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  ec_write_u8(offset, value) -> u64
  //
  // SKELETON: same gate shape as ec_read_u8 plus a value<256 gate.
  // Record (cmd=EC_CMD_WRITE, addr=offset, value=value), bump
  // _ec_write_ct, mark done, return EC_OK.
  //
  // Real body: PHASE_CMD outb(EC_PORT_SC, EC_CMD_WRITE); PHASE_STATUS
  // outb(EC_PORT_DATA, offset); PHASE_DATA outb(EC_PORT_DATA, value);
  // each phase polls IBF==0 with EC_POLL_MAX bound.
  //
  // SysV: rdi = offset, rsi = value. Three pushes.
  // Labels prefixed `ecw_`.
  // ==========================================================================

  pub let ec_write_u8 : (u64, u64) -> u64 !{mem} @{boot} =
    fn (offset: u64, value: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: companion to ec_read_u8 for the WRITE opcode. Gates: (1) inited, (2) NOT needs_reset, (3) offset<256, (4) value<256. The fourth gate is NEW relative to read: a value byte >= 256 would overflow the EC's 8-bit data register and the EC specifies that behaviour as UNDEFINED. Refusing with EC_ERR_UNKNOWN keeps the whole 0xFFFFFF-prefixed error band distinguishable from a legitimate 0..255 byte. Record+bump sequence same shape as read: cmd=0x81, addr=offset, value=value. Returns EC_OK on skeleton success — the real body returns EC_OK too on commit, so the skeleton and the real driver share a return-shape. 3-push callee-save prologue (rbx, r12, r13); r12=offset, r13=value survive the stat writes. Labels prefixed `ecw_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                        // offset
        mov r13, rsi;                        // value

        // --- (1) inited?
        mov rax, [rip + _ec_inited];
        cmp rax, 0;
        je  ecw_notinit;

        // --- (2) needs_reset?
        mov rax, [rip + _ec_needs_reset];
        cmp rax, 0;
        jne ecw_resetreq;

        // --- (3) offset < 256?
        mov rax, 256;
        cmp r12, rax;
        jae ecw_badoff;

        // --- (4) value < 256?
        mov rax, 256;
        cmp r13, rax;
        jae ecw_badval;

        // --- Record the transaction tuple.
        mov rax, 0x81;                       // EC_CMD_WRITE
        mov [rip + _ec_last_cmd],   rax;
        mov [rip + _ec_last_addr],  r12;
        mov [rip + _ec_last_value], r13;

        // --- Bump the counter.
        mov rax, [rip + _ec_write_ct];
        add rax, 1;
        mov [rip + _ec_write_ct], rax;

        // --- Mark FSM done.
        mov rax, 4;                          // EC_PHASE_DONE
        mov [rip + _ec_last_phase], rax;

        xor rax, rax;                        // EC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ecw_notinit:
        mov rax, 0xFFFFFFCA;                 // EC_ERR_UNKNOWN
        pop r13;
        pop r12;
        pop rbx;
        ret;
      ecw_resetreq:
        mov rax, 0xFFFFFFC8;                 // EC_ERR_RESET_REQ
        pop r13;
        pop r12;
        pop rbx;
        ret;
      ecw_badoff:
        mov rax, 0xFFFFFFCA;                 // EC_ERR_UNKNOWN
        pop r13;
        pop r12;
        pop rbx;
        ret;
      ecw_badval:
        mov rax, 0xFFFFFFCA;                 // EC_ERR_UNKNOWN
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  ec_query() -> u64
  //
  // SKELETON: gate on (inited AND NOT needs_reset), record (cmd=QR,
  // addr=0, value=0 since skeleton has no query byte to return),
  // bump _ec_query_ct, mark done, return 0 (meaning "no query
  // pending" per ACPI 6.5 §12.6).
  //
  // Real body: PHASE_CMD outb(EC_PORT_SC, EC_CMD_QUERY); poll
  // IBF==0; PHASE_DATA poll OBF==1; value = inb(EC_PORT_DATA). The
  // phase sequence SKIPS PHASE_STATUS because QUERY has no operand.
  //
  // No arguments. Returns 0 (no query) or 1..255 (the query byte,
  // which is a one-nibble event-source id — see ec_route.pdx for
  // the _Qxx dispatch that consumes it), or one of the error
  // codes on refusal.
  //
  // SysV: no inputs. Two pushes. Labels prefixed `ecq_`.
  // ==========================================================================

  pub let ec_query : () -> u64 !{mem} @{boot} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: issue QR_EC and return the query byte. Gates: (1) inited, (2) NOT needs_reset. There is no third gate because QR has no address or value operand; the whole surface area is 'ask the controller what event woke the SCI'. Record cmd=0x84 (EC_CMD_QUERY), addr=0, value=0 at skeleton stage: addr=0 is honest because QR takes no address, and value=0 encodes 'no query pending' per ACPI 6.5 §12.6. Bump _ec_query_ct, mark FSM done, return 0. The ring-3 consumer (user/aml/aml_ec.pdx) interprets 0 as 'no event' and bails out of the _Qxx dispatch loop — the skeleton's 0 is therefore a VALID runtime result, not a stub placeholder. Only 2 pushes (rbx, r12) needed because no second argument; entry rsp%16==8, after 2 pushes rsp%16==8 still but no nested call fires. Labels prefixed `ecq_`.",
      block: {
        push rbx;
        push r12;

        // --- (1) inited?
        mov rax, [rip + _ec_inited];
        cmp rax, 0;
        je  ecq_notinit;

        // --- (2) needs_reset?
        mov rax, [rip + _ec_needs_reset];
        cmp rax, 0;
        jne ecq_resetreq;

        // --- Record (cmd=QR, addr=0, value=0).
        mov rax, 0x84;                       // EC_CMD_QUERY
        mov [rip + _ec_last_cmd], rax;
        xor rax, rax;
        mov [rip + _ec_last_addr],  rax;
        mov [rip + _ec_last_value], rax;

        // --- Bump the counter.
        mov rax, [rip + _ec_query_ct];
        add rax, 1;
        mov [rip + _ec_query_ct], rax;

        // --- Mark FSM done.
        mov rax, 4;                          // EC_PHASE_DONE
        mov [rip + _ec_last_phase], rax;

        xor rax, rax;                        // query = 0 (no event)
        pop r12;
        pop rbx;
        ret;

      ecq_notinit:
        mov rax, 0xFFFFFFCA;                 // EC_ERR_UNKNOWN
        pop r12;
        pop rbx;
        ret;
      ecq_resetreq:
        mov rax, 0xFFFFFFC8;                 // EC_ERR_RESET_REQ
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  ec_handler_opregion(op, offset, value) -> u64
  //
  // SKELETON: the dispatch stub the KIND_OP_REGION handler will call
  // when the row's space_id is OPREG_SPACE_EC (0x03). Routes to one
  // of {ec_read_u8, ec_write_u8, ec_query} by `op`:
  //
  //   op == EC_HANDLER_OP_READ  (1) -> ec_read_u8(offset)
  //   op == EC_HANDLER_OP_WRITE (2) -> ec_write_u8(offset, value)
  //   op == EC_HANDLER_OP_QUERY (3) -> ec_query()
  //   otherwise                      -> EC_ERR_BAD_OPCODE
  //
  // After a successful route, EMIT the Wave 59 success fingerprint
  //
  //   EC OPREGION OK cmd=<2-hex> addr=0x<2-hex> value=0x<2-hex>
  //
  // via `klog_s1_x3` using the recorded _ec_last_cmd / _ec_last_addr
  // / _ec_last_value fields. The fingerprint is emitted here (not in
  // each of the three leaf entrypoints) so a direct caller of
  // ec_read_u8 (e.g. a kernel self-test) does not spam the log — the
  // fingerprint is specifically about the OpRegion dispatch path.
  //
  // Returns whatever the delegated entrypoint returned. On a
  // delegate error, the fingerprint is NOT emitted (the delegate's
  // own stat updates still fire; the fingerprint is for successful
  // dispatches only).
  //
  // SysV: rdi = op, rsi = offset, rdx = value. Register plan: 5
  // pushes (rbx, r12, r13, r14, r15) leave rsp%16 == 8; one `sub
  // rsp, 8` + two `push <stack-arg>` for klog_s1_x3's three
  // stack-slot args (v2, k3, v3) means total stack adjust 32 B;
  // after the add rsp,32 the body rsp%16 == 8 again — single-
  // return epilogue. Labels prefixed `ech_`.
  // ==========================================================================

  pub let ec_handler_opregion : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (op: u64, offset: u64, value: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: the dispatcher stub the KIND_OP_REGION handler calls when space_id==OPREG_SPACE_EC. Routes by op to ec_read_u8/ec_write_u8/ec_query. The route choice is a cmp-chain (not a jump table) because op has three live values and a chain is one branch per case versus a table that would waste 253 slots. Rejects anything outside {1,2,3} with EC_ERR_BAD_OPCODE (0xFFFFFFC9), chosen over EC_ERR_UNKNOWN because 'wrong opcode' is a MORE SPECIFIC refusal — the dispatcher's op is a constant chosen by the ACPI subsystem, so an unknown value here is a plumbing bug upstream and the error name should say so. On successful delegate, emits the success fingerprint via klog_s1_x3 with k1=cmd, v1=last_cmd, k2=addr, v2=last_addr, k3=value, v3=last_value — reading the three fields FROM MEMORY (not from the delegate's return value) so a read-ec call that returned 0 as its byte still shows value=0x00 in the fingerprint rather than being conflated with the delegate's return. Stack-alignment accounting: SysV entry has rsp%16==8. The 5-push callee-save prologue (rbx, r12=op saved, r13=offset saved, r14=value saved, r15=delegate return saved) adds 40 B so rsp%16==(8-40)%16==0 after prologue. Three stack-arg pushes for klog_s1_x3 (v3, k3_ptr, v2 in reverse-order LIFO so after CALL [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3) would leave rsp%16==8 and misalign the CALL; one `sub rsp, 8` is inserted BEFORE the three pushes to add the 8 B of adjustment that makes rsp%16==0 at CALL. The post-call `add rsp, 32` reclaims the align-sub (8) + three pushes (24) in one shot. Labels prefixed `ech_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // op
        mov r13, rsi;                        // offset
        mov r14, rdx;                        // value

        // --- Opcode dispatch.
        cmp r12, 1;                          // EC_HANDLER_OP_READ
        je  ech_do_read;
        cmp r12, 2;                          // EC_HANDLER_OP_WRITE
        je  ech_do_write;
        cmp r12, 3;                          // EC_HANDLER_OP_QUERY
        je  ech_do_query;
        jmp ech_badop;

      ech_do_read:
        mov rdi, r13;
        call ec_read_u8;
        mov r15, rax;                        // save return
        jmp ech_check;

      ech_do_write:
        mov rdi, r13;
        mov rsi, r14;
        call ec_write_u8;
        mov r15, rax;
        jmp ech_check;

      ech_do_query:
        call ec_query;
        mov r15, rax;
        jmp ech_check;

      ech_check:
        // If the delegate's return has the top 24 bits of the error
        // band (0xFFFFFF prefix), skip the fingerprint — this is a
        // refusal path and the delegate already updated its own
        // counters. Any value < 0xFFFFFF00 is a successful byte.
        mov rax, r15;
        mov r11, 0xFFFFFF00;
        cmp rax, r11;
        jae ech_out;

        // --- Emit the success fingerprint.
        //
        //   EC OPREGION OK cmd=<2-hex> addr=0x<2-hex> value=0x<2-hex>
        //
        // klog_s1_x3 signature (per wrappers.pdx §klog_s1_x3):
        //   rdi = level (3 = LEVEL_INFO)
        //   rsi = subsys_ptr (SUBSYS_DRV_)
        //   rdx = tag_ptr
        //   rcx = k1_ptr, r8 = v1
        //   r9  = k2_ptr
        //   [rsp+8]  = v2
        //   [rsp+16] = k3_ptr
        //   [rsp+24] = v3
        //
        // Alignment: after the 5 callee-save pushes rsp%16==0. Three
        // stack-arg pushes (24 B) would move rsp to rsp%16==8 and
        // misalign the klog_s1_x3 CALL (which requires %16==0). One
        // `sub rsp, 8` BEFORE the pushes adjusts to rsp%16==8, then
        // the three 8-byte pushes land rsp back at %16==0 for the
        // CALL. The pushes are LIFO so to get [rsp+8]=v2, [rsp+16]=k3,
        // [rsp+24]=v3 after the CALL (which pushes return addr at
        // [rsp+0]), the push order is REVERSE: v3 first, then k3_ptr,
        // then v2. Post-call `add rsp, 32` reclaims the 8 B align +
        // 24 B pushes in one shot.

        sub rsp, 8;                          // align-for-push
        mov rax, [rip + _ec_last_value];
        push rax;                            // [rsp+24] = v3 after CALL
        lea rax, [rip + ec_k_value];
        push rax;                            // [rsp+16] = k3_ptr after CALL
        mov rax, [rip + _ec_last_addr];
        push rax;                            // [rsp+8]  = v2 after CALL

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + ec_tag_ok];
        lea rcx, [rip + ec_k_cmd];
        mov r8,  [rip + _ec_last_cmd];       // v1
        lea r9,  [rip + ec_k_addr];
        call klog_s1_x3;
        add rsp, 32;                         // reclaim align + 3 pushes

        mov rax, r15;                        // return delegate value
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ech_out:
        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      ech_badop:
        mov rax, 0xFFFFFFC9;                 // EC_ERR_BAD_OPCODE
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  Stat getters — single-load leaves for witness callers
  //
  // Named counterparts to the LPG D7 skeleton's getter set. A boot
  // witness can assert `ec_inited()==1 AND ec_read_count() > 0` after
  // a smoke test that drives ec_handler_opregion a known number of
  // times.
  // ==========================================================================

  pub let ec_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_inited. Pair for the counter getters so a witness can observe the init-latch flip. Leaf.",
      block: { mov rax, [rip + _ec_inited]; ret }
    }

  pub let ec_needs_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_needs_reset. Non-zero after a timeout, zero after a subsequent ec_init. The real body's timeout path flips it; the skeleton never does. Leaf.",
      block: { mov rax, [rip + _ec_needs_reset]; ret }
    }

  pub let ec_last_phase : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_last_phase. EC_PHASE_DONE (4) after a successful transaction; one of IDLE/CMD/STATUS/DATA (0..3) after a timeout. Leaf.",
      block: { mov rax, [rip + _ec_last_phase]; ret }
    }

  pub let ec_last_cmd : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_last_cmd. The last opcode written to EC_SC. Leaf.",
      block: { mov rax, [rip + _ec_last_cmd]; ret }
    }

  pub let ec_last_addr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_last_addr. The last address byte written to EC_DATA, 0 for QR. Leaf.",
      block: { mov rax, [rip + _ec_last_addr]; ret }
    }

  pub let ec_last_value : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_last_value. The last byte read from or written to EC_DATA. Leaf.",
      block: { mov rax, [rip + _ec_last_value]; ret }
    }

  pub let ec_read_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_read_ct. Bumped once per successful ec_read_u8. Leaf.",
      block: { mov rax, [rip + _ec_read_ct]; ret }
    }

  pub let ec_write_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_write_ct. Bumped once per successful ec_write_u8. Leaf.",
      block: { mov rax, [rip + _ec_write_ct]; ret }
    }

  pub let ec_query_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_query_ct. Bumped once per successful ec_query. Leaf.",
      block: { mov rax, [rip + _ec_query_ct]; ret }
    }

  pub let ec_timeout_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2525 (Wave 59 D8) skeleton: single-load getter for _ec_timeout_ct. The real body bumps this once per phase-poll bust; the skeleton never does, so this returns 0 until the follow-up slice lands. Leaf.",
      block: { mov rax, [rip + _ec_timeout_ct]; ret }
    }

}
