// src/kernel/core/drivers/rtl8139/irq.pdx -- R91.M4-004 (paideia-os #2028)
//
// Realtek RTL8139 interrupt handler. Sibling of mac.pdx under the
// same milestone; kept in a separate file to mirror the sibling
// driver layouts (drivers/e1000e/irq.pdx, drivers/virtio_net/isr.pdx).
//
// =============================================================================
// SECTION 0  RTL8139 ISR SEMANTICS (RTL8139 ProgrammersGuide §5)
// =============================================================================
//
// The rtl8139 exposes two 16-bit registers for interrupt handling:
//
//   IMR  (u16 @ bar1+0x3C)  -- interrupt mask register (which causes
//                              propagate to the INTx line / MSI vector).
//   ISR  (u16 @ bar1+0x3E)  -- interrupt status register (which causes
//                              are asserted right now).
//
// ISR is write-1-to-clear (W1C): the driver writes back the bits it
// serviced to acknowledge them. The remaining bits stay asserted
// until either serviced or manually written.
//
// Documented cause bits consumed here:
//
//   ROK  (bit 0, 0x0001)  Receive OK -- one or more frames landed in
//                         the RX buffer since last ISR read/clear.
//   RER  (bit 1, 0x0002)  Receive Error -- a frame arrived with a
//                         CRC / alignment / runt error. Not drained
//                         at MVP (rtl8139_rx_poll already ignores
//                         corrupt frames per §2 of rx.pdx).
//   TOK  (bit 2, 0x0004)  Transmit OK -- a transmit descriptor
//                         completed. TX is fire-and-forget at MVP
//                         (see tx.pdx §"MVP simplifications"), so
//                         nothing to do; the bit is acknowledged
//                         (W1C) but not otherwise serviced.
//   TER  (bit 3, 0x0008)  Transmit Error -- collision cap exceeded /
//                         under-run / etc. Acknowledged but not
//                         otherwise serviced at MVP.
//   others (bits 4..15)   RXOVW / PUN_LinkChg / FOVW / LenChg / TimeOut
//                         / SysErr / etc. Not enabled in IMR at MVP
//                         (RTL8139_IMR_DEFAULT = 0x0005 = ROK|TOK)
//                         but ISR may still latch them from spurious
//                         asserts; the write-back mask below (r12) is
//                         the full snapshot, so any latched bit is
//                         cleared alongside the ones we care about.
//
// Read-then-write-back discipline: we snapshot ISR once into r12,
// dispatch off the snapshot (multiple bit tests against the same
// value), then write the snapshot back verbatim to clear every bit
// we saw. This mirrors drivers/e1000e/irq.pdx's ICR discipline and
// drivers/virtio_net/isr.pdx's ISR-status discipline.
//
// =============================================================================
// SECTION 1  BAR RESOLUTION + SINGLE-ACTIVE-NIC SCOPE
// =============================================================================
//
// probe.pdx records bar1_pa at record+8. MVP scope is single-active-
// NIC so slot 0 is the only record ever consulted. The gate before
// any MMIO is _rtl8139_device_count > 0 -- zero means probe did not
// find a device and any MMIO to slot 0 would dereference garbage.
//
// =============================================================================
// SECTION 2  FINGERPRINT DISCIPLINE
// =============================================================================
//
// One fingerprint tag owns the OK signal:
//
//   rtl8139_isr_ok_msg
//     Emitted at EVERY ISR entry that gets past the NO_DEV gate, via
//     klog_s1_d1 with k_bits carrying the ISR snapshot. This line lets
//     a boot photograph confirm the ISR is being invoked even when
//     the queue/TOK bits are both 0 (a spurious IRQ still leaves the
//     fingerprint). Matches drivers/virtio_net/isr.pdx §3 posture.
//
// =============================================================================
// SECTION 3  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// Labels prefixed `rtl_isr_`. MMIO u16 read+write via mfence-bracketed
// `xor rax,rax; mov_w rax,[mem]` / `mov_w [mem], reg` (matches drivers/
// virtio_net/isr.pdx §"MMIO byte read"). Bit tests via mov scratch,
// r12; and scratch, imm; cmp scratch, 0; je/jne so the ISR snapshot
// in r12 is not consumed by the first cause dispatch. No `add reg,
// [mem]`.

module Irq = structure {

  // ============================================================================
  // MMIO register offsets consumed here (bar1_pa is the base).
  // ============================================================================

  pub let RTL8139_REG_ISR       : u64 = 0x3E    // u16 interrupt status

  pub let RTL8139_ISR_ROK       : u64 = 0x0001
  pub let RTL8139_ISR_RER       : u64 = 0x0002
  pub let RTL8139_ISR_TOK       : u64 = 0x0004
  pub let RTL8139_ISR_TER       : u64 = 0x0008

  // ============================================================================
  // Fingerprint tag (ONE-line pdx string literal).
  //
  //   "rtl8139 isr ok [legacy: RTL8139 ISR OK]"
  //     39 printable chars + 1 NUL terminator = 40 bytes.
  //
  // OK_TOK regex matches on the bracketed legacy shard's word-boundary
  // OK. Needs an ALLOWLIST entry alongside the sibling virtio_net_isr_
  // ok_msg entry until R91.M5 boot_r91_nic_probe smoke (#2031) pins
  // it under a PAIDEIA_NIC=rtl8139 boot mode.
  // ============================================================================

  pub let rtl8139_isr_ok_msg : [u8; 40] = "rtl8139 isr ok [legacy: RTL8139 ISR OK]\0"

  // ============================================================================
  // rtl8139_isr_handle() -> u64
  //
  // IRQ entry point (single-active-NIC MVP: always services slot 0).
  //
  // Returns:
  //   0  always (the ISR does not surface an errno to the trampoline
  //      -- a genuine error would land through a diag emit instead).
  //
  // Body:
  //   (1) Gate: if _rtl8139_device_count == 0 -> xor rax,rax; return
  //       (no device to service, no fingerprint since there is nothing
  //       meaningful to log about a spurious IRQ from a non-existent
  //       device).
  //   (2) Load bar1_pa from _rtl8139_devices[0]+8.
  //   (3) Read ISR (u16 @ bar+0x3E), snapshot in r12 (callee-save --
  //       survives every nested call).
  //   (4) Emit fingerprint klog_s1_d1(NET_, isr_ok_msg, k_bits, r12)
  //       carrying the raw snapshot.
  //   (5) If ROK (r12 & 0x0001) -> call rtl8139_rx_poll(bar_pa).
  //   (6) TOK / RER / TER: no service at MVP; W1C in step (7) still
  //       acknowledges them so they do not re-latch.
  //   (7) Write r12 back to ISR (W1C ack).
  //   (8) xor rax, rax; return.
  //
  // Register plan (2-push callee-save + 8 B align pad):
  //   rbx = bar_pa   (survives the RX drain + the fingerprint call)
  //   r12 = ISR snapshot (survives klog_s1_d1 + rtl8139_rx_poll so
  //         the ack write in step 7 sees the full original bit set)
  //
  //   2 pushes = 16 B; entry rsp%16==8 -> 24; sub rsp,8 -> 32, %16==0
  //   (aligned for nested SysV calls).
  //
  // Labels prefixed `rtl_isr_`.
  // ============================================================================

  pub let rtl8139_isr_handle : () -> u64 !{sysreg, mem} @{irq} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { irq },
      justification: "R91.M4-004 (paideia-os #2028). RTL8139 ISR handler. Snapshots the ISR u16 (bar1+0x3E), emits a per-entry fingerprint carrying the raw bits, dispatches on bit 0 (ROK -> rtl8139_rx_poll drain), no-op on bits 2/1/3 (TOK/RER/TER -- serviced by W1C ack only at MVP), writes the snapshot back to ack all latched bits, returns 0. Body: (1) 2-push callee-save (rbx=bar_pa, r12=ISR snapshot) + sub rsp,8 = 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for nested calls). (2) NO_DEV gate: load _rtl8139_device_count; if 0 -> xor rax,rax; teardown; ret (no fingerprint -- nothing to log about a spurious IRQ from a non-existent device; the ISR trampoline attach itself is guarded by device_count > 0 in the future R91.M5 wiring, so this arm is defence-in-depth). (3) Load bar1_pa from _rtl8139_devices[0]+8 into rbx. (4) Read ISR (u16 @ rbx+0x3E) with mfence-bracket envelope: `mov r10, rbx; add r10, 0x3E; mfence; xor rax, rax; mov_w rax, [r10]; mfence`. Stash in callee-save r12. (5) Emit fingerprint: klog_s1_d1(LEVEL_INFO=3, SUBSYS_NET_, rtl8139_isr_ok_msg, k_bits, r12). Emitted at EVERY entry past the NO_DEV gate so a spurious IRQ (r12==0) still leaves a witness -- matches drivers/virtio_net/isr.pdx §3 discipline. (6) ROK dispatch: mov rax, r12; and rax, 0x0001; cmp rax, 0; je rtl_isr_after_rok; mov rdi, rbx; call rtl8139_rx_poll (returns count in rax, ignored at IRQ scope). (7) TOK/RER/TER: no service at MVP; the W1C ack below clears them. Future R91.M4-005+ MAY add a TX descriptor reap on TOK; the ISR snapshot is preserved in r12 across the ack so that landing does not need to re-read the register. (8) ISR W1C ack: `mov r10, rbx; add r10, 0x3E; mov_w [r10], r12` -- write-back the snapshot verbatim to clear every bit we saw. Ordering: no post-fence needed; the store globally retires before any following instruction per SDM Vol 3A §11.3.1. (9) xor rax, rax; teardown; ret. Encoder discipline: MMIO u16 read+write via mfence-bracketed xor+mov_w / mov_w-store; bit tests via mov scratch, r12; and scratch, imm; cmp scratch, 0 (so r12 stays clean for the ack). No `add reg, [mem]`. Effects !{sysreg, mem} @{irq} -- @{irq} matches an IDT-vector-called routine (the IDT attach lands in a future R91.M5 wiring). Labels prefixed rtl_isr_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // ---------- (2) NO_DEV gate ----------
        mov rax, [rip + _rtl8139_device_count];
        cmp rax, 0;
        jne rtl_isr_have_dev;
        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret;

      rtl_isr_have_dev:
        // ---------- (3) Load bar1_pa from _rtl8139_devices[0]+8 ----------
        lea r10, [rip + _rtl8139_devices];
        mov rbx, [r10 + 8];

        // ---------- (4) Read ISR (u16 @ bar+0x3E), snapshot in r12 ----------
        mov r10, rbx;
        add r10, 0x3E;
        mfence;
        xor rax, rax;
        mov_w rax, [r10];
        mfence;
        mov r12, rax;                            // r12 = ISR snapshot

        // ---------- (5) Fingerprint: "rtl8139 isr ok bits=<isr>" ----------
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + rtl8139_isr_ok_msg];
        lea rcx, [rip + k_bits];
        mov r8, r12;                             // v1 = snapshot
        call klog_s1_d1;

        // ---------- (6) ROK -> RX drain ----------
        mov rax, r12;
        and rax, 0x0001;                         // ROK bit
        cmp rax, 0;
        je rtl_isr_after_rok;

        mov rdi, rbx;                            // bar_pa
        call rtl8139_rx_poll;                    // returns count (ignored)

      rtl_isr_after_rok:
        // ---------- (7) TOK / RER / TER: no service at MVP; W1C ack ----------

        // ---------- (8) ISR W1C ack: write snapshot back ----------
        mov r10, rbx;
        add r10, 0x3E;
        mov_w [r10], r12;

        // ---------- (9) Return 0 ----------
        xor rax, rax;
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
