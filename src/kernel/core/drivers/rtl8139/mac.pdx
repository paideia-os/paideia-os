// src/kernel/core/drivers/rtl8139/mac.pdx -- R91.M4-004 (paideia-os #2028)
//
// Realtek RTL8139 MAC address read. The rtl8139 carries the burned-in
// MAC (or the EEPROM-programmed override on OEM boards) in the six
// consecutive u8 registers IDR0..IDR5 at bar1+0x00..0x05. Reading is
// direct MMIO with no EEPROM window handshake -- much simpler than
// e1000e's EERD polling (drivers/e1000e/mac.pdx §"EEPROM word layout")
// because the rtl8139 exposes the shadow copy of the MAC directly in
// its register file.
//
// =============================================================================
// SECTION 0  IDR0..IDR5 LAYOUT (RTL8139 ProgrammersGuide §5)
// =============================================================================
//
//   IDR0  u8 @ bar1+0x00   MAC byte 0 (OUI[0])
//   IDR1  u8 @ bar1+0x01   MAC byte 1 (OUI[1])
//   IDR2  u8 @ bar1+0x02   MAC byte 2 (OUI[2])
//   IDR3  u8 @ bar1+0x03   MAC byte 3 (NIC-suffix[0])
//   IDR4  u8 @ bar1+0x04   MAC byte 4 (NIC-suffix[1])
//   IDR5  u8 @ bar1+0x05   MAC byte 5 (NIC-suffix[2])
//
// Wire order matches memory order: byte 0 is the first octet
// transmitted on the wire (typically the highest-order OUI byte). We
// pack the six bytes little-endian into a u64: byte 0 in bits [7:0],
// byte 5 in bits [47:40], upper 16 bits (bits [63:48]) left zero to
// satisfy the KIND_NIC mac_word contract (cap/kind_nic.pdx §"nic_mac_
// valid": bits [63:48] must be zero on mint).
//
// =============================================================================
// SECTION 1  RECORD FIELD OFFSET CONSUMED
// =============================================================================
//
// probe.pdx records the per-device MAC slot at record+24 (u64). This
// module writes the packed u64 there and also returns it in rax so
// the caller can hand it directly to kind_nic_mint_body without an
// intermediate reload.
//
// =============================================================================
// SECTION 2  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// Labels prefixed `rtl_mac_`. Encoder-conservative posture:
//   * MMIO byte reads bracketed with mfence pairs (matches drivers/
//     virtio_net/mac.pdx §"MAC[0]" pattern).
//   * u8 loads via `xor rax,rax; mov_b rax, [mem]` (no mov_bzx).
//   * The packed u64 store uses bare `mov [mem], reg64` (natural 8-B
//     store into an 8-B slot; x86-64 tolerates unaligned WB writes
//     but the record is @align(8) so it is naturally aligned anyway).

module Mac = structure {

  // ============================================================================
  // Fingerprint tag (ONE-line pdx string literal).
  //
  //   "rtl8139 mac ok [legacy: RTL8139 MAC OK]"
  //     39 printable chars + 1 NUL terminator = 40 bytes.
  //
  // OK_TOK regex matches on the bracketed legacy shard's word-boundary
  // OK. Needs an ALLOWLIST entry alongside the sibling virtio_net_mac_
  // ok_msg entry until R91.M5 boot_r91_nic_probe smoke (#2031) pins
  // it under a PAIDEIA_NIC=rtl8139 boot mode.
  // ============================================================================

  pub let rtl8139_mac_ok_msg : [u8; 40] = "rtl8139 mac ok [legacy: RTL8139 MAC OK]\0"

  // ============================================================================
  // rtl8139_read_mac(bar_pa: u64) -> u64
  //
  // SysV: (bar_pa: u64) -> u64
  //   rdi = BAR1 physical base (MMIO)
  //
  // Reads IDR0..IDR5, packs the six bytes little-endian into a u64
  // (byte 0 in bits [7:0], byte 5 in bits [47:40], upper 16 bits
  // zero), writes the packed value to _rtl8139_devices[0]+24, emits
  // the fingerprint, and returns the packed value in rax.
  //
  // Single-active-NIC MVP scope: always writes to slot 0. The multi-
  // NIC promotion mirrors the same substrate change the RX/TX/ISR
  // paths will need and is a shared future edit.
  //
  // Register plan (3-push callee-save + 8 B align pad):
  //   rbx = bar_pa  (survives every MMIO read + the fingerprint call)
  //   r12 = packed MAC accumulator (survives klog_s1_d1 -> return via rax)
  //   r13 = &_rtl8139_devices[0]
  //
  //   3 pushes = 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for the
  //   nested klog_s1_d1 without extra pad).
  //
  // Labels prefixed `rtl_mac_`.
  // ============================================================================

  pub let rtl8139_read_mac : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R91.M4-004 (paideia-os #2028). Read the six MAC bytes from RTL8139 IDR0..IDR5 (u8 @ bar1+0x00..0x05), pack little-endian into a u64 (byte 0 in bits [7:0], byte 5 in bits [47:40], upper 16 bits zero to satisfy the KIND_NIC mac_word contract per cap/kind_nic.pdx nic_mac_valid), store at _rtl8139_devices[0]+24, emit fingerprint, return packed value in rax. Body: (1) 3-push (rbx=bar_pa, r12=packed accumulator, r13=&record[0]) -- 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for nested klog_s1_d1). (2) mov rbx, rdi (bar_pa). (3) Zero r12 (accumulator). (4) For N in 0..6: `mov r10, rbx; add r10, N; mfence; xor rax, rax; mov_b rax, [r10]; mfence; shl rax, (N*8); or r12, rax`. Six unrolled iterations rather than a runtime loop because the trip count is a compile-time constant and unrolling avoids a loop-index register. (5) Store packed MAC at record[0]+24: `lea r13, [rip + _rtl8139_devices]; mov [r13 + 24], r12`. (6) Emit fingerprint klog_s1_d1(LEVEL_INFO=3, SUBSYS_NET_, rtl8139_mac_ok_msg, k_mac, r12). r12 survives per SysV. (7) mov rax, r12; teardown. Encoder discipline: MMIO byte reads bracketed with mfence pairs (matches drivers/virtio_net/mac.pdx §MAC[0] pattern); no mov_bzx -- xor+mov_b dst-zero form. Reserved-label discipline: labels prefixed rtl_mac_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                            // rbx = bar_pa
        xor r12, r12;                            // packed accumulator

        // ---------- IDR0 -> MAC[0] into bits [7:0] ----------
        mov r10, rbx;
        add r10, 0;                              // IDR0 offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        or r12, rax;

        // ---------- IDR1 -> MAC[1] << 8 ----------
        mov r10, rbx;
        add r10, 1;                              // IDR1 offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        shl rax, 8;
        or r12, rax;

        // ---------- IDR2 -> MAC[2] << 16 ----------
        mov r10, rbx;
        add r10, 2;                              // IDR2 offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        shl rax, 16;
        or r12, rax;

        // ---------- IDR3 -> MAC[3] << 24 ----------
        mov r10, rbx;
        add r10, 3;                              // IDR3 offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        shl rax, 24;
        or r12, rax;

        // ---------- IDR4 -> MAC[4] << 32 ----------
        mov r10, rbx;
        add r10, 4;                              // IDR4 offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        shl rax, 32;
        or r12, rax;

        // ---------- IDR5 -> MAC[5] << 40 ----------
        mov r10, rbx;
        add r10, 5;                              // IDR5 offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        shl rax, 40;
        or r12, rax;

        // ---------- Store packed MAC into slot 0's record @+24 ----------
        lea r13, [rip + _rtl8139_devices];
        mov [r13 + 24], r12;

        // ---------- Fingerprint: "rtl8139 mac ok mac=<packed>" ----------
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + rtl8139_mac_ok_msg];
        lea rcx, [rip + k_mac];
        mov r8, r12;                             // v1 = packed MAC
        call klog_s1_d1;

        // ---------- Return packed MAC ----------
        mov rax, r12;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
