// src/kernel/core/drivers/rtl8139/probe.pdx -- R91.M4-001 (paideia-os #2025)
//   + R111.M2-006 (paideia-os #2358) probe-table refactor.
//
// Realtek RTL8139 (NE2K-clone-era, 10/100 PCI) NIC device probe.
//
// After pci_enumerate_all_segments (src/kernel/core/pci/enum.pdx) populates
// _pci_devices with one 32-byte record per enumerated function, this probe
// consults pci_probe_table_find (core/pci/enum.pdx §pci_probe_table_find)
// with the packed (vid<<16)|did key for Realtek RTL8139:
//
//   vendor_id  = 0x10EC (Realtek)
//   device_id  = 0x8139 (RTL8139)
//   class_code = 0x02 / subclass = 0x00 (network / ethernet) -- implied
//                 by the vendor/device pair for this NIC; not filtered
//                 on because the (vid,did) already uniquely identifies
//                 the RTL8139 silicon family.
//
// R111.M2-006 (#2358) replaces the pre-existing walk-of-_pci_devices
// body with a single pci_probe_table_find call. The BAR-read semantics
// (BAR1 as the primary MMIO carrier, BAR0 as the recorded-but-unused
// I/O window) and the first-device reset+power-on tail are preserved
// byte-for-byte.
//
// The device exposes two BARs:
//
//   BAR0 (config +0x10) -- 256-byte I/O port window (bit 0 == 1)
//   BAR1 (config +0x14) -- 256-byte MMIO window     (bit 0 == 0)
//
// Both BARs address the SAME register file. We prefer BAR1 (MMIO)
// because the rest of the driver (rx.pdx / tx.pdx / mac.pdx / irq.pdx)
// uses ordinary MMIO loads/stores; using I/O ports would need an
// `inb`/`outb` primitive family that does not exist in paideia-as as
// of v0.24.x. BAR0 is recorded for future I/O-mode fallback but is
// not consumed at this milestone.
//
// -----------------------------------------------------------------------------
// _rtl8139_devices record layout (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  _pad0
//   +6    u16 _pad1
//   +8    u64 bar1_pa           // MMIO physical base (primary)
//   +16   u64 bar0_io           // I/O port base (recorded, unused MVP)
//   +24   u64 mac               // 6-byte MAC packed low; upper 2 B unused
//   +32   end
//
// -----------------------------------------------------------------------------
// R111.M2-006 fingerprints
// -----------------------------------------------------------------------------
//
// In addition to the pre-existing device-count rollup ("rtl8139 probe
// ok [legacy: RTL8139 PROBE OK] n=<count>") the probe now emits one of:
//
//   RTL8139 PROBE FOUND vid=<hex> did=<hex> bdf=<hex>   (match)
//   RTL8139 PROBE NONE                                   (no match)
//
// Neither literal contains a standalone "OK" token, so no ALLOWLIST
// entry is required in tools/verify-fingerprint-coverage.sh.
//
// -----------------------------------------------------------------------------
// RTL8139_MAX_DEVS = 1 (post R111.M2-006)
// -----------------------------------------------------------------------------
//
// The pre-refactor probe allowed up to 2 slots as defensive headroom
// for a hypothetical dual-NIC configuration; the refactor collapses to
// the single-device shape that matches pci_probe_table_find's "first
// match" contract. A second RTL8139 would still be visible in
// _pci_devices (the enum table records every BDF) but the driver
// tail's activation slot is singular.
//
// -----------------------------------------------------------------------------
// First-device reset + power-on
// -----------------------------------------------------------------------------
//
// On the discovered device we:
//
//   (1) Write CMD (u8 @ bar1+0x37) = 0x10 (RST, bit 4). The bit is
//       self-clearing once the controller has completed its internal
//       reset. QEMU clears it in a single MMIO round-trip; the RTL8139
//       ProgrammersGuide notes real silicon completes in "a few
//       microseconds". We poll for at most 1000 iterations (~30 us on
//       a 3 GHz core with the mfence-bracketed MMIO read cost) which
//       is ~1000x margin; if it never clears we still fall through --
//       the count fingerprint witnesses the discovery, and any
//       downstream MMIO to a wedged controller lands on its own
//       failure path rather than a hang here.
//
//   (2) Write Config1 (u8 @ bar1+0x52) = 0x00. Powers the controller
//       out of any sleep / LWAKE state and enables the primary DAC
//       reference. Safe to write unconditionally on QEMU.
//
// The subsequent RX and TX bring-up is NOT done here; it lands in
// rx.pdx (rtl8139_rx_init) and is invoked from the future
// nic_dispatch attach path once the R91.M4 dispatch cmp-chain arm is
// wired (issue directive: do NOT touch nic_dispatch.pdx here).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.24.x)
// -----------------------------------------------------------------------------
//
//   G1: sized MMIO stores go through mov_b / mov_w / mov_d; a bare
//       `mov [addr], reg` would widen to REX.W and clobber neighbouring
//       registers.
//   G4: full-register compares; no `add reg, [mem]`.
//   No mov_bzx / mov_wzx: byte / word loads use the
//       `xor rax,rax; mov_b/w rax, [mem]` dst-zero form (matches
//       drivers/virtio_net/mac.pdx L200 pattern).
//
// Reserved-label discipline: labels prefixed `rtl_pb_` to avoid the
// paideia-as reserved names (`loop`, `if`, `next`, ...).

module Probe = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let RTL8139_VENDOR_REALTEK : u64 = 0x10EC
  pub let RTL8139_DEVICE_ID      : u64 = 0x8139

  // Packed key handed to pci_probe_table_find: (vid<<16)|did.
  pub let RTL8139_VID_DID        : u64 = 0x10EC8139

  pub let RTL8139_MAX_DEVS       : u64 = 1
  pub let RTL8139_DEV_REC_SIZE   : u64 = 32

  // ---- MMIO register offsets consumed here ----
  pub let RTL8139_REG_CMD        : u64 = 0x37    // u8  command
  pub let RTL8139_REG_CONFIG1    : u64 = 0x52    // u8  config-1 (power)

  // ---- CMD bits ----
  pub let RTL8139_CMD_RST        : u64 = 0x10    // bit 4 -- software reset

  pub let RTL8139_RESET_SPIN_MAX : u64 = 1000

  // ============================================================================
  // Fingerprint tag (ONE-line pdx string literal, PDX_STR-gate friendly).
  //
  // "rtl8139 probe ok [legacy: RTL8139 PROBE OK]"
  //   43 printable chars + 1 NUL terminator = 44 bytes.
  // OK_TOK regex (tools/verify-fingerprint-coverage.sh L880) matches on the
  // word-boundary uppercase OK in the bracketed legacy shard. The literal
  // needs an ALLOWLIST entry alongside the sibling virtio_net_* / e1000e_*
  // probe-ok entries until R91.M5 boot_r91_nic_probe smoke (#2031) pins
  // it under a PAIDEIA_NIC=rtl8139 boot mode.
  // ============================================================================

  pub let rtl8139_probe_ok_msg : [u8; 44] = "rtl8139 probe ok [legacy: RTL8139 PROBE OK]\0"

  // R111.M2-006 (#2358) probe-table result fingerprints.
  pub let tag_rtl8139_probe_found : [u8; 20] = "RTL8139 PROBE FOUND\0"
  pub let tag_rtl8139_probe_none  : [u8; 19] = "RTL8139 PROBE NONE\0"

  // ============================================================================
  // Canonical static slots -- .bss, @align(8)
  //
  //   _rtl8139_devices         : 2 x 32 B = 64 B = 8 x u64
  //                              (backing storage preserved from the pre-
  //                              R111.M2-006 shape; RTL8139_MAX_DEVS=1
  //                              means only slot 0 is populated, and the
  //                              second slot stays defensive headroom.)
  //   _rtl8139_device_count    : populated by rtl8139_probe
  // ============================================================================

  pub let mut _rtl8139_devices      : [u64; 8] = uninit @align(8)
  pub let mut _rtl8139_device_count : u64      = 0

  // ============================================================================
  // rtl8139_probe() -> u64
  // ============================================================================
  //
  // SysV: () -> u64
  //   Returns rax = number of RTL8139 NICs discovered (0..1).
  //
  // Register plan (post R111.M2-006 refactor):
  //   r13 = discovered count (0 or 1)  -- return value carrier
  //   r14 = &_pci_devices[match_index]  (only when a match is found)
  //   r15 = &_rtl8139_devices[0]         (only when populating the record)
  //   rbx = bar1_pa (only during first-device reset + power-on tail)
  //   rbp = spin counter (only during reset poll)
  //
  //   Scratch slots:
  //     [rsp+0]  = seg  (u64, zero-extended)
  //     [rsp+8]  = bus  (u64)
  //     [rsp+16] = dev  (u64)
  //     [rsp+24] = fn   (u64)
  //     [rsp+32] = bar1_pa staging (u64)
  //     [rsp+40] = bar0_io staging (u64)
  //     [rsp+48] = packed_bdf staging (u64)
  //
  //   6 pushes = 48 B; entry rsp%16==8 -> 56; sub rsp,56 (56 scratch
  //   slots) -> 112, %16==0.

  pub let rtl8139_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R91.M4-001 (paideia-os #2025) + R111.M2-006 (paideia-os #2358). Realtek RTL8139 NIC device probe rewritten to consult the shared pci_probe_table_find helper instead of walking _pci_devices inline; first-device reset+power-on tail (CMD.RST assert + bounded 1000-iter mfence-bracketed poll + Config1 power clear) is preserved byte-for-byte from the pre-refactor body. Body: (1) 6-push callee-save prologue (rbx, rbp, r12-r15) = 48B; entry rsp%16==8 -> 56; sub rsp,56 (56 scratch slots [rsp+0..48]) -> 112, %16==0. (2) Init r13 = count = 0. (3) rdi = RTL8139_VID_DID = 0x10EC8139 = (0x10EC<<16)|0x8139; call pci_probe_table_find. rax = matched _pci_devices index or 0xFFFFFFFFFFFFFFFF. (4) No-match: emit klog_s1(INFO, NET_, tag_rtl8139_probe_none) and jump straight to the count-fingerprint tail (rtl_pb_publish). (5) Match: compute r14 = &_pci_devices[rax] = base + (rax<<5). Stash BDF -- seg u16@+0 at [rsp+0], bus/dev/fn u8@+2/+3/+4 at [rsp+8/16/24]. Compute packed_bdf = (seg<<32)|(bus<<16)|(dev<<8)|fn into [rsp+48]. Emit klog_s1_x3(INFO, NET_, tag_rtl8139_probe_found, k_vid, 0x10EC, k_did, 0x8139, k_bdf, packed_bdf) via the standard 3-stack-arg pre-align pattern (sub rsp,8; push v3=packed_bdf; push k3=k_bdf; push v2=0x8139; call; add rsp,24; add rsp,8). (6) Read BAR0 via pci_config_read_u32(seg, bus, dev, fn, 0x10); mask ~0x3 into [rsp+40] (bar0_io -- I/O window; recorded, unused at MVP). (7) Read BAR1 via pci_config_read_u32(..., 0x14); verify bit 0 == 0 (MEM BAR); else jmp rtl_pb_publish (fall through with r13=0). Mask ~0xF into [rsp+32] (bar1_pa). (8) Populate _rtl8139_devices[0] at r15 with seg/bus/dev/fn/pad0/pad1 + bar1_pa/bar0_io + mac=0 (populated later by rtl8139_read_mac). (9) r13 = 1. (10) First-device reset+power-on: load rbx = bar1_pa from _rtl8139_devices[0]+8; write CMD (u8@bar1+0x37) = 0x10 (RST bit); poll CMD.RST bit for clear via bounded 1000-iter spin bracketed by mfence to force the MMIO round-trip and prevent the compiler/CPU from CSE-ing the load. On timeout fall through -- the count fingerprint still witnesses discovery. Write Config1 (u8@bar1+0x52) = 0 to clear the sleep state. (11) Count tail: publish _rtl8139_device_count = r13; emit klog_s1_d1(INFO, NET_, rtl8139_probe_ok_msg, k_n, r13). Return r13 in rax. Encoder posture: G1 sized MMIO stores via mov_b/mov_w; G4 full-register compares (cmp reg, reg / cmp reg, imm — never cmp reg, [mem]); no 2-op imul r,imm, no and reg,imm64. Reserved-label posture: labels prefixed `rtl_pb_`. Every nested callee (pci_probe_table_find, pci_config_read_u32, klog_s1, klog_s1_x3, klog_s1_d1) preserves rbx/rbp/r12-r15 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;                             // 56 scratch slots

        xor r13, r13;                            // count = 0

        // ============================================================
        // R111.M2-006 (#2358): consult the shared probe-table helper.
        // rdi = (0x10EC << 16) | 0x8139 = 0x10EC8139.
        // ============================================================
        mov rdi, 0x10EC8139;                     // RTL8139_VID_DID
        call pci_probe_table_find;

        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je rtl_pb_none;

        // ---- Match: compute r14 = &_pci_devices[rax]. ----
        shl rax, 5;                              // record stride 32
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // Stash BDF into scratch.
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;                      // seg
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;                      // bus
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;                     // dev
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;                     // fn

        // ---- Compute packed_bdf. ----
        mov rax, [rsp + 0];
        and rax, 0xFFFF;
        shl rax, 32;
        mov r10, rax;
        mov rax, [rsp + 8];
        and rax, 0xFF;
        shl rax, 16;
        or  r10, rax;
        mov rax, [rsp + 16];
        and rax, 0x1F;
        shl rax, 8;
        or  r10, rax;
        mov rax, [rsp + 24];
        and rax, 7;
        or  r10, rax;
        mov [rsp + 48], r10;

        // ---- Emit "RTL8139 PROBE FOUND vid=<> did=<> bdf=<>". ----
        sub rsp, 8;                              // pre-align
        mov rax, [rsp + 56];                     // packed_bdf (post-sub-8)
        push rax;                                // v3
        lea rax, [rip + k_bdf];
        push rax;                                // k3
        mov rax, 0x8139;                         // RTL8139_DEVICE_ID
        push rax;                                // v2 = did

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + tag_rtl8139_probe_found];
        lea rcx, [rip + k_vid];
        mov r8, 0x10EC;                          // v1 = vid
        lea r9, [rip + k_did];
        call klog_s1_x3;

        add rsp, 24;                             // pop 3 pushed args
        add rsp, 8;                              // undo pre-align

        // ============================================================
        // Read BAR0 (config +0x10) -- I/O port window on this NIC.
        // Record the address either way; the I/O-mode fallback path is
        // out of scope at MVP.
        // ============================================================
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x10;
        call pci_config_read_u32;

        mov r10, rax;
        and r10, 0xFFFFFFFFFFFFFFFC;             // ~0x3
        mov [rsp + 40], r10;                     // bar0_io

        // ============================================================
        // Read BAR1 (config +0x14) -- 32-bit MMIO window (primary).
        // ============================================================
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x14;
        call pci_config_read_u32;

        // Verify MEM BAR (bit 0 == 0); else fall through with count=0.
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne rtl_pb_publish;

        and rax, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 32], rax;                     // bar1_pa

        // ============================================================
        // Populate _rtl8139_devices[0] at r15.
        // Only one device supported (RTL8139_MAX_DEVS=1) so no stride
        // multiplication is needed.
        // ============================================================
        lea r15, [rip + _rtl8139_devices];

        mov r10, [rsp + 0];                      // seg
        mov_w [r15 + 0], r10;

        mov r10, [rsp + 8];                      // bus
        mov_b [r15 + 2], r10;

        mov r10, [rsp + 16];                     // dev
        mov_b [r15 + 3], r10;

        mov r10, [rsp + 24];                     // fn
        mov_b [r15 + 4], r10;

        xor r10, r10;
        mov_b [r15 + 5], r10;                    // pad0
        mov_w [r15 + 6], r10;                    // pad1

        mov r10, [rsp + 32];                     // bar1_pa
        mov [r15 + 8], r10;

        mov r10, [rsp + 40];                     // bar0_io
        mov [r15 + 16], r10;

        xor r10, r10;
        mov [r15 + 24], r10;                     // mac = 0 (populated later)

        mov r13, 1;                              // count = 1

        // ================================================================
        // First-device reset + power-on. Uses rbx as the bar1 carrier
        // throughout; rbp as a scratch spin counter (both were the loop
        // cursors and are free after the refactor).
        // ================================================================
        mov rbx, [r15 + 8];                      // rbx = bar1_pa (u64 @+8)

        // (a) Assert CMD.RST (bit 4). CMD is u8 @ bar1+0x37.
        mov r10, rbx;
        add r10, 0x37;                           // CMD offset
        mov rax, 0x10;                           // CMD_RST
        mov_b [r10], rax;

        // (b) Poll CMD.RST clear. Bounded 1000-iter spin.
        mov rbp, 1000;                           // RTL8139_RESET_SPIN_MAX

      rtl_pb_wait_rst:
        mov r10, rbx;
        add r10, 0x37;                           // CMD offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        and rax, 0x10;                           // isolate RST bit
        cmp rax, 0;
        je rtl_pb_powerup;                       // RST cleared -> done

        sub rbp, 1;
        cmp rbp, 0;
        jne rtl_pb_wait_rst;
        // Timeout: fall through. Downstream MMIO to a wedged controller
        // will land on its own failure path; count fingerprint still
        // witnesses discovery.

      rtl_pb_powerup:
        // (c) Write Config1 = 0 (power on, clear sleep state).
        // Config1 is u8 @ bar1+0x52.
        mov r10, rbx;
        add r10, 0x52;
        xor rax, rax;
        mov_b [r10], rax;

        jmp rtl_pb_publish;

      rtl_pb_none:
        // R111.M2-006 (#2358): no matching (vid,did) in the probe table.
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + tag_rtl8139_probe_none];
        call klog_s1;
        // r13 stays 0 -- fall through to publish/emit-ok tail.

      rtl_pb_publish:
        mov [rip + _rtl8139_device_count], r13;

        // Device-count fingerprint ("rtl8139 probe ok [...] n=<count>").
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + rtl8139_probe_ok_msg];
        lea rcx, [rip + k_n];
        mov r8, r13;                             // v1 = count
        call klog_s1_d1;

        mov rax, r13;                            // return count

        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
