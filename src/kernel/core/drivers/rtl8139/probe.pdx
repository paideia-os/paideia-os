// src/kernel/core/drivers/rtl8139/probe.pdx -- R91.M4-001 (paideia-os #2025)
//
// Realtek RTL8139 (NE2K-clone-era, 10/100 PCI) NIC device probe.
//
// After pci_enumerate_all (src/kernel/core/pci/enum.pdx) populates
// _pci_devices with one 32-byte record per enumerated function, this
// probe filters that list for the Realtek vendor + RTL8139 device-ID
// pair:
//
//   vendor_id  = 0x10EC (Realtek)
//   device_id  = 0x8139 (RTL8139)
//   class_code = 0x02 / subclass = 0x00 (network / ethernet) -- implied
//                 by the vendor/device pair for this NIC; not filtered
//                 on to keep the match short and mirror the shape the
//                 rtl8139 spec's own probe example uses.
//
// The device exposes two BARs:
//
//   BAR0 (config +0x10) -- 256-byte I/O port window (bit 0 == 1)
//   BAR1 (config +0x14) -- 256-byte MMIO window     (bit 0 == 0)
//
// Both BARs address the SAME register file. We prefer BAR1 (MMIO)
// because the rest of the driver (rx.pdx / tx.pdx / mac.pdx / irq.pdx)
// uses ordinary MMIO loads/stores; using I/O ports would need an
// `inb`/`outb` primitive family that does not exist in paideia-as as
// of v0.24.x. BAR0 is recorded for future I/O-mode fallback but is
// not consumed at this milestone.
//
// -----------------------------------------------------------------------------
// _rtl8139_devices record layout (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  _pad0
//   +6    u16 _pad1
//   +8    u64 bar1_pa           // MMIO physical base (primary)
//   +16   u64 bar0_io           // I/O port base (recorded, unused MVP)
//   +24   u64 mac               // 6-byte MAC packed low; upper 2 B unused
//   +32   end
//
// Layout is byte-for-byte compatible with the shared 8-byte BDF prefix
// used by _e1000e_devices / _virtio_net_devices; the tail diverges to
// carry only the two BAR carriers and the MAC slot (populated later by
// rtl8139_read_mac in mac.pdx).
//
// -----------------------------------------------------------------------------
// RTL8139_MAX_DEVS = 2
// -----------------------------------------------------------------------------
//
// A single QEMU `-device rtl8139` supplies one function; the second
// slot is defensive headroom for a hypothetical two-NIC configuration.
// Additional matches are silently dropped and observable via the count
// in the probe-OK fingerprint.
//
// -----------------------------------------------------------------------------
// First-device reset + power-on
// -----------------------------------------------------------------------------
//
// On the first device found (j == 0) we:
//
//   (1) Write CMD (u8 @ bar1+0x37) = 0x10 (RST, bit 4). The bit is
//       self-clearing once the controller has completed its internal
//       reset. QEMU clears it in a single MMIO round-trip; the RTL8139
//       ProgrammersGuide notes real silicon completes in "a few
//       microseconds". We poll for at most 1000 iterations (~30 us on
//       a 3 GHz core with the mfence-bracketed MMIO read cost) which
//       is ~1000x margin; if it never clears we still fall through --
//       the count fingerprint witnesses the discovery, and any
//       downstream MMIO to a wedged controller lands on its own
//       failure path rather than a hang here.
//
//   (2) Write Config1 (u8 @ bar1+0x52) = 0x00. Powers the controller
//       out of any sleep / LWAKE state and enables the primary DAC
//       reference. Safe to write unconditionally on QEMU.
//
// The subsequent RX and TX bring-up is NOT done here; it lands in
// rx.pdx (rtl8139_rx_init) and is invoked from the future
// nic_dispatch attach path once the R91.M4 dispatch cmp-chain arm is
// wired (issue directive: do NOT touch nic_dispatch.pdx here).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.24.x)
// -----------------------------------------------------------------------------
//
//   G1: sized MMIO stores go through mov_b / mov_w / mov_d; a bare
//       `mov [addr], reg` would widen to REX.W and clobber neighbouring
//       registers.
//   G4: full-register compares; no `add reg, [mem]`.
//   No mov_bzx / mov_wzx: byte / word loads use the
//       `xor rax,rax; mov_b/w rax, [mem]` dst-zero form (matches
//       drivers/virtio_net/mac.pdx L200 pattern).
//
// Reserved-label discipline: labels prefixed `rtl_pb_` to avoid the
// paideia-as reserved names (`loop`, `if`, `next`, ...).

module Probe = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let RTL8139_VENDOR_REALTEK : u64 = 0x10EC
  pub let RTL8139_DEVICE_ID      : u64 = 0x8139

  pub let RTL8139_MAX_DEVS       : u64 = 2
  pub let RTL8139_DEV_REC_SIZE   : u64 = 32

  // ---- MMIO register offsets consumed here ----
  pub let RTL8139_REG_CMD        : u64 = 0x37    // u8  command
  pub let RTL8139_REG_CONFIG1    : u64 = 0x52    // u8  config-1 (power)

  // ---- CMD bits ----
  pub let RTL8139_CMD_RST        : u64 = 0x10    // bit 4 -- software reset

  pub let RTL8139_RESET_SPIN_MAX : u64 = 1000

  // ============================================================================
  // Fingerprint tag (ONE-line pdx string literal, PDX_STR-gate friendly).
  //
  // "rtl8139 probe ok [legacy: RTL8139 PROBE OK]"
  //   43 printable chars + 1 NUL terminator = 44 bytes.
  // OK_TOK regex (tools/verify-fingerprint-coverage.sh L880) matches on the
  // word-boundary uppercase OK in the bracketed legacy shard. The literal
  // needs an ALLOWLIST entry alongside the sibling virtio_net_* / e1000e_*
  // probe-ok entries until R91.M5 boot_r91_nic_probe smoke (#2031) pins
  // it under a PAIDEIA_NIC=rtl8139 boot mode.
  // ============================================================================

  pub let rtl8139_probe_ok_msg : [u8; 44] = "rtl8139 probe ok [legacy: RTL8139 PROBE OK]\0"

  // ============================================================================
  // Canonical static slots -- .bss, @align(8)
  //
  //   _rtl8139_devices         : 2 x 32 B = 64 B = 8 x u64
  //   _rtl8139_device_count    : populated by rtl8139_probe
  // ============================================================================

  pub let mut _rtl8139_devices      : [u64; 8] = uninit @align(8)
  pub let mut _rtl8139_device_count : u64      = 0

  // ============================================================================
  // rtl8139_probe() -> u64
  // ============================================================================
  //
  // SysV: () -> u64
  //   Returns rax = number of RTL8139 NICs discovered (0..2).
  //
  // Register plan (mirrors e1000e_probe / virtio_net_probe):
  //   rbx = i (loop index into _pci_devices)
  //   r12 = _pci_device_count (loaded once)
  //   r13 = j (rtl8139 write index into _rtl8139_devices)
  //   r14 = &_pci_devices[i] (recomputed each iter)
  //   r15 = &_rtl8139_devices[j] (recomputed on match)
  //
  //   Scratch slots (per candidate device):
  //     [rsp+0]  = seg  (u64, zero-extended)
  //     [rsp+8]  = bus  (u64)
  //     [rsp+16] = dev  (u64)
  //     [rsp+24] = fn   (u64)
  //     [rsp+32] = bar1_pa staging (u64)
  //     [rsp+40] = bar0_io staging (u64)
  //
  //   6 pushes = 48 B; entry rsp%16==8 -> 56; sub rsp,56 (48 scratch +
  //   8 align) -> 112, %16==0 (aligned for every nested pci_config_read_u32
  //   call without extra pre-call pad). Matches the shape of e1000e_probe
  //   (drivers/e1000e/probe.pdx L229).

  pub let rtl8139_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R91.M4-001 (paideia-os #2025). Realtek RTL8139 NIC device probe. Structurally identical to e1000e_probe (drivers/e1000e/probe.pdx L217) with the vendor/device match retargeted to (0x10EC, 0x8139) and the BAR strategy tightened to BAR1 (MMIO) as the primary carrier (BAR0 is I/O ports; recorded but unused at MVP because paideia-as has no in/out primitive family). Body: (1) 6-push callee-save prologue (rbx, rbp, r12-r15) -- 48 B; entry rsp%16==8 -> 56; sub rsp,56 (48 scratch + 8 align) -> 112, %16==0. Scratch layout [rsp+0..24] for seg/bus/dev/fn; [rsp+32] for bar1_pa staging; [rsp+40] for bar0_io staging. (2) Init j=r13=0; load _pci_device_count into r12; init i=rbx=0. (3) Per-iteration bounds check: cmp rbx, r12; jae done. (4) r14 = _pci_devices + (i << 5) -- record stride 32 = shl 5. (5) Load vendor_id (u16 @ r14+8); if != 0x10EC -> skip. (6) Load device_id (u16 @ r14+10); if != 0x8139 -> skip. (7) Overflow guard: if r13 >= RTL8139_MAX_DEVS (=2), skip (silent drop -- observable via fingerprint count). (8) Stash BDF (seg u16 @+0, bus/dev/fn u8s @+2/+3/+4) into scratch slots [rsp+0..24]. (9) Read BAR0 lo via pci_config_read_u32(seg, bus, dev, fn, 0x10). Bit 0 tells I/O (1) vs MEM (0); bits [2:1]==0 is 32-bit MEM. rtl8139's BAR0 is the I/O window (bit 0 == 1 expected) -- mask ~0x3 into bar0_io. Stash into [rsp+40]. (10) Read BAR1 lo via pci_config_read_u32(..., 0x14). Bit 0 == 0 expected (32-bit MEM). If bit 0 == 1 (unexpected: I/O in BAR1) -> skip. Mask ~0xF into bar1_pa. Stash into [rsp+32]. (11) Compute r15 = _rtl8139_devices + (j << 5). Populate the 32-byte record: u16 seg @+0, u8 bus/dev/fn @+2/+3/+4, u8 pad0=0 @+5, u16 pad1=0 @+6, u64 bar1_pa @+8, u64 bar0_io @+16, u64 mac=0 @+24 (populated later by rtl8139_read_mac in mac.pdx). (12) j += 1; advance i; loop. (13) On loop exit: publish _rtl8139_device_count = r13. (14) First-device reset+power-on: if r13 > 0, load bar1 from _rtl8139_devices[0]+8 into rbx. (a) Write CMD u8 @ bar1+0x37 = 0x10 (RST bit). (b) Poll CMD u8 @ bar1+0x37 for bit 4 clear, up to 1000 iterations; each iteration is mfence + xor rax,rax + mov_b rax,[bar1+0x37] + mfence + and rax,0x10 + cmp+je. On timeout we fall through (the count fingerprint still witnesses discovery; downstream MMIO to a wedged controller lands on its own failure path). (c) Write Config1 u8 @ bar1+0x52 = 0 (power on / clear sleep). (15) Emit klog_s1_d1(INFO, NET_, rtl8139_probe_ok_msg, k_n, count). (16) Return r13 in rax. Reserved-label posture: labels prefixed `rtl_pb_`. Every nested callee (pci_config_read_u32, klog_s1_d1) preserves rbx/rbp/r12-r15 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;                             // 48 scratch + 8 align

        // Init counters.
        xor r13, r13;                            // j = 0
        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;                            // i = 0

      rtl_pb_loop:
        cmp rbx, r12;
        jae rtl_pb_done;

        // r14 = &_pci_devices[i]
        mov rax, rbx;
        shl rax, 5;
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // vendor_id (u16 @+8)
        xor rax, rax;
        mov_w rax, [r14 + 8];
        cmp rax, 0x10EC;                         // RTL8139_VENDOR_REALTEK
        jne rtl_pb_next;

        // device_id (u16 @+10)
        xor rax, rax;
        mov_w rax, [r14 + 10];
        cmp rax, 0x8139;                         // RTL8139_DEVICE_ID
        jne rtl_pb_next;

        // Overflow guard.
        cmp r13, 2;                              // RTL8139_MAX_DEVS
        jae rtl_pb_next;

        // Stash BDF into scratch.
        // seg (u16 @+0)
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;

        // bus (u8 @+2)
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;

        // dev (u8 @+3)
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;

        // fn (u8 @+4)
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;

        // ============================================================
        // Read BAR0 (config +0x10) -- I/O port window on this NIC.
        // ============================================================
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x10;
        call pci_config_read_u32;

        // rax = bar0_raw. bar0_io = raw & ~0x3 (mask I/O type bits).
        // Do not gate on bit 0 -- record the address either way; the
        // I/O-mode fallback path is out of scope at MVP.
        mov r10, rax;
        and r10, 0xFFFFFFFFFFFFFFFC;             // ~0x3
        mov [rsp + 40], r10;

        // ============================================================
        // Read BAR1 (config +0x14) -- 32-bit MMIO window (primary).
        // ============================================================
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x14;
        call pci_config_read_u32;

        // rax = bar1_raw. Verify MEM BAR (bit 0 == 0); else skip.
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne rtl_pb_next;                         // I/O in BAR1 not supported

        // bar1_pa = raw & ~0xF (mask MEM type bits + prefetch bit).
        and rax, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 32], rax;

        // ============================================================
        // Populate _rtl8139_devices[j] at r15.
        // ============================================================
        mov r11, r13;
        shl r11, 5;                              // j * 32
        lea r15, [rip + _rtl8139_devices];
        add r15, r11;

        // u16 seg @+0
        mov r10, [rsp + 0];
        mov_w [r15 + 0], r10;

        // u8 bus @+2
        mov r10, [rsp + 8];
        mov_b [r15 + 2], r10;

        // u8 dev @+3
        mov r10, [rsp + 16];
        mov_b [r15 + 3], r10;

        // u8 fn @+4
        mov r10, [rsp + 24];
        mov_b [r15 + 4], r10;

        // u8 pad0 = 0 @+5
        xor r10, r10;
        mov_b [r15 + 5], r10;

        // u16 pad1 = 0 @+6
        mov_w [r15 + 6], r10;

        // u64 bar1_pa @+8
        mov r10, [rsp + 32];
        mov [r15 + 8], r10;

        // u64 bar0_io @+16
        mov r10, [rsp + 40];
        mov [r15 + 16], r10;

        // u64 mac = 0 @+24 (populated later by rtl8139_read_mac)
        xor r10, r10;
        mov [r15 + 24], r10;

        // j += 1
        add r13, 1;

      rtl_pb_next:
        add rbx, 1;
        jmp rtl_pb_loop;

      rtl_pb_done:
        // Publish device count.
        mov [rip + _rtl8139_device_count], r13;

        // ================================================================
        // First-device reset + power-on. If no device found, skip.
        // Uses rbx as the bar1 carrier throughout; rbp as a scratch
        // spin counter (both were the loop cursors and are free now).
        // ================================================================
        cmp r13, 0;
        je rtl_pb_emit_fp;

        lea r15, [rip + _rtl8139_devices];
        mov rbx, [r15 + 8];                      // rbx = bar1_pa (u64 @+8)

        // (a) Assert CMD.RST (bit 4). CMD is u8 @ bar1+0x37.
        mov r10, rbx;
        add r10, 0x37;                           // CMD offset
        mov rax, 0x10;                           // CMD_RST
        mov_b [r10], rax;

        // (b) Poll CMD.RST clear. Bounded 1000-iter spin.
        mov rbp, 1000;                           // RTL8139_RESET_SPIN_MAX

      rtl_pb_wait_rst:
        mov r10, rbx;
        add r10, 0x37;                           // CMD offset
        mfence;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        and rax, 0x10;                           // isolate RST bit
        cmp rax, 0;
        je rtl_pb_powerup;                       // RST cleared -> done

        sub rbp, 1;
        cmp rbp, 0;
        jne rtl_pb_wait_rst;
        // Timeout: fall through. Downstream MMIO to a wedged controller
        // will land on its own failure path; count fingerprint still
        // witnesses discovery.

      rtl_pb_powerup:
        // (c) Write Config1 = 0 (power on, clear sleep state).
        // Config1 is u8 @ bar1+0x52.
        mov r10, rbx;
        add r10, 0x52;
        xor rax, rax;
        mov_b [r10], rax;

      rtl_pb_emit_fp:
        // Device-count fingerprint ("rtl8139 probe ok [...] n=<count>").
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_NET_];
        lea rdx, [rip + rtl8139_probe_ok_msg];
        lea rcx, [rip + k_n];
        mov r8, r13;                             // v1 = count
        call klog_s1_d1;

        mov rax, r13;                            // return count

        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
