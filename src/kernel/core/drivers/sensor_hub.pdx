// src/kernel/core/drivers/sensor_hub.pdx — R32.M5-002 (#1134)
//
// The kernel's SENSOR HUB scaffold. Three mounts (ALS, ACCEL, GYRO)
// that publish one sample each through hid_event_stream_publish with
// the HID_EVT_SENSOR bit and an opaque payload, and a honest
// DEFERRED_HARDWARE sentinel — but no I²C transfer lands in this
// tree.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE T14 G4 SENSOR HUB'S KERNEL-SIDE HALF, IN SCAFFOLD FORM.
// The T14 G4 aggregates ambient light, accelerometer and gyroscope
// readings behind a single Intel Sensor Hub speaking I²C-HID on
// LPSS I²C. When the KIND_I2C_SLAVE + KIND_HID_DEVICE bindings for
// the hub land, the sample paths read one report each and publish it
// through hid_event_stream_publish with the HID_EVT_SENSOR bit.
// Today they publish a SYNTHETIC sample carrying the ordinal
// discriminant in the low byte -- enough to exercise the
// hid_event_stream_publish -> KIND_HID_EVENT subscriber fanout and
// the sensor_hub_arbitrated() honesty pin.
//
// IT IS NOT A LIVE DRIVER. Same discipline as backlight_pwm.pdx §0:
// the sample path is stated as a SCAFFOLD, and the pin
// `sensor_hub_arbitrated() == 0` -- an assertion the boot witness
// will one day break when a real I²C-HID capability plumbs through
// -- forces the design doc to be updated at that time. See §4 for
// the deferrals.
//
// IT DOES NOT MINT CAPABILITIES. Sensor-hub-facing capabilities
// arrive through the ordinary paths (KIND_I2C_SLAVE from the LPSS
// bus, KIND_HID_DEVICE from the class driver, KIND_SENSOR_CHANNEL
// from the subscriber side); this module does not touch any of those
// row tables and does not derive any capability from anything.
//
// =============================================================================
// §1  THREE MOUNTS, ONE FANOUT
// =============================================================================
//
// The three mounts (ALS, ACCEL, GYRO) share ONE fanout path
// (hid_event_stream_publish) and ONE class bit (HID_EVT_SENSOR).
// That decision is deliberate. The four HID event class bits are
// coarse-grained (kind_hid_event.pdx §4) and there is no bit per
// sensor type: a subscriber that wants ALS specifically holds a
// KIND_SENSOR_CHANNEL row whose sensor_type is ALS and whose
// endpoint carries a KIND_HID_EVENT subscription on the SENSOR
// class bit. The FANOUT tells "which endpoint this reaches"; the
// SENSOR_CHANNEL row tells "which sensor type this endpoint asked
// for". Splitting the two lets a subscriber ask for one sensor
// without silently receiving another.
//
// The payload is opaque to the stream (event_stream.pdx §0). This
// module packs the sensor type ordinal in the low byte plus a
// discriminant-and-sample fingerprint for the witness; a real
// milestone will replace the payload with an ID-and-sample word
// that the sensor_read_channel schema (#1135) unpacks.
//
// =============================================================================
// §2  ONE WRITER OF THE BIND FLAG
// =============================================================================
//
// Same discipline as backlight_pwm_bind: sensor_hub_bind is the ONE
// writer of `_sensor_hub_bound`. A second writer would be a second
// path claiming this driver is initialised without any capability
// check, and when the I²C-HID capability wires up (§4) the bind
// decision becomes load-bearing.
//
// tools/build.sh confines relocations against `_sensor_hub_bound`
// and `_sensor_hub_stats` to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// A sample path called with an out-of-range sensor type is
// BAD_TYPE; a path called before bind is NOT_BOUND. A publish that
// hid_event_stream_publish refuses is propagated as-is (its own
// error band 0xFFFFFEB0..BF); a supplementary sensor-hub counter
// records that the publish attempt happened, so a diagnostic can
// tell "the driver tried to publish but the stream refused" from
// "the driver never tried".
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO I²C TRANSFER runs from this module. The three sample paths
//     that would issue a HID GET_REPORT against the sensor hub are
//     absent, because no KIND_I2C_SLAVE + KIND_HID_DEVICE pair in
//     this tree names the sensor hub. A gated:hardware milestone
//     plumbs those (arity moves to two per mount at that point).
//
//   * NO ARBITRATION against SMM or the platform's own sensor
//     firmware. sensor_hub_arbitrated returns 0; the boot witness
//     pins it. When arbitration wires up, the pin fails and the
//     statement above is rewritten in the same commit -- same
//     device backlight_pwm uses.
//
//   * NO PER-RATE SCHEDULING. A real hub reads at its own rate and
//     the driver downsamples per KIND_SENSOR_CHANNEL subscription's
//     rate_hz; today the sample paths publish once each per witness
//     call, and no timer is armed.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFED0..0xFFFFFEDF
//
// Sixteen-wide, disjoint from every other in-tree band. hid_event_
// stream_channel occupies 0xFFFFFEC0..CF and hid_event_stream itself
// 0xFFFFFEB0..BF.
// =============================================================================

module SensorHub = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let SENSOR_HUB_OK                : u64 = 0
  pub let SENSOR_HUB_NOT_BOUND         : u64 = 0xFFFFFEDF
  pub let SENSOR_HUB_BAD_TYPE          : u64 = 0xFFFFFEDE
  pub let SENSOR_HUB_DEFERRED_HARDWARE : u64 = 0xFFFFFEDD

  // ==========================================================================
  // State.
  //
  //   _sensor_hub_bound : 0 (unbound) or 1 (bound).
  //   _sensor_hub_stats : counters:
  //     +0  binds       binds accepted
  //     +8  als_samples samples published on the ALS mount
  //     +16 acc_samples samples published on the ACCEL mount
  //     +24 gyr_samples samples published on the GYRO mount
  //     +32 bad_type    refusals: type not in {ALS, ACCEL, GYRO}
  //     +40 not_bound   refusals: sample before bind
  //     +48 fanout_bad  publish refusals propagated from the stream
  // ==========================================================================

  pub let mut _sensor_hub_bound : u64 = 0
  pub let mut _sensor_hub_stats : [u64; 8] = uninit @align(64)

  pub let SENSOR_HUB_ST_BINDS       : u64 = 0
  pub let SENSOR_HUB_ST_ALS_SAMPLES : u64 = 1
  pub let SENSOR_HUB_ST_ACC_SAMPLES : u64 = 2
  pub let SENSOR_HUB_ST_GYR_SAMPLES : u64 = 3
  pub let SENSOR_HUB_ST_BAD_TYPE    : u64 = 4
  pub let SENSOR_HUB_ST_NOT_BOUND   : u64 = 5
  pub let SENSOR_HUB_ST_FANOUT_BAD  : u64 = 6
  pub let SENSOR_HUB_ST_MAX         : u64 = 8

  // ==========================================================================
  // sensor_hub_reset() -> ()
  // ==========================================================================

  pub let sensor_hub_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-002 (#1134): clear the bind flag and every counter. Boot and teardown only. Bounded by an immediate compare (8 iterations). Leaf. Labels prefixed shub_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _sensor_hub_bound];
        xor rax, rax;
        mov [r10], rax;
        lea r10, [rip + _sensor_hub_stats];
        xor rcx, rcx;
      shub_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  shub_rs_loop;
        ret
      }
    }

  // ==========================================================================
  // sensor_hub_bind() -> SENSOR_HUB_OK
  //
  // ARITY ZERO. A real bind takes a KIND_I2C_SLAVE + KIND_HID_DEVICE
  // pair; the seam is left empty so a caller cannot pretend
  // capabilities are there. When the gated:hardware milestone lands,
  // the seam becomes arity TWO and the confinement pin in
  // tools/build.sh moves with it in the same commit.
  // ==========================================================================

  pub let sensor_hub_bind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-002 (#1134): mark the sensor-hub scaffold bound. ARITY ZERO deliberately -- see §2 and the module header. Increments _sensor_hub_stats[0]. Leaf. Labels prefixed shub_bd_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _sensor_hub_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _sensor_hub_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // SENSOR_HUB_OK
        ret
      }
    }

  // ==========================================================================
  // sensor_hub_bound() -> 1 | 0
  // ==========================================================================

  pub let sensor_hub_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-002 (#1134): 1 once sensor_hub_bind has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _sensor_hub_bound];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // sensor_hub_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device backlight_pwm_arbitrated /
  // ec_access_arbitrated use.
  // ==========================================================================

  pub let sensor_hub_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-002 (#1134): report whether reads through this hub are arbitrated against SMM and the platform's own sensor firmware. IT RETURNS 0, because nothing in this tree coordinates the I²C-HID hub with a firmware-owned or graphics-owned actor. The boot witness pins the result at 0 for the same reason backlight_pwm_arbitrated is pinned: a claim in a comment rots silently, a value a test asserts on does not, and the milestone that closes the coordination gap cannot land without rewriting the statement that says it has not been closed. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // sensor_hub_pack_payload(type, sample) -> word
  //
  // Local payload shape. [63:56] = type ordinal (ALS/ACCEL/GYRO in
  // 1..3), [15:0] = sample discriminant (witness-supplied), rest
  // reserved zero. The real payload shape lives with
  // sensor_read_channel schema (#1135); this is enough to exercise
  // the fanout.
  // ==========================================================================

  pub let sensor_hub_pack_payload : (u64, u64) -> u64 !{} @{} =
    fn (t: u64) (sample: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R32.M5-002 (#1134): pack a synthetic sensor payload. rax = (type << 56) | (sample & 0xFFFF). Neither the stream nor the KIND_HID_EVENT fanout looks at the payload; this shape is enough to identify the mount that produced it during witnessing. Pure leaf. Labels prefixed shub_pp_.",
      block: {
        mov rax, rsi;
        mov r10, 0xFFFF;
        and rax, r10;
        mov r10, rdi;
        shl r10, 56;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // sensor_hub_sample_common(type, sample, stat_idx) -> code
  //
  // Internal helper shared by the three mount paths. Gates, packs,
  // and publishes through hid_event_stream_publish. Returns the
  // fanout's match count on success, propagates fanout errors, or
  // returns NOT_BOUND / BAD_TYPE.
  // ==========================================================================

  pub let sensor_hub_sample_common : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (t: u64, sample: u64, stat_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-002 (#1134): shared sample path. Gates: (1) bound? else NOT_BOUND. (2) type in {ALS, ACCEL, GYRO}, else BAD_TYPE. (3) pack payload with sensor_hub_pack_payload. (4) hid_event_stream_publish(HID_EVT_SENSOR, payload); on any refused publish (any answer >= 0xFFFFFE00), bump ST_FANOUT_BAD and propagate. On success, bump the mount-specific stats counter (stat_idx). Returns the fanout match count on the happy path (0 if no subscriber matched -- not an error). Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed shub_sc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // type
        mov r13, rsi;                    // sample
        mov r14, rdx;                    // stat_idx

        // (1) bound?
        lea r10, [rip + _sensor_hub_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  shub_sc_not_bound;

        // (2) type in [1,3].
        cmp r12, 1;
        jb  shub_sc_bad_type;
        cmp r12, 3;
        ja  shub_sc_bad_type;

        // (3) pack payload.
        mov rdi, r12;
        mov rsi, r13;
        call sensor_hub_pack_payload;
        mov rbx, rax;                    // payload

        // (4) publish on HID_EVT_SENSOR (0x08).
        mov rdi, 0x08;                   // HID_EVT_SENSOR
        mov rsi, rbx;
        call hid_event_stream_publish;

        // Refusal? Fanout error band is 0xFFFFFE00..0xFFFFFEFF; treat
        // any value >= 0xFFFFFE00 as an error (match counts are < 16
        // by SENSOR_MAX).
        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae shub_sc_fanout_bad;

        // Success -- bump mount stat.
        lea r10, [rip + _sensor_hub_stats];
        mov r11, [r10 + r14 * 8];
        add r11, 1;
        mov [r10 + r14 * 8], r11;

        jmp shub_sc_out;                 // rax = match count from publish

      shub_sc_bad_type:
        lea r10, [rip + _sensor_hub_stats];
        mov rax, [r10 + 32];             // bad_type
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFEDE;             // SENSOR_HUB_BAD_TYPE
        jmp shub_sc_out;

      shub_sc_not_bound:
        lea r10, [rip + _sensor_hub_stats];
        mov rax, [r10 + 40];             // not_bound
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFEDF;             // SENSOR_HUB_NOT_BOUND
        jmp shub_sc_out;

      shub_sc_fanout_bad:
        // rax already holds the fanout error; preserve it, but count.
        mov rbx, rax;                    // save fanout code
        lea r10, [rip + _sensor_hub_stats];
        mov rax, [r10 + 48];             // fanout_bad
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, rbx;

      shub_sc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // sensor_hub_sample_als(lux)   -> code
  // sensor_hub_sample_accel(v)   -> code
  // sensor_hub_sample_gyro(v)    -> code
  //
  // Three arity-ONE mount seams. A second parameter would let a caller
  // choose which sensor type this call publishes for -- and one call
  // publishing under two names would let a subscriber count against a
  // rate budget for a class it never asked about.
  // ==========================================================================

  pub let sensor_hub_sample_als : (u64) -> u64 !{mem} @{cap} =
    fn (lux: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-002 (#1134): publish one ALS sample. ARITY ONE, pinned by tools/build.sh. Delegates to sensor_hub_sample_common with type = SENSOR_TYPE_ALS (1) and stat_idx = ST_ALS_SAMPLES (1). Two pushes leave rsp%16 == 0 at the nested call. Labels prefixed shub_sa_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov rdi, 1;                      // SENSOR_TYPE_ALS
        mov rsi, r12;
        mov rdx, 1;                      // ST_ALS_SAMPLES
        call sensor_hub_sample_common;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let sensor_hub_sample_accel : (u64) -> u64 !{mem} @{cap} =
    fn (v: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-002 (#1134): publish one ACCEL sample. ARITY ONE, pinned. Delegates with type = SENSOR_TYPE_ACCEL (2) and stat_idx = ST_ACC_SAMPLES (2). Labels prefixed shub_sac_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov rdi, 2;                      // SENSOR_TYPE_ACCEL
        mov rsi, r12;
        mov rdx, 2;                      // ST_ACC_SAMPLES
        call sensor_hub_sample_common;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let sensor_hub_sample_gyro : (u64) -> u64 !{mem} @{cap} =
    fn (v: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R32.M5-002 (#1134): publish one GYRO sample. ARITY ONE, pinned. Delegates with type = SENSOR_TYPE_GYRO (3) and stat_idx = ST_GYR_SAMPLES (3). Labels prefixed shub_sg_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov rdi, 3;                      // SENSOR_TYPE_GYRO
        mov rsi, r12;
        mov rdx, 3;                      // ST_GYR_SAMPLES
        call sensor_hub_sample_common;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sensor_hub_stat(which) -> count
  // ==========================================================================

  pub let sensor_hub_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R32.M5-002 (#1134): bounds-checked read of one counter; out-of-range returns 0. Leaf. Labels prefixed shub_st_.",
      block: {
        cmp rdi, 8;                      // SENSOR_HUB_ST_MAX
        jae shub_st_zero;
        lea r10, [rip + _sensor_hub_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      shub_st_zero:
        xor rax, rax;
        ret
      }
    }
}
