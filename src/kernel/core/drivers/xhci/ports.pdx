// src/kernel/core/drivers/xhci/ports.pdx — R26-M3-001..002 (#951, #952)
//
// xHCI Root-Hub Port Register set — PORTSC accessors + reset-with-
// settle-poll primitive. The port register set is the first per-device
// touchpoint of the driver: PORTSC.CCS surfaces "device connected on
// this port", PORTSC.PR drives the reset that puts the device into
// the Default state, and PORTSC.PortSpeed captures the negotiated
// link speed that seeds the Slot Context (see context.pdx).
//
// -----------------------------------------------------------------------------
// Port register layout (xHCI 1.2 §5.4.8, per-port 16 B block)
// -----------------------------------------------------------------------------
//
// The first port register block starts at op_base + 0x400 (op_base =
// BAR0 + CAPLENGTH). Each port occupies 16 bytes (four u32 registers):
//
//   +0  PORTSC    Port Status and Control
//   +4  PORTPMSC  Power Management Status and Control
//   +8  PORTLI    Port Link Info
//   +C  PORTHLPMC Hardware LPM Control
//
// Port N (1-based per xHCI spec convention) lives at
//   op_base + 0x400 + (N - 1) * 0x10
//
// -----------------------------------------------------------------------------
// PORTSC bit-field map (xHCI 1.2 Table 5-27)
// -----------------------------------------------------------------------------
//
//   bit  0   CCS   Current Connect Status              (ROS — read-only status)
//   bit  1   PED   Port Enabled/Disabled               (RW1C — spec quirk;
//                                                        writing 1 disables
//                                                        the port. Treat as
//                                                        RW1C-preserve here.)
//   bit  3   OCA   Over-current Active                 (ROS)
//   bit  4   PR    Port Reset                          (RW)
//   bits 5..8 PLS  Port Link State                     (RW / RWS)
//   bit  9   PP    Port Power                          (RW)
//   bits 10..13 PortSpeed                              (ROS after reset)
//                    1 = Full-speed  (12  Mbps)
//                    2 = Low-speed   (1.5 Mbps)
//                    3 = High-speed  (480 Mbps)
//                    4 = SuperSpeed  (5   Gbps)
//   bits 14..15 PIC Port Indicator Control             (RW)
//   bit 16   LWS   Port Link State Write Strobe        (RW)
//   bit 17   CSC   Connect Status Change               (RW1C)
//   bit 18   PEC   Port Enabled/Disabled Change        (RW1C)
//   bit 19   WRC   Warm Port Reset Change              (RW1C, SS only)
//   bit 20   OCC   Over-current Change                 (RW1C)
//   bit 21   PRC   Port Reset Change                   (RW1C)
//   bit 22   PLC   Port Link State Change              (RW1C)
//   bit 23   CEC   Port Config Error Change            (RW1C)
//   bit 24   CAS   Cold Attach Status                  (ROS)
//   bit 25   WCE   Wake on Connect Enable              (RW)
//   bit 26   WDE   Wake on Disconnect Enable           (RW)
//   bit 27   WOE   Wake on Over-current Enable         (RW)
//   bit 30   DR    Device Removable                    (RO)
//   bit 31   WPR   Warm Port Reset                     (RW1S / SS only)
//
// -----------------------------------------------------------------------------
// RW1C-preserving write discipline
// -----------------------------------------------------------------------------
//
// PORTSC bits [17:23] are RW1C — writing 1 to any of these bits clears
// the corresponding change latch, writing 0 is a no-op. If the driver
// wants to modify a RW state bit (PR, PP, WCE, ...) without disturbing
// pending change latches (CSC, PEC, PRC, ...), it must mask those bits
// off in the value being written. This is precisely the Linux
// xhci_port_state_to_neutral() posture (drivers/usb/host/xhci.h).
//
// `xhci_port_write` applies that mask internally so the ordinary
// caller-path "set PP" / "set PR" reads-modify-writes safely. Explicit
// change-latch clears (used in xhci_port_reset to acknowledge PRC)
// route through xhci_op_write_u32 directly, bypassing the mask.
//
// PORTSC RW1C mask = bits 17..23 = 0x00FE0000. Value written is
// `caller_value & ~0x00FE0000 = caller_value & 0xFF01FFFF`.
//
// -----------------------------------------------------------------------------
// Port-reset settle discipline (§4.19.5 + §5.4.8)
// -----------------------------------------------------------------------------
//
// After PR is set, the HC drives the USB reset on the physical wire and
// signals completion by asserting PRC (bit 21). Software MUST wait for
// PRC before reading PortSpeed (which is only valid post-reset), and
// MUST then acknowledge PRC via a RW1C write.
//
// Reset timeout budget: the xhci spec doesn't mandate a strict limit but
// 500 ms is the de-facto Linux ceiling (see USB_RESUME_TIMEOUT in
// include/linux/usb.h). We reuse XHCI_RESET_SPIN_MAX = 5_000_000
// polling iterations from reset.pdx — same units, same ~150 ms
// realistic runtime, same "hung reset produces a boot-time fault
// witness rather than a UX-visible stall" trade-off.
//
// -----------------------------------------------------------------------------
// R26.M3 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` boot the PCI enumerator returns 0 devices, so
// xhci_probe leaves the device table empty and no port register access
// ever fires. Symbols exist for the R26.M3+ driver-attach path and
// the UEFI/OVMF activation.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: u32 MMIO writes route through xhci_op_write_u32 (mov_d internally).
//   G4: full-register compares.
//
// Reserved-label discipline: `xhci_pt_` prefix.

module Ports = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let XHCI_PORT_REGS_BASE       : u64 = 0x400          // from op_base
  pub let XHCI_PORT_STRIDE          : u64 = 0x10           // 4 * u32 per port
  pub let XHCI_PORTSC_OFF           : u64 = 0x00           // PORTSC within port

  // PORTSC bit masks.
  pub let XHCI_PORTSC_CCS           : u64 = 0x00000001     // bit  0
  pub let XHCI_PORTSC_PED           : u64 = 0x00000002     // bit  1
  pub let XHCI_PORTSC_OCA           : u64 = 0x00000008     // bit  3
  pub let XHCI_PORTSC_PR            : u64 = 0x00000010     // bit  4
  pub let XHCI_PORTSC_PP            : u64 = 0x00000200     // bit  9
  pub let XHCI_PORTSC_CSC           : u64 = 0x00020000     // bit 17 (RW1C)
  pub let XHCI_PORTSC_PEC           : u64 = 0x00040000     // bit 18 (RW1C)
  pub let XHCI_PORTSC_WRC           : u64 = 0x00080000     // bit 19 (RW1C)
  pub let XHCI_PORTSC_OCC           : u64 = 0x00100000     // bit 20 (RW1C)
  pub let XHCI_PORTSC_PRC           : u64 = 0x00200000     // bit 21 (RW1C)
  pub let XHCI_PORTSC_PLC           : u64 = 0x00400000     // bit 22 (RW1C)
  pub let XHCI_PORTSC_CEC           : u64 = 0x00800000     // bit 23 (RW1C)

  // RW1C mask covering bits 17..23. Value written by xhci_port_write
  // is `value & ~RW1C_MASK` so change latches are preserved (writing 0
  // to a RW1C bit is a no-op).
  pub let XHCI_PORTSC_RW1C_MASK     : u64 = 0x00FE0000
  pub let XHCI_PORTSC_RW1C_KEEP     : u64 = 0xFF01FFFF     // ~RW1C_MASK & 0xFFFFFFFF

  // PortSpeed extraction (bits 10..13).
  pub let XHCI_PORTSC_SPEED_SHIFT   : u64 = 10
  pub let XHCI_PORTSC_SPEED_MASK    : u64 = 0xF

  // PortSpeed named constants (xHCI 1.2 Table 5-27).
  pub let XHCI_PORT_SPEED_FULL      : u64 = 1
  pub let XHCI_PORT_SPEED_LOW       : u64 = 2
  pub let XHCI_PORT_SPEED_HIGH      : u64 = 3
  pub let XHCI_PORT_SPEED_SUPER     : u64 = 4

  // HCSPARAMS1.MaxPorts field (bits 24..31).
  pub let XHCI_HCS1_MAXPORTS_SHIFT_C  : u64 = 24
  pub let XHCI_HCS1_MAXPORTS_MASK_C   : u64 = 0xFF

  // Reset settle-poll budget — same units as xhci_reset (~150 ms actual
  // wall-clock under a healthy controller).
  pub let XHCI_PORT_RESET_SPIN_MAX  : u64 = 5000000

  // ============================================================================
  // xhci_port_count(bar0) -> u32
  // ============================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base
  //
  // Returns rax = HCSPARAMS1.MaxPorts (bits 24..31 of the capability
  // register), zero-extended to u64. QEMU q35 xhci reports 4; T14 G4
  // typically reports 12 (4 USB3 + 8 USB2 across two intel host
  // controllers).
  //
  // Body:
  //   (1) sub rsp, 8 for alignment (no callee-save needed — one nested
  //       call to xhci_cap_u32 and immediate return).
  //   (2) rsi = XHCI_CAP_HCSPARAMS1 offset (0x04); rdi already holds
  //       bar0.
  //   (3) call xhci_cap_u32 → rax = HCSPARAMS1.
  //   (4) shr rax, 24; and rax, 0xFF.
  //   (5) add rsp, 8; ret.

  pub let xhci_port_count : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-001 (#951). Read HCSPARAMS1.MaxPorts (bits 24..31). Body: (1) sub rsp,8 for align — entry rsp%16==8 -> 16 (%16==0) at call boundary. rdi already holds bar0 (SysV). (2) mov rsi, 4 (XHCI_CAP_HCSPARAMS1); call xhci_cap_u32 -> rax. (3) shr rax, 24 puts MaxPorts in low 8 bits with upper bits zero; and rax, 0xFF for explicit width. (4) add rsp,8; ret. No callee-save needed — no state survives the single nested call.",
      block: {
        sub rsp, 8;
        mov rsi, 4;                              // XHCI_CAP_HCSPARAMS1
        call xhci_cap_u32;
        shr rax, 24;
        and rax, 0xFF;
        add rsp, 8;
        ret
      }
    }

  // ============================================================================
  // xhci_port_read(bar0, port_1based) -> u32
  // ============================================================================
  //
  // SysV: (bar0: u64, port_1based: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = 1-based port number (spec convention)
  //
  // Returns rax = PORTSC value (u32, zero-extended).
  //
  // Body:
  //   (1) Compute op_base = bar0 + CAPLENGTH.
  //   (2) Compute portsc_offset = 0x400 + (port - 1) * 0x10.
  //   (3) xhci_op_u32(op_base, portsc_offset).
  //
  // Register plan (2-push callee-save):
  //   rbx = bar0        (survives xhci_cap_u8 call; overwritten to
  //                       op_base afterwards — original bar0 no longer
  //                       needed)
  //   rbp = port_1based (survives xhci_cap_u8 call; consumed to compute
  //                       portsc_offset)
  //
  //   2 pushes = 16 B (rsp%16 unchanged from entry 8) + sub rsp,8 for
  //   alignment. Total frame 24 B; entry %16==8 -> 32, %16==0 at every
  //   nested-call boundary.

  pub let xhci_port_read : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, port_1based: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-001 (#951). Read PORTSC for a 1-based port. Body: (1) 2-push callee-save (rbx=bar0->op_base, rbp=port_1based) + sub rsp,8 align — 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for nested xhci_cap_u8 + xhci_op_u32). (2) rbx=rdi, rbp=rsi. (3) op_base = bar0 + CAPLENGTH: mov rdi,rbx; xor rsi,rsi; call xhci_cap_u8 -> rax. add rbx, rax (rbx now holds op_base — original bar0 no longer needed). (4) portsc_offset = 0x400 + (port-1)*0x10: mov rax, rbp; sub rax, 1; shl rax, 4; add rax, 0x400. (5) call xhci_op_u32(op_base=rbx, off=rax) -> rax. (6) restore + ret.",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = port_1based

        // (1) op_base = bar0 + CAPLENGTH.
        mov rdi, rbx;
        xor rsi, rsi;                            // CAPLENGTH offset = 0
        call xhci_cap_u8;
        add rbx, rax;                            // rbx = op_base

        // (2) portsc_offset = 0x400 + (port - 1) * 0x10.
        mov rax, rbp;
        sub rax, 1;
        shl rax, 4;
        add rax, 1024;                           // 0x400

        // (3) PORTSC = xhci_op_u32(op_base, portsc_offset).
        mov rdi, rbx;
        mov rsi, rax;
        call xhci_op_u32;

        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xhci_port_write(bar0, port_1based, value) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64, port_1based: u64, value: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = 1-based port number
  //   rdx = PORTSC value to write (u32 semantics; masked)
  //
  // Body:
  //   (1) Compute op_base = bar0 + CAPLENGTH.
  //   (2) Compute portsc_offset.
  //   (3) Mask off RW1C bits: value_masked = value & 0xFF01FFFF.
  //       Writing 0 to a RW1C bit is a no-op — this preserves any
  //       pending change latches (CSC/PEC/WRC/OCC/PRC/PLC/CEC) that
  //       the caller hasn't explicitly asked to clear.
  //   (4) xhci_op_write_u32(op_base, portsc_offset, value_masked).
  //
  // Register plan (3-push callee-save):
  //   rbx = bar0 -> op_base
  //   rbp = port_1based
  //   r12 = value (survives xhci_cap_u8 call)
  //
  //   3 pushes = 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for all
  //   nested calls without extra pad).

  pub let xhci_port_write : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, port_1based: u64, value: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-001 (#951). RW1C-preserving PORTSC write. Body: (1) 3-push callee-save (rbx=bar0->op_base, rbp=port_1based, r12=value) — 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for nested xhci_cap_u8 + xhci_op_write_u32). (2) rbx=rdi, rbp=rsi, r12=rdx. (3) op_base = bar0 + CAPLENGTH via xhci_cap_u8(bar0, 0); add rbx, rax. (4) portsc_offset = 0x400 + (port-1)*0x10 via mov rax,rbp; sub rax,1; shl rax,4; add rax,0x400. (5) Mask off RW1C: and r12, 0xFF01FFFF — clears bits 17..23 in the value being written so change latches (CSC/PEC/WRC/OCC/PRC/PLC/CEC) are not inadvertently cleared. Writing 0 to a RW1C bit is a no-op per xHCI 1.2 §5.4.8 (Linux xhci_port_state_to_neutral posture). (6) xhci_op_write_u32(op_base=rbx, off=rax, val=r12).",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = port_1based
        mov r12, rdx;                            // r12 = value

        // (1) op_base = bar0 + CAPLENGTH.
        mov rdi, rbx;
        xor rsi, rsi;
        call xhci_cap_u8;
        add rbx, rax;                            // rbx = op_base

        // (2) portsc_offset.
        mov rax, rbp;
        sub rax, 1;
        shl rax, 4;
        add rax, 1024;                           // 0x400

        // (3) Mask RW1C bits (17..23) to zero — no-op write there.
        and r12, 0xFF01FFFF;

        // (4) MMIO write.
        mov rdi, rbx;
        mov rsi, rax;
        mov rdx, r12;
        call xhci_op_write_u32;

        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xhci_port_reset(bar0, port_1based) -> u32
  // ============================================================================
  //
  // SysV: (bar0: u64, port_1based: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = 1-based port number
  //
  // Returns rax = negotiated port speed (1..4) on success, 0 on any of:
  //   - no device connected (PORTSC.CCS = 0 on entry)
  //   - reset never completed within XHCI_PORT_RESET_SPIN_MAX iters
  //
  // Body:
  //   (1) op_base = bar0 + CAPLENGTH (r12).
  //   (2) portsc_off = 0x400 + (port - 1) * 0x10 (r13).
  //   (3) Read PORTSC. If CCS == 0, no device — return 0.
  //   (4) Prime PR-set value: RMW-preserve — neutral = PORTSC &
  //       0xFF01FFFF (mask RW1C latches); new = neutral | PR (0x10).
  //       Write directly via xhci_op_write_u32 (bypassing
  //       xhci_port_write's mask duplication — the value already has
  //       the mask applied).
  //   (5) Poll PORTSC.PRC (bit 21) until 1, budget r14 =
  //       XHCI_PORT_RESET_SPIN_MAX iterations.
  //   (6) On PRC set: extract PortSpeed (bits 10..13). Cache in r14
  //       (spin counter no longer needed).
  //   (7) Clear PRC by writing 1 to bit 21 (RW1C clear pattern):
  //       neutralize other RW1C latches (& 0xFF01FFFF), OR in PRC
  //       (0x200000), write directly.
  //   (8) Return speed in rax.
  //
  // Register plan (5-push callee-save):
  //   rbx = bar0
  //   rbp = port_1based
  //   r12 = op_base
  //   r13 = portsc_off (from op_base)
  //   r14 = spin counter / cached speed
  //
  //   5 pushes = 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for
  //   every nested call without extra pre-call pad).

  pub let xhci_port_reset : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, port_1based: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-002 (#952). Port reset with settle poll + speed capture per xHCI 1.2 §4.19.5 / §5.4.8. Body: (1) 5-push callee-save (rbx=bar0, rbp=port_1based, r12=op_base, r13=portsc_off, r14=spin/speed) — 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every nested xhci_cap_u8 / xhci_op_u32 / xhci_op_write_u32 call). (2) op_base = bar0 + CAPLENGTH via xhci_cap_u8(bar0, 0). Save r12. (3) portsc_off = 0x400 + (port-1)*0x10 (r13). (4) Read PORTSC via xhci_op_u32(r12, r13) -> rax. Check CCS bit 0: mov r14,rax; and r14,1; cmp r14,0; je no_device -> return 0. (5) RMW-preserve set PR: and rax, 0xFF01FFFF (mask RW1C latches to no-op-write positions); or rax, 0x10 (set PR bit 4). Write via xhci_op_write_u32(r12, r13, rax). Use direct op-window write (not xhci_port_write) since we've already applied the RW1C mask locally and want to avoid the recomputation of op_base + port_off inside that helper. (6) Poll PRC: mov r14, XHCI_PORT_RESET_SPIN_MAX (5_000_000). Loop { read PORTSC; extract PRC bit 21 via `and rax, 0x200000; cmp rax, 0`; jne prc_done; dec r14; if r14==0 -> timeout=return 0; jmp loop }. (7) prc_done: rax holds the final PORTSC snapshot with PR complete. Extract speed: mov r14, rax; shr r14, 10; and r14, 0xF. Cache speed in r14 (spin counter no longer needed). (8) Clear PRC: and rax, 0xFF01FFFF (mask ALL RW1C latches off); or rax, 0x200000 (set only PRC to clear it); write via xhci_op_write_u32. This keeps other change latches pending (CSC survives — driver-attach code will consume them). (9) Return rax = speed (mov rax, r14). Reserved labels: `xhci_pt_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = port_1based

        // (1) op_base = bar0 + CAPLENGTH.
        mov rdi, rbx;
        xor rsi, rsi;
        call xhci_cap_u8;
        mov r12, rbx;
        add r12, rax;                            // r12 = op_base

        // (2) portsc_off = 0x400 + (port - 1) * 0x10.
        mov rax, rbp;
        sub rax, 1;
        shl rax, 4;
        add rax, 1024;                           // 0x400
        mov r13, rax;                            // r13 = portsc_off

        // (3) Read PORTSC — check CCS.
        mov rdi, r12;
        mov rsi, r13;
        call xhci_op_u32;

        mov r14, rax;
        and r14, 1;                              // CCS
        cmp r14, 0;
        je xhci_pt_fail;

        // (4) Set PR while preserving RW1C latches.
        and rax, 0xFF01FFFF;
        or  rax, 16;                             // PR bit 4 = 0x10

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, rax;
        call xhci_op_write_u32;

        // (5) Poll PORTSC.PRC = 1.
        mov r14, 5000000;                        // XHCI_PORT_RESET_SPIN_MAX

      xhci_pt_wait_prc:
        mov rdi, r12;
        mov rsi, r13;
        call xhci_op_u32;

        mov rcx, rax;
        and rcx, 0x200000;                       // PRC bit 21
        cmp rcx, 0;
        jne xhci_pt_prc_done;

        sub r14, 1;
        cmp r14, 0;
        je xhci_pt_fail;
        jmp xhci_pt_wait_prc;

      xhci_pt_prc_done:
        // rax has PORTSC with PRC set + valid PortSpeed. Cache speed.
        mov r14, rax;
        shr r14, 10;
        and r14, 15;                             // speed (bits 10..13)

        // (6) Acknowledge PRC by writing 1 to bit 21. Neutralize other
        //     RW1C latches (they stay pending for the driver-attach path).
        and rax, 0xFF01FFFF;
        or  rax, 0x200000;                       // PRC set = clear

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, rax;
        call xhci_op_write_u32;

        // (7) Return speed.
        mov rax, r14;
        jmp xhci_pt_done;

      xhci_pt_fail:
        xor rax, rax;

      xhci_pt_done:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
