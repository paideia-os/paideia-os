// src/kernel/core/drivers/xhci/dcbaap.pdx — R26-M4-001 (#956)
//
// xHCI Device Context Base Address Array (DCBAA) — a MaxSlots+1 entry
// array of 64-bit physical pointers, one per Device Context, that the
// host controller DMAs to locate the Device Context of the slot named
// in a Command/Transfer TRB. Programmed via the DCBAAP operational
// register at op_base + 0x30 (xHCI 1.2 §5.4.6 / §6.2.1).
//
// -----------------------------------------------------------------------------
// Array layout (xHCI 1.2 §6.1)
// -----------------------------------------------------------------------------
//
//   DCBAA[0]             — scratchpad buffer array PA (if HCSPARAMS2 says
//                          the HC requires scratchpad buffers) OR 0 if
//                          no scratchpad. We default to 0 at M4 because
//                          the QEMU q35 xhci fixture reports Max
//                          Scratchpad Bufs == 0. Scratchpad allocation
//                          lands at R26.M6 alongside SS descriptor
//                          exchange.
//   DCBAA[1..MaxSlots]   — Device Context PA for each active slot ID.
//                          Software populates *before* Address Device so
//                          the HC can DMA the slot's Device Context on
//                          transaction start.
//
// The array is 64-byte aligned per §6.1 (matches the PCIe cache-line the
// HC uses for DMA burst reads).
//
// -----------------------------------------------------------------------------
// Device Context storage
// -----------------------------------------------------------------------------
//
// Every active slot owns one Device Context (33 * 32 B = 1056 B for
// CSZ=0). Following the same discipline as `_xhci_input_contexts`
// (context.pdx), we provision one 4 KiB page per slot in a
// slot-indexed pool. This:
//
//   * Keeps the per-slot addressing arithmetic branch-free —
//     `base + slot_id * 4096`.
//   * Is page-granular so DMA translations under the R25 IOMMU boundary
//     map cleanly one PTE at a time.
//   * Comfortably fits CSZ=1 too (33 * 64 = 2112 B still ≤ 4096).
//
// The pool covers slots 0..63; slot 0 is over-provisioned so the byte
// arithmetic stays branch-free (its page is never handed to the HC
// because DCBAA[0] is the scratchpad-array slot, not a Device Context
// slot).
//
// -----------------------------------------------------------------------------
// Cross-reference to _xhci_input_contexts
// -----------------------------------------------------------------------------
//
// Input Context and Device Context are DISTINCT structures owned by the
// SW driver and the HC respectively:
//   * Input Context: SW-populated at Address Device / Configure Endpoint
//     time; contains the Input Control Context prefix + a shadow Slot
//     Context + shadow Endpoint Contexts. Handed to the HC via the
//     command TRB's Parameter field. The HC copies fields OUT to the
//     Device Context.
//   * Device Context: HC-owned, DMA'd via DCBAA. SW reads it after
//     command completion to learn assigned USB address / EP state, but
//     never writes it.
//
// M3 (context.pdx) built the Input Context pool; M4 here builds the
// Device Context pool + the DCBAA that indexes it.
//
// -----------------------------------------------------------------------------
// DCBAAP register (xHCI 1.2 §5.4.6)
// -----------------------------------------------------------------------------
//
//   u64 @ op_base + 0x30
//     bits [63:6]   Device Context Base Address Array Pointer (PA, 64-B aligned)
//     bits  [5:0]   Reserved (0)
//
// Programmed once at driver-attach time, then the HC re-reads it on
// every command/transfer to walk the slot table. The array itself must
// be in memory the HC can DMA (identity-mapped .bss under our
// boot-stub; IOMMU-translated once R25 lands the full DTE for the xHCI
// BDF).
//
// -----------------------------------------------------------------------------
// R26.M4 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` boot QEMU q35 exposes no xHC to xhci_probe, so
// xhci_dcbaap_init is never called and DCBAAP is never programmed.
// Symbol exists for the R26.M6+ driver-attach path and for UEFI/OVMF
// activation.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: 64-bit stores/reads are natural REX.W width — plain mov safe.
//
// Reserved-label discipline: labels prefixed `xhci_da_`.

module Dcbaap = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  // DCBAA sizing — 128 entries covers all MaxSlots values we care about
  // (xHCI 1.2 caps MaxSlots at 255 but every commodity fixture reports
  // ≤ 64 for USB2/USB3 combined). Kept a power of two so any future
  // 256-entry expansion is a one-constant change.
  pub let XHCI_DCBAA_ENTRIES        : u64 = 128
  pub let XHCI_DCBAA_BYTES          : u64 = 1024      // 128 * 8

  // Per-slot Device Context page.
  pub let XHCI_DEV_CTX_STRIDE       : u64 = 4096

  // Number of Device Context pages we actually provision (must match
  // XHCI_MAX_SLOTS_INPUT from context.pdx — the two constants move
  // together with any MaxSlots ceiling bump).
  pub let XHCI_MAX_DEV_CTXS         : u64 = 64
  pub let XHCI_DEV_CTX_BYTES_TOTAL  : u64 = 262144    // 64 * 4096

  // Operational-window DCBAAP offset (mirrors XHCI_OP_DCBAAP in regs.pdx).
  pub let XHCI_DCBAAP_OFFSET        : u64 = 0x30

  // ============================================================================
  // Canonical .bss storage
  // ============================================================================
  //
  //   _xhci_dcbaa           : 128 * 8 B = 1024 B = 128 u64 slots
  //                           @align(64) per xHCI 1.2 §6.1 (HC DMA
  //                           cache-line alignment).
  //   _xhci_device_contexts : 64 * 4096 B = 262 144 B = 32 768 u64s
  //                           @align(4096) — one page per slot, page-
  //                           granular for DMA translation.

  pub let mut _xhci_dcbaa           : [u64; 128]   = uninit @align(64)
  pub let mut _xhci_device_contexts : [u64; 32768] = uninit @align(4096)

  // ============================================================================
  // xhci_dcbaap_init(bar0) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64) -> ()
  //   rdi = BAR0 base (page-aligned MMIO)
  //
  // Body:
  //   (1) Zero the 1024-byte DCBAA (all entries start null; slot 0 stays
  //       0 because we have no scratchpad requirement at M4).
  //   (2) Zero the 262 144-byte Device Context pool (Device Contexts
  //       start with EP State = 0 = Disabled per xHCI 1.2 §6.2.3).
  //   (3) Populate DCBAA[i] for i in [1, 63]:
  //         DCBAA[i] = &_xhci_device_contexts + i * 4096
  //       Slot 0 stays 0 (scratchpad-not-required).
  //   (4) Compute op_base = bar0 + CAPLENGTH via xhci_cap_u8.
  //   (5) Program DCBAAP (u64 @ op_base + 0x30) = &_xhci_dcbaa PA.
  //       xhci_op_write_u64's mfence-before is what commits the DCBAA
  //       and Device Context stores globally before the HC ever DMAs
  //       through the DCBAAP pointer.
  //
  // Register plan (5-push callee-save):
  //   rbx = bar0                (survives every nested call)
  //   rbp = dcbaa_base_va       (also serves as DCBAAP arg to write_u64)
  //   r12 = dev_ctx_base_va     (loop-invariant slot pool base)
  //   r13 = loop counter i      (1..63)
  //   r14 = op_base             (populated post-loop)
  //
  //   5 pushes = 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every
  //   nested rep_stosb / xhci_cap_u8 / xhci_op_write_u64 without pre-
  //   call pad).

  pub let xhci_dcbaap_init : (u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M4-001 (#956). DCBAA + Device Context pool bring-up + DCBAAP programming per xHCI 1.2 §6.1 / §5.4.6. Body: (1) 5-push callee-save prologue (rbx=bar0, rbp=dcbaa_base_va, r12=dev_ctx_base_va, r13=loop_i, r14=op_base) — 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every nested rep_stosb / xhci_cap_u8 / xhci_op_write_u64 without pre-call pad). (2) Stash bar0 in rbx. LEA dcbaa_base into rbp and dev_ctx_base into r12 — both survive rep_stosb (only rdi/rax/rcx are clobbered by string-op) and every SysV call that follows. (3) rep_stosb-zero the 1024-byte DCBAA: rdi=rbp, rax=0, rcx=1024, cld. rep_stosb rewrites rdi/rax/rcx; rbp/r12 survive. (4) rep_stosb-zero the 262144-byte Device Context pool: rdi=r12, rax=0, rcx=262144. (5) Populate DCBAA[1..63]: r13=1; loop: cmp r13,64; jae done; entry_addr = rbp + (r13 << 3); dev_ctx_pa = r12 + (r13 << 12); *entry_addr = dev_ctx_pa; r13+=1. DCBAA[0] stays 0 — scratchpad-required is 0 on the QEMU q35 xhci fixture (HCSPARAMS2 Max Scratchpad Bufs = 0); scratchpad allocation lands at R26.M6. (6) Compute op_base = bar0 + CAPLENGTH: mov rdi,rbx; xor rsi,rsi; call xhci_cap_u8; r14 = rbx + rax. (7) Program DCBAAP (u64 @ op_base + 0x30): mov rdi,r14; mov rsi,0x30; mov rdx,rbp; call xhci_op_write_u64. The accessor's mfence-before publishes the DCBAA + Device Context stores globally before the HC's first DMA through the DCBAAP pointer. Encoder: `jae done` for unsigned compare; `mov [rax], rcx` for the 64-bit DCBAA entry store (REX.W natural width — no G1 risk). Reserved labels: `xhci_da_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // rbx = bar0

        // LEA base pointers into callee-save regs (survive rep_stosb).
        lea rbp, [rip + _xhci_dcbaa];
        lea r12, [rip + _xhci_device_contexts];

        // ================================================================
        // (1) Zero the 1024-byte DCBAA.
        // ================================================================
        mov rdi, rbp;
        xor rax, rax;
        mov rcx, 1024;
        cld;
        rep_stosb;

        // ================================================================
        // (2) Zero the 262 144-byte Device Context pool.
        // ================================================================
        mov rdi, r12;
        xor rax, rax;
        mov rcx, 262144;
        cld;
        rep_stosb;

        // ================================================================
        // (3) Populate DCBAA[1..63] with Device Context PAs.
        //     DCBAA[0] intentionally stays 0 (no scratchpad @ M4).
        // ================================================================
        mov r13, 1;                              // i = 1

      xhci_da_loop:
        cmp r13, 64;
        jae xhci_da_loop_done;

        // entry_addr = &DCBAA[i] = dcbaa_base + i * 8
        mov rax, r13;
        shl rax, 3;
        add rax, rbp;

        // dev_ctx_pa = dev_ctx_base + i * 4096
        mov rcx, r13;
        shl rcx, 12;
        add rcx, r12;

        // *entry_addr = dev_ctx_pa  (u64 store; REX.W natural width).
        mov [rax], rcx;

        add r13, 1;
        jmp xhci_da_loop;

      xhci_da_loop_done:

        // ================================================================
        // (4) op_base = bar0 + CAPLENGTH.
        // ================================================================
        mov rdi, rbx;
        xor rsi, rsi;                            // offset 0 = CAPLENGTH
        call xhci_cap_u8;
        mov r14, rbx;
        add r14, rax;                            // op_base

        // ================================================================
        // (5) DCBAAP = &_xhci_dcbaa PA (identity map: VA == PA).
        // ================================================================
        mov rdi, r14;
        mov rsi, 48;                             // XHCI_OP_DCBAAP = 0x30
        mov rdx, rbp;                            // DCBAA base PA
        call xhci_op_write_u64;

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xhci_device_context_ptr(slot_id) -> u64
  // ============================================================================
  //
  // SysV: (slot_id: u64) -> u64
  //   rdi = slot_id (0..63; slot 0 is the scratchpad-array slot and its
  //                  Device Context page is unused but present so the
  //                  arithmetic stays branch-free)
  //
  // Returns rax = virtual address of the Device Context for that slot.
  // Under the boot-stub identity map, VA == PA, so the return value is
  // also the PA the HC DMAs on transaction start.
  //
  // Body:
  //   (1) base = &_xhci_device_contexts
  //   (2) offset = slot_id * 4096 = slot_id << 12
  //   (3) return base + offset
  //
  // Leaf function. No callee-save, no prologue.

  pub let xhci_device_context_ptr : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (slot_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M4-001 (#956). Return VA of the per-slot Device Context page — structural mirror of xhci_input_context_ptr (context.pdx L187). Body: (1) lea rax, [rip + _xhci_device_contexts] — RIP-relative anchor (identity-mapped so VA==PA under the boot stub). (2) shl rdi, 12 — multiply slot_id by 4096 (page stride). (3) add rax, rdi. (4) ret. Leaf — no callee-save, no prologue, no stack. Trusted caller: slot_id in [0, 64) is a driver-side precondition (bounded by XHCI_MAX_DEV_CTXS at DCBAA populate time); out-of-range would index into subsequent .bss and corrupt neighbor state.",
      block: {
        lea rax, [rip + _xhci_device_contexts];
        shl rdi, 12;
        add rax, rdi;
        ret
      }
    }
}
