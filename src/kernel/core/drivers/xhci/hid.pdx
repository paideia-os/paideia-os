// src/kernel/core/drivers/xhci/hid.pdx — R26-M5-004..005 (#963, #964)
//
// Kernel-side USB HID class match + SET_PROTOCOL(Boot) helper.
//
// -----------------------------------------------------------------------------
// Class-match discipline
// -----------------------------------------------------------------------------
//
// The USB HID class is signalled at the Interface level via
// bInterfaceClass = 0x03. Subclass (0=None, 1=Boot Interface) and
// protocol (0=None, 1=Keyboard, 2=Mouse) are not consulted at the
// first-stage kernel match — any Interface with class=0x03 is eligible
// for the boot-protocol path. Downstream userspace HID server (blocked
// on #1015) refines the match.
//
// -----------------------------------------------------------------------------
// SET_PROTOCOL(0) — HID Boot Protocol (USB HID 1.11 §7.2.6)
// -----------------------------------------------------------------------------
//
// Class-specific Control Transfer:
//
//   bmRequestType = 0x21   (host-to-device | class | interface)
//   bRequest      = 0x0B   (SET_PROTOCOL)
//   wValue        = 0      (0 = Boot Protocol, 1 = Report Protocol)
//   wIndex        = interface
//   wLength       = 0
//
// This is a 2-TRB Control Transfer (Setup + Status; no Data stage) —
// same shape as xhci_set_configuration in control_xfer.pdx but with a
// class-specific bmRequestType (0x21 vs 0x00) and different bRequest.
//
// Setup packet packed u64 (LE):
//   bytes: 21 0B 00 00 IL IH 00 00
//   base:  0x0B21 (bytes 0..1 = bmRequestType + bRequest);
//   caller ORs ((interface & 0xFFFF) << 32) at bytes 4..5 (wIndex).
//
// -----------------------------------------------------------------------------
// #963 partial-close note (kernel stub only)
// -----------------------------------------------------------------------------
//
// The full HID class driver lives in userspace (out-of-tree until #1015
// lands the userspace-server substrate). This file provides the
// kernel-side match hook (hid_probe_from_config) that the driver-attach
// loop calls to decide whether to route an interface toward the HID
// path. Kernel stays out of report parsing; that is userspace territory.
//
// -----------------------------------------------------------------------------
// R26.M5 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// No HC under BIOS/`-kernel` boot means no interface enumeration -> no
// call into hid_probe_from_config or xhci_hid_set_boot_protocol at
// boot. Symbols exist for R26.M6+ HID bring-up + UEFI/OVMF activation.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: zero-extended u8 load for the interface-class check.
//
// Reserved-label discipline: `hid_pfc_` (probe from config),
// `xhci_hsp_` (HID set protocol).

module Hid = structure {

  // ============================================================================
  // USB HID class constants
  // ============================================================================

  pub let USB_CLASS_HID                 : u64 = 0x03

  pub let USB_HID_PROTOCOL_BOOT         : u64 = 0
  pub let USB_HID_PROTOCOL_REPORT       : u64 = 1

  // Setup packet base for SET_PROTOCOL(0):
  //   bytes: 21 0B 00 00 IL IH 00 00
  //   Low 16 bits = 0x0B21; caller ORs ((interface & 0xFFFF) << 32).
  pub let USB_SETUP_SET_PROTOCOL_BASE   : u64 = 0x0B21

  // ============================================================================
  // hid_probe_from_config(config_info) -> u64
  // ============================================================================
  //
  // Returns 1 if config_info.interface_class (u8 @ +0) == 0x03; else 0.

  pub let hid_probe_from_config : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (config_info: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M5-004 (#963 kernel stub). First-stage HID class match: config_info.interface_class (u8 @ +0) == 0x03. Body: (1) xor rax,rax + mov_b rax, [rdi + 0] — G1 zero-extended u8 load of interface_class. (2) cmp rax, 3 (USB_CLASS_HID). (3) Single-ret discipline (matches slot.pdx pattern): branch to hit label on equal; fall-through zeroes rax + jmp done. hit sets rax=1 then falls to done. done -> ret. Leaf. Reserved labels: `hid_pfc_`.",
      block: {
        xor rax, rax;
        mov_b rax, [rdi + 0];
        cmp rax, 3;
        je  hid_pfc_hit;
        xor rax, rax;
        jmp hid_pfc_done;

      hid_pfc_hit:
        mov rax, 1;

      hid_pfc_done:
        ret
      }
    }

  // ============================================================================
  // xhci_hid_set_boot_protocol(bar0, event_ctx, slot_id, ep0_ring,
  //                            interface) -> u64
  // ============================================================================

  pub let xhci_hid_set_boot_protocol : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, event_ctx: u64, slot_id: u64, ep0_ring: u64, interface: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M5-005 (#964). SET_PROTOCOL(0=Boot) HID class-specific Control Transfer per USB HID 1.11 §7.2.6 + xHCI 1.2 §4.11.2. Structurally identical to xhci_set_configuration (control_xfer.pdx) — 2-TRB (Setup + Status), no Data stage. Body: (1) 5-push callee-save (rbx=bar0, rbp=event_ctx, r12=slot_id, r13=ep0_ring, r14=interface) + sub rsp,8 align — 48 B; entry rsp%16==8 -> 56, %16==0 (aligned for every nested call). (2) Compose Setup packet u64 = USB_SETUP_SET_PROTOCOL_BASE (0x0B21) | ((interface & 0xFFFF) << 32): mov rax, r14; and rax, 0xFFFF; shl rax, 32; mov rcx, 0x0B21; or rax, rcx. Encodes bmRequestType=0x21 (host-to-device | class | interface — NOT standard 0x00), bRequest=0x0B SET_PROTOCOL, wValue=0 (Boot Protocol), wIndex=interface, wLength=0. (3) Enqueue Setup TRB via xhci_transfer_enqueue_raw(ep0_ring, param=composed, status=8, ctrl=0x840 XHCI_CTL_SETUP_NODATA). TRT=0 (No Data Stage). (4) No Data TRB. (5) Enqueue Status IN+IOC TRB via xhci_transfer_enqueue_raw(ep0_ring, param=0, status=0, ctrl=0x11020 XHCI_CTL_STATUS_IN_IOC). Direction IN is opposite of implicit OUT for no-data Control transfers; IOC=1 publishes the completion event. (6) Ring EP0 doorbell: xhci_ring_ep_doorbell(bar0, slot_id, 1). DCI=1 = EP0. (7) Poll: xhci_poll_transfer_event(event_ctx). Return the poll result unchanged. Reserved labels: `xhci_hsp_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        mov rbp, rsi;
        mov r12, rdx;
        mov r13, rcx;
        mov r14, r8;

        mov rax, r14;
        and rax, 0xFFFF;
        shl rax, 32;
        mov rcx, 0x0B21;
        or  rax, rcx;

        mov rdi, r13;
        mov rsi, rax;
        mov rdx, 8;
        mov rcx, 0x840;
        call xhci_transfer_enqueue_raw;

        mov rdi, r13;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, 0x11020;
        call xhci_transfer_enqueue_raw;

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, 1;
        call xhci_ring_ep_doorbell;

        mov rdi, rbp;
        call xhci_poll_transfer_event;

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
