// src/kernel/core/drivers/xhci/attach.pdx — R111.M5-017 (paideia-os #2369)
//
// xHCI real-HW controller attach cascade.
//
// The R26.M1 substrate (drivers/xhci/probe.pdx, regs.pdx, bios_handoff.pdx,
// reset.pdx) plus the R26.M3 port register accessors (ports.pdx) already
// land every controller-attach primitive:
//
//   xhci_probe            — PCI walk for class 0x0C / subclass 0x03 /
//                           prog-if 0x30; publishes _xhci_devices.
//   xhci_bios_handoff     — walk xECP for USBLEGSUP (cap_id 0x01), set
//                           OS-owned semaphore, poll until BIOS clears
//                           its bit, then tail-call xhci_disable_smi to
//                           silence USBLEGCTLSTS SMI sources per xHCI
//                           1.2 §7.1.1..§7.1.2.
//   xhci_reset            — halt (clear USBCMD.RS + poll USBSTS.HCH),
//                           reset (set USBCMD.HCRST + poll HCRST clear
//                           AND USBSTS.CNR clear), then program
//                           CONFIG.MaxSlotsEn = min(HCSPARAMS1.MaxSlots,
//                           XHCI_MAX_SLOTS_MVP=64) — the operational-
//                           register init step of §4.2.
//   xhci_port_count       — HCSPARAMS1.MaxPorts.
//   xhci_port_read        — per-port PORTSC snapshot.
//   platform_mmio_map     — map (bar0_pa, 0x2000, MMIO_UC=0) into the
//                           higher-half kernel window at PML4[321].
//   cap_mint_write        — publish a cap-slot descriptor.
//
// What has been missing is the top-level orchestrator that chains these
// primitives together in the real boot cascade, mints the parent
// KIND_PCI_DEV broker with RIGHT_MINT so a future KIND_XHCI_CTRL
// derivation gate has a valid parent, publishes a per-controller
// KIND_XHCI_CTRL cap-slot for downstream USB substrate reach
// (KIND_USB_DEVICE / _HUB / _INTERFACE / _ENDPOINT), and emits the
// R111 fingerprints (XHCI ATTACH OK / XHCI PORT / XHCI BOOT NONE) so
// the operator + goldens can observe every T14 G4 xHCI function that
// boot reaches.
//
// Placement: called from kernel_main immediately after nvme_attach_all
// so (a) _pci_devices is populated (pci_publish_caps ran earlier),
// (b) the DMAR / IRT bring-up has landed one way or the other so
// subsequent xHCI MSI-X programming has a well-defined runtime gate,
// (c) vmd_detect_and_refuse has halted the boot if a VMD silicon
// block is masking silicon from config space (VMD masks NVMe not xHCI
// but the vmd_detect gate serves as the "no hidden devices" barrier
// for every driver-attach cascade), and (d) nvme_attach_all has
// already exercised the same platform_mmio_map + cap_mint_write path
// so any MMIO-window or cap-table breakage would have surfaced first
// on storage, not USB, keeping the "storage before HID" boot-order
// discipline.
//
// -----------------------------------------------------------------------------
// Parent-cap discipline
// -----------------------------------------------------------------------------
//
// The KIND_XHCI_CTRL derivation gate is not yet formalized in
// core/cap/kind_xhci_ctrl.pdx (M5 milestone footprint: attach-orchestrator
// only; full kind row / rights lattice / dispatch handler deferred to a
// follow-on wave alongside KIND_USB_DEVICE re-parenting). This orchestrator
// therefore mints the KIND_XHCI_CTRL descriptor directly via cap_mint_write
// with a raw KIND_XHCI_CTRL kind constant (0x19C) — no derivation-gate call
// runs. The XHCI_ATTACH_BROKER_SLOT (192) is nonetheless minted every
// iteration with R_DEV_ALL | RIGHT_MINT so the future gate (whose contract
// will demand `parent.kind == KIND_PCI_DEV(0x30) AND rights & RIGHT_MINT`,
// mirroring nvme_ctrl_check_parent_pci_dev in kind_nvme_controller.pdx
// L347-355) already has its parent broker in place; the switch from
// direct-mint to gate-derive is then a change to this file alone rather
// than to the kernel_main cascade or slot layout.
//
// Slot 192 was chosen deliberately over slot 177 (NVME_ATTACH_BROKER_SLOT):
// keeping storage and USB brokers on distinct slots means a concurrent
// re-attach of one class does not race the broker column of the other.
// Slot 176 is production (mount_bootstrap.pdx MBOT_ROOT_VOLUME_CAP_SLOT);
// 177 is NVMe's rotating broker; 184..191 are NVMe's per-controller
// publish band. Slots 192..199 are free below the e1000e band (200/201).
//
// -----------------------------------------------------------------------------
// Slot layout (verified against grep -rhnE for _CAP_SLOT constants
// across src/kernel/, 2026-09-07)
// -----------------------------------------------------------------------------
//
//   130   PFRB_MEM_SLOT           (page-frame refcount buffer)
//   132   SYSFB_STAGING_SLOT      (framebuffer staging)
//   134   SYSVM_STAGING_SLOT      (VM staging)
//   160   PXTL_PARENT_SLOT        (pdxfs test loader parent)
//   168   PXUW_PARENT_SLOT        (pdxfs unlock witness parent)
//   176   MBOT_ROOT_VOLUME_CAP_SLOT (root-volume mount bootstrap)
//   177   NVME_ATTACH_BROKER_SLOT (rotating KIND_PCI_DEV broker for NVMe)
//   184..191  NVME_ATTACH_PUB_SLOT_BASE (per-controller KIND_NVME_CONTROLLER,
//             8 slots, NVME_MAX_DEVS)
//   192   XHCI_ATTACH_BROKER_SLOT (new — this file)
//   196..199  XHCI_ATTACH_PUB_SLOT_BASE (new — 4 slots, XHCI_MAX_DEVS)
//   200   E1000E_DEVICE_CAP_SLOT
//   201   E1000E_NIC_CAP_SLOT
//   232   SL_GRANT_SLOT_BASE
//
// No collision with any live consumer. The 192..199 range keeps xHCI
// contiguous with the NVMe attach block for at-a-glance operator recall
// ("storage attaches at 184..191, USB at 192..199, NIC at 200..201").
//
// -----------------------------------------------------------------------------
// Fingerprint contract
// -----------------------------------------------------------------------------
//
// Per controller successfully brought up:
//   XHCI PORT port=<n> css=<0|1> speed=<n>
//     one line per root-hub port. css=1 iff a device is connected;
//     speed is PORTSC[13:10]: 0 = undefined, 1 = FS, 2 = LS, 3 = HS,
//     4 = SuperSpeed. On QEMU q35 with -device qemu-xhci a hotplugged
//     usb-storage/usb-kbd will surface as css=1 speed=3 or 4; on real
//     T14 G4 hardware every populated port lands on this emit.
//
//   XHCI ATTACH OK bdf=<packed> ports=<n> mmio=0x<hex>
//     bdf   = packed (seg[39:24] | bus[23:16] | dev[15:8] | fn[7:0])
//             via bdf_pack (core/cap/device_cap.pdx L136).
//     ports = HCSPARAMS1.MaxPorts (root-hub port count, 1..255).
//     mmio  = the mapped BAR0 kernel VA (bit 63 set for real higher-
//             half mappings; equal to bar0_pa in the -kernel PVH boot
//             path where the ranges lands inside the boot huge-page
//             identity map and platform_mmio_map's MAP_HUGE fallback
//             returns pa_base — see core/mm/mmio_map.pdx §MAP_HUGE).
//   klog_s1_x3 stack-arg layout: caller writes v2/k3/v3 into a
//   pre-reserved 24-byte scratch region at [rsp+0..rsp+16]. On call,
//   ret_addr goes to [rsp-8]; callee sees v2 at [callee_rsp+8] =
//   [caller_rsp+0]. Same mov-into-scratch idiom as nvme/attach.pdx L297-318.
//
// If xhci_probe reports zero devices (typical on QEMU-TCG -kernel boot
// where MCFG is absent, and on real hardware if the platform has no
// xHCI root complex — vanishingly rare post-2015):
//   XHCI BOOT NONE
//   xhci_attach_all returns 0.
//
// The "XHCI ATTACH OK" tag carries an OK token and therefore trips the
// verify-fingerprint-coverage.sh gate on any boot where an xHCI
// controller is present. Since the 14-mode QEMU matrix boots via
// `-kernel` (MCFG absent, xhci_probe returns 0, XHCI BOOT NONE arm
// taken), the OK line is unreachable in every default mode; an
// allowlist entry in tools/verify-fingerprint-coverage.sh names the
// same real-HW-only posture the NVME ATTACH OK sibling entry uses.
//
// -----------------------------------------------------------------------------
// Best-effort continuation on partial failure
// -----------------------------------------------------------------------------
//
// Only platform_mmio_map failure (rax == 0) skips the iteration; every
// other step (bios_handoff, reset, port_count) is best-effort continue.
// Rationale: (1) xhci_bios_handoff returning NO_ECAP or NO_LEGSUP is
// the qemu-xhci fixture posture (no legacy support cap present), not a
// real failure; TIMEOUT means firmware never released ownership, which
// on real hardware may still let register reads work well enough for
// the operator to see PORTSC snapshots. (2) xhci_reset TIMEOUT on
// halt or reset-completion phase indicates a controller in a bad state,
// but a subsequent PORTSC read will surface `css=0 speed=0` on every
// port — a distinct operator-visible signal that the controller is
// non-functional. Halting the whole boot on partial USB-controller
// failure would be worse than the observation. Publishing the cap on
// partial failure is consistent: downstream USB device enumeration
// will subsequently fail its own reset polls and produce its own
// fingerprint trail.
//
// -----------------------------------------------------------------------------
// Register plan + stack layout
// -----------------------------------------------------------------------------
//
// Callee-save prologue: push rbx, rbp, r12, r13, r14, r15 (6 × 8 = 48 B)
// then sub rsp, 40 (scratch). Entry rsp%16 == 8 (SysV callee entry);
// post-prologue rsp%16 == (8 + 48 + 40) mod 16 == 96 mod 16 == 0 —
// aligned for every nested call. Epilogue reverses.
//
// Register roles across the outer (controller) loop:
//   rbx = i               — cursor into _xhci_devices (0..count).
//   rbp = port cursor     — 1-based port index (1..maxports) inside the
//                            per-controller port scan.
//   r12 = count           — _xhci_device_count latched once from xhci_probe.
//   r13 = packed bdf      — per-iter, survives to publish + fingerprint emit.
//   r14 = bar0_va         — per-iter, mapped BAR0 kernel VA (published
//                            as target_ptr of the KIND_XHCI_CTRL cap).
//   r15 = successes       — accumulator returned in rax at exit.
//
// Scratch layout ([rsp+0..rsp+39], 40 B):
//   [rsp+0]  = klog v2 (ports @ OK / css @ PORT)      — becomes callee [rsp+8]
//   [rsp+8]  = klog k3 (&k_mmio @ OK / &k_speed @ PORT) — callee [rsp+16]
//   [rsp+16] = klog v3 (mmio @ OK / speed @ PORT)      — callee [rsp+24]
//   [rsp+24] = bar0_pa spill (survives bdf_pack; consumed by
//              platform_mmio_map immediately after)
//   [rsp+32] = ports count spill (survives per-port loop calls)
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.36+)
// -----------------------------------------------------------------------------
//
//   G1: byte + word loads via `xor rax, rax; mov_b/mov_w rax, [mem]`
//       — same pattern established by nvme/probe.pdx L138-169.
//   G4: full-register compares (`cmp rax, 0`, not `test`).
//
// No test rN/rN, no 2-op imul r,imm, no and reg,imm64 (0x21F/0x1F fit
// imm32), no cmp reg,[mem]. Byte-load-zero pattern for the u8/u16 BDF
// fields. Every immediate used (0x2000, 0x30, 0x21F, 0x19C, 0x1F, 0xF,
// 1, 3, 192, 196) fits imm32 — no movabs required.
//
// Reserved-label discipline: all labels prefixed `xhci_at_` to avoid
// reserved names (`loop`, `if`, `done`, `next`).

module Attach = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  // Slot 192 = rotating parent-broker KIND_PCI_DEV cap for xHCI attach.
  // Overwritten each iteration. Disjoint from every claimed slot (see
  // file header §Slot layout).
  pub let XHCI_ATTACH_BROKER_SLOT   : u64 = 192

  // Slots 196..199 (4 slots, one per XHCI_MAX_DEVS row) = per-controller
  // KIND_XHCI_CTRL cap. target_ptr holds the mapped BAR0 VA so downstream
  // USB substrate reach (KIND_USB_DEVICE / _HUB / _INTERFACE / _ENDPOINT)
  // can derive against a valid controller register-set pointer.
  pub let XHCI_ATTACH_PUB_SLOT_BASE : u64 = 196

  // KIND_XHCI_CTRL — sits in the storage/controller-kind cluster
  // (KIND_NVME_CONTROLLER=0x198, KIND_NVME_NAMESPACE=0x199,
  // KIND_AHCI_CONTROLLER=0x19A, KIND_AHCI_PORT=0x19B, this=0x19C).
  // Free per grep -rhnE 'KIND_[A-Z0-9_]+\s*:\s*u64\s*=\s*0x19' across
  // src/kernel/core/cap/ (2026-09-07). Reserved for the future formal
  // derivation-gated kind_xhci_ctrl.pdx.
  pub let KIND_XHCI_CTRL            : u64 = 0x19C

  // xHCI BAR0 MMIO window size. xHCI 1.2 §5 puts capability + operational
  // + runtime + doorbell registers within an 8 KiB window on every
  // commodity controller (Intel PCH, AMD chipsets, qemu-xhci). Extended
  // capabilities may extend past 8 KiB on some vendor implementations
  // but the substrate walkers (bios_handoff, ports) only touch inside
  // this window on the R111.M5 path.
  pub let XHCI_ATTACH_BAR0_SIZE     : u64 = 0x2000

  // MMIO_UC — cache_type argument to platform_mmio_map. xHCI register
  // set requires UC per xHCI 1.2 §5.2 (memory-typed as Uncacheable so
  // register RMW semantics land in program order without WB coalescing).
  // Same value NVMe uses (core/drivers/nvme/enable.pdx).
  pub let XHCI_ATTACH_MMIO_UC       : u64 = 0

  // ==========================================================================
  // xhci_attach_all() -> u64
  // ==========================================================================
  //
  // SysV: () -> u64
  //   rax = number of controllers successfully brought up + published
  //         (0..XHCI_MAX_DEVS=4). Zero indicates either "no xHCI silicon
  //         in this segment" (fingerprint XHCI BOOT NONE) or "every
  //         discovered controller failed MMIO map" (rare; a bar0_pa of
  //         0 in _xhci_devices would be the observable symptom).

  pub let xhci_attach_all : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot, cap },
      justification: "R111.M5-017 (paideia-os #2369): xHCI real-HW controller attach orchestrator. Called from kernel_main_64 immediately after nvme_attach_all (kernel_main.pdx L553). Body: (1) 6-push callee-save prologue (rbx, rbp, r12, r13, r14, r15 — 48 B) + sub rsp, 40 for scratch. Entry rsp%16==8; post-prologue rsp%16==(8+48+40) mod 16 == 96 mod 16 == 0 for every nested call. (2) Call xhci_probe to populate _xhci_devices and latch count in r12. Zero-count branch: emit XHCI BOOT NONE via klog_s1(LEVEL_INFO, SUBSYS_XHCI, tag_xhci_boot_none) and return 0. (3) Per iteration i in [0, count): compute &_xhci_devices[i] via `mov rax, rbx; shl rax, 5; lea r10, [rip + _xhci_devices]; add r10, rax`; stash bar0_pa (u64 @+8) into [rsp+24] BEFORE clobbering r10 with BDF-field loads (bdf_pack is leaf per its signature but preserving the spill discipline keeps the post-bdf_pack platform_mmio_map call insensitive to callee-save assumptions); extract seg (u16 @+0), bus/dev/fn (u8 @+2/+3/+4) using the xor+mov_b/mov_w byte-zero pattern from nvme/probe.pdx L138-169; pack via bdf_pack (rax = packed bdf) and save in r13. (4) Map BAR0: platform_mmio_map([rsp+24] bar0_pa, XHCI_ATTACH_BAR0_SIZE 0x2000, MMIO_UC 0) → rax. Non-zero returns are valid VAs (higher-half or identity-VA huge-page fallback); zero is failure (aspace_map returned MAP_OOM/MAP_OVERLAP, or a mid-range MAP_HUGE — see mmio_map.pdx §MAP_HUGE). cmp rax, 0; je xhci_at_next skips the iteration on map failure. Cache VA in r14. (5) BIOS handoff: mov rdi, r14; call xhci_bios_handoff. Return code (XHCI_HANDOFF_OK / _NO_ECAP / _NO_LEGSUP / _TIMEOUT) is informational — a TIMEOUT on real hardware may still leave register reads viable enough for the operator to observe PORTSC snapshots (see file header §Best-effort). (6) Reset: mov rdi, r14; call xhci_reset. This is the operational-register init step: halt (clear USBCMD.RS, poll USBSTS.HCH), reset (set USBCMD.HCRST, poll HCRST clear AND USBSTS.CNR clear), then program CONFIG.MaxSlotsEn per xHCI 1.2 §4.2 / §5.4.1.1. Return code (XHCI_RESET_OK / _ERR_HALT / _ERR_RESET) also informational. (7) Port count: xhci_port_count(r14) reads HCSPARAMS1.MaxPorts (bits 24..31) and returns 0..255. Spill into [rsp+32] for the OK-emit path AND the port-scan loop bound. (8) Port scan: mov rbp, 1 (1-based per xHCI spec convention). xhci_at_port_loop: mov r10, [rsp+32]; cmp rbp, r10; ja xhci_at_port_done. Read PORTSC via xhci_port_read(r14 bar0_va, rbp port_1based) — rax = PORTSC u32. Extract CCS (bit 0) into r11 via `and r11, 1`; extract PortSpeed (bits 10..13) into r10 via `shr r10, 10; and r10, 0xF`. Emit XHCI PORT port=<n> css=<0|1> speed=<n> via klog_s1_d3 (3 decimal KVs — port, css, speed all natural counts): caller writes v2=css to [rsp+0], k3=&k_speed to [rsp+8], v3=speed to [rsp+16]; k1/v1/k2 in registers (k_port, rbp, k_css). Advance rbp; loop. (9) Publish cascade: xhci_at_port_done — mint the KIND_PCI_DEV broker at slot XHCI_ATTACH_BROKER_SLOT (192) with R_DEV_ALL|RIGHT_MINT (0x21F) so a future kind_xhci_ctrl_check_parent_pci_dev gate (analogous to kind_nvme_controller.pdx L347-355) already has its valid parent — this file mints the leaf KIND_XHCI_CTRL directly via cap_mint_write today, but the broker mint costs a single cap_mint_write and makes the future migration to a formal derivation gate a change to this file alone. Publish the KIND_XHCI_CTRL cap at slot XHCI_ATTACH_PUB_SLOT_BASE + i (196+i) with R_DEV_ALL (0x1F — no MINT since KIND_XHCI_CTRL is a leaf in the R111.M5 kind lattice), target_ptr = r14 (bar0_va). (10) OK emit: mov r10, [rsp+32] (ports count); write to [rsp+0] as v2; lea rax, [rip+k_mmio]; mov [rsp+8], rax (k3); mov [rsp+16], r14 (v3 = mmio VA). klog_s1_x3(LEVEL_INFO, SUBSYS_XHCI, tag_xhci_attach_ok, k_bdf, r13 bdf, k_ports) — reads v2/k3/v3 at callee [rsp+8..24] = caller [rsp+0..16]. Increment r15. (11) xhci_at_next: add rbx, 1; jmp xhci_at_loop. (12) xhci_at_done: mov rax, r15; xhci_at_out: epilogue. Encoder pitfalls avoided: no test rN/rN (use cmp), no imul r,imm 2-op, no and reg,imm64 (0x21F/0x1F/0xF/0x2000 fit imm32; 0x30/0x19C/192/196/1/3 also fit), no cmp reg,[mem]. Byte-load-zero pattern for u8/u16 fields. Reserved labels: xhci_at_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        // ---------------------------------------------------------------
        // Populate _xhci_devices via xhci_probe. Sole caller in the boot
        // cascade — no idempotence concern.
        // ---------------------------------------------------------------
        call xhci_probe;
        mov r12, rax;                    // r12 = _xhci_device_count

        cmp r12, 0;
        jne xhci_at_have;

        // XHCI BOOT NONE: no xHCI controllers discovered.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_xhci_boot_none];
        call klog_s1;
        xor rax, rax;
        jmp xhci_at_out;

      xhci_at_have:
        xor rbx, rbx;                    // i = 0
        xor r15, r15;                    // successes = 0

      xhci_at_loop:
        cmp rbx, r12;
        jae xhci_at_done;

        // -------------------------------------------------------------
        // Compute &_xhci_devices[i] = base + (i << 5). Row stride 32 B
        // per xhci/probe.pdx L33-47.
        // -------------------------------------------------------------
        mov rax, rbx;
        shl rax, 5;
        lea r10, [rip + _xhci_devices];
        add r10, rax;

        // Stash bar0_pa (u64 @+8) into scratch for the platform_mmio_map
        // call below. Done before clobbering r10 with BDF field loads.
        mov rax, [r10 + 8];
        mov [rsp + 24], rax;             // bar0_pa spill

        // -------------------------------------------------------------
        // Pack BDF via bdf_pack(seg, bus, dev, fn). Byte-load-zero
        // pattern per nvme/probe.pdx L138-169.
        // -------------------------------------------------------------
        xor rax, rax;
        mov_w rax, [r10 + 0];            // seg (u16)
        mov rdi, rax;

        xor rax, rax;
        mov_b rax, [r10 + 2];            // bus (u8)
        mov rsi, rax;

        xor rax, rax;
        mov_b rax, [r10 + 3];            // dev (u8)
        mov rdx, rax;

        xor rax, rax;
        mov_b rax, [r10 + 4];            // fn (u8)
        mov rcx, rax;

        call bdf_pack;
        mov r13, rax;                    // r13 = packed bdf

        // -------------------------------------------------------------
        // Map BAR0 into the higher-half kernel window with UC caching.
        // platform_mmio_map returns 0 on any aspace_map failure
        // (MAP_OOM/MAP_OVERLAP) or on a mid-range MAP_HUGE; a first-
        // iteration MAP_HUGE returns bar0_pa (identity VA), which is a
        // valid alias the downstream xhci_* accessors can dereference.
        // -------------------------------------------------------------
        mov rdi, [rsp + 24];             // bar0_pa
        mov rsi, 0x2000;                 // XHCI_ATTACH_BAR0_SIZE
        xor rdx, rdx;                    // MMIO_UC
        call platform_mmio_map;

        cmp rax, 0;
        je xhci_at_next;                 // MMIO map failed — skip
        mov r14, rax;                    // r14 = bar0_va

        // -------------------------------------------------------------
        // BIOS -> OS handoff via USBLEGSUP (xECP walk). Also disables
        // USBLEGCTLSTS SMI sources per xHCI 1.2 §7.1.1..§7.1.2 (the
        // #944 substrate call couples handoff + SMI-disable inseparably).
        // Return code informational — see file header §Best-effort.
        // -------------------------------------------------------------
        mov rdi, r14;
        call xhci_bios_handoff;

        // -------------------------------------------------------------
        // Operational-register init: halt + HCRST + poll + program
        // CONFIG.MaxSlotsEn = min(HCSPARAMS1.MaxSlots, 64). Return
        // code informational.
        // -------------------------------------------------------------
        mov rdi, r14;
        call xhci_reset;

        // -------------------------------------------------------------
        // Port count: HCSPARAMS1.MaxPorts. Spill for OK emit AND
        // port-scan loop bound (calls will clobber caller-save regs).
        // -------------------------------------------------------------
        mov rdi, r14;
        call xhci_port_count;
        mov [rsp + 32], rax;             // ports count spill

        // -------------------------------------------------------------
        // Port scan: per port, snapshot PORTSC and emit
        //   XHCI PORT port=<n> css=<0|1> speed=<n>
        // rbp is the 1-based port cursor (xHCI spec convention).
        // -------------------------------------------------------------
        mov rbp, 1;                      // port_1based = 1

      xhci_at_port_loop:
        mov r10, [rsp + 32];             // ports count
        cmp rbp, r10;
        ja xhci_at_port_done;            // rbp > ports -> done

        // Read PORTSC(bar0_va, port_1based) -> rax = u32 zero-extended.
        mov rdi, r14;
        mov rsi, rbp;
        call xhci_port_read;

        // CCS = PORTSC & 1 (bit 0).
        mov r11, rax;
        and r11, 1;

        // PortSpeed = (PORTSC >> 10) & 0xF (bits 10..13).
        mov r10, rax;
        shr r10, 10;
        and r10, 15;

        // Emit XHCI PORT port=<n> css=<0|1> speed=<n> via klog_s1_d3.
        // Caller writes v2/k3/v3 at [rsp+0..16] (24 B); callee reads
        // them at [rsp+8..24] post-CALL push of ret_addr.
        mov [rsp + 0], r11;              // v2 = css
        lea rax, [rip + k_speed];
        mov [rsp + 8], rax;              // k3 = &k_speed
        mov [rsp + 16], r10;             // v3 = speed

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_xhci_port];
        lea rcx, [rip + k_port];         // k1
        mov r8, rbp;                     // v1 = port (1-based)
        lea r9, [rip + k_css];           // k2
        call klog_s1_d3;

        add rbp, 1;
        jmp xhci_at_port_loop;

      xhci_at_port_done:

        // -------------------------------------------------------------
        // Mint KIND_PCI_DEV broker at slot XHCI_ATTACH_BROKER_SLOT
        // (192) with R_DEV_ALL | RIGHT_MINT (0x21F). See file header
        // §Parent-cap discipline — the broker is a placeholder for the
        // future formal kind_xhci_ctrl derivation gate; publishing it
        // every iteration keeps the future gate migration local to
        // this file.
        // -------------------------------------------------------------
        mov rdi, 192;                    // XHCI_ATTACH_BROKER_SLOT
        mov rsi, 0x30;                   // KIND_PCI_DEV
        mov rdx, 0x21F;                  // R_DEV_ALL | RIGHT_MINT
        mov rcx, r13;                    // target_ptr = packed bdf
        call cap_mint_write;

        // -------------------------------------------------------------
        // Publish per-controller KIND_XHCI_CTRL cap at slot
        // XHCI_ATTACH_PUB_SLOT_BASE + i (196+i). target_ptr = bar0_va
        // (mapped MMIO kernel VA) so downstream USB substrate reach
        // (KIND_USB_DEVICE / _HUB / _INTERFACE / _ENDPOINT) can derive
        // against a valid controller register-set pointer.
        // -------------------------------------------------------------
        mov rdi, 196;                    // XHCI_ATTACH_PUB_SLOT_BASE
        add rdi, rbx;                    // + i
        mov rsi, 0x19C;                  // KIND_XHCI_CTRL
        mov rdx, 0x1F;                   // R_DEV_ALL (leaf; no MINT)
        mov rcx, r14;                    // target_ptr = bar0_va
        call cap_mint_write;

        // -------------------------------------------------------------
        // Emit XHCI ATTACH OK bdf=<packed> ports=<n> mmio=0x<hex>.
        // klog_s1_x3 reads v2/k3/v3 at callee [rsp+8..24] = caller
        // [rsp+0..16]; the same 24-byte scratch region the port loop
        // used above.
        // -------------------------------------------------------------
        mov r10, [rsp + 32];             // ports count
        mov [rsp + 0], r10;              // v2 = ports
        lea rax, [rip + k_mmio];
        mov [rsp + 8], rax;              // k3 = &k_mmio
        mov [rsp + 16], r14;             // v3 = bar0_va

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_xhci_attach_ok];
        lea rcx, [rip + k_bdf];          // k1
        mov r8, r13;                     // v1 = packed bdf
        lea r9, [rip + k_ports];         // k2
        call klog_s1_x3;

        add r15, 1;                      // successes++

      xhci_at_next:
        add rbx, 1;
        jmp xhci_at_loop;

      xhci_at_done:
        mov rax, r15;                    // return successes

      xhci_at_out:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

}
