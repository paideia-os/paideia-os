// src/kernel/core/drivers/xhci/trb.pdx — R26-M2-001 (#946)
//
// Transfer Request Block (TRB) primitive: a 16-byte quadword-pair that
// software or the xHC produces onto a ring buffer. Every command,
// transfer, and event in the xHCI protocol is a TRB — layout is fixed
// at 16 bytes, discriminated on the TRB Type field in the control word.
//
// -----------------------------------------------------------------------------
// TRB layout (xHCI 1.2 §4.11)
// -----------------------------------------------------------------------------
//
//   +0    u64  Parameter        — command-specific (PA of buffer /
//                                  Slot / Endpoint context / IRT handle)
//   +8    u32  Status           — Transfer Length / Completion Code
//   +12   u32  Control
//                bit  0        C       Cycle Bit — producer/consumer disc.
//                bit  1        ENT     Evaluate Next TRB
//                bit  2        ISP     Interrupt-on-Short-Packet
//                bit  4        CH      Chain Bit (multi-TRB transfer)
//                bit  5        IOC     Interrupt-on-Completion
//                bit  6        IDT     Immediate Data (setup stages)
//                bits [15:10]  TT      TRB Type (see constants below)
//                bits [20:16]  EP_ID   Endpoint ID (transfer TRBs only)
//                bits [31:24]  Slot ID (Address Device / Config EP etc.)
//
// Link TRB has an additional field:
//                bit  1        TC      Toggle Cycle (when Link → wrap)
//
// -----------------------------------------------------------------------------
// #946 blocker verdict — PAPER TIGER
// -----------------------------------------------------------------------------
//
// The issue was tagged `cross-repo:paideia-as-blocked` on the premise
// that a 128-bit TRB required "bitfield struct helpers phase 2" in
// paideia-as. Verdict: not blocked. Every existing 128-bit structure
// in the codebase — the VT-d IRTE (R22.M5), the MSI-X table entry
// (R21.M4), the NVMe CQE (R24.M2) — is written or read as two u64
// halves (or 4 × u32) with an mfence bracket. We inherit that
// discipline unchanged. The one xHCI-specific ordering constraint —
// "Cycle bit must be written LAST for producer safety" — is met by
// splitting the +12 control word into a `control_no_cycle` argument
// and a `cycle_bit` argument, with the OR of the two written after
// the +0 param and +8 status stores complete. mfence bracketing
// enforces store order across the producer/consumer boundary.
//
// -----------------------------------------------------------------------------
// Producer-safety discipline (xHCI 1.2 §4.9.4)
// -----------------------------------------------------------------------------
//
// A TRB is "owned" by the producer when its cycle bit differs from the
// consumer's expected cycle state. Software producers therefore MUST:
//
//   (1) Populate +0 (param) and +8 (status) FIRST.
//   (2) Write +12 with the caller-computed control_no_cycle OR-ed
//       with the current cycle_bit LAST — this atomic (u32) store
//       is the moment the xHC becomes eligible to fetch the TRB.
//
// mfence bracketing on each side of the +12 store guarantees:
//   (a) the +0/+8 stores retire before +12 (WB→WB ordering is TSO on
//       x86, but the xHC's DMA read is UC-aliased through the IOMMU
//       and may reorder — mfence forecloses the racy possibility);
//   (b) downstream code observes the +12 write publication before
//       any subsequent ring-bookkeeping mutation.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` widens → mov_d for the u32 stores at +8 / +12.
//       +0 store is natural REX.W (u64) — bare mov safe.
//   G4: full-register compares (not exercised here).
//
// Reserved-label discipline: no labels needed (leaf function).

module Trb = structure {

  // ============================================================================
  // TRB size + field offsets
  // ============================================================================

  pub let XHCI_TRB_SIZE             : u64 = 16
  pub let XHCI_TRB_OFF_PARAM        : u64 = 0     // u64
  pub let XHCI_TRB_OFF_STATUS       : u64 = 8     // u32
  pub let XHCI_TRB_OFF_CONTROL      : u64 = 12    // u32

  // ============================================================================
  // Control-word bit shifts (xHCI 1.2 §4.11.1)
  // ============================================================================

  pub let XHCI_TRB_CTL_C            : u64 = 0x00000001   // Cycle bit
  pub let XHCI_TRB_CTL_ENT          : u64 = 0x00000002   // Evaluate Next TRB
  pub let XHCI_TRB_CTL_ISP          : u64 = 0x00000004   // Int on Short Packet
  pub let XHCI_TRB_CTL_CH           : u64 = 0x00000010   // Chain Bit
  pub let XHCI_TRB_CTL_IOC          : u64 = 0x00000020   // Int on Completion
  pub let XHCI_TRB_CTL_IDT          : u64 = 0x00000040   // Immediate Data

  // Link TRB has TC (Toggle Cycle) at bit 1 (same slot as ENT for
  // transfer TRBs — TRB Type disambiguates).
  pub let XHCI_TRB_CTL_LINK_TC      : u64 = 0x00000002

  // TRB Type field: bits [15:10] of the control word. Callers compose
  // control_no_cycle as `(type << 10) | other_flags`.
  pub let XHCI_TRB_TYPE_SHIFT       : u64 = 10

  // ============================================================================
  // TRB Type constants (xHCI 1.2 §6.4.6, Table 6-91)
  // ============================================================================

  // Transfer ring TRB types.
  pub let XHCI_TRB_TYPE_NORMAL           : u64 = 1
  pub let XHCI_TRB_TYPE_SETUP_STAGE      : u64 = 2
  pub let XHCI_TRB_TYPE_DATA_STAGE       : u64 = 3
  pub let XHCI_TRB_TYPE_STATUS_STAGE     : u64 = 4
  pub let XHCI_TRB_TYPE_LINK             : u64 = 6
  pub let XHCI_TRB_TYPE_EVENT_DATA       : u64 = 7
  pub let XHCI_TRB_TYPE_NOOP             : u64 = 8

  // Command ring TRB types.
  pub let XHCI_TRB_TYPE_ENABLE_SLOT      : u64 = 9
  pub let XHCI_TRB_TYPE_DISABLE_SLOT     : u64 = 10
  pub let XHCI_TRB_TYPE_ADDRESS_DEVICE   : u64 = 11
  pub let XHCI_TRB_TYPE_CONFIGURE_EP     : u64 = 12
  pub let XHCI_TRB_TYPE_EVALUATE_CTX     : u64 = 13
  pub let XHCI_TRB_TYPE_RESET_EP         : u64 = 14
  pub let XHCI_TRB_TYPE_STOP_EP          : u64 = 15
  pub let XHCI_TRB_TYPE_SET_TR_DEQ_PTR   : u64 = 16
  pub let XHCI_TRB_TYPE_RESET_DEVICE     : u64 = 17
  pub let XHCI_TRB_TYPE_NOOP_CMD         : u64 = 23

  // Event ring TRB types.
  pub let XHCI_TRB_TYPE_TRANSFER_EVENT       : u64 = 32
  pub let XHCI_TRB_TYPE_CMD_COMPLETION_EVENT : u64 = 33
  pub let XHCI_TRB_TYPE_PORT_STATUS_EVENT    : u64 = 34

  // ============================================================================
  // trb_write(dst_pa, param, status, control_no_cycle, cycle_bit) -> ()
  // ============================================================================
  //
  // SysV: (dst_pa: u64, param: u64, status: u64, control_no_cycle: u64, cycle_bit: u64) -> ()
  //   rdi = destination TRB physical address (16-byte aligned)
  //   rsi = Parameter field (u64 semantics)
  //   rdx = Status field   (u32 semantics; upper bits ignored)
  //   rcx = Control-word bits EXCLUDING the Cycle bit (u32 semantics)
  //   r8  = Cycle bit value (0 or 1 — masked to bit 0 here)
  //
  // Body:
  //   (1) mfence — ensure prior WB stores drain before the TRB write.
  //   (2) Store Parameter (u64 @ +0) — plain 64-bit store, REX.W width.
  //   (3) Store Status (u32 @ +8) — mov_d to avoid REX.W widening.
  //   (4) mfence — order the +0/+8 stores before the +12 publish.
  //   (5) Compose ctl = control_no_cycle | (cycle_bit & 1).
  //   (6) Store Control (u32 @ +12) LAST — this is the publish edge.
  //   (7) mfence — publication visible to consumers before return.
  //
  // Leaf function — no callee-save clobber, no prologue.

  pub let trb_write : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (dst_pa: u64, param: u64, status: u64, control_no_cycle: u64, cycle_bit: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M2-001 (#946). 16-byte TRB write with producer-safe Cycle-bit-last ordering per xHCI 1.2 §4.9.4. Body: (1) mfence-before drains prior WB stores (SDM Vol 3A §11.3.1). (2) Store Parameter u64 at rdi+0 via plain `mov [rdi+0], rsi` — 8-byte width matches REX.W so no G1 widening risk. (3) Store Status u32 at rdi+8 via `mov_d [rdi+8], rdx` — G1 sized store prevents REX.W widening (would smash the +12 slot). (4) mfence-mid orders the +0/+8 stores before the Cycle-bit publish (WB→WB is TSO on x86 but xHC DMA reads are UC-aliased; belt+suspenders here matches R22.M5 IRTE discipline). (5) Compose control = rcx | (r8 & 1). Use `and r8, 1` then `or rcx, r8`; store rcx via `mov_d [rdi+12], rcx`. (6) mfence-after publishes the +12 store globally before the caller can advance the enqueue pointer. Leaf, no prologue.",
      block: {
        // (1) mfence-before.
        mfence;

        // (2) Parameter u64 @ +0.
        mov [rdi + 0], rsi;

        // (3) Status u32 @ +8 — G1 sized store.
        mov_d [rdi + 8], rdx;

        // (4) mfence-mid.
        mfence;

        // (5) Compose control = control_no_cycle | (cycle_bit & 1).
        and r8, 1;
        or  rcx, r8;

        // (6) Control u32 @ +12 — the publish edge.
        mov_d [rdi + 12], rcx;

        // (7) mfence-after.
        mfence;
        ret
      }
    }
}
