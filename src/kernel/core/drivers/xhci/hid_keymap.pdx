// src/kernel/core/drivers/xhci/hid_keymap.pdx — R26-M6-001 (#965)
//
// USB HID Usage Page 0x07 (Keyboard/Keypad) -> ASCII byte translation.
//
// -----------------------------------------------------------------------------
// Table shape
// -----------------------------------------------------------------------------
//
// Two 256-byte lookup tables, indexed by usage code (0..255):
//
//   _hid_us_keymap          : base (unshifted) US-layout translation.
//   _hid_us_keymap_shifted  : same, but with Left/Right Shift held.
//
// Value 0 means "no printable ASCII" (either reserved/undefined usage
// code, or a non-character key like a function key). The R26.M6 bridge
// is byte-oriented — a caller that sees 0 skips the event rather than
// injecting a NUL into the TTY line buffer (which tty_line_append
// would append verbatim, corrupting shell parsing).
//
// -----------------------------------------------------------------------------
// Populated range (0x00..0x38)
// -----------------------------------------------------------------------------
//
//   0x00..0x03  reserved / rollover errors           -> 0
//   0x04..0x1D  Keyboard a..z                        -> 'a'..'z' / 'A'..'Z'
//   0x1E..0x26  Keyboard 1..9                        -> '1'..'9' / '!'..'('
//   0x27        Keyboard 0                           -> '0' / ')'
//   0x28        Keyboard Return (Enter)              -> '\n' (LF)
//   0x29        Keyboard Escape                      -> 0x1B
//   0x2A        Keyboard Backspace                   -> 0x08
//   0x2B        Keyboard Tab                         -> 0x09
//   0x2C        Keyboard Space                       -> 0x20
//   0x2D        Keyboard - and _                     -> '-' / '_'
//   0x2E        Keyboard = and +                     -> '=' / '+'
//   0x2F        Keyboard [ and {                     -> '[' / '{'
//   0x30        Keyboard ] and }                     -> ']' / '}'
//   0x31        Keyboard \ and |                     -> '\' / '|'
//   0x32        Keyboard non-US # and ~              -> '#' / '~'  (US-layout
//                                                                   aliases to
//                                                                   0x33 pair)
//   0x33        Keyboard ; and :                     -> ';' / ':'
//   0x34        Keyboard ' and "                     -> '\'' / '"'
//   0x35        Keyboard ` and ~                     -> '`' / '~'
//   0x36        Keyboard , and <                     -> ',' / '<'
//   0x37        Keyboard . and >                     -> '.' / '>'
//   0x38        Keyboard / and ?                     -> '/' / '?'
//   0x39+       CapsLock, F1..F12, Nav, Keypad, ...  -> 0 (R27+)
//
// -----------------------------------------------------------------------------
// Modifier byte (USB HID Boot Keyboard §B.1)
// -----------------------------------------------------------------------------
//
//   bit 0  Left Ctrl
//   bit 1  Left Shift     <- consulted for shift table select
//   bit 2  Left Alt
//   bit 3  Left GUI
//   bit 4  Right Ctrl
//   bit 5  Right Shift    <- consulted for shift table select
//   bit 6  Right Alt
//   bit 7  Right GUI
//
// hid_translate consults (modifiers & 0x22) — either shift bit routes
// to the shifted table. CapsLock is a lock key (usage 0x39, R27+) and
// does not participate in this MVP path.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: zero-extended u8 load for the keymap-index step.
//
// Reserved-label discipline: `hid_kt_` (keymap translate).

module HidKeymap = structure {

  // ============================================================================
  // Modifier bitmask for either Shift key.
  // ============================================================================

  pub let HID_MOD_SHIFT_MASK : u64 = 0x22    // bit 1 | bit 5

  // ============================================================================
  // Base (unshifted) US keymap — 256 bytes.
  // ============================================================================

  pub let _hid_us_keymap : [u8; 256] = [
    // 0x00..0x0F — reserved(4) + a..k
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x61u8, 0x62u8, 0x63u8, 0x64u8,
    0x65u8, 0x66u8, 0x67u8, 0x68u8, 0x69u8, 0x6Au8, 0x6Bu8, 0x6Cu8,
    // 0x10..0x1F — m..z (14), 1..2 (2 of 10)
    0x6Du8, 0x6Eu8, 0x6Fu8, 0x70u8, 0x71u8, 0x72u8, 0x73u8, 0x74u8,
    0x75u8, 0x76u8, 0x77u8, 0x78u8, 0x79u8, 0x7Au8, 0x31u8, 0x32u8,
    // 0x20..0x2F — 3..9, 0, Enter, Esc, BS, Tab, Space, -, =, [
    0x33u8, 0x34u8, 0x35u8, 0x36u8, 0x37u8, 0x38u8, 0x39u8, 0x30u8,
    0x0Au8, 0x1Bu8, 0x08u8, 0x09u8, 0x20u8, 0x2Du8, 0x3Du8, 0x5Bu8,
    // 0x30..0x3F — ], \, #(non-US), ;, ', `, ,, ., /, CapsLock, F1..F6
    0x5Du8, 0x5Cu8, 0x23u8, 0x3Bu8, 0x27u8, 0x60u8, 0x2Cu8, 0x2Eu8,
    0x2Fu8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x40..0x4F — F7..F12, PrtSc, ScrollLock, Pause, Ins, Home, PgUp, Del, End
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x50..0x5F — arrows / numlock / keypad ops
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x60..0x6F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x70..0x7F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x80..0x8F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x90..0x9F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xA0..0xAF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xB0..0xBF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xC0..0xCF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xD0..0xDF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xE0..0xEF (modifier keys — no ASCII produced here)
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xF0..0xFF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8
  ]

  // ============================================================================
  // Shifted (US) keymap — 256 bytes.
  // ============================================================================

  pub let _hid_us_keymap_shifted : [u8; 256] = [
    // 0x00..0x0F — reserved(4) + A..K
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x41u8, 0x42u8, 0x43u8, 0x44u8,
    0x45u8, 0x46u8, 0x47u8, 0x48u8, 0x49u8, 0x4Au8, 0x4Bu8, 0x4Cu8,
    // 0x10..0x1F — M..Z, ! @
    0x4Du8, 0x4Eu8, 0x4Fu8, 0x50u8, 0x51u8, 0x52u8, 0x53u8, 0x54u8,
    0x55u8, 0x56u8, 0x57u8, 0x58u8, 0x59u8, 0x5Au8, 0x21u8, 0x40u8,
    // 0x20..0x2F — # $ % ^ & * ( ), Enter, Esc, BS, Tab, Space, _ + {
    0x23u8, 0x24u8, 0x25u8, 0x5Eu8, 0x26u8, 0x2Au8, 0x28u8, 0x29u8,
    0x0Au8, 0x1Bu8, 0x08u8, 0x09u8, 0x20u8, 0x5Fu8, 0x2Bu8, 0x7Bu8,
    // 0x30..0x3F — } | ~ : " ~ < > ? CapsLock F1..F6
    0x7Du8, 0x7Cu8, 0x7Eu8, 0x3Au8, 0x22u8, 0x7Eu8, 0x3Cu8, 0x3Eu8,
    0x3Fu8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x40..0x4F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x50..0x5F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x60..0x6F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x70..0x7F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x80..0x8F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0x90..0x9F
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xA0..0xAF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xB0..0xBF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xC0..0xCF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xD0..0xDF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xE0..0xEF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    // 0xF0..0xFF
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8,
    0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8
  ]

  // ============================================================================
  // hid_translate(usage: u8, modifiers: u8) -> u8
  // ============================================================================
  //
  // SysV: rdi = usage code (low 8 bits used), rsi = modifiers byte.
  // Returns rax = ASCII byte (0 if unmapped / non-printable).
  //
  // Body:
  //   (1) Mask usage to low 8 bits (rdi & 0xFF -> rax).
  //   (2) Test (modifiers & 0x22): shift table if nonzero, base otherwise.
  //   (3) lea table_base; add rax = index; zero-extended byte load -> rax.
  //
  // Leaf function — no callee-save, no stack frame.

  pub let hid_translate : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (usage: u64, modifiers: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M6-001 (#965). USB HID Usage Page 0x07 -> ASCII translation. Body: (1) mov rax, rdi; and rax, 0xFF — isolate 8-bit usage code. (2) mov rcx, rsi; and rcx, 0x22 (HID_MOD_SHIFT_MASK — bit 1 Left Shift | bit 5 Right Shift); cmp rcx, 0; je hid_kt_base to route unshifted vs shifted table. (3) hid_kt_shift path: lea rdx, [rip + _hid_us_keymap_shifted]; jmp hid_kt_load. (4) hid_kt_base path: lea rdx, [rip + _hid_us_keymap]. (5) hid_kt_load: add rdx, rax (byte index into the 256 B table); xor rax, rax; mov_b rax, [rdx] — G1 zero-extended u8 load. (6) ret. Leaf per graph — no callee-save, no frame. The returned 0 for unmapped codes is a caller contract (see hid_process_report — 0 means 'skip event, do not push into TTY line buffer'). Reserved labels: `hid_kt_`.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;

        mov rcx, rsi;
        and rcx, 0x22;
        cmp rcx, 0;
        je  hid_kt_base;

        lea rdx, [rip + _hid_us_keymap_shifted];
        jmp hid_kt_load;

      hid_kt_base:
        lea rdx, [rip + _hid_us_keymap];

      hid_kt_load:
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx];
        ret
      }
    } @no_frame
}
