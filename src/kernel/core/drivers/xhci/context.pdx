// src/kernel/core/drivers/xhci/context.pdx — R26-M3-004 (#954)
//
// xHCI Device Context data structures — Input Context (Input Control
// Context + Slot Context + up to 31 Endpoint Contexts) that the driver
// hands to the HC via Address Device / Configure Endpoint commands to
// describe a device slot's shape.
//
// -----------------------------------------------------------------------------
// Input Context layout (xHCI 1.2 §6.2.5)
// -----------------------------------------------------------------------------
//
// Assuming 32-byte contexts (HCCPARAMS1.CSZ = 0 — QEMU q35 xhci and
// every commodity Intel/AMD xhci fixture we care about at boot):
//
//   +0x000  Input Control Context   (32 B)
//             DW0  drop_flags        — bitmap; bit N clears Slot/EPn ctx
//             DW1  add_flags         — bitmap; bit N asserts Slot/EPn ctx
//                                       bit 0 = Slot Context (A0)
//                                       bit 1 = EP0 Context  (A1)
//                                       bit N = EP(N-1) IN/OUT (N≥2)
//             DW2..7 reserved
//
//   +0x020  Slot Context            (32 B — first Device Context slot)
//             DW0
//               [19:0]   Route String            — parent-hub route
//               [23:20]  Speed                   — 1..4 (see ports.pdx)
//               [25]     MTT                     — multi-TT hub
//               [26]     Hub                     — device is a hub
//               [31:27]  Context Entries         — highest valid EP DCI
//             DW1
//               [15:0]   Max Exit Latency
//               [23:16]  Root Hub Port Number    — 1-based
//               [31:24]  Number of Ports         — 0 for non-hubs
//             DW2..3 TT info + Interrupter Target + USB Device Address
//
//   +0x040  EP0 Context              (32 B)
//             DW0
//               [2:0]    EP State                — 0 = Disabled at init
//               [9:8]    Mult
//               [14:10]  Max PStreams
//               [15]     LSA
//               [23:16]  Interval
//               [31:24]  Max ESIT Payload Hi
//             DW1
//               [0]      Reserved
//               [2:1]    CErr                    — 3 = max retry
//               [5:3]    EP Type                 — 4 = Control Bidir
//               [7]      HID
//               [15:8]   Max Burst Size          — 0 for USB2
//               [31:16]  Max Packet Size         — speed-dependent
//             DW2..3   TR Dequeue Pointer + DCS
//             DW4      Average TRB Length + Max ESIT Payload Lo
//
//   +0x060  EP1..EP31 Contexts       (32 B each; unused at M3)
//
// Total Input Context size (CSZ=0): 33 * 32 = 1056 B. We provision 4096
// B per slot — comfortably 4x overhead, page-granular, and future-
// proof for CSZ=1 (which doubles context sizes to 64 B → 33 * 64 =
// 2112 B; still fits).
//
// -----------------------------------------------------------------------------
// Slot-indexed backing store
// -----------------------------------------------------------------------------
//
// _xhci_input_contexts is a 64 * 4096 B pool. Slot IDs are 1..MaxSlots
// (xHCI spec: slot 0 is the "no-slot" sentinel and never used for a
// real device). We over-provision slot 0 too so that the byte
// arithmetic `base + slot_id * 4096` stays branch-free, at the cost
// of one wasted page.
//
// The MVP slot cap of 64 matches xhci_reset's XHCI_MAX_SLOTS_MVP; the
// two constants must move together — the pool sizing here caps
// downstream slot allocation.
//
// -----------------------------------------------------------------------------
// EP0 Max Packet Size defaults (Address Device with BSR=1 path)
// -----------------------------------------------------------------------------
//
// After a port reset the negotiated speed is known but the device's
// actual EP0 MPS is not — it lives in the device descriptor which we
// can only fetch AFTER the device has an address. We seed a
// speed-conservative default:
//
//   Low-speed  (2)  → 8    (spec-mandated: LS has fixed EP0 MPS = 8)
//   SuperSpeed (4)  → 512  (spec-mandated: SS/SSP has fixed EP0 MPS = 512)
//   Full/High (1/3) → 64   (spec allows 8/16/32/64 for FS; 64 for HS;
//                            we default to 64 and correct via SET_MAX_
//                            PACKET on the FS-with-actual-MPS-≠-64 case
//                            once the device descriptor is fetched.
//                            Linux xhci does the same via
//                            xhci_change_max_packet.)
//
// Matches Linux drivers/usb/host/xhci-mem.c xhci_get_max_esit_payload +
// xhci_setup_addressable_virt_dev.
//
// -----------------------------------------------------------------------------
// R26.M3 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// xhci_input_context_init is a symbol at M3, never called under
// BIOS/-kernel boot. Real invocations gate on port_reset + enable_slot
// success chained during driver-attach at R26.M4+.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sized u32 stores via mov_d for DW writes.
//
// Reserved-label discipline: `xhci_ic_` prefix.

module Context = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let XHCI_INPUT_CTX_STRIDE     : u64 = 4096     // per-slot page
  pub let XHCI_MAX_SLOTS_INPUT      : u64 = 64       // MVP cap

  // Input Control Context sub-region offsets (within a slot's 4 KiB).
  pub let XHCI_ICC_OFF              : u64 = 0
  pub let XHCI_ICC_DROP             : u64 = 0        // DW0
  pub let XHCI_ICC_ADD              : u64 = 4        // DW1

  // Slot Context sub-region offsets.
  pub let XHCI_SLOT_CTX_OFF         : u64 = 32
  pub let XHCI_SLOT_DW0             : u64 = 32
  pub let XHCI_SLOT_DW1             : u64 = 36
  pub let XHCI_SLOT_DW2             : u64 = 40
  pub let XHCI_SLOT_DW3             : u64 = 44

  // EP0 Context sub-region offsets.
  pub let XHCI_EP0_CTX_OFF          : u64 = 64
  pub let XHCI_EP0_DW0              : u64 = 64
  pub let XHCI_EP0_DW1              : u64 = 68
  pub let XHCI_EP0_DW2              : u64 = 72       // TR Dequeue Pointer lo
  pub let XHCI_EP0_DW3              : u64 = 76       // TR Dequeue Pointer hi
  pub let XHCI_EP0_DW4              : u64 = 80

  // Input Control Context add_flags bits.
  pub let XHCI_ICC_ADD_A0_SLOT      : u64 = 0x1      // Slot Context
  pub let XHCI_ICC_ADD_A1_EP0       : u64 = 0x2      // EP0 Context

  // Slot Context DW0 field shifts.
  pub let XHCI_SLOT_DW0_SPEED_SHIFT : u64 = 20
  pub let XHCI_SLOT_DW0_CTX_ENTRIES_SHIFT : u64 = 27

  // EP0 Context DW1 encoding constants.
  pub let XHCI_EP_TYPE_CONTROL      : u64 = 4        // Control EP (bidir)
  pub let XHCI_EP0_DW1_BASE         : u64 = 0x26     // (CErr=3 << 1) | (EP Type=4 << 3)
                                                     //   = 0x6 | 0x20 = 0x26
  pub let XHCI_EP0_MPS_LOW          : u64 = 8
  pub let XHCI_EP0_MPS_FS_HS        : u64 = 64
  pub let XHCI_EP0_MPS_SUPER        : u64 = 512
  pub let XHCI_EP0_AVG_TRB_LEN      : u64 = 8        // conservative default

  // ============================================================================
  // Canonical .bss storage
  // ============================================================================
  //
  //   _xhci_input_contexts : 64 * 4096 B = 262 144 B = 32 768 u64s.
  //                          @align(4096) — per-slot page is page-
  //                          aligned so xhci_input_context_ptr can
  //                          derive DMA-safe PA via identity map.

  pub let mut _xhci_input_contexts : [u64; 32768] = uninit @align(4096)

  // ============================================================================
  // xhci_input_context_ptr(slot_id) -> u64
  // ============================================================================
  //
  // SysV: (slot_id: u64) -> u64
  //   rdi = slot_id (1..64; slot 0 is the "no-slot" sentinel)
  //
  // Returns rax = virtual address of the input context for that slot.
  // Under the boot-stub identity map, VA == PA, so the return value is
  // also the PA the caller feeds to Address Device.
  //
  // Body:
  //   (1) base = &_xhci_input_contexts
  //   (2) offset = slot_id * 4096 = slot_id << 12
  //   (3) return base + offset
  //
  // Leaf function. No callee-save, no prologue.

  pub let xhci_input_context_ptr : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (slot_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-004 (#954). Return VA of the per-slot input context page. Body: (1) lea rax, [rip + _xhci_input_contexts] — RIP-relative anchor (identity-mapped so VA==PA under the boot stub). (2) shl rdi, 12 — multiply slot_id by 4096 (page stride). (3) add rax, rdi. (4) ret. Leaf — no callee-save, no prologue, no stack. Trusted caller: slot_id ∈ [0, 64) is a driver-side precondition; out-of-range indices index into subsequent .bss and would corrupt neighbor state.",
      block: {
        lea rax, [rip + _xhci_input_contexts];
        shl rdi, 12;
        add rax, rdi;
        ret
      }
    }

  // ============================================================================
  // xhci_input_context_init(slot_id, root_hub_port, speed) -> ()
  // ============================================================================
  //
  // SysV: (slot_id: u64, root_hub_port: u64, speed: u64) -> ()
  //   rdi = slot_id
  //   rsi = root_hub_port (1-based)
  //   rdx = speed (1..4 from xhci_port_reset)
  //
  // Body:
  //   (1) ctx_va = xhci_input_context_ptr(slot_id).
  //   (2) rep_stosb-zero 4096 B — every field starts at spec default.
  //   (3) Input Control Context:
  //         drop_flags @+0  = 0        (nothing to drop on a fresh slot)
  //         add_flags  @+4  = A0 | A1  = 0x3 (Slot Context + EP0 Context)
  //   (4) Slot Context DW0 @+32:
  //         route_string   [19:0] = 0     (root-hub direct attach)
  //         speed          [23:20] = speed
  //         context_entries[31:27] = 1     (EP0 only)
  //       Slot Context DW1 @+36:
  //         root_hub_port  [23:16] = root_hub_port
  //         num_ports      [31:24] = 0
  //       DW2..3 stay zero (no TT, no assigned USB address yet).
  //   (5) EP0 Context DW1 @+68:
  //         CErr=3, EP Type=4 (Control), Max Packet Size by speed.
  //       DW2..3 (TR Dequeue Pointer) stay 0 — transfer-ring allocation
  //       lands at R26.M4. Address Device with BSR=1 tolerates a zero
  //       TR pointer because no SETUP transaction is issued.
  //       DW4: Average TRB Length = 8 (conservative non-zero — some
  //       HCs error on 0).
  //
  // Register plan (5-push callee-save):
  //   rbx = ctx_va                (survives every nested call)
  //   rbp = scratch
  //   r12 = slot_id (temporarily)
  //   r13 = root_hub_port
  //   r14 = speed
  //
  //   5 pushes = 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for
  //   xhci_input_context_ptr + rep_stosb without extra pad).

  pub let xhci_input_context_init : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (slot_id: u64, root_hub_port: u64, speed: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-004 (#954). Populate Input Control + Slot + EP0 contexts with Address-Device-ready defaults per xHCI 1.2 §6.2.2 / §6.2.3 / §6.2.5. Body: (1) 5-push callee-save (rbx=ctx_va, rbp=scratch, r12=slot_id/unused-after-init, r13=root_hub_port, r14=speed) — 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every nested call). (2) Stash args in r12/r13/r14 (rsi/rdx would get clobbered by xhci_input_context_ptr's call setup, but actually only rdi is passed — still, uniform stashing is cleaner). ctx_va = xhci_input_context_ptr(slot_id): mov rdi,r12; call -> rax. rbx=rax. (3) rep_stosb-zero 4096 B: rdi=rbx; xor rax,rax; mov rcx,4096; cld; rep_stosb. Clobbers rdi/rax/rcx; rbx/r13/r14 survive per SysV. (4) Input Control Context: drop_flags @+0 is already zero. add_flags @+4 = 0x3 (A0=Slot | A1=EP0): mov rax,3; mov_d [rbx+4],rax. (5) Slot Context DW0 @+32 = (speed << 20) | (1 << 27): mov rax,r14; shl rax,20; or rax,0x08000000; mov_d [rbx+32],rax. context_entries=1 means EP0 is the highest valid DCI (Device Context Index) — matches an M3 slot with no I/O endpoints. (6) Slot Context DW1 @+36 = root_hub_port << 16: mov rax,r13; shl rax,16; mov_d [rbx+36],rax. Max Exit Latency and Number of Ports both 0. (7) EP0 Context DW1 @+68: compute MPS by speed (Low=8, Super=512, else=64). base = 0x26 (CErr=3 | EP Type=Control). Assembled: (MPS << 16) | 0x26. mov_d [rbx+68],rax. (8) EP0 Context DW4 @+80 = Average TRB Length = 8: mov rax,8; mov_d [rbx+80],rax. DW0/DW2/DW3 stay zero (EP State=Disabled at HC init, TR Dequeue Pointer null — Address Device with BSR=1 does not fetch from it). Reserved labels: `xhci_ic_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                            // slot_id
        mov r13, rsi;                            // root_hub_port
        mov r14, rdx;                            // speed

        // (1) ctx_va = xhci_input_context_ptr(slot_id).
        mov rdi, r12;
        call xhci_input_context_ptr;
        mov rbx, rax;                            // rbx = ctx_va

        // (2) Zero the 4096-byte input-context page.
        mov rdi, rbx;
        xor rax, rax;
        mov rcx, 4096;
        cld;
        rep_stosb;

        // (3) Input Control Context — add_flags = A0 | A1 = 0x3.
        //     drop_flags @+0 stays 0.
        mov rax, 3;
        mov_d [rbx + 4], rax;

        // (4) Slot Context DW0 @+32 = (speed << 20) | (1 << 27).
        mov rax, r14;
        shl rax, 20;
        or  rax, 0x08000000;                     // context_entries = 1
        mov_d [rbx + 32], rax;

        // (5) Slot Context DW1 @+36 = root_hub_port << 16.
        mov rax, r13;
        shl rax, 16;
        mov_d [rbx + 36], rax;

        // (6) EP0 Context DW1 @+68: (MPS << 16) | 0x26.
        //     MPS default by speed:
        //       Low  (2)  -> 8
        //       Super(4)  -> 512
        //       else      -> 64
        mov rax, 64;
        cmp r14, 4;
        jne xhci_ic_check_low;
        mov rax, 512;
        jmp xhci_ic_mps_done;
      xhci_ic_check_low:
        cmp r14, 2;
        jne xhci_ic_mps_done;
        mov rax, 8;
      xhci_ic_mps_done:
        shl rax, 16;
        or  rax, 0x26;                           // CErr=3 | EP Type=Control
        mov_d [rbx + 68], rax;

        // (7) EP0 Context DW4 @+80 = Average TRB Length = 8.
        mov rax, 8;
        mov_d [rbx + 80], rax;

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
