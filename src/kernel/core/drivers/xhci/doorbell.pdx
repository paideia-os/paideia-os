// src/kernel/core/drivers/xhci/doorbell.pdx — R26-M2-005 (#950)
//
// xHCI Doorbell array writes — Doorbell 0 is the host-controller
// command-ring doorbell; Doorbell N (N > 0) is Device Context N's
// per-endpoint doorbell.
//
// -----------------------------------------------------------------------------
// Doorbell layout (xHCI 1.2 §5.6)
// -----------------------------------------------------------------------------
//
// The Doorbell Array begins at BAR0 + DBOFF (u32 from the Capability
// window @ +0x14; the low 2 bits are reserved and must be masked). Each
// doorbell is a u32 slot:
//
//   DB[0]      Host Controller Doorbell
//                bits [7:0]   DB Target (must be 0 for the command ring)
//                bits [31:16] DB Stream ID (must be 0 for the command ring)
//   DB[1..N]   Device Slot N Doorbell
//                bits [7:0]   DB Target
//                                1..31   Endpoint DCI (Data Context Index)
//                bits [31:16] DB Stream ID (streams-mode endpoints only)
//
// Writing DB[0] with value 0 rings the command-ring doorbell — the HC
// then walks the command ring from CRCR to consume any newly-enqueued
// TRB whose Cycle bit matches its expected cycle state.
//
// -----------------------------------------------------------------------------
// Ordering discipline
// -----------------------------------------------------------------------------
//
// The doorbell write must happen AFTER the TRB itself is visible in
// memory. trb_write already mfence-brackets the TRB store; the doorbell
// accessor adds its own mfence-before to enforce the boundary at the
// call-site level — this pairs correctly even when a caller enqueues
// multiple TRBs before a single doorbell ring.
//
// -----------------------------------------------------------------------------
// R26.M2 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// No real xHC under BIOS/-kernel means this function is never called
// at boot. Symbol exists for R26.M3 driver-attach + subsequent phases.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: xhci_mmio_write_u32 already uses mov_d internally.
//
// Reserved-label discipline: `xhci_db_`.

module Doorbell = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let XHCI_DB_HOST_CONTROLLER   : u64 = 0        // DB[0]
  pub let XHCI_DB_CMD_RING_VALUE    : u64 = 0        // Target=0, Stream=0

  // ============================================================================
  // xhci_ring_cmd_doorbell(bar0) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64) -> ()
  //   rdi = BAR0 base (page-aligned MMIO)
  //
  // Body:
  //   (1) Read DBOFF (u32 @ bar0 + 0x14) → mask the low 2 reserved bits.
  //   (2) Compute db0_addr = bar0 + (DBOFF & ~0x3).
  //   (3) Write 0 to db0_addr via xhci_mmio_write_u32 — the accessor
  //       mfence-brackets, so a caller-visible mfence-before is implicit
  //       via trb_write's mfence-after.
  //
  // Register plan (2-push callee-save):
  //   rbx = bar0 (survives xhci_cap_u32 call)
  //   rbp = db0_addr (scratch)
  //
  //   2 pushes = 16 B; entry rsp%16==8 -> 24, sub rsp,8 -> 32,
  //   %16==0 (aligned for xhci_cap_u32 + xhci_mmio_write_u32).

  pub let xhci_ring_cmd_doorbell : (u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M2-005 (#950). Ring DB[0] (host-controller command-ring doorbell) per xHCI 1.2 §5.6. Body: (1) 2-push callee-save prologue (rbx=bar0, rbp=db0_addr) + sub rsp,8 for alignment — 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for xhci_cap_u32 + xhci_mmio_write_u32 nested calls). (2) Read DBOFF (u32 @ bar0+0x14) via xhci_cap_u32; mask low 2 reserved bits via `and rax, ~0x3` = and with 0xFFFFFFFFFFFFFFFC (sign-extended imm32 pattern that mirrors nvme_reset). (3) db0_addr = bar0 + masked_dboff. Save in rbp. (4) Write 0 to db0_addr via xhci_mmio_write_u32(db0_addr, 0). The accessor's internal mfence-before pairs with any prior trb_write's mfence-after to enforce TRB-visible-before-doorbell ordering across the caller boundary. (5) Return. Reserved labels: `xhci_db_`.",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                            // rbx = bar0

        // (1) Read DBOFF.
        mov rdi, rbx;
        mov rsi, 20;                             // XHCI_CAP_DBOFF = 0x14
        call xhci_cap_u32;

        // (2) Mask low 2 reserved bits.
        and rax, 0xFFFFFFFFFFFFFFFC;

        // (3) db0_addr = bar0 + dboff.
        mov rbp, rbx;
        add rbp, rax;

        // (4) Write 0 to DB[0].
        mov rdi, rbp;
        xor rsi, rsi;                            // val = 0
        call xhci_mmio_write_u32;

        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
