// src/kernel/core/drivers/xhci/configure_ep.pdx — R26-M4-003 (#958)
//
// xHCI Configure Endpoint command — configure the slot's endpoints
// (mark them Running / Halted / etc.) per xHCI 1.2 §4.6.6 / §6.4.3.5.
//
// The R26.M4 MVP implements exactly ONE variant of Configure Endpoint:
// setting up EP1 IN as an Interrupt endpoint for a boot HID keyboard.
// Every other endpoint variant (bulk IN/OUT, isoc IN/OUT, higher-DCI
// interrupt endpoints) shares the same command-sequence shape and gets
// its own configure_ep_* helper in R26.M6+.
//
// -----------------------------------------------------------------------------
// EP1 IN → Device Context Index 3
// -----------------------------------------------------------------------------
//
// The Device Context (and Input Context) reserves 32-byte slots by
// endpoint DCI (§6.2.3.1 Table 6-16):
//
//   DCI 0    Slot Context
//   DCI 1    EP0 (Control, bidirectional)
//   DCI 2    EP1 OUT
//   DCI 3    EP1 IN            ←  our target
//   DCI 4    EP2 OUT
//   ...      DCI = 2*ep + dir_in
//                    dir_in = 1 for IN, 0 for OUT
//
// So EP1 IN maps to DCI 3. Its Endpoint Context slot in the Input
// Context lives at:
//
//   ic_base + 0x20 (Slot Context/DCI 0) + DCI * 0x20
//        = ic_base + 0x20 + 3*0x20
//        = ic_base + 0x80
//
// (The 0x20 prefix skips the Input Control Context.)
//
// -----------------------------------------------------------------------------
// Input Control Context add_flags (§6.2.5.1)
// -----------------------------------------------------------------------------
//
// For Configure Endpoint the driver sets:
//   add_flags bit 0  (A0)  = 1  — Slot Context is being updated (we bump
//                                Context Entries from 1 to 3).
//   add_flags bit 3  (A3)  = 1  — EP1 IN Context is being added.
//
// So add_flags = (1 << 0) | (1 << 3) = 0x9.
//
// drop_flags stays 0 — no endpoints are being removed.
//
// -----------------------------------------------------------------------------
// Slot Context DW0 patch
// -----------------------------------------------------------------------------
//
// M3's xhci_input_context_init seeded Slot DW0 with Context Entries = 1
// (EP0 only). Configure Endpoint updates the Slot Context, so we must
// re-publish DW0 with Context Entries = 3 (EP1 IN's DCI is 3 → highest
// valid DCI is 3):
//
//   DW0 &= 0x07FFFFFF        // clear bits [31:27]
//   DW0 |= (3 << 27)         // set Context Entries = 3
//
// Speed [23:20] and Route String [19:0] are preserved by the AND-mask
// so the HC continues to see the correct link parameters.
//
// -----------------------------------------------------------------------------
// EP1 IN Context layout (§6.2.3)
// -----------------------------------------------------------------------------
//
//   DW0 @ +0x80:
//     bits [ 2: 0]  EP State                 — 0 = Disabled at init
//     bits [ 9: 8]  Mult                     — 0
//     bits [14:10]  Max PStreams             — 0
//     bit  [15]     LSA                      — 0
//     bits [23:16]  Interval                 — log2(period / 125 µs)
//     bits [31:24]  Max ESIT Payload Hi      — 0
//   DW1 @ +0x84:
//     bit  [ 0]     Reserved
//     bits [ 2: 1]  CErr                     — 3 (max retry)
//     bits [ 5: 3]  EP Type                  — 7 = Interrupt IN
//     bit  [ 7]     HID                      — 0 (Endpoint HID flag)
//     bits [15: 8]  Max Burst Size           — 0
//     bits [31:16]  Max Packet Size          — 8 (boot keyboard)
//   DW2 @ +0x88:  TR Dequeue Pointer lo + DCS
//   DW3 @ +0x8C:  TR Dequeue Pointer hi
//   DW4 @ +0x90:
//     bits [15: 0]  Average TRB Length       — 8 (boot report size)
//     bits [31:16]  Max ESIT Payload Lo      — 0
//
// -----------------------------------------------------------------------------
// TR Dequeue Pointer + DCS
// -----------------------------------------------------------------------------
//
// The 64-bit TR Dequeue Pointer (DW2+DW3) carries:
//   bit  [   0]  DCS (Dequeue Cycle State) — HC's initial expected C bit
//   bits [63:4]  Ring PA (16-byte aligned)
//
// The transfer ring is 64-byte aligned (see transfer_ring.pdx) so its
// PA has bits [5:0] already zero — OR-ing 0x1 sets DCS without
// disturbing the pointer.
//
// -----------------------------------------------------------------------------
// max_packet_size + interval defaults (HID-specific)
// -----------------------------------------------------------------------------
//
// The task specification lists max_packet_size and interval as callee
// parameters. We hardcode boot-HID-keyboard defaults here (MPS=8,
// interval=3 → 8×125 µs = 1 ms polling for LS/FS, 2^3 microframes for
// HS+) because:
//
//   (a) This function is xhci_configure_ep_hid — HID is the target and
//       these are the USB HID Boot Protocol defaults.
//   (b) SysV integer register file is limited to 6 register args; the
//       existing (bar0, cmd_ctx, event_ctx, slot_id, input_ctx_pa,
//       transfer_ring_pa) exhausts it. Passing MPS/interval on the
//       stack introduces a new pdx pattern this codebase does not
//       currently exercise. Hardcoding keeps the ABI aligned with the
//       existing xhci_enable_slot / xhci_address_device shape.
//
// Non-HID variants of Configure Endpoint (bulk, isoc, non-boot HID)
// will land as sibling functions (xhci_configure_ep_bulk_in etc.) with
// their own default profiles at R26.M6+.
//
// -----------------------------------------------------------------------------
// Command TRB (xHCI 1.2 §6.4.3.5)
// -----------------------------------------------------------------------------
//
//   TRB Type         = 12
//   Parameter        = input_ctx_pa (64-byte-aligned Input Context PA)
//   Status           = 0
//   Control (no C)   = (12 << 10) | (Deconfigure=0 << 9) | (SlotID << 24)
//                    = 0x3000 | (SlotID << 24)
//
// Completion is a Command Completion Event (TRB Type 33) — same polling
// discipline as xhci_enable_slot / xhci_address_device / xhci_slot_disable.
//
// -----------------------------------------------------------------------------
// R26.M4 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// No HC under BIOS/`-kernel` boot → no port reset → no slot enable → no
// Configure Endpoint. Symbol exists for R26.M6+ HID bring-up.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sized u32 stores via mov_d for DW writes; u64 store for the
//       combined DW2+DW3 (TR Dequeue Pointer) via natural REX.W width.
//
// Reserved-label discipline: `xhci_ce_` (configure endpoint).

module ConfigureEp = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  // Input Control Context add_flags for Configure Endpoint on EP1 IN:
  //   A0 (Slot) | A3 (EP1 IN) = 0x1 | 0x8 = 0x9.
  pub let XHCI_CFG_EP_ADD_FLAGS      : u64 = 0x9

  // Slot Context DW0 Context Entries mask (bits 27..31).
  pub let XHCI_SLOT_DW0_CTX_ENTRIES_MASK : u64 = 0xF8000000

  // Slot Context Context Entries = 3 (EP1 IN is the highest valid DCI).
  pub let XHCI_SLOT_DW0_CTX_ENTRIES_3 : u64 = 0x18000000    // 3 << 27

  // EP1 IN Context offset within the Input Context:
  //   0x20 (Input Control Context) + DCI(3) * 0x20 = 0x80.
  pub let XHCI_EP1_IN_CTX_OFF        : u64 = 0x80

  // Per-DW offsets inside the EP1 IN Context.
  pub let XHCI_EP1_IN_DW0            : u64 = 0x80
  pub let XHCI_EP1_IN_DW1            : u64 = 0x84
  pub let XHCI_EP1_IN_DW2            : u64 = 0x88     // TR Dequeue lo + DCS
  pub let XHCI_EP1_IN_DW3            : u64 = 0x8C     // TR Dequeue hi
  pub let XHCI_EP1_IN_DW4            : u64 = 0x90

  // EP1 IN Context DW1 base:
  //   CErr=3 shift 1 = 0x6
  //   EP Type=7 (Interrupt IN) shift 3 = 0x38
  //   Combined = 0x3E.
  pub let XHCI_EP_TYPE_INTR_IN       : u64 = 7
  pub let XHCI_EP1_IN_DW1_BASE       : u64 = 0x3E

  // HID boot-keyboard defaults.
  pub let XHCI_HID_MAX_PACKET_SIZE   : u64 = 8
  pub let XHCI_HID_INTERVAL          : u64 = 3     // 2^3 microframes
  pub let XHCI_HID_AVG_TRB_LEN       : u64 = 8     // boot report size

  // Configure Endpoint command control (no cycle) base = (12 << 10) = 0x3000.
  pub let XHCI_CFG_EP_CTRL_NC_BASE   : u64 = 0x3000

  // Command-Completion-Event TRB type.
  pub let XHCI_TRB_TYPE_CCE          : u64 = 33

  // Completion Code SUCCESS.
  pub let XHCI_CC_SUCCESS            : u64 = 1

  // Event ring polling budget.
  pub let XHCI_CFG_EP_POLL_SPIN_MAX  : u64 = 5000000

  // Event ring segment size (single segment).
  pub let XHCI_EVT_SEG_TRBS          : u64 = 256

  // Return codes (mirror slot.pdx / slot_lifecycle.pdx).
  pub let XHCI_CFG_EP_OK             : u64 = 0
  pub let XHCI_CFG_EP_ERR_TYPE       : u64 = 1
  pub let XHCI_CFG_EP_ERR_TIMEOUT    : u64 = 2

  // Slot state CONFIGURED (mirrors slot_lifecycle.pdx).
  pub let XHCI_SLOT_STATE_CONFIGURED : u64 = 4

  // ============================================================================
  // xhci_configure_ep_hid(bar0, cmd_ctx, event_ctx, slot_id,
  //                       input_ctx_pa, transfer_ring_pa) -> u64
  // ============================================================================
  //
  // SysV: (bar0, cmd_ctx, event_ctx, slot_id, input_ctx_pa,
  //        transfer_ring_pa) -> u64
  //   rdi = BAR0 base
  //   rsi = cmd_ring_ctx pointer
  //   rdx = event_ring_ctx pointer
  //   rcx = slot ID (1..127)
  //   r8  = Input Context PA (64-byte-aligned)
  //   r9  = Transfer Ring PA (64-byte-aligned; EP1 IN Interrupt ring)
  //
  // Returns rax per "Return semantics" (0 / 1 / 2 / 0x100+CC).
  //
  // Body:
  //   Phase A — populate Input Context (uses r8=input_ctx_pa, r9=ring_pa).
  //   Phase B — enqueue Configure Endpoint TRB + doorbell.
  //   Phase C — poll event ring for CCE (SUCCESS/error).
  //   Phase D — on success set slot state to CONFIGURED.
  //
  // Register plan (6-push callee-save + 8 B align pad):
  //   rbx = bar0
  //   rbp = cmd_ctx
  //   r12 = event_ctx
  //   r13 = slot_id                    (preserved for control + state set)
  //   r14 = input_ctx_pa → trb_addr    (repurposed post-enqueue)
  //   r15 = transfer_ring_pa → expected cycle
  //                                    (repurposed post-Phase-A)
  //
  //   6 pushes = 48 B + sub rsp,8 = 56; entry rsp%16==8 -> 64, %16==0.

  pub let xhci_configure_ep_hid : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, cmd_ctx: u64, event_ctx: u64, slot_id: u64, input_ctx_pa: u64, transfer_ring_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M4-003 (#958). Configure Endpoint command sequence for EP1 IN Interrupt endpoint per xHCI 1.2 §4.6.6. Body: (1) 6-push callee-save (rbx=bar0, rbp=cmd_ctx, r12=event_ctx, r13=slot_id, r14=input_ctx_pa/trb_addr, r15=transfer_ring_pa/expected cycle) + sub rsp,8 align — 56 B; entry rsp%16==8 -> 64, %16==0 (aligned for every nested call). (2) Stash all 6 args. Phase A — populate Input Context (uses r14=input_ctx_pa, r15=transfer_ring_pa): (2a) Input Control Context add_flags @ input_ctx_pa+4 = 0x9 (A0|A3): mov rax,9; mov_d [r14+4],rax. drop_flags @+0 stays as M3 left it (0). (2b) Slot Context DW0 patch @ input_ctx_pa+32: RMW to bump Context Entries from 1 to 3 while preserving Speed [23:20] and Route String [19:0]: mov eax,[r14+32]; and rax,0x07FFFFFF (clear bits 27..31); or rax,0x18000000 (set 3<<27); mov_d [r14+32],rax. (2c) EP1 IN Context DW0 @ input_ctx_pa+0x80 = interval << 16 = 0x30000 (HID interval=3): mov rax,0x30000; mov_d [r14+0x80],rax. (2d) EP1 IN Context DW1 @ input_ctx_pa+0x84 = (MPS << 16) | 0x3E = (8<<16) | 0x3E = 0x8003E: mov rax,0x8003E; mov_d [r14+0x84],rax. Encodes CErr=3, EP Type=7 (Interrupt IN), Max Burst Size=0, Max Packet Size=8. (2e) TR Dequeue Pointer @ input_ctx_pa+0x88 (u64 spanning DW2+DW3) = transfer_ring_pa | 1 (DCS=1): mov rax,r15; or rax,1; mov [r14+0x88],rax. Ring is 64-byte aligned so bits [5:0] are 0; OR of 1 sets DCS without disturbing pointer. (2f) EP1 IN Context DW4 @ input_ctx_pa+0x90 = Average TRB Length = 8: mov rax,8; mov_d [r14+0x90],rax. Phase B — enqueue command: (3) Compose ctrl_no_cycle = 0x3000 | (slot_id << 24): mov rax,0x3000; mov rcx,r13; and rcx,0xFF; shl rcx,24; or rax,rcx. TRB Type=12 shifted left 10 = 0x3000; Deconfigure bit 9 = 0. (4) Enqueue: xhci_cmd_enqueue(cmd_ctx=rbp, param=input_ctx_pa=r14, status=0, ctrl_no_cycle=rax). (5) Ring DB[0]: xhci_ring_cmd_doorbell(rbx). Phase C — poll event ring: (6) r14 now becomes trb_addr = event_ring_va + dequeue_idx*16; r15 becomes expected cycle bit from event_ctx+18. (7) Spin poll (rax=5_000_000): cycle-match -> TRB Type check (== 33) -> Completion Code check (== 1). Same discipline as xhci_enable_slot. (8) On success: advance dequeue_idx (with segment wrap), then Phase D — set slot state to CONFIGURED: xhci_slot_state_set(slot_id=r13, state=4). Return 0. (9) Failure paths mirror xhci_enable_slot's return codes. Encoder: `mov [r14+0x88], rax` is natural REX.W 64-bit store (matches TR Dequeue Pointer DW2+DW3 spanning two consecutive 32-bit fields — the u64 store commits both atomically w.r.t. HC observation). Reserved labels: `xhci_ce_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // bar0
        mov rbp, rsi;                            // cmd_ctx
        mov r12, rdx;                            // event_ctx
        mov r13, rcx;                            // slot_id
        mov r14, r8;                             // input_ctx_pa
        mov r15, r9;                             // transfer_ring_pa

        // ================================================================
        // Phase A — populate Input Context.
        // ================================================================

        // (A1) Input Control Context add_flags @+4 = 0x9 (A0 | A3).
        //      drop_flags @+0 stays 0 (no endpoints being removed).
        mov rax, 9;
        mov_d [r14 + 4], rax;

        // (A2) Slot Context DW0 patch @+32 — bump Context Entries to 3.
        //      Preserve Speed [23:20] and Route String [19:0].
        mov eax, [r14 + 32];                     // read DW0 (u32, zero-ext)
        and rax, 0x07FFFFFF;                     // clear bits 27..31
        or  rax, 0x18000000;                     // Context Entries = 3
        mov_d [r14 + 32], rax;

        // (A3) EP1 IN Context DW0 @+0x80 = interval << 16 = 0x30000.
        mov rax, 0x30000;
        mov_d [r14 + 128], rax;                  // 0x80

        // (A4) EP1 IN Context DW1 @+0x84 = (MPS<<16) | 0x3E = 0x8003E.
        //      CErr=3 (bits 1..2), EP Type=7 Intr IN (bits 3..5), MPS=8.
        mov rax, 0x8003E;
        mov_d [r14 + 132], rax;                  // 0x84

        // (A5) TR Dequeue Pointer @+0x88 = transfer_ring_pa | 1 (DCS).
        //      Ring is 64-byte aligned so OR of 1 sets DCS cleanly.
        //      64-bit store spans DW2+DW3.
        mov rax, r15;
        or  rax, 1;
        mov [r14 + 136], rax;                    // 0x88

        // (A6) EP1 IN Context DW4 @+0x90 = Average TRB Length = 8.
        mov rax, 8;
        mov_d [r14 + 144], rax;                  // 0x90

        // ================================================================
        // Phase B — enqueue Configure Endpoint TRB + doorbell.
        // ================================================================

        // (B1) Compose ctrl_no_cycle = 0x3000 | (slot_id << 24).
        mov rax, 0x3000;
        mov rcx, r13;
        and rcx, 0xFF;
        shl rcx, 24;
        or  rax, rcx;

        // (B2) Enqueue Configure Endpoint TRB.
        mov rdi, rbp;                            // cmd_ctx
        mov rsi, r14;                            // param = input_ctx_pa
        xor rdx, rdx;                            // status = 0
        mov rcx, rax;                            // ctrl_no_cycle
        call xhci_cmd_enqueue;

        // (B3) Ring DB[0].
        mov rdi, rbx;
        call xhci_ring_cmd_doorbell;

        // ================================================================
        // Phase C — poll event ring.
        // ================================================================

        // (C1) Load polling state from event_ctx. r14 becomes trb_addr,
        //      r15 becomes expected cycle. Old input_ctx_pa/ring_pa are
        //      no longer needed post-enqueue.
        mov r14, [r12 + 8];                      // event_ring_va
        xor rax, rax;
        mov_w rax, [r12 + 16];                   // dequeue_idx
        shl rax, 4;
        add r14, rax;                            // r14 = trb_addr

        xor r15, r15;
        mov_b r15, [r12 + 18];                   // expected cycle

        mov rax, 5000000;                        // spin budget

      xhci_ce_poll:
        mov ecx, [r14 + 12];                     // Control word

        mov rdx, rcx;
        and rdx, 1;
        cmp rdx, r15;
        jne xhci_ce_no_event;

        // TRB Type check (bits 10..15).
        mov rdx, rcx;
        shr rdx, 10;
        and rdx, 0x3F;
        cmp rdx, 33;                             // CCE
        jne xhci_ce_wrong_type;

        // Completion Code check (Status bits 24..31).
        mov edx, [r14 + 8];
        shr rdx, 24;
        and rdx, 0xFF;
        cmp rdx, 1;                              // SUCCESS
        jne xhci_ce_cc_err;

        // Advance dequeue_idx (with segment wrap).
        xor rcx, rcx;
        mov_w rcx, [r12 + 16];
        add rcx, 1;
        cmp rcx, 256;
        jne xhci_ce_no_wrap;
        xor rcx, rcx;
        xor r15, 1;
        mov_b [r12 + 18], r15;
      xhci_ce_no_wrap:
        mov_w [r12 + 16], rcx;

        // ================================================================
        // Phase D — mark slot CONFIGURED.
        // ================================================================
        mov rdi, r13;                            // slot_id
        mov rsi, 4;                              // state = CONFIGURED
        call xhci_slot_state_set;

        xor rax, rax;                            // CFG_EP_OK
        jmp xhci_ce_done;

      xhci_ce_cc_err:
        or  rdx, 0x100;
        mov rax, rdx;
        jmp xhci_ce_done;

      xhci_ce_wrong_type:
        mov rax, 1;                              // CFG_EP_ERR_TYPE
        jmp xhci_ce_done;

      xhci_ce_no_event:
        sub rax, 1;
        cmp rax, 0;
        jne xhci_ce_poll;
        mov rax, 2;                              // CFG_EP_ERR_TIMEOUT

      xhci_ce_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
