// src/kernel/core/drivers/xhci/reset.pdx — R26-M1-005 (#945)
//
// xHCI controller reset + slot-enable programming sequence.
//
// Per xHCI 1.2 §4.2 the software controller-init flow is:
//
//   (1) Halt the controller — clear USBCMD.RS (bit 0); poll USBSTS.HCH
//       (bit 0) until set. Firmware may leave RS asserted after POST
//       (T14 G4 UEFI does this so keyboard remains usable through
//       BootExitServices); we must halt before HCRST or the reset may
//       be silently ignored (xHCI 1.2 §5.4.1.1).
//
//   (2) Reset the controller — write USBCMD.HCRST (bit 1) = 1. Poll
//       until:
//         (a) USBCMD.HCRST clears (controller acknowledged reset), AND
//         (b) USBSTS.CNR (bit 11) clears (controller ready for register
//             programming again).
//       Both conditions must hold — CNR clearing without HCRST clearing
//       (or vice versa) is an in-progress-reset state per §5.4.1.1.
//
//   (3) Program CONFIG.MaxSlotsEn = min(HCSPARAMS1.MaxSlots, 64) — the
//       MVP cap of 64 slots is arbitrary but matches the T14 G4's
//       actual USB endpoint budget with plenty of headroom. Increasing
//       beyond 64 requires a corresponding DCBAA allocation increase
//       (R26.M2).
//
// R26.M1 does NOT enable the controller after reset — starting RS
// requires the command ring, event ring, and device-context array to
// be pre-programmed. Those land in R26.M2..M3.
//
// -----------------------------------------------------------------------------
// Timeout budget
// -----------------------------------------------------------------------------
//
// xHCI 1.2 §5.4.1.1 does not mandate a specific reset timeout, but
// every commodity controller completes reset in under 1ms. The Linux
// XHCI_MAX_HALT_USEC budget is 16 seconds (conservative for buggy
// firmware); we use 5_000_000 spin iterations ~ 150ms which is 100x
// margin over any healthy controller and short enough that a hung
// reset produces a boot-time fault witness rather than a UX-visible
// stall. R26.M2 will replace this with a tsc/hpet-derived deadline
// once the driver-attach path is wired.
//
// -----------------------------------------------------------------------------
// R26.M1 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// xhci_reset is callable symbol at M1 but IS NOT wired into
// kernel_main.pdx. Under BIOS/`-kernel` boot the PCI enumerator
// returns 0 devices, xhci_probe returns 0 controllers, and there is
// no bar0 to pass to xhci_reset. Real activation lands at R26.M2
// driver-attach after event-ring / DCBAA allocation from phys_alloc.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: u32 MMIO writes route through xhci_op_write_u32 (mov_d internally).
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `xhci_rs_` to avoid the
// paideia-as reserved names (`loop`, `if`, ...).

module Reset = structure {

  // ============================================================================
  // Return codes
  // ============================================================================

  pub let XHCI_RESET_OK             : u64 = 0
  pub let XHCI_RESET_ERR_HALT       : u64 = 1     // USBSTS.HCH never set
  pub let XHCI_RESET_ERR_RESET      : u64 = 2     // HCRST/CNR never cleared

  // ============================================================================
  // Timeouts + MVP slot cap
  // ============================================================================

  pub let XHCI_RESET_SPIN_MAX       : u64 = 5000000
  pub let XHCI_MAX_SLOTS_MVP        : u64 = 64

  // ============================================================================
  // xhci_reset(bar0) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base (MMIO physical address, page-aligned).
  //
  // Returns rax = XHCI_RESET_OK (0) on success, or a non-zero error
  // code on timeout at either the halt or reset-completion phase.
  //
  // Register plan (5-push callee-save):
  //   rbx = bar0
  //   rbp = op_base = bar0 + CAPLENGTH
  //   r12 = spin counter (reused for halt-poll then reset-poll then
  //         cnr-poll)
  //   r13 = maxslots_en (final CONFIG value; MVP-capped to 64)
  //   r14 = scratch for RMW USBCMD values
  //
  //   5 pushes = 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every
  //   nested xhci_* / klog_s1_x1 call without extra pre-call pad).

  pub let xhci_reset : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-005 (#945). xHCI controller reset + slot-enable sequence per xHCI 1.2 §4.2 / §5.4.1.1. Body: (1) 5-push callee-save (rbx=bar0, rbp=op_base, r12=spin, r13=maxslots_en, r14=scratch) — 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every nested xhci_cap_u8 / xhci_op_u32 / xhci_op_write_u32 / xhci_cap_u32 / klog_s1_x1 call without pre-call pad). (2) Load CAPLENGTH (u8 @ bar0+0) via xhci_cap_u8(bar0, 0) -> rax. op_base = bar0 + rax. Save in rbp. (3) HALT phase: read USBCMD (op_base+0) via xhci_op_u32 -> rax. Clear RS bit 0 via `and rax, 0xFFFFFFFFFFFFFFFE` (sign-extended imm32 of 0xFFFFFFFE — same pattern as nvme_reset core/drivers/nvme/enable.pdx L152). Write back via xhci_op_write_u32(op_base, 0, new_cmd). (4) Poll USBSTS.HCH (bit 0) until set: init r12 = XHCI_RESET_SPIN_MAX. Loop { rax = xhci_op_u32(op_base, 4 = USBSTS); if (rax & 1) != 0 -> halted; dec r12; if r12 == 0 -> return XHCI_RESET_ERR_HALT }. (5) RESET phase: read USBCMD again (state may have changed since HALT), set HCRST bit 1 via `or rax, 2`, write back. (6) Poll BOTH USBCMD.HCRST (bit 1) clear AND USBSTS.CNR (bit 11 = 0x800) clear — spec §5.4.1.1: reset is complete only when BOTH conditions hold. init r12 = spin. Loop { cmd = xhci_op_u32(op_base, 0); if (cmd & 2) != 0 -> not done; sts = xhci_op_u32(op_base, 4); if (sts & 0x800) != 0 -> not done; -> reset_done; dec r12; if r12 == 0 -> return XHCI_RESET_ERR_RESET }. (7) Read HCSPARAMS1 (u32 @ bar0+4) via xhci_cap_u32 -> rax. MaxSlots = rax & 0xFF. Cap at 64 (MVP): if MaxSlots > 64 -> MaxSlots = 64. Save in r13. (8) Read CONFIG (op_base + 0x38), replace low 8 bits (MaxSlotsEn) with r13 preserving upper bits (U3E bit 8, CIE bit 9 — reserved zero at M1 but future-proof). config_new = (config_old & ~0xFF) | r13. Write back via xhci_op_write_u32(op_base, 0x38, config_new). (9) Emit klog_s1_x1(INFO, XHCI, tag_xhci_reset, k_slotsen, r13) fingerprint. (10) Return 0. Reserved labels: `xhci_rs_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // rbx = bar0

        // (2) op_base = bar0 + CAPLENGTH (u8 @ bar0+0).
        mov rdi, rbx;
        mov rsi, 0;                              // XHCI_CAP_CAPLENGTH
        call xhci_cap_u8;
        mov rbp, rbx;
        add rbp, rax;                            // rbp = op_base

        // ================================================================
        // (3) HALT — clear USBCMD.RS.
        // ================================================================
        mov rdi, rbp;
        mov rsi, 0;                              // XHCI_OP_USBCMD
        call xhci_op_u32;
        and rax, 0xFFFFFFFFFFFFFFFE;             // clear RS (bit 0)
        mov rdi, rbp;
        mov rsi, 0;
        mov rdx, rax;
        call xhci_op_write_u32;

        // ================================================================
        // (4) Poll USBSTS.HCH = 1 (halted).
        // ================================================================
        mov r12, 5000000;                        // XHCI_RESET_SPIN_MAX

      xhci_rs_wait_hch:
        mov rdi, rbp;
        mov rsi, 4;                              // XHCI_OP_USBSTS
        call xhci_op_u32;
        mov r14, rax;
        and r14, 1;                              // HCH
        cmp r14, 0;
        jne xhci_rs_halt_done;

        sub r12, 1;
        cmp r12, 0;
        je xhci_rs_err_halt;
        jmp xhci_rs_wait_hch;

      xhci_rs_halt_done:

        // ================================================================
        // (5) RESET — set USBCMD.HCRST.
        // ================================================================
        mov rdi, rbp;
        mov rsi, 0;                              // USBCMD
        call xhci_op_u32;
        or rax, 2;                               // HCRST (bit 1)
        mov rdi, rbp;
        mov rsi, 0;
        mov rdx, rax;
        call xhci_op_write_u32;

        // ================================================================
        // (6) Poll USBCMD.HCRST == 0 AND USBSTS.CNR == 0.
        // ================================================================
        mov r12, 5000000;

      xhci_rs_wait_reset:
        // Check USBCMD.HCRST.
        mov rdi, rbp;
        mov rsi, 0;                              // USBCMD
        call xhci_op_u32;
        mov r14, rax;
        and r14, 2;                              // HCRST
        cmp r14, 0;
        jne xhci_rs_reset_tick;                  // still resetting

        // Check USBSTS.CNR.
        mov rdi, rbp;
        mov rsi, 4;                              // USBSTS
        call xhci_op_u32;
        mov r14, rax;
        and r14, 0x800;                          // CNR (bit 11)
        cmp r14, 0;
        je xhci_rs_reset_done;                   // both clear

      xhci_rs_reset_tick:
        sub r12, 1;
        cmp r12, 0;
        je xhci_rs_err_reset;
        jmp xhci_rs_wait_reset;

      xhci_rs_reset_done:

        // ================================================================
        // (7) Compute MaxSlotsEn = min(HCSPARAMS1.MaxSlots, 64).
        // ================================================================
        mov rdi, rbx;
        mov rsi, 4;                              // XHCI_CAP_HCSPARAMS1
        call xhci_cap_u32;
        and rax, 0xFF;                           // MaxSlots
        mov r13, rax;
        cmp r13, 64;                             // XHCI_MAX_SLOTS_MVP
        jbe xhci_rs_slots_ok;
        mov r13, 64;
      xhci_rs_slots_ok:

        // ================================================================
        // (8) Read CONFIG, replace low 8 bits with r13, write back.
        // ================================================================
        mov rdi, rbp;
        mov rsi, 0x38;                           // XHCI_OP_CONFIG
        call xhci_op_u32;
        and rax, 0xFFFFFFFFFFFFFF00;             // clear MaxSlotsEn field
        or rax, r13;                             // program new MaxSlotsEn
        mov rdi, rbp;
        mov rsi, 0x38;
        mov rdx, rax;
        call xhci_op_write_u32;

        // ================================================================
        // (9) Emit "XHCI RESET slotsen=<n>".
        // ================================================================
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_xhci_reset];
        lea rcx, [rip + k_slotsen];
        mov r8, r13;                             // v1 = MaxSlotsEn
        call klog_s1_x1;

        xor rax, rax;                            // XHCI_RESET_OK
        jmp xhci_rs_done;

      xhci_rs_err_halt:
        mov rax, 1;                              // XHCI_RESET_ERR_HALT
        jmp xhci_rs_done;

      xhci_rs_err_reset:
        mov rax, 2;                              // XHCI_RESET_ERR_RESET

      xhci_rs_done:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
