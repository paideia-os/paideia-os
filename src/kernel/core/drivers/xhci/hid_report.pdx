// src/kernel/core/drivers/xhci/hid_report.pdx — R26-M6-002..003 (#966, #967)
//
// USB HID Boot Keyboard 8-byte report parser + TTY input bridge.
//
// -----------------------------------------------------------------------------
// HID Boot Keyboard report format (USB HID 1.11 §B.1)
// -----------------------------------------------------------------------------
//
//   byte 0     modifiers  (bit 0=LCtrl, 1=LShift, 2=LAlt, 3=LGui,
//                          4=RCtrl,  5=RShift, 6=RAlt, 7=RGui)
//   byte 1     reserved   (host must ignore; some devices post 0x01)
//   byte 2..7  keys[6]    (usage codes, 0 = empty slot)
//
// The 8-byte report is DMA'd by the xHCI EP1-IN Interrupt endpoint
// once per polling interval (see configure_ep.pdx — 8 microframes for
// LS/FS boot keyboards). The transfer-event walker calls
// hid_process_report(report_pa) after each successful transfer.
//
// -----------------------------------------------------------------------------
// Press / release detection (#966)
// -----------------------------------------------------------------------------
//
// A pressed key surfaces in report.keys[] for every polling interval it
// remains pressed. The kernel driver needs *edge-triggered* events
// (once per press, once per release) so the shell doesn't see the same
// keystroke repeated 8 000 times / second while the finger stays down.
//
// _hid_prev_report caches the last-seen 8-byte report. Each new report
// R is diffed against it:
//
//   for k in R.keys[6]:
//     if k != 0 and k not in prev.keys[6]:   -> KEY PRESS event
//   for k in prev.keys[6]:
//     if k != 0 and k not in R.keys[6]:      -> KEY RELEASE event
//
// then prev <- R.
//
// R26.M6 MVP only wires PRESS. RELEASE is emitted as a fingerprint
// (for observability) but does not touch the TTY line buffer — the
// cooked-mode TTY layer doesn't consume up-events. Key auto-repeat
// (holding a key => successive presses at ~30 Hz) is deliberately NOT
// emulated: the shell reads one line at a time and the user's finger
// discipline is the repeat source.
//
// -----------------------------------------------------------------------------
// Rollover handling
// -----------------------------------------------------------------------------
//
// USB HID Boot Keyboard signals a rollover-error condition by filling
// every keys[] slot with 0x01 (ErrorRollOver). The task spec treats
// bytes 2..3 == 0x01, 0x01 as the trigger — that's the first two key
// slots. When rollover fires we ignore the entire report (do NOT
// update _hid_prev_report — the next legal report re-establishes
// coherent press/release edges naturally).
//
// -----------------------------------------------------------------------------
// TTY bridge (#967)
// -----------------------------------------------------------------------------
//
// hid_bridge_to_tty(ascii) routes non-zero ASCII bytes into the R16.M5
// cooked-mode TTY layer via tty_process_input (core/tty/process_input.pdx).
// That path already handles CR/LF folding, backspace echo, and
// overflow bell — the HID bridge stays entirely below the character
// layer, treating the keyboard as one more byte source alongside the
// UART RX ring.
//
// Under the R26.M6 posture nothing polls xHCI EP1-IN yet (that's the
// R27 driver-attach wire-up) — the bridge symbol is callable but
// dormant at boot. Manual invocation from GDB (`call
// hid_bridge_to_tty(0x61)`) is the T14 G4 first-touch harness.
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   PRESS   "HID KEY <ascii>\n"          (fixed prefix + 1 raw byte + LF)
//
// Non-printable ASCII bytes (Esc 0x1B, Backspace 0x08) still emit —
// the fingerprint is byte-oriented and the caller-side smoke scanner
// tolerates raw bytes verbatim.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: zero-extended u8 loads + sized u8 stores for the report copy.
//
// Reserved-label discipline: `hid_pr_` (process report), `hid_br_`
// (bridge to tty).

module HidReport = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let HID_REPORT_BYTES              : u64 = 8
  pub let HID_REPORT_KEY_COUNT          : u64 = 6
  pub let HID_REPORT_KEYS_OFFSET        : u64 = 2
  pub let HID_ROLLOVER_MARKER           : u64 = 0x01

  // ============================================================================
  // _hid_prev_report — 8 B .bss anchor for the previous report.
  //
  // .bss zero-init means the first hid_process_report call sees an
  // empty prev — every non-zero key in the first report is a fresh
  // press. Same posture as _tty_prev_state in the TTY layer.
  // ============================================================================

  pub let mut _hid_prev_report : [u8; 8] = uninit @align(8)

  // ============================================================================
  // Fingerprint prefix — "HID KEY " (8 B, zero-terminated for uart_puts).
  // ============================================================================

  pub let _hid_kp_prefix_msg : [u8; 9] = "HID KEY \0"

  // ============================================================================
  // hid_bridge_to_tty(ascii: u8) -> ()
  // ============================================================================
  //
  // SysV: rdi = ASCII byte (low 8 bits used).
  //
  // If ascii == 0 -> no-op (caller contract: unmapped usage codes
  // resolve to 0 and must not enter the TTY layer, which would append
  // NUL into _tty_line_buf and corrupt shell parsing).
  //
  // Otherwise: forward the byte to tty_process_input, which handles
  // echo + line-buffer append + CR/LF folding + backspace erase per
  // the R16.M5 cooked-mode discipline (see core/tty/process_input.pdx).
  //
  // Non-leaf — 1 tail call to tty_process_input. The single push rbx
  // /pop rbx callee-save prologue keeps rsp % 16 == 0 across the
  // nested call.

  pub let hid_bridge_to_tty : (u64) -> () !{sysreg, mem} @{boot} =
    fn (ascii: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M6-003 (#967). HID -> TTY input bridge. Body: (1) push rbx (single callee-save, keeps rsp%16==0 for the nested tty_process_input call which non-leaf per core/tty/process_input.pdx). (2) mov rbx, rdi; and rbx, 0xFF — isolate low 8 bits. (3) cmp rbx, 0; je hid_br_done — zero-skip guard (unmapped HID codes translate to 0 per hid_keymap.pdx contract; must not enter TTY layer where tty_line_append would happily persist a NUL into _tty_line_buf and break shell tokenization). (4) mov rdi, rbx; call tty_process_input — forwards the byte through the R16.M5 cooked-mode router (echo + append + CR/LF fold + BS erase + BEL-on-full). (5) pop rbx; ret. Reserved labels: `hid_br_`.",
      block: {
        push rbx;

        mov rbx, rdi;
        and rbx, 0xFF;
        cmp rbx, 0;
        je  hid_br_done;

        mov rdi, rbx;
        call tty_process_input;

      hid_br_done:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // hid_process_report(report_pa: u64) -> ()
  // ============================================================================
  //
  // SysV: rdi = physical address of an 8-byte HID Boot Keyboard report.
  //
  // Under the identity map (kernel_main_uefi + boot_stub.S), a report
  // in kernel .bss / phys-alloc memory has VA == PA, so `mov_b [rdi]`
  // resolves both interpretations identically.
  //
  // Register plan (6-push callee-save + 8B align):
  //   rbx = report_pa           (survives every nested call)
  //   rbp = modifiers byte      (arg 1 to hid_translate on each press)
  //   r12 = i (outer loop index over report.keys[])
  //   r13 = j (inner loop index over prev.keys[])
  //   r14 = current key usage / scratch
  //   r15 = ASCII byte across uart_puts + uart_putc + hid_bridge_to_tty
  //
  //   6 pushes = 48 B; entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0.

  pub let hid_process_report : (u64) -> () !{sysreg, mem} @{boot} =
    fn (report_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M6-002 (#966). Poll one HID Boot Keyboard 8-byte report, emit fingerprint per new press, bridge each press through hid_translate + hid_bridge_to_tty, update _hid_prev_report. Body: (1) 6-push callee-save + sub rsp,8 align — 64 B total; entry rsp%16==8 -> aligned for every nested call (uart_puts, uart_putc, hid_translate, hid_bridge_to_tty). (2) Stash report_pa in rbx. (3) Rollover check: `xor rax,rax; mov_b rax,[rbx+2]; cmp rax,0x01; jne hid_pr_no_rollover`; then same on [rbx+3]; if both equal 0x01 jmp hid_pr_done without touching prev — next legal report re-syncs edges. (4) Load modifiers into rbp (u8 @rbx+0). (5) Outer loop i=r12=0: cmp r12,6; jae hid_pr_copy. Compute r14 = u8 @ (rbx + 2 + r12); cmp r14,0; je next_i (skip empty slot). (6) Inner loop j=r13=0: cmp r13,6; jae hid_pr_new_key (fell through — key was not in prev). Compare r14 vs u8 @ (_hid_prev_report + 2 + r13); if equal jmp next_i (already pressed). Advance j; loop. (7) hid_pr_new_key: rdi=r14 usage, rsi=rbp modifiers, call hid_translate. Result rax = ASCII. cmp rax,0; je next_i (unmapped key — skip). Save ASCII in r15. Emit fingerprint: lea rdi,[rip+_hid_kp_prefix_msg]; call uart_puts; mov rdi,r15; call uart_putc; mov rdi,0x0A; call uart_putc. Bridge: mov rdi,r15; call hid_bridge_to_tty. (8) next_i: add r12,1; jmp outer. (9) hid_pr_copy: copy report[0..8] to _hid_prev_report[0..8] byte-at-a-time via mov_b (u8-lane atomic; guards against G1 REX.W widening into neighbouring slots). Loop rcx=0..7: rdx = u8 @ (rbx+rcx); mov_b [_hid_prev_report+rcx], rdx. (10) hid_pr_done: epilogue. Reserved labels: `hid_pr_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;

        // ---- (1) Rollover check: bytes [2] and [3] both == 0x01 ----
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 1;
        jne hid_pr_no_rollover;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 1;
        je  hid_pr_done;

      hid_pr_no_rollover:
        // ---- (2) Modifiers byte ----
        xor rbp, rbp;
        mov_b rbp, [rbx + 0];

        // ---- (3) Outer loop over report.keys[] ----
        xor r12, r12;

      hid_pr_outer:
        cmp r12, 6;
        jae hid_pr_copy;

        // Load report.keys[i] = u8 @ (rbx + 2 + i)
        mov rcx, rbx;
        add rcx, 2;
        add rcx, r12;
        xor r14, r14;
        mov_b r14, [rcx];

        cmp r14, 0;
        je  hid_pr_next_i;

        // ---- (4) Inner loop: search prev.keys[] for r14 ----
        xor r13, r13;

      hid_pr_inner:
        cmp r13, 6;
        jae hid_pr_new_key;

        lea rcx, [rip + _hid_prev_report];
        add rcx, 2;
        add rcx, r13;
        xor rax, rax;
        mov_b rax, [rcx];

        cmp rax, r14;
        je  hid_pr_next_i;

        add r13, 1;
        jmp hid_pr_inner;

      hid_pr_new_key:
        // ---- (5) New key press: translate ----
        mov rdi, r14;
        mov rsi, rbp;
        call hid_translate;

        cmp rax, 0;
        je  hid_pr_next_i;

        mov r15, rax;

        // ---- (6) Emit fingerprint "HID KEY <ascii>\n" ----
        lea rdi, [rip + _hid_kp_prefix_msg];
        call uart_puts;

        mov rdi, r15;
        call uart_putc;

        mov rdi, 0x0A;
        call uart_putc;

        // ---- (7) Bridge byte into TTY layer ----
        mov rdi, r15;
        call hid_bridge_to_tty;

      hid_pr_next_i:
        add r12, 1;
        jmp hid_pr_outer;

      hid_pr_copy:
        // ---- (8) Copy report[0..8] into _hid_prev_report[0..8] ----
        xor rcx, rcx;

      hid_pr_cp:
        cmp rcx, 8;
        jae hid_pr_done;

        mov r8, rbx;
        add r8, rcx;
        xor rdx, rdx;
        mov_b rdx, [r8];

        lea r8, [rip + _hid_prev_report];
        add r8, rcx;
        mov_b [r8], rdx;

        add rcx, 1;
        jmp hid_pr_cp;

      hid_pr_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
