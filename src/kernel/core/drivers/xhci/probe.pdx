// src/kernel/core/drivers/xhci/probe.pdx — R26-M1-001 (#941)
//
// xHCI controller device probe.
//
// After pci_enumerate_all (src/kernel/core/pci/enum.pdx) populates
// _pci_devices with one 32-byte record per enumerated function, the
// xHCI probe filters that list for the PCI class code triple that
// identifies an eXtensible Host Controller Interface controller:
//
//   class_code = 0x0C (serial bus controller)
//   subclass   = 0x03 (USB controller)
//   prog_if    = 0x30 (xHCI 1.0 / 1.1 / 1.2 spec)
//
// The class/subclass pair lives in the enum-published _pci_devices
// record at offsets +6/+7; prog_if is NOT stored in the compact record
// so we read it back via pci_config_read_u8 for each candidate slot.
// This exactly mirrors the NVMe probe pattern (core/drivers/nvme/probe.pdx),
// which shares the same enum record layout.
//
// The 0x30 filter deliberately excludes the older UHCI (prog_if 0x00),
// OHCI (0x10) and EHCI (0x20) controllers. On the T14 G4 target every
// USB port is behind an xHCI root complex, so the 0x30 filter captures
// every USB device path we care about. Post-MVP support for legacy
// controllers (needed only for pre-Sandy-Bridge era boards) lands in a
// separate driver family with distinct filters.
//
// For every match the probe records a compact 32-byte descriptor into
// _xhci_devices and emits one "XHCI PROBE N=<count>" fingerprint. In
// the -kernel/BIOS boot path where MCFG is absent, _pci_device_count
// is 0 -> the probe drains the empty loop and emits "N=0".
//
// -----------------------------------------------------------------------------
// _xhci_devices record layout (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  _pad0
//   +6    u16 cap_msix_off      // 0 if MSI-X capability absent
//   +8    u64 bar0_pa           // controller register-set physical base
//   +16   u16 cap_msi_off       // 0 if MSI capability absent
//   +18   u16 _pad1
//   +20   u32 _pad2
//   +24   u64 _reserved
//   +32   end
//
// Layout is byte-for-byte identical to _nvme_devices. Consumers of both
// arrays (the R26.M2 driver-attach path) can share record-decode code.
//
// -----------------------------------------------------------------------------
// BAR0 decode
// -----------------------------------------------------------------------------
//
// Per xHCI 1.2 §5.2.1 the MMIO capability register set is at PCI BAR0.
// Real hardware ships this as either a 32-bit or 64-bit memory BAR
// (type bits [2:1] = 00 or 10). We accept both and reject I/O BARs
// (bit 0 = 1) since an xHCI controller must expose MMIO — an I/O-space
// BAR here would indicate mis-configured firmware, not a legitimate
// device.
//
//   bar0_pa (MEM64) = (BAR[hi=+0x14] << 32) | (BAR[lo=+0x10] & ~0xF)
//   bar0_pa (MEM32) = BAR[lo=+0x10] & ~0xF
//
// -----------------------------------------------------------------------------
// XHCI_MAX_DEVS = 4
// -----------------------------------------------------------------------------
//
// The T14 G4 exposes at most three xHCI root complexes: TB4 USB-C x2,
// USB-A hub, USB-3.2 USB-C. A 4-slot cap absorbs that plus one for
// headroom (external dock or PCH-attached expansion). Silent overflow
// is fine: real hardware never exceeds this ceiling, and a fifth
// controller (were one to appear) means the topology is unusual enough
// to justify a separate diagnostic path rather than a silent driver
// attach at boot.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: `mov [mem], reg32` narrow store widens -> use `mov_d` / `mov_w`
//       / `mov_b` for sized stores into the record.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `xhci_pr_` to avoid the
// paideia-as reserved names (`loop`, `if`, ...).

module Probe = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let XHCI_CLASS_CODE     : u64 = 0x0C   // serial bus controller
  pub let XHCI_SUBCLASS       : u64 = 0x03   // USB controller
  pub let XHCI_PROG_IF        : u64 = 0x30   // xHCI interface

  pub let XHCI_MAX_DEVS       : u64 = 4
  pub let XHCI_DEV_REC_SIZE   : u64 = 32

  // ============================================================================
  // Canonical static slots — .bss, @align(8)
  // ============================================================================
  //
  //   _xhci_devices          : 4 x 32 B = 128 B = 16 x u64
  //   _xhci_device_count     : populated by xhci_probe

  pub let mut _xhci_devices        : [u64; 16] = uninit @align(8)
  pub let mut _xhci_device_count   : u64       = 0

  // ============================================================================
  // xhci_probe() -> u64
  // ============================================================================
  //
  // SysV: () -> u64
  //   Returns rax = number of xHCI controllers discovered (0..4).
  //
  // Register plan (mirrors nvme_probe):
  //   rbx = i (loop index into _pci_devices)
  //   r12 = _pci_device_count (loaded once)
  //   r13 = j (xhci write index into _xhci_devices)
  //   r14 = &_pci_devices[i] (recomputed each iter)
  //   r15 = &_xhci_devices[j] (recomputed on match)
  //   rbp = scratch (cap_msix_off preservation across pci_find_cap)
  //
  //   Scratch slots (per candidate device):
  //     [rsp+0]  = seg  (u64, zero-extended)
  //     [rsp+8]  = bus  (u64)
  //     [rsp+16] = dev  (u64)
  //     [rsp+24] = fn   (u64)
  //     [rsp+32] = bar0_pa (u64, preserved across pci_find_cap)

  pub let xhci_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-001 (#941). xHCI controller device probe. Structurally identical to nvme_probe (core/drivers/nvme/probe.pdx L109) with the class/subclass/prog_if triple retargeted to 0x0C/0x03/0x30 and the XHCI_MAX_DEVS cap at 4. Body: (1) 6-push callee-save prologue (rbx, rbp, r12-r15) — 48 B; entry rsp%16==8 -> 56; sub rsp, 40 (32 scratch + 8 align) -> 96, %16==0 (aligned for every nested pci_config_read_u8 / pci_config_read_u32 / pci_find_cap without extra pre-call pad). Scratch layout [rsp+0..31] for seg/bus/dev/fn; [rsp+32] for bar0_pa across the two pci_find_cap calls. (2) Init j=r13=0; load _pci_device_count into r12; init i=rbx=0. (3) Per-iteration bounds check: cmp rbx, r12; jae done. (4) Compute r14 = &_pci_devices[i] = _pci_devices + (i << 5) — record stride 32 = shl 5. (5) Load class_code (u8 @ r14+6) and subclass (u8 @ r14+7); if class != 0x0C or subclass != 0x03 -> skip. Zero-extend via `xor rax,rax; mov_b rax, [r14+N]` pattern. (6) Class/subclass matched: read seg (u16 @ r14+0), bus (u8 @ +2), dev (u8 @ +3), fn (u8 @ +4) and stash into scratch slots [rsp+0..24]. (7) Call pci_config_read_u8(seg, bus, dev, fn, 0x09) -> rax = prog_if. If prog_if != 0x30, skip (USB but not xHCI — could be UHCI/OHCI/EHCI). (8) Overflow guard: if r13 >= XHCI_MAX_DEVS (=4), skip (silent drop — see module doc for justification). (9) Read BAR0 lo via pci_config_read_u32(seg, bus, dev, fn, 0x10). Determine 64-bit vs 32-bit via bits [2:1]: if bits == 0x2 -> read BAR0 hi via pci_config_read_u32(..., 0x14); compose bar0_pa = (hi << 32) | (lo & ~0xF). Else if bit 0 == 0 -> 32-bit MEM BAR: bar0_pa = lo & ~0xF. Else (I/O BAR) -> skip. (10) Call pci_find_cap(seg, bus, dev, fn, 0x11 MSI-X) -> cap_msix_off (rax). Save in rbp. Call pci_find_cap(..., 0x05 MSI) -> cap_msi_off. (11) Compute r15 = &_xhci_devices[j] = base + (j << 5). Populate the 32-byte record with the same layout as _nvme_devices: u16 seg @+0, u8 bus/dev/fn @+2/+3/+4, u8 pad=0 @+5, u16 cap_msix_off @+6, u64 bar0_pa @+8, u16 cap_msi_off @+16, zero the tail (18..32). (12) Increment r13 (j). (13) Advance i, loop. (14) On loop exit: publish _xhci_device_count = r13; emit klog_s1_d1(INFO, XHCI, tag_xhci_probe, k_n, count) fingerprint; return count. Reserved-label posture: labels prefixed `xhci_pr_`. Every nested callee preserves rbx/rbp/r12-r15 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;                             // 32 scratch + 8 align

        // Init counters.
        xor r13, r13;                            // j = 0 (xhci count)
        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;                            // i = 0

      xhci_pr_loop:
        cmp rbx, r12;
        jae xhci_pr_done;

        // r14 = &_pci_devices[i]
        mov rax, rbx;
        shl rax, 5;
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // class_code (u8 @+6)
        xor rax, rax;
        mov_b rax, [r14 + 6];
        cmp rax, 0x0C;                           // XHCI_CLASS_CODE
        jne xhci_pr_next;

        // subclass (u8 @+7)
        xor rax, rax;
        mov_b rax, [r14 + 7];
        cmp rax, 0x03;                           // XHCI_SUBCLASS
        jne xhci_pr_next;

        // Class + subclass match. Load BDF into scratch slots.
        // seg (u16 @+0)
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;

        // bus (u8 @+2)
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;

        // dev (u8 @+3)
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;

        // fn (u8 @+4)
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;

        // pci_config_read_u8(seg, bus, dev, fn, 0x09) -> prog_if
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x09;
        call pci_config_read_u8;
        cmp rax, 0x30;                           // XHCI_PROG_IF
        jne xhci_pr_next;

        // Overflow guard.
        cmp r13, 4;                              // XHCI_MAX_DEVS
        jae xhci_pr_next;

        // Read BAR0 lo (u32 @ config +0x10).
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x10;
        call pci_config_read_u32;

        // rax = bar_lo. Check bit 0 (0 = MEM, 1 = IO).
        mov r10, rax;                            // r10 = bar_lo (preserve across next call)
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne xhci_pr_next;                        // I/O BAR — not xHCI-conformant

        // Check bits [2:1]: 00 = 32-bit, 10 = 64-bit.
        mov r11, r10;
        shr r11, 1;
        and r11, 3;
        cmp r11, 2;
        je xhci_pr_bar64;

        // MEM32: bar0_pa = bar_lo & ~0xF
        mov r15, r10;
        and r15, 0xFFFFFFFFFFFFFFF0;
        jmp xhci_pr_bar_done;

      xhci_pr_bar64:
        // Save bar_lo across the hi-word read.
        mov [rsp + 32], r10;

        // Read BAR0 hi (u32 @ config +0x14).
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x14;
        call pci_config_read_u32;

        // rax = bar_hi. bar0_pa = (bar_hi << 32) | (bar_lo & ~0xF)
        shl rax, 32;
        mov r10, [rsp + 32];
        and r10, 0xFFFFFFFFFFFFFFF0;
        or rax, r10;
        mov r15, rax;                            // r15 = bar0_pa

      xhci_pr_bar_done:
        // Save bar0_pa across the pci_find_cap calls.
        mov [rsp + 32], r15;

        // pci_find_cap(seg, bus, dev, fn, MSI-X=0x11) -> cap_msix_off
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x11;
        call pci_find_cap;
        mov rbp, rax;                            // rbp = cap_msix_off

        // pci_find_cap(seg, bus, dev, fn, MSI=0x05) -> cap_msi_off
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x05;
        call pci_find_cap;

        // Now populate _xhci_devices[j]. r15 = &_xhci_devices[j]
        mov r11, r13;
        shl r11, 5;
        lea r15, [rip + _xhci_devices];
        add r15, r11;

        // rax = cap_msi_off; rbp = cap_msix_off; [rsp+32] = bar0_pa;
        // scratch [rsp+0..24] = seg/bus/dev/fn.

        // u16 seg @+0
        mov r10, [rsp + 0];
        mov_w [r15 + 0], r10;

        // u8 bus @+2
        mov r10, [rsp + 8];
        mov_b [r15 + 2], r10;

        // u8 dev @+3
        mov r10, [rsp + 16];
        mov_b [r15 + 3], r10;

        // u8 fn @+4
        mov r10, [rsp + 24];
        mov_b [r15 + 4], r10;

        // u8 pad0 = 0 @+5
        xor r10, r10;
        mov_b [r15 + 5], r10;

        // u16 cap_msix_off @+6
        mov_w [r15 + 6], rbp;

        // u64 bar0_pa @+8
        mov r10, [rsp + 32];
        mov [r15 + 8], r10;

        // u16 cap_msi_off @+16
        mov_w [r15 + 16], rax;

        // u16 pad1 = 0 @+18, u32 pad2 = 0 @+20, u64 reserved = 0 @+24.
        xor r10, r10;
        mov_w [r15 + 18], r10;
        mov_d [r15 + 20], r10;
        mov [r15 + 24], r10;

        // j += 1
        add r13, 1;

      xhci_pr_next:
        add rbx, 1;
        jmp xhci_pr_loop;

      xhci_pr_done:
        // Publish device count.
        mov [rip + _xhci_device_count], r13;

        // Emit "XHCI PROBE N=<count>".
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_xhci_probe];
        lea rcx, [rip + k_n];
        mov r8, r13;                             // v1 = count
        call klog_s1_d1;

        mov rax, r13;                            // return count

        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
