// src/kernel/core/drivers/xhci/bios_handoff.pdx — R26-M1-003/004 (#943, #944)
//
// xHCI USB Legacy Support (USBLEGSUP) BIOS -> OS handoff, plus the
// follow-on USBLEGCTLSTS SMI-source disable that prevents System
// Management Interrupt storms once OS ownership is asserted.
//
// -----------------------------------------------------------------------------
// Why this matters — SMI storm avoidance (#944)
// -----------------------------------------------------------------------------
//
// On BIOS-owned firmware paths the platform typically wires the xHCI
// controller to generate SMIs on OS-ownership change, PCI command,
// BAR access and (on some chipsets) every event interrupt. Once the
// OS asserts ownership without also clearing USBLEGCTLSTS the platform
// firmware sees ownership-change SMIs on every subsequent register
// touch, producing an SMI storm that stalls all CPUs for hundreds of
// microseconds per touch and blocks IRQ latency budgets entirely.
// See design/roadmap/r18-plus-bare-metal.md §R26 and Linux
// drivers/usb/host/xhci-pci.c usb_disable_xhci_ports (v5.15).
//
// -----------------------------------------------------------------------------
// xHCI extended-capability list walk (xHCI 1.2 §7)
// -----------------------------------------------------------------------------
//
// Unlike the PCIe legacy or extended capability lists (both walked
// via PCI config space through ECAM), the xHCI extended-cap list is
// MMIO-resident in the same BAR0 window as the controller's operational
// registers. HCCPARAMS1.xECP_offset (bits [31:16]) points at the first
// extended cap in DW units from BAR0 (byte offset = xECP << 2). Every
// extended-cap header is a u32 word:
//
//   bits  [7:0]   Capability ID
//   bits [15:8]   Next Capability Pointer (in DW units; 0 terminates)
//   bits [31:16]  Cap-specific
//
// USBLEGSUP has cap_id = 0x01 and defines the following per-cap-instance
// fields (xHCI 1.2 §7.1):
//
//   Base+0  u32  USBLEGSUP
//                bits  [7:0]   Capability ID (= 0x01)
//                bits [15:8]   Next Cap Ptr
//                bit  16       HC BIOS Owned Semaphore
//                bit  24       HC OS   Owned Semaphore
//   Base+4  u32  USBLEGCTLSTS
//                bit  0        USB SMI Enable
//                bit  4        SMI on Host System Error Enable
//                bit  13       SMI on OS Ownership Enable
//                bit  14       SMI on PCI Command Enable
//                bit  15       SMI on BAR Enable
//                bit  29       SMI on Host System Error   (RW1C)
//                bit  30       SMI on OS Ownership Change (RW1C)
//                bit  31       SMI on PCI Command         (RW1C)
//
// The handoff dance:
//   (1) OS sets USBLEGSUP.OS_OWNED (bit 24).
//   (2) OS polls USBLEGSUP.BIOS_OWNED (bit 16) until it clears — the
//       firmware acknowledges ownership transfer by clearing its bit.
//   (3) OS then clears USBLEGCTLSTS SMI-enable bits and clears the
//       RW1C status bits by writing 1 to them, per #944.
//
// -----------------------------------------------------------------------------
// SMI-disable formula (#944)
// -----------------------------------------------------------------------------
//
// Follows the Linux xhci-pci.c pattern:
//
//   val = readl(base + USBLEGCTLSTS);
//   val &= 0xFFFF0000;   // clear all SMI enable bits [0..15]
//   val |= 0xE0000000;   // write 1 to RW1C status bits [29..31] to clear
//   writel(val, base + USBLEGCTLSTS);
//
// The mask keeps the reserved-but-observable middle bits [16..28] at
// their read-back values, avoiding surprise writes into vendor-defined
// space that some Intel PCH USB variants use for platform-specific SMI
// gating (see design/roadmap/r18-plus-bare-metal.md §R26 hwman-§4).
//
// -----------------------------------------------------------------------------
// Timeout budget (1s @ ~150ns per xhci_mmio_u32)
// -----------------------------------------------------------------------------
//
// xhci_mmio_u32 costs two mfences + one UC MMIO read ~ 150 ns on a 3 GHz
// core. 6_600_000 iterations ~= 1 s wall-time, comfortably above the
// xHCI-spec-mandated 1s handoff budget. Under -kernel/BIOS boot the
// probe returns 0 controllers so this timeout is documentary today —
// R26.M2 driver-attach is the first real caller.
//
// -----------------------------------------------------------------------------
// R26.M1 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// xhci_bios_handoff / xhci_disable_smi / xhci_find_usblegsup are
// callable symbols at M1 but NOT wired into kernel_main.pdx. Under
// -kernel boot the PCI enumerator returns 0 devices, xhci_probe returns
// 0 controllers, and there is no bar0 to feed into these paths. Real
// activation lands at R26.M2 driver-attach.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: u32 MMIO writes route through xhci_mmio_write_u32 which uses
//       mov_d internally.
//   G4: full-register compares.
//
// Reserved-label discipline: labels prefixed `xhci_bh_` and `xhci_sm_`.

module BiosHandoff = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let XHCI_ECAP_ID_USBLEGSUP    : u64 = 0x01
  pub let XHCI_ECAP_MAX_WALK        : u64 = 48

  // USBLEGSUP semaphore bits — masked at u32 word width.
  pub let XHCI_USBLEGSUP_BIOS_OWNED : u64 = 0x00010000
  pub let XHCI_USBLEGSUP_OS_OWNED   : u64 = 0x01000000

  // USBLEGCTLSTS SMI-disable formula components.
  pub let XHCI_USBLEGCTLSTS_MASK    : u64 = 0xFFFF0000
  pub let XHCI_USBLEGCTLSTS_CLEAR   : u64 = 0xE0000000

  // USBLEGCTLSTS lives at USBLEGSUP + 4.
  pub let XHCI_USBLEGCTLSTS_OFFSET  : u64 = 4

  // Handoff timeout budget.
  pub let XHCI_HANDOFF_SPIN_MAX     : u64 = 6600000

  // Return codes.
  pub let XHCI_HANDOFF_OK           : u64 = 0
  pub let XHCI_HANDOFF_NO_ECAP      : u64 = 1     // no xECP list; nothing to do
  pub let XHCI_HANDOFF_NO_LEGSUP    : u64 = 2     // xECP present, no USBLEGSUP
  pub let XHCI_HANDOFF_TIMEOUT      : u64 = 3     // BIOS never released ownership

  // ============================================================================
  // xhci_find_usblegsup(bar0) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base (MMIO physical address, page-aligned).
  //
  // Returns rax = absolute MMIO address of the USBLEGSUP cap header
  // (i.e. bar0 + (xECP<<2) + offset walked to cap_id=0x01), or 0 if the
  // controller has no xECP list or USBLEGSUP is not present.
  //
  // Register plan (3-push callee-save):
  //   rbx = bar0 (preserved across xhci_cap_u32 / xhci_mmio_u32 calls)
  //   r12 = cursor (absolute MMIO address)
  //   r13 = visit counter (bounded at XHCI_ECAP_MAX_WALK = 48)
  //
  //   3 pushes = 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for every
  //   nested xhci_cap_u32 / xhci_mmio_u32 call without extra pad).

  pub let xhci_find_usblegsup : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-003 (#943). Walk the xHCI extended-capability list (rooted at BAR0 + (HCCPARAMS1.xECP << 2)) looking for USBLEGSUP (cap_id == 0x01). Returns the absolute MMIO address of the cap header, or 0 if absent. Body: (1) 3-push callee-save (rbx=bar0, r12=cursor, r13=visit_counter) — 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for every nested xhci_cap_u32 / xhci_mmio_u32 call without extra pad). (2) Read HCCPARAMS1 via xhci_cap_u32(bar0, 0x10). xECP_offset (in DW units) = HCCPARAMS1 >> 16. If xECP_offset == 0 -> no xECP list, return 0. (3) Compute r12 = bar0 + (xECP_offset << 2). Zero r13 (visit counter). (4) Loop: bound check r13 < 48; read header = xhci_mmio_u32(r12). cap_id = header & 0xFF. If cap_id == 0x01 -> return r12. next_ptr = (header >> 8) & 0xFF. If next_ptr == 0 -> return 0 (end of list). Advance r12 += (next_ptr << 2); r13 += 1; loop. (5) Fall-through (walked past 48 caps): return 0 — defensive against corrupt or cyclic next-ptr chains, same posture as pci_find_cap (core/pci/cap.pdx L156). Reserved labels: `xhci_bh_find_`. Every nested callee preserves rbx/r12/r13 per SysV.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                            // rbx = bar0

        // Read HCCPARAMS1 at bar0 + 0x10.
        mov rdi, rbx;
        mov rsi, 0x10;                           // XHCI_CAP_HCCPARAMS1
        call xhci_cap_u32;

        // xECP_offset = HCCPARAMS1 >> 16.
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, 0;
        je xhci_bh_find_none;

        // r12 = bar0 + (xECP << 2)
        shl rax, 2;
        mov r12, rbx;
        add r12, rax;

        xor r13, r13;                            // visit counter

      xhci_bh_find_loop:
        cmp r13, 48;                             // XHCI_ECAP_MAX_WALK
        jae xhci_bh_find_none;

        // Read u32 cap header at r12.
        mov rdi, r12;
        call xhci_mmio_u32;

        // cap_id = header & 0xFF
        mov r10, rax;
        and r10, 0xFF;
        cmp r10, 0x01;                           // XHCI_ECAP_ID_USBLEGSUP
        je xhci_bh_find_hit;

        // next_ptr (DW units) = (header >> 8) & 0xFF
        mov r10, rax;
        shr r10, 8;
        and r10, 0xFF;
        cmp r10, 0;
        je xhci_bh_find_none;

        // Advance cursor.
        shl r10, 2;
        add r12, r10;
        add r13, 1;
        jmp xhci_bh_find_loop;

      xhci_bh_find_hit:
        mov rax, r12;
        jmp xhci_bh_find_done;

      xhci_bh_find_none:
        xor rax, rax;

      xhci_bh_find_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xhci_bios_handoff(bar0) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64) -> u64
  //   rdi = BAR0 base.
  //
  // Returns rax = XHCI_HANDOFF_OK on success (or a no-op path where the
  // controller lacks USBLEGSUP), XHCI_HANDOFF_TIMEOUT on 1s timeout.
  //
  // On success, also invokes xhci_disable_smi (#944) with the located
  // USBLEGSUP offset so the two operations always land together — the
  // spec requires the OS to disable SMI sources before enabling
  // interrupts on the controller, and separating them is a well-known
  // recipe for platform-specific SMI storms on Intel PCH.
  //
  // Register plan (3-push callee-save + 8-byte align):
  //   rbx = bar0
  //   r12 = usblegsup_addr (absolute MMIO ptr, saved across polls)
  //   r13 = spin counter
  //
  //   3 pushes = 24 B; entry rsp%16==8 -> 32; sub rsp, 8 -> 40, %16==8.
  //   Actually we need %16==0 pre-call: 24 pushes + 8 pad = 32 -> %16==0.
  //   Wait: entry rsp%16==8 (SysV callee has rsp%16==8 on entry). After
  //   3 pushes (24 B) rsp%16==0. No extra pad needed. Drop the sub 8.

  pub let xhci_bios_handoff : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-003 (#943). USBLEGSUP BIOS -> OS handoff sequence per xHCI 1.2 §7.1.1. Body: (1) 3-push callee-save (rbx=bar0, r12=usblegsup_addr, r13=spin) — 24 B; entry rsp%16==8 -> 32, %16==0 (aligned for nested calls without extra pad). (2) rbx = bar0. Locate USBLEGSUP: mov rdi,rbx; call xhci_find_usblegsup -> rax. If rax == 0 -> return XHCI_HANDOFF_OK (no legacy support cap present; nothing to hand off — the qemu-xhci fixture also exposes this path when built without --legacy). Save rax in r12. (3) Read USBLEGSUP: xhci_mmio_u32(r12) -> rax. Set OS Owned bit (bit 24): or rax, 0x01000000. Write back: xhci_mmio_write_u32(r12, rax). (4) Poll BIOS Owned (bit 16) until cleared: init r13 = XHCI_HANDOFF_SPIN_MAX. Loop { rax = xhci_mmio_u32(r12); if (rax & 0x10000) == 0 -> success; dec r13; if r13 == 0 -> return XHCI_HANDOFF_TIMEOUT }. (5) On success: emit klog_s1_x1(INFO, XHCI, tag_xhci_handoff, k_xecp, r12) fingerprint and disable SMI sources by tail-calling xhci_disable_smi(bar0, r12) so #943 and #944 are inseparable. (6) Return 0. Encoder: `or rax, 0x01000000` (bit-24 set) is imm32; `and rax, 0x10000` bit-16 test is imm32. Reserved labels: `xhci_bh_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                            // rbx = bar0

        // Locate USBLEGSUP.
        mov rdi, rbx;
        call xhci_find_usblegsup;
        cmp rax, 0;
        je xhci_bh_ok_no_legsup;
        mov r12, rax;                            // r12 = usblegsup MMIO addr

        // Read USBLEGSUP; set OS Owned; write back.
        mov rdi, r12;
        call xhci_mmio_u32;
        or rax, 0x01000000;                      // XHCI_USBLEGSUP_OS_OWNED
        mov rdi, r12;
        mov rsi, rax;
        call xhci_mmio_write_u32;

        // Poll BIOS Owned (bit 16) until clear.
        mov r13, 6600000;                        // XHCI_HANDOFF_SPIN_MAX

      xhci_bh_poll:
        mov rdi, r12;
        call xhci_mmio_u32;
        mov r10, rax;
        and r10, 0x10000;                        // XHCI_USBLEGSUP_BIOS_OWNED
        cmp r10, 0;
        je xhci_bh_poll_done;

        sub r13, 1;
        cmp r13, 0;
        je xhci_bh_timeout;
        jmp xhci_bh_poll;

      xhci_bh_poll_done:
        // Emit "XHCI HANDOFF xecp=<addr>".
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_xhci_handoff];
        lea rcx, [rip + k_xecp];
        mov r8, r12;                             // v1 = usblegsup addr
        call klog_s1_x1;

        // Disable SMI sources per #944 (couple #943 + #944 by construction).
        mov rdi, rbx;                            // bar0
        mov rsi, r12;                            // usblegsup MMIO addr
        call xhci_disable_smi;

        xor rax, rax;                            // XHCI_HANDOFF_OK
        jmp xhci_bh_done;

      xhci_bh_ok_no_legsup:
        xor rax, rax;                            // OK: nothing to hand off
        jmp xhci_bh_done;

      xhci_bh_timeout:
        mov rax, 3;                              // XHCI_HANDOFF_TIMEOUT

      xhci_bh_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xhci_disable_smi(bar0, usblegsup_addr) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, usblegsup_addr: u64) -> u64
  //   rdi = BAR0 base (unused here; carried for API symmetry with future
  //         debug helpers that need to correlate USBLEGCTLSTS back to the
  //         controller).
  //   rsi = absolute MMIO address of the USBLEGSUP cap header (as
  //         returned by xhci_find_usblegsup).
  //
  // Returns rax = XHCI_HANDOFF_OK (0). This function cannot fail — it
  // is a simple read-mask-write RMW into a controller-local RW1C
  // register.
  //
  // Register plan (2-push callee-save + 8 align):
  //   rbx = usblegsup_addr
  //   rbp = usblegctlsts value (pre-modify)
  //
  //   2 pushes = 16 B; entry rsp%16==8 -> 24; sub rsp, 8 -> 32, %16==0.

  pub let xhci_disable_smi : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, usblegsup_addr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-004 (#944). Clear USBLEGCTLSTS SMI-enable bits (0..15) and clear the RW1C status bits (29..31) by writing 1 to them, per xHCI 1.2 §7.1.2 and the Linux xhci-pci.c pattern. Body: (1) 2-push callee-save (rbx=usblegctlsts_addr, rbp=val) — 16 B; entry rsp%16==8 -> 24; sub rsp,8 -> 32, %16==0 (aligned for nested xhci_mmio_u32 / xhci_mmio_write_u32 / klog_s1_x1). (2) Compute usblegctlsts address = usblegsup_addr + 4 into rbx. (3) Read current USBLEGCTLSTS: mov rdi, rbx; call xhci_mmio_u32 -> rax. Save in rbp. (4) Compute new value: mask &= 0xFFFF0000 (clears enable bits [0..15], preserves reserved middle bits [16..28] at their observed values, preserves RW1C status bits [29..31] at their observed values), then OR |= 0xE0000000 (writes 1 to bits [29..31] so the RW1C semantics of USBLEGCTLSTS clear each pending SMI status latch). (5) Write back: xhci_mmio_write_u32(rbx, new_val). (6) Emit klog_s1_x1(INFO, XHCI, tag_xhci_smi, k_xecp, usblegsup_addr) fingerprint. (7) Return 0. bar0 (rdi) is discarded — kept in the signature for the R26.M2 debug helper that will emit `bar0=<addr> ctlsts=<val>` correlations. Encoder: `and rax, 0xFFFF0000` and `or rax, 0xE0000000` are both imm32 forms; sign extension is not an issue because 0xFFFF0000 and 0xE0000000 both have bit 31 set only in the sign-extended representation, which is fine — the resulting 64-bit AND/OR mask covers the desired 32-bit MMIO word (upper 32 bits of the 64-bit value are dropped by the mov_d store in xhci_mmio_write_u32). Reserved labels: `xhci_sm_`.",
      block: {
        push rbx;
        push rbp;
        sub rsp, 8;

        // rbx = usblegctlsts addr = usblegsup + 4.
        mov rbx, rsi;
        add rbx, 4;                              // XHCI_USBLEGCTLSTS_OFFSET

        // Read USBLEGCTLSTS.
        mov rdi, rbx;
        call xhci_mmio_u32;
        mov rbp, rax;                            // preserved for optional witness

        // Compute new value: (old & 0xFFFF0000) | 0xE0000000.
        //
        // Both immediates are the sign-extended 64-bit form of the
        // desired 32-bit mask (0xFFFF0000 and 0xE0000000 both have bit
        // 31 set). The MMIO store in xhci_mmio_write_u32 uses mov_d
        // (4-byte dword store), so any upper-32 bits in rax are
        // discarded on write — the low 32 bits carry the intended
        // (val & 0xFFFF0000) | 0xE0000000 pattern exactly.
        and rax, 0xFFFFFFFFFFFF0000;             // clear SMI enable bits [0..15]
        or rax, 0xFFFFFFFFE0000000;              // W1C the RW1C status bits [29..31]

        // Write back.
        mov rdi, rbx;
        mov rsi, rax;
        call xhci_mmio_write_u32;

        // Emit "XHCI SMI xecp=<addr>".
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_xhci_smi];
        lea rcx, [rip + k_xecp];
        mov r8, rbx;                             // v1 = usblegctlsts addr
        call klog_s1_x1;

        xor rax, rax;                            // XHCI_HANDOFF_OK
        add rsp, 8;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
