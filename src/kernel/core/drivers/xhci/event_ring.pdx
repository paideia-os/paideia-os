// src/kernel/core/drivers/xhci/event_ring.pdx — R26-M2-003 (#948)
//
// xHCI Event Ring + Event Ring Segment Table (ERST) — a HC-produced,
// software-consumed ring of TRBs used to signal command completion,
// transfer completion, and port-status change events for Interrupter 0.
//
// -----------------------------------------------------------------------------
// Layout (xHCI 1.2 §4.9.4)
// -----------------------------------------------------------------------------
//
// The Event Ring is not a contiguous ring like the Command/Transfer
// rings. Instead, it is composed of one or more *segments* whose base
// addresses and sizes are enumerated in the Event Ring Segment Table
// (ERST). Software programs the ERSTBA register with the ERST base,
// and the HC walks the ERST when its cursor crosses a segment boundary.
//
// For the MVP we use a single 256-TRB segment (4 KiB), which is more
// than enough for boot-time command completion + a handful of port
// status events. Larger segments land in R26.M3 once the driver-attach
// wraparound path is exercised under load.
//
// ERST entry format (§6.5, 16 bytes):
//
//   +0    u64  Ring Segment Base Address (segment_pa; 64-byte aligned)
//   +8    u32  Ring Segment Size          (# TRBs in the segment; 16..4096)
//   +12   u32  Reserved
//
// Runtime register set (per §5.5, at RTS_BASE + 0x20 + N*0x20 for
// Interrupter N):
//
//   +0    u32  IMAN — Interrupter Management
//                bit 0  IP  Interrupt Pending (RW1C)
//                bit 1  IE  Interrupt Enable
//   +4    u32  IMOD — Interrupt Moderation
//                bits [15:0]  IMODI  interval, 250 ns units
//                bits [31:16] IMODC  down counter (RO)
//   +8    u32  ERSTSZ — Event Ring Segment Table Size
//                bits [15:0]  # segments in ERST (1..HCSPARAMS2.ERST_MAX)
//   +12   u32  Reserved
//   +16   u64  ERSTBA — Event Ring Segment Table Base Address
//                bits [63:6]  ERST base (64-byte aligned)
//   +24   u64  ERDP — Event Ring Dequeue Pointer
//                bits [63:4]  current dequeue PA (16-byte aligned)
//                bit  3       EHB  Event Handler Busy (RW1C, must be
//                             written to clear on every ERDP update
//                             per §4.17.5)
//                bits [2:0]   DESI Dequeue ERST Segment Index
//
// -----------------------------------------------------------------------------
// event_ring_ctx layout (32 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u64  ring_pa       — segment 0 base PA
//   +8    u64  ring_va       — segment 0 base VA (== PA under identity map)
//   +16   u16  dequeue_idx   — current SW dequeue index within segment 0
//   +18   u8   cycle_bit     — expected Cycle-bit for next event (start = 1)
//   +19   u8   _pad0
//   +20   u32  size          — # TRBs per segment (256)
//   +24   u64  _reserved
//
// -----------------------------------------------------------------------------
// R26.M2 posture: dormant at boot
// -----------------------------------------------------------------------------
//
// Same as cmd_ring: no MCFG under BIOS/-kernel means the probe finds 0
// controllers and xhci_event_ring_init is never invoked. Symbols exist
// for R26.M3 driver-attach.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sized stores via mov_b / mov_w / mov_d.
//
// Reserved-label discipline: `xhci_er_`.

module EventRing = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let XHCI_EVT_RING_TRBS        : u64 = 256
  pub let XHCI_EVT_RING_BYTES       : u64 = 4096
  pub let XHCI_ERST_ENTRIES         : u64 = 4          // room for R26.M3 growth
  pub let XHCI_ERST_ENTRY_SIZE      : u64 = 16
  pub let XHCI_ERST_BYTES           : u64 = 64         // 4 * 16

  // Runtime-register offsets (relative to per-Interrupter base @ RTS+0x20).
  pub let XHCI_INT_OFF_IMAN         : u64 = 0
  pub let XHCI_INT_OFF_IMOD         : u64 = 4
  pub let XHCI_INT_OFF_ERSTSZ       : u64 = 8
  pub let XHCI_INT_OFF_ERSTBA       : u64 = 16
  pub let XHCI_INT_OFF_ERDP         : u64 = 24

  // IMAN bits.
  pub let XHCI_IMAN_IP              : u64 = 0x1
  pub let XHCI_IMAN_IE              : u64 = 0x2

  // Default IMOD (moderation) — 4000 ns = 16 * 250 ns units = 0x10 in
  // low 16 bits. Linux default is 0xFA0 (1 ms) which is far too coarse
  // for boot-time completion latency. 0x10 keeps completion visible
  // within microseconds of the HC posting.
  pub let XHCI_IMOD_DEFAULT         : u64 = 0x10

  // ERDP EHB bit — must be written =1 on every ERDP update to
  // acknowledge the pending event batch (RW1C per §4.17.5).
  pub let XHCI_ERDP_EHB             : u64 = 0x8

  // event_ring_ctx offsets.
  pub let XHCI_ER_CTX_RING_PA       : u64 = 0
  pub let XHCI_ER_CTX_RING_VA       : u64 = 8
  pub let XHCI_ER_CTX_DEQ_IDX       : u64 = 16
  pub let XHCI_ER_CTX_CYCLE_BIT     : u64 = 18
  pub let XHCI_ER_CTX_SIZE_FIELD    : u64 = 20
  pub let XHCI_ER_CTX_SIZE          : u64 = 32

  // Per-Interrupter base = RTS + 0x20 + N*0x20. For Interrupter 0: RTS+0x20.
  pub let XHCI_INT0_BASE_FROM_RTS   : u64 = 0x20

  // ============================================================================
  // Canonical .bss storage
  // ============================================================================
  //
  //   _xhci_event_ring     : 256 * 16 B = 4096 B (single segment).
  //                          @align(64) per xHCI 1.2 §4.9.4.1.
  //   _xhci_erst           : 4 * 16 B = 64 B ERST table.
  //                          @align(64) per xHCI 1.2 §6.5.
  //   _xhci_event_ring_ctx : 32 B = 4 * u64.

  pub let mut _xhci_event_ring       : [u64; 512] = uninit @align(64)
  pub let mut _xhci_erst             : [u64; 8]   = uninit @align(64)
  pub let mut _xhci_event_ring_ctx   : [u64; 4]   = uninit @align(8)

  // ============================================================================
  // xhci_event_ring_init(bar0, ctx) -> ()
  // ============================================================================
  //
  // SysV: (bar0: u64, ctx: u64) -> ()
  //   rdi = BAR0 base
  //   rsi = pointer to a 32-byte event_ring_ctx (writable)
  //
  // Body:
  //   (1) Zero-fill _xhci_event_ring (4096 B) and _xhci_erst (64 B).
  //   (2) ERST[0] = { segment_base_pa = event_ring_pa, size = 256,
  //                   reserved = 0 }.
  //       ERST[1..3] stay zero — HC uses ERSTSZ (=1 here) to know the
  //       enumerated table length.
  //   (3) Populate ctx: ring_pa, ring_va, dequeue_idx=0, cycle_bit=1
  //       (matches HC's initial cycle state per §4.9.4.1), size=256.
  //   (4) Locate the runtime register base: rts_base = bar0 +
  //       xhci_cap_u32(bar0, RTSOFF=0x18). Interrupter-0 base = rts +
  //       0x20 — passed as op_base to xhci_op_write_u32 / _u64.
  //   (5) Program Interrupter-0 registers in the ORDER MANDATED by
  //       xHCI 1.2 §4.17.5:
  //         ERSTSZ (u32 @ +8)     = 1
  //         ERDP   (u64 @ +24)    = ring_pa | EHB
  //         ERSTBA (u64 @ +16)    = erst_pa            ← last, per spec
  //         IMOD   (u32 @ +4)     = 0x10               (moderation)
  //         IMAN   (u32 @ +0)     = IE | IP            (enable + clear)
  //       ERSTBA must be programmed *after* ERSTSZ and ERDP so the HC
  //       consistency check at ERSTBA-write time sees a coherent view.
  //
  // Register plan (5-push callee-save):
  //   rbx = bar0
  //   rbp = ctx
  //   r12 = int0_base (rts + 0x20)
  //   r13 = ring_pa   (== &_xhci_event_ring)
  //   r14 = erst_pa   (== &_xhci_erst)
  //
  //   5 pushes = 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for
  //   every nested rep_stosb / xhci_cap_u32 / xhci_op_write_u32 /
  //   xhci_op_write_u64 call).

  pub let xhci_event_ring_init : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (bar0: u64, ctx: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M2-003 (#948). Event-ring + ERST substrate + Interrupter-0 programming per xHCI 1.2 §4.9.4 / §4.17.5. Body: (1) 5-push callee-save prologue (rbx=bar0, rbp=ctx, r12=int0_base, r13=ring_pa, r14=erst_pa) — 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every nested call). (2) rep_stosb-zero the 4096-byte event ring: rdi=lea &_xhci_event_ring, rax=0, rcx=4096, cld. Repeat for _xhci_erst (64 B). rep_stosb clobbers rdi/rax/rcx; rbx/rbp/r12-r14 survive per SysV. (3) ring_pa = lea &_xhci_event_ring (identity-map alias). erst_pa = lea &_xhci_erst. Save in r13/r14. (4) ERST[0]: store segment_base_pa (u64 @ erst+0) = r13; store size (u32 @ erst+8) = 256 via mov_d; reserved (u32 @ erst+12) = 0 via mov_d. (5) Populate ctx: ring_pa @+0, ring_va @+8, dequeue_idx @+16 (u16=0), cycle_bit @+18 (u8=1), _pad @+19 (u8=0), size @+20 (u32=256), _reserved @+24 (u64=0). (6) rts_base = bar0 + xhci_cap_u32(bar0, 0x18). int0_base = rts_base + 0x20. Save in r12. (7) Program Interrupter-0 registers in spec-mandated order (ERSTSZ first, ERDP, ERSTBA last, then IMOD, IMAN) — the ERSTBA-last discipline (§4.17.5) prevents the HC from starting to walk a partially-programmed ERST. Each program is: ERSTSZ = xhci_op_write_u32(int0_base, 8, 1); ERDP = xhci_op_write_u64(int0_base, 24, ring_pa|EHB=0x8); ERSTBA = xhci_op_write_u64(int0_base, 16, erst_pa); IMOD = xhci_op_write_u32(int0_base, 4, 0x10); IMAN = xhci_op_write_u32(int0_base, 0, IE|IP=0x3). Writing IMAN with IE=1 and IP=1 simultaneously enables interrupts and clears any pending latch from prior firmware ownership. Every accessor internally mfence-brackets. Reserved labels: `xhci_er_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // rbx = bar0
        mov rbp, rsi;                            // rbp = ctx

        // ================================================================
        // (2) Zero-fill event ring + ERST.
        // ================================================================
        lea rdi, [rip + _xhci_event_ring];
        xor rax, rax;
        mov rcx, 4096;
        cld;
        rep_stosb;

        lea rdi, [rip + _xhci_erst];
        xor rax, rax;
        mov rcx, 64;
        cld;
        rep_stosb;

        // ================================================================
        // (3) Anchor ring_pa and erst_pa.
        // ================================================================
        lea r13, [rip + _xhci_event_ring];
        lea r14, [rip + _xhci_erst];

        // ================================================================
        // (4) ERST[0] = { ring_pa, 256, 0 }.
        // ================================================================
        // segment_base_pa (u64 @ +0)
        mov [r14 + 0], r13;

        // size (u32 @ +8) = 256
        mov rax, 256;
        mov_d [r14 + 8], rax;

        // reserved (u32 @ +12) = 0
        xor rax, rax;
        mov_d [r14 + 12], rax;

        // ================================================================
        // (5) Populate ctx.
        // ================================================================
        // ring_pa @+0
        mov [rbp + 0], r13;

        // ring_va @+8
        mov [rbp + 8], r13;

        // dequeue_idx @+16 (u16) = 0
        xor rax, rax;
        mov_w [rbp + 16], rax;

        // cycle_bit @+18 (u8) = 1
        mov rax, 1;
        mov_b [rbp + 18], rax;

        // _pad0 @+19 (u8) = 0
        xor rax, rax;
        mov_b [rbp + 19], rax;

        // size @+20 (u32) = 256
        mov rax, 256;
        mov_d [rbp + 20], rax;

        // _reserved @+24 (u64) = 0
        xor rax, rax;
        mov [rbp + 24], rax;

        // ================================================================
        // (6) rts_base = bar0 + RTSOFF; int0_base = rts_base + 0x20.
        // ================================================================
        mov rdi, rbx;
        mov rsi, 24;                             // XHCI_CAP_RTSOFF = 0x18
        call xhci_cap_u32;
        mov r12, rbx;
        add r12, rax;                            // r12 = rts_base
        add r12, 32;                             // r12 = int0_base

        // ================================================================
        // (7) Program Interrupter 0 (ERSTSZ → ERDP → ERSTBA → IMOD → IMAN).
        //     ERSTBA must land AFTER ERSTSZ and ERDP per §4.17.5.
        // ================================================================
        // ERSTSZ (u32 @ +8) = 1
        mov rdi, r12;
        mov rsi, 8;
        mov rdx, 1;
        call xhci_op_write_u32;

        // ERDP (u64 @ +24) = ring_pa | EHB
        mov rdi, r12;
        mov rsi, 24;
        mov rdx, r13;
        or  rdx, 8;                              // EHB bit
        call xhci_op_write_u64;

        // ERSTBA (u64 @ +16) = erst_pa
        mov rdi, r12;
        mov rsi, 16;
        mov rdx, r14;
        call xhci_op_write_u64;

        // IMOD (u32 @ +4) = 0x10 (4 us moderation)
        mov rdi, r12;
        mov rsi, 4;
        mov rdx, 16;                             // XHCI_IMOD_DEFAULT
        call xhci_op_write_u32;

        // IMAN (u32 @ +0) = IE | IP (enable + clear pending latch)
        mov rdi, r12;
        xor rsi, rsi;
        mov rdx, 3;                              // IE(2) | IP(1)
        call xhci_op_write_u32;

        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
