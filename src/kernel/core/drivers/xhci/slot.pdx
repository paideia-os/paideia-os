// src/kernel/core/drivers/xhci/slot.pdx — R26-M3-003+005 (#953, #955)
//
// xHCI slot lifecycle commands: Enable Slot (allocate a device slot ID
// and pin it to a Device Context) + Address Device (bind the slot to
// a USB bus address so subsequent control transfers can address it).
//
// Both commands are one-TRB enqueue-then-wait sequences on the command
// ring built in cmd_ring.pdx, completed via a Command Completion Event
// TRB (type 33) posted by the HC onto the event ring built in
// event_ring.pdx.
//
// -----------------------------------------------------------------------------
// Enable Slot (xHCI 1.2 §4.6.3 / §6.4.3.2)
// -----------------------------------------------------------------------------
//
//   TRB Type         = 9
//   Parameter        = 0
//   Status           = 0
//   Control (no C)   = (9 << 10) | (SlotType << 16)
//                       — SlotType = 0 for USB2/USB3 (Slot Types Table
//                         6-24 lists reserved 1..15 for future non-USB
//                         protocol offloads — always 0 for us).
//
// Completion event (§6.4.2.2 Command Completion Event):
//
//   TRB Type   (bits 10..15 of Control)  = 33
//   Slot ID    (bits 24..31 of Control)  — the newly-allocated ID
//   Completion Code (bits 24..31 of Status)  — 1 = SUCCESS
//
// -----------------------------------------------------------------------------
// Address Device (xHCI 1.2 §4.6.5 / §6.4.3.4)
// -----------------------------------------------------------------------------
//
//   TRB Type         = 11
//   Parameter        = input_ctx_pa   (64-byte-aligned Input Context PA)
//   Status           = 0
//   Control (no C)   = (11 << 10) | (BSR << 9) | (SlotID << 24)
//                       BSR (Block Set Address Request):
//                         0 = normal — HC issues the USB SET_ADDRESS
//                             transaction over the wire.
//                         1 = deferred — HC transitions the slot to
//                             Addressed state WITHOUT issuing
//                             SET_ADDRESS. Used when the driver wants
//                             to fetch the device descriptor at
//                             address 0 first (to learn the actual
//                             EP0 MPS) before assigning an address.
//
// Both commands rely on the caller having populated the slot's Input
// Context (see context.pdx). Address Device with BSR=0 also requires
// the EP0 Transfer Ring to be programmed into the Input Context's
// TR Dequeue Pointer field — that allocation lands at R26.M4. For now
// the intended usage is BSR=1 (defer SET_ADDRESS).
//
// -----------------------------------------------------------------------------
// Completion-event poll discipline
// -----------------------------------------------------------------------------
//
// The event ring is a single 256-TRB segment (see event_ring.pdx). The
// per-slot dequeue index and expected cycle bit live in event_ctx.
// Polling loop:
//
//   (1) Load current dequeue_idx + expected cycle_bit from event_ctx.
//   (2) trb_addr = event_ring_va + dequeue_idx * 16.
//   (3) Read Control word (u32 @ trb_addr + 12).
//   (4) If C bit differs from expected cycle_bit: HC has not yet
//       posted — spin (bounded).
//   (5) Otherwise the TRB is SW-owned:
//         - Check TRB Type = 33 (CCE); other types get error return.
//         - Extract Slot ID / Completion Code as needed.
//   (6) Advance dequeue_idx (with segment wrap: idx == 256 → toggle
//       cycle_bit, reset idx = 0). Persist back to event_ctx.
//
// ERDP update (writing the new dequeue address back into the runtime
// register + acknowledging EHB) is DEFERRED to a per-controller
// interrupt-service worker in R26.M4. The M3 dormant path only
// exercises SW-side bookkeeping.
//
// -----------------------------------------------------------------------------
// bar0 parameter rationale
// -----------------------------------------------------------------------------
//
// Ringing DB[0] requires bar0. cmd_ring_ctx does not carry bar0 (the
// ring is memory-only from its perspective — DCBAA / CRCR programming
// happens at ring-init time). Rather than back-extend the ctx layout,
// bar0 is passed as an explicit argument — it's the same value the
// caller already has to hand off to xhci_probe / xhci_reset. This
// keeps the ctx a pure memory-side descriptor.
//
// -----------------------------------------------------------------------------
// Return semantics
// -----------------------------------------------------------------------------
//
//   xhci_enable_slot returns:
//     0             success (slot_id written to *out_slot_id)
//     1             wrong TRB type came back
//     2             timeout — HC never posted a completion
//     0x100..0x1FF  non-success completion code (Ored with 0x100)
//
//   xhci_address_device returns 0/1/2/0x100..0x1FF with the same
//   semantics.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: sized u16/u8 stores + zero-extended sub-8-byte loads.
//
// Reserved-label discipline: `xhci_es_` (enable slot), `xhci_ad_`
// (address device).

module Slot = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  // Command-Completion-Event TRB type (Event ring §6.4.2.2 Table 6-45).
  pub let XHCI_TRB_TYPE_CCE          : u64 = 33

  // Enable Slot command control: (9 << 10) | (SlotType=0 << 16) = 0x2400.
  pub let XHCI_ENABLE_SLOT_CTRL_NC   : u64 = 0x2400

  // Address Device command control base: (11 << 10) = 0x2C00.
  // BSR bit is at bit 9 (0x200); Slot ID field starts at bit 24.
  pub let XHCI_ADDRESS_DEVICE_CTRL_NC_BASE : u64 = 0x2C00
  pub let XHCI_ADDRESS_DEVICE_BSR    : u64 = 0x200

  // Completion Code (Status bits 24..31) SUCCESS.
  pub let XHCI_CC_SUCCESS            : u64 = 1

  // Event ring polling budget — matches xhci_reset's XHCI_RESET_SPIN_MAX.
  pub let XHCI_SLOT_POLL_SPIN_MAX    : u64 = 5000000

  // Event ring segment size (single-segment layout inherited from
  // event_ring.pdx). Kept as a local copy so wraparound math doesn't
  // reach across module boundaries at each callsite.
  pub let XHCI_EVT_SEG_TRBS          : u64 = 256

  // Return codes.
  pub let XHCI_SLOT_OK               : u64 = 0
  pub let XHCI_SLOT_ERR_TYPE         : u64 = 1     // wrong TRB type on ring
  pub let XHCI_SLOT_ERR_TIMEOUT      : u64 = 2     // HC never posted

  // ============================================================================
  // xhci_enable_slot(bar0, cmd_ctx, event_ctx, out_slot_id) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, cmd_ctx: u64, event_ctx: u64, out_slot_id: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = pointer to cmd_ring_ctx
  //   rdx = pointer to event_ring_ctx
  //   rcx = pointer to u8 receiving the allocated slot ID
  //
  // Returns rax per the "Return semantics" section above.
  //
  // Register plan (6-push callee-save):
  //   rbx = bar0
  //   rbp = cmd_ctx
  //   r12 = event_ctx
  //   r13 = out_slot_id
  //   r14 = trb_addr / expected cycle_bit / spin  (repurposed across
  //         phases — see block comments below)
  //   r15 = expected cycle_bit
  //
  //   6 pushes = 48 B; entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0
  //   (aligned for every nested call).

  pub let xhci_enable_slot : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, cmd_ctx: u64, event_ctx: u64, out_slot_id: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-003 (#953). Enable Slot command sequence per xHCI 1.2 §4.6.3. Body: (1) 6-push callee-save (rbx=bar0, rbp=cmd_ctx, r12=event_ctx, r13=out_slot_id, r14=trb_addr/spin, r15=expected cycle) + sub rsp,8 align — 56 B; entry rsp%16==8 -> 64, %16==0 (aligned for every nested call). (2) Stash args in rbx/rbp/r12/r13. (3) Enqueue Enable Slot TRB: xhci_cmd_enqueue(rbp, param=0, status=0, ctrl_no_cycle=0x2400). (9 << 10) with SlotType=0. (4) Ring DB[0]: xhci_ring_cmd_doorbell(rbx). This publishes the enqueue to the HC. (5) Load event-ring polling state: r14 = event_ring_va + dequeue_idx * 16 = trb_addr; r15 = expected cycle bit (u8 @ event_ctx+18). (6) Spin loop budgeted by rax=5_000_000 iters. Each iter: read Control (u32 @ r14+12) via `mov ecx, [r14 + 12]` (zero-extends into rcx). Extract cycle (rcx & 1); compare with r15; jne no_event. On cycle match, extract TRB Type (rcx >> 10 & 0x3F); if != 33 return SLOT_ERR_TYPE. On CCE, extract Slot ID (rcx >> 24 & 0xFF) and store as u8 at *r13 via mov_b. (7) Advance dequeue_idx: rcx = u16 @ event_ctx+16; add 1; if == 256 (segment wrap) -> zero rcx and toggle r15 (persisted back at event_ctx+18); persist rcx at event_ctx+16 via mov_w. ERDP register update is deferred to R26.M4 interrupt worker. (8) Return 0. Failure paths: no_event dec rax; if 0 return SLOT_ERR_TIMEOUT. wrong_type return SLOT_ERR_TYPE. Non-success completion code (Status bits 24..31 != 1) returns (code | 0x100). Reserved labels: `xhci_es_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // bar0
        mov rbp, rsi;                            // cmd_ctx
        mov r12, rdx;                            // event_ctx
        mov r13, rcx;                            // out_slot_id ptr

        // (1) Enqueue Enable Slot TRB.
        mov rdi, rbp;
        xor rsi, rsi;                            // param = 0
        xor rdx, rdx;                            // status = 0
        mov rcx, 0x2400;                         // (9 << 10) | 0
        call xhci_cmd_enqueue;

        // (2) Ring DB[0].
        mov rdi, rbx;
        call xhci_ring_cmd_doorbell;

        // (3) Load polling state from event_ctx.
        mov r14, [r12 + 8];                      // event_ring_va
        xor rax, rax;
        mov_w rax, [r12 + 16];                   // dequeue_idx (u16)
        shl rax, 4;                              // idx * 16
        add r14, rax;                            // r14 = trb_addr

        xor r15, r15;
        mov_b r15, [r12 + 18];                   // expected cycle_bit

        mov rax, 5000000;                        // spin budget

      xhci_es_poll:
        // Read Control word (u32 @ trb_addr + 12).
        mov ecx, [r14 + 12];                     // zero-extends into rcx

        // Cycle compare.
        mov rdx, rcx;
        and rdx, 1;
        cmp rdx, r15;
        jne xhci_es_no_event;

        // TRB Type check (bits 10..15).
        mov rdx, rcx;
        shr rdx, 10;
        and rdx, 0x3F;
        cmp rdx, 33;                             // CCE
        jne xhci_es_wrong_type;

        // Check Completion Code at Status +8, bits 24..31.
        mov edx, [r14 + 8];
        shr rdx, 24;
        and rdx, 0xFF;
        cmp rdx, 1;                              // SUCCESS
        jne xhci_es_cc_err;

        // Extract Slot ID from Control bits 24..31.
        shr rcx, 24;
        and rcx, 0xFF;
        mov_b [r13 + 0], rcx;                    // *out_slot_id = slot_id

        // Advance dequeue_idx (with segment wrap).
        xor rcx, rcx;
        mov_w rcx, [r12 + 16];
        add rcx, 1;
        cmp rcx, 256;
        jne xhci_es_no_wrap;
        xor rcx, rcx;
        xor r15, 1;
        mov_b [r12 + 18], r15;
      xhci_es_no_wrap:
        mov_w [r12 + 16], rcx;

        xor rax, rax;                            // SLOT_OK
        jmp xhci_es_done;

      xhci_es_cc_err:
        // Non-success completion code — return (code | 0x100).
        or  rdx, 0x100;
        mov rax, rdx;
        jmp xhci_es_done;

      xhci_es_wrong_type:
        mov rax, 1;                              // SLOT_ERR_TYPE
        jmp xhci_es_done;

      xhci_es_no_event:
        sub rax, 1;
        cmp rax, 0;
        jne xhci_es_poll;
        mov rax, 2;                              // SLOT_ERR_TIMEOUT

      xhci_es_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xhci_address_device(bar0, cmd_ctx, event_ctx, slot_id,
  //                     input_ctx_pa, bsa) -> u64
  // ============================================================================
  //
  // SysV: (bar0, cmd_ctx, event_ctx, slot_id, input_ctx_pa, bsa) -> u64
  //   rdi = BAR0 base
  //   rsi = cmd_ring_ctx ptr
  //   rdx = event_ring_ctx ptr
  //   rcx = slot ID (1..64)
  //   r8  = input context PA (64-byte-aligned)
  //   r9  = Block Set Address Request bit (0 or 1)
  //
  // Returns rax per "Return semantics" (0 success, 1 wrong type, 2
  // timeout, 0x100+ completion code error).
  //
  // Register plan (6-push callee-save + 8 B align pad):
  //   rbx = bar0
  //   rbp = cmd_ctx
  //   r12 = event_ctx
  //   r13 = slot_id                    (preserved for control assembly)
  //   r14 = input_ctx_pa → trb_addr    (repurposed post-enqueue)
  //   r15 = bsa → expected cycle       (repurposed post-enqueue)
  //
  //   6 pushes = 48 B + sub rsp,8 = 56; entry rsp%16==8 -> 64, %16==0.

  pub let xhci_address_device : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, cmd_ctx: u64, event_ctx: u64, slot_id: u64, input_ctx_pa: u64, bsa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M3-005 (#955). Address Device command sequence per xHCI 1.2 §4.6.5. Body: (1) 6-push callee-save (rbx=bar0, rbp=cmd_ctx, r12=event_ctx, r13=slot_id, r14=input_ctx_pa/trb_addr, r15=bsa/cycle) + sub rsp,8 align — 56 B; entry rsp%16==8 -> 64, %16==0 (aligned for every nested call). (2) Stash all 6 args. (3) Compose Control (no cycle) = 0x2C00 | (bsa & 1) << 9 | (slot_id & 0xFF) << 24: mov rax, 0x2C00; mov rcx, r15; and rcx,1; shl rcx,9; or rax,rcx; mov rcx,r13; and rcx,0xFF; shl rcx,24; or rax,rcx. (4) Enqueue Address Device TRB: xhci_cmd_enqueue(cmd_ctx=rbp, param=input_ctx_pa=r14, status=0, ctrl_no_cycle=rax). Save the composed control isn't needed after enqueue. (5) Ring DB[0]: xhci_ring_cmd_doorbell(rbx). (6) Load event-ring polling state — r14 becomes trb_addr = event_ring_va + dequeue_idx*16; r15 becomes expected cycle bit from event_ctx+18. The prior r14/r15 values (input_ctx_pa/bsa) are no longer needed. (7) Spin poll (rax=5_000_000). Same discipline as xhci_enable_slot: cycle-match -> type check (== 33) -> completion-code check (== 1). (8) On success: advance dequeue_idx (with segment wrap), return 0. (9) Failure paths mirror xhci_enable_slot's return codes. Reserved labels: `xhci_ad_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // bar0
        mov rbp, rsi;                            // cmd_ctx
        mov r12, rdx;                            // event_ctx
        mov r13, rcx;                            // slot_id
        mov r14, r8;                             // input_ctx_pa
        mov r15, r9;                             // bsa

        // (1) Compose ctrl_no_cycle = 0x2C00 | (bsa << 9) | (slot_id << 24).
        mov rax, 0x2C00;

        mov rcx, r15;
        and rcx, 1;
        shl rcx, 9;
        or  rax, rcx;

        mov rcx, r13;
        and rcx, 0xFF;
        shl rcx, 24;
        or  rax, rcx;

        // (2) Enqueue Address Device TRB.
        mov rdi, rbp;                            // cmd_ctx
        mov rsi, r14;                            // param = input_ctx_pa
        xor rdx, rdx;                            // status = 0
        mov rcx, rax;                            // ctrl_no_cycle
        call xhci_cmd_enqueue;

        // (3) Ring DB[0].
        mov rdi, rbx;
        call xhci_ring_cmd_doorbell;

        // (4) Load polling state from event_ctx.
        mov r14, [r12 + 8];                      // event_ring_va
        xor rax, rax;
        mov_w rax, [r12 + 16];                   // dequeue_idx
        shl rax, 4;
        add r14, rax;                            // r14 = trb_addr

        xor r15, r15;
        mov_b r15, [r12 + 18];                   // expected cycle

        mov rax, 5000000;                        // spin budget

      xhci_ad_poll:
        mov ecx, [r14 + 12];                     // Control word

        mov rdx, rcx;
        and rdx, 1;
        cmp rdx, r15;
        jne xhci_ad_no_event;

        // TRB Type check.
        mov rdx, rcx;
        shr rdx, 10;
        and rdx, 0x3F;
        cmp rdx, 33;
        jne xhci_ad_wrong_type;

        // Completion Code check.
        mov edx, [r14 + 8];                      // Status word
        shr rdx, 24;
        and rdx, 0xFF;
        cmp rdx, 1;                              // SUCCESS
        jne xhci_ad_cc_err;

        // Advance dequeue_idx.
        xor rcx, rcx;
        mov_w rcx, [r12 + 16];
        add rcx, 1;
        cmp rcx, 256;
        jne xhci_ad_no_wrap;
        xor rcx, rcx;
        xor r15, 1;
        mov_b [r12 + 18], r15;
      xhci_ad_no_wrap:
        mov_w [r12 + 16], rcx;

        xor rax, rax;                            // SLOT_OK
        jmp xhci_ad_done;

      xhci_ad_cc_err:
        or  rdx, 0x100;
        mov rax, rdx;
        jmp xhci_ad_done;

      xhci_ad_wrong_type:
        mov rax, 1;
        jmp xhci_ad_done;

      xhci_ad_no_event:
        sub rax, 1;
        cmp rax, 0;
        jne xhci_ad_poll;
        mov rax, 2;

      xhci_ad_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
