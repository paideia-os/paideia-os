// src/kernel/core/drivers/xhci/hotplug.pdx — R26-M6-004 (#968)
//
// xHCI Port Status Change Event (PSCE) handler — attach + detach.
//
// -----------------------------------------------------------------------------
// PSCE Event TRB layout (xHCI 1.2 §6.4.2.3, Table 6-48)
// -----------------------------------------------------------------------------
//
//   DWORD 0 (Parameter Lo):
//     bits [23:0]   RsvdZ
//     bits [31:24]  Port ID           <- byte at TRB + 3
//   DWORD 1 (Parameter Hi):  RsvdZ
//   DWORD 2 (Status):
//     bits [23:0]   RsvdZ
//     bits [31:24]  Completion Code
//   DWORD 3 (Control):
//     bit  [0]      Cycle
//     bits [9:1]    RsvdZ
//     bits [15:10]  TRB Type = 34
//
// The event ring walker (R27 driver-attach path) filters TRB Type == 34
// and forwards the raw TRB PA to xhci_hotplug_handler_event.
//
// -----------------------------------------------------------------------------
// PORTSC change latches (xHCI 1.2 Table 5-27)
// -----------------------------------------------------------------------------
//
//   bit  0   CCS   Current Connect Status              (ROS)
//   bit 17   CSC   Connect Status Change               (RW1C)
//
// Attach edge:  CCS == 1  AND  CSC == 1
// Detach edge:  CCS == 0  AND  CSC == 1
// Spurious:     CSC == 0  — event without a change latch is a warm-reset
//                           side effect; log + clear.
//
// CSC is cleared by writing 1 back to bit 17 (RW1C). RW1C-preserving
// discipline is applied via xhci_port_write's internal mask (bits
// 17..23 all zero in the caller-supplied value; RW1C(0) is no-op),
// then bit 17 OR-ed into the write value.
//
// -----------------------------------------------------------------------------
// R26.M6 posture: dormant at boot; attach chain is documented as a TODO
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` QEMU boot there is no controller, no interrupter,
// no event ring walker — xhci_hotplug_handler_event is a callable ELF
// symbol that never fires. Under UEFI/OVMF + real T14 G4 hardware the
// caller path is:
//
//   xhci_irq_handler (R27) — walks event ring, filters TRB Type == 34,
//                            invokes xhci_hotplug_handler_event.
//
// The attach chain proper (xhci_port_reset -> xhci_enable_slot ->
// xhci_input_context_init -> xhci_address_device -> xhci_configure_ep_hid)
// requires a per-port slot ledger (port_id -> slot_id table) so that
// subsequent hotplug events for the same physical port can retrieve
// the right slot state. That ledger is R27 driver-attach scope.
//
// For R26.M6 this handler:
//
//   1. Extracts Port ID from the PSCE TRB.
//   2. Reads PORTSC.
//   3. Distinguishes attach / detach / spurious via CCS + CSC.
//   4. On attach:  calls xhci_port_reset(bar0, port) — returns
//                  negotiated speed (or 0 on failure). Emits fingerprint
//                  "XHCI HOTPLUG ATTACH port=<n> speed=<s>\n".
//   5. On detach:  emits fingerprint "XHCI HOTPLUG DETACH port=<n>\n".
//   6. Always:     clears CSC by writing bit 17 back through
//                  xhci_port_write (RW1C-preserving; other change
//                  latches PEC/WRC/OCC/PRC/PLC/CEC stay pending for
//                  the R27 driver-attach path to consume).
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   ATTACH_PREFIX   "XHCI HOTPLUG ATTACH port=" (25 B + \0)
//   DETACH_PREFIX   "XHCI HOTPLUG DETACH port=" (25 B + \0)
//   SPUR_PREFIX     "XHCI HOTPLUG SPURIOUS port=" (27 B + \0)
//   SPEED_INFIX     " speed="                    (7  B + \0)
//   NL              "\n"                         (1  B + \0)
//
// Port ID (0..127) and speed (0..15) are single-hex-nibble emissions
// via the shr+cmp+add classic pattern (see ap_entry.pdx L164 for the
// idiom that's been the standard since R18.M1).
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: zero-extended u8 load for the Port ID byte + PORTSC RMW via
//       existing xhci_op_u32 accessor.
//
// Reserved-label discipline: `xhci_hp_` (hotplug).

module Hotplug = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let XHCI_PORTSC_CCS_MASK          : u64 = 0x1
  pub let XHCI_PORTSC_CSC_MASK          : u64 = 0x20000       // bit 17
  pub let XHCI_PORTSC_CSC_BIT_POS       : u64 = 17

  // Port-register block base (op-window offset 0x400).
  pub let XHCI_PORTSC_BASE_OFF          : u64 = 0x400

  // Per-port stride.
  pub let XHCI_PORT_REG_STRIDE          : u64 = 0x10

  // TRB Type == 34 (PSCE) — checked by the caller path, exposed here for
  // symbol clarity and downstream event-ring walker code.
  pub let XHCI_TRB_TYPE_PSCE            : u64 = 34

  // ============================================================================
  // Fingerprint messages
  // ============================================================================

  pub let _xhci_hp_attach_msg   : [u8; 26] = "XHCI HOTPLUG ATTACH port=\0"
  pub let _xhci_hp_detach_msg   : [u8; 26] = "XHCI HOTPLUG DETACH port=\0"
  pub let _xhci_hp_spur_msg     : [u8; 28] = "XHCI HOTPLUG SPURIOUS port=\0"
  pub let _xhci_hp_speed_msg    : [u8; 8]  = " speed=\0"

  // ============================================================================
  // xhci_hp_emit_nibble(byte: u64) -> ()  [static helper]
  // ============================================================================
  //
  // SysV: rdi = value; emits low nibble as ASCII hex.
  //
  // Leaf — clobbers rax, rcx, rdi (call-site's responsibility to save).

  let xhci_hp_emit_nibble : (u64) -> () !{sysreg} @{boot} =
    fn (val: u64) -> unsafe {
      effects: { sysreg },
      capabilities: { boot },
      justification: "R26-M6-004 (#968) hex-nibble emission helper mirroring the ap_entry.pdx idiom (core/smp/ap_entry.pdx L134). Body: (1) push rbx (single callee-save keeps rsp%16==0 for uart_putc). (2) mov rax, rdi; and rax, 0xF — isolate low nibble. (3) cmp rax, 10; jae hp_letter; add rax, 0x30 (digit '0'..'9'); jmp emit. (4) hp_letter: add rax, 0x57 (letter 'a'..'f' = 0x61..0x66 = 10+0x57..15+0x57). (5) emit: mov rdi, rax; call uart_putc. (6) pop rbx; ret.",
      block: {
        push rbx;

        mov rax, rdi;
        and rax, 0xF;
        cmp rax, 10;
        jae xhci_hp_letter;
        add rax, 0x30;
        jmp xhci_hp_emit;

      xhci_hp_letter:
        add rax, 0x57;

      xhci_hp_emit:
        mov rdi, rax;
        call uart_putc;

        pop rbx;
        ret
      }
    }

  // ============================================================================
  // xhci_hotplug_handler_event(bar0, event_trb_pa) -> u64
  // ============================================================================
  //
  // SysV: (bar0: u64, event_trb_pa: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = Port Status Change Event TRB physical address
  //
  // Returns rax:
  //   0  spurious (CSC == 0)
  //   1  attach event (CCS=1, CSC=1)
  //   2  detach event (CCS=0, CSC=1)
  //
  // Register plan (6-push callee-save + 8 B align):
  //   rbx = bar0                       (survives every nested call)
  //   rbp = port_id (1..255)
  //   r12 = portsc snapshot            (scratch after CCS/CSC decode)
  //   r13 = classification (0=spur, 1=attach, 2=detach)
  //   r14 = negotiated speed (attach only)
  //   r15 = scratch
  //
  //   6 pushes = 48 B; entry rsp%16==8 -> 56, sub rsp,8 -> 64, %16==0
  //   (aligned for every nested SysV call).

  pub let xhci_hotplug_handler_event : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (bar0: u64, event_trb_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M6-004 (#968). Port Status Change Event handler per xHCI 1.2 §6.4.2.3 + §5.4.8. Body: (1) 6-push callee-save + sub rsp,8 align — 64 B; entry rsp%16==8 -> aligned for every nested call. (2) Stash bar0 in rbx. (3) Extract Port ID: PSCE TRB DWORD 0 bits [31:24]. `mov eax, [rsi + 0]` (u32 zero-ext into rax); `shr rax, 24`; `and rax, 0xFF`. Save in rbp. (4) Read PORTSC: rdi=rbx, rsi=rbp, call xhci_port_read -> rax. Save PORTSC in r12. (5) Classify: extract CCS = r12 & 1 (rcx); extract CSC = (r12 >> 17) & 1 (rdx). If CSC==0 (spurious): r13=0. Else if CCS==1: r13=1 (attach). Else r13=2 (detach). (6) On attach: call xhci_port_reset(bar0=rbx, port=rbp) -> speed. Save in r14. Emit `XHCI HOTPLUG ATTACH port=` then port hex, ` speed=`, speed hex, '\\n'. (7) On detach: r14=0. Emit `XHCI HOTPLUG DETACH port=` then port hex, '\\n'. (8) On spurious: emit `XHCI HOTPLUG SPURIOUS port=` then port hex, '\\n'. (9) Always: clear CSC by RMW: mov rax, r12; and rax, 0xFF01FFFF (mask RW1C latches to zero); or rax, 0x20000 (write 1 to CSC to clear). Call xhci_port_write(bar0=rbx, port=rbp, val=rax) — the port_write helper re-applies the RW1C mask so our OR sets CSC and the surrounding zeros are RW1C(0)=no-op. (10) Return classification in rax (from r13). Reserved labels: `xhci_hp_`.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // bar0

        // ---- (1) Extract Port ID from PSCE TRB DWORD 0 bits [31:24] ----
        mov eax, [rsi + 0];                      // zero-ext u32 -> rax
        shr rax, 24;
        and rax, 0xFF;
        mov rbp, rax;                            // rbp = port_id

        // ---- (2) Read PORTSC ----
        mov rdi, rbx;
        mov rsi, rbp;
        call xhci_port_read;
        mov r12, rax;                            // r12 = PORTSC snapshot

        // ---- (3) Classify ----
        mov rcx, r12;
        and rcx, 1;                              // CCS
        mov rdx, r12;
        shr rdx, 17;
        and rdx, 1;                              // CSC

        cmp rdx, 0;
        je  xhci_hp_spurious;

        cmp rcx, 1;
        je  xhci_hp_attach;

        // Fall through: CCS == 0, CSC == 1 -> detach.
        mov r13, 2;
        jmp xhci_hp_detach;

      xhci_hp_spurious:
        mov r13, 0;

        lea rdi, [rip + _xhci_hp_spur_msg];
        call uart_puts;

        // Emit port high nibble
        mov rdi, rbp;
        shr rdi, 4;
        call xhci_hp_emit_nibble;
        // Emit port low nibble
        mov rdi, rbp;
        call xhci_hp_emit_nibble;
        // Newline
        mov rdi, 0x0A;
        call uart_putc;
        jmp xhci_hp_clear_csc;

      xhci_hp_attach:
        mov r13, 1;

        // Reset port -> negotiated speed (or 0 on failure).
        mov rdi, rbx;
        mov rsi, rbp;
        call xhci_port_reset;
        mov r14, rax;                            // r14 = speed

        lea rdi, [rip + _xhci_hp_attach_msg];
        call uart_puts;

        mov rdi, rbp;
        shr rdi, 4;
        call xhci_hp_emit_nibble;
        mov rdi, rbp;
        call xhci_hp_emit_nibble;

        lea rdi, [rip + _xhci_hp_speed_msg];
        call uart_puts;

        mov rdi, r14;
        shr rdi, 4;
        call xhci_hp_emit_nibble;
        mov rdi, r14;
        call xhci_hp_emit_nibble;

        mov rdi, 0x0A;
        call uart_putc;

        // Attach-chain continuation (xhci_enable_slot ->
        // xhci_input_context_init -> xhci_address_device ->
        // xhci_configure_ep_hid) is R27 driver-attach scope — it needs a
        // port_id -> slot_id ledger that lives outside this handler.
        // The reset-only body here surfaces the speed number as the
        // observable proof that the M3 port-reset primitive fires on
        // the hotplug edge; downstream chain lands with the R27 wire.
        jmp xhci_hp_clear_csc;

      xhci_hp_detach:
        lea rdi, [rip + _xhci_hp_detach_msg];
        call uart_puts;

        mov rdi, rbp;
        shr rdi, 4;
        call xhci_hp_emit_nibble;
        mov rdi, rbp;
        call xhci_hp_emit_nibble;

        mov rdi, 0x0A;
        call uart_putc;

        // Detach-chain continuation (xhci_slot_disable + transfer-ring
        // teardown) is R27 driver-attach scope — same port_id -> slot_id
        // ledger dependency as the attach path.

      xhci_hp_clear_csc:
        // ---- (4) Clear CSC via port_write RMW ----
        //   Zero the RW1C latches in the base value, then OR bit 17
        //   (CSC clear = RW1C write of 1). xhci_port_write re-applies
        //   the 0xFF01FFFF mask internally — writing 0 to the other
        //   RW1C bits is a no-op so this preserves any pending change
        //   latches PEC/WRC/OCC/PRC/PLC/CEC for R27 consumers.
        mov rax, r12;
        and rax, 0xFF01FFFF;
        or  rax, 0x20000;

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, rax;
        call xhci_port_write;

        // ---- (5) Return classification ----
        mov rax, r13;

        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
