// src/kernel/core/drivers/xhci/hid_kbd_attach.pdx — R111.M5-018 (paideia-os #2370)
//
// HID boot-keyboard attach cascade.
//
// -----------------------------------------------------------------------------
// What this orchestrator does
// -----------------------------------------------------------------------------
//
// R111.M5-017 (xhci_attach_all — drivers/xhci/attach.pdx) brings up
// every discovered xHCI controller: BIOS handoff, HCRST, port-scan
// snapshot, and publishes one KIND_XHCI_CTRL cap per controller at
// slots 196..199 with target_ptr = bar0_va. R111.M5-018 is the next
// step in the T14 G4 input-substrate cascade: walk USB devices that
// have been enumerated over each attached controller, find the ones
// whose Interface descriptor advertises HID Boot Keyboard (class 0x03,
// subclass 0x01, protocol 0x01 — USB HID 1.11 §4.2), and drive the
// per-keyboard bring-up sequence:
//
//   (1) SET_PROTOCOL(0=Boot Protocol) via control endpoint (§7.2.6).
//   (2) SET_IDLE(duration=0, report_id=0) via control endpoint (§7.2.4)
//       — "no idle limit; report every state change" so the device
//       stops coalescing key-down events into a single polling window.
//   (3) Configure the interrupt-IN endpoint (EP1 IN Interrupt, DCI=3,
//       8-byte report per §B.1) via xhci_configure_ep_hid.
//   (4) Publish per-keyboard KIND_HID_KBD cap at slots 212..215 so a
//       future userspace HID server (blocked on #1015) can derive
//       against a valid endpoint pointer.
//   (5) Emit fingerprint `HID KBD ATTACH OK bdf=<h> iface=<n> ep=<h>`
//       per keyboard successfully brought up.
//
// If no controllers are present (typical -kernel/QEMU boot where
// _xhci_device_count == 0) or none has an enumerated device with an
// HID Boot Keyboard interface, emit `HID KBD NONE` and return 0.
//
// -----------------------------------------------------------------------------
// Substrate posture at this milestone
// -----------------------------------------------------------------------------
//
// USB device enumeration (per-port reset → xhci_enable_slot →
// xhci_address_device → xhci_get_descriptor_device →
// xhci_get_descriptor_config → xhci_parse_config_descriptor) is landed
// as functions in drivers/xhci/{slot, control_xfer, configure_ep}.pdx
// but is NOT yet wired into the boot cascade — the full per-controller
// event-ring worker + cmd_ring / event_ring / DCBA / per-slot Input
// Context allocation lives in R34+ substrate that has not landed a
// call site above this orchestrator. Consequently `_hid_kbd_devices`
// starts empty (`_hid_kbd_dev_count == 0`) on every current boot
// (QEMU -kernel, QEMU UEFI/OVMF, real T14 G4), so this orchestrator's
// only reachable arm today is the `HID KBD NONE` emit.
//
// The row-processing arm below is nonetheless landed in full: when a
// follow-up milestone (R111.M5-019 or the R34.M6+ USB-enumeration
// worker) populates `_hid_kbd_devices[i]` with the six pointers +
// four scalars needed to drive the bring-up sequence, this
// orchestrator picks them up unchanged — no changes to
// kernel_main.pdx, no changes to the fingerprint schema, no changes
// to the slot layout. The R111.M5-017 file's "orchestrator now,
// derivation gate later" posture (attach.pdx §Parent-cap discipline)
// applies to this file too: the KIND_HID_KBD leaf mint happens
// directly via cap_mint_write here; the future formal
// kind_hid_kbd derivation gate is a change to this file alone.
//
// -----------------------------------------------------------------------------
// IRQ path
// -----------------------------------------------------------------------------
//
// The current xHCI attach cascade does NOT program MSI-X vectors for
// per-controller interrupt endpoints (attach.pdx stops at BIOS handoff
// + reset + port-scan + cap-publish). The MSI-X + VT-d IR bring-up
// (msix_ir_bringup_all, kernel_main.pdx L513) programs the IRT for
// downstream NIC MSI-X routes, but no xHCI Transfer Event vector has
// a routing entry. Once that vector is wired, its ISR (a follow-on)
// will:
//
//   (a) read one 8-byte HID Boot Keyboard report out of the interrupt
//       endpoint's DMA buffer (an entry in `_hid_kbd_devices[i]` at
//       +32 = transfer_ring_ctx holds the ring; the ISR peels off
//       one completed Transfer Event and grabs the report_pa the
//       enqueued Normal TRB carried);
//   (b) call hid_process_report(report_pa) — hid_report.pdx §R26-M6-002
//       already handles rollover, edge detection, keymap translation
//       and TTY-bridge; the entire kbd->ASCII->tty path is already
//       audited and dormant.
//
// The R111.M5-018 landing therefore covers the CONTROL-transfer +
// endpoint-configuration + cap-publication half of the wire-up; the
// Transfer Event handler wire-up (item 5 in the task spec) is the
// remaining follow-on and lands atop this orchestrator without
// changes to this file.
//
// -----------------------------------------------------------------------------
// Slot layout (verified 2026-09-07 against grep -rhnE for _SLOT / _CAP_SLOT
// constants across src/kernel/**)
// -----------------------------------------------------------------------------
//
//   192   XHCI_ATTACH_BROKER_SLOT          (R111.M5-017)
//   196..199  XHCI_ATTACH_PUB_SLOT_BASE    (R111.M5-017, 4 slots)
//   200   E1000E_DEVICE_CAP_SLOT
//   201   E1000E_NIC_CAP_SLOT
//   208   HID_KBD_ATTACH_BROKER_SLOT       (new — this file)
//   212..215  HID_KBD_ATTACH_PUB_SLOT_BASE (new — 4 slots)
//   232   SL_GRANT_SLOT_BASE
//
// The 202..207 gap is deliberately left free for follow-on
// controller-adjacent brokers (e.g. mouse / gamepad HID class arms in
// R34.M4-003/004). 208 + 212..215 keep HID input contiguous but
// spaced apart from the E1000E block so a re-attach of one class
// does not race the broker column of the other. Note: values
// 200..206 already appear in core/cap/dispatch.pdx as
// DISPATCH_SLOT_* / DRIVER_OP_* op-code discriminators (dispatch
// ordinals, NOT cap_table indices — no collision).
//
// -----------------------------------------------------------------------------
// KIND_HID_KBD
// -----------------------------------------------------------------------------
//
// KIND_HID_KBD = 0x19D sits contiguous with the storage/controller
// cluster (0x198..0x19C: NVME_CONTROLLER, NVME_NAMESPACE,
// AHCI_CONTROLLER, AHCI_PORT, XHCI_CTRL) — the natural extension for
// an HID device kind derived over KIND_XHCI_CTRL. Verified free per
// grep -rhnE 'KIND_[A-Z0-9_]+\s*:\s*u64\s*=\s*0x19[DEF]|0x1(A[4-9]|B[013-9])'
// across src/kernel/** (2026-09-07). Reserved for the future formal
// derivation-gated kind_hid_kbd.pdx.
//
// -----------------------------------------------------------------------------
// _hid_kbd_devices row layout (128 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u64 bar0_va           — mapped controller BAR0 kernel VA
//                                  (matches KIND_XHCI_CTRL target_ptr;
//                                   forwarded to xhci_hid_set_boot_protocol,
//                                   xhci_hid_set_idle, xhci_configure_ep_hid,
//                                   and the leaf KIND_HID_KBD target_ptr
//                                   is transfer_ring so downstream cursor
//                                   readers dereference the ring, not bar0).
//   +8    u64 event_ctx         — event_ring_ctx pointer (per-controller)
//   +16   u64 cmd_ctx           — cmd_ring_ctx pointer (per-controller)
//   +24   u64 ep0_ring          — EP0 transfer_ring_ctx (per-slot Control)
//   +32   u64 transfer_ring     — EP1 IN Interrupt transfer_ring_ctx
//   +40   u64 input_ctx_pa      — 64-byte-aligned Input Context PA
//   +48   u64 slot_id           — 1..127 (device slot ID; stored as u64
//                                  for load-ease — SysV arg register)
//   +56   u64 iface             — bInterfaceNumber (0..N)
//   +64   u64 ep_addr           — bEndpointAddress (u8: bit 7 = dir_in,
//                                  bits 3..0 = ep_num — e.g. 0x81 for
//                                  EP1 IN)
//   +72   u64 packed_bdf        — bdf_pack output of parent controller's
//                                  seg/bus/dev/fn
//   +80..+127                    padding to a 128 B stride (shl 7)
//
// 4 rows × 128 B = 512 B = [u64; 64].
//
// -----------------------------------------------------------------------------
// Fingerprint contract
// -----------------------------------------------------------------------------
//
// Per keyboard successfully brought up:
//   HID KBD ATTACH OK bdf=0x<h> iface=0x<h> ep=0x<h>
//     bdf   = bdf_pack of the parent controller.
//     iface = bInterfaceNumber for the HID interface within the
//             device's Configuration descriptor (typically 0).
//     ep    = bEndpointAddress of the interrupt-IN endpoint
//             (typically 0x81; task spec says "ep2" but xHCI DCI
//             indexes distinguish IN vs OUT so the boot keyboard's
//             single interrupt-IN endpoint is EP1 IN => DCI 3 =>
//             bEndpointAddress 0x81).
//
// If no HID Boot Keyboard is found on any attached controller:
//   HID KBD NONE
//   hid_keyboard_attach_all returns 0.
//
// The "HID KBD ATTACH OK" tag carries an OK token and therefore trips
// the verify-fingerprint-coverage.sh gate. Since the 14-mode QEMU
// matrix boots via `-kernel` and the USB enumeration substrate is
// not yet wired above this orchestrator, `_hid_kbd_dev_count` stays
// 0 in every default mode; an allowlist entry in
// tools/verify-fingerprint-coverage.sh names the same real-HW-only
// posture the XHCI ATTACH OK / NVME ATTACH OK siblings use.
//
// -----------------------------------------------------------------------------
// Best-effort continuation
// -----------------------------------------------------------------------------
//
// SET_PROTOCOL / SET_IDLE / Configure Endpoint each return a status
// code (0 = success; 1/2/0x100+CC = various failure modes). Per-step
// failures are informational: this orchestrator does NOT skip
// downstream steps on a non-zero return, because (a) SET_IDLE failure
// on a device that does not implement it (some non-compliant
// keyboards STALL SET_IDLE) is common; (b) Configure Endpoint
// failure would surface downstream when the interrupt endpoint's
// Transfer Event never fires, and the operator would see key
// presses simply not reaching the TTY (a distinct observable
// symptom); (c) halting per-keyboard bring-up on partial failure
// would deny the operator the observability window that the
// fingerprint provides. The KIND_HID_KBD cap publish still fires so
// downstream observers can inspect the device state.
//
// -----------------------------------------------------------------------------
// Register plan + stack layout
// -----------------------------------------------------------------------------
//
// Callee-save prologue: push rbx, rbp, r12, r13, r14, r15 (6 × 8 = 48 B)
// then sub rsp, 40 (24 B klog scratch + 16 B pad). Entry rsp%16 == 8
// (SysV callee entry); post-prologue rsp%16 == (8 + 48 + 40) mod 16
// == 96 mod 16 == 0 — aligned for every nested call.
//
// Register roles across the outer (keyboard) loop:
//   rbx = i                  — cursor into _hid_kbd_devices (0..count).
//   rbp = &_hid_kbd_devices[i] — recomputed each iteration.
//   r12 = count              — _hid_kbd_dev_count latched once.
//   r13 = packed_bdf         — per-iter, survives to fingerprint emit.
//   r14 = successes          — accumulator returned in rax at exit.
//   r15 = scratch            — reserved for future use (kept in
//                              6-push prologue for 16-B alignment).
//
// Scratch layout ([rsp+0..rsp+39], 40 B):
//   [rsp+0]  = klog v2 (iface @ ATTACH OK)             → callee [rsp+8]
//   [rsp+8]  = klog k3 (&k_ep @ ATTACH OK)             → callee [rsp+16]
//   [rsp+16] = klog v3 (ep_addr @ ATTACH OK)           → callee [rsp+24]
//   [rsp+24..+39]                                       pad
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.36+)
// -----------------------------------------------------------------------------
//
//   G1: u64 loads via natural REX.W width (every _hid_kbd_devices
//       field is a full u64 lane — no sub-8-byte fields to zero-
//       extend). No test rN/rN (all compares are `cmp rax, imm8`
//       or `cmp reg, reg`). No 2-op `imul r,imm` (row stride 128
//       via `shl rax, 7`). No `and reg, imm64` (every immediate
//       used fits imm32: 0x21F / 0x1F / 0x19C / 0x19D / 208 / 212 /
//       3 / 1). No `cmp reg, [mem]` (all mem operands staged to
//       a register first).
//
// Reserved-label discipline: all labels prefixed `hid_kbd_at_` to
// avoid reserved names (`loop`, `if`, `done`, `next`).

module HidKbdAttach = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  // Maximum HID boot keyboards this orchestrator's row table can
  // hold. Four accommodates: laptop internal keyboard (T14 G4
  // built-in has an EC path but external USB keyboards land here) +
  // an external USB keyboard on each USB-A port + one dock-attached
  // keyboard. Silent overflow is fine: a fifth keyboard would
  // indicate an unusual topology worth a distinct diagnostic path.
  pub let HID_KBD_MAX_DEVS               : u64 = 4

  // Row stride (128 B — 16 u64 lanes; only the first 10 lanes are
  // used at this milestone, the tail reserved for future fields).
  pub let HID_KBD_DEV_ROW_SIZE           : u64 = 128

  // Slot 208 = rotating parent-broker KIND_XHCI_CTRL cap for the
  // future formal kind_hid_kbd derivation gate. Overwritten each
  // iteration. Disjoint from every claimed slot (see file header
  // §Slot layout).
  pub let HID_KBD_ATTACH_BROKER_SLOT     : u64 = 208

  // Slots 212..215 (4 slots, one per HID_KBD_MAX_DEVS row) =
  // per-keyboard KIND_HID_KBD cap. target_ptr holds the transfer
  // ring pointer so downstream readers (userspace HID server, once
  // #1015 lands) can dereference the ring for report peeking.
  pub let HID_KBD_ATTACH_PUB_SLOT_BASE   : u64 = 212

  // KIND_HID_KBD — sits in the storage/controller-kind cluster
  // (KIND_NVME_CONTROLLER=0x198, KIND_NVME_NAMESPACE=0x199,
  // KIND_AHCI_CONTROLLER=0x19A, KIND_AHCI_PORT=0x19B,
  // KIND_XHCI_CTRL=0x19C, this=0x19D). Reserved for the future
  // formal derivation-gated kind_hid_kbd.pdx.
  pub let KIND_HID_KBD                   : u64 = 0x19D

  // Row field offsets (128 B row, u64 lanes).
  pub let HID_KBD_ROW_BAR0_VA            : u64 = 0
  pub let HID_KBD_ROW_EVENT_CTX          : u64 = 8
  pub let HID_KBD_ROW_CMD_CTX            : u64 = 16
  pub let HID_KBD_ROW_EP0_RING           : u64 = 24
  pub let HID_KBD_ROW_TRANSFER_RING      : u64 = 32
  pub let HID_KBD_ROW_INPUT_CTX_PA       : u64 = 40
  pub let HID_KBD_ROW_SLOT_ID            : u64 = 48
  pub let HID_KBD_ROW_IFACE              : u64 = 56
  pub let HID_KBD_ROW_EP_ADDR            : u64 = 64
  pub let HID_KBD_ROW_PACKED_BDF         : u64 = 72

  // ==========================================================================
  // Canonical static slots — .bss, @align(8)
  // ==========================================================================
  //
  //   _hid_kbd_devices         : 4 × 128 B = 512 B = 64 × u64
  //   _hid_kbd_dev_count       : populated by the USB-enumeration worker
  //                              (deferred substrate — stays 0 today).

  pub let mut _hid_kbd_devices       : [u64; 64] = uninit @align(8)
  pub let mut _hid_kbd_dev_count     : u64       = 0

  // ==========================================================================
  // hid_keyboard_attach_all() -> u64
  // ==========================================================================
  //
  // SysV: () -> u64
  //   rax = number of HID boot keyboards successfully brought up
  //         (0..HID_KBD_MAX_DEVS=4). Zero indicates either "no USB
  //         HID Boot Keyboard reached the enumeration substrate"
  //         (fingerprint HID KBD NONE) or "every discovered keyboard
  //         failed the control-transfer sequence" (per-step failures
  //         are logged by the nested wrappers; the orchestrator does
  //         not itself emit per-failure fingerprints — see file
  //         header §Best-effort continuation).

  pub let hid_keyboard_attach_all : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot, cap },
      justification: "R111.M5-018 (paideia-os #2370): HID boot-keyboard attach orchestrator. Called from kernel_main_64 immediately after xhci_attach_all (kernel_main.pdx). Body: (1) 6-push callee-save prologue (rbx, rbp, r12, r13, r14, r15 - 48 B) + sub rsp, 40 for scratch (24 B klog stack-arg region + 16 B pad). Entry rsp%16==8; post-prologue rsp%16==(8+48+40) mod 16 == 96 mod 16 == 0 for every nested call. (2) Latch _hid_kbd_dev_count into r12. Zero-count branch: emit HID KBD NONE via klog_s1(LEVEL_INFO, SUBSYS_XHCI, tag_hid_kbd_none) and return 0. This is the only reachable arm on every current boot (QEMU -kernel, QEMU UEFI/OVMF, real T14 G4) because the USB enumeration substrate that would populate _hid_kbd_devices has not landed a call site above this orchestrator - see file header §Substrate posture. (3) Init i=rbx=0, successes=r14=0. Per iteration i in [0, count): compute rbp = &_hid_kbd_devices[i] via `mov rax, rbx; shl rax, 7; lea r10, [rip + _hid_kbd_devices]; add r10, rax; mov rbp, r10`. Row stride 128 = shl 7 (no 2-op imul r,imm needed). (4) Latch packed_bdf into r13 (survives the nested calls that may clobber it; used for the OK-emit v1 slot). (5) SET_PROTOCOL(0=Boot) via xhci_hid_set_boot_protocol(bar0_va=[rbp+0], event_ctx=[rbp+8], slot_id=[rbp+48], ep0_ring=[rbp+24], iface=[rbp+56]) - args mapped rdi/rsi/rdx/rcx/r8 per SysV. Result in rax (0=OK, 1/2/0x100+CC=failure). Informational return - see file header §Best-effort. (6) SET_IDLE(duration=0, report_id=0) via xhci_hid_set_idle(bar0_va, event_ctx, slot_id, ep0_ring, iface) with the same arg mapping. duration=0 tells the device to report on every state change (no idle throttling); non-compliant keyboards that STALL SET_IDLE fall through here without stopping the bring-up. (7) Configure interrupt IN endpoint via xhci_configure_ep_hid(bar0_va=[rbp+0], cmd_ctx=[rbp+16], event_ctx=[rbp+8], slot_id=[rbp+48], input_ctx_pa=[rbp+40], transfer_ring=[rbp+32]) - 6 register args (rdi..r9). Programs EP1 IN as Interrupt IN with MPS=8, interval=3 microframes (~1 ms), Average TRB Length=8; then issues the Configure Endpoint command and moves the slot to CONFIGURED per xHCI 1.2 §4.6.6. (8) Publish cascade: mint the KIND_XHCI_CTRL broker at slot HID_KBD_ATTACH_BROKER_SLOT (208) with R_DEV_ALL|RIGHT_MINT (0x21F), target_ptr = bar0_va - placeholder for the future formal kind_hid_kbd derivation gate whose contract will demand `parent.kind == KIND_XHCI_CTRL(0x19C) AND rights & RIGHT_MINT`. Publish the KIND_HID_KBD cap at slot HID_KBD_ATTACH_PUB_SLOT_BASE + i (212+i) with R_DEV_ALL (0x1F, no MINT since KIND_HID_KBD is a leaf), target_ptr = transfer_ring (the interrupt-IN ring the future ISR peels events off). (9) OK emit: mov rax, [rbp+56] (iface); mov [rsp+0], rax (v2). lea rax, [rip+k_ep]; mov [rsp+8], rax (k3). mov rax, [rbp+64] (ep_addr); mov [rsp+16], rax (v3). klog_s1_x3(LEVEL_INFO, SUBSYS_XHCI, tag_hid_kbd_attach_ok, k_bdf, r13, k_iface) - callee reads v2/k3/v3 at [rbp+16..+32] = [caller_rsp+0..+16] per the M1-004 stack-arg convention. iface + ep_addr rendered as hex (small integer counts, but reading as hex keeps the operator's parse of the endpoint-address direction-bit unambiguous: 0x81 vs 0x01 is immediate; 129 vs 1 is not). (10) Increment r14 (successes++). (11) hid_kbd_at_next: add rbx, 1; jmp hid_kbd_at_loop. (12) hid_kbd_at_done: mov rax, r14; hid_kbd_at_out: epilogue. Encoder pitfalls avoided: no test rN/rN (use cmp), no imul r,imm 2-op (shl 7 for row stride), no and reg,imm64 (0x21F/0x1F/0x19C/0x19D/208/212/3/1 all fit imm32), no cmp reg,[mem] (values staged to register first). Every field load uses natural REX.W u64 mov - no sub-8-byte zero-extension needed. Reserved labels: hid_kbd_at_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        // ---------------------------------------------------------------
        // Latch _hid_kbd_dev_count. Zero -> HID KBD NONE arm.
        // ---------------------------------------------------------------
        mov r12, [rip + _hid_kbd_dev_count];

        cmp r12, 0;
        jne hid_kbd_at_have;

        // HID KBD NONE: no boot keyboards discovered on any controller.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_hid_kbd_none];
        call klog_s1;
        xor rax, rax;
        jmp hid_kbd_at_out;

      hid_kbd_at_have:
        xor rbx, rbx;                    // i = 0
        xor r14, r14;                    // successes = 0

      hid_kbd_at_loop:
        cmp rbx, r12;
        jae hid_kbd_at_done;

        // -------------------------------------------------------------
        // Compute rbp = &_hid_kbd_devices[i] = base + (i << 7).
        // Row stride 128 B per file header §_hid_kbd_devices layout.
        // -------------------------------------------------------------
        mov rax, rbx;
        shl rax, 7;
        lea r10, [rip + _hid_kbd_devices];
        add r10, rax;
        mov rbp, r10;

        // Latch packed_bdf into r13 for the OK-emit v1 slot. Every
        // nested call below may clobber caller-save regs; r13 is
        // callee-save so it survives.
        mov r13, [rbp + 72];             // packed_bdf

        // -------------------------------------------------------------
        // (1) SET_PROTOCOL(0=Boot) — USB HID 1.11 §7.2.6.
        //
        // xhci_hid_set_boot_protocol(bar0, event_ctx, slot_id,
        //                            ep0_ring, iface).
        // -------------------------------------------------------------
        mov rdi, [rbp + 0];              // bar0_va
        mov rsi, [rbp + 8];              // event_ctx
        mov rdx, [rbp + 48];             // slot_id
        mov rcx, [rbp + 24];             // ep0_ring
        mov r8,  [rbp + 56];             // iface
        call xhci_hid_set_boot_protocol;

        // -------------------------------------------------------------
        // (2) SET_IDLE(0, 0) — USB HID 1.11 §7.2.4.
        //
        // xhci_hid_set_idle(bar0, event_ctx, slot_id, ep0_ring, iface).
        // Non-compliant keyboards STALL this request; the return
        // value is informational and the orchestrator continues on
        // to endpoint configuration.
        // -------------------------------------------------------------
        mov rdi, [rbp + 0];              // bar0_va
        mov rsi, [rbp + 8];              // event_ctx
        mov rdx, [rbp + 48];             // slot_id
        mov rcx, [rbp + 24];             // ep0_ring
        mov r8,  [rbp + 56];             // iface
        call xhci_hid_set_idle;

        // -------------------------------------------------------------
        // (3) Configure interrupt-IN endpoint (EP1 IN, DCI=3) per
        // xHCI 1.2 §4.6.6. 8-byte HID Boot Keyboard report descriptor
        // (§B.1) hard-coded into xhci_configure_ep_hid (MPS=8,
        // interval=3 microframes = ~1 ms polling, Average TRB
        // Length=8).
        //
        // xhci_configure_ep_hid(bar0, cmd_ctx, event_ctx, slot_id,
        //                       input_ctx_pa, transfer_ring_pa).
        // -------------------------------------------------------------
        mov rdi, [rbp + 0];              // bar0_va
        mov rsi, [rbp + 16];             // cmd_ctx
        mov rdx, [rbp + 8];              // event_ctx
        mov rcx, [rbp + 48];             // slot_id
        mov r8,  [rbp + 40];             // input_ctx_pa
        mov r9,  [rbp + 32];             // transfer_ring_pa
        call xhci_configure_ep_hid;

        // -------------------------------------------------------------
        // (4) Mint KIND_XHCI_CTRL broker at slot 208 with
        // R_DEV_ALL | RIGHT_MINT (0x21F). Placeholder for the future
        // kind_hid_kbd derivation gate — see file header
        // §KIND_HID_KBD.
        // -------------------------------------------------------------
        mov rdi, 208;                    // HID_KBD_ATTACH_BROKER_SLOT
        mov rsi, 0x19C;                  // KIND_XHCI_CTRL
        mov rdx, 0x21F;                  // R_DEV_ALL | RIGHT_MINT
        mov rcx, [rbp + 0];              // target_ptr = bar0_va
        call cap_mint_write;

        // -------------------------------------------------------------
        // (5) Publish per-keyboard KIND_HID_KBD cap at slot 212 + i
        // with R_DEV_ALL. target_ptr = transfer_ring so the future
        // userspace HID server (blocked on #1015) can dereference
        // the interrupt-IN ring for report peek.
        // -------------------------------------------------------------
        mov rdi, 212;                    // HID_KBD_ATTACH_PUB_SLOT_BASE
        add rdi, rbx;                    // + i
        mov rsi, 0x19D;                  // KIND_HID_KBD
        mov rdx, 0x1F;                   // R_DEV_ALL (leaf; no MINT)
        mov rcx, [rbp + 32];             // target_ptr = transfer_ring
        call cap_mint_write;

        // -------------------------------------------------------------
        // (6) Emit HID KBD ATTACH OK bdf=0x<h> iface=0x<h> ep=0x<h>
        // via klog_s1_x3. Stack-arg convention: caller writes v2/k3/v3
        // at [rsp+0..+16] BEFORE the CALL. After CALL the ret_addr
        // consumes 8 B; the callee sees them at its own [rsp+8..+24].
        // Same idiom as xhci_attach_all (attach.pdx L400-403).
        // -------------------------------------------------------------
        mov rax, [rbp + 56];             // iface
        mov [rsp + 0], rax;              // v2 = iface

        lea rax, [rip + k_ep];
        mov [rsp + 8], rax;              // k3 = &k_ep

        mov rax, [rbp + 64];             // ep_addr
        mov [rsp + 16], rax;             // v3 = ep_addr

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_XHCI];
        lea rdx, [rip + tag_hid_kbd_attach_ok];
        lea rcx, [rip + k_bdf];          // k1
        mov r8, r13;                     // v1 = packed_bdf
        lea r9, [rip + k_iface];         // k2
        call klog_s1_x3;

        add r14, 1;                      // successes++

      hid_kbd_at_next:
        add rbx, 1;
        jmp hid_kbd_at_loop;

      hid_kbd_at_done:
        mov rax, r14;                    // return successes

      hid_kbd_at_out:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

}
