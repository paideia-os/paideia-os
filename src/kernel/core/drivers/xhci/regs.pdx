// src/kernel/core/drivers/xhci/regs.pdx — R26-M1-002 (#942)
//
// xHCI controller-register MMIO accessors. Every xHCI controller
// exposes an MMIO window at BAR0 whose layout is fixed by the eXtensible
// Host Controller Interface for USB 1.2 specification. The window has
// two disjoint register sections:
//
//   * Capability Registers  @ BAR0 + 0x00                    (read-only)
//   * Operational Registers @ BAR0 + CAPLENGTH               (RW)
//   * Runtime Registers     @ BAR0 + RTSOFF                  (RW)
//   * Doorbell Array        @ BAR0 + DBOFF                   (WO)
//   * Extended Capabilities @ BAR0 + (HCCPARAMS1.xECP << 2)  (RW)
//
// This file implements the plain MMIO accessors for the Capability and
// Operational windows. Runtime / Doorbell / xECP accessors land at
// R26.M2 when the driver-attach path allocates the event ring and
// device-context array.
//
// -----------------------------------------------------------------------------
// Capability-window register offsets (xHCI 1.2 §5.3)
// -----------------------------------------------------------------------------
//
//   0x00  u8   CAPLENGTH     — bytes from BAR0 to op-register base
//   0x01  u8   reserved
//   0x02  u16  HCIVERSION    — BCD version (0x0100 = 1.0, 0x0120 = 1.20)
//
//   0x04  u32  HCSPARAMS1
//                bits  [7:0]   MaxSlots         — max device slots
//                bits [18:8]   MaxIntrs         — max interrupters (MSI-X vecs)
//                bits [24..23] reserved
//                bits [31:24]  MaxPorts         — max root-hub ports
//
//   0x08  u32  HCSPARAMS2
//                bits  [3:0]   IST              — isochronous scheduling threshold
//                bits  [7:4]   ERST Max         — event-ring segment table max
//                bits [25:21]  Max Scratchpad Bufs Hi
//                bits [26]     SPR              — scratchpad restore
//                bits [31:27]  Max Scratchpad Bufs Lo
//
//   0x0C  u32  HCSPARAMS3
//                bits  [7:0]   U1 Device Exit Latency  (µs)
//                bits [31:16]  U2 Device Exit Latency  (µs)
//
//   0x10  u32  HCCPARAMS1
//                bit  0        AC64  — 64-bit addressing capable
//                bit  1        BNC   — bandwidth negotiation
//                bit  2        CSZ   — 64-byte context sizes when set
//                bit  3        PPC   — port-power control
//                bit  4        PIND  — port indicators
//                bit  5        LHRC  — light HC reset capability
//                bit  6        LTC   — latency tolerance messaging capability
//                bit  7        NSS   — no secondary streams
//                bit  8        PAE   — parse all event data
//                bit  9        SPC   — stopped short-packet capability
//                bit 10        SEC   — stopped EDTLA capability
//                bit 11        CFC   — contiguous frame ID capability
//                bits [15:12]  MaxPSASize
//                bits [31:16]  xECP  — extended-cap ptr (in DW units from BAR0)
//
//   0x14  u32  DBOFF          — doorbell-array offset (in DW units, low 2 zero)
//   0x18  u32  RTSOFF         — runtime-register-space offset (32 B aligned)
//   0x1C  u32  HCCPARAMS2
//
// -----------------------------------------------------------------------------
// Operational-window register offsets (xHCI 1.2 §5.4)
// -----------------------------------------------------------------------------
//
//   All offsets are relative to op_base = BAR0 + CAPLENGTH.
//
//   0x00  u32  USBCMD
//                bit  0  RS       — Run/Stop
//                bit  1  HCRST    — Host Controller Reset
//                bit  2  INTE     — Interrupter Enable
//                bit  3  HSEE     — Host System Error Enable
//                bit  7  LHCRST   — Light HC Reset
//                bit  8  CSS      — Controller Save State
//                bit  9  CRS      — Controller Restore State
//                bit 10  EWE      — Enable Wrap Event
//
//   0x04  u32  USBSTS
//                bit  0  HCH      — HC Halted
//                bit  2  HSE      — Host System Error
//                bit  3  EINT     — Event Interrupt
//                bit  4  PCD      — Port Change Detect
//                bit  8  SSS      — Save State Status
//                bit  9  RSS      — Restore State Status
//                bit 10  SRE      — Save/Restore Error
//                bit 11  CNR      — Controller Not Ready
//                bit 12  HCE      — Host Controller Error
//
//   0x08  u32  PAGESIZE        — supported page sizes (bit N set = 2^(N+12))
//   0x14  u32  DNCTRL          — device notification control
//   0x18  u64  CRCR            — command-ring control (RCS / CS / CA / CRR / ptr)
//   0x30  u64  DCBAAP          — device-context base-addr-array pointer
//   0x38  u32  CONFIG          — MaxSlotsEn [7:0] + U3E + CIE
//
// Port register set (per-port 16 B block) begins at op_base + 0x400.
//
// -----------------------------------------------------------------------------
// R26.M1 posture: no boot-time xHCI MMIO
// -----------------------------------------------------------------------------
//
// Under BIOS/`-kernel` boot QEMU q35 does not expose PCI devices to the
// PCI enumerator (MCFG-absent path). xhci_probe consequently returns 0
// controllers and the reset/handoff/config paths are never invoked at
// M1. The accessors below are dormant symbols at M1 — real invocations
// land at R26.M2 driver-attach after event-ring and DCBAA allocation
// from phys_alloc + IOMMU DTE programming.
//
// -----------------------------------------------------------------------------
// MMIO ordering discipline
// -----------------------------------------------------------------------------
//
// All accessors bracket the MMIO transaction with `mfence` — same
// posture as core/iommu/vtd_regs.pdx / core/drivers/nvme/regs.pdx:
//   (a) mfence-BEFORE: earlier WB stores retire before the UC MMIO
//       transaction begins (SDM Vol 3A §11.3.1 — WB→UC not ordered).
//   (b) mfence-AFTER: the MMIO transaction publishes / completes
//       before downstream code observes side-effects.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.22.x)
// -----------------------------------------------------------------------------
//
//   G1: mov [mem], reg32 widens → mov_d for u32 MMIO stores.
//       64-bit MMIO stores are natural REX.W width so bare mov is safe.
//
// -----------------------------------------------------------------------------
// #942 blocker verdict
// -----------------------------------------------------------------------------
//
// #942 was labeled `cross-repo:paideia-as-blocked` on the premise that
// "bitfield struct helpers phase 2 (v0.22)" was required to decode the
// packed HCSPARAMS1 / HCCPARAMS1 fields. Verdict: PAPER TIGER. Each
// field decomposes cleanly into `shr / and` sequences that every
// existing PCI / VT-d / NVMe accessor already uses (see nvme_reset in
// core/drivers/nvme/enable.pdx for the same discipline on NVMe.CAP.MPS
// etc.). 64-bit MMIO reads/writes are proven by nvme_reg_u64 /
// nvme_reg_write_u64 (R24.M1) which in turn inherit from vtd_read_u64
// / vtd_write_u64 (R22.M4). No encoder gap blocks this module — the
// label is removed and M1 lands under standard discipline.

module Regs = structure {

  // ============================================================================
  // Capability-window register offsets (bytes from BAR0)
  // ============================================================================

  pub let XHCI_CAP_CAPLENGTH        : u64 = 0x00
  pub let XHCI_CAP_HCIVERSION       : u64 = 0x02
  pub let XHCI_CAP_HCSPARAMS1       : u64 = 0x04
  pub let XHCI_CAP_HCSPARAMS2       : u64 = 0x08
  pub let XHCI_CAP_HCSPARAMS3       : u64 = 0x0C
  pub let XHCI_CAP_HCCPARAMS1       : u64 = 0x10
  pub let XHCI_CAP_DBOFF            : u64 = 0x14
  pub let XHCI_CAP_RTSOFF           : u64 = 0x18
  pub let XHCI_CAP_HCCPARAMS2       : u64 = 0x1C

  // ============================================================================
  // Operational-window register offsets (bytes from op_base = BAR0 + CAPLENGTH)
  // ============================================================================

  pub let XHCI_OP_USBCMD            : u64 = 0x00
  pub let XHCI_OP_USBSTS            : u64 = 0x04
  pub let XHCI_OP_PAGESIZE          : u64 = 0x08
  pub let XHCI_OP_DNCTRL            : u64 = 0x14
  pub let XHCI_OP_CRCR              : u64 = 0x18
  pub let XHCI_OP_DCBAAP            : u64 = 0x30
  pub let XHCI_OP_CONFIG            : u64 = 0x38

  // ============================================================================
  // USBCMD bit definitions (xHCI 1.2 §5.4.1)
  // ============================================================================

  pub let XHCI_USBCMD_RS            : u64 = 0x00000001
  pub let XHCI_USBCMD_HCRST         : u64 = 0x00000002
  pub let XHCI_USBCMD_INTE          : u64 = 0x00000004
  pub let XHCI_USBCMD_HSEE          : u64 = 0x00000008
  pub let XHCI_USBCMD_LHCRST        : u64 = 0x00000080
  pub let XHCI_USBCMD_CSS           : u64 = 0x00000100
  pub let XHCI_USBCMD_CRS           : u64 = 0x00000200
  pub let XHCI_USBCMD_EWE           : u64 = 0x00000400

  // ============================================================================
  // USBSTS bit definitions (xHCI 1.2 §5.4.2)
  // ============================================================================

  pub let XHCI_USBSTS_HCH           : u64 = 0x00000001
  pub let XHCI_USBSTS_HSE           : u64 = 0x00000004
  pub let XHCI_USBSTS_EINT          : u64 = 0x00000008
  pub let XHCI_USBSTS_PCD           : u64 = 0x00000010
  pub let XHCI_USBSTS_SSS           : u64 = 0x00000100
  pub let XHCI_USBSTS_RSS           : u64 = 0x00000200
  pub let XHCI_USBSTS_SRE           : u64 = 0x00000400
  pub let XHCI_USBSTS_CNR           : u64 = 0x00000800
  pub let XHCI_USBSTS_HCE           : u64 = 0x00001000

  // ============================================================================
  // HCSPARAMS1 field shifts
  // ============================================================================
  //
  //   MaxSlots  = HCSPARAMS1 & 0xFF
  //   MaxIntrs  = (HCSPARAMS1 >> 8)  & 0x7FF
  //   MaxPorts  = (HCSPARAMS1 >> 24) & 0xFF

  pub let XHCI_HCS1_MAXSLOTS_MASK   : u64 = 0x000000FF
  pub let XHCI_HCS1_MAXINTRS_SHIFT  : u64 = 8
  pub let XHCI_HCS1_MAXINTRS_MASK   : u64 = 0x000007FF
  pub let XHCI_HCS1_MAXPORTS_SHIFT  : u64 = 24
  pub let XHCI_HCS1_MAXPORTS_MASK   : u64 = 0x000000FF

  // ============================================================================
  // HCCPARAMS1 field shifts
  // ============================================================================
  //
  //   xECP_offset (DW units, byte offset = xECP << 2) = HCCPARAMS1 >> 16

  pub let XHCI_HCC1_XECP_SHIFT      : u64 = 16
  pub let XHCI_HCC1_XECP_MASK       : u64 = 0x0000FFFF
  pub let XHCI_HCC1_AC64            : u64 = 0x00000001
  pub let XHCI_HCC1_CSZ             : u64 = 0x00000004

  // ============================================================================
  // xhci_cap_u8 — 8-bit MMIO read from bar0 + offset (Capability window)
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64) -> u64
  //   rdi = BAR0 base
  //   rsi = capability-register offset (XHCI_CAP_* constant)
  //
  // Returns rax = 8-bit register value, zero-extended.
  //
  // Leaf function. mfence brackets the MMIO transaction.

  pub let xhci_cap_u8 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). xHCI capability-window 8-bit MMIO read (CAPLENGTH lives at BAR0+0x00 as a u8). Structural sibling to nvme_reg_u32 (core/drivers/nvme/regs.pdx L173). Body: (1) mfence — earlier WB stores retire before this UC MMIO transaction (SDM Vol 3A §11.3.1: WB→UC on same CPU is not TSO-ordered). (2) Compute effective address = base + offset. (3) xor rax,rax to zero-extend, then mov_b al, [rax] — but that's a byte access we can't do with the mov_b as-store form; use the pattern `xor rax,rax; mov_b rax, [rax]` (dst-load form is proven in probe.pdx L140). Actually: xor eax,eax; then load byte via mov_b rax, [rax] where rax already holds the address... conflicts. Use: mov r10, base; add r10, offset; xor rax, rax; mov_b rax, [r10]. (4) mfence. Leaf function, no prologue.",
      block: {
        mfence;
        mov r10, rdi;
        add r10, rsi;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_cap_u16 — 16-bit MMIO read from bar0 + offset (Capability window)
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64) -> u64
  //   HCIVERSION @ BAR0 + 0x02 is the canonical u16 caller.

  pub let xhci_cap_u16 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). xHCI capability-window 16-bit MMIO read. HCIVERSION @ BAR0+0x02. Body: mfence / lea addr / zero-extend u16 load via `xor rax,rax; mov_w rax, [r10]` (same dst-load pattern as probe.pdx L153) / mfence. Leaf.",
      block: {
        mfence;
        mov r10, rdi;
        add r10, rsi;
        xor rax, rax;
        mov_w rax, [r10];
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_cap_u32 — 32-bit MMIO read from bar0 + offset (Capability window)
  // ============================================================================
  //
  // SysV: (base: u64, offset: u64) -> u64
  //   HCSPARAMS1/2/3, HCCPARAMS1/2, DBOFF, RTSOFF are all u32.

  pub let xhci_cap_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). xHCI capability-window 32-bit MMIO read. Structural sibling to nvme_reg_u32 (core/drivers/nvme/regs.pdx L173). rdi = BAR0 base, rsi = XHCI_CAP_* offset. Body: mfence / lea addr / mov eax, [addr] (zero-extends into upper 32 bits of rax per SDM Vol 2A §3.4.1.1) / mfence. Leaf.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_op_u32 — 32-bit MMIO read from op_base + offset (Operational window)
  // ============================================================================
  //
  // SysV: (op_base: u64, offset: u64) -> u64
  //   op_base = BAR0 + CAPLENGTH (computed once by caller and passed).
  //   offset  = XHCI_OP_* constant (USBCMD/USBSTS/PAGESIZE/DNCTRL/CONFIG).

  pub let xhci_op_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (op_base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). xHCI operational-window 32-bit MMIO read. Structural sibling to nvme_reg_u32. rdi = op_base = BAR0 + CAPLENGTH (caller pre-computes), rsi = XHCI_OP_* offset. Body: mfence / lea addr / mov eax, [addr] / mfence. Leaf.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_op_write_u32 — 32-bit MMIO write to op_base + offset
  // ============================================================================
  //
  // SysV: (op_base: u64, offset: u64, val: u64) -> ()

  pub let xhci_op_write_u32 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (op_base: u64, offset: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). xHCI operational-window 32-bit MMIO write (USBCMD, USBSTS RW1C bits, DNCTRL, CONFIG). Structural sibling to nvme_reg_write_u32 (core/drivers/nvme/regs.pdx L197). rdi = op_base, rsi = offset, rdx = value. Body: mfence / lea addr / mov_d [addr], rdx (G1 sized store — bare `mov [addr], rdx` would widen to REX.W and clobber the neighbouring register slot) / mfence.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_d [rax], rdx;
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_op_u64 — 64-bit MMIO read from op_base + offset
  // ============================================================================
  //
  // SysV: (op_base: u64, offset: u64) -> u64
  //   CRCR @ +0x18, DCBAAP @ +0x30 are u64.

  pub let xhci_op_u64 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (op_base: u64, offset: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). xHCI operational-window 64-bit MMIO read (CRCR @ +0x18, DCBAAP @ +0x30). Structural sibling to nvme_reg_u64 (core/drivers/nvme/regs.pdx L222). Body: mfence / lea addr / mov rax, [addr] (destination *is* rax so no encoder-gap risk) / mfence. Leaf.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov rax, [rax];
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_op_write_u64 — 64-bit MMIO write to op_base + offset
  // ============================================================================
  //
  // SysV: (op_base: u64, offset: u64, val: u64) -> ()

  pub let xhci_op_write_u64 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (op_base: u64, offset: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). xHCI operational-window 64-bit MMIO write (CRCR / DCBAAP programming during driver-attach at R26.M2). Structural sibling to nvme_reg_write_u64 (core/drivers/nvme/regs.pdx L243). Body: mfence / lea addr / mov [addr], rdx (plain 64-bit store — no G1 risk since REX.W matches the 8-byte MMIO width) / mfence.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov [rax], rdx;
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_mmio_u32 — 32-bit MMIO read from an absolute address (bar0 + off)
  // ============================================================================
  //
  // SysV: (addr: u64) -> u64
  //
  // Used by the extended-capability walker (bios_handoff.pdx) whose cursor
  // is an absolute MMIO address — carrying a base + offset pair through
  // the walk adds no clarity, and the xECP list header format (u32 at
  // cursor) is easiest to express against a raw pointer.

  pub let xhci_mmio_u32 : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (addr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). Absolute-address 32-bit MMIO read used by the xECP walker in bios_handoff.pdx. Body: mfence / mov eax, [rdi] / mfence. Leaf.",
      block: {
        mfence;
        mov eax, [rdi];
        mfence;
        ret
      }
    }

  // ============================================================================
  // xhci_mmio_write_u32 — 32-bit MMIO write to an absolute address
  // ============================================================================
  //
  // SysV: (addr: u64, val: u64) -> ()

  pub let xhci_mmio_write_u32 : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (addr: u64, val: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R26-M1-002 (#942). Absolute-address 32-bit MMIO write used by the USBLEGSUP RMW sequence in bios_handoff.pdx. Body: mfence / mov_d [rdi], rsi (G1 sized store) / mfence. Leaf.",
      block: {
        mfence;
        mov_d [rdi], rsi;
        mfence;
        ret
      }
    }
}
