// src/kernel/core/drivers/fb_map.pdx — R23-M1-001 (#875)
//
// Linear-framebuffer mapper: install the UEFI-GOP-reported LFB into the
// kernel address space at a fixed high-half VA, with PTE bits selecting
// PAT slot 4 (WC / write-combining).
//
// Round: R23 — Framebuffer console (GOP direct)
// Milestone: R23.M1 LFB map + PAT + font
// Roadmap: design/roadmap/r18-plus-bare-metal.md §R23
// Encoder floor: paideia-as v0.20.1 (aspace_map, movabs r64,imm64, RIP-rel
//                loads — all long-established in the R13/R14 KPTI substrate).
//
// ==============================================================================
// Purpose
// ==============================================================================
//
// R19.M3-002 (#793) populated a framebuffer descriptor in _boot_env (base,
// size, pitch, width, height, format).  R23 needs the LFB visible to the
// kernel as writable memory so a rasterizer can splat glyphs.  Two things
// must hold:
//
//   (1) The physical range [fb_base, fb_base + size) must be reachable via
//       a kernel VA.  We map at a fixed VA in the unused kernel PML4[320]
//       subtree: 0xFFFF_A000_0000_0000.  Kernel image + heap + IST stacks
//       live under PML4[256] (0xFFFF_8000_...); PML4[320] is otherwise
//       empty, so the LFB range never collides.
//
//   (2) The mapping must select WC cacheability.  On x86_64 with PAT, the
//       leaf PTE bits (PAT, PCD, PWT) form a 3-bit index into IA32_PAT.
//       R23.M1-002 (#876; core/mm/pat.pdx) programmed slot 4 = WC.  Slot 4
//       decodes as (PAT=1, PCD=0, PWT=0) — i.e. PTE bit 7 set, bits 3+4
//       clear.  This module encodes that as flags = 0x82 (RW=2 | PAT=0x80)
//       + NX (bit 63) = 0x8000000000000082 (aspace_map ORs PRESENT itself).
//
// ==============================================================================
// VA selection: 0xFFFF_A000_0000_0000
// ==============================================================================
//
// PML4 index of the chosen VA:
//   0xFFFF_A000_0000_0000 >> 39 & 0x1FF = 0x140 = 320.
//
// PML4[256..320) currently holds:
//   PML4[256]        — KERNEL_VMA_BASE alias (0xFFFF_8000_...); kernel image
//   PML4[257..320)   — unused (no phys backing)
//
// PML4[320..512) is likewise unused today.  The next high-half consumer is
// the R25+ physmap window (SDM-recommended ffff_c000_0000_0000+); placing
// the LFB at 320 leaves that window untouched.
//
// The chosen VA is canonical (bits 48..63 sign-extend from bit 47 =
// 0xFFFF_...); nothing further needs alignment beyond page granularity
// which aspace_map enforces.
//
// ==============================================================================
// PVH boot path (no _boot_env)
// ==============================================================================
//
// Under `qemu -kernel` (PVH ELF entry) the R19 UEFI-stub handoff never runs,
// so _boot_env is uninitialized and _boot_env_pa == 0.  Callers of
// fb_map_lfb must check _boot_env_pa first (deferred to the console
// wire-up in R23.M2+) and pass fb_base_pa = 0 to signal "no framebuffer"
// — this function returns 0 without touching the address space.
//
// ==============================================================================
// Registers & call discipline
// ==============================================================================
//
// aspace_map takes 4 args (rdi=as_root, rsi=vaddr, rdx=paddr, rcx=flags)
// and clobbers rax + all caller-save.  We loop over the framebuffer 4 KiB
// at a time, calling aspace_map per page.  State that survives across the
// call (fb_va cursor, fb_pa cursor, remaining bytes, return-VA base) lives
// in callee-save registers.
//
// 5-push prologue (rbx, r12, r13, r14, r15) — from entry rsp%16==8, five
// pushes land rsp%16 == (8 - 40) mod 16 == 0, so nested aspace_map calls
// see the required 16-byte alignment.  r15 is unused in the body but
// pushed to reach the odd-count-of-pushes required for correct alignment;
// this mirrors the padding idiom in kpti_build_user_pml4 (uses `sub rsp,
// 8`, same effect).
//
// ==============================================================================
// Return value
// ==============================================================================
//
//   fb_base_pa == 0            -> return 0 (no framebuffer available)
//   size == 0                  -> return the fixed VA (no pages to map)
//   aspace_map returns nonzero -> propagate the error code in rax
//                                 (MAP_OOM=0xFFFFFFFE, MAP_OVERLAP=0xFFFFFFFF)
//   success                    -> return the fixed VA (0xFFFF_A000_0000_0000)
//
// The caller can compare the return against 0 to detect "no framebuffer"
// and against MAP_* sentinels to detect specific failure modes.
//
// ==============================================================================
// Size rounding
// ==============================================================================
//
// The GOP-reported size is measured in bytes.  We iterate 4096 bytes per
// aspace_map call and stop when `remaining <= 0`.  If the fb size is not a
// multiple of 4 KiB (e.g. 1920x1080 x 4bpp = 8,294,400 bytes = 2025 pages =
// exactly 8,294,400 bytes; but odd resolutions may report non-multiple),
// the final iteration maps a partial-page's worth of PA, which is fine —
// the whole page is mapped even though the caller may only use part of it.
//
// The loop terminator uses `jbe` (unsigned <=) so remaining==0 exits
// cleanly on the first iteration when size==0.  We decrement remaining
// by 4096 each pass; if size < 4096 the initial sub underflows to a huge
// unsigned value.  Guard with a pre-loop compare instead — cleaner.
//
// ==============================================================================
// Instruction floor
// ==============================================================================
//
// - mov r64, imm64          (movabs; kpti.pdx precedent)
// - mov r64, [rip + sym]    (RIP-rel load; kpti.pdx L559 precedent)
// - lea r64, [rip + sym]    (R11 encoder)
// - cmp / jae / jbe / je / jne / jmp   (R11 flow control)
// - add / sub r64, imm32    (R11 arith)
// - call rel32              (R11 encoder)

module FbMap = structure {

  // Kernel VA base for the LFB mapping.  See VA-selection comment above.
  pub let FB_MAP_VA_BASE : u64 = 0xFFFFA00000000000

  // PTE flags for a WC framebuffer page:
  //   bit 63 = NX       (0x8000000000000000) — no exec from framebuffer
  //   bit 7  = PAT      (0x80)               — high bit of PAT index (slot 4)
  //   bit 4  = PCD      (0)                  — PAT slot index bit 1
  //   bit 3  = PWT      (0)                  — PAT slot index bit 0
  //   bit 1  = RW       (0x2)                — writable
  //   bit 0  = PRESENT  (OR'd by aspace_map) — leaf present
  //
  // packed: 0x8000_0000_0000_0082
  //
  // The PAT slot index formed by (PAT<<2 | PCD<<1 | PWT) = (1<<2 | 0 | 0)
  // = 4, selecting the WC entry programmed by src/kernel/core/mm/pat.pdx
  // pat_init_this_cpu.
  pub let FB_MAP_PTE_FLAGS : u64 = 0x8000000000000082

  pub let FB_MAP_PAGE_BYTES : u64 = 4096

  // ==========================================================================
  // fb_map_lfb(fb_base_pa, size) -> u64
  // ==========================================================================
  //
  // Iterate the physical range in 4 KiB chunks; call aspace_map per page
  // against the kernel PML4 (_kernel_pml4_pa singleton, populated at boot
  // by kernel_main_64).
  //
  // Prereqs (caller-enforced):
  //   - pat_init_this_cpu already ran on this CPU (else WC PTE bits decode
  //     as the default slot-4 memory type = WB).
  //   - _kernel_pml4_pa is populated (R14b bring-up; always true post-boot).
  //   - fb_base_pa is 4 KiB-aligned (GOP guarantees this per UEFI 2.10
  //     §12.9 EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE::FrameBufferBase which
  //     "shall be aligned to a page boundary").
  // ==========================================================================
  pub let fb_map_lfb : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (fb_base_pa: u64) (size: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { boot },
      justification: "R23-M1-001 (#875): map the GOP-reported LFB range at kernel VA 0xFFFF_A000_0000_0000 with PAT-slot-4 (WC) cacheability.  Iterates the [fb_base_pa, fb_base_pa + size) physical range in 4 KiB steps, calling aspace_map(_kernel_pml4_pa, va_cursor, pa_cursor, 0x8000_0000_0000_0082) per page.  The flags encode NX (bit 63) | PAT (bit 7) | RW (bit 1); aspace_map ORs PRESENT.  With pat_init_this_cpu already having set IA32_PAT[slot 4]=WC, the CPU decodes these PTE bits as write-combining memory type per SDM Vol 3A §11.12.  Register discipline: 5-push prologue (rbx=va cursor, r12=pa cursor, r13=remaining bytes, r14=return-VA base, r15=padding for alignment).  From entry rsp%16==8, five pushes land rsp%16==0 for nested aspace_map calls (aspace_map's own 4-push prologue restores its own alignment discipline).  r15 pushed but unused in body; padding idiom mirrors kpti_build_user_pml4's `sub rsp, 8` alignment.  Guard-outs: (a) fb_base_pa == 0 (PVH boot path with no boot_env / no framebuffer) — return 0 immediately; (b) size == 0 — return FB_MAP_VA_BASE without any aspace_map call; (c) aspace_map returns nonzero (MAP_OOM=0xFFFFFFFE or MAP_OVERLAP=0xFFFFFFFF) — propagate the sentinel in rax and unwind.  Loop terminator uses cmp+jbe over remaining bytes so partial-final-page frames (size not multiple of 4096) still map the full trailing page — the whole page is present even if the caller only writes part.  UEFI 2.10 §12.9 guarantees the LFB base is page-aligned so no ceiling-round on fb_base_pa is required.  VA selection (PML4[320], 0xFFFF_A000_0000_0000): unused by the kernel image (PML4[256] alias) and by the R25+ physmap window (PML4[384+]); no collision risk today or planned.  aspace_map's own justification (core/mm/aspace_map.pdx L47-53) documents its unsafe contract; we satisfy the four preconditions listed there: (1) rdi=_kernel_pml4_pa (kernel PML4 phys base, populated at boot); (2) rsi=vaddr (canonical high-half VA, 4KB-aligned); (3) rdx=paddr (page-aligned per GOP); (4) rcx=flags (well-formed, non-conflicting).  Cross-CPU coherence: this mapping lives in _kernel_pml4_pa which is shared across CPUs; every CPU that has run pat_init_this_cpu (or its AP twin pat_init_ap) sees the WC memory type on framebuffer PTEs.  This function is not called anywhere at R23.M1 close — it's substrate only, wired by R23.M2 (console + panic path) or R23.M3 (opt-in fb console).  Emits no fingerprint (deferred to the console wire so the log line can include the resolved VA/width/height alongside the map success).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (a) Guard: fb_base_pa == 0 (PVH boot, no framebuffer).
        cmp rdi, 0;
        je fb_map_lfb_no_fb;

        // Initialize cursors.
        //   r12 = pa cursor       (starts at fb_base_pa)
        //   rbx = va cursor       (starts at FB_MAP_VA_BASE)
        //   r14 = return-VA base  (constant across loop; saved for return)
        //   r13 = remaining bytes (starts at size)
        mov r12, rdi;
        mov rbx, 0xFFFFA00000000000;              // FB_MAP_VA_BASE (movabs)
        mov r14, rbx;
        mov r13, rsi;

      fb_map_lfb_loop:
        // (b) Terminator: remaining <= 0.
        cmp r13, 0;
        jbe fb_map_lfb_done;

        // (c) Map one page.
        //     rdi = _kernel_pml4_pa (RIP-rel load from mm/kpti.pdx symbol)
        //     rsi = va cursor
        //     rdx = pa cursor
        //     rcx = FB_MAP_PTE_FLAGS
        mov rdi, [rip + _kernel_pml4_pa];
        mov rsi, rbx;
        mov rdx, r12;
        mov rcx, 0x8000000000000082;              // NX | PAT (bit 7) | RW
        call aspace_map;

        // Propagate errors: aspace_map returns 0 on OK, MAP_OOM / MAP_OVERLAP
        // on failure.  Non-zero -> return the sentinel to the caller.
        cmp rax, 0;
        jne fb_map_lfb_fail;

        // Advance cursors.
        add r12, 4096;
        add rbx, 4096;
        sub r13, 4096;
        jmp fb_map_lfb_loop;

      fb_map_lfb_done:
        mov rax, r14;                             // return the base VA
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fb_map_lfb_no_fb:
        xor rax, rax;                             // return 0 (no framebuffer)
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fb_map_lfb_fail:
        // rax already holds the aspace_map error sentinel (MAP_OOM /
        // MAP_OVERLAP).  Propagate to caller.
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
