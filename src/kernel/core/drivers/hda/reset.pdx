// src/kernel/core/drivers/hda/reset.pdx — R33.M1-002 (#1138)
//
// The kernel-side Intel HDA CONTROLLER RESET sequence scaffold.
// SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE GCTL.CRST RESET SEQUENCE for an Intel HDA controller. Per
// Intel HDA §4.2.2 the software controller-init flow is:
//
//   (1) ENTER RESET: write GCTL.CRST = 0 (bit 0 of the u32 at BAR0+0x08).
//       The controller drives CRST low, halts DMA, and clears the
//       CORB/RIRB running bits. Firmware may leave CRST asserted; the
//       spec explicitly permits an implementation to skip step (1) if
//       CRST is already 0 (as after cold reset).
//
//   (2) EXIT RESET:  write GCTL.CRST = 1. The controller comes out of
//       reset and READS BACK CRST = 1 within 100us. The read-back is
//       load-bearing: a controller that never signals CRST=1 is stuck
//       in reset, and the bring-up sequence that gates on the CORB
//       and RIRB base-address programming would otherwise proceed to
//       program those against a dead register window.
//
// R33.M1 does NOT drive the sequence. GCTL is a register in the
// window hda/controller.pdx §1 declares, but the register accessor
// returns DEFERRED_HARDWARE at this milestone -- no MMIO runs. This
// module DECLARES the reset seams (arm and release) and PROPAGATES
// the controller's write sentinel, so a bring-up caller sees the
// same NOT_BOUND / DEFERRED_HARDWARE codes it would see for any
// other register op.
//
// IT IS NOT A LIVE RESET. Same discipline as i2c_hid/reset_wake.pdx
// §0 and hda/controller.pdx §0: the seams are stated as a SCAFFOLD,
// and the pin `hda_reset_arbitrated() == 0` -- an assertion that
// FAILS the moment a future milestone plumbs real MMIO through the
// controller.pdx write seam -- forces the design doc to be updated
// at that time.
//
// IT USES THE CONTROLLER WRITE SEAM AT ITS DECLARED ARITY. Arity of
// hda_controller_write is TWO ({reg_offset, value}). A live reset
// would call it twice (CRST=0 then CRST=1) with a bounded poll
// between; this scaffold calls it in the same shape and propagates
// the DEFERRED_HARDWARE sentinel. Widening the controller seam to
// accept a poll timeout or a mask would let a caller reach control
// paths no capability named -- same reason ec_access.pdx §2 exists.
//
// =============================================================================
// §1  ONE WRITER OF THE COMPLETION LATCHES
// =============================================================================
//
// Same discipline as i2c_hid/reset_wake.pdx §1 and hda/controller.pdx
// §2: exactly one writer of `_hda_reset_stats`. tools/build.sh
// confines relocations against `_hda_reset_stats` to this object. A
// stray writer would be a second path counting a reset that never
// issued, and the bring-up flow that gates on the count would
// advance without the controller having been reset.
//
// =============================================================================
// §2  REFUSE, NEVER CLAMP
// =============================================================================
//
// Arm/release before controller bind -> propagates NOT_BOUND from the
// controller write seam (refused, not queued). Neither seam takes
// caller arguments beyond the ones the spec pins: a caller-supplied
// GCTL VALUE would let arbitrary bits (FCNTRL, UNSOL) be flipped on a
// reset call, and the reset sequence only writes the CRST bit.
//
// =============================================================================
// §3  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL MMIO. hda/controller.pdx returns DEFERRED_HARDWARE
//     without touching the BAR handle at this milestone; this module
//     propagates that sentinel.
//
//   * NO POST-RESET POLL. Intel HDA §4.2.2 asks the host to wait 100us
//     for GCTL.CRST to read back as 1. This module has no timer and
//     the controller read seam returns DEFERRED_HARDWARE anyway; the
//     poll wires up at R33.M2 alongside a bounded wall-clock read
//     from HDA_REG_WALCLK.
//
//   * NO CODEC-STATE-CHANGE-STATUS DRAIN. A live reset must read and
//     clear STATESTS (BAR0+0x0E) after CRST=1 or the first codec
//     enumeration sees stale bits. Deferred to R33.M2 with the codec
//     probe.
//
//   * NO ARBITRATION. Same shape as hda/controller.pdx §4.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFC50..0xFFFFFC5F
// =============================================================================

module Reset = structure {

  // ==========================================================================
  // §4 return codes -- but the module PROPAGATES the controller's
  // return whenever it dispatches, so a happy-path caller sees
  // DEFERRED_HARDWARE (0xFFFFFC4C), a not-yet-bound controller
  // surfaces NOT_BOUND (0xFFFFFC4F), etc. The codes below are for
  // gates this module ITSELF decides -- currently none, kept for
  // future use (§3 deferrals).
  // ==========================================================================

  pub let HDA_RESET_OK : u64 = 0

  // Spec constants -- Intel HDA §4.2.2 GCTL register + CRST bit.
  // GCTL sits at BAR0+0x08 (u32); CRST is bit 0. The register offset
  // is declared in hda/controller.pdx §1 (HDA_REG_GCTL); the constants
  // below shadow the spec numbers so this file reads standalone.

  pub let HDA_RESET_GCTL_OFFSET : u64 = 0x08
  pub let HDA_RESET_GCTL_ENTER  : u64 = 0x00000000       // CRST = 0
  pub let HDA_RESET_GCTL_EXIT   : u64 = 0x00000001       // CRST = 1

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // One stats array split into two halves -- arm calls in [0], release
  // calls in [1] -- so an arm that never ran cannot be counted by the
  // release seam, and vice versa.
  // ==========================================================================

  pub let mut _hda_reset_stats : [u64; 4] = uninit @align(64)

  pub let HDA_RESET_ST_ARMS     : u64 = 0
  pub let HDA_RESET_ST_RELEASES : u64 = 1
  pub let HDA_RESET_ST_MAX      : u64 = 4

  // ==========================================================================
  // hda_reset_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as hda_controller_arbitrated:
  // pinned at 0 by the boot witness so a future milestone plumbing
  // real MMIO cannot land without rewriting the claim.
  // ==========================================================================

  pub let hda_reset_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M1-002 (#1138): report whether the reset seam issues real MMIO today. IT RETURNS 0, because hda_controller_write is a scaffold that returns DEFERRED_HARDWARE without touching the BAR handle. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_reset_arm() -> code
  //
  // ARITY ZERO. The register is the spec-enumerated GCTL (BAR0+0x08);
  // the value is the spec-enumerated CRST=0 (all bits zero). A
  // caller-supplied argument would let arbitrary bits reach GCTL --
  // the reset sequence only touches CRST, and the other GCTL bits
  // (FCNTRL bit 1, UNSOL bit 8) are the responsibility of the modules
  // that use them.
  //
  // Counts CALLS in stats[0], propagates the controller's return. On
  // the happy path (controller bound) the controller counts a WRITE
  // in its own stats and returns DEFERRED_HARDWARE.
  // ==========================================================================

  pub let hda_reset_arm : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-002 (#1138): drive GCTL.CRST -> 0 (enter reset). ARITY ZERO because the register (GCTL @ BAR0+0x08) and the value (all zeros) are both spec-enumerated and a caller-supplied argument would let arbitrary bits reach GCTL. Increments _hda_reset_stats[0] on every call (call count); the controller's return is propagated -- DEFERRED_HARDWARE on the happy path, NOT_BOUND if the controller was never bound, and either way counted by the controller in its own stats. NO REAL MMIO RUNS: the controller write seam is a scaffold (controller.pdx §4). Uses push/pop rbp to preserve 16-byte alignment across the nested call. Reserved labels: none.",
      block: {
        push rbp;

        // Count the call before dispatch -- a refused call still ran.
        lea r10, [rip + _hda_reset_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        // Dispatch: hda_controller_write(GCTL_OFFSET, GCTL_ENTER).
        mov rdi, 0x08;                   // HDA_RESET_GCTL_OFFSET
        mov rsi, 0x00;                   // HDA_RESET_GCTL_ENTER (CRST=0)
        call hda_controller_write;

        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // hda_reset_release() -> code
  //
  // ARITY ZERO for the same reason as arm. Release writes GCTL.CRST=1
  // (bit 0 set, other bits zero). A live driver would then poll the
  // controller for CRST readback and drain STATESTS; this scaffold
  // ends at the write and propagates the sentinel.
  // ==========================================================================

  pub let hda_reset_release : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-002 (#1138): drive GCTL.CRST -> 1 (exit reset). ARITY ZERO -- see hda_reset_arm's justification for the reason the seam accepts no caller argument. Increments _hda_reset_stats[1]; the controller's return is propagated. NO REAL MMIO, NO POST-RESET POLL, NO STATESTS DRAIN -- deferred to R33.M2 (§3). Uses push/pop rbp to preserve 16-byte alignment across the nested call. Reserved labels: none.",
      block: {
        push rbp;

        // Count the release call.
        lea r10, [rip + _hda_reset_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;

        // Dispatch: hda_controller_write(GCTL_OFFSET, GCTL_EXIT).
        mov rdi, 0x08;                   // HDA_RESET_GCTL_OFFSET
        mov rsi, 0x01;                   // HDA_RESET_GCTL_EXIT (CRST=1)
        call hda_controller_write;

        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // hda_reset_arm_count() / hda_reset_release_count() -> count
  //
  // Read-only accessors used by the witness to prove the seams
  // counted.
  // ==========================================================================

  pub let hda_reset_arm_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-002 (#1138): count of hda_reset_arm invocations. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_reset_stats];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hda_reset_release_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-002 (#1138): count of hda_reset_release invocations. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_reset_stats];
        mov rax, [r10 + 8];
        ret
      }
    }
}
