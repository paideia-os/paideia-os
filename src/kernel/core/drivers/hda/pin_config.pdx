// src/kernel/core/drivers/hda/pin_config.pdx -- R33.M2-003 (#1144)
//
// Pure decoders for the Intel HDA PIN COMPLEX "configuration default"
// register (default_cfg), verb 0xF1C reply. SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS A BAG OF PURE DECODERS. Per Intel HDA §7.3.3.31 every pin
// complex widget has a 32-bit CONFIGURATION DEFAULT register describing
// the JACK on the chassis the pin routes to: what kind of connector it
// is, where on the chassis it sits, what colour the moulding is, which
// device the OEM soldered behind it, and which "association" group of
// pins it belongs to (all pins in one group form one logical stream:
// front pair + centre + LFE, headphone jack + speaker, ...).
//
// This module decodes ONE 32-bit register into its nine fields. It does
// NOT read the register from a codec (verb dispatch is verbs.pdx), NOT
// walk the widget graph (widget_graph.pdx), NOT store anything (all
// functions are pure leaves), and NOT expose an assignment API to the
// OEM record (an OEM's soldering is not something the kernel invents).
//
// The nine getters have arity ONE (the 32-bit register value). A
// getter that took a "field mask" or a widened word would let a caller
// pull bits from wherever it named -- exactly the class of confusion
// the enumerated getters exist to stop, because a screen-auto policy
// that read the "device" field from bits [15:12] (where colour lives)
// would route audio to the moulding colour of the jack the driver
// probed, and that would be a hard defect to explain.
//
// =============================================================================
// §1  FIELD LAYOUT IS FIXED, NOT NEGOTIATED
// =============================================================================
//
// Per Intel HDA §7.3.3.31 the 32-bit default_cfg word is:
//
//   bits [31:30]  port connectivity (2 bits)
//                  0 = jack (external)
//                  1 = no physical connection
//                  2 = fixed function device (internal)
//                  3 = jack + internal (both)
//   bits [29:24]  location (6 bits):
//                    [29:28] gross location (2 bits: 0=ext, 1=int, 2=sep, 3=other)
//                    [27:24] geometric location (4 bits, N/E/W/S/rear/front/...)
//   bits [23:20]  default device (4 bits): line-out / speaker / hp /
//                  cd / spdif-out / digital-out / modem-line / modem-hs /
//                  line-in / aux / mic / telephony / spdif-in /
//                  digital-in / reserved / other
//   bits [19:16]  connection type (4 bits): unknown / 1/8-stereo /
//                  1/4-stereo / atapi / rca / optical / other-digital /
//                  other-analog / multichannel-analog / xlr /
//                  rj-11 / combination / reserved (C-F)
//   bits [15:12]  colour (4 bits): unknown / black / grey / blue /
//                  green / red / orange / yellow / purple / pink /
//                  reserved (A-D) / white / other
//   bits [11:8]   misc (4 bits, bit 0 = jack-detect override)
//   bits [7:4]    default association (4 bits, 1..15; 0 = unallocated)
//   bits [3:0]    sequence within the association (4 bits, 0..15)
//
// Every getter is REFUSED (BAD) if the 32-bit input has any bit set
// above bit 31. Widening the input to a full u64 with silent masking
// would let a caller feed a "verb response frame" straight in and pull
// what the getter named from wherever that landed inside; refusing at
// the width gate keeps "the input is a 32-bit register value" a
// property of every caller.
//
// =============================================================================
// §2  ONE READER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_pin_cfg_stats` to
// this object. Counters are advisory only (bad-input rejections); no
// state is mutated by the decoders themselves.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Input outside u32 -> BAD (0xFFFFFFFFFFFFFFFF), not the low 32 bits of
// the input. Any decoder that silently discarded the high bits would
// let a caller supply a value whose "meaningful" 32 bits sat where a
// live driver never reads.
//
// The individual field getters do NOT enumerate the semantic values --
// a getter returning "colour = 0xE" is a real answer (white), not a
// refusal; the *enumeration* of which colour codes are legal is in the
// spec, not this module. A future NAME_OF_COLOUR helper would go here
// as a separate function.
//
// =============================================================================
// §4  ERROR / SENTINEL CODES 0xFFFFFCA0..0xFFFFFCAF
// =============================================================================
//
// One code today: BAD_INPUT (input wider than 32 bits). The
// DECODE_BAD sentinel returned from every getter on refusal is the
// standard cross-module 0xFFFFFFFFFFFFFFFF value. Reserved slots are
// left for future refusal codes (e.g. reserved-bit assertion on a
// specific field, once a live driver treats reserved != 0 as an OEM
// error to report rather than silently ignore).
//
// =============================================================================

module PinConfig = structure {

  // ==========================================================================
  // §1 field enumerations (constants exposed for callers; the getters
  // themselves return the raw code, and a caller compares).
  // ==========================================================================

  // Port connectivity ([31:30])
  pub let HDA_PIN_CFG_CONN_JACK      : u64 = 0
  pub let HDA_PIN_CFG_CONN_NONE      : u64 = 1
  pub let HDA_PIN_CFG_CONN_FIXED     : u64 = 2
  pub let HDA_PIN_CFG_CONN_BOTH      : u64 = 3

  // Gross location ([29:28])
  pub let HDA_PIN_CFG_GLOC_EXT       : u64 = 0
  pub let HDA_PIN_CFG_GLOC_INT       : u64 = 1
  pub let HDA_PIN_CFG_GLOC_SEP       : u64 = 2
  pub let HDA_PIN_CFG_GLOC_OTHER     : u64 = 3

  // Default device ([23:20]) -- 16 values enumerated
  pub let HDA_PIN_CFG_DEV_LINE_OUT   : u64 = 0x0
  pub let HDA_PIN_CFG_DEV_SPEAKER    : u64 = 0x1
  pub let HDA_PIN_CFG_DEV_HP_OUT     : u64 = 0x2
  pub let HDA_PIN_CFG_DEV_CD         : u64 = 0x3
  pub let HDA_PIN_CFG_DEV_SPDIF_OUT  : u64 = 0x4
  pub let HDA_PIN_CFG_DEV_DIG_OUT    : u64 = 0x5
  pub let HDA_PIN_CFG_DEV_MODEM_LINE : u64 = 0x6
  pub let HDA_PIN_CFG_DEV_MODEM_HS   : u64 = 0x7
  pub let HDA_PIN_CFG_DEV_LINE_IN    : u64 = 0x8
  pub let HDA_PIN_CFG_DEV_AUX        : u64 = 0x9
  pub let HDA_PIN_CFG_DEV_MIC_IN     : u64 = 0xA
  pub let HDA_PIN_CFG_DEV_TELEPHONY  : u64 = 0xB
  pub let HDA_PIN_CFG_DEV_SPDIF_IN   : u64 = 0xC
  pub let HDA_PIN_CFG_DEV_DIG_IN     : u64 = 0xD
  pub let HDA_PIN_CFG_DEV_RESERVED   : u64 = 0xE
  pub let HDA_PIN_CFG_DEV_OTHER      : u64 = 0xF

  // ==========================================================================
  // §4 return codes.
  // ==========================================================================

  pub let HDA_PIN_CFG_OK        : u64 = 0
  pub let HDA_PIN_CFG_BAD_INPUT : u64 = 0xFFFFFCAF
  pub let HDA_PIN_CFG_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Stats -- advisory. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_pin_cfg_stats : [u64; 4] = uninit @align(64)

  pub let HDA_PIN_CFG_ST_DECODES  : u64 = 0
  pub let HDA_PIN_CFG_ST_BAD      : u64 = 1

  // ==========================================================================
  // Helper: is_u32(v) -> 1 iff v fits 32 bits.
  //
  // The width gate every getter runs. Split out so the nine getters do
  // not disagree on what "u32" means (a decoder that used "cmp v, 0xFF_FF_FF_FF
  // ; jbe ok" and a decoder that used "cmp v, 0x1_0000_0000 ; jb ok"
  // both look right, and only one of them accepts 0xFFFFFFFF).
  // ==========================================================================

  pub let hda_pin_cfg_is_u32 : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): 1 iff v fits 32 bits (v <= 0xFFFFFFFF). Every field getter §1 calls this before decoding; refuses the input if it has any bit set above bit 31. Splitting the gate into one function keeps 'what u32 means' a single fact rather than nine possibly-disagreeing comparisons. Pure leaf. Labels prefixed hpc_iu_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_iu_no;
        mov rax, 1;
        ret;
      hpc_iu_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Per-field getters. Each is arity ONE (the 32-bit register value)
  // and returns the field VALUE on success, DECODE_BAD on width refusal.
  // ==========================================================================

  // [31:30] port connectivity
  pub let hda_pin_cfg_conn : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract port_connectivity from default_cfg[31:30]. Width gate: v fits 32 bits else DECODE_BAD. Return (v >> 30) & 0x3. Two-bit field: 0=jack, 1=none, 2=fixed, 3=both. Pure. Labels prefixed hpc_c_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_c_bad;
        mov rax, rdi;
        shr rax, 30;
        and rax, 0x3;
        ret;
      hpc_c_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [29:28] gross location
  pub let hda_pin_cfg_gross_loc : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract gross_location from default_cfg[29:28]. Width gate. Return (v >> 28) & 0x3. Pure. Labels prefixed hpc_gl_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_gl_bad;
        mov rax, rdi;
        shr rax, 28;
        and rax, 0x3;
        ret;
      hpc_gl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [27:24] geometric location
  pub let hda_pin_cfg_geom_loc : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract geometric_location from default_cfg[27:24]. Width gate. Return (v >> 24) & 0xF. Pure. Labels prefixed hpc_gm_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_gm_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xF;
        ret;
      hpc_gm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [23:20] default device
  pub let hda_pin_cfg_device : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract default_device from default_cfg[23:20]. Width gate. Return (v >> 20) & 0xF. Sixteen enumerated values per §1: line-out / speaker / hp / cd / spdif-out / digital-out / modem-line / modem-hs / line-in / aux / mic / telephony / spdif-in / digital-in / reserved / other. Pure. Labels prefixed hpc_d_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_d_bad;
        mov rax, rdi;
        shr rax, 20;
        and rax, 0xF;
        ret;
      hpc_d_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [19:16] connection type
  pub let hda_pin_cfg_ctype : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract connection_type from default_cfg[19:16]. Width gate. Return (v >> 16) & 0xF. Enumerated per §1. Pure. Labels prefixed hpc_t_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_t_bad;
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xF;
        ret;
      hpc_t_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [15:12] colour
  pub let hda_pin_cfg_color : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract colour from default_cfg[15:12]. Width gate. Return (v >> 12) & 0xF. Pure. Labels prefixed hpc_k_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_k_bad;
        mov rax, rdi;
        shr rax, 12;
        and rax, 0xF;
        ret;
      hpc_k_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [11:8] misc
  pub let hda_pin_cfg_misc : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract misc from default_cfg[11:8]. Width gate. Return (v >> 8) & 0xF. Bit 0 of the four is jack-detect override. Pure. Labels prefixed hpc_m_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_m_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xF;
        ret;
      hpc_m_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [7:4] default association
  pub let hda_pin_cfg_assoc : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract default_association from default_cfg[7:4]. Width gate. Return (v >> 4) & 0xF. Association 0 means unallocated per §1; the getter returns the raw code without judging it, callers compare. Pure. Labels prefixed hpc_a_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_a_bad;
        mov rax, rdi;
        shr rax, 4;
        and rax, 0xF;
        ret;
      hpc_a_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // [3:0] sequence
  pub let hda_pin_cfg_seq : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): extract sequence from default_cfg[3:0]. Width gate. Return v & 0xF. Pure. Labels prefixed hpc_s_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hpc_s_bad;
        mov rax, rdi;
        and rax, 0xF;
        ret;
      hpc_s_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_pin_cfg_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_pin_cfg_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-003 (#1144): bounds-checked read of one advisory counter. Out of range returns 0. Leaf. Labels prefixed hpc_st_.",
      block: {
        cmp rdi, 4;
        jae hpc_st_zero;
        lea r10, [rip + _hda_pin_cfg_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hpc_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_pin_cfg_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same shape as the other HDA scaffold pins:
  // pinned at 0 by the boot witness so a future milestone that plumbs
  // a real verb-response reader into these decoders cannot land
  // without rewriting the claim (and the enumeration tables above,
  // if a spec revision changes them).
  // ==========================================================================

  pub let hda_pin_cfg_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-003 (#1144): report whether these decoders operate on live codec verb responses today. IT RETURNS 0 -- no verb dispatch runs at this milestone (§0); the decoders take a caller-supplied register value. The boot witness pins it at 0 so a future milestone that reads default_cfg via verb 0xF1C through a live CORB/RIRB path must flip the pin in the same commit. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

}
