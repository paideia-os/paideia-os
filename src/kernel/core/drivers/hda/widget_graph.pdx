  pub let hda_widget_graph_row_conn : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64, idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-002 (#1143): read the idx-th connection node_id from row row_id's connections word. Gates: (1) row_id < count else DECODE_BAD (BAD_ROW class). (2) idx < connections_len else DECODE_BAD (BAD_INDEX class). Return byte slot at bit offset idx*8 of word 1. Leaf. Labels prefixed hwg_rk_.",
      block: {
        lea r10, [rip + _hda_widget_graph_count];
        mov r11, [r10];
        cmp rdi, r11;
        jae hwg_rk_bad;

        mov rax, rdi;
        shl rax, 4;
        lea r10, [rip + _hda_widget_graph_rows];
        add r10, rax;                    // row base

        mov r11, [r10 + 0];              // header
        shr r11, 20;
        and r11, 0xF;                    // connections_len
        cmp rsi, r11;
        jae hwg_rk_bad;

        // shift = idx * 8
        mov rax, rsi;
        shl rax, 3;
        mov rcx, rax;
        mov rax, [r10 + 8];
        shr rax, cl;
        and rax, 0xFF;
        ret;

      hwg_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

