// src/kernel/core/drivers/hda/widget_graph.pdx -- R33.M2-002 (#1143)
//
// The typed record for an Intel HDA codec's WIDGET GRAPH -- the set of
// (codec_addr, node_id, widget_type, connections[]) rows a live probe
// would populate by walking AUDIO_WIDGET_CAP + CONNECTION_LIST verbs.
// SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS A TYPED RECORD TABLE. Per Intel HDA §7.3.4 a codec exposes
// widgets underneath each function group (AFG / MFG), each widget
// identified by a node id and each carrying an AUDIO_WIDGET_CAPABILITY
// dword whose top nibble names the widget TYPE:
//
//   0x0  audio output   (D-to-A converter, a stream sink)
//   0x1  audio input    (A-to-D converter, a stream source)
//   0x2  audio mixer    (mixes multiple inputs)
//   0x3  audio selector (multiplexes multiple inputs into one)
//   0x4  pin complex    (a physical jack / speaker terminal)
//   0x5  power widget   (a power domain node)
//   0x6  volume knob    (a physical knob)
//   0x7  beep generator (a system-speaker beep source)
//   0xF  vendor defined (Realtek's own type outside the enumeration)
//
// Each widget also owns a CONNECTION_LIST -- the set of upstream node
// ids whose output can be routed into this widget's input. The list is
// how the audio graph is TRAVERSED: a screen-auto policy that wants
// audio at the headphone pin walks the connections from that pin back
// through selectors / mixers / audio-outputs to a stream converter.
//
// This module DECLARES the storage and the seams (add a row, append a
// connection, read fields). It does NOT parse verb responses, does NOT
// drive the codec, and does NOT walk the graph -- graph traversal is a
// consumer of the read seams and lives in userspace once the query
// channel (issue #1146) is plumbed.
//
// IT IS NOT A LIVE POPULATION PASS. Same discipline as the four
// R33.M1 scaffolds: the pin `hda_widget_graph_arbitrated() == 0` --
// an assertion that FAILS the moment a future milestone plumbs real
// verb-response consumption into the row mutators -- forces the
// design doc to be updated at that time.
//
// =============================================================================
// §1  ROW LAYOUT IS FIXED, NOT NEGOTIATED
// =============================================================================
//
// One row is two u64 words = 16 bytes. Row `i` sits at byte offset
// `i * 16` in `_hda_widget_graph_rows`.
//
//   word 0 -- header
//     [ 7:0]  codec_addr (u4 -- 0..15)
//     [15:8]  node_id    (u8 -- 0..255)
//     [19:16] widget_type (u4 -- one of {0..7, F})
//     [23:20] connections_len (u4 -- 0..8; §3 bounds it at HDA_WG_CONN_MAX)
//     [63:24] reserved zero
//
//   word 1 -- connections
//     [ 7: 0]  connections[0] node_id (u8)
//     [15: 8]  connections[1]
//     [23:16]  connections[2]
//     [31:24]  connections[3]
//     [39:32]  connections[4]
//     [47:40]  connections[5]
//     [55:48]  connections[6]
//     [63:56]  connections[7]
//
// Eight connections cap per row because the Realtek ALC287 mixer /
// selector widgets top out at eight inputs, and a fixed cap makes
// "the row is 16 bytes" a source-of-truth number the confinement
// gate can check.
//
// The row is a LATCH once its header is written -- add_row refuses a
// second write to the same (codec_addr, node_id). append_conn advances
// connections_len and writes into the next byte slot; it refuses once
// connections_len reaches HDA_WG_CONN_MAX.
//
// =============================================================================
// §2  ONE WRITER OF THE ROWS AND THE COUNT
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_widget_graph_rows`,
// `_hda_widget_graph_count` and `_hda_widget_graph_stats` to this
// object. A second writer of the row table would let another module
// invent a widget the codec never advertised; a second writer of the
// count would let a caller reserve a row without going through the
// LATCH-per-header gate that add_row enforces.
//
// The table size is HDA_WG_MAX_ROWS = 128 rows = 2048 bytes. That is
// two 64-widget codecs' worth (the ALC287 declares ~54; the ceiling
// is deliberately loose so a second codec (HDMI, on the same
// controller) can share the table without needing a per-codec split).
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr >= 16 -> BAD_ADDR (refused, not masked).
// node_id >= 256 -> BAD_NODE.
// widget_type not in {0..7, F} -> BAD_TYPE.
// Table full (count >= MAX_ROWS) -> FULL.
// A second add for the same (codec_addr, node_id) -> REBIND.
// connections_len already at MAX_CONN on append_conn -> FULL_CONN.
// Row id out of range on any read seam -> BAD_ROW.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO VERB-RESPONSE INGEST. add_row is called by whatever binds a
//     row from an upper layer's belief about the codec; a live pass
//     would ingest the AUDIO_WIDGET_CAP verb response and derive
//     widget_type from bits [23:20] of that response. Deferred to
//     R33.M3.
//
//   * NO CONNECTION-LIST VERB PARSE. Per HDA §7.3.3.2 the connection
//     list is walked by verb 0xF02 GET_CONNECTION_LIST_ENTRY over
//     multiple invocations. append_conn today accepts a caller-
//     supplied node id; a live pass would decode the verb reply.
//
//   * NO ARBITRATION. Same shape as the four R33.M1 scaffolds:
//     `hda_widget_graph_arbitrated() == 0` is pinned by the boot
//     witness so a future milestone that reads real verb replies
//     into these rows cannot land silently.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC90..0xFFFFFC9F
// =============================================================================

module WidgetGraph = structure {

  // ==========================================================================
  // §1 widget type enumeration (per Intel HDA §7.3.4).
  // ==========================================================================

  pub let HDA_WG_TYPE_AUDIO_OUT   : u64 = 0x0
  pub let HDA_WG_TYPE_AUDIO_IN    : u64 = 0x1
  pub let HDA_WG_TYPE_MIXER       : u64 = 0x2
  pub let HDA_WG_TYPE_SELECTOR    : u64 = 0x3
  pub let HDA_WG_TYPE_PIN_COMPLEX : u64 = 0x4
  pub let HDA_WG_TYPE_POWER       : u64 = 0x5
  pub let HDA_WG_TYPE_VOLUME_KNOB : u64 = 0x6
  pub let HDA_WG_TYPE_BEEP_GEN    : u64 = 0x7
  pub let HDA_WG_TYPE_VENDOR      : u64 = 0xF

  // ==========================================================================
  // §1 / §2 table geometry.
  // ==========================================================================

  pub let HDA_WG_MAX_ROWS  : u64 = 128
  pub let HDA_WG_CONN_MAX  : u64 = 8
  pub let HDA_WG_ROW_BYTES : u64 = 16   // two u64 words per row

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_WG_OK            : u64 = 0
  pub let HDA_WG_BAD_ADDR      : u64 = 0xFFFFFC9F
  pub let HDA_WG_BAD_NODE      : u64 = 0xFFFFFC9E
  pub let HDA_WG_BAD_TYPE      : u64 = 0xFFFFFC9D
  pub let HDA_WG_FULL          : u64 = 0xFFFFFC9C
  pub let HDA_WG_REBIND        : u64 = 0xFFFFFC9B
  pub let HDA_WG_FULL_CONN     : u64 = 0xFFFFFC9A
  pub let HDA_WG_BAD_ROW       : u64 = 0xFFFFFC99
  pub let HDA_WG_BAD_INDEX     : u64 = 0xFFFFFC98
  pub let HDA_WG_BAD_CONN_NODE : u64 = 0xFFFFFC97

  pub let HDA_WG_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // 128 rows * 16 bytes = 2048 bytes = 256 u64 slots.
  // ==========================================================================

  pub let mut _hda_widget_graph_rows  : [u64; 256] = uninit @align(64)
  pub let mut _hda_widget_graph_count : u64 = 0
  pub let mut _hda_widget_graph_stats : [u64; 8] = uninit @align(64)

  pub let HDA_WG_ST_ADDS       : u64 = 0
  pub let HDA_WG_ST_APPENDS    : u64 = 1
  pub let HDA_WG_ST_BAD_ADDR   : u64 = 2
  pub let HDA_WG_ST_BAD_NODE   : u64 = 3
  pub let HDA_WG_ST_BAD_TYPE   : u64 = 4
  pub let HDA_WG_ST_FULL       : u64 = 5
  pub let HDA_WG_ST_REBIND     : u64 = 6
  pub let HDA_WG_ST_FULL_CONN  : u64 = 7

  // ==========================================================================
  // hda_widget_graph_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Pinned at 0 by the boot witness so a future
  // milestone plumbing real verb-response ingest into the row mutators
  // cannot land without rewriting the claim.
  // ==========================================================================

  pub let hda_widget_graph_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-002 (#1143): report whether the widget graph is populated from real codec verb responses today. IT RETURNS 0 -- add_row and append_conn take caller-supplied bytes at this milestone (§4). The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_widget_graph_reset() -> ()
  //
  // Bring the table back to empty. Zeroes the count only -- rows are
  // never read past the count, so the row bytes are dead until the
  // next add. A live driver would call this on codec-detach so a
  // subsequent re-probe does not carry stale rows across.
  // ==========================================================================

  pub let hda_widget_graph_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-002 (#1143): zero the row count so subsequent adds start at row 0. Row bytes past the new count are dead by construction; leaving them uncleared is faster and matches the discipline elsewhere (rows are not read past count). Returns 0. Leaf. Labels prefixed hwg_r_.",
      block: {
        lea r10, [rip + _hda_widget_graph_count];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_widget_graph_count() -> count
  // ==========================================================================

  pub let hda_widget_graph_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-002 (#1143): read the current row count. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_widget_graph_count];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_widget_graph_type_valid(t) -> 1 | 0
  //
  // 1 iff t is in the enumeration §1. Split out so add_row and future
  // per-type filters agree on which types are legal.
  // ==========================================================================

  pub let hda_widget_graph_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-002 (#1143): 1 iff t is one of the nine enumerated widget types {0..7, F}. A fifth-nibble value would be a spec revision the driver has not seen; refused rather than silently mapped to 'other' so the row's type field always names a real spec category. Pure leaf. Labels prefixed hwg_tv_.",
      block: {
        cmp rdi, 7;
        jbe hwg_tv_yes;
        cmp rdi, 0xF;
        je  hwg_tv_yes;
        xor rax, rax;
        ret;
      hwg_tv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_widget_graph_find(codec_addr, node_id) -> row_id | HDA_WG_MAX_ROWS
  //
  // Linear scan of the populated rows. Returns HDA_WG_MAX_ROWS (=128)
  // as the "not found" sentinel -- disjoint from every legal row id,
  // and equal to the ceiling so callers that unconditionally compare
  // "< count" reject it cleanly.
  // ==========================================================================

  pub let hda_widget_graph_find : (u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-002 (#1143): return the row id whose header matches (codec_addr, node_id). Linear scan of count rows; returns 128 if not found. The 'not found' sentinel is chosen equal to HDA_WG_MAX_ROWS so a caller that unconditionally compares 'row < count' rejects it (count is <= 128). Labels prefixed hwg_f_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // codec_addr
        mov r13, rsi;                    // node_id

        lea r14, [rip + _hda_widget_graph_count];
        mov r14, [r14];                  // count
        xor rbx, rbx;                    // row idx

      hwg_f_scan:
        cmp rbx, r14;
        jae hwg_f_not_found;

        // Compute row base = rows + rbx * 16.
        mov rax, rbx;
        shl rax, 4;                      // *16
        lea r10, [rip + _hda_widget_graph_rows];
        add r10, rax;
        mov r11, [r10 + 0];              // header word

        // codec_addr = r11 & 0xFF
        mov rax, r11;
        and rax, 0xFF;
        cmp rax, r12;
        jne hwg_f_next;

        // node_id = (r11 >> 8) & 0xFF
        mov rax, r11;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, r13;
        jne hwg_f_next;

        mov rax, rbx;
        jmp hwg_f_out;

      hwg_f_next:
        add rbx, 1;
        jmp hwg_f_scan;

      hwg_f_not_found:
        mov rax, 128;                    // HDA_WG_MAX_ROWS

      hwg_f_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_widget_graph_add(codec_addr, node_id, widget_type) -> row_id | code
  //
  // ARITY THREE: the three header fields excluding connections_len,
  // which starts at zero and is advanced by append_conn. A caller-
  // supplied connections_len would let the caller reserve slots
  // append_conn had not been called for -- exactly the confusion
  // "widen add" avoids by matching the row shape as it is populated.
  //
  // Gates, in order:
  //   (1) codec_addr < 16                   else BAD_ADDR
  //   (2) node_id < 256                     else BAD_NODE
  //   (3) widget_type in enumeration        else BAD_TYPE
  //   (4) count < MAX_ROWS                  else FULL
  //   (5) no existing row for this (a, n)   else REBIND
  //   (6) write header, zero connections,
  //       bump count, return new row id.
  // ==========================================================================

  pub let hda_widget_graph_add : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, widget_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-002 (#1143): add a widget row. Gates: (1) codec_addr < 16 else BAD_ADDR (refused, not masked -- a codec_addr of 16 is a wire-field overflow and silently masking to 0 would insert a row for a codec the caller did not name). (2) node_id < 256 else BAD_NODE. (3) widget_type in {0..7, F} else BAD_TYPE (refused rather than mapped to 'other' -- see hda_widget_graph_type_valid). (4) count < MAX_ROWS else FULL. (5) no existing row for (codec_addr, node_id) else REBIND: the row is a LATCH per §1 -- a second add for the same header would let two callers disagree on what type the same widget is. (6) write header at count*16 and zero the connections word, bump count. Returns the new row id. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed hwg_a_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr
        mov r13, rsi;                    // node_id
        mov r14, rdx;                    // widget_type

        // (1) codec_addr < 16
        cmp r12, 16;
        jae hwg_a_bad_addr;

        // (2) node_id < 256
        mov r10, 256;
        cmp r13, r10;
        jae hwg_a_bad_node;

        // (3) widget_type valid
        mov rdi, r14;
        call hda_widget_graph_type_valid;
        cmp rax, 0;
        je  hwg_a_bad_type;

        // (4) count < MAX_ROWS
        lea r10, [rip + _hda_widget_graph_count];
        mov r15, [r10];                  // count (also new row id if we succeed)
        mov r11, 128;                    // HDA_WG_MAX_ROWS
        cmp r15, r11;
        jae hwg_a_full;

        // (5) not already present
        mov rdi, r12;
        mov rsi, r13;
        call hda_widget_graph_find;
        mov r11, 128;
        cmp rax, r11;
        jne hwg_a_rebind;

        // (6) write header + zero connections, bump count.
        mov rax, r15;
        shl rax, 4;                      // row byte offset
        lea r10, [rip + _hda_widget_graph_rows];
        add r10, rax;                    // row base

        // header word: codec_addr [7:0] | node_id [15:8] | type [19:16]
        // connections_len [23:20] starts at 0.
        mov rax, r12;
        and rax, 0xFF;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        mov r11, r14;
        and r11, 0xF;
        shl r11, 16;
        or  rax, r11;
        mov [r10 + 0], rax;

        // connections word: zero.
        xor rax, rax;
        mov [r10 + 8], rax;

        // bump count.
        lea r10, [rip + _hda_widget_graph_count];
        mov rax, r15;
        add rax, 1;
        mov [r10], rax;

        // ST_ADDS++
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        mov rax, r15;                    // new row id
        jmp hwg_a_out;

      hwg_a_bad_addr:
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC9F;
        jmp hwg_a_out;
      hwg_a_bad_node:
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC9E;
        jmp hwg_a_out;
      hwg_a_bad_type:
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC9D;
        jmp hwg_a_out;
      hwg_a_full:
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC9C;
        jmp hwg_a_out;
      hwg_a_rebind:
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC9B;

      hwg_a_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_widget_graph_append_conn(row_id, target_node) -> code
  //
  // ARITY TWO. Appends target_node to row_id's connection list,
  // advancing connections_len. Refuses if the list is already at
  // HDA_WG_CONN_MAX. Refuses if target_node does not fit u8.
  // Refuses if row_id is not a live row.
  // ==========================================================================

  pub let hda_widget_graph_append_conn : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64, target_node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-002 (#1143): append target_node to row_id's connection list. Gates, in order: (1) row_id < count else BAD_ROW. (2) target_node < 256 else BAD_CONN_NODE (refused, not masked -- a target beyond wire width is a caller error). (3) connections_len < HDA_WG_CONN_MAX else FULL_CONN. Then: write target_node into the next byte slot of word 1, bump connections_len in the header. Returns OK. Two pushes leave rsp%16 == 0 at nested-call sites (there are none in this seam, but the shape stays consistent with the rest of the module). Labels prefixed hwg_ap_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // target_node

        // (1) row_id < count
        lea r10, [rip + _hda_widget_graph_count];
        mov r11, [r10];
        cmp rbx, r11;
        jae hwg_ap_bad_row;

        // (2) target_node < 256
        mov r10, 256;
        cmp r12, r10;
        jae hwg_ap_bad_conn_node;

        // Row base
        mov rax, rbx;
        shl rax, 4;
        lea r10, [rip + _hda_widget_graph_rows];
        add r10, rax;                    // r10 = row base

        // (3) connections_len < HDA_WG_CONN_MAX
        mov r11, [r10 + 0];              // header
        mov rax, r11;
        shr rax, 20;
        and rax, 0xF;                    // current len
        cmp rax, 8;
        jae hwg_ap_full_conn;

        // Write target_node into byte slot `len` of word 1.
        mov r11, rax;                    // save current len
        shl rax, 3;                      // len * 8 bits shift
        mov rcx, rax;                    // rcx = shift amount
        mov r8, [r10 + 8];               // current connections word
        mov r9, r12;
        and r9, 0xFF;
        shl r9, cl;                      // shift by cl (low byte of rcx)
        or  r8, r9;
        mov [r10 + 8], r8;

        // Advance connections_len in the header: header[23:20] += 1.
        mov rax, [r10 + 0];
        mov r8, 0xF;
        shl r8, 20;                      // mask for [23:20]
        not r8;
        and rax, r8;                     // clear len
        mov r8, r11;                     // old len
        add r8, 1;
        and r8, 0xF;
        shl r8, 20;
        or  rax, r8;
        mov [r10 + 0], rax;

        // ST_APPENDS++
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;

        xor rax, rax;                    // OK
        jmp hwg_ap_out;

      hwg_ap_bad_row:
        mov rax, 0xFFFFFC99;
        jmp hwg_ap_out;
      hwg_ap_bad_conn_node:
        mov rax, 0xFFFFFC97;
        jmp hwg_ap_out;
      hwg_ap_full_conn:
        lea r10, [rip + _hda_widget_graph_stats];
        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;
        mov rax, 0xFFFFFC9A;

      hwg_ap_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Read seams. All arity ONE (row_id) or TWO (row_id, index).
  // Return DECODE_BAD on BAD_ROW / BAD_INDEX.
  // ==========================================================================

  pub let hda_widget_graph_row_codec : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-002 (#1143): read codec_addr from row row_id's header [7:0]. Gate: row_id < count else DECODE_BAD. Leaf. Labels prefixed hwg_rc_.",
      block: {
        lea r10, [rip + _hda_widget_graph_count];
        mov r11, [r10];
        cmp rdi, r11;
        jae hwg_rc_bad;
        mov rax, rdi;
        shl rax, 4;
        lea r10, [rip + _hda_widget_graph_rows];
        add r10, rax;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        ret;
      hwg_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let hda_widget_graph_row_node : (u64) -> u64 !{mem} @{} =
