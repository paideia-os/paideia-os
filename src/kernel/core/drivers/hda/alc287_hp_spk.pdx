// src/kernel/core/drivers/hda/alc287_hp_spk.pdx -- R33.M4-002 (#1153)
//
// The Realtek ALC287 HEADPHONE + SPEAKER output path setup, and the
// JACK-DRIVEN AUTO-SWITCH that arbitrates between them. SCAFFOLD-
// COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE HP + SPK PATH BINDER for the ALC287 codec on the T14 G4:
//
//   * Pin 0x21 = HP jack (analog headphone / headset output)
//   * Pin 0x14 = internal speaker (class-D amp, EAPD-controlled)
//
// The path binder issues the two SET_PIN_WIDGET_CTL verbs that put each
// pin in its correct direction (HP + amp for the HP jack, out + amp for
// the speaker), and the SET_EAPD_BTL_ENABLE verb that switches on the
// speaker's external amplifier. The AUTO-SWITCH seam consumes a jack
// state (1 = plugged, 0 = unplugged) and re-issues a small set of
// verbs to route audio between the two outputs -- mute the speaker
// when the HP is plugged, unmute it when unplugged.
//
// IT IS NOT A LIVE PATH. Same discipline as the other R33 scaffolds:
// the pin `hda_alc287_hp_spk_arbitrated() == 0` -- an assertion that
// FAILS the moment a future milestone plumbs real MMIO through the
// underlying CORB/RIRB path -- forces the design doc to be updated at
// that time.
//
// TWO PINS, TWO NODE IDS, FIXED. Widening the seams to accept caller-
// supplied pin nids would let a stray helper route audio to a pin
// nobody named -- exactly the confusion the vendor wrapper exists to
// remove: only this module writes ALC287-specific HP/SPK path bits.
//
// =============================================================================
// §1  VERB SEQUENCES ARE FIXED, NOT NEGOTIATED
// =============================================================================
//
// bind():
//   SET_PIN_WIDGET_CTL(HP_NID=0x21, 0xC0)   -- OUT (bit 6) + HP amp (bit 7)
//   SET_PIN_WIDGET_CTL(SPK_NID=0x14, 0x40)  -- OUT (bit 6) only, no HP amp
//   SET_EAPD_BTL_ENABLE(SPK_NID=0x14, 0x02) -- EAPD bit set, BTL clear
//
// auto_switch(plugged=1):    (HP plugged: HP live, speaker muted)
//   SET_AMP_GAIN_MUTE(HP_NID, 0xB000)   -- unmute HP L+R output amp
//   SET_AMP_GAIN_MUTE(SPK_NID, 0xB080)  -- mute SPK L+R output amp
//
// auto_switch(plugged=0):    (HP unplugged: speaker live, HP muted)
//   SET_AMP_GAIN_MUTE(HP_NID, 0xB080)   -- mute HP
//   SET_AMP_GAIN_MUTE(SPK_NID, 0xB000)  -- unmute SPK
//
// The AMP_GAIN_MUTE payload bits (per HDA §7.3.3.7 / verbs.pdx §1):
//   [15]=set-output, [14]=set-input,
//   [13]=set-left,   [12]=set-right,
//   [11:8]=index (0 for the sole output amp), [7]=mute, [6:0]=gain.
//
// So 0xB000 = set-out + set-L + set-R + gain 0 (unmute at zero-dB).
//    0xB080 = set-out + set-L + set-R + mute (gain zero, mute bit set).
//
// =============================================================================
// §2  ONE READER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_alc287_hp_spk_stats`
// to this object. Counters and the current state latch are the only
// record of what the auto-switch has decided; a second writer would let
// another module claim the codec is muted while its speaker is running.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr >= 16                       -> BAD_ADDR (bind, auto_switch)
// bind() before init                     -> NOT_INIT (defers to
//                                            hda_alc287_init_bound())
// auto_switch() before bind              -> NOT_BOUND
// Any underlying verb send not
//   DEFERRED_HARDWARE                    -> VERB_FAIL
// jack_state not in {0, 1}               -> BAD_STATE
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL VERB TRANSPORT. The verb helpers scaffold, R33.M2 §4.
//   * NO AMP INTROSPECTION. A live driver would read AUDIO_WIDGET_CAP
//     for each pin's amp presence before writing to it; this scaffold
//     assumes the ALC287 pin cap layout the Realtek datasheet documents.
//   * NO SMOOTH VOLUME RAMP. auto_switch snaps the transition; a live
//     policy would fade over ~10 ms to avoid a click. Deferred.
//   * NO ARBITRATION. Pinned at 0.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCD0..0xFFFFFCDF
// =============================================================================

module Alc287HpSpk = structure {

  // ==========================================================================
  // §1 constants.
  // ==========================================================================

  pub let HDA_ALC287_HP_NID           : u64 = 0x21
  pub let HDA_ALC287_SPK_NID          : u64 = 0x14

  pub let HDA_ALC287_PIN_CTL_OUT_HP   : u64 = 0xC0  // OUT + HP amp
  pub let HDA_ALC287_PIN_CTL_OUT_SPK  : u64 = 0x40  // OUT only
  pub let HDA_ALC287_EAPD_ON          : u64 = 0x02  // EAPD bit set

  pub let HDA_ALC287_AMP_UNMUTE       : u64 = 0xB000
  pub let HDA_ALC287_AMP_MUTE         : u64 = 0xB080

  // Jack states.
  pub let HDA_ALC287_JACK_UNPLUGGED   : u64 = 0
  pub let HDA_ALC287_JACK_PLUGGED     : u64 = 1

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_ALC287_HS_OK          : u64 = 0
  pub let HDA_ALC287_HS_BAD_ADDR    : u64 = 0xFFFFFCDF
  pub let HDA_ALC287_HS_NOT_INIT    : u64 = 0xFFFFFCDE
  pub let HDA_ALC287_HS_NOT_BOUND   : u64 = 0xFFFFFCDD
  pub let HDA_ALC287_HS_VERB_FAIL   : u64 = 0xFFFFFCDC
  pub let HDA_ALC287_HS_BAD_STATE   : u64 = 0xFFFFFCDB

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // Slots:
  //   [0] ST_BINDS       -- successful bind calls
  //   [1] ST_SWITCHES    -- successful auto_switch calls
  //   [2] ST_BAD_ADDR    -- BAD_ADDR refusals
  //   [3] ST_NOT_INIT    -- NOT_INIT refusals
  //   [4] ST_NOT_BOUND   -- NOT_BOUND refusals
  //   [5] ST_VERB_FAIL   -- verb-send non-DEFERRED refusals
  //   [6] ST_BAD_STATE   -- BAD_STATE refusals
  //   [7] ST_BOUND       -- latch (0 = never bound; non-zero = codec+1)
  //   [8] ST_JACK_STATE  -- current jack state as last set (0/1); 0xFF if
  //                          auto_switch has never been called.
  // ==========================================================================

  pub let mut _hda_alc287_hp_spk_stats : [u64; 16] = uninit @align(64)

  pub let HDA_ALC287_HS_ST_BINDS      : u64 = 0
  pub let HDA_ALC287_HS_ST_SWITCHES   : u64 = 1
  pub let HDA_ALC287_HS_ST_BAD_ADDR   : u64 = 2
  pub let HDA_ALC287_HS_ST_NOT_INIT   : u64 = 3
  pub let HDA_ALC287_HS_ST_NOT_BOUND  : u64 = 4
  pub let HDA_ALC287_HS_ST_VERB_FAIL  : u64 = 5
  pub let HDA_ALC287_HS_ST_BAD_STATE  : u64 = 6
  pub let HDA_ALC287_HS_ST_BOUND      : u64 = 7
  pub let HDA_ALC287_HS_ST_JACK_STATE : u64 = 8

  // ==========================================================================
  // hda_alc287_hp_spk_arbitrated() -> 0
  // ==========================================================================

  pub let hda_alc287_hp_spk_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M4-002 (#1153): report whether the HP/SPK path issues real MMIO today. IT RETURNS 0 -- every verb is routed through hda_verb_send_long / hda_verb_send_short scaffolds. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_hp_spk_bound() -> 0 | codec+1
  // ==========================================================================

  pub let hda_alc287_hp_spk_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-002 (#1153): read the bind latch. 0 means never bound; non-zero encodes (codec_addr+1). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + 56];             // slot 7
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_hp_spk_bind(codec_addr) -> code
  //
  // ARITY ONE. Emits the three verbs of §1 (SET_PIN_WIDGET_CTL x2 +
  // SET_EAPD_BTL_ENABLE x1) and latches the codec. Refuses if the
  // vendor init hasn't run for this codec (a HP amp write before the
  // headroom coefficient is set can produce an audible click on real
  // hardware).
  // ==========================================================================

  pub let hda_alc287_hp_spk_bind : (u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-002 (#1153): bind the HP + SPK path on codec_addr. Gates: (1) codec_addr < 16 else BAD_ADDR. (2) hda_alc287_init_bound() reports codec_addr+1 else NOT_INIT (a live driver refuses this order because the HP amp headroom coefficient from init pair 5 must be in place before an amp write goes out). (3) Latch cell zero else return OK (idempotent -- a second bind writes the same three verbs; unlike init, the pin/eapd writes are safe to repeat). Verbs in table order (§1). On any non-DEFERRED return, ST_VERB_FAIL and refuse. On success, bump ST_BINDS, stamp latch codec+1. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed has_bd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr

        // (1) codec_addr < 16
        cmp r12, 16;
        jae has_bd_bad_addr;

        // (2) init already run for this codec?
        call hda_alc287_init_bound;
        mov r13, r12;
        add r13, 1;                      // expected latch value
        cmp rax, r13;
        jne has_bd_not_init;

        // (SET_PIN_WIDGET_CTL HP, 0xC0)
        mov rdi, r12;
        mov rsi, 0x21;                   // HP_NID
        mov rdx, 0xC0;                   // OUT + HP
        call hda_verb_set_pin_ctl;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne has_bd_verb_fail;

        // (SET_PIN_WIDGET_CTL SPK, 0x40)
        mov rdi, r12;
        mov rsi, 0x14;                   // SPK_NID
        mov rdx, 0x40;                   // OUT
        call hda_verb_set_pin_ctl;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne has_bd_verb_fail;

        // (SET_EAPD_BTL_ENABLE SPK, 0x02)
        mov rdi, r12;
        mov rsi, 0x14;                   // SPK_NID
        mov rdx, 0x02;                   // EAPD bit
        call hda_verb_set_eapd;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne has_bd_verb_fail;

        // Success: bump ST_BINDS, stamp latch.
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        mov rax, r12;
        add rax, 1;
        mov [r10 + 56], rax;             // latch codec+1

        xor rax, rax;
        jmp has_bd_out;

      has_bd_bad_addr:
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFCDF;
        jmp has_bd_out;
      has_bd_not_init:
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFCDE;
        jmp has_bd_out;
      has_bd_verb_fail:
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov r11, [r10 + 40];
        add r11, 1;
        mov [r10 + 40], r11;
        mov rax, 0xFFFFFCDC;

      has_bd_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_hp_spk_auto_switch(jack_state) -> code
  //
  // ARITY ONE (excluding the implicit codec_addr, which is read from the
  // bind latch). Chooses one of two verb sequences (§1) based on
  // jack_state and reissues the two SET_AMP_GAIN_MUTE writes.
  //
  // A caller-supplied codec_addr would be redundant with the latched
  // one; a mismatch would let a driver mute a codec it does not own.
  // ==========================================================================

  pub let hda_alc287_hp_spk_auto_switch : (u64) -> u64 !{mem} @{} =
    fn (jack_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-002 (#1153): switch HP/SPK path based on jack_state (1 = plugged -> HP live, SPK muted; 0 = unplugged -> SPK live, HP muted). Gates: (1) bind latch non-zero else NOT_BOUND. (2) jack_state in {0, 1} else BAD_STATE (refused, not truncated -- a state outside the enumeration means the caller's jack detection is broken and should not silently reach the amps). Read codec_addr = latch - 1. Issue two SET_AMP_GAIN_MUTE via hda_verb_set_amp_gain with the payloads from §1. On success, bump ST_SWITCHES and stamp ST_JACK_STATE with the current state (advisory; the loader for the auto-switch decision is the interrupt path in alc287_jack.pdx). Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed has_sw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // jack_state

        // (1) bound?
        call hda_alc287_hp_spk_bound;
        cmp rax, 0;
        je  has_sw_not_bound;
        sub rax, 1;
        mov r13, rax;                    // codec_addr

        // (2) jack_state in {0, 1}
        cmp r12, 1;
        ja  has_sw_bad_state;

        // Choose payloads.
        // plugged (1): HP unmute (0xB000), SPK mute (0xB080)
        // unplugged (0): HP mute (0xB080), SPK unmute (0xB000)
        cmp r12, 1;
        je  has_sw_plugged;

        // Unplugged path.
        mov r14, 0xB080;                 // HP mute
        mov r15, 0xB000;                 // SPK unmute
        jmp has_sw_do;

      has_sw_plugged:
        mov r14, 0xB000;                 // HP unmute
        mov r15, 0xB080;                 // SPK mute

      has_sw_do:
        // SET_AMP_GAIN_MUTE HP
        mov rdi, r13;
        mov rsi, 0x21;                   // HP_NID
        mov rdx, r14;
        call hda_verb_set_amp_gain;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne has_sw_verb_fail;

        // SET_AMP_GAIN_MUTE SPK
        mov rdi, r13;
        mov rsi, 0x14;                   // SPK_NID
        mov rdx, r15;
        call hda_verb_set_amp_gain;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne has_sw_verb_fail;

        // Success.
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        mov [r10 + 64], r12;             // ST_JACK_STATE = latest

        xor rax, rax;
        jmp has_sw_out;

      has_sw_not_bound:
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFCDD;
        jmp has_sw_out;
      has_sw_bad_state:
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFCDB;
        jmp has_sw_out;
      has_sw_verb_fail:
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov r11, [r10 + 40];
        add r11, 1;
        mov [r10 + 40], r11;
        mov rax, 0xFFFFFCDC;

      has_sw_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_hp_spk_reset() -> ()
  //
  // Clear the bind latch. Boot-witness teardown only.
  // ==========================================================================

  pub let hda_alc287_hp_spk_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-002 (#1153): clear the bind latch. Cumulative counters preserved. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        xor rax, rax;
        mov [r10 + 56], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_hp_spk_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_alc287_hp_spk_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-002 (#1153): bounds-checked read of one HP/SPK counter. Out of range returns 0. Leaf. Labels prefixed has_st_.",
      block: {
        cmp rdi, 16;
        jae has_st_zero;
        lea r10, [rip + _hda_alc287_hp_spk_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      has_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

}
