// src/kernel/core/drivers/hda/sof_effects.pdx -- R33.M6-003 (#1164)
//
// The Sound Open Firmware (SOF) DSP EFFECT PIPELINE dispatch scaffold.
// SCAFFOLD-COMPATIBLE. OPTIONAL PATH.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE EFFECT-PIPELINE DISPATCH SEAM for Realtek DSP effects
// exposed through the ALC287 codec when SOF is present. The effect
// pipeline is an optional processing chain the DSP applies between
// the PCM input and the codec's mixer bank: bass boost, HP compander,
// dynamic-range compression, wind-noise reduction on the mic array.
// Each effect is identified by an EFFECT KIND (§1) and slotted into
// one of eight FIXED PIPELINE SLOTS.
//
// This module DECLARES:
//
//   * the eight kind constants (bass, drc, mic_agc, ns, comp, eq,
//     3d, passthrough);
//   * a fixed-arity attach seam (attach_effect(slot, kind));
//   * a fixed-arity detach seam (detach_effect(slot));
//   * the pipeline-load latch (pipeline_load()) which asserts the
//     preconditions once and refuses on a second call;
//   * the arbitration pin (arbitrated() == 0).
//
// This module PERFORMS NO REAL DSP DISPATCH -- the underlying SOF
// loader path (sof_loader.pdx) is a scaffold, and no ADSP mailbox is
// programmed. Every attach/detach records the (slot, kind) pair in
// the pipeline table and returns DEFERRED_HARDWARE.
//
// THIS PATH IS OPTIONAL. The whole module gates on
// hda_alc287_init_bound() reporting a bound codec AND
// hda_sof_loader_ready() reporting a READY loader. If EITHER is
// false, every call returns NOT_READY. A machine without SOF (SOF is
// runtime-optional per D2.b) never exercises this path, and the
// gating is what guarantees no half-programmed effect chain leaks
// into the PCM path on such a machine.
//
// IT IS NOT A LIVE PIPELINE. Same discipline as the M1..M5 scaffolds:
// the pin `hda_sof_effects_arbitrated() == 0` -- an assertion that
// FAILS the moment a future milestone plumbs real IPC through the
// ADSP mailbox -- forces the design doc to be updated at that time.
//
// ARITY IS TWO ON ATTACH (slot, kind). A caller-supplied EFFECT
// PARAMETER blob would let a helper install an arbitrary payload on
// the codec's analog path -- exactly what the vendor wrapper (M4)
// exists to prevent. Effect parameters are fixed per kind at this
// milestone; a live implementation would layer a typed parameter
// setter (set_bass_gain(slot, gain), set_drc_threshold(slot, thr))
// over this, each with its own gate.
//
// =============================================================================
// §1  EFFECT KIND ENUM
// =============================================================================
//
//   0  HDA_SOF_FX_PASSTHROUGH  - identity; useful for testing.
//   1  HDA_SOF_FX_BASS         - low-shelf boost on the HP path.
//   2  HDA_SOF_FX_DRC          - dynamic-range compression on the mixer.
//   3  HDA_SOF_FX_MIC_AGC      - AGC on the mic array.
//   4  HDA_SOF_FX_NS           - two-line noise suppression.
//   5  HDA_SOF_FX_COMP         - HP compander (Realtek-specific).
//   6  HDA_SOF_FX_EQ           - fixed 5-band EQ.
//   7  HDA_SOF_FX_3D           - HP spatial widening.
//
// A kind >= 8 is REFUSED as BAD_KIND. Adding a kind requires an edit
// here + one in sof_effects_synth.pdx's coverage; the enum is
// deliberately closed at this milestone.
//
// =============================================================================
// §2  ONE WRITER OF THE PIPELINE TABLE
// =============================================================================
//
// tools/build.sh confines relocations against
// `_hda_sof_effects_pipeline` and `_hda_sof_effects_stats` to this
// object. The pipeline table is the only evidence of what effect
// occupies each slot; a second writer would let another module claim
// a mixer slot without the codec's knowledge.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
//   codec unbound OR loader not READY    -> NOT_READY
//   slot >= 8                            -> BAD_SLOT
//   kind >= 8                            -> BAD_KIND
//   attach into occupied slot            -> SLOT_BUSY
//   detach from empty slot               -> SLOT_EMPTY
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL IPC. Attach/detach do not touch the ADSP mailbox.
//   * NO EFFECT PARAMETER STAGING. A live driver would push per-kind
//     parameter blobs alongside each attach.
//   * NO REORDERING GUARANTEES. Slots are independent by construction
//     at this milestone; a live pipeline enforces a fixed traversal
//     order and this module does not.
//   * NO ARBITRATION. `hda_sof_effects_arbitrated() == 0` is pinned
//     by the boot witness.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC60..0xFFFFFC6F
// =============================================================================

module SofEffects = structure {

  // ==========================================================================
  // §1 kinds.
  // ==========================================================================

  pub let HDA_SOF_FX_PASSTHROUGH : u64 = 0
  pub let HDA_SOF_FX_BASS        : u64 = 1
  pub let HDA_SOF_FX_DRC         : u64 = 2
  pub let HDA_SOF_FX_MIC_AGC     : u64 = 3
  pub let HDA_SOF_FX_NS          : u64 = 4
  pub let HDA_SOF_FX_COMP        : u64 = 5
  pub let HDA_SOF_FX_EQ          : u64 = 6
  pub let HDA_SOF_FX_3D          : u64 = 7

  pub let HDA_SOF_FX_KIND_MAX    : u64 = 8
  pub let HDA_SOF_FX_SLOT_MAX    : u64 = 8

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_SOF_FX_OK                 : u64 = 0
  pub let HDA_SOF_FX_NOT_READY          : u64 = 0xFFFFFC6F
  pub let HDA_SOF_FX_BAD_SLOT           : u64 = 0xFFFFFC6E
  pub let HDA_SOF_FX_BAD_KIND           : u64 = 0xFFFFFC6D
  pub let HDA_SOF_FX_SLOT_BUSY          : u64 = 0xFFFFFC6C
  pub let HDA_SOF_FX_SLOT_EMPTY         : u64 = 0xFFFFFC6B
  pub let HDA_SOF_FX_DEFERRED_HARDWARE  : u64 = 0xFFFFFC6A

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // Pipeline table: eight u64 slots. Slot value:
  //    0      = empty
  //    kind+1 = occupied by (kind)  (encoded so kind 0 is
  //             distinguishable from empty without a second cell).
  // ==========================================================================

  pub let mut _hda_sof_effects_pipeline : [u64; 8] = uninit @align(64)
  pub let mut _hda_sof_effects_stats    : [u64; 8] = uninit @align(64)

  pub let HDA_SOF_FX_ST_ATTACHES  : u64 = 0
  pub let HDA_SOF_FX_ST_DETACHES  : u64 = 1
  pub let HDA_SOF_FX_ST_NOT_READY : u64 = 2
  pub let HDA_SOF_FX_ST_BAD_SLOT  : u64 = 3
  pub let HDA_SOF_FX_ST_BAD_KIND  : u64 = 4
  pub let HDA_SOF_FX_ST_SLOT_BUSY : u64 = 5
  pub let HDA_SOF_FX_ST_SLOT_EMP  : u64 = 6

  // ==========================================================================
  // hda_sof_effects_arbitrated() -> 0
  // ==========================================================================

  pub let hda_sof_effects_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M6-003 (#1164): report whether the SOF effect pipeline issues real IPC today. IT RETURNS 0, because nothing in this tree programs the ADSP mailbox. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_effects_slot_kind(slot) -> 0 | kind+1
  // Read-only accessor. Slot >= 8 returns 0.
  // ==========================================================================

  pub let hda_sof_effects_slot_kind : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-003 (#1164): read the pipeline slot table. slot >= 8 returns 0 (no fabricated occupancy). Leaf. Labels prefixed hsfx_sk_.",
      block: {
        cmp rdi, 8;
        jae hsfx_sk_zero;
        lea r10, [rip + _hda_sof_effects_pipeline];
        mov rax, [r10 + rdi * 8];
        ret;
      hsfx_sk_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_effects_attach(slot, kind) -> OK | NOT_READY | BAD_SLOT
  //                                        | BAD_KIND | SLOT_BUSY
  //
  // ARITY TWO. Fixed slot + fixed kind; no caller-supplied parameter
  // blob (see §0 for why).
  // ==========================================================================

  pub let hda_sof_effects_attach : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64, kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-003 (#1164): attach an effect kind to a pipeline slot. Gates, in order: (1) codec bound (hda_alc287_init_bound != 0) AND loader ready (hda_sof_loader_ready == 1) else NOT_READY (the whole path is OPTIONAL and unavailable when SOF is not present or the codec is unpowered). (2) slot < 8 else BAD_SLOT. (3) kind < 8 else BAD_KIND. (4) slot cell == 0 else SLOT_BUSY (a second attach to the same slot would silently displace the first without any DSP-side detach). On success: stamp pipeline[slot] = kind+1, bump ST_ATTACHES. Two nested calls (init_bound, sof_loader_ready) require a full SysV-aligned frame; five pushes bring rsp%16 == 0. Labels prefixed hsfx_at_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;                        // slot
        mov r13, rsi;                        // kind

        // (1) codec bound?
        call hda_alc287_init_bound;
        cmp rax, 0;
        je hsfx_at_not_ready;

        // (1) loader ready?
        call hda_sof_loader_ready;
        cmp rax, 1;
        jne hsfx_at_not_ready;

        // (2) slot < 8
        cmp r12, 8;
        jae hsfx_at_bad_slot;

        // (3) kind < 8
        cmp r13, 8;
        jae hsfx_at_bad_kind;

        // (4) slot empty?
        lea r10, [rip + _hda_sof_effects_pipeline];
        mov rax, [r10 + r12 * 8];
        cmp rax, 0;
        jne hsfx_at_busy;

        // stamp kind+1.
        mov rax, r13;
        add rax, 1;
        mov [r10 + r12 * 8], rax;

        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;
        jmp hsfx_at_out;

      hsfx_at_not_ready:
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 16];                 // ST_NOT_READY
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC6F;
        jmp hsfx_at_out;
      hsfx_at_bad_slot:
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 24];                 // ST_BAD_SLOT
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC6E;
        jmp hsfx_at_out;
      hsfx_at_bad_kind:
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 32];                 // ST_BAD_KIND
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC6D;
        jmp hsfx_at_out;
      hsfx_at_busy:
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 40];                 // ST_SLOT_BUSY
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC6C;

      hsfx_at_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_effects_detach(slot) -> OK | NOT_READY | BAD_SLOT | SLOT_EMPTY
  //
  // ARITY ONE. Slot-only; the DSP-side identity of the effect at the
  // slot is inferred from the stamp.
  // ==========================================================================

  pub let hda_sof_effects_detach : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-003 (#1164): detach the effect at pipeline slot. Gates: (1) codec bound AND loader ready else NOT_READY. (2) slot < 8 else BAD_SLOT. (3) slot cell != 0 else SLOT_EMPTY (a detach of an already-empty slot would silently succeed and let a caller pretend it cleaned up state it never installed). On success: clear pipeline[slot], bump ST_DETACHES. Two nested calls: five pushes for SysV alignment. Labels prefixed hsfx_dt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;

        call hda_alc287_init_bound;
        cmp rax, 0;
        je hsfx_dt_not_ready;

        call hda_sof_loader_ready;
        cmp rax, 1;
        jne hsfx_dt_not_ready;

        cmp r12, 8;
        jae hsfx_dt_bad_slot;

        lea r10, [rip + _hda_sof_effects_pipeline];
        mov rax, [r10 + r12 * 8];
        cmp rax, 0;
        je hsfx_dt_empty;

        xor rax, rax;
        mov [r10 + r12 * 8], rax;

        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 8];                  // ST_DETACHES
        add rax, 1;
        mov [r10 + 8], rax;

        xor rax, rax;
        jmp hsfx_dt_out;

      hsfx_dt_not_ready:
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC6F;
        jmp hsfx_dt_out;
      hsfx_dt_bad_slot:
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC6E;
        jmp hsfx_dt_out;
      hsfx_dt_empty:
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + 48];                 // ST_SLOT_EMP
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC6B;

      hsfx_dt_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_effects_clear() -> ()
  //
  // Clear the whole pipeline table. Used only by the boot witness's
  // teardown; a live path would use per-slot detach. Leaves counters
  // alone.
  // ==========================================================================

  pub let hda_sof_effects_clear : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-003 (#1164): zero all eight pipeline slots. Cumulative counters preserved. Returns 0. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_sof_effects_pipeline];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_effects_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_sof_effects_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-003 (#1164): bounds-checked read of one SOF-effects counter. Out of range returns 0. Leaf. Labels prefixed hsfx_st_.",
      block: {
        cmp rdi, 8;
        jae hsfx_st_zero;
        lea r10, [rip + _hda_sof_effects_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hsfx_st_zero:
        xor rax, rax;
        ret
      }
    }
}
