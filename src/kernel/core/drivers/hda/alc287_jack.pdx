// src/kernel/core/drivers/hda/alc287_jack.pdx -- R33.M4-004 (#1155)
//
// The Realtek ALC287 UNSOLICITED-RESPONSE handler for jack detection,
// and the JACK EVENT PUBLISH SEAM that feeds the auto-switch and any
// subscriber on the KIND_HID_EVENT-adjacent jack_channel.
// SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE JACK-DETECT INTERRUPT PATH for the ALC287 codec.
//
// HDA CODEC UNSOLICITED RESPONSES (Intel HDA §7.3.6): a widget can be
// configured to emit an UNSOLICITED response frame when its state
// changes -- for a pin complex, this is JACK PRESENCE DETECT. The
// response frame carries a caller-supplied TAG (6 bits) that the
// driver associated with the pin at SET_UNSOLICITED_ENABLE time. When
// the RIRB delivers the frame the driver looks the tag up in its own
// table and dispatches.
//
// On the T14 G4 the ALC287 has ONE unsolicited-tag consumer that
// matters at bind time: the HP jack (pin 0x21). Tag 0x01 = HP jack
// change. A live driver would arm the pin with SET_UNSOLICITED_ENABLE
// (verb 0x708, payload = 0x80 | tag), then on tag 0x01 arrival read
// GET_PIN_SENSE (verb 0xF09) whose reply bit 31 is presence-detect.
// This scaffold DECLARES those seams and PROPAGATES the DEFERRED_
// HARDWARE sentinel from the underlying verb helpers.
//
// The ISR seam takes a caller-supplied {tag, subtag} pair (the shape
// of the RIRB unsolicited-response payload) and:
//
//   (1) refuses tags outside {HP_TAG}   -> UNKNOWN_TAG (counted)
//   (2) updates the internal jack-state cell (INSERTED / REMOVED)
//   (3) calls the AUTO-SWITCH seam in alc287_hp_spk.pdx with the new
//       jack state, so the muting arbitration is a single decision at
//       a single site rather than a shared cell every module reads
//   (4) bumps ST_ISR_CALLS and returns OK
//
// The PUBLISH seam is what the boot witness inspects. It takes a jack
// state, refuses one outside {0, 1}, bumps ST_EVENTS_PUBLISHED, and
// stamps the current state. When R33.M5 wires the jack_channel end-
// point (KIND_HID_EVENT-adjacent -- share the fanout shape but not
// the semantic type; jack presence is a device-state event, not a
// key/pointer event), the publish path will additionally enqueue a
// frame; today, only the counter advances. The pin
// `hda_alc287_jack_arbitrated() == 0` flips the moment a live
// subscriber is bound.
//
// IT IS NOT A LIVE ISR. Nothing in this tree binds an interrupt to
// the codec; the ISR seam is driven from thread context by the boot
// witness, exactly as sci_isr_body is by the GPE fixture (r30_platform
// witness header, §"the service routine").
//
// =============================================================================
// §1  TAGS AND VERBS ARE FIXED, NOT NEGOTIATED
// =============================================================================
//
// Tag assignments:
//
//   HP_JACK_TAG = 0x01   (assigned by alc287_jack_arm on bind)
//
// Verbs used:
//
//   SET_UNSOLICITED_ENABLE = 0x708 (LONG, 8-bit payload)
//     payload = 0x80 | tag (bit 7 = enable, bits [5:0] = tag)
//   GET_PIN_SENSE          = 0xF09 (LONG, 8-bit payload = 0)
//     reply bit 31 = present, bit 30 = impedance-sense (unused here)
//
// This scaffold does NOT read the reply -- verbs.pdx §4 documents that
// no verb response is inspected today. The ISR consumes a caller-
// supplied SUBTAG whose meaning is:
//
//   subtag & 1 == 1 -> plugged
//   subtag & 1 == 0 -> unplugged
//
// This shape matches the ALSA hda_jack.c convention (bit 0 of the tag
// payload byte is presence). A live driver would issue GET_PIN_SENSE
// and read bit 31 of the reply; the shape stays consistent because a
// live implementation replaces the caller-supplied subtag with the
// verb reply and calls the same publish path.
//
// =============================================================================
// §2  ONE READER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_alc287_jack_stats`
// to this object. The state cell is the codec's belief about the jack;
// a second writer would let another module claim plugged while the
// hardware disagrees.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr >= 16                       -> BAD_ADDR (arm)
// arm() before init                      -> NOT_INIT
// isr() before arm                       -> NOT_ARMED
// tag not in {HP_JACK_TAG}               -> UNKNOWN_TAG
// publish() state not in {0, 1}          -> BAD_STATE
// Any verb send not DEFERRED_HARDWARE    -> VERB_FAIL
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL RIRB UNSOLICITED CONSUMPTION. hda/rirb.pdx does not
//     inspect the ring; the ISR is driven from thread context.
//   * NO GET_PIN_SENSE REPLY READ. The subtag is caller-supplied.
//   * NO LIVE JACK_CHANNEL SUBSCRIBER. Publish increments the counter.
//   * NO ARBITRATION.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCF0..0xFFFFFCFF
// =============================================================================

module Alc287Jack = structure {

  // ==========================================================================
  // §1 constants.
  // ==========================================================================

  pub let HDA_ALC287_HP_JACK_TAG        : u64 = 0x01
  pub let HDA_ALC287_HP_JACK_NID        : u64 = 0x21

  pub let HDA_ALC287_VERB_SET_UNSOL     : u64 = 0x708
  pub let HDA_ALC287_UNSOL_ENABLE       : u64 = 0x80  // bit 7 | tag

  // Jack states (mirror the values in alc287_hp_spk.pdx).
  pub let HDA_ALC287_J_UNPLUGGED        : u64 = 0
  pub let HDA_ALC287_J_PLUGGED          : u64 = 1

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_ALC287_J_OK               : u64 = 0
  pub let HDA_ALC287_J_BAD_ADDR         : u64 = 0xFFFFFCFF
  pub let HDA_ALC287_J_NOT_INIT         : u64 = 0xFFFFFCFE
  pub let HDA_ALC287_J_NOT_ARMED        : u64 = 0xFFFFFCFD
  pub let HDA_ALC287_J_UNKNOWN_TAG      : u64 = 0xFFFFFCFC
  pub let HDA_ALC287_J_BAD_STATE        : u64 = 0xFFFFFCFB
  pub let HDA_ALC287_J_VERB_FAIL        : u64 = 0xFFFFFCFA

  // ==========================================================================
  // State.
  //
  // Slots:
  //   [0] ST_ARMS             -- successful arm() calls
  //   [1] ST_ISR_CALLS        -- ISR entries that dispatched
  //   [2] ST_EVENTS_PUBLISHED -- publish() successes
  //   [3] ST_BAD_ADDR
  //   [4] ST_NOT_INIT
  //   [5] ST_NOT_ARMED
  //   [6] ST_UNKNOWN_TAG
  //   [7] ST_BAD_STATE
  //   [8] ST_VERB_FAIL
  //   [9] ST_ARMED           -- latch (codec+1 or 0)
  //  [10] ST_JACK_STATE      -- current cached jack state (0/1); 0xFF if
  //                              never observed
  // ==========================================================================

  pub let mut _hda_alc287_jack_stats : [u64; 16] = uninit @align(64)

  pub let HDA_ALC287_J_ST_ARMS         : u64 = 0
  pub let HDA_ALC287_J_ST_ISR_CALLS    : u64 = 1
  pub let HDA_ALC287_J_ST_PUBLISHED    : u64 = 2
  pub let HDA_ALC287_J_ST_BAD_ADDR     : u64 = 3
  pub let HDA_ALC287_J_ST_NOT_INIT     : u64 = 4
  pub let HDA_ALC287_J_ST_NOT_ARMED    : u64 = 5
  pub let HDA_ALC287_J_ST_UNKNOWN_TAG  : u64 = 6
  pub let HDA_ALC287_J_ST_BAD_STATE    : u64 = 7
  pub let HDA_ALC287_J_ST_VERB_FAIL    : u64 = 8
  pub let HDA_ALC287_J_ST_ARMED        : u64 = 9
  pub let HDA_ALC287_J_ST_JACK_STATE   : u64 = 10

  // ==========================================================================
  // hda_alc287_jack_arbitrated() -> 0
  // ==========================================================================

  pub let hda_alc287_jack_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M4-004 (#1155): report whether the jack path issues real MMIO OR routes a real subscriber event today. IT RETURNS 0 -- verbs are scaffold sends, and no jack_channel subscriber is bound. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_jack_armed() -> 0 | codec+1
  // ==========================================================================

  pub let hda_alc287_jack_armed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-004 (#1155): read the arm latch. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 72];             // slot 9
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_jack_arm(codec_addr) -> code
  //
  // ARITY ONE. Configures pin 0x21 (HP jack) for unsolicited responses
  // with tag HP_JACK_TAG (0x01).
  // ==========================================================================

  pub let hda_alc287_jack_arm : (u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-004 (#1155): arm the HP jack for unsolicited responses. Gates: (1) codec_addr < 16 else BAD_ADDR. (2) init bound for this codec else NOT_INIT (unsolicited on an un-powered codec is undefined). Dispatch SET_UNSOLICITED_ENABLE (verb 0x708) to HP_JACK_NID (0x21) with payload 0x80 | 0x01 = 0x81 (enable bit + tag). On success, bump ST_ARMS and stamp latch codec+1. Six pushes leave rsp%16 == 0. Labels prefixed hjk_ar_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr

        // (1) codec_addr < 16
        cmp r12, 16;
        jae hjk_ar_bad_addr;

        // (2) init bound?
        call hda_alc287_init_bound;
        mov r13, r12;
        add r13, 1;
        cmp rax, r13;
        jne hjk_ar_not_init;

        // Dispatch SET_UNSOLICITED_ENABLE via send_long.
        mov rdi, r12;                    // codec_addr
        mov rsi, 0x21;                   // HP_JACK_NID
        mov rdx, 0x708;                  // verb id
        mov rcx, 0x81;                   // 0x80 | tag(0x01)
        call hda_verb_send_long;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hjk_ar_verb_fail;

        // Success.
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        mov rax, r12;
        add rax, 1;
        mov [r10 + 72], rax;             // latch codec+1

        xor rax, rax;
        jmp hjk_ar_out;

      hjk_ar_bad_addr:
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFCFF;
        jmp hjk_ar_out;
      hjk_ar_not_init:
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFCFE;
        jmp hjk_ar_out;
      hjk_ar_verb_fail:
        lea r10, [rip + _hda_alc287_jack_stats];
        mov r11, [r10 + 64];
        add r11, 1;
        mov [r10 + 64], r11;
        mov rax, 0xFFFFFCFA;

      hjk_ar_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_jack_publish(state) -> code
  //
  // ARITY ONE. The event fanout seam. Refuses states outside {0, 1},
  // bumps ST_EVENTS_PUBLISHED and stamps ST_JACK_STATE. When
  // R33.M5 (or later) wires jack_channel this seam will additionally
  // enqueue a frame; today only the counter advances.
  // ==========================================================================

  pub let hda_alc287_jack_publish : (u64) -> u64 !{mem} @{} =
    fn (state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-004 (#1155): publish a jack state to the (currently unwired) jack_channel. Gate: state in {0, 1} else BAD_STATE (refused, not truncated -- a garbage state means the ISR's decode is broken and the subscriber must not silently observe garbage). Bump ST_EVENTS_PUBLISHED and stamp ST_JACK_STATE. NO SUBSCRIBER FANOUT YET (§4). Leaf. Labels prefixed hjk_pu_.",
      block: {
        cmp rdi, 1;
        ja  hjk_pu_bad_state;

        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov [r10 + 80], rdi;             // ST_JACK_STATE

        xor rax, rax;
        ret;

      hjk_pu_bad_state:
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;
        mov rax, 0xFFFFFCFB;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_jack_isr(tag, subtag) -> code
  //
  // ARITY TWO. The unsolicited-response entry point. Not a real
  // interrupt today -- driven from thread context by the boot witness
  // and, later, by the RIRB unsolicited path.
  //
  // Behaviour:
  //   (1) armed latch non-zero else NOT_ARMED
  //   (2) tag == HP_JACK_TAG else UNKNOWN_TAG
  //   (3) decode subtag: (subtag & 1) -> plugged, else unplugged
  //   (4) call hda_alc287_jack_publish(state) -- fanout
  //   (5) call hda_alc287_hp_spk_auto_switch(state) -- act on it
  //   (6) bump ST_ISR_CALLS
  //   (7) return OK
  // ==========================================================================

  pub let hda_alc287_jack_isr : (u64, u64) -> u64 !{mem} @{} =
    fn (tag: u64, subtag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-004 (#1155): the unsolicited-response entry point. Not a real interrupt today (§0); driven from thread context. Gates: (1) armed latch non-zero else NOT_ARMED (an ISR entry before arm names no pin). (2) tag == HP_JACK_TAG (0x01) else UNKNOWN_TAG (refused, not silently mapped -- a foreign tag arriving means the RIRB decoder is broken and the driver must not synthesize a jack event from garbage). (3) Decode: state = subtag & 1 (bit 0 = presence, per §1). (4) Publish the state -- fanout to the jack_channel via hda_alc287_jack_publish; propagate its return on failure so a broken publish is not silently swallowed. (5) Act on it -- hda_alc287_hp_spk_auto_switch(state), so the muting decision runs at the single site alc287_hp_spk.pdx owns; propagate its return on failure. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed hjk_is_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // tag
        mov r13, rsi;                    // subtag

        // (1) armed?
        call hda_alc287_jack_armed;
        cmp rax, 0;
        je  hjk_is_not_armed;

        // (2) tag known?
        cmp r12, 0x01;                   // HP_JACK_TAG
        jne hjk_is_unknown_tag;

        // (3) decode state = subtag & 1
        mov r14, r13;
        and r14, 1;

        // (4) publish(state)
        mov rdi, r14;
        call hda_alc287_jack_publish;
        cmp rax, 0;
        jne hjk_is_out;                  // propagate publish failure

        // (5) auto_switch(state)
        mov rdi, r14;
        call hda_alc287_hp_spk_auto_switch;
        cmp rax, 0;
        jne hjk_is_out;                  // propagate switch failure

        // (6) bump ST_ISR_CALLS
        lea r10, [rip + _hda_alc287_jack_stats];
        mov r11, [r10 + 8];
        add r11, 1;
        mov [r10 + 8], r11;

        xor rax, rax;                    // OK
        jmp hjk_is_out;

      hjk_is_not_armed:
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFCFD;
        jmp hjk_is_out;
      hjk_is_unknown_tag:
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFCFC;

      hjk_is_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_jack_reset() -> ()
  //
  // Boot-witness teardown: clear the armed latch and the state cell.
  // Cumulative counters preserved.
  // ==========================================================================

  pub let hda_alc287_jack_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-004 (#1155): clear armed latch and cached jack state. Cumulative counters preserved. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_jack_stats];
        xor rax, rax;
        mov [r10 + 72], rax;             // armed latch
        mov [r10 + 80], rax;             // ST_JACK_STATE
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_jack_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_alc287_jack_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-004 (#1155): bounds-checked read of one jack counter. Out of range returns 0. Leaf. Labels prefixed hjk_st_.",
      block: {
        cmp rdi, 16;
        jae hjk_st_zero;
        lea r10, [rip + _hda_alc287_jack_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hjk_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

}
