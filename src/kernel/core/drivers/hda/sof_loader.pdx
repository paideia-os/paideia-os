// src/kernel/core/drivers/hda/sof_loader.pdx -- R33.M6-001 (#1162)
//
// The Sound Open Firmware (SOF) DSP FIRMWARE LOADER scaffold.
// SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE DSP FIRMWARE HANDSHAKE SEAM for the audio DSP (Intel cAVS
// 2.5 / SOF). A live firmware handoff is a four-stage exchange over
// the ADSP IPC + boot-status window:
//
//   (STAGE 0)  ROM entry.  The DSP powers up in an internal ROM stub
//              that scans a small mailbox for a base-firmware image
//              stream. The host writes the base firmware into the
//              DSP's IMR (Isolated Memory Region), then rings a
//              doorbell.
//   (STAGE 1)  BASE_FW_ENTERED.  ROM has jumped into the base firmware
//              and now expects the manifest of loadable modules to
//              stream in through the same mailbox.
//   (STAGE 2)  FW_ENTERED.  Base firmware has finished ingesting the
//              module manifest and is running its scheduler.
//   (STAGE 3)  READY.  DSP raises the READY doorbell; the loader may
//              hand off to the topology programmer (sof_topology.pdx).
//
// This module DECLARES the stage constants, the region-pointer +
// length latch, the four-step advance seam, and the READY latch. It
// PERFORMS NO REAL MMIO -- the underlying HDA controller path
// (controller.pdx, corb.pdx, rirb.pdx) is itself a scaffold, and the
// DSP ADSP register window has not been mapped at this milestone.
//
// The signature-verification path is a DIFFERENT module
// (sof_verify.pdx, #1165). The loader HAS a `fw_verified` slot it
// refuses to advance without, but nothing here computes the verdict.
// Split so a verify failure is a separate error code from a handshake
// failure and a caller can distinguish "vendor cert bad" from "DSP
// stuck in ROM".
//
// IT IS NOT A LIVE HANDSHAKE. Same discipline as the M1..M4
// scaffolds: the pin `hda_sof_loader_arbitrated() == 0` -- an
// assertion that FAILS the moment a future milestone plumbs real
// ADSP MMIO -- forces the design doc to be updated at that time.
//
// ARITY IS TWO ON BIND (fw_ptr, fw_len). A caller-supplied STAGE
// would let a helper skip verify by claiming BASE_FW_ENTERED without
// ever having crossed STAGE 0's gate -- exactly the confusion the
// stage machine exists to prevent. The stage advances only through
// hda_sof_loader_advance().
//
// =============================================================================
// §1  STAGE MACHINE
// =============================================================================
//
// Stage cell _hda_sof_loader_stage advances only in one direction
// (0 -> 1 -> 2 -> 3). Any attempt to advance more than one step, or
// to advance without the verify latch set, returns NOT_VERIFIED /
// BAD_STAGE.
//
// =============================================================================
// §2  ONE WRITER OF THE LATCH + STAGE
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_sof_loader_bound`,
// `_hda_sof_loader_fw_ptr`, `_hda_sof_loader_fw_len`,
// `_hda_sof_loader_stage`, `_hda_sof_loader_verified` and
// `_hda_sof_loader_stats` to this object. A second writer would let a
// stray helper claim the DSP is READY without a real handshake.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// fw_ptr == 0                             -> BAD_FW_PTR
// fw_len == 0 or fw_len > 4 MiB           -> BAD_FW_LEN
//   (4 MiB is the documented max IMR region on cAVS 2.5; upload
//   beyond that would overrun DSP-side memory.)
// second bind                             -> REBIND (LATCH)
// advance before verify                   -> NOT_VERIFIED
// advance past STAGE 3                    -> BAD_STAGE
// advance on unbound loader               -> NOT_BOUND
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL IMR UPLOAD. The fw region is not memcpy'd anywhere.
//   * NO REAL DOORBELL. The advance step does not touch ADSP IPC.
//   * NO REAL BOOT-STATUS POLL. The stage machine advances on
//     software call; a live loader would poll HIPCT/HIPCIE for the
//     BASE_FW_ENTERED / FW_ENTERED / READY tokens with a timeout.
//   * NO ARBITRATION. `hda_sof_loader_arbitrated() == 0` is pinned
//     by the boot witness.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC80..0xFFFFFC8F
// =============================================================================

module SofLoader = structure {

  // ==========================================================================
  // §1 stage constants.
  // ==========================================================================

  pub let HDA_SOF_STAGE_ROM              : u64 = 0
  pub let HDA_SOF_STAGE_BASE_FW_ENTERED  : u64 = 1
  pub let HDA_SOF_STAGE_FW_ENTERED       : u64 = 2
  pub let HDA_SOF_STAGE_READY            : u64 = 3

  // §3 upper bound: 4 MiB IMR (cAVS 2.5).
  pub let HDA_SOF_FW_MAX_LEN : u64 = 0x00400000

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_SOF_LOADER_OK           : u64 = 0
  pub let HDA_SOF_LOADER_BAD_FW_PTR   : u64 = 0xFFFFFC8F
  pub let HDA_SOF_LOADER_BAD_FW_LEN   : u64 = 0xFFFFFC8E
  pub let HDA_SOF_LOADER_REBIND       : u64 = 0xFFFFFC8D
  pub let HDA_SOF_LOADER_NOT_BOUND    : u64 = 0xFFFFFC8C
  pub let HDA_SOF_LOADER_NOT_VERIFIED : u64 = 0xFFFFFC8B
  pub let HDA_SOF_LOADER_BAD_STAGE    : u64 = 0xFFFFFC8A

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_sof_loader_bound    : u64 = 0
  pub let mut _hda_sof_loader_fw_ptr   : u64 = 0
  pub let mut _hda_sof_loader_fw_len   : u64 = 0
  pub let mut _hda_sof_loader_stage    : u64 = 0
  pub let mut _hda_sof_loader_verified : u64 = 0
  pub let mut _hda_sof_loader_stats    : [u64; 8] = uninit @align(64)

  // Stat slot indices (byte offsets = index * 8).
  pub let HDA_SOF_LOADER_ST_BINDS       : u64 = 0
  pub let HDA_SOF_LOADER_ST_ADVANCES    : u64 = 1
  pub let HDA_SOF_LOADER_ST_BAD_FW_PTR  : u64 = 2
  pub let HDA_SOF_LOADER_ST_BAD_FW_LEN  : u64 = 3
  pub let HDA_SOF_LOADER_ST_REBIND      : u64 = 4
  pub let HDA_SOF_LOADER_ST_NOT_BOUND   : u64 = 5
  pub let HDA_SOF_LOADER_ST_NOT_VERIFY  : u64 = 6
  pub let HDA_SOF_LOADER_ST_BAD_STAGE   : u64 = 7

  // ==========================================================================
  // hda_sof_loader_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same shape as every other HDA scaffold pin.
  // ==========================================================================

  pub let hda_sof_loader_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M6-001 (#1162): report whether the SOF firmware handshake issues real MMIO / doorbell today. IT RETURNS 0, because nothing in this tree maps the ADSP register window, memcpy's into IMR, or polls HIPCT. The boot witness pins it at 0 for the same reason ec_access_arbitrated is pinned. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_bound() -> 1 | 0
  // ==========================================================================

  pub let hda_sof_loader_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): 1 once hda_sof_loader_bind has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_sof_loader_bound];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_stage() -> stage
  // ==========================================================================

  pub let hda_sof_loader_stage : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): return the current handshake stage (0..3). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_sof_loader_stage];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_ready() -> 1 | 0
  // ==========================================================================

  pub let hda_sof_loader_ready : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): 1 once the stage machine has reached HDA_SOF_STAGE_READY (3). Leaf. Labels prefixed hsl_rdy_.",
      block: {
        lea r10, [rip + _hda_sof_loader_stage];
        mov rax, [r10];
        cmp rax, 3;
        jne hsl_rdy_no;
        mov rax, 1;
        ret;
      hsl_rdy_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_bind(fw_ptr, fw_len) -> OK | REBIND | BAD_FW_PTR | BAD_FW_LEN
  //
  // ARITY TWO: the firmware region pointer and length. A caller-supplied
  // STAGE would let a helper skip verify by claiming BASE_FW_ENTERED
  // without ever having crossed STAGE 0's gate. The bind is a LATCH;
  // once bound it cannot be re-bound (a second bind returns REBIND).
  // ==========================================================================

  pub let hda_sof_loader_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (fw_ptr: u64, fw_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): bind the SOF loader to a firmware region (ptr, len). Gates, in order: (1) fw_ptr != 0 else BAD_FW_PTR (a null region cannot be uploaded, and passing null would silently claim a bound loader over garbage). (2) fw_len in (0..HDA_SOF_FW_MAX_LEN] else BAD_FW_LEN (zero would let a caller bind a loader that never uploaded anything; > 4 MiB would overrun the DSP IMR window on cAVS 2.5). (3) not already bound else REBIND (the whole discipline rests on the bind being a LATCH: a stray relocation would be a second path claiming this frame owns a different fw region). On success: stamp fw_ptr, fw_len, set bound=1, stage=0, verified=0, bump ST_BINDS. Leaf. Labels prefixed hsl_bd_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je hsl_bd_bad_fw_ptr;

        cmp rsi, 0;
        je hsl_bd_bad_fw_len;
        mov r10, 0x00400000;                 // HDA_SOF_FW_MAX_LEN
        cmp rsi, r10;
        ja hsl_bd_bad_fw_len;

        lea r10, [rip + _hda_sof_loader_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne hsl_bd_rebind;

        lea r10, [rip + _hda_sof_loader_fw_ptr];
        mov [r10], rdi;
        lea r10, [rip + _hda_sof_loader_fw_len];
        mov [r10], rsi;

        lea r10, [rip + _hda_sof_loader_stage];
        xor rax, rax;
        mov [r10], rax;
        lea r10, [rip + _hda_sof_loader_verified];
        mov [r10], rax;

        lea r10, [rip + _hda_sof_loader_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                        // OK
        ret;

      hsl_bd_bad_fw_ptr:
        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 16];                 // ST_BAD_FW_PTR
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC8F;
        ret;

      hsl_bd_bad_fw_len:
        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 24];                 // ST_BAD_FW_LEN
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC8E;
        ret;

      hsl_bd_rebind:
        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 32];                 // ST_REBIND
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC8D;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_mark_verified() -> ()
  //
  // Called by sof_verify (#1165) after the DUAL-SIG check has passed.
  // Split so a caller cannot advance the stage without the dual-sig
  // path having produced a real verdict.
  // ==========================================================================

  pub let hda_sof_loader_mark_verified : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): set the verified latch. Consumed by hda_sof_loader_advance. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_sof_loader_verified];
        mov rax, 1;
        mov [r10], rax;
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_advance() -> OK | NOT_BOUND | NOT_VERIFIED | BAD_STAGE
  //
  // Advance the stage machine by ONE step. Refuses when unbound, when
  // not verified, and when already at HDA_SOF_STAGE_READY. The stage
  // machine is one-way by construction: reset only via reset().
  // ==========================================================================

  pub let hda_sof_loader_advance : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): advance the handshake stage by one. Gates, in order: (1) bound else NOT_BOUND. (2) verified else NOT_VERIFIED (the whole point of the split with sof_verify is that a caller cannot advance without a signed dual-sig verdict). (3) stage < 3 else BAD_STAGE (refused, not saturated; a live loader that thinks it is 'about to be READY again' has invented a stage the DSP does not have). Bump ST_ADVANCES, return OK. Leaf. Labels prefixed hsl_ad_.",
      block: {
        lea r10, [rip + _hda_sof_loader_bound];
        mov rax, [r10];
        cmp rax, 0;
        je hsl_ad_not_bound;

        lea r10, [rip + _hda_sof_loader_verified];
        mov rax, [r10];
        cmp rax, 0;
        je hsl_ad_not_verify;

        lea r10, [rip + _hda_sof_loader_stage];
        mov rax, [r10];
        cmp rax, 3;
        jae hsl_ad_bad_stage;

        add rax, 1;
        mov [r10], rax;

        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 8];                  // ST_ADVANCES
        add rax, 1;
        mov [r10 + 8], rax;

        xor rax, rax;
        ret;

      hsl_ad_not_bound:
        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 40];                 // ST_NOT_BOUND
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC8C;
        ret;

      hsl_ad_not_verify:
        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 48];                 // ST_NOT_VERIFY
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC8B;
        ret;

      hsl_ad_bad_stage:
        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + 56];                 // ST_BAD_STAGE
        add rax, 1;
        mov [r10 + 56], rax;
        mov rax, 0xFFFFFC8A;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_reset() -> ()
  //
  // Clear the whole latch (bound, fw_ptr, fw_len, stage, verified).
  // Used only by the boot witness's teardown; a live loader would use
  // a DSP-power-off path. Leaves the counters alone (they are
  // cumulative evidence).
  // ==========================================================================

  pub let hda_sof_loader_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): clear the SOF loader latches. Cumulative counters preserved. Returns 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        lea r10, [rip + _hda_sof_loader_bound];
        mov [r10], rax;
        lea r10, [rip + _hda_sof_loader_fw_ptr];
        mov [r10], rax;
        lea r10, [rip + _hda_sof_loader_fw_len];
        mov [r10], rax;
        lea r10, [rip + _hda_sof_loader_stage];
        mov [r10], rax;
        lea r10, [rip + _hda_sof_loader_verified];
        mov [r10], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_sof_loader_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_sof_loader_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-001 (#1162): bounds-checked read of one SOF-loader counter. Out of range returns 0. Leaf. Labels prefixed hsl_st_.",
      block: {
        cmp rdi, 8;
        jae hsl_st_zero;
        lea r10, [rip + _hda_sof_loader_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hsl_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame
}
