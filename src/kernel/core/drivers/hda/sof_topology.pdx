// src/kernel/core/drivers/hda/sof_topology.pdx -- R33.M6-002 (#1163)
//
// The Sound Open Firmware (SOF) TOPOLOGY BINARY PARSER scaffold.
// SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE PARSER FOR THE SOF TOPOLOGY BINARY -- the compiled form
// of an M4-preprocessed topology description. Upstream SOF ships
// each machine's topology as a `.tplg` file: an M4 macro expansion
// over a family of {type_id, size, value} TUPLES, packed into a
// fixed binary layout with a lead-in header. This module DECODES
// the binary form and exposes a typed sequence of tuples to the
// pipeline builder (sof_effects.pdx, #1164) without ever building
// an intermediate graph on the heap.
//
// The binary layout this parser accepts:
//
//   HEADER (16 bytes):
//     +0  u32  magic     - 0x50465353 ("SFP" prefix; ascii backwards).
//                          Rejected if wrong -- a topology file whose
//                          first four bytes are not the magic is not
//                          a SOF topology.
//     +4  u32  size      - total payload bytes (must equal buf_len - 16).
//     +8  u32  abi       - upstream ABI major.minor.patch packed as
//                          (major << 24) | (minor << 12) | patch. This
//                          module accepts only ABI 3.x (major == 3).
//     +12 u32  count     - number of tuples in the payload.
//
//   TUPLE (12 + value_size bytes, 4-byte aligned):
//     +0  u32  type_id   - tuple kind. Enumerated in §1.
//     +4  u32  offset    - byte offset from start of PAYLOAD (not from
//                          the buffer) where this tuple's value sits.
//                          Bounds-checked against `size`.
//     +8  u32  size      - length of `value` in bytes. Bounds-checked
//                          against `size - offset`.
//     +12       value    - opaque bytes; not interpreted by the parser.
//
// This module DECLARES the header + tuple accessors, the well-formed-
// ness gates, and a fixed-arity per-call decoder. It PERFORMS NO
// HEAP ALLOCATION; every access is against the caller's buffer. The
// pipeline builder (sof_effects.pdx) drives the walk with an index
// and consumes value bytes it interprets by type_id.
//
// IT IS NOT A LIVE TOPOLOGY LOADER. Same discipline as the other
// M6 scaffolds: no firmware upload runs (that is sof_loader.pdx),
// no dispatch to the DSP runs (that is sof_effects.pdx). This is
// pure decode over caller-supplied bytes.
//
// ARITY IS THREE ON parse (buf_ptr, buf_len, out_hdr). A caller-
// supplied `count` would let a stray helper claim more tuples than
// the header names, which is exactly the confusion the header exists
// to prevent -- the count is stated ONCE, in the header, and every
// caller reads it there.
//
// =============================================================================
// §1  TUPLE TYPE IDS
// =============================================================================
//
// The upstream SOF tplg format enumerates dozens of tuple types; the
// R33 subset consumed by sof_effects covers PCM, WIDGET, GRAPH and
// PIPELINE tuples. Enumerated here for cross-file visibility.
//
//   0x0001  PCM              - PCM capabilities per DAI.
//   0x0002  WIDGET           - one topology widget (pga, mux, etc.).
//   0x0003  GRAPH            - source/sink edge between two widgets.
//   0x0004  PIPELINE         - pipeline scheduling parameters.
//   0x0005  MANIFEST         - vendor manifest passthrough (opaque).
//
// A type_id outside this enum is REFUSED by pipe callers on decode;
// the parser itself does NOT gate on type_id (an unknown tuple is
// still a well-formed frame the SOF ABI reserves for forward-compat).
//
// =============================================================================
// §2  ONE WRITER OF THE PARSER STATS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_sof_topology_stats`
// to this object. The counters are the only evidence a parse ran and
// what it observed; a second writer would let another module claim a
// tuple was parsed that never was.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
//   buf_ptr == 0                          -> BAD_BUF_PTR
//   buf_len < 16                          -> BAD_BUF_LEN (header short)
//   magic != 0x50465353                   -> BAD_MAGIC
//   size + 16 != buf_len                  -> BAD_SIZE
//   abi major != 3                        -> BAD_ABI
//   Per-tuple decode:
//     offset >= size                      -> BAD_TUPLE_OFFSET
//     offset + tuple_size > size          -> BAD_TUPLE_LENGTH
//     tuple index >= count                -> BAD_TUPLE_INDEX
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO VALUE INTERPRETATION. The parser exposes raw `value` bytes;
//     interpretation is the effect pipeline's job (sof_effects.pdx).
//   * NO HEAP GRAPH. Callers drive a linear tuple walk against the
//     original buffer; no intermediate node table is materialised.
//   * NO ARBITRATION (parser is pure decode; no MMIO).
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC70..0xFFFFFC7F
// =============================================================================

module SofTopology = structure {

  // ==========================================================================
  // §0/§1 constants.
  // ==========================================================================

  pub let HDA_SOF_TPLG_MAGIC       : u64 = 0x50465353     // "SFP\0" LE
  pub let HDA_SOF_TPLG_HDR_BYTES   : u64 = 16
  pub let HDA_SOF_TPLG_TUP_MIN     : u64 = 12             // 12 bytes header
  pub let HDA_SOF_TPLG_ABI_MAJOR   : u64 = 3

  pub let HDA_SOF_TPLG_T_PCM       : u64 = 0x0001
  pub let HDA_SOF_TPLG_T_WIDGET    : u64 = 0x0002
  pub let HDA_SOF_TPLG_T_GRAPH     : u64 = 0x0003
  pub let HDA_SOF_TPLG_T_PIPELINE  : u64 = 0x0004
  pub let HDA_SOF_TPLG_T_MANIFEST  : u64 = 0x0005

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_SOF_TPLG_OK               : u64 = 0
  pub let HDA_SOF_TPLG_BAD_BUF_PTR      : u64 = 0xFFFFFC7F
  pub let HDA_SOF_TPLG_BAD_BUF_LEN      : u64 = 0xFFFFFC7E
  pub let HDA_SOF_TPLG_BAD_MAGIC        : u64 = 0xFFFFFC7D
  pub let HDA_SOF_TPLG_BAD_SIZE         : u64 = 0xFFFFFC7C
  pub let HDA_SOF_TPLG_BAD_ABI          : u64 = 0xFFFFFC7B
  pub let HDA_SOF_TPLG_BAD_TUP_INDEX    : u64 = 0xFFFFFC7A
  pub let HDA_SOF_TPLG_BAD_TUP_OFFSET   : u64 = 0xFFFFFC79
  pub let HDA_SOF_TPLG_BAD_TUP_LENGTH   : u64 = 0xFFFFFC78

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_sof_topology_stats : [u64; 8] = uninit @align(64)

  pub let HDA_SOF_TPLG_ST_PARSES        : u64 = 0
  pub let HDA_SOF_TPLG_ST_TUP_READS     : u64 = 1
  pub let HDA_SOF_TPLG_ST_BAD_BUF       : u64 = 2
  pub let HDA_SOF_TPLG_ST_BAD_MAGIC     : u64 = 3
  pub let HDA_SOF_TPLG_ST_BAD_SIZE      : u64 = 4
  pub let HDA_SOF_TPLG_ST_BAD_ABI       : u64 = 5
  pub let HDA_SOF_TPLG_ST_BAD_TUP_IDX   : u64 = 6
  pub let HDA_SOF_TPLG_ST_BAD_TUP_BOUND : u64 = 7

  // ==========================================================================
  // hda_sof_topology_parse_header(buf_ptr, buf_len) -> OK | error
  //
  // ARITY TWO. Reads the 16-byte header and validates the magic, size
  // and ABI. Returns OK if the buffer is a well-formed SOF tplg with
  // a plausible header. The tuple count is exposed via
  // hda_sof_topology_count() on success (or 0 on error).
  // ==========================================================================

  pub let hda_sof_topology_parse_header : (u64, u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64, buf_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-002 (#1163): validate the 16-byte SOF tplg header. Gates, in order: (1) buf_ptr != 0 else BAD_BUF_PTR (a null buffer cannot be decoded; refused before any deref). (2) buf_len >= 16 else BAD_BUF_LEN (header would run off the end). (3) magic == 0x50465353 else BAD_MAGIC. (4) size + 16 == buf_len else BAD_SIZE (header claim must match the caller's length; a shorter/longer size would let a stray tuple lie about its offset). (5) abi major == 3 else BAD_ABI (the R33 subset accepts one ABI major line; forward-compat lives in tuple type_id space, not ABI major). On success: stash count in _hda_sof_topology_stats slot 0 (via bump), return OK. Reads are byte-wise little-endian to avoid an unaligned qword load on caller-supplied bytes. Leaf. Labels prefixed hst_ph_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je hst_ph_bad_buf_ptr;
        cmp rsi, 16;
        jb hst_ph_bad_buf_len;

        // magic (u32 LE) at +0
        xor rax, rax;
        mov eax, [rdi + 0];
        mov r10d, 0x50465353;
        cmp eax, r10d;
        jne hst_ph_bad_magic;

        // size (u32 LE) at +4
        xor rax, rax;
        mov eax, [rdi + 4];
        add rax, 16;
        cmp rax, rsi;
        jne hst_ph_bad_size;

        // abi (u32 LE) at +8; upper byte is major
        xor rax, rax;
        mov eax, [rdi + 8];
        shr rax, 24;
        cmp rax, 3;
        jne hst_ph_bad_abi;

        // OK: bump ST_PARSES.
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        xor rax, rax;
        ret;

      hst_ph_bad_buf_ptr:
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 16];                 // ST_BAD_BUF
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC7F;
        ret;

      hst_ph_bad_buf_len:
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC7E;
        ret;

      hst_ph_bad_magic:
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 24];                 // ST_BAD_MAGIC
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC7D;
        ret;

      hst_ph_bad_size:
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 32];                 // ST_BAD_SIZE
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC7C;
        ret;

      hst_ph_bad_abi:
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 40];                 // ST_BAD_ABI
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC7B;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_topology_count(buf_ptr) -> count
  //
  // Read the header's tuple count. Assumes parse_header has already
  // succeeded on the buffer; a caller that reads count from an
  // unvalidated buffer is asking for garbage.
  // ==========================================================================

  pub let hda_sof_topology_count : (u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-002 (#1163): read the u32 tuple count at header offset +12. Null buf_ptr returns 0 without deref. Leaf. Labels prefixed hst_cn_.",
      block: {
        cmp rdi, 0;
        je hst_cn_zero;
        xor rax, rax;
        mov eax, [rdi + 12];
        ret;
      hst_cn_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_topology_tuple_type(buf_ptr, buf_len, tup_index) -> type | error
  // hda_sof_topology_tuple_size(buf_ptr, buf_len, tup_index) -> size | error
  //
  // Per-tuple decoders. Both gate index vs the header count and offset
  // vs the payload extent. type reads the u32 at tuple+0; size reads
  // the u32 at tuple+8. Value bytes are addressed by the caller via
  // hda_sof_topology_value_ptr.
  // ==========================================================================

  pub let hda_sof_topology_tuple_type : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64, buf_len: u64, tup_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-002 (#1163): read tuple[tup_index].type_id at (payload_ptr + tuple_start + 0). Gates: (1) buf_ptr != 0 else BAD_BUF_PTR. (2) buf_len >= 16 + count*12 else BAD_TUP_INDEX propagated (a caller that walks past the header's stated count has invented tuples the header does not have). (3) tup_index < count else BAD_TUP_INDEX. Tuple stride is FIXED at 12 bytes at this milestone (opaque `value` bytes are addressed by hda_sof_topology_value_ptr / _len rather than co-located with the tuple frame in the buffer). Leaf. Labels prefixed hst_tt_.",
      block: {
        cmp rdi, 0;
        je hst_tt_bad_index;
        cmp rsi, 16;
        jb hst_tt_bad_index;

        // count at +12.
        xor rax, rax;
        mov eax, [rdi + 12];
        cmp rdx, rax;
        jae hst_tt_bad_index;

        // tuple start = 16 + tup_index * 12.
        mov rax, rdx;
        shl rax, 3;                          // *8
        mov r11, rdx;
        shl r11, 2;                          // *4
        add rax, r11;                        // *12
        add rax, 16;

        // Bounds re-check: rax + 12 <= buf_len.
        mov r11, rax;
        add r11, 12;
        cmp r11, rsi;
        ja hst_tt_bad_index;

        // Read u32 at buf_ptr + rax.
        mov r10, rdi;
        add r10, rax;

        lea r11, [rip + _hda_sof_topology_stats];
        mov rcx, [r11 + 8];
        add rcx, 1;
        mov [r11 + 8], rcx;

        xor rax, rax;
        mov eax, [r10 + 0];
        ret;

      hst_tt_bad_index:
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 48];                 // ST_BAD_TUP_IDX
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC7A;
        ret
      }
    }

  pub let hda_sof_topology_tuple_size : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64, buf_len: u64, tup_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-002 (#1163): read tuple[tup_index].size at (payload_ptr + tuple_start + 8). Same index+offset gates as tuple_type. Leaf. Labels prefixed hst_ts_.",
      block: {
        cmp rdi, 0;
        je hst_ts_bad_index;
        cmp rsi, 16;
        jb hst_ts_bad_index;

        xor rax, rax;
        mov eax, [rdi + 12];
        cmp rdx, rax;
        jae hst_ts_bad_index;

        mov rax, rdx;
        shl rax, 3;
        mov r11, rdx;
        shl r11, 2;
        add rax, r11;
        add rax, 16;

        mov r11, rax;
        add r11, 12;
        cmp r11, rsi;
        ja hst_ts_bad_index;

        mov r10, rdi;
        add r10, rax;

        xor rax, rax;
        mov eax, [r10 + 8];
        ret;

      hst_ts_bad_index:
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC7A;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_topology_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_sof_topology_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-002 (#1163): bounds-checked read of one SOF-topology counter. Out of range returns 0. Leaf. Labels prefixed hst_st_.",
      block: {
        cmp rdi, 8;
        jae hst_st_zero;
        lea r10, [rip + _hda_sof_topology_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hst_st_zero:
        xor rax, rax;
        ret
      }
    }
}
