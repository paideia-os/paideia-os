// src/kernel/core/drivers/hda/rirb.pdx — R33.M1-004 (#1140)
//
// The kernel-side Intel HDA RIRB (Response Input Ring Buffer)
// scaffold. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE RIRB CONSUMER FRAME for an Intel HDA controller. Per
// Intel HDA §4.4.2 the RIRB is a DMA-driven ring in host memory the
// CONTROLLER fills with 64-bit response entries (32-bit response +
// 32-bit response extended containing codec/unsolicited bits) as
// codecs answer verbs the software posted to the CORB. The consumer
// contract is:
//
//   (1) SW allocates a physically-contiguous, 128-byte-aligned ring
//       of 2 / 16 / 256 entries (each 8 bytes wide, so 16 / 128 /
//       2048 bytes total).
//   (2) SW writes the ring base into RIRBLBASE (BAR0+0x50) +
//       RIRBUBASE (BAR0+0x54).
//   (3) SW selects ring size via RIRBSIZE (BAR0+0x5E bits [1:0]).
//   (4) SW asserts RIRBWPRST (RIRBWP bit 15) then clears it.
//   (5) SW writes RIRBCTL.RUN (BAR0+0x5C bit 1) = 1, and enables
//       the response interrupt with RIRBCTL.RINTCTL (bit 0) + the
//       response-count threshold in RINTCNT (BAR0+0x5A).
//   (6) On response interrupt, SW reads RIRBWP and consumes entries
//       between the shadow RP (SW-owned) and RIRBWP. Each entry is
//       classified: EX bit 4 of the second u32 distinguishes
//       SOLICITED (a response to a verb SW posted) from UNSOLICITED
//       (a codec-initiated event -- jack plug/unplug, ...).
//
// R33.M1 does NOT drive the ring. This module DECLARES the seams
// (init and consume), holds the ring parameters an eventual R33.M2
// bring-up sequence would populate, and refuses consume until init
// arrives with a plausible ring physical address.
//
// IT IS NOT A LIVE RIRB. Same discipline as hda/corb.pdx §0: the
// seams are stated as a SCAFFOLD, and the pin
// `hda_rirb_arbitrated() == 0` -- an assertion that FAILS the moment
// a future milestone plumbs real MMIO through the controller write
// seam -- forces the design doc to be updated at that time.
//
// SOLICITED AND UNSOLICITED ARE COUNTED SEPARATELY. Both flow
// through the same ring but are classified by the EX bit; the
// scaffold consume seam accepts a classification argument (0 =
// SOLICITED, 1 = UNSOLICITED) and counts each in its own stats
// slot. A live consumer would read the EX bit from the DMA'd
// response bytes; this scaffold takes the classification from the
// caller so the boot witness can exercise both paths without
// running MMIO.
//
// =============================================================================
// §1  SIZE CODE IS ENUMERATED, NOT NEGOTIATED
// =============================================================================
//
// RIRBSIZE bits [1:0] enumerate the three legal ring sizes:
//
//   0b00  =  2 entries (  16 B)
//   0b01  = 16 entries ( 128 B)
//   0b10  = 256 entries (2048 B)
//   0b11  = reserved
//
// Same rejection discipline as hda/corb.pdx §1: caller-supplied byte
// count would let a caller claim a size the controller does not
// support and the register programming would silently clip.
//
// =============================================================================
// §2  ONE WRITER OF THE INIT LATCH
// =============================================================================
//
// Same discipline as hda/corb.pdx §2: exactly one writer of
// `_hda_rirb_bound`, `_hda_rirb_ring_pa`, `_hda_rirb_size_code` and
// `_hda_rirb_stats`. tools/build.sh confines relocations against all
// four to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Ring PA not 128-byte-aligned -> BAD_ALIGN (refused).
// Size code outside {0,1,2} -> BAD_SIZE. Consume before init ->
// NOT_INITIALISED. Second init -> REBIND. Classification outside
// {0,1} -> BAD_KIND. Happy path -> DEFERRED_HARDWARE.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL MMIO / NO DMA READ. hda/controller.pdx returns
//     DEFERRED_HARDWARE without touching the BAR handle, and no
//     memory is allocated for the ring.
//
//   * NO SHADOW RP. A live consumer maintains a SW-side RP and
//     compares it against the DMA-updated RIRBWP; this scaffold
//     counts a consume without addressing the ring.
//
//   * NO UNSOLICITED DISPATCH. A live consumer would forward the
//     unsolicited entry to the codec event stream (R33.M4). This
//     scaffold counts the class and stops.
//
//   * NO ARBITRATION. Same shape as hda/controller.pdx §4.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC70..0xFFFFFC7F
// =============================================================================

module Rirb = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_RIRB_OK                : u64 = 0
  pub let HDA_RIRB_NOT_INITIALISED   : u64 = 0xFFFFFC7F
  pub let HDA_RIRB_BAD_ALIGN         : u64 = 0xFFFFFC7E
  pub let HDA_RIRB_BAD_SIZE          : u64 = 0xFFFFFC7D
  pub let HDA_RIRB_BAD_KIND          : u64 = 0xFFFFFC7B
  pub let HDA_RIRB_DEFERRED_HARDWARE : u64 = 0xFFFFFC7C
  pub let HDA_RIRB_REBIND            : u64 = 0xFFFFFC7A

  // §1 size codes.
  pub let HDA_RIRB_SIZE_2            : u64 = 0
  pub let HDA_RIRB_SIZE_16           : u64 = 1
  pub let HDA_RIRB_SIZE_256          : u64 = 2

  pub let HDA_RIRB_ALIGN_MASK        : u64 = 0x7F

  // §0 classification codes.
  pub let HDA_RIRB_KIND_SOLICITED    : u64 = 0
  pub let HDA_RIRB_KIND_UNSOLICITED  : u64 = 1

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_rirb_bound     : u64 = 0
  pub let mut _hda_rirb_ring_pa   : u64 = 0
  pub let mut _hda_rirb_size_code : u64 = 0
  pub let mut _hda_rirb_stats     : [u64; 8] = uninit @align(64)

  pub let HDA_RIRB_ST_INITS       : u64 = 0
  pub let HDA_RIRB_ST_SOLICITED   : u64 = 1
  pub let HDA_RIRB_ST_UNSOLICITED : u64 = 2
  pub let HDA_RIRB_ST_BAD_ALIGN   : u64 = 3
  pub let HDA_RIRB_ST_BAD_SIZE    : u64 = 4
  pub let HDA_RIRB_ST_BAD_KIND    : u64 = 5
  pub let HDA_RIRB_ST_NOT_INIT    : u64 = 6
  pub let HDA_RIRB_ST_REBIND      : u64 = 7

  // ==========================================================================
  // hda_rirb_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION.
  // ==========================================================================

  pub let hda_rirb_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M1-004 (#1140): report whether the RIRB seam reads real DMA responses today. IT RETURNS 0, because no ring memory is allocated and hda_controller_write is a scaffold. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_rirb_init(ring_pa, size_code) -> OK | REBIND | BAD_ALIGN | BAD_SIZE
  //
  // ARITY TWO. Same rejection discipline as hda_corb_init:
  //   (1) size_code in {0, 1, 2} -- else BAD_SIZE.
  //   (2) ring_pa 128-B-aligned  -- else BAD_ALIGN.
  //   (3) not already bound      -- else REBIND.
  // ==========================================================================

  pub let hda_rirb_init : (u64, u64) -> u64 !{mem} @{} =
    fn (ring_pa: u64, size_code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-004 (#1140): initialise the RIRB frame with a ring physical address and an enumerated RIRBSIZE code. Same three-gate discipline as hda_corb_init (§0/§1/§3): (1) size_code in {0=2 ent, 1=16 ent, 2=256 ent}, else BAD_SIZE -- refused, not defaulted. (2) ring_pa & 0x7F == 0, else BAD_ALIGN -- refused, not rounded: HDA RIRB DMA requires 128-byte alignment per §4.4.2. (3) not already bound, else REBIND. Increments _hda_rirb_stats[0] on OK. Leaf. Labels prefixed hda_rb_in_ per reserved-label discipline.",
      block: {
        // (1) size_code in {0, 1, 2}.
        mov r10, 2;
        cmp rsi, r10;
        ja  hda_rb_in_bad_size;

        // (2) ring_pa & 0x7F == 0.
        mov r10, rdi;
        and r10, 0x7F;
        cmp r10, 0;
        jne hda_rb_in_bad_align;

        // (3) not already bound.
        lea r10, [rip + _hda_rirb_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne hda_rb_in_rebind;

        // (4) latch and return OK.
        lea r10, [rip + _hda_rirb_ring_pa];
        mov [r10], rdi;

        lea r10, [rip + _hda_rirb_size_code];
        mov [r10], rsi;

        lea r10, [rip + _hda_rirb_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // OK
        ret;

      hda_rb_in_bad_size:
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 32];             // slot 4 = BAD_SIZE
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC7D;             // BAD_SIZE
        ret;

      hda_rb_in_bad_align:
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 24];             // slot 3 = BAD_ALIGN
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC7E;             // BAD_ALIGN
        ret;

      hda_rb_in_rebind:
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 56];             // slot 7 = REBIND
        add rax, 1;
        mov [r10 + 56], rax;
        mov rax, 0xFFFFFC7A;             // REBIND
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_rirb_bound() -> 1 | 0
  // ==========================================================================

  pub let hda_rirb_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-004 (#1140): 1 once hda_rirb_init has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_rirb_bound];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_rirb_ring_pa() / hda_rirb_size_code() -- read-only accessors.
  // ==========================================================================

  pub let hda_rirb_ring_pa : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-004 (#1140): return the ring physical address latched at init. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_rirb_ring_pa];
        mov rax, [r10];
        ret
      }
    } @no_frame

  pub let hda_rirb_size_code : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-004 (#1140): return the RIRBSIZE code latched at init (0=2 ent, 1=16, 2=256). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_rirb_size_code];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_rirb_consume(kind) -> code
  //
  // ARITY ONE. kind = HDA_RIRB_KIND_SOLICITED (0) or
  // HDA_RIRB_KIND_UNSOLICITED (1). A live consumer would classify by
  // reading the EX bit from the DMA'd response entry; this scaffold
  // takes the classification from the caller so the boot witness can
  // exercise both paths without running MMIO.
  //
  // Gates, in order:
  //   (1) kind in {0, 1}        -- else BAD_KIND.
  //   (2) init has run          -- else NOT_INITIALISED.
  //   (3) happy path counts and returns DEFERRED_HARDWARE.
  // ==========================================================================

  pub let hda_rirb_consume : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-004 (#1140): consume one response entry classified as SOLICITED (0) or UNSOLICITED (1). Gates: (1) kind in {0, 1}, else BAD_KIND -- refused, not defaulted: an unknown classification is a caller error, and picking one by default would silently misroute a codec event. (2) init has run, else NOT_INITIALISED -- a consume before init would read from a zero-based ring. (3) increments the class-specific stats slot (SOLICITED -> [1], UNSOLICITED -> [2]) and returns DEFERRED_HARDWARE. NO REAL DMA READ RUNS (§4). Leaf. Labels prefixed hda_rb_cn_ per reserved-label discipline.",
      block: {
        // (1) kind in {0, 1}.
        mov r10, 1;
        cmp rdi, r10;
        ja  hda_rb_cn_bad_kind;

        // (2) init has run.
        lea r10, [rip + _hda_rirb_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  hda_rb_cn_not_init;

        // (3) route to per-class slot then DEFERRED_HARDWARE.
        cmp rdi, 0;
        jne hda_rb_cn_unsol;

        // SOLICITED
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 8];              // slot 1 = SOLICITED
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFC7C;             // DEFERRED_HARDWARE
        ret;

      hda_rb_cn_unsol:
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 16];             // slot 2 = UNSOLICITED
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC7C;             // DEFERRED_HARDWARE
        ret;

      hda_rb_cn_bad_kind:
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 40];             // slot 5 = BAD_KIND
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC7B;             // BAD_KIND
        ret;

      hda_rb_cn_not_init:
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 48];             // slot 6 = NOT_INITIALISED
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC7F;             // NOT_INITIALISED
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_rirb_solicited() / hda_rirb_unsolicited() -> count
  // ==========================================================================

  pub let hda_rirb_solicited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-004 (#1140): count of consume(SOLICITED) outcomes. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let hda_rirb_unsolicited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-004 (#1140): count of consume(UNSOLICITED) outcomes. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_rirb_stats];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame
}
