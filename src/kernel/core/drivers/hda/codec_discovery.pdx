// src/kernel/core/drivers/hda/codec_discovery.pdx — R33.M2-001 (#1142)
//
// The kernel-side Intel HDA CODEC DISCOVERY scaffold: verb encoding,
// GET_PARAMETER over CORB, node walk over the codec address space.
// SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE PROBE FRAME for Intel HDA codec discovery. Per Intel HDA
// §7.3 the software enumerates codecs by walking the codec address
// space (0..15, one per SDIN line) and, for each present codec,
// probing the root node (node 0) with GET_PARAMETER (verb 0xF00) for
// four fundamental parameter ids:
//
//   0x00  VENDOR_ID              32-bit {vendor:16, device:16}
//   0x02  REVISION_ID            revision + stepping
//   0x04  SUBORDINATE_NODE_COUNT {start_node:8, total_nodes:8}
//   0x05  FUNCTION_GROUP_TYPE    fg type + capabilities bit
//
// Function groups (typically AFG=Audio Function Group at type 0x01)
// live under the root; widget nodes (audio outputs, inputs, mixers,
// selectors, pin complexes) live under each function group. This
// module DECLARES the seams (get_parameter, walk_function_groups,
// walk_widgets, probe_all) and refuses discovery calls until both
// CORB and RIRB are bound.
//
// IT IS NOT A LIVE DISCOVERY PASS. Same discipline as hda/corb.pdx §0
// and hda/rirb.pdx §0: the seams are stated as a SCAFFOLD, and the
// pin `hda_codec_discovery_arbitrated() == 0` -- an assertion that
// FAILS the moment a future milestone plumbs real DMA response
// consumption -- forces the design doc to be updated at that time.
//
// THE SCAFFOLD DOES SUBMIT VERBS. get_parameter encodes a real
// 32-bit verb and hands it to hda_corb_submit (which itself returns
// DEFERRED_HARDWARE without touching the ring). It then calls
// hda_rirb_consume(SOLICITED) to advance the response-consumer
// counter. What it does NOT do: read a byte back from the ring,
// classify the DMA'd response payload, or filter absent codecs by
// timeout. Absent-codec filtering awaits real MMIO in R33.M3.
//
// =============================================================================
// §1  VERB ENCODING IS FIXED, NOT NEGOTIATED
// =============================================================================
//
// Per Intel HDA §7.3.3 the 32-bit codec verb wire format is:
//
//   bits [31:28]  codec address (0..15, indexes the SDIN line)
//   bits [27:20]  node id (0..255; node 0 is the root)
//   bits [19:12]  verb (0x000..0xFFF; 0xF00 = GET_PARAMETER, 0xF01 =
//                       GET_CONNECTION_SELECT, ...)
//   bits [11:0]   payload (verb-specific; for GET_PARAMETER, the
//                          parameter id occupies bits [7:0])
//
// Every field is REFUSED at the encoder if it does not fit. A caller
// that supplied a codec_addr of 16 would either encode into bit 32
// (out of the verb) or wrap into bits [31:28] of node -- the encoder
// refuses rather than either, mirroring hda/corb.pdx's rejection
// discipline.
//
// =============================================================================
// §2  ONE READER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_codec_disc_stats`
// to this object. The counters are the only evidence that a discovery
// pass ran and what it observed; a second writer would let another
// module invent probe counts.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr outside 0..15 -> BAD_ADDR (refused, not truncated).
// node_id outside 0..255 -> BAD_NODE. param_id outside 0..255 ->
// BAD_PARAM. CORB or RIRB not bound -> NOT_READY. Happy path ->
// DEFERRED_HARDWARE.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL RESPONSE READ. hda/rirb.pdx returns DEFERRED_HARDWARE
//     without touching the ring, so there is no vendor_id byte to
//     inspect. The scaffold's probe_all treats every codec address
//     as present.
//   * NO ABSENT-CODEC FILTERING. A live pass would wait for the
//     RIRB response threshold (RINTCNT) and treat a timeout as
//     "codec not present". Deferred to R33.M3.
//   * NO WIDGET DESCRIPTOR PARSING. Widget capabilities (AUDIO_
//     WIDGET_CAP, PCM_SIZE_RATE, ...) are read in later milestones.
//     This scaffold enumerates NODE IDS via the fixed count the
//     Intel HDA §7.3.4 example encodes; a live pass takes the range
//     from SUBORDINATE_NODE_COUNT's DMA reply.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC80..0xFFFFFC8F
// =============================================================================

module CodecDiscovery = structure {

  // ==========================================================================
  // §1 verb encoding constants.
  // ==========================================================================

  pub let HDA_CODEC_MAX               : u64 = 16
  pub let HDA_NODE_MAX                : u64 = 256
  pub let HDA_VERB_MAX                : u64 = 4096
  pub let HDA_PAYLOAD_MAX             : u64 = 4096

  pub let HDA_VERB_GET_PARAMETER      : u64 = 0xF00

  pub let HDA_PARAM_VENDOR_ID              : u64 = 0x00
  pub let HDA_PARAM_REVISION_ID            : u64 = 0x02
  pub let HDA_PARAM_SUBORDINATE_NODE_COUNT : u64 = 0x04
  pub let HDA_PARAM_FUNCTION_GROUP_TYPE    : u64 = 0x05
  pub let HDA_PARAM_AUDIO_WIDGET_CAP       : u64 = 0x09

  // Scaffold-side fixed walk depths. A live pass takes them from the
  // SUBORDINATE_NODE_COUNT DMA reply; §4 documents the deferral.
  pub let HDA_CD_FG_PER_CODEC     : u64 = 2   // AFG + MFG (upper bound)
  pub let HDA_CD_WIDGETS_PER_FG   : u64 = 8   // ALC287-shaped upper bound

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_CODEC_DISC_OK                 : u64 = 0
  pub let HDA_CODEC_DISC_NOT_READY          : u64 = 0xFFFFFC8F
  pub let HDA_CODEC_DISC_BAD_ADDR           : u64 = 0xFFFFFC8E
  pub let HDA_CODEC_DISC_BAD_NODE           : u64 = 0xFFFFFC8D
  pub let HDA_CODEC_DISC_DEFERRED_HARDWARE  : u64 = 0xFFFFFC8C
  pub let HDA_CODEC_DISC_BAD_PARAM          : u64 = 0xFFFFFC8B

  // The encoder's contract for a refused input.
  pub let HDA_CODEC_VERB_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Stats. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_codec_disc_stats : [u64; 8] = uninit @align(64)

  pub let HDA_CD_ST_PROBES         : u64 = 0
  pub let HDA_CD_ST_GET_PARAMS     : u64 = 1
  pub let HDA_CD_ST_FGS_WALKED     : u64 = 2
  pub let HDA_CD_ST_WIDGETS_WALKED : u64 = 3
  pub let HDA_CD_ST_BAD_ADDR       : u64 = 4
  pub let HDA_CD_ST_BAD_NODE       : u64 = 5
  pub let HDA_CD_ST_BAD_PARAM      : u64 = 6
  pub let HDA_CD_ST_NOT_READY      : u64 = 7

  // ==========================================================================
  // hda_codec_discovery_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as hda_controller_arbitrated
  // and hda_corb_arbitrated: pinned at 0 by the boot witness so a
  // future milestone plumbing real DMA response consumption cannot
  // land without rewriting the claim.
  // ==========================================================================

  pub let hda_codec_discovery_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-001 (#1142): report whether the discovery pass reads real DMA response payloads. IT RETURNS 0, because hda/rirb.pdx returns DEFERRED_HARDWARE without touching the ring, and this scaffold submits verbs whose replies it never inspects. The boot witness pins it at 0 so a future milestone that plumbs the response classifier cannot land silently. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_codec_verb_encode(codec_addr, node_id, verb, payload) -> u32 | BAD
  //
  // ARITY FOUR: the four wire fields §1 documents. Each is REFUSED
  // rather than truncated. Widening to accept a pre-packed u32 would
  // let a caller reach codec bytes with no field validation between
  // the pack and the wire.
  // ==========================================================================

  pub let hda_codec_verb_encode : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (codec_addr: u64, node_id: u64, verb: u64, payload: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-001 (#1142): encode a 32-bit codec verb per §1. Gates: (1) codec_addr < HDA_CODEC_MAX (16); else HDA_CODEC_VERB_BAD -- refused rather than truncated: a codec_addr of 16 with a rotate/mask would land at addr 0 while pretending to reach addr 16, and the discovery pass would then loop forever thinking it was probing new codecs. (2) node_id < HDA_NODE_MAX (256); else BAD -- refused rather than masked: an 8-bit node field exists because the wire has 8 bits, and a wider argument is a caller error. (3) verb < HDA_VERB_MAX (4096) and (4) payload < HDA_PAYLOAD_MAX (4096); same. Pack: (codec_addr << 28) | (node_id << 20) | (verb << 12) | payload. Result fits in 32 bits, so no upper bits leak. Pure leaf. Labels prefixed hcd_ve_ per reserved-label discipline.",
      block: {
        // (1) codec_addr < 16
        mov r10, 16;
        cmp rdi, r10;
        jae hcd_ve_bad;

        // (2) node_id < 256
        mov r10, 256;
        cmp rsi, r10;
        jae hcd_ve_bad;

        // (3) verb < 4096
        mov r10, 4096;
        cmp rdx, r10;
        jae hcd_ve_bad;

        // (4) payload < 4096
        mov r10, 4096;
        cmp rcx, r10;
        jae hcd_ve_bad;

        // Pack.
        mov rax, rdi;
        shl rax, 28;
        mov r10, rsi;
        shl r10, 20;
        or  rax, r10;
        mov r10, rdx;
        shl r10, 12;
        or  rax, r10;
        or  rax, rcx;
        ret;

      hcd_ve_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_codec_get_parameter(codec_addr, node_id, param_id) -> code
  //
  // Submits a GET_PARAMETER verb over CORB and advances the RIRB
  // consumer counter (as SOLICITED). NO REAL RESPONSE READ (§4).
  //
  // ARITY THREE. Widening to accept a raw 32-bit verb would bypass
  // the verb-field validator §1 exists to enforce.
  // ==========================================================================

  pub let hda_codec_get_parameter : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, param_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-001 (#1142): send GET_PARAMETER (verb 0xF00) to (codec_addr, node_id) for param_id and mark one solicited response as consumed. Gates, in order: (1) hda_corb_bound() AND hda_rirb_bound() -- else NOT_READY: the CORB init latch and RIRB init latch are what say a live producer/consumer pair exists. A get_parameter before either would submit to an unbound ring. (2) codec_addr < 16 else BAD_ADDR (counted, refused). (3) node_id < 256 else BAD_NODE (counted, refused). (4) param_id < 256 else BAD_PARAM (counted, refused): the wire format has param_id in payload[7:0]; a wider argument would encode into bits[11:8] and address a different verb payload. (5) encode via hda_codec_verb_encode; submit via hda_corb_submit; ignore its DEFERRED_HARDWARE return -- the seam succeeded at the discipline gate, and the deferred-hardware nature is documented in hda/corb.pdx §4. (6) advance the RIRB consumer via hda_rirb_consume(SOLICITED = 0). (7) increment GET_PARAMS. Return DEFERRED_HARDWARE. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed hcd_ge_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr
        mov r13, rsi;                    // node_id
        mov r14, rdx;                    // param_id

        // (1) CORB/RIRB bound?
        call hda_corb_bound;
        cmp rax, 0;
        je  hcd_ge_not_ready;
        call hda_rirb_bound;
        cmp rax, 0;
        je  hcd_ge_not_ready;

        // (2) codec_addr < 16
        mov r10, 16;
        cmp r12, r10;
        jae hcd_ge_bad_addr;

        // (3) node_id < 256
        mov r10, 256;
        cmp r13, r10;
        jae hcd_ge_bad_node;

        // (4) param_id < 256
        mov r10, 256;
        cmp r14, r10;
        jae hcd_ge_bad_param;

        // (5) encode verb + submit.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0xF00;                  // GET_PARAMETER
        mov rcx, r14;                    // payload = param_id
        call hda_codec_verb_encode;
        // (encoder can't return BAD here: all four fields validated above)
        mov rdi, rax;
        call hda_corb_submit;
        // (ignore return: DEFERRED_HARDWARE is the seam's success sentinel)

        // (6) advance RIRB consumer as SOLICITED.
        xor rdi, rdi;                    // HDA_RIRB_KIND_SOLICITED
        call hda_rirb_consume;

        // (7) count and return.
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 8];              // ST_GET_PARAMS
        add rax, 1;
        mov [r10 + 8], rax;

        mov rax, 0xFFFFFC8C;             // DEFERRED_HARDWARE
        jmp hcd_ge_out;

      hcd_ge_not_ready:
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 56];             // ST_NOT_READY
        add rax, 1;
        mov [r10 + 56], rax;
        mov rax, 0xFFFFFC8F;             // NOT_READY
        jmp hcd_ge_out;
      hcd_ge_bad_addr:
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 32];             // ST_BAD_ADDR
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC8E;
        jmp hcd_ge_out;
      hcd_ge_bad_node:
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 40];             // ST_BAD_NODE
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC8D;
        jmp hcd_ge_out;
      hcd_ge_bad_param:
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 48];             // ST_BAD_PARAM
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC8B;

      hcd_ge_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_codec_walk_function_groups(codec_addr) -> count | code
  //
  // ARITY ONE. Sends SUBORDINATE_NODE_COUNT to node 0, then walks a
  // fixed count of HDA_CD_FG_PER_CODEC function-group nodes probing
  // FUNCTION_GROUP_TYPE on each. Returns the count actually walked
  // on success. A live pass would take the range from the DMA reply.
  // ==========================================================================

  pub let hda_codec_walk_function_groups : (u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-001 (#1142): walk the function-group nodes under codec_addr. Sequence: (1) get_parameter(codec_addr, 0, SUBORDINATE_NODE_COUNT) to probe the range -- a live pass would consume the DMA reply for {start_node, total_nodes} and iterate that range; this scaffold uses a fixed count (§0/§4). Return the get_parameter code on any non-DEFERRED_HARDWARE outcome so the caller can distinguish BAD_ADDR / NOT_READY from a successful walk. (2) For each of HDA_CD_FG_PER_CODEC nodes (starting at node 1, which is where AFG lives per HDA §7.3.4), send get_parameter FUNCTION_GROUP_TYPE. Count only successful (DEFERRED_HARDWARE) sends. (3) Increment ST_FGS_WALKED by the count. Return the count. Two pushes leave rsp%16 == 0 at every nested call. Labels prefixed hcd_wa_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // codec_addr
        xor rbx, rbx;                    // count of successful FG probes

        // (1) SUBORDINATE_NODE_COUNT on node 0.
        mov rdi, r12;
        xor rsi, rsi;                    // node 0
        mov rdx, 0x04;                   // SUBORDINATE_NODE_COUNT
        call hda_codec_get_parameter;
        mov r11, 0xFFFFFC8C;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hcd_wa_out_ax;               // propagate the error

        // (2) Walk HDA_CD_FG_PER_CODEC function groups starting at node 1.
        mov r13, 1;                      // current node
        mov r14, 3;                      // stop at node 1 + HDA_CD_FG_PER_CODEC (2)
      hcd_wa_scan:
        cmp r13, r14;
        jae hcd_wa_done;

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x05;                   // FUNCTION_GROUP_TYPE
        call hda_codec_get_parameter;
        mov r11, 0xFFFFFC8C;
        cmp rax, r11;
        jne hcd_wa_next;
        add rbx, 1;
      hcd_wa_next:
        add r13, 1;
        jmp hcd_wa_scan;

      hcd_wa_done:
        // (3) Bump ST_FGS_WALKED by rbx.
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 16];             // ST_FGS_WALKED
        add rax, rbx;
        mov [r10 + 16], rax;
        mov rax, rbx;
        jmp hcd_wa_out;

      hcd_wa_out_ax:
        // Fall through with rax preserved.

      hcd_wa_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_codec_walk_widgets(codec_addr, fg_node) -> count | code
  //
  // ARITY TWO. Sends SUBORDINATE_NODE_COUNT under fg_node, then
  // probes AUDIO_WIDGET_CAP on a fixed count of widget nodes.
  // ==========================================================================

  pub let hda_codec_walk_widgets : (u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, fg_node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-001 (#1142): walk the widget nodes under (codec_addr, fg_node). Sequence: (1) get_parameter(codec_addr, fg_node, SUBORDINATE_NODE_COUNT); propagate any non-DEFERRED_HARDWARE code. (2) For each of HDA_CD_WIDGETS_PER_FG nodes, probe AUDIO_WIDGET_CAP. Count successful sends. (3) Bump ST_WIDGETS_WALKED. Return the count. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed hcd_wi_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr
        mov r13, rsi;                    // fg_node
        xor rbx, rbx;                    // count

        // (1) SUBORDINATE_NODE_COUNT on fg_node.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x04;                   // SUBORDINATE_NODE_COUNT
        call hda_codec_get_parameter;
        mov r11, 0xFFFFFC8C;
        cmp rax, r11;
        jne hcd_wi_out_ax;

        // (2) Walk widgets. Start at fg_node+1 for HDA_CD_WIDGETS_PER_FG steps.
        mov r14, r13;
        add r14, 1;                      // current widget node
        mov r15, r14;
        add r15, 8;                      // stop at start + HDA_CD_WIDGETS_PER_FG
      hcd_wi_scan:
        cmp r14, r15;
        jae hcd_wi_done;
        // Guard node < 256 so a large fg_node does not overflow.
        mov r10, 256;
        cmp r14, r10;
        jae hcd_wi_done;

        mov rdi, r12;
        mov rsi, r14;
        mov rdx, 0x09;                   // AUDIO_WIDGET_CAP
        call hda_codec_get_parameter;
        mov r11, 0xFFFFFC8C;
        cmp rax, r11;
        jne hcd_wi_next;
        add rbx, 1;
      hcd_wi_next:
        add r14, 1;
        jmp hcd_wi_scan;

      hcd_wi_done:
        // (3) Bump ST_WIDGETS_WALKED.
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 24];             // ST_WIDGETS_WALKED
        add rax, rbx;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp hcd_wi_out;

      hcd_wi_out_ax:
        // fall through
      hcd_wi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_codec_discovery_probe_all() -> count | code
  //
  // ARITY ZERO. Walks codec addresses 0..15 and probes VENDOR_ID on
  // each. Returns the count of successful probes (all 16 in this
  // scaffold, since no real DMA is inspected).
  // ==========================================================================

  pub let hda_codec_discovery_probe_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-001 (#1142): walk 0..15 and probe VENDOR_ID (param 0x00 at node 0) on each address. Returns count of successful sends. A live pass would treat a RIRB timeout as 'codec absent' and skip; this scaffold treats every address as present. Increments ST_PROBES by the count on completion. Propagates any NOT_READY encountered on the first probe so the caller sees an unbound-CORB error rather than a zero count. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed hcd_pa_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        xor rbx, rbx;                    // count
        xor r12, r12;                    // codec_addr

      hcd_pa_scan:
        cmp r12, 16;                     // HDA_CODEC_MAX
        jae hcd_pa_done;

        mov rdi, r12;
        xor rsi, rsi;                    // node 0
        xor rdx, rdx;                    // VENDOR_ID (0x00)
        call hda_codec_get_parameter;
        mov r11, 0xFFFFFC8C;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hcd_pa_check_ready;
        add rbx, 1;
        add r12, 1;
        jmp hcd_pa_scan;

      hcd_pa_check_ready:
        // If NOT_READY on the FIRST probe, propagate it (nothing to count).
        mov r11, 0xFFFFFC8F;             // NOT_READY
        cmp rax, r11;
        jne hcd_pa_next_bad;
        cmp r12, 0;
        je  hcd_pa_out_ax;
      hcd_pa_next_bad:
        add r12, 1;
        jmp hcd_pa_scan;

      hcd_pa_done:
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + 0];              // ST_PROBES
        add rax, rbx;
        mov [r10 + 0], rax;
        mov rax, rbx;
        jmp hcd_pa_out;

      hcd_pa_out_ax:
        // rax already holds NOT_READY
      hcd_pa_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_codec_disc_stat(which) -> count
  // ==========================================================================

  pub let hda_codec_disc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-001 (#1142): bounds-checked read of one discovery counter. Out of range returns 0. Leaf. Labels prefixed hcd_st_.",
      block: {
        cmp rdi, 8;
        jae hcd_st_zero;
        lea r10, [rip + _hda_codec_disc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hcd_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

}
