// src/kernel/core/drivers/hda/corb.pdx — R33.M1-003 (#1139)
//
// The kernel-side Intel HDA CORB (Command Output Ring Buffer)
// scaffold. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE CORB PRODUCER FRAME for an Intel HDA controller. Per
// Intel HDA §4.4.1 the CORB is a DMA-driven ring in host memory the
// software fills with 32-bit verbs (codec ID + node + control) that
// the controller reads and dispatches to the codecs. The producer
// contract is:
//
//   (1) SW allocates a physically-contiguous, 128-byte-aligned ring
//       of 2 / 16 / 256 entries (u32 each).
//   (2) SW writes the ring base into CORBLBASE (BAR0+0x40, low 32
//       bits) + CORBUBASE (BAR0+0x44, high 32 bits).
//   (3) SW selects the ring size via CORBSIZE (BAR0+0x4E, bits [1:0]).
//   (4) SW asserts CORBRPRST (CORBRP bit 15) then clears it, verifying
//       CORBRP reads back as 0.
//   (5) SW writes CORBCTL.RUN (BAR0+0x4C bit 1) = 1.
//   (6) To submit a verb: write the u32 into ring[WP+1 mod SIZE], then
//       publish by writing CORBWP (BAR0+0x48) = (WP+1 mod SIZE). The
//       controller polls CORBWP against its CORBRP and DMAs the new
//       verb into the codec.
//
// Overrun is impossible on the producer side by construction: SW must
// gate every publish on `((WP+1) mod SIZE) != current_CORBRP`, which
// requires reading CORBRP over MMIO. A caller that skips the gate can
// clobber a verb the controller has not yet consumed.
//
// R33.M1 does NOT drive the ring. This module DECLARES the seams
// (init and submit), holds the ring parameters an eventual R33.M2
// bring-up sequence would populate, and refuses submit until init
// arrives with a plausible ring physical address.
//
// IT IS NOT A LIVE CORB. Same discipline as hda/controller.pdx §0
// and hda/reset.pdx §0: the seams are stated as a SCAFFOLD, and the
// pin `hda_corb_arbitrated() == 0` -- an assertion that FAILS the
// moment a future milestone plumbs real MMIO through the controller
// write seam -- forces the design doc to be updated at that time.
//
// IT ACCEPTS AN OPAQUE u64 RING PHYSICAL ADDRESS AND AN ENUMERATED
// SIZE CODE. R33.M1 has no phys_alloc consumer for HDA rings; the
// bind takes an opaque u64 that the write seams observe and refuse
// to dereference. Widening bind to accept the ring VIRTUAL ADDRESS
// too would let a caller reach memory no capability named -- exactly
// what §2 of ec_access.pdx exists to prevent -- so the seam is arity
// TWO ({ring_pa, size_code}) at this milestone.
//
// =============================================================================
// §1  SIZE CODE IS ENUMERATED, NOT NEGOTIATED
// =============================================================================
//
// CORBSIZE bits [1:0] enumerate the three legal ring sizes:
//
//   0b00  =  2 entries (   8 B)
//   0b01  = 16 entries (  64 B)
//   0b10  = 256 entries (1024 B)
//   0b11  = reserved
//
// The size code is validated to be one of {0, 1, 2} at bind. A
// caller-supplied byte count (8 / 64 / 1024) would let a caller
// claim a ring size the controller does not support and the register
// programming would silently clip or corrupt; the enumerated code is
// what the register consumes on the wire.
//
// =============================================================================
// §2  ONE WRITER OF THE INIT LATCH
// =============================================================================
//
// Same discipline as hda/controller.pdx §2: exactly one writer of
// `_hda_corb_bound`, `_hda_corb_ring_pa`, `_hda_corb_size_code` and
// `_hda_corb_stats`. tools/build.sh confines relocations against all
// four to this object. The ring parameters are a LATCH; once bound
// they cannot be re-bound (a second init returns REBIND).
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Ring PA not 128-byte-aligned -> BAD_ALIGN (refused, not rounded --
// the controller DMA engine requires bit alignment the spec pins).
// Size code outside {0,1,2} -> BAD_SIZE. Submit before init ->
// NOT_INITIALISED. Second init -> REBIND. Verb wider than 32 bits ->
// BAD_VERB. Happy path -> DEFERRED_HARDWARE.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL MMIO. hda/controller.pdx returns DEFERRED_HARDWARE
//     without touching the BAR handle.
//
//   * NO WP/RP TRACKING. A live producer must maintain a shadow WP,
//     read CORBRP over MMIO before every publish, and refuse
//     overrun. This scaffold submits a verb by validating and
//     counting it; no write reaches the ring.
//
//   * NO CORBRPRST HANDSHAKE. The step (4) reset assertion is a
//     bring-up-time-only sequence; deferred to R33.M2.
//
//   * NO ARBITRATION. Same shape as hda/controller.pdx §4.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC60..0xFFFFFC6F
// =============================================================================

module Corb = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_CORB_OK                : u64 = 0
  pub let HDA_CORB_NOT_INITIALISED   : u64 = 0xFFFFFC6F
  pub let HDA_CORB_BAD_ALIGN         : u64 = 0xFFFFFC6E
  pub let HDA_CORB_BAD_SIZE          : u64 = 0xFFFFFC6D
  pub let HDA_CORB_BAD_VERB          : u64 = 0xFFFFFC6B
  pub let HDA_CORB_DEFERRED_HARDWARE : u64 = 0xFFFFFC6C
  pub let HDA_CORB_REBIND            : u64 = 0xFFFFFC6A

  // §1 size codes.
  pub let HDA_CORB_SIZE_2            : u64 = 0
  pub let HDA_CORB_SIZE_16           : u64 = 1
  pub let HDA_CORB_SIZE_256          : u64 = 2

  // Ring alignment mask -- CORB spec requires the ring physical
  // address to be 128-byte-aligned.
  pub let HDA_CORB_ALIGN_MASK        : u64 = 0x7F

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_corb_bound     : u64 = 0
  pub let mut _hda_corb_ring_pa   : u64 = 0
  pub let mut _hda_corb_size_code : u64 = 0
  pub let mut _hda_corb_stats     : [u64; 8] = uninit @align(64)

  pub let HDA_CORB_ST_INITS       : u64 = 0
  pub let HDA_CORB_ST_SUBMITS     : u64 = 1
  pub let HDA_CORB_ST_BAD_ALIGN   : u64 = 2
  pub let HDA_CORB_ST_BAD_SIZE    : u64 = 3
  pub let HDA_CORB_ST_BAD_VERB    : u64 = 4
  pub let HDA_CORB_ST_NOT_INIT    : u64 = 5
  pub let HDA_CORB_ST_REBIND      : u64 = 6
  pub let HDA_CORB_ST_MAX         : u64 = 8

  // ==========================================================================
  // hda_corb_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as hda_controller_arbitrated
  // and hda_reset_arbitrated: pinned at 0 by the boot witness so a
  // future milestone plumbing real MMIO cannot land without rewriting
  // the claim.
  // ==========================================================================

  pub let hda_corb_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M1-003 (#1139): report whether the CORB seam issues real MMIO today. IT RETURNS 0, because the controller write seam is a scaffold. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_corb_init(ring_pa, size_code) -> OK | REBIND | BAD_ALIGN | BAD_SIZE
  //
  // ARITY TWO: ring physical address and enumerated CORB size code.
  // A caller-supplied ring VIRTUAL address too would be a way to
  // reach memory no capability named -- exactly what §2 of
  // ec_access.pdx exists to prevent.
  //
  // Gates, in order:
  //   (1) size_code in {0, 1, 2}   -- else BAD_SIZE (refused).
  //   (2) ring_pa 128-byte-aligned -- else BAD_ALIGN (refused).
  //   (3) not already bound        -- else REBIND (refused).
  //   (4) latch and return OK.
  // ==========================================================================

  pub let hda_corb_init : (u64, u64) -> u64 !{mem} @{} =
    fn (ring_pa: u64, size_code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-003 (#1139): initialise the CORB frame with a ring physical address and an enumerated CORBSIZE code. Gates: (1) size_code in {0=2 ent, 1=16 ent, 2=256 ent}, else BAD_SIZE -- refused, not defaulted: a size the controller cannot program is a bring-up error the driver must fix, not one the register programmer papers over. (2) ring_pa & 0x7F == 0, else BAD_ALIGN -- refused, not rounded: HDA CORB DMA requires 128-byte alignment per §4.4.1, and a rounded address would let the DMA engine walk memory the caller did not intend. (3) not already bound, else REBIND -- the whole discipline rests on the bind being a LATCH. Increments _hda_corb_stats[0] on OK. Leaf. Labels prefixed hda_cb_in_ per reserved-label discipline.",
      block: {
        // (1) size_code in {0, 1, 2}.
        mov r10, 2;
        cmp rsi, r10;
        ja  hda_cb_in_bad_size;

        // (2) ring_pa & 0x7F == 0.
        mov r10, rdi;
        and r10, 0x7F;
        cmp r10, 0;
        jne hda_cb_in_bad_align;

        // (3) not already bound.
        lea r10, [rip + _hda_corb_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne hda_cb_in_rebind;

        // (4) latch and return OK.
        lea r10, [rip + _hda_corb_ring_pa];
        mov [r10], rdi;

        lea r10, [rip + _hda_corb_size_code];
        mov [r10], rsi;

        lea r10, [rip + _hda_corb_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // OK
        ret;

      hda_cb_in_bad_size:
        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 24];             // slot 3 = BAD_SIZE
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC6D;             // BAD_SIZE
        ret;

      hda_cb_in_bad_align:
        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 16];             // slot 2 = BAD_ALIGN
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC6E;             // BAD_ALIGN
        ret;

      hda_cb_in_rebind:
        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 48];             // slot 6 = REBIND
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC6A;             // REBIND
        ret
      }
    }

  // ==========================================================================
  // hda_corb_bound() -> 1 | 0
  // ==========================================================================

  pub let hda_corb_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-003 (#1139): 1 once hda_corb_init has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_corb_bound];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hda_corb_ring_pa() / hda_corb_size_code() -- read-only accessors
  // for the parameters latched at init.
  // ==========================================================================

  pub let hda_corb_ring_pa : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-003 (#1139): return the ring physical address latched at init. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_corb_ring_pa];
        mov rax, [r10];
        ret
      }
    }

  pub let hda_corb_size_code : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-003 (#1139): return the CORBSIZE code latched at init (0=2 ent, 1=16, 2=256). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_corb_size_code];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hda_corb_submit(verb) -> code
  //
  // ARITY ONE. Verb is the 32-bit codec verb (codec addr bits [31:28]
  // + node id [27:20] + verb [19:0]). A caller-supplied ring index
  // would let a caller clobber a slot the controller has not yet
  // consumed -- the WP is owned by the driver, not the caller.
  //
  // Gates, in order:
  //   (1) verb fits 32 bits -- else BAD_VERB (refused, not truncated).
  //   (2) init has run      -- else NOT_INITIALISED.
  //   (3) happy path returns DEFERRED_HARDWARE (no MMIO runs).
  // ==========================================================================

  pub let hda_corb_submit : (u64) -> u64 !{mem} @{} =
    fn (verb: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-003 (#1139): submit a codec verb through the CORB scaffold. Gates: (1) verb fits 32 bits, else BAD_VERB -- refused, not truncated: a codec verb wider than 32 bits is a caller error (the wire format is fixed at 4 bytes) and truncating would silently deliver a different verb than the caller intended. (2) init has run, else NOT_INITIALISED and counted -- a submit before init would compute a ring slot address from a zero base and clobber physical address zero. (3) happy path returns DEFERRED_HARDWARE -- no real ring write runs (§4). Leaf. Labels prefixed hda_cb_sb_ per reserved-label discipline.",
      block: {
        // (1) verb fits 32 bits.
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  hda_cb_sb_bad_verb;

        // (2) init has run.
        lea r10, [rip + _hda_corb_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  hda_cb_sb_not_init;

        // (3) DEFERRED_HARDWARE.
        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 8];              // slot 1 = SUBMITS
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFC6C;             // DEFERRED_HARDWARE
        ret;

      hda_cb_sb_bad_verb:
        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 32];             // slot 4 = BAD_VERB
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC6B;             // BAD_VERB
        ret;

      hda_cb_sb_not_init:
        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 40];             // slot 5 = NOT_INITIALISED
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC6F;             // NOT_INITIALISED
        ret
      }
    }

  // ==========================================================================
  // hda_corb_submits() -> count
  // ==========================================================================

  pub let hda_corb_submits : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-003 (#1139): read the count of deferred-hardware outcomes on the submit seam. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_corb_stats];
        mov rax, [r10 + 8];
        ret
      }
    }
}
