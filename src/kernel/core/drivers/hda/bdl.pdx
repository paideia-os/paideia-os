// src/kernel/core/drivers/hda/bdl.pdx — R33.M3-002 (#1148)
//
// The kernel-side Intel HDA Buffer Descriptor List (BDL) scaffold.
// SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE BDL PROGRAMMING FRAME for a single HDA stream descriptor.
// Per Intel HDA §3.6.2 the BDL is a physically-contiguous, 128-byte-
// aligned array of 16-byte entries; each entry is:
//
//   +0  u64 buffer_pa    (physical address of a fragment)
//   +8  u32 length       (fragment length in bytes)
//   +12 u32 flags        (bit 0 = IOC — Interrupt On Completion)
//
// The stream descriptor's BDLPL/BDLPU registers point at the array
// base, and the DMA engine walks entries 0..LVI (Last Valid Index) in
// order, wrapping back to 0. Bring-up:
//
//   (1) SW allocates a 128-byte-aligned BDL of N entries (2 <= N <= 256).
//   (2) SW populates every entry with {buffer_pa, length, flags}.
//   (3) SW writes BDLPL (SDnBDPL, BAR0 + 0x80 + 0x20*n + 0x18) and
//       BDLPU (+0x1C) with the array's physical base.
//   (4) SW writes LVI (+0x0C bits [7:0]) = N-1.
//   (5) SW writes CBL (+0x08) = SUM_i length[i] — total cyclic buffer.
//   (6) SW writes SDCTL.RUN (SDnCTL bit 1) = 1.
//
// R33.M3 does NOT drive real MMIO. This module DECLARES the seams
// (BDL allocation, entry population, LVI/CBL programming) and holds
// the BDL parameters an R33.M4 bring-up sequence would populate; it
// refuses use until an init arrives with plausible parameters.
//
// IT IS NOT A LIVE DMA. Same discipline as hda/controller.pdx §0,
// hda/corb.pdx §0 and hda/reset.pdx §0: the seams are a SCAFFOLD, and
// the pin `hda_bdl_arbitrated() == 0` — an assertion that FAILS the
// moment a future milestone plumbs real MMIO through the stream-
// descriptor write seam — forces the design doc to be updated then.
//
// =============================================================================
// §1  ALIGNMENT AND ENTRY-COUNT ARE ENUMERATED
// =============================================================================
//
// BDL base 128-byte-aligned per §3.6.2. Entry count in [2, 256] per the
// same section. Buffer_pa 128-byte-aligned per §3.3.1 (DMA engine
// requires the fragment aligned to at least the cache line, and 128 B
// is the safe superset). Length in bytes must be a nonzero multiple of
// the sample stride (2/4 bytes for 16-bit or 32-bit stereo) — this
// module bounds it at 128 KiB (a period longer than 128 KiB at 48 kHz
// stereo 32-bit is > 170 ms, past every latency budget the platform
// hosts).
//
// =============================================================================
// §2  ONE WRITER OF THE INIT LATCH
// =============================================================================
//
// Same discipline as hda/corb.pdx §2: exactly one writer of
// `_hda_bdl_bound`, `_hda_bdl_pa`, `_hda_bdl_entries`, `_hda_bdl_cbl`
// and `_hda_bdl_stats`. tools/build.sh confines relocations against
// all five to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// BDL PA not 128-byte-aligned -> BAD_ALIGN.
// Entry count outside [2, 256] -> BAD_COUNT.
// Populate before init -> NOT_INITIALISED.
// Second init -> REBIND.
// Entry index >= entries -> BAD_INDEX.
// Buffer PA not 128-byte-aligned -> BAD_ALIGN.
// Length 0 or > 131072 -> BAD_LENGTH.
// Flags with reserved bits set -> BAD_FLAGS.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL MMIO — no BDLPL/BDLPU/LVI/CBL/SDCTL write reaches a
//     register. The populate happens in a shadow table; when R33.M4
//     lands the real DMA path, hda_bdl_program replaces the shadow
//     write with a stream-descriptor programming sequence.
//   * NO REAL DMA ALLOCATION — R33.M3 has no phys_alloc consumer for
//     BDLs; the bind takes an opaque u64 that the seams observe and
//     refuse to dereference.
//   * NO ARBITRATION.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC40..0xFFFFFC4F
// =============================================================================

module Bdl = structure {

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_BDL_OK                : u64 = 0
  pub let HDA_BDL_NOT_INITIALISED   : u64 = 0xFFFFFC4F
  pub let HDA_BDL_BAD_ALIGN         : u64 = 0xFFFFFC4E
  pub let HDA_BDL_BAD_COUNT         : u64 = 0xFFFFFC4D
  pub let HDA_BDL_BAD_INDEX         : u64 = 0xFFFFFC4C
  pub let HDA_BDL_BAD_LENGTH        : u64 = 0xFFFFFC4B
  pub let HDA_BDL_BAD_FLAGS         : u64 = 0xFFFFFC4A
  pub let HDA_BDL_REBIND            : u64 = 0xFFFFFC49
  pub let HDA_BDL_DEFERRED_HARDWARE : u64 = 0xFFFFFC48

  // §1 bounds.
  pub let HDA_BDL_ALIGN_MASK        : u64 = 0x7F
  pub let HDA_BDL_ENTRIES_MIN       : u64 = 2
  pub let HDA_BDL_ENTRIES_MAX       : u64 = 256
  pub let HDA_BDL_LENGTH_MAX        : u64 = 131072       // 128 KiB
  pub let HDA_BDL_FLAG_IOC          : u64 = 0x1
  pub let HDA_BDL_FLAG_MASK         : u64 = 0x1

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // _hda_bdl_shadow is a 256-entry * 16-byte shadow of the BDL bytes
  // hda_bdl_populate would write into a real DMA array; used by the
  // witness to check that populate reached the entry it claimed to.
  // Real DMA path replaces the shadow with the actual array in R33.M4.
  // ==========================================================================

  pub let mut _hda_bdl_bound   : u64 = 0
  pub let mut _hda_bdl_pa      : u64 = 0
  pub let mut _hda_bdl_entries : u64 = 0
  pub let mut _hda_bdl_cbl     : u64 = 0
  pub let mut _hda_bdl_shadow  : [u64; 512] = uninit @align(64)   // 256 * 16 B
  pub let mut _hda_bdl_stats   : [u64; 8] = uninit @align(64)

  pub let HDA_BDL_ST_INITS       : u64 = 0
  pub let HDA_BDL_ST_POPULATES   : u64 = 1
  pub let HDA_BDL_ST_PROGRAMS    : u64 = 2
  pub let HDA_BDL_ST_BAD_ALIGN   : u64 = 3
  pub let HDA_BDL_ST_BAD_COUNT   : u64 = 4
  pub let HDA_BDL_ST_BAD_INDEX   : u64 = 5
  pub let HDA_BDL_ST_BAD_LENGTH  : u64 = 6
  pub let HDA_BDL_ST_REBIND      : u64 = 7
  pub let HDA_BDL_ST_MAX         : u64 = 8

  // ==========================================================================
  // hda_bdl_arbitrated() -> 0
  // ==========================================================================

  pub let hda_bdl_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-002 (#1148): honesty pin. IT RETURNS 0, because the stream-descriptor programming seam is a scaffold. Boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_bdl_bound() -> 1 | 0
  // ==========================================================================

  pub let hda_bdl_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): 1 once hda_bdl_init succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_bdl_bound];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hda_bdl_init(bdl_pa, entries) -> OK | REBIND | BAD_ALIGN | BAD_COUNT
  //
  // ARITY TWO. A caller-supplied BDL VIRTUAL address too would be a way
  // to reach memory no capability named — exactly what ec_access.pdx §2
  // exists to prevent.
  // ==========================================================================

  pub let hda_bdl_init : (u64, u64) -> u64 !{mem} @{} =
    fn (bdl_pa: u64, entries: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): initialise the BDL frame. Gates: (1) entries in [HDA_BDL_ENTRIES_MIN, HDA_BDL_ENTRIES_MAX] else BAD_COUNT — refused not defaulted: HDA §3.6.2 pins the range and both 0 (a zero-entry list) and 257 (past LVI range) are bring-up errors the driver must fix. (2) bdl_pa & 0x7F == 0 else BAD_ALIGN — refused not rounded per §1. (3) not already bound else REBIND. Sets CBL to 0 initially (populated by the sum of hda_bdl_populate calls). Leaf. Labels prefixed hda_bdl_in_.",
      block: {
        // (1) entries in [MIN, MAX]?
        mov r10, 2;
        cmp rsi, r10;
        jb  hda_bdl_in_bad_count;
        mov r10, 256;
        cmp rsi, r10;
        ja  hda_bdl_in_bad_count;

        // (2) alignment?
        mov r10, rdi;
        and r10, 0x7F;
        cmp r10, 0;
        jne hda_bdl_in_bad_align;

        // (3) not bound?
        lea r10, [rip + _hda_bdl_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne hda_bdl_in_rebind;

        // Latch.
        lea r10, [rip + _hda_bdl_pa];
        mov [r10], rdi;

        lea r10, [rip + _hda_bdl_entries];
        mov [r10], rsi;

        lea r10, [rip + _hda_bdl_cbl];
        xor rax, rax;
        mov [r10], rax;

        lea r10, [rip + _hda_bdl_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;
        ret;

      hda_bdl_in_bad_count:
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 32];             // slot 4 = BAD_COUNT
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC4D;
        ret;

      hda_bdl_in_bad_align:
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 24];             // slot 3 = BAD_ALIGN
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC4E;
        ret;

      hda_bdl_in_rebind:
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 56];             // slot 7 = REBIND
        add rax, 1;
        mov [r10 + 56], rax;
        mov rax, 0xFFFFFC49;
        ret
      }
    }

  // ==========================================================================
  // hda_bdl_pa() / hda_bdl_entries() / hda_bdl_cbl().
  // ==========================================================================

  pub let hda_bdl_pa : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): BDL PA latched at init. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_bdl_pa];
        mov rax, [r10];
        ret
      }
    }

  pub let hda_bdl_entries : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): entry count latched at init. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_bdl_entries];
        mov rax, [r10];
        ret
      }
    }

  pub let hda_bdl_cbl : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): running CBL (sum of populate lengths). Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_bdl_cbl];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hda_bdl_populate(index, buffer_pa, length, flags) -> OK | code
  //
  // ARITY FOUR. Writes one 16-byte entry into the shadow BDL and
  // updates CBL. §3 gates apply.
  // ==========================================================================

  pub let hda_bdl_populate : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (index: u64, buffer_pa: u64, length: u64, flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): populate one BDL entry. Gates: (1) init has run else NOT_INITIALISED. (2) index < entries else BAD_INDEX. (3) buffer_pa & 0x7F == 0 else BAD_ALIGN. (4) length in (0, HDA_BDL_LENGTH_MAX] else BAD_LENGTH. (5) flags & ~HDA_BDL_FLAG_MASK == 0 else BAD_FLAGS. Writes buffer_pa at shadow[index*2 + 0]; length in low 32 bits and flags in high 32 bits of shadow[index*2 + 1]. Adds length to _hda_bdl_cbl. Increments POPULATES. Labels prefixed hda_bdl_pop_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // index
        mov r13, rsi;                    // buffer_pa
        mov r14, rdx;                    // length
        // flags stays in rcx

        // (1) init.
        lea r10, [rip + _hda_bdl_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  hda_bdl_pop_not_init;

        // (2) index < entries.
        lea r10, [rip + _hda_bdl_entries];
        mov rax, [r10];
        cmp r12, rax;
        jae hda_bdl_pop_bad_index;

        // (3) buffer_pa & 0x7F == 0.
        mov rax, r13;
        and rax, 0x7F;
        cmp rax, 0;
        jne hda_bdl_pop_bad_align;

        // (4) length in (0, LENGTH_MAX].
        cmp r14, 0;
        je  hda_bdl_pop_bad_length;
        mov r10, 131072;
        cmp r14, r10;
        ja  hda_bdl_pop_bad_length;

        // (5) flags.
        mov rax, rcx;
        mov r10, 0x1;
        not r10;                         // ~HDA_BDL_FLAG_MASK
        and rax, r10;
        cmp rax, 0;
        jne hda_bdl_pop_bad_flags;

        // Write shadow[index*2 + 0] = buffer_pa.
        lea r10, [rip + _hda_bdl_shadow];
        mov rbx, r12;
        shl rbx, 4;                      // index * 16
        add r10, rbx;
        mov [r10 + 0], r13;

        // shadow[index*2 + 1] = length | (flags << 32).
        mov rax, r14;
        mov r11, rcx;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 8], rax;

        // CBL += length.
        lea r10, [rip + _hda_bdl_cbl];
        mov rax, [r10];
        add rax, r14;
        mov [r10], rax;

        // POPULATES++.
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;

        xor rax, rax;
        jmp hda_bdl_pop_out;

      hda_bdl_pop_not_init:
        mov rax, 0xFFFFFC4F;
        jmp hda_bdl_pop_out;
      hda_bdl_pop_bad_index:
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC4C;
        jmp hda_bdl_pop_out;
      hda_bdl_pop_bad_align:
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC4E;
        jmp hda_bdl_pop_out;
      hda_bdl_pop_bad_length:
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFC4B;
        jmp hda_bdl_pop_out;
      hda_bdl_pop_bad_flags:
        mov rax, 0xFFFFFC4A;

      hda_bdl_pop_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_bdl_entry_pa(index) -> pa | DECODE_BAD
  // hda_bdl_entry_length(index) -> length | DECODE_BAD
  // ==========================================================================

  pub let hda_bdl_entry_pa : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): read shadow entry PA at index. Bounds via _hda_bdl_entries; returns 0xFFFFFFFFFFFFFFFF on out-of-range. Labels prefixed hda_bdl_epa_.",
      block: {
        lea r10, [rip + _hda_bdl_entries];
        mov rax, [r10];
        cmp rdi, rax;
        jae hda_bdl_epa_bad;
        lea r10, [rip + _hda_bdl_shadow];
        mov rax, rdi;
        shl rax, 4;
        add r10, rax;
        mov rax, [r10 + 0];
        ret;
      hda_bdl_epa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let hda_bdl_entry_length : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): read shadow entry length at index. Labels prefixed hda_bdl_elen_.",
      block: {
        lea r10, [rip + _hda_bdl_entries];
        mov rax, [r10];
        cmp rdi, rax;
        jae hda_bdl_elen_bad;
        lea r10, [rip + _hda_bdl_shadow];
        mov rax, rdi;
        shl rax, 4;
        add r10, rax;
        mov rax, [r10 + 8];
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret;
      hda_bdl_elen_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let hda_bdl_entry_flags : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): read shadow entry flags at index. Labels prefixed hda_bdl_efl_.",
      block: {
        lea r10, [rip + _hda_bdl_entries];
        mov rax, [r10];
        cmp rdi, rax;
        jae hda_bdl_efl_bad;
        lea r10, [rip + _hda_bdl_shadow];
        mov rax, rdi;
        shl rax, 4;
        add r10, rax;
        mov rax, [r10 + 8];
        shr rax, 32;
        ret;
      hda_bdl_efl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // hda_bdl_program(stream_desc) -> DEFERRED_HARDWARE | NOT_INITIALISED
  //
  // ARITY ONE. The seam that R33.M4 will populate with the BDLPL /
  // BDLPU / LVI / CBL / SDCTL programming for a stream descriptor
  // index (SDn). Returns DEFERRED_HARDWARE on the happy path today.
  // ==========================================================================

  pub let hda_bdl_program : (u64) -> u64 !{mem} @{} =
    fn (stream_desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): program the stream descriptor to point at the bound BDL. ARITY ONE — stream_desc is the stream number (0..7 output, 8..15 input on a typical HDA); the driver reaches BAR + 0x80 + 0x20*n + ... offsets from that. Gates: (1) init has run else NOT_INITIALISED. (2) DEFERRED_HARDWARE — no real MMIO runs (§4). Increments PROGRAMS. Labels prefixed hda_bdl_pg_.",
      block: {
        lea r10, [rip + _hda_bdl_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  hda_bdl_pg_not_init;

        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;

        mov rax, 0xFFFFFC48;             // DEFERRED_HARDWARE
        ret;

      hda_bdl_pg_not_init:
        mov rax, 0xFFFFFC4F;
        ret
      }
    }

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let hda_bdl_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): scrub every latch, every shadow entry and every counter. Boot / teardown only. Labels prefixed hda_bdl_rs_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _hda_bdl_bound];
        mov [r10], rax;
        lea r10, [rip + _hda_bdl_pa];
        mov [r10], rax;
        lea r10, [rip + _hda_bdl_entries];
        mov [r10], rax;
        lea r10, [rip + _hda_bdl_cbl];
        mov [r10], rax;

        lea r10, [rip + _hda_bdl_shadow];
        xor rcx, rcx;
      hda_bdl_rs_shadow:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  hda_bdl_rs_shadow;

        lea r10, [rip + _hda_bdl_stats];
        xor rcx, rcx;
      hda_bdl_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hda_bdl_rs_stats;
        ret
      }
    }

  pub let hda_bdl_populates : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): count of successful populate calls. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let hda_bdl_programs : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-002 (#1148): count of deferred-hardware program outcomes. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_bdl_stats];
        mov rax, [r10 + 16];
        ret
      }
    }
}
