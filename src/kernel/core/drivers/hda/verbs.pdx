// src/kernel/core/drivers/hda/verbs.pdx -- R33.M2-004 (#1145)
//
// Per-verb helpers for the Intel HDA codec verb path: SET/GET
// PIN_WIDGET_CTL, EAPD_BTL_ENABLE, POWER_STATE, and AMP_GAIN_MUTE.
// SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS A BAG OF NAMED HELPERS that (a) fix the verb id for a common
// codec operation, (b) validate the payload's width and value range for
// that verb, (c) submit the verb through the existing CORB scaffold,
// and (d) advance the RIRB response consumer counter. It does NOT
// change how the wire encoding works (that is codec_discovery.pdx §1),
// does NOT read responses (that is R33.M3), and does NOT own any
// storage of its own besides a small counters table.
//
// Every helper has a FIXED SIGNATURE per its verb. The payload
// parameter's shape reflects what the verb's payload actually names --
// PIN_WIDGET_CTL takes ONE byte (bits [7:0] of the pin control
// register), EAPD_BTL_ENABLE takes ONE byte (bit 1 = EAPD, bit 2 =
// L-R swap), POWER_STATE takes ONE nibble (D0..D3cold), GET forms take
// no payload at all. A helper that took a raw "verb payload u16" for a
// GET_PIN_WIDGET_CTL call would let a caller submit a payload the
// register does not read -- exactly the confusion the per-verb wrappers
// exist to remove.
//
// TWO VERB WIRE FORMATS EXIST (Intel HDA §7.3.3):
//
//   * LONG form  -- 12-bit verb id + 8-bit payload. Codec_discovery.pdx
//                   §1's `hda_codec_verb_encode` implements this form.
//                   All 0xF00-block GET verbs and all 0x7XX SET verbs
//                   use this form.
//
//   * SHORT form -- 4-bit verb id + 16-bit payload. Verbs 0x0..0xF
//                   with the small ids use this form. SET_AMP_GAIN_MUTE
//                   (verb id 0x3) is the one this module needs.
//
// This module adds `hda_verb_pack_short` and a dispatch helper that
// choose between the two encoders per call. Widening `hda_codec_verb_encode`
// to fold the two would let a caller submit a 12-bit-verb payload
// that landed in a 16-bit-payload slot on the wire; the two encoders
// stay separate for the same reason `hda_reset_arm` and
// `hda_controller_write` stay separate.
//
// =============================================================================
// §1  VERB IDS ARE FIXED, NOT NEGOTIATED
// =============================================================================
//
// Per Intel HDA §7.3.3 the standard verb ids this module handles:
//
//   GET_PIN_WIDGET_CTL       = 0xF07   (long,  payload=0)
//   SET_PIN_WIDGET_CTL       = 0x707   (long,  payload=u8)
//   GET_EAPD_BTL_ENABLE      = 0xF0C   (long,  payload=0)
//   SET_EAPD_BTL_ENABLE      = 0x70C   (long,  payload=u8)
//   GET_POWER_STATE          = 0xF05   (long,  payload=0)
//   SET_POWER_STATE          = 0x705   (long,  payload=u4 D-state)
//   GET_AMP_GAIN_MUTE        = 0xB00   (long,  payload=u8 selector)
//   SET_AMP_GAIN_MUTE_SHORT  = 0x3     (SHORT, payload=u16)
//
// GET_AMP_GAIN_MUTE's payload selects direction, side and index (per
// HDA §7.3.3.7 bits: [15]=output/input, [13]=left/right, [3:0]=index).
// SET_AMP_GAIN_MUTE's payload writes the amp mute+gain (bits: [15]=set-
// output, [14]=set-input, [13]=set-left, [12]=set-right, [11:8]=index,
// [7]=mute, [6:0]=gain). Both take their payload with no clamping;
// the helper refuses widths above the field width and accepts every
// bit pattern within it (a caller that wants to clear mute AND set
// gain to 0 submits payload = 0, which is legal).
//
// =============================================================================
// §2  ONE READER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_verb_stats` to
// this object. Counters are the only evidence that a verb helper ran
// and what it observed; a second writer would let another module
// invent verb sends the codec never received.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr >= 16 -> BAD_ADDR (refused, not truncated -- the encoder
//   in codec_discovery.pdx §1 refuses the same value, and the two
//   agree deliberately).
// node_id >= 256 -> BAD_NODE.
// Payload wider than the verb's field width -> BAD_PAYLOAD.
// CORB / RIRB not bound -> NOT_READY (via hda_codec_get_parameter's
//   own gate; we let the underlying scaffold do the gate rather than
//   duplicating it and risking drift).
// Happy path -> DEFERRED_HARDWARE (no real MMIO or response read).
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL VERB TRANSPORT. Every send routes through
//     hda_corb_submit + hda_rirb_consume, both scaffolds that return
//     DEFERRED_HARDWARE without touching a ring.
//   * NO RESPONSE INSPECTION. GET helpers submit the verb and advance
//     the RIRB solicited counter; they do not read the response byte.
//     A live path would read the reply out of the RIRB DMA area and
//     return it to the caller.
//   * NO ARBITRATION. Same shape as the other R33.M2 scaffolds:
//     `hda_verb_arbitrated() == 0` is pinned at 0 by the boot witness.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCB0..0xFFFFFCBF
// =============================================================================

module Verbs = structure {

  // ==========================================================================
  // §1 verb id constants.
  // ==========================================================================

  pub let HDA_VERB_GET_PIN_CTL      : u64 = 0xF07
  pub let HDA_VERB_SET_PIN_CTL      : u64 = 0x707
  pub let HDA_VERB_GET_EAPD         : u64 = 0xF0C
  pub let HDA_VERB_SET_EAPD         : u64 = 0x70C
  pub let HDA_VERB_GET_POWER_STATE  : u64 = 0xF05
  pub let HDA_VERB_SET_POWER_STATE  : u64 = 0x705
  pub let HDA_VERB_GET_AMP_GAIN     : u64 = 0xB00
  pub let HDA_VERB_SET_AMP_GAIN_ID4 : u64 = 0x3      // SHORT-form verb id

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_VERB_OK                 : u64 = 0
  pub let HDA_VERB_NOT_READY          : u64 = 0xFFFFFCBF
  pub let HDA_VERB_BAD_ADDR           : u64 = 0xFFFFFCBE
  pub let HDA_VERB_BAD_NODE           : u64 = 0xFFFFFCBD
  pub let HDA_VERB_BAD_PAYLOAD        : u64 = 0xFFFFFCBC
  pub let HDA_VERB_DEFERRED_HARDWARE  : u64 = 0xFFFFFCBB

  pub let HDA_VERB_ENCODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Stats. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_verb_stats : [u64; 16] = uninit @align(64)

  pub let HDA_VERB_ST_SENDS_LONG   : u64 = 0
  pub let HDA_VERB_ST_SENDS_SHORT  : u64 = 1
  pub let HDA_VERB_ST_BAD_ADDR     : u64 = 2
  pub let HDA_VERB_ST_BAD_NODE     : u64 = 3
  pub let HDA_VERB_ST_BAD_PAYLOAD  : u64 = 4
  pub let HDA_VERB_ST_NOT_READY    : u64 = 5
  pub let HDA_VERB_ST_GET_PIN_CTL  : u64 = 6
  pub let HDA_VERB_ST_SET_PIN_CTL  : u64 = 7
  pub let HDA_VERB_ST_GET_EAPD     : u64 = 8
  pub let HDA_VERB_ST_SET_EAPD     : u64 = 9
  pub let HDA_VERB_ST_GET_POWER    : u64 = 10
  pub let HDA_VERB_ST_SET_POWER    : u64 = 11
  pub let HDA_VERB_ST_GET_AMP      : u64 = 12
  pub let HDA_VERB_ST_SET_AMP      : u64 = 13

  // ==========================================================================
  // hda_verb_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same shape as the other HDA scaffold pins.
  // ==========================================================================

  pub let hda_verb_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-004 (#1145): report whether the verb helpers issue real MMIO or read real responses today. IT RETURNS 0 -- every helper delegates the wire transport to hda_corb_submit and hda_rirb_consume, both scaffolds. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_verb_pack_short(codec_addr, node_id, verb4, payload16) -> u64 | BAD
  //
  // Pack a SHORT-form verb (4-bit verb id + 16-bit payload).
  //
  //   [31:28]  codec_addr
  //   [27:20]  node_id
  //   [19:16]  verb4
  //   [15:0]   payload16
  //
  // Kept SEPARATE from hda_codec_verb_encode (long form) so a widened
  // encoder cannot silently place a 16-bit payload where an 8-bit
  // register expects it, or vice versa.
  // ==========================================================================

  pub let hda_verb_pack_short : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (codec_addr: u64, node_id: u64, verb4: u64, payload16: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M2-004 (#1145): pack a SHORT-form 32-bit codec verb. Gates: (1) codec_addr < 16, (2) node_id < 256, (3) verb4 < 16 (4-bit field), (4) payload16 < 65536 (16-bit field). Any refusal -> ENCODE_BAD. Pack: (codec_addr << 28) | (node_id << 20) | (verb4 << 16) | payload16. Kept separate from hda_codec_verb_encode so a widened encoder cannot let a caller stuff bits into the wrong field. Pure leaf. Labels prefixed hv_ps_.",
      block: {
        // (1) codec_addr < 16
        cmp rdi, 16;
        jae hv_ps_bad;
        // (2) node_id < 256
        mov r10, 256;
        cmp rsi, r10;
        jae hv_ps_bad;
        // (3) verb4 < 16
        cmp rdx, 16;
        jae hv_ps_bad;
        // (4) payload16 < 65536
        mov r10, 65536;
        cmp rcx, r10;
        jae hv_ps_bad;

        mov rax, rdi;
        shl rax, 28;
        mov r10, rsi;
        shl r10, 20;
        or  rax, r10;
        mov r10, rdx;
        shl r10, 16;
        or  rax, r10;
        or  rax, rcx;
        ret;

      hv_ps_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_verb_send_long(codec_addr, node_id, verb12, payload8) -> code
  //
  // Route a LONG-form verb through the codec_discovery scaffold's
  // submit path. Gates on CORB/RIRB bound state via the underlying
  // hda_codec_get_parameter's returned code; a NOT_READY or a BAD_*
  // is propagated. On success returns DEFERRED_HARDWARE.
  //
  // Rather than duplicate hda_codec_get_parameter's gates, we call
  // it: verb 0xF00 (GET_PARAMETER) is the same shape as any other
  // long-form GET, so calling it with a different verb id would put
  // a payload in the wrong slot. Instead we encode our own verb and
  // submit via hda_corb_submit directly, then advance RIRB.
  // ==========================================================================

  pub let hda_verb_send_long : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, verb12: u64, payload8: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): send a LONG-form verb through the scaffold transport. Gates in order: (1) CORB and RIRB bound else NOT_READY. (2) codec_addr < 16 else BAD_ADDR. (3) node_id < 256 else BAD_NODE. (4) payload8 < 256 else BAD_PAYLOAD -- the LONG-form field is 8 bits, and refusing here (rather than at hda_codec_verb_encode's 12-bit gate) is what pins THIS module's payload contract at 8 bits regardless of what the underlying encoder currently accepts. (5) encode via hda_codec_verb_encode (verb id 12-bit, payload 12-bit slot -- we only use the low 8). (6) submit via hda_corb_submit. (7) advance RIRB solicited via hda_rirb_consume(0). (8) bump SENDS_LONG. Returns DEFERRED_HARDWARE. Six pushes keep rsp%16 == 0 at every nested call. Labels prefixed hv_sl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr
        mov r13, rsi;                    // node_id
        mov r14, rdx;                    // verb12
        mov r15, rcx;                    // payload8

        // (1) CORB and RIRB bound.
        call hda_corb_bound;
        cmp rax, 0;
        je  hv_sl_not_ready;
        call hda_rirb_bound;
        cmp rax, 0;
        je  hv_sl_not_ready;

        // (2) codec_addr < 16
        cmp r12, 16;
        jae hv_sl_bad_addr;

        // (3) node_id < 256
        mov r10, 256;
        cmp r13, r10;
        jae hv_sl_bad_node;

        // (4) payload8 < 256
        mov r10, 256;
        cmp r15, r10;
        jae hv_sl_bad_payload;

        // (5) encode via hda_codec_verb_encode.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call hda_codec_verb_encode;
        // (encoder cannot return BAD here: all four fields validated.)

        // (6) submit.
        mov rdi, rax;
        call hda_corb_submit;

        // (7) advance RIRB solicited.
        xor rdi, rdi;                    // HDA_RIRB_KIND_SOLICITED
        call hda_rirb_consume;

        // (8) count and return.
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 0];              // ST_SENDS_LONG
        add rax, 1;
        mov [r10 + 0], rax;

        mov rax, 0xFFFFFCBB;             // DEFERRED_HARDWARE
        jmp hv_sl_out;

      hv_sl_not_ready:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 40];             // ST_NOT_READY
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFCBF;
        jmp hv_sl_out;
      hv_sl_bad_addr:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFCBE;
        jmp hv_sl_out;
      hv_sl_bad_node:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFCBD;
        jmp hv_sl_out;
      hv_sl_bad_payload:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFCBC;

      hv_sl_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_verb_send_short(codec_addr, node_id, verb4, payload16) -> code
  //
  // Route a SHORT-form verb. Same gates as hda_verb_send_long except
  // the payload gate is 16 bits and the encoder is hda_verb_pack_short.
  // ==========================================================================

  pub let hda_verb_send_short : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, verb4: u64, payload16: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): send a SHORT-form verb through the scaffold transport. Gates: (1) CORB and RIRB bound else NOT_READY. (2) codec_addr < 16 else BAD_ADDR. (3) node_id < 256 else BAD_NODE. (4) payload16 < 65536 else BAD_PAYLOAD. (5) pack via hda_verb_pack_short. (6) submit via hda_corb_submit. (7) advance RIRB. (8) bump SENDS_SHORT. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed hv_ss_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        // (1) bound
        call hda_corb_bound;
        cmp rax, 0;
        je  hv_ss_not_ready;
        call hda_rirb_bound;
        cmp rax, 0;
        je  hv_ss_not_ready;

        // (2) codec_addr < 16
        cmp r12, 16;
        jae hv_ss_bad_addr;

        // (3) node_id < 256
        mov r10, 256;
        cmp r13, r10;
        jae hv_ss_bad_node;

        // (4) payload16 < 65536
        mov r10, 65536;
        cmp r15, r10;
        jae hv_ss_bad_payload;

        // (5) pack SHORT.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call hda_verb_pack_short;

        // (6) submit.
        mov rdi, rax;
        call hda_corb_submit;

        // (7) advance RIRB.
        xor rdi, rdi;
        call hda_rirb_consume;

        // (8) count.
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 8];              // ST_SENDS_SHORT
        add rax, 1;
        mov [r10 + 8], rax;

        mov rax, 0xFFFFFCBB;
        jmp hv_ss_out;

      hv_ss_not_ready:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFCBF;
        jmp hv_ss_out;
      hv_ss_bad_addr:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFCBE;
        jmp hv_ss_out;
      hv_ss_bad_node:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFCBD;
        jmp hv_ss_out;
      hv_ss_bad_payload:
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFCBC;

      hv_ss_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Per-verb GET / SET wrappers. Arity fixed per verb.
  //
  // Each wrapper: (a) validates the payload's SPECIFIC width for its
  // verb (§1), (b) delegates to send_long or send_short, (c) bumps
  // its per-verb counter on the happy path.
  // ==========================================================================

  // ---- PIN_WIDGET_CTL --------------------------------------------------

  pub let hda_verb_get_pin_ctl : (u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): GET_PIN_WIDGET_CTL (verb 0xF07). Arity TWO -- the GET carries no payload. Delegates to hda_verb_send_long with payload=0. Bumps ST_GET_PIN_CTL on DEFERRED_HARDWARE outcome. Labels prefixed hv_gp_.",
      block: {
        push rbp;

        mov rdx, 0xF07;
        xor rcx, rcx;
        call hda_verb_send_long;

        // If DEFERRED_HARDWARE, bump per-verb counter.
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_gp_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 48];             // ST_GET_PIN_CTL
        add r11, 1;
        mov [r10 + 48], r11;
        mov rax, 0xFFFFFCBB;

      hv_gp_out:
        pop rbp;
        ret
      }
    }

  pub let hda_verb_set_pin_ctl : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, ctl: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): SET_PIN_WIDGET_CTL (verb 0x707). Arity THREE. ctl is the u8 pin control byte (bit 5=out_enable, bit 6=hp_enable, bit 7=in_enable; bits [4:0] = VRef select). No enumeration gate here -- the register accepts any of the 256 bit patterns and imposes its own consistency at read; the helper's job is width, not policy. Delegates to hda_verb_send_long with verb 0x707. Bumps ST_SET_PIN_CTL on DEFERRED_HARDWARE. Labels prefixed hv_sp_.",
      block: {
        push rbp;

        mov r8, rdx;                     // save ctl
        mov rdx, 0x707;
        mov rcx, r8;
        call hda_verb_send_long;

        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_sp_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 56];             // ST_SET_PIN_CTL
        add r11, 1;
        mov [r10 + 56], r11;
        mov rax, 0xFFFFFCBB;

      hv_sp_out:
        pop rbp;
        ret
      }
    }

  // ---- EAPD_BTL_ENABLE ------------------------------------------------

  pub let hda_verb_get_eapd : (u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): GET_EAPD_BTL_ENABLE (verb 0xF0C). Arity TWO. Delegates. Bumps ST_GET_EAPD. Labels prefixed hv_ge_.",
      block: {
        push rbp;

        mov rdx, 0xF0C;
        xor rcx, rcx;
        call hda_verb_send_long;

        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_ge_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 64];             // ST_GET_EAPD
        add r11, 1;
        mov [r10 + 64], r11;
        mov rax, 0xFFFFFCBB;

      hv_ge_out:
        pop rbp;
        ret
      }
    }

  pub let hda_verb_set_eapd : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, bits: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): SET_EAPD_BTL_ENABLE (verb 0x70C). Arity THREE. bits is a u8 (bit 0=BTL, bit 1=EAPD, bit 2=L-R swap). Delegates. Bumps ST_SET_EAPD. Labels prefixed hv_se_.",
      block: {
        push rbp;

        mov r8, rdx;                     // save bits
        mov rdx, 0x70C;
        mov rcx, r8;
        call hda_verb_send_long;

        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_se_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 72];             // ST_SET_EAPD
        add r11, 1;
        mov [r10 + 72], r11;
        mov rax, 0xFFFFFCBB;

      hv_se_out:
        pop rbp;
        ret
      }
    }

  // ---- POWER_STATE ---------------------------------------------------

  pub let hda_verb_get_power_state : (u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): GET_POWER_STATE (verb 0xF05). Arity TWO. Delegates. Bumps ST_GET_POWER. Labels prefixed hv_gw_.",
      block: {
        push rbp;

        mov rdx, 0xF05;
        xor rcx, rcx;
        call hda_verb_send_long;

        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_gw_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 80];             // ST_GET_POWER
        add r11, 1;
        mov [r10 + 80], r11;
        mov rax, 0xFFFFFCBB;

      hv_gw_out:
        pop rbp;
        ret
      }
    }

  pub let hda_verb_set_power_state : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, dstate: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): SET_POWER_STATE (verb 0x705). Arity THREE. dstate is a u4 D-state (0=D0, 1=D1, 2=D2, 3=D3hot, 4=D3cold). Gate: dstate < 16 else BAD_PAYLOAD (checked at hda_verb_send_long's 8-bit gate; a stricter <=4 gate would refuse D-states a future spec adds without a name change here). Delegates. Bumps ST_SET_POWER. Labels prefixed hv_sw_.",
      block: {
        push rbp;

        mov r8, rdx;                     // save dstate
        mov rdx, 0x705;
        mov rcx, r8;
        call hda_verb_send_long;

        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_sw_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 88];             // ST_SET_POWER
        add r11, 1;
        mov [r10 + 88], r11;
        mov rax, 0xFFFFFCBB;

      hv_sw_out:
        pop rbp;
        ret
      }
    }

  // ---- AMP_GAIN_MUTE -----------------------------------------------

  pub let hda_verb_get_amp_gain : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, selector: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): GET_AMP_GAIN_MUTE (verb 0xB00). Arity THREE. selector is a u8 (bit 15 is output/input, bit 13 is left/right, bits [3:0] index). This helper delegates to send_long with payload=selector, and does NOT re-validate the selector's internal layout -- a caller that supplies a legal bit pattern with a nonsensical field combination still gets a real codec reply (the codec's own response codes say 'unsupported'). The width gate (selector < 256) is what send_long enforces. Bumps ST_GET_AMP. Labels prefixed hv_ga_.",
      block: {
        push rbp;

        mov r8, rdx;                     // save selector
        mov rdx, 0xB00;
        mov rcx, r8;
        call hda_verb_send_long;

        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_ga_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 96];             // ST_GET_AMP
        add r11, 1;
        mov [r10 + 96], r11;
        mov rax, 0xFFFFFCBB;

      hv_ga_out:
        pop rbp;
        ret
      }
    }

  pub let hda_verb_set_amp_gain : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64, node_id: u64, payload16: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): SET_AMP_GAIN_MUTE (SHORT-form verb id 0x3). Arity THREE. payload16 is the full 16-bit register write per HDA §7.3.3.7 (bit 15=set-out, bit 14=set-in, bit 13=set-left, bit 12=set-right, bits [11:8]=index, bit 7=mute, bits [6:0]=gain). Routed through hda_verb_send_short because the 16-bit payload does not fit LONG form. Bumps ST_SET_AMP on DEFERRED_HARDWARE. Labels prefixed hv_sa_.",
      block: {
        push rbp;

        mov r8, rdx;                     // save payload
        mov rdx, 0x3;                    // SHORT verb id
        mov rcx, r8;
        call hda_verb_send_short;

        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hv_sa_out;
        lea r10, [rip + _hda_verb_stats];
        mov r11, [r10 + 104];            // ST_SET_AMP
        add r11, 1;
        mov [r10 + 104], r11;
        mov rax, 0xFFFFFCBB;

      hv_sa_out:
        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // hda_verb_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_verb_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M2-004 (#1145): bounds-checked read of one verb counter. Out of range returns 0. Leaf. Labels prefixed hv_st_.",
      block: {
        cmp rdi, 16;
        jae hv_st_zero;
        lea r10, [rip + _hda_verb_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hv_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame
}
