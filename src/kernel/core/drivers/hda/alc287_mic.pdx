// src/kernel/core/drivers/hda/alc287_mic.pdx -- R33.M4-003 (#1154)
//
// The Realtek ALC287 MICROPHONE input path setup, covering both the
// INTERNAL mic array (T14 G4 has two dual-mems arrays for beamforming)
// and the EXTERNAL mic on the headset combo jack. SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE MIC PATH BINDER for the ALC287 codec on the T14 G4:
//
//   * Pin 0x12 = internal mic array (DMIC-shaped analog; VREF-driven)
//   * Pin 0x19 = external headset mic (combo jack; VREF 80% for TRRS)
//   * Node 0x23 = mic input selector (chooses which pin drives the ADC)
//
// The path binder puts each pin into IN direction with the correct
// VREF, and initialises the ADC amp gain to a mid-scale value (0x17,
// ~+18 dB on the ALC287 mic preamp curve). A live driver would probe
// the pin cap's supported VREF set and negotiate; this scaffold uses
// the datasheet-recommended default per pin.
//
// The SELECT seam flips the internal selector (node 0x23) between the
// internal and external mic inputs. On the ALC287, the mic ADC sees
// exactly one of the two pins at a time; a policy layer chooses
// (headset present -> external; otherwise internal beamforming).
//
// IT IS NOT A LIVE PATH. Same discipline as the other R33 scaffolds:
// the pin `hda_alc287_mic_arbitrated() == 0` -- an assertion that
// FAILS the moment a future milestone plumbs real MMIO through the
// underlying CORB/RIRB path -- forces the design doc to be updated at
// that time.
//
// NOISE-CANCELLATION STUB. Issue #1154 asks for a noise-cancellation
// stub. This module DECLARES `hda_alc287_mic_nc_enable`, which counts
// its call and pins arbitrated=0; it does NOT program the ALC287
// beamforming coefficients today, because the beamforming coefficients
// depend on the sample-rate-locked audio timeline the compositor uses
// (KIND_AUDIO_CLOCK, R33.M3), and the compositor is not up yet. The
// stub records the intent; the flip goes to the boot witness the
// moment the coefficients are wired.
//
// =============================================================================
// §1  VERB SEQUENCES ARE FIXED, NOT NEGOTIATED
// =============================================================================
//
// bind():
//   SET_PIN_WIDGET_CTL(IMIC_NID=0x12, 0x24)    -- IN (bit 5) + VREF 80% (0x04)
//   SET_PIN_WIDGET_CTL(EMIC_NID=0x19, 0x24)    -- IN + VREF 80% (TRRS mic bias)
//   SET_AMP_GAIN_MUTE(ADC_NID=0x08, 0x7017)    -- set input L+R, index 0,
//                                                  gain 0x17 (~+18 dB), no mute
//
// The AMP_GAIN_MUTE payload:
//   [15]=set-out=0, [14]=set-in=1, [13]=set-left=1, [12]=set-right=1,
//   [11:8]=index=0, [7]=mute=0, [6:0]=gain=0x17.
//   So 0x7017 = 0111_0000_0001_0111 = set-in + L + R + gain 0x17.
//
// select(internal):
//   SET_CONNECTION_SELECT(SEL_NID=0x23, 0x00)  -- selector input 0 = internal
//
// select(external):
//   SET_CONNECTION_SELECT(SEL_NID=0x23, 0x01)  -- selector input 1 = external
//
// SET_CONNECTION_SELECT is verb 0x701 (LONG, 8-bit payload). Since
// verbs.pdx does not currently expose a get/set wrapper for it, this
// module drives it through hda_verb_send_long directly.
//
// =============================================================================
// §2  ONE READER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_alc287_mic_stats`
// to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr >= 16                       -> BAD_ADDR
// bind() before init                     -> NOT_INIT
// select() before bind                   -> NOT_BOUND
// nc_enable() before bind                -> NOT_BOUND
// which not in {INTERNAL, EXTERNAL}      -> BAD_WHICH
// Any verb send not DEFERRED_HARDWARE    -> VERB_FAIL
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL VERB TRANSPORT.
//   * NO BEAMFORMING COEFFICIENTS. See nc_enable stub above.
//   * NO PIN-CAP INTROSPECTION. VREF is hardcoded at 80% per datasheet.
//   * NO INPUT-AMP CURVE READ. Gain 0x17 chosen from datasheet mid-scale.
//   * NO ARBITRATION.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCE0..0xFFFFFCEF
// =============================================================================

module Alc287Mic = structure {

  // ==========================================================================
  // §1 constants.
  // ==========================================================================

  pub let HDA_ALC287_IMIC_NID       : u64 = 0x12
  pub let HDA_ALC287_EMIC_NID       : u64 = 0x19
  pub let HDA_ALC287_MIC_ADC_NID    : u64 = 0x08
  pub let HDA_ALC287_MIC_SEL_NID    : u64 = 0x23

  pub let HDA_ALC287_PIN_CTL_IN_V80 : u64 = 0x24  // IN + VREF 80%
  pub let HDA_ALC287_MIC_GAIN_MID   : u64 = 0x7017
  pub let HDA_ALC287_VERB_SET_CONN  : u64 = 0x701

  // Selector inputs.
  pub let HDA_ALC287_MIC_INTERNAL   : u64 = 0
  pub let HDA_ALC287_MIC_EXTERNAL   : u64 = 1

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_ALC287_MC_OK          : u64 = 0
  pub let HDA_ALC287_MC_BAD_ADDR    : u64 = 0xFFFFFCEF
  pub let HDA_ALC287_MC_NOT_INIT    : u64 = 0xFFFFFCEE
  pub let HDA_ALC287_MC_NOT_BOUND   : u64 = 0xFFFFFCED
  pub let HDA_ALC287_MC_BAD_WHICH   : u64 = 0xFFFFFCEC
  pub let HDA_ALC287_MC_VERB_FAIL   : u64 = 0xFFFFFCEB

  // ==========================================================================
  // State.
  //
  // Slots:
  //   [0] ST_BINDS
  //   [1] ST_SELECTS_INT
  //   [2] ST_SELECTS_EXT
  //   [3] ST_NC_CALLS
  //   [4] ST_BAD_ADDR
  //   [5] ST_NOT_INIT
  //   [6] ST_NOT_BOUND
  //   [7] ST_BAD_WHICH
  //   [8] ST_VERB_FAIL
  //   [9] ST_BOUND       -- latch (codec+1 or 0)
  //  [10] ST_ACTIVE      -- last-selected input (INTERNAL/EXTERNAL); 0 by default
  //  [11] ST_NC_ENABLED  -- 0 or 1
  // ==========================================================================

  pub let mut _hda_alc287_mic_stats : [u64; 16] = uninit @align(64)

  pub let HDA_ALC287_MC_ST_BINDS       : u64 = 0
  pub let HDA_ALC287_MC_ST_SEL_INT     : u64 = 1
  pub let HDA_ALC287_MC_ST_SEL_EXT     : u64 = 2
  pub let HDA_ALC287_MC_ST_NC_CALLS    : u64 = 3
  pub let HDA_ALC287_MC_ST_BAD_ADDR    : u64 = 4
  pub let HDA_ALC287_MC_ST_NOT_INIT    : u64 = 5
  pub let HDA_ALC287_MC_ST_NOT_BOUND   : u64 = 6
  pub let HDA_ALC287_MC_ST_BAD_WHICH   : u64 = 7
  pub let HDA_ALC287_MC_ST_VERB_FAIL   : u64 = 8
  pub let HDA_ALC287_MC_ST_BOUND       : u64 = 9
  pub let HDA_ALC287_MC_ST_ACTIVE      : u64 = 10
  pub let HDA_ALC287_MC_ST_NC_ENABLED  : u64 = 11

  // ==========================================================================
  // hda_alc287_mic_arbitrated() -> 0
  // ==========================================================================

  pub let hda_alc287_mic_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M4-003 (#1154): report whether the mic path issues real MMIO today. IT RETURNS 0 -- every verb routes through hda_verb_send_* scaffolds. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_mic_bound() -> 0 | codec+1
  // ==========================================================================

  pub let hda_alc287_mic_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-003 (#1154): read the mic bind latch. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 72];             // slot 9
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_mic_bind(codec_addr) -> code
  //
  // ARITY ONE. Emits the three verbs of §1 bind(). Refuses if init has
  // not run for this codec.
  // ==========================================================================

  pub let hda_alc287_mic_bind : (u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-003 (#1154): bind the mic path on codec_addr. Gates: (1) codec_addr < 16 else BAD_ADDR. (2) hda_alc287_init_bound reports codec+1 else NOT_INIT (VREF bias on an unpowered analog pin is undefined). Verbs in §1 order: SET_PIN_WIDGET_CTL(IMIC, 0x24), SET_PIN_WIDGET_CTL(EMIC, 0x24), SET_AMP_GAIN_MUTE(ADC, 0x7017). On any non-DEFERRED return, ST_VERB_FAIL. On success, bump ST_BINDS and stamp latch codec+1. Six pushes leave rsp%16 == 0. Labels prefixed hmc_bd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr

        // (1) codec_addr < 16
        cmp r12, 16;
        jae hmc_bd_bad_addr;

        // (2) init bound for this codec?
        call hda_alc287_init_bound;
        mov r13, r12;
        add r13, 1;
        cmp rax, r13;
        jne hmc_bd_not_init;

        // (SET_PIN_WIDGET_CTL IMIC, 0x24)
        mov rdi, r12;
        mov rsi, 0x12;
        mov rdx, 0x24;
        call hda_verb_set_pin_ctl;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hmc_bd_verb_fail;

        // (SET_PIN_WIDGET_CTL EMIC, 0x24)
        mov rdi, r12;
        mov rsi, 0x19;
        mov rdx, 0x24;
        call hda_verb_set_pin_ctl;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hmc_bd_verb_fail;

        // (SET_AMP_GAIN_MUTE ADC, 0x7017)
        mov rdi, r12;
        mov rsi, 0x08;
        mov rdx, 0x7017;
        call hda_verb_set_amp_gain;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hmc_bd_verb_fail;

        // Success.
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        mov rax, r12;
        add rax, 1;
        mov [r10 + 72], rax;             // latch codec+1

        xor rax, rax;
        jmp hmc_bd_out;

      hmc_bd_bad_addr:
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFCEF;
        jmp hmc_bd_out;
      hmc_bd_not_init:
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFCEE;
        jmp hmc_bd_out;
      hmc_bd_verb_fail:
        lea r10, [rip + _hda_alc287_mic_stats];
        mov r11, [r10 + 64];
        add r11, 1;
        mov [r10 + 64], r11;
        mov rax, 0xFFFFFCEB;

      hmc_bd_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_mic_select(which) -> code
  //
  // ARITY ONE. which is INTERNAL (0) or EXTERNAL (1); refused
  // otherwise. Emits SET_CONNECTION_SELECT to node 0x23 with the
  // selector input index that matches.
  // ==========================================================================

  pub let hda_alc287_mic_select : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-003 (#1154): select which mic drives the ADC. Gates: (1) bind latch non-zero else NOT_BOUND. (2) which in {INTERNAL=0, EXTERNAL=1} else BAD_WHICH (refused, not masked; a policy that meant 'external' but supplied 5 must fail rather than silently select input 5 -- which does not exist on ALC287 -- and read silence). Reads codec_addr = latch - 1. Dispatches SET_CONNECTION_SELECT (verb 0x701) via hda_verb_send_long with payload = which. On success bump the corresponding ST_SELECTS_INT/ST_SELECTS_EXT counter and stamp ST_ACTIVE. Six pushes leave rsp%16 == 0. Labels prefixed hmc_se_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // which

        // (1) bound?
        call hda_alc287_mic_bound;
        cmp rax, 0;
        je  hmc_se_not_bound;
        sub rax, 1;
        mov r13, rax;                    // codec_addr

        // (2) which in {0, 1}
        cmp r12, 1;
        ja  hmc_se_bad_which;

        // Dispatch SET_CONNECTION_SELECT(node 0x23, payload = which).
        mov rdi, r13;                    // codec_addr
        mov rsi, 0x23;                   // MIC_SEL_NID
        mov rdx, 0x701;                  // verb id
        mov rcx, r12;                    // payload
        call hda_verb_send_long;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hmc_se_verb_fail;

        // Bump the right selector counter.
        lea r10, [rip + _hda_alc287_mic_stats];
        cmp r12, 0;
        jne hmc_se_ext;
        mov rax, [r10 + 8];              // ST_SEL_INT
        add rax, 1;
        mov [r10 + 8], rax;
        jmp hmc_se_stamp;
      hmc_se_ext:
        mov rax, [r10 + 16];             // ST_SEL_EXT
        add rax, 1;
        mov [r10 + 16], rax;

      hmc_se_stamp:
        mov [r10 + 80], r12;             // ST_ACTIVE
        xor rax, rax;
        jmp hmc_se_out;

      hmc_se_not_bound:
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFCED;
        jmp hmc_se_out;
      hmc_se_bad_which:
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;
        mov rax, 0xFFFFFCEC;
        jmp hmc_se_out;
      hmc_se_verb_fail:
        lea r10, [rip + _hda_alc287_mic_stats];
        mov r11, [r10 + 64];
        add r11, 1;
        mov [r10 + 64], r11;
        mov rax, 0xFFFFFCEB;

      hmc_se_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_mic_nc_enable() -> code
  //
  // ARITY ZERO. Beamforming/noise-cancellation stub. Records intent by
  // bumping ST_NC_CALLS and stamping ST_NC_ENABLED=1; does NOT program
  // any coefficient. Deferred to a later milestone that has KIND_AUDIO_
  // CLOCK sample-rate context bound (§0 noise-cancellation stub).
  // ==========================================================================

  pub let hda_alc287_mic_nc_enable : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-003 (#1154): noise-cancellation intent stub. Gate: bind latch non-zero else NOT_BOUND (a noise-cancellation call before the mic pins are configured names nothing). No verbs emitted -- the ALC287 beamforming coefficients depend on the sample-rate context from KIND_AUDIO_CLOCK which is not up in this scaffold. Records the intent by bumping ST_NC_CALLS and stamping ST_NC_ENABLED=1. Leaf. Labels prefixed hmc_nc_.",
      block: {
        push rbp;

        call hda_alc287_mic_bound;
        cmp rax, 0;
        je  hmc_nc_not_bound;

        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 1;
        mov [r10 + 88], rax;             // ST_NC_ENABLED

        xor rax, rax;
        jmp hmc_nc_out;

      hmc_nc_not_bound:
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFCED;

      hmc_nc_out:
        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_mic_reset() -> ()
  // ==========================================================================

  pub let hda_alc287_mic_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-003 (#1154): clear the bind latch and nc-enabled cell. Cumulative counters preserved. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_mic_stats];
        xor rax, rax;
        mov [r10 + 72], rax;             // latch
        mov [r10 + 88], rax;             // nc enabled
        ret
      }
    } @no_frame

  // ==========================================================================
  // hda_alc287_mic_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_alc287_mic_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-003 (#1154): bounds-checked read of one mic counter. Out of range returns 0. Leaf. Labels prefixed hmc_st_.",
      block: {
        cmp rdi, 16;
        jae hmc_st_zero;
        lea r10, [rip + _hda_alc287_mic_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hmc_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

}
