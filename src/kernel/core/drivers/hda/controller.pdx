// src/kernel/core/drivers/hda/controller.pdx — R33.M1-001 (#1137)
//
// The kernel-side Intel HDA (High Definition Audio) CONTROLLER PROBE +
// BAR MAPPING scaffold. SCAFFOLD.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE PCI PROBE + BAR HANDOFF for an Intel HDA / cAVS 2.5
// controller (PCI class 04:03, prog_if 0x00 - Audio Device / HD Audio
// Compatible). The controller register window sits at PCI BAR0. This
// module holds the LATCHED BAR base an eventual probe would populate,
// declares the fixed HDA register offsets consumers (reset.pdx,
// corb.pdx, rirb.pdx) address, and refuses every register-window
// operation until a bind arrives with a plausible BAR handle.
//
// IT IS NOT A LIVE PROBE. Same discipline as ec_access.pdx (#1580),
// backlight_pwm.pdx §4 and i2c_hid/transport.pdx §0: the probe frame is
// stated as a SCAFFOLD, and the pin `hda_controller_arbitrated() == 0`
// -- an assertion that FAILS the moment a future milestone plumbs
// pci_enumerate_all into hda_controller_bind -- forces the design doc
// to be updated at that time. See §4 for deferrals.
//
// IT ACCEPTS AN OPAQUE u64 BAR HANDLE. R26 (xhci) and R24 (nvme)
// landed compact 32-byte PCI device records under _pci_devices, and
// their probes (drivers/xhci/probe.pdx / drivers/nvme/probe.pdx) filter
// _pci_devices by class code and stash the BAR0 physical address into
// a matching per-driver table. R33.M1 does NOT walk _pci_devices --
// pci_enumerate_all is empty under BIOS/-kernel boot (MCFG absent), and
// the OVMF path that populates it has no consumer for the AUDIO class
// yet -- so the bind takes an OPAQUE u64: on the T14 G4 that handle
// will be a cap slot; today it is an inert sentinel the register
// accessors observe and refuse to dereference.
//
// Widening bind to receive a controller BASE and an EXTENT would let
// a caller reach any window a firmware table happens to name --
// exactly what §2 of ec_access.pdx exists to prevent. The seam is
// arity ONE (bar_handle) and stays there until R33.M2 plumbs the
// PCI probe path.
//
// =============================================================================
// §1  HDA CONTROLLER REGISTER MAP (Intel HDA §3)
// =============================================================================
//
// All offsets are byte offsets from BAR0. The controller uses a
// LITTLE-ENDIAN memory-mapped layout; the accessor discipline the
// consumers (reset.pdx, corb.pdx, rirb.pdx) use to reach these is
// standard mfence-bracketed MMIO -- but no accessor runs at M1.
//
//   0x00  u16  GCAP           - global capabilities (64OK bit 0, NSDO
//                                bits [2:1], BSS bits [7:3], ISS bits
//                                [11:8], OSS bits [15:12]).
//   0x02  u8   VMIN           - minor version.
//   0x03  u8   VMAJ           - major version (== 1 on cAVS 2.5).
//   0x04  u16  OUTPAY         - output payload capability.
//   0x06  u16  INPAY          - input payload capability.
//   0x08  u32  GCTL           - global control:
//                                bit  0  CRST (0=reset, 1=run)
//                                bit  1  FCNTRL (flush control)
//                                bit  8  UNSOL (unsolicited-response enable)
//   0x0C  u16  WAKEEN         - wake enable (per-SDIN bit).
//   0x0E  u16  WAKESTS        - wake status (write-1-clear).
//   0x20  u32  INTCTL         - interrupt control:
//                                bit 30  CIE (controller interrupt enable)
//                                bit 31  GIE (global interrupt enable)
//                                bits [29:0] SIE (stream int enables).
//   0x24  u32  INTSTS         - interrupt status.
//   0x30  u32  WALCLK         - 24 MHz wall clock (link position).
//   0x38  u32  SSYNC          - stream synchronization.
//   0x40  u32  CORBLBASE      - CORB base low  32 bits (128-B aligned).
//   0x44  u32  CORBUBASE      - CORB base high 32 bits.
//   0x48  u16  CORBWP         - CORB write pointer (SW-written).
//   0x4A  u16  CORBRP         - CORB read  pointer (HW-written; bit 15
//                                is RST, SW-set/HW-clear on reset).
//   0x4C  u8   CORBCTL        - CORB control (MEIE bit 0, RUN bit 1).
//   0x4D  u8   CORBSTS        - CORB status (CMEI bit 0, W1C).
//   0x4E  u8   CORBSIZE       - CORB size (bits [1:0] set entry count).
//   0x50  u32  RIRBLBASE      - RIRB base low  32 bits (128-B aligned).
//   0x54  u32  RIRBUBASE      - RIRB base high 32 bits.
//   0x58  u16  RIRBWP         - RIRB write pointer (bit 15 is RST).
//   0x5A  u16  RINTCNT        - response interrupt count.
//   0x5C  u8   RIRBCTL        - RIRB control (RINTCTL bit 0, RUN bit 1,
//                                RIRBOIC bit 2 - overrun int enable).
//   0x5D  u8   RIRBSTS        - RIRB status  (RINTFL bit 0, RIRBOIS bit 2).
//   0x5E  u8   RIRBSIZE       - RIRB size (bits [1:0]).
//
// The register offset constants are declared here rather than
// duplicated across reset.pdx / corb.pdx / rirb.pdx: those files
// consume the offsets by name, and a single source of truth avoids a
// divergence when an accessor's width shifts by one byte.
//
// =============================================================================
// §2  ONE WRITER OF THE BIND LATCH
// =============================================================================
//
// Same discipline as i2c_hid/transport.pdx §2: exactly one writer of
// `_hda_controller_bound`. tools/build.sh confines relocations against
// `_hda_controller_bound`, `_hda_controller_bar` and
// `_hda_controller_stats` to this object. The BAR handle is a LATCH;
// once bound it cannot be re-bound (a second bind returns REBIND). A
// future revoke path lands with the R33.M2 PCI probe integration.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Register offset outside 0..0x5F (the documented HDA register window
// this milestone tracks) -> BAD_REG (refused, not truncated).
// Read/write before bind -> NOT_BOUND. Second bind -> REBIND. Happy
// path -> DEFERRED_HARDWARE, the honest sentinel a caller that treats
// as success has invented a claim this module does not carry.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL PCI PROBE. pci_enumerate_all is empty under BIOS boot,
//     and no consumer walks _pci_devices for class 0x04 subclass 0x03
//     yet. R33.M2 wires the probe and populates _hda_controller_bar.
//
//   * NO MMIO. The register accessors return DEFERRED_HARDWARE without
//     touching the bar handle -- the handle is an inert u64 sentinel
//     at this milestone.
//
//   * NO ARBITRATION against firmware-owned HDA (SST OpRegion holders,
//     ACPI _PS0/_PS3 sequencing). Same shape as ec_access.pdx (#1580)
//     and i2c_hid/transport.pdx §4: the pin
//     `hda_controller_arbitrated() == 0` is what the boot witness
//     asserts, and the assertion fails the moment coordination lands.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFC40..0xFFFFFC4F
// =============================================================================

module Controller = structure {

  // ==========================================================================
  // §1 HDA register offsets. Consumed by hda/reset.pdx, hda/corb.pdx,
  // hda/rirb.pdx once the register accessors land.
  // ==========================================================================

  pub let HDA_REG_GCAP        : u64 = 0x00
  pub let HDA_REG_VMIN        : u64 = 0x02
  pub let HDA_REG_VMAJ        : u64 = 0x03
  pub let HDA_REG_OUTPAY      : u64 = 0x04
  pub let HDA_REG_INPAY       : u64 = 0x06
  pub let HDA_REG_GCTL        : u64 = 0x08
  pub let HDA_REG_WAKEEN      : u64 = 0x0C
  pub let HDA_REG_WAKESTS     : u64 = 0x0E
  pub let HDA_REG_INTCTL      : u64 = 0x20
  pub let HDA_REG_INTSTS      : u64 = 0x24
  pub let HDA_REG_WALCLK      : u64 = 0x30
  pub let HDA_REG_SSYNC       : u64 = 0x38
  pub let HDA_REG_CORBLBASE   : u64 = 0x40
  pub let HDA_REG_CORBUBASE   : u64 = 0x44
  pub let HDA_REG_CORBWP      : u64 = 0x48
  pub let HDA_REG_CORBRP      : u64 = 0x4A
  pub let HDA_REG_CORBCTL     : u64 = 0x4C
  pub let HDA_REG_CORBSTS     : u64 = 0x4D
  pub let HDA_REG_CORBSIZE    : u64 = 0x4E
  pub let HDA_REG_RIRBLBASE   : u64 = 0x50
  pub let HDA_REG_RIRBUBASE   : u64 = 0x54
  pub let HDA_REG_RIRBWP      : u64 = 0x58
  pub let HDA_REG_RINTCNT     : u64 = 0x5A
  pub let HDA_REG_RIRBCTL     : u64 = 0x5C
  pub let HDA_REG_RIRBSTS     : u64 = 0x5D
  pub let HDA_REG_RIRBSIZE    : u64 = 0x5E
  pub let HDA_REG_MAX_OFFSET  : u64 = 0x5F

  // GCTL bits (consumed by reset.pdx).
  pub let HDA_GCTL_CRST       : u64 = 0x00000001
  pub let HDA_GCTL_FCNTRL     : u64 = 0x00000002
  pub let HDA_GCTL_UNSOL      : u64 = 0x00000100

  // PCI class filter (consumed by the future R33.M2 probe).
  pub let HDA_PCI_CLASS_CODE  : u64 = 0x04
  pub let HDA_PCI_SUBCLASS    : u64 = 0x03
  pub let HDA_PCI_PROG_IF     : u64 = 0x00

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_CTRL_OK                 : u64 = 0
  pub let HDA_CTRL_NOT_BOUND          : u64 = 0xFFFFFC4F
  pub let HDA_CTRL_BAD_REG            : u64 = 0xFFFFFC4E
  pub let HDA_CTRL_DEFERRED_HARDWARE  : u64 = 0xFFFFFC4C
  pub let HDA_CTRL_REBIND             : u64 = 0xFFFFFC4B

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_controller_bound : u64 = 0
  pub let mut _hda_controller_bar   : u64 = 0
  pub let mut _hda_controller_stats : [u64; 8] = uninit @align(64)

  pub let HDA_CTRL_ST_BINDS     : u64 = 0
  pub let HDA_CTRL_ST_READS     : u64 = 1
  pub let HDA_CTRL_ST_WRITES    : u64 = 2
  pub let HDA_CTRL_ST_BAD_REG   : u64 = 3
  pub let HDA_CTRL_ST_NOT_BOUND : u64 = 4
  pub let HDA_CTRL_ST_REBIND    : u64 = 5
  pub let HDA_CTRL_ST_MAX       : u64 = 8

  // ==========================================================================
  // hda_controller_bind(bar_handle) -> OK | REBIND
  //
  // ARITY ONE: the opaque BAR handle (a future PCI-record slot; an
  // inert u64 today). A caller-supplied EXTENT would be a way to
  // reach registers no capability named -- exactly what §2 of
  // ec_access.pdx exists to prevent.
  // ==========================================================================

  pub let hda_controller_bind : (u64) -> u64 !{mem} @{} =
    fn (bar_handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-001 (#1137): bind the HDA controller frame to an opaque BAR handle (a future PCI-record slot). Refuses a second bind with REBIND -- the whole discipline rests on the bind being a LATCH: a stray relocation would be a second path claiming this frame is initialised to a different BAR window, and when R33.M2 plumbs pci_enumerate_all through this seam, a spuriously-set BAR would let register I/O reach a window the capability did not name. Increments _hda_controller_stats[0]. Leaf. Labels prefixed hda_ct_bd_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _hda_controller_bound];
        mov rax, [r10];
        cmp rax, 0;
        jne hda_ct_bd_rebind;

        lea r10, [rip + _hda_controller_bar];
        mov [r10], rdi;

        lea r10, [rip + _hda_controller_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // OK
        ret;

      hda_ct_bd_rebind:
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 40];             // slot 5 = REBIND
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFFC4B;             // REBIND
        ret
      }
    }

  // ==========================================================================
  // hda_controller_bound() -> 1 | 0
  // ==========================================================================

  pub let hda_controller_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-001 (#1137): 1 once hda_controller_bind has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_controller_bound];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hda_controller_bar() -> handle
  // Read-only accessor for the BAR handle latched at bind.
  // ==========================================================================

  pub let hda_controller_bar : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-001 (#1137): return the opaque BAR handle latched at bind. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_controller_bar];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // hda_controller_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as i2c_hid_transport_arbitrated,
  // ec_access_arbitrated: pinned at 0 by the boot witness so a future
  // milestone plumbing a real PCI probe + MMIO cannot land without
  // rewriting the claim.
  // ==========================================================================

  pub let hda_controller_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M1-001 (#1137): report whether the frame issues real MMIO today. IT RETURNS 0, because nothing in this tree walks _pci_devices for class 0x04 subclass 0x03 or dereferences _hda_controller_bar. The boot witness pins it at 0 for the same reason ec_access_arbitrated is pinned: a claim in a comment rots silently, a value a test asserts on does not. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_controller_read(reg_offset) -> code
  //
  // The read seam. Validates reg_offset fits 0..0x5F (the HDA register
  // window this milestone tracks), requires bind, returns
  // DEFERRED_HARDWARE on the happy path. No real MMIO runs.
  // ==========================================================================

  pub let hda_controller_read : (u64) -> u64 !{mem} @{} =
    fn (reg_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-001 (#1137): the read seam. Gates, in order: (1) reg_offset in 0..HDA_REG_MAX_OFFSET (0x5F), else BAD_REG and counted -- refused, not truncated. Register offsets are enumerated by Intel HDA §3, not negotiated at the driver, and a caller that asks for one this window does not name has invented a register the spec does not have. (2) bound, else NOT_BOUND and counted. (3) happy path returns DEFERRED_HARDWARE (honest sentinel per §3), counted. NO REAL MMIO RUNS: a live driver would bracket a mov instruction with mfence and dereference _hda_controller_bar + reg_offset, and none of that is in this milestone. Leaf. Labels prefixed hda_ct_rd_ per reserved-label discipline.",
      block: {
        // (1) reg_offset in 0..HDA_REG_MAX_OFFSET.
        mov r10, 0x5F;                   // HDA_REG_MAX_OFFSET
        cmp rdi, r10;
        ja  hda_ct_rd_bad_reg;

        // (2) bound?
        lea r10, [rip + _hda_controller_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  hda_ct_rd_not_bound;

        // (3) DEFERRED_HARDWARE.
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 8];              // slot 1 = READS
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFC4C;             // DEFERRED_HARDWARE
        ret;

      hda_ct_rd_bad_reg:
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 24];             // slot 3 = BAD_REG
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC4E;             // BAD_REG
        ret;

      hda_ct_rd_not_bound:
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 32];             // slot 4 = NOT_BOUND
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC4F;             // NOT_BOUND
        ret
      }
    }

  // ==========================================================================
  // hda_controller_write(reg_offset, value) -> code
  //
  // The write seam. Same gate order as read. No real MMIO runs.
  // ==========================================================================

  pub let hda_controller_write : (u64, u64) -> u64 !{mem} @{} =
    fn (reg_offset: u64, value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-001 (#1137): the write seam. Same gate order as read: reg_offset in 0..HDA_REG_MAX_OFFSET (BAD_REG), bound (NOT_BOUND), else DEFERRED_HARDWARE. NO REAL MMIO RUNS. The value parameter is accepted but not stored -- a live driver would bracket a mov instruction with mfence into _hda_controller_bar + reg_offset. Leaf. Labels prefixed hda_ct_wr_ per reserved-label discipline.",
      block: {
        // (1) reg_offset in 0..HDA_REG_MAX_OFFSET.
        mov r10, 0x5F;
        cmp rdi, r10;
        ja  hda_ct_wr_bad_reg;

        // (2) bound?
        lea r10, [rip + _hda_controller_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  hda_ct_wr_not_bound;

        // (3) DEFERRED_HARDWARE.
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 16];             // slot 2 = WRITES
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFC4C;             // DEFERRED_HARDWARE
        ret;

      hda_ct_wr_bad_reg:
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFC4E;             // BAD_REG
        ret;

      hda_ct_wr_not_bound:
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFC4F;             // NOT_BOUND
        ret
      }
    }

  // ==========================================================================
  // hda_controller_reads() -> count
  // hda_controller_writes() -> count
  // ==========================================================================

  pub let hda_controller_reads : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-001 (#1137): read the count of deferred-hardware outcomes on the read seam. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let hda_controller_writes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M1-001 (#1137): read the count of deferred-hardware outcomes on the write seam. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_controller_stats];
        mov rax, [r10 + 16];
        ret
      }
    }
}
