// src/kernel/core/drivers/hda/sof_verify.pdx -- R33.M6-004 (#1165)
//
// The Sound Open Firmware (SOF) SIGNATURE VERIFICATION scaffold.
// SCAFFOLD-COMPATIBLE. Implements the D1.a DUAL-SIGNATURE policy
// from design/drivers/blob-policy.md §1 for the SOF firmware blob.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE POLICY GATE that enforces D1.a on the SOF DSP firmware:
// every blob loaded by sof_loader.pdx (#1162) must carry BOTH a
// Paideia manifest signature AND a vendor (Intel/Realtek) signature,
// each verifying against the corresponding public key. The policy
// rationale is in blob-policy.md §1: neither signature alone is
// sufficient, because either root's compromise would otherwise
// collapse the guarantee into a single-sig one.
//
// This module DECLARES:
//
//   * hda_sof_verify_dual(fw_ptr, fw_len,
//                         paideia_sig, paideia_pk,
//                         vendor_sig, vendor_pk) -> DUAL verdict;
//   * the DUAL verdict enum (OK / PAIDEIA_FAIL / VENDOR_FAIL /
//     BOTH_FAIL / BAD_ARGS);
//   * hda_sof_verify_arbitrated() (returns 0 today: the underlying
//     ML-DSA-65 primitive is scaffolded per sig_verify.pdx §0);
//   * the fail-closed contract: EITHER signature failing rejects the
//     whole blob, and BOTH signatures being examined is a
//     precondition of the OK verdict.
//
// The actual signature-material check is delegated to
// driver_sig_verify_algo (src/kernel/core/driver/sig_verify.pdx).
// This module wraps it TWICE, with two DIFFERENT public keys, and
// composes the two verdicts into a single DUAL verdict.
//
// At R29 the scaffold epoch is live (driver_sig_scaffold_epoch == 1)
// and the underlying verifier's happy path returns
// SIG_UNSIGNED_SCAFFOLD (verdict 1) for a bytewise-zero signature. This
// module treats SIG_UNSIGNED_SCAFFOLD as ACCEPTABLE ONLY WHEN THE
// EPOCH FLAG IS SET, and the assembled DUAL verdict then reports
// HDA_SOF_VERIFY_DUAL_SCAFFOLD (a verdict of its own, numerically
// distinct from OK), so a caller cannot mistake a scaffold-epoch
// bypass for a real DUAL success. R32 flips the epoch to 0; on that
// day, SIG_UNSIGNED_SCAFFOLD from either arm becomes a rejection.
//
// IT IS NOT AN ML-DSA-65 LATTICE VERIFIER. That lives in
// src/kernel/core/crypto/ml_dsa/verify.pdx (R32 dependency); see
// sig_verify.pdx §0 for the explicit "no hand-rolled crypto here"
// discipline.
//
// ARITY IS SIX. A signature-length parameter is NOT passed: the SOF
// blob uses only ML-DSA-65, whose signature length (3309) is fixed
// by the algorithm and NOT negotiated at the driver.
//
// =============================================================================
// §1  DUAL VERDICT ENUM
// =============================================================================
//
//   0  HDA_SOF_VERIFY_DUAL_OK           - both signatures verified
//                                         (R32-only outcome).
//   1  HDA_SOF_VERIFY_DUAL_SCAFFOLD     - both signatures were
//                                         bytewise-zero placeholders
//                                         AND the scaffold epoch is
//                                         live. Log-and-continue at
//                                         R29; hard reject at R32.
//   0xFFFFFCA0  DUAL_PAIDEIA_FAIL       - only paideia arm failed.
//   0xFFFFFCA1  DUAL_VENDOR_FAIL        - only vendor arm failed.
//   0xFFFFFCA2  DUAL_BOTH_FAIL          - both arms failed.
//   0xFFFFFCA3  DUAL_BAD_ARGS           - a gate rejected an argument
//                                         (null, misaligned, wrong
//                                         algo) before either arm ran.
//   0xFFFFFCA4  DUAL_MIXED_SCAFFOLD     - one arm returned
//                                         SIG_UNSIGNED_SCAFFOLD and
//                                         the other returned real
//                                         verifier output. NEVER
//                                         accepted (see §0).
//
// The rejection band starts at 0xFFFFFCA0 so a DUAL verdict is
// distinguishable from any single-arm verdict at a glance (single-arm
// verdicts live in 0xFFFFFD8x).
//
// =============================================================================
// §2  ONE WRITER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_sof_verify_stats`
// to this object. The counters are the only evidence of what dual
// arms produced; a second writer would let another module invent a
// verify pass the crypto substrate never blessed.
//
// =============================================================================
// §3  FAIL-CLOSED, NEVER PARTIAL
// =============================================================================
//
// The policy is a fail-closed AND: DUAL_OK is emitted only when both
// arms produce SIG_OK (R32) or both arms produce SIG_UNSIGNED_SCAFFOLD
// (and the epoch flag is live). Every other combination is a
// rejection. In particular, a MIXED scaffold+non-scaffold answer is
// DUAL_MIXED_SCAFFOLD (never accepted), because an attacker who
// replaced the paideia signature with real bytes while leaving the
// vendor signature zero (or vice versa) would otherwise reduce the
// dual-signature guarantee to whichever arm remained scaffolded.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:crypto R32)
// =============================================================================
//
//   * NO REAL ML-DSA-65 VERIFY. Delegated to driver_sig_verify_algo,
//     which itself is a scaffold at R29 (returns SIG_UNVERIFIABLE
//     for any real signature material). Both arms therefore return
//     UNVERIFIABLE for a live signature until R32 lands the lattice
//     primitive.
//   * NO AUDIT EMIT. A live path would emit to the audit spine on
//     every verdict; that call is left to the driver-lifecycle
//     supervisor at R29.M2 (blob-policy §5).
//   * NO ARBITRATION. `hda_sof_verify_arbitrated() == 0` while the
//     scaffold epoch is live; boot witness pins the assertion.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCA0..0xFFFFFCAF
// =============================================================================

module SofVerify = structure {

  // ==========================================================================
  // §1 dual verdict constants.
  // ==========================================================================

  pub let HDA_SOF_VERIFY_DUAL_OK             : u64 = 0
  pub let HDA_SOF_VERIFY_DUAL_SCAFFOLD       : u64 = 1
  pub let HDA_SOF_VERIFY_DUAL_PAIDEIA_FAIL   : u64 = 0xFFFFFCA0
  pub let HDA_SOF_VERIFY_DUAL_VENDOR_FAIL    : u64 = 0xFFFFFCA1
  pub let HDA_SOF_VERIFY_DUAL_BOTH_FAIL      : u64 = 0xFFFFFCA2
  pub let HDA_SOF_VERIFY_DUAL_BAD_ARGS       : u64 = 0xFFFFFCA3
  pub let HDA_SOF_VERIFY_DUAL_MIXED_SCAFFOLD : u64 = 0xFFFFFCA4

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  // ==========================================================================

  pub let mut _hda_sof_verify_stats : [u64; 8] = uninit @align(64)

  // Scratch cell for the first-arm verdict across the second arm's
  // call site (both r10 and r11 are caller-save). One cell rather
  // than a callee-save register avoids widening the frame and keeps
  // the composition table below reading straight from memory.
  pub let mut _hda_sof_verify_arm_tmp : u64 = 0

  pub let HDA_SOF_VERIFY_ST_OK          : u64 = 0
  pub let HDA_SOF_VERIFY_ST_SCAFFOLD    : u64 = 1
  pub let HDA_SOF_VERIFY_ST_PAIDEIA     : u64 = 2
  pub let HDA_SOF_VERIFY_ST_VENDOR      : u64 = 3
  pub let HDA_SOF_VERIFY_ST_BOTH        : u64 = 4
  pub let HDA_SOF_VERIFY_ST_BAD_ARGS    : u64 = 5
  pub let HDA_SOF_VERIFY_ST_MIXED       : u64 = 6

  // ==========================================================================
  // hda_sof_verify_arbitrated() -> 0
  //
  // Reports whether real ML-DSA-65 lattice verification runs today.
  // Zero while sig_verify.pdx is in the scaffold epoch; flips when
  // R32 lands the lattice primitive.
  // ==========================================================================

  pub let hda_sof_verify_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M6-004 (#1165): report whether the SOF dual-sig gate runs a real lattice verifier today. IT RETURNS 0, because the underlying driver_sig_verify_algo is a structural scaffold (see sig_verify.pdx §0). Boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_verify_dual(fw_ptr, fw_len,
  //                     paideia_sig, paideia_pk,
  //                     vendor_sig, vendor_pk) -> DUAL verdict
  //
  // ARITY SIX. Wraps driver_sig_verify_algo twice (once per key). The
  // signature length is FIXED at 3309 bytes (SIG_ML_DSA_65_SIG_BYTES);
  // ptrs are the caller's responsibility.
  // ==========================================================================

  pub let hda_sof_verify_dual : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (fw_ptr: u64, fw_len: u64,
        paideia_sig: u64, paideia_pk: u64,
        vendor_sig: u64, vendor_pk: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-004 (#1165): dual-signature verification of the SOF firmware blob per D1.a. Two calls into driver_sig_verify_algo, one per key, composed by §3's fail-closed AND. On the R29 scaffold epoch: both arms returning SIG_UNSIGNED_SCAFFOLD (1) yields DUAL_SCAFFOLD (1); one arm SCAFFOLD + one arm any other output yields DUAL_MIXED_SCAFFOLD (rejection). On R32: both arms returning SIG_OK (0) yields DUAL_OK; any other pair yields a per-arm rejection code. Callee-save registers r12..r15 hold the four keyed pointers across the two nested calls; six pushes bring rsp%16 == 0 at each call site (rbx as alignment pad, then r12..r15, then rbp). Labels prefixed hsv_dv_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                        // fw_ptr
        mov r13, rsi;                        // fw_len
        mov r14, rcx;                        // paideia_pk (from arg 3)
        mov r15, r9;                         // vendor_pk (from arg 5)
        mov rbx, rdx;                        // paideia_sig (from arg 2)
        mov rbp, r8;                         // vendor_sig (from arg 4)

        // Arm 1: paideia.
        //   algo=1, artifact=(r12, r13), sig=(rbx, 3309), pk=r14.
        mov rdi, 1;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, rbx;
        mov r8, 3309;
        mov r9, r14;
        call driver_sig_verify_algo;
        lea r11, [rip + _hda_sof_verify_arm_tmp];
        mov [r11], rax;                      // stash paideia verdict

        // Arm 2: vendor.
        mov rdi, 1;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, rbp;
        mov r8, 3309;
        mov r9, r15;
        call driver_sig_verify_algo;
        mov r11, rax;                        // vendor verdict in r11
        lea r10, [rip + _hda_sof_verify_arm_tmp];
        mov r10, [r10];                      // reload paideia verdict into r10

        // Compose per §3.
        //   (r10 == 0 && r11 == 0) -> DUAL_OK
        //   (r10 == 1 && r11 == 1) -> DUAL_SCAFFOLD (epoch gated below)
        //   (r10 == 1 && r11 != 1) OR (r10 != 1 && r11 == 1) -> MIXED
        //   (r10 != 0 && r11 == 0) -> PAIDEIA_FAIL
        //   (r10 == 0 && r11 != 0) -> VENDOR_FAIL
        //   (r10 != 0 && r11 != 0) -> BOTH_FAIL

        // Both SIG_OK -> DUAL_OK.
        cmp r10, 0;
        jne hsv_dv_check_scaffold;
        cmp r11, 0;
        jne hsv_dv_vendor_fail;
        // DUAL_OK.
        lea r10, [rip + _hda_sof_verify_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        xor rax, rax;
        jmp hsv_dv_out;

      hsv_dv_check_scaffold:
        // r10 != 0. Is it scaffold?
        cmp r10, 1;
        jne hsv_dv_paideia_not_scaffold;
        // r10 == 1 (SCAFFOLD). r11 must also be 1.
        cmp r11, 1;
        jne hsv_dv_mixed;
        // Both SCAFFOLD; gate on epoch flag.
        call driver_sig_scaffold_epoch;
        cmp rax, 0;
        je hsv_dv_both_fail;
        // Epoch live -> DUAL_SCAFFOLD.
        lea r10, [rip + _hda_sof_verify_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 1;
        jmp hsv_dv_out;

      hsv_dv_paideia_not_scaffold:
        // r10 != 0 and r10 != 1: paideia arm failed.
        // Check r11 to distinguish PAIDEIA_FAIL from BOTH_FAIL.
        cmp r11, 0;
        je hsv_dv_paideia_fail;
        cmp r11, 1;
        je hsv_dv_mixed;                     // real fail on paideia + scaffold on vendor
        jmp hsv_dv_both_fail;

      hsv_dv_vendor_fail:
        // r10 == 0 (SIG_OK) and r11 != 0. If r11 == 1 -> MIXED.
        cmp r11, 1;
        je hsv_dv_mixed;
        lea r10, [rip + _hda_sof_verify_stats];
        mov rax, [r10 + 24];                 // ST_VENDOR
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFCA1;
        jmp hsv_dv_out;

      hsv_dv_paideia_fail:
        lea r10, [rip + _hda_sof_verify_stats];
        mov rax, [r10 + 16];                 // ST_PAIDEIA
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFCA0;
        jmp hsv_dv_out;

      hsv_dv_both_fail:
        lea r10, [rip + _hda_sof_verify_stats];
        mov rax, [r10 + 32];                 // ST_BOTH
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFFCA2;
        jmp hsv_dv_out;

      hsv_dv_mixed:
        lea r10, [rip + _hda_sof_verify_stats];
        mov rax, [r10 + 48];                 // ST_MIXED
        add rax, 1;
        mov [r10 + 48], rax;
        mov rax, 0xFFFFFCA4;

      hsv_dv_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_sof_verify_dual_is_ok(v) -> 1 | 0
  //
  // The sanctioned predicate. Callers gate their attach-to-loader
  // decision through this: it returns 1 only for DUAL_OK (0). At R29
  // that means every attach refuses (DUAL_SCAFFOLD returns 0 here); at
  // R32 real signatures start returning DUAL_OK.
  //
  // A callsite that open-codes `cmp rax, 1; jbe accept` would silently
  // accept DUAL_SCAFFOLD, which is exactly the mistake this predicate
  // exists to prevent. Same discipline as driver_sig_verdict_is_ok.
  // ==========================================================================

  pub let hda_sof_verify_dual_is_ok : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M6-004 (#1165): exact-equality predicate against DUAL_OK (0). Mirrors driver_sig_verdict_is_ok. Leaf. Labels prefixed hsv_dio_.",
      block: {
        xor rax, rax;
        cmp rdi, 0;
        jne hsv_dio_out;
        mov rax, 1;
      hsv_dio_out:
        ret
      }
    }

  // ==========================================================================
  // hda_sof_verify_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_sof_verify_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M6-004 (#1165): bounds-checked read of one SOF-verify counter. Out of range returns 0. Leaf. Labels prefixed hsv_st_.",
      block: {
        cmp rdi, 8;
        jae hsv_st_zero;
        lea r10, [rip + _hda_sof_verify_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hsv_st_zero:
        xor rax, rax;
        ret
      }
    }
}
