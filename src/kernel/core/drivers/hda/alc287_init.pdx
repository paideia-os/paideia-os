// src/kernel/core/drivers/hda/alc287_init.pdx -- R33.M4-001 (#1152)
//
// The Realtek ALC287 vendor-specific INIT SEQUENCE scaffold.
// SCAFFOLD-COMPATIBLE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE VENDOR COEFFICIENT INIT PATH for the ALC287 codec. Realtek
// codecs expose a bank of internal PROCESSING COEFFICIENTS, addressed
// as {index, value} pairs, that adjust the internal analog signal
// chain -- HP amp headroom, mic biasing, EQ pre-emphasis and (on the
// ALC287 specifically) the AGC hysteresis for the two-line-array beam-
// forming mic pair. These coefficients are not part of the standard
// HDA verb set; the Realtek codec driver in Linux upstream carries a
// per-part init table, applied once at bind after the codec has come
// out of RESET and before any pin/route programming.
//
// Coefficients are set through two Realtek-defined verbs:
//
//   * SHORT-form verb id 0x5 (SET_COEF_INDEX)          -- 16-bit index
//   * SHORT-form verb id 0x4 (SET_PROC_COEF)           -- 16-bit value
//
// A live init sends one pair per coefficient: SET_COEF_INDEX(idx),
// SET_PROC_COEF(val). This module DECLARES the seams, iterates a fixed
// table of six pairs derived from the Realtek datasheet + the Linux
// alc287_fixup_thinkpad path, and delegates every verb to the R33.M2
// hda_verb_send_short scaffold (which returns DEFERRED_HARDWARE).
//
// IT IS NOT A LIVE INIT PASS. Same discipline as the R33.M2 scaffolds:
// the pin `hda_alc287_init_arbitrated() == 0` -- an assertion that
// FAILS the moment a future milestone plumbs real MMIO through the
// underlying CORB/RIRB path -- forces the design doc to be updated at
// that time.
//
// TABLE SIZE IS FIXED. The six entries are the minimal set the ALC287
// datasheet + Linux upstream apply on every bind path (the machine-
// specific fixup adds more entries over the top). A caller-supplied
// TABLE would let a stray helper inject arbitrary coefficients into
// the codec's analog path, which is exactly the confusion the vendor
// wrapper exists to remove: only this module writes ALC287-specific
// coefficients.
//
// =============================================================================
// §1  COEFFICIENT TABLE IS FIXED, NOT NEGOTIATED
// =============================================================================
//
// Entries (index, value) applied in table order to the codec's AFG
// node (node 0x01 on ALC287):
//
//   (0x08, 0x6a0c)  -- HP output routing default
//   (0x0d, 0xa020)  -- EAPD hold time (min 20 ms)
//   (0x33, 0x0000)  -- disable classD boost pre-charge
//   (0x49, 0x0149)  -- mic beamforming AGC hysteresis
//   (0x4a, 0xa60d)  -- HP amp headroom (2 dB, per datasheet)
//   (0x6e, 0x00a6)  -- power-down suppression on jack removal
//
// Each write is (a) SET_COEF_INDEX(codec_addr, AFG=0x01, idx) then
// (b) SET_PROC_COEF(codec_addr, AFG=0x01, val). Two SHORT-form verbs
// per pair, twelve verbs total.
//
// =============================================================================
// §2  ONE READER OF THE STATS COUNTERS
// =============================================================================
//
// tools/build.sh confines relocations against `_hda_alc287_init_stats`
// to this object. The counters (pairs applied, refused calls, done
// latch) are the only evidence that init ran and what it observed; a
// second writer would let another module invent an init pass the
// codec never received.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// codec_addr >= 16                       -> BAD_ADDR
// A second bind for the same codec_addr  -> ALREADY_BOUND (LATCH)
// Any underlying verb send returning
//   NOT_READY / BAD_*                   -> propagated as VERB_FAIL
//                                          (counted; the failing pair's
//                                           index is NOT recorded here,
//                                           because a two-verb pair split
//                                           across success/failure is
//                                           ambiguous by construction; a
//                                           live driver would abort the
//                                           whole bind on this).
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO REAL VERB TRANSPORT. hda_verb_send_short is a scaffold that
//     returns DEFERRED_HARDWARE without touching a ring.
//   * NO CODEC-STATE VERIFICATION. A live init would read back each
//     coefficient with GET_PROC_COEF and refuse the bind on mismatch.
//     Deferred.
//   * NO POWER-STATE SEQUENCING. A live init sits between D0 entry
//     (SET_POWER_STATE D0 on AFG) and the pin/route programming; this
//     scaffold declares no ordering of its own beyond the internal
//     table order.
//   * NO ARBITRATION. `hda_alc287_init_arbitrated() == 0` is pinned by
//     the boot witness.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFCC0..0xFFFFFCCF
// =============================================================================

module Alc287Init = structure {

  // ==========================================================================
  // §1 constants.
  // ==========================================================================

  pub let HDA_ALC287_AFG_NODE       : u64 = 0x01

  // SHORT-form verb ids for the coefficient set pair.
  pub let HDA_ALC287_VERB_SET_COEF_IDX : u64 = 0x5
  pub let HDA_ALC287_VERB_SET_PROC_COEF: u64 = 0x4

  // Table cardinality. Six pairs = twelve verbs.
  pub let HDA_ALC287_INIT_PAIRS     : u64 = 6

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let HDA_ALC287_INIT_OK            : u64 = 0
  pub let HDA_ALC287_INIT_BAD_ADDR      : u64 = 0xFFFFFCCF
  pub let HDA_ALC287_INIT_ALREADY_BOUND : u64 = 0xFFFFFCCE
  pub let HDA_ALC287_INIT_VERB_FAIL     : u64 = 0xFFFFFCCD

  // ==========================================================================
  // State. Confined to this object by tools/build.sh.
  //
  // Slots:
  //   [0] ST_APPLIED     -- coefficient pairs successfully submitted
  //   [1] ST_BAD_ADDR    -- refused BAD_ADDR bind calls
  //   [2] ST_ALREADY     -- refused ALREADY_BOUND bind calls
  //   [3] ST_VERB_FAIL   -- verb-send returns other than DEFERRED_HARDWARE
  //   [4] ST_BOUND       -- latch (0 = never bound, non-0 = bound to codec+1)
  // ==========================================================================

  pub let mut _hda_alc287_init_stats : [u64; 8] = uninit @align(64)

  pub let HDA_ALC287_ST_APPLIED   : u64 = 0
  pub let HDA_ALC287_ST_BAD_ADDR  : u64 = 1
  pub let HDA_ALC287_ST_ALREADY   : u64 = 2
  pub let HDA_ALC287_ST_VERB_FAIL : u64 = 3
  pub let HDA_ALC287_ST_BOUND     : u64 = 4

  // ==========================================================================
  // hda_alc287_init_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same shape as the other HDA scaffold pins.
  // ==========================================================================

  pub let hda_alc287_init_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M4-001 (#1152): report whether the ALC287 vendor init issues real MMIO today. IT RETURNS 0, because every verb is dispatched through hda_verb_send_short, a scaffold that returns DEFERRED_HARDWARE. The boot witness pins it at 0. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_init_bound() -> 0 | codec_addr+1
  //
  // The bind latch. Zero means never bound; non-zero encodes (codec_addr+1)
  // so a bind to codec 0 is DISTINGUISHABLE from the unbound state without
  // needing a second cell.
  // ==========================================================================

  pub let hda_alc287_init_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-001 (#1152): read the bind latch. 0 means never bound; non-zero encodes (codec_addr+1). Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_init_stats];
        mov rax, [r10 + 32];
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_init_apply(codec_addr) -> code
  //
  // ARITY ONE. The table is fixed §1. Widening this seam to accept a
  // caller-supplied table would let a stray helper inject arbitrary
  // coefficients into the codec's analog path -- exactly what the
  // vendor wrapper exists to stop (§0).
  //
  // Gates, in order:
  //   (1) codec_addr < 16                   else BAD_ADDR
  //   (2) not already bound                 else ALREADY_BOUND (LATCH)
  //   (3) For each of six pairs:
  //         send SET_COEF_INDEX(codec, AFG, idx)
  //         send SET_PROC_COEF(codec, AFG, val)
  //       If either returns anything other than DEFERRED_HARDWARE,
  //       bump ST_VERB_FAIL and return VERB_FAIL. Do NOT set the
  //       latch on partial application.
  //   (4) Bump ST_APPLIED by six, set latch to codec+1, return OK.
  // ==========================================================================

  pub let hda_alc287_init_apply : (u64) -> u64 !{mem} @{} =
    fn (codec_addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-001 (#1152): apply the fixed six-pair vendor coefficient table to codec_addr's AFG (node 0x01). Gates: (1) codec_addr < 16 else BAD_ADDR (refused, not masked; a codec_addr of 16 would silently apply to codec 0). (2) latch cell zero else ALREADY_BOUND (a second bind would silently re-run twelve verbs at the codec, which is not idempotent for coefficients whose semantics are 'apply delta'). Table order is the datasheet order and matches Linux upstream. Each pair is two SHORT-form verb sends via hda_verb_send_short (verb ids 0x5 and 0x4). The pairs are UNROLLED in this scaffold rather than driven from a .rodata table because iterating a small fixed table adds a loop reserved-label conflict and a table-address indirection that adds no value at this milestone. On any verb failure, latch STAYS ZERO -- the coefficient state after a partial bind is not defined, and a live driver would drop the codec on this. Seven pushes: rbx, r12..r15, rbp, plus one alignment cell keeps rsp%16 == 0 at every nested call. Labels prefixed hai_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // codec_addr

        // (1) codec_addr < 16
        cmp r12, 16;
        jae hai_ap_bad_addr;

        // (2) already bound?
        lea r10, [rip + _hda_alc287_init_stats];
        mov rax, [r10 + 32];             // latch
        cmp rax, 0;
        jne hai_ap_already;

        // Pair 1: (0x08, 0x6a0c)
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x5;
        mov rcx, 0x08;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;             // DEFERRED_HARDWARE
        cmp rax, r11;
        jne hai_ap_verb_fail;
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x4;
        mov rcx, 0x6a0c;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;

        // Pair 2: (0x0d, 0xa020)
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x5;
        mov rcx, 0x0d;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x4;
        mov rcx, 0xa020;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;

        // Pair 3: (0x33, 0x0000)
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x5;
        mov rcx, 0x33;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x4;
        xor rcx, rcx;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;

        // Pair 4: (0x49, 0x0149)
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x5;
        mov rcx, 0x49;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x4;
        mov rcx, 0x0149;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;

        // Pair 5: (0x4a, 0xa60d)
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x5;
        mov rcx, 0x4a;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x4;
        mov rcx, 0xa60d;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;

        // Pair 6: (0x6e, 0x00a6)
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x5;
        mov rcx, 0x6e;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;
        mov rdi, r12;
        mov rsi, 0x01;
        mov rdx, 0x4;
        mov rcx, 0x00a6;
        call hda_verb_send_short;
        mov r11, 0xFFFFFCBB;
        cmp rax, r11;
        jne hai_ap_verb_fail;

        // (4) Success: bump applied by six, stamp latch codec+1.
        lea r10, [rip + _hda_alc287_init_stats];
        mov rax, [r10 + 0];              // ST_APPLIED
        add rax, 6;
        mov [r10 + 0], rax;

        mov rax, r12;
        add rax, 1;
        mov [r10 + 32], rax;             // latch

        xor rax, rax;                    // OK
        jmp hai_ap_out;

      hai_ap_bad_addr:
        lea r10, [rip + _hda_alc287_init_stats];
        mov rax, [r10 + 8];              // ST_BAD_ADDR
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFCCF;
        jmp hai_ap_out;
      hai_ap_already:
        lea r10, [rip + _hda_alc287_init_stats];
        mov rax, [r10 + 16];             // ST_ALREADY
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFCCE;
        jmp hai_ap_out;
      hai_ap_verb_fail:
        lea r10, [rip + _hda_alc287_init_stats];
        mov r11, [r10 + 24];             // ST_VERB_FAIL
        add r11, 1;
        mov [r10 + 24], r11;
        mov rax, 0xFFFFFCCD;

      hai_ap_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_init_reset() -> ()
  //
  // Clear the latch so a subsequent apply can bind again. Used only by
  // the boot witness's teardown; a live driver would use codec-detach.
  // Leaves the counters alone (they are cumulative evidence).
  // ==========================================================================

  pub let hda_alc287_init_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-001 (#1152): clear the bind latch cell. Cumulative counters are preserved. Returns 0. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _hda_alc287_init_stats];
        xor rax, rax;
        mov [r10 + 32], rax;
        ret
      }
    }

  // ==========================================================================
  // hda_alc287_init_stat(which) -> counter | 0
  // ==========================================================================

  pub let hda_alc287_init_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M4-001 (#1152): bounds-checked read of one ALC287-init counter. Out of range returns 0. Leaf. Labels prefixed hai_st_.",
      block: {
        cmp rdi, 8;
        jae hai_st_zero;
        lea r10, [rip + _hda_alc287_init_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hai_st_zero:
        xor rax, rax;
        ret
      }
    }

}
