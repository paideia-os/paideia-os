// src/kernel/core/drivers/tpm/tpm_crb.pdx -- Wave 59 I9 [R30] (paideia-os#2566)
//
// Trusted Platform Module 2.0 Command Response Buffer (CRB) interface
// SKELETON. T14 G4 ships Intel fTPM -- a firmware TPM 2.0 implementation
// resident in the CSME (Converged Security + Management Engine) that
// exposes exactly the same MMIO contract as a discrete TPM 2.0 chip
// (TCG PC Client Platform TPM Profile Spec for TPM 2.0, Family 2.0
// Revision 1.59, §6.5 "CRB Interface"). The register window at
// 0xFED40000..0xFED45FFF is subdivided into FOUR LOCALITIES of 0x1000
// bytes each (locality 0, 1, 2, 3, 4; locality 4 is reserved for
// hardware-only use and is not addressable from software); each
// locality exposes an identical register layout defined by the TCG
// CRB spec §6.5.2.
//
// This skeleton:
//
//   * freezes the per-locality MMIO register map (TPM_LOC_STATE through
//     TPM_CRB_DATA_BUFFER, 16 named registers, offsets in [0..0x80])
//   * freezes the TPM 2.0 command-header shape (10 bytes big-endian:
//     tag:u16, size:u32, command_code:u32)
//   * freezes the TPM 2.0 constants this module cares about
//     (TPM_ST_NO_SESSIONS tag, TPM_CC_GetCapability, TPM_CC_PCR_Extend,
//     TPM_CAP_TPM_PROPERTIES, TPM_PT_FAMILY_INDICATOR, TPM_ALG_SHA256)
//   * freezes the return-code band 0xFFFFFD53..0xFFFFFD57 so a
//     skeleton refusal and a real-body refusal share a code
//   * freezes the four public entrypoints (`tpm_crb_init`,
//     `tpm_crb_submit`, `tpm_crb_get_capability`,
//     `tpm_crb_pcr_extend_7`) with their eventual SysV signatures
//   * freezes the dispatch stub `cap_handler_tpm_crb(rights,
//     target_ptr, op_arg)` the KIND_TPM_CRB (0x4E) arm in
//     `src/kernel/core/cap/invoke.pdx` will call once the follow-up
//     slice carries the invoke.pdx wire-up
//   * emits the Wave 59 fingerprint lines (INIT success, SUBMIT
//     per-call, PCR7_EXTEND per-call) via `klog_s1_d2`, `klog_s1_x2`,
//     `klog_s1_x1` so a boot witness can SEE the seam fire even
//     before the real-body slice lands
//   * confines the TPM-session mutable state to this object (one
//     controller per machine -- a tier-1 x86_64 laptop has exactly one
//     TPM pointer, same posture as ec.pdx's one-controller invariant)
//
// -----------------------------------------------------------------------------
// §0  WHY `tpm/`, NOT `acpi/` AND NOT A GENERIC `security/`
// -----------------------------------------------------------------------------
//
// The ACPI table TPM2 (ACPI 6.5 §6.2.26) carries the MMIO base and the
// interface-type nibble (0 = FIFO/TIS, 1 = CRB) -- that is where the
// `0xFED40000` on the T14 G4 comes from and why Wave 71's D5 ACPICA
// walker is the eventual provider of `mmio_base` to `tpm_crb_init`.
// But the file does NOT live under `acpi/`: ACPI is only the mechanism
// by which the base is discovered. The CRB interface is a TCG spec,
// not an ACPI one, and every other TPM transport that may ship on
// future paideia-os targets (TIS/FIFO over the LPC bus, SPI-TPM on
// embedded SKUs) will land as a SIBLING `.pdx` in `tpm/`, not as yet
// another file sprayed through `acpi/`. Keeping the dimension
// (transport = CRB vs FIFO vs SPI) co-located under one directory
// matches the directive 2026-10-10 ("novel + clean design bias") --
// a reader looking for "where is the TPM substrate" finds everything
// in one place, and does not have to grep across acpi/, security/,
// crypto/ for its pieces.
//
// A `security/` directory is deferred: the TPM is only ONE primitive
// of several (Secure Boot verifier, kernel-image blob verifier,
// attestation-report builder) that collectively make up the paideia-os
// trusted-boot story. Those will land under `security/` when more
// than one of them exists; today the module tree would carry a
// directory with exactly one driver, which signals the directory as
// speculative and makes a reviewer wonder what the OTHER files
// should look like. One wrong-shaped directory is worse than one
// right-shaped file: when the second TPM driver (FIFO/TIS) lands,
// moving a FOLDER is one `git mv`; moving a FILE out of a
// speculative folder is two.
//
// -----------------------------------------------------------------------------
// §1  CRB INTERFACE -- WHY FOUR LOCALITIES, AND WHY LOCALITY 0 ONLY
// -----------------------------------------------------------------------------
//
// TCG PC Client PTP §4.6 "Locality Hierarchy" defines FIVE localities
// (0..4) each 0x1000 bytes wide inside a contiguous 0x5000-byte MMIO
// window:
//
//   locality 0 -- "Non-trusted and Legacy Code" -- the OS runtime
//                 locality. All boot-firmware and OS-runtime TPM
//                 interactions on x86_64 use this locality. This is
//                 the one the skeleton latches.
//   locality 1 -- "Trusted Code" -- a hypervisor would use it to
//                 isolate guest TPM state from the host. paideia-os
//                 is not a hypervisor and never claims this locality.
//   locality 2 -- "Trusted OS" -- DRTM (Dynamic Root of Trust for
//                 Measurement) sequences use it (Intel TXT, AMD SKINIT).
//                 paideia-os may use locality 2 for a future DRTM
//                 launch; today it does not.
//   locality 3 -- "Auxiliary Component" -- reserved for Microsoft
//                 BitLocker-style scenarios. paideia-os never uses it.
//   locality 4 -- "TPM Internal Use Only" -- not addressable from
//                 software. The MMIO window is only 0x5000 bytes wide
//                 (0..0x4FFF); offset 0x4000..0x4FFF is the hardware-
//                 reserved slice and software writes to it are
//                 silently ignored by the chip.
//
// The locality a driver uses is latched by WRITING `requestAccess`
// (bit 1 of `TPM_LOC_CTRL` at `locality_base + 0x8`), then POLLING
// `locAssigned` (bit 1 of `TPM_LOC_STATE` at `locality_base + 0x0`)
// until it reads 1. The skeleton codifies locality 0 as the single
// locality claim path; the real body polls the `locAssigned` bit
// with the standard `TPM_POLL_MAX` budget and refuses with
// `TPM_ERR_LOCALITY_FAILED` on exhaustion.
//
// -----------------------------------------------------------------------------
// §2  COMMAND HEADER -- WHY BIG-ENDIAN, AND HOW A LITTLE-ENDIAN HOST
//     WRITES IT
// -----------------------------------------------------------------------------
//
// TPM 2.0 Part 1 §16 "Interfaces" freezes the TPM command header as
//
//   struct TPM2_HEADER {
//     uint16_t tag;              // TPM_ST_NO_SESSIONS = 0x8001
//     uint32_t commandSize;      // total bytes incl. header
//     uint32_t commandCode;      // e.g. TPM_CC_GetCapability = 0x17A
//   }
//
// -- all three fields BIG-ENDIAN, same as every other TCG wire
// protocol (TPM 1.2 inherited the discipline from the smart-card
// world and TPM 2.0 kept it). x86_64 is little-endian; writing a BE
// 32-bit integer to MMIO therefore requires a byte swap. The real
// body emits the swap via the `bswap` instruction (one byte, encoding
// 0x0F 0xC8..0xCF on registers rax..r15 with the REX.W prefix). The
// skeleton emits no port I/O so the swap is only mentioned in the
// commentary; the real-body slice adds `bswap` to each 32-bit field
// store and `rol r, 8` to each 16-bit field store.
//
// -----------------------------------------------------------------------------
// §3  RETURN CODES -- band 0xFFFFFD53..0xFFFFFD57
// -----------------------------------------------------------------------------
//
// Reserved by paideia-os#2566 for the TPM CRB driver. Disjoint from:
//
//   REGISTRY_SNAPSHOT_* (0xFFFFFD50..51, driver/registry_snapshot.pdx)
//   ECD_ERR_*           (0xFFFFFD44..48, drivers/acpi/ec_discovery.pdx)
//   EC_ERR_*            (0xFFFFFFC5..CA, drivers/acpi/ec.pdx)
//
//   0xFFFFFD53  TPM_ERR_ABSENT          -- the MMIO window reads back
//                                          all-ones (0xFFFFFFFF) on the
//                                          first LOC_STATE probe; no TPM
//                                          present (common on bare-metal
//                                          BIOS that disabled fTPM, or
//                                          on QEMU without `-device
//                                          tpm-crb,tpmdev=`)
//   0xFFFFFD54  TPM_ERR_NOT_CRB         -- INTF_ID[3:0] != 1; this chip
//                                          exposes the FIFO/TIS interface
//                                          only. A future SIBLING driver
//                                          (`tpm_tis.pdx`) will consume
//                                          those; this driver refuses
//                                          with a specific name so an
//                                          operator reading the fingerprint
//                                          log knows which sibling to
//                                          enable
//   0xFFFFFD55  TPM_ERR_LOCALITY_FAILED -- requestAccess was issued but
//                                          locAssigned never read 1 within
//                                          TPM_POLL_MAX iterations. The
//                                          most common cause is another
//                                          actor holding the locality
//                                          (SMI-mode BIOS, or an earlier
//                                          driver that forgot to release
//                                          -- see `tpm_crb_release` in
//                                          the follow-up slice)
//   0xFFFFFD56  TPM_ERR_CMD_TIMEOUT     -- tpmSts bit never cleared within
//                                          TPM_POLL_MAX iterations after
//                                          CTRL_START.bit0 was set. The
//                                          command is lost; the controller
//                                          may still be processing it and
//                                          the response may land later --
//                                          `cancel` must be issued before
//                                          retrying (`CTRL_CANCEL.bit0`)
//   0xFFFFFD57  TPM_ERR_BAD_RESPONSE    -- the response buffer's size
//                                          field (big-endian u32 at
//                                          DATA_BUFFER[2..6]) overflowed
//                                          the caller's resp_len or
//                                          underflowed TPM_HEADER_SIZE
//                                          (10 bytes)
//
// All five codes are present at skeleton stage and never fired (the
// skeleton always returns TPM_OK after bookkeeping). The symbols
// exist today so that the real-body slice can land without re-
// numbering, and so a reviewer debugging a bring-up log reads the
// SAME code the final driver will emit. Grep-audit at landing time
// (2026-10-10): `grep -rnE '0xFFFFFD5[3-7]' src/kernel/` returned
// ZERO existing hits.
//
// -----------------------------------------------------------------------------
// §4  invoke.pdx -- SLOT 0x4E (KIND_TPM_CRB) RESERVED, DISPATCH DEFERRED
// -----------------------------------------------------------------------------
//
// The capability KIND_TPM_CRB is a NEW cap -- it derives nothing from
// an existing capability kind (unlike KIND_FIRMWARE_BLOB which
// derived over KIND_MEMORY): the TPM is a top-of-hierarchy device,
// not an overlay on a memory range or a device bus. The 0x4E slot
// was reserved by the issue text and audit at landing time
// (2026-10-10) found 0x4C, 0x4D, 0x4E, 0x4F all free:
//
//   $ grep -nE 'cmp rcx, 0x4[CDEF]|mov r9, 0x4[CDEF]|KIND.*0x4[CDEF]' \
//           src/kernel/core/cap/invoke.pdx
//   (no matches)
//
// 0x4C and 0x4D are left for the two SIBLING parallel Wave 79 drops
// (I7 extensions and D17 touchpad gestures); 0x4F stays free for the
// next wave's first picker.
//
// The dispatch arm in invoke.pdx is added by this landing (one
// cmp/je pair in the §A opcode block + one call_kind_tpm_crb trampoline
// in the §B dispatch block, same shape as every KIND_* arm above).
//
// -----------------------------------------------------------------------------
// §5  I7 FIRMWARE_BLOB CROSS-REFERENCE
// -----------------------------------------------------------------------------
//
// `src/kernel/core/cap/kind_firmware_blob.pdx:663` (Wave 73 I7) carries
// a TODO:
//
//   // TODO(wave-74): extend TPM PCR 7 on successful mount
//
// `tpm_crb_pcr_extend_7` is the entrypoint that comment references.
// This skeleton does NOT edit kind_firmware_blob.pdx; the TODO stays
// in place until the follow-up slice that lands the TPM real body
// wires the extend call into the firmware-blob mount path. The
// skeleton exposes the entrypoint SYMBOL so a `grep` from
// `kind_firmware_blob.pdx` can find it, and so an upstream reviewer
// walking the TODO can see the ABI it will eventually call.
//
// -----------------------------------------------------------------------------
// §6  FINGERPRINTS
// -----------------------------------------------------------------------------
//
//   tests/fingerprints/tpm_crb.golden:
//
//     TPM INIT intf=<dec> loc=<dec>
//     TPM SUBMIT cmd_code=0x<8-hex> rc=0x<8-hex>
//     TPM PCR7_EXTEND digest=0x<16-hex>
//
// Three lines, one per entrypoint path:
//
//   * INIT emits once per successful `tpm_crb_init` via klog_s1_d2
//     (both fields decimal: intf is the INTF_ID[3:0] nibble, loc is
//     the locality number this driver claimed)
//   * SUBMIT emits once per `tpm_crb_submit` call (success OR refusal)
//     via klog_s1_x2 (cmd_code is the TPM_CC_* big-endian value
//     observed in the command header, rc is the TPM_RC_* big-endian
//     value observed in the response header, or one of our 0xFFFFFD5*
//     codes on local refusal)
//   * PCR7_EXTEND emits once per `tpm_crb_pcr_extend_7` via klog_s1_x1
//     (the digest is the SHA-256 truncated to its first 8 bytes --
//     the full digest is 32 bytes but a 64-bit witness value is
//     enough to catch "wrong blob extended" bugs; a reviewer who
//     needs the full digest can read it out of the command buffer
//     in the Qemu trace)
//
// Format letters follow the klog_* convention (`d` = decimal, `x` =
// hex). The golden file is anchored by the pattern (`<dec>` /
// `<8-hex>` / `<16-hex>`); the smoke harness greps for the literal
// line without the value substitution.
//
// -----------------------------------------------------------------------------
// §7  paideia-as v0.36.82 ENCODER POSTURE
// -----------------------------------------------------------------------------
//
//   G1 -- every u32 MMIO store would use `mov_d` in the real body;
//         the skeleton emits NO MMIO (all reads/writes stubbed).
//   G4 -- every compare is on a full 64-bit register; no `cmp al, imm`.
//   No `test rN, rN` -- zero-equality uses `cmp rN, 0`.
//   No `and r, imm64` -- every mask here fits in imm32 (TPM_PT_
//                        FAMILY_INDICATOR = 0x100 is imm32-safe).
//   No two-operand `imul r, imm` -- the skeleton has no multiplies.
//   Multiline `pub let x = "..."` strings -- forbidden; every tag below
//                                             is one line.
//   Module basename match -- `tpm_crb.pdx` -> `module TpmCrb`.
//   Reserved labels (`loop`, `if`, `let`) -- every label in this file
//                                             is prefixed with the
//                                             function's own 4-letter
//                                             tag (`tci_` / `tcs_` /
//                                             `tcg_` / `tcp_` / `tch_`),
//                                             per the pdx-encoder-
//                                             pitfalls memory
//                                             2026-09-26.
//   Fingerprint tag `[u8; N]` -- `N = len(string) + 1`, nul-terminated.
//
// =============================================================================

module TpmCrb = structure {

  // ==========================================================================
  // §A  CRB register offsets (TCG PC Client PTP §6.5.2; per-locality)
  //
  // Offsets are from `locality_base` where `locality_base = mmio_base +
  // (locality_index * 0x1000)`. Locality 0 is `mmio_base` itself.
  // ==========================================================================

  pub let TPM_LOC_STATE          : u64 = 0x0000  // bit0 established, bit1
                                                  // locAssigned, bits4:2
                                                  // activeLocality
  pub let TPM_LOC_CTRL           : u64 = 0x0008  // bit0 requestAccess
                                                  // bit1 relinquish
                                                  // bit2 seize
                                                  // bit3 resetEstablishment
  pub let TPM_LOC_STS            : u64 = 0x000C  // bit0 granted
                                                  // bit1 beenSeized
  pub let TPM_CRB_INTF_ID        : u64 = 0x0030  // bits3:0 interface type
                                                  // (0 = FIFO/TIS, 1 = CRB)
  pub let TPM_CRB_CTRL_EXT       : u64 = 0x0038  // extended-control register
  pub let TPM_CRB_CTRL_REQ       : u64 = 0x0040  // bit0 cmdReady
                                                  // bit1 goIdle
  pub let TPM_CRB_CTRL_STS       : u64 = 0x0044  // bit0 tpmSts (0 = idle)
                                                  // bit1 tpmIdle
  pub let TPM_CRB_CTRL_CANCEL    : u64 = 0x0048  // write 1 to cancel in-
                                                  // flight command
  pub let TPM_CRB_CTRL_START     : u64 = 0x004C  // write 1 to start command
                                                  // currently in CMD buffer
  pub let TPM_CRB_CTRL_CMD_SIZE  : u64 = 0x0058  // caller-advertised cmd buf
                                                  // length (bytes)
  pub let TPM_CRB_CTRL_CMD_LADDR : u64 = 0x005C  // low 32b of cmd buf PA
  pub let TPM_CRB_CTRL_CMD_HADDR : u64 = 0x0060  // high 32b of cmd buf PA
  pub let TPM_CRB_CTRL_RSP_SIZE  : u64 = 0x0064  // caller-advertised resp
                                                  // buf length (bytes)
  pub let TPM_CRB_CTRL_RSP_ADDR  : u64 = 0x0068  // 64-bit resp buf PA
  pub let TPM_CRB_DATA_BUFFER    : u64 = 0x0080  // 3968 bytes of in-line
                                                  // command/response space
                                                  // (0x80..0xFFF)

  // ==========================================================================
  // §B  Interface + locality constants
  // ==========================================================================

  pub let TPM_INTF_CRB  : u64 = 0x1              // INTF_ID[3:0] = 1 means CRB
  pub let TPM_INTF_FIFO : u64 = 0x0              // INTF_ID[3:0] = 0 means TIS

  pub let TPM_LOC_0 : u64 = 0                    // the one locality this
                                                  // driver claims (see §1)

  pub let TPM_LOC_STRIDE   : u64 = 0x1000        // bytes per locality
  pub let TPM_WINDOW_BYTES : u64 = 0x5000        // five localities total

  pub let TPM_DATA_BUFFER_MAX : u64 = 3968       // 0x80..0xFFF = 3968 bytes

  // Bit masks for the status/control registers.

  pub let TPM_LOC_STATE_ESTAB      : u64 = 0x1   // bit0: tpmEstablished
  pub let TPM_LOC_STATE_ASSIGNED   : u64 = 0x2   // bit1: locAssigned
  pub let TPM_LOC_CTRL_REQUEST     : u64 = 0x1   // bit0: requestAccess
  pub let TPM_LOC_CTRL_RELINQUISH  : u64 = 0x2   // bit1: relinquish
  pub let TPM_CRB_CTRL_REQ_READY   : u64 = 0x1   // bit0: cmdReady
  pub let TPM_CRB_CTRL_REQ_GOIDLE  : u64 = 0x2   // bit1: goIdle
  pub let TPM_CRB_CTRL_STS_TPMSTS  : u64 = 0x1   // bit0: tpmSts (busy)
  pub let TPM_CRB_CTRL_STS_IDLE    : u64 = 0x2   // bit1: tpmIdle
  pub let TPM_CRB_CTRL_START_GO    : u64 = 0x1   // bit0: start
  pub let TPM_INTF_ID_TYPE_MASK    : u64 = 0xF   // bits3:0 of INTF_ID

  // ==========================================================================
  // §C  TPM 2.0 wire constants (TPM 2.0 Part 2 §6)
  //
  // All multi-byte fields BIG-ENDIAN on the wire. These constants are
  // documented in HOST (little-endian) order; the real body byte-
  // swaps them before storing into the command buffer.
  // ==========================================================================

  pub let TPM_HEADER_SIZE : u64 = 10              // tag(2) + size(4) + cc(4)

  pub let TPM_ST_NO_SESSIONS : u64 = 0x8001       // tag for sessionless cmds
  pub let TPM_ST_SESSIONS    : u64 = 0x8002       // tag for sessioned cmds

  pub let TPM_CC_GetCapability : u64 = 0x0000017A // "ask the TPM about itself"
  pub let TPM_CC_PCR_Extend    : u64 = 0x00000182 // "extend a PCR bank"
  pub let TPM_CC_PCR_Read      : u64 = 0x0000017E // "read a PCR bank"
  pub let TPM_CC_Startup       : u64 = 0x00000144 // "wake the TPM"

  pub let TPM_CAP_TPM_PROPERTIES : u64 = 0x6      // capability-list selector
                                                   // for the fixed-property
                                                   // table

  pub let TPM_PT_FAMILY_INDICATOR : u64 = 0x100   // property index: ASCII
                                                   // string "2.0" if TPM 2.0,
                                                   // "1.2" if TPM 1.2 (the
                                                   // discriminator this
                                                   // driver cares about)

  pub let TPM_ALG_SHA256 : u64 = 0x000B           // PCR bank selector --
                                                   // SHA-256 is the bank
                                                   // measured_boot uses

  pub let TPM_PCR_7 : u64 = 0x7                   // UEFI Secure Boot DB /
                                                   // DBX / vendor firmware
                                                   // measurements land here

  pub let TPM_RC_SUCCESS : u64 = 0x0              // TPM 2.0 "all OK" rc

  // ==========================================================================
  // §D  Handler op argument codes (cap_handler_tpm_crb)
  //
  // The op_arg encoding mirrors ec_discovery.pdx: low byte names the
  // op, high bytes carry per-op arguments. Four values are legal;
  // anything else is INVOKE_UNSUPPORTED.
  // ==========================================================================

  pub let TPM_OP_INIT       : u64 = 1
  pub let TPM_OP_SUBMIT     : u64 = 2
  pub let TPM_OP_GET_CAP    : u64 = 3
  pub let TPM_OP_PCR_EXTEND : u64 = 4

  // ==========================================================================
  // §E  Return codes -- band 0xFFFFFD53..0xFFFFFD57
  //
  // See the file header §3 for the band-disjointness proof.
  // ==========================================================================

  pub let TPM_OK                   : u64 = 0
  pub let TPM_ERR_ABSENT           : u64 = 0xFFFFFD53
  pub let TPM_ERR_NOT_CRB          : u64 = 0xFFFFFD54
  pub let TPM_ERR_LOCALITY_FAILED  : u64 = 0xFFFFFD55
  pub let TPM_ERR_CMD_TIMEOUT      : u64 = 0xFFFFFD56
  pub let TPM_ERR_BAD_RESPONSE     : u64 = 0xFFFFFD57

  // ==========================================================================
  // §F  Poll bound -- iterations the real-body FSM will spin before
  //      declaring a phase-timeout.
  //
  // TPM 2.0 Part 1 §A.1 "Command-Processing Durations" sets the
  // longest tier-1 command duration at 20 ms (TPM_CC_Clear /
  // TPM_CC_SelfTest); every other command this driver issues is
  // short (TPM_CC_GetCapability < 1 ms, TPM_CC_PCR_Extend < 2 ms).
  // 65_536 iterations x ~300 ns per MMIO read on a Raptor Lake PCH-H
  // approx 20 ms, which matches the longest expected envelope. Named
  // here so the real-body slice has a settled constant and so a
  // tester can grep the number if a controller is observed to be
  // slower in the wild (which has happened on some SPI-TPM chips --
  // not fTPM, but a future tpm_tis.pdx may want a bigger bound).
  //
  // The skeleton does not spin; the constant is published so the
  // golden assertions carry the right magnitude from day one.
  // ==========================================================================

  pub let TPM_POLL_MAX : u64 = 65536

  // ==========================================================================
  // §G  Mutable state -- one TPM per machine, confined to this object
  //      (tools/build.sh's `objdump -r` symbol-confinement pass asserts
  //      no other object may relocate against these symbols).
  //
  // The real-body slice generalises to `[u64; N]` only if a machine
  // ships with two TPMs (not currently observed on any shipped
  // x86_64 platform -- the spec permits ONE discrete TPM plus the
  // fTPM-in-CSME, but the fTPM is the one that answers the ACPI
  // TPM2 table and the discrete chip, when present, is reached via a
  // separate ACPI DEV table that is Industry-Vertical and not
  // tier-1-paideia territory). Today the T14 G4 case is one, and a
  // scalar is honest.
  //
  // Fields:
  //   _tpm_mmio_base    the MMIO base passed to tpm_crb_init; 0 means
  //                      "not initialised"
  //   _tpm_locality     the locality number this driver claimed; 0 on
  //                      the standard path, left as a field so a
  //                      future DRTM driver can read what the OS-
  //                      runtime driver claimed
  //   _tpm_intf_type    INTF_ID[3:0] observed at init; 1 = CRB, 0 =
  //                      FIFO (and tpm_crb_init refuses in that case)
  //   _tpm_inited       1 iff tpm_crb_init has been called successfully
  //   _tpm_last_cmd_code the last TPM_CC_* value seen by tpm_crb_submit
  //   _tpm_last_rc      the last response-code (TPM_RC_* or one of our
  //                      0xFFFFFD5* bands) emitted by tpm_crb_submit
  //   _tpm_init_ct      successful tpm_crb_init count
  //   _tpm_submit_ct    successful tpm_crb_submit count
  //   _tpm_get_cap_ct   successful tpm_crb_get_capability count
  //   _tpm_extend_ct    successful tpm_crb_pcr_extend_7 count
  //   _tpm_timeout_ct   timeouts observed across all transaction paths
  // ==========================================================================

  pub let mut _tpm_mmio_base     : u64 = 0
  pub let mut _tpm_locality      : u64 = 0
  pub let mut _tpm_intf_type     : u64 = 0
  pub let mut _tpm_inited        : u64 = 0
  pub let mut _tpm_last_cmd_code : u64 = 0
  pub let mut _tpm_last_rc       : u64 = 0
  pub let mut _tpm_init_ct       : u64 = 0
  pub let mut _tpm_submit_ct     : u64 = 0
  pub let mut _tpm_get_cap_ct    : u64 = 0
  pub let mut _tpm_extend_ct     : u64 = 0
  pub let mut _tpm_timeout_ct    : u64 = 0

  // ==========================================================================
  // §H  Fingerprint tags + keys
  //
  //   TPM INIT intf=<dec> loc=<dec>
  //   TPM SUBMIT cmd_code=0x<8-hex> rc=0x<8-hex>
  //   TPM PCR7_EXTEND digest=0x<16-hex>
  //
  // Single-line `pub let` string literals per the pdx-encoder-pitfalls
  // memory 2026-09-26: a `pub let x = "..."` split across lines is
  // parsed as two declarations.
  //
  // Tag lengths: strlen + 1 (nul).
  //   "TPM INIT"         = 8 chars  -> [u8; 9]
  //   "TPM SUBMIT"       = 10 chars -> [u8; 11]
  //   "TPM PCR7_EXTEND"  = 15 chars -> [u8; 16]
  //   "intf"             = 4 chars  -> [u8; 5]
  //   "loc"              = 3 chars  -> [u8; 4]
  //   "cmd_code"         = 8 chars  -> [u8; 9]
  //   "rc"               = 2 chars  -> [u8; 3]
  //   "digest"           = 6 chars  -> [u8; 7]
  // ==========================================================================

  pub let tpm_tag_init    : [u8; 9]  = "TPM INIT\0"
  pub let tpm_tag_submit  : [u8; 11] = "TPM SUBMIT\0"
  pub let tpm_tag_extend  : [u8; 16] = "TPM PCR7_EXTEND\0"
  pub let tpm_k_intf      : [u8; 5]  = "intf\0"
  pub let tpm_k_loc       : [u8; 4]  = "loc\0"
  pub let tpm_k_cmd_code  : [u8; 9]  = "cmd_code\0"
  pub let tpm_k_rc        : [u8; 3]  = "rc\0"
  pub let tpm_k_digest    : [u8; 7]  = "digest\0"

  // ==========================================================================
  // §I  tpm_crb_init(mmio_base) -> u64
  //
  // SKELETON: gate on (mmio_base != 0), latch mmio_base, latch
  // locality 0, latch intf_type = CRB (1 at skeleton; the real body
  // reads INTF_ID[3:0] from `mmio_base + TPM_CRB_INTF_ID`), bump
  // _tpm_init_ct, flip _tpm_inited, emit the INIT fingerprint,
  // return TPM_OK.
  //
  // Real body sequence (deferred to follow-up slice):
  //
  //   (1) Read LOC_STATE at mmio_base+0x0; if the read returns
  //       0xFFFFFFFF, the window is unmapped -> TPM_ERR_ABSENT.
  //   (2) Read INTF_ID at mmio_base+0x30; if (val & 0xF) != 1 ->
  //       TPM_ERR_NOT_CRB (a future tpm_tis.pdx handles the FIFO case).
  //   (3) Write LOC_CTRL.requestAccess = 1 at mmio_base+0x8; poll
  //       LOC_STATE.locAssigned at mmio_base+0x0 until bit1 == 1,
  //       bounded by TPM_POLL_MAX. On timeout -> TPM_ERR_LOCALITY_FAILED.
  //   (4) Write CTRL_REQ.cmdReady = 1 at mmio_base+0x40 to arm the
  //       command buffer.
  //   (5) Latch mmio_base, locality, intf_type into the state slots.
  //   (6) Bump _tpm_init_ct, flip _tpm_inited.
  //   (7) Emit the INIT fingerprint.
  //
  // No arguments. SysV: rdi = mmio_base.
  // Register plan: 2 pushes (rbx, r12). r12 = mmio_base saved across
  // the fingerprint call. Entry rsp%16==8; after 2 pushes rsp%16==8;
  // one `sub rsp, 16; mov [rsp+0], v2; call; add rsp, 16` recipe
  // around klog_s1_d2 (per pdx-encoder-pitfalls 2026-09-26: v2 at
  // caller [rsp+0] NOT [rsp+8]) aligns the CALL to %16==0.
  // Labels prefixed `tci_`.
  // ==========================================================================

  pub let tpm_crb_init : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (mmio_base: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: latch mmio_base, locality 0, interface type CRB (1); bump _tpm_init_ct; flip _tpm_inited; emit the INIT fingerprint. Gate: mmio_base == 0 -> TPM_ERR_ABSENT (the common boot-time case before the ACPI TPM2 table has been parsed and before Wave 71 D5's walker has handed us a base). The real-body slice adds the three live MMIO reads (LOC_STATE for presence probe, INTF_ID for CRB vs FIFO classification, LOC_STATE poll for locality claim) + one write (LOC_CTRL.requestAccess) + one write (CTRL_REQ.cmdReady). At skeleton stage all four are deferred because the port-I/O capability (KIND_MEMORY over 0xFED40000..0xFED45FFF) has no caller that mints it yet -- the ACPI walker lands its first MMIO cap mint in the follow-up slice. Register plan: 2-push callee-save prologue (rbx scratch, r12 = mmio_base saved across the klog_s1_d2 CALL). Entry rsp%16==8; after 2 pushes rsp%16==8; the `sub rsp,16; mov [rsp+0],v2; call; add rsp,16` recipe adjusts to %16==0 at CALL and reclaims the 16 B in one shot after. v2 is the LOCALITY (second decimal field in the fingerprint); v1 is INTF_TYPE (first decimal field, passed in r8). Labels prefixed `tci_`.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;                        // mmio_base

        // --- Gate: mmio_base == 0 means ACPI TPM2 table absent or
        //      the ACPI walker has not yet produced a base.
        cmp r12, 0;
        je  tci_absent;

        // --- Latch mmio_base, locality 0, intf_type CRB.
        mov [rip + _tpm_mmio_base], r12;
        xor rax, rax;                        // locality 0
        mov [rip + _tpm_locality], rax;
        mov rax, 1;                          // TPM_INTF_CRB
        mov [rip + _tpm_intf_type], rax;

        // --- Bump _tpm_init_ct.
        mov rax, [rip + _tpm_init_ct];
        add rax, 1;
        mov [rip + _tpm_init_ct], rax;

        // --- Flip _tpm_inited (last, so a re-init call sees the
        //      bumped counter first -- same discipline as ec.pdx).
        mov rax, 1;
        mov [rip + _tpm_inited], rax;

        // --- Emit INIT fingerprint: TPM INIT intf=<dec> loc=<dec>
        //      klog_s1_d2 signature:
        //        rdi = level (3 = LEVEL_INFO)
        //        rsi = subsys_ptr (SUBSYS_DRV_)
        //        rdx = tag_ptr
        //        rcx = k1_ptr, r8 = v1 (intf, decimal)
        //        r9  = k2_ptr
        //        [rsp+0] = v2 (loc, decimal) -- NOT [rsp+8]
        //      Per pdx-encoder-pitfalls 2026-09-26 entry on
        //      klog_s1_d2: the wrapper reads v2 from [rbp+16] after
        //      its own push rbp, which from the caller is the slot
        //      directly at [rsp+0] after a `sub rsp, 16`.
        sub rsp, 24;                         // 2 pushes => %16==8; +24 => %16==0 at CALL
        mov rax, [rip + _tpm_locality];
        mov [rsp + 0], rax;                  // v2 = locality
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + tpm_tag_init];
        lea rcx, [rip + tpm_k_intf];
        mov r8,  [rip + _tpm_intf_type];     // v1 = intf type
        lea r9,  [rip + tpm_k_loc];
        call klog_s1_d2;
        add rsp, 24;

        xor rax, rax;                        // TPM_OK
        pop r12;
        pop rbx;
        ret;

      tci_absent:
        mov rax, 0xFFFFFD53;                 // TPM_ERR_ABSENT
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  tpm_crb_submit(cmd_ptr, cmd_len, resp_ptr, resp_len) -> u64
  //
  // SKELETON: gate on (inited AND cmd_len >= 10 AND cmd_len <=
  // TPM_DATA_BUFFER_MAX AND resp_len >= 10 AND resp_len <=
  // TPM_DATA_BUFFER_MAX), extract cmd_code from the command header
  // (bytes 6..10, big-endian u32), stash into _tpm_last_cmd_code,
  // record _tpm_last_rc = TPM_RC_SUCCESS as the stub result, bump
  // _tpm_submit_ct, emit the SUBMIT fingerprint, return TPM_OK.
  //
  // Real body sequence (deferred to follow-up slice):
  //
  //   (1) Copy cmd_ptr[0..cmd_len] into mmio_base+TPM_CRB_DATA_BUFFER.
  //       Byte-for-byte, no byte-swap: the caller composed the command
  //       in big-endian wire format already (TPM 2.0 Part 1 §16).
  //   (2) Write CTRL_CMD_SIZE = cmd_len at mmio_base+0x58.
  //   (3) Write CTRL_CMD_LADDR = low32(mmio_base + DATA_BUFFER) at
  //       mmio_base+0x5C and CTRL_CMD_HADDR = high32 at mmio_base+0x60.
  //       (A CRB-interface TPM can also DMA from a separate buffer;
  //       for the in-line case these point back into DATA_BUFFER.)
  //   (4) Write CTRL_RSP_SIZE = resp_len at mmio_base+0x64 and
  //       CTRL_RSP_ADDR = DATA_BUFFER PA at mmio_base+0x68.
  //   (5) Write CTRL_START.bit0 = 1 at mmio_base+0x4C to launch.
  //   (6) Poll CTRL_STS.tpmSts (bit0) at mmio_base+0x44 until it
  //       reads 0 (meaning "controller is no longer busy"), bounded
  //       by TPM_POLL_MAX. On timeout -> TPM_ERR_CMD_TIMEOUT.
  //   (7) Read response-size (bytes 2..6 of DATA_BUFFER, big-endian);
  //       if size > resp_len or size < 10 -> TPM_ERR_BAD_RESPONSE.
  //   (8) Copy mmio_base+DATA_BUFFER[0..response_size] into
  //       resp_ptr. Read the TPM_RC (big-endian u32 at response
  //       bytes 6..10) into _tpm_last_rc.
  //   (9) Bump _tpm_submit_ct, emit the fingerprint.
  //
  // SysV: rdi = cmd_ptr, rsi = cmd_len, rdx = resp_ptr, rcx = resp_len.
  // Register plan: 5 pushes (rbx, r12=cmd_ptr, r13=cmd_len, r14=
  // resp_ptr, r15=resp_len). Entry rsp%16==8; after 5 pushes
  // rsp%16==0; klog_s1_x2 takes one stack arg (v2 at caller [rsp+0]
  // NOT [rsp+8]) via the sub-16 recipe. Labels prefixed `tcs_`.
  // ==========================================================================

  pub let tpm_crb_submit : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (cmd_ptr: u64, cmd_len: u64, resp_ptr: u64, resp_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: core TPM command-submit stub. Gates in order so an operator sees the first failure: (1) _tpm_inited == 0 -> TPM_ERR_ABSENT (uninit maps to the ABSENT code because at skeleton stage the two conditions are indistinguishable: no mmio_base latched means no probe happened means no evidence of a chip; the real body separates them by actually reading LOC_STATE); (2) cmd_len < TPM_HEADER_SIZE (10) -> TPM_ERR_BAD_RESPONSE (a sub-10-byte command cannot carry a tag+size+cc triple so there is nothing to submit; this uses BAD_RESPONSE rather than a new code because the condition is symmetric with the response-undersize branch -- the issue text reserves exactly 5 codes and this re-uses one); (3) cmd_len > TPM_DATA_BUFFER_MAX -> TPM_ERR_BAD_RESPONSE (3968 bytes is the architectural DATA_BUFFER ceiling; a larger command cannot fit); (4) resp_len < TPM_HEADER_SIZE or resp_len > TPM_DATA_BUFFER_MAX -> same code (symmetric with the cmd gates). Extract cmd_code from the command header's bytes 6..10 (big-endian u32): the real body uses `mov_d` + `bswap` here; the skeleton does a byte-shuffle via four `movzx` + `shl` + `or` because cmd_ptr may not be MMIO-aligned (a TPM command composed in a userspace page could sit at ANY 1-byte alignment). But at SKELETON stage we DO NOT TRUST the caller's cmd_ptr (it may be 0, or point to kernel memory, or not have the capability to be dereferenced yet); we therefore record a SYNTHETIC cmd_code of 0 and defer the actual byte read to the follow-up slice that lands the KIND_MEMORY-backed access. _tpm_last_rc records TPM_RC_SUCCESS (0) as the stub result. Register plan: 5-push callee-save prologue (rbx scratch, r12=cmd_ptr, r13=cmd_len, r14=resp_ptr, r15=resp_len). Entry rsp%16==8; after 5 pushes rsp%16==0 so the klog_s1_x2 CALL is aligned without pad; the sub-16 recipe around klog_s1_x2 (v2 at caller [rsp+0]) adjusts for the one stack arg. v1 = cmd_code (hex), v2 = rc (hex). The _tpm_last_cmd_code and _tpm_last_rc latches are set BEFORE the fingerprint CALL so the fingerprint reads from memory, matching ec.pdx's `ec_handler_opregion` discipline. Labels prefixed `tcs_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // cmd_ptr
        mov r13, rsi;                        // cmd_len
        mov r14, rdx;                        // resp_ptr
        mov r15, rcx;                        // resp_len

        // --- (1) inited?
        mov rax, [rip + _tpm_inited];
        cmp rax, 0;
        je  tcs_absent;

        // --- (2) cmd_len >= TPM_HEADER_SIZE (10)?
        cmp r13, 10;
        jb  tcs_bad_resp;

        // --- (3) cmd_len <= TPM_DATA_BUFFER_MAX?
        mov rax, 3968;                       // TPM_DATA_BUFFER_MAX
        cmp r13, rax;
        ja  tcs_bad_resp;

        // --- (4a) resp_len >= TPM_HEADER_SIZE?
        cmp r15, 10;
        jb  tcs_bad_resp;

        // --- (4b) resp_len <= TPM_DATA_BUFFER_MAX?
        mov rax, 3968;                       // TPM_DATA_BUFFER_MAX
        cmp r15, rax;
        ja  tcs_bad_resp;

        // --- Record synthetic cmd_code = 0 (stub: real body reads
        //      the big-endian u32 at cmd_ptr+6, bswaps it, stores
        //      here).
        xor rax, rax;
        mov [rip + _tpm_last_cmd_code], rax;

        // --- Record synthetic rc = TPM_RC_SUCCESS (0).
        xor rax, rax;
        mov [rip + _tpm_last_rc], rax;

        // --- Bump _tpm_submit_ct.
        mov rax, [rip + _tpm_submit_ct];
        add rax, 1;
        mov [rip + _tpm_submit_ct], rax;

        // --- Emit SUBMIT fingerprint: TPM SUBMIT cmd_code=hex rc=hex
        //      klog_s1_x2 signature (stack: [rsp+0] = v2 = rc):
        //        sub rsp, 16; mov [rsp+0], rc
        //        rdi = level, rsi = subsys, rdx = tag,
        //        rcx = k1 (cmd_code key), r8 = v1 (cmd_code),
        //        r9 = k2 (rc key)
        sub rsp, 16;
        mov rax, [rip + _tpm_last_rc];
        mov [rsp + 0], rax;                  // v2 = rc
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + tpm_tag_submit];
        lea rcx, [rip + tpm_k_cmd_code];
        mov r8,  [rip + _tpm_last_cmd_code]; // v1 = cmd_code
        lea r9,  [rip + tpm_k_rc];
        call klog_s1_x2;
        add rsp, 16;

        xor rax, rax;                        // TPM_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      tcs_absent:
        mov rax, 0xFFFFFD53;                 // TPM_ERR_ABSENT
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      tcs_bad_resp:
        mov rax, 0xFFFFFD57;                 // TPM_ERR_BAD_RESPONSE
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  tpm_crb_get_capability(property) -> u64
  //
  // SKELETON: gate on inited; stash property into _tpm_last_cmd_code
  // (so the fingerprint has a trace of which property was asked);
  // bump _tpm_get_cap_ct; return TPM_OK. The real body builds a
  // 22-byte TPM2_GetCapability command (header 10 B + capability 4 B
  // + property 4 B + propertyCount 4 B), submits it via
  // `tpm_crb_submit`, parses the response's TPML_TAGGED_TPM_PROPERTY
  // structure and returns the first property value.
  //
  // The DEFAULT consumer calls this with property =
  // TPM_PT_FAMILY_INDICATOR to probe "is this a TPM 2.0?" (expected
  // return in the real body: the ASCII string "2.0" packed into a
  // u32, i.e. 0x322E3000). At skeleton stage the return is TPM_OK
  // which the caller interprets as "the fingerprint shows I asked
  // for it".
  //
  // SysV: rdi = property. Two pushes. Labels prefixed `tcg_`.
  // ==========================================================================

  pub let tpm_crb_get_capability : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (property: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: TPM2_GetCapability stub. Gate on inited; refuse with TPM_ERR_ABSENT if not. Stash property into _tpm_last_cmd_code so the SUBMIT fingerprint (which this entrypoint does NOT emit directly -- the real body goes through tpm_crb_submit which emits its own fingerprint) has a shadow trace. Bump _tpm_get_cap_ct. The ACTUAL command this will build in the real body: tag=TPM_ST_NO_SESSIONS, size=22, cc=TPM_CC_GetCapability, capability=TPM_CAP_TPM_PROPERTIES (6), property=caller's arg, propertyCount=1 -- all BIG-ENDIAN on the wire, byte-swapped from host order via `bswap`. The response is a TPML_TAGGED_TPM_PROPERTY with one element whose property field matches the request. At SKELETON stage no command is built because the KIND_MEMORY-backed cmd buffer has no caller yet. Register plan: 2-push callee-save prologue (rbx = property saved). Entry rsp%16==8; after 2 pushes rsp%16==8; no nested CALL fires in the skeleton so alignment is only paid in the follow-up slice. Labels prefixed `tcg_`.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                        // property

        // --- Gate: inited?
        mov rax, [rip + _tpm_inited];
        cmp rax, 0;
        je  tcg_absent;

        // --- Stash property as the shadow cmd_code trace.
        mov [rip + _tpm_last_cmd_code], rbx;

        // --- Bump _tpm_get_cap_ct.
        mov rax, [rip + _tpm_get_cap_ct];
        add rax, 1;
        mov [rip + _tpm_get_cap_ct], rax;

        xor rax, rax;                        // TPM_OK
        pop r12;
        pop rbx;
        ret;

      tcg_absent:
        mov rax, 0xFFFFFD53;                 // TPM_ERR_ABSENT
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §L  tpm_crb_pcr_extend_7(digest_ptr) -> u64
  //
  // SKELETON: gate on (inited AND digest_ptr != 0); read the first 8
  // bytes at digest_ptr as the fingerprint witness value (truncated
  // SHA-256); bump _tpm_extend_ct; emit the PCR7_EXTEND fingerprint;
  // return TPM_OK. The real body builds a TPM2_PCR_Extend command
  // (header 10 B + pcrHandle 4 B + authSize 4 B + authArea N B +
  // digests TPML_DIGEST_VALUES {count=1, {hashAlg=TPM_ALG_SHA256,
  // digest 32 B}}), submits it via tpm_crb_submit, verifies the
  // response rc == TPM_RC_SUCCESS, and returns.
  //
  // This is the entrypoint I7 KIND_FIRMWARE_BLOB (Wave 73) will call
  // on successful mount per its TODO at
  // src/kernel/core/cap/kind_firmware_blob.pdx:663,791.
  //
  // SKELETON NOTE: digest_ptr may be a NULL in call sites that have
  // not yet been plumbed. We refuse with TPM_ERR_ABSENT (not TPM_ERR_
  // BAD_RESPONSE) in that case because the condition means "no
  // digest to extend" which is a plumbing issue upstream, not a
  // response-shape issue.
  //
  // SysV: rdi = digest_ptr. Two pushes. Labels prefixed `tcp_`.
  // ==========================================================================

  pub let tpm_crb_pcr_extend_7 : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (digest_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: PCR 7 extend stub. Gate on (inited AND digest_ptr != 0). Read the first 8 bytes at digest_ptr -- the leading u64 of the SHA-256 digest -- as the fingerprint witness value. Bump _tpm_extend_ct. Emit the PCR7_EXTEND fingerprint with the truncated digest as a single hex KV. The real body builds a TPM2_PCR_Extend command: tag=TPM_ST_SESSIONS (because PCR extend requires a session), size=37 bytes minimum, cc=TPM_CC_PCR_Extend, pcrHandle=TPM_PCR_7 (7), authSize=9, authArea={TPM_RS_PW (0x40000009), nonce.size=0, sessionAttributes=0, hmac.size=0}, digests.count=1, digests.digests[0]={hashAlg=TPM_ALG_SHA256, digest=32 bytes read from digest_ptr} -- all BIG-ENDIAN on the wire. On a NULL digest_ptr refusal we use TPM_ERR_ABSENT rather than minting a new 'bad arg' code because the condition is upstream plumbing (I7 KIND_FIRMWARE_BLOB has not yet wired its mount path to this call) rather than TPM-side. Register plan: 2-push callee-save prologue (rbx = digest_ptr saved across the fingerprint call, r12 scratch). Entry rsp%16==8; after 2 pushes rsp%16==8; klog_s1_x1 is a NO-stack-arg wrapper so the CALL aligns via one more sub-8 (klog_s1_x1 takes exactly 5 register args -- level/subsys/tag/k1/v1 -- no stack). But paideia-as 5-arg CALL alignment: entry rsp%16==8, after 2 pushes rsp%16==8, so a `sub rsp, 8` right before CALL brings rsp%16==0. Then `add rsp, 8` after. Labels prefixed `tcp_`.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                        // digest_ptr

        // --- Gate 1: inited?
        mov rax, [rip + _tpm_inited];
        cmp rax, 0;
        je  tcp_absent;

        // --- Gate 2: digest_ptr != 0?
        cmp rbx, 0;
        je  tcp_absent;

        // --- Read the leading u64 of the digest (the witness value
        //      that the fingerprint will carry). The caller's digest
        //      is 32 bytes big-endian; the host read is little-endian,
        //      so this value is the "host view" of the first 8
        //      digest bytes -- NOT the TPM's view. A reviewer
        //      reconciling fingerprint vs on-wire bytes should bswap
        //      mentally. The real-body slice bswaps before storing
        //      so the fingerprint is TPM-wire-consistent; today we
        //      skip the bswap because the skeleton has no wire.
        mov r12, [rbx + 0];                  // r12 = first 8 bytes

        // --- Bump _tpm_extend_ct.
        mov rax, [rip + _tpm_extend_ct];
        add rax, 1;
        mov [rip + _tpm_extend_ct], rax;

        // --- Emit PCR7_EXTEND fingerprint: digest=0x<16-hex>
        //      klog_s1_x1 signature (no stack args):
        //        rdi = level, rsi = subsys, rdx = tag, rcx = k1,
        //        r8 = v1 (digest)
        //      Alignment: rsp%16==8 after 2 pushes; sub rsp,8 to
        //      bring %16==0 for CALL, then add rsp,8 after.
        sub rsp, 8;
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + tpm_tag_extend];
        lea rcx, [rip + tpm_k_digest];
        mov r8,  r12;                        // v1 = first 8 bytes
        call klog_s1_x1;
        add rsp, 8;

        xor rax, rax;                        // TPM_OK
        pop r12;
        pop rbx;
        ret;

      tcp_absent:
        mov rax, 0xFFFFFD53;                 // TPM_ERR_ABSENT
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §M  cap_handler_tpm_crb(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch stub the KIND_TPM_CRB (0x4E) arm in cap/invoke.pdx
  // calls. Routes by op_arg's low byte:
  //
  //   op == TPM_OP_INIT       (1) -> tpm_crb_init(op_arg >> 8)
  //                                   (the mmio_base is passed in the
  //                                   high 56 bits of op_arg; a real
  //                                   mmio_base is >=0xFED40000 and
  //                                   fits comfortably)
  //   op == TPM_OP_SUBMIT     (2) -> INVOKE_UNSUPPORTED at skeleton
  //                                   (the four pointer args do not
  //                                   fit in op_arg; the follow-up
  //                                   slice adds a KIND_TPM_CRB_SUBMIT
  //                                   capability with the four args
  //                                   stored in the capability row)
  //   op == TPM_OP_GET_CAP    (3) -> tpm_crb_get_capability(op_arg >> 8)
  //   op == TPM_OP_PCR_EXTEND (4) -> tpm_crb_pcr_extend_7(op_arg >> 8)
  //                                   (digest_ptr fits in a kernel VA
  //                                   which is a canonical sign-
  //                                   extended 48-bit value in the
  //                                   upper half; op_arg >> 8 preserves
  //                                   enough bits for the real-body
  //                                   slice to narrow to a cap row id
  //                                   if the follow-up chooses)
  //   otherwise                    -> INVOKE_UNSUPPORTED
  //
  // Rights and target_ptr are IGNORED at skeleton stage; the follow-
  // up slice may add a rights gate (R_TPM_SUBMIT / R_TPM_EXTEND) once
  // the KIND_TPM_CRB cap is minted against a specific principal. The
  // signature carries both so that slice does not need to re-plumb
  // the ABI.
  //
  // SysV: rdi = rights, rsi = target_ptr, rdx = op_arg. Register
  // plan: 3-push callee-save prologue (rbx = op_arg preserved, r12 =
  // op code, r13 scratch). Labels prefixed `tch_`.
  // ==========================================================================

  pub let cap_handler_tpm_crb : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: cap-table dispatch stub for KIND_TPM_CRB (0x4E). The cmp-chain over {1,2,3,4} is one branch per legal op (not a jump table) because four live values occupy less bytecode as a chain. tpm_crb_init, tpm_crb_get_capability, tpm_crb_pcr_extend_7 each take one argument unpacked from `op_arg >> 8`: op_arg's low byte names the op; the next 56 bits carry the argument (mmio_base, property, or digest_ptr). Same encoding ec_discovery.pdx uses for its op-arg demux. tpm_crb_submit cannot be dispatched this way because its four pointer args do not fit in 56 bits; a dedicated KIND_TPM_CRB_SUBMIT cap in the follow-up slice carries the four fields in its row. The op is masked to the low byte via `and r12, 0xFF` on entry so a caller that leaves garbage in the high bytes of op_arg does not accidentally match. Unknown op returns INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC), not a TPM_ERR_* code -- the latter names a wire-protocol bug, this names a cap-dispatch bug. Rights and target_ptr are ACCEPTED but IGNORED at skeleton stage. 3-push prologue (rbx=op_arg saved, r12=op code, r13 scratch) aligns rsp%16==0 for every nested CALL (entry rsp%16==8, after 3 pushes rsp%16==0). Labels prefixed `tch_`.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdx;                        // rbx = op_arg (preserve)
        mov r12, rdx;                        // r12 = op
        and r12, 0xFF;                       // mask to low byte

        // --- Opcode dispatch.
        cmp r12, 1;                          // TPM_OP_INIT
        je  tch_init;
        cmp r12, 2;                          // TPM_OP_SUBMIT
        je  tch_submit;
        cmp r12, 3;                          // TPM_OP_GET_CAP
        je  tch_getcap;
        cmp r12, 4;                          // TPM_OP_PCR_EXTEND
        je  tch_extend;

        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      tch_init:
        mov rdi, rbx;
        shr rdi, 8;                          // mmio_base = op_arg >> 8
        call tpm_crb_init;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      tch_submit:
        // Four-pointer submit cannot be dispatched through a single
        // op_arg at skeleton stage; the follow-up slice adds a
        // dedicated KIND_TPM_CRB_SUBMIT cap whose row carries the
        // four fields. Refuse with INVOKE_UNSUPPORTED so a caller
        // sees a cap-dispatch refusal rather than a TPM-side error.
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        pop r13;
        pop r12;
        pop rbx;
        ret;

      tch_getcap:
        mov rdi, rbx;
        shr rdi, 8;                          // property = op_arg >> 8
        call tpm_crb_get_capability;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      tch_extend:
        mov rdi, rbx;
        shr rdi, 8;                          // digest_ptr = op_arg >> 8
        call tpm_crb_pcr_extend_7;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §N  Stat getters -- single-load leaves for witness callers
  //
  // Parallel to ec.pdx / ec_discovery.pdx getter sets. A boot witness
  // can assert
  //
  //   tpm_crb_inited()         == 1
  //   AND tpm_crb_init_count()    >= 1
  //   AND tpm_crb_mmio_base_q()   != 0
  //   AND tpm_crb_intf_type()     == TPM_INTF_CRB
  //   AND tpm_crb_locality()      == 0
  //   AND tpm_crb_submit_count()  <= some bound a smoke run sets
  //   AND tpm_crb_extend_count()  <= some bound a smoke run sets
  //
  // after a smoke run that drives cap_handler_tpm_crb a known number
  // of times.
  // ==========================================================================

  pub let tpm_crb_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_inited. Non-zero after the first successful tpm_crb_init. Leaf.",
      block: { mov rax, [rip + _tpm_inited]; ret }
    }

  pub let tpm_crb_mmio_base_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_mmio_base. Zero until the first successful tpm_crb_init; thereafter the latched base. Named `_q` to match the ec/hda `*_q` getter convention. Leaf.",
      block: { mov rax, [rip + _tpm_mmio_base]; ret }
    }

  pub let tpm_crb_locality : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_locality. Zero on the OS-runtime path; distinguishes a future DRTM driver that claims locality 2. Leaf.",
      block: { mov rax, [rip + _tpm_locality]; ret }
    }

  pub let tpm_crb_intf_type : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_intf_type. TPM_INTF_CRB (1) on the T14 G4 fTPM path; TPM_INTF_FIFO (0) means tpm_crb_init refused and a future tpm_tis.pdx driver should take over. Leaf.",
      block: { mov rax, [rip + _tpm_intf_type]; ret }
    }

  pub let tpm_crb_last_cmd_code : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_last_cmd_code. The TPM_CC_* value of the last command this driver submitted, or the property index of the last get_capability call. Zero at skeleton stage (synthetic) until the real body reads it from the command header. Leaf.",
      block: { mov rax, [rip + _tpm_last_cmd_code]; ret }
    }

  pub let tpm_crb_last_rc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_last_rc. TPM_RC_SUCCESS (0) at skeleton stage; the real body carries the TPM-side rc read out of the response header. Leaf.",
      block: { mov rax, [rip + _tpm_last_rc]; ret }
    }

  pub let tpm_crb_init_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_init_ct. Bumped once per successful tpm_crb_init. Leaf.",
      block: { mov rax, [rip + _tpm_init_ct]; ret }
    }

  pub let tpm_crb_submit_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_submit_ct. Bumped once per successful tpm_crb_submit. Leaf.",
      block: { mov rax, [rip + _tpm_submit_ct]; ret }
    }

  pub let tpm_crb_get_cap_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_get_cap_ct. Bumped once per successful tpm_crb_get_capability. Leaf.",
      block: { mov rax, [rip + _tpm_get_cap_ct]; ret }
    }

  pub let tpm_crb_extend_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_extend_ct. Bumped once per successful tpm_crb_pcr_extend_7. Leaf.",
      block: { mov rax, [rip + _tpm_extend_ct]; ret }
    }

  pub let tpm_crb_timeout_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os#2566 (Wave 59 I9) skeleton: single-load getter for _tpm_timeout_ct. The real body bumps this once per CTRL_STS.tpmSts poll bust or per LOC_STATE.locAssigned poll bust; the skeleton never does, so this returns 0 until the follow-up slice lands. Leaf.",
      block: { mov rax, [rip + _tpm_timeout_ct]; ret }
    }

}
