// src/kernel/core/drivers/gpu/hevc_frame.pdx — R37.M8-003 (#1287)
//
// HEVC decode PLUMBING SCAFFOLD -- framework hooks for descriptor
// entry (NAL unit types, slice header fields) without a real HEVC
// codec bind.  A real HEVC codec lands in a later media stack round
// (R44+); this module is the plumbing that lets vcs_engine.pdx count
// frames the decoder would consume without pretending to decode any.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the FRAMEWORK SEAM the media stack will plug into.  The VCS
// engine substrate (vcs_engine.pdx, R37.M8-002) accepts submits from
// any codec; HEVC-specific frame descriptors need typed fields the
// engine substrate should not carry (NAL unit type, temporal id,
// SPS/PPS ids, slice header offsets).  This module accepts those
// descriptors, VALIDATES their structural fields, records the
// frame in a ring buffer, and STOPS THERE -- no reconstruction, no
// motion compensation, no in-loop filter.
//
// IT DOES NOT DECODE A FRAME.  The decode-picture-buffer, the
// deblock kernel, the CABAC engine and the SAO filter all live in
// the future R44 media stack.  This module refuses hevc_frame_decode
// with HEVC_DEFERRED and reports HEVC_ST_DEFERRED counts so an
// operator sees the framework is exercised even before the decoder
// arrives.
//
// IT DOES NOT MINT KIND_HEVC_FRAME.  The kind belongs to the media
// stack round; this module accepts a caller-owned descriptor pointer
// and records the frame in a bounded ring the caller reads back
// through hevc_frame_last_*.
//
// IT DOES NOT TALK TO VCS.  The two modules communicate through the
// frame counter (vcs.hevc_frames_seen equivalent) exposed via
// hevc_frames_admitted().  A future R44 consumer wires the two.
//
// hevc_arbitrated() returns 0 until the real HEVC codec binds.
//
// =============================================================================
// §1  NAL UNIT TYPE ENUMERATION (H.265 §7.4.2)
// =============================================================================
//
//   TRAIL_N   = 0    TRAIL_R    = 1
//   TSA_N     = 2    TSA_R      = 3
//   STSA_N    = 4    STSA_R     = 5
//   RADL_N    = 6    RADL_R     = 7
//   RASL_N    = 8    RASL_R     = 9
//   BLA_W_LP  = 16   BLA_W_RADL = 17   BLA_N_LP  = 18
//   IDR_W_RADL= 19   IDR_N_LP   = 20
//   CRA_NUT   = 21
//   VPS_NUT   = 32   SPS_NUT    = 33   PPS_NUT   = 34
//   AUD_NUT   = 35   EOS_NUT    = 36   EOB_NUT   = 37
//   FD_NUT    = 38   PREFIX_SEI = 39   SUFFIX_SEI= 40
//
// Values not listed are RESERVED per H.265 §7.4.2 and refused as
// HEVC_BAD_NAL.  A live decoder consumes VCL NAL units (0..31 with
// bit-0 set to R-suffix) and parses SPS/PPS/VPS out of the non-VCL
// range (32..47); this module classifies but does not consume.
//
// =============================================================================
// §2  SLICE HEADER FIELDS (H.265 §7.3.6.1)
// =============================================================================
//
// The descriptor a caller passes carries the small typed prefix
// this scaffold enforces.  Full slice header parse is a live-decoder
// concern; the scaffold checks the fields whose invalid values
// would misdirect the parser and refuses at the boundary.
//
//   Offset  Field                        Size
//   -------------------------------------------------------------
//   0x00    nal_unit_type                u8    (0..63)
//   0x01    temporal_id_plus1            u8    (1..7 per §7.4.2.2)
//   0x02    slice_pic_parameter_set_id   u8    (0..63)
//   0x03    dependent_slice_segment      u8    (0 or 1)
//   0x04    slice_type                   u8    (0=B, 1=P, 2=I)
//   0x05    reserved                     u8[3]
//   0x08    slice_segment_address        u32
//   0x0C    frame_number                 u32
//   0x10    descriptor_size              u32   (must be >= 0x10)
//
// A descriptor whose descriptor_size < 0x10 is REFUSED as
// BAD_DESC_SIZE (the caller allocated less than the fixed prefix).
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _hevc_ring, _hevc_head, _hevc_admitted, _hevc_stats are written
// only by helpers in this module.  tools/build.sh confines
// relocations against each to core/drivers/gpu/hevc_frame.o.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF500..0xFFFFF50F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: vcs_engine
// 0xFFFFF510..1F; adjacent free band below: gpu_stress
// 0xFFFFF4F0..FF, R37.M8-004).

module HevcFrame = structure {

  // §1: NAL unit type constants (a subset of the H.265 enumeration
  // — the values the scaffold checks against).
  pub let HEVC_NAL_TRAIL_N   : u64 = 0
  pub let HEVC_NAL_TRAIL_R   : u64 = 1
  pub let HEVC_NAL_IDR_W_RADL: u64 = 19
  pub let HEVC_NAL_IDR_N_LP  : u64 = 20
  pub let HEVC_NAL_CRA_NUT   : u64 = 21
  pub let HEVC_NAL_VPS_NUT   : u64 = 32
  pub let HEVC_NAL_SPS_NUT   : u64 = 33
  pub let HEVC_NAL_PPS_NUT   : u64 = 34
  pub let HEVC_NAL_AUD_NUT   : u64 = 35
  pub let HEVC_NAL_MAX       : u64 = 63

  // §2: slice-type constants.
  pub let HEVC_SLICE_TYPE_B : u64 = 0
  pub let HEVC_SLICE_TYPE_P : u64 = 1
  pub let HEVC_SLICE_TYPE_I : u64 = 2

  // §2: descriptor byte offsets.
  pub let HEVC_OFF_NAL_TYPE           : u64 = 0x00
  pub let HEVC_OFF_TEMPORAL_ID_PLUS1  : u64 = 0x01
  pub let HEVC_OFF_PPS_ID             : u64 = 0x02
  pub let HEVC_OFF_DEP_SLICE_SEG      : u64 = 0x03
  pub let HEVC_OFF_SLICE_TYPE         : u64 = 0x04
  pub let HEVC_OFF_SLICE_SEG_ADDR     : u64 = 0x08
  pub let HEVC_OFF_FRAME_NUMBER       : u64 = 0x0C
  pub let HEVC_OFF_DESC_SIZE          : u64 = 0x10

  pub let HEVC_DESC_MIN_SIZE : u64 = 0x10

  // §3: ring size — small bounded window so a runaway caller
  // cannot exhaust .bss.  16 entries * 8 bytes/entry (frame_number
  // snapshot) = 128 bytes.
  pub let HEVC_RING_SIZE : u64 = 16

  // Failure taxonomy -- 0xFFFFF500..0xFFFFF50F.
  pub let HEVC_OK              : u64 = 0
  pub let HEVC_BAD_ARG         : u64 = 0xFFFFF50F
  pub let HEVC_NULL_DESC       : u64 = 0xFFFFF50E
  pub let HEVC_BAD_DESC_SIZE   : u64 = 0xFFFFF50D
  pub let HEVC_BAD_NAL         : u64 = 0xFFFFF50C
  pub let HEVC_BAD_TEMPORAL_ID : u64 = 0xFFFFF50B
  pub let HEVC_BAD_SLICE_TYPE  : u64 = 0xFFFFF50A
  pub let HEVC_BAD_PPS_ID      : u64 = 0xFFFFF509
  pub let HEVC_DEFERRED        : u64 = 0xFFFFF508    // decode requested; scaffold only

  // Ring buffer of recently admitted frame numbers (u64 each).
  pub let mut _hevc_ring     : [u64; 16] = uninit @align(64)
  pub let mut _hevc_head     : [u64; 1]  = uninit @align(64)
  pub let mut _hevc_admitted : [u64; 1]  = uninit @align(64)

  // Counters.
  pub let mut _hevc_stats : [u64; 8] = uninit @align(64)

  pub let HEVC_ST_ADMITS    : u64 = 0
  pub let HEVC_ST_REFUSED   : u64 = 1
  pub let HEVC_ST_DEFERRED  : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let hevc_frame_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-003 (#1287): clear ring + admit counter + stats. Boot and teardown only. Labels prefixed hevc_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _hevc_ring];
        xor rcx, rcx;
      hevc_rs_ring:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  hevc_rs_ring;

        lea r10, [rip + _hevc_head];
        mov [r10 + 0], rax;
        lea r10, [rip + _hevc_admitted];
        mov [r10 + 0], rax;

        lea r10, [rip + _hevc_stats];
        xor rcx, rcx;
      hevc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hevc_rs_stats;
        ret
      }
    }

  pub let hevc_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M8-003 (#1287): honesty pin. Returns 0 until the real HEVC codec binds in R44+.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let hevc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-003 (#1287): counter bump. Labels prefixed hevc_nt_.",
      block: {
        cmp rdi, 8;
        jae hevc_nt_out;
        lea r10, [rip + _hevc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hevc_nt_out:
        ret
      }
    }

  pub let hevc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-003 (#1287): counter read. Labels prefixed hevc_stt_.",
      block: {
        cmp rdi, 8;
        jae hevc_stt_zero;
        lea r10, [rip + _hevc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hevc_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Field validators (§1, §2).
  // ==========================================================================

  pub let hevc_nal_valid : (u64) -> u64 !{} @{} =
    fn (nal_type: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M8-003 (#1287): 1 iff nal_type <= HEVC_NAL_MAX (63). §1. Labels prefixed hevc_nv_.",
      block: {
        cmp rdi, 63;
        ja  hevc_nv_no;
        mov rax, 1;
        ret;
      hevc_nv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hevc_temporal_id_valid : (u64) -> u64 !{} @{} =
    fn (t_id_plus1: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M8-003 (#1287): 1 iff 1 <= t_id_plus1 <= 7 (§7.4.2.2). Labels prefixed hevc_tv_.",
      block: {
        cmp rdi, 1;
        jb  hevc_tv_no;
        cmp rdi, 7;
        ja  hevc_tv_no;
        mov rax, 1;
        ret;
      hevc_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hevc_slice_type_valid : (u64) -> u64 !{} @{} =
    fn (slice_type: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M8-003 (#1287): 1 iff slice_type in {B=0, P=1, I=2}. Labels prefixed hevc_sv_.",
      block: {
        cmp rdi, 2;
        ja  hevc_sv_no;
        mov rax, 1;
        ret;
      hevc_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hevc_frame_admit(desc_ptr) — accept a descriptor into the ring.
  // Refuses:
  //   NULL_DESC        desc_ptr == 0
  //   BAD_DESC_SIZE    descriptor_size < HEVC_DESC_MIN_SIZE
  //   BAD_NAL          nal_unit_type > HEVC_NAL_MAX
  //   BAD_TEMPORAL_ID  temporal_id_plus1 outside [1, 7]
  //   BAD_SLICE_TYPE   slice_type outside {0, 1, 2}
  //   BAD_PPS_ID       slice_pic_parameter_set_id > 63
  //
  // On success:
  //   * ring[head % HEVC_RING_SIZE] <- frame_number
  //   * head += 1
  //   * admitted += 1
  //   * ADMITS counter bumped
  // ==========================================================================

  pub let hevc_frame_admit : (u64) -> u64 !{mem} @{} =
    fn (desc_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-003 (#1287): admit a descriptor. THE ONE WRITER of _hevc_ring / _hevc_head / _hevc_admitted. Labels prefixed hevc_a_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // desc_ptr

        cmp rbx, 0;
        je  hevc_a_null;

        // descriptor_size (u32) at +0x10.
        mov eax, [rbx + 16];
        cmp rax, 0x10;
        jb  hevc_a_bad_size;

        // nal_unit_type (u8) at +0x00.  Zero-extended byte load via
        // xor+mov_b idiom (mov_b does not zero-extend on its own;
        // matches acpi/checksum.pdx §R20-M1-003 discipline).
        xor rax, rax;
        mov_b rax, [rbx + 0];
        mov rdi, rax;
        call hevc_nal_valid;
        cmp rax, 0;
        je  hevc_a_bad_nal;

        // temporal_id_plus1 (u8) at +0x01.
        xor rax, rax;
        mov_b rax, [rbx + 1];
        mov rdi, rax;
        call hevc_temporal_id_valid;
        cmp rax, 0;
        je  hevc_a_bad_temporal;

        // slice_pic_parameter_set_id (u8) at +0x02.
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 63;
        ja  hevc_a_bad_pps;

        // slice_type (u8) at +0x04.
        xor rax, rax;
        mov_b rax, [rbx + 4];
        mov rdi, rax;
        call hevc_slice_type_valid;
        cmp rax, 0;
        je  hevc_a_bad_slice_type;

        // frame_number (u32) at +0x0C.
        mov eax, [rbx + 12];
        mov r12, rax;                    // stashed frame_number

        // head = _hevc_head; slot = head % HEVC_RING_SIZE.
        lea r10, [rip + _hevc_head];
        mov r13, [r10 + 0];              // head
        mov rax, r13;
        and rax, 0xF;                    // mod 16

        // ring[slot] = frame_number.
        lea r10, [rip + _hevc_ring];
        mov [r10 + rax * 8], r12;

        // head += 1.
        lea r10, [rip + _hevc_head];
        add r13, 1;
        mov [r10 + 0], r13;

        // admitted += 1.
        lea r10, [rip + _hevc_admitted];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // ADMITS
        call hevc_note;

        xor rax, rax;
        jmp hevc_a_out;

      hevc_a_null:
        mov rdi, 1;
        call hevc_note;
        mov rax, 0xFFFFF50E;
        jmp hevc_a_out;
      hevc_a_bad_size:
        mov rdi, 1;
        call hevc_note;
        mov rax, 0xFFFFF50D;
        jmp hevc_a_out;
      hevc_a_bad_nal:
        mov rdi, 1;
        call hevc_note;
        mov rax, 0xFFFFF50C;
        jmp hevc_a_out;
      hevc_a_bad_temporal:
        mov rdi, 1;
        call hevc_note;
        mov rax, 0xFFFFF50B;
        jmp hevc_a_out;
      hevc_a_bad_slice_type:
        mov rdi, 1;
        call hevc_note;
        mov rax, 0xFFFFF50A;
        jmp hevc_a_out;
      hevc_a_bad_pps:
        mov rdi, 1;
        call hevc_note;
        mov rax, 0xFFFFF509;

      hevc_a_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hevc_frame_decode(desc_ptr) — always returns HEVC_DEFERRED this
  // milestone.  The framework seam a live decoder will replace.
  // ==========================================================================

  pub let hevc_frame_decode : (u64) -> u64 !{mem} @{} =
    fn (desc_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-003 (#1287): framework seam — returns HEVC_DEFERRED and bumps the DEFERRED counter. The live HEVC codec replaces this body in R44+. Labels prefixed hevc_d_.",
      block: {
        mov rdi, 2;                      // DEFERRED
        call hevc_note;
        mov rax, 0xFFFFF508;
        ret
      }
    }

  // ==========================================================================
  // Accessors.
  // ==========================================================================

  pub let hevc_frames_admitted : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-003 (#1287): cumulative admits. Labels prefixed hevc_fa_.",
      block: {
        lea r10, [rip + _hevc_admitted];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hevc_frame_last : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-003 (#1287): frame_number of the most recently admitted frame, or 0 if none. Labels prefixed hevc_fl_.",
      block: {
        lea r10, [rip + _hevc_head];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  hevc_fl_none;
        sub rax, 1;
        and rax, 0xF;
        lea r10, [rip + _hevc_ring];
        mov rax, [r10 + rax * 8];
        ret;
      hevc_fl_none:
        xor rax, rax;
        ret
      }
    }
}
