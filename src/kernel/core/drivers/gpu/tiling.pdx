// src/kernel/core/drivers/gpu/tiling.pdx — R37.M3-003 (#1264)
//
// GPU tiling-format encoders. For each of the five formats
// (LINEAR, X, Y, TILE4, TILEF) this module exposes the pattern shape
// (tile width and tile height in bytes) and a linear-to-tiled
// address transform that a copy engine (or a CPU staging path) can
// use to place bytes at the correct in-memory offset for a scan-out.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CANONICAL ADDRESS TRANSFORM per tiling format for the
// Iris Xe (Gen12) and Xe2 tiling taxonomies. Every consumer that
// needs to compute a tiled byte offset -- copy engine, CPU shadow
// staging, compositor buffer inspector -- routes through this
// module. A second copy of the arithmetic would let one path use a
// Y-tile stride while another used a Tile4 stride, and every buffer
// produced by the first and read by the second would silently be
// swizzled wrong.
//
// IT DOES NOT ALLOCATE STORAGE. The caller supplies the linear byte
// offset and receives the tiled byte offset for a given (x, y) pixel
// position at a given pixel stride. The BO backing storage is owned
// by bo_alloc.pdx and named by KIND_GPU_BO.
//
// IT DOES NOT VALIDATE PIXEL FORMATS. Pixel stride in bytes is the
// unit the module speaks; the format-aware validator lives one layer
// up (kind_display_plane.pdx §1e for scan-out; kind_gpu_bo.pdx §1f
// for the format hint the caller stamps on a BO).
//
// =============================================================================
// §1  THE FIVE PATTERNS
// =============================================================================
//
// LINEAR (fmt=0):
//   No swizzle. `linear_offset = y * stride + x * bpp`. The identity
//   transform, kept explicit so a caller does not have to branch on
//   fmt before calling.
//
// X-TILED (fmt=1):
//   Intel legacy, 512-byte strip pattern. A tile is 512 bytes wide,
//   8 rows tall. Rows within a tile are contiguous.
//
// Y-TILED (fmt=2):
//   128-byte column, 32-row tall pattern. A tile is 128 bytes wide
//   (32 columns of a 4-byte format), 32 rows tall, with columns
//   contiguous WITHIN the tile -- the transpose of X-tiling.
//
// TILE4 (fmt=3):
//   Xe1 native. 64-byte column, 64-row pattern. Sub-tiles a Y-tile
//   for the Xe hierarchical-cache line width.
//
// TILEF (fmt=4):
//   Xe2+ native. 256-byte column, 64-row pattern. Widens Tile4 for
//   the Xe2 L3 line width; consumers that touch neither Xe2 nor
//   HDR staging never see it.
//
// =============================================================================
// §2  ADDRESS TRANSFORM
// =============================================================================
//
// The per-tile shape is fixed by format; the tile stride (bytes per
// tile row across the surface) is derived from the linear stride
// rounded up to the tile width. The transform for tiled formats is:
//
//   tile_x        = x / tile_w
//   tile_y        = y / tile_h
//   intra_tile_x  = x mod tile_w
//   intra_tile_y  = y mod tile_h
//
//   tiled_offset =   tile_y * tiles_per_row * tile_size
//                  + tile_x * tile_size
//                  + intra_tile_y * tile_w
//                  + intra_tile_x
//
// where tile_size = tile_w * tile_h and tiles_per_row = ceil(stride
// / tile_w). x is the byte offset (px * bpp), NOT the pixel index.
// The caller multiplies before invoking.
//
// =============================================================================
// §3  ONE WRITER OF THE COUNTERS
// =============================================================================
//
// _tiling_stats is written only by helpers in this module.
// tools/build.sh confines relocations against it to
// core/drivers/gpu/tiling.o.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF620..0xFFFFF62F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: bo_alloc
// 0xFFFFF630..3F; adjacent free band below: cache_policy
// 0xFFFFF610..1F).

module Tiling = structure {

  // §1: format ordinals (mirror KindGpuBo.KGB_TIL_*).
  pub let TIL_FMT_LINEAR : u64 = 0
  pub let TIL_FMT_X      : u64 = 1
  pub let TIL_FMT_Y      : u64 = 2
  pub let TIL_FMT_TILE4  : u64 = 3
  pub let TIL_FMT_TILEF  : u64 = 4
  pub let TIL_FMT_MAX    : u64 = 4

  // §1: per-format tile shape in bytes / rows.
  pub let TIL_LIN_W : u64 = 1
  pub let TIL_LIN_H : u64 = 1
  pub let TIL_X_W   : u64 = 512
  pub let TIL_X_H   : u64 = 8
  pub let TIL_Y_W   : u64 = 128
  pub let TIL_Y_H   : u64 = 32
  pub let TIL_4_W   : u64 = 64
  pub let TIL_4_H   : u64 = 64
  pub let TIL_F_W   : u64 = 256
  pub let TIL_F_H   : u64 = 64

  // Failure taxonomy -- 0xFFFFF620..0xFFFFF62F.
  pub let TIL_OK          : u64 = 0
  pub let TIL_BAD_FMT     : u64 = 0xFFFFF62F
  pub let TIL_BAD_DIM     : u64 = 0xFFFFF62E
  pub let TIL_BAD_STRIDE  : u64 = 0xFFFFF62D
  pub let TIL_BAD_ARG     : u64 = 0xFFFFF62C
  pub let TIL_DECODE_BAD  : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _tiling_stats : [u64; 8] = uninit @align(64)

  pub let TIL_ST_LINEAR : u64 = 0
  pub let TIL_ST_X      : u64 = 1
  pub let TIL_ST_Y      : u64 = 2
  pub let TIL_ST_TILE4  : u64 = 3
  pub let TIL_ST_TILEF  : u64 = 4
  pub let TIL_ST_REFUSED : u64 = 5

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let tiling_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-003 (#1264): clear the tiling counter row. Boot and teardown only. Labels prefixed til_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _tiling_stats];
        xor rcx, rcx;
      til_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  til_rs_stats;
        ret
      }
    } @no_frame

  pub let til_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-003 (#1264): counter bump. Labels prefixed til_nt_.",
      block: {
        cmp rdi, 8;
        jae til_nt_out;
        lea r10, [rip + _tiling_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      til_nt_out:
        ret
      }
    } @no_frame

  pub let til_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-003 (#1264): counter read. Labels prefixed til_st_.",
      block: {
        cmp rdi, 8;
        jae til_st_zero;
        lea r10, [rip + _tiling_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      til_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Format validators + shape lookups.
  // ==========================================================================

  pub let til_fmt_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-003 (#1264): 1 iff f <= TIL_FMT_MAX (4). Labels prefixed til_fv_.",
      block: {
        cmp rdi, 4;
        ja  til_fv_no;
        mov rax, 1;
        ret;
      til_fv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let til_tile_width : (u64) -> u64 !{} @{} =
    fn (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-003 (#1264): tile width in bytes for format. DECODE_BAD on bad fmt. Labels prefixed til_tw_.",
      block: {
        cmp rdi, 0;
        je  til_tw_lin;
        cmp rdi, 1;
        je  til_tw_x;
        cmp rdi, 2;
        je  til_tw_y;
        cmp rdi, 3;
        je  til_tw_t4;
        cmp rdi, 4;
        je  til_tw_tf;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      til_tw_lin:
        mov rax, 1;
        ret;
      til_tw_x:
        mov rax, 512;
        ret;
      til_tw_y:
        mov rax, 128;
        ret;
      til_tw_t4:
        mov rax, 64;
        ret;
      til_tw_tf:
        mov rax, 256;
        ret
      }
    } @no_frame

  pub let til_tile_height : (u64) -> u64 !{} @{} =
    fn (fmt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-003 (#1264): tile height in rows for format. DECODE_BAD on bad fmt. Labels prefixed til_th_.",
      block: {
        cmp rdi, 0;
        je  til_th_lin;
        cmp rdi, 1;
        je  til_th_x;
        cmp rdi, 2;
        je  til_th_y;
        cmp rdi, 3;
        je  til_th_t4;
        cmp rdi, 4;
        je  til_th_tf;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      til_th_lin:
        mov rax, 1;
        ret;
      til_th_x:
        mov rax, 8;
        ret;
      til_th_y:
        mov rax, 32;
        ret;
      til_th_t4:
        mov rax, 64;
        ret;
      til_th_tf:
        mov rax, 64;
        ret
      }
    } @no_frame

  // ==========================================================================
  // til_tiles_per_row(fmt, stride_bytes) -> ceil(stride / tile_w)
  //
  // The pattern-aware stride an address transform steps through per
  // tile row. LINEAR returns 1 (there is only one "tile" that spans
  // the row); every other format rounds up.
  // ==========================================================================

  pub let til_tiles_per_row : (u64, u64) -> u64 !{} @{} =
    fn (fmt: u64) (stride: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-003 (#1264): ceil(stride / tile_width). DECODE_BAD on bad fmt or stride 0. Labels prefixed til_tpr_.",
      block: {
        push r12;
        push r13;

        cmp rdi, 4;
        ja  til_tpr_bad;
        cmp rsi, 0;
        je  til_tpr_bad;

        mov r12, rsi;                    // stride
        push rdi;
        call til_tile_width;
        pop rdi;
        mov r13, rax;                    // tile_w

        // ceil(stride / tile_w) = (stride + tile_w - 1) / tile_w.
        mov rax, r12;
        add rax, r13;
        sub rax, 1;
        xor rdx, rdx;
        div r13;
        jmp til_tpr_out;

      til_tpr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      til_tpr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // til_encode(fmt, x_bytes, y, stride_bytes) -> tiled_offset | DECODE_BAD
  //
  // §2's canonical transform. `x_bytes` is the BYTE offset of the
  // pixel within its row (px * bpp); `y` is the row index; `stride_
  // bytes` is the linear stride (bytes per row).
  //
  // Refuses:
  //   BAD_FMT     if fmt > MAX
  //   BAD_STRIDE  if stride == 0
  //   BAD_DIM     if x_bytes >= stride
  // ==========================================================================

  pub let til_encode : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (fmt: u64) (x_bytes: u64) (y: u64) (stride: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-003 (#1264): linear (x_bytes, y) -> tiled byte offset. §2. Labels prefixed til_e_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // fmt
        mov r13, rsi;                    // x_bytes
        mov r14, rdx;                    // y
        mov r15, rcx;                    // stride

        cmp r12, 4;
        ja  til_e_bad_fmt;
        cmp r15, 0;
        je  til_e_bad_stride;
        cmp r13, r15;
        jae til_e_bad_dim;

        // Fast path: LINEAR.
        cmp r12, 0;
        jne til_e_tiled;
        // linear: y * stride + x_bytes
        mov rax, r14;
        imul rax, r15;                   // rax = y * stride (low 64)
        add rax, r13;
        mov rdi, 0;                      // LINEAR counter
        call til_note;
        jmp til_e_out;

      til_e_tiled:
        // rbx = tile_w
        mov rdi, r12;
        call til_tile_width;
        mov rbx, rax;
        // rbp = tile_h
        mov rdi, r12;
        call til_tile_height;
        mov rbp, rax;

        // Compute tile_x / intra_x = x_bytes divmod tile_w.
        mov rax, r13;
        xor rdx, rdx;
        div rbx;
        push rax;                        // tile_x  @ [rsp+40]
        push rdx;                        // intra_x @ [rsp+32]

        // Compute tile_y / intra_y = y divmod tile_h.
        mov rax, r14;
        xor rdx, rdx;
        div rbp;
        push rax;                        // tile_y  @ [rsp+24]
        push rdx;                        // intra_y @ [rsp+16]

        // tiles_per_row = (stride + tile_w - 1) / tile_w.
        mov rax, r15;
        add rax, rbx;
        sub rax, 1;
        xor rdx, rdx;
        div rbx;
        push rax;                        // tpr @ [rsp+8]

        // tile_size = tile_w * tile_h.
        mov rax, rbx;
        imul rax, rbp;
        push rax;                        // tile_size @ [rsp+0]

        // base_row = tile_y * tpr * tile_size.
        mov rax, [rsp + 24];             // tile_y
        mov r10, [rsp + 8];              // tpr
        imul rax, r10;                   // rax = tile_y * tpr (low 64)
        mov r10, [rsp + 0];              // tile_size
        imul rax, r10;                   // rax = base_row (low 64)
        mov r11, rax;                    // base_row

        // base_tile = tile_x * tile_size.
        mov rax, [rsp + 40];             // tile_x
        mov r10, [rsp + 0];              // tile_size
        imul rax, r10;
        add r11, rax;                    // + base_tile

        // intra = intra_y * tile_w + intra_x.
        mov rax, [rsp + 16];             // intra_y
        imul rax, rbx;                   // * tile_w
        mov r10, [rsp + 32];             // intra_x
        add rax, r10;
        add rax, r11;                    // + base_row+base_tile

        add rsp, 48;                     // pop six saved qwords

        // Bump per-format counter (fmt in r12).
        push rax;
        mov rdi, r12;
        call til_note;
        pop rax;
        jmp til_e_out;

      til_e_bad_fmt:
        mov rdi, 5;                      // REFUSED
        call til_note;
        mov rax, 0xFFFFF62F;
        jmp til_e_out;
      til_e_bad_stride:
        mov rdi, 5;
        call til_note;
        mov rax, 0xFFFFF62D;
        jmp til_e_out;
      til_e_bad_dim:
        mov rdi, 5;
        call til_note;
        mov rax, 0xFFFFF62E;

      til_e_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
