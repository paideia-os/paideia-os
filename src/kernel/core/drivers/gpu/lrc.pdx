// src/kernel/core/drivers/gpu/lrc.pdx — R37.M5-002 (#1273)
//
// Iris Xe (Gen12) Logical Ring Context (LRC) layout + initializer.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CANONICAL LRC BOOKKEEPING SITE for the Xe1 execution
// engines.  Every KIND_GPU_CONTEXT that runs on an engine needs a
// physical LRC region: a page-aligned block that holds a per-engine
// register-state header and the ring buffer state the GPU restores
// on context-in and saves on context-out.  A second LRC bookkeeping
// site would let one path stamp initial defaults while the other
// consumed a live register save, and the two would drift silently
// through preemption cycles.
//
// It is ALSO the ONE SITE that computes per-engine LRC sizes.  Xe1
// engines carry different register sets (render is largest, blitter
// smallest); a second size calculator would let one path allocate
// too small a region and the GPU would DMA past the tail on the next
// context switch.
//
// IT DOES NOT ALLOCATE PHYSICAL FRAMES.  Frames come from PMM via
// the KIND_MEMORY authority the caller of lrc_init held; this module
// records the (ctx_row, engine_id, lrc_pa, lrc_size) 4-tuple and
// stamps the default register values into the region.  It does NOT
// write MMIO -- the R37.M1 owner is the sole writer of engine MMIO.
//
// IT DOES NOT MINT KIND_GPU_CONTEXT.  That is kind_gpu_context.pdx.
// This module CONSUMES the context row (through kgctx_row_engine,
// kgctx_row_vm) and records the LRC region that backs it.
//
// =============================================================================
// §1  PER-ENGINE LRC SIZES (BSPEC XE1 §3.4)
// =============================================================================
//
// The Xe1 LRC region is a page-aligned block whose size depends on
// the engine class.  Per bspec Xe1 §3.4:
//
//   RENDER  (RCS)  64 KiB  — largest register set (URB, sampler,
//                             VS/HS/DS/GS/PS state, sync state)
//   BLITTER (BCS)  16 KiB  — smallest (copy engine only)
//   VIDEO   (VCS)  32 KiB  — media pipeline (MFX, HEVC, VP9)
//
// These are the physical extents the driver reserves per context per
// engine.  Under-allocation would cause a save/restore to overflow
// into an adjacent object; over-allocation wastes memory that scales
// linearly with active contexts.  This module encodes the sizes as
// constants and refuses any lrc_init whose reservation does not
// match the engine class.
//
// =============================================================================
// §2  DEFAULT REGISTER STATE
// =============================================================================
//
// A fresh LRC needs default values in its header before the engine
// can restore it.  The default set is small and well-known per
// bspec Xe1 §3.4.1 -- a MI_LOAD_REGISTER_IMM ordinal, followed by
// pairs of (register offset, value) covering:
//
//   CTX_TIMESTAMP     0 (reset per context)
//   RING_HEAD         0 (empty ring)
//   RING_TAIL         0 (empty ring)
//   RING_START        engine base MMIO offset
//   RING_CONTROL      length | valid
//   HW_STATE          minimal (no shader outstanding)
//
// This module stamps the 8-slot default header at offset 0 of the
// LRC region so the engine's first restore reads a coherent state.
// The header is 8 * 16 = 128 bytes (register offset + value pairs);
// the remaining LRC pages are zeroed to fault-in cleanly.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _lrc_table and _lrc_stats are written only by helpers in this
// module.  tools/build.sh confines relocations against each to
// core/drivers/gpu/lrc.o.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF590..0xFFFFF59F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used bands: kind_gpu_context
// 0xFFFFF5A0..AF, execlists 0xFFFFF580..8F, ctx_priority
// 0xFFFFF570..7F).

module Lrc = structure {

  // §1: engine class ordinals (mirror kind_gpu_context.pdx).
  pub let LRC_ENGINE_RENDER  : u64 = 0
  pub let LRC_ENGINE_BLITTER : u64 = 1
  pub let LRC_ENGINE_VIDEO   : u64 = 2
  pub let LRC_ENGINE_MAX     : u64 = 2

  // §1: per-engine LRC sizes in bytes.
  pub let LRC_SIZE_RENDER    : u64 = 0x10000   // 64 KiB
  pub let LRC_SIZE_BLITTER   : u64 = 0x4000    // 16 KiB
  pub let LRC_SIZE_VIDEO     : u64 = 0x8000    // 32 KiB

  // §2: default header extent (8 register slots * 16 bytes each).
  pub let LRC_HEADER_BYTES   : u64 = 0x80

  // §2: default register-slot ordinals (indexes into the header).
  pub let LRC_REG_CTX_TS     : u64 = 0
  pub let LRC_REG_RING_HEAD  : u64 = 1
  pub let LRC_REG_RING_TAIL  : u64 = 2
  pub let LRC_REG_RING_START : u64 = 3
  pub let LRC_REG_RING_CTL   : u64 = 4
  pub let LRC_REG_HW_STATE   : u64 = 5
  pub let LRC_REG_RSVD_6     : u64 = 6
  pub let LRC_REG_RSVD_7     : u64 = 7
  pub let LRC_REG_SLOTS      : u64 = 8

  // Failure taxonomy -- 0xFFFFF590..0xFFFFF59F.
  pub let LRC_OK              : u64 = 0
  pub let LRC_BAD_CTX         : u64 = 0xFFFFF59F
  pub let LRC_BAD_ENGINE      : u64 = 0xFFFFF59E
  pub let LRC_BAD_PA          : u64 = 0xFFFFF59D
  pub let LRC_BAD_SIZE        : u64 = 0xFFFFF59C
  pub let LRC_BAD_SLOT        : u64 = 0xFFFFF59B
  pub let LRC_ENOSPC          : u64 = 0xFFFFF59A
  pub let LRC_DUPLICATE       : u64 = 0xFFFFF599
  pub let LRC_BAD_ID          : u64 = 0xFFFFF598
  pub let LRC_BAD_ARG         : u64 = 0xFFFFF597
  pub let LRC_DECODE_BAD      : u64 = 0xFFFFFFFFFFFFFFFF

  // §3: row layout -- 32 bytes per LRC entry.
  //   [+0]  in_use[63:56] | ctx_row_id[15:8] | engine_id[23:16]
  //   [+8]  lrc_pa    (u64, 4K-aligned)
  //   [+16] lrc_size  (u64, matches engine class)
  //   [+24] init_seq  (u64, incremented on lrc_init; used for debugging)
  //
  // 16 entries * 32 B = 512 B as [u64; 64].  Sixteen is 8 contexts *
  // 2 engines (a context on render + blitter, common) plus headroom.
  pub let LRC_MAX        : u64 = 16
  pub let LRC_ROW_BYTES  : u64 = 32

  pub let mut _lrc_table : [u64; 64] = uninit @align(64)
  pub let mut _lrc_stats : [u64; 8]  = uninit @align(64)

  pub let LRC_ST_INITS     : u64 = 0
  pub let LRC_ST_TEARDOWNS : u64 = 1
  pub let LRC_ST_REFUSED   : u64 = 2
  pub let LRC_ST_DUPLICATE : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let lrc_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): clear LRC table + counters. Boot and teardown only. Labels prefixed lrc_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _lrc_table];
        xor rcx, rcx;
      lrc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  lrc_rs_rows;

        lea r10, [rip + _lrc_stats];
        xor rcx, rcx;
      lrc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  lrc_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let lrc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): counter bump. Labels prefixed lrc_nt_.",
      block: {
        cmp rdi, 8;
        jae lrc_nt_out;
        lea r10, [rip + _lrc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      lrc_nt_out:
        ret
      }
    }

  pub let lrc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): counter read. Labels prefixed lrc_stt_.",
      block: {
        cmp rdi, 8;
        jae lrc_stt_zero;
        lea r10, [rip + _lrc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      lrc_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let lrc_engine_valid : (u64) -> u64 !{} @{} =
    fn (e: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-002 (#1273): 1 iff e in {0,1,2}. Labels prefixed lrc_ev_.",
      block: {
        cmp rdi, 2;
        ja  lrc_ev_no;
        mov rax, 1;
        ret;
      lrc_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let lrc_pa_valid : (u64) -> u64 !{} @{} =
    fn (pa: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-002 (#1273): 1 iff pa != 0 AND pa & 0xFFF == 0 (4K-aligned frame). Labels prefixed lrc_pv_.",
      block: {
        cmp rdi, 0;
        je  lrc_pv_no;
        mov r10, 0xFFF;
        and r10, rdi;
        cmp r10, 0;
        jne lrc_pv_no;
        mov rax, 1;
        ret;
      lrc_pv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lrc_size_for_engine(engine_id) -> bytes | DECODE_BAD
  //
  // The canonical engine -> LRC size mapping per §1.
  // ==========================================================================

  pub let lrc_size_for_engine : (u64) -> u64 !{} @{} =
    fn (engine_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-002 (#1273): per-engine LRC size lookup. Labels prefixed lrc_sfe_.",
      block: {
        cmp rdi, 0;
        je  lrc_sfe_render;
        cmp rdi, 1;
        je  lrc_sfe_blitter;
        cmp rdi, 2;
        je  lrc_sfe_video;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      lrc_sfe_render:
        mov rax, 0x10000;
        ret;
      lrc_sfe_blitter:
        mov rax, 0x4000;
        ret;
      lrc_sfe_video:
        mov rax, 0x8000;
        ret
      }
    }

  // ==========================================================================
  // lrc_size_valid(engine_id, size) -> 1 iff size matches engine class.
  // ==========================================================================

  pub let lrc_size_valid : (u64, u64) -> u64 !{} @{} =
    fn (engine_id: u64) (size: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M5-002 (#1273): 1 iff size equals lrc_size_for_engine(engine_id). Labels prefixed lrc_sv_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        call lrc_size_for_engine;
        cmp rax, r13;
        jne lrc_sv_no;
        mov rax, 1;
        jmp lrc_sv_out;
      lrc_sv_no:
        xor rax, rax;
      lrc_sv_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // lrc_find(ctx_row_id, engine_id) -> lrc_id | LRC_NONE
  //
  // Look up an existing LRC row for (ctx_row_id, engine_id).  Used by
  // lrc_init to enforce uniqueness and by the submit path to locate
  // the region on context switch-in.
  // ==========================================================================

  pub let LRC_NONE : u64 = 0xFF

  pub let lrc_find : (u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row_id: u64) (engine_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): live LRC row for (ctx_row_id, engine_id), or LRC_NONE. Labels prefixed lrc_fnd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        xor rbx, rbx;
      lrc_fnd_scan:
        cmp rbx, 16;
        jae lrc_fnd_none;
        lea r10, [rip + _lrc_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  lrc_fnd_next;

        mov r11, rax;
        shr r11, 8;
        and r11, 0xFF;
        cmp r11, r12;
        jne lrc_fnd_next;

        mov r11, rax;
        shr r11, 16;
        and r11, 0xFF;
        cmp r11, r13;
        jne lrc_fnd_next;

        mov rax, rbx;
        jmp lrc_fnd_out;

      lrc_fnd_next:
        add rbx, 1;
        jmp lrc_fnd_scan;

      lrc_fnd_none:
        mov rax, 0xFF;
      lrc_fnd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lrc_init(ctx_row_id, engine_id, lrc_pa, lrc_size) -> lrc_id | error
  //
  // Record one LRC region and stamp the default header at *lrc_pa.
  // THE ONE WRITER of _lrc_table.  Refuses:
  //   BAD_CTX      ctx_row_id > 0xFF
  //   BAD_ENGINE   engine_id > 2
  //   BAD_PA       lrc_pa unaligned / zero
  //   BAD_SIZE     lrc_size != canonical for engine class
  //   DUPLICATE    another live LRC already covers (ctx_row_id, engine_id)
  //   ENOSPC       16 LRC rows already claimed
  //
  // §2 stamp is intentionally IN-SCOPE for the witness only -- the
  // production build routes through a KIND_MEMORY writer that owns
  // the frame; this module does NOT dereference lrc_pa unless the
  // witness explicitly enables it via lrc_init_no_stamp.
  //
  // The reason for the split: dereferencing an arbitrary physical
  // address in a boot-time witness on QEMU is safe because the
  // witness picks a known-mapped scratch frame; a production caller
  // may hand us a physical address that is not yet backed by CPU-side
  // mappings, and the frame stamp must go through the walker.
  // ==========================================================================

  pub let lrc_init_no_stamp : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ctx_row_id: u64) (engine_id: u64) (lrc_pa: u64) (lrc_size: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): record one LRC row WITHOUT stamping the region. THE ONE WRITER of _lrc_table (row-metadata only). Labels prefixed lrc_ins_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // ctx_row_id
        mov r13, rsi;                    // engine_id
        mov r14, rdx;                    // lrc_pa
        mov r15, rcx;                    // lrc_size

        cmp r12, 0xFF;
        ja  lrc_ins_bad_ctx;

        mov rdi, r13;
        call lrc_engine_valid;
        cmp rax, 0;
        je  lrc_ins_bad_engine;

        mov rdi, r14;
        call lrc_pa_valid;
        cmp rax, 0;
        je  lrc_ins_bad_pa;

        mov rdi, r13;
        mov rsi, r15;
        call lrc_size_valid;
        cmp rax, 0;
        je  lrc_ins_bad_size;

        mov rdi, r12;
        mov rsi, r13;
        call lrc_find;
        cmp rax, 0xFF;
        jne lrc_ins_duplicate;

        // Scan for a free row.
        xor rbx, rbx;
      lrc_ins_scan:
        cmp rbx, 16;
        jae lrc_ins_enospc;
        lea r10, [rip + _lrc_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lrc_ins_claim;
        add rbx, 1;
        jmp lrc_ins_scan;

      lrc_ins_claim:
        // hdr = in_use=1 | ctx[15:8] | engine[23:16]
        mov rax, r12;
        and rax, 0xFF;
        shl rax, 8;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r14;
        mov [r10 + 16], r15;
        // init_seq: bump _lrc_stats[LRC_ST_INITS] pre-increment.
        lea r11, [rip + _lrc_stats];
        mov rax, [r11 + 0];
        add rax, 1;
        mov [r10 + 24], rax;
        mov [r11 + 0], rax;

        mov rax, rbx;
        jmp lrc_ins_out;

      lrc_ins_bad_ctx:
        mov rdi, 2;
        call lrc_note;
        mov rax, 0xFFFFF59F;
        jmp lrc_ins_out;
      lrc_ins_bad_engine:
        mov rdi, 2;
        call lrc_note;
        mov rax, 0xFFFFF59E;
        jmp lrc_ins_out;
      lrc_ins_bad_pa:
        mov rdi, 2;
        call lrc_note;
        mov rax, 0xFFFFF59D;
        jmp lrc_ins_out;
      lrc_ins_bad_size:
        mov rdi, 2;
        call lrc_note;
        mov rax, 0xFFFFF59C;
        jmp lrc_ins_out;
      lrc_ins_duplicate:
        mov rdi, 3;
        call lrc_note;
        mov rax, 0xFFFFF599;
        jmp lrc_ins_out;
      lrc_ins_enospc:
        mov rdi, 2;
        call lrc_note;
        mov rax, 0xFFFFF59A;

      lrc_ins_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lrc_teardown(lrc_id) -> OK | error
  //
  // Release one LRC row (does NOT free the physical frame -- that is
  // the caller's KIND_MEMORY authority).
  // ==========================================================================

  pub let lrc_teardown : (u64) -> u64 !{mem} @{} =
    fn (lrc_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): release one LRC row (frame not freed). Labels prefixed lrc_td_.",
      block: {
        cmp rdi, 16;
        jae lrc_td_bad_id;
        lea r10, [rip + _lrc_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lrc_td_bad_id;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        push rdi;
        mov rdi, 1;                      // TEARDOWNS
        call lrc_note;
        pop rdi;

        xor rax, rax;
        ret;

      lrc_td_bad_id:
        push rdi;
        mov rdi, 2;
        call lrc_note;
        pop rdi;
        mov rax, 0xFFFFF598;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let lrc_row_valid : (u64) -> u64 !{mem} @{} =
    fn (lid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): 1 iff LRC row live. Labels prefixed lrc_rv_.",
      block: {
        cmp rdi, 16;
        jae lrc_rv_no;
        lea r10, [rip + _lrc_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lrc_rv_no;
        mov rax, 1;
        ret;
      lrc_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let lrc_row_ctx : (u64) -> u64 !{mem} @{} =
    fn (lid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): ctx_row_id. Labels prefixed lrc_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call lrc_row_valid;
        cmp rax, 0;
        je  lrc_rc_bad;
        lea r10, [rip + _lrc_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp lrc_rc_out;
      lrc_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      lrc_rc_out:
        pop r12;
        ret
      }
    }

  pub let lrc_row_engine : (u64) -> u64 !{mem} @{} =
    fn (lid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): engine_id. Labels prefixed lrc_ren_.",
      block: {
        push r12;
        mov r12, rdi;
        call lrc_row_valid;
        cmp rax, 0;
        je  lrc_ren_bad;
        lea r10, [rip + _lrc_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 16;
        and rax, 0xFF;
        jmp lrc_ren_out;
      lrc_ren_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      lrc_ren_out:
        pop r12;
        ret
      }
    }

  pub let lrc_row_pa : (u64) -> u64 !{mem} @{} =
    fn (lid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): lrc_pa. Labels prefixed lrc_rpa_.",
      block: {
        push r12;
        mov r12, rdi;
        call lrc_row_valid;
        cmp rax, 0;
        je  lrc_rpa_bad;
        lea r10, [rip + _lrc_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp lrc_rpa_out;
      lrc_rpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      lrc_rpa_out:
        pop r12;
        ret
      }
    }

  pub let lrc_row_size : (u64) -> u64 !{mem} @{} =
    fn (lid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): lrc_size. Labels prefixed lrc_rsz_.",
      block: {
        push r12;
        mov r12, rdi;
        call lrc_row_valid;
        cmp rax, 0;
        je  lrc_rsz_bad;
        lea r10, [rip + _lrc_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp lrc_rsz_out;
      lrc_rsz_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      lrc_rsz_out:
        pop r12;
        ret
      }
    }

  pub let lrc_row_seq : (u64) -> u64 !{mem} @{} =
    fn (lid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M5-002 (#1273): init_seq. Labels prefixed lrc_rsq_.",
