// src/kernel/core/drivers/gpu/huc/bundle.pdx -- R111.M6-021 (#2373)
//
// Iris Xe HuC FIRMWARE BUNDLE verifier. Parses the Intel-shipped
// HuC firmware image (CSS-signed format, as delivered by Intel at
// /paideia/firmware/gpu/huc_16.bin on the ESP) and verifies that
// (a) it structurally looks like a signed HuC uCode image,
// (b) the HuC firmware major version is the 16.x line paideia is
//     designed against, and
// (c) the RSA-2048 signature slot in the CSS header is populated.
//
// This module sits BETWEEN the M6-024 firmware-loader API (which
// hands us (pa, size) after resolving the manifest entry for the
// HuC blob) and the R37.M8 substrate (huc_load.pdx, #1285). It
// answers the narrow question "is this byte range the Intel HuC
// 16.x image paideia expects to bundle, structurally?" without
// invoking the R37.M8 admission gate -- that gate still runs on
// top, over paideia's dual-sign envelope, once M6-024 wraps the
// Intel body in the paideia sig slots.
//
// Byte-for-byte parallel to the R111.M6-020 GuC bundle verifier
// (paideia-os #2372) at src/kernel/core/drivers/gpu/guc/bundle.pdx.
// The two files share the Intel CSS header layout (SECTION 1); the
// only differences are (a) module_type pinned to 7 = CSS_MODULE_
// TYPE_HUC in place of 6 = CSS_MODULE_TYPE_GUC, and (b) sw_version
// major pinned to 16 for HuC 16.x in place of 70 for GuC 70.x.
// Everything else -- header_size_dw, module_vendor, signature-slot
// structural check, register plan, alignment ledger, fingerprint
// format, encoder posture -- matches guc/bundle.pdx byte-for-byte
// so the pair reads as one submodule of the M6-024 loader wire.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the BUNDLING-AND-STRUCTURAL-VERIFY step for an Intel-shipped
// HuC image. It knows the Intel CSS header layout as delivered by
// Intel firmware releases; it does NOT know paideia's dual-sign
// envelope (that is huc_load.pdx's hucl_verify_vendor + hucl_verify_
// paideia contract at R37.M8-001, #1285), and it does NOT perform
// the WOPCM stage or the HUC_STATUS.HUC_ACCEPTED handshake
// (huc_load.pdx's hucl_load, same file). The whole point of the
// split is that the file paideia commits to the tree with the OS
// is the Intel binary -- byte-for-byte the vendor blob -- and
// paideia's dual-sign wrap is applied downstream by M6-024's loader
// before the R37.M8 admission gate sees it. Splitting bundling
// from admission keeps the vendor bytes verifiable against Intel's
// signing convention without collapsing them into paideia's private
// envelope prematurely.
//
// IT DOES NOT PERFORM REAL RSA-2048 OR SHA-256 ARITHMETIC. The RSA
// signature check is STRUCTURAL this milestone: the CSS signature
// slot (offset 0x188..0x287, 256 bytes) is checked non-zero by
// reading the first 16 bytes and refusing on an all-zero read. The
// real cryptographic verifier -- SHA-256 over the firmware body
// (from CSS_HDR_END to blob_end), then RSA-PKCS#1-v1_5 decrypt of
// the signature under Intel's pinned public key (modulus @ 0x84,
// exponent @ 0x184), then compare of the recovered hash to the
// computed hash -- lands with the R32 wave-2 KIND_HASH_SESSION
// primitive. The substitution point is here, unchanged for every
// caller: huc_firmware_bundle_verify() keeps the same signature
// and the same "fails closed on missing sig" semantic; the byte
// pattern the check accepts narrows from "first 16 bytes of sig
// slot non-zero" to "RSA-2048 arithmetic validates", and every
// existing refusal path stays intact.
//
// IT DOES NOT LOAD THE FIRMWARE. The (pa, size) pair the verifier
// records after success is consumed by M6-024's loader, which
// hands it off to hucl_verify_vendor + hucl_verify_paideia
// (paideia envelope admission at R37.M8) and then hucl_load
// (WOPCM staging + HUC_ACCEPTED handshake, same file). This
// module's contract is "does this look like the Intel bundle
// paideia expects to ship?", not "load it".
//
// IT IS FINGERPRINT-EMITTING. Both success and every failure arm
// emit a klog line via the standard klog_s1_* wrapper family.
// Success emits `HUC BUNDLE OK ver_maj=<n> ver_min=<n> size=<n>`
// (klog_s1_d3, three decimal KV entries -- the requested
// `ver=<n>.<n>` form is expressed as two ver_maj + ver_min KVs so
// the existing d3 wrapper covers the emit without a new arity).
// Failure emits `HUC BUNDLE SKIP reason=0x<code>` (klog_s1_x1,
// one hex KV) with the specific HUCBDL_* code so an operator sees
// which check refused. Both use SUBSYS_BOOT. Byte-for-byte parallel
// to the GUC BUNDLE OK/SKIP shape landed at guc/bundle.pdx.
//
// =============================================================================
// SECTION 1  INTEL CSS HEADER LAYOUT (as parsed here)
// =============================================================================
//
// The Intel HuC firmware CSS header shares its byte layout with the
// GuC firmware CSS header (both use `struct uc_css_header` in
// drivers/gpu/drm/i915/gt/uc/intel_uc_fw.h). The only field values
// that differ per-uCode are module_type (7 for HuC vs. 6 for GuC)
// and sw_version.major. Field-by-field:
//
//   Offset  Size Field                Notes
//   ----------------------------------------------------------------------
//   0x000   u32  module_type          7 = CSS_MODULE_TYPE_HUC (6 = GuC).
//                                     This is the "5-DWORD identity
//                                     signature" lead field per Intel's
//                                     CSS convention.
//   0x004   u32  header_size_dw       Header size in DWORDs. Intel HuC
//                                     16.x ships with the same header
//                                     size as GuC 70.x -- 0xA1 (161 dw
//                                     = 644 bytes) -- because the CSS
//                                     header structure is uCode-agnostic.
//                                     header_size_dw != 0xA1 trips
//                                     HUCBDL_BAD_HEADER_SIZE. This is
//                                     honesty-conservative: paideia is
//                                     shipped against the specific
//                                     header variant it was validated
//                                     with.
//   0x008   u32  header_version       Ignored this milestone (informational).
//   0x00C   u32  module_id            Ignored this milestone.
//   0x010   u32  module_vendor        0x00008086 = Intel. Pinned.
//   0x014   u32  date                 BCD YYYYMMDD. Ignored this milestone.
//   0x018   u32  size_dw              Total blob size in DWORDs (header +
//                                     body + trailing padding). Ignored
//                                     this milestone; the M6-024 loader
//                                     validates size_dw*4 <= blob_size at
//                                     its layer.
//   0x01C   u32  key_size_dw          Ignored -- crypto is stubbed.
//   0x020   u32  modulus_size_dw      Ignored -- crypto is stubbed.
//   0x024   u32  exponent_size_dw     Ignored -- crypto is stubbed.
//   0x028   u32  time                 BCD HHMMSS. Ignored.
//   0x02C..0x03F  reserved0[5]        Ignored.
//   0x040   u32  sw_version           Version. Bits [23:16] = major (must
//                                     be 16 for the HuC 16.x line R37.M8
//                                     was designed against), bits [15:8]
//                                     = minor (informational; reported in
//                                     the OK fingerprint), bits [7:0] =
//                                     patch (ignored). No live handshake
//                                     register mirrors this field for
//                                     HuC (unlike GuC's GUCHS_REG_VERSION);
//                                     the R37.M8 substrate simply asserts
//                                     HUC_STATUS.HUC_ACCEPTED and moves on.
//                                     R111.M6-021 pins the version at
//                                     the pre-load bundle gate instead.
//   0x044   u32  submission_version   Ignored this milestone.
//   0x048..0x077  reserved1[12]       Ignored.
//   0x078   u32  header_info          Ignored.
//   0x07C   u32  reserved3            Ignored.
//   0x080   u32  reserved4            Ignored.
//   0x084..0x183  modulus[64]         RSA-2048 public-key modulus. Used
//                                     by the real verifier (R32 wave-2);
//                                     ignored structurally.
//   0x184   u32  exponent             RSA-2048 public-key exponent. Ignored
//                                     structurally.
//   0x188..0x287  signature[64]       RSA-2048 signature (256 bytes). This
//                                     is the slot the STRUCTURAL check
//                                     tests non-zero (first 16 bytes: two
//                                     u64 reads at 0x188 and 0x190, OR'd
//                                     together -- zero pair refuses as
//                                     HUCBDL_MISSING_SIG).
//   0x288+  ...  firmware body        The uCode payload -- opaque here.
//                                     Its length is derivable from
//                                     (size_dw * 4) - CSS_HDR_SIZE_BYTES.
//
// CSS_HDR_SIZE_BYTES = 0x288 = 648 -- the through-signature end of
// the header, and the minimum accepted blob size (a caller cannot
// pretend a 400-byte trace of the first few fields was a valid
// image).
//
// The "5-DWORD identity signature" phrasing in the R111.M6-021
// brief matches the first five DWORDs -- module_type,
// header_size_dw, header_version, module_id, module_vendor -- of
// which three (module_type, header_size_dw, module_vendor) are
// pinned by this verifier as the identity gate before any content
// check runs.  module_type is what distinguishes an Intel HuC blob
// from an Intel GuC blob at the identity layer; the M6-024 loader
// dispatches on the manifest path (/paideia/firmware/gpu/huc_16.bin
// -> this verifier), not on module_type, so a caller who mis-routes
// a GuC blob at (pa, size) to this verifier is caught here by the
// module_type != 7 gate rather than silently accepted.
//
// =============================================================================
// SECTION 2  ONE WRITER OF THE STATE
// =============================================================================
//
// _hucbdl_blob_pa, _hucbdl_blob_size, _hucbdl_ver_major,
// _hucbdl_ver_minor, _hucbdl_verified, and _hucbdl_stats are
// written only by helpers in this module. tools/build.sh should
// confine relocations against each to
// `core/drivers/gpu/huc/bundle.o` when the module is wired into
// the build (see also the .plans/scratch/CHANGELOG entry for
// M6-021). Confinement not yet wired at file-landing (build.sh
// touch happens in the same wave with M6-024's loader) -- matches
// the guc/bundle.pdx landing posture.
//
// =============================================================================
// SECTION 3  ERROR CODES 0xFFFFEB80..0xFFFFEB8F
// =============================================================================
//
// Sixteen-wide band verified disjoint at repo-grep time
// (2026-09-07) from every other kind/driver band. Reserved
// immediately above the GuC bundle band (0xFFFFEB70..0xFFFFEB7F,
// R111.M6-020, guc/bundle.pdx SECTION 3) so a bulk grep for
// `0xFFFFEB[78]` catches both bundles.  The 0xFFFFEB80..8F band is
// documented free at the GuC landing (guc/bundle.pdx SECTION 3
// listing).  Adjacent used band below: gucbdl 0xFFFFEB70..7F;
// adjacent free bands above: 0xFFFFEB90..BF (reserved for future
// bundle verifiers per the same cluster convention).
//
// Chosen out of the same 0xFFFFEBxx neighbourhood as the GuC
// verifier (dominated by kind_* admission bands) so the two
// firmware-bundle verifiers land as a numeric pair rather than
// scattered across the huc_load R37.M8 cluster (0xFFFFF520..52F)
// -- the bundle verifier is a bootpath consumer, not an R37.M8
// substrate module, so the 0xFFFFEBxx neighbourhood reads
// truthfully.
//
// =============================================================================
// SECTION 4  ENCODER POSTURE (per pdx encoder pitfall memo)
// =============================================================================
//
// The verifier is written to avoid the six recurring encoder
// pitfalls:
//   * No `test rN,rN` -- every zero test is `cmp reg, 0` (or a
//     zero-flag consumer after arithmetic that already set ZF).
//   * No 2-op `imul r,imm` -- no multiplication at all.
//   * No `and reg, imm64` -- every mask constant fits imm32
//     (0xFF, 0xFFFF, 0x8086), so `and r64, imm32` is safe.
//   * No `cmp reg, [mem]` -- every memory read is staged to a
//     register before the compare.
//   * Byte-load-zero pattern: `mov eax, [mem]` implicitly zero-
//     extends to rax (x86-64 semantic), so `mov eax, [rbx+0]`
//     reads a u32 into rax with the top 32 bits cleared -- no
//     `movzx` needed and no `mov al, [...]; and rax, 0xFF`
//     dance for u32 reads.
//   * Module basename mismatch: file is `bundle.pdx`, module is
//     `Bundle` (PascalCase of basename), matching the convention
//     used by `guc/bundle.pdx -> Bundle` in the parallel M6-020
//     landing (there being no name collision -- module namespace
//     for the pdx tool is source-file-scoped; public symbols
//     (`_hucbdl_*` vs. `_gucbdl_*`, HUCBDL_* vs. GUCBDL_*,
//     huc_firmware_bundle_verify vs. guc_firmware_bundle_verify)
//     are what the linker sees).

module Bundle = structure {

  // =============================================================================
  // Section 1: CSS header layout constants.
  // =============================================================================

  // Field offsets (bytes from blob start).  Mirrors gucbdl_off_*
  // (guc/bundle.pdx L217..223) because the CSS header layout is
  // uCode-agnostic.
  pub let HUCBDL_OFF_MODULE_TYPE      : u64 = 0x000
  pub let HUCBDL_OFF_HEADER_SIZE_DW   : u64 = 0x004
  pub let HUCBDL_OFF_MODULE_VENDOR    : u64 = 0x010
  pub let HUCBDL_OFF_SW_VERSION       : u64 = 0x040
  pub let HUCBDL_OFF_SIG_LO           : u64 = 0x188
  pub let HUCBDL_OFF_SIG_HI           : u64 = 0x190

  // Sizes.  Same as GuC per §1 note above.
  pub let HUCBDL_HDR_SIZE_BYTES       : u64 = 0x288     // 648
  pub let HUCBDL_HDR_SIZE_DW_EXPECTED : u64 = 0xA1      // 161

  // Identity pins.  module_type differs from GuC (7 for HuC vs 6
  // for GuC); vendor matches (both Intel).
  pub let HUCBDL_MODULE_TYPE_HUC      : u64 = 7         // CSS_MODULE_TYPE_HUC
  pub let HUCBDL_VENDOR_INTEL         : u64 = 0x8086    // Intel PCI vendor ID

  // Version pin: HuC 16.x line R37.M8 was designed against.
  pub let HUCBDL_VERSION_MAJOR_PIN    : u64 = 16

  // =============================================================================
  // Section 3: Failure taxonomy -- 0xFFFFEB80..0xFFFFEB8F.
  // Parallel to gucbdl at 0xFFFFEB70..7F.
  // =============================================================================

  pub let HUCBDL_OK                   : u64 = 0
  pub let HUCBDL_NULL_BLOB            : u64 = 0xFFFFEB8F
  pub let HUCBDL_TOO_SMALL            : u64 = 0xFFFFEB8E
  pub let HUCBDL_BAD_MODULE_TYPE      : u64 = 0xFFFFEB8D
  pub let HUCBDL_BAD_HEADER_SIZE      : u64 = 0xFFFFEB8C
  pub let HUCBDL_BAD_VENDOR           : u64 = 0xFFFFEB8B
  pub let HUCBDL_BAD_VERSION          : u64 = 0xFFFFEB8A
  pub let HUCBDL_MISSING_SIG          : u64 = 0xFFFFEB89
  pub let HUCBDL_BAD_ARG              : u64 = 0xFFFFEB88

  // =============================================================================
  // Section 2: Recorded blob descriptor + version + verified flag.
  // =============================================================================

  pub let mut _hucbdl_blob_pa    : [u64; 1] = uninit @align(64)
  pub let mut _hucbdl_blob_size  : [u64; 1] = uninit @align(64)
  pub let mut _hucbdl_ver_major  : [u64; 1] = uninit @align(64)
  pub let mut _hucbdl_ver_minor  : [u64; 1] = uninit @align(64)
  pub let mut _hucbdl_verified   : [u64; 1] = uninit @align(64)

  // Counters. Slot 0 = VERIFIED, slots 1..7 = per-refusal-code
  // counts (SKIP_* below).
  pub let mut _hucbdl_stats      : [u64; 8] = uninit @align(64)

  pub let HUCBDL_ST_VERIFIED       : u64 = 0
  pub let HUCBDL_ST_SKIP_NULL      : u64 = 1
  pub let HUCBDL_ST_SKIP_SIZE      : u64 = 2
  pub let HUCBDL_ST_SKIP_MODULE    : u64 = 3
  pub let HUCBDL_ST_SKIP_HDR       : u64 = 4
  pub let HUCBDL_ST_SKIP_VENDOR    : u64 = 5
  pub let HUCBDL_ST_SKIP_VER       : u64 = 6
  pub let HUCBDL_ST_SKIP_SIG       : u64 = 7

  // =============================================================================
  // Fingerprint tags + local klog keys.
  //
  // Both tags NUL-terminated but WITHOUT a trailing \n (the klog
  // emitter appends its own \n\0 at line-end).  Byte-for-byte
  // parallel to guc/bundle.pdx L299..303 -- only the 'GUC' prefix
  // becomes 'HUC'.
  //
  // OK tag "HUC BUNDLE OK\0" -- 13 chars + NUL = 14 B. Carries the
  // "OK" fingerprint token; verify-fingerprint-coverage.sh will see
  // it and require an allowlist entry.  Allowlisted at this landing
  // (unlike the GUC BUNDLE OK peer, which deferred its allowlist
  // entry to M6-024) so the coverage gate stays green from day one.
  //
  // SKIP tag "HUC BUNDLE SKIP\0" -- 15 chars + NUL = 16 B. Carries
  // no OK token; invisible to the coverage extractor.
  //
  // Local keys "ver_maj\0" and "ver_min\0" (8 B each) declared
  // here rather than in klog/keys.pdx because they are specific
  // to firmware-version emits and no other subsystem needs them
  // this milestone.  If a second consumer arises (GuC bundle
  // already declares its own copies -- consolidation happens
  // whenever the third caller lands), moved to klog/keys.pdx.
  // =============================================================================

  pub let tag_huc_bundle_ok   : [u8; 14] = "HUC BUNDLE OK\0"
  pub let tag_huc_bundle_skip : [u8; 16] = "HUC BUNDLE SKIP\0"

  pub let k_hucbdl_ver_maj : [u8; 8] = "ver_maj\0"
  pub let k_hucbdl_ver_min : [u8; 8] = "ver_min\0"

  // =============================================================================
  // hucbdl_reset() -> ()
  //
  // Clears blob descriptor, version, verified flag, and stats.
  // Called at boot before the first bundle verify, and on
  // teardown. Byte-for-byte parallel to gucbdl_reset in
  // guc/bundle.pdx (which is itself parallel to gucv_reset in
  // guc_verify.pdx and hucl_reset -> huc_load_reset in
  // huc_load.pdx).
  // =============================================================================

  pub let hucbdl_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): clear blob record, version, verified flag, and stats. Called from boot init before the first M6-024 loader invocation, and on teardown. Byte-for-byte parallel to gucbdl_reset (guc/bundle.pdx L314). Labels prefixed hucbdl_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _hucbdl_blob_pa];
        mov [r10 + 0], rax;
        lea r10, [rip + _hucbdl_blob_size];
        mov [r10 + 0], rax;
        lea r10, [rip + _hucbdl_ver_major];
        mov [r10 + 0], rax;
        lea r10, [rip + _hucbdl_ver_minor];
        mov [r10 + 0], rax;
        lea r10, [rip + _hucbdl_verified];
        mov [r10 + 0], rax;

        lea r10, [rip + _hucbdl_stats];
        xor rcx, rcx;
      hucbdl_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hucbdl_rs_stats;
        ret
      }
    }

  // =============================================================================
  // hucbdl_arbitrated() -> u64
  //
  // Honesty pin. Returns 0 until R32 wave-2 binds this to a live
  // RSA-2048 + SHA-256 verifier. Mirrors gucbdl_arbitrated in
  // guc/bundle.pdx and hucl_arbitrated in huc_load.pdx.
  // =============================================================================

  pub let hucbdl_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R111.M6-021 (#2373): honesty pin. Returns 0 until R32 wave-2 KIND_HASH_SESSION binds this to a live RSA-2048 + SHA-256 verifier over Intel's pinned HuC public key (modulus @ 0x84, exponent @ 0x184, signature @ 0x188 in the CSS header). Parallel to gucbdl_arbitrated (guc/bundle.pdx L351) and hucl_arbitrated (huc_load.pdx L201).",
      block: {
        xor rax, rax;
        ret
      }
    }

  // =============================================================================
  // hucbdl_note(which) -> ()
  //
  // Bump the which-th counter in _hucbdl_stats. `which >= 8` is a
  // silent no-op (defensive guard against a caller passing a stray
  // value). Byte-for-byte parallel to gucbdl_note in guc/bundle.pdx.
  // =============================================================================

  pub let hucbdl_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): counter bump. Silent no-op for which >= 8. Labels prefixed hucbdl_nt_.",
      block: {
        cmp rdi, 8;
        jae hucbdl_nt_out;
        lea r10, [rip + _hucbdl_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hucbdl_nt_out:
        ret
      }
    }

  // =============================================================================
  // hucbdl_stat(which) -> u64
  //
  // Read the which-th counter. `which >= 8` returns 0. Byte-for-
  // byte parallel to gucbdl_stat in guc/bundle.pdx.
  // =============================================================================

  pub let hucbdl_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): counter read. Returns 0 for which >= 8. Labels prefixed hucbdl_st_.",
      block: {
        cmp rdi, 8;
        jae hucbdl_st_zero;
        lea r10, [rip + _hucbdl_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hucbdl_st_zero:
        xor rax, rax;
        ret
      }
    }

  // =============================================================================
  // huc_firmware_bundle_verify(pa, size) -> HUCBDL_OK | HUCBDL_*
  //
  // Sole entry point. Parses the Intel CSS header at [pa, pa+size)
  // and returns:
  //   HUCBDL_OK               -- structurally valid HuC 16.x bundle
  //                              (module_type=7, header_size_dw=0xA1,
  //                              module_vendor=0x8086, sw_version.major=16,
  //                              signature slot first 16 bytes non-zero).
  //                              Records {pa, size, ver_maj, ver_min,
  //                              verified=1} and emits
  //                              `HUC BUNDLE OK ver_maj=<n> ver_min=<n>
  //                              size=<n>` via klog_s1_d3.
  //   HUCBDL_NULL_BLOB        -- pa == 0.
  //   HUCBDL_TOO_SMALL        -- size < 0x288 (below CSS header end).
  //   HUCBDL_BAD_MODULE_TYPE  -- header module_type != 7.
  //   HUCBDL_BAD_HEADER_SIZE  -- header_size_dw != 0xA1.
  //   HUCBDL_BAD_VENDOR       -- header module_vendor != 0x8086.
  //   HUCBDL_BAD_VERSION      -- sw_version.major != 16.
  //   HUCBDL_MISSING_SIG      -- signature slot [0x188..0x198) both u64
  //                              words zero.
  // Every non-OK arm emits `HUC BUNDLE SKIP reason=0x<code>` via
  // klog_s1_x1 (SUBSYS_BOOT, LEVEL_INFO) so an operator sees which
  // check refused, and bumps the matching SKIP_* counter.
  //
  // Check order matches the failure taxonomy above: null, size,
  // module_type, header_size_dw, vendor, version, sig -- from
  // cheapest guard to most complex. Sig check is last because it
  // dereferences the deepest CSS-header offset (0x188 + 16 = 0x198)
  // and can only run after size >= 0x288 is proven.
  //
  // Not idempotent this milestone: a second call overwrites the
  // recorded blob descriptor unconditionally. Idempotence-under-
  // identity + BAD_ARG-on-swap can be added at the same seam
  // where gucv_verify does it, once the M6-024 loader either
  // (a) proves it never re-verifies within a boot, or (b) surfaces
  // a legitimate "re-check the same blob" call.
  //
  // Encoder posture per SECTION 4:
  //   * No test rN,rN -- every zero check is cmp reg, 0.
  //   * No 2-op imul r,imm -- no multiplication.
  //   * No and reg, imm64 -- masks are 0xFF (imm32).
  //   * No cmp reg, [mem] -- every u32 read stages via `mov eax,
  //     [mem]` before the compare, u64 read via `mov rax, [mem]`.
  //   * Byte-load-zero: `mov eax, [rbx+off]` zero-extends to rax
  //     implicitly (x86-64 semantic); no movzx needed for u32.
  //
  // Alignment ledger (SysV: rsp%16==0 before every CALL; entry is
  // rsp%16==8 after the caller's own CALL to us):
  //   entry:          rsp%16 == 8
  //   push rbx:       rsp%16 == 0
  //   push r12:       rsp%16 == 8
  //   push r13:       rsp%16 == 0
  //   push r14:       rsp%16 == 8
  //   -- 4 callee-save pushes; rsp%16 == 8 at body start --
  //
  //   For a leaf inner call (hucbdl_note, klog_s1_x1):
  //     sub rsp, 8;   rsp%16 == 0
  //     call ...
  //     add rsp, 8;   rsp%16 == 8
  //
  //   For the klog_s1_d3 emit (3 stack args -- v2=ver_min,
  //   k3=k_size, v3=size -- pushed BEFORE the call in reverse
  //   order so [rsp+8]=v2 at the callee's entry):
  //     push size (v3);            rsp%16 == 0
  //     lea rax, [rip + k_size];
  //     push rax  (k3);            rsp%16 == 8
  //     push r14  (v2);            rsp%16 == 0
  //     call klog_s1_d3;
  //     add rsp, 24;               rsp%16 == 8
  //
  //   Both epilogue paths converge at:
  //     pop r14; pop r13; pop r12; pop rbx; ret  (rsp%16==8 at
  //     the ret, becomes rsp%16==0 in the caller after the pop).
  //
  // Callee-save usage:
  //   rbx = blob_pa       (survives every inner call, indexes CSS)
  //   r12 = blob_size     (survives; consumed as v3 in the OK emit)
  //   r13 = ver_major     (extracted from sw_version; v1 in emit)
  //   r14 = ver_minor     (extracted from sw_version; v2 in emit)
  //
  // Labels prefixed hucbdl_v_ (grep audit 2026-09-07: no hucbdl_
  // hits anywhere else in src/kernel/).
  // =============================================================================

  pub let huc_firmware_bundle_verify : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (pa: u64) (size: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M6-021 (paideia-os #2373): Intel CSS-format HuC firmware bundle verifier. Consumes (pa, size) from the M6-024 firmware loader (which resolved the manifest entry for /paideia/firmware/gpu/huc_16.bin on the ESP) and answers 'is this the Intel-shipped HuC 16.x image paideia expects to ship?' via a structural parse of the CSS header (SECTION 1 layout: module_type @ 0x00 pinned to 7 = CSS_MODULE_TYPE_HUC, header_size_dw @ 0x04 pinned to 0xA1, module_vendor @ 0x10 pinned to 0x8086 = Intel, sw_version @ 0x40 with bits[23:16]=major pinned to 16). RSA-2048 signature slot @ 0x188 (256 bytes) is checked STRUCTURALLY: first 16 bytes read as two u64 words, OR'd, refused if the pair is zero. Real cryptographic verify (SHA-256 over body + RSA-PKCS#1-v1_5 decrypt under Intel's pinned public key at modulus @ 0x84 / exponent @ 0x184) lands with R32 wave-2 KIND_HASH_SESSION; the substitution point is the sig-slot check here, unchanged for the caller. On OK records {blob_pa, blob_size, ver_major, ver_minor, verified=1} to the module state (SECTION 2), bumps HUCBDL_ST_VERIFIED, and emits `HUC BUNDLE OK ver_maj=<n> ver_min=<n> size=<n>` via klog_s1_d3 (SUBSYS_BOOT, LEVEL_INFO). Every failure arm bumps the matching SKIP_* counter and emits `HUC BUNDLE SKIP reason=0x<code>` via klog_s1_x1 with the specific HUCBDL_* refusal code (SECTION 3: NULL_BLOB / TOO_SMALL / BAD_MODULE_TYPE / BAD_HEADER_SIZE / BAD_VENDOR / BAD_VERSION / MISSING_SIG). Check order is cheapest-first: null pa, size >= 0x288, module_type=7, header_size_dw=0xA1, vendor=0x8086, ver_major=16, signature-slot non-zero. This is verify-only per the R111.M6-021 brief; the actual load into HuC WOPCM and the HUC_STATUS.HUC_ACCEPTED handshake happens through the R37.M8 substrate (hucl_verify_vendor + hucl_verify_paideia + hucl_load), wired by the M6-024 loader API. Register plan: rbx = blob_pa (indexes CSS), r12 = blob_size (consumed as v3 in OK emit), r13 = ver_major (v1), r14 = ver_minor (v2). Alignment (SysV): entry rsp%16==8, 4 callee-save pushes -> rsp%16==8; leaf inner calls (hucbdl_note, klog_s1_x1) use sub rsp,8 / call / add rsp,8; the klog_s1_d3 emit pushes 3 stack args (v3=size, k3=k_size, v2=ver_min in reverse order so [rsp+8]=v2 at callee entry) -> rsp%16==0 pre-call, add rsp,24 post-call. Epilogue: pop r14; pop r13; pop r12; pop rbx; ret. Encoder pitfalls avoided per SECTION 4: no test rN,rN (all zero checks are cmp reg,0), no 2-op imul r,imm (no multiplication), no and reg,imm64 (masks 0xFF fit imm32), no cmp reg,[mem] (every read staged to a register), byte-load-zero via `mov eax,[mem]` implicit zero-extension for u32 reads. Labels prefixed hucbdl_v_ (grep audit 2026-09-07: no hucbdl_v_ hits anywhere else in src/kernel/). Cross-module refs: SUBSYS_BOOT (klog/subsys), k_size + k_reason (klog/keys), klog_s1_d3 + klog_s1_x1 (klog/wrappers). This module's state variables (_hucbdl_*) require one-writer confinement to core/drivers/gpu/huc/bundle.o in tools/build.sh -- wired in the same wave as the M6-024 loader landing (matches guc/bundle.pdx L165 deferral posture). Byte-for-byte parallel to guc_firmware_bundle_verify (guc/bundle.pdx L493) with three symbol-level swaps: module_type pin 6 -> 7, ver_major pin 70 -> 16, and the taxonomy band 0xFFFFEB7x -> 0xFFFFEB8x.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                            // blob_pa
        mov r12, rsi;                            // blob_size

        // ---------- 1. NULL blob ----------
        cmp rbx, 0;
        je  hucbdl_v_null;

        // ---------- 2. Undersized ----------
        // Minimum blob is the CSS header end at 0x288 = 648 bytes.
        mov rax, 0x288;
        cmp r12, rax;
        jb  hucbdl_v_too_small;

        // ---------- 3. module_type must be 7 (CSS_MODULE_TYPE_HUC) ----------
        // Stage the u32 through eax first (implicit zero-extend to rax).
        mov eax, [rbx + 0];
        cmp eax, 7;
        jne hucbdl_v_bad_module;

        // ---------- 4. header_size_dw must be 0xA1 ----------
        mov eax, [rbx + 4];
        cmp eax, 0xA1;
        jne hucbdl_v_bad_hdr;

        // ---------- 5. module_vendor must be 0x8086 (Intel) ----------
        mov eax, [rbx + 16];
        cmp eax, 0x8086;
        jne hucbdl_v_bad_vendor;

        // ---------- 6. sw_version -- extract major + minor ----------
        // sw_version bit layout (matches Intel CSS convention;
        // guc/bundle.pdx L541 uses the same idiom for GuC):
        //   bits [23:16] = major
        //   bits [15:8]  = minor
        //   bits  [7:0]  = patch (ignored)
        mov eax, [rbx + 64];
        mov r13, rax;                            // r13 = sw_version
        shr r13, 16;
        and r13, 0xFF;                           // r13 = major
        mov r14, rax;                            // r14 = sw_version
        shr r14, 8;
        and r14, 0xFF;                           // r14 = minor

        // ---------- 7. Major must be 16 ----------
        cmp r13, 16;
        jne hucbdl_v_bad_ver;

        // ---------- 8. Signature slot structural check ----------
        // The RSA-2048 signature occupies 256 bytes at offset
        // 0x188..0x287. Read the first 16 bytes as two u64 words;
        // OR them together; refuse if the pair is zero (i.e., an
        // unsigned or corrupted image). The real RSA-PKCS#1-v1_5
        // decrypt lands at this seam under R32 wave-2 --
        // hucbdl_arbitrated() returns 0 until then to signal the
        // stub state honestly.
        mov rax, [rbx + 0x188];                  // sig_lo
        mov rcx, [rbx + 0x190];                  // sig_hi
        or  rax, rcx;
        cmp rax, 0;
        je  hucbdl_v_missing_sig;

        // =========================================================
        // OK path: record blob descriptor + version, bump the
        // VERIFIED counter, emit the OK fingerprint.
        // =========================================================
        lea r10, [rip + _hucbdl_blob_pa];
        mov [r10 + 0], rbx;
        lea r10, [rip + _hucbdl_blob_size];
        mov [r10 + 0], r12;
        lea r10, [rip + _hucbdl_ver_major];
        mov [r10 + 0], r13;
        lea r10, [rip + _hucbdl_ver_minor];
        mov [r10 + 0], r14;
        lea r10, [rip + _hucbdl_verified];
        mov rax, 1;
        mov [r10 + 0], rax;

        // Bump VERIFIED counter (slot 0).
        sub rsp, 8;                              // align: %16==8 -> 0
        mov rdi, 0;                              // HUCBDL_ST_VERIFIED
        call hucbdl_note;
        add rsp, 8;                              // %16 -> 8

        // Emit "HUC BUNDLE OK ver_maj=<n> ver_min=<n> size=<n>".
        // klog_s1_d3 stack-arg layout (per wrapper header): caller
        // pushes v3, k3, v2 in that order BEFORE the call so at
        // callee entry [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3.
        push r12;                                // v3 = blob_size
        lea rax, [rip + k_size];
        push rax;                                // k3 = k_size
        push r14;                                // v2 = ver_minor

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_huc_bundle_ok];
        lea rcx, [rip + k_hucbdl_ver_maj];       // k1
        mov r8,  r13;                            // v1 = ver_major
        lea r9,  [rip + k_hucbdl_ver_min];       // k2
        call klog_s1_d3;
        add rsp, 24;                             // undo 3 stack args

        xor rax, rax;                            // HUCBDL_OK = 0
        jmp hucbdl_v_out;

        // =========================================================
        // Failure arms. Each bumps its SKIP_* counter, emits
        // `HUC BUNDLE SKIP reason=0x<code>` via klog_s1_x1, and
        // returns the specific HUCBDL_* code. The reason code is
        // carried in rbx across the shared emit block so the
        // klog_s1_x1 call site is written once.
        // =========================================================
      hucbdl_v_null:
        sub rsp, 8;
        mov rdi, 1;                              // HUCBDL_ST_SKIP_NULL
        call hucbdl_note;
        add rsp, 8;
        mov rbx, 0xFFFFEB8F;                     // HUCBDL_NULL_BLOB
        jmp hucbdl_v_skip_emit;

      hucbdl_v_too_small:
        sub rsp, 8;
        mov rdi, 2;                              // HUCBDL_ST_SKIP_SIZE
        call hucbdl_note;
        add rsp, 8;
        mov rbx, 0xFFFFEB8E;                     // HUCBDL_TOO_SMALL
        jmp hucbdl_v_skip_emit;

      hucbdl_v_bad_module:
        sub rsp, 8;
        mov rdi, 3;                              // HUCBDL_ST_SKIP_MODULE
        call hucbdl_note;
        add rsp, 8;
        mov rbx, 0xFFFFEB8D;                     // HUCBDL_BAD_MODULE_TYPE
        jmp hucbdl_v_skip_emit;

      hucbdl_v_bad_hdr:
        sub rsp, 8;
        mov rdi, 4;                              // HUCBDL_ST_SKIP_HDR
        call hucbdl_note;
        add rsp, 8;
        mov rbx, 0xFFFFEB8C;                     // HUCBDL_BAD_HEADER_SIZE
        jmp hucbdl_v_skip_emit;

      hucbdl_v_bad_vendor:
        sub rsp, 8;
        mov rdi, 5;                              // HUCBDL_ST_SKIP_VENDOR
        call hucbdl_note;
        add rsp, 8;
        mov rbx, 0xFFFFEB8B;                     // HUCBDL_BAD_VENDOR
        jmp hucbdl_v_skip_emit;

      hucbdl_v_bad_ver:
        sub rsp, 8;
        mov rdi, 6;                              // HUCBDL_ST_SKIP_VER
        call hucbdl_note;
        add rsp, 8;
        mov rbx, 0xFFFFEB8A;                     // HUCBDL_BAD_VERSION
        jmp hucbdl_v_skip_emit;

      hucbdl_v_missing_sig:
        sub rsp, 8;
        mov rdi, 7;                              // HUCBDL_ST_SKIP_SIG
        call hucbdl_note;
        add rsp, 8;
        mov rbx, 0xFFFFEB89;                     // HUCBDL_MISSING_SIG
        // fall through

      hucbdl_v_skip_emit:
        // klog_s1_x1(3, SUBSYS_BOOT, tag_huc_bundle_skip,
        //            k_reason, <reason_code in rbx>).
        sub rsp, 8;                              // align: %16==8 -> 0
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_huc_bundle_skip];
        lea rcx, [rip + k_reason];
        mov r8,  rbx;                            // v1 = reason code
        call klog_s1_x1;
        add rsp, 8;                              // %16 -> 8

        mov rax, rbx;                            // return the reason
        // fall through to epilogue

      hucbdl_v_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =============================================================================
  // Row accessors. All parallel to gucbdl_is_verified / gucbdl_blob_pa_of /
  // gucbdl_blob_size_of / gucbdl_ver_major_of / gucbdl_ver_minor_of in
  // guc/bundle.pdx.
  // =============================================================================

  pub let hucbdl_is_verified : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): 1 iff a bundle has been verified this boot. Labels prefixed hucbdl_iv_.",
      block: {
        lea r10, [rip + _hucbdl_verified];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hucbdl_blob_pa_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): recorded bundle physical address, or 0 if none verified. Labels prefixed hucbdl_bp_.",
      block: {
        lea r10, [rip + _hucbdl_blob_pa];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hucbdl_blob_size_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): recorded bundle byte size, or 0 if none verified. Labels prefixed hucbdl_bs_.",
      block: {
        lea r10, [rip + _hucbdl_blob_size];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hucbdl_ver_major_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): recorded firmware major version (16 for HuC 16.x), or 0 if none verified. Labels prefixed hucbdl_vm_.",
      block: {
        lea r10, [rip + _hucbdl_ver_major];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let hucbdl_ver_minor_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R111.M6-021 (#2373): recorded firmware minor version, or 0 if none verified. Labels prefixed hucbdl_vn_.",
      block: {
        lea r10, [rip + _hucbdl_ver_minor];
        mov rax, [r10 + 0];
        ret
      }
    }
}
