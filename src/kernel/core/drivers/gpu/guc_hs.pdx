// src/kernel/core/drivers/gpu/guc_hs.pdx — R37.M2-003 (#1259)
//
// Iris Xe GuC HANDSHAKE + version-negotiation. Sits ABOVE guc_load
// (#1258) in the R37.M2 chain: once the firmware is uploaded and the
// GuC reset is released, the GuC's tiny in-ROM boot ROM finishes
// loading the uploaded image and stamps GUC_STATUS.UKERNEL_LOADED.
// The KMD then sends an SLPC (Single Loop Power Control) init MMIO,
// reads back the firmware VERSION and FEATURES words, and records
// the intersection of "features paideia knows how to drive" with
// "features the GuC advertises" as the enabled feature set.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the FIRMWARE-COMES-UP half of R37.M2. guc_verify (#1257)
// admits the image; guc_load (#1258) stages it into GuC WOPCM and
// releases the reset; this module is what runs AFTER the release
// edge — the moment where the KMD stops speaking to a passive
// firmware image and starts speaking to a live GuC. Without this
// handshake the load is unverifiable from the OS side: the KMD
// wrote three registers and read none, and a GuC that failed to
// come up looks the same as one that came up perfectly.
//
// IT DOES NOT SPEAK THE FULL HXG PROTOCOL. HXG (H2G / G2H) is the
// message-passing wire the KMD uses to submit contexts and receive
// completions in R37.M4+; the scaffold here reads three status
// words (UKERNEL_LOADED bit, VERSION, FEATURES) and writes ONE
// SLPC init word. Every HXG mailbox on a live driver is a distinct
// KIND_GPU_HXG_MAILBOX capability, and that lands with the
// KIND_GPU_CONTEXT scaffolds R37.M3 owns; substituting a live
// mailbox at this seam does not change any caller — the KMD's
// contract with the GuC after handshake is "the GuC responds to
// H2G messages", which the reader half of guchs_handshake proves
// the return channel exists to carry.
//
// IT DOES NOT VALIDATE THE VERSION SEMANTICALLY. The scaffold
// insists the version word is NON-ZERO (a GuC that reports 0
// either failed to bring up its version block or replied to a read
// that arrived while the firmware was mid-boot); a live driver
// pins the min/max supported version range explicitly and refuses
// a firmware outside it, and the pin lives with the KIND_HASH_
// SESSION vendor-key table under R32 wave-2.
//
// guchs_arbitrated() returns 0 until a later round wires the seam
// to a live HXG mailbox pair.
//
// =============================================================================
// §1  REGISTER OFFSETS
// =============================================================================
//
// Offsets picked to land inside the gpu_reg_audit whitelist range
// [0x0, 0x40000). A live driver replaces these with the bspec §21.5
// offsets (GUC_STATUS = 0xC000, SOFT_SCRATCH_0..15 = 0xC180..0xC1BC
// for the H2G/G2H mailbox); the substitution point is here.
//
//   GUCHS_REG_STATUS       : 0xC000  (bit 30 = UKERNEL_LOADED)
//   GUCHS_REG_VERSION      : 0xC008  (u32; low 16 = minor, high 16
//                                     = major — matches Intel GuC
//                                     firmware header layout)
//   GUCHS_REG_FEATURES     : 0xC00C  (u32; feature capability mask
//                                     the GuC advertises)
//   GUCHS_REG_SLPC_INIT    : 0xC02C  (u32; SLPC bring-up trigger.
//                                     KMD writes a non-zero token;
//                                     GuC reflects readiness through
//                                     STATUS.UKERNEL_LOADED plus a
//                                     subsequent SLPC ping — the ping
//                                     itself is R37.M4 scope)
//
// GUCHS_UKERNEL_LOADED_BIT : 1 << 30 — the "loaded" bit inside
//                                     GUC_STATUS.
//
// =============================================================================
// §2  FEATURE NEGOTIATION
// =============================================================================
//
// GUCHS_KMD_SUPPORT_MASK is the union of features the KMD knows how
// to drive at this milestone. On handshake, enabled_features is
// KMD_SUPPORT_MASK & GUC_ADVERTISED_MASK — the intersection. A GuC
// that advertises a feature paideia does not implement is IGNORED
// (the feature is not enabled) rather than refused; a paideia-only
// feature the GuC does not implement is not enabled either. The
// arithmetic is exact: an operator reading the enabled_features
// register sees a bitset whose every 1 bit is a feature BOTH sides
// agreed to.
//
// R37.M2 scope: submission (bit 0), SLPC (bit 1). The GuC on Iris
// Xe advertises more (context isolation, telemetry, PDI etc.); the
// KMD narrows to two bits because the R37.M4+ callers that light up
// the other features do not exist yet, and lighting them up here
// would be honesty-violating (the arbitrated pin fires when a
// consumer lands).
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _guchs_ready, _guchs_version, _guchs_features_enabled, and
// _guchs_stats are written only by helpers in this module.
// tools/build.sh confines relocations against each to
// `core/drivers/gpu/guc_hs.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF650..0xFFFFF65F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: guc_load
// 0xFFFFF660..6F; adjacent free band below: available for future
// R37.M2 modules).

module GucHs = structure {

  // §1: register offsets.
  pub let GUCHS_REG_STATUS      : u64 = 0xC000
  pub let GUCHS_REG_VERSION     : u64 = 0xC008
  pub let GUCHS_REG_FEATURES    : u64 = 0xC00C
  pub let GUCHS_REG_SLPC_INIT   : u64 = 0xC02C

  // §1: UKERNEL_LOADED bit.
  pub let GUCHS_UKERNEL_LOADED_BIT : u64 = 0x40000000  // 1 << 30

  // §1: SLPC init token — a non-zero sentinel a live driver
  // replaces with the GuC-agreed SLPC vector base.
  pub let GUCHS_SLPC_INIT_TOKEN : u64 = 0x51C0100

  // §2: KMD-side feature-support mask (bit 0 = submission, bit 1 =
  // SLPC). Every bit that shows up in _guchs_features_enabled must
  // be in BOTH this mask AND the GuC's advertised mask.
  pub let GUCHS_FEAT_SUBMISSION : u64 = 0x1
  pub let GUCHS_FEAT_SLPC       : u64 = 0x2
  pub let GUCHS_KMD_SUPPORT_MASK: u64 = 0x3            // submission | SLPC

  // Failure taxonomy — 0xFFFFF650..0xFFFFF65F.
  pub let GUCHS_OK              : u64 = 0
  pub let GUCHS_BAD_ARG         : u64 = 0xFFFFF65F
  pub let GUCHS_NOT_LOADED      : u64 = 0xFFFFF65E
  pub let GUCHS_MMIO_NOT_BOUND  : u64 = 0xFFFFF65D
  pub let GUCHS_TIMEOUT         : u64 = 0xFFFFF65C
  pub let GUCHS_BAD_VERSION     : u64 = 0xFFFFF65B
  pub let GUCHS_MMIO_REFUSED    : u64 = 0xFFFFF65A
  pub let GUCHS_ALREADY_UP      : u64 = 0xFFFFF659

  // Handshake state.
  pub let mut _guchs_ready             : [u64; 1] = uninit @align(64)
  pub let mut _guchs_version           : [u64; 1] = uninit @align(64)
  pub let mut _guchs_features_enabled  : [u64; 1] = uninit @align(64)

  // Counters.
  pub let mut _guchs_stats : [u64; 8] = uninit @align(64)

  pub let GUCHS_ST_HANDSHAKES : u64 = 0
  pub let GUCHS_ST_TIMEOUTS   : u64 = 1
  pub let GUCHS_ST_REFUSED    : u64 = 2

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let guchs_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-003 (#1259): clear ready flag, version, features, and stats. Boot and teardown. Labels prefixed guchs_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _guchs_ready];
        mov [r10 + 0], rax;
        lea r10, [rip + _guchs_version];
        mov [r10 + 0], rax;
        lea r10, [rip + _guchs_features_enabled];
        mov [r10 + 0], rax;

        lea r10, [rip + _guchs_stats];
        xor rcx, rcx;
      guchs_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  guchs_rs_stats;
        ret
      }
    } @no_frame

  pub let guchs_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M2-003 (#1259): honesty pin. Returns 0 until a later round wires the seam to a live HXG mailbox pair.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let guchs_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-003 (#1259): counter bump. Labels prefixed guchs_nt_.",
      block: {
        cmp rdi, 8;
        jae guchs_nt_out;
        lea r10, [rip + _guchs_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      guchs_nt_out:
        ret
      }
    } @no_frame

  pub let guchs_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-003 (#1259): counter read. Labels prefixed guchs_st_.",
      block: {
        cmp rdi, 8;
        jae guchs_st_zero;
        lea r10, [rip + _guchs_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      guchs_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // guchs_negotiate(guc_features) -> intersected mask
  //
  // §2 arithmetic. Given a GuC-advertised feature word, returns
  // the intersection with GUCHS_KMD_SUPPORT_MASK. No side effects.
  // ==========================================================================

  pub let guchs_negotiate : (u64) -> u64 !{} @{} =
    fn (guc_features: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M2-003 (#1259): §2 feature-set intersection. Labels prefixed guchs_n_.",
      block: {
        mov rax, rdi;
        mov r10, 0x3;                    // KMD_SUPPORT_MASK
        and rax, r10;
        ret
      }
    } @no_frame

  // ==========================================================================
  // guchs_handshake() -> GUCHS_OK | error
  //
  // §0: THE ONE ENTRY POINT for GuC post-load bring-up. Order:
  //   1. Precondition: guc_load has recorded loaded=1 this boot.
  //   2. Precondition: gpu_mmio is bound.
  //   3. Not-already-up.
  //   4. READ GUC_STATUS; assert UKERNEL_LOADED bit is set. On the
  //      synth seam a caller pre-writes the STATUS word so the read
  //      returns UKERNEL_LOADED — a live driver polls this in a
  //      wall-clock timeout loop (bspec §21.6 recommends 200 ms;
  //      the loop lands with the wall-clock in a later round).
  //   5. WRITE SLPC_INIT_TOKEN to GUCHS_REG_SLPC_INIT.
  //   6. READ GUC_VERSION; refuse BAD_VERSION on 0.
  //   7. READ GUC_FEATURES; call guchs_negotiate to intersect with
  //      §2's KMD support mask.
  //   8. Record {ready=1, version, features_enabled}; bump
  //      HANDSHAKES.
  //
  // Every register touch goes through gmmio_write32 / gmmio_read32
  // so the audit gate (#1256) sees it.
  // ==========================================================================

  pub let guchs_handshake : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-003 (#1259): GuC handshake + version + feature negotiation. Verifies loaded+bound preconditions; polls STATUS.UKERNEL_LOADED; kicks SLPC; reads VERSION + FEATURES; negotiates. Labels prefixed guchs_h_.",
      block: {
        push rbx;
        push r12;

        // 1. Loaded precondition.
        call gucl_is_loaded;
        cmp rax, 1;
        jne guchs_h_not_loaded;

        // 2. gmmio bound.
        call gmmio_is_bound;
        cmp rax, 1;
        jne guchs_h_not_bound;

        // 3. Not-already-up.
        lea r10, [rip + _guchs_ready];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne guchs_h_already;

        // 4. Poll UKERNEL_LOADED.
        mov rdi, 0xC000;                 // GUC_STATUS
        call gmmio_read32;
        // rax is the STATUS word (or an error sentinel; MMIO refuses
        // return the offset_ok code, which will fail the AND-mask
        // test below the same way a live GuC that has not come up
        // would).
        mov r10, 0x40000000;             // UKERNEL_LOADED bit
        mov rcx, rax;
        and rcx, r10;
        cmp rcx, r10;
        jne guchs_h_timeout;

        // 5. Kick SLPC.
        mov rdi, 0xC02C;                 // GUC_SLPC_INIT
        mov rsi, 0x51C0100;              // SLPC_INIT_TOKEN
        call gmmio_write32;
        cmp rax, 0;
        jne guchs_h_mmio;

        // 6. Read VERSION.
        mov rdi, 0xC008;                 // GUC_VERSION
        call gmmio_read32;
        mov rbx, rax;                    // stash version
        cmp rbx, 0;
        je  guchs_h_bad_version;

        // 7. Read FEATURES, negotiate.
        mov rdi, 0xC00C;                 // GUC_FEATURES
        call gmmio_read32;
        mov r12, rax;                    // stash raw guc features

        mov rdi, r12;
        call guchs_negotiate;
        // rax = intersected mask.

        // 8. Record.
        lea r10, [rip + _guchs_version];
        mov [r10 + 0], rbx;
        lea r10, [rip + _guchs_features_enabled];
        mov [r10 + 0], rax;
        lea r10, [rip + _guchs_ready];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // HANDSHAKES
        call guchs_note;
        xor rax, rax;
        jmp guchs_h_out;

      guchs_h_not_loaded:
        mov rdi, 2;
        call guchs_note;
        mov rax, 0xFFFFF65E;
        jmp guchs_h_out;
      guchs_h_not_bound:
        mov rdi, 2;
        call guchs_note;
        mov rax, 0xFFFFF65D;
        jmp guchs_h_out;
      guchs_h_already:
        mov rdi, 2;
        call guchs_note;
        mov rax, 0xFFFFF659;
        jmp guchs_h_out;
      guchs_h_timeout:
        mov rdi, 1;
        call guchs_note;
        mov rax, 0xFFFFF65C;
        jmp guchs_h_out;
      guchs_h_mmio:
        mov rdi, 2;
        call guchs_note;
        mov rax, 0xFFFFF65A;
        jmp guchs_h_out;
      guchs_h_bad_version:
        mov rdi, 2;
        call guchs_note;
        mov rax, 0xFFFFF65B;

      guchs_h_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let guchs_is_ready : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-003 (#1259): 1 iff GuC handshake has completed this boot. Labels prefixed guchs_ir_.",
      block: {
        lea r10, [rip + _guchs_ready];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let guchs_version_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-003 (#1259): recorded GuC firmware version or 0. Labels prefixed guchs_vo_.",
      block: {
        lea r10, [rip + _guchs_version];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let guchs_features_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-003 (#1259): negotiated feature mask or 0. Labels prefixed guchs_fo_.",
      block: {
        lea r10, [rip + _guchs_features_enabled];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame
}
