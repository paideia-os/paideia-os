// src/kernel/core/drivers/gpu/guc_verify.pdx — R37.M2-001 (#1257)
//
// Iris Xe GuC firmware DUAL-SIGNATURE verifier. Opens R37.M2 (GPU
// firmware substrate) by refusing to accept a GuC firmware blob whose
// vendor (RSA-2048) signature slot is empty OR whose paideia
// (Dilithium-2) re-signature slot is empty. Fails closed on EITHER
// miss — the dual-signature discipline mandated by design/roadmap/
// next-wave-synthesis.md §10 D1.a for a foreign blob run in ring 0.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ADMISSION GATE for a GuC firmware image. gpu_mmio (#1253)
// knows how to write a register; guc_load (#1258) knows how to move
// the firmware bytes into GuC-owned WOPCM through the GT DMA engine;
// this module knows whether the blob is one paideia has agreed to
// run at all. A load call that skipped this gate would silently ship
// vendor firmware into a ring-0 execution context without paideia
// having taken responsibility for the shipment — the exact failure
// mode D1.a exists to make impossible.
//
// IT DOES NOT PERFORM REAL RSA-2048 OR DILITHIUM-2 SIGNATURE
// ARITHMETIC. Both signature slots are checked STRUCTURALLY this
// milestone: the slot is present in the blob, and the slot's payload
// is non-empty. The real cryptographic verifier lands under
// KIND_HASH_SESSION (R32 wave-2 scope). Substituting the real
// verifier at that seam does not change any caller: gucv_verify()
// keeps the same signature and the same "fails closed on either
// miss" semantic — the byte pattern the check accepts narrows from
// "any non-zero" to "algebraically valid", and every existing
// refusal path stays intact.
//
// IT DOES NOT MINT A KIND_FIRMWARE_BLOB. The blob descriptor a
// live GuC load path would receive from a supervisor is out of scope
// for M2 substrate — this module answers "does this byte range look
// like a signed GuC firmware image?", not "who authorised this
// image?".
//
// gucv_arbitrated() returns 0 until R32 wave-2 binds the seam to a
// live KIND_HASH_SESSION verifier.
//
// =============================================================================
// §1  BLOB HEADER LAYOUT
// =============================================================================
//
//   Offset  Field                Size  Notes
//   ----------------------------------------------------------------------
//   0x00    magic                u32   'GUCF' (LE: 0x46435547)
//   0x04    body_size            u32   bytes of firmware body past
//                                      the header (informational this
//                                      milestone; the body is not
//                                      hashed here — that is the real
//                                      verifier's job).
//   0x08    vendor_sig[0..8)     u64   RSA-2048 signature slot (word 0)
//   0x10    vendor_sig[8..16)    u64   (word 1). A slot with BOTH
//                                      words zero is REFUSED.
//   0x18    paideia_sig[0..8)    u64   Dilithium-2 re-sign slot (w 0)
//   0x20    paideia_sig[8..16)   u64   (word 1). A slot with BOTH
//                                      words zero is REFUSED.
//   0x28    body...              u32×N firmware body (§3 of a real
//                                      GuC image; opaque here).
//
// Header size = 0x28 (40 bytes). A blob shorter than the header is
// REFUSED as TOO_SMALL — a caller cannot pretend a 16-byte trace of
// magic + one signature was a valid image.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _gucv_blob_ptr, _gucv_blob_len, _gucv_verified, and _gucv_stats
// are written only by helpers in this module. tools/build.sh confines
// relocations against each to `core/drivers/gpu/guc_verify.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF670..0xFFFFF67F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: gpu_reg_audit
// 0xFFFFF680..8F; adjacent free bands below: guc_load
// 0xFFFFF660..6F).

module GucVerify = structure {

  // §1: header layout.
  pub let GUCV_MAGIC             : u64 = 0x46435547           // 'GUCF' LE
  pub let GUCV_HDR_SIZE          : u64 = 0x28
  pub let GUCV_OFF_MAGIC         : u64 = 0x00
  pub let GUCV_OFF_BODY_SIZE     : u64 = 0x04
  pub let GUCV_OFF_VENDOR_LO     : u64 = 0x08
  pub let GUCV_OFF_VENDOR_HI     : u64 = 0x10
  pub let GUCV_OFF_PAIDEIA_LO    : u64 = 0x18
  pub let GUCV_OFF_PAIDEIA_HI    : u64 = 0x20

  // Failure taxonomy — 0xFFFFF670..0xFFFFF67F.
  pub let GUCV_OK                : u64 = 0
  pub let GUCV_BAD_ARG           : u64 = 0xFFFFF67F
  pub let GUCV_TOO_SMALL         : u64 = 0xFFFFF67E
  pub let GUCV_BAD_MAGIC         : u64 = 0xFFFFF67D
  pub let GUCV_BAD_VENDOR_SIG    : u64 = 0xFFFFF67C
  pub let GUCV_BAD_PAIDEIA_SIG   : u64 = 0xFFFFF67B
  pub let GUCV_NULL_BLOB         : u64 = 0xFFFFF67A

  // Recorded blob descriptor after a successful verify.
  pub let mut _gucv_blob_ptr : [u64; 1] = uninit @align(64)
  pub let mut _gucv_blob_len : [u64; 1] = uninit @align(64)
  pub let mut _gucv_verified : [u64; 1] = uninit @align(64)

  // Counters.
  pub let mut _gucv_stats : [u64; 8] = uninit @align(64)

  pub let GUCV_ST_VERIFIED     : u64 = 0
  pub let GUCV_ST_VENDOR_MISS  : u64 = 1
  pub let GUCV_ST_PAIDEIA_MISS : u64 = 2
  pub let GUCV_ST_REFUSED      : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let gucv_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): clear blob record, verified flag, and stats. Boot and teardown. Labels prefixed gucv_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _gucv_blob_ptr];
        mov [r10 + 0], rax;
        lea r10, [rip + _gucv_blob_len];
        mov [r10 + 0], rax;
        lea r10, [rip + _gucv_verified];
        mov [r10 + 0], rax;

        lea r10, [rip + _gucv_stats];
        xor rcx, rcx;
      gucv_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gucv_rs_stats;
        ret
      }
    }

  pub let gucv_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M2-001 (#1257): honesty pin. Returns 0 until R32 wave-2 KIND_HASH_SESSION binds this to a live RSA-2048 + Dilithium-2 verifier.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let gucv_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): counter bump. Labels prefixed gucv_nt_.",
      block: {
        cmp rdi, 8;
        jae gucv_nt_out;
        lea r10, [rip + _gucv_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      gucv_nt_out:
        ret
      }
    }

  pub let gucv_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): counter read. Labels prefixed gucv_st_.",
      block: {
        cmp rdi, 8;
        jae gucv_st_zero;
        lea r10, [rip + _gucv_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      gucv_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // gucv_verify_vendor(blob_ptr, blob_len) -> GUCV_OK | GUCV_BAD_VENDOR_SIG
  //
  // The RSA-2048 slot half of §1. A slot with BOTH words zero is
  // BAD_VENDOR_SIG. A live verifier will run the RSA-PKCS#1-v1_5
  // check against paideia's pinned Intel-GuC public key over the
  // firmware body; the substitution point is here, unchanged for the
  // caller.
  //
  // PRE: gucv_verify_size(blob_ptr, blob_len) already returned OK.
  //      (The public entry point gucv_verify() serialises the calls.)
  // ==========================================================================

  pub let gucv_verify_vendor : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): vendor (RSA-2048) sig slot check. §1 offsets. Labels prefixed gucv_vv_.",
      block: {
        mov rax, [rdi + 8];              // vendor_sig[0]
        mov rcx, [rdi + 16];             // vendor_sig[1]
        or  rax, rcx;
        cmp rax, 0;
        je  gucv_vv_bad;
        xor rax, rax;
        ret;
      gucv_vv_bad:
        mov rax, 0xFFFFF67C;             // BAD_VENDOR_SIG
        ret
      }
    }

  // ==========================================================================
  // gucv_verify_paideia(blob_ptr, blob_len) -> GUCV_OK | GUCV_BAD_PAIDEIA_SIG
  //
  // The Dilithium-2 re-sign half of §1. A slot with BOTH words zero
  // is BAD_PAIDEIA_SIG. A live verifier will call into paideia's
  // post-quantum Dilithium-2 primitive over the same body the vendor
  // signature covers.
  // ==========================================================================

  pub let gucv_verify_paideia : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): paideia (Dilithium-2) re-sign slot check. §1 offsets. Labels prefixed gucv_vp_.",
      block: {
        mov rax, [rdi + 24];             // paideia_sig[0]
        mov rcx, [rdi + 32];             // paideia_sig[1]
        or  rax, rcx;
        cmp rax, 0;
        je  gucv_vp_bad;
        xor rax, rax;
        ret;
      gucv_vp_bad:
        mov rax, 0xFFFFF67B;             // BAD_PAIDEIA_SIG
        ret
      }
    }

  // ==========================================================================
  // gucv_verify(blob_ptr, blob_len) -> GUCV_OK | error
  //
  // §0: THE ONE ENTRY POINT for GuC firmware admission. Order:
  //   1. NULL blob refused (NULL_BLOB).
  //   2. Undersized blob refused (TOO_SMALL).
  //   3. Wrong magic refused (BAD_MAGIC).
  //   4. Vendor sig slot empty refused (BAD_VENDOR_SIG).
  //   5. Paideia sig slot empty refused (BAD_PAIDEIA_SIG).
  //   6. On OK: record {blob_ptr, blob_len, verified=1}; bump
  //      VERIFIED counter; return 0.
  //
  // Both signature checks ALWAYS run. Neither short-circuits on the
  // other's success — the failure taxonomy tells the caller which
  // half refused so an operator sees whether the vendor blob or the
  // paideia re-sign is the missing half.
  //
  // A second call with an ALREADY-VERIFIED image is idempotent iff
  // the pair {blob_ptr, blob_len} matches; a swap is refused as
  // BAD_ARG. That mirrors gmmio_bind's swap-refusal (#1253).
  // ==========================================================================

  pub let gucv_verify : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): DUAL-SIGNATURE verify (D1.a). Vendor and paideia sig slots BOTH checked; fails closed on either miss. Idempotent under identity; refuses BAD_ARG on a swap. Labels prefixed gucv_v_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // blob_ptr
        mov r12, rsi;                    // blob_len

        // 1. NULL blob.
        cmp rbx, 0;
        je  gucv_v_null;

        // 2. Undersized.
        cmp r12, 0x28;
        jb  gucv_v_too_small;

        // 3. Magic.
        mov eax, [rbx + 0];
        mov r13d, 0x46435547;            // 'GUCF' LE
        cmp eax, r13d;
        jne gucv_v_bad_magic;

        // Idempotent under identity swap-check.
        lea r10, [rip + _gucv_verified];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  gucv_v_do;

        lea r10, [rip + _gucv_blob_ptr];
        mov rax, [r10 + 0];
        cmp rax, rbx;
        jne gucv_v_bad_arg;
        lea r10, [rip + _gucv_blob_len];
        mov rax, [r10 + 0];
        cmp rax, r12;
        jne gucv_v_bad_arg;
        xor rax, rax;                    // already verified, same blob
        jmp gucv_v_out;

      gucv_v_do:
        // 4. Vendor.
        mov rdi, rbx;
        mov rsi, r12;
        call gucv_verify_vendor;
        cmp rax, 0;
        jne gucv_v_vendor_bad;

        // 5. Paideia.
        mov rdi, rbx;
        mov rsi, r12;
        call gucv_verify_paideia;
        cmp rax, 0;
        jne gucv_v_paideia_bad;

        // 6. Record.
        lea r10, [rip + _gucv_blob_ptr];
        mov [r10 + 0], rbx;
        lea r10, [rip + _gucv_blob_len];
        mov [r10 + 0], r12;
        lea r10, [rip + _gucv_verified];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // VERIFIED
        call gucv_note;
        xor rax, rax;
        jmp gucv_v_out;

      gucv_v_null:
        mov rdi, 3;
        call gucv_note;
        mov rax, 0xFFFFF67A;
        jmp gucv_v_out;
      gucv_v_too_small:
        mov rdi, 3;
        call gucv_note;
        mov rax, 0xFFFFF67E;
        jmp gucv_v_out;
      gucv_v_bad_magic:
        mov rdi, 3;
        call gucv_note;
        mov rax, 0xFFFFF67D;
        jmp gucv_v_out;
      gucv_v_bad_arg:
        mov rdi, 3;
        call gucv_note;
        mov rax, 0xFFFFF67F;
        jmp gucv_v_out;
      gucv_v_vendor_bad:
        mov rdi, 1;                      // VENDOR_MISS
        call gucv_note;
        mov rdi, 3;
        call gucv_note;
        mov rax, 0xFFFFF67C;
        jmp gucv_v_out;
      gucv_v_paideia_bad:
        mov rdi, 2;                      // PAIDEIA_MISS
        call gucv_note;
        mov rdi, 3;
        call gucv_note;
        mov rax, 0xFFFFF67B;

      gucv_v_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let gucv_is_verified : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): 1 iff a blob has been verified this boot. Labels prefixed gucv_iv_.",
      block: {
        lea r10, [rip + _gucv_verified];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let gucv_blob_ptr_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): recorded blob pointer or 0. Labels prefixed gucv_bp_.",
      block: {
        lea r10, [rip + _gucv_blob_ptr];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let gucv_blob_len_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M2-001 (#1257): recorded blob length or 0. Labels prefixed gucv_bl_.",
      block: {
        lea r10, [rip + _gucv_blob_len];
        mov rax, [r10 + 0];
        ret
      }
    }
}
