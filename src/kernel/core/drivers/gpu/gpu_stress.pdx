// src/kernel/core/drivers/gpu/gpu_stress.pdx — R37.M8-004 (#1288)
//
// GPU submission STRESS RIG.  Runs a configurable number of no-op
// batch submissions against the batch builder + BO allocator and
// asserts the delta of (allocs - frees) is zero at the end.  Opens
// the regression-gate discipline for the entire R37 substrate: a
// leak in any of the R37.M3..M7 modules trips this rig BEFORE the
// production media path lands in R44+.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the REGRESSION SITE for VRAM/BO leak detection.  Every iter
// allocates a slab through boa_alloc, opens a batch builder session
// over a static scratch backing, emits MI_NOOP + MI_BATCH_BUFFER_END,
// closes the builder, and frees the slab.  100 000 iterations is
// enough to expose a per-iter leak by the time the pool's 8 slots
// of the 4K class saturate (an eight-iteration leak would trip
// ENOSPC well before 100 000).
//
// IT DOES NOT TALK TO GuC.  guc_submit's queue substrate is
// exercised by its own witness (guc_submit_synth.pdx).  A stress
// rig that rang the doorbell 100 000 times would burn 100 000
// gmmio_write32 records through the audit gate and drown the
// interesting signal in noise.  The submission substrate leak this
// rig hunts lives BELOW the doorbell: BO allocator, batch builder
// cursor, and the .bss row tables both modules stamp.
//
// IT DOES NOT TALK TO HuC OR VCS.  Those are R37.M8's other pieces
// and have their own witnesses.  This rig stays on the RCS-class
// path so a failure here localises to R37.M3 / R37.M6, not to
// M8-only work.
//
// IT USES A STATIC SCRATCH BACKING.  The batch buffer needs a
// writable region; declaring it as [u64; 512] in this module's
// .bss keeps the rig self-contained (no KIND_MEMORY plumbing, no
// PMM burn) and 4 KiB of scratch is comfortably enough for the
// two-dword worst-case per iteration.
//
// stress_arbitrated() returns 0 until the rig is wired into a
// nightly regression harness above the boot witness.
//
// =============================================================================
// §1  RIG SHAPE
// =============================================================================
//
// Per iteration:
//   1. slab = boa_alloc(BOA_CLASS_4K, memory_slot=1)
//   2. batch_builder_begin(_stress_backing, sizeof(_stress_backing))
//   3. bat_emit_noop()
//   4. bat_emit_batch_end()
//   5. batch_builder_end()
//   6. boa_free(slab)
//
// At the top:  snap_a = boa_stat(BOA_ST_ALLOCS); snap_f = boa_stat(BOA_ST_FREES)
// At the end:  delta = (final_alloc - final_free) - (snap_a - snap_f) == 0
//
// A leak in any of the six steps trips one of:
//   * ENOSPC from boa_alloc  -> a prior iter did not free
//   * BAT_BUSY from begin    -> a prior iter did not end
//   * BAT_OVERFLOW / MISALIGN-> cursor drifted across a session
//   * non-zero delta         -> alloc/free counters diverged
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _stress_backing, _stress_last, _stress_stats are written only by
// helpers in this module.  tools/build.sh confines relocations
// against each to core/drivers/gpu/gpu_stress.o.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF4F0..0xFFFFF4FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: hevc_frame
// 0xFFFFF500..0F; adjacent free band below: available for future
// R37.M8+ modules).

module GpuStress = structure {

  // §1: iteration bounds.  Default is 100 000 per R37.M8-004
  // acceptance criterion; the entry point accepts a caller-chosen
  // count so a lighter shakedown is possible.
  pub let STRESS_DEFAULT_ITERS : u64 = 100000

  // §1: static scratch buffer, 4 KiB.  A batch-buffer session needs
  // a writable region; four KiB is comfortably enough for the
  // two-dword worst-case per iteration.  [u64; 512] = 4096 B.
  pub let mut _stress_backing : [u64; 512] = uninit @align(4096)

  // §2: bookkeeping.
  pub let mut _stress_last : [u64; 4] = uninit @align(64)

  pub let STRESS_LAST_ITERS_RUN     : u64 = 0
  pub let STRESS_LAST_DELTA_ALLOCS  : u64 = 1
  pub let STRESS_LAST_LAST_ERROR    : u64 = 2
  pub let STRESS_LAST_FIRST_FAIL_IT : u64 = 3

  // Counters.
  pub let mut _stress_stats : [u64; 8] = uninit @align(64)

  pub let STRESS_ST_RUNS   : u64 = 0
  pub let STRESS_ST_PASSES : u64 = 1
  pub let STRESS_ST_FAILS  : u64 = 2

  // Failure taxonomy -- 0xFFFFF4F0..0xFFFFF4FF.
  pub let STRESS_OK             : u64 = 0
  pub let STRESS_BAD_ARG        : u64 = 0xFFFFF4FF
  pub let STRESS_ALLOC_FAIL     : u64 = 0xFFFFF4FE
  pub let STRESS_BEGIN_FAIL     : u64 = 0xFFFFF4FD
  pub let STRESS_NOOP_FAIL      : u64 = 0xFFFFF4FC
  pub let STRESS_END_OP_FAIL    : u64 = 0xFFFFF4FB
  pub let STRESS_BUILDER_END_FAIL : u64 = 0xFFFFF4FA
  pub let STRESS_FREE_FAIL      : u64 = 0xFFFFF4F9
  pub let STRESS_LEAK           : u64 = 0xFFFFF4F8

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let gpu_stress_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): clear scratch backing + bookkeeping + stats. Boot and teardown only. Labels prefixed stress_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _stress_backing];
        xor rcx, rcx;
      stress_rs_backing:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  stress_rs_backing;

        lea r10, [rip + _stress_last];
        xor rcx, rcx;
      stress_rs_last:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  stress_rs_last;

        lea r10, [rip + _stress_stats];
        xor rcx, rcx;
      stress_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  stress_rs_stats;
        ret
      }
    }

  pub let stress_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M8-004 (#1288): honesty pin. Returns 0 until the rig is wired into a nightly regression harness above the boot witness.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let stress_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): counter bump. Labels prefixed stress_nt_.",
      block: {
        cmp rdi, 8;
        jae stress_nt_out;
        lea r10, [rip + _stress_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      stress_nt_out:
        ret
      }
    }

  pub let stress_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): counter read. Labels prefixed stress_stt_.",
      block: {
        cmp rdi, 8;
        jae stress_stt_zero;
        lea r10, [rip + _stress_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      stress_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Accessors — inspect the last run's bookkeeping.
  // ==========================================================================

  pub let stress_last_iters_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): iterations the last stress_run completed (== requested on OK; == first_fail on failure). Labels prefixed stress_li_.",
      block: {
        lea r10, [rip + _stress_last];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let stress_last_delta : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): (final_alloc - final_free) - (snap_alloc - snap_free) of the last run. Zero on OK. Labels prefixed stress_ld_.",
      block: {
        lea r10, [rip + _stress_last];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let stress_last_error : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): last stress_run's return code. Labels prefixed stress_le_.",
      block: {
        lea r10, [rip + _stress_last];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let stress_last_first_fail : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): iteration index at which the last run first failed, or 0 on OK. Labels prefixed stress_lf_.",
      block: {
        lea r10, [rip + _stress_last];
        mov rax, [r10 + 24];
        ret
      }
    }

  // ==========================================================================
  // stress_iter() — run one iteration.  Returns STRESS_OK or one
  // of STRESS_ALLOC_FAIL / STRESS_BEGIN_FAIL / STRESS_NOOP_FAIL /
  // STRESS_END_OP_FAIL / STRESS_BUILDER_END_FAIL / STRESS_FREE_FAIL.
  //
  // Structured so stress_run can call it in a tight loop and read
  // both the pass/fail bit and the localised error class in one
  // return value.
  // ==========================================================================

  pub let stress_iter : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): one iteration -- alloc + begin + noop + end + builder_end + free. All six calls must succeed. Labels prefixed stress_i_.",
      block: {
        push rbx;

        // 1. Allocate a 4K slab.
        mov rdi, 0;                      // BOA_CLASS_4K
        mov rsi, 1;                      // dummy memory_slot (non-zero)
        call boa_alloc;
        // A negative sentinel (>= 0xFFFFF000) is an error; slab_id
        // is 0..47.  Guard the top of the taxonomy band.
        mov r11, 0xFFFFF000;
        cmp rax, r11;
        jae stress_i_alloc_fail;
        mov rbx, rax;                    // slab_id

        // 2. Open builder over _stress_backing (4 KiB capacity).
        lea rdi, [rip + _stress_backing];
        mov rsi, 4096;
        call batch_builder_begin;
        cmp rax, 0;
        jne stress_i_begin_fail;

        // 3. MI_NOOP.
        call bat_emit_noop;
        cmp rax, 0;
        jne stress_i_noop_fail;

        // 4. MI_BATCH_BUFFER_END.
        call bat_emit_batch_end;
        cmp rax, 0;
        jne stress_i_end_op_fail;

        // 5. Close builder.
        call batch_builder_end;
        // Returns cursor on success (>= 4), sentinel on failure.
        mov r11, 0xFFFFF000;
        cmp rax, r11;
        jae stress_i_builder_end_fail;

        // 6. Free slab.
        mov rdi, rbx;
        call boa_free;
        cmp rax, 0;
        jne stress_i_free_fail;

        xor rax, rax;
        jmp stress_i_out;

      stress_i_alloc_fail:
        mov rax, 0xFFFFF4FE;
        jmp stress_i_out;
      stress_i_begin_fail:
        // A begin failure means the previous iteration did not end
        // -- free the slab we already claimed to preserve the delta
        // invariant across the failure boundary.
        mov rdi, rbx;
        call boa_free;
        mov rax, 0xFFFFF4FD;
        jmp stress_i_out;
      stress_i_noop_fail:
        call batch_builder_end;          // scrub the open session
        mov rdi, rbx;
        call boa_free;
        mov rax, 0xFFFFF4FC;
        jmp stress_i_out;
      stress_i_end_op_fail:
        call batch_builder_end;
        mov rdi, rbx;
        call boa_free;
        mov rax, 0xFFFFF4FB;
        jmp stress_i_out;
      stress_i_builder_end_fail:
        // Builder already errored; scrubbing again would loop.
        // Free the slab so alloc/free stays balanced.
        mov rdi, rbx;
        call boa_free;
        mov rax, 0xFFFFF4FA;
        jmp stress_i_out;
      stress_i_free_fail:
        mov rax, 0xFFFFF4F9;

      stress_i_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // stress_run(iters) -> STRESS_OK | error
  //
  // §1: snap the (allocs, frees) pair, loop `iters` iterations,
  // snap again, assert the delta is zero.  On failure the loop
  // stops at the first failing iteration and records the iteration
  // index in _stress_last[STRESS_LAST_FIRST_FAIL_IT].
  //
  // Refuses BAD_ARG if iters == 0.
  // ==========================================================================

  pub let stress_run : (u64) -> u64 !{mem} @{} =
    fn (iters: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M8-004 (#1288): the whole rig -- snapshot, loop iters, snapshot, assert delta = 0. Labels prefixed stress_r_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // iters requested

        cmp rbx, 0;
        je  stress_r_bad_arg;

        mov rdi, 0;                      // RUNS
        call stress_note;

        // Snapshot (allocs - frees).
        mov rdi, 0;                      // BOA_ST_ALLOCS
        call boa_stat;
        mov r14, rax;                    // snap_allocs
        mov rdi, 1;                      // BOA_ST_FREES
        call boa_stat;
        sub r14, rax;                    // snap = allocs - frees

        // Loop counter r12 = 0..iters.
        xor r12, r12;
      stress_r_loop:
        cmp r12, rbx;
        jae stress_r_done;

        call stress_iter;
        cmp rax, 0;
        jne stress_r_iter_fail;

        add r12, 1;
        jmp stress_r_loop;

      stress_r_done:
        // Compute final (allocs - frees).
        mov rdi, 0;
        call boa_stat;
        mov r15, rax;
        mov rdi, 1;
        call boa_stat;
        sub r15, rax;                    // final = allocs - frees

        // delta = final - snap.
        mov r13, r15;
        sub r13, r14;

        // Stash iters_run + delta.
        lea r10, [rip + _stress_last];
        mov [r10 + 0], r12;              // iters_run == requested
        mov [r10 + 8], r13;              // delta

        cmp r13, 0;
        jne stress_r_leak;

        // PASS.  Note ordering: stamp last_error / first_fail and bump
        // PASSES BEFORE zeroing rax for the return.  stress_note reads
        // and writes _stress_stats through rax, so leaving `xor rax,
        // rax` above the call left the return value as the PASSES
        // counter (== 1) and the witness's stage 3 `cmp rax, 0` tripped.
        xor rax, rax;
        mov [r10 + 16], rax;             // last_error = STRESS_OK
        mov [r10 + 24], rax;             // first_fail = 0
        mov rdi, 1;                      // PASSES
        call stress_note;
        xor rax, rax;                    // return STRESS_OK
        jmp stress_r_out;

      stress_r_iter_fail:
        // r12 is the failed iteration index; rax is the class.
        mov r13, rax;                    // stash class
        lea r10, [rip + _stress_last];
        mov [r10 + 0], r12;              // iters_run == first_fail
        mov [r10 + 16], r13;             // last_error
        mov [r10 + 24], r12;             // first_fail
        // Best-effort delta snap for the caller's inspection.
        mov rdi, 0;
        call boa_stat;
        mov r15, rax;
        mov rdi, 1;
        call boa_stat;
        sub r15, rax;
        mov rax, r15;
        sub rax, r14;
        mov [r10 + 8], rax;              // delta

        mov rdi, 2;                      // FAILS
        call stress_note;
        mov rax, r13;
        jmp stress_r_out;

      stress_r_leak:
        lea r10, [rip + _stress_last];
        mov rax, 0xFFFFF4F8;
        mov [r10 + 16], rax;             // last_error = LEAK
        mov rdi, 2;                      // FAILS
        call stress_note;
        mov rax, 0xFFFFF4F8;
        jmp stress_r_out;

      stress_r_bad_arg:
        mov rax, 0xFFFFF4FF;

      stress_r_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
