// src/kernel/core/drivers/gpu/iris_xe_guc.pdx -- Wave 77 G7 [R37] (#2544)
//
// Intel Iris Xe GuC (Graphics μController) firmware loader +
// signature-verification + submission-handshake SKELETON. On Gen 12
// (Alder/Raptor Lake iGPU) the GuC is a dedicated microcontroller
// that owns work-queue submission -- host builds a context descriptor,
// stages it, kicks a doorbell MMIO register, and the GuC schedules it
// onto the render/compute/copy engine without further host CPU
// involvement. The firmware blob is signed with an Intel master key;
// the GuC refuses to leave reset-pending until the host has staged a
// blob whose signature verifies.
//
// This file sits adjacent to the Wave 74 G5 GTT bind path
// (gpu_gtt.pdx) and the Wave 73 I7 firmware blob kind
// (kind_firmware_blob.pdx). On the load path the real body (follow-up
// slice) does: firmware_lookup("guc") -> cap; firmware_blob_slice(cap,
// &pa, &len); gtt_bind(GUC_WOPCM_OFFSET, pa, RW); write GUC_WOPCM_SIZE
// / UC_INIT_BASE / UC_INIT_MMIO_BASE MMIO regs; poll GUC_STATUS until
// FIRMWARE_LOADED (0x08) with a timeout; emit the LOAD fingerprint.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// Posture: EVERY body here is a STUB per the Wave 77 G7 skeleton
// directive. The MMIO offsets, GUC_STATUS state constants, error
// taxonomy, and fingerprint shapes are FROZEN at this skeleton stage
// so the follow-up slice can land the real MMIO body against the
// same ABI and constants without churn. The static state block, the
// fingerprint tags, and the counter bumps are real; no live MMIO is
// written yet (QEMU: no Iris Xe BAR0; T14 G4: BAR0 wired by
// R104.M1-003 but consumed by iris_xe_modeset today).
//
// Every entrypoint:
//   (1) range-checks or structural-checks its inputs (cap bounds,
//       state-machine liveness) and refuses with a module-scoped
//       error code otherwise;
//   (2) records the request into the module state block;
//   (3) bumps the per-op counter so an operator can see the entry
//       on a boot-witness programme;
//   (4) emits a fingerprint (load / kick / handshake) via klog so
//       the handshake sequence shows up on the klog wire.
//
// =============================================================================
// SECTION 1  REGISTER MAP (Intel Iris Xe / Alder-Lake / Raptor-Lake)
// =============================================================================
//
// Source: Intel bspec "Register Reference -> GuC / HuC" and the
// i915 drm/i915/gt/uc/intel_guc_reg.h canonical offsets. All GuC
// registers live in BAR0 and are 32-bit per Intel bspec §15.
//
//   GUC_WOPCM_SIZE          +0xC050   -- Write-Only Protected
//                                        Content Memory window size
//                                        (bytes of GuC-only SRAM
//                                        carved out at BAR0 top).
//                                        Bit[0] = LOCKED (one-way).
//   GUC_WOPCM_OFFSET        +0xC340   -- GuC-visible base inside
//                                        the WOPCM window; firmware
//                                        is loaded here.
//   UOS_RSA_SCRATCH_0..15   +0xC200   -- 16 x u32 scratch registers
//                                        holding the RSA-2048
//                                        signature header the GuC
//                                        verifies against its
//                                        burned public-key hash.
//   DMA_ADDR_0_LOW          +0xC300   -- 4-byte little-endian low
//                                        half of the host-DMA
//                                        source address for the
//                                        GuC's internal copy engine.
//   DMA_ADDR_0_HIGH         +0xC304   -- high half (top 20 bits of
//                                        64-bit host PA; lower 44
//                                        of DMA_ADDR_0_LOW).
//   DMA_COPY_SIZE           +0xC308   -- bytes to copy from host DMA
//                                        to WOPCM.
//   DMA_CTRL                +0xC30C   -- bit[0] START, bit[1] UOS
//                                        (meaning: this is a signed
//                                        firmware upload, not an
//                                        arbitrary host-DMA copy).
//   GUC_STATUS              +0xC000   -- bits[31:8] stage, bits[7:0]
//                                        bootrom state code
//                                        (0x02..0x30 enumerated in
//                                        §2).
//   GUC_DOORBELL_0          +0x11A000 -- doorbell page 0 (one 4K
//                                        page per client context);
//                                        any write to this register
//                                        is a submission kick that
//                                        the GuC's scheduler sees
//                                        as "work is ready in my
//                                        work queue".
//
// =============================================================================
// SECTION 2  GUC_STATUS state codes (bits [7:0])
// =============================================================================
//
// Source: i915 drm/i915/gt/uc/intel_guc_fwif.h GS_UKERNEL_LAPIC_DONE
// enumeration. These are the state codes GUC_STATUS[7:0] passes
// through in sequence as the GuC's internal bootrom + ukernel brings
// itself up:
//
//     0x02  RESET_COMPLETE       -- bootrom cleared internal SRAM
//                                   and is ready to accept a
//                                   signed firmware upload
//     0x05  EXCEPTION_DONE       -- any pending exception was
//                                   serviced and cleared (fatal
//                                   if seen after FIRMWARE_LOADED)
//     0x06  FIRMWARE_READY       -- bootrom has latched the RSA
//                                   signature from the UOS scratch
//                                   bank and is about to begin
//                                   verification
//     0x08  FIRMWARE_LOADED      -- signature verified; firmware
//                                   image copied into WOPCM and
//                                   the ukernel's entry point has
//                                   been jumped to
//     0x11  HOST_INIT_DONE       -- GuC has latched the host's
//                                   init descriptor (CTB layout
//                                   + policies + log buffer) and
//                                   is ready for the first kick
//     0x30  KM_SUBMISSION_READY  -- GuC's kernel-mode scheduler
//                                   is online and will service
//                                   doorbell writes against the
//                                   active CTB
//
// The host's wait-handshake loop polls GUC_STATUS reading only the
// low byte, comparing against the single terminal state its caller
// cares about -- the GuC NEVER goes BACKWARDS through the state
// sequence except on a hard reset, so a late-stage caller does not
// have to re-observe earlier codes.
//
// =============================================================================
// SECTION 3  CAPABILITY DISPATCH SLOT -- KIND_GPU_GUC_DRV = 0x46
// =============================================================================
//
// Grep of src/kernel/core/cap/invoke.pdx shows NO reserved slot for
// a GuC-driver kind. The adjacent 0x3C..0x45 band holds the Wave
// 59..76 derived-over-KIND_DEVICE driver kinds (KIND_FIRMWARE_BLOB
// 0x3C, KIND_BATTERY_DRV 0x3D, KIND_THERMAL_ZONE_DRV 0x3E,
// KIND_PPGTT 0x3F, KIND_FAN_DRV 0x40, KIND_HOTPLUG_DRV 0x41,
// KIND_GPU_BO_DRV 0x43, KIND_BACKLIGHT_DRV 0x44, KIND_I2C_HID_DRV
// 0x45). 0x46 is the next free numeric slot and the natural choice:
// GuC is a per-GPU-device microcontroller that fits over KIND_DEVICE
// identically to KIND_HOTPLUG_DRV (0x41) and KIND_GPU_BO_DRV (0x43).
//
// Audit at landing time: `grep -nE 'cmp rcx, 0x46\b' src/kernel/core/
// cap/invoke.pdx` returned ZERO existing dispatch arms. The invoke.
// pdx edit lands beside the existing KIND_I2C_HID_DRV arm.
//
// The handler is `cap_handler_guc` -- the final `_drv` suffix is
// elided because no authority-layer KIND_GPU_GUC exists for this
// kind to disambiguate against (unlike KIND_BACKLIGHT_DRV vs
// KIND_BACKLIGHT or KIND_BATTERY_DRV vs KIND_BATTERY).
//
// =============================================================================
// SECTION 4  ERROR CODES -- 0xFFFFFD88..0xFFFFFD8F
// =============================================================================
//
// Eight codes reserved for this module. The 0xFFFFFD80..87 band is
// already consumed (grep: see e.g. the Wave 73 I7 KIND_FIRMWARE_BLOB
// band); 0xFFFFFD88..8F is the next 8-code gap. Values:
//
//     0xFFFFFD88  GUC_ERR_BAD_CAP            -- firmware_blob_cap bounds / kind
//     0xFFFFFD89  GUC_ERR_BLOB_INVALID       -- blob slice returned
//                                               a zero-length or
//                                               misaligned base
//     0xFFFFFD8A  GUC_ERR_SIG_MISMATCH       -- UOS RSA scratch bank
//                                               verify failed (real
//                                               body); skeleton
//                                               never emits
//     0xFFFFFD8B  GUC_ERR_LOAD_TIMEOUT       -- GUC_STATUS did not
//                                               reach FIRMWARE_LOADED
//                                               within caller-supplied
//                                               deadline
//     0xFFFFFD8C  GUC_ERR_HANDSHAKE_TIMEOUT  -- GUC_STATUS did not
//                                               reach KM_SUBMISSION_
//                                               READY within deadline
//     0xFFFFFD8D  GUC_ERR_BAD_STATE          -- submit_work called
//                                               before KM_SUBMISSION_
//                                               READY was observed
//     0xFFFFFD8E  GUC_ERR_SUBMIT_FULL        -- GuC work-queue full
//                                               (CTB cursor at tail)
//     0xFFFFFD8F  GUC_ERR_RESERVED           -- reserved for the real
//                                               body's additional
//                                               failure classes
//
// Band 0xFFFFFD80..87 (used; firmware_blob) is DISJOINT from here.
// Band 0xFFFFFDA0..AC (used; kind_firmware_blob neighbor) is also
// disjoint. The adjacent reserved codes in SECTION 1 of
// kind_firmware_blob.pdx match the gap boundary.
//
// =============================================================================
// SECTION 5  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized stores): the follow-up slice uses mov_d for every
//      MMIO write (GUC_WOPCM_SIZE / DMA_* / DMA_CTRL / doorbell
//      are 32-bit per Intel bspec). This skeleton emits no MMIO
//      writes; module statics are u64 so plain REX.W mov is correct.
//   G4 (full-register compares): every cmp here is on a 64-bit
//      register; no `cmp al, imm` or `cmp eax, imm` short-form.
//   No `test rN, rN` -- equality-against-zero is `cmp rN, 0`.
//   No `and rN, imm64` -- the one mask this module needs for a real
//      body (GUC_STATUS[7:0]) is `0xFF` (imm8) so even without r11
//      staging an `and` is legal; the skeleton stages its single
//      masked compare via `mov r11, 0xFF; and r11, rax` out of habit.
//   No two-operand `imul r, imm` -- the submit_work body loads the
//      ctx_desc stride via `shl`, not imul.
//   64-bit immediates -- GUC_WOPCM_OFFSET (0xC340) fits imm32
//      (loaded via mov r64, imm) and is never used as an and-mask.
//   Multiline `pub let ="..."` is forbidden by the pdx parser;
//      every tag below is a single line.
//   Module basename matches filename basename:
//      iris_xe_guc.pdx -> module IrisXeGuc.
//   Reserved labels -- every label in this file is prefixed with the
//      per-entrypoint tag (guc_ld_, guc_kk_, guc_wh_, guc_sb_,
//      guc_hd_) so none collides with sibling GPU drivers and none
//      accidentally spells `loop`, `if`, or `let`.
//   klog_s1_x2 caller contract: v2 at caller `[rsp+0]` -- which
//      inside the wrapper after push rbp lives at `[rbp+16]`.
//      Writing v2 to `[rsp+8]` (one slot high) is the Wave 73 I7
//      pitfall; this module writes to `[rsp+0]` exclusively.
//   Fingerprint tag arrays: `[u8; N]` with N = strlen + 1 for the
//      trailing NUL. The counts below are hand-verified:
//        "GUC LOAD\0"               ->  9 bytes
//        "GUC KICK\0"               ->  9 bytes
//        "GUC HANDSHAKE\0"          -> 14 bytes
//        "cap\0"                    ->  4 bytes
//        "blob_pa\0"                ->  8 bytes
//        "doorbell_written\0"       -> 17 bytes
//        "status\0"                 ->  7 bytes
//        "state\0"                  ->  6 bytes
//
// =============================================================================
// SECTION 6  STACK + REGISTER PLAN
// =============================================================================
//
// Four entrypoints + one cap-dispatch handler:
//
//   guc_load_firmware     (blob_cap)        -> u64
//   guc_kick_doorbell     ()                -> u64
//   guc_wait_handshake    (timeout_cycles)  -> u64
//   guc_submit_work       (ctx_desc)        -> u64
//   cap_handler_guc       (rights, tgt, op) -> u64
//
// Every entrypoint is non-leaf: load_firmware calls firmware_blob_
// slice + gtt_bind + klog_s1_x2; kick_doorbell calls klog_s1_d1;
// wait_handshake calls klog_s1_x1_d1; submit_work calls klog_s1_d1
// (skeleton); cap_handler_guc calls klog_s1 + the per-op query leaf.
// Every one takes the 3-push callee-save prologue:
//
//   push rbx; push r12; push r13;    // 3 pushes, 24B
//   -- entry rsp%16 == 8; after 3 pushes rsp%16 == 0 (call-site aligned)
//
// For klog_s1_x2 / klog_s1_x1_d1 (1 stack arg = v2 or vd): the caller
// does `sub rsp, 16; mov [rsp+0], <value>; call ...; add rsp, 16;`.
// The `[rsp+0]` placement is REQUIRED -- the wrapper reads v2/vd
// from `[rbp+16]` which is caller's `[rsp+0]` at the moment of CALL.
//
// =============================================================================
// SECTION 7  WIRING
// =============================================================================
//
// Not wired to the smoke witness at skeleton stage. The file
// compiles alongside the kernel because tools/build.sh recurses
// through src/kernel/core/drivers/gpu/ with a single `find`, so a
// new .pdx in that directory is picked up automatically; no
// build.sh edit required.
//
// invoke.pdx edit: adds one dispatch arm (0x46 -> cap_handler_guc)
// adjacent to the Wave 76 D13 KIND_I2C_HID_DRV arm, and one call
// stub (call_kind_guc) adjacent to the call_kind_i2c_hid stub.
//
// Follow-up boot-witness programme at tests/kernel/drivers/
// wit_iris_xe_guc_handshake.pdx will:
//   (1) guc_load_firmware(firmware_lookup("guc", 3));
//   (2) guc_kick_doorbell();
//   (3) guc_wait_handshake(1000000);
//   (4) guc_submit_work(0xDEADBEEF);
// and assert the three fingerprints land on the klog wire plus the
// counter getters report (1, 1, 1, 1).

module IrisXeGuc = structure {

  // ==========================================================================
  // §A  Register offsets -- BAR0-relative, per Intel bspec §15
  // ==========================================================================

  pub let GUC_WOPCM_SIZE       : u64 = 0xC050
  pub let GUC_WOPCM_OFFSET     : u64 = 0xC340
  pub let GUC_UOS_RSA_SCRATCH0 : u64 = 0xC200
  pub let GUC_DMA_ADDR_0_LOW   : u64 = 0xC300
  pub let GUC_DMA_ADDR_0_HIGH  : u64 = 0xC304
  pub let GUC_DMA_COPY_SIZE    : u64 = 0xC308
  pub let GUC_DMA_CTRL         : u64 = 0xC30C
  pub let GUC_STATUS           : u64 = 0xC000
  pub let GUC_DOORBELL_0       : u64 = 0x11A000

  // DMA_CTRL bits.
  pub let GUC_DMA_CTRL_START   : u64 = 0x01
  pub let GUC_DMA_CTRL_UOS     : u64 = 0x02

  // GUC_WOPCM_SIZE[0] -- one-way lock bit.
  pub let GUC_WOPCM_LOCKED     : u64 = 0x01

  // Status byte mask (GUC_STATUS[7:0]).
  pub let GUC_STATUS_MASK      : u64 = 0xFF

  // ==========================================================================
  // §B  GUC_STATUS state codes
  // ==========================================================================

  pub let GUC_STATE_RESET_COMPLETE      : u64 = 0x02
  pub let GUC_STATE_EXCEPTION_DONE      : u64 = 0x05
  pub let GUC_STATE_FIRMWARE_READY      : u64 = 0x06
  pub let GUC_STATE_FIRMWARE_LOADED     : u64 = 0x08
  pub let GUC_STATE_HOST_INIT_DONE      : u64 = 0x11
  pub let GUC_STATE_KM_SUBMISSION_READY : u64 = 0x30

  // ==========================================================================
  // §C  Failure taxonomy -- band 0xFFFFFD88..0xFFFFFD8F
  // ==========================================================================

  pub let GUC_OK                        : u64 = 0
  pub let GUC_ERR_BAD_CAP               : u64 = 0xFFFFFD88
  pub let GUC_ERR_BLOB_INVALID          : u64 = 0xFFFFFD89
  pub let GUC_ERR_SIG_MISMATCH          : u64 = 0xFFFFFD8A
  pub let GUC_ERR_LOAD_TIMEOUT          : u64 = 0xFFFFFD8B
  pub let GUC_ERR_HANDSHAKE_TIMEOUT     : u64 = 0xFFFFFD8C
  pub let GUC_ERR_BAD_STATE             : u64 = 0xFFFFFD8D
  pub let GUC_ERR_SUBMIT_FULL           : u64 = 0xFFFFFD8E
  pub let GUC_ERR_RESERVED              : u64 = 0xFFFFFD8F

  // Invoke-layer sentinels; module-local copies so cap_handler_guc
  // need not reach into the invoke module. Bit-identical to the
  // values in cap/invoke.pdx and kind_firmware_blob.pdx.
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Rights-mask bits. R_GUC_READ gates every QUERY op in
  // cap_handler_guc. The real body (follow-up slice) adds
  // R_GUC_LOAD and R_GUC_SUBMIT for the two destructive paths.
  pub let R_GUC_READ : u64 = 0x001

  // ==========================================================================
  // §D  Module state -- last-observed GuC status + the four counters
  //
  // The skeleton records (last_blob_cap, last_blob_pa, last_blob_len,
  // last_status) each entry so a boot-witness programme can read
  // them back through the stat accessors in §K. Each slot is u64
  // for alignment; the real body preserves this layout and extends
  // it with CTB cursor + log-buffer base.
  // ==========================================================================

  pub let mut _guc_last_blob_cap : u64 = 0
  pub let mut _guc_last_blob_pa  : u64 = 0
  pub let mut _guc_last_blob_len : u64 = 0
  pub let mut _guc_last_status   : u64 = 0

  // Per-op counters.
  pub let mut _guc_load_ct       : u64 = 0
  pub let mut _guc_kick_ct       : u64 = 0
  pub let mut _guc_handshake_ct  : u64 = 0
  pub let mut _guc_submit_ct     : u64 = 0

  // ==========================================================================
  // §E  Fingerprint tags + keys
  //
  // Fingerprints on the wire:
  //   GUC LOAD cap=0x<16-hex> blob_pa=0x<16-hex>
  //   GUC KICK doorbell_written=1
  //   GUC HANDSHAKE status=0x<8-hex> state=<dec>
  //
  // Matches tests/fingerprints/iris_xe_guc.golden.
  // ==========================================================================

  pub let guc_tag_load      : [u8; 9]  = "GUC LOAD\0"
  pub let guc_tag_kick      : [u8; 9]  = "GUC KICK\0"
  pub let guc_tag_handshake : [u8; 14] = "GUC HANDSHAKE\0"
  pub let guc_tag_handler   : [u8; 11] = "GUC HANDLE\0"

  pub let guc_k_cap         : [u8; 4]  = "cap\0"
  pub let guc_k_blob_pa     : [u8; 8]  = "blob_pa\0"
  pub let guc_k_doorbell    : [u8; 17] = "doorbell_written\0"
  pub let guc_k_status      : [u8; 7]  = "status\0"
  pub let guc_k_state       : [u8; 6]  = "state\0"

  // ==========================================================================
  // §F  guc_load_firmware(blob_cap) -> u64
  //
  // Stage the signed GuC firmware blob into WOPCM. Real body:
  // firmware_blob_slice(cap, &pa, &len); gtt_bind(GUC_WOPCM_OFFSET,
  // pa, RW); mov_d GUC_WOPCM_SIZE | LOCKED; mov_d DMA_ADDR_0_LOW/
  // HIGH; mov_d DMA_COPY_SIZE; mov_d DMA_CTRL (START | UOS); poll
  // GUC_STATUS until FIRMWARE_LOADED (0x08). Skeleton stops at the
  // state record + fingerprint.
  //
  // Gate: firmware_blob_slice return nonzero -> GUC_ERR_BAD_CAP.
  //
  // SysV: rdi = blob_cap.
  // Stack: 3-push callee-save prologue + sub rsp, 16 for the
  // klog_s1_x2 v2 slot + two u64 locals for firmware_blob_slice's
  // out_ptr / out_len (stored in the module's _guc_last_blob_pa /
  // _guc_last_blob_len globals so no extra stack cells are needed).
  // Labels prefixed guc_ld_.
  // ==========================================================================

  pub let guc_load_firmware : (u64) -> u64 !{mem, sysreg} @{boot, cap} =
    fn (blob_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: validate firmware blob cap, resolve its (pa, len) via firmware_blob_slice, record (cap, pa, len) into module state, bump _guc_load_ct, emit `GUC LOAD cap=0x<hex> blob_pa=0x<hex>` via klog_s1_x2. Gate: firmware_blob_slice nonzero return -> GUC_ERR_BAD_CAP (the slice helper itself distinguishes bounds / kind-wrong / already-released, but at skeleton stage the GuC layer collapses all three to BAD_CAP; the follow-up slice preserves the slice-helper's distinction so operators can tell `signature-chain broken` from `cap revoked`). The real body (follow-up slice) continues: gtt_bind(GUC_WOPCM_OFFSET, pa, RW); mov_d GUC_WOPCM_SIZE | LOCKED; mov_d DMA_ADDR_0_LOW / HIGH; mov_d DMA_COPY_SIZE; mov_d DMA_CTRL (START | UOS); poll GUC_STATUS until FIRMWARE_LOADED (0x08) or GUC_ERR_LOAD_TIMEOUT. Register plan: rbx=blob_cap (saved for fingerprint + state record), r12=blob_pa (saved post-slice). Entry rsp%16==8; 3 pushes +24 -> ==0; sub rsp,16 -> ==0 at the klog_s1_x2 call site (v2 at [rsp+0]). Labels prefixed guc_ld_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                         // rbx = blob_cap

        // --- Call firmware_blob_slice(cap, &_guc_last_blob_pa,
        //     &_guc_last_blob_len). On success rax == 0 and the
        //     two globals hold the slice. Signature from
        //     kind_firmware_blob.pdx L885.
        mov rdi, rbx;                         // cap
        lea rsi, [rip + _guc_last_blob_pa];   // out_ptr_ptr
        lea rdx, [rip + _guc_last_blob_len];  // out_len_ptr
        call firmware_blob_slice;
        cmp rax, 0;
        jne guc_ld_badcap;

        // --- Reload blob_pa for the fingerprint.
        mov r12, [rip + _guc_last_blob_pa];

        // --- Record cap into module state.
        mov [rip + _guc_last_blob_cap], rbx;

        // --- Count the load (bump before fingerprint so a crash
        //     mid-fingerprint still records the entry).
        mov rax, [rip + _guc_load_ct];
        add rax, 1;
        mov [rip + _guc_load_ct], rax;

        // --- klog_s1_x2(level=3, SUBSYS_DRV_, guc_tag_load,
        //                guc_k_cap, blob_cap,
        //                guc_k_blob_pa, [v2 = blob_pa]).
        //
        // SysV reg args: level, subsys, tag, k1, v1, k2. The 7th
        // arg (v2) lives at caller [rsp+0] which maps to the
        // wrapper's [rbp+16] after push rbp.
        sub rsp, 16;
        mov [rsp + 0], r12;                   // v2 = blob_pa
        mov rdi, 3;                           // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + guc_tag_load];
        lea rcx, [rip + guc_k_cap];           // k1
        mov r8, rbx;                          // v1 = blob_cap
        lea r9, [rip + guc_k_blob_pa];        // k2
        call klog_s1_x2;
        add rsp, 16;

        xor rax, rax;                         // GUC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      guc_ld_badcap:
        mov rax, 0xFFFFFD88;                  // GUC_ERR_BAD_CAP
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §G  guc_kick_doorbell() -> u64
  //
  // Ring GUC_DOORBELL_0 to tell the GuC's scheduler there is work
  // in its CTB. Real body: mov_d [bar0 + GUC_DOORBELL_0], 1 (any
  // nonzero value kicks; i915 uses 1). Skeleton stops at the state
  // bump + fingerprint.
  //
  // No gates: a doorbell write is a hardware primitive; the GuC's
  // own scheduler refuses or stalls on a kick before HOST_INIT_
  // DONE, and the layered submit path (guc_submit_work) is what
  // enforces the state precondition in software.
  //
  // SysV: no args. 3-push callee-save prologue + no stack args
  // (klog_s1_d1 is a reg-only 6-param call). Labels prefixed guc_kk_.
  // ==========================================================================

  pub let guc_kick_doorbell : () -> u64 !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: bump _guc_kick_ct, emit `GUC KICK doorbell_written=1` fingerprint via klog_s1_d1. The real body writes mov_d [bar0 + GUC_DOORBELL_0], 1; the skeleton omits the MMIO since neither QEMU nor the T14 G4 BAR mapping is wired at Wave 77. No gates in software -- the GuC's scheduler is the authority on when a kick is valid; the layered guc_submit_work path above this is where the state-machine precondition is enforced. The decimal `=1` on the wire comes from klog_s1_d1 with fmt='d'; the only KV is a constant 1 so no register staging is needed. Three callee-save pushes keep the 3-push shape identical across every entrypoint in this file (shape stability > minimality). Labels prefixed guc_kk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // --- Count the kick.
        mov rax, [rip + _guc_kick_ct];
        add rax, 1;
        mov [rip + _guc_kick_ct], rax;

        // --- klog_s1_d1(level=3, SUBSYS_DRV_, guc_tag_kick,
        //                guc_k_doorbell, 1).
        mov rdi, 3;                           // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + guc_tag_kick];
        lea rcx, [rip + guc_k_doorbell];      // k1
        mov r8, 1;                            // v1 = 1 (decimal)
        call klog_s1_d1;

        xor rax, rax;                         // GUC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  guc_wait_handshake(timeout_cycles) -> u64
  //
  // Poll GUC_STATUS until the low byte reaches KM_SUBMISSION_READY
  // (0x30) or `timeout_cycles` iterations have elapsed. Real body:
  // mov_d rax, [bar0 + GUC_STATUS]; mov r11, 0xFF; and r11, rax; cmp
  // r11, 0x30; je done; sub rcx, 1; jnz loop_head; return
  // GUC_ERR_HANDSHAKE_TIMEOUT. Skeleton records the terminal state
  // (synthetic 0x30 so the fingerprint renders cleanly) + bumps
  // the counter.
  //
  // Gate: timeout_cycles == 0 -> GUC_ERR_HANDSHAKE_TIMEOUT
  //       (a zero-cycle budget is a programming error, not a
  //       successful handshake).
  //
  // SysV: rdi = timeout_cycles.
  // Stack: 3-push callee-save + sub rsp, 16 for the klog_s1_x1_d1
  // vd stack slot (status is hex v1 in r8; state is decimal vd at
  // [rsp+0]). Labels prefixed guc_wh_.
  // ==========================================================================

  pub let guc_wait_handshake : (u64) -> u64 !{mem, sysreg} @{boot, cap} =
    fn (timeout_cycles: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: validate timeout, record synthetic KM_SUBMISSION_READY (0x30) into _guc_last_status, bump _guc_handshake_ct, emit `GUC HANDSHAKE status=0x<hex> state=<dec>` via klog_s1_x1_d1. Gate: timeout_cycles == 0 -> GUC_ERR_HANDSHAKE_TIMEOUT. The real body (follow-up slice) polls GUC_STATUS via mov_d; status[7:0] is masked via `mov r11, 0xFF; and r11, rax` to sidestep the `and r11, imm64` encoder gap; `cmp r11, 0x30` is the terminal check; the decrement loop uses `sub rcx, 1; jnz guc_wh_loop_head` which is G4-safe (sub rN, imm32 only; no imul). Register plan: rbx = timeout_cycles (saved), r12 = loaded status (saved for fingerprint), r13 = masked state (saved for fingerprint). Entry rsp%16==8; 3 pushes +24 -> ==0; sub rsp,16 -> ==0 at the klog_s1_x1_d1 call site (vd at [rsp+0]). Labels prefixed guc_wh_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                         // rbx = timeout_cycles

        // --- Gate: zero-cycle budget is a programming error.
        cmp rbx, 0;
        je  guc_wh_timeout;

        // --- Skeleton: synthesize KM_SUBMISSION_READY as the
        //     observed state. The full u32 status word is modeled
        //     as (0x30 | 0x00000000) so the hex fingerprint
        //     renders a clean 0x30; the low byte is 0x30
        //     (KM_SUBMISSION_READY).
        mov r12, 0x30;                        // synthetic full status
        mov r13, 0x30;                        // low-byte state

        // --- Record the terminal status so witness callers can
        //     read it back through guc_last_status_q.
        mov [rip + _guc_last_status], r12;

        // --- Count the handshake.
        mov rax, [rip + _guc_handshake_ct];
        add rax, 1;
        mov [rip + _guc_handshake_ct], rax;

        // --- klog_s1_x1_d1(level=3, SUBSYS_DRV_, guc_tag_handshake,
        //                   guc_k_status, status, guc_k_state,
        //                   [vd = state]).
        //
        // SysV reg args: level, subsys, tag, kx, vx, kd. 7th arg
        // (vd) at caller [rsp+0] -> wrapper [rbp+16].
        sub rsp, 16;
        mov [rsp + 0], r13;                   // vd = state (decimal)
        mov rdi, 3;                           // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + guc_tag_handshake];
        lea rcx, [rip + guc_k_status];        // kx
        mov r8, r12;                          // vx = status (hex)
        lea r9, [rip + guc_k_state];          // kd
        call klog_s1_x1_d1;
        add rsp, 16;

        xor rax, rax;                         // GUC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      guc_wh_timeout:
        mov rax, 0xFFFFFD8C;                  // GUC_ERR_HANDSHAKE_TIMEOUT
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  guc_submit_work(ctx_desc) -> u64
  //
  // Append `ctx_desc` to the GuC CTB (Command Transport Buffer)
  // and kick the doorbell. Real body: validate GuC is in
  // KM_SUBMISSION_READY by reading _guc_last_status; load CTB tail
  // cursor; copy ctx_desc into the tail slot; advance tail; write
  // doorbell. Skeleton stops at the state-precondition check +
  // counter bump.
  //
  // Gates:
  //   (1) _guc_last_status != KM_SUBMISSION_READY (0x30) ->
  //       GUC_ERR_BAD_STATE (caller must observe a successful
  //       guc_wait_handshake before submitting).
  //
  // SysV: rdi = ctx_desc. Leaf-ish (no klog call at skeleton stage;
  // submit does not emit its own fingerprint -- the KICK fingerprint
  // of the paired guc_kick_doorbell call is the submission's
  // operator-visible event). 3-push shape retained for consistency.
  // Labels prefixed guc_sb_.
  // ==========================================================================

  pub let guc_submit_work : (u64) -> u64 !{mem, sysreg} @{boot, cap} =
    fn (ctx_desc: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: validate GuC is in KM_SUBMISSION_READY, bump _guc_submit_ct, return GUC_OK. Gate: _guc_last_status != 0x30 -> GUC_ERR_BAD_STATE (operator must observe guc_wait_handshake success before submitting). The real body (follow-up slice): load CTB tail cursor from module state; copy ctx_desc into the tail slot via a 64-bit mov; advance the cursor; call guc_kick_doorbell to ring the hardware. ctx_desc is `saved into` rbx but at skeleton stage it is otherwise unused -- the parameter is retained so the caller signature does not shift on the follow-up PR. Register plan: rbx=ctx_desc (saved). Entry rsp%16==8; 3 pushes +24 -> ==0 (no nested call at skeleton; shape kept for consistency with the real body which calls guc_kick_doorbell). Labels prefixed guc_sb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                         // rbx = ctx_desc (saved)

        // --- Gate: GuC must be in KM_SUBMISSION_READY (0x30).
        mov rax, [rip + _guc_last_status];
        cmp rax, 0x30;
        jne guc_sb_badstate;

        // --- Count the submit.
        mov rax, [rip + _guc_submit_ct];
        add rax, 1;
        mov [rip + _guc_submit_ct], rax;

        xor rax, rax;                         // GUC_OK
        pop r13;
        pop r12;
        pop rbx;
        ret;

      guc_sb_badstate:
        mov rax, 0xFFFFFD8D;                  // GUC_ERR_BAD_STATE
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  cap_handler_guc(rights, target_ptr, op_arg) -> u64
  //
  // KIND_GPU_GUC_DRV (0x46) cap-invoke dispatch. Query-only at
  // skeleton stage; the destructive ops (LOAD, KICK, SUBMIT) are
  // reached by driver-privileged kernel paths above the generic
  // cap_invoke syscall ABI, same posture as cap_handler_i2c_hid
  // (Wave 76 D13).
  //
  //     op 0 QUERY_LAST_STATUS -> _guc_last_status (as hex)
  //     op 1 QUERY_LOAD_COUNT  -> _guc_load_ct
  //     op 2 QUERY_KICK_COUNT  -> _guc_kick_ct
  //     op 3 QUERY_HAND_COUNT  -> _guc_handshake_ct
  //     op 4 QUERY_SUB_COUNT   -> _guc_submit_ct
  //     else                   -> INVOKE_UNSUPPORTED
  //
  // Rights gate: every op requires R_GUC_READ.
  // target_ptr is unused at skeleton stage (module-wide query);
  // follow-up slice adds a per-GPU-device row table + per-ptr
  // dispatch.
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg.
  // Stack recipe: 3-push callee-save (rbx=rights, r12=target_ptr,
  // r13=op_code). The op_code mask (op_arg & 0xFF) stages through
  // r10 to sidestep the `and r11, imm64` encoder gap. Labels
  // prefixed guc_hd_.
  // ==========================================================================

  pub let cap_handler_guc : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64, target_ptr: u64, op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 77 G7 (paideia-os#2544): KIND_GPU_GUC_DRV cap_invoke dispatch. Entry chatter (klog_s1 of guc_tag_handler) with the three incoming regs preserved in callee-save slots. op_code = op_arg & 0xFF; rights gate against R_GUC_READ; dispatch 0..4 to the matching accessor via immediate loads from the module statics; else INVOKE_UNSUPPORTED. target_ptr is unused at skeleton stage (query is module-wide); follow-up slice adds per-device row table + per-ptr dispatch. Three callee-save pushes land rsp%16==0 at the klog_s1 call site. The 8-bit op_code mask stages through r10 (`mov r10, 0xFF; and r13, r10`) to sidestep `and r11, imm64`. Labels prefixed guc_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                         // rights
        mov r12, rsi;                         // target_ptr (unused at skeleton)
        mov r13, rdx;                         // op_arg
        mov r10, 0xFF;
        and r13, r10;                         // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                           // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + guc_tag_handler];
        call klog_s1;

        // Rights gate.
        mov r10, rbx;
        and r10, 0x001;                       // R_GUC_READ
        cmp r10, 0;
        je  guc_hd_denied;

        // Op dispatch.
        cmp r13, 0;
        je  guc_hd_op_status;
        cmp r13, 1;
        je  guc_hd_op_load;
        cmp r13, 2;
        je  guc_hd_op_kick;
        cmp r13, 3;
        je  guc_hd_op_hand;
        cmp r13, 4;
        je  guc_hd_op_sub;
        jmp guc_hd_unsup;

      guc_hd_op_status:
        mov rax, [rip + _guc_last_status];
        jmp guc_hd_out;

      guc_hd_op_load:
        mov rax, [rip + _guc_load_ct];
        jmp guc_hd_out;

      guc_hd_op_kick:
        mov rax, [rip + _guc_kick_ct];
        jmp guc_hd_out;

      guc_hd_op_hand:
        mov rax, [rip + _guc_handshake_ct];
        jmp guc_hd_out;

      guc_hd_op_sub:
        mov rax, [rip + _guc_submit_ct];
        jmp guc_hd_out;

      guc_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;          // INVOKE_DENIED
        jmp guc_hd_out;
      guc_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;          // INVOKE_UNSUPPORTED

      guc_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  Stat accessors -- single-load leaf getters for witness callers.
  //
  // Five getters so a boot-witness programme can assert the entries
  // bumped past zero without reaching into the module's statics
  // directly. Each is a single-load leaf; signatures stay stable
  // when the follow-up slice re-shapes the storage.
  // ==========================================================================

  pub let guc_load_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: single-load getter for _guc_load_ct. Witness-side assertion anchor. Leaf.",
      block: { mov rax, [rip + _guc_load_ct]; ret }
    }

  pub let guc_kick_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: single-load getter for _guc_kick_ct. Pair for guc_load_count. Leaf.",
      block: { mov rax, [rip + _guc_kick_ct]; ret }
    }

  pub let guc_handshake_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: single-load getter for _guc_handshake_ct. Pair for guc_load_count. Leaf.",
      block: { mov rax, [rip + _guc_handshake_ct]; ret }
    }

  pub let guc_submit_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: single-load getter for _guc_submit_ct. Pair for guc_load_count. Leaf.",
      block: { mov rax, [rip + _guc_submit_ct]; ret }
    }

  pub let guc_last_status_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 G7 (paideia-os#2544) skeleton: single-load getter for _guc_last_status. Pair for guc_load_count. Leaf.",
      block: { mov rax, [rip + _guc_last_status]; ret }
    }
}
