// src/kernel/core/drivers/gpu/cache_policy.pdx — R37.M3-004 (#1265)
//
// GPU cache policy — per-BO MOCS (Memory Object Control State) index
// selection and coherency-domain classification.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DECISION SITE for "given a caller-declared cache policy
// (WB / WT / UC / WC), which MOCS index and which coherency domain
// (CPU or GPU) does the CPU-visible mapping and the GPU-side scan-out
// receive." Every consumer that programs a page-table entry or
// requests a GPU surface state routes through this module: a second
// site with a second table would let one path stamp WB into a surface
// state while the other stamped UC into the CPU mapping, and every
// buffer produced by the first and read by the second would silently
// tear.
//
// IT DOES NOT PROGRAM THE PAT / MTRR ENTRIES. The Iris Xe MOCS table
// is programmed at gpu_mmio_init (R37.M1); this module answers "which
// existing MOCS index applies to this cache policy" -- it does not
// hand out new indices, and it does not mutate the table.
//
// IT DOES NOT VALIDATE CAPABILITY RIGHTS. Ownership over the BO the
// policy applies to is enforced one layer up by KIND_GPU_BO's
// dispatch; this module is a pure classification function.
//
// =============================================================================
// §1  THE FOUR POLICIES
// =============================================================================
//
// WB (writeback, fmt=0):
//   CPU cache lines carry the authoritative state; the GPU snoops on
//   the CPU coherency domain. Fastest CPU-side writes into
//   compositor overlay buffers; requires GPU-CPU-coherent
//   architectures (all Gen12+ Iris Xe qualifies).
//   MOCS index: 2 (Xe1 default WB with snooping).
//   Coherency domain: CPU (snooped by GPU).
//
// WT (writethrough, fmt=1):
//   CPU writes hit both cache and memory; the GPU reads memory. Used
//   for immutable-once-written textures (shader constants,
//   compile-time atlases) where the WB coherency traffic would be
//   pure overhead.
//   MOCS index: 3 (Xe1 WT with GPU-side pass-through).
//   Coherency domain: CPU (write-flush on entry, no snoop).
//
// UC (uncached, fmt=2):
//   CPU writes bypass cache. Command-buffer submission paths, ring
//   head/tail pointers, and MSI-X vector pages. The GPU sees writes
//   immediately.
//   MOCS index: 0 (Xe1 UC / non-cacheable).
//   Coherency domain: NONE (both sides bypass their private caches).
//
// WC (writecombine, fmt=3):
//   CPU writes coalesce into 64-byte fill buffers and are pushed to
//   memory in bursts. Scan-out buffers where the CPU is producer and
//   the GPU is consumer at video rate.
//   MOCS index: 1 (Xe1 WC / streaming).
//   Coherency domain: GPU (CPU flushes on frame boundary).
//
// =============================================================================
// §2  COHERENCY DOMAIN VALUES
// =============================================================================
//
//   CPOL_DOMAIN_CPU   (0)  authoritative state on CPU-side lines
//   CPOL_DOMAIN_GPU   (1)  authoritative state on GPU-side lines
//   CPOL_DOMAIN_NONE  (2)  neither cache is authoritative
//
// =============================================================================
// §3  ONE WRITER OF THE COUNTERS
// =============================================================================
//
// _cache_policy_stats is written only by helpers in this module.
// tools/build.sh confines relocations against it to
// core/drivers/gpu/cache_policy.o.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF610..0xFFFFF61F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: tiling
// 0xFFFFF620..2F; adjacent free band below: gpu_bo_alloc_channel
// 0xFFFFF600..0F).

module CachePolicy = structure {

  // §1: policy ordinals (mirror KindGpuBo.KGB_CACHE_*).
  pub let CPOL_WB  : u64 = 0
  pub let CPOL_WT  : u64 = 1
  pub let CPOL_UC  : u64 = 2
  pub let CPOL_WC  : u64 = 3
  pub let CPOL_MAX : u64 = 3

  // §1: per-policy MOCS index.
  pub let CPOL_MOCS_WB : u64 = 2
  pub let CPOL_MOCS_WT : u64 = 3
  pub let CPOL_MOCS_UC : u64 = 0
  pub let CPOL_MOCS_WC : u64 = 1

  // §2: coherency-domain ordinals.
  pub let CPOL_DOMAIN_CPU  : u64 = 0
  pub let CPOL_DOMAIN_GPU  : u64 = 1
  pub let CPOL_DOMAIN_NONE : u64 = 2

  // Failure taxonomy -- 0xFFFFF610..0xFFFFF61F.
  pub let CPOL_OK          : u64 = 0
  pub let CPOL_BAD_POLICY  : u64 = 0xFFFFF61F
  pub let CPOL_BAD_ARG     : u64 = 0xFFFFF61E
  pub let CPOL_DECODE_BAD  : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _cache_policy_stats : [u64; 8] = uninit @align(64)

  pub let CPOL_ST_WB  : u64 = 0
  pub let CPOL_ST_WT  : u64 = 1
  pub let CPOL_ST_UC  : u64 = 2
  pub let CPOL_ST_WC  : u64 = 3
  pub let CPOL_ST_REFUSED : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let cache_policy_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-004 (#1265): clear the cache policy counter row. Boot and teardown only. Labels prefixed cpol_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _cache_policy_stats];
        xor rcx, rcx;
      cpol_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cpol_rs_stats;
        ret
      }
    }

  pub let cpol_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-004 (#1265): counter bump. Labels prefixed cpol_nt_.",
      block: {
        cmp rdi, 8;
        jae cpol_nt_out;
        lea r10, [rip + _cache_policy_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cpol_nt_out:
        ret
      }
    }

  pub let cpol_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-004 (#1265): counter read. Labels prefixed cpol_st_.",
      block: {
        cmp rdi, 8;
        jae cpol_st_zero;
        lea r10, [rip + _cache_policy_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cpol_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let cpol_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-004 (#1265): 1 iff p <= CPOL_MAX (3). Labels prefixed cpol_v_.",
      block: {
        cmp rdi, 3;
        ja  cpol_v_no;
        mov rax, 1;
        ret;
      cpol_v_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cpol_mocs_index(policy) -> MOCS index | DECODE_BAD
  //
  // §1's per-policy MOCS index lookup. The single authority mapping
  // (WB, WT, UC, WC) -> (2, 3, 0, 1). Bumps the matching per-policy
  // counter on a live query; bumps REFUSED on a bad policy.
  // ==========================================================================

  pub let cpol_mocs_index : (u64) -> u64 !{mem} @{} =
    fn (policy: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M3-004 (#1265) + #1613: per-policy MOCS index. On a policy outside the declared range, returns the SPECIFIC band code CPOL_BAD_POLICY (0xFFFFF61F) rather than a generic sentinel; a caller comparing against 0xFFFFFFFFFFFFFFFF would have compared against a value this module never produces, so an operator inspecting the code would learn nothing about which validator refused. Labels prefixed cpol_mi_.",
      block: {
        push r12;
        mov r12, rdi;

        cmp r12, 3;
        ja  cpol_mi_bad;

        // Bump per-policy counter.
        mov rdi, r12;
        call cpol_note;

        cmp r12, 0;
        je  cpol_mi_wb;
        cmp r12, 1;
        je  cpol_mi_wt;
        cmp r12, 2;
        je  cpol_mi_uc;
        // fall through to WC
        mov rax, 1;
        jmp cpol_mi_out;

      cpol_mi_wb:
        mov rax, 2;
        jmp cpol_mi_out;
      cpol_mi_wt:
        mov rax, 3;
        jmp cpol_mi_out;
      cpol_mi_uc:
        xor rax, rax;
        jmp cpol_mi_out;

      cpol_mi_bad:
        mov rdi, 4;                      // REFUSED
        call cpol_note;
        mov rax, 0xFFFFF61F;             // CPOL_BAD_POLICY

      cpol_mi_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cpol_coherency_domain(policy) -> CPU | GPU | NONE | DECODE_BAD
  //
  // §1's per-policy coherency-domain mapping.
  //   WB -> CPU (snooped)
  //   WT -> CPU (write-flush)
  //   UC -> NONE (both sides bypass)
  //   WC -> GPU (frame-boundary flush)
  // ==========================================================================

  pub let cpol_coherency_domain : (u64) -> u64 !{} @{} =
    fn (policy: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M3-004 (#1265) + #1613: per-policy coherency-domain ordinal. On a policy outside the declared range, returns the SPECIFIC band code CPOL_BAD_POLICY (0xFFFFF61F) rather than a generic sentinel — same reasoning as cpol_mocs_index. Labels prefixed cpol_cd_.",
      block: {
        cmp rdi, 0;
        je  cpol_cd_cpu;
        cmp rdi, 1;
        je  cpol_cd_cpu;
        cmp rdi, 2;
        je  cpol_cd_none;
        cmp rdi, 3;
        je  cpol_cd_gpu;
        mov rax, 0xFFFFF61F;             // CPOL_BAD_POLICY
        ret;
      cpol_cd_cpu:
        xor rax, rax;
        ret;
      cpol_cd_gpu:
        mov rax, 1;
        ret;
      cpol_cd_none:
        mov rax, 2;
        ret
      }
    }
}
