// src/kernel/core/drivers/scsi/scsi_cmd.pdx — R34.M3-003 (#1178)
//
// SCSI command layer, per SPC-4 / SBC-3.
//
// This module SCAFFOLDS SCSI CDB (Command Descriptor Block)
// construction for the small set of commands a mass-storage class
// driver needs: READ(10)/READ(16), WRITE(10)/WRITE(16), INQUIRY,
// READ_CAPACITY(10)/READ_CAPACITY(16), TEST_UNIT_READY,
// REQUEST_SENSE.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is a CDB PACKER. It writes a CDB into a caller-supplied buffer;
// it does NOT wrap it in a CBW (bot.pdx does that) or in a Command
// IU (uas.pdx does that). Keeping the three layers disjoint is what
// lets one BOT/UAS transport swap while the SCSI layer above them
// stays unchanged.
//
// IT IS NOT A LIVE DRIVER. scsi_cmd_arbitrated() returns 0 until
// R34.M3 wires this into a driver that consumes real completions.
//
// =============================================================================
// §1  CDB LAYOUT — SPC-4 §4
// =============================================================================
//
// The first byte of every CDB is the OPERATION CODE. The CDB's
// length is fixed by that opcode (6/10/12/16 bytes for group 0/1/2/4
// commands, per SPC-4 Table 12). This module produces:
//
//   TEST_UNIT_READY    0x00  6 bytes
//   REQUEST_SENSE      0x03  6 bytes
//   INQUIRY            0x12  6 bytes
//   READ_CAPACITY(10)  0x25  10 bytes
//   READ(10)           0x28  10 bytes
//   WRITE(10)          0x2A  10 bytes
//   READ_CAPACITY(16)  0x9E service 0x10, 16 bytes
//   READ(16)           0x88  16 bytes
//   WRITE(16)          0x8A  16 bytes
//
// SPC-4 §4 fields, endianness is BIG-ENDIAN in the CDB (SCSI on-the-
// wire order): the LBA at offset [+2..+5] of READ(10) is stored MSB
// first.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFFB30..0xFFFFFB3F
// =============================================================================

module ScsiCmd = structure {

  pub let SCSI_OP_TEST_UNIT_READY   : u64 = 0x00
  pub let SCSI_OP_REQUEST_SENSE     : u64 = 0x03
  pub let SCSI_OP_INQUIRY           : u64 = 0x12
  pub let SCSI_OP_READ_CAPACITY_10  : u64 = 0x25
  pub let SCSI_OP_READ_10           : u64 = 0x28
  pub let SCSI_OP_WRITE_10          : u64 = 0x2A
  pub let SCSI_OP_READ_16           : u64 = 0x88
  pub let SCSI_OP_WRITE_16          : u64 = 0x8A
  pub let SCSI_OP_READ_CAPACITY_16  : u64 = 0x9E   // service action 0x10

  pub let SCSI_CDB6_LEN  : u64 = 6
  pub let SCSI_CDB10_LEN : u64 = 10
  pub let SCSI_CDB16_LEN : u64 = 16

  pub let SCSI_LBA32_MAX     : u64 = 0xFFFFFFFF
  pub let SCSI_XFER16_MAX    : u64 = 0xFFFF
  pub let SCSI_XFER32_MAX    : u64 = 0xFFFFFFFF
  pub let SCSI_INQ_ALLOC_MAX : u64 = 255

  pub let SCSI_CMD_OK              : u64 = 0
  pub let SCSI_CMD_BAD_BUF         : u64 = 0xFFFFFB3F
  pub let SCSI_CMD_BAD_LEN         : u64 = 0xFFFFFB3E
  pub let SCSI_CMD_BAD_OP          : u64 = 0xFFFFFB3D
  pub let SCSI_CMD_BAD_LBA         : u64 = 0xFFFFFB3C
  pub let SCSI_CMD_BAD_XFER        : u64 = 0xFFFFFB3B
  pub let SCSI_CMD_BAD_ALLOC       : u64 = 0xFFFFFB3A
  pub let SCSI_CMD_BAD_ARG         : u64 = 0xFFFFFB39

  pub let mut _scsi_cmd_stats : [u64; 8] = uninit @align(64)

  pub let SCSI_CMD_ST_PACKS     : u64 = 0
  pub let SCSI_CMD_ST_REJECTS   : u64 = 1
  pub let SCSI_CMD_ST_PARSES    : u64 = 2

  pub let scsi_cmd_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): clear scsi_cmd stats. Labels prefixed scmd_rs_.",
      block: {
        lea r10, [rip + _scsi_cmd_stats];
        xor rax, rax;
        xor rcx, rcx;
      scmd_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  scmd_rs_loop;
        ret
      }
    }

  pub let scsi_cmd_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-003 (#1178): honesty pin. Returns 0 until R34.M3 wires a driver.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let scsi_cmd_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): counter read. Labels prefixed scmd_st_.",
      block: {
        cmp rdi, 8;
        jae scmd_st_zero;
        lea r10, [rip + _scsi_cmd_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      scmd_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let scsi_cmd_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): counter bump. Labels prefixed scmd_nt_.",
      block: {
        cmp rdi, 8;
        jae scmd_nt_out;
        lea r10, [rip + _scsi_cmd_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      scmd_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Big-endian store helpers (byte-oriented, no register width surprises).
  // ==========================================================================

  pub let scsi_cmd_st_be16 : (u64, u64) -> () !{mem} @{} =
    fn (dst: u64) (val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): big-endian u16 store. Labels prefixed scmd_be16_.",
      block: {
        mov rax, rsi;
        shr rax, 8;
        and rax, 0xFF;
        mov [rdi + 0], al;
        mov rax, rsi;
        and rax, 0xFF;
        mov [rdi + 1], al;
        ret
      }
    }

  pub let scsi_cmd_st_be32 : (u64, u64) -> () !{mem} @{} =
    fn (dst: u64) (val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): big-endian u32 store. Labels prefixed scmd_be32_.",
      block: {
        mov rax, rsi;
        shr rax, 24;
        and rax, 0xFF;
        mov [rdi + 0], al;
        mov rax, rsi;
        shr rax, 16;
        and rax, 0xFF;
        mov [rdi + 1], al;
        mov rax, rsi;
        shr rax, 8;
        and rax, 0xFF;
        mov [rdi + 2], al;
        mov rax, rsi;
        and rax, 0xFF;
        mov [rdi + 3], al;
        ret
      }
    }

  // ==========================================================================
  // READ(10): opcode 0x28, 10 bytes.
  //   [+0]  0x28
  //   [+1]  flags (0)
  //   [+2..+5] LBA (u32 big-endian)
  //   [+6]  group_number (0)
  //   [+7..+8]  transfer length in blocks (u16 big-endian)
  //   [+9]  control (0)
  // ==========================================================================

  pub let scsi_cmd_read10 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (lba: u64) (blocks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): build a READ(10) CDB. Refuses buf==0, len<10, lba>u32, blocks==0 or blocks>u16. Labels prefixed scmd_r10_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        cmp r12, 0;
        je  scmd_r10_bad_buf;
        cmp r13, 10;
        jb  scmd_r10_bad_len;

        mov r10, 0xFFFFFFFF;
        cmp r14, r10;
        ja  scmd_r10_bad_lba;

        cmp r15, 0;
        je  scmd_r10_bad_xfer;
        cmp r15, 0xFFFF;
        ja  scmd_r10_bad_xfer;

        mov rax, 0x28;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;
        mov rdi, r12;
        add rdi, 2;
        mov rsi, r14;
        call scsi_cmd_st_be32;
        xor rax, rax;
        mov [r12 + 6], al;
        mov rdi, r12;
        add rdi, 7;
        mov rsi, r15;
        call scsi_cmd_st_be16;
        xor rax, rax;
        mov [r12 + 9], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_r10_out;

      scmd_r10_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_r10_out;
      scmd_r10_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;
        jmp scmd_r10_out;
      scmd_r10_bad_lba:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3C;
        jmp scmd_r10_out;
      scmd_r10_bad_xfer:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3B;

      scmd_r10_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let scsi_cmd_write10 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (lba: u64) (blocks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): build a WRITE(10) CDB. Same shape as READ(10) but opcode 0x2A. Labels prefixed scmd_w10_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        cmp r12, 0;
        je  scmd_w10_bad_buf;
        cmp r13, 10;
        jb  scmd_w10_bad_len;

        mov r10, 0xFFFFFFFF;
        cmp r14, r10;
        ja  scmd_w10_bad_lba;

        cmp r15, 0;
        je  scmd_w10_bad_xfer;
        cmp r15, 0xFFFF;
        ja  scmd_w10_bad_xfer;

        mov rax, 0x2A;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;
        mov rdi, r12;
        add rdi, 2;
        mov rsi, r14;
        call scsi_cmd_st_be32;
        xor rax, rax;
        mov [r12 + 6], al;
        mov rdi, r12;
        add rdi, 7;
        mov rsi, r15;
        call scsi_cmd_st_be16;
        xor rax, rax;
        mov [r12 + 9], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_w10_out;

      scmd_w10_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_w10_out;
      scmd_w10_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;
        jmp scmd_w10_out;
      scmd_w10_bad_lba:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3C;
        jmp scmd_w10_out;
      scmd_w10_bad_xfer:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3B;

      scmd_w10_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // READ(16): opcode 0x88, 16 bytes.
  //   [+0]  0x88
  //   [+1]  flags (0)
  //   [+2..+9]   LBA (u64 big-endian) — laid out as be32 hi then be32 lo
  //   [+10..+13] transfer length (u32 big-endian)
  //   [+14] group_number (0)
  //   [+15] control (0)
  //
  // Split store: writes hi and lo as two big-endian u32s to avoid a
  // 64-bit BE primitive on paideia-as.
  // ==========================================================================

  pub let scsi_cmd_read16 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (lba: u64) (blocks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): build a READ(16) CDB. Refuses buf==0, len<16, blocks==0 or blocks>u32. Labels prefixed scmd_r16_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        cmp r12, 0;
        je  scmd_r16_bad_buf;
        cmp r13, 16;
        jb  scmd_r16_bad_len;

        cmp r15, 0;
        je  scmd_r16_bad_xfer;
        mov r10, 0xFFFFFFFF;
        cmp r15, r10;
        ja  scmd_r16_bad_xfer;

        mov rax, 0x88;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;

        // hi u32 of LBA at +2, lo u32 at +6.
        mov rdi, r12;
        add rdi, 2;
        mov rsi, r14;
        shr rsi, 32;
        and rsi, 0xFFFFFFFF;
        call scsi_cmd_st_be32;
        mov rdi, r12;
        add rdi, 6;
        mov rsi, r14;
        and rsi, 0xFFFFFFFF;
        call scsi_cmd_st_be32;

        mov rdi, r12;
        add rdi, 10;
        mov rsi, r15;
        call scsi_cmd_st_be32;

        xor rax, rax;
        mov [r12 + 14], al;
        mov [r12 + 15], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_r16_out;

      scmd_r16_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_r16_out;
      scmd_r16_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;
        jmp scmd_r16_out;
      scmd_r16_bad_xfer:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3B;

      scmd_r16_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let scsi_cmd_write16 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (lba: u64) (blocks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): build a WRITE(16) CDB. Same shape as READ(16) but opcode 0x8A. Labels prefixed scmd_w16_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        cmp r12, 0;
        je  scmd_w16_bad_buf;
        cmp r13, 16;
        jb  scmd_w16_bad_len;

        cmp r15, 0;
        je  scmd_w16_bad_xfer;
        mov r10, 0xFFFFFFFF;
        cmp r15, r10;
        ja  scmd_w16_bad_xfer;

        mov rax, 0x8A;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;

        mov rdi, r12;
        add rdi, 2;
        mov rsi, r14;
        shr rsi, 32;
        and rsi, 0xFFFFFFFF;
        call scsi_cmd_st_be32;
        mov rdi, r12;
        add rdi, 6;
        mov rsi, r14;
        and rsi, 0xFFFFFFFF;
        call scsi_cmd_st_be32;

        mov rdi, r12;
        add rdi, 10;
        mov rsi, r15;
        call scsi_cmd_st_be32;

        xor rax, rax;
        mov [r12 + 14], al;
        mov [r12 + 15], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_w16_out;

      scmd_w16_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_w16_out;
      scmd_w16_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;
        jmp scmd_w16_out;
      scmd_w16_bad_xfer:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3B;

      scmd_w16_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // INQUIRY: opcode 0x12, 6 bytes.
  //   [+0]  0x12
  //   [+1]  EVPD flag (0)
  //   [+2]  page code (0 when EVPD=0)
  //   [+3..+4]  allocation length u16 big-endian
  //   [+5]  control (0)
  // ==========================================================================

  pub let scsi_cmd_inquiry : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (alloc_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): build an INQUIRY CDB. Standard inquiry (EVPD=0). alloc_len <= 255 for standard data. Labels prefixed scmd_inq_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  scmd_inq_bad_buf;
        cmp r13, 6;
        jb  scmd_inq_bad_len;
        cmp r14, 0xFFFF;
        ja  scmd_inq_bad_alloc;

        mov rax, 0x12;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;
        mov [r12 + 2], al;
        mov rdi, r12;
        add rdi, 3;
        mov rsi, r14;
        call scsi_cmd_st_be16;
        xor rax, rax;
        mov [r12 + 5], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_inq_out;

      scmd_inq_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_inq_out;
      scmd_inq_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;
        jmp scmd_inq_out;
      scmd_inq_bad_alloc:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3A;

      scmd_inq_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // READ_CAPACITY(10): opcode 0x25, 10 bytes.
  //   [+0]  0x25
  //   [+1]  reserved (0)
  //   [+2..+5]  LBA (u32 big-endian) — 0 unless PMI set
  //   [+6..+8]  reserved (0)
  //   [+8]  PMI flag bit 0 (0 for our use)
  //   [+9]  control
  // ==========================================================================

  pub let scsi_cmd_read_capacity_10 : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): build a READ_CAPACITY(10) CDB. Labels prefixed scmd_rc10_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  scmd_rc10_bad_buf;
        cmp r13, 10;
        jb  scmd_rc10_bad_len;

        mov rax, 0x25;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;
        mov [r12 + 2], al;
        mov [r12 + 3], al;
        mov [r12 + 4], al;
        mov [r12 + 5], al;
        mov [r12 + 6], al;
        mov [r12 + 7], al;
        mov [r12 + 8], al;
        mov [r12 + 9], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_rc10_out;

      scmd_rc10_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_rc10_out;
      scmd_rc10_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;

      scmd_rc10_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // READ_CAPACITY(16): opcode 0x9E service action 0x10, 16 bytes.
  // ==========================================================================

  pub let scsi_cmd_read_capacity_16 : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): build a READ_CAPACITY(16) CDB with SERVICE ACTION 0x10 at [+1] (SBC-3 §5.15). Labels prefixed scmd_rc16_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  scmd_rc16_bad_buf;
        cmp r13, 16;
        jb  scmd_rc16_bad_len;

        mov rax, 0x9E;
        mov [r12 + 0], al;
        mov rax, 0x10;
        mov [r12 + 1], al;
        xor rax, rax;
        mov [r12 + 2], al;
        mov [r12 + 3], al;
        mov [r12 + 4], al;
        mov [r12 + 5], al;
        mov [r12 + 6], al;
        mov [r12 + 7], al;
        mov [r12 + 8], al;
        mov [r12 + 9], al;
        mov [r12 + 10], al;
        mov [r12 + 11], al;
        mov [r12 + 12], al;
        mov [r12 + 13], al;
        mov [r12 + 14], al;
        mov [r12 + 15], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_rc16_out;

      scmd_rc16_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_rc16_out;
      scmd_rc16_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;

      scmd_rc16_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // TEST_UNIT_READY: opcode 0x00, 6 bytes all zero after the opcode.
  // ==========================================================================

  pub let scsi_cmd_test_unit_ready : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): TEST_UNIT_READY CDB. Labels prefixed scmd_tur_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  scmd_tur_bad_buf;
        cmp r13, 6;
        jb  scmd_tur_bad_len;

        xor rax, rax;
        mov [r12 + 0], al;
        mov [r12 + 1], al;
        mov [r12 + 2], al;
        mov [r12 + 3], al;
        mov [r12 + 4], al;
        mov [r12 + 5], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_tur_out;

      scmd_tur_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_tur_out;
      scmd_tur_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;

      scmd_tur_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // REQUEST_SENSE: opcode 0x03, 6 bytes.
  //   [+0]  0x03
  //   [+1..+3]  reserved
  //   [+4]  allocation length (u8, <= 255)
  //   [+5]  control
  // ==========================================================================

  pub let scsi_cmd_request_sense : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) (alloc_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): REQUEST_SENSE CDB, alloc_len <= 255. Labels prefixed scmd_rs_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  scmd_rs_bad_buf;
        cmp r13, 6;
        jb  scmd_rs_bad_len;
        cmp r14, 255;
        ja  scmd_rs_bad_alloc;

        mov rax, 0x03;
        mov [r12 + 0], al;
        xor rax, rax;
        mov [r12 + 1], al;
        mov [r12 + 2], al;
        mov [r12 + 3], al;
        mov rax, r14;
        and rax, 0xFF;
        mov [r12 + 4], al;
        xor rax, rax;
        mov [r12 + 5], al;

        mov rdi, 0;
        call scsi_cmd_note;
        xor rax, rax;
        jmp scmd_rs_out;

      scmd_rs_bad_buf:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3F;
        jmp scmd_rs_out;
      scmd_rs_bad_len:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3E;
        jmp scmd_rs_out;
      scmd_rs_bad_alloc:
        mov rdi, 1;
        call scsi_cmd_note;
        mov rax, 0xFFFFFB3A;

      scmd_rs_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // scsi_cmd_opcode(buf, len) -> opcode | error
  //   Convenience: just returns the first byte.
  // ==========================================================================

  pub let scsi_cmd_opcode : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): opcode byte accessor. Labels prefixed scmd_op_.",
      block: {
        cmp rdi, 0;
        je  scmd_op_bad;
        cmp rsi, 1;
        jb  scmd_op_bad;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        ret;
      scmd_op_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }
}
