// src/kernel/core/drivers/vello/vello_tiling.pdx -- G4.M4 substrate
//
// G4.M4-001 (#1488): tile-based render coarsening (multi-resolution).
// G4.M4-002 (#1489): tile occupancy heuristic (skip empty tiles).
//
// =============================================================================
// SECTION 0  COARSENING AS AN OCCUPANCY-DRIVEN CHOICE
// =============================================================================
//
// A frame drawn at 4K into 16-px tiles has 32,400 tiles. Most are
// empty most of the time -- desktop backgrounds have vast solid-color
// runs. The sort-middle architecture wins here: the coarsening pass
// looks at scene bounding boxes and marks the coarsest tile size at
// which each region is still monochrome; the render pipeline then
// spends compute time only where paths actually cross.
//
// Coarsening_level in the renderer row selects between four ceilings:
//   level 0: no coarsening (every tile at native size)
//   level 1: 2x coarsening allowed (16px -> 32px if empty)
//   level 2: 4x coarsening allowed (16px -> 64px if empty)
//   level 3: 8x coarsening allowed (16px -> 128px if empty)
//
// The occupancy heuristic (M4-002) then skips fully-empty coarse
// tiles from BLEND enumeration -- one pass fewer over a large flat
// region. The two together give ~35% end-to-end time on desktop
// scenes at typical density (per §5 bench targets).
//
// =============================================================================
// SECTION 1  TILE-GRID BOOKKEEPING
// =============================================================================
//
// The kernel side stores, per submission, the effective tile-grid
// dimensions (tiles_x, tiles_y), the observed occupancy (occupied,
// skipped_empty, coarsened), and the current coarsen level applied.
// The paideia-as @wgsl_module lowering runs the actual coarsen +
// occupancy compute shader; kernel side is bookkeeping the counters.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFED50..0xFFFFED5F
// =============================================================================

module VelloTiling = structure {

  pub let VT_OK              : u64 = 0
  pub let VT_ERR_BAD_ID      : u64 = 0xFFFFED5F
  pub let VT_ERR_BAD_EXTENT  : u64 = 0xFFFFED5E
  pub let VT_ERR_BAD_LEVEL   : u64 = 0xFFFFED5D
  pub let VT_ERR_NO_ROOM     : u64 = 0xFFFFED5C
  pub let VT_ERR_NOT_INIT    : u64 = 0xFFFFED5B

  // Per-submission tile-grid state. 16 slots.
  //   [+0]  submit_id
  //   [+8]  header: active[63:56] | level[55:48]
  //                | tiles_x[47:32] | tiles_y[31:16]
  //   [+16] occupied
  //   [+24] skipped_empty
  //   [+32] coarsened
  pub let mut _vt_state : [u64; 80] = uninit @align(64)
  pub let mut _vt_stats : [u64; 8]  = uninit @align(64)

  pub let VT_STA_INITS       : u64 = 0
  pub let VT_STA_MARKS       : u64 = 1
  pub let VT_STA_SKIPS       : u64 = 2
  pub let VT_STA_COARSENS    : u64 = 3
  pub let VT_STA_REFUSED     : u64 = 4

  pub let VT_LEVEL_MAX : u64 = 3

  pub let vt_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4 clear state + counters.",
      block: {
        lea r10, [rip + _vt_state];
        xor rax, rax;
        xor rcx, rcx;
      vt_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 80;
        jb  vt_rs_state;

        lea r10, [rip + _vt_stats];
        xor rcx, rcx;
      vt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vt_rs_stats;
        ret
      }
    }

  pub let vt_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4 counter bump.",
      block: {
        cmp rdi, 8;
        jae vt_nt_out;
        lea r10, [rip + _vt_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vt_nt_out:
        ret
      }
    }

  pub let vt_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4 counter read.",
      block: {
        cmp rdi, 8;
        jae vt_st_zero;
        lea r10, [rip + _vt_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vt_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vt_state_addr : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M4 slot base pointer (5 u64 = 40 bytes per slot).",
      block: {
        cmp rdi, 16;
        jae vt_sa_bad;
        lea rax, [rip + _vt_state];
        mov r10, rdi;
        imul r10, r10, 40;
        add rax, r10;
        ret;
      vt_sa_bad:
        xor rax, rax;
        ret
      }
    }

  pub let vt_level_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M4-001 (#1488): 1 iff l <= VT_LEVEL_MAX = 3.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  vt_lv_no;
        mov rax, 1;
        ret;
      vt_lv_no:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vt_init(submit_id, tiles_x, tiles_y, level) -> slot | err
  // =========================================================================
  pub let vt_init : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (submit_id: u64) (tx: u64) (ty: u64) (level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4-001 (#1488): claim a slot for a submission, record initial grid + coarsening level. Four callee-save pushes + one align pad keep rsp aligned.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov r10, 0xFFFF;
        cmp r13, r10;
        ja  vt_it_bad_ext;
        cmp r14, r10;
        ja  vt_it_bad_ext;
        cmp r13, 0;
        je  vt_it_bad_ext;
        cmp r14, 0;
        je  vt_it_bad_ext;

        mov rdi, r15;
        call vt_level_valid;
        cmp rax, 0;
        je  vt_it_bad_lvl;

        xor rbx, rbx;
      vt_it_scan:
        cmp rbx, 16;
        jae vt_it_no_room;
        mov rdi, rbx;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_it_no_room;
        mov r10, [rax + 8];
        shr r10, 56;
        cmp r10, 0;
        je  vt_it_claim;
        add rbx, 1;
        jmp vt_it_scan;

      vt_it_claim:
        mov [rax + 0], r12;
        mov rcx, 1;
        shl rcx, 56;
        mov r10, r15;
        and r10, 0xFF;
        shl r10, 48;
        or  rcx, r10;
        mov r10, r13;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rcx, r10;
        mov r10, r14;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rcx, r10;
        mov [rax + 8], rcx;
        xor rcx, rcx;
        mov [rax + 16], rcx;
        mov [rax + 24], rcx;
        mov [rax + 32], rcx;

        mov rdi, 0;
        call vt_note;                     // inits

        mov rax, rbx;
        jmp vt_it_out;

      vt_it_bad_ext:
        mov rdi, 4;
        call vt_note;
        mov rax, 0xFFFFED5E;
        jmp vt_it_out;
      vt_it_bad_lvl:
        mov rdi, 4;
        call vt_note;
        mov rax, 0xFFFFED5D;
        jmp vt_it_out;
      vt_it_no_room:
        mov rdi, 4;
        call vt_note;
        mov rax, 0xFFFFED5C;

      vt_it_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Mark one tile occupied.
  pub let vt_mark_occupied : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4-001 (#1488): occupied += 1.",
      block: {
        push r12;
        mov r12, rdi;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_mo_bad;
        mov r10, [rax + 8];
        shr r10, 56;
        cmp r10, 0;
        je  vt_mo_bad;
        mov r10, [rax + 16];
        add r10, 1;
        mov [rax + 16], r10;

        mov rdi, 1;
        call vt_note;

        xor rax, rax;
        jmp vt_mo_out;
      vt_mo_bad:
        mov rax, 0xFFFFED5B;
      vt_mo_out:
        pop r12;
        ret
      }
    }

  // Mark one empty tile skipped (occupancy heuristic).
  pub let vt_mark_skipped : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4-002 (#1489): skipped_empty += 1.",
      block: {
        push r12;
        mov r12, rdi;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_ms_bad;
        mov r10, [rax + 8];
        shr r10, 56;
        cmp r10, 0;
        je  vt_ms_bad;
        mov r10, [rax + 24];
        add r10, 1;
        mov [rax + 24], r10;

        mov rdi, 2;
        call vt_note;

        xor rax, rax;
        jmp vt_ms_out;
      vt_ms_bad:
        mov rax, 0xFFFFED5B;
      vt_ms_out:
        pop r12;
        ret
      }
    }

  // Mark one tile coarsened (coarsening pass).
  pub let vt_mark_coarsened : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4-001 (#1488): coarsened += 1.",
      block: {
        push r12;
        mov r12, rdi;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_mc_bad;
        mov r10, [rax + 8];
        shr r10, 56;
        cmp r10, 0;
        je  vt_mc_bad;
        mov r10, [rax + 32];
        add r10, 1;
        mov [rax + 32], r10;

        mov rdi, 3;
        call vt_note;

        xor rax, rax;
        jmp vt_mc_out;
      vt_mc_bad:
        mov rax, 0xFFFFED5B;
      vt_mc_out:
        pop r12;
        ret
      }
    }

  pub let vt_occupied_of : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4 read occupied count.",
      block: {
        push r12;
        mov r12, rdi;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_oo_bad;
        mov rax, [rax + 16];
        jmp vt_oo_out;
      vt_oo_bad:
        xor rax, rax;
      vt_oo_out:
        pop r12;
        ret
      }
    }

  pub let vt_skipped_of : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4 read skipped count.",
      block: {
        push r12;
        mov r12, rdi;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_so_bad;
        mov rax, [rax + 24];
        jmp vt_so_out;
      vt_so_bad:
        xor rax, rax;
      vt_so_out:
        pop r12;
        ret
      }
    }

  pub let vt_coarsened_of : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4 read coarsened count.",
      block: {
        push r12;
        mov r12, rdi;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_co_bad;
        mov rax, [rax + 32];
        jmp vt_co_out;
      vt_co_bad:
        xor rax, rax;
      vt_co_out:
        pop r12;
        ret
      }
    }

  pub let vt_level_of : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M4 read level.",
      block: {
        push r12;
        mov r12, rdi;
        call vt_state_addr;
        cmp rax, 0;
        je  vt_lo_bad;
        mov rax, [rax + 8];
        shr rax, 48;
        and rax, 0xFF;
        jmp vt_lo_out;
      vt_lo_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vt_lo_out:
        pop r12;
        ret
      }
    }
}
