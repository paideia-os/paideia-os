// src/kernel/core/drivers/vello/vello_scene_encoder.pdx -- G4.M1-005 (#1479)
// + G4.M1-001 (#1475) kernel-side seams for the paideia-as scene
// encoder library.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the SEAM the vello_render_channel calls when a client
// invokes encode_scene. It owns the per-scene encoding-progress
// state (bytes remaining to upload, last-encoded path count) and
// delegates the actual scene byte-stream production to paideia-as's
// @wgsl_module machinery -- see design/roadmap/next-wave-synthesis.md
// §2 G4 for the paideia-as v0.30 gap.
//
// The encoder is DOUBLE-BUFFERED per scene: while a compute
// pipeline reads bytes N of the previous submission, the encoder
// writes bytes N+1 of the next. The two-buffer discipline is a
// hard invariant -- an encoder that writes into the buffer being
// read from is a "torn scene" bug people chase for weeks in hosted
// stacks. Here it is expressed as one row per scene with a slot-
// parity bit; a submit gates on the "OTHER side" being idle.
//
// It is NOT the paideia-as encoder itself (that library is a
// cross-repo gap; see design/roadmap/paideia-as-blockers.md for
// the v0.30 tracking bundle) and NOT the compute pipelines --
// those live in drivers/vello/vello_pipeline.pdx.
//
// =============================================================================
// SECTION 1  ENCODING BUDGET AND PATH IR
// =============================================================================
//
// The path IR is one of six opcodes packed into 4-bit tags in the
// scene byte stream: MOVE_TO, LINE_TO, QUAD_TO, CUBIC_TO, CLOSE,
// CLIP. The encoder's arithmetic tracks (a) how many opcodes have
// been produced, (b) how many bytes those opcodes consume, and
// (c) the running Bezier degree bound so the compute pipelines'
// per-tile stack size can be sized correctly.
//
// The kernel-side seam only tracks (a) and (b) -- the paideia-as
// library produces the byte stream. Kernel side is a bookkeeping
// row per scene.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFED90..0xFFFFED9F
// =============================================================================

module VelloSceneEncoder = structure {

  pub let VSE_OK               : u64 = 0
  pub let VSE_ERR_BAD_SCENE    : u64 = 0xFFFFED9F
  pub let VSE_ERR_BAD_BYTES    : u64 = 0xFFFFED9E
  pub let VSE_ERR_BAD_PATHS    : u64 = 0xFFFFED9D
  pub let VSE_ERR_BUSY         : u64 = 0xFFFFED9C   // other buffer still reading
  pub let VSE_ERR_NO_ROOM      : u64 = 0xFFFFED9B
  pub let VSE_ERR_NOT_STARTED  : u64 = 0xFFFFED9A
  pub let VSE_ERR_UPLOAD_FAIL  : u64 = 0xFFFFED99
  pub let VSE_ERR_BAD_OP       : u64 = 0xFFFFED98

  // Path IR opcodes (4-bit tag, low nibble of a byte).
  pub let VSE_OP_MOVE_TO  : u64 = 0
  pub let VSE_OP_LINE_TO  : u64 = 1
  pub let VSE_OP_QUAD_TO  : u64 = 2
  pub let VSE_OP_CUBIC_TO : u64 = 3
  pub let VSE_OP_CLOSE    : u64 = 4
  pub let VSE_OP_CLIP     : u64 = 5
  pub let VSE_OP_MAX      : u64 = 5

  // Per-scene encoding state. 16 slots (mirrors _vello_scene_table).
  // Each: {byte_cursor:u64, path_cursor:u64, degree_bound:u16,
  //        parity:u8, active:u8, reserved:u32}. Packed into 3 u64.
  //
  //   [+0]  byte_cursor
  //   [+8]  path_cursor
  //   [+16] header: active[63:56] | parity[55:48]
  //                | degree_bound[47:32] | reserved[31:0]
  pub let mut _vse_state : [u64; 48] = uninit @align(64)
  pub let mut _vse_stats : [u64; 8]  = uninit @align(64)

  pub let VSE_ST_ENCODES  : u64 = 0
  pub let VSE_ST_UPLOADS  : u64 = 1
  pub let VSE_ST_STARTS   : u64 = 2
  pub let VSE_ST_FINISHES : u64 = 3
  pub let VSE_ST_BUSIES   : u64 = 4
  pub let VSE_ST_REFUSED  : u64 = 5

  pub let vse_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479): clear encoder state + counters.",
      block: {
        lea r10, [rip + _vse_state];
        xor rax, rax;
        xor rcx, rcx;
      vse_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  vse_rs_state;

        lea r10, [rip + _vse_stats];
        xor rcx, rcx;
      vse_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vse_rs_stats;
        ret
      }
    }

  pub let vse_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479) counter bump.",
      block: {
        cmp rdi, 8;
        jae vse_nt_out;
        lea r10, [rip + _vse_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vse_nt_out:
        ret
      }
    }

  pub let vse_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479) counter read.",
      block: {
        cmp rdi, 8;
        jae vse_st_zero;
        lea r10, [rip + _vse_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vse_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vse_state_addr : (u64) -> u64 !{} @{} =
    fn (scene_row: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-005 (#1479): base pointer of state slot for scene row (3 u64 = 24 bytes per slot). Returns 0 for bad row.",
      block: {
        cmp rdi, 16;
        jae vse_sa_bad;
        lea rax, [rip + _vse_state];
        mov r10, rdi;
        imul r10, r10, 24;
        add rax, r10;
        ret;
      vse_sa_bad:
        xor rax, rax;
        ret
      }
    }

  pub let vse_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M1-005 (#1479): 1 iff op <= VSE_OP_MAX = 5.",
      block: {
        mov r10, 5;
        cmp rdi, r10;
        ja  vse_ov_no;
        mov rax, 1;
        ret;
      vse_ov_no:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vse_encode(scene_row, encoded_bytes, paths, samps, flags)
  //     -> ok | err
  //
  // Bookkeeping for one encode_scene RPC. Verifies the scene row is
  // live, checks the OTHER-side buffer is idle, then records the
  // encoding intent + updates the scene's flags. The actual byte
  // stream is produced by paideia-as (v0.30 gap #1475 -- @wgsl_
  // module) and uploaded by vse_upload.
  // =========================================================================
  pub let vse_encode : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (scene_row: u64) (encoded_bytes: u64) (paths: u64) (samps: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479): record encoding progress on the per-scene state slot. Refuses BUSY if other-side parity is still active. Five callee-save pushes (odd) keep rsp aligned across calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, r8;                      // flags

        mov rdi, r12;
        call vse_state_addr;
        cmp rax, 0;
        je  vse_en_bad_scene;
        mov rbx, rax;

        mov rax, [rbx + 16];
        shr rax, 56;
        cmp rax, 0;
        jne vse_en_busy;

        // Record cursors + activate.
        mov [rbx + 0], r13;               // byte_cursor
        mov [rbx + 8], r14;               // path_cursor
        mov rax, 1;
        shl rax, 56;
        mov [rbx + 16], rax;

        // Update flags on the scene row.
        mov rdi, r12;
        mov rsi, r15;
        call vs_row_set_flags;
        cmp rax, 0;
        jne vse_en_bad_scene;

        mov rdi, 2;
        call vse_note;                    // starts
        mov rdi, 0;
        call vse_note;                    // encodes

        xor rax, rax;
        jmp vse_en_out;

      vse_en_bad_scene:
        mov rdi, 5;
        call vse_note;
        mov rax, 0xFFFFED9F;
        jmp vse_en_out;
      vse_en_busy:
        mov rdi, 4;
        call vse_note;
        mov rax, 0xFFFFED9C;

      vse_en_out:
        pop r15;
        pop r14;
        pop r13;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vse_upload(scene_row) -> ok | err
  //
  // Signals the scene bytes are ready in the parent BO. Kernel-side
  // is a state-only transition (parity flip); the actual DMA into
  // the BO is done by paideia-as's @wgsl_module lowering when the
  // library exists.
  // =========================================================================
  pub let vse_upload : (u64) -> u64 !{mem} @{} =
    fn (scene_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479): flip parity, mark upload complete. Three pushes (odd) keep rsp aligned.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov rdi, r12;
        call vse_state_addr;
        cmp rax, 0;
        je  vse_up_bad;
        mov rbx, rax;

        mov rax, [rbx + 16];
        shr rax, 56;
        cmp rax, 0;
        je  vse_up_not_started;

        // Flip parity bit and clear active. header: active[63:56]
        // becomes 0; parity[55:48] toggled.
        mov rax, [rbx + 16];
        mov rcx, rax;
        shr rcx, 48;
        and rcx, 0xFF;                    // parity
        xor rcx, 1;
        and rcx, 0xFF;
        // Rebuild header: parity[55:48], zero active.
        mov r10, 0xFF;
        shl r10, 48;
        not r10;
        and rax, r10;
        mov r10, 0xFF;
        shl r10, 56;
        not r10;
        and rax, r10;
        mov r10, rcx;
        shl r10, 48;
        or  rax, r10;
        mov [rbx + 16], rax;

        mov rdi, 1;
        call vse_note;                    // uploads
        mov rdi, 3;
        call vse_note;                    // finishes

        xor rax, rax;
        jmp vse_up_out;

      vse_up_bad:
        mov rdi, 5;
        call vse_note;
        mov rax, 0xFFFFED9F;
        jmp vse_up_out;
      vse_up_not_started:
        mov rdi, 5;
        call vse_note;
        mov rax, 0xFFFFED9A;

      vse_up_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vse_active(scene_row) -> 0 | 1 | 0xF..F on bad
  // =========================================================================
  pub let vse_active : (u64) -> u64 !{mem} @{} =
    fn (scene_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479): read active bit.",
      block: {
        push r12;
        mov r12, rdi;
        call vse_state_addr;
        cmp rax, 0;
        je  vse_ac_bad;
        mov r10, [rax + 16];
        shr r10, 56;
        and r10, 0xFF;
        mov rax, r10;
        jmp vse_ac_out;
      vse_ac_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vse_ac_out:
        pop r12;
        ret
      }
    }

  pub let vse_parity : (u64) -> u64 !{mem} @{} =
    fn (scene_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479): read parity bit.",
      block: {
        push r12;
        mov r12, rdi;
        call vse_state_addr;
        cmp rax, 0;
        je  vse_pa_bad;
        mov r10, [rax + 16];
        shr r10, 48;
        and r10, 0xFF;
        mov rax, r10;
        jmp vse_pa_out;
      vse_pa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vse_pa_out:
        pop r12;
        ret
      }
    }

  pub let vse_bytes_written : (u64) -> u64 !{mem} @{} =
    fn (scene_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M1-005 (#1479): current byte_cursor.",
      block: {
        push r12;
        mov r12, rdi;
        call vse_state_addr;
        cmp rax, 0;
        je  vse_bw_bad;
        mov rax, [rax + 0];
        jmp vse_bw_out;
      vse_bw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      vse_bw_out:
        pop r12;
        ret
      }
    }
}
