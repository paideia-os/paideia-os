// src/kernel/core/drivers/vello/vello_effects.pdx -- G4.M3 substrate
//
// G4.M3-001 (#1485): gradient compute pass (linear / radial / conic).
// G4.M3-002 (#1486): Gaussian blur / feathering compute pass.
// G4.M3-003 (#1487): path-effect stack (dash, arrow, marker).
//
// =============================================================================
// SECTION 0  EFFECTS AS OPTIONAL CHAINED PASSES
// =============================================================================
//
// The base stroke+fill+blend cycle handles the essential 2D drawing
// grammar. Effects (gradients, blurs, arrowheads) are OPTIONAL
// compute passes chained on top of a submission. Each effect pass
// consumes the intermediate buffer produced by the previous stage
// and writes an updated version -- the composition is left-to-right.
//
// The kernel side records which effects are enabled per submission
// via a bitmask (VE_FX_* below), the parameters (gradient stops,
// blur sigma, dash pattern), and a pass ordinal for observability.
//
// =============================================================================
// SECTION 1  BLUR IS SEPARABLE
// =============================================================================
//
// Gaussian blur is implemented as two 1-D passes (horizontal then
// vertical) because a separable convolution is O(N) per axis where
// the naive 2-D kernel is O(N^2). The sigma parameter is validated
// to a positive integer (kernel radius = 3*sigma + 1 conservatively);
// the driver's role is to pick the CPU or GPU kernel and record the
// two-pass count.
//
// =============================================================================
// SECTION 2  DASH PATTERN AS RUN-LENGTH
// =============================================================================
//
// Dash patterns are stored as a small run-length: up to VE_DASH_MAX
// = 8 alternating on/off segments (u16 each). Arrow and marker
// primitives are expressed as a discrete opcode plus an angle field;
// the compute pass rotates the marker glyph to match.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFED60..0xFFFFED6F
// =============================================================================

module VelloEffects = structure {

  pub let VE_OK              : u64 = 0
  pub let VE_ERR_BAD_ID      : u64 = 0xFFFFED6F
  pub let VE_ERR_BAD_KIND    : u64 = 0xFFFFED6E
  pub let VE_ERR_BAD_PARAM   : u64 = 0xFFFFED6D
  pub let VE_ERR_NO_ROOM     : u64 = 0xFFFFED6C
  pub let VE_ERR_BAD_SIGMA   : u64 = 0xFFFFED6B
  pub let VE_ERR_BAD_STOPS   : u64 = 0xFFFFED6A
  pub let VE_ERR_BAD_DASH    : u64 = 0xFFFFED69

  // Effect kinds.
  pub let VE_KIND_GRAD_LINEAR : u64 = 0
  pub let VE_KIND_GRAD_RADIAL : u64 = 1
  pub let VE_KIND_GRAD_CONIC  : u64 = 2
  pub let VE_KIND_BLUR        : u64 = 3
  pub let VE_KIND_DASH        : u64 = 4
  pub let VE_KIND_ARROW       : u64 = 5
  pub let VE_KIND_MARKER      : u64 = 6
  pub let VE_KIND_MAX         : u64 = 6

  // Effect-mask flags on a submission.
  pub let VE_FX_GRADIENT : u64 = 0x01
  pub let VE_FX_BLUR     : u64 = 0x02
  pub let VE_FX_DASH     : u64 = 0x04
  pub let VE_FX_ARROW    : u64 = 0x08
  pub let VE_FX_MARKER   : u64 = 0x10
  pub let VE_FX_ALL      : u64 = 0x1F

  // Bounds.
  pub let VE_DASH_MAX     : u64 = 8
  pub let VE_STOPS_MAX    : u64 = 16
  pub let VE_SIGMA_MAX    : u64 = 128

  // Per-effect record ring: 32 slots, each 5 u64 (40 bytes).
  //   [+0]  submit_id (u64)         -- which submission this effect targets
  //   [+8]  header: active[63:56] | kind[47:40] | pass_ord[39:32]
  //   [+16] p1 (u64)                -- kind-specific (start/center/sigma/etc.)
  //   [+24] p2 (u64)                -- kind-specific (end/radius/dash_pat/etc.)
  //   [+32] p3 (u64)                -- kind-specific (angle/stops_ptr/etc.)
  pub let mut _ve_ring  : [u64; 160] = uninit @align(64)
  pub let mut _ve_stats : [u64; 8]   = uninit @align(64)

  pub let VE_STA_ENQUEUES : u64 = 0
  pub let VE_STA_GRADIENTS: u64 = 1
  pub let VE_STA_BLURS    : u64 = 2
  pub let VE_STA_DASHES   : u64 = 3
  pub let VE_STA_ARROWS   : u64 = 4
  pub let VE_STA_MARKERS  : u64 = 5
  pub let VE_STA_REFUSED  : u64 = 6

  pub let ve_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M3-* (#1485-1487): clear ring + counters.",
      block: {
        lea r10, [rip + _ve_ring];
        xor rax, rax;
        xor rcx, rcx;
      ve_rs_ring:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 160;
        jb  ve_rs_ring;

        lea r10, [rip + _ve_stats];
        xor rcx, rcx;
      ve_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ve_rs_stats;
        ret
      }
    }

  pub let ve_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M3 counter bump.",
      block: {
        cmp rdi, 8;
        jae ve_nt_out;
        lea r10, [rip + _ve_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ve_nt_out:
        ret
      }
    }

  pub let ve_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M3 counter read.",
      block: {
        cmp rdi, 8;
        jae ve_st_zero;
        lea r10, [rip + _ve_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ve_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ve_kind_valid : (u64) -> u64 !{} @{} =
    fn (k: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M3 kind bounds.",
      block: {
        mov r10, 6;
        cmp rdi, r10;
        ja  ve_kv_no;
        mov rax, 1;
        ret;
      ve_kv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ve_sigma_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M3-002 (#1486): 1 iff 0 < s <= VE_SIGMA_MAX = 128.",
      block: {
        cmp rdi, 0;
        je  ve_sv_no;
        mov r10, 128;
        cmp rdi, r10;
        ja  ve_sv_no;
        mov rax, 1;
        ret;
      ve_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ve_stops_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M3-001 (#1485): 1 iff 2 <= n <= VE_STOPS_MAX = 16.",
      block: {
        cmp rdi, 2;
        jb  ve_stv_no;
        mov r10, 16;
        cmp rdi, r10;
        ja  ve_stv_no;
        mov rax, 1;
        ret;
      ve_stv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ve_dash_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M3-003 (#1487): 1 iff 2 <= n <= VE_DASH_MAX = 8 and n is even (dashes are on/off pairs).",
      block: {
        cmp rdi, 2;
        jb  ve_dv_no;
        mov r10, 8;
        cmp rdi, r10;
        ja  ve_dv_no;
        mov r10, rdi;
        and r10, 1;
        cmp r10, 0;
        jne ve_dv_no;
        mov rax, 1;
        ret;
      ve_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ve_row_addr : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M3 row base pointer.",
      block: {
        cmp rdi, 32;
        jae ve_ra_bad;
        lea rax, [rip + _ve_ring];
        mov r10, rdi;
        imul r10, r10, 40;
        add rax, r10;
        ret;
      ve_ra_bad:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // ve_enqueue(submit_id, kind, p1, p2, p3) -> row_id | err
  // =========================================================================
  pub let ve_enqueue : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (submit_id: u64) (kind: u64) (p1: u64) (p2: u64) (p3: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M3 enqueue an effect record; validate kind + kind-specific params. Five pushes (odd) keep rsp aligned.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;
        mov rbx, r8;

        mov rdi, r13;
        call ve_kind_valid;
        cmp rax, 0;
        je  ve_eq_bad_kind;

        // Kind-specific param validation.
        cmp r13, 3;                       // BLUR
        jne ve_eq_check_grad;
        mov rdi, r14;                     // p1 = sigma
        call ve_sigma_valid;
        cmp rax, 0;
        je  ve_eq_bad_param;
        jmp ve_eq_claim;
      ve_eq_check_grad:
        cmp r13, 2;                       // GRADIENT (0..2)
        ja  ve_eq_check_dash;
        // p1 = stops count; validate.
        mov rdi, r14;
        call ve_stops_valid;
        cmp rax, 0;
        je  ve_eq_bad_stops;
        jmp ve_eq_claim;
      ve_eq_check_dash:
        cmp r13, 4;                       // DASH
        jne ve_eq_claim;
        mov rdi, r14;                     // p1 = dash count
        call ve_dash_valid;
        cmp rax, 0;
        je  ve_eq_bad_dash;

      ve_eq_claim:
        // Loop counter in rcx (caller-saved but we do not call inside
        // this loop -- address arithmetic is inline to keep alignment
        // clean).  rax holds the row-base address on exit.
        xor rcx, rcx;
      ve_eq_scan:
        cmp rcx, 32;
        jae ve_eq_no_room;
        lea r10, [rip + _ve_ring];
        mov r11, rcx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, r10;
        mov r10, [rax + 8];
        shr r10, 56;
        cmp r10, 0;
        je  ve_eq_write;
        add rcx, 1;
        jmp ve_eq_scan;

      ve_eq_write:
        mov [rax + 0], r12;
        mov r10, 1;
        shl r10, 56;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 40;
        or  r10, r11;
        mov [rax + 8], r10;
        mov [rax + 16], r14;
        mov [rax + 24], r15;
        mov [rax + 32], rbx;

        // rbx is free after the row body writes; hijack it to hold
        // the row_id across the ve_note calls (rcx is caller-saved).
        mov rbx, rcx;

        // Per-kind counter bump.
        cmp r13, 2;
        ja  ve_eq_check_blur;
        mov rdi, 1;
        call ve_note;                     // gradients
        jmp ve_eq_notify_done;
      ve_eq_check_blur:
        cmp r13, 3;
        jne ve_eq_check_dashk;
        mov rdi, 2;
        call ve_note;                     // blurs
        jmp ve_eq_notify_done;
      ve_eq_check_dashk:
        cmp r13, 4;
        jne ve_eq_check_arrow;
        mov rdi, 3;
        call ve_note;                     // dashes
        jmp ve_eq_notify_done;
      ve_eq_check_arrow:
        cmp r13, 5;
        jne ve_eq_marker;
        mov rdi, 4;
        call ve_note;                     // arrows
        jmp ve_eq_notify_done;
      ve_eq_marker:
        mov rdi, 5;
        call ve_note;                     // markers
      ve_eq_notify_done:
        mov rdi, 0;
        call ve_note;                     // enqueues

        mov rax, rbx;
        jmp ve_eq_out;

      ve_eq_bad_kind:
        mov rdi, 6;
        call ve_note;
        mov rax, 0xFFFFED6E;
        jmp ve_eq_out;
      ve_eq_bad_param:
        mov rdi, 6;
        call ve_note;
        mov rax, 0xFFFFED6B;
        jmp ve_eq_out;
      ve_eq_bad_stops:
        mov rdi, 6;
        call ve_note;
        mov rax, 0xFFFFED6A;
        jmp ve_eq_out;
      ve_eq_bad_dash:
        mov rdi, 6;
        call ve_note;
        mov rax, 0xFFFFED69;
        jmp ve_eq_out;
      ve_eq_no_room:
        mov rdi, 6;
        call ve_note;
        mov rax, 0xFFFFED6C;

      ve_eq_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Count active effect records for a given submit_id.
  pub let ve_count_for : (u64) -> u64 !{mem} @{} =
    fn (submit_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M3 count enqueued effects for one submission.",
      block: {
        xor rcx, rcx;                     // count
        xor r9, r9;                       // index
      ve_cf_scan:
        cmp r9, 32;
        jae ve_cf_out;
        lea r10, [rip + _ve_ring];
        mov r11, r9;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 8];
        shr rax, 56;
        cmp rax, 0;
        je  ve_cf_next;
        mov rax, [r10 + 0];
        cmp rax, rdi;
        jne ve_cf_next;
        add rcx, 1;
      ve_cf_next:
        add r9, 1;
        jmp ve_cf_scan;
      ve_cf_out:
        mov rax, rcx;
        ret
      }
    }

  pub let ve_kind_of : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M3 read kind field on a row.",
      block: {
        cmp rdi, 32;
        jae ve_ko_bad;
        lea r10, [rip + _ve_ring];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 8];
        shr rax, 56;
        cmp rax, 0;
        je  ve_ko_bad;
        mov rax, [r10 + 8];
        shr rax, 40;
        and rax, 0xFF;
        ret;
      ve_ko_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let ve_p1_of : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M3 read p1 field on a row.",
      block: {
        cmp rdi, 32;
        jae ve_p1_bad;
        lea r10, [rip + _ve_ring];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 16];
        ret;
      ve_p1_bad:
        xor rax, rax;
        ret
      }
    }
}
