// src/kernel/core/drivers/vello/vello_cpu_fallback.pdx -- G4.M2-004
// + G4.M2-005 (#1483, #1484)
//
// =============================================================================
// SECTION 0  WHY A CPU RASTERIZER LIVES IN THE KERNEL TREE
// =============================================================================
//
// The §7 R3 mitigation of design/roadmap/next-wave-synthesis.md
// requires that Vello have a CPU rasterizer path taking the SAME
// scene bytes as the GPU pipeline -- the paideia analogue of
// llvmpipe. Rationale:
//
//   * A T14 without a working Iris Xe or with a broken WGSL toolchain
//     must still render its compositor (headless is not an option
//     for GUI first-boot).
//   * The equivalence test (M2-005) demands bit-exact output for a
//     chosen op subset so any regression that only surfaces on the
//     GPU pipeline gets caught by a CPU-side reference.
//
// The kernel-side fallback is not a full rasterizer -- it is the
// bookkeeping + hash primitive the equivalence gate needs. The
// paideia-as v0.30 @wgsl_module lowering ships the actual scalar
// rasterizer as a companion library.
//
// =============================================================================
// SECTION 1  EQUIVALENCE HASH
// =============================================================================
//
// The gate compares CPU and GPU output by a canonical hash over the
// tile-block covered pixels: FNV-1a over (tile_x, tile_y, cover_lo,
// cover_hi, color_rgba) tuples emitted per painted tile. A match on
// the hash implies bit-exact output; a mismatch prints the offending
// tile ordinal and colour and halts the render.
//
// The scene chooses whether to opt into equivalence by setting the
// VS_FL_TILED_COARSE flag; opting in trades ~15% end-to-end latency
// (per bench) for a byte-for-byte cross-check on every frame.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFED70..0xFFFFED7F
// =============================================================================

module VelloCpuFallback = structure {

  pub let VCF_OK               : u64 = 0
  pub let VCF_ERR_BAD_SCENE    : u64 = 0xFFFFED7F
  pub let VCF_ERR_HASH_MISMATCH: u64 = 0xFFFFED7E
  pub let VCF_ERR_NO_ROOM      : u64 = 0xFFFFED7D
  pub let VCF_ERR_NOT_RUN      : u64 = 0xFFFFED7C
  pub let VCF_ERR_BAD_ID       : u64 = 0xFFFFED7B

  // Per-submission fallback state. 16 slots.
  //   [+0]  submit_id
  //   [+8]  cpu_hash (FNV-1a 64-bit)
  //   [+16] header: active[63:56] | tiles_hashed[47:32]
  pub let mut _vcf_state : [u64; 48] = uninit @align(64)
  pub let mut _vcf_stats : [u64; 8]  = uninit @align(64)

  pub let VCF_ST_RUNS         : u64 = 0
  pub let VCF_ST_HASH_MATCHES : u64 = 1
  pub let VCF_ST_HASH_MISMATCH: u64 = 2
  pub let VCF_ST_REFUSED      : u64 = 3

  // FNV-1a constants for the tile-hash rolling accumulator.
  pub let VCF_FNV_OFFSET : u64 = 0xCBF29CE484222325
  pub let VCF_FNV_PRIME  : u64 = 0x00000100000001B3

  pub let vcf_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-004 (#1483): clear fallback state + counters.",
      block: {
        lea r10, [rip + _vcf_state];
        xor rax, rax;
        xor rcx, rcx;
      vcf_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  vcf_rs_state;

        lea r10, [rip + _vcf_stats];
        xor rcx, rcx;
      vcf_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vcf_rs_stats;
        ret
      }
    }

  pub let vcf_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-004 counter bump.",
      block: {
        cmp rdi, 8;
        jae vcf_nt_out;
        lea r10, [rip + _vcf_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vcf_nt_out:
        ret
      }
    }

  pub let vcf_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-004 counter read.",
      block: {
        cmp rdi, 8;
        jae vcf_st_zero;
        lea r10, [rip + _vcf_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vcf_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vcf_state_addr : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M2-004 (#1483): base pointer of state slot for index (3 u64 per slot).",
      block: {
        cmp rdi, 16;
        jae vcf_sa_bad;
        lea rax, [rip + _vcf_state];
        mov r10, rdi;
        imul r10, r10, 24;
        add rax, r10;
        ret;
      vcf_sa_bad:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vcf_mix(acc, byte) -> new_acc
  //
  // FNV-1a rolling mixer. Kept as its own primitive so both the
  // per-tile ingestion and the boot-witness canned corpus use the
  // same code path.
  // =========================================================================
  pub let vcf_mix : (u64, u64) -> u64 !{} @{} =
    fn (acc: u64) (byte: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G4.M2-004 (#1483): FNV-1a step. XOR byte then multiply by FNV_PRIME.",
      block: {
        mov rax, rdi;
        mov r10, rsi;
        and r10, 0xFF;
        xor rax, r10;
        mov r10, 0x00000100000001B3;
        imul rax, r10;
        ret
      }
    }

  // Claim a state slot for a submission.
  pub let vcf_start : (u64) -> u64 !{mem} @{} =
    fn (submit_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-004 (#1483): allocate a fallback slot, seed FNV offset.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        xor rbx, rbx;
      vcf_ss_scan:
        cmp rbx, 16;
        jae vcf_ss_no_room;
        mov rdi, rbx;
        call vcf_state_addr;
        cmp rax, 0;
        je  vcf_ss_no_room;
        mov r13, rax;
        mov rax, [r13 + 16];
        shr rax, 56;
        cmp rax, 0;
        je  vcf_ss_claim;
        add rbx, 1;
        jmp vcf_ss_scan;

      vcf_ss_claim:
        mov [r13 + 0], r12;
        mov r10, 0xCBF29CE484222325;
        mov [r13 + 8], r10;
        mov rax, 1;
        shl rax, 56;
        mov [r13 + 16], rax;

        mov rdi, 0;
        call vcf_note;                    // runs

        mov rax, rbx;
        jmp vcf_ss_out;

      vcf_ss_no_room:
        mov rdi, 3;
        call vcf_note;
        mov rax, 0xFFFFED7D;

      vcf_ss_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Ingest one tile record: (tile_x, tile_y, cover_lo, cover_hi, rgba)
  // packed as five u64 args -- we hash the low byte of each in
  // sequence to model the canonical byte order.
  pub let vcf_ingest : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (tx: u64) (ty: u64) (cover_lo: u64) (cover_hi: u64) (rgba: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-004 (#1483): fold 5-tuple into rolling FNV. Seven pushes (six callee-save + one align pad) keep rsp % 16 == 0 across vcf_mix + arith: entry 8, +7*8=56, 8+56 mod 16 = 0.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        push rax;                        // align pad (odd push count)

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;
        mov rbx, r8;
        mov rbp, r9;

        mov rdi, r12;
        call vcf_state_addr;
        cmp rax, 0;
        je  vcf_in_bad;
        mov r12, rax;

        mov rax, [r12 + 16];
        shr rax, 56;
        cmp rax, 0;
        je  vcf_in_bad;

        mov rax, [r12 + 8];
        mov rdi, rax;
        mov rsi, r13;
        call vcf_mix;
        mov rdi, rax;
        mov rsi, r14;
        call vcf_mix;
        mov rdi, rax;
        mov rsi, r15;
        call vcf_mix;
        mov rdi, rax;
        mov rsi, rbx;
        call vcf_mix;
        mov rdi, rax;
        mov rsi, rbp;
        call vcf_mix;
        mov [r12 + 8], rax;

        // Bump tiles_hashed[47:32].
        mov rax, [r12 + 16];
        mov rcx, rax;
        shr rcx, 32;
        and rcx, 0xFFFF;
        add rcx, 1;
        mov r10, 0xFFFF;
        shl r10, 32;
        not r10;
        and rax, r10;
        and rcx, 0xFFFF;
        shl rcx, 32;
        or  rax, rcx;
        mov [r12 + 16], rax;

        xor rax, rax;
        jmp vcf_in_out;

      vcf_in_bad:
        mov rdi, 3;
        call vcf_note;
        mov rax, 0xFFFFED7F;

      vcf_in_out:
        pop rcx;                         // discard align pad
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let vcf_hash_of : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-004 (#1483): read cpu_hash.",
      block: {
        push r12;
        mov r12, rdi;
        call vcf_state_addr;
        cmp rax, 0;
        je  vcf_ho_bad;
        mov rax, [rax + 8];
        jmp vcf_ho_out;
      vcf_ho_bad:
        mov rax, 0;
      vcf_ho_out:
        pop r12;
        ret
      }
    }

  pub let vcf_tiles_of : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-004 (#1483): read tiles_hashed.",
      block: {
        push r12;
        mov r12, rdi;
        call vcf_state_addr;
        cmp rax, 0;
        je  vcf_to_bad;
        mov rax, [rax + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp vcf_to_out;
      vcf_to_bad:
        xor rax, rax;
      vcf_to_out:
        pop r12;
        ret
      }
    }

  // =========================================================================
  // vcf_verify(slot, gpu_hash) -> ok | HASH_MISMATCH
  //
  // G4.M2-005 (#1484): compare the accumulated CPU hash against the
  // caller-supplied gpu_hash. The regression gate reports mismatch
  // via VCF_STA_HASH_MISMATCH so operators see the discrepancy in
  // dmesg without halting the compositor.
  // =========================================================================
  pub let vcf_verify : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (gpu_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G4.M2-005 (#1484): cross-check hashes. Bumps HASH_MATCHES on OK, HASH_MISMATCH otherwise. Three pushes keep rsp aligned.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call vcf_hash_of;
        cmp rax, r13;
        jne vcf_vf_bad;

        mov rdi, 1;
        call vcf_note;                    // hash matches
        xor rax, rax;
        jmp vcf_vf_out;

      vcf_vf_bad:
        mov rdi, 2;
        call vcf_note;                    // hash mismatches
        mov rax, 0xFFFFED7E;

      vcf_vf_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
