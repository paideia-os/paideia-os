// src/kernel/core/drivers/wifi/net80211_mlme.pdx — R38.M4-003 (#1306)
//
// 802.11 MLME (MAC LAYER MANAGEMENT ENTITY) + PMF (Protected
// Management Frames, 802.11w) state for the net80211 class driver.
//
// Two independent pieces live here:
//
//   (1) PMF mode -- DISABLED / CAPABLE / REQUIRED.  Governs whether
//       an unprotected mgmt frame is accepted or refused.
//
//   (2) SA Query transaction -- the ceremony 802.11w defines for a
//       station to prove liveness to an AP that has received a
//       plausible-but-unauthenticated Deauth/Disassoc.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the POLICY half of PMF.  A live path composes: the mgmt
// frame goes through R38.M4-001's encode, this module decides
// whether it may be admitted, and R38.M6+ (SAE keys) provides the
// BIP/IGTK that would compute the MIC.  Here the MIC is a byte the
// caller passes in (`is_protected`); a REQUIRED-PMF station rejects
// any (state-changing) mgmt frame whose is_protected == 0.
//
// IT DOES NOT COMPUTE OR VERIFY A MIC.  R32 (crypto) + R38.M6 own
// the CMAC/BIP primitive; this module's refuse-gate is "did the
// caller tell us the frame is protected".
//
// IT DOES NOT TRIGGER AN SA QUERY.  The trigger is a mgmt-frame
// arrival at a driver above this scaffold; that composition lands
// with R38.M4-002 wiring nas_step(DEAUTH) to first ask the MLME
// whether an SA Query is warranted.  Here the transaction is driven
// by the witness through the four primitives:
//   nml_sa_query_start / _respond / _tick / _state.
//
// nml_arbitrated() returns 0 until R38.M6+ replaces the byte-flag
// `is_protected` with a real BIP MIC verification.
//
// =============================================================================
// §1  PMF MODES
// =============================================================================
//
//   NML_PMF_DISABLED (0) -- ANY mgmt frame admitted regardless of
//                           is_protected.
//   NML_PMF_CAPABLE  (1) -- protected frames preferred; unprotected
//                           admitted for backward compatibility.
//   NML_PMF_REQUIRED (2) -- unprotected state-changing mgmt frames
//                           REFUSED (NML_PMF_REQUIRED_FAIL).
//
// =============================================================================
// §2  SA QUERY STATE MACHINE
// =============================================================================
//
//   NML_SAQ_IDLE (0)    -- no transaction in flight.
//   NML_SAQ_PENDING (1) -- transaction id issued; ticks counting
//                          down; response awaited.
//   NML_SAQ_TIMEOUT (2) -- ticks reached zero; response window
//                          closed; the caller must reset before
//                          another start.
//
// Transitions:
//   IDLE + start(id, ticks)              -> PENDING (id, ticks stored)
//   PENDING + respond(id)                -> IDLE (id must match)
//   PENDING + tick(dt >= remaining)      -> TIMEOUT
//   PENDING + tick(dt < remaining)       -> PENDING (remaining -= dt)
//   TIMEOUT + respond(*)                 -> refuse SA_QUERY_TIMEOUT_STATE
//   TIMEOUT + start(*, *)                -> refuse SA_QUERY_BUSY
//                                          (caller must nml_reset)
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// `_nml_state` and `_nml_stats` are written only by helpers in this
// module.  tools/build.sh confines relocations against both symbols
// to `core/drivers/wifi/net80211_mlme.o` so a second writer cannot
// silently promote a PMF mode or retire an SA Query.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF400..0xFFFFF40F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: net80211_assoc
// 0xFFFFF410..1F, R38.M4-002; adjacent free band below:
// net80211_regdom 0xFFFFF3F0..FF, R38.M4-005).

module Net80211Mlme = structure {

  // §1: PMF modes.
  pub let NML_PMF_DISABLED  : u64 = 0
  pub let NML_PMF_CAPABLE   : u64 = 1
  pub let NML_PMF_REQUIRED  : u64 = 2
  pub let NML_PMF_MAX       : u64 = 2

  // §2: SA Query states.
  pub let NML_SAQ_IDLE      : u64 = 0
  pub let NML_SAQ_PENDING   : u64 = 1
  pub let NML_SAQ_TIMEOUT   : u64 = 2

  // Failure taxonomy 0xFFFFF400..0xFFFFF40F.
  pub let NML_OK                       : u64 = 0
  pub let NML_BAD_ARG                  : u64 = 0xFFFFF40F
  pub let NML_BAD_MODE                 : u64 = 0xFFFFF40E
  pub let NML_PMF_REQUIRED_FAIL        : u64 = 0xFFFFF40D
  pub let NML_SA_QUERY_BUSY            : u64 = 0xFFFFF40C     // start while PENDING or TIMEOUT
  pub let NML_SA_QUERY_MISMATCH        : u64 = 0xFFFFF40B     // respond with wrong id
  pub let NML_SA_QUERY_NOT_PENDING     : u64 = 0xFFFFF40A     // respond while IDLE
  pub let NML_SA_QUERY_TIMEOUT_STATE   : u64 = 0xFFFFF409     // respond after TIMEOUT
  pub let NML_SA_QUERY_ZERO_TICKS      : u64 = 0xFFFFF408     // start with ticks == 0
  pub let NML_SA_QUERY_ZERO_ID         : u64 = 0xFFFFF407     // start with id == 0

  // §3: state cell layout.
  //   [0] PMF mode
  //   [1] SA Query state
  //   [2] SA Query id
  //   [3] SA Query remaining ticks
  pub let mut _nml_state : [u64; 4] = uninit @align(64)
  pub let mut _nml_stats : [u64; 8] = uninit @align(64)

  // Stat slot indices.
  pub let NML_STAT_MODE_SETS       : u64 = 0
  pub let NML_STAT_ADMITS          : u64 = 1
  pub let NML_STAT_REFUSED         : u64 = 2
  pub let NML_STAT_SAQ_STARTS      : u64 = 3
  pub let NML_STAT_SAQ_RESPONDS    : u64 = 4
  pub let NML_STAT_SAQ_TIMEOUTS    : u64 = 5
  pub let NML_STAT_DEAUTH_ADMITS   : u64 = 6
  pub let NML_STAT_DEAUTH_REFUSED  : u64 = 7

  // ==========================================================================
  // Reset — PMF back to DISABLED, SA Query IDLE.  Boot + teardown.
  // ==========================================================================

  pub let nml_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): clear state + stats. Labels prefixed nml_rs_.",
      block: {
        lea r10, [rip + _nml_state];
        xor rax, rax;
        xor rcx, rcx;
      nml_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  nml_rs_st;

        lea r10, [rip + _nml_stats];
        xor rcx, rcx;
      nml_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  nml_rs_ct;
        ret
      }
    } @no_frame

  pub let nml_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M4-003 (#1306): honesty pin. Returns 0 until BIP MIC verification replaces the is_protected byte flag.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let nml_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): counter bump. Labels prefixed nml_nt_.",
      block: {
        cmp rdi, 8;
        jae nml_nt_out;
        lea r10, [rip + _nml_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      nml_nt_out:
        ret
      }
    } @no_frame

  pub let nml_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): counter read. Labels prefixed nml_st_.",
      block: {
        cmp rdi, 8;
        jae nml_st_zero;
        lea r10, [rip + _nml_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      nml_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let nml_pmf_mode : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): read PMF mode.",
      block: {
        lea r10, [rip + _nml_state];
        mov rax, [r10];
        ret
      }
    } @no_frame

  pub let nml_pmf_set_mode : (u64) -> u64 !{mem} @{} =
    fn (mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): set PMF mode. Refuses > NML_PMF_MAX. Labels prefixed nml_pm_.",
      block: {
        cmp rdi, 2;                       // NML_PMF_MAX
        ja  nml_pm_bad;
        lea r10, [rip + _nml_state];
        mov [r10], rdi;
        push rdi;
        mov rdi, 0;                       // MODE_SETS
        call nml_note;
        pop rdi;
        xor rax, rax;
        ret;
      nml_pm_bad:
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF40E;              // NML_BAD_MODE
        ret
      }
    }

  // ==========================================================================
  // nml_mgmt_admit(is_protected) -> NML_OK | NML_PMF_REQUIRED_FAIL
  //
  // The one refuse-gate that consumes the PMF mode.  In DISABLED or
  // CAPABLE mode admits any is_protected value; in REQUIRED mode
  // refuses is_protected == 0.  Bumps DEAUTH_ADMITS / DEAUTH_REFUSED.
  //
  // Named "mgmt_admit" rather than "deauth_admit" because the same
  // gate applies to Deauth / Disassoc / SA Query Req / SA Query Resp
  // and any Robust Action frame -- the gate does not discriminate on
  // frame subtype (the caller does that above by only calling for
  // Robust frames).
  // ==========================================================================

  pub let nml_mgmt_admit : (u64) -> u64 !{mem} @{} =
    fn (is_protected: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): PMF admit gate for a Robust mgmt frame. Labels prefixed nml_ma_.",
      block: {
        lea r10, [rip + _nml_state];
        mov rax, [r10];                   // mode
        cmp rax, 2;                       // REQUIRED?
        jne nml_ma_admit;
        cmp rdi, 0;
        je  nml_ma_refuse;
      nml_ma_admit:
        push rdi;
        mov rdi, 6;                       // DEAUTH_ADMITS
        call nml_note;
        pop rdi;
        xor rax, rax;
        ret;
      nml_ma_refuse:
        mov rdi, 7;                       // DEAUTH_REFUSED
        call nml_note;
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF40D;              // NML_PMF_REQUIRED_FAIL
        ret
      }
    }

  // ==========================================================================
  // SA Query queries.
  // ==========================================================================

  pub let nml_sa_query_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): read SA Query state.",
      block: {
        lea r10, [rip + _nml_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let nml_sa_query_ticks : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): read SA Query remaining ticks.",
      block: {
        lea r10, [rip + _nml_state];
        mov rax, [r10 + 24];              // slot 3
        ret
      }
    } @no_frame

  pub let nml_sa_query_id : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): read SA Query transaction id.",
      block: {
        lea r10, [rip + _nml_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  // ==========================================================================
  // nml_sa_query_start(id, timeout_ticks) -> NML_OK | error
  //
  // Refuses:
  //   * id == 0             -> NML_SA_QUERY_ZERO_ID
  //   * timeout_ticks == 0  -> NML_SA_QUERY_ZERO_TICKS
  //   * state != IDLE       -> NML_SA_QUERY_BUSY
  //
  // Stores (id, ticks) into _nml_state and sets state = PENDING.
  // ==========================================================================

  pub let nml_sa_query_start : (u64, u64) -> u64 !{mem} @{} =
    fn (id: u64) (ticks: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): open an SA Query transaction. Labels prefixed nml_ss_.",
      block: {
        cmp rdi, 0;
        je  nml_ss_zero_id;
        cmp rsi, 0;
        je  nml_ss_zero_ticks;
        lea r10, [rip + _nml_state];
        mov rax, [r10 + 8];               // state
        cmp rax, 0;                       // IDLE
        jne nml_ss_busy;

        mov [r10 + 16], rdi;              // id
        mov [r10 + 24], rsi;              // ticks
        mov rax, 1;                       // PENDING
        mov [r10 + 8], rax;

        push rdi;
        push rsi;
        mov rdi, 3;                       // SAQ_STARTS
        call nml_note;
        pop rsi;
        pop rdi;
        xor rax, rax;
        ret;

      nml_ss_zero_id:
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF407;              // NML_SA_QUERY_ZERO_ID
        ret;
      nml_ss_zero_ticks:
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF408;              // NML_SA_QUERY_ZERO_TICKS
        ret;
      nml_ss_busy:
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF40C;              // NML_SA_QUERY_BUSY
        ret
      }
    }

  // ==========================================================================
  // nml_sa_query_respond(id) -> NML_OK | error
  //
  // Refuses:
  //   * state == IDLE      -> NML_SA_QUERY_NOT_PENDING
  //   * state == TIMEOUT   -> NML_SA_QUERY_TIMEOUT_STATE
  //   * id != stored id    -> NML_SA_QUERY_MISMATCH
  //
  // On admission: clears id + ticks + state (back to IDLE) and bumps
  // SAQ_RESPONDS.
  // ==========================================================================

  pub let nml_sa_query_respond : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): retire an SA Query transaction with matching id. Labels prefixed nml_sr_.",
      block: {
        push rbx;
        mov rbx, rdi;

        lea r10, [rip + _nml_state];
        mov rax, [r10 + 8];               // state
        cmp rax, 0;                       // IDLE
        je  nml_sr_not_pending;
        cmp rax, 2;                       // TIMEOUT
        je  nml_sr_timeout;

        // PENDING: check id.
        mov rax, [r10 + 16];
        cmp rax, rbx;
        jne nml_sr_mismatch;

        // Retire.
        xor rax, rax;
        mov [r10 + 8], rax;               // state = IDLE
        mov [r10 + 16], rax;              // id = 0
        mov [r10 + 24], rax;              // ticks = 0

        mov rdi, 4;                       // SAQ_RESPONDS
        call nml_note;
        xor rax, rax;
        pop rbx;
        ret;

      nml_sr_not_pending:
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF40A;
        pop rbx;
        ret;
      nml_sr_timeout:
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF409;
        pop rbx;
        ret;
      nml_sr_mismatch:
        mov rdi, 2;
        call nml_note;
        mov rax, 0xFFFFF40B;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nml_sa_query_tick(dt) -> NML_OK | error
  //
  // If state != PENDING: NO-OP + admit (0).  Otherwise decrement
  // remaining ticks by dt; if the delta consumes all remaining
  // ticks, transition to TIMEOUT and bump SAQ_TIMEOUTS.  A caller
  // that never ticks a stopped clock is a caller whose scheduling
  // is broken; the no-op admit here refuses that assumption cleanly
  // rather than manufacturing a state change.
  // ==========================================================================

  pub let nml_sa_query_tick : (u64) -> u64 !{mem} @{} =
    fn (dt: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-003 (#1306): advance the SA Query clock. Labels prefixed nml_sk_.",
      block: {
        lea r10, [rip + _nml_state];
        mov rax, [r10 + 8];               // state
        cmp rax, 1;                       // PENDING
        jne nml_sk_noop;

        mov rax, [r10 + 24];              // remaining
        cmp rdi, rax;
        jae nml_sk_expire;

        // remaining -= dt; still PENDING.
        sub rax, rdi;
        mov [r10 + 24], rax;
        xor rax, rax;
        ret;

      nml_sk_expire:
        // Transition to TIMEOUT.
        mov rax, 2;                       // TIMEOUT
        mov [r10 + 8], rax;
        xor rax, rax;
        mov [r10 + 24], rax;              // ticks = 0

        mov rdi, 5;                       // SAQ_TIMEOUTS
        call nml_note;
        xor rax, rax;
        ret;

      nml_sk_noop:
        xor rax, rax;
        ret
      }
    }
}
