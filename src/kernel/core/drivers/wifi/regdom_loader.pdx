// src/kernel/core/drivers/wifi/regdom_loader.pdx — R38.M6-001 (#1314)
//
// REGULATORY-DOMAIN LOADER.  Resolves a COUNTRY CODE (2-byte ASCII
// pair, ISO 3166 subset) into a regulatory domain and PUBLISHES the
// resolution to net80211_regdom by calling nrd_bind against the
// mapped NRD_DOMAIN_*.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RESOLVER that sits above net80211_regdom (R38.M4-005,
// #1308) and below the geo-hint discovery (R38.M6-003, #1316).  A
// live path composes:
//
//   geo_hint.gh_query()            -> (country_code, confidence)
//   regdomain_channel.rdc_pack()   -> {cc, source, ts} wire hint
//   regdom_loader.rdl_publish()    -> nrd_bind(rdl_cc_to_domain(cc))
//
// The loader carries TWO paths to a country code -- an EEPROM read
// (radio's OTP), and a compiled-in DEFAULT of WW (worldwide safe
// subset).  A live board either has an EEPROM the radio driver can
// read (path #1) or does not, and this module reports the second
// case honestly rather than fabricating one -- rdl_load_eeprom()
// returns RDL_NO_EEPROM when the eeprom_stub_id is 0.
//
// IT DOES NOT PARSE COUNTRY IE.  That is the class driver's business
// once wpa_supervisor is up; a Country IE update flows through
// nrd_unbind + nrd_bind directly, not through this loader.
//
// IT DOES NOT ARBITRATE WITH GNSS.  A live path with two disagreeing
// hints (EEPROM says JP, GNSS says US) resolves through the
// arbitration policy the ring-3 supervisor owns -- this module only
// exposes the two sources it knows about.  rdl_arbitrated() returns
// 0 until that composition lands.
//
// =============================================================================
// §1  COUNTRY CODES  (ISO 3166-1 alpha-2, packed as ASCII u16)
// =============================================================================
//
// The known set is small on purpose -- one code per regdomain the
// net80211_regdom module recognises, plus a WORLDWIDE (WW) code that
// maps to the safest 2.4 GHz subset (channels 1..11, i.e. NRD_DOMAIN_US).
//
//   RDL_CC_US = 0x5553  ('U'<<8 | 'S')  -> NRD_DOMAIN_US
//   RDL_CC_EU = 0x4555  ('E'<<8 | 'U')  -> NRD_DOMAIN_EU
//   RDL_CC_JP = 0x4A50  ('J'<<8 | 'P')  -> NRD_DOMAIN_JP
//   RDL_CC_CN = 0x434E  ('C'<<8 | 'N')  -> NRD_DOMAIN_US (subset ch 1..11)
//   RDL_CC_UK = 0x554B  ('U'<<8 | 'K')  -> NRD_DOMAIN_EU (13-ch identical)
//   RDL_CC_WW = 0x5757  ('W'<<8 | 'W')  -> NRD_DOMAIN_US (safe subset)
//
// A code outside this table is REFUSED (RDL_BAD_CC).  The kernel
// does not silently promote an unrecognised country to WW: that would
// mask a live driver misreading its own EEPROM.
//
// =============================================================================
// §2  SOURCES
// =============================================================================
//
//   RDL_SRC_NONE    = 0    (never loaded)
//   RDL_SRC_EEPROM  = 1    (radio OTP / EEPROM read)
//   RDL_SRC_DEFAULT = 2    (compiled-in WW fallback)
//
// Note: GNSS is NOT a loader source.  Geo-hint discovery
// (regdom_loader's peer) reports GNSS through regdomain_channel with
// RDC_SRC_GNSS = 2; the loader does not touch GNSS itself.  The
// numeric values in the two enums are deliberately disjoint at the
// wire boundary (regdomain_channel uses 1/2/3, this module uses 0/1/2)
// so a caller that mixes them up runs into the source validator on
// the wire side rather than silently mislabelling a hint.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// `_rdl_state` and `_rdl_stats` are written only by helpers in this
// module.  tools/build.sh confines relocations against both symbols
// to `core/drivers/wifi/regdom_loader.o` so a second writer cannot
// silently promote a country code or forge a source label.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF390..0xFFFFF39F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: wpa_supplicant_channel
// 0xFFFFF3A0..AF; adjacent free band below: regdomain_channel
// 0xFFFFF380..8F).

module RegdomLoader = structure {

  // §1: country codes (ISO 3166-1 alpha-2, packed ASCII).
  pub let RDL_CC_US       : u64 = 0x5553
  pub let RDL_CC_EU       : u64 = 0x4555
  pub let RDL_CC_JP       : u64 = 0x4A50
  pub let RDL_CC_CN       : u64 = 0x434E
  pub let RDL_CC_UK       : u64 = 0x554B
  pub let RDL_CC_WW       : u64 = 0x5757

  // §2: source ordinals.
  pub let RDL_SRC_NONE    : u64 = 0
  pub let RDL_SRC_EEPROM  : u64 = 1
  pub let RDL_SRC_DEFAULT : u64 = 2

  // §4: failure taxonomy 0xFFFFF390..0xFFFFF39F.
  pub let RDL_OK               : u64 = 0
  pub let RDL_BAD_ARG          : u64 = 0xFFFFF39F
  pub let RDL_NOT_LOADED       : u64 = 0xFFFFF39E
  pub let RDL_ALREADY_LOADED   : u64 = 0xFFFFF39D
  pub let RDL_NO_EEPROM        : u64 = 0xFFFFF39C    // stub says "no EEPROM present"
  pub let RDL_BAD_CC           : u64 = 0xFFFFF39B    // country code outside known set
  pub let RDL_BAD_SOURCE       : u64 = 0xFFFFF39A
  pub let RDL_PUBLISH_FAIL     : u64 = 0xFFFFF399    // nrd_bind refused

  // §3: state cell layout.
  //   [0] loaded (0 / 1)
  //   [1] source (RDL_SRC_*)
  //   [2] country_code (16-bit ASCII pair)
  pub let mut _rdl_state : [u64; 4] = uninit @align(64)
  pub let mut _rdl_stats : [u64; 8] = uninit @align(64)

  pub let RDL_STAT_LOADS_EEPROM   : u64 = 0
  pub let RDL_STAT_LOADS_DEFAULT  : u64 = 1
  pub let RDL_STAT_LOAD_REFUSED   : u64 = 2
  pub let RDL_STAT_PUBLISHES      : u64 = 3
  pub let RDL_STAT_PUBLISH_REFUSED: u64 = 4

  // ==========================================================================
  // Reset -- clear state + stats.  Boot + teardown.
  // ==========================================================================

  pub let rdl_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): clear state + stats. Labels prefixed rdl_rs_.",
      block: {
        lea r10, [rip + _rdl_state];
        xor rax, rax;
        xor rcx, rcx;
      rdl_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  rdl_rs_st;

        lea r10, [rip + _rdl_stats];
        xor rcx, rcx;
      rdl_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  rdl_rs_ct;
        ret
      }
    } @no_frame

  pub let rdl_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-001 (#1314): honesty pin. Returns 0 until a ring-3 supervisor composes this loader with the GNSS-derived hint (geo_hint.pdx) through the regdomain_channel wire.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let rdl_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): counter bump. Labels prefixed rdl_nt_.",
      block: {
        cmp rdi, 8;
        jae rdl_nt_out;
        lea r10, [rip + _rdl_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      rdl_nt_out:
        ret
      }
    } @no_frame

  pub let rdl_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): counter read. Labels prefixed rdl_st_.",
      block: {
        cmp rdi, 8;
        jae rdl_st_zero;
        lea r10, [rip + _rdl_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      rdl_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let rdl_loaded : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): read LOADED flag.",
      block: {
        lea r10, [rip + _rdl_state];
        mov rax, [r10];
        ret
      }
    } @no_frame

  pub let rdl_source : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): read source ordinal (0 if never loaded).",
      block: {
        lea r10, [rip + _rdl_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let rdl_country : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): read country code (0 if never loaded).",
      block: {
        lea r10, [rip + _rdl_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  // ==========================================================================
  // rdl_cc_valid(cc) -> 1 iff cc is one of {US, EU, JP, CN, UK, WW}.
  // ==========================================================================

  pub let rdl_cc_valid : (u64) -> u64 !{} @{} =
    fn (cc: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-001 (#1314): recognise the six ISO codes in §1. Labels prefixed rdl_cv_.",
      block: {
        mov r10, 0x5553;                  // US
        cmp rdi, r10;
        je  rdl_cv_yes;
        mov r10, 0x4555;                  // EU
        cmp rdi, r10;
        je  rdl_cv_yes;
        mov r10, 0x4A50;                  // JP
        cmp rdi, r10;
        je  rdl_cv_yes;
        mov r10, 0x434E;                  // CN
        cmp rdi, r10;
        je  rdl_cv_yes;
        mov r10, 0x554B;                  // UK
        cmp rdi, r10;
        je  rdl_cv_yes;
        mov r10, 0x5757;                  // WW
        cmp rdi, r10;
        je  rdl_cv_yes;
        xor rax, rax;
        ret;
      rdl_cv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // rdl_cc_to_domain(cc) -> NRD_DOMAIN_* | 0 (unknown)
  //
  // US -> 1, EU -> 2, JP -> 3, CN -> 1 (2.4 GHz safe subset ch 1..11),
  // UK -> 2 (EU-identical 13-channel), WW -> 1 (safest global subset).
  // ==========================================================================

  pub let rdl_cc_to_domain : (u64) -> u64 !{} @{} =
    fn (cc: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-001 (#1314): map country code to net80211_regdom NRD_DOMAIN_*. Labels prefixed rdl_cd_.",
      block: {
        mov r10, 0x5553;                  // US
        cmp rdi, r10;
        je  rdl_cd_us;
        mov r10, 0x4555;                  // EU
        cmp rdi, r10;
        je  rdl_cd_eu;
        mov r10, 0x4A50;                  // JP
        cmp rdi, r10;
        je  rdl_cd_jp;
        mov r10, 0x434E;                  // CN -> US-subset
        cmp rdi, r10;
        je  rdl_cd_us;
        mov r10, 0x554B;                  // UK -> EU
        cmp rdi, r10;
        je  rdl_cd_eu;
        mov r10, 0x5757;                  // WW -> US-safe
        cmp rdi, r10;
        je  rdl_cd_us;
        xor rax, rax;
        ret;
      rdl_cd_us:
        mov rax, 1;
        ret;
      rdl_cd_eu:
        mov rax, 2;
        ret;
      rdl_cd_jp:
        mov rax, 3;
        ret
      }
    } @no_frame

  // ==========================================================================
  // rdl_load_eeprom(eeprom_stub_id) -> RDL_OK | error
  //
  // Stub for the radio's EEPROM/OTP path.  A live driver will replace
  // this with a real read against the AX211 CNVi transport; the stub
  // interprets its argument as a country code, treating zero as
  // "no EEPROM present" (RDL_NO_EEPROM).  A caller that passes a
  // country code outside the known set is refused with RDL_BAD_CC.
  //
  // Refuses:
  //   * already loaded             -> RDL_ALREADY_LOADED
  //   * eeprom_stub_id == 0        -> RDL_NO_EEPROM
  //   * country code unknown       -> RDL_BAD_CC
  // ==========================================================================

  pub let rdl_load_eeprom : (u64) -> u64 !{mem} @{} =
    fn (eeprom_stub_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): EEPROM path stub. Labels prefixed rdl_le_.",
      block: {
        push rbx;
        mov rbx, rdi;

        // Already loaded?
        lea r10, [rip + _rdl_state];
        mov rax, [r10];
        cmp rax, 0;
        jne rdl_le_dupe;

        cmp rbx, 0;
        je  rdl_le_noeep;

        mov rdi, rbx;
        call rdl_cc_valid;
        cmp rax, 0;
        je  rdl_le_badcc;

        lea r10, [rip + _rdl_state];
        mov rax, 1;
        mov [r10], rax;                   // loaded = 1
        mov rax, 1;                       // RDL_SRC_EEPROM
        mov [r10 + 8], rax;
        mov [r10 + 16], rbx;              // country_code

        mov rdi, 0;                       // LOADS_EEPROM
        call rdl_note;
        xor rax, rax;
        pop rbx;
        ret;

      rdl_le_dupe:
        mov rdi, 2;                       // LOAD_REFUSED
        call rdl_note;
        mov rax, 0xFFFFF39D;              // ALREADY_LOADED
        pop rbx;
        ret;
      rdl_le_noeep:
        mov rdi, 2;
        call rdl_note;
        mov rax, 0xFFFFF39C;              // NO_EEPROM
        pop rbx;
        ret;
      rdl_le_badcc:
        mov rdi, 2;
        call rdl_note;
        mov rax, 0xFFFFF39B;              // BAD_CC
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // rdl_load_default() -> RDL_OK | error
  //
  // Compiled-in fallback: loads (WW, DEFAULT).  A live path calls
  // this when rdl_load_eeprom returned RDL_NO_EEPROM.
  //
  // Refuses:
  //   * already loaded             -> RDL_ALREADY_LOADED
  // ==========================================================================

  pub let rdl_load_default : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): DEFAULT fallback loads WW. Push rbx aligns rsp%16 -> 0 for the nested rdl_note call. Labels prefixed rdl_ld_.",
      block: {
        push rbx;

        lea r10, [rip + _rdl_state];
        mov rax, [r10];
        cmp rax, 0;
        jne rdl_ld_dupe;

        lea r10, [rip + _rdl_state];
        mov rax, 1;
        mov [r10], rax;                   // loaded
        mov rax, 2;                       // RDL_SRC_DEFAULT
        mov [r10 + 8], rax;
        mov rax, 0x5757;                  // WW
        mov [r10 + 16], rax;

        mov rdi, 1;                       // LOADS_DEFAULT
        call rdl_note;
        xor rax, rax;
        pop rbx;
        ret;

      rdl_ld_dupe:
        mov rdi, 2;                       // LOAD_REFUSED
        call rdl_note;
        mov rax, 0xFFFFF39D;              // ALREADY_LOADED
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // rdl_unload() -> RDL_OK | error
  //
  // Drop the loaded record.  Called on retry (EEPROM failed; want to
  // switch to DEFAULT).  Refuses if never loaded.
  // ==========================================================================

  pub let rdl_unload : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): drop record. Labels prefixed rdl_ul_.",
      block: {
        lea r10, [rip + _rdl_state];
        mov rax, [r10];
        cmp rax, 0;
        je  rdl_ul_notl;

        xor rax, rax;
        mov [r10], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        xor rax, rax;
        ret;

      rdl_ul_notl:
        mov rax, 0xFFFFF39E;              // NOT_LOADED
        ret
      }
    }

  // ==========================================================================
  // rdl_publish() -> RDL_OK | error
  //
  // Maps the loaded country_code to a NRD_DOMAIN_* and calls
  // nrd_bind against net80211_regdom.  Refuses if never loaded, if
  // the country code no longer maps to a known domain (a defensive
  // check -- the load path already refuses unknowns), or if nrd_bind
  // refuses (already-bound / unknown-domain).
  //
  // The caller composes: rdl_load_eeprom / rdl_load_default first,
  // then this.  A live path adds arbitration against a GNSS-derived
  // hint before publishing; this module reports rdl_arbitrated() = 0
  // until that composition lands.
  // ==========================================================================

  pub let rdl_publish : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-001 (#1314): publish loaded country_code to net80211_regdom.nrd_bind. Labels prefixed rdl_pb_.",
      block: {
        push rbx;

        lea r10, [rip + _rdl_state];
        mov rax, [r10];
        cmp rax, 0;
        je  rdl_pb_notl;

        mov rbx, [r10 + 16];              // country_code
        mov rdi, rbx;
        call rdl_cc_to_domain;
        cmp rax, 0;
        je  rdl_pb_badcc;

        mov rdi, rax;
        call nrd_bind;
        cmp rax, 0;
        jne rdl_pb_bindfail;

        mov rdi, 3;                       // PUBLISHES
        call rdl_note;
        xor rax, rax;
        pop rbx;
        ret;

      rdl_pb_notl:
        mov rdi, 4;                       // PUBLISH_REFUSED
        call rdl_note;
        mov rax, 0xFFFFF39E;              // NOT_LOADED
        pop rbx;
        ret;
      rdl_pb_badcc:
        mov rdi, 4;
        call rdl_note;
        mov rax, 0xFFFFF39B;              // BAD_CC
        pop rbx;
        ret;
      rdl_pb_bindfail:
        mov rdi, 4;
        call rdl_note;
        mov rax, 0xFFFFF399;              // PUBLISH_FAIL
        pop rbx;
        ret
      }
    }
}
