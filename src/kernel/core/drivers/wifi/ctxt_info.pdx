// src/kernel/core/drivers/wifi/ctxt_info.pdx — R38.M2-001 (#1294)
//
// Intel AX211 CTXT_INFO structure + TX and RX ring backing stores.
// The CTXT_INFO block is the on-boot "handshake page" iwlwifi hands
// to the firmware; it names the base PAs (BDA -- Buffer Descriptor
// Address) of the TR (transfer/TX), RX-free, RX-used and status
// rings, plus the firmware image size and page count.  This module
// is the ONE WRITER of that block and of the TX/RX rings themselves,
// so a second module cannot forge a submitted descriptor slot.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RING-BACKING-STORE + INDEX BOOKKEEPING half of R38.M2.
// tx_dma (R38.M2-002) is the ENQUEUE half; it consults wctx_index_get
// / wctx_tx_slot_write to bump the tail pointer and stage a TFD.
// The two halves compose:
//
//   caller -> tx_dma.wtxd_enqueue
//     -> dma_domain.wdd_check              (§7 D1.b refuse-gate)
//     -> ctxt_info.wctx_tx_slot_write      (SINGLE WRITER of the ring)
//     -> ctxt_info.wctx_index_set          (SINGLE WRITER of the tail)
//     -> tx_dma.wtxd_doorbell_write        (SINGLE WRITER of the CSR)
//
// IT DOES NOT ISSUE MMIO.  The CTXT_INFO block and the rings live in
// this module's .bss.  A live driver hands the firmware the physical
// addresses of these regions via BAR-writable CTXT_INFO_BA CSR (a
// register the load path already models under fw_load); the substitution
// point is here, unchanged for the caller.
//
// IT DOES NOT VALIDATE A CALLER-SUPPLIED PA.  That is D1.b's job and
// lives in dma_domain.pdx; tx_dma routes every buffer through the
// domain refuse-gate before it reaches this module.
//
// wctx_arbitrated() returns 0 until R38.M4 hands these regions to a
// live iwlwifi firmware via CTXT_INFO_BA.
//
// =============================================================================
// §1  RING GEOMETRY
// =============================================================================
//
// TX ring: 256 slots of one TFD each.  A TFD as this scaffold models
// it is a two-u64 pair:
//   word 0 : tfd_addr           (buffer PA)
//   word 1 : tfd_len | flags    (low 32 = length, high 32 = flags)
// A live driver's TFD adds up to 20 fragment descriptors per slot;
// the two-word form is sufficient for the R38.M2 refuse-gate exercise
// and expands without changing the wctx_tx_slot_write signature (the
// fragment array becomes a follow-on write into the same slot's tail).
//
// RX ring: 256 slots of one BDA (Buffer Descriptor Address) each.  A
// live driver's RX descriptor is one u64 (upper 12 bits are the ring
// index the hardware wrote, lower 52 the buffer PA); the one-word
// form here matches that shape.
//
// =============================================================================
// §2  INDEX BOOKKEEPING
// =============================================================================
//
// _wctx_indices carries {tx_head, tx_tail, rx_head, rx_tail,
// tx_ring_bda, rx_ring_bda, reserved, reserved}.  head and tail are
// FREE-RUNNING 64-bit counters; the slot index is (head % 256).
// Free-running counters distinguish "empty ring" (head == tail) from
// "full ring" (head - tail == depth) without a spare slot -- a
// property iwlwifi uses on real hardware and this scaffold keeps.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _wctx_info, _wctx_tx_ring, _wctx_rx_ring, _wctx_indices and
// _wctx_stats are written only by helpers in this module.
// tools/build.sh confines relocations against each symbol to
// `core/drivers/wifi/ctxt_info.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF4A0..0xFFFFF4AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: fw_compat
// 0xFFFFF4B0..BF, R38.M1-004; adjacent free band below: tx_dma
// 0xFFFFF490..9F, R38.M2-002).

module CtxtInfo = structure {

  // §1: geometry.
  pub let WCTX_TX_DEPTH        : u64 = 256
  pub let WCTX_RX_DEPTH        : u64 = 256
  pub let WCTX_TX_ENTRY_U64S   : u64 = 2              // {addr, len|flags}
  pub let WCTX_RX_ENTRY_U64S   : u64 = 1              // {bda}

  // §1: CTXT_INFO field slot indices inside _wctx_info.
  pub let WCTX_INFO_VERSION     : u64 = 0
  pub let WCTX_INFO_CONTROL     : u64 = 1
  pub let WCTX_INFO_IMG_SIZE    : u64 = 2
  pub let WCTX_INFO_PAGE_COUNT  : u64 = 3
  pub let WCTX_INFO_TR_BDA      : u64 = 4
  pub let WCTX_INFO_RX_BDA      : u64 = 5
  pub let WCTX_INFO_HCMD_BDA    : u64 = 6
  pub let WCTX_INFO_STATUS_BDA  : u64 = 7
  pub let WCTX_INFO_FIELDS      : u64 = 8

  // §2: index slot indices inside _wctx_indices.
  pub let WCTX_IDX_TX_HEAD      : u64 = 0
  pub let WCTX_IDX_TX_TAIL      : u64 = 1
  pub let WCTX_IDX_RX_HEAD      : u64 = 2
  pub let WCTX_IDX_RX_TAIL      : u64 = 3
  pub let WCTX_IDX_TX_RING_BDA  : u64 = 4
  pub let WCTX_IDX_RX_RING_BDA  : u64 = 5
  pub let WCTX_IDX_SLOTS        : u64 = 8

  // Failure taxonomy — 0xFFFFF4A0..0xFFFFF4AF.
  pub let WCTX_OK               : u64 = 0
  pub let WCTX_BAD_ARG          : u64 = 0xFFFFF4AF
  pub let WCTX_INDEX_OOR        : u64 = 0xFFFFF4AE
  pub let WCTX_RING_FULL        : u64 = 0xFFFFF4AD
  pub let WCTX_RING_EMPTY       : u64 = 0xFFFFF4AC
  pub let WCTX_BAD_FIELD        : u64 = 0xFFFFF4AB
  pub let WCTX_NOT_INIT         : u64 = 0xFFFFF4AA

  // §3: the writers.
  //   CTXT_INFO block modelled as [u64; 8] (one slot per named field
  //   in §1; a live block reserves ~2 KB for future firmware fields
  //   which are not consumed by this milestone).
  pub let mut _wctx_info    : [u64; 8]   = uninit @align(64)
  //   TX ring: 256 * 2 = 512 u64s (4096 bytes).
  pub let mut _wctx_tx_ring : [u64; 512] = uninit @align(64)
  //   RX ring: 256 * 1 = 256 u64s (2048 bytes).
  pub let mut _wctx_rx_ring : [u64; 256] = uninit @align(64)
  //   Indices + ring BDAs.
  pub let mut _wctx_indices : [u64; 8]   = uninit @align(64)
  //   Stats.
  pub let mut _wctx_stats   : [u64; 8]   = uninit @align(64)

  // Stat slot indices.
  pub let WCTX_STAT_INITS       : u64 = 0
  pub let WCTX_STAT_TX_WRITES   : u64 = 1
  pub let WCTX_STAT_RX_WRITES   : u64 = 2
  pub let WCTX_STAT_FIELD_SETS  : u64 = 3
  pub let WCTX_STAT_REFUSED     : u64 = 4

  // ==========================================================================
  // Reset — zero every writer.  Boot + teardown.
  // ==========================================================================

  pub let wctx_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): zero CTXT_INFO block, both rings, indices, stats. Labels prefixed wctx_rs_.",
      block: {
        // _wctx_info: 8 u64.
        lea r10, [rip + _wctx_info];
        xor rax, rax;
        xor rcx, rcx;
      wctx_rs_info:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wctx_rs_info;

        // _wctx_tx_ring: 512 u64.
        lea r10, [rip + _wctx_tx_ring];
        xor rcx, rcx;
      wctx_rs_tx:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  wctx_rs_tx;

        // _wctx_rx_ring: 256 u64.
        lea r10, [rip + _wctx_rx_ring];
        xor rcx, rcx;
      wctx_rs_rx:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  wctx_rs_rx;

        // _wctx_indices: 8 u64.
        lea r10, [rip + _wctx_indices];
        xor rcx, rcx;
      wctx_rs_idx:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wctx_rs_idx;

        // _wctx_stats: 8 u64.
        lea r10, [rip + _wctx_stats];
        xor rcx, rcx;
      wctx_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wctx_rs_st;

        ret
      }
    }

  pub let wctx_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M2-001 (#1294): honesty pin. Returns 0 until R38.M4 hands these regions to a live firmware via CTXT_INFO_BA.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let wctx_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): counter bump. Labels prefixed wctx_nt_.",
      block: {
        cmp rdi, 8;
        jae wctx_nt_out;
        lea r10, [rip + _wctx_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wctx_nt_out:
        ret
      }
    }

  pub let wctx_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): counter read. Labels prefixed wctx_st_.",
      block: {
        cmp rdi, 8;
        jae wctx_st_zero;
        lea r10, [rip + _wctx_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wctx_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // CTXT_INFO field access.
  // ==========================================================================

  pub let wctx_info_set : (u64, u64) -> u64 !{mem} @{} =
    fn (field: u64) (val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): write CTXT_INFO field. Refuses BAD_FIELD out of range. Labels prefixed wctx_is_.",
      block: {
        cmp rdi, 8;                       // WCTX_INFO_FIELDS
        jae wctx_is_bad;
        lea r10, [rip + _wctx_info];
        mov [r10 + rdi * 8], rsi;
        push rdi;
        mov rdi, 3;                       // WCTX_STAT_FIELD_SETS
        call wctx_note;
        pop rdi;
        xor rax, rax;
        ret;
      wctx_is_bad:
        mov rdi, 4;                       // REFUSED
        call wctx_note;
        mov rax, 0xFFFFF4AB;              // WCTX_BAD_FIELD
        ret
      }
    }

  pub let wctx_info_get : (u64) -> u64 !{mem} @{} =
    fn (field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): read CTXT_INFO field. Returns 0xFFFFF4AB on BAD_FIELD (indistinguishable from a stored value of that exact bit-pattern only if the caller wrote it deliberately). Labels prefixed wctx_ig_.",
      block: {
        cmp rdi, 8;
        jae wctx_ig_bad;
        lea r10, [rip + _wctx_info];
        mov rax, [r10 + rdi * 8];
        ret;
      wctx_ig_bad:
        mov rax, 0xFFFFF4AB;              // WCTX_BAD_FIELD
        ret
      }
    }

  // ==========================================================================
  // wctx_init(version, img_size, page_count, tx_bda, rx_bda) -> WCTX_OK
  //
  // Records the firmware handshake fields + the ring BDAs (physical
  // base addresses of the two rings the firmware will read from and
  // write to).  Every field is written unconditionally; there is no
  // validity check on the values (a caller-supplied img_size of zero
  // is a firmware image with zero bytes to load, which fw_verify
  // would already have refused).  Bumps INITS on completion.
  // ==========================================================================

  pub let wctx_init : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (version: u64) (img_size: u64) (page_count: u64) (tx_bda: u64) (rx_bda: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): stamp CTXT_INFO fields + record ring BDAs. Labels prefixed wctx_in_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // version
        mov r12, rsi;                     // img_size
        mov r13, rdx;                     // page_count
        mov r14, rcx;                     // tx_bda
        mov r15, r8;                      // rx_bda

        lea r10, [rip + _wctx_info];
        mov [r10 + 0], rbx;               // VERSION
        xor rax, rax;
        mov [r10 + 8], rax;               // CONTROL (zeroed; live path will set)
        mov [r10 + 16], r12;              // IMG_SIZE
        mov [r10 + 24], r13;              // PAGE_COUNT
        mov [r10 + 32], r14;              // TR_BDA
        mov [r10 + 40], r15;              // RX_BDA
        mov [r10 + 48], rax;              // HCMD_BDA
        mov [r10 + 56], rax;              // STATUS_BDA

        lea r10, [rip + _wctx_indices];
        mov [r10 + 32], r14;              // TX_RING_BDA slot
        mov [r10 + 40], r15;              // RX_RING_BDA slot
        // TX_HEAD, TX_TAIL, RX_HEAD, RX_TAIL zeroed by wctx_reset;
        // wctx_init does not repeat that zeroing so a mid-boot
        // re-init cannot silently rewind a live counter without
        // the caller having called wctx_reset first.

        mov rdi, 0;                       // WCTX_STAT_INITS
        call wctx_note;
        xor rax, rax;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Index access.
  // ==========================================================================

  pub let wctx_index_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): read index slot. OOR returns 0. Labels prefixed wctx_ig_i_.",
      block: {
        cmp rdi, 8;                       // WCTX_IDX_SLOTS
        jae wctx_ig_i_zero;
        lea r10, [rip + _wctx_indices];
        mov rax, [r10 + rdi * 8];
        ret;
      wctx_ig_i_zero:
        xor rax, rax;
        ret
      }
    }

  pub let wctx_index_set : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): write index slot. OOR returns WCTX_INDEX_OOR. Labels prefixed wctx_is_i_.",
      block: {
        cmp rdi, 8;
        jae wctx_is_i_bad;
        lea r10, [rip + _wctx_indices];
        mov [r10 + rdi * 8], rsi;
        xor rax, rax;
        ret;
      wctx_is_i_bad:
        mov rax, 0xFFFFF4AE;              // WCTX_INDEX_OOR
        ret
      }
    }

  // ==========================================================================
  // Ring geometry helpers -- head/tail arithmetic on free-running
  // counters, per §2.
  // ==========================================================================

  //  free = depth - (head - tail).  Because both counters are 64-bit
  //  and only ever advance forward, (head - tail) is the number of
  //  in-flight slots.  A ring is FULL iff (head - tail) == depth,
  //  EMPTY iff (head - tail) == 0.  A well-behaved caller advances
  //  the tail (retire) and the head (enqueue) monotonically; a caller
  //  that runs head past tail + depth is refused as RING_FULL at
  //  wctx_tx_slot_write time.
  pub let wctx_tx_inflight : (u64, u64) -> u64 !{} @{} =
    fn (head: u64) (tail: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M2-001 (#1294): head - tail. Labels prefixed wctx_ti_.",
      block: {
        mov rax, rdi;
        sub rax, rsi;
        ret
      }
    }

  pub let wctx_tx_is_full : (u64, u64) -> u64 !{} @{} =
    fn (head: u64) (tail: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M2-001 (#1294): 1 iff (head - tail) == WCTX_TX_DEPTH. Labels prefixed wctx_tf_.",
      block: {
        mov rax, rdi;
        sub rax, rsi;
        mov r10, 256;                     // WCTX_TX_DEPTH
        cmp rax, r10;
        jne wctx_tf_no;
        mov rax, 1;
        ret;
      wctx_tf_no:
        xor rax, rax;
        ret
      }
    }

  pub let wctx_tx_is_empty : (u64, u64) -> u64 !{} @{} =
    fn (head: u64) (tail: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M2-001 (#1294): 1 iff head == tail. Labels prefixed wctx_te_.",
      block: {
        cmp rdi, rsi;
        je  wctx_te_yes;
        xor rax, rax;
        ret;
      wctx_te_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // TX slot write / read.  slot must be < WCTX_TX_DEPTH; higher indices
  // refuse INDEX_OOR.  Each slot is two u64s.
  // ==========================================================================

  pub let wctx_tx_slot_write : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (tfd_addr: u64) (tfd_len_flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): stamp a TFD at (slot * 16). OOR refuses. Labels prefixed wctx_tw_. Offset folded into r10 via `add` because paideia-as requires an explicit scale on any index register, and the TFD layout is 16 bytes wide (no 16 scale available; the alternative is two [+ *8] pokes but folding is cleaner).",
      block: {
        cmp rdi, 256;                     // WCTX_TX_DEPTH
        jae wctx_tw_bad;
        lea r10, [rip + _wctx_tx_ring];
        // offset = slot * 2 * 8 = slot * 16.
        mov rax, rdi;
        shl rax, 4;
        add r10, rax;
        mov [r10], rsi;                   // word 0
        mov [r10 + 8], rdx;               // word 1

        push rdi;
        mov rdi, 1;                       // WCTX_STAT_TX_WRITES
        call wctx_note;
        pop rdi;
        xor rax, rax;
        ret;
      wctx_tw_bad:
        mov rdi, 4;
        call wctx_note;
        mov rax, 0xFFFFF4AE;              // WCTX_INDEX_OOR
        ret
      }
    }

  pub let wctx_tx_slot_addr : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): read TFD word 0 at slot. OOR returns 0. Labels prefixed wctx_ta_. Offset folded into r10 (paideia-as requires an explicit scale on any index register; no 16 scale available for a 16-byte TFD).",
      block: {
        cmp rdi, 256;
        jae wctx_ta_zero;
        lea r10, [rip + _wctx_tx_ring];
        mov rax, rdi;
        shl rax, 4;
        add r10, rax;
        mov rax, [r10];
        ret;
      wctx_ta_zero:
        xor rax, rax;
        ret
      }
    }

  pub let wctx_tx_slot_lenflags : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): read TFD word 1 at slot. OOR returns 0. Labels prefixed wctx_tl_. Offset folded into r10 (see wctx_tx_slot_write justification for the scale-form rationale).",
      block: {
        cmp rdi, 256;
        jae wctx_tl_zero;
        lea r10, [rip + _wctx_tx_ring];
        mov rax, rdi;
        shl rax, 4;
        add r10, rax;
        mov rax, [r10 + 8];
        ret;
      wctx_tl_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // RX slot write / read.  slot < WCTX_RX_DEPTH; higher indices refuse
  // INDEX_OOR.  Each slot is one u64.
  // ==========================================================================

  pub let wctx_rx_slot_write : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (bda: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): stamp an RX BDA at slot. OOR refuses. Labels prefixed wctx_rw_.",
      block: {
        cmp rdi, 256;
        jae wctx_rw_bad;
        lea r10, [rip + _wctx_rx_ring];
        mov [r10 + rdi * 8], rsi;

        push rdi;
        mov rdi, 2;                       // WCTX_STAT_RX_WRITES
        call wctx_note;
        pop rdi;
        xor rax, rax;
        ret;
      wctx_rw_bad:
        mov rdi, 4;
        call wctx_note;
        mov rax, 0xFFFFF4AE;
        ret
      }
    }

  pub let wctx_rx_slot_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-001 (#1294): read RX BDA at slot. OOR returns 0. Labels prefixed wctx_rg_.",
      block: {
        cmp rdi, 256;
        jae wctx_rg_zero;
        lea r10, [rip + _wctx_rx_ring];
        mov rax, [r10 + rdi * 8];
        ret;
      wctx_rg_zero:
        xor rax, rax;
        ret
      }
    }
}
