// src/kernel/core/drivers/wifi/fw_load.pdx — R38.M1-003 (#1292)
//
// Intel AX211 firmware LOAD SEQUENCE -- upload the UMAC+MVM sections
// admitted by fw_verify (#1291) via DMA into on-chip SRAM, release
// the CPU reset via CSR_RESET, and wait for the INIT_ALIVE
// notification by polling the CSR_INT status bit.  Refuses the load
// unless BOTH fw_verify has admitted a bundle this boot AND
// fw_compat (#1293) has approved the version-compatibility pair for
// the recorded hardware id.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the BYTE-MOVER + BRING-UP FSM of R38.M1.  fw_verify (#1291)
// answers "may we run this bundle at all?"; fw_compat (#1293)
// answers "is this bundle allowed on THIS hardware id?"; this
// module is what happens AFTER both refuse-gates pass: it shovels
// the two sections into on-chip SRAM through a DMA seam, releases
// the CPU reset by clearing CSR_RESET.CPU_HALT, and polls the
// INIT_ALIVE bit of CSR_INT with a bounded wait.  Without this
// module the verified bundle is inert.
//
// IT DOES NOT PERFORM REAL DMA.  The upload is modelled as two
// writes into a small synthetic register bank (§3), one per
// section, whose destination address is the section's on-chip SRAM
// offset and whose value is a caller-verifiable digest.  A live
// driver replaces the two writes with a real DMA engine that
// shovels the sections into the AX211's on-chip SRAM; the
// substitution point is here, unchanged for the caller.
//
// IT DOES NOT MINT KIND_WIFI_FIRMWARE.  The firmware descriptor a
// live load path would receive belongs to R38.M3 -- this module
// takes a caller-verified bundle out of fw_verify's row accessors.
//
// wfl_arbitrated() returns 0 until a later round wires the seam to
// a live iwlwifi DMA engine and interrupt line.
//
// =============================================================================
// §1  CSR REGISTER MAP (synthetic; iwlwifi drv/csr.h names)
// =============================================================================
//
// A tiny register bank inside this module models the AX211 CSR
// window.  Layout (u32 each, packed at u64 slots for alignment):
//
//   [0]  CSR_RESET       bit 0 = CPU_HALT (asserted by hardware
//                        after power-on; the load path releases it
//                        after the sections have been staged).
//   [1]  CSR_INT         bit 0 = INIT_ALIVE (hardware writes this
//                        once the firmware's initial ALIVE
//                        notification is on the RX ring).
//   [2]  CSR_HW_REV      copy of the caller-supplied hardware id;
//                        the load path reads it before consulting
//                        fw_compat.
//   [3]  CSR_UMAC_ADDR   destination-SRAM address the UMAC section
//                        was written to (echo of the DMA descriptor).
//   [4]  CSR_UMAC_DIGEST digest of the UMAC section (u64 xor of
//                        the two words at offsets 0 and 8; a live
//                        driver replaces this with the DMA engine's
//                        completion status word).
//   [5]  CSR_MVM_ADDR    ditto for MVM.
//   [6]  CSR_MVM_DIGEST  ditto for MVM.
//   [7]  CSR_UPLOAD_SEQ  the load path's upload count (bumped once
//                        per successful load; a live driver
//                        replaces this with the hardware SEQ CSR).
//
// The BAR-relative offset a live driver would use is documented in
// iwlwifi drv/csr.h; the offsets here are internal and do not need
// to match the shipping ones -- fw_load's contract with the rest
// of the system is through wfl_load(), not through the offsets.
//
// =============================================================================
// §2  TIMEOUT BOUND (BSPEC §7 mitigation surface)
// =============================================================================
//
// A live iwlwifi driver polls CSR_INT.INIT_ALIVE with a 2 s
// timeout.  In this scaffold the wait is a bounded loop of 2 s /
// tick-quantum iterations; the iteration count is exposed as
// WFL_ALIVE_MAX_ITERS so a witness can prove the timeout path
// without waiting a real 2 s.
//
// A load whose ALIVE bit is not set inside the bound returns
// WFL_ALIVE_TIMEOUT.  On timeout the CPU is halted again (a live
// driver would re-assert CSR_RESET.CPU_HALT so the chip does not
// execute a partially-uploaded image), the recorded bundle is
// left in place for post-mortem, and the loaded flag stays 0.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _wfl_csr, _wfl_loaded, _wfl_alive_iters, and _wfl_stats are
// written only by helpers in this module.  tools/build.sh confines
// relocations against each to `core/drivers/wifi/fw_load.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF4C0..0xFFFFF4CF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: fw_verify
// 0xFFFFF4D0..DF, R38.M1-002; adjacent free band below: fw_compat
// 0xFFFFF4B0..BF, R38.M1-004).

module FwLoad = structure {

  // §1: synthetic CSR bank slot indices.
  pub let WFL_CSR_RESET       : u64 = 0
  pub let WFL_CSR_INT         : u64 = 1
  pub let WFL_CSR_HW_REV      : u64 = 2
  pub let WFL_CSR_UMAC_ADDR   : u64 = 3
  pub let WFL_CSR_UMAC_DIGEST : u64 = 4
  pub let WFL_CSR_MVM_ADDR    : u64 = 5
  pub let WFL_CSR_MVM_DIGEST  : u64 = 6
  pub let WFL_CSR_UPLOAD_SEQ  : u64 = 7

  pub let WFL_RESET_CPU_HALT  : u64 = 0x1
  pub let WFL_INT_INIT_ALIVE  : u64 = 0x1

  // On-chip SRAM destination addresses (bspec §7.3; scaffold
  // constants -- live driver reads them from the firmware bundle
  // header instead of pinning here).
  pub let WFL_SRAM_UMAC_BASE : u64 = 0x400000
  pub let WFL_SRAM_MVM_BASE  : u64 = 0x800000

  // §2: bounded wait for INIT_ALIVE.
  pub let WFL_ALIVE_MAX_ITERS : u64 = 0x100000       // 2^20 iterations

  // Failure taxonomy — 0xFFFFF4C0..0xFFFFF4CF.
  pub let WFL_OK              : u64 = 0
  pub let WFL_BAD_ARG         : u64 = 0xFFFFF4CF
  pub let WFL_NOT_VERIFIED    : u64 = 0xFFFFF4CE
  pub let WFL_NOT_COMPATIBLE  : u64 = 0xFFFFF4CD
  pub let WFL_UMAC_UPLOAD_FAIL: u64 = 0xFFFFF4CC
  pub let WFL_MVM_UPLOAD_FAIL : u64 = 0xFFFFF4CB
  pub let WFL_RESET_STUCK     : u64 = 0xFFFFF4CA
  pub let WFL_ALIVE_TIMEOUT   : u64 = 0xFFFFF4C9
  pub let WFL_ALREADY_LOADED  : u64 = 0xFFFFF4C8

  // §3: synthetic CSR bank (8 u32-in-u64 slots) + loaded flag +
  // observed alive-wait iteration count.
  pub let mut _wfl_csr          : [u64; 8] = uninit @align(64)
  pub let mut _wfl_loaded       : [u64; 1] = uninit @align(64)
  pub let mut _wfl_alive_iters  : [u64; 1] = uninit @align(64)

  // Counters.
  pub let mut _wfl_stats : [u64; 8] = uninit @align(64)

  pub let WFL_ST_LOADS     : u64 = 0
  pub let WFL_ST_TIMEOUTS  : u64 = 1
  pub let WFL_ST_REFUSED   : u64 = 2

  // ==========================================================================
  // Reset.
  //
  // Clears the CSR bank to power-on state (CPU_HALT asserted,
  // INIT_ALIVE clear, all other slots zero), clears the loaded flag
  // and the alive-iters counter, and zeros the stats vector.
  // ==========================================================================

  pub let wfl_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): clear CSR bank to power-on state (CPU_HALT set), clear loaded flag, alive-iters counter, and stats. Boot and teardown. Labels prefixed wfl_rs_.",
      block: {
        lea r10, [rip + _wfl_csr];
        xor rax, rax;
        xor rcx, rcx;
      wfl_rs_csr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wfl_rs_csr;

        // Set CSR_RESET.CPU_HALT (slot 0, bit 0).
        lea r10, [rip + _wfl_csr];
        mov rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;
        lea r10, [rip + _wfl_loaded];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfl_alive_iters];
        mov [r10 + 0], rax;

        lea r10, [rip + _wfl_stats];
        xor rcx, rcx;
      wfl_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wfl_rs_stats;
        ret
      }
    }

  // wfl_reset_load_state — clear only the CSR bank + loaded flag +
  // alive-iters (CSR_RESET.CPU_HALT re-armed).  Leaves _wfl_stats
  // untouched so a witness that reloads mid-run keeps the refusal /
  // timeout / load tallies it has accumulated.  Distinct from wfl_reset,
  // which is a full boot/teardown scrub that clears the stats too.
  pub let wfl_reset_load_state : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): reload-facing reset — CSR bank + loaded + alive-iters only, stats preserved. Labels prefixed wfl_rls_.",
      block: {
        lea r10, [rip + _wfl_csr];
        xor rax, rax;
        xor rcx, rcx;
      wfl_rls_csr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wfl_rls_csr;

        // Set CSR_RESET.CPU_HALT (slot 0, bit 0).
        lea r10, [rip + _wfl_csr];
        mov rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;
        lea r10, [rip + _wfl_loaded];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfl_alive_iters];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let wfl_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-003 (#1292): honesty pin. Returns 0 until a later round wires the upload/wait seams to a live AX211 DMA engine and interrupt line.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let wfl_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): counter bump. Labels prefixed wfl_nt_.",
      block: {
        cmp rdi, 8;
        jae wfl_nt_out;
        lea r10, [rip + _wfl_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wfl_nt_out:
        ret
      }
    }

  pub let wfl_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): counter read. Labels prefixed wfl_st_.",
      block: {
        cmp rdi, 8;
        jae wfl_st_zero;
        lea r10, [rip + _wfl_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wfl_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Synthetic CSR accessors (witness surface).
  //
  // wfl_csr_read(slot)               -> u64
  // wfl_csr_stamp_alive()            -> ()   pre-writes CSR_INT bit 0
  // wfl_csr_stamp_hw_rev(rev)        -> ()   pre-writes CSR_HW_REV
  //
  // A witness uses stamp_alive to model the "firmware is up" edge
  // between the reset release and the INIT_ALIVE poll; stamp_hw_rev
  // seeds the hardware id CSR so fw_compat can consume it through
  // the loaded flag path.
  // ==========================================================================

  pub let wfl_csr_read : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): read a CSR bank slot. Bounds-check refuses out-of-range with 0. Labels prefixed wfl_cr_.",
      block: {
        cmp rdi, 8;
        jae wfl_cr_zero;
        lea r10, [rip + _wfl_csr];
        mov rax, [r10 + rdi * 8];
        ret;
      wfl_cr_zero:
        xor rax, rax;
        ret
      }
    }

  pub let wfl_csr_stamp_alive : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): witness surface -- stamp CSR_INT.INIT_ALIVE. Labels prefixed wfl_sa_.",
      block: {
        lea r10, [rip + _wfl_csr];
        mov rax, [r10 + 8];              // CSR_INT
        or  rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let wfl_csr_stamp_hw_rev : (u64) -> () !{mem} @{} =
    fn (rev: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): witness surface -- stamp CSR_HW_REV. Labels prefixed wfl_sh_.",
      block: {
        lea r10, [rip + _wfl_csr];
        mov [r10 + 16], rdi;             // CSR_HW_REV
        ret
      }
    }

  // ==========================================================================
  // wfl_load(hw_rev) -> WFL_OK | error
  //
  // §0: THE ONE ENTRY POINT for AX211 firmware bring-up.  Order:
  //   1. Precondition: fw_verify has admitted a bundle this boot.
  //   2. Precondition: fw_compat approves the (hw_rev, bundle)
  //      pair.  hw_rev arrives from the caller (typically read out
  //      of ax211_probe's decoded id) rather than from the CSR
  //      bank -- keeping the compat check independent of the CSR
  //      seam this milestone.
  //   3. Not-already-loaded (a re-load without a scrub is refused;
  //      an operator that wants to reload runs wfl_reset first).
  //   4. Upload UMAC section: write section pointer to
  //      CSR_UMAC_ADDR + section digest to CSR_UMAC_DIGEST.
  //   5. Upload MVM section: same, at CSR_MVM_ADDR / CSR_MVM_DIGEST.
  //   6. Release CPU reset: clear CSR_RESET.CPU_HALT.  Refuses
  //      RESET_STUCK if the pre-write reset bit was somehow already
  //      clear.
  //   7. Poll CSR_INT.INIT_ALIVE with the bounded wait §2 sets.
  //      Records the observed iteration count in _wfl_alive_iters
  //      so a witness can prove the poll actually ran.  Refuses
  //      ALIVE_TIMEOUT on expiry (also re-asserts CPU_HALT).
  //   8. Bump CSR_UPLOAD_SEQ, set loaded=1, bump LOADS.
  // ==========================================================================

  pub let wfl_load : (u64) -> u64 !{mem} @{} =
    fn (hw_rev: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): AX211 firmware bring-up FSM. Verifies precondition gates, uploads UMAC+MVM sections via CSR seam, releases CPU reset, polls INIT_ALIVE with bounded wait, records. Labels prefixed wfl_l_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // hw_rev

        // 1. Verified.
        call wfv_is_verified;
        cmp rax, 1;
        jne wfl_l_not_verified;

        // 2. Compatible: wcm_check_pair(hw_rev, umac_len, mvm_len).
        //    fw_compat treats (umac_len, mvm_len) as a proxy for
        //    the bundle version -- the section extents are the
        //    coarsest immutable fingerprint the bundle carries.
        call wfv_umac_len_of;
        mov r13, rax;                    // umac_len

        call wfv_mvm_len_of;
        mov r14, rax;                    // mvm_len

        mov rdi, rbx;
        mov rsi, r13;
        mov rdx, r14;
        call wcm_check_pair;
        cmp rax, 0;
        jne wfl_l_not_compatible;

        // 3. Not-already-loaded.
        lea r10, [rip + _wfl_loaded];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne wfl_l_already;

        // 4. Upload UMAC.
        //    Compute a tiny digest = word0 XOR word1 of the UMAC
        //    section as it lives inside the blob.
        call wfv_blob_ptr_of;
        mov r12, rax;                    // blob_ptr

        call wfv_umac_off_of;
        add rax, r12;                    // blob_ptr + umac_off
        mov r10, rax;
        mov rax, [r10 + 0];
        mov rcx, [r10 + 8];
        xor rax, rcx;                    // digest

        lea r10, [rip + _wfl_csr];
        mov rcx, 0x400000;               // WFL_SRAM_UMAC_BASE
        mov [r10 + 24], rcx;             // CSR_UMAC_ADDR
        mov [r10 + 32], rax;             // CSR_UMAC_DIGEST

        // Verify echo -- catches a broken write path (a live driver
        // would compare the DMA completion status word here).
        mov rcx, [r10 + 24];
        cmp rcx, 0x400000;
        jne wfl_l_umac_fail;

        // 5. Upload MVM.
        call wfv_blob_ptr_of;
        mov r12, rax;

        call wfv_mvm_off_of;
        add rax, r12;
        mov r10, rax;
        mov rax, [r10 + 0];
        mov rcx, [r10 + 8];
        xor rax, rcx;

        lea r10, [rip + _wfl_csr];
        mov rcx, 0x800000;               // WFL_SRAM_MVM_BASE
        mov [r10 + 40], rcx;             // CSR_MVM_ADDR
        mov [r10 + 48], rax;             // CSR_MVM_DIGEST

        mov rcx, [r10 + 40];
        cmp rcx, 0x800000;
        jne wfl_l_mvm_fail;

        // 6. Release CPU reset.  Refuses RESET_STUCK if CPU_HALT
        //    was already clear (a live driver would treat this as
        //    "someone else already released; refuse to race").
        lea r10, [rip + _wfl_csr];
        mov rax, [r10 + 0];              // CSR_RESET
        mov rcx, rax;
        and rcx, 1;
        cmp rcx, 0;
        je  wfl_l_reset_stuck;
        and rax, 0xFFFFFFFFFFFFFFFE;     // clear bit 0
        mov [r10 + 0], rax;

        // 7. Poll INIT_ALIVE.
        xor r12, r12;                    // iteration counter
      wfl_l_poll:
        lea r10, [rip + _wfl_csr];
        mov rax, [r10 + 8];              // CSR_INT
        mov rcx, rax;
        and rcx, 1;
        cmp rcx, 0;
        jne wfl_l_alive_seen;
        add r12, 1;
        mov r10, 0x100000;               // WFL_ALIVE_MAX_ITERS
        cmp r12, r10;
        jb  wfl_l_poll;

        // Timeout: re-assert CPU_HALT, record iters, refuse.
        lea r10, [rip + _wfl_csr];
        mov rax, [r10 + 0];
        or  rax, 1;
        mov [r10 + 0], rax;
        lea r10, [rip + _wfl_alive_iters];
        mov [r10 + 0], r12;
        jmp wfl_l_timeout;

      wfl_l_alive_seen:
        lea r10, [rip + _wfl_alive_iters];
        mov [r10 + 0], r12;

        // 8. Bump upload seq, set loaded.
        lea r10, [rip + _wfl_csr];
        mov rax, [r10 + 56];             // CSR_UPLOAD_SEQ
        add rax, 1;
        mov [r10 + 56], rax;

        lea r10, [rip + _wfl_loaded];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // LOADS
        call wfl_note;
        xor rax, rax;
        jmp wfl_l_out;

      wfl_l_not_verified:
        mov rdi, 2;
        call wfl_note;
        mov rax, 0xFFFFF4CE;
        jmp wfl_l_out;
      wfl_l_not_compatible:
        mov rdi, 2;
        call wfl_note;
        mov rax, 0xFFFFF4CD;
        jmp wfl_l_out;
      wfl_l_already:
        mov rdi, 2;
        call wfl_note;
        mov rax, 0xFFFFF4C8;
        jmp wfl_l_out;
      wfl_l_umac_fail:
        mov rdi, 2;
        call wfl_note;
        mov rax, 0xFFFFF4CC;
        jmp wfl_l_out;
      wfl_l_mvm_fail:
        mov rdi, 2;
        call wfl_note;
        mov rax, 0xFFFFF4CB;
        jmp wfl_l_out;
      wfl_l_reset_stuck:
        mov rdi, 2;
        call wfl_note;
        mov rax, 0xFFFFF4CA;
        jmp wfl_l_out;
      wfl_l_timeout:
        mov rdi, 1;                      // TIMEOUTS
        call wfl_note;
        mov rdi, 2;
        call wfl_note;
        mov rax, 0xFFFFF4C9;

      wfl_l_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let wfl_is_loaded : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): 1 iff AX211 firmware has been loaded this boot. Labels prefixed wfl_il_.",
      block: {
        lea r10, [rip + _wfl_loaded];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let wfl_alive_iters_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-003 (#1292): recorded INIT_ALIVE poll iteration count. Labels prefixed wfl_ai_.",
      block: {
        lea r10, [rip + _wfl_alive_iters];
        mov rax, [r10 + 0];
        ret
      }
    }
}
