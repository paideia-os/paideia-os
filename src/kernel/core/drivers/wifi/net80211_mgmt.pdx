// src/kernel/core/drivers/wifi/net80211_mgmt.pdx — R38.M4-001 (#1304)
//
// 802.11 MANAGEMENT-FRAME encode/decode scaffold for the net80211
// class driver.  Every subsystem below this file (assoc / MLME /
// regulatory-domain gate) treats a frame as an already-encoded byte
// buffer; this module owns the ENCODE + DECODE of that buffer's
// header and Information Elements.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WIRE-FORMAT half of the net80211 class driver.  Live
// hardware never sees a `struct 80211_hdr`: the AX211 speaks TFDs
// (R38.M2 tx_dma) and the descriptor payload is the packed byte
// stream this module writes.  A caller that wants to send a Beacon
// asks this module to stage a frame, then hands the buffer to
// tx_dma.wtxd_enqueue.  A caller that wants to interpret a received
// frame reads its type + IEs through the decode helpers below.
//
// IT DOES NOT INITIATE OR RECEIVE A FRAME.  Composition with the
// transport is left to R38.M4-002 (assoc state machine) and above --
// this scaffold owns encoding + decoding a single frame at rest.
//
// IT DOES NOT VALIDATE CRYPTOGRAPHIC INTEGRITY.  MFP-protected MMPDUs
// carry a MIC computed with IGTK/BIP; that is R38.M4-003 (MLME +
// PMF).  Here the encoded bytes are the plaintext header + IE stream.
//
// nmg_arbitrated() returns 0 until R38.M4-002 composes this scaffold
// with a live radio (mgmt frames actually egress the transport).
//
// =============================================================================
// §1  FRAME LAYOUT -- 24-BYTE MAC HEADER + IE TAIL
// =============================================================================
//
//   [+0..2)    FC       frame_control (byte 0 = FC0, byte 1 = FC1)
//   [+2..4)    DUR      duration
//   [+4..10)   ADDR1    destination MAC (6 bytes)
//   [+10..16)  ADDR2    source MAC      (6 bytes)
//   [+16..22)  ADDR3    BSSID           (6 bytes)
//   [+22..24)  SEQCTL   seqno + fragno
//   [+24..)    IE tail  TLV stream: type(1) len(1) value(len)
//
// This scaffold stages one 256-byte frame in `_nmg_frame` and tracks
// the encode position in `_nmg_pos`.  A caller that needs a second
// concurrent frame builds it against a caller-supplied buffer through
// the raw byte helpers (nmg_ie_type_at etc take a byte pointer); the
// staged buffer is a driver-private convenience for the common case
// of "stage one, submit one".
//
// =============================================================================
// §2  IE TLV DISCIPLINE
// =============================================================================
//
// Each IE is `type(u8) len(u8) value(len bytes)`.  `nmg_ie_next` walks
// the stream refusing to advance past the buffer end (IE_TRUNCATED),
// so a corrupted length field cannot walk the decoder out of the
// buffer.  `nmg_ie_find` composes `nmg_ie_next` with a type match and
// returns IE_NOT_FOUND rather than surfacing the sentinel through the
// caller's type comparison.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// `_nmg_frame`, `_nmg_pos` and `_nmg_stats` are written only by
// helpers in this module.  tools/build.sh confines relocations
// against each symbol to `core/drivers/wifi/net80211_mgmt.o` so a
// second writer cannot forge a staged header or a decode counter.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF420..0xFFFFF42F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: none yet; adjacent free
// band below: net80211_assoc 0xFFFFF410..1F, R38.M4-002).

module Net80211Mgmt = structure {

  // §1: buffer geometry.
  pub let NMG_FRAME_CAP    : u64 = 256
  pub let NMG_HDR_LEN      : u64 = 24
  pub let NMG_IE_MIN_LEN   : u64 = 2                // type + len bytes

  // §1: frame_control byte-0 encodings (subtype[7:4] | type[3:2] |
  // proto_ver[1:0]).  Proto_ver = 0 always; type + subtype pin the
  // meaning.  These are the five this milestone recognises.
  pub let NMG_FRAME_BEACON      : u64 = 0x80        // mgmt, subtype 8
  pub let NMG_FRAME_PROBE_REQ   : u64 = 0x40        // mgmt, subtype 4
  pub let NMG_FRAME_PROBE_RESP  : u64 = 0x50        // mgmt, subtype 5
  pub let NMG_FRAME_ASSOC_REQ   : u64 = 0x00        // mgmt, subtype 0
  pub let NMG_FRAME_DEAUTH      : u64 = 0xC0        // mgmt, subtype 12

  // §2: IE type ids the class driver looks at directly.  The full
  // 802.11 IE table has ~250 entries; this scaffold names the three
  // WPA3-SAE association needs (SSID + rates + RSN).
  pub let NMG_IE_SSID   : u64 = 0
  pub let NMG_IE_RATES  : u64 = 1
  pub let NMG_IE_RSN    : u64 = 48

  // Sentinel values.
  pub let NMG_IE_NONE   : u64 = 0xFFFFFFFFFFFFFFFF

  // Failure taxonomy 0xFFFFF420..0xFFFFF42F.
  pub let NMG_OK             : u64 = 0
  pub let NMG_BAD_ARG        : u64 = 0xFFFFF42F
  pub let NMG_BAD_TYPE       : u64 = 0xFFFFF42E
  pub let NMG_BAD_OFFSET     : u64 = 0xFFFFF42D
  pub let NMG_IE_TRUNCATED   : u64 = 0xFFFFF42C
  pub let NMG_IE_NOT_FOUND   : u64 = 0xFFFFF42B
  pub let NMG_FRAME_FULL     : u64 = 0xFFFFF42A
  pub let NMG_NO_HDR         : u64 = 0xFFFFF429     // encode called before hdr_start

  // §3: the one writer's cells.
  pub let mut _nmg_frame : [u8; 256] = uninit @align(64)
  pub let mut _nmg_pos   : [u64; 1]  = uninit @align(64)
  pub let mut _nmg_stats : [u64; 8]  = uninit @align(64)

  // Stat slot indices.
  pub let NMG_STAT_HDR_ENCODES : u64 = 0
  pub let NMG_STAT_IE_APPENDS  : u64 = 1
  pub let NMG_STAT_DECODES     : u64 = 2
  pub let NMG_STAT_IE_WALKS    : u64 = 3
  pub let NMG_STAT_REFUSED     : u64 = 4
  pub let NMG_STAT_NOT_FOUND   : u64 = 5

  // ==========================================================================
  // Reset — clear staged frame + counters.  Boot + teardown.
  // ==========================================================================

  pub let nmg_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): clear staged frame, position, stats. Labels prefixed nmg_rs_.",
      block: {
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        xor rcx, rcx;
      nmg_rs_frm:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;                      // 256 bytes / 8
        jb  nmg_rs_frm;

        lea r10, [rip + _nmg_pos];
        mov [r10], rax;

        lea r10, [rip + _nmg_stats];
        xor rcx, rcx;
      nmg_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  nmg_rs_st;
        ret
      }
    } @no_frame

  pub let nmg_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M4-001 (#1304): honesty pin. Returns 0 until R38.M4-002 composes this scaffold with a live radio.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let nmg_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): counter bump. Labels prefixed nmg_nt_.",
      block: {
        cmp rdi, 8;
        jae nmg_nt_out;
        lea r10, [rip + _nmg_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      nmg_nt_out:
        ret
      }
    } @no_frame

  pub let nmg_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): counter read. Labels prefixed nmg_st_.",
      block: {
        cmp rdi, 8;
        jae nmg_st_zero;
        lea r10, [rip + _nmg_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      nmg_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let nmg_pos : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): read current encode position.",
      block: {
        lea r10, [rip + _nmg_pos];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Frame-type validator.  1 iff `fc0` is one of the five recognised
  // frame-control byte-0 encodings (Beacon / ProbeReq / ProbeResp /
  // AssocReq / Deauth).  A caller that wants to send an unrecognised
  // type has to widen this validator first; the encoder will refuse
  // otherwise with NMG_BAD_TYPE.
  // ==========================================================================

  pub let nmg_frame_valid_type : (u64) -> u64 !{} @{} =
    fn (fc0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M4-001 (#1304): recognise Beacon/ProbeReq/ProbeResp/AssocReq/Deauth. Labels prefixed nmg_ft_.",
      block: {
        cmp rdi, 0x80;                    // BEACON
        je  nmg_ft_yes;
        cmp rdi, 0x40;                    // PROBE_REQ
        je  nmg_ft_yes;
        cmp rdi, 0x50;                    // PROBE_RESP
        je  nmg_ft_yes;
        cmp rdi, 0x00;                    // ASSOC_REQ
        je  nmg_ft_yes;
        cmp rdi, 0xC0;                    // DEAUTH
        je  nmg_ft_yes;
        xor rax, rax;
        ret;
      nmg_ft_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // nmg_hdr_encode(frame_type_fc0, seqctl)
  //   -> NMG_OK | NMG_BAD_TYPE
  //
  // Writes the 24-byte MAC header into _nmg_frame at offset 0:
  //   FC0 = frame_type_fc0, FC1 = 0 (no flags this milestone)
  //   DUR = 0
  //   ADDR1 / ADDR2 / ADDR3 all zeroed (caller stamps via
  //     nmg_frame_write_addr helpers below or R38.M4-002 composes)
  //   SEQCTL = seqctl (low 16 bits)
  // Resets _nmg_pos to NMG_HDR_LEN (24) so IE append starts at the
  // correct offset.  Bumps HDR_ENCODES on admission.
  // ==========================================================================

  pub let nmg_hdr_encode : (u64, u64) -> u64 !{mem} @{} =
    fn (fc0: u64) (seqctl: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): stage 24-byte MAC header. Refuses unrecognised frame type before any write. Labels prefixed nmg_he_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;                     // fc0
        mov r12, rsi;                     // seqctl

        // Type gate.
        mov rdi, rbx;
        call nmg_frame_valid_type;
        cmp rax, 0;
        je  nmg_he_bad_type;

        // Zero the whole staged frame (256 bytes = 32 words).
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        xor rcx, rcx;
      nmg_he_zero:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  nmg_he_zero;

        // Stamp FC0 at byte 0.
        mov rax, rbx;
        mov_b [r10], rax;

        // Stamp SEQCTL at bytes 22..24 (low 16 bits).
        mov rax, r12;
        mov_b [r10 + 22], rax;
        mov rax, r12;
        shr rax, 8;
        mov_b [r10 + 23], rax;

        // Position = 24.
        lea r10, [rip + _nmg_pos];
        mov rax, 24;
        mov [r10], rax;

        mov rdi, 0;                       // HDR_ENCODES
        call nmg_note;
        xor rax, rax;
        pop r12;
        pop rbx;
        ret;

      nmg_he_bad_type:
        mov rdi, 4;                       // REFUSED
        call nmg_note;
        mov rax, 0xFFFFF42E;              // NMG_BAD_TYPE
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nmg_frame_byte_at(off) -> byte in low 8 bits, or 0xFF...FF if OOR.
  // ==========================================================================

  pub let nmg_frame_byte_at : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): read staged frame byte at offset. OOR returns sentinel. Labels prefixed nmg_ba_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae nmg_ba_oor;
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        mov_b rax, [r10 + rdi*1];
        ret;
      nmg_ba_oor:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let nmg_hdr_get_type : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): read FC0 from staged frame.",
      block: {
        mov rdi, 2;                       // NMG_STAT_DECODES
        call nmg_note;
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        mov_b rax, [r10];
        ret
      }
    }

  pub let nmg_hdr_get_seqctl : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): read SEQCTL (bytes 22..24) as u16.",
      block: {
        mov rdi, 2;                       // NMG_STAT_DECODES
        call nmg_note;
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        mov_b rax, [r10 + 23];
        shl rax, 8;
        xor rcx, rcx;
        mov_b rcx, [r10 + 22];
        or  rax, rcx;
        ret
      }
    }

  // ==========================================================================
  // nmg_ie_append(ie_type, ie_len, val_word)
  //   -> NMG_OK | NMG_NO_HDR | NMG_FRAME_FULL | NMG_BAD_ARG
  //
  // Appends one IE at the current write position.  This scaffold
  // supports ie_len in [0..8] with the value packed into the low
  // ie_len bytes of val_word (little-endian).  A caller that wants a
  // longer IE writes the bytes directly through nmg_frame_write_byte.
  //
  // Refuses if position < NMG_HDR_LEN (header not staged), if the
  // resulting position would exceed NMG_FRAME_CAP, or if ie_len > 8.
  // Bumps IE_APPENDS on admission.
  // ==========================================================================

  pub let nmg_ie_append : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ie_type: u64) (ie_len: u64) (val_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): append one IE TLV. Length capped at 8 for the packed val_word path. Labels prefixed nmg_ia_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        mov rbx, rdi;                     // ie_type (0..255)
        mov r12, rsi;                     // ie_len (0..8)
        mov r13, rdx;                     // val_word

        // ie_type in [0..255].
        cmp rbx, 255;
        ja  nmg_ia_bad_arg;

        // ie_len in [0..8].
        cmp r12, 8;
        ja  nmg_ia_bad_arg;

        // Position >= NMG_HDR_LEN?
        lea r10, [rip + _nmg_pos];
        mov r14, [r10];
        cmp r14, 24;
        jb  nmg_ia_no_hdr;

        // Room for 2 + ie_len bytes?
        mov rax, r14;
        add rax, 2;
        add rax, r12;
        cmp rax, 256;
        ja  nmg_ia_full;

        // Write type + length.
        lea r10, [rip + _nmg_frame];
        mov rax, rbx;
        mov_b [r10 + r14*1], rax;
        add r14, 1;
        mov rax, r12;
        mov_b [r10 + r14*1], rax;
        add r14, 1;

        // Write ie_len bytes of val_word, LE.
        mov rcx, 0;
      nmg_ia_bytes:
        cmp rcx, r12;
        jae nmg_ia_bytes_done;
        mov rax, r13;
        mov_b [r10 + r14*1], rax;
        add r14, 1;
        shr r13, 8;
        add rcx, 1;
        jmp nmg_ia_bytes;
      nmg_ia_bytes_done:

        // Save new position.
        lea r10, [rip + _nmg_pos];
        mov [r10], r14;

        mov rdi, 1;                       // IE_APPENDS
        call nmg_note;
        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      nmg_ia_bad_arg:
        mov rdi, 4;
        call nmg_note;
        mov rax, 0xFFFFF42F;              // NMG_BAD_ARG
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      nmg_ia_no_hdr:
        mov rdi, 4;
        call nmg_note;
        mov rax, 0xFFFFF429;              // NMG_NO_HDR
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      nmg_ia_full:
        mov rdi, 4;
        call nmg_note;
        mov rax, 0xFFFFF42A;              // NMG_FRAME_FULL
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nmg_ie_type_at(off) / nmg_ie_len_at(off)
  //   -> low 8 bits, or NMG_IE_NONE if off falls outside the IE tail
  //   (off < NMG_HDR_LEN or off+2 > _nmg_pos).
  // ==========================================================================

  pub let nmg_ie_type_at : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): read IE type byte at off. Refuses OOR. Labels prefixed nmg_it_.",
      block: {
        cmp rdi, 24;
        jb  nmg_it_bad;
        lea r10, [rip + _nmg_pos];
        mov rax, [r10];
        cmp rdi, rax;
        jae nmg_it_bad;
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        mov_b rax, [r10 + rdi*1];
        ret;
      nmg_it_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let nmg_ie_len_at : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): read IE length byte at off+1. Refuses OOR. Labels prefixed nmg_il_.",
      block: {
        cmp rdi, 24;
        jb  nmg_il_bad;
        mov rax, rdi;
        add rax, 1;
        lea r10, [rip + _nmg_pos];
        mov rcx, [r10];
        cmp rax, rcx;
        jae nmg_il_bad;
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        mov_b rax, [r10 + rdi*1 + 1];
        ret;
      nmg_il_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // nmg_ie_next(off) -> next_off | NMG_IE_TRUNCATED | NMG_IE_NOT_FOUND
  //
  // Given an IE offset, returns the offset of the next IE.  Refuses:
  //   * off < NMG_HDR_LEN (BAD_OFFSET)
  //   * off + 2 > _nmg_pos (IE_TRUNCATED -- header itself doesn't fit)
  //   * off + 2 + len > _nmg_pos (IE_TRUNCATED -- value doesn't fit)
  //   * next_off == _nmg_pos (IE_NOT_FOUND -- at end of stream)
  //
  // Bumps IE_WALKS on entry.
  // ==========================================================================

  pub let nmg_ie_next : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): walk to next IE. Refuses truncated stream. Labels prefixed nmg_in_.",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rdi, 3;                       // IE_WALKS
        call nmg_note;

        // off < 24?
        cmp rbx, 24;
        jb  nmg_in_bad_off;

        // off + 2 > pos?
        lea r10, [rip + _nmg_pos];
        mov r11, [r10];
        mov rax, rbx;
        add rax, 2;
        cmp rax, r11;
        ja  nmg_in_trunc;

        // len = frame[off + 1].
        lea r10, [rip + _nmg_frame];
        xor rcx, rcx;
        mov_b rcx, [r10 + rbx*1 + 1];

        // next_off = off + 2 + len.
        mov rax, rbx;
        add rax, 2;
        add rax, rcx;
        cmp rax, r11;
        ja  nmg_in_trunc;

        // next_off == pos -> NOT_FOUND (end of stream).
        cmp rax, r11;
        je  nmg_in_not_found;

        pop rbx;
        ret;

      nmg_in_bad_off:
        mov rdi, 4;
        call nmg_note;
        mov rax, 0xFFFFF42D;              // NMG_BAD_OFFSET
        pop rbx;
        ret;
      nmg_in_trunc:
        mov rdi, 4;
        call nmg_note;
        mov rax, 0xFFFFF42C;              // NMG_IE_TRUNCATED
        pop rbx;
        ret;
      nmg_in_not_found:
        mov rdi, 5;                       // NOT_FOUND
        call nmg_note;
        mov rax, 0xFFFFF42B;              // NMG_IE_NOT_FOUND
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nmg_ie_find(ie_type)
  //   -> off | NMG_IE_NOT_FOUND | NMG_IE_TRUNCATED | NMG_BAD_OFFSET
  //
  // Walks the IE tail starting at NMG_HDR_LEN looking for the first
  // IE whose type byte matches.  Composition of nmg_ie_next + a type
  // compare so the truncation-refusal discipline is checked once, in
  // one place, by every consumer.
  // ==========================================================================

  pub let nmg_ie_find : (u64) -> u64 !{mem} @{} =
    fn (ie_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-001 (#1304): find first IE with matching type. Truncation refuse-gate is nmg_ie_next. Labels prefixed nmg_if_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;                     // wanted ie_type
        mov r12, 24;                      // walking offset

      nmg_if_loop:
        // Check bounds: offset + 2 within pos?  If not -> NOT_FOUND.
        lea r10, [rip + _nmg_pos];
        mov r11, [r10];
        mov rax, r12;
        add rax, 2;
        cmp rax, r11;
        ja  nmg_if_end;

        // Compare type byte.
        lea r10, [rip + _nmg_frame];
        xor rax, rax;
        mov_b rax, [r10 + r12*1];
        cmp rax, rbx;
        jne nmg_if_step;

        // Match.
        mov rax, r12;
        pop r12;
        pop rbx;
        ret;

      nmg_if_step:
        // Advance via nmg_ie_next.  If it refuses, propagate.
        mov rdi, r12;
        call nmg_ie_next;
        // NOT_FOUND / TRUNCATED / BAD_OFFSET propagate.
        mov r10, 0xFFFFF420;
        cmp rax, r10;
        jae nmg_if_prop;
        mov r12, rax;
        jmp nmg_if_loop;

      nmg_if_end:
        mov rdi, 5;                       // NOT_FOUND
        call nmg_note;
        mov rax, 0xFFFFF42B;
        pop r12;
        pop rbx;
        ret;

      nmg_if_prop:
        pop r12;
        pop rbx;
        ret
      }
    }
}
