// src/kernel/core/drivers/wifi/ax211_probe.pdx — R38.M1-001 (#1289)
//
// Intel AX211 (iwlwifi-equivalent) PCI PROBE + BAR mapping scaffold.
// Opens R38.M1 (WiFi bring-up).  Recognises the Network Controller
// class code (0x02, 0x80), filters candidates by Intel vendor
// (0x8086) and the AX211 device family (0x51F0, 0x54F0), refuses a
// BAR0 whose extent is less than 1 MB or misaligned, and stages the
// caller-provided CSR_HW_REV register snapshot so a later mint of
// KIND_WIFI_DEV (R38.M3+) can containment-check the window without
// re-consulting firmware.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNISE + RECORD half of an AX211 bring-up.  A PCIe
// function whose class/subclass triple is (0x02, 0x80, *) is a
// Network Controller / Other Network Controller per the PCI SIG
// registry; filtered by Intel vendor 0x8086 and one of the AX211
// device ids, this scaffold distills the vendor/device pair the
// enumerator saw, validates the BAR0 window (1 MB minimum, 64 KiB
// aligned per the iwlwifi driver's own extent expectation), and
// stashes the hardware id/revision decoded from a caller-supplied
// CSR_HW_REV word.
//
// IT DOES NOT TOUCH REAL MMIO.  The chip revision word arrives
// through the parameter list this milestone.  R38.M2 wires the seam
// to a live BAR0 read; the substitution is a one-line change here
// (the recognise entry takes a caps snapshot exactly as
// iris_xe_probe does).
//
// IT DOES NOT MINT KIND_WIFI_DEV.  That is the mint gate the R38.M3
// bring-up path takes once the BAR is measured through a live
// memory authority; this scaffold records the EXTENTS so that mint
// can containment-check its request without re-asking the firmware.
//
// axp_probe_arbitrated() returns 0 until R38.M3 binds a live BAR
// read against this seam.
//
// =============================================================================
// §1  PCI CLASSIFICATION (PCI SIG code registry)
// =============================================================================
//
//   base class 0x02  Network Controller
//   subclass  0x80  Other Network Controller  (Intel WiFi cores)
//
// Class pair packed as (class << 8) | subclass = 0x0280.
//
// Vendor filter: 0x8086 (Intel).  Device ids the AX211 family
// enumerates on shipping T14 G4 boards:
//
//   0x51F0  AX211 (Alder Lake-P integrated)
//   0x51F1  AX211 (Alder Lake-N integrated)
//   0x54F0  AX211 (Raptor Lake-U integrated)
//
// Every other device id under the Intel WiFi range is REFUSED as
// BAD_FAMILY rather than optimistically accepted -- an AX210 or an
// AX201 uses a different firmware family and a probe that admitted
// it would ship a mismatched image the fw_compat gate (R38.M1-004)
// would only catch after fw_verify had already recorded it.
//
// BAR0 alignment: 64 KiB minimum (the iwlwifi driver expects a
// 1 MB window whose base is 64 KiB aligned; larger alignments are
// accepted, smaller are refused as MISALIGNED).
//
// BAR0 length: 1 MB minimum.  A shorter window cannot hold the
// UMAC+MVM CSR block plus scratch SRAM the firmware handshake
// (R38.M1-003) writes into.
//
// =============================================================================
// §2  CSR_HW_REV LAYOUT (iwlwifi documented at drv/csr.h)
// =============================================================================
//
//   CSR_HW_REV_TYPE_MASK       0x000FFF00   ("chip type" nibble)
//   CSR_HW_REV_STEP_MASK       0x0000000C   ("stepping" — A0, B0, ...)
//   CSR_HW_REV_DASH_MASK       0x00000003   ("dash" revision)
//
// A caps word of zero refuses as BAD_CAPS (the caller either did
// not read the register or read it before the chip finished
// bringing up its rev block); a chip-type nibble of zero refuses as
// BAD_HW_TYPE for the same reason.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _axp_probe_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/wifi/ax211_probe.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF4E0..0xFFFFF4EF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: gpu_stress
// 0xFFFFF4F0..FF; adjacent free band below: fw_verify
// 0xFFFFF4D0..DF, R38.M1-002).

module Ax211Probe = structure {

  // PCI classification (§1).
  pub let AXP_PCI_CLASS_NETWORK      : u64 = 0x02
  pub let AXP_PCI_SUBCLASS_OTHER_NET : u64 = 0x80
  pub let AXP_PCI_CLASS_PAIR         : u64 = 0x0280

  // Accepted vendor set.
  pub let AXP_VENDOR_INTEL : u64 = 0x8086

  // Accepted device ids (§1).
  pub let AXP_DEV_51F0 : u64 = 0x51F0
  pub let AXP_DEV_51F1 : u64 = 0x51F1
  pub let AXP_DEV_54F0 : u64 = 0x54F0

  // BAR0 shape (§1).
  pub let AXP_BAR0_ALIGN_MASK : u64 = 0xFFFF        // 64 KiB align
  pub let AXP_BAR0_MIN_LEN    : u64 = 0x100000      // 1 MB

  // CSR_HW_REV decode (§2).
  pub let AXP_HW_TYPE_MASK  : u64 = 0x000FFF00
  pub let AXP_HW_TYPE_SHIFT : u64 = 8
  pub let AXP_HW_STEP_MASK  : u64 = 0x0000000C
  pub let AXP_HW_STEP_SHIFT : u64 = 2
  pub let AXP_HW_DASH_MASK  : u64 = 0x00000003

  // Failure taxonomy — 0xFFFFF4E0..0xFFFFF4EF.
  pub let AXP_OK             : u64 = 0
  pub let AXP_BAD_ARG        : u64 = 0xFFFFF4EF
  pub let AXP_BAD_CLASS      : u64 = 0xFFFFF4EE
  pub let AXP_BAD_VENDOR     : u64 = 0xFFFFF4ED
  pub let AXP_BAD_FAMILY     : u64 = 0xFFFFF4EC
  pub let AXP_BAD_BAR0       : u64 = 0xFFFFF4EB
  pub let AXP_MISALIGNED     : u64 = 0xFFFFF4EA
  pub let AXP_BAD_CAPS       : u64 = 0xFFFFF4E9
  pub let AXP_BAD_HW_TYPE    : u64 = 0xFFFFF4E8

  pub let mut _axp_probe_stats : [u64; 8] = uninit @align(64)

  pub let AXP_ST_ATTEMPTS : u64 = 0
  pub let AXP_ST_MATCHED  : u64 = 1
  pub let AXP_ST_REJECTS  : u64 = 2
  pub let AXP_ST_ALIGNED  : u64 = 3
  pub let AXP_ST_TYPE     : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let axp_probe_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-001 (#1289): clear stats. Labels prefixed axp_rs_.",
      block: {
        lea r10, [rip + _axp_probe_stats];
        xor rax, rax;
        xor rcx, rcx;
      axp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  axp_rs_loop;
        ret
      }
    } @no_frame

  pub let axp_probe_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): honesty pin. Returns 0 until R38.M3 binds this against a live PCIe AX211 BAR window.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let axp_probe_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-001 (#1289): counter read. Labels prefixed axp_st_.",
      block: {
        cmp rdi, 8;
        jae axp_st_zero;
        lea r10, [rip + _axp_probe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      axp_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let axp_probe_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-001 (#1289): counter bump. Labels prefixed axp_nt_.",
      block: {
        cmp rdi, 8;
        jae axp_nt_out;
        lea r10, [rip + _axp_probe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      axp_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let axp_class_valid : (u64) -> u64 !{} @{} =
    fn (class_pair: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): 1 iff class_pair == 0x0280 (Network / Other). Labels prefixed axp_cv_.",
      block: {
        mov r10, 0x0280;
        cmp rdi, r10;
        jne axp_cv_no;
        mov rax, 1;
        ret;
      axp_cv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let axp_vendor_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): 1 iff v == 0x8086 Intel. Labels prefixed axp_vv_.",
      block: {
        cmp rdi, 0x8086;
        je  axp_vv_yes;
        xor rax, rax;
        ret;
      axp_vv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let axp_family_valid : (u64) -> u64 !{} @{} =
    fn (device_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): 1 iff device_id in {0x51F0, 0x51F1, 0x54F0}. Labels prefixed axp_fv_.",
      block: {
        cmp rdi, 0x51F0;
        je  axp_fv_yes;
        cmp rdi, 0x51F1;
        je  axp_fv_yes;
        cmp rdi, 0x54F0;
        je  axp_fv_yes;
        xor rax, rax;
        ret;
      axp_fv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let axp_bar0_aligned : (u64) -> u64 !{} @{} =
    fn (bar_base: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): 1 iff (bar_base & 0xFFFF) == 0 (64 KiB alignment). Labels prefixed axp_ba_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        cmp rax, 0;
        jne axp_ba_no;
        mov rax, 1;
        ret;
      axp_ba_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let axp_bar0_len_ok : (u64) -> u64 !{} @{} =
    fn (bar_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): 1 iff bar_len >= 1 MB. Labels prefixed axp_bl_.",
      block: {
        mov r10, 0x100000;
        cmp rdi, r10;
        jb  axp_bl_no;
        mov rax, 1;
        ret;
      axp_bl_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Decode CSR_HW_REV (§2).
  // ==========================================================================

  pub let axp_decode_hw_type : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): extract chip-type nibble (caps[19:8]) shifted right. Labels prefixed axp_dt_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFF;
        ret
      }
    } @no_frame

  pub let axp_decode_hw_step : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): extract stepping bits (caps[3:2]). Labels prefixed axp_ds_.",
      block: {
        mov rax, rdi;
        shr rax, 2;
        and rax, 0x3;
        ret
      }
    } @no_frame

  pub let axp_decode_hw_dash : (u64) -> u64 !{} @{} =
    fn (caps: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-001 (#1289): extract dash bits (caps[1:0]). Labels prefixed axp_dd_.",
      block: {
        mov rax, rdi;
        and rax, 0x3;
        ret
      }
    } @no_frame

  // ==========================================================================
  // axp_probe_recognise(class_pair, vendor, device_id, bar0_base,
  //                     bar0_len, caps)
  //   -> hw_type[15:0] | (step << 16) | (dash << 24) | err
  //
  // Six-arg entry, calling convention identical to
  // ixp_probe_recognise (three integer args pass in registers, three
  // stashed to callee-save through rbp).  Sequence:
  //   1. class pair == 0x0280
  //   2. vendor in accepted set
  //   3. device id in accepted family set
  //   4. bar0_base > 0, bar0_len >= 1 MB
  //   5. bar0_base 64 KiB aligned
  //   6. caps non-zero
  //   7. chip type non-zero
  //
  // Every accepted probe bumps MATCHED + ALIGNED + TYPE.  Every
  // refusal bumps REJECTS.
  // ==========================================================================

  pub let axp_probe_recognise : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (class_pair: u64) (vendor: u64) (device_id: u64) (bar0_base: u64) (bar0_len: u64) (caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-001 (#1289): recognise an Intel AX211 WiFi controller. Six args stashed to five callee-save regs plus rbp. Sequence per header. Returns hw_type | (step << 16) | (dash << 24). Labels prefixed axp_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // class_pair
        mov r12, rsi;                    // vendor
        mov r13, rdx;                    // device_id
        mov r14, rcx;                    // bar0_base
        mov r15, r8;                     // bar0_len
        mov rbp, r9;                     // caps

        mov rdi, 0;                      // ATTEMPTS
        call axp_probe_note;

        // 1. class pair.
        mov rdi, rbx;
        call axp_class_valid;
        cmp rax, 0;
        je  axp_rc_bad_class;

        // 2. vendor.
        mov rdi, r12;
        call axp_vendor_valid;
        cmp rax, 0;
        je  axp_rc_bad_vendor;

        // 3. device family.
        mov rdi, r13;
        call axp_family_valid;
        cmp rax, 0;
        je  axp_rc_bad_family;

        // 4. BAR0 base + length.
        cmp r14, 0;
        je  axp_rc_bad_bar0;
        mov rdi, r15;
        call axp_bar0_len_ok;
        cmp rax, 0;
        je  axp_rc_bad_bar0;

        // 5. Alignment.
        mov rdi, r14;
        call axp_bar0_aligned;
        cmp rax, 0;
        je  axp_rc_misaligned;
        mov rdi, 3;                      // ALIGNED
        call axp_probe_note;

        // 6. caps non-zero.
        cmp rbp, 0;
        je  axp_rc_bad_caps;

        // 7. hw type non-zero.
        mov rdi, rbp;
        call axp_decode_hw_type;
        cmp rax, 0;
        je  axp_rc_bad_hw_type;
        mov rbx, rax;                    // hw_type (stashed)
        mov rdi, 4;                      // TYPE
        call axp_probe_note;

        // Decode step + dash for packing.
        mov rdi, rbp;
        call axp_decode_hw_step;
        mov r12, rax;                    // step

        mov rdi, rbp;
        call axp_decode_hw_dash;
        mov r13, rax;                    // dash

        // MATCHED.
        mov rdi, 1;
        call axp_probe_note;

        // Pack hw_type | (step << 16) | (dash << 24).
        mov rax, rbx;
        and rax, 0xFFFF;
        mov r10, r12;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, r13;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        jmp axp_rc_out;

      axp_rc_bad_class:
        mov rdi, 2;
        call axp_probe_note;
        mov rax, 0xFFFFF4EE;
        jmp axp_rc_out;
      axp_rc_bad_vendor:
        mov rdi, 2;
        call axp_probe_note;
        mov rax, 0xFFFFF4ED;
        jmp axp_rc_out;
      axp_rc_bad_family:
        mov rdi, 2;
        call axp_probe_note;
        mov rax, 0xFFFFF4EC;
        jmp axp_rc_out;
      axp_rc_bad_bar0:
        mov rdi, 2;
        call axp_probe_note;
        mov rax, 0xFFFFF4EB;
        jmp axp_rc_out;
      axp_rc_misaligned:
        mov rdi, 2;
        call axp_probe_note;
        mov rax, 0xFFFFF4EA;
        jmp axp_rc_out;
      axp_rc_bad_caps:
        mov rdi, 2;
        call axp_probe_note;
        mov rax, 0xFFFFF4E9;
        jmp axp_rc_out;
      axp_rc_bad_hw_type:
        mov rdi, 2;
        call axp_probe_note;
        mov rax, 0xFFFFF4E8;

      axp_rc_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
