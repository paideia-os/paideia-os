// src/kernel/core/drivers/wifi/wpa3_sae.pdx — R38.M5-002 (#1310)
//
// WPA3 SAE (Simultaneous Authentication of Equals) state machine per
// RFC 7664 / 802.11-2020 §12.4.  Governs the two-round commit/confirm
// exchange between two peers proving mutual knowledge of a shared
// password, without either peer transmitting the password or a
// hash-and-slam derivative from it.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the POLICY / STATE half of SAE.  A live path composes: the
// mgmt-frame layer (R38.M4-001) delivers a SAE commit / confirm
// element; this module admits or refuses the transition against the
// FSM; the KIND_WIFI_KEY (R38.M5-001) records the derived PMK once
// ACCEPTED.
//
// IT DOES NOT COMPUTE THE ECC POINT.  hash-to-element and the
// hunting-and-pecking password-to-curve mapping are the crypto
// server's (R32) business; here the commit-element payload is an
// opaque u64 the caller passes through, and sae_arbitrated() reports
// 0 until R32 wires the real curve arithmetic.
//
// IT DOES NOT COMPUTE THE KCK-BASED CONFIRM.  Same argument: the
// confirm value is an opaque u64 the caller supplies; the FSM checks
// that it matches the one the peer sent, and admits the transition.
//
// The four states + refuse-taxonomy is what the module OWNS.
//
// =============================================================================
// §1  STATES  (RFC 7664 §3.2, 802.11-2020 §12.4.7)
// =============================================================================
//
//   SAE_INIT      (0) -- no exchange in flight.
//   SAE_COMMITTED (1) -- local commit sent, awaiting peer commit.
//   SAE_CONFIRMED (2) -- both commits exchanged, awaiting peer confirm.
//   SAE_ACCEPTED  (3) -- both confirms exchanged; PMK derived.
//   SAE_FAILED    (4) -- bad confirm / invalid transition; reset req'd.
//
// Legal transitions:
//   INIT      + start(local_commit)                -> COMMITTED
//   COMMITTED + peer_commit(peer_scalar)           -> CONFIRMED
//   CONFIRMED + peer_confirm(kck_value)  [match]   -> ACCEPTED
//   CONFIRMED + peer_confirm(kck_value)  [mismatch]-> FAILED
//   * (except INIT) + reset()                      -> INIT
//   FAILED + start(*)                              -> refuse BUSY (reset)
//   ACCEPTED + start(*)                            -> refuse BUSY (reset)
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// `_sae_state` and `_sae_stats` are written only by helpers in this
// module.  tools/build.sh confines relocations against both symbols
// to `core/drivers/wifi/wpa3_sae.o` so a second writer cannot
// silently forge an SAE transition.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF3D0..0xFFFFF3DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: KIND_WIFI_KEY
// 0xFFFFF3E0..EF; adjacent free band below: wpa_4way 0xFFFFF3C0..CF).

module Wpa3Sae = structure {

  // §1 states.
  pub let SAE_INIT       : u64 = 0
  pub let SAE_COMMITTED  : u64 = 1
  pub let SAE_CONFIRMED  : u64 = 2
  pub let SAE_ACCEPTED   : u64 = 3
  pub let SAE_FAILED     : u64 = 4
  pub let SAE_STATE_MAX  : u64 = 4

  // Failure taxonomy 0xFFFFF3D0..0xFFFFF3DF.
  pub let SAE_OK                  : u64 = 0
  pub let SAE_BAD_ARG             : u64 = 0xFFFFF3DF
  pub let SAE_BAD_STATE           : u64 = 0xFFFFF3DE
  pub let SAE_ZERO_COMMIT         : u64 = 0xFFFFF3DD
  pub let SAE_ZERO_CONFIRM        : u64 = 0xFFFFF3DC
  pub let SAE_ZERO_SCALAR         : u64 = 0xFFFFF3DB
  pub let SAE_CONFIRM_MISMATCH    : u64 = 0xFFFFF3DA
  pub let SAE_BUSY                : u64 = 0xFFFFF3D9    // start while != INIT
  pub let SAE_INVALID_TRANSITION  : u64 = 0xFFFFF3D8

  // §2: state cell layout.
  //   [0] state
  //   [1] local_commit
  //   [2] peer_scalar (received in peer commit)
  //   [3] expected_confirm (KCK-derived, set when transitioning to CONFIRMED)
  pub let mut _sae_state : [u64; 4] = uninit @align(64)
  pub let mut _sae_stats : [u64; 8] = uninit @align(64)

  pub let SAE_STAT_COMMITS        : u64 = 0
  pub let SAE_STAT_PEER_COMMITS   : u64 = 1
  pub let SAE_STAT_CONFIRMS       : u64 = 2
  pub let SAE_STAT_ACCEPTS        : u64 = 3
  pub let SAE_STAT_FAILS          : u64 = 4
  pub let SAE_STAT_REFUSED        : u64 = 5
  pub let SAE_STAT_RESETS         : u64 = 6
  pub let SAE_STAT_TRANSITIONS    : u64 = 7

  // ==========================================================================
  // Reset -- state INIT, all fields cleared.  Boot + teardown + retry.
  // ==========================================================================

  pub let sae_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): clear state + stats. Labels prefixed sae_rs_.",
      block: {
        lea r10, [rip + _sae_state];
        xor rax, rax;
        xor rcx, rcx;
      sae_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  sae_rs_st;

        lea r10, [rip + _sae_stats];
        xor rcx, rcx;
      sae_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sae_rs_ct;
        ret
      }
    } @no_frame

  pub let sae_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M5-002 (#1310): honesty pin. Returns 0 until R32 crypto server wires real ECC point + KCK verification behind sae_start / sae_peer_commit / sae_peer_confirm.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sae_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): counter bump. Labels prefixed sae_nt_.",
      block: {
        cmp rdi, 8;
        jae sae_nt_out;
        lea r10, [rip + _sae_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sae_nt_out:
        ret
      }
    } @no_frame

  pub let sae_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): counter read. Labels prefixed sae_st_.",
      block: {
        cmp rdi, 8;
        jae sae_st_zero;
        lea r10, [rip + _sae_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sae_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Getters.
  // ==========================================================================

  pub let sae_state : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): read state.",
      block: {
        lea r10, [rip + _sae_state];
        mov rax, [r10];
        ret
      }
    } @no_frame

  pub let sae_local_commit : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): read local commit.",
      block: {
        lea r10, [rip + _sae_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let sae_peer_scalar_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): read peer commit scalar.",
      block: {
        lea r10, [rip + _sae_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let sae_expected_confirm : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): read expected confirm value.",
      block: {
        lea r10, [rip + _sae_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  // ==========================================================================
  // sae_start(local_commit) -> SAE_OK | error
  //
  // Refuses:
  //   * local_commit == 0     -> SAE_ZERO_COMMIT
  //   * state != INIT         -> SAE_BUSY  (caller must reset first)
  //
  // Stores local_commit, sets state = COMMITTED.  Bumps COMMITS + TRANS.
  // ==========================================================================

  pub let sae_start : (u64) -> u64 !{mem} @{} =
    fn (local_commit: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): begin SAE exchange (INIT -> COMMITTED). Labels prefixed sae_ss_.",
      block: {
        cmp rdi, 0;
        je  sae_ss_zero;

        lea r10, [rip + _sae_state];
        mov rax, [r10];
        cmp rax, 0;                       // INIT?
        jne sae_ss_busy;

        mov [r10 + 8], rdi;               // local_commit
        mov rax, 1;                       // COMMITTED
        mov [r10], rax;

        push rdi;
        mov rdi, 0;                       // COMMITS
        call sae_note;
        mov rdi, 7;                       // TRANSITIONS
        call sae_note;
        pop rdi;
        xor rax, rax;
        ret;

      sae_ss_zero:
        mov rdi, 5;
        call sae_note;
        mov rax, 0xFFFFF3DD;              // ZERO_COMMIT
        ret;
      sae_ss_busy:
        mov rdi, 5;
        call sae_note;
        mov rax, 0xFFFFF3D9;              // BUSY
        ret
      }
    }

  // ==========================================================================
  // sae_peer_commit(peer_scalar, expected_confirm) -> SAE_OK | error
  //
  // The peer commit element arrives with a scalar (the peer's ECC
  // point).  In a live path the ECC output feeds into the KCK
  // derivation, whose next-round MIC is the expected_confirm value we
  // stash for the CONFIRMED step; here we take BOTH values as opaque
  // arguments because the derivation is R32's business.
  //
  // Refuses:
  //   * peer_scalar == 0            -> SAE_ZERO_SCALAR
  //   * expected_confirm == 0       -> SAE_ZERO_CONFIRM
  //   * state != COMMITTED          -> SAE_INVALID_TRANSITION
  //
  // Stores peer_scalar + expected_confirm, sets state = CONFIRMED.
  // ==========================================================================

  pub let sae_peer_commit : (u64, u64) -> u64 !{mem} @{} =
    fn (peer_scalar: u64) (expected_confirm: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): accept peer commit (COMMITTED -> CONFIRMED). Labels prefixed sae_pc_.",
      block: {
        cmp rdi, 0;
        je  sae_pc_zero_scalar;
        cmp rsi, 0;
        je  sae_pc_zero_confirm;

        lea r10, [rip + _sae_state];
        mov rax, [r10];
        cmp rax, 1;                       // COMMITTED?
        jne sae_pc_bad_state;

        mov [r10 + 16], rdi;              // peer_scalar
        mov [r10 + 24], rsi;              // expected_confirm
        mov rax, 2;                       // CONFIRMED
        mov [r10], rax;

        push rdi;
        push rsi;
        mov rdi, 1;                       // PEER_COMMITS
        call sae_note;
        mov rdi, 7;                       // TRANSITIONS
        call sae_note;
        pop rsi;
        pop rdi;
        xor rax, rax;
        ret;

      sae_pc_zero_scalar:
        mov rdi, 5;
        call sae_note;
        mov rax, 0xFFFFF3DB;              // ZERO_SCALAR
        ret;
      sae_pc_zero_confirm:
        mov rdi, 5;
        call sae_note;
        mov rax, 0xFFFFF3DC;              // ZERO_CONFIRM
        ret;
      sae_pc_bad_state:
        mov rdi, 5;
        call sae_note;
        mov rax, 0xFFFFF3D8;              // INVALID_TRANSITION
        ret
      }
    }

  // ==========================================================================
  // sae_peer_confirm(kck_value) -> SAE_OK | error
  //
  // The peer confirm element arrives with a KCK-based MIC.  A live
  // path verifies the MIC with the KCK derived from the ECC scalar +
  // both parties' commits; here we compare the supplied kck_value
  // against the expected_confirm stashed in the peer_commit step.
  //
  // Refuses:
  //   * kck_value == 0                       -> SAE_ZERO_CONFIRM
  //   * state != CONFIRMED                   -> SAE_INVALID_TRANSITION
  //   * kck_value != expected_confirm        -> SAE_CONFIRM_MISMATCH
  //                                             (transitions to FAILED)
  //
  // On MATCH: state -> ACCEPTED, bumps ACCEPTS + CONFIRMS + TRANS.
  // On MISMATCH: state -> FAILED, bumps FAILS + REFUSED, returns
  // CONFIRM_MISMATCH.
  // ==========================================================================

  pub let sae_peer_confirm : (u64) -> u64 !{mem} @{} =
    fn (kck_value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-002 (#1310): verify peer confirm (CONFIRMED -> ACCEPTED / FAILED). Labels prefixed sae_pf_.",
      block: {
        push rbx;
        mov rbx, rdi;

        cmp rbx, 0;
        je  sae_pf_zero;

        lea r10, [rip + _sae_state];
        mov rax, [r10];
        cmp rax, 2;                       // CONFIRMED?
        jne sae_pf_bad_state;

        mov rax, [r10 + 24];              // expected_confirm
        cmp rax, rbx;
        jne sae_pf_mismatch;

        // MATCH: -> ACCEPTED.
        mov rax, 3;                       // ACCEPTED
        mov [r10], rax;

        mov rdi, 2;                       // CONFIRMS
        call sae_note;
        mov rdi, 3;                       // ACCEPTS
        call sae_note;
        mov rdi, 7;                       // TRANSITIONS
        call sae_note;
        xor rax, rax;
        pop rbx;
        ret;

      sae_pf_zero:
        mov rdi, 5;
        call sae_note;
        mov rax, 0xFFFFF3DC;              // ZERO_CONFIRM
        pop rbx;
        ret;
      sae_pf_bad_state:
        mov rdi, 5;
        call sae_note;
        mov rax, 0xFFFFF3D8;              // INVALID_TRANSITION
        pop rbx;
        ret;
      sae_pf_mismatch:
        // Transition to FAILED.
        lea r10, [rip + _sae_state];
        mov rax, 4;                       // FAILED
        mov [r10], rax;
        mov rdi, 4;                       // FAILS
        call sae_note;
        mov rdi, 5;                       // REFUSED
        call sae_note;
        mov rdi, 7;                       // TRANSITIONS
        call sae_note;
        mov rax, 0xFFFFF3DA;              // CONFIRM_MISMATCH
        pop rbx;
        ret
      }
    }
}
