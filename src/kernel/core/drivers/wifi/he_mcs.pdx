// src/kernel/core/drivers/wifi/he_mcs.pdx — R38.M7-001 (#1318)
//
// 802.11ax HE (High Efficiency) rate framework.  MCS index 0..11
// (adds the 1024-QAM tier over 802.11ac's 0..9) plus a MU-MIMO
// group/user metadata table.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RATE-TABLE + MU-MIMO METADATA half of the AX211 HE PHY
// binding.  A live path composes:
//
//   he_mcs.hem_rate_lookup(mcs, bw, gi, nss)  -> peak Mbps
//   rate_control.rc2_report()                 -> {peer, MCS} PER
//   rate_control.rc2_decide()                 -> next MCS
//   ...radio driver programs the AX211 rate register
//
// IT DOES NOT PROGRAM THE PHY.  A live path replaces the (kept)
// hem_arbitrated() = 0 pin with a real MAC/PHY write against the
// CNVi transport once that binding lands.  Here the table is a
// compile-time truth about the standard, and the MU-MIMO rows are
// software metadata the class driver consults before it stitches an
// A-MPDU group together.
//
// IT DOES NOT DECIDE WHICH MCS TO USE.  That is rate_control.pdx
// (R38.M7-002, #1319).  This module only answers "how fast does
// (mcs, bw, gi, nss) run" and "does this MU group exist".
//
// =============================================================================
// §1  MCS + BW + GI ORDINALS (802.11-2020 + 802.11ax D8.0)
// =============================================================================
//
//   HEM_MCS_MAX      = 11    (MCS0..MCS11; 10/11 are the 1024-QAM tier)
//   HEM_BW_20        = 0     (20 MHz PPDU)
//   HEM_BW_40        = 1     (40 MHz PPDU)
//   HEM_BW_80        = 2     (80 MHz PPDU)
//   HEM_BW_160       = 3     (160 MHz PPDU)
//   HEM_GI_08        = 0     (0.8 us guard interval, LTF x1)
//   HEM_GI_16        = 1     (1.6 us guard interval, LTF x2)
//   HEM_GI_32        = 2     (3.2 us guard interval, LTF x4)
//   HEM_NSS_MAX      = 8     (up to 8 spatial streams, AX PHY-cap)
//
// =============================================================================
// §2  MU-MIMO METADATA
// =============================================================================
//
// A GROUP is a downlink MU-MIMO transmission unit: one PPDU that
// carries up to 8 (per Wi-Fi 6) users.  We record (group_id, n_users,
// primary_ru, secondary_ru) per live group, and a per-user row
// (group_id, user_id, aid, mcs).  Two tables, both bounded and per
// AX211 PHY capability.
//
//   HEM_GROUPS_MAX   = 4     (concurrent DL-MU groups, driver-imposed)
//   HEM_USERS_PER    = 8     (users per group, 802.11ax MU-MIMO cap)
//   HEM_USERS_TOTAL  = 32    (HEM_GROUPS_MAX * HEM_USERS_PER)
//
// Row layouts (u64 cells):
//   Group [+0] in_use|group_id  [+8] n_users  [+16] primary_ru  [+24] secondary_ru
//   User  [+0] in_use|group_id  [+8] user_id  [+16] aid         [+24] mcs
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// `_hem_groups`, `_hem_users`, `_hem_state` and `_hem_stats` are
// written only by helpers in this module.  tools/build.sh confines
// relocations against every symbol to `core/drivers/wifi/he_mcs.o`
// so a second writer cannot silently promote a rate or stitch a user
// into a group they were never admitted to.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF360..0xFFFFF36F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: rate_control
// 0xFFFFF350..5F; adjacent free band below: available for future
// R38.M7+ modules).

module HeMcs = structure {

  // §1: ordinals.
  pub let HEM_MCS_MAX       : u64 = 11
  pub let HEM_BW_20         : u64 = 0
  pub let HEM_BW_40         : u64 = 1
  pub let HEM_BW_80         : u64 = 2
  pub let HEM_BW_160        : u64 = 3
  pub let HEM_BW_MAX        : u64 = 3
  pub let HEM_GI_08         : u64 = 0
  pub let HEM_GI_16         : u64 = 1
  pub let HEM_GI_32         : u64 = 2
  pub let HEM_GI_MAX        : u64 = 2
  pub let HEM_NSS_MAX       : u64 = 8

  // §2: MU-MIMO bounds.
  pub let HEM_GROUPS_MAX    : u64 = 4
  pub let HEM_USERS_PER     : u64 = 8
  pub let HEM_USERS_TOTAL   : u64 = 32
  pub let HEM_GROUP_NONE    : u64 = 0xFF

  // §4: failure taxonomy 0xFFFFF360..0xFFFFF36F.
  pub let HEM_OK               : u64 = 0
  pub let HEM_BAD_ARG          : u64 = 0xFFFFF36F
  pub let HEM_BAD_MCS          : u64 = 0xFFFFF36E
  pub let HEM_BAD_BW           : u64 = 0xFFFFF36D
  pub let HEM_BAD_GI           : u64 = 0xFFFFF36C
  pub let HEM_BAD_NSS          : u64 = 0xFFFFF36B
  pub let HEM_ENOSPC           : u64 = 0xFFFFF36A
  pub let HEM_NO_GROUP         : u64 = 0xFFFFF369
  pub let HEM_ALREADY          : u64 = 0xFFFFF368
  pub let HEM_GROUP_FULL       : u64 = 0xFFFFF367

  // §3: state cells + tables.
  //   _hem_state layout:
  //     [0] table_ready flag  [1] active_groups  [2] active_users
  pub let mut _hem_state  : [u64; 4]  = uninit @align(64)
  pub let mut _hem_groups : [u64; 16] = uninit @align(64)  // 4 groups * 4 u64
  pub let mut _hem_users  : [u64; 128] = uninit @align(64) // 32 users * 4 u64
  pub let mut _hem_stats  : [u64; 8]  = uninit @align(64)

  pub let HEM_STAT_LOOKUPS      : u64 = 0
  pub let HEM_STAT_LOOKUPS_REFUSED : u64 = 1
  pub let HEM_STAT_GROUP_ADDS   : u64 = 2
  pub let HEM_STAT_GROUP_REFUSED: u64 = 3
  pub let HEM_STAT_USER_ADDS    : u64 = 4
  pub let HEM_STAT_USER_REFUSED : u64 = 5
  pub let HEM_STAT_RESETS       : u64 = 6

  // ==========================================================================
  // Reset -- clear state, tables + counters.  Boot + teardown.
  // ==========================================================================

  pub let hem_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): clear _hem_state + tables + counters. Labels prefixed hem_rs_.",
      block: {
        lea r10, [rip + _hem_state];
        xor rax, rax;
        xor rcx, rcx;
      hem_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  hem_rs_st;

        lea r10, [rip + _hem_groups];
        xor rcx, rcx;
      hem_rs_gr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  hem_rs_gr;

        lea r10, [rip + _hem_users];
        xor rcx, rcx;
      hem_rs_us:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  hem_rs_us;

        lea r10, [rip + _hem_stats];
        xor rcx, rcx;
      hem_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hem_rs_ct;

        lea r10, [rip + _hem_stats];
        mov rax, [r10 + 48];              // RESETS slot
        add rax, 1;
        mov [r10 + 48], rax;
        ret
      }
    }

  pub let hem_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M7-001 (#1318): honesty pin. Returns 0 until a real MAC/PHY binding programs the AX211 rate register from a live hem_rate_lookup answer.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let hem_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): counter bump. Labels prefixed hem_nt_. Preserves rax across the counter bump: hem_rate_lookup stages the computed Mbps in rax across this call at hem_rl_done — reading _hem_stats via rax would clobber the return value, so every rate lookup would return the running LOOKUPS count instead of the rate.",
      block: {
        push rax;
        cmp rdi, 8;
        jae hem_nt_out;
        lea r10, [rip + _hem_stats];
        mov r11, [r10 + rdi * 8];
        add r11, 1;
        mov [r10 + rdi * 8], r11;
      hem_nt_out:
        pop rax;
        ret
      }
    }

  pub let hem_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): counter read. Labels prefixed hem_st_.",
      block: {
        cmp rdi, 8;
        jae hem_st_zero;
        lea r10, [rip + _hem_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hem_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let hem_active_groups : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): live-group counter.",
      block: {
        lea r10, [rip + _hem_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let hem_active_users : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): live-user counter.",
      block: {
        lea r10, [rip + _hem_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  // ==========================================================================
  // hem_mcs_valid / hem_bw_valid / hem_gi_valid / hem_nss_valid
  // ==========================================================================

  pub let hem_mcs_valid : (u64) -> u64 !{} @{} =
    fn (mcs: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M7-001 (#1318): 0..11 is the AX MCS range.",
      block: {
        cmp rdi, 11;
        ja  hem_mv_no;
        mov rax, 1;
        ret;
      hem_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hem_bw_valid : (u64) -> u64 !{} @{} =
    fn (bw: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M7-001 (#1318): 0..3 is the AX BW range.",
      block: {
        cmp rdi, 3;
        ja  hem_bv_no;
        mov rax, 1;
        ret;
      hem_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hem_gi_valid : (u64) -> u64 !{} @{} =
    fn (gi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M7-001 (#1318): 0..2 is the AX GI range.",
      block: {
        cmp rdi, 2;
        ja  hem_gv_no;
        mov rax, 1;
        ret;
      hem_gv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hem_nss_valid : (u64) -> u64 !{} @{} =
    fn (nss: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M7-001 (#1318): 1..8 spatial streams.",
      block: {
        cmp rdi, 0;
        je  hem_nv_no;
        cmp rdi, 8;
        ja  hem_nv_no;
        mov rax, 1;
        ret;
      hem_nv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // hem_rate_lookup(mcs, bw, gi, nss) -> Mbps | 0 on error
  //
  // Rate = base_20MHz_08GI[mcs] * bw_scale[bw] * gi_scale[gi] / gi_div[gi] *
  //        nss.  We approximate this by a compact base-rate table for
  //        (MCS0..11) at 20 MHz + 0.8 us GI (single stream), then scale.
  //
  // Base rates (Mbps) for HE 20 MHz, 0.8 us GI, single stream (802.11ax
  // D8.0 Table 21-27), rounded down to whole Mbps:
  //   MCS0=8,  MCS1=17, MCS2=25, MCS3=34, MCS4=51, MCS5=68, MCS6=77,
  //   MCS7=86, MCS8=103, MCS9=114, MCS10=129, MCS11=143.
  //
  // Bandwidth scale: 20->1, 40->2, 80->4, 160->8.
  // GI scale (approximate, PPDU-length-only view): 0.8us base,
  //   1.6us multiplies by 100/105 (5% loss), 3.2us by 100/110 (10% loss).
  //   We implement GI scaling by numerator/denominator constants for
  //   integer arithmetic.
  // ==========================================================================

  pub let hem_rate_lookup : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (mcs: u64, bw: u64, gi: u64, nss: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): compute Mbps from (mcs, bw, gi, nss). Labels prefixed hem_rl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // mcs
        mov r12, rsi;                     // bw
        mov r13, rdx;                     // gi
        mov r14, rcx;                     // nss

        // Validate.
        mov rdi, rbx;
        call hem_mcs_valid;
        cmp rax, 0;
        je  hem_rl_bad;
        mov rdi, r12;
        call hem_bw_valid;
        cmp rax, 0;
        je  hem_rl_bad;
        mov rdi, r13;
        call hem_gi_valid;
        cmp rax, 0;
        je  hem_rl_bad;
        mov rdi, r14;
        call hem_nss_valid;
        cmp rax, 0;
        je  hem_rl_bad;

        // Base-rate lookup via switch on mcs.
        xor rax, rax;
        cmp rbx, 0;
        je  hem_rl_b0;
        cmp rbx, 1;
        je  hem_rl_b1;
        cmp rbx, 2;
        je  hem_rl_b2;
        cmp rbx, 3;
        je  hem_rl_b3;
        cmp rbx, 4;
        je  hem_rl_b4;
        cmp rbx, 5;
        je  hem_rl_b5;
        cmp rbx, 6;
        je  hem_rl_b6;
        cmp rbx, 7;
        je  hem_rl_b7;
        cmp rbx, 8;
        je  hem_rl_b8;
        cmp rbx, 9;
        je  hem_rl_b9;
        cmp rbx, 10;
        je  hem_rl_b10;
        cmp rbx, 11;
        je  hem_rl_b11;
        jmp hem_rl_bad;
      hem_rl_b0:  mov rax, 8;   jmp hem_rl_scale;
      hem_rl_b1:  mov rax, 17;  jmp hem_rl_scale;
      hem_rl_b2:  mov rax, 25;  jmp hem_rl_scale;
      hem_rl_b3:  mov rax, 34;  jmp hem_rl_scale;
      hem_rl_b4:  mov rax, 51;  jmp hem_rl_scale;
      hem_rl_b5:  mov rax, 68;  jmp hem_rl_scale;
      hem_rl_b6:  mov rax, 77;  jmp hem_rl_scale;
      hem_rl_b7:  mov rax, 86;  jmp hem_rl_scale;
      hem_rl_b8:  mov rax, 103; jmp hem_rl_scale;
      hem_rl_b9:  mov rax, 114; jmp hem_rl_scale;
      hem_rl_b10: mov rax, 129; jmp hem_rl_scale;
      hem_rl_b11: mov rax, 143;

      hem_rl_scale:
        // BW scale: shift-left by bw (20=x1, 40=x2, 80=x4, 160=x8).
        mov rcx, r12;
        shl rax, cl;

        // NSS multiplier.
        mov r15, rax;
        xor rax, rax;
        mov r11, r14;
      hem_rl_nssmul:
        cmp r11, 0;
        je  hem_rl_gi;
        add rax, r15;
        sub r11, 1;
        jmp hem_rl_nssmul;

      hem_rl_gi:
        // GI scaling.  gi=0 (0.8us) -> multiply by 1.  gi=1 (1.6us)
        // -> multiply by 100 / 105.  gi=2 (3.2us) -> multiply by
        // 100 / 110.
        cmp r13, 0;
        je  hem_rl_done;
        cmp r13, 1;
        je  hem_rl_gi16;
        // gi == 2
        imul rax, rax, 100;               // rax *= 100
        mov rcx, 110;
        xor rdx, rdx;
        div rcx;                          // rax = rax/110
        jmp hem_rl_done;
      hem_rl_gi16:
        imul rax, rax, 100;
        mov rcx, 105;
        xor rdx, rdx;
        div rcx;

      hem_rl_done:
        mov rdi, 0;                       // LOOKUPS
        call hem_note;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hem_rl_bad:
        mov rdi, 1;                       // LOOKUPS_REFUSED
        call hem_note;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hem_group_add(group_id, n_users, primary_ru, secondary_ru) -> HEM_OK | err
  //
  // Register a MU-MIMO group.  Refuses if:
  //   * n_users == 0 or n_users > HEM_USERS_PER
  //   * group_id already registered
  //   * no free group slot (ENOSPC)
  // ==========================================================================

  pub let hem_group_add : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (group_id: u64, n_users: u64, primary_ru: u64, secondary_ru: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): admit MU-MIMO group into _hem_groups. Labels prefixed hem_ga_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // group_id
        mov r12, rsi;                     // n_users
        mov r13, rdx;                     // primary_ru
        mov r14, rcx;                     // secondary_ru

        // Validate n_users in 1..HEM_USERS_PER.
        cmp r12, 0;
        je  hem_ga_bad;
        cmp r12, 8;
        ja  hem_ga_bad;

        // Search for duplicate group_id + first free slot.
        xor rcx, rcx;                     // scan cursor
        mov r15, 16;                      // sentinel = not found
      hem_ga_scan:
        cmp rcx, 4;
        jae hem_ga_scan_done;
        lea r10, [rip + _hem_groups];
        mov r11, rcx;
        shl r11, 5;                       // rcx * 32 bytes
        add r10, r11;
        mov r8, [r10];                    // in_use|group_id
        mov r11, r8;
        and r11, 0xFF;
        cmp r11, 0;
        je  hem_ga_freeslot;
        mov r9, r8;
        shr r9, 8;
        cmp r9, rbx;
        je  hem_ga_dupe;
        add rcx, 1;
        jmp hem_ga_scan;
      hem_ga_freeslot:
        cmp r15, 16;
        jne hem_ga_scan_next;
        mov r15, rcx;
      hem_ga_scan_next:
        add rcx, 1;
        jmp hem_ga_scan;
      hem_ga_scan_done:
        cmp r15, 16;
        je  hem_ga_full;

        // Install group row at slot r15.
        lea r10, [rip + _hem_groups];
        mov r11, r15;
        shl r11, 5;
        add r10, r11;
        mov r9, rbx;
        shl r9, 8;
        or  r9, 1;                        // in_use=1
        mov [r10],      r9;
        mov [r10 + 8],  r12;
        mov [r10 + 16], r13;
        mov [r10 + 24], r14;

        // Bump active_groups.
        lea r10, [rip + _hem_state];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;

        mov rdi, 2;                       // GROUP_ADDS
        call hem_note;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hem_ga_bad:
        mov rdi, 3;                       // GROUP_REFUSED
        call hem_note;
        mov rax, 0xFFFFF36F;              // BAD_ARG
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hem_ga_dupe:
        mov rdi, 3;
        call hem_note;
        mov rax, 0xFFFFF368;              // ALREADY
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hem_ga_full:
        mov rdi, 3;
        call hem_note;
        mov rax, 0xFFFFF36A;              // ENOSPC
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // hem_user_add(group_id, user_id, aid, mcs) -> HEM_OK | err
  //
  // Attach a user to a live group.  Refuses if:
  //   * mcs invalid
  //   * group_id not registered
  //   * group already at n_users (GROUP_FULL)
  //   * (group_id, user_id) already registered
  //   * no free user slot
  // ==========================================================================

  pub let hem_user_add : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (group_id: u64, user_id: u64, aid: u64, mcs: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M7-001 (#1318): attach user to MU-MIMO group. Labels prefixed hem_ua_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // group_id
        mov r12, rsi;                     // user_id
        mov r13, rdx;                     // aid
        mov r14, rcx;                     // mcs

        // Validate mcs.
        mov rdi, r14;
        call hem_mcs_valid;
        cmp rax, 0;
        je  hem_ua_bad;

        // Locate group row + capacity.
        xor rcx, rcx;
      hem_ua_glookup:
        cmp rcx, 4;
        jae hem_ua_nogroup;
        lea r10, [rip + _hem_groups];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov r8, [r10];
        mov r11, r8;
        and r11, 0xFF;
        cmp r11, 0;
        je  hem_ua_glookup_next;
        mov r9, r8;
        shr r9, 8;
        cmp r9, rbx;
        je  hem_ua_gfound;
      hem_ua_glookup_next:
        add rcx, 1;
        jmp hem_ua_glookup;
      hem_ua_gfound:
        // r10 currently points at matching group row.  Cache capacity.
        mov r15, [r10 + 8];               // capacity

        // Scan users table: count matching group_id, look for dupe (gid,uid),
        // remember first free slot.
        xor rcx, rcx;
        xor r8, r8;                       // count in this group
        mov r11, 128;                     // free-slot sentinel
      hem_ua_uscan:
        cmp rcx, 32;
        jae hem_ua_uscan_done;
        lea r10, [rip + _hem_users];
        mov r9, rcx;
        shl r9, 5;
        add r10, r9;
        mov r9, [r10];                    // in_use|group_id
        mov rdx, r9;
        and rdx, 0xFF;
        cmp rdx, 0;
        je  hem_ua_ufree;
        mov rdx, r9;
        shr rdx, 8;
        cmp rdx, rbx;
        jne hem_ua_uscan_next;
        add r8, 1;
        // Same group; check user_id dupe.
        mov rdx, [r10 + 8];
        cmp rdx, r12;
        je  hem_ua_dupe;
        jmp hem_ua_uscan_next;
      hem_ua_ufree:
        cmp r11, 128;
        jne hem_ua_uscan_next;
        mov r11, rcx;
      hem_ua_uscan_next:
        add rcx, 1;
        jmp hem_ua_uscan;
      hem_ua_uscan_done:
        // Capacity check.
        cmp r8, r15;
        jae hem_ua_full;
        // Space check.
        cmp r11, 128;
        je  hem_ua_full;

        // Install user row at r11.
        lea r10, [rip + _hem_users];
        mov r9, r11;
        shl r9, 5;
        add r10, r9;
        mov r9, rbx;
        shl r9, 8;
        or  r9, 1;
        mov [r10],      r9;
        mov [r10 + 8],  r12;
        mov [r10 + 16], r13;
        mov [r10 + 24], r14;

        // Bump active_users.
        lea r10, [rip + _hem_state];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;

        mov rdi, 4;                       // USER_ADDS
        call hem_note;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hem_ua_bad:
        mov rdi, 5;                       // USER_REFUSED
        call hem_note;
        mov rax, 0xFFFFF36E;              // BAD_MCS
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hem_ua_nogroup:
        mov rdi, 5;
        call hem_note;
        mov rax, 0xFFFFF369;              // NO_GROUP
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hem_ua_dupe:
        mov rdi, 5;
        call hem_note;
        mov rax, 0xFFFFF368;              // ALREADY
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      hem_ua_full:
        mov rdi, 5;
        call hem_note;
        mov rax, 0xFFFFF367;              // GROUP_FULL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
