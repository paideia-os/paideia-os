// src/kernel/core/drivers/wifi/fw_compat.pdx — R38.M1-004 (#1293)
//
// Intel AX211 firmware VERSION COMPATIBILITY MATRIX -- refuses a
// load whose (hardware_id, firmware_version) pair is not in the
// pinned matrix.  §7 R5 mitigation surface: a caller that admitted
// a bundle whose signature verified but whose version does not
// match the shipping regulatory profile of the underlying chip
// would ship a foreign RF policy into ring-0-adjacent execution.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the VERSION-GATE half of R38.M1.  fw_verify (#1291) proves
// paideia signed off on the bundle; this module proves paideia
// signed off on the bundle FOR THIS HARDWARE.  A vendor-signed
// UMAC image whose regulatory tables were minted for a 6E-only SKU
// would happily verify against a 6E+7-band SKU whose hardware id
// belongs to a later stepping -- with the radio then transmitting
// on bands the chip's antenna certification does not cover.  The
// mitigation is a small, PINNED, source-of-truth table of
// (hw_type, allowed_version_min, allowed_version_max) rows, and a
// call from wfl_load that refuses any pair outside the table.
//
// The table is COMPILE-TIME.  A live driver ships the same table
// with a paideia-signed data blob; this module models the mint by
// exposing wcm_matrix_row_of() for the audit path so an operator
// can read the whole table back through the same seam wfl_load
// consults.
//
// IT DOES NOT PARSE THE VERSION OUT OF THE BUNDLE.  fw_verify's
// section extents (UMAC and MVM section lengths) are the proxy
// this milestone uses -- the section lengths are an immutable
// fingerprint of the bundle version (two shipping versions have
// distinct section sizes) and are already validated by wfv_verify.
// A future round replaces the section-length proxy with a version
// tuple parsed out of the bundle header without changing the
// wcm_check_pair signature.
//
// wcm_arbitrated() returns 0 until a live signed-matrix mint lands.
//
// =============================================================================
// §1  COMPATIBILITY MATRIX (§7 R5 mitigation, PINNED)
// =============================================================================
//
// Each row is (hw_type, umac_min, umac_max, mvm_min, mvm_max).
// A caller-supplied (hw_rev, umac_len, mvm_len) is compatible iff
//   * The row whose hw_type nibble matches hw_rev's chip-type nibble
//     (bits 19:8 of hw_rev) exists in the matrix.
//   * umac_len is in [umac_min, umac_max].
//   * mvm_len  is in [mvm_min,  mvm_max].
//
// Rows shipped this milestone:
//
//   hw_type   umac_min   umac_max   mvm_min    mvm_max
//   -------   --------   --------   --------   --------
//   0x510     0x080000   0x180000   0x040000   0x0C0000   (0x51F0)
//   0x511     0x080000   0x180000   0x040000   0x0C0000   (0x51F1)
//   0x540     0x080000   0x180000   0x040000   0x0C0000   (0x54F0)
//
// The three shipping AX211 device ids share a version range; the
// matrix carries them as three rows rather than one so a future
// stepping can bump one range independently without a caller
// change.  A caller whose hw_type is not one of the three rows is
// refused as WCM_UNKNOWN_HW.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _wcm_stats is written only by helpers in this module.  The
// matrix itself is compile-time (.rodata) and has no writer.
// tools/build.sh confines relocations against _wcm_stats to
// `core/drivers/wifi/fw_compat.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF4B0..0xFFFFF4BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: fw_load
// 0xFFFFF4C0..CF, R38.M1-003; adjacent free band below: available
// for future R38.M1 modules).

module FwCompat = structure {

  // §1: matrix layout constants.
  pub let WCM_ROWS        : u64 = 3
  pub let WCM_COLS        : u64 = 5              // hw_type + 4 range bounds
  pub let WCM_ROW_BYTES   : u64 = 40             // 5 * u64

  // Column indices inside a row.
  pub let WCM_COL_HW_TYPE  : u64 = 0
  pub let WCM_COL_UMAC_MIN : u64 = 1
  pub let WCM_COL_UMAC_MAX : u64 = 2
  pub let WCM_COL_MVM_MIN  : u64 = 3
  pub let WCM_COL_MVM_MAX  : u64 = 4

  // Hardware-type nibble mask (matches AXP_HW_TYPE_MASK shifted).
  pub let WCM_HW_TYPE_MASK  : u64 = 0xFFF
  pub let WCM_HW_TYPE_SHIFT : u64 = 8

  // Failure taxonomy — 0xFFFFF4B0..0xFFFFF4BF.
  pub let WCM_OK              : u64 = 0
  pub let WCM_BAD_ARG         : u64 = 0xFFFFF4BF
  pub let WCM_UNKNOWN_HW      : u64 = 0xFFFFF4BE
  pub let WCM_BAD_UMAC_VER    : u64 = 0xFFFFF4BD
  pub let WCM_BAD_MVM_VER     : u64 = 0xFFFFF4BC
  pub let WCM_OUT_OF_RANGE    : u64 = 0xFFFFF4BB    // row idx out of range

  // §1: the matrix.  Flat [u64; 15] laid out row-major so a lookup
  // is a single (row * 5 + col) compute.  The values are the
  // constants documented in §1; keeping them in .rodata means
  // there is nothing to write and no writer to confine.
  pub let _wcm_matrix : [u64; 15] = [
    // row 0: hw_type 0x510 (0x51F0 family)
    0x510, 0x080000, 0x180000, 0x040000, 0x0C0000,
    // row 1: hw_type 0x511 (0x51F1 family)
    0x511, 0x080000, 0x180000, 0x040000, 0x0C0000,
    // row 2: hw_type 0x540 (0x54F0 family)
    0x540, 0x080000, 0x180000, 0x040000, 0x0C0000
  ]

  // Counters.
  pub let mut _wcm_stats : [u64; 8] = uninit @align(64)

  pub let WCM_ST_ADMITS       : u64 = 0
  pub let WCM_ST_UNKNOWN_HW   : u64 = 1
  pub let WCM_ST_BAD_UMAC     : u64 = 2
  pub let WCM_ST_BAD_MVM      : u64 = 3
  pub let WCM_ST_REFUSED      : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let wcm_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-004 (#1293): clear stats. Matrix itself is .rodata and has no writer. Boot and teardown. Labels prefixed wcm_rs_.",
      block: {
        lea r10, [rip + _wcm_stats];
        xor rax, rax;
        xor rcx, rcx;
      wcm_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wcm_rs_loop;
        ret
      }
    }

  pub let wcm_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-004 (#1293): honesty pin. Returns 0 until a live paideia-signed matrix mint replaces the compile-time table.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let wcm_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-004 (#1293): counter bump. Labels prefixed wcm_nt_.",
      block: {
        cmp rdi, 8;
        jae wcm_nt_out;
        lea r10, [rip + _wcm_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wcm_nt_out:
        ret
      }
    }

  pub let wcm_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-004 (#1293): counter read. Labels prefixed wcm_st_.",
      block: {
        cmp rdi, 8;
        jae wcm_st_zero;
        lea r10, [rip + _wcm_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wcm_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // wcm_matrix_row_of(row_idx, col_idx) -> u64
  //
  // Read a matrix cell.  Out-of-range indices return
  // WCM_OUT_OF_RANGE (a sentinel that is disjoint from every valid
  // cell value at this milestone; the caller distinguishes it by
  // comparing against the sentinel, not by range).
  // ==========================================================================

  pub let wcm_matrix_row_of : (u64, u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) (col_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-004 (#1293): read row_idx,col_idx from the pinned matrix. Refuses OUT_OF_RANGE. Labels prefixed wcm_mr_.",
      block: {
        cmp rdi, 3;                      // WCM_ROWS
        jae wcm_mr_oor;
        cmp rsi, 5;                      // WCM_COLS
        jae wcm_mr_oor;
        // idx = row_idx * 5 + col_idx.
        mov rax, rdi;
        mov rcx, 5;
        imul rax, rcx;
        add rax, rsi;
        lea r10, [rip + _wcm_matrix];
        mov rax, [r10 + rax * 8];
        ret;
      wcm_mr_oor:
        mov rax, 0xFFFFF4BB;             // OUT_OF_RANGE
        ret
      }
    }

  // ==========================================================================
  // wcm_lookup_hw(hw_type) -> row_idx | WCM_UNKNOWN_HW
  //
  // Linear scan over the three shipping rows.  A future round
  // replaces this with a hashed lookup once the matrix grows past
  // a dozen rows -- the scan cost at 3 rows is a handful of cycles.
  // ==========================================================================

  pub let wcm_lookup_hw : (u64) -> u64 !{mem} @{} =
    fn (hw_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-004 (#1293): linear scan for hw_type row. Labels prefixed wcm_lh_.",
      block: {
        push rbx;
        mov rbx, rdi;                    // hw_type

        lea r10, [rip + _wcm_matrix];
        xor rcx, rcx;                    // row index
      wcm_lh_loop:
        // row start = _wcm_matrix + rcx * 5 * 8 = + rcx * 40.
        mov rax, rcx;
        mov rdx, 5;
        imul rax, rdx;
        mov rdx, [r10 + rax * 8];        // hw_type column
        cmp rdx, rbx;
        je  wcm_lh_hit;
        add rcx, 1;
        cmp rcx, 3;                      // WCM_ROWS
        jb  wcm_lh_loop;

        // Miss.
        mov rax, 0xFFFFF4BE;             // UNKNOWN_HW
        jmp wcm_lh_out;

      wcm_lh_hit:
        mov rax, rcx;

      wcm_lh_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // wcm_check_pair(hw_rev, umac_len, mvm_len) -> WCM_OK | error
  //
  // §0: THE ONE ENTRY POINT for wfl_load's compat gate.
  //   1. Extract hw_type nibble from hw_rev (bits 19:8).
  //   2. wcm_lookup_hw -> refuses UNKNOWN_HW if the row is absent.
  //   3. umac_len in [umac_min, umac_max] -> refuses BAD_UMAC_VER.
  //   4. mvm_len  in [mvm_min,  mvm_max ] -> refuses BAD_MVM_VER.
  //   5. On OK: bump ADMITS counter and return 0.
  //
  // Both range checks ALWAYS run.  Neither short-circuits on the
  // other's success -- the failure taxonomy tells the caller which
  // half refused so an operator sees whether the UMAC or the MVM
  // section is out of range.
  // ==========================================================================

  pub let wcm_check_pair : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hw_rev: u64) (umac_len: u64) (mvm_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-004 (#1293): version-compat gate. §1 range check per §7 R5. Labels prefixed wcm_c_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // hw_rev
        mov r12, rsi;                    // umac_len
        mov r13, rdx;                    // mvm_len

        // 1. Extract hw_type nibble.
        mov rax, rbx;
        shr rax, 8;
        and rax, 0xFFF;                  // WCM_HW_TYPE_MASK

        // 2. Row lookup.
        mov rdi, rax;
        call wcm_lookup_hw;
        mov r11, 0xFFFFF4BE;
        cmp rax, r11;
        je  wcm_c_unknown;

        // rax = row idx.
        // Row-base offset in cells = row * 5.  Read the four bounds.
        push rax;                        // save row idx
        mov rcx, 5;
        imul rax, rcx;
        lea r10, [rip + _wcm_matrix];

        // umac_min = row[1], umac_max = row[2].
        mov rdi, [r10 + rax * 8 + 8];    // umac_min
        mov rsi, [r10 + rax * 8 + 16];   // umac_max
        // 3. Umac range.
        cmp r12, rdi;
        jb  wcm_c_bad_umac_pop;
        cmp r12, rsi;
        ja  wcm_c_bad_umac_pop;

        // mvm_min = row[3], mvm_max = row[4].
        mov rdi, [r10 + rax * 8 + 24];   // mvm_min
        mov rsi, [r10 + rax * 8 + 32];   // mvm_max
        // 4. Mvm range.
        cmp r13, rdi;
        jb  wcm_c_bad_mvm_pop;
        cmp r13, rsi;
        ja  wcm_c_bad_mvm_pop;

        add rsp, 8;                      // discard saved row idx
        mov rdi, 0;                      // ADMITS
        call wcm_note;
        xor rax, rax;
        jmp wcm_c_out;

      wcm_c_bad_umac_pop:
        add rsp, 8;
        mov rdi, 2;                      // BAD_UMAC
        call wcm_note;
        mov rdi, 4;                      // REFUSED
        call wcm_note;
        mov rax, 0xFFFFF4BD;
        jmp wcm_c_out;
      wcm_c_bad_mvm_pop:
        add rsp, 8;
        mov rdi, 3;                      // BAD_MVM
        call wcm_note;
        mov rdi, 4;
        call wcm_note;
        mov rax, 0xFFFFF4BC;
        jmp wcm_c_out;
      wcm_c_unknown:
        mov rdi, 1;                      // UNKNOWN_HW
        call wcm_note;
        mov rdi, 4;
        call wcm_note;
        mov rax, 0xFFFFF4BE;

      wcm_c_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
