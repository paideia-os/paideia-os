// src/kernel/core/drivers/wifi/fw_verify.pdx — R38.M1-002 (#1291)
//
// Intel AX211 (iwlwifi) UMAC/MVM firmware DUAL-SIGNATURE verifier.
// Refuses to accept a WiFi firmware image whose vendor (RSA-2048)
// signature slot is empty OR whose paideia (Dilithium-2) re-sign
// slot is empty.  Fails closed on EITHER miss -- the dual-signature
// discipline mandated by design/roadmap/next-wave-synthesis.md
// §10 D1.a for a foreign blob run in ring 0.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ADMISSION GATE for an AX211 firmware image.  ax211_probe
// (#1289) recognises the PCI function; fw_load (#1292) is the
// byte-mover that shovels UMAC+MVM sections into on-chip SRAM and
// waits for the INIT_ALIVE notification; this module answers
// "may we run this image at all?".  A load call that skipped this
// gate would silently ship vendor firmware into a ring-0-adjacent
// execution context without paideia having taken responsibility for
// the shipment -- the exact failure mode D1.a exists to make
// impossible.
//
// The iwlwifi firmware ships TWO code sections per bundle: the UMAC
// (user microcode, the higher-level MVM protocol engine) and the
// MVM (radio microcode).  This module accepts a bundle descriptor
// naming both sections and verifies the pair together; a bundle
// whose UMAC section is present and MVM absent (or vice-versa) is
// refused as BAD_SECTIONS.  A live driver mints two distinct
// firmware objects the fw_load path then uploads; this scaffold's
// contract with fw_load is "the bundle admitted here is
// wfv_bundle_of(), the sections' offsets and sizes come out of
// wfv_umac_of() / wfv_mvm_of()".
//
// IT DOES NOT PERFORM REAL RSA-2048 OR DILITHIUM-2 SIGNATURE
// ARITHMETIC.  Both signature slots are checked STRUCTURALLY this
// milestone: the slot is present and the slot's payload is
// non-empty.  The real cryptographic verifier lands under
// KIND_HASH_SESSION (R32 wave-2 scope).  Substituting the real
// verifier at that seam does not change any caller: wfv_verify()
// keeps the same signature and the same "fails closed on either
// miss" semantic -- the byte pattern the check accepts narrows from
// "any non-zero" to "algebraically valid", and every existing
// refusal path stays intact.
//
// wfv_arbitrated() returns 0 until R32 wave-2 binds the seam to a
// live KIND_HASH_SESSION verifier.
//
// =============================================================================
// §1  BUNDLE HEADER LAYOUT
// =============================================================================
//
//   Offset  Field                Size  Notes
//   ----------------------------------------------------------------------
//   0x00    magic                u32   'IWLB' (LE: 0x424C5749)
//   0x04    body_size            u32   bytes of firmware body past
//                                      the header (informational; the
//                                      body is not hashed here).
//   0x08    vendor_sig[0..8)     u64   RSA-2048 signature slot (word 0)
//   0x10    vendor_sig[8..16)    u64   (word 1). A slot with BOTH
//                                      words zero is REFUSED.
//   0x18    paideia_sig[0..8)    u64   Dilithium-2 re-sign slot (w 0)
//   0x20    paideia_sig[8..16)   u64   (word 1). A slot with BOTH
//                                      words zero is REFUSED.
//   0x28    umac_off             u32   byte offset of UMAC section
//                                      within blob (u32, from base).
//                                      Must be >= header size and
//                                      + umac_len must fit blob_len.
//   0x2C    umac_len             u32   length of UMAC section (bytes).
//                                      Must be > 0.
//   0x30    mvm_off              u32   byte offset of MVM section.
//                                      Must be >= header size and
//                                      + mvm_len must fit blob_len.
//   0x34    mvm_len              u32   length of MVM section.
//                                      Must be > 0.
//   0x38    body...              u32×N sections + body (§3 of a real
//                                      iwlwifi image; opaque here).
//
// Header size = 0x38 (56 bytes).  A blob shorter than the header is
// REFUSED as TOO_SMALL -- a caller cannot pretend a 16-byte trace
// of magic + one signature was a valid image.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _wfv_blob_ptr, _wfv_blob_len, _wfv_verified, _wfv_umac_off,
// _wfv_umac_len, _wfv_mvm_off, _wfv_mvm_len and _wfv_stats are
// written only by helpers in this module.  tools/build.sh confines
// relocations against each to `core/drivers/wifi/fw_verify.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF4D0..0xFFFFF4DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: ax211_probe
// 0xFFFFF4E0..EF, R38.M1-001; adjacent free band below: fw_load
// 0xFFFFF4C0..CF, R38.M1-003).

module FwVerify = structure {

  // §1: header layout.
  pub let WFV_MAGIC             : u64 = 0x424C5749           // 'IWLB' LE
  pub let WFV_HDR_SIZE          : u64 = 0x38
  pub let WFV_OFF_MAGIC         : u64 = 0x00
  pub let WFV_OFF_BODY_SIZE     : u64 = 0x04
  pub let WFV_OFF_VENDOR_LO     : u64 = 0x08
  pub let WFV_OFF_VENDOR_HI     : u64 = 0x10
  pub let WFV_OFF_PAIDEIA_LO    : u64 = 0x18
  pub let WFV_OFF_PAIDEIA_HI    : u64 = 0x20
  pub let WFV_OFF_UMAC_OFF      : u64 = 0x28
  pub let WFV_OFF_UMAC_LEN      : u64 = 0x2C
  pub let WFV_OFF_MVM_OFF       : u64 = 0x30
  pub let WFV_OFF_MVM_LEN       : u64 = 0x34

  // Failure taxonomy — 0xFFFFF4D0..0xFFFFF4DF.
  pub let WFV_OK                : u64 = 0
  pub let WFV_BAD_ARG           : u64 = 0xFFFFF4DF
  pub let WFV_TOO_SMALL         : u64 = 0xFFFFF4DE
  pub let WFV_BAD_MAGIC         : u64 = 0xFFFFF4DD
  pub let WFV_BAD_VENDOR_SIG    : u64 = 0xFFFFF4DC
  pub let WFV_BAD_PAIDEIA_SIG   : u64 = 0xFFFFF4DB
  pub let WFV_NULL_BLOB         : u64 = 0xFFFFF4DA
  pub let WFV_BAD_SECTIONS      : u64 = 0xFFFFF4D9

  // Recorded bundle descriptor after a successful verify.
  pub let mut _wfv_blob_ptr : [u64; 1] = uninit @align(64)
  pub let mut _wfv_blob_len : [u64; 1] = uninit @align(64)
  pub let mut _wfv_verified : [u64; 1] = uninit @align(64)
  pub let mut _wfv_umac_off : [u64; 1] = uninit @align(64)
  pub let mut _wfv_umac_len : [u64; 1] = uninit @align(64)
  pub let mut _wfv_mvm_off  : [u64; 1] = uninit @align(64)
  pub let mut _wfv_mvm_len  : [u64; 1] = uninit @align(64)

  // Counters.
  pub let mut _wfv_stats : [u64; 8] = uninit @align(64)

  pub let WFV_ST_VERIFIED     : u64 = 0
  pub let WFV_ST_VENDOR_MISS  : u64 = 1
  pub let WFV_ST_PAIDEIA_MISS : u64 = 2
  pub let WFV_ST_REFUSED      : u64 = 3
  pub let WFV_ST_SECTION_MISS : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let wfv_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): clear bundle record, verified flag, section extents, and stats. Boot and teardown. Labels prefixed wfv_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _wfv_blob_ptr];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfv_blob_len];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfv_verified];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfv_umac_off];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfv_umac_len];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfv_mvm_off];
        mov [r10 + 0], rax;
        lea r10, [rip + _wfv_mvm_len];
        mov [r10 + 0], rax;

        lea r10, [rip + _wfv_stats];
        xor rcx, rcx;
      wfv_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wfv_rs_stats;
        ret
      }
    } @no_frame

  pub let wfv_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M1-002 (#1291): honesty pin. Returns 0 until R32 wave-2 KIND_HASH_SESSION binds this to a live RSA-2048 + Dilithium-2 verifier.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let wfv_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): counter bump. Labels prefixed wfv_nt_.",
      block: {
        cmp rdi, 8;
        jae wfv_nt_out;
        lea r10, [rip + _wfv_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wfv_nt_out:
        ret
      }
    } @no_frame

  pub let wfv_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): counter read. Labels prefixed wfv_st_.",
      block: {
        cmp rdi, 8;
        jae wfv_st_zero;
        lea r10, [rip + _wfv_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wfv_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // wfv_verify_vendor(blob_ptr, blob_len) -> WFV_OK | BAD_VENDOR_SIG
  //
  // The RSA-2048 slot half of §1.  A slot with BOTH words zero is
  // BAD_VENDOR_SIG.  A live verifier will run the RSA-PKCS#1-v1_5
  // check against paideia's pinned Intel-iwlwifi public key over
  // the firmware body; the substitution point is here, unchanged
  // for the caller.
  //
  // PRE: wfv_verify_size(blob_ptr, blob_len) already returned OK.
  //      (The public entry point wfv_verify() serialises the calls.)
  // ==========================================================================

  pub let wfv_verify_vendor : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): vendor (RSA-2048) sig slot check. §1 offsets. Labels prefixed wfv_vv_.",
      block: {
        mov rax, [rdi + 8];              // vendor_sig[0]
        mov rcx, [rdi + 16];             // vendor_sig[1]
        or  rax, rcx;
        cmp rax, 0;
        je  wfv_vv_bad;
        xor rax, rax;
        ret;
      wfv_vv_bad:
        mov rax, 0xFFFFF4DC;             // BAD_VENDOR_SIG
        ret
      }
    } @no_frame

  // ==========================================================================
  // wfv_verify_paideia(blob_ptr, blob_len) -> WFV_OK | BAD_PAIDEIA_SIG
  //
  // The Dilithium-2 re-sign half of §1.  A slot with BOTH words
  // zero is BAD_PAIDEIA_SIG.
  // ==========================================================================

  pub let wfv_verify_paideia : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): paideia (Dilithium-2) re-sign slot check. §1 offsets. Labels prefixed wfv_vp_.",
      block: {
        mov rax, [rdi + 24];             // paideia_sig[0]
        mov rcx, [rdi + 32];             // paideia_sig[1]
        or  rax, rcx;
        cmp rax, 0;
        je  wfv_vp_bad;
        xor rax, rax;
        ret;
      wfv_vp_bad:
        mov rax, 0xFFFFF4DB;             // BAD_PAIDEIA_SIG
        ret
      }
    } @no_frame

  // ==========================================================================
  // wfv_verify_sections(blob_ptr, blob_len) -> WFV_OK | BAD_SECTIONS
  //
  // Checks that both UMAC and MVM section extents are present and
  // fit inside the blob:
  //   * umac_off >= header size AND (umac_off + umac_len) <= blob_len
  //   * mvm_off  >= header size AND (mvm_off  + mvm_len ) <= blob_len
  //   * umac_len > 0 AND mvm_len > 0
  //
  // A bundle whose UMAC or MVM section is absent, or whose extent
  // walks past blob_len, is REFUSED.  This is the section-shape half
  // of §1 -- catching a truncated bundle before fw_load tries to
  // upload it.
  // ==========================================================================

  pub let wfv_verify_sections : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): UMAC + MVM section extent check per §1. Fails BAD_SECTIONS. Labels prefixed wfv_vs_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;                    // blob_ptr
        mov r12, rsi;                    // blob_len

        // umac_off + umac_len.
        xor rax, rax;
        mov eax, [rbx + 40];             // umac_off (u32)
        cmp rax, 0x38;                   // header size
        jb  wfv_vs_bad;
        xor rcx, rcx;
        mov ecx, [rbx + 44];             // umac_len (u32)
        cmp rcx, 0;
        je  wfv_vs_bad;
        add rax, rcx;
        cmp rax, r12;
        ja  wfv_vs_bad;

        // mvm_off + mvm_len.
        xor rax, rax;
        mov eax, [rbx + 48];             // mvm_off (u32)
        cmp rax, 0x38;
        jb  wfv_vs_bad;
        xor rcx, rcx;
        mov ecx, [rbx + 52];             // mvm_len (u32)
        cmp rcx, 0;
        je  wfv_vs_bad;
        add rax, rcx;
        cmp rax, r12;
        ja  wfv_vs_bad;

        xor rax, rax;
        jmp wfv_vs_out;
      wfv_vs_bad:
        mov rax, 0xFFFFF4D9;             // BAD_SECTIONS
      wfv_vs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // wfv_verify(blob_ptr, blob_len) -> WFV_OK | error
  //
  // §0: THE ONE ENTRY POINT for AX211 firmware admission.  Order:
  //   1. NULL blob refused (NULL_BLOB).
  //   2. Undersized blob refused (TOO_SMALL).
  //   3. Wrong magic refused (BAD_MAGIC).
  //   4. Vendor sig slot empty refused (BAD_VENDOR_SIG).
  //   5. Paideia sig slot empty refused (BAD_PAIDEIA_SIG).
  //   6. Section extents malformed refused (BAD_SECTIONS).
  //   7. On OK: record {blob_ptr, blob_len, umac_off, umac_len,
  //      mvm_off, mvm_len, verified=1}; bump VERIFIED counter;
  //      return 0.
  //
  // BOTH signature checks ALWAYS run.  Neither short-circuits on
  // the other's success -- the failure taxonomy tells the caller
  // which half refused so an operator sees whether the vendor blob
  // or the paideia re-sign is the missing half.
  //
  // A second call with an ALREADY-VERIFIED image is idempotent iff
  // the pair {blob_ptr, blob_len} matches; a swap is refused as
  // BAD_ARG.  That mirrors gmmio_bind's swap-refusal and
  // gucv_verify's.
  // ==========================================================================

  pub let wfv_verify : (u64, u64) -> u64 !{mem} @{} =
    fn (blob_ptr: u64) (blob_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): DUAL-SIGNATURE verify (D1.a). Vendor and paideia sig slots BOTH checked; sections' extents validated; fails closed on any miss. Idempotent under identity; refuses BAD_ARG on a swap. Labels prefixed wfv_v_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // blob_ptr
        mov r12, rsi;                    // blob_len

        // 1. NULL blob.
        cmp rbx, 0;
        je  wfv_v_null;

        // 2. Undersized.
        cmp r12, 0x38;
        jb  wfv_v_too_small;

        // 3. Magic.
        mov eax, [rbx + 0];
        mov r13d, 0x424C5749;            // 'IWLB' LE
        cmp eax, r13d;
        jne wfv_v_bad_magic;

        // Idempotent under identity swap-check.
        lea r10, [rip + _wfv_verified];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  wfv_v_do;

        lea r10, [rip + _wfv_blob_ptr];
        mov rax, [r10 + 0];
        cmp rax, rbx;
        jne wfv_v_bad_arg;
        lea r10, [rip + _wfv_blob_len];
        mov rax, [r10 + 0];
        cmp rax, r12;
        jne wfv_v_bad_arg;
        xor rax, rax;                    // already verified, same bundle
        jmp wfv_v_out;

      wfv_v_do:
        // 4. Vendor.
        mov rdi, rbx;
        mov rsi, r12;
        call wfv_verify_vendor;
        cmp rax, 0;
        jne wfv_v_vendor_bad;

        // 5. Paideia.
        mov rdi, rbx;
        mov rsi, r12;
        call wfv_verify_paideia;
        cmp rax, 0;
        jne wfv_v_paideia_bad;

        // 6. Sections.
        mov rdi, rbx;
        mov rsi, r12;
        call wfv_verify_sections;
        cmp rax, 0;
        jne wfv_v_sections_bad;

        // 7. Record.
        lea r10, [rip + _wfv_blob_ptr];
        mov [r10 + 0], rbx;
        lea r10, [rip + _wfv_blob_len];
        mov [r10 + 0], r12;

        // UMAC extents.
        xor rax, rax;
        mov eax, [rbx + 40];
        lea r10, [rip + _wfv_umac_off];
        mov [r10 + 0], rax;
        xor rax, rax;
        mov eax, [rbx + 44];
        lea r10, [rip + _wfv_umac_len];
        mov [r10 + 0], rax;

        // MVM extents.
        xor rax, rax;
        mov eax, [rbx + 48];
        lea r10, [rip + _wfv_mvm_off];
        mov [r10 + 0], rax;
        xor rax, rax;
        mov eax, [rbx + 52];
        lea r10, [rip + _wfv_mvm_len];
        mov [r10 + 0], rax;

        lea r10, [rip + _wfv_verified];
        mov rax, 1;
        mov [r10 + 0], rax;

        mov rdi, 0;                      // VERIFIED
        call wfv_note;
        xor rax, rax;
        jmp wfv_v_out;

      wfv_v_null:
        mov rdi, 3;
        call wfv_note;
        mov rax, 0xFFFFF4DA;
        jmp wfv_v_out;
      wfv_v_too_small:
        mov rdi, 3;
        call wfv_note;
        mov rax, 0xFFFFF4DE;
        jmp wfv_v_out;
      wfv_v_bad_magic:
        mov rdi, 3;
        call wfv_note;
        mov rax, 0xFFFFF4DD;
        jmp wfv_v_out;
      wfv_v_bad_arg:
        mov rdi, 3;
        call wfv_note;
        mov rax, 0xFFFFF4DF;
        jmp wfv_v_out;
      wfv_v_vendor_bad:
        mov rdi, 1;                      // VENDOR_MISS
        call wfv_note;
        mov rdi, 3;
        call wfv_note;
        mov rax, 0xFFFFF4DC;
        jmp wfv_v_out;
      wfv_v_paideia_bad:
        mov rdi, 2;                      // PAIDEIA_MISS
        call wfv_note;
        mov rdi, 3;
        call wfv_note;
        mov rax, 0xFFFFF4DB;
        jmp wfv_v_out;
      wfv_v_sections_bad:
        mov rdi, 4;                      // SECTION_MISS
        call wfv_note;
        mov rdi, 3;
        call wfv_note;
        mov rax, 0xFFFFF4D9;

      wfv_v_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let wfv_is_verified : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): 1 iff a bundle has been verified this boot. Labels prefixed wfv_iv_.",
      block: {
        lea r10, [rip + _wfv_verified];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let wfv_blob_ptr_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): recorded bundle pointer or 0. Labels prefixed wfv_bp_.",
      block: {
        lea r10, [rip + _wfv_blob_ptr];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let wfv_blob_len_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): recorded bundle length or 0. Labels prefixed wfv_bl_.",
      block: {
        lea r10, [rip + _wfv_blob_len];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let wfv_umac_off_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): recorded UMAC offset or 0. Labels prefixed wfv_uo_.",
      block: {
        lea r10, [rip + _wfv_umac_off];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let wfv_umac_len_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): recorded UMAC length or 0. Labels prefixed wfv_ul_.",
      block: {
        lea r10, [rip + _wfv_umac_len];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let wfv_mvm_off_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): recorded MVM offset or 0. Labels prefixed wfv_mo_.",
      block: {
        lea r10, [rip + _wfv_mvm_off];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let wfv_mvm_len_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M1-002 (#1291): recorded MVM length or 0. Labels prefixed wfv_ml_.",
      block: {
        lea r10, [rip + _wfv_mvm_len];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame
}
