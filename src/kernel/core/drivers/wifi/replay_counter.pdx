// src/kernel/core/drivers/wifi/replay_counter.pdx — R38.M5-004 (#1312)
//
// KRACK-safe per-key monotone replay counter.  802.11-2020 §12.5.2
// requires that a PN (packet number) used to encrypt one MPDU never
// be reused; the KRACK class of attacks (Vanhoef 2017) exploited
// implementations that RE-INSTALLED a key -- resetting the PN
// counter -- when a retransmitted M3 or Group Key Handshake message
// was received.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CENTRAL POLICY that decides whether:
//
//   (a) a PTK / GTK install request may proceed (rc_install_guard),
//   (b) an incoming MPDU with a given PN may be decrypted
//       (rc_recv_guard).
//
// The rules per KRACK-safe discipline:
//
//   (a) INSTALL of a PTK/GTK for key_id K with initial_pn P is
//       REFUSED if a live row already exists for K, regardless of P
//       -- a second install is the very bug KRACK exploited.  The
//       ONE way to install anew is to first rc_free the old row.
//
//   (b) RECV of an MPDU with PN P against key_id K is REFUSED if
//       P <= last_seen_pn(K).  Refuse (RC_REPLAY), not clamp: a
//       replay attempt is a security event that must be observable.
//
// IT DOES NOT DECRYPT.  It is a policy gate the driver's RX path
// consults BEFORE decrypt; the actual CCMP / GCMP decrypt lives
// elsewhere.
//
// IT DOES NOT DERIVE KEYS.  R32 / wpa_4way derive; this module only
// tracks the counter STATE per installed key.
//
// =============================================================================
// §1  ROWS  (8 entries, one per live key)
// =============================================================================
//
// A row is (in_use, key_id, initial_pn, last_seen_pn).  key_id is
// 0..7 (802.11 §12.7.6.2 -- 0..3 group, 4..7 pairwise).  The table
// has 8 slots -- there are never more than a handful of live keys at
// once on one station.
//
// Row layout (32 bytes each, fits [u64; 32] for 8 rows):
//
//   [+0]  in_use[7:0] | key_id[15:8]
//   [+8]  initial_pn (u64)
//   [+16] last_seen_pn (u64)
//   [+24] reserved (0)
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// `_rc_table` and `_rc_stats` are written only by helpers in this
// module.  tools/build.sh confines relocations against both symbols
// to `core/drivers/wifi/replay_counter.o` so a second writer cannot
// silently reset a counter.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF3B0..0xFFFFF3BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: wpa_4way
// 0xFFFFF3C0..CF; adjacent free band below: wpa_supplicant_channel
// 0xFFFFF3A0..AF).

module ReplayCounter = structure {

  pub let RC_MAX             : u64 = 8
  pub let RC_ROW_BYTES       : u64 = 32
  pub let RC_KEY_ID_MAX      : u64 = 7

  // Failure taxonomy 0xFFFFF3B0..0xFFFFF3BF.
  pub let RC_OK              : u64 = 0
  pub let RC_BAD_ARG         : u64 = 0xFFFFF3BF
  pub let RC_BAD_KEY_ID      : u64 = 0xFFFFF3BE
  pub let RC_ENOSPC          : u64 = 0xFFFFF3BD
  pub let RC_ALREADY         : u64 = 0xFFFFF3BC    // second install of a live key
  pub let RC_NOT_INSTALLED   : u64 = 0xFFFFF3BB
  pub let RC_REPLAY          : u64 = 0xFFFFF3BA    // PN <= last_seen -- KRACK gate

  pub let RC_ROW_NONE        : u64 = 0xFF

  pub let mut _rc_table : [u64; 32] = uninit @align(64)
  pub let mut _rc_stats : [u64; 8]  = uninit @align(64)

  pub let RC_STAT_INSTALLS   : u64 = 0
  pub let RC_STAT_INSTALLS_REFUSED : u64 = 1
  pub let RC_STAT_RECVS      : u64 = 2
  pub let RC_STAT_RECVS_REFUSED : u64 = 3
  pub let RC_STAT_REPLAYS    : u64 = 4
  pub let RC_STAT_FREES      : u64 = 5

  // ==========================================================================
  // Reset -- scrub table + counters.  Boot + teardown.
  // ==========================================================================

  pub let rc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): clear _rc_table + _rc_stats. Labels prefixed rc_rs_.",
      block: {
        lea r10, [rip + _rc_table];
        xor rax, rax;
        xor rcx, rcx;
      rc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  rc_rs_rows;

        lea r10, [rip + _rc_stats];
        xor rcx, rcx;
      rc_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  rc_rs_ct;
        ret
      }
    } @no_frame

  pub let rc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): counter bump. Labels prefixed rc_nt_.",
      block: {
        cmp rdi, 8;
        jae rc_nt_out;
        lea r10, [rip + _rc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      rc_nt_out:
        ret
      }
    } @no_frame

  pub let rc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): counter read. Labels prefixed rc_stt_.",
      block: {
        cmp rdi, 8;
        jae rc_stt_zero;
        lea r10, [rip + _rc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      rc_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // rc_find_by_key_id(key_id) -> row_id (0..7) | RC_ROW_NONE (0xFF)
  //
  // Linear scan over 8 rows; O(1) constant-time table for the whole
  // system.
  // ==========================================================================

  pub let rc_find_by_key_id : (u64) -> u64 !{mem} @{} =
    fn (key_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): find live row for key_id. Labels prefixed rc_fk_.",
      block: {
        cmp rdi, 7;
        ja  rc_fk_none;
        xor rcx, rcx;
      rc_fk_scan:
        cmp rcx, 8;
        jae rc_fk_none;
        lea r10, [rip + _rc_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        and r11, 0xFF;                    // in_use
        cmp r11, 0;
        je  rc_fk_next;
        shr rax, 8;
        and rax, 0xFF;                    // key_id
        cmp rax, rdi;
        je  rc_fk_hit;
      rc_fk_next:
        add rcx, 1;
        jmp rc_fk_scan;
      rc_fk_hit:
        mov rax, rcx;
        ret;
      rc_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // rc_install_guard(key_id, initial_pn) -> RC_OK | error
  //
  // KRACK GATE.  REFUSES if a live row already exists for key_id.
  // Otherwise claims an empty row and records (key_id, initial_pn),
  // with last_seen_pn = initial_pn (so the first RX with a PN >
  // initial is admitted, and a PN <= initial is refused as REPLAY).
  //
  // Refuses:
  //   * key_id > 7          -> RC_BAD_KEY_ID
  //   * already installed   -> RC_ALREADY  (KRACK gate!)
  //   * no empty row        -> RC_ENOSPC
  // ==========================================================================

  pub let rc_install_guard : (u64, u64) -> u64 !{mem} @{} =
    fn (key_id: u64) (initial_pn: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): KRACK-safe install gate. REFUSES a second install for a live key_id. Labels prefixed rc_ig_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        cmp rbx, 7;
        ja  rc_ig_bad_key;

        // Already installed?
        mov rdi, rbx;
        call rc_find_by_key_id;
        cmp rax, 0xFF;
        jne rc_ig_already;

        // Find empty row.
        xor r13, r13;
      rc_ig_scan:
        cmp r13, 8;
        jae rc_ig_enospc;
        lea r10, [rip + _rc_table];
        mov r11, r13;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        cmp rax, 0;
        je  rc_ig_claim;
        add r13, 1;
        jmp rc_ig_scan;

      rc_ig_claim:
        // in_use=1 | key_id<<8
        mov rax, 1;
        mov r11, rbx;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov [r10 + 8], r12;               // initial_pn
        mov [r10 + 16], r12;              // last_seen_pn := initial_pn
        xor rax, rax;
        mov [r10 + 24], rax;

        mov rdi, 0;                       // INSTALLS
        call rc_note;
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      rc_ig_bad_key:
        mov rdi, 1;
        call rc_note;
        mov rax, 0xFFFFF3BE;              // BAD_KEY_ID
        pop r13;
        pop r12;
        pop rbx;
        ret;
      rc_ig_already:
        mov rdi, 1;                       // INSTALLS_REFUSED
        call rc_note;
        mov rax, 0xFFFFF3BC;              // ALREADY -- KRACK gate!
        pop r13;
        pop r12;
        pop rbx;
        ret;
      rc_ig_enospc:
        mov rdi, 1;
        call rc_note;
        mov rax, 0xFFFFF3BD;              // ENOSPC
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // rc_recv_guard(key_id, pn) -> RC_OK | error
  //
  // Called on every RX with a valid MPDU header.  REFUSES if the PN
  // is <= the last one seen; otherwise updates last_seen_pn.
  //
  // Refuses:
  //   * key_id > 7          -> RC_BAD_KEY_ID
  //   * no live row         -> RC_NOT_INSTALLED
  //   * pn <= last_seen     -> RC_REPLAY  (the whole point of KRACK)
  // ==========================================================================

  pub let rc_recv_guard : (u64, u64) -> u64 !{mem} @{} =
    fn (key_id: u64) (pn: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): PN monotonicity gate on RX. Labels prefixed rc_rg_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        cmp rbx, 7;
        ja  rc_rg_bad_key;

        mov rdi, rbx;
        call rc_find_by_key_id;
        cmp rax, 0xFF;
        je  rc_rg_no_row;

        mov r13, rax;                     // row_id
        lea r10, [rip + _rc_table];
        mov r11, r13;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 16];              // last_seen_pn
        cmp r12, rax;
        jbe rc_rg_replay;

        // Admit: bump last_seen_pn.
        mov [r10 + 16], r12;
        mov rdi, 2;                       // RECVS
        call rc_note;
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      rc_rg_bad_key:
        mov rdi, 3;
        call rc_note;
        mov rax, 0xFFFFF3BE;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      rc_rg_no_row:
        mov rdi, 3;
        call rc_note;
        mov rax, 0xFFFFF3BB;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      rc_rg_replay:
        mov rdi, 4;                       // REPLAYS
        call rc_note;
        mov rdi, 3;                       // RECVS_REFUSED
        call rc_note;
        mov rax, 0xFFFFF3BA;              // REPLAY
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // rc_free(key_id) -> RC_OK | error
  //
  // Drop the live row for key_id.  Called on rekey, disconnect,
  // teardown.  Refuses if no live row.
  // ==========================================================================

  pub let rc_free : (u64) -> u64 !{mem} @{} =
    fn (key_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): drop live row for key_id. Labels prefixed rc_f_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;

        cmp rbx, 7;
        ja  rc_f_bad_key;

        mov rdi, rbx;
        call rc_find_by_key_id;
        cmp rax, 0xFF;
        je  rc_f_no_row;

        mov r12, rax;                     // row_id
        lea r10, [rip + _rc_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;

        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rdi, 5;                       // FREES
        call rc_note;
        xor rax, rax;
        pop r12;
        pop rbx;
        ret;

      rc_f_bad_key:
        mov rax, 0xFFFFF3BE;
        pop r12;
        pop rbx;
        ret;
      rc_f_no_row:
        mov rax, 0xFFFFF3BB;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Getters (for the witness + telemetry).
  // ==========================================================================

  pub let rc_last_seen : (u64) -> u64 !{mem} @{} =
    fn (key_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M5-004 (#1312): read last_seen_pn for key_id, or sentinel. Labels prefixed rc_ls_.",
      block: {
        push rbx;
        mov rbx, rdi;
        mov rdi, rbx;
        call rc_find_by_key_id;
        cmp rax, 0xFF;
        je  rc_ls_none;
        lea r10, [rip + _rc_table];
        mov r11, rax;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      rc_ls_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }
}
