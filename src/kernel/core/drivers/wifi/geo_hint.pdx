// src/kernel/core/drivers/wifi/geo_hint.pdx — R38.M6-003 (#1316)
//
// GEO-HINT DISCOVERY.  Reports a (country_code, confidence) pair to
// the ring-3 supervisor for regdomain arbitration.  Tries a USB
// modem GNSS receiver first (via an R40 stub -- placeholder call),
// then falls back to hardcoded WW.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DISCOVERY half of the geo/regdomain path.  A live
// supervisor composes:
//
//   geo_hint.gh_query()          -> (country_code, source, confidence)
//   regdomain_channel.rdc_pack() -> wire hint
//   regdom_loader.rdl_publish()  -> nrd_bind
//
// IT DOES NOT DRIVE A USB MODEM.  R40 is where CDC-ACM / MBIM
// transport, NMEA parsing and NEA/RMC decoding land.  Here the GNSS
// path is a STUB (gh_query_gnss_stub) that always reports
// "not available" -- the honest posture for a milestone that lands
// the arbitration surface without the transport underneath.
//
// IT DOES NOT WRITE net80211_regdom.  Publishing is the loader's
// business; this module reports a hint the loader (or its wire
// consumer through regdomain_channel) may or may not act on
// depending on its arbitration policy.
//
// gh_arbitrated() returns 0 until R40 wires the real modem into the
// stub call site.  A live path with two disagreeing hints (EEPROM
// says JP, GNSS says US) resolves through the arbitration policy
// the ring-3 supervisor owns.
//
// =============================================================================
// §1  SOURCES  (aligned with regdomain_channel.pdx RDC_SRC_*)
// =============================================================================
//
//   GH_SRC_NONE    = 0    (never queried)
//   GH_SRC_GNSS    = 2    (matches RDC_SRC_GNSS)
//   GH_SRC_DEFAULT = 3    (matches RDC_SRC_DEFAULT)
//
// Value 1 (RDC_SRC_EEPROM) is NOT assigned here -- the EEPROM path
// belongs to regdom_loader.  gh_source() reporting 1 would be a
// wiring bug and the value is deliberately left unclaimed in this
// enum to make that visible.
//
// =============================================================================
// §2  CONFIDENCE  (unitless 0..100)
// =============================================================================
//
//   GH_CONF_NONE = 0
//   GH_CONF_LOW  = 10   (DEFAULT / WW fallback)
//   GH_CONF_HIGH = 100  (GNSS lock)
//
// A live path may combine this with the (per-source) accuracy the
// GNSS transport reports; the coarse tier is what the arbitration
// policy switches on today.  Numbers are unitless -- the schema at
// the wire boundary does not carry confidence yet (regdomain_channel
// v1 packs only cc + source + ts); a future revision widens the
// payload.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// `_gh_state` and `_gh_stats` are written only by helpers in this
// module.  tools/build.sh confines relocations against both symbols
// to `core/drivers/wifi/geo_hint.o` so a second writer cannot
// silently forge a hint source or promote confidence.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF370..0xFFFFF37F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: regdomain_channel
// 0xFFFFF380..8F; adjacent free band below: available for future
// R38.M6+ modules).

module GeoHint = structure {

  // §1: source ordinals.
  pub let GH_SRC_NONE     : u64 = 0
  pub let GH_SRC_GNSS     : u64 = 2
  pub let GH_SRC_DEFAULT  : u64 = 3

  // §2: confidence tiers.
  pub let GH_CONF_NONE    : u64 = 0
  pub let GH_CONF_LOW     : u64 = 10
  pub let GH_CONF_HIGH    : u64 = 100

  // WW country code (aligned with regdom_loader.pdx RDL_CC_WW).
  pub let GH_CC_WW        : u64 = 0x5757

  // §4: failure taxonomy 0xFFFFF370..0xFFFFF37F.
  pub let GH_OK           : u64 = 0
  pub let GH_BAD_ARG      : u64 = 0xFFFFF37F
  pub let GH_NOT_QUERIED  : u64 = 0xFFFFF37E
  pub let GH_ALREADY      : u64 = 0xFFFFF37D
  pub let GH_GNSS_ABSENT  : u64 = 0xFFFFF37C   // honest signal, not a bug

  // §3: state cell layout.
  //   [0] queried (0 / 1)
  //   [1] source (GH_SRC_*)
  //   [2] country_code
  //   [3] confidence
  pub let mut _gh_state : [u64; 4] = uninit @align(64)
  pub let mut _gh_stats : [u64; 8] = uninit @align(64)

  pub let GH_STAT_QUERIES   : u64 = 0
  pub let GH_STAT_GNSS_HIT  : u64 = 1
  pub let GH_STAT_GNSS_MISS : u64 = 2
  pub let GH_STAT_DEFAULTS  : u64 = 3
  pub let GH_STAT_RESETS    : u64 = 4

  // ==========================================================================
  // Reset -- clear state + stats.  Boot + teardown.
  // ==========================================================================

  pub let gh_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): clear state + stats. Labels prefixed gh_rs_.",
      block: {
        lea r10, [rip + _gh_state];
        xor rax, rax;
        xor rcx, rcx;
      gh_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  gh_rs_st;

        lea r10, [rip + _gh_stats];
        xor rcx, rcx;
      gh_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gh_rs_ct;

        lea r10, [rip + _gh_stats];
        mov rax, [r10 + 32];              // RESETS slot
        add rax, 1;
        mov [r10 + 32], rax;
        ret
      }
    }

  pub let gh_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-003 (#1316): honesty pin. Returns 0 until R40 wires a real USB modem GNSS transport into gh_query_gnss_stub.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let gh_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): counter bump. Labels prefixed gh_nt_.",
      block: {
        cmp rdi, 8;
        jae gh_nt_out;
        lea r10, [rip + _gh_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      gh_nt_out:
        ret
      }
    }

  pub let gh_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): counter read. Labels prefixed gh_st_.",
      block: {
        cmp rdi, 8;
        jae gh_st_zero;
        lea r10, [rip + _gh_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      gh_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let gh_queried : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): read QUERIED flag.",
      block: {
        lea r10, [rip + _gh_state];
        mov rax, [r10];
        ret
      }
    }

  pub let gh_source : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): read source (0 if never queried).",
      block: {
        lea r10, [rip + _gh_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let gh_country : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): read country_code.",
      block: {
        lea r10, [rip + _gh_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let gh_confidence : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): read confidence tier.",
      block: {
        lea r10, [rip + _gh_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  // ==========================================================================
  // gh_query_gnss_stub(usb_modem_stub_id) -> country_code | 0
  //
  // R40 STUB.  A live path replaces this with a CDC-ACM / MBIM
  // transport that reads NMEA / RMC from the USB modem.  The stub
  // interprets a NON-ZERO argument as a synthetic GNSS-derived
  // country code (for tests that want to exercise the GNSS-hit path),
  // and 0 as "no modem present / no lock".
  //
  // Honesty pin: this function returns 0 for any argument on a real
  // boot until R40 wires the real transport, and gh_arbitrated()
  // reflects that.  The stub argument path exists exclusively for
  // synth witnesses to exercise the branch structure.
  // ==========================================================================

  pub let gh_query_gnss_stub : (u64) -> u64 !{} @{} =
    fn (usb_modem_stub_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M6-003 (#1316): R40 stub. Returns the argument unchanged (test seam) or 0 for absent. Labels prefixed gh_qg_.",
      block: {
        cmp rdi, 0;
        je  gh_qg_none;
        mov rax, rdi;
        ret;
      gh_qg_none:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // gh_query(usb_modem_stub_id) -> GH_OK | error
  //
  // Two-tier discovery:
  //   1. Try GNSS via the R40 stub.  Non-zero return -> record as
  //      (cc, GNSS, HIGH); 0 -> fall through.
  //   2. Fall back to (WW, DEFAULT, LOW).
  //
  // gh_query itself never fails on a fresh state -- the fallback is
  // always available.  It refuses ALREADY on a second call before
  // a reset (a caller that wants to re-query must call gh_reset).
  // ==========================================================================

  pub let gh_query : (u64) -> u64 !{mem} @{} =
    fn (usb_modem_stub_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M6-003 (#1316): two-tier discovery. GNSS first, DEFAULT fallback. Labels prefixed gh_qy_.",
      block: {
        push rbx;
        mov rbx, rdi;

        lea r10, [rip + _gh_state];
        mov rax, [r10];
        cmp rax, 0;
        jne gh_qy_dupe;

        mov rdi, 0;                       // QUERIES
        call gh_note;

        // Try GNSS.
        mov rdi, rbx;
        call gh_query_gnss_stub;
        cmp rax, 0;
        je  gh_qy_default;

        // GNSS hit: record (cc, GNSS, HIGH).
        push rax;                         // saved cc from stub
        lea r10, [rip + _gh_state];
        mov rcx, 1;
        mov [r10], rcx;                   // queried
        mov rcx, 2;                       // GH_SRC_GNSS
        mov [r10 + 8], rcx;
        pop rcx;
        mov [r10 + 16], rcx;              // cc
        mov rcx, 100;                     // GH_CONF_HIGH
        mov [r10 + 24], rcx;

        mov rdi, 1;                       // GNSS_HIT
        call gh_note;
        xor rax, rax;
        pop rbx;
        ret;

      gh_qy_default:
        mov rdi, 2;                       // GNSS_MISS
        call gh_note;

        lea r10, [rip + _gh_state];
        mov rax, 1;
        mov [r10], rax;                   // queried
        mov rax, 3;                       // GH_SRC_DEFAULT
        mov [r10 + 8], rax;
        mov rax, 0x5757;                  // WW
        mov [r10 + 16], rax;
        mov rax, 10;                      // GH_CONF_LOW
        mov [r10 + 24], rax;

        mov rdi, 3;                       // DEFAULTS
        call gh_note;
        xor rax, rax;
        pop rbx;
        ret;

      gh_qy_dupe:
        mov rax, 0xFFFFF37D;              // ALREADY
        pop rbx;
        ret
      }
    }
}
