// src/kernel/core/drivers/wifi/dma_domain.pdx — R38.M2-005 (#1298)
//
// PER-DRIVER DMA DOMAIN enforcement for the AX211 iwlwifi transport
// path.  Design D1.b (drivers confined to their own IOMMU domain):
// every TX/RX buffer PA a caller submits to tx_dma MUST fall inside
// the domain window this module records at bind time, and a submit
// whose buffer straddles or leaves the window is REFUSED before the
// doorbell writes.  The domain window is a single (base_pa, length)
// pair per bind -- shared between iwlwifi's TX ring, RX ring and
// (future) BT co-controller as one KIND_DMA_DOMAIN mint per the
// issue's "single KIND_DMA_DOMAIN for iwlwifi_driver + BT driver
// (shared)" deliverable.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the REFUSE-GATE half of D1.b.  A live IOMMU driver -- Intel
// VT-d, R21+ -- programs the domain's page tables and translates
// device-issued addresses through them; this scaffold performs the
// SOFTWARE HALF of that translation table's promise: the driver may
// only ask the device to touch buffers whose PAs are inside the
// domain the mint gave it.  A hardware translation that catches a
// mistake here would report a page-fault interrupt; a caller that
// asks in the first place is closing the door before the fault.
//
// IT DOES NOT MINT KIND_DMA_DOMAIN.  The kind lands with the wifi
// bring-up cluster in a later R38 milestone (M4+); this scaffold
// stashes the (base_pa, length) pair a live mint would carry and
// answers wdd_check() against it so tx_dma.pdx (R38.M2-002) can
// consult a single-writer state rather than passing the window
// through every submit.
//
// IT DOES NOT INSTALL PAGE-TABLE ENTRIES.  R21 VT-d owns the
// translation; this module owns the "did the caller ASK for the
// right thing" refusal.  A live path composes: this refusal first,
// then the hardware translation second.
//
// wdd_arbitrated() returns 0 until a live KIND_DMA_DOMAIN mint (R38
// wifi bring-up) binds this against a real IOMMU domain descriptor.
//
// =============================================================================
// §1  DOMAIN WINDOW SEMANTICS
// =============================================================================
//
// A domain window is a half-open interval [base_pa, base_pa + length).
// A submitted (buf_pa, buf_len) is inside iff BOTH
//   * buf_pa            >= base_pa
//   * buf_pa + buf_len  <= base_pa + length
// hold, with the sum computed WITHOUT wrap: an addition that
// overflows u64 is treated as OUT_OF_DOMAIN rather than as evidence
// the buffer happens to fit modulo 2^64.  A zero-length submit
// refuses as ZERO_LEN (a driver has no legitimate reason to enqueue
// an empty descriptor and the RX/TX rings would treat a length-zero
// TFD as "no bytes to move", which is a bug in the caller, not a
// state to admit).
//
// =============================================================================
// §2  ONE BINDING AT A TIME
// =============================================================================
//
// wdd_bind refuses a second bind while the first is live
// (ALREADY_BOUND).  A rebind must go through wdd_unbind first, so
// the caller cannot silently retarget the domain a live tx_dma
// path is already checking against.  R21 VT-d will additionally
// require the domain descriptor's owner-pid to match; this scaffold
// enforces the mutual-exclusion half of that ceremony.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _wdd_state and _wdd_stats are written only by helpers in this
// module.  tools/build.sh confines relocations against both symbols
// to `core/drivers/wifi/dma_domain.o` so a second writer cannot
// forge a domain binding or a check counter.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF480..0xFFFFF48F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every
// other kind/driver band (adjacent used band above: tx_dma
// 0xFFFFF490..9F, R38.M2-002; adjacent free band below: available
// for future R38.M2 modules).

module DmaDomain = structure {

  // §1: window state slot indices inside _wdd_state.
  pub let WDD_ST_BASE   : u64 = 0                // domain base PA
  pub let WDD_ST_LEN    : u64 = 1                // domain length (bytes)
  pub let WDD_ST_BOUND  : u64 = 2                // 0 = unbound, 1 = bound
  pub let WDD_ST_OWNER  : u64 = 3                // owner-pid (reserved)

  // Failure taxonomy — 0xFFFFF480..0xFFFFF48F.
  pub let WDD_OK              : u64 = 0
  pub let WDD_BAD_ARG         : u64 = 0xFFFFF48F
  pub let WDD_UNBOUND         : u64 = 0xFFFFF48E
  pub let WDD_OUT_OF_DOMAIN   : u64 = 0xFFFFF48D
  pub let WDD_ZERO_LEN        : u64 = 0xFFFFF48C
  pub let WDD_OVERFLOW        : u64 = 0xFFFFF48B
  pub let WDD_ALREADY_BOUND   : u64 = 0xFFFFF48A

  // §3: the one writer.
  pub let mut _wdd_state : [u64; 4] = uninit @align(64)
  pub let mut _wdd_stats : [u64; 8] = uninit @align(64)

  // Stat indices.
  pub let WDD_STAT_BINDS      : u64 = 0
  pub let WDD_STAT_UNBINDS    : u64 = 1
  pub let WDD_STAT_CHECKS     : u64 = 2
  pub let WDD_STAT_ADMITS     : u64 = 3
  pub let WDD_STAT_REFUSED    : u64 = 4
  pub let WDD_STAT_BIND_DUPES : u64 = 5

  // ==========================================================================
  // Reset — clear state and counters.  Boot + teardown.
  // ==========================================================================

  pub let wdd_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): clear state + stats. Labels prefixed wdd_rs_.",
      block: {
        lea r10, [rip + _wdd_state];
        xor rax, rax;
        xor rcx, rcx;
      wdd_rs_state:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  wdd_rs_state;

        lea r10, [rip + _wdd_stats];
        xor rcx, rcx;
      wdd_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wdd_rs_stats;
        ret
      }
    } @no_frame

  pub let wdd_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M2-005 (#1298): honesty pin. Returns 0 until a live KIND_DMA_DOMAIN mint replaces the software-only binding.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let wdd_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): counter bump. Labels prefixed wdd_nt_.",
      block: {
        cmp rdi, 8;
        jae wdd_nt_out;
        lea r10, [rip + _wdd_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wdd_nt_out:
        ret
      }
    } @no_frame

  pub let wdd_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): counter read. Labels prefixed wdd_st_.",
      block: {
        cmp rdi, 8;
        jae wdd_st_zero;
        lea r10, [rip + _wdd_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wdd_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // wdd_bound() -> u64  (1 iff a domain is currently bound)
  // ==========================================================================

  pub let wdd_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): read BOUND flag from _wdd_state[2].",
      block: {
        lea r10, [rip + _wdd_state];
        mov rax, [r10 + 16];              // WDD_ST_BOUND * 8
        ret
      }
    } @no_frame

  pub let wdd_domain_base : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): read BASE from _wdd_state[0].",
      block: {
        lea r10, [rip + _wdd_state];
        mov rax, [r10];                   // WDD_ST_BASE * 8 = 0
        ret
      }
    } @no_frame

  pub let wdd_domain_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): read LEN from _wdd_state[1].",
      block: {
        lea r10, [rip + _wdd_state];
        mov rax, [r10 + 8];               // WDD_ST_LEN * 8
        ret
      }
    } @no_frame

  // ==========================================================================
  // wdd_bind(base_pa, length) -> WDD_OK | error
  //
  // Refuses:
  //   * length == 0        -> WDD_ZERO_LEN
  //   * base + length wrap -> WDD_OVERFLOW
  //   * already bound      -> WDD_ALREADY_BOUND
  //
  // On admission: stamps (base, length, 1) into _wdd_state and bumps
  // BINDS.  A live mint would additionally record the owner-pid in
  // WDD_ST_OWNER; this scaffold leaves the slot at zero.
  // ==========================================================================

  pub let wdd_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (base_pa: u64) (length: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): bind domain window. Zero-length + overflow + already-bound refuse before any state write. Labels prefixed wdd_bd_.",
      block: {
        // Reject length == 0.
        cmp rsi, 0;
        je  wdd_bd_zero;

        // Reject base + length overflow (unsigned).  Overflow iff
        // (base + length) wraps below the original base -- cmp/jb
        // rather than `add`/`jc` because paideia-as uses cmp-relative
        // condition mnemonics.
        mov rax, rdi;
        add rax, rsi;
        cmp rax, rdi;
        jb  wdd_bd_overflow;

        // Reject if already bound.
        lea r10, [rip + _wdd_state];
        mov rax, [r10 + 16];              // BOUND slot
        cmp rax, 0;
        jne wdd_bd_dupe;

        // Admit: write (base, length, 1).
        mov [r10], rdi;                   // BASE
        mov [r10 + 8], rsi;               // LEN
        mov rax, 1;
        mov [r10 + 16], rax;              // BOUND

        mov rdi, 0;                       // WDD_STAT_BINDS
        call wdd_note;
        xor rax, rax;
        ret;

      wdd_bd_zero:
        mov rdi, 4;                       // REFUSED
        call wdd_note;
        mov rax, 0xFFFFF48C;              // WDD_ZERO_LEN
        ret;
      wdd_bd_overflow:
        mov rdi, 4;
        call wdd_note;
        mov rax, 0xFFFFF48B;              // WDD_OVERFLOW
        ret;
      wdd_bd_dupe:
        mov rdi, 5;                       // WDD_STAT_BIND_DUPES
        call wdd_note;
        mov rdi, 4;
        call wdd_note;
        mov rax, 0xFFFFF48A;              // WDD_ALREADY_BOUND
        ret
      }
    }

  // ==========================================================================
  // wdd_unbind() -> WDD_OK | WDD_UNBOUND
  //
  // Clears (base, length, bound).  Refuses when no domain is bound
  // so a stray unbind cannot silently pass.
  // ==========================================================================

  pub let wdd_unbind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): unbind. Refuses when unbound. Labels prefixed wdd_ub_.",
      block: {
        lea r10, [rip + _wdd_state];
        mov rax, [r10 + 16];              // BOUND
        cmp rax, 0;
        je  wdd_ub_unbound;

        xor rax, rax;
        mov [r10], rax;                   // BASE = 0
        mov [r10 + 8], rax;               // LEN = 0
        mov [r10 + 16], rax;              // BOUND = 0

        mov rdi, 1;                       // WDD_STAT_UNBINDS
        call wdd_note;
        xor rax, rax;
        ret;

      wdd_ub_unbound:
        mov rdi, 4;
        call wdd_note;
        mov rax, 0xFFFFF48E;              // WDD_UNBOUND
        ret
      }
    }

  // ==========================================================================
  // wdd_check(buf_pa, buf_len) -> WDD_OK | error
  //
  // §0: THE ONE ENTRY POINT tx_dma consults on every submit.  Order:
  //   1. bound (WDD_UNBOUND if not)
  //   2. buf_len != 0 (WDD_ZERO_LEN)
  //   3. buf_pa + buf_len does not overflow u64 (WDD_OVERFLOW)
  //   4. [buf_pa, buf_pa + buf_len) is contained in
  //      [base, base + length) (WDD_OUT_OF_DOMAIN)
  //
  // Bumps CHECKS on entry; ADMITS on OK; REFUSED on any refusal.
  // ==========================================================================

  pub let wdd_check : (u64, u64) -> u64 !{mem} @{} =
    fn (buf_pa: u64) (buf_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M2-005 (#1298): the one refuse-gate. Bound + non-zero length + no-overflow + containment, in that order. Labels prefixed wdd_ck_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                     // buf_pa
        mov r12, rsi;                     // buf_len

        mov rdi, 2;                       // WDD_STAT_CHECKS
        call wdd_note;

        // 1. bound?
        lea r10, [rip + _wdd_state];
        mov rax, [r10 + 16];              // BOUND
        cmp rax, 0;
        je  wdd_ck_unbound;

        // 2. buf_len != 0?
        cmp r12, 0;
        je  wdd_ck_zero;

        // 3. buf_pa + buf_len no wrap?
        mov rax, rbx;
        add rax, r12;
        cmp rax, rbx;
        jb  wdd_ck_overflow;

        // 4. containment.
        // low: buf_pa >= base
        mov rdx, [r10];                   // BASE
        cmp rbx, rdx;
        jb  wdd_ck_out;
        // high: buf_pa + buf_len <= base + length
        mov rcx, [r10 + 8];               // LEN
        add rdx, rcx;                     // BASE + LEN (BASE+LEN cannot wrap; wdd_bind rejected the overflow at admit)
        cmp rax, rdx;                     // rax = buf_pa + buf_len
        ja  wdd_ck_out;

        mov rdi, 3;                       // WDD_STAT_ADMITS
        call wdd_note;
        xor rax, rax;
        jmp wdd_ck_done;

      wdd_ck_unbound:
        mov rdi, 4;
        call wdd_note;
        mov rax, 0xFFFFF48E;              // WDD_UNBOUND
        jmp wdd_ck_done;
      wdd_ck_zero:
        mov rdi, 4;
        call wdd_note;
        mov rax, 0xFFFFF48C;              // WDD_ZERO_LEN
        jmp wdd_ck_done;
      wdd_ck_overflow:
        mov rdi, 4;
        call wdd_note;
        mov rax, 0xFFFFF48B;              // WDD_OVERFLOW
        jmp wdd_ck_done;
      wdd_ck_out:
        mov rdi, 4;
        call wdd_note;
        mov rax, 0xFFFFF48D;              // WDD_OUT_OF_DOMAIN

      wdd_ck_done:
        pop r12;
        pop rbx;
        ret
      }
    }
}
