// src/kernel/core/drivers/wifi/net80211_regdom.pdx — R38.M4-005 (#1308)
//
// REGULATORY-DOMAIN gate for the net80211 class driver.  Consumes the
// regdomain_id a KIND_WIFI_PHY row carries (R38.M3-001) and REFUSES
// any transmit / channel-switch that would drive a channel not
// allowed by that regdomain.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CHANNEL-ADMISSION gate that sits below tx_dma.  A caller
// that wants to enqueue a frame passes the CHANNEL the frame will
// egress on; this module refuses OUT-OF-DOMAIN channels before the
// bytes ever reach a doorbell.
//
// IT DOES NOT PARSE A COUNTRY IE.  The regdomain the phy carries was
// resolved at bring-up (from platform firmware, an OTP fuse or a
// country IE the driver decoded once); this module treats it as
// received truth and refuses only against it.  A live path adds
// dynamic regdom updates through nrd_rebind after a channel switch
// consumes a new country IE.
//
// IT DOES NOT ENFORCE POWER LIMITS.  A live regulatory regime also
// caps EIRP per channel; that lands with R38.M5+ (WPA3-SAE +
// EAPOL) once we have the framework for per-channel state.  Here
// the gate is CHANNEL binary admit/refuse.
//
// nrd_arbitrated() returns 0 until R38.M5+ composes this against a
// live PHY row + Country IE parser.
//
// =============================================================================
// §1  DOMAINS RECOGNISED
// =============================================================================
//
// Three regdomains are canonical enough to name in this scaffold:
//
//   NRD_DOMAIN_US = 0x0001  channels 1..11 (2.4 GHz)
//   NRD_DOMAIN_EU = 0x0002  channels 1..13 (2.4 GHz)
//   NRD_DOMAIN_JP = 0x0003  channels 1..14 (2.4 GHz)
//
// A regdom outside {US, EU, JP} is UNKNOWN.  The 5 GHz + 6 GHz bands
// are the next milestones' business.
//
// =============================================================================
// §2  BINDING PATHS
// =============================================================================
//
//   nrd_bind(regdom_id)         -- direct bind (a live path uses this
//                                  after resolving the regdom out of
//                                  platform firmware).
//   nrd_bind_from_phy(row_id)   -- reads regdom out of the KIND_WIFI_PHY
//                                  row via wphy_row_regdom and binds.
//                                  Refuses if the phy row is invalid
//                                  (the read returns the caps-layer
//                                  sentinel; this module maps it to
//                                  NRD_UNKNOWN_REGDOM without exposing
//                                  the sentinel through its own API).
//
// Rebind through nrd_unbind first.  A retarget without unbind is
// ALREADY_BOUND (the caller cannot silently swap the regulatory
// authority a live tx path is checking against).
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// `_nrd_state` and `_nrd_stats` are written only by helpers in this
// module.  tools/build.sh confines relocations against both symbols
// to `core/drivers/wifi/net80211_regdom.o` so a second writer cannot
// silently forge a regdomain admission.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF3F0..0xFFFFF3FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: net80211_mlme
// 0xFFFFF400..0F, R38.M4-003; adjacent free band below: available
// for future R38.M4+ modules).

module Net80211Regdom = structure {

  // §1: regdomain ids.
  pub let NRD_DOMAIN_UNKNOWN  : u64 = 0x0000
  pub let NRD_DOMAIN_US       : u64 = 0x0001
  pub let NRD_DOMAIN_EU       : u64 = 0x0002
  pub let NRD_DOMAIN_JP       : u64 = 0x0003

  // Channel ceilings per domain (2.4 GHz only this milestone).
  pub let NRD_US_MAX_CH       : u64 = 11
  pub let NRD_EU_MAX_CH       : u64 = 13
  pub let NRD_JP_MAX_CH       : u64 = 14

  // Failure taxonomy 0xFFFFF3F0..0xFFFFF3FF.
  pub let NRD_OK                  : u64 = 0
  pub let NRD_BAD_ARG             : u64 = 0xFFFFF3FF
  pub let NRD_NOT_BOUND           : u64 = 0xFFFFF3FE
  pub let NRD_UNKNOWN_REGDOM      : u64 = 0xFFFFF3FD
  pub let NRD_CHANNEL_FORBIDDEN   : u64 = 0xFFFFF3FC
  pub let NRD_ALREADY_BOUND       : u64 = 0xFFFFF3FB
  pub let NRD_BAD_CHANNEL         : u64 = 0xFFFFF3FA

  // §3: state cell layout.
  //   [0] bound (0 / 1)
  //   [1] regdom id
  pub let mut _nrd_state : [u64; 2] = uninit @align(64)
  pub let mut _nrd_stats : [u64; 8] = uninit @align(64)

  // Stat slot indices.
  pub let NRD_STAT_BINDS         : u64 = 0
  pub let NRD_STAT_UNBINDS       : u64 = 1
  pub let NRD_STAT_TX_CHECKS     : u64 = 2
  pub let NRD_STAT_TX_ADMITS     : u64 = 3
  pub let NRD_STAT_TX_REFUSED    : u64 = 4
  pub let NRD_STAT_SWITCH_CHECKS : u64 = 5
  pub let NRD_STAT_SWITCH_REFUSED: u64 = 6

  // ==========================================================================
  // Reset — unbound, no regdom, counters cleared.  Boot + teardown.
  // ==========================================================================

  pub let nrd_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): clear state + stats. Labels prefixed nrd_rs_.",
      block: {
        lea r10, [rip + _nrd_state];
        xor rax, rax;
        mov [r10], rax;
        mov [r10 + 8], rax;

        lea r10, [rip + _nrd_stats];
        xor rcx, rcx;
      nrd_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  nrd_rs_ct;
        ret
      }
    }

  pub let nrd_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M4-005 (#1308): honesty pin. Returns 0 until R38.M5+ wires this against a live PHY + Country IE parser.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let nrd_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): counter bump. Labels prefixed nrd_nt_.",
      block: {
        cmp rdi, 8;
        jae nrd_nt_out;
        lea r10, [rip + _nrd_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      nrd_nt_out:
        ret
      }
    }

  pub let nrd_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): counter read. Labels prefixed nrd_st_.",
      block: {
        cmp rdi, 8;
        jae nrd_st_zero;
        lea r10, [rip + _nrd_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      nrd_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let nrd_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): read BOUND flag.",
      block: {
        lea r10, [rip + _nrd_state];
        mov rax, [r10];
        ret
      }
    }

  pub let nrd_regdom : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): read bound regdom id (or 0 if unbound).",
      block: {
        lea r10, [rip + _nrd_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  // ==========================================================================
  // Regdom validator.  1 iff regdom_id is one of {US, EU, JP}.
  // ==========================================================================

  pub let nrd_regdom_valid : (u64) -> u64 !{} @{} =
    fn (regdom_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M4-005 (#1308): recognise US/EU/JP. Labels prefixed nrd_rv_.",
      block: {
        cmp rdi, 1;                       // US
        je  nrd_rv_yes;
        cmp rdi, 2;                       // EU
        je  nrd_rv_yes;
        cmp rdi, 3;                       // JP
        je  nrd_rv_yes;
        xor rax, rax;
        ret;
      nrd_rv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // Channel validator.  1 iff channel is 1..14 (2.4 GHz range).
  // ==========================================================================

  pub let nrd_channel_valid : (u64) -> u64 !{} @{} =
    fn (channel: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M4-005 (#1308): channel in [1..14]. Labels prefixed nrd_cv_.",
      block: {
        cmp rdi, 1;
        jb  nrd_cv_no;
        cmp rdi, 14;
        ja  nrd_cv_no;
        mov rax, 1;
        ret;
      nrd_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // nrd_bind(regdom_id) -> NRD_OK | error
  //
  // Refuses:
  //   * bound already            -> NRD_ALREADY_BOUND
  //   * regdom outside {US,EU,JP}-> NRD_UNKNOWN_REGDOM
  //
  // Stamps (regdom_id, 1) into _nrd_state and bumps BINDS.
  // ==========================================================================

  pub let nrd_bind : (u64) -> u64 !{mem} @{} =
    fn (regdom_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): direct regdom bind. Labels prefixed nrd_bd_.",
      block: {
        push rbx;
        mov rbx, rdi;

        lea r10, [rip + _nrd_state];
        mov rax, [r10];
        cmp rax, 0;
        jne nrd_bd_dupe;

        mov rdi, rbx;
        call nrd_regdom_valid;
        cmp rax, 0;
        je  nrd_bd_unk;

        lea r10, [rip + _nrd_state];
        mov rax, 1;
        mov [r10], rax;
        mov [r10 + 8], rbx;

        mov rdi, 0;                       // BINDS
        call nrd_note;
        xor rax, rax;
        pop rbx;
        ret;

      nrd_bd_dupe:
        mov rax, 0xFFFFF3FB;              // NRD_ALREADY_BOUND
        pop rbx;
        ret;
      nrd_bd_unk:
        mov rax, 0xFFFFF3FD;              // NRD_UNKNOWN_REGDOM
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nrd_bind_from_phy(phy_row_id) -> NRD_OK | error
  //
  // Reads regdomain_id out of a KIND_WIFI_PHY row via wphy_row_regdom
  // and binds through nrd_bind.  Maps the caps-layer sentinel
  // (0xFFFFFFFFFFFFFFFF, returned when the phy row's tail is invalid)
  // to NRD_UNKNOWN_REGDOM so this module's API does not surface a
  // foreign sentinel.  Also refuses if the extracted value is a valid
  // 16-bit id but names an UNKNOWN regdom (i.e. 0 or > 3).
  // ==========================================================================

  pub let nrd_bind_from_phy : (u64) -> u64 !{mem} @{} =
    fn (phy_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): read regdom from KIND_WIFI_PHY row and bind. Labels prefixed nrd_bp_.",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rdi, rbx;
        call wphy_row_regdom;
        // wphy sentinel = 0xFFFFFFFFFFFFFFFF for invalid row.
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  nrd_bp_unk;

        // Also refuse values that don't fit our 16-bit expectation
        // (caps layer already ANDs with 0xFFFF, but defence in depth).
        mov r11, 0xFFFF;
        cmp rax, r11;
        ja  nrd_bp_unk;

        // Delegate to nrd_bind (which validates + bumps + writes).
        mov rdi, rax;
        call nrd_bind;
        pop rbx;
        ret;

      nrd_bp_unk:
        mov rax, 0xFFFFF3FD;              // NRD_UNKNOWN_REGDOM
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nrd_unbind() -> NRD_OK | NRD_NOT_BOUND
  // ==========================================================================

  pub let nrd_unbind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): unbind. Refuses when unbound. Labels prefixed nrd_ub_.",
      block: {
        lea r10, [rip + _nrd_state];
        mov rax, [r10];
        cmp rax, 0;
        je  nrd_ub_notb;

        xor rax, rax;
        mov [r10], rax;
        mov [r10 + 8], rax;

        mov rdi, 1;                       // UNBINDS
        call nrd_note;
        xor rax, rax;
        ret;

      nrd_ub_notb:
        mov rax, 0xFFFFF3FE;              // NRD_NOT_BOUND
        ret
      }
    }

  // ==========================================================================
  // nrd_channel_allowed(channel) -> 1 iff allowed by BOUND regdom.
  //
  // A read-only query the class driver's channel-scan enumeration
  // uses to filter the set it advertises to a supplicant.  Returns 0
  // unless BOUND (unbound + no admission == no advertised channel).
  // ==========================================================================

  pub let nrd_channel_allowed : (u64) -> u64 !{mem} @{} =
    fn (channel: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): channel allowed under current regdom. Labels prefixed nrd_ca_.",
      block: {
        push rbx;
        mov rbx, rdi;

        lea r10, [rip + _nrd_state];
        mov rax, [r10];
        cmp rax, 0;
        je  nrd_ca_no;

        mov rdi, rbx;
        call nrd_channel_valid;
        cmp rax, 0;
        je  nrd_ca_no;

        lea r10, [rip + _nrd_state];
        mov rax, [r10 + 8];               // regdom
        cmp rax, 1;                       // US
        je  nrd_ca_us;
        cmp rax, 2;                       // EU
        je  nrd_ca_eu;
        cmp rax, 3;                       // JP
        je  nrd_ca_jp;
        jmp nrd_ca_no;

      nrd_ca_us:
        cmp rbx, 11;
        ja  nrd_ca_no;
        jmp nrd_ca_yes;
      nrd_ca_eu:
        cmp rbx, 13;
        ja  nrd_ca_no;
        jmp nrd_ca_yes;
      nrd_ca_jp:
        cmp rbx, 14;
        ja  nrd_ca_no;
        // fall through
      nrd_ca_yes:
        mov rax, 1;
        pop rbx;
        ret;
      nrd_ca_no:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nrd_tx_check(channel) -> NRD_OK | error
  //
  // The one refuse-gate a live tx path composes above tx_dma.wtxd_enqueue.
  // Refuses:
  //   * unbound             -> NRD_NOT_BOUND
  //   * channel invalid     -> NRD_BAD_CHANNEL
  //   * channel forbidden   -> NRD_CHANNEL_FORBIDDEN
  // Bumps TX_CHECKS on entry; TX_ADMITS on OK; TX_REFUSED on any refusal.
  // ==========================================================================

  pub let nrd_tx_check : (u64) -> u64 !{mem} @{} =
    fn (channel: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): tx admission against regdom. Labels prefixed nrd_tc_.",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rdi, 2;                       // TX_CHECKS
        call nrd_note;

        lea r10, [rip + _nrd_state];
        mov rax, [r10];
        cmp rax, 0;
        je  nrd_tc_notb;

        mov rdi, rbx;
        call nrd_channel_valid;
        cmp rax, 0;
        je  nrd_tc_bad_ch;

        mov rdi, rbx;
        call nrd_channel_allowed;
        cmp rax, 0;
        je  nrd_tc_forb;

        mov rdi, 3;                       // TX_ADMITS
        call nrd_note;
        xor rax, rax;
        pop rbx;
        ret;

      nrd_tc_notb:
        mov rdi, 4;
        call nrd_note;
        mov rax, 0xFFFFF3FE;
        pop rbx;
        ret;
      nrd_tc_bad_ch:
        mov rdi, 4;
        call nrd_note;
        mov rax, 0xFFFFF3FA;
        pop rbx;
        ret;
      nrd_tc_forb:
        mov rdi, 4;
        call nrd_note;
        mov rax, 0xFFFFF3FC;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nrd_switch_check(new_channel) -> NRD_OK | error
  //
  // Refuse-gate for channel-switch attempts.  Same refusal shape as
  // nrd_tx_check with a distinct counter (SWITCH_*) so an operator can
  // tell a driver hitting the regdom on transmit apart from one
  // hitting it on channel switch.
  // ==========================================================================

  pub let nrd_switch_check : (u64) -> u64 !{mem} @{} =
    fn (new_channel: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M4-005 (#1308): channel-switch admission. Labels prefixed nrd_sc_.",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rdi, 5;                       // SWITCH_CHECKS
        call nrd_note;

        lea r10, [rip + _nrd_state];
        mov rax, [r10];
        cmp rax, 0;
        je  nrd_sc_notb;

        mov rdi, rbx;
        call nrd_channel_valid;
        cmp rax, 0;
        je  nrd_sc_bad_ch;

        mov rdi, rbx;
        call nrd_channel_allowed;
        cmp rax, 0;
        je  nrd_sc_forb;

        xor rax, rax;
        pop rbx;
        ret;

      nrd_sc_notb:
        mov rdi, 6;
        call nrd_note;
        mov rax, 0xFFFFF3FE;
        pop rbx;
        ret;
      nrd_sc_bad_ch:
        mov rdi, 6;
        call nrd_note;
        mov rax, 0xFFFFF3FA;
        pop rbx;
        ret;
      nrd_sc_forb:
        mov rdi, 6;
        call nrd_note;
        mov rax, 0xFFFFF3FC;
        pop rbx;
        ret
      }
    }
}
