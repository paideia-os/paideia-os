// src/kernel/core/drivers/audio/hda_controller.pdx -- Wave 77 D15 [R33] (paideia-os #2532)
//
// Intel HDA (High Definition Audio) controller MMIO + CORB/RIRB bring-up.
// SKELETON.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// IT IS a fresh standalone module under `drivers/audio/` that owns the
// LIVE register-level bring-up of the Intel HDA / cAVS 2.5 controller:
// reset, CORB (Command Output Ring Buffer) and RIRB (Response Input
// Ring Buffer) DMA page allocation + base-register programming, and a
// `hda_send_verb(codec, nid, verb)` entrypoint D16 (Realtek ALC287
// codec driver) will consume. The caller supplies the BAR0 MMIO VA
// directly (`hda_init(bar0_mmio)`); the HDA PCI probe stays in
// `drivers/hda/controller.pdx` (R33.M1-001 #1137), which latches an
// opaque BAR handle and is deliberately a scaffold.
//
// IT IS NOT the probe. The two modules coexist for the same reason the
// drv/authority pair every KIND in this cap-table uses coexists:
// `drivers/hda/controller.pdx` is the PCI-record latch (`hda_
// controller_bind`, `hda_controller_read`, `hda_controller_write`),
// and THIS module is the register-level CORB/RIRB engine. Different
// state slots, different symbols, no overlap. R33.M2 wires the
// pci_enumerate_all probe into `hda_controller_bind`; the kernel
// then calls `hda_init(hda_controller_bar())` here to light the ring.
//
// IT IS a SKELETON. The MMIO writes are present and byte-exact against
// Intel HDA spec §3, but on QEMU the HDA device is not instantiated by
// default -- bar0_mmio == 0 is the overwhelming boot-time case and the
// init body refuses with HDA_ERR_MMIO_UNINITED. On real T14 G4 hardware
// the Realtek ALC287 codec hangs off this ring; D16 (next wave) wires
// the codec driver on top of `hda_send_verb`.
//
// =============================================================================
// SECTION 1  MMIO REGISTER MAP (Intel HDA Spec §3; offsets from BAR0)
// =============================================================================
//
//   0x00  u16  GCAP           - Global Capabilities
//                                bit  0   64OK  (64-bit addressing supported)
//                                bits [2:1]  NSDO (serial-data outputs count)
//                                bits [7:3]  BSS  (bidir stream count)
//                                bits [11:8] ISS  (input  stream count)
//                                bits [15:12] OSS (output stream count)
//   0x02  u8   VMIN           - minor version
//   0x03  u8   VMAJ           - major version (= 1 on cAVS 2.5)
//   0x08  u32  GCTL           - Global Control:
//                                bit  0  CRST   (0=in reset, 1=running)
//                                bit  1  FCNTRL (flush control)
//                                bit  8  UNSOL  (unsolicited-response enable)
//   0x0C  u16  WAKEEN         - wake enable (one bit per SDIN)
//   0x0E  u16  STATESTS       - codec plug status (one bit per codec; W1C)
//   0x20  u32  INTCTL         - interrupt control (bit 31 GIE, bit 30 CIE)
//   0x24  u32  INTSTS         - interrupt status
//   0x30  u32  WALCLK         - 24 MHz wall clock (link-position counter)
//   0x40  u32  CORBLBASE      - CORB base low  32b (128-B aligned)
//   0x44  u32  CORBUBASE      - CORB base high 32b
//   0x48  u16  CORBWP         - CORB write pointer (SW-written)
//   0x4A  u16  CORBRP         - CORB read  pointer (HW-written; bit 15 RST,
//                                SW-set / HW-clear on reset)
//   0x4C  u8   CORBCTL        - CORB control (bit 0 MEIE, bit 1 RUN)
//   0x4D  u8   CORBSTS        - CORB status  (bit 0 CMEI, W1C)
//   0x4E  u8   CORBSIZE       - CORB size (bits [1:0] encode entry count)
//   0x50  u32  RIRBLBASE      - RIRB base low  32b
//   0x54  u32  RIRBUBASE      - RIRB base high 32b
//   0x58  u16  RIRBWP         - RIRB write pointer (HW-written; bit 15 RST)
//   0x5A  u16  RINTCNT        - response interrupt count
//   0x5C  u8   RIRBCTL        - RIRB control (bit 0 RINTCTL, bit 1 RUN)
//   0x5D  u8   RIRBSTS        - RIRB status  (bit 0 RINTFL, bit 2 BOIS, W1C)
//   0x5E  u8   RIRBSIZE       - RIRB size (bits [1:0] encode entry count)
//
// All accesses sized per spec. 32-bit regs via `mov_d`; 16-bit via
// `mov_w`; 8-bit via `mov_b`. Any wider or narrower access is UB per
// Intel HDA spec §3.
//
// =============================================================================
// SECTION 2  CORB / RIRB LAYOUT
// =============================================================================
//
//   CORB entry is a 32-bit VERB:
//     bits [31:28] codec_addr   (0..15)
//     bits [27:20] nid          (node id, 0..255)
//     bits [19:8]  verb_id      (12-bit opcode)
//     bits  [7:0]  payload      (opcode-specific)
//
//   RIRB entry is 64-bit:
//     bits  [31:0] response     (codec data)
//     bits [63:32] extended     (codec_addr, solicited bit, timestamp)
//
//   Default sizes (CORBSIZE=0x02, RIRBSIZE=0x02):
//     CORB = 256 entries * 4 B = 1024 B (1 KiB).
//     RIRB = 256 entries * 8 B = 2048 B (2 KiB).
//
//   Each ring sits in its own 4 KiB page (phys_alloc(0)). HDA requires
//   128-byte alignment; a page is 4096-byte-aligned, which satisfies.
//   The remainder of each page is reserved for a future extension (DMA
//   position buffer, aux ring tails).
//
// =============================================================================
// SECTION 3  RETURN CODES (reserved from the 0xFFFFFE00 block)
// =============================================================================
//
// Grep audit at landing time (Wave 77):
//   grep -rhE "0xFFFFFE2[1-5]" src/   -> ZERO hits before this file.
// Grep audit at landing time proved 0xFFFFFEEA..EE already consumed by
// drivers/gpio/gpio_pad.pdx; the HDA codes slide to the 0xFFFFFE2x
// contiguous free block instead.
//
//   HDA_ERR_MMIO_UNINITED   0xFFFFFE21  - bar0_mmio == 0 at a send_verb
//                                          or read_wall_clock call
//                                          (hda_init was not yet called,
//                                          or init refused and the latch
//                                          is still zero).
//   HDA_ERR_CRST_TIMEOUT    0xFFFFFE22  - the GCTL.CRST transition
//                                          (reset -> run or run -> reset)
//                                          did not complete within the
//                                          bounded poll budget.
//   HDA_ERR_CORB_OVERFLOW   0xFFFFFE23  - CORBWP would overtake CORBRP
//                                          on a send_verb (CORB full;
//                                          at skeleton this is a defense
//                                          against a wild WP, since the
//                                          ring is sized 256 and no one
//                                          holds > 1 outstanding verb).
//   HDA_ERR_RIRB_UNDERFLOW  0xFFFFFE24  - a send_verb polled RIRB and
//                                          RIRBWP never advanced past
//                                          our last-known tail.
//   HDA_ERR_VERB_TIMEOUT    0xFFFFFE25  - the response poll exhausted
//                                          its iteration budget without
//                                          seeing CORBRP catch up to WP.
//
// =============================================================================
// SECTION 4  KIND SLOT
// =============================================================================
//
// KIND_HDA (= 0x48, 72). Derived kind over KIND_DEVICE (base slot 10)
// since the HDA controller is a PCI device whose per-ring state is
// bound to one device descriptor. Dispatch arm added to
// `cap/invoke.pdx`:
//
//   cmp rcx, 0x48;
//   je  call_kind_hda;
//
// 0x48 fits imm32 with bit 31 clear so no r9 staging; direct form
// matches KIND_BACKLIGHT_DRV (0x44) and KIND_I2C_HID_DRV (0x45) in
// the same block. Grep audit at landing time:
//
//   grep -nE "cmp rcx, 0x48\b" src/kernel/core/cap/invoke.pdx
//
// returned ZERO existing arms. D14 (0x47) and G7 (0x46) land in
// parallel; this file claims 0x48 only.
//
// =============================================================================
// SECTION 5  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized MMIO) -- every 32-bit MMIO store/load uses mov_d; every
//     16-bit via mov_w; every 8-bit via mov_b. Any wider access is UB
//     per Intel HDA §3.
//   G4 (full-register compares) -- every cmp is on a 64-bit register.
//   No `test rN, rN` (equality-against-zero is `cmp rN, 0`).
//   No `and r11, imm64` -- every mask fits imm32; the one 64-bit
//     immediate (KERNEL_VMA_BASE = 0xFFFF800000000000) uses `sub rN,
//     imm` which paideia-as encodes directly (precedent: boot/witness/
//     early_mm.pdx L277). No `and r,imm64` appears here.
//   No 2-op `imul r, imm` -- the one multiplication (verb pack) uses
//     shl + or chaining; the two scales (codec_addr<<28, nid<<20,
//     verb_id<<8) are all `shl r, imm` plain forms.
//   No multiline `pub let ="..."` -- every string tag is a single-line
//     literal with explicit trailing `\0`.
//   Module basename -- HdaController matches `hda_controller.pdx`.
//   Reserved-label discipline -- every label is prefixed `hda_in_`,
//     `hda_sv_`, `hda_rs_`, `hda_wc_` or `hda_hd_` (never `loop`,
//     `if`, `let`, `done`, `next`).
//   klog variants -- the per-arity wrappers obey the caller [rsp+0]
//     NOT [rsp+8] convention (I7 regression trap). Stack recipe at
//     every call site documents which `sub rsp, N` lands which v{d,x}
//     at which caller offset.
//   Fingerprint tag `[u8; N]` -- N = len(string literal) + 1 (the
//     trailing `\0`).
//
// =============================================================================
// SECTION 6  FINGERPRINT WIRE FORMAT
// =============================================================================
//
// Two tags, one per entrypoint, matching tests/fingerprints/
// hda_controller.golden:
//
//   HDA INIT codecs_present=0x<4-hex>
//   HDA VERB codec=<dec> nid=<dec>
//   HDA RESP verb=0x<8-hex> response=0x<8-hex>
//
// `HDA VERB` is a two-line pair: `klog_s1_d2` emits codec+nid as
// decimals; a follow-on `klog_s1_x2` emits verb+response as hex. A
// one-line four-KV mixed-format wrapper (`klog_s1_d2_x2`) does not
// exist in klog/wrappers.pdx at Wave 77 D15; splitting is simpler
// than minting a new wrapper for a skeleton emission. D16's codec
// driver, which issues verbs through this seam, will see the pair.
//
// Golden entries:
//   HDA INIT codecs_present=0x<4-hex>
//   HDA VERB codec=<dec> nid=<dec>
//   HDA RESP verb=0x<8-hex> response=0x<8-hex>
//
// =============================================================================
// SECTION 7  STACK + REGISTER PLAN
// =============================================================================
//
// hda_init:
//   Prologue: push rbx, r12, r13 (3 * 8 = 24 B). Entry rsp%16==8, after
//   3 pushes rsp%16==0 (aligned pre-CALL). sub rsp, 16 to stage one
//   stack arg for klog_s1_x1 is NOT needed on INIT (we use klog_s1_x1
//   whose signature carries codecs_present in r8 directly). rbx holds
//   bar0_mmio; r12 holds CORB VA; r13 holds RIRB VA.
//
// hda_send_verb:
//   Prologue: push rbx, rbp, r12, r13, r14 (5 pushes = 40 B). Entry
//   rsp%16==8, after 5 pushes rsp%16==0. rbx=bar0, rbp=codec_addr,
//   r12=nid, r13=verb_id (payload merged), r14=response. For the
//   klog_s1_d2 (v2=nid on caller stack) and klog_s1_x2 (v2=response
//   on caller stack) calls, sub rsp,16 + mov [rsp+0], <v2> stages
//   the 7th-arg; add rsp,16 reclaims. The v at caller [rsp+0] NOT
//   [rsp+8] trap (I7 regression) is baked into every klog_s1_x2 /
//   klog_s1_d2 call site in this file.
//
// hda_reset_controller:
//   Prologue: push rbx (1 * 8 = 8 B). Entry rsp%16==8; one push lands
//   rsp%16==0 (aligned). rbx holds bar0_mmio. Pure MMIO + bounded
//   poll; no nested calls other than the klog chatter deferred to
//   the caller.
//
// hda_read_wall_clock, hda_mmio_base_q and the stats getters: leaf.
//
// cap_handler_hda:
//   Prologue: push rbx, r12, r13 (3 * 8 = 24 B); rbx=rights, r12=
//   target_ptr (unused at skeleton), r13=op_code. Entry rsp%16==8,
//   after 3 pushes rsp%16==0. Labels prefixed `hda_hd_`.
//
// =============================================================================

module HdaController = structure {

  // ==========================================================================
  // §A  KIND / rights
  // ==========================================================================

  pub let KIND_HDA      : u64 = 0x48          // Wave 77 D15 derived-kind tag
  pub let KIND_HDA_BASE : u64 = 10            // = KIND_DEVICE

  pub let R_HDA_READ   : u64 = 0x001          // query ops (wall clock, stats)
  pub let R_HDA_WRITE  : u64 = 0x002          // mutate ops (reset, send_verb)
  pub let R_HDA_ALL    : u64 = 0x003          // handed to the holder on create

  // ==========================================================================
  // §B  MMIO offsets (BAR0-relative; Intel HDA Spec §3)
  // ==========================================================================

  pub let HDA_GCAP      : u64 = 0x00
  pub let HDA_VMIN      : u64 = 0x02
  pub let HDA_VMAJ      : u64 = 0x03
  pub let HDA_GCTL      : u64 = 0x08
  pub let HDA_WAKEEN    : u64 = 0x0C
  pub let HDA_STATESTS  : u64 = 0x0E
  pub let HDA_INTCTL    : u64 = 0x20
  pub let HDA_INTSTS    : u64 = 0x24
  pub let HDA_WALCLK    : u64 = 0x30
  pub let HDA_CORBLBASE : u64 = 0x40
  pub let HDA_CORBUBASE : u64 = 0x44
  pub let HDA_CORBWP    : u64 = 0x48
  pub let HDA_CORBRP    : u64 = 0x4A
  pub let HDA_CORBCTL   : u64 = 0x4C
  pub let HDA_CORBSTS   : u64 = 0x4D
  pub let HDA_CORBSIZE  : u64 = 0x4E
  pub let HDA_RIRBLBASE : u64 = 0x50
  pub let HDA_RIRBUBASE : u64 = 0x54
  pub let HDA_RIRBWP    : u64 = 0x58
  pub let HDA_RINTCNT   : u64 = 0x5A
  pub let HDA_RIRBCTL   : u64 = 0x5C
  pub let HDA_RIRBSTS   : u64 = 0x5D
  pub let HDA_RIRBSIZE  : u64 = 0x5E

  // Bit masks (fit imm32; staged in r10 at every cmp site for clarity).
  pub let HDA_GCTL_CRST    : u64 = 0x1
  pub let HDA_CORBSIZE_256 : u64 = 0x2        // bits[1:0] = 0b10 -> 256 entries
  pub let HDA_RIRBSIZE_256 : u64 = 0x2
  pub let HDA_CORBCTL_RUN  : u64 = 0x2
  pub let HDA_RIRBCTL_RUN  : u64 = 0x2
  pub let HDA_CORB_RP_RST  : u64 = 0x8000     // bit 15 of CORBRP
  pub let HDA_RIRB_WP_RST  : u64 = 0x8000     // bit 15 of RIRBWP

  // Poll bound (iterations). 4096 is the same ceiling nvme_identify
  // and i2c_hid use on their status-bit polls; a HDA CRST transition
  // on real hardware lands in O(100ns) so 4096 is loose, intentional
  // for QEMU no-op completion as well.
  pub let HDA_POLL_MAX  : u64 = 4096

  // ==========================================================================
  // §C  Return codes
  // ==========================================================================

  pub let HDA_OK                   : u64 = 0
  pub let HDA_ERR_MMIO_UNINITED    : u64 = 0xFFFFFE21
  pub let HDA_ERR_CRST_TIMEOUT     : u64 = 0xFFFFFE22
  pub let HDA_ERR_CORB_OVERFLOW    : u64 = 0xFFFFFE23
  pub let HDA_ERR_RIRB_UNDERFLOW   : u64 = 0xFFFFFE24
  pub let HDA_ERR_VERB_TIMEOUT     : u64 = 0xFFFFFE25

  // Standard cap_invoke sentinels (full 64-bit).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // ==========================================================================
  // §D  cap_handler_hda op ordinals
  // ==========================================================================

  pub let HDA_OP_READ_WALL_CLOCK  : u64 = 0   // -> HDA_WALCLK register
  pub let HDA_OP_QUERY_CODECS     : u64 = 1   // -> last STATESTS mask
  pub let HDA_OP_QUERY_VERB_COUNT : u64 = 2   // -> _hda_verb_ct tally
  pub let HDA_OP_RESET            : u64 = 3   // -> hda_reset_controller
  pub let HDA_OP_MAX              : u64 = 3

  // ==========================================================================
  // §E  Module-local state
  //
  // Four scalars + two ring-page latches + three counters.
  //   _hda_bar0           -- the live BAR0 VA (0 iff hda_init refused).
  //   _hda_codecs_present -- STATESTS mask read at init time (per-SDI).
  //   _hda_corb_va        -- phys_alloc()-returned kernel VA for CORB page.
  //   _hda_rirb_va        -- phys_alloc()-returned kernel VA for RIRB page.
  //   _hda_last_wp        -- last SW-written CORBWP (ring cursor; 0 at init).
  //   _hda_init_ct        -- bump on each successful hda_init entry.
  //   _hda_verb_ct        -- bump on each successful hda_send_verb entry.
  //   _hda_reset_ct       -- bump on each successful hda_reset_controller.
  //
  // No per-codec row table at skeleton: D16 ALC287 driver sits on top
  // of this seam and holds the per-codec state itself. A follow-up
  // slice adds a 4-slot codec-row table here when a second codec can
  // coexist on the link (SDI1 of a dock audio dongle, etc.).
  // ==========================================================================

  pub let mut _hda_bar0           : u64 = 0
  pub let mut _hda_codecs_present : u64 = 0
  pub let mut _hda_corb_va        : u64 = 0
  pub let mut _hda_rirb_va        : u64 = 0
  pub let mut _hda_last_wp        : u64 = 0
  pub let mut _hda_init_ct        : u64 = 0
  pub let mut _hda_verb_ct        : u64 = 0
  pub let mut _hda_reset_ct       : u64 = 0

  // ==========================================================================
  // §F  Fingerprint tags + keys
  //
  // tag sizes count the trailing NUL. Measured byte-exact against the
  // golden template `tests/fingerprints/hda_controller.golden`.
  // ==========================================================================

  pub let hda_tag_init     : [u8; 9]  = "HDA INIT\0"
  pub let hda_tag_verb     : [u8; 9]  = "HDA VERB\0"
  pub let hda_tag_resp     : [u8; 9]  = "HDA RESP\0"
  pub let hda_tag_entry    : [u8; 21] = "KIND_HDA dispatch iv\0"

  pub let hda_k_codecs     : [u8; 15] = "codecs_present\0"
  pub let hda_k_codec      : [u8; 6]  = "codec\0"
  pub let hda_k_nid        : [u8; 4]  = "nid\0"
  pub let hda_k_verb       : [u8; 5]  = "verb\0"
  pub let hda_k_response   : [u8; 9]  = "response\0"

  // ==========================================================================
  // §G  hda_reset_controller(bar0) -> u64
  //
  // Toggle GCTL.CRST: write 0 (enter reset), poll until low; write 1
  // (leave reset), poll until high. Bounded iteration budget
  // (HDA_POLL_MAX) returns HDA_ERR_CRST_TIMEOUT. No fingerprint on
  // reset itself (the init path emits one for the composite).
  //
  // SysV: rdi = bar0 (direct arg; the public getter uses _hda_bar0).
  // Returns HDA_OK or HDA_ERR_CRST_TIMEOUT.
  // ==========================================================================
  pub let hda_reset_controller : (u64) -> u64 !{mem, sysreg} @{} =
    fn (bar0: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532). GCTL.CRST toggle sequence: (1) mov_d [bar0+0x08], 0 enters reset; (2) spin reading mov_d rax, [bar0+0x08] until bit0 clears or HDA_POLL_MAX exhausts; (3) mov_d [bar0+0x08], 1 leaves reset; (4) spin until bit0 sets. Encoder posture: 32-bit MMIO via mov_d; no test r,r (cmp rN,0); no and r,imm64 (CRST mask fits imm32 as 0x1). Register plan: rbx = bar0 (saved for use after each MMIO), r10 = scratch base, r11 = scratch (poll ctr), rcx = scratch value. Entry rsp%16==8; one push rbx lands rsp%16==0 (aligned, no nested CALL). Labels prefixed hda_rs_. Return path: HDA_OK on both polls complete; HDA_ERR_CRST_TIMEOUT on either budget exhausted. Bump _hda_reset_ct only on the success exit.",
      block: {
        push rbx;
        mov rbx, rdi;                        // bar0

        // --- Phase 1: enter reset (GCTL.CRST = 0).
        mov r10, rbx;
        add r10, 0x08;                       // HDA_GCTL
        xor rcx, rcx;
        mov_d [r10], rcx;

        // --- Phase 2: spin until GCTL.CRST reads 0.
        xor r11, r11;                        // poll ctr
      hda_rs_wait_low:
        mov r10, rbx;
        add r10, 0x08;
        xor rax, rax;
        mov_d rax, [r10];
        mov rcx, 0x1;
        and rax, rcx;                        // isolate CRST
        cmp rax, 0;
        je  hda_rs_low_ok;
        add r11, 1;
        cmp r11, 4096;                       // HDA_POLL_MAX
        jb  hda_rs_wait_low;
        jmp hda_rs_timeout;

      hda_rs_low_ok:
        // --- Phase 3: leave reset (GCTL.CRST = 1).
        mov r10, rbx;
        add r10, 0x08;
        mov rcx, 1;
        mov_d [r10], rcx;

        // --- Phase 4: spin until GCTL.CRST reads 1.
        xor r11, r11;
      hda_rs_wait_high:
        mov r10, rbx;
        add r10, 0x08;
        xor rax, rax;
        mov_d rax, [r10];
        mov rcx, 0x1;
        and rax, rcx;
        cmp rax, 1;
        je  hda_rs_high_ok;
        add r11, 1;
        cmp r11, 4096;
        jb  hda_rs_wait_high;
        jmp hda_rs_timeout;

      hda_rs_high_ok:
        mov rax, [rip + _hda_reset_ct];
        add rax, 1;
        mov [rip + _hda_reset_ct], rax;
        xor rax, rax;                        // HDA_OK
        jmp hda_rs_out;

      hda_rs_timeout:
        mov rax, 0xFFFFFE22;                 // HDA_ERR_CRST_TIMEOUT

      hda_rs_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  hda_init(bar0_mmio) -> u64
  //
  // (1) Reject bar0_mmio == 0 (QEMU no-device gate).
  // (2) Reset the controller via hda_reset_controller(bar0).
  // (3) Allocate two 4 KiB pages via phys_alloc(0) -- one for CORB,
  //     one for RIRB. On any allocation failure, refuse without
  //     half-programming the base registers.
  // (4) Stash the kernel VAs in _hda_corb_va / _hda_rirb_va and
  //     compute each page's PA = VA - KERNEL_VMA_BASE.
  // (5) Program CORBLBASE/CORBUBASE and RIRBLBASE/RIRBUBASE.
  // (6) Reset the ring pointers: write CORBRP.RST (bit 15); wait for
  //     readback == 0x8000; clear; wait for readback == 0. Repeat the
  //     dance for RIRBWP.RST. (At skeleton we stop at the first
  //     reset-set write; on QEMU readbacks return garbage anyway and
  //     D16 verifies the real-HW ordering.)
  // (7) Program CORBSIZE / RIRBSIZE to 256 entries.
  // (8) Set CORBCTL.RUN and RIRBCTL.RUN (bit 1).
  // (9) Read STATESTS (u16); stash into _hda_codecs_present.
  // (10) Latch bar0 into _hda_bar0, bump _hda_init_ct.
  // (11) Emit `HDA INIT codecs_present=0x<hex>` via klog_s1_x1.
  //
  // SysV: rdi = bar0_mmio.
  // Returns HDA_OK, HDA_ERR_MMIO_UNINITED, or HDA_ERR_CRST_TIMEOUT.
  // ==========================================================================
  pub let hda_init : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (bar0_mmio: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 77 D15 (paideia-os#2532). Entry gate: bar0_mmio == 0 -> HDA_ERR_MMIO_UNINITED (QEMU no-device case; the common boot path, matches edp_backlight.pdx dpcd_base==0 refuse arm). Reset the controller first (hda_reset_controller), then phys_alloc(0) twice for the CORB (1 KiB used of a 4 KiB page) and RIRB (2 KiB used of a 4 KiB page). The PAs are VA - 0xFFFF800000000000 (precedent: boot/witness/early_mm.pdx L277 for sub rN,imm64); the HDA controller needs the PA in its base registers because it is a bus master. Program CORBLBASE/UBASE and RIRBLBASE/UBASE (four 32-bit mov_d writes). Program CORBSIZE/RIRBSIZE = 256 entries (0x02 in bits[1:0]) and CORBCTL.RUN / RIRBCTL.RUN (bit 1 of each). Read STATESTS (u16) to learn which codecs are present. Fingerprint via klog_s1_x1 (hex KV codecs_present). Encoder posture: 32-bit MMIO via mov_d; 16-bit via mov_w; 8-bit via mov_b; no test r,r; no and r,imm64 (every mask fits imm32); no imul r,imm 2-op. VA->PA via sub rN,0xFFFF800000000000 (6-byte REX.W 2D form) same as kpti.pdx and aspace_map.pdx precedents. Register plan: rbx = bar0 (saved from rdi), r12 = CORB VA, r13 = RIRB VA. Entry rsp%16==8; three pushes land rsp%16==0 pre-CALL. Labels prefixed hda_in_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // bar0_mmio

        // --- Gate 0: bar0 == 0.
        cmp rbx, 0;
        je  hda_in_refuse_mmio;

        // --- Reset the controller.
        mov rdi, rbx;
        call hda_reset_controller;
        cmp rax, 0;
        jne hda_in_refuse_reset;

        // --- Allocate CORB page.
        xor rdi, rdi;
        call phys_alloc;
        cmp rax, 0;
        je  hda_in_refuse_mmio;              // out of memory -> MMIO uninit
        mov r12, rax;                        // CORB VA

        // --- Allocate RIRB page.
        xor rdi, rdi;
        call phys_alloc;
        cmp rax, 0;
        je  hda_in_refuse_mmio;
        mov r13, rax;                        // RIRB VA

        // Latch VAs (visible to accessors + follow-up MMIO).
        mov [rip + _hda_corb_va], r12;
        mov [rip + _hda_rirb_va], r13;

        // --- CORBLBASE (low 32b of CORB PA).
        mov rax, r12;
        sub rax, 0xFFFF800000000000;         // CORB PA (bus-master view)
        mov r10, rbx;
        add r10, 0x40;                       // HDA_CORBLBASE
        mov_d [r10], rax;                    // low 32 bits (mov_d truncates)

        // --- CORBUBASE (high 32b).
        mov rax, r12;
        sub rax, 0xFFFF800000000000;
        shr rax, 32;
        mov r10, rbx;
        add r10, 0x44;                       // HDA_CORBUBASE
        mov_d [r10], rax;

        // --- RIRBLBASE.
        mov rax, r13;
        sub rax, 0xFFFF800000000000;
        mov r10, rbx;
        add r10, 0x50;                       // HDA_RIRBLBASE
        mov_d [r10], rax;

        // --- RIRBUBASE.
        mov rax, r13;
        sub rax, 0xFFFF800000000000;
        shr rax, 32;
        mov r10, rbx;
        add r10, 0x54;                       // HDA_RIRBUBASE
        mov_d [r10], rax;

        // --- CORBSIZE = 256 entries (bits[1:0] = 0b10).
        mov r10, rbx;
        add r10, 0x4E;                       // HDA_CORBSIZE
        mov rcx, 0x2;
        mov_b [r10], rcx;

        // --- RIRBSIZE = 256 entries.
        mov r10, rbx;
        add r10, 0x5E;                       // HDA_RIRBSIZE
        mov rcx, 0x2;
        mov_b [r10], rcx;

        // --- Clear CORBWP = 0.
        mov r10, rbx;
        add r10, 0x48;                       // HDA_CORBWP
        xor rcx, rcx;
        mov_w [r10], rcx;

        // --- Reset the ring pointers (write bit 15 of CORBRP + RIRBWP;
        //     real-HW readback-poll deferred to the follow-up slice).
        mov r10, rbx;
        add r10, 0x4A;                       // HDA_CORBRP
        mov rcx, 0x8000;                     // HDA_CORB_RP_RST
        mov_w [r10], rcx;

        mov r10, rbx;
        add r10, 0x58;                       // HDA_RIRBWP
        mov rcx, 0x8000;                     // HDA_RIRB_WP_RST
        mov_w [r10], rcx;

        // --- CORBCTL.RUN = 1, RIRBCTL.RUN = 1.
        mov r10, rbx;
        add r10, 0x4C;                       // HDA_CORBCTL
        mov rcx, 0x2;                        // HDA_CORBCTL_RUN
        mov_b [r10], rcx;

        mov r10, rbx;
        add r10, 0x5C;                       // HDA_RIRBCTL
        mov rcx, 0x2;                        // HDA_RIRBCTL_RUN
        mov_b [r10], rcx;

        // --- Read STATESTS (u16; one bit per codec).
        mov r10, rbx;
        add r10, 0x0E;                       // HDA_STATESTS
        xor rax, rax;
        mov_w rax, [r10];
        mov [rip + _hda_codecs_present], rax;

        // --- Latch bar0 and bump init count.
        mov [rip + _hda_bar0], rbx;
        xor rax, rax;
        mov [rip + _hda_last_wp], rax;
        mov rax, [rip + _hda_init_ct];
        add rax, 1;
        mov [rip + _hda_init_ct], rax;

        // --- Fingerprint: `HDA INIT codecs_present=0x<4-hex>`.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + hda_tag_init];
        lea rcx, [rip + hda_k_codecs];
        mov r8, [rip + _hda_codecs_present];
        call klog_s1_x1;

        xor rax, rax;                        // HDA_OK
        jmp hda_in_out;

      hda_in_refuse_mmio:
        mov rax, 0xFFFFFE21;                 // HDA_ERR_MMIO_UNINITED
        jmp hda_in_out;
      hda_in_refuse_reset:
        // rax already holds the CRST timeout error from the nested call.

      hda_in_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  hda_send_verb(codec_addr, nid, verb) -> u64
  //
  // Pack the 32-bit CORB verb:
  //   bits [31:28] codec_addr (& 0xF)
  //   bits [27:20] nid        (& 0xFF)
  //   bits [19:0]  verb       (& 0xFFFFF -- 12-bit opcode + 8-bit payload)
  //
  // Write the packed verb into the next CORB entry
  // (CORB[(_hda_last_wp + 1) & 0xFF]) via a 32-bit mov_d into the CORB
  // page, bump CORBWP (u16 MMIO write), bounded-poll RIRBWP until it
  // advances past our previous tail, read the 64-bit RIRB entry at
  // the new tail, return the low 32-bit response in rax.
  //
  // SysV: rdi = codec_addr, rsi = nid, rdx = verb.
  // Returns the 32-bit codec response, or HDA_ERR_MMIO_UNINITED /
  // HDA_ERR_CORB_OVERFLOW / HDA_ERR_VERB_TIMEOUT.
  // ==========================================================================
  pub let hda_send_verb : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (codec_addr: u64) (nid: u64) (verb: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532). (1) Gate _hda_bar0==0 (hda_init not called) -> HDA_ERR_MMIO_UNINITED. (2) Pack 32-bit verb: codec_addr<<28 | nid<<20 | verb (masked to 20b). The masks (0xF, 0xFF, 0xFFFFF) all fit imm32 so plain `and r,imm` is safe (no r11 staging needed). (3) Advance CORBWP: new_wp = (last_wp + 1) & 0xFF (ring index). (4) Store packed verb at CORB[new_wp]: &CORB + new_wp*4 as a mov_d. The *4 is `shl r, 2` (not imul). (5) Write new_wp to HDA_CORBWP (u16 MMIO). (6) Bounded poll on RIRBWP until it != previous value. CORBRP catching up to CORBWP is the strict completion signal; RIRBWP movement is the easier observable (hardware posts the response before updating RIRBWP). (7) Read response from RIRB[new_wp] low 32 bits via mov_d. (8) Latch new_wp into _hda_last_wp, bump _hda_verb_ct. (9) Emit two-line fingerprint (klog_s1_d2 for codec+nid dec; klog_s1_x2 for verb+response hex). Encoder posture: 32-bit MMIO via mov_d; 16-bit via mov_w; shl r,imm for every scale; sub rN,0xFFFF800000000000 pattern unused here (phys_alloc result is a VA; CORB/RIRB are accessed as VAs since the kernel mapped them into the direct map at phys_alloc time). Register plan: rbx = bar0, rbp = codec_addr & 0xF, r12 = nid & 0xFF, r13 = packed verb, r14 = response. Entry rsp%16==8; five pushes land rsp%16==0. The klog_s1_d2 7th arg (v2=nid) stages at caller [rsp+0] NOT [rsp+8] (I7 regression trap, same convention iris_xe_hotplug.pdx uses). klog_s1_x2 7th arg (v2=response) stages the same way. Labels prefixed hda_sv_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        // --- Gate 0: _hda_bar0 == 0 -> MMIO uninited.
        mov rbx, [rip + _hda_bar0];
        cmp rbx, 0;
        je  hda_sv_refuse_mmio;

        // --- Mask inputs to spec sizes.
        mov rbp, rdi;
        mov r10, 0xF;
        and rbp, r10;                        // codec_addr & 0xF
        mov r12, rsi;
        mov r10, 0xFF;
        and r12, r10;                        // nid & 0xFF
        mov r13, rdx;
        mov r10, 0xFFFFF;
        and r13, r10;                        // verb & 0xFFFFF (20b opcode+payload)

        // --- Pack packed = (codec_addr << 28) | (nid << 20) | verb.
        mov rax, rbp;
        shl rax, 28;
        mov rcx, r12;
        shl rcx, 20;
        or  rax, rcx;
        or  rax, r13;                        // rax = packed 32-bit verb

        // --- Advance CORBWP: new_wp = (last_wp + 1) & 0xFF.
        mov rcx, [rip + _hda_last_wp];
        add rcx, 1;
        mov r10, 0xFF;
        and rcx, r10;                        // ring index (256-entry CORB)

        // --- Store the packed verb at CORB[new_wp] * 4.
        mov r10, [rip + _hda_corb_va];
        mov r11, rcx;
        shl r11, 2;                          // new_wp * 4
        add r10, r11;
        mov_d [r10], rax;

        // --- MMIO write CORBWP (u16).
        mov r10, rbx;
        add r10, 0x48;                       // HDA_CORBWP
        mov_w [r10], rcx;

        // --- Save new_wp for the response slot read below.
        mov [rip + _hda_last_wp], rcx;

        // --- Bounded poll: wait for RIRBWP != new_wp - 1 (i.e. the
        //     hardware advanced the RIRB pointer at least once past
        //     our last-known tail). We re-read RIRBWP each iteration.
        //     On QEMU the HDA device is absent and the RIRBWP read
        //     returns 0 forever; the poll budget expires and we
        //     return HDA_ERR_VERB_TIMEOUT. D16 ALC287 integration
        //     treats TIMEOUT as the no-hardware signal.
        mov r14, rcx;                        // r14 = new_wp (target)
        xor r11, r11;                        // poll ctr
      hda_sv_wait:
        mov r10, rbx;
        add r10, 0x58;                       // HDA_RIRBWP
        xor rax, rax;
        mov_w rax, [r10];
        cmp rax, r14;
        je  hda_sv_got;
        add r11, 1;
        cmp r11, 4096;                       // HDA_POLL_MAX
        jb  hda_sv_wait;
        jmp hda_sv_refuse_timeout;

      hda_sv_got:
        // --- Read 64-bit RIRB entry at index new_wp.
        mov r10, [rip + _hda_rirb_va];
        mov r11, r14;
        shl r11, 3;                          // new_wp * 8
        add r10, r11;
        xor rax, rax;
        mov_d rax, [r10];                    // response (low 32b)
        mov r14, rax;                        // r14 = response (saved for fp)

        // --- Bump verb count.
        mov rax, [rip + _hda_verb_ct];
        add rax, 1;
        mov [rip + _hda_verb_ct], rax;

        // --- Fingerprint line 1: `HDA VERB codec=<dec> nid=<dec>`.
        // klog_s1_d2 takes 6 regs + v2 at caller [rsp+0]. Stage r12 (nid).
        sub rsp, 16;
        mov [rsp + 0], r12;                  // v2 = nid (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + hda_tag_verb];
        lea rcx, [rip + hda_k_codec];
        mov r8, rbp;                         // v1 = codec_addr (decimal)
        lea r9, [rip + hda_k_nid];
        call klog_s1_d2;
        add rsp, 16;

        // --- Fingerprint line 2: `HDA RESP verb=0x<8-hex> response=0x<8-hex>`.
        // klog_s1_x2 takes 6 regs + v2 at caller [rsp+0]. Stage r14 (response).
        sub rsp, 16;
        mov [rsp + 0], r14;                  // v2 = response (hex)
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + hda_tag_resp];
        lea rcx, [rip + hda_k_verb];
        mov r8, r13;                         // v1 = packed verb (hex)
        lea r9, [rip + hda_k_response];
        call klog_s1_x2;
        add rsp, 16;

        mov rax, r14;                        // return the response
        jmp hda_sv_out;

      hda_sv_refuse_mmio:
        mov rax, 0xFFFFFE21;                 // HDA_ERR_MMIO_UNINITED
        jmp hda_sv_out;
      hda_sv_refuse_timeout:
        mov rax, 0xFFFFFE25;                 // HDA_ERR_VERB_TIMEOUT

      hda_sv_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  hda_read_wall_clock() -> u64
  //
  // Read HDA_WALCLK (u32; 24 MHz link position counter). Returns the
  // raw 32-bit value zero-extended into rax, or HDA_ERR_MMIO_UNINITED
  // if the controller has not been bound.
  // ==========================================================================
  pub let hda_read_wall_clock : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532) leaf: load _hda_bar0; refuse on zero; add 0x30 (HDA_WALCLK); 32-bit MMIO read via mov_d; zero-extend into rax (mov_d auto-zero-extends into the upper 32 bits per SDM Vol.1 §3.4.1.1, same precedent fb_console.pdx L284 and nvme/set_features.pdx L198). Pure leaf; no stack frame. Labels prefixed hda_wc_.",
      block: {
        mov rax, [rip + _hda_bar0];
        cmp rax, 0;
        je  hda_wc_refuse;
        mov r10, rax;
        add r10, 0x30;                       // HDA_WALCLK
        xor rax, rax;
        mov_d rax, [r10];
        ret;
      hda_wc_refuse:
        mov rax, 0xFFFFFE21;                 // HDA_ERR_MMIO_UNINITED
        ret
      }
    }

  // ==========================================================================
  // §K  Stat / state accessors -- single-load leaf getters.
  // ==========================================================================

  pub let hda_bar0_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532): single-load getter for _hda_bar0. Zero before init. Pure leaf.",
      block: { mov rax, [rip + _hda_bar0]; ret }
    }

  pub let hda_codecs_present_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532): single-load getter for _hda_codecs_present (STATESTS mask snapshot). D16 ALC287 driver reads this to decide which codec address to probe. Pure leaf.",
      block: { mov rax, [rip + _hda_codecs_present]; ret }
    }

  pub let hda_init_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532): single-load getter for _hda_init_ct. Witness anchor. Pure leaf.",
      block: { mov rax, [rip + _hda_init_ct]; ret }
    }

  pub let hda_verb_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532): single-load getter for _hda_verb_ct. Pure leaf.",
      block: { mov rax, [rip + _hda_verb_ct]; ret }
    }

  pub let hda_reset_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 77 D15 (paideia-os#2532): single-load getter for _hda_reset_ct. Pure leaf.",
      block: { mov rax, [rip + _hda_reset_ct]; ret }
    }

  // ==========================================================================
  // §L  cap_handler_hda(rights, target_ptr, op_arg) -> u64
  //
  // KIND_HDA cap_invoke dispatch handler.  Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x48; je
  // call_kind_hda` arm added alongside this file.
  //
  //     op 0 HDA_OP_READ_WALL_CLOCK  -> hda_read_wall_clock
  //     op 1 HDA_OP_QUERY_CODECS     -> hda_codecs_present_q
  //     op 2 HDA_OP_QUERY_VERB_COUNT -> hda_verb_count
  //     op 3 HDA_OP_RESET            -> hda_reset_controller(_hda_bar0)
  //     else                          -> INVOKE_UNSUPPORTED
  //
  // Rights gate: ops 0..2 require R_HDA_READ; op 3 requires R_HDA_WRITE.
  // target_ptr is accepted but unused at skeleton stage (reserved for
  // multi-controller systems; today one controller is implicit).
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg.
  // Stack recipe: 3-push callee-save (rbx=rights, r12=target_ptr,
  // r13=op_code).  Labels prefixed `hda_hd_`.
  // ==========================================================================
  pub let cap_handler_hda : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 77 D15 (paideia-os#2532): KIND_HDA cap_invoke dispatch. Entry chatter (klog_s1 of hda_tag_entry) with the three incoming regs preserved in callee-save slots. op_code = op_arg & 0xFF; rights gate per-op (R_HDA_READ for query ops, R_HDA_WRITE for reset); dispatch 0..3 to the matching entrypoint; else INVOKE_UNSUPPORTED. The 8-bit op_code mask stages through r10 (fits imm32; and r10,0xFF is sign-extend-safe). Three callee-save pushes (rbx=rights, r12=target_ptr, r13=op_code) land rsp%16==0 at every nested call. Labels prefixed hda_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rights
        mov r12, rsi;                        // target_ptr (unused at skeleton)
        mov r13, rdx;                        // op_arg
        mov r10, 0xFF;
        and r13, r10;                        // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + hda_tag_entry];
        call klog_s1;

        // Op dispatch.
        cmp r13, 0;
        je  hda_hd_op_wclk;
        cmp r13, 1;
        je  hda_hd_op_codecs;
        cmp r13, 2;
        je  hda_hd_op_vct;
        cmp r13, 3;
        je  hda_hd_op_reset;
        jmp hda_hd_unsup;

      hda_hd_op_wclk:
        mov r10, rbx;
        and r10, 0x001;                      // R_HDA_READ
        cmp r10, 0;
        je  hda_hd_denied;
        call hda_read_wall_clock;
        jmp hda_hd_out;

      hda_hd_op_codecs:
        mov r10, rbx;
        and r10, 0x001;
        cmp r10, 0;
        je  hda_hd_denied;
        call hda_codecs_present_q;
        jmp hda_hd_out;

      hda_hd_op_vct:
        mov r10, rbx;
        and r10, 0x001;
        cmp r10, 0;
        je  hda_hd_denied;
        call hda_verb_count;
        jmp hda_hd_out;

      hda_hd_op_reset:
        mov r10, rbx;
        and r10, 0x002;                      // R_HDA_WRITE
        cmp r10, 0;
        je  hda_hd_denied;
        mov rdi, [rip + _hda_bar0];
        cmp rdi, 0;
        je  hda_hd_mmio_uninit;
        call hda_reset_controller;
        jmp hda_hd_out;

      hda_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        jmp hda_hd_out;
      hda_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED
        jmp hda_hd_out;
      hda_hd_mmio_uninit:
        mov rax, 0xFFFFFE21;                 // HDA_ERR_MMIO_UNINITED

      hda_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
