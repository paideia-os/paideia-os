// src/kernel/core/drivers/audio/alc287_codec.pdx -- Wave 78 D16 [R33] (paideia-os #2533)
//
// Realtek ALC287 HDA codec driver.  Widget-graph traversal + jack-detect
// built atop the Wave 77 D15 HDA controller's `hda_send_verb` seam.
// SKELETON.
//
// =============================================================================
// SECTION 0  SCOPE + HONESTY PIN
// =============================================================================
//
// IT IS a standalone driver module under `drivers/audio/` that owns the
// Realtek ALC287 widget-graph side of the T14 G4 audio stack: codec
// probe (GET_PARAMETERS traversal from root through AFG to leaf widgets),
// per-pin jack-presence detection (GET_PIN_SENSE), and the pin-widget +
// amp-gain + connection-select SET verbs that configure a playback or
// capture route end-to-end.  Every byte of codec traffic lands on
// `hda_send_verb(codec_addr, nid, verb) -> u64` -- the Wave 77 D15 seam
// -- so this file is MMIO-free: all register-level ordering, CORB/RIRB
// state, and poll budgets are the controller's problem.
//
// IT IS NOT the controller.  `drivers/audio/hda_controller.pdx` (Wave 77,
// 948 LOC) owns the HDA ring; this file consumes it.  It is also NOT
// the vendor coefficient init path -- that scaffold already lives at
// `drivers/hda/alc287_init.pdx` (R33.M4-001 #1152, scaffold) and
// applies the six Realtek PROC_COEF pairs the ThinkPad fixup table
// specifies.  The two coexist for the same reason the kernel's drv /
// authority pair for every KIND coexists: `alc287_init.pdx` is a
// paideia-as scaffold deferred to the DEFERRED_HARDWARE latch and the
// per-platform fixup table it holds is appropriately isolated; THIS
// module is the register-level widget-graph interpreter and lives on
// the live hda_send_verb seam.
//
// IT IS A SKELETON.  On QEMU the HDA device is not instantiated by
// default and `hda_send_verb` returns 0xFFFFFE25 (HDA_ERR_VERB_TIMEOUT)
// -- that error is the "no codec responds" signal and this module
// propagates it as ALC287_ERR_VERB_FAILED (0xFFFFFE92).  On real T14 G4
// the ALC287 hangs off SDIN0; a follow-up slice walks the AFG
// recursively, populates _widget_table, and seats the playback stream
// against the codec's internal mixer.
//
// =============================================================================
// SECTION 1  ALC287 WIDGET GRAPH (Intel HDA Spec §7.1; Realtek ALC287 DS)
// =============================================================================
//
// HDA codecs are nodes in a DAG.  The ROOT (nid=0) has three function
// groups: AFG (Audio), VSG (Vendor-Specific), MFG (Modem).  On ALC287
// only the AFG is populated; its nid is reported through the root's
// GET_PARAMETERS(NODE_COUNT) response.
//
// Under the AFG hangs a flat list of WIDGETS.  Each widget's TYPE is
// encoded in bits [23:20] of its AUDIO_WIDGET_CAPS (GET_PARAMETERS
// param 0x09) response:
//
//     type-nibble    widget-kind         role
//     ------------   -------------       --------------------------------
//     0x0            AUDIO_OUT (DAC)     digital -> analog converter
//     0x1            AUDIO_IN  (ADC)     analog -> digital converter
//     0x2            AUDIO_MIXER         sums + per-input amps
//     0x3            AUDIO_SELECTOR      1-of-N input mux + amp
//     0x4            PIN_COMPLEX         physical jack endpoint
//     0x5            POWER_WIDGET        power-state latch
//     0x6            VOLUME_KNOB         hw-controlled master vol
//     0x7            BEEP_GENERATOR      PC-speaker emulation
//
// ALC287 exposes ~26 widgets:
//   * 2 DACs    (headphone, speaker)
//   * 3 ADCs    (dmic, headset mic, line in)
//   * 4 mixers  (output mixer, mic bias network, HP amp, ClassD)
//   * 1 selector (adc input select)
//   * 8 pins    (hp-out, speaker, headset-out, headset-mic, dmic, line-in,
//                internal mic L/R)
//   * 1 power widget, 1 vol knob, 1 beep gen, ~5 vendor-specific
//
// Each widget has a CONNECTION LIST (GET_CONNECT_LIST) giving the nids
// that feed into it.  A playback route is a path (DAC) -> (mixer) ->
// (pin complex); the mixer's connection list has the DAC's nid in slot
// 0.  A capture route is (pin complex) -> (adc selector) -> (ADC); the
// selector's connection list has the pin's nid at some slot i, and
// SET_CONNECTION_SELECT writes i to pick it.
//
// At skeleton stage this module records the AFG start nid + sub-node
// count from the first probe (enough for a witness-level smoke) and
// treats the full traversal as a follow-up slice.  The entrypoint
// surface stays stable through that slice -- the public ABI below is
// what D16 commits to.
//
// =============================================================================
// SECTION 2  VERB ENCODING (short form; HDA Spec §7.3.3)
// =============================================================================
//
// The 32-bit CORB verb packed by `hda_send_verb` is:
//
//     [31:28] codec_addr   (0..15)
//     [27:20] nid          (0..255)
//     [19:0]  verb payload (12-bit opcode + 8-bit data)
//
// `hda_send_verb` masks the caller's `verb` arg to 20 bits.  This file
// constructs the 20-bit payload field as:
//
//     payload = (opcode_12b << 8) | data_8b
//
// opcode    name                       data interpretation
// ------    ----                       -------------------
// 0xF00     GET_PARAMETERS             param ID (0x04 NODE_COUNT,
//                                      0x09 AUDIO_WIDGET_CAPS, etc.)
// 0xF09     GET_PIN_SENSE              0 (reads codec state)
// 0x300     SET_AMP_GAIN_MUTE          8-bit MSB of a 16-bit control
//                                      word; the full 16-bit control
//                                      is treated as "long form" by
//                                      the spec but the skeleton uses
//                                      the short-form 8-bit truncation
//                                      (default-level mute+zero-gain
//                                      is a single 0 byte that works
//                                      byte-identically in both forms)
// 0x701     SET_CONNECTION_SELECT      0..7 (connection list index)
// 0x707     SET_PIN_WIDGET_CONTROL     bits: 0x40=OUT_ENABLE,
//                                            0x20=IN_ENABLE,
//                                            0x80=HP_ENABLE
//
// A follow-up slice replaces the short-form amp write with the long-
// form payload (16-bit data in bits [15:0]) once per-channel gain
// control is wired; the control-byte-is-zero case is byte-identical
// across the two encodings so the skeleton is correct for the default
// case it emits.
//
// =============================================================================
// SECTION 3  RETURN CODES
// =============================================================================
//
// Grep audit at landing time (Wave 78):
//   grep -rhE "0xFFFFFE2[6-9A]" src/kernel/
// Band 0xFFFFFE26..0xFFFFFE27 was free.  Band 0xFFFFFE28..0xFFFFFE2A
// was already consumed by `policy/thermal_policy.pdx` (THERMAL_POLICY_
// BAD_LEVEL / BAD_INTENT / MAP_ALREADY).  The remaining three ALC287
// codes slide to the next contiguous free band 0xFFFFFE91..0xFFFFFE93
// (grep -rhE "0xFFFFFE9[1-3]" src/kernel/ returned ZERO hits before
// this file).  The split is defensible: 0xFFFFFE26..27 are the two
// "direct HDA dependency" errors (controller-not-up, bad-NID input);
// 0xFFFFFE91..93 are the three "widget-graph" errors (table-full,
// verb-failed-mid-walk, amp-not-supported).
//
//   ALC287_ERR_HDA_NOT_INITED    0xFFFFFE26  - hda_bar0_q() == 0 at
//                                              entry (D15 hda_init
//                                              not yet called).
//   ALC287_ERR_BAD_NID           0xFFFFFE27  - caller-supplied nid
//                                              >= 256 (overflows the
//                                              HDA 8-bit node field).
//   ALC287_ERR_WIDGET_TABLE_FULL 0xFFFFFE91  - a traversal step tried
//                                              to append past slot 31
//                                              of _widget_table.
//   ALC287_ERR_VERB_FAILED       0xFFFFFE92  - hda_send_verb returned
//                                              a value in [0xFFFFFE00,
//                                              0xFFFFFFFF] (any of
//                                              HDA's error codes).
//   ALC287_ERR_NO_AMP_SUPPORT    0xFFFFFE93  - caller called a route
//                                              helper on a widget
//                                              whose AUDIO_WIDGET_CAPS
//                                              lacks the OUT_AMP or
//                                              IN_AMP bit (reserved
//                                              for the follow-up
//                                              slice; the skeleton
//                                              writes amps
//                                              unconditionally and
//                                              never raises this).
//
// =============================================================================
// SECTION 4  KIND SLOT
// =============================================================================
//
// KIND_ALC287 (= 0x49, 73).  Derived kind over KIND_DEVICE (base slot
// 10) -- an ALC287 codec is a per-device entity (one codec descriptor
// per SDIN per HDA controller) in the same posture as KIND_HDA (0x48,
// Wave 77 D15).  Dispatch arm added to `cap/invoke.pdx`:
//
//   cmp rcx, 0x49;
//   je  call_kind_alc287;
//
// 0x49 fits imm32 with bit 31 clear so no r9 staging; direct form
// matches every sub-0x80 driver kind in the invoke block (KIND_HDA
// 0x48, KIND_SYNAPTICS 0x47, KIND_GPU_GUC_DRV 0x46, KIND_I2C_HID_DRV
// 0x45, KIND_BACKLIGHT_DRV 0x44, KIND_GPU_BO_DRV 0x43, KIND_HOTPLUG
// 0x41, KIND_FAN_DRV 0x40, KIND_PPGTT 0x3F, KIND_THERMAL_ZONE_DRV
// 0x3E, KIND_BATTERY_DRV 0x3D, KIND_FIRMWARE_BLOB 0x3C).  Grep audit
// at landing time:
//
//   grep -nE "cmp rcx, 0x49\b" src/kernel/core/cap/invoke.pdx
//
// returned ZERO existing arms.  The main dispatcher adds the arm
// alongside this file as part of the Wave 78 submission.
//
// =============================================================================
// SECTION 5  ENCODER POSTURE (paideia-as v0.36.82)
// =============================================================================
//
//   G1 (sized MMIO) -- NO MMIO in this file.  Every byte of codec
//     traffic is a `call hda_send_verb` into Wave 77 D15 which owns
//     the sized MMIO discipline.
//   G4 (full-register compares) -- every cmp is on a 64-bit register.
//     No `test rN, rN` (equality-against-zero is `cmp rN, 0`).
//   No `and r11, imm64` -- every mask fits imm32 and stages through
//     r10 at use site.  The HDA error-band comparison constant
//     0xFFFFFE00 is unsigned-32-bit (not sign-extend-safe) so EVERY
//     use stages via `mov r10, 0xFFFFFE00; cmp rax, r10` rather than
//     `cmp rax, 0xFFFFFE00`.
//   No 2-op `imul r, imm` -- the one multiplication (widget table row
//     base: nid * 32) uses `shl r, 5` (powers of 2).
//   No multiline `pub let ="..."` -- every string tag is a single-line
//     literal with explicit trailing `\0`.
//   Module basename -- `Alc287Codec` matches `alc287_codec.pdx`.
//   Reserved-label discipline -- every label is prefixed `alc_in_`,
//     `alc_pb_`, `alc_jk_`, `alc_or_`, `alc_ir_` or `alc_hd_` (never
//     `loop`, `if`, `let`, `done`, `next`).
//   klog variants -- the per-arity wrappers obey the caller [rsp+0]
//     NOT [rsp+8] convention (I7 regression trap).  Every klog_s1_d2
//     call site in this file documents its stack recipe inline.
//   Fingerprint tag `[u8; N]` -- N = len(string literal) + 1 (the
//     trailing `\0`).  Byte-counted below in §F.
//
// =============================================================================
// SECTION 6  FINGERPRINT WIRE FORMAT
// =============================================================================
//
// Three tags, matching `tests/fingerprints/alc287_codec.golden`:
//
//   ALC287 PROBE codec=<dec> n_widgets=<dec>
//   ALC287 JACK nid=<dec> present=<dec>
//   ALC287 ROUTE dac=<dec> pin=<dec>
//
// All three use klog_s1_d2 (two decimal KV entries, byte-identical
// shape to hda_controller.pdx's `HDA VERB codec=<dec> nid=<dec>`
// precedent).  The input route helper reuses `ALC287 ROUTE` with
// adc_nid in the `dac` slot; both route verbs are structurally
// identical and the golden pattern matches either case.
//
// =============================================================================
// SECTION 7  STACK + REGISTER PLAN
// =============================================================================
//
// alc287_probe:
//   Prologue: push rbx, r12, r13 (3 * 8 = 24 B).  Entry rsp%16==8,
//   after 3 pushes rsp%16==0 (aligned pre-CALL).  rbx = codec_addr,
//   r12 = n_widgets (extracted from NODE_COUNT response), r13 =
//   AFG start nid (extracted from same response).  klog_s1_d2 call
//   site stages v2 at caller [rsp+0]: `sub rsp, 16; mov [rsp+0], r12`
//   (NOT [rsp+8] -- the I7 regression trap).
//
// alc287_detect_jack:
//   Prologue: push rbx, r12, r13 (3 pushes).  Entry rsp%16==8 ->
//   rsp%16==0.  rbx = nid, r12 = present (bit 31 of response), r13
//   = unused.  Same klog_s1_d2 shape as probe.
//
// alc287_set_output_route:
//   Prologue: push rbx, rbp, r12 (3 pushes).  Entry rsp%16==8 ->
//   rsp%16==0.  rbx = dac_nid, rbp = pin_nid, r12 = unused.  Same
//   klog_s1_d2 shape.
//
// alc287_set_input_route:
//   Prologue: push rbx, rbp, r12 (3 pushes).  Same shape as output.
//
// cap_handler_alc287:
//   Prologue: push rbx, r12, r13 (3 pushes); rbx=rights, r12=
//   target_ptr (unused at skeleton), r13=op_code.  Labels prefixed
//   `alc_hd_`.
//
// Stat getters: leaf (no stack frame).
//
// =============================================================================

module Alc287Codec = structure {

  // ==========================================================================
  // §A  KIND / rights
  // ==========================================================================

  pub let KIND_ALC287      : u64 = 0x49      // Wave 78 D16 derived-kind tag
  pub let KIND_ALC287_BASE : u64 = 10        // = KIND_DEVICE

  pub let R_ALC287_READ   : u64 = 0x001      // query ops (jack detect, stats)
  pub let R_ALC287_WRITE  : u64 = 0x002      // mutate ops (probe, routes)
  pub let R_ALC287_ALL    : u64 = 0x003      // handed to the holder on create

  // ==========================================================================
  // §B  Verb opcodes + GET_PARAMETERS parameter IDs
  //
  // Short-form 12-bit opcodes; the per-call verb payload is
  //   verb = (opcode << 8) | data
  // where data is the opcode-specific 8-bit field (param ID for GET,
  // control byte for SET).  All five opcodes fit in 12 bits so
  // (opcode << 8) fits in 20 bits and `hda_send_verb` accepts them
  // without truncation.
  // ==========================================================================

  pub let VERB_GET_PARAMETERS   : u64 = 0xF00
  pub let VERB_GET_PIN_SENSE    : u64 = 0xF09
  pub let VERB_SET_AMP_GAIN     : u64 = 0x300
  pub let VERB_SET_CONN_SELECT  : u64 = 0x701
  pub let VERB_SET_PIN_CTL      : u64 = 0x707

  pub let PARAM_NODE_COUNT      : u64 = 0x04
  pub let PARAM_WIDGET_CAPS     : u64 = 0x09

  pub let PIN_CTL_OUT_ENABLE    : u64 = 0x40
  pub let PIN_CTL_IN_ENABLE     : u64 = 0x20

  // Widget-type encoding (4-bit field from AUDIO_WIDGET_CAPS bits
  // [23:20]).  Kept as named constants so the follow-up slice's
  // traversal walker reads naturally.
  pub let WIDGET_TYPE_DAC       : u64 = 0x0
  pub let WIDGET_TYPE_ADC       : u64 = 0x1
  pub let WIDGET_TYPE_MIXER     : u64 = 0x2
  pub let WIDGET_TYPE_SELECTOR  : u64 = 0x3
  pub let WIDGET_TYPE_PIN       : u64 = 0x4
  pub let WIDGET_TYPE_POWER     : u64 = 0x5
  pub let WIDGET_TYPE_VOLKNOB   : u64 = 0x6
  pub let WIDGET_TYPE_BEEPGEN   : u64 = 0x7

  // Error-band boundary.  Any value `rax >= ALC287_ERR_BAND` returned
  // by `hda_send_verb` is treated as an HDA error (0xFFFFFE21..25
  // today; any future HDA error ends up in the same 0xFFFFFE00..FF
  // page).  A legitimate codec response is a 32-bit value and never
  // sign-extends into that range.
  pub let ALC287_ERR_BAND       : u64 = 0xFFFFFE00

  // Maximum widgets stored in _widget_table (32 rows * 4 u64 =
  // 128 u64 total; ALC287 has ~26 widgets so 32 is comfortable
  // headroom).
  pub let ALC287_MAX_WIDGETS    : u64 = 32

  // ==========================================================================
  // §C  Return codes (reserved -- see §3 above for the taxonomy audit)
  // ==========================================================================

  pub let ALC287_OK                    : u64 = 0
  pub let ALC287_ERR_HDA_NOT_INITED    : u64 = 0xFFFFFE26
  pub let ALC287_ERR_BAD_NID           : u64 = 0xFFFFFE27
  pub let ALC287_ERR_WIDGET_TABLE_FULL : u64 = 0xFFFFFE91
  pub let ALC287_ERR_VERB_FAILED       : u64 = 0xFFFFFE92
  pub let ALC287_ERR_NO_AMP_SUPPORT    : u64 = 0xFFFFFE93

  // Standard cap_invoke sentinels (full 64-bit).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // ==========================================================================
  // §D  cap_handler_alc287 op ordinals
  //
  // op_arg bit layout:
  //     [7:0]   op_code
  //     [15:8]  nid1  (codec_addr for PROBE; nid for JACK;
  //                    dac/adc for route ops)
  //     [23:16] nid2  (pin for route ops; 0 for probe + jack)
  // ==========================================================================

  pub let ALC287_OP_PROBE          : u64 = 0  // nid1 = codec_addr
  pub let ALC287_OP_DETECT_JACK    : u64 = 1  // nid1 = nid
  pub let ALC287_OP_SET_OUT_ROUTE  : u64 = 2  // nid1 = dac_nid, nid2 = pin
  pub let ALC287_OP_SET_IN_ROUTE   : u64 = 3  // nid1 = adc_nid, nid2 = pin
  pub let ALC287_OP_QUERY_PROBE_CT : u64 = 4
  pub let ALC287_OP_MAX            : u64 = 4

  // ==========================================================================
  // §E  Module-local state
  //
  // Five scalars + one widget table + four counters:
  //   _alc287_codec_addr  -- codec address the last probe latched (0..15).
  //   _alc287_n_widgets   -- sub-node count returned by GET_PARAMETERS
  //                          (NODE_COUNT) at the root (full response low 8 b).
  //   _alc287_afg_nid     -- starting node id reported in the same response.
  //   _alc287_last_jack   -- bit 31 of the most recent GET_PIN_SENSE response
  //                          (1 = jack present, 0 = unplugged).
  //   _alc287_last_jack_nid -- the nid most recently fed to detect_jack.
  //   _widget_table       -- 128 u64 (32 rows x 4 fields).  Row N starts at
  //                          index N*4:
  //                             [N*4+0] = nid
  //                             [N*4+1] = widget_type (4-bit from caps)
  //                             [N*4+2] = caps (full u64; low 32 bits valid)
  //                             [N*4+3] = reserved (future connection-list)
  //   _alc287_probe_ct     -- bump on each successful alc287_probe entry.
  //   _alc287_jack_ct      -- bump on each successful alc287_detect_jack.
  //   _alc287_or_ct        -- bump on each successful set_output_route.
  //   _alc287_ir_ct        -- bump on each successful set_input_route.
  //
  // No per-codec row table at skeleton: a second ALC287 on the same
  // controller is not a configuration this project supports (one HDA
  // link = one ALC287 on T14 G4).  The follow-up slice revisits.
  // ==========================================================================

  pub let mut _alc287_codec_addr    : u64 = 0
  pub let mut _alc287_n_widgets     : u64 = 0
  pub let mut _alc287_afg_nid       : u64 = 0
  pub let mut _alc287_last_jack     : u64 = 0
  pub let mut _alc287_last_jack_nid : u64 = 0

  pub let mut _widget_table         : [u64; 128] = uninit @align(64)

  pub let mut _alc287_probe_ct      : u64 = 0
  pub let mut _alc287_jack_ct       : u64 = 0
  pub let mut _alc287_or_ct         : u64 = 0
  pub let mut _alc287_ir_ct         : u64 = 0

  // ==========================================================================
  // §F  Fingerprint tags + keys
  //
  // Tag sizes count the trailing NUL.  Measured byte-exact against the
  // golden template `tests/fingerprints/alc287_codec.golden`.
  // ==========================================================================

  pub let alc_tag_probe   : [u8; 13] = "ALC287 PROBE\0"
  pub let alc_tag_jack    : [u8; 12] = "ALC287 JACK\0"
  pub let alc_tag_route   : [u8; 13] = "ALC287 ROUTE\0"
  pub let alc_tag_entry   : [u8; 24] = "KIND_ALC287 dispatch iv\0"

  pub let alc_k_codec     : [u8; 6]  = "codec\0"
  pub let alc_k_n_widgets : [u8; 10] = "n_widgets\0"
  pub let alc_k_nid       : [u8; 4]  = "nid\0"
  pub let alc_k_present   : [u8; 8]  = "present\0"
  pub let alc_k_dac       : [u8; 4]  = "dac\0"
  pub let alc_k_pin       : [u8; 4]  = "pin\0"

  // ==========================================================================
  // §G  alc287_probe(codec_addr) -> u64
  //
  // (1) Validate codec_addr <= 0xF (the HDA codec address field is
  //     4 bits).  Values > 15 are a caller bug, not a hardware fault.
  // (2) Gate on hda_bar0_q() == 0 (D15 not inited) ->
  //     ALC287_ERR_HDA_NOT_INITED.
  // (3) Issue GET_PARAMETERS(NODE_COUNT) on root (nid=0) via
  //     hda_send_verb.  verb_arg = (0xF00 << 8) | 0x04 = 0xF0004.
  // (4) Interpret the response:
  //       bits [23:16] = starting-node-id (the AFG nid on ALC287)
  //       bits  [7:0]  = sub-node-count (the AFG count on ALC287)
  //     At skeleton we record both and stop; the follow-up slice
  //     walks the AFG's sub-nodes and populates _widget_table.
  // (5) Latch _alc287_codec_addr, _alc287_n_widgets, _alc287_afg_nid.
  // (6) Bump _alc287_probe_ct.
  // (7) Emit `ALC287 PROBE codec=<dec> n_widgets=<dec>`.
  //
  // SysV: rdi = codec_addr.  Returns ALC287_OK on success, or one of
  // ALC287_ERR_HDA_NOT_INITED / ALC287_ERR_BAD_NID (misreused for
  // bad-codec-addr) / ALC287_ERR_VERB_FAILED on failure.
  // ==========================================================================
  pub let alc287_probe : (u64) -> u64 !{mem, sysreg} @{boot} =
    fn (codec_addr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 78 D16 (paideia-os#2533).  Probe root node: GET_PARAMETERS(NODE_COUNT) on nid=0 to learn the AFG start nid + sub-node count.  verb_arg = (VERB_GET_PARAMETERS << 8) | PARAM_NODE_COUNT = (0xF00 << 8) | 0x04 = 0xF0004.  Response layout per HDA spec §7.1.2: bits [23:16] = starting-node-id, bits [7:0] = sub-node-count.  Gates: codec_addr > 0xF -> ALC287_ERR_BAD_NID (reuse: a bad codec_addr is a bad input in the same taxonomy as a bad NID); hda_bar0_q() == 0 -> ALC287_ERR_HDA_NOT_INITED (D15 hda_init not yet called); any `hda_send_verb` return `rax >= 0xFFFFFE00` -> ALC287_ERR_VERB_FAILED (propagates HDA_ERR_MMIO_UNINITED / HDA_ERR_VERB_TIMEOUT in the single band).  Encoder posture: 20-bit verb payload fits imm32 directly (`mov rdx, 0xF0004` is a 7-byte REX.W B8 form); the error-band constant 0xFFFFFE00 is unsigned-32-bit (not sign-extend-safe) so it stages via `mov r10, 0xFFFFFE00; cmp rax, r10` (same posture as every other error-band comparison across drivers/).  No test r,r; no imul r,imm; no and r,imm64.  Register plan: rbx=codec_addr, r12=n_widgets, r13=afg_nid.  Entry rsp%16==8; three callee-save pushes land rsp%16==0 pre-CALL.  klog_s1_d2 7th arg (v2=n_widgets) stages at caller [rsp+0] NOT [rsp+8] (I7 regression trap).  Labels prefixed alc_pb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // codec_addr

        // --- Gate 0: codec_addr > 0xF -> BAD_NID (reused as "bad input").
        mov r10, 0xF;
        cmp rbx, r10;
        ja  alc_pb_bad_nid;

        // --- Gate 1: hda_bar0_q() == 0 -> HDA not inited.
        call hda_bar0_q;
        cmp rax, 0;
        je  alc_pb_hda_uninited;

        // --- Issue GET_PARAMETERS(NODE_COUNT) on root (nid=0).
        mov rdi, rbx;                        // codec_addr
        xor rsi, rsi;                        // nid = 0 (root)
        mov rdx, 0xF0004;                    // (0xF00 << 8) | 0x04
        call hda_send_verb;

        // --- Gate 2: send_verb error (rax >= 0xFFFFFE00).
        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_pb_verb_failed;

        // --- Extract n_widgets (bits [7:0]) and afg_nid (bits [23:16]).
        mov r12, rax;
        mov r10, 0xFF;
        and r12, r10;                        // n_widgets

        mov r13, rax;
        shr r13, 16;
        and r13, r10;                        // afg_nid

        // --- Latch state.
        mov [rip + _alc287_codec_addr], rbx;
        mov [rip + _alc287_n_widgets],  r12;
        mov [rip + _alc287_afg_nid],    r13;

        // --- Bump probe count.
        mov rax, [rip + _alc287_probe_ct];
        add rax, 1;
        mov [rip + _alc287_probe_ct], rax;

        // --- Fingerprint: `ALC287 PROBE codec=<dec> n_widgets=<dec>`.
        // klog_s1_d2 takes 6 regs + v2 at caller [rsp+0].  Stage r12.
        sub rsp, 16;
        mov [rsp + 0], r12;                  // v2 = n_widgets (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + alc_tag_probe];
        lea rcx, [rip + alc_k_codec];
        mov r8, rbx;                         // v1 = codec_addr (decimal)
        lea r9, [rip + alc_k_n_widgets];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                        // ALC287_OK
        jmp alc_pb_out;

      alc_pb_bad_nid:
        mov rax, 0xFFFFFE27;                 // ALC287_ERR_BAD_NID
        jmp alc_pb_out;
      alc_pb_hda_uninited:
        mov rax, 0xFFFFFE26;                 // ALC287_ERR_HDA_NOT_INITED
        jmp alc_pb_out;
      alc_pb_verb_failed:
        mov rax, 0xFFFFFE92;                 // ALC287_ERR_VERB_FAILED

      alc_pb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §H  alc287_detect_jack(nid) -> u64
  //
  // (1) Validate nid < 256 (fits the HDA 8-bit node field).
  // (2) Gate on hda_bar0_q() == 0 -> ALC287_ERR_HDA_NOT_INITED.
  // (3) Issue GET_PIN_SENSE on `nid` via hda_send_verb using the
  //     latched _alc287_codec_addr.  verb_arg = (0xF09 << 8) | 0x00
  //     = 0xF0900.
  // (4) Response bit 31 is PRESENCE_DETECT.  Extract to a 0/1.
  // (5) Latch _alc287_last_jack, _alc287_last_jack_nid.
  // (6) Bump _alc287_jack_ct.
  // (7) Emit `ALC287 JACK nid=<dec> present=<dec>`.
  // (8) Return the 0/1 presence state (NOT a status code).  Error
  //     paths return the 0xFFFFFE2x / 0xFFFFFE92 codes as usual.
  //
  // SysV: rdi = nid.  Returns 0 or 1 on success, or an error code.
  // ==========================================================================
  pub let alc287_detect_jack : (u64) -> u64 !{mem, sysreg} @{} =
    fn (nid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533).  GET_PIN_SENSE on `nid` using the latched _alc287_codec_addr.  verb_arg = (VERB_GET_PIN_SENSE << 8) | 0 = 0xF0900.  Response bit 31 is PRESENCE_DETECT per HDA spec §7.3.3.14; extract to 0/1 via shr 31 + and 1.  Gates: nid > 0xFF -> ALC287_ERR_BAD_NID; hda_bar0_q() == 0 -> ALC287_ERR_HDA_NOT_INITED; send_verb error (rax >= 0xFFFFFE00) -> ALC287_ERR_VERB_FAILED.  Encoder posture: same as alc287_probe; the 32-bit nid-mask 0xFF stages via r10 (fits imm32).  Register plan: rbx=nid, r12=present, r13=unused.  Entry rsp%16==8; three callee-save pushes land rsp%16==0.  klog_s1_d2 7th arg (v2=present) at caller [rsp+0] NOT [rsp+8].  Labels prefixed alc_jk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // nid

        // --- Gate 0: nid > 0xFF -> BAD_NID.
        mov r10, 0xFF;
        cmp rbx, r10;
        ja  alc_jk_bad_nid;

        // --- Gate 1: hda_bar0_q() == 0 -> HDA not inited.
        call hda_bar0_q;
        cmp rax, 0;
        je  alc_jk_hda_uninited;

        // --- Issue GET_PIN_SENSE.
        mov rdi, [rip + _alc287_codec_addr];
        mov rsi, rbx;                        // nid
        mov rdx, 0xF0900;                    // (0xF09 << 8) | 0x00
        call hda_send_verb;

        // --- Gate 2: send_verb error.
        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_jk_verb_failed;

        // --- Extract presence (bit 31 of response).
        mov r12, rax;
        shr r12, 31;
        mov r10, 0x1;
        and r12, r10;                        // present = 0 or 1

        // --- Latch state.
        mov [rip + _alc287_last_jack],     r12;
        mov [rip + _alc287_last_jack_nid], rbx;

        // --- Bump jack count.
        mov rax, [rip + _alc287_jack_ct];
        add rax, 1;
        mov [rip + _alc287_jack_ct], rax;

        // --- Fingerprint: `ALC287 JACK nid=<dec> present=<dec>`.
        sub rsp, 16;
        mov [rsp + 0], r12;                  // v2 = present (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + alc_tag_jack];
        lea rcx, [rip + alc_k_nid];
        mov r8, rbx;                         // v1 = nid (decimal)
        lea r9, [rip + alc_k_present];
        call klog_s1_d2;
        add rsp, 16;

        mov rax, r12;                        // return 0/1 presence
        jmp alc_jk_out;

      alc_jk_bad_nid:
        mov rax, 0xFFFFFE27;                 // ALC287_ERR_BAD_NID
        jmp alc_jk_out;
      alc_jk_hda_uninited:
        mov rax, 0xFFFFFE26;                 // ALC287_ERR_HDA_NOT_INITED
        jmp alc_jk_out;
      alc_jk_verb_failed:
        mov rax, 0xFFFFFE92;                 // ALC287_ERR_VERB_FAILED

      alc_jk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §I  alc287_set_output_route(dac_nid, pin_nid) -> u64
  //
  // Program a playback route from a DAC to a pin complex:
  //   (1) SET_PIN_WIDGET_CONTROL on pin  (payload = PIN_CTL_OUT_ENABLE=0x40)
  //   (2) SET_AMP_GAIN_MUTE     on DAC  (payload = 0 -- default-level,
  //                                       both channels unmuted at
  //                                       zero gain; the follow-up
  //                                       slice extends to the full
  //                                       16-bit long-form amp word)
  //   (3) SET_CONNECTION_SELECT on pin  (payload = 0, slot 0 of the
  //                                       pin's connection list is
  //                                       the DAC's output on ALC287)
  //
  // Each verb lands through `hda_send_verb` using the latched
  // _alc287_codec_addr.  On any send_verb error -> ALC287_ERR_VERB_FAILED;
  // on nid overflow -> ALC287_ERR_BAD_NID; on HDA-not-inited ->
  // ALC287_ERR_HDA_NOT_INITED.  Fingerprint on success:
  //
  //   ALC287 ROUTE dac=<dec> pin=<dec>
  //
  // SysV: rdi = dac_nid, rsi = pin_nid.
  // ==========================================================================
  pub let alc287_set_output_route : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (dac_nid: u64) (pin_nid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533).  Three-verb route: SET_PIN_WIDGET_CONTROL(pin, OUT_ENABLE) + SET_AMP_GAIN_MUTE(dac, 0) + SET_CONNECTION_SELECT(pin, 0).  Each verb packed as (opcode << 8) | data: (0x707 << 8) | 0x40 = 0x70740, (0x300 << 8) | 0 = 0x30000, (0x701 << 8) | 0 = 0x70100.  All three fit imm32 directly.  Gates: dac_nid > 0xFF -> ALC287_ERR_BAD_NID; pin_nid > 0xFF -> ALC287_ERR_BAD_NID; hda_bar0_q() == 0 -> ALC287_ERR_HDA_NOT_INITED; any send_verb error (rax >= 0xFFFFFE00) -> ALC287_ERR_VERB_FAILED.  Register plan: rbx=dac_nid, rbp=pin_nid, r12=unused.  Entry rsp%16==8; three callee-save pushes land rsp%16==0 pre-CALL (every call site is a nested `call hda_send_verb` or `call klog_s1_d2`).  klog_s1_d2 v2 at caller [rsp+0] NOT [rsp+8].  Labels prefixed alc_or_.",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov rbx, rdi;                        // dac_nid
        mov rbp, rsi;                        // pin_nid

        // --- Gate 0: dac_nid > 0xFF -> BAD_NID.
        mov r10, 0xFF;
        cmp rbx, r10;
        ja  alc_or_bad_nid;
        cmp rbp, r10;
        ja  alc_or_bad_nid;

        // --- Gate 1: hda_bar0_q() == 0 -> HDA not inited.
        call hda_bar0_q;
        cmp rax, 0;
        je  alc_or_hda_uninited;

        // --- Verb 1: SET_PIN_WIDGET_CONTROL(pin, OUT_ENABLE).
        mov rdi, [rip + _alc287_codec_addr];
        mov rsi, rbp;                        // pin_nid
        mov rdx, 0x70740;                    // (0x707 << 8) | 0x40
        call hda_send_verb;

        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_or_verb_failed;

        // --- Verb 2: SET_AMP_GAIN_MUTE(dac, 0).
        mov rdi, [rip + _alc287_codec_addr];
        mov rsi, rbx;                        // dac_nid
        mov rdx, 0x30000;                    // (0x300 << 8) | 0
        call hda_send_verb;

        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_or_verb_failed;

        // --- Verb 3: SET_CONNECTION_SELECT(pin, 0).
        mov rdi, [rip + _alc287_codec_addr];
        mov rsi, rbp;                        // pin_nid
        mov rdx, 0x70100;                    // (0x701 << 8) | 0
        call hda_send_verb;

        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_or_verb_failed;

        // --- Bump output-route count.
        mov rax, [rip + _alc287_or_ct];
        add rax, 1;
        mov [rip + _alc287_or_ct], rax;

        // --- Fingerprint: `ALC287 ROUTE dac=<dec> pin=<dec>`.
        sub rsp, 16;
        mov [rsp + 0], rbp;                  // v2 = pin_nid (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + alc_tag_route];
        lea rcx, [rip + alc_k_dac];
        mov r8, rbx;                         // v1 = dac_nid (decimal)
        lea r9, [rip + alc_k_pin];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                        // ALC287_OK
        jmp alc_or_out;

      alc_or_bad_nid:
        mov rax, 0xFFFFFE27;                 // ALC287_ERR_BAD_NID
        jmp alc_or_out;
      alc_or_hda_uninited:
        mov rax, 0xFFFFFE26;                 // ALC287_ERR_HDA_NOT_INITED
        jmp alc_or_out;
      alc_or_verb_failed:
        mov rax, 0xFFFFFE92;                 // ALC287_ERR_VERB_FAILED

      alc_or_out:
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §J  alc287_set_input_route(adc_nid, pin_nid) -> u64
  //
  // Program a capture route from a pin complex to an ADC.  Structurally
  // identical to the output route helper but:
  //   (1) SET_PIN_WIDGET_CONTROL on pin  (payload = PIN_CTL_IN_ENABLE=0x20)
  //   (2) SET_AMP_GAIN_MUTE     on ADC  (payload = 0)
  //   (3) SET_CONNECTION_SELECT on ADC  (payload = 0, slot 0 of the
  //                                       ADC selector's connection
  //                                       list is the pin on ALC287)
  //
  // Fingerprint reuses `ALC287 ROUTE` with adc_nid in the `dac` KV
  // (the shared tag was a deliberate design decision -- see §6).
  //
  // SysV: rdi = adc_nid, rsi = pin_nid.
  // ==========================================================================
  pub let alc287_set_input_route : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (adc_nid: u64) (pin_nid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533).  Three-verb capture route, mirror of alc287_set_output_route.  Verbs: SET_PIN_WIDGET_CONTROL(pin, IN_ENABLE=0x20) packed as 0x70720; SET_AMP_GAIN_MUTE(adc, 0) packed as 0x30000; SET_CONNECTION_SELECT(adc, 0) packed as 0x70100 -- note the SELECT verb lands on the ADC's selector, not the pin, because on a capture path the ADC-side selector is the one with the pin in its connection list.  Register plan: rbx=adc_nid, rbp=pin_nid, r12=unused.  Entry rsp%16==8; three callee-save pushes land rsp%16==0.  Labels prefixed alc_ir_.",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov rbx, rdi;                        // adc_nid
        mov rbp, rsi;                        // pin_nid

        // --- Gate 0: adc_nid / pin_nid > 0xFF -> BAD_NID.
        mov r10, 0xFF;
        cmp rbx, r10;
        ja  alc_ir_bad_nid;
        cmp rbp, r10;
        ja  alc_ir_bad_nid;

        // --- Gate 1: hda_bar0_q() == 0 -> HDA not inited.
        call hda_bar0_q;
        cmp rax, 0;
        je  alc_ir_hda_uninited;

        // --- Verb 1: SET_PIN_WIDGET_CONTROL(pin, IN_ENABLE).
        mov rdi, [rip + _alc287_codec_addr];
        mov rsi, rbp;                        // pin_nid
        mov rdx, 0x70720;                    // (0x707 << 8) | 0x20
        call hda_send_verb;

        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_ir_verb_failed;

        // --- Verb 2: SET_AMP_GAIN_MUTE(adc, 0).
        mov rdi, [rip + _alc287_codec_addr];
        mov rsi, rbx;                        // adc_nid
        mov rdx, 0x30000;                    // (0x300 << 8) | 0
        call hda_send_verb;

        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_ir_verb_failed;

        // --- Verb 3: SET_CONNECTION_SELECT(adc, 0).
        mov rdi, [rip + _alc287_codec_addr];
        mov rsi, rbx;                        // adc_nid (selector lives on the ADC)
        mov rdx, 0x70100;                    // (0x701 << 8) | 0
        call hda_send_verb;

        mov r10, 0xFFFFFE00;
        cmp rax, r10;
        jae alc_ir_verb_failed;

        // --- Bump input-route count.
        mov rax, [rip + _alc287_ir_ct];
        add rax, 1;
        mov [rip + _alc287_ir_ct], rax;

        // --- Fingerprint: `ALC287 ROUTE dac=<dec> pin=<dec>` (shared tag).
        sub rsp, 16;
        mov [rsp + 0], rbp;                  // v2 = pin_nid (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + alc_tag_route];
        lea rcx, [rip + alc_k_dac];
        mov r8, rbx;                         // v1 = adc_nid (decimal)
        lea r9, [rip + alc_k_pin];
        call klog_s1_d2;
        add rsp, 16;

        xor rax, rax;                        // ALC287_OK
        jmp alc_ir_out;

      alc_ir_bad_nid:
        mov rax, 0xFFFFFE27;                 // ALC287_ERR_BAD_NID
        jmp alc_ir_out;
      alc_ir_hda_uninited:
        mov rax, 0xFFFFFE26;                 // ALC287_ERR_HDA_NOT_INITED
        jmp alc_ir_out;
      alc_ir_verb_failed:
        mov rax, 0xFFFFFE92;                 // ALC287_ERR_VERB_FAILED

      alc_ir_out:
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §K  Stat / state accessors -- single-load leaf getters.
  // ==========================================================================

  pub let alc287_codec_addr_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_codec_addr (last-probed address, 0 before any probe).  Pure leaf.",
      block: { mov rax, [rip + _alc287_codec_addr]; ret }
    }

  pub let alc287_n_widgets_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_n_widgets (NODE_COUNT low byte latched at last probe).  Pure leaf.",
      block: { mov rax, [rip + _alc287_n_widgets]; ret }
    }

  pub let alc287_afg_nid_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_afg_nid (NODE_COUNT high byte, the AFG start nid).  Pure leaf.",
      block: { mov rax, [rip + _alc287_afg_nid]; ret }
    }

  pub let alc287_last_jack_q : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_last_jack (0/1 presence state from the most recent detect_jack).  Pure leaf.",
      block: { mov rax, [rip + _alc287_last_jack]; ret }
    }

  pub let alc287_probe_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_probe_ct.  Witness anchor.  Pure leaf.",
      block: { mov rax, [rip + _alc287_probe_ct]; ret }
    }

  pub let alc287_jack_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_jack_ct.  Pure leaf.",
      block: { mov rax, [rip + _alc287_jack_ct]; ret }
    }

  pub let alc287_out_route_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_or_ct.  Pure leaf.",
      block: { mov rax, [rip + _alc287_or_ct]; ret }
    }

  pub let alc287_in_route_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 78 D16 (paideia-os#2533): single-load getter for _alc287_ir_ct.  Pure leaf.",
      block: { mov rax, [rip + _alc287_ir_ct]; ret }
    }

  // ==========================================================================
  // §L  cap_handler_alc287(rights, target_ptr, op_arg) -> u64
  //
  // KIND_ALC287 cap_invoke dispatch handler.  Reachable from
  // cap/invoke.pdx:cap_invoke_dispatch via the `cmp rcx, 0x49; je
  // call_kind_alc287` arm added alongside this file.
  //
  //   op 0 ALC287_OP_PROBE          -> alc287_probe(codec_addr=op_arg[15:8])
  //   op 1 ALC287_OP_DETECT_JACK    -> alc287_detect_jack(nid=op_arg[15:8])
  //   op 2 ALC287_OP_SET_OUT_ROUTE  -> alc287_set_output_route(
  //                                      dac=op_arg[15:8],
  //                                      pin=op_arg[23:16])
  //   op 3 ALC287_OP_SET_IN_ROUTE   -> alc287_set_input_route(
  //                                      adc=op_arg[15:8],
  //                                      pin=op_arg[23:16])
  //   op 4 ALC287_OP_QUERY_PROBE_CT -> alc287_probe_count
  //   else                           -> INVOKE_UNSUPPORTED
  //
  // Rights gate: ops 1 + 4 (jack-detect, probe-count) require
  // R_ALC287_READ.  Ops 0, 2, 3 (probe, out-route, in-route) require
  // R_ALC287_WRITE.
  //
  // SysV: rdi=rights, rsi=target_ptr, rdx=op_arg.
  // Stack recipe: 3-push callee-save (rbx=rights, r12=op_arg (NOT
  // target_ptr -- target_ptr is unused at skeleton so the slot is
  // repurposed to preserve op_arg across the klog_s1 entry chatter
  // which clobbers rdx), r13=op_code).  Labels prefixed `alc_hd_`.
  // ==========================================================================
  pub let cap_handler_alc287 : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave 78 D16 (paideia-os#2533): KIND_ALC287 cap_invoke dispatch.  Entry chatter via klog_s1(alc_tag_entry) preserves the three incoming regs across callee-save slots.  op_code = op_arg & 0xFF; rights gate per-op (R_ALC287_READ for jack + probe-count queries, R_ALC287_WRITE for probe + routes); dispatch 0..4 to the matching entrypoint; else INVOKE_UNSUPPORTED.  Pack decode: PROBE / JACK use arg1 = (op_arg >> 8) & 0xFF (codec_addr or nid).  OUT_ROUTE / IN_ROUTE additionally use arg2 = (op_arg >> 16) & 0xFF (pin_nid).  The 8-bit masks stage through r10 (fit imm32).  Register plan: rbx=rights, r12=op_arg (NOT target_ptr -- target_ptr is unused at the skeleton and the r12 slot is repurposed to preserve op_arg across the klog_s1 entry chatter which clobbers rdx), r13=op_code.  Three callee-save pushes land rsp%16==0 at every nested call.  Labels prefixed alc_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rights
        mov r12, rdx;                        // op_arg (preserved across klog_s1)
        mov r13, r12;
        mov r10, 0xFF;
        and r13, r10;                        // op_code = op_arg[7:0]

        // Entry chatter.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + alc_tag_entry];
        call klog_s1;

        // Op dispatch.
        cmp r13, 0;
        je  alc_hd_op_probe;
        cmp r13, 1;
        je  alc_hd_op_jack;
        cmp r13, 2;
        je  alc_hd_op_or;
        cmp r13, 3;
        je  alc_hd_op_ir;
        cmp r13, 4;
        je  alc_hd_op_pct;
        jmp alc_hd_unsup;

      alc_hd_op_probe:
        mov r10, rbx;
        and r10, 0x002;                      // R_ALC287_WRITE
        cmp r10, 0;
        je  alc_hd_denied;
        mov rdi, r12;
        shr rdi, 8;
        mov r10, 0xFF;
        and rdi, r10;                        // codec_addr
        call alc287_probe;
        jmp alc_hd_out;

      alc_hd_op_jack:
        mov r10, rbx;
        and r10, 0x001;                      // R_ALC287_READ
        cmp r10, 0;
        je  alc_hd_denied;
        mov rdi, r12;
        shr rdi, 8;
        mov r10, 0xFF;
        and rdi, r10;                        // nid
        call alc287_detect_jack;
        jmp alc_hd_out;

      alc_hd_op_or:
        mov r10, rbx;
        and r10, 0x002;                      // R_ALC287_WRITE
        cmp r10, 0;
        je  alc_hd_denied;
        mov rdi, r12;
        shr rdi, 8;
        mov r10, 0xFF;
        and rdi, r10;                        // dac_nid
        mov rsi, r12;
        shr rsi, 16;
        and rsi, r10;                        // pin_nid
        call alc287_set_output_route;
        jmp alc_hd_out;

      alc_hd_op_ir:
        mov r10, rbx;
        and r10, 0x002;                      // R_ALC287_WRITE
        cmp r10, 0;
        je  alc_hd_denied;
        mov rdi, r12;
        shr rdi, 8;
        mov r10, 0xFF;
        and rdi, r10;                        // adc_nid
        mov rsi, r12;
        shr rsi, 16;
        and rsi, r10;                        // pin_nid
        call alc287_set_input_route;
        jmp alc_hd_out;

      alc_hd_op_pct:
        mov r10, rbx;
        and r10, 0x001;                      // R_ALC287_READ
        cmp r10, 0;
        je  alc_hd_denied;
        call alc287_probe_count;
        jmp alc_hd_out;

      alc_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;         // INVOKE_DENIED
        jmp alc_hd_out;
      alc_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;         // INVOKE_UNSUPPORTED

      alc_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
