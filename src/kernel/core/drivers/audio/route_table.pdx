// src/kernel/core/drivers/audio/route_table.pdx -- R33.M5-003 (#1159)
//
// The AUDIO ROUTING FABRIC.
//
// KIND_AUDIO_ROUTE (kind_audio_route.pdx) is the CAPABILITY that names
// one routing edge. This module is the FABRIC BENEATH IT: a per-slot
// index into the kind's row table, plus the ONE primitive the system
// has for combining two Q15 gains (`q15_add_sat`). That primitive is
// here rather than in the kind because it is a SATURATING FIXED-POINT
// arithmetic operation, and saturation is a property of the arithmetic
// domain, not of the descriptor shape.
//
// =============================================================================
// §0  WHY Q15 SATURATION IS ITS OWN FILE
// =============================================================================
//
// Two ways to combine two Q15 signed values in a mixer:
//
//   (a) MODULAR ADD -- what a plain `add r10, r11` does. On overflow,
//       the result wraps. A +32000 sum with +5000 wraps to a very-
//       negative -28536: a loud peak becomes a loud opposite-polarity
//       peak with no discontinuity in the sample stream downstream can
//       detect. Every downstream limiter would happily consume the
//       inversion.
//
//   (b) SATURATING ADD -- clamp to [Q15_MIN, Q15_MAX]. The same +32000
//       + +5000 pins at +32767. The signal clips (audibly), which is
//       what every downstream user of the mixer output would expect
//       and can react to. Nothing wraps.
//
// PaideiaOS mixers use (b), always, everywhere. `q15_add_sat` is the
// one primitive that answers a question the amplifier will ask about
// combined gain, so having two answers to that question would be a
// silent per-edge choice about whether inversion is a legal signal.
// It is not. §1 states the discipline.
//
// =============================================================================
// §1  Q15_ADD_SAT SEMANTICS
// =============================================================================
//
// Inputs: two signed 16-bit values, each represented as a u64 whose low
// 16 bits carry the value and whose high 48 bits are the sign extension
// (0x0000_0000_0000_0000 for non-negative, 0xFFFF_FFFF_FFFF_0000 for
// negative). audio_route_gain_valid enforces exactly this shape.
//
// Output: the arithmetic sum, clamped to [Q15_MIN, Q15_MAX], in the
// same sign-extended shape.
//
// Table:
//
//     +30000 + +10000  ->  +32767      (clipped high)
//     +32767 + +32767  ->  +32767      (clipped high)
//     -32000 + -10000  ->  -32768      (clipped low)
//     -32768 + -32768  ->  -32768      (clipped low)
//     +10000 + -10000  ->  0           (no clip)
//     +32767 + -32768  ->  -1          (no clip)
//     -32768 + +32767  ->  -1          (no clip)
//
// The addition itself is performed in i64 arithmetic (68-bit range,
// well beyond the sum of two i16 values), then compared against Q15_MAX
// and Q15_MIN as SIGNED values, then re-truncated to the 16-bit
// sign-extended shape.
//
// =============================================================================
// §2  THE ROUTE-TABLE ROW IS A KIND PRIVATE
// =============================================================================
//
// This module does NOT declare its own row table. The route rows live
// in kind_audio_route.pdx's `_audio_route_table`, and every accessor
// this module offers reaches into that table only through the kind's
// own row-accessor entry points. There is no second table, no shadow
// copy, and no per-fabric writer. Confinement is
// tools/build.sh:[audio-route-confine].

module RouteTable = structure {

  // Q15 constants as signed 16-bit values sign-extended to i64/u64.
  pub let Q15_MAX_S : u64 = 0x0000000000007FFF   // +32767
  pub let Q15_MIN_S : u64 = 0xFFFFFFFFFFFF8000   // -32768

  // ==========================================================================
  // q15_add_sat(a, b) -> clamped(a + b) in [Q15_MIN_S, Q15_MAX_S]
  //
  // Signed addition with saturation. Inputs must be sign-extended
  // 16-bit values; audio_route_gain_valid guarantees this shape for
  // any value that reached a route row. Callers with values from other
  // sources MUST validate before invoking, because this primitive does
  // NOT re-check its inputs -- validation is a mint-time concern, and
  // this is a hot-path mixer helper.
  //
  // The choice of signed comparison (jg/jl rather than ja/jb) is
  // load-bearing: an unsigned comparison would clamp a legitimate
  // -1 (= 0xFFFFFFFFFFFFFFFF as u64) as if it were larger than +1.
  // ==========================================================================

  pub let q15_add_sat : (u64, u64) -> u64 !{} @{} =
    fn (a: u64, b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M5-003 (#1159): saturating signed add on Q15 values. Inputs are sign-extended 16-bit as u64. Sum in 64-bit signed arithmetic, then clamp against Q15_MAX (+32767 = 0x7FFF) and Q15_MIN (-32768 = 0xFFFFFFFFFFFF8000). Signed comparisons via jg/jl. The primitive REFUSES ambiguity: a Q15 value is a specific u64 shape, not any 16-bit low. THIS IS THE ONE SATURATING COMBINE in the audio fabric -- see §0. Labels prefixed q15as_.",
      block: {
        mov rax, rdi;
        add rax, rsi;

        // Compare signed against Q15_MAX_S = +32767.
        mov r10, 0x7FFF;
        cmp rax, r10;
        jg  q15as_hi;
        // Compare signed against Q15_MIN_S = -32768 (0xFFFFFFFFFFFF8000).
        mov r10, 0xFFFFFFFFFFFF8000;
        cmp rax, r10;
        jl  q15as_lo;
        ret;
      q15as_hi:
        mov rax, 0x7FFF;
        ret;
      q15as_lo:
        mov rax, 0xFFFFFFFFFFFF8000;
        ret
      }
    }

  // ==========================================================================
  // route_table_gain_of_slot(slot) -> Q15 signed gain | DECODE_BAD
  //
  // Thin wrapper around audio_route_gain_of_slot for callers that want
  // the fabric name rather than the capability-kind name. Same arity,
  // same semantics.
  // ==========================================================================

  pub let route_table_gain_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-003 (#1159): pass-through to audio_route_gain_of_slot. Named to expose the ROW read at the fabric level. Labels: none.",
      block: {
        push rbx;
        call audio_route_gain_of_slot;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // route_table_mute_of_slot(slot) -> mute bit | DECODE_BAD
  // ==========================================================================

  pub let route_table_mute_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-003 (#1159): pass-through to audio_route_mute_of_slot. Labels: none.",
      block: {
        push rbx;
        call audio_route_mute_of_slot;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // route_table_effective_gain(slot) -> Q15 gain
  //
  // The fabric's "what gain does this edge apply RIGHT NOW" query. If
  // the edge is muted, returns 0; otherwise returns the row's gain_q15.
  // A future stage compositing multiple edges to one output would call
  // q15_add_sat on the pairwise results of this.
  //
  // A dead slot returns 0 (silence), because a mixer that reached a
  // dead slot is a mixer whose upstream stage has a stale reference,
  // and silence is the only safe answer.
  // ==========================================================================

  pub let route_table_effective_gain : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M5-003 (#1159): if muted OR dead -> 0 (silence); else gain_q15. NO CLAMPING NEEDED -- the row's own gain is already validated Q15. Labels prefixed rte_eg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // slot

        mov rdi, r12;
        call route_table_mute_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  rte_eg_zero;
        cmp rax, 1;
        je  rte_eg_zero;

        mov rdi, r12;
        call route_table_gain_of_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  rte_eg_zero;
        jmp rte_eg_out;

      rte_eg_zero:
        xor rax, rax;

      rte_eg_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
