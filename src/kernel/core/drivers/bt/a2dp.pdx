// src/kernel/core/drivers/bt/a2dp.pdx — R39.M5-001 (#1339)
//
// Bluetooth A2DP (Advanced Audio Distribution Profile) — Stream End
// Point (SEP) registry, codec capability set (SBC mandatory + AAC
// recommended), and the AVDTP signalling FSM
// (DISCOVER / GET_CAPABILITIES / SET_CONFIGURATION / OPEN / START /
// SUSPEND / CLOSE).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CANONICAL BOOKKEEPING SITE for A2DP Stream End Points and
// the AVDTP transaction FSM on this host.  Every SEP the local device
// advertises (codec_type, media_type, cap masks, current state) is
// recorded here, and every AVDTP verb the peer initiates is dispatched
// against a row in _a2dp_seps.  A second SEP table would let one path
// see an SEP as STREAMING and the other as IDLE, and the audio bridge
// (a2dp_bridge.pdx) would happily push PCM into a stream nobody had
// started.
//
// It is NOT the L2CAP transport (R39.M2 carries the AVDTP PDUs on
// PSM 0x0019), and it is NOT the audio path (a2dp_bridge.pdx wires this
// module's STREAMING SEPs to KIND_PCM_STREAM from R33).  It is NOT the
// SBC / AAC codec implementation either -- the codec-specific fields on
// each SEP row are pure BOOKKEEPING; the a2dp_bridge decoder / encoder
// consumes them but the frame math lives there.
//
// It is NOT a codec-negotiation policy: the SEP row records what the
// local device CAN do; the AVDTP SET_CONFIGURATION verb records what
// the peer PICKED.  Nothing here decides between SBC and AAC on the
// peer's behalf.
//
// =============================================================================
// §1  SEP TABLE
// =============================================================================
//
// A2DP_SEP_MAX = 4 SEPs -- enough for one SBC-source, one AAC-source,
// one SBC-sink and one AAC-sink concurrently.  A second-generation
// table would grow this to per-connection SEP pools; the fixed cap is
// deliberate for R39.M5.
//
// Per-SEP row (8 u64, 64 bytes; row_id r lives at word offset r*8):
//
//   [+0]   active(bit 0) | codec_type(bits 8..15) |
//          media_type(bits 16..23) | state(bits 32..39)
//   [+8]   cap_sample_rate_mask         (u16 subset of A2DP §4.3.x)
//   [+16]  cap_channel_mode_mask
//   [+24]  cap_codec_extra              (SBC: block_length | subbands
//                                        | allocation | bitpool_min | max
//                                        AAC: obj_type | rfa)
//   [+32]  cfg_sample_rate              (post-SET_CONFIGURATION)
//   [+40]  cfg_channel_mode
//   [+48]  cfg_codec_extra
//   [+56]  session_id                   (AVDTP transaction label)
//
// =============================================================================
// §2  CODEC / MEDIA TYPES (A2DP §4.3)
// =============================================================================
//
//   A2DP_MEDIA_AUDIO = 0x00
//   A2DP_CODEC_SBC   = 0x00
//   A2DP_CODEC_AAC   = 0x02
//
// This module ACCEPTS SBC + AAC and refuses all other codec_type values
// with A2DP_BAD_CODEC.  MPEG-1,2 (0x01), ATRAC (0x04) and Non-A2DP
// (0xFF) are legal on the wire but out of scope for R39.M5.
//
// =============================================================================
// §3  AVDTP FSM (per AVDTP §8.2)
// =============================================================================
//
//   A2DP_STATE_IDLE       (0)
//   A2DP_STATE_CONFIGURED (1)   after SET_CONFIGURATION
//   A2DP_STATE_OPEN       (2)   after OPEN
//   A2DP_STATE_STREAMING  (3)   after START
//   A2DP_STATE_CLOSING    (4)   after CLOSE (transient before IDLE)
//
// Legal edges:
//   IDLE       -> CONFIGURED   (a2dp_set_configuration)
//   CONFIGURED -> OPEN         (a2dp_open)
//   OPEN       -> STREAMING    (a2dp_start)
//   STREAMING  -> OPEN         (a2dp_suspend)
//   any        -> CLOSING      (a2dp_close)
//   CLOSING    -> IDLE         (a2dp_close cleanup)
//
// Any other edge returns A2DP_BAD_STATE.
//
// =============================================================================
// §4  ONE WRITER OF THE STATE
// =============================================================================
//
// _a2dp_seps, _a2dp_stats and _a2dp_init are written only by helpers in
// this module.  tools/build.sh confines relocations against each to
// core/drivers/bt/a2dp.o so a second writer cannot silently forge an
// SEP row or promote an FSM edge.
//
// =============================================================================
// §5  FAILURE TAXONOMY 0xFFFFF2C0..0xFFFFF2CF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: bt_pairing_channel
// 0xFFFFF2D0..0x2DF; adjacent free band below: a2dp_bridge candidate
// 0xFFFFF2B0..0x2BF).

module A2dp = structure {

  // §2: codec + media types.
  pub let A2DP_MEDIA_AUDIO : u64 = 0x00
  pub let A2DP_CODEC_SBC   : u64 = 0x00
  pub let A2DP_CODEC_AAC   : u64 = 0x02

  // §3: AVDTP FSM states.
  pub let A2DP_STATE_IDLE       : u64 = 0
  pub let A2DP_STATE_CONFIGURED : u64 = 1
  pub let A2DP_STATE_OPEN       : u64 = 2
  pub let A2DP_STATE_STREAMING  : u64 = 3
  pub let A2DP_STATE_CLOSING    : u64 = 4
  pub let A2DP_STATE_MAX        : u64 = 4

  // AVDTP verb ordinals (per AVDTP §8.5).
  pub let A2DP_VERB_DISCOVER          : u64 = 0x01
  pub let A2DP_VERB_GET_CAPABILITIES  : u64 = 0x02
  pub let A2DP_VERB_SET_CONFIGURATION : u64 = 0x03
  pub let A2DP_VERB_OPEN              : u64 = 0x06
  pub let A2DP_VERB_START             : u64 = 0x07
  pub let A2DP_VERB_CLOSE             : u64 = 0x08
  pub let A2DP_VERB_SUSPEND           : u64 = 0x09
  pub let A2DP_VERB_MIN               : u64 = 0x01
  pub let A2DP_VERB_MAX               : u64 = 0x09

  // SBC sample-rate mask bits (A2DP §4.3.1).
  pub let A2DP_SBC_SR_48000 : u64 = 0x01
  pub let A2DP_SBC_SR_44100 : u64 = 0x02
  pub let A2DP_SBC_SR_32000 : u64 = 0x04
  pub let A2DP_SBC_SR_16000 : u64 = 0x08
  pub let A2DP_SBC_SR_MASK  : u64 = 0x0F

  // SBC channel-mode mask bits (A2DP §4.3.1).
  pub let A2DP_SBC_CM_JOINT_STEREO : u64 = 0x01
  pub let A2DP_SBC_CM_STEREO       : u64 = 0x02
  pub let A2DP_SBC_CM_DUAL         : u64 = 0x04
  pub let A2DP_SBC_CM_MONO         : u64 = 0x08
  pub let A2DP_SBC_CM_MASK         : u64 = 0x0F

  // AAC sample-rate bits (A2DP §4.5.2; subset).
  pub let A2DP_AAC_SR_48000 : u64 = 0x0100
  pub let A2DP_AAC_SR_44100 : u64 = 0x0200
  pub let A2DP_AAC_SR_32000 : u64 = 0x0400
  pub let A2DP_AAC_SR_MASK  : u64 = 0x0700

  // AAC channel bits.
  pub let A2DP_AAC_CH_1 : u64 = 0x01
  pub let A2DP_AAC_CH_2 : u64 = 0x02
  pub let A2DP_AAC_CH_MASK : u64 = 0x03

  // §1: SEP table sizing.
  pub let A2DP_SEP_MAX   : u64 = 4
  pub let A2DP_ROW_WORDS : u64 = 8
  pub let A2DP_SEP_NONE  : u64 = 0xFF

  // Column offsets within a row (byte offsets).
  pub let A2DP_COL_META             : u64 = 0
  pub let A2DP_COL_CAP_SR           : u64 = 8
  pub let A2DP_COL_CAP_CM           : u64 = 16
  pub let A2DP_COL_CAP_EXTRA        : u64 = 24
  pub let A2DP_COL_CFG_SR           : u64 = 32
  pub let A2DP_COL_CFG_CM           : u64 = 40
  pub let A2DP_COL_CFG_EXTRA        : u64 = 48
  pub let A2DP_COL_SESSION_ID       : u64 = 56

  // §5: failure taxonomy 0xFFFFF2C0..0xFFFFF2CF.
  pub let A2DP_OK                  : u64 = 0
  pub let A2DP_BAD_ARG             : u64 = 0xFFFFF2CF
  pub let A2DP_BAD_SEP             : u64 = 0xFFFFF2CE
  pub let A2DP_SEP_ENOSPC          : u64 = 0xFFFFF2CD
  pub let A2DP_SEP_IN_USE          : u64 = 0xFFFFF2CC
  pub let A2DP_BAD_CODEC           : u64 = 0xFFFFF2CB
  pub let A2DP_BAD_MEDIA           : u64 = 0xFFFFF2CA
  pub let A2DP_BAD_STATE           : u64 = 0xFFFFF2C9
  pub let A2DP_BAD_VERB            : u64 = 0xFFFFF2C8
  pub let A2DP_BAD_SAMPLE_RATE     : u64 = 0xFFFFF2C7
  pub let A2DP_BAD_CHANNEL_MODE    : u64 = 0xFFFFF2C6
  pub let A2DP_NOT_INITIALIZED     : u64 = 0xFFFFF2C5
  pub let A2DP_BAD_CFG_MASK        : u64 = 0xFFFFF2C4
  pub let A2DP_UNSUPPORTED         : u64 = 0xFFFFF2C3
  pub let A2DP_DUP_CODEC           : u64 = 0xFFFFF2C2
  pub let A2DP_REFUSED             : u64 = 0xFFFFF2C1

  // §4: state cells.  4 rows * 8 u64s = 32 u64s.
  pub let mut _a2dp_seps  : [u64; 32] = uninit @align(64)
  pub let mut _a2dp_stats : [u64;  8] = uninit @align(64)
  pub let mut _a2dp_init  : u64       = 0

  // Counter ordinals.
  pub let A2DP_ST_DISCOVERS : u64 = 0
  pub let A2DP_ST_CAPS_QS   : u64 = 1
  pub let A2DP_ST_CFGS      : u64 = 2
  pub let A2DP_ST_OPENS     : u64 = 3
  pub let A2DP_ST_STARTS    : u64 = 4
  pub let A2DP_ST_SUSPENDS  : u64 = 5
  pub let A2DP_ST_CLOSES    : u64 = 6
  pub let A2DP_ST_REFUSED   : u64 = 7

  // ==========================================================================
  // a2dp_reset -- clear SEP table + counters + init flag.  Boot and
  // teardown only.
  // ==========================================================================

  pub let a2dp_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): clear SEP table, counters, and init flag. Labels prefixed a2dp_rs_.",
      block: {
        lea r10, [rip + _a2dp_seps];
        xor rax, rax;
        xor rcx, rcx;
      a2dp_rs_seps:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  a2dp_rs_seps;

        lea r10, [rip + _a2dp_stats];
        xor rcx, rcx;
      a2dp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  a2dp_rs_stats;

        lea r10, [rip + _a2dp_init];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // a2dp_init -- must run before any other op.
  // ==========================================================================

  pub let a2dp_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): mark module initialised.  Idempotent. Labels prefixed a2dp_in_.",
      block: {
        call a2dp_reset;
        lea r10, [rip + _a2dp_init];
        mov rax, 1;
        mov [r10], rax;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let a2dp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): counter bump. Labels prefixed a2dp_nt_.",
      block: {
        cmp rdi, 8;
        jae a2dp_nt_out;
        lea r10, [rip + _a2dp_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      a2dp_nt_out:
        ret
      }
    } @no_frame

  pub let a2dp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): counter read. Labels prefixed a2dp_st_.",
      block: {
        cmp rdi, 8;
        jae a2dp_st_zero;
        lea r10, [rip + _a2dp_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      a2dp_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let a2dp_codec_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-001 (#1339): 1 iff codec is SBC (0) or AAC (2). Labels prefixed a2dp_cv_.",
      block: {
        cmp rdi, 0;
        je  a2dp_cv_yes;
        cmp rdi, 2;
        je  a2dp_cv_yes;
        xor rax, rax;
        ret;
      a2dp_cv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let a2dp_media_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-001 (#1339): 1 iff media == AUDIO (0). Labels prefixed a2dp_mv_.",
      block: {
        cmp rdi, 0;
        jne a2dp_mv_no;
        mov rax, 1;
        ret;
      a2dp_mv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let a2dp_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-001 (#1339): 1 iff state <= CLOSING (4). Labels prefixed a2dp_sv_.",
      block: {
        cmp rdi, 4;
        ja  a2dp_sv_no;
        mov rax, 1;
        ret;
      a2dp_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let a2dp_verb_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-001 (#1339): 1 iff v in {1,2,3,6,7,8,9}. Labels prefixed a2dp_vv_.",
      block: {
        cmp rdi, 1;
        je  a2dp_vv_yes;
        cmp rdi, 2;
        je  a2dp_vv_yes;
        cmp rdi, 3;
        je  a2dp_vv_yes;
        cmp rdi, 6;
        je  a2dp_vv_yes;
        cmp rdi, 7;
        je  a2dp_vv_yes;
        cmp rdi, 8;
        je  a2dp_vv_yes;
        cmp rdi, 9;
        je  a2dp_vv_yes;
        xor rax, rax;
        ret;
      a2dp_vv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.  row_id r lives at word offset r*8 in _a2dp_seps.
  // ==========================================================================

  pub let a2dp_sep_in_use : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): 1 iff row_id<MAX and META bit 0 set. Labels prefixed a2dp_iu_.",
      block: {
        cmp rdi, 4;
        jae a2dp_iu_no;
        lea r10, [rip + _a2dp_seps];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  a2dp_iu_no;
        mov rax, 1;
        ret;
      a2dp_iu_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let a2dp_sep_codec : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): codec_type of a live SEP, or 0xFF..FF if absent. Labels prefixed a2dp_sc_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_sc_bad;
        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp a2dp_sc_out;
      a2dp_sc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2dp_sc_out:
        pop r12;
        ret
      }
    }

  pub let a2dp_sep_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): state of a live SEP, or 0xFF..FF if absent. Labels prefixed a2dp_ss_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_ss_bad;
        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;
        and rax, 0xFF;
        jmp a2dp_ss_out;
      a2dp_ss_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2dp_ss_out:
        pop r12;
        ret
      }
    }

  pub let a2dp_sep_cfg_sample_rate : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): configured sample rate mask of a live SEP. Labels prefixed a2dp_gsr_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_gsr_bad;
        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp a2dp_gsr_out;
      a2dp_gsr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2dp_gsr_out:
        pop r12;
        ret
      }
    }

  pub let a2dp_sep_cfg_channel_mode : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): configured channel-mode mask of a live SEP. Labels prefixed a2dp_gcm_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_gcm_bad;
        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        jmp a2dp_gcm_out;
      a2dp_gcm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2dp_gcm_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // a2dp_find_codec(codec) -- return row_id of first live SEP with
  // matching codec, or A2DP_SEP_NONE.
  // ==========================================================================

  pub let a2dp_find_codec : (u64) -> u64 !{mem} @{} =
    fn (codec: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): linear scan of _a2dp_seps for first live row whose codec_type == arg. Labels prefixed a2dp_fc_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      a2dp_fc_scan:
        cmp rbx, 4;
        jae a2dp_fc_none;
        lea r10, [rip + _a2dp_seps];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        and r11, 0x1;
        cmp r11, 0;
        je  a2dp_fc_next;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, r12;
        je  a2dp_fc_hit;
      a2dp_fc_next:
        add rbx, 1;
        jmp a2dp_fc_scan;
      a2dp_fc_hit:
        mov rax, rbx;
        jmp a2dp_fc_out;
      a2dp_fc_none:
        mov rax, 0xFF;
      a2dp_fc_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // a2dp_sep_declare(codec, media, cap_sr_mask, cap_cm_mask) --
  // register one SEP.  Refuses if module not initialised, if codec or
  // media invalid, if a duplicate codec already registered, or if the
  // table is full.  Returns row_id on success.  ONE WRITER of the
  // positive edge of _a2dp_seps.
  // ==========================================================================

  pub let a2dp_sep_declare : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (codec: u64) (media: u64) (cap_sr: u64) (cap_cm: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): claim one SEP row. THE ONE WRITER of the positive edge of _a2dp_seps.  Refuses NOT_INITIALIZED / BAD_CODEC / BAD_MEDIA / DUP_CODEC / SEP_ENOSPC / BAD_CFG_MASK. Labels prefixed a2dp_dc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // codec
        mov r13, rsi;                    // media
        mov r14, rdx;                    // cap_sr
        mov r15, rcx;                    // cap_cm

        // Init check.
        lea r10, [rip + _a2dp_init];
        mov rax, [r10];
        cmp rax, 0;
        je  a2dp_dc_notinit;

        // Codec validity.
        mov rdi, r12;
        call a2dp_codec_valid;
        cmp rax, 0;
        je  a2dp_dc_bad_codec;

        // Media validity.
        mov rdi, r13;
        call a2dp_media_valid;
        cmp rax, 0;
        je  a2dp_dc_bad_media;

        // Cap-mask sanity: at least one bit set in each mask.
        cmp r14, 0;
        je  a2dp_dc_bad_cfg;
        cmp r15, 0;
        je  a2dp_dc_bad_cfg;

        // Duplicate-codec check.
        mov rdi, r12;
        call a2dp_find_codec;
        mov r11, 0xFF;
        cmp rax, r11;
        jne a2dp_dc_dup;

        // Free-row scan.
        xor rbx, rbx;
      a2dp_dc_scan:
        cmp rbx, 4;
        jae a2dp_dc_enospc;
        lea r10, [rip + _a2dp_seps];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  a2dp_dc_hit;
        add rbx, 1;
        jmp a2dp_dc_scan;

      a2dp_dc_hit:
        // Pack META: active(bit 0) | codec(bits 8..15) |
        // media(bits 16..23) | state=IDLE(bits 32..39).
        mov rax, r12;
        shl rax, 8;
        mov r11, r13;
        shl r11, 16;
        or  rax, r11;
        or  rax, 0x1;
        mov [r10 + 0], rax;

        // Capabilities.
        mov [r10 + 8],  r14;             // cap_sample_rate_mask
        mov [r10 + 16], r15;             // cap_channel_mode_mask
        xor rax, rax;
        mov [r10 + 24], rax;             // cap_codec_extra (unused at
                                         // R39.M5; the bridge fills it
                                         // in on SET_CONFIGURATION).

        // No configuration yet.
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rax, rbx;                    // return row_id
        jmp a2dp_dc_out;

      a2dp_dc_notinit:
        mov rax, 0xFFFFF2C5;
        jmp a2dp_dc_bump;
      a2dp_dc_bad_codec:
        mov rax, 0xFFFFF2CB;
        jmp a2dp_dc_bump;
      a2dp_dc_bad_media:
        mov rax, 0xFFFFF2CA;
        jmp a2dp_dc_bump;
      a2dp_dc_bad_cfg:
        mov rax, 0xFFFFF2C4;
        jmp a2dp_dc_bump;
      a2dp_dc_dup:
        mov rax, 0xFFFFF2C2;
        jmp a2dp_dc_bump;
      a2dp_dc_enospc:
        mov rax, 0xFFFFF2CD;
      a2dp_dc_bump:
        push rax;
        mov rdi, 7;                      // REFUSED
        call a2dp_note;
        pop rax;

      a2dp_dc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // a2dp_sep_release(row_id) -- clear the SEP row.  ONE WRITER of the
  // negative edge.
  // ==========================================================================

  pub let a2dp_sep_release : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): release one SEP row. Labels prefixed a2dp_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_rl_bad;

        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        xor rax, rax;
        jmp a2dp_rl_out;

      a2dp_rl_bad:
        mov rax, 0xFFFFF2CE;             // BAD_SEP
      a2dp_rl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // AVDTP verbs.
  //
  // Each verb takes (row_id, arg...) and returns 0 / an error from the
  // §5 taxonomy.  DISCOVER is the special one -- it returns a bitmask
  // of live SEP row-ids (bit r set iff SEP r is live), not an error.
  // ==========================================================================

  // a2dp_discover -- return bitmask of live SEPs.  Refuses if not
  // initialised (returns 0 with REFUSED counter bumped).
  pub let a2dp_discover : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): bitmask of live SEPs (bit r <-> row r).  0 if module not initialised. Labels prefixed a2dp_dv_.",
      block: {
        push rbx;
        push r12;

        lea r10, [rip + _a2dp_init];
        mov rax, [r10];
        cmp rax, 0;
        je  a2dp_dv_zero;

        xor r12, r12;                    // accumulator
        xor rbx, rbx;
      a2dp_dv_scan:
        cmp rbx, 4;
        jae a2dp_dv_done;
        lea r10, [rip + _a2dp_seps];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  a2dp_dv_next;
        mov r11, 1;
        mov rcx, rbx;
        shl r11, cl;
        or  r12, r11;
      a2dp_dv_next:
        add rbx, 1;
        jmp a2dp_dv_scan;
      a2dp_dv_done:
        mov rdi, 0;                      // DISCOVERS counter
        call a2dp_note;
        mov rax, r12;
        jmp a2dp_dv_out;
      a2dp_dv_zero:
        xor rax, rax;
      a2dp_dv_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // a2dp_get_capabilities(row_id) -- return the packed META word (the
  // caller reads the codec / cap masks via the accessors above).
  pub let a2dp_get_capabilities : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): return codec_type of the addressed SEP; BAD_SEP if absent. Labels prefixed a2dp_gc_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_gc_bad;
        mov rdi, 1;                      // CAPS_QS counter
        call a2dp_note;
        mov rdi, r12;
        call a2dp_sep_codec;
        jmp a2dp_gc_out;
      a2dp_gc_bad:
        mov rax, 0xFFFFF2CE;
      a2dp_gc_out:
        pop r12;
        ret
      }
    }

  // a2dp_set_configuration(row_id, cfg_sr, cfg_cm) -- move IDLE ->
  // CONFIGURED, latch the peer-picked config.  Refuses non-subset cfg
  // (BAD_SAMPLE_RATE / BAD_CHANNEL_MODE) or non-IDLE state.
  pub let a2dp_set_configuration : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (cfg_sr: u64) (cfg_cm: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): IDLE -> CONFIGURED.  Refuses BAD_SEP / BAD_STATE / BAD_SAMPLE_RATE / BAD_CHANNEL_MODE. cfg_sr / cfg_cm MUST be a non-empty subset of the SEP's capability masks.  Labels prefixed a2dp_sc2_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // cfg_sr
        mov r14, rdx;                    // cfg_cm

        mov rdi, r12;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_sc2_bad_sep;

        // State check: must be IDLE.
        mov rdi, r12;
        call a2dp_sep_state;
        cmp rax, 0;
        jne a2dp_sc2_bad_state;

        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        // cfg_sr must be non-empty and a subset of cap_sr.
        mov rax, [r10 + 8];
        mov rbx, r13;
        and rbx, rax;
        cmp rbx, r13;
        jne a2dp_sc2_bad_sr;
        cmp r13, 0;
        je  a2dp_sc2_bad_sr;

        // cfg_cm must be non-empty and a subset of cap_cm.
        mov rax, [r10 + 16];
        mov rbx, r14;
        and rbx, rax;
        cmp rbx, r14;
        jne a2dp_sc2_bad_cm;
        cmp r14, 0;
        je  a2dp_sc2_bad_cm;

        // Latch config, advance state to CONFIGURED.
        mov [r10 + 32], r13;
        mov [r10 + 40], r14;

        mov rax, [r10 + 0];
        mov r11, 0xFFFFFF00FFFFFFFF;      // clear state byte (bits 32..39)
        and rax, r11;
        mov r11, 1;
        shl r11, 32;
        or  rax, r11;                    // state = CONFIGURED
        mov [r10 + 0], rax;

        mov rdi, 2;                      // CFGS counter
        call a2dp_note;
        xor rax, rax;
        jmp a2dp_sc2_out;

      a2dp_sc2_bad_sep:
        mov rax, 0xFFFFF2CE;
        jmp a2dp_sc2_bump;
      a2dp_sc2_bad_state:
        mov rax, 0xFFFFF2C9;
        jmp a2dp_sc2_bump;
      a2dp_sc2_bad_sr:
        mov rax, 0xFFFFF2C7;
        jmp a2dp_sc2_bump;
      a2dp_sc2_bad_cm:
        mov rax, 0xFFFFF2C6;
      a2dp_sc2_bump:
        push rax;
        mov rdi, 7;
        call a2dp_note;
        pop rax;
      a2dp_sc2_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // a2dp_edge_advance(row_id, next_state, counter, allowed_prev) --
  // shared FSM edge helper.  Verifies row live, current state ==
  // allowed_prev, then sets state and bumps counter.
  pub let a2dp_edge_advance : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (next_state: u64) (counter: u64) (allowed_prev: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): shared FSM edge helper.  Refuses BAD_SEP / BAD_STATE.  Labels prefixed a2dp_ea_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // next_state
        mov r14, rdx;                    // counter
        mov r15, rcx;                    // allowed_prev

        mov rdi, r12;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_ea_bad_sep;

        mov rdi, r12;
        call a2dp_sep_state;
        cmp rax, r15;
        jne a2dp_ea_bad_state;

        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        mov r11, 0xFFFFFF00FFFFFFFF;
        and rax, r11;
        mov r11, r13;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 0], rax;

        mov rdi, r14;
        call a2dp_note;
        xor rax, rax;
        jmp a2dp_ea_out;

      a2dp_ea_bad_sep:
        mov rax, 0xFFFFF2CE;
        jmp a2dp_ea_bump;
      a2dp_ea_bad_state:
        mov rax, 0xFFFFF2C9;
      a2dp_ea_bump:
        push rax;
        mov rdi, 7;
        call a2dp_note;
        pop rax;
      a2dp_ea_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let a2dp_open : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): CONFIGURED -> OPEN. Labels prefixed a2dp_op_.",
      block: {
        mov rsi, 2;                      // OPEN
        mov rdx, 3;                      // OPENS counter
        mov rcx, 1;                      // allowed_prev = CONFIGURED
        call a2dp_edge_advance;
        ret
      }
    }

  pub let a2dp_start : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): OPEN -> STREAMING. Labels prefixed a2dp_sta_.",
      block: {
        mov rsi, 3;                      // STREAMING
        mov rdx, 4;                      // STARTS counter
        mov rcx, 2;                      // allowed_prev = OPEN
        call a2dp_edge_advance;
        ret
      }
    }

  pub let a2dp_suspend : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): STREAMING -> OPEN. Labels prefixed a2dp_su_.",
      block: {
        mov rsi, 2;                      // OPEN
        mov rdx, 5;                      // SUSPENDS counter
        mov rcx, 3;                      // allowed_prev = STREAMING
        call a2dp_edge_advance;
        ret
      }
    }

  // a2dp_close(row_id) -- any live state -> CLOSING -> IDLE; releases
  // the row.  Refuses BAD_SEP.
  pub let a2dp_close : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-001 (#1339): any -> CLOSING -> IDLE; row released. Labels prefixed a2dp_cl_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2dp_sep_in_use;
        cmp rax, 0;
        je  a2dp_cl_bad_sep;

        lea r10, [rip + _a2dp_seps];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        // Transient CLOSING (4).
        mov rax, [r10 + 0];
        mov r11, 0xFFFFFF00FFFFFFFF;
        and rax, r11;
        mov r11, 4;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 0], rax;

        // Immediate release.
        mov rdi, r12;
        call a2dp_sep_release;

        mov rdi, 6;                      // CLOSES counter
        call a2dp_note;
        xor rax, rax;
        jmp a2dp_cl_out;

      a2dp_cl_bad_sep:
        mov rax, 0xFFFFF2CE;
        push rax;
        mov rdi, 7;
        call a2dp_note;
        pop rax;
      a2dp_cl_out:
        pop r12;
        ret
      }
    }
}
