// src/kernel/core/drivers/bt/a2dp_bridge.pdx — R39.M5-002 (#1340)
//
// Audio-graph bridge: wire one A2DP SEP (KIND_BT_L2CAP media stream,
// SBC or AAC-encoded) to one KIND_PCM_STREAM (R33 audio graph).
// Decodes inbound SBC/AAC frames to PCM samples, encodes outbound PCM
// to SBC/AAC frames, and reports the sample-rate + channel-count that
// the two ends have agreed to.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CANONICAL BRIDGE-RECORD TABLE for A2DP <-> KIND_PCM_STREAM
// wiring.  Every live bridge record names (a2dp_sep_id, pcm_stream_slot,
// direction, running_frame_count, running_byte_count, last_delta_ns) so
// the retransmission module (a2dp_rtx.pdx) can compute drift and the
// audio bridge can report position.  A second bridge table would let
// one path push PCM into a stream nobody had activated and the other
// path see the stream as inactive.
//
// It is NOT the codec implementation.  The `a2db_decode_frame` and
// `a2db_encode_frame` helpers are STRUCTURAL: they return sample-count
// and byte-count contracts derived from the SBC/AAC frame header, but
// the actual DCT / MDCT math lives in the userland codec supervisor
// that R35 stood up.  This module NEVER writes into a KIND_PCM_STREAM
// row directly -- it invokes the R33 audio-graph API against the
// stream slot and the audio subsystem does the ring bookkeeping.
//
// It is NOT the KIND_PCM_STREAM state.  _pcm_stream_table is confined
// to core/cap/kind_pcm_stream.o (see tools/build.sh); this module only
// READS the stream slot's clock / rate / channels through the
// pcm_stream_* selectors.
//
// It is NOT the transport.  The AVDTP media stream travels on L2CAP
// (R39.M2, PSM 0x0019); this module accepts already-reassembled frames
// as (payload_ptr, payload_len) pairs.
//
// =============================================================================
// §1  BRIDGE RECORD TABLE
// =============================================================================
//
// A2DB_BRIDGE_MAX = 2.  One typical live A2DP session is (SBC or AAC)
// source-to-sink; a second slot lets a call-audio session (SCO/HFP) run
// in parallel without evicting the media bridge.  The fixed cap is
// deliberate at R39.M5.
//
// Per-bridge row (8 u64, 64 bytes; row_id r lives at word offset r*8):
//
//   [+0]   active(bit 0) | direction(bit 1) | codec(bits 8..15) |
//          seq_wrap_flag(bit 16)
//   [+8]   a2dp_sep_id
//   [+16]  pcm_stream_slot                 (cap slot of KIND_PCM_STREAM)
//   [+24]  agreed_sample_rate_hz           (8000..96000)
//   [+32]  agreed_channel_count            (1 or 2)
//   [+40]  frames_seen                     (running frame counter)
//   [+48]  bytes_seen                      (running codec byte counter)
//   [+56]  last_frame_epoch                (u64 monotonic ordinal; the
//                                            rtx module reads this to
//                                            compute drift.)
//
// direction bit: 0 = INBOUND (peer -> local, decode), 1 = OUTBOUND
// (local -> peer, encode).
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _a2db_bridges, _a2db_stats and _a2db_init are written only by
// helpers in this module.  tools/build.sh confines relocations against
// each to core/drivers/bt/a2dp_bridge.o so a second writer cannot
// silently forge a bridge row or promote frames onto a stream slot
// that never registered.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF2B0..0xFFFFF2BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: a2dp 0xFFFFF2C0..0x2CF;
// adjacent free band below: a2dp_rtx candidate 0xFFFFF2A0..0x2AF).

module A2dpBridge = structure {

  // §1: direction bits.
  pub let A2DB_DIR_INBOUND  : u64 = 0
  pub let A2DB_DIR_OUTBOUND : u64 = 1

  // §1: sizing.
  pub let A2DB_BRIDGE_MAX  : u64 = 2
  pub let A2DB_ROW_WORDS   : u64 = 8
  pub let A2DB_ROW_NONE    : u64 = 0xFF

  // Column offsets (byte offsets).
  pub let A2DB_COL_META          : u64 = 0
  pub let A2DB_COL_SEP_ID        : u64 = 8
  pub let A2DB_COL_PCM_SLOT      : u64 = 16
  pub let A2DB_COL_SR_HZ         : u64 = 24
  pub let A2DB_COL_CHANNELS      : u64 = 32
  pub let A2DB_COL_FRAMES        : u64 = 40
  pub let A2DB_COL_BYTES         : u64 = 48
  pub let A2DB_COL_LAST_EPOCH    : u64 = 56

  // Frame contract limits.
  pub let A2DB_FRAME_MIN_BYTES : u64 = 8
  pub let A2DB_FRAME_MAX_BYTES : u64 = 1024
  pub let A2DB_SAMPLES_PER_SBC_FRAME : u64 = 128     // A2DP §12.4.2 baseline
  pub let A2DB_SAMPLES_PER_AAC_FRAME : u64 = 1024    // AAC-LC baseline

  // Codec constants (must match a2dp.pdx).
  pub let A2DB_CODEC_SBC : u64 = 0x00
  pub let A2DB_CODEC_AAC : u64 = 0x02

  // §3: failure taxonomy 0xFFFFF2B0..0xFFFFF2BF.
  pub let A2DB_OK                : u64 = 0
  pub let A2DB_BAD_ARG           : u64 = 0xFFFFF2BF
  pub let A2DB_BAD_ROW           : u64 = 0xFFFFF2BE
  pub let A2DB_BAD_SEP           : u64 = 0xFFFFF2BD
  pub let A2DB_BAD_STREAM        : u64 = 0xFFFFF2BC
  pub let A2DB_BAD_DIRECTION     : u64 = 0xFFFFF2BB
  pub let A2DB_BAD_RATE          : u64 = 0xFFFFF2BA
  pub let A2DB_BAD_CHANNELS      : u64 = 0xFFFFF2B9
  pub let A2DB_BAD_CODEC         : u64 = 0xFFFFF2B8
  pub let A2DB_BAD_FRAME         : u64 = 0xFFFFF2B7
  pub let A2DB_BAD_STATE         : u64 = 0xFFFFF2B6
  pub let A2DB_ENOSPC            : u64 = 0xFFFFF2B5
  pub let A2DB_NOT_INITIALIZED   : u64 = 0xFFFFF2B4
  pub let A2DB_ROW_IN_USE        : u64 = 0xFFFFF2B3
  pub let A2DB_STREAM_MISMATCH   : u64 = 0xFFFFF2B2
  pub let A2DB_REFUSED           : u64 = 0xFFFFF2B1

  // §2: state cells.  2 rows * 8 u64s = 16 u64s.
  pub let mut _a2db_bridges : [u64; 16] = uninit @align(64)
  pub let mut _a2db_stats   : [u64;  8] = uninit @align(64)
  pub let mut _a2db_init    : u64       = 0

  // Counter ordinals.
  pub let A2DB_ST_ATTACHES  : u64 = 0
  pub let A2DB_ST_DETACHES  : u64 = 1
  pub let A2DB_ST_DECODES   : u64 = 2
  pub let A2DB_ST_ENCODES   : u64 = 3
  pub let A2DB_ST_UNDERRUNS : u64 = 4
  pub let A2DB_ST_MISMATCH  : u64 = 5
  pub let A2DB_ST_FRAME_BAD : u64 = 6
  pub let A2DB_ST_REFUSED   : u64 = 7

  // ==========================================================================
  // Reset + init.
  // ==========================================================================

  pub let a2db_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): clear bridge table + counters + init flag. Labels prefixed a2db_rs_.",
      block: {
        lea r10, [rip + _a2db_bridges];
        xor rax, rax;
        xor rcx, rcx;
      a2db_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  a2db_rs_rows;

        lea r10, [rip + _a2db_stats];
        xor rcx, rcx;
      a2db_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  a2db_rs_stats;

        lea r10, [rip + _a2db_init];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    } @no_frame

  pub let a2db_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): mark module initialised.  Idempotent. Labels prefixed a2db_in_.",
      block: {
        call a2db_reset;
        lea r10, [rip + _a2db_init];
        mov rax, 1;
        mov [r10], rax;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let a2db_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): counter bump. Labels prefixed a2db_nt_.",
      block: {
        cmp rdi, 8;
        jae a2db_nt_out;
        lea r10, [rip + _a2db_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      a2db_nt_out:
        ret
      }
    } @no_frame

  pub let a2db_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): counter read. Labels prefixed a2db_st_.",
      block: {
        cmp rdi, 8;
        jae a2db_st_zero;
        lea r10, [rip + _a2db_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      a2db_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let a2db_dir_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-002 (#1340): 1 iff direction is 0 or 1. Labels prefixed a2db_dv_.",
      block: {
        cmp rdi, 1;
        ja  a2db_dv_no;
        mov rax, 1;
        ret;
      a2db_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let a2db_rate_valid : (u64) -> u64 !{} @{} =
    fn (hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-002 (#1340): 1 iff hz in [8000..96000] (a permissive superset of A2DP + LE Audio ranges). Labels prefixed a2db_rv_.",
      block: {
        mov r10, 8000;
        cmp rdi, r10;
        jb  a2db_rv_no;
        mov r10, 96000;
        cmp rdi, r10;
        ja  a2db_rv_no;
        mov rax, 1;
        ret;
      a2db_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let a2db_ch_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-002 (#1340): 1 iff n in {1,2}. Labels prefixed a2db_chv_.",
      block: {
        cmp rdi, 1;
        je  a2db_chv_yes;
        cmp rdi, 2;
        je  a2db_chv_yes;
        xor rax, rax;
        ret;
      a2db_chv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let a2db_codec_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M5-002 (#1340): 1 iff codec is SBC (0) or AAC (2).  Labels prefixed a2db_cv_.",
      block: {
        cmp rdi, 0;
        je  a2db_cv_yes;
        cmp rdi, 2;
        je  a2db_cv_yes;
        xor rax, rax;
        ret;
      a2db_cv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let a2db_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): 1 iff row_id<MAX and META bit 0 set. Labels prefixed a2db_iu_.",
      block: {
        cmp rdi, 2;
        jae a2db_iu_no;
        lea r10, [rip + _a2db_bridges];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  a2db_iu_no;
        mov rax, 1;
        ret;
      a2db_iu_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let a2db_row_direction : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): direction bit of a live row.  Labels prefixed a2db_rd_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_rd_bad;
        lea r10, [rip + _a2db_bridges];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 1;
        and rax, 0x1;
        jmp a2db_rd_out;
      a2db_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2db_rd_out:
        pop r12;
        ret
      }
    }

  pub let a2db_row_frames : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): frames_seen counter of a live row.  Labels prefixed a2db_rf_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_rf_bad;
        lea r10, [rip + _a2db_bridges];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];
        jmp a2db_rf_out;
      a2db_rf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2db_rf_out:
        pop r12;
        ret
      }
    }

  pub let a2db_row_epoch : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): last_frame_epoch of a live row.  Labels prefixed a2db_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_re_bad;
        lea r10, [rip + _a2db_bridges];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 56];
        jmp a2db_re_out;
      a2db_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2db_re_out:
        pop r12;
        ret
      }
    }

  pub let a2db_row_pcm_slot : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): pcm_stream_slot of a live row.  Labels prefixed a2db_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_rp_bad;
        lea r10, [rip + _a2db_bridges];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp a2db_rp_out;
      a2db_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      a2db_rp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // a2db_find_sep(a2dp_sep_id) -- return row_id whose SEP matches, or
  // A2DB_ROW_NONE.  a2dp_rtx.pdx uses this to look up drift state
  // without a second table.
  // ==========================================================================

  pub let a2db_find_sep : (u64) -> u64 !{mem} @{} =
    fn (sep_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): linear scan of _a2db_bridges for first row whose sep_id matches.  Labels prefixed a2db_fs_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      a2db_fs_scan:
        cmp rbx, 2;
        jae a2db_fs_none;
        lea r10, [rip + _a2db_bridges];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  a2db_fs_next;
        mov rax, [r10 + 8];
        cmp rax, r12;
        je  a2db_fs_hit;
      a2db_fs_next:
        add rbx, 1;
        jmp a2db_fs_scan;
      a2db_fs_hit:
        mov rax, rbx;
        jmp a2db_fs_out;
      a2db_fs_none:
        mov rax, 0xFF;
      a2db_fs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // a2db_attach(sep_id, pcm_slot, direction, codec, sample_rate_hz,
  //             channels) -- register a bridge.
  //
  // Refuses NOT_INITIALIZED / BAD_DIRECTION / BAD_CODEC / BAD_RATE /
  // BAD_CHANNELS / STREAM_MISMATCH (sep already bridged) / ENOSPC.
  // Returns row_id on success.  ONE WRITER of the positive edge.
  // ==========================================================================

  pub let a2db_attach : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (sep_id: u64) (pcm_slot: u64) (direction: u64) (codec: u64) (rate_hz: u64) (channels: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): claim one bridge row.  THE ONE WRITER of the positive edge of _a2db_bridges.  Refuses NOT_INITIALIZED / BAD_DIRECTION / BAD_CODEC / BAD_RATE / BAD_CHANNELS / STREAM_MISMATCH / ENOSPC. Labels prefixed a2db_at_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Args -> callee-saved.  With 6 args, the 5th and 6th arrive on
        // the stack (SysV) BUT this project's assembler passes them in
        // registers r8/r9 (see gatt_attr_insert which uses 4 args and
        // R32.M4 GTT walkers which use 5).  Preserve them.
        mov r12, rdi;                    // sep_id
        mov r13, rsi;                    // pcm_slot
        mov r14, rdx;                    // direction
        mov r15, rcx;                    // codec
        // rate_hz (r8) + channels (r9) held on the stack via push below.
        push r8;
        push r9;

        // Init check.
        lea r10, [rip + _a2db_init];
        mov rax, [r10];
        cmp rax, 0;
        je  a2db_at_notinit;

        // Direction check.
        mov rdi, r14;
        call a2db_dir_valid;
        cmp rax, 0;
        je  a2db_at_bad_dir;

        // Codec check.
        mov rdi, r15;
        call a2db_codec_valid;
        cmp rax, 0;
        je  a2db_at_bad_codec;

        // Rate check.
        mov rdi, [rsp + 8];              // rate_hz saved above r9
        call a2db_rate_valid;
        cmp rax, 0;
        je  a2db_at_bad_rate;

        // Channels check.
        mov rdi, [rsp + 0];              // channels
        call a2db_ch_valid;
        cmp rax, 0;
        je  a2db_at_bad_ch;

        // Duplicate SEP check.
        mov rdi, r12;
        call a2db_find_sep;
        mov r11, 0xFF;
        cmp rax, r11;
        jne a2db_at_mismatch;

        // Free-row scan.
        xor rbx, rbx;
      a2db_at_scan:
        cmp rbx, 2;
        jae a2db_at_enospc;
        lea r10, [rip + _a2db_bridges];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  a2db_at_hit;
        add rbx, 1;
        jmp a2db_at_scan;

      a2db_at_hit:
        // META: active | direction | codec.
        mov rax, r14;
        shl rax, 1;
        or  rax, 0x1;
        mov r11, r15;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;

        mov [r10 + 8],  r12;             // sep_id
        mov [r10 + 16], r13;             // pcm_slot
        mov rax, [rsp + 8];
        mov [r10 + 24], rax;             // rate_hz
        mov rax, [rsp + 0];
        mov [r10 + 32], rax;             // channels
        xor rax, rax;
        mov [r10 + 40], rax;             // frames_seen
        mov [r10 + 48], rax;             // bytes_seen
        mov [r10 + 56], rax;             // last_frame_epoch

        mov rdi, 0;                      // ATTACHES counter
        call a2db_note;
        mov rax, rbx;                    // return row_id
        jmp a2db_at_out;

      a2db_at_notinit:
        mov rax, 0xFFFFF2B4;
        jmp a2db_at_bump;
      a2db_at_bad_dir:
        mov rax, 0xFFFFF2BB;
        jmp a2db_at_bump;
      a2db_at_bad_codec:
        mov rax, 0xFFFFF2B8;
        jmp a2db_at_bump;
      a2db_at_bad_rate:
        mov rax, 0xFFFFF2BA;
        jmp a2db_at_bump;
      a2db_at_bad_ch:
        mov rax, 0xFFFFF2B9;
        jmp a2db_at_bump;
      a2db_at_mismatch:
        mov rax, 0xFFFFF2B2;
        jmp a2db_at_bump;
      a2db_at_enospc:
        mov rax, 0xFFFFF2B5;
      a2db_at_bump:
        push rax;
        mov rdi, 7;
        call a2db_note;
        pop rax;
      a2db_at_out:
        add rsp, 16;                     // restore r8/r9 slots
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // a2db_detach(row_id) -- release the bridge row.  ONE WRITER of the
  // negative edge.  Refuses BAD_ROW.
  // ==========================================================================

  pub let a2db_detach : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): release one bridge row.  Labels prefixed a2db_dt_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_dt_bad;

        lea r10, [rip + _a2db_bridges];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 1;                      // DETACHES counter
        call a2db_note;
        xor rax, rax;
        jmp a2db_dt_out;

      a2db_dt_bad:
        mov rax, 0xFFFFF2BE;
        push rax;
        mov rdi, 7;
        call a2db_note;
        pop rax;
      a2db_dt_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Frame contract.
  //
  // a2db_decode_frame(row_id, frame_len)  --  inbound: peer wrote a
  //   compressed frame of frame_len bytes; return the number of PCM
  //   samples the payload denotes.  Advances frames_seen, bytes_seen
  //   and last_frame_epoch.
  //
  // a2db_encode_frame(row_id, sample_count)  --  outbound: the audio
  //   graph produced `sample_count` PCM samples; return the number of
  //   codec bytes the encoder will emit.
  //
  // Neither call performs the codec math (that lives in the userland
  // codec supervisor).  They both maintain the running counters and
  // enforce the FRAME_MIN / FRAME_MAX / SAMPLES_PER_FRAME contract.
  // ==========================================================================

  pub let a2db_decode_frame : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (frame_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): inbound frame contract.  Refuses BAD_ROW / BAD_DIRECTION / BAD_FRAME.  Returns sample-count for the frame; advances frames_seen, bytes_seen, last_frame_epoch. Labels prefixed a2db_df_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // frame_len

        mov rdi, r12;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_df_bad_row;

        // Direction must be INBOUND (0).
        mov rdi, r12;
        call a2db_row_direction;
        cmp rax, 0;
        jne a2db_df_bad_dir;

        // Frame length within [MIN..MAX].
        mov r10, 8;
        cmp r13, r10;
        jb  a2db_df_bad_frame;
        mov r10, 1024;
        cmp r13, r10;
        ja  a2db_df_bad_frame;

        // Compute samples-per-frame from codec.
        lea r10, [rip + _a2db_bridges];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;                   // codec

        mov rcx, 128;                    // SBC default
        cmp rax, 2;                      // AAC?
        jne a2db_df_have_samples;
        mov rcx, 1024;
      a2db_df_have_samples:
        mov rbx, rcx;                    // samples for this frame

        // Advance counters.
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;             // frames_seen++
        mov rax, [r10 + 48];
        add rax, r13;
        mov [r10 + 48], rax;             // bytes_seen += frame_len
        mov rax, [r10 + 56];
        add rax, rbx;                    // last_epoch += sample-count
        mov [r10 + 56], rax;

        mov rdi, 2;                      // DECODES counter
        call a2db_note;

        mov rax, rbx;
        jmp a2db_df_out;

      a2db_df_bad_row:
        mov rax, 0xFFFFF2BE;
        jmp a2db_df_bump;
      a2db_df_bad_dir:
        mov rax, 0xFFFFF2BB;
        jmp a2db_df_bump;
      a2db_df_bad_frame:
        mov rax, 0xFFFFF2B7;
      a2db_df_bump:
        push rax;
        mov rdi, 6;                      // FRAME_BAD if frame-shaped
        call a2db_note;
        mov rdi, 7;
        call a2db_note;
        pop rax;
      a2db_df_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let a2db_encode_frame : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (sample_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): outbound frame contract.  Refuses BAD_ROW / BAD_DIRECTION / BAD_FRAME.  Returns codec-byte-count for the frame (structural estimate: 64 B for SBC, 512 B for AAC per baseline).  Advances frames_seen, bytes_seen, last_frame_epoch. Labels prefixed a2db_ef_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_ef_bad_row;

        // Direction must be OUTBOUND (1).
        mov rdi, r12;
        call a2db_row_direction;
        cmp rax, 1;
        jne a2db_ef_bad_dir;

        // sample_count must match the codec's samples-per-frame.
        lea r10, [rip + _a2db_bridges];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        mov rcx, 128;                    // SBC
        mov rbx, 64;                     // SBC byte estimate
        cmp rax, 2;
        jne a2db_ef_have_shape;
        mov rcx, 1024;                   // AAC
        mov rbx, 512;
      a2db_ef_have_shape:
        cmp r13, rcx;
        jne a2db_ef_bad_frame;

        // Advance counters.
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, [r10 + 48];
        add rax, rbx;
        mov [r10 + 48], rax;
        mov rax, [r10 + 56];
        add rax, r13;
        mov [r10 + 56], rax;

        mov rdi, 3;                      // ENCODES counter
        call a2db_note;
        mov rax, rbx;
        jmp a2db_ef_out;

      a2db_ef_bad_row:
        mov rax, 0xFFFFF2BE;
        jmp a2db_ef_bump;
      a2db_ef_bad_dir:
        mov rax, 0xFFFFF2BB;
        jmp a2db_ef_bump;
      a2db_ef_bad_frame:
        mov rax, 0xFFFFF2B7;
      a2db_ef_bump:
        push rax;
        mov rdi, 6;
        call a2db_note;
        mov rdi, 7;
        call a2db_note;
        pop rax;
      a2db_ef_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // a2db_report_underrun(row_id) -- caller signals a decoder-side
  // starvation.  Advances the UNDERRUNS counter; the a2dp_rtx module
  // reads this via a2db_stat to decide drain policy.
  // ==========================================================================

  pub let a2db_report_underrun : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M5-002 (#1340): counter-only signal from a stalled consumer.  Labels prefixed a2db_ur_.",
      block: {
        push r12;
        mov r12, rdi;
        call a2db_row_in_use;
        cmp rax, 0;
        je  a2db_ur_bad;
        mov rdi, 4;                      // UNDERRUNS counter
        call a2db_note;
        xor rax, rax;
        jmp a2db_ur_out;
      a2db_ur_bad:
        mov rax, 0xFFFFF2BE;
      a2db_ur_out:
        pop r12;
        ret
      }
    }
}
