// src/kernel/core/drivers/bt/bt_hid.pdx — R39.M6-002 (#1344)
//
// Bluetooth HID Profile (HID over L2CAP) — the transport that lets a
// BT-attached keyboard, mouse or trackpad appear to the R32 HID stack
// exactly the way an I²C-HID or USB-HID device would.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// The BT HID specification (BT SIG HID Profile 1.1, §5) reserves TWO
// L2CAP PSMs per HID peer: the Control channel at PSM 0x11 (SET_REPORT,
// GET_REPORT, SET_PROTOCOL, DATA_REQUEST) and the Interrupt channel at
// PSM 0x13 (report streaming toward the host, low-latency).  This module
// is the CANONICAL BOOKKEEPING SITE that pairs those two CIDs with a
// KIND_HID_DEVICE row (R32.M3-001) through composite_bind, so a stream
// of Interrupt-channel HID reports is routed into exactly the HID class
// driver that opened the pair.
//
// It IS the routing table.  A second table would let one path see the
// interrupt-channel CID as bound to keyboard slot k and the other as
// bound to mouse slot m — and the R32 event fan-out (kind_hid_event)
// would happily deliver a keystroke into a stream nobody had opened.
//
// It is NOT the L2CAP transport (R39.M2 owns channel establishment,
// configuration and disconnection).  This module accepts already-
// allocated (ctrl_cid, intr_cid) pairs.
//
// It is NOT the HID report parser (R32.M2 report_parser owns that).
// This module accepts already-parsed report ordinals for its ingest
// contract.
//
// It is NOT KIND_HID_DEVICE.  The device row is minted by the R32.M3
// substrate; this module records the SLOT number the R32 mint returned
// and refuses to bind a slot that isn't live.
//
// =============================================================================
// §1  BIND TABLE
// =============================================================================
//
// BTHID_ROW_MAX = 4 — one for a keyboard, one for a mouse/trackpad, and
// two spare slots for composite devices (a keyboard-with-touchpad exposes
// two HID interfaces in parallel).  Fixed cap is deliberate at R39.M6.
//
// Per-row (4 u64, 32 bytes; row_id r lives at word offset r*4):
//
//   [+0]   active(bit 0) | dev_kind(bits 8..15) |
//          composite_bind_row(bits 16..23)
//   [+8]   ctrl_cid                (L2CAP Channel ID for PSM 0x11)
//   [+16]  intr_cid                (L2CAP Channel ID for PSM 0x13)
//   [+24]  hid_device_slot         (cap slot of KIND_HID_DEVICE)
//
// dev_kind: 0 = KEYBOARD, 1 = MOUSE.  A composite device consumes two
// rows, one per interface.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _bthid_rows, _bthid_stats and _bthid_init are written only by helpers
// in this module.  tools/build.sh confines relocations against each to
// core/drivers/bt/bt_hid.o so a second writer cannot forge a routing
// row (which would let keystrokes end up in the wrong subscriber's
// stream on a machine holding both a keyboard and a trackpad).
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF280..0xFFFFF28F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: hfp 0xFFFFF290..0x29F;
// adjacent free band below: le_audio 0xFFFFF270..0x27F).

module BtHid = structure {

  // §1 dev_kind.
  pub let BTHID_KIND_KEYBOARD : u64 = 0
  pub let BTHID_KIND_MOUSE    : u64 = 1

  // BT HID PSMs (BT HID §5).
  pub let BTHID_PSM_CTRL : u64 = 0x11
  pub let BTHID_PSM_INTR : u64 = 0x13

  // §1 sizing.
  pub let BTHID_ROW_MAX   : u64 = 4
  pub let BTHID_ROW_WORDS : u64 = 4
  pub let BTHID_ROW_NONE  : u64 = 0xFF

  // Column offsets (byte offsets).
  pub let BTHID_COL_META     : u64 = 0
  pub let BTHID_COL_CTRL_CID : u64 = 8
  pub let BTHID_COL_INTR_CID : u64 = 16
  pub let BTHID_COL_HID_SLOT : u64 = 24

  // Report-length contract.  BT HID §7.4.5: interrupt-channel payload is
  // 1 + N bytes (HIDP header + report body); N is bounded by the
  // negotiated report size and by the L2CAP MPS the pair agreed to.
  pub let BTHID_REPORT_MIN_BYTES : u64 = 2
  pub let BTHID_REPORT_MAX_BYTES : u64 = 512

  // §3 failure taxonomy 0xFFFFF280..0xFFFFF28F.
  pub let BTHID_OK                : u64 = 0
  pub let BTHID_BAD_ARG           : u64 = 0xFFFFF28F
  pub let BTHID_BAD_ROW           : u64 = 0xFFFFF28E
  pub let BTHID_BAD_PSM           : u64 = 0xFFFFF28D
  pub let BTHID_BAD_CID           : u64 = 0xFFFFF28C
  pub let BTHID_BAD_KIND          : u64 = 0xFFFFF28B
  pub let BTHID_BAD_DEVICE        : u64 = 0xFFFFF28A
  pub let BTHID_ENOSPC            : u64 = 0xFFFFF289
  pub let BTHID_NOT_INITIALIZED   : u64 = 0xFFFFF288
  pub let BTHID_ROW_IN_USE        : u64 = 0xFFFFF287
  pub let BTHID_DUP_DEVICE        : u64 = 0xFFFFF286
  pub let BTHID_BAD_REPORT        : u64 = 0xFFFFF285
  pub let BTHID_BIND_FAIL         : u64 = 0xFFFFF284
  pub let BTHID_UNBOUND           : u64 = 0xFFFFF283
  pub let BTHID_CID_COLLISION     : u64 = 0xFFFFF282
  pub let BTHID_REFUSED           : u64 = 0xFFFFF281

  // §2 state cells.  4 rows * 4 u64s = 16 u64s.
  pub let mut _bthid_rows  : [u64; 16] = uninit @align(64)
  pub let mut _bthid_stats : [u64;  8] = uninit @align(64)
  pub let mut _bthid_init  : u64       = 0

  // Counter ordinals.
  pub let BTHID_ST_BINDS    : u64 = 0
  pub let BTHID_ST_UNBINDS  : u64 = 1
  pub let BTHID_ST_REPORTS  : u64 = 2
  pub let BTHID_ST_KEYBOARD : u64 = 3
  pub let BTHID_ST_MOUSE    : u64 = 4
  pub let BTHID_ST_BAD_RPT  : u64 = 5
  pub let BTHID_ST_COMPOSED : u64 = 6
  pub let BTHID_ST_REFUSED  : u64 = 7

  // ==========================================================================
  // Reset + init.
  // ==========================================================================

  pub let bthid_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): clear bind table + counters + init flag. Labels prefixed bthid_rs_.",
      block: {
        lea r10, [rip + _bthid_rows];
        xor rax, rax;
        xor rcx, rcx;
      bthid_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  bthid_rs_rows;

        lea r10, [rip + _bthid_stats];
        xor rcx, rcx;
      bthid_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bthid_rs_stats;

        lea r10, [rip + _bthid_init];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    }

  pub let bthid_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): mark module initialised.  Idempotent. Labels prefixed bthid_in_.",
      block: {
        call bthid_reset;
        lea r10, [rip + _bthid_init];
        mov rax, 1;
        mov [r10], rax;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let bthid_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): counter bump. Labels prefixed bthid_nt_.",
      block: {
        cmp rdi, 8;
        jae bthid_nt_out;
        lea r10, [rip + _bthid_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bthid_nt_out:
        ret
      }
    }

  pub let bthid_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): counter read. Labels prefixed bthid_st_.",
      block: {
        cmp rdi, 8;
        jae bthid_st_zero;
        lea r10, [rip + _bthid_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bthid_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let bthid_psm_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-002 (#1344): 1 iff p is CTRL (0x11) or INTR (0x13). Labels prefixed bthid_pv_.",
      block: {
        cmp rdi, 0x11;
        je  bthid_pv_yes;
        cmp rdi, 0x13;
        je  bthid_pv_yes;
        xor rax, rax;
        ret;
      bthid_pv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let bthid_kind_valid : (u64) -> u64 !{} @{} =
    fn (k: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-002 (#1344): 1 iff k in {0,1}. Labels prefixed bthid_kv_.",
      block: {
        cmp rdi, 1;
        ja  bthid_kv_no;
        mov rax, 1;
        ret;
      bthid_kv_no:
        xor rax, rax;
        ret
      }
    }

  pub let bthid_cid_valid : (u64) -> u64 !{} @{} =
    fn (cid: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-002 (#1344): 1 iff cid in the L2CAP dynamic range (0x0040..0xFFFF). Labels prefixed bthid_cv_.",
      block: {
        mov r10, 0x0040;
        cmp rdi, r10;
        jb  bthid_cv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  bthid_cv_no;
        mov rax, 1;
        ret;
      bthid_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.  row_id r lives at word offset r*4 in _bthid_rows.
  // ==========================================================================

  pub let bthid_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): 1 iff row_id<MAX and META bit 0 set. Labels prefixed bthid_iu_.",
      block: {
        cmp rdi, 4;
        jae bthid_iu_no;
        lea r10, [rip + _bthid_rows];
        mov r11, rdi;
        shl r11, 5;                      // row_id * 32 bytes
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  bthid_iu_no;
        mov rax, 1;
        ret;
      bthid_iu_no:
        xor rax, rax;
        ret
      }
    }

  pub let bthid_row_kind : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): dev_kind of a live bind row. Labels prefixed bthid_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call bthid_row_in_use;
        cmp rax, 0;
        je  bthid_rk_bad;
        lea r10, [rip + _bthid_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp bthid_rk_out;
      bthid_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bthid_rk_out:
        pop r12;
        ret
      }
    }

  pub let bthid_row_ctrl_cid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): ctrl_cid of a live bind row. Labels prefixed bthid_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call bthid_row_in_use;
        cmp rax, 0;
        je  bthid_rc_bad;
        lea r10, [rip + _bthid_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp bthid_rc_out;
      bthid_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bthid_rc_out:
        pop r12;
        ret
      }
    }

  pub let bthid_row_intr_cid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): intr_cid of a live bind row. Labels prefixed bthid_ri_.",
      block: {
        push r12;
        mov r12, rdi;
        call bthid_row_in_use;
        cmp rax, 0;
        je  bthid_ri_bad;
        lea r10, [rip + _bthid_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp bthid_ri_out;
      bthid_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bthid_ri_out:
        pop r12;
        ret
      }
    }

  pub let bthid_row_hid_slot : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): hid_device_slot of a live bind row. Labels prefixed bthid_rh_.",
      block: {
        push r12;
        mov r12, rdi;
        call bthid_row_in_use;
        cmp rax, 0;
        je  bthid_rh_bad;
        lea r10, [rip + _bthid_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp bthid_rh_out;
      bthid_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bthid_rh_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bthid_find_hid(hid_slot) -> row_id | BTHID_ROW_NONE.  Duplicate-
  // detector: one HID device slot may be bound only once at a time.
  // ==========================================================================

  pub let bthid_find_hid : (u64) -> u64 !{mem} @{} =
    fn (hid_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): linear scan of _bthid_rows for first row whose hid_slot matches. Labels prefixed bthid_fh_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      bthid_fh_scan:
        cmp rbx, 4;
        jae bthid_fh_none;
        lea r10, [rip + _bthid_rows];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  bthid_fh_next;
        mov rax, [r10 + 24];
        cmp rax, r12;
        je  bthid_fh_hit;
      bthid_fh_next:
        add rbx, 1;
        jmp bthid_fh_scan;
      bthid_fh_hit:
        mov rax, rbx;
        jmp bthid_fh_out;
      bthid_fh_none:
        mov rax, 0xFF;
      bthid_fh_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bthid_find_cid(cid) -> row_id | BTHID_ROW_NONE.  Collision detector
  // for L2CAP CIDs: no two live rows may share a ctrl OR intr CID.
  // ==========================================================================

  pub let bthid_find_cid : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): linear scan of _bthid_rows for first row whose ctrl_cid or intr_cid equals cid. Labels prefixed bthid_fc_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      bthid_fc_scan:
        cmp rbx, 4;
        jae bthid_fc_none;
        lea r10, [rip + _bthid_rows];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  bthid_fc_next;
        mov rax, [r10 + 8];
        cmp rax, r12;
        je  bthid_fc_hit;
        mov rax, [r10 + 16];
        cmp rax, r12;
        je  bthid_fc_hit;
      bthid_fc_next:
        add rbx, 1;
        jmp bthid_fc_scan;
      bthid_fc_hit:
        mov rax, rbx;
        jmp bthid_fc_out;
      bthid_fc_none:
        mov rax, 0xFF;
      bthid_fc_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bthid_bind(dev_kind, ctrl_cid, intr_cid, hid_slot) -- register the
  // routing for one BT HID peer.  Refuses NOT_INITIALIZED / BAD_KIND /
  // BAD_CID / DUP_DEVICE / CID_COLLISION / ENOSPC.  Returns row_id on
  // success.  ONE WRITER of the positive edge of _bthid_rows.
  //
  // The composite_bind row-id column records which R32 composite-bind
  // slot the pair was inserted into so a hot-unplug can tear both down
  // together.  At R39.M6 we record the encoded row-id but do not yet
  // call composite_bind_add (that requires the R32 interface slot the
  // BT peer synthesises — deferred to R39 hardware bring-up).
  // ==========================================================================

  pub let bthid_bind : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dev_kind: u64) (ctrl_cid: u64) (intr_cid: u64) (hid_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): claim one bind row.  THE ONE WRITER of the positive edge of _bthid_rows.  Refuses NOT_INITIALIZED / BAD_KIND / BAD_CID / DUP_DEVICE / CID_COLLISION / ENOSPC. Labels prefixed bthid_bd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // dev_kind
        mov r13, rsi;                    // ctrl_cid
        mov r14, rdx;                    // intr_cid
        mov r15, rcx;                    // hid_slot

        // Init check.
        lea r10, [rip + _bthid_init];
        mov rax, [r10];
        cmp rax, 0;
        je  bthid_bd_notinit;

        // Kind check.
        mov rdi, r12;
        call bthid_kind_valid;
        cmp rax, 0;
        je  bthid_bd_bad_kind;

        // CID checks.
        mov rdi, r13;
        call bthid_cid_valid;
        cmp rax, 0;
        je  bthid_bd_bad_cid;
        mov rdi, r14;
        call bthid_cid_valid;
        cmp rax, 0;
        je  bthid_bd_bad_cid;

        // ctrl and intr CIDs must differ.
        cmp r13, r14;
        je  bthid_bd_bad_cid;

        // Duplicate hid_slot check.
        mov rdi, r15;
        call bthid_find_hid;
        mov r11, 0xFF;
        cmp rax, r11;
        jne bthid_bd_dup;

        // Ctrl CID collision.
        mov rdi, r13;
        call bthid_find_cid;
        mov r11, 0xFF;
        cmp rax, r11;
        jne bthid_bd_coll;

        // Intr CID collision.
        mov rdi, r14;
        call bthid_find_cid;
        mov r11, 0xFF;
        cmp rax, r11;
        jne bthid_bd_coll;

        // Free-row scan.
        xor rbx, rbx;
      bthid_bd_scan:
        cmp rbx, 4;
        jae bthid_bd_enospc;
        lea r10, [rip + _bthid_rows];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  bthid_bd_hit;
        add rbx, 1;
        jmp bthid_bd_scan;

      bthid_bd_hit:
        // META: active(bit 0) | dev_kind(bits 8..15) |
        // composite_bind_row=row_id(bits 16..23).
        mov rax, r12;
        shl rax, 8;
        or  rax, 0x1;
        mov r11, rbx;
        and r11, 0xFF;
        shl r11, 16;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov [r10 + 8],  r13;             // ctrl_cid
        mov [r10 + 16], r14;             // intr_cid
        mov [r10 + 24], r15;             // hid_slot

        mov rdi, 0;                      // BINDS
        call bthid_note;

        // Note dev_kind counter.
        cmp r12, 0;
        jne bthid_bd_note_mouse;
        mov rdi, 3;                      // KEYBOARD
        call bthid_note;
        jmp bthid_bd_ret_row;
      bthid_bd_note_mouse:
        mov rdi, 4;                      // MOUSE
        call bthid_note;

      bthid_bd_ret_row:
        mov rax, rbx;
        jmp bthid_bd_out;

      bthid_bd_notinit:
        mov rax, 0xFFFFF288;
        jmp bthid_bd_bump;
      bthid_bd_bad_kind:
        mov rax, 0xFFFFF28B;
        jmp bthid_bd_bump;
      bthid_bd_bad_cid:
        mov rax, 0xFFFFF28C;
        jmp bthid_bd_bump;
      bthid_bd_dup:
        mov rax, 0xFFFFF286;
        jmp bthid_bd_bump;
      bthid_bd_coll:
        mov rax, 0xFFFFF282;
        jmp bthid_bd_bump;
      bthid_bd_enospc:
        mov rax, 0xFFFFF289;
      bthid_bd_bump:
        push rax;
        mov rdi, 7;                      // REFUSED
        call bthid_note;
        pop rax;
      bthid_bd_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // bthid_unbind(row_id) -- release the bind row.  ONE WRITER of the
  // negative edge.  Refuses BAD_ROW.
  // ==========================================================================

  pub let bthid_unbind : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): release one bind row. Labels prefixed bthid_ub_.",
      block: {
        push r12;
        mov r12, rdi;
        call bthid_row_in_use;
        cmp rax, 0;
        je  bthid_ub_bad;

        lea r10, [rip + _bthid_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rdi, 1;                      // UNBINDS
        call bthid_note;
        xor rax, rax;
        jmp bthid_ub_out;

      bthid_ub_bad:
        mov rax, 0xFFFFF28E;
        push rax;
        mov rdi, 7;
        call bthid_note;
        pop rax;
      bthid_ub_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // bthid_report_ingest(row_id, report_len) -- one HID report just
  // arrived on the interrupt channel of row_id; refuse malformed
  // (BAD_REPORT), refuse if the row is unbound (BAD_ROW).  Advances the
  // REPORTS counter and returns 0.
  //
  // At R39.M6 the actual fan-out into KIND_HID_EVENT is deferred: the
  // routing entry is here, and the R32 event supervisor's ingest side
  // is what the T14 bring-up will wire.  This function is the
  // structural half.
  // ==========================================================================

  pub let bthid_report_ingest : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (report_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-002 (#1344): report-arrival contract on the interrupt channel.  Refuses BAD_ROW / BAD_REPORT.  Advances REPORTS counter. Labels prefixed bthid_rp_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call bthid_row_in_use;
        cmp rax, 0;
        je  bthid_rp_bad_row;

        // report_len bounds.
        mov r10, 2;
        cmp r13, r10;
        jb  bthid_rp_bad_rpt;
        mov r10, 512;
        cmp r13, r10;
        ja  bthid_rp_bad_rpt;

        mov rdi, 2;                      // REPORTS
        call bthid_note;
        xor rax, rax;
        jmp bthid_rp_out;

      bthid_rp_bad_row:
        mov rax, 0xFFFFF28E;
        jmp bthid_rp_bump;
      bthid_rp_bad_rpt:
        mov rax, 0xFFFFF285;
      bthid_rp_bump:
        push rax;
        mov rdi, 5;                      // BAD_RPT if the shape was wrong
        call bthid_note;
        mov rdi, 7;
        call bthid_note;
        pop rax;
      bthid_rp_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
