// src/kernel/core/drivers/bt/l2cap_dyn.pdx — R39.M2-002 (#1328)
//
// L2CAP dynamic channels with LE Credit-Based Flow Control (BT §3.4).
// Owns the small session table backing CONNECT_REQ / CONNECT_RSP and
// FLOW_CONTROL_CREDIT_IND for connection-oriented LE channels, and the
// monotonic CID allocator that starts at 0x0040.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// LE CBFC (BT §3.4) is the flow-control mechanism connection-oriented
// L2CAP channels use above LE ACL: a peer advertises credits it is
// willing to receive, the sender consumes one credit per K-frame sent,
// and the peer replenishes with FLOW_CONTROL_CREDIT_IND.  A subscriber
// that carries a channel at credits=0 must not be able to force a send;
// the credit column on _ldyn_sessions is the gate, and every send path
// consults and decrements it under the row's ownership.
//
// It is NOT the L2CAP fixed channel surface (drivers/bt/l2cap_fixed.pdx)
// -- fixed CIDs 0x0004..0x0006 do not negotiate CONNECT_REQ; they are
// always live.
//
// It is NOT the KIND_BT_L2CAP_CHANNEL capability
// (cap/kind_bt_l2cap_channel.pdx) -- a KIND_BT_L2CAP_CHANNEL row names
// ONE side of a channel with credits FROZEN at mint; this module owns
// the mutable session backing that the profile stack drives against.
//
// It DOES NOT ISSUE MMIO.  The session table lives in this module's
// .bss and hci_cnvi.pdx frames anything that eventually reaches the
// wire.
//
// =============================================================================
// §1  DYNAMIC CID RANGE (BT §3.2)
// =============================================================================
//
// L2CAP §2.1 reserves CIDs 0x0040..0x007F for LE dynamic channels
// created via CONNECT_REQ.  This module allocates monotonically inside
// that range through _ldyn_next_cid; wrap-around at 0x0080 refuses
// (LDYN_ENOSPC) because a wrapped CID could collide with a still-live
// channel and misroute a frame.
//
// =============================================================================
// §2  SESSION TABLE
// =============================================================================
//
// _ldyn_sessions holds four rows of eight u64s (cid, psm, mtu, credits,
// hci_chan_slot, state, tx_count, rx_count).  A second table would let
// one path advance an FSM edge while another read the old state, so
// the row is the sole bookkeeping surface for one dynamic channel.
//
// Session states:
//   LDYN_STATE_IDLE       (0) -- row free
//   LDYN_STATE_REQUESTED  (1) -- CONNECT_REQ sent, awaiting RSP
//   LDYN_STATE_OPEN       (2) -- CONNECT_RSP OK, channel is live
//   LDYN_STATE_CLOSED     (3) -- disconnect ack'd
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF0E0..0xFFFFF0EF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: l2cap_fixed 0xFFFFF0F0..FF;
// adjacent free band below: bt_l2cap_channel schema 0xFFFFF0D0..DF).

module L2capDyn = structure {

  // §1: dynamic CID allocation range.
  pub let LDYN_CID_BASE : u64 = 0x0040
  pub let LDYN_CID_MAX  : u64 = 0x0080             // exclusive upper bound

  // §2: table geometry.
  pub let LDYN_SESSION_MAX : u64 = 4
  pub let LDYN_ROW_WORDS   : u64 = 8

  // §2: session states.
  pub let LDYN_STATE_IDLE      : u64 = 0
  pub let LDYN_STATE_REQUESTED : u64 = 1
  pub let LDYN_STATE_OPEN      : u64 = 2
  pub let LDYN_STATE_CLOSED    : u64 = 3
  pub let LDYN_STATE_MAX       : u64 = 3

  // §2: row column ordinals.
  pub let LDYN_COL_CID            : u64 = 0
  pub let LDYN_COL_PSM            : u64 = 1
  pub let LDYN_COL_MTU            : u64 = 2
  pub let LDYN_COL_CREDITS        : u64 = 3
  pub let LDYN_COL_HCI_CHAN_SLOT  : u64 = 4
  pub let LDYN_COL_STATE          : u64 = 5
  pub let LDYN_COL_TX_COUNT       : u64 = 6
  pub let LDYN_COL_RX_COUNT       : u64 = 7

  // CONNECT_RSP result codes (BT §4.23).
  pub let LDYN_RSP_SUCCESS         : u64 = 0
  pub let LDYN_RSP_PSM_UNSUPPORTED : u64 = 2
  pub let LDYN_RSP_NO_RESOURCES    : u64 = 4

  // MTU bound (per BT §3.2.2 LE minimum ATT MTU).
  pub let LDYN_MTU_MIN : u64 = 23

  // §3: failure taxonomy 0xFFFFF0E0..0xFFFFF0EF.
  pub let LDYN_OK                : u64 = 0
  pub let LDYN_ENOSPC            : u64 = 0xFFFFF0EF
  pub let LDYN_BAD_PSM           : u64 = 0xFFFFF0EE
  pub let LDYN_BAD_MTU           : u64 = 0xFFFFF0ED
  pub let LDYN_BAD_HCI           : u64 = 0xFFFFF0EC
  pub let LDYN_NO_CREDITS        : u64 = 0xFFFFF0EB
  pub let LDYN_UNKNOWN_CID       : u64 = 0xFFFFF0EA
  pub let LDYN_CONNECT_REFUSED   : u64 = 0xFFFFF0E9
  pub let LDYN_BAD_STATE         : u64 = 0xFFFFF0E8
  pub let LDYN_BAD_ARG           : u64 = 0xFFFFF0E7
  pub let LDYN_NOT_INITIALIZED   : u64 = 0xFFFFF0E6
  pub let LDYN_BAD_CID_ALLOC     : u64 = 0xFFFFF0E5
  pub let LDYN_ALREADY_OPEN      : u64 = 0xFFFFF0E4
  pub let LDYN_CREDIT_OVERFLOW   : u64 = 0xFFFFF0E3
  pub let LDYN_BAD_RSP_CODE      : u64 = 0xFFFFF0E2
  pub let LDYN_ALREADY_CLOSED    : u64 = 0xFFFFF0E1
  pub let LDYN_BAD_SESSION_SLOT  : u64 = 0xFFFFF0E0

  pub let LDYN_ROW_NONE : u64 = 0xFF

  // 4 rows x 8 words = 32 u64.
  pub let mut _ldyn_sessions : [u64; 32] = uninit @align(64)
  pub let mut _ldyn_stats    : [u64; 4]  = uninit @align(64)
  pub let mut _ldyn_init     : u64       = 0
  pub let mut _ldyn_next_cid : u64       = 0

  // Counter ordinals inside _ldyn_stats.
  pub let LDYN_ST_CONNECT_REQS : u64 = 0
  pub let LDYN_ST_CONNECT_RSPS : u64 = 1
  pub let LDYN_ST_CREDITS      : u64 = 2
  pub let LDYN_ST_REFUSED      : u64 = 3

  // ==========================================================================
  // ldyn_init -- reset session table + CID cursor.
  // ==========================================================================

  pub let ldyn_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): reset session table + counters + CID cursor. Labels prefixed ldyn_i_.",
      block: {
        lea r10, [rip + _ldyn_sessions];
        xor rax, rax;
        xor rcx, rcx;
      ldyn_i_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  ldyn_i_rows;

        lea r10, [rip + _ldyn_stats];
        xor rcx, rcx;
      ldyn_i_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  ldyn_i_stats;

        lea r10, [rip + _ldyn_next_cid];
        mov rax, 0x0040;
        mov [r10], rax;

        lea r10, [rip + _ldyn_init];
        mov rax, 1;
        mov [r10], rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let ldyn_psm_valid : (u64) -> u64 !{} @{} =
    fn (psm: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-002 (#1328): 1 iff psm non-zero and fits 16 bits (BT §4.2). Labels prefixed ldyn_pv_.",
      block: {
        cmp rdi, 0;
        je  ldyn_pv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  ldyn_pv_no;
        mov rax, 1;
        ret;
      ldyn_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let ldyn_mtu_valid : (u64) -> u64 !{} @{} =
    fn (mtu: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-002 (#1328): 1 iff mtu in [23, 0xFFFF] per BT §3.2.2. Labels prefixed ldyn_mv_.",
      block: {
        cmp rdi, 23;
        jb  ldyn_mv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  ldyn_mv_no;
        mov rax, 1;
        ret;
      ldyn_mv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let ldyn_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): counter bump. Labels prefixed ldyn_nt_.",
      block: {
        cmp rdi, 4;
        jae ldyn_nt_out;
        lea r10, [rip + _ldyn_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ldyn_nt_out:
        ret
      }
    }

  pub let ldyn_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): counter read. Labels prefixed ldyn_stt_.",
      block: {
        cmp rdi, 4;
        jae ldyn_stt_zero;
        lea r10, [rip + _ldyn_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ldyn_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row addressing helpers.
  // ==========================================================================

  pub let ldyn_row_addr : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): row pointer or 0. Labels prefixed ldyn_ra_.",
      block: {
        cmp rdi, 4;
        jae ldyn_ra_no;
        lea r10, [rip + _ldyn_sessions];
        mov r11, rdi;
        shl r11, 6;                       // 8 u64 * 8 = 64
        add r10, r11;
        mov rax, r10;
        ret;
      ldyn_ra_no:
        xor rax, rax;
        ret
      }
    }

  pub let ldyn_find_by_cid : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): live row with column CID == cid, or ROW_NONE. Refuses 0. Labels prefixed ldyn_fc_.",
      block: {
        cmp rdi, 0;
        je  ldyn_fc_none;
        xor rcx, rcx;
      ldyn_fc_scan:
        cmp rcx, 4;
        jae ldyn_fc_none;
        lea r10, [rip + _ldyn_sessions];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // cid
        cmp rax, 0;
        je  ldyn_fc_next;
        cmp rax, rdi;
        je  ldyn_fc_hit;
      ldyn_fc_next:
        add rcx, 1;
        jmp ldyn_fc_scan;
      ldyn_fc_hit:
        mov rax, rcx;
        ret;
      ldyn_fc_none:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // CID allocator -- monotonic in [0x0040, 0x0080).  Refuses wrap.
  // ==========================================================================

  pub let ldyn_alloc_cid : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): return next CID and advance cursor. Refuse wrap past LDYN_CID_MAX (0x0080). Labels prefixed ldyn_ac_.",
      block: {
        lea r10, [rip + _ldyn_next_cid];
        mov rax, [r10];
        mov r11, 0x0080;
        cmp rax, r11;
        jae ldyn_ac_wrap;
        mov r8, rax;
        add r8, 1;
        mov [r10], r8;
        ret;
      ldyn_ac_wrap:
        mov rax, 0xFFFFF0E5;             // BAD_CID_ALLOC
        ret
      }
    }

  // ==========================================================================
  // ldyn_connect_req(psm, mtu, hci_chan_slot, init_credits) -> cid | FAIL
  //
  // Allocate a dynamic CID, claim a session row, stash (psm, mtu,
  // hci_chan_slot, init_credits) and advance to REQUESTED.  Returns the
  // allocated cid on success; failure codes fall in the LDYN_ band.
  // ==========================================================================

  pub let ldyn_connect_req : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (psm: u64) (mtu: u64) (hci_chan_slot: u64) (init_credits: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): allocate cid, claim row, advance to REQUESTED. Refuse if !init, psm invalid, mtu invalid, hci_chan_slot>=256, no rows, or CID wrap. Labels prefixed ldyn_cq_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // psm
        mov r13, rsi;                    // mtu
        mov r14, rdx;                    // hci_chan_slot
        mov r15, rcx;                    // init_credits

        lea r10, [rip + _ldyn_init];
        mov rax, [r10];
        cmp rax, 0;
        je  ldyn_cq_notinit;

        mov rdi, r12;
        call ldyn_psm_valid;
        cmp rax, 0;
        je  ldyn_cq_bad_psm;

        mov rdi, r13;
        call ldyn_mtu_valid;
        cmp rax, 0;
        je  ldyn_cq_bad_mtu;

        mov r10, 256;
        cmp r14, r10;
        jae ldyn_cq_bad_hci;

        mov r10, 0xFFFF;
        cmp r15, r10;
        ja  ldyn_cq_credit_over;

        // Find a free session row (cid == 0).
        xor rbx, rbx;
      ldyn_cq_scan:
        cmp rbx, 4;
        jae ldyn_cq_full;
        lea r10, [rip + _ldyn_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // cid
        cmp rax, 0;
        je  ldyn_cq_claim;
        add rbx, 1;
        jmp ldyn_cq_scan;

      ldyn_cq_claim:
        // Allocate a CID (bump cursor).
        call ldyn_alloc_cid;
        mov r11, 0xFFFFF0E5;
        cmp rax, r11;
        je  ldyn_cq_no_cid;
        mov rbp, rax;                    // allocated cid

        // Refill row pointer (call ldyn_alloc_cid clobbered r10/r11).
        lea r10, [rip + _ldyn_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov [r10 + 0],  rbp;             // cid
        mov [r10 + 8],  r12;             // psm
        mov [r10 + 16], r13;             // mtu
        mov [r10 + 24], r15;             // credits
        mov [r10 + 32], r14;             // hci_chan_slot
        mov rax, 1;
        mov [r10 + 40], rax;             // state = REQUESTED
        xor rax, rax;
        mov [r10 + 48], rax;             // tx_count
        mov [r10 + 56], rax;             // rx_count

        mov rdi, 0;
        call ldyn_note;

        mov rax, rbp;
        jmp ldyn_cq_out;

      ldyn_cq_notinit:
        mov rax, 0xFFFFF0E6;             // NOT_INITIALIZED
        jmp ldyn_cq_out;
      ldyn_cq_bad_psm:
        mov rdi, 3;
        call ldyn_note;
        mov rax, 0xFFFFF0EE;             // BAD_PSM
        jmp ldyn_cq_out;
      ldyn_cq_bad_mtu:
        mov rdi, 3;
        call ldyn_note;
        mov rax, 0xFFFFF0ED;             // BAD_MTU
        jmp ldyn_cq_out;
      ldyn_cq_bad_hci:
        mov rdi, 3;
        call ldyn_note;
        mov rax, 0xFFFFF0EC;             // BAD_HCI
        jmp ldyn_cq_out;
      ldyn_cq_credit_over:
        mov rax, 0xFFFFF0E3;             // CREDIT_OVERFLOW
        jmp ldyn_cq_out;
      ldyn_cq_full:
        mov rdi, 3;
        call ldyn_note;
        mov rax, 0xFFFFF0EF;             // ENOSPC
        jmp ldyn_cq_out;
      ldyn_cq_no_cid:
        mov rdi, 3;
        call ldyn_note;
        mov rax, 0xFFFFF0E5;             // BAD_CID_ALLOC

      ldyn_cq_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ldyn_connect_rsp(cid, result) -> OK | FAIL
  //
  // Apply a CONNECT_RSP.  On SUCCESS advance REQUESTED -> OPEN;
  // otherwise refuse the row into CLOSED.
  // ==========================================================================

  pub let ldyn_connect_rsp : (u64, u64) -> u64 !{mem} @{} =
    fn (cid: u64) (result: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): apply CONNECT_RSP. SUCCESS -> OPEN. Refusal codes -> CLOSED plus CONNECT_REFUSED return. Refuse if cid unknown (UNKNOWN_CID), state not REQUESTED (BAD_STATE), or result code out of range (BAD_RSP_CODE). Labels prefixed ldyn_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        // Result code must be 0 or one of the enumerated refusal codes.
        cmp r13, 0;
        je  ldyn_cr_code_ok;
        cmp r13, 2;
        je  ldyn_cr_code_ok;
        cmp r13, 4;
        je  ldyn_cr_code_ok;
        jmp ldyn_cr_bad_code;

      ldyn_cr_code_ok:
        mov rdi, r12;
        call ldyn_find_by_cid;
        cmp rax, 0xFF;
        je  ldyn_cr_unknown;

        lea r10, [rip + _ldyn_sessions];
        mov r11, rax;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 40];             // state
        cmp rax, 1;                      // must be REQUESTED
        jne ldyn_cr_bad_state;

        cmp r13, 0;
        je  ldyn_cr_success;

        // Refusal: -> CLOSED, return CONNECT_REFUSED.
        mov rax, 3;
        mov [r10 + 40], rax;

        mov rdi, 1;
        call ldyn_note;

        mov rax, 0xFFFFF0E9;             // CONNECT_REFUSED
        jmp ldyn_cr_out;

      ldyn_cr_success:
        mov rax, 2;
        mov [r10 + 40], rax;             // -> OPEN

        mov rdi, 1;
        call ldyn_note;

        xor rax, rax;
        jmp ldyn_cr_out;

      ldyn_cr_unknown:
        mov rax, 0xFFFFF0EA;
        jmp ldyn_cr_out;
      ldyn_cr_bad_state:
        mov rax, 0xFFFFF0E8;
        jmp ldyn_cr_out;
      ldyn_cr_bad_code:
        mov rax, 0xFFFFF0E2;             // BAD_RSP_CODE

      ldyn_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ldyn_credit_ind(cid, delta) -> OK | FAIL
  //
  // Apply a FLOW_CONTROL_CREDIT_IND.  Bumps credits by delta; refuses
  // overflow past u16.
  // ==========================================================================

  pub let ldyn_credit_ind : (u64, u64) -> u64 !{mem} @{} =
    fn (cid: u64) (delta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): credits += delta on cid's row. Refuse UNKNOWN_CID, delta > 0xFFFF, state != OPEN (BAD_STATE), or overflow (CREDIT_OVERFLOW). Labels prefixed ldyn_ci_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov r10, 0xFFFF;
        cmp r13, r10;
        ja  ldyn_ci_over;

        mov rdi, r12;
        call ldyn_find_by_cid;
        cmp rax, 0xFF;
        je  ldyn_ci_unknown;

        lea r10, [rip + _ldyn_sessions];
        mov r11, rax;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 40];             // state
        cmp rax, 2;                      // must be OPEN
        jne ldyn_ci_bad_state;

        mov rax, [r10 + 24];             // credits
        add rax, r13;
        mov r11, 0xFFFF;
        cmp rax, r11;
        ja  ldyn_ci_over;
        mov [r10 + 24], rax;

        mov rdi, 2;
        call ldyn_note;

        xor rax, rax;
        jmp ldyn_ci_out;

      ldyn_ci_unknown:
        mov rax, 0xFFFFF0EA;
        jmp ldyn_ci_out;
      ldyn_ci_bad_state:
        mov rax, 0xFFFFF0E8;
        jmp ldyn_ci_out;
      ldyn_ci_over:
        mov rax, 0xFFFFF0E3;

      ldyn_ci_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ldyn_send(cid) -> credits_left | FAIL
  //
  // Consume one credit for a K-frame.  Refuses NO_CREDITS when the
  // row's credit column is already zero.
  // ==========================================================================

  pub let ldyn_send : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): consume one credit, return credits_left. Refuse if cid unknown (UNKNOWN_CID), state != OPEN (BAD_STATE), or credits==0 (NO_CREDITS). Labels prefixed ldyn_sn_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call ldyn_find_by_cid;
        cmp rax, 0xFF;
        je  ldyn_sn_unknown;

        lea r10, [rip + _ldyn_sessions];
        mov r11, rax;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 40];             // state
        cmp rax, 2;                      // must be OPEN
        jne ldyn_sn_bad_state;

        mov rax, [r10 + 24];             // credits
        cmp rax, 0;
        je  ldyn_sn_no_creds;
        sub rax, 1;
        mov [r10 + 24], rax;

        // tx_count += 1
        mov r8, [r10 + 48];
        add r8, 1;
        mov [r10 + 48], r8;

        jmp ldyn_sn_out;                 // rax == credits_left

      ldyn_sn_unknown:
        mov rax, 0xFFFFF0EA;
        jmp ldyn_sn_out;
      ldyn_sn_bad_state:
        mov rax, 0xFFFFF0E8;
        jmp ldyn_sn_out;
      ldyn_sn_no_creds:
        mov rax, 0xFFFFF0EB;

      ldyn_sn_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ldyn_state_of(cid) -> state ordinal | UNKNOWN_CID
  // ==========================================================================

  pub let ldyn_state_of : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): cid -> state ordinal or UNKNOWN_CID. Labels prefixed ldyn_so_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call ldyn_find_by_cid;
        cmp rax, 0xFF;
        je  ldyn_so_unknown;

        lea r10, [rip + _ldyn_sessions];
        mov r11, rax;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 40];             // state
        jmp ldyn_so_out;

      ldyn_so_unknown:
        mov rax, 0xFFFFF0EA;

      ldyn_so_out:
        pop r12;
        ret
      }
    }

  pub let ldyn_credits_of : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-002 (#1328): cid -> credit balance or UNKNOWN_CID. Labels prefixed ldyn_co_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call ldyn_find_by_cid;
        cmp rax, 0xFF;
        je  ldyn_co_unknown;

        lea r10, [rip + _ldyn_sessions];
        mov r11, rax;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];             // credits
        jmp ldyn_co_out;

      ldyn_co_unknown:
        mov rax, 0xFFFFF0EA;

      ldyn_co_out:
        pop r12;
        ret
      }
    }
}
