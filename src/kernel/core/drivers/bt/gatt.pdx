// src/kernel/core/drivers/bt/gatt.pdx — R39.M3-002 (#1332)
//
// Bluetooth GATT (Generic Attribute Profile) — server-side attribute
// database + client-side service/characteristic discovery walker + ATT
// PDU pack/unpack primitives (Read/Write/Notify/Indicate).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CANONICAL GATT ATTRIBUTE BOOKKEEPING SITE for the Bluetooth
// subsystem.  Every attribute a local server exposes (handle → 16-bit
// UUID → permissions → value pointer) is recorded here.  Every
// discovery walk a local client performs against a peer's database is
// driven from here.  A second attribute table would let one path
// resolve a handle to one value and the other to a different value,
// and the GATT wire would speak in disagreement with the local view.
//
// It is ALSO the ONE SITE that packs / unpacks the four ATT PDUs this
// milestone supports (Read Request 0x0A, Read Response 0x0B, Write
// Request 0x12, Notification 0x1B, Indication 0x1D per BT §3.4).  A
// second packer would let one path stamp big-endian and the other
// little-endian, and BT §3.3.2 is UNAMBIGUOUS -- ATT is little-endian
// on the wire.
//
// IT DOES NOT SEND / RECEIVE OVER L2CAP.  L2CAP CID 0x0004 (ATT fixed
// channel) is the R39.M2 layer's job; this module produces / consumes
// the PDU BYTES and hands them to bt_gatt_channel.pdx, which the R39.M2
// L2CAP transport carries.
//
// IT DOES NOT MANAGE THE CONNECTION.  A KIND_BT_GATT_CONNECTION row
// (kind_bt_gatt_connection.pdx) names the connection; this module
// accepts a conn_row_id + attribute handle and does the ATT work.
//
// IT DOES NOT DECIDE PERMISSIONS AT DISPATCH TIME.  Permission bits
// live on the attribute row and every op that touches an attribute
// checks them BEFORE reading / writing the value; the check is local
// to the table and does not consult the connection's security_level
// (that gate is enforced by the caller before it invokes the read /
// write here, so this module can be exercised in isolation without a
// live connection).
//
// =============================================================================
// §1  ATTRIBUTE DATABASE (BT §3.2.2)
// =============================================================================
//
// Per BT §3.2.2 an attribute is a triple (handle, type, value) with a
// permission bitmask.  handle is a 16-bit non-zero value (0 is
// reserved); type is a 16-bit UUID (the 128-bit UUID case is not
// supported at R39.M3 -- it is a legal-but-rare extension that would
// double the row width, and no in-tree consumer requests it).
//
// The database holds GATT_ATTR_MAX = 16 attributes -- sized to fit the
// GAP (Generic Access Profile) + GATT service (0x1800 / 0x1801) plus a
// handful of characteristics, which is the minimum shape a bring-up
// needs.  A second-generation database would grow this to per-service
// tables; the fixed cap is deliberate at R39.M3.
//
// Per-attribute row (16 bytes):
//
//   [+0]  handle[15:0] | type_uuid[31:16] | perm[47:32] | in_use[55:48]
//   [+8]  value (u64; caller-supplied, up to 64 bits payload)
//
// Permission bits (BT §5.2.2):
//
//   GATT_PERM_READ            (1 << 0)
//   GATT_PERM_WRITE           (1 << 1)
//   GATT_PERM_NOTIFY          (1 << 2)
//   GATT_PERM_INDICATE        (1 << 3)
//   GATT_PERM_AUTH_REQ_READ   (1 << 4)
//   GATT_PERM_AUTH_REQ_WRITE  (1 << 5)
//
// =============================================================================
// §2  ATT PDU OPCODES (BT §3.4)
// =============================================================================
//
//   GATT_PDU_READ_REQ   0x0A   Read Request   (Handle)
//   GATT_PDU_READ_RSP   0x0B   Read Response  (Value)
//   GATT_PDU_WRITE_REQ  0x12   Write Request  (Handle, Value)
//   GATT_PDU_NOTIFY     0x1B   Notification   (Handle, Value)
//   GATT_PDU_INDICATE   0x1D   Indication     (Handle, Value)
//
// Little-endian on the wire.  A pack failure returns GATT_DECODE_BAD;
// an unpack against a payload whose opcode does not match the caller
// returns GATT_BAD_OPCODE.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _gatt_attrs, _gatt_disc, and _gatt_stats are written only by helpers
// in this module.  tools/build.sh confines relocations against each to
// core/drivers/bt/gatt.o.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF310..0xFFFFF31F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: kind_bt_gatt_connection
// 0xFFFFF320..0xFFFFF32F; adjacent free band below: bt_gatt_channel
// 0xFFFFF300..0xFFFFF30F).

module Gatt = structure {

  // §2: ATT PDU opcodes.
  pub let GATT_PDU_READ_REQ   : u64 = 0x0A
  pub let GATT_PDU_READ_RSP   : u64 = 0x0B
  pub let GATT_PDU_WRITE_REQ  : u64 = 0x12
  pub let GATT_PDU_NOTIFY     : u64 = 0x1B
  pub let GATT_PDU_INDICATE   : u64 = 0x1D

  // §1: permission bits.
  pub let GATT_PERM_READ            : u64 = 0x01
  pub let GATT_PERM_WRITE           : u64 = 0x02
  pub let GATT_PERM_NOTIFY          : u64 = 0x04
  pub let GATT_PERM_INDICATE        : u64 = 0x08
  pub let GATT_PERM_AUTH_REQ_READ   : u64 = 0x10
  pub let GATT_PERM_AUTH_REQ_WRITE  : u64 = 0x20
  pub let GATT_PERM_ALL             : u64 = 0x3F

  // §1: table size.
  pub let GATT_ATTR_MAX : u64 = 16
  pub let GATT_ATTR_NONE : u64 = 0xFF

  // Discovery walker record (per connection).  Since we support ONE
  // discovery at a time (the walker is a singleton in this milestone),
  // the record is a single row.
  pub let GATT_DISC_MAX_RESULTS : u64 = 16

  // Failure taxonomy -- 0xFFFFF310..0xFFFFF31F.
  pub let GATT_OK              : u64 = 0
  pub let GATT_BAD_ARG         : u64 = 0xFFFFF31F
  pub let GATT_BAD_HANDLE      : u64 = 0xFFFFF31E    // handle 0 or > max
  pub let GATT_BAD_UUID        : u64 = 0xFFFFF31D    // uuid out of 16-bit range
  pub let GATT_BAD_PERM        : u64 = 0xFFFFF31C    // permission mask outside PERM_ALL
  pub let GATT_BAD_OPCODE      : u64 = 0xFFFFF31B    // ATT opcode mismatch on unpack
  pub let GATT_ATTR_ENOSPC     : u64 = 0xFFFFF31A    // no free attribute row
  pub let GATT_ATTR_NOT_FOUND  : u64 = 0xFFFFF319    // handle absent
  pub let GATT_ATTR_IN_USE     : u64 = 0xFFFFF318    // duplicate handle
  pub let GATT_PERM_DENIED     : u64 = 0xFFFFF317    // requested op refused by perm
  pub let GATT_DISC_BUSY       : u64 = 0xFFFFF316    // a discovery walk is live
  pub let GATT_DISC_IDLE       : u64 = 0xFFFFF315    // step / end without begin

  pub let GATT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // §1: attribute table -- 16 rows * 16 B = 256 B as [u64; 32].
  pub let mut _gatt_attrs : [u64; 32] = uninit @align(64)

  // Discovery walker record -- 32 bytes.
  //   [+0]  active_flag[7:0] | conn_row_id[15:8]
  //         | start_handle[31:16] | end_handle[47:32]
  //         | uuid_filter[63:48]
  //   [+8]  cursor (u16 handle currently under walk)
  //   [+16] result_count (u64)
  //   [+24] reserved
  pub let mut _gatt_disc : [u64; 4] = uninit @align(64)

  // Counters.
  pub let mut _gatt_stats : [u64; 8] = uninit @align(64)

  pub let GATT_ST_INSERTS   : u64 = 0
  pub let GATT_ST_REMOVES   : u64 = 1
  pub let GATT_ST_READS     : u64 = 2
  pub let GATT_ST_WRITES    : u64 = 3
  pub let GATT_ST_NOTIFIES  : u64 = 4
  pub let GATT_ST_DISC_BEGS : u64 = 5
  pub let GATT_ST_DISC_HITS : u64 = 6
  pub let GATT_ST_REFUSED   : u64 = 7

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let gatt_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): clear attribute table, discovery walker, and counters. Boot and teardown only. Labels prefixed gatt_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _gatt_attrs];
        xor rcx, rcx;
      gatt_rs_attrs:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  gatt_rs_attrs;

        lea r10, [rip + _gatt_disc];
        xor rcx, rcx;
      gatt_rs_disc:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  gatt_rs_disc;

        lea r10, [rip + _gatt_stats];
        xor rcx, rcx;
      gatt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gatt_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let gatt_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): counter bump. Labels prefixed gatt_nt_.",
      block: {
        cmp rdi, 8;
        jae gatt_nt_out;
        lea r10, [rip + _gatt_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      gatt_nt_out:
        ret
      }
    } @no_frame

  pub let gatt_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): counter read. Labels prefixed gatt_stt_.",
      block: {
        cmp rdi, 8;
        jae gatt_stt_zero;
        lea r10, [rip + _gatt_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      gatt_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let gatt_handle_valid : (u64) -> u64 !{} @{} =
    fn (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): 1 iff h non-zero and fits 16 bits. Labels prefixed gatt_hv_.",
      block: {
        cmp rdi, 0;
        je  gatt_hv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  gatt_hv_no;
        mov rax, 1;
        ret;
      gatt_hv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gatt_uuid_valid : (u64) -> u64 !{} @{} =
    fn (u: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): 1 iff u fits 16 bits (128-bit UUIDs are not supported at R39.M3). Labels prefixed gatt_uv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  gatt_uv_no;
        mov rax, 1;
        ret;
      gatt_uv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gatt_perm_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): subset test against GATT_PERM_ALL (0x3F). Labels prefixed gatt_pv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x3F;
        and rax, r10;
        cmp rax, rdi;
        jne gatt_pv_no;
        mov rax, 1;
        ret;
      gatt_pv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.  A row is 16 bytes; row_id r lives at index r*2 in
  // the [u64; 32] view of _gatt_attrs.
  // ==========================================================================

  pub let gatt_attr_in_use : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): 1 iff row_id<MAX and its in_use byte is set. Labels prefixed gatt_iu_.",
      block: {
        cmp rdi, 16;
        jae gatt_iu_no;
        lea r10, [rip + _gatt_attrs];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 48;
        and rax, 0xFF;
        cmp rax, 0;
        je  gatt_iu_no;
        mov rax, 1;
        ret;
      gatt_iu_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gatt_attr_handle : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): handle field. Labels prefixed gatt_ah_.",
      block: {
        push r12;
        mov r12, rdi;
        call gatt_attr_in_use;
        cmp rax, 0;
        je  gatt_ah_bad;
        lea r10, [rip + _gatt_attrs];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFFFF;
        jmp gatt_ah_out;
      gatt_ah_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gatt_ah_out:
        pop r12;
        ret
      }
    }

  pub let gatt_attr_uuid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): type UUID field. Labels prefixed gatt_au_.",
      block: {
        push r12;
        mov r12, rdi;
        call gatt_attr_in_use;
        cmp rax, 0;
        je  gatt_au_bad;
        lea r10, [rip + _gatt_attrs];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp gatt_au_out;
      gatt_au_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gatt_au_out:
        pop r12;
        ret
      }
    }

  pub let gatt_attr_perm : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): permission mask. Labels prefixed gatt_ap_.",
      block: {
        push r12;
        mov r12, rdi;
        call gatt_attr_in_use;
        cmp rax, 0;
        je  gatt_ap_bad;
        lea r10, [rip + _gatt_attrs];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp gatt_ap_out;
      gatt_ap_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gatt_ap_out:
        pop r12;
        ret
      }
    }

  pub let gatt_attr_value : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): value word.  A permission gate at the caller is required for GATT_PERM_READ. Labels prefixed gatt_av_.",
      block: {
        push r12;
        mov r12, rdi;
        call gatt_attr_in_use;
        cmp rax, 0;
        je  gatt_av_bad;
        lea r10, [rip + _gatt_attrs];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp gatt_av_out;
      gatt_av_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      gatt_av_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // gatt_find_by_handle(handle) — linear scan, ROW_NONE if absent.
  // ==========================================================================

  pub let gatt_find_by_handle : (u64) -> u64 !{mem} @{} =
    fn (handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): live row holding handle, or ROW_NONE. Refuses handle 0. Labels prefixed gatt_fh_.",
      block: {
        cmp rdi, 0;
        je  gatt_fh_none;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  gatt_fh_none;
        xor rcx, rcx;
      gatt_fh_scan:
        cmp rcx, 16;
        jae gatt_fh_none;
        lea r10, [rip + _gatt_attrs];
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 48;
        and r11, 0xFF;
        cmp r11, 0;
        je  gatt_fh_next;
        and rax, 0xFFFF;
        cmp rax, rdi;
        je  gatt_fh_hit;
      gatt_fh_next:
        add rcx, 1;
        jmp gatt_fh_scan;
      gatt_fh_hit:
        mov rax, rcx;
        ret;
      gatt_fh_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gatt_attr_insert(handle, uuid, perm, value) — ONE WRITER of the
  // attribute table.  Refuses BAD_HANDLE / BAD_UUID / BAD_PERM /
  // ATTR_IN_USE / ATTR_ENOSPC.  Returns row_id on success.
  // ==========================================================================

  pub let gatt_attr_insert : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (handle: u64) (uuid: u64) (perm: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): claim one attribute row. THE ONE WRITER of _gatt_attrs (positive edge). Labels prefixed gatt_ai_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // handle
        mov r13, rsi;                    // uuid
        mov r14, rdx;                    // perm
        mov r15, rcx;                    // value

        mov rdi, r12;
        call gatt_handle_valid;
        cmp rax, 0;
        je  gatt_ai_bad_handle;

        mov rdi, r13;
        call gatt_uuid_valid;
        cmp rax, 0;
        je  gatt_ai_bad_uuid;

        mov rdi, r14;
        call gatt_perm_valid;
        cmp rax, 0;
        je  gatt_ai_bad_perm;

        // Duplicate check.
        mov rdi, r12;
        call gatt_find_by_handle;
        cmp rax, 0xFF;
        jne gatt_ai_in_use;

        xor rbx, rbx;
      gatt_ai_scan:
        cmp rbx, 16;
        jae gatt_ai_enospc;

        lea r10, [rip + _gatt_attrs];
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 48;
        and rax, 0xFF;
        cmp rax, 0;
        je  gatt_ai_claim;

        add rbx, 1;
        jmp gatt_ai_scan;

      gatt_ai_claim:
        // Pack: handle[15:0] | uuid[31:16] | perm[47:32] | in_use[55:48]=1
        mov rax, r12;
        and rax, 0xFFFF;
        mov r11, r13;
        and r11, 0xFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, r14;
        and r11, 0xFFFF;
        shl r11, 32;
        or  rax, r11;
        mov r11, 1;
        shl r11, 48;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov [r10 + 8], r15;

        mov rdi, 0;
        call gatt_note;

        mov rax, rbx;
        jmp gatt_ai_out;

      gatt_ai_bad_handle:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF31E;
        jmp gatt_ai_out;
      gatt_ai_bad_uuid:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF31D;
        jmp gatt_ai_out;
      gatt_ai_bad_perm:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF31C;
        jmp gatt_ai_out;
      gatt_ai_in_use:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF318;
        jmp gatt_ai_out;
      gatt_ai_enospc:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF31A;

      gatt_ai_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // gatt_attr_remove(handle) — ONE WRITER (negative edge).  Refuses
  // ATTR_NOT_FOUND if the handle is not registered.
  // ==========================================================================

  pub let gatt_attr_remove : (u64) -> u64 !{mem} @{} =
    fn (handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): scrub one attribute row. THE ONE WRITER (negative edge). Labels prefixed gatt_ar_.",
      block: {
        push r12;

        mov r12, rdi;

        call gatt_find_by_handle;
        cmp rax, 0xFF;
        je  gatt_ar_not_found;

        lea r10, [rip + _gatt_attrs];
        mov r11, rax;
        shl r11, 4;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        mov rdi, 1;
        call gatt_note;

        xor rax, rax;
        jmp gatt_ar_out;

      gatt_ar_not_found:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF319;

      gatt_ar_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // gatt_read(handle) — permission-gated read.  Refuses PERM_DENIED if
  // GATT_PERM_READ is unset on the row; refuses ATTR_NOT_FOUND if the
  // handle is absent.  On success returns the value.
  // ==========================================================================

  pub let gatt_read : (u64) -> u64 !{mem} @{} =
    fn (handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): permission-gated read. Labels prefixed gatt_r_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;

        call gatt_find_by_handle;
        cmp rax, 0xFF;
        je  gatt_r_not_found;
        mov r13, rax;

        mov rdi, r13;
        call gatt_attr_perm;
        mov r11, 0x01;
        and rax, r11;
        cmp rax, 0;
        je  gatt_r_denied;

        mov rdi, r13;
        call gatt_attr_value;

        mov r11, rax;
        mov rdi, 2;
        call gatt_note;
        mov rax, r11;
        jmp gatt_r_out;

      gatt_r_not_found:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF319;
        jmp gatt_r_out;
      gatt_r_denied:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF317;

      gatt_r_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // gatt_write(handle, value) — permission-gated write.  Same shape.
  // ==========================================================================

  pub let gatt_write : (u64, u64) -> u64 !{mem} @{} =
    fn (handle: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): permission-gated write to the value word. Labels prefixed gatt_w_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r14, rsi;

        mov rdi, r12;
        call gatt_find_by_handle;
        cmp rax, 0xFF;
        je  gatt_w_not_found;
        mov r13, rax;

        mov rdi, r13;
        call gatt_attr_perm;
        mov r11, 0x02;
        and rax, r11;
        cmp rax, 0;
        je  gatt_w_denied;

        lea r10, [rip + _gatt_attrs];
        mov r11, r13;
        shl r11, 4;
        add r10, r11;
        mov [r10 + 8], r14;

        mov rdi, 3;
        call gatt_note;

        xor rax, rax;
        jmp gatt_w_out;

      gatt_w_not_found:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF319;
        jmp gatt_w_out;
      gatt_w_denied:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF317;

      gatt_w_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // ATT PDU pack/unpack primitives.  Little-endian on the wire (BT §3.3.2).
  //
  //   pack_read_req(handle) -> u64
  //     [7:0]   opcode = 0x0A
  //     [23:8]  handle
  //     [63:24] zero
  //
  //   pack_read_rsp(value) -> u64
  //     [7:0]   opcode = 0x0B
  //     [63:8]  value (up to 56 bits payload -- fits ATT MTU=23)
  //
  //   pack_write_req(handle, value_lo) -> u64
  //     [7:0]   opcode = 0x12
  //     [23:8]  handle
  //     [63:24] value_lo (40-bit payload)
  //
  //   pack_notify(handle, value_lo) -> u64      opcode 0x1B
  //   pack_indicate(handle, value_lo) -> u64    opcode 0x1D
  //
  // Unpackers refuse a payload whose opcode byte does not match with
  // GATT_BAD_OPCODE.
  // ==========================================================================

  pub let gatt_pack_read_req : (u64) -> u64 !{} @{} =
    fn (handle: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): pack Read Request (opcode 0x0A | handle[23:8]). Labels prefixed gatt_prr_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  gatt_prr_bad;
        cmp rdi, 0;
        je  gatt_prr_bad;
        mov rax, 0x0A;
        mov r10, rdi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      gatt_prr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let gatt_unpack_read_req : (u64) -> u64 !{} @{} =
    fn (pdu: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): unpack Read Request; refuse if opcode != 0x0A. Labels prefixed gatt_urr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x0A;
        jne gatt_urr_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFFF;
        ret;
      gatt_urr_bad:
        mov rax, 0xFFFFF31B;
        ret
      }
    } @no_frame

  pub let gatt_pack_read_rsp : (u64) -> u64 !{} @{} =
    fn (value: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): pack Read Response (opcode 0x0B | value[63:8]). Labels prefixed gatt_prs_.",
      block: {
        mov r10, 0x00FFFFFFFFFFFFFF;
        cmp rdi, r10;
        ja  gatt_prs_bad;
        mov rax, 0x0B;
        mov r10, rdi;
        and r10, 0x00FFFFFFFFFFFFFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      gatt_prs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let gatt_unpack_read_rsp : (u64) -> u64 !{} @{} =
    fn (pdu: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): unpack Read Response; refuse if opcode != 0x0B. Labels prefixed gatt_urs_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x0B;
        jne gatt_urs_bad;
        mov rax, rdi;
        shr rax, 8;
        ret;
      gatt_urs_bad:
        mov rax, 0xFFFFF31B;
        ret
      }
    } @no_frame

  pub let gatt_pack_write_req : (u64, u64) -> u64 !{} @{} =
    fn (handle: u64) (value_lo: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): pack Write Request (opcode 0x12 | handle[23:8] | value_lo[63:24]). Labels prefixed gatt_pwr_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  gatt_pwr_bad;
        cmp rdi, 0;
        je  gatt_pwr_bad;
        mov r10, 0xFFFFFFFFFF;
        cmp rsi, r10;
        ja  gatt_pwr_bad;
        mov rax, 0x12;
        mov r10, rdi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFFFFFFFFFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      gatt_pwr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let gatt_unpack_write_handle : (u64) -> u64 !{} @{} =
    fn (pdu: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): unpack Write Request handle; refuse if opcode != 0x12. Labels prefixed gatt_uwh_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x12;
        jne gatt_uwh_bad;
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFFFF;
        ret;
      gatt_uwh_bad:
        mov rax, 0xFFFFF31B;
        ret
      }
    } @no_frame

  pub let gatt_unpack_write_value : (u64) -> u64 !{} @{} =
    fn (pdu: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): unpack Write Request value; refuse if opcode != 0x12. Labels prefixed gatt_uwv_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        cmp rax, 0x12;
        jne gatt_uwv_bad;
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFFFFFFFFFF;
        ret;
      gatt_uwv_bad:
        mov rax, 0xFFFFF31B;
        ret
      }
    } @no_frame

  pub let gatt_pack_notify : (u64, u64) -> u64 !{} @{} =
    fn (handle: u64) (value_lo: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): pack Notification (opcode 0x1B | handle[23:8] | value_lo[63:24]). Same shape as Write. Labels prefixed gatt_pn_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  gatt_pn_bad;
        cmp rdi, 0;
        je  gatt_pn_bad;
        mov r10, 0xFFFFFFFFFF;
        cmp rsi, r10;
        ja  gatt_pn_bad;
        mov rax, 0x1B;
        mov r10, rdi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFFFFFFFFFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      gatt_pn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let gatt_pack_indicate : (u64, u64) -> u64 !{} @{} =
    fn (handle: u64) (value_lo: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M3-002 (#1332): pack Indication (opcode 0x1D | handle[23:8] | value_lo[63:24]). Same shape as Notify but ACK-driven at the peer. Labels prefixed gatt_pi_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  gatt_pi_bad;
        cmp rdi, 0;
        je  gatt_pi_bad;
        mov r10, 0xFFFFFFFFFF;
        cmp rsi, r10;
        ja  gatt_pi_bad;
        mov rax, 0x1D;
        mov r10, rdi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rsi;
        and r10, 0xFFFFFFFFFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      gatt_pi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // gatt_notify(handle) — server-side path.  Reads the value under the
  // GATT_PERM_NOTIFY gate and packs a Notification PDU ready for the
  // channel to carry.
  // ==========================================================================

  pub let gatt_notify : (u64) -> u64 !{mem} @{} =
    fn (handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): gate NOTIFY on the row's permission bit and pack the notify PDU. Labels prefixed gatt_no_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;

        call gatt_find_by_handle;
        cmp rax, 0xFF;
        je  gatt_no_not_found;
        mov r13, rax;

        mov rdi, r13;
        call gatt_attr_perm;
        mov r11, 0x04;
        and rax, r11;
        cmp rax, 0;
        je  gatt_no_denied;

        mov rdi, r13;
        call gatt_attr_value;
        mov r11, 0xFFFFFFFFFF;
        and rax, r11;                    // clamp to 40-bit payload width
        mov r13, rax;

        mov rdi, r12;
        mov rsi, r13;
        call gatt_pack_notify;

        mov r11, rax;
        mov rdi, 4;
        call gatt_note;
        mov rax, r11;
        jmp gatt_no_out;

      gatt_no_not_found:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF319;
        jmp gatt_no_out;
      gatt_no_denied:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF317;

      gatt_no_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Discovery walker — client-side scan across a handle range.
  //
  //   gatt_disc_begin(conn_row_id, start_handle, end_handle, uuid_filter)
  //     open a walk.  Refuses DISC_BUSY if one is live.
  //   gatt_disc_step() -> next matching handle, or ATTR_NOT_FOUND when
  //     the cursor passes end_handle.
  //   gatt_disc_end() -> total result count; closes the walk.
  //
  // The walk enumerates LOCAL attributes with a matching UUID.  A real
  // client discovery walks a peer's database through Find Information /
  // Find By Type / Read By Type ATT PDUs; that is grafted onto this
  // scaffold when the R39.M4 milestone lands a real peer connection.
  // ==========================================================================

  pub let gatt_disc_active : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): 1 iff a discovery walk is live. Labels prefixed gatt_da_.",
      block: {
        lea r10, [rip + _gatt_disc];
        mov rax, [r10 + 0];
        and rax, 0xFF;
        cmp rax, 0;
        je  gatt_da_no;
        mov rax, 1;
        ret;
      gatt_da_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gatt_disc_begin : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (conn_row_id: u64) (start_h: u64) (end_h: u64) (uuid_filter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): open a discovery walk. THE ONE WRITER of _gatt_disc (positive edge). Labels prefixed gatt_db_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // conn_row_id
        mov r13, rsi;                    // start_h
        mov r14, rdx;                    // end_h
        mov r15, rcx;                    // uuid_filter

        call gatt_disc_active;
        cmp rax, 0;
        jne gatt_db_busy;

        mov rdi, r13;
        call gatt_handle_valid;
        cmp rax, 0;
        je  gatt_db_bad_handle;

        mov rdi, r14;
        call gatt_handle_valid;
        cmp rax, 0;
        je  gatt_db_bad_handle;

        cmp r13, r14;
        ja  gatt_db_bad_handle;

        mov rdi, r15;
        call gatt_uuid_valid;
        cmp rax, 0;
        je  gatt_db_bad_uuid;

        cmp r12, 0xFF;
        ja  gatt_db_bad_arg;

        lea r10, [rip + _gatt_disc];
        // active=1 | conn_row_id[15:8] | start[31:16] | end[47:32] | uuid[63:48]
        mov rax, 1;
        mov r11, r12;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        mov r11, r13;
        and r11, 0xFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r11, r14;
        and r11, 0xFFFF;
        shl r11, 32;
        or  rax, r11;
        mov r11, r15;
        and r11, 0xFFFF;
        shl r11, 48;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov rax, r13;                    // cursor = start_h
        mov [r10 + 8], rax;
        xor rax, rax;
        mov [r10 + 16], rax;             // result_count = 0
        mov [r10 + 24], rax;

        mov rdi, 5;
        call gatt_note;

        xor rax, rax;
        jmp gatt_db_out;

      gatt_db_busy:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF316;
        jmp gatt_db_out;
      gatt_db_bad_handle:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF31E;
        jmp gatt_db_out;
      gatt_db_bad_uuid:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF31D;
        jmp gatt_db_out;
      gatt_db_bad_arg:
        mov rdi, 7;
        call gatt_note;
        mov rax, 0xFFFFF31F;

      gatt_db_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gatt_disc_step : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): advance the discovery cursor; return the next matching handle or ATTR_NOT_FOUND. Labels prefixed gatt_ds_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        call gatt_disc_active;
        cmp rax, 0;
        je  gatt_ds_idle;

        lea rbx, [rip + _gatt_disc];
        mov r13, [rbx + 0];
        // end_h = r13[47:32]
        mov r12, r13;
        shr r12, 32;
        and r12, 0xFFFF;
        // uuid_filter = r13[63:48]
        mov r14, r13;
        shr r14, 48;
        and r14, 0xFFFF;

      gatt_ds_advance:
        mov rax, [rbx + 8];
        cmp rax, r12;
        ja  gatt_ds_done;

        // Look up handle=rax in table.
        mov rdi, rax;
        call gatt_find_by_handle;
        cmp rax, 0xFF;
        je  gatt_ds_next;

        mov rdi, rax;
        call gatt_attr_uuid;
        cmp rax, r14;
        jne gatt_ds_next;

        // Hit.  Return the handle and bump the cursor.
        mov rax, [rbx + 8];
        mov r13, rax;
        mov rax, [rbx + 8];
        add rax, 1;
        mov [rbx + 8], rax;
        // result_count += 1
        mov rax, [rbx + 16];
        add rax, 1;
        mov [rbx + 16], rax;

        mov rdi, 6;
        call gatt_note;

        mov rax, r13;
        jmp gatt_ds_out;

      gatt_ds_next:
        mov rax, [rbx + 8];
        add rax, 1;
        mov [rbx + 8], rax;
        jmp gatt_ds_advance;

      gatt_ds_done:
        mov rax, 0xFFFFF319;
        jmp gatt_ds_out;
      gatt_ds_idle:
        mov rax, 0xFFFFF315;

      gatt_ds_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gatt_disc_end : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): close a discovery walk. THE ONE WRITER (negative edge). Returns result_count. Labels prefixed gatt_de_.",
      block: {
        push r12;

        call gatt_disc_active;
        cmp rax, 0;
        je  gatt_de_idle;

        lea r10, [rip + _gatt_disc];
        mov r12, [r10 + 16];

        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rax, r12;
        jmp gatt_de_out;

      gatt_de_idle:
        mov rax, 0xFFFFF315;

      gatt_de_out:
        pop r12;
        ret
      }
    }

  pub let gatt_disc_results : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M3-002 (#1332): current result_count. Labels prefixed gatt_dr_.",
      block: {
        lea r10, [rip + _gatt_disc];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame
}
