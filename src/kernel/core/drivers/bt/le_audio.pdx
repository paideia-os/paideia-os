// src/kernel/core/drivers/bt/le_audio.pdx — R39.M6-003 (#1345)
//
// LE Audio scaffolding — BAP (Basic Audio Profile), CAP (Common Audio
// Profile) and Isochronous Channel binding via KIND_ISOCH_STREAM
// (R34.M5-001).  This is the FRAMEWORK the future BAP/CAP roles will
// mount on; the profile semantics themselves (unicast group setup,
// broadcast source announcement, capability advertisement in the ASCS
// service) are DEFERRED until the R32 crypto server can back the SEALED
// LTK path end-to-end.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CANONICAL ROLE TABLE that pairs a BAP/CAP role (unicast
// server, unicast client, broadcast source, broadcast sink) with an
// LC3-codec configuration and the KIND_ISOCH_STREAM slot the isoch
// bytes travel through.  A second table would let one path advertise a
// broadcast source with LC3/48 kHz and the other path see the same
// role as an off-air unicast sink, and the R34 isoch supervisor would
// happily push different frame shapes down the two views.
//
// It is NOT the LC3 codec.  LC3 encode / decode lives in the userland
// codec supervisor (R35); this module records the sample-rate and
// frame-duration the ROLE agreed to and enforces the (rate, duration)
// contract on ingest.
//
// It is NOT the BAP unicast-group / broadcast-source finite-state
// machine.  Those FSMs consume the BAP PACS/ASCS/BASS characteristics
// on top of GATT (R39.M3); this module accepts already-negotiated role
// declarations as (role, codec, isoch_slot, rate, duration, direction)
// tuples.
//
// It is NOT the isoch transport.  ISO Data Path setup, CIS / BIS
// creation, and BN/FT parameter negotiation happen at the R39.M2 HCI
// transport level; this module accepts already-allocated KIND_ISOCH_
// STREAM slot numbers.
//
// It is a SCAFFOLD.  Real BAP + CAP land when the crypto server can
// back the SEALED LTK path end-to-end (the R32 milestone that closes
// KIND_BT_PAIRING's sealed row).  The framework's purpose is that
// when they land, this table is where they mount.
//
// =============================================================================
// §1  ROLE TABLE
// =============================================================================
//
// LEAU_ROW_MAX = 4 — one unicast-server pair (mic + earpiece toward one
// LE Audio peer) needs two rows if the local device drives both
// directions; two more slots let a broadcast source coexist with a
// unicast pair.  Fixed cap is deliberate at R39.M6.
//
// Per-row (4 u64, 32 bytes; row_id r lives at word offset r*4):
//
//   [+0]   active(bit 0) | role(bits 8..15) | codec(bits 16..23) |
//          direction(bit 24)
//   [+8]   isoch_stream_slot         (cap slot of KIND_ISOCH_STREAM)
//   [+16]  sample_rate_hz            (8000/16000/24000/32000/44100/48000)
//   [+24]  frame_duration_us         (7500 or 10000)
//
// direction bit: 0 = SINK (peer -> local), 1 = SOURCE (local -> peer).
//
// =============================================================================
// §2  ROLES (BAP §3.4)
// =============================================================================
//
//   LEAU_ROLE_UNICAST_SERVER  = 1
//   LEAU_ROLE_UNICAST_CLIENT  = 2
//   LEAU_ROLE_BROADCAST_SOURCE = 3
//   LEAU_ROLE_BROADCAST_SINK  = 4
//
// Any other ordinal returns LEAU_BAD_ROLE.
//
// =============================================================================
// §3  CODEC (BAP §4.5)
// =============================================================================
//
//   LEAU_CODEC_LC3    = 0x06    (BT SIG assigned number; mandatory)
//   LEAU_CODEC_VENDOR = 0xFF    (out-of-scope for R39.M6)
//
// Any other ordinal returns LEAU_BAD_CODEC.
//
// =============================================================================
// §4  RATE + DURATION (LC3 §3)
// =============================================================================
//
// LC3 admits {8, 16, 24, 32, 44.1, 48} kHz and frame durations of
// {7500, 10000} microseconds.  Any other rate returns LEAU_BAD_RATE;
// any other duration returns LEAU_BAD_DURATION.
//
// =============================================================================
// §5  ONE WRITER OF THE STATE
// =============================================================================
//
// _leau_rows, _leau_stats and _leau_init are written only by helpers in
// this module.  tools/build.sh confines relocations against each to
// core/drivers/bt/le_audio.o so a second writer cannot silently forge
// a role row and drift the R34 isoch supervisor's frame contract.
//
// =============================================================================
// §6  FAILURE TAXONOMY 0xFFFFF270..0xFFFFF27F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: bt_hid 0xFFFFF280..0x28F;
// adjacent free band below: 0xFFFFF260..0x26F unused at R39.M6).

module LeAudio = structure {

  // §2 roles.
  pub let LEAU_ROLE_UNICAST_SERVER   : u64 = 1
  pub let LEAU_ROLE_UNICAST_CLIENT   : u64 = 2
  pub let LEAU_ROLE_BROADCAST_SOURCE : u64 = 3
  pub let LEAU_ROLE_BROADCAST_SINK   : u64 = 4
  pub let LEAU_ROLE_MIN              : u64 = 1
  pub let LEAU_ROLE_MAX              : u64 = 4

  // §3 codecs.
  pub let LEAU_CODEC_LC3    : u64 = 0x06
  pub let LEAU_CODEC_VENDOR : u64 = 0xFF

  // §4 rates.
  pub let LEAU_RATE_8K   : u64 = 8000
  pub let LEAU_RATE_16K  : u64 = 16000
  pub let LEAU_RATE_24K  : u64 = 24000
  pub let LEAU_RATE_32K  : u64 = 32000
  pub let LEAU_RATE_441K : u64 = 44100
  pub let LEAU_RATE_48K  : u64 = 48000

  // §4 durations.
  pub let LEAU_DUR_7500  : u64 = 7500
  pub let LEAU_DUR_10000 : u64 = 10000

  // Direction bits.
  pub let LEAU_DIR_SINK   : u64 = 0
  pub let LEAU_DIR_SOURCE : u64 = 1

  // §1 sizing.
  pub let LEAU_ROW_MAX   : u64 = 4
  pub let LEAU_ROW_WORDS : u64 = 4
  pub let LEAU_ROW_NONE  : u64 = 0xFF

  // Column offsets (byte offsets).
  pub let LEAU_COL_META     : u64 = 0
  pub let LEAU_COL_ISOCH    : u64 = 8
  pub let LEAU_COL_RATE     : u64 = 16
  pub let LEAU_COL_DURATION : u64 = 24

  // §6 failure taxonomy 0xFFFFF270..0xFFFFF27F.
  pub let LEAU_OK                : u64 = 0
  pub let LEAU_BAD_ARG           : u64 = 0xFFFFF27F
  pub let LEAU_BAD_ROW           : u64 = 0xFFFFF27E
  pub let LEAU_BAD_ROLE          : u64 = 0xFFFFF27D
  pub let LEAU_BAD_CODEC         : u64 = 0xFFFFF27C
  pub let LEAU_BAD_RATE          : u64 = 0xFFFFF27B
  pub let LEAU_BAD_DURATION      : u64 = 0xFFFFF27A
  pub let LEAU_BAD_DIRECTION     : u64 = 0xFFFFF279
  pub let LEAU_BAD_ISOCH         : u64 = 0xFFFFF278
  pub let LEAU_ENOSPC            : u64 = 0xFFFFF277
  pub let LEAU_NOT_INITIALIZED   : u64 = 0xFFFFF276
  pub let LEAU_DUP_ROW           : u64 = 0xFFFFF275
  pub let LEAU_ROW_IN_USE        : u64 = 0xFFFFF274
  pub let LEAU_BAD_FRAME         : u64 = 0xFFFFF273
  pub let LEAU_UNBOUND           : u64 = 0xFFFFF272
  pub let LEAU_REFUSED           : u64 = 0xFFFFF271

  // §5 state cells.  4 rows * 4 u64s = 16 u64s.
  pub let mut _leau_rows  : [u64; 16] = uninit @align(64)
  pub let mut _leau_stats : [u64;  8] = uninit @align(64)
  pub let mut _leau_init  : u64       = 0

  // Counter ordinals.
  pub let LEAU_ST_DECLARES : u64 = 0
  pub let LEAU_ST_RELEASES : u64 = 1
  pub let LEAU_ST_FRAMES   : u64 = 2
  pub let LEAU_ST_UNICAST  : u64 = 3
  pub let LEAU_ST_BCAST    : u64 = 4
  pub let LEAU_ST_BAD_RATE : u64 = 5
  pub let LEAU_ST_BAD_DUR  : u64 = 6
  pub let LEAU_ST_REFUSED  : u64 = 7

  // ==========================================================================
  // Reset + init.
  // ==========================================================================

  pub let leau_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): clear role table + counters + init flag. Labels prefixed leau_rs_.",
      block: {
        lea r10, [rip + _leau_rows];
        xor rax, rax;
        xor rcx, rcx;
      leau_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  leau_rs_rows;

        lea r10, [rip + _leau_stats];
        xor rcx, rcx;
      leau_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  leau_rs_stats;

        lea r10, [rip + _leau_init];
        xor rax, rax;
        mov [r10], rax;
        ret
      }
    } @no_frame

  pub let leau_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): mark module initialised.  Idempotent. Labels prefixed leau_in_.",
      block: {
        call leau_reset;
        lea r10, [rip + _leau_init];
        mov rax, 1;
        mov [r10], rax;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let leau_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): counter bump. Labels prefixed leau_nt_.",
      block: {
        cmp rdi, 8;
        jae leau_nt_out;
        lea r10, [rip + _leau_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      leau_nt_out:
        ret
      }
    } @no_frame

  pub let leau_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): counter read. Labels prefixed leau_st_.",
      block: {
        cmp rdi, 8;
        jae leau_st_zero;
        lea r10, [rip + _leau_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      leau_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let leau_role_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-003 (#1345): 1 iff r in {1..4}. Labels prefixed leau_rv_.",
      block: {
        cmp rdi, 1;
        jb  leau_rv_no;
        cmp rdi, 4;
        ja  leau_rv_no;
        mov rax, 1;
        ret;
      leau_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let leau_codec_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-003 (#1345): 1 iff c is LC3 (0x06) or VENDOR (0xFF). Labels prefixed leau_cv_.",
      block: {
        cmp rdi, 0x06;
        je  leau_cv_yes;
        cmp rdi, 0xFF;
        je  leau_cv_yes;
        xor rax, rax;
        ret;
      leau_cv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let leau_rate_valid : (u64) -> u64 !{} @{} =
    fn (hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-003 (#1345): 1 iff hz in {8000,16000,24000,32000,44100,48000}. Labels prefixed leau_rtv_.",
      block: {
        mov r10, 8000;
        cmp rdi, r10;
        je  leau_rtv_yes;
        mov r10, 16000;
        cmp rdi, r10;
        je  leau_rtv_yes;
        mov r10, 24000;
        cmp rdi, r10;
        je  leau_rtv_yes;
        mov r10, 32000;
        cmp rdi, r10;
        je  leau_rtv_yes;
        mov r10, 44100;
        cmp rdi, r10;
        je  leau_rtv_yes;
        mov r10, 48000;
        cmp rdi, r10;
        je  leau_rtv_yes;
        xor rax, rax;
        ret;
      leau_rtv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let leau_duration_valid : (u64) -> u64 !{} @{} =
    fn (us: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-003 (#1345): 1 iff us in {7500,10000}. Labels prefixed leau_dv_.",
      block: {
        mov r10, 7500;
        cmp rdi, r10;
        je  leau_dv_yes;
        mov r10, 10000;
        cmp rdi, r10;
        je  leau_dv_yes;
        xor rax, rax;
        ret;
      leau_dv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let leau_direction_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M6-003 (#1345): 1 iff d in {0,1}. Labels prefixed leau_dirv_.",
      block: {
        cmp rdi, 1;
        ja  leau_dirv_no;
        mov rax, 1;
        ret;
      leau_dirv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.  row_id r lives at word offset r*4 in _leau_rows.
  // ==========================================================================

  pub let leau_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): 1 iff row_id<MAX and META bit 0 set. Labels prefixed leau_iu_.",
      block: {
        cmp rdi, 4;
        jae leau_iu_no;
        lea r10, [rip + _leau_rows];
        mov r11, rdi;
        shl r11, 5;                      // row_id * 32 bytes
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  leau_iu_no;
        mov rax, 1;
        ret;
      leau_iu_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let leau_row_role : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): role of a live role row. Labels prefixed leau_rr_.",
      block: {
        push r12;
        mov r12, rdi;
        call leau_row_in_use;
        cmp rax, 0;
        je  leau_rr_bad;
        lea r10, [rip + _leau_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp leau_rr_out;
      leau_rr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      leau_rr_out:
        pop r12;
        ret
      }
    }

  pub let leau_row_codec : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): codec of a live role row. Labels prefixed leau_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call leau_row_in_use;
        cmp rax, 0;
        je  leau_rc_bad;
        lea r10, [rip + _leau_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 16;
        and rax, 0xFF;
        jmp leau_rc_out;
      leau_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      leau_rc_out:
        pop r12;
        ret
      }
    }

  pub let leau_row_isoch : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): isoch_stream_slot of a live role row. Labels prefixed leau_ri_.",
      block: {
        push r12;
        mov r12, rdi;
        call leau_row_in_use;
        cmp rax, 0;
        je  leau_ri_bad;
        lea r10, [rip + _leau_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp leau_ri_out;
      leau_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      leau_ri_out:
        pop r12;
        ret
      }
    }

  pub let leau_row_rate : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): sample_rate of a live role row. Labels prefixed leau_rrt_.",
      block: {
        push r12;
        mov r12, rdi;
        call leau_row_in_use;
        cmp rax, 0;
        je  leau_rrt_bad;
        lea r10, [rip + _leau_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp leau_rrt_out;
      leau_rrt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      leau_rrt_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // leau_find_isoch(isoch_slot) -> row_id | LEAU_ROW_NONE.  One isoch
  // slot may back at most one BAP/CAP role at a time.
  // ==========================================================================

  pub let leau_find_isoch : (u64) -> u64 !{mem} @{} =
    fn (isoch_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): linear scan for a live row whose isoch_slot matches. Labels prefixed leau_fi_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      leau_fi_scan:
        cmp rbx, 4;
        jae leau_fi_none;
        lea r10, [rip + _leau_rows];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  leau_fi_next;
        mov rax, [r10 + 8];
        cmp rax, r12;
        je  leau_fi_hit;
      leau_fi_next:
        add rbx, 1;
        jmp leau_fi_scan;
      leau_fi_hit:
        mov rax, rbx;
        jmp leau_fi_out;
      leau_fi_none:
        mov rax, 0xFF;
      leau_fi_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // leau_role_declare(role, codec, isoch_slot, rate, duration, direction)
  //   -- register one BAP/CAP role.  Refuses NOT_INITIALIZED / BAD_ROLE /
  //   BAD_CODEC / BAD_RATE / BAD_DURATION / BAD_DIRECTION / DUP_ROW /
  //   ENOSPC.  Returns row_id on success.  ONE WRITER of the positive
  //   edge of _leau_rows.
  // ==========================================================================

  pub let leau_role_declare : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (role: u64) (codec: u64) (isoch_slot: u64) (rate: u64) (duration: u64) (direction: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): claim one BAP/CAP role row.  THE ONE WRITER of the positive edge of _leau_rows.  Refuses NOT_INITIALIZED / BAD_ROLE / BAD_CODEC / BAD_RATE / BAD_DURATION / BAD_DIRECTION / DUP_ROW / ENOSPC. Labels prefixed leau_dc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // role
        mov r13, rsi;                    // codec
        mov r14, rdx;                    // isoch_slot
        mov r15, rcx;                    // rate
        // duration in r8, direction in r9.
        push r8;
        push r9;

        // Init check.
        lea r10, [rip + _leau_init];
        mov rax, [r10];
        cmp rax, 0;
        je  leau_dc_notinit;

        // Role check.
        mov rdi, r12;
        call leau_role_valid;
        cmp rax, 0;
        je  leau_dc_bad_role;

        // Codec check.
        mov rdi, r13;
        call leau_codec_valid;
        cmp rax, 0;
        je  leau_dc_bad_codec;

        // Rate check.
        mov rdi, r15;
        call leau_rate_valid;
        cmp rax, 0;
        je  leau_dc_bad_rate;

        // Duration check.
        mov rdi, [rsp + 8];
        call leau_duration_valid;
        cmp rax, 0;
        je  leau_dc_bad_dur;

        // Direction check.
        mov rdi, [rsp + 0];
        call leau_direction_valid;
        cmp rax, 0;
        je  leau_dc_bad_dir;

        // Duplicate isoch_slot check.
        mov rdi, r14;
        call leau_find_isoch;
        mov r11, 0xFF;
        cmp rax, r11;
        jne leau_dc_dup;

        // Free-row scan.
        xor rbx, rbx;
      leau_dc_scan:
        cmp rbx, 4;
        jae leau_dc_enospc;
        lea r10, [rip + _leau_rows];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0x1;
        cmp rax, 0;
        je  leau_dc_hit;
        add rbx, 1;
        jmp leau_dc_scan;

      leau_dc_hit:
        // META: active(bit 0) | role(bits 8..15) | codec(bits 16..23) |
        // direction(bit 24).
        mov rax, r12;
        shl rax, 8;
        or  rax, 0x1;
        mov r11, r13;
        shl r11, 16;
        or  rax, r11;
        mov r11, [rsp + 0];
        shl r11, 24;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov [r10 + 8],  r14;             // isoch_slot
        mov [r10 + 16], r15;             // rate
        mov rax, [rsp + 8];
        mov [r10 + 24], rax;             // duration

        mov rdi, 0;                      // DECLARES
        call leau_note;

        // Note role class (unicast vs broadcast).
        cmp r12, 2;
        ja  leau_dc_note_bcast;
        mov rdi, 3;                      // UNICAST
        call leau_note;
        jmp leau_dc_ret;
      leau_dc_note_bcast:
        mov rdi, 4;                      // BCAST
        call leau_note;

      leau_dc_ret:
        mov rax, rbx;
        jmp leau_dc_out;

      leau_dc_notinit:
        mov rax, 0xFFFFF276;
        jmp leau_dc_bump;
      leau_dc_bad_role:
        mov rax, 0xFFFFF27D;
        jmp leau_dc_bump;
      leau_dc_bad_codec:
        mov rax, 0xFFFFF27C;
        jmp leau_dc_bump;
      leau_dc_bad_rate:
        mov rax, 0xFFFFF27B;
        push rax;
        mov rdi, 5;                      // BAD_RATE
        call leau_note;
        pop rax;
        jmp leau_dc_bump;
      leau_dc_bad_dur:
        mov rax, 0xFFFFF27A;
        push rax;
        mov rdi, 6;                      // BAD_DUR
        call leau_note;
        pop rax;
        jmp leau_dc_bump;
      leau_dc_bad_dir:
        mov rax, 0xFFFFF279;
        jmp leau_dc_bump;
      leau_dc_dup:
        mov rax, 0xFFFFF275;
        jmp leau_dc_bump;
      leau_dc_enospc:
        mov rax, 0xFFFFF277;
      leau_dc_bump:
        push rax;
        mov rdi, 7;                      // REFUSED
        call leau_note;
        pop rax;
      leau_dc_out:
        add rsp, 16;                     // restore r8/r9 slots
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // leau_role_release(row_id) -- release a role row.  ONE WRITER of the
  // negative edge.  Refuses BAD_ROW.
  // ==========================================================================

  pub let leau_role_release : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): release one BAP/CAP role row. Labels prefixed leau_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call leau_row_in_use;
        cmp rax, 0;
        je  leau_rl_bad;

        lea r10, [rip + _leau_rows];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rdi, 1;                      // RELEASES
        call leau_note;
        xor rax, rax;
        jmp leau_rl_out;

      leau_rl_bad:
        mov rax, 0xFFFFF27E;
        push rax;
        mov rdi, 7;
        call leau_note;
        pop rax;
      leau_rl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // leau_isoch_frame(row_id, frame_len) -- one LC3 frame arrived on the
  // role's isoch stream.  Structural contract: LC3 frames are 20..155
  // bytes at 48 kHz / 10 ms; we accept the (min=15, max=200) envelope
  // that covers every valid (rate, duration) pair per LC3 §3.  Refuses
  // BAD_ROW / BAD_FRAME.  Advances FRAMES counter.
  // ==========================================================================

  pub let leau_isoch_frame : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (frame_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M6-003 (#1345): LC3 frame-arrival contract on the isoch stream.  Refuses BAD_ROW / BAD_FRAME.  Advances FRAMES counter. Labels prefixed leau_if_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call leau_row_in_use;
        cmp rax, 0;
        je  leau_if_bad_row;

        mov r10, 15;
        cmp r13, r10;
        jb  leau_if_bad_frame;
        mov r10, 200;
        cmp r13, r10;
        ja  leau_if_bad_frame;

        mov rdi, 2;                      // FRAMES
        call leau_note;
        xor rax, rax;
        jmp leau_if_out;

      leau_if_bad_row:
        mov rax, 0xFFFFF27E;
        jmp leau_if_bump;
      leau_if_bad_frame:
        mov rax, 0xFFFFF273;
      leau_if_bump:
        push rax;
        mov rdi, 7;
        call leau_note;
        pop rax;
      leau_if_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
