// src/kernel/core/drivers/bt/hci_cnvi.pdx — R39.M1-001 (#1323)
//
// HCI transport over the Intel CNVi bus.  CNVi (Connectivity iVector)
// is the shared PHY that carries both 802.11 traffic (R38 AX211) and
// Bluetooth HCI traffic on the same silicon.  This module is the ONE
// WRITER of the small-ring bookkeeping that fronts the BT slice of the
// bus and the ONE SITE that discharges the four HCI packet frames
// (CMD / ACL / SCO / EVT per BT §4.1) into and out of that slice.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CNVi HCI TRANSPORT: the code that takes a well-formed HCI
// packet (opcode / length / params from the R39.M1-004 packer) and
// stages it on the small in-memory ring that a live iwlwifi + iwlbt
// firmware pair would consume; it is also the code that takes an
// inbound EVT (bytes from the controller) and unpacks the framing per
// BT §4.4.  A second stager on this ring would let one path submit a
// CMD and the other silently drop it because the head pointer moved
// underneath, and the debug fingerprint would agree with neither.
//
// It is NOT the CNVi PHY.  The PHY handshake and CTXT_INFO plumbing
// belong to R38.M2 (wifi/ctxt_info.pdx).  This module rides on top of
// the CTXT_INFO block via a VHCI-like bridge: the AX211 firmware
// exposes an HCI slice as a small pair of rings alongside the 802.11
// TR/RX rings.
//
// It is NOT the KIND_BT_HCI_CHANNEL capability.  A KIND_BT_HCI_CHANNEL
// row (kind_bt_hci_channel.pdx) names ONE side of the transport
// (direction + packet_type + adapter_slot); this module accepts a
// row_id and a packet payload and does the framing / staging work.
//
// It DOES NOT ISSUE MMIO.  The ring lives in this module's .bss.  A
// live driver hands the firmware the physical address of the region via
// the same CTXT_INFO_BA path fw_load models under R38; the substitution
// point is here, unchanged for the caller.
//
// =============================================================================
// §1  RING GEOMETRY -- BT SLICE OF CNVi
// =============================================================================
//
// TX (host->controller): 16 slots of {opcode | len_flags, param_word}.
//   word 0: opcode[15:0] | len[23:16] | flags[31:24]
//   word 1: param_word (up to 64 bits of parameters; sufficient for
//           the M1.M4 CMD corpus).
// RX (controller->host): 16 slots of {evt_code | param_len | subevent |
//   flags, param_word}.
//   word 0: evt_code[7:0] | param_len[15:8] | subevent[23:16] |
//           flags[31:24].
//   word 1: param_word.
//
// A live driver's TFD holds up to 20 fragments; the two-word form here
// is sufficient for the R39.M1 refuse-gate exercise and expands
// without changing the hci_tx_slot_write signature.
//
// =============================================================================
// §2  INDEX BOOKKEEPING
// =============================================================================
//
// _hci_indices carries {tx_head, tx_tail, rx_head, rx_tail, tx_ring_bda,
// rx_ring_bda, reserved, reserved}.  head and tail are FREE-RUNNING
// 64-bit counters; the slot index is (head % 16).  Free-running counters
// distinguish "empty ring" from "full ring" without a spare slot.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _hci_tx_ring, _hci_rx_ring, _hci_indices, and _hci_stats are written
// only by helpers in this module.  tools/build.sh confines relocations
// against each symbol to `core/drivers/bt/hci_cnvi.o`.
//
// =============================================================================
// §4  HCI PACKET FRAMING (BT §4)
// =============================================================================
//
// Per BT §4.1 there are four HCI packet types identified on the wire by
// a one-byte type indicator:
//
//   HCI_PKT_CMD  0x01   host -> controller command
//   HCI_PKT_ACL  0x02   host <-> controller ACL data
//   HCI_PKT_SCO  0x03   host <-> controller SCO data
//   HCI_PKT_EVT  0x04   controller -> host event
//
// This module packs / unpacks the FRAMING (type + opcode/handle + length)
// only; the parameter payload is opaque to the transport and travels as
// a single u64 in this scaffold.
//
// =============================================================================
// §5  FAILURE TAXONOMY 0xFFFFF120..0xFFFFF12F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: kind_bt_hci_channel
// 0xFFFFF130..3F; adjacent free band below: bt_hci_channel schema
// 0xFFFFF110..1F).

module HciCnvi = structure {

  // §1: geometry.
  pub let HCI_TX_DEPTH      : u64 = 16
  pub let HCI_RX_DEPTH      : u64 = 16
  pub let HCI_TX_ENTRY_U64S : u64 = 2
  pub let HCI_RX_ENTRY_U64S : u64 = 2

  // §4: packet type indicators.
  pub let HCI_PKT_CMD : u64 = 0x01
  pub let HCI_PKT_ACL : u64 = 0x02
  pub let HCI_PKT_SCO : u64 = 0x03
  pub let HCI_PKT_EVT : u64 = 0x04
  pub let HCI_PKT_MAX : u64 = 0x04

  // §2: index slot indices inside _hci_indices.
  pub let HCI_IDX_TX_HEAD    : u64 = 0
  pub let HCI_IDX_TX_TAIL    : u64 = 1
  pub let HCI_IDX_RX_HEAD    : u64 = 2
  pub let HCI_IDX_RX_TAIL    : u64 = 3
  pub let HCI_IDX_TX_BDA     : u64 = 4
  pub let HCI_IDX_RX_BDA     : u64 = 5
  pub let HCI_IDX_SLOTS      : u64 = 8

  // §5: failure taxonomy 0xFFFFF120..0xFFFFF12F.
  pub let HCI_OK             : u64 = 0
  pub let HCI_BAD_ARG        : u64 = 0xFFFFF12F
  pub let HCI_INDEX_OOR      : u64 = 0xFFFFF12E
  pub let HCI_RING_FULL      : u64 = 0xFFFFF12D
  pub let HCI_RING_EMPTY     : u64 = 0xFFFFF12C
  pub let HCI_BAD_PKT_TYPE   : u64 = 0xFFFFF12B
  pub let HCI_BAD_LEN        : u64 = 0xFFFFF12A
  pub let HCI_NOT_INIT       : u64 = 0xFFFFF129
  pub let HCI_BAD_OPCODE     : u64 = 0xFFFFF128
  pub let HCI_BAD_HANDLE     : u64 = 0xFFFFF127
  pub let HCI_BAD_EVT_CODE   : u64 = 0xFFFFF126
  pub let HCI_BAD_FLAGS      : u64 = 0xFFFFF125
  pub let HCI_NOT_ARBITRATED : u64 = 0xFFFFF124

  // Per BT §4.1 opcode field: OGF (6 bits, 15:10) | OCF (10 bits, 9:0).
  // A live controller consumes any well-formed 16-bit opcode.  For the
  // refuse-gate we bound-check the length field per BT §4.4.1:
  //   HCI Command parameter length: 0..255 (u8)
  //   HCI Event parameter length:   0..255 (u8)
  //   HCI ACL data length:          0..0xFFFF (u16)
  pub let HCI_CMD_LEN_MAX : u64 = 255
  pub let HCI_EVT_LEN_MAX : u64 = 255
  pub let HCI_ACL_LEN_MAX : u64 = 65535

  // §3: the writers.
  //   TX ring: 16 * 2 = 32 u64s (256 bytes).
  pub let mut _hci_tx_ring : [u64; 32] = uninit @align(64)
  //   RX ring: 16 * 2 = 32 u64s (256 bytes).
  pub let mut _hci_rx_ring : [u64; 32] = uninit @align(64)
  //   Indices + ring BDAs.
  pub let mut _hci_indices : [u64; 8]  = uninit @align(64)
  //   Stats.
  pub let mut _hci_stats   : [u64; 8]  = uninit @align(64)
  //   Arbitration flag (0 until a live firmware hands us the BDA).
  pub let mut _hci_arbitrated : u64 = 0

  pub let HCI_ST_INITS       : u64 = 0
  pub let HCI_ST_TX_WRITES   : u64 = 1
  pub let HCI_ST_RX_WRITES   : u64 = 2
  pub let HCI_ST_REFUSED     : u64 = 3
  pub let HCI_ST_PACKS       : u64 = 4
  pub let HCI_ST_UNPACKS     : u64 = 5

  // ==========================================================================
  // Reset -- zero every writer.  Boot + teardown.
  // ==========================================================================

  pub let hci_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): zero TX ring, RX ring, indices, stats, arbitration flag. Labels prefixed hci_rs_.",
      block: {
        // _hci_tx_ring: 32 u64.
        lea r10, [rip + _hci_tx_ring];
        xor rax, rax;
        xor rcx, rcx;
      hci_rs_tx:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  hci_rs_tx;

        // _hci_rx_ring: 32 u64.
        lea r10, [rip + _hci_rx_ring];
        xor rcx, rcx;
      hci_rs_rx:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  hci_rs_rx;

        // _hci_indices: 8 u64.
        lea r10, [rip + _hci_indices];
        xor rcx, rcx;
      hci_rs_idx:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hci_rs_idx;

        // _hci_stats: 8 u64.
        lea r10, [rip + _hci_stats];
        xor rcx, rcx;
      hci_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hci_rs_st;

        // Arbitration flag.
        lea r10, [rip + _hci_arbitrated];
        mov [r10], rax;
        ret
      }
    } @no_frame

  pub let hci_arbitrated : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): 1 iff a live firmware has claimed the CNVi BT slice via the CTXT_INFO bridge. Labels prefixed hci_ar_.",
      block: {
        lea r10, [rip + _hci_arbitrated];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let hci_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): counter bump. Labels prefixed hci_nt_.",
      block: {
        cmp rdi, 8;
        jae hci_nt_out;
        lea r10, [rip + _hci_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hci_nt_out:
        ret
      }
    } @no_frame

  pub let hci_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): counter read. Labels prefixed hci_stt_.",
      block: {
        cmp rdi, 8;
        jae hci_stt_zero;
        lea r10, [rip + _hci_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hci_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Index accessors (single writers of _hci_indices).
  // ==========================================================================

  pub let hci_index_get : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): read one index. Refuses out-of-range. Labels prefixed hci_ig_.",
      block: {
        cmp rdi, 8;
        jae hci_ig_bad;
        lea r10, [rip + _hci_indices];
        mov rax, [r10 + rdi * 8];
        ret;
      hci_ig_bad:
        mov rax, 0xFFFFF12E;
        ret
      }
    } @no_frame

  pub let hci_index_set : (u64, u64) -> u64 !{mem} @{} =
    fn (which: u64) (val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): write one index. THE ONE WRITER. Refuses out-of-range. Labels prefixed hci_is_.",
      block: {
        cmp rdi, 8;
        jae hci_is_bad;
        lea r10, [rip + _hci_indices];
        mov [r10 + rdi * 8], rsi;
        xor rax, rax;
        ret;
      hci_is_bad:
        mov rax, 0xFFFFF12E;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Packet-type validator.
  // ==========================================================================

  pub let hci_pkt_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-001 (#1323): 1 iff t in {CMD,ACL,SCO,EVT}. Labels prefixed hci_ptv_.",
      block: {
        cmp rdi, 1;
        jb  hci_ptv_no;
        cmp rdi, 4;
        ja  hci_ptv_no;
        mov rax, 1;
        ret;
      hci_ptv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Command packer -- opcode + length -> word 0.
  // ==========================================================================

  pub let hci_cmd_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (opcode: u64) (param_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): pack HCI CMD framing word 0: opcode[15:0] | len[23:16] | flags=CMD[31:24]. Refuses opcode > u16 (BAD_OPCODE) and len > 255 (BAD_LEN). Labels prefixed hci_cp_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  hci_cp_bad_op;
        cmp rsi, 255;
        ja  hci_cp_bad_len;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, 0x01;                    // HCI_PKT_CMD
        shl r10, 24;
        or  rax, r10;

        push rax;
        mov rdi, 4;
        call hci_note;
        pop rax;
        ret;
      hci_cp_bad_op:
        mov rax, 0xFFFFF128;
        ret;
      hci_cp_bad_len:
        mov rax, 0xFFFFF12A;
        ret
      }
    }

  // ==========================================================================
  // Event packer -- evt_code + param_len -> word 0.
  // ==========================================================================

  pub let hci_evt_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (evt_code: u64) (param_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): pack HCI EVT framing word 0: evt_code[7:0] | len[15:8] | subevent=0[23:16] | flags=EVT[31:24]. Labels prefixed hci_ep_.",
      block: {
        cmp rdi, 255;
        ja  hci_ep_bad_evt;
        cmp rsi, 255;
        ja  hci_ep_bad_len;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, 0x04;                    // HCI_PKT_EVT
        shl r10, 24;
        or  rax, r10;

        push rax;
        mov rdi, 4;
        call hci_note;
        pop rax;
        ret;
      hci_ep_bad_evt:
        mov rax, 0xFFFFF126;
        ret;
      hci_ep_bad_len:
        mov rax, 0xFFFFF12A;
        ret
      }
    }

  // ==========================================================================
  // ACL packer -- conn_handle + data_len -> word 0.
  // ==========================================================================

  pub let hci_acl_pack : (u64, u64) -> u64 !{mem} @{} =
    fn (conn_handle: u64) (data_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): pack HCI ACL framing word 0: handle[11:0] | pb_flag=0[13:12] | bc_flag=0[15:14] | len[31:16] (framed as u16 per BT §5.4.2). Labels prefixed hci_ap_.",
      block: {
        mov r10, 0x0FFF;
        cmp rdi, r10;
        ja  hci_ap_bad_h;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  hci_ap_bad_len;

        mov rax, rdi;
        and rax, 0x0FFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;

        push rax;
        mov rdi, 4;
        call hci_note;
        pop rax;
        ret;
      hci_ap_bad_h:
        mov rax, 0xFFFFF127;
        ret;
      hci_ap_bad_len:
        mov rax, 0xFFFFF12A;
        ret
      }
    }

  // ==========================================================================
  // Unpackers.
  // ==========================================================================

  pub let hci_cmd_unpack_opcode : (u64) -> u64 !{mem} @{} =
    fn (w0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): opcode field from CMD word 0. Labels prefixed hci_cuo_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame

  pub let hci_cmd_unpack_len : (u64) -> u64 !{mem} @{} =
    fn (w0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): len field from CMD word 0. Labels prefixed hci_cul_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hci_evt_unpack_code : (u64) -> u64 !{mem} @{} =
    fn (w0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): evt_code from EVT word 0. Labels prefixed hci_euc_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hci_evt_unpack_len : (u64) -> u64 !{mem} @{} =
    fn (w0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): len field from EVT word 0. Labels prefixed hci_eul_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let hci_pkt_type_of : (u64) -> u64 !{mem} @{} =
    fn (w0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): packet type indicator from word 0[31:24]. Labels prefixed hci_pto_.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // TX slot write.  THE ONE WRITER of _hci_tx_ring.
  // ==========================================================================

  pub let hci_tx_slot_write : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (w0: u64) (param_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): write one TX slot. Refuses slot >= HCI_TX_DEPTH. Labels prefixed hci_tw_.",
      block: {
        cmp rdi, 16;
        jae hci_tw_bad;
        // Refuse a word 0 with an out-of-range packet-type indicator.
        mov r10, rsi;
        shr r10, 24;
        and r10, 0xFF;
        cmp r10, 0;
        je  hci_tw_bad_pkt;
        cmp r10, 4;
        ja  hci_tw_bad_pkt;

        lea r10, [rip + _hci_tx_ring];
        mov r11, rdi;
        shl r11, 4;                       // 2 u64 = 16 bytes per slot
        add r10, r11;
        mov [r10 + 0], rsi;
        mov [r10 + 8], rdx;

        mov rdi, 1;
        call hci_note;

        xor rax, rax;
        ret;
      hci_tw_bad_pkt:
        mov rax, 0xFFFFF12B;
        ret;
      hci_tw_bad:
        mov rax, 0xFFFFF12E;
        ret
      }
    }

  pub let hci_tx_slot_read : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (which_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): read one TX slot word (0 or 1). Refuses OOR. Labels prefixed hci_tr_.",
      block: {
        cmp rdi, 16;
        jae hci_tr_bad;
        cmp rsi, 1;
        ja  hci_tr_bad;

        lea r10, [rip + _hci_tx_ring];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov r11, rsi;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10];
        ret;
      hci_tr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // RX slot write.  THE ONE WRITER of _hci_rx_ring.  (In production this
  // is populated by the controller-side firmware via DMA; this scaffold
  // exposes the entry point directly so a witness can synth a payload.)
  // ==========================================================================

  pub let hci_rx_slot_write : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (w0: u64) (param_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): write one RX slot. Refuses slot >= HCI_RX_DEPTH. Labels prefixed hci_rw_.",
      block: {
        cmp rdi, 16;
        jae hci_rw_bad;
        // Only EVT (0x04) or ACL (0x02) or SCO (0x03) are legal on RX;
        // CMD is host->controller only.
        mov r10, rsi;
        shr r10, 24;
        and r10, 0xFF;
        cmp r10, 2;
        jb  hci_rw_bad_pkt;
        cmp r10, 4;
        ja  hci_rw_bad_pkt;

        lea r10, [rip + _hci_rx_ring];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov [r10 + 0], rsi;
        mov [r10 + 8], rdx;

        mov rdi, 2;
        call hci_note;

        xor rax, rax;
        ret;
      hci_rw_bad_pkt:
        mov rax, 0xFFFFF12B;
        ret;
      hci_rw_bad:
        mov rax, 0xFFFFF12E;
        ret
      }
    }

  pub let hci_rx_slot_read : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (which_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): read one RX slot word (0 or 1). Refuses OOR. Labels prefixed hci_rr_.",
      block: {
        cmp rdi, 16;
        jae hci_rr_bad;
        cmp rsi, 1;
        ja  hci_rr_bad;

        lea r10, [rip + _hci_rx_ring];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov r11, rsi;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10];
        ret;
      hci_rr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Enqueue -- pack + stage + bump tail, using the free-running counter
  // discipline (head - tail == depth means full).
  // ==========================================================================

  pub let hci_tx_enqueue : (u64, u64) -> u64 !{mem} @{} =
    fn (framing_w0: u64) (param_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): stage one framed CMD/ACL/SCO into the TX ring. Refuses RING_FULL and BAD_PKT_TYPE. Labels prefixed hci_te_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // framing_w0
        mov r13, rsi;                    // param_word

        // Framing sanity: type indicator in [1,3] (CMD/ACL/SCO on TX).
        mov r10, r12;
        shr r10, 24;
        and r10, 0xFF;
        cmp r10, 1;
        jb  hci_te_bad_pkt;
        cmp r10, 3;
        ja  hci_te_bad_pkt;

        // Fullness check: head - tail >= DEPTH -> FULL.
        mov rdi, 0;                      // HCI_IDX_TX_HEAD
        call hci_index_get;
        mov rbx, rax;                    // head
        mov rdi, 1;                      // HCI_IDX_TX_TAIL
        call hci_index_get;
        mov r14, rax;                    // tail

        mov rax, rbx;
        sub rax, r14;
        cmp rax, 16;
        jae hci_te_full;

        // Slot = tail mod 16.
        mov rax, r14;
        and rax, 0x0F;

        mov rdi, rax;
        mov rsi, r12;
        mov rdx, r13;
        call hci_tx_slot_write;
        cmp rax, 0;
        jne hci_te_out;

        // Bump tail.
        add r14, 1;
        mov rdi, 1;
        mov rsi, r14;
        call hci_index_set;
        cmp rax, 0;
        jne hci_te_out;

        xor rax, rax;
        jmp hci_te_out;

      hci_te_bad_pkt:
        mov rax, 0xFFFFF12B;
        jmp hci_te_out;
      hci_te_full:
        mov rdi, 3;
        call hci_note;
        mov rax, 0xFFFFF12D;

      hci_te_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hci_rx_dequeue : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-001 (#1323): pop head slot from RX ring. Returns word 0 of the head slot (0xFFFF...FF if empty). Advances head. Labels prefixed hci_rd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rdi, 2;                      // HCI_IDX_RX_HEAD
        call hci_index_get;
        mov rbx, rax;                    // head
        mov rdi, 3;                      // HCI_IDX_RX_TAIL
        call hci_index_get;
        mov r12, rax;                    // tail

        cmp rbx, r12;
        je  hci_rd_empty;

        mov rax, rbx;
        and rax, 0x0F;
        mov rdi, rax;
        mov rsi, 0;
        call hci_rx_slot_read;
        mov r13, rax;                    // save word 0

        add rbx, 1;
        mov rdi, 2;
        mov rsi, rbx;
        call hci_index_set;

        mov rax, r13;
        jmp hci_rd_out;

      hci_rd_empty:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      hci_rd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
