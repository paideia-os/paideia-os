// src/kernel/core/drivers/bt/l2cap_fixed.pdx — R39.M2-001 (#1327)
//
// L2CAP fixed channels (BT §3.2) -- the registration + lookup surface
// for the three fixed CIDs that carry ATT, LE signalling, and Security
// Manager traffic.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// L2CAP §3.2 defines a small enumerated set of FIXED channel identifiers
// that are reserved across every LE ACL connection: 0x0004 (ATT),
// 0x0005 (LE signalling), and 0x0006 (Security Manager).  Every LE
// connection carries these three CIDs implicitly -- there is no
// CONNECT_REQ / RSP handshake for them; a subscriber that receives a
// frame on CID 0x0004 has bytes that mean "ATT PDU" regardless of
// negotiation.  This module owns the small registration table that maps
// each fixed CID to the KIND_IPC_ENDPOINT handler_key that receives its
// traffic, and the lookup helper the RX path calls per inbound frame.
//
// It is NOT the ATT / SMP protocol.  Those live in
// drivers/bt/gatt.pdx (R39.M3) and would live in drivers/bt/smp.pdx if
// SMP were separated from le_sc.pdx (R39.M4).  This module carries the
// CID -> handler binding only.
//
// It is NOT the DYNAMIC channel machinery.  Dynamic CIDs 0x0040+
// negotiated through LE CBFC live in drivers/bt/l2cap_dyn.pdx.
//
// =============================================================================
// §1  FIXED CIDS (BT §3.2)
// =============================================================================
//
//   LFX_CID_ATT           0x0004   Attribute Protocol (BT §3.4)
//   LFX_CID_LE_SIGNALING  0x0005   LE L2CAP signalling channel (BT §3.4.6)
//   LFX_CID_SM            0x0006   Security Manager Protocol (BT §3.5)
//
// Every other CID in the fixed range (0x0001 = BR/EDR signalling,
// 0x0002 = connectionless, 0x0003 = AMP manager) is refused because
// this is an LE-only host.
//
// =============================================================================
// §2  REGISTRATION TABLE
// =============================================================================
//
// _lfx_channels holds four rows of four u64s (cid, handler_key,
// hci_chan_slot, in_use flag).  Four rows because the three fixed CIDs
// plus one spare cover any live registration surface -- the table is
// scanned linearly on every RX packet, so growth past four hurts the
// hot path.
//
// A second registration site would let one path advance a handler bind
// while another read the old binding; every mutator lives in this file
// and tools/build.sh confines relocations against _lfx_channels to
// core/drivers/bt/l2cap_fixed.o.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF0F0..0xFFFFF0FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: kind_bt_l2cap_channel
// 0xFFFFF100..0F; adjacent free band below: l2cap_dyn 0xFFFFF0E0..EF).

module L2capFixed = structure {

  // §1: fixed CIDs.
  pub let LFX_CID_ATT          : u64 = 0x0004
  pub let LFX_CID_LE_SIGNALING : u64 = 0x0005
  pub let LFX_CID_SM           : u64 = 0x0006

  // §2: table geometry (4 rows x 4 u64 = 16 u64).
  pub let LFX_CHAN_MAX     : u64 = 4
  pub let LFX_ROW_WORDS    : u64 = 4

  // Row column ordinals.
  pub let LFX_COL_CID           : u64 = 0
  pub let LFX_COL_HANDLER_KEY   : u64 = 1
  pub let LFX_COL_HCI_CHAN_SLOT : u64 = 2
  pub let LFX_COL_IN_USE        : u64 = 3

  // §3: failure taxonomy 0xFFFFF0F0..0xFFFFF0FF.
  pub let LFX_OK                 : u64 = 0
  pub let LFX_BAD_CID            : u64 = 0xFFFFF0FF
  pub let LFX_UNKNOWN_CID        : u64 = 0xFFFFF0FE
  pub let LFX_ALREADY_REGISTERED : u64 = 0xFFFFF0FD
  pub let LFX_ENOSPC             : u64 = 0xFFFFF0FC
  pub let LFX_BAD_HANDLER        : u64 = 0xFFFFF0FB
  pub let LFX_BAD_CHAN_SLOT      : u64 = 0xFFFFF0FA
  pub let LFX_NOT_REGISTERED     : u64 = 0xFFFFF0F9
  pub let LFX_BAD_ARG            : u64 = 0xFFFFF0F8
  pub let LFX_NOT_INITIALIZED    : u64 = 0xFFFFF0F7
  pub let LFX_ALREADY_INIT       : u64 = 0xFFFFF0F6
  pub let LFX_RX_NO_HANDLER      : u64 = 0xFFFFF0F5
  pub let LFX_UNUSED_A           : u64 = 0xFFFFF0F4
  pub let LFX_UNUSED_B           : u64 = 0xFFFFF0F3
  pub let LFX_UNUSED_C           : u64 = 0xFFFFF0F2
  pub let LFX_UNUSED_D           : u64 = 0xFFFFF0F1
  pub let LFX_UNUSED_E           : u64 = 0xFFFFF0F0

  pub let LFX_ROW_NONE : u64 = 0xFF

  // 4 rows x 4 words = 16 u64.
  pub let mut _lfx_channels : [u64; 16] = uninit @align(64)
  pub let mut _lfx_stats    : [u64; 4]  = uninit @align(64)
  pub let mut _lfx_init     : u64       = 0

  // Counter ordinals inside _lfx_stats.
  pub let LFX_ST_REGISTERS   : u64 = 0
  pub let LFX_ST_UNREGISTERS : u64 = 1
  pub let LFX_ST_LOOKUPS     : u64 = 2
  pub let LFX_ST_REFUSED     : u64 = 3

  // ==========================================================================
  // lfx_init -- reset registration table.  MUST run before any other op.
  // ==========================================================================

  pub let lfx_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): reset registration table + counters + init flag. Labels prefixed lfx_i_.",
      block: {
        lea r10, [rip + _lfx_channels];
        xor rax, rax;
        xor rcx, rcx;
      lfx_i_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  lfx_i_rows;

        lea r10, [rip + _lfx_stats];
        xor rcx, rcx;
      lfx_i_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  lfx_i_stats;

        lea r10, [rip + _lfx_init];
        mov rax, 1;
        mov [r10], rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let lfx_cid_valid : (u64) -> u64 !{} @{} =
    fn (cid: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M2-001 (#1327): 1 iff cid in {ATT (0x04), LE_SIGNALING (0x05), SM (0x06)} per BT §3.2. Labels prefixed lfx_cv_.",
      block: {
        cmp rdi, 0x0004;
        je  lfx_cv_yes;
        cmp rdi, 0x0005;
        je  lfx_cv_yes;
        cmp rdi, 0x0006;
        je  lfx_cv_yes;
        xor rax, rax;
        ret;
      lfx_cv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let lfx_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): counter bump. Labels prefixed lfx_nt_.",
      block: {
        cmp rdi, 4;
        jae lfx_nt_out;
        lea r10, [rip + _lfx_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      lfx_nt_out:
        ret
      }
    }

  pub let lfx_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): counter read. Labels prefixed lfx_stt_.",
      block: {
        cmp rdi, 4;
        jae lfx_stt_zero;
        lea r10, [rip + _lfx_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      lfx_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pointer.  Returns pointer into _lfx_channels for row `id`, or 0.
  // ==========================================================================

  pub let lfx_row_addr : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): row pointer or 0. Labels prefixed lfx_ra_.",
      block: {
        cmp rdi, 4;
        jae lfx_ra_no;
        lea r10, [rip + _lfx_channels];
        mov r11, rdi;
        shl r11, 5;                       // 4 u64 * 8 = 32 bytes/row
        add r10, r11;
        mov rax, r10;
        ret;
      lfx_ra_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Find row by CID -- returns row_id (0..3) or LFX_ROW_NONE.
  // ==========================================================================

  pub let lfx_find_by_cid : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): live row with column CID == cid, or ROW_NONE. Labels prefixed lfx_fc_.",
      block: {
        cmp rdi, 0;
        je  lfx_fc_none;
        xor rcx, rcx;
      lfx_fc_scan:
        cmp rcx, 4;
        jae lfx_fc_none;
        lea r10, [rip + _lfx_channels];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];             // in_use column (offset 3*8)
        cmp rax, 0;
        je  lfx_fc_next;
        mov rax, [r10 + 0];              // cid column
        cmp rax, rdi;
        je  lfx_fc_hit;
      lfx_fc_next:
        add rcx, 1;
        jmp lfx_fc_scan;
      lfx_fc_hit:
        mov rax, rcx;
        ret;
      lfx_fc_none:
        mov rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // lfx_register(cid, handler_key, hci_chan_slot) -> row_id | FAIL
  // ==========================================================================

  pub let lfx_register : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (cid: u64) (handler_key: u64) (hci_chan_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): bind (cid -> handler_key) at hci_chan_slot. Refuse if cid not in fixed set (BAD_CID), handler_key 0 (BAD_HANDLER), hci_chan_slot >= 256 (BAD_CHAN_SLOT), cid already registered (ALREADY_REGISTERED), or table full (ENOSPC). Labels prefixed lfx_rg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // cid
        mov r13, rsi;                    // handler_key
        mov r14, rdx;                    // hci_chan_slot

        lea r10, [rip + _lfx_init];
        mov rax, [r10];
        cmp rax, 0;
        je  lfx_rg_notinit;

        mov rdi, r12;
        call lfx_cid_valid;
        cmp rax, 0;
        je  lfx_rg_bad_cid;

        cmp r13, 0;
        je  lfx_rg_bad_handler;

        mov r10, 256;
        cmp r14, r10;
        jae lfx_rg_bad_chan;

        mov rdi, r12;
        call lfx_find_by_cid;
        cmp rax, 0xFF;
        jne lfx_rg_already;

        xor rbx, rbx;
      lfx_rg_scan:
        cmp rbx, 4;
        jae lfx_rg_full;
        lea r10, [rip + _lfx_channels];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];             // in_use
        cmp rax, 0;
        je  lfx_rg_claim;
        add rbx, 1;
        jmp lfx_rg_scan;

      lfx_rg_claim:
        mov [r10 + 0],  r12;             // cid
        mov [r10 + 8],  r13;             // handler_key
        mov [r10 + 16], r14;             // hci_chan_slot
        mov rax, 1;
        mov [r10 + 24], rax;             // in_use

        mov rdi, 0;
        call lfx_note;

        mov rax, rbx;
        jmp lfx_rg_out;

      lfx_rg_notinit:
        mov rax, 0xFFFFF0F7;             // NOT_INITIALIZED
        jmp lfx_rg_out;
      lfx_rg_bad_cid:
        mov rdi, 3;
        call lfx_note;
        mov rax, 0xFFFFF0FF;             // BAD_CID
        jmp lfx_rg_out;
      lfx_rg_bad_handler:
        mov rax, 0xFFFFF0FB;             // BAD_HANDLER
        jmp lfx_rg_out;
      lfx_rg_bad_chan:
        mov rax, 0xFFFFF0FA;             // BAD_CHAN_SLOT
        jmp lfx_rg_out;
      lfx_rg_already:
        mov rdi, 3;
        call lfx_note;
        mov rax, 0xFFFFF0FD;             // ALREADY_REGISTERED
        jmp lfx_rg_out;
      lfx_rg_full:
        mov rdi, 3;
        call lfx_note;
        mov rax, 0xFFFFF0FC;             // ENOSPC

      lfx_rg_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lfx_lookup(cid) -> handler_key | UNKNOWN_CID
  // ==========================================================================

  pub let lfx_lookup : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): resolve cid -> handler_key. Refuse if cid not fixed (BAD_CID) or not registered (UNKNOWN_CID). Labels prefixed lfx_lk_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call lfx_cid_valid;
        cmp rax, 0;
        je  lfx_lk_bad_cid;

        mov rdi, r12;
        call lfx_find_by_cid;
        cmp rax, 0xFF;
        je  lfx_lk_unknown;

        lea r10, [rip + _lfx_channels];
        mov r11, rax;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];              // handler_key

        mov rdi, 2;
        call lfx_note;

        jmp lfx_lk_out;

      lfx_lk_bad_cid:
        mov rax, 0xFFFFF0FF;
        jmp lfx_lk_out;
      lfx_lk_unknown:
        mov rax, 0xFFFFF0FE;

      lfx_lk_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // lfx_hci_chan(cid) -> hci_chan_slot | UNKNOWN_CID
  // ==========================================================================

  pub let lfx_hci_chan : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): resolve cid -> hci_chan_slot. Labels prefixed lfx_hc_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call lfx_cid_valid;
        cmp rax, 0;
        je  lfx_hc_bad_cid;

        mov rdi, r12;
        call lfx_find_by_cid;
        cmp rax, 0xFF;
        je  lfx_hc_unknown;

        lea r10, [rip + _lfx_channels];
        mov r11, rax;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];             // hci_chan_slot
        jmp lfx_hc_out;

      lfx_hc_bad_cid:
        mov rax, 0xFFFFF0FF;
        jmp lfx_hc_out;
      lfx_hc_unknown:
        mov rax, 0xFFFFF0FE;

      lfx_hc_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // lfx_unregister(cid) -> OK | NOT_REGISTERED
  // ==========================================================================

  pub let lfx_unregister : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): tear down (cid -> ...) binding. Refuse if not fixed (BAD_CID) or not currently bound (NOT_REGISTERED). Labels prefixed lfx_un_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call lfx_cid_valid;
        cmp rax, 0;
        je  lfx_un_bad_cid;

        mov rdi, r12;
        call lfx_find_by_cid;
        cmp rax, 0xFF;
        je  lfx_un_not_reg;

        lea r10, [rip + _lfx_channels];
        mov r11, rax;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;             // in_use = 0

        mov rdi, 1;
        call lfx_note;

        xor rax, rax;
        jmp lfx_un_out;

      lfx_un_bad_cid:
        mov rax, 0xFFFFF0FF;
        jmp lfx_un_out;
      lfx_un_not_reg:
        mov rax, 0xFFFFF0F9;

      lfx_un_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // lfx_rx_dispatch(cid) -> handler_key | RX_NO_HANDLER
  //
  // The single site the RX path calls per inbound L2CAP frame.  Isolates
  // the RX no-handler failure from the general lookup one so operators
  // can distinguish a subscriber that queried an absent binding
  // (LFX_UNKNOWN_CID) from an RX frame that arrived with no receiver
  // (LFX_RX_NO_HANDLER).
  // ==========================================================================

  pub let lfx_rx_dispatch : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M2-001 (#1327): RX-path lookup; distinguishes no-handler (RX_NO_HANDLER) from unknown-cid (BAD_CID). Labels prefixed lfx_rx_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call lfx_cid_valid;
        cmp rax, 0;
        je  lfx_rx_bad;

        mov rdi, r12;
        call lfx_find_by_cid;
        cmp rax, 0xFF;
        je  lfx_rx_none;

        lea r10, [rip + _lfx_channels];
        mov r11, rax;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];              // handler_key
        jmp lfx_rx_out;

      lfx_rx_bad:
        mov rax, 0xFFFFF0FF;
        jmp lfx_rx_out;
      lfx_rx_none:
        mov rdi, 3;
        call lfx_note;
        mov rax, 0xFFFFF0F5;

      lfx_rx_out:
        pop r12;
        ret
      }
    }
}
