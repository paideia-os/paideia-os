// src/kernel/core/drivers/bt/le_sc.pdx — R39.M4-001 (#1335)
//
// Bluetooth LE Secure Connections pairing -- P-256 ECDH keypair
// generation, peer-key exchange, DH-key handle derivation, LTK
// derivation, AuthReq bit validator, and the pairing FSM.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SCHEMA + FSM of the LE SC pairing exchange, and the
// synthetic keygen / DH / LTK helpers that discharge it.  It is NOT the
// crypto server: the P-256 arithmetic here returns SYNTHESIS HANDLES,
// and the real primitives are supplied by the R32 crypto server when
// available.  design/roadmap/next-wave-softarch.md §358: "the crypto
// server is the ONE process that unseals; every other holder passes the
// SEALED reference across a boundary that never carries raw material".
//
// The session table _lesc_sessions holds four rows of eight u64s
// (keygen_key, peer_lo, peer_hi, dhkey, ltk_handle, state, authreq,
// session_id) and is the ONE bookkeeping surface for pairing state.  A
// second table would let one path advance an FSM edge and the other
// see the old state.
//
// =============================================================================
// §1  FSM STATES + LEGAL EDGES
// =============================================================================
//
// LESC_STATE_IDLE (0) -> PAIRING_INIT (1) -> ECDH_EXCHANGE (2) ->
//   AUTH_STAGE1 (3) -> AUTH_STAGE2 (4) -> LTK_DERIVED (5) -> DONE (6).
// Any state -> FAILED (7) is legal (abort / MITM rejection); any
// state -> IDLE (0) is legal (session teardown).
//
// =============================================================================
// §2  AUTHREQ BITS (BT §3.5.1)
// =============================================================================
//
//   BONDING   0x01  request bond
//   MITM      0x04  request MITM protection
//   SC        0x08  request Secure Connections (required for LE SC)
//   KEYPRESS  0x10  request keypress notifications during passkey entry
//
// Reserved bits [7:5], [1] must be zero; any set -> AUTHREQ_INVALID.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF2E0..0xFFFFF2EF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: kind_bt_pairing
// 0xFFFFF2F0..0x2FF; adjacent free band below: bt_pairing_channel
// 0xFFFFF2D0..0x2DF).

module LeSc = structure {

  // AuthReq bits.
  pub let LESC_AUTHREQ_BONDING   : u64 = 0x01
  pub let LESC_AUTHREQ_MITM      : u64 = 0x04
  pub let LESC_AUTHREQ_SC        : u64 = 0x08
  pub let LESC_AUTHREQ_KEYPRESS  : u64 = 0x10
  pub let LESC_AUTHREQ_MASK      : u64 = 0x1D

  // FSM states.
  pub let LESC_STATE_IDLE          : u64 = 0
  pub let LESC_STATE_PAIRING_INIT  : u64 = 1
  pub let LESC_STATE_ECDH_EXCHANGE : u64 = 2
  pub let LESC_STATE_AUTH_STAGE1   : u64 = 3
  pub let LESC_STATE_AUTH_STAGE2   : u64 = 4
  pub let LESC_STATE_LTK_DERIVED   : u64 = 5
  pub let LESC_STATE_DONE          : u64 = 6
  pub let LESC_STATE_FAILED        : u64 = 7
  pub let LESC_STATE_MAX           : u64 = 7

  pub let LESC_SESSION_MAX         : u64 = 4
  pub let LESC_ROW_WORDS           : u64 = 8

  // §3 failure taxonomy 0xFFFFF2E0..0xFFFFF2EF.
  pub let LESC_OK                     : u64 = 0
  pub let LESC_BAD_ARG                : u64 = 0xFFFFF2EF
  pub let LESC_ECDH_KEYGEN_FAIL       : u64 = 0xFFFFF2EE
  pub let LESC_ECDH_BAD_PEER_KEY      : u64 = 0xFFFFF2ED
  pub let LESC_DHKEY_COMPUTE_FAIL     : u64 = 0xFFFFF2EC
  pub let LESC_LTK_DERIVE_FAIL        : u64 = 0xFFFFF2EB
  pub let LESC_AUTHREQ_INVALID        : u64 = 0xFFFFF2EA
  pub let LESC_FSM_BAD_STATE          : u64 = 0xFFFFF2E9
  pub let LESC_MITM_FAIL              : u64 = 0xFFFFF2E8
  pub let LESC_PASSKEY_BAD            : u64 = 0xFFFFF2E7
  pub let LESC_NUMERIC_COMPARE_FAIL   : u64 = 0xFFFFF2E6
  pub let LESC_KEYPRESS_BAD           : u64 = 0xFFFFF2E5
  pub let LESC_STATE_STUCK            : u64 = 0xFFFFF2E4
  pub let LESC_BOND_FAIL              : u64 = 0xFFFFF2E3
  pub let LESC_NOT_INITIALIZED        : u64 = 0xFFFFF2E2
  pub let LESC_ALREADY_ACTIVE         : u64 = 0xFFFFF2E1
  pub let LESC_ENOSPC                 : u64 = 0xFFFFF2E0

  // Session-row column ordinals (u64 word index within a row).
  pub let LESC_COL_KEYGEN_KEY : u64 = 0
  pub let LESC_COL_PEER_LO    : u64 = 1
  pub let LESC_COL_PEER_HI    : u64 = 2
  pub let LESC_COL_DHKEY      : u64 = 3
  pub let LESC_COL_LTK_HANDLE : u64 = 4
  pub let LESC_COL_STATE      : u64 = 5
  pub let LESC_COL_AUTHREQ    : u64 = 6
  pub let LESC_COL_SESSION_ID : u64 = 7

  // 4 rows x 8 words = 32 u64s.
  pub let mut _lesc_sessions : [u64; 32] = uninit @align(64)
  pub let mut _lesc_stats    : [u64; 4]  = uninit @align(64)
  pub let mut _lesc_init     : u64       = 0

  // ==========================================================================
  // lesc_init -- reset session table.  MUST run before any other op.
  // ==========================================================================

  pub let lesc_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): reset session table + counters + init flag. Labels prefixed lesc_i_.",
      block: {
        lea r10, [rip + _lesc_sessions];
        xor rax, rax;
        xor rcx, rcx;
      lesc_i_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  lesc_i_rows;

        lea r10, [rip + _lesc_stats];
        xor rcx, rcx;
      lesc_i_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  lesc_i_stats;

        lea r10, [rip + _lesc_init];
        mov rax, 1;
        mov [r10], rax;
        ret
      }
    }

  // ==========================================================================
  // AuthReq validator -- reject reserved bits.
  // ==========================================================================

  pub let lesc_authreq_validate : (u64) -> u64 !{} @{} =
    fn (req: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M4-001 (#1335): 1 iff req only bits within LESC_AUTHREQ_MASK. Labels prefixed lesc_av_.",
      block: {
        mov rax, rdi;
        mov r10, 0x1D;
        and rax, r10;
        cmp rax, rdi;
        jne lesc_av_no;
        mov rax, 1;
        ret;
      lesc_av_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Session helpers.
  // ==========================================================================

  // Return pointer into _lesc_sessions for row `id`, or 0 if out of range.
  pub let lesc_row_addr : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): row pointer or 0. Labels prefixed lesc_ra_.",
      block: {
        cmp rdi, 4;
        jae lesc_ra_no;
        lea r10, [rip + _lesc_sessions];
        mov r11, rdi;
        shl r11, 6;                       // 8 u64s * 8 = 64 bytes per row
        add r10, r11;
        mov rax, r10;
        ret;
      lesc_ra_no:
        xor rax, rax;
        ret
      }
    }

  // Allocate a session row (first row where keygen_key == 0).
  pub let lesc_alloc_session : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): claim first free session row. Labels prefixed lesc_as_.",
      block: {
        push rbx;
        push r12;

        lea r12, [rip + _lesc_init];
        mov rax, [r12];
        cmp rax, 0;
        je  lesc_as_notinit;

        xor rbx, rbx;
      lesc_as_scan:
        cmp rbx, 4;
        jae lesc_as_full;
        lea r10, [rip + _lesc_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // keygen_key
        cmp rax, 0;
        je  lesc_as_hit;
        add rbx, 1;
        jmp lesc_as_scan;
      lesc_as_hit:
        mov rax, rbx;
        jmp lesc_as_out;
      lesc_as_full:
        mov rax, 0xFFFFF2E0;             // ENOSPC
        jmp lesc_as_out;
      lesc_as_notinit:
        mov rax, 0xFFFFF2E2;             // NOT_INITIALIZED
      lesc_as_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Synth P-256 keygen -- returns a non-zero handle stored in row 0.
  // ==========================================================================

  pub let lesc_ecdh_keygen : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R39.M4-001 (#1335): synthesise P-256 keypair.  In this scaffold, `keygen_key` is a synthetic handle derived from the ROW ORDINAL plus a fixed seed; the R32 crypto server replaces this with a real ECDH call when available.  Refuses if lesc_init has not run (NOT_INITIALIZED) or if the session table is full (ECDH_KEYGEN_FAIL over ENOSPC).  Labels prefixed lesc_kg_.",
      block: {
        push rbx;
        push r12;

        call lesc_alloc_session;
        mov r12, rax;

        mov r10, 0xFFFFF2E0;
        cmp rax, r10;
        je  lesc_kg_enospc;
        mov r10, 0xFFFFF2E2;
        cmp rax, r10;
        je  lesc_kg_notinit;

        // Compose a synthetic keygen_key: 0x_P256_KEY_ | row_id.
        lea r10, [rip + _lesc_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, 0xDEADCAFE;             // decorative sentinel (P-256 stub key)
        shl rax, 8;
        or  rax, r12;                    // low byte: session ordinal
        mov [r10 + 0], rax;              // keygen_key
        mov rbx, rax;

        // State -> PAIRING_INIT.
        mov rax, 1;
        mov [r10 + 40], rax;             // state

        mov rax, rbx;                    // return keygen_key
        jmp lesc_kg_out;

      lesc_kg_enospc:
        mov rax, 0xFFFFF2EE;             // ECDH_KEYGEN_FAIL over ENOSPC
        jmp lesc_kg_out;
      lesc_kg_notinit:
        mov rax, 0xFFFFF2E2;

      lesc_kg_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Apply peer public key.  Refuses (0, 0) and refuses if session absent.
  // Returns dhkey handle (non-zero) or LESC_ECDH_BAD_PEER_KEY / etc.
  // ==========================================================================

  pub let lesc_ecdh_apply_peer : (u64, u64) -> u64 !{mem} @{} =
    fn (peer_lo: u64) (peer_hi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): stash peer pubkey on the most-recent live session (highest-numbered live row).  Refuse (0,0) as an invalid P-256 point.  Refuse if state != PAIRING_INIT.  Advance to ECDH_EXCHANGE and return a synthetic dhkey handle.  Labels prefixed lesc_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // peer_lo
        mov r13, rsi;                    // peer_hi

        // (0,0) is the point-at-infinity: reject.
        mov rax, r12;
        or  rax, r13;
        cmp rax, 0;
        je  lesc_ap_bad_peer;

        // Find most-recent live session (highest keygen_key row).
        mov rbx, 4;
      lesc_ap_scan:
        cmp rbx, 0;
        je  lesc_ap_nostate;
        sub rbx, 1;
        lea r10, [rip + _lesc_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // keygen_key
        cmp rax, 0;
        je  lesc_ap_scan;

        // Check state == PAIRING_INIT (1).
        mov rax, [r10 + 40];
        cmp rax, 1;
        jne lesc_ap_bad_state;

        // Stash peer and advance.
        mov [r10 + 8],  r12;             // peer_lo
        mov [r10 + 16], r13;             // peer_hi

        // Synth dhkey = (peer_lo ^ peer_hi) | 0x1000_0000
        mov rax, r12;
        xor rax, r13;
        or  rax, 0x10000000;
        mov [r10 + 24], rax;             // dhkey

        // state -> ECDH_EXCHANGE (2).
        mov r11, 2;
        mov [r10 + 40], r11;

        // Return dhkey.
        jmp lesc_ap_out;

      lesc_ap_bad_peer:
        mov rax, 0xFFFFF2ED;
        jmp lesc_ap_out;
      lesc_ap_bad_state:
        mov rax, 0xFFFFF2E9;
        jmp lesc_ap_out;
      lesc_ap_nostate:
        mov rax, 0xFFFFF2E2;

      lesc_ap_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Derive LTK from dhkey handle.  Returns 32-bit LTK handle (bit-truncated
  // synthesis handle -- the R32 crypto server holds the actual key bytes).
  // ==========================================================================

  pub let lesc_ltk_derive : (u64) -> u64 !{mem} @{} =
    fn (dhkey_handle: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): synthesise LTK handle from dhkey.  Refuses zero handle.  Locates the session whose dhkey matches; refuses if none.  Advances state PAIRING_ECDH_EXCHANGE -> LTK_DERIVED (5) skipping AUTH stages (this scaffold folds stage 1 + 2 into the derivation; a real implementation runs f5 / f6 between).  Returns LTK handle (32-bit) as a stub, NEVER the LTK bytes.  Labels prefixed lesc_ld_.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;

        cmp r12, 0;
        je  lesc_ld_bad;

        // Find the session whose dhkey == r12.
        xor rbx, rbx;
      lesc_ld_scan:
        cmp rbx, 4;
        jae lesc_ld_bad;
        lea r10, [rip + _lesc_sessions];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];             // dhkey
        cmp rax, r12;
        je  lesc_ld_hit;
        add rbx, 1;
        jmp lesc_ld_scan;

      lesc_ld_hit:
        // Only allow if state is ECDH_EXCHANGE (2) or an AUTH state (3, 4).
        mov rax, [r10 + 40];
        cmp rax, 2;
        jb  lesc_ld_bad_state;
        cmp rax, 4;
        ja  lesc_ld_bad_state;

        // Synth LTK handle = (dhkey * 0x9E37) & 0xFFFFFFFF | 0x8000_0000.
        mov rax, r12;
        imul rax, rax, 0x9E37;
        and rax, 0xFFFFFFFF;
        or  rax, 0x80000000;
        mov [r10 + 32], rax;             // ltk_handle

        // State -> LTK_DERIVED (5).
        mov r11, 5;
        mov [r10 + 40], r11;

        jmp lesc_ld_out;

      lesc_ld_bad_state:
        mov rax, 0xFFFFF2E9;
        jmp lesc_ld_out;
      lesc_ld_bad:
        mov rax, 0xFFFFF2EB;             // LTK_DERIVE_FAIL

      lesc_ld_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // FSM query + advance.
  // ==========================================================================

  pub let lesc_state : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): session_id -> state, or LESC_BAD_ARG. Labels prefixed lesc_st_.",
      block: {
        cmp rdi, 4;
        jae lesc_st_bad;
        lea r10, [rip + _lesc_sessions];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];              // keygen_key
        cmp rax, 0;
        je  lesc_st_stuck;
        mov rax, [r10 + 40];
        ret;
      lesc_st_stuck:
        mov rax, 0xFFFFF2E4;             // STATE_STUCK
        ret;
      lesc_st_bad:
        mov rax, 0xFFFFF2EF;             // BAD_ARG
        ret
      }
    }

  pub let lesc_advance : (u64, u64) -> u64 !{mem} @{} =
    fn (session_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M4-001 (#1335): advance FSM.  Legal edges: any -> IDLE, any -> FAILED; forward-only within IDLE < PAIRING_INIT < ECDH_EXCHANGE < AUTH_STAGE1 < AUTH_STAGE2 < LTK_DERIVED < DONE.  Refuses backward edge (FSM_BAD_STATE).  Labels prefixed lesc_adv_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 4;
        jae lesc_adv_bad;
        cmp r13, 7;
        ja  lesc_adv_bad;

        lea r10, [rip + _lesc_sessions];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];              // keygen_key
        cmp rax, 0;
        je  lesc_adv_stuck;

        mov rax, [r10 + 40];             // current state

        // Any -> IDLE (0) or FAILED (7) is legal.
        cmp r13, 0;
        je  lesc_adv_apply;
        cmp r13, 7;
        je  lesc_adv_apply;

        // Forward-only: new_state must be > current.
        cmp r13, rax;
        jbe lesc_adv_bad_edge;

      lesc_adv_apply:
        mov [r10 + 40], r13;
        xor rax, rax;
        jmp lesc_adv_out;

      lesc_adv_stuck:
        mov rax, 0xFFFFF2E4;
        jmp lesc_adv_out;
      lesc_adv_bad_edge:
        mov rax, 0xFFFFF2E9;
        jmp lesc_adv_out;
      lesc_adv_bad:
        mov rax, 0xFFFFF2EF;

      lesc_adv_out:
        pop r13;
        pop r12;
        ret
      }
    }
}
