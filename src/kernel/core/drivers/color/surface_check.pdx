// src/kernel/core/drivers/color/surface_check.pdx -- G6.M1-005 (#1513)
//
// P5 partial: the elaborator-side check that a surface commit
// carries a KIND_COLOR_PROFILE capability. From the first pixel
// every buffer knows its colorspace; a commit without a profile
// cap is not "sRGB implicit" -- it is a mistake the compositor
// must refuse rather than guess.
//
// This module is NOT the mint gate for KIND_COLOR_PROFILE
// (cap/kind_color_profile.pdx §1). This module is the CHECK the
// compositor runs on the argument list of a surface_commit RPC.
//
// =============================================================================
// SECTION 0  THE CHECK
// =============================================================================
//
// A surface_commit RPC's argument list carries an array of cap
// slot ids and their kinds. The check is:
//
//   (a) the argument list is non-empty
//   (b) exactly ONE cap in the list has kind == KIND_COLOR_PROFILE
//   (c) that cap's row is live (cp_tail_valid returns 1)
//
// Two profiles is refused as ambiguous (a commit that names two
// colorspaces is a bug); zero is refused as missing.
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFED80..0xFFFFED8F
// =============================================================================

module SurfaceCheck = structure {

  pub let SC_OK           : u64 = 0
  pub let SC_EMPTY_ARGS   : u64 = 0xFFFFED8F
  pub let SC_NO_PROFILE   : u64 = 0xFFFFED8E
  pub let SC_TWO_PROFILES : u64 = 0xFFFFED8D
  pub let SC_DEAD_PROFILE : u64 = 0xFFFFED8C
  pub let SC_BAD_ARG      : u64 = 0xFFFFED8B

  pub let SC_KIND_COLOR_PROFILE : u64 = 0x18F

  pub let mut _sc_stats : [u64; 4] = uninit @align(64)

  pub let SC_ST_CHECKS  : u64 = 0
  pub let SC_ST_PASSES  : u64 = 1
  pub let SC_ST_REFUSED : u64 = 2
  pub let SC_ST_NOPROF  : u64 = 3

  pub let sc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-005 (#1513): clear counters.",
      block: {
        lea r10, [rip + _sc_stats];
        xor rax, rax;
        xor rcx, rcx;
      sc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  sc_rs_loop;
        ret
      }
    }

  pub let sc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-005 (#1513): counter bump.",
      block: {
        cmp rdi, 4;
        jae sc_nt_out;
        lea r10, [rip + _sc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sc_nt_out:
        ret
      }
    }

  pub let sc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-005 (#1513): counter read.",
      block: {
        cmp rdi, 4;
        jae sc_st_zero;
        lea r10, [rip + _sc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sc_st_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_commit_check(kinds_ptr, rows_ptr, count) -> SC_OK | err.
  //
  // kinds_ptr[i] holds the kind of arg i; rows_ptr[i] holds the row
  // id if the arg is a KIND_COLOR_PROFILE (arbitrary else). count is
  // the length of both arrays. Both arrays are 8 bytes stride.
  pub let surface_commit_check : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kinds: u64) (rows: u64) (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-005 (#1513): P5 partial -- refuse commit without exactly one live KIND_COLOR_PROFILE. Seven-push discipline (rbx/r12/r13/r14/r15/rbp + sub rsp,8) keeps rsp%16 == 0 before every inner call.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, 0;
        call sc_note;

        cmp r14, 0;
        je  sc_scc_empty;

        xor rbx, rbx;                       // i
        xor r15, r15;                       // count of profiles
        xor rbp, rbp;                       // remembered row_id

      sc_scc_scan:
        cmp rbx, r14;
        jae sc_scc_done;
        mov rax, [r12 + rbx * 8];
        mov r11, 0x18F;
        cmp rax, r11;
        jne sc_scc_step;
        add r15, 1;
        cmp r15, 2;
        jae sc_scc_two;
        mov rbp, [r13 + rbx * 8];
      sc_scc_step:
        add rbx, 1;
        jmp sc_scc_scan;

      sc_scc_done:
        cmp r15, 0;
        je  sc_scc_noprof;

        // Validate that the one row_id is live.
        mov rdi, rbp;
        call cp_tail_valid;
        cmp rax, 0;
        je  sc_scc_dead;

        mov rdi, 1;
        call sc_note;
        xor rax, rax;
        jmp sc_scc_out;

      sc_scc_empty:
        mov rdi, 2;
        call sc_note;
        mov rax, 0xFFFFED8F;
        jmp sc_scc_out;
      sc_scc_two:
        mov rdi, 2;
        call sc_note;
        mov rax, 0xFFFFED8D;
        jmp sc_scc_out;
      sc_scc_noprof:
        mov rdi, 3;
        call sc_note;
        mov rax, 0xFFFFED8E;
        jmp sc_scc_out;
      sc_scc_dead:
        mov rdi, 2;
        call sc_note;
        mov rax, 0xFFFFED8C;

      sc_scc_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
