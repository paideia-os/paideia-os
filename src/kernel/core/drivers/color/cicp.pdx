// src/kernel/core/drivers/color/cicp.pdx -- G6.M1-002 (#1510)
//
// CICP triplet parser per ITU-T H.273 (Coding-Independent Code
// Points).  Three 8-bit fields carry a stream's colorspace identity:
//
//   colour_primaries        (§8.1)   -- chromaticity of R, G, B, W
//   transfer_characteristics (§8.2)  -- OETF/EOTF (sRGB, BT.709, PQ, HLG, ...)
//   matrix_coefficients     (§8.3)   -- YCbCr <-> RGB matrix
//
// This module is NOT the mint gate: cap/kind_color_profile.pdx owns
// the row + validators. This module is the byte-level parser that a
// user-side supervisor (compositor / codec) calls to validate + name
// the well-known combinations before minting.
//
// =============================================================================
// SECTION 0  WHAT THIS MODULE IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the PARSER + NAMED-COMBINATION TABLE for CICP triplets.
//
// It is NOT the ICC v4 parser (drivers/color/icc.pdx), NOT the
// mint gate (cap/kind_color_profile.pdx §1), NOT the transfer
// function evaluator (drivers/color/eotf.pdx).
//
// =============================================================================
// SECTION 1  IDENTITY OF WELL-KNOWN TRIPLETS
// =============================================================================
//
// The parser recognizes four named combinations the compositor
// handles natively:
//
//   sRGB               (1,  13, 0)     -- BT.709 primaries, sRGB TRC, RGB matrix
//   Display-P3         (12, 13, 0)     -- P3 D65, sRGB TRC, RGB matrix
//   Rec.709            (1,  1,  1)     -- BT.709 primaries, BT.709 TRC, YCbCr 601
//   Rec.2020 PQ HDR10  (9,  16, 9)     -- BT.2020 primaries, PQ TRC, YCbCr NCL
//   Rec.2020 HLG HDR   (9,  18, 9)     -- BT.2020 primaries, HLG TRC, YCbCr NCL
//
// Every other legal triplet returns CICP_NAME_UNKNOWN + the raw
// values -- the compositor can still render it, it just does not
// get a preset conversion path.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFED60..0xFFFFED6F
// =============================================================================

module Cicp = structure {

  // Colour primaries (H.273 §8.1).
  pub let CICP_C_RESERVED : u64 = 0
  pub let CICP_C_BT709    : u64 = 1
  pub let CICP_C_BT470M   : u64 = 4
  pub let CICP_C_BT470BG  : u64 = 5
  pub let CICP_C_BT601    : u64 = 6
  pub let CICP_C_BT2020   : u64 = 9
  pub let CICP_C_XYZ      : u64 = 10
  pub let CICP_C_P3D65    : u64 = 12
  pub let CICP_C_MAX      : u64 = 22

  // Transfer characteristics (H.273 §8.2).
  pub let CICP_T_BT709    : u64 = 1
  pub let CICP_T_UNSPEC   : u64 = 2
  pub let CICP_T_GAMMA22  : u64 = 4
  pub let CICP_T_GAMMA28  : u64 = 5
  pub let CICP_T_BT601    : u64 = 6
  pub let CICP_T_LINEAR   : u64 = 8
  pub let CICP_T_LOG100   : u64 = 9
  pub let CICP_T_SRGB     : u64 = 13
  pub let CICP_T_BT2020_10 : u64 = 14
  pub let CICP_T_BT2020_12 : u64 = 15
  pub let CICP_T_PQ       : u64 = 16
  pub let CICP_T_HLG      : u64 = 18
  pub let CICP_T_MAX      : u64 = 18

  // Matrix coefficients (H.273 §8.3).
  pub let CICP_M_IDENTITY : u64 = 0
  pub let CICP_M_BT709    : u64 = 1
  pub let CICP_M_UNSPEC   : u64 = 2
  pub let CICP_M_BT601    : u64 = 6
  pub let CICP_M_BT2020NCL : u64 = 9
  pub let CICP_M_BT2020CL  : u64 = 10
  pub let CICP_M_MAX       : u64 = 14

  // Named combinations recognized by the compositor.
  pub let CICP_NAME_UNKNOWN : u64 = 0
  pub let CICP_NAME_SRGB    : u64 = 1
  pub let CICP_NAME_P3      : u64 = 2
  pub let CICP_NAME_REC709  : u64 = 3
  pub let CICP_NAME_HDR10   : u64 = 4
  pub let CICP_NAME_HLG     : u64 = 5

  // Failure taxonomy -- 0xFFFFED60..0xFFFFED6F.
  pub let CICP_OK             : u64 = 0
  pub let CICP_BAD_COLOUR     : u64 = 0xFFFFED6F
  pub let CICP_BAD_TRANSFER   : u64 = 0xFFFFED6E
  pub let CICP_BAD_MATRIX     : u64 = 0xFFFFED6D
  pub let CICP_MALFORMED      : u64 = 0xFFFFED6C

  pub let mut _cicp_stats : [u64; 4] = uninit @align(64)

  pub let CICP_ST_PARSES : u64 = 0
  pub let CICP_ST_NAMED  : u64 = 1
  pub let CICP_ST_UNKNOWN : u64 = 2
  pub let CICP_ST_REFUSED : u64 = 3

  pub let cicp_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-002 (#1510): clear counters.",
      block: {
        lea r10, [rip + _cicp_stats];
        xor rax, rax;
        xor rcx, rcx;
      cicp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  cicp_rs_loop;
        ret
      }
    }

  pub let cicp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-002 (#1510): counter bump.",
      block: {
        cmp rdi, 4;
        jae cicp_nt_out;
        lea r10, [rip + _cicp_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cicp_nt_out:
        ret
      }
    }

  pub let cicp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-002 (#1510): counter read.",
      block: {
        cmp rdi, 4;
        jae cicp_st_zero;
        lea r10, [rip + _cicp_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cicp_st_zero:
        xor rax, rax;
        ret
      }
    }

  // cicp_colour_valid(c) -- 1 iff c in [1, 22] and non-zero.
  pub let cicp_colour_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-002 (#1510): 1 iff c in [1, 22].",
      block: {
        cmp rdi, 0;
        je  cicp_cv_no;
        mov r10, 22;
        cmp rdi, r10;
        ja  cicp_cv_no;
        mov rax, 1;
        ret;
      cicp_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cicp_transfer_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-002 (#1510): 1 iff t in [1, 18].",
      block: {
        cmp rdi, 0;
        je  cicp_tv_no;
        mov r10, 18;
        cmp rdi, r10;
        ja  cicp_tv_no;
        mov rax, 1;
        ret;
      cicp_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let cicp_matrix_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-002 (#1510): 1 iff m in [0, 14].",
      block: {
        mov r10, 14;
        cmp rdi, r10;
        ja  cicp_mv_no;
        mov rax, 1;
        ret;
      cicp_mv_no:
        xor rax, rax;
        ret
      }
    }

  // cicp_parse(colour, transfer, matrix) -> named-ord | err.
  // Returns CICP_NAME_* on happy path (including CICP_NAME_UNKNOWN
  // for a valid but unnamed triplet); returns a failure taxonomy on
  // a value out of range.
  pub let cicp_parse : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (c: u64) (t: u64) (m: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-002 (#1510): validate + name a CICP triplet. Five-push discipline (rbx/r12/r13/r14/r15) keeps rsp%16 == 0 before every inner call, matching this codebase's odd-parity convention.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        call cicp_colour_valid;
        cmp rax, 0;
        je  cicp_pa_bad_c;
        mov rdi, r13;
        call cicp_transfer_valid;
        cmp rax, 0;
        je  cicp_pa_bad_t;
        mov rdi, r14;
        call cicp_matrix_valid;
        cmp rax, 0;
        je  cicp_pa_bad_m;

        mov rdi, 0;
        call cicp_note;

        // Named combinations. Preserve the row order documented in §1.
        // sRGB (1, 13, 0)
        cmp r12, 1;
        jne cicp_pa_try_p3;
        cmp r13, 13;
        jne cicp_pa_try_rec709;
        cmp r14, 0;
        jne cicp_pa_try_rec709;
        mov rax, 1;
        jmp cicp_pa_named;

      cicp_pa_try_p3:
        // Display-P3 (12, 13, 0)
        cmp r12, 12;
        jne cicp_pa_try_hdr10;
        cmp r13, 13;
        jne cicp_pa_try_hdr10;
        cmp r14, 0;
        jne cicp_pa_try_hdr10;
        mov rax, 2;
        jmp cicp_pa_named;

      cicp_pa_try_rec709:
        // Rec.709 (1, 1, 1)
        cmp r12, 1;
        jne cicp_pa_try_hdr10;
        cmp r13, 1;
        jne cicp_pa_try_hdr10;
        cmp r14, 1;
        jne cicp_pa_try_hdr10;
        mov rax, 3;
        jmp cicp_pa_named;

      cicp_pa_try_hdr10:
        // Rec.2020 PQ HDR10 (9, 16, 9)
        cmp r12, 9;
        jne cicp_pa_try_hlg;
        cmp r13, 16;
        jne cicp_pa_try_hlg;
        cmp r14, 9;
        jne cicp_pa_try_hlg;
        mov rax, 4;
        jmp cicp_pa_named;

      cicp_pa_try_hlg:
        // Rec.2020 HLG (9, 18, 9)
        cmp r12, 9;
        jne cicp_pa_unknown;
        cmp r13, 18;
        jne cicp_pa_unknown;
        cmp r14, 9;
        jne cicp_pa_unknown;
        mov rax, 5;

      cicp_pa_named:
        mov r10, rax;
        mov rdi, 1;
        call cicp_note;
        mov rax, r10;
        jmp cicp_pa_out;

      cicp_pa_unknown:
        mov rdi, 2;
        call cicp_note;
        xor rax, rax;                       // CICP_NAME_UNKNOWN
        jmp cicp_pa_out;

      cicp_pa_bad_c:
        mov rdi, 3;
        call cicp_note;
        mov rax, 0xFFFFED6F;
        jmp cicp_pa_out;
      cicp_pa_bad_t:
        mov rdi, 3;
        call cicp_note;
        mov rax, 0xFFFFED6E;
        jmp cicp_pa_out;
      cicp_pa_bad_m:
        mov rdi, 3;
        call cicp_note;
        mov rax, 0xFFFFED6D;

      cicp_pa_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // cicp_named_to_primaries(name) -> PRIM_* (kind_color_profile).
  // Maps the named triplet to the compositor's primaries enum;
  // returns 0 on UNKNOWN.
  pub let cicp_named_to_primaries : (u64) -> u64 !{} @{} =
    fn (name: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M1-002 (#1510): named -> PRIM_ ordinal.",
      block: {
        cmp rdi, 1;
        je  cicp_np_srgb;
        cmp rdi, 2;
        je  cicp_np_p3;
        cmp rdi, 3;
        je  cicp_np_rec709;
        cmp rdi, 4;
        je  cicp_np_rec2020;
        cmp rdi, 5;
        je  cicp_np_rec2020;
        xor rax, rax;
        ret;
      cicp_np_srgb:
        mov rax, 1;
        ret;
      cicp_np_p3:
        mov rax, 2;
        ret;
      cicp_np_rec709:
        mov rax, 3;
        ret;
      cicp_np_rec2020:
        mov rax, 4;
        ret
      }
    }
}
