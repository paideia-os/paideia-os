// src/kernel/core/drivers/color/icc.pdx -- G6.M1-003 (#1511)
//
// ICC v4 profile parser (subset). Two decoding shapes suffice for
// nearly every real-world profile shipped in image and font files:
//
//   (1) Matrix/TRC       -- three-column matrix ('rXYZ','gXYZ','bXYZ')
//                            plus three tone-reproduction curves
//                            ('rTRC','gTRC','bTRC'). D50 white point.
//   (2) LUT A-to-B0      -- 'A2B0' tag with a multidimensional lookup
//                            (per-channel input curves, CLUT, output
//                            curves). Used by print/CMYK profiles and
//                            some display profiles for gamut mapping.
//
// This module is NOT the mint gate: kind_color_profile.pdx §1 owns
// the row. This module is the byte-level validator that the ring-3
// supervisor calls to prove an ICC blob is well-formed enough to
// stand behind a KIND_COLOR_PROFILE mint.
//
// =============================================================================
// SECTION 0  ICC v4 HEADER LAYOUT (128 bytes, big-endian)
// =============================================================================
//
//   [+0]  profile_size (u32)
//   [+4]  preferred_cmm (u32)
//   [+8]  profile_version (u32; high byte = major; must be >= 4 here)
//   [+12] profile_class (u32; ASCII, e.g. 'mntr' = display)
//   [+16] data_colour_space (u32; ASCII, e.g. 'RGB ')
//   [+20] PCS (u32; 'XYZ ' or 'Lab ')
//   [+24] creation_datetime (12 bytes)
//   [+36] magic (u32; must equal 'acsp' = 0x61637370)
//   ...
//   [+128] tag_count (u32) + tag_table
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFED70..0xFFFFED7F
// =============================================================================

module Icc = structure {

  // Magic and version bounds.
  pub let ICC_MAGIC_ACSP   : u64 = 0x61637370        // 'acsp'
  pub let ICC_VERSION_MIN  : u64 = 0x04000000        // v4.0.0
  pub let ICC_HEADER_BYTES : u64 = 128
  pub let ICC_MIN_BYTES    : u64 = 132               // header + tag_count

  // Shape ordinals.
  pub let ICC_SHAPE_NONE   : u64 = 0
  pub let ICC_SHAPE_MATRIX_TRC : u64 = 1
  pub let ICC_SHAPE_LUT_A2B0   : u64 = 2

  // Failure taxonomy -- 0xFFFFED70..0xFFFFED7F.
  pub let ICC_OK             : u64 = 0
  pub let ICC_TOO_SHORT      : u64 = 0xFFFFED7F
  pub let ICC_BAD_MAGIC      : u64 = 0xFFFFED7E
  pub let ICC_BAD_VERSION    : u64 = 0xFFFFED7D
  pub let ICC_SIZE_MISMATCH  : u64 = 0xFFFFED7C
  pub let ICC_NO_SHAPE       : u64 = 0xFFFFED7B
  pub let ICC_TAG_TABLE_OVERFLOW : u64 = 0xFFFFED7A

  pub let mut _icc_stats : [u64; 4] = uninit @align(64)

  pub let ICC_ST_PARSES  : u64 = 0
  pub let ICC_ST_MATRIX  : u64 = 1
  pub let ICC_ST_LUT     : u64 = 2
  pub let ICC_ST_REFUSED : u64 = 3

  pub let icc_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-003 (#1511): clear counters.",
      block: {
        lea r10, [rip + _icc_stats];
        xor rax, rax;
        xor rcx, rcx;
      icc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  icc_rs_loop;
        ret
      }
    }

  pub let icc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-003 (#1511): counter bump.",
      block: {
        cmp rdi, 4;
        jae icc_nt_out;
        lea r10, [rip + _icc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      icc_nt_out:
        ret
      }
    }

  pub let icc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-003 (#1511): counter read.",
      block: {
        cmp rdi, 4;
        jae icc_st_zero;
        lea r10, [rip + _icc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      icc_st_zero:
        xor rax, rax;
        ret
      }
    }

  // icc_read_be32(base_ptr, off) -> u32 zero-extended into rax.
  // Big-endian read of 4 bytes; the caller supplies base + offset
  // within an already-bounded blob (bounds are enforced by
  // icc_parse_header before any per-tag read).
  pub let icc_read_be32 : (u64, u64) -> u64 !{mem} @{} =
    fn (base: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-003 (#1511): big-endian u32 read via mov_b + pre-zero pattern per fs/pdxfs_lite/uuid.pdx §5 — mov_b writes only the low 8 bits, so xor r10, r10 before each load keeps the upper bits clean.",
      block: {
        mov r9, rdi;
        add r9, rsi;
        xor rax, rax;
        xor r10, r10;
        mov_b rax, [r9 + 0];
        shl rax, 8;
        mov_b r10, [r9 + 1];
        or  rax, r10;
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [r9 + 2];
        or  rax, r10;
        shl rax, 8;
        xor r10, r10;
        mov_b r10, [r9 + 3];
        or  rax, r10;
        ret
      }
    }

  // icc_parse_header(blob_ptr, blob_len) -> ICC_OK | err.
  // Validates the 128-byte v4 header: length >= ICC_MIN_BYTES,
  // magic == 'acsp', version >= 4.0.0, size field matches blob_len.
  pub let icc_parse_header : (u64, u64) -> u64 !{mem} @{} =
    fn (blob: u64) (blen: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-003 (#1511): validate ICC v4 header.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov r10, 132;
        cmp r13, r10;
        jb  icc_ph_short;

        // magic at +36 must equal 'acsp'
        mov rdi, r12;
        mov rsi, 36;
        call icc_read_be32;
        mov r11, 0x61637370;
        cmp rax, r11;
        jne icc_ph_magic;

        // version at +8; major byte at highest position (BE).
        mov rdi, r12;
        mov rsi, 8;
        call icc_read_be32;
        mov r11, rax;
        shr r11, 24;
        cmp r11, 4;
        jb  icc_ph_ver;

        // profile_size at +0 == blob_len.
        mov rdi, r12;
        mov rsi, 0;
        call icc_read_be32;
        cmp rax, r13;
        jne icc_ph_size;

        mov rdi, 0;
        call icc_note;
        xor rax, rax;
        jmp icc_ph_out;

      icc_ph_short:
        mov rdi, 3;
        call icc_note;
        mov rax, 0xFFFFED7F;
        jmp icc_ph_out;
      icc_ph_magic:
        mov rdi, 3;
        call icc_note;
        mov rax, 0xFFFFED7E;
        jmp icc_ph_out;
      icc_ph_ver:
        mov rdi, 3;
        call icc_note;
        mov rax, 0xFFFFED7D;
        jmp icc_ph_out;
      icc_ph_size:
        mov rdi, 3;
        call icc_note;
        mov rax, 0xFFFFED7C;

      icc_ph_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // icc_detect_shape(blob_ptr, blob_len) -> ICC_SHAPE_* | err.
  // Walks the tag table looking for 'rXYZ','gXYZ','bXYZ' (matrix/TRC)
  // or 'A2B0' (LUT A-to-B0). Returns the first shape it finds; if
  // no shape tag is present, returns ICC_NO_SHAPE.
  pub let icc_detect_shape : (u64, u64) -> u64 !{mem} @{} =
    fn (blob: u64) (blen: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M1-003 (#1511): find first shape tag ('rXYZ' or 'A2B0').",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        mov rsi, r13;
        call icc_parse_header;
        cmp rax, 0;
        jne icc_ds_out;

        // tag_count at +128.
        mov rdi, r12;
        mov rsi, 128;
        call icc_read_be32;
        mov r14, rax;

        // Ensure tag_count * 12 + 132 <= blob_len.
        mov rax, r14;
        imul rax, rax, 12;
        add rax, 132;
        cmp rax, r13;
        ja  icc_ds_overflow;

        xor r15, r15;                       // i
      icc_ds_scan:
        cmp r15, r14;
        jae icc_ds_none;
        mov rax, r15;
        imul rax, rax, 12;
        add rax, 132;                       // offset of tag[i].sig
        mov rdi, r12;
        mov rsi, rax;
        call icc_read_be32;
        // rXYZ = 0x7258595A
        mov r11, 0x7258595A;
        cmp rax, r11;
        je  icc_ds_matrix;
        // A2B0 = 0x41324230
        mov r11, 0x41324230;
        cmp rax, r11;
        je  icc_ds_lut;
        add r15, 1;
        jmp icc_ds_scan;

      icc_ds_matrix:
        mov rdi, 1;
        call icc_note;
        mov rax, 1;
        jmp icc_ds_out;
      icc_ds_lut:
        mov rdi, 2;
        call icc_note;
        mov rax, 2;
        jmp icc_ds_out;
      icc_ds_none:
        mov rdi, 3;
        call icc_note;
        mov rax, 0xFFFFED7B;
        jmp icc_ds_out;
      icc_ds_overflow:
        mov rdi, 3;
        call icc_note;
        mov rax, 0xFFFFED7A;

      icc_ds_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
