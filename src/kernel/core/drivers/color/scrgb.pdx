// src/kernel/core/drivers/color/scrgb.pdx -- G6.M2-003 (#1516)
//
// scRGB-linear composition space. All compositor blending happens in
// linear light with D65 white and BT.709 primaries, but the value
// range is EXTENDED: negative values represent wide-gamut colors
// outside the sRGB primary triangle, and values > 1.0 represent
// highlights above SDR white. This lets a compositor composite a
// wide-gamut / HDR buffer onto an SDR canvas WITHOUT truncating
// out-of-gamut colors -- the truncation is deferred to the final
// display-transform stage, where the reference display is known.
//
// Storage: fp16 (IEEE 754 half-precision) three-channel, packed
// {R, G, B} as three consecutive u16 values in one u64 word (with
// 16 bits reserved). The compositor reads and writes these words;
// the shader unpacks + multiplies + repacks per pixel.
//
// This module is NOT the shader. It is the fp16 packing/unpacking
// TABLE + gamut-boundary predicates the compositor uses to reason
// about a scRGB-linear pixel without touching GPU state.
//
// =============================================================================
// SECTION 0  PIXEL LAYOUT
// =============================================================================
//
//   [15: 0] R (fp16)
//   [31:16] G (fp16)
//   [47:32] B (fp16)
//   [63:48] reserved (0)
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFEDB0..0xFFFFEDBF
// =============================================================================

module Scrgb = structure {

  pub let SCRGB_OK             : u64 = 0
  pub let SCRGB_BAD_CHANNEL    : u64 = 0xFFFFEDBF
  pub let SCRGB_BAD_PIXEL      : u64 = 0xFFFFEDBE
  pub let SCRGB_OUT_OF_GAMUT   : u64 = 0xFFFFEDBD

  // fp16 special constants (bit patterns).
  pub let FP16_ZERO       : u64 = 0x0000
  pub let FP16_ONE        : u64 = 0x3C00
  pub let FP16_NEG_ONE    : u64 = 0xBC00
  pub let FP16_MAX_NORMAL : u64 = 0x7BFF
  pub let FP16_NEG_MAX    : u64 = 0xFBFF
  pub let FP16_NAN_MASK   : u64 = 0x7C00

  pub let mut _scrgb_stats : [u64; 4] = uninit @align(64)

  pub let SCRGB_ST_PACKS   : u64 = 0
  pub let SCRGB_ST_UNPACKS : u64 = 1
  pub let SCRGB_ST_INGAMUT : u64 = 2
  pub let SCRGB_ST_OUTGAMUT : u64 = 3

  pub let scrgb_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-003 (#1516): clear counters.",
      block: {
        lea r10, [rip + _scrgb_stats];
        xor rax, rax;
        xor rcx, rcx;
      scrgb_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  scrgb_rs_loop;
        ret
      }
    }

  pub let scrgb_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-003 (#1516): counter bump.",
      block: {
        cmp rdi, 4;
        jae scrgb_nt_out;
        lea r10, [rip + _scrgb_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      scrgb_nt_out:
        ret
      }
    }

  pub let scrgb_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-003 (#1516): counter read.",
      block: {
        cmp rdi, 4;
        jae scrgb_st_zero;
        lea r10, [rip + _scrgb_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      scrgb_st_zero:
        xor rax, rax;
        ret
      }
    }

  // scrgb_pack(r, g, b) -> packed u64.
  // Each channel is a 16-bit fp16 bit pattern (caller-supplied); high
  // 16 bits of each argument must be zero.
  pub let scrgb_pack : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (r: u64) (g: u64) (b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-003 (#1516): pack {R, G, B} fp16 into u64.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  scrgb_pk_bad;
        cmp r13, r10;
        ja  scrgb_pk_bad;
        cmp r14, r10;
        ja  scrgb_pk_bad;

        mov rax, r12;
        and rax, 0xFFFF;
        mov r10, r13;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, r14;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        jmp scrgb_pk_out;

      scrgb_pk_bad:
        mov rax, 0xFFFFEDBF;

      scrgb_pk_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // scrgb_unpack_channel(pixel, ch) -> fp16 bit pattern (rax low 16).
  // ch: 0 = R, 1 = G, 2 = B.
  pub let scrgb_unpack_channel : (u64, u64) -> u64 !{mem} @{} =
    fn (px: u64) (ch: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-003 (#1516): unpack one channel from a scRGB pixel word.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov r10, 3;
        cmp r13, r10;
        jae scrgb_un_bad;

        mov rax, r12;
        cmp r13, 0;
        je  scrgb_un_r;
        cmp r13, 1;
        je  scrgb_un_g;
        // b
        shr rax, 32;
        and rax, 0xFFFF;
        jmp scrgb_un_out;
      scrgb_un_r:
        and rax, 0xFFFF;
        jmp scrgb_un_out;
      scrgb_un_g:
        shr rax, 16;
        and rax, 0xFFFF;
        jmp scrgb_un_out;

      scrgb_un_bad:
        mov rax, 0xFFFFEDBF;

      scrgb_un_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // scrgb_in_gamut(pixel) -> 1 iff every channel is in [0.0, 1.0].
  // fp16 [0.0, 1.0] corresponds to bit patterns [0x0000, 0x3C00]
  // exclusive of sign bit. A negative or > 1.0 channel means the
  // pixel is outside the sRGB gamut; the compositor still stores it
  // linearly.
  pub let scrgb_in_gamut : (u64) -> u64 !{mem} @{} =
    fn (px: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-003 (#1516): 1 iff every channel in [0.0, 1.0]. Three-push discipline (rbx/r12/r13) keeps rsp%16 == 0 before every inner call, matching this codebase's odd-parity convention.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        xor rbx, rbx;
      scrgb_ig_loop:
        cmp rbx, 3;
        jae scrgb_ig_yes;
        mov rdi, r12;
        mov rsi, rbx;
        call scrgb_unpack_channel;
        mov r13, rax;
        // sign bit set -> negative -> out.
        mov r10, r13;
        mov r11, 0x8000;
        and r10, r11;
        cmp r10, 0;
        jne scrgb_ig_no;
        // magnitude > 0x3C00 -> above 1.0.
        mov r10, 0x3C00;
        cmp r13, r10;
        ja  scrgb_ig_no;
        add rbx, 1;
        jmp scrgb_ig_loop;

      scrgb_ig_yes:
        mov rdi, 2;
        call scrgb_note;
        mov rax, 1;
        jmp scrgb_ig_out;
      scrgb_ig_no:
        mov rdi, 3;
        call scrgb_note;
        xor rax, rax;

      scrgb_ig_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
