// src/kernel/core/drivers/color/eotf.pdx -- G6.M2-002 (#1515)
//
// EOTF (Electro-Optical Transfer Function) / OETF (Opto-Electrical
// Transfer Function) pipeline. Four transfer curves the compositor
// applies at the encode/decode boundary:
//
//   sRGB     -- IEC 61966-2-1 piecewise (linear near 0, ~gamma 2.4)
//   PQ       -- SMPTE ST 2084 (10000 cd/m^2 peak)
//   HLG      -- ITU-R BT.2100 Hybrid Log-Gamma
//   DV       -- Dolby Vision (proprietary; hosted as pass-through
//               ordinal until the vendor blob authority lands)
//
// This module is NOT a floating-point library. Coefficient tables
// are Q16.16 fixed-point piecewise-linear approximations sampled at
// 65 stops; the shader interpolates. The compositor demands
// bit-exactness on a synthetic gradient (see the witness).
//
// =============================================================================
// SECTION 0  TABLE SHAPE
// =============================================================================
//
// One curve = 65 samples (u64 Q16.16 each) + 1 header word (curve
// ordinal), stride 66 words = 528 bytes per curve.
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFEDA0..0xFFFFEDAF
// =============================================================================

module Eotf = structure {

  pub let EOTF_SRGB : u64 = 1
  pub let EOTF_PQ   : u64 = 2
  pub let EOTF_HLG  : u64 = 3
  pub let EOTF_DV   : u64 = 4
  pub let EOTF_MAX  : u64 = 4

  pub let OETF_SRGB : u64 = 1
  pub let OETF_PQ   : u64 = 2
  pub let OETF_HLG  : u64 = 3
  pub let OETF_DV   : u64 = 4

  pub let EOTF_OK             : u64 = 0
  pub let EOTF_BAD_ORD        : u64 = 0xFFFFEDAF
  pub let EOTF_BAD_INDEX      : u64 = 0xFFFFEDAE
  pub let EOTF_BAD_SAMPLE     : u64 = 0xFFFFEDAD

  pub let EOTF_SAMPLES_PER_CURVE : u64 = 65
  pub let EOTF_ROW_WORDS         : u64 = 66      // 65 samples + 1 hdr

  // Four EOTF curves + four OETF curves = 8 * 66 = 528 words.
  pub let mut _eotf_tables : [u64; 528] = uninit @align(64)
  pub let mut _eotf_stats  : [u64; 4]   = uninit @align(64)

  pub let EOTF_ST_INSTALLS : u64 = 0
  pub let EOTF_ST_SAMPLES  : u64 = 1
  pub let EOTF_ST_REFUSED  : u64 = 2
  pub let EOTF_ST_RESETS   : u64 = 3

  pub let eotf_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-002 (#1515): clear curve tables + counters.",
      block: {
        lea r10, [rip + _eotf_tables];
        xor rax, rax;
        xor rcx, rcx;
      eotf_rs_tbl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 528;
        jb  eotf_rs_tbl;
        lea r10, [rip + _eotf_stats];
        xor rcx, rcx;
      eotf_rs_stat:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  eotf_rs_stat;
        ret
      }
    }

  pub let eotf_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-002 (#1515): counter bump.",
      block: {
        cmp rdi, 4;
        jae eotf_nt_out;
        lea r10, [rip + _eotf_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      eotf_nt_out:
        ret
      }
    }

  pub let eotf_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-002 (#1515): counter read.",
      block: {
        cmp rdi, 4;
        jae eotf_st_zero;
        lea r10, [rip + _eotf_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      eotf_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let eotf_ord_valid : (u64) -> u64 !{} @{} =
    fn (o: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M2-002 (#1515): 1 iff o in [1, 4].",
      block: {
        cmp rdi, 0;
        je  eotf_ov_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  eotf_ov_no;
        mov rax, 1;
        ret;
      eotf_ov_no:
        xor rax, rax;
        ret
      }
    }

  // eotf_curve_base(kind, ord) -> [u64] ptr (rax).
  // kind: 0 = EOTF (decode), 1 = OETF (encode).
  pub let eotf_curve_base : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (ord: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-002 (#1515): compute base pointer for a curve slot. Three-push discipline for rsp%16 == 0 before inner call.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        cmp r12, 1;
        ja  eotf_cb_zero;
        mov rdi, r13;
        call eotf_ord_valid;
        cmp rax, 0;
        je  eotf_cb_zero;
        // idx = kind * 4 + (ord-1); base = tables + idx * 66 * 8.
        mov rax, r12;
        imul rax, rax, 4;
        add rax, r13;
        sub rax, 1;
        imul rax, rax, 528;
        lea r10, [rip + _eotf_tables];
        add r10, rax;
        mov rax, r10;
        jmp eotf_cb_out;
      eotf_cb_zero:
        xor rax, rax;
      eotf_cb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // eotf_install(kind, ord, samples_ptr) -> ok | err.
  // Copies 65 samples (u64 each) from caller into the curve slot.
  pub let eotf_install : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (ord: u64) (samples: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-002 (#1515): install a 65-sample curve into (kind, ord) slot. Five-push discipline for rsp%16 == 0 before inner calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rdi, r12;
        mov rsi, r13;
        call eotf_curve_base;
        cmp rax, 0;
        je  eotf_in_bad;
        mov r10, rax;

        // Header word = ord.
        mov [r10 + 0], r13;
        xor rbx, rbx;
      eotf_in_copy:
        mov rax, [r14 + rbx * 8];
        mov [r10 + 8 + rbx * 8], rax;
        add rbx, 1;
        cmp rbx, 65;
        jb  eotf_in_copy;

        mov rdi, 0;
        call eotf_note;
        xor rax, rax;
        jmp eotf_in_out;
      eotf_in_bad:
        mov rdi, 2;
        call eotf_note;
        mov rax, 0xFFFFEDAF;
      eotf_in_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // eotf_sample(kind, ord, idx) -> Q16.16 sample | 0.
  pub let eotf_sample : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (ord: u64) (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M2-002 (#1515): read one sample of a curve.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r14, 65;
        jae eotf_sa_zero;
        mov rdi, r12;
        mov rsi, r13;
        call eotf_curve_base;
        cmp rax, 0;
        je  eotf_sa_zero;
        mov r10, rax;
        mov rax, [r10 + 8 + r14 * 8];
        jmp eotf_sa_out;
      eotf_sa_zero:
        xor rax, rax;
      eotf_sa_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
