// src/kernel/core/drivers/gfx/bochs_stdvga/lfb_map.pdx -- R101.M2-003
//
// Map the Bochs/stdvga LFB (BAR0 PA) into the kernel address space
// with PAT slot 4 = WC.
//
// Reuses core/mm/mmio_map.pdx's platform_mmio_map (PML4[321], 4 KiB-
// per-page WC/UC mapping via aspace_map) rather than open-coding a
// fresh mapper: platform_mmio_map already handles the PVH boot huge-
// page identity-overlap case (MAP_HUGE on first iteration -> return
// identity VA), which is EVERY QEMU `-kernel` boot in the smoke matrix.
//
// This module is a THIN WRAPPER: it looks up _bochs_stdvga_devices[0]
// for the BAR0 PA + probed size, invokes platform_mmio_map(pa, size,
// MMIO_WC=1), stashes the returned VA into the device record's
// bar0_lfb_va slot at +40, and returns the VA.
//
// -----------------------------------------------------------------------------
// Ordering vs modeset
// -----------------------------------------------------------------------------
//
// lfb_map runs AFTER bochs_stdvga_probe (which populates the device
// record) and AFTER bochs_stdvga_modeset (which enables the LFB in
// VBE-DISPI's ENABLE register with LFB_ENABLED). Before ENABLE, reads
// from BAR0 return VGA-legacy content; after ENABLE, they alias to
// the framebuffer's linear pixel array in the format the modeset
// programmed. This mapper does NOT depend on that -- the PTE
// arrangement is oblivious to what's on the other end -- but the
// caller is expected to modeset first for the write-and-read-back
// witness to see the pixels it wrote.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
// "r101 bochs lfb map ok va=<hex>" (klog_s1_x1).

module LfbMap = structure {

  pub let bochs_lfb_map_ok_msg : [u8; 22] = "r101 bochs lfb map ok\0"
  pub let bochs_k_va           : [u8; 3]  = "va\0"

  // ==========================================================================
  // bochs_lfb_map() -> u64
  //
  // Returns the kernel VA where the LFB is mapped (nonzero on success),
  // or 0 if no Bochs device is present (skip) / mapping failed.
  //
  // Register plan: rbx = &_bochs_stdvga_devices[0], r12 = bar0_lfb_pa,
  // r13 = bar0_size, r14 = returned VA.
  //
  // 4-push prologue (rbx/r12/r13/r14) leaves rsp%16 == 0 for nested
  // platform_mmio_map / klog_s1_x1 calls (entry rsp%16==8, +32 -> %16==0).
  // ==========================================================================
  pub let bochs_lfb_map : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R101.M2-003: map the BAR0 LFB into the kernel address space via platform_mmio_map (MMIO_WC=1 -> PAT slot 4 = WC, same selector fb_map_lfb uses at PML4[320] for the R23 GOP LFB; this landing uses PML4[321] via platform_mmio_map's VA bump cursor). Loops: (a) if _bochs_stdvga_device_count == 0, return 0 (nothing to map); (b) read _bochs_stdvga_devices[0] BAR0/size, call platform_mmio_map(bar0_pa, size, MMIO_WC), receive VA in rax; (c) stash VA into device[0]+40; (d) emit klog_s1_x1 fingerprint with the VA. Reused if bochs_stdvga_probe returned 0 (skip fingerprint AND skip lfb write). Register plan: 4-push (rbx/r12/r13/r14) prologue -- rbx = &device[0], r12 = bar0_pa, r13 = size, r14 = mapped VA. Labels prefixed bochs_lm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        // (a) Skip if no device.
        mov rax, [rip + _bochs_stdvga_device_count];
        cmp rax, 0;
        je  bochs_lm_skip;

        // Compute rbx = &_bochs_stdvga_devices[0].
        lea rbx, [rip + _bochs_stdvga_devices];

        // Read bar0_pa (u64 @+8) + bar0_size (u64 @+24).
        mov r12, [rbx + 8];
        mov r13, [rbx + 24];

        cmp r12, 0;
        je  bochs_lm_skip;
        cmp r13, 0;
        je  bochs_lm_skip;

        // (b) Map. platform_mmio_map(pa, size, cache_type=1 for MMIO_WC).
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 1;                              // MMIO_WC
        call platform_mmio_map;
        cmp rax, 0;
        je  bochs_lm_skip;
        mov r14, rax;                            // r14 = VA

        // (c) Stash into device[0]+40.
        mov [rbx + 40], r14;

        // (d) Fingerprint.
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + bochs_lfb_map_ok_msg];
        lea rcx, [rip + bochs_k_va];
        mov r8, r14;
        call klog_s1_x1;

        mov rax, r14;
        jmp bochs_lm_out;

      bochs_lm_skip:
        xor rax, rax;

      bochs_lm_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
