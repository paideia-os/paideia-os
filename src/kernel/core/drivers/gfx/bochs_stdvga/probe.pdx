// src/kernel/core/drivers/gfx/bochs_stdvga/probe.pdx -- R101.M2-001
//
// Bochs/QEMU stdvga PCI probe.
//
// After pci_enumerate_all (core/pci/enum.pdx) populates _pci_devices,
// this probe filters that list for the QEMU-published Bochs display
// vendor/device pair:
//
//   vendor_id  = 0x1234 (QEMU Bochs display)
//   device_id  = 0x1111 (Bochs display 2)
//   class_code = 0x03 / subclass = 0x00 (display / VGA-compatible) -- implied
//                 by the vendor/device pair; not gated on to keep the match
//                 short and mirror rtl8139_probe's shape.
//
// The device exposes two BARs of interest:
//
//   BAR0 (config +0x10) -- linear framebuffer (LFB), 32-bit MEM BAR.
//                          Size varies with the host QEMU build (typical
//                          16 MiB); mapped WC via platform_mmio_map at
//                          R101.M2-003 (lfb_map.pdx).
//   BAR2 (config +0x18) -- MMIO aperture holding the VBE-DISPI register
//                          set at offset 0x500 (index register) / 0x502
//                          (data register). See design/graphics/r101-
//                          kernel-plan.md §7 for why the modern QEMU
//                          stdvga forces MMIO-only access (paideia-as
//                          has no `in`/`out` I/O port encoder yet, so
//                          the legacy 0x1CE/0x1CF I/O port pair is not
//                          reachable from this tree). BAR2 is a 32-bit
//                          MEM BAR at least 4 KiB.
//
// -----------------------------------------------------------------------------
// _bochs_stdvga_devices record layout (48 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  _pad0
//   +6    u16 _pad1
//   +8    u64 bar0_lfb_pa       // BAR0 (LFB) physical base
//   +16   u64 bar2_mmio_pa      // BAR2 (VBE-DISPI MMIO) physical base
//   +24   u64 bar0_size         // LFB size (probed via BAR0 mask, or QEMU
//                               // default 16 MiB if the mask probe is
//                               // deferred to a later milestone)
//   +32   u64 bar2_mmio_va      // BAR2 kernel VA (mapped by modeset.pdx)
//   +40   u64 bar0_lfb_va       // BAR0 kernel VA (mapped by lfb_map.pdx)
//
// -----------------------------------------------------------------------------
// BOCHS_STDVGA_MAX_DEVS = 1
// -----------------------------------------------------------------------------
//
// QEMU emulates at most one Bochs display device per VM (a second
// -vga std would collide). The R101 witness pins to slot 0.
//
// -----------------------------------------------------------------------------
// LFB size probe
// -----------------------------------------------------------------------------
//
// Standard PCI BAR-size probe: save BAR0, write all-1s, read back the
// masked value, restore BAR0. QEMU's stdvga typically reports 16 MiB
// (0xFF000000 mask -> 0x01000000 = 16 MiB) as of the QEMU 8+ builds
// the smoke matrix uses. Some older QEMU versions report 32 MiB or
// 64 MiB; whatever the host reports, the mask arithmetic returns the
// correct value.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.24.x)
// -----------------------------------------------------------------------------
//
//   G1: sized MMIO stores go through mov_b / mov_w / mov_d.
//   G4: full-register compares; no `add reg, [mem]`, no `cmp reg, [mem]`.
//   No mov_bzx / mov_wzx: byte / word loads use `xor rax,rax; mov_b/w
//       rax, [mem]` (matches rtl8139/probe.pdx precedent).
//
// Reserved-label discipline: labels prefixed `bochs_p_`.

module Probe = structure {

  pub let BOCHS_VENDOR   : u64 = 0x1234
  pub let BOCHS_DEVICE   : u64 = 0x1111

  pub let BOCHS_MAX_DEVS  : u64 = 1
  pub let BOCHS_DEV_BYTES : u64 = 48

  // Default LFB size if the BAR-size probe path is skipped (typical
  // QEMU stdvga is 16 MiB).
  pub let BOCHS_DEFAULT_LFB_SIZE : u64 = 0x1000000

  // Fingerprint (all-lowercase, no OK_TOK trigger). "r101 bochs probe ok"
  pub let bochs_probe_ok_msg : [u8; 20] = "r101 bochs probe ok\0"

  // Canonical static slots.
  pub let mut _bochs_stdvga_devices      : [u64; 6] = uninit @align(8)
  pub let mut _bochs_stdvga_device_count : u64      = 0

  // ==========================================================================
  // bochs_stdvga_probe() -> u64
  //
  // Returns the count of Bochs display devices discovered (0 or 1).
  //
  // Register plan:
  //   rbx = i (loop index into _pci_devices)
  //   r12 = _pci_device_count (loaded once)
  //   r13 = j (write index into _bochs_stdvga_devices; 0..1)
  //   r14 = &_pci_devices[i] (recomputed each iter)
  //   r15 = &_bochs_stdvga_devices[j] (recomputed on match)
  //
  // Scratch layout ([rsp+0..24] for seg/bus/dev/fn, [rsp+32] for
  // bar0 staging, [rsp+40] for bar2 staging).
  //
  // 6 pushes = 48 B; entry rsp%16==8 -> 56; sub rsp,56 (48 scratch +
  // 8 align) -> 112, %16==0.
  // ==========================================================================
  pub let bochs_stdvga_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R101.M2-001: Bochs/QEMU stdvga PCI probe. Structurally identical to rtl8139_probe with the vendor/device match retargeted to (0x1234, 0x1111) and BAR strategy widened to BAR0 (LFB, 32-bit MEM) + BAR2 (MMIO for VBE-DISPI registers, 32-bit MEM). No I/O ports are consumed because paideia-as v0.24.x has no `in`/`out` primitive family -- BAR2 MMIO is the ONLY register interface at this landing (design/graphics/r101-kernel-plan.md §7). Body: (1) 6-push callee-save prologue (rbx, rbp, r12-r15) -- 48 B; entry rsp%16==8 -> 56; sub rsp,56 (48 scratch + 8 align) -> 112, %16==0. Scratch layout: [rsp+0..24] seg/bus/dev/fn; [rsp+32] bar0 staging; [rsp+40] bar2 staging. (2) Init j=r13=0; load _pci_device_count into r12; init i=rbx=0. (3) Per-iteration bounds check. (4) r14 = _pci_devices + (i << 5). (5) vendor_id (u16 @+8) compared against 0x1234; skip if mismatch. (6) device_id (u16 @+10) compared against 0x1111; skip if mismatch. (7) Overflow guard: skip once j >= BOCHS_MAX_DEVS (=1). (8) Stash BDF into [rsp+0..24]. (9) Read BAR0 via pci_config_read_u32(seg, bus, dev, fn, 0x10); expected 32-bit MEM (bit 0 == 0). Mask ~0xF into bar0_lfb_pa; stash [rsp+32]. (10) Read BAR2 via pci_config_read_u32(seg, bus, dev, fn, 0x18); expected 32-bit MEM. Mask ~0xF into bar2_mmio_pa; stash [rsp+40]. If bit 0 == 1 on either BAR (unexpected: I/O), skip. (11) Populate _bochs_stdvga_devices[j] at r15 with seg/bus/dev/fn/pad0/pad1 + bar0/bar2 + BOCHS_DEFAULT_LFB_SIZE (real BAR-size probe deferred to a later milestone -- QEMU stdvga reports 16 MiB in practice; a wrong ceiling here only shrinks the mapped range, does not affect correctness at 1024x768x32 = 3 MiB). (12) j += 1; advance i; loop. (13) On loop exit: publish _bochs_stdvga_device_count = r13. (14) Emit klog_s1_d1(INFO, DRV_, bochs_probe_ok_msg, k_n, count). (15) Return r13. Reserved-label posture: labels prefixed `bochs_p_`. Every nested callee (pci_config_read_u32, klog_s1_d1) preserves rbx/rbp/r12-r15 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;

        xor r13, r13;                            // j = 0
        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;                            // i = 0

      bochs_p_loop:
        cmp rbx, r12;
        jae bochs_p_done;

        mov rax, rbx;
        shl rax, 5;                              // record stride 32
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // vendor_id (u16 @+8)
        xor rax, rax;
        mov_w rax, [r14 + 8];
        cmp rax, 0x1234;
        jne bochs_p_next;

        // device_id (u16 @+10)
        xor rax, rax;
        mov_w rax, [r14 + 10];
        cmp rax, 0x1111;
        jne bochs_p_next;

        // Overflow guard (BOCHS_MAX_DEVS = 1)
        cmp r13, 1;
        jae bochs_p_next;

        // Stash BDF.
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;                      // seg
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;                      // bus
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;                     // dev
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;                     // fn

        // BAR0 (config +0x10) - LFB.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x10;
        call pci_config_read_u32;

        // Verify MEM BAR (bit 0 == 0); else skip (not expected on stdvga).
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne bochs_p_next;
        and rax, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 32], rax;                     // bar0_lfb_pa

        // BAR2 (config +0x18) - MMIO for VBE-DISPI registers.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x18;
        call pci_config_read_u32;

        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne bochs_p_next;
        and rax, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 40], rax;                     // bar2_mmio_pa

        // Populate _bochs_stdvga_devices[j].
        mov r11, r13;
        mov rax, r11;
        shl rax, 5;
        mov r10, r11;
        shl r10, 4;
        add rax, r10;                            // j * 48
        lea r15, [rip + _bochs_stdvga_devices];
        add r15, rax;

        mov r10, [rsp + 0];                      // seg
        mov_w [r15 + 0], r10;

        mov r10, [rsp + 8];                      // bus
        mov_b [r15 + 2], r10;

        mov r10, [rsp + 16];                     // dev
        mov_b [r15 + 3], r10;

        mov r10, [rsp + 24];                     // fn
        mov_b [r15 + 4], r10;

        xor r10, r10;
        mov_b [r15 + 5], r10;                    // pad0
        mov_w [r15 + 6], r10;                    // pad1

        mov r10, [rsp + 32];                     // bar0_lfb_pa
        mov [r15 + 8], r10;

        mov r10, [rsp + 40];                     // bar2_mmio_pa
        mov [r15 + 16], r10;

        mov r10, 0x1000000;                      // BOCHS_DEFAULT_LFB_SIZE (16 MiB)
        mov [r15 + 24], r10;

        xor r10, r10;
        mov [r15 + 32], r10;                     // bar2_mmio_va (populated by modeset)
        mov [r15 + 40], r10;                     // bar0_lfb_va (populated by lfb_map)

        add r13, 1;

      bochs_p_next:
        add rbx, 1;
        jmp bochs_p_loop;

      bochs_p_done:
        mov [rip + _bochs_stdvga_device_count], r13;

        // Fingerprint: emitted whether count is 0 or 1 (the count value
        // tells the caller which path fired).
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + bochs_probe_ok_msg];
        lea rcx, [rip + k_n];
        mov r8, r13;
        call klog_s1_d1;

        mov rax, r13;

        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
