// src/kernel/core/drivers/gfx/bochs_stdvga/probe.pdx -- R101.M2-001 +
//   R111.M2-006 (paideia-os #2358) probe-table refactor.
//
// Bochs/QEMU stdvga PCI probe.
//
// After pci_enumerate_all_segments (core/pci/enum.pdx) populates
// _pci_devices, this probe consults pci_probe_table_find with the
// packed (vid<<16)|did key for the QEMU-published Bochs display pair:
//
//   vendor_id  = 0x1234 (QEMU Bochs display)
//   device_id  = 0x1111 (Bochs display 2)
//   class_code = 0x03 / subclass = 0x00 (display / VGA-compatible) -- implied
//                 by the vendor/device pair; not gated on to keep the match
//                 short and mirror rtl8139_probe's shape.
//
// R111.M2-006 (#2358) rewrites the pre-existing walk-of-_pci_devices
// body into a single pci_probe_table_find call. The record layout the
// probe reads (BDF at u16/u8 offsets 0/2/3/4 and vid/did at u16 offsets
// 8/10) is unchanged; only the lookup mechanism moves from an inline
// loop into the shared helper in core/pci/enum.pdx §pci_probe_table_find.
// This means every driver probe now consults exactly one table (the
// enum-published _pci_devices) via one API, and adding a new driver
// costs one call + the BAR-read + record-population tail.
//
// The device exposes two BARs of interest:
//
//   BAR0 (config +0x10) -- linear framebuffer (LFB), 32-bit MEM BAR.
//                          Size varies with the host QEMU build (typical
//                          16 MiB); mapped WC via platform_mmio_map at
//                          R101.M2-003 (lfb_map.pdx).
//   BAR2 (config +0x18) -- MMIO aperture holding the VBE-DISPI register
//                          set at offset 0x500 (index register) / 0x502
//                          (data register). See design/graphics/r101-
//                          kernel-plan.md §7 for why the modern QEMU
//                          stdvga forces MMIO-only access (paideia-as
//                          has no `in`/`out` I/O port encoder yet, so
//                          the legacy 0x1CE/0x1CF I/O port pair is not
//                          reachable from this tree). BAR2 is a 32-bit
//                          MEM BAR at least 4 KiB.
//
// -----------------------------------------------------------------------------
// _bochs_stdvga_devices record layout (48 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  _pad0
//   +6    u16 _pad1
//   +8    u64 bar0_lfb_pa       // BAR0 (LFB) physical base
//   +16   u64 bar2_mmio_pa      // BAR2 (VBE-DISPI MMIO) physical base
//   +24   u64 bar0_size         // LFB size (probed via BAR0 mask, or QEMU
//                               // default 16 MiB if the mask probe is
//                               // deferred to a later milestone)
//   +32   u64 bar2_mmio_va      // BAR2 kernel VA (mapped by modeset.pdx)
//   +40   u64 bar0_lfb_va       // BAR0 kernel VA (mapped by lfb_map.pdx)
//
// -----------------------------------------------------------------------------
// R111.M2-006 fingerprints
// -----------------------------------------------------------------------------
//
// In addition to the pre-existing device-count rollup ("r101 bochs
// probe ok N=<count>") the probe now emits one of:
//
//   BOCHS PROBE FOUND vid=<hex> did=<hex> bdf=<hex>   (match — one line)
//   BOCHS PROBE NONE                                   (no match)
//
// The bdf value packs (seg<<32)|(bus<<16)|(dev<<8)|fn so a single
// hex-formatted u64 reads positionally as <seg>:<bus>:<dev>.<fn> —
// matching the R111.M2-005 "PCIE BDF" packing convention. Neither
// literal contains the token "OK" so the OK_TOK-driven coverage gate
// in tools/verify-fingerprint-coverage.sh does not require an
// ALLOWLIST entry for either.
//
// -----------------------------------------------------------------------------
// BOCHS_STDVGA_MAX_DEVS = 1
// -----------------------------------------------------------------------------
//
// QEMU emulates at most one Bochs display device per VM (a second
// -vga std would collide). The R101 witness pins to slot 0.
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.24.x)
// -----------------------------------------------------------------------------
//
//   G1: sized MMIO stores go through mov_b / mov_w / mov_d.
//   G4: full-register compares; no `add reg, [mem]`, no `cmp reg, [mem]`.
//   No mov_bzx / mov_wzx: byte / word loads use `xor rax,rax; mov_b/w
//       rax, [mem]` (matches rtl8139/probe.pdx precedent).
//
// Reserved-label discipline: labels prefixed `bochs_p_`.

module Probe = structure {

  pub let BOCHS_VENDOR   : u64 = 0x1234
  pub let BOCHS_DEVICE   : u64 = 0x1111

  // Packed key handed to pci_probe_table_find: (vid<<16)|did.
  pub let BOCHS_VID_DID  : u64 = 0x12341111

  pub let BOCHS_MAX_DEVS  : u64 = 1
  pub let BOCHS_DEV_BYTES : u64 = 48

  // Default LFB size if the BAR-size probe path is skipped (typical
  // QEMU stdvga is 16 MiB).
  pub let BOCHS_DEFAULT_LFB_SIZE : u64 = 0x1000000

  // Fingerprint (all-lowercase, no OK_TOK trigger). "r101 bochs probe ok"
  pub let bochs_probe_ok_msg : [u8; 20] = "r101 bochs probe ok\0"

  // R111.M2-006 (#2358) probe-table result fingerprints. Neither string
  // contains a standalone "OK" token, so no fingerprint-coverage gate
  // ALLOWLIST entry is required.
  pub let tag_bochs_probe_found : [u8; 18] = "BOCHS PROBE FOUND\0"
  pub let tag_bochs_probe_none  : [u8; 17] = "BOCHS PROBE NONE\0"

  // Canonical static slots.
  pub let mut _bochs_stdvga_devices      : [u64; 6] = uninit @align(8)
  pub let mut _bochs_stdvga_device_count : u64      = 0

  // ==========================================================================
  // bochs_stdvga_probe() -> u64
  //
  // Returns the count of Bochs display devices discovered (0 or 1).
  //
  // Register plan (post R111.M2-006 refactor):
  //   r13 = discovered count (0 or 1) — return value carrier
  //   r14 = &_pci_devices[match_index]  (only when a match is found)
  //   r15 = &_bochs_stdvga_devices[0]    (only when populating the record)
  //
  // Scratch layout:
  //   [rsp+0]  = seg  (u64, zero-extended)
  //   [rsp+8]  = bus  (u64)
  //   [rsp+16] = dev  (u64)
  //   [rsp+24] = fn   (u64)
  //   [rsp+32] = bar0_lfb_pa staging (u64)
  //   [rsp+40] = bar2_mmio_pa staging (u64)
  //   [rsp+48] = packed_bdf staging   (u64)
  //
  // 6 pushes = 48 B; entry rsp%16==8 -> 56; sub rsp,56 (56 scratch)
  // -> 112, %16==0 (aligned for every nested pci_probe_table_find /
  // pci_config_read_u32 / klog_s1_x3 / klog_s1_d1 call).
  // ==========================================================================
  pub let bochs_stdvga_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R101.M2-001 + R111.M2-006 (paideia-os #2358). Bochs/QEMU stdvga PCI probe rewritten to consult the shared pci_probe_table_find helper instead of walking _pci_devices inline. Body: (1) 6-push callee-save prologue (rbx, rbp, r12-r15) — 48 B; entry rsp%16==8 -> 56; sub rsp,56 (56 scratch slots [rsp+0..48]) -> 112, %16==0 (SysV-aligned for every nested call without extra pre-call pad). (2) Init r13 = count = 0. (3) Load rdi = BOCHS_VID_DID (0x12341111 = (0x1234<<16)|0x1111) and call pci_probe_table_find. rax = matched _pci_devices index or 0xFFFFFFFFFFFFFFFF (u64::MAX = -1). (4) On no-match: emit klog_s1(INFO, DRV_, tag_bochs_probe_none) and fall through to the count-fingerprint tail. (5) On match: compute r14 = &_pci_devices[rax] = base + (rax<<5). Stash BDF into scratch — seg (u16@+0) at [rsp+0], bus/dev/fn (u8@+2/+3/+4) at [rsp+8/16/24]. Compute packed_bdf = (seg<<32)|(bus<<16)|(dev<<8)|fn into [rsp+48] using the same shift-mask pattern as pci_enumerate_segment_range §L749. Emit klog_s1_x3(INFO, DRV_, tag_bochs_probe_found, k_vid, 0x1234, k_did, 0x1111, k_bdf, packed_bdf) using the standard 3-stack-arg pre-align pattern (sub rsp,8; push v3=packed_bdf; push k3=k_bdf; push v2=0x1111; call; add rsp,24; add rsp,8). (6) Read BAR0 via pci_config_read_u32(seg, bus, dev, fn, 0x10). Verify bit 0 == 0 (MEM BAR); else fall through to the count tail without incrementing r13. Mask ~0xF into [rsp+32]. (7) Read BAR2 via pci_config_read_u32(..., 0x18). Same MEM-BAR verification; mask ~0xF into [rsp+40]. (8) Populate _bochs_stdvga_devices[0] at r15 with seg/bus/dev/fn/pad0/pad1 + bar0/bar2 + BOCHS_DEFAULT_LFB_SIZE (real BAR-size probe deferred; QEMU stdvga reports 16 MiB and any wrong ceiling only shrinks the mapped range without breaking correctness at 1024x768x32 = 3 MiB). (9) r13 = 1. (10) Count tail: publish _bochs_stdvga_device_count = r13; emit klog_s1_d1(INFO, DRV_, bochs_probe_ok_msg, k_n, r13). Return r13. Encoder posture: G1 sized MMIO stores via mov_b/mov_w/mov_d; G4 full-register compares (cmp reg, imm / cmp reg, reg — never cmp reg, [mem]); no 2-op imul r,imm, no and reg,imm64 (only imm8/imm32-sign-extended constants used). Reserved-label posture: labels prefixed `bochs_p_`. Every nested callee (pci_probe_table_find, pci_config_read_u32, klog_s1, klog_s1_x3, klog_s1_d1) preserves rbx/rbp/r12-r15 per SysV.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;                             // 56 scratch slots

        xor r13, r13;                            // count = 0

        // ============================================================
        // R111.M2-006 (#2358): consult the shared probe-table helper.
        // rdi = (0x1234 << 16) | 0x1111 = 0x12341111.
        // ============================================================
        mov rdi, 0x12341111;                     // BOCHS_VID_DID
        call pci_probe_table_find;

        // rax = matched index or 0xFFFFFFFFFFFFFFFF (u64::MAX = -1).
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je bochs_p_none;

        // ---- Match: compute r14 = &_pci_devices[rax]. ----
        shl rax, 5;                              // record stride 32 = shl 5
        lea r14, [rip + _pci_devices];
        add r14, rax;

        // Stash BDF.
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;                      // seg
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;                      // bus
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;                     // dev
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;                     // fn

        // ---- Compute packed_bdf = (seg<<32)|(bus<<16)|(dev<<8)|fn ----
        mov rax, [rsp + 0];                      // seg
        and rax, 0xFFFF;
        shl rax, 32;
        mov r10, rax;                            // r10 = seg << 32
        mov rax, [rsp + 8];                      // bus
        and rax, 0xFF;
        shl rax, 16;
        or  r10, rax;
        mov rax, [rsp + 16];                     // dev
        and rax, 0x1F;
        shl rax, 8;
        or  r10, rax;
        mov rax, [rsp + 24];                     // fn
        and rax, 7;
        or  r10, rax;
        mov [rsp + 48], r10;                     // stash packed_bdf

        // ---- Emit "BOCHS PROBE FOUND vid=<> did=<> bdf=<>". ----
        // klog_s1_x3 stack args (deepest -> top): v3 = packed_bdf,
        //   k3 = k_bdf, v2 = did. Register args: rcx = k_vid, r8 = vid,
        //   r9 = k_did. Same 3-push pre-align pattern as dump.pdx L134.
        sub rsp, 8;                              // pre-align
        mov rax, [rsp + 56];                     // packed_bdf (post-sub-8)
        push rax;                                // v3
        lea rax, [rip + k_bdf];
        push rax;                                // k3
        mov rax, 0x1111;                         // BOCHS_DEVICE
        push rax;                                // v2 = did

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + tag_bochs_probe_found];
        lea rcx, [rip + k_vid];
        mov r8, 0x1234;                          // v1 = vid
        lea r9, [rip + k_did];
        call klog_s1_x3;

        add rsp, 24;                             // pop 3 pushed args
        add rsp, 8;                              // undo pre-align

        // ============================================================
        // Config-space walk (only reached on a matched device).
        // BAR0 (config +0x10) - LFB.
        // ============================================================
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x10;
        call pci_config_read_u32;

        // Verify MEM BAR (bit 0 == 0); else skip (not expected on stdvga).
        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne bochs_p_publish;                     // fall through with count=0
        and rax, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 32], rax;                     // bar0_lfb_pa

        // BAR2 (config +0x18) - MMIO for VBE-DISPI registers.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x18;
        call pci_config_read_u32;

        mov r11, rax;
        and r11, 1;
        cmp r11, 0;
        jne bochs_p_publish;                     // fall through with count=0
        and rax, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 40], rax;                     // bar2_mmio_pa

        // ---- Populate _bochs_stdvga_devices[0] at r15. ----
        // Only one device supported (BOCHS_MAX_DEVS=1) so j=0 and no
        // stride multiplication is needed.
        lea r15, [rip + _bochs_stdvga_devices];

        mov r10, [rsp + 0];                      // seg
        mov_w [r15 + 0], r10;

        mov r10, [rsp + 8];                      // bus
        mov_b [r15 + 2], r10;

        mov r10, [rsp + 16];                     // dev
        mov_b [r15 + 3], r10;

        mov r10, [rsp + 24];                     // fn
        mov_b [r15 + 4], r10;

        xor r10, r10;
        mov_b [r15 + 5], r10;                    // pad0
        mov_w [r15 + 6], r10;                    // pad1

        mov r10, [rsp + 32];                     // bar0_lfb_pa
        mov [r15 + 8], r10;

        mov r10, [rsp + 40];                     // bar2_mmio_pa
        mov [r15 + 16], r10;

        mov r10, 0x1000000;                      // BOCHS_DEFAULT_LFB_SIZE (16 MiB)
        mov [r15 + 24], r10;

        xor r10, r10;
        mov [r15 + 32], r10;                     // bar2_mmio_va (populated by modeset)
        mov [r15 + 40], r10;                     // bar0_lfb_va (populated by lfb_map)

        mov r13, 1;                              // count = 1
        jmp bochs_p_publish;

      bochs_p_none:
        // R111.M2-006 (#2358): no matching (vid,did) in the probe table.
        // Emit the NONE fingerprint before the shared count tail.
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + tag_bochs_probe_none];
        call klog_s1;
        // r13 stays 0 -- fall through to publish/emit-ok tail.

      bochs_p_publish:
        mov [rip + _bochs_stdvga_device_count], r13;

        // Fingerprint: emitted whether count is 0 or 1 (the count value
        // tells the caller which path fired).
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + bochs_probe_ok_msg];
        lea rcx, [rip + k_n];
        mov r8, r13;
        call klog_s1_d1;

        mov rax, r13;

        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
