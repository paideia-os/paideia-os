// src/kernel/core/drivers/gfx/bochs_stdvga/modeset.pdx -- R101.M2-002
//
// Bochs/QEMU stdvga modeset via the VBE-DISPI register set exposed at
// BAR2 MMIO offset 0x500.
//
// Under the modern QEMU stdvga (built with bochs-display), the twelve
// VBE-DISPI registers are direct-mapped at MMIO addresses:
//
//   BAR2 + 0x500 + (index * 2)      -- 16-bit register, direct access
//
// There is NO index/data indirection on the MMIO path (that's the
// legacy I/O port path, using ports 0x1CE / 0x1CF). paideia-as v0.24.x
// has no `in`/`out` primitive family, so the legacy path is unreachable
// -- MMIO direct access is the ONLY viable path from this tree, and it
// is what design/graphics/r101-kernel-plan.md §7 explicitly calls out
// as the fallback ("If a Bochs `in`/`out` I/O port encoder gap
// surfaces, fall back to MMIO-only access via BAR2's memory-mapped
// VBE-DISPI aperture").
//
// -----------------------------------------------------------------------------
// Register indices used
// -----------------------------------------------------------------------------
//
//   INDEX_XRES         = 1   (BAR2 + 0x502)
//   INDEX_YRES         = 2   (BAR2 + 0x504)
//   INDEX_BPP          = 3   (BAR2 + 0x506)
//   INDEX_ENABLE       = 4   (BAR2 + 0x508)
//   INDEX_VIRT_WIDTH   = 6   (BAR2 + 0x50C)
//   INDEX_VIRT_HEIGHT  = 7   (BAR2 + 0x50E)
//   INDEX_X_OFFSET     = 8   (BAR2 + 0x510)
//   INDEX_Y_OFFSET     = 9   (BAR2 + 0x512)
//
// ENABLE bits: DISABLED = 0x00, ENABLED = 0x01, LFB_ENABLED = 0x40,
//              NOCLEARMEM = 0x80.
//
// -----------------------------------------------------------------------------
// Modeset sequence (idempotent under re-entry)
// -----------------------------------------------------------------------------
//
//   (1) Write INDEX_ENABLE = 0                    (disable to program safely)
//   (2) Write INDEX_XRES   = width  (1024)
//   (3) Write INDEX_YRES   = height (768)
//   (4) Write INDEX_BPP    = depth  (32)
//   (5) Write INDEX_VIRT_WIDTH  = width           (no scrolling / no dbl-buf)
//   (6) Write INDEX_VIRT_HEIGHT = height
//   (7) Write INDEX_X_OFFSET = 0
//   (8) Write INDEX_Y_OFFSET = 0
//   (9) Write INDEX_ENABLE = ENABLED | LFB_ENABLED | NOCLEARMEM (=0xC1)
//
// -----------------------------------------------------------------------------
// BAR2 MMIO mapping
// -----------------------------------------------------------------------------
//
// BAR2 is a tiny window (4 KiB is enough for the VBE-DISPI aperture at
// 0x500..0x51B plus the surrounding VGA-legacy I/O passthrough at
// 0x400..0x4FF). Mapped UC via platform_mmio_map(cache_type=MMIO_UC=0)
// -- register access must not be reordered or coalesced. The mapping
// happens ONCE inside this function on the first call; subsequent calls
// reuse the stashed VA at _bochs_stdvga_devices[0]+32.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
// "r101 bochs modeset ok width=1024 height=768"  (klog_s1_d2)

module Modeset = structure {

  pub let BOCHS_MODESET_WIDTH  : u64 = 1024
  pub let BOCHS_MODESET_HEIGHT : u64 = 768
  pub let BOCHS_MODESET_BPP    : u64 = 32

  // VBE-DISPI direct-MMIO base offset within BAR2, plus per-register
  // stride (16-bit -> stride 2).
  pub let VBE_MMIO_BASE : u64 = 0x500

  // ENABLE composite bits.
  pub let VBE_DISPI_ENABLED     : u64 = 0x01
  pub let VBE_DISPI_LFB_ENABLED : u64 = 0x40
  pub let VBE_DISPI_NOCLEARMEM  : u64 = 0x80

  // BAR2 map size (one page suffices for the VBE-DISPI 12-register window).
  pub let BOCHS_BAR2_MAP_BYTES : u64 = 4096

  pub let bochs_modeset_ok_msg : [u8; 22] = "r101 bochs modeset ok\0"
  pub let bochs_k_width  : [u8; 6] = "width\0"
  pub let bochs_k_height : [u8; 7] = "height\0"

  // ==========================================================================
  // bochs_vbe_write(bar2_va, index, value) -> ()
  //
  // Store a 16-bit value at bar2_va + VBE_MMIO_BASE + (index * 2).
  // mfence brackets so the CPU cannot re-order across the register poke.
  // ==========================================================================
  pub let bochs_vbe_write : (u64, u64, u64) -> () !{mem} @{boot} =
    fn (bar2_va: u64) (index: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R101.M2-002: 16-bit MMIO store to bar2_va + 0x500 + (index * 2). mfence brackets so the CPU does not re-order the store across surrounding VBE-DISPI writes (the modeset sequence's ordering matters: ENABLE=0 must precede the geometry writes, and ENABLE=composite must follow them). Uses mov_w explicitly (sized store) per encoder-gap discipline -- a bare `mov [addr], reg` would widen to REX.W and clobber neighbouring memory. Labels prefixed bochs_vw_.",
      block: {
        mov r10, rdi;                            // bar2_va
        add r10, 0x500;                          // VBE_MMIO_BASE
        mov r11, rsi;
        shl r11, 1;                              // index * 2
        add r10, r11;

        mfence;
        mov_w [r10], rdx;
        mfence;
        ret
      }
    }

  // ==========================================================================
  // bochs_stdvga_modeset() -> u64
  //
  // Returns 1 on success, 0 on skip (no device / BAR2 map fail).
  //
  // Register plan: rbx = &device[0], r12 = bar2_pa, r13 = bar2_va.
  // ==========================================================================
  pub let bochs_stdvga_modeset : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R101.M2-002: program the Bochs stdvga VBE-DISPI register set to 1024x768x32 via BAR2 MMIO (direct-mapped access, no I/O ports). Sequence: (0) skip if no probed device; (1) map BAR2 into kernel address space via platform_mmio_map(cache_type=MMIO_UC=0) if not yet mapped -- stashes VA into device[0]+32; (2) write INDEX_ENABLE=0 (disable for safe reprogram); (3-4) INDEX_XRES=1024, INDEX_YRES=768; (5) INDEX_BPP=32; (6-7) INDEX_VIRT_WIDTH=1024, INDEX_VIRT_HEIGHT=768 (no scrolling / no double-buffer); (8-9) INDEX_X_OFFSET=0, INDEX_Y_OFFSET=0; (10) INDEX_ENABLE = ENABLED | LFB_ENABLED | NOCLEARMEM = 0xC1. Every write via bochs_vbe_write (mfence-bracketed mov_w). On success emit klog_s1_d2 fingerprint. Register plan: 3-push (rbx/r12/r13) + sub rsp,8 for alignment -- entry rsp%16==8, +24+8=32, rsp%16==0 for nested calls. Labels prefixed bochs_ms_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        // (0) Skip if no device probed.
        mov rax, [rip + _bochs_stdvga_device_count];
        cmp rax, 0;
        je  bochs_ms_skip;

        lea rbx, [rip + _bochs_stdvga_devices];
        mov r12, [rbx + 16];                     // bar2_pa
        cmp r12, 0;
        je  bochs_ms_skip;

        // (1) BAR2 map (once). Read the stashed VA at [rbx+32]; if 0,
        // map fresh via platform_mmio_map(MMIO_UC=0).
        mov r13, [rbx + 32];
        cmp r13, 0;
        jne bochs_ms_bar2_ok;

        mov rdi, r12;
        mov rsi, 4096;                           // BOCHS_BAR2_MAP_BYTES
        mov rdx, 0;                              // MMIO_UC
        call platform_mmio_map;
        cmp rax, 0;
        je  bochs_ms_skip;
        mov r13, rax;
        mov [rbx + 32], r13;                     // stash

      bochs_ms_bar2_ok:

        // (2) INDEX_ENABLE = 0
        mov rdi, r13;
        mov rsi, 4;                              // INDEX_ENABLE
        xor rdx, rdx;
        call bochs_vbe_write;

        // (3) INDEX_XRES = 1024
        mov rdi, r13;
        mov rsi, 1;                              // INDEX_XRES
        mov rdx, 1024;
        call bochs_vbe_write;

        // (4) INDEX_YRES = 768
        mov rdi, r13;
        mov rsi, 2;                              // INDEX_YRES
        mov rdx, 768;
        call bochs_vbe_write;

        // (5) INDEX_BPP = 32
        mov rdi, r13;
        mov rsi, 3;                              // INDEX_BPP
        mov rdx, 32;
        call bochs_vbe_write;

        // (6) INDEX_VIRT_WIDTH = 1024
        mov rdi, r13;
        mov rsi, 6;                              // INDEX_VIRT_WIDTH
        mov rdx, 1024;
        call bochs_vbe_write;

        // (7) INDEX_VIRT_HEIGHT = 768
        mov rdi, r13;
        mov rsi, 7;                              // INDEX_VIRT_HEIGHT
        mov rdx, 768;
        call bochs_vbe_write;

        // (8) INDEX_X_OFFSET = 0
        mov rdi, r13;
        mov rsi, 8;                              // INDEX_X_OFFSET
        xor rdx, rdx;
        call bochs_vbe_write;

        // (9) INDEX_Y_OFFSET = 0
        mov rdi, r13;
        mov rsi, 9;                              // INDEX_Y_OFFSET
        xor rdx, rdx;
        call bochs_vbe_write;

        // (10) INDEX_ENABLE = ENABLED | LFB_ENABLED | NOCLEARMEM = 0xC1
        mov rdi, r13;
        mov rsi, 4;                              // INDEX_ENABLE
        mov rdx, 0xC1;
        call bochs_vbe_write;

        // Fingerprint.
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + bochs_modeset_ok_msg];
        lea rcx, [rip + bochs_k_width];
        mov r8, 1024;
        lea r9, [rip + bochs_k_height];
        sub rsp, 8;
        mov rax, 768;
        push rax;
        call klog_s1_d2;
        add rsp, 16;

        mov rax, 1;
        jmp bochs_ms_out;

      bochs_ms_skip:
        xor rax, rax;

      bochs_ms_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
