// src/kernel/core/drivers/gfx/bochs_stdvga/flush.pdx -- R101.M2-004
//
// Bochs/QEMU stdvga flush: dumb copy from a KIND_FRAMEBUFFER-backed
// linear byte range into the LFB.
//
// The stdvga framebuffer is HOST-VISIBLE-ON-WRITE: every write to the
// mapped BAR0 range is immediately reflected in what the QEMU display
// shows. There is no "commit" or "flush" op on the host side; the
// per-page WC PTEs from lfb_map.pdx are sufficient. This function's
// job is therefore JUST to copy the pixel bytes from a caller-supplied
// source into the LFB.
//
// The R101 witness drives this by allocating a KIND_MEMORY-backed
// buffer sized to the fb, painting a checkerboard, and then invoking
// backend_flush(BOCHS_STDVGA, ...) which dispatches here.
//
// -----------------------------------------------------------------------------
// Contract
// -----------------------------------------------------------------------------
//
//   bochs_flush(src_va, dst_va, width, height, stride) -> bytes_copied
//
//   src_va, dst_va -- BGRA8888 linear byte ranges.
//   width, height  -- pixel dimensions.
//   stride         -- byte pitch (typically width * 4 for BGRA8888).
//
// Returns (width * 4) * height bytes copied on success; 0 on any
// zero argument.

module Flush = structure {

  // ==========================================================================
  // bochs_flush(src_va, dst_va, width, height, stride) -> u64
  //
  // Register plan:
  //   rbx = src_cursor       (advances by stride per row)
  //   r12 = dst_cursor       (advances by stride per row)
  //   r13 = rows_remaining   (decrements per row)
  //   r14 = stride           (immutable across the loop)
  //   r15 = bytes_per_row    (width * 4; immutable across the loop)
  //   rbp = total_bytes      (bytes_per_row * height; return value)
  //
  // Six callee-save pushes: entry rsp%16 == 8, +48 = 56, rsp%16 == 8.
  // No nested calls, so alignment doesn't matter (only external calls
  // require rsp%16 == 0 at the callee's entry).
  // ==========================================================================
  pub let bochs_flush : (u64, u64, u64, u64, u64) -> u64 !{mem} @{boot} =
    fn (src_va: u64) (dst_va: u64) (width: u64) (height: u64) (stride: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R101.M2-004: dumb-copy blit from a KIND_FRAMEBUFFER-backed source buffer into the mapped LFB. Precomputes bytes_per_row (width*4) into r15 and total_bytes (bytes_per_row*height) into rbp BEFORE the loop, so the epilogue can return the exact copied byte count. Loops `height` rows; each row copies `bytes_per_row` bytes in 8-byte qword strides via a nested rcx-indexed inner loop. WC-mapped dst (per lfb_map.pdx MMIO_WC) coalesces streams of qword writes into 64-byte bursts. Six callee-save pushes preserve the six live registers; no nested calls, so no alignment padding needed. Labels prefixed bochs_fl_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        // Defensive zero-check on any argument.
        cmp rdi, 0;
        je  bochs_fl_zero;
        cmp rsi, 0;
        je  bochs_fl_zero;
        cmp rdx, 0;
        je  bochs_fl_zero;
        cmp rcx, 0;
        je  bochs_fl_zero;
        cmp r8, 0;
        je  bochs_fl_zero;

        mov rbx, rdi;                            // src cursor
        mov r12, rsi;                            // dst cursor
        mov r13, rcx;                            // rows remaining
        mov r14, r8;                             // stride

        // bytes_per_row = width * 4
        mov r15, rdx;
        shl r15, 2;

        // total_bytes = bytes_per_row * height (for return)
        mov rax, r15;
        imul rax, rcx;
        mov rbp, rax;

      bochs_fl_row:
        cmp r13, 0;
        jbe bochs_fl_done;

        xor rcx, rcx;                            // byte offset in row = 0
      bochs_fl_qword:
        cmp rcx, r15;
        jae bochs_fl_row_done;

        mov rax, [rbx + rcx * 1];
        mov [r12 + rcx * 1], rax;

        add rcx, 8;
        jmp bochs_fl_qword;

      bochs_fl_row_done:
        add rbx, r14;
        add r12, r14;
        sub r13, 1;
        jmp bochs_fl_row;

      bochs_fl_done:
        mfence;                                  // publish WC writes
        mov rax, rbp;                            // total_bytes
        jmp bochs_fl_out;

      bochs_fl_zero:
        xor rax, rax;

      bochs_fl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
