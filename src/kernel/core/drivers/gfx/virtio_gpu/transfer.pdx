// src/kernel/core/drivers/gfx/virtio_gpu/transfer.pdx -- R103.M3-001
//                                                        (paideia-os #2162)
//
// virtio_gpu_transfer_to_host_2d(resource_id, x, y, w, h, offset):
// carry the guest-side written pixels of a 2D resource's backing
// range to the host resource, so a subsequent RESOURCE_FLUSH commits
// visible pixels.
//
// -----------------------------------------------------------------------------
// SECTION 1  COMMAND SHAPE (virtio 1.1 §5.7.7)
// -----------------------------------------------------------------------------
//
//   TRANSFER_TO_HOST_2D (0x0105):
//     +0   header (24 bytes)
//     +24  struct virtio_gpu_rect { u32 x, u32 y, u32 width, u32 height }
//     +40  u64 offset            (byte offset into the backing)
//     +48  u32 resource_id
//     +52  u32 padding
//   Total: 56 bytes.

module Transfer = structure {

  pub let VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D : u64 = 0x0105

  pub let vgpu_transfer_ok_msg : [u8; 22] = "r103 vgpu transfer ok\0"

  pub let virtio_gpu_transfer_to_host_2d :
      (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (resource_id: u64, x: u64, y: u64, w: u64, h: u64, offset: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M3-001: build TRANSFER_TO_HOST_2D (56 bytes). Header type=0x0105. Body @+24: rect. @+40: offset u64. @+48: resource_id u32. @+52: padding u32=0. Submit + verify OK_NODATA. Register plan: 6-arg SysV; stash all 6 to callee-save. Labels prefixed vgpu_tx_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // resource_id
        mov r12, rsi;                            // x
        mov r13, rdx;                            // y
        mov r14, rcx;                            // w
        mov r15, r8;                             // h
        mov rbp, r9;                             // offset

        mov rdi, 0x0105;
        call vgpu_res_write_hdr;

        lea r10, [rip + _vgpu_ctrl_cmd_buf];
        mov rax, r12;
        mov_d [r10 + 24], rax;                   // x
        mov rax, r13;
        mov_d [r10 + 28], rax;                   // y
        mov rax, r14;
        mov_d [r10 + 32], rax;                   // width
        mov rax, r15;
        mov_d [r10 + 36], rax;                   // height
        mov [r10 + 40], rbp;                     // offset u64
        mov rax, rbx;
        mov_d [r10 + 48], rax;                   // resource_id
        xor rax, rax;
        mov_d [r10 + 52], rax;

        mov rdi, 56;
        mov rsi, 24;
        call virtio_gpu_ctrl_submit_and_wait;
        cmp rax, 0;
        jne vgpu_tx_fail;

        lea r10, [rip + _vgpu_ctrl_resp_buf];
        xor rax, rax;
        mov eax, [r10 + 0];
        mov r11, 0x1100;
        cmp rax, r11;
        jne vgpu_tx_fail;

        xor rax, rax;
        jmp vgpu_tx_out;

      vgpu_tx_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      vgpu_tx_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
