// src/kernel/core/drivers/gfx/virtio_gpu/backing.pdx -- R103.M2-002
//                                                       (paideia-os #2160)
//
// virtio_gpu_resource_attach_backing: bind a single guest-physical
// page range (from a KIND_FRAMEBUFFER row) to a virtio-gpu 2D
// resource_id.
//
// -----------------------------------------------------------------------------
// SECTION 1  COMMAND SHAPE (virtio 1.1 §5.7.6)
// -----------------------------------------------------------------------------
//
//   RESOURCE_ATTACH_BACKING (0x0106):
//     +0   header (24 bytes)
//     +24  u32 resource_id
//     +28  u32 nr_entries
//     +32  entries[nr_entries]  { u64 addr, u32 length, u32 padding }
//
// R103 MVP contract: nr_entries = 1 (each KIND_FRAMEBUFFER row is
// backed by a single contiguous KIND_MEMORY range in this landing;
// scatter/gather is a later concern once phys-alloc gains a
// scatter-list return path). Total command size = 32 + 16 = 48 bytes.

module Backing = structure {

  pub let VIRTIO_GPU_CMD_ATTACH_BACKING : u64 = 0x0106
  pub let VIRTIO_GPU_CMD_DETACH_BACKING : u64 = 0x0107

  pub let vgpu_backing_ok_msg : [u8; 24] = "r103 vgpu attach back\0\0\0"

  // ==========================================================================
  // virtio_gpu_resource_attach_backing(resource_id, pa, len) -> 0 | sentinel
  //
  // Register plan (4-push callee-save + rsp,8 pad):
  //   rbx = resource_id
  //   r12 = pa
  //   r13 = len
  //   r14 = &_vgpu_ctrl_cmd_buf
  // ==========================================================================

  pub let virtio_gpu_resource_attach_backing : (u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (resource_id: u64, pa: u64, len: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M2-002: build ATTACH_BACKING (48 bytes). Header type=0x0106; body @+24 resource_id u32, @+28 nr_entries=1 u32, @+32 addr u64, @+40 length u32, @+44 padding u32. Bounds-check: pa+len wrap? Bounded by caller (KIND_FRAMEBUFFER's KIND_MEMORY parent authority already validated at mint time -- no re-check here). Submit + verify OK_NODATA. Labels prefixed vgpu_bck_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rdi, 0x0106;
        call vgpu_res_write_hdr;

        lea r14, [rip + _vgpu_ctrl_cmd_buf];
        mov rax, rbx;
        mov_d [r14 + 24], rax;                   // resource_id
        mov rax, 1;
        mov_d [r14 + 28], rax;                   // nr_entries
        mov [r14 + 32], r12;                     // addr u64
        mov rax, r13;
        mov_d [r14 + 40], rax;                   // length u32
        xor rax, rax;
        mov_d [r14 + 44], rax;                   // padding

        mov rdi, 48;
        mov rsi, 24;
        call virtio_gpu_ctrl_submit_and_wait;
        cmp rax, 0;
        jne vgpu_bck_fail;

        lea r10, [rip + _vgpu_ctrl_resp_buf];
        xor rax, rax;
        mov eax, [r10 + 0];
        mov r11, 0x1100;
        cmp rax, r11;
        jne vgpu_bck_fail;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + vgpu_backing_ok_msg];
        lea rcx, [rip + k_n];
        mov r8, rbx;
        call klog_s1_d1;

        xor rax, rax;
        jmp vgpu_bck_out;

      vgpu_bck_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      vgpu_bck_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
