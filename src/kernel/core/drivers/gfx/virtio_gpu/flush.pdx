// src/kernel/core/drivers/gfx/virtio_gpu/flush.pdx -- R103.M3-002
//                                                     (paideia-os #2163)
//
// virtio_gpu_resource_flush(resource_id, x, y, w, h): commit a resource
// (whose backing pixels were carried via TRANSFER_TO_HOST_2D) to the
// on-screen surface. This is the page-flip on virtio-gpu 2D.
//
// Two entry points:
//   * virtio_gpu_resource_flush() -- the synchronous form used by the
//     R103 witness's initial priming (paint red -> transfer -> flush,
//     wait for completion via the ctrl_submit_and_wait poll loop).
//   * virtio_gpu_backend_flush() -- the async form dispatched from
//     core/graphics/backend_dispatch.pdx when backend_kind ==
//     VIRTIO_GPU_2D. Does not wait; the isr.pdx handler (or the
//     LAPIC-tick fallback) drives the vblank signal on completion.
//
// -----------------------------------------------------------------------------
// SECTION 1  COMMAND SHAPE (virtio 1.1 §5.7.8)
// -----------------------------------------------------------------------------
//
//   RESOURCE_FLUSH (0x0104):
//     +0   header (24 bytes)
//     +24  struct virtio_gpu_rect { u32 x, u32 y, u32 width, u32 height }
//     +40  u32 resource_id
//     +44  u32 padding
//   Total: 48 bytes.

module Flush = structure {

  pub let VIRTIO_GPU_CMD_RESOURCE_FLUSH : u64 = 0x0104

  pub let vgpu_flush_ok_msg : [u8; 21] = "r103 vgpu flush ok\0\0\0"

  // Active resource id -- driver-owned state that backend_flush uses to
  // know which host resource to name in TRANSFER + FLUSH. The witness
  // (or a future compositor) sets this via virtio_gpu_set_active_resource.
  pub let mut _vgpu_active_resource_id : u64 = 0
  pub let mut _vgpu_active_width       : u64 = 0
  pub let mut _vgpu_active_height      : u64 = 0

  // ==========================================================================
  // virtio_gpu_set_active_resource(resource_id, w, h)
  //
  // Called by the witness after minting a KIND_FRAMEBUFFER + a paired
  // virtio-gpu resource_id so backend_flush knows the mapping.
  // ==========================================================================

  pub let virtio_gpu_set_active_resource : (u64, u64, u64) -> () !{mem} @{boot} =
    fn (resource_id: u64, w: u64, h: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "R103.M3-002: publish the current active resource_id + geometry so backend_flush knows what to TRANSFER + FLUSH. Simple stash. Labels prefixed vgpu_sar_.",
      block: {
        mov [rip + _vgpu_active_resource_id], rdi;
        mov [rip + _vgpu_active_width], rsi;
        mov [rip + _vgpu_active_height], rdx;
        ret
      }
    }

  // ==========================================================================
  // virtio_gpu_resource_flush(resource_id, x, y, w, h) -> 0 | sentinel
  //
  // Synchronous form. Uses ctrl_submit_and_wait -- returns after the
  // device signals completion. Bumps _vgpu_ctrl_pending_flushes even
  // for the sync form so the ISR fallback's counter stays coherent (a
  // sync flush that lands via poll rather than ISR is still a completed
  // flush from the fallback's point of view).
  // ==========================================================================

  pub let virtio_gpu_resource_flush : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (resource_id: u64, x: u64, y: u64, w: u64, h: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M3-002: build RESOURCE_FLUSH (48 bytes). Header type=0x0104. Body @+24: rect. @+40: resource_id u32. @+44: padding. Bumps _vgpu_ctrl_pending_flushes before submit; verify OK_NODATA on return. Register plan: 5 args, stash 5 to callee-save. Labels prefixed vgpu_fl_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // resource_id
        mov r12, rsi;                            // x
        mov r13, rdx;                            // y
        mov r14, rcx;                            // w
        mov r15, r8;                             // h

        // Bump pending flushes counter.
        lea r10, [rip + _vgpu_ctrl_pending_flushes];
        mov rax, [r10];
        add rax, 1;
        mov [r10], rax;

        mov rdi, 0x0104;
        call vgpu_res_write_hdr;

        lea r10, [rip + _vgpu_ctrl_cmd_buf];
        mov rax, r12;
        mov_d [r10 + 24], rax;
        mov rax, r13;
        mov_d [r10 + 28], rax;
        mov rax, r14;
        mov_d [r10 + 32], rax;
        mov rax, r15;
        mov_d [r10 + 36], rax;
        mov rax, rbx;
        mov_d [r10 + 40], rax;
        xor rax, rax;
        mov_d [r10 + 44], rax;

        mov rdi, 48;
        mov rsi, 24;
        call virtio_gpu_ctrl_submit_and_wait;
        cmp rax, 0;
        jne vgpu_fl_fail;

        lea r10, [rip + _vgpu_ctrl_resp_buf];
        xor rax, rax;
        mov eax, [r10 + 0];
        mov r11, 0x1100;
        cmp rax, r11;
        jne vgpu_fl_fail;

        // Draining a flush completion drives one vblank tick for the
        // R103 timeline so the R101 explicit-sync path fires uniformly
        // across backends. dpy_timeline_vblank_signal is idempotent
        // under a repeat call for the same value (unsigned max in
        // dpt_row_signal).
        mov rdi, 2;                              // engine_id (virtio)
        mov rsi, 1;                              // output_id (scanout 0 -> 1)
        call dpy_timeline_vblank_signal;

        // Consume the pending flush.
        lea r10, [rip + _vgpu_ctrl_pending_flushes];
        mov rax, [r10];
        cmp rax, 0;
        je  vgpu_fl_pf_clear_done;
        sub rax, 1;
        mov [r10], rax;
      vgpu_fl_pf_clear_done:

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + vgpu_flush_ok_msg];
        call klog_s1;

        xor rax, rax;
        jmp vgpu_fl_out;

      vgpu_fl_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      vgpu_fl_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // virtio_gpu_backend_flush(src_va, dst_va_unused, width, height, stride)
  //   -> bytes_copied
  //
  // The backend_dispatch entry point (R101.M1-002 shape). Ignores
  // dst_va (virtio-gpu doesn't expose a directly-writable LFB; the
  // guest owns the backing pages instead, which are the src_va). Steps:
  //
  //   (1) Skip if _vgpu_active_resource_id == 0 (no resource armed).
  //   (2) TRANSFER_TO_HOST_2D to carry the guest pixel writes at
  //       src_va into the host resource (offset=0, rect covers whole).
  //   (3) RESOURCE_FLUSH synchronously (which itself advances the
  //       display timeline via dpy_timeline_vblank_signal).
  //   (4) Return bytes_copied = width * 4 * height.
  //
  // The dispatch site (fb_flush.pdx -> backend_flush) supplies src_va
  // in rdi. This function ignores it -- the pixel bytes at src_va are
  // ALREADY at the physical page range the host resource is backed by
  // (KIND_FRAMEBUFFER's KIND_MEMORY parent), so no copy needs to happen
  // on the guest side; the TRANSFER carries them across the PCI boundary.
  // Passing width/height through the SysV arg vector lets this function
  // avoid a second read from the fb row.
  // ==========================================================================

  pub let virtio_gpu_backend_flush : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (src_va: u64, dst_va: u64, width: u64, height: u64, stride: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M3-002: virtio-gpu 2D backend flush entry point invoked from core/graphics/backend_dispatch.pdx when _active_backend_kind == VIRTIO_GPU_2D (2). Body: (1) Load active resource_id; skip if 0 (no armed resource). (2) TRANSFER_TO_HOST_2D at rect (0,0,w,h) offset 0. (3) RESOURCE_FLUSH -- the sync helper drives the vblank via dpy_timeline_vblank_signal. (4) Return width*4*height on success, 0 on failure. Register plan: 5 args -> stash 3 (width/height/stride) into callee-save (src_va/dst_va only used for the return-value multiplication). Labels prefixed vgpu_bf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdx;                            // width
        mov r13, rcx;                            // height
        mov r14, r8;                             // stride (unused)

        mov rbx, [rip + _vgpu_active_resource_id];
        cmp rbx, 0;
        je  vgpu_bf_skip;

        // TRANSFER_TO_HOST_2D(resource_id=rbx, x=0, y=0, w=r12, h=r13,
        //                     offset=0).
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, r12;
        mov r8, r13;
        xor r9, r9;
        call virtio_gpu_transfer_to_host_2d;
        cmp rax, 0;
        jne vgpu_bf_skip;

        // RESOURCE_FLUSH.
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        mov rcx, r12;
        mov r8, r13;
        call virtio_gpu_resource_flush;
        cmp rax, 0;
        jne vgpu_bf_skip;

        // Return bytes = width * 4 * height.
        mov rax, r12;
        shl rax, 2;
        imul rax, r13;
        jmp vgpu_bf_out;

      vgpu_bf_skip:
        xor rax, rax;

      vgpu_bf_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
