// src/kernel/core/drivers/gfx/virtio_gpu/common_cfg.pdx -- R103.M1-002 + M1-003
//                                                          (paideia-os #2155, #2156)
//
// Modern virtio 1.0 (v1.1) common configuration structure accessors +
// device init handshake for virtio-gpu-pci. Mirrors
// drivers/virtio_net/common_cfg.pdx (R91.M3-002) scoped to
// _virtio_gpu_common_cfg_pa. This module owns the .bss slot that probe
// populates.
//
// =============================================================================
// SECTION 1  COMMON CONFIG LAYOUT (virtio 1.1 §4.1.4.3)
// =============================================================================
//
// Same field layout as virtio-net's common cfg. See virtio_net/common_cfg
// .pdx §1 for the exhaustive breakdown.
//
// =============================================================================
// SECTION 2  FEATURE BITS NEGOTIATED (R103.M1-003)
// =============================================================================
//
// Bit  1  VIRTIO_GPU_F_EDID          (accepted -- emulated EDID)
// Bit  0  VIRTIO_GPU_F_VIRGL         (declined -- 3D deferred, §13)
// Bit  2  VIRTIO_GPU_F_RESOURCE_UUID (declined -- R105 concern)
// Bit 32  VIRTIO_F_VERSION_1         (mandatory)
//
//   VGPU_F_ACK_LO_MASK = (1 << 1) = 0x00000002
//   VGPU_F_ACK_HI_MASK = 0x00000001 (VIRTIO_F_VERSION_1 at bit 0 of hi)
//
// =============================================================================
// SECTION 3  INIT HANDSHAKE (virtio 1.1 §3.1.1)
// =============================================================================
//
// RESET -> ACK -> DRIVER -> FEATURES -> FEATURES_OK -> DRIVER_OK.
// Body mirrors virtio_net_init_handshake with the mask constants and
// error-code sentinels retargeted.
//
// PRODUCTION-CAVEAT: per virtio 1.1 §3.1.1 step 7, queue setup belongs
// BETWEEN FEATURES_OK and DRIVER_OK. Follow-on wiring (controlq_init +
// cursorq_init in kernel_main's cascade) is sequenced explicitly by the
// caller so the caveat is honoured without an in-file split.
//
// =============================================================================
// SECTION 4  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// Labels prefixed `vgpu_cc_`. All MMIO ops via mfence-bracketed
// mov_b/mov_w/mov_d envelope, matching vn_cc_* leaf shape.

module CommonCfg = structure {

  pub let VGPU_CC_OFF_DEV_FEAT_SEL : u64 = 0x00
  pub let VGPU_CC_OFF_DEV_FEAT     : u64 = 0x04
  pub let VGPU_CC_OFF_DRV_FEAT_SEL : u64 = 0x08
  pub let VGPU_CC_OFF_DRV_FEAT     : u64 = 0x0C
  pub let VGPU_CC_OFF_MSIX_CONFIG  : u64 = 0x10
  pub let VGPU_CC_OFF_NUM_QUEUES   : u64 = 0x12
  pub let VGPU_CC_OFF_DEV_STATUS   : u64 = 0x14
  pub let VGPU_CC_OFF_CFG_GEN      : u64 = 0x15
  pub let VGPU_CC_OFF_QUEUE_SEL    : u64 = 0x16
  pub let VGPU_CC_OFF_QUEUE_SIZE   : u64 = 0x18
  pub let VGPU_CC_OFF_QUEUE_MSIX   : u64 = 0x1A
  pub let VGPU_CC_OFF_QUEUE_EN     : u64 = 0x1C
  pub let VGPU_CC_OFF_QUEUE_NOTIFY : u64 = 0x1E
  pub let VGPU_CC_OFF_QUEUE_DESC   : u64 = 0x20
  pub let VGPU_CC_OFF_QUEUE_DRV    : u64 = 0x28
  pub let VGPU_CC_OFF_QUEUE_DEV    : u64 = 0x30

  pub let VGPU_STATUS_RESET        : u64 = 0
  pub let VGPU_STATUS_ACK          : u64 = 1
  pub let VGPU_STATUS_DRIVER       : u64 = 2
  pub let VGPU_STATUS_DRIVER_OK    : u64 = 4
  pub let VGPU_STATUS_FEATURES_OK  : u64 = 8
  pub let VGPU_STATUS_FAILED       : u64 = 128

  pub let VGPU_F_SEL_LO            : u64 = 0
  pub let VGPU_F_SEL_HI            : u64 = 1

  // Only VIRTIO_GPU_F_EDID (bit 1) accepted in low half.
  pub let VGPU_F_ACK_LO_MASK       : u64 = 0x00000002
  pub let VGPU_F_ACK_HI_MASK       : u64 = 0x00000001
  pub let VGPU_F_VERSION_1_HI      : u64 = 0x00000001

  pub let VGPU_CC_OK               : u64 = 0
  pub let VGPU_CC_ERR_NO_BAR       : u64 = 0xFFFFFFFFFFFFFFED
  pub let VGPU_CC_ERR_NO_VERSION_1 : u64 = 0xFFFFFFFFFFFFFFA1
  pub let VGPU_CC_ERR_FEATURES_OK  : u64 = 0xFFFFFFFFFFFFFFFB

  // .bss slot: physical address of the common cfg MMIO region. Sole
  // writer is Probe.virtio_gpu_probe (probe.pdx §vgpu_pb_cc_skip). Sole
  // readers are the leaves in this module and every downstream virtio-
  // gpu driver file.
  pub let mut _virtio_gpu_common_cfg_pa : u64 = 0

  // Fingerprints (all-lowercase, no OK_TOK). NUL-terminated.
  pub let vgpu_init_ok_msg   : [u8; 22] = "r103 vgpu init hs ok\0\0"
  pub let vgpu_init_fail_msg : [u8; 23] = "r103 vgpu init hs fail\0"

  // ==========================================================================
  // vgpu_cc_read_u8 / write_u8 / read_u16 / write_u16 / read_u32 / write_u32
  //
  // Same shape as vn_cc_*. mfence-bracketed sized MMIO ops.
  // ==========================================================================

  pub let vgpu_cc_read_u8 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-002: 8-bit MMIO read from common_cfg base+offset. mfence-bracketed mov_b. Labels prefixed vgpu_cc_r8_.",
      block: {
        mfence;
        mov r10, rdi;
        add r10, rsi;
        xor rax, rax;
        mov_b rax, [r10];
        mfence;
        ret
      }
    }

  pub let vgpu_cc_write_u8 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-002: 8-bit MMIO write. Labels prefixed vgpu_cc_w8_.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_b [rax], rdx;
        mfence;
        ret
      }
    }

  pub let vgpu_cc_read_u16 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-002: 16-bit MMIO read. Labels prefixed vgpu_cc_r16_.",
      block: {
        mfence;
        mov r10, rdi;
        add r10, rsi;
        xor rax, rax;
        mov_w rax, [r10];
        mfence;
        ret
      }
    }

  pub let vgpu_cc_write_u16 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-002: 16-bit MMIO write. Labels prefixed vgpu_cc_w16_.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_w [rax], rdx;
        mfence;
        ret
      }
    }

  pub let vgpu_cc_read_u32 : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-002: 32-bit MMIO read. `mov eax,[mem]` zero-extends per SDM Vol 2A §3.4.1.1. Labels prefixed vgpu_cc_r32_.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov eax, [rax];
        mfence;
        ret
      }
    }

  pub let vgpu_cc_write_u32 : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (base: u64, offset: u64, val: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-002: 32-bit MMIO write via mov_d. Labels prefixed vgpu_cc_w32_.",
      block: {
        mfence;
        mov rax, rdi;
        add rax, rsi;
        mov_d [rax], rdx;
        mfence;
        ret
      }
    }

  // ==========================================================================
  // Status accessors.
  // ==========================================================================

  pub let virtio_gpu_read_device_status : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-003: read device_status u8. 0 return means either no device OR live-reset -- caller distinguishes via the NO_BAR gate. Labels prefixed vgpu_cc_rds_.",
      block: {
        mov rdi, [rip + _virtio_gpu_common_cfg_pa];
        cmp rdi, 0;
        je  vgpu_cc_rds_none;
        mov rsi, 0x14;
        call vgpu_cc_read_u8;
        ret;
      vgpu_cc_rds_none:
        xor rax, rax;
        ret
      }
    }

  pub let virtio_gpu_write_device_status : (u64) -> () !{sysreg, mem} @{boot} =
    fn (status: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-003: write device_status u8; no-op if _virtio_gpu_common_cfg_pa is 0. Labels prefixed vgpu_cc_wds_.",
      block: {
        mov rdx, rdi;
        mov rdi, [rip + _virtio_gpu_common_cfg_pa];
        cmp rdi, 0;
        je  vgpu_cc_wds_none;
        mov rsi, 0x14;
        call vgpu_cc_write_u8;
      vgpu_cc_wds_none:
        ret
      }
    }

  pub let virtio_gpu_read_device_features : (u64) -> u64 !{sysreg, mem} @{boot} =
    fn (feature_select: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-003: two-step read of device_feature: write select, then read DEV_FEAT. Labels prefixed vgpu_cc_rdf_.",
      block: {
        push rbx;
        mov rbx, rdi;
        mov rdi, [rip + _virtio_gpu_common_cfg_pa];
        cmp rdi, 0;
        je  vgpu_cc_rdf_none;
        mov rsi, 0x00;
        mov rdx, rbx;
        call vgpu_cc_write_u32;
        mov rdi, [rip + _virtio_gpu_common_cfg_pa];
        mov rsi, 0x04;
        call vgpu_cc_read_u32;
        pop rbx;
        ret;
      vgpu_cc_rdf_none:
        xor rax, rax;
        pop rbx;
        ret
      }
    }

  pub let virtio_gpu_write_driver_features : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (feature_select: u64, feature_lo: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-003: two-step write of driver_feature: write select, then write DRV_FEAT. Labels prefixed vgpu_cc_wdf_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;
        mov  rbx, rdi;
        mov  r12, rsi;
        mov  rdi, [rip + _virtio_gpu_common_cfg_pa];
        cmp  rdi, 0;
        je   vgpu_cc_wdf_none;
        mov  rsi, 0x08;
        mov  rdx, rbx;
        call vgpu_cc_write_u32;
        mov  rdi, [rip + _virtio_gpu_common_cfg_pa];
        mov  rsi, 0x0C;
        mov  rdx, r12;
        call vgpu_cc_write_u32;
      vgpu_cc_wdf_none:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // virtio_gpu_init_handshake() -> u64
  //
  // Register plan (2-push callee-save):
  //   rbx = accumulated device_status
  //   r12 = scratch for feature/status snapshots
  //   entry rsp%16==8 -> push rbx,r12 -> 24, %16==8; sub rsp,8 -> 32,
  //   %16==0 aligned for every nested call.
  // ==========================================================================

  pub let virtio_gpu_init_handshake : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-003 (paideia-os #2156). Modern virtio 1.0/1.1 §3.1.1 driver init sequence for the first-active virtio-gpu device. Body: (1) 2-push callee-save + sub rsp,8 for alignment. (2) Gate: NO_BAR sentinel if _virtio_gpu_common_cfg_pa is 0 (no fingerprint, no device to log about). (3) RESET (write 0). (4) ACK |= 1. (5) DRIVER |= 2. (6) FEATURES lo: read + mask with VGPU_F_ACK_LO_MASK (0x00000002 = VIRTIO_GPU_F_EDID only) + write. (7) FEATURES hi: read; require VIRTIO_F_VERSION_1 (bit 0 of hi); fail with NO_VERSION_1 sentinel + FAIL fingerprint if absent. Else mask + write. (8) FEATURES_OK |= 8; re-read; fail with FEATURES_OK sentinel if not latched. (9) DRIVER_OK |= 4. (10) OK fingerprint. Labels prefixed vgpu_cc_hs_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov  rax, [rip + _virtio_gpu_common_cfg_pa];
        cmp  rax, 0;
        jne  vgpu_cc_hs_reset;
        mov  rax, 0xFFFFFFFFFFFFFFED;        // NO_BAR
        jmp  vgpu_cc_hs_fail;

      vgpu_cc_hs_reset:
        xor  rdi, rdi;
        call virtio_gpu_write_device_status;
        xor  rbx, rbx;

        or   rbx, 1;                         // ACK
        mov  rdi, rbx;
        call virtio_gpu_write_device_status;

        or   rbx, 2;                         // DRIVER
        mov  rdi, rbx;
        call virtio_gpu_write_device_status;

        // FEATURES lo (select=0).
        xor  rdi, rdi;
        call virtio_gpu_read_device_features;
        mov  r12, rax;
        and  r12, 0x00000002;                // VGPU_F_ACK_LO_MASK
        xor  rdi, rdi;
        mov  rsi, r12;
        call virtio_gpu_write_driver_features;

        // FEATURES hi (select=1); VIRTIO_F_VERSION_1 required.
        mov  rdi, 1;
        call virtio_gpu_read_device_features;
        mov  r12, rax;
        and  rax, 1;
        cmp  rax, 0;
        jne  vgpu_cc_hs_hi_ok;
        mov  rdi, rbx;
        or   rdi, 128;                       // FAILED
        call virtio_gpu_write_device_status;
        mov  rax, 0xFFFFFFFFFFFFFFA1;        // NO_VERSION_1
        jmp  vgpu_cc_hs_fail;

      vgpu_cc_hs_hi_ok:
        and  r12, 1;
        mov  rdi, 1;
        mov  rsi, r12;
        call virtio_gpu_write_driver_features;

        // FEATURES_OK.
        or   rbx, 8;
        mov  rdi, rbx;
        call virtio_gpu_write_device_status;
        call virtio_gpu_read_device_status;
        mov  r12, rax;
        and  r12, 8;
        cmp  r12, 0;
        jne  vgpu_cc_hs_feats_ok;
        mov  rdi, rbx;
        or   rdi, 128;
        call virtio_gpu_write_device_status;
        mov  rax, 0xFFFFFFFFFFFFFFFB;        // FEATURES_OK
        jmp  vgpu_cc_hs_fail;

      vgpu_cc_hs_feats_ok:
        or   rbx, 4;                         // DRIVER_OK
        mov  rdi, rbx;
        call virtio_gpu_write_device_status;

        // OK fingerprint.
        mov  rdi, 3;
        lea  rsi, [rip + SUBSYS_DRV_];
        lea  rdx, [rip + vgpu_init_ok_msg];
        call klog_s1;
        xor  rax, rax;
        jmp  vgpu_cc_hs_done;

      vgpu_cc_hs_fail:
        mov  r12, rax;
        mov  rdi, 3;
        lea  rsi, [rip + SUBSYS_DRV_];
        lea  rdx, [rip + vgpu_init_fail_msg];
        call klog_s1;
        mov  rax, r12;

      vgpu_cc_hs_done:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
