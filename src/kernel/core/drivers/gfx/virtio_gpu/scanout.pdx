// src/kernel/core/drivers/gfx/virtio_gpu/scanout.pdx -- R103.M2-003
//                                                       (paideia-os #2161)
//
// virtio_gpu_set_scanout(scanout_id, resource_id, x, y, w, h): bind a
// resource to a scanout so its contents become the visible framebuffer.
//
// -----------------------------------------------------------------------------
// SECTION 1  COMMAND SHAPE (virtio 1.1 §5.7.5)
// -----------------------------------------------------------------------------
//
//   SET_SCANOUT (0x0103):
//     +0   header (24 bytes)
//     +24  struct virtio_gpu_rect { u32 x, u32 y, u32 width, u32 height }
//     +40  u32 scanout_id
//     +44  u32 resource_id
//   Total: 48 bytes.
//
// R103 MVP pins scanout_id=0 (single-scanout scope, §13); multi-scanout
// is R104's concern.

module Scanout = structure {

  pub let VIRTIO_GPU_CMD_SET_SCANOUT : u64 = 0x0103

  pub let vgpu_scanout_ok_msg : [u8; 22] = "r103 vgpu scanout ok\0\0"

  // ==========================================================================
  // virtio_gpu_set_scanout(scanout_id, resource_id, x, y, w, h) -> 0 | sentinel
  //
  // paideia-as SysV: 6 args in registers.
  // ==========================================================================

  pub let virtio_gpu_set_scanout : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (scanout_id: u64, resource_id: u64, x: u64, y: u64, w: u64, h: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M2-003: build SET_SCANOUT (48 bytes). Header type=0x0103. Body @+24: rect { u32 x, y, w, h }. @+40: scanout_id. @+44: resource_id. Submit + verify OK_NODATA. Register plan: 6-arg SysV -> stash all 6 into callee-save before overwriting arg regs for vgpu_res_write_hdr. Labels prefixed vgpu_sc_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                            // scanout_id
        mov r12, rsi;                            // resource_id
        mov r13, rdx;                            // x
        mov r14, rcx;                            // y
        mov r15, r8;                             // w
        mov rbp, r9;                             // h

        mov rdi, 0x0103;
        call vgpu_res_write_hdr;

        lea r10, [rip + _vgpu_ctrl_cmd_buf];
        mov rax, r13;
        mov_d [r10 + 24], rax;                   // x
        mov rax, r14;
        mov_d [r10 + 28], rax;                   // y
        mov rax, r15;
        mov_d [r10 + 32], rax;                   // width
        mov rax, rbp;
        mov_d [r10 + 36], rax;                   // height
        mov rax, rbx;
        mov_d [r10 + 40], rax;                   // scanout_id
        mov rax, r12;
        mov_d [r10 + 44], rax;                   // resource_id

        mov rdi, 48;
        mov rsi, 24;
        call virtio_gpu_ctrl_submit_and_wait;
        cmp rax, 0;
        jne vgpu_sc_fail;

        lea r10, [rip + _vgpu_ctrl_resp_buf];
        xor rax, rax;
        mov eax, [r10 + 0];
        mov r11, 0x1100;
        cmp rax, r11;
        jne vgpu_sc_fail;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + vgpu_scanout_ok_msg];
        call klog_s1;

        xor rax, rax;
        jmp vgpu_sc_out;

      vgpu_sc_fail:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      vgpu_sc_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
