// src/kernel/core/drivers/gfx/virtio_gpu/isr.pdx -- R103.M4-001 + M4-002
//                                                   (paideia-os #2165, #2166)
//
// virtio-gpu ISR entry point + LAPIC-tick fallback.
//
// The ISR mirrors virtio_net/isr.pdx (§4.1.4.5 virtio 1.0 legacy-style
// interrupt): a single ISR-status byte with two documented cause bits
// (queue = bit 0, cfg-change = bit 1). Reading atomically clears them.
// This file's queue-interrupt arm drives dpy_timeline_vblank_signal with
// source = SOURCE_VIRTIO_COMPLETION (4).
//
// The LAPIC-tick fallback (M4-002) is a defensive path -- if the ISR
// isn't wired (no IDT vector attached in this landing) or a host stalls,
// the tick body observes _vgpu_ctrl_pending_flushes > 0 for more than
// ~2 refresh periods and synthesizes a vblank tick. First occurrence
// per boot emits a warning fingerprint.
//
// -----------------------------------------------------------------------------
// SECTION 1  ISR wiring
// -----------------------------------------------------------------------------
//
// Under legacy INTx the QEMU virtio-gpu shares vector 11 (typical default).
// This landing does NOT install an IDT vector -- the sync flush path
// (flush.pdx virtio_gpu_resource_flush) polls the used ring itself and
// advances the timeline directly, and the async path relies on the
// fallback. A follow-on R103.M4-003 landing (out of scope here) wires
// virtio_gpu_isr_handle into the R29 KIND_HW_INTERRUPT dispatch table.
//
// -----------------------------------------------------------------------------
// SECTION 2  Fallback threshold
// -----------------------------------------------------------------------------
//
// Refresh period ≈ 16.7 ms at 60 Hz; at 100 Hz LAPIC tick that is ~2
// ticks per refresh. Two refresh periods = 4 ticks. Guard at >= 6 ticks
// to leave a margin for host jitter without spuriously firing.

module Isr = structure {

  pub let SOURCE_VIRTIO_COMPLETION : u64 = 4

  pub let VGPU_FALLBACK_TICKS_THRESHOLD : u64 = 6

  pub let mut _vgpu_ticks_since_last_signal : u64 = 0
  pub let mut _vgpu_stall_warned            : u64 = 0

  pub let vgpu_isr_ok_msg    : [u8; 19] = "r103 vgpu isr ok\0\0\0"
  pub let vgpu_flip_done_msg : [u8; 26] = "r103 vgpu flip done ok\0\0\0\0"
  pub let vgpu_stall_msg     : [u8; 22] = "r103 vgpu stall fbk\0\0\0"

  // ==========================================================================
  // virtio_gpu_isr_handle() -> u64
  //
  // Reads the ISR-status byte, dispatches on cause bits. Returns 0.
  //
  // Register plan (1-push callee-save):
  //   r12 = ISR snapshot survives across nested calls.
  //   entry rsp%16==8 -> push r12 -> 16, %16==0.
  // ==========================================================================

  pub let virtio_gpu_isr_handle : () -> u64 !{sysreg, mem} @{irq} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {irq},
      justification: "R103.M4-001: virtio 1.0 legacy-style ISR for virtio-gpu. Snapshot ISR-status u8; on bit-0-set (queue interrupt), signal dpy_timeline_vblank_signal(engine=2 virtio, output=1) + emit 'r103 vgpu flip done ok' fingerprint. On bit-1-set (cfg change), no-op today. Every entry past the NO_BAR gate emits per-entry fingerprint carrying bits snapshot. Structurally virtio_net/isr.pdx (drivers/virtio_net/isr.pdx L176) with the queue arm redirected. Labels prefixed vgpu_isr_.",
      block: {
        push r12;

        mov rax, [rip + _virtio_gpu_common_cfg_pa];
        cmp rax, 0;
        jne vgpu_isr_have;
        xor rax, rax;
        pop r12;
        ret;

      vgpu_isr_have:
        // Compute isr_pa from _virtio_gpu_devices[0].
        lea r10, [rip + _virtio_gpu_devices];

        xor rax, rax;
        mov_b rax, [r10 + 34];                   // isr_bar
        cmp rax, 4;
        je  vgpu_isr_use_bar4;
        xor r11, r11;
        jmp vgpu_isr_add_off;

      vgpu_isr_use_bar4:
        mov r11, [r10 + 8];                      // bar4_pa

      vgpu_isr_add_off:
        xor rax, rax;
        mov_w rax, [r10 + 28];                   // isr_off
        add r11, rax;

        // Read + clear.
        mfence;
        xor rax, rax;
        mov_b rax, [r11];
        mfence;

        mov r12, rax;

        // Per-entry fingerprint.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + vgpu_isr_ok_msg];
        lea rcx, [rip + k_bits];
        mov r8, r12;
        call klog_s1_d1;

        // Bit 0: queue interrupt.
        mov rax, r12;
        and rax, 1;
        cmp rax, 0;
        je  vgpu_isr_done;

        // Signal vblank.
        mov rdi, 2;                              // engine_id (virtio)
        mov rsi, 1;                              // output_id (scanout 0 -> 1)
        call dpy_timeline_vblank_signal;

        // Update the timeline row's source to SOURCE_VIRTIO_COMPLETION.
        // dpt_row_source_set is idempotent + best-effort; ignores its
        // return (no-op if row not live).
        mov rdi, 2;
        mov rsi, 1;
        call dpt_find_by_engine_output;
        cmp rax, 0xFF;
        je  vgpu_isr_no_row;
        mov rdi, rax;
        mov rsi, 4;                              // SOURCE_VIRTIO_COMPLETION
        call dpt_row_source_set;
      vgpu_isr_no_row:

        // Drain pending flushes.
        lea r10, [rip + _vgpu_ctrl_pending_flushes];
        mov rax, [r10];
        cmp rax, 0;
        je  vgpu_isr_pf_zero;
        sub rax, 1;
        mov [r10], rax;
      vgpu_isr_pf_zero:

        // Reset ticks counter.
        xor rax, rax;
        mov [rip + _vgpu_ticks_since_last_signal], rax;

        // Flip-done fingerprint.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + vgpu_flip_done_msg];
        call klog_s1;

      vgpu_isr_done:
        xor rax, rax;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // virtio_gpu_isr_tick() -> ()
  //
  // Called from int/exceptions.pdx's handle_timer body ONCE per LAPIC
  // tick (100 Hz). Gates on _active_backend_kind == VIRTIO_GPU_2D (2)
  // so it is a cheap load-compare on non-virtio-gpu boots. Body:
  //
  //   (1) Gate on _active_backend_kind == 2.
  //   (2) If _vgpu_ctrl_pending_flushes == 0, reset ticks counter, ret.
  //   (3) Increment _vgpu_ticks_since_last_signal.
  //   (4) If counter >= VGPU_FALLBACK_TICKS_THRESHOLD (6):
  //         (a) Emit stall warning ONCE per boot.
  //         (b) Signal dpy_timeline_vblank_signal(2, 1) (idempotent).
  //         (c) Consume one pending flush.
  //         (d) Reset counter.
  // ==========================================================================

  pub let virtio_gpu_isr_tick : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R103.M4-002: LAPIC-tick fallback. Gates on _active_backend_kind == VIRTIO_GPU_2D (2). If a pending flush has been unserviced for >=6 ticks (~2 refresh periods at 100 Hz LAPIC), synthesize a vblank tick to keep the compositor from wedging, and emit a one-shot stall warning per boot. Leaf-like: 3 pushes (r12/r13/r14 unused for now but reserved for future counter growth) skipped since we touch only caller-save. Labels prefixed vgpu_isrt_.",
      block: {
        sub rsp, 8;

        // Gate on active backend == VIRTIO_GPU_2D (2).
        mov rax, [rip + _active_backend_kind];
        cmp rax, 2;
        jne vgpu_isrt_out;

        // No pending flush -> reset counter and return.
        mov rax, [rip + _vgpu_ctrl_pending_flushes];
        cmp rax, 0;
        jne vgpu_isrt_have_pending;
        xor rax, rax;
        mov [rip + _vgpu_ticks_since_last_signal], rax;
        jmp vgpu_isrt_out;

      vgpu_isrt_have_pending:
        // Bump counter.
        mov rax, [rip + _vgpu_ticks_since_last_signal];
        add rax, 1;
        mov [rip + _vgpu_ticks_since_last_signal], rax;

        // Threshold check.
        cmp rax, 6;
        jb  vgpu_isrt_out;

        // Warning fires ONCE per boot.
        mov rax, [rip + _vgpu_stall_warned];
        cmp rax, 0;
        jne vgpu_isrt_after_warn;
        mov rax, 1;
        mov [rip + _vgpu_stall_warned], rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + vgpu_stall_msg];
        call klog_s1;
      vgpu_isrt_after_warn:

        // Synthetic vblank tick.
        mov rdi, 2;
        mov rsi, 1;
        call dpy_timeline_vblank_signal;

        // Consume one pending flush + reset counter.
        lea r10, [rip + _vgpu_ctrl_pending_flushes];
        mov rax, [r10];
        cmp rax, 0;
        je  vgpu_isrt_after_drain;
        sub rax, 1;
        mov [r10], rax;
      vgpu_isrt_after_drain:
        xor rax, rax;
        mov [rip + _vgpu_ticks_since_last_signal], rax;

      vgpu_isrt_out:
        add rsp, 8;
        ret
      }
    }
}
