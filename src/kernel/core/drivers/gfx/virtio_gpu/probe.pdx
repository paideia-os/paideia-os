// src/kernel/core/drivers/gfx/virtio_gpu/probe.pdx -- R103.M1-001 (paideia-os #2154)
//
// virtio-gpu-pci PCI probe + modern virtio 1.0 BAR / vendor-cap
// discovery.
//
// Structurally identical to drivers/virtio_net/probe.pdx (R91.M3-001):
// walks _pci_devices, filters for the QEMU-published virtio-gpu-pci
// vendor+device pair:
//
//   vendor_id  = 0x1AF4 (Red Hat / virtio)
//   device_id  = 0x1050 (modern virtio-gpu, virtio 1.1)
//   device_id  = 0x1010 (transitional; ignored at R103 -- MVP is modern-only,
//                        matching how virtio_net treats its 0x1000 arm as
//                        subsystem-gated)
//
// The R103.M1-001 issue-text names both device_ids; this landing accepts
// only the modern variant (0x1050) and records the transitional path as
// a deferred follow-on (§0 below). Real deployments on QEMU 4.0+ default
// to the modern variant so this covers every smoke-mode boot.
//
// -----------------------------------------------------------------------------
// _virtio_gpu_devices record layout (64 B, @align(8))
// -----------------------------------------------------------------------------
//
//   +0    u16 seg
//   +2    u8  bus
//   +3    u8  dev
//   +4    u8  fn
//   +5    u8  is_modern             // always 1 at this landing
//   +6    u16 device_id
//   +8    u64 bar4_pa               // modern virtio-pci cfg carrier
//   +16   u64 _pad0                 // (reserved to keep field offsets
//                                   //  parallel with virtio_net_devices)
//   +24   u16 common_cfg_off        // byte offset within common_cfg_bar
//   +26   u16 notify_off            // byte offset within notify_bar
//   +28   u16 isr_off               // byte offset within isr_bar
//   +30   u16 device_cfg_off        // byte offset within device_cfg_bar
//   +32   u8  common_cfg_bar
//   +33   u8  notify_bar
//   +34   u8  isr_bar
//   +35   u8  device_cfg_bar
//   +36   u32 notify_off_multiplier
//   +40   u16 cap_msix_off
//   +42   u16 _pad1
//   +44   u32 _pad2
//   +48   u64 notify_bar_va         // populated by controlq_init
//   +56   u64 common_cfg_bar_va     // populated by controlq_init
//
// -----------------------------------------------------------------------------
// paideia-as encoder-gap posture (v0.24.x)
// -----------------------------------------------------------------------------
//
//   G1: sized MMIO stores via mov_b / mov_w / mov_d.
//   G4: full-register compares; no `add reg, [mem]`, no `cmp reg, [mem]`.
//   No mov_bzx / mov_wzx: byte / word loads via `xor rax,rax; mov_b/w
//       rax, [mem]` (rtl8139/probe + virtio_net/probe precedent).
//
// Reserved-label discipline: labels prefixed `vgpu_pb_`.

module Probe = structure {

  pub let VIRTIO_VENDOR_ID           : u64 = 0x1AF4
  pub let VIRTIO_GPU_DID_MODERN      : u64 = 0x1050
  pub let VIRTIO_GPU_MAX_DEVS        : u64 = 1
  pub let VIRTIO_GPU_DEV_REC_SIZE    : u64 = 64

  pub let VIRTIO_PCI_CAP_COMMON_CFG  : u64 = 1
  pub let VIRTIO_PCI_CAP_NOTIFY_CFG  : u64 = 2
  pub let VIRTIO_PCI_CAP_ISR_CFG     : u64 = 3
  pub let VIRTIO_PCI_CAP_DEVICE_CFG  : u64 = 4
  pub let VIRTIO_PCI_VENDOR_CAP_ID   : u64 = 0x09

  // 1 x 64 B = 64 B = 8 u64.
  pub let mut _virtio_gpu_devices      : [u64; 8] = uninit @align(8)
  pub let mut _virtio_gpu_device_count : u64      = 0

  // Fingerprint (all-lowercase, no OK_TOK trigger). NUL-terminated.
  pub let vgpu_probe_ok_msg : [u8; 20] = "r103 vgpu probe ok\0\0"

  // ==========================================================================
  // virtio_gpu_probe() -> u64
  //
  // Returns rax = number of virtio-gpu devices discovered (0..1).
  //
  // Register plan (mirrors virtio_net_probe with the vendor triple
  // retargeted to (0x1AF4, 0x1050) and no transitional-arm subsystem
  // gate):
  //   rbx = i (loop cursor into _pci_devices)
  //   r12 = _pci_device_count
  //   r13 = j (write cursor into _virtio_gpu_devices, capped at 1)
  //   r14 = &_pci_devices[i]
  //   r15 = &_virtio_gpu_devices[j] / spilled to [rsp+48]
  //   rbp = cap-walk cursor
  //
  //   Scratch layout (88 B; 6 pushes = 48 B; entry rsp%16==8 -> 56 (%16==8);
  //   sub rsp,88 -> rsp%16==0 aligned):
  //     [rsp+0]  seg (u64)
  //     [rsp+8]  bus
  //     [rsp+16] dev
  //     [rsp+24] fn
  //     [rsp+32] bar4_pa
  //     [rsp+40] reserved (unused; keeps virtio_net's scratch offsets)
  //     [rsp+48] record_ptr spill
  //     [rsp+56] cap-walk visit counter
  //     [rsp+64] cap-walk cfg_type spill
  //     [rsp+72] cap-walk bar_idx spill
  //     [rsp+80] pad / spare
  // ==========================================================================

  pub let virtio_gpu_probe : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R103.M1-001 (paideia-os #2154). virtio-gpu-pci PCI probe. Retargets virtio_net_probe (drivers/virtio_net/probe.pdx L192) to vendor+device (0x1AF4, 0x1050) with a modern-only match (no transitional subsystem-id gate) and a MAX_DEVS=1 cap. Body identical in shape to virtio_net_probe: 6-push callee-save, 88-byte scratch frame, BAR4 discovery (single MEM64 carrier at config +0x20), inline vendor-cap walk (cap_id 0x09) capturing per-cfg_type (bar_idx, offset) tuples plus notify_off_multiplier. Writes record fields per §record-layout (u16 seg @+0, u8 bus/dev/fn @+2..+4, u8 is_modern=1 @+5, u16 device_id @+6, u64 bar4_pa @+8, u16 common_cfg_off @+24, u16 notify_off @+26, u16 isr_off @+28, u16 device_cfg_off @+30, u8 common_cfg_bar @+32, u8 notify_bar @+33, u8 isr_bar @+34, u8 device_cfg_bar @+35, u32 notify_off_multiplier @+36, u16 cap_msix_off @+40). Emits klog_s1_d1 fingerprint (LEVEL_INFO=3, SUBSYS_DRV_, vgpu_probe_ok_msg, k_count, count). Labels prefixed vgpu_pb_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 88;

        xor r13, r13;
        mov r12, [rip + _pci_device_count];
        xor rbx, rbx;

      vgpu_pb_loop:
        cmp rbx, r12;
        jae vgpu_pb_done;

        mov rax, rbx;
        shl rax, 5;                              // stride 32
        lea r14, [rip + _pci_devices];
        add r14, rax;

        xor rax, rax;
        mov_w rax, [r14 + 8];
        cmp rax, 0x1AF4;
        jne vgpu_pb_next;

        xor rax, rax;
        mov_w rax, [r14 + 10];
        cmp rax, 0x1050;                         // modern virtio-gpu
        jne vgpu_pb_next;

        // Stash BDF.
        xor rax, rax;
        mov_w rax, [r14 + 0];
        mov [rsp + 0], rax;
        xor rax, rax;
        mov_b rax, [r14 + 2];
        mov [rsp + 8], rax;
        xor rax, rax;
        mov_b rax, [r14 + 3];
        mov [rsp + 16], rax;
        xor rax, rax;
        mov_b rax, [r14 + 4];
        mov [rsp + 24], rax;

        // Overflow guard (MAX_DEVS = 1).
        cmp r13, 1;
        jae vgpu_pb_next;

        // Zero bar4 scratch.
        xor rax, rax;
        mov [rsp + 32], rax;

        // Read BAR4 (config +0x20) -- modern cfg carrier.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x20;
        call pci_config_read_u32;

        mov r10, rax;
        cmp r10, 0;
        je  vgpu_pb_next;                        // no modern cfg
        mov r11, r10;
        and r11, 1;
        cmp r11, 0;
        jne vgpu_pb_next;                        // I/O BAR nonstandard

        // MEM check bits [2:1]. MEM32 -> mask &~0xF; MEM64 -> compose hi.
        mov r11, r10;
        shr r11, 1;
        and r11, 3;
        cmp r11, 2;
        je  vgpu_pb_bar4_64;

        // MEM32.
        mov r15, r10;
        and r15, 0xFFFFFFFFFFFFFFF0;
        mov [rsp + 32], r15;
        jmp vgpu_pb_bar_done;

      vgpu_pb_bar4_64:
        mov [rsp + 32], r10;

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x24;
        call pci_config_read_u32;

        shl rax, 32;
        mov r10, [rsp + 32];
        and r10, 0xFFFFFFFFFFFFFFF0;
        or  rax, r10;
        mov [rsp + 32], rax;

      vgpu_pb_bar_done:
        // Compute r15 = &_virtio_gpu_devices[j] = base + (j << 6).
        mov r11, r13;
        shl r11, 6;
        lea r15, [rip + _virtio_gpu_devices];
        add r15, r11;

        // Zero 64-byte record.
        xor r10, r10;
        mov [r15 + 0],  r10;
        mov [r15 + 8],  r10;
        mov [r15 + 16], r10;
        mov [r15 + 24], r10;
        mov [r15 + 32], r10;
        mov [r15 + 40], r10;
        mov [r15 + 48], r10;
        mov [r15 + 56], r10;

        // Spill record_ptr for reload after nested reads.
        mov [rsp + 48], r15;

        // seg u16 @+0, bus/dev/fn u8s @+2/+3/+4, is_modern=1 @+5.
        mov r10, [rsp + 0];
        mov_w [r15 + 0], r10;
        mov r10, [rsp + 8];
        mov_b [r15 + 2], r10;
        mov r10, [rsp + 16];
        mov_b [r15 + 3], r10;
        mov r10, [rsp + 24];
        mov_b [r15 + 4], r10;
        mov r10, 1;
        mov_b [r15 + 5], r10;

        // device_id u16 @+6.
        xor r10, r10;
        mov_w r10, [r14 + 10];
        mov_w [r15 + 6], r10;

        // bar4_pa u64 @+8.
        mov r10, [rsp + 32];
        mov [r15 + 8], r10;

        // ---------- Vendor-cap walk ----------
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x34;
        call pci_config_read_u8;

        and rax, 0xFC;
        mov rbp, rax;

        xor rax, rax;
        mov [rsp + 56], rax;

      vgpu_pb_cap_loop:
        cmp rbp, 0;
        je  vgpu_pb_cap_done;

        mov rax, [rsp + 56];
        cmp rax, 48;
        jae vgpu_pb_cap_done;

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        call pci_config_read_u8;

        cmp rax, 0x09;
        jne vgpu_pb_cap_advance;

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 3;
        call pci_config_read_u8;

        cmp rax, 1;
        jb  vgpu_pb_cap_advance;
        cmp rax, 4;
        ja  vgpu_pb_cap_advance;

        mov [rsp + 64], rax;                     // cfg_type spill

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 4;
        call pci_config_read_u8;
        mov [rsp + 72], rax;                     // bar_idx spill

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 8;
        call pci_config_read_u32;

        mov r15, [rsp + 48];
        mov r11, [rsp + 64];
        mov r10, [rsp + 72];

        cmp r11, 1;
        je  vgpu_pb_cap_common;
        cmp r11, 2;
        je  vgpu_pb_cap_notify;
        cmp r11, 3;
        je  vgpu_pb_cap_isr;
        cmp r11, 4;
        je  vgpu_pb_cap_device;
        jmp vgpu_pb_cap_advance;

      vgpu_pb_cap_common:
        mov_w [r15 + 24], rax;
        mov_b [r15 + 32], r10;
        jmp vgpu_pb_cap_advance;

      vgpu_pb_cap_notify:
        mov_w [r15 + 26], rax;
        mov_b [r15 + 33], r10;

        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 16;
        call pci_config_read_u32;

        mov r15, [rsp + 48];
        mov_d [r15 + 36], rax;
        jmp vgpu_pb_cap_advance;

      vgpu_pb_cap_isr:
        mov_w [r15 + 28], rax;
        mov_b [r15 + 34], r10;
        jmp vgpu_pb_cap_advance;

      vgpu_pb_cap_device:
        mov_w [r15 + 30], rax;
        mov_b [r15 + 35], r10;

      vgpu_pb_cap_advance:
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, rbp;
        add r8, 1;
        call pci_config_read_u8;

        and rax, 0xFC;
        mov rbp, rax;

        mov rax, [rsp + 56];
        add rax, 1;
        mov [rsp + 56], rax;

        jmp vgpu_pb_cap_loop;

      vgpu_pb_cap_done:
        // MSI-X cap probe.
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 16];
        mov rcx, [rsp + 24];
        mov r8, 0x11;
        call pci_find_cap;

        mov r15, [rsp + 48];
        mov_w [r15 + 40], rax;

        // Publish common_cfg_pa for the consumer module.
        // PA = (common_cfg_bar == 4 ? bar4_pa : 0) + common_cfg_off.
        xor rax, rax;
        mov_b rax, [r15 + 32];                   // common_cfg_bar
        cmp rax, 4;
        jne vgpu_pb_cc_skip;
        mov r10, [r15 + 8];                      // bar4_pa
        xor rax, rax;
        mov_w rax, [r15 + 24];                   // common_cfg_off
        add r10, rax;
        mov [rip + _virtio_gpu_common_cfg_pa], r10;
      vgpu_pb_cc_skip:

        add r13, 1;

      vgpu_pb_next:
        add rbx, 1;
        jmp vgpu_pb_loop;

      vgpu_pb_done:
        mov [rip + _virtio_gpu_device_count], r13;

        // Fingerprint (emitted every boot -- count=0 branch is still a
        // grep-assertable witness).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + vgpu_probe_ok_msg];
        lea rcx, [rip + k_count];
        mov r8, r13;
        call klog_s1_d1;

        mov rax, r13;

        add rsp, 88;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
