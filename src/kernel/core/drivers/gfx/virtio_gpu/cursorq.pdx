// src/kernel/core/drivers/gfx/virtio_gpu/cursorq.pdx -- R103.M1-005
//                                                       (paideia-os #2158)
//
// Cursor virtqueue (queue index 1) minimal-init stub. The R103 MVP
// scope (design/graphics/r101-kernel-plan.md §R103.M1-005) does NOT
// exercise cursor-plane updates; those are a G7 compositor concern.
// This landing programs the queue slot so the device sees it live --
// keeping the compositor's cursor path in G7 from needing a queue re-
// init later -- without any refill or notify traffic.
//
// Two .bss pages (descriptor + shared avail/used) match controlq's
// shape one-for-one. If a follow-on wave grows the cursor path into a
// live 60-Hz cursor stream, this file's public surface (queue base +
// doorbell) can be reused verbatim.
//
// Encoder + label discipline: labels prefixed `vgpu_cq2_`.

module Cursorq = structure {

  pub let VGPU_CURSORQ_ID              : u64 = 1

  pub let mut _vgpu_cursor_desc_pg       : [u64; 512] = uninit @align(4096)
  pub let mut _vgpu_cursor_avail_used_pg : [u64; 512] = uninit @align(4096)
  pub let mut _vgpu_cursor_doorbell_va   : u64 = 0

  pub let vgpu_cursorq_init_ok_msg : [u8; 24] = "r103 vgpu cursorq init\0\0"

  // ==========================================================================
  // virtio_gpu_cursorq_init() -> u64
  //
  // Same shape as ctrlq_init with queue_id=1. See controlq.pdx §M1-004
  // for the register plan; sole difference is QUEUE_SELECT=1 and the
  // page pair changes.
  // ==========================================================================

  pub let virtio_gpu_cursorq_init : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R103.M1-005: cursor-queue (id 1) minimal-init stub. Same COMMON_CFG programming path as ctrlq_init with queue_id=1 and QUEUE_DESC / QUEUE_DRIVER / QUEUE_DEVICE bound to the cursor-pair pages. Keeps the queue live so a G7 compositor cursor path does not need to re-init. Reuses _vgpu_notify_bar_va -- must run AFTER ctrlq_init has mapped BAR4 (otherwise silently no-op with VGPU_VQ_ERR_NO_BAR to avoid a duplicate mapping). Labels prefixed vgpu_cq2_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 8;

        mov  rbx, [rip + _virtio_gpu_common_cfg_pa];
        cmp  rbx, 0;
        jne  vgpu_cq2_have_bar;
        mov  rax, 0xFFFFFFFFFFFFFFED;
        jmp  vgpu_cq2_done;

      vgpu_cq2_have_bar:
        mov  r13, [rip + _vgpu_notify_bar_va];
        cmp  r13, 0;
        jne  vgpu_cq2_have_notify;
        mov  rax, 0xFFFFFFFFFFFFFFED;
        jmp  vgpu_cq2_done;

      vgpu_cq2_have_notify:
        lea  r12, [rip + _virtio_gpu_devices];

        // QUEUE_SELECT = 1.
        mov  rdi, rbx;
        mov  rsi, 0x16;
        mov  rdx, 1;
        call vgpu_cc_write_u16;

        // QUEUE_SIZE = 16 (no separate size probe -- cursor traffic is
        // trivial; if the device rejects, we simply leave the queue
        // disabled and skip further cursor programming below).
        mov  rdi, rbx;
        mov  rsi, 0x18;
        call vgpu_cc_read_u16;
        cmp  rax, 16;
        jae  vgpu_cq2_size_ok;
        mov  rax, 0xFFFFFFFFFFFFFFE0;
        jmp  vgpu_cq2_done;

      vgpu_cq2_size_ok:
        mov  rdi, rbx;
        mov  rsi, 0x18;
        mov  rdx, 16;
        call vgpu_cc_write_u16;

        // Read QUEUE_NOTIFY and compute cursor doorbell.
        mov  rdi, rbx;
        mov  rsi, 0x1E;
        call vgpu_cc_read_u16;
        mov  r14, rax;
        // Zero-extended u32 load of notify_off_multiplier from device+36.
        mov  rax, r12;
        add  rax, 36;
        mov  eax, [rax];
        imul rax, r14;
        mov  r15, r13;
        add  r15, rax;
        mov  [rip + _vgpu_cursor_doorbell_va], r15;

        // QUEUE_DESC lo/hi.
        lea  rax, [rip + _vgpu_cursor_desc_pg];
        mov  rdi, rbx;
        mov  rsi, 0x20;
        mov  rdx, rax;
        call vgpu_cc_write_u32;
        lea  rax, [rip + _vgpu_cursor_desc_pg];
        shr  rax, 32;
        mov  rdi, rbx;
        mov  rsi, 0x24;
        mov  rdx, rax;
        call vgpu_cc_write_u32;

        // QUEUE_DRIVER lo/hi.
        lea  rax, [rip + _vgpu_cursor_avail_used_pg];
        mov  rdi, rbx;
        mov  rsi, 0x28;
        mov  rdx, rax;
        call vgpu_cc_write_u32;
        lea  rax, [rip + _vgpu_cursor_avail_used_pg];
        shr  rax, 32;
        mov  rdi, rbx;
        mov  rsi, 0x2C;
        mov  rdx, rax;
        call vgpu_cc_write_u32;

        // QUEUE_DEVICE lo/hi (used ring at +2048).
        lea  rax, [rip + _vgpu_cursor_avail_used_pg];
        add  rax, 2048;
        mov  rdi, rbx;
        mov  rsi, 0x30;
        mov  rdx, rax;
        call vgpu_cc_write_u32;
        lea  rax, [rip + _vgpu_cursor_avail_used_pg];
        add  rax, 2048;
        shr  rax, 32;
        mov  rdi, rbx;
        mov  rsi, 0x34;
        mov  rdx, rax;
        call vgpu_cc_write_u32;

        // QUEUE_ENABLE = 1.
        mov  rdi, rbx;
        mov  rsi, 0x1C;
        mov  rdx, 1;
        call vgpu_cc_write_u16;

        mov  rdi, 3;
        lea  rsi, [rip + SUBSYS_DRV_];
        lea  rdx, [rip + vgpu_cursorq_init_ok_msg];
        call klog_s1;

        xor  rax, rax;

      vgpu_cq2_done:
        add  rsp, 8;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbp;
        pop  rbx;
        ret
      }
    }
}
