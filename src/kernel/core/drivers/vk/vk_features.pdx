// src/kernel/core/drivers/vk/vk_features.pdx -- G3.M3 substrate
//
// G3.M3-002 (#1468): VK_KHR_present_id integration.
// G3.M3-003 (#1469): VK_KHR_present_wait integration (thin wrapper
//                    delegating to vfc_wait_for_present).
// G3.M3-004 (#1470): VK_EXT_swapchain_maintenance1 shape --
//                    release-on-discard.
// G3.M3-005 (#1471): P3 acceptance -- fractional scale factor as
//                    first-class geometry param.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER OWNS
// =============================================================================
//
// * A per-surface monotone present_id counter (M3-002). vkQueue-
//   PresentKHR with the KHR_present_id extension attaches an ID to
//   each frame; the counter here supplies the next ID for a given
//   surface so a client's IDs are strictly monotone even across
//   swapchain recreations (which reset the swapchain but not the
//   surface).
//
// * A thin wrapper over vfc_wait_for_present that adds a
//   per-surface "highest observed" cache so a wait for an already-
//   observed ID returns immediately without a queue scan (M3-003).
//
// * The release-on-discard seam: when MAILBOX drops a pending
//   frame, this seam transitions the discarded image to
//   VKSI_ST_DISCARDED and pushes a VFC_EV_DISCARD record so a
//   waiter on that ID unblocks with a distinguished status
//   (M3-004).
//
// * A fractional-scale-factor validator that P3 acceptance asserts
//   against the surface's row (M3-005). The validator is the ONE
//   place that answers "is this (num, den) a legal scale?" so a
//   compositor cannot silently accept a non-normalized fraction.
//
// =============================================================================
// SECTION 1  FAILURE TAXONOMY 0xFFFFEDB0..0xFFFFEDBF
// =============================================================================

module VkFeatures = structure {

  // Per-surface present_id counters. 8 slots (mirrors surface table).
  // Each: {next_id:u64, highest_observed:u64}.
  pub let mut _vkf_present_id : [u64; 16] = uninit @align(64)
  pub let mut _vkf_stats      : [u64; 4]  = uninit @align(64)

  pub let VKF_ST_ISSUES   : u64 = 0
  pub let VKF_ST_WAITS    : u64 = 1
  pub let VKF_ST_DISCARDS : u64 = 2
  pub let VKF_ST_REFUSED  : u64 = 3

  pub let VKF_OK              : u64 = 0
  pub let VKF_ERR_BAD_SURFACE : u64 = 0xFFFFEDBF
  pub let VKF_ERR_BAD_ID      : u64 = 0xFFFFEDBE
  pub let VKF_ERR_BAD_SCALE   : u64 = 0xFFFFEDBD
  pub let VKF_ERR_NO_IMAGE    : u64 = 0xFFFFEDBC
  pub let VKF_ERR_TIMEOUT     : u64 = 0xFFFFEDBB

  pub let vkf_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-* clear counters + present_id state.",
      block: {
        lea r10, [rip + _vkf_present_id];
        xor rax, rax;
        xor rcx, rcx;
      vkf_rs_pid:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  vkf_rs_pid;

        lea r10, [rip + _vkf_stats];
        xor rcx, rcx;
      vkf_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vkf_rs_st;
        ret
      }
    }

  pub let vkf_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-* counter bump.",
      block: {
        cmp rdi, 4;
        jae vkf_nt_out;
        lea r10, [rip + _vkf_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vkf_nt_out:
        ret
      }
    }

  pub let vkf_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-* counter read.",
      block: {
        cmp rdi, 4;
        jae vkf_st_zero;
        lea r10, [rip + _vkf_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vkf_st_zero:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vkf_issue_present_id(surf_row) -> present_id
  //
  // Monotone next present_id for this surface. Post-increment (the
  // returned value is the ID for the frame the client is about to
  // queue). Wrap at u64 -- 2^64 present_ids at 240 Hz is > 2 billion
  // years, so wrap cannot be observed.
  // =========================================================================
  pub let vkf_issue_present_id : (u64) -> u64 !{mem} @{} =
    fn (surf_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-002 (#1468): monotone next ID for surface.",
      block: {
        cmp rdi, 8;
        jae vkf_ip_bad;
        lea r10, [rip + _vkf_present_id];
        mov r11, rdi;
        shl r11, 4;                       // 2 u64 per surface
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        add r11, 1;
        mov [r10 + 0], r11;

        push rax;
        mov rdi, 0;
        call vkf_note;
        pop rax;
        ret;
      vkf_ip_bad:
        mov rax, 0xFFFFEDBF;
        ret
      }
    }

  // vkf_last_present_id(surf_row) -> highest_observed
  pub let vkf_last_present_id : (u64) -> u64 !{mem} @{} =
    fn (surf_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-002 (#1468): read highest observed ID (0 if none seen).",
      block: {
        cmp rdi, 8;
        jae vkf_lp_bad;
        lea r10, [rip + _vkf_present_id];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 8];
        ret;
      vkf_lp_bad:
        mov rax, 0xFFFFEDBF;
        ret
      }
    }

  // vkf_mark_observed(surf_row, present_id) -> ()
  //
  // Called by the display-timeline signal path after a present has
  // landed. Advances highest_observed to max(current, present_id).
  pub let vkf_mark_observed : (u64, u64) -> u64 !{mem} @{} =
    fn (surf_row: u64) (present_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-002 (#1468): advance highest_observed if present_id > current.",
      block: {
        cmp rdi, 8;
        jae vkf_mo_bad;
        lea r10, [rip + _vkf_present_id];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 8];
        cmp rsi, rax;
        jbe vkf_mo_ok;
        mov [r10 + 8], rsi;
      vkf_mo_ok:
        xor rax, rax;
        ret;
      vkf_mo_bad:
        mov rax, 0xFFFFEDBF;
        ret
      }
    }

  // =========================================================================
  // vkf_wait_present(surf_row, target_id, timeout_ns) -> ts | err
  //
  // Fast path: if highest_observed >= target_id return the last
  // known timestamp (0 -- the timestamp is lost; a slow path is
  // preferred if the client cares). Slow path: delegate to
  // vfc_wait_for_present.
  // =========================================================================
  pub let vkf_wait_present : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (surf_row: u64) (target_id: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "G3.M3-003 (#1469): fast-path against highest_observed cache; slow-path delegates to vfc_wait_for_present.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;
        mov rbx, rdx;

        mov rdi, r12;
        call vkf_last_present_id;
        mov r10, 0xFFFFEDBF;
        cmp rax, r10;
        je  vkf_wp_bad;

        cmp rax, r13;
        jae vkf_wp_fast;

        mov rdi, 1;
        call vkf_note;

        mov rdi, r13;
        mov rsi, rbx;
        call vfc_wait_for_present;
        jmp vkf_wp_out;

      vkf_wp_fast:
        xor rax, rax;
        jmp vkf_wp_out;
      vkf_wp_bad:
        mov rdi, 3;
        call vkf_note;
        mov rax, 0xFFFFEDBF;

      vkf_wp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vkf_discard_release(image_row, present_id) -> OK | err
  //
  // VK_EXT_swapchain_maintenance1 release-on-discard: transition
  // image to VKSI_ST_DISCARDED and push a VFC_EV_DISCARD record
  // whose payload names the present_id. A waiter on that ID
  // observes the discard rather than blocking forever.
  // =========================================================================
  pub let vkf_discard_release : (u64, u64) -> u64 !{mem} @{} =
    fn (image_row: u64) (present_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M3-004 (#1470): mark DISCARDED + push VFC_EV_DISCARD carrying present_id. maintenance1 shape. Three callee-save pushes (odd) keep rsp aligned.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call vksi_tail_valid;
        cmp rax, 0;
        je  vkf_dr_no_img;

        mov rdi, r12;
        mov rsi, 5;                       // VKSI_ST_DISCARDED
        call vksi_row_set_state;

        mov rdi, r13;
        xor rsi, rsi;                     // payload = 0 (discard has no ts)
        call vfc_push;

        mov rdi, 2;
        call vkf_note;

        xor rax, rax;
        jmp vkf_dr_out;

      vkf_dr_no_img:
        mov rdi, 3;
        call vkf_note;
        mov rax, 0xFFFFEDBC;

      vkf_dr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vkf_scale_valid(num, den) -> 1 | 0
  //
  // P3 acceptance: fractional scale factor as first-class geometry
  // param. Legal iff 0 < num, den <= 65535, AND the fraction is in
  // NORMAL form (gcd(num, den) = 1). The gcd requirement is what
  // makes the scale factor first-class: (3, 2) and (6, 4) name the
  // same scale but a compositor deciding "is this a scale I can
  // scan out directly?" cares about the reduced form.
  // =========================================================================
  pub let vkf_gcd : (u64, u64) -> u64 !{} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M3-005 (#1471): Euclidean gcd. Zero-arg returns non-zero counterpart or 0.",
      block: {
        mov rax, rdi;
        mov rcx, rsi;
      vkf_gc_loop:
        cmp rcx, 0;
        je  vkf_gc_out;
        xor rdx, rdx;
        div rcx;
        mov rax, rcx;
        mov rcx, rdx;
        jmp vkf_gc_loop;
      vkf_gc_out:
        ret
      }
    }

  pub let vkf_scale_valid : (u64, u64) -> u64 !{} @{} =
    fn (num: u64) (den: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M3-005 (#1471): 1 iff 0 < num, den <= 65535 AND gcd(num, den) == 1. P3 first-class scale.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        cmp r12, 0;
        je  vkf_sv_no;
        cmp r13, 0;
        je  vkf_sv_no;
        mov r10, 65535;
        cmp r12, r10;
        ja  vkf_sv_no;
        cmp r13, r10;
        ja  vkf_sv_no;

        mov rdi, r12;
        mov rsi, r13;
        call vkf_gcd;
        cmp rax, 1;
        jne vkf_sv_no;

        mov rax, 1;
        jmp vkf_sv_out;

      vkf_sv_no:
        xor rax, rax;

      vkf_sv_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
