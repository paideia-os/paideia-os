// src/kernel/core/drivers/vk/bench.pdx -- G3.M4 substrate
//
// G3.M4-001 (#1472): presentation-time-driven adaptive rendering
//                    example -- the scaffold a client uses to pick
//                    render complexity from observed frame budget.
// G3.M4-002 (#1473): swapchain benchmark (acquire->submit->present
//                    latency) -- the primitive a userspace bench
//                    driver invokes to measure the three phases.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER RECORDS
// =============================================================================
//
// A ring of the last 64 completed present cycles. Each record:
//   {acquire_ns, submit_ns, present_ns, refresh_ns}
// where each field is a hpet_now_ns reading captured at the named
// phase transition. From these three deltas the client's adaptive
// renderer picks its next-frame complexity (M4-001), and a bench
// tool computes p50/p95/p99 of the acquire->present tail (M4-002).
//
// =============================================================================
// SECTION 1  ADAPTIVE POLICY (M4-001)
// =============================================================================
//
// The simplest policy that this substrate supports (a client is free
// to layer more): "if p95 acquire->present of the last N frames is
// above 90% of refresh, shed one complexity level; if below 60%,
// raise one." The recording is here so ONE ring answers both the
// bench driver's export and the adaptive policy's read.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEDA0..0xFFFFEDAF
// =============================================================================

module Bench = structure {

  pub let VKB_RING_LEN : u64 = 64

  // Ring: 64 records * 4 u64 = 256 u64. Plus head cursor + full flag.
  pub let mut _vkb_ring   : [u64; 256] = uninit @align(64)
  pub let mut _vkb_cursor : [u64; 2]   = uninit @align(64)   // [head, wrapped]
  pub let mut _vkb_stats  : [u64; 4]   = uninit @align(64)

  pub let VKB_ST_RECORDS  : u64 = 0
  pub let VKB_ST_QUERIES  : u64 = 1
  pub let VKB_ST_ADAPTIVE : u64 = 2
  pub let VKB_ST_REFUSED  : u64 = 3

  pub let VKB_OK              : u64 = 0
  pub let VKB_ERR_BAD_ARG     : u64 = 0xFFFFEDAF
  pub let VKB_ERR_NO_DATA     : u64 = 0xFFFFEDAE
  pub let VKB_ERR_BAD_PERC    : u64 = 0xFFFFEDAD

  // Complexity levels the adaptive policy shifts between.
  pub let VKB_COMPLEXITY_MIN  : u64 = 0
  pub let VKB_COMPLEXITY_MAX  : u64 = 4    // 0..4

  pub let vkb_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-* clear ring + counters.",
      block: {
        lea r10, [rip + _vkb_ring];
        xor rax, rax;
        xor rcx, rcx;
      vkb_rs_ring:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  vkb_rs_ring;

        lea r10, [rip + _vkb_cursor];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        lea r10, [rip + _vkb_stats];
        xor rcx, rcx;
      vkb_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vkb_rs_st;
        ret
      }
    }

  pub let vkb_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-* counter bump.",
      block: {
        cmp rdi, 4;
        jae vkb_nt_out;
        lea r10, [rip + _vkb_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vkb_nt_out:
        ret
      }
    }

  pub let vkb_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-* counter read.",
      block: {
        cmp rdi, 4;
        jae vkb_st_zero;
        lea r10, [rip + _vkb_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vkb_st_zero:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vkb_record(acquire_ns, submit_ns, present_ns, refresh_ns)
  //
  // Push one bench record. Wraps the head. `wrapped` bit sticks
  // (once wrapped, always -- so the query knows to use the full
  // ring length instead of head).
  // =========================================================================
  pub let vkb_record : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (acq: u64) (sub: u64) (pre: u64) (ref_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-001 (#1472) + G3.M4-002 (#1473): append one record to the 64-deep ring.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        lea r10, [rip + _vkb_cursor];
        mov rbx, [r10 + 0];

        lea r11, [rip + _vkb_ring];
        mov rax, rbx;
        shl rax, 5;                        // 4 u64 * 8 = 32 per slot
        add r11, rax;
        mov [r11 + 0],  r12;
        mov [r11 + 8],  r13;
        mov [r11 + 16], r14;
        mov [r11 + 24], r15;

        add rbx, 1;
        cmp rbx, 64;
        jb  vkb_rc_head_ok;
        xor rbx, rbx;
        mov rax, 1;
        mov [r10 + 8], rax;                // wrapped
      vkb_rc_head_ok:
        mov [r10 + 0], rbx;

        mov rdi, 0;
        call vkb_note;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // vkb_count -> number of valid records (min(head, RING_LEN if
  // wrapped)).
  pub let vkb_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-002 (#1473): live record count.",
      block: {
        lea r10, [rip + _vkb_cursor];
        mov rax, [r10 + 8];
        cmp rax, 0;
        je  vkb_cn_head;
        mov rax, 64;
        ret;
      vkb_cn_head:
        mov rax, [r10 + 0];
        ret
      }
    }

  // vkb_latency(idx) -> (present_ns - acquire_ns) for record idx.
  pub let vkb_latency : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-002 (#1473): compute record's acquire->present delta.",
      block: {
        mov r10, 64;
        cmp rdi, r10;
        jae vkb_la_bad;
        lea r10, [rip + _vkb_ring];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        mov rcx, [r10 + 0];
        sub rax, rcx;
        ret;
      vkb_la_bad:
        mov rax, 0xFFFFEDAF;
        ret
      }
    }

  // =========================================================================
  // vkb_average_latency -> mean acquire->present ns across valid records
  //
  // Simple mean (not a percentile). A percentile ranker is deferred
  // to userland -- the kernel-side ring keeps a bounded footprint
  // and exports the raw records for a fuller analysis to walk.
  // =========================================================================
  pub let vkb_average_latency : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-002 (#1473): mean latency over valid records; VKB_ERR_NO_DATA on empty ring.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        call vkb_count;
        cmp rax, 0;
        je  vkb_al_no_data;
        mov r13, rax;

        xor rbx, rbx;
        xor r12, r12;
      vkb_al_loop:
        cmp r12, r13;
        jae vkb_al_avg;
        mov rdi, r12;
        call vkb_latency;
        add rbx, rax;
        add r12, 1;
        jmp vkb_al_loop;

      vkb_al_avg:
        mov rax, rbx;
        xor rdx, rdx;
        div r13;
        mov r14, rax;
        mov rdi, 1;
        call vkb_note;
        mov rax, r14;
        jmp vkb_al_out;

      vkb_al_no_data:
        mov rax, 0xFFFFEDAE;

      vkb_al_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vkb_adaptive_complexity(current, refresh_ns) -> next_complexity
  //
  // Adaptive rendering policy: if average latency > 90% of
  // refresh_ns, shed one level (down to MIN). If < 60%, raise one
  // (up to MAX). Otherwise unchanged.
  // =========================================================================
  pub let vkb_adaptive_complexity : (u64, u64) -> u64 !{mem} @{} =
    fn (current: u64) (refresh_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M4-001 (#1472): shed one level above 90% refresh, raise below 60%. Bounded to [0, MAX=4].",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;

        call vkb_average_latency;
        mov r10, 0xFFFFEDAE;
        cmp rax, r10;
        je  vkb_ac_unchanged;
        mov rbx, rax;

        // 90% threshold = refresh_ns * 9 / 10
        mov rax, r13;
        imul rax, rax, 9;
        xor rdx, rdx;
        mov r10, 10;
        div r10;
        cmp rbx, rax;
        ja  vkb_ac_shed;

        // 60% threshold = refresh_ns * 6 / 10
        mov rax, r13;
        imul rax, rax, 6;
        xor rdx, rdx;
        mov r10, 10;
        div r10;
        cmp rbx, rax;
        jb  vkb_ac_raise;

      vkb_ac_unchanged:
        mov rax, r12;
        jmp vkb_ac_out;

      vkb_ac_shed:
        cmp r12, 0;
        je  vkb_ac_unchanged;
        mov r14, r12;
        sub r14, 1;
        mov rdi, 2;
        call vkb_note;
        mov rax, r14;
        jmp vkb_ac_out;

      vkb_ac_raise:
        mov r10, 4;
        cmp r12, r10;
        jae vkb_ac_unchanged;
        mov r14, r12;
        add r14, 1;
        mov rdi, 2;
        call vkb_note;
        mov rax, r14;

      vkb_ac_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
