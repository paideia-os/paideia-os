// src/kernel/core/drivers/vk/icd.pdx -- G3.M1 substrate
//
// G3.M1-002 (#1458): Vulkan ICD (Installable Client Driver) glue.
// G3.M1-003 (#1459): VK_paideia_surface extension registration.
// G3.M1-005 (#1461): Vulkan 1.3 loader integration + SPIR-V reader
//                    smoke.
//
// =============================================================================
// SECTION 0  WHAT THIS DRIVER IS AND WHAT IT IS NOT
// =============================================================================
//
// It is the kernel-side REGISTRY the Vulkan loader consults at
// vkCreateInstance time: which ICDs are installed, which extensions
// each declares, which physical devices each exposes. In a hosted
// stack this lives entirely in userland (/etc/vulkan/icd.d/*.json);
// in paideia the extension list is a kernel-visible fact so a
// compromised loader cannot declare an extension the underlying ICD
// does not implement.
//
// It is NOT the ICD itself (each ICD is a userspace driver process);
// NOT the loader (which lives in userland compositor + libvulkan);
// NOT the surface implementation (that lives in kind_vk_surface.pdx
// + drivers/vk/swapchain.pdx).
//
// =============================================================================
// SECTION 1  VK_paideia_surface EXTENSION (G3.M1-003 #1459)
// =============================================================================
//
// The paideia-native surface extension. Advertises:
//
//   VK_paideia_surface_spec_version         = 1
//   vkCreatePaideiaSurfaceKHR (analog)      = the create_swapchain
//                                             RPC on vk_surface_channel
//
// The extension is bound to the loader at initialization time and
// carries the (surface_channel_endpoint, output_slot_hint) pair a
// compositor client needs to open a surface. Registration is
// idempotent -- a re-init overwrites the record.
//
// =============================================================================
// SECTION 2  SPIR-V READER SMOKE (G3.M1-005 #1461)
// =============================================================================
//
// The loader's job of "did the shader bytecode arrive intact" is
// answered by a minimal SPIR-V magic-word check: bytes 0-3 must be
// 0x07230203 (little-endian SPIR-V magic). Anything else refuses at
// the loader boundary rather than being handed to the ICD.
//
// This is a substrate check, not a full validator -- the real
// SPIR-V validator lives in mesa's userland ICD. The kernel-side
// check exists so a malformed BO cannot pretend to be a shader.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEDD0..0xFFFFEDDF
// =============================================================================

module Icd = structure {

  // Extension IDs. Kept as ordinals so the loader can reason about
  // them without carrying vendor strings.
  pub let VKI_EXT_KHR_SURFACE           : u64 = 1
  pub let VKI_EXT_KHR_SWAPCHAIN         : u64 = 2
  pub let VKI_EXT_KHR_PRESENT_ID        : u64 = 3
  pub let VKI_EXT_KHR_PRESENT_WAIT      : u64 = 4
  pub let VKI_EXT_EXT_SWAPCHAIN_MAINT   : u64 = 5
  pub let VKI_EXT_PAIDEIA_SURFACE       : u64 = 6
  pub let VKI_EXT_MAX                   : u64 = 6

  // ICD registry: 4 slots. Each: {icd_key:u64, ext_bitmap:u64,
  //                               vk_version:u32, sig_ok:u32}.
  //   [+0]  icd_key    (non-zero = live)
  //   [+8]  ext_bitmap (bit i set iff extension i declared)
  //   [+16] vk_version | sig_ok<<32  (VK version major.minor.patch
  //                                   packed as (M<<22)|(m<<12)|patch;
  //                                   Vulkan 1.3 = 0x00403000)
  pub let mut _vki_icd_table : [u64; 12] = uninit @align(64)
  pub let mut _vki_stats     : [u64; 4]  = uninit @align(64)

  pub let VKI_ICD_MAX : u64 = 4

  pub let VKI_ST_REGS   : u64 = 0
  pub let VKI_ST_LOOKUP : u64 = 1
  pub let VKI_ST_SIGCHK : u64 = 2
  pub let VKI_ST_REFUSED : u64 = 3

  pub let VKI_OK                : u64 = 0
  pub let VKI_ERR_BAD_KEY       : u64 = 0xFFFFEDDF
  pub let VKI_ERR_BAD_EXT       : u64 = 0xFFFFEDDE
  pub let VKI_ERR_BAD_VERSION   : u64 = 0xFFFFEDDD
  pub let VKI_ERR_ENOSPC        : u64 = 0xFFFFEDDC
  pub let VKI_ERR_NOT_FOUND     : u64 = 0xFFFFEDDB
  pub let VKI_ERR_SPIRV_MAGIC   : u64 = 0xFFFFEDDA
  pub let VKI_ERR_SPIRV_TOO_SHORT : u64 = 0xFFFFEDD9

  // Vulkan 1.3.0 packed version.
  pub let VKI_VK_VERSION_1_3    : u64 = 0x00403000
  pub let VKI_VK_VERSION_MIN    : u64 = 0x00403000

  pub let VKI_SPIRV_MAGIC : u64 = 0x07230203

  pub let vki_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-002 (#1458): clear ICD table + counters.",
      block: {
        lea r10, [rip + _vki_icd_table];
        xor rax, rax;
        xor rcx, rcx;
      vki_rs_icd:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 12;
        jb  vki_rs_icd;

        lea r10, [rip + _vki_stats];
        xor rcx, rcx;
      vki_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  vki_rs_st;
        ret
      }
    }

  pub let vki_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-002 (#1458): counter bump.",
      block: {
        cmp rdi, 4;
        jae vki_nt_out;
        lea r10, [rip + _vki_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      vki_nt_out:
        ret
      }
    }

  pub let vki_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-002 (#1458): counter read.",
      block: {
        cmp rdi, 4;
        jae vki_st_zero;
        lea r10, [rip + _vki_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      vki_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let vki_ext_valid : (u64) -> u64 !{} @{} =
    fn (ext: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-003 (#1459): 1 iff ext in [1, VKI_EXT_MAX].",
      block: {
        cmp rdi, 0;
        je  vki_ev_no;
        mov r10, 6;
        cmp rdi, r10;
        ja  vki_ev_no;
        mov rax, 1;
        ret;
      vki_ev_no:
        xor rax, rax;
        ret
      }
    }

  pub let vki_version_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G3.M1-005 (#1461): 1 iff v >= VKI_VK_VERSION_1_3.",
      block: {
        mov r10, 0x00403000;
        cmp rdi, r10;
        jb  vki_vv_no;
        mov rax, 1;
        ret;
      vki_vv_no:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // vki_register(icd_key, ext_bitmap, vk_version) -> icd_row | err
  //
  // Register one ICD with its extension set and version. Idempotent
  // on icd_key -- a second register with the same key overwrites the
  // record (allows an ICD to update its extension bitmap without
  // teardown).
  // =========================================================================
  pub let vki_register : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (icd_key: u64) (ext_bitmap: u64) (vk_version: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-002 (#1458) + G3.M1-003 (#1459): claim ICD row; ext_bitmap has bit i set for each declared extension. Version >= 1.3. Five callee-save pushes (odd) keep rsp aligned.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je  vki_re_bad_key;

        mov rdi, r14;
        call vki_version_valid;
        cmp rax, 0;
        je  vki_re_bad_ver;

        // Look for existing entry with same key.
        xor rbx, rbx;
      vki_re_scan:
        cmp rbx, 4;
        jae vki_re_alloc;
        lea r10, [rip + _vki_icd_table];
        mov r11, rbx;
        imul r11, r11, 24;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, r12;
        je  vki_re_update;
        add rbx, 1;
        jmp vki_re_scan;

      vki_re_alloc:
        xor rbx, rbx;
      vki_re_ascan:
        cmp rbx, 4;
        jae vki_re_enospc;
        lea r10, [rip + _vki_icd_table];
        mov r11, rbx;
        imul r11, r11, 24;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  vki_re_claim;
        add rbx, 1;
        jmp vki_re_ascan;

      vki_re_claim:
        mov [r10 + 0],  r12;
      vki_re_update:
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;

        mov rdi, 0;
        call vki_note;

        mov rax, rbx;
        jmp vki_re_out;

      vki_re_bad_key:
        mov rdi, 3;
        call vki_note;
        mov rax, 0xFFFFEDDF;
        jmp vki_re_out;
      vki_re_bad_ver:
        mov rdi, 3;
        call vki_note;
        mov rax, 0xFFFFEDDD;
        jmp vki_re_out;
      vki_re_enospc:
        mov rdi, 3;
        call vki_note;
        mov rax, 0xFFFFEDDC;

      vki_re_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // vki_has_ext(icd_row, ext_id) -> 1 | 0
  pub let vki_has_ext : (u64, u64) -> u64 !{mem} @{} =
    fn (icd_row: u64) (ext_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-003 (#1459): bit-test bit `ext_id` in ext_bitmap of row `icd_row`.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r13;
        call vki_ext_valid;
        cmp rax, 0;
        je  vki_he_no;

        mov r10, 4;
        cmp r12, r10;
        jae vki_he_no;
        lea r11, [rip + _vki_icd_table];
        mov rax, r12;
        imul rax, rax, 24;
        add r11, rax;
        mov rax, [r11 + 0];
        cmp rax, 0;
        je  vki_he_no;
        mov rbx, [r11 + 8];
        mov r10, 1;
        mov rcx, r13;
        shl r10, cl;
        and rbx, r10;
        cmp rbx, 0;
        je  vki_he_no;
        mov rdi, 1;
        call vki_note;
        mov rax, 1;
        jmp vki_he_out;

      vki_he_no:
        xor rax, rax;

      vki_he_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // vki_spirv_check(bo_addr, byte_len) -> OK | err
  //
  // Loader-side SPIR-V magic-word check.
  // =========================================================================
  pub let vki_spirv_check : (u64, u64) -> u64 !{mem} @{} =
    fn (bo_addr: u64) (byte_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G3.M1-005 (#1461): first 4 bytes at bo_addr must be 0x07230203 (SPIR-V magic). One callee-save push (odd) keeps rsp aligned across vki_note.",
      block: {
        push rbx;
        mov r10, 4;
        cmp rsi, r10;
        jb  vki_sp_short;
        mov eax, [rdi];
        mov r10, 0x07230203;
        cmp rax, r10;
        jne vki_sp_bad;
        mov rdi, 2;
        call vki_note;
        xor rax, rax;
        pop rbx;
        ret;
      vki_sp_short:
        mov rax, 0xFFFFEDD9;
        pop rbx;
        ret;
      vki_sp_bad:
        mov rax, 0xFFFFEDDA;
        pop rbx;
        ret
      }
    }
}
