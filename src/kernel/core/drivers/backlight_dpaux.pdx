// src/kernel/core/drivers/backlight_dpaux.pdx — R31.M5-004 (#1109)
//
// The kernel's DP-AUX backend scaffold for a KIND_BACKLIGHT with
// backend = BACKLIGHT_BACKEND_DPAUX. VESA eDP DPCD backlight registers,
// bind flag, refusal taxonomy, DEFERRED_HARDWARE sentinel and a
// FALLBACK_ACPI sentinel for panels that do not advertise AUX
// backlight capability.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// IT IS THE VESA eDP AUX-CHANNEL BACKLIGHT CONTROLLER'S KERNEL-SIDE
// HALF, IN SCAFFOLD FORM. A live driver would perform three DPCD
// writes per brightness change:
//
//   DPCD 0x720 (EDP_BACKLIGHT_MODE_SET_REGISTER) <- mode with bit 1 set
//   DPCD 0x721 (EDP_BACKLIGHT_BRIGHTNESS_MSB)    <- level high byte
//   DPCD 0x722 (EDP_BACKLIGHT_BRIGHTNESS_LSB)    <- level low byte
//
// per VESA eDP 1.4b §7. The AUX transactions themselves require an
// AUX-channel capability rooted in the graphics adapter's
// KIND_MMIO_WINDOW; no such capability exists in this tree. When the
// gated:hardware milestone lands, the same three-byte sequence runs
// against the panel's DPCD address space and this scaffold becomes the
// driver.
//
// IT IS NOT A LIVE DRIVER. Same discipline as backlight_pwm.pdx §4 and
// ec_access.pdx (#1580): the coordination and the transactions are
// stated as absent, and the pin `backlight_dpaux_arbitrated() == 0`
// forces the design doc to be updated at the point a real coordination
// path lands. See §4 for the deferrals list.
//
// SOME PANELS DO NOT SUPPORT AUX BACKLIGHT. VESA eDP 1.4b makes AUX
// backlight capability an advertised feature (DPCD 0x701 bit 0), and a
// panel whose capability bit is clear does not accept the three-byte
// sequence above. Per issue #1109 the driver "falls back to ACPI BCM"
// on such panels; the honest kernel-side sentinel for that outcome is
// BACKLIGHT_DPAUX_FALLBACK_ACPI, and the policy above this driver picks
// a different backend at the point it sees the sentinel. No fallback
// runs in this module -- the fallback is a compositor decision, and
// this driver reports what the panel is capable of, not what to do
// about it.
//
// =============================================================================
// §1  DPCD REGISTER LAYOUT (VESA eDP 1.4b §7)
// =============================================================================
//
//   0x720  BACKLIGHT_MODE_SET_REGISTER
//            bit 1 (BL_AUX_ENABLE): 1 = brightness controlled via AUX
//   0x721  BRIGHTNESS_MSB     high 8 bits of the 16-bit level
//   0x722  BRIGHTNESS_LSB     low 8 bits
//
// A live write sequence writes MODE_SET once at bind, then MSB/LSB per
// level change. None of these transactions run today.
//
// =============================================================================
// §2  ONE WRITER OF THE BIND FLAG
// =============================================================================
//
// Same discipline as backlight_pwm.pdx §2 and ec_access.pdx: exactly
// one writer of `_backlight_dpaux_bound`. tools/build.sh confines
// relocations against `_backlight_dpaux_bound` and
// `_backlight_dpaux_stats` to this object.
//
// =============================================================================
// §3  REFUSE, NEVER CLAMP
// =============================================================================
//
// Level > 16 bits -> BAD_LEVEL. Write before bind -> NOT_BOUND. A
// bound driver whose panel does not advertise the AUX backlight
// capability bit -> FALLBACK_ACPI (an honest sentinel; the compositor
// then binds an ACPI backend for that panel). Otherwise ->
// DEFERRED_HARDWARE. Neither refusal is silently mapped to success.
//
// =============================================================================
// §4  WHAT THIS MODULE STILL DOES NOT DO (gated:hardware)
// =============================================================================
//
//   * NO AUX TRANSACTIONS run. The KIND_AUX_CHANNEL-shaped capability
//     that would authorise reaching the panel's DPCD does not exist
//     in this tree.
//   * NO CAPABILITY PROBE. A live driver would read DPCD 0x701 at
//     bind, note the AUX-backlight bit, and refuse the bind (with a
//     panel-side FALLBACK_ACPI at bind time) if the panel did not
//     support it. Today the sentinel is available on the write seam
//     for demonstrative purposes; a real bind will probe at bind and
//     refuse there.
//   * NO ARBITRATION against the PSR self-refresh path. Same
//     coordination gap as backlight_pwm.pdx §4 and ec_access.pdx.
//     backlight_dpaux_arbitrated returns 0.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFFEA0..0xFFFFFEAF
//
// FIVE codes at this milestone. FALLBACK_ACPI is at the low end of the
// band on purpose so the compositor's next-driver-lookup can key off
// (code & 0xF) without a magic-number list.
// =============================================================================

module BacklightDpaux = structure {

  // ==========================================================================
  // §1 DPCD addresses. Constants, not written anywhere in this module.
  // ==========================================================================

  pub let DPAUX_BL_MODE_SET_ADDR   : u64 = 0x720
  pub let DPAUX_BL_BRIGHTNESS_MSB  : u64 = 0x721
  pub let DPAUX_BL_BRIGHTNESS_LSB  : u64 = 0x722
  pub let DPAUX_BL_MODE_AUX_ENABLE : u64 = 0x02

  // ==========================================================================
  // §5 return codes.
  // ==========================================================================

  pub let BACKLIGHT_DPAUX_OK                : u64 = 0
  pub let BACKLIGHT_DPAUX_NOT_BOUND         : u64 = 0xFFFFFEAF
  pub let BACKLIGHT_DPAUX_BAD_LEVEL         : u64 = 0xFFFFFEAE
  pub let BACKLIGHT_DPAUX_BAD_AUX           : u64 = 0xFFFFFEAD
  pub let BACKLIGHT_DPAUX_DEFERRED_HARDWARE : u64 = 0xFFFFFEAC
  pub let BACKLIGHT_DPAUX_FALLBACK_ACPI     : u64 = 0xFFFFFEAB

  // ==========================================================================
  // State. Same layout as backlight_pwm.pdx.
  // ==========================================================================

  pub let mut _backlight_dpaux_bound : u64 = 0
  pub let mut _backlight_dpaux_stats : [u64; 8] = uninit @align(64)

  pub let BACKLIGHT_DPAUX_ST_BINDS     : u64 = 0
  pub let BACKLIGHT_DPAUX_ST_WRITES    : u64 = 1
  pub let BACKLIGHT_DPAUX_ST_BAD_LEVEL : u64 = 2
  pub let BACKLIGHT_DPAUX_ST_NOT_BOUND : u64 = 3
  pub let BACKLIGHT_DPAUX_ST_MAX       : u64 = 8

  // ==========================================================================
  // backlight_dpaux_bind() -> BACKLIGHT_DPAUX_OK
  // ==========================================================================

  pub let backlight_dpaux_bind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-004 (#1109): mark the DPAUX backend scaffold bound. ARITY ZERO for the same reason backlight_pwm_bind is arity zero: a real bind takes an AUX-channel capability and a probe of DPCD 0x701 to establish that the panel advertises AUX backlight, and neither exists yet. Leaving the seam empty means a caller cannot forge a bind. When the gated:hardware milestone lands, arity moves to two ({aux_slot, panel_caps}) and the confinement pin in tools/build.sh moves with it. Increments _backlight_dpaux_stats[0]. Leaf. Labels prefixed bldpx_bd_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _backlight_dpaux_bound];
        mov rax, 1;
        mov [r10], rax;

        lea r10, [rip + _backlight_dpaux_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        xor rax, rax;                    // BACKLIGHT_DPAUX_OK
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_dpaux_bound() -> 1 | 0
  // ==========================================================================

  pub let backlight_dpaux_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-004 (#1109): 1 once backlight_dpaux_bind has succeeded. Leaf load. Reserved labels: none.",
      block: {
        lea r10, [rip + _backlight_dpaux_bound];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_dpaux_arbitrated() -> 0
  //
  // THE HONESTY FUNCTION. Same device as backlight_pwm_arbitrated and
  // ec_access_arbitrated: pinned at 0 by the boot witness so a future
  // milestone plumbing coordination cannot land without rewriting the
  // claim that says it has not.
  // ==========================================================================

  pub let backlight_dpaux_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-004 (#1109): report whether AUX writes through this backend are coordinated against the PSR self-refresh subsystem and the graphics driver's own AUX users. IT RETURNS 0, because nothing in this tree coordinates the panel's AUX channel. The boot witness pins it at 0 for the same reason ec_access_arbitrated and backlight_pwm_arbitrated are pinned: a claim in a comment rots silently, a value a test asserts on does not. Leaf. Reserved labels: none.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_dpaux_write(level) -> code
  //
  // The write seam. Validates 16-bit level, requires bind, returns
  // DEFERRED_HARDWARE on the happy path. Does NOT return FALLBACK_ACPI
  // in this milestone -- that sentinel is defined and reserved for the
  // capability probe that will arrive with the AUX-channel capability;
  // its refusal is what the compositor keys off to bind an ACPI backend
  // instead.
  // ==========================================================================

  pub let backlight_dpaux_write : (u64) -> u64 !{mem} @{} =
    fn (level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-004 (#1109): the write seam. Gates, in order: (1) level fits 16 bits (kind_backlight LEVEL_UPPER = 65535), else BAD_LEVEL and counted -- refused, not clamped. (2) driver bound, else NOT_BOUND and counted. (3) the happy path returns DEFERRED_HARDWARE (an honest sentinel per §3), counted in the writes cell. NO REAL AUX TRANSACTION RUNS: three DPCD writes (MODE_SET, MSB, LSB) are what a live driver would emit, and none of them are in this milestone. The FALLBACK_ACPI code is defined (§5) and reserved for the future capability probe at bind time -- the write seam never returns it, because by construction if we got to the seam the bind succeeded. Leaf. Labels prefixed bldpx_wr_ per reserved-label discipline.",
      block: {
        // (1) level fits 16 bits.
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  bldpx_wr_bad_level;

        // (2) bound?
        lea r10, [rip + _backlight_dpaux_bound];
        mov rax, [r10];
        cmp rax, 0;
        je  bldpx_wr_not_bound;

        // (3) DEFERRED_HARDWARE.
        lea r10, [rip + _backlight_dpaux_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        mov rax, 0xFFFFFEAC;             // BACKLIGHT_DPAUX_DEFERRED_HARDWARE
        ret;

      bldpx_wr_bad_level:
        lea r10, [rip + _backlight_dpaux_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFFEAE;             // BACKLIGHT_DPAUX_BAD_LEVEL
        ret;

      bldpx_wr_not_bound:
        lea r10, [rip + _backlight_dpaux_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFFEAF;             // BACKLIGHT_DPAUX_NOT_BOUND
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_dpaux_writes() -> count
  // ==========================================================================

  pub let backlight_dpaux_writes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-004 (#1109): read the count of deferred-hardware outcomes returned to callers. Same observation channel as backlight_pwm_writes: the counter is the only place a diagnostic can observe that this seam was exercised without a real AUX transaction landing. Leaf. Reserved labels: none.",
      block: {
        lea r10, [rip + _backlight_dpaux_stats];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame
}
