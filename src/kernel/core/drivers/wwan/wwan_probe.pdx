// src/kernel/core/drivers/wwan/wwan_probe.pdx -- R40.M4-002 (#1359)
//
// M.2 WWAN modem PROBE + POWER GATING scaffold. Opens R40.M4 (T14 G4
// LTE / 5G-NR modem bring-up over the M.2 3042/3052 slot).
//
// Recognises the M.2 WWAN vendor set (Intel 0x8086, Fibocom 0x2CB7 --
// the two shipping WWAN vendors on Lenovo T14 G4 mainboards),
// validates the PCIe BAR extent, records probe outcomes, and exposes
// a PCIe power-state seam (D0 active <-> D3 gated) so the kernel can
// gate the modem down between MBIM sessions without a driver-owned
// side channel.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNISE + RECORD + POWER-GATE half of an M.2 WWAN
// bring-up. A PCIe function whose class code (0x0D, 0x40) or USB
// interface class 0x02 subclass 0x0E (Communications / Mobile
// Broadband) is a WWAN candidate. This scaffold distills the
// vendor/product pair and validates the M.2 3042/3052 form-factor
// bit the caller supplied.
//
// IT DOES NOT TOUCH REAL MMIO OR THE ACPI _PS0/_PS3 METHODS. Power
// transitions are recorded here through a seam that a later round
// wires against real PCIe power-management config-space writes and
// the ACPI supervisor's _PS0/_PS3 evaluation. This module records
// INTENT (the target state); the seam owns EXECUTION.
//
// IT DOES NOT MINT KIND_WWAN_MODEM. That mint belongs to R40.M4-002
// once the BAR and identity are measured through a live memory
// authority; this scaffold records the EXTENTS + IDENTITIES so the
// mint can containment-check its request without re-asking firmware.
//
// wwp_probe_arbitrated() returns 0 until a later round binds a live
// BAR + power seam against this scaffold.
//
// =============================================================================
// §1  ACCEPTED VENDOR / DEVICE SET
// =============================================================================
//
//   0x8086  Intel (XMM 7360 / XMM 7560 M.2 WWAN modules)
//   0x2CB7  Fibocom (L850-GL / L860-GL / FM350-GL M.2 modules)
//
// Every other vendor id is REFUSED as WWP_BAD_VENDOR rather than
// optimistically accepted -- a non-WWAN module in an M.2 slot uses a
// different MBIM firmware family and a probe that admitted it would
// hand the MBIM driver a device that speaks a different protocol.
//
// =============================================================================
// §2  M.2 FORM-FACTOR BIT
// =============================================================================
//
//   WWP_FORM_3042  M.2 Key-B 3042 (30x42mm, LTE class)
//   WWP_FORM_3052  M.2 Key-B 3052 (30x52mm, 5G-NR class)
//
// Neither is "better" -- the ring-3 supervisor decides which physical
// slot to activate; this scaffold records what the caller measured.
//
// =============================================================================
// §3  POWER GATING SEAM
// =============================================================================
//
// wwp_pwr_transition(cur, target) records the intent to move a modem
// between D0 and D3. Transitions D0 -> D3 and D3 -> D0 are allowed;
// same-state transitions are refused with WWP_PWR_NOOP; D1/D2 as
// either source or target are refused with WWP_BAD_PWR because the
// intermediate D-states are not part of the accepted WWAN power
// discipline.
//
// =============================================================================
// §4  ONE WRITER OF THE STATE
// =============================================================================
//
// _wwp_probe_stats, _wwp_probes, _wwp_probe_count, and _wwp_pwr_last
// are written only by helpers in this module. tools/build.sh confines
// relocations against each to `core/drivers/wwan/wwan_probe.o`.
//
// =============================================================================
// §5  ERROR CODES 0xFFFFF1A0..0xFFFFF1AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band. Adjacent used band above: kind_mbim_session
// 0xFFFFF1B0..BF (R40.M4-004). Adjacent free band below: mbim
// 0xFFFFF190..9F (R40.M4-003).

module WwanProbe = structure {

  // Accepted vendor set (§1).
  pub let WWP_VENDOR_INTEL    : u64 = 0x8086
  pub let WWP_VENDOR_FIBOCOM  : u64 = 0x2CB7

  // M.2 form-factor bits (§2).
  pub let WWP_FORM_3042       : u64 = 1
  pub let WWP_FORM_3052       : u64 = 2

  // BAR shape.
  pub let WWP_BAR_ALIGN_MASK  : u64 = 0xFFF          // 4 KiB align
  pub let WWP_BAR_MIN_LEN     : u64 = 0x1000         // 4 KiB min

  // Power-state ordinals -- must MATCH KindWwanModem.
  pub let WWP_PWR_D0          : u64 = 0
  pub let WWP_PWR_D3          : u64 = 3

  // Failure taxonomy -- 0xFFFFF1A0..0xFFFFF1AF.
  pub let WWP_OK              : u64 = 0
  pub let WWP_BAD_VENDOR      : u64 = 0xFFFFF1AF
  pub let WWP_BAD_PRODUCT     : u64 = 0xFFFFF1AE
  pub let WWP_BAD_BAR_ALIGN   : u64 = 0xFFFFF1AD
  pub let WWP_BAD_BAR_LEN     : u64 = 0xFFFFF1AC
  pub let WWP_BAD_FORM        : u64 = 0xFFFFF1AB
  pub let WWP_BAD_PWR         : u64 = 0xFFFFF1AA
  pub let WWP_PWR_NOOP        : u64 = 0xFFFFF1A9
  pub let WWP_ENOSPC          : u64 = 0xFFFFF1A8
  pub let WWP_BAD_SLOT        : u64 = 0xFFFFF1A7

  // Probe table.
  pub let WWP_MAX             : u64 = 4              // T14 G4 has 1 WWAN slot; 4 for headroom
  pub let WWP_ROW_BYTES       : u64 = 32

  pub let mut _wwp_probes       : [u64; 16] = uninit @align(64)
  pub let mut _wwp_probe_count  : [u64; 1]  = uninit @align(64)
  pub let mut _wwp_probe_stats  : [u64; 8]  = uninit @align(64)
  pub let mut _wwp_pwr_last     : [u64; 4]  = uninit @align(64)

  pub let WWP_ST_ATTEMPTS      : u64 = 0
  pub let WWP_ST_ACCEPTED      : u64 = 1
  pub let WWP_ST_REFUSED       : u64 = 2
  pub let WWP_ST_PWR_D0        : u64 = 3
  pub let WWP_ST_PWR_D3        : u64 = 4
  pub let WWP_ST_PWR_REFUSED   : u64 = 5

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let wwp_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): clear probe table, count, stats, and last-power cell. Boot + teardown. Labels prefixed wwp_rs_.",
      block: {
        lea r10, [rip + _wwp_probes];
        xor rax, rax;
        xor rcx, rcx;
      wwp_rs_tbl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  wwp_rs_tbl;

        lea r10, [rip + _wwp_probe_count];
        xor rax, rax;
        mov [r10 + 0], rax;

        lea r10, [rip + _wwp_probe_stats];
        xor rcx, rcx;
      wwp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wwp_rs_stats;

        lea r10, [rip + _wwp_pwr_last];
        xor rcx, rcx;
      wwp_rs_pwr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  wwp_rs_pwr;
        ret
      }
    }

  pub let wwp_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-002 (#1359): honesty pin. Returns 0 until a later round wires this against a live PCIe BAR + ACPI _PS0/_PS3 seam.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let wwp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): counter bump. Labels prefixed wwp_nt_.",
      block: {
        cmp rdi, 8;
        jae wwp_nt_out;
        lea r10, [rip + _wwp_probe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wwp_nt_out:
        ret
      }
    }

  pub let wwp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): counter read. Labels prefixed wwp_stt_.",
      block: {
        cmp rdi, 8;
        jae wwp_stt_zero;
        lea r10, [rip + _wwp_probe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wwp_stt_zero:
        xor rax, rax;
        ret
      }
    }

  pub let wwp_probe_count_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): number of live probes. Labels prefixed wwp_pc_.",
      block: {
        lea r10, [rip + _wwp_probe_count];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let wwp_vendor_valid : (u64) -> u64 !{} @{} =
    fn (vendor: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-002 (#1359): 1 iff vendor in {Intel 0x8086, Fibocom 0x2CB7}. Labels prefixed wwp_vv_.",
      block: {
        mov r10, 0x8086;
        cmp rdi, r10;
        je  wwp_vv_yes;
        mov r10, 0x2CB7;
        cmp rdi, r10;
        je  wwp_vv_yes;
        xor rax, rax;
        ret;
      wwp_vv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let wwp_form_valid : (u64) -> u64 !{} @{} =
    fn (form: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-002 (#1359): 1 iff form in {3042=1, 3052=2}. Enumerated. Labels prefixed wwp_fv_.",
      block: {
        cmp rdi, 1;
        je  wwp_fv_yes;
        cmp rdi, 2;
        je  wwp_fv_yes;
        xor rax, rax;
        ret;
      wwp_fv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let wwp_bar_valid : (u64, u64) -> u64 !{} @{} =
    fn (bar_base: u64) (bar_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-002 (#1359): 1 iff BAR base is 4 KiB aligned and BAR length >= 4 KiB. Labels prefixed wwp_bv_.",
      block: {
        mov r10, 0xFFF;
        mov rax, rdi;
        and rax, r10;
        cmp rax, 0;
        jne wwp_bv_no;
        mov r10, 0x1000;
        cmp rsi, r10;
        jb  wwp_bv_no;
        mov rax, 1;
        ret;
      wwp_bv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Probe record: (vendor, product, bar_base, bar_len, form).
  //
  // Row layout, 32 bytes per row (WWP_MAX = 4 rows in a [u64; 16] table):
  //   [+0]  in_use[7:0] | form[15:8] | vendor[31:16] | product[47:32]
  //   [+8]  bar_base (u64)
  //   [+16] bar_len (u64)
  //   [+24] reserved (u64)
  // ==========================================================================

  pub let wwp_probe_add : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vendor: u64) (product: u64) (bar_base: u64) (bar_len: u64) (form: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): record one probed WWAN modem. Gates: vendor_valid, form_valid, bar_valid, product non-zero. ENOSPC at WWP_MAX. Labels prefixed wwp_pa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // vendor
        mov r12, rsi;                    // product
        mov r13, rdx;                    // bar_base
        mov r14, rcx;                    // bar_len
        mov r15, r8;                     // form

        mov rdi, 0;                      // ATTEMPTS
        call wwp_note;

        mov rdi, rbx;
        call wwp_vendor_valid;
        cmp rax, 0;
        je  wwp_pa_bad_vendor;

        cmp r12, 0;
        je  wwp_pa_bad_product;
        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  wwp_pa_bad_product;

        mov rdi, r13;
        mov rsi, r14;
        call wwp_bar_valid;
        cmp rax, 0;
        je  wwp_pa_bad_bar;

        mov rdi, r15;
        call wwp_form_valid;
        cmp rax, 0;
        je  wwp_pa_bad_form;

        // Capacity.
        lea r10, [rip + _wwp_probe_count];
        mov r11, [r10 + 0];
        cmp r11, 4;                      // WWP_MAX
        jae wwp_pa_enospc;

        // Row base.
        lea r10, [rip + _wwp_probes];
        mov r9, r11;
        shl r9, 5;                       // stride 32
        add r10, r9;

        // Header word.
        mov rax, 1;                      // in_use
        mov r9, r15;
        and r9, 0xFF;
        shl r9, 8;                       // form
        or  rax, r9;
        mov r9, rbx;
        and r9, 0xFFFF;
        shl r9, 16;                      // vendor
        or  rax, r9;
        mov r9, r12;
        and r9, 0xFFFF;
        shl r9, 32;                      // product
        or  rax, r9;
        mov [r10 + 0], rax;

        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;

        // Bump count.
        lea r10, [rip + _wwp_probe_count];
        add r11, 1;
        mov [r10 + 0], r11;

        mov rdi, 1;                      // ACCEPTED
        call wwp_note;
        xor rax, rax;
        jmp wwp_pa_out;

      wwp_pa_bad_vendor:
        mov rdi, 2;
        call wwp_note;
        mov rax, 0xFFFFF1AF;
        jmp wwp_pa_out;
      wwp_pa_bad_product:
        mov rdi, 2;
        call wwp_note;
        mov rax, 0xFFFFF1AE;
        jmp wwp_pa_out;
      wwp_pa_bad_bar:
        mov rdi, 2;
        call wwp_note;
        // Distinguish align vs len.
        mov r10, 0xFFF;
        mov rax, r13;
        and rax, r10;
        cmp rax, 0;
        jne wwp_pa_bad_align;
        mov rax, 0xFFFFF1AC;
        jmp wwp_pa_out;
      wwp_pa_bad_align:
        mov rax, 0xFFFFF1AD;
        jmp wwp_pa_out;
      wwp_pa_bad_form:
        mov rdi, 2;
        call wwp_note;
        mov rax, 0xFFFFF1AB;
        jmp wwp_pa_out;
      wwp_pa_enospc:
        mov rdi, 2;
        call wwp_note;
        mov rax, 0xFFFFF1A8;

      wwp_pa_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  //
  // wwp_probe_row_vendor / _product / _bar_base / _bar_len / _form
  // ==========================================================================

  pub let wwp_probe_row_vendor : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): vendor at row (hdr[31:16]). Returns 0xFFFFFFFFFFFFFFFF on bad row. Labels prefixed wwp_rv_.",
      block: {
        cmp rdi, 4;
        jae wwp_rv_bad;
        lea r10, [rip + _wwp_probes];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        je  wwp_rv_bad;
        shr rax, 16;
        and rax, 0xFFFF;
        ret;
      wwp_rv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wwp_probe_row_product : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): product at row (hdr[47:32]). Labels prefixed wwp_rp_.",
      block: {
        cmp rdi, 4;
        jae wwp_rp_bad;
        lea r10, [rip + _wwp_probes];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        je  wwp_rp_bad;
        shr rax, 32;
        and rax, 0xFFFF;
        ret;
      wwp_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wwp_probe_row_form : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): form at row (hdr[15:8]). Labels prefixed wwp_rf_.",
      block: {
        cmp rdi, 4;
        jae wwp_rf_bad;
        lea r10, [rip + _wwp_probes];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        je  wwp_rf_bad;
        shr rax, 8;
        and rax, 0xFF;
        ret;
      wwp_rf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wwp_probe_row_bar_base : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): bar_base at row. Labels prefixed wwp_rb_.",
      block: {
        cmp rdi, 4;
        jae wwp_rb_bad;
        lea r10, [rip + _wwp_probes];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        cmp rax, 0;
        je  wwp_rb_bad;
        mov rax, [r10 + 8];
        ret;
      wwp_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let wwp_probe_row_bar_len : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): bar_len at row. Labels prefixed wwp_rl_.",
      block: {
        cmp rdi, 4;
        jae wwp_rl_bad;
        lea r10, [rip + _wwp_probes];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFF;
        cmp rax, 0;
        je  wwp_rl_bad;
        mov rax, [r10 + 16];
        ret;
      wwp_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Power gating (§3).
  //
  // wwp_pwr_transition(cur, target) -> OK | BAD_PWR | PWR_NOOP
  //
  // Records the target state in _wwp_pwr_last[0] on success.
  // ==========================================================================

  pub let wwp_pwr_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (cur: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): D0 <-> D3 transition. Refuses D1/D2 in either position (BAD_PWR). Refuses same-state (PWR_NOOP). Labels prefixed wwp_pt_.",
      block: {
        // cur in {D0=0, D3=3}
        cmp rdi, 0;
        je  wwp_pt_cur_ok;
        cmp rdi, 3;
        je  wwp_pt_cur_ok;
        mov rdi, 5;                      // PWR_REFUSED
        call wwp_note;
        mov rax, 0xFFFFF1AA;
        ret;

      wwp_pt_cur_ok:
        // target in {D0=0, D3=3}
        cmp rsi, 0;
        je  wwp_pt_target_ok;
        cmp rsi, 3;
        je  wwp_pt_target_ok;
        mov rdi, 5;
        call wwp_note;
        mov rax, 0xFFFFF1AA;
        ret;

      wwp_pt_target_ok:
        cmp rdi, rsi;
        jne wwp_pt_go;
        mov rdi, 5;
        call wwp_note;
        mov rax, 0xFFFFF1A9;
        ret;

      wwp_pt_go:
        lea r10, [rip + _wwp_pwr_last];
        mov [r10 + 0], rsi;              // record target
        cmp rsi, 0;
        jne wwp_pt_d3;
        mov rdi, 3;                      // PWR_D0
        call wwp_note;
        xor rax, rax;
        ret;
      wwp_pt_d3:
        mov rdi, 4;                      // PWR_D3
        call wwp_note;
        xor rax, rax;
        ret
      }
    }

  pub let wwp_pwr_last_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-002 (#1359): last recorded power state. Labels prefixed wwp_pl_.",
      block: {
        lea r10, [rip + _wwp_pwr_last];
        mov rax, [r10 + 0];
        ret
      }
    }
}
