// src/kernel/core/drivers/wwan/mbim.pdx -- R40.M4-003 (#1361)
//
// MBIM (Mobile Broadband Interface Model) per USB CDC scaffold.
//
// MBIM is the standard control-plane protocol WWAN modems speak over
// USB CDC. It moves control commands (OPEN, CONNECT, DISCONNECT,
// SUBSCRIBE) across a bulk-in/bulk-out pair and delivers
// notifications (SIGNAL_STATE, CONNECT, PACKET_SERVICE) over an
// interrupt IN endpoint.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CONTROL / NOTIFICATION CHANNEL SUBSTRATE plus the three
// session verbs the ring-3 supervisor calls: mbim_connect,
// mbim_disconnect, mbim_get_signal_strength. It does NOT touch real
// USB (that will be a later round's wiring against the xHCI/usb_urb
// stack), does NOT drive the modem's LTE / 5G-NR PHY (that lives
// below the MBIM protocol layer), and does NOT own KIND_MBIM_SESSION
// (the capability owns identity, this driver owns the wire).
//
// mbim_arbitrated() returns 0 until a later round binds the two
// channels against live USB endpoints.
//
// =============================================================================
// §1  CONTROL CHANNEL FSM
// =============================================================================
//
// MBIM_CTRL_CLOSED    initial state
// MBIM_CTRL_OPEN      OPEN handshake completed; SUBSCRIBE and CONNECT valid
// MBIM_CTRL_CONNECTED CONNECT completed; data plane active
//
// The FSM refuses any verb reached from the wrong state (BAD_STATE)
// rather than silently returning to a safe one.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _mbim_ctrl_state, _mbim_notif_last, _mbim_stats, and _mbim_signal
// are written only by helpers in this module. tools/build.sh confines
// relocations against each to `core/drivers/wwan/mbim.o`.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF190..0xFFFFF19F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band. Adjacent used band above: wwan_probe
// 0xFFFFF1A0..AF (R40.M4-002). Adjacent free band below: unassigned
// 0xFFFFF180..8F.

module Mbim = structure {

  // Control FSM ordinals.
  pub let MBIM_CTRL_CLOSED    : u64 = 0
  pub let MBIM_CTRL_OPEN      : u64 = 1
  pub let MBIM_CTRL_CONNECTED : u64 = 2

  // Notification kinds.
  pub let MBIM_NOTIF_NONE          : u64 = 0
  pub let MBIM_NOTIF_SIGNAL_STATE  : u64 = 1
  pub let MBIM_NOTIF_CONNECT       : u64 = 2
  pub let MBIM_NOTIF_PACKET_SVC    : u64 = 3

  // Failure taxonomy -- 0xFFFFF190..0xFFFFF19F.
  pub let MBIM_OK              : u64 = 0
  pub let MBIM_BAD_STATE       : u64 = 0xFFFFF19F
  pub let MBIM_BAD_ARG         : u64 = 0xFFFFF19E
  pub let MBIM_NOT_OPEN        : u64 = 0xFFFFF19D
  pub let MBIM_ALREADY_OPEN    : u64 = 0xFFFFF19C
  pub let MBIM_NOT_CONNECTED   : u64 = 0xFFFFF19B
  pub let MBIM_ALREADY_CONN    : u64 = 0xFFFFF19A
  pub let MBIM_BAD_NOTIF       : u64 = 0xFFFFF199
  pub let MBIM_BAD_SIGNAL      : u64 = 0xFFFFF198

  pub let mut _mbim_ctrl_state : [u64; 1]  = uninit @align(64)
  pub let mut _mbim_notif_last : [u64; 4]  = uninit @align(64)
  pub let mut _mbim_signal     : [u64; 1]  = uninit @align(64)
  pub let mut _mbim_stats      : [u64; 8]  = uninit @align(64)

  pub let MBIM_ST_OPENS       : u64 = 0
  pub let MBIM_ST_CLOSES      : u64 = 1
  pub let MBIM_ST_CONNECTS    : u64 = 2
  pub let MBIM_ST_DISCONNECTS : u64 = 3
  pub let MBIM_ST_NOTIFS      : u64 = 4
  pub let MBIM_ST_REFUSED     : u64 = 5

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let mbim_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): clear control state, last notification, signal, stats. Boot + teardown. Labels prefixed mbim_rs_.",
      block: {
        lea r10, [rip + _mbim_ctrl_state];
        xor rax, rax;
        mov [r10 + 0], rax;

        lea r10, [rip + _mbim_notif_last];
        xor rcx, rcx;
      mbim_rs_nl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  mbim_rs_nl;

        lea r10, [rip + _mbim_signal];
        mov [r10 + 0], rax;

        lea r10, [rip + _mbim_stats];
        xor rcx, rcx;
      mbim_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  mbim_rs_st;
        ret
      }
    }

  pub let mbim_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-003 (#1361): honesty pin. Returns 0 until a later round wires the control + notification channels against live USB CDC endpoints.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let mbim_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): counter bump. Labels prefixed mbim_nt_.",
      block: {
        cmp rdi, 8;
        jae mbim_nt_out;
        lea r10, [rip + _mbim_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      mbim_nt_out:
        ret
      }
    }

  pub let mbim_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): counter read. Labels prefixed mbim_stt_.",
      block: {
        cmp rdi, 8;
        jae mbim_stt_zero;
        lea r10, [rip + _mbim_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      mbim_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // FSM primitives.
  // ==========================================================================

  pub let mbim_state_of : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): current control state. Labels prefixed mbim_so_.",
      block: {
        lea r10, [rip + _mbim_ctrl_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let mbim_open : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): control-channel OPEN handshake. CLOSED -> OPEN. Refuses ALREADY_OPEN from OPEN/CONNECTED. Labels prefixed mbim_op_.",
      block: {
        push rbx;
        lea r10, [rip + _mbim_ctrl_state];
        mov rbx, [r10 + 0];
        cmp rbx, 0;                      // CLOSED
        jne mbim_op_already;

        mov rax, 1;                      // OPEN
        mov [r10 + 0], rax;

        mov rdi, 0;                      // OPENS
        call mbim_note;
        xor rax, rax;
        pop rbx;
        ret;

      mbim_op_already:
        mov rdi, 5;                      // REFUSED
        call mbim_note;
        mov rax, 0xFFFFF19C;
        pop rbx;
        ret
      }
    }

  pub let mbim_close : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): control-channel CLOSE. Any -> CLOSED, but only from OPEN or CONNECTED (NOT_OPEN otherwise). Labels prefixed mbim_cl_.",
      block: {
        push rbx;
        lea r10, [rip + _mbim_ctrl_state];
        mov rbx, [r10 + 0];
        cmp rbx, 0;
        je  mbim_cl_not_open;

        xor rax, rax;                    // CLOSED
        mov [r10 + 0], rax;

        // Also clear signal on close.
        lea r10, [rip + _mbim_signal];
        mov [r10 + 0], rax;

        mov rdi, 1;                      // CLOSES
        call mbim_note;
        xor rax, rax;
        pop rbx;
        ret;

      mbim_cl_not_open:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF19D;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Session verb: mbim_connect(session_id).
  //
  // OPEN -> CONNECTED. Refused from CLOSED (NOT_OPEN) or from
  // CONNECTED (ALREADY_CONN). session_id must fit u8.
  // ==========================================================================

  pub let mbim_connect : (u64) -> u64 !{mem} @{} =
    fn (session_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): MBIM CONNECT verb. OPEN -> CONNECTED. Refused otherwise. session_id refused if > 0xFF (widening not masked). Labels prefixed mbim_cn_.",
      block: {
        push rbx;
        cmp rdi, 0xFF;
        ja  mbim_cn_bad_arg;
        mov rbx, rdi;

        lea r10, [rip + _mbim_ctrl_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  mbim_cn_not_open;
        cmp rax, 2;
        je  mbim_cn_already;
        cmp rax, 1;
        jne mbim_cn_bad_state;

        mov rax, 2;                      // CONNECTED
        mov [r10 + 0], rax;

        mov rdi, 2;                      // CONNECTS
        call mbim_note;
        xor rax, rax;
        pop rbx;
        ret;

      mbim_cn_not_open:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF19D;
        pop rbx;
        ret;
      mbim_cn_already:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF19A;
        pop rbx;
        ret;
      mbim_cn_bad_state:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF19F;
        pop rbx;
        ret;
      mbim_cn_bad_arg:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF19E;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Session verb: mbim_disconnect().
  //
  // CONNECTED -> OPEN. Refused if NOT_CONNECTED.
  // ==========================================================================

  pub let mbim_disconnect : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): MBIM DISCONNECT verb. CONNECTED -> OPEN. Refused if NOT_CONNECTED. Labels prefixed mbim_dc_.",
      block: {
        push rbx;
        lea r10, [rip + _mbim_ctrl_state];
        mov rax, [r10 + 0];
        cmp rax, 2;
        jne mbim_dc_not_conn;

        mov rax, 1;                      // OPEN
        mov [r10 + 0], rax;

        mov rdi, 3;                      // DISCONNECTS
        call mbim_note;
        xor rax, rax;
        pop rbx;
        ret;

      mbim_dc_not_conn:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF19B;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Notification post: mbim_notif_post(kind, raw_signal).
  //
  // Records the most recently received notification. kind must be in
  // {SIGNAL_STATE, CONNECT, PACKET_SVC}; raw_signal only meaningful
  // for SIGNAL_STATE (and must fit u16). Requires the control channel
  // to be at least OPEN.
  // ==========================================================================

  pub let mbim_notif_post : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (raw_signal: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): record one notification. Refuses if channel CLOSED. kind must be in enumerated set; raw_signal must fit u16. Labels prefixed mbim_np_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;
        mov r12, rsi;

        lea r10, [rip + _mbim_ctrl_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  mbim_np_not_open;

        cmp rbx, 1;
        je  mbim_np_kind_ok;
        cmp rbx, 2;
        je  mbim_np_kind_ok;
        cmp rbx, 3;
        je  mbim_np_kind_ok;
        jmp mbim_np_bad_notif;

      mbim_np_kind_ok:
        // For SIGNAL_STATE, validate raw_signal fits u16.
        cmp rbx, 1;
        jne mbim_np_store;
        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  mbim_np_bad_signal;

      mbim_np_store:
        lea r10, [rip + _mbim_notif_last];
        mov [r10 + 0], rbx;              // last kind
        mov [r10 + 8], r12;              // last raw

        // Update signal cell only for SIGNAL_STATE.
        cmp rbx, 1;
        jne mbim_np_no_sig;
        lea r10, [rip + _mbim_signal];
        mov [r10 + 0], r12;
      mbim_np_no_sig:

        mov rdi, 4;                      // NOTIFS
        call mbim_note;
        xor rax, rax;
        jmp mbim_np_out;

      mbim_np_not_open:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF19D;
        jmp mbim_np_out;
      mbim_np_bad_notif:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF199;
        jmp mbim_np_out;
      mbim_np_bad_signal:
        mov rdi, 5;
        call mbim_note;
        mov rax, 0xFFFFF198;

      mbim_np_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Session verb: mbim_get_signal_strength() -> raw | BAD_STATE
  //
  // Returns the most recently posted signal-state raw value, or
  // MBIM_BAD_STATE if the channel is CLOSED.
  // ==========================================================================

  pub let mbim_get_signal_strength : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): return last recorded raw signal strength. Labels prefixed mbim_gs_.",
      block: {
        lea r10, [rip + _mbim_ctrl_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  mbim_gs_bad;
        lea r10, [rip + _mbim_signal];
        mov rax, [r10 + 0];
        ret;
      mbim_gs_bad:
        mov rax, 0xFFFFF19F;
        ret
      }
    }

  pub let mbim_notif_last_kind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): last-notification kind readback. Labels prefixed mbim_nk_.",
      block: {
        lea r10, [rip + _mbim_notif_last];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let mbim_notif_last_raw : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-003 (#1361): last-notification raw readback. Labels prefixed mbim_nr_.",
      block: {
        lea r10, [rip + _mbim_notif_last];
        mov rax, [r10 + 8];
        ret
      }
    }
}
