// src/kernel/core/drivers/tb/dma_active_indicator.pdx — R35.M5-004 (#1218)
//
// TB4 external-DMA active indicator — SOURCE-OF-TRUTH channel for the
// persistent compositor overlay that must be visible whenever an
// external TB4 dock holds a DMA-capable tunnel. Per D3 of
// design/roadmap/next-wave-synthesis.md, the "external DMA active"
// indicator is a security-visible signal: a user who cannot see that
// their machine is DMA-live cannot make an informed decision about
// whether to unplug the dock before entering a password.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ATOMIC COUNTER + PUBLISH SEAM half of the indicator. It:
//
//   1. COUNTER — one u64 tracking the number of active DMA-capable
//      tunnels (KIND_TB_ROUTE with tunnel_type = PCIe today; DP/USB3
//      when they gain DMA in the future). Every publish_enter bumps
//      it, every publish_leave decrements it. A decrement that would
//      cross zero is REFUSED (UNDERFLOW), because the alternative --
//      wrapping to 2^64-1 -- would tell the compositor to render
//      the overlay forever.
//
//   2. OBSERVE — a pure read the compositor supervisor consumes.
//      When R43 (compositor GPU pipeline) lands the overlay renderer
//      will poll this on every frame; the render decision is:
//          if observe() > 0: draw overlay
//
//   3. RESET — clears the counter to zero. Used at boot; not called
//      during normal operation because the counter is monotone in the
//      "activity" it records.
//
// IT DOES NOT DRAW THE OVERLAY. R43's compositor owns the pixel
// pipeline; this module owns the value the compositor reads. The
// separation is the same as every other kernel-source-of-truth /
// compositor-consumer pair in this tree (KIND_BACKLIGHT ->
// backlight_channel, KIND_ACPI_EVENT -> evt_stream).
//
// IT DOES NOT WIRE ITSELF INTO tb_route ESTABLISHMENT AUTOMATICALLY.
// R35.M3's pcie_tunnel / dp_tunnel / usb3_tunnel modules call
// publish_enter/leave explicitly when a DMA-capable route is
// established/torn. This module publishes the primitive; the callers
// wire it in. As of R35.M5 the wiring is deferred to R36 (per §5).
//
// dma_active_indicator_arbitrated() returns 0 until the compositor's
// overlay renderer polls this channel.
//
// =============================================================================
// §1  MONOTONE-COUNT DISCIPLINE
// =============================================================================
//
// The counter is a UNSIGNED, SATURATING-AT-ZERO count. It never
// underflows. A publish_leave against a zero counter is refused
// UNDERFLOW rather than silently wrapping, because the failure mode
// of wrapping is: the compositor believes 18 quintillion tunnels are
// active and never turns the overlay off. The refusal is diagnostic
// — the caller has a bookkeeping bug — but the counter's meaning is
// preserved.
//
// =============================================================================
// §2  BOUNDED CAP
// =============================================================================
//
// The counter is capped at DMA_ACT_MAX (256 — an operating system with
// more than 256 simultaneously live DMA-capable TB4 tunnels is a case
// the operator has bigger questions about than counter arithmetic).
// A publish_enter at the cap is refused ENOSPC. The overlay renders
// on non-zero, so a cap breach still shows the overlay; the refusal
// only prevents the counter's SEMANTICS from drifting.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _tb_dma_active_counter and _tb_dma_active_stats are written only by
// helpers in this module. tools/build.sh confines relocations against
// each symbol to `core/drivers/tb/dma_active_indicator.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF8D0..0xFFFFF8DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: trusted_device 0xFFFFF8E0..EF,
// security_policy 0xFFFFF8F0..FF, cascade_harness 0xFFFFF900..0F,
// consent_revoke 0xFFFFF910..1F).
//
// =============================================================================
// §5  DEFERRED WIRING (honesty)
// =============================================================================
//
// The R35.M3 tunnel-establishment sequencers (pcie_tunnel /
// dp_tunnel / usb3_tunnel) do NOT call publish_enter yet, and the
// R35.M3 route-teardown sequencer does NOT call publish_leave. The
// wiring is deferred to R36's IOMMU driver scaffold, at which point
// the publish semantics can be pinned to a live INVALIDATE
// completion rather than the cap-side transition. This module ships
// with the counter and the seam so the compositor supervisor has
// something to poll from R43 forward -- an overlay renderer that
// crashed on a null pointer would defeat the property the indicator
// exists to advertise.

module DmaActiveIndicator = structure {

  // Failure taxonomy — 0xFFFFF8D0..0xFFFFF8DF.
  pub let DMA_ACT_OK        : u64 = 0
  pub let DMA_ACT_BAD_ARG   : u64 = 0xFFFFF8DF
  pub let DMA_ACT_UNDERFLOW : u64 = 0xFFFFF8DE
  pub let DMA_ACT_ENOSPC    : u64 = 0xFFFFF8DD

  pub let DMA_ACT_MAX : u64 = 256

  pub let mut _tb_dma_active_counter : [u64; 1] = uninit @align(64)
  pub let mut _tb_dma_active_stats   : [u64; 8] = uninit @align(64)

  pub let DMA_ACT_ST_ENTERS    : u64 = 0
  pub let DMA_ACT_ST_LEAVES    : u64 = 1
  pub let DMA_ACT_ST_UNDERFLOW : u64 = 2
  pub let DMA_ACT_ST_ENOSPC    : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dma_active_indicator_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-004 (#1218): clear counter + stats. Labels prefixed dai_rs_.",
      block: {
        lea r10, [rip + _tb_dma_active_counter];
        xor rax, rax;
        mov [r10], rax;

        lea r10, [rip + _tb_dma_active_stats];
        xor rcx, rcx;
      dai_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dai_rs_loop;
        ret
      }
    } @no_frame

  pub let dma_active_indicator_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M5-004 (#1218): honesty pin. Returns 0 until the compositor overlay polls observe(). See §5.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dai_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-004 (#1218): counter read.",
      block: {
        cmp rdi, 8;
        jae dai_st_zero;
        lea r10, [rip + _tb_dma_active_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dai_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dai_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-004 (#1218): counter bump. Labels prefixed dai_nt_.",
      block: {
        cmp rdi, 8;
        jae dai_nt_out;
        lea r10, [rip + _tb_dma_active_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dai_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // OBSERVE. Pure read of the counter. The compositor overlay
  // renderer's decision is: if observe() > 0 draw overlay.
  // ==========================================================================

  pub let dma_active_observe : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-004 (#1218): counter read.",
      block: {
        lea r10, [rip + _tb_dma_active_counter];
        mov rax, [r10];
        ret
      }
    } @no_frame

  // ==========================================================================
  // PUBLISH ENTER. Called by a tunnel-establishment sequencer when
  // a new DMA-capable tunnel becomes live. Refuses ENOSPC at the
  // cap (§2).
  // ==========================================================================

  pub let dma_active_publish_enter : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-004 (#1218): bump counter, refuse at cap. Labels prefixed dai_pe_.",
      block: {
        lea r10, [rip + _tb_dma_active_counter];
        mov rax, [r10];
        mov r11, 256;                    // DMA_ACT_MAX
        cmp rax, r11;
        jae dai_pe_full;
        add rax, 1;
        mov [r10], rax;
        mov rdi, 0;                      // ENTERS
        call dai_note;
        xor rax, rax;
        ret;
      dai_pe_full:
        mov rdi, 3;                      // ENOSPC
        call dai_note;
        mov rax, 0xFFFFF8DD;
        ret
      }
    }

  // ==========================================================================
  // PUBLISH LEAVE. Called by a tunnel-teardown sequencer when a
  // DMA-capable tunnel goes away. Refuses UNDERFLOW rather than
  // wrapping (§1).
  // ==========================================================================

  pub let dma_active_publish_leave : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-004 (#1218): decrement counter, refuse on zero. Labels prefixed dai_pl_.",
      block: {
        lea r10, [rip + _tb_dma_active_counter];
        mov rax, [r10];
        cmp rax, 0;
        je  dai_pl_zero;
        sub rax, 1;
        mov [r10], rax;
        mov rdi, 1;                      // LEAVES
        call dai_note;
        xor rax, rax;
        ret;
      dai_pl_zero:
        mov rdi, 2;                      // UNDERFLOW
        call dai_note;
        mov rax, 0xFFFFF8DE;
        ret
      }
    }
}
