// src/kernel/core/drivers/tb/dp_aux_passthru.pdx — R35.M9-002 (#1230)
//
// DP AUX PASS-THROUGH OVER TB4.
//
// The DisplayPort AUX channel (VESA DP 2.1 §2.4) is the low-speed
// side-band the sink and source use to exchange DPCD (Display Port
// Configuration Data), read EDID over I²C-over-AUX, and negotiate
// link training. USB4 §10.6 tunnels AUX packets across the TB4 fabric
// so the far-end panel's AUX transactions reach the host DP source as
// if the panel were connected directly.
//
// dp_tunnel.pdx (R35.M3) counts AUX transactions at the shape-check
// boundary; this module carries the RING that a live driver would
// submit AUX requests through, and the RESPONSE HANDLING vocabulary
// (ACK / NACK / DEFER) each request completes with.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the IN-FLIGHT RING + RESPONSE ARBITRATION half of the AUX
// pass-through. It:
//
//   1. SUBMIT — dpaux_submit(tunnel_slot, cmd_type, address,
//      length) enqueues an AUX request into a 16-slot in-flight ring
//      and returns the slot index. Refuses BAD_CMD (cmd_type not in
//      {0, 1, 8, 9}), BAD_ADDRESS (>= 2^20 for AUX; DP 2.1 §2.4.2),
//      BAD_LENGTH (0 or > 16 bytes; DP 2.1 §2.4.1), ENOSPC when the
//      ring is full, and NOT_TUNNELED (BAD_TUNNEL_SLOT here) for an
//      out-of-range slot.
//
//   2. COMPLETE — dpaux_complete(slot, status) closes the slot with
//      an ACK / NACK / DEFER outcome. Refuses BAD_SLOT (slot >= 16 or
//      not in flight), BAD_STATUS (not in {0, 1, 2}). Bumps the
//      corresponding per-status counter.
//
//   3. LOOKUP — dpaux_slot_in_use(slot), dpaux_slot_cmd(slot),
//      dpaux_slot_address(slot), dpaux_slot_status(slot) let a caller
//      inspect a live or just-completed slot before its next reuse.
//
// IT DOES NOT ISSUE AUX BYTES OVER THE WIRE. That is a live DP AUX
// driver's job; this scaffold is the ring the driver submits into,
// and the fabric transport belongs to cm_rings (R35.M2). The
// counters here account for shape-checked traffic, not for the wire.
//
// IT DOES NOT INTERPRET DPCD BYTES. Whether the read of DPCD offset
// 0x00600 returns POWER_ON or POWER_SAVE, or whether an EDID read
// yields a legal EDID block, is a caller's decision. This module only
// carries the transaction; the payload's meaning is elsewhere.
//
// IT DOES NOT AUTO-RETRY ON DEFER. DP 2.1 §2.4.3 mandates up to 7
// retries on DEFER before a NACK; the retry policy is a caller's
// authority (a live driver typically owns a per-tunnel retry budget).
// This module records that a DEFER happened; the retry is upstream.
//
// dpaux_arbitrated() returns 0 until a live DP AUX driver binds this
// scaffold against real AUX transactions.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _dpaux_pt_ring and _dpaux_pt_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/dp_aux_passthru.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF810..0xFFFFF81F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dp_hotplug_bridge 0xFFFFF800..
// 0F, dp_ddi_shim 0xFFFFF820..2F).

module DpAuxPassthru = structure {

  // Ring capacity + slot geometry.
  pub let DPAUX_RING_MAX  : u64 = 16
  pub let DPAUX_SLOT_U64  : u64 = 8               // 8 u64s per slot (64 bytes)

  // Command types (DP 2.1 §2.4.1, USB4 §10.6).
  pub let DPAUX_CMD_I2C_WRITE    : u64 = 0x0
  pub let DPAUX_CMD_I2C_READ     : u64 = 0x1
  pub let DPAUX_CMD_NATIVE_WRITE : u64 = 0x8
  pub let DPAUX_CMD_NATIVE_READ  : u64 = 0x9

  // Response ordinals.
  pub let DPAUX_RESP_ACK   : u64 = 0
  pub let DPAUX_RESP_NACK  : u64 = 1
  pub let DPAUX_RESP_DEFER : u64 = 2
  pub let DPAUX_RESP_MAX   : u64 = 2

  // Slot status.
  pub let DPAUX_STATUS_FREE      : u64 = 0
  pub let DPAUX_STATUS_IN_FLIGHT : u64 = 1
  pub let DPAUX_STATUS_ACKED     : u64 = 2
  pub let DPAUX_STATUS_NACKED    : u64 = 3
  pub let DPAUX_STATUS_DEFERRED  : u64 = 4

  // AUX address space is 20 bits (DP 2.1 §2.4.2).
  pub let DPAUX_ADDR_MAX : u64 = 0xFFFFF

  // Max transaction size is 16 bytes (DP 2.1 §2.4.1).
  pub let DPAUX_LEN_MAX : u64 = 16

  // Tunnel slot cap. u8-wide like dp_ddi_shim.
  pub let DPAUX_TUNNEL_MAX : u64 = 0xFF

  // Failure taxonomy — 0xFFFFF810..0xFFFFF81F.
  pub let DPAUX_OK              : u64 = 0
  pub let DPAUX_BAD_ARG         : u64 = 0xFFFFF81F
  pub let DPAUX_BAD_CMD         : u64 = 0xFFFFF81E
  pub let DPAUX_BAD_ADDRESS     : u64 = 0xFFFFF81D
  pub let DPAUX_BAD_LENGTH      : u64 = 0xFFFFF81C
  pub let DPAUX_BAD_TUNNEL_SLOT : u64 = 0xFFFFF81B
  pub let DPAUX_BAD_STATUS      : u64 = 0xFFFFF81A
  pub let DPAUX_BAD_SLOT        : u64 = 0xFFFFF819
  pub let DPAUX_ENOSPC          : u64 = 0xFFFFF818

  pub let DPAUX_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPAUX_SLOT_NONE  : u64 = 0xFF

  // Slot (8 u64s, 64 bytes):
  //   [+0]  in_use  (0/1)
  //   [+8]  tunnel_slot
  //   [+16] cmd_type
  //   [+24] address
  //   [+32] length
  //   [+40] status
  //   [+48] reserved
  //   [+56] reserved
  pub let mut _dpaux_pt_ring  : [u64; 128] = uninit @align(64)  // 16 slots × 8 u64
  pub let mut _dpaux_pt_stats : [u64; 8]   = uninit @align(64)

  pub let DPAUX_ST_SUBMITS   : u64 = 0
  pub let DPAUX_ST_ACKS      : u64 = 1
  pub let DPAUX_ST_NACKS     : u64 = 2
  pub let DPAUX_ST_DEFERS    : u64 = 3
  pub let DPAUX_ST_REJECTS   : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dpaux_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): clear ring + stats. Labels prefixed dpaux_rs_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _dpaux_pt_ring];
      dpaux_rs_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  dpaux_rs_r;

        xor rcx, rcx;
        lea r10, [rip + _dpaux_pt_stats];
      dpaux_rs_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dpaux_rs_s;
        ret
      }
    }

  pub let dpaux_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-002 (#1230): honesty pin. Returns 0 until a live DP AUX driver binds this against real AUX transactions.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): counter read.",
      block: {
        cmp rdi, 8;
        jae dpaux_st_zero;
        lea r10, [rip + _dpaux_pt_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpaux_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): counter bump. Labels prefixed dpaux_nt_.",
      block: {
        cmp rdi, 8;
        jae dpaux_nt_out;
        lea r10, [rip + _dpaux_pt_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpaux_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Slot accessors. slot byte offset = slot * 64 = slot << 6.
  // ==========================================================================

  pub let dpaux_slot_in_use : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): read slot.in_use.",
      block: {
        cmp rdi, 16;
        jae dpaux_si_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, rbx;
        mov rax, [r10 + 0];
        pop rbx;
        ret;
      dpaux_si_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_slot_tunnel : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): read slot.tunnel_slot.",
      block: {
        cmp rdi, 16;
        jae dpaux_stn_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, rbx;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      dpaux_stn_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_slot_cmd : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): read slot.cmd_type.",
      block: {
        cmp rdi, 16;
        jae dpaux_sc_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, rbx;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      dpaux_sc_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_slot_address : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): read slot.address.",
      block: {
        cmp rdi, 16;
        jae dpaux_sa_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, rbx;
        mov rax, [r10 + 24];
        pop rbx;
        ret;
      dpaux_sa_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_slot_length : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): read slot.length.",
      block: {
        cmp rdi, 16;
        jae dpaux_sl_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, rbx;
        mov rax, [r10 + 32];
        pop rbx;
        ret;
      dpaux_sl_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_slot_status : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): read slot.status.",
      block: {
        cmp rdi, 16;
        jae dpaux_sst_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, rbx;
        mov rax, [r10 + 40];
        pop rbx;
        ret;
      dpaux_sst_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpaux_cmd_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-002 (#1230): 1 iff c in {0, 1, 8, 9}.",
      block: {
        cmp rdi, 0;
        je  dpaux_cv_yes;
        cmp rdi, 1;
        je  dpaux_cv_yes;
        cmp rdi, 8;
        je  dpaux_cv_yes;
        cmp rdi, 9;
        je  dpaux_cv_yes;
        xor rax, rax;
        ret;
      dpaux_cv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let dpaux_addr_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-002 (#1230): 1 iff a fits in 20 bits.",
      block: {
        mov r10, 0xFFFFF;
        cmp rdi, r10;
        ja  dpaux_av_no;
        mov rax, 1;
        ret;
      dpaux_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_len_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-002 (#1230): 1 iff l in [1, 16].",
      block: {
        cmp rdi, 0;
        je  dpaux_lv_no;
        cmp rdi, 16;
        ja  dpaux_lv_no;
        mov rax, 1;
        ret;
      dpaux_lv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_tunnel_valid : (u64) -> u64 !{} @{} =
    fn (ts: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-002 (#1230): 1 iff ts fits in u8.",
      block: {
        cmp rdi, 0xFF;
        ja  dpaux_tv_no;
        mov rax, 1;
        ret;
      dpaux_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dpaux_resp_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-002 (#1230): 1 iff r in [0, 2].",
      block: {
        cmp rdi, 2;
        ja  dpaux_rv_no;
        mov rax, 1;
        ret;
      dpaux_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dpaux_submit(tunnel_slot, cmd_type, address, length).
  //
  // Sequence:
  //   1. tunnel_slot fits u8            (BAD_TUNNEL_SLOT)
  //   2. cmd_type in {0, 1, 8, 9}       (BAD_CMD)
  //   3. address fits 20 bits           (BAD_ADDRESS)
  //   4. length in [1, 16]              (BAD_LENGTH)
  //   5. allocate free slot             (ENOSPC)
  //   6. commit; IN_FLIGHT; SUBMITS++
  // ==========================================================================

  pub let dpaux_submit : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) (cmd_type: u64) (address: u64) (length: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): enqueue an AUX request. Returns slot id or error. Labels prefixed dpaux_su_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // tunnel_slot
        mov r12, rsi;                    // cmd
        mov r13, rdx;                    // address
        mov r14, rcx;                    // length

        mov rdi, rbx;
        call dpaux_tunnel_valid;
        cmp rax, 0;
        je  dpaux_su_bad_tunnel;

        mov rdi, r12;
        call dpaux_cmd_valid;
        cmp rax, 0;
        je  dpaux_su_bad_cmd;

        mov rdi, r13;
        call dpaux_addr_valid;
        cmp rax, 0;
        je  dpaux_su_bad_addr;

        mov rdi, r14;
        call dpaux_len_valid;
        cmp rax, 0;
        je  dpaux_su_bad_len;

        // Scan for free slot.
        xor r15, r15;
      dpaux_su_scan:
        cmp r15, 16;
        jae dpaux_su_full;
        mov rdi, r15;
        call dpaux_slot_in_use;
        cmp rax, 0;
        je  dpaux_su_free;
        add r15, 1;
        jmp dpaux_su_scan;

      dpaux_su_free:
        // Byte offset = r15 * 64.
        push r15;
        mov rax, r15;
        shl rax, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, rax;
        mov rax, 1;
        mov [r10 + 0], rax;
        mov [r10 + 8], rbx;
        mov [r10 + 16], r12;
        mov [r10 + 24], r13;
        mov [r10 + 32], r14;
        mov rax, 1;                      // IN_FLIGHT
        mov [r10 + 40], rax;
        xor rax, rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 0;                      // SUBMITS
        call dpaux_note;
        pop rax;                         // return slot id
        jmp dpaux_su_out;

      dpaux_su_bad_tunnel:
        mov rdi, 4;
        call dpaux_note;
        mov rax, 0xFFFFF81B;
        jmp dpaux_su_out;
      dpaux_su_bad_cmd:
        mov rdi, 4;
        call dpaux_note;
        mov rax, 0xFFFFF81E;
        jmp dpaux_su_out;
      dpaux_su_bad_addr:
        mov rdi, 4;
        call dpaux_note;
        mov rax, 0xFFFFF81D;
        jmp dpaux_su_out;
      dpaux_su_bad_len:
        mov rdi, 4;
        call dpaux_note;
        mov rax, 0xFFFFF81C;
        jmp dpaux_su_out;
      dpaux_su_full:
        mov rdi, 4;
        call dpaux_note;
        mov rax, 0xFFFFF818;

      dpaux_su_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpaux_complete(slot, response).
  //
  // Sequence:
  //   1. slot < 16                             (BAD_SLOT)
  //   2. slot in_use == 1 && status == IN_FLIGHT (BAD_SLOT)
  //   3. response in {0, 1, 2}                 (BAD_STATUS)
  //   4. write status = ACKED / NACKED / DEFERRED
  //   5. clear in_use (slot becomes reusable);
  //      bump per-response counter.
  //
  // The slot's fields (cmd_type / address / length) are preserved so
  // the caller can inspect them one last time after completion; the
  // in_use flag is what marks the slot reusable, and dpaux_slot_status
  // continues to report ACKED / NACKED / DEFERRED until the slot is
  // reused. The next dpaux_submit that lands here overwrites them.
  // ==========================================================================

  pub let dpaux_complete : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (response: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): close an in-flight AUX slot with ACK/NACK/DEFER. Labels prefixed dpaux_cp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // response

        cmp rbx, 16;
        jae dpaux_cp_bad_slot;

        mov rdi, rbx;
        call dpaux_slot_in_use;
        cmp rax, 0;
        je  dpaux_cp_bad_slot;

        mov rdi, rbx;
        call dpaux_slot_status;
        cmp rax, 1;                      // IN_FLIGHT
        jne dpaux_cp_bad_slot;

        mov rdi, r12;
        call dpaux_resp_valid;
        cmp rax, 0;
        je  dpaux_cp_bad_status;

        // Byte offset = slot * 64.
        mov r13, rbx;
        shl r13, 6;
        lea r10, [rip + _dpaux_pt_ring];
        add r10, r13;

        // status = 2 + response  (ACKED=2, NACKED=3, DEFERRED=4)
        mov rax, r12;
        add rax, 2;
        mov [r10 + 40], rax;

        // in_use = 0 (slot reusable, status remains readable)
        xor rax, rax;
        mov [r10 + 0], rax;

        // Per-response counter: ACK->1, NACK->2, DEFER->3.
        mov rdi, r12;
        add rdi, 1;
        call dpaux_note;

        xor rax, rax;
        jmp dpaux_cp_out;

      dpaux_cp_bad_slot:
        mov rdi, 4;
        call dpaux_note;
        mov rax, 0xFFFFF819;
        jmp dpaux_cp_out;
      dpaux_cp_bad_status:
        mov rdi, 4;
        call dpaux_note;
        mov rax, 0xFFFFF81A;

      dpaux_cp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpaux_in_flight_count — number of currently-in-flight slots.
  // ==========================================================================

  pub let dpaux_in_flight_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-002 (#1230): count in_use slots.",
      block: {
        push rbx;
        push r12;

        xor rbx, rbx;
        xor r12, r12;
      dpaux_ifc_it:
        cmp r12, 16;
        jae dpaux_ifc_done;
        mov rdi, r12;
        call dpaux_slot_in_use;
        cmp rax, 0;
        je  dpaux_ifc_next;
        add rbx, 1;
      dpaux_ifc_next:
        add r12, 1;
        jmp dpaux_ifc_it;
      dpaux_ifc_done:
        mov rax, rbx;
        pop r12;
        pop rbx;
        ret
      }
    }
}
