// src/kernel/core/drivers/tb/sw_cm_evtmux.pdx — R35.M6-003 (#1221)
//
// Software Connection Manager (sw-CM) EVENT DEMULTIPLEXER.
//
// The cm_rings RX ring (R35.M2 — cm_rings.pdx) delivers control
// packets originating in downstream routers: notifications about
// paths appearing and disappearing, port state transitions, and
// tunnel life-cycle events. This module PARSES a packed event word,
// DISPATCHES it to the appropriate sw_cm_fsm transition, and
// COUNTS what it dispatched, refused and classified as unknown.
//
// The event vocabulary is deliberately small:
//
//   * SWEVT_PATH_ADDED     (1) — arg = slot; transitions path to
//                                PROBED.
//   * SWEVT_PATH_REMOVED   (2) — arg = slot; transitions path to
//                                TORN.
//   * SWEVT_PORT_STATE     (3) — arg = (slot << 8) | new_state;
//                                transitions port to new_state
//                                (validated by fsm's per-tier
//                                legality table).
//   * SWEVT_TUNNEL         (4) — arg = (slot << 8) | new_state;
//                                transitions tunnel to new_state.
//
// A packed event word encodes:
//     type[7:0] | slot[15:8] | new_state[23:16] | flags[63:24]
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DEMUX + COUNT half of the RX event path. It:
//
//   1. PACK / UNPACK — pack_event, unpack_type / unpack_slot /
//      unpack_new_state helpers. Packing is exposed so a witness (or
//      a future live router-response translator) can synthesise
//      events in the same shape the demux expects.
//
//   2. DISPATCH — sw_cm_evtmux_dispatch(packed) parses type and
//      calls the appropriate sw_cm_fsm transition. Returns 0 on
//      success, the transition's error code on refusal, or
//      SWMUX_UNKNOWN if type is not in the table.
//
//   3. COUNTS — per-type counters (path_added, path_removed,
//      port_state, tunnel_evt), an unknown counter and a refused
//      counter. The unknown counter is separate from the refused
//      counter because "the FSM refused a legal-shape transition"
//      and "the event demux got a byte it does not understand" are
//      different bug classes with different remediations.
//
// IT DOES NOT ITSELF READ FROM THE RX RING. The caller (a future
// evtloop task) reads tb_cm_rx_dequeue and hands the packed word to
// this module. Splitting the reader from the dispatcher lets the
// same demux serve a live RX consumer and a witness that inject a
// packed word inline.
//
// IT DOES NOT SUBSCRIBE TO CROSS-TIER SIDE EFFECTS. A PATH_REMOVED
// on a slot whose tunnel is still ESTABLISHED does NOT auto-tear the
// tunnel — that is the responsibility of the R35.M3 route_teardown
// sequencer, whose ordering discipline is documented. This module
// applies one transition per event.
//
// sw_cm_evtmux_arbitrated() returns 0 until the R42 evtloop task is
// bound as this module's RX-dequeue caller.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _sw_cm_evtmux_stats and _sw_cm_evtmux_last are written only by
// helpers in this module. tools/build.sh confines relocations
// against each symbol to `core/drivers/tb/sw_cm_evtmux.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF8A0..0xFFFFF8AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: sw_cm_cmdq 0xFFFFF8B0..BF,
// sw_cm_fsm 0xFFFFF8C0..CF, sw_cm_fw_interop 0xFFFFF890..9F).

module SwCmEvtmux = structure {

  // Event ordinals.
  pub let SWEVT_UNSPEC       : u64 = 0
  pub let SWEVT_PATH_ADDED   : u64 = 1
  pub let SWEVT_PATH_REMOVED : u64 = 2
  pub let SWEVT_PORT_STATE   : u64 = 3
  pub let SWEVT_TUNNEL       : u64 = 4
  pub let SWEVT_MAX          : u64 = 4

  // Failure taxonomy — 0xFFFFF8A0..0xFFFFF8AF.
  pub let SWMUX_OK        : u64 = 0
  pub let SWMUX_BAD_ARG   : u64 = 0xFFFFF8AF
  pub let SWMUX_UNKNOWN   : u64 = 0xFFFFF8AE
  pub let SWMUX_BAD_SLOT  : u64 = 0xFFFFF8AD
  pub let SWMUX_BAD_STATE : u64 = 0xFFFFF8AC
  pub let SWMUX_REFUSED   : u64 = 0xFFFFF8AB

  pub let SWMUX_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _sw_cm_evtmux_stats : [u64; 8] = uninit @align(64)
  // Last packed event dispatched — for diagnostics.
  pub let mut _sw_cm_evtmux_last  : [u64; 1] = uninit @align(8)

  pub let SWMUX_ST_PATH_ADDED   : u64 = 0
  pub let SWMUX_ST_PATH_REMOVED : u64 = 1
  pub let SWMUX_ST_PORT_STATE   : u64 = 2
  pub let SWMUX_ST_TUNNEL       : u64 = 3
  pub let SWMUX_ST_UNKNOWN      : u64 = 4
  pub let SWMUX_ST_REFUSED      : u64 = 5
  pub let SWMUX_ST_DISPATCHED   : u64 = 6

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let sw_cm_evtmux_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-003 (#1221): clear stats + last-event. Labels prefixed semr_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _sw_cm_evtmux_stats];
        xor rcx, rcx;
      semr_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  semr_s;
        lea r10, [rip + _sw_cm_evtmux_last];
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  pub let sw_cm_evtmux_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-003 (#1221): honesty pin. Returns 0 until the R42 evtloop task is bound as this module's RX-dequeue caller.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sw_cm_evtmux_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-003 (#1221): counter read.",
      block: {
        cmp rdi, 8;
        jae semst_zero;
        lea r10, [rip + _sw_cm_evtmux_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      semst_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sem_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-003 (#1221): counter bump. Labels prefixed semn_.",
      block: {
        cmp rdi, 8;
        jae semn_out;
        lea r10, [rip + _sw_cm_evtmux_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      semn_out:
        ret
      }
    } @no_frame

  pub let sw_cm_evtmux_last : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-003 (#1221): last-event read.",
      block: {
        lea r10, [rip + _sw_cm_evtmux_last];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Pack / unpack.
  //   type[7:0] | slot[15:8] | new_state[23:16] | flags[63:24]
  // ==========================================================================

  pub let sw_cm_evt_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (evt_type: u64) (slot: u64) (new_state: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-003 (#1221): pack event word. Refuses evt_type > MAX, slot >= 32, new_state > 255, flags > 40 bits. Labels prefixed sep_.",
      block: {
        cmp rdi, 4;                      // SWEVT_MAX
        ja  sep_bad;
        cmp rsi, 32;
        jae sep_bad;
        cmp rdx, 0xFF;
        ja  sep_bad;
        mov r10, 0xFFFFFFFFFF;
        cmp rcx, r10;
        ja  sep_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFFFFFFFFFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      sep_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let sw_cm_evt_type : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-003 (#1221): unpack type.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let sw_cm_evt_slot : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-003 (#1221): unpack slot.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let sw_cm_evt_new_state : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-003 (#1221): unpack new_state.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Dispatch. Reads type; hands off to fsm; classifies outcome.
  // ==========================================================================

  pub let sw_cm_evtmux_dispatch : (u64) -> u64 !{mem} @{} =
    fn (packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-003 (#1221): dispatch by event type. Stamps last-event. Labels prefixed semd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // packed

        lea r10, [rip + _sw_cm_evtmux_last];
        mov [r10 + 0], rbx;

        mov rdi, rbx;
        call sw_cm_evt_type;
        mov r12, rax;                    // type

        mov rdi, rbx;
        call sw_cm_evt_slot;
        mov r13, rax;                    // slot

        cmp r12, 1;                      // PATH_ADDED
        je  semd_path_added;
        cmp r12, 2;                      // PATH_REMOVED
        je  semd_path_removed;
        cmp r12, 3;                      // PORT_STATE
        je  semd_port_state;
        cmp r12, 4;                      // TUNNEL
        je  semd_tunnel;
        jmp semd_unknown;

      semd_path_added:
        mov rdi, r13;
        mov rsi, 1;                      // PROBED
        call sw_cm_fsm_path_transition;
        cmp rax, 0;
        jne semd_refused;
        mov rdi, 0;
        call sem_note;
        jmp semd_ok;

      semd_path_removed:
        mov rdi, r13;
        mov rsi, 3;                      // TORN
        call sw_cm_fsm_path_transition;
        cmp rax, 0;
        jne semd_refused;
        mov rdi, 1;
        call sem_note;
        jmp semd_ok;

      semd_port_state:
        mov rdi, rbx;
        call sw_cm_evt_new_state;
        mov rdi, r13;
        mov rsi, rax;
        call sw_cm_fsm_port_transition;
        cmp rax, 0;
        jne semd_refused;
        mov rdi, 2;
        call sem_note;
        jmp semd_ok;

      semd_tunnel:
        mov rdi, rbx;
        call sw_cm_evt_new_state;
        mov rdi, r13;
        mov rsi, rax;
        call sw_cm_fsm_tunnel_transition;
        cmp rax, 0;
        jne semd_refused;
        mov rdi, 3;
        call sem_note;
        jmp semd_ok;

      semd_ok:
        mov rdi, 6;                      // DISPATCHED
        call sem_note;
        xor rax, rax;
        jmp semd_out;

      semd_unknown:
        mov rdi, 4;                      // UNKNOWN
        call sem_note;
        mov rax, 0xFFFFF8AE;
        jmp semd_out;

      semd_refused:
        push rax;
        mov rdi, 5;                      // REFUSED
        call sem_note;
        pop rax;

      semd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
