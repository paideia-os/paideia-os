// src/kernel/core/drivers/tb/pcie_tunnel.pdx — R35.M3-001 (#1205)
//
// TB4 PCIe protocol adapter — tunnel establishment scaffold. Per
// USB4 §7 (PCIe Adapter), a PCIe tunnel is established by allocating
// two paths (upstream and downstream) between two PCIe protocol
// adapters on distinct routers in a domain, then configuring the
// downstream port so that the exposed PCIe device appears to the
// host as a device on the local PCIe hierarchy.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ARBITRATION + PATH BOOKKEEPING half of PCIe tunnel
// establishment. USB4 §7.4 defines the CONFIG_SPACE writes the CM
// issues to allocate a path (a hop-by-hop reservation of one
// contiguous adapter chain) and the DOWNSTREAM PORT CONFIG the
// exposed device requires. This scaffold owns:
//
//   * A pair of counter arrays tracking recognition attempts,
//     allocations, refusals and rejects.
//   * Validators for the pieces of the request the kernel can check
//     without touching hardware (source/sink adapter, tunnel
//     direction, request shape).
//   * An arbitration pin — pcie_tunnel_arbitrated() — that returns 0
//     until a live driver binds this scaffold against real router
//     adapter registers.
//
// IT DOES NOT ISSUE CM PACKETS. The CONFIG_SPACE writes required to
// allocate paths are the driver's responsibility; this scaffold's
// pcie_tunnel_negotiate_recognise verifies the request shape only.
// A live driver hands the recognized shape to cm_rings.pdx for the
// actual submission.
//
// IT DOES NOT MINT KIND_TB_ROUTE. Path allocation is a bookkeeping
// operation; the capability that names the established tunnel is
// KIND_TB_ROUTE, minted by kind_tb_route.pdx once negotiation
// completes and both endpoints report ACTIVE.
//
// =============================================================================
// §1  PATH DIRECTIONS (USB4 §7.4)
// =============================================================================
//
// A PCIe tunnel is bidirectional but expressed as TWO paths: one
// upstream (device → host) and one downstream (host → device). The
// scaffold's UPSTREAM / DOWNSTREAM ordinals identify which side of
// the pair a recognize call is validating.
//
//   0  UPSTREAM   — device-side PCIe adapter → host-side adapter
//   1  DOWNSTREAM — host-side PCIe adapter → device-side adapter
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _pcie_tunnel_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/tb/pcie_tunnel.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF990..0xFFFFF99F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: kind_tb_route 0xFFFFF9A0..AF,
// dp_tunnel 0xFFFFF980..8F, usb3_tunnel 0xFFFFF970..7F,
// route_teardown 0xFFFFF960..6F).

module PcieTunnel = structure {

  // Path direction ordinals (§1).
  pub let PCIE_TUN_UPSTREAM   : u64 = 0
  pub let PCIE_TUN_DOWNSTREAM : u64 = 1
  pub let PCIE_TUN_DIR_MAX    : u64 = 1

  // Failure taxonomy — 0xFFFFF990..0xFFFFF99F.
  pub let PCIE_TUN_OK           : u64 = 0
  pub let PCIE_TUN_BAD_ARG      : u64 = 0xFFFFF99F
  pub let PCIE_TUN_BAD_DIR      : u64 = 0xFFFFF99E
  pub let PCIE_TUN_BAD_ADAPTER  : u64 = 0xFFFFF99D
  pub let PCIE_TUN_BAD_ROUTE    : u64 = 0xFFFFF99C
  pub let PCIE_TUN_SELF_LOOP    : u64 = 0xFFFFF99B
  pub let PCIE_TUN_BAD_CONFIG   : u64 = 0xFFFFF99A

  pub let mut _pcie_tunnel_stats : [u64; 8] = uninit @align(64)

  pub let PCIE_TUN_ST_ATTEMPTS  : u64 = 0
  pub let PCIE_TUN_ST_ALLOC_UP  : u64 = 1
  pub let PCIE_TUN_ST_ALLOC_DN  : u64 = 2
  pub let PCIE_TUN_ST_REJECTS   : u64 = 3
  pub let PCIE_TUN_ST_CONFIG    : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let pcie_tunnel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-001 (#1205): clear stats. Labels prefixed ptn_rs_.",
      block: {
        lea r10, [rip + _pcie_tunnel_stats];
        xor rax, rax;
        xor rcx, rcx;
      ptn_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ptn_rs_loop;
        ret
      }
    }

  pub let pcie_tunnel_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-001 (#1205): honesty pin. Returns 0 until a later round binds this against live router CONFIG_SPACE.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let pcie_tunnel_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-001 (#1205): counter read.",
      block: {
        cmp rdi, 8;
        jae ptn_st_zero;
        lea r10, [rip + _pcie_tunnel_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ptn_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_tunnel_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-001 (#1205): counter bump. Labels prefixed ptn_nt_.",
      block: {
        cmp rdi, 8;
        jae ptn_nt_out;
        lea r10, [rip + _pcie_tunnel_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ptn_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let pcie_tun_dir_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-001 (#1205): 1 iff d in {0,1}. Labels prefixed ptn_dv_.",
      block: {
        cmp rdi, 1;
        ja  ptn_dv_no;
        mov rax, 1;
        ret;
      ptn_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_tun_adapter_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-001 (#1205): 1 iff a fits in u8. Labels prefixed ptn_av_.",
      block: {
        cmp rdi, 0xFF;
        ja  ptn_av_no;
        mov rax, 1;
        ret;
      ptn_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_tun_route_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-001 (#1205): 1 iff r fits in 24 bits (USB4 route). Labels prefixed ptn_rv_.",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  ptn_rv_no;
        mov rax, 1;
        ret;
      ptn_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Path allocation (recognize phase). Given a proposed (route_id,
  // source_adapter, sink_adapter, direction), verify the request
  // shape. A caller passes the request to cm_rings for actual
  // submission.
  //
  // Sequence:
  //   1. Direction valid (§1)
  //   2. Source adapter fits u8
  //   3. Sink adapter fits u8
  //   4. Source != Sink (SELF_LOOP refused)
  //   5. Route fits 24 bits
  //
  // Returns 0 on success (increments ALLOC_UP or ALLOC_DN by
  // direction), one of the failure codes above on refusal.
  // ==========================================================================

  pub let pcie_tunnel_path_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (source_adapter: u64) (sink_adapter: u64) (direction: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-001 (#1205): recognize one path allocation request. Refuses SELF_LOOP (source == sink) rather than forwarding to cm_rings — a live driver cannot recover from a routing loop and must be told at the API boundary. Labels prefixed ptn_pa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // route_id
        mov r12, rsi;                    // source_adapter
        mov r13, rdx;                    // sink_adapter
        mov r14, rcx;                    // direction

        mov rdi, 0;                      // ATTEMPTS
        call pcie_tunnel_note;

        // Direction.
        mov rdi, r14;
        call pcie_tun_dir_valid;
        cmp rax, 0;
        je  ptn_pa_bad_dir;

        // Source adapter.
        mov rdi, r12;
        call pcie_tun_adapter_valid;
        cmp rax, 0;
        je  ptn_pa_bad_adapter;

        // Sink adapter.
        mov rdi, r13;
        call pcie_tun_adapter_valid;
        cmp rax, 0;
        je  ptn_pa_bad_adapter;

        // Self-loop.
        cmp r12, r13;
        je  ptn_pa_self_loop;

        // Route.
        mov rdi, rbx;
        call pcie_tun_route_valid;
        cmp rax, 0;
        je  ptn_pa_bad_route;

        // Bump the correct counter.
        cmp r14, 0;                      // UPSTREAM
        jne ptn_pa_dn;
        mov rdi, 1;                      // ALLOC_UP
        call pcie_tunnel_note;
        xor rax, rax;
        jmp ptn_pa_out;

      ptn_pa_dn:
        mov rdi, 2;                      // ALLOC_DN
        call pcie_tunnel_note;
        xor rax, rax;
        jmp ptn_pa_out;

      ptn_pa_bad_dir:
        mov rdi, 3;
        call pcie_tunnel_note;
        mov rax, 0xFFFFF99E;
        jmp ptn_pa_out;
      ptn_pa_bad_adapter:
        mov rdi, 3;
        call pcie_tunnel_note;
        mov rax, 0xFFFFF99D;
        jmp ptn_pa_out;
      ptn_pa_bad_route:
        mov rdi, 3;
        call pcie_tunnel_note;
        mov rax, 0xFFFFF99C;
        jmp ptn_pa_out;
      ptn_pa_self_loop:
        mov rdi, 3;
        call pcie_tunnel_note;
        mov rax, 0xFFFFF99B;

      ptn_pa_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Downstream port config recognition. Given a config word for the
  // exposed device's downstream port (config_word packs
  // secondary_bus[7:0], subordinate_bus[15:8], link_speed[23:16]),
  // verify the shape.
  //
  // Sequence:
  //   1. secondary_bus > 0
  //   2. subordinate_bus >= secondary_bus
  //   3. link_speed in [1, 6] (PCIe generations 1..6)
  //
  // Returns 0 on success (increments CONFIG), BAD_CONFIG on refusal.
  // ==========================================================================

  pub let pcie_tunnel_ds_config : (u64) -> u64 !{mem} @{} =
    fn (config_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-001 (#1205): recognize downstream port config. Refuses inverted bus ranges (subordinate < secondary) rather than clipping. Labels prefixed ptn_dc_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rax, rbx;
        and rax, 0xFF;                   // secondary_bus
        cmp rax, 0;
        je  ptn_dc_bad;

        mov r10, rbx;
        shr r10, 8;
        and r10, 0xFF;                   // subordinate_bus
        cmp r10, rax;
        jb  ptn_dc_bad;

        mov r10, rbx;
        shr r10, 16;
        and r10, 0xFF;                   // link_speed
        cmp r10, 1;
        jb  ptn_dc_bad;
        cmp r10, 6;
        ja  ptn_dc_bad;

        mov rdi, 4;                      // CONFIG
        call pcie_tunnel_note;
        xor rax, rax;
        jmp ptn_dc_out;

      ptn_dc_bad:
        mov rdi, 3;
        call pcie_tunnel_note;
        mov rax, 0xFFFFF99A;

      ptn_dc_out:
        pop rbx;
        ret
      }
    }
}
