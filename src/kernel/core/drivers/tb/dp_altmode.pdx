// src/kernel/core/drivers/tb/dp_altmode.pdx — R35.M10-003 (#1234)
//
// DISPLAYPORT ALT MODE VIA USB-PD STRUCTURED VDMs.
//
// VESA DisplayPort Alt Mode 2.1 negotiates a DP session on a USB-C
// connector by exchanging Structured VDMs (SVDMs) over USB-PD:
//
//     Discover Identity   -> confirms Alt Mode-capable partner
//     Discover SVIDs      -> confirms 0xFF01 (VESA DP) in the list
//     Discover Modes      -> retrieves DP capabilities (SST/MST, pin
//                            assignments A..F, HPD support)
//     Enter Mode 0xFF01   -> switches physical layer into DP muxing
//     DP Status VDM       -> announces DFP_D / UFP_D role and HPD
//     DP Configure VDM    -> commits pin assignment
//     Exit Mode 0xFF01    -> tears the session down
//
// This module is the PER-PORT ENTER/CONFIGURE/EXIT STATE MACHINE that
// carries a DP alt-mode session through those transitions, plus the
// DP Status VDM's HPD / role bits and a PIN-ASSIGNMENT VALIDATOR that
// refuses combinations DP 2.1 §5.4 does not permit.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the PER-PORT DP ALT-MODE FSM half of the USB-PD SVDM
// exchange. It:
//
//   1. ENTER — dpam_enter(port, pin_assignment) opens a DP session on
//      the port with the given pin assignment. Refuses BAD_PORT,
//      BAD_PIN (not exactly one of A..F), ALREADY_ENTERED (port state
//      already ENTERED or CONFIGURED). Transitions state to ENTERED.
//
//   2. STATUS — dpam_status(port, dfp_ufp, hpd_high) records the DP
//      Status VDM bits. Refuses BAD_PORT, BAD_ARG (dfp_ufp not in
//      {0, 1, 2, 3}), NOT_ENTERED (port state == INACTIVE). Sets the
//      HPD and role bits on the port row.
//
//   3. CONFIGURE — dpam_configure(port, pin_assignment) commits the
//      pin assignment after ENTER. Refuses BAD_PORT, BAD_PIN,
//      BAD_STATE (port state != ENTERED). Transitions state to
//      CONFIGURED.
//
//   4. EXIT — dpam_exit(port) tears down the DP session. Refuses
//      BAD_PORT, NOT_ENTERED (state == INACTIVE). Transitions state
//      to EXITED and clears pin / hpd / role.
//
//   5. QUERY — dpam_port_state / dpam_port_pin / dpam_port_hpd /
//      dpam_port_role read individual fields. dpam_active_count()
//      returns the number of ports whose state is ENTERED or
//      CONFIGURED.
//
// IT DOES NOT SEND VDMs OVER CC. That is a live PD stack's job. This
// scaffold records the transitions the messages would drive.
//
// IT DOES NOT PROBE FOR DP SVID. dpam_enter assumes the caller has
// already run Discover Identity / SVIDs / Modes and confirmed the
// partner speaks DP 0xFF01. The scaffold refuses ENTER on the FSM
// grounds (state, pin assignment) rather than on discovery grounds.
//
// IT DOES NOT MUX THE PHY. The USB-C mux (typically a PCH SIO PD
// controller behind an FSA4480-family analog switch on the T14 G4)
// belongs to the platform driver. The scaffold's ENTER records the
// intent; the mux switch belongs elsewhere.
//
// dpam_arbitrated() returns 0 until a live PD stack binds this
// scaffold against real SVDM traffic.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _dpam_ports and _dpam_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/dp_altmode.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF7D0..0xFFFFF7DF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: usbpd_contract 0xFFFFF7E0..
// EF).

module DpAltmode = structure {

  // Port capacity + slot geometry.
  pub let DPAM_PORT_MAX     : u64 = 4               // per-host DP-alt ports
  pub let DPAM_PORT_U64     : u64 = 8               // 8 u64s per port row

  // VESA DisplayPort SVID (DP Alt Mode 2.1 §5.1).
  pub let DPAM_SVID         : u64 = 0xFF01

  // State ordinals.
  pub let DPAM_STATE_INACTIVE   : u64 = 0
  pub let DPAM_STATE_ENTERED    : u64 = 1
  pub let DPAM_STATE_CONFIGURED : u64 = 2
  pub let DPAM_STATE_EXITED     : u64 = 3

  // Pin assignment bitmask (DP Alt Mode 2.1 §5.4 Table 5-5).
  // Exactly one bit must be set on ENTER / CONFIGURE.
  pub let DPAM_PIN_A : u64 = 0x01
  pub let DPAM_PIN_B : u64 = 0x02
  pub let DPAM_PIN_C : u64 = 0x04
  pub let DPAM_PIN_D : u64 = 0x08
  pub let DPAM_PIN_E : u64 = 0x10
  pub let DPAM_PIN_F : u64 = 0x20
  pub let DPAM_PIN_MASK : u64 = 0x3F                // A..F

  // Role bits from DP Status VDM (DP Alt Mode 2.1 §5.5.2).
  //   bit 0: UFP_D (partner sinks video)
  //   bit 1: DFP_D (partner sources video)
  // The two are not mutually exclusive on a dual-role sink.
  pub let DPAM_ROLE_UFP_D : u64 = 0x1
  pub let DPAM_ROLE_DFP_D : u64 = 0x2
  pub let DPAM_ROLE_MASK  : u64 = 0x3

  // Failure taxonomy — 0xFFFFF7D0..0xFFFFF7DF.
  pub let DPAM_OK               : u64 = 0
  pub let DPAM_BAD_ARG          : u64 = 0xFFFFF7DF
  pub let DPAM_BAD_PORT         : u64 = 0xFFFFF7DE
  pub let DPAM_BAD_PIN          : u64 = 0xFFFFF7DD
  pub let DPAM_BAD_STATE        : u64 = 0xFFFFF7DC
  pub let DPAM_NOT_ENTERED      : u64 = 0xFFFFF7DB
  pub let DPAM_ALREADY_ENTERED  : u64 = 0xFFFFF7DA

  pub let DPAM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Port row (8 u64s, 64 bytes):
  //   [+0]  in_use     (0/1)
  //   [+8]  state
  //   [+16] pin_assignment
  //   [+24] hpd_high   (0/1)
  //   [+32] role       (bit 0 UFP_D, bit 1 DFP_D)
  //   [+40] reserved
  //   [+48] reserved
  //   [+56] reserved
  pub let mut _dpam_ports : [u64; 32] = uninit @align(64)   // 4 ports × 8 u64
  pub let mut _dpam_stats : [u64; 8]  = uninit @align(64)

  pub let DPAM_ST_ENTERS      : u64 = 0
  pub let DPAM_ST_CONFIGURES  : u64 = 1
  pub let DPAM_ST_EXITS       : u64 = 2
  pub let DPAM_ST_STATUSES    : u64 = 3
  pub let DPAM_ST_HPD_HIGHS   : u64 = 4
  pub let DPAM_ST_REFUSES     : u64 = 5

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dpam_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): clear ports + stats. Labels prefixed dpam_rs_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _dpam_ports];
      dpam_rs_p:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  dpam_rs_p;

        xor rcx, rcx;
        lea r10, [rip + _dpam_stats];
      dpam_rs_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dpam_rs_s;
        ret
      }
    } @no_frame

  pub let dpam_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-003 (#1234): honesty pin. Returns 0 until a live PD stack binds this against real SVDM traffic.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): counter read.",
      block: {
        cmp rdi, 8;
        jae dpam_st_zero;
        lea r10, [rip + _dpam_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpam_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): counter bump. Labels prefixed dpam_nt_.",
      block: {
        cmp rdi, 8;
        jae dpam_nt_out;
        lea r10, [rip + _dpam_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpam_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Port accessors. Port byte offset = port * 64 = port << 6.
  // ==========================================================================

  pub let dpam_port_in_use : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): read port.in_use.",
      block: {
        cmp rdi, 4;
        jae dpam_pi_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov rax, [r10 + 0];
        pop rbx;
        ret;
      dpam_pi_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_port_state : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): read port.state.",
      block: {
        cmp rdi, 4;
        jae dpam_ps_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      dpam_ps_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_port_pin : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): read port.pin_assignment.",
      block: {
        cmp rdi, 4;
        jae dpam_pp_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      dpam_pp_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_port_hpd : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): read port.hpd_high.",
      block: {
        cmp rdi, 4;
        jae dpam_ph_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov rax, [r10 + 24];
        pop rbx;
        ret;
      dpam_ph_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_port_role : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): read port.role.",
      block: {
        cmp rdi, 4;
        jae dpam_pr_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov rax, [r10 + 32];
        pop rbx;
        ret;
      dpam_pr_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpam_port_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-003 (#1234): 1 iff p in [0, 3].",
      block: {
        cmp rdi, 3;
        ja  dpam_pv_no;
        mov rax, 1;
        ret;
      dpam_pv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_pin_valid : (u64) -> u64 !{} @{} =
    fn (pin: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-003 (#1234): 1 iff pin is exactly one of A..F (bits 0..5, single bit).",
      block: {
        // Must be nonzero.
        cmp rdi, 0;
        je  dpam_piv_no;
        // Must fit within A..F mask (0x3F).
        mov rax, rdi;
        mov r10, 0x3F;
        not r10;
        and rax, r10;
        cmp rax, 0;
        jne dpam_piv_no;
        // Must have exactly one bit set: (pin & (pin-1)) == 0.
        mov rax, rdi;
        mov r10, rdi;
        sub r10, 1;
        and rax, r10;
        cmp rax, 0;
        jne dpam_piv_no;
        mov rax, 1;
        ret;
      dpam_piv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpam_role_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-003 (#1234): 1 iff r in {0, 1, 2, 3} (bits 0..1 only).",
      block: {
        mov rax, rdi;
        mov r10, 0x3;
        not r10;
        and rax, r10;
        cmp rax, 0;
        jne dpam_rv_no;
        mov rax, 1;
        ret;
      dpam_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Store helpers.
  // ==========================================================================

  pub let dpam_set_state : (u64, u64) -> () !{mem} @{} =
    fn (port: u64) (state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): write port.state + set in_use=1. Labels prefixed dpam_ss_.",
      block: {
        cmp rdi, 4;
        jae dpam_ss_out;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov rax, 1;
        mov [r10 + 0], rax;
        mov [r10 + 8], rsi;
        pop rbx;
      dpam_ss_out:
        ret
      }
    } @no_frame

  pub let dpam_set_pin : (u64, u64) -> () !{mem} @{} =
    fn (port: u64) (pin: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): write port.pin_assignment. Labels prefixed dpam_sp_.",
      block: {
        cmp rdi, 4;
        jae dpam_sp_out;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov [r10 + 16], rsi;
        pop rbx;
      dpam_sp_out:
        ret
      }
    } @no_frame

  pub let dpam_set_hpd : (u64, u64) -> () !{mem} @{} =
    fn (port: u64) (hpd: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): write port.hpd_high. Labels prefixed dpam_sh_.",
      block: {
        cmp rdi, 4;
        jae dpam_sh_out;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov [r10 + 24], rsi;
        pop rbx;
      dpam_sh_out:
        ret
      }
    } @no_frame

  pub let dpam_set_role : (u64, u64) -> () !{mem} @{} =
    fn (port: u64) (role: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): write port.role. Labels prefixed dpam_sr_.",
      block: {
        cmp rdi, 4;
        jae dpam_sr_out;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpam_ports];
        add r10, rbx;
        mov [r10 + 32], rsi;
        pop rbx;
      dpam_sr_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // dpam_enter(port, pin_assignment).
  //
  // Sequence:
  //   1. port in [0, 3]                (BAD_PORT)
  //   2. pin_assignment is one of A..F (BAD_PIN)
  //   3. state != ENTERED && != CONFIGURED (ALREADY_ENTERED)
  //   4. commit; state = ENTERED; pin = pin_assignment.
  // ==========================================================================

  pub let dpam_enter : (u64, u64) -> u64 !{mem} @{} =
    fn (port: u64) (pin_assignment: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): Enter Mode SVDM. Labels prefixed dpam_en_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        call dpam_port_valid;
        cmp rax, 0;
        je  dpam_en_bad_port;

        mov rdi, r12;
        call dpam_pin_valid;
        cmp rax, 0;
        je  dpam_en_bad_pin;

        mov rdi, rbx;
        call dpam_port_state;
        cmp rax, 1;                      // ENTERED
        je  dpam_en_already;
        cmp rax, 2;                      // CONFIGURED
        je  dpam_en_already;

        mov rdi, rbx;
        mov rsi, 1;                      // ENTERED
        call dpam_set_state;
        mov rdi, rbx;
        mov rsi, r12;
        call dpam_set_pin;

        mov rdi, 0;                      // ENTERS
        call dpam_note;
        xor rax, rax;
        jmp dpam_en_out;

      dpam_en_bad_port:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DE;
        jmp dpam_en_out;
      dpam_en_bad_pin:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DD;
        jmp dpam_en_out;
      dpam_en_already:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DA;

      dpam_en_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpam_status(port, role, hpd_high) — DP Status VDM.
  //
  // Sequence:
  //   1. port in [0, 3]              (BAD_PORT)
  //   2. role in {0, 1, 2, 3}        (BAD_ARG)
  //   3. hpd_high in {0, 1}          (BAD_ARG)
  //   4. state != INACTIVE           (NOT_ENTERED)
  //   5. commit role + hpd; bump HPD_HIGHS if hpd_high==1.
  // ==========================================================================

  pub let dpam_status : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (port: u64) (role: u64) (hpd_high: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): DP Status VDM. Labels prefixed dpam_su_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rdi, rbx;
        call dpam_port_valid;
        cmp rax, 0;
        je  dpam_su_bad_port;

        mov rdi, r12;
        call dpam_role_valid;
        cmp rax, 0;
        je  dpam_su_bad_arg;

        cmp r13, 1;
        ja  dpam_su_bad_arg;

        mov rdi, rbx;
        call dpam_port_state;
        cmp rax, 0;
        je  dpam_su_not_entered;

        mov rdi, rbx;
        mov rsi, r12;
        call dpam_set_role;
        mov rdi, rbx;
        mov rsi, r13;
        call dpam_set_hpd;

        mov rdi, 3;                      // STATUSES
        call dpam_note;
        cmp r13, 1;
        jne dpam_su_ok;
        mov rdi, 4;                      // HPD_HIGHS
        call dpam_note;
      dpam_su_ok:
        xor rax, rax;
        jmp dpam_su_out;

      dpam_su_bad_port:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DE;
        jmp dpam_su_out;
      dpam_su_bad_arg:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DF;
        jmp dpam_su_out;
      dpam_su_not_entered:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DB;

      dpam_su_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpam_configure(port, pin_assignment).
  //
  // Sequence:
  //   1. port valid                   (BAD_PORT)
  //   2. pin valid                    (BAD_PIN)
  //   3. state == ENTERED             (BAD_STATE)
  //   4. commit; state = CONFIGURED; pin = pin_assignment.
  // ==========================================================================

  pub let dpam_configure : (u64, u64) -> u64 !{mem} @{} =
    fn (port: u64) (pin_assignment: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): DP Configure VDM. Labels prefixed dpam_cf_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        call dpam_port_valid;
        cmp rax, 0;
        je  dpam_cf_bad_port;

        mov rdi, r12;
        call dpam_pin_valid;
        cmp rax, 0;
        je  dpam_cf_bad_pin;

        mov rdi, rbx;
        call dpam_port_state;
        cmp rax, 1;                      // ENTERED
        jne dpam_cf_bad_state;

        mov rdi, rbx;
        mov rsi, 2;                      // CONFIGURED
        call dpam_set_state;
        mov rdi, rbx;
        mov rsi, r12;
        call dpam_set_pin;

        mov rdi, 1;                      // CONFIGURES
        call dpam_note;
        xor rax, rax;
        jmp dpam_cf_out;

      dpam_cf_bad_port:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DE;
        jmp dpam_cf_out;
      dpam_cf_bad_pin:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DD;
        jmp dpam_cf_out;
      dpam_cf_bad_state:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DC;

      dpam_cf_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpam_exit(port).
  //
  // Sequence:
  //   1. port valid           (BAD_PORT)
  //   2. state != INACTIVE    (NOT_ENTERED)
  //   3. commit; state = EXITED; clear pin, hpd, role.
  // ==========================================================================

  pub let dpam_exit : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): Exit Mode SVDM. Labels prefixed dpam_ex_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        call dpam_port_valid;
        cmp rax, 0;
        je  dpam_ex_bad_port;

        mov rdi, rbx;
        call dpam_port_state;
        cmp rax, 0;
        je  dpam_ex_not_entered;

        mov rdi, rbx;
        mov rsi, 3;                      // EXITED
        call dpam_set_state;
        mov rdi, rbx;
        mov rsi, 0;
        call dpam_set_pin;
        mov rdi, rbx;
        mov rsi, 0;
        call dpam_set_hpd;
        mov rdi, rbx;
        mov rsi, 0;
        call dpam_set_role;

        mov rdi, 2;                      // EXITS
        call dpam_note;
        xor rax, rax;
        jmp dpam_ex_out;

      dpam_ex_bad_port:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DE;
        jmp dpam_ex_out;
      dpam_ex_not_entered:
        mov rdi, 5;
        call dpam_note;
        mov rax, 0xFFFFF7DB;

      dpam_ex_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpam_active_count — number of ports in ENTERED or CONFIGURED.
  // ==========================================================================

  pub let dpam_active_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-003 (#1234): count ENTERED + CONFIGURED ports.",
      block: {
        push rbx;
        push r12;

        xor rbx, rbx;
        xor r12, r12;
      dpam_ac_it:
        cmp r12, 4;
        jae dpam_ac_done;
        mov rdi, r12;
        call dpam_port_state;
        cmp rax, 1;
        je  dpam_ac_hit;
        cmp rax, 2;
        je  dpam_ac_hit;
        jmp dpam_ac_next;
      dpam_ac_hit:
        add rbx, 1;
      dpam_ac_next:
        add r12, 1;
        jmp dpam_ac_it;
      dpam_ac_done:
        mov rax, rbx;
        pop r12;
        pop rbx;
        ret
      }
    }
}
