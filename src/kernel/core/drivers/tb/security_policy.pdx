// src/kernel/core/drivers/tb/security_policy.pdx — R35.M5-002 (#1216)
//
// TB4 per-dock security-level policy. Per D3 of
// design/roadmap/next-wave-synthesis.md, the five USB4/TB4 security
// levels are the coarse-grained gate the DOCK-LEVEL policy applies
// BEFORE the fine-grained cap machinery (KIND_DMA_ATTESTATION,
// KIND_TB_ROUTE) authorises anything.
//
// The five levels are named for what the DOCK is allowed to originate:
//
//   0 NONE      the dock is invisible to the host — no tunnels of any
//               kind are established. Used for a policy-flag "kiosk"
//               mode or an operator lockdown.
//   1 USER      the default. PCIe / DP / USB3 tunnels may be
//               established after user consent (dma_consent_channel);
//               a KIND_DMA_ATTESTATION is minted per PCIe tunnel and
//               participates in the R35.M4 revoke cascade.
//   2 SECURE    like USER but with FRESH per-boot attestation keys —
//               the trusted_device.pdx enrollment is NOT consulted.
//               Used for a machine where the operator wants every
//               attach to demand a fresh consent regardless of prior
//               enrollments.
//   3 DP_ONLY   only DisplayPort tunnels are permitted. PCIe and USB3
//               tunnel requests are REFUSED at the policy gate before
//               reaching the tunnel sequencer.
//   4 USB_ONLY  only USB3 tunnels are permitted. Symmetric to DP_ONLY
//               for the case of a corporate deployment where an
//               operator wants keyboards and phone charging but no
//               displays that could photograph the screen.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the POLICY TABLE + GATE half of the security-level machinery.
// It:
//
//   1. TABLE — a fixed-capacity 16-row per-dock table. Row header
//      records in_use flag; row body records the dock_id and the
//      currently effective level. New rows arrive default-USER.
//
//   2. GATE — security_policy_gate_tunnel(dock, tunnel_type)
//      returns OK if the dock's current level permits the tunnel_type,
//      REFUSED if it does not, NOT_FOUND if the dock has no policy row.
//
//   3. TRANSITIONS — security_policy_set_level(dock, new_level)
//      transitions a row's level. There is no lattice constraint on
//      the transition itself (the operator may raise or lower); the
//      GATE reads whatever the current level is on every call, so a
//      LOWERED level takes effect on the NEXT gate call. IN-FLIGHT
//      tunnels are NOT torn down by a transition -- that is the
//      consent_revoke cascade's job, driven from the compositor
//      supervisor.
//
// IT DOES NOT ITSELF ENFORCE THE ATTESTATION FRESHNESS FOR SECURE.
// The R35.M4 dma_consent_channel + kind_dma_attestation modules own
// consent freshness; this module signals SECURE via the level column,
// and the consent-dialog implementation consults it. As of R35.M5 the
// consent dialog is not yet reading the level — that wiring is
// deferred to R36 per §5.
//
// security_policy_arbitrated() returns 0 until the compositor's
// policy-setter UI is bound to security_policy_set_level.
//
// =============================================================================
// §1  DEFAULT-USER
// =============================================================================
//
// A dock that has no policy row is treated by the gate as USER (the
// pragmatic default that matches Linux-boltd behaviour for a fresh
// attach). The row is created by security_policy_set_level or by
// security_policy_ensure -- both explicit. There is no implicit
// creation path from the gate itself, because a gate that could
// create a row would allow a rogue attach to plant a default row and
// then race the compositor's policy-set.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _tb_security_policy_table and _tb_security_policy_stats are written
// only by helpers in this module. tools/build.sh confines relocations
// against each symbol to `core/drivers/tb/security_policy.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF8F0..0xFFFFF8FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dma_active_indicator
// 0xFFFFF8D0..DF, trusted_device 0xFFFFF8E0..EF, cascade_harness
// 0xFFFFF900..0F, consent_revoke 0xFFFFF910..1F).
//
// =============================================================================
// §5  DEFERRED WIRING (honesty)
// =============================================================================
//
// The tunnel-establishment sequencers (pcie_tunnel / dp_tunnel /
// usb3_tunnel) do NOT call security_policy_gate_tunnel yet, and the
// consent_dialog does NOT consult the level column for SECURE
// attestation freshness. Both wirings are deferred to R36. This
// module ships with the table and the gate primitive so the
// compositor's policy-setter UI has something to write to from R43
// forward.

module SecurityPolicy = structure {

  // Level ordinals (§0).
  pub let SECPOL_LVL_NONE     : u64 = 0
  pub let SECPOL_LVL_USER     : u64 = 1
  pub let SECPOL_LVL_SECURE   : u64 = 2
  pub let SECPOL_LVL_DP_ONLY  : u64 = 3
  pub let SECPOL_LVL_USB_ONLY : u64 = 4
  pub let SECPOL_LVL_MAX      : u64 = 4

  // Tunnel-type mirror of kind_tb_route.pdx.
  pub let SECPOL_TUN_PCIE : u64 = 0
  pub let SECPOL_TUN_DP   : u64 = 1
  pub let SECPOL_TUN_USB3 : u64 = 2
  pub let SECPOL_TUN_MAX  : u64 = 2

  // Table: 16 entries of 32 bytes.
  //   [+0]  header (in_use[63:56] | level[15:8])
  //   [+8]  dock_id
  //   [+16] reserved
  //   [+24] reserved
  pub let SECPOL_MAX       : u64 = 16
  pub let SECPOL_ROW_BYTES : u64 = 32

  pub let mut _tb_security_policy_table : [u64; 64] = uninit @align(64)
  pub let mut _tb_security_policy_stats : [u64; 8]  = uninit @align(64)

  pub let SECPOL_ST_INSTALLED : u64 = 0
  pub let SECPOL_ST_UPDATED   : u64 = 1
  pub let SECPOL_ST_GATE_OK   : u64 = 2
  pub let SECPOL_ST_GATE_DENY : u64 = 3
  pub let SECPOL_ST_REJECTS   : u64 = 4

  // Failure taxonomy — 0xFFFFF8F0..0xFFFFF8FF.
  pub let SECPOL_OK              : u64 = 0
  pub let SECPOL_BAD_ARG         : u64 = 0xFFFFF8FF
  pub let SECPOL_BAD_DOCK        : u64 = 0xFFFFF8FE
  pub let SECPOL_BAD_LEVEL       : u64 = 0xFFFFF8FD
  pub let SECPOL_BAD_TUNNEL      : u64 = 0xFFFFF8FC
  pub let SECPOL_ENOSPC          : u64 = 0xFFFFF8FB
  pub let SECPOL_NOT_FOUND       : u64 = 0xFFFFF8FA
  pub let SECPOL_DENIED          : u64 = 0xFFFFF8F9

  pub let SECPOL_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let SECPOL_ROW_NONE   : u64 = 0xFF

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let security_policy_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-002 (#1216): clear table + stats. Labels prefixed sp_rs_.",
      block: {
        lea r10, [rip + _tb_security_policy_table];
        xor rax, rax;
        xor rcx, rcx;
      sp_rs_tab:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  sp_rs_tab;

        lea r10, [rip + _tb_security_policy_stats];
        xor rcx, rcx;
      sp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sp_rs_stats;
        ret
      }
    } @no_frame

  pub let security_policy_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M5-002 (#1216): honesty pin. Returns 0 until the compositor policy-setter UI is bound. See §5.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-002 (#1216): counter read.",
      block: {
        cmp rdi, 8;
        jae sp_st_zero;
        lea r10, [rip + _tb_security_policy_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sp_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-002 (#1216): counter bump. Labels prefixed sp_nt_.",
      block: {
        cmp rdi, 8;
        jae sp_nt_out;
        lea r10, [rip + _tb_security_policy_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sp_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let sp_dock_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M5-002 (#1216): 1 iff d non-zero and fits in u16.",
      block: {
        cmp rdi, 0;
        je  sp_dv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  sp_dv_no;
        mov rax, 1;
        ret;
      sp_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sp_level_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M5-002 (#1216): 1 iff l in 0..=4.",
      block: {
        cmp rdi, 4;
        ja  sp_lv_no;
        mov rax, 1;
        ret;
      sp_lv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sp_tunnel_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M5-002 (#1216): 1 iff t in 0..=2.",
      block: {
        cmp rdi, 2;
        ja  sp_tv_no;
        mov rax, 1;
        ret;
      sp_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let security_policy_find_row : (u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-002 (#1216): return row_id holding this dock, or ROW_NONE. Labels prefixed sp_fr_.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;
        mov rdi, r12;
        call sp_dock_valid;
        cmp rax, 0;
        je  sp_fr_none;

        xor rbx, rbx;
      sp_fr_scan:
        cmp rbx, 16;
        jae sp_fr_none;
        lea r10, [rip + _tb_security_policy_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sp_fr_next;
        mov rax, [r10 + 8];
        cmp rax, r12;
        je  sp_fr_hit;
      sp_fr_next:
        add rbx, 1;
        jmp sp_fr_scan;
      sp_fr_hit:
        mov rax, rbx;
        jmp sp_fr_out;
      sp_fr_none:
        mov rax, 0xFF;
      sp_fr_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let security_policy_level_of : (u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-002 (#1216): current level for dock, or DECODE_BAD if not tracked. Labels prefixed sp_lo_.",
      block: {
        push rbx;
        mov rbx, rdi;
        mov rdi, rbx;
        call security_policy_find_row;
        cmp rax, 0xFF;
        je  sp_lo_none;
        lea r10, [rip + _tb_security_policy_table];
        mov r11, rax;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        pop rbx;
        ret;
      sp_lo_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // set_level: create row (if new) or update level (if existing).
  // Returns OK on success, ENOSPC if table full for a new dock,
  // BAD_DOCK / BAD_LEVEL on invalid args.
  // ==========================================================================

  pub let security_policy_set_level : (u64, u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) (level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-002 (#1216): install or update policy row for dock. Labels prefixed sp_sl_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // dock_id
        mov r13, rsi;                    // level

        mov rdi, r12;
        call sp_dock_valid;
        cmp rax, 0;
        je  sp_sl_bad_dock;

        mov rdi, r13;
        call sp_level_valid;
        cmp rax, 0;
        je  sp_sl_bad_level;

        // Existing row?
        mov rdi, r12;
        call security_policy_find_row;
        cmp rax, 0xFF;
        jne sp_sl_update;

        // Find empty slot for a new row.
        xor rbx, rbx;
      sp_sl_alloc:
        cmp rbx, 16;
        jae sp_sl_enospc;
        lea r10, [rip + _tb_security_policy_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sp_sl_write;
        add rbx, 1;
        jmp sp_sl_alloc;

      sp_sl_write:
        // Header: in_use=1[63:56] | level[15:8]
        mov rax, 1;
        shl rax, 56;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov [r10 + 8], r12;              // dock_id
        xor rax, rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov rdi, 0;                      // INSTALLED
        call sp_note;
        xor rax, rax;
        jmp sp_sl_out;

      sp_sl_update:
        // Row already exists at index rax — overwrite level.
        lea r10, [rip + _tb_security_policy_table];
        mov r11, rax;
        shl r11, 5;
        add r10, r11;
        mov rax, 1;
        shl rax, 56;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 0], rax;
        mov rdi, 1;                      // UPDATED
        call sp_note;
        xor rax, rax;
        jmp sp_sl_out;

      sp_sl_bad_dock:
        mov rdi, 4;
        call sp_note;
        mov rax, 0xFFFFF8FE;
        jmp sp_sl_out;
      sp_sl_bad_level:
        mov rdi, 4;
        call sp_note;
        mov rax, 0xFFFFF8FD;
        jmp sp_sl_out;
      sp_sl_enospc:
        mov rdi, 4;
        call sp_note;
        mov rax, 0xFFFFF8FB;

      sp_sl_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // GATE: given (dock, tunnel_type), return OK if the dock's level
  // permits the tunnel_type, DENIED if not, NOT_FOUND if no row.
  //
  // Permission matrix (row = level, col = tunnel_type; 1 = allowed):
  //                PCIe   DP   USB3
  //   NONE      :    0     0     0
  //   USER      :    1     1     1
  //   SECURE    :    1     1     1
  //   DP_ONLY   :    0     1     0
  //   USB_ONLY  :    0     0     1
  // ==========================================================================

  pub let security_policy_gate_tunnel : (u64, u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) (tunnel_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-002 (#1216): apply level x tunnel_type matrix. Labels prefixed sp_gt_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // dock_id
        mov r13, rsi;                    // tunnel_type

        mov rdi, r12;
        call sp_dock_valid;
        cmp rax, 0;
        je  sp_gt_bad_dock;

        mov rdi, r13;
        call sp_tunnel_valid;
        cmp rax, 0;
        je  sp_gt_bad_tunnel;

        mov rdi, r12;
        call security_policy_level_of;
        mov rbx, rax;                    // level
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rbx, r11;
        je  sp_gt_not_found;

        // Dispatch on level.
        cmp rbx, 0;                      // NONE
        je  sp_gt_deny;
        cmp rbx, 1;                      // USER
        je  sp_gt_allow;
        cmp rbx, 2;                      // SECURE
        je  sp_gt_allow;
        cmp rbx, 3;                      // DP_ONLY
        je  sp_gt_dp_only;
        cmp rbx, 4;                      // USB_ONLY
        je  sp_gt_usb_only;
        jmp sp_gt_bad_level;

      sp_gt_dp_only:
        cmp r13, 1;                      // DP
        je  sp_gt_allow;
        jmp sp_gt_deny;

      sp_gt_usb_only:
        cmp r13, 2;                      // USB3
        je  sp_gt_allow;
        jmp sp_gt_deny;

      sp_gt_allow:
        mov rdi, 2;                      // GATE_OK
        call sp_note;
        xor rax, rax;
        jmp sp_gt_out;
      sp_gt_deny:
        mov rdi, 3;                      // GATE_DENY
        call sp_note;
        mov rax, 0xFFFFF8F9;
        jmp sp_gt_out;
      sp_gt_not_found:
        mov rdi, 4;
        call sp_note;
        mov rax, 0xFFFFF8FA;
        jmp sp_gt_out;
      sp_gt_bad_dock:
        mov rdi, 4;
        call sp_note;
        mov rax, 0xFFFFF8FE;
        jmp sp_gt_out;
      sp_gt_bad_tunnel:
        mov rdi, 4;
        call sp_note;
        mov rax, 0xFFFFF8FC;
        jmp sp_gt_out;
      sp_gt_bad_level:
        mov rdi, 4;
        call sp_note;
        mov rax, 0xFFFFF8FD;

      sp_gt_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
