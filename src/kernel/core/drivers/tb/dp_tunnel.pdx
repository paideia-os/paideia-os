// src/kernel/core/drivers/tb/dp_tunnel.pdx — R35.M3-002 (#1206)
//
// TB4 DisplayPort protocol adapter — tunnel establishment scaffold.
// Per USB4 §10 (DP Adapter), a DP tunnel is established by pairing
// an IN adapter (source, host side) with an OUT adapter (sink,
// device side) on distinct routers, negotiating DP main-link
// parameters (lane count, link rate), and tunneling both the DP
// main link and the AUX channel across the domain. This scaffold
// owns the virtual DDI (Digital Display Interface) mapping that
// R36's display substrate consumes.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNIZE + DDI MAPPING half of DP tunnel establishment.
// USB4 §10.3 defines the negotiation phase (BANDWIDTH_REQUEST /
// ALLOCATE / DEALLOCATE control packets) and §10.4 defines the AUX
// tunnel encapsulation. This scaffold owns:
//
//   * Validators for main-link parameters (lane count, link rate).
//   * A virtual DDI slot allocator (fixed-capacity 4-slot table) —
//     the HAND-OFF POINT to R36's display substrate. R36 consumes
//     a DDI slot number and treats it as a locally-addressable
//     display output. Two DP tunnels claiming the same DDI slot
//     is refused as DDI_IN_USE.
//   * An AUX-channel tunnel counter (tracks how many AUX requests
//     have been recognised for a given tunnel).
//
// IT DOES NOT ISSUE DP AUX TRANSACTIONS. AUX read/write bytes flow
// through the CM ring path once the tunnel is ACTIVE; this scaffold
// counts them at the shape-check boundary only.
//
// IT DOES NOT MINT KIND_TB_ROUTE. The capability that names the
// established DP tunnel is KIND_TB_ROUTE with tunnel_type = 1;
// minting is the caller's responsibility once ddi_allocate and
// main_link_negotiate both succeed.
//
// dp_tunnel_arbitrated() returns 0 until a live driver binds this
// scaffold against real DP adapter registers.
//
// =============================================================================
// §1  MAIN-LINK PARAMETERS (VESA DisplayPort 2.1 §3.5)
// =============================================================================
//
// Lane count: 1, 2 or 4. USB4 DP tunneling does not support the
// x8 variant seen on desktop DP2.1 (there is no eight-lane path
// through a TB4 fabric today).
//
// Link rate ordinals (RBR / HBR / HBR2 / HBR3 / UHBR10 / UHBR13.5 /
// UHBR20):
//   1  RBR      1.62 Gbps/lane
//   2  HBR      2.7  Gbps/lane
//   3  HBR2     5.4  Gbps/lane
//   4  HBR3     8.1  Gbps/lane
//   5  UHBR10  10    Gbps/lane
//   6  UHBR13   13.5 Gbps/lane
//   7  UHBR20   20   Gbps/lane
//
// =============================================================================
// §2  VIRTUAL DDI MAPPING (R36 HAND-OFF)
// =============================================================================
//
// The compositor sees a display output as a DDI number. A DP tunnel
// coming up through TB4 is presented to R36's display substrate as
// a virtual DDI in the range [DDI_TB_BASE, DDI_TB_BASE + DDI_MAX).
// Local DDIs (integrated display, external DP-over-USB-C direct
// pin) claim [0, DDI_TB_BASE). This scaffold owns the ALLOCATION
// TABLE; it does NOT own the DDI ↔ compositor sink translation.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _dp_tunnel_stats and _dp_tunnel_ddi_tab are written only by
// helpers in this module. tools/build.sh confines relocations
// against both symbols to `core/drivers/tb/dp_tunnel.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF980..0xFFFFF98F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: kind_tb_route 0xFFFFF9A0..AF,
// pcie_tunnel 0xFFFFF990..9F, usb3_tunnel 0xFFFFF970..7F,
// route_teardown 0xFFFFF960..6F).

module DpTunnel = structure {

  // Lane counts (§1).
  pub let DP_LANES_X1 : u64 = 1
  pub let DP_LANES_X2 : u64 = 2
  pub let DP_LANES_X4 : u64 = 4
  pub let DP_LANES_MAX : u64 = 4

  // Link rate ordinals (§1).
  pub let DP_RATE_RBR    : u64 = 1
  pub let DP_RATE_HBR    : u64 = 2
  pub let DP_RATE_HBR2   : u64 = 3
  pub let DP_RATE_HBR3   : u64 = 4
  pub let DP_RATE_UHBR10 : u64 = 5
  pub let DP_RATE_UHBR13 : u64 = 6
  pub let DP_RATE_UHBR20 : u64 = 7
  pub let DP_RATE_MAX    : u64 = 7

  // Virtual DDI mapping (§2).
  pub let DP_DDI_TB_BASE : u64 = 16              // local DDIs 0..15
  pub let DP_DDI_MAX     : u64 = 4               // four TB4 virtual DDIs
  pub let DP_DDI_NONE    : u64 = 0xFF

  // Failure taxonomy — 0xFFFFF980..0xFFFFF98F.
  pub let DP_TUN_OK             : u64 = 0
  pub let DP_TUN_BAD_ARG        : u64 = 0xFFFFF98F
  pub let DP_TUN_BAD_LANES      : u64 = 0xFFFFF98E
  pub let DP_TUN_BAD_RATE       : u64 = 0xFFFFF98D
  pub let DP_TUN_BAD_ADAPTER    : u64 = 0xFFFFF98C
  pub let DP_TUN_SELF_LOOP      : u64 = 0xFFFFF98B
  pub let DP_TUN_DDI_IN_USE     : u64 = 0xFFFFF98A
  pub let DP_TUN_DDI_ENOSPC     : u64 = 0xFFFFF989
  pub let DP_TUN_DDI_BAD        : u64 = 0xFFFFF988
  pub let DP_TUN_DDI_NOT_HELD   : u64 = 0xFFFFF987

  pub let mut _dp_tunnel_stats  : [u64; 8] = uninit @align(64)
  //   ddi_tab entries: 0 = free, non-zero = source_adapter+1 of holder.
  //   The "+1" biases the value so that source_adapter 0 (a legal
  //   adapter ordinal) is distinguishable from "free".
  pub let mut _dp_tunnel_ddi_tab : [u64; 4] = uninit @align(64)

  pub let DP_TUN_ST_ATTEMPTS   : u64 = 0
  pub let DP_TUN_ST_ALLOCATED  : u64 = 1
  pub let DP_TUN_ST_RELEASED   : u64 = 2
  pub let DP_TUN_ST_REJECTS    : u64 = 3
  pub let DP_TUN_ST_AUX_XFERS  : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dp_tunnel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-002 (#1206): clear stats + DDI table. Labels prefixed dtn_rs_.",
      block: {
        lea r10, [rip + _dp_tunnel_stats];
        xor rax, rax;
        xor rcx, rcx;
      dtn_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dtn_rs_stats;

        lea r10, [rip + _dp_tunnel_ddi_tab];
        xor rcx, rcx;
      dtn_rs_ddi:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dtn_rs_ddi;
        ret
      }
    } @no_frame

  pub let dp_tunnel_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-002 (#1206): honesty pin. Returns 0 until a later round binds this against a live DP adapter.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dp_tunnel_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-002 (#1206): counter read.",
      block: {
        cmp rdi, 8;
        jae dtn_st_zero;
        lea r10, [rip + _dp_tunnel_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dtn_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dp_tunnel_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-002 (#1206): counter bump. Labels prefixed dtn_nt_.",
      block: {
        cmp rdi, 8;
        jae dtn_nt_out;
        lea r10, [rip + _dp_tunnel_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dtn_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dp_tun_lanes_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-002 (#1206): 1 iff n in {1, 2, 4}. Labels prefixed dtn_lv_.",
      block: {
        cmp rdi, 1;
        je  dtn_lv_yes;
        cmp rdi, 2;
        je  dtn_lv_yes;
        cmp rdi, 4;
        je  dtn_lv_yes;
        xor rax, rax;
        ret;
      dtn_lv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let dp_tun_rate_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-002 (#1206): 1 iff r in [1, 7]. Labels prefixed dtn_rv_.",
      block: {
        cmp rdi, 1;
        jb  dtn_rv_no;
        cmp rdi, 7;
        ja  dtn_rv_no;
        mov rax, 1;
        ret;
      dtn_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dp_tun_adapter_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-002 (#1206): 1 iff a fits in u8. Labels prefixed dtn_av_.",
      block: {
        cmp rdi, 0xFF;
        ja  dtn_av_no;
        mov rax, 1;
        ret;
      dtn_av_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dp_tun_ddi_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-002 (#1206): 1 iff d in [DP_DDI_TB_BASE, DP_DDI_TB_BASE + DP_DDI_MAX). Labels prefixed dtn_ddv_.",
      block: {
        mov r10, 16;                     // DP_DDI_TB_BASE
        cmp rdi, r10;
        jb  dtn_ddv_no;
        mov r10, 20;                     // DP_DDI_TB_BASE + DP_DDI_MAX
        cmp rdi, r10;
        jae dtn_ddv_no;
        mov rax, 1;
        ret;
      dtn_ddv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Main-link negotiation recognition.
  //
  // Given a request (source_adapter, sink_adapter, lanes, rate),
  // verify the shape. A caller passes the request to cm_rings for
  // the ALLOCATE / BANDWIDTH_REQUEST control packets.
  //
  // Sequence:
  //   1. Source adapter fits u8
  //   2. Sink adapter fits u8
  //   3. Source != Sink (SELF_LOOP refused)
  //   4. Lanes in {1, 2, 4}
  //   5. Rate in [1, 7]
  // ==========================================================================

  pub let dp_tunnel_main_link : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (source_adapter: u64) (sink_adapter: u64) (lanes: u64) (rate: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-002 (#1206): recognize main-link negotiation. Refuses SELF_LOOP (source == sink) — a DP tunnel cannot terminate on the router that sourced it. Labels prefixed dtn_ml_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // source_adapter
        mov r12, rsi;                    // sink_adapter
        mov r13, rdx;                    // lanes
        mov r14, rcx;                    // rate

        mov rdi, 0;                      // ATTEMPTS
        call dp_tunnel_note;

        mov rdi, rbx;
        call dp_tun_adapter_valid;
        cmp rax, 0;
        je  dtn_ml_bad_adapter;

        mov rdi, r12;
        call dp_tun_adapter_valid;
        cmp rax, 0;
        je  dtn_ml_bad_adapter;

        cmp rbx, r12;
        je  dtn_ml_self_loop;

        mov rdi, r13;
        call dp_tun_lanes_valid;
        cmp rax, 0;
        je  dtn_ml_bad_lanes;

        mov rdi, r14;
        call dp_tun_rate_valid;
        cmp rax, 0;
        je  dtn_ml_bad_rate;

        xor rax, rax;
        jmp dtn_ml_out;

      dtn_ml_bad_adapter:
        mov rdi, 3;
        call dp_tunnel_note;
        mov rax, 0xFFFFF98C;
        jmp dtn_ml_out;
      dtn_ml_self_loop:
        mov rdi, 3;
        call dp_tunnel_note;
        mov rax, 0xFFFFF98B;
        jmp dtn_ml_out;
      dtn_ml_bad_lanes:
        mov rdi, 3;
        call dp_tunnel_note;
        mov rax, 0xFFFFF98E;
        jmp dtn_ml_out;
      dtn_ml_bad_rate:
        mov rdi, 3;
        call dp_tunnel_note;
        mov rax, 0xFFFFF98D;

      dtn_ml_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Virtual DDI allocation. Given a source_adapter, claim one of the
  // DP_DDI_MAX (=4) virtual DDI slots in the range
  // [DP_DDI_TB_BASE, DP_DDI_TB_BASE + DP_DDI_MAX). Returns the DDI
  // number on success, DDI_ENOSPC when the table is full.
  //
  // Two DP tunnels claiming the same source_adapter is REFUSED as
  // DDI_IN_USE (rather than aliasing) — a live compositor cannot
  // correctly render two panels through one DDI.
  // ==========================================================================

  pub let dp_tunnel_ddi_alloc : (u64) -> u64 !{mem} @{} =
    fn (source_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-002 (#1206): claim one virtual DDI slot for source_adapter. Refuses IN_USE if the same source_adapter already holds a slot. Labels prefixed dtn_da_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // source_adapter

        mov rdi, rbx;
        call dp_tun_adapter_valid;
        cmp rax, 0;
        je  dtn_da_bad_adapter;

        // Compute biased holder value: source_adapter + 1.
        mov r12, rbx;
        add r12, 1;

        // Scan for existing holder.
        xor rcx, rcx;
      dtn_da_scan:
        cmp rcx, 4;
        jae dtn_da_alloc;
        lea r10, [rip + _dp_tunnel_ddi_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  dtn_da_in_use;
        add rcx, 1;
        jmp dtn_da_scan;

      dtn_da_alloc:
        // Scan for free slot.
        xor rcx, rcx;
      dtn_da_alloc_scan:
        cmp rcx, 4;
        jae dtn_da_enospc;
        lea r10, [rip + _dp_tunnel_ddi_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  dtn_da_claim;
        add rcx, 1;
        jmp dtn_da_alloc_scan;

      dtn_da_claim:
        mov [r10 + rcx * 8], r12;        // stash holder+1
        mov rdi, 1;                      // ALLOCATED
        call dp_tunnel_note;
        // Return DDI number = DP_DDI_TB_BASE + slot.
        mov rax, rcx;
        add rax, 16;                     // DP_DDI_TB_BASE
        jmp dtn_da_out;

      dtn_da_in_use:
        mov rdi, 3;
        call dp_tunnel_note;
        mov rax, 0xFFFFF98A;
        jmp dtn_da_out;
      dtn_da_enospc:
        mov rdi, 3;
        call dp_tunnel_note;
        mov rax, 0xFFFFF989;
        jmp dtn_da_out;
      dtn_da_bad_adapter:
        mov rdi, 3;
        call dp_tunnel_note;
        mov rax, 0xFFFFF98C;

      dtn_da_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // Release BY source_adapter. Walks the internal DDI table for the
  // biased holder value and calls the by-DDI release path once
  // located. Exposed for route_teardown.pdx so the teardown sequencer
  // does not itself relocate against _dp_tunnel_ddi_tab — the
  // one-writer discipline (§3) is preserved by keeping every table
  // walker in this compilation unit.
  //
  // Returns 0 on success, DDI_NOT_HELD if source_adapter holds no
  // slot, BAD_ADAPTER if source_adapter is out of range.
  pub let dp_tunnel_release_by_source : (u64) -> u64 !{mem} @{} =
    fn (source_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-005 (#1209): release-by-source helper. Keeps the DDI-table walk inside this compilation unit so route_teardown.o carries no relocation against _dp_tunnel_ddi_tab. Labels prefixed dtn_rbs_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // source_adapter

        mov rdi, rbx;
        call dp_tun_adapter_valid;
        cmp rax, 0;
        je  dtn_rbs_bad;

        mov r12, rbx;
        add r12, 1;                      // biased holder value

        xor rcx, rcx;
      dtn_rbs_scan:
        cmp rcx, 4;
        jae dtn_rbs_not_held;
        lea r10, [rip + _dp_tunnel_ddi_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  dtn_rbs_hit;
        add rcx, 1;
        jmp dtn_rbs_scan;

      dtn_rbs_hit:
        // Convert slot to DDI number, then call the by-DDI release.
        mov rdi, rcx;
        add rdi, 16;                     // DP_DDI_TB_BASE
        call dp_tunnel_ddi_release;
        jmp dtn_rbs_out;

      dtn_rbs_bad:
        mov rax, 0xFFFFF98C;
        jmp dtn_rbs_out;
      dtn_rbs_not_held:
        mov rax, 0xFFFFF987;

      dtn_rbs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dp_tunnel_ddi_release : (u64) -> u64 !{mem} @{} =
    fn (ddi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-002 (#1206): release a virtual DDI slot. Refuses DDI_BAD for a DDI outside the TB range, DDI_NOT_HELD for a slot that is already free. Labels prefixed dtn_dr_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        call dp_tun_ddi_valid;
        cmp rax, 0;
        je  dtn_dr_bad;

        // Slot index = ddi - DP_DDI_TB_BASE.
        mov rcx, rbx;
        sub rcx, 16;

        lea r10, [rip + _dp_tunnel_ddi_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  dtn_dr_not_held;

        xor rax, rax;
        mov [r10 + rcx * 8], rax;

        mov rdi, 2;                      // RELEASED
        call dp_tunnel_note;
        xor rax, rax;
        jmp dtn_dr_out;

      dtn_dr_bad:
        mov rax, 0xFFFFF988;
        jmp dtn_dr_out;
      dtn_dr_not_held:
        mov rax, 0xFFFFF987;

      dtn_dr_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // AUX channel tunneling. Counts a proposed AUX transaction. A
  // caller passes the request byte to cm_rings for actual submission.
  // ==========================================================================

  pub let dp_tunnel_aux_note : (u64) -> u64 !{mem} @{} =
    fn (aux_bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-002 (#1206): note one AUX transaction of aux_bytes bytes. Refuses aux_bytes > 16 (AUX max transaction size per DP 2.1 §3.4). Labels prefixed dtn_ax_.",
      block: {
        push rbx;

        mov rbx, rdi;

        cmp rbx, 16;
        ja  dtn_ax_bad;

        mov rdi, 4;                      // AUX_XFERS
        call dp_tunnel_note;
        xor rax, rax;
        jmp dtn_ax_out;

      dtn_ax_bad:
        mov rax, 0xFFFFF98F;

      dtn_ax_out:
        pop rbx;
        ret
      }
    }
}
