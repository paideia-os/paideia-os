// src/kernel/core/drivers/tb/consent_dialog.pdx — R35.M4-003 (#1212)
//
// Compositor consent-dialog handler STUB. This is the ring-3-facing
// scaffold that R35.M4 lands so KIND_DMA_ATTESTATION has an authority
// path to move from PENDING to GRANTED — the actual dialog UI is a
// G7 concern (compositor rendering, keyboard/pointer capture, focus
// stealing prevention) that will replace this stub in a later round.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the KERNEL SIDE of the consent-dialog RPC. Given a request
// registered through dma_consent_channel.dma_consent_request, this
// scaffold:
//
//   1. Applies the boot-flag policy — deny-untrusted by default, or
//      auto-grant if the operator explicitly enabled it (see
//      consent_dialog_set_auto_grant).
//   2. Records the decision in an audit ring so an operator can
//      reconstruct which dock was granted or denied at what boot.
//   3. Fires the reply callback (dma_consent_channel.dma_consent_reply)
//      that wakes the caller.
//   4. Transitions the corresponding KIND_DMA_ATTESTATION row from
//      PENDING to GRANTED / REVOKED through dma_attest_row_set_granted
//      / dma_attest_row_set_revoked.
//
// IT DOES NOT PAINT PIXELS. The user-visible dialog is G7's work; this
// stub decides synchronously based on policy so the R35.M4 substrate
// can be exercised end-to-end. When G7 lands, the auto-grant flag
// becomes a debug backdoor and the default deny-untrusted policy
// becomes the answer for any request the compositor cannot present
// to the user (headless boot, kiosk mode, early bring-up).
//
// IT DOES NOT MINT KIND_DMA_ATTESTATION. Minting is the dock
// supervisor's responsibility; this stub only moves the row it holds
// through the state-machine transitions the kind allows (§2 of
// kind_dma_attestation.pdx).
//
// consent_dialog_arbitrated() returns 0 until a compositor binds this
// scaffold against a real UI event source.
//
// =============================================================================
// §1  DEFAULT POLICY IS DENY-UNTRUSTED
// =============================================================================
//
// Absent an explicit configuration, every consent request is DENIED.
// This is the correct default for a system whose whole point is to
// require user consent before a bus-mastering device can DMA the
// host — a dock plugged in during a boot with no compositor running
// (early bring-up, recovery shell) must not silently escalate to
// full DMA reach.
//
// The operator can flip the boot flag to AUTO_GRANT for headless
// bring-up, and the audit trail records the flip. This is a
// deliberate operator override, not a fallback — a scaffold that
// silently auto-granted would defeat the whole security property
// R35.M4 exists to establish.
//
// =============================================================================
// §2  AUDIT RING
// =============================================================================
//
// Every consent decision (grant, deny, revoke) writes one record into
// _consent_dialog_audit: (dock_id, decision, req_seq). The ring is
// FIXED-CAPACITY (16 entries) and wraps by overwriting the oldest
// entry — a boot with more than sixteen consent decisions is a case
// the operator has bigger questions about than which one got
// overwritten first.
//
// _consent_dialog_audit is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/tb/consent_dialog.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF930..0xFFFFF93F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dma_consent_channel
// 0xFFFFF940..4F, kind_dma_attestation 0xFFFFF950..5F, iommu_domain
// 0xFFFFF920..2F, consent_revoke 0xFFFFF910..1F).

module ConsentDialog = structure {

  // Policy ordinals (§1).
  pub let CONSENT_POLICY_DENY_UNTRUSTED : u64 = 0
  pub let CONSENT_POLICY_AUTO_GRANT     : u64 = 1
  pub let CONSENT_POLICY_MAX            : u64 = 1

  // Decision ordinals (§2).
  pub let CONSENT_DECISION_GRANTED : u64 = 0
  pub let CONSENT_DECISION_DENIED  : u64 = 1
  pub let CONSENT_DECISION_REVOKED : u64 = 2
  pub let CONSENT_DECISION_MAX     : u64 = 2

  // Failure taxonomy — 0xFFFFF930..0xFFFFF93F.
  pub let CONSENT_DLG_OK              : u64 = 0
  pub let CONSENT_DLG_BAD_ARG         : u64 = 0xFFFFF93F
  pub let CONSENT_DLG_BAD_POLICY      : u64 = 0xFFFFF93E
  pub let CONSENT_DLG_BAD_DECISION    : u64 = 0xFFFFF93D
  pub let CONSENT_DLG_BAD_DOCK        : u64 = 0xFFFFF93C
  pub let CONSENT_DLG_BAD_SEQ         : u64 = 0xFFFFF93B
  pub let CONSENT_DLG_NO_ROW          : u64 = 0xFFFFF93A
  pub let CONSENT_DLG_TRANSITION      : u64 = 0xFFFFF939

  // Boot-flag policy (mutable at boot, immutable after seal).
  pub let mut _consent_dialog_policy : u64 = 0     // CONSENT_POLICY_DENY_UNTRUSTED

  // Audit ring — 16 entries of 32 bytes.
  //   [+0]  header (in_use[63:56] | reserved)
  //   [+8]  dock_id
  //   [+16] decision (u8) | req_seq (u64 at [63:8])
  //   [+24] issued_at (opaque)
  pub let CONSENT_DLG_AUDIT_MAX       : u64 = 16
  pub let CONSENT_DLG_AUDIT_ROW_BYTES : u64 = 32

  pub let mut _consent_dialog_audit : [u64; 64] = uninit @align(64)
  pub let mut _consent_dialog_head  : u64       = 0

  pub let mut _consent_dialog_stats : [u64; 8] = uninit @align(64)

  pub let CONSENT_DLG_ST_REQUESTS : u64 = 0
  pub let CONSENT_DLG_ST_GRANTS   : u64 = 1
  pub let CONSENT_DLG_ST_DENIES   : u64 = 2
  pub let CONSENT_DLG_ST_REVOKES  : u64 = 3
  pub let CONSENT_DLG_ST_REJECTS  : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let consent_dialog_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): clear policy + audit ring + head + stats. Labels prefixed cdg_rs_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _consent_dialog_policy];
        mov [r10], rax;
        lea r10, [rip + _consent_dialog_head];
        mov [r10], rax;

        lea r10, [rip + _consent_dialog_audit];
        xor rcx, rcx;
      cdg_rs_ring:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  cdg_rs_ring;

        lea r10, [rip + _consent_dialog_stats];
        xor rcx, rcx;
      cdg_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cdg_rs_stats;
        ret
      }
    }

  pub let consent_dialog_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-003 (#1212): honesty pin. Returns 0 until a compositor binds this scaffold to a real UI event source.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let cdg_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): counter bump. Labels prefixed cdg_nt_.",
      block: {
        cmp rdi, 8;
        jae cdg_nt_out;
        lea r10, [rip + _consent_dialog_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cdg_nt_out:
        ret
      }
    }

  pub let cdg_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): counter read.",
      block: {
        cmp rdi, 8;
        jae cdg_st_zero;
        lea r10, [rip + _consent_dialog_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cdg_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Policy setter.
  // ==========================================================================

  pub let consent_dialog_set_auto_grant : (u64) -> u64 !{mem} @{} =
    fn (enable: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): flip the boot-flag policy. 0=DENY_UNTRUSTED (default), 1=AUTO_GRANT. Refuses any other value BAD_POLICY. Labels prefixed cdg_sag_.",
      block: {
        cmp rdi, 1;
        ja  cdg_sag_bad;
        lea r10, [rip + _consent_dialog_policy];
        mov [r10], rdi;
        xor rax, rax;
        ret;
      cdg_sag_bad:
        mov rax, 0xFFFFF93E;
        ret
      }
    }

  pub let consent_dialog_policy_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): policy read.",
      block: {
        lea r10, [rip + _consent_dialog_policy];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // Audit ring.
  //
  // THE ONE WRITER of _consent_dialog_audit. tools/build.sh confines
  // relocations against `_consent_dialog_audit` to this object.
  // ==========================================================================

  pub let consent_dialog_audit_record : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (dock_id: u64) (decision: u64) (req_seq: u64) (issued_at: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): write one audit ring entry at _head, then advance _head modulo 16. Overwrite-oldest on wrap. Labels prefixed cdg_ar_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // dock_id
        mov r13, rsi;                    // decision
        mov r14, rdx;                    // req_seq
        mov r15, rcx;                    // issued_at

        lea r10, [rip + _consent_dialog_head];
        mov rax, [r10];
        mov r11, rax;                    // slot idx
        add rax, 1;
        mov rcx, 16;
        xor rdx, rdx;
        div rcx;                         // rax:rdx = head+1 / 16
        mov [r10], rdx;                  // new head = (head+1) mod 16

        lea r10, [rip + _consent_dialog_audit];
        mov rax, r11;
        shl rax, 5;
        add r10, rax;

        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;
        mov [r10 + 8], r12;

        // decision[7:0] | req_seq[63:8]
        mov rax, r13;
        and rax, 0xFF;
        mov r11, r14;
        shl r11, 8;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov [r10 + 24], r15;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let consent_dialog_audit_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): read decision at ring idx, or DECODE_BAD. Labels prefixed cdg_at_.",
      block: {
        cmp rdi, 16;
        jae cdg_at_bad;
        lea r10, [rip + _consent_dialog_audit];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cdg_at_bad;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        ret;
      cdg_at_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let consent_dialog_audit_dock_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): read dock at ring idx. Labels prefixed cdg_da_.",
      block: {
        cmp rdi, 16;
        jae cdg_da_bad;
        lea r10, [rip + _consent_dialog_audit];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  cdg_da_bad;
        mov rax, [r10 + 8];
        ret;
      cdg_da_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Handle one request.
  //
  // Applies the policy, records the decision, drives the state
  // transition on the attestation row (via dma_attest_row_set_granted
  // / _set_revoked), and returns the decision ordinal.
  //
  // Sequence:
  //   1. Validate row_id (must name a live KIND_DMA_ATTESTATION row).
  //   2. Read policy.
  //   3. If AUTO_GRANT -> attempt PENDING -> GRANTED via
  //      dma_attest_row_set_granted; if it refuses, the row is not
  //      in PENDING, so record the actual decision (already granted
  //      / already revoked) and return.
  //   4. If DENY_UNTRUSTED -> attempt PENDING -> REVOKED via
  //      dma_attest_row_set_revoked; return REVOKED (deny is the
  //      same terminal state as revoke, per §1 of
  //      kind_dma_attestation.pdx: a consent that was declined
  //      cannot be un-declined).
  //   5. Record the decision, bump counters.
  // ==========================================================================

  pub let consent_dialog_handle : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (dock_id: u64) (req_seq: u64) (issued_at: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-003 (#1212): apply policy to one request, transition the row, record audit, return decision ordinal. Labels prefixed cdg_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // dock_id
        mov r13, rdx;                    // req_seq
        mov r14, rcx;                    // issued_at

        mov rdi, 0;                      // REQUESTS
        call cdg_note;

        // Validate row.
        mov rdi, rbx;
        call dma_attest_tail_valid;
        cmp rax, 0;
        je  cdg_hn_no_row;

        // Read policy.
        call consent_dialog_policy_get;
        mov r15, rax;

        cmp r15, 1;                      // AUTO_GRANT
        je  cdg_hn_grant;
        jmp cdg_hn_deny;

      cdg_hn_grant:
        mov rdi, rbx;
        call dma_attest_row_set_granted;
        cmp rax, 0;
        jne cdg_hn_trans_grant;
        mov rdi, r12;
        mov rsi, 0;                      // GRANTED
        mov rdx, r13;
        mov rcx, r14;
        call consent_dialog_audit_record;
        mov rdi, 1;                      // GRANTS
        call cdg_note;
        mov rax, 0;                      // GRANTED
        jmp cdg_hn_out;

      cdg_hn_deny:
        mov rdi, rbx;
        call dma_attest_row_set_revoked;
        cmp rax, 0;
        jne cdg_hn_trans_deny;
        mov rdi, r12;
        mov rsi, 1;                      // DENIED
        mov rdx, r13;
        mov rcx, r14;
        call consent_dialog_audit_record;
        mov rdi, 2;                      // DENIES
        call cdg_note;
        mov rax, 1;                      // DENIED
        jmp cdg_hn_out;

      cdg_hn_no_row:
        mov rdi, 4;                      // REJECTS
        call cdg_note;
        mov rax, 0xFFFFF93A;
        jmp cdg_hn_out;

      cdg_hn_trans_grant:
        mov rdi, 4;
        call cdg_note;
        mov rax, 0xFFFFF939;
        jmp cdg_hn_out;
      cdg_hn_trans_deny:
        mov rdi, 4;
        call cdg_note;
        mov rax, 0xFFFFF939;

      cdg_hn_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
