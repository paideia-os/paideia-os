// src/kernel/core/drivers/tb/topology_graph.pdx — R35.M7-001 (#1223)
//
// TB4 TOPOLOGY GRAPH MODEL.
//
// The router table maintained by router_walk (R35.M2) is a FLAT list of
// discovered routers, indexed by route_id. It answers "which routers
// exist" but says nothing about how they are wired together: a
// downstream port of router A is bonded to an upstream port of router
// B, and the pair (A.p_a, B.p_b) is a physical LINK. Without those
// links a compositor cannot say "the DP tunnel on adapter 6 of this
// dock reaches display 2 through router X", and the security policy
// cannot say "this route revocation must drop every path that transits
// router Y".
//
// This module is the GRAPH THAT ANSWERS THAT QUESTION. Vertices are
// routers (identified by route_id, mirroring KIND_TB_DOMAIN's 24-bit
// route field); edges are physical port ↔ port bonds. A path from the
// host to a downstream point is a sequence of hops through this graph.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the GRAPH ADT half of the topology model. It:
//
//   1. VERTICES — 32-slot router table (route_id + port_count). One
//      writer per row; find by route_id; insert/remove.
//
//   2. EDGES — 128-slot edge table. Each edge is a
//      (router_a, port_a, router_b, port_b) bidirectional tuple.
//      One writer per row; find by either endpoint.
//
//   3. ADJACENCY — tg_edge_neighbor(route_id, port) returns the
//      opposite endpoint (packed neighbor_route_id[23:0] |
//      neighbor_port[31:24]) or TG_ROW_NONE.
//
// IT DOES NOT MINT KIND_TB_DOMAIN or KIND_TB_ROUTE. It records
// STRUCTURE, not authority. Callers holding a KIND_TB_DOMAIN or
// KIND_TB_ROUTE for the routers involved use this model to reason
// about them.
//
// IT DOES NOT WALK ROUTERS TO POPULATE ITSELF. router_walk.pdx
// (R35.M2) is the discovery driver; a live consumer of the topology
// channel translates router_appeared events into tg_router_add calls,
// and a future adapter-config parser translates link-property words
// into tg_edge_add calls. This scaffold ships the ADT so the diff
// consumer (R35.M7 #1225) has something to snapshot.
//
// tg_arbitrated() returns 0 until a router_appeared subscriber is
// bound as this module's populator.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _tg_routers, _tg_edges and _tg_stats are written only by helpers in
// this module. tools/build.sh confines relocations against each symbol
// to `core/drivers/tb/topology_graph.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF880..0xFFFFF88F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: sw_cm_fw_interop 0xFFFFF890..
// 9F, route_arith 0xFFFFF870..7F, topology_diff 0xFFFFF860..6F).

module TopologyGraph = structure {

  // Row / capacity constants.
  pub let TG_ROUTER_MAX     : u64 = 32
  pub let TG_EDGE_MAX       : u64 = 128
  pub let TG_ROUTER_ROW_BYTES : u64 = 32
  pub let TG_EDGE_ROW_BYTES   : u64 = 32
  pub let TG_PORT_MAX       : u64 = 63

  // Failure taxonomy — 0xFFFFF880..0xFFFFF88F.
  pub let TG_OK           : u64 = 0
  pub let TG_BAD_ARG      : u64 = 0xFFFFF88F
  pub let TG_BAD_ROUTE    : u64 = 0xFFFFF88E
  pub let TG_BAD_PORT     : u64 = 0xFFFFF88D
  pub let TG_DUP_ROUTER   : u64 = 0xFFFFF88C
  pub let TG_DUP_EDGE     : u64 = 0xFFFFF88B
  pub let TG_ENOSPC       : u64 = 0xFFFFF88A
  pub let TG_NOT_FOUND    : u64 = 0xFFFFF889
  pub let TG_PORT_IN_USE  : u64 = 0xFFFFF888
  pub let TG_SELF_LOOP    : u64 = 0xFFFFF887

  pub let TG_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TG_ROW_NONE   : u64 = 0xFF

  // Router row (32 bytes):
  //   [+0]  header  (in_use[63:56])
  //   [+8]  route_id[23:0]
  //   [+16] port_count[7:0]
  //   [+24] reserved
  pub let mut _tg_routers : [u64; 128] = uninit @align(64)

  // Edge row (32 bytes):
  //   [+0]  header  (in_use[63:56])
  //   [+8]  router_a[23:0] | port_a[31:24]
  //   [+16] router_b[23:0] | port_b[31:24]
  //   [+24] reserved
  pub let mut _tg_edges : [u64; 512] = uninit @align(64)

  pub let mut _tg_stats : [u64; 8] = uninit @align(64)

  pub let TG_ST_ROUTER_ADDED : u64 = 0
  pub let TG_ST_ROUTER_RM    : u64 = 1
  pub let TG_ST_EDGE_ADDED   : u64 = 2
  pub let TG_ST_EDGE_RM      : u64 = 3
  pub let TG_ST_REJECTS      : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let tg_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): clear routers, edges, stats. Labels prefixed tgr_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _tg_routers];
      tgr_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  tgr_r;

        lea r10, [rip + _tg_edges];
        xor rcx, rcx;
      tgr_e:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  tgr_e;

        lea r10, [rip + _tg_stats];
        xor rcx, rcx;
      tgr_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tgr_s;
        ret
      }
    } @no_frame

  pub let tg_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M7-001 (#1223): honesty pin. Returns 0 until a router_appeared subscriber is bound as this module's populator.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tg_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): counter read.",
      block: {
        cmp rdi, 8;
        jae tgst_zero;
        lea r10, [rip + _tg_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tgst_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tg_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): counter bump. Labels prefixed tgn_.",
      block: {
        cmp rdi, 8;
        jae tgn_out;
        lea r10, [rip + _tg_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tgn_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Router vertex table.
  // ==========================================================================

  pub let tg_router_find : (u64) -> u64 !{mem} @{} =
    fn (route_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): return row_id for route_id, or ROW_NONE. Labels prefixed tgrf_.",
      block: {
        xor rcx, rcx;
      tgrf_scan:
        cmp rcx, 32;
        jae tgrf_none;
        lea r10, [rip + _tg_routers];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgrf_next;
        mov rax, [r10 + 8];
        and rax, 0xFFFFFF;
        cmp rax, rdi;
        je  tgrf_hit;
      tgrf_next:
        add rcx, 1;
        jmp tgrf_scan;
      tgrf_hit:
        mov rax, rcx;
        ret;
      tgrf_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let tg_router_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): count live routers. Labels prefixed tgrc_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      tgrc_scan:
        cmp rcx, 32;
        jae tgrc_out;
        lea r10, [rip + _tg_routers];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov r11, [r10 + 0];
        shr r11, 56;
        cmp r11, 0;
        je  tgrc_next;
        add rax, 1;
      tgrc_next:
        add rcx, 1;
        jmp tgrc_scan;
      tgrc_out:
        ret
      }
    } @no_frame

  pub let tg_router_add : (u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (port_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): add router vertex. Refuses BAD_ROUTE (> 24 bits), BAD_ARG (port_count > 255), DUP_ROUTER, ENOSPC. Labels prefixed tgra_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // route_id
        mov r12, rsi;                    // port_count

        mov r10, 0xFFFFFF;
        cmp rbx, r10;
        ja  tgra_bad_route;
        cmp r12, 0xFF;
        ja  tgra_bad_arg;

        // Dup check.
        mov rdi, rbx;
        call tg_router_find;
        cmp rax, 0xFF;
        jne tgra_dup;

        // Free scan.
        xor r13, r13;
      tgra_scan:
        cmp r13, 32;
        jae tgra_enospc;
        lea r10, [rip + _tg_routers];
        mov r11, r13;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgra_claim;
        add r13, 1;
        jmp tgra_scan;

      tgra_claim:
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;
        mov rax, rbx;
        and rax, 0xFFFFFF;
        mov [r10 + 8], rax;
        mov rax, r12;
        and rax, 0xFF;
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        mov rdi, 0;                      // ROUTER_ADDED
        call tg_note;

        mov rax, r13;
        jmp tgra_out;

      tgra_bad_route:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88E;
        jmp tgra_out;
      tgra_bad_arg:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88F;
        jmp tgra_out;
      tgra_dup:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88C;
        jmp tgra_out;
      tgra_enospc:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88A;

      tgra_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tg_router_remove : (u64) -> u64 !{mem} @{} =
    fn (route_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): remove router vertex. Does not sweep its edges — R35.M7 diff consumer sees them as still present until a caller drops them. Refuses NOT_FOUND. Labels prefixed tgrr_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r10, 0xFFFFFF;
        cmp rbx, r10;
        ja  tgrr_nf;

        mov rdi, rbx;
        call tg_router_find;
        cmp rax, 0xFF;
        je  tgrr_nf;
        mov r12, rax;

        lea r10, [rip + _tg_routers];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rdi, 1;                      // ROUTER_RM
        call tg_note;
        xor rax, rax;
        jmp tgrr_out;

      tgrr_nf:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF889;

      tgrr_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Edge table.
  //
  // An edge is (router_a, port_a, router_b, port_b), bidirectional.
  // Adding an edge (A.p_a, B.p_b) is the same as (B.p_b, A.p_a); the
  // scaffold canonicalises by keeping the lower route_id on the "a"
  // side. Ports on a router are single-owner: an edge that would
  // occupy an already-occupied (router, port) refuses PORT_IN_USE.
  // ==========================================================================

  pub let tg_edge_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): count live edges. Labels prefixed tgec_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
      tgec_scan:
        cmp rcx, 128;
        jae tgec_out;
        lea r10, [rip + _tg_edges];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov r11, [r10 + 0];
        shr r11, 56;
        cmp r11, 0;
        je  tgec_next;
        add rax, 1;
      tgec_next:
        add rcx, 1;
        jmp tgec_scan;
      tgec_out:
        ret
      }
    } @no_frame

  // Return row_id whose endpoint matches (route_id, port) on side a
  // OR side b, else ROW_NONE.
  pub let tg_edge_find : (u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): find edge with endpoint (route_id, port). Labels prefixed tgef_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        xor r13, r13;
      tgef_scan:
        cmp r13, 128;
        jae tgef_none;
        lea r10, [rip + _tg_edges];
        mov r11, r13;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgef_next;
        // side a
        mov rax, [r10 + 8];
        mov rcx, rax;
        and rax, 0xFFFFFF;                // router_a
        shr rcx, 24;
        and rcx, 0xFF;                    // port_a
        cmp rax, rbx;
        jne tgef_try_b;
        cmp rcx, r12;
        je  tgef_hit;
      tgef_try_b:
        mov rax, [r10 + 16];
        mov rcx, rax;
        and rax, 0xFFFFFF;                // router_b
        shr rcx, 24;
        and rcx, 0xFF;                    // port_b
        cmp rax, rbx;
        jne tgef_next;
        cmp rcx, r12;
        je  tgef_hit;
      tgef_next:
        add r13, 1;
        jmp tgef_scan;
      tgef_hit:
        mov rax, r13;
        jmp tgef_out;
      tgef_none:
        mov rax, 0xFF;
      tgef_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tg_edge_add : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (router_a: u64) (port_a: u64) (router_b: u64) (port_b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): add bidirectional edge. Refuses BAD_ROUTE, BAD_PORT (> 63), SELF_LOOP (a==b), PORT_IN_USE on either endpoint, DUP_EDGE if the same pair already exists, ENOSPC. Labels prefixed tgea_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // router_a
        mov r12, rsi;                    // port_a
        mov r13, rdx;                    // router_b
        mov r14, rcx;                    // port_b

        mov r10, 0xFFFFFF;
        cmp rbx, r10;
        ja  tgea_bad_route;
        cmp r13, r10;
        ja  tgea_bad_route;
        cmp r12, 63;
        ja  tgea_bad_port;
        cmp r14, 63;
        ja  tgea_bad_port;

        // self-loop guard: same router same port
        cmp rbx, r13;
        jne tgea_check_ports;
        cmp r12, r14;
        je  tgea_self;

      tgea_check_ports:
        // PORT_IN_USE on (router_a, port_a)?
        mov rdi, rbx;
        mov rsi, r12;
        call tg_edge_find;
        cmp rax, 0xFF;
        jne tgea_dup_or_used;
        // PORT_IN_USE on (router_b, port_b)?
        mov rdi, r13;
        mov rsi, r14;
        call tg_edge_find;
        cmp rax, 0xFF;
        jne tgea_port_used_b;

        // Free scan.
        xor r15, r15;
      tgea_scan:
        cmp r15, 128;
        jae tgea_enospc;
        lea r10, [rip + _tg_edges];
        mov r11, r15;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgea_claim;
        add r15, 1;
        jmp tgea_scan;

      tgea_claim:
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;
        // side a
        mov rax, rbx;
        and rax, 0xFFFFFF;
        mov r11, r12;
        and r11, 0xFF;
        shl r11, 24;
        or  rax, r11;
        mov [r10 + 8], rax;
        // side b
        mov rax, r13;
        and rax, 0xFFFFFF;
        mov r11, r14;
        and r11, 0xFF;
        shl r11, 24;
        or  rax, r11;
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;

        mov rdi, 2;                      // EDGE_ADDED
        call tg_note;
        mov rax, r15;
        jmp tgea_out;

      tgea_bad_route:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88E;
        jmp tgea_out;
      tgea_bad_port:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88D;
        jmp tgea_out;
      tgea_self:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF887;
        jmp tgea_out;
      tgea_dup_or_used:
        // find hit; distinguish DUP_EDGE (same pair) vs PORT_IN_USE.
        mov r15, rax;                    // matched row
        lea r10, [rip + _tg_edges];
        mov r11, r15;
        shl r11, 5;
        add r10, r11;
        // Read matched sides.
        mov rax, [r10 + 8];
        mov rcx, rax;
        and rax, 0xFFFFFF;               // side_a router
        shr rcx, 24;
        and rcx, 0xFF;                   // side_a port
        // Is the OTHER side (r13, r14)?
        mov r11, [r10 + 16];
        mov r10, r11;
        and r10, 0xFFFFFF;               // side_b router
        shr r11, 24;
        and r11, 0xFF;                   // side_b port
        // Case: (rbx,r12) matched side a; check if (r13,r14) matches side b.
        cmp rax, rbx;
        jne tgea_check_swap;
        cmp rcx, r12;
        jne tgea_check_swap;
        cmp r10, r13;
        jne tgea_port_used_a;
        cmp r11, r14;
        jne tgea_port_used_a;
        jmp tgea_dup;
      tgea_check_swap:
        // Otherwise (rbx,r12) matched side b; check reverse.
        cmp rax, r13;
        jne tgea_port_used_a;
        cmp rcx, r14;
        jne tgea_port_used_a;
        jmp tgea_dup;

      tgea_dup:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88B;
        jmp tgea_out;
      tgea_port_used_a:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF888;
        jmp tgea_out;
      tgea_port_used_b:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF888;
        jmp tgea_out;
      tgea_enospc:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF88A;

      tgea_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tg_edge_remove : (u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): remove edge whose endpoint is (route_id, port). Refuses NOT_FOUND. Labels prefixed tger_.",
      block: {
        push rbx;

        mov rdi, rdi;
        mov rsi, rsi;
        call tg_edge_find;
        cmp rax, 0xFF;
        je  tger_nf;
        mov rbx, rax;

        lea r10, [rip + _tg_edges];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rdi, 3;                      // EDGE_RM
        call tg_note;
        xor rax, rax;
        jmp tger_out;

      tger_nf:
        mov rdi, 4;
        call tg_note;
        mov rax, 0xFFFFF889;

      tger_out:
        pop rbx;
        ret
      }
    }

  // Return neighbor endpoint packed as neighbor_route[23:0] |
  // neighbor_port[31:24] for the edge at (route_id, port), or
  // TG_DECODE_BAD if none.
  pub let tg_edge_neighbor : (u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): return opposite endpoint of (route_id, port). Labels prefixed tgen_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        mov rsi, r12;
        call tg_edge_find;
        cmp rax, 0xFF;
        je  tgen_none;
        mov r13, rax;

        lea r10, [rip + _tg_edges];
        mov r11, r13;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        mov rcx, rax;
        and rax, 0xFFFFFF;               // side_a router
        shr rcx, 24;
        and rcx, 0xFF;                   // side_a port
        cmp rax, rbx;
        jne tgen_return_a;
        cmp rcx, r12;
        jne tgen_return_a;
        // The queried endpoint IS side a — return side b.
        mov rax, [r10 + 16];
        jmp tgen_out;
      tgen_return_a:
        mov rax, [r10 + 8];
        jmp tgen_out;

      tgen_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      tgen_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Row accessors — mirror the R35.M7-003 diff consumer's needs.
  // ==========================================================================

  pub let tg_router_row_route : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): route_id at row_id, or DECODE_BAD.",
      block: {
        cmp rdi, 32;
        jae tgrrr_bad;
        lea r10, [rip + _tg_routers];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgrrr_bad;
        mov rax, [r10 + 8];
        and rax, 0xFFFFFF;
        ret;
      tgrrr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let tg_router_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): 1 iff router row is populated.",
      block: {
        cmp rdi, 32;
        jae tgriu_no;
        lea r10, [rip + _tg_routers];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgriu_no;
        mov rax, 1;
        ret;
      tgriu_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tg_edge_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): 1 iff edge row is populated.",
      block: {
        cmp rdi, 128;
        jae tgeiu_no;
        lea r10, [rip + _tg_edges];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgeiu_no;
        mov rax, 1;
        ret;
      tgeiu_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tg_edge_row_side_a : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): packed side_a (router[23:0] | port[31:24]) at row_id, or DECODE_BAD.",
      block: {
        cmp rdi, 128;
        jae tgesa_bad;
        lea r10, [rip + _tg_edges];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgesa_bad;
        mov rax, [r10 + 8];
        ret;
      tgesa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let tg_edge_row_side_b : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-001 (#1223): packed side_b (router[23:0] | port[31:24]) at row_id, or DECODE_BAD.",
      block: {
        cmp rdi, 128;
        jae tgesb_bad;
        lea r10, [rip + _tg_edges];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tgesb_bad;
        mov rax, [r10 + 16];
        ret;
      tgesb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame
}
