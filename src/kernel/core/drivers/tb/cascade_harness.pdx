// src/kernel/core/drivers/tb/cascade_harness.pdx — R35.M5-001 (#1215)
//
// TB4 cap-revocation cascade VALIDATION HARNESS — adversarial.
//
// The R35.M4-005 consent_revoke sequencer (consent_revoke.pdx) walks
// the KIND_DMA_ATTESTATION -> KIND_TB_ROUTE cascade for a SINGLE
// dock's routes. The R35.M3-005 route_teardown sequencer
// (route_teardown.pdx) walks the KIND_TB_ROUTE -> KIND_USB_DEVICE
// cascade for a single route. What has NOT been proved end-to-end
// against a DEEP chain is: does one revoke at the top of an
// attestation actually leave the whole chain empty?
//
// This module is the primitive that answers the question. It is a
// VALIDATION HARNESS in the same sense the R29 chaos harness is: it
// is production code that ships in the kernel and can be driven from
// a boot witness OR from a runtime supervisor (once R42's supervisor
// lands, an operator will be able to ask "is the revoke cascade
// intact?" and get a bounded answer). The synth witness in
// tests/kernel/drivers/tb/cascade_harness_synth.pdx exercises the
// harness at boot; that keeps the property under CI.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CHAIN-EMPTY VERIFIER and the STAGE COUNTER half of the
// cascade validation. It:
//
//   1. VERIFY_EMPTY — cascade_harness_verify_empty(slot_base,
//      slot_count) reads cap_table[slot_base..slot_base+slot_count),
//      returns 0 iff every one of them has kind == 0 (i.e. the
//      descriptor is empty). Returns a stamped error code on the
//      first slot that is not empty, encoding the slot index in the
//      low byte for diagnostic reporting. This is the adversarial
//      part -- the harness does not ask the cap subsystem WHETHER a
//      cap is revoked, it reads the descriptor bytes directly.
//
//   2. VERIFY_ROUTES_TORN — cascade_harness_verify_routes_torn(
//      slot_base, slot_count) walks the same slot range and, for
//      every slot whose descriptor still holds a KIND_TB_ROUTE,
//      requires the row's state == TORN (2). A route that survived
//      the cascade with state != TORN is a failure mode this harness
//      exposes. Returns 0 on all-torn (or all-empty), a stamped
//      error otherwise.
//
//   3. VERIFY_DEPTH — cascade_harness_verify_depth(slot_base,
//      slot_count) reports the effective chain depth found: the
//      number of slots at [slot_base..slot_base+slot_count) that
//      hold a KIND_TB_ROUTE (regardless of state). Used to
//      distinguish "the cascade cleaned up 8 routes" from "the
//      cascade cleaned up 0 routes because nothing was there".
//
// IT DOES NOT ITSELF BUILD THE CHAIN. The synth witness mints the
// 8-deep chain because chain-mint is a fixture concern (the caps in
// question are dummy KIND_TB_ROUTE rows against synthetic endpoints,
// not live TB4 hardware). This module is what the fixture calls to
// VERIFY the cascade behaved.
//
// IT DOES NOT ITSELF TRIGGER THE REVOKE. Same discipline: the synth
// witness calls consent_revoke_sequence for the attestation at the
// top of the chain, then calls this module to verify the sweep. A
// live supervisor use will look the same: trigger the revoke, then
// verify.
//
// cascade_harness_arbitrated() returns 0 until a runtime supervisor
// binds this module against a live consent-revoke path.
//
// =============================================================================
// §1  BOUNDED WALKS
// =============================================================================
//
// Every walk this module performs is bounded by slot_count, which
// is itself capped at CASCADE_HARNESS_MAX_DEPTH (12 — the USB4 spec
// max route depth) even if a caller supplies a larger value. A
// harness that could walk unbounded would be a denial-of-service
// primitive with a clear invocation path from any holder of the
// KIND_DMA_ATTESTATION cap.
//
// =============================================================================
// §2  ADVERSARIAL: READ DESCRIPTOR BYTES DIRECTLY
// =============================================================================
//
// The `verify_empty` walk reads cap_table + slot*24 + 0 (the kind
// byte) DIRECTLY. It does not call cap_slot_kind_of or any
// accessor: an accessor that lies (a bug in R35.M4's revoke path
// that clears the row but not the descriptor) would make an
// accessor-based verify pass on the same bug it is meant to catch.
// This is the property the "adversarial" in the module name refers
// to.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _cascade_harness_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/tb/cascade_harness.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF900..0xFFFFF90F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: consent_revoke
// 0xFFFFF910..1F, iommu_domain 0xFFFFF920..2F, security_policy
// 0xFFFFF8F0..FF, trusted_device 0xFFFFF8E0..EF).
//
// The low byte of a stamped error carries the offending slot index:
//   0xFFFFF9NX  where N is the class (D=DIRTY, T=NOT_TORN) and X is
//   the slot mod 16. The full slot index is not encoded (only 8 bits
//   fit) -- the harness reports the first failure only, and the
//   caller reads _cascade_harness_stats[FIRST_FAIL_SLOT] for the
//   full index.

module CascadeHarness = structure {

  // Failure taxonomy — 0xFFFFF900..0xFFFFF90F.
  pub let CASH_OK                : u64 = 0
  pub let CASH_BAD_ARG           : u64 = 0xFFFFF90F
  pub let CASH_BAD_RANGE         : u64 = 0xFFFFF90E
  pub let CASH_DIRTY             : u64 = 0xFFFFF90D
  pub let CASH_NOT_TORN          : u64 = 0xFFFFF90C
  pub let CASH_READ_REFUSED      : u64 = 0xFFFFF90B

  pub let CASCADE_HARNESS_MAX_DEPTH : u64 = 12

  pub let mut _cascade_harness_stats : [u64; 8] = uninit @align(64)

  pub let CASH_ST_VERIFY_EMPTY   : u64 = 0
  pub let CASH_ST_VERIFY_TORN    : u64 = 1
  pub let CASH_ST_FIRST_FAIL_SLOT: u64 = 2
  pub let CASH_ST_DEPTH_LAST     : u64 = 3
  pub let CASH_ST_REJECTS        : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let cascade_harness_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-001 (#1215): clear stats. Labels prefixed ch_rs_.",
      block: {
        lea r10, [rip + _cascade_harness_stats];
        xor rax, rax;
        xor rcx, rcx;
      ch_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ch_rs_loop;
        ret
      }
    }

  pub let cascade_harness_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M5-001 (#1215): honesty pin. Returns 0 until a runtime supervisor binds this harness against a live consent-revoke path.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let ch_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-001 (#1215): counter read.",
      block: {
        cmp rdi, 8;
        jae ch_st_zero;
        lea r10, [rip + _cascade_harness_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      ch_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ch_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-001 (#1215): counter bump. Labels prefixed ch_nt_.",
      block: {
        cmp rdi, 8;
        jae ch_nt_out;
        lea r10, [rip + _cascade_harness_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ch_nt_out:
        ret
      }
    }

  pub let ch_record_slot : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-001 (#1215): store slot into FIRST_FAIL_SLOT. Overwrites — this harness reports the first failure only; the caller can rerun for later ones.",
      block: {
        lea r10, [rip + _cascade_harness_stats];
        mov [r10 + 16], rdi;             // slot 2 * 8
        ret
      }
    }

  pub let ch_record_depth : (u64) -> () !{mem} @{} =
    fn (depth: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M5-001 (#1215): store depth into DEPTH_LAST.",
      block: {
        lea r10, [rip + _cascade_harness_stats];
        mov [r10 + 24], rdi;             // slot 3 * 8
        ret
      }
    }

  // ==========================================================================
  // VERIFY_EMPTY: walk slot_base..slot_base+min(slot_count, 12) and
  // require the KIND field at cap_table + slot*24 + 0 to be zero on
  // every slot. Returns 0 on all-empty, CASH_DIRTY|slot_lo on first
  // dirty slot.
  //
  // Reads the descriptor bytes DIRECTLY (§2).
  // ==========================================================================

  pub let cascade_harness_verify_empty : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot_base: u64) (slot_count: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M5-001 (#1215): walk cap_table slots directly. Labels prefixed ch_ve_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // slot_base
        mov r12, rsi;                    // slot_count

        mov rdi, 0;                      // VERIFY_EMPTY
        call ch_note;

        // Cap slot_count.
        mov r10, 12;                     // CASCADE_HARNESS_MAX_DEPTH
        cmp r12, r10;
        jbe ch_ve_ok_cap;
        mov r12, r10;
      ch_ve_ok_cap:

        // Bound check.
        mov r10, 256;
        mov rax, rbx;
        add rax, r12;
        cmp rax, r10;
        ja  ch_ve_bad_range;

        xor r13, r13;                    // iter
      ch_ve_scan:
        cmp r13, r12;
        jae ch_ve_done;

        // slot = rbx + r13.
        mov rax, rbx;
        add rax, r13;

        // Read cap_table + slot * 24 + 0 (kind byte).
        mov r10, cap_table;
        mov r11, rax;                    // slot
        mov r8, rax;
        shl r11, 3;                      // slot * 8
        shl r8, 4;                       // slot * 16
        add r11, r8;                     // slot * 24
        add r10, r11;
        mov rax, [r10 + 0];              // kind
        cmp rax, 0;
        jne ch_ve_dirty;

        add r13, 1;
        jmp ch_ve_scan;

      ch_ve_done:
        xor rax, rax;
        jmp ch_ve_out;

      ch_ve_dirty:
        // Record offending slot: rbx + r13.
        mov rax, rbx;
        add rax, r13;
        mov rdi, rax;
        call ch_record_slot;
        mov rdi, 4;                      // REJECTS
        call ch_note;
        mov rax, rbx;
        add rax, r13;
        and rax, 0x0F;                   // low nibble
        mov r10, 0xFFFFF90D;
        // Stamp the low byte with slot mod 16 (nibble in low 4 bits;
        // high nibble already 'D' from CASH_DIRTY).
        and r10, 0xFFFFFFFFFFFFFFF0;
        or  rax, r10;
        jmp ch_ve_out;

      ch_ve_bad_range:
        mov rdi, 4;
        call ch_note;
        mov rax, 0xFFFFF90E;

      ch_ve_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // VERIFY_ROUTES_TORN: walk slot_base..slot_base+min(slot_count,
  // 12). For every slot whose descriptor still holds a KIND_TB_ROUTE
  // (kind == 0x16D), require the row's state == TB_ROUTE_STATE_TORN
  // (2). Returns 0 on all-torn (or all-empty), CASH_NOT_TORN|slot_lo
  // on first non-TORN slot.
  //
  // The check is: use tb_route_row_of_slot to find the row, then
  // tb_route_row_state to read the state. A slot whose descriptor is
  // empty (kind == 0) contributes nothing (empty is stronger than
  // TORN and passes trivially).
  // ==========================================================================

  pub let cascade_harness_verify_routes_torn : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot_base: u64) (slot_count: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M5-001 (#1215): walk slots, for each KIND_TB_ROUTE slot require state=TORN. Labels prefixed ch_vt_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // slot_base
        mov r12, rsi;                    // slot_count

        mov rdi, 1;                      // VERIFY_TORN
        call ch_note;

        mov r10, 12;
        cmp r12, r10;
        jbe ch_vt_ok_cap;
        mov r12, r10;
      ch_vt_ok_cap:

        mov r10, 256;
        mov rax, rbx;
        add rax, r12;
        cmp rax, r10;
        ja  ch_vt_bad_range;

        xor r13, r13;
      ch_vt_scan:
        cmp r13, r12;
        jae ch_vt_done;

        mov rax, rbx;
        add rax, r13;

        // Descriptor kind.
        mov r10, cap_table;
        mov r11, rax;
        mov r8, rax;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rcx, [r10 + 0];
        cmp rcx, 0;
        je  ch_vt_next;                  // empty slot is fine
        mov r11, 0x16D;                  // KIND_TB_ROUTE
        cmp rcx, r11;
        jne ch_vt_next;                  // not a route — not our concern

        // It IS a KIND_TB_ROUTE. Resolve row and read state.
        push rax;
        mov rdi, rax;                    // slot
        call tb_route_row_of_slot;
        mov r11, rax;
        pop rax;
        cmp r11, 0xFF;
        je  ch_vt_next;                  // no row — treat as empty

        push rax;
        mov rdi, r11;
        call tb_route_row_state;
        mov r11, rax;
        pop rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r11, r10;
        je  ch_vt_not_torn;              // decode bad -> not torn
        cmp r11, 2;                      // TB_ROUTE_STATE_TORN
        jne ch_vt_not_torn;

      ch_vt_next:
        add r13, 1;
        jmp ch_vt_scan;

      ch_vt_done:
        xor rax, rax;
        jmp ch_vt_out;

      ch_vt_not_torn:
        mov rax, rbx;
        add rax, r13;
        mov rdi, rax;
        call ch_record_slot;
        mov rdi, 4;
        call ch_note;
        mov rax, rbx;
        add rax, r13;
        and rax, 0x0F;
        mov r10, 0xFFFFF90C;
        and r10, 0xFFFFFFFFFFFFFFF0;
        or  rax, r10;
        jmp ch_vt_out;

      ch_vt_bad_range:
        mov rdi, 4;
        call ch_note;
        mov rax, 0xFFFFF90E;

      ch_vt_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // VERIFY_DEPTH: count how many slots in the range currently hold a
  // KIND_TB_ROUTE descriptor. Used to distinguish a genuine cascade
  // sweep (depth was N, now 0) from a vacuous pass (depth was 0 to
  // begin with).
  // ==========================================================================

  pub let cascade_harness_verify_depth : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot_base: u64) (slot_count: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M5-001 (#1215): count KIND_TB_ROUTE descriptors in range. Labels prefixed ch_vd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // slot_base
        mov r12, rsi;                    // slot_count
        xor r14, r14;                    // count

        mov r10, 12;
        cmp r12, r10;
        jbe ch_vd_ok_cap;
        mov r12, r10;
      ch_vd_ok_cap:

        mov r10, 256;
        mov rax, rbx;
        add rax, r12;
        cmp rax, r10;
        ja  ch_vd_out;

        xor r13, r13;
      ch_vd_scan:
        cmp r13, r12;
        jae ch_vd_done;

        mov rax, rbx;
        add rax, r13;

        mov r10, cap_table;
        mov r11, rax;
        mov r8, rax;
        shl r11, 3;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rcx, [r10 + 0];
        mov r11, 0x16D;                  // KIND_TB_ROUTE
        cmp rcx, r11;
        jne ch_vd_next;
        add r14, 1;
      ch_vd_next:
        add r13, 1;
        jmp ch_vd_scan;

      ch_vd_done:
        mov rdi, r14;
        call ch_record_depth;

      ch_vd_out:
        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
