// src/kernel/core/drivers/tb/sw_cm_fw_interop.pdx — R35.M6-004 (#1222)
//
// Software Connection Manager (sw-CM) FIRMWARE-CM INTEROP HANDSHAKE.
//
// Modern USB4 hosts ship in one of two arrangements:
//
//   * FIRMWARE-CM PRESENT — the NHI silicon or an adjacent
//     microcontroller (typically Intel's Titan Ridge or Maple Ridge)
//     runs the Connection Manager itself, and the host driver must
//     defer to it: the host does not walk routers, does not
//     establish tunnels, does not enforce policy. Every action goes
//     through the firmware, and the host receives topology through
//     firmware-published events.
//
//   * FIRMWARE-CM ABSENT — the host runs the CM itself, exactly the
//     path R35.M6-001/002/003 delivers.
//
// This module is the FIRST-CONTACT NEGOTIATION between the sw-CM and
// the (possibly present) firmware-CM. It reads the NHI capability
// register (through a seam that today reports absent for QEMU), and
// on that basis:
//
//   * If firmware-CM is ABSENT — mode goes to ACTIVE. The sw-CM
//     runs the four operations above.
//   * If firmware-CM is PRESENT — mode goes to PASSIVE. The sw-CM
//     becomes an OBSERVER: it consumes the topology events the
//     firmware publishes and does not itself issue commands. This
//     also means the sw-CM's cmdq (sw_cm_cmdq.pdx) is a no-op — a
//     host attempting to enqueue in PASSIVE mode gets refused
//     (WRONG_MODE from a caller-owned check; this module ships the
//     mode primitive that check reads).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CAPABILITY-DETECT + MODE-LATCH + FEATURE-NEGOTIATION
// half of the interop handshake. It:
//
//   1. DETECT — sw_cm_nhi_fw_present() reads a seam that today
//      returns 0 (no firmware-CM under QEMU). A live probe is
//      deferred to R36 (per §5); this module ships with the value
//      the negotiation will read once bound.
//
//   2. INIT — sw_cm_fw_interop_init(fw_present, fw_version,
//      feature_mask) latches the negotiated state:
//        mode         := ACTIVE if fw_present==0 else PASSIVE
//        fw_version   := as supplied
//        feature_mask := as supplied
//      The three fields become IMMUTABLE for the rest of the boot.
//      Re-init returns SWIOP_ALREADY_INIT. This is deliberate: the
//      whole point of the arrangement is that a machine's CM
//      identity is a boot-time fact, not a runtime toggle. A
//      firmware-CM cannot appear or vanish mid-boot without a reset,
//      and a host that started ACTIVE cannot safely become PASSIVE
//      without renegotiating every downstream router.
//
//   3. NEGOTIATE — sw_cm_fw_interop_negotiate(client_mask)
//      intersects the caller's supported feature bits with the
//      firmware's, returning the agreed set. Callable multiple times
//      because it is READ-ONLY against the latched fields.
//
//   4. QUERY — sw_cm_fw_interop_mode(), sw_cm_fw_interop_version(),
//      sw_cm_fw_interop_feature_mask() — read accessors.
//
// IT DOES NOT ITSELF SWITCH OTHER MODULES BETWEEN ACTIVE AND PASSIVE
// BEHAVIOUR. Callers of sw_cm_cmdq_enqueue / router_walk / cm_rings
// query the mode and adjust. Splitting the switch from the mode
// makes the switch's location visible in each caller's code.
//
// sw_cm_fw_interop_arbitrated() returns 0 until the NHI capability
// probe is bound to a real MMIO read.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _sw_cm_fw_interop_state and _sw_cm_fw_interop_stats are written
// only by helpers in this module. tools/build.sh confines
// relocations against each symbol to `core/drivers/tb/
// sw_cm_fw_interop.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF890..0xFFFFF89F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: sw_cm_evtmux
// 0xFFFFF8A0..AF, sw_cm_cmdq 0xFFFFF8B0..BF, sw_cm_fsm
// 0xFFFFF8C0..CF).
//
// =============================================================================
// §5  DEFERRED WIRING (honesty)
// =============================================================================
//
// The NHI-capability probe seam (sw_cm_nhi_fw_present) returns 0
// today regardless of hardware; the platform-descriptor read that
// would answer the question honestly is deferred to R36 (VT-d
// scaffold, which owns the platform-descriptor path this probe
// shares). This module ships with the mode-latching primitive so
// callers can query the value once the probe is bound.

module SwCmFwInterop = structure {

  // Mode ordinals.
  pub let SWIOP_MODE_UNINIT  : u64 = 0
  pub let SWIOP_MODE_ACTIVE  : u64 = 1
  pub let SWIOP_MODE_PASSIVE : u64 = 2

  // Feature bit budget — 32 bits reserved.
  pub let SWIOP_FEATURE_MASK_MAX : u64 = 0xFFFFFFFF

  // Failure taxonomy — 0xFFFFF890..0xFFFFF89F.
  pub let SWIOP_OK              : u64 = 0
  pub let SWIOP_BAD_ARG         : u64 = 0xFFFFF89F
  pub let SWIOP_ALREADY_INIT    : u64 = 0xFFFFF89E
  pub let SWIOP_NOT_INIT        : u64 = 0xFFFFF89D
  pub let SWIOP_BAD_VERSION     : u64 = 0xFFFFF89C
  pub let SWIOP_BAD_MASK        : u64 = 0xFFFFF89B

  pub let SWIOP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // State layout:
  //   [0] init_flag (0 = uninit, 1 = latched)
  //   [1] mode
  //   [2] fw_version
  //   [3] feature_mask
  pub let mut _sw_cm_fw_interop_state : [u64; 4] = uninit @align(64)
  pub let mut _sw_cm_fw_interop_stats : [u64; 8] = uninit @align(64)

  pub let SWIOP_ST_INIT_ACTIVE  : u64 = 0
  pub let SWIOP_ST_INIT_PASSIVE : u64 = 1
  pub let SWIOP_ST_NEGOTIATIONS : u64 = 2
  pub let SWIOP_ST_REJECTS      : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let sw_cm_fw_interop_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): clear state + stats. Labels prefixed sior_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _sw_cm_fw_interop_state];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        lea r10, [rip + _sw_cm_fw_interop_stats];
        xor rcx, rcx;
      sior_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sior_s;
        ret
      }
    }

  pub let sw_cm_fw_interop_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-004 (#1222): honesty pin. Returns 0 until the NHI capability probe is bound to a real MMIO read. See §5.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let sw_cm_fw_interop_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): counter read.",
      block: {
        cmp rdi, 8;
        jae sios_zero;
        lea r10, [rip + _sw_cm_fw_interop_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sios_zero:
        xor rax, rax;
        ret
      }
    }

  pub let sio_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): counter bump. Labels prefixed sion_.",
      block: {
        cmp rdi, 8;
        jae sion_out;
        lea r10, [rip + _sw_cm_fw_interop_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sion_out:
        ret
      }
    }

  // ==========================================================================
  // NHI capability seam. Returns 0 (firmware-CM absent) today. A live
  // MMIO read is deferred to R36 (per §5).
  // ==========================================================================

  pub let sw_cm_nhi_fw_present : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-004 (#1222): NHI FW-CM present probe seam. Returns 0 (absent) today. See §5.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Query accessors.
  // ==========================================================================

  pub let sw_cm_fw_interop_is_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): read init flag.",
      block: {
        lea r10, [rip + _sw_cm_fw_interop_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let sw_cm_fw_interop_mode : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): read latched mode. Uninit -> UNINIT (0).",
      block: {
        lea r10, [rip + _sw_cm_fw_interop_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let sw_cm_fw_interop_version : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): read latched fw_version. Uninit -> 0.",
      block: {
        lea r10, [rip + _sw_cm_fw_interop_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let sw_cm_fw_interop_feature_mask : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): read latched feature_mask. Uninit -> 0.",
      block: {
        lea r10, [rip + _sw_cm_fw_interop_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  // ==========================================================================
  // INIT. Latch mode / fw_version / feature_mask.
  //
  // Semantics:
  //   * fw_present bit -> mode: 0 => ACTIVE, non-zero => PASSIVE.
  //   * fw_version validated: must fit in 32 bits.
  //   * feature_mask validated: must fit in 32 bits.
  //   * ALREADY_INIT if init flag is set.
  //
  // Note that fw_version and feature_mask are accepted even when
  // fw_present==0 (ACTIVE). They are ignored in ACTIVE by every
  // caller, but latched here so a test can distinguish "the init
  // ran" from "no init ever ran" without a separate mode ping.
  // ==========================================================================

  pub let sw_cm_fw_interop_init : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (fw_present: u64) (fw_version: u64) (feature_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): latch mode/version/mask; refuse re-init. Labels prefixed sioi_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // fw_present
        mov r12, rsi;                    // fw_version
        mov r13, rdx;                    // feature_mask

        mov r10, 0xFFFFFFFF;
        cmp r12, r10;
        ja  sioi_bad_ver;
        cmp r13, r10;
        ja  sioi_bad_mask;

        lea r10, [rip + _sw_cm_fw_interop_state];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne sioi_already;

        // Latch.
        mov rax, 1;
        mov [r10 + 0], rax;              // init flag

        // Mode.
        cmp rbx, 0;
        je  sioi_active;
        // Passive.
        mov rax, 2;
        mov [r10 + 8], rax;
        mov [r10 + 16], r12;
        mov [r10 + 24], r13;
        mov rdi, 1;                      // INIT_PASSIVE
        call sio_note;
        xor rax, rax;
        jmp sioi_out;

      sioi_active:
        mov rax, 1;
        mov [r10 + 8], rax;
        mov [r10 + 16], r12;
        mov [r10 + 24], r13;
        mov rdi, 0;                      // INIT_ACTIVE
        call sio_note;
        xor rax, rax;
        jmp sioi_out;

      sioi_already:
        mov rdi, 3;
        call sio_note;
        mov rax, 0xFFFFF89E;
        jmp sioi_out;
      sioi_bad_ver:
        mov rdi, 3;
        call sio_note;
        mov rax, 0xFFFFF89C;
        jmp sioi_out;
      sioi_bad_mask:
        mov rdi, 3;
        call sio_note;
        mov rax, 0xFFFFF89B;

      sioi_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // NEGOTIATE. Intersect the client's requested feature bits with the
  // firmware's. Returns the agreed mask on success, DECODE_BAD if
  // called before init.
  // ==========================================================================

  pub let sw_cm_fw_interop_negotiate : (u64) -> u64 !{mem} @{} =
    fn (client_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-004 (#1222): intersect client_mask with latched feature_mask. Labels prefixed sion_g_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // client_mask

        call sw_cm_fw_interop_is_init;
        cmp rax, 0;
        je  sion_g_not_init;

        call sw_cm_fw_interop_feature_mask;
        and rax, rbx;
        mov r10, 0xFFFFFFFF;
        and rax, r10;

        push rax;
        mov rdi, 2;                      // NEGOTIATIONS
        call sio_note;
        pop rax;

        jmp sion_g_out;

      sion_g_not_init:
        mov rdi, 3;
        call sio_note;
        mov rax, 0xFFFFFFFFFFFFFFFF;

      sion_g_out:
        pop rbx;
        ret
      }
    }
}
