// src/kernel/core/drivers/tb/usb3_xhci_ext.pdx — R35.M10-001 (#1232)
//
// USB3 TUNNEL VIRTUAL xHCI PORT EXTENSION.
//
// R35.M3 (#1207) established a USB3 tunnel across the TB4 fabric.
// Once the tunnel is up, the tunneled host arrives at the local
// xHCI as an ADDITIONAL SET OF PORTS grafted onto the existing
// xHCI port-set (xHCI 1.2 §4.19 leaves room for hot-added port
// pairs; the eXtended Capabilities pointer chain is the mechanism a
// driver walks to discover them). This module is the ROW TABLE
// that carries the mapping from a TB4 tunnel_slot to the (base, count)
// range of xHCI ports the tunnel presents, and the PORT PLACEHOLDER
// EVENTS the R34 USB stack will consume once a real xHCI extension
// binding lands.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ROW TABLE + PLACEHOLDER EVENT half of the xHCI tunnel
// extension. It:
//
//   1. BIND — u3xe_bind(tunnel_slot, xhci_base_port, port_count)
//      stamps a row that grafts port_count consecutive xHCI ports
//      starting at xhci_base_port onto the tunneled slot. Refuses
//      BAD_TUNNEL_SLOT (>0xFF), BAD_BASE (>= U3XE_PORT_LIMIT), BAD_COUNT
//      (0 or > U3XE_PORT_MAX), DUP (tunnel_slot already bound), OVERLAP
//      (the [base, base+count) range intersects another binding), and
//      ENOSPC when the table is full.
//
//   2. UNBIND — u3xe_unbind(tunnel_slot) clears the row keyed by
//      tunnel_slot. Refuses NOT_FOUND. Bumps the UNBIND counter and
//      emits one port_removed placeholder per port in the range.
//
//   3. LOOKUP — u3xe_find_by_slot(tunnel_slot) returns the row index
//      or ROW_NONE. u3xe_row_in_use / u3xe_row_tunnel /
//      u3xe_row_xhci_base / u3xe_row_count read individual fields.
//
//   4. EVENT — u3xe_port_added(tunnel_slot, port_index) and
//      u3xe_port_removed(tunnel_slot, port_index) bump per-kind
//      counters. R34's USB supervisor replaces the counter bump with
//      a fanout through usb_hub_channel once a live binding exists.
//
// IT DOES NOT WRITE xHCI MMIO. The eXtended Capabilities pointer walk
// that discovers hot-added port sets, and the PORTSC handshake that
// resets and enumerates a device on one, belong to a live xHCI
// driver. This scaffold only carries the SHAPE of the association;
// the wire belongs to R34.
//
// IT DOES NOT ALLOCATE THE TUNNEL. usb3_tunnel.pdx (R35.M3-003)
// establishes the fabric-side tunnel; this shim consumes the tunnel_slot
// it returned and pairs it with the xHCI port range the tunneled host
// wants to expose.
//
// IT DOES NOT INTERPRET DEVICE STATE. Whether a port is running at
// SS/SS+/USB3 Gen 2x2 is a caller's determination against the xHCI
// PORTSC register; this scaffold records only the port index bounds.
//
// u3xe_arbitrated() returns 0 until R34's USB supervisor binds this
// scaffold against real xHCI port-add / port-remove transactions.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _u3xe_ports and _u3xe_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/usb3_xhci_ext.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF7F0..0xFFFFF7FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dp_hotplug_bridge 0xFFFFF800..
// 0F, usbpd_contract 0xFFFFF7E0..EF).

module Usb3XhciExt = structure {

  // Row capacity + slot geometry.
  pub let U3XE_ROW_MAX     : u64 = 4               // one per tunneled host
  pub let U3XE_ROW_U64     : u64 = 8               // 8 u64s per row (64 bytes)

  // xHCI 1.2 caps port index at 255; carry that ceiling.
  pub let U3XE_PORT_LIMIT  : u64 = 255             // max xHCI port index

  // Cap ports-per-tunnel at 8: USB4 §11.4 permits multi-port hosts but
  // a tunneled hub arriving with more than 8 ports is a warrant to
  // fall back to enumeration, not to graft directly.
  pub let U3XE_PORT_MAX    : u64 = 8               // ports per binding cap

  // Tunnel slot cap. Same u8 range dp_ddi_shim / dp_aux_passthru use.
  pub let U3XE_TUNNEL_MAX  : u64 = 0xFF

  // Status ordinals.
  pub let U3XE_STATUS_FREE   : u64 = 0
  pub let U3XE_STATUS_BOUND  : u64 = 1
  pub let U3XE_STATUS_UNBOUND: u64 = 2

  // Placeholder event kinds.
  pub let U3XE_EVT_ADDED   : u64 = 0
  pub let U3XE_EVT_REMOVED : u64 = 1
  pub let U3XE_EVT_MAX     : u64 = 1

  // Failure taxonomy — 0xFFFFF7F0..0xFFFFF7FF.
  pub let U3XE_OK              : u64 = 0
  pub let U3XE_BAD_ARG         : u64 = 0xFFFFF7FF
  pub let U3XE_BAD_TUNNEL_SLOT : u64 = 0xFFFFF7FE
  pub let U3XE_BAD_BASE        : u64 = 0xFFFFF7FD
  pub let U3XE_BAD_COUNT       : u64 = 0xFFFFF7FC
  pub let U3XE_BAD_PORT        : u64 = 0xFFFFF7FB
  pub let U3XE_DUP             : u64 = 0xFFFFF7FA
  pub let U3XE_ENOSPC          : u64 = 0xFFFFF7F9
  pub let U3XE_NOT_FOUND       : u64 = 0xFFFFF7F8
  pub let U3XE_OVERLAP         : u64 = 0xFFFFF7F7

  pub let U3XE_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let U3XE_ROW_NONE   : u64 = 0xFF

  // Row (8 u64s, 64 bytes):
  //   [+0]  in_use  (0/1)
  //   [+8]  tunnel_slot
  //   [+16] xhci_base_port
  //   [+24] port_count
  //   [+32] status
  //   [+40] reserved
  //   [+48] reserved
  //   [+56] reserved
  pub let mut _u3xe_ports : [u64; 32] = uninit @align(64)   // 4 rows × 8 u64
  pub let mut _u3xe_stats : [u64; 8]  = uninit @align(64)

  pub let U3XE_ST_BINDS    : u64 = 0
  pub let U3XE_ST_UNBINDS  : u64 = 1
  pub let U3XE_ST_ADDED    : u64 = 2
  pub let U3XE_ST_REMOVED  : u64 = 3
  pub let U3XE_ST_REJECTS  : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let u3xe_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): clear rows + stats. Labels prefixed u3xe_rs_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _u3xe_ports];
      u3xe_rs_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  u3xe_rs_r;

        xor rcx, rcx;
        lea r10, [rip + _u3xe_stats];
      u3xe_rs_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  u3xe_rs_s;
        ret
      }
    }

  pub let u3xe_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-001 (#1232): honesty pin. Returns 0 until R34's USB supervisor binds this against real xHCI port-add / port-remove transactions.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): counter read.",
      block: {
        cmp rdi, 8;
        jae u3xe_st_zero;
        lea r10, [rip + _u3xe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      u3xe_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): counter bump. Labels prefixed u3xe_nt_.",
      block: {
        cmp rdi, 8;
        jae u3xe_nt_out;
        lea r10, [rip + _u3xe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      u3xe_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Row byte offset = row * 64 = row << 6.
  // ==========================================================================

  pub let u3xe_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): read row.in_use.",
      block: {
        cmp rdi, 4;
        jae u3xe_ri_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _u3xe_ports];
        add r10, rbx;
        mov rax, [r10 + 0];
        pop rbx;
        ret;
      u3xe_ri_zero:
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_row_tunnel : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): read row.tunnel_slot.",
      block: {
        cmp rdi, 4;
        jae u3xe_rt_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _u3xe_ports];
        add r10, rbx;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      u3xe_rt_zero:
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_row_xhci_base : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): read row.xhci_base_port.",
      block: {
        cmp rdi, 4;
        jae u3xe_rb_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _u3xe_ports];
        add r10, rbx;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      u3xe_rb_zero:
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_row_count : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): read row.port_count.",
      block: {
        cmp rdi, 4;
        jae u3xe_rc_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _u3xe_ports];
        add r10, rbx;
        mov rax, [r10 + 24];
        pop rbx;
        ret;
      u3xe_rc_zero:
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_row_status : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): read row.status.",
      block: {
        cmp rdi, 4;
        jae u3xe_rst_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _u3xe_ports];
        add r10, rbx;
        mov rax, [r10 + 32];
        pop rbx;
        ret;
      u3xe_rst_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let u3xe_tunnel_valid : (u64) -> u64 !{} @{} =
    fn (ts: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-001 (#1232): 1 iff ts fits in u8.",
      block: {
        cmp rdi, 0xFF;
        ja  u3xe_tv_no;
        mov rax, 1;
        ret;
      u3xe_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_base_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-001 (#1232): 1 iff b in [0, 255].",
      block: {
        cmp rdi, 255;
        ja  u3xe_bv_no;
        mov rax, 1;
        ret;
      u3xe_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let u3xe_count_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M10-001 (#1232): 1 iff c in [1, 8].",
      block: {
        cmp rdi, 0;
        je  u3xe_cv_no;
        cmp rdi, 8;
        ja  u3xe_cv_no;
        mov rax, 1;
        ret;
      u3xe_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // u3xe_find_by_slot(tunnel_slot) — locate row by tunnel_slot.
  // ==========================================================================

  pub let u3xe_find_by_slot : (u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): scan for row whose tunnel_slot == arg. Labels prefixed u3xe_fs_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        xor r12, r12;
      u3xe_fs_scan:
        cmp r12, 4;
        jae u3xe_fs_none;
        mov rdi, r12;
        call u3xe_row_in_use;
        cmp rax, 0;
        je  u3xe_fs_next;
        mov rdi, r12;
        call u3xe_row_tunnel;
        cmp rax, rbx;
        je  u3xe_fs_hit;
      u3xe_fs_next:
        add r12, 1;
        jmp u3xe_fs_scan;
      u3xe_fs_hit:
        mov rax, r12;
        pop r12;
        pop rbx;
        ret;
      u3xe_fs_none:
        mov rax, 0xFF;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // u3xe_range_overlaps(base, count) — 1 iff any live row's port range
  // overlaps [base, base+count). Two intervals [a, a+la) and [b, b+lb)
  // are disjoint iff a+la <= b or b+lb <= a; they overlap otherwise.
  // ==========================================================================

  pub let u3xe_range_overlaps : (u64, u64) -> u64 !{mem} @{} =
    fn (base: u64) (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): scan for a live row whose [base, base+count) intersects [arg, arg+arg). Labels prefixed u3xe_ro_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // arg base
        mov r12, rsi;                    // arg count
        mov r13, rbx;
        add r13, r12;                    // arg end

        xor r14, r14;                    // iterator
      u3xe_ro_scan:
        cmp r14, 4;
        jae u3xe_ro_no;
        mov rdi, r14;
        call u3xe_row_in_use;
        cmp rax, 0;
        je  u3xe_ro_next;
        mov rdi, r14;
        call u3xe_row_xhci_base;
        mov r15, rax;                    // row base
        mov rdi, r14;
        call u3xe_row_count;
        add rax, r15;                    // row end
        // Overlap iff !(arg_end <= row_base || row_end <= arg_base).
        cmp r13, r15;
        jbe u3xe_ro_next;
        cmp rax, rbx;
        jbe u3xe_ro_next;
        // Overlap.
        mov rax, 1;
        jmp u3xe_ro_out;
      u3xe_ro_next:
        add r14, 1;
        jmp u3xe_ro_scan;
      u3xe_ro_no:
        xor rax, rax;

      u3xe_ro_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // u3xe_bind(tunnel_slot, xhci_base_port, port_count).
  //
  // Sequence:
  //   1. tunnel_slot fits u8               (BAD_TUNNEL_SLOT)
  //   2. xhci_base_port in [0, 255]        (BAD_BASE)
  //   3. port_count in [1, 8]              (BAD_COUNT)
  //   4. base + count <= 256               (BAD_BASE, so the range fits u8)
  //   5. no existing row for tunnel_slot   (DUP)
  //   6. no existing row overlaps range    (OVERLAP)
  //   7. allocate free row                 (ENOSPC)
  //   8. commit; BOUND status; BINDS bump
  // ==========================================================================

  pub let u3xe_bind : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) (xhci_base_port: u64) (port_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): stamp a tunnel-to-xHCI-port-range row. Labels prefixed u3xe_bd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // tunnel_slot
        mov r12, rsi;                    // base
        mov r13, rdx;                    // count

        mov rdi, rbx;
        call u3xe_tunnel_valid;
        cmp rax, 0;
        je  u3xe_bd_bad_tunnel;

        mov rdi, r12;
        call u3xe_base_valid;
        cmp rax, 0;
        je  u3xe_bd_bad_base;

        mov rdi, r13;
        call u3xe_count_valid;
        cmp rax, 0;
        je  u3xe_bd_bad_count;

        // base + count <= 256 so the range fits within the u8 port
        // window; otherwise the tail port index would exceed 255 and
        // become indistinguishable from an unrelated eXtCap chain.
        mov rax, r12;
        add rax, r13;
        cmp rax, 256;
        ja  u3xe_bd_bad_base;

        mov rdi, rbx;
        call u3xe_find_by_slot;
        cmp rax, 0xFF;
        jne u3xe_bd_dup;

        mov rdi, r12;
        mov rsi, r13;
        call u3xe_range_overlaps;
        cmp rax, 0;
        jne u3xe_bd_overlap;

        // Scan for free row.
        xor r14, r14;
      u3xe_bd_scan:
        cmp r14, 4;
        jae u3xe_bd_full;
        mov rdi, r14;
        call u3xe_row_in_use;
        cmp rax, 0;
        je  u3xe_bd_free;
        add r14, 1;
        jmp u3xe_bd_scan;

      u3xe_bd_free:
        mov r15, r14;
        shl r15, 6;
        lea r10, [rip + _u3xe_ports];
        add r10, r15;
        mov rax, 1;
        mov [r10 + 0], rax;
        mov [r10 + 8], rbx;
        mov [r10 + 16], r12;
        mov [r10 + 24], r13;
        mov rax, 1;                      // BOUND
        mov [r10 + 32], rax;
        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 0;                      // BINDS
        call u3xe_note;
        xor rax, rax;
        jmp u3xe_bd_out;

      u3xe_bd_bad_tunnel:
        mov rdi, 4;                      // REJECTS
        call u3xe_note;
        mov rax, 0xFFFFF7FE;
        jmp u3xe_bd_out;
      u3xe_bd_bad_base:
        mov rdi, 4;
        call u3xe_note;
        mov rax, 0xFFFFF7FD;
        jmp u3xe_bd_out;
      u3xe_bd_bad_count:
        mov rdi, 4;
        call u3xe_note;
        mov rax, 0xFFFFF7FC;
        jmp u3xe_bd_out;
      u3xe_bd_dup:
        mov rdi, 4;
        call u3xe_note;
        mov rax, 0xFFFFF7FA;
        jmp u3xe_bd_out;
      u3xe_bd_overlap:
        mov rdi, 4;
        call u3xe_note;
        mov rax, 0xFFFFF7F7;
        jmp u3xe_bd_out;
      u3xe_bd_full:
        mov rdi, 4;
        call u3xe_note;
        mov rax, 0xFFFFF7F9;

      u3xe_bd_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // u3xe_unbind(tunnel_slot). Clears the row, sets UNBOUND, bumps
  // UNBINDS counter and per-port REMOVED events (one per port).
  // ==========================================================================

  pub let u3xe_unbind : (u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): drop a tunnel-to-xHCI-port-range row. Labels prefixed u3xe_ub_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;

        mov rdi, rbx;
        call u3xe_tunnel_valid;
        cmp rax, 0;
        je  u3xe_ub_bad_tunnel;

        mov rdi, rbx;
        call u3xe_find_by_slot;
        cmp rax, 0xFF;
        je  u3xe_ub_not_found;
        mov r12, rax;

        // Capture port_count BEFORE clearing so we can emit the
        // corresponding REMOVED bumps.
        mov rdi, r12;
        call u3xe_row_count;
        mov r14, rax;

        mov r13, r12;
        shl r13, 6;
        lea r10, [rip + _u3xe_ports];
        add r10, r13;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov rax, 2;                      // UNBOUND status
        mov [r10 + 32], rax;
        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 1;                      // UNBINDS
        call u3xe_note;

        // Bump REMOVED once per port that had been in the range.
      u3xe_ub_rem_scan:
        cmp r14, 0;
        je  u3xe_ub_ok;
        mov rdi, 3;                      // REMOVED
        call u3xe_note;
        sub r14, 1;
        jmp u3xe_ub_rem_scan;

      u3xe_ub_ok:
        xor rax, rax;
        jmp u3xe_ub_out;

      u3xe_ub_bad_tunnel:
        mov rdi, 4;
        call u3xe_note;
        mov rax, 0xFFFFF7FE;
        jmp u3xe_ub_out;
      u3xe_ub_not_found:
        mov rdi, 4;
        call u3xe_note;
        mov rax, 0xFFFFF7F8;

      u3xe_ub_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Port-index placeholder events. R34 replaces the counter bumps with
  // a fanout through usb_hub_channel once a live binding exists.
  //
  // port_index is validated against the row's [xhci_base_port,
  // xhci_base_port + port_count) window: an event outside that window
  // is a caller error and refuses BAD_PORT.
  // ==========================================================================

  pub let u3xe_port_added : (u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) (port_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): placeholder emit of port_added. Labels prefixed u3xe_pa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // tunnel
        mov r12, rsi;                    // port_index

        mov rdi, rbx;
        call u3xe_tunnel_valid;
        cmp rax, 0;
        je  u3xe_pa_bad_tunnel;

        mov rdi, rbx;
        call u3xe_find_by_slot;
        cmp rax, 0xFF;
        je  u3xe_pa_not_found;
        mov r13, rax;                    // row id

        mov rdi, r13;
        call u3xe_row_xhci_base;
        mov r14, rax;                    // row base
        cmp r12, r14;
        jb  u3xe_pa_bad_port;
        mov rdi, r13;
        call u3xe_row_count;
        add rax, r14;                    // row base + count = end
        cmp r12, rax;
        jae u3xe_pa_bad_port;

        mov rdi, 2;                      // ADDED
        call u3xe_note;
        xor rax, rax;
        jmp u3xe_pa_out;

      u3xe_pa_bad_tunnel:
        mov rax, 0xFFFFF7FE;
        jmp u3xe_pa_out;
      u3xe_pa_not_found:
        mov rax, 0xFFFFF7F8;
        jmp u3xe_pa_out;
      u3xe_pa_bad_port:
        mov rax, 0xFFFFF7FB;

      u3xe_pa_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let u3xe_port_removed : (u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) (port_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): placeholder emit of port_removed. Labels prefixed u3xe_pr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        call u3xe_tunnel_valid;
        cmp rax, 0;
        je  u3xe_pr_bad_tunnel;

        mov rdi, rbx;
        call u3xe_find_by_slot;
        cmp rax, 0xFF;
        je  u3xe_pr_not_found;
        mov r13, rax;

        mov rdi, r13;
        call u3xe_row_xhci_base;
        mov r14, rax;
        cmp r12, r14;
        jb  u3xe_pr_bad_port;
        mov rdi, r13;
        call u3xe_row_count;
        add rax, r14;
        cmp r12, rax;
        jae u3xe_pr_bad_port;

        mov rdi, 3;                      // REMOVED
        call u3xe_note;
        xor rax, rax;
        jmp u3xe_pr_out;

      u3xe_pr_bad_tunnel:
        mov rax, 0xFFFFF7FE;
        jmp u3xe_pr_out;
      u3xe_pr_not_found:
        mov rax, 0xFFFFF7F8;
        jmp u3xe_pr_out;
      u3xe_pr_bad_port:
        mov rax, 0xFFFFF7FB;

      u3xe_pr_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // u3xe_binding_count — number of currently-bound rows.
  // ==========================================================================

  pub let u3xe_binding_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M10-001 (#1232): count in_use rows.",
      block: {
        push rbx;
        push r12;

        xor rbx, rbx;
        xor r12, r12;
      u3xe_bc_it:
        cmp r12, 4;
        jae u3xe_bc_done;
        mov rdi, r12;
        call u3xe_row_in_use;
        cmp rax, 0;
        je  u3xe_bc_next;
        add rbx, 1;
      u3xe_bc_next:
        add r12, 1;
        jmp u3xe_bc_it;
      u3xe_bc_done:
        mov rax, rbx;
        pop r12;
        pop rbx;
        ret
      }
    }
}
