// src/kernel/core/drivers/tb/sw_cm_cmdq.pdx — R35.M6-002 (#1220)
//
// Software Connection Manager (sw-CM) HOST-DRIVEN COMMAND QUEUE.
//
// The sw-CM chooses one of four commands whenever the topology, the
// policy or an operator action calls for a change in the connection
// state of a downstream point:
//
//   * SWCMD_PROBE_PATH        (0) — issue Read Router Config on a
//                                   candidate path.
//   * SWCMD_CONNECT_PORT      (1) — bring a specific port up to
//                                   NEGOTIATED.
//   * SWCMD_ESTABLISH_TUNNEL  (2) — allocate + program a tunnel
//                                   of a specific type on an
//                                   established port.
//   * SWCMD_TEAR_TUNNEL       (3) — release an established tunnel.
//
// These are the queue's SEMANTIC entries. The queue itself is a
// 32-slot ring buffer of (seq_tag, cmd_type, arg0, arg1) tuples. The
// PRODUCER is host code (the sw-CM scheduler, driven from cmdq
// callers such as the R42 supervisor or the R35.M3 tunnel
// sequencer); the CONSUMER is the cm_rings TX submitter (R35.M2 —
// tb_cm_tx_submit). The consumer translates each command into one
// or more CM control packets and drains this queue as it does so.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RING BUFFER + SEQUENCE COUNTER half of the command
// dispatch path. It:
//
//   1. RING — a 32-slot ring; each slot holds four u64 (seq_tag,
//      cmd_type, arg0, arg1). Producer + consumer indices with the
//      standard (prod+1) & MASK full-check.
//
//   2. SEQ TAGS — sw_cm_cmdq_enqueue stamps every command with a
//      monotone-increasing sequence number the caller can correlate
//      with a matching event later (see sw_cm_evtmux.pdx). Ties
//      per-command outcomes to their originating command without
//      requiring the caller to invent a naming scheme.
//
//   3. DRAIN — sw_cm_cmdq_dequeue takes one command off the head
//      and hands it to the caller for translation into a
//      tb_cm_tx_submit descriptor.
//
// IT DOES NOT ITSELF CALL tb_cm_tx_submit. Doing so from inside the
// dequeue would give this module DMA authority; that authority
// belongs to cm_rings alone. The consumer walks: dequeue -> pack
// descriptor -> tb_cm_tx_submit, and this scaffold ships only the
// first step.
//
// IT DOES NOT VALIDATE arg0 / arg1 SEMANTICALLY. Their meaning
// depends on cmd_type (a slot id for PROBE_PATH, a (slot,
// tunnel_type) pair for ESTABLISH_TUNNEL). The FSM (sw_cm_fsm.pdx)
// checks state legality; this module checks only cmd_type validity
// and ring-buffer occupancy.
//
// sw_cm_cmdq_arbitrated() returns 0 until the cm_rings TX submitter
// is bound as the queue's consumer.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _sw_cm_cmdq_ring, _sw_cm_cmdq_idx, _sw_cm_cmdq_seq and
// _sw_cm_cmdq_stats are written only by helpers in this module.
// tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/sw_cm_cmdq.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF8B0..0xFFFFF8BF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: sw_cm_fsm 0xFFFFF8C0..CF,
// sw_cm_evtmux 0xFFFFF8A0..AF, sw_cm_fw_interop 0xFFFFF890..9F).

module SwCmCmdq = structure {

  // Command ordinals.
  pub let SWCMD_PROBE_PATH       : u64 = 0
  pub let SWCMD_CONNECT_PORT     : u64 = 1
  pub let SWCMD_ESTABLISH_TUNNEL : u64 = 2
  pub let SWCMD_TEAR_TUNNEL      : u64 = 3
  pub let SWCMD_MAX              : u64 = 3

  // Ring geometry. Power of two -> modulo is mask.
  pub let SWCMDQ_SIZE : u64 = 32
  pub let SWCMDQ_MASK : u64 = 31

  // Per-slot layout: 4 u64 = 32 bytes.
  //   [+0]  seq_tag
  //   [+8]  cmd_type
  //   [+16] arg0
  //   [+24] arg1
  pub let SWCMDQ_SLOT_BYTES : u64 = 32

  // Failure taxonomy — 0xFFFFF8B0..0xFFFFF8BF.
  pub let SWCMDQ_OK        : u64 = 0
  pub let SWCMDQ_BAD_ARG   : u64 = 0xFFFFF8BF
  pub let SWCMDQ_BAD_TYPE  : u64 = 0xFFFFF8BE
  pub let SWCMDQ_FULL      : u64 = 0xFFFFF8BD
  pub let SWCMDQ_EMPTY     : u64 = 0xFFFFF8BC
  pub let SWCMDQ_BAD_INDEX : u64 = 0xFFFFF8BB

  pub let SWCMDQ_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Ring storage: 32 slots × 4 u64 = 128 u64.
  pub let mut _sw_cm_cmdq_ring  : [u64; 128] = uninit @align(64)
  // Indices: [0] = producer, [1] = consumer.
  pub let mut _sw_cm_cmdq_idx   : [u64; 2]   = uninit @align(16)
  // Sequence generator — monotonic across the boot.
  pub let mut _sw_cm_cmdq_seq   : [u64; 1]   = uninit @align(8)
  pub let mut _sw_cm_cmdq_stats : [u64; 8]   = uninit @align(64)

  pub let SWCMDQ_ST_ENQUEUED : u64 = 0
  pub let SWCMDQ_ST_DEQUEUED : u64 = 1
  pub let SWCMDQ_ST_FULL     : u64 = 2
  pub let SWCMDQ_ST_EMPTY    : u64 = 3
  pub let SWCMDQ_ST_REJECTS  : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let sw_cm_cmdq_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): clear ring, indices, seq and stats. Labels prefixed scqr_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _sw_cm_cmdq_ring];
      scqr_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  scqr_r;

        lea r10, [rip + _sw_cm_cmdq_idx];
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;

        lea r10, [rip + _sw_cm_cmdq_seq];
        mov [r10 + 0], rax;

        lea r10, [rip + _sw_cm_cmdq_stats];
        xor rcx, rcx;
      scqr_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  scqr_s;
        ret
      }
    } @no_frame

  pub let sw_cm_cmdq_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-002 (#1220): honesty pin. Returns 0 until the cm_rings TX submitter is bound as the queue's consumer.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sw_cm_cmdq_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): counter read.",
      block: {
        cmp rdi, 8;
        jae scqs_zero;
        lea r10, [rip + _sw_cm_cmdq_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      scqs_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let scq_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): counter bump. Labels prefixed scqn_.",
      block: {
        cmp rdi, 8;
        jae scqn_out;
        lea r10, [rip + _sw_cm_cmdq_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      scqn_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Index accessors — plain reads today, seams for MMIO tomorrow.
  // ==========================================================================

  pub let sw_cm_cmdq_prod : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): read producer index.",
      block: {
        lea r10, [rip + _sw_cm_cmdq_idx];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let sw_cm_cmdq_cons : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): read consumer index.",
      block: {
        lea r10, [rip + _sw_cm_cmdq_idx];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let sw_cm_cmdq_seq_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): read next-to-issue seq without incrementing.",
      block: {
        lea r10, [rip + _sw_cm_cmdq_seq];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Enqueue. Stamps a seq_tag; returns it in rax on success (never 0
  // on success — seq starts at 1). Refuses SWCMDQ_FULL if the ring
  // is full, SWCMDQ_BAD_TYPE if cmd_type is out of range.
  // ==========================================================================

  pub let sw_cm_cmdq_enqueue : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (cmd_type: u64) (arg0: u64) (arg1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): enqueue command. seq_tag returned on success. Labels prefixed scqe_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // cmd_type
        mov r12, rsi;                    // arg0
        mov r13, rdx;                    // arg1

        cmp rbx, 3;                      // SWCMD_MAX
        ja  scqe_bad_type;

        call sw_cm_cmdq_prod;
        mov r14, rax;                    // prod
        call sw_cm_cmdq_cons;
        mov r15, rax;                    // cons

        mov r10, r14;
        add r10, 1;
        and r10, 31;                     // SWCMDQ_MASK
        cmp r10, r15;
        je  scqe_full;

        // Bump sequence.
        lea r10, [rip + _sw_cm_cmdq_seq];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov r15, rax;                    // seq_tag

        // Write slot at r14.
        lea r10, [rip + _sw_cm_cmdq_ring];
        mov r11, r14;
        shl r11, 5;                      // 4 u64 = 32 bytes per slot
        add r10, r11;
        mov [r10 + 0], r15;              // seq_tag
        mov [r10 + 8], rbx;              // cmd_type
        mov [r10 + 16], r12;             // arg0
        mov [r10 + 24], r13;             // arg1

        // Advance producer.
        mov r10, r14;
        add r10, 1;
        and r10, 31;
        lea r11, [rip + _sw_cm_cmdq_idx];
        mov [r11 + 0], r10;

        mov rdi, 0;                      // ENQUEUED
        call scq_note;

        mov rax, r15;                    // return seq_tag
        jmp scqe_out;

      scqe_full:
        mov rdi, 2;                      // FULL
        call scq_note;
        mov rax, 0xFFFFF8BD;
        jmp scqe_out;
      scqe_bad_type:
        mov rdi, 4;
        call scq_note;
        mov rax, 0xFFFFF8BE;

      scqe_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Peek. Returns the slot the consumer would read on the next
  // dequeue, without advancing. Field accessor pattern lets a
  // caller read seq_tag / cmd_type / arg0 / arg1 without a large
  // return tuple.
  // ==========================================================================

  pub let sw_cm_cmdq_peek_field : (u64) -> u64 !{mem} @{} =
    fn (field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): read field at consumer position without advancing. field 0=seq_tag, 1=cmd_type, 2=arg0, 3=arg1. Empty -> DECODE_BAD. Labels prefixed scqp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // field
        cmp rbx, 3;
        ja  scqp_bad;

        call sw_cm_cmdq_prod;
        mov r12, rax;
        call sw_cm_cmdq_cons;
        mov r13, rax;

        cmp r12, r13;
        je  scqp_bad;

        lea r10, [rip + _sw_cm_cmdq_ring];
        mov r11, r13;
        shl r11, 5;
        add r10, r11;
        mov r11, rbx;
        shl r11, 3;                      // field * 8
        add r10, r11;
        mov rax, [r10];
        jmp scqp_out;

      scqp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      scqp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dequeue. Advances the consumer index. Returns seq_tag of the
  // dequeued command on success; SWCMDQ_EMPTY otherwise.
  // ==========================================================================

  pub let sw_cm_cmdq_dequeue : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-002 (#1220): dequeue one command. Returns seq_tag on success. Labels prefixed scqd_.",
      block: {
        push rbx;
        push r12;

        call sw_cm_cmdq_prod;
        mov rbx, rax;
        call sw_cm_cmdq_cons;
        mov r12, rax;

        cmp rbx, r12;
        je  scqd_empty;

        // Read seq_tag from slot at r12.
        lea r10, [rip + _sw_cm_cmdq_ring];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];              // seq_tag

        // Advance consumer.
        mov r10, r12;
        add r10, 1;
        and r10, 31;
        lea r11, [rip + _sw_cm_cmdq_idx];
        mov [r11 + 8], r10;

        push rax;
        mov rdi, 1;                      // DEQUEUED
        call scq_note;
        pop rax;

        jmp scqd_out;

      scqd_empty:
        mov rdi, 3;                      // EMPTY
        call scq_note;
        mov rax, 0xFFFFF8BC;

      scqd_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
