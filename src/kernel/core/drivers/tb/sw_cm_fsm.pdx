// src/kernel/core/drivers/tb/sw_cm_fsm.pdx — R35.M6-001 (#1219)
//
// Software Connection Manager (sw-CM) STATE MACHINE. Per D3 of
// design/roadmap/next-wave-synthesis.md, PaideiaOS commits to a
// software-CM path (Linux-style) rather than the firmware-CM
// dependency. The sw-CM decomposes the USB4 connection-management
// problem into three orthogonal per-slot state machines:
//
//   * PATH — the physical control path between the host NHI and a
//     downstream adapter's control transport. Sequence:
//       PATH_IDLE (0) -> PATH_PROBED (1) -> PATH_CONNECTED (2)
//       -> PATH_TORN (3)
//     A PROBED path has answered a Read Router Config; a CONNECTED
//     path has a live CM ring conversation; a TORN path has been
//     brought down and its resources released.
//
//   * PORT — a downstream adapter port. Sequence:
//       PORT_DISABLED (0) -> PORT_ENABLED (1) -> PORT_NEGOTIATED (2)
//       PORT_ERROR (3) is a sink accepting a jump from ENABLED or
//       NEGOTIATED on any USB4 protocol error.
//
//   * TUNNEL — a single logical tunnel (PCIe / DP / USB3) traversing
//     one path over one port. Sequence:
//       TUN_NONE (0) -> TUN_NEGOTIATING (1) -> TUN_ESTABLISHED (2)
//       -> TUN_TEARING (3) -> TUN_TORN (4)
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SLOT TABLE + TRANSITION VALIDATOR half of the software-CM
// substrate. It:
//
//   1. TABLES — three fixed 32-row arrays, one per tier, indexed by
//      slot. Slot 0..31 uniquely identifies a downstream point in the
//      topology; the correspondence is established by the cmdq/evtmux
//      caller (see sw_cm_cmdq.pdx / sw_cm_evtmux.pdx).
//
//   2. TRANSITIONS — sw_cm_fsm_path_transition,
//      sw_cm_fsm_port_transition, sw_cm_fsm_tunnel_transition each
//      validate against a per-tier legality table. An illegal
//      transition is REFUSED (SWFSM_BAD_TRANSITION) rather than
//      silently clamped: silence-on-illegal would let a lost RX event
//      (see sw_cm_evtmux.pdx) advance the FSM past a state it never
//      actually visited.
//
//   3. READ — sw_cm_fsm_path_state / _port_state / _tunnel_state
//      read the current state of a slot in its respective tier.
//
// IT DOES NOT ISSUE OR RECEIVE THE UNDERLYING USB4 CONTROL PACKETS.
// The cmdq module (sw_cm_cmdq.pdx) enqueues the packets that DRIVE
// transitions; the evtmux module (sw_cm_evtmux.pdx) demultiplexes RX
// responses and calls transition helpers here. This module owns only
// the state, not the transport.
//
// IT DOES NOT SPAN SLOTS. A tunnel transition on slot 3 has no effect
// on slot 4's tunnel state. Cross-slot ordering (e.g. tearing a
// port's tunnels before disabling the port) is the CALLER's
// responsibility. This is a deliberate choice: an FSM that quietly
// cascaded cross-slot transitions would obscure the topological
// cascade that R35.M3's route_teardown / R35.M4's consent_revoke
// sequencers already express explicitly.
//
// sw_cm_fsm_arbitrated() returns 0 until the R42 supervisor's live
// event stream is bound.
//
// =============================================================================
// §1  BOUNDED SLOT ID
// =============================================================================
//
// Slots are 0..31 inclusive. A slot >= 32 is BAD_SLOT rather than
// silently masked; a caller with a slot they cannot decode has a
// bookkeeping bug the FSM should surface, not paper over.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _sw_cm_path_states, _sw_cm_port_states, _sw_cm_tunnel_states and
// _sw_cm_fsm_stats are written only by helpers in this module.
// tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/sw_cm_fsm.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF8C0..0xFFFFF8CF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: sw_cm_cmdq 0xFFFFF8B0..BF,
// sw_cm_evtmux 0xFFFFF8A0..AF, sw_cm_fw_interop 0xFFFFF890..9F,
// dma_active_indicator 0xFFFFF8D0..DF).

module SwCmFsm = structure {

  // Tier tags — used by the counter table and by callers that want a
  // single dispatch entry.
  pub let SWFSM_TIER_PATH   : u64 = 0
  pub let SWFSM_TIER_PORT   : u64 = 1
  pub let SWFSM_TIER_TUNNEL : u64 = 2

  // Path states.
  pub let SWFSM_PATH_IDLE      : u64 = 0
  pub let SWFSM_PATH_PROBED    : u64 = 1
  pub let SWFSM_PATH_CONNECTED : u64 = 2
  pub let SWFSM_PATH_TORN      : u64 = 3
  pub let SWFSM_PATH_MAX       : u64 = 3

  // Port states.
  pub let SWFSM_PORT_DISABLED   : u64 = 0
  pub let SWFSM_PORT_ENABLED    : u64 = 1
  pub let SWFSM_PORT_NEGOTIATED : u64 = 2
  pub let SWFSM_PORT_ERROR      : u64 = 3
  pub let SWFSM_PORT_MAX        : u64 = 3

  // Tunnel states.
  pub let SWFSM_TUN_NONE        : u64 = 0
  pub let SWFSM_TUN_NEGOTIATING : u64 = 1
  pub let SWFSM_TUN_ESTABLISHED : u64 = 2
  pub let SWFSM_TUN_TEARING     : u64 = 3
  pub let SWFSM_TUN_TORN        : u64 = 4
  pub let SWFSM_TUN_MAX         : u64 = 4

  // Slot cap.
  pub let SWFSM_SLOT_MAX : u64 = 32

  // Failure taxonomy — 0xFFFFF8C0..0xFFFFF8CF.
  pub let SWFSM_OK              : u64 = 0
  pub let SWFSM_BAD_ARG         : u64 = 0xFFFFF8CF
  pub let SWFSM_BAD_SLOT        : u64 = 0xFFFFF8CE
  pub let SWFSM_BAD_STATE       : u64 = 0xFFFFF8CD
  pub let SWFSM_BAD_TIER        : u64 = 0xFFFFF8CC
  pub let SWFSM_BAD_TRANSITION  : u64 = 0xFFFFF8CB

  pub let SWFSM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Per-tier state tables.
  pub let mut _sw_cm_path_states   : [u64; 32] = uninit @align(64)
  pub let mut _sw_cm_port_states   : [u64; 32] = uninit @align(64)
  pub let mut _sw_cm_tunnel_states : [u64; 32] = uninit @align(64)
  pub let mut _sw_cm_fsm_stats     : [u64; 8]  = uninit @align(64)

  pub let SWFSM_ST_PATH_TRANS   : u64 = 0
  pub let SWFSM_ST_PORT_TRANS   : u64 = 1
  pub let SWFSM_ST_TUNNEL_TRANS : u64 = 2
  pub let SWFSM_ST_REJECTS      : u64 = 3
  pub let SWFSM_ST_LAST_SLOT    : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let sw_cm_fsm_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): clear all three tier tables and stats. Labels prefixed sfr_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _sw_cm_path_states];
        xor rcx, rcx;
      sfr_p:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  sfr_p;

        lea r10, [rip + _sw_cm_port_states];
        xor rcx, rcx;
      sfr_o:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  sfr_o;

        lea r10, [rip + _sw_cm_tunnel_states];
        xor rcx, rcx;
      sfr_t:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  sfr_t;

        lea r10, [rip + _sw_cm_fsm_stats];
        xor rcx, rcx;
      sfr_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sfr_s;
        ret
      }
    }

  pub let sw_cm_fsm_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-001 (#1219): honesty pin. Returns 0 until the R42 supervisor's live event stream is bound.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let sw_cm_fsm_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): counter read.",
      block: {
        cmp rdi, 8;
        jae sfs_zero;
        lea r10, [rip + _sw_cm_fsm_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      sfs_zero:
        xor rax, rax;
        ret
      }
    }

  pub let sf_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): counter bump. Labels prefixed sfn_.",
      block: {
        cmp rdi, 8;
        jae sfn_out;
        lea r10, [rip + _sw_cm_fsm_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      sfn_out:
        ret
      }
    }

  pub let sf_record_slot : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): stamp LAST_SLOT for diagnostics.",
      block: {
        lea r10, [rip + _sw_cm_fsm_stats];
        mov [r10 + 32], rdi;
        ret
      }
    }

  // ==========================================================================
  // Readers.
  // ==========================================================================

  pub let sw_cm_fsm_path_state : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): read path tier state. Labels prefixed spg_.",
      block: {
        cmp rdi, 32;
        jae spg_bad;
        lea r10, [rip + _sw_cm_path_states];
        mov rax, [r10 + rdi * 8];
        ret;
      spg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sw_cm_fsm_port_state : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): read port tier state. Labels prefixed spo_.",
      block: {
        cmp rdi, 32;
        jae spo_bad;
        lea r10, [rip + _sw_cm_port_states];
        mov rax, [r10 + rdi * 8];
        ret;
      spo_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let sw_cm_fsm_tunnel_state : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): read tunnel tier state. Labels prefixed stg_.",
      block: {
        cmp rdi, 32;
        jae stg_bad;
        lea r10, [rip + _sw_cm_tunnel_states];
        mov rax, [r10 + rdi * 8];
        ret;
      stg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Path transition legality:
  //   IDLE      -> PROBED
  //   PROBED    -> CONNECTED
  //   CONNECTED -> TORN
  //   PROBED    -> TORN
  //   TORN      -> IDLE          (recycle a slot after teardown)
  // Anything else refused BAD_TRANSITION.
  // ==========================================================================

  pub let sf_path_legal : (u64, u64) -> u64 !{} @{} =
    fn (from: u64) (to: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-001 (#1219): path legality table. Labels prefixed spl_.",
      block: {
        cmp rdi, 0;                      // IDLE -> PROBED
        jne spl_p_no;
        cmp rsi, 1;
        jne spl_deny;
        jmp spl_allow;
      spl_p_no:
        cmp rdi, 1;                      // PROBED -> CONNECTED|TORN
        jne spl_c_no;
        cmp rsi, 2;
        je  spl_allow;
        cmp rsi, 3;
        je  spl_allow;
        jmp spl_deny;
      spl_c_no:
        cmp rdi, 2;                      // CONNECTED -> TORN
        jne spl_t_no;
        cmp rsi, 3;
        je  spl_allow;
        jmp spl_deny;
      spl_t_no:
        cmp rdi, 3;                      // TORN -> IDLE
        jne spl_deny;
        cmp rsi, 0;
        je  spl_allow;
      spl_deny:
        xor rax, rax;
        ret;
      spl_allow:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // Port transition legality:
  //   DISABLED   -> ENABLED
  //   ENABLED    -> NEGOTIATED | ERROR | DISABLED
  //   NEGOTIATED -> DISABLED | ERROR
  //   ERROR      -> DISABLED    (recover by hard-cycling)
  // ==========================================================================

  pub let sf_port_legal : (u64, u64) -> u64 !{} @{} =
    fn (from: u64) (to: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-001 (#1219): port legality table. Labels prefixed sol_.",
      block: {
        cmp rdi, 0;                      // DISABLED -> ENABLED
        jne sol_e_no;
        cmp rsi, 1;
        je  sol_allow;
        jmp sol_deny;
      sol_e_no:
        cmp rdi, 1;                      // ENABLED -> NEGOTIATED|ERROR|DISABLED
        jne sol_n_no;
        cmp rsi, 2;
        je  sol_allow;
        cmp rsi, 3;
        je  sol_allow;
        cmp rsi, 0;
        je  sol_allow;
        jmp sol_deny;
      sol_n_no:
        cmp rdi, 2;                      // NEGOTIATED -> DISABLED|ERROR
        jne sol_r_no;
        cmp rsi, 0;
        je  sol_allow;
        cmp rsi, 3;
        je  sol_allow;
        jmp sol_deny;
      sol_r_no:
        cmp rdi, 3;                      // ERROR -> DISABLED
        jne sol_deny;
        cmp rsi, 0;
        je  sol_allow;
      sol_deny:
        xor rax, rax;
        ret;
      sol_allow:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // Tunnel transition legality:
  //   NONE        -> NEGOTIATING
  //   NEGOTIATING -> ESTABLISHED | TORN   (TORN on negotiation-abort)
  //   ESTABLISHED -> TEARING
  //   TEARING     -> TORN
  //   TORN        -> NONE                 (recycle)
  // ==========================================================================

  pub let sf_tunnel_legal : (u64, u64) -> u64 !{} @{} =
    fn (from: u64) (to: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M6-001 (#1219): tunnel legality table. Labels prefixed stl_.",
      block: {
        cmp rdi, 0;                      // NONE -> NEGOTIATING
        jne stl_n_no;
        cmp rsi, 1;
        je  stl_allow;
        jmp stl_deny;
      stl_n_no:
        cmp rdi, 1;                      // NEGOTIATING -> ESTABLISHED|TORN
        jne stl_e_no;
        cmp rsi, 2;
        je  stl_allow;
        cmp rsi, 4;
        je  stl_allow;
        jmp stl_deny;
      stl_e_no:
        cmp rdi, 2;                      // ESTABLISHED -> TEARING
        jne stl_g_no;
        cmp rsi, 3;
        je  stl_allow;
        jmp stl_deny;
      stl_g_no:
        cmp rdi, 3;                      // TEARING -> TORN
        jne stl_r_no;
        cmp rsi, 4;
        je  stl_allow;
        jmp stl_deny;
      stl_r_no:
        cmp rdi, 4;                      // TORN -> NONE
        jne stl_deny;
        cmp rsi, 0;
        je  stl_allow;
      stl_deny:
        xor rax, rax;
        ret;
      stl_allow:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // Transition primitives. Each: validate slot, validate to-state,
  // read from-state, check legality, write on OK, refuse otherwise.
  // ==========================================================================

  pub let sw_cm_fsm_path_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (to: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): path tier transition. Labels prefixed spt_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // to

        cmp rbx, 32;
        jae spt_bad_slot;
        cmp r12, 3;
        ja  spt_bad_state;

        lea r10, [rip + _sw_cm_path_states];
        mov rax, [r10 + rbx * 8];        // from
        mov rdi, rax;
        mov rsi, r12;
        call sf_path_legal;
        cmp rax, 0;
        je  spt_bad_trans;

        lea r10, [rip + _sw_cm_path_states];
        mov [r10 + rbx * 8], r12;

        mov rdi, 0;                      // PATH_TRANS
        call sf_note;
        mov rdi, rbx;
        call sf_record_slot;

        xor rax, rax;
        jmp spt_out;

      spt_bad_slot:
        mov rdi, 3;
        call sf_note;
        mov rax, 0xFFFFF8CE;
        jmp spt_out;
      spt_bad_state:
        mov rdi, 3;
        call sf_note;
        mov rax, 0xFFFFF8CD;
        jmp spt_out;
      spt_bad_trans:
        mov rdi, 3;
        call sf_note;
        mov rdi, rbx;
        call sf_record_slot;
        mov rax, 0xFFFFF8CB;

      spt_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sw_cm_fsm_port_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (to: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): port tier transition. Labels prefixed sot_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        cmp rbx, 32;
        jae sot_bad_slot;
        cmp r12, 3;
        ja  sot_bad_state;

        lea r10, [rip + _sw_cm_port_states];
        mov rax, [r10 + rbx * 8];
        mov rdi, rax;
        mov rsi, r12;
        call sf_port_legal;
        cmp rax, 0;
        je  sot_bad_trans;

        lea r10, [rip + _sw_cm_port_states];
        mov [r10 + rbx * 8], r12;

        mov rdi, 1;                      // PORT_TRANS
        call sf_note;
        mov rdi, rbx;
        call sf_record_slot;

        xor rax, rax;
        jmp sot_out;

      sot_bad_slot:
        mov rdi, 3;
        call sf_note;
        mov rax, 0xFFFFF8CE;
        jmp sot_out;
      sot_bad_state:
        mov rdi, 3;
        call sf_note;
        mov rax, 0xFFFFF8CD;
        jmp sot_out;
      sot_bad_trans:
        mov rdi, 3;
        call sf_note;
        mov rdi, rbx;
        call sf_record_slot;
        mov rax, 0xFFFFF8CB;

      sot_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let sw_cm_fsm_tunnel_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (to: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M6-001 (#1219): tunnel tier transition. Labels prefixed stt_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        cmp rbx, 32;
        jae stt_bad_slot;
        cmp r12, 4;
        ja  stt_bad_state;

        lea r10, [rip + _sw_cm_tunnel_states];
        mov rax, [r10 + rbx * 8];
        mov rdi, rax;
        mov rsi, r12;
        call sf_tunnel_legal;
        cmp rax, 0;
        je  stt_bad_trans;

        lea r10, [rip + _sw_cm_tunnel_states];
        mov [r10 + rbx * 8], r12;

        mov rdi, 2;                      // TUNNEL_TRANS
        call sf_note;
        mov rdi, rbx;
        call sf_record_slot;

        xor rax, rax;
        jmp stt_out;

      stt_bad_slot:
        mov rdi, 3;
        call sf_note;
        mov rax, 0xFFFFF8CE;
        jmp stt_out;
      stt_bad_state:
        mov rdi, 3;
        call sf_note;
        mov rax, 0xFFFFF8CD;
        jmp stt_out;
      stt_bad_trans:
        mov rdi, 3;
        call sf_note;
        mov rdi, rbx;
        call sf_record_slot;
        mov rax, 0xFFFFF8CB;

      stt_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
