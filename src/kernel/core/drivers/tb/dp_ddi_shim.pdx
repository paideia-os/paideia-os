// src/kernel/core/drivers/tb/dp_ddi_shim.pdx — R35.M9-001 (#1229)
//
// TB4 DP-TUNNEL <-> VIRTUAL DDI SHIM (R36 hand-off point).
//
// dp_tunnel.pdx (R35.M3) allocates a virtual DDI slot number in the
// range [DP_DDI_TB_BASE, DP_DDI_TB_BASE + DP_DDI_MAX) at tunnel
// establishment. That number is a shape, not a bridge — R36's display
// supervisor will consume KIND_DISPLAY_OUTPUT rows, and it needs to
// know which DDI ordinal maps to which live TB4 tunnel slot and, when
// the display panel presents itself as an MST stream at the far end of
// a DP branch, which stream on that DDI belongs to which client.
//
// This module is the ROWS that carry those associations, and the pair
// of placeholder events (ddi_appeared / ddi_removed) that R36 will
// consume once KIND_DISPLAY_OUTPUT lands. R35 CLOSES WITHOUT
// KIND_DISPLAY_OUTPUT — that kind opens R36 — so this shim is the
// LAST kernel-side surface across the tunnel/display boundary that
// belongs in R35, and the FIRST surface across it that R36 reads.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ASSOCIATION HALF of the DP-tunnel to virtual-DDI mapping:
//
//   1. RECORD — dpddi_record(tunnel_slot, ddi_index, mst_stream_id)
//      stamps a row associating a TB4 tunnel_slot (as returned by the
//      arbiter / dp_tunnel_ddi_alloc) with a DDI ordinal in [0, 3]
//      and, for MST panels, an MST stream id in [0, 63]. For the
//      single-stream (SST) case, mst_stream_id is DPDDI_STREAM_SST.
//      Sets status = DPDDI_STATUS_APPEARED and bumps the APPEARED
//      counter. Refuses malformed inputs (BAD_TUNNEL_SLOT, BAD_DDI,
//      BAD_STREAM), DUP if a row with the same (ddi_index, stream)
//      already exists, and ENOSPC when the fixed table is full.
//
//   2. REMOVE — dpddi_remove(tunnel_slot) clears the row keyed by
//      tunnel_slot and sets status = DPDDI_STATUS_REMOVED. Refuses
//      NOT_FOUND. Bumps the REMOVED counter.
//
//   3. LOOKUP — dpddi_find_by_slot(tunnel_slot) returns the row index
//      or ROW_NONE. dpddi_find_by_ddi(ddi_index, mst_stream_id)
//      returns the row index of the (ddi, stream) tuple's holder or
//      ROW_NONE.
//
// The two event placeholders — dpddi_event_appeared() and
// dpddi_event_removed() — are counter-only for R35: they bump the
// APPEARED / REMOVED counters in a way an R36 subscriber can observe
// through dpddi_stat(). R36 replaces the counter bump with a fanout
// through display_topology_channel once KIND_DISPLAY_OUTPUT lands.
// Both entry points are IDEMPOTENT with respect to the ROW state that
// dpddi_record / dpddi_remove already mutated — they only emit the
// notification.
//
// IT DOES NOT MINT KIND_DISPLAY_OUTPUT. That is R36's authority.
// A future dpddi_record_bind(row_id, kind_display_output_cap) will
// bind the row to a minted capability once the kind exists.
//
// IT DOES NOT ALLOCATE THE VIRTUAL DDI. That is dp_tunnel.pdx's job
// (dp_tunnel_ddi_alloc). This shim is downstream — it consumes the
// number dp_tunnel returned and pairs it with an MST stream id.
//
// IT DOES NOT DECIDE MST vs SST. Whether the panel presented itself as
// SST or as an MST branch head is determined by DPCD read at bring-up;
// this shim just carries the stream id the caller chose. For SST,
// mst_stream_id is DPDDI_STREAM_SST (which is 0xFF, distinguishable
// from any legal MST stream in [0, 63]).
//
// dpddi_arbitrated() returns 0 until R36's display supervisor binds
// this module against real KIND_DISPLAY_OUTPUT consumers.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _dpddi_rows and _dpddi_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/dp_ddi_shim.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF820..0xFFFFF82F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dp_hotplug_bridge 0xFFFFF800..
// 0F, dp_aux_passthru 0xFFFFF810..1F, tunnel_priority 0xFFFFF830..3F).

module DpDdiShim = structure {

  // Row / capacity constants.
  pub let DPDDI_ROW_MAX     : u64 = 4              // one per virtual DDI
  pub let DPDDI_ROW_U64     : u64 = 8              // 8 u64s per row (64 bytes)

  // DDI ordinal range (mirrors dp_tunnel.pdx DP_DDI_MAX).
  pub let DPDDI_DDI_MAX     : u64 = 4              // 0..3 legal

  // MST stream id range (per DP 2.1 §2.6 MST payload IDs are 1..63,
  // but we permit 0 as a legal id and DPDDI_STREAM_SST = 0xFF for the
  // single-stream case).
  pub let DPDDI_STREAM_MAX  : u64 = 63             // 0..63 legal
  pub let DPDDI_STREAM_SST  : u64 = 0xFF           // sentinel for SST

  // Tunnel slot cap. dp_tunnel.pdx has DP_DDI_MAX = 4 tunnel slots
  // today; carry an 8-bit u8 range to leave room for growth.
  pub let DPDDI_TUNNEL_MAX  : u64 = 0xFF

  // Status ordinals.
  pub let DPDDI_STATUS_FREE     : u64 = 0
  pub let DPDDI_STATUS_APPEARED : u64 = 1
  pub let DPDDI_STATUS_REMOVED  : u64 = 2

  // Failure taxonomy — 0xFFFFF820..0xFFFFF82F.
  pub let DPDDI_OK              : u64 = 0
  pub let DPDDI_BAD_ARG         : u64 = 0xFFFFF82F
  pub let DPDDI_BAD_TUNNEL_SLOT : u64 = 0xFFFFF82E
  pub let DPDDI_BAD_DDI         : u64 = 0xFFFFF82D
  pub let DPDDI_BAD_STREAM      : u64 = 0xFFFFF82C
  pub let DPDDI_DUP             : u64 = 0xFFFFF82B
  pub let DPDDI_ENOSPC          : u64 = 0xFFFFF82A
  pub let DPDDI_NOT_FOUND       : u64 = 0xFFFFF829

  pub let DPDDI_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DPDDI_ROW_NONE   : u64 = 0xFF

  // Row (8 u64s, 64 bytes):
  //   [+0]  in_use  (0/1)
  //   [+8]  tunnel_slot
  //   [+16] ddi_index
  //   [+24] mst_stream_id
  //   [+32] status
  //   [+40] reserved
  //   [+48] reserved
  //   [+56] reserved
  pub let mut _dpddi_rows  : [u64; 32] = uninit @align(64)   // 4 rows × 8 u64
  pub let mut _dpddi_stats : [u64; 8]  = uninit @align(64)

  pub let DPDDI_ST_APPEARED  : u64 = 0
  pub let DPDDI_ST_REMOVED   : u64 = 1
  pub let DPDDI_ST_RECORDS   : u64 = 2
  pub let DPDDI_ST_REJECTS   : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dpddi_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): clear rows + stats. Labels prefixed dpddi_rs_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _dpddi_rows];
      dpddi_rs_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  dpddi_rs_r;

        xor rcx, rcx;
        lea r10, [rip + _dpddi_stats];
      dpddi_rs_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dpddi_rs_s;
        ret
      }
    } @no_frame

  pub let dpddi_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-001 (#1229): honesty pin. Returns 0 until R36's display supervisor binds this against real KIND_DISPLAY_OUTPUT consumers.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): counter read.",
      block: {
        cmp rdi, 8;
        jae dpddi_st_zero;
        lea r10, [rip + _dpddi_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dpddi_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): counter bump. Labels prefixed dpddi_nt_.",
      block: {
        cmp rdi, 8;
        jae dpddi_nt_out;
        lea r10, [rip + _dpddi_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dpddi_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row helpers. Row byte offset = slot * 64 = slot << 6.
  // ==========================================================================

  pub let dpddi_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): read row.in_use.",
      block: {
        cmp rdi, 4;
        jae dpddi_ri_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpddi_rows];
        add r10, rbx;
        mov rax, [r10 + 0];
        pop rbx;
        ret;
      dpddi_ri_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_row_tunnel : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): read row.tunnel_slot.",
      block: {
        cmp rdi, 4;
        jae dpddi_rt_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpddi_rows];
        add r10, rbx;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      dpddi_rt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_row_ddi : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): read row.ddi_index.",
      block: {
        cmp rdi, 4;
        jae dpddi_rd_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpddi_rows];
        add r10, rbx;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      dpddi_rd_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_row_stream : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): read row.mst_stream_id.",
      block: {
        cmp rdi, 4;
        jae dpddi_rm_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpddi_rows];
        add r10, rbx;
        mov rax, [r10 + 24];
        pop rbx;
        ret;
      dpddi_rm_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_row_status : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): read row.status.",
      block: {
        cmp rdi, 4;
        jae dpddi_rst_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 6;
        lea r10, [rip + _dpddi_rows];
        add r10, rbx;
        mov rax, [r10 + 32];
        pop rbx;
        ret;
      dpddi_rst_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dpddi_tunnel_valid : (u64) -> u64 !{} @{} =
    fn (ts: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-001 (#1229): 1 iff ts fits in u8.",
      block: {
        cmp rdi, 0xFF;
        ja  dpddi_tv_no;
        mov rax, 1;
        ret;
      dpddi_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_ddi_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-001 (#1229): 1 iff d in [0, 3].",
      block: {
        cmp rdi, 3;
        ja  dpddi_dv_no;
        mov rax, 1;
        ret;
      dpddi_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let dpddi_stream_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-001 (#1229): 1 iff s in [0, 63] or s == DPDDI_STREAM_SST (0xFF).",
      block: {
        cmp rdi, 0xFF;
        je  dpddi_sv_yes;
        cmp rdi, 63;
        ja  dpddi_sv_no;
      dpddi_sv_yes:
        mov rax, 1;
        ret;
      dpddi_sv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // dpddi_find_by_slot(tunnel_slot) — locate row by tunnel_slot.
  // ==========================================================================

  pub let dpddi_find_by_slot : (u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): scan for row whose tunnel_slot == arg. Labels prefixed dpddi_fs_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        xor r12, r12;
      dpddi_fs_scan:
        cmp r12, 4;
        jae dpddi_fs_none;
        mov rdi, r12;
        call dpddi_row_in_use;
        cmp rax, 0;
        je  dpddi_fs_next;
        mov rdi, r12;
        call dpddi_row_tunnel;
        cmp rax, rbx;
        je  dpddi_fs_hit;
      dpddi_fs_next:
        add r12, 1;
        jmp dpddi_fs_scan;
      dpddi_fs_hit:
        mov rax, r12;
        pop r12;
        pop rbx;
        ret;
      dpddi_fs_none:
        mov rax, 0xFF;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpddi_find_by_ddi(ddi_index, mst_stream_id) — locate row by
  // (ddi_index, mst_stream_id) tuple. Uniqueness of the tuple is a
  // record-time invariant, so at most one row matches.
  // ==========================================================================

  pub let dpddi_find_by_ddi : (u64, u64) -> u64 !{mem} @{} =
    fn (ddi_index: u64) (mst_stream_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): scan for row whose (ddi, stream) == (arg, arg). Labels prefixed dpddi_fd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // ddi
        mov r12, rsi;                    // stream
        xor r13, r13;

      dpddi_fd_scan:
        cmp r13, 4;
        jae dpddi_fd_none;
        mov rdi, r13;
        call dpddi_row_in_use;
        cmp rax, 0;
        je  dpddi_fd_next;
        mov rdi, r13;
        call dpddi_row_ddi;
        cmp rax, rbx;
        jne dpddi_fd_next;
        mov rdi, r13;
        call dpddi_row_stream;
        cmp rax, r12;
        je  dpddi_fd_hit;
      dpddi_fd_next:
        add r13, 1;
        jmp dpddi_fd_scan;
      dpddi_fd_hit:
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      dpddi_fd_none:
        mov rax, 0xFF;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpddi_record(tunnel_slot, ddi_index, mst_stream_id).
  //
  // Sequence:
  //   1. tunnel_slot fits u8               (BAD_TUNNEL_SLOT)
  //   2. ddi_index in [0, 3]               (BAD_DDI)
  //   3. mst_stream_id in [0, 63] or SST   (BAD_STREAM)
  //   4. no existing row for tunnel_slot   (DUP)
  //   5. no existing row for (ddi, stream) (DUP)
  //   6. allocate free row                 (ENOSPC)
  //   7. commit; APPEARED status; APPEARED counter bump
  // ==========================================================================

  pub let dpddi_record : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) (ddi_index: u64) (mst_stream_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): stamp a DP-tunnel-to-DDI row and emit ddi_appeared. Labels prefixed dpddi_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // tunnel_slot
        mov r12, rsi;                    // ddi
        mov r13, rdx;                    // stream

        mov rdi, rbx;
        call dpddi_tunnel_valid;
        cmp rax, 0;
        je  dpddi_rc_bad_tunnel;

        mov rdi, r12;
        call dpddi_ddi_valid;
        cmp rax, 0;
        je  dpddi_rc_bad_ddi;

        mov rdi, r13;
        call dpddi_stream_valid;
        cmp rax, 0;
        je  dpddi_rc_bad_stream;

        mov rdi, rbx;
        call dpddi_find_by_slot;
        cmp rax, 0xFF;
        jne dpddi_rc_dup;

        mov rdi, r12;
        mov rsi, r13;
        call dpddi_find_by_ddi;
        cmp rax, 0xFF;
        jne dpddi_rc_dup;

        // Scan for free row.
        xor r14, r14;
      dpddi_rc_scan:
        cmp r14, 4;
        jae dpddi_rc_full;
        mov rdi, r14;
        call dpddi_row_in_use;
        cmp rax, 0;
        je  dpddi_rc_free;
        add r14, 1;
        jmp dpddi_rc_scan;

      dpddi_rc_free:
        mov r15, r14;
        shl r15, 6;
        lea r10, [rip + _dpddi_rows];
        add r10, r15;
        mov rax, 1;
        mov [r10 + 0], rax;
        mov [r10 + 8], rbx;
        mov [r10 + 16], r12;
        mov [r10 + 24], r13;
        mov rax, 1;                      // APPEARED
        mov [r10 + 32], rax;
        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 2;                      // RECORDS
        call dpddi_note;
        mov rdi, 0;                      // APPEARED
        call dpddi_note;
        xor rax, rax;
        jmp dpddi_rc_out;

      dpddi_rc_bad_tunnel:
        mov rdi, 3;                      // REJECTS
        call dpddi_note;
        mov rax, 0xFFFFF82E;
        jmp dpddi_rc_out;
      dpddi_rc_bad_ddi:
        mov rdi, 3;
        call dpddi_note;
        mov rax, 0xFFFFF82D;
        jmp dpddi_rc_out;
      dpddi_rc_bad_stream:
        mov rdi, 3;
        call dpddi_note;
        mov rax, 0xFFFFF82C;
        jmp dpddi_rc_out;
      dpddi_rc_dup:
        mov rdi, 3;
        call dpddi_note;
        mov rax, 0xFFFFF82B;
        jmp dpddi_rc_out;
      dpddi_rc_full:
        mov rdi, 3;
        call dpddi_note;
        mov rax, 0xFFFFF82A;

      dpddi_rc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpddi_remove(tunnel_slot).
  // ==========================================================================

  pub let dpddi_remove : (u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): clear a DP-tunnel-to-DDI row and emit ddi_removed. Labels prefixed dpddi_rm_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        mov rdi, rbx;
        call dpddi_tunnel_valid;
        cmp rax, 0;
        je  dpddi_rm_bad_tunnel;

        mov rdi, rbx;
        call dpddi_find_by_slot;
        cmp rax, 0xFF;
        je  dpddi_rm_not_found;
        mov r12, rax;

        mov r13, r12;
        shl r13, 6;
        lea r10, [rip + _dpddi_rows];
        add r10, r13;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov rax, 2;                      // REMOVED status
        mov [r10 + 32], rax;
        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rdi, 1;                      // REMOVED counter
        call dpddi_note;
        xor rax, rax;
        jmp dpddi_rm_out;

      dpddi_rm_bad_tunnel:
        mov rdi, 3;
        call dpddi_note;
        mov rax, 0xFFFFF82E;
        jmp dpddi_rm_out;
      dpddi_rm_not_found:
        mov rdi, 3;
        call dpddi_note;
        mov rax, 0xFFFFF829;

      dpddi_rm_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Placeholder event emitters. R36 replaces the counter bump with a
  // fanout through display_topology_channel once KIND_DISPLAY_OUTPUT
  // lands. Both bump the corresponding counter and return 0.
  // ==========================================================================

  pub let dpddi_event_appeared : (u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) (ddi_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): placeholder emit of ddi_appeared. Refuses BAD_TUNNEL_SLOT / BAD_DDI. Labels prefixed dpddi_ea_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        call dpddi_tunnel_valid;
        cmp rax, 0;
        je  dpddi_ea_bad_tunnel;
        mov rdi, r12;
        call dpddi_ddi_valid;
        cmp rax, 0;
        je  dpddi_ea_bad_ddi;

        mov rdi, 0;                      // APPEARED
        call dpddi_note;
        xor rax, rax;
        jmp dpddi_ea_out;

      dpddi_ea_bad_tunnel:
        mov rax, 0xFFFFF82E;
        jmp dpddi_ea_out;
      dpddi_ea_bad_ddi:
        mov rax, 0xFFFFF82D;

      dpddi_ea_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dpddi_event_removed : (u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_slot: u64) (ddi_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): placeholder emit of ddi_removed. Refuses BAD_TUNNEL_SLOT / BAD_DDI. Labels prefixed dpddi_er_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;
        mov r12, rsi;

        mov rdi, rbx;
        call dpddi_tunnel_valid;
        cmp rax, 0;
        je  dpddi_er_bad_tunnel;
        mov rdi, r12;
        call dpddi_ddi_valid;
        cmp rax, 0;
        je  dpddi_er_bad_ddi;

        mov rdi, 1;                      // REMOVED
        call dpddi_note;
        xor rax, rax;
        jmp dpddi_er_out;

      dpddi_er_bad_tunnel:
        mov rax, 0xFFFFF82E;
        jmp dpddi_er_out;
      dpddi_er_bad_ddi:
        mov rax, 0xFFFFF82D;

      dpddi_er_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dpddi_row_count — number of currently-active rows.
  // ==========================================================================

  pub let dpddi_row_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-001 (#1229): count in_use rows.",
      block: {
        push rbx;
        push r12;

        xor rbx, rbx;                    // count
        xor r12, r12;                    // iterator
      dpddi_rc_it:
        cmp r12, 4;
        jae dpddi_rc_done;
        mov rdi, r12;
        call dpddi_row_in_use;
        cmp rax, 0;
        je  dpddi_rc_it_next;
        add rbx, 1;
      dpddi_rc_it_next:
        add r12, 1;
        jmp dpddi_rc_it;
      dpddi_rc_done:
        mov rax, rbx;
        pop r12;
        pop rbx;
        ret
      }
    }
}
