// src/kernel/core/drivers/tb/nhi_probe.pdx — R35.M2-001 (#1200)
//
// TB4 / USB4 Native Host Interface (NHI) PCIe probe + BAR mapping
// scaffold. Recognises the USB4 host interface class code (0x0C 0x03
// 0x40), filters candidates by vendor (Intel 0x8086), and decodes
// the NHI capability register into ring count + port count — all
// through a synthetic seam this milestone.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNISE + RECORD half of a Thunderbolt / USB4 bring-up.
// A PCIe function whose class/subclass/prog-if triple is
// (0x0C, 0x03, 0x40) is a USB4 Host Interface per the PCI SIG's own
// registry; this scaffold's job is to match that shape, distill the
// vendor / device pair the enumerator saw, and stash the two NHI
// capability values a later round consults when it wires the CM
// rings.
//
// IT DOES NOT TOUCH REAL MMIO. The NHI capability register (ring
// count at NHI_CAP_0[3:0], port count at NHI_CAP_0[11:4]) is read
// through a seam whose default backing is caller-supplied register
// snapshots. A later round wires that seam to the BAR0 window.
//
// IT DOES NOT DERIVE A KIND_OP_REGION. That is the mint gate the
// bring-up path takes once the BAR is measured through a live memory
// authority; this scaffold records the EXTENT so that mint can
// containment-check its request without asking the firmware again.
//
// tb_nhi_probe_arbitrated() returns 0 until that binding lands.
//
// =============================================================================
// §1  PCI CLASSIFICATION (PCI SIG code registry)
// =============================================================================
//
//   base class 0x0C  Serial Bus Controller
//   subclass  0x03  USB Controller
//   prog if   0x40  USB4 Host Interface
//
// Vendor filter: 0x8086 (Intel) — the only shipping vendor of the
// on-die NHI at this milestone. A future revision that adds AMD or
// a discrete NHI extends the accepted-vendor set at
// tb_nhi_vendor_valid; nothing in this scaffold hard-codes Intel
// device ids.
//
// BAR0 alignment: 64 KB is the PCIe-mandated minimum for a USB4
// controller (USB4 §11.6.1). The probe refuses a BAR whose masked
// base is not 64 KB aligned as MISALIGNED rather than clipping it.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _tb_nhi_probe_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/tb/nhi_probe.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFF9E0..0xFFFFF9EF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: tb_domain 0xFFFFF9F0..FF,
// tb_cm_rings 0xFFFFF9D0..DF, tb_router_walk 0xFFFFF9C0..CF,
// tb_topology_channel 0xFFFFF9B0..BF).

module NhiProbe = structure {

  // PCI classification (§1).
  pub let PCI_CLASS_SERIAL_BUS   : u64 = 0x0C
  pub let PCI_SUBCLASS_USB       : u64 = 0x03
  pub let PCI_PROGIF_USB4_HOSTIF : u64 = 0x40

  // Class triple packed as (class << 16) | (subclass << 8) | progif.
  pub let PCI_CLASS_TRIPLE_USB4  : u64 = 0x0C0340

  // Accepted vendor set.
  pub let TB_NHI_VENDOR_INTEL : u64 = 0x8086

  // Alignment (§1).
  pub let TB_NHI_BAR_ALIGN_LOG2 : u64 = 16          // 64 KB
  pub let TB_NHI_BAR_ALIGN_MASK : u64 = 0xFFFF

  // NHI capability layout (USB4 §11.6.1).
  pub let TB_NHI_CAP0_RING_MASK  : u64 = 0x000F
  pub let TB_NHI_CAP0_PORT_MASK  : u64 = 0x0FF0
  pub let TB_NHI_CAP0_PORT_SHIFT : u64 = 4

  // BAR extent minimum (64 KB).
  pub let TB_NHI_BAR_MIN_LEN : u64 = 0x10000

  // Failure taxonomy — 0xFFFFF9E0..0xFFFFF9EF.
  pub let TB_NHI_OK           : u64 = 0
  pub let TB_NHI_BAD_ARG      : u64 = 0xFFFFF9EF
  pub let TB_NHI_BAD_CLASS    : u64 = 0xFFFFF9EE
  pub let TB_NHI_BAD_VENDOR   : u64 = 0xFFFFF9ED
  pub let TB_NHI_BAD_BAR      : u64 = 0xFFFFF9EC
  pub let TB_NHI_MISALIGNED   : u64 = 0xFFFFF9EB
  pub let TB_NHI_BAD_CAP0     : u64 = 0xFFFFF9EA
  pub let TB_NHI_NO_RINGS     : u64 = 0xFFFFF9E9
  pub let TB_NHI_NO_PORTS     : u64 = 0xFFFFF9E8

  pub let mut _tb_nhi_probe_stats : [u64; 8] = uninit @align(64)

  pub let TB_NHI_ST_ATTEMPTS : u64 = 0
  pub let TB_NHI_ST_MATCHED  : u64 = 1
  pub let TB_NHI_ST_REJECTS  : u64 = 2
  pub let TB_NHI_ST_ALIGNED  : u64 = 3
  pub let TB_NHI_ST_RINGS    : u64 = 4
  pub let TB_NHI_ST_PORTS    : u64 = 5

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let tb_nhi_probe_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-001 (#1200): clear stats. Labels prefixed tnp_rs_.",
      block: {
        lea r10, [rip + _tb_nhi_probe_stats];
        xor rax, rax;
        xor rcx, rcx;
      tnp_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tnp_rs_loop;
        ret
      }
    }

  pub let tb_nhi_probe_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-001 (#1200): honesty pin. Returns 0 until a later round binds this against a live PCIe NHI BAR window.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let tb_nhi_probe_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-001 (#1200): counter read. Labels prefixed tnp_st_.",
      block: {
        cmp rdi, 8;
        jae tnp_st_zero;
        lea r10, [rip + _tb_nhi_probe_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tnp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let tb_nhi_probe_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-001 (#1200): counter bump. Labels prefixed tnp_nt_.",
      block: {
        cmp rdi, 8;
        jae tnp_nt_out;
        lea r10, [rip + _tb_nhi_probe_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tnp_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let tb_nhi_class_valid : (u64) -> u64 !{} @{} =
    fn (class_triple: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-001 (#1200): 1 iff class_triple == 0x0C0340 (USB4 host interface). Labels prefixed tnp_cv_.",
      block: {
        mov r10, 0x0C0340;
        cmp rdi, r10;
        jne tnp_cv_no;
        mov rax, 1;
        ret;
      tnp_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_nhi_vendor_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-001 (#1200): 1 iff v in {0x8086 Intel}. A discrete-NHI vendor added later joins here rather than in the mint. Labels prefixed tnp_vv_.",
      block: {
        cmp rdi, 0x8086;
        je  tnp_vv_yes;
        xor rax, rax;
        ret;
      tnp_vv_yes:
        mov rax, 1;
        ret
      }
    }

  pub let tb_nhi_bar_aligned : (u64) -> u64 !{} @{} =
    fn (bar_base: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-001 (#1200): 1 iff (bar_base & 0xFFFF) == 0 (64 KB alignment). Labels prefixed tnp_ba_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        cmp rax, 0;
        jne tnp_ba_no;
        mov rax, 1;
        ret;
      tnp_ba_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Decode NHI capability word.
  //
  //   cap0[3:0]   ring count
  //   cap0[11:4]  port count
  //
  // A cap0 with zero rings or zero ports is a controller nothing can
  // use — refused as NO_RINGS / NO_PORTS rather than recorded.
  // ==========================================================================

  pub let tb_nhi_decode_rings : (u64) -> u64 !{} @{} =
    fn (cap0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-001 (#1200): decode ring count from cap0[3:0]. Labels prefixed tnp_dr_.",
      block: {
        mov rax, rdi;
        and rax, 0x000F;
        ret
      }
    }

  pub let tb_nhi_decode_ports : (u64) -> u64 !{} @{} =
    fn (cap0: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-001 (#1200): decode port count from cap0[11:4]. Labels prefixed tnp_dp_.",
      block: {
        mov rax, rdi;
        shr rax, 4;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // tb_nhi_probe_recognise(class_triple, vendor, bar_base, bar_len, cap0)
  //                       -> rings[7:0] | ports[15:8] | err
  //
  // Sequence:
  //   1. Class triple = 0x0C0340
  //   2. Vendor in accepted set
  //   3. bar_base > 0 and bar_len >= 64 KB
  //   4. bar_base 64 KB aligned
  //   5. cap0 non-zero
  //   6. Rings > 0
  //   7. Ports > 0
  //
  // Every accepted probe bumps MATCHED and the per-field counters
  // (ALIGNED, RINGS, PORTS). Every refusal bumps REJECTS.
  // ==========================================================================

  pub let tb_nhi_probe_recognise : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (class_triple: u64) (vendor: u64) (bar_base: u64) (bar_len: u64) (cap0: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-001 (#1200): recognise a USB4 NHI. Args stashed to callee-save regs before any call. Sequence: class triple; vendor; bar_base > 0 + bar_len >= 64 KB; alignment; cap0 non-zero; rings > 0; ports > 0. Returns rings[7:0] | ports[15:8]. Labels prefixed tnp_rc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // class_triple
        mov r12, rsi;                    // vendor
        mov r13, rdx;                    // bar_base
        mov r14, rcx;                    // bar_len
        mov r15, r8;                     // cap0

        mov rdi, 0;                      // ATTEMPTS
        call tb_nhi_probe_note;

        // 1. Class triple.
        mov rdi, rbx;
        call tb_nhi_class_valid;
        cmp rax, 0;
        je  tnp_rc_bad_class;

        // 2. Vendor.
        mov rdi, r12;
        call tb_nhi_vendor_valid;
        cmp rax, 0;
        je  tnp_rc_bad_vendor;

        // 3. BAR base and length.
        cmp r13, 0;
        je  tnp_rc_bad_bar;
        mov r10, 0x10000;                // 64 KB
        cmp r14, r10;
        jb  tnp_rc_bad_bar;

        // 4. Alignment.
        mov rdi, r13;
        call tb_nhi_bar_aligned;
        cmp rax, 0;
        je  tnp_rc_misaligned;
        mov rdi, 3;                      // ALIGNED
        call tb_nhi_probe_note;

        // 5. cap0 non-zero.
        cmp r15, 0;
        je  tnp_rc_bad_cap0;

        // 6. Rings.
        mov rdi, r15;
        call tb_nhi_decode_rings;
        cmp rax, 0;
        je  tnp_rc_no_rings;
        mov rbx, rax;                    // rings (reuse rbx now that class check is done)
        mov rdi, 4;                      // RINGS
        call tb_nhi_probe_note;

        // 7. Ports.
        mov rdi, r15;
        call tb_nhi_decode_ports;
        cmp rax, 0;
        je  tnp_rc_no_ports;
        mov r12, rax;                    // ports (reuse r12)
        mov rdi, 5;                      // PORTS
        call tb_nhi_probe_note;

        // MATCHED.
        mov rdi, 1;
        call tb_nhi_probe_note;

        // Pack rings | (ports << 8).
        mov rax, rbx;
        and rax, 0xFF;
        mov r10, r12;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        jmp tnp_rc_out;

      tnp_rc_bad_class:
        mov rdi, 2;
        call tb_nhi_probe_note;
        mov rax, 0xFFFFF9EE;
        jmp tnp_rc_out;
      tnp_rc_bad_vendor:
        mov rdi, 2;
        call tb_nhi_probe_note;
        mov rax, 0xFFFFF9ED;
        jmp tnp_rc_out;
      tnp_rc_bad_bar:
        mov rdi, 2;
        call tb_nhi_probe_note;
        mov rax, 0xFFFFF9EC;
        jmp tnp_rc_out;
      tnp_rc_misaligned:
        mov rdi, 2;
        call tb_nhi_probe_note;
        mov rax, 0xFFFFF9EB;
        jmp tnp_rc_out;
      tnp_rc_bad_cap0:
        mov rdi, 2;
        call tb_nhi_probe_note;
        mov rax, 0xFFFFF9EA;
        jmp tnp_rc_out;
      tnp_rc_no_rings:
        mov rdi, 2;
        call tb_nhi_probe_note;
        mov rax, 0xFFFFF9E9;
        jmp tnp_rc_out;
      tnp_rc_no_ports:
        mov rdi, 2;
        call tb_nhi_probe_note;
        mov rax, 0xFFFFF9E8;

      tnp_rc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
