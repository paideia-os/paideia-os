// src/kernel/core/drivers/tb/dp_hotplug_bridge.pdx — R35.M9-003 (#1231)
//
// TB4 DP-ADAPTER HOT-PLUG BRIDGE.
//
// tb_topology_channel (R35.M2-004) fans router_appeared /
// router_departed / tunnel_established / tunnel_torn events out to
// subscribers. Not every tunnel event is a DISPLAY event: a
// tunnel_type of PCIe (0/1) or USB3 (3) or HOSTIF (4) has nothing to
// tell the display supervisor. R36's KIND_DISPLAY_OUTPUT (which does
// not yet exist) will care only about DP-adapter tunnel events, and
// wants each translated into a _dp_output_event placeholder that its
// subscriber list can fan out through display_topology_channel.
//
// This module is the FILTER that reads TB topology events, drops
// everything that is not a DP tunnel, and stamps a placeholder
// _dp_output_event record for each match. R35 closes without
// KIND_DISPLAY_OUTPUT; R36's opener will replace the placeholder
// counter bump with the real fanout.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DP-TUNNEL FILTER + PLACEHOLDER EMITTER between the TB
// topology stream and R36's future display substrate. It:
//
//   1. INGEST — dphp_on_tunnel_established(tunnel_type,
//      source_adapter, sink_adapter) is called by a caller that has
//      subscribed to tb_topology_channel and observed a
//      tunnel_established event. It drops the event when
//      tunnel_type != TB_TUNNEL_DP (2), and stamps a placeholder
//      _dp_output_event of kind APPEARED otherwise. Returns 0 on emit
//      (or on non-DP drop, which is not an error), refuses BAD_ARG.
//
//   2. INGEST — dphp_on_tunnel_torn(tunnel_type, source_adapter,
//      sink_adapter) mirrors the above for tear-down events, emitting
//      REMOVED placeholders.
//
//   3. QUERY — dphp_placeholder_count() returns the total number of
//      placeholder events emitted. dphp_placeholder_by_kind(kind)
//      returns the per-kind count. R36's opener will consume this
//      counter to assert that its subscriber saw N events before it
//      starts fanning them out for real.
//
// IT DOES NOT SUBSCRIBE TO tb_topology_channel ITSELF. That
// subscription lives in the caller's setup path (a live R35 supervisor
// would bind this module's ingest functions as subscriber callbacks).
// Keeping this module a PURE FILTER decouples it from the schema's
// subscription accounting.
//
// IT DOES NOT FANOUT TO display_topology_channel. That channel does
// not yet exist (it opens R36 alongside KIND_DISPLAY_OUTPUT). The
// placeholder counter is the seam an R36 witness reads to prove the
// filter fired before the fanout code lands.
//
// IT DOES NOT REPRESENT ADAPTER CLASS. USB4 §11.6 classifies each
// downstream adapter by protocol (PCIe / DP / USB3), and a live
// implementation would read that class from the router's CAP block.
// This scaffold takes the tunnel_type ordinal as ground truth: the
// caller is trusted to have retrieved it from the topology event
// itself (word0[7:0] of the ttc packed record).
//
// dphp_arbitrated() returns 0 until R36 binds a real fanout in place
// of the placeholder counter.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _dphp_events and _dphp_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/dp_hotplug_bridge.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF800..0xFFFFF80F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dp_aux_passthru 0xFFFFF810..
// 1F).

module DpHotplugBridge = structure {

  // Placeholder event kinds. These are the placeholders R36's
  // KIND_DISPLAY_OUTPUT event consumer will subscribe to.
  pub let DPHP_KIND_APPEARED : u64 = 0
  pub let DPHP_KIND_REMOVED  : u64 = 1
  pub let DPHP_KIND_MAX      : u64 = 1

  // Recent-event ring geometry. We remember the last 16 emissions so
  // an R36-side witness can inspect what the filter forwarded before
  // it starts consuming a live fanout. The ring wraps on overflow;
  // the counter dphp_placeholder_count() is authoritative for total
  // events emitted.
  pub let DPHP_RING_MAX  : u64 = 16
  pub let DPHP_EVT_U64   : u64 = 4                // 4 u64s per event (32 bytes)

  // Tunnel type from tb_topology_channel.pdx (§3).
  pub let DPHP_TUN_PCIE_UP    : u64 = 0
  pub let DPHP_TUN_PCIE_DOWN  : u64 = 1
  pub let DPHP_TUN_DP         : u64 = 2
  pub let DPHP_TUN_USB3       : u64 = 3
  pub let DPHP_TUN_HOSTIF     : u64 = 4
  pub let DPHP_TUN_TYPE_MAX   : u64 = 4

  // 24-bit adapter ids per the channel schema.
  pub let DPHP_ADAPTER_MAX : u64 = 0xFFFFFF

  // Failure taxonomy — 0xFFFFF800..0xFFFFF80F.
  pub let DPHP_OK           : u64 = 0
  pub let DPHP_BAD_ARG      : u64 = 0xFFFFF80F
  pub let DPHP_BAD_TUNNEL   : u64 = 0xFFFFF80E
  pub let DPHP_BAD_ADAPTER  : u64 = 0xFFFFF80D
  pub let DPHP_BAD_KIND     : u64 = 0xFFFFF80C

  pub let DPHP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Event record (4 u64s, 32 bytes) — recent-emissions ring:
  //   [+0]  in_use  (0/1)
  //   [+8]  kind (APPEARED / REMOVED)
  //   [+16] source_adapter
  //   [+24] sink_adapter
  pub let mut _dphp_events : [u64; 64] = uninit @align(64)   // 16 slots × 4 u64
  pub let mut _dphp_stats  : [u64; 8]  = uninit @align(64)

  pub let DPHP_ST_APPEARED    : u64 = 0
  pub let DPHP_ST_REMOVED     : u64 = 1
  pub let DPHP_ST_INGESTED    : u64 = 2   // total ingests, including drops
  pub let DPHP_ST_FILTERED    : u64 = 3   // dropped because not DP
  pub let DPHP_ST_EMITTED     : u64 = 4   // placeholder records stamped
  pub let DPHP_ST_REJECTS     : u64 = 5
  pub let DPHP_ST_RING_HEAD   : u64 = 6   // next slot to write

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let dphp_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): clear events + stats. Labels prefixed dphp_rs_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _dphp_events];
      dphp_rs_e:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  dphp_rs_e;

        xor rcx, rcx;
        lea r10, [rip + _dphp_stats];
      dphp_rs_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dphp_rs_s;
        ret
      }
    }

  pub let dphp_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-003 (#1231): honesty pin. Returns 0 until R36 binds a real fanout through display_topology_channel.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let dphp_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): counter read.",
      block: {
        cmp rdi, 8;
        jae dphp_st_zero;
        lea r10, [rip + _dphp_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dphp_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dphp_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): counter bump. Labels prefixed dphp_nt_.",
      block: {
        cmp rdi, 8;
        jae dphp_nt_out;
        lea r10, [rip + _dphp_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dphp_nt_out:
        ret
      }
    }

  pub let dphp_stat_set : (u64, u64) -> () !{mem} @{} =
    fn (which: u64) (val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): counter write (for RING_HEAD wrap). Labels prefixed dphp_ss_.",
      block: {
        cmp rdi, 8;
        jae dphp_ss_out;
        lea r10, [rip + _dphp_stats];
        mov [r10 + rdi * 8], rsi;
      dphp_ss_out:
        ret
      }
    }

  // ==========================================================================
  // Event ring accessors. slot byte offset = slot * 32 = slot << 5.
  // ==========================================================================

  pub let dphp_event_in_use : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): read event.in_use.",
      block: {
        cmp rdi, 16;
        jae dphp_ei_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _dphp_events];
        add r10, rbx;
        mov rax, [r10 + 0];
        pop rbx;
        ret;
      dphp_ei_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dphp_event_kind : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): read event.kind.",
      block: {
        cmp rdi, 16;
        jae dphp_ek_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _dphp_events];
        add r10, rbx;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      dphp_ek_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dphp_event_source : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): read event.source_adapter.",
      block: {
        cmp rdi, 16;
        jae dphp_es_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _dphp_events];
        add r10, rbx;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      dphp_es_zero:
        xor rax, rax;
        ret
      }
    }

  pub let dphp_event_sink : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): read event.sink_adapter.",
      block: {
        cmp rdi, 16;
        jae dphp_esk_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _dphp_events];
        add r10, rbx;
        mov rax, [r10 + 24];
        pop rbx;
        ret;
      dphp_esk_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dphp_tunnel_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-003 (#1231): 1 iff t in [0, 4].",
      block: {
        cmp rdi, 4;
        ja  dphp_tv_no;
        mov rax, 1;
        ret;
      dphp_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dphp_adapter_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-003 (#1231): 1 iff a fits in 24 bits.",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  dphp_av_no;
        mov rax, 1;
        ret;
      dphp_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let dphp_is_dp_tunnel : (u64) -> u64 !{} @{} =
    fn (tunnel_type: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M9-003 (#1231): 1 iff tunnel_type == DPHP_TUN_DP.",
      block: {
        cmp rdi, 2;                      // DPHP_TUN_DP
        jne dphp_id_no;
        mov rax, 1;
        ret;
      dphp_id_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Ring writer. Stamps one placeholder event at RING_HEAD and
  // advances RING_HEAD mod 16. Overwrites the oldest slot on wrap.
  // ==========================================================================

  pub let dphp_emit_ring : (u64, u64, u64) -> () !{mem} @{} =
    fn (kind: u64) (source_adapter: u64) (sink_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): stamp one event at RING_HEAD; advance. Labels prefixed dphp_er_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // kind
        mov r12, rsi;                    // source
        mov r13, rdx;                    // sink

        mov rdi, 6;                      // RING_HEAD
        call dphp_stat;
        mov r14, rax;                    // head
        // wrap: head = head mod 16
        and r14, 15;

        // Byte offset = head * 32 = head << 5.
        mov rax, r14;
        shl rax, 5;
        lea r10, [rip + _dphp_events];
        add r10, rax;
        mov rax, 1;
        mov [r10 + 0], rax;
        mov [r10 + 8], rbx;
        mov [r10 + 16], r12;
        mov [r10 + 24], r13;

        // Advance head.
        add r14, 1;
        and r14, 15;
        mov rdi, 6;                      // RING_HEAD
        mov rsi, r14;
        call dphp_stat_set;

        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dphp_on_tunnel_established(tunnel_type, source_adapter, sink_adapter).
  //
  // Sequence:
  //   1. tunnel_type in [0, 4]              (BAD_TUNNEL)
  //   2. source_adapter fits 24 bits        (BAD_ADAPTER)
  //   3. sink_adapter fits 24 bits          (BAD_ADAPTER)
  //   4. INGESTED++ (always, on well-formed input)
  //   5. if tunnel_type != DP: FILTERED++; return OK.
  //   6. else: emit APPEARED placeholder; APPEARED++; EMITTED++.
  // ==========================================================================

  pub let dphp_on_tunnel_established : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_type: u64) (source_adapter: u64) (sink_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): filter tunnel_established → emit APPEARED. Labels prefixed dphp_ote_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // tunnel_type
        mov r12, rsi;                    // source
        mov r13, rdx;                    // sink

        mov rdi, rbx;
        call dphp_tunnel_valid;
        cmp rax, 0;
        je  dphp_ote_bad_tunnel;

        mov rdi, r12;
        call dphp_adapter_valid;
        cmp rax, 0;
        je  dphp_ote_bad_adapter;

        mov rdi, r13;
        call dphp_adapter_valid;
        cmp rax, 0;
        je  dphp_ote_bad_adapter;

        mov rdi, 2;                      // INGESTED
        call dphp_note;

        mov rdi, rbx;
        call dphp_is_dp_tunnel;
        cmp rax, 0;
        je  dphp_ote_filter;

        mov rdi, 0;                      // APPEARED placeholder kind
        mov rsi, r12;
        mov rdx, r13;
        call dphp_emit_ring;
        mov rdi, 0;                      // APPEARED counter
        call dphp_note;
        mov rdi, 4;                      // EMITTED
        call dphp_note;
        xor rax, rax;
        jmp dphp_ote_out;

      dphp_ote_filter:
        mov rdi, 3;                      // FILTERED
        call dphp_note;
        xor rax, rax;
        jmp dphp_ote_out;

      dphp_ote_bad_tunnel:
        mov rdi, 5;
        call dphp_note;
        mov rax, 0xFFFFF80E;
        jmp dphp_ote_out;
      dphp_ote_bad_adapter:
        mov rdi, 5;
        call dphp_note;
        mov rax, 0xFFFFF80D;

      dphp_ote_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // dphp_on_tunnel_torn — same shape as _established but stamps a
  // REMOVED placeholder.
  // ==========================================================================

  pub let dphp_on_tunnel_torn : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tunnel_type: u64) (source_adapter: u64) (sink_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): filter tunnel_torn → emit REMOVED. Labels prefixed dphp_ott_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        mov rdi, rbx;
        call dphp_tunnel_valid;
        cmp rax, 0;
        je  dphp_ott_bad_tunnel;

        mov rdi, r12;
        call dphp_adapter_valid;
        cmp rax, 0;
        je  dphp_ott_bad_adapter;

        mov rdi, r13;
        call dphp_adapter_valid;
        cmp rax, 0;
        je  dphp_ott_bad_adapter;

        mov rdi, 2;                      // INGESTED
        call dphp_note;

        mov rdi, rbx;
        call dphp_is_dp_tunnel;
        cmp rax, 0;
        je  dphp_ott_filter;

        mov rdi, 1;                      // REMOVED placeholder kind
        mov rsi, r12;
        mov rdx, r13;
        call dphp_emit_ring;
        mov rdi, 1;                      // REMOVED counter
        call dphp_note;
        mov rdi, 4;                      // EMITTED
        call dphp_note;
        xor rax, rax;
        jmp dphp_ott_out;

      dphp_ott_filter:
        mov rdi, 3;                      // FILTERED
        call dphp_note;
        xor rax, rax;
        jmp dphp_ott_out;

      dphp_ott_bad_tunnel:
        mov rdi, 5;
        call dphp_note;
        mov rax, 0xFFFFF80E;
        jmp dphp_ott_out;
      dphp_ott_bad_adapter:
        mov rdi, 5;
        call dphp_note;
        mov rax, 0xFFFFF80D;

      dphp_ott_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Placeholder query surface for a future R36 witness.
  // ==========================================================================

  pub let dphp_placeholder_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): total placeholder emissions (APPEARED + REMOVED).",
      block: {
        mov rdi, 4;                      // EMITTED
        call dphp_stat;
        ret
      }
    }

  pub let dphp_placeholder_by_kind : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M9-003 (#1231): per-kind emission count.",
      block: {
        cmp rdi, 1;
        ja  dphp_pbk_bad;
        // kind 0 -> stat 0 (APPEARED), kind 1 -> stat 1 (REMOVED).
        call dphp_stat;
        ret;
      dphp_pbk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }
}
