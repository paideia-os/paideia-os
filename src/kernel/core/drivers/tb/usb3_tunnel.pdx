// src/kernel/core/drivers/tb/usb3_tunnel.pdx — R35.M3-003 (#1207)
//
// TB4 USB3 protocol adapter — tunnel establishment scaffold. Per
// USB4 §8 (USB3 Adapter), a USB3 tunnel is established by pairing
// a downstream-facing USB3 adapter (host side) with an
// upstream-facing USB3 adapter (device side) on distinct routers,
// negotiating a USB3 gen (Gen1 5Gbps / Gen2 10Gbps / Gen2x2 20Gbps),
// and presenting the tunneled USB3 root as a VIRTUAL xHCI PORT SET
// on the local xHCI controller.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOGNIZE + VIRTUAL PORT MAPPING half of USB3 tunnel
// establishment. USB4 §8.3 defines the negotiation phase and §8.4
// defines the packet encapsulation. This scaffold owns:
//
//   * Validators for the USB3 gen ordinal and per-port bandwidth
//     shape.
//   * A virtual xHCI port allocator (fixed-capacity 4-slot table)
//     — the HAND-OFF POINT to the xHCI supervisor. The supervisor
//     consumes a port number in [XHCI_PORT_TB_BASE, +MAX) and
//     treats it as a USB port on the local xHCI controller.
//     Two USB3 tunnels claiming the same virtual port is refused
//     as PORT_IN_USE.
//
// IT DOES NOT ISSUE USB3 TRAFFIC. USB packet forwarding flows
// through the CM path once the tunnel is ACTIVE; this scaffold
// verifies request shape only.
//
// IT DOES NOT MINT KIND_TB_ROUTE. The capability that names the
// established USB3 tunnel is KIND_TB_ROUTE with tunnel_type = 2;
// minting is the caller's responsibility once port_alloc and
// gen_negotiate both succeed.
//
// usb3_tunnel_arbitrated() returns 0 until a live driver binds
// this scaffold against real USB3 adapter registers.
//
// =============================================================================
// §1  USB3 GEN ORDINALS (USB4 §8.3)
// =============================================================================
//
//   1  Gen1     5   Gbps  (SuperSpeed)
//   2  Gen2    10   Gbps  (SuperSpeedPlus)
//   3  Gen2x2  20   Gbps  (SuperSpeedPlus dual-lane)
//
// USB4 native (40 Gbps) is not a USB3 tunnel — it is the tunnel
// substrate itself. A tunnel that would claim USB4 Gen speeds is
// refused as BAD_GEN.
//
// =============================================================================
// §2  VIRTUAL xHCI PORT MAPPING
// =============================================================================
//
// The local xHCI controller enumerates a fixed number of physical
// USB2 + USB3 ports (host ports 1..N, where N is
// controller-specific). A USB3 tunnel coming up through TB4 is
// presented as a VIRTUAL port in the range
// [XHCI_PORT_TB_BASE, XHCI_PORT_TB_BASE + XHCI_PORT_MAX). Physical
// ports claim [1, XHCI_PORT_TB_BASE).
//
// The virtual-port extension is R34 xHCI supervisor's contract —
// this scaffold owns the ALLOCATION TABLE only.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _usb3_tunnel_stats and _usb3_tunnel_port_tab are written only by
// helpers in this module. tools/build.sh confines relocations
// against both symbols to `core/drivers/tb/usb3_tunnel.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFF970..0xFFFFF97F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: kind_tb_route 0xFFFFF9A0..AF,
// pcie_tunnel 0xFFFFF990..9F, dp_tunnel 0xFFFFF980..8F,
// route_teardown 0xFFFFF960..6F).

module Usb3Tunnel = structure {

  // USB3 gen ordinals (§1).
  pub let USB3_GEN1   : u64 = 1
  pub let USB3_GEN2   : u64 = 2
  pub let USB3_GEN2X2 : u64 = 3
  pub let USB3_GEN_MAX : u64 = 3

  // Per-port bandwidth (Mbps).
  pub let USB3_BW_GEN1_MBPS   : u64 = 5000
  pub let USB3_BW_GEN2_MBPS   : u64 = 10000
  pub let USB3_BW_GEN2X2_MBPS : u64 = 20000

  // Virtual xHCI port range (§2).
  pub let XHCI_PORT_TB_BASE : u64 = 32              // physical ports 1..31
  pub let XHCI_PORT_MAX     : u64 = 4               // four virtual ports
  pub let XHCI_PORT_NONE    : u64 = 0xFF

  // Failure taxonomy — 0xFFFFF970..0xFFFFF97F.
  pub let USB3_TUN_OK             : u64 = 0
  pub let USB3_TUN_BAD_ARG        : u64 = 0xFFFFF97F
  pub let USB3_TUN_BAD_GEN        : u64 = 0xFFFFF97E
  pub let USB3_TUN_BAD_ADAPTER    : u64 = 0xFFFFF97D
  pub let USB3_TUN_SELF_LOOP      : u64 = 0xFFFFF97C
  pub let USB3_TUN_PORT_IN_USE    : u64 = 0xFFFFF97B
  pub let USB3_TUN_PORT_ENOSPC    : u64 = 0xFFFFF97A
  pub let USB3_TUN_PORT_BAD       : u64 = 0xFFFFF979
  pub let USB3_TUN_PORT_NOT_HELD  : u64 = 0xFFFFF978

  pub let mut _usb3_tunnel_stats    : [u64; 8] = uninit @align(64)
  pub let mut _usb3_tunnel_port_tab : [u64; 4] = uninit @align(64)

  pub let USB3_TUN_ST_ATTEMPTS  : u64 = 0
  pub let USB3_TUN_ST_ALLOCATED : u64 = 1
  pub let USB3_TUN_ST_RELEASED  : u64 = 2
  pub let USB3_TUN_ST_REJECTS   : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let usb3_tunnel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-003 (#1207): clear stats + port table. Labels prefixed utn_rs_.",
      block: {
        lea r10, [rip + _usb3_tunnel_stats];
        xor rax, rax;
        xor rcx, rcx;
      utn_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  utn_rs_stats;

        lea r10, [rip + _usb3_tunnel_port_tab];
        xor rcx, rcx;
      utn_rs_ports:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  utn_rs_ports;
        ret
      }
    } @no_frame

  pub let usb3_tunnel_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-003 (#1207): honesty pin. Returns 0 until a later round binds this against a live USB3 adapter.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb3_tunnel_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-003 (#1207): counter read.",
      block: {
        cmp rdi, 8;
        jae utn_st_zero;
        lea r10, [rip + _usb3_tunnel_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      utn_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb3_tunnel_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-003 (#1207): counter bump. Labels prefixed utn_nt_.",
      block: {
        cmp rdi, 8;
        jae utn_nt_out;
        lea r10, [rip + _usb3_tunnel_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      utn_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let usb3_tun_gen_valid : (u64) -> u64 !{} @{} =
    fn (g: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-003 (#1207): 1 iff g in [1, 3]. Labels prefixed utn_gv_.",
      block: {
        cmp rdi, 1;
        jb  utn_gv_no;
        cmp rdi, 3;
        ja  utn_gv_no;
        mov rax, 1;
        ret;
      utn_gv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb3_tun_adapter_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-003 (#1207): 1 iff a fits in u8. Labels prefixed utn_av_.",
      block: {
        cmp rdi, 0xFF;
        ja  utn_av_no;
        mov rax, 1;
        ret;
      utn_av_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb3_tun_port_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-003 (#1207): 1 iff p in [XHCI_PORT_TB_BASE, XHCI_PORT_TB_BASE + XHCI_PORT_MAX). Labels prefixed utn_pv_.",
      block: {
        mov r10, 32;                     // XHCI_PORT_TB_BASE
        cmp rdi, r10;
        jb  utn_pv_no;
        mov r10, 36;                     // TB_BASE + MAX
        cmp rdi, r10;
        jae utn_pv_no;
        mov rax, 1;
        ret;
      utn_pv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Gen bandwidth lookup. Returns Mbps for a valid gen, DECODE_BAD
  // for invalid input.
  // ==========================================================================

  pub let usb3_tun_gen_bw_mbps : (u64) -> u64 !{} @{} =
    fn (g: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M3-003 (#1207): map gen -> Mbps per §1. Labels prefixed utn_gb_.",
      block: {
        cmp rdi, 1;
        je  utn_gb_g1;
        cmp rdi, 2;
        je  utn_gb_g2;
        cmp rdi, 3;
        je  utn_gb_g3;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      utn_gb_g1:
        mov rax, 5000;
        ret;
      utn_gb_g2:
        mov rax, 10000;
        ret;
      utn_gb_g3:
        mov rax, 20000;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Gen negotiation recognition.
  //
  // Given a request (source_adapter, sink_adapter, gen), verify
  // the shape. A caller passes the request to cm_rings for the
  // ALLOCATE control packet.
  //
  // Sequence:
  //   1. Source adapter fits u8
  //   2. Sink adapter fits u8
  //   3. Source != Sink (SELF_LOOP refused)
  //   4. Gen in [1, 3]
  // ==========================================================================

  pub let usb3_tunnel_gen_negotiate : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (source_adapter: u64) (sink_adapter: u64) (gen: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-003 (#1207): recognize gen negotiation. Refuses SELF_LOOP (source == sink) — a USB3 tunnel cannot terminate on its own router. Labels prefixed utn_gn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // source_adapter
        mov r12, rsi;                    // sink_adapter
        mov r13, rdx;                    // gen

        mov rdi, 0;                      // ATTEMPTS
        call usb3_tunnel_note;

        mov rdi, rbx;
        call usb3_tun_adapter_valid;
        cmp rax, 0;
        je  utn_gn_bad_adapter;

        mov rdi, r12;
        call usb3_tun_adapter_valid;
        cmp rax, 0;
        je  utn_gn_bad_adapter;

        cmp rbx, r12;
        je  utn_gn_self_loop;

        mov rdi, r13;
        call usb3_tun_gen_valid;
        cmp rax, 0;
        je  utn_gn_bad_gen;

        xor rax, rax;
        jmp utn_gn_out;

      utn_gn_bad_adapter:
        mov rdi, 3;
        call usb3_tunnel_note;
        mov rax, 0xFFFFF97D;
        jmp utn_gn_out;
      utn_gn_self_loop:
        mov rdi, 3;
        call usb3_tunnel_note;
        mov rax, 0xFFFFF97C;
        jmp utn_gn_out;
      utn_gn_bad_gen:
        mov rdi, 3;
        call usb3_tunnel_note;
        mov rax, 0xFFFFF97E;

      utn_gn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Virtual xHCI port allocation. Given a source_adapter, claim one
  // of XHCI_PORT_MAX (=4) virtual port slots. Returns the port
  // number on success, PORT_ENOSPC when full.
  //
  // Two tunnels claiming the same source_adapter is REFUSED as
  // PORT_IN_USE (rather than aliasing) — a subscriber that walked
  // xhci_slot_lifecycle for both would attribute events wrongly.
  //
  // The stashed value is source_adapter + 1 (biased) to distinguish
  // "held by adapter 0" from "free".
  // ==========================================================================

  pub let usb3_tunnel_port_alloc : (u64) -> u64 !{mem} @{} =
    fn (source_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-003 (#1207): claim one virtual xHCI port slot. Refuses IN_USE if the same source_adapter already holds a slot. Labels prefixed utn_pa_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // source_adapter

        mov rdi, rbx;
        call usb3_tun_adapter_valid;
        cmp rax, 0;
        je  utn_pa_bad_adapter;

        mov r12, rbx;
        add r12, 1;                      // biased holder value

        // Scan for existing holder.
        xor rcx, rcx;
      utn_pa_scan:
        cmp rcx, 4;
        jae utn_pa_alloc;
        lea r10, [rip + _usb3_tunnel_port_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  utn_pa_in_use;
        add rcx, 1;
        jmp utn_pa_scan;

      utn_pa_alloc:
        // Scan for free slot.
        xor rcx, rcx;
      utn_pa_alloc_scan:
        cmp rcx, 4;
        jae utn_pa_enospc;
        lea r10, [rip + _usb3_tunnel_port_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  utn_pa_claim;
        add rcx, 1;
        jmp utn_pa_alloc_scan;

      utn_pa_claim:
        mov [r10 + rcx * 8], r12;
        mov rdi, 1;                      // ALLOCATED
        call usb3_tunnel_note;
        mov rax, rcx;
        add rax, 32;                     // XHCI_PORT_TB_BASE
        jmp utn_pa_out;

      utn_pa_in_use:
        mov rdi, 3;
        call usb3_tunnel_note;
        mov rax, 0xFFFFF97B;
        jmp utn_pa_out;
      utn_pa_enospc:
        mov rdi, 3;
        call usb3_tunnel_note;
        mov rax, 0xFFFFF97A;
        jmp utn_pa_out;
      utn_pa_bad_adapter:
        mov rdi, 3;
        call usb3_tunnel_note;
        mov rax, 0xFFFFF97D;

      utn_pa_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // Release BY source_adapter. Walks the internal port table for the
  // biased holder value and calls the by-port release path once
  // located. Exposed for route_teardown.pdx so the teardown sequencer
  // does not itself relocate against _usb3_tunnel_port_tab — the
  // one-writer discipline (§3) is preserved by keeping every table
  // walker in this compilation unit.
  //
  // Returns 0 on success, PORT_NOT_HELD if source_adapter holds no
  // slot, BAD_ADAPTER if source_adapter is out of range.
  pub let usb3_tunnel_release_by_source : (u64) -> u64 !{mem} @{} =
    fn (source_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-005 (#1209): release-by-source helper. Keeps the port-table walk inside this compilation unit so route_teardown.o carries no relocation against _usb3_tunnel_port_tab. Labels prefixed utn_rbs_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // source_adapter

        mov rdi, rbx;
        call usb3_tun_adapter_valid;
        cmp rax, 0;
        je  utn_rbs_bad;

        mov r12, rbx;
        add r12, 1;                      // biased holder value

        xor rcx, rcx;
      utn_rbs_scan:
        cmp rcx, 4;
        jae utn_rbs_not_held;
        lea r10, [rip + _usb3_tunnel_port_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  utn_rbs_hit;
        add rcx, 1;
        jmp utn_rbs_scan;

      utn_rbs_hit:
        mov rdi, rcx;
        add rdi, 32;                     // XHCI_PORT_TB_BASE
        call usb3_tunnel_port_release;
        jmp utn_rbs_out;

      utn_rbs_bad:
        mov rax, 0xFFFFF97D;
        jmp utn_rbs_out;
      utn_rbs_not_held:
        mov rax, 0xFFFFF978;

      utn_rbs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb3_tunnel_port_release : (u64) -> u64 !{mem} @{} =
    fn (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M3-003 (#1207): release a virtual xHCI port slot. Refuses PORT_BAD for a port outside the TB range, PORT_NOT_HELD for a slot already free. Labels prefixed utn_pr_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        call usb3_tun_port_valid;
        cmp rax, 0;
        je  utn_pr_bad;

        mov rcx, rbx;
        sub rcx, 32;                     // slot = port - TB_BASE

        lea r10, [rip + _usb3_tunnel_port_tab];
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  utn_pr_not_held;

        xor rax, rax;
        mov [r10 + rcx * 8], rax;

        mov rdi, 2;                      // RELEASED
        call usb3_tunnel_note;
        xor rax, rax;
        jmp utn_pr_out;

      utn_pr_bad:
        mov rax, 0xFFFFF979;
        jmp utn_pr_out;
      utn_pr_not_held:
        mov rax, 0xFFFFF978;

      utn_pr_out:
        pop rbx;
        ret
      }
    }
}
