// src/kernel/core/drivers/tb/route_arith.pdx — R35.M7-002 (#1224)
//
// TB4 ROUTE-STRING ARITHMETIC.
//
// A USB4 route string (§5.4) is a concatenation of 5-bit downstream-
// port ordinals, one per hop, packed low-to-high in the 64-bit route
// field. The topmost 4 bits are reserved; the specification caps a
// route at 12 hops (60 bits). Adapter ordinals cap at 32 per router,
// so each hop fits the 5-bit field without truncation.
//
// router_walk.pdx (R35.M2) provided TWO of the four operations this
// module ships — depth (count_hops) and parent (pop_last_hop) — but
// clamped the route field to 24 bits (matching KIND_TB_DOMAIN's own
// 24-bit route cap for the R35.M2 substrate work). This module lifts
// that cap to the full USB4-legal 60-bit range and adds the two
// operations discovery needs: APPEND_HOP (extend a route by one
// downstream port) and EXTRACT_HOP (read the port ordinal at hop
// index n).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the PURE-ARITHMETIC layer of the route-string algebra:
//
//   1. RA_APPEND_HOP(route_id, port) — shifts the route field left by
//      5 bits and OR-s the port into the low slot. Refuses BAD_HOP
//      if port does not fit in 5 bits (port > 31 — the encoding
//      cannot represent it), TOO_DEEP if the current depth is
//      already 12.
//
//   2. RA_POP_LAST_HOP(route_id) — clears the highest occupied
//      5-bit slot. Refuses NO_HOPS on a depth-0 route.
//
//   3. RA_COUNT_HOPS(route_id) — position of the highest non-zero
//      5-bit slot + 1. Depth 0 for route 0. Refuses BAD_ROUTE if
//      route > 60 bits.
//
//   4. RA_EXTRACT_HOP(route_id, n) — port ordinal at hop index n
//      (0 = the deepest / first hop from the root; count-1 = the
//      most recent). Refuses BAD_INDEX if n >= depth.
//
// IT HOLDS NO STATE beyond a stats array (op counts). Every op is a
// pure function of its arguments. No reset seam is required beyond
// clearing the counters.
//
// IT DOES NOT REPLACE router_walk's depth/parent for the 24-bit
// substrate. Those callers cap route_id at 24 bits by contract; this
// module lifts the cap to 60 bits for consumers that need to reason
// about the full 12-hop route.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _ra_stats is written only by helpers in this module. tools/build.sh
// confines relocations against the symbol to
// `core/drivers/tb/route_arith.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF870..0xFFFFF87F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: topology_graph 0xFFFFF880..
// 8F, topology_diff 0xFFFFF860..6F).

module RouteArith = structure {

  // Encoding constants.
  pub let RA_HOP_BITS  : u64 = 5
  pub let RA_HOP_MAX   : u64 = 31              // 5-bit slot max
  pub let RA_DEPTH_MAX : u64 = 12
  pub let RA_ROUTE_MAX : u64 = 0x0FFFFFFFFFFFFFFF   // 60 bits set

  // Failure taxonomy — 0xFFFFF870..0xFFFFF87F.
  pub let RA_OK        : u64 = 0
  pub let RA_BAD_ARG   : u64 = 0xFFFFF87F
  pub let RA_BAD_ROUTE : u64 = 0xFFFFF87E
  pub let RA_BAD_HOP   : u64 = 0xFFFFF87D
  pub let RA_TOO_DEEP  : u64 = 0xFFFFF87C
  pub let RA_NO_HOPS   : u64 = 0xFFFFF87B
  pub let RA_BAD_INDEX : u64 = 0xFFFFF87A

  pub let RA_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  pub let mut _ra_stats : [u64; 8] = uninit @align(64)

  pub let RA_ST_APPEND  : u64 = 0
  pub let RA_ST_POP     : u64 = 1
  pub let RA_ST_COUNT   : u64 = 2
  pub let RA_ST_EXTRACT : u64 = 3
  pub let RA_ST_REJECTS : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let ra_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-002 (#1224): clear stats. Labels prefixed rar_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _ra_stats];
      rar_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  rar_s;
        ret
      }
    }

  pub let ra_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-002 (#1224): counter read.",
      block: {
        cmp rdi, 8;
        jae rast_zero;
        lea r10, [rip + _ra_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      rast_zero:
        xor rax, rax;
        ret
      }
    }

  pub let ra_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-002 (#1224): counter bump. Labels prefixed ran_.",
      block: {
        cmp rdi, 8;
        jae ran_out;
        lea r10, [rip + _ra_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      ran_out:
        ret
      }
    }

  // ==========================================================================
  // ra_count_hops — position of highest non-zero 5-bit slot + 1.
  //
  // route 0 => 0. Route with only slot 0 set => 1. Slot 11 set => 12.
  // Refuses BAD_ROUTE if route_id has any bit above bit 59 set.
  // ==========================================================================

  pub let ra_count_hops : (u64) -> u64 !{mem} @{} =
    fn (route_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-002 (#1224): count occupied hops. Labels prefixed rach_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        // Bound check: any bit above 59 set?
        mov r10, rbx;
        shr r10, 60;
        cmp r10, 0;
        jne rach_bad;

        cmp rbx, 0;
        je  rach_zero;

        xor r12, r12;                    // slot index
        xor r13, r13;                    // highest+1

      rach_scan:
        cmp r12, 12;
        jae rach_done;
        mov r10, rbx;
        mov r11, r12;
        // r11 = slot * 5, encoded as (slot << 2) + slot to sidestep
        // imul r64, imm which paideia-as does not emit.
        shl r11, 2;
        add r11, r12;
        mov rcx, r11;
        shr r10, cl;
        and r10, 0x1F;
        cmp r10, 0;
        je  rach_skip;
        mov r13, r12;
        add r13, 1;
      rach_skip:
        add r12, 1;
        jmp rach_scan;

      rach_done:
        mov rdi, 2;                      // COUNT
        call ra_note;
        mov rax, r13;
        jmp rach_out;
      rach_zero:
        mov rdi, 2;
        call ra_note;
        xor rax, rax;
        jmp rach_out;
      rach_bad:
        mov rdi, 4;                      // REJECTS
        call ra_note;
        mov rax, 0xFFFFF87E;

      rach_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ra_append_hop — shift the route left by 5 and OR the port into
  // the low slot.
  //
  // The convention across this module: hop index 0 is the FIRST hop
  // from the root (the innermost / deepest field, at the highest
  // occupied slot position); the LAST-appended hop lives in the
  // low-order slot. That matches the USB4 §5.4 encoding a router
  // reads left-to-right during forwarding.
  //
  // Refuses BAD_HOP if port > 31 (does not fit in 5 bits), BAD_ROUTE
  // if the input route already has a bit above bit 59 set, TOO_DEEP
  // if the input's depth is already 12.
  // ==========================================================================

  pub let ra_append_hop : (u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-002 (#1224): append downstream port. Labels prefixed raah_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // route_id
        mov r12, rsi;                    // port

        cmp r12, 31;                     // 5-bit max
        ja  raah_bad_hop;

        // Route bound.
        mov r10, rbx;
        shr r10, 60;
        cmp r10, 0;
        jne raah_bad_route;

        // Depth.
        mov rdi, rbx;
        call ra_count_hops;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  raah_bad_route;
        cmp rax, 12;
        jae raah_too_deep;

        // Shift + OR.
        mov rax, rbx;
        shl rax, 5;
        mov r10, r12;
        and r10, 0x1F;
        or  rax, r10;

        push rax;
        mov rdi, 0;                      // APPEND
        call ra_note;
        pop rax;
        jmp raah_out;

      raah_bad_hop:
        mov rdi, 4;
        call ra_note;
        mov rax, 0xFFFFF87D;
        jmp raah_out;
      raah_bad_route:
        mov rdi, 4;
        call ra_note;
        mov rax, 0xFFFFF87E;
        jmp raah_out;
      raah_too_deep:
        mov rdi, 4;
        call ra_note;
        mov rax, 0xFFFFF87C;

      raah_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ra_pop_last_hop — clear the highest occupied 5-bit slot; return
  // the resulting parent route.
  //
  // Refuses BAD_ROUTE if input has a bit above bit 59 set, NO_HOPS
  // if input is depth 0.
  // ==========================================================================

  pub let ra_pop_last_hop : (u64) -> u64 !{mem} @{} =
    fn (route_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-002 (#1224): clear highest occupied 5-bit slot. Labels prefixed raph_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;

        mov r10, rbx;
        shr r10, 60;
        cmp r10, 0;
        jne raph_bad_route;

        cmp rbx, 0;
        je  raph_no_hops;

        // Find highest occupied slot.
        mov r12, 11;                     // start at top
      raph_scan:
        mov r10, rbx;
        mov r11, r12;
        shl r11, 2;
        add r11, r12;
        mov rcx, r11;
        shr r10, cl;
        and r10, 0x1F;
        cmp r10, 0;
        jne raph_hit;
        cmp r12, 0;
        je  raph_no_hops;
        sub r12, 1;
        jmp raph_scan;

      raph_hit:
        // Clear slot r12.
        mov rax, 0x1F;
        mov rcx, r12;
        shl rcx, 2;
        add rcx, r12;
        shl rax, cl;
        not rax;
        and rbx, rax;

        push rbx;
        mov rdi, 1;                      // POP
        call ra_note;
        pop rax;
        jmp raph_out;

      raph_bad_route:
        mov rdi, 4;
        call ra_note;
        mov rax, 0xFFFFF87E;
        jmp raph_out;
      raph_no_hops:
        mov rdi, 4;
        call ra_note;
        mov rax, 0xFFFFF87B;

      raph_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ra_extract_hop(route_id, n) — port ordinal at hop index n.
  //
  // Convention: hop index 0 is the DEEPEST hop (highest occupied
  // slot); hop index (depth - 1) is the low-order slot (the last
  // appended). This matches the forwarding order a router reads.
  //
  // Refuses BAD_ROUTE if route has a bit above bit 59 set, BAD_INDEX
  // if n >= depth.
  // ==========================================================================

  pub let ra_extract_hop : (u64, u64) -> u64 !{mem} @{} =
    fn (route_id: u64) (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M7-002 (#1224): read hop ordinal at index n (0 = deepest). Labels prefixed raxh_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // route
        mov r12, rsi;                    // n

        mov r10, rbx;
        shr r10, 60;
        cmp r10, 0;
        jne raxh_bad_route;

        mov rdi, rbx;
        call ra_count_hops;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  raxh_bad_route;
        mov r13, rax;                    // depth

        cmp r12, r13;
        jae raxh_bad_index;

        // slot_index = (depth - 1) - n; deepest hop is at highest
        // occupied slot.
        mov r14, r13;
        sub r14, 1;
        sub r14, r12;

        // Extract 5 bits at r14 * 5.
        mov r10, rbx;
        mov r11, r14;
        shl r11, 2;
        add r11, r14;
        mov rcx, r11;
        shr r10, cl;
        and r10, 0x1F;

        push r10;
        mov rdi, 3;                      // EXTRACT
        call ra_note;
        pop rax;
        jmp raxh_out;

      raxh_bad_route:
        mov rdi, 4;
        call ra_note;
        mov rax, 0xFFFFF87E;
        jmp raxh_out;
      raxh_bad_index:
        mov rdi, 4;
        call ra_note;
        mov rax, 0xFFFFF87A;

      raxh_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
