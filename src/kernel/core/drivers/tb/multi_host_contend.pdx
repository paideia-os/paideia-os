// src/kernel/core/drivers/tb/multi_host_contend.pdx — R35.M8-002 (#1227)
//
// TB4 MULTI-HOST CONTENTION PLACEHOLDER (future-proofing).
//
// USB4 §11 permits two upstream TB4 ports on the same DOCK to be wired
// to two independent HOSTS. When both hosts try to claim the same
// DOWNSTREAM ADAPTER — the display panel, an external SSD, a fan
// controller — the CM must decide which host holds it and refuse the
// other. This is the two-node case; the general n-host case is
// out-of-scope for R35.
//
// R43+ will wire this into a live multi-host dock; for R35 the driver
// harness has only one host. This module ships the ARBITRATION MODEL
// so the callers we already have can hold a live counter of contended
// claims (0 today, non-zero once R43 lands) and so R35's cascade tests
// can rehearse the refusal shape.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the FIRST-CLAIM-WINS arbiter over a fixed capacity claim
// table. It:
//
//   1. REQUEST — mhc_request(host_id, downstream_adapter) allocates a
//      claim row if none exists for the adapter and stamps host_id as
//      the holder. Refuses DENIED_CONTENDED if a claim already exists
//      naming a different host.
//
//   2. RELEASE — mhc_release(host_id, downstream_adapter) clears a
//      claim held by host_id. Refuses NOT_HELD if no claim exists or
//      if the caller does not hold it.
//
//   3. QUERY — mhc_holder(downstream_adapter) returns the host_id or
//      MHC_NO_HOLDER; mhc_row_count() lets a caller ask how many
//      claims are live.
//
// IT DOES NOT WIRE INTO A LIVE DOCK. Real multi-host wiring is R43+;
// this scaffold ships the model.
//
// IT DOES NOT SCHEDULE CLAIMS. First-claim-wins is a policy; a fair
// scheduler that rotates ownership across hosts is deferred.
//
// IT DOES NOT PREEMPT. host_0 keeps a claim until it releases it or
// the row is reset. Priority-driven preemption belongs to
// tunnel_priority.pdx (R35.M8-003) and operates over TUNNEL TYPES, not
// over hosts.
//
// mhc_arbitrated() returns 0 until a live R43 multi-host CM binds
// this module against real requests.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _mhc_claims and _mhc_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/multi_host_contend.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF840..0xFFFFF84F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: tunnel_priority 0xFFFFF830..
// 3F, tunnel_arbiter 0xFFFFF850..5F).

module MultiHostContend = structure {

  // Row / capacity constants.
  pub let MHC_CLAIM_MAX     : u64 = 16
  pub let MHC_ROW_U64       : u64 = 4              // 4 u64s per row (32 bytes)

  // Failure taxonomy — 0xFFFFF840..0xFFFFF84F.
  pub let MHC_OK               : u64 = 0
  pub let MHC_BAD_ARG          : u64 = 0xFFFFF84F
  pub let MHC_DENIED_CONTENDED : u64 = 0xFFFFF84E
  pub let MHC_ENOSPC           : u64 = 0xFFFFF84D
  pub let MHC_NOT_HELD         : u64 = 0xFFFFF84C
  pub let MHC_BAD_HOST         : u64 = 0xFFFFF84B

  pub let MHC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let MHC_NO_HOLDER  : u64 = 0xFFFFFFFFFFFFFFFF
  pub let MHC_ROW_NONE   : u64 = 0xFF

  // Claim row (4 u64s, 32 bytes):
  //   [+0]  in_use  (0/1)
  //   [+8]  host_id
  //   [+16] downstream_adapter
  //   [+24] reserved
  pub let mut _mhc_claims : [u64; 64] = uninit @align(64)   // 16 rows × 4 u64

  pub let mut _mhc_stats : [u64; 8] = uninit @align(64)

  pub let MHC_ST_REQUESTS  : u64 = 0
  pub let MHC_ST_RELEASES  : u64 = 1
  pub let MHC_ST_CONTENDED : u64 = 2
  pub let MHC_ST_REJECTS   : u64 = 3

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let mhc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): clear claim rows + stats. Labels prefixed mhc_rs_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _mhc_claims];
      mhc_rs_c:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  mhc_rs_c;

        xor rcx, rcx;
        lea r10, [rip + _mhc_stats];
      mhc_rs_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  mhc_rs_s;
        ret
      }
    } @no_frame

  pub let mhc_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M8-002 (#1227): honesty pin. Returns 0 until R43+ wires a live multi-host dock.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let mhc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): counter read.",
      block: {
        cmp rdi, 8;
        jae mhc_st_zero;
        lea r10, [rip + _mhc_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      mhc_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let mhc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): counter bump. Labels prefixed mhc_nt_.",
      block: {
        cmp rdi, 8;
        jae mhc_nt_out;
        lea r10, [rip + _mhc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      mhc_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row helpers.
  // ==========================================================================

  pub let mhc_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): read row.in_use.",
      block: {
        cmp rdi, 16;
        jae mhc_ri_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;                      // * 32 bytes
        lea r10, [rip + _mhc_claims];
        add r10, rbx;
        mov rax, [r10 + 0];
        pop rbx;
        ret;
      mhc_ri_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let mhc_row_host : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): read row.host_id.",
      block: {
        cmp rdi, 16;
        jae mhc_rh_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _mhc_claims];
        add r10, rbx;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      mhc_rh_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let mhc_row_adapter : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): read row.downstream_adapter.",
      block: {
        cmp rdi, 16;
        jae mhc_ra_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _mhc_claims];
        add r10, rbx;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      mhc_ra_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // Live claim count.
  pub let mhc_row_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): count in-use rows. Labels prefixed mhc_rc_.",
      block: {
        push rbx;
        push r12;
        xor rbx, rbx;                    // count
        xor r12, r12;                    // iterator
      mhc_rc_scan:
        cmp r12, 16;
        jae mhc_rc_done;
        mov rdi, r12;
        call mhc_row_in_use;
        cmp rax, 0;
        je  mhc_rc_next;
        add rbx, 1;
      mhc_rc_next:
        add r12, 1;
        jmp mhc_rc_scan;
      mhc_rc_done:
        mov rax, rbx;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Find row by downstream_adapter. Returns row_id or ROW_NONE.
  pub let mhc_find : (u64) -> u64 !{mem} @{} =
    fn (downstream_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): scan for downstream_adapter. Labels prefixed mhc_fd_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // adapter
        xor r12, r12;

      mhc_fd_scan:
        cmp r12, 16;
        jae mhc_fd_none;
        mov rdi, r12;
        call mhc_row_in_use;
        cmp rax, 0;
        je  mhc_fd_next;
        mov rdi, r12;
        call mhc_row_adapter;
        cmp rax, rbx;
        je  mhc_fd_hit;
      mhc_fd_next:
        add r12, 1;
        jmp mhc_fd_scan;

      mhc_fd_hit:
        mov rax, r12;
        pop r12;
        pop rbx;
        ret;
      mhc_fd_none:
        mov rax, 0xFF;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Query the current holder host_id for downstream_adapter, or
  // MHC_NO_HOLDER (0xFF..FF) if none.
  pub let mhc_holder : (u64) -> u64 !{mem} @{} =
    fn (downstream_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): read holder host_id.",
      block: {
        mov rdi, rdi;
        call mhc_find;
        cmp rax, 0xFF;
        je  mhc_hl_none;
        mov rdi, rax;
        call mhc_row_host;
        ret;
      mhc_hl_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // mhc_request — claim a downstream_adapter for host_id.
  //
  // Policy: FIRST-CLAIM-WINS. If no claim exists for the adapter, the
  // caller's host_id is stamped. If a claim exists naming a DIFFERENT
  // host, refuses DENIED_CONTENDED. If a claim exists naming the
  // caller's host_id, returns OK (idempotent).
  //
  // Sequence:
  //   1. host_id in valid range (small u64; 0..0xFF for now)  (BAD_HOST)
  //   2. adapter fits u8                                      (BAD_ARG)
  //   3. Find existing claim
  //        3a. exists, holder == caller -> OK
  //        3b. exists, holder != caller -> DENIED_CONTENDED
  //        3c. absent -> allocate row, stamp
  //   4. Absent + no free row -> ENOSPC
  // ==========================================================================

  pub let mhc_request : (u64, u64) -> u64 !{mem} @{} =
    fn (host_id: u64) (downstream_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): first-claim-wins request. Labels prefixed mhc_rq_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // host_id
        mov r12, rsi;                    // adapter

        cmp rbx, 0xFF;
        ja  mhc_rq_bad_host;
        cmp r12, 0xFF;
        ja  mhc_rq_bad_arg;

        mov rdi, 0;                      // REQUESTS
        call mhc_note;

        mov rdi, r12;
        call mhc_find;
        cmp rax, 0xFF;
        je  mhc_rq_absent;
        mov r13, rax;                    // slot

        // Existing claim — compare holder.
        mov rdi, r13;
        call mhc_row_host;
        cmp rax, rbx;
        je  mhc_rq_ok;
        // Different holder — contention.
        mov rdi, 2;                      // CONTENDED
        call mhc_note;
        mov rdi, 3;                      // REJECTS
        call mhc_note;
        mov rax, 0xFFFFF84E;
        jmp mhc_rq_out;

      mhc_rq_absent:
        // Scan for free row.
        xor r13, r13;
      mhc_rq_scan:
        cmp r13, 16;
        jae mhc_rq_full;
        mov rdi, r13;
        call mhc_row_in_use;
        cmp rax, 0;
        je  mhc_rq_free;
        add r13, 1;
        jmp mhc_rq_scan;

      mhc_rq_free:
        mov r14, r13;
        shl r14, 5;
        lea r10, [rip + _mhc_claims];
        add r10, r14;
        mov rax, 1;
        mov [r10 + 0], rax;
        mov [r10 + 8], rbx;
        mov [r10 + 16], r12;
        xor rax, rax;
        mov [r10 + 24], rax;

      mhc_rq_ok:
        xor rax, rax;
        jmp mhc_rq_out;

      mhc_rq_full:
        mov rdi, 3;
        call mhc_note;
        mov rax, 0xFFFFF84D;
        jmp mhc_rq_out;
      mhc_rq_bad_host:
        mov rdi, 3;
        call mhc_note;
        mov rax, 0xFFFFF84B;
        jmp mhc_rq_out;
      mhc_rq_bad_arg:
        mov rdi, 3;
        call mhc_note;
        mov rax, 0xFFFFF84F;

      mhc_rq_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // mhc_release — clear a claim held by host_id.
  //
  // Sequence:
  //   1. host_id in valid range
  //   2. adapter fits u8
  //   3. Find claim
  //   4. Holder matches -> clear row
  //   5. Holder differs or absent -> NOT_HELD
  // ==========================================================================

  pub let mhc_release : (u64, u64) -> u64 !{mem} @{} =
    fn (host_id: u64) (downstream_adapter: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-002 (#1227): release a claim. Labels prefixed mhc_rl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;
        mov r12, rsi;

        cmp rbx, 0xFF;
        ja  mhc_rl_bad_host;
        cmp r12, 0xFF;
        ja  mhc_rl_bad_arg;

        mov rdi, r12;
        call mhc_find;
        cmp rax, 0xFF;
        je  mhc_rl_not_held;
        mov r13, rax;

        mov rdi, r13;
        call mhc_row_host;
        cmp rax, rbx;
        jne mhc_rl_not_held;

        mov r14, r13;
        shl r14, 5;
        lea r10, [rip + _mhc_claims];
        add r10, r14;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rdi, 1;                      // RELEASES
        call mhc_note;
        xor rax, rax;
        jmp mhc_rl_out;

      mhc_rl_bad_host:
        mov rdi, 3;
        call mhc_note;
        mov rax, 0xFFFFF84B;
        jmp mhc_rl_out;
      mhc_rl_bad_arg:
        mov rdi, 3;
        call mhc_note;
        mov rax, 0xFFFFF84F;
        jmp mhc_rl_out;
      mhc_rl_not_held:
        mov rdi, 3;
        call mhc_note;
        mov rax, 0xFFFFF84C;

      mhc_rl_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
