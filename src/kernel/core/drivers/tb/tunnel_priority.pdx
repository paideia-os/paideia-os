// src/kernel/core/drivers/tb/tunnel_priority.pdx — R35.M8-003 (#1228)
//
// TB4 TUNNEL PRIORITY POLICY.
//
// When the arbiter (tunnel_arbiter.pdx, R35.M8-001) refuses a new
// reservation because the link is oversubscribed, the requester's
// choice is not always "give up". A DisplayPort tunnel demanded by
// the compositor for a newly-plugged panel is worth more, on a
// human-factors ledger, than an existing USB3 tunnel carrying a
// bulk file copy. A PCIe tunnel carrying block I/O to the boot disk
// is worth more than a USB3 tunnel to a webcam. Somebody has to
// state the ordering, and this module is where the statement lives.
//
// Priority is a small ordinal, LOW-IS-HIGH: 0 is the most important
// class. By default:
//
//     DISPLAY (DP,   tunnel_type=1) => priority 0    (highest)
//     PCIe    (PCIe, tunnel_type=0) => priority 1
//     USB3    (USB3, tunnel_type=2) => priority 2    (lowest)
//
// A dock can OVERRIDE this default. A "media dock" that is primarily
// a video sink might reassert DP > PCIe > USB3 (which matches the
// default); a "storage dock" that fronts an NVMe array might promote
// PCIe above DP. The override table carries per-(domain, type)
// priority values.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ORDERING half of the tunnel-establishment protocol. It:
//
//   1. RESOLVE — tpri_of(domain, tunnel_type) returns the priority
//      ordinal (0 = highest). Reads any per-(domain, type) override
//      row before falling back to the compile-time default.
//
//   2. COMPARE — tpri_may_preempt(new_type, existing_type) at DEFAULT
//      priorities returns 1 iff a new tunnel of `new_type` would
//      preempt an existing tunnel of `existing_type`. Comparison is
//      strict: equal priorities do NOT preempt (the existing tunnel
//      keeps the resource on ties).
//
//   3. OVERRIDE — tpri_override(domain, tunnel_type, priority) stamps
//      a per-dock override row. tpri_clear_override(domain,
//      tunnel_type) removes it. tpri_reset clears the whole table.
//
// IT DOES NOT PERFORM THE PREEMPTION. Actually tearing down the
// existing tunnel (dp_tunnel_ddi_release / pcie_tunnel_deallocate /
// usb3_tunnel_port_free) and re-running arbitration for the new
// tunnel is the CALLER's responsibility. This module only ANSWERS
// the question "would preemption be justified"; the sequencer that
// enacts a yes is R35.M9+.
//
// IT DOES NOT DEFINE FAIRNESS. Two USB3 tunnels of equal priority
// compete on a first-come basis at the arbiter; this module has no
// tiebreaker to add. A future starvation-avoidance policy that
// promotes long-waiting requests belongs in a scheduler above this
// module, not inside it.
//
// tpri_arbitrated() returns 0 until a live sequencer binds this
// module against real preemption decisions.
//
// =============================================================================
// §1  ONE WRITER OF THE STATE
// =============================================================================
//
// _tpri_overrides and _tpri_stats are written only by helpers in this
// module. tools/build.sh confines relocations against each symbol to
// `core/drivers/tb/tunnel_priority.o`.
//
// =============================================================================
// §2  ERROR CODES 0xFFFFF830..0xFFFFF83F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: multi_host_contend 0xFFFFF840..
// 4F).

module TunnelPriority = structure {

  // Row / capacity constants.
  pub let TPRI_OVERRIDE_MAX  : u64 = 8
  pub let TPRI_ROW_U64       : u64 = 4              // 4 u64s per row (32 bytes)

  // Tunnel type ordinals — mirror kind_tb_route.pdx.
  pub let TPRI_TT_PCIE : u64 = 0
  pub let TPRI_TT_DP   : u64 = 1
  pub let TPRI_TT_USB3 : u64 = 2
  pub let TPRI_TT_MAX  : u64 = 2

  // Default priorities (LOW = highest).
  pub let TPRI_DEFAULT_DP   : u64 = 0
  pub let TPRI_DEFAULT_PCIE : u64 = 1
  pub let TPRI_DEFAULT_USB3 : u64 = 2

  // Legal priority range (u8, but the meaningful values are 0..3).
  pub let TPRI_PRIO_MAX : u64 = 0xFF

  // Failure taxonomy — 0xFFFFF830..0xFFFFF83F.
  pub let TPRI_OK          : u64 = 0
  pub let TPRI_BAD_ARG     : u64 = 0xFFFFF83F
  pub let TPRI_BAD_TYPE    : u64 = 0xFFFFF83E
  pub let TPRI_BAD_DOMAIN  : u64 = 0xFFFFF83D
  pub let TPRI_BAD_PRIO    : u64 = 0xFFFFF83C
  pub let TPRI_ENOSPC      : u64 = 0xFFFFF83B
  pub let TPRI_NOT_FOUND   : u64 = 0xFFFFF83A

  pub let TPRI_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TPRI_ROW_NONE   : u64 = 0xFF

  // Override row (4 u64s, 32 bytes):
  //   [+0]  in_use  (0/1)
  //   [+8]  domain_id
  //   [+16] tunnel_type
  //   [+24] priority
  pub let mut _tpri_overrides : [u64; 32] = uninit @align(64)   // 8 rows × 4 u64

  pub let mut _tpri_stats : [u64; 8] = uninit @align(64)

  pub let TPRI_ST_RESOLVES  : u64 = 0
  pub let TPRI_ST_OVERRIDES : u64 = 1
  pub let TPRI_ST_CLEARS    : u64 = 2
  pub let TPRI_ST_PREEMPTS  : u64 = 3              // may_preempt returned 1
  pub let TPRI_ST_REJECTS   : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let tpri_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): clear override rows + stats. Labels prefixed tpri_rs_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        lea r10, [rip + _tpri_overrides];
      tpri_rs_o:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  tpri_rs_o;

        xor rcx, rcx;
        lea r10, [rip + _tpri_stats];
      tpri_rs_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tpri_rs_s;
        ret
      }
    } @no_frame

  pub let tpri_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M8-003 (#1228): honesty pin. Returns 0 until a live sequencer binds preemption.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tpri_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): counter read.",
      block: {
        cmp rdi, 8;
        jae tpri_st_zero;
        lea r10, [rip + _tpri_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tpri_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tpri_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): counter bump. Labels prefixed tpri_nt_.",
      block: {
        cmp rdi, 8;
        jae tpri_nt_out;
        lea r10, [rip + _tpri_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tpri_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row helpers.
  // ==========================================================================

  pub let tpri_row_in_use : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): read row.in_use.",
      block: {
        cmp rdi, 8;
        jae tpri_ri_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;                      // * 32 bytes
        lea r10, [rip + _tpri_overrides];
        add r10, rbx;
        mov rax, [r10 + 0];
        pop rbx;
        ret;
      tpri_ri_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tpri_row_domain : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): read row.domain_id.",
      block: {
        cmp rdi, 8;
        jae tpri_rd_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _tpri_overrides];
        add r10, rbx;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      tpri_rd_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tpri_row_type : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): read row.tunnel_type.",
      block: {
        cmp rdi, 8;
        jae tpri_rt_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _tpri_overrides];
        add r10, rbx;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      tpri_rt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tpri_row_prio : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): read row.priority.",
      block: {
        cmp rdi, 8;
        jae tpri_rp_zero;
        push rbx;
        mov rbx, rdi;
        shl rbx, 5;
        lea r10, [rip + _tpri_overrides];
        add r10, rbx;
        mov rax, [r10 + 24];
        pop rbx;
        ret;
      tpri_rp_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Compile-time default priority.
  //
  // Returns DECODE_BAD on out-of-range type.
  // ==========================================================================

  pub let tpri_default_of : (u64) -> u64 !{} @{} =
    fn (tunnel_type: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M8-003 (#1228): compile-time priority per type. Labels prefixed tpri_dv_.",
      block: {
        cmp rdi, 0;
        je  tpri_dv_pcie;
        cmp rdi, 1;
        je  tpri_dv_dp;
        cmp rdi, 2;
        je  tpri_dv_usb3;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret;
      tpri_dv_pcie:
        mov rax, 1;
        ret;
      tpri_dv_dp:
        xor rax, rax;
        ret;
      tpri_dv_usb3:
        mov rax, 2;
        ret
      }
    } @no_frame

  // ==========================================================================
  // tpri_find_override(domain, tunnel_type) — return row_id or ROW_NONE.
  // ==========================================================================

  pub let tpri_find_override : (u64, u64) -> u64 !{mem} @{} =
    fn (domain_id: u64) (tunnel_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): scan for override row. Labels prefixed tpri_fo_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // domain
        mov r12, rsi;                    // tunnel_type
        xor r13, r13;                    // iterator

      tpri_fo_scan:
        cmp r13, 8;
        jae tpri_fo_none;
        mov rdi, r13;
        call tpri_row_in_use;
        cmp rax, 0;
        je  tpri_fo_next;
        mov rdi, r13;
        call tpri_row_domain;
        cmp rax, rbx;
        jne tpri_fo_next;
        mov rdi, r13;
        call tpri_row_type;
        cmp rax, r12;
        je  tpri_fo_hit;
      tpri_fo_next:
        add r13, 1;
        jmp tpri_fo_scan;

      tpri_fo_hit:
        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      tpri_fo_none:
        mov rax, 0xFF;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tpri_of(domain, tunnel_type) — resolved priority.
  //
  // Consults the override table first, then falls back to the
  // default. Returns DECODE_BAD on out-of-range tunnel_type.
  //
  // domain_id is not range-checked here — this is a lookup, not an
  // authority check. An unknown domain_id simply finds no override.
  // ==========================================================================

  pub let tpri_of : (u64, u64) -> u64 !{mem} @{} =
    fn (domain_id: u64) (tunnel_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): resolved priority. Labels prefixed tpri_ov_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // domain
        mov r12, rsi;                    // tunnel_type

        cmp r12, 2;
        ja  tpri_ov_bad;

        mov rdi, 0;                      // RESOLVES
        call tpri_note;

        mov rdi, rbx;
        mov rsi, r12;
        call tpri_find_override;
        cmp rax, 0xFF;
        je  tpri_ov_default;
        mov rdi, rax;
        call tpri_row_prio;
        pop r12;
        pop rbx;
        ret;

      tpri_ov_default:
        mov rdi, r12;
        call tpri_default_of;
        pop r12;
        pop rbx;
        ret;
      tpri_ov_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tpri_may_preempt(new_type, existing_type) — strict priority
  // compare at DEFAULT priorities.
  //
  // Returns 1 iff default(new_type) < default(existing_type)
  // (LOW-is-HIGH), 0 otherwise. Equal priorities do NOT preempt.
  // Bumps PREEMPTS stat when returning 1.
  //
  // This convenience does NOT consult the override table — callers
  // that want per-domain override should use tpri_of themselves and
  // compare the two ordinals directly.
  // ==========================================================================

  pub let tpri_may_preempt : (u64, u64) -> u64 !{mem} @{} =
    fn (new_type: u64) (existing_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): strict default-priority compare. Labels prefixed tpri_mp_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // new
        mov r12, rsi;                    // existing

        cmp rbx, 2;
        ja  tpri_mp_no;
        cmp r12, 2;
        ja  tpri_mp_no;

        mov rdi, rbx;
        call tpri_default_of;
        push rax;
        mov rdi, r12;
        call tpri_default_of;
        pop rcx;                         // new_prio
        // Preempt iff new_prio < existing_prio.
        cmp rcx, rax;
        jae tpri_mp_no;

        mov rdi, 3;                      // PREEMPTS
        call tpri_note;
        mov rax, 1;
        pop r12;
        pop rbx;
        ret;

      tpri_mp_no:
        xor rax, rax;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tpri_override — stamp a per-(domain, tunnel_type) override.
  //
  // Sequence:
  //   1. tunnel_type in {0, 1, 2}   (BAD_TYPE)
  //   2. priority <= PRIO_MAX       (BAD_PRIO)
  //   3. domain fits u16            (BAD_DOMAIN)
  //   4. Find existing override -> update in place
  //   5. Allocate free row          (ENOSPC on full)
  // ==========================================================================

  pub let tpri_override : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (domain_id: u64) (tunnel_type: u64) (priority: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): stamp override. Labels prefixed tpri_ovr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // domain
        mov r12, rsi;                    // tunnel_type
        mov r13, rdx;                    // priority

        cmp r12, 2;
        ja  tpri_ovr_bad_type;
        cmp r13, 0xFF;
        ja  tpri_ovr_bad_prio;
        mov r10, 0xFFFF;
        cmp rbx, r10;
        ja  tpri_ovr_bad_domain;

        mov rdi, rbx;
        mov rsi, r12;
        call tpri_find_override;
        cmp rax, 0xFF;
        je  tpri_ovr_absent;
        mov r14, rax;                    // existing slot — update in place

        mov r15, r14;
        shl r15, 5;
        lea r10, [rip + _tpri_overrides];
        add r10, r15;
        mov [r10 + 24], r13;
        jmp tpri_ovr_ok;

      tpri_ovr_absent:
        // Scan for free slot.
        xor r14, r14;
      tpri_ovr_scan:
        cmp r14, 8;
        jae tpri_ovr_full;
        mov rdi, r14;
        call tpri_row_in_use;
        cmp rax, 0;
        je  tpri_ovr_free;
        add r14, 1;
        jmp tpri_ovr_scan;

      tpri_ovr_free:
        mov r15, r14;
        shl r15, 5;
        lea r10, [rip + _tpri_overrides];
        add r10, r15;
        mov rax, 1;
        mov [r10 + 0], rax;
        mov [r10 + 8], rbx;
        mov [r10 + 16], r12;
        mov [r10 + 24], r13;

      tpri_ovr_ok:
        mov rdi, 1;                      // OVERRIDES
        call tpri_note;
        xor rax, rax;
        jmp tpri_ovr_out;

      tpri_ovr_full:
        mov rdi, 4;                      // REJECTS
        call tpri_note;
        mov rax, 0xFFFFF83B;
        jmp tpri_ovr_out;
      tpri_ovr_bad_type:
        mov rdi, 4;
        call tpri_note;
        mov rax, 0xFFFFF83E;
        jmp tpri_ovr_out;
      tpri_ovr_bad_prio:
        mov rdi, 4;
        call tpri_note;
        mov rax, 0xFFFFF83C;
        jmp tpri_ovr_out;
      tpri_ovr_bad_domain:
        mov rdi, 4;
        call tpri_note;
        mov rax, 0xFFFFF83D;

      tpri_ovr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tpri_clear_override(domain, tunnel_type) — remove a stamped
  // override. Refuses NOT_FOUND if no override exists for the pair.
  // ==========================================================================

  pub let tpri_clear_override : (u64, u64) -> u64 !{mem} @{} =
    fn (domain_id: u64) (tunnel_type: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M8-003 (#1228): clear override. Labels prefixed tpri_co_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        cmp r12, 2;
        ja  tpri_co_bad_type;

        mov rdi, rbx;
        mov rsi, r12;
        call tpri_find_override;
        cmp rax, 0xFF;
        je  tpri_co_not_found;
        mov r13, rax;

        shl r13, 5;
        lea r10, [rip + _tpri_overrides];
        add r10, r13;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;

        mov rdi, 2;                      // CLEARS
        call tpri_note;
        xor rax, rax;
        jmp tpri_co_out;

      tpri_co_bad_type:
        mov rdi, 4;
        call tpri_note;
        mov rax, 0xFFFFF83E;
        jmp tpri_co_out;
      tpri_co_not_found:
        mov rdi, 4;
        call tpri_note;
        mov rax, 0xFFFFF83A;

      tpri_co_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
