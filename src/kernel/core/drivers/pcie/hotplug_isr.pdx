// src/kernel/core/drivers/pcie/hotplug_isr.pdx — R35.M1-001 (#1195)
//
// PCIe root-port service-interrupt ISR scaffold. Reads Slot Status,
// decodes the four hotplug event bits (presence-detect changed,
// data-link-layer state changed, command completed, power fault),
// clears them write-1-to-clear, and hands the resulting event record
// to pcie_hotplug_channel for subscriber routing.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the DECODE + CLEAR half of a PCIe root-port service interrupt.
// The actual MSI/MSI-X vector arrives through KIND_HW_INTERRUPT (or
// KIND_HW_MSIX_VECTOR); this scaffold's job is to translate a raw Slot
// Status word into one enqueued pcie_hotplug_channel event record.
//
// IT DOES NOT TOUCH REAL MMIO. Slot Status is read via
// pcie_hotplug_isr_read_slot_status, which today is a seam callable by
// tests. A later round wires that seam to the config-space window a
// live PCI root port exposes.
//
// IT DOES NOT REGISTER AN MSI-X VECTOR. That is the composite_bind
// pass a later round runs when the R35.M1 fabric is wired against a
// live root port.
//
// pcie_hotplug_isr_arbitrated() returns 0 until that binding lands.
//
// =============================================================================
// §1  PCIe SLOT STATUS BIT LAYOUT (PCIe base §6.7)
// =============================================================================
//
// Slot Status is a u16 at offset 0x1A of the PCIe Capability. The
// four bits this scaffold consumes:
//
//   bit 0   Attention Button Pressed   (not decoded here)
//   bit 1   Power Fault Detected       -> POWER_FAULT
//   bit 3   Presence Detect Changed    -> PRESENCE_DETECT_CHANGE
//   bit 4   Command Completed          -> COMMAND_COMPLETED
//   bit 8   Data Link Layer State Changed -> DLL_STATE_CHANGE
//
// All are write-1-to-clear. The ISR MUST clear the bit it just
// decoded (otherwise the same edge fires again immediately). The
// clear write is the last mutation the ISR performs on the register
// so a race between decode and clear cannot lose an event.
//
// =============================================================================
// §2  ORDER OF DECODE
// =============================================================================
//
// The four bits are decoded and enqueued in a fixed order that is
// DELIBERATELY the numeric order of the KIND_PCIE_HOTPLUG_EVENT
// event_type ordinal:
//
//   0 PRESENCE_DETECT_CHANGE (bit 3)
//   1 DLL_STATE_CHANGE       (bit 8)
//   2 COMMAND_COMPLETED      (bit 4)
//   3 POWER_FAULT            (bit 1)
//
// A single interrupt frequently raises TWO bits simultaneously
// (presence-detect-changed + DLL-state-changed at insertion, for
// example); this scaffold enqueues both, in the fixed order, so a
// subscriber never has to reason about "which one was reported first
// out of the same interrupt".
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _pcie_hotplug_isr_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/pcie/hotplug_isr.o`.
//
// =============================================================================
// §4  ERROR CODES 0xFFFFFA20..0xFFFFFA2F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: pcie_hp_evt 0xFFFFFA30..3F,
// pcie_hotplug_channel 0xFFFFFA10..1F, pcie_link_retrain
// 0xFFFFFA00..0F).

module HotplugIsr = structure {

  // Slot Status bit positions (PCIe base §6.7).
  pub let PCIE_SS_ATTENTION_BUTTON  : u64 = 0x0001
  pub let PCIE_SS_POWER_FAULT       : u64 = 0x0002
  pub let PCIE_SS_MRL_SENSOR        : u64 = 0x0004
  pub let PCIE_SS_PRESENCE_CHANGED  : u64 = 0x0008
  pub let PCIE_SS_COMMAND_COMPLETED : u64 = 0x0010
  pub let PCIE_SS_PRESENCE_DETECT   : u64 = 0x0040
  pub let PCIE_SS_DLL_STATE_CHANGED : u64 = 0x0100

  // Aggregate mask of the four bits this ISR clears write-1-to-clear.
  pub let PCIE_SS_HANDLED_MASK : u64 = 0x011A

  // Failure taxonomy — 0xFFFFFA20..0xFFFFFA2F.
  pub let PCIE_ISR_OK          : u64 = 0
  pub let PCIE_ISR_BAD_ARG     : u64 = 0xFFFFFA2F
  pub let PCIE_ISR_BAD_STATUS  : u64 = 0xFFFFFA2E
  pub let PCIE_ISR_ENQUEUE_ERR : u64 = 0xFFFFFA2D
  pub let PCIE_ISR_NO_EVENT    : u64 = 0xFFFFFA2C

  pub let mut _pcie_hotplug_isr_stats : [u64; 8] = uninit @align(64)

  pub let PCIE_ISR_ST_INTERRUPTS : u64 = 0
  pub let PCIE_ISR_ST_PRESENCE   : u64 = 1
  pub let PCIE_ISR_ST_DLL_CHANGE : u64 = 2
  pub let PCIE_ISR_ST_CMD_DONE   : u64 = 3
  pub let PCIE_ISR_ST_POWER_FLT  : u64 = 4
  pub let PCIE_ISR_ST_SPURIOUS   : u64 = 5
  pub let PCIE_ISR_ST_REJECTS    : u64 = 6

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let pcie_hotplug_isr_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-001 (#1195): clear stats. Labels prefixed piso_rs_.",
      block: {
        lea r10, [rip + _pcie_hotplug_isr_stats];
        xor rax, rax;
        xor rcx, rcx;
      piso_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  piso_rs_loop;
        ret
      }
    } @no_frame

  pub let pcie_hotplug_isr_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-001 (#1195): honesty pin. Returns 0 until a later round binds this against a real PCIe root port MSI-X vector.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pcie_hotplug_isr_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-001 (#1195): counter read. Labels prefixed piso_st_.",
      block: {
        cmp rdi, 8;
        jae piso_st_zero;
        lea r10, [rip + _pcie_hotplug_isr_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      piso_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pcie_hotplug_isr_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-001 (#1195): counter bump. Labels prefixed piso_nt_.",
      block: {
        cmp rdi, 8;
        jae piso_nt_out;
        lea r10, [rip + _pcie_hotplug_isr_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      piso_nt_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // pcie_hotplug_isr_decode(slot_status) -> event_bitmap
  //
  // Returns which handled-event bits are raised, as an OR of
  //   0x1 PRESENCE_DETECT_CHANGE
  //   0x2 DLL_STATE_CHANGE
  //   0x4 COMMAND_COMPLETED
  //   0x8 POWER_FAULT
  // ==========================================================================

  pub let pcie_hotplug_isr_decode : (u64) -> u64 !{} @{} =
    fn (slot_status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-001 (#1195): decode Slot Status bits into a compact event bitmap. Labels prefixed piso_dc_.",
      block: {
        xor rax, rax;
        mov r10, rdi;
        and r10, 0x0008;                 // PRESENCE_CHANGED bit 3
        cmp r10, 0;
        je  piso_dc_skip1;
        or  rax, 0x1;
      piso_dc_skip1:
        mov r10, rdi;
        and r10, 0x0100;                 // DLL_STATE_CHANGED bit 8
        cmp r10, 0;
        je  piso_dc_skip2;
        or  rax, 0x2;
      piso_dc_skip2:
        mov r10, rdi;
        and r10, 0x0010;                 // COMMAND_COMPLETED bit 4
        cmp r10, 0;
        je  piso_dc_skip3;
        or  rax, 0x4;
      piso_dc_skip3:
        mov r10, rdi;
        and r10, 0x0002;                 // POWER_FAULT bit 1
        cmp r10, 0;
        je  piso_dc_skip4;
        or  rax, 0x8;
      piso_dc_skip4:
        ret
      }
    } @no_frame

  // ==========================================================================
  // pcie_hotplug_isr_clear_mask(slot_status) -> u16 to write back
  //
  // Returns the write-1-to-clear mask (the same bits that were
  // decoded) so the caller may issue the MMIO write. This is a pure
  // function; the actual write happens through the register seam.
  // ==========================================================================

  pub let pcie_hotplug_isr_clear_mask : (u64) -> u64 !{} @{} =
    fn (slot_status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-001 (#1195): return which handled bits to write-1-to-clear. Labels prefixed piso_cm_.",
      block: {
        mov rax, rdi;
        and rax, 0x011A;                 // PCIE_SS_HANDLED_MASK
        ret
      }
    } @no_frame

  // ==========================================================================
  // pcie_hotplug_isr_service(bdf, slot_status) -> u64 count
  //
  // Given a bdf and a Slot Status snapshot, enqueue every raised
  // event on pcie_hotplug_channel. Returns the number of events
  // enqueued (0..4).
  //
  // This is the wiring the composite_bind pass would install as the
  // MSI-X vector handler. Live MMIO reads and writes remain outside
  // the scaffold.
  // ==========================================================================

  pub let pcie_hotplug_isr_service : (u64, u64) -> u64 !{mem} @{} =
    fn (bdf: u64) (slot_status: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-001 (#1195): decode + enqueue every raised event, in the fixed order (§2). Refuses bdf > 0xFFFF (BAD_ARG). Bumps INTERRUPTS on entry and the per-event counter for each enqueued event. Returns count enqueued. Labels prefixed piso_sv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r15, rdi;                    // bdf
        mov r14, rsi;                    // slot_status
        xor r13, r13;                    // count

        mov r10, 0xFFFF;
        cmp r15, r10;
        ja  piso_sv_bad;
        mov r10, 0xFFFF;
        cmp r14, r10;
        ja  piso_sv_bad;

        mov rdi, 0;                      // INTERRUPTS
        call pcie_hotplug_isr_note;

        mov rdi, r14;
        call pcie_hotplug_isr_decode;
        mov rbx, rax;                    // event bitmap

        cmp rbx, 0;
        jne piso_sv_do;
        mov rdi, 5;                      // SPURIOUS
        call pcie_hotplug_isr_note;
        jmp piso_sv_done;

      piso_sv_do:
        // PRESENCE_DETECT_CHANGE (0x1)
        mov r10, rbx;
        and r10, 0x1;
        cmp r10, 0;
        je  piso_sv_sk_p;
        mov rdi, r15;                    // bdf
        mov rsi, 0;                      // event_type
        mov rdx, r14;                    // port_status
        call pcie_hotplug_channel_enqueue;
        cmp rax, 0;
        jne piso_sv_rej;
        mov rdi, 1;                      // PRESENCE
        call pcie_hotplug_isr_note;
        add r13, 1;
      piso_sv_sk_p:
        // DLL_STATE_CHANGE (0x2)
        mov r10, rbx;
        and r10, 0x2;
        cmp r10, 0;
        je  piso_sv_sk_d;
        mov rdi, r15;
        mov rsi, 1;
        mov rdx, r14;
        call pcie_hotplug_channel_enqueue;
        cmp rax, 0;
        jne piso_sv_rej;
        mov rdi, 2;                      // DLL_CHANGE
        call pcie_hotplug_isr_note;
        add r13, 1;
      piso_sv_sk_d:
        // COMMAND_COMPLETED (0x4)
        mov r10, rbx;
        and r10, 0x4;
        cmp r10, 0;
        je  piso_sv_sk_c;
        mov rdi, r15;
        mov rsi, 2;
        mov rdx, r14;
        call pcie_hotplug_channel_enqueue;
        cmp rax, 0;
        jne piso_sv_rej;
        mov rdi, 3;                      // CMD_DONE
        call pcie_hotplug_isr_note;
        add r13, 1;
      piso_sv_sk_c:
        // POWER_FAULT (0x8)
        mov r10, rbx;
        and r10, 0x8;
        cmp r10, 0;
        je  piso_sv_sk_f;
        mov rdi, r15;
        mov rsi, 3;
        mov rdx, r14;
        call pcie_hotplug_channel_enqueue;
        cmp rax, 0;
        jne piso_sv_rej;
        mov rdi, 4;                      // POWER_FLT
        call pcie_hotplug_isr_note;
        add r13, 1;
      piso_sv_sk_f:

      piso_sv_done:
        mov rax, r13;
        jmp piso_sv_out;

      piso_sv_rej:
        mov rdi, 6;                      // REJECTS
        call pcie_hotplug_isr_note;
        mov rax, 0xFFFFFA2D;
        jmp piso_sv_out;
      piso_sv_bad:
        mov rax, 0xFFFFFA2F;

      piso_sv_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
