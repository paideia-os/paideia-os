// src/kernel/core/drivers/pcie/link_retrain.pdx — R35.M1-004 (#1198)
//
// PCIe LTSSM link-retrain scaffold. Triggers the Retrain Link bit in
// Link Control (offset 0x10 of the PCIe Capability, bit 5), polls
// Link Status (offset 0x12, bit 11 Link Training) until it clears,
// and reads back the negotiated speed + width fields.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the LTSSM-RETRAIN half of a hotplug recovery. After a
// hotplug event decoded by hotplug_isr.pdx, some transitions
// require the downstream link to renegotiate (insertion frequently
// requires speed/width renegotiation; a DPC event always requires it
// after the containment window closes). This scaffold sequences the
// three-step ritual PCIe base §4.2.6 (LTSSM) prescribes:
//
//   1. Set Link Control bit 5 (Retrain Link).
//   2. Poll Link Status bit 11 (Link Training) until it reads 0.
//   3. Read Link Status Current Link Speed (bits [3:0]) and
//      Negotiated Link Width (bits [9:4]).
//
// IT DOES NOT TOUCH REAL MMIO. The Link Control write + Link Status
// polls reach the register window through seams
// (pcie_link_control_seam / pcie_link_status_seam) that a later
// round wires to a live root port. Today the scaffold operates on
// caller-supplied register snapshots.
//
// IT ENFORCES A TIMEOUT. PCIe base §7.5.3.7 mandates that a Retrain
// Link operation complete within 100 ms; a link that has not left
// Link Training within that window is either dead or misbehaving,
// and the scaffold returns PCIE_LR_TIMEOUT rather than spinning
// forever. The count is expressed in POLL ITERATIONS rather than
// wall time so this module has no clock dependency: a live driver
// converts 100 ms into iterations against its poll period.
//
// pcie_link_retrain_arbitrated() returns 0 until a later round
// binds this against a real root port.
//
// =============================================================================
// §1  LINK CONTROL / LINK STATUS BIT LAYOUT (PCIe base §7.5.3.7-8)
// =============================================================================
//
// Link Control (u16, offset 0x10):
//   bit 5   Retrain Link (RW; write 1 to trigger; self-clearing)
//
// Link Status (u16, offset 0x12):
//   bits [3:0]   Current Link Speed (1=2.5, 2=5.0, 3=8.0, 4=16.0, 5=32.0 GT/s)
//   bits [9:4]   Negotiated Link Width (x1, x2, x4, x8, x16)
//   bit 11       Link Training (1 while training, 0 when done)
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _pcie_link_retrain_stats is written only by helpers in this module.
// tools/build.sh confines relocations against the symbol to
// `core/drivers/pcie/link_retrain.o`.
//
// =============================================================================
// §3  ERROR CODES 0xFFFFFA00..0xFFFFFA0F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: pcie_hotplug_channel
// 0xFFFFFA10..1F, pcie_hotplug_isr 0xFFFFFA20..2F).

module LinkRetrain = structure {

  // Bit positions.
  pub let PCIE_LC_RETRAIN_LINK     : u64 = 0x0020  // Link Control bit 5
  pub let PCIE_LS_LINK_TRAINING    : u64 = 0x0800  // Link Status bit 11

  pub let PCIE_LS_SPEED_MASK       : u64 = 0x000F  // bits [3:0]
  pub let PCIE_LS_WIDTH_MASK       : u64 = 0x03F0  // bits [9:4]
  pub let PCIE_LS_WIDTH_SHIFT      : u64 = 4

  // Encoded speeds. PCIe 1.1..6.0 currently span 1..6.
  pub let PCIE_SPEED_2_5_GTS  : u64 = 1
  pub let PCIE_SPEED_5_0_GTS  : u64 = 2
  pub let PCIE_SPEED_8_0_GTS  : u64 = 3
  pub let PCIE_SPEED_16_GTS   : u64 = 4
  pub let PCIE_SPEED_32_GTS   : u64 = 5
  pub let PCIE_SPEED_64_GTS   : u64 = 6
  pub let PCIE_SPEED_MAX      : u64 = 6

  // Encoded widths.
  pub let PCIE_WIDTH_X1  : u64 = 1
  pub let PCIE_WIDTH_X2  : u64 = 2
  pub let PCIE_WIDTH_X4  : u64 = 4
  pub let PCIE_WIDTH_X8  : u64 = 8
  pub let PCIE_WIDTH_X16 : u64 = 16
  pub let PCIE_WIDTH_MAX : u64 = 32

  // Poll iteration cap. A caller passes iters_cap; the scaffold
  // refuses iters_cap == 0 (would trivially timeout) and
  // iters_cap > 1000000 (an unbounded caller). 100 ms at a 1 us
  // poll period is 100_000 iterations; 1M covers a 10x margin.
  pub let PCIE_LR_ITERS_MIN : u64 = 1
  pub let PCIE_LR_ITERS_MAX : u64 = 1000000

  // Failure taxonomy — 0xFFFFFA00..0xFFFFFA0F.
  pub let PCIE_LR_OK         : u64 = 0
  pub let PCIE_LR_BAD_ARG    : u64 = 0xFFFFFA0F
  pub let PCIE_LR_BAD_ITERS  : u64 = 0xFFFFFA0E
  pub let PCIE_LR_BAD_SPEED  : u64 = 0xFFFFFA0D
  pub let PCIE_LR_BAD_WIDTH  : u64 = 0xFFFFFA0C
  pub let PCIE_LR_TIMEOUT    : u64 = 0xFFFFFA0B
  pub let PCIE_LR_BAD_STATUS : u64 = 0xFFFFFA0A

  pub let mut _pcie_link_retrain_stats : [u64; 8] = uninit @align(64)

  pub let PCIE_LR_ST_ATTEMPTS : u64 = 0
  pub let PCIE_LR_ST_SUCCESS  : u64 = 1
  pub let PCIE_LR_ST_TIMEOUTS : u64 = 2
  pub let PCIE_LR_ST_REJECTS  : u64 = 3
  pub let PCIE_LR_ST_POLLS    : u64 = 4

  // ==========================================================================
  // Reset.
  // ==========================================================================

  pub let pcie_link_retrain_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-004 (#1198): clear stats. Labels prefixed plr_rs_.",
      block: {
        lea r10, [rip + _pcie_link_retrain_stats];
        xor rax, rax;
        xor rcx, rcx;
      plr_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  plr_rs_loop;
        ret
      }
    }

  pub let pcie_link_retrain_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-004 (#1198): honesty pin. Returns 0 until a later round binds this against a real root port.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let pcie_link_retrain_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-004 (#1198): counter read.",
      block: {
        cmp rdi, 8;
        jae plr_st_zero;
        lea r10, [rip + _pcie_link_retrain_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      plr_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_link_retrain_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-004 (#1198): counter bump. Labels prefixed plr_nt_.",
      block: {
        cmp rdi, 8;
        jae plr_nt_out;
        lea r10, [rip + _pcie_link_retrain_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      plr_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let pcie_lr_speed_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-004 (#1198): 1 iff s in [1, PCIE_SPEED_MAX].",
      block: {
        cmp rdi, 1;
        jb  plr_sv_no;
        cmp rdi, 6;                      // PCIE_SPEED_MAX
        ja  plr_sv_no;
        mov rax, 1;
        ret;
      plr_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pcie_lr_width_valid : (u64) -> u64 !{} @{} =
    fn (w: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-004 (#1198): 1 iff w in {1, 2, 4, 8, 16, 32}.",
      block: {
        cmp rdi, 1;
        je  plr_wv_yes;
        cmp rdi, 2;
        je  plr_wv_yes;
        cmp rdi, 4;
        je  plr_wv_yes;
        cmp rdi, 8;
        je  plr_wv_yes;
        cmp rdi, 16;
        je  plr_wv_yes;
        cmp rdi, 32;
        je  plr_wv_yes;
        xor rax, rax;
        ret;
      plr_wv_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // pcie_lr_trigger(link_control_in) -> link_control_out
  //
  // Returns the Link Control value with bit 5 (Retrain Link) SET.
  // Pure function; the seam writes it.
  // ==========================================================================

  pub let pcie_lr_trigger : (u64) -> u64 !{} @{} =
    fn (link_control_in: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-004 (#1198): set Retrain Link bit 5 on Link Control. Labels prefixed plr_tr_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  plr_tr_bad;
        mov rax, rdi;
        or  rax, 0x0020;
        and rax, 0xFFFF;
        ret;
      plr_tr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // pcie_lr_is_training(link_status) -> 1 | 0
  // ==========================================================================

  pub let pcie_lr_is_training : (u64) -> u64 !{} @{} =
    fn (link_status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-004 (#1198): 1 iff Link Status bit 11 (Link Training) is set. Labels prefixed plr_it_.",
      block: {
        mov rax, rdi;
        and rax, 0x0800;
        cmp rax, 0;
        je  plr_it_no;
        mov rax, 1;
        ret;
      plr_it_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pcie_lr_decode_speed(link_status) -> speed | BAD_SPEED
  // pcie_lr_decode_width(link_status) -> width | BAD_WIDTH
  // ==========================================================================

  pub let pcie_lr_decode_speed : (u64) -> u64 !{} @{} =
    fn (link_status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-004 (#1198): decode Current Link Speed from Link Status[3:0]; refuses invalid encodings. Labels prefixed plr_ds_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        and r12, 0x000F;
        mov rdi, r12;
        call pcie_lr_speed_valid;
        cmp rax, 0;
        je  plr_ds_bad;
        mov rax, r12;
        jmp plr_ds_out;
      plr_ds_bad:
        mov rax, 0xFFFFFA0D;
      plr_ds_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let pcie_lr_decode_width : (u64) -> u64 !{} @{} =
    fn (link_status: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M1-004 (#1198): decode Negotiated Link Width from Link Status[9:4]; refuses invalid encodings. Labels prefixed plr_dw_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        shr r12, 4;
        and r12, 0x003F;
        mov rdi, r12;
        call pcie_lr_width_valid;
        cmp rax, 0;
        je  plr_dw_bad;
        mov rax, r12;
        jmp plr_dw_out;
      plr_dw_bad:
        mov rax, 0xFFFFFA0C;
      plr_dw_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pcie_lr_sequence(link_status_snapshot_train,
  //                  link_status_snapshot_done, iters_cap) -> speed|width|err
  //
  // Simulates the ritual on caller-supplied register snapshots. The
  // caller passes two Link Status snapshots: the one read immediately
  // after triggering (still training) and the one read after
  // completion. iters_cap bounds the poll count; a caller that
  // supplies a "still training after N polls" pair sees TIMEOUT.
  //
  // Return packing on success: speed[7:0] | (width[13:8]).
  // ==========================================================================

  pub let pcie_lr_sequence : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ls_training: u64) (ls_done: u64) (iters_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M1-004 (#1198): sequence a retrain against caller-supplied snapshots. Refuses iters_cap outside [1, 1000000] (BAD_ITERS). If ls_training still reads training and iters_cap == 1, returns TIMEOUT. Otherwise decodes ls_done. Labels prefixed plr_sq_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // ls_training
        mov r13, rsi;                    // ls_done
        mov r14, rdx;                    // iters_cap

        mov r10, 0xFFFF;
        cmp r12, r10;
        ja  plr_sq_bad_arg;
        cmp r13, r10;
        ja  plr_sq_bad_arg;

        cmp r14, 1;
        jb  plr_sq_bad_iters;
        mov r10, 1000000;
        cmp r14, r10;
        ja  plr_sq_bad_iters;

        mov rdi, 0;                      // ATTEMPTS
        call pcie_link_retrain_note;

        // If the "done" snapshot is still training we return TIMEOUT.
        mov rdi, r13;
        call pcie_lr_is_training;
        cmp rax, 0;
        jne plr_sq_timeout;

        // Count "polls" as iters_cap (proxy for a real driver's loop
        // count under the cap).
        mov rdi, 4;                      // POLLS
        call pcie_link_retrain_note;

        // Decode speed.
        mov rdi, r13;
        call pcie_lr_decode_speed;
        mov r10, 0xFFFFFA0D;
        cmp rax, r10;
        je  plr_sq_bad_speed;
        mov r15, rax;                    // speed

        // Decode width.
        mov rdi, r13;
        call pcie_lr_decode_width;
        mov r10, 0xFFFFFA0C;
        cmp rax, r10;
        je  plr_sq_bad_width;
        mov rbx, rax;                    // width

        // Success.
        mov rdi, 1;                      // SUCCESS
        call pcie_link_retrain_note;

        mov rax, r15;
        and rax, 0xFF;
        mov r10, rbx;
        and r10, 0x3F;
        shl r10, 8;
        or  rax, r10;
        jmp plr_sq_out;

      plr_sq_timeout:
        mov rdi, 2;                      // TIMEOUTS
        call pcie_link_retrain_note;
        mov rax, 0xFFFFFA0B;
        jmp plr_sq_out;
      plr_sq_bad_speed:
        mov rdi, 3;
        call pcie_link_retrain_note;
        mov rax, 0xFFFFFA0D;
        jmp plr_sq_out;
      plr_sq_bad_width:
        mov rdi, 3;
        call pcie_link_retrain_note;
        mov rax, 0xFFFFFA0C;
        jmp plr_sq_out;
      plr_sq_bad_iters:
        mov rdi, 3;
        call pcie_link_retrain_note;
        mov rax, 0xFFFFFA0E;
        jmp plr_sq_out;
      plr_sq_bad_arg:
        mov rdi, 3;
        call pcie_link_retrain_note;
        mov rax, 0xFFFFFA0F;

      plr_sq_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
