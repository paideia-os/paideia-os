// src/kernel/core/drivers/fb_glyph.pdx — R23-M2-001 (#879)
//
// Glyph rasterizer for the framebuffer console.  Splats one 8x16 glyph
// from the embedded font blob (_fb_font, populated at R23.M1 #877) into
// the linear framebuffer at a given pixel origin.
//
// Round: R23 — Framebuffer console (GOP direct)
// Milestone: R23.M2 rasterizer + console + ANSI + write API
// Roadmap: design/roadmap/r18-plus-bare-metal.md §R23
// Encoder floor: paideia-as v0.20.1 (mov_d for u32 stores, shl/shr r64
//                imm8, imul r64, r64 — all R21.M5 / R20.M3 baseline).
//
// ==============================================================================
// draw_glyph(fb_base, pitch, x, y, glyph_idx, fg_bg) -> void
// ==============================================================================
//
// paideia-as caps at 6 SysV register args.  fg + bg are packed into one
// u64 by the caller:
//
//   fg_bg = (bg << 32) | (fg & 0xFFFFFFFF)
//
// so the caller's shared attribute value can be constant-hoisted across
// many draw_glyph calls (fb_console_init / redraw / putchar all reuse a
// single (fg,bg) pair for a whole glyph).
//
// The framebuffer is assumed 32-bpp BGRA (EFI_PIXEL_BGR_8888, the QEMU
// stdvga + Intel Raptor Lake T14 G4 default).  Each pixel is a u32 in
// LE memory order [B, G, R, A]; the caller precomputes fg / bg as the
// u32 hex value shaped for that layout.
//
// Pixel address arithmetic:
//   glyph_top_left = fb_base + y * pitch + x * 4
//   row_start[r]   = glyph_top_left + r * pitch
//   pixel[r][c]    = row_start[r] + c * 4
//
// Font row bitmap:
//   For row r, fb_font_row(glyph_idx, r) returns an 8-bit bitmap where
//   bit 7 (0x80) is the leftmost pixel and bit 0 (0x01) is the rightmost.
//   Set bits render fg, clear bits render bg.
//
// No bounds check on (x, y) — caller (fb_console_putchar / redraw_all)
// derives (x, y) from grid coordinates and cols/rows dimensions that
// are locked to the framebuffer's width/height at fb_console_init.
//
// ==============================================================================
// Register / stack discipline
// ==============================================================================
//
// SysV inputs on entry:
//   rdi = fb_base       (VA of framebuffer, WC-mapped per R23.M1 #875)
//   rsi = pitch         (bytes per scanline)
//   rdx = x             (pixel column of glyph top-left)
//   rcx = y             (pixel row of glyph top-left)
//   r8  = glyph_idx     (0..256)
//   r9  = fg_bg         (low 32 = fg pixel, high 32 = bg pixel)
//
// Prologue: 5 callee-save pushes (rbx, r12, r13, r14, r15) — entry
// rsp%16 == 8, +40 = rsp%16 == 0.  Plus `sub rsp, 16` for a row-index
// scratch slot ([rsp+0] = row_idx) that survives the fb_font_row call.
// rsp%16 stays 0 across nested calls (fb_font_row is a leaf; no further
// alignment work needed).
//
// Callee-save allocation across the body:
//   rbx = row_addr_base    (fb_base + y * pitch + x * 4 = glyph top-left)
//   r12 = pitch            (stride between successive rows)
//   r13 = glyph_idx        (survives fb_font_row calls; passed as rdi)
//   r14 = fg               (low 32 of fg_bg, u32-in-u64)
//   r15 = bg               (high 32 of fg_bg, u32-in-u64)
//
// Scratch / caller-save inside the loop body:
//   rax = font byte (from fb_font_row) / running-mask tempora
//   rcx = row_start / mask
//   rdi = row_bits copy / arg to fb_font_row
//   rsi = arg to fb_font_row
//   r8  = column counter (0..8)
//   r9  = pixel address
//   r10 = bit test tempora
//
// ==============================================================================
// Encoder-gap workarounds
// ==============================================================================
//
// G1: mov [mem], reg32 widens to REX.W 8-byte store — use `mov_d` for
// all 32-bit pixel writes into WC-mapped LFB.  A REX.W store would
// clobber the next pixel (or the last pixel of the previous row when
// c == 7) with the top 32 bits of the source register (bg high bits are
// zero — but fg high bits are also zero, so this is a latent instead of
// immediate bug; correctness is preserved either way because both fg
// and bg fit in u32).  The `mov_d` form is disciplined per hpet.pdx L166
// (R20.M3 mandate).
//
// ==============================================================================
// Instruction floor
// ==============================================================================
//
// - push / pop r64        (R11 encoder)
// - sub / add rsp, imm8   (R11 encoder)
// - mov r64, r64          (R11 encoder)
// - imul r64, r64         (R21.M5 / tsc.pdx precedent)
// - shl / shr r64, imm8   (R11 encoder)
// - and / or  r64, r64    (R11 encoder)
// - and rax, imm32        (R11 encoder)
// - mov r64, imm32/imm64  (R11 encoder)
// - mov_d [mem], r32      (G1 workaround; hpet/madt/fadt precedents)
// - cmp / jae / je / jne / jmp   (R11 flow)
// - call rel32            (R11 encoder)

module FbGlyph = structure {

  // ==========================================================================
  // draw_glyph : (u64, u64, u64, u64, u64, u64) -> ()
  // ==========================================================================
  //
  // Rasterize glyph_idx at pixel origin (x, y) in the framebuffer whose
  // top-left VA is fb_base and scanline stride is pitch (bytes).  Colors
  // are packed as fg_bg = (bg << 32) | (fg & 0xFFFFFFFF), both 32-bpp
  // pre-shaped pixel values suitable for direct u32 store into the LFB.
  //
  // ==========================================================================
  pub let draw_glyph : (u64, u64, u64, u64, u64, u64) -> () !{mem} @{} =
    fn (fb_base: u64) (pitch: u64) (x: u64) (y: u64) (glyph_idx: u64) (fg_bg: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R23-M2-001 (#879): rasterize one 8x16 glyph from the embedded font blob (_fb_font, R23.M1 #877) into the WC-mapped LFB at pixel origin (x, y).  Caller packs fg/bg into fg_bg = (bg << 32) | fg so paideia-as's 6-register SysV cap is respected without stack args (fg + bg are constant across long spans of draw_glyph calls in fb_console_init redraw and fb_console_putchar hot path; hoisting the pack into the caller avoids a per-glyph shl+or).  Assumes 32-bpp BGR_8888 (EFI_PIXEL_BGR_8888 = 1, the QEMU stdvga + Intel PCH default); caller pre-shapes fg / bg as u32 hex values in BGRA memory-byte order (0x00_RR_GG_BB when written LE).  Register plan: 5 callee-save pushes (rbx=row_addr_base=fb_base + y*pitch + x*4; r12=pitch; r13=glyph_idx; r14=fg; r15=bg) + sub rsp, 16 for a row_idx scratch slot ([rsp+0]) that survives the fb_font_row call.  entry rsp%16==8, +40 (5 pushes) = 0, +16 (sub) = 0 — leaf callee (fb_font_row) sees the aligned rsp.  Body: (i) compute glyph_top_left = fb_base + y*pitch + x*4 via imul + shl + add sequence; (ii) 16-iteration row loop; (iii) per row: fb_font_row(glyph_idx, row_idx) -> font_bits (byte in rax); (iv) 8-iteration col loop with running mask starting at 0x80 and shifted right by 1 per pixel; (v) pixel address = row_start + col*4; (vi) fg or bg u32 pixel written via mov_d (G1 workaround — plain `mov [mem], r32` widens to 8-byte store, which would clobber the neighbouring pixel or scanline).  fb_font_row clobbers rax/rcx/rdx/rdi/rsi/r8 (SysV caller-save + its internal scratch); all state we need across the call lives in callee-saves (rbx/r12/r13/r14/r15) or the stack scratch slot.  No bounds check on (x, y) — caller (fb_console_putchar / redraw_all) derives grid coordinates from cols/rows locked to the framebuffer's width/height at fb_console_init time so pixel writes always land inside the mapped [FB_MAP_VA_BASE, FB_MAP_VA_BASE + fb_size) window.  No fingerprint (hot-path rasterizer; fb_console_init emits the once-per-boot console banner).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                              // scratch: [rsp+0] = row_idx

        // ------------------------------------------------------------
        // (i) Compute glyph_top_left = fb_base + y * pitch + x * 4.
        // ------------------------------------------------------------
        mov rax, rcx;                             // rax = y
        imul rax, rsi;                            // rax = y * pitch
        add rax, rdi;                             // rax = fb_base + y*pitch
        mov r10, rdx;                             // r10 = x
        shl r10, 2;                               // r10 = x * 4  (32-bpp)
        add rax, r10;                             // rax = fb_base + y*pitch + x*4
        mov rbx, rax;                             // rbx = row_addr_base (row 0)

        mov r12, rsi;                             // r12 = pitch
        mov r13, r8;                              // r13 = glyph_idx

        // Split fg_bg into fg (low 32) and bg (high 32).
        mov r14, r9;
        mov rax, 0xFFFFFFFF;
        and r14, rax;                             // r14 = fg (masked to u32)

        mov r15, r9;
        shr r15, 32;                              // r15 = bg (upper 32 -> low)

        // Row counter = 0.
        xor rax, rax;
        mov [rsp + 0], rax;                       // row_idx = 0

      draw_glyph_row_loop:
        mov rax, [rsp + 0];
        cmp rax, 16;
        jae draw_glyph_done;

        // ----------------------------------------------------------
        // (iii) Fetch font row bitmap.  fb_font_row(glyph, row).
        //       Clobbers rax/rcx/rdx/rdi/rsi/r8 (SysV caller-save).
        // ----------------------------------------------------------
        mov rdi, r13;                             // arg 0 = glyph_idx
        mov rsi, rax;                             // arg 1 = row_idx
        call fb_font_row;                         // rax = font byte

        mov rdi, rax;                             // rdi = font_bits (survive col loop)

        // ----------------------------------------------------------
        // (v) row_start = row_addr_base + row_idx * pitch
        // ----------------------------------------------------------
        mov rcx, [rsp + 0];                       // rcx = row_idx (reload)
        imul rcx, r12;                            // rcx = row_idx * pitch
        add rcx, rbx;                             // rcx = row_start

        // ----------------------------------------------------------
        // (iv) 8-iteration col loop with running mask.
        //      mask starts at 0x80 (leftmost pixel = bit 7).
        // ----------------------------------------------------------
        mov rax, 0x80;                            // rax = bit mask (running)
        xor r8, r8;                               // r8  = col = 0

      draw_glyph_col_loop:
        cmp r8, 8;
        jae draw_glyph_col_done;

        // pixel_addr = row_start + col * 4
        mov r9, r8;
        shl r9, 2;                                // r9 = col * 4
        add r9, rcx;                              // r9 = &pixel

        // test bit
        mov r10, rdi;                             // r10 = font_bits
        and r10, rax;                             // r10 = font_bits & mask
        jz  draw_glyph_pixel_bg;

        // fg pixel — mov_d for 32-bit sized store (G1).
        mov_d [r9 + 0], r14;
        jmp draw_glyph_pixel_done;

      draw_glyph_pixel_bg:
        mov_d [r9 + 0], r15;                      // bg pixel — 32-bit sized store

      draw_glyph_pixel_done:
        shr rax, 1;                               // mask >>= 1
        add r8, 1;                                // col++
        jmp draw_glyph_col_loop;

      draw_glyph_col_done:
        // Advance row_idx.
        mov rcx, [rsp + 0];
        add rcx, 1;
        mov [rsp + 0], rcx;
        jmp draw_glyph_row_loop;

      draw_glyph_done:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
