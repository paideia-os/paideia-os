// src/kernel/core/drivers/fb_font.pdx — R23-M1-003 (#877) + R23-M1-004 (#878)
//
// Embedded 8x16 bitmap font for the framebuffer console (deferred rasterizer
// is #879 / R23.M2).  This file provides the SUBSTRATE — a .rodata symbol
// holding 4096 bytes (256 glyphs x 16 rows x 1 byte/row) and a leaf accessor
// fb_font_row(glyph, row) that returns the byte bitmap for one row.
//
// Round: R23 — Framebuffer console (GOP direct)
// Milestone: R23.M1 LFB map + PAT + font
// Roadmap: design/roadmap/r18-plus-bare-metal.md §R23
// Encoder floor: paideia-as v0.20.1 + @include_bytes (v0.19 / issue #1013).
//
// ==============================================================================
// Layout
// ==============================================================================
//
// _fb_font : [u8; 4096]
//   Row-major, glyph-major.  Byte at offset (glyph_idx * 16 + row_idx) holds
//   the 8-pixel bitmap for row `row_idx` (0 = top) of glyph `glyph_idx`.
//   Bit 7 (0x80) of a row byte is the leftmost pixel; bit 0 (0x01) is the
//   rightmost.  A set bit renders foreground, a clear bit renders background
//   (rasterizer's job — deferred to #879).
//
// @align(64) — cacheline alignment.  The rasterizer will load consecutive
// glyph rows via aligned loads; 64-byte alignment guarantees no glyph-row
// straddles two cachelines (16 rows/glyph fit exactly in one cacheline).
//
// ==============================================================================
// Font source
// ==============================================================================
//
// The blob is embedded via paideia-as @include_bytes from
// assets/fonts/vga8x16.bin at the repo root.  Path is resolved relative to
// this .pdx file's directory (per paideia-as-parser/src/parse_primary.rs
// resolve_and_read_embed's with_source_dir join).
//
// R23.M1 asset content: 256 * 16 bytes, mostly zero.  ASCII 0x21..0x7E get
// a placeholder alternating-row pattern (0xAA / 0x55) so downstream visual
// verification (once the rasterizer lands in #879) shows something, not a
// blank screen.  R23.M2 replaces the asset with actual public-domain
// vgacon-8x16 glyph data (Linux lib/fonts/font_8x16.c — Public Domain per
// the file's own header).  Because the .pdx symbol is a [u8; 4096]-shaped
// binding, swapping the underlying .bin file requires zero .pdx changes.
//
// Length invariant: the declared array length ([u8; 4096]) must match the
// on-disk file size exactly, or paideia-as emits diagnostic T0558 (SARIF
// text: "declared [u8; N] size does not match actual bytes from @guid or
// @include_bytes").
//
// ==============================================================================
// @include_bytes verification (blocker #878)
// ==============================================================================
//
// @include_bytes was implemented in paideia-as issues #1013 (parser +
// resolver), #1014 (@include_str sibling), #1103 (PE/COFF emitter path).
// It is production-ready as of paideia-as v0.20.1.  The R23.M1 investigation
// verified this by grep of tools/paideia-as/crates/ — no follow-up work in
// paideia-as required (blocker was stale; not a real gap).
//
// Path form: relative to this .pdx's dir.  Absolute paths are rejected by
// paideia-as-parser P0279 diagnostic.  ../../.. traversal is permitted (no
// path-traversal guard in the resolver).
//
// ==============================================================================
// fb_font_row(glyph, row) — leaf accessor
// ==============================================================================
//
// Contract: returns the 8-bit row bitmap for (glyph, row).  Caller must
// pass glyph ∈ [0..256) and row ∈ [0..16); out-of-range inputs read the
// bytes at (glyph*16 + row) which — for glyph=255, row=15 — is the last
// byte of the array (offset 4095), still in-bounds; for glyph>=256 the
// read walks off the array into whatever .rodata neighbor lives next.
// Upstream discipline (the rasterizer, #879) will bounds-check.
//
// Encoding: `movzx rax, byte ptr [rip + _fb_font + rdi*16 + rsi]`.
// paideia-as's byte-load idiom (path.pdx L74 precedent): `xor rax, rax;
// mov_b rax, [addr]` for zero-extended byte load.  We fold that into a
// leaf pattern here.  rdx / r8 scratch for the address math.
//
// Register discipline: leaf, no push/pop.  SysV caller-save clobbers only
// (rax, rcx, rdx, r8).  rdi and rsi are inputs (SysV arg regs 0 and 1);
// their post-return values are undefined (SysV caller-save).
//
// ==============================================================================
// Instruction floor
// ==============================================================================
//
// - lea r64, [rip + sym]      (R11 encoder)
// - imul r64, r64, imm8       (R11 encoder — for glyph*16; use shl by 4 instead)
// - shl r64, imm8             (R11 encoder)
// - add r64, r64              (R11 encoder)
// - mov_b r64, [r64+r64]      (byte load; xor+mov_b idiom per path.pdx)

module FbFont = structure {

  // Byte counts:
  //   FB_FONT_GLYPHS      = 256   (one per byte value)
  //   FB_FONT_ROWS_PER    = 16    (8x16 font — 16 rows tall)
  //   FB_FONT_COLS_PER    = 8     (row bitmap is 1 byte = 8 pixels wide)
  //   FB_FONT_BYTES_PER   = 16    (rows_per * cols_per / 8)
  //   FB_FONT_TOTAL_BYTES = 4096  (glyphs * bytes_per)
  pub let FB_FONT_GLYPHS      : u64 = 256
  pub let FB_FONT_ROWS_PER    : u64 = 16
  pub let FB_FONT_COLS_PER    : u64 = 8
  pub let FB_FONT_BYTES_PER   : u64 = 16
  pub let FB_FONT_TOTAL_BYTES : u64 = 4096

  // ==========================================================================
  // _fb_font: 4096-byte embedded font blob (.rodata).
  // ==========================================================================
  //
  // Emitted by paideia-as as an immutable byte array in .rodata via
  // @include_bytes.  Path is relative to this .pdx file (parser policy).
  //
  //   src/kernel/core/drivers/fb_font.pdx     <-- this file
  //   assets/fonts/vga8x16.bin                <-- the blob
  //
  //   Relative from this file's dir:
  //     ../../../../assets/fonts/vga8x16.bin
  //
  // The @align(64) attribute forces the section's base alignment; combined
  // with 16-byte glyph pitch, no glyph-row byte-load ever straddles a
  // cacheline boundary — a nice-to-have for the rasterizer's hot loop.
  //
  // The `_fb_font` name is `pub` (visible as an nm symbol) so downstream
  // fixtures can assert its presence and size directly.  R23.M1 verifier:
  //   nm build/kernel.elf | grep _fb_font  # -> "<addr> R _fb_font"
  pub let _fb_font : [u8; 4096] = @include_bytes("../../../../assets/fonts/vga8x16.bin") @align(64)

  // ==========================================================================
  // fb_font_row(glyph, row) -> u8
  // ==========================================================================
  //
  // Return the 8-pixel bitmap byte for row `row` of glyph `glyph`.
  //
  // Address arithmetic:
  //   addr = &_fb_font + glyph * 16 + row
  //        = &_fb_font + (glyph << 4) + row
  //
  // Uses `xor rax, rax; mov_b rax, [r8]` (zero-extended byte load; path.pdx
  // L74 idiom is the canonical byte-read form in this codebase).
  // ==========================================================================
  pub let fb_font_row : (u64, u64) -> u64 !{mem} @{} =
    fn (glyph: u64) (row: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R23-M1-003 (#877): leaf accessor for the 8x16 font blob.  Contract: caller supplies glyph in rdi ∈ [0..256), row in rsi ∈ [0..16); returns the row bitmap byte zero-extended to u64 in rax.  Address math: lea r8, [rip + _fb_font]; shl rdi, 4 (glyph * 16 = glyph << 4); add r8, rdi (r8 = &_fb_font + glyph*16); add r8, rsi (r8 = &_fb_font[glyph*16 + row]).  Byte load via canonical `xor rax, rax; mov_b rax, [r8]` idiom (path.pdx L74 precedent — paideia-as's mov_b does not zero-extend, per sys_execve_shim.pdx:110 note; the pre-zero of rax makes the zero-extension explicit).  Leaf function: no push/pop, no callee-save discipline; SysV caller-save regs only (rax, rcx, rdx, r8, rdi, rsi all documented caller-save).  Out-of-range inputs: glyph >= 256 walks past the 4096-byte array end into whatever .rodata neighbor lives next; row >= 16 similarly but bounded to a single glyph pitch.  Neither raises a fault (all reads land inside kernel .rodata which is P=1, U=0 — reachable from ring 0 without #PF); wrong-input data is undefined.  Upstream bounds-check discipline lives with the rasterizer (#879 R23.M2).",
      block: {
        lea r8, [rip + _fb_font];
        shl rdi, 4;
        add r8, rdi;
        add r8, rsi;
        xor rax, rax;
        mov_b rax, [r8];
        ret
      }
    }
}
