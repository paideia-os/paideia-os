// src/kernel/core/config/features.pdx — R22-M6-004 (#873)
//
// Boot-time feature-toggle constants. Central registry for compile-time
// switches that gate optional kernel subsystems on/off. Modeled after
// the Linux .config paradigm but constrained to R22's minimum-viable
// set: today's registry is a single-flag mechanism (IOMMU on/off) that
// R23+ will extend with additional gates as new subsystems land.
//
// -----------------------------------------------------------------------------
// Why compile-time
// -----------------------------------------------------------------------------
//
// The paideia-native alternative — a boot-time command line parsed
// from the multiboot2 tag or the UEFI LoadOptions blob — is scoped
// for R25+ (see design/kernel/iommu-boot-toggle.md §4 for the
// migration path). At R22.M6 the kernel does not yet accept any
// runtime string configuration; the boot_env struct passed from
// kernel_main_uefi carries only pre-parsed ACPI info + memory-map
// pointers, not free-form key/value pairs.
//
// Compile-time flags are therefore the mechanism available today.
// Every consumer that references IOMMU_ENABLED (or any future
// FEATURE_* constant) reads it as `let flag : u64 = Features.IOMMU_ENABLED`
// which resolves at assembly time — no branch penalty, no `.data`
// footprint beyond the constant itself.
//
// The trade-off is that flipping a flag requires a `tools/build.sh`
// re-run. For MVP bring-up this is acceptable: the primary use case
// is "R23 developer wants to test the IOMMU-enabled path locally
// before landing the runtime toggle", not "end user picks their
// preferred kernel config at boot". The migration to a runtime
// command-line parser is queued for R25 alongside the userspace-init
// argument-passing work.
//
// -----------------------------------------------------------------------------
// Current flag registry (R22.M6)
// -----------------------------------------------------------------------------
//
//   IOMMU_ENABLED
//       0 (default) — VT-d substrate is present in kernel.elf but not
//                     brought online at boot. GCMD.TE stays 0; no DMA
//                     translation occurs. Devices continue DMA-ing to
//                     bare host PAs. This is the R22.M6 shipping mode.
//       1           — R23-experimental. Consumers include:
//                       * kernel_main_uefi calls vtd_root_init +
//                         vtd_set_root + GCMD.TE ceremony after MCFG
//                         wire-up.
//                       * The DMA-fault regression fixture at
//                         tests/kernel/iommu/dma_fault_regression.pdx
//                         switches from SKIP to LIVE mode.
//                       * IR-plane witnesses register real IDT vectors
//                         for vtd_fault_dispatch.
//                     Not yet wired at M6; the flag exists so R23 can
//                     land the wire-up as a one-line delete of the
//                     `if (flag == 0) return;` guards.
//
// -----------------------------------------------------------------------------
// See also
// -----------------------------------------------------------------------------
//
//   - design/kernel/iommu-boot-toggle.md — full toggle mechanism doc.
//   - design/round-retrospectives/r22-closure.md §"Preflight for R23"
//     — the R23 milestone where IOMMU_ENABLED = 1 becomes shippable.
//   - tests/kernel/iommu/dma_fault_regression.pdx — the M6 SKIP-mode
//     witness that R23 flips to LIVE when this flag flips to 1.

module Features = structure {

  // ==========================================================================
  // IOMMU_ENABLED — Intel VT-d translation enable at boot
  // ==========================================================================
  //
  // Default 0 (R22.M6). Flipping to 1 requires R23 to also wire:
  //   1. phase1_acpi_gather's DMAR branch that populates has_dmar +
  //      _vtd_base from the DMAR ACPI table (currently hardcoded).
  //   2. vtd_root_init + vtd_set_root call in kernel_main_uefi.
  //   3. GCMD.TE (Translation Enable) + poll GSTS.TES.
  //   4. Context-cache + IOTLB invalidation issuance post-SRTP.
  //   5. IDT wire for vtd_fault_dispatch.
  //   6. AP-side x2APIC EOI path (already retired under R22.M1).
  //
  // See design/kernel/iommu-boot-toggle.md §3 for the full wire-up
  // checklist R23 must complete before flipping this flag ships.
  //
  // Type is u64 not u8 (per task spec's "u8 = 0" note): paideia-as
  // constant-fold prefers u64-sized let bindings for `mov r64, imm`
  // consumption; a u8 constant would force a widening move at every
  // read site. The value semantics are still 0/1 boolean.
  pub let IOMMU_ENABLED : u64 = 0

  // ==========================================================================
  // CRYPTO_ML_DSA_ENABLED — R32 ML-DSA-65 verify substrate live
  // ==========================================================================
  //
  // Default 0 (R25.M5). R32 lands the real ML-DSA-65 verify
  // primitive; flipping this flag to 1 tells the PdxFS-lite mount
  // signature-verify shim (see src/kernel/core/fs/pdxfs_lite/verify.pdx
  // pdxfs_sb_verify_sig) to call the R32 crypto entry-point instead
  // of the dev-mode all-zero-signature bypass. Consumers:
  //
  //   * src/kernel/core/fs/pdxfs_lite/verify.pdx —
  //     pdxfs_sb_verify_sig switches from the memcmp-against-zero
  //     acceptance check to a real ML-DSA-65 verify call when this
  //     flips to 1. At R25.M5 the R32 crypto substrate does not yet
  //     exist; flipping the flag would leave the verify path
  //     unresolved (link fail) — the flip lands with R32 in the
  //     same commit that provides ml_dsa_verify.
  //
  //   * tests/kernel/fs/pdxfs_lite_corrupt_sb.pdx — the bit-flip
  //     fixture flips from "sig-all-zero passes dev-mode" to
  //     "bit-flip in signed region rejected by real ML-DSA verify"
  //     when this flag turns on (R32+).
  //
  // See design/filesystem/pdxfs-lite-perf.md for the <5 ms verify
  // acceptance target that lands at the R32 flip.
  pub let CRYPTO_ML_DSA_ENABLED : u64 = 0

  // ==========================================================================
  // PDXFS_DEV_KEY_ONLY — accept all-zero signature (dev bypass) at mount
  // ==========================================================================
  //
  // Default 1 at R25.M5 (MVP path). Documents that the PdxFS-lite
  // mount signature-verify path uses the dev bypass:
  // pdxfs_sb_verify_sig accepts a superblock whose 3400-byte sig
  // field is all zeros. Rationale + threat model:
  //
  //   * MVP: no real ML-DSA-65 verify primitive is compiled into
  //     the kernel yet (R32 dependency). The MVP dev bypass allows
  //     tools/mkfs-pdxfs-lite.sh to author images with an all-zero
  //     sig and have the kernel mount them; the corruption-fixture
  //     smoke can still be written and CI-gated against dev-mode
  //     semantics; the mount pathway is fully exercised end-to-end.
  //
  //   * R32 flip: when CRYPTO_ML_DSA_ENABLED=1 lands, this flag
  //     should flip to 0 in the same commit (or shortly after);
  //     leaving both flags at 1 would let a real key + a leaked
  //     "all zero" signature coexist as valid mount tokens, which
  //     defeats the security posture.
  //
  //   * The dev-mode branch NEVER accepts a non-zero signature.
  //     A malformed image with a partial signature (some non-zero
  //     bytes) is rejected — the "dev bypass" is not a "verify
  //     nothing" mode.
  //
  // Consumers:
  //   * src/kernel/core/fs/pdxfs_lite/verify.pdx —
  //     pdxfs_sb_verify_sig's dev-mode branch. Body is unconditionally
  //     compiled in at R25.M5 (the branch is present in .text and
  //     always executed under the current flag values). When the
  //     CRYPTO_ML_DSA_ENABLED flip lands, verify.pdx is revised to
  //     switch its per-invocation gate to test this flag alongside
  //     CRYPTO_ML_DSA_ENABLED.
  //
  //   * tests/kernel/fs/pdxfs_lite_corrupt_sb.pdx — the fixture
  //     documents that under DEV_KEY_ONLY=1 the bit-flip does NOT
  //     cause a verify failure (the signature is still all zeros —
  //     the tampered byte is elsewhere in the signed region), so
  //     the fixture serves as substrate proof that the pathway is
  //     wired and will bite when R32 flips the flags.
  pub let PDXFS_DEV_KEY_ONLY : u64 = 1

  // ==========================================================================
  // Slot for future flags (reserved comment — no code yet)
  // ==========================================================================
  //
  // R23+ additions in the planned order:
  //   pub let X2APIC_ENABLED       : u64 = 1   // already always-on post R22.M1
  //   pub let SMEP_ENABLED         : u64 = 1   // R11 shipping default
  //   pub let SMAP_ENABLED         : u64 = 1   // R11 shipping default
  //   pub let KPTI_ENABLED         : u64 = 1   // R14 shipping default
  //   pub let NVME_MSIX_IR         : u64 = 0   // R24, gates on IOMMU_ENABLED=1
  //   pub let VIRTIO_MSIX_IR       : u64 = 0   // R23, gates on IOMMU_ENABLED=1
  //   pub let SCHED_TSC_DEADLINE   : u64 = 1   // R21 substrate ready
  //
  // Each addition lands with a design doc under design/kernel/ that
  // documents its consumers + the migration path from compile-time
  // to boot-command-line (R25).
}
