// src/kernel/core/fs/fs_current_holders.pdx — UMB-W2 R139.M2 (paideia-os#2640)
//
// FS current-holders query — kernel-facing wrapper over the VFS
// vops_current_holders dispatcher (core/fs/vops.pdx §+112 slot).
//
// -----------------------------------------------------------------------------
// Purpose
// -----------------------------------------------------------------------------
//
// Given a vnode handle (an index into _vnode_pool), returns the backend's
// live-fd count for that vnode: how many open file descriptors still
// reference it. The count is foundational for three downstream features:
//
//   * **R139.M4 lazy-unmount pre-check** — a lazy unmount must know
//     whether any session still holds the mount before it drops the
//     mountpoint off the active table.  Querying each mount-root vnode's
//     holder count is the pre-check primitive.
//
//   * **R127.M6 shell-session garbage collector** — a shell session that
//     exits with lingering fds leaves vnodes with non-zero holder
//     counts; the GC uses this query to find leaks worth reporting.
//
//   * **Future `fuser`-like introspection** — a user-visible utility that
//     lists which pids / sessions hold which files.  R139.M2 lands the
//     count surface; the pid-list form grows later.
//
// -----------------------------------------------------------------------------
// Dispatch shape
// -----------------------------------------------------------------------------
//
// Vops slot at +112 (VOPS_CURRENT_HOLDERS_OFFSET, frozen by this landing).
// Shared adapter `_fs_vnode_refcount_adapter` (core/fs/vops.pdx) reads the
// universal u16 refcount at vnode+4 (design/kernel/vfs-layout.md §2 row
// refcount, frozen by #570 since R16.M1) and returns it zero-extended as
// a u64 in rax.  Installed by pdxfs_lite_vops_init and pdxfs_block_vops_
// init.  tmpfs and pipe elect to opt out at this landing (null slot ->
// VOPS_ERR_NOT_SUPPORTED -> FS_HOLDERS_NOT_SUPPORTED); a future wave can
// wire the shared adapter in those populators without touching this
// module.
//
// -----------------------------------------------------------------------------
// Shim: fs_vnode_holder_count(vn_idx) -> u64
// -----------------------------------------------------------------------------
//
// User-space-callable surface (kernel helper; a syscall shim lands later
// alongside the fuser-like consumer).  Signature:
//
//   fs_vnode_holder_count(vn_idx: u64) -> u64
//     Success:  the live-fd count for vnode[vn_idx], as a u64 in [0, 65535].
//     Failure:  FS_HOLDERS_BAD_VNODE       (0xFFFFED70) if vn_idx == 0
//                                             (slot-0 sentinel reserved
//                                             invalid per #570) or
//                                             vn_idx >= VNODE_MAX=256.
//               FS_HOLDERS_NOT_SUPPORTED   (0xFFFFED71) if the backend
//                                             elects to opt out (null
//                                             slot in its vops table).
//
// Every call emits exactly one FS_HOLDERS fingerprint on serial:
//
//   `FS_HOLDERS vnode=0x<16-hex> count=<dec>`                — success
//   `FS_HOLDERS ERROR vnode=0x<16-hex> code=0x<16-hex>`      — failure
//
// The success form uses klog_s1_x1_d1 (hex vnode handle, decimal count);
// the error form uses klog_s1_x2 (hex vnode handle, hex error code).  Byte
// counts NUL-inclusive per #699 discipline (tags end with `\0`, length
// field includes the terminator).
//
// -----------------------------------------------------------------------------
// Error band
// -----------------------------------------------------------------------------
//
// Reserves 0xFFFFED70..0xFFFFED71 (two codes), carved from the free band
// above KIND_USER's 0xFFFFED30..0xFFFFED3F slice and below the
// vello_tiling 0xFFFFED50..0xFFFFED5F slice.  Grep audit 2026-10-11:
// 0xFFFFED70 and 0xFFFFED71 are unused anywhere in src/.
//
//   FS_HOLDERS_BAD_VNODE     : 0xFFFFED70  — vn_idx == 0 or >= VNODE_MAX
//   FS_HOLDERS_NOT_SUPPORTED : 0xFFFFED71  — backend did not install a
//                                            current_holders adapter
//
// -----------------------------------------------------------------------------
// Encoder posture
// -----------------------------------------------------------------------------
//
// No `test rN,rN` (use `cmp rN,0; je/jne` per project convention).
// No `and r11, imm64` (no imm64 and-mask used here).
// No 2-op `imul r, imm` (no multiplication in this module).
// No multiline `pub let ="..."` (every string stays single-line).
// Labels prefixed `fsh_` throughout (fs holders; no collision with pdx
// reserved keywords `loop`, `if`, `else`, `let`, `fn`).
// klog_s1_x1_d1 and klog_s1_x2 caller discipline: `sub rsp, 16;
// mov [rsp+0], v2; call; add rsp, 16` keeps rsp%16==0 at the klog
// entry (matches kind_cmd_module.pdx L677 and sys_pdxfs_stat_by_inode.
// pdx L309 patterns verbatim).
// Fingerprint tag [u8; N] = len(string) + 1 (NUL terminator counted).

module FsCurrentHolders = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  // VNODE_MAX duplicated from core/fs/vnode_pool.pdx (#571) so this leaf
  // helper has no cross-module VNODE_MAX load.  The two literals must
  // move together if VNODE_MAX is ever widened.
  pub let FSH_VNODE_MAX              : u64 = 256

  // Dispatcher sentinel the vops_current_holders dispatcher returns on
  // null ops_ptr or null slot.  Mirrors Vops.VOPS_ERR_NOT_SUPPORTED
  // (core/fs/vops.pdx L103).
  pub let FSH_VOPS_ERR_NOT_SUPPORTED : u64 = 0xFFFFFFFFFFFFFFFF

  // Error band — reserved 0xFFFFED70..0xFFFFED71 (grep-verified free
  // 2026-10-11).  See file header §Error band for the band rationale.
  pub let FS_HOLDERS_BAD_VNODE       : u64 = 0xFFFFED70
  pub let FS_HOLDERS_NOT_SUPPORTED   : u64 = 0xFFFFED71

  // Fingerprint tag strings.  NUL-inclusive length per #699 discipline.
  pub let tag_fs_holders_ok  : [u8; 11] = "FS_HOLDERS\0"
  pub let tag_fs_holders_err : [u8; 17] = "FS_HOLDERS ERROR\0"

  // Fingerprint keys.  k_vnode (6 bytes, "vnode\0") and k_count (6
  // bytes, "count\0") are REUSED from core/klog/keys.pdx L1564 / L662.
  // fsh_k_code is minted here (5 bytes, "code\0").  Per the keys.pdx
  // reuse discipline, a module-local tag/key owned by the emitting
  // module stays local; only globally-reused keys live in keys.pdx.
  pub let fsh_k_code : [u8; 5] = "code\0"

  // ==========================================================================
  // fs_vnode_holder_count(vn_idx) -> u64
  //
  //   Returns the backend-reported live-fd count for vnode[vn_idx], or
  //   a reserved failure sentinel on error.  Emits exactly one
  //   FS_HOLDERS fingerprint per call (success or failure form).
  //
  //   See file header for the full contract + error band.
  //
  //   Register plan: 3-push callee-save prologue (rbx = vn_idx survives
  //   every nested call; r12 = vnode_ptr survives vops_current_holders;
  //   r13 = raw count / error-code spill for the fingerprint emit).
  //   Entry rsp%16==8; +24 pushes = 32, %16==0 at every nested call per
  //   SysV AMD64.  klog_s1_x1_d1 / klog_s1_x2 7th-arg push lands via
  //   `sub rsp, 16; mov [rsp+0], v2` (16-byte sub keeps rsp%16==0 at the
  //   wrapper's entry; the wrapper's `push rbp; mov rbp, rsp` then
  //   shifts v2 to [rbp+16]).  Matches kind_cmd_module.pdx L677-686
  //   byte-for-byte.
  // ==========================================================================
  pub let fs_vnode_holder_count : (u64) -> u64 !{mem, sysreg} @{} =
    fn (vn_idx: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {},
      justification: "UMB-W2 R139.M2 (paideia-os#2640): kernel-facing holder-count query. Validates the vnode handle (0 or >= VNODE_MAX=256 -> FS_HOLDERS_BAD_VNODE), resolves it to a vnode_ptr via vnode_slot (leaf, no failure path), dispatches through vops_current_holders (null-guarded; opt-out backend returns 0xFFFFFFFFFFFFFFFF which we map to FS_HOLDERS_NOT_SUPPORTED), and emits one FS_HOLDERS fingerprint per call. Three-push callee-save prologue (rbx=vn_idx surviving every nested call for the fingerprint emit; r12=vnode_ptr spilled across the klog_s1_x1_d1 call; r13=count/code spill for the 7th-arg push) lands rsp%16==0 at every nested call (entry rsp%16==8 + 24 = 32, %16==0). klog_s1_x1_d1 (success) / klog_s1_x2 (failure) 7th-arg discipline: `sub rsp, 16; mov [rsp+0], v2; call; add rsp, 16` keeps rsp%16==0 at wrapper entry per the kind_cmd_module.pdx L677 and sys_pdxfs_stat_by_inode.pdx L309 patterns. Effects {mem, sysreg}: mem for the vnode load through vops_current_holders and for the klog wrapper's KV-array writes; sysreg transitively from klog_s1_*'s TSC read + UART emit path (same widening sys_pdxfs_stat_by_inode_body uses at sys_pdxfs_stat_by_inode.pdx L257). Capabilities {}: no cap operation runs here; a future per-mount VOL_RIGHT gate on the query (R139.M4+) would widen this. Encoder-conservative: no test (use cmp rN,0; je), no 2-op imul r,imm, no and r,imm64, no multiline string literal, no mov_b (whole-qword only); every form proven at vfs_close.pdx / sys_pdxfs_stat_by_inode.pdx / kind_cmd_module.pdx. Reserved labels: fsh_ (fs holders) — no collision with pdx reserved words loop/if/else/let/fn or any other sibling module's label prefix (grep audit 2026-10-11).",
      block: {
        push rbx;
        push r12;
        push r13;
        // rsp%16: 8 + 24 = 32, %16==0 at every nested call.

        mov rbx, rdi;                        // rbx = vn_idx (preserved for emits)

        // ---- (1) Validate vnode handle ----
        //
        // vn_idx == 0 is the slot-0 sentinel reserved invalid per #570
        // (vnode_pool.pdx _vnode_bitmap[0] starts set so vnode_alloc
        // never returns 0; the sentinel means "no vnode / detached").
        // vn_idx >= VNODE_MAX=256 is out of pool range.
        cmp rbx, 0;
        je  fsh_bad_vnode;
        cmp rbx, 256;                        // FSH_VNODE_MAX (direct imm32)
        jae fsh_bad_vnode;

        // ---- (2) Resolve handle to vnode pointer ----
        //
        // vnode_slot(vn_idx) -> &_vnode_pool[vn_idx * 64]. Leaf
        // function, 3 instructions, no failure path (idx range already
        // validated above).
        mov rdi, rbx;
        call vnode_slot;
        mov r12, rax;                        // r12 = vnode_ptr

        // ---- (3) Dispatch through vops_current_holders ----
        //
        // Null ops_ptr OR null slot -> VOPS_ERR_NOT_SUPPORTED
        // (0xFFFFFFFFFFFFFFFF); otherwise rax = backend-reported
        // holder count.
        mov rdi, r12;
        call vops_current_holders;
        mov r13, rax;                        // r13 = raw count / sentinel

        // FSH_VOPS_ERR_NOT_SUPPORTED == 0xFFFFFFFFFFFFFFFF: cmp with
        // sign-extended imm8 (-1) matches the thermal_policy.pdx L386
        // and block_cache_flush.pdx L336 one-shot shape.
        cmp r13, 0xFFFFFFFFFFFFFFFF;
        je  fsh_not_supported;

        // ---- (4a) Success: emit `FS_HOLDERS vnode=0x<16> count=<dec>` ----
        //
        // klog_s1_x1_d1(level, subsys, tag, k1_hex, v1_hex, k2_dec, v2_dec)
        //   rdi=LEVEL_INFO=3, rsi=&SUBSYS_FS__, rdx=&tag_fs_holders_ok
        //   rcx=&k_vnode (hex), r8=vn_idx (hex)
        //   r9=&k_count (dec), [rsp+0]=count (dec) via sub rsp,16
        sub rsp, 16;
        mov [rsp + 0], r13;                  // v2 = count (decimal)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_fs_holders_ok];
        lea rcx, [rip + k_vnode];
        mov r8, rbx;                         // v1 = vn_idx (as the handle to report)
        lea r9, [rip + k_count];
        call klog_s1_x1_d1;
        add rsp, 16;

        mov rax, r13;                        // success return: the real count
        jmp fsh_done;

      fsh_bad_vnode:
        // ---- (4b) BAD_VNODE: emit `FS_HOLDERS ERROR vnode=0x<16> code=0x<16>` ----
        mov r13, 0xFFFFED70;                 // FS_HOLDERS_BAD_VNODE
        sub rsp, 16;
        mov [rsp + 0], r13;                  // v2 = code (hex)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_fs_holders_err];
        lea rcx, [rip + k_vnode];
        mov r8, rbx;                         // v1 = vn_idx (the bad handle)
        lea r9, [rip + fsh_k_code];
        call klog_s1_x2;
        add rsp, 16;
        mov rax, r13;                        // return FS_HOLDERS_BAD_VNODE
        jmp fsh_done;

      fsh_not_supported:
        // ---- (4c) NOT_SUPPORTED: emit `FS_HOLDERS ERROR vnode=0x<16> code=0x<16>` ----
        mov r13, 0xFFFFED71;                 // FS_HOLDERS_NOT_SUPPORTED
        sub rsp, 16;
        mov [rsp + 0], r13;                  // v2 = code (hex)
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_fs_holders_err];
        lea rcx, [rip + k_vnode];
        mov r8, rbx;                         // v1 = vn_idx (the handle we tried)
        lea r9, [rip + fsh_k_code];
        call klog_s1_x2;
        add rsp, 16;
        mov rax, r13;                        // return FS_HOLDERS_NOT_SUPPORTED

      fsh_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
