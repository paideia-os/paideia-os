// src/kernel/core/fs/path.pdx — R16-M1-004 (#573)
// Path resolver: split-on-'/' component walk via vops_lookup.
//
// Per design/kernel/r16-m1-004-path-resolver.md:
//
//   path_resolve turns a null-terminated ASCII path string into a vnode index
//   by walking the tree one component at a time. Each component becomes a
//   vops_lookup(dir_vn, name_ptr) call against the current directory vnode.
//
// Storage:
//   - _path_component_buf [u8; 64]: non-reentrant scratch buffer for
//     component names (NAME_MAX=63 + NUL).
//   - _path_witness_vops_table [u64; 11]: vops table for witness stub.
//     (R56.M3-003 grew this from 7 to 9 slots — see core/fs/vops.pdx
//     header for the layout note.)
//   - _path_witness_lookup_stub: purpose-built lookup for the witness tree.

module Path = structure {
  // === Constants (pinned by design/kernel/r16-m1-004-path-resolver.md §4) ===
  pub let PATH_MAX          : u64 = 256     // whole-path byte budget
  pub let NAME_MAX          : u64 = 63      // per-component budget (excl. NUL)
  pub let NAME_BUF_SIZE     : u64 = 64      // _path_component_buf sizing
  pub let PATH_IDX_FAIL     : u64 = 0       // sole failure sentinel
  pub let BYTE_SLASH        : u64 = 0x2F    // '/'
  pub let BYTE_DOT          : u64 = 0x2E    // '.'
  pub let BYTE_NUL          : u64 = 0x00

  // Vnode field offsets (mirrors from vfs-layout.md #570)
  pub let VNODE_PARENT_IDX_OFFSET : u64 = 8
  pub let VNODE_IDX_NONE          : u64 = 0xFFFF
  pub let VNODE_MAX               : u64 = 256

  // Vops lookup offset (from vops.pdx #572)
  pub let VOPS_LOOKUP_OFFSET      : u64 = 32

  // Mount table layout mirrors (frozen by mount.pdx §Layout constants; not
  // re-frozen here). The path resolver reads the packed u64 entry directly
  // rather than call through Mount:: to avoid a nested-call round-trip on
  // every resolve. Any change to these must move in lockstep with mount.pdx.
  pub let MOUNT_MAX                    : u64 = 8
  pub let MOUNT_BACKEND_MASK           : u64 = 0xFF
  pub let MOUNT_FLAG_PENDING_UNMOUNT   : u64 = 0x04

  // Refusal code returned when a resolve is anchored at a mount slot marked
  // pending-unmount. Distinct from the generic rax=0 path_fail sentinel so
  // callers implementing the lazy-umount drain can distinguish "no such
  // path" from "path lives on a mount that has entered its teardown
  // window". Sits in the mount-lifecycle slice of the reserved refusal
  // band; adjacent slots (ED49..ED4F) reserved for follow-on unmount
  // lifecycle codes.
  pub let PATH_LOOKUP_PENDING_UNMOUNT  : u64 = 0xFFFFED48

  // === Storage (.bss slab — non-reentrant at R16.M1) ===
  pub let mut _path_component_buf : [u8; 64] = uninit @align(8)

  // ==========================================================================
  // path_resolve(path_ptr: u64, root_vnode_idx: u64, cwd_vnode_idx: u64) -> u64
  //
  // Signature frozen for R16 series (design §2). Returns vnode idx (u16 in
  // low bits of rax) on success; rax == 0 on any failure.
  //
  // Register discipline: 5-push callee-save prologue lands rsp%16==0 for
  // nested calls. Loop invariants:
  //   rbx = cur (current vnode idx, u64 with low 16 bits used)
  //   r12 = p (path cursor, advances one byte at a time)
  //   r13 = scanned (total bytes consumed, bounded at PATH_MAX)
  //   r14 = write cursor into _path_component_buf (during copy phase only)
  //   r15 = &_path_component_buf (base address, preserved across calls)
  // ==========================================================================
  pub let path_resolve : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (path_ptr: u64) (root_vnode_idx: u64) (cwd_vnode_idx: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R16-M1-004 (#573) path resolver, extended by R17-M0-#665 Phase 4 / R17-M5-#754. Five-phase iterative walk: (1) prologue + anchor selection (absolute vs relative), (2) outer component loop with slash-skip, (3) inner copy loop into scratch buffer, (4) . and .. fast-path handling, (5) regular vops_lookup dispatch, then vnode_cache_or_alloc(parent_vn, backend_inode, ops_ptr) to convert the backend inode idx into a real vnode-pool idx (the pre-fix code fed the backend idx straight into `cur`, which then aliased into _vnode_pool via vnode_slot's arithmetic — the #754 _tty0 clobber). See design/kernel/r16-m1-004-path-resolver.md §3 for the base algorithm. Register plan: rbx=cur (vnode-pool idx), r12=p, r13=scanned, r14=dual-purpose (write cursor DURING inner copy loop only; ops_ptr snapshot from parent vnode DURING regular_lookup — the two phases never overlap: end_component consumes-then-abandons the write cursor before regular_lookup snapshots ops_ptr), r15=buffer base. Callee-save discipline: 5 pushes (40 B) + retaddr (8 B) = 48 B = 0 mod 16, so nested calls see rsp%16==0 (SysV ABI requirement post-call). All generic failure paths return rax=0; success returns vnode idx in low 16 bits of rax (upper 48 bits zero). One distinguished refusal returns rax=PATH_LOOKUP_PENDING_UNMOUNT (0xFFFFED48) when the anchor's mount slot has MOUNT_FLAG_PENDING_UNMOUNT set — a linear scan of _mount_table (path_pending_scan) sits between the anchor bounds check and the buffer-base lea, matching the anchor vnode idx against each occupied slot's root_vnode_idx and inspecting the flags byte at bits [40, 48). The scan uses only caller-save scratch (rax/rcx/r9/r10) and preserves rbx, so downstream register plans see no perturbation from a passed gate.",
      block: {
        // --- Prologue: save callee-save regs (rsp%16 becomes 0 post-call) ---
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // --- Sanity check: path_ptr != 0 ---
        cmp  rdi, 0;
        je   path_fail;

        // --- Load path cursor and init scanned counter ---
        mov  r12, rdi;                        // r12 = p
        xor  r13, r13;                        // r13 = scanned

        // --- Peek [p] to decide absolute vs relative ---
        xor  rax, rax;
        mov_b rax, [r12];
        cmp  rax, 0x2F;                       // '/'
        jne  relative_start;

        // --- Absolute: cur = root, skip leading '/' ---
        mov  rbx, rsi;                        // cur = root_vnode_idx
        add  r12, 1;
        add  r13, 1;
        jmp  validate_cur;

      relative_start:
        mov  rbx, rdx;                        // cur = cwd_vnode_idx

      validate_cur:
        cmp  rbx, 0;                          // 0 → invalid anchor
        je   path_fail;
        cmp  rbx, 256;                        // VNODE_MAX
        jae  path_fail;

        // --- Refuse fresh resolves anchored at a pending-unmount mount ---
        // Linear scan of _mount_table (8 slots, one L1D line). For each
        // occupied slot whose root_vnode_idx equals the anchor rbx, inspect
        // the flags byte at bits [40, 48); if MOUNT_FLAG_PENDING_UNMOUNT is
        // set, refuse the resolve with PATH_LOOKUP_PENDING_UNMOUNT so the
        // lazy-umount lifecycle can drain in-flight lookups without new
        // arrivals. A matched slot without the flag falls through to the
        // normal walk. Scratch: rax/rcx/r9/r10 are all caller-save and are
        // reloaded before any use downstream (rbx is preserved throughout).
        lea  r9, [rip + _mount_table];
        xor  rcx, rcx;
      path_pending_scan:
        cmp  rcx, 8;                          // MOUNT_MAX
        jae  path_pending_ok;
        mov  rax, [r9 + rcx*8];
        mov  r10, rax;
        shr  r10, 32;
        and  r10, 0xFF;                       // backend byte
        cmp  r10, 0;                          // MOUNT_BACKEND_NONE → empty
        je   path_pending_next;
        mov  r10, rax;
        shr  r10, 16;
        and  r10, 0xFFFF;                     // root_vnode_idx
        cmp  r10, rbx;
        jne  path_pending_next;
        shr  rax, 40;
        and  rax, 0x04;                       // MOUNT_FLAG_PENDING_UNMOUNT
        cmp  rax, 0;
        jne  path_pending_unmount;
        jmp  path_pending_ok;                 // matched slot; flag clear
      path_pending_next:
        add  rcx, 1;
        jmp  path_pending_scan;
      path_pending_ok:

        lea  r15, [rip + _path_component_buf]; // r15 = buffer base

        // --- Outer component loop ---
      component_loop:
        cmp  r13, 256;                        // PATH_MAX
        jae  path_fail;

        // --- Skip any run of '/' (collapses '//' and eats trailing '/') ---
      skip_slashes:
        xor  rax, rax;
        mov_b rax, [r12];
        cmp  rax, 0x2F;                       // '/'
        jne  after_skip;
        add  r12, 1;
        add  r13, 1;
        cmp  r13, 256;
        jae  path_fail;
        jmp  skip_slashes;

      after_skip:
        cmp  rax, 0;                          // \0 → done
        je   return_cur;

        // --- Inner copy loop: one component into _path_component_buf ---
        mov  r14, r15;                        // r14 = write cursor at buffer base
        xor  rcx, rcx;                        // rcx = j (component length)

      copy_char:
        cmp  r13, 256;
        jae  path_fail;

        xor  rax, rax;
        mov_b rax, [r12];
        cmp  rax, 0;
        je   end_component;
        cmp  rax, 0x2F;
        je   end_component;

        // Length gate deliberately sits AFTER the terminator check (verify
        // fix, #573): a component of exactly NAME_MAX=63 bytes must still
        // get to see its 64th input byte (the '\0' or '/') to terminate
        // cleanly. Gating on rcx before the terminator check would fail a
        // legal 63-byte name one byte early (rcx==63 hits the old gate
        // before [r12] is ever read again). Placed here, the gate still
        // fires before any store once rcx==63, so a 64+-byte component is
        // rejected with no overrun — buffer safety is unchanged.
        cmp  rcx, 63;                         // NAME_MAX (component too long)
        jae  path_fail;

        mov_b [r14 + 0], rax;                 // store one byte
        add  r14, 1;                          // advance write cursor (workaround encoder gap §6.1)
        add  r12, 1;                          // advance path cursor
        add  r13, 1;
        add  rcx, 1;
        jmp  copy_char;

      end_component:
        xor  rax, rax;
        mov_b [r14 + 0], rax;                 // null-terminate the component

        // --- Handle '.' (self) and '..' (parent) before lookup ---
        cmp  rcx, 1;
        jne  check_dotdot;
        xor  rax, rax;
        mov_b rax, [r15 + 0];
        cmp  rax, 0x2E;                       // '.'
        jne  regular_lookup;
        jmp  component_loop;                  // "." — cur unchanged

      check_dotdot:
        cmp  rcx, 2;
        jne  regular_lookup;
        xor  rax, rax;
        mov_b rax, [r15 + 0];
        cmp  rax, 0x2E;
        jne  regular_lookup;
        xor  rax, rax;
        mov_b rax, [r15 + 1];
        cmp  rax, 0x2E;
        jne  regular_lookup;

        // ".." — read parent_idx from cur's vnode (+8)
        mov  rdi, rbx;
        call vnode_slot;                      // rax = &vnode[cur]
        xor  rcx, rcx;
        mov_w rcx, [rax + 8];                 // rcx = parent_idx (low 16 bits)
        cmp  rcx, 0xFFFF;                     // VNODE_IDX_NONE
        je   component_loop;                  // root's parent → stay at root
        mov  rbx, rcx;                        // cur = parent
        jmp  component_loop;

        // --- Regular component: dispatch to vops_lookup then cache-or-alloc ---
        //
        // #665 Phase 4 / #754 fix: vops_lookup returns a BACKEND inode idx
        // (e.g. tmpfs_lookup returns an index into _tmpfs_inode_pool), NOT
        // a vnode-pool idx. The pre-fix code assigned that backend idx
        // directly to `cur`, and the next iteration's `vnode_slot(cur)` then
        // treated it as a vnode-pool slot — arithmetically clobbering
        // whichever _vnode_pool slot lived at the same numeric index. Wave-3
        // of #754 caught _tty0 (a chrdev vnode_alloc'd at slot 6) getting
        // shadowed by sh_inode_idx=6 via exactly this path, retargeting
        // every shell sys_read(fd=0) through _tmpfs_read_adapter on the
        // wrong backend.
        //
        // The fix routes the returned backend idx through
        // vnode_cache_or_alloc(parent_vn_idx, backend_inode_idx, ops_ptr)
        // (see core/fs/vnode_pool.pdx:164) which either dedups against an
        // existing (parent, backend, ops)-triple in the pool or allocates a
        // fresh vnode-pool slot bound to those fields. Same helper vfs_open
        // uses at Step 7 of its O_CREAT path (see vfs_open.pdx:204) for the
        // symmetric "just created a backend inode, want a vnode idx" case.
        //
        // ops_ptr propagation: at R17.M0-M5 tmpfs is the sole mounted
        // backend, so the child inherits the parent's ops_ptr unchanged.
        // Cross-fs mount traversal (a future concern) will require a
        // mount_lookup on the resolved child here to pick up the mounted
        // fs's ops_ptr instead of the parent's.
        //
        // Register plan for this block:
        //   rbx = parent vnode-pool idx (LIVE across both calls; SysV
        //         callee-save both in vops_lookup's dispatch chain and in
        //         vnode_cache_or_alloc's 4-push prologue).
        //   r14 = parent.ops_ptr, snapshotted BEFORE vops_lookup (which
        //         reloads rdi with the vnode ptr for the call and forwards
        //         it through to the backend adapter). r14 was the write
        //         cursor during the inner copy loop above, but that role
        //         ends at end_component — r14 is free by the time we reach
        //         regular_lookup. Callee-save discipline preserves r14
        //         across both nested calls.
        //   rax = scratch/return chain.
      regular_lookup:
        mov  rdi, rbx;
        call vnode_slot;                      // rax = &vnode[cur] (parent)
        mov  r14, [rax + 24];                 // r14 = parent.ops_ptr (VNODE_OPS_PTR_OFFSET=24)
        mov  rdi, rax;                        // rdi = dir vnode ptr
        mov  rsi, r15;                        // rsi = &_path_component_buf
        call vops_lookup;                     // rax = backend_child_idx | 0 | -1
        and  rax, 0xFFFF;                     // mask to u16 idx
        cmp  rax, 0;
        je   path_fail;                       // ENOENT
        cmp  rax, 0xFFFF;
        je   path_fail;                       // explicit reject on masked sentinel

        // Cache-or-alloc: turn (parent_vn, backend_inode, ops) into a real
        // vnode-pool idx. Returns 0xFFFF on pool OOM; never returns 0
        // (vnode_alloc skips slot 0 via the pre-set bitmap bit, and the
        // dedup scan starts at i=1) but a defensive guard is cheap.
        mov  rdi, rbx;                        // arg1: parent_idx = current cur
        mov  rsi, rax;                        // arg2: backend_child_idx
        mov  rdx, r14;                        // arg3: parent's ops_ptr
        call vnode_cache_or_alloc;            // rax = vnode-pool idx (dedup or fresh) | 0xFFFF
        cmp  rax, 0xFFFF;
        je   path_fail;                       // vnode-pool OOM
        cmp  rax, 0;
        je   path_fail;                       // defensive: 0 is the reserved sentinel

        mov  rbx, rax;                        // cur = new vnode-pool idx
        jmp  component_loop;

        // --- Epilogue: return cur in rax ---
      return_cur:
        mov  rax, rbx;
        jmp  path_done;

      path_pending_unmount:
        mov  rax, 0xFFFFED48;                 // PATH_LOOKUP_PENDING_UNMOUNT
        jmp  path_done;

      path_fail:
        xor  rax, rax;

      path_done:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Witness fixtures (R16-M1-004 canary — design §5)
  // ==========================================================================
  //
  // Purpose-built lookup stub and vops table for the witness tree. The
  // witness allocates three vnodes (root, foo, bar) and threads them
  // through six sub-tests.

  // R56.M3-003 (#1792): widened from [u64; 7] to [u64; 9] so a
  // vops_readdir dispatch (offset +64) against a vnode pointing at this
  // witness table does not OOB-read past the .bss reservation. The two
  // new tail slots stay null.
  //
  // R56.M3-004 (#1793): widened from [u64; 9] to [u64; 11] for the
  // vops_mkdir/vops_rmdir tail slots at +72 / +80.  Same discipline —
  // the two new tail slots stay null so the dispatcher's null-guard
  // renders any stray mkdir/rmdir dispatch on this witness as
  // VOPS_ERR_NOT_SUPPORTED rather than OOB-reading past .bss.
  pub let mut _path_witness_vops_table : [u64; 11] = uninit @align(8)

  // Lookup stub for witness tree: returns 2 for names starting with 'f' (foo),
  // 3 for names starting with 'b' (bar), 0 otherwise. Ignores dir_vn — the
  // flat witness tree makes name sufficient for routing.
  pub let _path_witness_lookup_stub : (u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R16-M1-004 (#573) witness stub. Routes lookups in the flat test tree by first character: names starting with 'f' (foo) return 2, names starting with 'b' (bar) return 3, all others return 0 (ENOENT). Ignores dir_vn — the test tree is flat enough that name alone routes correctly.",
      block: {
        // Load first byte of name
        xor rax, rax;
        mov_b rax, [rsi];

        // Check for 'f' (0x66) → return 2
        cmp rax, 0x66;
        jne check_b;
        mov rax, 2;
        ret;

      check_b:
        // Check for 'b' (0x62) → return 3
        cmp rax, 0x62;
        jne not_found;
        mov rax, 3;
        ret;

      not_found:
        // All others → return 0 (ENOENT)
        xor rax, rax;
        ret
      }
    }
}
