// src/kernel/core/fs/backend_registry.pdx - R17-M0 #665 Phase 2
// Small backend-type to ops_table, root_inode registry.
//
// R52.M5-005 (#1707): backend_ops_table gains a `cmp rdi, 5; je
// bot_pdxfs_block` arm returning `_pdxfs_block_vops` (core/fs/pdxfs/
// vops_block.pdx) per design/filesystem/volume-fs-substrate.md §3.2 --
// mirrors _tmpfs_vops's shape exactly. backend_root_inode is
// deliberately NOT given a matching arm: PDXFS_BLOCK's root inode is a
// per-volume, superblock-derived value (core/fs/pdxfs/mount_block.pdx's
// mount_pdxfs_block calls #1706's probe_one_bdev, which stamps it onto
// the KIND_VOLUME row via volume_registry_register/volume_row_populate
// /volume_row_root_inode_set), not a backend-wide static constant the
// way TMPFS's root inode (1) is -- so backend_type 5 correctly falls
// through to bot_default's existing `xor rax, rax` here (0 = "no
// static root inode for this backend", not an error).

module BackendRegistry = structure {

  pub let backend_ops_table : (u64) -> u64 !{mem} @{} =
    fn (backend_type: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "dispatch backend type to vops table. R52.M5-005 (#1707) added the backend_type==5 (MOUNT_BACKEND_PDXFS_BLOCK) arm returning &_pdxfs_block_vops, ahead of the pre-existing TMPFS(1) check so it does not disturb that branch's fall-through shape; backend_type!=1 and !=5 still falls to bot_default (rax=0).",
      block: {
        cmp rdi, 5;
        jne bot_check_tmpfs;
        lea rax, [rip + _pdxfs_block_vops];
        ret;
bot_check_tmpfs:
        cmp rdi, 1;
        jne bot_default;
        lea rax, [rip + _tmpfs_vops];
        ret;
bot_default:
        xor rax, rax;
        ret;
      }
    }

  pub let backend_root_inode : (u64) -> u64 !{} @{} =
    fn (backend_type: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "dispatch backend type to root inode. backend_type==5 (PDXFS_BLOCK) intentionally has no arm here -- see file header note: its root inode is per-volume/superblock-derived, stamped onto the KIND_VOLUME row by mount_pdxfs_block, not a static per-backend constant this dispatcher can return.",
      block: {
        mov rax, 0;
        sub rdi, 1;
        jne skip1;
        mov rax, 1;
        skip1:
        ret;
      }
    }

}
