// src/kernel/core/fs/backend_registry.pdx - R17-M0 #665 Phase 2
// Small backend-type to ops_table, root_inode registry.
//
// R52.M5-005 (#1707): backend_ops_table gained a backend_type==5 arm
// returning `_pdxfs_block_vops` (core/fs/pdxfs/vops_block.pdx) per
// design/filesystem/volume-fs-substrate.md §3.2 -- mirrors _tmpfs_vops's
// shape exactly. R53.M2-006 (#1741) refactors that arm into the
// canonical `cmp rdi, 5; je bot_pdxfs_block` + labeled-target form
// (per design/tooling/volume-lifecycle-mechanism.md §M2), making the
// dispatch a per-backend cascade of `cmp ...; je bot_<name>;` arms
// terminated by `bot_default`. Same encoded semantics as the
// #1707 flatten -- pure structural rename so future backend arms
// (RO snap-mount, remote FS, ...) drop in as one more `cmp/je` pair
// without disturbing existing arms' fall-through shape.
//
// backend_root_inode is deliberately NOT given a matching arm:
// PDXFS_BLOCK's root inode is a per-volume, superblock-derived value
// (core/fs/pdxfs/mount_block.pdx's mount_pdxfs_block calls #1706's
// probe_one_bdev, which stamps it onto the KIND_VOLUME row via
// volume_registry_register/volume_row_populate/volume_row_root_inode_set),
// not a backend-wide static constant the way TMPFS's root inode (1)
// is -- so backend_type 5 correctly falls through to bot_default's
// existing `xor rax, rax` here (0 = "no static root inode for this
// backend", not an error).
//
// Note: there is no `BACKEND_REGISTRY_MAX` constant in this module;
// the dispatcher is a small explicit `cmp/je` cascade rather than a
// bounds-checked table. The admissible-backend upper bound lives in
// core/fs/mount.pdx (R53.M2-004 #1739 widened it from 4 to 5).

module BackendRegistry = structure {

  pub let backend_ops_table : (u64) -> u64 !{mem} @{} =
    fn (backend_type: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R53.M2-006 (#1741): dispatch backend_type to its vops table via a `cmp rdi, <k>; je bot_<name>;` cascade terminated by `bot_default: xor rax,rax; ret`. Arms: 5 -> &_pdxfs_block_vops (bot_pdxfs_block), 1 -> &_tmpfs_vops (bot_tmpfs); every other backend_type returns 0. Same encoded semantics as #1707's flatten -- the labeled-target form is the extensible shape called for by design/tooling/volume-lifecycle-mechanism.md §M2 (new backends drop in as one more `cmp/je` arm) and is what the issue text asks for verbatim (`cmp rdi, 5; je bot_pdxfs_block`). Callee-save discipline: leaf; no stack use; rax is the only clobber the ABI cares about here.",
      block: {
        cmp rdi, 5;
        je bot_pdxfs_block;
        cmp rdi, 1;
        je bot_tmpfs;
        jmp bot_default;
bot_pdxfs_block:
        lea rax, [rip + _pdxfs_block_vops];
        ret;
bot_tmpfs:
        lea rax, [rip + _tmpfs_vops];
        ret;
bot_default:
        xor rax, rax;
        ret;
      }
    }

  pub let backend_root_inode : (u64) -> u64 !{} @{} =
    fn (backend_type: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "dispatch backend type to root inode. backend_type==5 (PDXFS_BLOCK) intentionally has no arm here -- see file header note: its root inode is per-volume/superblock-derived, stamped onto the KIND_VOLUME row by mount_pdxfs_block, not a static per-backend constant this dispatcher can return.",
      block: {
        mov rax, 0;
        sub rdi, 1;
        jne skip1;
        mov rax, 1;
        skip1:
        ret;
      }
    }

}
