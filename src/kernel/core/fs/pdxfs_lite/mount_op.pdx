// src/kernel/core/fs/pdxfs_lite/mount_op.pdx — R25-M4-002 (#925)
//
// PdxFS-lite mount pathway: read superblock, allocate a VFS vnode for the
// root inode, publish it as the mounted filesystem's root, and record the
// mount in _pdxfs_lite_mount_ctx.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// pdxfs_lite_mount(bar0, nsid, mountpoint_vn_idx) -> u64
//   Returns u16 in low bits: the root vnode-pool index of the mounted fs.
//   Returns 0xFFFF on any failure.
//
// bar0 is threaded through for API stability but currently unused (see
// mount.pdx L98 rationale — nvme_read_blocking resolves the target controller
// from its own globals set at driver-attach time). When the KIND_BLKDEV cap
// substrate lands (#1015), a sibling function resolves (bar0, nsid) from a
// cap handle and calls this inner path.
//
// mountpoint_vn_idx is the parent vnode-pool index the root vnode should
// stitch under (its `parent_idx` field). Pass 0xFFFF for a detached mount
// (the caller has not yet chosen a mountpoint), or a valid vnode-pool idx
// to link the root under an existing directory vnode. The mount table
// entry itself (_mount_table wire-up) is NOT populated at R25.M4 — that
// happens at R25.M5+ when we grow src/kernel/core/fs/backend_registry.pdx
// to know about PDXFS_LITE=5.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
// The task spec calls for a "PDXFS MOUNT OK bytes=<sb.size>" fingerprint on
// successful mount from init. At R25.M4 no live blkdev exists under the
// `-kernel` path (KIND_BLKDEV cap plumbing gates on #1015 / R28+), so mount
// is not called from init and no klog line is emitted. When the boot-time
// wire lands, the caller should klog:
//
//   klog(SUBSYS_FS, "PDXFS MOUNT OK root_vn=%u nsid=%u",
//        root_vn_idx, nsid);
//
// (sb.size is not a superblock field; the equivalent is
// sb.itable_bcount * sb.block_size = kernel-visible metadata region size —
// documented deviation from the task spec's fingerprint format.)
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_mo_`.

module MountOp = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let PDXFS_LITE_MOUNT_OK             : u64 = 0
  pub let PDXFS_LITE_MOUNT_FAIL           : u64 = 0xFFFF   // MOUNT_IDX_NONE mirror

  pub let PDXFS_LITE_VNODE_TYPE_DIR       : u64 = 2       // VNODE_TYPE_DIR mirror
  pub let PDXFS_LITE_VNODE_IDX_NONE       : u64 = 0xFFFF  // VNODE_IDX_NONE mirror
  pub let PDXFS_LITE_SB_ROOT_INO_OFFSET   : u64 = 64      // PDXFS_SB_ROOT_INO_OFFSET mirror

  pub let PDXFS_LITE_VN_TYPE_OFFSET       : u64 = 0
  pub let PDXFS_LITE_VN_PARENT_OFFSET     : u64 = 8
  pub let PDXFS_LITE_VN_OPS_PTR_OFFSET    : u64 = 24
  pub let PDXFS_LITE_VN_BACKEND_OFFSET    : u64 = 32

  // ============================================================================
  // pdxfs_lite_mount(bar0: u64, nsid: u64, mountpoint_vn_idx: u64) -> u64
  //
  //   rdi = bar0 (unused at R25.M4; API stability — see header)
  //   rsi = nsid (u32 semantics)
  //   rdx = mountpoint_vn_idx (0xFFFF for detached root)
  //
  //   Returns rax = root vnode-pool idx on success, 0xFFFF on failure.
  //
  //   Flow:
  //     (1)   pdxfs_lite_read_and_stage_superblock(bar0, nsid). Non-zero → FAIL.
  //           The superblock is now valid at &_pdxfs_sb (structural checks).
  //     (1.5) R25-M5-001 (#929): pdxfs_sb_verify_sig(&_pdxfs_sb,
  //           pdxfs_lite_pubkey_ptr()) → 0 (fail) means FAIL. Under
  //           R25.M5 Features.PDXFS_DEV_KEY_ONLY=1 this accepts an
  //           all-zero sig; R32 flip switches to real ML-DSA-65 verify.
  //     (2) root_ino = *(u64*)(&_pdxfs_sb + PDXFS_LITE_SB_ROOT_INO_OFFSET).
  //     (3) vnode_alloc → root_vn_idx. 0xFFFF → FAIL.
  //     (4) vnode_slot(root_vn_idx) → &vnode. Populate:
  //         - +0  type       = VNODE_TYPE_DIR (2)
  //         - +8  parent_idx = mountpoint_vn_idx (or VNODE_IDX_NONE if 0)
  //         - +24 ops_ptr    = &_pdxfs_lite_vops
  //         - +32 backend_ptr= root_ino (u64)
  //     (5) Populate _pdxfs_lite_mount_ctx:
  //         - +0  nsid
  //         - +8  &_pdxfs_sb
  //         - +16 root_ino
  //         - +24 root_vn_idx
  //         - +32 mounted_flag = 1
  //     (6) Return root_vn_idx.
  //
  //   Register plan (5-push callee-save; entry rsp%16==8 + 40 = 48, %16==0
  //   at call sites — no pad required):
  //     rbx = bar0            (retained for future cap-resolve hook)
  //     r12 = nsid
  //     r13 = mountpoint_vn_idx
  //     r14 = root_ino
  //     r15 = root_vn_idx
  // ============================================================================
  pub let pdxfs_lite_mount : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (bar0: u64, nsid: u64, mountpoint_vn_idx: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M4-002 (#925) + R25-M5-001 (#929). Mount a PdxFS-lite image: read+validate superblock, verify its ML-DSA-65 signature (dev-bypass at R25.M5), allocate a VFS vnode for the root inode, publish it, record in _pdxfs_lite_mount_ctx. Body: (1) 5-push callee-save prologue (rbx=bar0, r12=nsid, r13=mountpoint_vn_idx, r14=root_ino, r15=root_vn_idx) — 40 B; entry rsp%16==8 + 40 = 48, %16==0 for nested calls (pdxfs_lite_read_and_stage_superblock / pdxfs_lite_pubkey_ptr / pdxfs_sb_verify_sig / vnode_alloc / vnode_slot). No pad required. (2) Stage args. (3) Call pdxfs_lite_read_and_stage_superblock(bar0, nsid); non-zero → FAIL. (3.5) Signature-verify gate (#929): call pdxfs_lite_pubkey_ptr → rax; mov rsi, rax; lea rdi, [rip+_pdxfs_sb]; call pdxfs_sb_verify_sig; cmp rax,0; je FAIL. Rejects a superblock whose sig field does not satisfy the current mode (dev-bypass accepts all-zero sig at MVP; real ML-DSA-65 verify at R32). Both callees are leaf mem-only functions so no callee-save disturbance. (4) Load root_ino from _pdxfs_sb+64 (PDXFS_SB_ROOT_INO_OFFSET) into r14. (5) Call vnode_alloc; if 0xFFFF → FAIL. Save into r15. (6) Call vnode_slot(r15) → rax = &vnode. Stamp: +0 type = 2 (VNODE_TYPE_DIR); +8 parent = r13 (or 0xFFFF if r13 == 0); +24 ops_ptr = &_pdxfs_lite_vops; +32 backend_ptr = r14 (root_ino). (7) Populate _pdxfs_lite_mount_ctx: +0 nsid = r12, +8 sb = &_pdxfs_sb, +16 root_ino = r14, +24 root_vn_idx = r15, +32 mounted = 1. (8) Return r15. Reserved labels: pdxl_mo_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                              // bar0
        mov r12, rsi;                              // nsid
        mov r13, rdx;                              // mountpoint_vn_idx

        // (0) Ensure the vops table is populated. pdxfs_lite_vops_init is
        //     idempotent (a plain slot-store populator), so calling it here
        //     removes the boot-time-init dependency without penalty. If a
        //     future kernel_main hook lands (mirroring tmpfs_vops_init), this
        //     call becomes redundant but remains harmless.
        call pdxfs_lite_vops_init;

        // (1) Read + validate superblock into _pdxfs_sb.
        mov rdi, rbx;
        mov rsi, r12;
        call pdxfs_lite_read_and_stage_superblock;
        cmp rax, 0;
        jne pdxl_mo_fail;

        // (1.5) R25-M5-001 (#929): signature verify. Runs AFTER the
        //       structural sb_validate (magic/version/block_size/root_ino
        //       already sane) and BEFORE mount publication into
        //       _pdxfs_lite_mount_ctx — a failing verify means the mount
        //       never observes a `mounted_flag=1` state. Verify returns
        //       1 on pass, 0 on fail. At R25.M5 under Features.PDXFS_
        //       DEV_KEY_ONLY=1 this accepts an all-zero sig; when R32
        //       flips Features.CRYPTO_ML_DSA_ENABLED=1, the real
        //       ML-DSA-65 verify takes over — no wire-up change here.
        //       Args: rdi=&_pdxfs_sb, rsi=pubkey_pa (pdxfs_lite_pubkey_ptr()).
        //       Verify is a pure-mem leaf so its call site does not
        //       disturb the callee-save discipline established at prologue.
        call pdxfs_lite_pubkey_ptr;
        mov rsi, rax;                              // rsi = pubkey_pa
        lea rdi, [rip + _pdxfs_sb];                // rdi = &sb
        call pdxfs_sb_verify_sig;
        cmp rax, 0;
        je pdxl_mo_fail;                           // 0 = verify fail (E_INVALID_SB)

        // (2) Extract root_ino from the staged superblock.
        lea rax, [rip + _pdxfs_sb];
        mov r14, [rax + 64];                       // sb.root_ino (u64 @ +64)
        cmp r14, 0;
        je pdxl_mo_fail;                           // defensive: sb_validate should have caught this

        // (3) Allocate a vnode-pool slot for the root vnode.
        call vnode_alloc;
        cmp rax, 0xFFFF;
        je pdxl_mo_fail;
        mov r15, rax;                              // root_vn_idx

        // (4) Populate the root vnode's fields.
        mov rdi, r15;
        call vnode_slot;                           // rax = &vnode

        // +0 type = VNODE_TYPE_DIR (2).
        mov rcx, 2;
        mov [rax + 0], rcx;

        // +8 parent_idx = mountpoint_vn_idx (or VNODE_IDX_NONE if caller
        //     passed 0 = unset).
        mov rcx, 0xFFFF;                           // VNODE_IDX_NONE default
        cmp r13, 0;
        je pdxl_mo_no_parent;
        mov rcx, r13;
        and rcx, 0xFFFF;

      pdxl_mo_no_parent:
        mov [rax + 8], rcx;

        // +24 ops_ptr = &_pdxfs_lite_vops.
        lea rcx, [rip + _pdxfs_lite_vops];
        mov [rax + 24], rcx;

        // +32 backend_ptr = root_ino (u64).
        mov [rax + 32], r14;

        // (5) Populate _pdxfs_lite_mount_ctx.
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov [rax + 0], r12;                        // nsid
        lea rcx, [rip + _pdxfs_sb];
        mov [rax + 8], rcx;                        // &sb
        mov [rax + 16], r14;                       // root_ino
        mov [rax + 24], r15;                       // root_vn_idx
        mov rcx, 1;
        mov [rax + 32], rcx;                       // mounted_flag = 1

        // (6) Return root_vn_idx.
        mov rax, r15;
        jmp pdxl_mo_ret;

      pdxl_mo_fail:
        mov rax, 0xFFFF;

      pdxl_mo_ret:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pdxfs_lite_is_mounted() -> u64
  //   Returns 1 if a PdxFS-lite mount is live, 0 otherwise. Consulted by
  //   namei (which cannot start walking before a mount exists).
  //
  //   Leaf.
  // ============================================================================
  pub let pdxfs_lite_is_mounted : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M4-002 (#925). Return _pdxfs_lite_mount_ctx[+32] (mounted_flag). Leaf: single load + ret.",
      block: {
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rax, [rax + 32];
        ret
      }
    }

  // ============================================================================
  // pdxfs_lite_mount_root_vn() -> u64
  //   Returns the root vnode-pool idx of the current mount, or 0 if not
  //   mounted. Consulted by namei as its starting anchor.
  //
  //   Leaf.
  // ============================================================================
  pub let pdxfs_lite_mount_root_vn : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M4-002 (#925). Return _pdxfs_lite_mount_ctx[+24] (root_vn_idx). Zero when not mounted (mount_ctx starts zero, and vnode_alloc never returns idx 0 anyway per the slot-0 sentinel discipline). Leaf.",
      block: {
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rax, [rax + 24];
        ret
      }
    }
}
