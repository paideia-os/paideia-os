// src/kernel/core/fs/pdxfs_lite/pubkey.pdx — R25-M5-002 (#930)
//
// Embedded PdxFS-lite ML-DSA-65 public key — kernel-image-resident.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// The mount signature-verify path (verify.pdx pdxfs_sb_verify_sig,
// #929) needs a public key to feed the ML-DSA-65 verify primitive.
// Embedding the key inside kernel.elf (rather than reading it from
// disk / a boot-time parameter) matches the "root-of-trust lives
// with the code that verifies signatures against it" discipline
// laid out in design/security/root-of-trust-model.md — reading the
// key from disk before verifying the disk would beg the question.
//
// At R25.M5 the embedded blob is 1952 bytes of zeros. Rationale:
//
//   * ML-DSA-65 public keys are exactly 1952 bytes (NIST FIPS 204
//     §5.4 "Parameter Sets" pk_bytes column). Fixing the array
//     length here at 1952 gives an R32-ready substrate: when the
//     real crypto lands, the asset file gets swapped for a real
//     key and the .pdx symbol keeps the same address + size.
//
//   * The dev-mode bypass path in verify.pdx does not consult the
//     public key at all (it just tests the signature against all
//     zeros). So an all-zero key at MVP is inert — the pointer is
//     threaded through the verify API for interface stability, but
//     never dereferenced under Features.PDXFS_DEV_KEY_ONLY=1.
//
//   * When Features.CRYPTO_ML_DSA_ENABLED flips to 1 at R32, this
//     asset file must be regenerated from a real ML-DSA-65 keypair
//     (paideia-keys / tools/gen-pdxfs-key.sh — R32 scope). The
//     private half stays offline; the mkfs tool (tools/mkfs-pdxfs-
//     lite.sh) grows a --sign-with <priv-key> option that emits
//     real signatures.
//
// -----------------------------------------------------------------------------
// Layout constants
// -----------------------------------------------------------------------------
//
// PDXFS_LITE_PUBKEY_BYTES = 1952
//   ML-DSA-65 fixed public-key size per NIST FIPS 204 §5.4.
//
// @align(64) on the storage — cacheline-aligned so the future R32
// verify primitive can burst-load key words without straddling.
//
// -----------------------------------------------------------------------------
// Physical address discipline (matches design/kernel/vfs-layout.md §5)
// -----------------------------------------------------------------------------
//
// pdxfs_lite_pubkey_ptr() returns the *virtual* address of the
// embedded blob. Under the identity-map discipline the kernel
// establishes at aspace_map_init (post R14b), the virtual and
// physical addresses of any low-half .bss / .rodata byte are equal.
// The verify API declares its pubkey_pa argument as u64 to signal
// "physical address"; callers pass whatever pdxfs_lite_pubkey_ptr
// returns and the identity map does the right thing.
//
// -----------------------------------------------------------------------------
// Encoder floor
// -----------------------------------------------------------------------------
//
// - @include_bytes (paideia-as issue #1013, v0.19+) — path is
//   resolved relative to this .pdx file's directory. From
//   src/kernel/core/fs/pdxfs_lite/pubkey.pdx to
//   assets/keys/pdxfs-lite-dev.pub the ../ walk is:
//     src/kernel/core/fs/pdxfs_lite/  -> src/kernel/core/fs/
//                                     -> src/kernel/core/
//                                     -> src/kernel/
//                                     -> src/
//                                     -> <repo root>
//   Five ../ steps then assets/keys/pdxfs-lite-dev.pub. Precedent:
//   src/kernel/core/drivers/fb_font.pdx L128 uses the identical
//   idiom with four ../ steps (fb_font.pdx sits one dir shallower).
//
// - lea r64, [rip + sym] + ret (leaf) — proven encoder shape
//   throughout the kernel.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// This module is straight-line (single leaf function, no branches),
// so no label prefix is needed.

module Pubkey = structure {

  // ============================================================================
  // Layout constants — frozen at R25.M5. Any change tracks NIST FIPS 204
  // parameter-set changes and requires simultaneous updates to the mkfs
  // tool + design/filesystem/pdxfs-lite-format.md §5.4.
  // ============================================================================

  pub let PDXFS_LITE_PUBKEY_BYTES : u64 = 1952

  // ============================================================================
  // _pdxfs_lite_pubkey — 1952-byte embedded ML-DSA-65 public-key blob.
  //
  // Emitted by paideia-as as an immutable byte array in .rodata via
  // @include_bytes. Path resolved relative to this .pdx file's directory
  // (five ../ steps to the repo root, then assets/keys/pdxfs-lite-dev.pub).
  //
  // @align(64) forces cacheline alignment — the future R32 verify path
  // will burst-read the key in aligned 64-byte chunks; this alignment
  // guarantees no chunk crosses a cacheline boundary.
  //
  // The `_pdxfs_lite_pubkey` name is `pub` (visible as an nm symbol) so
  // R25.M5 close-verification can grep for it directly and R32 wire-up
  // can reference it without a forward-decl fixup.
  // ============================================================================
  pub let _pdxfs_lite_pubkey : [u8; 1952] =
    @include_bytes("../../../../../assets/keys/pdxfs-lite-dev.pub") @align(64)

  // ============================================================================
  // pdxfs_lite_pubkey_ptr() -> u64
  //   Returns &_pdxfs_lite_pubkey (virtual address; identity-mapped to its
  //   physical address per the kernel's identity-map discipline — see
  //   design/kernel/vfs-layout.md §5). Consumers pass the returned u64 as
  //   the `pubkey_pa` argument to pdxfs_sb_verify_sig.
  //
  //   Leaf: single lea + ret, no callee-save touched.
  // ============================================================================
  pub let pdxfs_lite_pubkey_ptr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M5-002 (#930). Return &_pdxfs_lite_pubkey. Single-instruction body plus ret. lea from rip-relative label is the standard address-taking idiom used throughout this kernel (superblock.pdx L194 sb_scratch_addr, tmpfs/inode.pdx, nvme/sync.pdx L194 _nvme_requests). Leaf function, no callee-save. Marked `mem` effect conservatively since callers dereference the returned pointer; the function itself is pure address arithmetic.",
      block: {
        lea rax, [rip + _pdxfs_lite_pubkey];
        ret
      }
    }
}
