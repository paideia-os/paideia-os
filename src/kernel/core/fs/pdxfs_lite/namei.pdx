// src/kernel/core/fs/pdxfs_lite/namei.pdx — R25-M4-004 (#927)
//
// PdxFS-lite path lookup (namei-lite): walk `/` -> `dir1` -> `dir2` -> `file`
// by dispatching each component through vops_lookup against the current
// vnode.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// pdxfs_lite_namei(path, path_len, out_vnode) -> u16
//
//   Walks a NUL-terminated ASCII path starting from the mounted PdxFS-lite
//   root vnode. On success, writes the resolved vnode-pool idx (as u64) to
//   *out_vnode and returns 0. On failure, writes 0 to *out_vnode and returns
//   an errno-like code:
//
//     PDXFS_NAMEI_OK           (0)     — hit
//     PDXFS_NAMEI_ENOENT       (1)     — a component along the path did not
//                                        exist
//     PDXFS_NAMEI_ENOTMOUNTED  (2)     — no PdxFS-lite mount is live
//     PDXFS_NAMEI_ENAMETOOLONG (3)     — a component exceeds PATH_MAX/NAME_MAX
//                                        (delegated to the shared path
//                                        resolver's bounds)
//     PDXFS_NAMEI_EINVAL       (4)     — path is NULL or path_len is 0
//
// -----------------------------------------------------------------------------
// Implementation
// -----------------------------------------------------------------------------
//
// At R16.M1 the kernel already ships src/kernel/core/fs/path.pdx
// (`path_resolve`) — a robust component walker that dispatches each step
// through vops_lookup against the current vnode's ops table. Because
// pdxfs_lite's root vnode carries `ops_ptr = &_pdxfs_lite_vops`, each
// lookup step ultimately reaches _pdxfs_lite_lookup_adapter → get_inode →
// pdxfs_lite_lookup_by_name (readdir.pdx). No duplication required.
//
// pdxfs_lite_namei is therefore a thin wrapper:
//
//   (1) Validate args (path != NULL, path_len > 0).
//   (2) Confirm a PdxFS-lite mount is live (pdxfs_lite_is_mounted).
//   (3) Anchor the walk at the mount's root vnode (pdxfs_lite_mount_root_vn).
//   (4) Delegate to path_resolve.
//   (5) Translate path_resolve's zero-on-failure convention into the errno
//       codes above and stamp *out_vnode.
//
// The path_len arg is retained for signature stability with the task spec
// but is not used inside — path_resolve enforces PATH_MAX=256 via its own
// scan (see src/kernel/core/fs/path.pdx L96-108). A future revision can
// early-reject when path_len > PATH_MAX to save the scan cost.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_ni_`.

module Namei = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let PDXFS_NAMEI_OK             : u64 = 0
  pub let PDXFS_NAMEI_ENOENT         : u64 = 1
  pub let PDXFS_NAMEI_ENOTMOUNTED    : u64 = 2
  pub let PDXFS_NAMEI_ENAMETOOLONG   : u64 = 3
  pub let PDXFS_NAMEI_EINVAL         : u64 = 4

  // ============================================================================
  // pdxfs_lite_namei(path: u64, path_len: u64, out_vnode: u64) -> u64
  //
  //   rdi = path (ptr to NUL-terminated ASCII path)
  //   rsi = path_len (in bytes, excluding NUL — informational)
  //   rdx = out_vnode (writable u64 destination for the resolved vnode idx)
  //
  //   Returns rax = PDXFS_NAMEI_* code.
  //
  // Register plan (3-push callee-save; entry rsp%16==8 + 24 = 32 → sub 8 →
  // 40, %16==8 for nested calls; oh wait — SysV requires %16==0 at call
  // boundary. Recompute: 8+24=32, 32 mod 16 = 0. That's already aligned;
  // no sub rsp needed. Post-call the callee sees 32-8+8 = 32 % 16 = 0 —
  // wait, the callee's own CALL push makes it rsp%16 = (32-8) % 16 = 8.
  // Correct — callee entry rsp%16 == 8, standard SysV. No pad required):
  //
  //     rbx = path
  //     r12 = out_vnode
  //     r13 = resolved_idx (temp across final store)
  // ============================================================================
  pub let pdxfs_lite_namei : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (path: u64, path_len: u64, out_vnode: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M4-004 (#927). Thin wrapper that anchors path_resolve at the PdxFS-lite mount root. Body: (1) 3-push callee-save prologue (rbx=path, r12=out_vnode, r13=resolved_idx) — 24 B; entry rsp%16==8 + 24 = 32, %16==0 at nested-call sites (no pad). (2) Validate: path != 0, out_vnode != 0. Zero either → EINVAL and stamp *out_vnode = 0 if out_vnode != 0. (3) Check pdxfs_lite_is_mounted; zero → ENOTMOUNTED. (4) Load root_vn_idx via pdxfs_lite_mount_root_vn; zero → ENOTMOUNTED (defensive — is_mounted already checked). (5) Call path_resolve(path=rbx, root_idx=rax, cwd=0). Zero → ENOENT. (6) Save resolved into r13, stamp *r12 = r13, return OK. Error paths stamp *r12 = 0 (when r12 != 0) and return the appropriate code. Reserved labels: pdxl_ni_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                              // path
        mov r12, rdx;                              // out_vnode

        // (1) Validate path != 0.
        cmp rbx, 0;
        je pdxl_ni_einval;

        // Validate out_vnode != 0.
        cmp r12, 0;
        je pdxl_ni_einval_no_stamp;

        // (2) Check mount.
        call pdxfs_lite_is_mounted;
        cmp rax, 0;
        je pdxl_ni_enotmounted;

        // (3) Load root vnode idx.
        call pdxfs_lite_mount_root_vn;
        cmp rax, 0;
        je pdxl_ni_enotmounted;

        // (4) Delegate to path_resolve(path, root_idx, cwd=0).
        mov rsi, rax;                              // root_idx
        mov rdi, rbx;                              // path
        xor rdx, rdx;                              // cwd = 0
        call path_resolve;
        cmp rax, 0;
        je pdxl_ni_enoent;

        // (5) Success — stamp *out_vnode = resolved idx.
        mov r13, rax;
        mov [r12 + 0], r13;
        xor eax, eax;                              // PDXFS_NAMEI_OK
        jmp pdxl_ni_ret;

      pdxl_ni_enoent:
        // Stamp *out_vnode = 0 to preclude a stale reader.
        xor rcx, rcx;
        mov [r12 + 0], rcx;
        mov rax, 1;                                // PDXFS_NAMEI_ENOENT
        jmp pdxl_ni_ret;

      pdxl_ni_enotmounted:
        xor rcx, rcx;
        mov [r12 + 0], rcx;
        mov rax, 2;                                // PDXFS_NAMEI_ENOTMOUNTED
        jmp pdxl_ni_ret;

      pdxl_ni_einval:
        // out_vnode is non-null here (or we'd be at pdxl_ni_einval_no_stamp).
        xor rcx, rcx;
        mov [r12 + 0], rcx;
      pdxl_ni_einval_no_stamp:
        mov rax, 4;                                // PDXFS_NAMEI_EINVAL

      pdxl_ni_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
