// src/kernel/core/fs/pdxfs_lite/readdir.pdx — R25-M4-003 (#926)
//
// PdxFS-lite directory read + name lookup by iterating the on-disk directory
// data blocks via the R25.M2 read pipeline (pdxfs_read + extent_translate).
//
// -----------------------------------------------------------------------------
// On-disk directory entry — 256-byte fixed stride
// -----------------------------------------------------------------------------
//
//   Offset  Size  Field       Type    Notes
//   ------  ----  ----------  ------  --------------------------------------
//   0       8     inode_id    u64 LE  0 == unused / tombstone
//   8       2     name_len    u16 LE  1..240 for a live entry
//   10      1     type        u8      1=REG, 2=DIR, 4=SYMLINK, 15=UNUSED
//   11      5     _pad        u8[5]   Zero
//   16      240   name        u8[240] NUL-terminated, remainder = 0
//   --------------------------------------------------------------------------
//   256 total
//
// 16 entries per 4 KiB block. The directory's inode.size (bytes) tells us how
// many entries are in play: entry_count = size / 256. mkfs writes root with
// size = 0 (empty dir), so at R25.M4 readdir on the mkfs-produced image
// trivially returns 0 entries. The code path is exercised end-to-end by the
// vops dispatcher, though — this is what pins the vops table wiring.
//
// -----------------------------------------------------------------------------
// Deviation note (from #926 issue body)
// -----------------------------------------------------------------------------
//
// The issue body proposed a variable-length record (name_len:u8, type:u8,
// inode_id:u32, name[name_len]). The task-body specification (R25.M4 task
// list) locks in the 256-byte fixed-stride form because:
//
//   (a) Fixed stride removes a parse pass at readdir time (index -> offset is
//       a shift, not a scan).
//   (b) 256 B aligns to L1 cache line (matches PDXL-D5 in
//       design/filesystem/pdxfs-lite-format.md).
//   (c) 240-byte names are long enough for the MVP shell without an indirect
//       string-heap.
//
// Documented deviation.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_rd_dir_` and `pdxl_lu_`.

module Readdir = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let PDXFS_LITE_DIRENT_SIZE          : u64 = 256
  pub let PDXFS_LITE_DIRENT_SHIFT         : u64 = 8      // log2(256)

  pub let PDXFS_LITE_DIRENT_INODE_OFFSET  : u64 = 0      // u64
  pub let PDXFS_LITE_DIRENT_NAMELEN_OFFSET: u64 = 8      // u16
  pub let PDXFS_LITE_DIRENT_TYPE_OFFSET   : u64 = 10     // u8
  pub let PDXFS_LITE_DIRENT_NAME_OFFSET   : u64 = 16
  pub let PDXFS_LITE_DIRENT_NAME_MAX      : u64 = 240

  pub let PDXFS_LITE_INODE_SIZE_OFFSET    : u64 = 8      // mirror of PDXFS_INODE_SIZE_FIELD_OFFSET

  // ============================================================================
  // Scratch buffer for one dirent (256 B) during name lookup.
  // ============================================================================
  pub let mut _pdxfs_lite_dirent_scratch : [u64; 32] = uninit @align(8)

  // ============================================================================
  // pdxfs_lite_readdir(dir_vn: u64, cursor: u64, out_entries: u64,
  //                    max: u64) -> u64
  //
  //   rdi = &dir_vnode (VFS surface — dir_vn, not raw inode)
  //   rsi = cursor (u64 — entry index to start at)
  //   rdx = out_entries (destination byte pointer)
  //   rcx = max (max entries to copy)
  //
  //   Returns rax = number of entries actually copied (0..max).
  //
  //   Body:
  //     (1) Extract dir_inode_id from vnode+32 low 16 bits.
  //     (2) Load nsid/&sb from _pdxfs_lite_mount_ctx.
  //     (3) get_inode(nsid, sb, dir_inode_id, &_pdxfs_lite_inode_scratch).
  //     (4) total = inode.size >> 8   (== inode.size / 256).
  //     (5) if cursor >= total: return 0.
  //     (6) avail = total - cursor. n = min(avail, max).
  //     (7) if n == 0: return 0.
  //     (8) pdxfs_read(nsid, sb, &inode, cursor<<8, n<<8, out_entries).
  //     (9) if read status != 0: return 0.
  //     (10) return n.
  //
  //   Register plan (6-push + 8 pad; entry rsp%16==8 → 56 → 64, %16==0):
  //     rbx = nsid
  //     rbp = &sb
  //     r12 = dir_inode_id
  //     r13 = cursor
  //     r14 = out_entries
  //     r15 = max
  // ============================================================================
  pub let pdxfs_lite_readdir : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (dir_vn: u64, cursor: u64, out_entries: u64, max: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M4-003 (#926). Emit dirents from cursor into out_entries, capped at max. Body: (1) 6-push callee-save prologue + sub rsp,8 alignment pad (entry rsp%16==8 + 48 pushes = 56 + 8 = 64, %16==0). (2) Save cursor/out/max into r13/r14/r15; extract dir_inode_id from rdi+32 low 16 bits into r12; load nsid (mctx+0) into rbx and &sb (mctx+8) into rbp. (3) Call get_inode(rbx, rbp, r12, &_pdxfs_lite_inode_scratch); on non-zero → return 0. (4) total = _pdxfs_lite_inode_scratch[+8] >> 8 (bytes -> entry count). (5) cmp r13, total; jae → return 0. (6) avail = total - r13; n = min(avail, r15). (7) cmp n, 0; je → return 0. (8) pdxfs_read(rbx, rbp, &inode_scratch, r13<<8, n<<8, r14). (9) On non-zero read status → return 0; else return n. Reserved labels: pdxl_rd_dir_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // Extract dir_inode_id.
        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        // Save args.
        mov r13, rsi;                              // cursor
        mov r14, rdx;                              // out_entries
        mov r15, rcx;                              // max

        // Load mount context.
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rbx, [rax + 0];                        // nsid
        mov rbp, [rax + 8];                        // &sb

        // get_inode into scratch.
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        lea rcx, [rip + _pdxfs_lite_inode_scratch];
        call get_inode;
        cmp rax, 0;
        jne pdxl_rd_dir_zero;

        // total = inode.size / 256.
        lea r10, [rip + _pdxfs_lite_inode_scratch];
        mov r11, [r10 + 8];                        // inode.size (u64)
        shr r11, 8;                                // >> 8 (== /256)

        // If cursor >= total: 0 entries.
        cmp r13, r11;
        jae pdxl_rd_dir_zero;

        // avail = total - cursor.
        sub r11, r13;                              // r11 = avail

        // n = min(avail, max).
        cmp r11, r15;
        jbe pdxl_rd_dir_use_avail;
        mov r11, r15;                              // n = max

      pdxl_rd_dir_use_avail:
        // If n == 0: return 0.
        cmp r11, 0;
        je pdxl_rd_dir_zero;

        // Save n on stack (need it as return value after pdxfs_read).
        push r11;
        sub rsp, 8;                                // realign after the extra push

        // pdxfs_read(nsid, sb, &inode, cursor<<8, n<<8, out).
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_lite_inode_scratch];
        mov rcx, r13;
        shl rcx, 8;                                // cursor * 256
        mov r8, r11;
        shl r8, 8;                                 // n * 256
        mov r9, r14;
        call pdxfs_read;

        add rsp, 8;                                // undo realign
        pop r11;                                   // recover n

        cmp rax, 0;
        jne pdxl_rd_dir_zero;

        mov rax, r11;
        jmp pdxl_rd_dir_ret;

      pdxl_rd_dir_zero:
        xor eax, eax;

      pdxl_rd_dir_ret:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pdxfs_lite_lookup_by_name(nsid, sb, dir_inode, name_ptr) -> u64
  //
  //   rdi = nsid, rsi = &sb, rdx = &dir_inode (128 B, already loaded),
  //   rcx = name_ptr (NUL-terminated ASCII string, len <= 240 bytes)
  //
  //   Returns child_inode_id (u64 non-zero) on hit, 0 on ENOENT.
  //
  //   Iterates the directory 256-byte entries via pdxfs_read into
  //   _pdxfs_lite_dirent_scratch, comparing each entry's name field
  //   (offset +16, capped at name_len from offset +8) with name_ptr.
  //
  //   Algorithm (linear scan — O(entries)):
  //     total = dir_inode.size / 256
  //     for i in [0, total):
  //       offset = i * 256
  //       pdxfs_read(nsid, sb, dir_inode, offset, 256, &_dirent_scratch)
  //       if read fails: return 0
  //       if scratch.inode_id == 0: continue (tombstone)
  //       n = min(scratch.name_len, 240)
  //       if strncmp_eq_nul(name_ptr, &scratch.name, n): return scratch.inode_id
  //     return 0
  //
  //   Register plan (6-push + 8 pad; entry rsp%16==8 → 56 → 64, %16==0):
  //     rbx = nsid
  //     rbp = &sb
  //     r12 = &dir_inode
  //     r13 = name_ptr
  //     r14 = i (entry index)
  //     r15 = total (entry count)
  // ============================================================================
  pub let pdxfs_lite_lookup_by_name : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (nsid: u64, sb: u64, dir_inode: u64, name_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M4-003 (#926). Linear scan over dir_inode.size/256 entries, comparing each 256-byte record's name field to name_ptr. Body: (1) 6-push callee-save prologue + sub rsp,8 alignment (entry rsp%16==8 + 48 = 56 + 8 = 64, %16==0). (2) Stage args: rbx=nsid, rbp=sb, r12=dir_inode, r13=name_ptr. (3) total = dir_inode.size >> 8 into r15. If total == 0 → return 0 (empty dir). (4) i = 0 into r14. (5) Outer loop pdxl_lu_top: cmp r14, r15; jae pdxl_lu_miss. (6) Compute file_offset = i * 256: mov rcx, r14; shl rcx, 8. (7) pdxfs_read(rbx, rbp, r12, offset, 256, &_pdxfs_lite_dirent_scratch). On non-zero status → return 0 (I/O failure treated as ENOENT for lookup semantics — surface convention per src/kernel/core/fs/vops.pdx L172). (8) Load scratch.inode_id (u64 @ +0). If 0 → skip (tombstone). (9) Compare names: load scratch.name_len (u16 @ +8) into r10, cap at 240. Call pdxl_lu_strncmp(name_ptr, &scratch.name (+16), r10). On match (rax == 1) → return scratch.inode_id. (10) i++, jmp top. Reserved labels: pdxl_lu_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                              // nsid
        mov rbp, rsi;                              // sb
        mov r12, rdx;                              // dir_inode
        mov r13, rcx;                              // name_ptr

        // total = dir_inode.size / 256.
        mov r15, [r12 + 8];
        shr r15, 8;
        cmp r15, 0;
        je pdxl_lu_miss;

        xor r14, r14;                              // i = 0

      pdxl_lu_top:
        cmp r14, r15;
        jae pdxl_lu_miss;

        // pdxfs_read(nsid, sb, dir_inode, i*256, 256, &_pdxfs_lite_dirent_scratch).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r14;
        shl rcx, 8;                                // i * 256
        mov r8, 256;                               // len = 256
        lea r9, [rip + _pdxfs_lite_dirent_scratch];
        call pdxfs_read;
        cmp rax, 0;
        jne pdxl_lu_miss;                          // I/O failure → ENOENT surface

        // Load scratch.inode_id (u64 @ +0). Tombstone if 0.
        lea r10, [rip + _pdxfs_lite_dirent_scratch];
        mov r11, [r10 + 0];
        cmp r11, 0;
        je pdxl_lu_next;

        // Compare names. Load scratch.name_len (u16 @ +8).
        xor rax, rax;
        mov_w rax, [r10 + 8];
        // Cap at 240.
        cmp rax, 240;
        jbe pdxl_lu_cap_ok;
        mov rax, 240;

      pdxl_lu_cap_ok:
        // Call strncmp(name_ptr, &scratch.name, name_len).
        mov rdi, r13;                              // name_ptr
        lea rsi, [r10 + 16];                       // &scratch.name
        mov rdx, rax;                              // name_len
        call pdxl_lu_strncmp;
        cmp rax, 1;
        je pdxl_lu_hit;

      pdxl_lu_next:
        add r14, 1;
        jmp pdxl_lu_top;

      pdxl_lu_hit:
        // Return scratch.inode_id.
        lea r10, [rip + _pdxfs_lite_dirent_scratch];
        mov rax, [r10 + 0];
        jmp pdxl_lu_ret;

      pdxl_lu_miss:
        xor eax, eax;

      pdxl_lu_ret:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pdxl_lu_strncmp(a: *u8, b: *u8, n: u64) -> u64
  //   rdi = a, rsi = b, rdx = n
  //   Returns 1 if:
  //     - the first n bytes of a and b compare equal, AND
  //     - a[n] == 0 (i.e. `a` is NUL-terminated exactly at length n)
  //   Returns 0 otherwise. This matches "exact-length NUL-terminated" lookup
  //   semantics — the dir entry's name field is a fixed 240-byte slab with a
  //   known length (name_len), and the lookup key must match name_len bytes
  //   AND end there. Prevents a 3-byte "foo" query from matching a "foobar"
  //   directory entry.
  //
  //   Leaf. rax/rcx/r8 caller-saved.
  // ============================================================================
  pub let pdxl_lu_strncmp : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (a: u64, b: u64, n: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M4-003 (#926 helper). Byte-by-byte equality on first n bytes AND require a[n] == 0. Body: (1) xor rcx,rcx (i). (2) Loop pdxl_lu_sn_top: cmp rcx, rdx; jae pdxl_lu_sn_check_tail. (3) mov_b r8, [rdi+rcx*1]; mov_b rax, [rsi+rcx*1]; cmp r8, rax; jne pdxl_lu_sn_miss. add rcx, 1; jmp top. (4) pdxl_lu_sn_check_tail: mov_b r8, [rdi+rdx*1]. cmp r8, 0; jne pdxl_lu_sn_miss. mov rax, 1; ret. (5) pdxl_lu_sn_miss: xor eax, eax; ret. Leaf. Encoder: mov_b [reg+reg*1] proven in path.pdx L121.",
      block: {
        xor rcx, rcx;

      pdxl_lu_sn_top:
        cmp rcx, rdx;
        jae pdxl_lu_sn_check_tail;

        xor r8, r8;
        mov_b r8, [rdi + rcx*1];
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        cmp r8, rax;
        jne pdxl_lu_sn_miss;

        add rcx, 1;
        jmp pdxl_lu_sn_top;

      pdxl_lu_sn_check_tail:
        xor r8, r8;
        mov_b r8, [rdi + rdx*1];
        cmp r8, 0;
        jne pdxl_lu_sn_miss;
        mov rax, 1;
        ret;

      pdxl_lu_sn_miss:
        xor eax, eax;
        ret
      }
    }
}
