// src/kernel/core/fs/pdxfs_lite/unlink.pdx — R25-M6-002 (#934)
//
// PdxFS-lite UNLINK: remove a directory entry, drop the target inode's link
// count, free its data blocks + inode slot when link_count reaches zero.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// pdxfs_lite_unlink(parent_vn, name, name_len) -> u64
//
//   Removes the entry `name` from `parent_vn` in-memory (write path stubbed
//   under R25.M6 — see §Write-through gap).
//
//   Returns:
//     PDXFS_MUT_OK      (0)  — never at M6 (write path stubbed).
//     PDXFS_MUT_ENOENT  (2)  — no such entry in parent.
//     PDXFS_MUT_EIO     (3)  — NVMe read failure staging parent inode.
//     PDXFS_MUT_EROFS   (5)  — happy path at M6: entry located, target inode
//                              loaded, in-memory link_count decremented, but
//                              no persistence (nvme_write_blocking is not yet
//                              available — R24 debt #906).
//
// -----------------------------------------------------------------------------
// Flow
// -----------------------------------------------------------------------------
//
//   (1) Extract parent_inode_id from parent_vn +32 low 16 bits.
//   (2) Load nsid/&sb from _pdxfs_lite_mount_ctx.
//   (3) get_inode(parent) into _pdxfs_lite_inode_scratch. EIO on failure.
//   (4) pdxl_dir_find(name, name_len). If 0xFFFFFFFF → ENOENT.
//       Side effect: _pdxfs_lite_dirent_scratch holds the matched 256-byte
//       record (owned by pdxl_dir_find), giving us the target inode_id and
//       type at +0 and +10.
//   (5) target_ino = scratch.inode_id (u64 @+0). Non-zero by pdxl_dir_find's
//       tombstone gate.
//   (6) get_inode(target) into _pdxfs_mut_child_inode_scratch (borrowed from
//       create.pdx — the M6 mutation ops share this second-inode buffer).
//   (7) In-memory: decrement link_count (u16 @+112). If reaches 0:
//         - For each extent[0..8] with len_lba > 0, extent_free(start_lba, len_lba).
//           Failures are swallowed at M6 (extent_free itself returns
//           ETODO_WRITE — the bitmap page is dirty in scratch but not
//           persisted; that's fine for our purposes because we're returning
//           EROFS anyway).
//         - Clear the inode's mode (u16 @+0 = 0) to mark the slot free.
//   (8) [TODO(#906): zero the parent's 256-byte dirent slot and
//        put_inode(parent) + put_inode(target); then persist the extent-bitmap
//        page.]
//   (9) Return PDXFS_MUT_EROFS.
//
// -----------------------------------------------------------------------------
// Write-through gap
// -----------------------------------------------------------------------------
//
// The dir-entry clear (step 8) and both put_inode() calls (parent's touched
// dirent block + target's link_count zero) all require nvme_write_blocking,
// which does not yet exist. At M6 we complete every in-memory transformation
// so the state is inspectable in the scratch buffers, then return EROFS. The
// bitmap-free path IS taken (extent_free succeeds in-scratch) — this makes
// the M6 in-memory state consistent with what disk would show once #906
// lands, so a follow-up test can validate the transformation without
// re-implementing it.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_un_`.

module Unlink = structure {

  // ============================================================================
  // pdxl_un_free_extents(nsid: u64, sb: u64, inode: u64) -> u64
  //
  //   rdi = nsid, rsi = &sb, rdx = &inode (128 B)
  //
  //   For each populated extent slot (start_lba != 0), call
  //   extent_free(start_lba, len_lba). At M6 every extent_free returns
  //   ETODO_WRITE (bitmap dirty in scratch, not persisted) — we ignore
  //   individual return codes and always return 0 here.
  //
  //   Register plan (5-push + 8 pad; entry rsp%16==8 + 40 + 8 = 56, %16==0):
  //     rbx = nsid
  //     rbp = &sb
  //     r12 = &inode
  //     r13 = extent_slot_ptr (r12 + 40 + i*8)
  //     r14 = i
  // ============================================================================
  pub let pdxl_un_free_extents : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (nsid: u64, sb: u64, inode: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M6-002 (#934 helper). Iterate extent[0..8] and call extent_free on each populated slot. Body: (1) 5-push callee-save prologue (rbx=nsid, rbp=sb, r12=inode, r13=slot_ptr, r14=i) — 40 B; entry rsp%16==8 + 40 = 48, sub rsp,8 → 56, %16==0. (2) mov r13, r12; add r13, 40 (&extent[0]). xor r14,r14. (3) Loop pdxl_un_fe_top: cmp r14, 8; jae pdxl_un_fe_done. (4) Load start (u32 @+0). If 0 → break (dense-fill invariant matches inode_current_blocks in write.pdx L100). (5) Load len (u32 @+4). (6) extent_free(rbx, rbp, start, len). Discard rax. (7) Advance: add r13,8; add r14,1; jmp top. (8) xor eax,eax; ret. Reserved labels: pdxl_un_fe_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                              // nsid
        mov rbp, rsi;                              // sb
        mov r12, rdx;                              // &inode

        mov r13, r12;
        add r13, 40;                               // &extent[0]
        xor r14, r14;                              // i

      pdxl_un_fe_top:
        cmp r14, 8;
        jae pdxl_un_fe_done;

        // Load start (u32 @+0).
        xor r8, r8;
        mov_d r8, [r13 + 0];
        cmp r8, 0;
        je pdxl_un_fe_done;                        // dense fill: empty slot terminates

        // Load len (u32 @+4).
        xor r9, r9;
        mov_d r9, [r13 + 4];

        // extent_free(nsid, sb, start_lba=r8, count_lba=r9).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r8;
        mov rcx, r9;
        call extent_free;
        // Discard rax — write-back stub always returns ETODO_WRITE.

        add r13, 8;
        add r14, 1;
        jmp pdxl_un_fe_top;

      pdxl_un_fe_done:
        xor eax, eax;
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pdxfs_lite_unlink(parent_vn, name, name_len) -> u64
  //
  //   rdi = &parent_vnode
  //   rsi = name (u8*, non-NUL-terminated)
  //   rdx = name_len
  //
  //   Returns rax = PDXFS_MUT_* code.
  //
  //   Register plan (5-push + 8 pad; entry rsp%16==8 + 40 + 8 = 56, %16==0):
  //     rbx = nsid
  //     rbp = &sb
  //     r12 = parent_inode_id
  //     r13 = name
  //     r14 = name_len
  //     (target_ino is loaded on demand from _pdxfs_lite_dirent_scratch)
  // ============================================================================
  pub let pdxfs_lite_unlink : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (parent_vn: u64, name: u64, name_len: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M6-002 (#934). Locate the dir entry, load the target inode, decrement link_count, free its extents when link_count reaches 0. Body: (1) 5-push callee-save prologue (rbx=nsid, rbp=sb, r12=parent_ino, r13=name, r14=name_len) — 40 B; entry rsp%16==8 + 40 = 48, sub rsp,8 → 56, %16==0. (2) Stage args. Extract parent_inode_id via [rdi+32] & 0xFFFF. Load nsid/sb from _pdxfs_lite_mount_ctx. (3) get_inode(parent) into _pdxfs_lite_inode_scratch. On non-zero → EIO. (4) pdxl_dir_find(nsid, sb, &_pdxfs_lite_inode_scratch, name, name_len). If rax == 0xFFFFFFFF → ENOENT. (5) target_ino = _pdxfs_lite_dirent_scratch[+0] (u64). (6) get_inode(target) into _pdxfs_mut_child_inode_scratch. On non-zero → EIO. (7) Decrement link_count (u16 @+112) of child. Load into r10 (u16), sub 1, store back. cmp r10, 0. If != 0 → skip extent free. (8) pdxl_un_free_extents(nsid, sb, &child_inode). Zero mode (u16 @+0) to mark slot free. (9) Return EROFS (write path stubbed). Reserved labels: pdxl_un_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // Extract parent_inode_id.
        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        mov r13, rsi;                              // name
        mov r14, rdx;                              // name_len

        // Load nsid/sb from mount ctx.
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rbx, [rax + 0];
        mov rbp, [rax + 8];

        // (3) get_inode(parent).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        lea rcx, [rip + _pdxfs_lite_inode_scratch];
        call get_inode;
        cmp rax, 0;
        jne pdxl_un_eio;

        // (4) pdxl_dir_find.
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_lite_inode_scratch];
        mov rcx, r13;
        mov r8, r14;
        call pdxl_dir_find;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je pdxl_un_enoent;

        // (5) target_ino from _pdxfs_lite_dirent_scratch[+0].
        lea r10, [rip + _pdxfs_lite_dirent_scratch];
        mov r11, [r10 + 0];                        // target inode id
        cmp r11, 0;
        je pdxl_un_enoent;                         // defensive: shouldn't happen after find

        // (6) get_inode(target).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r11;
        lea rcx, [rip + _pdxfs_mut_child_inode_scratch];
        call get_inode;
        cmp rax, 0;
        jne pdxl_un_eio;

        // (7) Decrement link_count (u16 @+112).
        lea r10, [rip + _pdxfs_mut_child_inode_scratch];
        xor r11, r11;
        mov_w r11, [r10 + 112];
        cmp r11, 0;
        je pdxl_un_lc_skip;                        // already at 0 — defensive
        sub r11, 1;
        mov_w [r10 + 112], r11;

        cmp r11, 0;
        jne pdxl_un_lc_skip;                       // still referenced elsewhere

        // (8) link_count reached 0 → free extents + free inode slot.
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_mut_child_inode_scratch];
        call pdxl_un_free_extents;

        // Zero mode (u16 @+0) to mark inode slot free.
        lea r10, [rip + _pdxfs_mut_child_inode_scratch];
        xor r11, r11;
        mov_w [r10 + 0], r11;

      pdxl_un_lc_skip:
        // (9) TODO(#906): put_inode(parent, dirent-cleared) + put_inode(target).
        //     For now, surface as EROFS.
        mov rax, 5;                                // PDXFS_MUT_EROFS
        jmp pdxl_un_ret;

      pdxl_un_enoent:
        mov rax, 2;                                // PDXFS_MUT_ENOENT
        jmp pdxl_un_ret;

      pdxl_un_eio:
        mov rax, 3;                                // PDXFS_MUT_EIO

      pdxl_un_ret:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
