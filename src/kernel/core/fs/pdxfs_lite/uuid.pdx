// src/kernel/core/fs/pdxfs_lite/uuid.pdx — R25-M1-004 (#914)
//
// PdxFS-lite v0 UUID generation + comparison.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// sb_generate_uuid(out: *u8[16]) -> u64
//   Populates a caller-supplied 16-byte buffer with an RFC 4122 v4 UUID.
//   Entropy source at R25.M1: two sequential rdtsc samples (deterministic
//   in principle, non-repeating in practice for one-shot mkfs use). Real
//   CSPRNG (rdrand or ChaCha20 seeded from HW entropy) lands at #929
//   R25.M5. See design doc §4.1 for rationale.
//
// sb_uuid_match(sb: *pdxfs_sb, expected_uuid: *u8[16]) -> u64
//   Returns 1 on bytewise match, 0 on mismatch. Two u64 loads + two u64
//   compares — the only branch is the final "did the two match" test.
//
// -----------------------------------------------------------------------------
// RFC 4122 v4 layout (16 bytes)
// -----------------------------------------------------------------------------
//
//   xxxxxxxx-xxxx-Mxxx-Nxxx-xxxxxxxxxxxx
//                 ^    ^
//   Byte 6 top nibble = 4  (version = 4)
//   Byte 8 top two bits = 10  (RFC 4122 variant)
//
// After filling 16 bytes with the entropy source:
//   out[6] = (out[6] & 0x0F) | 0x40
//   out[8] = (out[8] & 0x3F) | 0x80
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_uid_` (avoids reserved `if`, `loop`, `end`, ...).

module Uuid = structure {

  // ============================================================================
  // sb_generate_uuid(out: *u8[16]) -> u64
  //   rdi = destination pointer (16 writable bytes)
  //   returns 0.
  //
  // Body:
  //   (1) rdtsc → sample1 (u64) via `rdtsc; shl rdx,32; or rax,rdx`
  //       (identical idiom to time/tsc.pdx L138-L140).
  //   (2) Store sample1 at [rdi + 0].
  //   (3) rdtsc → sample2 (a few dozen cycles later, so LSBs differ).
  //   (4) XOR sample2 with the constant 0xA5A5A5A5A5A5A5A5 to spread
  //       bits (TSC low bits are close in successive reads on non-CFT
  //       hosts — the XOR + adjacent-read is a byte-diffuser, not a
  //       real entropy pool. Real entropy at #929 M5).
  //   (5) Store sample2 at [rdi + 8].
  //   (6) Byte 6: load, `and 0x0F`, `or 0x40`, store.
  //   (7) Byte 8: load, `and 0x3F`, `or 0x80`, store.
  //   (8) Return 0.
  //
  // Leaf function; no callee-save touched. mov_b for byte-wide field
  // patches (same encoder shape as nvme/sync.pdx L222 OPC store).
  // ============================================================================

  pub let sb_generate_uuid : (u64) -> u64 !{sysreg, mem} @{} =
    fn (out: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M1-004 (#914). Populate a 16-byte UUID buffer with an RFC 4122 v4 UUID using two rdtsc samples as the entropy source (real CSPRNG deferred to #929 M5). Body: (1) Save `out` in r10 (rdtsc trashes rax/rdx). (2) rdtsc → sample1 via `rdtsc; shl rdx,32; or rax,rdx` (matches time/tsc.pdx L138-L140 idiom exactly). (3) mov [r10+0], rax. (4) rdtsc → sample2 (same reconstruct). (5) XOR sample2 with 0xA5A5A5A5A5A5A5A5 (mov imm64 + xor r64,r64 — imm64 xor encoding gap sidestepped by materialising the constant into r11 first). (6) mov [r10+8], rax. (7) Patch byte 6: mov_b r9, [r10+6]; and r9, 0x0F; or r9, 0x40; mov_b [r10+6], r9. (8) Patch byte 8: mov_b r9, [r10+8]; and r9, 0x3F; or r9, 0x80; mov_b [r10+8], r9. (9) xor eax,eax; ret. Leaf. Encoder posture: rdtsc + shl/or reconstruct proven; mov r64,imm64 proven; mov_b load/store proven; and/or with imm8 proven. Reserved labels: none (straight-line). Note: two adjacent rdtsc samples on invariant-TSC hosts differ by ~30-50 cycles — LSB entropy is thin. The XOR-with-constant is a byte-diffuser to prevent all-zero-high-nibble outputs; it doesn't add entropy. Documented as MVP-only in design/filesystem/pdxfs-lite-format.md §4.1.",
      block: {
        // (1) Save out in r10 (survives rdtsc's rax/rdx clobber).
        mov r10, rdi;

        // (2) sample1 = rdtsc reconstructed to 64-bit.
        rdtsc;
        shl rdx, 32;
        or rax, rdx;

        // (3) Store sample1 at [out + 0].
        mov [r10 + 0], rax;

        // (4) sample2 = rdtsc reconstructed to 64-bit.
        rdtsc;
        shl rdx, 32;
        or rax, rdx;

        // (5) XOR with diffuser (materialise imm64 in r11 first).
        mov r11, 0xA5A5A5A5A5A5A5A5;
        xor rax, r11;

        // (6) Store sample2 at [out + 8].
        mov [r10 + 8], rax;

        // (7) Patch byte 6: (byte & 0x0F) | 0x40  (RFC 4122 version = 4).
        xor r9, r9;
        mov_b r9, [r10 + 6];
        and r9, 0x0F;
        or  r9, 0x40;
        mov_b [r10 + 6], r9;

        // (8) Patch byte 8: (byte & 0x3F) | 0x80  (RFC 4122 variant = 10b).
        xor r9, r9;
        mov_b r9, [r10 + 8];
        and r9, 0x3F;
        or  r9, 0x80;
        mov_b [r10 + 8], r9;

        // (9) Return 0.
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_uuid_match(sb: *pdxfs_sb, expected_uuid: *u8[16]) -> u64
  //   rdi = &sb (superblock base — UUID at offset PDXFS_SB_UUID_OFFSET = 8)
  //   rsi = &expected_uuid (16 bytes)
  //
  //   Returns 1 on match, 0 on mismatch.
  //
  // Body: two u64 compares (bytes [8, 16) vs [0, 8), then bytes [16, 24) vs
  // [8, 16)). AND the two zero-or-not flags into a single 0/1 result via
  // sete + and.
  //
  // Simpler shape: subtract each pair, OR the two differences, then
  // `test rax, rax; setz al; movzx rax, al`. Zero difference in both
  // halves → return 1.
  // ============================================================================

  pub let sb_uuid_match : (u64, u64) -> u64 !{mem} @{} =
    fn (sb: u64, expected_uuid: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M1-004 (#914). Compare 16 bytes at sb+PDXFS_SB_UUID_OFFSET (=8) against expected_uuid[0..16]. Body: (1) Load sb.uuid[0..8]  = [rdi + 8],  expected[0..8] = [rsi + 0]; xor → r10. (2) Load sb.uuid[8..16] = [rdi + 16], expected[8..16]= [rsi + 8]; xor → r11. (3) OR r10, r11 → rax (zero iff both halves matched). (4) cmp rax,0; sete al; movzx rax, al → 1/0. Leaf. Encoder: mov r64,[reg+imm8] and xor r64,r64 proven. `sete al; movzx rax, al` — sete supported. If movzx r64,r8 has a paideia-as gap, we emit `and rax, 0xFF` before returning; safer to just conditional-branch. Rewritten body avoids sete/movzx: branch on jne to a no-match path (rax=0), fall-through path returns rax=1.",
      block: {
        // (1) First 8 bytes.
        mov  r10, [rdi + 8];                        // sb.uuid[0..8]
        mov  r11, [rsi + 0];                        // expected[0..8]
        xor  r10, r11;

        // (2) Second 8 bytes.
        mov  r8,  [rdi + 16];                       // sb.uuid[8..16]
        mov  r9,  [rsi + 8];                        // expected[8..16]
        xor  r8,  r9;

        // (3) OR the two differences.
        or   r10, r8;

        // (4) Branch on zero.
        cmp  r10, 0;
        jne  pdxl_uid_m_no;

        mov  rax, 1;
        ret;

      pdxl_uid_m_no:
        xor  eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_uuid_log_fingerprint(sb: *pdxfs_sb) -> u64  (stub)
  //   Placeholder for the mount fingerprint klog line.
  //   R25.M1 lands the symbol only; real klog emission ("PDXL_MOUNT uuid=...")
  //   lands at R25.M2 when the mount wire calls into klog_s2_x2.
  //   Returns 0.
  // ============================================================================
  pub let sb_uuid_log_fingerprint : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M1-004 (#914). Placeholder — the mount-fingerprint klog emission is scoped to R25.M2 wire-up (see design/filesystem/pdxfs-lite-format.md §5). At M1 this function is a symbol-existence anchor: kernel_main / VFS bring-up can reference it now without a forward-decl fixup at M2. Body: xor eax,eax; ret. Zero effect. Leaf.",
      block: {
        xor eax, eax;
        ret
      }
    }
}
