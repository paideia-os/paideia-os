// src/kernel/core/fs/pdxfs_lite/vops.pdx — R25-M4-001 (#924)
//
// PdxFS-lite VFS backend registration: vops function-pointer table +
// vnode-to-inode adapter thunks + init populator + mount-context storage.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// This file lands the plumbing that lets a mounted PdxFS-lite image participate
// in the VFS dispatch protocol frozen by R16.M1 (#572). It publishes:
//
//   _pdxfs_lite_vops : [u64; 7]         — shared vops function-pointer table
//     +0  read      → _pdxfs_lite_read_adapter
//     +8  write     → _pdxfs_lite_write_adapter
//     +16 open      → _pdxfs_lite_open_stub
//     +24 close     → _pdxfs_lite_close_stub
//     +32 lookup    → _pdxfs_lite_lookup_adapter
//     +40 create    → _pdxfs_lite_create_adapter (R25.M6 #933; EROFS at M6
//                                                  until nvme_write_blocking
//                                                  lands #906)
//     +48 unlink    → _pdxfs_lite_unlink_adapter (R25.M6 #934; EROFS at M6)
//
//   _pdxfs_lite_mount_ctx : [u64; 8]    — 64-B per-mount context (single-mount
//                                          MVP; multi-mount lands with R25.M6+)
//     +0  nsid           (u32 semantics, held as u64)
//     +8  &sb            (identity-mapped pointer into _pdxfs_sb)
//     +16 root_ino       (u64, always 1 at R25 per PDXFS_SB_ROOT_INO_OFFSET)
//     +24 root_vn_idx    (u16 low bits — vnode-pool idx of mounted root)
//     +32 mounted_flag   (0 = not mounted, 1 = mounted)
//     +40..64 reserved
//
//   _pdxfs_lite_inode_scratch : [u64; 16]  — 128-B in-memory copy of the
//                                             on-disk inode currently being
//                                             acted upon (per-adapter re-load;
//                                             no caching at M4).
//
// -----------------------------------------------------------------------------
// Adapter shape
// -----------------------------------------------------------------------------
//
// The vops surface hands the adapter a *vnode pointer* (rdi) plus the op's
// remaining args. The pdxfs_lite primitives (get_inode, pdxfs_read,
// pdxfs_write, pdxfs_lite_lookup_by_name) take (nsid, sb, inode, ...). Each
// adapter therefore:
//
//   (1) Loads inode_id from vnode.backend_ptr (+32, low 16 bits) — matches the
//       tmpfs adapter idiom (src/kernel/core/fs/tmpfs/vops.pdx L41).
//   (2) Loads nsid and &sb from _pdxfs_lite_mount_ctx (single-mount globals).
//   (3) Calls get_inode into _pdxfs_lite_inode_scratch to materialise the
//       128-byte on-disk inode struct in memory.
//   (4) Marshals the primitive's SysV registers and tail-composes.
//
// Reentrancy: at R25.M4 the VFS holds a coarse FS lock across the entire
// dispatch (matching tmpfs, matching #919 write path). The shared
// _pdxfs_lite_inode_scratch is safe under that lock. Per-CPU scratch lands
// with R25.M6+ concurrency substrate.
//
// -----------------------------------------------------------------------------
// Registration
// -----------------------------------------------------------------------------
//
// pdxfs_lite_vops_init() populates the 7 slots at boot (or at first mount).
// A caller-observable hook into the mount table's backend_ops_table registry
// (src/kernel/core/fs/backend_registry.pdx) is deferred to the mount wire-up
// at R25.M5+ — at M4 the mount pathway (mount_op.pdx) publishes ops_ptr
// directly on the root vnode, so registry-driven dispatch is not on the M4
// critical path.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_vp_`.

module Vops = structure {

  // ============================================================================
  // Layout constants
  // ============================================================================

  pub let PDXFS_LITE_MCTX_SIZE            : u64 = 64
  pub let PDXFS_LITE_MCTX_NSID_OFFSET     : u64 = 0
  pub let PDXFS_LITE_MCTX_SB_OFFSET       : u64 = 8
  pub let PDXFS_LITE_MCTX_ROOT_INO_OFFSET : u64 = 16
  pub let PDXFS_LITE_MCTX_ROOT_VN_OFFSET  : u64 = 24
  pub let PDXFS_LITE_MCTX_MOUNTED_OFFSET  : u64 = 32

  pub let PDXFS_LITE_VNODE_BACKEND_OFFSET : u64 = 32   // frozen: vnode +32 = backend_ptr
  pub let PDXFS_LITE_VNODE_OPS_PTR_OFFSET : u64 = 24
  pub let PDXFS_LITE_VNODE_INODE_MASK     : u64 = 0xFFFF   // low 16 bits hold inode_id

  pub let PDXFS_LITE_VOPS_ERR_NOT_SUPPORTED : u64 = 0xFFFFFFFFFFFFFFFF

  // ============================================================================
  // Storage
  // ============================================================================

  // Single-mount per-kernel context. Zero-initialised (mounted_flag = 0 = not
  // mounted). pdxfs_lite_mount populates all fields on success.
  pub let mut _pdxfs_lite_mount_ctx : [u64; 8] = uninit @align(64)

  // 128-byte staging buffer for one loaded inode. Used by adapters as the
  // `out` argument to get_inode and then as the `inode` argument to the
  // pdxfs_read / pdxfs_write / pdxfs_lite_lookup_by_name primitives.
  pub let mut _pdxfs_lite_inode_scratch : [u64; 16] = uninit @align(8)

  // Shared vops function-pointer table. Populated by pdxfs_lite_vops_init.
  // R56.M3-002 (#1791): widened 7 -> 8 for the stat slot at +56.
  // R56.M3-003 (#1792): widened 8 -> 9 for the readdir slot at +64.  Slot
  // +64 is wired to _pdxfs_lite_readdir_stub — the pdxfs_lite on-disk
  // dirent format (256-byte fixed stride, see readdir.pdx §On-disk
  // directory entry) does not match the packed record stream sys_getdents
  // expects, and the format-translation adapter is a follow-up; the stub
  // returns the terminator record so a caller of sys_getdents on a
  // pdxfs_lite dir sees EOD immediately instead of a VOPS_ERR_NOT_SUPPORTED
  // sentinel.
  pub let mut _pdxfs_lite_vops : [u64; 9] = uninit @align(8)

  // ============================================================================
  // mctx accessors
  // ============================================================================

  // pdxfs_lite_mctx_addr() -> u64 — returns &_pdxfs_lite_mount_ctx.
  pub let pdxfs_lite_mctx_addr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M4-001 (#924). Return &_pdxfs_lite_mount_ctx. Leaf; matches sb_scratch_addr idiom in superblock.pdx L188.",
      block: {
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_read_adapter(vn, buf, len, off) -> u64
  //   rdi = &vnode, rsi = buf, rdx = len, rcx = off.
  //
  //   Loads inode from disk, dispatches to pdxfs_read. Returns pdxfs_read's
  //   rax verbatim (0 on success, 1 on EIO, 2 on hole).
  //
  //   Register plan (6-push callee-save + 8 pad; entry rsp%16==8 → 56 → 64):
  //     rbx = nsid            (loaded from mctx +0)
  //     rbp = &sb             (loaded from mctx +8)
  //     r12 = inode_id        (from vnode +32 low 16 bits)
  //     r13 = buf             (rsi at entry)
  //     r14 = len             (rdx at entry)
  //     r15 = off             (rcx at entry)
  // ============================================================================
  pub let _pdxfs_lite_read_adapter : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M4-001 (#924). Bridge vops (vn, buf, len, off) surface to pdxfs_read (nsid, sb, inode, off, len, out_pa). Body: (1) 6-push callee-save prologue + sub rsp,8 for SysV alignment (entry rsp%16==8 + 48 pushes = 56, + 8 pad = 64, %16==0 pre nested-call). (2) Extract inode_id = *(u16*)(vnode+32) low 16 bits — matches tmpfs adapter idiom (src/kernel/core/fs/tmpfs/vops.pdx L41 `mov rdi,[rdi+32]; and rdi,0xFFFF`). Save into r12. (3) Save buf/len/off into r13/r14/r15. (4) Load nsid and &sb from _pdxfs_lite_mount_ctx via lea + [reg+imm8] indirection. (5) Call get_inode(nsid=rbx, sb=rbp, inode_id=r12, out=&_pdxfs_lite_inode_scratch). If status != 0, return VOPS_ERR_NOT_SUPPORTED (0xFFFFFFFFFFFFFFFF). (6) Call pdxfs_read(nsid=rbx, sb=rbp, inode=&_pdxfs_lite_inode_scratch, off=r15, len=r14, out_pa=r13). Return rax verbatim. Reserved labels: pdxl_vp_r_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // Extract inode_id from vnode.backend_ptr (+32, low 16 bits).
        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        // Save buf/len/off into callee-save.
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        // Load nsid and &sb from mount context.
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rbx, [rax + 0];                        // nsid
        mov rbp, [rax + 8];                        // &sb

        // get_inode(nsid, sb, inode_id, &_pdxfs_lite_inode_scratch).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        lea rcx, [rip + _pdxfs_lite_inode_scratch];
        call get_inode;
        cmp rax, 0;
        jne pdxl_vp_r_eio;

        // pdxfs_read(nsid, sb, &inode_scratch, off, len, buf).
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_lite_inode_scratch];
        mov rcx, r15;                              // offset
        mov r8, r14;                               // len
        mov r9, r13;                               // out_pa (buf)
        call pdxfs_read;
        jmp pdxl_vp_r_ret;

      pdxl_vp_r_eio:
        mov rax, 0xFFFFFFFFFFFFFFFF;               // VOPS_ERR_NOT_SUPPORTED

      pdxl_vp_r_ret:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_write_adapter(vn, buf, len, off) -> u64
  //   Identical shape to read adapter but dispatches to pdxfs_write. At R25.M4
  //   pdxfs_write is itself stubbed and returns PDXFS_WRITE_ETODO_WRITE (=4);
  //   the adapter forwards that verbatim. Real write completion lands with the
  //   nvme_write_blocking substrate at R25.M5+ (TODO gated on that milestone).
  // ============================================================================
  pub let _pdxfs_lite_write_adapter : (u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M4-001 (#924). Bridge vops write surface to pdxfs_write. Body identical to _pdxfs_lite_read_adapter but targets pdxfs_write instead of pdxfs_read. Note: pdxfs_write at R25.M2 is stubbed and returns PDXFS_WRITE_ETODO_WRITE (=4) on the happy path — the adapter forwards that verbatim. Real byte-transfer completion lands once nvme_write_blocking exists (R25.M5+). See src/kernel/core/fs/pdxfs_lite/write.pdx §Data write gap. Reserved labels: pdxl_vp_w_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rbx, [rax + 0];
        mov rbp, [rax + 8];

        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        lea rcx, [rip + _pdxfs_lite_inode_scratch];
        call get_inode;
        cmp rax, 0;
        jne pdxl_vp_w_eio;

        // pdxfs_write(nsid, sb, &inode_scratch, off, len, in_pa).
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_lite_inode_scratch];
        mov rcx, r15;
        mov r8, r14;
        mov r9, r13;
        call pdxfs_write;
        jmp pdxl_vp_w_ret;

      pdxl_vp_w_eio:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      pdxl_vp_w_ret:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_lookup_adapter(dir_vn, name_ptr) -> u64
  //   rdi = &dir_vnode, rsi = name_ptr
  //   returns child_inode_id (u16 low bits) on hit, 0 on ENOENT.
  //
  //   Register plan (4-push callee-save; entry rsp%16==8 → 40 → sub 8 → 48):
  //     rbx = nsid
  //     rbp = &sb
  //     r12 = dir_inode_id
  //     r13 = name_ptr
  // ============================================================================
  pub let _pdxfs_lite_lookup_adapter : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M4-001 (#924). Bridge vops lookup (dir_vn, name_ptr) surface to pdxfs_lite_lookup_by_name (nsid, sb, dir_inode, name_ptr). Body: 4-push callee-save prologue (rbx=nsid, rbp=&sb, r12=dir_inode_id, r13=name_ptr) + sub rsp,8 alignment pad. Extract dir_inode_id from vnode+32 low 16 bits. Load nsid/&sb from mount context. Call get_inode → stage into _pdxfs_lite_inode_scratch; if non-zero, return 0 (ENOENT — vops_lookup zero convention per src/kernel/core/fs/vops.pdx L170). Call pdxfs_lite_lookup_by_name(nsid, sb, &inode_scratch, name_ptr). Forward rax verbatim (child inode_id or 0). Reserved labels: pdxl_vp_l_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;

        // Extract dir_inode_id.
        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        // Save name_ptr.
        mov r13, rsi;

        // Load mount context.
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rbx, [rax + 0];
        mov rbp, [rax + 8];

        // get_inode(nsid, sb, dir_inode_id, &inode_scratch).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        lea rcx, [rip + _pdxfs_lite_inode_scratch];
        call get_inode;
        cmp rax, 0;
        jne pdxl_vp_l_enoent;

        // pdxfs_lite_lookup_by_name(nsid, sb, &inode_scratch, name_ptr).
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_lite_inode_scratch];
        mov rcx, r13;
        call pdxfs_lite_lookup_by_name;
        jmp pdxl_vp_l_ret;

      pdxl_vp_l_enoent:
        xor eax, eax;

      pdxl_vp_l_ret:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_open_stub(vn, flags) -> u64
  //   No per-open state at R25.M4. Returns 0 (success). Mirrors tmpfs stub
  //   rationale — the null-slot alternative would return E_NOT_SUPPORTED
  //   and break sys_open on pdxfs_lite-backed files.
  // ============================================================================
  pub let _pdxfs_lite_open_stub : (u64, u64) -> u64 !{} @{} =
    fn (vn: u64) (flags: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R25-M4-001 (#924). Success stub for open. PdxFS-lite has no per-open state at M4 (per-open buffered-write staging lands with the writable path). Returns 0. Leaf.",
      block: {
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_close_stub(vn) -> u64  — mirror of open stub.
  // ============================================================================
  pub let _pdxfs_lite_close_stub : (u64) -> u64 !{} @{} =
    fn (vn: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R25-M4-001 (#924). Success stub for close. Symmetric to _pdxfs_lite_open_stub.",
      block: {
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // _pdxl_vp_strlen(s: *u8) -> u64
  //   Small NUL-scanner. Bounds itself at 240 bytes (dirent name-field cap)
  //   so a malformed / unterminated string never runs off a page.
  //
  //   Introduced at R25.M6 as the shim between the vops surface (which passes
  //   NUL-terminated name_ptr) and pdxfs_lite_create/unlink (which take an
  //   explicit name_len). Not exported outside vops.pdx.
  //
  //   Leaf.
  // ============================================================================
  pub let _pdxl_vp_strlen : (u64) -> u64 !{mem} @{} =
    fn (s: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M6-004 (#933/#934 adapter helper). Scan NUL-terminated string, cap length at 240 (PDXFS_MUT_DIRENT_NAME_MAX). Body: xor rcx,rcx (i). Loop pdxl_vp_sl_top: cmp rcx,240; jae pdxl_vp_sl_done. xor r8,r8; mov_b r8, [rdi+rcx*1]; cmp r8,0; je pdxl_vp_sl_done. add rcx,1; jmp top. pdxl_vp_sl_done: mov rax, rcx; ret. Leaf. Reserved labels: pdxl_vp_sl_.",
      block: {
        xor rcx, rcx;

      pdxl_vp_sl_top:
        cmp rcx, 240;
        jae pdxl_vp_sl_done;
        xor r8, r8;
        mov_b r8, [rdi + rcx*1];
        cmp r8, 0;
        je pdxl_vp_sl_done;
        add rcx, 1;
        jmp pdxl_vp_sl_top;

      pdxl_vp_sl_done:
        mov rax, rcx;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_create_adapter(dir_vn, name_ptr, mode) -> u64
  //
  //   Bridges the vops surface (dir_vn, name_ptr, mode) to
  //   pdxfs_lite_create(parent_vn, name, name_len, mode, out_vnode).
  //   Computes name_len via _pdxl_vp_strlen. Drops the new-vnode out-parameter
  //   (passes 0) — the vops surface does not expose it; callers relookup via
  //   vops_lookup.
  //
  //   Returns pdxfs_lite_create's rax verbatim (0 = success (never at M6),
  //   1=EEXIST, 3=EIO, 4=EFBIG, 5=EROFS). Callers observe EROFS at M6.
  //
  //   Register plan (4-push callee-save + 8 pad; entry rsp%16==8 + 32 + 8 = 48,
  //   %16==0):
  //     rbx = dir_vn, r12 = name_ptr, r13 = mode
  // ============================================================================
  pub let _pdxfs_lite_create_adapter : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (mode: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M6-004 (#933 adapter). Compute strlen(name_ptr) then dispatch to pdxfs_lite_create. Body: (1) 3-push callee-save prologue (rbx=dir_vn, r12=name_ptr, r13=mode) — 24 B; entry rsp%16==8 + 24 = 32, sub rsp,8 → 40, %16==8. Wait — need %16==0 at call. Recompute: 8+24=32, 32%16==0 (already aligned pre-call!). Callee's own CALL push then makes callee-entry rsp%16==8 as SysV requires. So no pad. Layout: 3-push only. (2) Stage args. (3) Compute name_len via _pdxl_vp_strlen(name_ptr). Save rax to r14 — need a 4th push. Rework: 4-push (rbx, r12, r13, r14). Now 8+32=40, sub rsp,8 → 48, %16==0. (4) Dispatch pdxfs_lite_create(dir_vn=rbx, name=r12, name_len=r14, mode=r13, out_vnode=0). Forward rax. Reserved labels: pdxl_vp_ca_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                              // dir_vn
        mov r12, rsi;                              // name_ptr
        mov r13, rdx;                              // mode

        // Compute name_len.
        mov rdi, r12;
        call _pdxl_vp_strlen;
        mov r14, rax;                              // name_len

        // pdxfs_lite_create(dir_vn, name_ptr, name_len, mode, out_vnode=0).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r14;
        mov rcx, r13;
        xor r8, r8;                                // out_vnode = 0
        call pdxfs_lite_create;

        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_unlink_adapter(dir_vn, name_ptr) -> u64
  //
  //   Bridges the vops surface (dir_vn, name_ptr) to
  //   pdxfs_lite_unlink(parent_vn, name, name_len). Computes name_len via
  //   _pdxl_vp_strlen.
  //
  //   Returns pdxfs_lite_unlink's rax verbatim.
  //
  //   Register plan (3-push callee-save + 8 pad; entry rsp%16==8 + 24 + 8 = 40,
  //   %16==8. Hmm — need 0. Adjust: 8+24=32%16==0 already; no pad needed.
  //   But we push 3 items = 24, +8 push-of-outer-call = 32 → 32%16==0.
  //   Callee sees %16==8 — SysV entry state. Correct — no pad):
  //     rbx = dir_vn, r12 = name_ptr, r13 = name_len (post-strlen)
  // ============================================================================
  pub let _pdxfs_lite_unlink_adapter : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M6-004 (#934 adapter). Compute strlen(name_ptr) then dispatch to pdxfs_lite_unlink. Body: (1) 3-push callee-save prologue (rbx=dir_vn, r12=name_ptr, r13=name_len). Entry rsp%16==8 + 24 = 32 → 32%16==0. Callee's CALL push makes callee-entry rsp%16==8 per SysV — correct without pad. (2) Compute name_len. (3) Dispatch. Reserved labels: pdxl_vp_ua_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                              // dir_vn
        mov r12, rsi;                              // name_ptr

        mov rdi, r12;
        call _pdxl_vp_strlen;
        mov r13, rax;                              // name_len

        // pdxfs_lite_unlink(dir_vn, name_ptr, name_len).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call pdxfs_lite_unlink;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_stat_adapter(vn, stat_buf) -> u64  — R56.M3-002 (#1791)
  //
  //   Loads on-disk inode into _pdxfs_lite_inode_scratch via get_inode,
  //   then fills the caller-supplied 64-byte kernel-side stat struct at
  //   [rsi..rsi+64) using the frozen PDXFS_INODE_* offsets (mode u16 @+0,
  //   uid u16 @+2, gid u16 @+4, size u64 @+8, mtime u64 @+24, link_count
  //   u16 @+112).
  //
  //   Failure mode: if get_inode fails (EIO / ECKSUM / ERANGE), the caller
  //   receives VOPS_ERR_NOT_SUPPORTED (0xFFFFFFFFFFFFFFFF) and the stat
  //   struct is left in whatever state the partial fill reached — the
  //   caller (sys_stat_body) treats any non-zero return as -EIO / -ENOENT
  //   and refuses to copy the buffer back to the user.
  //
  //   Register plan (5-push callee-save + 8 pad; entry rsp%16==8 + 40 = 48,
  //   sub 8 -> 56, %16==0 pre-call; nested call sees %16==8):
  //     rbx = stat_buf        (survives across get_inode call)
  //     rbp = &sb             (loaded from mctx +8)
  //     r12 = inode_id        (from vnode +32 low 16 bits)
  //     r13 = nsid            (loaded from mctx +0)
  //     r14 = &_pdxfs_lite_inode_scratch  (loaded once, dead post-fill)
  //     r15 = unused (kept for prologue-uniformity with sibling adapters)
  // ============================================================================
  pub let _pdxfs_lite_stat_adapter : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (vn: u64) (stat_buf: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R56.M3-002 (#1791): pdxfs_lite stat adapter. Bridges vops (vn, stat_buf) surface to get_inode + field-copy into the caller's 64-byte kernel stat struct. Body: (1) 5-push callee-save prologue (rbx=stat_buf, rbp=&sb, r12=inode_id, r13=nsid, r14=&inode_scratch) + sub rsp,8 for SysV alignment (entry rsp%16==8 + 40 = 48 + 8 pad = 56, %16==0 pre-call; nested get_inode sees %16==8 at entry). (2) Extract inode_id from vnode.backend_ptr (+32, low 16 bits) matching the sibling read/write adapters. (3) Load nsid and &sb from _pdxfs_lite_mount_ctx (single-mount M4 globals). (4) Call get_inode(nsid, sb, inode_id, out=&scratch) — populates 128 B on-disk inode struct into _pdxfs_lite_inode_scratch. On non-zero return jmp to psla_eio (returns VOPS_ERR_NOT_SUPPORTED). (5) Field-copy from scratch to stat_buf using the frozen PDXFS_INODE_* offsets: mode u16 @+0 -> stat +24 low 32; uid u16 @+2 -> stat +32 low 32; gid u16 @+4 -> stat +32 high 32; size u64 @+8 -> stat +8; mtime u64 @+24 -> stat +16; link_count u16 @+112 -> stat +24 high 32. ino = inode_id (r12). blksize = 4096 -> stat +40 low 32; blocks = (size + 4095) >> 12 -> stat +40 high 32 (u32 cast safe: pdxfs_lite files at R25.M4 cap far below u32-worth of pages). Reserved tail (+48..+63) zeroed via 2x u64 stores. Return 0. Labels prefixed psla_ (pdxfs stat lite adapter). No test; mov_w for u16 zero-extended loads (matches fd_inherit.pdx / vfs_open.pdx idiom).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        // No sub rsp,8 pad: 5 pushes leave rsp%16==0 (entry %16==8
        // + (-40) = %16==0) which is exactly what SysV requires at
        // the nested get_inode call.  Sibling _pdxfs_lite_read_adapter
        // uses 6 pushes + sub rsp,8 for the same reason (6*8=48; 8+48
        // = 56 -> %16==8, +8 pad -> %16==0).

        mov rbx, rsi;                              // rbx = stat_buf (survives)

        // Extract inode_id from vnode.backend_ptr (+32, low 16 bits).
        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        // Load nsid and &sb from mount context.
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov r13, [rax + 0];                        // nsid
        mov rbp, [rax + 8];                        // &sb

        // Stage &_pdxfs_lite_inode_scratch into r14 (used by both call
        // and later field loads).
        lea r14, [rip + _pdxfs_lite_inode_scratch];

        // get_inode(nsid, sb, inode_id, out=&_pdxfs_lite_inode_scratch).
        mov rdi, r13;
        mov rsi, rbp;
        mov rdx, r12;
        mov rcx, r14;
        call get_inode;
        cmp rax, 0;
        jne psla_eio;

        // ---- Fill kernel-side 64-byte stat struct ----

        // +0 ino = inode_id (u64) — r12 already holds it zero-extended.
        mov [rbx + 0], r12;

        // +8 size = *(u64*)(scratch + 8)         PDXFS_INODE_SIZE_FIELD_OFFSET
        mov rax, [r14 + 8];
        mov [rbx + 8], rax;

        // +16 mtime = *(u64*)(scratch + 24)      PDXFS_INODE_MTIME_OFFSET
        mov rax, [r14 + 24];
        mov [rbx + 16], rax;

        // +24 mode u32 (low) + nlink u32 (high).
        //   mode  = u16 @scratch+0  (PDXFS_INODE_MODE_OFFSET)
        //   nlink = u16 @scratch+112 (PDXFS_INODE_LINK_COUNT_OFFSET)
        mov_w rax, [r14 + 0];                      // rax = mode u16 zx
        mov_w rcx, [r14 + 112];                    // rcx = nlink u16 zx
        shl rcx, 32;                               // nlink into high 32
        or  rax, rcx;                              // {mode | (nlink << 32)}
        mov [rbx + 24], rax;

        // +32 uid u32 (low) + gid u32 (high).
        //   uid = u16 @scratch+2   (PDXFS_INODE_UID_OFFSET)
        //   gid = u16 @scratch+4   (PDXFS_INODE_GID_OFFSET)
        mov_w rax, [r14 + 2];
        mov_w rcx, [r14 + 4];
        shl rcx, 32;
        or  rax, rcx;
        mov [rbx + 32], rax;

        // +40 blksize u32 (low = 4096) + blocks u32 (high = (size+4095)>>12).
        mov rcx, [r14 + 8];                        // rcx = size
        add rcx, 4095;
        shr rcx, 12;                               // rcx = blocks
        shl rcx, 32;                               // move blocks into high 32
        mov rax, 4096;                             // rax = blksize u32
        or  rax, rcx;                              // {blksize | (blocks << 32)}
        mov [rbx + 40], rax;

        // +48..+63 reserved = 0 (two u64 stores)
        xor rax, rax;
        mov [rbx + 48], rax;
        mov [rbx + 56], rax;

        // Return 0
        xor rax, rax;
        jmp psla_ret;

      psla_eio:
        mov rax, 0xFFFFFFFFFFFFFFFF;               // VOPS_ERR_NOT_SUPPORTED

      psla_ret:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // _pdxfs_lite_readdir_stub(vn, buf, nbytes, cursor) -> u64
  //
  //   R56.M3-003 (#1792) forward-compat stub. Emits ONLY the 12-byte
  //   terminator (name_len == 0) into buf and returns 12. Real translation
  //   from the on-disk 256-byte pdxfs_lite dirent (see readdir.pdx §On-disk
  //   directory entry) to the packed record stream sys_getdents expects is
  //   deferred to a follow-up round — pdxfs_lite roots are empty at mkfs
  //   time (readdir.pdx L21-24), so an EOD reply is functionally correct
  //   for every dir the current tree can produce.
  //
  //   Bounds discipline: if nbytes < 12, return 0 (no room even for the
  //   terminator; caller sees zero bytes and treats as EOD/EAGAIN per its
  //   own convention). Leaf function; no callee-save touched.
  // ============================================================================
  pub let _pdxfs_lite_readdir_stub : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vn: u64) (buf: u64) (nbytes: u64) (cursor: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R56.M3-003 (#1792). Terminator-only stub. Body: (1) cmp rdx, 12; jb short_ret (nbytes < 12 → return 0). (2) Zero 12 bytes at [rsi]: mov [rsi+0], rax=0 (ino); mov_w [rsi+8], rax (name_len); mov_b [rsi+10], rax (type); mov_b [rsi+11], rax (reserved). (3) mov rax, 12; ret. short_ret: xor eax, eax; ret. Leaf; rax/rcx/r8 caller-save.",
      block: {
        cmp rdx, 12;
        jb  pdxl_rda_short;
        xor rax, rax;
        mov [rsi + 0], rax;                        // ino = 0
        mov_w [rsi + 8], rax;                      // name_len = 0
        mov_b [rsi + 10], rax;                     // type = 0
        mov_b [rsi + 11], rax;                     // reserved = 0
        mov rax, 12;
        ret;

      pdxl_rda_short:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // pdxfs_lite_vops_init() -> u64
  //   Populate _pdxfs_lite_vops with the adapter/stub pointers. Called once
  //   from kernel_main / boot init (or at first mount) before any consumer of
  //   _pdxfs_lite_vops exists. Idempotent.
  //
  //   R56.M3-002 (#1791): grew to 8 slots (adds stat at +56).
  //   R56.M3-003 (#1792): grew to 9 slots (adds readdir stub at +64).
  // ============================================================================
  pub let pdxfs_lite_vops_init : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R25-M4-001 (#924). Populator for _pdxfs_lite_vops. Computes base via lea rip+_pdxfs_lite_vops, then stores each adapter/stub pointer at its frozen slot offset per src/kernel/core/fs/vops.pdx VOPS_*_OFFSET constants. Mirrors tmpfs_vops_init discipline (src/kernel/core/fs/tmpfs/vops.pdx L178). Leaf; no callee-save touched. 16 instructions (7 x lea+mov + lea base + xor + ret).",
      block: {
        lea r8, [rip + _pdxfs_lite_vops];

        lea rax, [rip + _pdxfs_lite_read_adapter];
        mov [r8 + 0], rax;                          // VOPS_READ_OFFSET

        lea rax, [rip + _pdxfs_lite_write_adapter];
        mov [r8 + 8], rax;                          // VOPS_WRITE_OFFSET

        lea rax, [rip + _pdxfs_lite_open_stub];
        mov [r8 + 16], rax;                         // VOPS_OPEN_OFFSET

        lea rax, [rip + _pdxfs_lite_close_stub];
        mov [r8 + 24], rax;                         // VOPS_CLOSE_OFFSET

        lea rax, [rip + _pdxfs_lite_lookup_adapter];
        mov [r8 + 32], rax;                         // VOPS_LOOKUP_OFFSET

        lea rax, [rip + _pdxfs_lite_create_adapter];
        mov [r8 + 40], rax;                         // VOPS_CREATE_OFFSET

        lea rax, [rip + _pdxfs_lite_unlink_adapter];
        mov [r8 + 48], rax;                         // VOPS_UNLINK_OFFSET

        // R56.M3-002 (#1791): stat slot at +56.
        lea rax, [rip + _pdxfs_lite_stat_adapter];
        mov [r8 + 56], rax;                         // VOPS_STAT_OFFSET

        // R56.M3-003 (#1792): readdir slot at +64 (terminator-only stub).
        lea rax, [rip + _pdxfs_lite_readdir_stub];
        mov [r8 + 64], rax;                         // VOPS_READDIR_OFFSET

        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // pdxfs_lite_vops_addr() -> u64  — returns &_pdxfs_lite_vops.
  // ============================================================================
  pub let pdxfs_lite_vops_addr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M4-001 (#924). Return &_pdxfs_lite_vops. Consumed by mount_op to stamp ops_ptr into the root vnode. Leaf.",
      block: {
        lea rax, [rip + _pdxfs_lite_vops];
        ret
      }
    }
}
