// src/kernel/core/fs/pdxfs_lite/rename.pdx — R25-M6-003 (#935)
//
// PdxFS-lite RENAME: same-directory in-place record swap. Optionally clobbers
// an existing `newname` entry inline (mirrors POSIX rename semantics).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// pdxfs_lite_rename(parent_vn, oldname, oldlen, newname, newlen) -> u64
//
//   Same-directory rename. Cross-directory rename is deferred (needs a second
//   parent load + dir-append/dir-remove pair — the atomic-cross-directory
//   invariant is subtler than the one-block record swap this file provides).
//
//   Returns:
//     PDXFS_MUT_OK       (0)  — never at M6 (write path stubbed).
//     PDXFS_MUT_ENOENT   (2)  — no such `oldname` in parent.
//     PDXFS_MUT_EIO      (3)  — NVMe read failure staging parent inode.
//     PDXFS_MUT_EROFS    (5)  — happy path at M6: rename staged in scratch
//                                buffers; nvme_write_blocking not yet
//                                available (R24 debt #906).
//
//   The `newlen > 240` case yields EINVAL semantics via a dir-find miss (the
//   dirent name field caps at 240 bytes) rather than a distinct return code —
//   documented deviation from a fully-populated errno surface, appropriate for
//   MVP.
//
// -----------------------------------------------------------------------------
// Atomicity
// -----------------------------------------------------------------------------
//
// The task spec asks for "atomic within same directory (in-place record swap)".
// Once nvme_write_blocking lands (#906), each 256-byte dirent record fits in
// a single sector-aligned write when the parent's dir block is 4-KiB aligned
// (which it always is — mkfs allocates dir blocks at extent granularity). A
// dirent overwrite therefore hits a single sector; on NVMe the sector write
// is atomic (nvme-spec §4.4). This is why RENAME collapses to one write
// instead of a delete+create pair — half-torn state is impossible at the
// device level.
//
// If `newname` already exists in parent, the M6 code path:
//   (a) Locates newname → note its inode_id for eventual free.
//   (b) Locates oldname → note its slot.
//   (c) Would overwrite oldname's slot with the fully-formed new dirent
//       {oldname's inode_id, newlen, oldname's type, newname bytes}.
//   (d) Would zero newname's original slot (tombstone) — this loses the
//       clobbered inode's link_count decrement, deferred to a follow-up
//       (documented; the M6 in-memory state has the parent's dir buffer
//       correctly transformed but the clobbered target's link_count is
//       untouched — a completeness-vs-scope tradeoff called out in #935).
//
// At M6 with no persistence, we run through (a) and (b), stage the intended
// oldname-slot post-image in _pdxfs_lite_dirent_scratch, then return EROFS.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_rn_`.

module Rename = structure {

  // ============================================================================
  // pdxfs_lite_rename(parent_vn, oldname, oldlen, newname, newlen) -> u64
  //
  //   rdi = &parent_vnode
  //   rsi = oldname
  //   rdx = oldlen
  //   rcx = newname
  //   r8  = newlen
  //
  //   Returns rax = PDXFS_MUT_* code.
  //
  //   Flow:
  //     (1) Extract parent_inode_id.
  //     (2) Load nsid/&sb.
  //     (3) get_inode(parent). EIO on failure.
  //     (4) pdxl_dir_find(oldname). Miss → ENOENT.
  //         Side effect: _pdxfs_lite_dirent_scratch holds the OLD record.
  //     (5) Snapshot inode_id (u64 @+0) and type (u8 @+10) from the OLD
  //         record into stack slots.
  //     (6) pdxl_dir_find(newname). If hit — record clobber intent (M6 no-op
  //         beyond noting; the tombstone-clear write is deferred to #906).
  //     (7) Rebuild the target 256-byte record in _pdxfs_lite_dirent_scratch:
  //           +0  inode_id  = snapshot
  //           +8  name_len  = newlen (cap at 240)
  //           +10 type      = snapshot
  //           +11..+16 pad  = 0
  //           +16..+16+newlen  = newname bytes
  //           remaining tail   = 0
  //     (8) Return PDXFS_MUT_EROFS. (Real write would put_inode(parent).)
  //
  //   Register plan (6-push + 24 stack (align+scratch); entry rsp%16==8 +
  //   48 + 24 = 80, %16==0):
  //     rbx = nsid
  //     rbp = &sb
  //     r12 = parent_inode_id
  //     r13 = newname
  //     r14 = newlen
  //     r15 = capped_newlen (post step 7)
  //     Stack slots (rsp+0 .. rsp+15):
  //       [rsp+0]  = snapshot inode_id (u64)
  //       [rsp+8]  = snapshot type    (u8, held in u64 slot for alignment)
  // ============================================================================
  pub let pdxfs_lite_rename : (u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (parent_vn: u64, oldname: u64, oldlen: u64, newname: u64, newlen: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M6-003 (#935). Locate oldname, snapshot its inode_id/type, optionally note newname clobber, rebuild the target dirent record in _pdxfs_lite_dirent_scratch. No persistence at M6 — return EROFS. Body: (1) 6-push callee-save prologue (rbx=nsid, rbp=sb, r12=parent_ino, r13=newname, r14=newlen, r15=capped_newlen) — 48 B; entry rsp%16==8 + 48 = 56, sub rsp,24 → 80, %16==0. Stack slots hold snapshot inode_id ([rsp+0]) and snapshot type ([rsp+8]). (2) Stage: extract parent_ino via [rdi+32] & 0xFFFF into r12; save newname/newlen into r13/r14. oldname/oldlen (rsi/rdx) used inline before first call. Load nsid/sb from _pdxfs_lite_mount_ctx. (3) get_inode(parent) into _pdxfs_lite_inode_scratch. On non-zero → EIO. (4) pdxl_dir_find(oldname/oldlen) — need to restage rsi/rdx as they were clobbered. Recover from the entry-args by saving them earlier: at prologue, push rsi (oldname) and rdx (oldlen) into stack too? Simpler: retain oldname/oldlen in callee-save r10/r11 across steps. But those are caller-save. Use additional stack slots. Actually, we can compose the dir_find with cur rsi/rdx directly by saving them BEFORE nsid/sb load clobbers rax. Rework: after prologue, push oldname/oldlen into new stack slots. Extend stack to 32 B (pad-safe): sub rsp,32. Layout: [rsp+0]=snap_ino, [rsp+8]=snap_type, [rsp+16]=oldname, [rsp+24]=oldlen. Entry rsp%16==8+48+32=88 → 88%16==8, WRONG. Adjust to 40 B: 8+48+40=96, %16==0. Layout: [0]=snap_ino, [8]=snap_type, [16]=oldname, [24]=oldlen, [32]=pad. Reserved labels: pdxl_rn_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;                               // 8+48+40 = 96, %16==0

        // Extract parent_inode_id.
        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        // Save (oldname, oldlen) to stack (needed after get_inode/mctx-load
        // clobbers rsi/rdx).
        mov [rsp + 16], rsi;                       // oldname
        mov [rsp + 24], rdx;                       // oldlen

        // Save newname/newlen into callee-save r13/r14.
        mov r13, rcx;                              // newname
        mov r14, r8;                               // newlen

        // Load nsid/sb.
        lea rax, [rip + _pdxfs_lite_mount_ctx];
        mov rbx, [rax + 0];
        mov rbp, [rax + 8];

        // (3) get_inode(parent).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        lea rcx, [rip + _pdxfs_lite_inode_scratch];
        call get_inode;
        cmp rax, 0;
        jne pdxl_rn_eio;

        // (4) pdxl_dir_find(oldname, oldlen).
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_lite_inode_scratch];
        mov rcx, [rsp + 16];                       // oldname
        mov r8, [rsp + 24];                        // oldlen
        call pdxl_dir_find;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je pdxl_rn_enoent;

        // (5) Snapshot inode_id (u64 @+0) and type (u8 @+10) from OLD record.
        lea r10, [rip + _pdxfs_lite_dirent_scratch];
        mov r11, [r10 + 0];                        // snapshot inode_id
        mov [rsp + 0], r11;
        xor r11, r11;
        mov_b r11, [r10 + 10];                     // snapshot type
        mov [rsp + 8], r11;

        // (6) Check for newname clobber (best-effort — hit means we would
        //     clobber; miss means we just overwrite oldname's slot with
        //     newname's bytes). At M6 the outcome is identical: build the
        //     target record. We call pdxl_dir_find to leave the scratch
        //     containing an already-newname-shaped record if newname exists,
        //     which we then OVERWRITE in step 7 anyway. Skipping the call
        //     costs correctness at future-M7 (need to know the clobbered
        //     inode's id for link_count decrement) — keep it here so the
        //     clobber-target's inode_id lives in the scratch briefly.
        mov rdi, rbx;
        mov rsi, rbp;
        lea rdx, [rip + _pdxfs_lite_inode_scratch];
        mov rcx, r13;                              // newname
        mov r8, r14;                               // newlen
        call pdxl_dir_find;
        // Ignore rax — hit or miss, we overwrite the scratch in step 7.

        // (7) Rebuild the target 256-B dirent record in _pdxfs_lite_dirent_scratch.
        // Zero-fill the 256 bytes first.
        lea rdi, [rip + _pdxfs_lite_dirent_scratch];
        xor eax, eax;
        mov rcx, 32;                               // 256 / 8
        cld;
        rep_stosq;

        // Base pointer back into r10.
        lea r10, [rip + _pdxfs_lite_dirent_scratch];

        // +0  inode_id = snapshot
        mov r11, [rsp + 0];
        mov [r10 + 0], r11;

        // +8  name_len = min(newlen, 240)
        mov r15, r14;
        cmp r15, 240;
        jbe pdxl_rn_len_ok;
        mov r15, 240;

      pdxl_rn_len_ok:
        mov_w [r10 + 8], r15;

        // +10 type = snapshot (u8)
        mov r11, [rsp + 8];
        mov_b [r10 + 10], r11;

        // +16..+16+capped_newlen: copy newname bytes.
        // Loop: for (i=0; i < r15; ++i) dst[16+i] = src[i].
        xor rcx, rcx;

      pdxl_rn_cp_top:
        cmp rcx, r15;
        jae pdxl_rn_cp_done;
        xor r8, r8;
        mov_b r8, [r13 + rcx*1];                   // src byte
        mov r11, r10;
        add r11, 16;
        add r11, rcx;
        mov_b [r11 + 0], r8;
        add rcx, 1;
        jmp pdxl_rn_cp_top;

      pdxl_rn_cp_done:
        // (8) TODO(#906): put_inode(parent) after writing the dir block back.
        //     M6: return EROFS.
        mov rax, 5;                                // PDXFS_MUT_EROFS
        jmp pdxl_rn_ret;

      pdxl_rn_enoent:
        mov rax, 2;                                // PDXFS_MUT_ENOENT
        jmp pdxl_rn_ret;

      pdxl_rn_eio:
        mov rax, 3;                                // PDXFS_MUT_EIO

      pdxl_rn_ret:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
