// src/kernel/core/fs/pdxfs_lite/superblock.pdx — R25-M1-002 (#912)
//
// PdxFS-lite v0 superblock struct + validation.
//
// -----------------------------------------------------------------------------
// #912 "paideia-as-blocked" verdict — PAPER TIGER (this landing rebuts it)
// -----------------------------------------------------------------------------
//
// The #912 issue body claimed "packed struct read/write phase 2 (v0.22)"
// was needed. It is not. Every existing sized on-disk struct in the
// kernel (tmpfs inode at 256 B in src/kernel/core/fs/tmpfs/inode.pdx,
// NVMe SQE at 64 B built inline in src/kernel/core/drivers/nvme/sync.pdx
// L210-L245) already uses the [u64; N] + typed offset accessors idiom
// against the current paideia-as encoder (v0.22.x). The four proven
// primitives are:
//
//   (1) `pub let mut _name : [u64; N] = uninit @align(K)` — .bss storage.
//   (2) `lea rax, [rip + _name]` + `add rax, off` — field pointer arith.
//   (3) `mov_d [rax + off], reg` / `mov_w` / `mov_b` — sized stores.
//   (4) `mov_d reg, [rax + off]` / `mov_w` / `mov_b` — sized loads.
//
// Verified by tmpfs/inode.pdx (256-B inode with u8/u16/u64 fields) and
// nvme/sync.pdx (64-B SQE with u8/u16/u32/u64 fields). Neither file
// requires a paideia-as "packed struct" primitive. The 4-KiB superblock
// laid out here is structurally identical, only larger.
//
// The encoder gap the original #912 body referenced probably meant
// generated bitfield helpers (v0.22.x has partial support). We don't
// use bitfields here — every superblock field is naturally aligned to
// its width. Bitfield helpers become relevant at R25.M2 for the inode
// `mode` field (top nibble = type, bottom 12 = perms), and even there
// a `shr / and` pair suffices.
//
// -----------------------------------------------------------------------------
// Byte layout — mirrors design/filesystem/pdxfs-lite-format.md §1.1
// -----------------------------------------------------------------------------
//
//   Offset  Size  Field
//   ------  ----  --------------------------------------------
//   0       4     magic       u32 = 0x4C584450 ("PDXL" LE)
//   4       4     version     u32 = 1
//   8       16    uuid        u8[16]
//   24      4     block_size  u32 = 4096
//   28      4     _pad0
//   32      8     itable_lba
//   40      8     itable_bcount
//   48      8     extent_area_lba
//   56      8     extent_area_bcount
//   64      8     root_ino
//   72      624   _reserved
//   696     3400  sig         u8[3400] — ML-DSA-65 (§5.4 of design doc)
//   ------------
//   4096 = one 4 KiB block
//
// Backing storage:  [u64; 512] = 4096 bytes exactly.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_sb_` throughout (avoids `if`, `loop`, `end`, ...
// per feedback_paideia_as_version_discipline.md).

module Superblock = structure {

  // ============================================================================
  // Layout constants — frozen at R25.M1. Any change requires a version bump
  // (see design/filesystem/pdxfs-lite-format.md §1.2 — no in-place upgrade).
  // ============================================================================

  pub let PDXFS_SB_SIZE                : u64 = 4096
  pub let PDXFS_SB_QWORDS              : u64 = 512

  // Magic = ASCII "PDXL" little-endian. Byte order:
  //   byte 0 = 'P' = 0x50
  //   byte 1 = 'D' = 0x44
  //   byte 2 = 'X' = 0x58
  //   byte 3 = 'L' = 0x4C
  // As a u32 LE: 0x4C584450.
  pub let PDXFS_SB_MAGIC               : u64 = 0x4C584450
  pub let PDXFS_SB_VERSION             : u64 = 1
  pub let PDXFS_SB_BLOCK_SIZE          : u64 = 4096

  // Field offsets — frozen; downstream (mount.pdx, uuid.pdx) reads/writes
  // via these constants only.
  pub let PDXFS_SB_MAGIC_OFFSET        : u64 = 0     // u32
  pub let PDXFS_SB_VERSION_OFFSET      : u64 = 4     // u32
  pub let PDXFS_SB_UUID_OFFSET         : u64 = 8     // u8[16]
  pub let PDXFS_SB_BLOCK_SIZE_OFFSET   : u64 = 24    // u32
  pub let PDXFS_SB_PAD0_OFFSET         : u64 = 28    // u32
  pub let PDXFS_SB_ITABLE_LBA_OFFSET   : u64 = 32    // u64
  pub let PDXFS_SB_ITABLE_BCOUNT_OFFSET: u64 = 40    // u64
  pub let PDXFS_SB_EA_LBA_OFFSET       : u64 = 48    // u64
  pub let PDXFS_SB_EA_BCOUNT_OFFSET    : u64 = 56    // u64
  pub let PDXFS_SB_ROOT_INO_OFFSET     : u64 = 64    // u64
  pub let PDXFS_SB_RESERVED_OFFSET     : u64 = 72    // u8[624]
  pub let PDXFS_SB_SIG_OFFSET          : u64 = 696   // u8[3400]
  pub let PDXFS_SB_SIG_LEN             : u64 = 3400
  pub let PDXFS_SB_SIGNED_LEN          : u64 = 696   // [0, 696) covered by sig

  // Return-code sentinels (u16 semantics; u64 in ABI).
  pub let PDXFS_SB_OK                  : u64 = 0
  pub let PDXFS_SB_EFTYPE              : u64 = 1     // bad magic / version / block_size
  pub let PDXFS_SB_EINVAL              : u64 = 2     // bad itable_lba / root_ino
  pub let PDXFS_SB_EIO                 : u64 = 3     // block read failure

  // ============================================================================
  // Shared kernel-owned superblock scratch (dev/mount fingerprint).
  //
  // At R25.M1 there is exactly one PdxFS-lite mount possible per kernel
  // (single-device NVMe substrate + no VFS backend registry entry yet).
  // pdxfs_lite_read_superblock stages the block here; sb_validate + the
  // uuid.pdx helpers inspect this pointer via `lea rax, [rip + _pdxfs_sb]`.
  //
  // R25.M2 (mount + VFS wire-up) grows this to a per-mount slab. Until
  // then, the shared scratch is the mount-point address.
  //
  // 512 * 8 = 4096 bytes = one 4 KiB block. @align(4096) so downstream
  // NVMe PRP-encoded reads land at a page-aligned physical address (PRP1
  // requires 4 KiB alignment for a single-page transfer, see nvme/prp.pdx).
  // ============================================================================
  pub let mut _pdxfs_sb : [u64; 512] = uninit @align(4096)

  // ============================================================================
  // sb_validate(sb: *pdxfs_sb) -> u64
  //   rdi = &superblock (4 KiB block already loaded into memory)
  //   returns PDXFS_SB_OK on all-checks-pass;
  //           PDXFS_SB_EFTYPE if magic/version/block_size wrong;
  //           PDXFS_SB_EINVAL if itable_lba == 0 OR root_ino == 0.
  //
  // Field reads use mov_d (u32) / mov (u64); leaf function (no callee-save,
  // no nested call). Return path is a fall-through into `ret`.
  // ============================================================================
  pub let sb_validate : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M1-002 (#912). Validate that a loaded 4 KiB superblock is a well-formed PdxFS-lite v0 header. Body: (1) mov_d rax, [rdi + 0] (magic u32); cmp rax, 0x4C584450; jne EFTYPE. (2) mov_d rax, [rdi + 4] (version u32); cmp rax, 1; jne EFTYPE. (3) mov_d rax, [rdi + 24] (block_size u32); cmp rax, 4096; jne EFTYPE. (4) mov rax, [rdi + 32] (itable_lba u64); cmp rax, 0; je EINVAL. (5) mov rax, [rdi + 64] (root_ino u64); cmp rax, 0; je EINVAL. (6) Return PDXFS_SB_OK (=0) via xor eax,eax. Encoder posture: mov_d (u32 load) proven by nvme/sync.pdx L228 (mov_d [r10+4], rbx pattern uses same encoding class). mov r64, [reg+imm8] proven throughout. cmp r64, imm32 proven. je/jne proven. xor eax, eax proven. All rax uses caller-saved SysV. Leaf: no prologue, no callee-save touched. Reserved labels: pdxl_sb_.",
      block: {
        // (1) magic
        mov_d rax, [rdi + 0];
        cmp rax, 0x4C584450;
        jne pdxl_sb_v_eftype;

        // (2) version
        mov_d rax, [rdi + 4];
        cmp rax, 1;
        jne pdxl_sb_v_eftype;

        // (3) block_size
        mov_d rax, [rdi + 24];
        cmp rax, 4096;
        jne pdxl_sb_v_eftype;

        // (4) itable_lba != 0
        mov rax, [rdi + 32];
        cmp rax, 0;
        je pdxl_sb_v_einval;

        // (5) root_ino != 0
        mov rax, [rdi + 64];
        cmp rax, 0;
        je pdxl_sb_v_einval;

        // (6) OK
        xor eax, eax;
        ret;

      pdxl_sb_v_eftype:
        mov rax, 1;                                 // PDXFS_SB_EFTYPE
        ret;

      pdxl_sb_v_einval:
        mov rax, 2;                                 // PDXFS_SB_EINVAL
        ret
      }
    }

  // ============================================================================
  // sb_scratch_addr() -> u64  — kernel-scope helper
  //   returns &_pdxfs_sb (base of the 4 KiB shared superblock scratch).
  //
  // Downstream modules (mount.pdx, uuid.pdx) use this to reach the shared
  // buffer without duplicating the `lea rax, [rip + _pdxfs_sb]` fixup.
  // Leaf, no callee-save, no memory effect (pure address computation, but
  // marked `mem` conservatively since callers dereference the result).
  // ============================================================================
  pub let sb_scratch_addr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M1-002 (#912). Return &_pdxfs_sb. Single-instruction body plus ret. lea from rip-relative label is the standard address-taking idiom used throughout this kernel (tmpfs/inode.pdx L56, nvme/sync.pdx L194). Leaf function.",
      block: {
        lea rax, [rip + _pdxfs_sb];
        ret
      }
    }

  // ============================================================================
  // sb_serialize_defaults(sb: *pdxfs_sb, itable_lba, itable_bcount,
  //                       extent_area_lba, extent_area_bcount) -> u64
  //   rdi = &sb (4 KiB buffer, caller-zeroed)
  //   rsi = itable_lba
  //   rdx = itable_bcount
  //   rcx = extent_area_lba
  //   r8  = extent_area_bcount
  //
  //   Writes the fixed-value fields (magic, version, block_size, root_ino=1)
  //   and the caller-provided layout LBAs. UUID and sig are left as caller-
  //   zeroed and must be filled by a separate sb_generate_uuid + sign step.
  //
  //   Used by a host-side mkfs tool (compiled with the same paideia-as
  //   toolchain — Pillar 10) to author a valid v0 image. At R25.M1 this
  //   helper is also the reference for the R25.M2 in-kernel format path.
  //
  //   Returns 0.
  // ============================================================================
  pub let sb_serialize_defaults : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (sb: u64, itable_lba: u64, itable_bcount: u64,
        extent_area_lba: u64, extent_area_bcount: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M1-002 (#912). Stamp the fixed-value fields + caller-provided layout LBAs into a caller-zeroed 4 KiB buffer. Body: (1) magic (u32 @+0) = 0x4C584450 via mov rax + mov_d [rdi+0], rax. (2) version (u32 @+4) = 1. (3) block_size (u32 @+24) = 4096. (4) itable_lba (u64 @+32) = rsi. (5) itable_bcount (u64 @+40) = rdx. (6) extent_area_lba (u64 @+48) = rcx. (7) extent_area_bcount (u64 @+56) = r8. (8) root_ino (u64 @+64) = 1. UUID + sig NOT written — caller responsibility. Returns 0 via xor eax,eax. Leaf. Encoder: mov_d + mov proven. Reserved labels: none needed (straight-line).",
      block: {
        // (1) magic
        mov rax, 0x4C584450;
        mov_d [rdi + 0], rax;

        // (2) version
        mov rax, 1;
        mov_d [rdi + 4], rax;

        // (3) block_size
        mov rax, 4096;
        mov_d [rdi + 24], rax;

        // (4) itable_lba
        mov [rdi + 32], rsi;

        // (5) itable_bcount
        mov [rdi + 40], rdx;

        // (6) extent_area_lba
        mov [rdi + 48], rcx;

        // (7) extent_area_bcount
        mov [rdi + 56], r8;

        // (8) root_ino = 1
        mov rax, 1;
        mov [rdi + 64], rax;

        // return 0
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_load_field_u64(sb: *pdxfs_sb, off: u64) -> u64
  //   rdi = &sb
  //   rsi = byte offset (caller must ensure 8-byte aligned + in-range)
  //
  //   Generic u64 field accessor. Used by mount.pdx + logging without
  //   duplicating the address-arith. Leaf.
  // ============================================================================
  pub let sb_load_field_u64 : (u64, u64) -> u64 !{mem} @{} =
    fn (sb: u64, off: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M1-002 (#912). Generic u64 field accessor. Body: mov rax, [rdi + rsi] via lea (avoid encoder friction on [reg+reg] SIB where rsi acts as base+index — safer to add). Leaf.",
      block: {
        add rdi, rsi;
        mov rax, [rdi + 0];
        ret
      }
    }
}
