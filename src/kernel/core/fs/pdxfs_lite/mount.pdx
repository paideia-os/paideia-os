// src/kernel/core/fs/pdxfs_lite/mount.pdx — R25-M1-003 (#913)
//
// Superblock read + validate wire — bridges NVMe substrate (R24) to the
// PdxFS-lite superblock struct (#912).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// pdxfs_lite_read_superblock(bar0, nsid, out_sb) -> u64
//
//   Reads LBA 0 (one 4 KiB block) from the given NVMe namespace,
//   stages it into *out_sb, then invokes sb_validate. Returns a u16-in-u64
//   status code:
//
//     PDXFS_SB_OK      (0) — mount can proceed.
//     PDXFS_SB_EFTYPE  (1) — magic / version / block_size wrong.
//     PDXFS_SB_EINVAL  (2) — itable_lba OR root_ino zero.
//     PDXFS_SB_EIO     (3) — NVMe read failed (any non-zero CQE status).
//
// The caller MUST have already:
//   (1) enumerated the NVMe device via nvme_probe (R24.M1),
//   (2) initialised its admin+IO queues (R24.M2/M3), and
//   (3) identified the target namespace and passed its NSID as `nsid`.
//
// At R25.M1 the KIND_BLKDEV cap plumbing from R24.M5 is not yet wired
// through to the VFS layer (blocked on #1015 userspace-server substrate).
// Threading (bar0, nsid) as explicit args keeps this function testable
// standalone from a kernel wire-up point without dragging the whole cap
// system in. When #1015 unblocks, this function grows a sibling that
// resolves (bar0, nsid) from a KIND_BLKDEV cap handle and calls the
// inner path here.
//
// -----------------------------------------------------------------------------
// Physical buffer discipline
// -----------------------------------------------------------------------------
//
// nvme_read_blocking expects buf_pa = physical address. At R25.M1 the
// kernel identity-maps its own .bss (see src/kernel/core/mm/aspace_map.pdx
// and design/kernel/vfs-layout.md §5). Therefore the virtual address of
// _pdxfs_sb (or the caller-supplied out_sb, if page-aligned) IS its
// physical address, and no aspace_translate call is required.
//
// The `_pdxfs_sb` shared scratch is @align(4096) precisely so this
// identity is safe. If the caller passes a differently-aligned out_sb,
// the read still succeeds under identity-map, but the PRP1 alignment
// requirement (0 mod 4096) forces us to stage through _pdxfs_sb first
// and then memcpy out. This function always stages through _pdxfs_sb.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_mt_`.

module Mount = structure {

  // ============================================================================
  // pdxfs_lite_read_superblock(bar0: u64, nsid: u64, out_sb: u64) -> u64
  //
  //   rdi = bar0 (opaque at R25.M1 — threaded for API stability; unused
  //         inside because nvme_read_blocking resolves the target
  //         controller from its own globals set at driver-attach time)
  //   rsi = nsid (u32 semantics)
  //   rdx = out_sb (destination; must be 8-byte writable for the memcpy)
  //
  //   Returns rax = status (PDXFS_SB_OK / PDXFS_SB_EFTYPE / PDXFS_SB_EINVAL /
  //   PDXFS_SB_EIO).
  //
  // Register plan (4-push callee-save + 8 pad = 40 B; entry rsp%16==8 →
  // rsp%16==0 pre-call to nvme_read_blocking / sb_validate):
  //   rbx = bar0 (advisory — kept live for future cap-resolve hook)
  //   r12 = nsid
  //   r13 = out_sb
  //   r14 = &_pdxfs_sb (scratch base)
  //
  //   Flow:
  //     (1) Stage: rbx/r12/r13 stash args, r14 = sb_scratch_addr().
  //     (2) nvme_read_blocking(nsid, 0, 8, r14) — read LBA 0, 8 blocks
  //         (8 × 512 B = 4 KiB) or 1 block (1 × 4 KiB = 4 KiB) depending
  //         on device LBA format. At R25.M1 we assume 512 B LBAs (matches
  //         the R24 fixture); the count=8 is safe on 4 KiB-LBA devices
  //         too (reads 8 × 4 KiB = 32 KiB into a 4 KiB buffer — WRONG,
  //         will overrun). Left as a documented open at R25.M4 when
  //         nvme_identify_ns parses LBAF and we pick the count at
  //         runtime. See §Open items below.
  //     (3) If nvme_read_blocking returned non-zero → return EIO.
  //     (4) memcpy 4 KiB from _pdxfs_sb into out_sb via rep_movsq
  //         (512 qwords).
  //     (5) sb_validate(out_sb) — returns 0 / 1 / 2 verbatim.
  //     (6) Return rax = validate status.
  // ============================================================================
  //
  // Open items (deferred to R25.M4):
  //   O1. Runtime LBA-format lookup. Today count=8 assumes 512 B LBAs.
  //       Fix requires nvme_identify_ns caching (R24.M2 already parses
  //       it — expose via a `nvme_ns_lba_shift(nsid)` accessor).
  //   O2. bar0 is threaded but unused. Route to a hypothetical
  //       nvme_read_blocking_on(bar0, nsid, ...) when multi-controller
  //       support lands (R28+).
  //   O3. out_sb == _pdxfs_sb short-circuit (skip the memcpy). Not
  //       relevant at R25.M1 (mount.pdx callers always stage through
  //       the scratch anyway).

  pub let pdxfs_lite_read_superblock : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (bar0: u64, nsid: u64, out_sb: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M1-003 (#913). Read LBA 0 (4 KiB) from NVMe into shared _pdxfs_sb scratch, memcpy into caller's out_sb, invoke sb_validate. Body: (1) 4-push callee-save prologue (rbx=bar0, r12=nsid, r13=out_sb, r14=scratch base) + sub rsp,8 alignment pad — entry rsp%16==8 + 32 B pushes → 40 → sub 8 → 48 → %16==0 (aligned for nested nvme_read_blocking call which itself pushes 6 more). (2) Load _pdxfs_sb address via `lea r14, [rip + _pdxfs_sb]` (identical idiom to nvme/sync.pdx L194 for _nvme_requests). (3) Marshal nvme_read_blocking args: rdi=nsid (r12), rsi=lba=0, rdx=count=8, rcx=buf_pa=r14 (identity-map assumption per design/kernel/vfs-layout.md §5 — .bss high-VA equals physical under R14-M2-onwards aspace map). (4) call nvme_read_blocking. Return code test: cmp rax,0; jne EIO. (5) memcpy 4 KiB from r14 into r13 via rep_movsq (rsi=src=r14, rdi=dst=r13, rcx=512, cld, rep movsq). Same rep_movsq pattern as elsewhere in kernel (e.g., load_prog). (6) call sb_validate with rdi=r13. Returned rax forwarded verbatim through the epilogue. (7) 4-pop epilogue + add rsp,8. Encoder posture: mov, push, pop, sub, add, lea, call, cmp, jne, cld, rep_movsq, ret — all pre-existing. Reserved labels: pdxl_mt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                               // bar0 (retained; unused at R25.M1)
        mov r12, rsi;                               // nsid
        mov r13, rdx;                               // out_sb

        // (2) r14 = &_pdxfs_sb (page-aligned scratch under identity map).
        lea r14, [rip + _pdxfs_sb];

        // (3) nvme_read_blocking(nsid=r12, lba=0, count=8, buf_pa=r14)
        mov rdi, r12;
        mov rsi, 0;
        mov rdx, 8;
        mov rcx, r14;
        call nvme_read_blocking;

        // (4) Non-zero CQE status → EIO.
        cmp rax, 0;
        jne pdxl_mt_eio;

        // (5) memcpy 4 KiB from _pdxfs_sb (rsi) into out_sb (rdi).
        mov rsi, r14;                               // src = scratch
        mov rdi, r13;                               // dst = out_sb
        mov rcx, 512;                               // 4096/8 qwords
        cld;
        rep_movsq;

        // (6) sb_validate(out_sb). Forwards status verbatim.
        mov rdi, r13;
        call sb_validate;
        jmp pdxl_mt_ret;

      pdxl_mt_eio:
        mov rax, 3;                                 // PDXFS_SB_EIO

      pdxl_mt_ret:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pdxfs_lite_read_and_stage_superblock(bar0: u64, nsid: u64) -> u64
  //   Convenience: reads LBA 0 into the shared _pdxfs_sb scratch AND leaves
  //   it there. Returns validation status (no memcpy step). Used by callers
  //   that will consult the scratch directly (mount fingerprint, uuid probe).
  //
  //   Register plan mirrors pdxfs_lite_read_superblock but drops r13/out_sb.
  // ============================================================================
  pub let pdxfs_lite_read_and_stage_superblock : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (bar0: u64, nsid: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M1-003 (#913). Read LBA 0 (4 KiB) from NVMe into shared _pdxfs_sb scratch, invoke sb_validate on the scratch, return status. No memcpy step (caller consults the scratch via sb_scratch_addr). Body: (1) 3-push callee-save prologue (rbx=bar0, r12=nsid, r14=&_pdxfs_sb) + sub rsp,8 pad. Entry rsp%16==8 + 24 B pushes → 32 → sub 8 → 40 → %16==8. Wait — pre-call to nvme_read_blocking needs rsp%16==0. Fix: 3 pushes + sub rsp,8 gives rsp%16==0 at call site (8 + 24 + 8 = 40, 40 mod 16 = 8, NOT 0). Need one more push or additional pad. Use sub rsp,16 instead. Rechecked: entry 8 + 24 pushes = 32, 32 mod 16 = 0. sub rsp,8 → 40, 40 mod 16 = 8. That's wrong for a call site (call pushes 8, callee starts at %16==0 which is the OPPOSITE of SysV entry %16==8). Correct: at call site rsp must be %16==0 so callee starts %16==8 after its own push of ret addr. Entry %16==8 + 24 pushes = 32 mod 16 = 0. Good, no extra pad needed. Drop the sub rsp,8. (2) call nvme_read_blocking with (nsid=r12, lba=0, count=8, buf_pa=r14). (3) cmp rax,0; jne EIO. (4) call sb_validate(r14). Status in rax forwarded. Reserved labels: pdxl_mt_s_.",
      block: {
        push rbx;
        push r12;
        push r14;

        mov rbx, rdi;                               // bar0
        mov r12, rsi;                               // nsid
        lea r14, [rip + _pdxfs_sb];                 // scratch base (page-aligned)

        // Read LBA 0 → scratch.
        mov rdi, r12;
        mov rsi, 0;
        mov rdx, 8;
        mov rcx, r14;
        call nvme_read_blocking;

        cmp rax, 0;
        jne pdxl_mt_s_eio;

        // Validate in-place.
        mov rdi, r14;
        call sb_validate;
        jmp pdxl_mt_s_ret;

      pdxl_mt_s_eio:
        mov rax, 3;                                 // PDXFS_SB_EIO

      pdxl_mt_s_ret:
        pop r14;
        pop r12;
        pop rbx;
        ret
      }
    }
}
