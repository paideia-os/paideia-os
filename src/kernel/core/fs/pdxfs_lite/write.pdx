// src/kernel/core/fs/pdxfs_lite/write.pdx — R25-M2-005 (#919)
//
// PdxFS-lite v0 extent-based file write: extend inode.size, allocate new
// blocks, update extent map, persist inode.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// pdxfs_write(nsid, sb, inode, offset, len, in_pa) -> u64
//   Grows the file to at least offset+len bytes (allocating a new extent
//   run if needed), stamps the new inode.size and inode.mtime, and returns
//   through put_inode. Data-block payload transfers (the actual bytes in
//   in_pa → device) are STUBBED at R25.M2 — see §Data write gap below.
//
// -----------------------------------------------------------------------------
// bar0 signature note
// -----------------------------------------------------------------------------
//
// Dropped from the M2 signature — same rationale as pdxfs_read and
// get_inode/put_inode. See mount.pdx L98 and inode.pdx header comments.
//
// -----------------------------------------------------------------------------
// Data write gap
// -----------------------------------------------------------------------------
//
// The task-body specification calls for "For each 4KB chunk: translate +
// write via a stubbed nvme_write_blocking". Because nvme_write_blocking
// does not yet exist (R24.M5 landed the read half only), the M2 body:
//
//   (1) Computes the geometry (which logical blocks the write touches,
//       whether any new blocks need to be allocated).
//   (2) Calls extent_alloc when the write extends the file past its current
//       last block. Records the returned extent in the first free
//       inode.extent[] slot.
//   (3) Stamps inode.size = max(old_size, offset+len).
//   (4) Stamps inode.mtime with a monotonic-lookalike (rdtsc sample).
//   (5) Calls put_inode — which itself stubs the inode-table write-back
//       and returns PDXFS_INODE_ETODO_WRITE (=4).
//   (6) Returns PDXFS_WRITE_ETODO_WRITE (=4) to the caller.
//
// The actual `in_pa → device` byte transfer is NOT emitted; it lands at
// R25.M3 once nvme_write_blocking exists. `in_pa` is threaded but unused
// at M2 — deviating callers would have to arrange the payload themselves
// via a lower-level path (none exists yet).
//
// -----------------------------------------------------------------------------
// Extent-slot allocation policy
// -----------------------------------------------------------------------------
//
// Dense-fill: scan inode.extent[0..8] for the first slot with start_lba == 0
// and write the new run there. If all 8 slots are occupied, we return
// PDXFS_WRITE_ENOSPC — the indirect-extent overflow path lands at R25.M3
// (same milestone as the write path's second half).
//
// This means a file that already has 8 non-contiguous extents but total
// less than 2 MiB written cannot grow further under M2. Acceptable for the
// MVP shell (small text files rarely fragment).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_wr_`.

module Write = structure {

  // ============================================================================
  // Constants
  // ============================================================================

  pub let PDXFS_WRITE_OK                 : u64 = 0
  pub let PDXFS_WRITE_ENOSPC             : u64 = 1          // out-of-space (bitmap) OR extent-slots full
  pub let PDXFS_WRITE_EIO                : u64 = 2          // NVMe I/O failure (future: on data-write path)
  pub let PDXFS_WRITE_ETODO_WRITE        : u64 = 4          // data-write / inode-persist stubbed at M2

  pub let PDXFS_WRITE_BLOCK_SIZE         : u64 = 4096
  pub let PDXFS_WRITE_BLOCK_SHIFT        : u64 = 12

  // ============================================================================
  // Helper: inode_current_blocks(inode) -> u64
  //   rdi = &inode
  //
  //   Sum extent[i].len_lba across all populated slots (start_lba != 0).
  //   Dense-fill discipline: first slot with start_lba == 0 terminates.
  //
  //   Leaf.
  // ============================================================================
  pub let inode_current_blocks : (u64) -> u64 !{mem} @{} =
    fn (inode: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M2-005 (#919 helper). Sum extent[i].len_lba for i in 0..8 while extent[i].start_lba != 0. Body: (1) xor rax,rax (running total). (2) xor rcx,rcx (i). (3) mov r10, rdi; add r10, 40 (&extent[0]). (4) Loop pdxl_wr_ib_top: cmp rcx, 8; jae pdxl_wr_ib_done. (5) Load start (u32 @+0): xor r8,r8; mov_d r8, [r10]. cmp r8,0; je pdxl_wr_ib_done. (6) Load len (u32 @+4): xor r9,r9; mov_d r9, [r10+4]. add rax, r9. (7) add r10, 8; add rcx, 1; jmp top. Leaf. Reserved labels: pdxl_wr_ib_.",
      block: {
        xor rax, rax;                              // total
        xor rcx, rcx;                              // i
        mov r10, rdi;
        add r10, 40;                               // &extent[0]

      pdxl_wr_ib_top:
        cmp rcx, 8;
        jae pdxl_wr_ib_done;

        xor r8, r8;
        mov_d r8, [r10];                           // start_lba
        cmp r8, 0;
        je pdxl_wr_ib_done;

        xor r9, r9;
        mov_d r9, [r10 + 4];                       // len_lba
        add rax, r9;

        add r10, 8;
        add rcx, 1;
        jmp pdxl_wr_ib_top;

      pdxl_wr_ib_done:
        ret
      }
    }

  // ============================================================================
  // Helper: inode_first_free_extent_slot(inode) -> u64
  //   rdi = &inode
  //
  //   Returns i in [0, 8) of the first slot with start_lba == 0, or 0xFF if
  //   all 8 slots occupied.
  //
  //   Leaf.
  // ============================================================================
  pub let inode_first_free_extent_slot : (u64) -> u64 !{mem} @{} =
    fn (inode: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M2-005 (#919 helper). Scan extent[0..8] for first slot with start_lba == 0. Body: xor rcx,rcx; mov r10, rdi; add r10, 40. Loop pdxl_wr_fs_top: cmp rcx,8; jae pdxl_wr_fs_full. xor r8,r8; mov_d r8, [r10]. cmp r8,0; je pdxl_wr_fs_hit. add r10,8; add rcx,1; jmp top. hit: mov rax, rcx; ret. full: mov rax, 0xFF; ret. Leaf. Reserved labels: pdxl_wr_fs_.",
      block: {
        xor rcx, rcx;
        mov r10, rdi;
        add r10, 40;

      pdxl_wr_fs_top:
        cmp rcx, 8;
        jae pdxl_wr_fs_full;

        xor r8, r8;
        mov_d r8, [r10];
        cmp r8, 0;
        je pdxl_wr_fs_hit;

        add r10, 8;
        add rcx, 1;
        jmp pdxl_wr_fs_top;

      pdxl_wr_fs_hit:
        mov rax, rcx;
        ret;

      pdxl_wr_fs_full:
        mov rax, 0xFF;
        ret
      }
    }

  // ============================================================================
  // pdxfs_write(nsid: u64, sb: u64, inode: u64, offset: u64, len: u64,
  //             in_pa: u64) -> u64
  //   rdi = nsid, rsi = &sb, rdx = &inode (in-memory), rcx = offset,
  //   r8 = len, r9 = in_pa (UNUSED at M2 — see §Data write gap).
  //
  //   Returns 0 (OK) never at M2 — always returns ETODO_WRITE on the happy
  //   path since put_inode is itself stubbed. Genuine failures return
  //   ENOSPC / EIO with priority over ETODO_WRITE.
  //
  // Register plan (6-push + 8 pad; entry rsp%16==8 → 56 → 64, %16==0):
  //   rbx = nsid
  //   rbp = &sb
  //   r12 = &inode
  //   r13 = offset
  //   r14 = len
  //   r15 = new_size (computed) / then reused for needed_new_blocks
  //
  //   in_pa (r9 at entry) is dropped after prologue — documented UNUSED.
  //
  //   Flow (see §Data write gap for scope):
  //     (1) new_size = max(inode.size, offset + len).
  //     (2) current_blocks = inode_current_blocks(inode).
  //     (3) needed_total = (new_size + 4095) >> 12.
  //     (4) if needed_total > current_blocks:
  //           needed_new = needed_total - current_blocks
  //           start_lba = extent_alloc(nsid, sb, needed_new)
  //           if start_lba == 0: return ENOSPC
  //           slot = inode_first_free_extent_slot(inode)
  //           if slot == 0xFF: return ENOSPC (all 8 in use)
  //           inode.extent[slot].start_lba = (u32)start_lba
  //           inode.extent[slot].len_lba   = (u32)needed_new
  //     (5) inode.size = new_size; inode.mtime = rdtsc-sample.
  //     (6) [TODO(R25.M3): for each 4-KiB chunk in [offset, offset+len):
  //          translate → nvme_write_blocking(chunk_pa)]
  //     (7) status = put_inode(nsid, sb, inode_id?, inode). At M2 we don't
  //         have an inode-id here — put_inode requires it and callers of
  //         pdxfs_write are expected to know the id. This is a scope
  //         mismatch with the task: the task-body specifies "put_inode" as
  //         the closing step but pdxfs_write's signature doesn't include
  //         inode_id. Two resolutions:
  //           (a) grow signature to 7 args → paideia-as untested territory.
  //           (b) leave put_inode to the caller (VFS layer will hold the
  //               inode-id in the vnode) and return ETODO_WRITE here.
  //         We take (b): pdxfs_write mutates the in-memory inode struct and
  //         returns; the VFS caller composes with put_inode. Documented.
  //     (8) Return PDXFS_WRITE_ETODO_WRITE.
  // ============================================================================
  pub let pdxfs_write : (u64, u64, u64, u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (nsid: u64, sb: u64, inode: u64, offset: u64, len: u64, in_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R25-M2-005 (#919). Grow file, allocate extent, stamp size/mtime. Body: (1) 6-push callee-save prologue + sub rsp,8 → rsp%16==0. (2) Stage: rbx=nsid, rbp=sb, r12=inode, r13=offset, r14=len. r9 (in_pa) discarded. (3) Compute new_size = max(inode.size, offset+len): mov r15, r13; add r15, r14 (=end_byte). mov r10, [r12 + 8] (inode.size). cmp r15, r10; jae pdxl_wr_use_end. mov r15, r10 (existing size larger). pdxl_wr_use_end: r15 = new_size. (4) needed_total = (new_size + 4095) >> 12: mov rcx, r15; add rcx, 4095; shr rcx, 12. Save in r11 across call. Actually r11 is caller-save; use another approach: keep needed_total on stack via push. Simpler: compute needed_total AFTER the current_blocks call. (5) current_blocks = inode_current_blocks(r12): mov rdi, r12; call inode_current_blocks → rax. Save rax in r10 (caller-save, safe until next call). (6) needed_total = (r15 + 4095) >> 12: recompute (arithmetic-only, no clobber). mov rcx, r15; add rcx, 4095; shr rcx, 12. (7) if rcx > r10: needed_new = rcx - r10. Else: skip alloc. cmp rcx, r10; jbe pdxl_wr_no_alloc. sub rcx, r10. (8) extent_alloc(rbx, rbp, rcx): mov rdi, rbx; mov rsi, rbp; mov rdx, rcx; call extent_alloc → rax = start_lba. (9) cmp rax, 0; je pdxl_wr_enospc. Save start_lba in r8 (caller-save; last use before the slot-find call which returns u64). (10) inode_first_free_extent_slot(r12): mov rdi, r12; save r8 across call? Yes — push r8. mov rdi, r12; call inode_first_free_extent_slot → rax. pop r8 (start_lba back). (11) cmp rax, 0xFF; je pdxl_wr_enospc. Compute &extent[slot] = r12 + 40 + rax*8: mov r11, rax; shl r11, 3; add r11, r12; add r11, 40. (12) Stamp start_lba (u32 @+0) and len (u32 @+4). But we need needed_new for the len field — we lost it. Recover: current_blocks was in r10, but the intermediate call clobbered r10... actually inode_first_free_extent_slot is leaf and only touches rax/rcx/r10/r8 (per body above). r10 is trashed. Rethink: push needed_new too. Do: push needed_new BEFORE the first_free_extent_slot call, alongside r8. Actually simpler: recompute needed_new inline before writing len. We have new_size in r15, and current_blocks was in r10 (lost). Recompute current_blocks needs another call — expensive. Cleanest: push needed_new alongside r8. push r8 (start_lba); push rcx (needed_new); call; pop rcx; pop r8. (13) mov_d [r11+0], r8; mov_d [r11+4], rcx. (14) pdxl_wr_no_alloc: Stamp inode.size = r15 (u64 @+8). mov [r12+8], r15. (15) Stamp inode.mtime: rdtsc; shl rdx,32; or rax,rdx; mov [r12+24], rax. (16) Return: mov rax, 4 (ETODO_WRITE). Epilogue. Error terminals: pdxl_wr_enospc: mov rax, 1; jmp ret. Reserved labels: pdxl_wr_. Encoder: rdtsc / mov r64,imm32 / mov_d / mov / push / pop / call / cmp / jae / jbe / je / jmp — all proven.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                              // nsid
        mov rbp, rsi;                              // &sb
        mov r12, rdx;                              // &inode
        mov r13, rcx;                              // offset
        mov r14, r8;                               // len
        // r9 (in_pa) intentionally discarded — see §Data write gap.

        // (3) new_size = max(inode.size, offset+len).
        mov r15, r13;
        add r15, r14;                              // r15 = offset + len
        mov r10, [r12 + 8];                        // inode.size
        cmp r15, r10;
        jae pdxl_wr_use_end;
        mov r15, r10;                              // existing size larger

      pdxl_wr_use_end:
        // (4) current_blocks.
        mov rdi, r12;
        call inode_current_blocks;
        mov r10, rax;                              // r10 = current_blocks

        // (5) needed_total = (new_size + 4095) >> 12.
        mov rcx, r15;
        add rcx, 4095;
        shr rcx, 12;                               // rcx = needed_total

        // (6) needed_new = needed_total - current_blocks, if positive.
        cmp rcx, r10;
        jbe pdxl_wr_no_alloc;
        sub rcx, r10;                              // rcx = needed_new

        // (7) extent_alloc(nsid, sb, needed_new).
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, rcx;
        call extent_alloc;
        cmp rax, 0;
        je pdxl_wr_enospc;

        // Push start_lba (rax) and needed_new (rdx was destroyed; recover:
        // extent_alloc's third arg came from rcx which we still had as the
        // arg register — actually rcx was moved to rdx and the callee may
        // have trashed rdx. But we're about to reuse rdx anyway. The
        // needed_new value MUST be preserved across the next call.
        // Recompute needed_new here from r15/r10 which are still valid.
        push rax;                                  // start_lba
        mov rcx, r15;
        add rcx, 4095;
        shr rcx, 12;
        sub rcx, r10;                              // rcx = needed_new (recomputed)
        push rcx;                                  // needed_new

        // (8) Find first free slot.
        mov rdi, r12;
        call inode_first_free_extent_slot;
        // rax = slot idx (0..7) or 0xFF.

        pop rcx;                                   // rcx = needed_new
        pop r8;                                    // r8  = start_lba

        cmp rax, 0xFF;
        je pdxl_wr_enospc;

        // (9) &extent[slot] = r12 + 40 + slot*8.
        mov r11, rax;
        shl r11, 3;
        add r11, r12;
        add r11, 40;

        // (10) Stamp start_lba (u32 @+0) + len (u32 @+4).
        mov_d [r11 + 0], r8;
        mov_d [r11 + 4], rcx;

      pdxl_wr_no_alloc:
        // (11) Stamp inode.size = new_size (u64 @+8).
        mov [r12 + 8], r15;

        // (12) Stamp inode.mtime via rdtsc reconstruction (matches uuid.pdx
        //      L74-L84 idiom). r10/r11 caller-save; free to trash.
        rdtsc;
        shl rdx, 32;
        or rax, rdx;
        mov [r12 + 24], rax;                       // inode.mtime

        // (13) TODO(R25.M3): data-block write loop via nvme_write_blocking.
        //      For each 4-KiB chunk in [offset, offset+len):
        //        logical_lba = chunk_off >> 12
        //        phys_lba = extent_translate(inode, logical_lba)
        //        nvme_write_blocking(nsid, phys_lba, 8, chunk_pa)
        //      For M2 the payload is not moved; documented in header.

        mov rax, 4;                                // PDXFS_WRITE_ETODO_WRITE
        jmp pdxl_wr_ret;

      pdxl_wr_enospc:
        mov rax, 1;                                // PDXFS_WRITE_ENOSPC

      pdxl_wr_ret:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
