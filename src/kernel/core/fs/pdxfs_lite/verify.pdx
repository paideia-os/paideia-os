// src/kernel/core/fs/pdxfs_lite/verify.pdx — R25-M5-001 (#929)
//
// PdxFS-lite superblock signature-verify shim.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// pdxfs_sb_verify_sig(sb: *pdxfs_sb, pubkey_pa: u64) -> u64
//   Returns 1 on verify pass, 0 on verify fail. Called from
//   mount_op.pdx pdxfs_lite_mount BEFORE the mount is published
//   into _pdxfs_lite_mount_ctx — a verify fail means the mount
//   never publishes (pdxfs_lite_mount returns 0xFFFF).
//
// Three modes, gated by src/kernel/core/config/features.pdx compile-
// time flags:
//
//   (1) Real ML-DSA-65 verify (Features.CRYPTO_ML_DSA_ENABLED = 1):
//       Call into the R32 crypto substrate (ml_dsa_verify). At R25.M5
//       that substrate does not exist, so this branch is DEAD CODE
//       at MVP — flipping the flag today would leave an unresolved
//       symbol at link. The gate exists so R32 can drop the crypto
//       primitive next to the flag flip without editing this file's
//       API shape.
//
//   (2) Dev bypass (Features.PDXFS_DEV_KEY_ONLY = 1) — R25.M5 default:
//       Accept the superblock iff its 3400-byte sig field is all
//       zeros. tools/mkfs-pdxfs-lite.sh authors images with an
//       all-zero sig at MVP; this bypass lets the kernel mount them.
//       A non-zero byte anywhere in the sig field is rejected — the
//       bypass is NOT a "verify nothing" mode, so a garbage-sig
//       image still fails cleanly.
//
//   (3) Neither flag set: return 0 (reject). Secure-by-default when
//       both flags are simultaneously turned off (a state a future
//       hardening flag might use to disable mount entirely).
//
// At R25.M5 the flag values are hard-coded (CRYPTO=0, DEV_KEY_ONLY=1)
// in features.pdx AND mirrored below as immediates. The reason for
// hard-coding rather than loading Features.X into a register: no
// existing .pdx asm body in this kernel loads a module-scoped
// compile-time `let X : u64 = imm` binding as an immediate operand
// (paideia-as v0.22 lacks a proven idiom; every reference-site so far
// hardcodes the literal — see superblock.pdx L142 which hardcodes
// 0x4C584450 rather than PDXFS_SB_MAGIC). When the R32 flip lands,
// this file's body is revised in lockstep with features.pdx — the
// two-source-of-truth invariant is a documented burden of the MVP
// substrate, retired when a real Features.X→imm encoder idiom lands.
//
// -----------------------------------------------------------------------------
// Verify budget
// -----------------------------------------------------------------------------
//
// Dev-mode (memcmp of 3400 bytes against zero, done as 425 qword
// loads + or'd together): fits inside 1 µs on Raptor Lake per
// design/filesystem/pdxfs-lite-perf.md — three orders of magnitude
// under the <5 ms target reserved for the real ML-DSA-65 path.
//
// -----------------------------------------------------------------------------
// ABI
// -----------------------------------------------------------------------------
//
//   rdi = sb          — pointer to a 4 KiB superblock staged in memory
//                       (typically &_pdxfs_sb from superblock.pdx).
//   rsi = pubkey_pa   — physical address of the embedded ML-DSA-65
//                       public key (from pdxfs_lite_pubkey_ptr()).
//                       Unused under dev-bypass; kept in the ABI for
//                       R32 forward-compatibility.
//   returns rax = 1 (pass) or 0 (fail).
//
// -----------------------------------------------------------------------------
// Register plan (leaf under dev-bypass — no callee-save touched)
// -----------------------------------------------------------------------------
//
//   Dev-bypass branch:
//     r10 = base pointer into sb + PDXFS_SB_SIG_OFFSET (= 696)
//     r11 = accumulator: OR of all 425 qwords in the sig field
//     rcx = loop counter (qwords remaining; 3400/8 = 425)
//     rax = per-load scratch + final return
//
//   No pushes needed: rax/rcx/r10/r11 are SysV caller-save. The ML-DSA
//   branch (R32) will add its own prologue when it lands.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `pdxl_vs_` (avoids `if`, `loop`, `end` per
// feedback_paideia_as_version_discipline.md).

module Verify = structure {

  // ============================================================================
  // Constants — mirrored from superblock.pdx (frozen offsets/lengths for
  // the 4 KiB PdxFS-lite v0 superblock).
  // ============================================================================

  pub let PDXFS_VERIFY_SIG_OFFSET : u64 = 696    // PDXFS_SB_SIG_OFFSET mirror
  pub let PDXFS_VERIFY_SIG_LEN    : u64 = 3400   // PDXFS_SB_SIG_LEN mirror
  pub let PDXFS_VERIFY_SIG_QWORDS : u64 = 425    // 3400 / 8

  // Return sentinels.
  pub let PDXFS_VERIFY_PASS       : u64 = 1
  pub let PDXFS_VERIFY_FAIL       : u64 = 0

  // ============================================================================
  // pdxfs_sb_verify_sig(sb: *pdxfs_sb, pubkey_pa: u64) -> u64
  //
  //   rdi = sb (superblock base pointer — typically &_pdxfs_sb)
  //   rsi = pubkey_pa (unused under R25.M5 dev-bypass path)
  //
  //   Returns rax = 1 on verify pass, 0 on verify fail.
  //
  // Flow (dev-bypass mode — R25.M5 default):
  //   (1) r10 = rdi + PDXFS_VERIFY_SIG_OFFSET   (base of sig[0..3400])
  //   (2) xor r11, r11                          (accumulator = 0)
  //   (3) mov rcx, PDXFS_VERIFY_SIG_QWORDS      (loop counter = 425)
  //   (4) pdxl_vs_next:
  //         mov rax, [r10]
  //         or  r11, rax
  //         add r10, 8
  //         dec rcx
  //         jne pdxl_vs_next
  //   (5) test r11 (zero iff every qword was zero)
  //         cmp r11, 0
  //         jne pdxl_vs_fail      (any non-zero byte -> reject)
  //   (6) mov rax, 1; ret         (all-zero sig -> accept)
  //   pdxl_vs_fail:
  //     xor eax, eax; ret
  //
  // 3400 bytes = 425 qwords exactly (no tail — 3400 is a multiple of 8).
  //
  // Encoder posture:
  //   * lea r64, [reg + imm32] — proven (superblock.pdx L194 uses the
  //     rip-relative form; add-reg-imm variant is the same encoder class).
  //     Simpler: use `add r10, imm` after mov r10, rdi.
  //   * mov r64, [r64]       — proven throughout.
  //   * or r64, r64, xor r64, r64, dec r64, cmp r64, imm, jne — all proven.
  //   * ret — proven.
  // ============================================================================
  pub let pdxfs_sb_verify_sig : (u64, u64) -> u64 !{mem} @{} =
    fn (sb: u64, pubkey_pa: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M5-001 (#929). PdxFS-lite superblock signature-verify shim. R25.M5 body: dev-bypass path only (Features.PDXFS_DEV_KEY_ONLY=1). Accepts a superblock iff its 3400-byte sig field is bytewise all zero. Body: (1) mov r10, rdi; add r10, 696 — r10 -> sig[0]. (2) xor r11, r11 — accumulator. (3) mov rcx, 425 — 3400/8 qwords. (4) loop: mov rax, [r10]; or r11, rax; add r10, 8; dec rcx; jne loop-head. (5) cmp r11, 0; jne fail. (6) mov rax, 1; ret. fail: xor eax, eax; ret. Leaf: rax/rcx/r10/r11 all SysV caller-save; no prologue. When Features.CRYPTO_ML_DSA_ENABLED flips to 1 (R32), this body gets a leading `call ml_dsa_verify(sb, sb+696, 696, pubkey_pa)` branch — the dev-bypass path remains as a fallback under DEV_KEY_ONLY (dropped in the same commit). Reserved labels: pdxl_vs_. Rejects a garbage-sig image (any non-zero byte anywhere in the 3400-byte sig field) even under dev-bypass, so the bypass is not a `verify nothing` mode. Verify budget: 425 qword loads + 425 OR + 425 add + 425 dec + 425 jne = ~2125 cycles on Raptor Lake ~ 500 ns (well under the <5 ms real-ML-DSA target reserved for R32 per design/filesystem/pdxfs-lite-perf.md). rsi/pubkey_pa unused at MVP — kept in ABI for R32 forward-compat.",
      block: {
        // (1) r10 = sb + PDXFS_SB_SIG_OFFSET (=696).
        mov r10, rdi;
        add r10, 696;

        // (2) accumulator = 0.
        xor r11, r11;

        // (3) counter = 425 (qwords).
        mov rcx, 425;

      pdxl_vs_next:
        // (4) OR every qword into the accumulator.
        mov rax, [r10];
        or  r11, rax;
        add r10, 8;
        dec rcx;
        jne pdxl_vs_next;

        // (5) Non-zero accumulator -> at least one non-zero byte -> reject.
        cmp r11, 0;
        jne pdxl_vs_fail;

        // (6) All-zero sig -> accept (dev-bypass).
        mov rax, 1;
        ret;

      pdxl_vs_fail:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // ml_dsa_verify_stub(sb: *pdxfs_sb, pubkey_pa: u64) -> u64
  //
  //   Unconditional-pass stub occupying the symbol slot the R32 real
  //   ML-DSA-65 verify primitive will replace. Present at R25.M5 so
  //   the substrate exists as a callable-and-testable entry point;
  //   when R32 lands, this stub is deleted and the real function
  //   at src/kernel/core/crypto/ml_dsa/verify.pdx takes over the
  //   symbol (see design/roadmap/r18-plus-bare-metal.md §R32).
  //
  //   Not called from pdxfs_sb_verify_sig at R25.M5 (the branch is
  //   compile-time-dead under CRYPTO_ML_DSA_ENABLED=0). Retained so
  //   nm build/kernel.elf | grep ml_dsa_verify_stub confirms the
  //   substrate lands.
  //
  //   Returns 1 unconditionally. Leaf.
  // ============================================================================
  pub let ml_dsa_verify_stub : (u64, u64) -> u64 !{mem} @{} =
    fn (sb: u64, pubkey_pa: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R25-M5-001 (#929). Placeholder for the R32 ML-DSA-65 verify primitive. At R25.M5 the real crypto substrate is not yet built (R32 milestone); this stub occupies the symbol so the pdxfs_sb_verify_sig CRYPTO_ML_DSA_ENABLED=1 branch (currently compile-time-dead) has a resolvable call target. Body: mov rax, 1; ret. Leaf, no callee-save. When R32 lands, this stub is deleted and the real primitive at src/kernel/core/crypto/ml_dsa/verify.pdx takes over the ml_dsa_verify symbol.",
      block: {
        mov rax, 1;
        ret
      }
    }
}
