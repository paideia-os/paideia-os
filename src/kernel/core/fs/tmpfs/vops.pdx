// src/kernel/core/fs/tmpfs/vops.pdx — R16-M2-008 (#586)
// tmpfs vops table + 5 adapter wrappers + 2 stubs + init populator.
//
// Per design/kernel/r16-m2-008-tmpfs-vops-wire.md:
//
//   Materialise the concrete _tmpfs_vops : [u64; 7] shared function-pointer
//   table for the tmpfs backend. Bridge the two-signature gap between vops
//   (which take vnode_ptr in rdi) and tmpfs primitives (which take inode_idx
//   in rdi). 5 adapters extract idx from vnode.backend_ptr @+32, mask to low
//   16 bits, and tail-call their primitive. 2 stubs (open/close) return 0
//   (success no-op). tmpfs_vops_init populates all 7 slots at boot.

module Vops = structure {
  // ==========================================================================
  // _tmpfs_vops : [u64; 14] — shared vops table (R56.M3-002 widened for stat;
  //                           R56.M3-003 widened for readdir;
  //                           R56.M3-004 widened for mkdir/rmdir;
  //                           R56.M3-005 widened for rename;
  //                           Wave λ widened for readlink/symlink)
  // ==========================================================================
  // Allocated in .bss with @align(8). Each slot holds a function pointer:
  //   +0  (VOPS_READ_OFFSET)     -> _tmpfs_read_adapter
  //   +8  (VOPS_WRITE_OFFSET)    -> _tmpfs_write_adapter
  //   +16 (VOPS_OPEN_OFFSET)     -> _tmpfs_open_stub
  //   +24 (VOPS_CLOSE_OFFSET)    -> _tmpfs_close_stub
  //   +32 (VOPS_LOOKUP_OFFSET)   -> _tmpfs_lookup_adapter
  //   +40 (VOPS_CREATE_OFFSET)   -> _tmpfs_create_adapter
  //   +48 (VOPS_UNLINK_OFFSET)   -> _tmpfs_unlink_adapter
  //   +56 (VOPS_STAT_OFFSET)     -> _tmpfs_stat_adapter    (R56.M3-002 #1791)
  //   +64 (VOPS_READDIR_OFFSET)  -> _tmpfs_readdir_adapter (R56.M3-003 #1792)
  //   +72 (VOPS_MKDIR_OFFSET)    -> _tmpfs_mkdir_adapter   (R56.M3-004 #1793)
  //   +80 (VOPS_RMDIR_OFFSET)    -> _tmpfs_rmdir_adapter   (R56.M3-004 #1793)
  //   +88 (VOPS_RENAME_OFFSET)   -> _tmpfs_rename_adapter  (R56.M3-005 #1794)
  //   +96 (VOPS_READLINK_OFFSET) -> _tmpfs_readlink_adapter (Wave λ)
  //   +104 (VOPS_SYMLINK_OFFSET) -> _tmpfs_symlink_adapter  (Wave λ)
  pub let mut _tmpfs_vops : [u64; 14] = uninit @align(8)

  // Wave λ (λ-04): side-pool storage for symlink targets.  A 256×256-byte
  // slab indexed by tmpfs inode idx (TMPFS_MAX=256).  Each 256-byte slot
  // holds the raw NUL-padded target string; the length lives in the
  // inode's own SIZE field (TMPFS_INODE_SIZE_OFFSET=8).  Byte-symmetric
  // with the tmpfs page-pool allocation discipline (kept out of the
  // inode struct so the +1040 name / +1136 sibling-chain offsets stay
  // byte-identical — see paideia-os #2436 for the last rebase episode).
  //
  // Sizing: TMPFS_SYMLINK_TARGET_MAX (256) × TMPFS_MAX (256) = 65 536 B.
  // Fresh .bss allocation; every slot is byte-zero at boot, so the read
  // path reads zero bytes for an unallocated slot (defence in depth vs.
  // a mis-routed vops_readlink on a non-symlink inode; the adapter's
  // own type-gate is the primary check).
  pub let TMPFS_SYMLINK_TARGET_MAX  : u64 = 256
  pub let TMPFS_SYMLINK_TYPE        : u64 = 3       // VNODE_TYPE_LNK (fresh; REG=1, DIR=2)
  pub let mut _tmpfs_symlink_pool   : [u8; 65536] = uninit @align(8)

  // _tmpfs_symlink_slot(idx: u64) -> u64 — pool-slot address helper.
  //
  // Returns &_tmpfs_symlink_pool[idx * 256].  Leaf; matches
  // tmpfs_inode_slot's own shape (tmpfs/inode.pdx §tmpfs_inode_slot).
  // Encoder note: shl 8 requires only one instruction so this stays
  // shorter than the tmpfs_inode_slot helper.
  pub let _tmpfs_symlink_slot : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "Wave λ (λ-04): compute &_tmpfs_symlink_pool[idx * 256]. SIB scale supports 1/2/4/8 only, so *256 requires an explicit shl 8 + add — three-instruction body. No bounds check by policy: caller has validated idx via tmpfs_inode_alloc round-trip. Leaf function; rax scratch, no callee-save.",
      block: {
        mov rax, rdi;
        shl rax, 8;                         // idx * 256 (TMPFS_SYMLINK_TARGET_MAX)
        lea rcx, [rip + _tmpfs_symlink_pool];
        add rax, rcx;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_read_adapter — extract idx from vnode, call tmpfs_read
  // ==========================================================================
  // vops signature:  read(vn, buf, len, off)  [rdi=vn, rsi=buf, rdx=len, rcx=off]
  // tmpfs signature: tmpfs_read(idx, buf, len, off)  [rdi=idx, rsi=buf, rdx=len, rcx=off]
  //
  // Backend_ptr encoding: low 16 bits hold inode_idx; high 48 bits reserved.
  // Adapter extracts idx via load + mask; passes buf/len/off through untouched.
  pub let _tmpfs_read_adapter : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R16-M2-008 (#586): Adapter wrapper bridging vops signature (vnode_ptr) to tmpfs_read signature (inode_idx). Load vnode.backend_ptr from rdi+32, mask to low 16 bits (inode_idx), forward buf/len/off through rsi/rdx/rcx unchanged. Non-leaf (nested call): sub rsp,8 / call tmpfs_read / add rsp,8 maintains SysV alignment (rsp%16==8 at callee entry). Two instructions for idx extract (mov + and 0xFFFF); 4 for alignment/call/return; 6 total including comment.",
      block: {
        mov  rdi, [rdi + 32];      // load vnode.backend_ptr
        and  rdi, 0xFFFF;          // mask to inode_idx (bits [0,16))
        sub  rsp, 8;               // SysV alignment pad around nested call
        call tmpfs_read;           // direct call to tmpfs_read(idx, buf, len, off)
        add  rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_write_adapter — extract idx from vnode, call tmpfs_write
  // ==========================================================================
  // Identical shape to _tmpfs_read_adapter; only the target primitive differs.
  pub let _tmpfs_write_adapter : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R16-M2-008 (#586): Adapter wrapper identical to _tmpfs_read_adapter except target is tmpfs_write. Extract idx from vnode.backend_ptr (+32), mask to low 16 bits, pass through buf/len/off in rsi/rdx/rcx. Non-leaf with sub/call/add rsp,8 pattern for SysV alignment.",
      block: {
        mov  rdi, [rdi + 32];      // load vnode.backend_ptr
        and  rdi, 0xFFFF;          // mask to inode_idx
        sub  rsp, 8;               // SysV alignment pad
        call tmpfs_write;          // direct call to tmpfs_write(idx, buf, len, off)
        add  rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_lookup_adapter — extract idx from vnode, call tmpfs_lookup
  // ==========================================================================
  // vops signature:  lookup(dir_vn, name_ptr)  [rdi=dir_vn, rsi=name_ptr]
  // tmpfs signature: tmpfs_lookup(dir_idx, name_ptr)  [rdi=dir_idx, rsi=name_ptr]
  //
  // Two-argument form; rdx/rcx pass through unused but harmless.
  pub let _tmpfs_lookup_adapter : (u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R16-M2-008 (#586): Adapter wrapper for tmpfs_lookup. Extract dir_idx from vnode.backend_ptr (+32), mask to low 16 bits, pass name_ptr through in rsi unchanged. Return value (child idx or 0) forwarded verbatim. Non-leaf with SysV alignment pad.",
      block: {
        mov  rdi, [rdi + 32];      // load vnode.backend_ptr
        and  rdi, 0xFFFF;          // mask to inode_idx
        sub  rsp, 8;               // SysV alignment pad
        call tmpfs_lookup;         // direct call to tmpfs_lookup(dir_idx, name)
        add  rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_create_adapter — extract idx, shuffle args, call tmpfs_create
  // ==========================================================================
  // vops signature:  create(dir_vn, name_ptr, mode)  [rdi=dir_vn, rsi=name_ptr, rdx=mode]
  // tmpfs signature: tmpfs_create(dir_idx, name_ptr, name_len, type)  [rdi=dir_idx, rsi=name_ptr, rdx=name_len, rcx=type]
  //
  // Argument transform: rdx (mode) -> rcx (type_), and inject rdx = 32 (name_len cap).
  // At R16.M2, caller supplies raw VNODE_TYPE_* constant; R17+ will add mode->type helper.
  pub let _tmpfs_create_adapter : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (mode: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R16-M2-008 (#586): Adapter wrapper for tmpfs_create with argument shape transform. Extract dir_idx from vnode.backend_ptr (+32), mask to low 16 bits. Shuffle rdx (mode) into rcx (type), inject rdx = 96 (TMPFS_INODE_NAME_MAX, #2234: was 32). Primitive's own name loop caps at 95 bytes + NUL, so passing 96 achieves effective strnlen behavior. Non-leaf with SysV alignment (sub/call/add rsp,8). 9 instructions total. paideia-os #2436 unchanged here: this adapter passes name_len only; the primitive owns the field-offset shifts that come with the page_ptrs widen.",
      block: {
        mov  rdi, [rdi + 32];      // load vnode.backend_ptr
        and  rdi, 0xFFFF;          // mask to inode_idx
        mov  rcx, rdx;             // rcx = mode (becomes type_ for tmpfs_create)
        mov  rdx, 96;              // rdx = name_len = TMPFS_INODE_NAME_MAX (#2234: was 32)
        sub  rsp, 8;               // SysV alignment pad
        call tmpfs_create;         // direct call to tmpfs_create(dir_idx, name, len, type)
        add  rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_unlink_adapter — extract idx from vnode, call tmpfs_unlink
  // ==========================================================================
  // vops signature:  unlink(dir_vn, name_ptr)  [rdi=dir_vn, rsi=name_ptr]
  // tmpfs signature: tmpfs_unlink(dir_idx, name_ptr)  [rdi=dir_idx, rsi=name_ptr]
  //
  // Identical shape to _tmpfs_lookup_adapter.
  pub let _tmpfs_unlink_adapter : (u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R16-M2-008 (#586): Adapter wrapper for tmpfs_unlink. Extract dir_idx from vnode.backend_ptr (+32), mask to low 16 bits, pass name_ptr through in rsi unchanged. Return 0 on success, 0xFFFF on failure — forwarded verbatim. Non-leaf with SysV alignment pad.",
      block: {
        mov  rdi, [rdi + 32];      // load vnode.backend_ptr
        and  rdi, 0xFFFF;          // mask to inode_idx
        sub  rsp, 8;               // SysV alignment pad
        call tmpfs_unlink;         // direct call to tmpfs_unlink(dir_idx, name)
        add  rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_open_stub — success no-op stub
  // ==========================================================================
  // tmpfs has no per-open state to initialize at R16.M2. Stub returns 0 (success).
  // Null slot would return VOPS_ERR_NOT_SUPPORTED, which would fail vfs_open
  // for tmpfs at R16.M3+ — a substantive behaviour bug. Stubs prevent this.
  pub let _tmpfs_open_stub : (u64, u64) -> u64 !{} @{} =
    fn (vn: u64) (flags: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R16-M2-008 (#586): Stub for open slot. Tmpfs has no per-open state to manage; every open on tmpfs trivially succeeds. Returns 0 (success), not an error sentinel. Null slot would return E_NOT_SUPPORTED (-1 as u64), breaking downstream sys_open at R16.M3. Leaf function; 2 instructions (xor eax,eax; ret).",
      block: {
        xor  eax, eax;             // return 0 (success)
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_close_stub — success no-op stub
  // ==========================================================================
  // Identical shape and rationale to _tmpfs_open_stub.
  pub let _tmpfs_close_stub : (u64) -> u64 !{} @{} =
    fn (vn: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R16-M2-008 (#586): Stub for close slot. Tmpfs has no per-open state to teardown. Returns 0 (success). Mirrors _tmpfs_open_stub rationale: null slot would break R16.M3+ sys_close.",
      block: {
        xor  eax, eax;             // return 0 (success)
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_stat_adapter — extract inode idx, fill 64-byte kernel stat struct
  // ==========================================================================
  // vops signature:   stat(vn, stat_buf)  [rdi=vn, rsi=stat_buf]
  // Returns 0 on success.
  //
  // Stat struct layout (frozen by design/kernel/vfs-metadata-syscalls.md
  // and sys_stat.pdx module header — 64 bytes total):
  //   +0  ino     u64   (inode idx from vnode.backend_ptr low 16 bits)
  //   +8  size   u64   (tmpfs_inode.size @ TMPFS_INODE_SIZE_OFFSET=8)
  //   +16 mtime  u64   (0 — pending clock wire-up)
  //   +24 mode   u32   (0 — tmpfs has no POSIX mode word at R56)
  //   +28 nlink  u32   (tmpfs_inode.link_count @ +4, zero-extended from u16)
  //   +32 uid    u32   (0)
  //   +36 gid    u32   (0)
  //   +40 blksize u32  (4096 — tmpfs page size)
  //   +44 blocks u32   ((size + 4095) >> 12 — ceil-div, u32-cast is safe:
  //                     tmpfs cap is 16 pages per file so blocks <= 16)
  //   +48..+63         reserved, zeroed
  //
  // Register plan: 3-push callee-save (rbx = stat_buf, r12 = inode_idx,
  // r13 = &inode).  Alignment: entry rsp%16==8 (SysV callee entry
  // via vops_stat dispatcher's `sub rsp, 8; call rax; add rsp, 8`
  // bracket), 3 pushes -> %16==0 which is exactly what SysV requires
  // at the nested tmpfs_inode_slot CALL site (that callee's own
  // retaddr push then delivers rsp%16==8 at its body entry).  No
  // extra pad needed.
  pub let _tmpfs_stat_adapter : (u64, u64) -> u64 !{mem} @{} =
    fn (vn: u64) (stat_buf: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R56.M3-002 (#1791): tmpfs stat adapter. Bridges vops (vnode, stat_buf) surface to tmpfs_inode_slot -> field reads. 3-push callee-save prologue (rbx=stat_buf, r12=inode_idx, r13=&inode). Extract inode_idx from vnode.backend_ptr (+32, low 16 bits) — matches _tmpfs_read_adapter's idiom. Call tmpfs_inode_slot(idx) -> &inode. Fill the 64-byte stat struct field-by-field using the frozen TMPFS_INODE_* offsets (SIZE_OFFSET=8 u64, LINK_COUNT_OFFSET=4 u16 zero-extended, TYPE_OFFSET=0 — all in the header region unchanged by #2436). ino=r12 (inode idx as u64); size=[&inode+8]; mode=0 (no POSIX mode at R56); nlink=[&inode+4]&0xFFFF; uid=gid=0; blksize=4096; blocks=(size+4095)>>12. Reserved tail zeroed via 2x u64 stores. Alignment: entry rsp%16==8, 3 pushes -> %16==0 pre-call; the single nested call (tmpfs_inode_slot) sees %16==8 at entry per SysV. tmpfs_inode_slot is a leaf so no further alignment concern. Returns 0. Labels prefixed tfsa_ (tmpfs stat adapter). No test; no mov_b.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rsi;                    // rbx = stat_buf (survives across call)

        // Extract inode_idx from vnode.backend_ptr (+32, low 16 bits).
        mov r12, [rdi + 32];
        and r12, 0xFFFF;

        // Resolve inode ptr.
        mov rdi, r12;
        call tmpfs_inode_slot;           // rax = &inode
        mov r13, rax;                    // r13 = &inode

        // +0 ino = inode_idx (u64)
        mov [rbx + 0], r12;

        // +8 size = *(u64*)(inode + 8)
        mov rax, [r13 + 8];              // TMPFS_INODE_SIZE_OFFSET = 8
        mov [rbx + 8], rax;

        // +16 mtime = 0
        xor rax, rax;
        mov [rbx + 16], rax;

        // +24 mode = 0 (u32), +28 nlink = link_count (u32) — pack as one u64
        //   low 32 bits = mode (0); high 32 bits = nlink.
        // Load nlink from TMPFS_INODE_LINK_COUNT_OFFSET (+4), u16
        // zero-extended via mov_w (paideia-as idiom; matches
        // fd_inherit.pdx:65 / vfs_open.pdx:250 / vfs_close.pdx:83).
        mov_w rax, [r13 + 4];            // rax = link_count u16 zero-ext
        shl rax, 32;                     // rax now: nlink in [32..64), zero elsewhere
        mov [rbx + 24], rax;             // mode=0 low, nlink u32 high

        // +32 uid = 0 (u32), +36 gid = 0 (u32) — pack as one u64 zero
        xor rax, rax;
        mov [rbx + 32], rax;

        // +40 blksize = 4096 (u32), +44 blocks = (size + 4095) >> 12 (u32)
        //   size lives in [r13 + 8] (already loaded once, reload for clarity).
        mov rcx, [r13 + 8];              // rcx = size
        add rcx, 4095;                   // ceil-div numerator
        shr rcx, 12;                     // rcx = blocks
        shl rcx, 32;                     // move blocks into high 32
        mov rax, 4096;                   // rax = blksize u32 in low 32
        or  rax, rcx;                    // pack {blksize | (blocks << 32)}
        mov [rbx + 40], rax;

        // +48..+63 reserved = 0 (two u64 stores)
        xor rax, rax;
        mov [rbx + 48], rax;
        mov [rbx + 56], rax;

        // Return 0
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_readdir_adapter(vn, buf, nbytes, cursor) -> u64
  //   R56.M3-003 (#1792): iterate the intrusive sibling chain rooted at
  //   inode.first_child, emitting a packed record stream into `buf`.
  //
  //   Record layout (matches sys_getdents body contract):
  //     +0   ino:      u64  (inode index; low 16 bits carry tmpfs slot)
  //     +8   name_len: u16
  //     +10  type:     u8   (VNODE_TYPE_DIR=2, VNODE_TYPE_REG=1)
  //     +11  reserved: u8   (0)
  //     +12  name[name_len]  (no NUL terminator)
  //   Stream terminator: a header with name_len == 0.
  //
  //   Cursor: entry index within the sibling chain (0 = first_child).
  //   The adapter skips `cursor` siblings up front, then emits from there.
  //
  //   Register plan (5-push callee-save + sub rsp, 32 = 40 + 32 = 72;
  //   entry rsp%16==8 → 8 + 72 = 80, %16 == 0 pre-nested-call, matching
  //   SysV %16==8 at callee entry post-CALL push):
  //     rbx = write cursor (kernel dst; advances)
  //     r12 = end of buffer (buf + nbytes; sentinel)
  //     r13 = cur_idx (current sibling; sentinel = 0xFFFF)
  //     r14 = cursor (skip-count budget; decrements while > 0)
  //     r15 = entries_emitted (return-value companion; unused externally
  //           at R56.M3-003, kept for future extend to `vop_readdir` that
  //           reports both bytes and count)
  //   Frame slots ([rsp+0..+32) with sub rsp, 32):
  //     [rsp+ 0] = alignment pad (unused)
  //     [rsp+ 8] = cur_inode ptr (result of most-recent tmpfs_inode_slot)
  //     [rsp+16] = buf_end (mirrors r12 for reload after clobber)
  //     [rsp+24] = buf_base (for post-loop bytes_written computation)
  // ==========================================================================
  pub let _tmpfs_readdir_adapter : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vn: u64) (buf: u64) (nbytes: u64) (cursor: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R56.M3-003 (#1792): tmpfs readdir adapter — walk sibling chain from cursor, emit packed records into buf until nbytes exhausted, always append terminator (if room). Body: (1) 5-push callee-save prologue + sub rsp, 32 lands rsp%16==0 for nested tmpfs_inode_slot calls (entry rsp%16==8 + 40 pushes + 32 pad = 80, %16 == 0). (2) Extract dir inode_idx from vnode.backend_ptr (+32, low 16 bits, tmpfs adapter idiom). Load dir_inode; type gate against VNODE_TYPE_DIR (2) — non-dir → return 12 (terminator only, matches getdents-on-non-dir short-read semantics per §Contract; alternative was to sentinel out but the body already gates via fd_get so structurally this branch is defensive). (3) Extract first_child (+1140 u16 via [+1136] shr 32 mask 0xFFFF; #2436: was +244/+240; #2234: was +180/+176). (4) Skip cursor entries: while cur != 0xFFFF and skip > 0: cur = next_sibling; skip--. (5) Emit loop: while cur != 0xFFFF: load cur_inode; scan name[0..96] for NUL to get name_len (cap 96; #2234: was 32); record_size = 12 + name_len; if write_cursor + record_size + 12 (terminator reserve) > buf_end: break (out-of-buffer, cursor stays advanced so next call resumes here). Store ino=cur (u64); name_len (u16); type=inode.type (u8); reserved=0 (u8); byte-copy name; advance write_cursor by record_size; entries_emitted++. cur = next_sibling. (6) Write terminator: 12 zero bytes at write_cursor (name_len=0). Only if buf_end - write_cursor >= 12 (checked by loop-break invariant). Advance write_cursor by 12. (7) Return bytes_written = write_cursor - buf_base. paideia-os #2436: name-field base moved +144 -> +1040 (page_ptrs widened 16 -> 128); every scan/copy cursor rebased accordingly. Reserved labels: tmpfs_rda_. Encoder: mov_b/mov_w already proven in tmpfs/init.pdx L52-L112; shr/and idiom for u16 extraction proven in tmpfs/lookup.pdx L52-L54.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov rbx, rsi;                       // rbx = write cursor (kernel dst)
        mov r12, rsi;
        add r12, rdx;                       // r12 = buf_end (buf + nbytes)
        mov r14, rcx;                       // r14 = skip cursor
        xor r15, r15;                       // r15 = entries_emitted (unused)

        // Save buf_base at [rsp+24] for the return-value computation.
        mov [rsp + 24], rsi;
        // Save buf_end at [rsp+16] for reload.
        mov [rsp + 16], r12;

        // Extract dir inode_idx from vnode.backend_ptr (+32, low 16 bits).
        mov rdi, [rdi + 32];
        and rdi, 0xFFFF;
        call tmpfs_inode_slot;              // rax = &dir_inode

        // Type gate: must be VNODE_TYPE_DIR (2).
        xor rcx, rcx;
        mov_b rcx, [rax + 0];
        cmp rcx, 2;
        jne tmpfs_rda_terminator_only;

        // first_child at +1140 (u16). Load u64 at +1136 (#2436: was +244/+240;
        // #2234: was +176/+180) and extract bits [32,48).
        mov rcx, [rax + 1136];
        shr rcx, 32;
        and rcx, 0xFFFF;
        mov r13, rcx;                       // r13 = cur_idx

        // Skip `cursor` entries.
      tmpfs_rda_skip:
        cmp r14, 0;
        je  tmpfs_rda_emit;
        cmp r13, 0xFFFF;
        je  tmpfs_rda_terminator_only;      // chain exhausted before cursor

        mov rdi, r13;
        call tmpfs_inode_slot;              // rax = &cur_inode
        // next_sibling at +1138 (u16). Load u64 at +1136 (#2436: was +242/+240;
        // #2234: was +176/+178); shr 16; mask 0xFFFF.
        mov rcx, [rax + 1136];
        shr rcx, 16;
        and rcx, 0xFFFF;
        mov r13, rcx;
        sub r14, 1;
        jmp tmpfs_rda_skip;

      tmpfs_rda_emit:
        cmp r13, 0xFFFF;
        je  tmpfs_rda_terminator;           // chain exhausted → emit terminator

        // Load current inode.
        mov rdi, r13;
        call tmpfs_inode_slot;              // rax = &cur_inode
        // Save cur_ptr in a scratch slot (rax will be clobbered by loops).
        mov [rsp + 8], rax;                 // spill cur_ptr

        // ---- Compute name_len by scanning name field [+1040..+1136) for NUL ----
        // (#2436: was [+144..+240) — page_ptrs widened 16 -> 128 shifted +896;
        //  #2234 widened field 32 -> 96 within its previous base of +144.)
        //   rcx = name_len (0..96)
        //   r8  = temp byte
        //   r9  = &cur_inode.name[0] (rax + 1040)
        mov r9, rax;
        add r9, 1040;
        xor rcx, rcx;
      tmpfs_rda_scan:
        cmp rcx, 96;
        jae tmpfs_rda_scan_done;
        xor r8, r8;
        mov_b r8, [r9 + rcx*1];
        cmp r8, 0;
        je  tmpfs_rda_scan_done;
        add rcx, 1;
        jmp tmpfs_rda_scan;
      tmpfs_rda_scan_done:
        // rcx = name_len ∈ [0, 96]. Store transiently for header emit.

        // ---- Bounds check: record + terminator reserve fits ----
        //   need = 12 + name_len + 12 (terminator) = 24 + name_len
        mov rax, rbx;
        add rax, 24;
        add rax, rcx;
        cmp rax, r12;
        ja  tmpfs_rda_terminator;           // no room; emit terminator + return

        // ---- Emit record header ----
        // ino (u64) = cur_idx (r13; low 16 bits carry the tmpfs slot).
        mov [rbx + 0], r13;
        // name_len (u16)
        mov_w [rbx + 8], rcx;
        // type (u8) = cur_inode.type at +0
        mov r10, [rsp + 8];                 // r10 = &cur_inode
        xor r8, r8;
        mov_b r8, [r10 + 0];
        mov_b [rbx + 10], r8;
        // reserved (u8) = 0
        xor r8, r8;
        mov_b [rbx + 11], r8;

        // ---- Byte-copy name[0..name_len] ----
        //   r9  = &cur_inode.name[0] (#2436: was +144, now +1040)
        //   r11 = dst (rbx + 12)
        //   r8  = byte counter
        mov r9, r10;
        add r9, 1040;
        mov r11, rbx;
        add r11, 12;
        xor r8, r8;
      tmpfs_rda_copy:
        cmp r8, rcx;
        jae tmpfs_rda_copy_done;
        xor rax, rax;
        mov_b rax, [r9 + r8*1];
        mov_b [r11 + r8*1], rax;
        add r8, 1;
        jmp tmpfs_rda_copy;
      tmpfs_rda_copy_done:
        // Advance write cursor by 12 + name_len.
        add rbx, 12;
        add rbx, rcx;
        add r15, 1;                         // entries_emitted++

        // Advance to next sibling.
        mov r10, [rsp + 8];                 // r10 = &cur_inode
        mov rcx, [r10 + 1136];              // #2436: was +240; #2234: was +176
        shr rcx, 16;
        and rcx, 0xFFFF;
        mov r13, rcx;                       // r13 = next cur_idx
        jmp tmpfs_rda_emit;

      tmpfs_rda_terminator:
        // Bounds check: 12 bytes must fit for terminator.
        mov rax, rbx;
        add rax, 12;
        cmp rax, r12;
        ja  tmpfs_rda_out;                  // no room even for terminator; skip

        // Write 12-byte zero header.
        xor rax, rax;
        mov [rbx + 0], rax;                 // ino = 0
        mov_w [rbx + 8], rax;               // name_len = 0
        mov_b [rbx + 10], rax;              // type = 0
        mov_b [rbx + 11], rax;              // reserved = 0
        add rbx, 12;
        jmp tmpfs_rda_out;

      tmpfs_rda_terminator_only:
        // Non-directory OR empty chain OR cursor past end: emit terminator only.
        mov rax, rbx;
        add rax, 12;
        cmp rax, r12;
        ja  tmpfs_rda_out;
        xor rax, rax;
        mov [rbx + 0], rax;
        mov_w [rbx + 8], rax;
        mov_b [rbx + 10], rax;
        mov_b [rbx + 11], rax;
        add rbx, 12;

      tmpfs_rda_out:
        // Return bytes_written = rbx - buf_base.
        mov rax, rbx;
        sub rax, [rsp + 24];

        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_mkdir_adapter(dir_vn, name_ptr, name_len, mode) -> u64
  //   R56.M3-004 (#1793) — bridge vops surface to tmpfs_create with
  //   type=VNODE_TYPE_DIR (2), forwarding name_ptr / name_len / discarding
  //   the caller's `mode` (tmpfs has no POSIX mode word at R56).
  //
  //   Returns 0 on success (tmpfs_create returned new_idx != 0), or
  //   VOPS_ERR_NOT_SUPPORTED (0xFFFFFFFFFFFFFFFF) on any failure
  //   (bad parent type, collision, OOM) — matches the R56 sys_mkdir
  //   contract that a non-zero body return maps to -EIO for ring-3.
  // ==========================================================================
  pub let _tmpfs_mkdir_adapter : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (name_len: u64) (mode: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R56.M3-004 (#1793): tmpfs mkdir adapter. Bridges vops (dir_vn, name_ptr, name_len, mode) to tmpfs_create(dir_idx, name_ptr, name_len, type=VNODE_TYPE_DIR=2). Body: (1) Extract dir_idx from vnode.backend_ptr (+32, low 16 bits, tmpfs adapter idiom). (2) Cap name_len at 96 (TMPFS_INODE_NAME_MAX; #2234: was 32; matches _tmpfs_create_adapter's own 96-byte hard limit). (3) Move rdx (name_len) untouched; rcx (mode) is REPLACED with 2 (VNODE_TYPE_DIR) — tmpfs has no POSIX mode word at R56 so the caller's mode is intentionally dropped rather than mis-persisted. (4) sub rsp,8 / call tmpfs_create / add rsp,8 for SysV alignment. (5) rax = tmpfs_create's return (new_idx or 0); non-zero -> 0 (success), 0 -> VOPS_ERR_NOT_SUPPORTED. Leaf-adjacent (single nested call). No test; no mov_b.",
      block: {
        mov  rdi, [rdi + 32];      // load vnode.backend_ptr
        and  rdi, 0xFFFF;          // mask to dir_idx
        // Cap name_len at 96 (tmpfs name-field ceiling, #2234: was 32).
        mov  rax, 96;
        cmp  rdx, rax;
        jbe  tmpfs_mkdir_len_ok;
        mov  rdx, rax;
      tmpfs_mkdir_len_ok:
        // rsi = name_ptr (untouched); rdx = capped name_len (untouched);
        // rcx = mode (dropped); overwrite with VNODE_TYPE_DIR = 2.
        mov  rcx, 2;
        sub  rsp, 8;               // SysV alignment pad
        call tmpfs_create;         // rax = new_idx or 0
        add  rsp, 8;
        cmp  rax, 0;
        je   tmpfs_mkdir_fail;
        xor  eax, eax;             // success -> 0
        ret;
      tmpfs_mkdir_fail:
        mov  rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_rmdir_adapter(dir_vn, name_ptr, name_len) -> u64
  //   R56.M3-004 (#1793) — bridge vops surface to tmpfs_unlink.
  //
  //   tmpfs_unlink is a plain child-remove: it type-gates that the PARENT
  //   is a DIR but does not distinguish whether the TARGET is a file or a
  //   directory, and does not check emptiness.  Both semantic gates
  //   (target-is-dir, target-is-empty) are R57+ tightenings; the R56
  //   scope is limited to wiring the syscall through the vops table with
  //   fingerprint parity.
  //
  //   Returns 0 on success, VOPS_ERR_NOT_SUPPORTED on any failure.
  //   name_ptr must be NUL-terminated (tmpfs_unlink's contract); the
  //   sys_rmdir_body ensures this by splitting the caller's path
  //   in-place and NUL-terminating the basename in its kernel scratch.
  //   name_len is accepted for signature uniformity with vops_mkdir but
  //   dropped here (tmpfs_unlink uses strlen internally via tmpfs_lookup).
  // ==========================================================================
  pub let _tmpfs_rmdir_adapter : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R56.M3-004 (#1793): tmpfs rmdir adapter. Bridges vops (dir_vn, name_ptr, name_len) to tmpfs_unlink(dir_idx, name_ptr). Body: (1) Extract dir_idx from vnode.backend_ptr (+32, low 16 bits). (2) rsi = name_ptr already positioned; rdx (name_len) is accepted for signature uniformity but discarded (tmpfs_unlink walks NUL). (3) sub rsp,8 / call tmpfs_unlink / add rsp,8. (4) tmpfs_unlink returns 0 on success, 0xFFFFFFFFFFFFFFFF on failure; forward verbatim. R57+ target-is-dir + target-is-empty gates are a follow-up scoped to inode-metadata-widened rmdir semantics (empty-dir traversal + type_gate on target inode's TYPE byte at +0). Leaf-adjacent. No test; no mov_b.",
      block: {
        mov  rdi, [rdi + 32];      // load vnode.backend_ptr
        and  rdi, 0xFFFF;          // mask to dir_idx
        // rsi = name_ptr (untouched, NUL-terminated by caller).
        // rdx (name_len) discarded — tmpfs_unlink signature is 2-arg.
        sub  rsp, 8;               // SysV alignment pad
        call tmpfs_unlink;         // rax = 0 or 0xFFFFFFFFFFFFFFFF
        add  rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_rename_adapter(dir_vn, old_ptr, old_len, new_ptr, new_len) -> u64
  //   R56.M3-005 (#1794): same-directory rename via in-place inode name
  //   rewrite in the sibling chain rooted at dir.first_child.
  //
  //   vops signature: rename(dir_vn, old_ptr, old_len, new_ptr, new_len).
  //   Returns 0 on success; VOPS_ERR_NOT_SUPPORTED (0xFFFFFFFFFFFFFFFF)
  //   on any failure (name-not-found, name-too-long, non-directory).
  //
  //   The tmpfs inode name field lives at TMPFS_INODE_NAME_OFFSET (+1040)
  //   with a 96-byte cap (#2436: base was +144, shifted +896 with the
  //   page_ptrs 16 -> 128 widen; #2234: was 32 bytes; widened for 64-hex
  //   fingerprint home-dir names).  Rename is a leaf-side scan (walk siblings, byte-
  //   compare each child's name[0..96] against old, on match overwrite
  //   name[0..96] with new + zero-pad).  Cap new_len at 96 (any longer
  //   name fails; the adapter does NOT truncate silently).
  //
  //   NOTE: this adapter does NOT handle the "new_name already exists in
  //   parent" case (POSIX would unlink the target first).  For MVP this
  //   is documented as a follow-up: the sys_rename smoke landing in
  //   #1795 only exercises rename to a fresh name.
  //
  //   Register plan (5-push callee-save + sub rsp, 16 = 56;  entry rsp
  //   %16==8 + 40 + 16 = 64, %16==0 for nested calls; nested callees see
  //   %16==8 at entry per SysV):
  //     rbx = new_ptr           (survives across tmpfs_inode_slot calls)
  //     r12 = new_len (capped)
  //     r13 = old_ptr
  //     r14 = old_len (capped)
  //     r15 = cur_idx           (sibling iterator; sentinel = 0xFFFF)
  //   Frame slots ([rsp+0..+16)):
  //     [rsp+0]  = dir_inode_id
  //     [rsp+8]  = spare / alignment
  // ==========================================================================
  pub let _tmpfs_rename_adapter : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (old_ptr: u64) (old_len: u64) (new_ptr: u64) (new_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R56.M3-005 (#1794): tmpfs rename adapter. Walk the parent's sibling chain (extract dir_inode_id from vnode.backend_ptr +32 low 16 bits; load first_child from dir_inode +1140 u16), for each child load its name[0..96] and byte-compare against old_ptr[0..old_len]; on match, overwrite the child's name[0..96] with new_ptr[0..new_len] zero-padded, return 0. Not-found -> VOPS_ERR_NOT_SUPPORTED. new_len > 96 -> VOPS_ERR_NOT_SUPPORTED (adapter refuses truncation). Body: (1) 5-push callee-save prologue (rbx=new_ptr, r12=new_len, r13=old_ptr, r14=old_len, r15=cur_idx) + sub rsp,16 for two spill slots; entry rsp%16==8 + 40 + 16 = 64, %16==0. (2) Refuse new_len > 96 (#2234: was 32). (3) Extract dir_inode_id via [rdi+32] & 0xFFFF; spill to [rsp+0]. Load first_child = *(u16 @ +1140 of dir_inode via u64 @+1136 shr 32 mask 0xFFFF; #2436: was +244/+240; #2234: was +180/+176). r15 = cur_idx. (4) Outer loop: cur == 0xFFFF -> not-found. tmpfs_inode_slot(cur) -> &cur. Match check: byte-compare cur.name[0..old_len] against old[0..old_len]; also check name[old_len] == NUL (end-of-name terminator) so 'foo' does not match 'foobar'. On match, jmp overwrite. Else advance cur = cur.next_sibling (@+1138 u16 via u64 @+1136 shr 16 mask 0xFFFF; #2436: was +242/+240; #2234: was +178/+176) and continue. (5) Overwrite: byte-copy new[0..new_len] to cur.name[0..new_len], then zero-pad from cur.name[new_len..96]. Return 0. paideia-os #2436: name-field base moved +144 -> +1040 with the page_ptrs widen; every cursor derived from `+ 144` rebased to `+ 1040`. Reserved labels: tmrn_. Encoder: mov_b/mov_w proven in tmpfs/init.pdx L52-L112; shr/and idiom for u16 extraction proven in tmpfs/lookup.pdx L52-L54.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rcx;                    // rbx = new_ptr
        mov r12, r8;                     // r12 = new_len
        mov r13, rsi;                    // r13 = old_ptr
        mov r14, rdx;                    // r14 = old_len

        // (1) Refuse new_len > 96 (or 0). (#2234: was 32.)
        cmp r12, 96;
        ja  tmrn_nosup;
        cmp r12, 0;
        je  tmrn_nosup;
        cmp r14, 0;
        je  tmrn_nosup;

        // (2) Extract dir_inode_id.
        mov r10, [rdi + 32];
        and r10, 0xFFFF;
        mov [rsp + 0], r10;              // spill dir_ino

        // Load dir inode -> first_child.
        mov rdi, r10;
        call tmpfs_inode_slot;           // rax = &dir_inode
        // Type gate: must be VNODE_TYPE_DIR (2).
        xor rcx, rcx;
        mov_b rcx, [rax + 0];
        cmp rcx, 2;
        jne tmrn_nosup;
        // first_child at +1140 (u16 via u64 @+1136 shr 32 mask 0xFFFF).
        // (#2436: was +244/+240; #2234: was +180/+176.)
        mov rcx, [rax + 1136];
        shr rcx, 32;
        and rcx, 0xFFFF;
        mov r15, rcx;                    // r15 = cur_idx

      tmrn_loop:
        cmp r15, 0xFFFF;
        je  tmrn_nosup;                  // not found

        // Load current inode.
        mov rdi, r15;
        call tmpfs_inode_slot;           // rax = &cur_inode
        mov r9, rax;                     // r9 = &cur (survives compare loop)

        // Byte-compare cur.name[0..old_len] against r13[0..old_len].
        // First, load cur.name base into r10.
        // (#2436: name base moved +144 -> +1040 with page_ptrs widen.)
        mov r10, r9;
        add r10, 1040;                   // r10 = &cur.name[0]

        xor rcx, rcx;
      tmrn_cmp_top:
        cmp rcx, r14;
        jae tmrn_cmp_check_term;
        xor r8, r8;
        mov_b r8, [r10 + rcx*1];
        xor r11, r11;
        mov_b r11, [r13 + rcx*1];
        cmp r8, r11;
        jne tmrn_advance;
        add rcx, 1;
        jmp tmrn_cmp_top;

      tmrn_cmp_check_term:
        // Also require cur.name[old_len] == NUL (or old_len == 96). (#2234: was 32.)
        cmp r14, 96;
        jae tmrn_match;
        xor r8, r8;
        mov_b r8, [r10 + r14*1];
        cmp r8, 0;
        jne tmrn_advance;

      tmrn_match:
        // Overwrite cur.name[0..new_len] with new[0..new_len].
        //   r10 = &cur.name[0]; r12 = new_len (already capped <= 96). (#2234: was 32.)
        xor rcx, rcx;
      tmrn_wr_top:
        cmp rcx, r12;
        jae tmrn_wr_done;
        xor r8, r8;
        mov_b r8, [rbx + rcx*1];
        mov_b [r10 + rcx*1], r8;
        add rcx, 1;
        jmp tmrn_wr_top;
      tmrn_wr_done:

        // Zero-pad name[new_len..96]. (#2234: was 32.)
        xor r8, r8;
      tmrn_pad_top:
        cmp rcx, 96;
        jae tmrn_pad_done;
        mov_b [r10 + rcx*1], r8;
        add rcx, 1;
        jmp tmrn_pad_top;
      tmrn_pad_done:

        // Success.
        xor rax, rax;
        jmp tmrn_ret;

      tmrn_advance:
        // Load next_sibling (@+1138 u16 via u64 @+1136 shr 16 mask 0xFFFF).
        // (#2436: was +242/+240; #2234: was +178/+176.)
        mov rcx, [r9 + 1136];
        shr rcx, 16;
        and rcx, 0xFFFF;
        mov r15, rcx;
        jmp tmrn_loop;

      tmrn_nosup:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      tmrn_ret:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_symlink_adapter(dir_vn, name_ptr, name_len, target_ptr, target_len) -> u64
  //   Wave λ (λ-04): create a new symlink inode inside the given parent.
  //
  //   Sequence:
  //     (1) Extract dir_idx from vnode.backend_ptr (+32, low 16 bits).
  //     (2) Cap name_len at 96 (TMPFS_INODE_NAME_MAX); cap target_len at
  //         256 (TMPFS_SYMLINK_TARGET_MAX-1 to leave room for a NUL byte
  //         at the pool slot's tail; the target is stored as raw bytes,
  //         not NUL-terminated at read time — the length in inode.size is
  //         authoritative).
  //     (3) Call tmpfs_create(dir_idx, name_ptr, name_len, type=LNK=3)
  //         → rax = new_idx (non-zero) or 0 on failure (collision, OOM,
  //         parent-not-dir).  0 → VOPS_ERR_NOT_SUPPORTED.
  //     (4) Compute &_tmpfs_symlink_pool[new_idx*256] via
  //         _tmpfs_symlink_slot; byte-copy target[0..target_len].
  //     (5) Write inode.size = target_len at &new_inode + 8
  //         (TMPFS_INODE_SIZE_OFFSET).  Also overwrite inode.type = 3
  //         (LNK) defensively — tmpfs_create already stored our type
  //         arg, but the belt-and-braces store costs one instruction and
  //         guarantees the readlink adapter's type-gate later.
  //     (6) Return 0.
  //
  //   Register plan (5-push callee-save; entry rsp%16==8 + 40 = %16==0
  //   at nested call sites, which is exactly what SysV requires):
  //     rbx = target_ptr     (survives across nested calls)
  //     r12 = target_len (capped)
  //     r13 = name_ptr (positioned into rsi at tmpfs_create call)
  //     r14 = name_len (capped, positioned into rdx)
  //     r15 = new_idx (result of tmpfs_create; consumed at step 4 + 5)
  // ==========================================================================
  pub let _tmpfs_symlink_adapter : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (name_len: u64) (target_ptr: u64) (target_len: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Wave λ (λ-04): tmpfs symlink adapter. Bridges vops (dir_vn, name_ptr, name_len, target_ptr, target_len) surface to tmpfs_create(dir_idx, name_ptr, name_len, type=LNK=3) followed by a target-string copy into the _tmpfs_symlink_pool side table indexed by the new inode idx and a size store into inode.size. 5-push callee-save prologue (rbx=target_ptr, r12=capped target_len, r13=name_ptr, r14=capped name_len, r15=new_idx) leaves rsp%16==0 (entry %16==8 - 40 = %16==0) which is SysV-correct at nested call sites (matches sys_stat_body's own 5-push discipline). Body: (1) Extract dir_idx from vnode.backend_ptr (+32, low 16 bits). (2) Cap name_len at 96; cap target_len at 255 (leaves the pool slot's final byte as an implicit NUL sentinel). Refuse target_len == 0 (a zero-length target has no meaning) → VOPS_ERR_NOT_SUPPORTED. (3) Call tmpfs_create(dir_idx, name_ptr, name_len, type=3=LNK). Non-zero rax = new_idx on success; 0 = parent-not-dir / collision / OOM → VOPS_ERR_NOT_SUPPORTED. (4) Compute &_tmpfs_symlink_pool[new_idx*256] via _tmpfs_symlink_slot; byte-copy target[0..target_len] into the pool slot. (5) Compute &new_inode via tmpfs_inode_slot(new_idx); store target_len into [&inode + 8] (TMPFS_INODE_SIZE_OFFSET). (6) Return 0. Reserved labels: tfsslnk_. No test; no mov_b for the type store (using a full mov to inode.size which is u64 at +8). The byte-copy loop uses mov_b at r10+rcx*1 addressing (proven in tmpfs/init.pdx L52-L112 and _tmpfs_readdir_adapter's own copy loop above).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rcx;                        // rbx = target_ptr
        mov r12, r8;                         // r12 = target_len
        mov r13, rsi;                        // r13 = name_ptr
        mov r14, rdx;                        // r14 = name_len

        // ---- (2) Caps + refusal gate ----
        //   name_len cap 96
        mov rax, 96;
        cmp r14, rax;
        jbe tfsslnk_name_ok;
        mov r14, rax;
      tfsslnk_name_ok:
        //   target_len cap 255 (leave last byte of pool slot as NUL sentinel)
        mov rax, 255;
        cmp r12, rax;
        jbe tfsslnk_tgt_ok;
        mov r12, rax;
      tfsslnk_tgt_ok:
        //   Refuse zero-length target
        cmp r12, 0;
        je  tfsslnk_nosup;

        // ---- (1) Extract dir_idx and call tmpfs_create ----
        mov rax, [rdi + 32];
        and rax, 0xFFFF;                     // rax = dir_idx

        // tmpfs_create(dir_idx, name_ptr, name_len, type=3)
        mov rdi, rax;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, 3;                          // TMPFS_SYMLINK_TYPE = 3 (LNK)
        call tmpfs_create;                   // rax = new_idx or 0
        cmp rax, 0;
        je  tfsslnk_nosup;
        mov r15, rax;                        // r15 = new_idx

        // ---- (4) Copy target into _tmpfs_symlink_pool[new_idx*256] ----
        mov rdi, r15;
        call _tmpfs_symlink_slot;            // rax = &pool[new_idx]
        // Byte-copy target[0..r12] into rax[0..r12].
        //   r10 = &pool slot (dst)
        //   r11 = &target (src) — reuse rbx-content directly via a load
        //   rcx = i
        //   r8  = byte
        mov r10, rax;
        mov r11, rbx;
        xor rcx, rcx;
      tfsslnk_copy:
        cmp rcx, r12;
        jae tfsslnk_copy_done;
        xor r8, r8;
        mov_b r8, [r11 + rcx*1];
        mov_b [r10 + rcx*1], r8;
        add rcx, 1;
        jmp tfsslnk_copy;
      tfsslnk_copy_done:

        // ---- (5) inode.size = target_len (u64 store @+8) ----
        mov rdi, r15;
        call tmpfs_inode_slot;               // rax = &new_inode
        mov [rax + 8], r12;                  // TMPFS_INODE_SIZE_OFFSET = 8

        // Also stamp inode.type = 3 (LNK) defensively (mov_b @+0).
        mov r8, 3;
        mov_b [rax + 0], r8;                 // TMPFS_INODE_TYPE_OFFSET = 0

        // ---- (6) Success return ----
        xor rax, rax;
        jmp tfsslnk_ret;

      tfsslnk_nosup:
        mov rax, 0xFFFFFFFFFFFFFFFF;

      tfsslnk_ret:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _tmpfs_readlink_adapter(vn, buf, bufsize) -> u64
  //   Wave λ (λ-04): read the target string of a tmpfs symlink inode.
  //
  //   Sequence:
  //     (1) Extract inode_idx from vnode.backend_ptr (+32, low 16 bits).
  //     (2) Load &inode via tmpfs_inode_slot; type-gate on inode.type == 3
  //         (LNK).  Non-symlink → return 0xFFFFFFFFFFFFFFEA (-EINVAL sign
  //         convention: 22).  Actually paideia-os uses -22 = 0xFFFFFFFFFFFFFFEA.
  //     (3) Load target_len from inode.size (u64 @+8).  Cap at min(len,
  //         bufsize).
  //     (4) Compute &_tmpfs_symlink_pool[idx*256] via _tmpfs_symlink_slot.
  //     (5) Byte-copy pool[0..cap] into buf[0..cap].
  //     (6) Return cap (byte count written; caller sees non-zero as
  //         success and interprets the negative-errno sentinel via sign
  //         test).
  //
  //   Register plan (4-push callee-save + sub rsp,8 alignment pad; entry
  //   rsp%16==8 + 32 + 8 = 48 → %16==0 at nested call sites):
  //     rbx = buf              (survives across nested calls)
  //     r12 = bufsize
  //     r13 = inode_idx
  //     r14 = capped_len       (min(target_len, bufsize); consumed post-copy)
  // ==========================================================================
  pub let _tmpfs_readlink_adapter : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (vn: u64) (buf: u64) (bufsize: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Wave λ (λ-04): tmpfs readlink adapter. Bridges vops (vn, buf, bufsize) surface to tmpfs_inode_slot + type-gate + side-pool byte-copy. 4-push callee-save prologue (rbx=buf, r12=bufsize, r13=inode_idx, r14=capped_len) + sub rsp,8 alignment pad leaves rsp%16==0 (entry %16==8 + 32 + 8 = 48, %16==0) at nested call sites. Body: (1) Extract inode_idx from vnode.backend_ptr (+32, low 16 bits, tmpfs adapter idiom). (2) tmpfs_inode_slot(inode_idx) → &inode. Type-gate: inode.type (u8 @+0) must == 3 (TMPFS_SYMLINK_TYPE=LNK); mismatch → -EINVAL (0xFFFFFFFFFFFFFFEA, -22). (3) Load target_len from inode.size (u64 @+8); cap at min(len, bufsize). (4) _tmpfs_symlink_slot(inode_idx) → &pool[idx*256]. (5) Byte-copy loop pool[0..cap] → buf[0..cap] (mov_b with xor r8 zero-extend, proven idiom). (6) Return capped_len (byte count). Non-negative value == success; caller sign-tests the return to distinguish. Reserved labels: tfsrdlnk_. No test; mov_b for both the type-gate byte load and the copy-loop bytes.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rsi;                        // rbx = buf
        mov r12, rdx;                        // r12 = bufsize

        // ---- (1) Extract inode_idx from vnode.backend_ptr ----
        mov rax, [rdi + 32];
        and rax, 0xFFFF;
        mov r13, rax;

        // ---- (2) &inode + type-gate ----
        mov rdi, r13;
        call tmpfs_inode_slot;               // rax = &inode
        xor r8, r8;
        mov_b r8, [rax + 0];                 // inode.type
        cmp r8, 3;                           // TMPFS_SYMLINK_TYPE
        jne tfsrdlnk_einval;

        // ---- (3) capped_len = min(inode.size, bufsize) ----
        mov r14, [rax + 8];                  // TMPFS_INODE_SIZE_OFFSET
        cmp r14, r12;
        jbe tfsrdlnk_size_ok;
        mov r14, r12;
      tfsrdlnk_size_ok:

        // ---- (4) &pool slot ----
        mov rdi, r13;
        call _tmpfs_symlink_slot;            // rax = &pool[idx]

        // ---- (5) Byte-copy loop ----
        //   r10 = &pool (src); rbx = buf (dst); rcx = i; r8 = byte
        mov r10, rax;
        xor rcx, rcx;
      tfsrdlnk_copy:
        cmp rcx, r14;
        jae tfsrdlnk_copy_done;
        xor r8, r8;
        mov_b r8, [r10 + rcx*1];
        mov_b [rbx + rcx*1], r8;
        add rcx, 1;
        jmp tfsrdlnk_copy;
      tfsrdlnk_copy_done:

        // ---- (6) Return byte count ----
        mov rax, r14;
        jmp tfsrdlnk_ret;

      tfsrdlnk_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;         // -EINVAL (-22)

      tfsrdlnk_ret:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tmpfs_vops_init() -> u64 — populate _tmpfs_vops table
  // ==========================================================================
  // Boot-time populator. Called once from kernel_main before any consumer
  // of _tmpfs_vops exists. Idempotent (safe to call twice).
  //
  // Register discipline: leaf function, no callee-save. Uses rax (scratch),
  // r8 (base address). Returns 0 (via xor eax, eax).
  pub let tmpfs_vops_init : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R16-M2-008 (#586): Populator for _tmpfs_vops table. Computes base address via lea rip+_tmpfs_vops, then stores each adapter/stub pointer at its offset using proven idioms (lea rip+sym; mov [reg+disp],reg) per vnode_pool.pdx and tmpfs/inode.pdx. Offset immediates are frozen by #572 §4: VOPS_READ_OFFSET=0, VOPS_WRITE_OFFSET=8, VOPS_OPEN_OFFSET=16, VOPS_CLOSE_OFFSET=24, VOPS_LOOKUP_OFFSET=32, VOPS_CREATE_OFFSET=40, VOPS_UNLINK_OFFSET=48. 16 instructions (7×2 for lea+mov, plus lea r8, xor eax, ret). Leaf; no callee-save touched.",
      block: {
        lea  r8, [rip + _tmpfs_vops];      // r8 = &_tmpfs_vops

        lea  rax, [rip + _tmpfs_read_adapter];
        mov  [r8 + 0], rax;                 // slot +0 = VOPS_READ_OFFSET

        lea  rax, [rip + _tmpfs_write_adapter];
        mov  [r8 + 8], rax;                 // slot +8 = VOPS_WRITE_OFFSET

        lea  rax, [rip + _tmpfs_open_stub];
        mov  [r8 + 16], rax;                // slot +16 = VOPS_OPEN_OFFSET

        lea  rax, [rip + _tmpfs_close_stub];
        mov  [r8 + 24], rax;                // slot +24 = VOPS_CLOSE_OFFSET

        lea  rax, [rip + _tmpfs_lookup_adapter];
        mov  [r8 + 32], rax;                // slot +32 = VOPS_LOOKUP_OFFSET

        lea  rax, [rip + _tmpfs_create_adapter];
        mov  [r8 + 40], rax;                // slot +40 = VOPS_CREATE_OFFSET

        lea  rax, [rip + _tmpfs_unlink_adapter];
        mov  [r8 + 48], rax;                // slot +48 = VOPS_UNLINK_OFFSET

        // R56.M3-002 (#1791): populate stat slot at +56.
        lea  rax, [rip + _tmpfs_stat_adapter];
        mov  [r8 + 56], rax;                // slot +56 = VOPS_STAT_OFFSET

        // R56.M3-003 (#1792): populate readdir slot at +64.
        lea  rax, [rip + _tmpfs_readdir_adapter];
        mov  [r8 + 64], rax;                // slot +64 = VOPS_READDIR_OFFSET

        // R56.M3-004 (#1793): populate mkdir slot at +72.
        lea  rax, [rip + _tmpfs_mkdir_adapter];
        mov  [r8 + 72], rax;                // slot +72 = VOPS_MKDIR_OFFSET

        // R56.M3-004 (#1793): populate rmdir slot at +80.
        lea  rax, [rip + _tmpfs_rmdir_adapter];
        mov  [r8 + 80], rax;                // slot +80 = VOPS_RMDIR_OFFSET

        // R56.M3-005 (#1794): populate rename slot at +88.
        lea  rax, [rip + _tmpfs_rename_adapter];
        mov  [r8 + 88], rax;                // slot +88 = VOPS_RENAME_OFFSET

        // Wave λ (λ-04): populate readlink slot at +96.
        lea  rax, [rip + _tmpfs_readlink_adapter];
        mov  [r8 + 96], rax;                // slot +96 = VOPS_READLINK_OFFSET

        // Wave λ (λ-04): populate symlink slot at +104.
        lea  rax, [rip + _tmpfs_symlink_adapter];
        mov  [r8 + 104], rax;               // slot +104 = VOPS_SYMLINK_OFFSET

        xor  eax, eax;
        ret
      }
    }
}
