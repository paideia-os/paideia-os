// src/kernel/core/fs/tmpfs/inode.pdx — R16-M2-001 (#579)
// Static tmpfs inode slab + bitmap allocator.
//
// Original R16-M2-001 shape: 64 slots (TMPFS_MAX=64), single-word bitmap,
// 16 KiB pool.  Widened at paideia-os #2004 to 256 slots (TMPFS_MAX=256),
// four-word bitmap, 64 KiB pool — matches the vnode_pool sizing convention
// (VNODE_MAX=256, VNODE_BITMAP_WORDS=4) after boot-seed inventory growth
// (16 /bin binaries + /share/doc + /pkgs + /system/{packages,keys,trash} +
// /journal/pkg + rootfs_seed's per-file entries + boot self-test witness
// allocations) exhausted the 64-slot pool near boot and left ring-3
// mkdir /home silently failing.  Bit 0 is pre-set on word 0 at load time
// so slot 0 (the reserved "invalid inode" sentinel) is never handed out.
//
// See design/kernel/r16-m2-001-tmpfs-inode-pool.md for the frozen 256-byte
// inode layout (unchanged by the widening).
//
// paideia-os #2234 (R106 blocker): TMPFS_INODE_NAME_MAX widened 32 -> 96.
// R106's persistent-home mount names directories "/home/<64-hex-fingerprint>/"
// — a 64-hex fingerprint plus NUL terminator requires >= 65 bytes, which
// blew past the old 32-byte name field and truncated the mount name. 96
// gives 64 hex + NUL + a 31-byte margin for future path-component growth.
// The name field still starts at TMPFS_INODE_NAME_OFFSET=144; growing it to
// 96 bytes (144..240) shifts the packed parent/next_sibling/first_child u64
// from +176 to +240, consuming 64 of the 72 bytes that were previously
// unused inode padding. TMPFS_INODE_SIZE stays 256 — no pool/row size
// constant changes.

module Inode = structure {
  // === Layout constants (pinned by design/kernel/r16-m2-001-tmpfs-inode-pool.md) ===
  pub let TMPFS_INODE_SIZE         : u64 = 256         // MUST equal sizeof(struct tmpfs_inode)
  pub let TMPFS_INODE_ALIGN        : u64 = 64          // cache-line boundary
  pub let TMPFS_MAX                : u64 = 256         // pool slot count (paideia-os #2004)
  pub let TMPFS_INODE_POOL_BYTES   : u64 = 65536       // TMPFS_MAX * TMPFS_INODE_SIZE
  pub let TMPFS_INODE_BITMAP_WORDS : u64 = 4           // TMPFS_MAX / 64
  pub let TMPFS_INODE_IDX_ROOT     : u64 = 1
  pub let TMPFS_INODE_IDX_NONE     : u64 = 0xFFFF
  pub let TMPFS_INODE_ALLOC_OOM    : u64 = 0xFFFF
  // paideia-os #2234 (R106): was 32; a 64-hex fingerprint name plus NUL
  // needs >= 65 bytes. 96 = 64 hex + NUL + 31-byte margin.
  pub let TMPFS_INODE_NAME_MAX     : u64 = 96

  // === Field offsets — hot half (first 3 lines: [0, 192)) ===
  pub let TMPFS_INODE_TYPE_OFFSET       : u64 = 0
  pub let TMPFS_INODE_FLAGS_OFFSET      : u64 = 1
  pub let TMPFS_INODE_REFCOUNT_OFFSET   : u64 = 2
  pub let TMPFS_INODE_LINK_COUNT_OFFSET : u64 = 4
  pub let TMPFS_INODE_SIZE_OFFSET       : u64 = 8
  pub let TMPFS_INODE_PAGES_OFFSET      : u64 = 16     // page_ptrs[16] base
  pub let TMPFS_INODE_NAME_OFFSET       : u64 = 144    // name[96] base (#2234: was name[32])
  // paideia-os #2234: shifted 176/178/180 -> 240/242/244 (+64) because the
  // name field grew from 32 to 96 bytes (144 + 96 = 240, still 8-aligned).
  pub let TMPFS_INODE_PARENT_OFFSET     : u64 = 240
  pub let TMPFS_INODE_NEXT_SIB_OFFSET   : u64 = 242
  pub let TMPFS_INODE_FIRST_CHILD_OFFSET: u64 = 244

  // === Local flag bits ===
  pub let TMPFS_INODE_FLAG_VALID    : u8  = 0x01

  // === Storage (.bss slab + .data bitmap) ===
  // 8192 u64 = 65536 B = 256 x 256 B. @align(64) puts each slot on its own
  // cache-line boundary (four L1D lines per 256-byte inode).
  pub let mut _tmpfs_inode_pool   : [u64; 8192] = uninit @align(64)

  // 4 x u64 = 256 bits. Bit 0 of word 0 pre-set so tmpfs_inode_alloc never
  // returns slot 0 (the reserved "invalid inode" sentinel per R16-M2-001).
  pub let mut _tmpfs_inode_bitmap : [u64; 4] = [1, 0, 0, 0]

  // ==========================================================================
  // tmpfs_inode_slot(idx: u64) -> u64 — index -> pointer helper
  // ==========================================================================
  pub let tmpfs_inode_slot : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R16-M2-001 (#579): Compute &_tmpfs_inode_pool[idx*256]. SIB scale is limited to 1/2/4/8 so *256 requires an explicit shl 8 + add (three-instruction body, not one). No bounds check by policy — caller has already validated idx via a tmpfs_inode_alloc round-trip or a #570 SS7.3-pinned index field. Unchanged by the paideia-os #2004 TMPFS_MAX=256 widening (the pool is contiguous; only the base pointer + slot stride matters here).",
      block: {
        lea rax, [rip + _tmpfs_inode_pool];
        shl rdi, 8;                         // idx * 256
        add rax, rdi;
        ret
      }
    }

  // ==========================================================================
  // tmpfs_inode_alloc() -> u64 — low-first multi-word bitmap scan (leaf)
  // ==========================================================================
  // paideia-os #2004 rewrite: was a single-word scan (TMPFS_MAX=64); now
  // scans TMPFS_BITMAP_WORDS=4 words low-to-high (matches vnode_alloc's
  // R16-M1-002 shape byte-for-byte, only VNODE_MAX -> TMPFS_MAX and the
  // pool/bitmap symbol names differ).  Bit 0 is pre-set by the static
  // initializer; bsf on ~word preserves the slot-0 sentinel.  Leaf function
  // — no callee-save prologue, trashes caller-saved regs only.
  pub let tmpfs_inode_alloc : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {},
      justification: "paideia-os #2004 + R90-XREPO.010.M1-005 (#2113) fault-inject hook: multi-word bitmap scan for TMPFS_MAX=256. Fault-inject hook at entry: `sub rsp, 8` aligns rsp%16 == 0 from entry rsp%16 == 8 SysV, then `mov rdi, 2 (FAULT_CLASS_INODE_ALLOC_FAIL); call pdxfs_fault_check_and_consume; add rsp, 8; cmp rax, 0; jne tmpfs_inode_alloc_inject` -- on injection, return TMPFS_INODE_ALLOC_OOM (0xFFFF) byte-identical to real pool exhaustion, bitmap byte-identical to entry (no bit consumed).  Effects widened from {mem} to {mem, sysreg} because pdxfs_fault_check_and_consume's klog_s1_d1 emit reads the TSC (matches every other klog-emitting fs/* body's widening rationale).  Non-injection path unchanged from #2004: scan _tmpfs_inode_bitmap words 0..3 low-to-high. For each word, load it, complement via xor word, 0xFFFFFFFFFFFFFFFF (round-trips through the imm8 -1 form; NOT is not a resolvable mnemonic per vnode_alloc.pdx L108's own note), then cmp 0 to detect an all-ones (fully-allocated) word — skip via cmp/je in place of unavailable `test`. bsf_q finds the first free (1) bit in the complemented word. idx = word*64 + bit; range-check idx < TMPFS_MAX=256 (belt-and-braces vs. a future TMPFS_MAX change not a multiple of 64); bts_q sets the bit directly in the register form; store the word back; return idx. On exhaustion return TMPFS_INODE_ALLOC_OOM=0xFFFF in the low 16 bits (upper 48 bits zero — safe against `cmp rax, 0xFFFF` at every call site, matches vnode_alloc's sentinel shape). Non-leaf now (pdxfs_fault_check_and_consume is a nested call); still no prologue -- the alignment pad is a single `sub rsp, 8` + matching `add rsp, 8` bracketing the call. All mnemonics proven by vnode_pool.pdx + pdxfs/fault_inject.pdx.",
      block: {
        // ==== Fault-inject hook: FAULT_CLASS_INODE_ALLOC_FAIL ====
        sub rsp, 8;                         // align rsp%16 == 0 for nested call
        mov rdi, 2;                         // FAULT_CLASS_INODE_ALLOC_FAIL
        call pdxfs_fault_check_and_consume;
        add rsp, 8;
        cmp rax, 0;
        jne tmpfs_inode_alloc_inject;

        lea r8, [rip + _tmpfs_inode_bitmap];
        xor rcx, rcx;                       // rcx = word index, 0..3

      tmpfs_inode_alloc_scan:
        cmp rcx, 4;                         // TMPFS_INODE_BITMAP_WORDS
        jae tmpfs_inode_alloc_oom;

        mov r9, [r8 + rcx*8];               // r9 = bitmap[word]
        mov r10, r9;
        xor r10, 0xFFFFFFFFFFFFFFFF;        // r10 = ~word (free bits = 1)
        cmp r10, 0;                         // test unavailable — cmp/je in its place
        je  tmpfs_inode_alloc_next;         // word entirely allocated

        bsf_q rdx, r10;                     // rdx = first free bit in word

        // idx = word*64 + bit
        mov rax, rcx;
        shl rax, 6;
        add rax, rdx;
        cmp rax, 256;                       // TMPFS_MAX
        jae tmpfs_inode_alloc_oom;          // past valid range (last-word tail)

        bts_q r9, rdx;                      // set bit rdx in r9 (register form)
        mov [r8 + rcx*8], r9;               // store word back
        ret;                                // rax holds idx

      tmpfs_inode_alloc_next:
        add rcx, 1;
        jmp tmpfs_inode_alloc_scan;

      tmpfs_inode_alloc_oom:
        mov rax, 0xFFFF;                    // TMPFS_INODE_ALLOC_OOM
        ret;

      tmpfs_inode_alloc_inject:
        // Fault-inject synthetic OOM path -- byte-identical to a real
        // pool-exhaustion refusal (no bitmap bit consumed).  See
        // src/kernel/core/fs/pdxfs/fault_inject.pdx §Single-shot for
        // why the arm is already consumed by the check_and_consume
        // call above (so a caller that retries hits the real allocator
        // path on the next invocation).
        mov rax, 0xFFFF;                    // TMPFS_INODE_ALLOC_OOM
        ret
      }
    }

  // ==========================================================================
  // tmpfs_inode_free(idx: u64) -> u64 — bitmap-clear + slot-zero (leaf)
  // ==========================================================================
  // paideia-os #2004 rewrite: was a single-word bitmap clear (TMPFS_MAX=64);
  // now splits idx into (word, bit) = (idx >> 6, idx & 63) so the correct
  // word of the 4-word bitmap is cleared.  Slot-payload zeroing shape is
  // unchanged (rep_stosq, 32 qwords per slot).
  pub let tmpfs_inode_free : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "paideia-os #2004: multi-word bitmap clear + 256-byte slot payload zero for TMPFS_MAX=256. Compute word/bit split via shr 6 / and 63 (matches vnode_free's R16-M1-002 shape); btr_q clears the bit in-register; store the word back. Slot payload zero via rep_stosq (count = 32 qwords, unchanged from the pre-widening body). Leaf function — no callee-save prologue; rax/rcx/rdi/r8/r9/r10 all caller-saved per SysV AMD64. Splits into two disjoint memory regions (bitmap word + slot payload); ordering (bit-clear then zero, or reverse) is observably identical under single-writer R16.M2. Under R17 concurrency, bit-clear-first would let a concurrent tmpfs_inode_alloc race the same slot — but tmpfs_inode_alloc is called only from tmpfs_create under the future FS lock, so no race window opens. Implementation chooses zero-first for defensive symmetry with vnode_free (#571). Frame prologue implicit under src/kernel/** — the frame-elision keyword is deliberately not used here per the kernel-wide discipline.",
      block: {
        // ====== Save idx (rdi) into r10 before rep_stosq clobbers rdi ======
        mov  r10, rdi;                      // r10 = idx (survives rep_stosq)

        // ====== Compute slot address ======
        lea  r8, [rip + _tmpfs_inode_pool];
        mov  r9, rdi;
        shl  r9, 8;                         // idx * 256
        add  r8, r9;                        // r8 = &_tmpfs_inode_pool[idx]

        // ====== Zero via rep_stosq (dst=rdi, count=rcx, fill=rax) ======
        mov  rdi, r8;
        mov  rcx, 32;                       // 256/8 qwords
        xor  eax, eax;                      // fill = 0 (rax = 0 also becomes return)
        cld;
        rep_stosq;

        // ====== Clear bit idx (in r10) from the 4-word bitmap ======
        // word_idx = idx >> 6; bit_within_word = idx & 63.
        mov  rax, r10;
        shr  rax, 6;                        // rax = word index (idx / 64)
        mov  rcx, r10;
        and  rcx, 63;                       // rcx = bit within word

        lea  r8, [rip + _tmpfs_inode_bitmap];
        mov  r9, [r8 + rax*8];
        btr_q r9, rcx;                      // clear bit rcx in r9
        mov  [r8 + rax*8], r9;

        // ====== Return 0 ======
        xor  rax, rax;
        ret
      }
    }

  // ==========================================================================
  // tmpfs_inode_alloc_count() -> u64 — allocated-slot count (leaf)
  // ==========================================================================
  // paideia-os #2004 diagnostic: sums popcnt across all four bitmap words
  // and subtracts 1 for the pre-set slot-0 sentinel bit (so the return is
  // the number of user-visible allocated inodes at the moment of the call).
  // Kernighan-style bit counting is used in place of the popcnt mnemonic
  // (matches phys_alloc_free_count's precedent — popcnt requires SSE4.2 /
  // QEMU -cpu max, which every mode in the tree already uses but the
  // fallback is simpler than adding a new encoder dependency).
  //
  // Read-only: no {mem} effect (matches phys_alloc_free_count's declaration
  // — the loads through the bitmap are observation, not mutation).
  pub let tmpfs_inode_alloc_count : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {},
      capabilities: {},
      justification: "paideia-os #2004: sum (popcnt(word)) across all four _tmpfs_inode_bitmap words, then subtract 1 for the pre-set slot-0 sentinel bit. Kernighan-style bit counting inside a per-word loop, matching phys_alloc_free_count's algorithm (core/mm/phys_alloc.pdx L147 — popcnt fallback, no SSE4.2 dependency). Read-only observation of the bitmap; no {mem} effect. Leaf function — no callee-save prologue; rax/rcx/rdx/r8/r9/r10/r11 all caller-saved per SysV AMD64.",
      block: {
        lea rax, [rip + _tmpfs_inode_bitmap];
        xor rcx, rcx;                       // rcx = running total of set bits
        xor rdx, rdx;                       // rdx = word index

      tmpfs_inode_count_word_loop:
        cmp rdx, 4;                         // TMPFS_INODE_BITMAP_WORDS
        jae tmpfs_inode_count_done;
        mov r9, [rax + rdx * 8];            // r9 = bitmap[word]

        // Kernighan bit-count over r9 into r10.
        xor r10, r10;
      tmpfs_inode_count_bit_loop:
        cmp r9, 0;
        je  tmpfs_inode_count_bit_done;
        mov r11, r9;
        sub r11, 1;
        and r9, r11;                        // r9 &= (r9 - 1) — clears lowest set bit
        add r10, 1;
        jmp tmpfs_inode_count_bit_loop;
      tmpfs_inode_count_bit_done:

        add rcx, r10;
        add rdx, 1;
        jmp tmpfs_inode_count_word_loop;

      tmpfs_inode_count_done:
        // User-visible count = total_set - 1 (subtract the slot-0 sentinel).
        mov rax, rcx;
        sub rax, 1;
        ret
      }
    }
}
