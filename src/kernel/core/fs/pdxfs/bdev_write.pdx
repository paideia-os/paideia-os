// src/kernel/core/fs/pdxfs/bdev_write.pdx -- R42.M5-001 (#1396)
// Renamed from nvme_write.pdx -- R51.M7-005 (#1673)
// R54.M1-002 (#1779): nvw_batch_flush real submit path over nvme_write_blocking
//
// PDXFS v1 -- NVMe WRITE PATH INTEGRATION.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on how a PdxFS v1 block write leaves the CoW
// walker and reaches the NVMe kernel driver: every logical write from
// cow_write.pdx / refcount.pdx / wal.pdx that must land on device
// crosses THIS module, so no caller can hand-roll a submission that
// bypasses the WAL fsync + refcount gates the sibling modules maintain.
//
// It is a SCAFFOLD (D7) THAT NOW OWNS A REAL SUBMIT PATH (R54.M1-002 /
// #1779). Submission Queue entries are accumulated in a small BSS ring
// by nvw_submit as before. A batch is "flushed" by nvw_batch_flush,
// which now branches on whether a live NVMe IO SQ pair exists
// (_nvme_io_queue_count > 0):
//
//   - LIVE PATH: for each PENDING entry, calls nvme_write_blocking(nsid=1,
//     lba, count=1, buf_pa=&_nvw_flush_scratch) directly (drivers/nvme/
//     sync.pdx, R54.M1-001 / #1778). Marks entry SUBMITTED only when the
//     call returns status == 0. Status non-zero leaves the entry PENDING
//     and does not bump submitted_count for it (a subsequent flush will
//     retry).
//
//   - SUBSTRATE PATH (_nvme_io_queue_count == 0, every QEMU-TCG -kernel
//     boot mode: MCFG absent -> _pci_device_count == 0 -> _nvme_device_
//     count == 0 even with `-device nvme` per drivers/nvme/probe.pdx's
//     drain-empty guard): preserves the pre-R54.M1-002 scaffold
//     behavior (mark PENDING -> SUBMITTED without calling the driver)
//     so existing witnesses (nvme_write_synth, concurrent_stress_synth,
//     durability tests) that run in substrate posture stay green.
//     Calling nvme_write_blocking in substrate mode would stage a DMA
//     into a zero sq_pa (a boot-critical page hazard) per the R54.M1-
//     001 witness header's own guard rationale.
//
// Completions are still modelled by a per-cid ack (nvw_completion) that
// moves entries out of the submitted band into the completed band. A
// widening will replace this with the driver interrupt handler that
// reads the CQE, freeing the cid; that widening also lands
// caller-supplied buf_pa into the entry format (extending
// NVW_ENTRY_WORDS from 4 to a wider stride) so the LIVE PATH stops
// using _nvw_flush_scratch as a stand-in source page.
//
// It DOES NOT own the NVMe driver. The driver interface exists per
// #906; this module carries the FS-side batching + accounting so a
// widening's swap-in of the actual doorbell write and the actual
// interrupt-driven CQE walk touches ONE line in nvw_batch_flush and
// ONE line in nvw_completion respectively.
//
// It DOES NOT own the WAL invariant. wal.pdx is the authority on
// write-ahead ordering; a caller that submits a block write here
// before the corresponding record is fsynced through wal_fsync is a
// caller that will (once the driver is real) tear on a crash. That
// invariant is enforced at THE CALL SITE (cow_write's write pass)
// rather than duplicated here: this module is the plumbing, wal.pdx
// is the discipline.
//
// It DOES NOT own durability policy. durability.pdx (#1397) is the
// authority on the FLUSH-and-fence sequence a caller executes when it
// wants ordered persistence; this module's nvw_completion is the
// atomic that a FLUSH-wait spins on.
//
// =============================================================================
// §1  QUEUE GEOMETRY
// =============================================================================
//
// NVW_SQ_DEPTH        = 64      max pending + submitted entries
// NVW_ENTRY_WORDS     = 4       per-entry footprint in u64s
//
// _nvw_sq is a flat [u64; NVW_SQ_DEPTH * NVW_ENTRY_WORDS]. Entry(i)
// starts at _nvw_sq[i * 4]:
//
//   +0    cid              command id (>= 1); 0 = free slot
//   +8    lba              linear block address the write targets
//   +16   len              payload length in bytes (>= 1)
//   +24   status           0 = pending, 1 = submitted, 2 = completed
//
// batch_head is the next-write index for nvw_submit (also the
// pending count until nvw_batch_flush moves them). A batch_flush
// walks [0..batch_head), stamps status = 1 (submitted), records the
// number in submitted_count, and leaves batch_head untouched (the
// entries stay in the SQ until completion frees them).
//
// A widening will replace the flat status field with the real NVMe
// CQE phase-tag protocol; the FS-side plumbing here uses the
// simplest possible watermark scheme so the semantic (pending ->
// submitted -> completed) is expressible without a driver.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _nvw_sq and _nvw_state are written only by helpers in this module.
// tools/build.sh confines relocations against each to
// `core/fs/pdxfs/bdev_write.o`. A second writer would let a caller
// "submit a block write to the driver without recording the CoW
// walker's guard" or "acknowledge a completion for a cid the walker
// never submitted", either of which would let the block-layout
// bookkeeping drift out of sync with what the device actually holds.
//
// STATE LAYOUT -- _nvw_state : [u64; 8]
//   +0    init_mark          0xF11E once nvw_reset has run
//   +8    err                sticky error latch (first-writer-wins)
//   +16   batch_head         next-write index into the SQ (pending count)
//   +24   next_cid           next command id nvw_submit will hand out
//   +32   submit_count       total nvw_submit calls that succeeded
//   +40   flush_count        total nvw_batch_flush calls that moved entries
//   +48   flushed_total      cumulative entries moved pending -> submitted
//   +56   completion_count   total nvw_completion calls that succeeded
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEF00..0xFFFFEF0F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: fs_channel 0xFFFFEF10..1F (R42.M4-004, sibling).
// Adjacent free band below: durability 0xFFFFEEF0..FF (R42.M5-002,
// sibling).
//
//   NVW_OK              = 0
//   NVW_ERR_NOT_INIT    = 0xFFFFEF0F   accessor before nvw_reset
//   NVW_ERR_SQ_FULL     = 0xFFFFEF0E   submit when batch_head == SQ_DEPTH
//   NVW_ERR_BAD_LEN     = 0xFFFFEF0D   submit with len == 0
//   NVW_ERR_BAD_CID     = 0xFFFFEF0C   completion with cid not in SQ
//   NVW_ERR_ALREADY_DONE= 0xFFFFEF0B   completion of a cid already completed
//   NVW_ERR_NOT_SUBMIT  = 0xFFFFEF0A   completion of a cid still pending
//   NVW_ERR_INTERNAL    = 0xFFFFEF09   unreachable-fallthrough tripwire
//
// R51.M8-005 (#1679) adds a SECOND, disjoint band -- 0xFFFFECD0..DF
// (BDEVFS, design/hardware/nvme-ahci-tail-milestones.md's file-touch
// table) -- for bdev_write_sync, the first function in this file that
// calls cap_invoke directly instead of accounting into _nvw_sq. See
// that function's own section header for the full scope note.
//
//   BDEVFS_INVOKE_FAILED = 0xFFFFECD0   cap_invoke returned non-zero,
//                                        not INVOKE_RESULT_INVALID_HANDLE
//   BDEVFS_EIO           = 0xFFFFECD2   cap_invoke returned
//                                        INVOKE_RESULT_INVALID_HANDLE
//                                        (revoked/never-minted slot)
//
// Reserved-label discipline: labels prefixed `nvw_`; bdev_write_sync's
// own labels are prefixed `bdw_ws_`.

module BdevWrite = structure {

  pub let NVW_SQ_DEPTH        : u64 = 64
  pub let NVW_ENTRY_WORDS     : u64 = 4

  pub let NVW_STATUS_PENDING    : u64 = 0
  pub let NVW_STATUS_SUBMITTED  : u64 = 1
  pub let NVW_STATUS_COMPLETED  : u64 = 2

  pub let NVW_OK              : u64 = 0
  pub let NVW_ERR_NOT_INIT    : u64 = 0xFFFFEF0F
  pub let NVW_ERR_SQ_FULL     : u64 = 0xFFFFEF0E
  pub let NVW_ERR_BAD_LEN     : u64 = 0xFFFFEF0D
  pub let NVW_ERR_BAD_CID     : u64 = 0xFFFFEF0C
  pub let NVW_ERR_ALREADY_DONE: u64 = 0xFFFFEF0B
  pub let NVW_ERR_NOT_SUBMIT  : u64 = 0xFFFFEF0A
  pub let NVW_ERR_INTERNAL    : u64 = 0xFFFFEF09

  pub let NVW_INIT_MARK       : u64 = 0xF11E

  // 64 entries * 4 u64 = 256 u64. Aligned so a per-entry load starts
  // on a cache line that the widening's real driver can DMA into.
  pub let mut _nvw_sq    : [u64; 256] = uninit @align(64)
  pub let mut _nvw_state : [u64; 8]   = uninit @align(64)

  // ==========================================================================
  // R54.M1-002 (#1779): flush-time source page for nvme_write_blocking.
  //
  // nvw_batch_flush now performs a REAL NVMe Write command per pending SQ
  // entry when a live IO SQ pair exists (_nvme_io_queue_count > 0). The
  // scaffold entries stored (cid, lba, len, status) but never captured a
  // caller-supplied buf_pa -- callers accumulated writes without ever
  // being asked to name the source page. This BSS is the temporary source
  // page nvw_batch_flush hands to nvme_write_blocking's PRP1 slot, and it
  // is populated with zeros at .bss init: a widening that lands
  // caller-supplied buf_pa into the entry format (extending
  // NVW_ENTRY_WORDS from 4 to a wider stride) will swap this scratch for
  // the entry's own buf_pa field and delete this BSS.
  //
  // 4 KiB (512 u64), @align(4096) -- PRP1 requires page alignment per
  // NVMe §4.5.2 (single-page transfer at R54.M1). Single writer: written
  // only by bdev_write.o (nvw_batch_flush reads its address; the page
  // stays .bss-zero for the R54.M1-002 landing because the entries do
  // not yet carry the source data).
  pub let mut _nvw_flush_scratch : [u64; 512] = uninit @align(4096)

  // ==========================================================================
  // R51.M8-005 (#1679): BDEVFS band (0xFFFFECD0..0xFFFFECDF, design/
  // hardware/nvme-ahci-tail-milestones.md's file-touch table names this
  // module as the band's owner). #1673 (R51.M7-005) NAMED this band and
  // an "internal rewrite" -- this module's read/write/flush functions
  // calling cap_invoke(bdev_slot, BDEV_OP_{READ,WRITE,FLUSH}_LBA, ...)
  // directly instead of accumulating into the _nvw_sq scaffold above --
  // but the commit that actually landed (4708409) did the FILE RENAME
  // ONLY: no cap_invoke call existed anywhere in this file before this
  // issue. #1679's own charter (a WRITE in flight when the underlying
  // device is hot-removed must surface EIO, not a silent success)
  // requires calling the REAL cap_invoke path for a WRITE_LBA, so THIS
  // issue lands exactly that one function -- bdev_write_sync, using
  // #1673's own named signature (bdev_slot, lba, nblocks, dma_iova) --
  // rather than the full three-function rewrite (bdev_read_sync,
  // bdev_flush) plus the durability.pdx / wal.pdx / cow_write.pdx caller
  // migration #1673 also described. Those remain open gaps, flagged
  // here rather than silently dropped. The pre-existing NVW_*
  // SQ-accounting scaffold above and its existing callers are UNTOUCHED
  // by this addition -- bdev_write_sync is purely additive.
  //
  //   BDEVFS_INVOKE_FAILED = 0xFFFFECD0 -- #1673's own named code,
  //     first claimed here: cap_invoke returned any non-zero result
  //     OTHER than INVOKE_RESULT_INVALID_HANDLE (a forwarded BDEV_ERR_*/
  //     AHCIIO_*/NVMEIO_* sentinel, or INVOKE_DENIED/INVOKE_UNSUPPORTED).
  //   BDEVFS_EIO = 0xFFFFECD2 -- #1679's own named code: cap_invoke
  //     returned INVOKE_RESULT_INVALID_HANDLE (cap/invoke.pdx), which
  //     means the slot's descriptor read kind == KIND_NULL (0) at
  //     invoke time -- either never minted, or scrubbed by a revoke
  //     cascade (ahci_port_cascade_revoke_blkdev /
  //     nvme_ns_cascade_revoke_blkdev) that ran WHILE this write was in
  //     flight. This is the hot-remove-under-write case #1679 exists to
  //     prove surfaces an error rather than "0 == success".
  //     BDEVFS_BAD_STATUS (0xFFFFECD1, #1673's third named code) is NOT
  //     claimed here -- it describes a status_out-field mismatch this
  //     minimal single-function landing has no caller for; left for
  //     whichever issue lands bdev_read_sync/bdev_flush and can give it
  //     a real exercise path instead of an unclaimed, untested slot.
  // ==========================================================================

  pub let BDEVFS_INVOKE_FAILED : u64 = 0xFFFFECD0
  pub let BDEVFS_EIO           : u64 = 0xFFFFECD2

  // {lba, nblocks, dma_iova, status_out} -- must be 4-KiB aligned (design
  // §3.5's op_arg encoding packs the descriptor-page address into
  // op_arg[63:12], so the low 12 bits must be zero) even though only 32
  // bytes are used. Mirrors superblock_read.pdx's _sb_read_desc exactly.
  pub let mut _bdw_write_desc : [u64; 4] = uninit @align(4096)

  // ==========================================================================
  // bdev_write_sync(bdev_slot, lba, nblocks, dma_iova) -> u64
  //
  // Stamp the descriptor page and cap_invoke(bdev_slot, BDEV_OP_WRITE_LBA
  // | desc_page_addr) directly -- see the SECTION header above for scope
  // and the BDEVFS_* failure-code taxonomy.
  // ==========================================================================
  pub let bdev_write_sync : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_slot: u64) (lba: u64) (nblocks: u64) (dma_iova: u64) -> unsafe {
      effects: { mem, sysreg }, capabilities: { cap },
      justification: "R51.M8-005 (#1679): first real cap_invoke(bdev_slot, BDEV_OP_WRITE_LBA, ...) call in this file -- see the SECTION header above (this landing is bdev_write_sync only; bdev_read_sync/bdev_flush and the durability.pdx/wal.pdx/cow_write.pdx caller migration #1673 also described remain open). Three callee-save pushes (rbx=bdev_slot, r12=&_bdw_write_desc, r13=unused padding) leave rsp%16==0 (entry rsp%16==8 -> 8+24=32, %16==0) for the nested cap_invoke call. Body: (1) rbx=bdev_slot (rdi). (2) r12=&_bdw_write_desc (lea rip-relative, proven idiom throughout this kernel). (3) stamp the descriptor page (design §3.5, cap_handler_blkdev.pdx): [r12+0]=lba (rsi), [r12+8]=nblocks (rdx), [r12+16]=dma_iova (rcx), [r12+24]=status_out=0 (xor rax,rax). (4) rdi=rbx; rsi=r12 OR'd with op_code 4 (BDEV_OP_WRITE_LBA) via mov r10,4; or rsi,r10 -- r12's low 12 bits are guaranteed zero by @align(4096), matching superblock_read.pdx's sb_read / kind_nvme_io_queues_synth.pdx's proven op_arg-packing idiom. call cap_invoke. (5) cmp rax,0; je bdw_ws_ok -- BDEV_ERR_OK, return 0. (6) mov r10, 0xFFFFFFFFFFFFFFFE (INVOKE_RESULT_INVALID_HANDLE, cap/invoke.pdx, staged via r10 per G4 since a bare imm32 cmp sign-extends); cmp rax, r10; je bdw_ws_eio -- the R51.M8-005 hot-remove case: a KIND_BLKDEV slot scrubbed mid-write now returns INVOKE_RESULT_INVALID_HANDLE (cap/invoke.pdx's own R51.M8-005 fix) instead of falling through to a target_ptr echo. (7) any other non-zero cap_invoke result -> BDEVFS_INVOKE_FAILED (0xFFFFECD0). bdw_ws_eio: BDEVFS_EIO (0xFFFFECD2). bdw_ws_ok: 0. Labels prefixed bdw_ws_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // bdev_slot

        lea r12, [rip + _bdw_write_desc];
        mov [r12 + 0], rsi;               // lba
        mov [r12 + 8], rdx;               // nblocks
        mov [r12 + 16], rcx;              // dma_iova
        xor rax, rax;
        mov [r12 + 24], rax;              // status_out = 0

        mov rdi, rbx;
        mov rsi, r12;
        mov r10, 4;                       // BDEV_OP_WRITE_LBA
        or  rsi, r10;
        call cap_invoke;

        cmp rax, 0;
        je  bdw_ws_ok;

        mov r10, 0xFFFFFFFFFFFFFFFE;      // INVOKE_RESULT_INVALID_HANDLE
        cmp rax, r10;
        je  bdw_ws_eio;

        mov rax, 0xFFFFECD0;              // BDEVFS_INVOKE_FAILED
        jmp bdw_ws_out;

      bdw_ws_eio:
        mov rax, 0xFFFFECD2;              // BDEVFS_EIO
        jmp bdw_ws_out;

      bdw_ws_ok:
        xor rax, rax;

      bdw_ws_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Reset. Clears queue + state; installs init_mark and primes next_cid = 1.
  // A cid of 0 would collide with the "free slot" sentinel in the entry.
  // ==========================================================================

  pub let nvw_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): clear SQ + state, install init_mark, prime next_cid to 1 (0 is the free-slot sentinel in _nvw_sq entries). Labels prefixed nvw_rst_.",
      block: {
        lea r10, [rip + _nvw_sq];
        xor rax, rax;
        xor rcx, rcx;
      nvw_rst_q:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  nvw_rst_q;

        lea r10, [rip + _nvw_state];
        xor rcx, rcx;
      nvw_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  nvw_rst_s;

        mov rax, 0xF11E;
        mov [r10 + 0], rax;
        mov rax, 1;
        mov [r10 + 24], rax;                    // next_cid := 1
        ret
      }
    }

  pub let nvw_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): 1 iff init_mark matches. Labels prefixed nvw_bnd_.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_bnd_no;
        mov rax, 1;
        ret;
      nvw_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let nvw_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): sticky error latch readback.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let nvw_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): first-writer-wins error latch. Labels prefixed nvw_se_.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne nvw_se_out;
        mov [r10 + 8], rdi;
      nvw_se_out:
        ret
      }
    }

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let nvw_depth : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M5-001 (#1396): NVW_SQ_DEPTH as u64.",
      block: {
        mov rax, 64;
        ret
      }
    }

  pub let nvw_batch_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): batch_head (pending count).",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let nvw_next_cid : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): next_cid field.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let nvw_submit_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): submit_count field.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let nvw_flush_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): flush_count field.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let nvw_flushed_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): flushed_total field.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let nvw_completion_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): completion_count field.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  // ==========================================================================
  // Per-entry accessors. Refuse on:
  //   - not init                    NVW_ERR_NOT_INIT
  //   - idx >= batch_head           NVW_ERR_BAD_CID (positional; caller passed
  //                                                    an entry idx past pending
  //                                                    count).
  // ==========================================================================

  pub let nvw_cid_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): read cid of entry idx. Labels prefixed nvw_ca_.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_ca_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae nvw_ca_bi;

        mov rax, rdi;
        shl rax, 2;                             // idx * 4
        lea r11, [rip + _nvw_sq];
        mov rax, [r11 + rax * 8];               // +0 cid
        ret;

      nvw_ca_ni:
        mov rdi, 0xFFFFEF0F;
        call nvw_set_err;
        xor rax, rax;
        ret;
      nvw_ca_bi:
        mov rdi, 0xFFFFEF0C;
        call nvw_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let nvw_lba_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): read lba of entry idx. Labels prefixed nvw_la_.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_la_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae nvw_la_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, 1;                             // +1 (u64) = +8 = lba
        lea r11, [rip + _nvw_sq];
        mov rax, [r11 + rax * 8];
        ret;

      nvw_la_ni:
        mov rdi, 0xFFFFEF0F;
        call nvw_set_err;
        xor rax, rax;
        ret;
      nvw_la_bi:
        mov rdi, 0xFFFFEF0C;
        call nvw_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let nvw_len_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): read len of entry idx. Labels prefixed nvw_na_.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_na_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae nvw_na_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, 2;                             // +2 u64 = len
        lea r11, [rip + _nvw_sq];
        mov rax, [r11 + rax * 8];
        ret;

      nvw_na_ni:
        mov rdi, 0xFFFFEF0F;
        call nvw_set_err;
        xor rax, rax;
        ret;
      nvw_na_bi:
        mov rdi, 0xFFFFEF0C;
        call nvw_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let nvw_status_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): read status of entry idx. Labels prefixed nvw_sa_.",
      block: {
        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_sa_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae nvw_sa_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, 3;                             // +3 u64 = status
        lea r11, [rip + _nvw_sq];
        mov rax, [r11 + rax * 8];
        ret;

      nvw_sa_ni:
        mov rdi, 0xFFFFEF0F;
        call nvw_set_err;
        xor rax, rax;
        ret;
      nvw_sa_bi:
        mov rdi, 0xFFFFEF0C;
        call nvw_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // nvw_submit(lba, len) -> u64
  //
  // Enqueue one write in the pending band. Assigns a fresh cid
  // (next_cid++), stamps status = 0 (pending). Returns the assigned
  // cid on success (>= 1).
  //
  // Refuses:
  //   - not init                    NVW_ERR_NOT_INIT
  //   - len == 0                    NVW_ERR_BAD_LEN
  //   - batch_head == NVW_SQ_DEPTH  NVW_ERR_SQ_FULL
  //
  // A caller that hits SQ_FULL must call nvw_batch_flush (to move the
  // pending band into the submitted band and free the pending count)
  // and then await completions (to actually free entry slots). The
  // scaffold does not coalesce completed slots into batch_head; a
  // widening's real SQ head pointer will reclaim them.
  // ==========================================================================

  pub let nvw_submit : (u64, u64) -> u64 !{mem} @{} =
    fn (lba: u64, len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): enqueue one pending write. Assigns next_cid (>= 1 because 0 is the free-slot sentinel), stamps status = PENDING (0). SQ_FULL is refused rather than overwritten because an in-place overwrite would drop a write the CoW walker's guard has already accounted for. Labels prefixed nvw_sb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_sb_ni;

        cmp rsi, 0;
        je  nvw_sb_bl;

        mov rbx, [r10 + 16];                    // batch_head
        mov r11, 64;                            // NVW_SQ_DEPTH
        cmp rbx, r11;
        jae nvw_sb_full;

        mov r12, [r10 + 24];                    // next_cid

        // r13 = idx * 4 (u64 offset for entry base)
        mov rax, rbx;
        shl rax, 2;
        mov r13, rax;

        lea r11, [rip + _nvw_sq];
        mov [r11 + r13 * 8], r12;               // +0 cid
        add r13, 1;
        mov [r11 + r13 * 8], rdi;               // +8 lba
        add r13, 1;
        mov [r11 + r13 * 8], rsi;               // +16 len
        add r13, 1;
        xor rax, rax;
        mov [r11 + r13 * 8], rax;               // +24 status = PENDING

        // batch_head++, next_cid++, submit_count++.
        add rbx, 1;
        mov [r10 + 16], rbx;
        add r12, 1;
        mov [r10 + 24], r12;
        mov r9, [r10 + 32];
        add r9, 1;
        mov [r10 + 32], r9;

        // Return the cid we just used (r12 - 1).
        mov rax, r12;
        sub rax, 1;
        jmp nvw_sb_out;

      nvw_sb_ni:
        mov rdi, 0xFFFFEF0F;
        call nvw_set_err;
        xor rax, rax;
        jmp nvw_sb_out;
      nvw_sb_bl:
        mov rdi, 0xFFFFEF0D;
        call nvw_set_err;
        xor rax, rax;
        jmp nvw_sb_out;
      nvw_sb_full:
        mov rdi, 0xFFFFEF0E;
        call nvw_set_err;
        xor rax, rax;

      nvw_sb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvw_batch_flush() -> u64
  //
  // Move every pending entry to the submitted band. Walks
  // [0..batch_head) looking for status == PENDING (0). On each hit,
  // BRANCHES on _nvme_io_queue_count:
  //
  //   - LIVE (_nvme_io_queue_count > 0): calls
  //     nvme_write_blocking(nsid=1, entry.lba, count=1,
  //                         buf_pa=&_nvw_flush_scratch).
  //     On status == 0 -> stamps SUBMITTED and bumps newly-submitted.
  //     On status != 0 -> leaves the entry PENDING (a subsequent flush
  //                       retries).
  //
  //   - SUBSTRATE (_nvme_io_queue_count == 0): stamps SUBMITTED and
  //     bumps newly-submitted (pre-R54.M1-002 scaffold behavior). This
  //     avoids DMA into a zero sq_pa hazard when the boot posture has
  //     no live NVMe controller (every QEMU-TCG -kernel run today).
  //
  // Bumps flush_count once per call (even if zero entries move; the
  // flush attempt is itself an event) and adds newly-submitted to
  // flushed_total. Returns the number of entries newly submitted.
  //
  // Emits the R54.M1-002 fingerprint via klog_s1_x2 at the end of any
  // flush where newly-submitted > 0. Substrate flushes that moved
  // entries emit exactly the same fingerprint as live flushes -- the
  // wire signal is "the flush attempt made progress", not "the driver
  // is live". A flush that moved zero entries is silent on the wire.
  //
  // Effects widened to {sysreg, mem} at R54.M1-002 (#1779) to cover
  // nvme_write_blocking (drivers/nvme/sync.pdx: !{sysreg, mem} @{})
  // and klog_s1_x2 (klog/wrappers.pdx: !{sysreg, mem} @{}). Both
  // existing callers (tests/kernel/fs/pdxfs/nvme_write_synth.pdx and
  // concurrent_stress_synth.pdx) already declare !{sysreg, mem} on
  // their own witness effect row, so this widening propagates cleanly.
  //
  // Refuses:
  //   - not init                    NVW_ERR_NOT_INIT
  // ==========================================================================

  pub let nvw_batch_flush : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R42.M5-001 (#1396) + R54.M1-002 (#1779): flush the pending band into the submitted band. flush_count bumps regardless of the moved count so a caller polling flush_count sees every doorbell attempt; flushed_total accumulates only the actually-moved count. R54.M1-002 rewrite: branches on _nvme_io_queue_count -- LIVE calls nvme_write_blocking(nsid=1, entry.lba, count=1, buf_pa=&_nvw_flush_scratch) per PENDING entry and only stamps SUBMITTED on status == 0; SUBSTRATE (no live IO SQ pair, every QEMU-TCG -kernel boot today) preserves the pre-R54.M1-002 stamping so existing substrate witnesses (nvme_write_synth, concurrent_stress_synth) stay green. Substrate-branch rationale mirrors the R54.M1-001 witness's own _nvme_io_queue_count guard -- calling nvme_write_blocking with no live sq_pa would DMA into page 0, a boot-critical hazard. Fingerprint via klog_s1_x2 (tag_pdxb_bdev_flush_ok, k_pending=pending_seen, k_submitted=newly_submitted) fires only when newly_submitted > 0 so zero-move flushes stay silent on the wire. Register plan: 4 pushes (rbx=i, r12=batch_head, r13=newly-submitted, r14=pending_seen) -- 32 B; entry rsp%16==8 -> 40, %16==8 (aligned for nested calls after `sub rsp, 8` scoped around each nvme_write_blocking, and after `push v2` before klog_s1_x2 since 8+8=16 %16==0). Loop reads status @+i*4+3 (u64 stride 4); on PENDING (0): bump pending_seen; check _nvme_io_queue_count; if 0 (substrate) -> stamp SUBMITTED, bump newly-submitted; if !=0 (live) -> load lba @+i*4+1, staged into rsi via a temporary r15 save/restore across the call (r15 is not a prologue-pushed reg here to keep the prologue at 4 pushes -- lba is spilled onto the reserved-stack pad instead). Actually simpler: preserve i and batch_head across the call by keeping them in callee-save rbx/r12 which nvme_write_blocking honours; load lba fresh from _nvw_sq into rsi post-call is not needed if we spill it to a scratch reg beforehand -- we spill (lba, entry_status_offset_in_bytes) into (r15, r11 replacement) but r11 is caller-save; use rbp for entry base + status offset spill (rbp pushed in prologue). Revised prologue: 5 pushes (rbx=i, rbp=status_off, r12=batch_head, r13=newly-submitted, r14=pending_seen) -- 40 B; entry rsp%16==8 -> 48, %16==0. Then `sub rsp, 8` is NOT needed around nvme_write_blocking (rsp%16==0 already). For klog_s1_x2's 7th arg push: 48+8=56, %16==8 -- BAD. So we push a dummy first (add sub rsp, 8), no -- simpler: reduce to 4 pushes and use sub rsp, 8 as an alignment pad around klog_s1_x2 only. Final: 5 pushes; before klog_s1_x2, `sub rsp, 8; push r13(v2); call; add rsp, 16`. Wire cost: 5 pushes + 1 sub + 1 push = 6 stack ops per flush -- negligible. nvme_write_blocking preserves rbx/rbp/r12/r13/r14/r15 per SysV (kernel/core/drivers/nvme/sync.pdx nvme_sy_wr_ prologue pushes all six). klog_s1_x2 preserves rbx/r12/r13/r14/r15 per SysV (rbp is its own frame register but restored). Labels prefixed nvw_bf_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_bf_ni;

        // flush_count++
        mov r9, [r10 + 40];
        add r9, 1;
        mov [r10 + 40], r9;

        mov r12, [r10 + 16];                    // batch_head
        xor rbx, rbx;                           // i = 0
        xor r13, r13;                           // newly-submitted counter
        xor r14, r14;                           // pending_seen counter

      nvw_bf_top:
        cmp rbx, r12;
        jae nvw_bf_done;

        // status offset = i * 4 + 3 (u64s)
        mov rax, rbx;
        shl rax, 2;
        add rax, 3;
        mov rbp, rax;                           // save status u64-offset for post-call reuse
        lea r11, [rip + _nvw_sq];
        mov r8, [r11 + rax * 8];
        cmp r8, 0;                              // only PENDING is processed
        jne nvw_bf_next;

        // PENDING entry: bump pending_seen.
        add r14, 1;

        // Branch: substrate vs live NVMe IO SQ pair.
        mov rax, [rip + _nvme_io_queue_count];
        cmp rax, 0;
        je  nvw_bf_substrate;

        // -------------------------------------------------------------
        // LIVE path: nvme_write_blocking(nsid=1, lba, count=1, buf_pa).
        //
        // lba is at entry+8 (u64-offset = i*4 + 1).
        // Register plan: nvme_write_blocking clobbers rax/rcx/rdx/r8/
        // r9/r10/r11/rdi/rsi (caller-save) but preserves rbx/rbp/r12/
        // r13/r14/r15 (callee-save). We keep i (rbx), status offset
        // (rbp), batch_head (r12), counters (r13/r14) across the call.
        // rsp%16 already == 0 here (5 pushes atop entry rsp%16==8, so
        // 8+40=48, %16==0), so no `sub rsp, 8` alignment is needed.
        // -------------------------------------------------------------

        // Load lba: entry_u64_offset = i * 4 + 1
        mov rax, rbx;
        shl rax, 2;
        add rax, 1;
        lea r11, [rip + _nvw_sq];
        mov rsi, [r11 + rax * 8];               // rsi = lba

        mov rdi, 1;                             // nsid = 1
        mov rdx, 1;                             // count = 1 block
        lea rcx, [rip + _nvw_flush_scratch];    // buf_pa = &_nvw_flush_scratch

        call nvme_write_blocking;

        // rax = CQE status; 0 == success. Non-zero leaves PENDING.
        cmp rax, 0;
        jne nvw_bf_next;

        // Success: stamp SUBMITTED via saved offset (rbp).
        lea r11, [rip + _nvw_sq];
        mov r8, 1;
        mov [r11 + rbp * 8], r8;
        add r13, 1;
        jmp nvw_bf_next;

      nvw_bf_substrate:
        // Substrate path: stamp SUBMITTED without a driver call.
        lea r11, [rip + _nvw_sq];
        mov r8, 1;
        mov [r11 + rbp * 8], r8;
        add r13, 1;

      nvw_bf_next:
        add rbx, 1;
        jmp nvw_bf_top;

      nvw_bf_done:
        lea r10, [rip + _nvw_state];
        mov r9, [r10 + 48];
        add r9, r13;
        mov [r10 + 48], r9;                     // flushed_total += r13

        // -------------------------------------------------------------
        // Fingerprint. Silent when newly_submitted == 0 (a flush that
        // moved zero entries is not a wire event).
        // -------------------------------------------------------------
        cmp r13, 0;
        je  nvw_bf_ret;

        // klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS__, tag_pdxb_bdev_flush_ok,
        //            k_pending, pending_seen, k_submitted, newly_submitted)
        //
        // Args: rdi=level, rsi=subsys, rdx=tag, rcx=k1, r8=v1, r9=k2,
        //       [rsp+8] = v2 (7th arg pushed by caller).
        //
        // Alignment: rsp%16==0 here. `sub rsp, 8` -> %16==8, then
        // `push r13` (v2) -> %16==0 pre-call. Cleanup `add rsp, 16`.
        // (Equivalent to a single 16-byte allocation with v2 written to
        // [rsp+0], but the push/sub pair reads more idiomatic against
        // the wrappers.pdx convention comment.)
        mov rdi, 3;                             // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_pdxb_bdev_flush_ok];
        lea rcx, [rip + k_pending];
        mov r8, r14;                            // pending_seen
        lea r9, [rip + k_submitted];
        sub rsp, 8;                             // align pad before v2 push
        push r13;                               // v2 = newly_submitted
        call klog_s1_x2;
        add rsp, 16;                            // undo push + pad

      nvw_bf_ret:
        mov rax, r13;
        jmp nvw_bf_out;

      nvw_bf_ni:
        mov rdi, 0xFFFFEF0F;
        call nvw_set_err;
        xor rax, rax;

      nvw_bf_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // nvw_completion(cid) -> u64
  //
  // Acknowledge completion of one command. Walks [0..batch_head)
  // searching for entry.cid == cid. Refuses:
  //   - not init                    NVW_ERR_NOT_INIT
  //   - cid not present             NVW_ERR_BAD_CID
  //   - entry status == COMPLETED   NVW_ERR_ALREADY_DONE
  //   - entry status == PENDING     NVW_ERR_NOT_SUBMIT (completion
  //                                                       before flush is
  //                                                       impossible in
  //                                                       hardware; refuse
  //                                                       the caller who
  //                                                       fakes one).
  // On success: stamps status = COMPLETED, bumps completion_count.
  // Returns 1.
  //
  // A widening replaces the linear search with the CQE walk; the
  // ACK semantics are the same.
  // ==========================================================================

  pub let nvw_completion : (u64) -> u64 !{mem} @{} =
    fn (cid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M5-001 (#1396): acknowledge one completion. The linear search is a scaffold artefact; the widening's real driver reads the phase-tagged CQE. The ALREADY_DONE + NOT_SUBMIT refusals keep the state machine honest: a caller that acks the same cid twice or that acks a cid still in the pending band exposes a divergence with the underlying NVMe protocol. Labels prefixed nvw_co_.",
      block: {
        push rbx;
        push r12;

        lea r10, [rip + _nvw_state];
        mov rax, [r10 + 0];
        mov r11, 0xF11E;
        cmp rax, r11;
        jne nvw_co_ni;

        mov r12, [r10 + 16];                    // batch_head
        xor rbx, rbx;                           // i = 0

      nvw_co_top:
        cmp rbx, r12;
        jae nvw_co_bc;

        // cid offset = i * 4 + 0
        mov rax, rbx;
        shl rax, 2;
        lea r11, [rip + _nvw_sq];
        mov r8, [r11 + rax * 8];
        cmp r8, rdi;
        je  nvw_co_hit;

        add rbx, 1;
        jmp nvw_co_top;

      nvw_co_hit:
        // status offset = i * 4 + 3
        add rax, 3;
        mov r8, [r11 + rax * 8];
        cmp r8, 2;
        je  nvw_co_ad;
        cmp r8, 0;
        je  nvw_co_ns;

        // status == SUBMITTED. Mark COMPLETED and bump counter.
        mov r8, 2;
        mov [r11 + rax * 8], r8;
        lea r10, [rip + _nvw_state];
        mov r9, [r10 + 56];
        add r9, 1;
        mov [r10 + 56], r9;
        mov rax, 1;
        jmp nvw_co_out;

      nvw_co_ni:
        mov rdi, 0xFFFFEF0F;
        call nvw_set_err;
        xor rax, rax;
        jmp nvw_co_out;
      nvw_co_bc:
        mov rdi, 0xFFFFEF0C;
        call nvw_set_err;
        xor rax, rax;
        jmp nvw_co_out;
      nvw_co_ad:
        mov rdi, 0xFFFFEF0B;
        call nvw_set_err;
        xor rax, rax;
        jmp nvw_co_out;
      nvw_co_ns:
        mov rdi, 0xFFFFEF0A;
        call nvw_set_err;
        xor rax, rax;

      nvw_co_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
