// src/kernel/core/fs/pdxfs/inode_table.pdx -- R52.M4-002 (#1698) +
//                                              R52.M4-004 (#1700)
//
// PDXFS-ON-BLOCK v1 -- INODE TABLE SKELETON: READ / WRITE / ALLOC-FRESH /
//                       SCRUB / RESOLVE over the fixed 128-B-per-inode
//                       on-disk slab.
//
// Design authority: design/filesystem/r52-implementation-plan.md §2.4
// (R52.M4, step 2: "#1698 -- inode_table.pdx: inode_read(vol_slot,
// inode_no) -> inode_row_ptr | err, inode_write(vol_slot, inode_no,
// inode_row_ptr) -> err, inode_alloc_fresh(vol_slot) -> inode_no | err,
// inode_scrub_slot(vol_slot, inode_no) -> err. The 128-B inode row is
// passed by pointer; individual field accessors mirror the
// pdxfs_file_row_* discipline."); step 4: "#1700 -- inode_no ->
// (inode_lba, slot_in_block) resolver: pure arithmetic on the
// superblock's itable_lba + slot math (inode_no / 32 -> block offset,
// inode_no % 32 -> slot). Returns packed u64."); on-disk row layout
// frozen at design/filesystem/volume-fs-substrate.md §2.3 ("Inode
// table -- fixed slab, 128 B per inode").
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Lands the four primitives §2.4 names for #1698:
//
//   inode_read(bdev_cap: u64, inode_no: u64) -> u64
//     Returns a pointer to a 128-byte in-memory copy of the on-disk row
//     (`_itable_row_scratch`), or one of INODE_INVALID_INDEX /
//     INODE_HEADER_INUSE_BAD / the reused ALLOC_BITMAP_TORN (see
//     "Failure taxonomy" below).
//
//   inode_write(bdev_cap: u64, inode_no: u64, row_ptr: u64) -> u64
//     Splices the 128 bytes at row_ptr into the resident inode-table
//     block at inode_no's slot and durably writes the whole 4-KiB block
//     back. Returns 0 on success.
//
//   inode_alloc_fresh(bdev_cap: u64) -> u64
//     Scans the whole itable_bcount-block region for the first slot
//     whose header in_use byte is 0 (skipping inode 0, the permanent
//     invalid-inode sentinel), immediately constructs and durably
//     writes a minimal fresh row there (in_use=1, refcount=1, every
//     other field zero) via inode_write, and returns its inode_no.
//     Immediate durable commit mirrors allocator.pdx's alloc_block --
//     see design-doc gap 1 below.
//
//   inode_scrub_slot(bdev_cap: u64, inode_no: u64) -> u64
//     Zeroes an inode row's full 128 bytes in place and durably writes
//     the block back (the free-list counterpart to inode_alloc_fresh --
//     mirrors allocator.pdx's free_block). Refuses inode_no == 0.
//
//   inode_resolve(sb_ptr: u64, inode_no: u64) -> u64                  [#1700]
//     Pure arithmetic: inode_no -> (inode_lba, slot_in_block), packed
//     into one u64 as (inode_lba << 8) | slot_in_block. Reads only
//     sb_itable_lba(sb_ptr) (superblock.pdx, #1682) -- unlike every
//     other function in this file it does NOT require itable_init to
//     have run and does NOT touch _itable_state, since it needs only
//     the superblock's itable_lba, not the cached copy. Returns
//     INODE_RESOLVER_LBA_OVERFLOW if the computed inode_lba does not
//     fit in the packing's 56 high bits (top byte of inode_lba
//     nonzero) -- see "Design-doc gaps" item 5 below.
//
// vol_slot vs bdev_cap: identical substitution allocator.pdx's own #1692
// header already made and flagged (gap 1 there) -- no per-volume slot
// table exists yet (KIND_VOLUME lands at R52.M5, #1707), so this module
// threads the caller-supplied bdev_cap directly, exactly as
// superblock_read.pdx / superblock_write.pdx / allocator.pdx already do.
// A follow-up at M5 can widen `_itable_state` into a per-slot array
// without touching the row I/O logic below.
//
// Per-field row accessors (the "mirror the pdxfs_file_row_* discipline"
// clause of #1698's plan text) are NOT landed here -- #1698's own
// four-primitive list above is the complete scope this issue names;
// per-field getters/setters over the 128-byte row are needed by M6's
// PXT_OP_* handlers (§2.6) once those exist to populate a row before
// calling inode_write, and are deferred to that landing (or to #1699's
// KIND_INODE_HANDLE cap module, whichever consumes them first) rather
// than speculatively added here. Flagged for softarch to confirm the
// right landing site.
//
// -----------------------------------------------------------------------------
// Design-doc gaps flagged (see final report to main / softarch)
// -----------------------------------------------------------------------------
//
// 1. Immediate-commit allocation. §2.4's plan text describes
//    `inode_alloc_fresh` only as "allocate a fresh inode number" with no
//    stated durability posture. This landing mirrors allocator.pdx's
//    alloc_block: the freshly-found slot is durably written (in_use=1)
//    before the inode_no is returned, so a second call cannot observe
//    the same free slot. The alternative (return the inode_no only,
//    leave the on-disk write to the caller) would let a caller who
//    never follows up with its own write leave the slot's on-disk
//    in_use byte at 0 forever, and would let a hypothetical second
//    caller pick the exact same slot before the first ever writes it
//    (no concurrency exists yet in this single-threaded boot path, but
//    the immediate-commit posture is the safer default and is already
//    proven at M3). Softarch should confirm this posture before M6's
//    PXT_OP_CREATE starts depending on it.
//
// 2. `itable_init` precondition. `inode_read`/`inode_write`/
//    `inode_alloc_fresh`/`inode_scrub_slot` all assume `itable_init
//    (sb_ptr)` has already run in this boot (populating `_itable_state`'s
//    `itable_lba`/`itable_bcount` fields and marking the resident block
//    unloaded). No frozen M4 sentinel exists for "not initialized" (the
//    M4 band's 8 codes are fully allocated per §4/§7.2 -- see below),
//    so this is an undocumented-in-band precondition, exactly the same
//    posture allocator.pdx's own gap 3 (`alloc_init` precondition)
//    already flagged and left for a later band-widening decision.
//
// 3. Single resident inode-table block. Mirrors allocator.pdx's gap 2:
//    this module holds exactly ONE resident 4-KiB inode-table block
//    (`_itable_blk_buf`) at a time. `inode_alloc_fresh`'s whole-region
//    scan reloads it once per block via `itable_ensure_block_loaded`
//    (itself cache-aware -- a block already resident from a prior
//    `inode_read`/`inode_write` call is not re-read), so no additional
//    "unconditional load" helper (the `alloc_bm_load_block` shape) is
//    needed here the way #1694 needed one for the allocator's own
//    scan-on-mount -- `itable_ensure_block_loaded`'s cache check is
//    already correct for a monotonically-advancing scan.
//
// 4. Reused failure code. Per §4/§7.2, the M4 band (0xFFFFED18..ED1F)
//    has no code that means "an on-disk inode-table block's READ or
//    WRITE did not report an acceptable BDEV status" -- the 8 slots are
//    INODE_INVALID_INDEX, INODE_HEADER_INUSE_BAD,
//    INODE_ALLOC_FRESH_EXHAUSTED (wired here), INODE_TAIL_PREFIX_TEAR /
//    INODE_TAIL_HASH_MISMATCH / INODE_SIG_VERIFY_FAIL (reserved for
//    #1701, sig_verify.pdx), INODE_RESOLVER_LBA_OVERFLOW (wired here by
//    #1700's inode_resolve), and INODE_SLOT_BOUNDS (reserved for #1699,
//    kind_inode_handle.pdx). This landing reuses allocator.pdx's own
//    ALLOC_BITMAP_TORN (0xFFFFED11, M3's band) for every BDEV I/O
//    failure here, restated as the literal `0xFFFFED11` per this
//    codebase's no-cross-module-constant-import convention (see
//    superblock.pdx's header) with a comment citing the source --
//    exactly the precedent `mkfs_upgrade.pdx` already set reusing
//    `PDXB_SB_READ_BDEV_ERR` (0xFFFFED08, M2's band) rather than
//    minting a new M2-band code for its own raw LBA-0 read. This is
//    also the concrete tie to this issue's brief ("uses R52.M3's
//    allocator for on-disk inode blocks") as read by this landing: the
//    on-disk-block I/O style (raw `cap_invoke` READ, `bdev_barrier_
//    write` + `bbjw_check` WRITE) AND the I/O-failure sentinel are both
//    reused from allocator.pdx, since the inode-table region is a fixed
//    slab addressed directly from the superblock (itable_lba/itable_
//    bcount) and does NOT consume allocator.pdx's bitmap-tracked DATA
//    region -- `Allocator.alloc_block`/`free_block` are not called
//    anywhere in this file. Softarch should confirm this reading is
//    the intended one; if the brief instead meant something else, this
//    is the file to amend.
//
// 5. Resolver packing choice + landing site. §2.4/#1700's brief only says
//    "returns packed u64" and its arity note says the pair is "safe
//    because slot fits in 8 bits" -- it does not spell out which half
//    gets which bit range. This landing reads that note as: slot_in_block
//    occupies the low 8 bits (it needs only 5, since ITABLE_ROWS_PER_
//    BLOCK is 32, but KIND_INODE_HANDLE's own row tail (§2.4 item 3)
//    already commits slot_in_block to a full u8 field, so packing it into
//    the low byte here keeps both representations shift-compatible), and
//    inode_lba occupies the high 56 bits via `(inode_lba << 8) |
//    slot_in_block`, guarded by INODE_RESOLVER_LBA_OVERFLOW when
//    inode_lba's own top byte is already nonzero (>= 2^56 LBA -- not
//    reachable by any realistic volume, but the reserved code exists
//    precisely for this bound, so it is wired here rather than left
//    dead). This is also why inode_resolve lands in THIS file rather
//    than a new module: the file's own header (see "On-disk row layout"
//    below) already flagged inode_read/inode_write's private inline
//    block_idx/slot arithmetic as "the equivalent arithmetic... not
//    exposed as a symbol #1700 would need to supersede or call
//    through" -- #1700 adds the missing public symbol alongside that
//    private arithmetic without refactoring inode_read/inode_write to
//    call through it, to keep this landing's diff to the new function
//    only. Softarch should confirm both the packing direction and the
//    call-through deferral; if a future landing (e.g. #1699's
//    KIND_INODE_HANDLE row population, or M6's PXT_OP_CREATE) wants
//    inode_read/inode_write to compute their block_idx/slot via
//    inode_resolve instead of their own inline shr/and, that refactor
//    is straightforward (the arithmetic is provably identical) but is
//    left for whichever landing first needs single-sourced logic here.
//
// -----------------------------------------------------------------------------
// On-disk row layout (128 B) -- volume-fs-substrate.md §2.3, frozen
// -----------------------------------------------------------------------------
//
//   Offset  Size  Field          Type      Notes
//   ------  ----  -------------  --------  --------------------------------
//   0       8     header         u64 LE    in_use[63:56], file_type[55:48],
//                                           mode_bits[15:0]
//   8       8     inode_no       u64 LE    self-index
//   16      8     byte_len       u64 LE
//   24      8     created_ns     u64 LE
//   32      8     mtime_ns       u64 LE
//   40      8     refcount       u64 LE
//   48      8     root_block     u64 LE
//   56      8     cow_gen        u64 LE
//   64      8     content_hash   u64 LE
//   72      24    sig_prefix     u8[24]
//   96      32    sig_hash       u8[32]
//   Total   128
//
// 32 inodes pack into one 4096-byte block (itable_lba + inode_no/32);
// slot_in_block = inode_no % 32; byte offset within block = slot * 128.
// The public `inode_no -> (inode_lba, slot_in_block)` resolver is
// `inode_resolve` (#1700, landed below) -- inode_read/inode_write/
// inode_scrub_slot's own private inline block_idx/slot arithmetic
// (identical math, plus the in-block byte offset which inode_resolve
// does not compute) is left in place rather than refactored to call
// through inode_resolve; see "Design-doc gaps" item 5 above.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- 0xFFFFED18..ED1F (M4 sub-slice; see
// design/filesystem/r52-implementation-plan.md §4/§7.2). Full band
// frozen here (mirrors allocator.pdx's own posture for its M3 band);
// this landing WIRES four, REUSES one from M3 (see gap 4 above), and
// leaves three reserved for #1699/#1701.
// -----------------------------------------------------------------------------
//
//   INODE_INVALID_INDEX         = 0xFFFFED18  wired: inode_read/_write/
//                                              _scrub_slot's inode_no
//                                              resolves to a block_idx
//                                              >= itable_bcount, or (scrub
//                                              only) inode_no == 0.
//   INODE_HEADER_INUSE_BAD      = 0xFFFFED19  wired: inode_read's
//                                              post-copy sanity check
//                                              finds the row's in_use
//                                              byte is neither 0 nor 1
//                                              (torn/garbage header).
//   INODE_ALLOC_FRESH_EXHAUSTED = 0xFFFFED1A  wired: inode_alloc_fresh's
//                                              whole-region scan finds
//                                              no free (in_use==0,
//                                              inode_no != 0) slot.
//   INODE_TAIL_PREFIX_TEAR      = 0xFFFFED1B  reserved for #1701
//                                              (sig_verify.pdx).
//   INODE_TAIL_HASH_MISMATCH    = 0xFFFFED1C  reserved for #1701.
//   INODE_SIG_VERIFY_FAIL       = 0xFFFFED1D  reserved for #1701.
//   INODE_RESOLVER_LBA_OVERFLOW = 0xFFFFED1E  wired: inode_resolve's
//                                              computed inode_lba does
//                                              not fit in the packing's
//                                              56 high bits (top byte
//                                              of inode_lba nonzero).
//   INODE_SLOT_BOUNDS           = 0xFFFFED1F  reserved for #1699
//                                              (kind_inode_handle.pdx).
//
//   Reused from M3's band (see gap 4 above):
//   ALLOC_BITMAP_TORN (0xFFFFED11, allocator.pdx) -- every BDEV READ/
//     WRITE issued by this file (itable_ensure_block_loaded's READ,
//     inode_write's/inode_scrub_slot's/inode_alloc_fresh's WRITE) that
//     did not report an acceptable status per bbjw_check.
//
// -----------------------------------------------------------------------------
// Storage (single-writer per field; helpers in this file only)
// -----------------------------------------------------------------------------
//
// `_itable_state` : [u64; 8] @align(8)
//   +0  init_mark        ITABLE_INIT_MARK once itable_init has run
//   +8  itable_lba        cached from sb_itable_lba (superblock.pdx, #1682)
//   +16 itable_bcount     cached from sb_itable_bcount
//   +24 loaded_block_idx  which relative block index (0..itable_bcount)
//                         is resident in _itable_blk_buf;
//                         0xFFFFFFFFFFFFFFFF = none loaded
//   +32/+40/+48/+56 reserved, not yet assigned
//
// `_itable_blk_buf`      : [u64; 512] @align(4096) -- the one resident
//                          4-KiB inode-table block (32 rows * 16 qwords).
// `_itable_desc`         : [u64; 4]   @align(4096) -- the BDEV_OP_READ_LBA
//                          descriptor page used by itable_ensure_block_
//                          loaded (writes go through bdev_barrier_write,
//                          which owns its own descriptor page internally).
// `_itable_row_scratch`  : [u64; 16]  @align(64) -- the 128-byte row copy
//                          inode_read returns a pointer into; decoupled
//                          from _itable_blk_buf so the returned pointer
//                          stays valid across a later block swap.
// `_itable_alloc_scratch`: [u64; 16]  @align(64) -- the 128-byte fresh-row
//                          scratch inode_alloc_fresh builds before
//                          handing it to inode_write.
//
// All five tables are written only by helpers in this file; confined at
// build time via tools/build.sh ec_confine_one.
//
// -----------------------------------------------------------------------------
// Durable writes -- bdev_barrier.pdx (#1676), reused per allocator.pdx's
// own precedent (see gap 4 above for the reused ALLOC_BITMAP_TORN code).
// -----------------------------------------------------------------------------
//
// Every inode-table block WRITE goes through bdev_barrier_write (records
// the (op_code=4, lba) submission event before issuing cap_invoke); every
// READ is a raw cap_invoke (op_code 3), matching allocator.pdx's own
// alloc_bm_ensure_loaded posture -- reads are not part of the write-
// barrier ordering discipline. Every WRITE and every READ this module
// issues has its cap_invoke-forwarded result checked via BdevBarrier.
// bbjw_check (0 = BDEV_ERR_OK, 0xFFFFEC58 = NVMEIO_PICK_NONE, both
// acceptable per that function's own header note). No BDEV_OP_FLUSH is
// issued here -- durability across a crash is the journal's job (R52.M5,
// WAL replay), not this milestone's, exactly matching allocator.pdx's
// own posture for the same reason.
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §5.1)
// -----------------------------------------------------------------------------
//
// itable_init(sb_ptr) = 1. itable_ensure_block_loaded(bdev_cap,
// block_idx) = 2. inode_read(bdev_cap, inode_no) = 2.
// inode_write(bdev_cap, inode_no, row_ptr) = 3 -- the row-pointer
// collapse §5.1's table names for this exact function (naive arity 11
// avoided). inode_alloc_fresh(bdev_cap) = 1 (assumes itable_init has
// run -- see gap 2). inode_scrub_slot(bdev_cap, inode_no) = 2.
// inode_resolve(sb_ptr, inode_no) = 2 -- §2.4's own "resolver arity
// note" observes the two logical return values (inode_lba,
// slot_in_block) pack into one u64 return since slot fits in 8 bits, so
// no output-arg scratch is needed here (contrast inode_alloc_fresh's
// 3-value return, which does need one -- see §5.1's table, deferred to
// a future landing since #1700's own scope is the resolver only).
// Every arity sits far under the paideia-as ceiling of 6.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// itable_init: 1 push (rbx = sb_ptr, reloaded before each of the 2 sb_*
// accessor calls), same shape as allocator.pdx's alloc_init. Entry
// rsp%16==8 + 8 = 16, %16==0.
// itable_ensure_block_loaded: 3 pushes (rbx=bdev_cap, r12=block_idx,
// r13=unused-but-pushed for alignment/pattern uniformity -- block_idx
// must survive the nested cap_invoke call to stamp loaded_block_idx
// afterward, unlike allocator.pdx's alloc_bm_ensure_loaded which always
// targets the single fixed alloc_lba block and needs no such carry).
// Entry rsp%16==8 + 24 = 32, %16==0.
// inode_read: 3 pushes (rbx=bdev_cap, r12=block_idx, r13=row_byte_
// offset). Entry rsp%16==8 + 24 = 32, %16==0.
// inode_write/inode_alloc_fresh/inode_scrub_slot: 5 pushes (rbx/r12/
// r13/r14/r15), matching the uniform 5-push shape allocator.pdx's
// alloc_block/free_block/alloc_scan_on_mount already establish for
// "several nested calls, a handful of live values". Entry rsp%16==8 +
// 40 = 48, %16==0.
// inode_resolve: 1 push (rbx=inode_no, saved across the single nested
// sb_itable_lba(sb_ptr) call -- sb_ptr itself needs no saving, it is
// consumed directly as the call's own rdi argument and never read
// again), same shape as itable_init's single-nested-call prologue.
// Entry rsp%16==8 + 8 = 16, %16==0.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity memory access anywhere in this module -- the
// in_use byte is extracted from an already-loaded qword via shr+and
// (register-level, not memory-level), so no mov_b is needed, mirroring
// superblock.pdx's sb_flags / allocator.pdx's whole-qword-only posture.
// No test instruction anywhere; every zero/nonzero and ordering check
// uses cmp reg, imm / cmp reg, reg + je/jne/jb/jae. Every label is
// prefixed with its owning function's abbreviation (itable_init needs
// none -- straight-line body; `iebl_` for itable_ensure_block_loaded,
// `ir_` for inode_read, `iw_` for inode_write, `iaf_` for
// inode_alloc_fresh, `iss_` for inode_scrub_slot, `inrs_` for
// inode_resolve -- distinct from `ir_` to avoid colliding with
// inode_read's own labels in this same module), per the reserved-
// label discipline.

module InodeTable = structure {

  // ============================================================================
  // M4 failure taxonomy -- 0xFFFFED18..ED1F (full band frozen; see header).
  // ============================================================================

  pub let INODE_INVALID_INDEX         : u64 = 0xFFFFED18
  pub let INODE_HEADER_INUSE_BAD      : u64 = 0xFFFFED19
  pub let INODE_ALLOC_FRESH_EXHAUSTED : u64 = 0xFFFFED1A
  pub let INODE_TAIL_PREFIX_TEAR      : u64 = 0xFFFFED1B   // reserved for #1701
  pub let INODE_TAIL_HASH_MISMATCH    : u64 = 0xFFFFED1C   // reserved for #1701
  pub let INODE_SIG_VERIFY_FAIL       : u64 = 0xFFFFED1D   // reserved for #1701
  pub let INODE_RESOLVER_LBA_OVERFLOW : u64 = 0xFFFFED1E   // wired by inode_resolve (#1700)
  pub let INODE_SLOT_BOUNDS           : u64 = 0xFFFFED1F   // reserved for #1699

  // ============================================================================
  // Geometry / misc constants.
  // ============================================================================

  pub let ITABLE_ROW_BYTES       : u64 = 128
  pub let ITABLE_ROWS_PER_BLOCK  : u64 = 32
  pub let ITABLE_BLOCK_BYTES     : u64 = 4096
  pub let INODE_SENTINEL         : u64 = 0    // permanent invalid-inode index
  pub let INODE_ROOT             : u64 = 1    // mkfs-time root directory
  pub let ITABLE_INIT_MARK       : u64 = 0x17AB1E
  pub let ITABLE_NO_BLOCK_LOADED : u64 = 0xFFFFFFFFFFFFFFFF

  // ============================================================================
  // Storage.
  // ============================================================================

  pub let mut _itable_state : [u64; 8] = uninit @align(8)

  pub let mut _itable_blk_buf : [u64; 512] = uninit @align(4096)
  pub let mut _itable_desc    : [u64; 4]   = uninit @align(4096)

  pub let mut _itable_row_scratch   : [u64; 16] = uninit @align(64)
  pub let mut _itable_alloc_scratch : [u64; 16] = uninit @align(64)

  // ============================================================================
  // itable_init(sb_ptr: u64) -> u64
  //   Seeds itable_lba/itable_bcount from the #1682 superblock accessors,
  //   marks the resident inode-table block unloaded, installs
  //   ITABLE_INIT_MARK. Always returns 0.
  // ============================================================================
  pub let itable_init : (u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M4-002 (#1698). 1-push prologue (rbx = sb_ptr) lands rsp%16==0 for the 2 nested sb_* accessor calls (entry rsp%16==8 + 8 = 16), same shape as allocator.pdx's alloc_init. Body: (1) rbx=sb_ptr. (2) rdi=rbx; call sb_itable_lba; r10=rax. (3) rdi=rbx; call sb_itable_bcount (rax holds itable_bcount, stored immediately -- no register pressure issue since nothing else is live). (4) Stamp _itable_state: [+8]=r10 (itable_lba), [+16]=rax (itable_bcount), [+24]=ITABLE_NO_BLOCK_LOADED (all-ones sentinel), [+0]=ITABLE_INIT_MARK. (5) xor eax,eax; pop rbx; ret. Reserved labels: none needed (straight-line body). Cross-module calls to sb_itable_lba/sb_itable_bcount (superblock.pdx, module Superblock) follow the same flat-symbol-namespace convention allocator.pdx's own alloc_init already uses to call sb_alloc_lba et al.",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rdi, rbx;
        call sb_itable_lba;
        mov r10, rax;

        mov rdi, rbx;
        call sb_itable_bcount;

        lea r9, [rip + _itable_state];
        mov [r9 + 8], r10;
        mov [r9 + 16], rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        mov [r9 + 24], r10;
        mov r10, 0x17AB1E;
        mov [r9 + 0], r10;

        xor eax, eax;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // inode_resolve(sb_ptr: u64, inode_no: u64) -> u64                  [#1700]
  //   Pure arithmetic resolver: inode_no -> (inode_lba, slot_in_block),
  //   packed as (inode_lba << 8) | slot_in_block (see header "Design-doc
  //   gaps" item 5 for the packing-direction rationale). Reads only
  //   sb_itable_lba(sb_ptr) -- does NOT require itable_init to have run
  //   and does NOT touch _itable_state. Returns
  //   INODE_RESOLVER_LBA_OVERFLOW if the computed inode_lba's own top
  //   byte is nonzero (would not survive the << 8 packing losslessly).
  // ============================================================================
  pub let inode_resolve : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (inode_no: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M4-004 (#1700). 1-push prologue (rbx = inode_no) lands rsp%16==0 for the single nested sb_itable_lba(sb_ptr) call (entry rsp%16==8 + 8 = 16), same shape as itable_init's own prologue. sb_ptr (rdi) is consumed directly as the call's own argument and needs no saving -- it is never read again after the call. Body: (1) push rbx; rbx=inode_no(rsi) (rdi still holds sb_ptr, untouched). (2) call sb_itable_lba (rdi already = sb_ptr); rax = itable_lba. (3) rcx=rbx; shr rcx,5 (block_idx = inode_no/32, safe imm8 shift); add rax,rcx (rax = inode_lba = itable_lba + block_idx). (4) overflow check: r10=rax; shr r10,56 (top byte); cmp r10,0; jne overflow (packing into the high 56 bits via << 8 below would lose data). (5) rcx=rbx; and rcx,31 (slot_in_block = inode_no%32, safe direct imm); shl rax,8; or rax,rcx (pack: high 56 bits = inode_lba, low 8 bits = slot_in_block); jmp done. overflow: mov rax,0xFFFFED1E (INODE_RESOLVER_LBA_OVERFLOW). done: pop rbx; ret. No test instruction (cmp+jne only); no mov_b (no byte-granularity memory access -- the overflow check is a register-level shr+cmp over an already-loaded value). Reserved labels: inrs_ (distinct from inode_read's ir_ prefix in this same module).",
      block: {
        push rbx;

        mov rbx, rsi;

        call sb_itable_lba;

        mov rcx, rbx;
        shr rcx, 5;
        add rax, rcx;

        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        jne inrs_overflow;

        mov rcx, rbx;
        and rcx, 31;
        shl rax, 8;
        or rax, rcx;
        jmp inrs_done;

      inrs_overflow:
        mov rax, 0xFFFFED1E;

      inrs_done:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // itable_ensure_block_loaded(bdev_cap: u64, block_idx: u64) -> u64
  //   If the resident block already holds block_idx's inode-table block
  //   (loaded_block_idx == block_idx), no-op (returns 0). Else issues a
  //   single BDEV_OP_READ_LBA(itable_lba + block_idx, 1 block) into
  //   _itable_blk_buf. Returns 0 on success, the reused ALLOC_BITMAP_TORN
  //   (0xFFFFED11, allocator.pdx) if the read's forwarded status was not
  //   acceptable per BdevBarrier.bbjw_check.
  // ============================================================================
  pub let itable_ensure_block_loaded : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (block_idx: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M4-002 (#1698). 3-push prologue (rbx=bdev_cap, r12=block_idx, r13=unused-but-pushed for alignment/pattern uniformity) lands rsp%16==0 for the nested cap_invoke + bbjw_check calls (entry rsp%16==8 + 24 = 32). block_idx must survive the nested cap_invoke call (to stamp loaded_block_idx afterward), unlike allocator.pdx's alloc_bm_ensure_loaded which always targets the single fixed alloc_lba block. Body: (1) rbx=bdev_cap, r12=block_idx. (2) r10=&_itable_state; rax=[r10+24] (loaded_block_idx); cmp rax,r12; je ok (already resident). (3) rax=[r10+8] (itable_lba); add rax,r12 (target lba). (4) r11=&_itable_desc; stamp [+0]=target lba, [+8]=1 (nblocks), [+16]=&_itable_blk_buf, [+24]=0 (status_out) -- same descriptor-staging idiom as allocator.pdx's alloc_bm_ensure_loaded/alloc_bm_load_block. (5) rdi=rbx; rsi=r11 OR'd with BDEV_OP_READ_LBA(3) via r9 (r11's low 12 bits are guaranteed zero by @align(4096)); call cap_invoke. (6) rdi=rax; call bbjw_check; cmp rax,0; jne bad. (7) mark loaded_block_idx=r12; xor eax,eax; jmp done. bad: mov rax,0xFFFFED11 (reused ALLOC_BITMAP_TORN, allocator.pdx -- see header gap 4); jmp done. ok: xor eax,eax. done: pop r13; pop r12; pop rbx; ret. Reserved labels: iebl_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        lea r10, [rip + _itable_state];
        mov rax, [r10 + 24];
        cmp rax, r12;
        je iebl_ok;

        mov rax, [r10 + 8];
        add rax, r12;

        lea r11, [rip + _itable_desc];
        mov [r11 + 0], rax;
        mov rax, 1;
        mov [r11 + 8], rax;
        lea rax, [rip + _itable_blk_buf];
        mov [r11 + 16], rax;
        xor rax, rax;
        mov [r11 + 24], rax;

        mov rdi, rbx;
        mov rsi, r11;
        mov r9, 3;
        or rsi, r9;
        call cap_invoke;

        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne iebl_bad;

        lea r10, [rip + _itable_state];
        mov [r10 + 24], r12;
        xor eax, eax;
        jmp iebl_done;

      iebl_bad:
        mov rax, 0xFFFFED11;
        jmp iebl_done;

      iebl_ok:
        xor eax, eax;

      iebl_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // inode_read(bdev_cap: u64, inode_no: u64) -> u64
  //   Returns a pointer to a 128-byte in-memory copy of inode_no's
  //   on-disk row (_itable_row_scratch), or INODE_INVALID_INDEX / the
  //   reused ALLOC_BITMAP_TORN / INODE_HEADER_INUSE_BAD.
  // ============================================================================
  pub let inode_read : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (inode_no: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M4-002 (#1698). 3-push prologue (rbx=bdev_cap, r12=block_idx, r13=row_byte_offset) lands rsp%16==0 for the nested itable_ensure_block_loaded call (entry rsp%16==8 + 24 = 32). Body: (1) rbx=bdev_cap(rdi). (2) rax=inode_no(rsi); rcx=rax; shr rcx,5 (block_idx = inode_no/32, safe imm8 shift); r12=rcx. (3) rax=inode_no(rsi, reloaded); and rax,31 (slot_in_block = inode_no%32, safe direct imm); shl rax,7 (*128 = row_byte_offset); r13=rax. (4) bound check: r10=&_itable_state; rax=[r10+16] (itable_bcount); cmp r12,rax; jae bad_index. (5) rdi=rbx; rsi=r12; call itable_ensure_block_loaded; cmp rax,0; jne torn. (6) splice-copy 16 qwords from &_itable_blk_buf+r13 into &_itable_row_scratch via a manual rcx=0..16 loop (no rep movsq precedent in this codebase). (7) header sanity: rax=[_itable_row_scratch+0]; rcx=rax; shr rcx,56; and rcx,0xFF (in_use byte); cmp rcx,0; je hdr_ok; cmp rcx,1; je hdr_ok; jmp hdr_bad. hdr_ok: rax=&_itable_row_scratch (lea); jmp done. hdr_bad: rax=INODE_HEADER_INUSE_BAD; jmp done. bad_index: rax=INODE_INVALID_INDEX; jmp done. torn: rax=0xFFFFED11 (reused ALLOC_BITMAP_TORN). done: 3-pop epilogue + ret. No test instruction; no mov_b (in_use extraction is register-level shr/and over an already-loaded qword, not a byte-granularity memory access). Reserved labels: ir_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        mov rax, rsi;
        mov rcx, rax;
        shr rcx, 5;
        mov r12, rcx;

        mov rax, rsi;
        and rax, 31;
        shl rax, 7;
        mov r13, rax;

        lea r10, [rip + _itable_state];
        mov rax, [r10 + 16];
        cmp r12, rax;
        jae ir_bad_index;

        mov rdi, rbx;
        mov rsi, r12;
        call itable_ensure_block_loaded;
        cmp rax, 0;
        jne ir_torn;

        lea r11, [rip + _itable_blk_buf];
        add r11, r13;
        lea r10, [rip + _itable_row_scratch];
        mov rcx, 0;

      ir_copy_top:
        cmp rcx, 16;
        jae ir_copy_done;
        mov rax, [r11 + rcx * 8];
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp ir_copy_top;

      ir_copy_done:
        lea r10, [rip + _itable_row_scratch];
        mov rax, [r10 + 0];
        mov rcx, rax;
        shr rcx, 56;
        and rcx, 0xFF;
        cmp rcx, 0;
        je ir_hdr_ok;
        cmp rcx, 1;
        je ir_hdr_ok;
        jmp ir_hdr_bad;

      ir_hdr_ok:
        lea rax, [rip + _itable_row_scratch];
        jmp ir_done;

      ir_hdr_bad:
        mov rax, 0xFFFFED19;
        jmp ir_done;

      ir_bad_index:
        mov rax, 0xFFFFED18;
        jmp ir_done;

      ir_torn:
        mov rax, 0xFFFFED11;

      ir_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // inode_write(bdev_cap: u64, inode_no: u64, row_ptr: u64) -> u64
  //   Splices the 128 bytes at row_ptr into the resident inode-table
  //   block at inode_no's slot (after ensuring that block is loaded, so
  //   the other 31 rows in the block are preserved) and durably writes
  //   the whole 4-KiB block back. Returns 0 on success, INODE_INVALID_
  //   INDEX or the reused ALLOC_BITMAP_TORN on failure.
  // ============================================================================
  pub let inode_write : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (inode_no: u64) (row_ptr: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M4-002 (#1698). 5-push prologue (rbx=bdev_cap, r12=block_idx, r13=row_byte_offset, r14=row_ptr, r15=unused-but-pushed for pattern uniformity with allocator.pdx's alloc_block/free_block) lands rsp%16==0 (entry rsp%16==8 + 40 = 48) for every nested call below. Body: (1) rbx=bdev_cap(rdi), r14=row_ptr(rdx) -- saved first since rdx is caller-save and would not survive the nested calls below. (2) rax=inode_no(rsi); rcx=rax; shr rcx,5; r12=rcx (block_idx). (3) rax=inode_no(rsi, reloaded); and rax,31; shl rax,7; r13=rax (row_byte_offset). (4) bound check: r10=&_itable_state; rax=[r10+16]; cmp r12,rax; jae bad_index. (5) rdi=rbx; rsi=r12; call itable_ensure_block_loaded; cmp rax,0; jne torn (read-modify-write: the existing block content must be resident before the splice so the other 31 rows are preserved). (6) splice-copy 16 qwords from r14 into &_itable_blk_buf+r13 via a manual rcx=0..16 loop. (7) rdi=rbx; r10=&_itable_state; rsi=[r10+8]+r12 (target lba); rdx=1; rcx=&_itable_blk_buf; call bdev_barrier_write; rdi=rax; call bbjw_check; cmp rax,0; jne torn. (8) xor eax,eax; jmp done. bad_index: rax=INODE_INVALID_INDEX; jmp done. torn: rax=0xFFFFED11 (reused ALLOC_BITMAP_TORN). done: 5-pop epilogue + ret. No test instruction; no mov_b. Reserved labels: iw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r14, rdx;

        mov rax, rsi;
        mov rcx, rax;
        shr rcx, 5;
        mov r12, rcx;

        mov rax, rsi;
        and rax, 31;
        shl rax, 7;
        mov r13, rax;

        lea r10, [rip + _itable_state];
        mov rax, [r10 + 16];
        cmp r12, rax;
        jae iw_bad_index;

        mov rdi, rbx;
        mov rsi, r12;
        call itable_ensure_block_loaded;
        cmp rax, 0;
        jne iw_torn;

        lea r11, [rip + _itable_blk_buf];
        add r11, r13;
        mov rcx, 0;

      iw_copy_top:
        cmp rcx, 16;
        jae iw_copy_done;
        mov rax, [r14 + rcx * 8];
        mov [r11 + rcx * 8], rax;
        add rcx, 1;
        jmp iw_copy_top;

      iw_copy_done:
        mov rdi, rbx;
        lea r10, [rip + _itable_state];
        mov rsi, [r10 + 8];
        add rsi, r12;
        mov rdx, 1;
        lea rcx, [rip + _itable_blk_buf];
        call bdev_barrier_write;
        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne iw_torn;

        xor eax, eax;
        jmp iw_done;

      iw_bad_index:
        mov rax, 0xFFFFED18;
        jmp iw_done;

      iw_torn:
        mov rax, 0xFFFFED11;

      iw_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // inode_alloc_fresh(bdev_cap: u64) -> u64
  //   Scans every inode-table block in turn (block_idx = 0 ..
  //   itable_bcount-1), and within each, every slot (0..31), for the
  //   first row whose header in_use byte is 0 and whose inode_no
  //   (block_idx*32 + slot) is not INODE_SENTINEL (0, the permanent
  //   invalid-inode index -- never allocated). On the first such slot,
  //   constructs a minimal fresh row in _itable_alloc_scratch (in_use=1,
  //   file_type=0, mode_bits=0, inode_no=candidate, every other field
  //   zero except refcount=1), durably writes it via inode_write, and
  //   returns the candidate inode_no. Returns INODE_ALLOC_FRESH_
  //   EXHAUSTED if the whole region is scanned with no free slot found,
  //   or the reused ALLOC_BITMAP_TORN if a per-block read or the final
  //   write fails. Precondition: itable_init(sb_ptr) has already run in
  //   this boot (see header gap 2).
  // ============================================================================
  pub let inode_alloc_fresh : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M4-002 (#1698). 5-push prologue (rbx=bdev_cap, r12=itable_bcount, r13=block_idx, r14=slot, r15=candidate inode_no) lands rsp%16==0 (entry rsp%16==8 + 40 = 48) for every nested call below, matching allocator.pdx's alloc_scan_on_mount shape. Body: (1) rbx=bdev_cap(rdi). (2) r10=&_itable_state; r12=[r10+16] (itable_bcount). (3) r13=0 (block_idx). blk_top: cmp r13,r12; jae exhausted. (4) rdi=rbx; rsi=r13; call itable_ensure_block_loaded; cmp rax,0; jne torn. (5) r14=0 (slot). slot_top: cmp r14,32; jae blk_done (advance to next block). (6) rax=r14; shl rax,4 (slot*16 = header's word index within _itable_blk_buf); r10=&_itable_blk_buf; r11=[r10+rax*8] (header word); rcx=r11; shr rcx,56; and rcx,0xFF (in_use byte); cmp rcx,0; jne slot_next (occupied). (7) rax=r13; shl rax,5; add rax,r14 (candidate = block_idx*32+slot); r15=rax; cmp r15,0; je slot_next (skip the permanent sentinel). (8) found: zero all 16 qwords of _itable_alloc_scratch via a manual rcx=0..16 loop. (9) mov rax,1; shl rax,56 (in_use=1, file_type=0, mode_bits=0); store at _itable_alloc_scratch+0 (header). store r15 at +8 (inode_no). mov rax,1; store at +40 (refcount=1). (10) rdi=rbx; rsi=r15; rdx=&_itable_alloc_scratch (lea); call inode_write; cmp rax,0; jne write_fail (rax already holds inode_write's forwarded error code). (11) rax=r15 (return candidate inode_no); jmp done. slot_next: add r14,1; jmp slot_top. blk_done: add r13,1; jmp blk_top. exhausted: rax=INODE_ALLOC_FRESH_EXHAUSTED; jmp done. torn: rax=0xFFFFED11 (reused ALLOC_BITMAP_TORN). write_fail: (rax already set by inode_write) jmp done. done: 5-pop epilogue + ret. No test instruction; no mov_b. Reserved labels: iaf_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;

        lea r10, [rip + _itable_state];
        mov r12, [r10 + 16];

        xor r13, r13;

      iaf_blk_top:
        cmp r13, r12;
        jae iaf_exhausted;

        mov rdi, rbx;
        mov rsi, r13;
        call itable_ensure_block_loaded;
        cmp rax, 0;
        jne iaf_torn;

        xor r14, r14;

      iaf_slot_top:
        cmp r14, 32;
        jae iaf_blk_done;

        mov rax, r14;
        shl rax, 4;
        lea r10, [rip + _itable_blk_buf];
        mov r11, [r10 + rax * 8];
        mov rcx, r11;
        shr rcx, 56;
        and rcx, 0xFF;
        cmp rcx, 0;
        jne iaf_slot_next;

        mov rax, r13;
        shl rax, 5;
        add rax, r14;
        mov r15, rax;
        cmp r15, 0;
        je iaf_slot_next;

        jmp iaf_found;

      iaf_slot_next:
        add r14, 1;
        jmp iaf_slot_top;

      iaf_blk_done:
        add r13, 1;
        jmp iaf_blk_top;

      iaf_found:
        lea r10, [rip + _itable_alloc_scratch];
        xor rax, rax;
        mov rcx, 0;

      iaf_zero_top:
        cmp rcx, 16;
        jae iaf_zero_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp iaf_zero_top;

      iaf_zero_done:
        lea r10, [rip + _itable_alloc_scratch];
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;
        mov [r10 + 8], r15;
        mov rax, 1;
        mov [r10 + 40], rax;

        mov rdi, rbx;
        mov rsi, r15;
        lea rdx, [rip + _itable_alloc_scratch];
        call inode_write;
        cmp rax, 0;
        jne iaf_done;

        mov rax, r15;
        jmp iaf_done;

      iaf_exhausted:
        mov rax, 0xFFFFED1A;
        jmp iaf_done;

      iaf_torn:
        mov rax, 0xFFFFED11;

      iaf_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // inode_scrub_slot(bdev_cap: u64, inode_no: u64) -> u64
  //   Zeroes an inode row's full 128 bytes in place (wiping header,
  //   identity, and every content/signature reference) and durably
  //   writes the block back. The free-list counterpart to
  //   inode_alloc_fresh, mirroring allocator.pdx's free_block. Refuses
  //   inode_no == INODE_SENTINEL (0) -- the permanent invalid-inode
  //   slot is never a scrub target.
  // ============================================================================
  pub let inode_scrub_slot : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (inode_no: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M4-002 (#1698). 5-push prologue (rbx=bdev_cap, r12=block_idx, r13=row_byte_offset, r14/r15=unused-but-pushed for pattern uniformity with inode_write) lands rsp%16==0 (entry rsp%16==8 + 40 = 48). Body: (1) rbx=bdev_cap(rdi). (2) rax=inode_no(rsi); cmp rax,0; je bad_index (protect the permanent sentinel). (3) rcx=rax; shr rcx,5; r12=rcx (block_idx). (4) rax=inode_no(rsi, reloaded); and rax,31; shl rax,7; r13=rax (row_byte_offset). (5) bound check: r10=&_itable_state; rax=[r10+16]; cmp r12,rax; jae bad_index. (6) rdi=rbx; rsi=r12; call itable_ensure_block_loaded; cmp rax,0; jne torn. (7) zero all 16 qwords at &_itable_blk_buf+r13 via a manual rcx=0..16 loop. (8) rdi=rbx; r10=&_itable_state; rsi=[r10+8]+r12; rdx=1; rcx=&_itable_blk_buf; call bdev_barrier_write; rdi=rax; call bbjw_check; cmp rax,0; jne torn. (9) xor eax,eax; jmp done. bad_index: rax=INODE_INVALID_INDEX; jmp done. torn: rax=0xFFFFED11 (reused ALLOC_BITMAP_TORN). done: 5-pop epilogue + ret. No test instruction; no mov_b. Reserved labels: iss_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;

        mov rax, rsi;
        cmp rax, 0;
        je iss_bad_index;

        mov rcx, rax;
        shr rcx, 5;
        mov r12, rcx;

        mov rax, rsi;
        and rax, 31;
        shl rax, 7;
        mov r13, rax;

        lea r10, [rip + _itable_state];
        mov rax, [r10 + 16];
        cmp r12, rax;
        jae iss_bad_index;

        mov rdi, rbx;
        mov rsi, r12;
        call itable_ensure_block_loaded;
        cmp rax, 0;
        jne iss_torn;

        lea r10, [rip + _itable_blk_buf];
        add r10, r13;
        xor rax, rax;
        mov rcx, 0;

      iss_zero_top:
        cmp rcx, 16;
        jae iss_zero_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp iss_zero_top;

      iss_zero_done:
        mov rdi, rbx;
        lea r10, [rip + _itable_state];
        mov rsi, [r10 + 8];
        add rsi, r12;
        mov rdx, 1;
        lea rcx, [rip + _itable_blk_buf];
        call bdev_barrier_write;
        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne iss_torn;

        xor eax, eax;
        jmp iss_done;

      iss_bad_index:
        mov rax, 0xFFFFED18;
        jmp iss_done;

      iss_torn:
        mov rax, 0xFFFFED11;

      iss_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
