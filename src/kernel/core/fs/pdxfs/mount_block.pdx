// src/kernel/core/fs/pdxfs/mount_block.pdx -- R52.M5-005 (#1707)
//
// PDXFS-ON-BLOCK v1 -- MOUNT_BACKEND_PDXFS_BLOCK ENTRY POINT.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/filesystem/r52-implementation-plan.md §2.5 step 5 (#1707) /
// design/filesystem/volume-fs-substrate.md §3.2. The calling task's own
// framing: "Takes a bdev cap + optional UUID hint. Calls #1706's probe
// to find the volume. Runs journal_replay via #1704/#1705. Mints
// KIND_VOLUME + returns handle." This file is that entry point,
// `mount_pdxfs_block`.
//
// `core/fs/mount.pdx`'s existing `mount(path_ptr, backend_type)` is
// deliberately NOT extended to accept backend_type 5 -- that function
// is vnode-pool-only (bootstrap/submount over `vnode_alloc` +
// `path_resolve`) and has no bdev_cap argument to thread through it.
// design/filesystem/volume-fs-substrate.md §3.2 itself frames R52.M5's
// change as extending "the mount TABLE" (the discriminant + the
// `_mount_table` reserved-field convention), not the `mount()`
// FUNCTION's control flow. `mount_pdxfs_block` writes a `_mount_table`
// entry directly (see §3.2: "the 16-bit reserved field ... is
// populated with the KIND_VOLUME row index for PDXFS_BLOCK mounts"),
// matching `mount()`'s own Phase-3 (free-slot scan) and Phase-6 (entry
// pack) shape but with a volume-cap flow standing in for `mount()`'s
// vnode-alloc flow.
//
// -----------------------------------------------------------------------------
// Why this can be a real implementation and not just a design-doc
// placeholder, as of this commit (2026-08-23)
// -----------------------------------------------------------------------------
//
// Every building block this function calls is ALREADY LANDED in this
// tree:
//   - `probe_one_bdev` (probe.pdx, #1706) -- THIS IS "#1706's probe"
//     the calling task names. It reads + validates LBA 0 of the given
//     `KIND_BLKDEV` slot (via `sb_read`) and idempotently registers the
//     volume into the uuid-keyed registry (via `volume_registry_
//     register`), returning a `KIND_VOLUME` row_id or forwarding
//     whatever sentinel `sb_read`/`volume_registry_register` produced.
//     Calling it here (rather than re-deriving its logic inline) is
//     the literal, direct answer to "Calls #1706's probe to find the
//     volume".
//   - `sb_read` / `sb_uuid_lo` / `sb_uuid_hi` / `sb_journal_lba` /
//     `sb_journal_bcount` (superblock_read.pdx #1686, superblock.pdx
//     #1682) -- `probe_one_bdev` does not expose its own internal
//     `sb_ptr` to its caller, so this function re-reads block 0 once
//     more (a second, side-effect-free `sb_read` call -- pure,
//     idempotent, explicitly safe to call any number of times, see
//     that module's own header) purely to fetch the journal region
//     fields and the uuid this function needs for its OWN work (the
//     uuid-hint gate, §3.3 bullet 1; the journal_replay call, §4.3)
//     that `probe_one_bdev`'s narrower registration-only contract does
//     not surface.
//   - `journal_replay` (journal_ondisk.pdx #1704) -- the real on-disk
//     JBNL cold-boot walker (backward-walk-to-checkpoint,
//     forward-CSUM-verified-walk, per-record classification). Note:
//     the FILE `journal_replay.pdx` (#1705's target) is still the R42
//     BSS-classification scaffold as of this commit -- #1705 remains
//     open to decide whether that file becomes a thin wrapper over
//     THIS on-disk walker or is retired in its favour (journal_ondisk.
//     pdx's own header, gap statement after "Scope note"). This file
//     calls the ALREADY-REAL on-disk walker (journal_ondisk.pdx's
//     `journal_replay`) directly, satisfying "Runs journal_replay via
//     #1704/#1705" from the #1704 side without waiting on #1705's
//     file-identity decision.
//   - `journal_checkpoint_lba` / `journal_writer_set_checkpoint`
//     (journal_ondisk.pdx #1708) -- checkpoint read-back / advance,
//     keyed by KIND_VOLUME row_id (both bound-check against 16,
//     matching KIND_VOLUME's own 16-row ceiling -- confirming row_id
//     IS the intended "vol_slot" these two functions expect, the same
//     row_id `probe_one_bdev`/`volume_registry_register` produce).
//   - `volume_row_mount_slot_set` / `cap_mint_write` (kind_volume.pdx
//     #1703, cap/mint.pdx) -- stamp the mount_slot back-pointer onto
//     the row and install the cap-table handle.
//
// -----------------------------------------------------------------------------
// What is deliberately NOT done here (flagged gaps)
// -----------------------------------------------------------------------------
//
// 1. No multi-device iteration inside THIS function. `probe.pdx`
//    already landed that layer separately (`probe_all_bdevs`, "iterate
//    every live KIND_BLKDEV"); a caller wanting a full "probe
//    everything, then pick a root and mount it" boot sequence calls
//    `probe_all_bdevs` first (or relies on it having already run) and
//    then calls THIS function once, pointed at the specific bdev_cap
//    it wants mounted. Root-selection policy across MULTIPLE probed
//    volumes (§3.3: bootloader hint / superblock root-flag /
//    single-device disambiguation) is therefore also out of scope
//    here -- `uuid_hint_lo`/`uuid_hint_hi` implements exactly bullet 1
//    of §3.3 (an authoritative hint the caller already resolved),
//    refusing with `MOUNT_ROOT_AMBIGUOUS` if the device this function
//    was pointed at does not carry the requested UUID; a caller with
//    NO hint (both zero) accepts whatever volume is on the device,
//    matching §3.3 bullet 3's single-device fallback in the
//    degenerate one-caller-one-device case.
// 2. No ML-DSA-65 signature cross-check (§6.4's "Volume mount
//    cross-checks superblock.sig_key_hash == KIND_SIG_KEY.key_hash").
//    Both volume_registry.pdx's and probe.pdx's own headers already
//    flag this as deferred to mount-time / #1707 without closing it
//    ("Sig cross-checking is a MOUNT-time act ... not a probe-time
//    act ... #1707 does not assume this file already closed that
//    gate"). It remains open here too: no KIND_SIG_KEY slot is
//    threaded through this function's arguments, and `sig_verify.pdx`
//    (#1701) verifies INODE sig-tails, not the superblock's
//    `sig_key_hash` field -- a superblock-vs-KIND_SIG_KEY cross-check
//    module does not exist yet in this tree. Flagged for a follow-up
//    once a loader-supplied KIND_SIG_KEY threading convention is
//    designed.
// 3. No VFS vnode-pool integration. mp_idx/root_idx (bits [0,32) of the
//    mount-table entry) are stamped VNODE_IDX_NONE (0xFFFF) rather
//    than a real vnode -- bridging path_resolve's vnode-indexed walk
//    to the inode-indexed PdxFS-on-block walker is not specified by
//    any landed design doc section; it plausibly lands alongside
//    R52.M6/M7's real vops adapters (vops_block.pdx, this milestone's
//    sibling file, stubs all five data-path slots for the same
//    reason).
// 4. Checkpoint discovery on a truly cold boot (row never before
//    registered by this kernel instance) falls back to journal_lba
//    (start of journal region) when `journal_checkpoint_lba` reads 0
//    (its own "unset" sentinel, matching journal_head_lba's identical
//    convention, and journal_writer_set_checkpoint's own header:
//    "defaults to journal_lba on first touch if never called
//    explicitly" -- confirmed by journal_append itself seeding it, per
//    tests/kernel/fs/pdxfs/mount_replay_witness_synth.pdx stage 16).
//    §4.3's own text says recovery is idempotent under exactly this
//    over-wide replay ("replaying a range whose in-place writes
//    already happened is a no-op"), so this is a safe -- if
//    conservative -- default, not a correctness gap, but it is worth
//    naming: a real "last known checkpoint" for a volume this kernel
//    instance has genuinely never touched would need to be read back
//    from the on-disk journal region itself (the highest-seq block's
//    own `checkpoint` field), which `journal_replay` already does
//    internally for HEAD discovery but does not surface a
//    caller-visible checkpoint-field readback for.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- this file's slice of 0xFFFFED20..ED27
// -----------------------------------------------------------------------------
//
// Every specific SB_*/VOL_*/JNL_* code this function can return is
// FORWARDED VERBATIM from the callee that produced it (`probe_one_
// bdev`'s forwarded sb_read/volume_registry_register codes, this
// file's own second `sb_read` call's 5 possible codes, journal_
// replay's 1 hard-fail code) -- no new codes are declared for those
// paths. This file claims its own two #1707-reserved M5-band codes
// (kind_volume.pdx §3: "reserved for #1707"):
//
//   MOUNT_ROOT_AMBIGUOUS  = 0xFFFFED26   uuid_hint given but does not
//                                        match this device's
//                                        superblock uuid (see gap 1
//                                        above on scope)
//   MOUNT_BACKEND_UNKNOWN = 0xFFFFED27   reserved for a genuinely
//                                        fitting future call site
//                                        (e.g. a later sys_mount
//                                        syscall wrapper's own
//                                        backend-dispatch refusal);
//                                        no call site in THIS file
//                                        needs it -- see
//                                        vops_block.pdx (this
//                                        milestone's sibling file)
//                                        for where it IS actually used
//                                        (its 5 not-yet-wired data-path
//                                        stubs)
//
// "No free mount slot" (Phase-3-style scan exhausts all 8 slots)
// mirrors `mount()`'s OWN convention for the identical condition:
// returns 0xFFFF (MOUNT_IDX_NONE), not an ED-band code, keeping this
// function's return convention consistent with `mount()`'s (both
// return a `_mount_table` slot index on success, 0xFFFF on "table
// full").
//
// -----------------------------------------------------------------------------
// Distinguishing a real pointer from a sentinel error code
// -----------------------------------------------------------------------------
//
// This function's own `sb_read` call re-uses probe.pdx's own proven
// idiom rather than enumerating individual sentinel values: every real
// kernel address is `>= KERNEL_VMA_BASE` (`0xFFFF800000000000`), vastly
// larger than any `0xFFFFEDxx` sentinel (< 2^32); stage the base into
// a register and `cmp rax, r10; jb <sentinel>` (register-register
// compare, no imm32 sign-extension hazard). `probe_one_bdev`'s own
// return is disambiguated the way `probe_all_bdevs` itself does:
// `cmp rax, 16; jae <not a row_id>` (row ids are 0..15; every failure
// sentinel it can produce is far larger).
//
// -----------------------------------------------------------------------------
// Arity discipline
// -----------------------------------------------------------------------------
//
// `mount_pdxfs_block(cap_slot, bdev_cap, uuid_hint_lo, uuid_hint_hi)`,
// arity 4. No `parent_slot` argument -- this function mints through
// `probe_one_bdev` -> `volume_registry_register` (a kernel-trusted,
// no-parent-cap primitive; see volume_registry.pdx's own header:
// "Direct kernel-trusted registration -- NOT the user-facing
// volume_cap_mint_inner ceremony ... a boot-time device walker does
// not hold [a parent cap] on anyone's behalf"), not
// `volume_cap_mint_inner` directly.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// This function issues far more nested calls than fit in the
// available callee-save budget if every intermediate value were kept
// live in a register (uuid_hint_lo/hi, uuid_lo/hi, journal_lba/bcount,
// mount_slot, row_id -- 8 values, 3 registers). It therefore follows
// this codebase's OWN dominant idiom for that shape (mkfs.pdx's
// `_mkfs_layout_row`, inode_table.pdx's `_itable_row_scratch`,
// journal_ondisk.pdx's `_journal_replay_stats`): a small static
// scratch struct, `_mpb_scratch`, spilled to and reloaded from rather
// than juggled across an insufficient register budget. Only
// `cap_slot` (r12), `bdev_cap` (rbx), and `sb_ptr` (r13, set once this
// function's own `sb_read` succeeds) are held live in callee-save
// registers for the function's whole body; everything else
// round-trips through `_mpb_scratch`. 3-push prologue (rbx/r12/r13,
// odd count) lands rsp%16==0 with no pad (SysV-entry rsp%16==8 + 24 =
// 32, %16==0).
//
// `_mpb_scratch : [u64; 16] @align(64)`:
//   +0  uuid_hint_lo   +8  uuid_hint_hi   +16 mount_slot
//   +24 uuid_lo        +32 uuid_hi        +40 journal_lba
//   +48 journal_bcount +56 row_id         (+64..+120 unused headroom)
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere (every field is a whole qword,
// via already-existing accessors or direct qword loads/stores against
// `_mpb_scratch`/`_mount_table`). No `test` instruction; every branch
// uses `cmp reg, imm`/`cmp reg, reg` + `je`/`jne`/`jae`/`jb`. Every
// ED-band sentinel compared against `rax` (rather than assigned to it)
// is staged through r10 first, per this codebase's "bit 31/63 set:
// stage via reg, no bare imm cmp" discipline; sentinels merely
// ASSIGNED via `mov rax, <imm>` need no staging. Every comparison
// against a `_mpb_scratch` field loads it into a register first (no
// `cmp reg, [mem]` anywhere -- no proven precedent for that operand
// form exists anywhere else in this codebase's `.pdx` sources). Every
// label is prefixed `mpb_` -- grep audit 2026-08-23: no `mpb_` hits
// anywhere else in `src/kernel/`.

module MountBlock = structure {

  pub let mut _mpb_scratch : [u64; 16] = uninit @align(64)

  // ==========================================================================
  // mount_pdxfs_block(cap_slot, bdev_cap, uuid_hint_lo, uuid_hint_hi)
  //   -> mount_slot | 0xFFFF (table full) | SB_*/VOL_*/JNL_* (forwarded)
  //      | MOUNT_ROOT_AMBIGUOUS (0xFFFFED26)
  //
  // uuid_hint_lo/uuid_hint_hi of (0, 0) means "no hint -- accept
  // whatever PdxFS-on-block v1 volume is on this device" (§3.3 bullet
  // 3's single-device fallback in the one-caller-one-device case; see
  // file header gap 1 for why full multi-volume root-selection is out
  // of scope here).
  // ==========================================================================
  pub let mount_pdxfs_block : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (cap_slot: u64) (bdev_cap: u64) (uuid_hint_lo: u64) (uuid_hint_hi: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M5-005 (#1707). 3-push prologue (rbx=bdev_cap, r12=cap_slot, r13=sb_ptr once this function's own sb_read succeeds) lands rsp%16==0 (odd count, no pad). Body per file header: (1) stash uuid_hint_lo/hi into _mpb_scratch[+0]/[+8]. (2) probe_one_bdev(bdev_cap) -- #1706's probe, does sb_read + magic/version/block_size/reserved validation + idempotent uuid-keyed volume_registry_register in one call; stage-compare its result against 16 (row ids are 0..15, every sb_read/volume_registry_register failure sentinel is >= 0xFFFFED00), forwarding verbatim to mpb_done on rax>=16; else store row_id at scratch[+56]. (3) sb_read(bdev_cap) AGAIN -- probe_one_bdev does not expose its own internal sb_ptr, and this function needs the uuid + journal region fields off it; stage KERNEL_VMA_BASE (0xFFFF800000000000) into r10 and cmp rax,r10; jb mpb_done (sentinel -- defensive only, this exact device/LBA0 just validated cleanly one call ago) else r13=rax (sb_ptr). (4) sb_uuid_lo/sb_uuid_hi(r13) into scratch[+24]/[+32]. (5) hint check: if scratch[+0]|scratch[+8] != 0, both halves must match scratch[+24]/[+32] (each comparison loads both operands into registers first, no cmp-against-memory) else MOUNT_ROOT_AMBIGUOUS (0xFFFFED26). (6) sb_journal_lba/sb_journal_bcount(r13) into scratch[+40]/[+48]. (7) journal_checkpoint_lba(row_id); 0 (unset sentinel) falls back to scratch[+40] (journal_lba) per file header gap 4. (8) journal_replay(bdev_cap, row_id, journal_lba, journal_bcount, checkpoint_lba); stage-compare rax against JNL_CHECKPOINT_BEYOND_HEAD (0xFFFFED22) ONLY -- every other journal_replay outcome (including CSUM/MAGIC/SEQ truncation, which journal_replay's own contract treats as non-fatal torn-write handling, folded into applied_total rather than rax) is informational and does not abort the mount, per volume-fs-substrate.md §4.3's own 'non-fatal, truncate not fail' framing for the forward walk. (9) journal_replay_head_lba() (no-arg); journal_writer_set_checkpoint(row_id, head_lba) advances the checkpoint post-replay per §4.3 step 10. (10) linear scan of _mount_table (identical shape to mount()'s own Phase 3) for the first backend==0 slot; MOUNT_MAX exhausted -> 0xFFFF (mirrors mount()'s own table-full convention, not an ED-band code). (11) volume_row_mount_slot_set(row_id, mount_slot) stamps the back-pointer #1703's own header names this setter for. (12) cap_mint_write(cap_slot, KIND_VOLUME=0x1A0, R_VOL_ALL=0x43B, row_id) installs the handle. (13) pack the _mount_table entry: mp_idx=root_idx=0xFFFF (VNODE_IDX_NONE, file header gap 3), backend=5 (MOUNT_BACKEND_PDXFS_BLOCK), flags=MOUNT_FLAG_VALID|MOUNT_FLAG_ROOT-if-slot0 (identical shift/or shape to mount()'s own Phase 6), reserved=row_id&0xFFFF at bits [48,64) per §3.2's own text; store; return mount_slot. mpb_done/mpb_ambiguous/mpb_no_slot converge on mpb_epilogue with rax already set to the return value. 3-pop epilogue + ret. No test instruction; no mov_b. Reserved labels: mpb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                    // cap_slot
        mov rbx, rsi;                    // bdev_cap
        lea r10, [rip + _mpb_scratch];
        mov [r10 + 0], rdx;              // uuid_hint_lo
        mov [r10 + 8], rcx;              // uuid_hint_hi

        // (2) #1706's probe: find + idempotently register the volume.
        mov rdi, rbx;
        call probe_one_bdev;
        mov r10, 16;
        cmp rax, r10;
        jae mpb_done;                    // forwarded sb_read/registry error
        lea r10, [rip + _mpb_scratch];
        mov [r10 + 56], rax;             // row_id

        // (3) re-read the superblock for fields probe didn't surface.
        mov rdi, rbx;
        call sb_read;
        mov r10, 0xFFFF800000000000;     // KERNEL_VMA_BASE
        cmp rax, r10;
        jb mpb_done;                     // sentinel (defensive only)
        mov r13, rax;                    // sb_ptr

        mov rdi, r13;
        call sb_uuid_lo;
        lea r10, [rip + _mpb_scratch];
        mov [r10 + 24], rax;             // uuid_lo

        mov rdi, r13;
        call sb_uuid_hi;
        lea r10, [rip + _mpb_scratch];
        mov [r10 + 32], rax;             // uuid_hi

        // (5) uuid-hint gate.
        lea r10, [rip + _mpb_scratch];
        mov rax, [r10 + 0];
        mov rcx, [r10 + 8];
        or  rax, rcx;
        cmp rax, 0;
        je  mpb_skip_hint;
        mov rax, [r10 + 0];
        mov r11, [r10 + 24];
        cmp rax, r11;
        jne mpb_ambiguous;
        mov rax, [r10 + 8];
        mov r11, [r10 + 32];
        cmp rax, r11;
        jne mpb_ambiguous;
      mpb_skip_hint:

        mov rdi, r13;
        call sb_journal_lba;
        lea r10, [rip + _mpb_scratch];
        mov [r10 + 40], rax;             // journal_lba

        mov rdi, r13;
        call sb_journal_bcount;
        lea r10, [rip + _mpb_scratch];
        mov [r10 + 48], rax;             // journal_bcount

        // (7) checkpoint discovery (0 = unset -> fall back to journal_lba).
        lea r10, [rip + _mpb_scratch];
        mov rdi, [r10 + 56];             // row_id
        call journal_checkpoint_lba;
        cmp rax, 0;
        jne mpb_have_checkpoint;
        lea r10, [rip + _mpb_scratch];
        mov rax, [r10 + 40];             // fallback: journal_lba
      mpb_have_checkpoint:
        mov r8, rax;                     // checkpoint_lba -> arg5

        // (8) real on-disk journal replay (#1704).
        lea r10, [rip + _mpb_scratch];
        mov rdi, rbx;                    // bdev_cap
        mov rsi, [r10 + 56];             // vol_slot = row_id
        mov rdx, [r10 + 40];             // journal_lba
        mov rcx, [r10 + 48];             // journal_bcount
        call journal_replay;
        mov r10, 0xFFFFED22;             // JNL_CHECKPOINT_BEYOND_HEAD
        cmp rax, r10;
        je mpb_done;

        // (9) advance checkpoint past the replayed range.
        call journal_replay_head_lba;
        lea r10, [rip + _mpb_scratch];
        mov rdi, [r10 + 56];             // row_id
        mov rsi, rax;                    // new checkpoint = head_lba
        call journal_writer_set_checkpoint;

        // (10) find a free mount slot (mirrors mount()'s own Phase 3).
        lea r9, [rip + _mount_table];
        xor rcx, rcx;
      mpb_scan:
        cmp rcx, 8;
        jae mpb_no_slot;
        mov rax, [r9 + rcx * 8];
        shr rax, 32;
        and rax, 0xFF;
        cmp rax, 0;
        je mpb_slot_found;
        add rcx, 1;
        jmp mpb_scan;
      mpb_slot_found:
        lea r10, [rip + _mpb_scratch];
        mov [r10 + 16], rcx;             // mount_slot

        // (11) stamp mount_slot back-pointer onto the KIND_VOLUME row.
        lea r10, [rip + _mpb_scratch];
        mov rdi, [r10 + 56];             // row_id
        mov rsi, [r10 + 16];             // mount_slot
        call volume_row_mount_slot_set;

        // (12) install the cap-table handle.
        lea r10, [rip + _mpb_scratch];
        mov rdi, r12;                    // cap_slot
        mov rsi, 0x1A0;                  // KIND_VOLUME
        mov rdx, 0x43B;                  // R_VOL_ALL
        mov rcx, [r10 + 56];             // row_id
        call cap_mint_write;

        // (13) pack + write the mount-table entry (mirrors mount()'s Phase 6).
        mov rax, 0xFFFF;                 // mp_idx = VNODE_IDX_NONE
        mov rcx, 0xFFFF;
        shl rcx, 16;
        or  rax, rcx;                    // root_idx = VNODE_IDX_NONE
        mov rcx, 5;                      // MOUNT_BACKEND_PDXFS_BLOCK
        shl rcx, 32;
        or  rax, rcx;

        mov rcx, 1;                      // MOUNT_FLAG_VALID
        lea r10, [rip + _mpb_scratch];
        mov r11, [r10 + 16];             // mount_slot
        cmp r11, 0;
        jne mpb_no_root_flag;
        or  rcx, 2;                      // MOUNT_FLAG_ROOT
      mpb_no_root_flag:
        shl rcx, 40;
        or  rax, rcx;

        lea r10, [rip + _mpb_scratch];
        mov rcx, [r10 + 56];             // row_id
        and rcx, 0xFFFF;
        shl rcx, 48;
        or  rax, rcx;

        lea r9, [rip + _mount_table];
        lea r10, [rip + _mpb_scratch];
        mov r11, [r10 + 16];             // mount_slot
        mov [r9 + r11 * 8], rax;

        lea r10, [rip + _mpb_scratch];
        mov rax, [r10 + 16];             // return mount_slot
        jmp mpb_epilogue;

      mpb_ambiguous:
        mov rax, 0xFFFFED26;             // MOUNT_ROOT_AMBIGUOUS
        jmp mpb_epilogue;

      mpb_no_slot:
        mov rax, 0xFFFF;                 // MOUNT_IDX_NONE (mirrors mount()'s own convention)
        jmp mpb_epilogue;

      mpb_done:
        jmp mpb_epilogue;

      mpb_epilogue:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
