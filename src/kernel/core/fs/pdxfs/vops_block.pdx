// src/kernel/core/fs/pdxfs/vops_block.pdx -- R52.M5-005 (#1707)
//
// PDXFS-ON-BLOCK v1 -- _pdxfs_block_vops TABLE (mount-table backend
// discriminant MOUNT_BACKEND_PDXFS_BLOCK = 5's ops table).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/filesystem/volume-fs-substrate.md §3.2: "backend_registry.pdx's
// backend_ops_table dispatch gains a `cmp rdi, 5; je bot_pdxfs_block`
// arm returning the address of a new `_pdxfs_block_vops` table (mirrors
// `_tmpfs_vops` shape)." This file lands exactly that table, mirroring
// `core/fs/tmpfs/vops.pdx`'s own `_tmpfs_vops : [u64; 7]` layout and
// `Vops.tmpfs_vops_init`'s populator shape one-for-one (same 7 offsets:
// READ=0, WRITE=8, OPEN=16, CLOSE=24, LOOKUP=32, CREATE=40, UNLINK=48).
//
// UNLIKE _tmpfs_vops, none of this table's 7 slots bridge to a real
// block-backed read/write/lookup/create/unlink walker yet -- those
// walkers do not exist in this tree. §4.4 names the actual wiring:
// `PXT_OP_CREATE`/`_RENAME`/`_UNLINK` land at R52.M6 against
// `kind_pdxfs_txn.pdx`, and a real vops-shaped read/write bridge over
// `cow_read.pdx`/`cow_write.pdx` needs the block-cache wiring named at
// R52.M7 (§5, "Wire cache into cow_read.pdx + cow_write.pdx"). Landing
// stub adapters here (rather than leaving the table half-populated, or
// leaving `backend_ops_table`'s new arm dangle a null pointer) matches
// this codebase's own established posture for a backend whose ops
// table exists ahead of its walkers -- see `_tmpfs_open_stub`/
// `_tmpfs_close_stub`'s own header note on why a null slot is worse
// than an explicit stub ("Null slot would return E_NOT_SUPPORTED...
// breaking downstream sys_open").
//
// READ/WRITE/LOOKUP/CREATE/UNLINK stubs here do NOT follow tmpfs's
// "return 0 (success no-op)" convention for those five slots -- a
// silent-success read/write/lookup/create/unlink on a backend with no
// real walker would corrupt caller state (e.g. a read that reports
// success while leaving the destination buffer untouched). They return
// `MOUNT_BACKEND_UNKNOWN` (0xFFFFED27, kind_volume.pdx's #1707-reserved
// M5-band slot) instead -- reused here for "this backend's op surface
// is not yet resolvable", the same broad-reuse posture
// journal_ondisk.pdx's own header documents for its band (gap 3: "this
// module reuses [an adjacent code] for all of these, on the rationale
// that every one of them means '... cannot be trusted/completed'").
// OPEN/CLOSE stubs DO mirror tmpfs's "return 0" shape: per-open state
// management genuinely has nothing to do yet at either backend (no
// cache pin/unpin exists before R52.M7's KIND_BLOCK_CACHE), so a
// trivial success is accurate, not misleading.
//
// -----------------------------------------------------------------------------
// Register discipline / mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// Every stub is a leaf (no nested call, no callee-save touched): a
// single `mov rax, <imm>; ret` (or `xor eax, eax; ret` for the two
// success stubs). The populator mirrors `tmpfs_vops_init`'s exact
// shape (lea + mov per slot, xor eax,eax; ret). No `test` instruction
// anywhere. No mov_b. No labels needed anywhere in this file (every
// function is straight-line).

module VopsBlock = structure {

  // ==========================================================================
  // _pdxfs_block_vops : [u64; 7] -- shared vops table for
  // MOUNT_BACKEND_PDXFS_BLOCK, same frozen layout as _tmpfs_vops:
  //   +0  (VOPS_READ_OFFSET)    -> _pdxfs_block_read_stub
  //   +8  (VOPS_WRITE_OFFSET)   -> _pdxfs_block_write_stub
  //   +16 (VOPS_OPEN_OFFSET)    -> _pdxfs_block_open_stub
  //   +24 (VOPS_CLOSE_OFFSET)   -> _pdxfs_block_close_stub
  //   +32 (VOPS_LOOKUP_OFFSET)  -> _pdxfs_block_lookup_stub
  //   +40 (VOPS_CREATE_OFFSET)  -> _pdxfs_block_create_stub
  //   +48 (VOPS_UNLINK_OFFSET)  -> _pdxfs_block_unlink_stub
  // ==========================================================================
  // R56.M3-002 (#1791): widened 7 -> 8 for the stat slot at +56. The
  // stat adapter lives in the sibling block_vops.pdx (per that file's
  // "canonical landing site" mandate) and is registered here by
  // pdxfs_block_vops_init below.
  //
  // R56.M3-003 (#1792): widened 8 -> 9 for the readdir slot at +64. No
  // block-backed dentry walker exists yet (would need the R52.M6 PXT_OP_*
  // dentry-write path to produce a walkable on-disk directory format
  // first). Slot +64 is wired to _pdxfs_block_readdir_stub which returns
  // MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than fabricating an empty
  // EOD reply — a silent "empty dir" would look like a real answer to
  // sys_getdents and mislead the caller.
  //
  // R56.M3-004 (#1793): widened 9 -> 11 for the mkdir/rmdir tail slots
  // at +72 / +80.  Both wired to _pdxfs_block_mkdir_stub /
  // _pdxfs_block_rmdir_stub (MOUNT_BACKEND_UNKNOWN sentinel, matching
  // the create/unlink sibling stubs' rationale).  The task-brief step
  // sequence (alloc inode, mode=DIR, append dentry, persist via R55
  // primitives) requires a vnode-to-(nsid, sb_ptr, bdev_cap, parent_
  // ino) bridge that does not exist yet — the block-backend vnode pool
  // stores only the vnode/idx pair, not the mount-context tuple the
  // R55 inode_table_write / R55 dir_append primitives need.  A silent-
  // success stub would look like a real mkdir to the sys_mkdir body
  // but leave the on-disk inode table and directory both un-mutated,
  // so the sentinel is the accurate answer.  Real bodies land with
  // the KIND_MOUNT-per-vnode wiring at R56.M4+ (see file header §What
  // is deliberately NOT done here for the mount-context-plumbing
  // gap).  Dir-format helpers landed alongside this milestone in
  // src/kernel/core/fs/pdxfs/dir.pdx are ready for that wire-up.
  //
  // R56.M3-005 (#1794): widened 11 -> 12 for the rename slot at +88.
  // Slot +88 is wired to _pdxfs_block_rename_stub (MOUNT_BACKEND_UNKNOWN)
  // -- real WAL-atomic rename needs the R52.M6 PXT_OP_RENAME wire (see
  // kind_pdxfs_txn.pdx journal-append + dirent-write path); a silent
  // "renamed" stub reply would leave persistent state un-mutated.
  pub let mut _pdxfs_block_vops : [u64; 12] = uninit @align(8)

  // vops signature: read(vn, buf, len, off) -- see file header: no real
  // walker exists yet (R52.M7 wires cow_read.pdx through the block
  // cache). Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27, reused per file
  // header rationale).
  pub let _pdxfs_block_read_stub : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): stub for the read slot. No block-backed read walker exists yet (R52.M7 wires cow_read.pdx through the block cache). A silent-success stub would corrupt callers (buffer left untouched but reported filled), so this returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than 0, unlike tmpfs's open/close stubs. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: write(vn, buf, len, off) -- same rationale as read.
  pub let _pdxfs_block_write_stub : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): stub for the write slot. No block-backed write walker exists yet (R52.M6 wires kind_pdxfs_txn.pdx's PXT_OP_* through the journal). Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) -- a silent-success stub would falsely claim a durable write happened. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: open(vn, flags) -- mirrors _tmpfs_open_stub's
  // "success no-op" rationale: no per-open state exists to manage at
  // either backend before R52.M7's KIND_BLOCK_CACHE pin/unpin.
  pub let _pdxfs_block_open_stub : (u64, u64) -> u64 !{} @{} =
    fn (vn: u64) (flags: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): stub for the open slot. Mirrors _tmpfs_open_stub (tmpfs/vops.pdx) exactly: no per-open state to initialize before R52.M7's block-cache pin/unpin lands, so a genuine 0 (success) is accurate, not misleading. Leaf, no callee-save.",
      block: {
        xor eax, eax;
        ret
      }
    }

  // vops signature: close(vn) -- mirrors _tmpfs_close_stub.
  pub let _pdxfs_block_close_stub : (u64) -> u64 !{} @{} =
    fn (vn: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): stub for the close slot. Mirrors _tmpfs_close_stub exactly: no per-open state to tear down yet. Leaf, no callee-save.",
      block: {
        xor eax, eax;
        ret
      }
    }

  // vops signature: lookup(dir_vn, name_ptr) -- no dentry-walk exists
  // yet over the block-backed directory format (R52.M6).
  pub let _pdxfs_block_lookup_stub : (u64, u64) -> u64 !{} @{} =
    fn (dir_vn: u64) (name_ptr: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): stub for the lookup slot. No block-backed dentry walker exists yet. Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than a bogus child idx. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: create(dir_vn, name_ptr, mode) -- PXT_OP_CREATE
  // lands at R52.M6.
  pub let _pdxfs_block_create_stub : (u64, u64, u64) -> u64 !{} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (mode: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): stub for the create slot. kind_pdxfs_txn.pdx's PXT_OP_CREATE (real inode allocation + JOP_INODE_WRITE + JOP_DENTRY_ADD) lands at R52.M6. Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than a fabricated success. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: unlink(dir_vn, name_ptr) -- PXT_OP_UNLINK lands at
  // R52.M6.
  pub let _pdxfs_block_unlink_stub : (u64, u64) -> u64 !{} @{} =
    fn (dir_vn: u64) (name_ptr: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): stub for the unlink slot. kind_pdxfs_txn.pdx's PXT_OP_UNLINK lands at R52.M6. Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than a fabricated success. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: readdir(dir_vn, buf, nbytes, cursor) -- R56.M3-003 (#1792)
  // stub for the readdir slot. No block-backed dentry walker exists yet
  // (would need the R52.M6 PXT_OP_* dentry-write path to produce a
  // walkable on-disk directory format first). Returns MOUNT_BACKEND_UNKNOWN
  // (0xFFFFED27) rather than fabricating an empty EOD reply -- a silent
  // "empty dir" would look like a real answer to sys_getdents and mislead
  // the caller.
  pub let _pdxfs_block_readdir_stub : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (dir_vn: u64) (buf: u64) (nbytes: u64) (cursor: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R56.M3-003 (#1792): stub for the readdir slot. No block-backed dentry walker exists yet (R52.M6 PXT_OP_* dentry-write path required first). Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than fabricating an empty EOD reply. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: mkdir(dir_vn, name_ptr, name_len, mode) -- R56.M3-004
  // (#1793) stub for the mkdir slot.  No vnode-to-mount-context bridge
  // exists yet; even though sibling primitives (inode_alloc_fresh /
  // inode_table_write from R52.M4 + R55.M2 and the new dir_append /
  // dir_remove helpers in dir.pdx) are landed, wiring them requires a
  // per-vnode (nsid, sb_ptr, bdev_cap, parent_ino) tuple the current
  // block-backed vnode pool does not carry.  Returns MOUNT_BACKEND_
  // UNKNOWN (0xFFFFED27) rather than a fabricated success -- a silent
  // success stub would look like a real mkdir to sys_mkdir_body but
  // leave the on-disk inode table and directory both un-mutated.
  pub let _pdxfs_block_mkdir_stub : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (name_len: u64) (mode: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R56.M3-004 (#1793): stub for the mkdir slot. No vnode-to-mount-context bridge yet (see file header §What is deliberately NOT done here). Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than a fabricated success. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: rmdir(dir_vn, name_ptr, name_len) -- R56.M3-004 (#1793)
  // stub for the rmdir slot. Same rationale as mkdir stub above.
  pub let _pdxfs_block_rmdir_stub : (u64, u64, u64) -> u64 !{} @{} =
    fn (dir_vn: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R56.M3-004 (#1793): stub for the rmdir slot. Symmetric to _pdxfs_block_mkdir_stub. Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27). Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // vops signature: rename(dir_vn, old_ptr, old_len, new_ptr, new_len) --
  // R56.M3-005 (#1794) stub for the rename slot. Real WAL-atomic rename
  // needs the R52.M6 PXT_OP_RENAME wire (see kind_pdxfs_txn.pdx journal-
  // append + dirent-write path). Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27)
  // rather than fabricating a success -- a silent "renamed" reply that
  // did not actually touch persistent state would mislead the caller.
  pub let _pdxfs_block_rename_stub : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (dir_vn: u64) (old_ptr: u64) (old_len: u64) (new_ptr: u64) (new_len: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R56.M3-005 (#1794): stub for the rename slot. Real WAL-atomic rename lands with R52.M6 PXT_OP_RENAME. Returns MOUNT_BACKEND_UNKNOWN (0xFFFFED27) rather than a fabricated success. Leaf, no callee-save.",
      block: {
        mov rax, 0xFFFFED27;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_block_vops_init() -> u64 -- populate _pdxfs_block_vops.
  //
  // Boot-time populator, mirrors tmpfs_vops_init's exact shape (lea
  // base once, lea+mov per slot, xor eax,eax; ret). Idempotent (safe to
  // call twice). Leaf, no callee-save.
  // ==========================================================================
  pub let pdxfs_block_vops_init : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52.M5-005 (#1707): populator for _pdxfs_block_vops, mirrors tmpfs_vops_init (core/fs/tmpfs/vops.pdx) one-for-one: lea r8,[rip+_pdxfs_block_vops] once, then 7x (lea rax,[rip+<stub>]; mov [r8+<offset>],rax) using the same frozen VOPS_*_OFFSET immediates #572 established (0/8/16/24/32/40/48), then xor eax,eax; ret. Leaf; no callee-save touched.",
      block: {
        lea r8, [rip + _pdxfs_block_vops];

        lea rax, [rip + _pdxfs_block_read_stub];
        mov [r8 + 0], rax;

        lea rax, [rip + _pdxfs_block_write_stub];
        mov [r8 + 8], rax;

        lea rax, [rip + _pdxfs_block_open_stub];
        mov [r8 + 16], rax;

        lea rax, [rip + _pdxfs_block_close_stub];
        mov [r8 + 24], rax;

        lea rax, [rip + _pdxfs_block_lookup_stub];
        mov [r8 + 32], rax;

        lea rax, [rip + _pdxfs_block_create_stub];
        mov [r8 + 40], rax;

        lea rax, [rip + _pdxfs_block_unlink_stub];
        mov [r8 + 48], rax;

        // R56.M3-002 (#1791): stat slot at +56 (adapter lives in
        // sibling block_vops.pdx per its canonical-landing-site mandate).
        lea rax, [rip + _pdxfs_block_stat_adapter];
        mov [r8 + 56], rax;                          // VOPS_STAT_OFFSET

        // R56.M3-003 (#1792): readdir slot at +64 (terminator-refusing stub).
        lea rax, [rip + _pdxfs_block_readdir_stub];
        mov [r8 + 64], rax;                          // VOPS_READDIR_OFFSET

        // R56.M3-004 (#1793): mkdir slot at +72 (MOUNT_BACKEND_UNKNOWN stub).
        lea rax, [rip + _pdxfs_block_mkdir_stub];
        mov [r8 + 72], rax;                          // VOPS_MKDIR_OFFSET

        // R56.M3-004 (#1793): rmdir slot at +80 (MOUNT_BACKEND_UNKNOWN stub).
        lea rax, [rip + _pdxfs_block_rmdir_stub];
        mov [r8 + 80], rax;                          // VOPS_RMDIR_OFFSET

        // R56.M3-005 (#1794): rename slot at +88 (MOUNT_BACKEND_UNKNOWN stub).
        lea rax, [rip + _pdxfs_block_rename_stub];
        mov [r8 + 88], rax;                          // VOPS_RENAME_OFFSET

        xor eax, eax;
        ret
      }
    }
}
