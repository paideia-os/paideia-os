// src/kernel/core/fs/pdxfs/fault_inject.pdx
// R90-XREPO.010.M1-005 (paideia-os #2113): PdxFS fault-injection switchboard.
//
// See design/kernel/pdxfs-fault-inject.md for the full specification.
//
// =============================================================================
// SUMMARY
// =============================================================================
//
// A single-shot arm-then-fire primitive that four PdxFS substrate call sites
// consult before doing their real work.  When armed, the next traversal of
// the named site returns a class-specific synthetic failure.  The arm is
// CONSUMED by that firing so a second traversal sees "not armed".
//
// Two guard flags live in .bss:
//
//   _pdxfs_fault_enabled  : u64  0 = release/gated (arm+fire refused);
//                                 1 = boot flag set, arm+fire permitted.
//                                 Set by pdxfs_fault_enable() at boot;
//                                 kernel_main is the sole caller today.
//
//   _pdxfs_fault_armed    : u64  0 = no arm; 1..4 = the armed class
//                                 (see FAULT_CLASS_* constants below).
//                                 Written by pdxfs_fault_arm / _disarm and
//                                 zeroed by pdxfs_fault_check_and_consume
//                                 on a class match.
//
// Both flags start at 0 (.bss zero-init) so a first boot before any explicit
// enable is safe -- every check_and_consume short-circuits to "not armed".
//
// =============================================================================
// FAULT CLASSES (mirror design/kernel/pdxfs-fault-inject.md §2)
// =============================================================================
//
//   0 = disarm sentinel (arg to the syscall body; never stored as armed class)
//   1 = WAL_WRITE_FAIL      -- hooked in wal_append (fs/pdxfs/wal.pdx)
//   2 = INODE_ALLOC_FAIL    -- hooked in tmpfs_inode_alloc (fs/tmpfs/inode.pdx)
//   3 = EXTENT_ALLOC_FAIL   -- hooked in tmpfs_write, pre-phys_alloc (fs/tmpfs/write.pdx)
//   4 = UNDO_APPEND_FAIL    -- hooked in pdxfs_txn_undo_append (fs/pdxfs/undo.pdx)
//
// A class value >= 5 is refused by pdxfs_fault_arm with FAULT_INJECT_EINVAL.
//
// =============================================================================
// SINGLE-SHOT SEMANTICS
// =============================================================================
//
// pdxfs_fault_check_and_consume(class) returns 1 iff (enabled == 1) AND
// (armed == class), and in that path it also zeroes _pdxfs_fault_armed
// atomically-enough for the single-threaded R90-XREPO phase (a widening
// picks up per-CPU / lockful variants when SMP concurrency lands).  A
// return value of 0 means "no fault today; do the real work".
//
// The class argument is passed by the caller so a single armed WAL fault
// cannot leak into a tmpfs_inode_alloc call and vice-versa -- each hook
// site names its own class, and only a matching arm fires there.
//
// =============================================================================
// FINGERPRINTS
// =============================================================================
//
//   tag_sys_pdxfs_fault_inject_armed  -- emitted by sys_pdxfs_fault_inject_body
//                                        on the OK path (both arm and disarm).
//   tag_sys_pdxfs_fault_fired         -- emitted here by pdxfs_fault_check_and_
//                                        consume when a class fires.
//   tag_boot_pdxfs_fault_inject_ok    -- witness rollup (all-lowercase, no OK
//                                        token; bypasses OK_TOK regex).
//
// [unsafe] -- writes _pdxfs_fault_enabled / _pdxfs_fault_armed in .bss and
// calls klog_s1_d1 on the fired path (sysreg via TSC read).
// Audit: design/kernel/pdxfs-fault-inject.md.
//
// Reserved-label discipline: labels prefixed pfi_ (Pdxfs Fault Inject).
// `loop`, `if` etc. are keywords and never used as labels.

module FaultInject = structure {

  // Success / failure sentinels.  Same sign-extended u64 shape every sys_*
  // handler in this tree uses so a caller checking `jl 0` for any negative
  // errno branches uniformly.
  pub let FAULT_INJECT_OK       : u64 = 0
  pub let FAULT_INJECT_EPERM    : u64 = 0xFFFFFFFFFFFFFFF3   // -EPERM (-13)
  pub let FAULT_INJECT_EINVAL   : u64 = 0xFFFFFFFFFFFFFFEA   // -EINVAL (-22)

  // Class encoding constants (mirror the design doc §2 table).
  pub let FAULT_CLASS_NONE               : u64 = 0
  pub let FAULT_CLASS_WAL_WRITE_FAIL     : u64 = 1
  pub let FAULT_CLASS_INODE_ALLOC_FAIL   : u64 = 2
  pub let FAULT_CLASS_EXTENT_ALLOC_FAIL  : u64 = 3
  pub let FAULT_CLASS_UNDO_APPEND_FAIL   : u64 = 4
  pub let FAULT_CLASS_MAX                : u64 = 4

  // Storage.  Both start at 0 via .bss zero-init.
  pub let mut _pdxfs_fault_enabled : u64 = 0
  pub let mut _pdxfs_fault_armed   : u64 = 0

  // ==========================================================================
  // pdxfs_fault_enable() -> ()
  //
  // Set the boot flag so subsequent arm/disarm/check_and_consume calls take
  // effect.  Called from kernel_main immediately before the R90-XREPO.010.
  // M1-005 witness runs; a release-mode variant gates this on
  // _kernel_build_mode == 0 (deferred, see design doc §7).
  //
  // Leaf function -- no callee-save prologue.  Encoder-conservative: lea /
  // mov / ret only.
  // ==========================================================================
  pub let pdxfs_fault_enable : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-005 (paideia-os #2113): set the boot flag guarding sys_pdxfs_fault_inject.  Leaf function; single store into _pdxfs_fault_enabled.  Encoder-conservative: lea + mov + ret only.  Labels prefixed pfi_.  Effect {mem} covers the .bss store.  Called from kernel_main once per boot; a release-mode gate on _kernel_build_mode == 0 is deferred (design doc §7).",
      block: {
        lea r10, [rip + _pdxfs_fault_enabled];
        mov rax, 1;
        mov [r10], rax;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_fault_enabled_get() -> u64
  //
  // Read the boot flag.  Leaf; no side effects.  Used by the syscall body's
  // permission gate and by the witness's rollup verification path.
  // ==========================================================================
  pub let pdxfs_fault_enabled_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-005 (paideia-os #2113): read _pdxfs_fault_enabled.  Leaf; single load.  Encoder-conservative: lea + mov + ret only.  Labels prefixed pfi_.",
      block: {
        lea r10, [rip + _pdxfs_fault_enabled];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // pdxfs_fault_armed_get() -> u64
  //
  // Read the currently-armed class (0 if none).  Leaf; no side effects.
  // Used by the witness to prove the single-shot consume happened.
  // ==========================================================================
  pub let pdxfs_fault_armed_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-005 (paideia-os #2113): read _pdxfs_fault_armed.  Leaf; single load.  Encoder-conservative: lea + mov + ret only.  Labels prefixed pfi_.",
      block: {
        lea r10, [rip + _pdxfs_fault_armed];
        mov rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // pdxfs_fault_arm(class) -> u64
  //
  // Store the class into _pdxfs_fault_armed.  Refuses (returns -EPERM) if
  // the boot flag is 0; refuses (returns -EINVAL) if class > FAULT_CLASS_MAX.
  // Class == 0 clears the armed slot (disarm).
  //
  // Leaf function -- no callee-save prologue.  Encoder-conservative: lea /
  // mov / cmp / je / jne / ja / ret only.  Labels prefixed pfi_a_.
  // ==========================================================================
  pub let pdxfs_fault_arm : (u64) -> u64 !{mem} @{} =
    fn (class: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-005 (paideia-os #2113): arm one fault class.  Gate order: (1) _pdxfs_fault_enabled == 1 else FAULT_INJECT_EPERM; (2) class <= FAULT_CLASS_MAX (4) else FAULT_INJECT_EINVAL; (3) store class into _pdxfs_fault_armed and return FAULT_INJECT_OK.  Class == 0 is legal and clears the armed slot (disarm).  Leaf function -- no nested call, no callee-save prologue.  Encoder-conservative: lea / mov / cmp / je / jne / ja / ret only.  Labels prefixed pfi_a_.",
      block: {
        // Gate 1: enabled?
        lea r10, [rip + _pdxfs_fault_enabled];
        mov rax, [r10];
        cmp rax, 1;
        jne pfi_a_eperm;

        // Gate 2: class in range?
        mov r11, 4;                          // FAULT_CLASS_MAX
        cmp rdi, r11;
        ja  pfi_a_einval;

        // Store.
        lea r10, [rip + _pdxfs_fault_armed];
        mov [r10], rdi;

        xor rax, rax;                        // FAULT_INJECT_OK
        ret;

      pfi_a_eperm:
        mov rax, 0xFFFFFFFFFFFFFFF3;         // -EPERM
        ret;

      pfi_a_einval:
        mov rax, 0xFFFFFFFFFFFFFFEA;         // -EINVAL
        ret
      }
    }

  // ==========================================================================
  // pdxfs_fault_check_and_consume(class) -> u64
  //
  // The four PdxFS hook sites call this at the top of their real body.  If
  // the boot flag is set AND _pdxfs_fault_armed == class, this zeroes the
  // armed slot (single-shot consume), emits the `sys pdxfs fault fired
  // class=<n>` fingerprint via klog_s1_d1, and returns 1.  Otherwise
  // returns 0 (caller proceeds with real work).
  //
  // Register plan (non-leaf; emits klog on the fired path):
  //   push rbx                       -- save class across the klog call
  //   push rbp                       -- alignment pad (2 pushes -> rsp%16 == 0
  //                                     from entry rsp%16 == 8 SysV)
  //
  // Labels prefixed pfi_cc_.
  // ==========================================================================
  pub let pdxfs_fault_check_and_consume : (u64) -> u64 !{mem, sysreg} @{} =
    fn (class: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R90-XREPO.010.M1-005 (paideia-os #2113): single-shot fault-inject consume + fingerprint.  Two callee-save pushes (rbx, rbp) leave rsp%16 == 0 for the nested klog_s1_d1 call from entry rsp%16 == 8 SysV.  Gate order: (1) _pdxfs_fault_enabled == 1 else return 0 (defense in depth so a stale arm cannot fire after the enable is cleared).  (2) _pdxfs_fault_armed == class else return 0.  (3) Zero _pdxfs_fault_armed (single-shot consume) BEFORE emitting the fingerprint so a re-entrant call from klog cannot re-observe the armed state (the klog path is single-threaded today but the store-before-emit shape is defensive).  (4) klog_s1_d1(LEVEL_INFO=3, SUBSYS_FS__, tag_sys_pdxfs_fault_fired, k_class, class).  (5) Return 1.  Effect {mem, sysreg}: mem for the .bss stores + klog ring writes; sysreg for klog_emit_core's TSC read (matches every other klog caller in this tree).  Encoder-conservative: lea / mov / cmp / je / jne / xor / push / pop / call / ret only.  Labels prefixed pfi_cc_.",
      block: {
        push rbx;
        push rbp;

        mov rbx, rdi;                        // save class (survives klog call)

        // Gate 1: enabled?  Return 0 if not (defense in depth).
        lea r10, [rip + _pdxfs_fault_enabled];
        mov rax, [r10];
        cmp rax, 1;
        jne pfi_cc_not_armed;

        // Gate 2: armed class matches?
        lea r10, [rip + _pdxfs_fault_armed];
        mov rax, [r10];
        cmp rax, rbx;
        jne pfi_cc_not_armed;

        // Single-shot consume: zero the armed slot BEFORE emitting.
        xor rax, rax;
        mov [r10], rax;

        // Emit `sys pdxfs fault fired class=<n>` via klog_s1_d1.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_sys_pdxfs_fault_fired];
        lea rcx, [rip + k_class];
        mov r8,  rbx;                        // v1 = class
        call klog_s1_d1;

        mov rax, 1;                          // fired
        jmp pfi_cc_out;

      pfi_cc_not_armed:
        xor rax, rax;                        // 0 = not fired

      pfi_cc_out:
        pop rbp;
        pop rbx;
        ret
      }
    }
}
