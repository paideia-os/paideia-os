        xor rax, rax;
        mov [r12 + 0], rax;
        mov [r12 + 8], rax;
        mov [r12 + 16], rax;
        mov [r12 + 24], rax;

        mov rdi, rbx;
        mov rsi, r12;
        mov r10, 5;
        or  rsi, r10;
        call cap_invoke;
        cmp rax, 0;
        jne jbf_err;

        xor eax, eax;
        jmp jbf_done;

      jbf_err:
        mov rax, 0xFFFFED21;

      jbf_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
