  // ============================================================================
  // Low-level BDEV I/O helpers, shared by journal_append and
  // journal_replay via _journal_io_desc. Same descriptor-page protocol
  // as superblock_read.pdx/superblock_write.pdx: op_arg packs the
  // op_code into the low 12 bits of the (4-KiB-aligned) descriptor
  // page address.
  // ============================================================================

  // jnl_bdev_write_block(bdev_cap, lba, buf_ptr) -> u64
  pub let jnl_bdev_write_block : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (lba: u64) (buf_ptr: u64) -> unsafe {
      effects: { mem, sysreg }, capabilities: { cap },
      justification: "R52.M5-002 (#1704). 5-push callee-save prologue (rbx/r12/r13/r14/r15, sb_write pattern) lands rsp%16==0 for the nested cap_invoke call. rbx=bdev_cap, r13=lba, r14=buf_ptr, r12=&_journal_io_desc, r15 unused (pattern uniformity). Stamps [r12+0]=lba,[r12+8]=nblocks=1,[r12+16]=dma_iova=buf_ptr,[r12+24]=status_out=0. rdi=rbx; rsi=r12 OR'd with op_code 4 (BDEV_OP_WRITE_LBA); call cap_invoke. Any nonzero result maps to the single generic JNL_CSUM_BAD (reused, gap 3). No test instruction. Reserved labels: jbw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r13, rsi;
        mov r14, rdx;

        lea r12, [rip + _journal_io_desc];
        mov [r12 + 0], r13;
        mov rax, 1;
        mov [r12 + 8], rax;
        mov [r12 + 16], r14;
        xor rax, rax;
        mov [r12 + 24], rax;

        mov rdi, rbx;
        mov rsi, r12;
        mov r10, 4;
        or  rsi, r10;
        call cap_invoke;
        cmp rax, 0;
        jne jbw_err;

        xor eax, eax;
        jmp jbw_done;

      jbw_err:
        mov rax, 0xFFFFED21;

      jbw_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // jnl_bdev_read_block(bdev_cap, lba, buf_ptr) -> u64
  pub let jnl_bdev_read_block : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
