  // journal_encode_dentry_add(txn_id, dir_inode, name_ptr, name_len, target_inode, out_ptr) -> u64
  //   JOP_DENTRY_ADD. payload {dir_inode:u64, name_len:u64(widened),
  //   name[]:u8 (zero-padded to 8B), target_inode:u64}. Arity 6 (ceiling).
  pub let journal_encode_dentry_add : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (txn_id: u64) (dir_inode: u64) (name_ptr: u64) (name_len: u64) (target_inode: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf, caller-save only (see gap 2 for the padding rationale). r10=padded_name_len=(name_len+7)&~8 via mov rax,rcx;add rax,7;mov r11,0xFFFFFFFFFFFFFFF8;and rax,r11;mov r10,rax (two-step mov-then-and idiom for a full-width mask, cap_handler_blkdev.pdx precedent). r11=pad_count=r10-rcx (computed before rcx is consumed as the copy-loop counter). record_hdr packed via rax=r10;add rax,24;shl rax,16;or rax,6 (payload_len=24+padded_name_len, op=6). Stores record_hdr/txn_id/dir_inode/name_len(raw) at r9+0/8/16/24. rdi repurposed as dest cursor (=out_ptr+32; txn_id's job in rdi is done by this point). Byte-copy loop (rdx=src cursor, rdi=dest cursor, rcx=remaining, matching acpi/checksum.pdx's proven xor+mov_b idiom) copies name_len raw bytes, then a second loop zero-pads r11 more bytes. rdi now points exactly at out_ptr+32+padded_name_len (the two loops together advance it by exactly padded_name_len bytes) -- store target_inode(r8) there. Return rax=r10+40 (r10=padded_name_len untouched since header packing). No test instruction. Reserved labels: jeda_.",
      block: {
        mov rax, rcx;
        add rax, 7;
        mov r11, 0xFFFFFFFFFFFFFFF8;
        and rax, r11;
        mov r10, rax;

        mov r11, r10;
        sub r11, rcx;

        mov rax, r10;
        add rax, 24;
        shl rax, 16;
        or  rax, 6;
        mov [r9 + 0], rax;
        mov [r9 + 8], rdi;
        mov [r9 + 16], rsi;
        mov [r9 + 24], rcx;

        mov rdi, r9;
        add rdi, 32;

        cmp rcx, 0;
        je jeda_name_done;
      jeda_copy:
        xor rax, rax;
        mov_b rax, [rdx];
        mov_b [rdi], rax;
        add rdx, 1;
        add rdi, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne jeda_copy;
      jeda_name_done:

        cmp r11, 0;
        je jeda_pad_done;
      jeda_pad:
        xor rax, rax;
        mov_b [rdi], rax;
        add rdi, 1;
        sub r11, 1;
        cmp r11, 0;
        jne jeda_pad;
      jeda_pad_done:

        mov [rdi + 0], r8;

        mov rax, r10;
        add rax, 40;
        ret
      }
    }

