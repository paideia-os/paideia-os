    }

  // ============================================================================
  // journal_head_lba(vol_slot) -> u64
  //   Current in-memory head LBA for vol_slot (0 if unset/out-of-range).
  // ============================================================================

  pub let journal_head_lba : (u64) -> u64 !{mem} @{} =
    fn (vol_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf, caller-save only. Bound-check vol_slot<16 else return 0 (matches head_lba's own 'unset' sentinel). row_base = &_journal_vol_state + vol_slot*64 via r10=vol_slot;shl r10,6;lea r11,[rip+_journal_vol_state];add r11,r10. Returns [row_base+0]. No test instruction. Reserved labels: jhl_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae jhl_bad;

        mov r10, rdi;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;
        mov rax, [r11 + 0];
        ret;

      jhl_bad:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // journal_writer_set_checkpoint(vol_slot, checkpoint_lba) -> ()
  //   Sets the checkpoint LBA a mount path stamps into every header this
  //   vol_slot's writer produces (defaults to journal_lba on first
  //   touch if never called explicitly).
  // ============================================================================

  pub let journal_writer_set_checkpoint : (u64, u64) -> () !{mem} @{} =
    fn (vol_slot: u64) (checkpoint_lba: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf, caller-save only. Bound-check vol_slot<16 else no-op. row_base computed the same way as journal_head_lba. Stores checkpoint_lba at [row_base+48]. No test instruction. Reserved labels: jwsc_.",
      block: {
        mov r10, 16;
        cmp rdi, r10;
        jae jwsc_done;

        mov r10, rdi;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;
        mov [r11 + 48], rsi;

      jwsc_done:
        ret
      }
    }

  // ============================================================================
  // journal_append(bdev_cap, vol_slot, journal_lba, journal_bcount,
  //                 record_ptr, record_len) -> u64
  //
  //   Appends one pre-encoded record (built by one of the
  //   journal_encode_* functions above) into vol_slot's journal ring.
  //   Lazily initializes per-vol-slot state on first touch (head_lba==0
  //   sentinel). Rolls to the next ring block when the record would not
  //   fit in the current block's records area. Durability sequencing
  //   per §4.2 (module header gap 7): write payload -> FLUSH -> compute
  //   + write csum.
  //
  //   Precondition (module header gap 1): record_len <=
  //   JNL_RECORDS_AREA_SIZE (4056). A JOP_BLOCK_WRITE record (4120 B)
  //   always violates this and is always refused.
  //
  //   Returns 0 (JNL_OK) on success, else JNL_CSUM_BAD (reused, gap 3)
  //   for a bad vol_slot, an oversized record, or a BDEV I/O failure.
  // ============================================================================

  pub let journal_append : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (vol_slot: u64) (journal_lba: u64) (journal_bcount: u64) (record_ptr: u64) (record_len: u64) -> unsafe {
      effects: { mem, sysreg }, capabilities: { cap },
      justification: "R52.M5-002 (#1704). 6-push callee-save prologue (rbx/rbp/r12/r13/r14/r15) + sub rsp,8 pad (cap_handler_blkdev.pdx's documented six-push+pad idiom) lands rsp%16==0 for every nested call. rbx=bdev_cap, rbp=vol_slot, r12=journal_lba, r13=journal_bcount, r14=record_ptr, r15=record_len -- all six preserved verbatim across every nested call for the whole function body. row_base (r11, caller-save) is recomputed via r10=rbp;shl r10,6;lea r11,[rip+_journal_vol_state];add r11,r10 immediately before EVERY use rather than cached across a nested call, since r11 is caller-save and would otherwise be silently clobbered by journal_advance_ring/jnl_bdev_write_block/jnl_bdev_flush/jnl_block_csum_compute. Body: (1) bound-check vol_slot<16 and record_len<=4056, else japp_bad (JNL_CSUM_BAD reused, gaps 1/3). (2) if [row+0]==0 (first touch): seed head_lba=journal_lba, off=32, rcnt=0, block_seq=0, next_seq=0, prev_lba=SENTINEL, checkpoint=journal_lba. (3) if off+record_len>4088: roll -- prev_lba:=old head_lba; head_lba:=journal_advance_ring(old head_lba,journal_lba,journal_bcount); off:=32; rcnt:=0; block_seq:=next_seq (snapshot). (4) if off==32 (fresh block from either (2) or (3)): zero the 512-qword stage buffer. (5) qwords=record_len/8 (exact, xor-then-div idiom, mkfs.pdx precedent) copy loop from record_ptr into stage_blk+off. (6) off+=record_len; rcnt+=1; next_seq+=1, all stored back. (7) stamp stage_blk header: magic (mov_d), record_count=rcnt (mov_d), seq=block_seq, prev_lba, checkpoint. (8) jnl_bdev_write_block(bdev_cap,head_lba,&stage_blk) [payload write] -> jne japp_err. (9) jnl_bdev_flush(bdev_cap) -> jne japp_err (the barrier between payload and csum, §4.2). (10) jnl_block_csum_compute(&stage_blk) -> stamp stage_blk+4088. (11) jnl_bdev_write_block again [csum write] -> jne japp_err. (12) xor eax,eax; success. japp_bad/japp_err both set rax=0xFFFFED21 (JNL_CSUM_BAD, reused per gap 3). No test instruction. Reserved labels: japp_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;
        mov rbp, rsi;
        mov r12, rdx;
        mov r13, rcx;
        mov r14, r8;
        mov r15, r9;

        mov r10, 16;
        cmp rbp, r10;
        jae japp_bad;

        mov r10, 4056;
        cmp r15, r10;
        ja  japp_bad;

        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;

        mov rax, [r11 + 0];
        cmp rax, 0;
        jne japp_have_head;

        mov [r11 + 0], r12;
        mov rax, 32;
        mov [r11 + 8], rax;
        xor rax, rax;
        mov [r11 + 16], rax;
        mov [r11 + 24], rax;
        mov [r11 + 32], rax;
        mov rax, 0xFFFFFFFFFFFFFFFF;
        mov [r11 + 40], rax;
        mov [r11 + 48], r12;

      japp_have_head:
        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;

        mov rax, [r11 + 8];
        mov r10, r15;
        add r10, rax;
        mov rcx, 4088;
        cmp r10, rcx;
        jbe japp_no_roll;

        mov rax, [r11 + 0];
        mov [r11 + 40], rax;
        mov rdi, rax;
        mov rsi, r12;
        mov rdx, r13;
        call journal_advance_ring;

        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;

        mov [r11 + 0], rax;
        mov rax, 32;
        mov [r11 + 8], rax;
        xor rax, rax;
        mov [r11 + 16], rax;
        mov rax, [r11 + 32];
        mov [r11 + 24], rax;

      japp_no_roll:
        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;

        mov rax, [r11 + 8];
        cmp rax, 32;
        jne japp_skip_zero;

        lea r10, [rip + _journal_stage_blk];
        xor rcx, rcx;
      japp_zero_loop:
        xor rax, rax;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jne japp_zero_loop;

      japp_skip_zero:
        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;

        mov rax, [r11 + 8];
        lea r10, [rip + _journal_stage_blk];
        add r10, rax;

        mov rax, r15;
        xor rdx, rdx;
        mov r9, 8;
        div r9;
        mov rcx, rax;

        xor r9, r9;
        cmp rcx, 0;
        je japp_copy_done;
      japp_copy_loop:
        mov rax, [r14 + r9 * 8];
        mov [r10 + r9 * 8], rax;
        add r9, 1;
        cmp r9, rcx;
        jne japp_copy_loop;
      japp_copy_done:

        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;

        mov rax, [r11 + 8];
        add rax, r15;
        mov [r11 + 8], rax;
        mov rax, [r11 + 16];
        add rax, 1;
        mov [r11 + 16], rax;
        mov rax, [r11 + 32];
        add rax, 1;
        mov [r11 + 32], rax;

        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;

        lea r10, [rip + _journal_stage_blk];
        mov rax, 0x4A424E4C;
        mov_d [r10 + 0], rax;
        mov rax, [r11 + 16];
        mov_d [r10 + 4], rax;
        mov rax, [r11 + 24];
        mov [r10 + 8], rax;
        mov rax, [r11 + 40];
        mov [r10 + 16], rax;
        mov rax, [r11 + 48];
        mov [r10 + 24], rax;

        mov rdi, rbx;
        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;
        mov rsi, [r11 + 0];
        lea rdx, [rip + _journal_stage_blk];
        call jnl_bdev_write_block;
        cmp rax, 0;
        jne japp_err;

        mov rdi, rbx;
        call jnl_bdev_flush;
        cmp rax, 0;
        jne japp_err;

        lea rdi, [rip + _journal_stage_blk];
        call jnl_block_csum_compute;
        lea r10, [rip + _journal_stage_blk];
        mov [r10 + 4088], rax;

        mov rdi, rbx;
        mov r10, rbp;
        shl r10, 6;
        lea r11, [rip + _journal_vol_state];
        add r11, r10;
        mov rsi, [r11 + 0];
        lea rdx, [rip + _journal_stage_blk];
        call jnl_bdev_write_block;
        cmp rax, 0;
        jne japp_err;

        xor eax, eax;
        jmp japp_done;

      japp_bad:
        mov rax, 0xFFFFED21;
        jmp japp_done;

      japp_err:
        mov rax, 0xFFFFED21;

      japp_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // journal_replay_applied_count / _discarded_count / _blocks_visited /
  // _head_lba / _err / _orphan_count -- readback accessors over
  // _journal_replay_stats, populated by journal_replay below.
  // ============================================================================

  pub let journal_replay_applied_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf field readback: _journal_replay_stats[+0].",
      block: { lea r10, [rip + _journal_replay_stats]; mov rax, [r10 + 0]; ret }
    }

  pub let journal_replay_discarded_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf field readback: _journal_replay_stats[+8].",
      block: { lea r10, [rip + _journal_replay_stats]; mov rax, [r10 + 8]; ret }
    }

  pub let journal_replay_blocks_visited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf field readback: _journal_replay_stats[+16].",
      block: { lea r10, [rip + _journal_replay_stats]; mov rax, [r10 + 16]; ret }
    }

  pub let journal_replay_head_lba : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf field readback: _journal_replay_stats[+24].",
      block: { lea r10, [rip + _journal_replay_stats]; mov rax, [r10 + 24]; ret }
    }

  pub let journal_replay_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf field readback: _journal_replay_stats[+32].",
      block: { lea r10, [rip + _journal_replay_stats]; mov rax, [r10 + 32]; ret }
    }

  pub let journal_replay_orphan_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-002 (#1704). Leaf field readback: _journal_replay_stats[+40] (module header gap 6).",
      block: { lea r10, [rip + _journal_replay_stats]; mov rax, [r10 + 40]; ret }
    }

  // ============================================================================
  // journal_replay(bdev_cap, vol_slot, journal_lba, journal_bcount,
  //                 checkpoint_lba) -> u64
  //
  //   Cold-boot JBNL walker per §4.3: (1) clears its own scratch state
  //   (idempotent across calls); (2) scans every block in
  //   [journal_lba, journal_lba+journal_bcount) for the highest-seq
  //   valid-magic block (the "head"); (3) walks backward via prev_lba
  //   from head to checkpoint_lba, bounded by journal_bcount steps
  //   (JNL_CHECKPOINT_BEYOND_HEAD if never reached); (4) walks forward
  //   from checkpoint_lba to head via journal_advance_ring,
  //   CSUM-verifying and seq-order-checking each block (truncating the
  //   replay range, not hard-failing, on the first violation -- a torn
  //   write at the head is expected and normal); (5) classifies every
  //   record by op into a 16-slot open-txn table (module header gap 6),
  //   folding JOP_COMMIT's buffered count into applied_total and
  //   JOP_ABORT's (or any still-open-at-end-of-range txn's) into
  //   discarded_total. Does NOT re-issue the classified writes (module
  //   header top note). Returns applied_total (0 if the journal was
  //   never written, or vol_slot is unused per module header gap 5).
  // ============================================================================

  pub let journal_replay : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (vol_slot: u64) (journal_lba: u64) (journal_bcount: u64) (checkpoint_lba: u64) -> unsafe {
      effects: { mem, sysreg }, capabilities: { cap },
      justification: "R52.M5-002 (#1704). 6-push callee-save prologue (rbx/rbp/r12/r13/r14/r15) + sub rsp,8 pad. rbx=bdev_cap, r12=journal_lba, r13=journal_bcount, r14=checkpoint_lba (reused later as per-block record cursor once dead), r15=lba cursor (scan then forward-walk), rbp=steps/blocks_visited counter (reused across phases). vol_slot(rsi) intentionally not preserved -- unused per module header gap 5. Phase 0: clear _journal_replay_txn_id (to JNL_SENTINEL_LBA)/_txn_count(0)/_stats(0) via three 16/16/8-iteration loops. Phase 1 (head discovery): linear scan r15=journal_lba..journal_lba+journal_bcount-1, jnl_bdev_read_block each; on magic match compare seq against stats[+48] (best_seq scratch)/stats[+56] (found_any flag), tracking the highest into stats[+24] (head_lba). Phase 2: if found_any==0, return 0 (nothing to replay). Phase 3 (backward walk): r15=head_lba, rbp=0; loop while r15!=checkpoint_lba: read block, prev_lba=[+16]; SENTINEL or rbp>=journal_bcount -> jrep_back_fail (stats[+32]=JNL_CHECKPOINT_BEYOND_HEAD, return it); else r15=prev_lba, rbp+=1. Phase 4 (forward walk): r15=checkpoint_lba, rbp=0 (repurposed as blocks_visited), stats[+56]=0 (have_prev_seq); loop: read block; magic mismatch -> jrep_fwd_magic_bad (truncate, stats[+32]=JNL_MAGIC_BAD); jnl_block_csum_compute mismatch -> jrep_fwd_csum_bad (truncate, JNL_CSUM_BAD); seq<=prev (when have_prev_seq) -> jrep_fwd_seq_bad (truncate, JNL_SEQ_OUT_OF_ORDER); else update prev_seq/have_prev_seq and process every record: decode op=record_hdr&0xFF, txn_id=[+8] into rdx (both read once before the op dispatch, neither touched by any branch); op==1 (BEGIN) scans _journal_replay_txn_id (index in rsi, all scratch caller-save -- see reasoning in-body) for an existing/free slot, claims a free one; op in {2,3,4,5,6,7} (write-class) finds the open txn and increments its count, or bumps stats[+40] (orphan_count, gap 6) if not found; op==8 (COMMIT) finds+folds count into stats[+0] (applied_total) and frees the slot; op==9 (ABORT) folds into stats[+8] (discarded_total) and frees the slot; shared epilogue jrep_op_next reloads record_hdr fresh (payload_len was never cached in a register that survives the dispatch, deliberately, to keep every op branch free to use any caller-save register) to compute total_len=16+payload_len and advance the record cursor r14, then loops. After all records: rbp+=1 (blocks_visited); if r15==stats[+24] (head_lba) -> jrep_fwd_done (success, reached head); else journal_advance_ring(r15,r12,r13)->r15, safety-cap rbp>=journal_bcount+1 -> jrep_fwd_done (best-effort stop). jrep_fwd_done: store rbp into stats[+16], sweep every still-open txn-table slot into stats[+8] (discarded_total, gap 6's end-of-range rule), load stats[+0] into rax, done. All early-exit paths (nothing-to-replay, checkpoint-beyond-head) converge on the shared jrep_epilogue label with rax already set. No test instruction; mov_d for the magic/record_count u32 fields. Reserved labels: jrep_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rdx;
        mov r13, rcx;
        mov r14, r8;

        lea r10, [rip + _journal_replay_txn_id];
        mov rax, 0xFFFFFFFFFFFFFFFF;
        xor rcx, rcx;
      jrep_clear_txn:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jne jrep_clear_txn;

        lea r10, [rip + _journal_replay_txn_count];
        xor rax, rax;
        xor rcx, rcx;
      jrep_clear_cnt:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jne jrep_clear_cnt;

        lea r10, [rip + _journal_replay_stats];
        xor rax, rax;
        xor rcx, rcx;
      jrep_clear_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jne jrep_clear_stats;

        mov r15, r12;
      jrep_scan_loop:
        mov r10, r12;
        add r10, r13;
        cmp r15, r10;
        jae jrep_scan_done;

        mov rdi, rbx;
        mov rsi, r15;
        lea rdx, [rip + _journal_stage_blk];
        call jnl_bdev_read_block;
        cmp rax, 0;
        jne jrep_scan_next;

        lea r10, [rip + _journal_stage_blk];
        mov_d rax, [r10 + 0];
        mov r11, 0x4A424E4C;
        cmp rax, r11;
        jne jrep_scan_next;

        mov rax, [r10 + 8];
        lea r11, [rip + _journal_replay_stats];
        mov rcx, [r11 + 56];
        cmp rcx, 0;
        jne jrep_scan_have_best;

        mov [r11 + 24], r15;
        mov [r11 + 48], rax;
        mov rcx, 1;
        mov [r11 + 56], rcx;
        jmp jrep_scan_next;

      jrep_scan_have_best:
        mov rcx, [r11 + 48];
        cmp rax, rcx;
        jbe jrep_scan_next;
        mov [r11 + 24], r15;
        mov [r11 + 48], rax;

      jrep_scan_next:
        add r15, 1;
        jmp jrep_scan_loop;

      jrep_scan_done:
        lea r10, [rip + _journal_replay_stats];
        mov rax, [r10 + 56];
        cmp rax, 0;
        jne jrep_have_head;

        xor eax, eax;
        jmp jrep_epilogue;

      jrep_have_head:
        lea r10, [rip + _journal_replay_stats];
        mov r15, [r10 + 24];
        xor rbp, rbp;

      jrep_back_loop:
        cmp r15, r14;
        je jrep_back_reached;

        mov rdi, rbx;
        mov rsi, r15;
        lea rdx, [rip + _journal_stage_blk];
        call jnl_bdev_read_block;
        cmp rax, 0;
        jne jrep_back_fail;

        lea r10, [rip + _journal_stage_blk];
        mov rax, [r10 + 16];
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je jrep_back_fail;

        mov r15, rax;
        add rbp, 1;
        cmp rbp, r13;
        jae jrep_back_fail;
        jmp jrep_back_loop;

      jrep_back_fail:
        lea r10, [rip + _journal_replay_stats];
        mov rax, 0xFFFFED22;
        mov [r10 + 32], rax;
        jmp jrep_epilogue;

      jrep_back_reached:
        mov r15, r14;
        xor rbp, rbp;
        lea r10, [rip + _journal_replay_stats];
        xor rax, rax;
        mov [r10 + 56], rax;

      jrep_fwd_loop:
        mov rdi, rbx;
        mov rsi, r15;
        lea rdx, [rip + _journal_stage_blk];
        call jnl_bdev_read_block;
        cmp rax, 0;
        jne jrep_fwd_done;

        lea r10, [rip + _journal_stage_blk];
        mov_d rax, [r10 + 0];
        mov r11, 0x4A424E4C;
        cmp rax, r11;
        jne jrep_fwd_magic_bad;

        lea rdi, [rip + _journal_stage_blk];
        call jnl_block_csum_compute;
        lea r10, [rip + _journal_stage_blk];
        mov rcx, [r10 + 4088];
        cmp rax, rcx;
        jne jrep_fwd_csum_bad;

        lea r10, [rip + _journal_stage_blk];
        mov rax, [r10 + 8];
        lea r11, [rip + _journal_replay_stats];
        mov rcx, [r11 + 56];
        cmp rcx, 0;
        je jrep_fwd_seq_ok;
        mov rcx, [r11 + 48];
        cmp rax, rcx;
        jbe jrep_fwd_seq_bad;

      jrep_fwd_seq_ok:
        lea r11, [rip + _journal_replay_stats];
        mov [r11 + 48], rax;
        mov rcx, 1;
        mov [r11 + 56], rcx;

        lea r10, [rip + _journal_stage_blk];
        mov_d rcx, [r10 + 4];
        lea r14, [r10 + 32];
        xor r8, r8;

      jrep_rec_loop:
        cmp r8, rcx;
        jae jrep_rec_done;

        mov rax, [r14 + 0];
        mov r9, rax;
        and r9, 0xFF;
        mov rdx, [r14 + 8];

        cmp r9, 1;
        je jrep_op_begin;
        cmp r9, 8;
        je jrep_op_commit;
        cmp r9, 9;
        je jrep_op_abort;
        jmp jrep_op_write;

      jrep_op_begin:
        lea r10, [rip + _journal_replay_txn_id];
        xor rsi, rsi;
      jrep_begin_scan:
        cmp rsi, 16;
        jae jrep_op_next;
        mov r9, [r10 + rsi * 8];
        cmp r9, rdx;
        je jrep_op_next;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r9, r11;
        jne jrep_begin_scan_next;
        mov [r10 + rsi * 8], rdx;
        lea r11, [rip + _journal_replay_txn_count];
        xor r9, r9;
        mov [r11 + rsi * 8], r9;
        jmp jrep_op_next;
      jrep_begin_scan_next:
        add rsi, 1;
        jmp jrep_begin_scan;

      jrep_op_write:
        lea r10, [rip + _journal_replay_txn_id];
        xor rsi, rsi;
      jrep_write_scan:
        cmp rsi, 16;
        jae jrep_write_orphan;
        mov r9, [r10 + rsi * 8];
        cmp r9, rdx;
        je jrep_write_found;
        add rsi, 1;
        jmp jrep_write_scan;
      jrep_write_found:
        lea r11, [rip + _journal_replay_txn_count];
        mov r9, [r11 + rsi * 8];
        add r9, 1;
        mov [r11 + rsi * 8], r9;
        jmp jrep_op_next;
      jrep_write_orphan:
        lea r10, [rip + _journal_replay_stats];
        mov r9, [r10 + 40];
        add r9, 1;
        mov [r10 + 40], r9;
        jmp jrep_op_next;

      jrep_op_commit:
        lea r10, [rip + _journal_replay_txn_id];
        xor rsi, rsi;
      jrep_commit_scan:
        cmp rsi, 16;
        jae jrep_op_next;
        mov r9, [r10 + rsi * 8];
        cmp r9, rdx;
        je jrep_commit_found;
        add rsi, 1;
        jmp jrep_commit_scan;
      jrep_commit_found:
        lea r11, [rip + _journal_replay_txn_count];
        mov r9, [r11 + rsi * 8];
        lea r10, [rip + _journal_replay_stats];
        mov rax, [r10 + 0];
        add rax, r9;
        mov [r10 + 0], rax;
        lea r10, [rip + _journal_replay_txn_id];
        mov r9, 0xFFFFFFFFFFFFFFFF;
        mov [r10 + rsi * 8], r9;
        jmp jrep_op_next;

      jrep_op_abort:
        lea r10, [rip + _journal_replay_txn_id];
        xor rsi, rsi;
      jrep_abort_scan:
        cmp rsi, 16;
        jae jrep_op_next;
        mov r9, [r10 + rsi * 8];
        cmp r9, rdx;
        je jrep_abort_found;
        add rsi, 1;
        jmp jrep_abort_scan;
      jrep_abort_found:
        lea r11, [rip + _journal_replay_txn_count];
        mov r9, [r11 + rsi * 8];
        lea r10, [rip + _journal_replay_stats];
        mov rax, [r10 + 8];
        add rax, r9;
        mov [r10 + 8], rax;
        lea r10, [rip + _journal_replay_txn_id];
        mov r9, 0xFFFFFFFFFFFFFFFF;
        mov [r10 + rsi * 8], r9;
        jmp jrep_op_next;

      jrep_op_next:
        mov rax, [r14 + 0];
        shr rax, 16;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        add rax, 16;
        add r14, rax;

        add r8, 1;
        jmp jrep_rec_loop;

      jrep_rec_done:
        add rbp, 1;

        lea r10, [rip + _journal_replay_stats];
        mov rax, [r10 + 24];
        cmp r15, rax;
        je jrep_fwd_done;

        mov rdi, r15;
        mov rsi, r12;
        mov rdx, r13;
        call journal_advance_ring;
        mov r15, rax;

        mov r10, r13;
        add r10, 1;
        cmp rbp, r10;
        jae jrep_fwd_done;

        jmp jrep_fwd_loop;

      jrep_fwd_magic_bad:
        lea r10, [rip + _journal_replay_stats];
        mov rax, 0xFFFFED20;
        mov [r10 + 32], rax;
        jmp jrep_fwd_done;

      jrep_fwd_csum_bad:
        lea r10, [rip + _journal_replay_stats];
        mov rax, 0xFFFFED21;
        mov [r10 + 32], rax;
        jmp jrep_fwd_done;

      jrep_fwd_seq_bad:
        lea r10, [rip + _journal_replay_stats];
        mov rax, 0xFFFFED23;
        mov [r10 + 32], rax;
        jmp jrep_fwd_done;

      jrep_fwd_done:
        lea r10, [rip + _journal_replay_stats];
        mov [r10 + 16], rbp;

        lea r10, [rip + _journal_replay_txn_id];
        xor rsi, rsi;
      jrep_sweep_loop:
        cmp rsi, 16;
        jae jrep_sweep_done;
        lea r10, [rip + _journal_replay_txn_id];
        mov r9, [r10 + rsi * 8];
        mov rax, 0xFFFFFFFFFFFFFFFF;
        cmp r9, rax;
        je jrep_sweep_next;

        lea r11, [rip + _journal_replay_txn_count];
        mov rdx, [r11 + rsi * 8];
        lea r10, [rip + _journal_replay_stats];
        mov rax, [r10 + 8];
        add rax, rdx;
        mov [r10 + 8], rax;

      jrep_sweep_next:
        add rsi, 1;
        jmp jrep_sweep_loop;

      jrep_sweep_done:
        lea r10, [rip + _journal_replay_stats];
        mov rax, [r10 + 0];

      jrep_epilogue:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
