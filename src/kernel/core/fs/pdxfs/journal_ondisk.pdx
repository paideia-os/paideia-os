      effects: { mem, sysreg }, capabilities: { cap },
      justification: "R52.M5-002 (#1704). Same shape as jnl_bdev_write_block, op_code 3 (BDEV_OP_READ_LBA), dma_iova=buf_ptr is the DESTINATION here. Any nonzero cap_invoke result maps to JNL_CSUM_BAD (reused, gap 3). No test instruction. Reserved labels: jbr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r13, rsi;
        mov r14, rdx;

        lea r12, [rip + _journal_io_desc];
        mov [r12 + 0], r13;
        mov rax, 1;
        mov [r12 + 8], rax;
        mov [r12 + 16], r14;
        xor rax, rax;
        mov [r12 + 24], rax;

        mov rdi, rbx;
        mov rsi, r12;
        mov r10, 3;
        or  rsi, r10;
        call cap_invoke;
        cmp rax, 0;
        jne jbr_err;

        xor eax, eax;
        jmp jbr_done;

      jbr_err:
        mov rax, 0xFFFFED21;

      jbr_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // jnl_bdev_flush(bdev_cap) -> u64
  pub let jnl_bdev_flush : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) -> unsafe {
      effects: { mem, sysreg }, capabilities: { cap },
      justification: "R52.M5-002 (#1704). 5-push callee-save prologue (rbx/r12/r13/r14/r15, pattern uniformity with jnl_bdev_write_block/_read_block) lands rsp%16==0 for the nested cap_invoke call. rbx=bdev_cap, r12=&_journal_io_desc (lba/nblocks/dma_iova/status_out all zeroed -- FLUSH's descriptor fields are not consumed for addressing, only status_out is written back). rdi=rbx; rsi=r12 OR'd with op_code 5 (BDEV_OP_FLUSH); call cap_invoke. This is the first FS-level BDEV_OP_FLUSH caller in the kernel (module header gap 7). Any nonzero result maps to JNL_CSUM_BAD (reused, gap 3). No test instruction. Reserved labels: jbf_.",
