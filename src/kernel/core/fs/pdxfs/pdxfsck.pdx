// src/kernel/core/fs/pdxfs/pdxfsck.pdx -- R52.M3-004 (#1695)
//
// PDXFS-ON-BLOCK v1 -- tools/pdxfsck: FREE-SPACE STATS + BITMAP
//                       CONSISTENCY VERIFIER.
//
// Design authority: design/filesystem/r52-implementation-plan.md §2.3
// (R52.M3, step 4: "#1695 -- tools/pdxfsck userspace tool: reads every
// inode's root_block and walks the CoW-tree references, comparing
// against the allocator bitmap. Reports mismatches (allocated-but-
// unreferenced, referenced-but-unallocated). Runs after mkfs in the M2
// smoke to prove the empty volume is consistent."); the issue's own
// title narrows this landing's scope to "R52.M3-004: Land tools/pdxfsck
// -- free-space verify" -- see "Design-doc gaps flagged" below for why
// the inode-cross-check half of §2.3 step 4 is not implemented here.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Lands the "free-space verify" sub-scope named by the issue title:
//
//   pdxfsck_bitmap_alignment_check(sb_ptr: u64) -> u64
//     Verifies the allocator bitmap region has enough bit capacity to
//     cover every data block the superblock claims (alloc_bcount*32768
//     >= data_bcount), and that neither region is degenerately empty.
//
//   pdxfsck_free_stack_duplicate_check() -> u64
//     Scans the allocator's in-memory LIFO free-block hint stack
//     (allocator.pdx, #1692) for a duplicate lba entry -- a concrete,
//     checkable "no double-frees" signal available without a persisted
//     free-list format (see gap 4 below).
//
//   pdxfsck_run(bdev_cap: u64, sb_ptr: u64, stats_out_ptr: u64) -> u64
//     Composite entry point: runs the two checks above, then walks the
//     whole allocator bitmap region (every alloc_bcount block, via
//     alloc_bm_load_block, #1694) counting free vs allocated bits across
//     exactly the first data_bcount bits (the volume's real data-block
//     count; any padding tail bits in the last bitmap block past
//     data_bcount are not counted). Populates the caller-owned 24-byte
//     `stats_out_ptr` scratch:
//       [+0]  free_blocks   (u64, count of clear bits in [0, data_bcount))
//       [+8]  data_bcount   (u64, from the superblock, for reference)
//       [+16] alloc_bcount  (u64, from the superblock, for reference)
//     Returns 0 on success, or FSCK_BITMAP_MISMATCH if either check
//     above failed (stats_out_ptr is not populated at all in that case),
//     or ALLOC_BITMAP_TORN (forwarded verbatim from alloc_bm_load_block)
//     if a per-block read failed partway through the scan (stats_out_ptr
//     [+8]/[+16] are already populated by that point; [+0] is not).
//
// -----------------------------------------------------------------------------
// Design-doc gaps flagged (see final report to main / softarch)
// -----------------------------------------------------------------------------
//
// 1. Location. §2.3's "Files new" line names
//    `src/userspace/pkg/pdxfsck/{cmd_pdxfsck.pdx, walk_inodes.pdx,
//    verify_bitmap.pdx, main.pdx}`. That userspace package tree does not
//    exist in this repo (`src/user/` holds freestanding executables with
//    `.ld` link scripts -- init, shell, echo_client/server, etc. -- not
//    a `pkg/` library layout), exactly the gap `mkfs.pdx` (#1688) already
//    flagged and descoped from for the same design doc's M2 "Files new"
//    line. This landing follows that same precedent: pdxfsck lands as a
//    kernel-space callable primitive module under `core/fs/pdxfs/`
//    rather than as a userspace binary, one file instead of four.
//
// 2. Inode-cross-check descoped. §2.3 step 4's full description --
//    "reads every inode's root_block and walks the CoW-tree references,
//    comparing against the allocator bitmap. Reports mismatches
//    (allocated-but-unreferenced, referenced-but-unallocated)" -- is NOT
//    implemented here. `inode_table.pdx` (R52.M4, #1697-#1702) has not
//    landed yet: there is no inode row format, no `inode_read`, no
//    root_block/CoW-tree walk primitive to read from at this point in
//    the build sequence (M3 is still landing; M4 is next). This landing
//    instead implements exactly R52.M3-004's own title scope ("free-
//    space verify"): bitmap/superblock alignment, a free-stack no-
//    double-free proxy, and a free/allocated bit count. The inode-vs-
//    bitmap cross-check (the two mismatch categories named above) is
//    deferred to a follow-up issue once M4's inode table lands --
//    flagged for softarch to file against the M4 milestone.
//
// 3. `pdxfsck_run`'s bitmap-scan precondition. Reading the resident
//    bitmap block(s) via `alloc_bm_load_block` requires the allocator's
//    cached geometry (`_alloc_state`'s `alloc_lba`/`alloc_bcount`/
//    `data_lba`) to already be seeded -- i.e. `alloc_init` or
//    `alloc_scan_on_mount` must already have run this boot. This is the
//    same undocumented-in-band precondition `allocator.pdx`'s own header
//    flags as gap 3 for `alloc_block`/`free_block` (no frozen M3
//    sentinel exists for "not initialized"; the full 8-code M3 band is
//    already allocated). `pdxfsck_run` deliberately does NOT call
//    `alloc_init` itself to paper over this -- `alloc_init` destructively
//    empties the free stack (zeroes `_alloc_free_stack_state`'s count),
//    which would silently discard the very state
//    `pdxfsck_free_stack_duplicate_check` needs to inspect if it ran
//    first in the same call. Callers (the M3 boot witness, #1696, or a
//    future mount path) must ensure `alloc_scan_on_mount` has already run
//    before invoking `pdxfsck_run`.
//
// 4. "No double-frees" is a live/runtime check, not an on-disk one. The
//    free-block hint stack is pure in-memory state (allocator.pdx never
//    persists it) -- there is no on-disk free-list format for a genuine
//    "was this bitmap bit cleared twice" audit to inspect. Runtime
//    double-frees are already refused live by `free_block`'s own
//    `FREE_DOUBLE` check (#1692) at the moment they would occur; this
//    module's `pdxfsck_free_stack_duplicate_check` instead audits
//    whether the SAME lba appears twice in the pending-reuse stack (which
//    would indicate a hypothetical caller bypassed `free_block`'s guard
//    via some other path), the best available proxy for this issue's
//    "no double-frees" requirement without a persisted free-list. Added
//    `Allocator.alloc_free_stack_peek` (allocator.pdx, same file/object
//    as the storage it reads -- no `tools/build.sh` `ec_confine_one`
//    change needed) as the nondestructive accessor this check needs;
//    the existing `alloc_free_stack_pop` could not be reused here since
//    it mutates state as a side effect of merely inspecting it.
//
// 5. Single-resident-block bitmap access. Per allocator.pdx's own gap 2,
//    `alloc_block`/`free_block` only ever address ONE resident 4-KiB
//    bitmap block. `pdxfsck_run`'s free-bit-count loop instead walks
//    every block directly via `alloc_bm_load_block` (#1694) -- the same
//    multi-block helper `alloc_scan_on_mount` already uses -- rather
//    than the single-resident-block accessor pair, so it correctly
//    covers the whole `alloc_bcount`-block region on a volume large
//    enough to need more than one bitmap block.
//
// -----------------------------------------------------------------------------
// Storage
// -----------------------------------------------------------------------------
//
// None. Every function here is stateless over its own module: geometry
// is read fresh from the caller-supplied `sb_ptr` / `Allocator._alloc_
// state` (via `Allocator`'s own accessors) on every call, and the 24-
// byte stats record is caller-owned (`stats_out_ptr`), not a global.
// Consequently no `tools/build.sh` `ec_confine_one` entries are needed
// for this file.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- reuses the M3 band frozen in allocator.pdx (see
// design/filesystem/r52-implementation-plan.md §4/§7.2)
// -----------------------------------------------------------------------------
//
// `FSCK_BITMAP_MISMATCH = 0xFFFFED17` is restated here as a local
// constant (this codebase's convention for citing another module's
// frozen sentinel by literal value plus a comment -- see superblock.pdx
// header's own note on why: "there is no precedent in this codebase for
// one .pdx module referencing another module's `pub let` constant by
// name"). Authoritative source: allocator.pdx (#1692), wired by this
// file (#1695). `pdxfsck_run` additionally forwards `ALLOC_BITMAP_TORN`
// (0xFFFFED11) verbatim from a failed `alloc_bm_load_block` call mid-scan,
// same "forward the nested failure verbatim" convention `mkfs_run`
// already uses for `mkfs_zero_region`/`sb_write`'s codes.
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §3.5)
// -----------------------------------------------------------------------------
//
// `pdxfsck_bitmap_alignment_check(sb_ptr)` = 1.
// `pdxfsck_free_stack_duplicate_check()` = 0.
// `pdxfsck_run(bdev_cap, sb_ptr, stats_out_ptr)` = 3. Every arity sits
// far under the paideia-as ceiling of 6.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// - `pdxfsck_bitmap_alignment_check`: 1 push (rbx = sb_ptr, reloaded
//   into rdi before each of the 2 nested `sb_*` accessor calls). Entry
//   rsp%16==8 + 8 = 16, %16==0. Same shape as allocator.pdx's
//   `alloc_init`.
// - `pdxfsck_free_stack_duplicate_check`: 5 pushes (rbx = count,
//   r12 = outer index i, r13 = inner index j, r14 = peeked value at i,
//   r15 = unused-but-pushed for pattern uniformity with allocator.pdx's
//   `alloc_block`/`free_block`/`alloc_scan_on_mount`). Entry
//   rsp%16==8 + 40 = 48, %16==0 -- a genuine 4-live-value need (count/i/
//   j/val_i) rounded up to the next ODD push count so the frame self-
//   aligns without an extra `sub rsp, 8` (an even push count from this
//   entry rsp%16==8 lands rsp%16==8, still misaligned for the nested
//   `call`s below; see the arity-hazard note in mkfs.pdx's own header
//   for why only odd push counts self-align from this ABI's fixed
//   entry offset).
// - `pdxfsck_run`: 5 pushes (rbx = bdev_cap, persists the whole
//   function; r12 = stats_out_ptr, persists the whole function; r13 =
//   sb_ptr for the four setup-phase calls, THEN reused as `global_idx`
//   once sb_ptr's last use -- the `sb_alloc_bcount` call -- has passed;
//   r14 = data_bcount, written once after the `sb_data_bcount` call and
//   left untouched afterward so it doubles as the scan loop's upper
//   bound with no reload needed; r15 = unused during setup, then
//   `free_count`, zeroed at loop entry). Entry rsp%16==8 + 40 = 48,
//   %16==0. This register-reuse-after-last-use pattern (sb_ptr -> the
//   loop's global bit index) mirrors `mkfs_run`'s own reuse of `total_
//   blocks`'s register slot once its value is fully embedded in the
//   layout row.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere (bitmap bits are read one at a
// time through `Allocator.alloc_bit_test`, which itself does the qword
// decomposition; this file never touches `_alloc_bm_buf` directly), so
// no `mov_b` is needed. No `test` instruction anywhere; every zero/
// nonzero and ordering check uses `cmp reg, imm`/`cmp reg, reg` +
// `je`/`jne`/`jb`/`jae`. `and rax, 32767` (the bit-index-within-block
// mask) and `shr rax, 15` (the block-index extraction, the inverse of
// allocator.pdx's own `alloc_scan_on_mount` `shl rax, 15`) are both safe
// direct immediates -- bit31 clear on 32767, and a plain shift count on
// 15 -- matching this codebase's own "safe imm32" precedent (allocator.
// pdx's `and rcx, 63` note). Every label in this file is prefixed with
// its owning function's abbreviation (`pdxfsck_bac_` for
// `pdxfsck_bitmap_alignment_check`, `pdxfsck_fsd_` for
// `pdxfsck_free_stack_duplicate_check`, `pdxfsck_run_` for
// `pdxfsck_run`), per the reserved-label discipline.

module Pdxfsck = structure {

  // ============================================================================
  // M3 failure taxonomy -- restated from allocator.pdx (#1692); see this
  // file's header for why the value is a literal restatement rather than
  // a cross-module symbol reference.
  // ============================================================================

  pub let FSCK_BITMAP_MISMATCH : u64 = 0xFFFFED17   // wired here (#1695); frozen at allocator.pdx (#1692)

  // ============================================================================
  // pdxfsck_bitmap_alignment_check(sb_ptr: u64) -> u64
  //   0 if alloc_bcount and data_bcount are both nonzero AND
  //   alloc_bcount*32768 >= data_bcount (the allocator bitmap region has
  //   enough bits to address every data block the superblock claims),
  //   else FSCK_BITMAP_MISMATCH.
  // ============================================================================
  pub let pdxfsck_bitmap_alignment_check : (u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-004 (#1695). 1-push prologue (rbx = sb_ptr) lands rsp%16==0 for the 2 nested sb_* accessor calls (entry rsp%16==8 + 8 = 16), same shape as allocator.pdx's alloc_init. Body: (1) rbx=sb_ptr. (2) rdi=rbx; call sb_alloc_bcount; r10=rax; cmp r10,0; je bad (degenerate empty bitmap region). (3) rdi=rbx; call sb_data_bcount; r11=rax; cmp r11,0; je bad (degenerate empty data region). (4) rax=r10; shl rax,15 (alloc_bcount*32768, same shift idiom allocator.pdx's alloc_scan_on_mount already proves for this exact multiplier); cmp rax,r11; jb bad (bitmap capacity short of data_bcount). (5) xor eax,eax; jmp done. bad: mov rax,0xFFFFED17; done: pop rbx; ret. Reserved labels: pdxfsck_bac_.",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rdi, rbx;
        call sb_alloc_bcount;
        mov r10, rax;
        cmp r10, 0;
        je pdxfsck_bac_bad;

        mov rdi, rbx;
        call sb_data_bcount;
        mov r11, rax;
        cmp r11, 0;
        je pdxfsck_bac_bad;

        mov rax, r10;
        shl rax, 15;
        cmp rax, r11;
        jb pdxfsck_bac_bad;

        xor eax, eax;
        jmp pdxfsck_bac_done;

      pdxfsck_bac_bad:
        mov rax, 0xFFFFED17;

      pdxfsck_bac_done:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pdxfsck_free_stack_duplicate_check() -> u64
  //   0 if no two entries in the allocator's current LIFO free-block
  //   hint stack (allocator.pdx, #1692) hold the same lba, else
  //   FSCK_BITMAP_MISMATCH. Nondestructive (uses alloc_free_stack_count
  //   / alloc_free_stack_peek only, #1695).
  // ============================================================================
  pub let pdxfsck_free_stack_duplicate_check : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-004 (#1695). 5-push prologue (rbx=count, r12=outer index i, r13=inner index j, r14=peeked value at i, r15=unused-but-pushed for pattern uniformity) lands rsp%16==0 (entry rsp%16==8 + 40 = 48) -- a genuine 4-live-value need rounded to the next odd push count so the nested alloc_free_stack_peek calls below see correct alignment; see header. Body: (1) call alloc_free_stack_count; rbx=rax. cmp rbx,2; jb ok (0 or 1 entries -- no pair possible). (2) r12=0 (i). outer: rax=r12; rcx=rbx; sub rcx,1; cmp rax,rcx; jae ok (i>=count-1, no j>i remains). (3) rdi=r12; call alloc_free_stack_peek; r14=rax (val at i). (4) r13=r12; add r13,1 (j=i+1). inner: cmp r13,rbx; jae inner_done. rdi=r13; call alloc_free_stack_peek; cmp rax,r14; je dup. add r13,1; jmp inner. inner_done: add r12,1; jmp outer. dup: mov rax,0xFFFFED17; jmp done. ok: xor eax,eax. done: 5-pop epilogue + ret. jb/jae proven throughout (allocator.pdx's own alloc_block/alloc_scan_on_mount). Reserved labels: pdxfsck_fsd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        call alloc_free_stack_count;
        mov rbx, rax;
        cmp rbx, 2;
        jb pdxfsck_fsd_ok;

        xor r12, r12;

      pdxfsck_fsd_outer:
        mov rax, r12;
        mov rcx, rbx;
        sub rcx, 1;
        cmp rax, rcx;
        jae pdxfsck_fsd_ok;

        mov rdi, r12;
        call alloc_free_stack_peek;
        mov r14, rax;

        mov r13, r12;
        add r13, 1;

      pdxfsck_fsd_inner:
        cmp r13, rbx;
        jae pdxfsck_fsd_inner_done;

        mov rdi, r13;
        call alloc_free_stack_peek;
        cmp rax, r14;
        je pdxfsck_fsd_dup;

        add r13, 1;
        jmp pdxfsck_fsd_inner;

      pdxfsck_fsd_inner_done:
        add r12, 1;
        jmp pdxfsck_fsd_outer;

      pdxfsck_fsd_dup:
        mov rax, 0xFFFFED17;
        jmp pdxfsck_fsd_done;

      pdxfsck_fsd_ok:
        xor eax, eax;

      pdxfsck_fsd_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // pdxfsck_run(bdev_cap: u64, sb_ptr: u64, stats_out_ptr: u64) -> u64
  //   Composite free-space-verify entry point. See file header for full
  //   semantics, precondition (allocator must already be initialized
  //   this boot), and stats_out_ptr's 24-byte layout.
  // ============================================================================
  pub let pdxfsck_run : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (sb_ptr: u64) (stats_out_ptr: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M3-004 (#1695). 5-push prologue (rbx=bdev_cap, r12=stats_out_ptr, r13=sb_ptr then reused as global_idx, r14=data_bcount, r15=unused then free_count) lands rsp%16==0 (entry rsp%16==8 + 40 = 48) for every nested call below; see header's Register discipline section for the full reuse-after-last-use rationale. Body: (1) rbx=bdev_cap(rdi), r12=stats_out_ptr(rdx), r13=sb_ptr(rsi). (2) rdi=r13; call pdxfsck_bitmap_alignment_check; cmp rax,0; jne mismatch. (3) call pdxfsck_free_stack_duplicate_check; cmp rax,0; jne mismatch. (4) rdi=r13; call sb_data_bcount; r14=rax; mov [r12+8],r14. (5) rdi=r13; call sb_alloc_bcount; mov [r12+16],rax (value not kept in a register -- not needed again). (6) r13=0 (global_idx, sb_ptr's last use was step 5). r15=0 (free_count). loop: cmp r13,r14 (data_bcount bound); jae loop_done. (7) rax=r13; and rax,32767; cmp rax,0; jne skip_load -- rax=r13; shr rax,15 (block_idx); rdi=rbx; rsi=rax; call alloc_bm_load_block; cmp rax,0; jne torn (forwards ALLOC_BITMAP_TORN verbatim). skip_load: (8) rax=r13; and rax,32767; rdi=rax; call alloc_bit_test; cmp rax,0; jne not_free -- add r15,1. not_free: add r13,1; jmp loop. loop_done: mov [r12+0],r15; xor eax,eax; jmp done. torn: (rax already ALLOC_BITMAP_TORN); jmp done. mismatch: mov rax,0xFFFFED17; done: 5-pop epilogue + ret. No test instruction; no mov_b. Reserved labels: pdxfsck_run_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r12, rdx;
        mov r13, rsi;

        mov rdi, r13;
        call pdxfsck_bitmap_alignment_check;
        cmp rax, 0;
        jne pdxfsck_run_mismatch;

        call pdxfsck_free_stack_duplicate_check;
        cmp rax, 0;
        jne pdxfsck_run_mismatch;

        mov rdi, r13;
        call sb_data_bcount;
        mov r14, rax;
        mov [r12 + 8], r14;

        mov rdi, r13;
        call sb_alloc_bcount;
        mov [r12 + 16], rax;

        xor r13, r13;
        xor r15, r15;

      pdxfsck_run_loop_top:
        cmp r13, r14;
        jae pdxfsck_run_loop_done;

        mov rax, r13;
        and rax, 32767;
        cmp rax, 0;
        jne pdxfsck_run_skip_load;

        mov rax, r13;
        shr rax, 15;
        mov rdi, rbx;
        mov rsi, rax;
        call alloc_bm_load_block;
        cmp rax, 0;
        jne pdxfsck_run_torn;

      pdxfsck_run_skip_load:
        mov rax, r13;
        and rax, 32767;
        mov rdi, rax;
        call alloc_bit_test;
        cmp rax, 0;
        jne pdxfsck_run_not_free;

        add r15, 1;

      pdxfsck_run_not_free:
        add r13, 1;
        jmp pdxfsck_run_loop_top;

      pdxfsck_run_loop_done:
        mov [r12 + 0], r15;
        xor eax, eax;
        jmp pdxfsck_run_done;

      pdxfsck_run_torn:
        jmp pdxfsck_run_done;

      pdxfsck_run_mismatch:
        mov rax, 0xFFFFED17;

      pdxfsck_run_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
