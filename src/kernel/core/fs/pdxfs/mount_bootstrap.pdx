// src/kernel/core/fs/pdxfs/mount_bootstrap.pdx -- R53.M3-004 (paideia-os #1745)
//
// mount_bootstrap -- root filesystem installation seam.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/tooling/volume-lifecycle-mechanism.md §4.1 / §4.4 / §4.5, and paideia-os
// R53.M3 milestone item R53.M3-004:
//
//   "mount_bootstrap uses MOUNT_BACKEND_PDXFS_BLOCK for slot 0 when the
//    probe selected a volume; falls back to the existing R16 TMPFS
//    bootstrap otherwise.  Preserves today's --no-disk behavior."
//
// This file is the branching primitive.  It composes two already-landed
// entry points -- `mount_pdxfs_block` (core/fs/pdxfs/mount_block.pdx,
// R52.M5-005 #1707) for the on-disk arm, and `mount` (core/fs/mount.pdx,
// R16-M1-005 #574) with backend_type=MOUNT_BACKEND_TMPFS (1) for the
// fallback arm.  Neither entry point is re-implemented here; this
// function's whole job is "call the probe-selection primitive; branch
// on its result".
//
// The intended boot-sequence position (wired by sibling R53.M3-005
// #1746 / M3-006 #1747, NOT here) is: after `pdxb_volume_probe_all_
// bdev()` has populated the volume registry from every live
// KIND_BLKDEV cap the R51 driver family minted, and before the vfs
// witness block that assumes a root mount exists.  This file provides
// the callable primitive; the call-site landing is that later
// milestone's concern.
//
// -----------------------------------------------------------------------------
// Sibling coordination (M3 wave)
// -----------------------------------------------------------------------------
//
//  - R53.M3-001 (#1742): NEW src/kernel/boot/handoff.pdx (factor
//    _init_handoff_* + add root_volume_uuid[16]).  When landed, exposes
//    a leaf reader for the bootloader UUID hint; this function's
//    selection primitive is layered so that hint can be threaded
//    without touching either arm of the branch.
//  - R53.M3-002 (#1743): wire pdxb_volume_probe_all_bdev() into
//    kernel_main after nvme_probe.  This IS the pre-condition for this
//    function's PDXFS_BLOCK arm to have any live volume-registry rows
//    to select from; on a --no-disk boot the registry stays empty and
//    this function takes the TMPFS fallback path unconditionally.
//  - R53.M3-003 (#1744): root_select (hint > flag > single > tmpfs-
//    fallback) -- OPEN as of authoring.  The task's exact framing is
//    "call `root_select()` from sibling #1744 (or the equivalent
//    selection primitive)".  Until the sibling lands, this function
//    inlines the SINGLE-DEVICE DISAMBIGUATION step of §4.4 (which is
//    root_select's step 3, and by construction the only step reachable
//    on a boot with no bootloader hint and no ROOT-flag reader) as its
//    equivalent selection primitive.  This preserves --no-disk parity
//    byte-for-byte (empty registry -> 0 live rows -> fallback) and
//    handles the single-live-device case correctly.  When #1744 lands
//    a fuller root_select body (hint match + ROOT-flag scan + single-
//    device fallback), the scan loop below is replaced by a single
//    `call root_select` with the same {live vol_idx | sentinel}
//    semantics; the branch and both mount arms stay unchanged.
//  - R53.M3-005 (#1746): fingerprint emit (PDXB PROBE OK / SKIP /
//    VOLUME MOUNTED / ROOT SELECTED / ROOT FALLBACK).  Hooks land on
//    the two exit paths of this function; the primitive itself does
//    not klog (mirrors mount_pdxfs_block's own silent-primitive shape,
//    where every observability line lives in a witness layer).
//  - R53.M3-006 (#1747): witness that a --no-disk configuration emits
//    FALLBACK TMPFS.  Consumes this function directly; its no-disk
//    posture matches the empty-registry -> fallback path below one-for-
//    one.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
// This file declares no new failure sentinels.  Every non-zero return
// is FORWARDED VERBATIM from either `mount_pdxfs_block` (mount_slot
// index in [0..7] on success; 0xFFFF on mount-table exhaustion;
// 0xFFFFED26 MOUNT_ROOT_AMBIGUOUS on hint mismatch; sb_*/vol_*/jnl_*
// codes on the various substrate failures) or `mount` (slot index in
// [0..7] on success; 0xFFFF on any failure per its own header).  A
// caller that needs to disambiguate the arm that was taken inspects
// _mount_table[MOUNT_ROOT_SLOT] itself afterwards -- the backend byte
// at bits [32,40) names the arm authoritatively (5 = PDXFS_BLOCK,
// 1 = TMPFS) with no rediagnosis needed from rax.
//
// Substrate posture: on a --no-disk boot the volume registry stays
// empty; the single-device scan returns 0 live rows; the branch takes
// the TMPFS fallback path; `mount("/", TMPFS)` succeeds (identical to
// today's R16 boot); mount_bootstrap returns MOUNT_ROOT_SLOT (0).  No
// regression.
//
// -----------------------------------------------------------------------------
// Cap-slot assignment
// -----------------------------------------------------------------------------
//
// `mount_pdxfs_block(cap_slot, bdev_cap, uuid_hint_lo, uuid_hint_hi)`
// stamps a KIND_VOLUME cap into `cap_slot` on success.  The choice of
// slot is not mount-table-visible (the mount table's _reserved field
// holds the volume registry row id, not the cap slot -- see §4.5).
// This function pins `MBOT_ROOT_VOLUME_CAP_SLOT = 176`, following the
// convention every M8 boot-mount smoke witness (pdxfs_boot_mount_smoke,
// pdxfs_reboot_verify_smoke, mount_replay_witness_synth,
// inode_table_witness_synth) already uses to minitmb the root volume
// cap on top of the R51 NVMe cap chain at slots 172..175.  A future
// boot-time free-cap-slot scan (deferred to a post-R53 wave, per
// sys_mount.pdx's own §Scaffolding note on the same seam) can replace
// this constant with a dynamic allocation without touching either
// mount arm.
//
// -----------------------------------------------------------------------------
// Arity discipline
// -----------------------------------------------------------------------------
//
// `mount_bootstrap()`, arity 0.  No arguments -- the whole selection
// state lives in the volume registry, populated by probe.pdx before
// this call.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// Three values are alive across the volume-registry scan loop's
// `volume_tail_valid` call and the subsequent `volume_row_device_slot`
// + `mount_pdxfs_block` / `mount` calls: the current scan index
// (walking 0..VOL_MAX), the SELECTED volume row id (set once for the
// unique live row we find, or a sentinel if none/multiple), and the
// live-row COUNT (used to gate exactly-one-live).  All three fit in
// callee-save regs; 3-push prologue (rbx, r12, r13, odd count) lands
// rsp%16==0 with no pad (SysV-entry rsp%16==8 + 24 = 32, %16==0)
// mirroring volume_registry_find's own 3-push shape one-for-one.
//   rbx = scan idx (0..VOL_MAX, then dead after the loop)
//   r12 = selected vol_idx (MBOT_VOLIDX_NONE = 0xFFFF until a match)
//   r13 = live count (0 = fallback, 1 = select, >=2 = fallback per
//         §4.4's own "ambiguous" fallthrough)
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere (every value touched is a whole
// qword -- register-form scan idx, selected vol_idx, live count).  No
// `test` instruction; every branch is `cmp reg, imm`/`cmp reg, reg`
// + `je`/`jne`/`jae`.  The VOL_DECODE_BAD sentinel (0xFFFFFFFFFFFFFFFF)
// is compared through r10 rather than as a bare imm (bit-63-set imm
// discipline, matching umount_block.pdx's own vol_rds_bad comparison
// idiom one-for-one).  Every label is prefixed `mbs_` -- grep audit
// 2026-08-23: no `mbs_` hits anywhere in src/kernel/ (`mbs_` is
// distinct from mount_block.pdx's own `mpb_`, umount_block.pdx's
// `umb_`, and every other pdxfs prefix by construction of its two-
// letter root `mb`+`s`).

module MountBootstrap = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  // Sentinel for r12 (selected vol_idx) when no live row has been seen.
  // Distinct from VOL_MAX (16) and from any live row id (0..15).
  pub let MBOT_VOLIDX_NONE : u64 = 0xFFFF

  // Well-known cap-table slot the mount_pdxfs_block call stamps the
  // KIND_VOLUME cap into.  See file header §Cap-slot assignment for
  // why 176.
  pub let MBOT_ROOT_VOLUME_CAP_SLOT : u64 = 176

  // Path buffer for the tmpfs fallback's mount() call.  "/\0" NUL-
  // terminated per mount()'s own path_ptr contract (see mount.pdx §mount
  // Phase 4: submount branch call path_resolve, which requires NUL
  // termination; the bootstrap branch of mount() nominally accepts "/"
  // without validating, but the NUL keeps this file self-contained if
  // mount()'s bootstrap-vs-submount split ever tightens).
  pub let _mbot_root_path : [u8; 2] = "/\0"

  // ==========================================================================
  // R53.M5-004 (#1757) fingerprint string.  Emitted from the tmpfs-
  // fallback arm of mount_bootstrap immediately before the fallback
  // mount() call.  More specific than root_select.pdx's own
  // "PDXB ROOT FALLBACK" fingerprint (R53.M3-005 / #1746): that line
  // says "no PdxFS-block root was selected"; this line says "the
  // caller chose the R16 tmpfs bootstrap as the concrete substitute".
  // Both lines fire in the substrate/no-disk boot in the fixed order
  // ROOT FALLBACK -> ROOT FALLBACK TMPFS (root_select's site runs
  // before the mount_bootstrap seam per r30_platform.pdx's own
  // sequence).  Output-strip-clean per design/policy/output-
  // provenance-strip.md (no round/milestone/issue reference in the
  // emitted string).  Length count includes the trailing "\n\0" pair.
  // ==========================================================================

  pub let pdxb_root_fallback_tmpfs_msg : [u8; 26] = "PDXB ROOT FALLBACK TMPFS\n\0"

  // ==========================================================================
  // Observability stats.  0 = INVOCATIONS, 1 = PDXFS_BLOCK arm taken,
  // 2 = TMPFS fallback arm taken.  Bumped on each exit path; a witness
  // (M3-006 #1747) reads these to distinguish the two arms without
  // having to inspect _mount_table itself.
  // ==========================================================================

  pub let mut _mbot_stats : [u64; 4] = uninit @align(64)

  pub let MBOT_ST_INVOCATIONS : u64 = 0
  pub let MBOT_ST_PDXFS_BLOCK : u64 = 1
  pub let MBOT_ST_TMPFS       : u64 = 2
  pub let MBOT_ST_MAX         : u64 = 4

  // Leaf stat bumper -- bounded increment, out-of-range no-op.  Mirrors
  // volume_registry_note's shape one-for-one.
  pub let mbot_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M3-004 (#1745): bounded stat-slot increment; out-of-range no-op. Leaf, mirrors volume_registry_note (volume_registry.pdx L160) one-for-one. Labels: single-branch, none needed.",
      block: {
        cmp rdi, 4;
        jae mbot_nt_out;
        lea r10, [rip + _mbot_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      mbot_nt_out:
        ret
      }
    }

  // Leaf stat reader -- bounded read; out-of-range returns 0.  Mirrors
  // volume_registry_stat one-for-one.
  pub let mbot_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M3-004 (#1745): bounded stat-slot read; out-of-range returns 0. Leaf, mirrors volume_registry_stat (volume_registry.pdx L176) one-for-one.",
      block: {
        cmp rdi, 4;
        jae mbot_st_zero;
        lea r10, [rip + _mbot_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      mbot_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // mount_bootstrap() -> u64
  //
  // Install the root filesystem at MOUNT_ROOT_SLOT (0), either as
  // MOUNT_BACKEND_PDXFS_BLOCK (backend_type=5) over a probe-selected
  // volume, or as MOUNT_BACKEND_TMPFS (backend_type=1) as the
  // fallback.
  //
  // Return value (forwarded verbatim from whichever arm ran):
  //   PDXFS_BLOCK arm: mount_pdxfs_block's return -- mount_slot in
  //                    [0..7] on success (MOUNT_ROOT_SLOT=0 on a fresh
  //                    boot with an empty mount_table), 0xFFFF on
  //                    table exhaustion, 0xFFFFED26 on hint mismatch,
  //                    or the appropriate sb_/vol_/jnl_ error code on
  //                    a substrate failure.  See mount_block.pdx §
  //                    mount_pdxfs_block header for the full taxonomy.
  //   TMPFS arm:       mount's return -- slot in [0..7] on success,
  //                    0xFFFF on failure (see mount.pdx §mount).
  //
  // Body per file header:
  //   (1) Bump MBOT_ST_INVOCATIONS.
  //   (2) Single-device disambiguation scan (equivalent selection
  //       primitive per file header sibling-coordination note on
  //       #1744): initialize r12 = MBOT_VOLIDX_NONE, r13 = 0, rbx = 0.
  //       Loop rbx=0..VOL_MAX; call volume_tail_valid(rbx); on live
  //       (rax != 0) update r12 = rbx and bump r13.  Exits with r13
  //       = live-row count and r12 = the most recent live vol_idx.
  //   (3) Selection gate: exactly-one-live gates the PDXFS_BLOCK arm;
  //       zero or multiple gates the TMPFS fallback.
  //   (4) PDXFS_BLOCK arm: rdi=r12; call volume_row_device_slot; if
  //       VOL_DECODE_BAD (dead row raced with scan -- defensive; the
  //       row was live at scan time, but a concurrent umount could
  //       have cleared it), fall through to the TMPFS arm rather than
  //       returning an ED-band error, matching §4.4's own "fall back
  //       to tmpfs on ambiguity" posture (a dead-row race is a form of
  //       ambiguity -- the volume the scan named is gone).  Else rsi
  //       = bdev_cap; rdi = MBOT_ROOT_VOLUME_CAP_SLOT; rdx = rcx = 0
  //       (no uuid hint -- we selected on live-row uniqueness alone,
  //       so a mount_pdxfs_block hint check would be a tautology);
  //       call mount_pdxfs_block; bump MBOT_ST_PDXFS_BLOCK; forward
  //       verbatim.
  //   (5) TMPFS arm: rdi = &_mbot_root_path ("/\0"); rsi = 1 (MOUNT_
  //       BACKEND_TMPFS); call mount; bump MBOT_ST_TMPFS; forward
  //       verbatim.
  //
  // Effects/capabilities widen to the widest nested call (mount_
  // pdxfs_block: !{mem, sysreg} @{cap} on the PDXFS_BLOCK arm;
  // mount: !{mem} on the TMPFS arm).  The union {mem, sysreg} @{cap}
  // covers both.
  // ==========================================================================
  pub let mount_bootstrap : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R53.M3-004 (#1745): root filesystem installation seam.  Branches on the equivalent selection primitive (single-device disambiguation over the volume registry) between MOUNT_BACKEND_PDXFS_BLOCK (via mount_pdxfs_block, mount_block.pdx #1707) and MOUNT_BACKEND_TMPFS (via mount with backend_type=1, mount.pdx #574).  3-push callee-save prologue (rbx=scan idx, r12=selected vol_idx (MBOT_VOLIDX_NONE=0xFFFF sentinel until match), r13=live count) lands rsp%16==0 for every nested call (SysV-entry rsp%16==8 + 24 = 32, %16==0 -- odd-count, no pad), mirroring volume_registry_find's own 3-push shape one-for-one.  Body per file header numbered scope note: (1) mbot_note(MBOT_ST_INVOCATIONS=0).  (2) Initialize r12 = 0xFFFF (MBOT_VOLIDX_NONE), r13 = 0 (live count), rbx = 0 (scan idx).  Scan loop mbot_scan_top: cmp rbx, 16 (VOL_MAX); jae mbot_scan_done.  rdi = rbx; call volume_tail_valid (kind_volume.pdx #1703, leaf -- 1 iff row_id < VOL_MAX and in_use byte set); cmp rax, 0; je mbot_scan_next (dead row, skip).  r12 = rbx; add r13, 1 (bump live count).  mbot_scan_next: add rbx, 1; jmp mbot_scan_top.  (3) mbot_scan_done: cmp r13, 1; jne mbot_fallback (zero or multiple live rows both take the tmpfs fallback per §4.4's own 'ambiguous' fallthrough).  (4) PDXFS_BLOCK arm: rdi = r12; call volume_row_device_slot (kind_volume.pdx #1703); mov r10, 0xFFFFFFFFFFFFFFFF (VOL_DECODE_BAD sentinel, staged via r10 per bit-63-set-imm discipline matching umount_block.pdx's own vol_rds_bad comparison one-for-one); cmp rax, r10; je mbot_fallback (dead-row race, defensive fall-through to tmpfs -- the row was live at scan time but a concurrent umount could have cleared it; §4.4's own 'fall back on ambiguity' posture covers this case since a dead-row race IS a form of ambiguity).  mov rsi, rax (bdev_cap); mov rdi, 176 (MBOT_ROOT_VOLUME_CAP_SLOT; see file header §Cap-slot assignment); xor rdx, rdx (uuid_hint_lo = 0 -- no hint, we selected on live-row uniqueness alone); xor rcx, rcx (uuid_hint_hi = 0); call mount_pdxfs_block; mov rdi, 1 (MBOT_ST_PDXFS_BLOCK); call mbot_note; jmp mbot_done (rax already holds mount_pdxfs_block's return, forwarded verbatim).  Note: r13 is preserved across mount_pdxfs_block's nested calls (callee-save under SysV) and mbot_note's leaf call (mbot_note touches no callee-save), so we may bump the stat via mbot_note after mount_pdxfs_block without spilling rax; rax is caller-save under SysV, so mbot_note's own instructions could smash it -- we spill mount_pdxfs_block's rax return through r13 (dead after the scan, safe to reuse) across the mbot_note call.  Same discipline in the TMPFS arm.  (5) mbot_fallback: R53.M5-004 (#1757) fingerprint hook first -- rdi=3 (LEVEL_INFO), lea rsi,[rip+SUBSYS_BOOT], lea rdx,[rip+pdxb_root_fallback_tmpfs_msg], call klog_s1; emit BEFORE mount() so the fingerprint names the CHOICE (tmpfs fallback path taken) rather than the outcome, and no rax spill is needed since rax is not yet live at this point (the mount() below is what makes it live).  Then: lea rdi, [rip + _mbot_root_path] (\"/\\0\"); mov rsi, 1 (MOUNT_BACKEND_TMPFS); call mount (mount.pdx #574 -- rax = slot [0..7] or 0xFFFF); mov r13, rax (spill across the mbot_note call); mov rdi, 2 (MBOT_ST_TMPFS); call mbot_note; mov rax, r13.  mbot_done: 3-pop epilogue (r13, r12, rbx) + ret.  No test instruction; no mov_b (all whole-qword access).  Reserved labels: mbs_ -- grep audit 2026-08-23: no mbs_ hits anywhere else in src/kernel/.",
      block: {
        // ---- Prologue ----
        push rbx;
        push r12;
        push r13;

        // ---- (1) Bump invocation count ----
        xor rdi, rdi;                            // MBOT_ST_INVOCATIONS
        call mbot_note;

        // ---- (2) Single-device disambiguation scan over the volume registry ----
        mov r12, 0xFFFF;                         // MBOT_VOLIDX_NONE
        xor r13, r13;                            // live count = 0
        xor rbx, rbx;                            // scan idx = 0

      mbot_scan_top:
        cmp rbx, 16;                             // VOL_MAX
        jae mbot_scan_done;
        mov rdi, rbx;
        call volume_tail_valid;                  // rax = 1 iff row live
        cmp rax, 0;
        je  mbot_scan_next;
        mov r12, rbx;                            // remember most-recent live vol_idx
        add r13, 1;                              // bump live count

      mbot_scan_next:
        add rbx, 1;
        jmp mbot_scan_top;

      mbot_scan_done:
        // ---- (3) Selection gate: exactly-one-live? ----
        cmp r13, 1;
        jne mbot_fallback;                        // 0 or >=2 live rows -> tmpfs

        // ---- (4) PDXFS_BLOCK arm ----
        mov rdi, r12;                            // vol_idx (unique live row)
        call volume_row_device_slot;             // rax = bdev_cap or VOL_DECODE_BAD
        mov r10, 0xFFFFFFFFFFFFFFFF;             // VOL_DECODE_BAD (bit-63 imm staged via r10)
        cmp rax, r10;
        je  mbot_fallback;                        // dead-row race -> tmpfs

        mov rsi, rax;                            // bdev_cap (2nd arg)
        mov rdi, 176;                            // MBOT_ROOT_VOLUME_CAP_SLOT (1st arg)
        xor rdx, rdx;                            // uuid_hint_lo = 0 (3rd arg)
        xor rcx, rcx;                            // uuid_hint_hi = 0 (4th arg)
        call mount_pdxfs_block;                  // rax = mount_slot or error
        mov r13, rax;                            // spill rax across mbot_note
        mov rdi, 1;                              // MBOT_ST_PDXFS_BLOCK
        call mbot_note;
        mov rax, r13;                            // restore return value
        jmp mbot_done;

      mbot_fallback:
        // ---- (5) TMPFS fallback arm (preserves --no-disk behavior) ----
        //
        // R53.M5-004 (#1757) fingerprint hook: emit 'PDXB ROOT FALLBACK
        // TMPFS' via klog_s1 BEFORE the mount() call.  The fingerprint
        // names the CHOICE (tmpfs fallback path taken) rather than the
        // outcome, so it fires regardless of whether the nested mount()
        // succeeds; the mount() rax value is still forwarded verbatim
        // through r13 as the return value.  No register spill needed
        // across klog_s1 here (rax is not yet live -- it will hold
        // mount()'s return only after the call below), matching root_
        // select.pdx's own rsel_fallback discipline one-for-one.
        // Output-strip-clean per design/policy/output-provenance-
        // strip.md.
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxb_root_fallback_tmpfs_msg];
        call klog_s1;

        lea rdi, [rip + _mbot_root_path];         // path_ptr = "/\0"
        mov rsi, 1;                              // MOUNT_BACKEND_TMPFS
        call mount;                              // rax = slot [0..7] or 0xFFFF
        mov r13, rax;                            // spill rax across mbot_note
        mov rdi, 2;                              // MBOT_ST_TMPFS
        call mbot_note;
        mov rax, r13;                            // restore return value

      mbot_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
