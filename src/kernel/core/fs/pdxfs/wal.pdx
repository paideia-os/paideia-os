// src/kernel/core/fs/pdxfs/wal.pdx -- R42.M2-001 (#1384)
// R55.M2-003 (#1785): wal_append_write + wal_fsync_bdev real body over
// bdev_write_at (#1784) + jnl_crc32c_range (journal_ondisk.pdx, #1704).
//
// PDXFS v1 JOURNAL -- WRITE-AHEAD LOG (RING BUFFER OF TX RECORDS).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on the WRITE-AHEAD invariant: every logical block
// write against a PdxFS volume MUST be preceded by an in-log record that
// names the transaction (seq), sizes its payload, links to the previous
// transaction (prev_seq), carries a checksum for tear detection, and is
// fsync'd to durable storage before the corresponding block-write is
// permitted to leave the module.
//
// It is the RING BUFFER the three sibling journal modules read:
//
//   journal_fence.pdx  -- reads (seq, head) to determine which records
//                          may participate in a commit fence.
//   journal_replay.pdx -- walks records from a checkpoint on mount and
//                          re-applies each one the fence table names.
//   journal_csum.pdx   -- recomputes the per-record checksum stored
//                          here to detect torn writes on replay.
//
// It is a SCAFFOLD (D7). The ring lives in a single BSS-backed region
// -- a real WAL is a preallocated on-disk extent the NVMe write path
// (#906) fsyncs synchronously. The scaffold's semantic (append-then-
// fsync-then-block-write, with an INVARIANT refusal if the caller
// tries to write a block ahead of the fsync watermark) is the semantic
// the on-disk widening preserves.
//
// It does NOT commit transactions. journal_fence.pdx is the sole
// authority on commit records; a WAL record is durable but a
// transaction is not committed until the fence writes its marker.
//
// It does NOT verify checksums. journal_csum.pdx recomputes and
// compares; this module only STORES the value each append hands it.
// The formula (seq XOR size XOR prev_seq) is a placeholder the csum
// widening replaces with CRC32C.
//
// It does NOT replay records. journal_replay.pdx walks the ring at
// mount time; this module owns the ring geometry and provides the
// per-record accessors the walker consumes.
//
// =============================================================================
// §1  RING GEOMETRY
// =============================================================================
//
// WAL_MAX_RECORDS      = 64        ring capacity (scaffold).
// WAL_RECORD_WORDS     = 5         per-record footprint in u64s.
//
// _wal_ring is a flat array of WAL_MAX_RECORDS * WAL_RECORD_WORDS u64s
// (2.5 KiB). Entry(i) starts at _wal_ring[i * 5]:
//
//   +0    seq          transaction sequence number (>= 1)
//   +8    size         payload size in bytes (>= 1)
//   +16   checksum     as supplied by the appender
//   +24   prev_seq     seq of the immediately preceding record (0 = none)
//   +32   flags        bit 0 = fsynced, bit 1 = block_written
//
// head is the next-write index (also the current record count until we
// wrap). The scaffold refuses to wrap; a widening replaces the refusal
// with a checkpoint-driven overwrite.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _wal_ring and _wal_state are written only by helpers in this module.
// tools/build.sh confines relocations against each to `core/fs/pdxfs/
// wal.o`. A second writer would let a caller "record a tx without
// running the append gate", which would let the block-write path bypass
// the write-ahead invariant with no symptom until a crash exposed the
// missing record.
//
// STATE LAYOUT -- _wal_state : [u64; 8]
//   +0    init_mark          0xEA10 once wal_reset has run
//   +8    err                sticky error latch (first-writer-wins)
//   +16   head               next-write index into the ring (also count)
//   +24   next_seq           next sequence id wal_append will hand out
//   +32   fsync_high_water   head at time of the last wal_fsync call
//   +40   append_count       total wal_append calls that succeeded
//   +48   fsync_count        total wal_fsync calls
//   +56   block_write_count  total wal_block_write calls that succeeded
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEFC0..0xFFFFEFCF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: cow_gc 0xFFFFEFD0..DF (R42.M1-004). Adjacent free band below:
// journal_fence 0xFFFFEFB0..BF (R42.M2-002).
//
//   WAL_OK              = 0
//   WAL_ERR_NOT_INIT    = 0xFFFFEFCF   accessor before wal_reset
//   WAL_ERR_RING_FULL   = 0xFFFFEFCE   append when head == WAL_MAX
//   WAL_ERR_BAD_IDX     = 0xFFFFEFCD   accessor: idx >= head
//   WAL_ERR_INVARIANT   = 0xFFFFEFCC   block_write before matching fsync
//   WAL_ERR_BAD_SIZE    = 0xFFFFEFCB   append with size == 0
//   WAL_ERR_INTERNAL    = 0xFFFFEFCA   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `wal_`.

module Wal = structure {

  pub let WAL_MAX_RECORDS     : u64 = 64
  pub let WAL_RECORD_WORDS    : u64 = 5

  pub let WAL_OK              : u64 = 0
  pub let WAL_ERR_NOT_INIT    : u64 = 0xFFFFEFCF
  pub let WAL_ERR_RING_FULL   : u64 = 0xFFFFEFCE
  pub let WAL_ERR_BAD_IDX     : u64 = 0xFFFFEFCD
  pub let WAL_ERR_INVARIANT   : u64 = 0xFFFFEFCC
  pub let WAL_ERR_BAD_SIZE    : u64 = 0xFFFFEFCB
  pub let WAL_ERR_INTERNAL    : u64 = 0xFFFFEFCA

  // R90-XREPO.010.M1-005 (paideia-os #2113): sticky latch value when
  // pdxfs_fault_check_and_consume(FAULT_CLASS_WAL_WRITE_FAIL) fires
  // inside wal_append.  Distinct from every existing WAL_ERR_* slot
  // so a post-mortem debugger can distinguish a fault-injected failure
  // from a real substrate refusal.  A caller cannot arm this state
  // outside of test builds (see design/kernel/pdxfs-fault-inject.md
  // §3 for the boot-flag gate).
  pub let WAL_ERR_INJECTED    : u64 = 0xFFFFEFC9

  pub let WAL_INIT_MARK       : u64 = 0xEA10

  pub let mut _wal_ring  : [u64; 320] = uninit @align(64)
  pub let mut _wal_state : [u64; 8]   = uninit @align(64)

  // ==========================================================================
  // R55.M2-003 (#1785): bdev-backed WAL scratch page + per-vol_row state.
  //
  // A DIFFERENT SUBSTRATE from the R42.M2 in-memory ring (_wal_ring /
  // _wal_state) above --- the R42 ring is a per-append-slot scaffold
  // whose txs never reach the device; this bdev-backed pair carries
  // real WAL records into `_wal_scratch` (one 4-KiB block) and flushes
  // via `bdev_write_at` (bdev_write.pdx, R55.M2-002 / #1784). The two
  // substrates coexist: the R42 in-memory ring stays behind existing
  // wal_append / wal_fsync (arity 0/2) callers that predate the
  // block-write path, while the R55.M2 pair adds `wal_append_write` and
  // `wal_fsync_bdev` for the pdxfs_block_write barrier described in
  // bdev_write.pdx §0 ("wal.pdx is the authority on write-ahead
  // ordering; a caller that submits a block write here before the
  // corresponding record is fsynced through wal_fsync is a caller that
  // will (once the driver is real) tear on a crash. That invariant is
  // enforced at THE CALL SITE (cow_write's write pass) rather than
  // duplicated here"). §Cache / CoW-write callers pick which substrate
  // they use; today's landing wires no caller, matching the same "add
  // the primitive, leave the caller migration to its own issue" posture
  // R55.M2-002 / #1784 used for `bdev_write_at`.
  //
  // WAL record layout --- 64 bytes = 8 qwords, so a 4-KiB block holds
  // exactly 64 records with no page header for the bdev-backed layer
  // (deliberately simpler than journal_ondisk.pdx's 4-KiB JBNL block
  // with its 32-B header + 8-B CSUM footer, since the bdev-backed WAL
  // records only DESCRIBE upcoming data-block writes; the payload
  // itself lives at `payload_pa` and is written by the caller's later
  // bdev_write_at through the pdxfs_block_write path, not embedded in
  // the WAL record --- which is exactly journal_ondisk.pdx's own
  // header gap 1 recommendation (c) for JOP_BLOCK_WRITE):
  //
  //   +0   magic         u64  0x00014C4157584450 -- reads forward on disk as
  //                            bytes 50 44 58 57 41 4C 01 00 = "PDXWAL\x01\x00"
  //                            (matches superblock_fmt.pdx's PDXB_SB_MAGIC
  //                            convention: LE storage reads forward as ASCII
  //                            tag + version).
  //   +8   txn_id        u64  monotonic, per-vol_row (bumped per append)
  //   +16  lba           u64  target LBA the upcoming data-block write hits
  //   +24  len           u64  payload length in bytes (>= 1)
  //   +32  payload_pa    u64  source page physical address (reference; the
  //                             page itself is NOT copied into the WAL block)
  //   +40  record_type   u64  1 = block_write (only type today)
  //   +48  csum          u64  CRC32C over bytes [+0, +48) (7 qwords),
  //                             seeded 0xFFFFFFFF, standard final-XOR
  //                             0xFFFFFFFF (jnl_crc32c_range from
  //                             journal_ondisk.pdx, R42.M5 substrate's
  //                             REAL CRC32C, not journal_csum.pdx's XOR-
  //                             mix placeholder --- see journal_csum.pdx
  //                             §0 for why the placeholder is a
  //                             deliberate stand-in for CRC32C in a real
  //                             widening, and journal_ondisk.pdx §gap 4
  //                             for the real implementation this landing
  //                             consumes)
  //   +56  reserved      u64  0
  //
  // Per-vol_row state --- 16 rows x 64 B (matches KIND_VOLUME's 16-row
  // ceiling, R52.M5-001; matches journal_ondisk.pdx's
  // _journal_vol_state stride one-for-one). vol_row is the row_id
  // (0..15) from `volume_row_of_slot`; NOT a raw row pointer, since
  // KIND_VOLUME rows (kind_volume.pdx §1) do NOT carry wal_head_lba /
  // wal_tail_lba / wal_bcount fields --- those live here, indexed by
  // vol_row, per the ticket's own "use module-scoped state" fallback
  // when the vol_row layout does not have the fields:
  //
  //   [+0]   head_lba          absolute LBA the next flush targets
  //                              (0 = unset --- first-touch seeds to
  //                              WAL_BDEV_BASE_LBA = 0x40)
  //   [+8]   reserved          (wal_tail_lba placeholder --- unused
  //                              until wraparound lands)
  //   [+16]  rcount            records currently buffered in
  //                              _wal_scratch (0..64)
  //   [+24]  next_txn_id       monotonic txn id handed out by the next
  //                              wal_append_write
  //   [+32]  flush_count       total wal_fsync_bdev calls that reached
  //                              the bdev_write_at gate (bump-on-attempt
  //                              matches nvw_batch_flush's own precedent)
  //   [+40]  append_count      total wal_append_write calls that succeeded
  //   [+48]  reserved          0
  //   [+56]  reserved          0
  //
  // First-touch seeds head_lba = 0x40 (WAL_BDEV_BASE_LBA) as a scaffold
  // constant. A widening will read the per-volume WAL region base from
  // the superblock (sb_journal_lba, R52.M5) once callers thread the
  // superblock pointer through; today no caller yet exists (this
  // landing adds only the primitives, matching the R55.M2-002 posture
  // of "primitive without wired caller"), so the constant is the
  // simplest defensible scaffold value and matches the golden
  // fingerprint's `lba=0x0000000000000040` verbatim.
  //
  // No wraparound: head_lba advances monotonically after each successful
  // flush. Scaffold assumption; a widening replaces this with a real
  // ring geometry against sb_journal_bcount. Refusal on wraparound is
  // deferred to the widening (the bdev_write_at target LBA space is
  // effectively unbounded at the scaffold layer).
  //
  // Single-writer discipline: `_wal_scratch` and `_wal_bdev_state` are
  // written only by wal_append_write + wal_fsync_bdev in THIS module;
  // tools/build.sh confines relocations against each to `core/fs/
  // pdxfs/wal.o` (matches R42's own _wal_ring / _wal_state confinement
  // one-for-one). A second writer would let a caller "record a write
  // to the WAL then re-stamp its own alternate record over the same
  // slot", which would defeat the write-ahead invariant this module
  // owns for the pdxfs_block_write path.
  // ==========================================================================

  pub let WAL_BDEV_BASE_LBA        : u64 = 0x40
  pub let WAL_BDEV_REC_BYTES       : u64 = 64
  pub let WAL_BDEV_RECS_PER_BLOCK  : u64 = 64
  pub let WAL_BDEV_RTYPE_BLOCK_WRITE : u64 = 1
  pub let WAL_BDEV_MAGIC           : u64 = 0x00014C4157584450

  pub let mut _wal_scratch     : [u64; 512] = uninit @align(4096)
  pub let mut _wal_bdev_state  : [u64; 128] = uninit @align(64)

  // ==========================================================================
  // Reset. Clears ring + state; installs init_mark and primes next_seq = 1.
  // ==========================================================================

  pub let wal_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): clear ring + state, install init_mark, prime next_seq. Labels prefixed wal_rst_.",
      block: {
        lea r10, [rip + _wal_ring];
        xor rax, rax;
        xor rcx, rcx;
      wal_rst_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 320;
        jb  wal_rst_r;

        lea r10, [rip + _wal_state];
        xor rcx, rcx;
      wal_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wal_rst_s;

        mov rax, 0xEA10;
        mov [r10 + 0], rax;
        mov rax, 1;
        mov [r10 + 24], rax;                    // next_seq := 1
        ret
      }
    }

  pub let wal_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): 1 iff init_mark matches. Labels prefixed wal_bnd_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_bnd_no;
        mov rax, 1;
        ret;
      wal_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let wal_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): sticky error latch readback.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let wal_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): first-writer-wins error latch. Labels prefixed wal_se_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne wal_se_out;
        mov [r10 + 8], rdi;
      wal_se_out:
        ret
      }
    }

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let wal_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): head field.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let wal_next_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): next_seq field.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let wal_fsync_high_water : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): fsync_high_water field.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let wal_append_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): append_count field.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let wal_fsync_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): fsync_count field.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let wal_block_write_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): block_write_count field.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  // ==========================================================================
  // Per-record accessors. Refuse on:
  //   - not init                    WAL_ERR_NOT_INIT
  //   - idx >= head                 WAL_ERR_BAD_IDX
  // ==========================================================================

  pub let wal_seq_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): read seq of record idx. Labels prefixed wal_sa_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_sa_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae wal_sa_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, rdi;                           // rdi * 5                                // rax = idx * 5
        lea r11, [rip + _wal_ring];
        mov rax, [r11 + rax * 8];               // +0 seq
        ret;

      wal_sa_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;
        ret;
      wal_sa_bi:
        mov rdi, 0xFFFFEFCD;
        call wal_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let wal_size_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): read size of record idx. Labels prefixed wal_za_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_za_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae wal_za_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, rdi;                           // rdi * 5
        add rax, 1;                             // +1 (u64) = +8 bytes = size
        lea r11, [rip + _wal_ring];
        mov rax, [r11 + rax * 8];
        ret;

      wal_za_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;
        ret;
      wal_za_bi:
        mov rdi, 0xFFFFEFCD;
        call wal_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let wal_checksum_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): read checksum of record idx. Labels prefixed wal_ca_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_ca_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae wal_ca_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, rdi;                           // rdi * 5
        add rax, 2;                             // +2 u64
        lea r11, [rip + _wal_ring];
        mov rax, [r11 + rax * 8];
        ret;

      wal_ca_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;
        ret;
      wal_ca_bi:
        mov rdi, 0xFFFFEFCD;
        call wal_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let wal_prev_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): read prev_seq of record idx. Labels prefixed wal_pa_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_pa_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae wal_pa_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, rdi;                           // rdi * 5
        add rax, 3;                             // +3 u64
        lea r11, [rip + _wal_ring];
        mov rax, [r11 + rax * 8];
        ret;

      wal_pa_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;
        ret;
      wal_pa_bi:
        mov rdi, 0xFFFFEFCD;
        call wal_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let wal_flags_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): read flags of record idx. Labels prefixed wal_fa_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_fa_ni;
        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae wal_fa_bi;

        mov rax, rdi;
        shl rax, 2;
        add rax, rdi;                           // rdi * 5
        add rax, 4;                             // +4 u64
        lea r11, [rip + _wal_ring];
        mov rax, [r11 + rax * 8];
        ret;

      wal_fa_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;
        ret;
      wal_fa_bi:
        mov rdi, 0xFFFFEFCD;
        call wal_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // wal_append(size, prev_seq) -> u64
  //
  // Append one record to the ring. Assigns a fresh seq (next_seq++),
  // records size + prev_seq, seeds a placeholder checksum
  // (seq XOR size XOR prev_seq -- csum widening rewrites), zero flags.
  // Returns the assigned seq id on success.
  //
  // Refuses:
  //   - not init                    WAL_ERR_NOT_INIT
  //   - size == 0                   WAL_ERR_BAD_SIZE
  //   - head == WAL_MAX_RECORDS     WAL_ERR_RING_FULL
  // ==========================================================================

  pub let wal_append : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (size: u64, prev_seq: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R42.M2-001 (#1384) + R90-XREPO.010.M1-005 (#2113) fault-inject hook: append tx record. Fault-inject hook at prologue top: 4-push prologue leaves rsp%16 == 8 (entry %8 + 4 pushes; parity unchanged since 4*8 mod 16 == 0), so `sub rsp, 8` aligns %16 == 0 for the nested pdxfs_fault_check_and_consume call; on injection we jump to wal_ap_inject (a new sentinel path that latches WAL_ERR_INJECTED via wal_set_err and returns 0 per wal_append's `0 = failure` contract). Effects widened from {mem} to {mem, sysreg} because pdxfs_fault_check_and_consume's klog_s1_d1 emit reads the TSC. Non-injection path unchanged. Labels prefixed wal_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        // ==== R90-XREPO.010.M1-005 (#2113) fault-inject hook ====
        // FAULT_CLASS_WAL_WRITE_FAIL == 1.  Alignment: 4 pushes from
        // entry rsp%16 == 8 lands at %16 == 8; `sub rsp, 8` aligns to
        // %16 == 0 for the nested call; `add rsp, 8` restores.  On
        // injection we latch WAL_ERR_INJECTED (0xFFFFEFC9, unused
        // wal.pdx errno slot) and return 0.
        sub rsp, 8;
        mov rdi, 1;                             // FAULT_CLASS_WAL_WRITE_FAIL
        call pdxfs_fault_check_and_consume;
        add rsp, 8;
        cmp rax, 0;
        jne wal_ap_inject;

        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_ap_ni;

        cmp rdi, 0;
        je  wal_ap_bs;

        mov rbx, [r10 + 16];                    // head
        mov r11, 64;                            // WAL_MAX_RECORDS
        cmp rbx, r11;
        jae wal_ap_full;

        mov r12, [r10 + 24];                    // next_seq

        // r13 = idx * 5 (u64 offset base for entry)
        mov rax, rbx;
        shl rax, 2;
        add rax, rbx;                           // rbx * 5
        mov r13, rax;

        // Compute checksum = seq XOR size XOR prev_seq.
        mov r14, r12;
        xor r14, rdi;                           // ^ size
        xor r14, rsi;                           // ^ prev_seq

        lea r11, [rip + _wal_ring];
        mov [r11 + r13 * 8], r12;               // +0 seq
        add r13, 1;
        mov [r11 + r13 * 8], rdi;               // +8 size
        add r13, 1;
        mov [r11 + r13 * 8], r14;               // +16 checksum
        add r13, 1;
        mov [r11 + r13 * 8], rsi;               // +24 prev_seq
        add r13, 1;
        xor rax, rax;
        mov [r11 + r13 * 8], rax;               // +32 flags = 0

        // head++, next_seq++, append_count++.
        add rbx, 1;
        mov [r10 + 16], rbx;
        add r12, 1;
        mov [r10 + 24], r12;
        mov r9, [r10 + 40];
        add r9, 1;
        mov [r10 + 40], r9;

        // Return the seq id we just used (r12 - 1).
        mov rax, r12;
        sub rax, 1;
        jmp wal_ap_out;

      wal_ap_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;
        jmp wal_ap_out;
      wal_ap_bs:
        mov rdi, 0xFFFFEFCB;
        call wal_set_err;
        xor rax, rax;
        jmp wal_ap_out;
      wal_ap_full:
        mov rdi, 0xFFFFEFCE;
        call wal_set_err;
        xor rax, rax;
        jmp wal_ap_out;

      wal_ap_inject:
        // R90-XREPO.010.M1-005 (#2113) fault-inject synthetic failure
        // -- latch WAL_ERR_INJECTED (0xFFFFEFC9, distinct from every
        // existing wal.pdx errno slot) and return 0 per wal_append's
        // "0 = failure" contract.  A caller observing this branch sees
        // an equivalent-to-EIO failure without a real disk fault; the
        // witness at src/kernel/boot/witness/r90_xrepo_010_005_pdxfs_
        // fault_inject.pdx uses the check_and_consume return code
        // directly rather than reading wal_err(), so the latch here is
        // for observability by post-mortem debuggers rather than the
        // witness's own assertion path.
        mov rdi, 0xFFFFEFC9;
        call wal_set_err;
        xor rax, rax;

      wal_ap_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // wal_fsync() -> u64
  //
  // Declare every record in [fsync_high_water..head) durable. Marks
  // each such record's flags bit 0 (fsynced). Returns the number of
  // records newly fsynced (0 if none pending).
  //
  // Refuses:
  //   - not init                    WAL_ERR_NOT_INIT
  // ==========================================================================

  pub let wal_fsync : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): fsync ring [hw..head). Labels prefixed wal_fs_.",
      block: {
        push rbx;
        push r12;
        push r13;

        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_fs_ni;

        // fsync_count++
        mov r9, [r10 + 48];
        add r9, 1;
        mov [r10 + 48], r9;

        mov rbx, [r10 + 32];                    // hw
        mov r12, [r10 + 16];                    // head
        xor r13, r13;                           // newly-fsynced
      wal_fs_top:
        cmp rbx, r12;
        jae wal_fs_done;

        // Set bit 0 in flags of record rbx.
        mov rax, rbx;
        shl rax, 2;
        add rax, rbx;                           // rbx * 5
        add rax, 4;
        lea r11, [rip + _wal_ring];
        mov r8, [r11 + rax * 8];
        or  r8, 1;
        mov [r11 + rax * 8], r8;

        add r13, 1;
        add rbx, 1;
        jmp wal_fs_top;

      wal_fs_done:
        lea r10, [rip + _wal_state];
        mov [r10 + 32], r12;                    // hw := head
        mov rax, r13;
        jmp wal_fs_out;

      wal_fs_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;

      wal_fs_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // wal_block_write(idx) -> u64
  //
  // Model a block-write against record idx. Refuses if that record has
  // not been fsynced (write-ahead invariant). Sets flags bit 1
  // (block_written) and bumps block_write_count on success. Returns 1.
  //
  // Refuses:
  //   - not init                    WAL_ERR_NOT_INIT
  //   - idx >= head                 WAL_ERR_BAD_IDX
  //   - record flags bit 0 clear    WAL_ERR_INVARIANT
  // ==========================================================================

  pub let wal_block_write : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-001 (#1384): model a block-write behind write-ahead invariant. Labels prefixed wal_bw_.",
      block: {
        lea r10, [rip + _wal_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA10;
        cmp rax, r11;
        jne wal_bw_ni;

        mov rax, [r10 + 16];                    // head
        cmp rdi, rax;
        jae wal_bw_bi;

        // Compute flags offset = idx * 5 + 4.
        mov rax, rdi;
        shl rax, 2;
        add rax, rdi;                           // rdi * 5
        add rax, 4;
        lea r11, [rip + _wal_ring];
        mov r8, [r11 + rax * 8];
        mov r9, r8;
        and r9, 1;                              // bit 0 = fsynced
        cmp r9, 0;
        je  wal_bw_inv;

        or  r8, 2;                              // bit 1 = block_written
        mov [r11 + rax * 8], r8;

        mov r9, [r10 + 56];
        add r9, 1;
        mov [r10 + 56], r9;                     // block_write_count++
        mov rax, 1;
        ret;

      wal_bw_ni:
        mov rdi, 0xFFFFEFCF;
        call wal_set_err;
        xor rax, rax;
        ret;
      wal_bw_bi:
        mov rdi, 0xFFFFEFCD;
        call wal_set_err;
        xor rax, rax;
        ret;
      wal_bw_inv:
        mov rdi, 0xFFFFEFCC;
        call wal_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // R55.M2-003 (#1785): bdev-backed WAL --- wal_append_write + wal_fsync_bdev
  //
  // See §Bdev-backed WAL storage block above for the record layout, the
  // per-vol_row state layout, the substrate justification, and the
  // single-writer discipline this pair upholds.
  //
  // Failure codes (all reused from the R42 WAL band 0xFFFFEFC0..CF above,
  // per the same "reuse a semantically-adjacent already-frozen code
  // rather than mint a new one" precedent journal_ondisk.pdx §gap 3
  // documents for its own JNL_CSUM_BAD reuses):
  //
  //   WAL_ERR_BAD_SIZE  (0xFFFFEFCB)   bad vol_row (>= 16) OR zero len
  //   WAL_ERR_RING_FULL (0xFFFFEFCE)   _wal_scratch buffer full (rcount
  //                                     == 64)
  //   WAL_ERR_INVARIANT (0xFFFFEFCC)   fsync's bdev_write_at returned
  //                                     non-zero (the invariant "the
  //                                     WAL is durable at wal_fsync
  //                                     completion" broke)
  //
  // Effect row: !{sysreg, mem} @{} --- matches inode_table_write's own
  // R55.M2-002 posture one-for-one (bdev_write_at is !{sysreg,mem} @{};
  // klog_s1_x2 is !{sysreg,mem} @{}). No capability handle is threaded
  // through this pair (vol_row is a small integer indexing module-
  // scoped state, not a cap slot); a widening that grows a bdev_cap
  // arg picks up @{cap} at that point.
  //
  // The append side is SILENT on the wire (no fingerprint emit); only
  // wal_fsync_bdev emits, and only on success with records-flushed > 0.
  // Matches R55.M2-001 alloc_extent_run's own "emit-on-success-only"
  // posture rather than the NVMe SQ scaffold's per-doorbell emit.
  // ==========================================================================

  // wal_append_write(vol_row, lba, len, payload_pa) -> u64
  //
  //   Append one 64-B WAL record describing an upcoming data-block
  //   write into `_wal_scratch` at slot `rcount`. Csum via
  //   jnl_crc32c_range (journal_ondisk.pdx). Bumps rcount + next_txn_id
  //   + append_count on success. Seeds head_lba to WAL_BDEV_BASE_LBA on
  //   first touch of a fresh vol_row.
  //
  //   Returns 0 (WAL_OK) on success, else WAL_ERR_BAD_SIZE (bad
  //   vol_row or zero len) / WAL_ERR_RING_FULL (buffer full).
  pub let wal_append_write : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vol_row: u64) (lba: u64) (len: u64) (payload_pa: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R55.M2-003 (#1785). See §Bdev-backed WAL storage above + design/filesystem/pdxfs-block-write-e2e.md §WAL for the full plan; short form: pack one 64-B record into _wal_scratch at slot=rcount, checksum it via jnl_crc32c_range (journal_ondisk.pdx's real CRC32C substrate, R52.M5 --- NOT journal_csum.pdx's XOR-mix placeholder, which operates on WAL HEADER FIELDS not a byte range). 2-push callee-save prologue (rbx=row_base ptr; r12=rec_ptr) + sub rsp,8 lands rsp%16==0 (entry rsp%16==8 + 16 + 8 = 32) for the single nested jnl_crc32c_range call. Body: (1) Bound-check vol_row<16 (via r10=16 stage per bit-63-set-imm discipline unneeded --- 16 fits in imm8, direct cmp) and len!=0 else wal_apw_bad (WAL_ERR_BAD_SIZE reused). (2) row_base = &_wal_bdev_state + vol_row*64 (shl 6) into rbx. (3) rcount = [rbx+16]; cmp rcount,64; jae wal_apw_full (WAL_ERR_RING_FULL). (4) First-touch head_lba seed: if [rbx+0]==0, store WAL_BDEV_BASE_LBA (0x40) into [rbx+0]. (5) rec_ptr = &_wal_scratch + rcount*64 into r12. (6) Store record fields: magic (imm64 via r10; 0x00014C4157584450), txn_id ([rbx+24]), lba (rsi verbatim from arg), len (rdx verbatim), payload_pa (rcx verbatim), record_type (1 = WAL_BDEV_RTYPE_BLOCK_WRITE), zero csum + reserved (bytes [+48, +64)). rsi/rdx/rcx are stored BEFORE the jnl_crc32c_range call (which clobbers them as caller-save); no spill is needed. (7) Compute csum: jnl_crc32c_range(r12, 48, 0xFFFFFFFF), then XOR rax with 0xFFFFFFFF (standard CRC32C final-XOR, staged via r10 per bit-set-imm discipline for parity even though 0xFFFFFFFF fits in imm32 zero-extended). Store rax at [r12+48]. rbx and r12 survive the call (SysV callee-save; jnl_crc32c_range's module header explicitly states 'caller-save only, no push needed', which means it TOUCHES only caller-save regs and therefore PRESERVES rbx/rbp/r12..r15 by construction). (8) Bump rcount, next_txn_id, append_count. (9) xor eax,eax; jmp wal_apw_out. wal_apw_bad / wal_apw_full set rax to the reused WAL_ERR_* code. Alignment: 2 pushes + sub 8 = 24; entry rsp%16==8 + 24 = 32, %16==0. No test instruction; no mov_b. Reserved labels: wal_apw_ (distinct from R42's wal_ap_ append, wal_bw_ block_write, wal_fs_ fsync).",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        // Bounds.
        mov r10, 16;
        cmp rdi, r10;
        jae wal_apw_bad;
        cmp rdx, 0;
        je  wal_apw_bad;

        // row_base = &_wal_bdev_state + vol_row * 64.
        mov r10, rdi;
        shl r10, 6;
        lea rbx, [rip + _wal_bdev_state];
        add rbx, r10;

        // rcount check.
        mov rax, [rbx + 16];
        mov r10, 64;
        cmp rax, r10;
        jae wal_apw_full;

        // First-touch head_lba seed.
        mov r9, [rbx + 0];
        cmp r9, 0;
        jne wal_apw_have_head;
        mov r9, 0x40;
        mov [rbx + 0], r9;

      wal_apw_have_head:
        // rec_ptr = &_wal_scratch + rcount * 64.
        mov r11, rax;
        shl r11, 6;
        lea r12, [rip + _wal_scratch];
        add r12, r11;

        // Store fields (rsi=lba, rdx=len, rcx=payload_pa, plus per-row txn_id).
        mov r10, 0x00014C4157584450;
        mov [r12 + 0], r10;
        mov r10, [rbx + 24];
        mov [r12 + 8], r10;
        mov [r12 + 16], rsi;
        mov [r12 + 24], rdx;
        mov [r12 + 32], rcx;
        mov r10, 1;
        mov [r12 + 40], r10;
        xor r10, r10;
        mov [r12 + 48], r10;
        mov [r12 + 56], r10;

        // Csum = jnl_crc32c_range(rec_ptr, 48, 0xFFFFFFFF) XOR 0xFFFFFFFF.
        mov rdi, r12;
        mov rsi, 48;
        mov rdx, 0xFFFFFFFF;
        call jnl_crc32c_range;
        mov r10, 0xFFFFFFFF;
        xor rax, r10;
        mov [r12 + 48], rax;

        // Bump rcount, next_txn_id, append_count.
        mov rax, [rbx + 16];
        add rax, 1;
        mov [rbx + 16], rax;
        mov rax, [rbx + 24];
        add rax, 1;
        mov [rbx + 24], rax;
        mov rax, [rbx + 40];
        add rax, 1;
        mov [rbx + 40], rax;

        xor rax, rax;
        jmp wal_apw_out;

      wal_apw_bad:
        mov rax, 0xFFFFEFCB;
        jmp wal_apw_out;

      wal_apw_full:
        mov rax, 0xFFFFEFCE;

      wal_apw_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // wal_fsync_bdev(vol_row) -> u64
  //
  //   Flush _wal_scratch (rcount records at head_lba) via bdev_write_at
  //   (nsid=1, head_lba, count=1, &_wal_scratch). On success: resets
  //   rcount=0, advances head_lba by 1, emits fingerprint via
  //   klog_s1_x2 (records + lba). No-op-with-success return when
  //   rcount==0 (no records to flush; no wire event).
  //
  //   Named `wal_fsync_bdev` rather than the ticket's bare `wal_fsync`
  //   because the R42 `wal_fsync : () -> u64` (line 562 above) already
  //   exists for the in-memory scaffold ring and paideia-as has no
  //   function-overloading; keeping both semantics distinguishable by
  //   name lets both substrates coexist during the caller migration
  //   window this landing does not close.
  //
  //   Returns 0 (WAL_OK) on success or on rcount==0 no-op, else
  //   WAL_ERR_BAD_SIZE (bad vol_row) / WAL_ERR_INVARIANT (bdev_write_at
  //   returned non-zero).
  pub let wal_fsync_bdev : (u64) -> u64 !{sysreg, mem} @{} =
    fn (vol_row: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R55.M2-003 (#1785). See §Bdev-backed WAL storage above + design/filesystem/pdxfs-block-write-e2e.md §WAL for the full plan; short form: flush _wal_scratch via bdev_write_at (bdev_write.pdx #1784) and emit klog_s1_x2 fingerprint on success. 4-push callee-save prologue (rbx=vol_row, rbp=row_base ptr, r12=rcount, r13=head_lba) + sub rsp,8 lands rsp%16==0 (entry rsp%16==8 + 32 + 8 = 48) for every nested call (bdev_write_at, klog_s1_x2). Body: (1) rbx=vol_row(rdi); bound-check <16 else wal_fs_bdev_bad (WAL_ERR_BAD_SIZE reused, matching wal_append_write). (2) rbp = row_base = &_wal_bdev_state + vol_row*64 (shl 6). (3) r12 = rcount = [rbp+16]; cmp 0; je wal_fs_bdev_nop (no records --- silent success, matches nvw_batch_flush's own zero-move silence). (4) r13 = head_lba = [rbp+0]. (5) flush_count++ ([rbp+32]) --- bump-on-attempt like nvw_batch_flush's flush_count (a caller polling flush_count sees every doorbell attempt regardless of I/O outcome). (6) bdev_write_at(nsid=1, head_lba=r13, count=1, buf_pa=&_wal_scratch): rdi=1, rsi=r13, rdx=1, lea rcx,[rip+_wal_scratch]; call. cmp rax,0; jne wal_fs_bdev_io_err. bdev_write_at preserves rbx/rbp/r12/r13 per SysV. Substrate branch (no live NVMe IO SQ pair, every QEMU-TCG -kernel boot today) is handled INSIDE bdev_write_at itself, which returns 0 without calling the driver --- so the fingerprint fires cleanly on substrate hardware too, exactly the behavior the R55.M2-002 inode_table_write precedent established. (7) Reset rcount=0 at [rbp+16] (do not touch head_lba yet --- fingerprint below wants the LBA that just landed, i.e. the pre-increment r13). (8) klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS__, tag_pdxb_wal_fsynced_ok, k_records, r12, k_lba, r13). v2 (lba) push convention: `sub rsp, 8; push r13; call klog_s1_x2; add rsp, 16` (rsp already at %16==0 from prologue sub 8, so sub 8 + push = +16, aligned pre-call; add 16 undoes both). Matches inode_table_write's own v2 push idiom one-for-one. (9) Advance head_lba: add r13,1; [rbp+0]=r13. (10) xor eax,eax; jmp wal_fs_bdev_out. Failure paths: wal_fs_bdev_bad (bad vol_row) returns WAL_ERR_BAD_SIZE; wal_fs_bdev_nop returns 0 (silent success); wal_fs_bdev_io_err returns WAL_ERR_INVARIANT (the WAL-durable invariant broke --- rcount is NOT reset, so a subsequent wal_fsync_bdev call will retry the same block; matches nvw_batch_flush's LIVE-path 'leaves PENDING on failure' retry semantic). No test instruction; no mov_b. Reserved labels: wal_fs_bdev_ (distinct from R42's wal_fs_ in-memory fsync above).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub  rsp, 8;

        mov rbx, rdi;

        // Bounds.
        mov r10, 16;
        cmp rbx, r10;
        jae wal_fs_bdev_bad;

        // row_base.
        mov r10, rbx;
        shl r10, 6;
        lea rbp, [rip + _wal_bdev_state];
        add rbp, r10;

        // rcount == 0 -> silent no-op success.
        mov r12, [rbp + 16];
        cmp r12, 0;
        je  wal_fs_bdev_nop;

        // head_lba.
        mov r13, [rbp + 0];

        // flush_count++ (bump-on-attempt).
        mov rax, [rbp + 32];
        add rax, 1;
        mov [rbp + 32], rax;

        // bdev_write_at(nsid=1, head_lba, count=1, buf_pa=&_wal_scratch).
        mov rdi, 1;
        mov rsi, r13;
        mov rdx, 1;
        lea rcx, [rip + _wal_scratch];
        call bdev_write_at;
        cmp rax, 0;
        jne wal_fs_bdev_io_err;

        // Reset rcount = 0.
        xor rax, rax;
        mov [rbp + 16], rax;

        // klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS__, tag_pdxb_wal_fsynced_ok,
        //            k_records, r12 (rcount just flushed),
        //            k_lba, r13 (head_lba that just landed))
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_pdxb_wal_fsynced_ok];
        lea rcx, [rip + k_records];
        mov r8, r12;
        lea r9, [rip + k_lba];
        sub rsp, 8;
        push r13;
        call klog_s1_x2;
        add rsp, 16;

        // Advance head_lba.
        add r13, 1;
        mov [rbp + 0], r13;

        xor rax, rax;
        jmp wal_fs_bdev_out;

      wal_fs_bdev_bad:
        mov rax, 0xFFFFEFCB;
        jmp wal_fs_bdev_out;

      wal_fs_bdev_nop:
        xor rax, rax;
        jmp wal_fs_bdev_out;

      wal_fs_bdev_io_err:
        mov rax, 0xFFFFEFCC;

      wal_fs_bdev_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
