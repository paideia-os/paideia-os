// src/kernel/core/fs/pdxfs/journal_fence.pdx -- R42.M2-002 (#1385)
//
// PDXFS v1 JOURNAL -- COMMIT ORDERING + FENCE PRIMITIVES.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on commit ordering: a transaction is COMMITTED
// only when this module has (1) observed a fence event -- an mfence +
// block-cache flush pair, modelled in the scaffold by a counter bump --
// AFTER the WAL record's payload writes reached the platform, and
// (2) written a commit marker naming the transaction's seq into its
// own commit table.
//
// The FENCE is the barrier the on-disk widening will implement as
// `mfence; sfence; cache-line-writeback-for-range` (or the platform's
// equivalent). In the scaffold, jfn_fence() bumps _jfn_state.fence_count
// and records the WAL head at the time; jfn_commit(seq) refuses unless
// a fence has been observed AFTER the corresponding WAL record's
// wal_append call. That refusal is the invariant.
//
// It is the RING SIBLING of the WAL: it names records by their WAL
// seq, and the WAL is the sole owner of the ring geometry
// (wal.pdx §1). This module owns nothing but its own commit table.
//
// It is a SCAFFOLD (D7). The commit table is a fixed-size list of
// (seq, wal_head_at_commit) pairs; a widening replaces it with the
// on-disk commit journal the mount path replays.
//
// It does NOT emit real mfence instructions. jfn_fence is a counter
// bump the widening replaces with the barrier pair; the invariant
// checked here is COMPOSITIONAL, not architectural.
//
// It does NOT replay commit records. journal_replay.pdx walks this
// module's commit table on mount via jfn_is_committed(seq); this
// module only records them.
//
// =============================================================================
// §1  COMMIT TABLE GEOMETRY
// =============================================================================
//
// JFN_MAX_COMMITS      = 64        table capacity (mirrors WAL_MAX).
//
// _jfn_commits is a flat array of JFN_MAX_COMMITS * 2 u64s:
//   entry(i) = _jfn_commits[i * 2 .. i * 2 + 1]
//     +0    seq                     WAL seq this commit marker names
//     +8    wal_head_at_commit      WAL head snapshot at commit time
//
// A commit table full is a scaffold refusal; a widening ties commit
// capacity to WAL capacity (one commit per tx).
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _jfn_commits and _jfn_state are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/fs/pdxfs/journal_fence.o`. A second writer would let a caller
// "record a commit without observing the fence", which would let a
// crash between block-write and platform-flush leave a tx marked
// committed when its blocks are still in a volatile cache.
//
// STATE LAYOUT -- _jfn_state : [u64; 8]
//   +0    init_mark          0xEBC0 once jfn_reset has run
//   +8    err                sticky error latch
//   +16   fence_count        total jfn_fence calls
//   +24   commit_count       total jfn_commit calls that succeeded
//   +32   last_fence_head    WAL head observed by the most recent fence
//   +40   commit_head        next-write index into _jfn_commits
//   +48   last_commit_seq    seq of the most recent successful commit
//   +56   reserved
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEFB0..0xFFFFEFBF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: wal 0xFFFFEFC0..CF (R42.M2-001). Adjacent free band below:
// journal_replay 0xFFFFEFA0..AF (R42.M2-003).
//
//   JFN_OK              = 0
//   JFN_ERR_NOT_INIT    = 0xFFFFEFBF   accessor before jfn_reset
//   JFN_ERR_NO_FENCE    = 0xFFFFEFBE   commit without preceding fence
//                                       covering the tx's WAL index
//   JFN_ERR_BAD_SEQ     = 0xFFFFEFBD   commit for seq not present in WAL
//   JFN_ERR_ALREADY     = 0xFFFFEFBC   commit for seq already committed
//   JFN_ERR_TABLE_FULL  = 0xFFFFEFBB   commit table at JFN_MAX_COMMITS
//   JFN_ERR_BAD_IDX     = 0xFFFFEFBA   accessor: idx >= commit_head
//   JFN_ERR_INTERNAL    = 0xFFFFEFB9   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `jfn_`.

module JournalFence = structure {

  pub let JFN_MAX_COMMITS     : u64 = 64

  pub let JFN_OK              : u64 = 0
  pub let JFN_ERR_NOT_INIT    : u64 = 0xFFFFEFBF
  pub let JFN_ERR_NO_FENCE    : u64 = 0xFFFFEFBE
  pub let JFN_ERR_BAD_SEQ     : u64 = 0xFFFFEFBD
  pub let JFN_ERR_ALREADY     : u64 = 0xFFFFEFBC
  pub let JFN_ERR_TABLE_FULL  : u64 = 0xFFFFEFBB
  pub let JFN_ERR_BAD_IDX     : u64 = 0xFFFFEFBA
  pub let JFN_ERR_INTERNAL    : u64 = 0xFFFFEFB9

  pub let JFN_INIT_MARK       : u64 = 0xEBC0

  pub let mut _jfn_commits : [u64; 128] = uninit @align(64)
  pub let mut _jfn_state   : [u64; 8]   = uninit @align(64)

  // ==========================================================================
  // Reset. Clears commit table + state; installs init_mark.
  // ==========================================================================

  pub let jfn_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): clear commit table + state, install init_mark. Labels prefixed jfn_rst_.",
      block: {
        lea r10, [rip + _jfn_commits];
        xor rax, rax;
        xor rcx, rcx;
      jfn_rst_c:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  jfn_rst_c;

        lea r10, [rip + _jfn_state];
        xor rcx, rcx;
      jfn_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  jfn_rst_s;

        mov rax, 0xEBC0;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let jfn_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): 1 iff init_mark matches. Labels prefixed jfn_bnd_.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 0];
        mov r11, 0xEBC0;
        cmp rax, r11;
        jne jfn_bnd_no;
        mov rax, 1;
        ret;
      jfn_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let jfn_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): sticky error latch readback.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let jfn_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): first-writer-wins error latch. Labels prefixed jfn_se_.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne jfn_se_out;
        mov [r10 + 8], rdi;
      jfn_se_out:
        ret
      }
    }

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let jfn_fence_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): fence_count field.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let jfn_commit_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): commit_count field.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let jfn_last_fence_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): last_fence_head field.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let jfn_commit_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): commit_head field.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let jfn_last_commit_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): last_commit_seq field.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  // ==========================================================================
  // jfn_fence() -> u64
  //
  // Observe a fence event. Records the current WAL head as
  // last_fence_head; bumps fence_count. Returns the observed head.
  //
  // Refuses:
  //   - not init                    JFN_ERR_NOT_INIT
  // ==========================================================================

  pub let jfn_fence : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): observe fence event; snapshot WAL head. Labels prefixed jfn_fn_.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 0];
        mov r11, 0xEBC0;
        cmp rax, r11;
        jne jfn_fn_ni;

        // fence_count++
        mov r9, [r10 + 16];
        add r9, 1;
        mov [r10 + 16], r9;

        call wal_head;
        lea r10, [rip + _jfn_state];
        mov [r10 + 32], rax;                    // last_fence_head
        ret;

      jfn_fn_ni:
        mov rdi, 0xFFFFEFBF;
        call jfn_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // jfn_commit(seq) -> u64
  //
  // Write a commit record naming seq. Refuses unless a fence has been
  // observed that covers the WAL index owning that seq (i.e.
  // last_fence_head strictly greater than the seq's WAL index).
  //
  // Refuses:
  //   - not init                    JFN_ERR_NOT_INIT
  //   - seq not present in WAL      JFN_ERR_BAD_SEQ
  //   - fence has not covered idx   JFN_ERR_NO_FENCE
  //   - seq already committed       JFN_ERR_ALREADY
  //   - commit table full           JFN_ERR_TABLE_FULL
  //
  // Register plan: 3-push callee-save. rbx = seq, rbp = seq_idx (WAL
  // index the seq lives at), r12 = commit_head.
  // ==========================================================================

  pub let jfn_commit : (u64) -> u64 !{mem} @{} =
    fn (seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): write commit marker for seq. Labels prefixed jfn_cm_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        sub rsp, 8;

        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 0];
        mov r11, 0xEBC0;
        cmp rax, r11;
        jne jfn_cm_ni;

        mov rbx, rdi;                           // seq

        // Locate seq in the WAL: scan [0..wal_head) via wal_seq_at.
        call wal_head;
        mov r12, rax;                           // WAL head
        xor rbp, rbp;                           // scan cursor
      jfn_cm_scan:
        cmp rbp, r12;
        jae jfn_cm_bs;
        mov rdi, rbp;
        call wal_seq_at;
        cmp rax, rbx;
        je  jfn_cm_found;
        add rbp, 1;
        jmp jfn_cm_scan;

      jfn_cm_found:
        // rbp = WAL index of seq. Fence must have covered it:
        // last_fence_head > rbp.
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 32];                    // last_fence_head
        cmp rax, rbp;
        jbe jfn_cm_nof;

        // Duplicate check: walk [0..commit_head) for seq.
        mov r12, [r10 + 40];                    // commit_head
        lea r11, [rip + _jfn_commits];
        xor rcx, rcx;
      jfn_cm_dup:
        cmp rcx, r12;
        jae jfn_cm_dup_done;
        mov rax, rcx;
        add rax, rax;                           // rcx * 2 (entry base)
        mov r8, [r11 + rax * 8];                // +0 seq
        cmp r8, rbx;
        je  jfn_cm_dupe;
        add rcx, 1;
        jmp jfn_cm_dup;

      jfn_cm_dup_done:
        // Table full check.
        mov r11, 64;                            // JFN_MAX_COMMITS
        cmp r12, r11;
        jae jfn_cm_full;

        // Append at commit_head. Entry base offset = commit_head * 2.
        mov rax, r12;
        add rax, rax;                           // * 2
        lea r11, [rip + _jfn_commits];
        mov [r11 + rax * 8], rbx;               // +0 seq
        add rax, 1;
        call wal_head;
        mov r9, rax;                            // WAL head
        mov rax, r12;
        add rax, rax;
        add rax, 1;
        lea r11, [rip + _jfn_commits];
        mov [r11 + rax * 8], r9;                // +8 wal_head_at_commit

        // commit_head++, commit_count++, last_commit_seq := seq.
        lea r10, [rip + _jfn_state];
        add r12, 1;
        mov [r10 + 40], r12;
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;
        mov [r10 + 48], rbx;

        mov rax, 1;
        jmp jfn_cm_out;

      jfn_cm_ni:
        mov rdi, 0xFFFFEFBF;
        call jfn_set_err;
        xor rax, rax;
        jmp jfn_cm_out;
      jfn_cm_bs:
        mov rdi, 0xFFFFEFBD;
        call jfn_set_err;
        xor rax, rax;
        jmp jfn_cm_out;
      jfn_cm_nof:
        mov rdi, 0xFFFFEFBE;
        call jfn_set_err;
        xor rax, rax;
        jmp jfn_cm_out;
      jfn_cm_dupe:
        mov rdi, 0xFFFFEFBC;
        call jfn_set_err;
        xor rax, rax;
        jmp jfn_cm_out;
      jfn_cm_full:
        mov rdi, 0xFFFFEFBB;
        call jfn_set_err;
        xor rax, rax;

      jfn_cm_out:
        add rsp, 8;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // jfn_is_committed(seq) -> u64
  //
  // 1 iff seq appears in the commit table; 0 otherwise. Refuses on:
  //   - not init                    JFN_ERR_NOT_INIT   (returns 0 with latch)
  // ==========================================================================

  pub let jfn_is_committed : (u64) -> u64 !{mem} @{} =
    fn (seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): 1 iff seq is committed. Labels prefixed jfn_ic_.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 0];
        mov r11, 0xEBC0;
        cmp rax, r11;
        jne jfn_ic_ni;

        mov r9, [r10 + 40];                     // commit_head
        lea r11, [rip + _jfn_commits];
        xor rcx, rcx;
      jfn_ic_top:
        cmp rcx, r9;
        jae jfn_ic_no;
        mov rax, rcx;
        add rax, rax;                           // * 2
        mov r8, [r11 + rax * 8];                // +0 seq
        cmp r8, rdi;
        je  jfn_ic_yes;
        add rcx, 1;
        jmp jfn_ic_top;

      jfn_ic_yes:
        mov rax, 1;
        ret;
      jfn_ic_no:
        xor rax, rax;
        ret;
      jfn_ic_ni:
        mov rdi, 0xFFFFEFBF;
        call jfn_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // jfn_commit_seq_at(idx) -> u64
  //
  // Read the seq stored at commit table position idx. Refuses:
  //   - not init                    JFN_ERR_NOT_INIT
  //   - idx >= commit_head          JFN_ERR_BAD_IDX
  // ==========================================================================

  pub let jfn_commit_seq_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-002 (#1385): read seq of commit record idx. Labels prefixed jfn_sa_.",
      block: {
        lea r10, [rip + _jfn_state];
        mov rax, [r10 + 0];
        mov r11, 0xEBC0;
        cmp rax, r11;
        jne jfn_sa_ni;

        mov rax, [r10 + 40];                    // commit_head
        cmp rdi, rax;
        jae jfn_sa_bi;

        mov rax, rdi;
        add rax, rax;                           // * 2
        lea r11, [rip + _jfn_commits];
        mov rax, [r11 + rax * 8];               // +0 seq
        ret;

      jfn_sa_ni:
        mov rdi, 0xFFFFEFBF;
        call jfn_set_err;
        xor rax, rax;
        ret;
      jfn_sa_bi:
        mov rdi, 0xFFFFEFBA;
        call jfn_set_err;
        xor rax, rax;
        ret
      }
    }
}
