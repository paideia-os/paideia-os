// src/kernel/core/fs/pdxfs/umount_block.pdx -- R52.M8-004 (#1724)
//
// PDXFS-ON-BLOCK v1 -- CLEAN UMOUNT (checkpoint advance + clean-unmount
// flag + final BD_OP_FLUSH + mount-table clear).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// design/filesystem/r52-implementation-plan.md §2.8 (R52.M8) / design/
// filesystem/volume-fs-substrate.md §5.3 ("Data-region blocks: write-
// back... The writeback pass issues BD_OP_FLUSH after every N=32
// writes to bound the crash-loss window.") + §4.3 step 10 ("Recovery on
// mount... rewrite the superblock's flags with the clean-unmount bit
// set"). This file is the CLEAN counterpart to mount_pdxfs_block.pdx
// (#1707): where mount reads the superblock, replays the journal, and
// advances the checkpoint past the replay range, umount flushes every
// dirty cache slot, advances the checkpoint past every WAL record the
// live session appended, stamps SB_FLAG_CLEAN back onto the on-disk
// superblock, issues one final BD_OP_FLUSH so the bdev's own write
// cache commits to media, and finally clears the _mount_table entry
// so a future mount does not observe a stale row.
//
// This is a SIBLING file to mount_block.pdx rather than a second
// function inside it, per the task brief's explicit "or new sibling
// umount_block.pdx if the mount file is being edited by another agent"
// clause -- avoiding a merge collision with any concurrent edit to
// mount_block.pdx while keeping every callee reference symmetric with
// how mount_block.pdx itself pulled them in.
//
// -----------------------------------------------------------------------------
// Why every callee is already landed on disk as of this commit
// -----------------------------------------------------------------------------
//
//   - `block_cache_flush_all` (block_cache.pdx #1715) -- drains every
//     dirty CLOCK-cache slot's owning bdev via
//     `BDEV_OP_WRITE_LBA`, forwarding either 0 (all slots clean or
//     already flushed) or the aggregate BC_WRITEBACK_ERR sentinel
//     (last-writer-wins across the walk, per that file's own header).
//     Same public symbol the write-back cadence tick
//     (block_cache_flush.pdx #1718) already resolves against.
//   - `journal_head_lba` / `journal_writer_set_checkpoint` (journal_
//     ondisk.pdx #1704 + #1708) -- checkpoint advance. mount_pdxfs_
//     block.pdx uses `journal_replay_head_lba` (from the replay walker)
//     for the same purpose at mount; at umount the writer's own live
//     head_lba is the authoritative "everything through here is on
//     disk" pointer, so this function calls the writer-side getter
//     (`journal_head_lba(vol_slot)`) rather than the replay-side one.
//     No fresh JOP_CHECKPOINT record encoder is needed -- the plan's
//     literal call-site language ("call `journal_checkpoint_advance`
//     if it exists ... else emit a JOP_CHECKPOINT record") is a
//     conditional: `journal_checkpoint_advance` does not exist as a
//     single symbol, but `journal_writer_set_checkpoint` IS the
//     checkpoint-advance primitive the writer half of that same module
//     exposes for exactly this purpose (see journal_ondisk.pdx §4.3
//     step 10), and mount_pdxfs_block.pdx's own umount-conceptually-
//     symmetric checkpoint advance uses this exact pair. The
//     JOP_CHECKPOINT alternative would require a new opcode (10) plus
//     a corresponding record-classification arm inside
//     journal_replay's forward walk (currently ops 1..9 only); that
//     is a strictly larger surface change and out of scope for #1724.
//   - `sb_read` / `sb_write` (superblock_read.pdx #1686, superblock_
//     write.pdx #1687) -- the read-modify-write of the flags field.
//     `sb_read` returns a live pointer into `_sb_read_buf`, matching
//     the same posture mount_pdxfs_block.pdx already relies on;
//     stamping bit 0 (PDXB_SB_FLAG_CLEAN_UNMOUNT, #1681) directly
//     into that buffer and calling `sb_write(bdev_cap, sb_ptr)`
//     persists it back verbatim.
//   - `jnl_bdev_flush` (journal_ondisk.pdx #1704) -- one final
//     BD_OP_FLUSH after every prior write is on the platter, ensuring
//     the bdev's own write cache has committed the superblock update
//     before the mount table row is cleared. This mirrors
//     block_cache_flush.pdx (#1718)'s own tick-body BD_OP_FLUSH step
//     one-for-one; that file's own header names the identical helper
//     for the identical purpose.
//   - `volume_row_device_slot` (kind_volume.pdx #1703) -- resolves
//     the KIND_VOLUME row's underlying bdev cap the same way
//     mount_pdxfs_block.pdx's write-back cadence tick already does
//     (block_cache_flush.pdx §Mount-root resolution). Returns
//     VOL_DECODE_BAD (0xFFFFFFFFFFFFFFFF) for a dead row; this
//     function treats that as MOUNT_BACKEND_UNKNOWN, matching mount_
//     block.pdx's own reservation of ED27 for that shape.
//
// -----------------------------------------------------------------------------
// What is deliberately NOT done here (flagged gaps)
// -----------------------------------------------------------------------------
//
// 1. No cap-table hand-back: the `cap_mint_write`-installed KIND_VOLUME
//    handle mount_pdxfs_block minted at cap_slot is NOT torn down here.
//    This function takes `mount_slot` only (arity 1 per the task
//    brief), and the mount-slot -> cap-slot back-pointer is not
//    currently threaded through any table (mount_block.pdx's own
//    header gap 3 flags this exact seam). A caller wanting to also
//    revoke the cap-slot handle after umount does so at its own layer,
//    calling `cap_mint_write(cap_slot, 0, 0, 0)` to zero the row --
//    same posture the M5/M6/M7 boot witnesses' own `*_clear` helpers
//    already use for their own cap-slot rows.
// 2. No KIND_VOLUME row tear-down. `volume_registry_register`
//    (volume_registry.pdx #1706) is idempotent -- probing the same
//    UUID a second time returns the same row_id. The row therefore
//    stays live across umount/remount cycles by design (the substrate
//    doc's own posture, §3.2). If a caller wants to genuinely revoke
//    the row, `volume_row_mount_slot_set(row_id, 0xFFFF)` clears the
//    mount-slot back-pointer without disturbing the uuid mapping --
//    same one-line seam mount_pdxfs_block.pdx uses to stamp it on the
//    other direction.
// 3. No cross-check that _mount_table[mount_slot]'s vol_slot actually
//    matches a live KIND_VOLUME row's own back-pointer
//    (volume_row_mount_slot for row_id == vol_slot should equal
//    mount_slot). A stale mismatch here would indicate mount_pdxfs_
//    block itself failed between stamping the back-pointer and packing
//    the mount table entry -- which mount_pdxfs_block's own five-jne-
//    to-mpb_done error paths already prevent by construction. This
//    function trusts that invariant rather than re-checking it, per
//    this codebase's dominant "one gate per invariant" discipline.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- reuses existing codes; no new sentinels
// -----------------------------------------------------------------------------
//
// design/filesystem/r52-implementation-plan.md §4 reserves R52's ED
// band as `ED00..ED2F` + `ED40..ED4F`. The M8 slice `ED48..ED4F` is
// earmarked for the smoke-witness fingerprints (SMOKE_MKFS_FAIL etc.),
// not for umount-function sentinels. This file therefore declares NO
// NEW error codes; every path either returns 0 (success), reuses one
// of two mount_block.pdx-owned M5-band codes, or forwards a callee's
// own sentinel verbatim:
//
//   0                          success -- every step above returned 0
//   0xFFFF                     mount_slot >= MOUNT_MAX (8) -- mirrors
//                              mount_pdxfs_block.pdx's identical
//                              MOUNT_IDX_NONE convention for the same
//                              "no valid slot to act on" shape (see
//                              that file's header §Failure taxonomy).
//   0xFFFFED27                 the slot's backend_type is not
//                              MOUNT_BACKEND_PDXFS_BLOCK (5), or the
//                              vol_slot's KIND_VOLUME row is dead
//                              (volume_row_device_slot returned
//                              VOL_DECODE_BAD). Reuses mount_block.
//                              pdx's own MOUNT_BACKEND_UNKNOWN slot,
//                              whose header text ("reserved for a
//                              genuinely fitting future call site")
//                              names exactly this class of refusal.
//   forwarded                  block_cache_flush_all's / sb_read's /
//                              sb_write's / jnl_bdev_flush's own
//                              sentinel, returned verbatim. This is
//                              the dominant substrate-mode arm: every
//                              live-hardware boot mode the smoke
//                              matrix drives runs against NVMEIO_
//                              PICK_NONE bdevs, and sb_read/sb_write
//                              compare cap_invoke's raw result directly
//                              against 0 (unlike journal_ondisk.pdx's
//                              own bbjw_check-mediated tolerance --
//                              see mount_replay_witness_synth.pdx's
//                              header for why), so those two calls
//                              legitimately fail with ED08/ED09 in
//                              substrate mode. The umount function
//                              forwards the failure verbatim rather
//                              than swallowing it, because a
//                              substrate-mode "clean unmount" that
//                              could not actually write the flag back
//                              is not clean.
//
// -----------------------------------------------------------------------------
// Distinguishing a real pointer from a sentinel error code
// -----------------------------------------------------------------------------
//
// `sb_read` returns either a live pointer into `_sb_read_buf` (>=
// KERNEL_VMA_BASE = 0xFFFF800000000000) or one of the ED08/ED00..ED07
// sentinels (< 2^32). This file uses the same stage-then-compare idiom
// mount_pdxfs_block.pdx uses: `mov r10, KERNEL_VMA_BASE; cmp rax, r10;
// jb umb_done` -- register-register compare, no imm32 sign-extension
// hazard. The stage-then-compare is also load-bearing for the
// VOL_DECODE_BAD (0xFFFFFFFFFFFFFFFF) check: that constant is imm64
// with bit 63 set, so `cmp rax, r10` with r10 pre-loaded avoids the
// same hazard.
//
// -----------------------------------------------------------------------------
// Arity discipline
// -----------------------------------------------------------------------------
//
// `umount_pdxfs_block(mount_slot) -> u64`, arity 1 -- well under the
// paideia-as arity-6 ceiling. Every callee this function invokes has
// its own arity vetted at the milestone that landed it (all 0..2).
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// Six values need to survive across nested calls: mount_slot, vol_slot,
// bdev_cap, sb_ptr, mount entry (for the final clear), and the running
// error accumulator. That is one value too many for the four
// callee-save registers available under a 5-push prologue (rsp%16==0
// budget), so this file follows mount_block.pdx's OWN idiom: three
// hot values live in callee-save registers for the whole body
// (rbx=bdev_cap once resolved, r12=mount_slot, r14=vol_slot); r13
// holds sb_ptr once `sb_read` succeeds; and one small static scratch
// (`_umb_scratch`) captures values that would otherwise fight for the
// last callee-save slot. The 5-push prologue (rbx/r12/r13/r14/r15,
// odd-count landing rsp%16==0 from SysV-entry rsp%16==8; the r15 push
// exists purely for prologue-count parity with the codebase's
// dominant sb_read-shape idiom, since a 4-push prologue would land
// rsp%16==8 and require an extra `sub rsp, 8`).
//
// `_umb_scratch : [u64; 8] @align(64)`:
//   +0  mount_entry_qword      (the packed _mount_table entry we read,
//                               so a later step's rax clobber does not
//                               force a second table read)
//   +8..+56  unused headroom
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// One byte-granularity access -- the SB_FLAG_CLEAN read-modify-write
// touches the u32 flags field @+28 (PDXB_SB_FLAGS_OFFSET), using
// `mov_d` on both load and store, matching mount_replay_witness_synth.
// pdx's own precedent for the identical field on the identical
// fixture. No `test` instruction anywhere; every branch is `cmp reg,
// imm` / `cmp reg, reg` + `je`/`jne`/`jae`/`jb`. Every sentinel with
// bit 63 set that is COMPARED against `rax` (VOL_DECODE_BAD,
// KERNEL_VMA_BASE) stages through r10 first; sentinels merely
// ASSIGNED to rax via `mov rax, <imm>` need no staging. No comparison
// against a `_mount_table` or `_umb_scratch` cell (every read loads
// into a register first). Every label is prefixed `umb_` -- grep audit
// against src/kernel/ at authoring time: no `umb_` hits anywhere else,
// no `_umb_` hits anywhere else -- both label prefix and BSS symbol
// are this file's alone.

module UmountBlock = structure {

  pub let mut _umb_scratch : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // umount_pdxfs_block(mount_slot) -> u64
  //   Success: 0.
  //   Failure sentinels: 0xFFFF (mount_slot out of range), 0xFFFFED27
  //   (backend mismatch OR dead volume row -- reused MOUNT_BACKEND_
  //   UNKNOWN), or a callee's own error code forwarded verbatim (see
  //   the Failure taxonomy note in the file header).
  //
  // Body per file header:
  //   (1) Bound-check mount_slot < MOUNT_MAX (8), else 0xFFFF.
  //   (2) Load _mount_table[mount_slot]; refuse if backend_type != 5.
  //   (3) Extract vol_slot from bits [48,64); resolve bdev_cap via
  //       volume_row_device_slot, refusing on VOL_DECODE_BAD.
  //   (4) block_cache_flush_all (§5.3) -- drains dirty data-region
  //       blocks the live session cached but never flushed. Forwards
  //       error verbatim on non-zero.
  //   (5) journal_head_lba(vol_slot) -> head_lba; journal_writer_set_
  //       checkpoint(vol_slot, head_lba) -- advances the checkpoint
  //       past the whole live-session WAL (§4.3 step 10, umount-side
  //       symmetric to mount_pdxfs_block's own post-replay advance).
  //       journal_writer_set_checkpoint has no return value (per its
  //       own header: no-op if vol_slot >= 16, else stamps the field);
  //       an unset head_lba (0) round-trips into the same "unset"
  //       sentinel, which is well-defined per that same header.
  //   (6) sb_read(bdev_cap) -> sb_ptr; refuse on any error sentinel
  //       (rax < KERNEL_VMA_BASE) by forwarding verbatim.
  //   (7) Stamp SB_FLAG_CLEAN (bit 0 = PDXB_SB_FLAG_CLEAN_UNMOUNT):
  //       mov_d rax, [sb_ptr+28]; or rax, 1; mov_d [sb_ptr+28], rax.
  //   (8) sb_write(bdev_cap, sb_ptr) -- persist the flag to LBA 0.
  //       Forwards error verbatim on non-zero.
  //   (9) jnl_bdev_flush(bdev_cap) -- BD_OP_FLUSH the bdev's write
  //       cache so the superblock update commits to media before the
  //       row is cleared. Forwards error verbatim on non-zero.
  //  (10) Clear _mount_table[mount_slot] = 0 -- the row is now free
  //       for a future mount_pdxfs_block scan to claim.
  //  (11) Return 0.
  // ==========================================================================
  pub let umount_pdxfs_block : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (mount_slot: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M8-004 (#1724). 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for every nested call (SysV-entry rsp%16==8 + 40 = 48, %16==0 -- odd-count, no pad). rbx=bdev_cap (set once volume_row_device_slot succeeds; unused for the two pre-resolution steps), r12=mount_slot (from rdi), r13=sb_ptr (set once sb_read succeeds), r14=vol_slot (extracted from the mount-table entry), r15 unused-but-pushed for prologue parity with the codebase's dominant sb_read shape. Body per header numbered scope note: (1) cmp r12,8; jae umb_slot_bad (return 0xFFFF, mirroring mount_pdxfs_block's own MOUNT_IDX_NONE). (2) lea r10,[rip+_mount_table]; rax=[r10+r12*8]; store to _umb_scratch[+0]; shr rax,32; and rax,0xFF; cmp rax,5; jne umb_backend_bad (return 0xFFFFED27). (3) reload rax from _umb_scratch[+0]; shr rax,48; and rax,0xFFFF; r14=rax (vol_slot); mov rdi,r14; call volume_row_device_slot; mov r10,0xFFFFFFFFFFFFFFFF; cmp rax,r10; je umb_backend_bad (dead-row is the same shape as backend mismatch -- both mean 'this slot no longer names a live PDXFS-block mount'); mov rbx,rax (bdev_cap). (4) call block_cache_flush_all; cmp rax,0; jne umb_done (rax already holds the callee error, forwarded verbatim). (5) mov rdi,r14; call journal_head_lba (leaf, no error path); mov rdi,r14; mov rsi,rax; call journal_writer_set_checkpoint (no return value; the vol_slot<16 bound-check is the setter's own responsibility). (6) mov rdi,rbx; call sb_read; mov r10,0xFFFF800000000000 (KERNEL_VMA_BASE); cmp rax,r10; jb umb_done (any ED-band sentinel forwarded verbatim); mov r13,rax (sb_ptr). (7) mov_d rax,[r13+28]; or rax,1 (PDXB_SB_FLAG_CLEAN_UNMOUNT); mov_d [r13+28],rax -- read-modify-write of the flags u32 in place, matching mount_replay_witness_synth.pdx's own precedent for the identical field. (8) mov rdi,rbx; mov rsi,r13; call sb_write; cmp rax,0; jne umb_done (forwards ED09 verbatim). (9) mov rdi,rbx; call jnl_bdev_flush; cmp rax,0; jne umb_done (forwards ED21 verbatim). (10) xor rax,rax; lea r10,[rip+_mount_table]; mov [r10+r12*8],rax -- row is now backend_type=0 (MOUNT_BACKEND_NONE), so mount_pdxfs_block's own Phase-3 scan will claim it on the next mount. (11) xor eax,eax; jmp umb_done. umb_slot_bad: mov rax,0xFFFF; jmp umb_done. umb_backend_bad: mov rax,0xFFFFED27; jmp umb_done. umb_done: 5-pop epilogue (r15,r14,r13,r12,rbx) + ret. No test instruction; one mov_d pair for the SB flags field (matches mount_replay_witness_synth.pdx's own precedent). Reserved labels: umb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // mount_slot

        // (1) bound-check mount_slot < MOUNT_MAX (8).
        cmp r12, 8;
        jae umb_slot_bad;

        // (2) load _mount_table[mount_slot]; refuse if backend != 5.
        lea r10, [rip + _mount_table];
        mov rax, [r10 + r12 * 8];
        lea r11, [rip + _umb_scratch];
        mov [r11 + 0], rax;              // cache mount entry
        shr rax, 32;
        and rax, 0xFF;
        cmp rax, 5;                      // MOUNT_BACKEND_PDXFS_BLOCK
        jne umb_backend_bad;

        // (3) extract vol_slot; resolve bdev_cap.
        lea r11, [rip + _umb_scratch];
        mov rax, [r11 + 0];
        shr rax, 48;
        and rax, 0xFFFF;
        mov r14, rax;                    // vol_slot

        mov rdi, r14;
        call volume_row_device_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // VOL_DECODE_BAD
        cmp rax, r10;
        je umb_backend_bad;
        mov rbx, rax;                    // bdev_cap

        // (4) drain dirty CLOCK-cache slots (§5.3).
        call block_cache_flush_all;
        cmp rax, 0;
        jne umb_done;                    // forwarded verbatim

        // (5) advance checkpoint past every live-session WAL record.
        mov rdi, r14;
        call journal_head_lba;

        mov rdi, r14;
        mov rsi, rax;
        call journal_writer_set_checkpoint;

        // (6) re-read superblock into the shared _sb_read_buf.
        mov rdi, rbx;
        call sb_read;
        mov r10, 0xFFFF800000000000;     // KERNEL_VMA_BASE
        cmp rax, r10;
        jb umb_done;                     // forwarded verbatim
        mov r13, rax;                    // sb_ptr

        // (7) stamp SB_FLAG_CLEAN (bit 0) into the flags field @+28.
        mov_d rax, [r13 + 28];
        or  rax, 1;                      // PDXB_SB_FLAG_CLEAN_UNMOUNT
        mov_d [r13 + 28], rax;

        // (8) persist the superblock back to LBA 0.
        mov rdi, rbx;
        mov rsi, r13;
        call sb_write;
        cmp rax, 0;
        jne umb_done;                    // forwarded verbatim

        // (9) final BD_OP_FLUSH so the write commits to media.
        mov rdi, rbx;
        call jnl_bdev_flush;
        cmp rax, 0;
        jne umb_done;                    // forwarded verbatim

        // (10) clear the mount-table row; a fresh mount can claim it.
        xor rax, rax;
        lea r10, [rip + _mount_table];
        mov [r10 + r12 * 8], rax;

        // (11) success.
        xor eax, eax;
        jmp umb_done;

      umb_slot_bad:
        mov rax, 0xFFFF;                 // MOUNT_IDX_NONE convention
        jmp umb_done;

      umb_backend_bad:
        mov rax, 0xFFFFED27;             // MOUNT_BACKEND_UNKNOWN (reused)
        jmp umb_done;

      umb_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
