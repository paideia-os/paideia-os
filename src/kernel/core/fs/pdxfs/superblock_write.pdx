// src/kernel/core/fs/pdxfs/superblock_write.pdx -- R52.M2-002 (#1687)
//
// PDXFS-ON-BLOCK v1 -- SUPERBLOCK WRITE (BDEV-backed).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Per issue #1687 (design/filesystem/r52-implementation-plan.md §2.2 step
// 2, scope as narrowed by main at M2-002 opening): land
// `sb_write(bdev_cap, sb_block_ptr) -> u64` -- writes a caller-supplied,
// already-formed 4-KiB PDXB superblock block to LBA 0 via
// `BDEV_OP_WRITE_LBA`. This is the counterpart to `superblock_read.pdx`
// (#1686): where `sb_read` fetches + validates, `sb_write` persists.
//
// DESCOPED from the design plan's original §2.2 step-2 text (which named
// a 3-arg `sb_write(bdev_cap, sb_ptr, sig_sk_ptr) -> err` that itself
// calls a paideia-as `mldsa65_sign` intrinsic over bytes `[0, 696)` and
// stamps `sig` at offset 696 before writing): that intrinsic is an
// unlanded cross-repo gap (§5.4 #1 -- "sign is the R52 blocker gap"; the
// paideia-as issue is filed and open as of this commit). This module
// does NOT sign, and does NOT call `BDEV_OP_FLUSH` -- both are left to a
// follow-up once the intrinsic lands (flush ordering relative to a
// caller's own additional writes -- e.g. mkfs.pdxfs's region zeroing --
// is a *caller* concern once #1688 wires those writes; a lone premature
// FLUSH here would just be redundant work at M2-002's scope). The caller
// (mkfs.pdxfs, #1688) is responsible for building a valid superblock
// block (fields via `superblock.pdx`'s accessors) BEFORE calling
// `sb_write`; this module does not validate the block's contents either
// -- it is a pure "persist these 4 KiB to LBA 0" primitive, matching
// `sb_read`'s own precedent of separating I/O from validation (there,
// validation happens; here, there is nothing yet to validate against,
// since the signed region is not fillable without the sign intrinsic).
//
// -----------------------------------------------------------------------------
// Calling convention (design/hardware/nvme-io-queues.md §3.5,
// src/kernel/core/cap/cap_handler_blkdev.pdx header + src/kernel/core/
// cap/invoke.pdx)
// -----------------------------------------------------------------------------
//
// `cap_invoke(slot: u64, op_arg: u64) -> u64` (rdi=slot, rsi=op_arg) is
// the caller-facing entry point; it bounds-checks `slot` and delegates to
// `cap_invoke_dispatch`, which demuxes on cap kind and reaches
// `cap_handler_blkdev` for a `KIND_BLKDEV` (0x42) cap. `op_arg` packs:
//   bits [7:0]    op_code        BDEV_OP_WRITE_LBA = 4
//   bits [11:8]   reserved       MUST be 0
//   bits [63:12]  page_number    descriptor-page address (4-KiB aligned)
// The descriptor page (only consulted for READ_LBA/WRITE_LBA/FLUSH) is a
// caller-owned 32-byte, 4-KiB-aligned scratch, identical layout to
// `sb_read`'s (cap_handler_blkdev.pdx header):
//   +0    lba        (u64)
//   +8    nblocks    (u64)
//   +16   dma_iova   (u64)   SOURCE buffer for WRITE_LBA (unlike READ_LBA,
//                            where it is the destination) -- here it is
//                            simply the caller-supplied `sb_block_ptr`;
//                            this module stages no copy of its own.
//   +24   status_out (u64)   raw driver return, written back by the handler
// `cap_invoke` itself returns `BDEV_ERR_OK` (0) on success, else one of
// the handler's own sentinels (`BDEV_ERR_*`) or a forwarded driver
// failure code. This module treats ANY non-zero return as a single
// generic `PDXB_SB_WRITE_BDEV_ERR` -- same posture as `sb_read`'s
// `PDXB_SB_READ_BDEV_ERR`; a caller that needs the underlying code can
// read `_sb_write_desc[+24]` (status_out) directly.
//
// -----------------------------------------------------------------------------
// Storage
// -----------------------------------------------------------------------------
//
// `_sb_write_desc` : [u64; 4] @align(4096) -- the WRITE_LBA descriptor
//                    page. Must itself be 4-KiB aligned: `op_arg` ORs the
//                    op_code into the low 12 bits of this address, so any
//                    nonzero low bits would corrupt the packed page
//                    number (cap_handler_blkdev.pdx's own header
//                    comment). No `_sb_write_buf` landing zone is needed
//                    here -- unlike `sb_read`, this module never owns the
//                    superblock bytes; `dma_iova` points directly at the
//                    caller-supplied `sb_block_ptr` (§Scope).
// Single-writer state, written only by `sb_write` in this file --
// confined at build time (`tools/build.sh` `ec_confine_one`) to
// `core/fs/pdxfs/superblock_write.o`, matching `sb_read`'s own
// precedent and every other new `_*` table in `core/fs/pdxfs/`.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- 0xFFFFED09 (M2 sub-slice, next slot after #1686's
// 0xFFFFED08; see design/filesystem/r52-implementation-plan.md §4/§7.2)
// -----------------------------------------------------------------------------
//
// `superblock_fmt.pdx` (#1681) reserved band 0xFFFFED08..0xFFFFED4F for
// R52.M2..M8 without defining the individual codes. #1686 claimed the
// first slot (`PDXB_SB_READ_BDEV_ERR = 0xFFFFED08`); this module claims
// the next:
//
//   PDXB_SB_WRITE_BDEV_ERR = 0xFFFFED09   BDEV_OP_WRITE_LBA did not
//                                         return BDEV_ERR_OK (0)
//
// (The design plan's §4 table additionally reserves ED0A/ED0B for
// SB_WRITE_BDEV_ERR/SB_FLUSH_FAIL under the ORIGINAL 3-arg sign+flush
// scope; those slots are left unclaimed here since this module's
// descoped form has neither a sign step nor a flush step. A future
// follow-up that adds signing/flush to this module -- once the
// paideia-as intrinsic lands -- should claim ED0A onward at that time
// rather than renumbering this code.)
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §3.5)
// -----------------------------------------------------------------------------
//
// `sb_write(bdev_cap, sb_block_ptr) -> u64`, arity 2 -- well under the
// paideia-as arity-6 ceiling.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// `sb_write` issues one nested call (`cap_invoke`), so it takes the
// uniform 5-push callee-save prologue this kernel uses for that shape
// (`superblock_read.pdx`'s `sb_read`, `fs/vfs_read.pdx`,
// `fs/vfs_close.pdx`): rbx=bdev_cap, r12=&_sb_write_desc,
// r13=sb_block_ptr (kept live across `cap_invoke`, whose rdi/rsi are
// clobbered), r14/r15 unused but pushed for pattern uniformity. 5 pushes
// from a SysV-entry rsp%16==8 land rsp%16==0, satisfying alignment for
// the nested `call` with no extra `sub rsp, 8`.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access in this module (the descriptor page is
// accessed only as whole qwords; the superblock block itself is never
// touched by this module -- it is handed to the device by address only).
// No `test` instruction anywhere; every branch uses `cmp reg, imm`/`cmp
// reg, reg` + `je`/`jne`. Every label is prefixed `sbw_` (labels are
// local to this file's function; no collision with `superblock_read.pdx`'s
// `sb_read_*` labels in a different translation unit).

module SuperblockWrite = structure {

  // ============================================================================
  // M2 failure taxonomy -- next slot after #1686's 0xFFFFED08.
  // ============================================================================

  pub let PDXB_SB_WRITE_BDEV_ERR : u64 = 0xFFFFED09

  // ============================================================================
  // Storage.
  // ============================================================================

  // 4 qwords: {lba, nblocks, dma_iova, status_out}. Must be 4-KiB aligned
  // (see header note) even though only 32 bytes are used.
  pub let mut _sb_write_desc : [u64; 4] = uninit @align(4096)

  // ============================================================================
  // sb_write(bdev_cap: u64, sb_block_ptr: u64) -> u64
  //   Success: returns 0 (BDEV_ERR_OK). Failure: returns
  //   PDXB_SB_WRITE_BDEV_ERR (bdev I/O did not report BDEV_ERR_OK).
  // ============================================================================

  pub let sb_write : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (sb_block_ptr: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M2-002 (#1687). 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for the nested cap_invoke call (superblock_read.pdx sb_read pattern); entry rsp%16==8 + 40 B of pushes = 48, %16==0, no extra sub rsp needed. Body: (1) rbx = bdev_cap (rdi). (2) r13 = sb_block_ptr (rsi) -- kept live across cap_invoke since rdi/rsi are caller-save. (3) r12 = &_sb_write_desc (lea rip-relative, proven idiom throughout this kernel). (4) Stamp the WRITE_LBA descriptor: [r12+0]=lba=0 (xor rax,rax; mov [r12+0],rax), [r12+8]=nblocks=1 (mov rax,1; mov [r12+8],rax), [r12+16]=dma_iova=r13 (mov [r12+16],r13 -- the caller's own block, no local copy), [r12+24]=status_out=0 (xor rax,rax; mov [r12+24],rax). (5) rdi=rbx (bdev_cap slot); rsi=r12 OR'd with op_code 4 (BDEV_OP_WRITE_LBA) via mov r10,4; or rsi,r10 -- r12's low 12 bits are guaranteed zero by @align(4096), matching sb_read's proven op_arg-packing idiom. call cap_invoke. (6) cmp rax,0; jne sbw_write_bdev_err (any non-zero cap_invoke result maps to the single generic PDXB_SB_WRITE_BDEV_ERR -- see header note on why finer-grained forwarding is out of scope here). (7) Success: xor eax,eax (return 0); jmp sbw_done. sbw_write_bdev_err: mov rax, 0xFFFFED09 (PDXB_SB_WRITE_BDEV_ERR; matches sb_read's proven mov rax,<imm64-fitting-sentinel> idiom). sbw_done: 5-pop epilogue (r15,r14,r13,r12,rbx) + ret. No test instruction; no mov_b (every access here is whole-qword or address computation). Reserved labels: sbw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // bdev_cap
        mov r13, rsi;                    // sb_block_ptr

        lea r12, [rip + _sb_write_desc];
        xor rax, rax;
        mov [r12 + 0], rax;              // lba = 0
        mov rax, 1;
        mov [r12 + 8], rax;              // nblocks = 1
        mov [r12 + 16], r13;             // dma_iova = sb_block_ptr
        xor rax, rax;
        mov [r12 + 24], rax;             // status_out = 0

        mov rdi, rbx;
        mov rsi, r12;
        mov r10, 4;                      // BDEV_OP_WRITE_LBA
        or  rsi, r10;
        call cap_invoke;
        cmp rax, 0;
        jne sbw_write_bdev_err;

        xor eax, eax;
        jmp sbw_done;

      sbw_write_bdev_err:
        mov rax, 0xFFFFED09;

      sbw_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
