// src/kernel/core/fs/pdxfs/mkfs.pdx -- R52.M2-003 (#1688)
//
// PDXFS-ON-BLOCK v1 -- mkfs.pdxfs TOOL (layout + format + persist).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Per design/filesystem/r52-implementation-plan.md §2.2 step 3: land a
// `mkfs.pdxfs` tool that takes a `KIND_BLKDEV` cap, computes the four
// region layouts (inode table, allocator bitmap, journal, data) from the
// caller-supplied volume geometry, zeroes the itable/alloc/journal
// regions, fills a superblock struct with valid magic/version/geometry/
// uuid/regions/root_inode, and persists it via `sb_write` (#1687,
// `superblock_write.pdx`).
//
// Public entry point: `mkfs_run(bdev_cap, total_blocks, block_size,
// inode_ratio, journal_size_hint) -> u64`, arity 5. Returns 0 on success,
// else one of this module's own `MKFS_*` codes or a code forwarded
// verbatim from `sb_write` (`PDXB_SB_WRITE_BDEV_ERR`, superblock_write.pdx).
//
// -----------------------------------------------------------------------------
// File-location decision (flagged design-doc gap, see final report to main)
// -----------------------------------------------------------------------------
//
// The plan's §2.2 "Files new" line names `src/userspace/pkg/mkfs.pdxfs/
// {cmd_mkfs.pdx, cmd_upgrade.pdx, layout.pdx, main.pdx}`. Neither
// `src/userspace/` nor any `pkg/` tree exists anywhere in this repo today
// -- the only real userspace-process tree is `src/user/` (each tool there
// pairs a `.pdx` with a `.ld` linker script and is wired through
// `tools/build-user.sh` into a standalone ELF + tmpfs `/bin/` entry, e.g.
// `pci_enumerator.pdx`/`.ld`). Standing up that parallel process
// infrastructure (linker script, syscall-shim entry, tmpfs embedding,
// task-pool registration, `run-smoke.sh` wiring) is a substantially larger
// scope than #1688 asks for and is not itself gated by anything in M2 --
// M2's own smoke (#1690) and boot witness (#1691) call this tool as a
// plain kernel-space function, matching `sb_read`/`sb_write`'s own
// precedent of landing as callable primitives under
// `src/kernel/core/fs/pdxfs/` rather than as wired userspace tasks.
// `mkfs.pdxfs --upgrade` (#1689) is explicitly a separate issue and is NOT
// implemented here; `layout.pdx`/`main.pdx`/`cmd_mkfs.pdx` are therefore
// collapsed into this one file's `mkfs_layout_compute` / `mkfs_run`
// functions rather than split across a directory that has no build-system
// footing yet. Softarch should confirm at M2 close whether a real
// `src/userspace/` process tree is wanted for a LATER milestone (the
// upgrade path, or once `mkfs.pdxfs` needs to run as an actual boot-time
// task rather than a witness-invoked primitive) -- until then this is the
// pragmatic, buildable landing.
//
// -----------------------------------------------------------------------------
// Region-layout algorithm (mirrors `superblock.pdx`'s `sb_validate_regions`
// checks (a)-(e) exactly, so every superblock this tool produces passes
// that gate unmodified)
// -----------------------------------------------------------------------------
//
// Inputs: `total_blocks` (u64, whole-volume span in 4-KiB blocks),
// `block_size` (u64, must be 4096 -- PDXB_SB_BLOCK_SIZE, checked
// literally since cross-module `pub let` references have no precedent in
// this codebase per `superblock.pdx`'s own header note), `inode_ratio`
// (u64, blocks-per-inode divisor: `num_inodes = total_blocks /
// inode_ratio`, floored to a minimum of 1), `journal_size_hint` (u64,
// journal span directly in 4-KiB blocks -- the plan does not fix a unit
// for this input; block-count is chosen for consistency with every other
// geometry field in the frozen format, and is flagged here as a
// design-doc gap for softarch to confirm).
//
//   itable_lba     = 1                                  (LBA 0 = superblock)
//   num_inodes     = max(1, total_blocks / inode_ratio)
//   itable_bcount  = max(1, ceil(num_inodes / 32))       (128-B inode row,
//                                                          32 rows/4-KiB block
//                                                          -- M4's #1697/#1698
//                                                          row width)
//   alloc_lba      = itable_lba + itable_bcount
//   alloc_bcount   = max(1, ceil(total_blocks / 32768))  (1 bit/block,
//                                                          4096*8 bits/block)
//   journal_lba    = alloc_lba + alloc_bcount
//   journal_bcount = journal_size_hint
//   data_lba       = journal_lba + journal_bcount
//   data_bcount    = total_blocks - data_lba              (requires
//                                                           data_lba < total_blocks,
//                                                           else MKFS_LAYOUT_FAIL)
//
// -----------------------------------------------------------------------------
// Root-inode gap (flagged design-doc gap, see final report to main)
// -----------------------------------------------------------------------------
//
// The plan's step-3 text additionally says mkfs.pdxfs "writes inode 0
// (invalid sentinel) + inode 1 (root dir)". The 128-byte inode row FORMAT
// is not frozen until R52.M4 (#1697 widens `KIND_PDXFS_FILE`, #1698 lands
// `inode_table.pdx`) -- there is no field layout to stamp yet at M2. This
// module therefore zeroes the itable region (every row reads as
// all-zero, which is the correct "unallocated" state for whatever `in_use`
// convention M4 lands) and does NOT stamp inode 1 content. This IS the
// M2 smoke's documented expected behavior: per §2.2 step 5 (#1690), "mkfs
// -> probe -> mount refuses ... because M4 has not yet initialised the
// inode table's sig-tail signing -- the refusal is by design at this
// milestone." Flagged as a required M4 follow-up: once `inode_table.pdx`
// lands, a patch to `mkfs_run` (or a wrapper) must stamp inode 1 as a
// valid root directory before M5's mount path can rely on it.
//
// -----------------------------------------------------------------------------
// Signing gap (inherited from `superblock_write.pdx`, #1687)
// -----------------------------------------------------------------------------
//
// `sb_write` (superblock_write.pdx) was itself descoped at #1687 to NOT
// sign and NOT flush, because the paideia-as `mldsa65_sign` intrinsic is
// an unlanded cross-repo gap (§5.4 #1). This module inherits that
// posture unmodified: `mkfs_sb_populate` leaves `sig_key_hash` (@+128)
// and `sig` (@+696) as zero (their static-storage initial value, never
// subsequently touched) rather than guessing a signature format ahead of
// the intrinsic landing. `sb_validate_sig_scope` (superblock.pdx) does
// not check `sig` contents (only the compile-time scope constants), so
// this does not block `sb_validate_all` -- but it DOES mean the resulting
// volume has no cryptographic superblock signature until a follow-up
// wires the intrinsic through both `sb_write` and this module.
//
// -----------------------------------------------------------------------------
// UUID generation
// -----------------------------------------------------------------------------
//
// Reuses `sb_generate_uuid` (src/kernel/core/fs/pdxfs_lite/uuid.pdx,
// #914) unmodified -- an RFC 4122 v4 UUID from two rdtsc samples
// (real CSPRNG deferred upstream per that module's own header note).
// Cross-directory `call` is already proven in this exact file set
// (`superblock_read.pdx` calls `cap/invoke.pdx`'s `cap_invoke`), so
// calling into `pdxfs_lite/` from `pdxfs/` is the same pattern.
//
// -----------------------------------------------------------------------------
// mount_gen / flags posture
// -----------------------------------------------------------------------------
//
// `mount_gen` (@+112) is stamped 1 at mkfs time (not 0): the M2 boot
// witness's own fingerprint (#1691, out of this issue's scope) prints
// "PDXB PROBE ok dev=0 uuid=... mount_gen=1" against a freshly-mkfs'd,
// probed-but-not-yet-mounted volume (mount itself is R52.M5) -- so 1 must
// be the value mkfs writes, not a value some future mount bump produces.
// `flags` (@+28) is stamped `PDXB_SB_FLAG_CLEAN_UNMOUNT (0x1) |
// PDXB_SB_FLAG_ROOT_VOLUME (0x2) = 0x3`: this tool has no notion of a
// multi-device pool yet (design/filesystem/multi-device-pool.md is future
// work), so every volume it formats is unconditionally marked
// root-eligible. Flagged for softarch to confirm this default once a
// pool-aware mkfs invocation exists.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- 0xFFFFED0C/0xFFFFED0D (M2 sub-slice; see
// design/filesystem/r52-implementation-plan.md §4)
// -----------------------------------------------------------------------------
//
// `MKFS_LAYOUT_FAIL = 0xFFFFED0C`: `mkfs_layout_compute` rejected the
// geometry (bad block_size, zero total_blocks/inode_ratio/
// journal_size_hint, or no room left for a nonempty data region).
// `MKFS_ZERO_FAIL = 0xFFFFED0D`: a `BDEV_OP_WRITE_LBA` issued by
// `mkfs_zero_region` did not return `BDEV_ERR_OK`.
// `mkfs_run` additionally forwards `sb_write`'s own
// `PDXB_SB_WRITE_BDEV_ERR` (0xFFFFED09, superblock_write.pdx) verbatim --
// NOT re-declared here, matching `sb_read.pdx`'s own precedent of
// forwarding a sub-module's code rather than re-numbering it.
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §3.5)
// -----------------------------------------------------------------------------
//
// `mkfs_run(bdev_cap, total_blocks, block_size, inode_ratio,
// journal_size_hint)` = 5. `mkfs_layout_compute` (the same four geometry
// inputs, no `bdev_cap`) = 4, per the plan's own explicit arity note for
// this exact function ("layout compute takes 4 inputs ... sits at 4 args,
// fine"). `mkfs_zero_region(bdev_cap, lba_start, block_count)` = 3.
// `mkfs_sb_populate(sb_block_ptr, layout_row_ptr)` = 2 -- the row-pointer
// collapse the plan recommends generally (§2.2's M5 hazard note) applied
// here too, so this function never approaches the ceiling despite
// populating 14 distinct superblock fields. All four functions sit
// comfortably under the paideia-as arity-6 ceiling.
//
// IMPORTANT: `mkfs_layout_compute` does NOT return the row pointer in
// rax (even though `_mkfs_layout_row`'s address would fit in a u64) --
// it returns a plain 0/error-code `u64` instead, and `mkfs_run` recovers
// the row's address itself via `lea` (a compile-time-known static
// address). This sidesteps a real encoding hazard: `cmp reg, imm32`
// has no 64-bit-immediate form on this ISA, so comparing rax against a
// specific large sentinel like `0xFFFFED0C` would sign-extend the
// immediate to `0xFFFFFFFFFFFFED0C` and never match the function's
// actual `mov rax, 0xFFFFED0C` (movabs-style exact-bit-pattern) return
// value -- silently dead code. Every existing sentinel-bearing function
// in this codebase (`sb_read`, `sb_write`, ...) sidesteps the same
// hazard by only ever testing `cmp rax, 0` / `jne` and forwarding the
// exact code verbatim, never re-comparing against the specific literal;
// this module follows that same discipline throughout.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// `mkfs_run`, `mkfs_zero_region`, and `mkfs_sb_populate` each issue
// nested `call`s, so each takes the uniform 5-push callee-save prologue
// this kernel uses for that shape (`superblock_read.pdx`'s `sb_read`,
// `superblock_write.pdx`'s `sb_write`): 5 pushes from a SysV-entry
// rsp%16==8 land rsp%16==0, satisfying alignment with no extra `sub rsp,
// 8`. `mkfs_layout_compute` is a pure leaf (no nested calls, only `div`)
// and takes no prologue, matching `superblock.pdx`'s `sb_validate_regions`
// precedent for the same shape.
//
// `mkfs_run`: rbx=bdev_cap (kept live throughout), r12=total_blocks then
// (after the layout call) reloaded to `&_mkfs_layout_row`, r13/r14/r15 =
// block_size/inode_ratio/journal_size_hint (live only long enough to
// marshal the `mkfs_layout_compute` call; dead afterward -- their values
// are baked into the row, so nothing re-reads them from these registers).
//
// `mkfs_zero_region`: rbx=bdev_cap, r12=&_mkfs_zero_desc, r13=&_mkfs_zero_buf,
// r14=current lba (loop cursor), r15=end lba (lba_start+block_count,
// exclusive).
//
// `mkfs_sb_populate`: rbx=sb_block_ptr, r12=layout_row_ptr, r13/r14/r15
// unused but pushed for pattern uniformity.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this module (every superblock
// field touched here is u32- or u64-aligned; the UUID's byte-level RFC
// 4122 patch bytes live in `sb_generate_uuid`, not duplicated here). No
// `test` instruction anywhere -- every branch uses `cmp reg, imm` / `cmp
// reg, reg` + `je`/`jne`/`jae`. Every label is prefixed `mkfs_` (this
// kernel's reserved-label discipline forbids bare `if`/`loop`/`fs`/
// `alloc`/`mount`/... as labels; `mkfs_` is this file's function-name
// prefix, unique across the whole link unit).

module Mkfs = structure {

  // ============================================================================
  // M2 failure taxonomy -- next two slots after #1686/#1687's
  // 0xFFFFED08/0xFFFFED09.
  // ============================================================================

  pub let MKFS_LAYOUT_FAIL : u64 = 0xFFFFED0C
  pub let MKFS_ZERO_FAIL   : u64 = 0xFFFFED0D

  // ============================================================================
  // Storage.
  // ============================================================================

  // 9 qwords: {itable_lba, itable_bcount, alloc_lba, alloc_bcount,
  // journal_lba, journal_bcount, data_lba, data_bcount, total_blocks}.
  // Plain static row -- not a BDEV descriptor page, no alignment
  // requirement beyond natural u64 alignment.
  pub let mut _mkfs_layout_row : [u64; 9] = [0; 9]

  // 512 qwords = 4096 bytes: the in-memory superblock built by
  // `mkfs_sb_populate` before `sb_write` persists it. @align(4096) matches
  // `superblock_read.pdx`'s `_sb_read_buf` convention (this buffer is
  // handed to `sb_write` as `sb_block_ptr`, which itself hands it
  // straight to `cap_invoke` as `dma_iova` -- see superblock_write.pdx
  // §Storage). Zero-initialized once; `_reserved` (@160, 536 B) and `sig`
  // (@696, 3400 B) are never subsequently written by this module (see
  // the Signing-gap note above), so they stay correctly zero across
  // every `mkfs_run` invocation without a re-zero step.
  pub let mut _mkfs_sb_scratch : [u64; 512] = [0; 512] @align(4096)

  // 512 qwords = 4096 bytes of zero: the reusable WRITE_LBA source buffer
  // for `mkfs_zero_region`. Never written after static init -- every
  // region-zeroing write reads FROM this same buffer.
  pub let mut _mkfs_zero_buf : [u64; 512] = [0; 512] @align(4096)

  // 4 qwords: {lba, nblocks, dma_iova, status_out}. Must be 4-KiB aligned
  // (op_arg ORs the op_code into the low 12 bits of this address --
  // cap_handler_blkdev.pdx's own header comment, same hazard
  // superblock_read.pdx/superblock_write.pdx already document).
  pub let mut _mkfs_zero_desc : [u64; 4] = uninit @align(4096)

  // ============================================================================
  // mkfs_layout_compute(total_blocks: u64, block_size: u64,
  //                      inode_ratio: u64, journal_size_hint: u64) -> u64
  //   Success: returns 0, having stamped all 9 fields of
  //   `_mkfs_layout_row`. Failure: returns MKFS_LAYOUT_FAIL.
  // ============================================================================

  pub let mkfs_layout_compute : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (total_blocks: u64) (block_size: u64) (inode_ratio: u64) (journal_size_hint: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M2-003 (#1688). Pure leaf (no nested calls, only `div`) -- no callee-save prologue needed, matching superblock.pdx's sb_validate_regions precedent for the same shape. Body: (1) Save the 4 args into r8/r9/r10/r11 immediately (rdi/rsi/rdx/rcx are about to be clobbered by `div`, which requires rdx as its high dividend half and rax as its low half/quotient). (2) Validate block_size==4096 (cmp r9,4096; jne fail), total_blocks!=0, inode_ratio!=0, journal_size_hint!=0 (each cmp+je fail) -- guards against div-by-zero and a nonsensical geometry. (3) num_inodes = total_blocks/inode_ratio via `mov rax,r8; xor rdx,rdx; div r10` (proven xor-then-div idiom, klog/hex.pdx L105-106); floor to 1 if the division truncated to 0 (small volume, few inodes). (4) itable_bcount = ceil(num_inodes/32) via `add rcx,31` then the same xor-div-by-32 idiom; floor to 1. (5) itable_lba=1 (LBA 0 is the superblock); stamp row[0]=itable_lba, row[1]=itable_bcount via `lea r9,[rip+_mkfs_layout_row]` (r9 free again -- block_size no longer needed post-validation). (6) alloc_lba = itable_lba+itable_bcount; row[2]=alloc_lba. (7) alloc_bcount = ceil(total_blocks/32768) (1 bit/block, 4096*8 bits/block), same ceil-div-then-floor-to-1 idiom; row[3]=alloc_bcount. (8) journal_lba = alloc_lba+alloc_bcount (reloaded from row[2] since rax was clobbered by the div); row[4]=journal_lba. (9) journal_bcount = journal_size_hint (r11, untouched this whole time); row[5]=journal_bcount. (10) data_lba = journal_lba+journal_bcount; row[6]=data_lba. (11) Guard: data_lba>=total_blocks (r8) -> fail (no room for a nonempty data region) via `cmp rax,r8; jae fail`. (12) data_bcount = total_blocks-data_lba; row[7]=data_bcount. (13) row[8]=total_blocks (r8). (14) xor eax,eax; ret. fail: mov rax,0xFFFFED0C (MKFS_LAYOUT_FAIL, movabs-exact per the module-header note); ret. This mirrors superblock.pdx's sb_validate_regions checks (a)-(e) exactly (itable_lba>=1, each region starts at/after the previous region's end, data_end<=total_blocks) so every superblock this tool later populates from the row passes sb_validate_regions/sb_validate_all unmodified. No test instruction; no mov_b. Reserved labels: mkfs_layout_compute_.",
      block: {
        mov r8,  rdi;                     // total_blocks
        mov r9,  rsi;                     // block_size
        mov r10, rdx;                     // inode_ratio
        mov r11, rcx;                     // journal_size_hint

        cmp r9, 4096;
        jne mkfs_layout_compute_fail;
        cmp r8, 0;
        je  mkfs_layout_compute_fail;
        cmp r10, 0;
        je  mkfs_layout_compute_fail;
        cmp r11, 0;
        je  mkfs_layout_compute_fail;

        // num_inodes = total_blocks / inode_ratio, floored to 1.
        mov rax, r8;
        xor rdx, rdx;
        div r10;
        cmp rax, 0;
        jne mkfs_layout_compute_ni_ok;
        mov rax, 1;

      mkfs_layout_compute_ni_ok:
        mov rcx, rax;                     // rcx = num_inodes

        // itable_bcount = ceil(num_inodes / 32), floored to 1.
        add rcx, 31;
        mov rax, rcx;
        mov rcx, 32;
        xor rdx, rdx;
        div rcx;
        cmp rax, 0;
        jne mkfs_layout_compute_itbc_ok;
        mov rax, 1;

      mkfs_layout_compute_itbc_ok:
        mov rcx, rax;                     // rcx = itable_bcount

        mov rax, 1;                       // itable_lba
        lea r9, [rip + _mkfs_layout_row];
        mov [r9 + 0], rax;                // row[0] = itable_lba
        mov [r9 + 8], rcx;                // row[1] = itable_bcount

        add rax, rcx;                     // alloc_lba = itable_lba + itable_bcount
        mov [r9 + 16], rax;               // row[2] = alloc_lba

        // alloc_bcount = ceil(total_blocks / 32768), floored to 1.
        mov rcx, r8;
        add rcx, 32767;
        mov rax, rcx;
        mov rcx, 32768;
        xor rdx, rdx;
        div rcx;
        cmp rax, 0;
        jne mkfs_layout_compute_alc_ok;
        mov rax, 1;

      mkfs_layout_compute_alc_ok:
        mov [r9 + 24], rax;               // row[3] = alloc_bcount
        mov rcx, rax;                     // rcx = alloc_bcount

        mov rax, [r9 + 16];               // alloc_lba
        add rax, rcx;                     // journal_lba = alloc_lba + alloc_bcount
        mov [r9 + 32], rax;               // row[4] = journal_lba

        mov [r9 + 40], r11;               // row[5] = journal_bcount

        add rax, r11;                     // data_lba = journal_lba + journal_bcount
        mov [r9 + 48], rax;               // row[6] = data_lba

        cmp rax, r8;
        jae mkfs_layout_compute_fail;     // no room for a nonempty data region

        mov rcx, r8;
        sub rcx, rax;                     // data_bcount = total_blocks - data_lba
        mov [r9 + 56], rcx;               // row[7] = data_bcount

        mov [r9 + 64], r8;                // row[8] = total_blocks

        xor eax, eax;
        ret;

      mkfs_layout_compute_fail:
        mov rax, 0xFFFFED0C;              // MKFS_LAYOUT_FAIL
        ret
      }
    }

  // ============================================================================
  // mkfs_zero_region(bdev_cap: u64, lba_start: u64, block_count: u64) -> u64
  //   Zeroes `block_count` blocks starting at `lba_start`, one
  //   BDEV_OP_WRITE_LBA(nblocks=1) at a time from a shared static
  //   all-zero source buffer. Success: 0. Failure: MKFS_ZERO_FAIL.
  //   block_count==0 is a no-op success (loop bound check fails
  //   immediately).
  // ============================================================================

  pub let mkfs_zero_region : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (lba_start: u64) (block_count: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M2-003 (#1688). 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for the nested cap_invoke call per call, matching superblock_write.pdx's sb_write pattern. Body: (1) rbx=bdev_cap. (2) r14=current lba (=lba_start), r15=end lba (=lba_start+block_count, exclusive) -- computed once. (3) r12=&_mkfs_zero_desc, r13=&_mkfs_zero_buf (both lea rip-relative, computed once outside the loop). (4) Loop mkfs_zero_region_top: cmp r14,r15; jae ok (block_count==0 or loop exhausted -- both correctly reach here since r14 never exceeds r15 by more than 1 per iteration). Else stamp the descriptor: [r12+0]=lba=r14, [r12+8]=nblocks=1, [r12+16]=dma_iova=r13 (the shared zero buffer -- every iteration writes FROM the same source, since the destination LBA is what changes), [r12+24]=status_out=0. rdi=rbx, rsi=r12 OR'd with op_code 4 (BDEV_OP_WRITE_LBA) via r10 (proven idiom, superblock_write.pdx sb_write). call cap_invoke. cmp rax,0; jne fail (any nonzero cap_invoke result maps to MKFS_ZERO_FAIL -- same single-generic-code posture as sb_read/sb_write's own BDEV error mapping). add r14,1 (advance lba); jmp top. ok: xor eax,eax; jmp done. fail: mov rax,0xFFFFED0D (MKFS_ZERO_FAIL). done: 5-pop epilogue + ret. No test instruction; no mov_b (whole-qword descriptor fields only). Reserved labels: mkfs_zero_region_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // bdev_cap
        mov r14, rsi;                     // current lba = lba_start
        mov r15, rsi;
        add r15, rdx;                     // end lba (exclusive) = lba_start + block_count

        lea r12, [rip + _mkfs_zero_desc];
        lea r13, [rip + _mkfs_zero_buf];

      mkfs_zero_region_top:
        cmp r14, r15;
        jae mkfs_zero_region_ok;

        mov [r12 + 0], r14;               // lba
        mov rax, 1;
        mov [r12 + 8], rax;               // nblocks = 1
        mov [r12 + 16], r13;              // dma_iova = &_mkfs_zero_buf
        xor rax, rax;
        mov [r12 + 24], rax;              // status_out = 0

        mov rdi, rbx;
        mov rsi, r12;
        mov r10, 4;                       // BDEV_OP_WRITE_LBA
        or  rsi, r10;
        call cap_invoke;
        cmp rax, 0;
        jne mkfs_zero_region_fail;

        add r14, 1;
        jmp mkfs_zero_region_top;

      mkfs_zero_region_ok:
        xor eax, eax;
        jmp mkfs_zero_region_done;

      mkfs_zero_region_fail:
        mov rax, 0xFFFFED0D;              // MKFS_ZERO_FAIL

      mkfs_zero_region_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // mkfs_sb_populate(sb_block_ptr: u64, layout_row_ptr: u64) -> u64
  //   Stamps a caller-zeroed 4-KiB buffer with a valid v1 PDXB superblock:
  //   magic, version, a fresh RFC 4122 v4 uuid, block_size, flags
  //   (clean-unmount | root-volume), the 8 region-layout fields + total_blocks
  //   from `layout_row_ptr` (see mkfs_layout_compute), root_inode=1,
  //   mount_gen=1. Does NOT touch sig_key_hash/_reserved/sig (left at
  //   their static zero -- see the Signing-gap module note). Always
  //   returns 0.
  // ============================================================================

  pub let mkfs_sb_populate : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (sb_block_ptr: u64) (layout_row_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R52.M2-003 (#1688). 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for the nested sb_generate_uuid call. Body: (1) rbx=sb_block_ptr, r12=layout_row_ptr. (2) magic (u32 @+0)=0x42584450, version (u32 @+4)=1, both via mov-imm+mov_d (proven idiom, pdxfs_lite/superblock.pdx sb_populate). (3) rdi=rbx+8 (&uuid, PDXB_SB_UUID_OFFSET); call sb_generate_uuid (pdxfs_lite/uuid.pdx, cross-directory call already proven by superblock_read.pdx's own call into cap/invoke.pdx) -- writes 16 bytes [8,24), does not touch block_size@24. (4) block_size (u32 @+24)=4096. (5) flags (u32 @+28)=PDXB_SB_FLAG_CLEAN_UNMOUNT|PDXB_SB_FLAG_ROOT_VOLUME=0x3 (see module header's mount_gen/flags-posture note). (6) total_blocks (u64 @+32) = row[8] (@layout_row_ptr+64). (7)-(10) itable_lba/itable_bcount/alloc_lba/alloc_bcount/journal_lba/journal_bcount/data_lba/data_bcount (@+40..@+96) copied verbatim from row[0..7] (@layout_row_ptr+0..+56) via 8 load-then-store pairs, offsets matching superblock_fmt.pdx exactly. (11) root_inode (u64 @+104)=1 (PDXB_SB_ROOT_INODE_DEFAULT). (12) mount_gen (u64 @+112)=1 (see module header note -- the M2 boot witness fingerprint expects mount_gen=1 straight off a freshly-mkfs'd volume). (13) snap_head (u64 @+120)=0 (explicit, though already zero from static init -- documents intent per superblock_fmt.pdx's 'reserved for R53' comment). (14) xor eax,eax; ret. sig_key_hash/_reserved/sig are NOT written (left at the buffer's static zero -- see Signing-gap note). No test instruction; no mov_b (uuid write is sb_generate_uuid's own concern, not duplicated here). Reserved labels: none needed (straight-line after the one call).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // sb_block_ptr
        mov r12, rsi;                     // layout_row_ptr

        // magic @+0, version @+4.
        mov rax, 0x42584450;
        mov_d [rbx + 0], rax;
        mov rax, 1;
        mov_d [rbx + 4], rax;

        // uuid @+8 (16 bytes) via sb_generate_uuid (pdxfs_lite/uuid.pdx).
        mov rdi, rbx;
        add rdi, 8;
        call sb_generate_uuid;

        // block_size @+24, flags @+28.
        mov rax, 4096;
        mov_d [rbx + 24], rax;
        mov rax, 3;                       // CLEAN_UNMOUNT(0x1) | ROOT_VOLUME(0x2)
        mov_d [rbx + 28], rax;

        // total_blocks @+32 = row[8].
        mov rax, [r12 + 64];
        mov [rbx + 32], rax;

        // itable_lba/itable_bcount @+40/+48 = row[0]/row[1].
        mov rax, [r12 + 0];
        mov [rbx + 40], rax;
        mov rax, [r12 + 8];
        mov [rbx + 48], rax;

        // alloc_lba/alloc_bcount @+56/+64 = row[2]/row[3].
        mov rax, [r12 + 16];
        mov [rbx + 56], rax;
        mov rax, [r12 + 24];
        mov [rbx + 64], rax;

        // journal_lba/journal_bcount @+72/+80 = row[4]/row[5].
        mov rax, [r12 + 32];
        mov [rbx + 72], rax;
        mov rax, [r12 + 40];
        mov [rbx + 80], rax;

        // data_lba/data_bcount @+88/+96 = row[6]/row[7].
        mov rax, [r12 + 48];
        mov [rbx + 88], rax;
        mov rax, [r12 + 56];
        mov [rbx + 96], rax;

        // root_inode @+104 = 1.
        mov rax, 1;
        mov [rbx + 104], rax;

        // mount_gen @+112 = 1.
        mov rax, 1;
        mov [rbx + 112], rax;

        // snap_head @+120 = 0 (explicit; already zero from static init).
        xor rax, rax;
        mov [rbx + 120], rax;

        xor eax, eax;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // mkfs_run(bdev_cap: u64, total_blocks: u64, block_size: u64,
  //           inode_ratio: u64, journal_size_hint: u64) -> u64
  //   Top-level mkfs.pdxfs entry point. Computes the region layout, zeroes
  //   the itable/alloc/journal regions, populates a superblock scratch
  //   buffer, and persists it via sb_write.
  //   Success: 0. Failure: MKFS_LAYOUT_FAIL, MKFS_ZERO_FAIL, or
  //   sb_write's PDXB_SB_WRITE_BDEV_ERR (superblock_write.pdx), forwarded
  //   verbatim.
  // ============================================================================

  pub let mkfs_run : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (total_blocks: u64) (block_size: u64) (inode_ratio: u64) (journal_size_hint: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M2-003 (#1688). 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for every nested call below (superblock_read.pdx sb_read / superblock_write.pdx sb_write pattern); entry rsp%16==8 + 40 B of pushes = 48, %16==0. Body: (1) Save the 5 args immediately: rbx=bdev_cap, r12=total_blocks, r13=block_size, r14=inode_ratio, r15=journal_size_hint (all 5 SysV arg regs rdi/rsi/rdx/rcx/r8 are caller-save and would not survive the first nested call). (2) Marshal + call mkfs_layout_compute(r12,r13,r14,r15). cmp rax,0; jne done (forwards MKFS_LAYOUT_FAIL verbatim -- see the module-header arity note on why this is a zero-check, never a specific-sentinel compare). (3) r12 = &_mkfs_layout_row (lea; total_blocks's original value in r12 is no longer needed -- it is now embedded in the row at +64, and r13/r14/r15's block_size/inode_ratio/journal_size_hint values are likewise dead from this point on). (4) Three mkfs_zero_region calls, one per region, each reloading rdi=rbx (bdev_cap) and rsi/rdx from the row (itable: row[0]/row[1] @+0/+8; alloc: row[2]/row[3] @+16/+24; journal: row[4]/row[5] @+32/+40), each followed by cmp rax,0; jne done (forwards MKFS_ZERO_FAIL verbatim). (5) call mkfs_sb_populate(&_mkfs_sb_scratch, r12) -- always returns 0, no check needed. (6) call sb_write(rbx, &_mkfs_sb_scratch) (superblock_write.pdx). cmp rax,0; jne done (forwards PDXB_SB_WRITE_BDEV_ERR verbatim). (7) xor eax,eax (success). done: 5-pop epilogue + ret. No test instruction; no mov_b. Reserved labels: mkfs_run_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // bdev_cap
        mov r12, rsi;                     // total_blocks
        mov r13, rdx;                     // block_size
        mov r14, rcx;                     // inode_ratio
        mov r15, r8;                      // journal_size_hint

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        mov rcx, r15;
        call mkfs_layout_compute;
        cmp rax, 0;
        jne mkfs_run_done;                // rax already = MKFS_LAYOUT_FAIL

        lea r12, [rip + _mkfs_layout_row];

        // Zero the inode-table region.
        mov rdi, rbx;
        mov rsi, [r12 + 0];               // itable_lba
        mov rdx, [r12 + 8];               // itable_bcount
        call mkfs_zero_region;
        cmp rax, 0;
        jne mkfs_run_done;                // rax already = MKFS_ZERO_FAIL

        // Zero the allocator bitmap region.
        mov rdi, rbx;
        mov rsi, [r12 + 16];              // alloc_lba
        mov rdx, [r12 + 24];              // alloc_bcount
        call mkfs_zero_region;
        cmp rax, 0;
        jne mkfs_run_done;

        // Zero the journal region.
        mov rdi, rbx;
        mov rsi, [r12 + 32];              // journal_lba
        mov rdx, [r12 + 40];              // journal_bcount
        call mkfs_zero_region;
        cmp rax, 0;
        jne mkfs_run_done;

        // Populate the superblock scratch buffer.
        lea rdi, [rip + _mkfs_sb_scratch];
        mov rsi, r12;
        call mkfs_sb_populate;

        // Persist it.
        mov rdi, rbx;
        lea rsi, [rip + _mkfs_sb_scratch];
        call sb_write;
        cmp rax, 0;
        jne mkfs_run_done;                // rax already = PDXB_SB_WRITE_BDEV_ERR

        xor eax, eax;

      mkfs_run_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
