// src/kernel/core/fs/pdxfs/lite_reader.pdx -- R42.M4-003 (#1394)
//
// PDXFS LITE -- READ-ONLY COMPAT MODE FOR LEGACY VOLUMES.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on how a caller reads a legacy PdxFS-lite volume
// WITHOUT upgrading it to v1. The read API surface mirrors what a v1
// reader would expose (mount / read / unmount / capacity), but the
// implementation is backed by the LITE on-disk layout. Every write
// attempt lands on lit_write_refuse and gets ROFS -- there is no
// second write path a widening could sneak through.
//
// It is a SCAFFOLD (D7). The block table is a flat 16-entry array in
// BSS seeded by a test path; a widening replaces it with a bounded
// read of the legacy inode + block tables straight off the underlying
// KIND_BLOCK_DEVICE, still refusing writes at the same site.
//
// It does NOT invoke UpgradeV1. A caller that wants to upgrade a lite
// volume calls the upgrade path directly; this module is the "keep
// running against lite" answer, and it must remain safe to invoke
// against a volume the operator has NOT chosen to migrate. Two modules
// looking at the same lite superblock would be safe -- both would be
// read-only -- but the write-refuse counter would then be spread
// across both, weakening the "every write attempt met refusal" claim
// the witness checks.
//
// It does NOT model concurrent readers. A widening will thread the
// mount through the derivation gate so revocation is expressible; the
// scaffold assumes a single caller so the counters stay meaningful.
//
// =============================================================================
// §1  BLOCK TABLE GEOMETRY
// =============================================================================
//
// LIT_MAX_BLOCKS = 16       block capacity (scaffold).
//
// _lit_blocks is a flat [u64; LIT_MAX_BLOCKS]. Block payloads are
// u64 opaque values seeded by the test path. A slot with value 0
// still counts as a live block; lit_read never distinguishes "empty"
// from "zero payload" because the on-disk format the widening will
// consume doesn't either.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _lit_blocks, _lit_sb and _lit_state are written only by helpers in
// this module. tools/build.sh confines relocations against each to
// `core/fs/pdxfs/lite_reader.o`. A second writer would let a caller
// "mount a legacy volume in write mode by planting a mounted-latch
// value the read API doesn't check", which would defeat the whole
// read-only compat story.
//
// STATE LAYOUT -- _lit_state : [u64; 8]
//   +0    init_mark             0x11ED once lit_reset has run
//   +8    err                   sticky error latch
//   +16   mounted               0/1
//   +24   read_count            cumulative successful lit_read calls
//   +32   write_refuse_count    cumulative lit_write_refuse calls
//   +40   mount_count           cumulative successful mounts
//   +48   unmount_count         cumulative successful unmounts
//   +56   reserved
//
// SUPER LAYOUT -- _lit_sb : [u64; 2]
//   +0    magic                 seeded LITE / V1 / other
//   +8    reserved
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEF20..0xFFFFEF2F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: upgrade_dryrun 0xFFFFEF30..3F (R42.M4-002). Adjacent free band
// below: unassigned.
//
//   LIT_OK                    = 0
//   LIT_ERR_NOT_INIT          = 0xFFFFEF2F   accessor before lit_reset
//   LIT_ERR_BAD_MAGIC         = 0xFFFFEF2E   mount against non-LITE magic
//   LIT_ERR_NOT_MOUNTED       = 0xFFFFEF2D   read/write/unmount before mount
//   LIT_ERR_BAD_IDX           = 0xFFFFEF2C   block idx >= LIT_MAX_BLOCKS
//   LIT_ERR_ROFS              = 0xFFFFEF2B   write refused on a mounted volume
//   LIT_ERR_ALREADY_MOUNTED   = 0xFFFFEF2A   mount when already mounted
//   LIT_ERR_INTERNAL          = 0xFFFFEF29   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `lit_`.

module LiteReader = structure {

  pub let LIT_MAX_BLOCKS          : u64 = 16
  pub let LIT_MAGIC_LITE          : u64 = 0x504446534C31
  pub let LIT_MAGIC_V1            : u64 = 0x50444653563200

  pub let LIT_OK                  : u64 = 0
  pub let LIT_ERR_NOT_INIT        : u64 = 0xFFFFEF2F
  pub let LIT_ERR_BAD_MAGIC       : u64 = 0xFFFFEF2E
  pub let LIT_ERR_NOT_MOUNTED     : u64 = 0xFFFFEF2D
  pub let LIT_ERR_BAD_IDX         : u64 = 0xFFFFEF2C
  pub let LIT_ERR_ROFS            : u64 = 0xFFFFEF2B
  pub let LIT_ERR_ALREADY_MOUNTED : u64 = 0xFFFFEF2A
  pub let LIT_ERR_INTERNAL        : u64 = 0xFFFFEF29

  pub let LIT_INIT_MARK           : u64 = 0x11ED

  pub let mut _lit_blocks : [u64; 16] = uninit @align(64)
  pub let mut _lit_sb     : [u64; 2]  = uninit @align(64)
  pub let mut _lit_state  : [u64; 8]  = uninit @align(64)

  // ==========================================================================
  // Reset. Clears blocks + sb + state; installs init_mark.
  // ==========================================================================

  pub let lit_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): clear blocks + sb + state, install init_mark. Labels prefixed lit_rst_.",
      block: {
        lea r10, [rip + _lit_blocks];
        xor rax, rax;
        xor rcx, rcx;
      lit_rst_b:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  lit_rst_b;

        lea r10, [rip + _lit_sb];
        xor rcx, rcx;
      lit_rst_p:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 2;
        jb  lit_rst_p;

        lea r10, [rip + _lit_state];
        xor rcx, rcx;
      lit_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  lit_rst_s;

        mov rax, 0x11ED;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let lit_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): 1 iff init_mark matches. Labels prefixed lit_bnd_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 0];
        mov r11, 0x11ED;
        cmp rax, r11;
        jne lit_bnd_no;
        mov rax, 1;
        ret;
      lit_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let lit_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): sticky error latch readback.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let lit_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): first-writer-wins error latch. Labels prefixed lit_se_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne lit_se_out;
        mov [r10 + 8], rdi;
      lit_se_out:
        ret
      }
    }

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let lit_capacity : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M4-003 (#1394): LIT_MAX_BLOCKS as u64.",
      block: {
        mov rax, 16;
        ret
      }
    }

  pub let lit_is_mounted : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): mounted field.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let lit_read_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): read_count field.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let lit_write_refuse_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): write_refuse_count field.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let lit_mount_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): mount_count field.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let lit_unmount_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): unmount_count field.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let lit_sb_magic : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): superblock magic readback.",
      block: {
        lea r10, [rip + _lit_sb];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // Test seeders (scaffold only).
  //
  // lit_seed_sb(magic)         install the source superblock magic.
  // lit_seed_block(idx, payload) install one block payload.
  // ==========================================================================

  pub let lit_seed_sb : (u64) -> u64 !{mem} @{} =
    fn (magic: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): install superblock magic. Labels prefixed lit_ss_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 0];
        mov r11, 0x11ED;
        cmp rax, r11;
        jne lit_ss_ni;

        lea r11, [rip + _lit_sb];
        mov [r11 + 0], rdi;
        mov rax, 1;
        ret;
      lit_ss_ni:
        mov rdi, 0xFFFFEF2F;
        call lit_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let lit_seed_block : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64, payload: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): install one block payload. Labels prefixed lit_sk_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 0];
        mov r11, 0x11ED;
        cmp rax, r11;
        jne lit_sk_ni;

        cmp rdi, 16;
        jae lit_sk_bi;

        lea r11, [rip + _lit_blocks];
        mov [r11 + rdi * 8], rsi;
        mov rax, 1;
        ret;
      lit_sk_ni:
        mov rdi, 0xFFFFEF2F;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_sk_bi:
        mov rdi, 0xFFFFEF2C;
        call lit_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lit_mount() -> u64
  //
  // Mount the legacy volume read-only. Refuses:
  //   - not init                    LIT_ERR_NOT_INIT
  //   - already mounted             LIT_ERR_ALREADY_MOUNTED
  //   - magic != LIT_MAGIC_LITE     LIT_ERR_BAD_MAGIC
  //
  // On success: sets mounted <- 1, bumps mount_count.
  // ==========================================================================

  pub let lit_mount : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): mount lite volume RO. Labels prefixed lit_mt_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 0];
        mov r11, 0x11ED;
        cmp rax, r11;
        jne lit_mt_ni;

        mov rax, [r10 + 16];                      // mounted
        cmp rax, 0;
        jne lit_mt_am;

        lea r11, [rip + _lit_sb];
        mov rax, [r11 + 0];
        mov r9, 0x504446534C31;
        cmp rax, r9;
        jne lit_mt_bm;

        mov rax, 1;
        mov [r10 + 16], rax;                      // mounted <- 1
        mov r9, [r10 + 40];
        add r9, 1;
        mov [r10 + 40], r9;                       // mount_count++
        mov rax, 1;
        ret;

      lit_mt_ni:
        mov rdi, 0xFFFFEF2F;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_mt_am:
        mov rdi, 0xFFFFEF2A;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_mt_bm:
        mov rdi, 0xFFFFEF2E;
        call lit_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lit_unmount() -> u64
  //
  // Drop the mount. Refuses:
  //   - not init                    LIT_ERR_NOT_INIT
  //   - not mounted                 LIT_ERR_NOT_MOUNTED
  // ==========================================================================

  pub let lit_unmount : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): unmount lite volume. Labels prefixed lit_un_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 0];
        mov r11, 0x11ED;
        cmp rax, r11;
        jne lit_un_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  lit_un_nm;

        xor rax, rax;
        mov [r10 + 16], rax;                      // mounted <- 0
        mov r9, [r10 + 48];
        add r9, 1;
        mov [r10 + 48], r9;                       // unmount_count++
        mov rax, 1;
        ret;

      lit_un_ni:
        mov rdi, 0xFFFFEF2F;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_un_nm:
        mov rdi, 0xFFFFEF2D;
        call lit_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lit_read(idx) -> u64
  //
  // Read block idx (0-based). Returns the block payload on success.
  // Refuses:
  //   - not init                    LIT_ERR_NOT_INIT
  //   - not mounted                 LIT_ERR_NOT_MOUNTED
  //   - idx >= LIT_MAX_BLOCKS       LIT_ERR_BAD_IDX
  //
  // On success: bumps read_count.
  // ==========================================================================

  pub let lit_read : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): read block idx from lite volume. Labels prefixed lit_rd_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 0];
        mov r11, 0x11ED;
        cmp rax, r11;
        jne lit_rd_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  lit_rd_nm;

        cmp rdi, 16;
        jae lit_rd_bi;

        lea r11, [rip + _lit_blocks];
        mov rax, [r11 + rdi * 8];
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;                       // read_count++
        ret;

      lit_rd_ni:
        mov rdi, 0xFFFFEF2F;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_rd_nm:
        mov rdi, 0xFFFFEF2D;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_rd_bi:
        mov rdi, 0xFFFFEF2C;
        call lit_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lit_write_refuse(idx, payload) -> u64
  //
  // The WRITE-REFUSAL LATCH. A live lite mount is IMMUTABLE by
  // construction; this entry is the ONE place a write attempt lands
  // and it always returns LIT_ERR_ROFS when the volume is mounted.
  // Refuses:
  //   - not init                    LIT_ERR_NOT_INIT
  //   - not mounted                 LIT_ERR_NOT_MOUNTED
  //   - idx >= LIT_MAX_BLOCKS       LIT_ERR_BAD_IDX
  //   - mounted                     LIT_ERR_ROFS (the whole point)
  //
  // On refusal (mounted case): bumps write_refuse_count.
  // ==========================================================================

  pub let lit_write_refuse : (u64, u64) -> u64 !{mem} @{} =
    fn (idx: u64, payload: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-003 (#1394): write attempt against lite RO volume always refused. Labels prefixed lit_wr_.",
      block: {
        lea r10, [rip + _lit_state];
        mov rax, [r10 + 0];
        mov r11, 0x11ED;
        cmp rax, r11;
        jne lit_wr_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  lit_wr_nm;

        cmp rdi, 16;
        jae lit_wr_bi;

        // Live mount + valid idx: refuse the write, bump the counter.
        mov r9, [r10 + 32];
        add r9, 1;
        mov [r10 + 32], r9;                       // write_refuse_count++
        mov rdi, 0xFFFFEF2B;
        call lit_set_err;
        mov rax, 0xFFFFEF2B;
        ret;

      lit_wr_ni:
        mov rdi, 0xFFFFEF2F;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_wr_nm:
        mov rdi, 0xFFFFEF2D;
        call lit_set_err;
        xor rax, rax;
        ret;
      lit_wr_bi:
        mov rdi, 0xFFFFEF2C;
        call lit_set_err;
        xor rax, rax;
        ret
      }
    }
}
