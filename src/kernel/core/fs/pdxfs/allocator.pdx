// src/kernel/core/fs/pdxfs/allocator.pdx -- R52.M3-001 (#1692) +
//                                            R52.M3-003 (#1694) +
//                                            R55.M2-001 (#1783)
//
// PDXFS-ON-BLOCK v1 -- BITMAP BLOCK ALLOCATOR SKELETON +
//                      MOUNT-TIME ALLOCATOR SCAN +
//                      EXTENT-RUN FIRST-FIT ALLOCATOR.
//
// Design authority: design/filesystem/r52-implementation-plan.md §2.3
// (R52.M3, step 1: "#1692 -- allocator.pdx: bitmap read/write/scan,
// alloc_hint : u64, LIFO free stack of size 16"; step 3: "#1694 --
// Allocator-scan-on-mount: at mount time, scan the whole allocator
// region (up to 8192 blocks for a 1 TiB volume), find the first zero
// bit, seed alloc_hint from it"); on-disk region layout per
// design/filesystem/volume-fs-substrate.md §2.2 ("Block allocator --
// bitmap, not extents") and §2.1's superblock field table (alloc_lba
// @+56, alloc_bcount @+64, data_lba @+88).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Lands the two core mutating primitives named by this issue:
//
//   alloc_block(bdev_cap: u64, alloc_hint: u64) -> u64
//     Returns an absolute data-region LBA on success, or one of
//     ALLOC_EXHAUSTED / ALLOC_BITMAP_TORN on failure.
//
//   free_block(bdev_cap: u64, lba: u64) -> u64
//     Returns 0 on success, or one of FREE_BAD_BIT / FREE_DOUBLE /
//     ALLOC_BITMAP_TORN / FREE_STACK_FULL.
//
// plus the supporting state this pair needs: a single resident 4-KiB
// bitmap block (`_alloc_bm_buf`), a 16-entry LIFO free stack
// (`_alloc_free_stack`), and `alloc_init(sb_ptr)` to seed the three
// region fields (`alloc_lba`, `alloc_bcount`, `data_lba`) from the
// superblock accessors #1682 (`superblock.pdx`) already landed.
//
// `alloc_scan_on_mount(bdev_cap, sb_ptr) -> u64` (this landing,
// R52.M3-003 / #1694): walks every one of the `alloc_bcount` bitmap
// blocks in turn (not just the single resident block `alloc_block`/
// `free_block` operate on), finds the first clear bit anywhere in the
// region, and seeds a new `alloc_hint` field in `_alloc_state` with its
// GLOBAL bit index (block_idx * 32768 + bit_pos). Per the gap-2 note
// below (carried over from #1692), this landing deliberately does NOT
// reshape `alloc_block`/`free_block`'s own bit-index arithmetic --
// those two still only ever operate on the single block resident at
// `alloc_lba` (block 0 of the bitmap region). A global hint pointing
// past block 0 is therefore not yet actionable by `alloc_block` (its
// existing out-of-[0,32768)-range clamp silently wraps such a hint back
// to 0); widening `alloc_block` to select among multiple resident
// blocks by hint is left to a future issue, exactly as #1692's own gap
// 2 anticipated ("extending alloc_bm_ensure_loaded to select among
// multiple resident-block slots ... does not require reshaping
// alloc_block/free_block's bit-index arithmetic").
//
// The `BITMAP_SET`/`BITMAP_CLEAR` WAL encoders remain the other
// unlanded issue in this milestone (#1693) and are deliberately not
// landed here -- see "Design-doc gaps flagged" below.
//
// -----------------------------------------------------------------------------
// Design-doc gaps flagged (see final report to main / softarch)
// -----------------------------------------------------------------------------
//
// 1. Signature shape. §2.3 names `alloc_block(vol_slot) -> lba | err`
//    and `free_block(vol_slot, lba) -> err` against a per-volume slot
//    table that does not exist yet (the volume registry is R52.M5,
//    `#1707`). This landing instead threads the caller-supplied
//    `bdev_cap` directly (exactly as `superblock_read.pdx`/
//    `superblock_write.pdx` already do) and an explicit `alloc_hint`
//    argument for `alloc_block` rather than a hidden per-slot hint
//    field, since no per-slot table exists to hold one yet. This is
//    the same "no cross-module vol_slot registry precedent" posture
//    `superblock.pdx`'s own header flags for its design-doc gap.
//    `alloc_init`/module-global state fills the single-volume role a
//    `vol_slot` table would occupy once M5 lands; a follow-up at M5
//    can widen these globals into a per-slot array without touching
//    the bit-scan/free-stack logic itself.
//
// 2. Single resident bitmap block. Per §2.3's own guidance ("Cache the
//    current bitmap block in a 4 KiB scratch buffer per volume; only
//    one bitmap block loaded at a time"), this module models exactly
//    ONE 4-KiB bitmap block (32768 bits, i.e. up to 128 MiB of data
//    blocks) rather than iterating across the full `alloc_bcount`
//    span a large volume may reserve (up to 8192 blocks for 1 TiB,
//    per #1694's own scope line). Multi-block bitmap-region iteration
//    is `alloc_scan_on_mount`'s job (#1694, landed in this file via a
//    dedicated `alloc_bm_load_block` helper that walks every block
//    without disturbing `alloc_block`/`free_block`'s single-resident-
//    block model) -- `alloc_block`/`free_block`'s own bit-index
//    arithmetic below is deliberately NOT reshaped by this landing; see
//    the header's #1694 scope note above for how a global hint value
//    interacts (or, for now, mostly doesn't) with `alloc_block`.
//
// 3. `alloc_init` precondition. `alloc_block`/`free_block` assume
//    `alloc_init(sb_ptr)` has already run in this boot (populating
//    `_alloc_state`'s `alloc_lba`/`alloc_bcount`/`data_lba` fields and
//    zeroing `bm_loaded_flag` + the free-stack count). No frozen M3
//    sentinel exists for "not initialized" (§4's 8-code table for this
//    band is fully allocated to the scan/free/fsck concerns below), so
//    this is an undocumented-in-band precondition rather than a
//    checked one -- exactly the same posture `bdev_barrier.pdx` avoids
//    via its own `MOUNTW_BARRIER_NOT_INIT` check, which this module
//    could adopt at M4+ if a spare band slot becomes available.
//
// 4. `FREE_STACK_FULL` ordering. `free_block` clears the bitmap bit and
//    durably writes it back BEFORE attempting to push the freed `lba`
//    onto the LIFO hint stack. A full stack (16 entries already
//    pending reuse) does not undo the already-committed free -- it
//    only means this particular `lba` will not be preferentially
//    reused by a subsequent `alloc_block` call (it remains discoverable
//    by the ordinary linear bitmap scan). `free_block` still returns
//    `FREE_STACK_FULL` in that case so a caller can observe the
//    degraded-hint condition, even though the free itself succeeded.
//    Flagged since this is a "soft" failure return over a state that
//    is otherwise fully consistent -- softarch should confirm this
//    reporting convention before M4 callers start depending on it.
//
// -----------------------------------------------------------------------------
// Bitmap layout
// -----------------------------------------------------------------------------
//
// Bit i (0 <= i < 32768) in `_alloc_bm_buf` corresponds to data block i
// past `data_lba`: physical LBA = data_lba + i. `1` = allocated,
// `0` = free. Word/bit decomposition mirrors the proven idiom in
// `pdxfs_lite/alloc.pdx` (`extent_alloc`/`extent_free`):
//
//   word_index = (bit_index >> 6) << 3      (byte offset of the qword)
//   bit_pos    = bit_index & 63
//   bit        = (word >> bit_pos) & 1
//
// -----------------------------------------------------------------------------
// Storage (single-writer per field; the writers are named per §Storage
// convention this tree already uses -- superblock_read.pdx, mkfs.pdx)
// -----------------------------------------------------------------------------
//
// `_alloc_state`       : [u64; 8] @align(8)
//   +0  init_mark        ALLOC_INIT_MARK once alloc_init has run
//   +8  alloc_lba        cached from sb_alloc_lba (superblock.pdx, #1682)
//   +16 alloc_bcount     cached from sb_alloc_bcount; used as the
//                        block_idx loop bound by alloc_scan_on_mount
//                        (#1694) -- alloc_block/free_block themselves
//                        still do not use it to select among multiple
//                        bitmap blocks (see gap 2 above)
//   +24 data_lba         cached from sb_data_lba
//   +32 bm_loaded_flag   0 = _alloc_bm_buf stale, 1 = holds alloc_lba's
//                        block
//   +40 alloc_hint       GLOBAL bit index (block_idx * 32768 + bit_pos)
//                        across the whole alloc_bcount-block region,
//                        seeded by alloc_scan_on_mount (#1694). Zero
//                        until a scan has run at least once in this
//                        boot (alloc_init does not touch this field).
//   +48/+56 reserved, not yet assigned
//
// `_alloc_bm_buf`  : [u64; 512] @align(4096) -- the one resident 4-KiB
//                    bitmap block (32768 bits).
// `_alloc_bm_desc` : [u64; 4]   @align(4096) -- the BDEV_OP_READ_LBA
//                    descriptor page used by `alloc_bm_ensure_loaded`
//                    and `alloc_bm_load_block` (#1694) (writes go
//                    through `bdev_barrier_write`, which owns its own
//                    descriptor page internally). The two readers never
//                    run concurrently (single-threaded boot/mount
//                    path), so sharing this one staging buffer is safe.
//
// `_alloc_free_stack`       : [u64; 16] @align(64) -- LIFO of recently
//                             freed LBAs, reused preferentially by
//                             `alloc_block` for CoW-write locality
//                             (design/filesystem/volume-fs-substrate.md
//                             §2.2).
// `_alloc_free_stack_state` : [u64; 2] @align(8) -- +0 count (0..16).
//
// All five tables are written only by helpers in this file; confined
// at build time via `tools/build.sh` `ec_confine_one`.
//
// -----------------------------------------------------------------------------
// Durable writes -- bdev_barrier.pdx (#1676)
// -----------------------------------------------------------------------------
//
// Every bitmap-block WRITE goes through `bdev_barrier_write` (records
// the (op_code=4, lba) submission event before issuing `cap_invoke`),
// per this issue's explicit scope. Per §2.3's own R51-gate note, M3
// does NOT issue a `BDEV_OP_FLUSH` after these writes -- durability
// across a crash is the journal's job (R52.M5, WAL replay), not this
// milestone's; `bdev_barrier_write`'s own submission record is enough
// to prove ordering once a caller wires FLUSH at M5. Every WRITE and
// the one READ this module issues has its `cap_invoke`-forwarded
// result checked via `BdevBarrier.bbjw_check` (0 = BDEV_ERR_OK,
// 0xFFFFEC58 = NVMEIO_PICK_NONE, both acceptable per that function's
// own header note) -- the same acceptable-status predicate
// `bdev_barrier_journaled_write` already uses, reused here rather than
// re-declaring an equivalent check.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- 0xFFFFED10..ED17 (M3 sub-slice; see
// design/filesystem/r52-implementation-plan.md §4/§7.2)
// -----------------------------------------------------------------------------
//
// All 8 M3 band codes are frozen here (the plan names the full set for
// the milestone's 5 issues up front); #1692 WIRES the four reachable
// from `alloc_block`/`free_block`, this landing (#1694) additionally
// WIRES the two reachable from `alloc_scan_on_mount`, and
// `FSCK_BITMAP_MISMATCH` remains frozen as a constant-only ahead of
// #1695, matching the precedent `superblock_fmt.pdx` set for the M1
// band:
//
//   ALLOC_EXHAUSTED         = 0xFFFFED10  wired: alloc_block's linear
//                                         scan reaches bit 32768
//                                         without finding a free bit.
//   ALLOC_BITMAP_TORN       = 0xFFFFED11  wired: the bitmap block's
//                                         READ (alloc_bm_ensure_loaded)
//                                         or WRITE (bdev_barrier_write)
//                                         did not report an acceptable
//                                         status per bbjw_check.
//   ALLOC_HINT_STALE        = 0xFFFFED12  wired (#1694): alloc_scan_on_
//                                         mount walked every bitmap
//                                         block in the region and found
//                                         no clear bit anywhere -- the
//                                         hint field is left at its
//                                         prior value ("stale") since
//                                         there is nothing fresh to
//                                         seed it with.
//   FREE_BAD_BIT            = 0xFFFFED13  wired: free_block's lba is
//                                         outside [data_lba,
//                                         data_lba + 32768).
//   FREE_DOUBLE             = 0xFFFFED14  wired: free_block's target
//                                         bit is already clear.
//   FREE_STACK_FULL         = 0xFFFFED15  wired: free_block's LIFO
//                                         hint-stack push finds 16
//                                         entries already pending (see
//                                         gap 4 above).
//   ALLOC_SCAN_UNTERMINATED = 0xFFFFED16  wired (#1694): a per-block
//                                         READ_LBA issued by
//                                         alloc_scan_on_mount's walk
//                                         (via alloc_bm_load_block) did
//                                         not report an acceptable
//                                         status per bbjw_check --
//                                         distinct from ALLOC_BITMAP_
//                                         TORN so a caller can tell "the
//                                         whole-region scan couldn't
//                                         complete" apart from a normal
//                                         alloc_block/free_block I/O
//                                         failure.
//   FSCK_BITMAP_MISMATCH    = 0xFFFFED17  wired (#1695, pdxfsck.pdx):
//                                         returned by
//                                         pdxfsck_bitmap_alignment_check
//                                         and
//                                         pdxfsck_free_stack_duplicate_
//                                         check (src/kernel/core/fs/
//                                         pdxfs/pdxfsck.pdx). Restated
//                                         there as a local constant per
//                                         this file's own "no cross-
//                                         module pub-let-by-name"
//                                         convention (see superblock.pdx
//                                         header) -- this comment is the
//                                         authoritative source cited by
//                                         that restatement.
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §3.5)
// -----------------------------------------------------------------------------
//
// `alloc_init(sb_ptr)` = 1. `alloc_bm_ensure_loaded(bdev_cap)` = 1.
// `alloc_bit_test/_set/_clear(bit_index)` = 1 each.
// `alloc_free_stack_count()` = 0, `alloc_free_stack_pop()` = 0,
// `alloc_free_stack_push(lba)` = 1, `alloc_free_stack_peek(index)` = 1
// (#1695). `alloc_block(bdev_cap, alloc_hint)`
// = 2. `free_block(bdev_cap, lba)` = 2.
// `alloc_bm_load_block(bdev_cap, block_idx)` = 2 (#1694).
// `alloc_scan_on_mount(bdev_cap, sb_ptr)` = 2 (#1694).
// `alloc_get_hint()` = 0 (#1694).
// `alloc_extent_run(bdev_cap, want_len, out_start_lba_ptr, out_granted_
// len_ptr, inode_row_ptr)` = 5 (#1783, R55.M2-001). Every arity sits far
// under the paideia-as ceiling of 6.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// This file mixes push-counts by actual need rather than forcing a
// single uniform shape (the same posture `bdev_barrier.pdx` takes
// across its own functions -- 0/1/4-plus-pad/6-plus-pad depending on
// how many live values a function must hold across its nested calls):
//   - `alloc_bit_test/_set/_clear`,
//     `alloc_free_stack_count/_pop/_push/_peek` (#1695) are leaves (no
//     nested `call`); no push needed.
//   - `alloc_init`: 1 push (rbx = sb_ptr, reloaded before each of the
//     3 `sb_*` accessor calls). Entry rsp%16==8 + 8 = 16, %16==0.
//   - `alloc_bm_ensure_loaded`: 1 push (rbx = bdev_cap). Same shape.
//   - `alloc_block`/`free_block`: 5 pushes (rbx/r12/r13/r14/r15,
//     matching the uniform 5-push shape `superblock.pdx`/
//     `superblock_read.pdx` use for this exact "several nested calls,
//     a handful of live values" shape). Entry rsp%16==8 + 40 = 48,
//     %16==0, no extra `sub rsp, 8` needed.
//   - `alloc_bm_load_block`: 1 push (rbx = bdev_cap), same shape as
//     `alloc_bm_ensure_loaded` -- one nested `cap_invoke` + `bbjw_check`
//     pair. Entry rsp%16==8 + 8 = 16, %16==0 (#1694).
//   - `alloc_scan_on_mount`: 5 pushes (rbx = bdev_cap, r12 =
//     alloc_bcount, r13 = block_idx, r14 = unused-but-pushed for
//     pattern uniformity, r15 = bit_idx within the current block),
//     matching the same uniform 5-push shape `alloc_block`/`free_block`
//     use. Entry rsp%16==8 + 40 = 48, %16==0 (#1694).
//   - `alloc_extent_run`: 6 pushes (rbx=bdev_cap, rbp=scan i,
//     r12=granted_len, r13=start_i, r14=inner j, r15=data_lba) + sub
//     rsp,24 for a 3-qword local frame ([rsp+0]=out_start_lba_ptr,
//     [rsp+8]=out_granted_len_ptr, [rsp+16]=inode_row_ptr). Entry
//     rsp%16==8 + 48 + 24 = 80, %16==0. The rbp push is what makes this
//     function one wider than alloc_block's 5-push shape -- alloc_extent
//     _run needs one more callee-save register than alloc_block does
//     (the scan i has to survive nested calls to both alloc_bit_test
//     and alloc_bit_set, whereas alloc_block only ever sees one bit at
//     a time). Same 6-push shape bdev_write.pdx's `nvw_batch_flush`
//     already documents for the identical "one more counter than
//     alloc_block" pressure. Each klog_s1_x2 emit is bracketed by
//     `sub rsp,8; push r12; ...; add rsp,16` to hand v2=granted_len
//     onto the caller-side stack slot the wrappers.pdx signature
//     names (#1783).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this module -- the bitmap is
// manipulated one qword at a time (word_index/bit_pos arithmetic, same
// as `pdxfs_lite/alloc.pdx`), so no `mov_b` is needed (mirroring
// `superblock.pdx`'s own "no mov_b needed" note for a similarly
// whole-qword-only module). No `test` instruction anywhere; every
// zero/nonzero and ordering check uses `cmp reg, imm`/`cmp reg, reg` +
// `je`/`jne`/`jb`/`jae`. Every label in this file is prefixed with its
// owning function's abbreviation under the `alloc_` family
// (`alloc_bl_` for `alloc_block`, `alloc_fb_` for `free_block`,
// `alloc_bel_` for `alloc_bm_ensure_loaded`, `alloc_bml_` for
// `alloc_bm_load_block` (#1694), `alloc_som_` for `alloc_scan_on_mount`
// (#1694)), per the reserved-label discipline (`alloc`/`free`
// themselves are reserved and never used bare as a label).

module Allocator = structure {

  // ============================================================================
  // M3 failure taxonomy -- 0xFFFFED10..ED17 (full band frozen; see header).
  // ============================================================================

  pub let ALLOC_EXHAUSTED         : u64 = 0xFFFFED10
  pub let ALLOC_BITMAP_TORN       : u64 = 0xFFFFED11
  pub let ALLOC_HINT_STALE        : u64 = 0xFFFFED12   // wired: alloc_scan_on_mount (#1694)
  pub let FREE_BAD_BIT            : u64 = 0xFFFFED13
  pub let FREE_DOUBLE             : u64 = 0xFFFFED14
  pub let FREE_STACK_FULL         : u64 = 0xFFFFED15
  pub let ALLOC_SCAN_UNTERMINATED : u64 = 0xFFFFED16   // wired: alloc_scan_on_mount (#1694)
  pub let FSCK_BITMAP_MISMATCH    : u64 = 0xFFFFED17   // reserved for #1695

  // ============================================================================
  // Geometry / misc constants.
  // ============================================================================

  pub let ALLOC_BITMAP_BITS    : u64 = 32768   // 4096 B * 8 bits -- one resident block
  pub let ALLOC_FREE_STACK_CAP : u64 = 16
  pub let ALLOC_INIT_MARK      : u64 = 0xA110C

  // R55.M2-001 (#1783): extent-run allocator (alloc_extent_run) caps the
  // per-call contiguous run at 8 blocks. 8 matches the "inode.extent[0..8]"
  // slot count the ticket names -- one 8-block extent fits in one 8-byte
  // extent slot under the packing convention (see alloc_extent_run's own
  // header), so a caller who requests want_len > 8 gets a granted_len of
  // exactly 8. Callers wanting a larger file allocate multiple runs and
  // populate consecutive extent slots; that multi-slot orchestration lands
  // in pdxfs_block_write (#1784), not here.
  pub let ALLOC_EXTENT_RUN_MAX : u64 = 8

  // R55.M2-001 (#1783): byte offset within the 128-byte inode row where
  // alloc_extent_run stamps extent slot 0's packed (start_lba, len_lba)
  // when a caller supplies inode_row_ptr != 0. Aliases over the pre-R55
  // `root_block` field at offset 48 (inode_table.pdx §"On-disk row
  // layout"): the R55 extent-based file layout supersedes the single-
  // block root_block slot, and inode_table.pdx will be widened alongside
  // pdxfs_block_write (#1784) to name this offset as extent[0].start_lba
  // rather than root_block. See design/filesystem/pdxfs-block-write-e2e.md
  // §Allocator for the packing convention this ticket freezes.
  pub let INODE_EXTENT_SLOT0_OFF : u64 = 48

  // ============================================================================
  // Storage.
  // ============================================================================

  pub let mut _alloc_state : [u64; 8] = uninit @align(8)

  pub let mut _alloc_bm_buf  : [u64; 512] = uninit @align(4096)
  pub let mut _alloc_bm_desc : [u64; 4]   = uninit @align(4096)

  pub let mut _alloc_free_stack       : [u64; 16] = uninit @align(64)
  pub let mut _alloc_free_stack_state : [u64; 2]  = uninit @align(8)

  // ============================================================================
  // alloc_init(sb_ptr: u64) -> u64
  //   Seeds alloc_lba/alloc_bcount/data_lba from the #1682 superblock
  //   accessors, marks the resident bitmap block stale, empties the
  //   free stack, and installs ALLOC_INIT_MARK. Always returns 0.
  // ============================================================================
  pub let alloc_init : (u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-001 (#1692). 1-push prologue (rbx = sb_ptr) lands rsp%16==0 for the 3 nested sb_* accessor calls (entry rsp%16==8 + 8 = 16). rbx is reloaded into rdi before each call since rdi is caller-save. Body: (1) rbx=sb_ptr. (2) rdi=rbx; call sb_alloc_lba; r10=rax. (3) rdi=rbx; call sb_alloc_bcount; r11=rax. (4) rdi=rbx; call sb_data_lba (rax holds data_lba, needed only once, stored immediately -- no register pressure issue). (5) Stamp _alloc_state: [+8]=r10 (alloc_lba), [+16]=r11 (alloc_bcount), [+24]=rax (data_lba), [+32]=0 (bm_loaded_flag), [+0]=ALLOC_INIT_MARK. (6) Zero _alloc_free_stack_state[+0] (count). (7) xor eax,eax; pop rbx; ret. Reserved labels: none needed (straight-line body). Cross-module calls to sb_alloc_lba/sb_alloc_bcount/sb_data_lba (superblock.pdx, module Superblock) follow the same flat-symbol-namespace convention superblock_read.pdx already uses to call sb_validate_magic et al.",
      block: {
        push rbx;
        mov rbx, rdi;

        mov rdi, rbx;
        call sb_alloc_lba;
        mov r10, rax;

        mov rdi, rbx;
        call sb_alloc_bcount;
        mov r11, rax;

        mov rdi, rbx;
        call sb_data_lba;

        lea r9, [rip + _alloc_state];
        mov [r9 + 8], r10;
        mov [r9 + 16], r11;
        mov [r9 + 24], rax;
        xor rax, rax;
        mov [r9 + 32], rax;
        mov r10, 0xA110C;
        mov [r9 + 0], r10;

        lea r9, [rip + _alloc_free_stack_state];
        xor rax, rax;
        mov [r9 + 0], rax;

        xor eax, eax;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // alloc_bm_ensure_loaded(bdev_cap: u64) -> u64
  //   If the resident block already holds alloc_lba's bitmap block
  //   (bm_loaded_flag == 1), no-op (returns 0). Else issues a single
  //   BDEV_OP_READ_LBA(alloc_lba, 1 block) into _alloc_bm_buf. Returns
  //   0 on success, ALLOC_BITMAP_TORN if the read's forwarded status
  //   was not acceptable per BdevBarrier.bbjw_check.
  // ============================================================================
  pub let alloc_bm_ensure_loaded : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M3-001 (#1692). 1-push prologue (rbx = bdev_cap) lands rsp%16==0 for the nested cap_invoke + bbjw_check calls (entry rsp%16==8 + 8 = 16). Body: (1) rbx=bdev_cap. (2) r10=&_alloc_state; rax=[r10+32] (bm_loaded_flag); cmp rax,0; jne ok (already resident). (3) r11=&_alloc_bm_desc; stamp [+0]=alloc_lba ([r10+8]), [+8]=1 (nblocks), [+16]=&_alloc_bm_buf, [+24]=0 (status_out) -- same descriptor-staging idiom as superblock_read.pdx's sb_read. (4) rdi=rbx; rsi=r11 OR'd with BDEV_OP_READ_LBA(3) via r9 (r11's low 12 bits are guaranteed zero by @align(4096)); call cap_invoke. (5) rdi=rax; call bbjw_check (BdevBarrier module -- 0 accepts BDEV_ERR_OK or NVMEIO_PICK_NONE, reused rather than re-declaring an equivalent predicate); cmp rax,0; jne bad. (6) mark bm_loaded_flag=1; xor eax,eax; jmp done. bad: mov rax,0xFFFFED11 (ALLOC_BITMAP_TORN); jmp done. ok: xor eax,eax. done: pop rbx; ret. Reserved labels: alloc_bel_.",
      block: {
        push rbx;
        mov rbx, rdi;

        lea r10, [rip + _alloc_state];
        mov rax, [r10 + 32];
        cmp rax, 0;
        jne alloc_bel_ok;

        lea r11, [rip + _alloc_bm_desc];
        mov rax, [r10 + 8];
        mov [r11 + 0], rax;
        mov rax, 1;
        mov [r11 + 8], rax;
        lea rax, [rip + _alloc_bm_buf];
        mov [r11 + 16], rax;
        xor rax, rax;
        mov [r11 + 24], rax;

        mov rdi, rbx;
        mov rsi, r11;
        mov r9, 3;
        or rsi, r9;
        call cap_invoke;

        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne alloc_bel_bad;

        lea r10, [rip + _alloc_state];
        mov rax, 1;
        mov [r10 + 32], rax;
        xor eax, eax;
        jmp alloc_bel_done;

      alloc_bel_bad:
        mov rax, 0xFFFFED11;
        jmp alloc_bel_done;

      alloc_bel_ok:
        xor eax, eax;

      alloc_bel_done:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // alloc_bit_test(bit_index: u64) -> u64   (0 or 1)
  // ============================================================================
  pub let alloc_bit_test : (u64) -> u64 !{mem} @{} =
    fn (bit_index: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-001 (#1692). Leaf (no nested call, no push needed). word_addr = &_alloc_bm_buf + ((bit_index >> 6) << 3); bit_pos = bit_index & 63; bit = (word >> bit_pos) & 1. Same decomposition as pdxfs_lite/alloc.pdx's extent_alloc scan step. `and rcx,63` is a safe imm32 (bit31 clear, no sign-extension hazard). Reserved labels: none (straight-line).",
      block: {
        mov r8, rdi;
        shr r8, 6;
        shl r8, 3;
        lea r9, [rip + _alloc_bm_buf];
        add r9, r8;
        mov r10, [r9];
        mov rcx, rdi;
        and rcx, 63;
        shr r10, cl;
        and r10, 1;
        mov rax, r10;
        ret
      }
    }

  // ============================================================================
  // alloc_bit_set(bit_index: u64) -> ()
  // ============================================================================
  pub let alloc_bit_set : (u64) -> () !{mem} @{} =
    fn (bit_index: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-001 (#1692). Leaf. word |= (1 << bit_pos), same addressing as alloc_bit_test. `mov r10,1; shl r10,cl` materialises the mask (proven idiom, pdxfs_lite/alloc.pdx). Reserved labels: none.",
      block: {
        mov r8, rdi;
        shr r8, 6;
        shl r8, 3;
        lea r9, [rip + _alloc_bm_buf];
        add r9, r8;
        mov rcx, rdi;
        and rcx, 63;
        mov r10, 1;
        shl r10, cl;
        mov r11, [r9];
        or r11, r10;
        mov [r9], r11;
        ret
      }
    }

  // ============================================================================
  // alloc_bit_clear(bit_index: u64) -> ()
  // ============================================================================
  pub let alloc_bit_clear : (u64) -> () !{mem} @{} =
    fn (bit_index: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-001 (#1692). Leaf. word &= ~(1 << bit_pos); the invert is `mov r8,0xFFFFFFFFFFFFFFFF; xor r11,r8` (materialise all-ones then XOR to invert the single-bit mask) -- the exact idiom pdxfs_lite/alloc.pdx's extent_free already proves for this same operation. Reserved labels: none.",
      block: {
        mov r8, rdi;
        shr r8, 6;
        shl r8, 3;
        lea r9, [rip + _alloc_bm_buf];
        add r9, r8;
        mov rcx, rdi;
        and rcx, 63;
        mov r10, 1;
        shl r10, cl;
        mov r8, 0xFFFFFFFFFFFFFFFF;
        xor r10, r8;
        mov r11, [r9];
        and r11, r10;
        mov [r9], r11;
        ret
      }
    }

  // ============================================================================
  // alloc_free_stack_count() -> u64
  // ============================================================================
  pub let alloc_free_stack_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-001 (#1692). Leaf readback of _alloc_free_stack_state[+0].",
      block: {
        lea r10, [rip + _alloc_free_stack_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ============================================================================
  // alloc_free_stack_pop() -> u64
  //   Precondition: alloc_free_stack_count() > 0 (checked by callers --
  //   alloc_block only calls this after observing a nonzero count).
  // ============================================================================
  pub let alloc_free_stack_pop : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-001 (#1692). Leaf. rcx=count; index=count-1; rax=stack[index]; store decremented count; return rax. Order matters: the element is read at the OLD count-1 index before the count is overwritten.",
      block: {
        lea r10, [rip + _alloc_free_stack_state];
        mov rcx, [r10 + 0];
        sub rcx, 1;
        lea r9, [rip + _alloc_free_stack];
        mov rax, [r9 + rcx * 8];
        mov [r10 + 0], rcx;
        ret
      }
    }

  // ============================================================================
  // alloc_free_stack_peek(index: u64) -> u64
  //   Nondestructive read of _alloc_free_stack[index]. Unlike
  //   alloc_free_stack_pop, does not touch _alloc_free_stack_state's
  //   count. Precondition: index < alloc_free_stack_count() (checked by
  //   callers -- pdxfsck.pdx's #1695 duplicate-entry scan only ever
  //   peeks indices in [0, count)). R52.M3-004 (#1695): added so
  //   tools/pdxfsck can inspect the LIFO free-stack's contents for
  //   duplicate lba entries without mutating allocator state (a plain
  //   pop/pop compare would empty the stack as a side effect of
  //   verification, which is not an acceptable posture for a read-only
  //   consistency check).
  // ============================================================================
  pub let alloc_free_stack_peek : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-004 (#1695). Leaf (no nested call, no push needed), same addressing shape as alloc_free_stack_pop but without touching _alloc_free_stack_state. Body: lea r9,[rip+_alloc_free_stack]; mov rax,[r9+rdi*8]; ret.",
      block: {
        lea r9, [rip + _alloc_free_stack];
        mov rax, [r9 + rdi * 8];
        ret
      }
    }

  // ============================================================================
  // alloc_free_stack_push(lba: u64) -> u64
  //   0 on success, FREE_STACK_FULL if 16 entries are already pending.
  // ============================================================================
  pub let alloc_free_stack_push : (u64) -> u64 !{mem} @{} =
    fn (lba: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-001 (#1692). Leaf. rax=count; cmp rax,16 (ALLOC_FREE_STACK_CAP); jae full; stack[count]=lba; count+=1; return 0. full: return FREE_STACK_FULL. Reserved labels: alloc_fsp_.",
      block: {
        lea r10, [rip + _alloc_free_stack_state];
        mov rax, [r10 + 0];
        cmp rax, 16;
        jae alloc_fsp_full;

        lea r9, [rip + _alloc_free_stack];
        mov [r9 + rax * 8], rdi;
        add rax, 1;
        mov [r10 + 0], rax;
        xor eax, eax;
        ret;

      alloc_fsp_full:
        mov rax, 0xFFFFED15;
        ret
      }
    }

  // ============================================================================
  // alloc_block(bdev_cap: u64, alloc_hint: u64) -> u64
  //
  //   1. If the free stack is non-empty, pop the most-recently-freed
  //      lba and re-allocate it (CoW-write locality preference, per
  //      volume-fs-substrate.md §2.2).
  //   2. Else linear-scan the resident bitmap block starting at
  //      alloc_hint (clamped to [0, 32768) -- an out-of-range hint
  //      wraps to 0; no second wraparound pass in this skeleton, see
  //      header gap 2) for the first clear bit, set it, and return
  //      data_lba + bit_index.
  //
  //   Every path durably writes the modified bitmap block back via
  //   bdev_barrier_write before returning a successful lba.
  // ============================================================================
  pub let alloc_block : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (alloc_hint: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M3-001 (#1692). 5-push prologue (rbx=bdev_cap, r12=alloc_hint, r13=data_lba, r14=working bit-index/candidate, r15=unused-but-pushed for pattern uniformity with superblock.pdx/superblock_read.pdx) lands rsp%16==0 (entry rsp%16==8 + 40 = 48) for every nested call below. Body: (1) rbx=bdev_cap(rdi), r12=alloc_hint(rsi). (2) r13=[_alloc_state+24] (data_lba). (3) call alloc_free_stack_count; cmp rax,0; je scan path. (4) Reuse path: call alloc_free_stack_pop -> r14=candidate lba. rdi=rbx; call alloc_bm_ensure_loaded; cmp rax,0; jne torn. rax=r14-r13 (bit_index); rdi=rax; call alloc_bit_set. rdi=rbx; rsi=[_alloc_state+8] (alloc_lba); rdx=1; rcx=&_alloc_bm_buf; call bdev_barrier_write; rdi=rax; call bbjw_check; cmp rax,0; jne torn. rax=r14 (candidate lba); return. (5) Scan path: rdi=rbx; call alloc_bm_ensure_loaded; cmp rax,0; jne torn. r14=r12 clamped to 0 if >=32768. Loop: cmp r14,32768 (ALLOC_BITMAP_BITS, safe direct imm per pdxfs_lite/alloc.pdx precedent); jae exhausted. rdi=r14; call alloc_bit_test; cmp rax,0; jne next (bit set = allocated). Found: rdi=r14; call alloc_bit_set. rdi=rbx; rsi=[_alloc_state+8]; rdx=1; rcx=&_alloc_bm_buf; call bdev_barrier_write; rdi=rax; call bbjw_check; cmp rax,0; jne torn. rax=r13+r14 (data_lba+bit_index); return. next: r14+=1; loop. exhausted: rax=ALLOC_EXHAUSTED. torn: rax=ALLOC_BITMAP_TORN. Reserved labels: alloc_bl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r12, rsi;

        lea r10, [rip + _alloc_state];
        mov r13, [r10 + 24];

        call alloc_free_stack_count;
        cmp rax, 0;
        je alloc_bl_scan;

        // ---- reuse-from-free-stack path ----
        call alloc_free_stack_pop;
        mov r14, rax;

        mov rdi, rbx;
        call alloc_bm_ensure_loaded;
        cmp rax, 0;
        jne alloc_bl_torn;

        mov rax, r14;
        sub rax, r13;
        mov rdi, rax;
        call alloc_bit_set;

        mov rdi, rbx;
        lea r10, [rip + _alloc_state];
        mov rsi, [r10 + 8];
        mov rdx, 1;
        lea rcx, [rip + _alloc_bm_buf];
        call bdev_barrier_write;
        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne alloc_bl_torn;

        mov rax, r14;
        jmp alloc_bl_done;

        // ---- linear-scan path ----
      alloc_bl_scan:
        mov rdi, rbx;
        call alloc_bm_ensure_loaded;
        cmp rax, 0;
        jne alloc_bl_torn;

        mov r14, r12;
        cmp r14, 32768;
        jb alloc_bl_scan_top;
        xor r14, r14;

      alloc_bl_scan_top:
        cmp r14, 32768;
        jae alloc_bl_exhausted;

        mov rdi, r14;
        call alloc_bit_test;
        cmp rax, 0;
        jne alloc_bl_scan_next;

        mov rdi, r14;
        call alloc_bit_set;

        mov rdi, rbx;
        lea r10, [rip + _alloc_state];
        mov rsi, [r10 + 8];
        mov rdx, 1;
        lea rcx, [rip + _alloc_bm_buf];
        call bdev_barrier_write;
        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne alloc_bl_torn;

        mov rax, r13;
        add rax, r14;
        jmp alloc_bl_done;

      alloc_bl_scan_next:
        add r14, 1;
        jmp alloc_bl_scan_top;

      alloc_bl_exhausted:
        mov rax, 0xFFFFED10;
        jmp alloc_bl_done;

      alloc_bl_torn:
        mov rax, 0xFFFFED11;

      alloc_bl_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // free_block(bdev_cap: u64, lba: u64) -> u64
  //
  //   Bounds-checks lba against [data_lba, data_lba + 32768), refuses
  //   a double-free (bit already clear), clears the bit, durably
  //   writes the bitmap block back, then pushes lba onto the LIFO free
  //   stack (see header gap 4 for FREE_STACK_FULL's post-hoc posture).
  // ============================================================================
  pub let free_block : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (lba: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M3-001 (#1692). 5-push prologue (rbx=bdev_cap, r12=lba, r13=data_lba, r14=bit_index, r15=unused-but-pushed for pattern uniformity) lands rsp%16==0 (entry rsp%16==8 + 40 = 48). Body: (1) rbx=bdev_cap(rdi), r12=lba(rsi). (2) r13=[_alloc_state+24] (data_lba). (3) cmp r12,r13; jb bad_bit (lba < data_lba, unsigned jb catches underflow). (4) r14=r12-r13 (bit_index); cmp r14,32768; jae bad_bit. (5) rdi=rbx; call alloc_bm_ensure_loaded; cmp rax,0; jne torn. (6) rdi=r14; call alloc_bit_test; cmp rax,0; je double (bit already clear). (7) rdi=r14; call alloc_bit_clear. (8) rdi=rbx; rsi=[_alloc_state+8] (alloc_lba); rdx=1; rcx=&_alloc_bm_buf; call bdev_barrier_write; rdi=rax; call bbjw_check; cmp rax,0; jne torn. (9) rdi=r12 (lba); call alloc_free_stack_push -- rax forwarded verbatim (0 or FREE_STACK_FULL) as this function's own return value. bad_bit: rax=FREE_BAD_BIT. double: rax=FREE_DOUBLE. torn: rax=ALLOC_BITMAP_TORN. Reserved labels: alloc_fb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;
        mov r12, rsi;

        lea r10, [rip + _alloc_state];
        mov r13, [r10 + 24];

        cmp r12, r13;
        jb alloc_fb_bad_bit;

        mov r14, r12;
        sub r14, r13;
        cmp r14, 32768;
        jae alloc_fb_bad_bit;

        mov rdi, rbx;
        call alloc_bm_ensure_loaded;
        cmp rax, 0;
        jne alloc_fb_torn;

        mov rdi, r14;
        call alloc_bit_test;
        cmp rax, 0;
        je alloc_fb_double;

        mov rdi, r14;
        call alloc_bit_clear;

        mov rdi, rbx;
        lea r10, [rip + _alloc_state];
        mov rsi, [r10 + 8];
        mov rdx, 1;
        lea rcx, [rip + _alloc_bm_buf];
        call bdev_barrier_write;
        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne alloc_fb_torn;

        mov rdi, r12;
        call alloc_free_stack_push;
        jmp alloc_fb_done;

      alloc_fb_bad_bit:
        mov rax, 0xFFFFED13;
        jmp alloc_fb_done;

      alloc_fb_double:
        mov rax, 0xFFFFED14;
        jmp alloc_fb_done;

      alloc_fb_torn:
        mov rax, 0xFFFFED11;

      alloc_fb_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // alloc_get_hint() -> u64
  //   Reads the GLOBAL bit-index hint seeded by the most recent
  //   successful alloc_scan_on_mount call (0 if none has run yet in
  //   this boot). R52.M3-003 (#1694).
  // ============================================================================
  pub let alloc_get_hint : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M3-003 (#1694). Leaf readback of _alloc_state[+40] (alloc_hint).",
      block: {
        lea r10, [rip + _alloc_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  // ============================================================================
  // alloc_bm_load_block(bdev_cap: u64, block_idx: u64) -> u64
  //   Unconditionally issues a single BDEV_OP_READ_LBA for the bitmap
  //   block at (alloc_lba + block_idx) into _alloc_bm_buf. Unlike
  //   alloc_bm_ensure_loaded, this does NOT consult or update
  //   bm_loaded_flag -- it exists solely for alloc_scan_on_mount's
  //   whole-region walk, which must load a different physical block on
  //   every iteration; alloc_block/free_block's own notion of "the"
  //   resident block (always alloc_lba's, i.e. block 0) is left
  //   untouched by this helper (design-doc gap 2, #1692 header).
  //   Returns 0 on success, ALLOC_BITMAP_TORN if the read's forwarded
  //   status was not acceptable per BdevBarrier.bbjw_check.
  //   R52.M3-003 (#1694).
  // ============================================================================
  pub let alloc_bm_load_block : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (block_idx: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M3-003 (#1694). 1-push prologue (rbx = bdev_cap) lands rsp%16==0 for the nested cap_invoke + bbjw_check calls (entry rsp%16==8 + 8 = 16), same shape as alloc_bm_ensure_loaded (#1692). Body: (1) rbx=bdev_cap(rdi). (2) r10=&_alloc_state; rax=[r10+8] (alloc_lba); add rax,rsi (block_idx, read before rsi is repurposed below) -> target lba. (3) r11=&_alloc_bm_desc; stamp [+0]=target lba, [+8]=1 (nblocks), [+16]=&_alloc_bm_buf, [+24]=0 (status_out) -- same descriptor-staging idiom as alloc_bm_ensure_loaded/superblock_read.pdx's sb_read. (4) rdi=rbx; rsi=r11 OR'd with BDEV_OP_READ_LBA(3) via r9 (r11's low 12 bits are guaranteed zero by @align(4096)); call cap_invoke. (5) rdi=rax; call bbjw_check; cmp rax,0; jne bad. (6) xor eax,eax; jmp done. bad: mov rax,0xFFFFED11 (ALLOC_BITMAP_TORN); done: pop rbx; ret. Reserved labels: alloc_bml_.",
      block: {
        push rbx;
        mov rbx, rdi;

        lea r10, [rip + _alloc_state];
        mov rax, [r10 + 8];
        add rax, rsi;

        lea r11, [rip + _alloc_bm_desc];
        mov [r11 + 0], rax;
        mov rax, 1;
        mov [r11 + 8], rax;
        lea rax, [rip + _alloc_bm_buf];
        mov [r11 + 16], rax;
        xor rax, rax;
        mov [r11 + 24], rax;

        mov rdi, rbx;
        mov rsi, r11;
        mov r9, 3;
        or rsi, r9;
        call cap_invoke;

        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne alloc_bml_bad;

        xor eax, eax;
        jmp alloc_bml_done;

      alloc_bml_bad:
        mov rax, 0xFFFFED11;

      alloc_bml_done:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // alloc_scan_on_mount(bdev_cap: u64, sb_ptr: u64) -> u64
  //
  //   Mount-time allocator hint seeding (R52.M3-003, #1694). Reseeds
  //   the allocator's cached geometry via alloc_init(sb_ptr) (this also
  //   marks the single resident block stale and empties the free
  //   stack), then walks all `alloc_bcount` bitmap blocks in order
  //   (block_idx = 0 .. alloc_bcount-1), loading each via
  //   alloc_bm_load_block and linear-scanning its 32768 bits for the
  //   first clear one. On success, stamps _alloc_state's alloc_hint
  //   field (+40) with the GLOBAL bit index (block_idx * 32768 +
  //   bit_pos) and returns 0. If every block is scanned without finding
  //   a clear bit, returns ALLOC_HINT_STALE (the hint field is left
  //   untouched -- there is nothing fresh to seed it with). If a
  //   per-block read fails partway through, returns
  //   ALLOC_SCAN_UNTERMINATED.
  //
  //   Per the header's design-doc gap 2 (carried over from #1692),
  //   this does NOT reshape alloc_block/free_block's own single-
  //   resident-block arithmetic -- a hint pointing past block 0 is not
  //   yet actionable by alloc_block; it is left for a future issue to
  //   widen alloc_block's block selection to follow this hint.
  // ============================================================================
  pub let alloc_scan_on_mount : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (sb_ptr: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M3-003 (#1694). 5-push prologue (rbx=bdev_cap, r12=alloc_bcount, r13=block_idx, r14=unused-but-pushed for pattern uniformity with alloc_block/free_block, r15=bit_idx within the current block) lands rsp%16==0 (entry rsp%16==8 + 40 = 48) for every nested call below. Body: (1) rbx=bdev_cap(rdi). (2) rdi=sb_ptr(rsi); call alloc_init -- reseeds alloc_lba/alloc_bcount/data_lba, clears bm_loaded_flag, empties free stack (alloc_hint at +40 is untouched by alloc_init). (3) r10=&_alloc_state; r12=[r10+16] (alloc_bcount). (4) r13=0 (block_idx). loop: cmp r13,r12; jae not_found. (5) rdi=rbx; rsi=r13; call alloc_bm_load_block; cmp rax,0; jne torn. (6) r15=0 (bit_idx). bit_loop: cmp r15,32768; jae block_done (no clear bit in this block, advance to next). (7) rdi=r15; call alloc_bit_test; cmp rax,0; je found (bit==0 means free). (8) r15+=1; jmp bit_loop. block_done: r13+=1; jmp loop. found: rax=r13; shl rax,15 (r13*32768); add rax,r15 (global bit index); r10=&_alloc_state; [r10+40]=rax; xor eax,eax; jmp done. not_found: rax=0xFFFFED12 (ALLOC_HINT_STALE); jmp done. torn: rax=0xFFFFED16 (ALLOC_SCAN_UNTERMINATED). done: pop r15..rbx; ret. Reserved labels: alloc_som_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;

        mov rdi, rsi;
        call alloc_init;

        lea r10, [rip + _alloc_state];
        mov r12, [r10 + 16];

        xor r13, r13;

      alloc_som_loop:
        cmp r13, r12;
        jae alloc_som_not_found;

        mov rdi, rbx;
        mov rsi, r13;
        call alloc_bm_load_block;
        cmp rax, 0;
        jne alloc_som_torn;

        xor r15, r15;

      alloc_som_bit_loop:
        cmp r15, 32768;
        jae alloc_som_block_done;

        mov rdi, r15;
        call alloc_bit_test;
        cmp rax, 0;
        je alloc_som_found;

        add r15, 1;
        jmp alloc_som_bit_loop;

      alloc_som_block_done:
        add r13, 1;
        jmp alloc_som_loop;

      alloc_som_found:
        mov rax, r13;
        shl rax, 15;
        add rax, r15;
        lea r10, [rip + _alloc_state];
        mov [r10 + 40], rax;
        xor eax, eax;
        jmp alloc_som_done;

      alloc_som_not_found:
        mov rax, 0xFFFFED12;
        jmp alloc_som_done;

      alloc_som_torn:
        mov rax, 0xFFFFED16;

      alloc_som_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // alloc_extent_run(bdev_cap: u64, want_len: u64,
  //                  out_start_lba_ptr: u64, out_granted_len_ptr: u64,
  //                  inode_row_ptr: u64) -> u64
  //
  //   R55.M2-001 (#1783). Real body for extent-run allocation of a fresh
  //   file. First-fit over the single resident bitmap block (see design-
  //   doc gap 2 in this file's header for the single-resident-block
  //   posture inherited from alloc_block/free_block): finds the first
  //   position at which `granted_len` (= min(want_len, ALLOC_EXTENT_RUN_
  //   MAX)) contiguous zero bits appear, sets every bit in the run, and
  //   durably writes the modified bitmap block back via bdev_barrier_
  //   write (matching alloc_block's own durability posture -- one WRITE
  //   per successful allocation regardless of run length).
  //
  //   Outputs:
  //     *out_start_lba_ptr    = data_lba + first bit in the run (absolute
  //                              LBA of the run's first block).
  //     *out_granted_len_ptr  = number of contiguous blocks allocated in
  //                              the run (>= 1, <= min(want_len,
  //                              ALLOC_EXTENT_RUN_MAX)). Writes are
  //                              skipped when the corresponding out
  //                              pointer is 0 (unit tests may pass 0 to
  //                              exercise the fingerprint emit without
  //                              caring about the values).
  //     inode row stamp        (only when inode_row_ptr != 0): writes one
  //                              packed u64 at inode_row_ptr +
  //                              INODE_EXTENT_SLOT0_OFF encoding the
  //                              extent slot as
  //                                (granted_len << 48) |
  //                                (start_lba & 0x0000FFFFFFFFFFFF)
  //                              -- the low 48 bits carry the absolute
  //                              start LBA (256 TiB of addressable blocks
  //                              at 1 B/LBA, orders of magnitude more at
  //                              4 KiB), the high 16 bits carry the run
  //                              length (up to 65535 blocks, well past
  //                              ALLOC_EXTENT_RUN_MAX = 8). Aliases over
  //                              the pre-R55 `root_block` field per this
  //                              file's own INODE_EXTENT_SLOT0_OFF header
  //                              note -- pdxfs_block_write (#1784) will
  //                              widen inode_table.pdx's row layout to
  //                              name this offset as extent[0].
  //
  //   Wire event (once per successful allocation):
  //     LEVEL_INFO / SUBSYS_FS__ / tag_pdxb_alloc_ok / start_lba /
  //     granted_len -- both k=v pairs formatted with fmt='x' by klog_
  //     s1_x2. Followed immediately by a self-verify wire event
  //     (tag_pdxb_alloc_verify_ok, same k=v pair) after re-reading every
  //     bit in the run via alloc_bit_test to confirm the set landed --
  //     matches the R55.M2-001 golden's second line and catches an
  //     encoder-time bit-set regression at the emit site itself rather
  //     than downstream in the read path.
  //
  //   Failure returns:
  //     ALLOC_BITMAP_TORN   -- alloc_bm_ensure_loaded or bdev_barrier_
  //                             write reported a non-acceptable status
  //                             (bbjw_check nonzero) -- same posture as
  //                             alloc_block.
  //     ALLOC_EXHAUSTED     -- no window of granted_len contiguous zero
  //                             bits exists in the resident block. Same
  //                             posture as alloc_block: the scan does
  //                             not span multiple bitmap blocks (see
  //                             design-doc gap 2 above).
  //
  //   Signature/arity: 5 args, well under the paideia-as ceiling of 6.
  //   Register plan: 6 callee-save pushes (rbx=bdev_cap, rbp=scan i,
  //   r12=granted_len, r13=start_i once found, r14=inner j, r15=data_lba
  //   cached) + sub rsp,24 to spill out_start_lba_ptr / out_granted_len_
  //   ptr / inode_row_ptr. Entry rsp%16==8, +48 (6 pushes) = 56, +24 =
  //   80, %16==0 for every nested call. The klog_s1_x2 wrappers-side v2
  //   is delivered via a `sub rsp,8; push r12; call; add rsp,16` bracket
  //   around each fingerprint emit (frame sits at rsp%16==0 before the
  //   bracket, so `sub 8; push r12` = 16 B lands rsp%16==0 pre-call).
  //   Reserved labels: alloc_er_.
  // ============================================================================
  pub let alloc_extent_run : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (want_len: u64) (out_start_lba_ptr: u64) (out_granted_len_ptr: u64) (inode_row_ptr: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R55.M2-001 (#1783). Extent-run first-fit allocator. 6-push prologue (rbx=bdev_cap, rbp=scan i, r12=granted_len, r13=start_i once found, r14=inner j, r15=data_lba cached) + sub rsp,24 lands rsp%16==0 (entry rsp%16==8 + 48 + 24 = 80, %16==0). Stack frame: [rsp+0]=out_start_lba_ptr (rdx spill), [rsp+8]=out_granted_len_ptr (rcx spill), [rsp+16]=inode_row_ptr (r8 spill). Body: (1) 6 pushes + sub rsp,24; spill rdx/rcx/r8 to frame; rbx=bdev_cap(rdi); r12=min(rsi, ALLOC_EXTENT_RUN_MAX=8) via cmp+ja+mov. (2) alloc_bm_ensure_loaded(rbx); cmp rax,0; jne torn. (3) r15=[_alloc_state+24] (data_lba cached). (4) Outer scan: rbp=0. loop: rax=rbp; add rax,r12; cmp rax,32768; ja exhausted (no room for a full run). Inner: r14=0. inner: cmp r14,r12; jae found (all r12 bits at rbp..rbp+r12 were zero). rdi=rbp+r14; call alloc_bit_test; cmp rax,0; jne inner_bit_set. r14+=1; jmp inner. inner_bit_set: rbp=rbp+r14+1 (skip past the set bit); jmp outer top. (5) found: r13=rbp (start_i). Set every bit in [rbp, rbp+r12): r14=0. set_top: cmp r14,r12; jae set_done. rdi=rbp+r14; call alloc_bit_set. r14+=1; jmp set_top. set_done. (6) Durable write of the modified bitmap block: rdi=rbx; rsi=[_alloc_state+8] (alloc_lba); rdx=1; rcx=&_alloc_bm_buf; call bdev_barrier_write; rdi=rax; call bbjw_check; cmp rax,0; jne torn. (7) Compute start_lba = r15 + r13; write to *out_start_lba_ptr when non-0 ([rsp+0]) and *out_granted_len_ptr when non-0 ([rsp+8]). (8) Stamp inode extent slot 0 when inode_row_ptr != 0 ([rsp+16]): packed = (r12 << 48) | (start_lba & 0x0000FFFFFFFFFFFF). shl by 48 is safe imm; the mask is materialised via `mov r10, 0x0000FFFFFFFFFFFF` (imm64 stage, bit-63 clear so a bare imm32 would sign-extend incorrectly for the high nibbles -- G4 encoder gap). Store one qword @[inode_row_ptr + INODE_EXTENT_SLOT0_OFF=48]. (9) Verify-post-condition: r14=0. verify_top: cmp r14,r12; jae verify_done. rdi=r13+r14; call alloc_bit_test; cmp rax,0; je torn (a bit that should be SET reads back as 0 -- catches an encoder-time alloc_bit_set regression). r14+=1; jmp verify_top. verify_done. (10) Emit fingerprint: klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS__, tag_pdxb_alloc_ok, k_start_lba, start_lba, k_len_lba, granted_len). start_lba is r15+r13 (recomputed since register may have been clobbered by the leaf verify loop -- actually alloc_bit_test preserves callee-save regs so r15 and r13 still hold their values, but recomputing is clearer). v2 (granted_len=r12) is pushed onto stack via [rsp+24] scratch (v2 must be at [rsp+8] relative to klog_s1_x2 entry per wrappers.pdx signature -- accomplished by `sub rsp, 8; push r12; call klog_s1_x2; add rsp, 16` bracketing since our frame already sits at rsp%16==0). (11) Emit verify fingerprint: klog_s1_x2 with tag_pdxb_alloc_verify_ok and same k=v pair -- second wire event fires only after step (9) confirmed every bit is set. (12) xor eax, eax (return 0); jmp done. exhausted: rax=ALLOC_EXHAUSTED (0xFFFFED10); jmp done. torn: rax=ALLOC_BITMAP_TORN (0xFFFFED11). done: add rsp, 24; 6-pop epilogue + ret. No test instruction; no mov_b. Reserved labels: alloc_er_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 24;

        // Frame: [rsp+0]=out_start_lba_ptr, [rsp+8]=out_granted_len_ptr,
        //        [rsp+16]=inode_row_ptr. 6 pushes (48 B) + sub 24 = 72;
        //        entry rsp%16==8 -> 80, %16==0.
        mov [rsp + 0], rdx;
        mov [rsp + 8], rcx;
        mov [rsp + 16], r8;

        mov rbx, rdi;

        // Cap want_len at ALLOC_EXTENT_RUN_MAX (= 8).
        mov r12, rsi;
        cmp r12, 8;
        jbe alloc_er_cap_done;
        mov r12, 8;

      alloc_er_cap_done:
        // want_len == 0 would let the scan trivially "find" a zero-length run
        // and then emit len_lba=0 fingerprints -- refuse instead.
        cmp r12, 0;
        je  alloc_er_exhausted;

        // Ensure the resident bitmap block is loaded.
        mov rdi, rbx;
        call alloc_bm_ensure_loaded;
        cmp rax, 0;
        jne alloc_er_torn;

        // Cache data_lba.
        lea r10, [rip + _alloc_state];
        mov r15, [r10 + 24];

        // Outer scan: rbp = i.
        xor rbp, rbp;

      alloc_er_outer:
        // (i + granted_len) <= 32768 ?
        mov rax, rbp;
        add rax, r12;
        cmp rax, 32768;
        ja  alloc_er_exhausted;

        // Inner: r14 = j; test bits [i, i+granted_len).
        xor r14, r14;

      alloc_er_inner:
        cmp r14, r12;
        jae alloc_er_found;

        mov rdi, rbp;
        add rdi, r14;
        call alloc_bit_test;
        cmp rax, 0;
        jne alloc_er_inner_bit_set;

        add r14, 1;
        jmp alloc_er_inner;

      alloc_er_inner_bit_set:
        // Conflict at (i + j): skip past the set bit -- i = i + j + 1.
        add rbp, r14;
        add rbp, 1;
        jmp alloc_er_outer;

      alloc_er_found:
        // r13 = start_i (freeze the run's first-bit index for later).
        mov r13, rbp;

        // Set every bit in [start_i, start_i + granted_len).
        xor r14, r14;

      alloc_er_set_top:
        cmp r14, r12;
        jae alloc_er_set_done;

        mov rdi, r13;
        add rdi, r14;
        call alloc_bit_set;

        add r14, 1;
        jmp alloc_er_set_top;

      alloc_er_set_done:
        // Durable writeback of the modified bitmap block via bdev_barrier_
        // write (records op_code=4/lba submission, then cap_invoke; same
        // durability posture as alloc_block).
        mov rdi, rbx;
        lea r10, [rip + _alloc_state];
        mov rsi, [r10 + 8];
        mov rdx, 1;
        lea rcx, [rip + _alloc_bm_buf];
        call bdev_barrier_write;
        mov rdi, rax;
        call bbjw_check;
        cmp rax, 0;
        jne alloc_er_torn;

        // Verify-post-condition: re-read every bit in the run and confirm
        // SET. Catches an encoder-time bit-set regression at emit time
        // (instead of downstream in a read path). torn on any zero.
        xor r14, r14;

      alloc_er_verify_top:
        cmp r14, r12;
        jae alloc_er_verify_done;

        mov rdi, r13;
        add rdi, r14;
        call alloc_bit_test;
        cmp rax, 0;
        je  alloc_er_torn;

        add r14, 1;
        jmp alloc_er_verify_top;

      alloc_er_verify_done:
        // start_lba = data_lba + start_i.
        mov r9, r15;
        add r9, r13;

        // Write outputs when caller-supplied pointers are non-zero.
        mov rax, [rsp + 0];
        cmp rax, 0;
        je  alloc_er_skip_out_start;
        mov [rax], r9;

      alloc_er_skip_out_start:
        mov rax, [rsp + 8];
        cmp rax, 0;
        je  alloc_er_skip_out_len;
        mov [rax], r12;

      alloc_er_skip_out_len:
        // Stamp inode extent slot 0 when inode_row_ptr != 0:
        //   packed = (granted_len << 48) | (start_lba & 0x0000FFFFFFFFFFFF).
        // The low-48-bit mask must be materialised via imm64 (bit-63 clear
        // does not save us here -- imm32 would only cover 31 bits and any
        // bit >=32 would then be lost). G4 encoder gap: use `mov r10, imm64`.
        mov rax, [rsp + 16];
        cmp rax, 0;
        je  alloc_er_skip_stamp;

        mov r10, 0x0000FFFFFFFFFFFF;
        mov r11, r9;
        and r11, r10;
        mov r10, r12;
        shl r10, 48;
        or  r11, r10;
        mov [rax + 48], r11;

      alloc_er_skip_stamp:
        // Fingerprint 1: klog_s1_x2(LEVEL_INFO=3, SUBSYS_FS__,
        //   tag_pdxb_alloc_ok, k_start_lba, start_lba, k_len_lba, granted_len).
        //
        // Alignment: frame currently at rsp%16==0. wrappers.pdx signature
        // has v2 at [rsp+8] on entry to klog_s1_x2 (pushed by caller).
        // `sub rsp,8; push r12; call; add rsp,16` keeps %16==0 across
        // the call.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_pdxb_alloc_ok];
        lea rcx, [rip + k_start_lba];
        mov r8, r9;
        lea r9, [rip + k_len_lba];
        sub rsp, 8;
        push r12;
        call klog_s1_x2;
        add rsp, 16;

        // Fingerprint 2: klog_s1_x2(..., tag_pdxb_alloc_verify_ok, ...).
        // start_lba recomputed since r9 was clobbered by k_len_lba lea +
        // klog internals; r13 (start_i) and r15 (data_lba) are callee-
        // save-preserved by klog_s1_x2 per SysV, so recomputation is safe.
        mov r9, r15;
        add r9, r13;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_pdxb_alloc_verify_ok];
        lea rcx, [rip + k_start_lba];
        mov r8, r9;
        lea r9, [rip + k_len_lba];
        sub rsp, 8;
        push r12;
        call klog_s1_x2;
        add rsp, 16;

        xor eax, eax;
        jmp alloc_er_done;

      alloc_er_exhausted:
        mov rax, 0xFFFFED10;
        jmp alloc_er_done;

      alloc_er_torn:
        mov rax, 0xFFFFED11;

      alloc_er_done:
        add rsp, 24;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
