// src/kernel/core/fs/pdxfs/superblock_fmt.pdx -- R52.M1-001 (#1681)
//
// PDXFS-ON-BLOCK v1 -- SUPERBLOCK FORMAT FREEZE (constants only).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// This module freezes the on-disk layout of the PdxFS-on-block v1
// superblock: magic, version, geometry, uuid, and the four region
// layout descriptors (inode table, block allocator, journal, data).
// It also freezes the M1 failure-taxonomy sub-band (0xFFFFED00..ED07)
// so downstream modules return stable, disjoint error codes from the
// first landing rather than inventing codes ad hoc at #1682+.
//
// Per design/filesystem/r52-implementation-plan.md §2.1: "#1681 --
// Freeze PDXB superblock at 4096 bytes ... this issue is a no-op on
// code." This file is the constants half of that freeze -- a passive
// data module with no functions, no BDEV I/O, and no control flow.
// #1682 lands `superblock.pdx`, the per-field accessor module (in the
// `pdxfs_lite/superblock.pdx` `sb_load_field_u64` / `sb_validate`
// idiom) that reads/writes these offsets against a live block buffer.
// #1686/#1687 (R52.M2) land the BDEV-backed `sb_read` / `sb_write`
// that actually persist a superblock.
//
// -----------------------------------------------------------------------------
// Authoritative source
// -----------------------------------------------------------------------------
//
// design/filesystem/volume-fs-substrate.md §2.1 "Superblock (LBA 0,
// exactly 4096 bytes)" is the single source of truth for this layout.
// Any offset or width change here requires a matching edit there plus
// a `version` bump (the substrate doc's own discipline: "Adding a
// field means bumping `version` and re-writing `sig`").
//
// -----------------------------------------------------------------------------
// Byte layout -- mirrors design/filesystem/volume-fs-substrate.md §2.1
// -----------------------------------------------------------------------------
//
//   Offset  Size  Field           Type       Notes
//   ------  ----  --------------  ---------  ------------------------------------
//   0       4     magic           u32 LE     0x42584450 = "PDXB"
//   4       4     version         u32 LE     1 at R52.M1
//   8       16    uuid            u8[16]     RFC 4122 v4; assigned at mkfs
//   24      4     block_size      u32 LE     4096; rejected at mount if different
//   28      4     flags           u32 LE     bit0 clean-unmount, bit1 root-volume,
//                                             bit2 read-only mount hint
//   32      8     total_blocks    u64 LE     total 4 KiB blocks the volume spans
//   40      8     itable_lba      u64 LE     first block of inode-table region
//   48      8     itable_bcount   u64 LE     inode-table span in blocks
//   56      8     alloc_lba       u64 LE     first block of allocator bitmap region
//   64      8     alloc_bcount    u64 LE     allocator bitmap span in blocks
//   72      8     journal_lba     u64 LE     first block of journal region
//   80      8     journal_bcount  u64 LE     journal span in blocks (WAL ring)
//   88      8     data_lba        u64 LE     first block of the data region
//   96      8     data_bcount     u64 LE     data-region span in blocks
//   104     8     root_inode      u64 LE     root directory inode index (v0: 1)
//   112     8     mount_gen       u64 LE     bumped on each mount
//   120     8     snap_head       u64 LE     reserved for R53 snapshot persistence
//   128     32    sig_key_hash    u8[32]     BLAKE3 fingerprint of signing pubkey
//   160     536   _reserved       u8[536]    zeroed at mkfs; must stay zero at mount
//   696     3400  sig             u8[3400]   ML-DSA-65 signature over [0, 696)
//   ------------
//   4096 = one 4 KiB block
//
// Backing storage: [u64; 512] = 4096 bytes exactly (matches the
// `pdxfs_lite/superblock.pdx` `_pdxfs_sb` idiom, @align(4096) for
// NVMe PRP1 single-page transfers).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// This module defines no functions and no labels. Downstream modules
// (#1682+) that consume these constants must prefix every label with
// their own function name -- do not use bare `if`, `loop`, `mount`,
// `fs`, `alloc`, `free` per feedback_paideia_as_version_discipline.md
// and design/filesystem/r52-implementation-plan.md §5.3.

module SuperblockFmt = structure {

  // ============================================================================
  // Superblock geometry constants -- frozen at R52.M1. Any change requires
  // a `version` bump (see design/filesystem/volume-fs-substrate.md §2.1).
  // ============================================================================

  pub let PDXB_SB_SIZE                    : u64 = 4096
  pub let PDXB_SB_QWORDS                  : u64 = 512

  // Magic = ASCII "PDXB" little-endian ("PdxFS Block-backed"; distinct
  // from the R25 lite-format's "PDXL"). Byte order:
  //   byte 0 = 'P' = 0x50
  //   byte 1 = 'D' = 0x44
  //   byte 2 = 'X' = 0x58
  //   byte 3 = 'B' = 0x42
  // As a u32 LE: 0x42584450.
  pub let PDXB_SB_MAGIC                    : u64 = 0x42584450
  pub let PDXB_SB_VERSION                  : u64 = 1
  pub let PDXB_SB_BLOCK_SIZE               : u64 = 4096

  // flags (offset 28) bit assignments.
  pub let PDXB_SB_FLAG_CLEAN_UNMOUNT       : u64 = 0x1    // bit0
  pub let PDXB_SB_FLAG_ROOT_VOLUME         : u64 = 0x2    // bit1
  pub let PDXB_SB_FLAG_READ_ONLY_HINT      : u64 = 0x4    // bit2

  // v0 discipline: root directory is always inode 1.
  pub let PDXB_SB_ROOT_INODE_DEFAULT       : u64 = 1

  // ============================================================================
  // Field offsets -- frozen; downstream (#1682 superblock.pdx, #1686
  // superblock_read.pdx, #1687 superblock_write.pdx) reads/writes via
  // these constants only. One line per field of
  // design/filesystem/volume-fs-substrate.md §2.1, in offset order.
  // ============================================================================

  pub let PDXB_SB_MAGIC_OFFSET          : u64 = 0      // u32
  pub let PDXB_SB_VERSION_OFFSET        : u64 = 4      // u32
  pub let PDXB_SB_UUID_OFFSET           : u64 = 8      // u8[16]
  pub let PDXB_SB_BLOCK_SIZE_OFFSET     : u64 = 24     // u32
  pub let PDXB_SB_FLAGS_OFFSET          : u64 = 28     // u32
  pub let PDXB_SB_TOTAL_BLOCKS_OFFSET   : u64 = 32     // u64
  pub let PDXB_SB_ITABLE_LBA_OFFSET     : u64 = 40     // u64
  pub let PDXB_SB_ITABLE_BCOUNT_OFFSET  : u64 = 48     // u64
  pub let PDXB_SB_ALLOC_LBA_OFFSET      : u64 = 56     // u64
  pub let PDXB_SB_ALLOC_BCOUNT_OFFSET   : u64 = 64     // u64
  pub let PDXB_SB_JOURNAL_LBA_OFFSET    : u64 = 72     // u64
  pub let PDXB_SB_JOURNAL_BCOUNT_OFFSET : u64 = 80     // u64
  pub let PDXB_SB_DATA_LBA_OFFSET       : u64 = 88     // u64
  pub let PDXB_SB_DATA_BCOUNT_OFFSET    : u64 = 96     // u64
  pub let PDXB_SB_ROOT_INODE_OFFSET     : u64 = 104    // u64
  pub let PDXB_SB_MOUNT_GEN_OFFSET      : u64 = 112    // u64
  pub let PDXB_SB_SNAP_HEAD_OFFSET      : u64 = 120    // u64
  pub let PDXB_SB_SIG_KEY_HASH_OFFSET   : u64 = 128    // u8[32]
  pub let PDXB_SB_SIG_KEY_HASH_LEN      : u64 = 32
  pub let PDXB_SB_RESERVED_OFFSET       : u64 = 160    // u8[536]
  pub let PDXB_SB_RESERVED_LEN          : u64 = 536
  pub let PDXB_SB_SIG_OFFSET            : u64 = 696    // u8[3400]
  pub let PDXB_SB_SIG_LEN               : u64 = 3400

  // sig_sign_scope: the byte range [start, end) the ML-DSA-65
  // signature covers. Excludes `sig` itself and excludes `_reserved`.
  // Adding a field means bumping `version` and re-writing `sig`
  // (design/filesystem/volume-fs-substrate.md §2.1 discipline note).
  pub let PDXB_SB_SIGN_SCOPE_START          : u64 = 0
  pub let PDXB_SB_SIGN_SCOPE_END            : u64 = 696

  // ============================================================================
  // M1 failure taxonomy -- 0xFFFFED00..0xFFFFED07 (8 codes).
  //
  // Disjoint sub-slice per design/filesystem/r52-implementation-plan.md
  // §4: bands ED08..ED4F are reserved for R52.M2..M8; bands ED30..ED3F,
  // ED50..ED9F, EDA0..EDBF, EDC0..EDFF remain owned by prior modules
  // (kind_user, kind_pdxfs_file, cicp, eotf, vello_renderer,
  // vello_scene). R52 code MUST NOT return a code outside its assigned
  // band. Ordering within the band: 000 = most-common expected error,
  // higher = rarer.
  //
  // These sentinels are frozen here (constants only) ahead of the
  // validation logic that returns them -- #1682+ wires the checks.
  // ============================================================================

  pub let PDXB_SB_MAGIC_BAD                : u64 = 0xFFFFED00
  pub let PDXB_SB_VERSION_BAD              : u64 = 0xFFFFED01
  pub let PDXB_SB_BLOCK_SIZE_BAD           : u64 = 0xFFFFED02
  pub let PDXB_SB_RESERVED_NONZERO         : u64 = 0xFFFFED03
  pub let PDXB_SB_TOTAL_BLOCKS_ZERO        : u64 = 0xFFFFED04
  pub let PDXB_SB_REGION_OVERLAP           : u64 = 0xFFFFED05
  pub let PDXB_SB_ROOT_INODE_INVALID       : u64 = 0xFFFFED06
  pub let PDXB_SB_SIG_SCOPE_INVALID        : u64 = 0xFFFFED07
}
