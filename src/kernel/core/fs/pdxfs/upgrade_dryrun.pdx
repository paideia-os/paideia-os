// src/kernel/core/fs/pdxfs/upgrade_dryrun.pdx -- R42.M4-002 (#1393)
//
// PDXFS LITE -> V1 UPGRADE -- DRY-RUN + REPORT.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on the READ-ONLY WALK a caller runs BEFORE
// committing to an in-place upgrade. Given a seeded source superblock,
// dry_walk produces a REPORT: block counts before/after, expected
// free-space delta (as a signed count of blocks, encoded as a u64
// two's-complement value), and an expected duration estimate. It
// touches ONLY the dry-run state buffer -- no _upg_sb write, no
// journal contact, no side effect the real upgrade would observe.
//
// It is a SCAFFOLD (D7). The source volume is a small BSS buffer
// (magic + block_count) seeded by the test path; a widening replaces
// it with a bounded scan of the legacy inode table. The scaffold's
// semantic (a "walk without writing, then answer four questions the
// caller must have answered before committing") is the semantic the
// widening preserves.
//
// It does NOT invoke UpgradeV1. Dry-run must NOT touch upgrade state,
// or the report would drift the moment a real upgrade landed. The
// cross-module witness composition still catches a caller that ran
// dry-run and then tried to commit against a different volume; this
// module refuses to answer without a fresh seed.
//
// It does NOT commit anything. dry_walk returns block counts and
// duration; a caller that wants to commit calls UpgradeV1.upg_upgrade
// separately, after re-seeding the upgrade path. The two modules do
// not share state on purpose.
//
// =============================================================================
// §1  REPORT ARITHMETIC
// =============================================================================
//
// blocks_before = source block count (as seeded).
// blocks_after  = blocks_before + DRY_SUPER_OVERHEAD + blocks_before
//                                                     * DRY_COW_OVERHEAD_NUM
//                                                     / DRY_COW_OVERHEAD_DEN
//
// For the scaffold: DRY_SUPER_OVERHEAD = 1 (one superblock swap
// journalled), DRY_COW_OVERHEAD_NUM = 1, DRY_COW_OVERHEAD_DEN = 4
// (one CoW head per four legacy inodes rounded down). The widening
// replaces these constants with per-volume numbers read from the
// journal capacity + the legacy inode density; the arithmetic on the
// scaffold side stays deterministic so the golden fingerprint is
// stable.
//
// free_delta_blocks = blocks_before (signed) - blocks_after (signed).
//                    Always <= 0 for a non-empty volume (upgrade uses
//                    more space than lite). Encoded as u64 two's-
//                    complement so callers can read it via dry_free_
//                    delta and inspect the sign bit.
//
// duration_estimate = blocks_before * DRY_DURATION_PER_BLOCK
//                     + DRY_DURATION_FIXED
//   with DRY_DURATION_PER_BLOCK = 8, DRY_DURATION_FIXED = 16. Units
//   are scaffold-abstract cycles; a widening will scale to microseconds
//   using the platform's frequency.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _dry_src and _dry_state are written only by helpers in this module.
// tools/build.sh confines relocations against each to
// `core/fs/pdxfs/upgrade_dryrun.o`. A second writer would let a caller
// "quiet a report by planting matching numbers", which would let a
// commit run against a volume the pre-flight walk never actually
// approved.
//
// STATE LAYOUT -- _dry_state : [u64; 8]
//   +0    init_mark          0x0D8A once dry_reset has run
//   +8    err                sticky error latch
//   +16   walked             0/1; every readback below refuses when 0
//   +24   blocks_before      as reported by the walk
//   +32   blocks_after       as computed from the walk
//   +40   free_delta_blocks  signed count in two's complement
//   +48   duration_estimate  see §1
//   +56   walk_count         cumulative dry_walk calls that returned OK
//
// SOURCE LAYOUT -- _dry_src : [u64; 4]
//   +0    magic              UPG_MAGIC_LITE or UPG_MAGIC_V1
//   +8    block_count        as seeded
//   +16   reserved
//   +24   reserved
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEF30..0xFFFFEF3F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: upgrade_v1 0xFFFFEF40..4F (R42.M4-001). Adjacent free band
// below: lite_reader 0xFFFFEF20..2F (R42.M4-003).
//
//   DRY_OK                    = 0
//   DRY_ERR_NOT_INIT          = 0xFFFFEF3F   accessor before dry_reset
//   DRY_ERR_NO_SOURCE         = 0xFFFFEF3E   walk before seed
//   DRY_ERR_BAD_MAGIC         = 0xFFFFEF3D   source not PdxFS-lite
//   DRY_ERR_ALREADY_V1        = 0xFFFFEF3C   source is already v1
//   DRY_ERR_NOT_WALKED        = 0xFFFFEF3B   report readback before walk
//   DRY_ERR_INTERNAL          = 0xFFFFEF3A   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `dry_`.

module UpgradeDryrun = structure {

  pub let DRY_MAGIC_LITE          : u64 = 0x504446534C31
  pub let DRY_MAGIC_V1            : u64 = 0x50444653563200

  pub let DRY_SUPER_OVERHEAD      : u64 = 1
  pub let DRY_COW_OVERHEAD_NUM    : u64 = 1
  pub let DRY_COW_OVERHEAD_DEN    : u64 = 4
  pub let DRY_DURATION_PER_BLOCK  : u64 = 8
  pub let DRY_DURATION_FIXED      : u64 = 16

  pub let DRY_OK                  : u64 = 0
  pub let DRY_ERR_NOT_INIT        : u64 = 0xFFFFEF3F
  pub let DRY_ERR_NO_SOURCE       : u64 = 0xFFFFEF3E
  pub let DRY_ERR_BAD_MAGIC       : u64 = 0xFFFFEF3D
  pub let DRY_ERR_ALREADY_V1      : u64 = 0xFFFFEF3C
  pub let DRY_ERR_NOT_WALKED      : u64 = 0xFFFFEF3B
  pub let DRY_ERR_INTERNAL        : u64 = 0xFFFFEF3A

  pub let DRY_INIT_MARK           : u64 = 0x0D8A

  pub let mut _dry_src   : [u64; 4] = uninit @align(64)
  pub let mut _dry_state : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Reset. Clears src + state; installs init_mark.
  // ==========================================================================

  pub let dry_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): clear src + state, install init_mark. Labels prefixed dry_rst_.",
      block: {
        lea r10, [rip + _dry_src];
        xor rax, rax;
        xor rcx, rcx;
      dry_rst_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  dry_rst_r;

        lea r10, [rip + _dry_state];
        xor rcx, rcx;
      dry_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dry_rst_s;

        mov rax, 0x0D8A;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let dry_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): 1 iff init_mark matches. Labels prefixed dry_bnd_.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 0];
        mov r11, 0x0D8A;
        cmp rax, r11;
        jne dry_bnd_no;
        mov rax, 1;
        ret;
      dry_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let dry_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): sticky error latch readback.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let dry_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): first-writer-wins error latch. Labels prefixed dry_se_.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne dry_se_out;
        mov [r10 + 8], rdi;
      dry_se_out:
        ret
      }
    }

  // ==========================================================================
  // Field readbacks (source).
  // ==========================================================================

  pub let dry_src_magic : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): source magic readback.",
      block: {
        lea r10, [rip + _dry_src];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let dry_src_blocks : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): source block_count readback.",
      block: {
        lea r10, [rip + _dry_src];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let dry_walk_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): walk_count field.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  pub let dry_is_walked : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): walked field.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  // ==========================================================================
  // Test seeder (scaffold only).
  // ==========================================================================

  pub let dry_seed : (u64, u64) -> u64 !{mem} @{} =
    fn (magic: u64, block_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): install a source. Labels prefixed dry_sd_.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 0];
        mov r11, 0x0D8A;
        cmp rax, r11;
        jne dry_sd_ni;

        lea r11, [rip + _dry_src];
        mov [r11 + 0], rdi;                       // magic
        mov [r11 + 8], rsi;                       // block_count
        // A re-seed invalidates any prior walk.
        xor rax, rax;
        mov [r10 + 16], rax;                      // walked <- 0
        mov [r10 + 24], rax;                      // blocks_before <- 0
        mov [r10 + 32], rax;                      // blocks_after <- 0
        mov [r10 + 40], rax;                      // free_delta_blocks <- 0
        mov [r10 + 48], rax;                      // duration_estimate <- 0
        mov rax, 1;
        ret;

      dry_sd_ni:
        mov rdi, 0xFFFFEF3F;
        call dry_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // dry_walk() -> u64
  //
  // Perform the dry-run walk against the seeded source. Preconditions:
  //   - initialised                     DRY_ERR_NOT_INIT
  //   - source magic != 0               DRY_ERR_NO_SOURCE
  //   - magic == DRY_MAGIC_V1           DRY_ERR_ALREADY_V1
  //   - magic == DRY_MAGIC_LITE         (else DRY_ERR_BAD_MAGIC)
  //
  // On success: computes the four report fields per §1, sets walked
  // <- 1, bumps walk_count, and returns blocks_before.
  //
  // Register plan: 2-push callee-save (rbx = blocks_before scratch).
  // ==========================================================================

  pub let dry_walk : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): dry-run + report. Labels prefixed dry_wk_.",
      block: {
        push rbx;
        push r12;

        lea r10, [rip + _dry_state];
        mov rax, [r10 + 0];
        mov r11, 0x0D8A;
        cmp rax, r11;
        jne dry_wk_ni;

        lea r11, [rip + _dry_src];
        mov rax, [r11 + 0];                       // magic
        cmp rax, 0;
        je  dry_wk_ns;

        mov r9, 0x50444653563200;
        cmp rax, r9;
        je  dry_wk_a1;

        mov r9, 0x504446534C31;
        cmp rax, r9;
        jne dry_wk_bm;

        // Compute the report.
        mov rbx, [r11 + 8];                       // blocks_before
        // blocks_after = blocks_before + 1 + blocks_before / 4.
        mov r12, rbx;
        shr r12, 2;                               // / 4
        mov rax, rbx;
        add rax, r12;
        add rax, 1;                               // + DRY_SUPER_OVERHEAD
        mov [r10 + 24], rbx;                      // blocks_before
        mov [r10 + 32], rax;                      // blocks_after

        // free_delta_blocks = blocks_before - blocks_after (signed).
        // With blocks_after > blocks_before this is negative; encode
        // as two's-complement u64.
        mov r9, rbx;
        sub r9, rax;                              // wraps on subtract
        mov [r10 + 40], r9;

        // duration_estimate = blocks_before * 8 + 16.
        mov r9, rbx;
        shl r9, 3;                                // * 8
        add r9, 16;
        mov [r10 + 48], r9;

        mov rax, 1;
        mov [r10 + 16], rax;                      // walked <- 1

        mov r9, [r10 + 56];
        add r9, 1;
        mov [r10 + 56], r9;                       // walk_count++

        mov rax, rbx;
        jmp dry_wk_out;

      dry_wk_ni:
        mov rdi, 0xFFFFEF3F;
        call dry_set_err;
        xor rax, rax;
        jmp dry_wk_out;
      dry_wk_ns:
        mov rdi, 0xFFFFEF3E;
        call dry_set_err;
        xor rax, rax;
        jmp dry_wk_out;
      dry_wk_bm:
        mov rdi, 0xFFFFEF3D;
        call dry_set_err;
        xor rax, rax;
        jmp dry_wk_out;
      dry_wk_a1:
        mov rdi, 0xFFFFEF3C;
        call dry_set_err;
        xor rax, rax;

      dry_wk_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Report readbacks -- refuse when walked == 0.
  // ==========================================================================

  pub let dry_blocks_before : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): blocks_before after walk. Labels prefixed dry_bb_.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 0];
        mov r11, 0x0D8A;
        cmp rax, r11;
        jne dry_bb_ni;
        mov rax, [r10 + 16];
        cmp rax, 0;
        je  dry_bb_nw;
        mov rax, [r10 + 24];
        ret;
      dry_bb_ni:
        mov rdi, 0xFFFFEF3F;
        call dry_set_err;
        xor rax, rax;
        ret;
      dry_bb_nw:
        mov rdi, 0xFFFFEF3B;
        call dry_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let dry_blocks_after : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): blocks_after after walk. Labels prefixed dry_ba_.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 0];
        mov r11, 0x0D8A;
        cmp rax, r11;
        jne dry_ba_ni;
        mov rax, [r10 + 16];
        cmp rax, 0;
        je  dry_ba_nw;
        mov rax, [r10 + 32];
        ret;
      dry_ba_ni:
        mov rdi, 0xFFFFEF3F;
        call dry_set_err;
        xor rax, rax;
        ret;
      dry_ba_nw:
        mov rdi, 0xFFFFEF3B;
        call dry_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let dry_free_delta : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): signed free_delta_blocks after walk. Labels prefixed dry_fd_.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 0];
        mov r11, 0x0D8A;
        cmp rax, r11;
        jne dry_fd_ni;
        mov rax, [r10 + 16];
        cmp rax, 0;
        je  dry_fd_nw;
        mov rax, [r10 + 40];
        ret;
      dry_fd_ni:
        mov rdi, 0xFFFFEF3F;
        call dry_set_err;
        xor rax, rax;
        ret;
      dry_fd_nw:
        mov rdi, 0xFFFFEF3B;
        call dry_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let dry_duration : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M4-002 (#1393): duration_estimate after walk. Labels prefixed dry_du_.",
      block: {
        lea r10, [rip + _dry_state];
        mov rax, [r10 + 0];
        mov r11, 0x0D8A;
        cmp rax, r11;
        jne dry_du_ni;
        mov rax, [r10 + 16];
        cmp rax, 0;
        je  dry_du_nw;
        mov rax, [r10 + 48];
        ret;
      dry_du_ni:
        mov rdi, 0xFFFFEF3F;
        call dry_set_err;
        xor rax, rax;
        ret;
      dry_du_nw:
        mov rdi, 0xFFFFEF3B;
        call dry_set_err;
        xor rax, rax;
        ret
      }
    }
}
