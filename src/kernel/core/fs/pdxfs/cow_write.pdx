// src/kernel/core/fs/pdxfs/cow_write.pdx -- R42.M1-003 (#1382)
//
// PDXFS v1 CoW WALKER -- WRITE PATH (allocate + copy + link).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WRITE HALF of the copy-on-write walker. On a write to a
// logical LBA the module resolves the current physical block via
// pxcr_read; if the refcount of that block is > 1 (SHARED across
// snapshots) it allocates a fresh physical block, copies the
// contents, and links the new block into the current snapshot's
// chain via pxcr_snapshot_map. If refcount == 1 (UNIQUE) the block
// is overwritten in place.
//
// It is a SCAFFOLD (D7). The block payload is a single u64 per
// physical block held in _pxcw_blocks. An on-disk backing widening
// (NVMe write path, #906) preserves the semantic: alloc-then-copy on
// SHARED, in-place on UNIQUE.
//
// It does NOT own the free list. cow_gc.pdx recovers physical blocks
// whose refcount drops to zero and returns them via its own free-list
// linkage; this module never recycles blocks -- pxcw_alloc_block is a
// monotonic bump allocator over PXCW_DEVICE_BLOCKS. A widening will
// consult the gc free list before bumping.
//
// It does NOT hash-verify writes. Verification is a widening -- a
// blake2s (or equivalent) digest per block written into a sidecar
// table -- deliberately deferred so the CoW invariant lands first
// and hash-check refusals are a separate story with their own witness.
//
// =============================================================================
// §1  BLOCK GEOMETRY
// =============================================================================
//
// PXCW_DEVICE_BLOCKS = 4096       physical blocks the scaffold owns.
// PXCW_BOOTSTRAP_BLK = 0          the block every fresh LBA resolves to
//                                  before any pxcw_write; refcount 1 by
//                                  convention. The witness primes this in
//                                  pxcw_reset.
//
// _pxcw_blocks layout: one u64 payload per block. mov [addr], val is the
// scaffold's "write"; memcpy semantics for a single word.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _pxcw_blocks and _pxcw_state are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/fs/pdxfs/cow_write.o`.
//
// STATE LAYOUT -- _pxcw_state : [u64; 8]
//   +0    init_mark        0xC1DE once pxcw_reset has run
//   +8    err              sticky error latch
//   +16   next_free_block  monotonic bump allocator cursor (starts at 1)
//   +24   write_count      total pxcw_write calls (both paths)
//   +32   cow_dupes        writes that took the SHARED path (allocate + copy)
//   +40   fast_paths       writes that took the UNIQUE path (in place)
//   +48   alloc_count      total pxcw_alloc_block calls
//   +56   reserved
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEFE0..0xFFFFEFEF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: cow_read 0xFFFFEFF0..FF (R42.M1-002). Adjacent used band
// below: cow_gc 0xFFFFEFD0..DF (R42.M1-004).
//
//   PXCW_OK                = 0
//   PXCW_ERR_NOT_INIT      = 0xFFFFEFEF   accessor before pxcw_reset
//   PXCW_ERR_OUT_OF_EXTENT = 0xFFFFEFEE   lba/blk >= PXCW_DEVICE_BLOCKS
//   PXCW_ERR_OOS           = 0xFFFFEFED   pxcw_alloc_block: bump cursor MAX
//   PXCW_ERR_READ_MISS     = 0xFFFFEFEC   pxcr_read returned NOT_FOUND
//   PXCW_ERR_BAD_SNAPSHOT  = 0xFFFFEFEB   snapshot_id == 0 or > snapshot_top
//   PXCW_ERR_MAP_FAIL      = 0xFFFFEFEA   pxcr_snapshot_map refused
//   PXCW_ERR_REFCOUNT_FAIL = 0xFFFFEFE9   pxrc_inc/pxrc_dec refused
//   PXCW_ERR_INTERNAL      = 0xFFFFEFE8   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `pxcw_`.

module CowWrite = structure {

  pub let PXCW_DEVICE_BLOCKS  : u64 = 4096
  pub let PXCW_BOOTSTRAP_BLK  : u64 = 0

  pub let PXCW_OK                : u64 = 0
  pub let PXCW_ERR_NOT_INIT      : u64 = 0xFFFFEFEF
  pub let PXCW_ERR_OUT_OF_EXTENT : u64 = 0xFFFFEFEE
  pub let PXCW_ERR_OOS           : u64 = 0xFFFFEFED
  pub let PXCW_ERR_READ_MISS     : u64 = 0xFFFFEFEC
  pub let PXCW_ERR_BAD_SNAPSHOT  : u64 = 0xFFFFEFEB
  pub let PXCW_ERR_MAP_FAIL      : u64 = 0xFFFFEFEA
  pub let PXCW_ERR_REFCOUNT_FAIL : u64 = 0xFFFFEFE9
  pub let PXCW_ERR_INTERNAL      : u64 = 0xFFFFEFE8

  pub let PXCW_INIT_MARK : u64 = 0xC1DE

  pub let mut _pxcw_blocks : [u64; 4096] = uninit @align(64)
  pub let mut _pxcw_state  : [u64; 8]    = uninit @align(64)

  // ==========================================================================
  // Reset. Clears block payload storage, state; installs init_mark and
  // primes next_free_block = 1 (block 0 is the shared bootstrap block
  // every fresh lba resolves to).
  // ==========================================================================

  pub let pxcw_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): clear blocks + state, install init_mark, prime next_free_block. Labels prefixed pxcw_rst_.",
      block: {
        lea r10, [rip + _pxcw_blocks];
        xor rax, rax;
        xor rcx, rcx;
      pxcw_rst_b:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4096;
        jb  pxcw_rst_b;

        lea r10, [rip + _pxcw_state];
        xor rcx, rcx;
      pxcw_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pxcw_rst_s;

        mov rax, 0xC1DE;
        mov [r10 + 0], rax;
        mov rax, 1;
        mov [r10 + 16], rax;                    // next_free_block := 1
        ret
      }
    }

  pub let pxcw_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): 1 iff init_mark matches. Labels prefixed pxcw_bnd_.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 0];
        mov r11, 0xC1DE;
        cmp rax, r11;
        jne pxcw_bnd_no;
        mov rax, 1;
        ret;
      pxcw_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let pxcw_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): sticky error latch readback.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let pxcw_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): first-writer-wins error latch. Labels prefixed pxcw_se_.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne pxcw_se_out;
        mov [r10 + 8], rdi;
      pxcw_se_out:
        ret
      }
    }

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let pxcw_next_free : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): next_free_block field.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let pxcw_write_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): write_count field.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let pxcw_cow_dupes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): cow_dupes field.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let pxcw_fast_paths : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): fast_paths field.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let pxcw_alloc_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): alloc_count field.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let pxcw_block_read : (u64) -> u64 !{mem} @{} =
    fn (blk: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): read a single block payload word. Refuses on out-of-extent. Labels prefixed pxcw_br_.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 0];
        mov r11, 0xC1DE;
        cmp rax, r11;
        jne pxcw_br_ni;

        cmp rdi, 4096;
        jae pxcw_br_oe;

        lea r11, [rip + _pxcw_blocks];
        mov rax, [r11 + rdi * 8];
        ret;

      pxcw_br_ni:
        mov rdi, 0xFFFFEFEF;
        call pxcw_set_err;
        xor rax, rax;
        ret;
      pxcw_br_oe:
        mov rdi, 0xFFFFEFEE;
        call pxcw_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pxcw_alloc_block() -> u64
  //
  // Bump-allocate a fresh physical block. Returns the new block id
  // (>= 1). Refuses:
  //   - not init                    PXCW_ERR_NOT_INIT
  //   - next_free_block == MAX      PXCW_ERR_OOS
  //
  // The allocator NEVER recycles. cow_gc.pdx maintains a free list a
  // widening will consult before this cursor bump; today the two paths
  // are independent so the CoW invariant is provable in isolation.
  // ==========================================================================

  pub let pxcw_alloc_block : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): bump-allocate a physical block. Labels prefixed pxcw_a_.",
      block: {
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 0];
        mov r11, 0xC1DE;
        cmp rax, r11;
        jne pxcw_a_ni;

        mov rax, [r10 + 16];                    // next_free_block
        cmp rax, 4096;
        jae pxcw_a_oos;

        mov r8, rax;                            // return value
        add rax, 1;
        mov [r10 + 16], rax;

        // alloc_count++
        mov r9, [r10 + 48];
        add r9, 1;
        mov [r10 + 48], r9;

        mov rax, r8;
        ret;

      pxcw_a_ni:
        mov rdi, 0xFFFFEFEF;
        call pxcw_set_err;
        xor rax, rax;
        ret;
      pxcw_a_oos:
        mov rdi, 0xFFFFEFED;
        call pxcw_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pxcw_write(snapshot_id, lba, payload) -> u64
  //
  // Write `payload` to the physical block backing `lba` in
  // `snapshot_id`. Two paths:
  //
  //   SHARED  (pxrc_get(cur_blk) > 1):
  //     alloc new_blk via pxcw_alloc_block
  //     copy payload from cur_blk into new_blk (single word)
  //     pxrc_dec(cur_blk); pxrc_inc(new_blk)
  //     pxcr_snapshot_map(snapshot_id, lba, new_blk)
  //     write payload into new_blk
  //     bump cow_dupes.
  //
  //   UNIQUE  (pxrc_get(cur_blk) == 1):
  //     write payload into cur_blk in place
  //     bump fast_paths.
  //
  // Refuses:
  //   - not init                    PXCW_ERR_NOT_INIT
  //   - lba >= PXCW_DEVICE_BLOCKS   PXCW_ERR_OUT_OF_EXTENT
  //   - snapshot_id == 0            PXCW_ERR_BAD_SNAPSHOT
  //   - pxcr_read failure           PXCW_ERR_READ_MISS
  //   - alloc failure               PXCW_ERR_OOS
  //   - pxrc_inc/dec failure        PXCW_ERR_REFCOUNT_FAIL
  //   - pxcr_snapshot_map failure   PXCW_ERR_MAP_FAIL
  //
  // Register plan: 6-push callee-save prologue (rbx = snapshot_id,
  // rbp = lba, r12 = payload, r13 = cur_blk, r14 = new_blk, r15 =
  // refcount cache). sub rsp, 8 keeps %16 == 0 across nested calls.
  // ==========================================================================

  pub let pxcw_write : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (snapshot_id: u64, lba: u64, payload: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M1-003 (#1382): decide SHARED vs UNIQUE via pxrc_get; on SHARED alloc + copy + refcount adjust + snapshot_map; on UNIQUE overwrite in place. Labels prefixed pxcw_w_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                           // snapshot_id
        mov rbp, rsi;                           // lba
        mov r12, rdx;                           // payload

        // Init check.
        lea r10, [rip + _pxcw_state];
        mov rax, [r10 + 0];
        mov r11, 0xC1DE;
        cmp rax, r11;
        jne pxcw_w_ni;

        // snapshot_id != 0
        cmp rbx, 0;
        je  pxcw_w_bs;

        // lba < PXCW_DEVICE_BLOCKS
        cmp rbp, 4096;
        jae pxcw_w_oe;

        // Resolve current block. rdi = lba.
        mov rdi, rbp;
        call pxcr_read;

        // pxcr_read returns error codes in the 0xFFFFEFF0..FF band.
        // Any value >= 0xFFFFF000 is treated as failure (matches the
        // taxonomy used repo-wide: only counts, block ids and payloads
        // live below that ceiling).
        mov r11, 0xFFFFEFF0;
        cmp rax, r11;
        jae pxcw_w_rm;

        mov r13, rax;                           // cur_blk

        // Refcount of cur_blk.
        mov rdi, r13;
        call pxrc_get;
        mov r11, 0xFFFFF000;
        cmp rax, r11;
        jae pxcw_w_rf;
        mov r15, rax;                           // rc

        // SHARED path: rc > 1.
        cmp r15, 1;
        ja  pxcw_w_shared;

        // ------------------ UNIQUE path ------------------
        // Overwrite cur_blk in place.
        lea r11, [rip + _pxcw_blocks];
        mov [r11 + r13 * 8], r12;

        // r10 was clobbered by pxcr_read + pxrc_get above (r10 is
        // caller-saved and both callees repoint it at their own
        // module state).  Reload it before touching _pxcw_state --
        // the SHARED path below has the same reload for the same
        // reason.
        lea r10, [rip + _pxcw_state];

        // fast_paths++
        mov r9, [r10 + 40];
        add r9, 1;
        mov [r10 + 40], r9;

        // write_count++
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;

        xor rax, rax;
        jmp pxcw_w_out;

      pxcw_w_shared:
        // ------------------ SHARED path ------------------
        call pxcw_alloc_block;
        mov r11, 0xFFFFF000;
        cmp rax, r11;
        jae pxcw_w_oos;
        mov r14, rax;                           // new_blk

        // Copy contents of cur_blk into new_blk. The write below
        // supersedes it, but the copy MATERIALISES the CoW invariant:
        // a subsequent partial-write widening (payload smaller than
        // block) will need the intact original bytes.
        lea r11, [rip + _pxcw_blocks];
        mov r9, [r11 + r13 * 8];
        mov [r11 + r14 * 8], r9;

        // pxrc_dec(cur_blk)
        mov rdi, r13;
        call pxrc_dec;
        mov r11, 0xFFFFF000;
        cmp rax, r11;
        jae pxcw_w_rf;

        // pxrc_inc(new_blk)
        mov rdi, r14;
        call pxrc_inc;
        mov r11, 0xFFFFF000;
        cmp rax, r11;
        jae pxcw_w_rf;

        // pxcr_snapshot_map(snapshot_id, lba, new_blk)
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r14;
        call pxcr_snapshot_map;
        cmp rax, 0;
        jne pxcw_w_mf;

        // Write payload into new_blk (overwrites the copied word).
        lea r11, [rip + _pxcw_blocks];
        mov [r11 + r14 * 8], r12;

        // cow_dupes++
        lea r10, [rip + _pxcw_state];
        mov r9, [r10 + 32];
        add r9, 1;
        mov [r10 + 32], r9;

        // write_count++
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;

        xor rax, rax;
        jmp pxcw_w_out;

      pxcw_w_ni:
        mov rdi, 0xFFFFEFEF;
        call pxcw_set_err;
        mov rax, 0xFFFFEFEF;
        jmp pxcw_w_out;
      pxcw_w_bs:
        mov rdi, 0xFFFFEFEB;
        call pxcw_set_err;
        mov rax, 0xFFFFEFEB;
        jmp pxcw_w_out;
      pxcw_w_oe:
        mov rdi, 0xFFFFEFEE;
        call pxcw_set_err;
        mov rax, 0xFFFFEFEE;
        jmp pxcw_w_out;
      pxcw_w_rm:
        mov rdi, 0xFFFFEFEC;
        call pxcw_set_err;
        mov rax, 0xFFFFEFEC;
        jmp pxcw_w_out;
      pxcw_w_oos:
        mov rdi, 0xFFFFEFED;
        call pxcw_set_err;
        mov rax, 0xFFFFEFED;
        jmp pxcw_w_out;
      pxcw_w_rf:
        mov rdi, 0xFFFFEFE9;
        call pxcw_set_err;
        mov rax, 0xFFFFEFE9;
        jmp pxcw_w_out;
      pxcw_w_mf:
        mov rdi, 0xFFFFEFEA;
        call pxcw_set_err;
        mov rax, 0xFFFFEFEA;

      pxcw_w_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pxcw_bdev_write_lba(vol_slot, bdev_cap, lba, buf_ptr) -> u64
  //
  // M7-003 (#1717): cache-mediated LBA write helper. This is the wiring
  // point named in design/filesystem/volume-fs-substrate.md §2.5 / §5.3
  // ("Wire cache into cow_read.pdx + cow_write.pdx"). PdxFS data-region
  // writes are WRITE-BACK per §5.3: fresh page data enters the per-volume
  // block cache and is marked dirty; the actual BD_OP_WRITE_LBA emission
  // is DEFERRED to M7-004 (#1718)'s flush cadence (every N=32 writes and
  // on cache pressure). The bdev_cap parameter is retained in the signature
  // for #1718 so that lands as a body-only diff -- no vops-side re-shape.
  //
  // Body -- composes the block_cache.pdx (#1715) API around the fact that
  // block_cache_mark_dirty takes a slot_ptr (returned from lookup/insert)
  // rather than (vol_slot, lba):
  //
  //   Fast path (already resident): block_cache_lookup returns a non-zero
  //   slot pointer. Copy the caller's 512 B into slot_ptr + BC_DATA_OFFSET
  //   (16), then block_cache_mark_dirty(slot_ptr). Skips the eviction
  //   probe cost of an insert.
  //
  //   Slow path (miss): block_cache_lookup returns 0. Call
  //   block_cache_insert(vol_slot, lba, buf_ptr) -- this copies our
  //   bytes into a slot the CLOCK hand reserves (may cascade a write-
  //   back on a dirty victim; that path already lives inside insert).
  //   On non-zero insert status, propagate (cache-insert failure --
  //   ALLOC_BITMAP_TORN 0xFFFFED11 -- has nothing left to mark dirty).
  //   On success, re-lookup to obtain the freshly-installed slot's
  //   pointer, then block_cache_mark_dirty(slot_ptr). A 0 return here
  //   would be an internal invariant break (insert-then-lookup miss);
  //   propagate as PXCW_ERR_INTERNAL (0xFFFFEFE8).
  //
  // Register plan: 6 callee-save pushes (rbx=vol_slot, rbp=bdev_cap,
  // r12=lba, r13=buf_ptr, r14=slot_ptr scratch, r15 unused for pattern
  // uniformity with pxcw_write) + sub rsp,8 pad leave rsp%16==0 across
  // every nested call (entry rsp%16==8, 6*8=48 -> 56, +8 -> 64, %16==0).
  // Nested: block_cache_lookup, block_cache_insert, block_cache_lookup,
  // block_cache_mark_dirty. Labels prefixed pxcw_bwl_.
  // ==========================================================================

  pub let pxcw_bdev_write_lba : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (vol_slot: u64, bdev_cap: u64, lba: u64, buf_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "M7-003 (#1717): write-back cache-mediated LBA write helper. See the section header above for the fast/slow-path body. Effects (!{mem, sysreg} @{cap}) propagate from block_cache_insert (block_cache.pdx #1715), which itself invokes BDEV_OP_WRITE_LBA via cap_invoke when the CLOCK hand lands on a dirty victim needing eviction write-back. bdev_cap (rsi) is preserved unread this milestone: #1718 will consume it when the deferred cadence-driven BD_OP_WRITE_LBA lands here. block_cache_mark_dirty takes slot_ptr (returned by lookup or via a follow-on lookup after insert), NOT (vol_slot, lba) -- the fast path avoids the insert eviction probe by memcpy-ing into an already-resident slot's data area at slot_ptr + BC_DATA_OFFSET(16). Six callee-save pushes + sub rsp,8 pad leave rsp%16==0 across every nested call (entry rsp%16==8, 6*8=48 -> 56, +8 -> 64, %16==0). Labels prefixed pxcw_bwl_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                          // vol_slot
        mov rbp, rsi;                          // bdev_cap (unused this milestone)
        mov r12, rdx;                          // lba
        mov r13, rcx;                          // buf_ptr

        // Probe cache for an existing resident slot.
        mov rdi, rbx;
        mov rsi, r12;
        call block_cache_lookup;
        cmp rax, 0;
        je  pxcw_bwl_miss;

        // Fast path: memcpy 512 B into slot_ptr + BC_DATA_OFFSET(16).
        mov r14, rax;                          // slot_ptr (kept for mark_dirty)
        mov r9, rax;
        add r9, 16;                            // r9 -> slot data area
        xor rcx, rcx;
      pxcw_bwl_hcp:
        mov rax, [r13 + rcx * 8];
        mov [r9 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  pxcw_bwl_hcp;

        // Mark dirty. block_cache_mark_dirty(slot_ptr) -> ().
        mov rdi, r14;
        call block_cache_mark_dirty;

        xor eax, eax;
        jmp pxcw_bwl_out;

      pxcw_bwl_miss:
        // Slow path: insert (copies our bytes into a reserved slot).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call block_cache_insert;
        cmp rax, 0;
        jne pxcw_bwl_out;

        // Re-lookup to obtain the freshly-installed slot's pointer for
        // mark_dirty. An insert-then-lookup miss would be an internal
        // invariant break (insert JUST wrote a valid slot for this
        // (vol_slot, lba)); propagate as PXCW_ERR_INTERNAL.
        mov rdi, rbx;
        mov rsi, r12;
        call block_cache_lookup;
        cmp rax, 0;
        je  pxcw_bwl_int;

        mov rdi, rax;
        call block_cache_mark_dirty;

        xor eax, eax;
        jmp pxcw_bwl_out;

      pxcw_bwl_int:
        mov rdi, 0xFFFFEFE8;                   // PXCW_ERR_INTERNAL
        call pxcw_set_err;
        mov rax, 0xFFFFEFE8;

      pxcw_bwl_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_block_write(vol_row, ino, offset, len, in_pa) -> u64
  //                                                        R55.M2-004 (#1786)
  //
  // Composed end-to-end write for a fresh (or in-place) block in a pdxfs-
  // block volume. Threads together the four R55.M2 primitives:
  //
  //   volume_row_device_slot  (kind_volume.pdx, #1703)  --> bdev_cap
  //   sb_read                  (superblock_read.pdx, #1686)  --> sb_ptr
  //   itable_init              (inode_table.pdx, #1698)
  //   inode_read               (inode_table.pdx, #1698)   --> inode row
  //   alloc_extent_run         (allocator.pdx,    #1783)   [if extent[0] absent]
  //   wal_append_write         (wal.pdx,           #1785)
  //   wal_fsync_bdev           (wal.pdx,           #1785)
  //   bdev_write_at            (bdev_write.pdx,    #1784)
  //   inode_table_write        (inode_table.pdx,   #1784)
  //   klog_s1_x3               (wrappers.pdx,      #686)
  //
  // Signature (per ticket #1786):
  //   vol_row   -- volume row id (0..15), indexes _wal_bdev_state and is
  //                also the input to volume_row_device_slot for bdev_cap
  //                resolution. Same integer parameter R55.M2-003 uses.
  //   ino       -- inode number (linear index into the on-disk inode
  //                table). Bound-checked downstream by inode_read (via
  //                _itable_state) and by inode_table_write (via sb_itable_
  //                bcount).
  //   offset    -- byte offset within the file where the write starts.
  //                M2-004 gate: MUST be 0 (see "Gaps" below).
  //   len       -- payload byte count. M2-004 gate: MUST be in (0, 4096].
  //   in_pa     -- physical address of the source page holding the len
  //                bytes to write. NVMe PRP1 requires page alignment for
  //                the single-page transfer; the caller is responsible
  //                (this function does not check).
  //
  // Returns 0 on success, else a sentinel:
  //   PDXB_WRITE_BAD_ARG   0xFFFFED0A   offset != 0 OR len == 0 OR len > 4096
  //   PDXB_WRITE_BAD_VOL   0xFFFFED0B   volume_row_device_slot returned
  //                                      VOL_DECODE_BAD (dead row)
  //   Any sub-primitive's own sentinel is forwarded verbatim (sb_read's
  //   PDXB_SB_* band, inode_read's INODE_* / reused ALLOC_BITMAP_TORN,
  //   alloc_extent_run's ALLOC_* band, wal_append_write / wal_fsync_bdev's
  //   WAL_ERR_* band, inode_table_write's INODE_INVALID_INDEX / reused
  //   ALLOC_BITMAP_TORN). No wrapper transform; the caller sees the
  //   originating band and can decide how to widen. Two new sentinels
  //   are minted in the M2 pdxfs-block band (0xFFFFED0A/29) for the two
  //   arg-gate refusals that no sub-primitive can produce.
  //
  // Composed flow (11 numbered steps per ticket §Scope):
  //   (1)  Gate offset==0 & 0<len<=4096 --- refuse with PDXB_WRITE_BAD_ARG.
  //   (2)  Substrate branch: if _nvme_io_queue_count == 0, jump directly
  //         to the fingerprint emit (skip every disk-touching step).
  //         Same posture the R55.M2-002 (inode_table_write) and
  //         R55.M2-003 (wal_fsync_bdev via bdev_write_at) primitives
  //         already establish --- the fingerprint fires cleanly whether
  //         the write reached hardware or not, so caller-side witnesses
  //         that run in substrate posture (every QEMU-TCG -kernel boot
  //         today) observe the composed attempt regardless.
  //   (3)  volume_row_device_slot(vol_row) --> bdev_cap. VOL_DECODE_BAD
  //         (0xFFFFFFFFFFFFFFFF) --> PDXB_WRITE_BAD_VOL.
  //   (4)  sb_read(bdev_cap) --> sb_ptr. Non-VMA return --> forward.
  //   (5)  itable_init(sb_ptr). Seeds _itable_state so the subsequent
  //         inode_read succeeds; itable_init always returns 0.
  //   (6)  inode_read(bdev_cap, ino) --> inode_ptr (into
  //         _itable_row_scratch). Non-VMA return --> forward.
  //   (7)  If inode_ptr[+48] (extent slot 0) == 0: allocate a single
  //         data block via alloc_extent_run(bdev_cap, want_len=1,
  //         out_start_lba_ptr=0, out_granted_len_ptr=0, inode_row_ptr).
  //         alloc_extent_run stamps the packed
  //         (granted_len << 48) | start_lba into inode_ptr[+48] itself.
  //         Non-zero return --> forward.
  //   (8)  data_lba = inode_ptr[+48] & 0x0000FFFFFFFFFFFF (low 48 bits =
  //         start_lba per §Allocator "Extent slot 0 stamping"). offset==0
  //         (gated in step 1), so the write hits data_lba directly with
  //         no in-block byte offset.
  //   (9)  wal_append_write(vol_row, data_lba, len, in_pa) --- records
  //         the pending write into the per-vol_row _wal_scratch slot.
  //         Silent on the wire. Non-zero --> forward.
  //   (10) wal_fsync_bdev(vol_row) --- flushes _wal_scratch via
  //         bdev_write_at, satisfying the WAL-fsync-before-data-write
  //         barrier bdev_write.pdx §0 explicitly refuses to enforce
  //         itself. Emits tag_pdxb_wal_fsynced_ok on success. Non-zero
  //         --> forward.
  //   (11) bdev_write_at(nsid=1, data_lba, count=1, in_pa) --- writes
  //         the caller's payload page to disk. Substrate-branched
  //         internally (returns 0 without touching the driver when
  //         _nvme_io_queue_count == 0, but we already substrate-
  //         short-circuited above so we reach this only in LIVE). Non-
  //         zero --> forward.
  //   (12) Update inode: byte_len (u64 @+16) = max(len, byte_len). Since
  //         offset==0 (gated), new_size == max(offset+len, byte_len) ==
  //         max(len, byte_len).
  //   (13) inode_table_write(nsid=1, sb_ptr, ino, inode_ptr) --- RMW
  //         persists the mutated inode row to disk. Emits
  //         tag_pdxb_inode_write_ok on success. Non-zero --> forward.
  //   (14) klog_s1_x3(LEVEL_INFO=3, SUBSYS_FS__, tag_pdxb_write_ok,
  //                    k_ino, ino, k_offset, 0, k_len, len).
  //
  //   Gap (deliberately deferred, per ticket): checkpoint advance is a
  //   no-op for M2-004 since wal_fsync_bdev already made this single
  //   record durable. A multi-record checkpoint chain lands at R56+.
  //
  // nsid = 1 hardcode. Same posture wal_fsync_bdev (R55.M2-003 / #1785)
  // establishes: the R55 kernel is a single-namespace boot; a widening
  // that admits multi-namespace threading of the (bdev_cap, nsid) pair
  // will need to update every hardcoded `mov rdi, 1` this file family
  // uses. Flagged uniformly rather than papered over here.
  //
  // sb_ptr is kept in r14 for the entire remaining flow (needed at
  // step 13 by inode_table_write). Re-lea'ing &_sb_read_buf from this
  // .o file would cross an ec_confine_one boundary (superblock_read.o
  // owns _sb_read_buf per tools/build.sh line ~5873) and land as a
  // build-time relocation refusal; keeping the sb_read return value in
  // a callee-save register avoids the cross-module symbol reference
  // entirely. inode_ptr (r15) similarly points at _itable_row_scratch,
  // which is confined to inode_table.o; same reason it stays in r15
  // after inode_read.
  //
  // bdev_cap is used only up to and including step 7 (alloc). It is
  // spilled to the stack frame's [rsp+0] slot rather than held in a
  // seventh callee-save register --- the 6 callee-save regs already
  // carry vol_row / ino / len / in_pa / sb_ptr / inode_ptr, and no
  // free callee-save register remains. sb_read / inode_read /
  // alloc_extent_run all take bdev_cap as their first arg; a stack
  // spill is cheaper than either re-calling volume_row_device_slot
  // three times or shuffling saved registers.
  //
  // Register discipline:
  //   6-push callee-save prologue (rbx=vol_row, rbp=ino, r12=len,
  //   r13=in_pa, r14=sb_ptr, r15=inode_ptr) + sub rsp,8 lands rsp%16==0
  //   (entry rsp%16==8 + 48 (6 pushes) + 8 = 64, %16==0) for every
  //   nested call. Frame [rsp+0] = bdev_cap spill. All nested callees
  //   preserve callee-save per SysV (volume_row_device_slot, sb_read,
  //   itable_init, inode_read, alloc_extent_run, wal_append_write,
  //   wal_fsync_bdev, bdev_write_at, inode_table_write, klog_s1_x3 --
  //   the emit's push convention layers on top without disturbing
  //   alignment; see the emit block for the sub 8 + 3 pushes = 32 B
  //   sandwich).
  //
  // Effects: !{mem, sysreg} @{cap}. Composes:
  //   mem     -- klog write, WAL append (memory-only), inode row mutation
  //   sysreg  -- NVMe I/O via bdev_write_at + inode_table_write's RMW
  //   cap     -- cap_invoke inside sb_read / inode_read / alloc_extent_run
  //
  // Failure semantics: every failure path returns WITHOUT emitting the
  // fingerprint. Success --- both LIVE and SUBSTRATE --- emits exactly
  // once. Matches ticket "Emit exactly once per successful composed op;
  // ANY failure path (bad ino, alloc exhaustion, WAL full, bdev error,
  // inode writeback error) bypasses emit and propagates the sentinel."
  //
  // Sub-primitive fingerprints (tag_pdxb_alloc_ok, tag_pdxb_wal_fsynced_
  // ok, tag_pdxb_inode_write_ok) also fire on the LIVE path --- that is
  // the wire event R55.M2-001/002/003 already own. The M2-004 golden
  // fixture (tests/r55/expected-r55-write-e2e.txt) matches only the
  // composed tag_pdxb_write_ok line as a substring; the sub-primitive
  // fingerprints are covered by their own R55.M2 goldens.
  //
  // Mount wire-up: DEFERRED to #1787 per the ticket's "extra check"
  // clause. The vops table (core/fs/pdxfs/vops_block.pdx, #1707) has
  // _pdxfs_block_write_stub returning MOUNT_BACKEND_UNKNOWN --- wiring
  // that stub to pdxfs_block_write requires a vnode-to-(vol_row, ino)
  // adapter that lands at R52.M8 (kind_pdxfs_txn.pdx family). This
  // primitive lands with a direct-call posture; the M2-005 smoke
  // (#1787) is the first caller.
  //
  // Reserved labels: pdxbw_.
  // ==========================================================================
  pub let pdxfs_block_write : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (vol_row: u64, ino: u64, offset: u64, len: u64, in_pa: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R55.M2-004 (#1786). Composed end-to-end write for a fresh (or in-place) block in a pdxfs-block volume. See the section header above for the full 14-step flow, register discipline, gap list, substrate posture, and mount-wire-up deferral. Short form: 6-push callee-save prologue (rbx=vol_row, rbp=ino, r12=len, r13=in_pa, r14=sb_ptr, r15=inode_ptr) + sub rsp,8 lands rsp%16==0 (entry rsp%16==8 + 48 + 8 = 64) for every nested call. Frame [rsp+0] = bdev_cap spill (no free 7th callee-save register). Body: (1) gate offset==0 & 0<len<=4096 else PDXB_WRITE_BAD_ARG. (2) substrate short-circuit: mov rax,[rip+_nvme_io_queue_count]; cmp rax,0; je pdxbw_emit. (3) volume_row_device_slot(vol_row); VOL_DECODE_BAD (0xFFFFFFFFFFFFFFFF via imm64 stage r10) --> PDXB_WRITE_BAD_VOL; spill result to [rsp+0]. (4) sb_read(bdev_cap); non-VMA (KERNEL_VMA_BASE=0xFFFF800000000000 via imm64 stage r10) --> forward; r14=sb_ptr. (5) itable_init(sb_ptr); always returns 0 (ignored). (6) inode_read(bdev_cap, ino); non-VMA --> forward; r15=inode_ptr. (7) if [r15+48]==0 alloc_extent_run(bdev_cap, 1, 0, 0, inode_ptr); non-zero --> forward. (8) data_lba = [r15+48] & 0x0000FFFFFFFFFFFF (low-48 via imm64 stage r10; bit-63-clear so bare imm32 would truncate the high nibbles --- G4 encoder gap, same pattern alloc_extent_run's own extent stamp uses). (9) wal_append_write(vol_row, data_lba, len, in_pa); non-zero --> forward. (10) wal_fsync_bdev(vol_row); non-zero --> forward. (11) bdev_write_at(1, data_lba, 1, in_pa); non-zero --> forward. (12) new_size = max(len, [r15+16]); [r15+16] = new_size. (13) inode_table_write(1, sb_ptr, ino, inode_ptr); non-zero --> forward. (14) klog_s1_x3(3, SUBSYS_FS__, tag_pdxb_write_ok, k_ino, ino, k_offset, 0, k_len, len). v2/k3/v3 stack push convention (per wrappers.pdx klog_s1_x3): [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3 post-call. Push in reverse (v3, k3, v2) with a leading sub rsp,8 pad; 3 pushes + 1 pad = 32 B keeps rsp%16==0 pre-call from the post-prologue rsp%16==0 (sub 8 -> %16==8, push -> 0, push -> 8, push -> 0). add rsp,32 undoes. Failure paths (pdxbw_bad_arg / pdxbw_bad_vol / pdxbw_forward) skip the emit and jump to pdxbw_done. All nested callees preserve callee-save per SysV; the emit does not clobber r14/r15 across its lifetime (klog_s1_x3 pushes/pops rbp only). No test instruction; no mov_b (byte_len is a whole-qword field at row+16; the size compare and update are register-level). Reserved labels: pdxbw_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 8;

        // Frame: [rsp+0] = bdev_cap spill.
        mov rbx, rdi;                           // vol_row
        mov rbp, rsi;                           // ino
        mov r12, rcx;                           // len
        mov r13, r8;                            // in_pa
        // rdx = offset (validated below; never stored -- gated to 0).

        // (1) Arg gate: offset == 0.
        cmp rdx, 0;
        jne pdxbw_bad_arg;

        // (1) Arg gate: len in (0, 4096].
        cmp r12, 0;
        je  pdxbw_bad_arg;
        mov r10, 4096;
        cmp r12, r10;
        ja  pdxbw_bad_arg;

        // (2) Substrate branch: no live NVMe IO SQ pair -> skip disk,
        //     still emit fingerprint (mirrors R55.M2-002/003 posture).
        mov rax, [rip + _nvme_io_queue_count];
        cmp rax, 0;
        je  pdxbw_emit;

        // (3) vol_row -> bdev_cap.
        mov rdi, rbx;
        call volume_row_device_slot;
        mov r10, 0xFFFFFFFFFFFFFFFF;             // VOL_DECODE_BAD (bit-63 set: imm64 stage)
        cmp rax, r10;
        je  pdxbw_bad_vol;
        mov [rsp + 0], rax;                      // spill bdev_cap

        // (4) sb_read(bdev_cap) -> sb_ptr | error sentinel.
        //     rax already holds bdev_cap; hand it straight through.
        mov rdi, rax;
        call sb_read;
        mov r10, 0xFFFF800000000000;             // KERNEL_VMA_BASE (imm64 stage)
        cmp rax, r10;
        jb  pdxbw_forward;
        mov r14, rax;                            // sb_ptr

        // (5) itable_init(sb_ptr). Always returns 0; rax ignored.
        mov rdi, r14;
        call itable_init;

        // (6) inode_read(bdev_cap, ino) -> inode_ptr | error sentinel.
        mov rdi, [rsp + 0];                      // bdev_cap
        mov rsi, rbp;                            // ino
        call inode_read;
        mov r10, 0xFFFF800000000000;
        cmp rax, r10;
        jb  pdxbw_forward;
        mov r15, rax;                            // inode_ptr (= &_itable_row_scratch)

        // (7) Allocate a single data block iff extent slot 0 is empty.
        //     extent[0] is at row offset +48 (packed: high 16 = len,
        //     low 48 = start_lba per §Allocator "Extent slot 0 stamping").
        mov rax, [r15 + 48];
        cmp rax, 0;
        jne pdxbw_have_extent;

        mov rdi, [rsp + 0];                      // bdev_cap
        mov rsi, 1;                              // want_len = 1 block (single-page write per M2-004 gate)
        xor rdx, rdx;                            // out_start_lba_ptr = 0 (unused)
        xor rcx, rcx;                            // out_granted_len_ptr = 0 (unused)
        mov r8, r15;                             // inode_row_ptr (stamps extent[0] in place)
        call alloc_extent_run;
        cmp rax, 0;
        jne pdxbw_forward;

      pdxbw_have_extent:
        // (8) data_lba = extent[0] & 0x0000_FFFF_FFFF_FFFF (low 48 bits).
        //     offset == 0 (gated), so no in-block byte offset to add.
        mov rax, [r15 + 48];
        mov r10, 0x0000FFFFFFFFFFFF;             // low-48 mask (imm64: high nibbles wouldn't survive imm32 sign-extension)
        and rax, r10;

        // (9) wal_append_write(vol_row, data_lba, len, in_pa).
        mov rdi, rbx;                            // vol_row
        mov rsi, rax;                            // data_lba
        mov rdx, r12;                            // len (byte count; wal_append refuses 0, records verbatim)
        mov rcx, r13;                            // in_pa (payload PA, referenced not embedded per §WAL record layout)
        call wal_append_write;
        cmp rax, 0;
        jne pdxbw_forward;

        // (10) wal_fsync_bdev(vol_row). Emits tag_pdxb_wal_fsynced_ok on
        //      success; substrate-branch happens inside bdev_write_at
        //      (already handled at step 2 for our composed emit).
        mov rdi, rbx;
        call wal_fsync_bdev;
        cmp rax, 0;
        jne pdxbw_forward;

        // (11) bdev_write_at(nsid=1, data_lba, count=1, in_pa).
        //      Recompute data_lba (rax clobbered by nested calls).
        mov rax, [r15 + 48];
        mov r10, 0x0000FFFFFFFFFFFF;
        and rax, r10;
        mov rdi, 1;                              // nsid (single-namespace boot per R55 posture)
        mov rsi, rax;                            // data_lba
        mov rdx, 1;                              // count = 1 block
        mov rcx, r13;                            // buf_pa
        call bdev_write_at;
        cmp rax, 0;
        jne pdxbw_forward;

        // (12) Update inode byte_len: new_size = max(len, byte_len).
        //      offset == 0 gated, so offset + len == len.
        //      Field at row offset +16 per the 128-B inode row layout.
        mov rax, [r15 + 16];                     // byte_len (existing)
        cmp rax, r12;                            // vs len
        jae pdxbw_size_kept;
        mov rax, r12;                            // new_size = len
      pdxbw_size_kept:
        mov [r15 + 16], rax;                     // stamp updated byte_len

        // (13) inode_table_write(nsid=1, sb_ptr, ino, inode_ptr).
        //      RMW read + splice + write; emits tag_pdxb_inode_write_ok
        //      on success.
        mov rdi, 1;                              // nsid
        mov rsi, r14;                            // sb_ptr
        mov rdx, rbp;                            // ino
        mov rcx, r15;                            // inode_ptr
        call inode_table_write;
        cmp rax, 0;
        jne pdxbw_forward;

      pdxbw_emit:
        // (14) klog_s1_x3(LEVEL_INFO=3, SUBSYS_FS__, tag_pdxb_write_ok,
        //                  k_ino, ino, k_offset, 0, k_len, len)
        //
        //      klog_s1_x3 caller-stack convention (wrappers.pdx line 137-146):
        //        [rsp+8]  = v2  (post-return-address push)
        //        [rsp+16] = k3
        //        [rsp+24] = v3
        //      Caller pushes in reverse: v3, k3, v2. From post-prologue
        //      rsp%16==0: sub 8 (pad) -> %16==8; push v3 -> 0; push k3 -> 8;
        //      push v2 -> 0 (aligned pre-call). add rsp, 32 undoes.
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + tag_pdxb_write_ok];
        lea rcx, [rip + k_ino];
        mov r8, rbp;                             // v1 = ino
        lea r9, [rip + k_offset];                // k2

        sub rsp, 8;                              // align pad
        push r12;                                // v3 = len
        lea r10, [rip + k_len];
        push r10;                                // k3 = &k_len
        xor r10, r10;
        push r10;                                // v2 = offset (always 0 per gate)
        call klog_s1_x3;
        add rsp, 32;                             // undo 3 pushes + pad

        xor eax, eax;
        jmp pdxbw_done;

      pdxbw_bad_arg:
        mov rax, 0xFFFFED0A;                     // PDXB_WRITE_BAD_ARG
        jmp pdxbw_done;

      pdxbw_bad_vol:
        mov rax, 0xFFFFED0B;                     // PDXB_WRITE_BAD_VOL
        jmp pdxbw_done;

      pdxbw_forward:
        // rax already holds the sub-primitive's forwarded error sentinel.

      pdxbw_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
