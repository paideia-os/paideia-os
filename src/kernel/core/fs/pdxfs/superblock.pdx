// src/kernel/core/fs/pdxfs/superblock.pdx — R52.M1-002 (#1682)
//
// PDXFS-ON-BLOCK v1 -- SUPERBLOCK ACCESSORS + M1 VALIDATORS.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Per design/filesystem/r52-implementation-plan.md §2.1 step 2: land the
// per-field accessor module for the 20 fields of §2.1, each accessor of
// the shape (sb_block_ptr) -> value, arity 1. Also `sb_sign_scope`.
//
// This module is a passive reader over an already-loaded 4 KiB superblock
// buffer (no BDEV I/O — that lands at R52.M2 in `superblock_read.pdx` /
// `superblock_write.pdx`, #1686/#1687). All offsets are hardcoded literals
// here, matching the numeric-literal-plus-comment convention already used
// throughout this kernel (see e.g. `pdxfs_lite/superblock.pdx`'s
// `sb_validate`, `cap/kind_ahci_port.pdx`'s local KIND_AHCI_PORT
// redeclaration) rather than a cross-file symbolic import — there is no
// precedent in this codebase for one .pdx module referencing another
// module's `pub let` constant by name, so offsets/sentinels are
// re-stated as literals with a comment citing the authoritative source:
// `src/kernel/core/fs/pdxfs/superblock_fmt.pdx` (#1681) and
// `design/filesystem/volume-fs-substrate.md` §2.1.
//
// This module also wires the 8 M1 failure-taxonomy codes
// (0xFFFFED00..ED07) that `superblock_fmt.pdx` froze as constants but
// deferred: "These sentinels are frozen here (constants only) ahead of
// the validation logic that returns them -- #1682+ wires the checks."
// #1682 is the only code-landing issue in M1 (#1681/#1683/#1684 are
// design-doc-only; #1685 is the boot witness that calls these
// accessors/validators) so the checks land here.
//
// -----------------------------------------------------------------------------
// Byte layout — mirrors superblock_fmt.pdx / volume-fs-substrate.md §2.1
// -----------------------------------------------------------------------------
//
//   Offset  Size  Field           Type       Notes
//   ------  ----  --------------  ---------  ------------------------------------
//   0       4     magic           u32 LE     0x42584450 = "PDXB"
//   4       4     version         u32 LE     1 at R52.M1
//   8       16    uuid            u8[16]     read as two u64 halves (lo @+8, hi @+16)
//   24      4     block_size      u32 LE     4096
//   28      4     flags           u32 LE     bit0/1/2 per §2.1
//   32      8     total_blocks    u64 LE
//   40      8     itable_lba      u64 LE
//   48      8     itable_bcount   u64 LE
//   56      8     alloc_lba       u64 LE
//   64      8     alloc_bcount    u64 LE
//   72      8     journal_lba     u64 LE
//   80      8     journal_bcount  u64 LE
//   88      8     data_lba        u64 LE
//   96      8     data_bcount     u64 LE
//   104     8     root_inode      u64 LE
//   112     8     mount_gen       u64 LE
//   120     8     snap_head       u64 LE
//   128     32    sig_key_hash    u8[32]     exposed as a pointer, not loaded
//   160     536   _reserved       u8[536]    scanned for all-zero (67 qwords)
//   696     3400  sig             u8[3400]   exposed as a pointer, not loaded
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §3.5/§5.1)
// -----------------------------------------------------------------------------
//
// Every getter below is arity 1 (sb_block_ptr) -> value. None approach the
// paideia-as arity-6 ceiling. `sb_sign_scope` packs its two logical return
// values (start, end) into one rax as `(end << 32) | start` rather than
// returning two values, per the plan's explicit guidance for this exact
// function. No field-write accessors land here — the plan's own scope
// line for #1682 lists only value-returning accessors ("(sb_block_ptr) ->
// value, arity 1"); bulk field population is `sb_populate_fields` at M2
// (#1687, `superblock_write.pdx`), which the plan separately flags for a
// `layout_descriptor_ptr` collapse to stay at arity 2.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// Every getter and every single-field validator (`sb_validate_*`) is a
// leaf: input in rdi, scratch in rax/rcx/r10/r11 (all caller-save per
// SysV AMD64), no nested `call`, no callee-save touched, no prologue.
// `sb_validate_all` is the one composite that issues nested calls, so it
// uses the 5-push callee-save prologue (rbx, r12, r13, r14, r15) this
// kernel uses uniformly for that shape (see `fs/vfs_read.pdx`,
// `fs/vfs_close.pdx`): 5 pushes from an SysV-entry rsp%16==8 land
// rsp%16==0, satisfying alignment for nested calls with no extra
// `sub rsp, 8`. rbx holds sb_block_ptr across every call; r12/r13/r14/r15
// are unused but kept pushed for the uniform pattern this kernel already
// establishes elsewhere.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity field in this module's accessor set requires
// `mov_b` (uuid/sig_key_hash/sig are all exposed as pointers or as
// u64-aligned halves, and `_reserved`'s scan reads whole qwords — 536 is
// evenly divisible by 8, so no byte tail remains). No `test` instruction
// anywhere; all zero/nonzero and bit-width checks use `cmp reg, 0` /
// `cmp reg, imm` + `je`/`jne`/`jb`/`ja`. Every label is prefixed with its
// owning function's full name (`sb_<fn>_<tag>`) to satisfy the reserved-
// label discipline and to guarantee uniqueness within this file (multiple
// functions in one paideia-as module share one label namespace — see
// `pdxfs_lite/alloc.pdx`'s per-function `pdxl_al_` / `pdxl_fr_` prefixes).
//
// -----------------------------------------------------------------------------
// Design-doc gap flagged (see final report to main)
// -----------------------------------------------------------------------------
//
// `sb_validate_sig_scope` / PDXB_SB_SIG_SCOPE_INVALID (0xFFFFED07): the
// sign scope [0, 696) is a pair of compile-time constants
// (PDXB_SB_SIGN_SCOPE_START/END in superblock_fmt.pdx), not an on-disk
// field. At v1 there is no way for this check to actually fail — it
// exists so the sentinel is wired now and stays meaningful if a future
// version ever makes the scope end computed from a field (e.g. a
// version-dependent reserved-region shrink). Flagged for softarch to
// confirm at R52.M2+ whether this stays a defensive no-op check or gets
// removed until a versioned scope is designed.

module Superblock = structure {

  // ============================================================================
  // sb_magic(sb: *superblock) -> u32 (magic, zero-extended into rax)
  // ============================================================================
  pub let sb_magic : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u32 magic @+0 (superblock_fmt.pdx PDXB_SB_MAGIC_OFFSET). mov_d zero-extends into rax per the encoder's proven behavior (pdxfs_lite/superblock.pdx sb_validate L141). Leaf, no callee-save touched.",
      block: {
        mov_d rax, [rdi + 0];
        ret
      }
    }

  // ============================================================================
  // sb_version(sb: *superblock) -> u32 (version, zero-extended into rax)
  // ============================================================================
  pub let sb_version : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u32 version @+4 (PDXB_SB_VERSION_OFFSET). Leaf.",
      block: {
        mov_d rax, [rdi + 4];
        ret
      }
    }

  // ============================================================================
  // sb_uuid_lo(sb: *superblock) -> u64 (uuid bytes [0..8) @+8)
  // ============================================================================
  pub let sb_uuid_lo : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load low 8 bytes of the 16-byte uuid field @+8 (PDXB_SB_UUID_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }

  // ============================================================================
  // sb_uuid_hi(sb: *superblock) -> u64 (uuid bytes [8..16) @+16)
  // ============================================================================
  pub let sb_uuid_hi : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load high 8 bytes of the 16-byte uuid field @+16 (PDXB_SB_UUID_OFFSET + 8). Leaf.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  // ============================================================================
  // sb_block_size(sb: *superblock) -> u32 (block_size, zero-extended)
  // ============================================================================
  pub let sb_block_size : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u32 block_size @+24 (PDXB_SB_BLOCK_SIZE_OFFSET). Leaf.",
      block: {
        mov_d rax, [rdi + 24];
        ret
      }
    }

  // ============================================================================
  // sb_flags(sb: *superblock) -> u32 (flags, zero-extended)
  // ============================================================================
  pub let sb_flags : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u32 flags @+28 (PDXB_SB_FLAGS_OFFSET). Bit assignments (bit0 clean-unmount, bit1 root-volume, bit2 read-only hint) are decoded by callers via `and rax, MASK` — this accessor returns the raw field. Leaf.",
      block: {
        mov_d rax, [rdi + 28];
        ret
      }
    }

  // ============================================================================
  // sb_total_blocks(sb: *superblock) -> u64 (@+32)
  // ============================================================================
  pub let sb_total_blocks : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 total_blocks @+32 (PDXB_SB_TOTAL_BLOCKS_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 32];
        ret
      }
    }

  // ============================================================================
  // sb_itable_lba(sb: *superblock) -> u64 (@+40)
  // ============================================================================
  pub let sb_itable_lba : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 itable_lba @+40 (PDXB_SB_ITABLE_LBA_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 40];
        ret
      }
    }

  // ============================================================================
  // sb_itable_bcount(sb: *superblock) -> u64 (@+48)
  // ============================================================================
  pub let sb_itable_bcount : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 itable_bcount @+48 (PDXB_SB_ITABLE_BCOUNT_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 48];
        ret
      }
    }

  // ============================================================================
  // sb_alloc_lba(sb: *superblock) -> u64 (@+56)
  // ============================================================================
  pub let sb_alloc_lba : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 alloc_lba @+56 (PDXB_SB_ALLOC_LBA_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 56];
        ret
      }
    }

  // ============================================================================
  // sb_alloc_bcount(sb: *superblock) -> u64 (@+64)
  // ============================================================================
  pub let sb_alloc_bcount : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 alloc_bcount @+64 (PDXB_SB_ALLOC_BCOUNT_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 64];
        ret
      }
    }

  // ============================================================================
  // sb_journal_lba(sb: *superblock) -> u64 (@+72)
  // ============================================================================
  pub let sb_journal_lba : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 journal_lba @+72 (PDXB_SB_JOURNAL_LBA_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 72];
        ret
      }
    }

  // ============================================================================
  // sb_journal_bcount(sb: *superblock) -> u64 (@+80)
  // ============================================================================
  pub let sb_journal_bcount : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 journal_bcount @+80 (PDXB_SB_JOURNAL_BCOUNT_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 80];
        ret
      }
    }

  // ============================================================================
  // sb_data_lba(sb: *superblock) -> u64 (@+88)
  // ============================================================================
  pub let sb_data_lba : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 data_lba @+88 (PDXB_SB_DATA_LBA_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 88];
        ret
      }
    }

  // ============================================================================
  // sb_data_bcount(sb: *superblock) -> u64 (@+96)
  // ============================================================================
  pub let sb_data_bcount : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 data_bcount @+96 (PDXB_SB_DATA_BCOUNT_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 96];
        ret
      }
    }

  // ============================================================================
  // sb_root_inode(sb: *superblock) -> u64 (@+104)
  // ============================================================================
  pub let sb_root_inode : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 root_inode @+104 (PDXB_SB_ROOT_INODE_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 104];
        ret
      }
    }

  // ============================================================================
  // sb_mount_gen(sb: *superblock) -> u64 (@+112)
  // ============================================================================
  pub let sb_mount_gen : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 mount_gen @+112 (PDXB_SB_MOUNT_GEN_OFFSET). Leaf.",
      block: {
        mov rax, [rdi + 112];
        ret
      }
    }

  // ============================================================================
  // sb_snap_head(sb: *superblock) -> u64 (@+120)
  // ============================================================================
  pub let sb_snap_head : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Load u64 snap_head @+120 (PDXB_SB_SNAP_HEAD_OFFSET). Reserved for R53 snapshot persistence; zero at R52 mkfs. Leaf.",
      block: {
        mov rax, [rdi + 120];
        ret
      }
    }

  // ============================================================================
  // sb_sig_key_hash_ptr(sb: *superblock) -> u64 (&sig_key_hash, @+128)
  //   Pointer accessor, not a load — sig_key_hash is a 32-byte BLAKE3
  //   fingerprint, too wide to return by value. Callers dereference.
  // ============================================================================
  pub let sb_sig_key_hash_ptr : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Return &sb[128] (PDXB_SB_SIG_KEY_HASH_OFFSET), the 32-byte BLAKE3 pubkey fingerprint. Address-only; no load — width (32 B) exceeds a register. Leaf, no memory actually touched by this function itself (marked mem conservatively since the returned pointer is dereferenced by callers, matching pdxfs_lite/superblock.pdx sb_scratch_addr's convention).",
      block: {
        mov rax, rdi;
        add rax, 128;
        ret
      }
    }

  // ============================================================================
  // sb_reserved_scan(sb: *superblock) -> u64
  //   0 if all 536 reserved bytes @+160 are zero, 1 if any is nonzero.
  //   536 / 8 = 67 qwords exactly — no byte tail, no mov_b needed.
  // ============================================================================
  pub let sb_reserved_scan : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). OR-accumulate all 67 qwords of _reserved [160, 696) (PDXB_SB_RESERVED_OFFSET/_LEN) into rax, then report zero/nonzero via cmp+je (no `test`). Body: (1) xor rax,rax (accumulator). (2) xor rcx,rcx (qword index). (3) mov r10, rdi; add r10, 160 (&_reserved[0]). (4) sb_reserved_scan_top: cmp rcx, 67; jae sb_reserved_scan_done. (5) mov r11, [r10]; or rax, r11; add r10, 8; add rcx, 1; jmp sb_reserved_scan_top. (6) sb_reserved_scan_done: cmp rax, 0; je sb_reserved_scan_zero; mov rax, 1; ret. (7) sb_reserved_scan_zero: xor eax, eax; ret. Leaf; caller-save scratch only (rax/rcx/r10/r11). Reserved labels: sb_reserved_scan_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        mov r10, rdi;
        add r10, 160;

      sb_reserved_scan_top:
        cmp rcx, 67;
        jae sb_reserved_scan_done;
        mov r11, [r10];
        or rax, r11;
        add r10, 8;
        add rcx, 1;
        jmp sb_reserved_scan_top;

      sb_reserved_scan_done:
        cmp rax, 0;
        je sb_reserved_scan_zero;
        mov rax, 1;
        ret;

      sb_reserved_scan_zero:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_sig_ptr(sb: *superblock) -> u64 (&sig, @+696)
  //   Pointer accessor — sig is 3400 bytes (ML-DSA-65), far too wide to
  //   return by value.
  // ============================================================================
  pub let sb_sig_ptr : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Return &sb[696] (PDXB_SB_SIG_OFFSET), the 3400-byte ML-DSA-65 signature over bytes [0, 696). Address-only; no load. Leaf.",
      block: {
        mov rax, rdi;
        add rax, 696;
        ret
      }
    }

  // ============================================================================
  // sb_sign_scope(sb: *superblock) -> u64 packed (end_off << 32) | start_off
  //   start_off = 0, end_off = 696 (PDXB_SB_SIGN_SCOPE_START/END) — both
  //   compile-time constants per §2.1's freeze, independent of sb's actual
  //   contents. sb is still accepted (arity 1) to match the plan's
  //   `sb_sign_scope(sb_ptr)` signature and to keep every accessor in this
  //   module uniform over (sb_block_ptr) -> value, even though the body
  //   does not dereference it. Two logical return values are packed per
  //   the plan's explicit "returns two values" arity note (§2.1 hazards).
  // ============================================================================
  pub let sb_sign_scope : (u64) -> u64 !{} @{} =
    fn (sb: u64) -> unsafe {
      effects: {},
      capabilities: {},
      justification: "R52-M1-002 (#1682). Pack (end_off=696, start_off=0) into one rax as (end << 32) | start, per the plan's arity-hazard guidance for a 2-value return. Since start_off is 0, the OR is a no-op and only the shift matters. Body: mov rax, 696; shl rax, 32; ret. No memory touched — pure constant computation, sb (rdi) unused. Leaf.",
      block: {
        mov rax, 696;
        shl rax, 32;
        ret
      }
    }

  // ============================================================================
  // sb_validate_magic(sb: *superblock) -> u64
  //   0 on match, else PDXB_SB_MAGIC_BAD (0xFFFFED00).
  // ============================================================================
  pub let sb_validate_magic : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_MAGIC_BAD (superblock_fmt.pdx). Body: mov_d rax, [rdi+0]; cmp rax, 0x42584450; je ok; mov rax, 0xFFFFED00; ret; ok: xor eax,eax; ret. cmp against 0x42584450 is safe as an imm32 (bit31 clear, no sign-extension hazard) per cap_handler_blkdev.pdx's documented convention for small-magnitude immediates. Leaf. Reserved labels: sb_validate_magic_.",
      block: {
        mov_d rax, [rdi + 0];
        cmp rax, 0x42584450;
        je sb_validate_magic_ok;
        mov rax, 0xFFFFED00;
        ret;

      sb_validate_magic_ok:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_validate_version(sb: *superblock) -> u64
  //   0 on match (version == 1), else PDXB_SB_VERSION_BAD (0xFFFFED01).
  // ============================================================================
  pub let sb_validate_version : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_VERSION_BAD. Body: mov_d rax, [rdi+4]; cmp rax, 1; je ok; mov rax, 0xFFFFED01; ret; ok: xor eax,eax; ret. Leaf. Reserved labels: sb_validate_version_.",
      block: {
        mov_d rax, [rdi + 4];
        cmp rax, 1;
        je sb_validate_version_ok;
        mov rax, 0xFFFFED01;
        ret;

      sb_validate_version_ok:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_validate_block_size(sb: *superblock) -> u64
  //   0 on match (block_size == 4096), else PDXB_SB_BLOCK_SIZE_BAD (0xFFFFED02).
  // ============================================================================
  pub let sb_validate_block_size : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_BLOCK_SIZE_BAD. Body: mov_d rax, [rdi+24]; cmp rax, 4096; je ok; mov rax, 0xFFFFED02; ret; ok: xor eax,eax; ret. Leaf. Reserved labels: sb_validate_block_size_.",
      block: {
        mov_d rax, [rdi + 24];
        cmp rax, 4096;
        je sb_validate_block_size_ok;
        mov rax, 0xFFFFED02;
        ret;

      sb_validate_block_size_ok:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_validate_reserved(sb: *superblock) -> u64
  //   0 if all 536 _reserved bytes @+160 are zero, else PDXB_SB_RESERVED_NONZERO
  //   (0xFFFFED03). Inlines the same qword-scan as sb_reserved_scan (kept
  //   leaf rather than calling out, avoiding any nested-call alignment
  //   bookkeeping for a 6-instruction loop).
  // ============================================================================
  pub let sb_validate_reserved : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_RESERVED_NONZERO. Body: same 67-qword OR-accumulate loop as sb_reserved_scan (see that function's justification for the per-step encoding), terminating in `cmp rax,0; je ok; mov rax,0xFFFFED03; ret; ok: xor eax,eax; ret` instead of the 0/1 sentinel. Leaf. Reserved labels: sb_validate_reserved_.",
      block: {
        xor rax, rax;
        xor rcx, rcx;
        mov r10, rdi;
        add r10, 160;

      sb_validate_reserved_top:
        cmp rcx, 67;
        jae sb_validate_reserved_done;
        mov r11, [r10];
        or rax, r11;
        add r10, 8;
        add rcx, 1;
        jmp sb_validate_reserved_top;

      sb_validate_reserved_done:
        cmp rax, 0;
        je sb_validate_reserved_ok;
        mov rax, 0xFFFFED03;
        ret;

      sb_validate_reserved_ok:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_validate_total_blocks(sb: *superblock) -> u64
  //   0 if total_blocks != 0, else PDXB_SB_TOTAL_BLOCKS_ZERO (0xFFFFED04).
  // ============================================================================
  pub let sb_validate_total_blocks : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_TOTAL_BLOCKS_ZERO. Body: mov rax, [rdi+32]; cmp rax, 0; jne ok; mov rax, 0xFFFFED04; ret; ok: xor eax,eax; ret. Leaf. Reserved labels: sb_validate_total_blocks_.",
      block: {
        mov rax, [rdi + 32];
        cmp rax, 0;
        jne sb_validate_total_blocks_ok;
        mov rax, 0xFFFFED04;
        ret;

      sb_validate_total_blocks_ok:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_validate_regions(sb: *superblock) -> u64
  //   0 if the four regions (itable, alloc, journal, data) are disjoint,
  //   in-order, start at/after LBA 1 (LBA 0 is the superblock itself), and
  //   the data region does not run past total_blocks; else
  //   PDXB_SB_REGION_OVERLAP (0xFFFFED05).
  //
  //   Checks (all u64, no signed-immediate hazard — every cmp compares
  //   two registers, never a large literal against a register):
  //     (a) itable_lba >= 1
  //     (b) alloc_lba   >= itable_lba  + itable_bcount
  //     (c) journal_lba >= alloc_lba   + alloc_bcount
  //     (d) data_lba    >= journal_lba + journal_bcount
  //     (e) data_lba + data_bcount <= total_blocks
  // ============================================================================
  pub let sb_validate_regions : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_REGION_OVERLAP. Sequential pairwise checks, reloading fields from rdi each step (leaf, no calls, rdi never overwritten): (a) rax=[rdi+40] (itable_lba); cmp rax,1; jb bad. (b) rcx=[rdi+48] (itable_bcount); add rax,rcx (itable_end); rcx=[rdi+56] (alloc_lba); cmp rcx,rax; jb bad. (c) rax=rcx (alloc_lba); rcx=[rdi+64] (alloc_bcount); add rax,rcx (alloc_end); rcx=[rdi+72] (journal_lba); cmp rcx,rax; jb bad. (d) rax=rcx (journal_lba); rcx=[rdi+80] (journal_bcount); add rax,rcx (journal_end); rcx=[rdi+88] (data_lba); cmp rcx,rax; jb bad. (e) rax=rcx (data_lba); rcx=[rdi+96] (data_bcount); add rax,rcx (data_end); rcx=[rdi+32] (total_blocks); cmp rax,rcx; ja bad. Else xor eax,eax; ret. bad: mov rax,0xFFFFED05; ret. jb/ja proven throughout (pdxfs_lite/alloc.pdx L350, pdxfs_lite/read.pdx L135). Leaf; scratch rax/rcx only. Reserved labels: sb_validate_regions_.",
      block: {
        // (a) itable_lba >= 1 (LBA 0 is reserved for the superblock)
        mov rax, [rdi + 40];
        cmp rax, 1;
        jb sb_validate_regions_bad;

        // (b) alloc_lba >= itable_end
        mov rcx, [rdi + 48];
        add rax, rcx;
        mov rcx, [rdi + 56];
        cmp rcx, rax;
        jb sb_validate_regions_bad;

        // (c) journal_lba >= alloc_end
        mov rax, rcx;
        mov rcx, [rdi + 64];
        add rax, rcx;
        mov rcx, [rdi + 72];
        cmp rcx, rax;
        jb sb_validate_regions_bad;

        // (d) data_lba >= journal_end
        mov rax, rcx;
        mov rcx, [rdi + 80];
        add rax, rcx;
        mov rcx, [rdi + 88];
        cmp rcx, rax;
        jb sb_validate_regions_bad;

        // (e) data_end <= total_blocks
        mov rax, rcx;
        mov rcx, [rdi + 96];
        add rax, rcx;
        mov rcx, [rdi + 32];
        cmp rax, rcx;
        ja sb_validate_regions_bad;

        xor eax, eax;
        ret;

      sb_validate_regions_bad:
        mov rax, 0xFFFFED05;
        ret
      }
    }

  // ============================================================================
  // sb_validate_root_inode(sb: *superblock) -> u64
  //   0 if root_inode == 1 (v0 discipline: root directory is always inode
  //   1, per §2.1/§2.3), else PDXB_SB_ROOT_INODE_INVALID (0xFFFFED06).
  // ============================================================================
  pub let sb_validate_root_inode : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_ROOT_INODE_INVALID. Body: mov rax, [rdi+104]; cmp rax, 1; je ok; mov rax, 0xFFFFED06; ret; ok: xor eax,eax; ret. v0 discipline fixes root_inode at 1 (PDXB_SB_ROOT_INODE_DEFAULT); a future multi-root design would need a version bump per the frozen-format discipline. Leaf. Reserved labels: sb_validate_root_inode_.",
      block: {
        mov rax, [rdi + 104];
        cmp rax, 1;
        je sb_validate_root_inode_ok;
        mov rax, 0xFFFFED06;
        ret;

      sb_validate_root_inode_ok:
        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // sb_validate_sig_scope(sb: *superblock) -> u64
  //   0 if the frozen sign scope is (start=0, end=696), else
  //   PDXB_SB_SIG_SCOPE_INVALID (0xFFFFED07).
  //
  //   NOTE (design-doc gap, flagged to main/softarch): at v1 both bounds
  //   are compile-time constants (PDXB_SB_SIGN_SCOPE_START/END), not
  //   on-disk fields, so this check cannot actually observe a bad value
  //   today. It is wired now — via sb_sign_scope — so the sentinel is
  //   meaningful the moment a future version makes the scope
  //   field-dependent, without a second freeze-and-wire round.
  // ============================================================================
  pub let sb_validate_sig_scope : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Wire PDXB_SB_SIG_SCOPE_INVALID. Body: push rbx; mov rbx, rdi (sb ptr, unused by sb_sign_scope but kept for ABI uniformity/pattern match); call sb_sign_scope -> rax = (696<<32)|0. mov r10, rax; shr r10, 32 (end, top half); cmp r10, 696; jne bad. mov r11, rax; shl r11, 32; shr r11, 32 (isolate low 32 bits = start, zero-extended — deliberately NOT `and r11, 0xFFFFFFFF`: that immediate has bit31 set and AND r64,imm32 sign-extends it to all-ones, silently no-op'ing the mask; the shl-then-shr round trip avoids that hazard using only proven shift instructions). cmp r11, 0; jne bad; xor eax,eax; pop rbx; ret; bad: mov rax, 0xFFFFED07; pop rbx; ret. This is a defensive check over compile-time constants (see module-level design-doc-gap note); it always passes at v1. Reserved labels: sb_validate_sig_scope_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call sb_sign_scope;
        mov r10, rax;
        shr r10, 32;
        cmp r10, 696;
        jne sb_validate_sig_scope_bad;
        mov r11, rax;
        shl r11, 32;
        shr r11, 32;
        cmp r11, 0;
        jne sb_validate_sig_scope_bad;
        xor eax, eax;
        pop rbx;
        ret;

      sb_validate_sig_scope_bad:
        mov rax, 0xFFFFED07;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // sb_validate_all(sb: *superblock) -> u64
  //   Runs the 8 M1 validators in band order (000 = most-common-expected
  //   per §4's discipline) and returns the first non-zero code, else 0.
  //   Composite — the only function in this module issuing nested calls,
  //   so it takes the uniform 5-push callee-save prologue this kernel
  //   uses for that shape (fs/vfs_read.pdx, fs/vfs_close.pdx): rbx holds
  //   sb_block_ptr across every call; r12/r13/r14/r15 are unused but
  //   pushed for pattern uniformity. 5 pushes from SysV-entry rsp%16==8
  //   land rsp%16==0, so every `call` below sees correct alignment with
  //   no extra `sub rsp, 8`.
  // ============================================================================
  pub let sb_validate_all : (u64) -> u64 !{mem} @{} =
    fn (sb: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52-M1-002 (#1682). Orchestrate the 8 sb_validate_* checks in band order, short-circuiting on first failure. 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for nested calls (fs/vfs_read.pdx pattern). rbx = sb_block_ptr, reloaded into rdi before every call since rdi is caller-save. After each call: cmp rax,0; jne sb_validate_all_done (forwards the sub-check's rax verbatim). Sequence: sb_validate_magic, sb_validate_version, sb_validate_block_size, sb_validate_reserved, sb_validate_total_blocks, sb_validate_regions, sb_validate_root_inode, sb_validate_sig_scope. Falls through to xor eax,eax on all-pass. Epilogue pops r15/r14/r13/r12/rbx in reverse. Reserved labels: sb_validate_all_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;

        mov rdi, rbx;
        call sb_validate_magic;
        cmp rax, 0;
        jne sb_validate_all_done;

        mov rdi, rbx;
        call sb_validate_version;
        cmp rax, 0;
        jne sb_validate_all_done;

        mov rdi, rbx;
        call sb_validate_block_size;
        cmp rax, 0;
        jne sb_validate_all_done;

        mov rdi, rbx;
        call sb_validate_reserved;
        cmp rax, 0;
        jne sb_validate_all_done;

        mov rdi, rbx;
        call sb_validate_total_blocks;
        cmp rax, 0;
        jne sb_validate_all_done;

        mov rdi, rbx;
        call sb_validate_regions;
        cmp rax, 0;
        jne sb_validate_all_done;

        mov rdi, rbx;
        call sb_validate_root_inode;
        cmp rax, 0;
        jne sb_validate_all_done;

        mov rdi, rbx;
        call sb_validate_sig_scope;
        cmp rax, 0;
        jne sb_validate_all_done;

        xor eax, eax;

      sb_validate_all_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
