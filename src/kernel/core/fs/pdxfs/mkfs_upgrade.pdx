// src/kernel/core/fs/pdxfs/mkfs_upgrade.pdx -- R52.M2-004 (#1689)
//
// PDXFS-ON-BLOCK v1 -- mkfs.pdxfs --upgrade (PDXL -> PDXB REWRITE).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Per design/filesystem/r52-implementation-plan.md §2.2 step 4: "reads
// the LBA 0, checks for "PDXL" magic (R25 lite-format), reads its
// region table, rewrites as PDXB at the same offsets with a fresh
// journal region carved from the tail. Same signing flow."
//
// Public entry point: `mkfs_upgrade_from_pdxl(bdev_cap, total_blocks,
// journal_size_hint) -> u64`, arity 3. Returns 0 on success, else one
// of this module's own `MKFS_UPGRADE_*` codes, the reused
// `PDXB_SB_READ_BDEV_ERR` value (see §Failure taxonomy below),
// `MKFS_ZERO_FAIL` (mkfs.pdx, #1688, forwarded verbatim from the
// reused `mkfs_zero_region`), or `PDXB_SB_WRITE_BDEV_ERR`
// (superblock_write.pdx, #1687, forwarded verbatim from `sb_write`).
//
// `total_blocks` and `journal_size_hint` are caller-supplied rather
// than derived from the volume, mirroring `mkfs.pdx`'s own `mkfs_run`
// precedent (#1688 took the same two geometry inputs as explicit
// arguments rather than a `BDEV_OP_QUERY_GEOM` call -- see that
// module's own header note). This is doubly necessary here: the PDXL
// superblock (design/filesystem/pdxfs-lite-format.md §1.1) has no
// `total_blocks` field at all (PDXL never tracked a bounded data
// region -- see that doc's §3, the extent bitmap's coverage is the
// only allocation-tracked span, and nothing upper-bounds where an
// individual inode's inline `start_lba` extents may point), so a
// caller-supplied volume size is the only way to know how much room
// exists to carve a fresh journal region out of.
//
// -----------------------------------------------------------------------------
// Why this does NOT reuse `sb_read` (superblock_read.pdx, #1686)
// -----------------------------------------------------------------------------
//
// `sb_read` immediately rejects any block whose magic is not
// `PDXB_SB_MAGIC` (0x42584450) -- see that module's own header note,
// which explicitly flags this exact tension: "the same subset
// mkfs.pdxfs --upgrade (#1689) needs when probing an EXISTING device
// that may still carry the R25 "PDXL" lite-format magic: a full
// 8-check gate would be meaningless there". A PDXL volume by
// definition carries the OLD magic (0x4C584450, "PDXL" LE, per
// pdxfs-lite-format.md §1.1 / pdxfs_lite/superblock.pdx
// PDXFS_SB_MAGIC) -- calling `sb_read` against it would deterministically
// return `PDXB_SB_MAGIC_BAD` (0xFFFFED00) before this module ever gets
// a chance to recognize the PDXL layout underneath. This module
// therefore issues its OWN raw `BDEV_OP_READ_LBA(0)` (identical
// descriptor-page protocol to `sb_read`'s, see below) and checks for
// the PDXL magic itself, rather than delegating to `sb_read`.
//
// It also does NOT reuse `pdxfs_lite/lite_reader.pdx` -- that module
// is an unrelated R42.M4-003 (#1394) in-memory BSS scaffold (a flat
// 16-entry test block table seeded by a test path, not a live
// KIND_BLKDEV reader) with its own non-standard magic encoding
// (`LIT_MAGIC_LITE = 0x504446534C31`, not the on-disk PDXL magic this
// module must recognize at LBA 0 offset 0). It answers a different
// question ("keep running read-only against an unmigrated volume")
// than this one ("physically rewrite LBA 0 as a PDXB superblock").
//
// -----------------------------------------------------------------------------
// PDXL source layout consumed here (design/filesystem/pdxfs-lite-format.md
// §1.1 / src/kernel/core/fs/pdxfs_lite/superblock.pdx)
// -----------------------------------------------------------------------------
//
//   Offset  Size  Field               Notes
//   ------  ----  ------------------  ------------------------------------
//   0       4     magic               0x4C584450 = "PDXL" LE
//   8       16    uuid                preserved verbatim into the new PDXB sb
//   32      8     itable_lba          preserved verbatim (same offset)
//   40      8     itable_bcount       preserved verbatim (same offset)
//   48      8     extent_area_lba     becomes PDXB alloc_lba (same offset)
//   56      8     extent_area_bcount  becomes PDXB alloc_bcount (same offset)
//   64      8     root_ino            NOT read -- PDXL v0 discipline already
//                                      fixes this at 1 (PDXL-format §2.2 /
//                                      pdxfs-lite-format.md §1.2); this
//                                      module stamps PDXB_SB_ROOT_INODE_DEFAULT
//                                      (1) directly rather than trusting an
//                                      on-disk value that is always the same
//                                      constant anyway.
//
// This module does NOT reformat or re-validate the itable/alloc region
// BYTES themselves -- see the "What 'preserving preservable state'
// means here" note below. It only reads the four geometry fields
// above out of the old superblock to seed the new one's region table.
//
// -----------------------------------------------------------------------------
// What "preserving preservable state" means here (flagged design-doc
// interpretation, see final report to main)
// -----------------------------------------------------------------------------
//
// The plan's step-4 text says "rewrites as PDXB at the same offsets
// with a fresh journal region carved from the tail" -- three separate
// claims this module honors literally:
//
//   (1) "at the same offsets": the new PDXB superblock's itable_lba /
//       itable_bcount / alloc_lba / alloc_bcount are copied VERBATIM
//       from the old PDXL superblock's itable_lba / itable_bcount /
//       extent_area_lba / extent_area_bcount. The physical LBA spans
//       of the inode table and the allocation bitmap are therefore
//       UNCHANGED by this upgrade -- this module never issues a
//       `BDEV_OP_WRITE_LBA` against either region. This is the
//       "preservable state": the region PLACEMENT survives, even
//       though (2) below means the region CONTENTS are not yet
//       reinterpretable as valid PDXB structures.
//
//   (2) Inode-row and bitmap-bit semantics are NOT reformatted. The
//       128-byte PDXL inode row (pdxfs-lite-format.md §2.1) and the
//       eventual PDXB inode row (frozen at R52.M4, #1697/#1698 -- not
//       yet landed as of this issue) are different formats; there is
//       no field-by-field conversion to perform yet, mirroring
//       `mkfs.pdx`'s own #1688 descope note ("The 128-byte inode row
//       FORMAT is not frozen until R52.M4 ... there is no field
//       layout to stamp yet at M2"). Unlike a *fresh* `mkfs_run`,
//       which zeroes the itable/alloc regions because they are
//       otherwise garbage/uninitialized, THIS module leaves the old
//       PDXL bytes in those regions completely untouched -- they are
//       neither zeroed (that would discard old PDXL file data for no
//       benefit at M2, since nothing reads it yet either way) nor
//       reinterpreted. A future M4 follow-up that wants to actually
//       migrate PDXL inode/dentry content into PDXB inode rows would
//       do so as its own pass over these preserved regions.
//
//   (3) "a fresh journal region carved from the tail": PDXL has no
//       journal region at all. This module computes
//       `journal_lba = alloc_lba + alloc_bcount` (immediately
//       following the preserved allocator-bitmap region -- the exact
//       same relative placement `mkfs.pdx`'s `mkfs_layout_compute`
//       uses for a from-scratch volume: itable, then alloc, then
//       journal, then data, each starting where the previous one
//       ends) and `journal_bcount = journal_size_hint`. Everything
//       from `journal_lba` onward that PDXL considered undifferentiated
//       "data" is repartitioned: the leading `journal_size_hint`
//       blocks of that former data span become the fresh journal
//       region (this is the "tail" being carved from -- the tail of
//       what PDXL treated as one contiguous data area, not the
//       physical tail of the whole volume), and `data_lba` moves
//       forward by `journal_bcount` accordingly. This placement is
//       REQUIRED, not just a style choice: `superblock.pdx`'s
//       (#1682) `sb_validate_regions` enforces the strict order
//       `itable_lba < alloc_lba < journal_lba < data_lba <=
//       total_blocks` (checks (a)-(e)); a journal literally at the
//       highest LBAs of the volume (with `data_lba` sitting BEFORE
//       it) would fail check (d) (`data_lba >= journal_end`). This
//       module's `mkfs_up_layout_compute` therefore mirrors
//       `mkfs_layout_compute`'s own canonical ordering exactly, just
//       seeded from the two preserved region fields instead of a
//       from-scratch geometry computation. The freshly-carved journal
//       region IS zeroed (via the reused `mkfs_zero_region`,
//       #1688) -- unlike the preserved itable/alloc regions, this
//       span held arbitrary former-PDXL-"data" bytes with no defined
//       meaning as a journal, so it must start clean for the eventual
//       R52.M5 WAL (#1704) to interpret correctly.
//
//   The volume's UUID is likewise preserved verbatim (copied from the
//   old superblock's `uuid` field, offset 8, 16 bytes) rather than
//   regenerated via `sb_generate_uuid` (unlike a fresh `mkfs_run`) --
//   an upgrade is the SAME logical volume under a new on-disk format,
//   not a new volume, so its identity should survive the rewrite.
//
// -----------------------------------------------------------------------------
// Signing gap (inherited from `superblock_write.pdx`, #1687, same
// posture `mkfs.pdx`'s #1688 already inherits)
// -----------------------------------------------------------------------------
//
// `sb_write` does not sign or flush (paideia-as `mldsa65_sign` is an
// unlanded cross-repo gap, §5.4 #1). `mkfs_up_sb_populate` leaves
// `sig_key_hash` (@+128) and `sig` (@+696) at the new scratch buffer's
// static-zero initial value, exactly like `mkfs.pdx`'s
// `mkfs_sb_populate`.
//
// -----------------------------------------------------------------------------
// Calling convention (design/hardware/nvme-io-queues.md §3.5,
// src/kernel/core/cap/cap_handler_blkdev.pdx header, src/kernel/core/
// cap/invoke.pdx) -- identical protocol to superblock_read.pdx's
// sb_read / mkfs.pdx's mkfs_zero_region: see those modules' own header
// notes for the full `op_arg`/descriptor-page breakdown. This module's
// raw LBA-0 read below is a direct copy of `sb_read`'s own read step,
// minus the four PDXB-specific field validators (which would reject
// a PDXL-magic block outright, see above).
//
// -----------------------------------------------------------------------------
// Storage
// -----------------------------------------------------------------------------
//
// `_mkfs_up_read_buf`   : [u64; 512] @align(4096) -- landing zone for the
//                          just-read (possibly-PDXL) LBA 0 block.
// `_mkfs_up_read_desc`  : [u64; 4]   @align(4096) -- the READ_LBA descriptor
//                          page (op_arg packs the op_code into this
//                          address's low 12 bits, see cap_handler_blkdev.pdx).
// `_mkfs_up_layout_row` : [u64; 9] -- {itable_lba, itable_bcount, alloc_lba,
//                          alloc_bcount, journal_lba, journal_bcount,
//                          data_lba, data_bcount, total_blocks}, same shape
//                          as mkfs.pdx's `_mkfs_layout_row`.
// `_mkfs_up_sb_scratch` : [u64; 512] @align(4096) -- the new PDXB
//                          superblock built by `mkfs_up_sb_populate`
//                          before `sb_write` persists it.
// All four are single-writer state confined (tools/build.sh
// `ec_confine_one`) to `core/fs/pdxfs/mkfs_upgrade.o`, matching every
// other new `_*` table in `core/fs/pdxfs/`.
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- 0xFFFFED0E/0xFFFFED0F (M2 sub-slice; see
// design/filesystem/r52-implementation-plan.md §4)
// -----------------------------------------------------------------------------
//
// `MKFS_UPGRADE_MAGIC_BAD = 0xFFFFED0E`: the block at LBA 0 is not a
// recognizable PDXL superblock -- either its magic isn't
// `0x4C584450` ("PDXL"), or (defensively) its `itable_lba` field
// reads as 0, which no valid PDXL volume would ever have (PDXL's own
// `sb_validate`, pdxfs_lite/superblock.pdx, rejects `itable_lba == 0`
// as `PDXFS_SB_EINVAL` at ordinary PDXL mount time -- a volume this
// module is asked to upgrade has therefore either never been
// mounted/validated, or its region table is corrupt either way, so
// the same "not a valid, upgradeable PDXL volume" code applies).
//
// `MKFS_UPGRADE_ROOM_SHORT = 0xFFFFED0F`: the caller-supplied
// `total_blocks` / `journal_size_hint` do not leave room for a
// nonempty data region once the fresh journal is carved out --
// either input is 0, or `journal_lba + journal_bcount >= total_blocks`.
//
// This module additionally forwards, verbatim, unmodified:
//   - the reused numeric value `0xFFFFED08` for a failed raw LBA-0
//     read (same failure class as `superblock_read.pdx`'s
//     `PDXB_SB_READ_BDEV_ERR` -- no new code needed for "a
//     BDEV_OP_READ_LBA against LBA 0 did not return BDEV_ERR_OK", the
//     exact same condition that sentinel already names elsewhere).
//     Declared here as a local literal rather than a cross-module
//     `pub let` reference -- there is no precedent in this codebase
//     for one .pdx module referencing another module's constant by
//     name (see superblock.pdx's own header note on this point).
//   - `MKFS_ZERO_FAIL` (0xFFFFED0D, mkfs.pdx, #1688) from the reused
//     `mkfs_zero_region` call against the fresh journal region.
//   - `PDXB_SB_WRITE_BDEV_ERR` (0xFFFFED09, superblock_write.pdx,
//     #1687) from `sb_write`.
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §3.5)
// -----------------------------------------------------------------------------
//
// `mkfs_upgrade_from_pdxl(bdev_cap, total_blocks, journal_size_hint)`
// = 3. `mkfs_up_layout_compute(old_read_buf_ptr, total_blocks,
// journal_size_hint)` = 3 -- the row-pointer collapse (reading the
// preserved itable/alloc fields straight out of the already-read PDXL
// buffer rather than passing each as its own argument) keeps this at
// 3 instead of the naive 5 (old_itable_lba, old_itable_bcount,
// old_alloc_lba, old_alloc_bcount, total_blocks, journal_size_hint =
// 6, right at the ceiling; folding the four old-buffer reads behind
// one pointer argument is the same discipline the plan applies
// throughout §5.1). `mkfs_up_sb_populate(new_sb_ptr, old_read_buf_ptr,
// layout_row_ptr)` = 3. All three comfortably under the paideia-as
// arity-6 ceiling.
//
// Like `mkfs.pdx`'s own `mkfs_layout_compute`, neither
// `mkfs_up_layout_compute` nor `mkfs_up_sb_populate` ever compares
// `rax` against a specific large sentinel literal (only `cmp rax, 0`
// / `jne`/`je`) -- `cmp reg, imm32` has no 64-bit-immediate form on
// this ISA, so a specific-sentinel compare would sign-extend the
// immediate and silently never match. Every sentinel return here is a
// `mov rax, <imm64>` forwarded verbatim by the caller.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// `mkfs_upgrade_from_pdxl` issues nested calls (raw `cap_invoke`,
// `mkfs_up_layout_compute`, `mkfs_zero_region`, `mkfs_up_sb_populate`,
// `sb_write`), so it takes the uniform 5-push callee-save prologue
// this kernel uses for that shape (`mkfs.pdx`'s `mkfs_run`,
// `superblock_read.pdx`'s `sb_read`): 5 pushes from a SysV-entry
// rsp%16==8 land rsp%16==0, satisfying alignment with no extra `sub
// rsp, 8`. rbx=bdev_cap (kept live throughout); r12=total_blocks
// then (after the layout call) reloaded to `&_mkfs_up_layout_row`
// (the same total_blocks-to-row-pointer register reuse `mkfs_run`
// itself already uses); r13=journal_size_hint (live only long enough
// to marshal the `mkfs_up_layout_compute` call); r14 transient
// (descriptor-page pointer during the raw read, dead afterward);
// r15=&_mkfs_up_read_buf (kept live across every subsequent call --
// both `mkfs_up_layout_compute` and `mkfs_up_sb_populate` need to read
// the old superblock's preserved fields out of it).
//
// `mkfs_up_layout_compute` and `mkfs_up_sb_populate` are both pure
// leaves (no nested `call`, only loads/stores/adds/subs) -- no
// prologue, matching `mkfs.pdx`'s own `mkfs_layout_compute` /
// `mkfs_sb_populate`... except `mkfs_sb_populate` itself takes a
// prologue there because IT calls `sb_generate_uuid`; THIS module's
// `mkfs_up_sb_populate` does not (it copies the old uuid bytes
// directly instead), so it stays a true leaf with no prologue at all.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this module (every field
// touched is u32- or u64-aligned; the uuid is copied as two u64
// halves, matching superblock.pdx's own `sb_uuid_lo`/`sb_uuid_hi`
// treatment). No `test` instruction anywhere -- every branch uses
// `cmp reg, imm` / `cmp reg, reg` + `je`/`jne`/`jae`. Every label is
// prefixed `mkfs_up_` per this issue's own naming requirement (this
// kernel's reserved-label discipline forbids bare `if`/`loop`/`fs`/
// `alloc`/`mount`/... as labels).

module MkfsUpgrade = structure {

  // ============================================================================
  // M2 failure taxonomy -- next two slots after mkfs.pdx's (#1688)
  // 0xFFFFED0C/0xFFFFED0D.
  // ============================================================================

  pub let MKFS_UPGRADE_MAGIC_BAD  : u64 = 0xFFFFED0E
  pub let MKFS_UPGRADE_ROOM_SHORT : u64 = 0xFFFFED0F

  // ============================================================================
  // Storage.
  // ============================================================================

  // 512 qwords = 4096 bytes: landing zone for the just-read (possibly
  // PDXL) LBA 0 block.
  pub let mut _mkfs_up_read_buf : [u64; 512] = uninit @align(4096)

  // 4 qwords: {lba, nblocks, dma_iova, status_out}. Must be 4-KiB
  // aligned (op_arg ORs the op_code into the low 12 bits of this
  // address -- cap_handler_blkdev.pdx's own header comment).
  pub let mut _mkfs_up_read_desc : [u64; 4] = uninit @align(4096)

  // 9 qwords: {itable_lba, itable_bcount, alloc_lba, alloc_bcount,
  // journal_lba, journal_bcount, data_lba, data_bcount, total_blocks}.
  // Same shape as mkfs.pdx's `_mkfs_layout_row`.
  pub let mut _mkfs_up_layout_row : [u64; 9] = [0; 9]

  // 512 qwords = 4096 bytes: the new PDXB superblock built by
  // `mkfs_up_sb_populate` before `sb_write` persists it. Zero-
  // initialized once; `sig_key_hash` (@160... actually @128) and
  // `_reserved`/`sig` are never subsequently written by this module
  // (see the Signing-gap note above), so they stay correctly zero
  // across every `mkfs_upgrade_from_pdxl` invocation without a
  // re-zero step.
  pub let mut _mkfs_up_sb_scratch : [u64; 512] = [0; 512] @align(4096)

  // ============================================================================
  // mkfs_up_layout_compute(old_read_buf_ptr: u64, total_blocks: u64,
  //                         journal_size_hint: u64) -> u64
  //   Reads the preserved itable/alloc fields out of the already-read
  //   old (PDXL) superblock buffer, carves a fresh journal region
  //   immediately after the preserved allocator region, and derives
  //   the data region from what remains. Success: returns 0, having
  //   stamped all 9 fields of `_mkfs_up_layout_row`. Failure: returns
  //   MKFS_UPGRADE_MAGIC_BAD (old itable_lba reads as 0 -- not a
  //   sane PDXL region table) or MKFS_UPGRADE_ROOM_SHORT
  //   (total_blocks/journal_size_hint zero, or no room left for a
  //   nonempty data region).
  // ============================================================================

  pub let mkfs_up_layout_compute : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (old_read_buf_ptr: u64) (total_blocks: u64) (journal_size_hint: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M2-004 (#1689). Pure leaf (no nested calls, only loads/adds/subs) -- no callee-save prologue needed, matching mkfs.pdx's mkfs_layout_compute precedent for the same shape. Body: (1) Save the 3 args into r8/r9/r10 immediately (rdi/rsi/rdx are about to be reused for scratch loads). (2) Guard total_blocks(r9)==0 -> fail_room; guard journal_size_hint(r10)==0 -> fail_room (a zero-length journal defeats the whole point of the upgrade and would make journal_lba==data_lba, a degenerate WAL). (3) Load old itable_lba @old_read_buf_ptr+32 into rax; cmp rax,0; je fail_magic (a PDXL volume with itable_lba==0 failed its own pdxfs_lite sb_validate EINVAL check at ordinary mount time -- not a sane region table to upgrade). (4) Load old itable_bcount @+40 into rcx. (5) lea r11,[rip+_mkfs_up_layout_row]; stamp row[0]=itable_lba(rax), row[1]=itable_bcount(rcx) -- both preserved verbatim at the SAME offsets they held under PDXL (see module header §'What preserving preservable state means here' point (1)). (6) Load old alloc_lba (PDXL extent_area_lba) @+48 into rax, old alloc_bcount (PDXL extent_area_bcount) @+56 into rcx; stamp row[2]=alloc_lba, row[3]=alloc_bcount -- likewise preserved verbatim. (7) journal_lba = alloc_lba+alloc_bcount (add rax,rcx); stamp row[4]=journal_lba; stamp row[5]=journal_bcount=r10 (journal_size_hint) directly, no arithmetic. (8) data_lba = journal_lba+journal_bcount (add rax,r10); cmp rax,r9(total_blocks); jae fail_room (no room for a nonempty data region -- the exact same guard shape as mkfs.pdx's mkfs_layout_compute step 11); stamp row[6]=data_lba. (9) data_bcount = total_blocks-data_lba (mov rcx,r9; sub rcx,rax); stamp row[7]=data_bcount. (10) stamp row[8]=total_blocks(r9). (11) xor eax,eax; ret. fail_room: mov rax,0xFFFFED0F (MKFS_UPGRADE_ROOM_SHORT); ret. fail_magic: mov rax,0xFFFFED0E (MKFS_UPGRADE_MAGIC_BAD); ret. No test instruction; no mov_b. Reserved labels: mkfs_up_layout_compute_.",
      block: {
        mov r8,  rdi;                     // old_read_buf_ptr
        mov r9,  rsi;                     // total_blocks
        mov r10, rdx;                     // journal_size_hint

        cmp r9, 0;
        je  mkfs_up_layout_compute_fail_room;
        cmp r10, 0;
        je  mkfs_up_layout_compute_fail_room;

        // Preserved itable_lba/itable_bcount (same offsets as PDXL).
        mov rax, [r8 + 32];
        cmp rax, 0;
        je  mkfs_up_layout_compute_fail_magic;
        mov rcx, [r8 + 40];

        lea r11, [rip + _mkfs_up_layout_row];
        mov [r11 + 0], rax;               // row[0] = itable_lba
        mov [r11 + 8], rcx;               // row[1] = itable_bcount

        // Preserved alloc_lba/alloc_bcount (PDXL extent_area_lba/_bcount,
        // same offsets).
        mov rax, [r8 + 48];
        mov rcx, [r8 + 56];
        mov [r11 + 16], rax;              // row[2] = alloc_lba
        mov [r11 + 24], rcx;              // row[3] = alloc_bcount

        // journal_lba = alloc_lba + alloc_bcount (fresh region, carved
        // immediately after the preserved allocator region).
        add rax, rcx;
        mov [r11 + 32], rax;              // row[4] = journal_lba
        mov [r11 + 40], r10;              // row[5] = journal_bcount

        // data_lba = journal_lba + journal_bcount.
        add rax, r10;
        cmp rax, r9;
        jae mkfs_up_layout_compute_fail_room;
        mov [r11 + 48], rax;              // row[6] = data_lba

        mov rcx, r9;
        sub rcx, rax;                     // data_bcount = total_blocks - data_lba
        mov [r11 + 56], rcx;              // row[7] = data_bcount

        mov [r11 + 64], r9;               // row[8] = total_blocks

        xor eax, eax;
        ret;

      mkfs_up_layout_compute_fail_room:
        mov rax, 0xFFFFED0F;              // MKFS_UPGRADE_ROOM_SHORT
        ret;

      mkfs_up_layout_compute_fail_magic:
        mov rax, 0xFFFFED0E;              // MKFS_UPGRADE_MAGIC_BAD
        ret
      }
    }

  // ============================================================================
  // mkfs_up_sb_populate(new_sb_ptr: u64, old_read_buf_ptr: u64,
  //                      layout_row_ptr: u64) -> u64
  //   Stamps a caller-zeroed 4-KiB buffer with a valid v1 PDXB
  //   superblock: PDXB magic/version, the volume's PRESERVED uuid
  //   (copied verbatim from the old PDXL superblock, not regenerated),
  //   block_size, flags (clean-unmount | root-volume), the 8
  //   region-layout fields + total_blocks from `layout_row_ptr` (see
  //   mkfs_up_layout_compute), root_inode=1, mount_gen=1. Does NOT
  //   touch sig_key_hash/_reserved/sig (left at their static zero --
  //   see the Signing-gap module note). Always returns 0.
  // ============================================================================

  pub let mkfs_up_sb_populate : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (new_sb_ptr: u64) (old_read_buf_ptr: u64) (layout_row_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R52.M2-004 (#1689). Pure leaf -- no nested calls (unlike mkfs.pdx's mkfs_sb_populate, which calls sb_generate_uuid; this module copies the OLD superblock's uuid bytes directly instead, so no call is needed and no prologue is required). Body: (1) Save the 3 args into r8/r9/r10. (2) magic (u32 @+0) = 0x42584450 ('PDXB') via mov rax,0x42584450; mov_d [r8+0],rax. (3) version (u32 @+4) = 1. (4) uuid @+8/+16 (16 bytes, two u64 halves) copied verbatim from old_read_buf_ptr(r9)+8/+16 -- preserves the volume's identity across the upgrade rather than regenerating a fresh one (module header note). (5) block_size (u32 @+24) = 4096. (6) flags (u32 @+28) = PDXB_SB_FLAG_CLEAN_UNMOUNT|PDXB_SB_FLAG_ROOT_VOLUME = 0x3, same default posture as mkfs.pdx's mkfs_sb_populate. (7) total_blocks (u64 @+32) = row[8] (@layout_row_ptr+64). (8)-(11) itable_lba/itable_bcount/alloc_lba/alloc_bcount/journal_lba/journal_bcount/data_lba/data_bcount (@+40..+96) copied verbatim from row[0..7] (@layout_row_ptr+0..+56) via 8 load-then-store pairs, offsets matching superblock_fmt.pdx exactly (same shape as mkfs.pdx's mkfs_sb_populate steps 7-10). (12) root_inode (u64 @+104) = 1 (PDXB_SB_ROOT_INODE_DEFAULT -- NOT read from the old superblock; PDXL v0 discipline already fixes this at 1, see module header note, so hardcoding is equivalent and avoids trusting an on-disk value that never varies). (13) mount_gen (u64 @+112) = 1 (an upgrade is a fresh PDXB mount generation, same posture as a from-scratch mkfs). (14) snap_head (u64 @+120) = 0 (explicit, though already zero from static init). (15) xor eax,eax; ret. sig_key_hash/_reserved/sig are NOT written (left at the buffer's static zero -- see Signing-gap note). No test instruction; no mov_b (uuid copy is two whole-qword loads/stores, not byte-level). Reserved labels: none needed (straight-line, no branches).",
      block: {
        mov r8,  rdi;                     // new_sb_ptr
        mov r9,  rsi;                     // old_read_buf_ptr
        mov r10, rdx;                     // layout_row_ptr

        // magic @+0, version @+4.
        mov rax, 0x42584450;
        mov_d [r8 + 0], rax;
        mov rax, 1;
        mov_d [r8 + 4], rax;

        // uuid @+8/+16 (16 bytes) preserved verbatim from the old
        // PDXL superblock.
        mov rax, [r9 + 8];
        mov [r8 + 8], rax;
        mov rax, [r9 + 16];
        mov [r8 + 16], rax;

        // block_size @+24, flags @+28.
        mov rax, 4096;
        mov_d [r8 + 24], rax;
        mov rax, 3;                       // CLEAN_UNMOUNT(0x1) | ROOT_VOLUME(0x2)
        mov_d [r8 + 28], rax;

        // total_blocks @+32 = row[8].
        mov rax, [r10 + 64];
        mov [r8 + 32], rax;

        // itable_lba/itable_bcount @+40/+48 = row[0]/row[1].
        mov rax, [r10 + 0];
        mov [r8 + 40], rax;
        mov rax, [r10 + 8];
        mov [r8 + 48], rax;

        // alloc_lba/alloc_bcount @+56/+64 = row[2]/row[3].
        mov rax, [r10 + 16];
        mov [r8 + 56], rax;
        mov rax, [r10 + 24];
        mov [r8 + 64], rax;

        // journal_lba/journal_bcount @+72/+80 = row[4]/row[5].
        mov rax, [r10 + 32];
        mov [r8 + 72], rax;
        mov rax, [r10 + 40];
        mov [r8 + 80], rax;

        // data_lba/data_bcount @+88/+96 = row[6]/row[7].
        mov rax, [r10 + 48];
        mov [r8 + 88], rax;
        mov rax, [r10 + 56];
        mov [r8 + 96], rax;

        // root_inode @+104 = 1 (PDXB_SB_ROOT_INODE_DEFAULT).
        mov rax, 1;
        mov [r8 + 104], rax;

        // mount_gen @+112 = 1.
        mov rax, 1;
        mov [r8 + 112], rax;

        // snap_head @+120 = 0 (explicit; already zero from static init).
        xor rax, rax;
        mov [r8 + 120], rax;

        xor eax, eax;
        ret
      }
    }

  // ============================================================================
  // mkfs_upgrade_from_pdxl(bdev_cap: u64, total_blocks: u64,
  //                         journal_size_hint: u64) -> u64
  //   Top-level mkfs.pdxfs --upgrade entry point (#1689). Reads LBA 0,
  //   detects a PDXL (pdxfs-lite) superblock, computes a PDXB region
  //   layout that preserves the itable/alloc regions at their PDXL
  //   offsets and carves a fresh journal region out of what PDXL
  //   considered undifferentiated data space, populates a PDXB
  //   superblock scratch buffer (preserving the volume's uuid), zeroes
  //   only the fresh journal region, and persists the new superblock
  //   via sb_write.
  //   Success: 0. Failure: MKFS_UPGRADE_MAGIC_BAD (LBA 0 is not a
  //   recognizable PDXL superblock), MKFS_UPGRADE_ROOM_SHORT (bad
  //   geometry inputs), the reused 0xFFFFED08 read-failure value, or
  //   MKFS_ZERO_FAIL / PDXB_SB_WRITE_BDEV_ERR forwarded verbatim from
  //   mkfs.pdx's mkfs_zero_region / superblock_write.pdx's sb_write.
  // ============================================================================

  pub let mkfs_upgrade_from_pdxl : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (total_blocks: u64) (journal_size_hint: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M2-004 (#1689). 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for every nested call below (mkfs.pdx's mkfs_run pattern); entry rsp%16==8 + 40 B of pushes = 48, %16==0. Body: (1) Save the 3 args immediately: rbx=bdev_cap, r12=total_blocks, r13=journal_size_hint (all 3 SysV arg regs are caller-save and would not survive the first nested call). (2) Raw LBA-0 read, identical protocol to superblock_read.pdx's sb_read (deliberately NOT calling sb_read itself -- see module header 'Why this does NOT reuse sb_read'): r14=&_mkfs_up_read_desc (lea), r15=&_mkfs_up_read_buf (lea); stamp [r14+0]=lba=0, [r14+8]=nblocks=1, [r14+16]=dma_iova=r15, [r14+24]=status_out=0; rdi=rbx, rsi=r14 OR'd with op_code 3 (BDEV_OP_READ_LBA) via r10; call cap_invoke; cmp rax,0; jne read_err (maps to the reused PDXB_SB_READ_BDEV_ERR value 0xFFFFED08 -- see module header Failure-taxonomy note on why no new code is declared for this). (3) Check magic: mov_d rax,[r15+0]; cmp rax,0x4C584450 ('PDXL' LE); jne magic_bad (MKFS_UPGRADE_MAGIC_BAD, 0xFFFFED0E) -- 0x4C584450 has bit31 clear (top nibble 4), safe as an imm32 per superblock.pdx's sb_validate_magic precedent for the analogous PDXB check. (4) Marshal + call mkfs_up_layout_compute(r15, r12, r13). cmp rax,0; jne done (forwards MKFS_UPGRADE_MAGIC_BAD or MKFS_UPGRADE_ROOM_SHORT verbatim -- the only two codes that function returns). (5) r12 = &_mkfs_up_layout_row (lea; total_blocks's original value in r12 is no longer needed -- it is now embedded in the row at +64, exactly the same register-reuse mkfs_run itself performs). (6) One mkfs_zero_region call against the FRESH journal region only (row[4]/row[5] @+32/+40 -- NOT against itable/alloc, which are preserved untouched per the module header's 'preserving preservable state' note): rdi=rbx, rsi=[r12+32], rdx=[r12+40]; call mkfs_zero_region (mkfs.pdx, #1688, cross-file call within core/fs/pdxfs/, same pattern mkfs_run itself uses three times). cmp rax,0; jne done (forwards MKFS_ZERO_FAIL 0xFFFFED0D verbatim). (7) call mkfs_up_sb_populate(&_mkfs_up_sb_scratch, r15, r12) -- always returns 0, no check needed (r15 still holds &_mkfs_up_read_buf, untouched since step 2; r12 now holds &_mkfs_up_layout_row from step 5). (8) call sb_write(rbx, &_mkfs_up_sb_scratch) (superblock_write.pdx, #1687, cross-file call, same pattern mkfs_run itself uses). cmp rax,0; jne done (forwards PDXB_SB_WRITE_BDEV_ERR verbatim). (9) xor eax,eax (success). done: 5-pop epilogue + ret. read_err: mov rax,0xFFFFED08; jmp done. magic_bad: mov rax,0xFFFFED0E; jmp done. No test instruction; no mov_b. Reserved labels: mkfs_up_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // bdev_cap
        mov r12, rsi;                     // total_blocks
        mov r13, rdx;                     // journal_size_hint

        lea r14, [rip + _mkfs_up_read_desc];
        lea r15, [rip + _mkfs_up_read_buf];

        xor rax, rax;
        mov [r14 + 0], rax;               // lba = 0
        mov rax, 1;
        mov [r14 + 8], rax;               // nblocks = 1
        mov [r14 + 16], r15;              // dma_iova = &_mkfs_up_read_buf
        xor rax, rax;
        mov [r14 + 24], rax;              // status_out = 0

        mov rdi, rbx;
        mov rsi, r14;
        mov r10, 3;                       // BDEV_OP_READ_LBA
        or  rsi, r10;
        call cap_invoke;
        cmp rax, 0;
        jne mkfs_up_read_err;

        // Detect PDXL magic (pdxfs-lite-format.md §1.1).
        mov_d rax, [r15 + 0];
        cmp rax, 0x4C584450;              // "PDXL" LE
        jne mkfs_up_magic_bad;

        mov rdi, r15;
        mov rsi, r12;
        mov rdx, r13;
        call mkfs_up_layout_compute;
        cmp rax, 0;
        jne mkfs_up_done;                 // rax already = MAGIC_BAD or ROOM_SHORT

        lea r12, [rip + _mkfs_up_layout_row];

        // Zero the freshly-carved journal region only.
        mov rdi, rbx;
        mov rsi, [r12 + 32];              // journal_lba
        mov rdx, [r12 + 40];              // journal_bcount
        call mkfs_zero_region;
        cmp rax, 0;
        jne mkfs_up_done;                 // rax already = MKFS_ZERO_FAIL

        // Populate the new PDXB superblock scratch buffer.
        lea rdi, [rip + _mkfs_up_sb_scratch];
        mov rsi, r15;
        mov rdx, r12;
        call mkfs_up_sb_populate;

        // Persist it.
        mov rdi, rbx;
        lea rsi, [rip + _mkfs_up_sb_scratch];
        call sb_write;
        cmp rax, 0;
        jne mkfs_up_done;                 // rax already = PDXB_SB_WRITE_BDEV_ERR

        xor eax, eax;
        jmp mkfs_up_done;

      mkfs_up_read_err:
        mov rax, 0xFFFFED08;              // reused PDXB_SB_READ_BDEV_ERR value
        jmp mkfs_up_done;

      mkfs_up_magic_bad:
        mov rax, 0xFFFFED0E;              // MKFS_UPGRADE_MAGIC_BAD

      mkfs_up_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
