// src/kernel/core/fs/pdxfs/snap_create.pdx -- R42.M3-001 (#1388)
//
// PDXFS v1 SNAPSHOT -- IMMUTABLE-VIEW CREATE + NAME REGISTRY.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on the ACT OF FREEZING the fs state as a NAMED
// immutable view. Every snapshot-consuming sibling reads its slot
// through this module:
//
//   snap_mount_ro.pdx  -- resolves a mount name to a snap_id via
//                          snc_lookup before opening it read-only.
//   snap_diff.pdx      -- takes two snap_ids and enumerates block
//                          differences.
//   snap_prune.pdx     -- deletes snapshots by policy; the exclusive-
//                          block accounting on delete mirrors the
//                          refcount-bump accounting this module
//                          performs on create.
//
// It is a SCAFFOLD (D7). The name-to-slot registry is a flat 16-entry
// table in BSS; a real widening replaces it with the on-disk snapshot
// superblock chain. The scaffold's semantic (an atomic "freeze +
// chain-head bump + refcount-bump-per-live-block" that either succeeds
// atomically or rejects with a named refusal) is the semantic the on-
// disk widening preserves.
//
// It does NOT touch pxrc.pdx (the cow refcount table). The "refcount
// all live blocks +1" step is ACCOUNTED here as a per-create bump of a
// SCAFFOLD-LOCAL counter (_snc_state refbump_total) whose value is
// SNC_LIVE_BLOCKS per create. A widening will call pxrc_inc on the
// actual live-block list; the counter this module bumps IS that call
// count on the scaffold. Keeping the accounting local means the R42.M3
// witnesses do not have to reset pxrc, and the two modules stay
// functionally independent until the widening lands.
//
// It does NOT read block payloads. A snapshot IS its name-hash + its
// slot index (== snap_id - 1). The block table each snapshot points
// at is owned by snap_diff.pdx in the scaffold.
//
// It does NOT delete snapshots. snap_prune.pdx owns the retention
// policy; this module's chain_head is append-only in the scaffold.
//
// =============================================================================
// §1  TABLE GEOMETRY
// =============================================================================
//
// SNC_MAX          = 16       chain capacity (scaffold).
// SNC_LIVE_BLOCKS  = 4        accounting bump per successful create.
//
// _snc_names is a flat array of SNC_MAX u64s. A slot with value 0 is
// EMPTY. A slot with any non-zero value holds the name_hash of a live
// snapshot. snap_id is 1-based == slot_idx + 1; snap_id 0 is reserved
// as the "no such snapshot" sentinel.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _snc_names and _snc_state are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/fs/pdxfs/snap_create.o`. A second writer would let a caller
// "register a name without an atomic create", which would let a mount
// path bind to a snapshot the chain-head bump never happened for --
// and every diff/prune against that binding would then be one made
// against a slot the atomic story never sanctioned.
//
// STATE LAYOUT -- _snc_state : [u64; 8]
//   +0    init_mark        0x5CEA once snc_reset has run
//   +8    err              sticky error latch (first-writer-wins)
//   +16   chain_head       next-write slot; also the live count
//   +24   create_count     total snc_create calls that mutated the chain
//   +32   refbump_total    SNC_LIVE_BLOCKS per successful create
//   +40   last_snap_id     snap_id returned by the most recent create
//   +48   reserved
//   +56   reserved
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEF80..0xFFFFEF8F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: journal_csum 0xFFFFEF90..9F (R42.M2-004). Adjacent free band
// below: snap_mount_ro 0xFFFFEF70..7F (R42.M3-002).
//
//   SNC_OK               = 0
//   SNC_ERR_NOT_INIT     = 0xFFFFEF8F   accessor before snc_reset
//   SNC_ERR_CHAIN_FULL   = 0xFFFFEF8E   create when chain_head == SNC_MAX
//   SNC_ERR_DUP_NAME     = 0xFFFFEF8D   create with a name already registered
//   SNC_ERR_BAD_NAME     = 0xFFFFEF8C   create with name_hash == 0
//   SNC_ERR_BAD_IDX      = 0xFFFFEF8B   accessor: idx >= SNC_MAX
//   SNC_ERR_INTERNAL     = 0xFFFFEF8A   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `snc_`.

module SnapCreate = structure {

  pub let SNC_MAX          : u64 = 16
  pub let SNC_LIVE_BLOCKS  : u64 = 4

  pub let SNC_OK              : u64 = 0
  pub let SNC_ERR_NOT_INIT    : u64 = 0xFFFFEF8F
  pub let SNC_ERR_CHAIN_FULL  : u64 = 0xFFFFEF8E
  pub let SNC_ERR_DUP_NAME    : u64 = 0xFFFFEF8D
  pub let SNC_ERR_BAD_NAME    : u64 = 0xFFFFEF8C
  pub let SNC_ERR_BAD_IDX     : u64 = 0xFFFFEF8B
  pub let SNC_ERR_INTERNAL    : u64 = 0xFFFFEF8A

  pub let SNC_INIT_MARK       : u64 = 0x5CEA

  pub let mut _snc_names : [u64; 16] = uninit @align(64)
  pub let mut _snc_state : [u64; 8]  = uninit @align(64)

  // ==========================================================================
  // Reset. Clears name table and state; installs init_mark.
  // ==========================================================================

  pub let snc_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): clear names + state, install init_mark. Labels prefixed snc_rst_.",
      block: {
        lea r10, [rip + _snc_names];
        xor rax, rax;
        xor rcx, rcx;
      snc_rst_n:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  snc_rst_n;

        lea r10, [rip + _snc_state];
        xor rcx, rcx;
      snc_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  snc_rst_s;

        mov rax, 0x5CEA;
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  pub let snc_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): 1 iff init_mark matches. Labels prefixed snc_bnd_.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 0];
        mov r11, 0x5CEA;
        cmp rax, r11;
        jne snc_bnd_no;
        mov rax, 1;
        ret;
      snc_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let snc_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): sticky error latch readback.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let snc_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): first-writer-wins error latch. Labels prefixed snc_se_.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne snc_se_out;
        mov [r10 + 8], rdi;
      snc_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let snc_capacity : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M3-001 (#1388): SNC_MAX as u64.",
      block: {
        mov rax, 16;
        ret
      }
    } @no_frame

  pub let snc_live_blocks : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M3-001 (#1388): SNC_LIVE_BLOCKS as u64.",
      block: {
        mov rax, 4;
        ret
      }
    } @no_frame

  pub let snc_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): chain_head field.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let snc_create_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): create_count field.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let snc_refbump_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): refbump_total field.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let snc_last_snap_id : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): last_snap_id field.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 40];
        ret
      }
    } @no_frame

  // ==========================================================================
  // snc_name_at(idx) -> u64
  //
  // Read the name_hash at slot idx (0-based). 0 iff the slot is empty.
  // Refuses:
  //   - not init                    SNC_ERR_NOT_INIT
  //   - idx >= SNC_MAX              SNC_ERR_BAD_IDX
  // ==========================================================================

  pub let snc_name_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): read name_hash of slot idx. Labels prefixed snc_na_.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 0];
        mov r11, 0x5CEA;
        cmp rax, r11;
        jne snc_na_ni;

        cmp rdi, 16;
        jae snc_na_bi;

        lea r11, [rip + _snc_names];
        mov rax, [r11 + rdi * 8];
        ret;

      snc_na_ni:
        mov rdi, 0xFFFFEF8F;
        call snc_set_err;
        xor rax, rax;
        ret;
      snc_na_bi:
        mov rdi, 0xFFFFEF8B;
        call snc_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snc_lookup(name_hash) -> u64
  //
  // Linear scan of the name table. Returns the 1-based snap_id of the
  // slot whose name_hash matches, or 0 if not found. name_hash == 0
  // always returns 0 (empty-slot sentinel is not a valid name).
  //
  // Refuses:
  //   - not init                    SNC_ERR_NOT_INIT (returns 0)
  // ==========================================================================

  pub let snc_lookup : (u64) -> u64 !{mem} @{} =
    fn (name_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): linear lookup by name_hash. Labels prefixed snc_lk_.",
      block: {
        lea r10, [rip + _snc_state];
        mov rax, [r10 + 0];
        mov r11, 0x5CEA;
        cmp rax, r11;
        jne snc_lk_ni;

        cmp rdi, 0;
        je  snc_lk_zero;

        lea r11, [rip + _snc_names];
        xor rcx, rcx;
      snc_lk_top:
        cmp rcx, 16;
        jae snc_lk_notfound;
        mov rax, [r11 + rcx * 8];
        cmp rax, rdi;
        je  snc_lk_hit;
        add rcx, 1;
        jmp snc_lk_top;

      snc_lk_hit:
        mov rax, rcx;
        add rax, 1;                             // 1-based snap_id
        ret;

      snc_lk_notfound:
        xor rax, rax;
        ret;

      snc_lk_zero:
        xor rax, rax;
        ret;

      snc_lk_ni:
        mov rdi, 0xFFFFEF8F;
        call snc_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snc_create(name_hash) -> u64
  //
  // Freeze the current fs state under `name_hash`. On success returns
  // the 1-based snap_id (chain_head at entry + 1), bumps chain_head,
  // bumps create_count, and adds SNC_LIVE_BLOCKS to refbump_total (the
  // scaffold's accounting for "refcount all live blocks +1").
  //
  // Refuses:
  //   - not init                    SNC_ERR_NOT_INIT
  //   - name_hash == 0              SNC_ERR_BAD_NAME
  //   - chain_head == SNC_MAX       SNC_ERR_CHAIN_FULL
  //   - name already registered     SNC_ERR_DUP_NAME
  //
  // Register plan: 2-push callee-save (rbx = slot idx during search).
  // ==========================================================================

  pub let snc_create : (u64) -> u64 !{mem} @{} =
    fn (name_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-001 (#1388): freeze fs state under name; bump chain_head + refbump. Labels prefixed snc_cr_.",
      block: {
        push rbx;
        push r12;

        lea r10, [rip + _snc_state];
        mov rax, [r10 + 0];
        mov r11, 0x5CEA;
        cmp rax, r11;
        jne snc_cr_ni;

        cmp rdi, 0;
        je  snc_cr_bn;

        mov rbx, rdi;                           // save name_hash

        // Chain-full check up front.
        mov r12, [r10 + 16];                    // chain_head
        mov r11, 16;
        cmp r12, r11;
        jae snc_cr_full;

        // Dup-name scan across ALL SNC_MAX slots (empty slots are 0
        // and cannot match a non-zero name_hash, so this stays correct
        // even after future pruning creates gaps).
        lea r11, [rip + _snc_names];
        xor rcx, rcx;
      snc_cr_dup_top:
        cmp rcx, 16;
        jae snc_cr_dup_done;
        mov rax, [r11 + rcx * 8];
        cmp rax, rbx;
        je  snc_cr_dup;
        add rcx, 1;
        jmp snc_cr_dup_top;

      snc_cr_dup_done:
        // Install name at slot chain_head.
        mov [r11 + r12 * 8], rbx;

        // chain_head++, create_count++, refbump += SNC_LIVE_BLOCKS,
        // last_snap_id = chain_head_at_entry + 1.
        mov rax, r12;
        add rax, 1;                             // new head + snap_id
        mov [r10 + 16], rax;                    // chain_head <- head+1
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;                     // create_count++
        mov r9, [r10 + 32];
        add r9, 4;                              // SNC_LIVE_BLOCKS
        mov [r10 + 32], r9;                     // refbump_total += 4
        mov [r10 + 40], rax;                    // last_snap_id
        jmp snc_cr_out;

      snc_cr_ni:
        mov rdi, 0xFFFFEF8F;
        call snc_set_err;
        xor rax, rax;
        jmp snc_cr_out;
      snc_cr_bn:
        mov rdi, 0xFFFFEF8C;
        call snc_set_err;
        xor rax, rax;
        jmp snc_cr_out;
      snc_cr_full:
        mov rdi, 0xFFFFEF8E;
        call snc_set_err;
        xor rax, rax;
        jmp snc_cr_out;
      snc_cr_dup:
        mov rdi, 0xFFFFEF8D;
        call snc_set_err;
        xor rax, rax;

      snc_cr_out:
        pop r12;
        pop rbx;
        ret
      }
    }
}
