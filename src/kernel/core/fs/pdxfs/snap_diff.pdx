// src/kernel/core/fs/pdxfs/snap_diff.pdx -- R42.M3-003 (#1390)
//
// PDXFS v1 SNAPSHOT -- BOUNDED DIFF BETWEEN TWO SNAPSHOTS.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on the per-block DIFFERENCE between two
// snapshots: given (snap_a, snap_b, cursor), it walks the block
// tables of both snapshots and emits, into a scaffold-local result
// table, up to SND_RESULT_MAX (block_idx, kind) pairs describing
// which blocks were ADDED, REMOVED, or MODIFIED going from A to B.
//
// Bounded output. A single snd_diff call returns at most SND_RESULT_
// MAX entries. When more remain, the caller resumes by re-calling
// with cursor set to snd_next_cursor(). A widening will lift the
// bound to a caller-supplied buffer; the scaffold's semantic (cursor
// in, count out, cursor bumps monotonically) is preserved.
//
// It is a SCAFFOLD (D7). Each snapshot's block table is a flat
// SND_BLOCKS_PER_SNAP-long array of "content hash" u64s where 0 means
// "block absent". A test-only seeder (snd_seed) drives the tables; a
// widening replaces the seeder with a scan of on-disk block tables.
//
// It does NOT read snap_create's chain. snap_id here is 0-based into
// snap_diff's private tables (0 .. SND_MAX_SNAPS-1). Coupling the two
// namespaces is a widening; the scaffold keeps them independent so
// this witness does not have to seed the SnapCreate registry, and a
// diff runs against synthetic per-snapshot block tables the diff
// module owns.
//
// It does NOT own the diff output beyond one call. The result table
// is overwritten on every snd_diff invocation; callers must extract
// entries via snd_result_block_at / snd_result_kind_at BEFORE the
// next call, or park them in caller memory.
//
// It CALLS nothing outside this module. Every dependency (result
// table, per-snapshot tables, cursor state) is local. This keeps the
// witness self-contained and the diff walker easy to reason about.
//
// =============================================================================
// §1  TABLE GEOMETRY
// =============================================================================
//
// SND_MAX_SNAPS         = 4          per-module snapshot capacity.
// SND_BLOCKS_PER_SNAP   = 32         blocks per snapshot table.
// SND_RESULT_MAX        = 256        bounded output per snd_diff call.
//
// _snd_blocks is a flat array of SND_MAX_SNAPS * SND_BLOCKS_PER_SNAP
// u64s (128 slots = 1 KiB). Entry(snap, block) lives at
// _snd_blocks[snap * SND_BLOCKS_PER_SNAP + block].
//
// _snd_result is a flat 2 * SND_RESULT_MAX array of u64s. Entry(i)
// starts at _snd_result[i * 2]:
//   +0    block_idx    the block whose state changed
//   +8    kind         SND_KIND_ADDED / REMOVED / MODIFIED
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _snd_blocks, _snd_result, and _snd_state are written only by
// helpers in this module. tools/build.sh confines relocations against
// each to `core/fs/pdxfs/snap_diff.o`. A second writer would let a
// caller "quiet a difference by planting a matching entry", which
// would smuggle a stale block past a downstream consumer that trusted
// the diff walker.
//
// STATE LAYOUT -- _snd_state : [u64; 8]
//   +0    init_mark        0x5D1F once snd_reset has run
//   +8    err              sticky error latch
//   +16   result_count     entries populated by the most recent diff
//   +24   diff_count       total snd_diff calls that ran to completion
//   +32   next_cursor      block idx to resume from (0 if scan finished)
//   +40   seed_count       total snd_seed calls that mutated a slot
//   +48   reserved
//   +56   reserved
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEF60..0xFFFFEF6F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: snap_mount_ro 0xFFFFEF70..7F (R42.M3-002). Adjacent free
// band below: snap_prune 0xFFFFEF50..5F (R42.M3-004).
//
//   SND_OK               = 0
//   SND_ERR_NOT_INIT     = 0xFFFFEF6F   accessor before snd_reset
//   SND_ERR_BAD_SNAP     = 0xFFFFEF6E   snap_id >= SND_MAX_SNAPS
//   SND_ERR_BAD_CURSOR   = 0xFFFFEF6D   cursor > SND_BLOCKS_PER_SNAP
//   SND_ERR_BAD_IDX      = 0xFFFFEF6C   result entry idx >= result_count
//   SND_ERR_BAD_BLOCK    = 0xFFFFEF6B   block_idx >= SND_BLOCKS_PER_SNAP
//   SND_ERR_INTERNAL     = 0xFFFFEF6A   unreachable-fallthrough tripwire
//
// Kinds:
//
//   SND_KIND_ADDED       = 1   block absent in A, present in B
//   SND_KIND_REMOVED     = 2   block present in A, absent in B
//   SND_KIND_MODIFIED    = 3   block present in both with different hashes
//
// Reserved-label discipline: labels prefixed `snd_`.

module SnapDiff = structure {

  pub let SND_MAX_SNAPS        : u64 = 4
  pub let SND_BLOCKS_PER_SNAP  : u64 = 32
  pub let SND_RESULT_MAX       : u64 = 256

  pub let SND_KIND_ADDED       : u64 = 1
  pub let SND_KIND_REMOVED     : u64 = 2
  pub let SND_KIND_MODIFIED    : u64 = 3

  pub let SND_OK               : u64 = 0
  pub let SND_ERR_NOT_INIT     : u64 = 0xFFFFEF6F
  pub let SND_ERR_BAD_SNAP     : u64 = 0xFFFFEF6E
  pub let SND_ERR_BAD_CURSOR   : u64 = 0xFFFFEF6D
  pub let SND_ERR_BAD_IDX      : u64 = 0xFFFFEF6C
  pub let SND_ERR_BAD_BLOCK    : u64 = 0xFFFFEF6B
  pub let SND_ERR_INTERNAL     : u64 = 0xFFFFEF6A

  pub let SND_INIT_MARK        : u64 = 0x5D1F

  pub let mut _snd_blocks : [u64; 128] = uninit @align(64)
  pub let mut _snd_result : [u64; 512] = uninit @align(64)
  pub let mut _snd_state  : [u64; 8]   = uninit @align(64)

  // ==========================================================================
  // Reset. Clears blocks + result + state; installs init_mark.
  // ==========================================================================

  pub let snd_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): clear per-snap blocks + result + state, install init_mark. Labels prefixed snd_rst_.",
      block: {
        lea r10, [rip + _snd_blocks];
        xor rax, rax;
        xor rcx, rcx;
      snd_rst_b:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  snd_rst_b;

        lea r10, [rip + _snd_result];
        xor rcx, rcx;
      snd_rst_r:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  snd_rst_r;

        lea r10, [rip + _snd_state];
        xor rcx, rcx;
      snd_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  snd_rst_s;

        mov rax, 0x5D1F;
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  pub let snd_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): 1 iff init_mark matches. Labels prefixed snd_bnd_.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 0];
        mov r11, 0x5D1F;
        cmp rax, r11;
        jne snd_bnd_no;
        mov rax, 1;
        ret;
      snd_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let snd_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): sticky error latch readback.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let snd_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): first-writer-wins error latch. Labels prefixed snd_se_.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne snd_se_out;
        mov [r10 + 8], rdi;
      snd_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let snd_capacity_snaps : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M3-003 (#1390): SND_MAX_SNAPS as u64.",
      block: {
        mov rax, 4;
        ret
      }
    } @no_frame

  pub let snd_capacity_blocks : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M3-003 (#1390): SND_BLOCKS_PER_SNAP as u64.",
      block: {
        mov rax, 32;
        ret
      }
    } @no_frame

  pub let snd_result_max : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M3-003 (#1390): SND_RESULT_MAX as u64.",
      block: {
        mov rax, 256;
        ret
      }
    } @no_frame

  pub let snd_result_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): result_count field.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let snd_diff_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): diff_count field.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let snd_next_cursor : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): next_cursor field.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let snd_seed_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): seed_count field.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 40];
        ret
      }
    } @no_frame

  // ==========================================================================
  // snd_block_at(snap_id, block_idx) -> u64
  //
  // Read the content hash of `block_idx` in `snap_id`. 0 iff the
  // block is absent. Refuses:
  //   - not init                        SND_ERR_NOT_INIT
  //   - snap_id >= SND_MAX_SNAPS        SND_ERR_BAD_SNAP
  //   - block_idx >= SND_BLOCKS_PER_SNAP  SND_ERR_BAD_BLOCK
  // ==========================================================================

  pub let snd_block_at : (u64, u64) -> u64 !{mem} @{} =
    fn (snap_id: u64, block_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): read one snapshot's block hash. Labels prefixed snd_ba_.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 0];
        mov r11, 0x5D1F;
        cmp rax, r11;
        jne snd_ba_ni;

        cmp rdi, 4;
        jae snd_ba_bs;
        cmp rsi, 32;
        jae snd_ba_bb;

        // offset = snap * 32 + block
        mov rax, rdi;
        shl rax, 5;                             // * 32
        add rax, rsi;
        lea r11, [rip + _snd_blocks];
        mov rax, [r11 + rax * 8];
        ret;

      snd_ba_ni:
        mov rdi, 0xFFFFEF6F;
        call snd_set_err;
        xor rax, rax;
        ret;
      snd_ba_bs:
        mov rdi, 0xFFFFEF6E;
        call snd_set_err;
        xor rax, rax;
        ret;
      snd_ba_bb:
        mov rdi, 0xFFFFEF6B;
        call snd_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snd_seed(snap_id, block_idx, hash) -> u64
  //
  // Test seeder. Set the content hash of `block_idx` in `snap_id`.
  // hash == 0 clears the slot (block absent). Bumps seed_count.
  // Returns 1 on success. Refuses:
  //   - not init                        SND_ERR_NOT_INIT
  //   - snap_id >= SND_MAX_SNAPS        SND_ERR_BAD_SNAP
  //   - block_idx >= SND_BLOCKS_PER_SNAP  SND_ERR_BAD_BLOCK
  // ==========================================================================

  pub let snd_seed : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (snap_id: u64, block_idx: u64, hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): test seeder for per-snap block hash. Labels prefixed snd_sd_.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 0];
        mov r11, 0x5D1F;
        cmp rax, r11;
        jne snd_sd_ni;

        cmp rdi, 4;
        jae snd_sd_bs;
        cmp rsi, 32;
        jae snd_sd_bb;

        mov rax, rdi;
        shl rax, 5;
        add rax, rsi;
        lea r11, [rip + _snd_blocks];
        mov [r11 + rax * 8], rdx;

        mov r9, [r10 + 40];
        add r9, 1;
        mov [r10 + 40], r9;                     // seed_count++
        mov rax, 1;
        ret;

      snd_sd_ni:
        mov rdi, 0xFFFFEF6F;
        call snd_set_err;
        xor rax, rax;
        ret;
      snd_sd_bs:
        mov rdi, 0xFFFFEF6E;
        call snd_set_err;
        xor rax, rax;
        ret;
      snd_sd_bb:
        mov rdi, 0xFFFFEF6B;
        call snd_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snd_result_block_at(entry_idx) -> u64
  //
  // Read the block_idx of result entry `entry_idx` (0-based). Refuses:
  //   - not init                    SND_ERR_NOT_INIT
  //   - entry_idx >= result_count   SND_ERR_BAD_IDX
  // ==========================================================================

  pub let snd_result_block_at : (u64) -> u64 !{mem} @{} =
    fn (entry_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): read block_idx of result entry. Labels prefixed snd_rb_.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 0];
        mov r11, 0x5D1F;
        cmp rax, r11;
        jne snd_rb_ni;

        mov rax, [r10 + 16];                    // result_count
        cmp rdi, rax;
        jae snd_rb_bi;

        mov rax, rdi;
        shl rax, 1;                             // * 2 (u64 pairs)
        lea r11, [rip + _snd_result];
        mov rax, [r11 + rax * 8];
        ret;

      snd_rb_ni:
        mov rdi, 0xFFFFEF6F;
        call snd_set_err;
        xor rax, rax;
        ret;
      snd_rb_bi:
        mov rdi, 0xFFFFEF6C;
        call snd_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snd_result_kind_at(entry_idx) -> u64
  //
  // Read the kind of result entry `entry_idx` (0-based). Refuses:
  //   - not init                    SND_ERR_NOT_INIT
  //   - entry_idx >= result_count   SND_ERR_BAD_IDX
  // ==========================================================================

  pub let snd_result_kind_at : (u64) -> u64 !{mem} @{} =
    fn (entry_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): read kind of result entry. Labels prefixed snd_rk_.",
      block: {
        lea r10, [rip + _snd_state];
        mov rax, [r10 + 0];
        mov r11, 0x5D1F;
        cmp rax, r11;
        jne snd_rk_ni;

        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae snd_rk_bi;

        mov rax, rdi;
        shl rax, 1;
        add rax, 1;
        lea r11, [rip + _snd_result];
        mov rax, [r11 + rax * 8];
        ret;

      snd_rk_ni:
        mov rdi, 0xFFFFEF6F;
        call snd_set_err;
        xor rax, rax;
        ret;
      snd_rk_bi:
        mov rdi, 0xFFFFEF6C;
        call snd_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snd_diff(snap_a, snap_b, cursor) -> u64
  //
  // Walk block indices [cursor .. SND_BLOCKS_PER_SNAP) comparing
  // _snd_blocks[a][i] against _snd_blocks[b][i]. For each pair that
  // differs, append (i, kind) to _snd_result. Stop when the result
  // table would overflow SND_RESULT_MAX; the block that would have
  // been added is left for the next call and next_cursor is set to
  // that block index. If the scan completes, next_cursor is set to
  // SND_BLOCKS_PER_SNAP (== capacity) so the caller can tell "done"
  // from "more remaining".
  //
  // Returns result_count.
  //
  // Refuses:
  //   - not init                        SND_ERR_NOT_INIT
  //   - snap_a >= SND_MAX_SNAPS         SND_ERR_BAD_SNAP
  //   - snap_b >= SND_MAX_SNAPS         SND_ERR_BAD_SNAP
  //   - cursor > SND_BLOCKS_PER_SNAP    SND_ERR_BAD_CURSOR
  //
  // Register plan: 4-push callee-save. rbx = block idx cursor,
  // rbp = result idx, r12 = snap_a base offset, r13 = snap_b base
  // offset. r14/r15 not needed. Odd number of pushes plus the
  // implicit return address keeps rsp % 16 == 0 across the recursive
  // call to snd_set_err.
  // ==========================================================================

  pub let snd_diff : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (snap_a: u64, snap_b: u64, cursor: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-003 (#1390): walk two snapshot tables, emit bounded diff. Labels prefixed snd_df_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;

        lea r10, [rip + _snd_state];
        mov rax, [r10 + 0];
        mov r11, 0x5D1F;
        cmp rax, r11;
        jne snd_df_ni;

        cmp rdi, 4;
        jae snd_df_bs;
        cmp rsi, 4;
        jae snd_df_bs;
        mov r11, 32;
        cmp rdx, r11;
        ja  snd_df_bc;

        // Compute per-snap base offsets (in u64 units).
        mov rax, rdi;
        shl rax, 5;                             // snap_a * 32
        mov r12, rax;
        mov rax, rsi;
        shl rax, 5;                             // snap_b * 32
        mov r13, rax;

        // Clear result_count and next_cursor.
        xor rax, rax;
        mov [r10 + 16], rax;
        mov [r10 + 32], rax;

        mov rbx, rdx;                           // block cursor
        xor rbp, rbp;                           // result idx = 0

      snd_df_top:
        mov r11, 32;
        cmp rbx, r11;
        jae snd_df_done;

        // Read a[rbx] and b[rbx].
        lea r11, [rip + _snd_blocks];
        mov rax, r12;
        add rax, rbx;
        mov r8, [r11 + rax * 8];                // hash_a
        mov rax, r13;
        add rax, rbx;
        mov r9, [r11 + rax * 8];                // hash_b

        // Classify.
        cmp r8, r9;
        je  snd_df_skip;                        // identical
        cmp r8, 0;
        je  snd_df_added;                       // a absent -> added
        cmp r9, 0;
        je  snd_df_removed;                     // b absent -> removed
        // both present, different: modified
        mov r9, 3;
        jmp snd_df_emit;

      snd_df_added:
        mov r9, 1;
        jmp snd_df_emit;

      snd_df_removed:
        mov r9, 2;
        // fallthrough to emit

      snd_df_emit:
        // Overflow check: rbp == 256 means the table is full and this
        // block is the first one deferred to the next call.
        mov r11, 256;
        cmp rbp, r11;
        jae snd_df_overflow;

        // _snd_result[rbp * 2 + 0] = rbx (block idx)
        // _snd_result[rbp * 2 + 1] = r9  (kind)
        lea r11, [rip + _snd_result];
        mov rax, rbp;
        shl rax, 1;
        mov [r11 + rax * 8], rbx;
        add rax, 1;
        mov [r11 + rax * 8], r9;
        add rbp, 1;

      snd_df_skip:
        add rbx, 1;
        jmp snd_df_top;

      snd_df_done:
        // Scan finished; next_cursor = 32 (== capacity, signals done).
        lea r10, [rip + _snd_state];
        mov [r10 + 16], rbp;                    // result_count
        mov rax, 32;
        mov [r10 + 32], rax;                    // next_cursor := SND_BLOCKS_PER_SNAP
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;                     // diff_count++
        mov rax, rbp;
        jmp snd_df_out;

      snd_df_overflow:
        // Result full; parked cursor points at rbx (the block that
        // would have been emitted). Caller resumes with cursor = rbx.
        lea r10, [rip + _snd_state];
        mov [r10 + 16], rbp;                    // result_count == 256
        mov [r10 + 32], rbx;                    // next_cursor := rbx
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;                     // diff_count++
        mov rax, rbp;
        jmp snd_df_out;

      snd_df_ni:
        mov rdi, 0xFFFFEF6F;
        call snd_set_err;
        xor rax, rax;
        jmp snd_df_out;
      snd_df_bs:
        mov rdi, 0xFFFFEF6E;
        call snd_set_err;
        xor rax, rax;
        jmp snd_df_out;
      snd_df_bc:
        mov rdi, 0xFFFFEF6D;
        call snd_set_err;
        xor rax, rax;

      snd_df_out:
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
