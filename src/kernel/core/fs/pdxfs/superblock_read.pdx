// src/kernel/core/fs/pdxfs/superblock_read.pdx -- R52.M2-001 (#1686)
//
// PDXFS-ON-BLOCK v1 -- SUPERBLOCK READ (BDEV-backed).
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Per design/filesystem/r52-implementation-plan.md §2.2 step 1: land
// `sb_read(bdev_cap) -> sb_block_ptr | err`. Issues `BDEV_OP_READ_LBA(0)`
// against the caller-supplied `KIND_BLKDEV` cap slot, checks
// `magic == 0x42584450`, `version == 1`, `block_size == 4096`, and that
// `_reserved` is all-zero; returns a typed error otherwise. This is the
// FIRST caller in this kernel of the R51.M3 `BDEV_OP_READ_LBA` cap path
// from filesystem code -- everything before this landing (bdev_write.pdx,
// renamed from nvme_write.pdx at R51.M7-005 / #1673, R42.M5) is a
// pre-cap SQ/CQ accounting scaffold, not a live device read.
//
// This module owns no BDEV I/O policy beyond "read LBA 0, validate the
// frozen v1 fields". It does NOT validate region layout, root_inode, or
// sig_scope -- those are `superblock.pdx`'s (#1682) `sb_validate_regions`
// / `sb_validate_root_inode` / `sb_validate_sig_scope`, reachable via
// `sb_validate_all` for a caller that wants the full 8-check gate (e.g. a
// future mount path). §2.2's own scope line for #1686 names exactly four
// checks (magic/version/block_size/reserved) -- the same subset
// `mkfs.pdxfs --upgrade` (#1689) needs when probing an EXISTING device
// that may still carry the R25 "PDXL" lite-format magic: a full 8-check
// gate would be meaningless there (region/root_inode fields are whatever
// the OLD format happened to leave behind at those offsets). Flagged here
// (mirroring #1682's own design-doc-gap note style) so a later milestone
// that wants the full gate reaches for `sb_validate_all` explicitly rather
// than assuming `sb_read` already ran it.
//
// It does NOT verify the ML-DSA-65 signature -- that is the volume-probe
// discovery flow's job (design/filesystem/volume-fs-substrate.md §3.1
// step 4, landed at R52.M5 `probe.pdx`, #1706), which holds the
// loader-supplied `KIND_SIG_KEY` this module has no access to.
//
// -----------------------------------------------------------------------------
// Calling convention (design/hardware/nvme-io-queues.md §3.5,
// src/kernel/core/cap/cap_handler_blkdev.pdx header + src/kernel/core/
// cap/invoke.pdx)
// -----------------------------------------------------------------------------
//
// `cap_invoke(slot: u64, op_arg: u64) -> u64` (rdi=slot, rsi=op_arg) is
// the caller-facing entry point; it bounds-checks `slot` and delegates to
// `cap_invoke_dispatch`, which demuxes on cap kind and reaches
// `cap_handler_blkdev` for a `KIND_BLKDEV` (0x42) cap. `op_arg` packs:
//   bits [7:0]    op_code        BDEV_OP_READ_LBA = 3
//   bits [11:8]   reserved       MUST be 0
//   bits [63:12]  page_number    descriptor-page address (4-KiB aligned)
// The descriptor page (only consulted for READ_LBA/WRITE_LBA/FLUSH) is a
// caller-owned 32-byte, 4-KiB-aligned scratch:
//   +0    lba        (u64)
//   +8    nblocks    (u64)
//   +16   dma_iova   (u64)   destination buffer for the read
//   +24   status_out (u64)   raw driver return, written back by the handler
// `cap_invoke` itself returns `BDEV_ERR_OK` (0) on success, else one of
// the handler's own sentinels (`BDEV_ERR_*`) or a forwarded driver
// failure code. This module treats ANY non-zero return as a single
// generic `PDXB_SB_READ_BDEV_ERR` -- the FS-level error taxonomy this
// module owns does not attempt to re-express every possible NVMe/AHCI/
// cap-layer failure; a caller that needs the underlying code can read
// `_sb_read_desc[+24]` (status_out) directly. Proven idiom for building
// `op_arg` from a page-aligned descriptor address:
// `tests/kernel/nvme/kind_nvme_io_queues_synth.pdx` lines ~602-617
// (`mov rdi, r14; mov r10, 3; or rdi, r10; mov rsi, rdi; mov rdi, <slot>;
// call cap_invoke`).
//
// -----------------------------------------------------------------------------
// Storage
// -----------------------------------------------------------------------------
//
// `_sb_read_buf`  : [u64; 512] @align(4096) -- the 4-KiB block landing
//                   zone for the just-read superblock. Matches
//                   `PDXB_SB_SIZE`/`PDXB_SB_QWORDS` (superblock_fmt.pdx).
// `_sb_read_desc` : [u64; 4]   @align(4096) -- the READ_LBA descriptor
//                   page. Must itself be 4-KiB aligned: `op_arg` ORs the
//                   op_code into the low 12 bits of this address, so any
//                   nonzero low bits would corrupt the packed page number
//                   (cap_handler_blkdev.pdx's own header comment).
// Both are single-writer state, written only by `sb_read` in this file --
// confined at build time (`tools/build.sh` `ec_confine_one`) to
// `core/fs/pdxfs/superblock_read.o`, matching the convention every other
// new `_*` table in `core/fs/pdxfs/` already follows (wal.pdx, cow_read.pdx,
// snap_create.pdx, ...).
//
// -----------------------------------------------------------------------------
// Failure taxonomy -- 0xFFFFED08 (M2 sub-slice; see
// design/filesystem/r52-implementation-plan.md §4/§7.2)
// -----------------------------------------------------------------------------
//
// `superblock_fmt.pdx` (#1681) reserved band 0xFFFFED08..0xFFFFED4F for
// R52.M2..M8 without defining the individual codes ("These sentinels are
// frozen here (constants only) ahead of the validation logic that
// returns them"). This module claims the FIRST slot of that reservation:
//
//   PDXB_SB_READ_BDEV_ERR = 0xFFFFED08   BDEV_OP_READ_LBA did not return
//                                        BDEV_ERR_OK (0)
//
// Magic/version/block_size/reserved failures are NOT re-declared here --
// they forward the M1 codes verbatim from `superblock.pdx` (#1682):
// `PDXB_SB_MAGIC_BAD` (ED00), `PDXB_SB_VERSION_BAD` (ED01),
// `PDXB_SB_BLOCK_SIZE_BAD` (ED02), `PDXB_SB_RESERVED_NONZERO` (ED03).
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §3.5)
// -----------------------------------------------------------------------------
//
// `sb_read(bdev_cap) -> sb_block_ptr | err`, arity 1 -- exactly the
// plan's signature. No collapse needed.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// `sb_read` issues nested calls (`cap_invoke` + up to four `sb_validate_*`
// calls), so it takes the uniform 5-push callee-save prologue this kernel
// uses for that shape (`fs/vfs_read.pdx`, `fs/vfs_close.pdx`,
// `superblock.pdx`'s `sb_validate_all`): rbx=bdev_cap (consumed once),
// r12=&_sb_read_desc, r13=&_sb_read_buf (kept live across every
// `sb_validate_*` call as both the argument and the eventual success
// return value), r14/r15 unused but pushed for pattern uniformity. 5
// pushes from a SysV-entry rsp%16==8 land rsp%16==0, satisfying alignment
// for every nested `call` with no extra `sub rsp, 8`.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access in this module (the descriptor page and the
// superblock buffer are both accessed as whole qwords or via `lea`
// address computation only -- the actual field-level `_reserved` scan
// lives in `superblock.pdx`'s `sb_validate_reserved`, called by pointer,
// not duplicated here). No `test` instruction anywhere; every branch uses
// `cmp reg, imm`/`cmp reg, reg` + `je`/`jne`. Every label is prefixed
// `sb_read_` (labels are local to this file's function; no collision
// with `superblock.pdx`'s own `sb_validate_*_ok`/`_bad` labels in a
// different translation unit).

module SuperblockRead = structure {

  // ============================================================================
  // M2 failure taxonomy -- first slot of the reserved 0xFFFFED08..ED4F band.
  // ============================================================================

  pub let PDXB_SB_READ_BDEV_ERR : u64 = 0xFFFFED08

  // ============================================================================
  // Storage.
  // ============================================================================

  // 512 qwords = 4096 bytes: the landing zone for the just-read block.
  pub let mut _sb_read_buf  : [u64; 512] = uninit @align(4096)

  // 4 qwords: {lba, nblocks, dma_iova, status_out}. Must be 4-KiB aligned
  // (see header note) even though only 32 bytes are used.
  pub let mut _sb_read_desc : [u64; 4]   = uninit @align(4096)

  // ============================================================================
  // sb_read(bdev_cap: u64) -> u64
  //   Success: returns &_sb_read_buf (the 4-KiB buffer holding the just-read,
  //   validated superblock). Failure: returns PDXB_SB_READ_BDEV_ERR (bdev
  //   I/O did not report BDEV_ERR_OK) or one of PDXB_SB_MAGIC_BAD /
  //   PDXB_SB_VERSION_BAD / PDXB_SB_BLOCK_SIZE_BAD / PDXB_SB_RESERVED_NONZERO
  //   forwarded verbatim from superblock.pdx's per-field validators.
  // ============================================================================

  pub let sb_read : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { cap },
      justification: "R52.M2-001 (#1686). 5-push callee-save prologue (rbx/r12/r13/r14/r15) lands rsp%16==0 for the nested cap_invoke + sb_validate_* calls (superblock.pdx sb_validate_all pattern); entry rsp%16==8 + 40 B of pushes = 48, %16==0, no extra sub rsp needed. Body: (1) rbx = bdev_cap (rdi). (2) r12 = &_sb_read_desc (lea rip-relative, proven idiom throughout this kernel). (3) Stamp the READ_LBA descriptor: [r12+0]=lba=0 (xor rax,rax; mov [r12+0],rax), [r12+8]=nblocks=1 (mov rax,1; mov [r12+8],rax), r13 = &_sb_read_buf (lea) then [r12+16]=dma_iova=r13 (mov [r12+16],r13), [r12+24]=status_out=0 (xor rax,rax; mov [r12+24],rax). (4) rdi=rbx (bdev_cap slot); rsi=r12 OR'd with op_code 3 (BDEV_OP_READ_LBA) via mov r10,3; or rsi,r10 -- r12's low 12 bits are guaranteed zero by @align(4096), matching kind_nvme_io_queues_synth.pdx's proven op_arg-packing idiom (lines ~602-617). call cap_invoke. (5) cmp rax,0; jne sb_read_bdev_err (any non-zero cap_invoke result maps to the single generic PDXB_SB_READ_BDEV_ERR -- see header note on why finer-grained forwarding is out of scope here). (6) Four validator calls, each reloading rdi=r13 (rdi is caller-save, r13 is callee-save and stays live across every call): call sb_validate_magic; cmp rax,0; jne sb_read_done (forwards the sub-check's rax verbatim, matching sb_validate_all's own short-circuit idiom). Then sb_validate_version, sb_validate_block_size, sb_validate_reserved in the same shape, in M1 band order (ED00, ED01, ED02, ED03) per §4's 'lower code = more common' discipline. (7) All four pass: mov rax, r13 (return the validated buffer pointer); jmp sb_read_done. sb_read_bdev_err: mov rax, 0xFFFFED08 (PDXB_SB_READ_BDEV_ERR; matches superblock.pdx's proven mov rax,<imm64-fitting-sentinel> idiom used for 0xFFFFED00..07). sb_read_done: 5-pop epilogue (r15,r14,r13,r12,rbx) + ret. No test instruction; no mov_b (every access here is whole-qword or address computation). Reserved labels: sb_read_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // bdev_cap

        lea r12, [rip + _sb_read_desc];
        xor rax, rax;
        mov [r12 + 0], rax;              // lba = 0
        mov rax, 1;
        mov [r12 + 8], rax;              // nblocks = 1
        lea r13, [rip + _sb_read_buf];
        mov [r12 + 16], r13;             // dma_iova = &_sb_read_buf
        xor rax, rax;
        mov [r12 + 24], rax;             // status_out = 0

        mov rdi, rbx;
        mov rsi, r12;
        mov r10, 3;                      // BDEV_OP_READ_LBA
        or  rsi, r10;
        call cap_invoke;
        cmp rax, 0;
        jne sb_read_bdev_err;

        mov rdi, r13;
        call sb_validate_magic;
        cmp rax, 0;
        jne sb_read_done;

        mov rdi, r13;
        call sb_validate_version;
        cmp rax, 0;
        jne sb_read_done;

        mov rdi, r13;
        call sb_validate_block_size;
        cmp rax, 0;
        jne sb_read_done;

        mov rdi, r13;
        call sb_validate_reserved;
        cmp rax, 0;
        jne sb_read_done;

        mov rax, r13;
        jmp sb_read_done;

      sb_read_bdev_err:
        mov rax, 0xFFFFED08;

      sb_read_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
