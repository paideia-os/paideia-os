// src/kernel/core/fs/pdxfs/journal_replay.pdx -- R42.M2-003 (#1386),
// widened R52.M5-003 (#1705)
//
// PDXFS v1 JOURNAL -- REPLAY ON MOUNT (IN-MEMORY WAL-RING CLASSIFIER,
// §1-§3 below, UNCHANGED since #1386) + ON-DISK JBNL WALKER (§4, thin
// wrapper added by #1705).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on mount-time recovery: given a checkpoint index
// (the WAL position at which the last successful mount completed), it
// walks every WAL record from checkpoint..head and IDEMPOTENTLY assigns
// one of three outcomes to each:
//
//   APPLIED    (state = 1) -- the record's tx has a commit marker in
//                              the fence table; the mount path may
//                              re-apply its block writes.
//   DISCARDED  (state = 2) -- no commit marker exists; the tx never
//                              observed durable, so its block writes
//                              (if any reached disk) must be forgotten.
//   PENDING    (state = 0) -- the record has not yet been visited.
//
// The scaffold does NOT actually re-issue block writes; a real walker
// hands each APPLIED record to cow_write.pdx. The scaffold's semantic
// is CLASSIFICATION -- the counts + per-record state the mount path
// consumes.
//
// It is IDEMPOTENT. jrp_replay may be called any number of times with
// the same WAL + commit table and produce the same classification.
// A widening runs it once at mount, but the idempotency is a property
// the on-disk widening preserves.
//
// It is a SCAFFOLD (D7). The state table is a parallel array to the
// WAL ring; a widening streams the classification into the mount path
// rather than materialising it.
//
// It does NOT own the WAL or the commit table. wal.pdx §1 owns the
// ring; journal_fence.pdx §1 owns the commit table. This module reads
// both via their public accessors and writes only its own state array.
//
// It does NOT verify checksums. journal_csum.pdx enforces the tear-
// detection refusal; this module refuses to CALL jrp_replay on a
// checkpoint past head (a bad-checkpoint refusal), but a widening
// will consult jcs_check_replay_eligible before assigning APPLIED.
//
// =============================================================================
// §1  STATE TABLE GEOMETRY
// =============================================================================
//
// JRP_MAX_RECORDS      = 64        table capacity (mirrors WAL_MAX).
//
// _jrp_state_at is a flat array of JRP_MAX_RECORDS u64s. Each slot
// mirrors the WAL record at the same index; jrp_reset zeros the array
// (all PENDING) and jrp_replay writes APPLIED or DISCARDED into
// [checkpoint..head).
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _jrp_state_at and _jrp_state are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/fs/pdxfs/journal_replay.o`. A second writer would let a caller
// "mark a record APPLIED without observing a commit", which would let
// the mount path re-apply block writes for an uncommitted tx.
//
// STATE LAYOUT -- _jrp_state : [u64; 8]
//   +0    init_mark          0xEA9E once jrp_reset has run
//   +8    err                sticky error latch
//   +16   scan_count         total jrp_scan_from calls
//   +24   replay_count       total jrp_replay calls
//   +32   last_applied       APPLIED records classified by the last replay
//   +40   last_discarded     DISCARDED records classified by the last replay
//   +48   last_checkpoint    checkpoint index the last replay was given
//   +56   last_replayed_seq  seq of the highest APPLIED record from last replay
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEFA0..0xFFFFEFAF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: journal_fence 0xFFFFEFB0..BF (R42.M2-002). Adjacent free band
// below: journal_csum 0xFFFFEF90..9F (R42.M2-004).
//
//   JRP_OK               = 0
//   JRP_ERR_NOT_INIT     = 0xFFFFEFAF   accessor before jrp_reset
//   JRP_ERR_BAD_CHECK    = 0xFFFFEFAE   checkpoint > wal_head
//   JRP_ERR_BAD_IDX      = 0xFFFFEFAD   accessor: idx >= JRP_MAX_RECORDS
//   JRP_ERR_INTERNAL     = 0xFFFFEFAC   unreachable-fallthrough tripwire
//
//   JRP_STATE_PENDING    = 0
//   JRP_STATE_APPLIED    = 1
//   JRP_STATE_DISCARDED  = 2
//
// Reserved-label discipline: labels prefixed `jrp_`.
//
// =============================================================================
// §4  R52.M5-003 (#1705) -- ON-DISK JBNL WALKER ADDED AS A THIN WRAPPER
// =============================================================================
//
// Design authority: design/filesystem/r52-implementation-plan.md §M5-003
// ("Rewrite journal_replay.pdx to walk on-disk JBNL blocks per §4.3...")
// + design/filesystem/volume-fs-substrate.md §2.4 (JBNL block layout) and
// §4.3 (recovery-on-mount sequencing). §M5-002 (#1704, journal_ondisk.pdx)
// landed FIRST and already contains a complete, real, on-disk JBNL walker
// -- a function also named `journal_replay` (5-arg: bdev_cap, vol_slot,
// journal_lba, journal_bcount, checkpoint_lba), plus six stat accessors
// (`journal_replay_applied_count` / `_discarded_count` / `_blocks_visited`
// / `_head_lba` / `_err` / `_orphan_count`) -- because §4.3's cold-boot
// sequencing (head discovery by seq scan, backward walk to checkpoint,
// forward CSUM-verified walk, per-record op-code classification) shares
// its state and constants (JNL_MAGIC, the 4096-B block layout, the CRC32C
// helper) with that module's writer (`journal_append`). #1704's own
// header flagged the resulting question explicitly for softarch: should
// #1705 retire THIS file in favour of journal_ondisk.pdx's walker, or
// make this file a thin wrapper over it?
//
// DECISION (#1705): thin wrapper, NOT retirement. Two real, already-
// landed dependents exercise this file's ORIGINAL §1/§2 in-memory
// WAL-ring-index classifier surface (`jrp_reset`, `jrp_replay`,
// `jrp_scan_from`, `jrp_state_at`, `jrp_last_applied`,
// `jrp_last_discarded`, etc.) and would need to be rewired as part of
// any retirement -- explicitly OUT OF SCOPE for a "rewrite
// journal_replay.pdx" issue:
//
//   1. src/kernel/core/cap/mount_replay_digest.pdx's `mrd_digest_compute`
//      folds `jrp_last_applied` + `jrp_last_discarded` directly. That
//      file's own §0 names this a deliberate placeholder pending a
//      FUTURE widening once R52.M5-003 lands ("a follow-up widens
//      mrd_digest_compute... field-for-field without changing this
//      file's comparator or failure code") -- i.e. that rewiring is its
//      own follow-up commit against R51.M8-003 (#1677), not this one.
//   2. tests/kernel/fs/pdxfs/journal_replay_synth.pdx witnesses the full
//      original jrp_* surface (reset/bound/err/scan_count/replay_count/
//      last_applied/last_discarded/last_checkpoint/last_replayed_seq/
//      state_at/scan_from/replay) against wal.pdx's in-memory ring +
//      journal_fence.pdx's commit table -- an R42 in-memory model with
//      no on-disk block device involved at all. On-disk JBNL block
//      semantics (per-block CSUM, backward walk to a checkpoint LBA,
//      per-txn open/commit/abort classification across many records)
//      have no faithful 1:1 mapping onto this test's per-WAL-INDEX
//      PENDING/APPLIED/DISCARDED state table; reinterpreting jrp_replay's
//      existing 1-arg signature to mean "walk this disk" would silently
//      break every existing assertion in that witness with no on-disk
//      fixture backing it.
//   3. tools/build.sh's R42.M2 confinement gate (`ec_confine_one` on
//      `_jrp_state_at` / `_jrp_state`, restricted to this file's own
//      `.o`) and arity pins (`semterm_pin_one` on `jrp_scan_from`,
//      `jrp_replay`, `jrp_state_at`) are literal-text / relocation
//      checks against THIS file's existing declarations; changing those
//      signatures or deleting that state fails the build outright unless
//      build.sh itself is edited in the same commit -- a second-file
//      change the design doc's own "Files edited" list for #1705 does
//      NOT name (compare #1704's entry, which explicitly names
//      "tools/build.sh (confine every new `_*_table` / `_*_stats`)" for
//      journal_ondisk.pdx's NEW state only).
//
// So: §1/§2/§3 above and every `jrp_*` function through `jrp_replay`
// (the original R42.M2-003 landing) are UNCHANGED -- same signatures,
// same state layout, same failure codes, same callers, same witness.
// What #1705 ADDS is a second surface below, `jrp_ondisk_*`, that
// satisfies the design doc's literal ask ("walk on-disk JBNL blocks")
// as true thin wrappers: each is a straight-line `sub rsp,8; call
// <journal_ondisk.pdx entry point>; add rsp,8; ret` forward with ZERO
// register shuffling (the wrapper's own arg registers already match the
// wrapped function's ABI slots exactly, since the signatures are copied
// verbatim) and zero added state -- this file still owns no bytes of
// `_journal_vol_state` / `_journal_replay_*` (those remain confined to
// journal_ondisk.o). `jrp_ondisk_replay` IS §4.3's real cold-boot
// walker; a future probe.pdx/mount.pdx (#1706/#1707, not yet landed --
// the volume registry that would supply a real bdev_cap/vol_slot/
// journal_lba/journal_bcount) may call it here for discoverability by
// this file's name, or call journal_ondisk.pdx's `journal_replay`
// directly (both names resolve to the identical on-disk walk;
// `jrp_ondisk_replay` only forwards).

module JournalReplay = structure {

  pub let JRP_MAX_RECORDS      : u64 = 64

  pub let JRP_OK               : u64 = 0
  pub let JRP_ERR_NOT_INIT     : u64 = 0xFFFFEFAF
  pub let JRP_ERR_BAD_CHECK    : u64 = 0xFFFFEFAE
  pub let JRP_ERR_BAD_IDX      : u64 = 0xFFFFEFAD
  pub let JRP_ERR_INTERNAL     : u64 = 0xFFFFEFAC

  pub let JRP_STATE_PENDING    : u64 = 0
  pub let JRP_STATE_APPLIED    : u64 = 1
  pub let JRP_STATE_DISCARDED  : u64 = 2

  pub let JRP_INIT_MARK        : u64 = 0xEA9E

  pub let mut _jrp_state_at : [u64; 64] = uninit @align(64)
  pub let mut _jrp_state    : [u64; 8]  = uninit @align(64)

  // ==========================================================================
  // Reset. Clears state table + counters; installs init_mark.
  // ==========================================================================

  pub let jrp_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): clear state table + counters, install init_mark. Labels prefixed jrp_rst_.",
      block: {
        lea r10, [rip + _jrp_state_at];
        xor rax, rax;
        xor rcx, rcx;
      jrp_rst_a:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  jrp_rst_a;

        lea r10, [rip + _jrp_state];
        xor rcx, rcx;
      jrp_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  jrp_rst_s;

        mov rax, 0xEA9E;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let jrp_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): 1 iff init_mark matches. Labels prefixed jrp_bnd_.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA9E;
        cmp rax, r11;
        jne jrp_bnd_no;
        mov rax, 1;
        ret;
      jrp_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let jrp_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): sticky error latch readback.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let jrp_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): first-writer-wins error latch. Labels prefixed jrp_se_.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne jrp_se_out;
        mov [r10 + 8], rdi;
      jrp_se_out:
        ret
      }
    }

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let jrp_scan_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): scan_count field.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let jrp_replay_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): replay_count field.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let jrp_last_applied : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): last_applied field.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let jrp_last_discarded : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): last_discarded field.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let jrp_last_checkpoint : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): last_checkpoint field.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let jrp_last_replayed_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): last_replayed_seq field.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  // ==========================================================================
  // jrp_state_at(idx) -> u64
  //
  // Read the classification (PENDING/APPLIED/DISCARDED) at position
  // idx. Refuses:
  //   - not init                    JRP_ERR_NOT_INIT
  //   - idx >= JRP_MAX_RECORDS      JRP_ERR_BAD_IDX
  // ==========================================================================

  pub let jrp_state_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): read classification at idx. Labels prefixed jrp_sa_.",
      block: {
        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA9E;
        cmp rax, r11;
        jne jrp_sa_ni;

        mov r11, 64;
        cmp rdi, r11;
        jae jrp_sa_bi;

        lea r11, [rip + _jrp_state_at];
        mov rax, [r11 + rdi * 8];
        ret;

      jrp_sa_ni:
        mov rdi, 0xFFFFEFAF;
        call jrp_set_err;
        xor rax, rax;
        ret;
      jrp_sa_bi:
        mov rdi, 0xFFFFEFAD;
        call jrp_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // jrp_scan_from(checkpoint) -> u64
  //
  // Count records the walker WOULD visit. Returns wal_head - checkpoint
  // (or 0 if checkpoint == head). No classification is performed; this
  // is the pre-flight the mount path uses for sizing.
  //
  // Refuses:
  //   - not init                    JRP_ERR_NOT_INIT
  //   - checkpoint > wal_head       JRP_ERR_BAD_CHECK
  // ==========================================================================

  pub let jrp_scan_from : (u64) -> u64 !{mem} @{} =
    fn (checkpoint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): pre-flight scan count. Labels prefixed jrp_sf_.",
      block: {
        push rbx;

        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA9E;
        cmp rax, r11;
        jne jrp_sf_ni;

        mov rbx, rdi;                           // checkpoint

        // scan_count++
        mov r9, [r10 + 16];
        add r9, 1;
        mov [r10 + 16], r9;

        call wal_head;
        cmp rbx, rax;
        ja  jrp_sf_bc;

        sub rax, rbx;                           // head - checkpoint
        jmp jrp_sf_out;

      jrp_sf_ni:
        mov rdi, 0xFFFFEFAF;
        call jrp_set_err;
        xor rax, rax;
        jmp jrp_sf_out;
      jrp_sf_bc:
        mov rdi, 0xFFFFEFAE;
        call jrp_set_err;
        xor rax, rax;

      jrp_sf_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // jrp_replay(checkpoint) -> u64
  //
  // Walk [checkpoint..wal_head) and classify each record. Refuses on
  // checkpoint > head (BAD_CHECK) or not init (NOT_INIT). Idempotent:
  // running twice on the same WAL + commit table yields the same table.
  //
  // For each WAL index idx in the range:
  //   - fetch seq = wal_seq_at(idx)
  //   - if jfn_is_committed(seq) -> _jrp_state_at[idx] = APPLIED
  //     applied++; last_replayed_seq = max(prev, seq)
  //   - else                     -> _jrp_state_at[idx] = DISCARDED
  //     discarded++
  //
  // Records outside [checkpoint..head) are left PENDING by this call
  // (idempotency: a prior call may have written APPLIED/DISCARDED into
  // [0..checkpoint), which this call must preserve).
  //
  // Returns the number of applied records.
  //
  // Register plan: 4-push callee-save + 8 pad. rbx = idx cursor,
  // rbp = applied, r12 = discarded, r13 = last_replayed_seq.
  // ==========================================================================

  pub let jrp_replay : (u64) -> u64 !{mem} @{} =
    fn (checkpoint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M2-003 (#1386): classify [checkpoint..head). Labels prefixed jrp_r_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;

        lea r10, [rip + _jrp_state];
        mov rax, [r10 + 0];
        mov r11, 0xEA9E;
        cmp rax, r11;
        jne jrp_r_ni;

        mov rbx, rdi;                           // checkpoint

        call wal_head;
        mov r9, rax;                            // head
        cmp rbx, r9;
        ja  jrp_r_bc;

        // replay_count++, last_checkpoint := checkpoint.
        lea r10, [rip + _jrp_state];
        mov r8, [r10 + 24];
        add r8, 1;
        mov [r10 + 24], r8;
        mov [r10 + 48], rbx;

        xor rbp, rbp;                           // applied
        xor r12, r12;                           // discarded
        xor r13, r13;                           // last_replayed_seq

      jrp_r_top:
        call wal_head;
        mov r9, rax;
        cmp rbx, r9;
        jae jrp_r_done;

        mov rdi, rbx;
        call wal_seq_at;
        mov rdi, rax;                           // rdi = seq (arg to next call)

        call jfn_is_committed;
        cmp rax, 0;
        je  jrp_r_disc;

        // APPLIED. Re-fetch seq for last_replayed_seq update.
        mov rax, 1;
        lea r11, [rip + _jrp_state_at];
        mov [r11 + rbx * 8], rax;
        add rbp, 1;
        mov rdi, rbx;
        call wal_seq_at;
        cmp rax, r13;
        jbe jrp_r_no_bump;
        mov r13, rax;
      jrp_r_no_bump:
        add rbx, 1;
        jmp jrp_r_top;

      jrp_r_disc:
        // DISCARDED.
        mov rax, 2;
        lea r11, [rip + _jrp_state_at];
        mov [r11 + rbx * 8], rax;
        add r12, 1;
        add rbx, 1;
        jmp jrp_r_top;

      jrp_r_done:
        lea r10, [rip + _jrp_state];
        mov [r10 + 32], rbp;                    // last_applied
        mov [r10 + 40], r12;                    // last_discarded
        mov [r10 + 56], r13;                    // last_replayed_seq
        mov rax, rbp;
        jmp jrp_r_out;

      jrp_r_ni:
        mov rdi, 0xFFFFEFAF;
        call jrp_set_err;
        xor rax, rax;
        jmp jrp_r_out;
      jrp_r_bc:
        mov rdi, 0xFFFFEFAE;
        call jrp_set_err;
        xor rax, rax;

      jrp_r_out:
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // R52.M5-003 (#1705): ON-DISK JBNL WALKER -- THIN WRAPPERS OVER
  // journal_ondisk.pdx (#1704). See §4 above for the retire-vs-wrap
  // decision. Every function below is a true pass-through: same arg
  // registers in, same rax out, zero local state, zero branches.
  // Alignment: this file's entry convention leaves rsp%16==8 at entry
  // (SysV); zero pushes is an EVEN push count, so each wrapper pads
  // with `sub rsp,8` before its one nested call and `add rsp,8` after,
  // per journal_ondisk.pdx's own documented even/odd push-count rule.
  // Reserved labels: none needed (straight-line, no branches).
  // ==========================================================================

  // jrp_ondisk_replay(bdev_cap, vol_slot, journal_lba, journal_bcount,
  //                     checkpoint_lba) -> u64
  //   Forwards verbatim to journal_ondisk.pdx's journal_replay -- the
  //   real §4.3 cold-boot walker (head discovery, backward walk to
  //   checkpoint, forward CSUM-verified classify). Returns applied_total.
  pub let jrp_ondisk_replay : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bdev_cap: u64) (vol_slot: u64) (journal_lba: u64) (journal_bcount: u64) (checkpoint_lba: u64) -> unsafe {
      effects: { mem, sysreg }, capabilities: { cap },
      justification: "R52.M5-003 (#1705). Thin wrapper: all five args already sit in rdi/rsi/rdx/rcx/r8, the exact ABI slots journal_ondisk.pdx's journal_replay expects, so no register shuffling is needed. sub rsp,8 (even push count, 0) lands rsp%16==0 for the nested call per journal_ondisk.pdx's own documented rule; add rsp,8 restores it after. rax already holds the callee's return value at ret. No test instruction, no branches. See §4 for why this file, not journal_ondisk.pdx alone, also exposes this entry point.",
      block: {
        sub rsp, 8;
        call journal_replay;
        add rsp, 8;
        ret
      }
    }

  // jrp_ondisk_applied_count() -> u64 -- forwards journal_replay_applied_count.
  pub let jrp_ondisk_applied_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R52.M5-003 (#1705). Thin wrapper, zero args. sub rsp,8/add rsp,8 pad around the one nested call (even push count, 0). No test instruction.",
      block: {
        sub rsp, 8;
        call journal_replay_applied_count;
        add rsp, 8;
        ret
      }
    }

  // jrp_ondisk_discarded_count() -> u64 -- forwards journal_replay_discarded_count.
  pub let jrp_ondisk_discarded_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
