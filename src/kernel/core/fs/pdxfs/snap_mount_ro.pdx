// src/kernel/core/fs/pdxfs/snap_mount_ro.pdx -- R42.M3-002 (#1389)
//
// PDXFS v1 SNAPSHOT -- READ-ONLY MOUNT REGISTRY.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the AUTHORITY on the mount-side view of a snapshot: given a
// name_hash, resolve it against the SnapCreate name registry to a
// snap_id, park that snap_id in a small mounts table, and return a
// 1-based mount_id the caller uses as a handle. Every write against a
// live mount is refused with SNR_ERR_ROFS -- the read-only property is
// enforced HERE (this module owns snr_write_refuse), not by convention
// at each write site.
//
// It is a SCAFFOLD (D7). The mounts table is a flat 8-entry array in
// BSS; a real widening will lift each row into a KIND_SNAP_MOUNT
// capability the derivation gate can revoke. The scaffold's semantic
// (a resolve-by-name + slot claim + read-only latch that either
// succeeds or rejects with a named refusal, and every write attempt
// is refused unconditionally) is the semantic the widening preserves.
//
// It does NOT implement the read path. A widening will forward reads
// to the snapshot's block table via snap_diff-style accessors; today
// this module only proves the WRITE REFUSAL. The read path arrives
// once the KIND_SNAP_MOUNT capability lands.
//
// It does NOT own snapshot lifecycle. snap_create.pdx registers the
// name; snap_prune.pdx deletes it. A mount that outlives its snapshot
// is a real-world hazard the widening addresses through the derivation
// gate; the scaffold does not model the race.
//
// It CALLS snc_lookup at mount-resolve time. Two rounds tied through
// one cross-module call: the R42.M3-001 name registry is the SINGLE
// SOURCE OF TRUTH about which names exist. A second lookup table here
// would let a caller mount a name the registry never sanctioned.
//
// =============================================================================
// §1  TABLE GEOMETRY
// =============================================================================
//
// SNR_MAX_MOUNTS  = 8         mounts capacity (scaffold).
//
// _snr_slots is a flat array of SNR_MAX_MOUNTS u64s. A slot with value
// 0 is EMPTY. A slot with any non-zero value holds the 1-based snap_id
// the mount resolves to. mount_id is 1-based == slot_idx + 1.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _snr_slots and _snr_state are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/fs/pdxfs/snap_mount_ro.o`. A second writer would let a caller
// "install a mount without name resolution", which would let the read
// path resolve to a slot whose name the registry never blessed.
//
// STATE LAYOUT -- _snr_state : [u64; 8]
//   +0    init_mark             0x5ADD once snr_reset has run
//   +8    err                   sticky error latch
//   +16   mount_count           live mounts (== non-empty slot count)
//   +24   mount_total           total snr_mount calls that succeeded
//   +32   unmount_total         total snr_unmount calls that succeeded
//   +40   write_refuse_count    total snr_write_refuse calls
//   +48   last_mount_id         mount_id returned by the most recent mount
//   +56   reserved
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEF70..0xFFFFEF7F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used band
// above: snap_create 0xFFFFEF80..8F (R42.M3-001). Adjacent free band
// below: snap_diff 0xFFFFEF60..6F (R42.M3-003).
//
//   SNR_OK                  = 0
//   SNR_ERR_NOT_INIT        = 0xFFFFEF7F   accessor before snr_reset
//   SNR_ERR_NOT_FOUND       = 0xFFFFEF7E   name not registered by snap_create
//   SNR_ERR_ROFS            = 0xFFFFEF7D   write refused on a live mount
//   SNR_ERR_MOUNTS_FULL     = 0xFFFFEF7C   mount when every slot is occupied
//   SNR_ERR_BAD_IDX         = 0xFFFFEF7B   mount_id 0 or > SNR_MAX_MOUNTS
//   SNR_ERR_BAD_NAME        = 0xFFFFEF7A   mount with name_hash == 0
//   SNR_ERR_NOT_MOUNTED     = 0xFFFFEF79   unmount on an empty slot
//   SNR_ERR_INTERNAL        = 0xFFFFEF78   unreachable-fallthrough tripwire
//
// Reserved-label discipline: labels prefixed `snr_`.

module SnapMountRo = structure {

  pub let SNR_MAX_MOUNTS      : u64 = 8

  pub let SNR_OK                : u64 = 0
  pub let SNR_ERR_NOT_INIT      : u64 = 0xFFFFEF7F
  pub let SNR_ERR_NOT_FOUND     : u64 = 0xFFFFEF7E
  pub let SNR_ERR_ROFS          : u64 = 0xFFFFEF7D
  pub let SNR_ERR_MOUNTS_FULL   : u64 = 0xFFFFEF7C
  pub let SNR_ERR_BAD_IDX       : u64 = 0xFFFFEF7B
  pub let SNR_ERR_BAD_NAME      : u64 = 0xFFFFEF7A
  pub let SNR_ERR_NOT_MOUNTED   : u64 = 0xFFFFEF79
  pub let SNR_ERR_INTERNAL      : u64 = 0xFFFFEF78

  pub let SNR_INIT_MARK         : u64 = 0x5ADD

  pub let mut _snr_slots : [u64; 8] = uninit @align(64)
  pub let mut _snr_state : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Reset. Clears mounts and state; installs init_mark.
  // ==========================================================================

  pub let snr_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): clear mounts + state, install init_mark. Labels prefixed snr_rst_.",
      block: {
        lea r10, [rip + _snr_slots];
        xor rax, rax;
        xor rcx, rcx;
      snr_rst_m:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  snr_rst_m;

        lea r10, [rip + _snr_state];
        xor rcx, rcx;
      snr_rst_s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  snr_rst_s;

        mov rax, 0x5ADD;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let snr_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): 1 iff init_mark matches. Labels prefixed snr_bnd_.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 0];
        mov r11, 0x5ADD;
        cmp rax, r11;
        jne snr_bnd_no;
        mov rax, 1;
        ret;
      snr_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let snr_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): sticky error latch readback.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let snr_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): first-writer-wins error latch. Labels prefixed snr_se_.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne snr_se_out;
        mov [r10 + 8], rdi;
      snr_se_out:
        ret
      }
    }

  // ==========================================================================
  // snr_reset_err — clear the sticky err latch WITHOUT touching mounts
  // or counters.  Used by witnesses that assert a specific latched code
  // across a stage boundary; the first-writer-wins latch must be cleared
  // between stages that both intentionally trigger a refusal path or the
  // second stage sees the first stage's code.
  // ==========================================================================

  pub let snr_reset_err : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): clear err latch, preserve mounts + counters. Labels prefixed snr_re_.",
      block: {
        lea r10, [rip + _snr_state];
        xor rax, rax;
        mov [r10 + 8], rax;
        ret
      }
    }

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let snr_capacity : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R42.M3-002 (#1389): SNR_MAX_MOUNTS as u64.",
      block: {
        mov rax, 8;
        ret
      }
    }

  pub let snr_mount_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): mount_count field.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let snr_mount_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): mount_total field.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let snr_unmount_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): unmount_total field.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let snr_write_refuse_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): write_refuse_count field.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let snr_last_mount_id : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): last_mount_id field.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  // ==========================================================================
  // snr_snap_id_at(mount_idx) -> u64
  //
  // Read the snap_id at slot mount_idx (0-based). 0 iff the slot is
  // empty. Refuses:
  //   - not init                    SNR_ERR_NOT_INIT
  //   - mount_idx >= SNR_MAX_MOUNTS SNR_ERR_BAD_IDX
  // ==========================================================================

  pub let snr_snap_id_at : (u64) -> u64 !{mem} @{} =
    fn (mount_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): read snap_id at slot mount_idx. Labels prefixed snr_sa_.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 0];
        mov r11, 0x5ADD;
        cmp rax, r11;
        jne snr_sa_ni;

        cmp rdi, 8;
        jae snr_sa_bi;

        lea r11, [rip + _snr_slots];
        mov rax, [r11 + rdi * 8];
        ret;

      snr_sa_ni:
        mov rdi, 0xFFFFEF7F;
        call snr_set_err;
        xor rax, rax;
        ret;
      snr_sa_bi:
        mov rdi, 0xFFFFEF7B;
        call snr_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snr_mount(name_hash) -> u64
  //
  // Resolve name_hash against the SnapCreate name registry (calls
  // snc_lookup), park the resulting snap_id in the first empty mount
  // slot, and return the 1-based mount_id. Refuses:
  //   - not init                    SNR_ERR_NOT_INIT
  //   - name_hash == 0              SNR_ERR_BAD_NAME
  //   - snc_lookup returns 0        SNR_ERR_NOT_FOUND
  //   - no empty slot               SNR_ERR_MOUNTS_FULL
  //
  // Register plan: 2-push callee-save (rbx = snap_id, r12 = slot idx).
  // ==========================================================================

  pub let snr_mount : (u64) -> u64 !{mem} @{} =
    fn (name_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): resolve name -> mount slot. Labels prefixed snr_mt_.",
      block: {
        push rbx;
        push r12;

        lea r10, [rip + _snr_state];
        mov rax, [r10 + 0];
        mov r11, 0x5ADD;
        cmp rax, r11;
        jne snr_mt_ni;

        cmp rdi, 0;
        je  snr_mt_bn;

        // Resolve via snc_lookup.
        call snc_lookup;
        cmp rax, 0;
        je  snr_mt_nf;
        mov rbx, rax;                           // snap_id

        // First-empty scan.
        lea r11, [rip + _snr_slots];
        xor r12, r12;
      snr_mt_scan:
        cmp r12, 8;
        jae snr_mt_full;
        mov rax, [r11 + r12 * 8];
        cmp rax, 0;
        je  snr_mt_park;
        add r12, 1;
        jmp snr_mt_scan;

      snr_mt_park:
        mov [r11 + r12 * 8], rbx;
        lea r10, [rip + _snr_state];
        mov r9, [r10 + 16];
        add r9, 1;
        mov [r10 + 16], r9;                     // mount_count++
        mov r9, [r10 + 24];
        add r9, 1;
        mov [r10 + 24], r9;                     // mount_total++
        mov rax, r12;
        add rax, 1;                             // 1-based mount_id
        mov [r10 + 48], rax;                    // last_mount_id
        jmp snr_mt_out;

      snr_mt_ni:
        mov rdi, 0xFFFFEF7F;
        call snr_set_err;
        xor rax, rax;
        jmp snr_mt_out;
      snr_mt_bn:
        mov rdi, 0xFFFFEF7A;
        call snr_set_err;
        xor rax, rax;
        jmp snr_mt_out;
      snr_mt_nf:
        mov rdi, 0xFFFFEF7E;
        call snr_set_err;
        xor rax, rax;
        jmp snr_mt_out;
      snr_mt_full:
        mov rdi, 0xFFFFEF7C;
        call snr_set_err;
        xor rax, rax;

      snr_mt_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // snr_unmount(mount_id) -> u64
  //
  // Drop the mount identified by 1-based mount_id. On success returns
  // 1, decrements mount_count, bumps unmount_total. Refuses:
  //   - not init                    SNR_ERR_NOT_INIT
  //   - mount_id == 0 or > MAX      SNR_ERR_BAD_IDX
  //   - slot already empty          SNR_ERR_NOT_MOUNTED
  // ==========================================================================

  pub let snr_unmount : (u64) -> u64 !{mem} @{} =
    fn (mount_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): drop one mount slot. Labels prefixed snr_un_.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 0];
        mov r11, 0x5ADD;
        cmp rax, r11;
        jne snr_un_ni;

        cmp rdi, 0;
        je  snr_un_bi;
        mov r11, 8;
        cmp rdi, r11;
        ja  snr_un_bi;

        mov r11, rdi;
        sub r11, 1;                             // 0-based idx
        lea r9, [rip + _snr_slots];
        mov rax, [r9 + r11 * 8];
        cmp rax, 0;
        je  snr_un_nm;

        xor rax, rax;
        mov [r9 + r11 * 8], rax;                // clear
        mov r9, [r10 + 16];
        sub r9, 1;
        mov [r10 + 16], r9;                     // mount_count--
        mov r9, [r10 + 32];
        add r9, 1;
        mov [r10 + 32], r9;                     // unmount_total++
        mov rax, 1;
        ret;

      snr_un_ni:
        mov rdi, 0xFFFFEF7F;
        call snr_set_err;
        xor rax, rax;
        ret;
      snr_un_bi:
        mov rdi, 0xFFFFEF7B;
        call snr_set_err;
        xor rax, rax;
        ret;
      snr_un_nm:
        mov rdi, 0xFFFFEF79;
        call snr_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snr_is_ro(mount_id) -> u64
  //
  // 1 iff the mount at `mount_id` is live. Every live mount is read-
  // only by construction; the boolean exists so the caller can gate on
  // "is this handle open?" without a mode field it could misinterpret.
  // Refuses:
  //   - not init                    SNR_ERR_NOT_INIT
  //   - mount_id == 0 or > MAX      SNR_ERR_BAD_IDX
  // ==========================================================================

  pub let snr_is_ro : (u64) -> u64 !{mem} @{} =
    fn (mount_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): 1 iff mount slot is live (RO by construction). Labels prefixed snr_ro_.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 0];
        mov r11, 0x5ADD;
        cmp rax, r11;
        jne snr_ro_ni;

        cmp rdi, 0;
        je  snr_ro_bi;
        mov r11, 8;
        cmp rdi, r11;
        ja  snr_ro_bi;

        mov r11, rdi;
        sub r11, 1;
        lea r9, [rip + _snr_slots];
        mov rax, [r9 + r11 * 8];
        cmp rax, 0;
        je  snr_ro_empty;
        mov rax, 1;
        ret;

      snr_ro_empty:
        xor rax, rax;
        ret;
      snr_ro_ni:
        mov rdi, 0xFFFFEF7F;
        call snr_set_err;
        xor rax, rax;
        ret;
      snr_ro_bi:
        mov rdi, 0xFFFFEF7B;
        call snr_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // snr_write_refuse(mount_id) -> u64
  //
  // The READ-ONLY LATCH. A live mount is IMMUTABLE by construction;
  // this entry is the ONE place a write attempt against a snapshot
  // mount lands. It returns SNR_ERR_ROFS unconditionally when the
  // mount is live, latches the error, and bumps write_refuse_count so
  // the witness can prove the refusal fired.
  //
  // Refuses:
  //   - not init                    SNR_ERR_NOT_INIT
  //   - mount_id == 0 or > MAX      SNR_ERR_BAD_IDX
  //   - slot empty                  SNR_ERR_NOT_MOUNTED
  //   - slot live                   SNR_ERR_ROFS (the whole point)
  // ==========================================================================

  pub let snr_write_refuse : (u64) -> u64 !{mem} @{} =
    fn (mount_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R42.M3-002 (#1389): write attempt against a RO mount always refused. Labels prefixed snr_wr_.",
      block: {
        lea r10, [rip + _snr_state];
        mov rax, [r10 + 0];
        mov r11, 0x5ADD;
        cmp rax, r11;
        jne snr_wr_ni;

        cmp rdi, 0;
        je  snr_wr_bi;
        mov r11, 8;
        cmp rdi, r11;
        ja  snr_wr_bi;

        mov r11, rdi;
        sub r11, 1;
        lea r9, [rip + _snr_slots];
        mov rax, [r9 + r11 * 8];
        cmp rax, 0;
        je  snr_wr_nm;

        // Live mount: refuse write with EROFS.
        mov r9, [r10 + 40];
        add r9, 1;
        mov [r10 + 40], r9;                     // write_refuse_count++
        mov rdi, 0xFFFFEF7D;
        call snr_set_err;
        mov rax, 0xFFFFEF7D;
        ret;

      snr_wr_ni:
        mov rdi, 0xFFFFEF7F;
        call snr_set_err;
        xor rax, rax;
        ret;
      snr_wr_bi:
        mov rdi, 0xFFFFEF7B;
        call snr_set_err;
        xor rax, rax;
        ret;
      snr_wr_nm:
        mov rdi, 0xFFFFEF79;
        call snr_set_err;
        xor rax, rax;
        ret
      }
    }
}
