// src/kernel/core/mm/mmio_map.pdx — boot-mmio-mapping step 1
//
// platform_mmio_map(pa_base, size, cache_type) -> kernel_va
//
// Generalization of fb_map_lfb (src/kernel/core/drivers/fb_map.pdx L159 ff.)
// for device MMIO windows. Reserves PML4[321] = 0xFFFF_A800_0000_0000 as the
// device-MMIO higher-half window (adjacent to the framebuffer window at
// PML4[320] and disjoint from the R25+ physmap window at PML4[384+]).
//
// Design memo: design/kernel/boot-mmio-mapping.md
//
// ==============================================================================
// Purpose
// ==============================================================================
//
// The boot identity map installed by tools/boot_stub.S covers [0, 4 GiB) with
// four 1-GiB huge pages. Every driver that touches MMIO in that window today
// works only by the accident of the huge-page overlap; anything above 4 GiB
// (routine on real hardware) is unmapped. This primitive lets a driver ask
// the mapper for a kernel VA for an arbitrary [pa, pa+size) range, with the
// right PAT-derived cacheability.
//
// The MAP_HUGE branch handles the identity-map overlap gracefully: when
// aspace_map descends into a boot 1-GiB huge page it returns MAP_HUGE
// (0xFFFFFFFD) rather than clobbering the huge-page mapping. In that case
// the caller can use the identity VA (which is exactly pa_base) — this
// keeps existing drivers whose base constants already land inside the boot
// identity window (HPET/APIC/IOAPIC on QEMU q35) working with no code change
// until they are converted to the higher-half VA the mapper hands back on
// real hardware.
//
// ==============================================================================
// VA-window selection: 0xFFFF_A800_0000_0000 (PML4[321])
// ==============================================================================
//
//   0xFFFF_A800_0000_0000 >> 39 & 0x1FF = 0x141 = 321
//
// PML4 layout snapshot (see src/kernel/core/drivers/fb_map.pdx L36 ff.):
//   PML4[256]        KERNEL_VMA_BASE alias (kernel image + heap + IST)
//   PML4[257..320)   unused
//   PML4[320]        framebuffer (FB_MAP_VA_BASE) — reserved by R23.M1
//   PML4[321]        device MMIO (this module) — reserved here
//   PML4[322..384)   unused
//   PML4[384+]       reserved for R25+ physmap window
//
// PML4[321] is unclaimed by any current or planned kernel VA consumer.
//
// ==============================================================================
// PAT selector encoding
// ==============================================================================
//
// PAT slot index = (PAT<<2 | PCD<<1 | PWT), 3 bits per PTE. See
// src/kernel/core/mm/pat.pdx for the IA32_PAT programming. Slot layout
// post-pat_init_this_cpu:
//   slot 0 = WB   slot 1 = WT   slot 2 = UC-  slot 3 = UC
//   slot 4 = WC   slot 5 = WT   slot 6 = UC-  slot 7 = UC
//
// This module exposes two cache types:
//   MMIO_UC = 0 -> flags = 0x8000_0000_0000_0012
//                   NX (bit 63) | PCD (bit 4) | RW (bit 1)
//                   PAT index = (PAT<<2 | PCD<<1 | PWT) = (0<<2 | 1<<1 | 0) = 2
//                   -> slot 2 = UC- (uncacheable, MTRR-overridable). Practical
//                      MMIO semantics on every target: strict UC ordering.
//   MMIO_WC = 1 -> flags = 0x8000_0000_0000_0082
//                   NX (bit 63) | PAT (bit 7) | RW (bit 1)
//                   PAT index = (1<<2 | 0<<1 | 0) = 4 -> slot 4 = WC
//                   (matches fb_map_lfb's WC selector, see fb_map.pdx L139).
//
// PRESENT (bit 0) is added by aspace_map itself (see aspace_map.pdx line
// where `or rax, 1` runs before storing the leaf PTE).
//
// ==============================================================================
// Register discipline
// ==============================================================================
//
// aspace_map takes 4 args (RDI, RSI, RDX, RCX) and clobbers RAX + caller-save
// regs. State that survives across the call lives in callee-save registers.
//
// 5-push prologue (rbx, r12, r13, r14, r15) — from entry rsp%16==8, five
// pushes land rsp%16 == 0 so nested aspace_map calls see the required 16-byte
// alignment.  Mirrors fb_map_lfb's discipline exactly.
//
//   rbx = pa_cursor      (advances by 4096 per page mapped)
//   r12 = va_cursor      (advances by 4096 per page mapped)
//   r13 = remaining      (bytes left to map)
//   r14 = flags          (immutable across the loop)
//   r15 = start_va       (saved for return; immutable across the loop)
//
// The "first iteration" detector for the MAP_HUGE fallback is
// (r12 == r15) — va_cursor still equals start_va because no page has yet
// been advanced. This is why start_va is saved in r15 rather than derived
// from r12 at the end.
//
// ==============================================================================
// Return contract
// ==============================================================================
//
//   size == 0                      -> return start_va (nothing mapped)
//   aspace_map returns MAP_HUGE
//     on the first iteration       -> return pa_base (identity-VA fallback)
//   aspace_map returns any other
//     non-zero (MAP_OOM, MAP_OVERLAP,
//     MAP_HUGE mid-way)            -> return 0
//   success (all pages mapped)     -> return start_va and publish
//                                     _mmio_va_next += size
//
// Counters (_mmio_map_stats):
//   [0] hits           bumped once per successful non-identity map
//   [1] huge_fallback  bumped once per identity-VA fallback
//   [2] aspace_fail    bumped once per aspace_map non-MAP_HUGE failure
//   [3] total_bytes    accumulated bytes mapped in higher-half window
//
// ==============================================================================
// Instruction floor
// ==============================================================================
//
// - mov r64, imm64        (movabs; kpti.pdx / fb_map precedent)
// - mov r64, imm32        (paideia-as v0.11.0 baseline)
// - mov r64, [rip + sym]  (RIP-rel load; kpti.pdx / fb_map precedent)
// - lea r64, [rip + sym]  (R11 encoder)
// - cmp / je / jne / jbe / jmp (R11 flow control)
// - add / sub r64, imm32  (R11 arith)
// - call rel32            (R11 encoder)

module MmioMap = structure {

  // Cache-type enum.
  pub let MMIO_UC : u64 = 0
  pub let MMIO_WC : u64 = 1

  // Higher-half VA base for device MMIO — PML4[321]. See selection rationale
  // above.
  pub let MMIO_VA_BASE : u64 = 0xFFFFA80000000000

  pub let MMIO_MAP_PAGE_BYTES : u64 = 4096

  // Bump-cursor for the MMIO VA window. Zero-initialized; lazy-initialized
  // to MMIO_VA_BASE on first entry so the .data footprint stays clean and
  // the initialization point is observable in a single place.
  pub let mut _mmio_va_next : u64 = 0

  // Observability counters. See "Counters" comment above for the layout.
  pub let mut _mmio_map_stats : [u64; 4] = [0; 4]

  // ==========================================================================
  // platform_mmio_map(pa_base, size, cache_type) -> kernel_va
  // ==========================================================================
  //
  // Iterate the physical range in 4 KiB chunks; call aspace_map per page
  // against the kernel PML4. On MAP_HUGE on the first iteration, return
  // pa_base as an identity-VA fallback (the boot huge-page identity map
  // already covers this range writably; the caller can dereference pa_base
  // directly). Any other non-zero return from aspace_map is treated as a
  // hard failure and the wrapper returns 0.
  //
  // Prereqs (caller-enforced):
  //   - pat_init_this_cpu already ran on this CPU.
  //   - _kernel_pml4_pa is populated (post-boot; always true).
  //   - pa_base is 4 KiB-aligned.
  // ==========================================================================
  pub let platform_mmio_map : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pa_base: u64) (size: u64) (cache_type: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { boot },
      justification: "boot-mmio-mapping step 1 (design/kernel/boot-mmio-mapping.md). Map a device-MMIO physical range [pa_base, pa_base+size) into the higher-half kernel window at PML4[321] (0xFFFF_A800_0000_0000) with PAT-derived cacheability. cache_type=0 selects MMIO_UC (PAT index 2 = UC-, flags 0x8000_0000_0000_0012 = NX|PCD|RW); cache_type=1 selects MMIO_WC (PAT index 4 = WC per pat_init_this_cpu, flags 0x8000_0000_0000_0082 = NX|PAT|RW — the same selector fb_map_lfb uses). aspace_map ORs PRESENT itself so the flags word omits bit 0. Register discipline: 5-push prologue (rbx=pa_cursor, r12=va_cursor, r13=remaining, r14=flags, r15=start_va) — from entry rsp%16==8, five pushes land rsp%16==0 for nested aspace_map calls; mirrors fb_map_lfb exactly. Bump cursor: _mmio_va_next is lazily initialized to MMIO_VA_BASE on the first call (0 sentinel in .bss keeps the initialization point observable in one place). On success the wrapper publishes _mmio_va_next += size and bumps _mmio_map_stats[0] (hits) + _mmio_map_stats[3] (total_bytes). MAP_HUGE branch: aspace_map returns MAP_HUGE (0xFFFFFFFD) when descent hits a PS=1 huge-page entry — for the boot identity map (four 1-GiB huge pages covering [0, 4 GiB) per tools/boot_stub.S) every fixed-PA driver window inside that range triggers this. The wrapper's response on the FIRST iteration only (va_cursor == start_va, meaning no page has advanced) is to return pa_base — the identity VA is a valid alias, the huge page is already RW, and existing drivers whose base constants land inside the boot window keep working with no code change until they are converted to the higher-half VA. This is what keeps HPET/xAPIC/IOAPIC live under -kernel PVH boots before real ACPI-driven mapping lands. _mmio_map_stats[1] (huge_fallback) tracks how many ranges took this path. MAP_HUGE mid-way through a range (should not happen for firmware-fixed windows) is treated as a hard failure. Any other non-zero aspace_map return (MAP_OOM=0xFFFFFFFE, MAP_OVERLAP=0xFFFFFFFF) bumps _mmio_map_stats[2] (aspace_fail) and returns 0. Loop terminator uses cmp+jbe on the remaining byte count (matches fb_map_lfb); size==0 short-circuits and returns start_va without any aspace_map call. Instruction floor: mov r64,imm64 (movabs for MMIO_VA_BASE / flags), mov r64,imm32 (small counters), mov r64,[rip+sym] / lea r64,[rip+sym] (RIP-rel; kpti + fb_map precedent), add / sub r64,imm32, cmp / je / jne / jbe / jmp, call rel32 — all in paideia-as v0.11.0+ baseline. No callers at this step; module is dead code until step 2 wires platform_map_early_mmio in kernel_main.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ------------------------------------------------------------------
        // Prologue: lazily initialize _mmio_va_next, snapshot start_va,
        // select flags word.
        // ------------------------------------------------------------------

        // Snapshot _mmio_va_next; if 0, initialize to MMIO_VA_BASE.
        mov r15, [rip + _mmio_va_next];
        cmp r15, 0;
        jne mmio_pm_va_ok;
        mov r15, 0xFFFFA80000000000;              // MMIO_VA_BASE
      mmio_pm_va_ok:

        // Initialize cursors.
        mov rbx, rdi;                             // pa_cursor = pa_base
        mov r12, r15;                             // va_cursor = start_va
        mov r13, rsi;                             // remaining = size

        // Select flags word from cache_type (rdx).
        //   MMIO_UC (0) -> 0x8000_0000_0000_0012  (NX | PCD | RW)
        //   MMIO_WC (1) -> 0x8000_0000_0000_0082  (NX | PAT | RW)
        mov r14, 0x8000000000000012;              // default UC
        cmp rdx, 1;
        jne mmio_pm_flags_ok;
        mov r14, 0x8000000000000082;              // WC
      mmio_pm_flags_ok:

      mmio_pm_loop:
        // Terminator: remaining <= 0.
        cmp r13, 0;
        jbe mmio_pm_done;

        // Map one page.
        //   rdi = _kernel_pml4_pa
        //   rsi = va_cursor
        //   rdx = pa_cursor
        //   rcx = flags
        mov rdi, [rip + _kernel_pml4_pa];
        mov rsi, r12;
        mov rdx, rbx;
        mov rcx, r14;
        call aspace_map;

        // 0 -> success, advance and loop.
        cmp rax, 0;
        je mmio_pm_advance;

        // Non-zero: classify MAP_HUGE vs other failure.
        mov rcx, 0xFFFFFFFD;                      // MAP_HUGE
        cmp rax, rcx;
        jne mmio_pm_fail;

        // MAP_HUGE. Only accept on the first iteration (va_cursor still
        // equals start_va — no page has advanced). Mid-way MAP_HUGE means
        // a range straddles a huge-page boundary partway in, which is not
        // a shape any firmware-fixed window produces; treat as failure.
        cmp r12, r15;
        jne mmio_pm_fail;

        // Bump huge_fallback counter: _mmio_map_stats[1] += 1.
        lea rcx, [rip + _mmio_map_stats];
        mov rax, [rcx + 8];
        add rax, 1;
        mov [rcx + 8], rax;

        // Return pa_base (identity-VA fallback). rbx still equals pa_base
        // because we have not advanced.
        mov rax, rbx;
        jmp mmio_pm_epilogue;

      mmio_pm_advance:
        add rbx, 4096;
        add r12, 4096;
        sub r13, 4096;
        jmp mmio_pm_loop;

      mmio_pm_done:
        // Publish new va_next (r12 = next-available VA).
        mov [rip + _mmio_va_next], r12;

        // hits++: _mmio_map_stats[0] += 1.
        lea rcx, [rip + _mmio_map_stats];
        mov rax, [rcx + 0];
        add rax, 1;
        mov [rcx + 0], rax;

        // total_bytes += (r12 - r15).
        mov rax, r12;
        sub rax, r15;
        mov rdx, [rcx + 24];
        add rdx, rax;
        mov [rcx + 24], rdx;

        // Return start_va.
        mov rax, r15;
        jmp mmio_pm_epilogue;

      mmio_pm_fail:
        // aspace_fail++: _mmio_map_stats[2] += 1.
        lea rcx, [rip + _mmio_map_stats];
        mov rax, [rcx + 16];
        add rax, 1;
        mov [rcx + 16], rax;
        xor rax, rax;
        // Fall through to epilogue.

      mmio_pm_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
