// src/kernel/core/mm/kpti.pdx — R13-m3-002 KPTI PGD-copy discipline
// Issue: #446
// Audit: design/audit/entries/r13-m3-002-kpti-pgd-copy.md
//
// Per-user process holds TWO PML4s (Meltdown mitigation):
//   - KERNEL_PGD: full kernel higher-half + trampoline + user pages (used in ring 0)
//   - USER_PGD:   user pages + trampoline only (used in ring 3)
// On syscall entry: swap CR3 kernel_pgd. On sysretq: swap back to user_pgd.
//
// Activation blocked on:
//   - Dedicated trampoline PDPT (not the shared PML4[256] alias)
//   - m5-002 syscall entry trampoline with CR3 swap
//   - #480 kernel VMA move to higher-half execution
//   - m10-001 fork calling both aspace_create + aspace_create_user_pgd
//
// Stub delivers signature-compatible symbol; full body swaps in at
// activation time. Callers get ASPACE_CREATE_NOT_YET (distinct from OOM)
// to distinguish "not yet activated" from "allocation failure".
//
// ===========================================================================
// #658 CONTRACT (VA-not-PA): kpti_build_user_pml4 receives a phys_alloc-form
// kernel VA as user_pml4_pa (per the module-wide phys_alloc contract — see
// phys_alloc.pdx and aspace_create.pdx). Its intermediate-table writes
// (PDPT/PD/PT link fields, PML4[256] link) were VA-form until commit
// 857a4df (#679) landed the boundary sub-KERNEL_VMA_BASE discipline that
// aspace_map already had from #652.
//
// aspace_create_user_pgd inherits phys_alloc's VA-form return. Callers
// (aspace_create_user in this file) return that VA verbatim; the CR3-flip
// boundary is the caller's responsibility, matching phys_alloc's contract.
//
// See paideia-os #658 for the full audit.
// ===========================================================================

module Kpti = structure {
  // Higher-half trampoline VA (kernel-side view).
  pub let KPTI_TRAMPOLINE_VA_KERNEL : u64 = 0xFFFF800000104000

  // Trampoline page VA in user-side view (identity-map region).
  pub let KPTI_TRAMPOLINE_VA_USER : u64 = 0x1000

  // PML4 slot for higher-half kernel.
  pub let PML4_TRAMPOLINE_SLOT : u64 = 256

  // Trampoline page-table indices (KPTI shared PDPT chain).
  pub let KPTI_TRAMP_PDPT_IDX : u64 = 0
  pub let KPTI_TRAMP_PD_IDX : u64 = 0
  pub let KPTI_TRAMP_PT_IDX : u64 = 260
  pub let KPTI_TRAMP_PT_DATA_IDX : u64 = 261

  // Trampoline data page VA (kernel-side view).
  pub let KPTI_TRAMPOLINE_DATA_VA_KERNEL : u64 = 0xFFFF800000105000

  // Kernel VMA base (matches link.ld KERNEL_VMA_BASE).
  pub let KERNEL_VMA_BASE_LOCAL : u64 = 0xFFFF800000000000

  // Return sentinels for aspace_create_user_pgd.
  pub let ASPACE_CREATE_OOM : u64 = 0xFFFFFFFF
  pub let ASPACE_CREATE_NOT_YET : u64 = 0xFFFFFFFE  // reserved for future trampoline-install failure path

  // Lazy singleton: phys addr of shared trampoline PDPT (0 = not yet allocated).
  pub let mut _kpti_trampoline_pdpt_pa : u64 = 0

  // Kernel PML4 phys addr — DEFINED in trampoline_data.pdx (#679 fix):
  // must live in the KPTI trampoline data page (VA 0xFFFF800000105010) so
  // syscall_entry can read it under user_pml4 before the CR3 flip. Previously
  // defined here as `pub let mut _kernel_pml4_pa : u64 = 0`, which the linker
  // placed in regular .bss (0xFFFF80000011B998) — invisible under strict-KPTI
  // user_pml4 → syscall_entry triple-faulted on `mov rax, [_kernel_pml4_pa]`.
  // References here + in entry.pdx + exceptions.pdx are now unresolved locally
  // and resolved at link-time to trampoline_data.pdx's `[u64; 1] uninit` slot.
  // Populated at boot by kernel_main_64 for kpti_switch_to_kernel + syscall_entry.
  // Today VA(pml4)==PA(pml4) since pml4 is in low identity .bss.boot (R14.M4-004 #500).

  // aspace_create_user_pgd(kernel_pml4) — KPTI USER_PGD factory (R14b-m4-001).
  // Allocates fresh PML4 page, zeroes all 512 entries. Returns phys base address,
  // or ASPACE_CREATE_OOM (0xFFFFFFFF) on allocation failure.
  // Prologue: push r12 (callee-saved per SysV; unused in body but primes for future
  // trampoline-PDPT install). Body: phys_alloc(0) -> phys addr, loop zero all 512
  // PML4 entries. On OOM from phys_alloc, jump to user_pgd_oom and return sentinel.
  // Full KPTI activation (trampoline PDPT install, CR3 swap, etc.) is future work.
  pub let aspace_create_user_pgd : (u64) -> u64 !{mem} @{} =
    fn (kernel_pml4: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R14b-m4-001 KPTI USER_PGD factory: allocates and zeroes new PML4 via phys_alloc(0). Unsafe because it writes to newly allocated PML4 memory. Prologue push r12 mirrors aspace_create prologue for parity and primes for future trampoline-PDPT install. On phys_alloc failure (rax==0), jumps to user_pgd_oom and returns ASPACE_CREATE_OOM (0xFFFFFFFF). Full KPTI activation (trampoline entry install, CR3 swap wiring, fork integration) blocked on m5-002, #480, m10-001 per design/audit/entries/r13-m3-002-kpti-pgd-copy.md.",
      block: {
        push r12;
        push r13;
        push r14;

        mov rdi, 0;
        call phys_alloc;
        cmp rax, 0;
        je user_pgd_oom;
        mov r14, rax;

        xor r13, r13;
        zero_loop:
          cmp r13, 512;
          jae zero_done;
          lea r8, [r14 + r13*8];
          mov rax, 0;
          mov [r8], rax;
          add r13, 1;
          jmp zero_loop;
        zero_done:

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret;

        user_pgd_oom:
        mov rax, 0xFFFFFFFF;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // kpti_build_user_pml4(user_pml4_pa) — Populate user PML4[256] with shared trampoline PDPT (R14b-m4-003).
  // Lazy singleton initialization: first call allocates and zeros PDPT+PD+PT chain,
  // populates the page-table entries, and installs PML4[256]. Subsequent calls reuse
  // the cached PDPT. Returns user_pml4_pa on success, ASPACE_CREATE_OOM (0xFFFFFFFF) on failure.
  // Trampoline discipline: PML4[256] → PDPT[0] → PD[0] → PT[260] → trampoline page (0x104000 phys).
  // PML4[256], PDPT[0], PD[0] are marked present+writable; PT[260] is present+RO+X (ring-0).
  pub let kpti_build_user_pml4 : (u64) -> u64 !{mem} @{} =
    fn (user_pml4_pa: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R14b-m4-003 (#499): Populate user PML4[256] to route higher-half VAs to shared trampoline PDPT that maps only the syscall trampoline page. Lazy singleton: first call allocates PDPT+PD+PT chain; subsequent calls reuse the same PDPT. Meltdown discipline — no kernel mappings other than trampoline installed in user aspace. R14b-m4-006b (#645): populate PT[261] with RW trampoline data page (scratch slot for saved user rsp, user CR3, kernel PML4 phys) with U=0 (kernel-only) and XD=1 (no-execute) flags; enables safe SYSCALL entry under strict KPTI without ordering bug.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                          // r12 = user_pml4_pa
        lea r13, [rip + _kpti_trampoline_pdpt_pa];
        mov rax, [r13];                        // load cached PDPT phys
        cmp rax, 0;
        jne kpti_have_pdpt;

        // Cold path: allocate PDPT
        mov rdi, 0;
        call phys_alloc;
        cmp rax, 0;
        je kpti_build_oom;
        mov r14, rax;                          // r14 = PDPT phys

        // Zero PDPT (512 entries × 8 bytes)
        xor rcx, rcx;
        kpti_zero_pdpt:
          cmp rcx, 512;
          jae kpti_zero_pdpt_done;
          lea r8, [r14 + rcx * 8];
          mov rax, 0;
          mov [r8], rax;
          add rcx, 1;
          jmp kpti_zero_pdpt;
        kpti_zero_pdpt_done:

        // Allocate PD
        mov rdi, 0;
        call phys_alloc;
        cmp rax, 0;
        je kpti_build_oom;
        mov r15, rax;                          // r15 = PD phys

        // Zero PD (512 entries × 8 bytes)
        xor rcx, rcx;
        kpti_zero_pd:
          cmp rcx, 512;
          jae kpti_zero_pd_done;
          lea r8, [r15 + rcx * 8];
          mov rax, 0;
          mov [r8], rax;
          add rcx, 1;
          jmp kpti_zero_pd;
        kpti_zero_pd_done:

        // Allocate PT
        mov rdi, 0;
        call phys_alloc;
        cmp rax, 0;
        je kpti_build_oom;
        mov r8, rax;                           // r8 = PT phys

        // Zero PT (512 entries × 8 bytes)
        xor rcx, rcx;
        kpti_zero_pt:
          cmp rcx, 512;
          jae kpti_zero_pt_done;
          lea r9, [r8 + rcx * 8];
          mov rax, 0;
          mov [r9], rax;
          add rcx, 1;
          jmp kpti_zero_pt;
        kpti_zero_pt_done:

        // Populate PT[260] with trampoline page (LMA = 0x104000).
        // Get trampoline VMA-relative offset.
        lea rcx, [rip + _syscall_trampoline_start];
        mov rdx, 0xFFFF800000000000;           // KERNEL_VMA_BASE
        sub rcx, rdx;                          // rcx = trampoline phys addr
        or rcx, 0x1;                           // present + RO + X (ring-0)
        mov r9, r8;                            // r9 = PT base
        add r9, 2080;                          // r9 = PT[260] slot (260*8=2080)
        mov [r9], rcx;

        // Populate PT[261] with trampoline data page (LMA = 0x105000).
        lea rcx, [rip + _syscall_trampoline_data_start];
        mov rdx, 0xFFFF800000000000;           // KERNEL_VMA_BASE
        sub rcx, rdx;                          // rcx = trampoline data phys
        mov rdx, 0x8000000000000003;           // present + RW + U=0 + XD
        or rcx, rdx;
        mov r9, r8;                            // r9 = PT base
        add r9, 2088;                          // r9 = PT[261] slot (261*8=2088)
        mov [r9], rcx;

        // #679: convert phys_alloc's kernel-VA return to genuine PA before
        // storing in a page-table entry. Same discipline as aspace_map
        // (#652 fix); the KPTI structural witness in kernel_main.pdx must
        // be updated in lockstep to PA→VA-recover on every table load.
        // Without this, CPU-walking these entries under a real CR3 flip
        // reads bits 12..51 as VA-shaped garbage → #PF → #DF → triple
        // fault (surfaced by #679's page-walk probe).

        // Populate PD[0] = PT_pa | 0x3 (present + writable, intermediate)
        mov rdx, r8;                           // rdx = PT VA (phys_alloc form)
        mov rcx, 0xFFFF800000000000;           // KERNEL_VMA_BASE
        sub rdx, rcx;                          // rdx = PT genuine PA
        or rdx, 0x3;
        mov [r15], rdx;

        // Populate PDPT[0] = PD_pa | 0x3
        mov rdx, r15;                          // rdx = PD VA
        mov rcx, 0xFFFF800000000000;
        sub rdx, rcx;                          // rdx = PD genuine PA
        or rdx, 0x3;
        mov [r14], rdx;

        // Cache PDPT phys in singleton (store PA form so the reuse path
        // below can drop it straight into PML4[256] without re-converting).
        mov rdx, r14;                          // rdx = PDPT VA
        mov rcx, 0xFFFF800000000000;
        sub rdx, rcx;                          // rdx = PDPT genuine PA
        mov [r13], rdx;
        mov rax, rdx;                          // rax = PDPT PA for install below

        kpti_have_pdpt:
        // Install PML4[256] = PDPT_pa | 0x3 (rax already carries PA form,
        // either from the cold-path sub above OR from the singleton load
        // which now also stores PA).
        mov rdx, rax;
        or rdx, 0x3;
        mov r8, r12;                           // r8 = user PML4 base
        add r8, 2048;                          // r8 = PML4[256] slot (256*8=2048)
        mov [r8], rdx;

        // #718 Phase A: Map _kernel_stack + IST1/2/3 stacks into user_pml4.
        // Each stack is 16384 bytes = 4 pages of data. Since the symbols are only
        // @align(16), the 16 KiB region can straddle up to 5 page frames when
        // start-of-stack is not page-aligned. Map 5 pages per stack (the base
        // page-frame plus 4 more, covering the worst-case straddle including the
        // top-of-stack byte at &stack + 16384, which is TSS.RSP0 / IST hardware slot).
        // Flags = P=1, RW=1, U=0, XD=1 (0x8000000000000003).
        // aspace_map contract: paddr parameter is kernel VA (phys_alloc form).
        // Register discipline: aspace_map clobbers r8-r11 AND r9 (last write is a
        // KERNEL_VMA_BASE movabs on the success path, r9 is not restored). Use r15
        // as the loop counter — SysV callee-save AND aspace_map preserves r12-r15.

        // Map _kernel_stack: 5 pages (covers any 4-KiB straddle)
        lea r14, [rip + _kernel_stack];
        and r14, 0xFFFFFFFFFFFFF000;            // r14 = page-aligned base
        xor r15, r15;                          // r15 = iteration counter (callee-save)
        kpti_map_kernel_stack_loop:
          cmp r15, 5;
          jae kpti_map_kernel_stack_done;
          mov rdi, r12;                        // rdi = user_pml4_pa
          mov rsi, r15;
          shl rsi, 12;                         // rsi = r15 * 4096
          add rsi, r14;                        // rsi = r14 + (r15 * 4096) = VA
          mov rdx, rsi;                        // rdx = paddr (kernel VA form; aspace_map converts)
          mov rcx, 0x8000000000000003;         // rcx = flags
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_kernel_stack_loop;
        kpti_map_kernel_stack_done:

        // Map _ist1_stack: 5 pages
        lea r14, [rip + _ist1_stack];
        and r14, 0xFFFFFFFFFFFFF000;
        xor r15, r15;
        kpti_map_ist1_stack_loop:
          cmp r15, 5;
          jae kpti_map_ist1_stack_done;
          mov rdi, r12;
          mov rsi, r15;
          shl rsi, 12;
          add rsi, r14;
          mov rdx, rsi;
          mov rcx, 0x8000000000000003;
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_ist1_stack_loop;
        kpti_map_ist1_stack_done:

        // Map _ist2_stack: 5 pages
        lea r14, [rip + _ist2_stack];
        and r14, 0xFFFFFFFFFFFFF000;
        xor r15, r15;
        kpti_map_ist2_stack_loop:
          cmp r15, 5;
          jae kpti_map_ist2_stack_done;
          mov rdi, r12;
          mov rsi, r15;
          shl rsi, 12;
          add rsi, r14;
          mov rdx, rsi;
          mov rcx, 0x8000000000000003;
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_ist2_stack_loop;
        kpti_map_ist2_stack_done:

        // Map _ist3_stack: 5 pages
        lea r14, [rip + _ist3_stack];
        and r14, 0xFFFFFFFFFFFFF000;
        xor r15, r15;
        kpti_map_ist3_stack_loop:
          cmp r15, 5;
          jae kpti_map_ist3_stack_done;
          mov rdi, r12;
          mov rsi, r15;
          shl rsi, 12;
          add rsi, r14;
          mov rdx, rsi;
          mov rcx, 0x8000000000000003;
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_ist3_stack_loop;
        kpti_map_ist3_stack_done:

        // #719 Phase B: Map _gdt_new + _gdt_ptr into user_pml4.
        // Both symbols reside on page 0xffff800000120000 (64 + 16 B total, well under 4 KiB).
        // Map 1 page, RO (P=1, RW=0, U=0, XD=1 = 0x8000000000000001).
        lea r14, [rip + _gdt_new];
        and r14, 0xFFFFFFFFFFFFF000;            // r14 = page-aligned base
        xor r15, r15;                          // r15 = iteration counter
        kpti_map_gdt_loop:
          cmp r15, 1;
          jae kpti_map_gdt_done;
          mov rdi, r12;                        // rdi = user_pml4_pa
          mov rsi, r15;
          shl rsi, 12;                         // rsi = r15 * 4096
          add rsi, r14;                        // rsi = r14 + (r15 * 4096)
          mov rdx, rsi;                        // rdx = paddr (kernel VA form)
          mov rcx, 0x8000000000000001;         // rcx = flags (RO)
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_gdt_loop;
        kpti_map_gdt_done:

        // #719 Phase B: Map _idt_storage into user_pml4.
        // 4096 bytes = exactly 1 page at 0xffff80000012d000.
        // Map 1 page, RO (P=1, RW=0, U=0, XD=1 = 0x8000000000000001).
        lea r14, [rip + _idt_storage];
        and r14, 0xFFFFFFFFFFFFF000;            // r14 = page-aligned base
        xor r15, r15;                          // r15 = iteration counter
        kpti_map_idt_storage_loop:
          cmp r15, 1;
          jae kpti_map_idt_storage_done;
          mov rdi, r12;                        // rdi = user_pml4_pa
          mov rsi, r15;
          shl rsi, 12;                         // rsi = r15 * 4096
          add rsi, r14;                        // rsi = r14 + (r15 * 4096)
          mov rdx, rsi;                        // rdx = paddr (kernel VA form)
          mov rcx, 0x8000000000000001;         // rcx = flags (RO)
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_idt_storage_loop;
        kpti_map_idt_storage_done:

        // #719 Phase B: Map _idt_descriptor into user_pml4.
        // 16 bytes on page 0xffff80000012e000 (separate from _idt_storage).
        // Map 1 page, RO (P=1, RW=0, U=0, XD=1 = 0x8000000000000001).
        lea r14, [rip + _idt_descriptor];
        and r14, 0xFFFFFFFFFFFFF000;            // r14 = page-aligned base
        xor r15, r15;                          // r15 = iteration counter
        kpti_map_idt_descriptor_loop:
          cmp r15, 1;
          jae kpti_map_idt_descriptor_done;
          mov rdi, r12;                        // rdi = user_pml4_pa
          mov rsi, r15;
          shl rsi, 12;                         // rsi = r15 * 4096
          add rsi, r14;                        // rsi = r14 + (r15 * 4096)
          mov rdx, rsi;                        // rdx = paddr (kernel VA form)
          mov rcx, 0x8000000000000001;         // rcx = flags (RO)
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_idt_descriptor_loop;
        kpti_map_idt_descriptor_done:

        // #719 Phase B: Map _tss into user_pml4.
        // 104 bytes on page 0xffff80000013e000.
        // Map 1 page, RW (P=1, RW=1, U=0, XD=1 = 0x8000000000000003) — TSS.RSP0 gets written by kernel.
        lea r14, [rip + _tss];
        and r14, 0xFFFFFFFFFFFFF000;            // r14 = page-aligned base
        xor r15, r15;                          // r15 = iteration counter
        kpti_map_tss_loop:
          cmp r15, 1;
          jae kpti_map_tss_done;
          mov rdi, r12;                        // rdi = user_pml4_pa
          mov rsi, r15;
          shl rsi, 12;                         // rsi = r15 * 4096
          add rsi, r14;                        // rsi = r14 + (r15 * 4096)
          mov rdx, rsi;                        // rdx = paddr (kernel VA form)
          mov rcx, 0x8000000000000003;         // rcx = flags (RW)
          call aspace_map;
          cmp rax, 0;
          jne kpti_build_oom;
          add r15, 1;
          jmp kpti_map_tss_loop;
        kpti_map_tss_done:

        // Return user_pml4_pa
        mov rax, r12;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

        kpti_build_oom:
        mov rax, 0xFFFFFFFF;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // kpti_switch_to_kernel — CR3 <- _kernel_pml4_pa (R14b-m4-005 #501).
  pub let kpti_switch_to_kernel : () -> () !{sysreg} @{} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {},
      justification: "R14b-m4-005 (#501) KPTI CR3 kernel switch: load CR3 with _kernel_pml4_pa singleton populated by kernel_main_64 at boot (#500). Real privileged instruction mov cr3, rax; paideia-as encoder emits 0F 22 D8. Full flush of non-global TLB entries is intentional here. Ring-0 only.",
      block: {
        lea rax, [rip + _kernel_pml4_pa];
        mov rax, [rax];
        mov cr3, rax;
        ret
      }
    }

  // kpti_switch_to_user(pml4_pa) — CR3 <- caller-supplied user PML4 phys.
  pub let kpti_switch_to_user : (u64) -> () !{sysreg} @{} =
    fn (pml4_pa: u64) -> unsafe {
      effects: {sysreg}, capabilities: {},
      justification: "R14b-m4-005 (#501) KPTI CR3 user switch: load CR3 from RDI per SysV. Caller (ring-0 trampoline path) ensures RDI is a valid user PML4 phys allocated via aspace_create_user_pgd and populated via kpti_build_user_pml4. Real privileged instruction mov cr3, rdi (0F 22 DF).",
      block: {
        mov cr3, rdi;
        ret
      }
    }
}
