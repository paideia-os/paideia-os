// src/kernel/core/mm/aspace_teardown.pdx — Phase 7 / R14-m2-005 → R16-M0-D11a
//
// Address space teardown — 4-level PML4 walk with U-bit gating.
//
// Walks user address space (PML4 entries 0-255; 256+ is kernel trampoline
// singleton, never touched here).  Freed leaves are dispatched through
// phys_free which since #559 is refcount-guarded: shared frames (CoW leaves
// with refcount >= 2) are decref'd but their bit stays set for remaining
// sharers; only frames whose refcount reaches 0 return to the pool.  This
// makes aspace_teardown CoW-safe without any refcount logic of its own.
//
// R16-M0-D11a fix: preserve r8 (pdpt_pa), r9 (pd_pa), r10 (pt_pa) across
// every nested phys_free call.  phys_free is a SysV function that clobbers
// r8-r11 as scratch (see phys_free.pdx — no push/pop of caller-save regs).
// The pre-D11a code saved indices (r13/r14/r15/rbx) but not bases; indices
// are callee-save-preserved by phys_free automatically, whereas the bases
// are what actually get trashed and re-read by outer-loop iterations.
//
// Also fix the frame mask from 0xFFFFFFFFF000 (bits 12..47, 36-bit; caps
// PA at 128 GiB) to 0x000FFFFFFFFFF000 (bits 12..51, 40-bit per Intel SDM
// Vol 3A §4.5).  Latent at R17.M0 (32 MiB pool) but wrong per spec and
// out-of-band with aspace_map/aspace_clone/pf_handler which all use the
// 40-bit form.

module AspaceTeardown = structure {
  // aspace_teardown(user_pml4_va) -> u64 !{mem} @{}
  //
  // Tear down a user address space by walking 4-level PML4[0..255].
  // For each present leaf with U=1: extract frame PA, phys_free(pa, 0).
  // For each present intermediate table: phys_free(pa, 0) after descent.
  // Finally, phys_free the PML4 itself.
  //
  // Input:  rdi = user_pml4_va (phys_alloc-form kernel VA — the walker
  //               dereferences the PML4 directly; higher-half kernel view).
  // Return: rax = 0 (phys_free never surfaces failure to us — its return
  //               is either OK or INVALID for out-of-pool addresses,
  //               neither of which needs handling here).
  //
  // Register discipline:
  //   r12 = user_pml4_va (survives whole function; callee-save via prologue)
  //   r13 = pml4 index i
  //   r14 = pdpt index j
  //   r15 = pd index k
  //   rbx = pt index l
  //   r8  = pdpt_pa (base for L2 loop)  — SAVED across phys_free
  //   r9  = pd_pa   (base for L3 loop)  — SAVED across phys_free
  //   r10 = pt_pa   (base for L4 loop)  — SAVED across phys_free
  //
  // Alignment: 5-push prologue = 40 bytes; at entry rsp % 16 == 8, after
  // prologue rsp % 16 == 0.  Each phys_free call site pushes enough regs
  // (with an 8-byte alignment pad where needed) so rsp % 16 == 0 at the
  // CALL instruction.
  pub let aspace_teardown : (u64) -> u64 !{mem} @{} = fn (user_pml4_pa: u64) -> unsafe {
    effects: {mem},
    capabilities: {},
    justification: "R14-m2-005 → R16-M0-D11a: walk PML4[0..255], free every present leaf with U=1, then each intermediate table, then the PML4 root itself. Uses phys_free (refcount-guarded per #559) so shared CoW leaves are decref'd not freed; unique intermediates are freed. Register discipline: 5-push callee-save prologue (rbx, r12, r13, r14, r15) preserves caller state and lands rsp % 16 == 0 for nested calls. r8/r9/r10 (SysV caller-save) hold pdpt_pa/pd_pa/pt_pa as walker bases and are SAVED on the stack around every phys_free call because phys_free legitimately clobbers r8-r11 as scratch (see phys_free.pdx). Pre-D11a code only saved indices (which phys_free already preserves as callee-save) but not bases — so on the first phys_free of a leaf the pt_pa base survived (explicitly pushed), but pd_pa (r9) and pdpt_pa (r8) were trashed; subsequent L3/L2 loop iterations read `[r9+idx*8]` / `[r8+idx*8]` from garbage → #PF → nested #PF via IST3 → shifted-frame trap signature. Silent for empty aspaces (task_free_witness R15.M5 never entered inner loops); manifest at R17.M0 first execve on init's fork'd child (multi-leaf aspace). Also normalized the frame mask to 0x000FFFFFFFFFF000 (bits 12..51, 40-bit per Intel SDM Vol 3A §4.5) — pre-D11a used 0xFFFFFFFFF000 (36-bit, caps PA at 128 GiB) which is latent at 32 MiB pool but wrong per spec and inconsistent with aspace_map/aspace_clone/pf_handler. KPTI PML4[256] subtree (trampoline PDPT singleton + trampoline text/data pages) is NEVER walked (L1 loop stops at 256) so no risk of freeing the shared trampoline PDPT. Freeing the PML4 root itself is safe because CR3 is on _kernel_pml4_pa throughout kernel execution (per KPTI, syscall_entry flips CR3 on entry and epilogue flips back on sysret); the user PML4 being freed is not the current one.",
    block: {
      // === Prologue: 5-push callee-save (rsp % 16 == 0 after) ===
      push rbx;
      push r15;
      push r14;
      push r13;
      push r12;

      // r12 = user_pml4_va (callee-save; survives all nested calls)
      // r13 = pml4 index (i)
      mov r12, rdi;
      xor r13, r13;

      // ==================================================================
      // === L1 (PML4) Loop ===
      // ==================================================================
      teardown_l1_loop:
        // Stop at entry 256 (kernel trampoline shared PDPT singleton lives
        // at PML4[256]; entries 257+ are kernel higher-half aliases —
        // neither are per-aspace and must NOT be freed).
        cmp r13, 256;
        jge teardown_l1_done;

        // pml4_entry = [r12 + r13*8]
        // paideia-as #928 workaround: avoid SIB with extended base.
        mov rcx, r13;
        shl rcx, 3;
        add rcx, r12;
        mov rax, [rcx];

        // PRESENT bit
        mov rcx, rax;
        and rcx, 1;
        jz teardown_l1_next;

        // Extract pdpt_pa (40-bit frame per Intel SDM Vol 3A §4.5)
        mov rcx, 0x000FFFFFFFFFF000;
        and rax, rcx;
        mov r8, rax;                        // r8 = pdpt_pa

        xor r14, r14;                       // pdpt_index j = 0

      // ================================================================
      // === L2 (PDPT) Loop ===
      // ================================================================
      teardown_l2_loop:
        cmp r14, 512;
        jge teardown_l2_done;

        // pdpt_entry = [r8 + r14*8]
        mov rcx, r14;
        shl rcx, 3;
        add rcx, r8;
        mov rax, [rcx];

        mov rcx, rax;
        and rcx, 1;
        jz teardown_l2_next;

        // Extract pd_pa
        mov rcx, 0x000FFFFFFFFFF000;
        and rax, rcx;
        mov r9, rax;                        // r9 = pd_pa

        xor r15, r15;                       // pd_index k = 0

      // ==============================================================
      // === L3 (PD) Loop ===
      // ==============================================================
      teardown_l3_loop:
        cmp r15, 512;
        jge teardown_l3_done;

        // pd_entry = [r9 + r15*8]
        mov rcx, r15;
        shl rcx, 3;
        add rcx, r9;
        mov rax, [rcx];

        mov rcx, rax;
        and rcx, 1;
        jz teardown_l3_next;

        // Extract pt_pa
        mov rcx, 0x000FFFFFFFFFF000;
        and rax, rcx;
        mov r10, rax;                       // r10 = pt_pa

        xor rbx, rbx;                       // pt_index l = 0

      // ============================================================
      // === L4 (PT) Loop — Leaf processing ===
      // ============================================================
      teardown_l4_loop:
        cmp rbx, 512;
        jge teardown_l4_done;

        // pt_entry = [r10 + rbx*8]
        mov rcx, rbx;
        shl rcx, 3;
        add rcx, r10;
        mov rax, [rcx];

        // PRESENT?
        mov rcx, rax;
        and rcx, 1;
        jz teardown_l4_next;

        // U-bit (bit 2)?  Only free user-mapped leaves.  Kernel-only
        // leaves (U=0) inside the user half should not appear in R17.M0
        // aspaces, but guard defensively — freeing a kernel-side frame
        // via phys_free would either be a no-op (out-of-pool → INVALID)
        // or corrupt a live kernel mapping.
        mov rcx, 4;
        and rcx, rax;
        jz teardown_l4_next;

        // Extract leaf_pa and dispatch to phys_free (refcount-guarded).
        //   - refcount 1 (unique leaf: private post-split, or fresh
        //     aspace's own alloc) → decref to 0 → clear bitmap bit → pool.
        //   - refcount >= 2 (CoW-shared with parent) → decref to n-1 >= 1
        //     → bit stays set → parent still owns the frame.
        //   - refcount 0 (invariant break; shouldn't happen) → phys_free
        //     no-op via #559 idempotent guard.  No underflow possible.
        mov rcx, 0x000FFFFFFFFFF000;
        and rax, rcx;
        mov rdi, rax;                       // rdi = leaf_pa
        xor rsi, rsi;                       // rsi = order 0

        // Save r8/r9/r10 (phys_free clobbers r8-r11).  Alignment: rsp
        // was % 16 == 0 pre-loop; 3 pushes (24 B) + 8 pad = 32 B → still
        // 0 at CALL.  Indices (r13/r14/r15/rbx) are SysV callee-save
        // and phys_free preserves them; no need to save.
        push r8;
        push r9;
        push r10;
        sub rsp, 8;
        call phys_free;
        add rsp, 8;
        pop r10;
        pop r9;
        pop r8;

      teardown_l4_next:
        add rbx, 1;
        jmp teardown_l4_loop;

      teardown_l4_done:
        // Free the PT page itself (unique to this aspace).  r10 IS the
        // page we're freeing, but we still preserve r8/r9 so the outer
        // L3 loop's next iteration can re-derive r9-relative slots.
        mov rdi, r10;
        xor rsi, rsi;
        push r8;
        push r9;
        call phys_free;
        pop r9;
        pop r8;

      teardown_l3_next:
        add r15, 1;
        jmp teardown_l3_loop;

      teardown_l3_done:
        // Free the PD page itself.  Preserve r8 so L2 loop's next
        // iteration can re-derive.  r9 is being freed; no preserve.
        mov rdi, r9;
        xor rsi, rsi;
        push r8;
        sub rsp, 8;                         // alignment pad (1 push + pad = 16 B)
        call phys_free;
        add rsp, 8;
        pop r8;

      teardown_l2_next:
        add r14, 1;
        jmp teardown_l2_loop;

      teardown_l2_done:
        // Free the PDPT page itself.  r8 is being freed; nothing to
        // preserve — L1 loop re-derives from r12 (callee-save-preserved).
        mov rdi, r8;
        xor rsi, rsi;
        call phys_free;

      teardown_l1_next:
        add r13, 1;
        jmp teardown_l1_loop;

      teardown_l1_done:
        // Free the PML4 page itself.  Safe because CR3 == _kernel_pml4_pa
        // throughout this call (KPTI: syscall_entry flipped CR3 on entry;
        // sys_execve_body runs under kernel PML4; sysret epilogue flips
        // to the NEW user PML4, not the OLD one we're freeing here).
        mov rdi, r12;
        xor rsi, rsi;
        call phys_free;

        // Return 0
        xor eax, eax;

      // === Epilogue: restore callee-save regs (LIFO of prologue) ===
      pop r12;
      pop r13;
      pop r14;
      pop r15;
      pop rbx;
      ret
    }
  } @no_frame
}
