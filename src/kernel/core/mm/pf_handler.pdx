// src/kernel/core/mm/pf_handler.pdx — Phase 5 P5-018 + R14b-M5-008 (#660) + R15-M6-002 (#553)
// Page fault handler — audit entry pf_handler-001.
//
// Handles #PF (page fault) exceptions. Decodes the faulting address
// from CR2, looks up the AS, and attempts to resolve the fault by
// mapping missing pages or validating access permissions. Returns
// error codes for invalid faults (e.g., write to read-only page).
//
// R14b-M5-008 (#660): Phase C — Implements pf_handle_cow fast-flip only.
// R15-M6-002 (#553): Phase D — Adds pf_cow_split for refcount >= 2:
//   allocate fresh frame → copy 4 KiB → rewrite PTE (RW=1, COW=0, preserving
//   US+NX from the old PTE) → invlpg cr2 → decref old frame via phys_free's
//   #559 refcount decref-guard (bit stays set for remaining sharers).
//
// Branch matrix on refcount at leaf-PTE dispatch:
//   refcount == 1     → fast flip in place (last owner promotes to R+W)
//   refcount >= 2     → SPLIT (this task takes a private copy, old frame
//                       stays live for the other sharer(s))
//   refcount == 0     → invariant break — bitmap says allocated, refcount
//                       says free; fall through to KILL/panic
//   FRAME_META_INVALID (=-1) → out-of-pool leaf frame; KILL/panic

module PfHandler = structure {
  let PF_HANDLE_OK   : i64 = 0
  let PF_HANDLE_KILL : i64 = 1

  // pf_handle_cow: Fast-flip handler for CoW pages (refcount == 1 only).
  // Signature: pf_handle_cow(frame_ptr) -> u64  !{mem, sysreg} @{boot}
  // frame_ptr (in rdi) points to the trap frame pushed by trampoline_vec14.
  // Returns PF_HANDLE_OK (0) if flip succeeded; PF_HANDLE_KILL (1) otherwise.
  //
  // Constants (inlined in code):
  //   PTE_PRESENT      = 0x001
  //   PTE_RW           = 0x002
  //   PTE_COW          = 0x200
  //   PTE_FRAME_MASK   = 0x000FFFFFFFFFF000
  //   KERNEL_VMA_BASE  = 0xFFFF800000000000
  pub let pf_handle_cow : (u64) -> u64 !{mem, sysreg} @{boot} = fn(frame_ptr: u64) -> unsafe {
    effects: { mem, sysreg },
    capabilities: { boot },
    justification: "R14b-M5-008 (#660) + R15-M6-002 (#553) + R17-M0-727-D8 (#727): Full CoW handler for shared pages. Five-register callee-save prologue (rbx, r12-r15). Walk PML4→PDPT→PD→PT, validate error_code (P|W only), check PTE (PRESENT + ~RW + COW), read frame refcount, branch on refcount: (==1) → fast-flip in place (OR RW, AND ~COW, store, invlpg, return OK); (>=2) → SPLIT path: phys_alloc(0) fresh frame → memcpy 4 KiB (512 × u64 loop) → build new PTE = new_pa | PRESENT | RW | preserved(US|NX) → store PTE → tlb_shootdown_local(cr2) → phys_free(old_pa,0) which invokes #559 refcount decref-guard (n→n-1≥1 keeps bit set for remaining sharers, n→0 releases). Ordering (alloc → copy → point → decref) matches Linux do_wp_page. (==0 or FRAME_META_INVALID) → return KILL (invariant break, panics via handle_pf). Instrumented with klog markers for bisection diagnostics: entry + 9 validation-error paths + fast-flip success + split success + split alloc failure. #727 fix: choose PML4 root by err.U (bit 2). Under strict KPTI (_isr_stub_14, #720/#721) CR3 is flipped to _kernel_pml4_pa on every ring-3 → ring-0 exception dispatch, so reading live CR3 during a ring-3 #PF gives the kernel PML4 — which has no per-process user leaves, causing the walker to reject at pf_cow_err_pml4 and return KILL. Every real ring-3 CoW fault (post-fork parent's first user-stack write) then hit EXC HALT. Dispatch: err.U=1 (ring-3 fault) → walk _current_tcb.user_pml4_va (@ +16, phys_alloc-form kernel VA, higher-half alias of the user PML4 frame, directly dereferenceable regardless of CR3); err.U=0 (ring-0 fault, e.g. the #661 kernel-side fast-flip witness which installs its CoW mapping into _kernel_pml4_pa) → walk live CR3, matching pre-#727 behaviour so the boot witness continues to pass. NULL guards on _current_tcb and user_pml4_va route to pf_cow_err_pml4 (kernel-only fault at boot / task teardown race → not a CoW).",
    block: {
      // Prologue: save 5 callee-saved registers
      push rbx;
      push r12;
      push r13;
      push r14;
      push r15;
      mov rbx, rdi;                    // rbx = frame_ptr (surviving)

      // Read CR2 (faulting VA) and error_code from trap frame
      mov r12, cr2;                    // r12 = faulting VA (surviving)
      mov r13, [rbx + 128];            // r13 = error_code (surviving)

      // [Entry marker] Log at function entry with CR2 and r12
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_entry;
      mov rdi, 3;                      // INFO level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_entry];
      lea rcx, [rip + k_cr2];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_entry:

      // Validate error_code: must have P=1, W=1; must NOT have RSVD|ID|PK|SS|SGX.
      // #661 bisection: prior mask 0x8069 incorrectly included bit 0 (P). CoW faults
      // MUST have P=1 (page is present but R-only), so bit 0 belongs in the P|W-exact
      // check below, not in the reject mask. Correct reject mask = bits {3, 4, 5, 6, 15}
      // = 0x8078. Confirmed via wire capture:
      //   PF COW ENTRY cr2=0x0000000000400000
      //   PF COW ERR RSVD err=0x0000000000000003    ← 0x3 & 0x8069 = 0x1, false reject
      mov rax, r13;
      and rax, 0x8078;                 // mask reserved bits: RSVD|ID|PK|SS|SGX
      cmp rax, 0;                      // any reserved bits set?
      jne pf_cow_err_rsvd;             // if so, not a CoW fault

      mov rax, r13;
      and rax, 0x3;                    // mask P and W bits
      cmp rax, 0x3;                    // must be exactly both P and W
      jne pf_cow_err_pw;

      // Walk PML4 → PDPT → PD → PT to find the leaf PTE.
      // R17-M0-727-D8 (#727): Under strict KPTI (post-#720/#721), _isr_stub_14
      // flips CR3 to _kernel_pml4_pa when the fault came from ring 3 (leaves
      // CR3 alone for ring-0 faults). So in the handler CR3 always equals
      // _kernel_pml4_pa, which does NOT carry per-process user PTEs.
      // Dispatch by error-code bit 2 (U): if the fault was user-mode, walk
      // the current task's user PML4 via _current_tcb.user_pml4_va (phys_alloc-
      // form kernel VA — higher-half alias of the user PML4 frame, directly
      // dereferenceable). Otherwise (ring-0 fault, incl. the #661 kernel-side
      // fast-flip witness which installs its mapping into _kernel_pml4_pa),
      // walk live CR3, matching the pre-#727 behaviour so that witness path
      // still succeeds. NULL guards on the user-mode path route to
      // pf_cow_err_pml4 (kernel-only fault at boot / task teardown race).
      mov rax, r13;
      and rax, 0x4;                    // err bit 2 = U (user-mode fault)
      cmp rax, 0;
      jne pf_cow_use_user_pml4;

      // Ring-0 fault: walk the live PML4 (== _kernel_pml4_pa in the strict-
      // KPTI handler, but works generally).
      mov rax, cr3;
      and rax, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK (bits 12..51; excludes bit 63 NX/XD)     // mask to physical frame address
      mov rcx, 0xFFFF800000000000;     // KERNEL_VMA_BASE
      add rax, rcx;                    // rax = PML4 VA
      jmp pf_cow_pml4_ready;

      pf_cow_use_user_pml4:
      mov rax, [rip + _current_tcb];
      cmp rax, 0;
      je pf_cow_err_pml4;              // no current task → not a CoW candidate
      mov rax, [rax + 16];             // rax = user_pml4_va (kernel VA form)
      cmp rax, 0;
      je pf_cow_err_pml4;              // task without aspace → not a CoW candidate
      mov rcx, 0xFFFF800000000000;     // KERNEL_VMA_BASE (reused in descent)

      pf_cow_pml4_ready:

      // PML4[idx = cr2>>39 & 0x1FF]
      mov r14, r12;                    // r14 = cr2 (surviving for PTE address calc)
      shr r14, 39;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PML4[idx]
      mov r15, [r14];                  // r15 = PML4[idx] (surviving)
      mov r8d, r15d;                   // load low 32 bits for non-extending test
      and r8d, 0x1;                    // test PRESENT bit (0x001)
      cmp r8d, 0;
      je pf_cow_err_pml4;

      // PDPT descent
      mov rax, r15;
      and rax, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK (bits 12..51; excludes bit 63 NX/XD)
      add rax, rcx;                    // rax = PDPT virtual address
      mov r14, r12;
      shr r14, 30;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PDPT[idx]
      mov r15, [r14];                  // r15 = PDPT[idx]
      mov r8d, r15d;
      and r8d, 0x1;                    // test PRESENT
      cmp r8d, 0;
      je pf_cow_err_pdpt;

      // PD descent
      mov rax, r15;
      and rax, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK (bits 12..51; excludes bit 63 NX/XD)
      add rax, rcx;                    // rax = PD virtual address
      mov r14, r12;
      shr r14, 21;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PD[idx]
      mov r15, [r14];                  // r15 = PD[idx]
      mov r8d, r15d;
      and r8d, 0x1;                    // test PRESENT
      cmp r8d, 0;
      je pf_cow_err_pd;

      // PT descent (leaf)
      mov rax, r15;
      and rax, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK (bits 12..51; excludes bit 63 NX/XD)
      add rax, rcx;                    // rax = PT virtual address
      mov r14, r12;
      shr r14, 12;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PT[idx] (surviving for store)
      mov r15, [r14];                  // r15 = leaf PTE (surviving)

      // Validate leaf PTE shape: PRESENT + ~RW + COW
      mov r8d, r15d;
      and r8d, 0x1;                    // test PRESENT (0x001)
      cmp r8d, 0;
      je pf_cow_err_pt;

      mov r8d, r15d;
      and r8d, 0x2;                    // test RW (0x002) — must be 0 (read-only)
      cmp r8d, 0;
      jne pf_cow_err_leaf_rw;

      mov r8, r15;
      and r8, 0x200;                   // test COW (0x200) — must be 1
      cmp r8, 0;
      je pf_cow_err_leaf_cow;

      // Read refcount from frame_meta[frame_pa >> 12]
      mov rax, r15;
      and rax, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK (bits 12..51; excludes bit 63 NX/XD)     // rax = frame physical address
      mov rdi, rax;                    // frame_pa → rdi for frame_meta_get
      call frame_meta_get;             // rax = refcount
      mov r13, rax;                    // capture refcount in r13 (dead post-err-validation)

      // Branch on refcount
      //   ==1        → fast-flip (last owner promotes in place)
      //   ==0 or -1  → invariant break, jump to kill/panic
      //   >=2        → split path (this task takes a private copy)
      cmp rax, 1;
      je pf_cow_flip;
      cmp rax, 0;
      je pf_cow_err_refcount;
      mov r8, 0xFFFFFFFFFFFFFFFF;      // FRAME_META_INVALID sentinel
      cmp rax, r8;
      je pf_cow_err_refcount;
      // refcount >= 2 → split path
      jmp pf_cow_split;

    pf_cow_flip:
      // Fast-flip: OR PTE_RW, AND ~PTE_COW, store atomically
      // #661 fix (softarch 2026-08-06): prior mask 0xFFFFFFFFFFFFDFFF clears
      // bit 13, not bit 9. PTE_COW = 0x200 = bit 9, so ~PTE_COW must have
      // bit 9 clear = 0xFFFFFFFFFFFFFDFF (13 F's, then D, then FF). Off-by-
      // one-nibble typo in prior mask kept PTE_COW set post-flip, so the
      // sub-test B witness's post-flip PTE_COW=0 assertion always failed.
      mov rax, r15;
      or rax, 0x2;                     // set RW bit (0x002)
      mov r8, 0xFFFFFFFFFFFFFDFF;      // ~0x200 (bit 9 clear)
      and rax, r8;                     // clear COW bit (0x200)
      mov [r14], rax;                  // atomic 8-byte store to PT slot

      // Invalidate TLB entry for cr2 via invlpg
      mov rdi, r12;                    // cr2 → rdi for tlb_shootdown_local
      call tlb_shootdown_local;

      // #661-followup (softarch 2026-08-06): the trap-frame CS/SS patch
      // that used to live here has been removed. Root cause — kernel_
      // main ran with the stale boot-time cached selectors CS=0x18 and
      // SS=0x20 (both invalid post-gdt_install: 0x18 became null, 0x20
      // became user-data DPL=3), so the CPU pushed those into the trap
      // frame on entry and iretq faulted trying to reload them. That
      // bug is now fixed at its source in gdt_install (Gdt module),
      // which does a same-privilege iretq to refresh cached CS/SS to
      // 0x08 / 0x10 right after lgdt. From this point on the CPU pushes
      // valid selectors into every trap frame, so no per-handler patch
      // is needed. See src/kernel/boot/gdt.pdx for the reload sequence.

      // [Success marker] Log successful flip completion.
      //
      // R51 Phase C batch 3 (SUBSYS_MM__ shard, boot-transcript.md §5.1
      // option A): two-line emit — narrative body followed by the byte-
      // identical `PF COW FLIP OK` fingerprint that tests/r14b/
      // expected-boot-r14b-kpti.txt:8 asserts and that verify-fingerprint-
      // coverage.sh's OK_TOK covered_by() anchors on.  Both calls sit under
      // the same _cow_witness_verbose gate — a boot with the witness off
      // (default) emits neither, so the transcript density under smoke is
      // unchanged; a boot with the witness on emits both, in order,
      // preserving the ordered-substring golden.  Same shape as HPET INIT
      // OK from shard 1 (b3db5cb) and BLOB SIG {OK,UNSIGNED,REJECT} from
      // batch 2 (d38d223).
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_success;
      mov rdi, 3;                      // INFO level (narrative)
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_flip_ok_narrative];
      call klog_s1;
      mov rdi, 3;                      // INFO level (fingerprint)
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_flip_ok];
      call klog_s1;
      skip_klog_success:

      // Return PF_HANDLE_OK
      xor rax, rax;
      jmp pf_handle_cow_epilogue;

    // ========================================================================
    // R15-M6-002 (#553): Split path — refcount >= 2.
    // ========================================================================
    // The page is shared with at least one other aspace. Take a private copy
    // for THIS task, rewrite the current-CR3 leaf PTE to point at the fresh
    // frame with R+W (COW cleared), invalidate the TLB entry, and decref the
    // old frame's refcount via phys_free's #559 guard (which keeps the bit
    // set because refcount stays >= 1 — old page still has other sharers).
    //
    // Register discipline through the split body:
    //   r12 = cr2 (faulting VA) — surviving, callee-save
    //   r13 = new frame VA (bit-63 form from phys_alloc) — surviving,
    //          overwrites the now-dead refcount value
    //   r14 = &PT[idx] (leaf-PTE slot address) — surviving, callee-save
    //   r15 = old leaf PTE value (untouched) — surviving, callee-save
    //   rbx = frame_ptr (dead since error_code was read at prologue) — spare
    //   rax/rcx/rdi/rsi/r8/r9/r10/r11 — scratch (all caller-save, no callee
    //          preservation needed across the internal calls: phys_alloc
    //          pushes r12/r13/r14 in its prologue; phys_free/tlb_shootdown_
    //          local touch only caller-save registers; r15/rbx survive as
    //          SysV callee-saves the callees never write).
    pf_cow_split:
      // --- 1. Allocate a fresh frame (born with refcount=1 via #559) ---
      mov rdi, 0;                      // order = 0 (single 4 KiB page)
      call phys_alloc;
      cmp rax, 0;
      je pf_cow_err_split_alloc;       // OOM → panic (no OOM-signalling at R15)
      mov r13, rax;                    // r13 = new_va (surviving; overwrites refcount)

      // --- 2. Copy old frame → new frame (512 × u64 = 4096 bytes) ---
      // Source: high-half VA of old frame  = old_pa + KERNEL_VMA_BASE
      // Dest:   new_va (already in phys_alloc's bit-63 form)
      mov rax, r15;                    // old leaf PTE
      mov rcx, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK
      and rax, rcx;                    // rax = old_pa
      mov rcx, 0xFFFF800000000000;     // KERNEL_VMA_BASE
      add rax, rcx;                    // rax = old_va (source)
      mov rsi, rax;                    // rsi = source VA
      mov rdi, r13;                    // rdi = dest VA
      xor rcx, rcx;                    // rcx = qword index
    memcpy_split_loop:
      cmp rcx, 512;
      jae memcpy_split_done;
      mov r8, [rsi + rcx * 8];         // load qword from src
      mov [rdi + rcx * 8], r8;         // store qword to dst
      add rcx, 1;
      jmp memcpy_split_loop;
    memcpy_split_done:

      // --- 3. Build new PTE and store it into the current-CR3 leaf slot ---
      // new_pte = new_pa | PTE_PRESENT | PTE_RW | preserved(US | NX)
      // - PTE_COW is left cleared (bit 9 = 0): the new frame is singly owned
      //   by this task and no longer participates in the CoW protocol until
      //   another aspace_clone_cow re-shares it.
      // - Cache/global/A/D bits (3..8) reset on the new frame — matches
      //   Linux do_wp_page's pristine-flags policy.
      mov rax, r13;                    // new_va (bit 63 form)
      mov rcx, 0xFFFF800000000000;     // KERNEL_VMA_BASE
      sub rax, rcx;                    // rax = new_pa (bit 63 cleared)
      mov rcx, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK (12..51)
      and rax, rcx;                    // rax = frame field
      mov r8, r15;                     // old PTE
      mov r9, 0x8000000000000004;      // NX (bit 63) | US (bit 2)
      and r8, r9;                      // r8 = preserved US + NX flags
      or rax, r8;                      // frame | preserved flags
      or rax, 0x3;                     // | PTE_PRESENT | PTE_RW  (COW=0)
      mov [r14], rax;                  // atomic 8-byte store into leaf PT slot

      // --- 4. Invalidate the TLB entry for the faulting VA ---
      // Post-store fence + local invlpg. Under iretq's serializing effect,
      // the CPU's subsequent re-execution of the faulting write sees the
      // new PTE (writable + pointing to the new frame).
      mov rdi, r12;                    // cr2 → rdi
      call tlb_shootdown_local;

      // --- 5. Decref the old frame ---
      // #559 decref-guard: (n → n-1 ≥ 1) → keep bit, return OK;
      //                    (n → 0)       → clear bit, return OK.
      // In the split path we entered because n ≥ 2, so the guard keeps the
      // bit set: the old frame stays live for the other sharer(s).
      mov rax, r15;                    // old PTE
      mov rcx, 0x000FFFFFFFFFF000;     // PTE_FRAME_MASK
      and rax, rcx;                    // rax = old_pa
      mov rdi, rax;                    // page → rdi
      xor rsi, rsi;                    // order = 0
      call phys_free;                  // returns 0 in both keep-bit and clear-bit paths

      // --- 6. Split success — emit klog marker if verbose ---
      //
      // R51 Phase C batch 3: two-line emit — narrative body followed by the
      // byte-identical `PF COW SPLIT OK` fingerprint.  The fingerprint is
      // ALLOWLISTED in tools/verify-fingerprint-coverage.sh (line ~116,
      // rationale: no witness writes to a shared frame) — its exact string
      // MUST stay in source to prevent the stale-allowlist trip.  Both
      // calls sit under the same _cow_witness_verbose gate.
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_split_ok;
      mov rdi, 3;                      // INFO level (narrative)
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_split_ok_narrative];
      call klog_s1;
      mov rdi, 3;                      // INFO level (fingerprint)
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_split_ok];
      call klog_s1;
      skip_klog_split_ok:

      // Return PF_HANDLE_OK — iretq re-executes the write on the new writable page.
      xor rax, rax;
      jmp pf_handle_cow_epilogue;

    // [Site 1 marker] Reserved bits rejection
    pf_cow_err_rsvd:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_1;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_err_rsvd_reject];
      lea rcx, [rip + k_err];
      mov r8, r13;
      call klog_s1_x1;
      skip_klog_1:
      jmp pf_handle_cow_kill;

    // [Site 2 marker] P|W exact rejection
    pf_cow_err_pw:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_2;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_err_pw_reject];
      lea rcx, [rip + k_err];
      mov r8, r13;
      call klog_s1_x1;
      skip_klog_2:
      jmp pf_handle_cow_kill;

    // [Site 3 marker] PML4 !PRESENT
    pf_cow_err_pml4:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_3;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pml4_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_3:
      jmp pf_handle_cow_kill;

    // [Site 4 marker] PDPT !PRESENT
    pf_cow_err_pdpt:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_4;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pdpt_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_4:
      jmp pf_handle_cow_kill;

    // [Site 5 marker] PD !PRESENT
    pf_cow_err_pd:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_5;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pd_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_5:
      jmp pf_handle_cow_kill;

    // [Site 6 marker] PT !PRESENT
    pf_cow_err_pt:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_6;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pt_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_6:
      jmp pf_handle_cow_kill;

    // [Site 7 marker] Leaf RW=1 rejection
    pf_cow_err_leaf_rw:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_7;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_leaf_rw_reject];
      lea rcx, [rip + k_pa];
      mov r8, r15;
      call klog_s1_x1;
      skip_klog_7:
      jmp pf_handle_cow_kill;

    // [Site 8 marker] Leaf COW=0 rejection
    pf_cow_err_leaf_cow:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_8;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_leaf_cow_reject];
      lea rcx, [rip + k_pa];
      mov r8, r15;
      call klog_s1_x1;
      skip_klog_8:
      jmp pf_handle_cow_kill;

    // [Site 9 marker] Refcount != 1 rejection
    pf_cow_err_refcount:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_9;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_refcount_reject];
      lea rcx, [rip + k_len];
      mov r8, r13;
      call klog_s1_x1;
      skip_klog_9:
      jmp pf_handle_cow_kill;

    // [Split OOM marker] phys_alloc(0) returned NULL in split path
    // R15 has no OOM-signal to userland; fall through to KILL → handle_pf panic.
    pf_cow_err_split_alloc:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_split_alloc_fail;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_split_alloc_fail];
      lea rcx, [rip + k_len];
      mov r8, r13;                     // r13 still holds original refcount (pre-overwrite)
      call klog_s1_x1;
      skip_klog_split_alloc_fail:
      jmp pf_handle_cow_kill;

    pf_handle_cow_kill:
      // Return PF_HANDLE_KILL (non-CoW, refcount==0, FRAME_META_INVALID, or split OOM)
      mov rax, 1;

    pf_handle_cow_epilogue:
      // Epilogue: restore callee-saved registers
      pop r15;
      pop r14;
      pop r13;
      pop r12;
      pop rbx;
      ret
    }
  }
}
