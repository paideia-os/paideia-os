// src/kernel/core/mm/pf_handler.pdx — Phase 5 P5-018 + R14b-M5-008 (#660)
// Page fault handler — audit entry pf_handler-001.
//
// Handles #PF (page fault) exceptions. Decodes the faulting address
// from CR2, looks up the AS, and attempts to resolve the fault by
// mapping missing pages or validating access permissions. Returns
// error codes for invalid faults (e.g., write to read-only page).
//
// R14b-M5-008 (#660): Phase C — Implements pf_handle_cow fast-flip only.
// Refcount == 1 → atomically flip PTE from (P|RW=0|COW) to (P|RW|~COW).
// Refcount > 1 or 0 → return KILL (split path deferred to #553).

module PfHandler = structure {
  let PF_HANDLE_OK   : i64 = 0
  let PF_HANDLE_KILL : i64 = 1

  // pf_handle_cow: Fast-flip handler for CoW pages (refcount == 1 only).
  // Signature: pf_handle_cow(frame_ptr) -> u64  !{mem, sysreg} @{boot}
  // frame_ptr (in rdi) points to the trap frame pushed by trampoline_vec14.
  // Returns PF_HANDLE_OK (0) if flip succeeded; PF_HANDLE_KILL (1) otherwise.
  //
  // Constants (inlined in code):
  //   PTE_PRESENT      = 0x001
  //   PTE_RW           = 0x002
  //   PTE_COW          = 0x200
  //   PTE_FRAME_MASK   = 0x000FFFFFFFFFF000
  //   KERNEL_VMA_BASE  = 0xFFFF800000000000
  pub let pf_handle_cow : (u64) -> u64 !{mem, sysreg} @{boot} = fn(frame_ptr: u64) -> unsafe {
    effects: { mem, sysreg },
    capabilities: { boot },
    justification: "R14b-M5-008 (#660): Phase C fast-flip handler for CoW pages with refcount==1. Five-register callee-save prologue (rbx, r12-r15). Walk PML4→PDPT→PD→PT, validate error_code (P|W only), check PTE (PRESENT + ~RW + COW), read frame refcount, branch on refcount: (1) → fast-flip: OR RW, AND ~COW, store, invlpg, return OK; (>1 or 0) → return KILL (split deferred to #553). No GS_BASE access (ring-0 only at #660 scope). Instrumented with 11 klog markers for bisection diagnostics (entry, 9 error paths, success).",
    block: {
      // Prologue: save 5 callee-saved registers
      push rbx;
      push r12;
      push r13;
      push r14;
      push r15;
      mov rbx, rdi;                    // rbx = frame_ptr (surviving)

      // Read CR2 (faulting VA) and error_code from trap frame
      mov r12, cr2;                    // r12 = faulting VA (surviving)
      mov r13, [rbx + 128];            // r13 = error_code (surviving)

      // [Entry marker] Log at function entry with CR2 and r12
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_entry;
      mov rdi, 3;                      // INFO level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_entry];
      lea rcx, [rip + k_cr2];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_entry:

      // Validate error_code: must have P=1, W=1; must NOT have RSVD|ID|PK|SS|SGX.
      // #661 bisection: prior mask 0x8069 incorrectly included bit 0 (P). CoW faults
      // MUST have P=1 (page is present but R-only), so bit 0 belongs in the P|W-exact
      // check below, not in the reject mask. Correct reject mask = bits {3, 4, 5, 6, 15}
      // = 0x8078. Confirmed via wire capture:
      //   PF COW ENTRY cr2=0x0000000000400000
      //   PF COW ERR RSVD err=0x0000000000000003    ← 0x3 & 0x8069 = 0x1, false reject
      mov rax, r13;
      and rax, 0x8078;                 // mask reserved bits: RSVD|ID|PK|SS|SGX
      cmp rax, 0;                      // any reserved bits set?
      jne pf_cow_err_rsvd;             // if so, not a CoW fault

      mov rax, r13;
      and rax, 0x3;                    // mask P and W bits
      cmp rax, 0x3;                    // must be exactly both P and W
      jne pf_cow_err_pw;

      // Walk PML4 → PDPT → PD → PT to find the leaf PTE
      // Read CR3 (page-table base)
      mov rax, cr3;
      and rax, 0xFFFFFFFFFFFFF000;     // mask to physical frame address (PTE_FRAME_MASK)
      mov rcx, 0xFFFF800000000000;     // KERNEL_VMA_BASE
      add rax, rcx;                    // rax = PML4 virtual address

      // PML4[idx = cr2>>39 & 0x1FF]
      mov r14, r12;                    // r14 = cr2 (surviving for PTE address calc)
      shr r14, 39;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PML4[idx]
      mov r15, [r14];                  // r15 = PML4[idx] (surviving)
      mov r8d, r15d;                   // load low 32 bits for non-extending test
      and r8d, 0x1;                    // test PRESENT bit (0x001)
      cmp r8d, 0;
      je pf_cow_err_pml4;

      // PDPT descent
      mov rax, r15;
      and rax, 0xFFFFFFFFFFFFF000;
      add rax, rcx;                    // rax = PDPT virtual address
      mov r14, r12;
      shr r14, 30;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PDPT[idx]
      mov r15, [r14];                  // r15 = PDPT[idx]
      mov r8d, r15d;
      and r8d, 0x1;                    // test PRESENT
      cmp r8d, 0;
      je pf_cow_err_pdpt;

      // PD descent
      mov rax, r15;
      and rax, 0xFFFFFFFFFFFFF000;
      add rax, rcx;                    // rax = PD virtual address
      mov r14, r12;
      shr r14, 21;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PD[idx]
      mov r15, [r14];                  // r15 = PD[idx]
      mov r8d, r15d;
      and r8d, 0x1;                    // test PRESENT
      cmp r8d, 0;
      je pf_cow_err_pd;

      // PT descent (leaf)
      mov rax, r15;
      and rax, 0xFFFFFFFFFFFFF000;
      add rax, rcx;                    // rax = PT virtual address
      mov r14, r12;
      shr r14, 12;
      and r14, 0x1FF;
      lea r14, [rax + r14 * 8];        // r14 = &PT[idx] (surviving for store)
      mov r15, [r14];                  // r15 = leaf PTE (surviving)

      // Validate leaf PTE shape: PRESENT + ~RW + COW
      mov r8d, r15d;
      and r8d, 0x1;                    // test PRESENT (0x001)
      cmp r8d, 0;
      je pf_cow_err_pt;

      mov r8d, r15d;
      and r8d, 0x2;                    // test RW (0x002) — must be 0 (read-only)
      cmp r8d, 0;
      jne pf_cow_err_leaf_rw;

      mov r8, r15;
      and r8, 0x200;                   // test COW (0x200) — must be 1
      cmp r8, 0;
      je pf_cow_err_leaf_cow;

      // Read refcount from frame_meta[frame_pa >> 12]
      mov rax, r15;
      and rax, 0xFFFFFFFFFFFFF000;     // rax = frame physical address
      mov rdi, rax;                    // frame_pa → rdi for frame_meta_get
      call frame_meta_get;             // rax = refcount
      mov r13, rax;                    // capture refcount in r13 (dead post-err-validation)

      // Branch on refcount
      cmp rax, 1;
      je pf_cow_flip;

      // refcount != 1: error path
      jmp pf_cow_err_refcount;

    pf_cow_flip:
      // Fast-flip: OR PTE_RW, AND ~PTE_COW, store atomically
      // #661 fix (softarch 2026-08-06): prior mask 0xFFFFFFFFFFFFDFFF clears
      // bit 13, not bit 9. PTE_COW = 0x200 = bit 9, so ~PTE_COW must have
      // bit 9 clear = 0xFFFFFFFFFFFFFDFF (13 F's, then D, then FF). Off-by-
      // one-nibble typo in prior mask kept PTE_COW set post-flip, so the
      // sub-test B witness's post-flip PTE_COW=0 assertion always failed.
      mov rax, r15;
      or rax, 0x2;                     // set RW bit (0x002)
      mov r8, 0xFFFFFFFFFFFFFDFF;      // ~0x200 (bit 9 clear)
      and rax, r8;                     // clear COW bit (0x200)
      mov [r14], rax;                  // atomic 8-byte store to PT slot

      // Invalidate TLB entry for cr2 via invlpg
      mov rdi, r12;                    // cr2 → rdi for tlb_shootdown_local
      call tlb_shootdown_local;

      // #661 (softarch 2026-08-06): patch the CPU-pushed iretq trap frame
      // to force CS=0x08 (kernel code64) and SS=0x10 (kernel data). ROOT
      // CAUSE — latent boot-selector staleness: boot_stub.S enters long
      // mode with CS=0x18 (code64) and reloads SS from 0x20 (data64) in
      // long_mode_trampoline. gdt_install then swaps the GDT — the new
      // layout puts kernel code64 at slot 0x08, kernel data at 0x10,
      // marks slot 0x18 reserved (null descriptor), and repurposes slot
      // 0x20 as user data (DPL=3). kernel_main never reloads CS/SS via
      // a far jump / mov after gdt_install, so it keeps running with
      // CS=0x18 and SS=0x20 all the way through. The staleness was
      // latent because no kernel-mode fault before this witness ever
      // iretq'd back; every other trap either halts (exc_handle) or
      // resumes in ring 3 (KPTI/ring3/UD witnesses). A CoW fast-flip
      // fault is the first kernel→kernel iretq, so it's the first path
      // to try to reload CS=0x18 (null descriptor → #NP) and SS=0x20
      // (DPL=3 while CPL=0 → #GP). Overwriting the pushed CS/SS here
      // lets iretq succeed. Proper fix — reload CS/SS in gdt_install
      // via a far jump + explicit SS reload — is a boot-infrastructure
      // change tracked as follow-up #TBD.
      mov rax, 8;
      mov [rbx + 144], rax;             // CS = kernel code64
      mov rax, 16;
      mov [rbx + 168], rax;             // SS = kernel data

      // [Success marker] Log successful flip completion
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_success;
      mov rdi, 3;                      // INFO level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_flip_ok];
      call klog_s1;
      skip_klog_success:

      // Return PF_HANDLE_OK
      xor rax, rax;
      jmp pf_handle_cow_epilogue;

    // [Site 1 marker] Reserved bits rejection
    pf_cow_err_rsvd:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_1;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_err_rsvd_reject];
      lea rcx, [rip + k_err];
      mov r8, r13;
      call klog_s1_x1;
      skip_klog_1:
      jmp pf_handle_cow_kill;

    // [Site 2 marker] P|W exact rejection
    pf_cow_err_pw:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_2;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_err_pw_reject];
      lea rcx, [rip + k_err];
      mov r8, r13;
      call klog_s1_x1;
      skip_klog_2:
      jmp pf_handle_cow_kill;

    // [Site 3 marker] PML4 !PRESENT
    pf_cow_err_pml4:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_3;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pml4_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_3:
      jmp pf_handle_cow_kill;

    // [Site 4 marker] PDPT !PRESENT
    pf_cow_err_pdpt:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_4;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pdpt_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_4:
      jmp pf_handle_cow_kill;

    // [Site 5 marker] PD !PRESENT
    pf_cow_err_pd:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_5;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pd_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_5:
      jmp pf_handle_cow_kill;

    // [Site 6 marker] PT !PRESENT
    pf_cow_err_pt:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_6;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_pt_absent];
      lea rcx, [rip + k_va];
      mov r8, r12;
      call klog_s1_x1;
      skip_klog_6:
      jmp pf_handle_cow_kill;

    // [Site 7 marker] Leaf RW=1 rejection
    pf_cow_err_leaf_rw:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_7;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_leaf_rw_reject];
      lea rcx, [rip + k_pa];
      mov r8, r15;
      call klog_s1_x1;
      skip_klog_7:
      jmp pf_handle_cow_kill;

    // [Site 8 marker] Leaf COW=0 rejection
    pf_cow_err_leaf_cow:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_8;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_leaf_cow_reject];
      lea rcx, [rip + k_pa];
      mov r8, r15;
      call klog_s1_x1;
      skip_klog_8:
      jmp pf_handle_cow_kill;

    // [Site 9 marker] Refcount != 1 rejection
    pf_cow_err_refcount:
      lea rax, [rip + _cow_witness_verbose];
      mov rax, [rax];
      cmp rax, 1;
      jne skip_klog_9;
      mov rdi, 1;                      // ERROR level
      lea rsi, [rip + SUBSYS_MM__];
      lea rdx, [rip + tag_pf_cow_refcount_reject];
      lea rcx, [rip + k_len];
      mov r8, r13;
      call klog_s1_x1;
      skip_klog_9:
      jmp pf_handle_cow_kill;

    pf_handle_cow_kill:
      // Return PF_HANDLE_KILL (non-CoW or refcount>1)
      mov rax, 1;

    pf_handle_cow_epilogue:
      // Epilogue: restore callee-saved registers
      pop r15;
      pop r14;
      pop r13;
      pop r12;
      pop rbx;
      ret
    }
  }
}
