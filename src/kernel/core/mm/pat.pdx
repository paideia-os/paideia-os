// src/kernel/core/mm/pat.pdx — R23-M1-002 (#876)
//
// IA32_PAT (MSR 0x277) programming — slot 4 = WC (write-combining).
//
// Round: R23 — Framebuffer console (GOP direct)
// Milestone: R23.M1 LFB map + PAT + font
// Roadmap: design/roadmap/r18-plus-bare-metal.md §R23
// Encoder floor: paideia-as v0.20.1 (rdmsr / wrmsr / mov r64,imm64 all
//                established at R21.M1 syscall MSR work).
//
// ==============================================================================
// Purpose
// ==============================================================================
//
// The Page Attribute Table (Intel SDM Vol 3A §11.12) lets an OS override the
// default MTRR-derived cacheability for individual page-table entries. Each
// leaf PTE (and PDE/PDPTE for large pages) carries three cache-hint bits —
// PAT (bit 7 for 4 KiB PTE), PCD (bit 4), PWT (bit 3) — which concatenate
// into a 3-bit index (PAT<<2 | PCD<<1 | PWT) selecting one of 8 memory-type
// slots in IA32_PAT.
//
// Reset value (SDM Vol 3A §11.12.4) is the "compatibility layout":
//
//   slot 0 = 0x06 = WB   (Write-Back)
//   slot 1 = 0x04 = WT   (Write-Through)
//   slot 2 = 0x07 = UC-  (Uncacheable, overridable by MTRR-WC)
//   slot 3 = 0x00 = UC   (strong Uncacheable)
//   slot 4 = 0x06 = WB
//   slot 5 = 0x04 = WT
//   slot 6 = 0x07 = UC-
//   slot 7 = 0x00 = UC
//
// Packed u64 = 0x0007040600070406 (LE bytes: 06 04 07 00 06 04 07 00).
//
// R23.M1 policy: repurpose slot 4 as WC (0x01 = Write-Combining) so the
// framebuffer mapping in #875 can address WC via PTE bits (PAT=1, PCD=0,
// PWT=0). WC coalesces sequential stores into cacheline-sized bursts on
// the memory controller, delivering the ~500 MiB/s fill throughput #875
// wants (naive UC is ~50 MiB/s at 1080p — 10x slower per Intel App Note
// AP-561).
//
// New PAT value = 0x0007040601070406 (only slot 4 changes, 06 -> 01).
//
// ==============================================================================
// Cross-CPU coherence
// ==============================================================================
//
// PAT is a per-logical-CPU MSR. Every CPU that ever writes to a WC page
// (via any path — kernel LFB stores, future user-space DMA windows) must
// see the same PAT programming, otherwise the same PTE bit pattern means
// different memory types on different CPUs. Solution: run pat_init_this_cpu
// on the BSP (kernel_main.pdx, after xsave_enable_this_cpu) and on every
// AP (ap_entry.pdx, mirrored slot). Both invocations write the same
// constant, so the discipline is trivially convergent.
//
// The BSP writes MUST land before the LFB is mapped via aspace_map with WC
// bits (#875) — otherwise the CPU sees the WC PTE bits but IA32_PAT still
// resolves slot 4 as WB, and the write-combining behavior is lost until
// pat_init_this_cpu runs and a subsequent TLB flush picks up the new
// interpretation. Order enforced by kernel_main.pdx: XSAVE substrate ->
// PAT init -> (future R23.M1 wire) fb_map_lfb -> (future R23.M2) console
// wire-up.
//
// APs get PAT init after xsave_enable_this_cpu for symmetry with the BSP
// wire and to keep bring-up-order invariants uniform. AP path emits no
// fingerprint (BSP-only, matching the xsave_enable_this_cpu contract).
//
// ==============================================================================
// Cross-hardware behavior
// ==============================================================================
//
// PAT support is architecturally universal on x86_64 (CPUID.01H:EDX bit 16;
// mandatory for long mode per SDM). No support-gate needed. The MSR write
// cannot #GP on a spec-conformant CPU. QEMU TCG, KVM, T14 G4 (Raptor Lake),
// and every other MVP target expose PAT.
//
// ==============================================================================
// Registers & call discipline
// ==============================================================================
//
// pat_init_this_cpu is called from kernel_main (BSP) and ap_entry (APs).
// Both are @{boot} cap contexts. One nested call to klog_s1 on BSP; no
// nested call on AP (no fingerprint). Single push of rbx aligns rsp for
// klog_s1 (entry rsp%16==8; push rbx -> rsp%16==0; call -> callee sees 8).
// rbx is otherwise unused — pushed strictly for alignment, matching the
// x2apic_probe_bsp precedent (see core/apic/x2apic.pdx L154-176 comment).
//
// wrmsr consumes RCX (MSR index), EAX (low 32 of value), EDX (high 32 of
// value). We build the constant in RAX + RDX directly rather than doing a
// rdmsr / mask / RMW / wrmsr, because:
//   (1) we know the reset value from SDM (no runtime state to preserve);
//   (2) we are the sole PAT programmer in the kernel;
//   (3) constant-write is 4 insts vs. RMW's ~12 insts (no `not` mnemonic
//       fluency issue — the mask idiom requires a scratch reg + shift +
//       xor -1 alternative — but constant-write dodges the whole class).
//
// If a future BIOS / hypervisor introduces per-slot policy we care about,
// migrate this file to RMW-with-mask and preserve non-slot-4 entries; the
// call-graph does not change.
//
// ==============================================================================
// Instruction floor
// ==============================================================================
//
// - mov r64, imm32  (paideia-as v0.20.1 baseline)
// - mov r64, imm64  (paideia-as v0.20.1 baseline)
// - rdmsr           (0F 32) — unused here; documented for completeness
// - wrmsr           (0F 30) — R13-m5-001 syscall_msr_init established
// - lea r64, [rip+sym] (R11 encoder)
// - call rel32       (R11 encoder)

module Pat = structure {

  // IA32_PAT MSR index — SDM Vol 4 Table 2-2.
  pub let IA32_PAT : u64 = 0x277

  // Full IA32_PAT u64 layout — Intel SDM Vol 3A §11.12.3 Table 11-11.
  // Slot i occupies bits [8*i, 8*i+2] of the 64-bit MSR value.  In LE
  // byte-order, slot i is the low 3 bits of byte i of the u64.
  //
  // Default (reset) value — SDM §11.12.4:
  //   byte 0 = 0x06 = WB    (slot 0)
  //   byte 1 = 0x04 = WT    (slot 1)
  //   byte 2 = 0x07 = UC-   (slot 2)
  //   byte 3 = 0x00 = UC    (slot 3)
  //   byte 4 = 0x06 = WB    (slot 4)
  //   byte 5 = 0x04 = WT    (slot 5)
  //   byte 6 = 0x07 = UC-   (slot 6)
  //   byte 7 = 0x00 = UC    (slot 7)
  //
  // R23 patch: byte 4 becomes 0x01 = WC.  All other slots unchanged.
  // wrmsr consumes EDX:EAX; the u64 splits as:
  //   LOW32  (EAX) = bytes 0..3 = 0x00_07_04_06
  //   HIGH32 (EDX) = bytes 4..7 = 0x00_07_04_01
  pub let PAT_VALUE_LOW32  : u64 = 0x00070406      // slots 0..3: WB, WT, UC-, UC
  pub let PAT_VALUE_HIGH32 : u64 = 0x00070401      // slots 4..7: WC, WT, UC-, UC

  // ==========================================================================
  // pat_init_this_cpu: write IA32_PAT with slot 4 = WC.
  // ==========================================================================
  //
  // Runs on BSP (kernel_main) and every AP (ap_entry) after their respective
  // xsave_enable_this_cpu.  Order rationale: XSAVE writes CR4.OSXSAVE which
  // is orthogonal to PAT — sequencing either way is safe.  We pin PAT after
  // XSAVE for BSP+AP symmetry with existing bring-up idiom (each subsystem
  // completes its per-CPU init before the next begins).
  //
  // Emits klog_s1 "PAT INIT OK slot4=WC" on the BSP path only.  APs do not
  // emit — same discipline as xsave_enable_this_cpu (BSP-only fingerprint
  // via `_xsave_area_size == 0` first-invocation check).  For PAT, the
  // "is this the BSP?" check would need a similar guard variable; at MVP
  // we skip the fingerprint on APs entirely by having ap_entry not emit and
  // relying on the ap_entry wire being explicit about "no fingerprint".
  //
  // Trade-off: the AP path also runs pat_init_this_cpu, so an AP hitting
  // this function would ALSO emit "PAT INIT OK" if the fingerprint were
  // unconditional.  Rather than add a per-CPU guard variable, we split the
  // function: pat_init_this_cpu (BSP-only, emits fingerprint) and
  // pat_init_ap (AP-only, silent).  Simpler than a boolean guard, and the
  // two paths share zero state.
  // ==========================================================================
  pub let pat_init_this_cpu : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R23-M1-002 (#876): program IA32_PAT (MSR 0x277) with slot 4 = 0x01 (WC).  New u64 = 0x0007040100070406 (default 0x0007040600070406 with byte 4 patched 0x06 -> 0x01).  wrmsr consumes RCX (index) + EAX (low32) + EDX (high32); we build the constant directly rather than rdmsr/mask/RMW because (a) reset value is architectural per SDM Vol 3A §11.12.4 Table 11-12, (b) we are the sole PAT programmer, (c) constant-write is 4 insts vs RMW's ~12.  RCX loaded with IA32_PAT (0x277).  RAX = 0x00070406 (LOW32 = slots 0..3 default: WB, WT, UC-, UC).  RDX = 0x00070401 (HIGH32 = slot 4 WC + slots 5..7 default: WT, UC-, UC).  Fingerprint via klog_s1(INFO, SUBSYS_MM__, tag_pat_init_ok) — SUBSYS_MM__ because PAT is a page-attribute mechanism owned by the MM subsystem.  Register discipline: 1 push of rbx purely for stack alignment (rbx unused in body; matches x2apic_probe_bsp precedent).  entry rsp%16==8; push rbx -> rsp%16==0; call klog_s1 sees the aligned rsp — nested callee's own ret-push lands rsp%16==8 inside klog_s1 matching wrapper contract.  wrmsr / mov r64,imm32 / lea r64,[rip+sym] / call rel32 all in paideia-as v0.20.1 baseline.  Called from kernel_main AFTER xsave_enable_this_cpu (kernel_main.pdx wire) and BEFORE any WC-flagged aspace_map call (currently none — fb_map_lfb call is deferred to a follow-up commit).  APs call pat_init_ap (silent variant) instead of this function, so this fingerprint fires exactly once per boot.  Cross-CPU coherence: pat_init_ap writes the same constant, so every logical CPU sees IA32_PAT[slot4]=WC and identical PTE bit patterns resolve to WC uniformly.  PAT support is architecturally universal in long mode (SDM Vol 3A §11.12.1) so no CPUID gate needed — the MSR write cannot #GP on a spec-conformant CPU.",
      block: {
        push rbx;

        // (1) Write IA32_PAT.
        //     RCX = 0x277 (MSR index).
        //     EAX = 0x00070406 (LOW32:  slot 0=WB, 1=WT, 2=UC-, 3=UC).
        //     EDX = 0x00070401 (HIGH32: slot 4=WC, 5=WT, 6=UC-, 7=UC).
        mov rcx, 0x277;
        mov rax, 0x00070406;
        mov rdx, 0x00070401;
        wrmsr;

        // (2) Fingerprint: klog_s1(LEVEL_INFO, SUBSYS_MM__, tag_pat_init_ok).
        mov rdi, 3;                             // LEVEL_INFO
        lea rsi, [rip + SUBSYS_MM__];
        lea rdx, [rip + tag_pat_init_ok];
        call klog_s1;

        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pat_init_ap: silent AP variant of pat_init_this_cpu.
  // ==========================================================================
  //
  // Same MSR write as pat_init_this_cpu; no klog_s1 emit.  Called from
  // ap_entry.pdx after xsave_enable_this_cpu.  Leaf function (no nested
  // calls) so no alignment push needed.
  // ==========================================================================
  pub let pat_init_ap : () -> () !{sysreg} @{boot} =
    fn () -> unsafe {
      effects: { sysreg },
      capabilities: { boot },
      justification: "R23-M1-002 (#876): AP-side IA32_PAT programming.  Byte-identical write to pat_init_this_cpu (same constant: RCX=0x277, EAX=0x00070406, EDX=0x00070401).  Silent: no klog_s1 emit, matching the ap_entry-side xsave_enable_this_cpu discipline (BSP-only fingerprints).  Leaf function; no callee-save prologue or alignment push required.  Justification for byte-identity with pat_init_this_cpu (rather than folding into it with a `should_emit` flag): (a) silent AP path is a 4-instruction leaf that fits in one cache line; (b) a runtime guard adds an unnecessary branch to every AP bring-up; (c) cross-CPU coherence contract is easier to audit when the write instruction sequence is a fixed, byte-identical trace on every CPU.",
      block: {
        mov rcx, 0x277;
        mov rax, 0x00070406;
        mov rdx, 0x00070401;
        wrmsr;
        ret
      }
    }
}
