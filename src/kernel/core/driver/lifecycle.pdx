// src/kernel/core/driver/lifecycle.pdx — R29.M2-001 (#1023)
//
// Driver-process lifecycle FSM: state constants + transition validator +
// transition primitive. First landing under R29.M2 (Lifecycle FSM real
// bodies + regression corpus).
//
// Design context
// --------------
// Per design/roadmap/next-wave-softarch.md §3 R29, every driver process
// in PaideiaOS transits a well-defined six-state finite-state machine
// during its lifetime. The FSM is a kernel-owned invariant — a driver
// cannot forge its own state (state bytes live in _driver_table, which
// only this module and driver_table.pdx write to). The R29.M2 milestone
// promotes the previously-aspirational FSM (a comment in
// design/drivers/framework.md) to executable code and locks the
// transition whitelist against R29.M3 (registry v2), R29.M4 (signing +
// signature-failure lifecycle), and R29.M7 (chaos-restart cascade),
// which all consume the same six state names.
//
// State machine (six states, one initial, one terminal)
// -----------------------------------------------------
//
//   Init(0) ── start ────────▶ Running(1) ◀──┐
//                                 │           │ resume
//                                 │ suspend   │
//                                 ▼           │
//                             Suspended(2) ───┘
//                                 │
//               handoff_begin ────┼──── handoff_begin
//                                 ▼           ▼
//                             Handoff(3)
//                                 │
//                                 │ stop
//                                 ▼
//   (direct stop from Init / Running / Suspended also allowed)
//                             Stopping(4)
//                                 │
//                                 ▼
//                             Stopped(5) [terminal]
//
// Whitelisted transitions (all others rejected with ERR_INVALID_TRANSITION):
//
//   Init      -> Running     (start)
//   Init      -> Stopping    (abandon — R29.M7-001, #1044; see below)
//   Running   -> Suspended   (suspend)
//   Suspended -> Running     (resume)
//   Running   -> Handoff     (handoff_begin — graceful takeover)
//   Suspended -> Handoff     (handoff_begin from paused driver)
//   Handoff   -> Stopping    (stop)
//   Running   -> Stopping    (direct stop, no handoff)
//   Suspended -> Stopping    (direct stop from paused driver)
//   Stopping  -> Stopped     (final drain complete)
//
// Stopped is terminal: no transition out. The supervisor unregisters
// the slot via driver_table_unregister after observing DRIVER_STATE_STOPPED
// and reaping the driver process.
//
// Transition table representation
// -------------------------------
// The whitelist is encoded as a single u64 constant DRIVER_LIFECYCLE_TABLE.
// Byte `i` of the u64 (byte at bit position `i*8..i*8+7`, low-endian in
// register load) holds a 6-bit bitmap of legal target states when the
// current state is `i`. Bit `j` of that byte is set iff `i -> j` is a
// whitelisted transition.
//
// The Init -> Stopping edge (R29.M7-001, #1044)
// ---------------------------------------------
// Added when cascade restart landed. It was already the DOCUMENTED
// intent of this FSM — the R29.M5-003 rationale below describes the
// signature-check path as "walking Init -> Stopping without the driver
// ever executing" — but byte 0 of the packed table admitted only
// Running, so the documented path was unreachable and the claim was
// aspirational.
//
// Restart is what made the gap load-bearing. A driver that faults
// during its own initialisation is in Init; without this edge it can
// never reach Stopped, can never be torn down, and can never be
// reaped — a permanently wedged descriptor holding one of 32 slots.
// driver_restart_force_stop needs the walk to Stopped to be TOTAL over
// the state space, and this is the one state from which it was not.
//
// Nothing else changes: no previously legal transition is removed, and
// no previously refused pair other than (Init, Stopping) becomes legal.
// Byte 0 moves 0x02 -> 0x12, so the constant moves
// 0x00000020101A1C02 -> 0x00000020101A1C12.
//
// Building the table:
//   Init(0)      -> {Running(1), Stopping(4)}       = 0b00010010 = 0x12
//   Running(1)   -> {Suspended(2), Handoff(3), Stopping(4)}
//                                                    = 0b00011100 = 0x1C
//   Suspended(2) -> {Running(1),   Handoff(3), Stopping(4)}
//                                                    = 0b00011010 = 0x1A
//   Handoff(3)   -> {Stopping(4)}                   = 0b00010000 = 0x10
//   Stopping(4)  -> {Stopped(5)}                    = 0b00100000 = 0x20
//   Stopped(5)   -> {}                              = 0b00000000 = 0x00
//
// Little-endian packing (byte 0 is Init's mask, byte 5 is Stopped's mask,
// bytes 6..7 are zero-padded for the two unused states above the FSM
// range):
//
//   byte:      7    6    5    4    3    2    1    0
//   value:   0x00 0x00 0x00 0x20 0x10 0x1A 0x1C 0x12
//   u64:     0x00_00_00_20_10_1A_1C_12 = 0x00000020101A1C12
//
// Transition check: read cur state -> `(TABLE >> (cur * 8)) & 0xFF`
// yields the 8-bit whitelist mask for the current state -> test
// `(mask >> new) & 1`. Constant-time; no branches; O(1). This layout
// also gives us instant fuzzability (feed random cur/new pairs, check
// the same bit) which is what R29.M2-005 (regression corpus) will do
// once it lands.
//
// Return codes
// ------------
// Every driver_lifecycle_* function returns a small u64 rc; 0 = success
// (only for functions that logically succeed), non-zero = distinct error
// category. Error codes are chosen from a range disjoint from the
// _driver_table register/unregister codes (0xFFFFFEFF range) so a mixed
// caller-side error trace remains observably distinct.

module Lifecycle = structure {

  // ============================================================================
  // FSM state constants (byte-valued; live at row[+0] byte 0)
  // ============================================================================

  pub let DRIVER_STATE_INIT      : u64 = 0
  pub let DRIVER_STATE_RUNNING   : u64 = 1
  pub let DRIVER_STATE_SUSPENDED : u64 = 2
  pub let DRIVER_STATE_HANDOFF   : u64 = 3
  pub let DRIVER_STATE_STOPPING  : u64 = 4
  pub let DRIVER_STATE_STOPPED   : u64 = 5

  // Cardinality — used by every state-range gate. If a future revision
  // adds a state (e.g. Frozen for OS-hibernation), bump this and extend
  // DRIVER_LIFECYCLE_TABLE below in the same commit.
  pub let DRIVER_STATE_COUNT     : u64 = 6

  // ============================================================================
  // Transition-whitelist table (packed u64, one byte per state).
  // Byte i encodes the 6-bit mask of legal target states from state i.
  //
  // Byte 0 (Init=0):      0x12  -> {Running, Stopping}
  // Byte 1 (Running=1):   0x1C  -> {Suspended, Handoff, Stopping}
  // Byte 2 (Suspended=2): 0x1A  -> {Running,   Handoff, Stopping}
  // Byte 3 (Handoff=3):   0x10  -> {Stopping}
  // Byte 4 (Stopping=4):  0x20  -> {Stopped}
  // Byte 5 (Stopped=5):   0x00  -> {}          [terminal]
  // Bytes 6..7:           0x00  -> reserved (no state)
  //
  // Little-endian packing: byte 0 is the LSB, byte 7 the MSB.
  //   0x00_00_00_20_10_1A_1C_12  == 0x00000020101A1C12
  // ============================================================================

  pub let DRIVER_LIFECYCLE_TABLE : u64 = 0x00000020101A1C12

  // ============================================================================
  // Return codes
  // ============================================================================
  //
  // Success sentinel for driver_lifecycle_transition:
  pub let DRIVER_LIFECYCLE_OK                       : u64 = 0

  // ERR_BAD_SLOT: slot >= DRIVER_TABLE_SLOTS OR slot's in_use byte == 0.
  // Both cases mean "no driver at this slot" — merged into one code to
  // keep callers simple; witness distinguishes by pre-checking in_use.
  pub let DRIVER_LIFECYCLE_ERR_BAD_SLOT             : u64 = 0xFFFFFF01

  // ERR_UNKNOWN_STATE: new_state >= DRIVER_STATE_COUNT (6). Distinct from
  // ERR_INVALID_TRANSITION so a fuzz corpus can distinguish "asked for
  // a nonexistent state" from "asked for a real but disallowed target".
  pub let DRIVER_LIFECYCLE_ERR_UNKNOWN_STATE        : u64 = 0xFFFFFF02

  // ERR_INVALID_TRANSITION: new_state is a valid state but the (cur, new)
  // pair is not on the whitelist. This is the primary invariant-guard
  // error; every unauthorised transition returns this code.
  pub let DRIVER_LIFECYCLE_ERR_INVALID_TRANSITION   : u64 = 0xFFFFFF03

  // -- R29.M5-003 (#1038): spawn/teardown codes -----------------------
  //
  // ERR_NOT_INIT: driver_lifecycle_start was called on a slot whose state
  // is not Init. Distinct from ERR_INVALID_TRANSITION because start does
  // more than transition — it mints a scarce IOMMU domain — and a caller
  // must be able to tell "you may not start a running driver" from "the
  // FSM refused an edge".
  pub let DRIVER_LIFECYCLE_ERR_NOT_INIT             : u64 = 0xFFFFFF04

  // ERR_DOMAIN_EXISTS: the D1.b cardinality refusal at the lifecycle
  // boundary — the slot already carries a KIND_DMA_DOMAIN. Mirrors
  // DRIVER_TABLE_DOMAIN_EXISTS one layer down; both exist because the
  // policy must be observable at the layer the supervisor calls.
  pub let DRIVER_LIFECYCLE_ERR_DOMAIN_EXISTS        : u64 = 0xFFFFFF05

  // ERR_NOT_STOPPED: driver_lifecycle_teardown was called on a slot that
  // has not reached the terminal Stopped state. Tearing down a domain
  // under a driver that may still be issuing DMA is the one ordering
  // mistake that turns a clean teardown into a use-after-free with a
  // bus-mastering device on the other end.
  pub let DRIVER_LIFECYCLE_ERR_NOT_STOPPED          : u64 = 0xFFFFFF06

  // ERR_DOMAIN_REVOKE: the domain survived both the cascade and the
  // precise revoke. Reported rather than swallowed — a driver descriptor
  // cleared over a live domain row is exactly the leak this issue closes.
  pub let DRIVER_LIFECYCLE_ERR_DOMAIN_REVOKE        : u64 = 0xFFFFFF07

  // ============================================================================
  // Audit strings (.rodata) — R29.M5-003 (#1038)
  //
  // Emitted under SUBSYS_CAP_ at LEVEL_INFO, the same channel as the
  // KIND_DMA_DOMAIN dispatch chatter and the iommu/domain_switch.pdx
  // bind/unbind lines, so a domain's whole life — mint, bind, unbind,
  // revoke — lands on one filter.
  // ============================================================================

  pub let drv_dom_mint_msg   : [u8; 19] = "DRIVER DOMAIN MINT\0"
  pub let drv_dom_revoke_msg : [u8; 21] = "DRIVER DOMAIN REVOKE\0"
  pub let drv_dom_k_row      : [u8; 4]  = "row\0"

  // ============================================================================
  // driver_lifecycle_transition_valid(cur_state, new_state) -> u64
  //
  // Pure predicate — no memory access, no side effects. Returns:
  //   1  iff (cur, new) is on the whitelist AND both states are < 6.
  //   0  otherwise.
  //
  // Used by driver_lifecycle_transition for the whitelist check AND
  // exposed independently so R29.M2-005's fuzz corpus can enumerate the
  // entire 36-cell (cur, new) grid without triggering side effects on
  // _driver_table.
  //
  // SysV ABI: rdi = cur_state, rsi = new_state.
  // ============================================================================

  pub let driver_lifecycle_transition_valid : (u64, u64) -> u64 !{} @{} =
    fn (cur_state: u64) (new_state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M2-001 (#1023): pure whitelist predicate. Returns 1 iff cur_state < DRIVER_STATE_COUNT (6) AND new_state < 6 AND (DRIVER_LIFECYCLE_TABLE >> (cur_state*8)) & (1 << new_state) is non-zero. Sequence: (1) bounds gates cur >= 6 -> 0, new >= 6 -> 0. (2) Load DRIVER_LIFECYCLE_TABLE constant into rax. (3) Compute shift count = cur * 8 = cur << 3 (into rcx, since x86 variable shifts consume CL). (4) shr rax, cl -> low byte of rax is the whitelist mask for the current state. (5) Mask 0xFF. (6) Compute bit position = 1 << new_state (via mov r10, 1; mov rcx, new; shl r10, cl). (7) Test mask AND bit -> return 1 if non-zero, else 0. Pure; no memory access. Leaf function; preserves callee-save regs.",
      block: {
        // (1a) cur >= 6 -> return 0.
        cmp rdi, 6;                          // DRIVER_STATE_COUNT
        jae drv_valid_no;

        // (1b) new >= 6 -> return 0.
        cmp rsi, 6;
        jae drv_valid_no;

        // (2) load DRIVER_LIFECYCLE_TABLE.
        mov rax, 0x00000020101A1C12;

        // (3) shift count = cur * 8. shl rax by CL requires cur in CL.
        //     rdi is caller-save; move to rcx (also caller-save so no push).
        mov rcx, rdi;
        shl rcx, 3;                          // cur * 8

        // (4) shr rax by CL -> low byte holds the whitelist mask.
        shr rax, cl;

        // (5) mask low byte.
        mov r10, 0xFF;
        and rax, r10;

        // (6) build (1 << new_state) in r11.
        mov r11, 1;
        mov rcx, rsi;                        // new_state
        shl r11, cl;                         // 1 << new_state

        // (7) test whitelist mask AND bit.
        and rax, r11;
        cmp rax, 0;
        je  drv_valid_no;

        mov rax, 1;
        ret;

      drv_valid_no:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // driver_lifecycle_get_state(slot) -> u64
  //
  // SysV ABI: rdi = slot.
  // Returns:
  //   0..5                                — current state byte (DRIVER_STATE_*).
  //   DRIVER_LIFECYCLE_ERR_BAD_SLOT       — slot >= 32 OR slot not in_use.
  //
  // Callers may distinguish states from the error sentinel by comparing
  // rax against DRIVER_STATE_COUNT (6): rax < 6 -> valid state, else error.
  //
  // Reads the row header via driver_table_read_state_byte AFTER gating
  // the slot with driver_table_slot_in_use (which combines bounds-check +
  // in_use-check). Serves the KIND_DRIVER OP_QUERY_STATE op the R29.M3+
  // handler will build on top.
  // ============================================================================

  pub let driver_lifecycle_get_state : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): return current state byte or DRIVER_LIFECYCLE_ERR_BAD_SLOT. Sequence: (1) call driver_table_slot_in_use(slot). This gates BOTH bounds (slot < 32) AND in_use (byte 1 of header != 0). If it returns 0, return ERR_BAD_SLOT. (2) call driver_table_read_state_byte(slot) which returns the low byte of the header — this IS the current state. Return it. Preserve slot across the first call by re-loading rdi from a callee-save (r12) before the second call. r12 spilled to stack. No arithmetic on the return value — the raw state byte is what the caller expects (values 0..5 map to DRIVER_STATE_INIT..DRIVER_STATE_STOPPED).",
      block: {
        push r12;
        mov r12, rdi;                        // stash slot

        // (1) gate.
        call driver_table_slot_in_use;       // rax = 1 if in-range + in_use
        cmp rax, 0;
        je  drv_get_state_bad_slot;

        // (2) read state byte.
        mov rdi, r12;                        // restore slot
        call driver_table_read_state_byte;   // rax = state
        pop r12;
        ret;

      drv_get_state_bad_slot:
        pop r12;
        mov rax, 0xFFFFFF01;                 // DRIVER_LIFECYCLE_ERR_BAD_SLOT
        ret
      }
    }

  // ============================================================================
  // driver_lifecycle_transition(slot, new_state) -> u64
  //
  // SysV ABI: rdi = slot, rsi = new_state.
  // Returns:
  //   DRIVER_LIFECYCLE_OK                     (0)          — state updated.
  //   DRIVER_LIFECYCLE_ERR_BAD_SLOT           (0xFFFFFF01) — slot >= 32
  //                                                          OR not in_use.
  //   DRIVER_LIFECYCLE_ERR_UNKNOWN_STATE      (0xFFFFFF02) — new_state >= 6.
  //   DRIVER_LIFECYCLE_ERR_INVALID_TRANSITION (0xFFFFFF03) — (cur, new)
  //                                                          not on
  //                                                          whitelist.
  //
  // Sequence:
  //   (1) driver_table_slot_in_use(slot) — bounds + in_use gate.
  //   (2) new_state >= 6 -> ERR_UNKNOWN_STATE.
  //   (3) driver_table_read_state_byte(slot) -> cur_state.
  //   (4) driver_lifecycle_transition_valid(cur_state, new_state).
  //   (5) if invalid -> ERR_INVALID_TRANSITION.
  //   (6) driver_table_write_state_byte(slot, new_state).
  //   (7) return OK.
  //
  // The order matters: gate slot BEFORE checking new_state so a bogus
  // slot argument gets one distinguishable error code regardless of
  // whether the state argument was also bogus. Symmetric to the
  // endpoint_write_pending shape in ipc/endpoint_table.pdx.
  // ============================================================================

  // R29.M6-002 (#1041): the Handoff edge is the third audited primitive,
  // alongside capability mint and revoke.
  //
  // Why here and not at the call sites
  // ----------------------------------
  // The FSM has exactly one commit point — step (6) below — and every
  // handoff in the system passes through it, because the descriptor's
  // state byte is only ever written there. A supervisor that hands a
  // device over therefore cannot do so unaudited, no matter which path
  // it took to get here or which path someone adds later. Auditing at
  // the call sites would put the guarantee back at the mercy of whoever
  // writes the next one.
  //
  // Only the COMMITTED transition to Handoff emits. A refused
  // transition is not a handoff, and recording refusals here would let
  // the lifecycle fuzzer — which walks every (from, to) pair, most of
  // them invalid — flood the ring with non-events and push the real
  // history out of the retained window.
  //
  // The from-state travels in `principal`: "who handed off" is not a
  // separate authority for this event, but "handed off FROM Running"
  // and "handed off FROM Suspended" are materially different stories
  // for an operator reconstructing a takeover, and the field is
  // otherwise unused for a non-capability event.
  //
  // {sysreg} joins the effect set via drv_audit_emit's timestamp read.
  // The only in-kernel caller, driver_lifecycle_start, already declares
  // {mem, sysreg}.
  pub let driver_lifecycle_transition : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (slot: u64) (new_state: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R29.M2-001 (#1023) + R29.M6-002 (#1041): validated FSM transition on the driver at slot, with an audit record on the committed Handoff edge. Sequence: (1) slot gate via driver_table_slot_in_use — combined bounds + in_use check. Return ERR_BAD_SLOT if it fails. (2) new_state >= DRIVER_STATE_COUNT (6) -> ERR_UNKNOWN_STATE. (3) driver_table_read_state_byte(slot) -> cur_state in rax, spilled to r14 because the audit record carries it as the from-state. (4) driver_lifecycle_transition_valid(cur_state, new_state). (5) If it returns 0 -> ERR_INVALID_TRANSITION. (6) driver_table_write_state_byte(slot, new_state) — single-byte header write, preserves in_use/pid. (7) If new_state == DRIVER_STATE_HANDOFF (3), drv_audit_emit(EV_HANDOFF, kind=0, subject=slot, principal=from-state, outcome=0); the emission follows the commit so no record can claim a transition the descriptor does not show. (8) Return OK. Spill slot to r12, new_state to r13 and cur_state to r14 (callee-save) across the five calls so caller-save rdi/rsi can be re-loaded per call. Three pushes also correct the frame alignment this function previously had: entry rsp%16 == 8, three pushes -> 0, which is what SysV wants at each call site. r12/r13/r14 pushed and popped symmetrically at every exit path.",
      block: {
        push r12;
        push r13;
        push r14;                            // 3 pushes -> rsp%16 = 0
        mov r12, rdi;                        // slot
        mov r13, rsi;                        // new_state

        // (1) slot gate.
        call driver_table_slot_in_use;       // rax = 1 iff in-range + in_use
        cmp rax, 0;
        je  drv_trans_bad_slot;

        // (2) new_state range gate.
        cmp r13, 6;                          // DRIVER_STATE_COUNT
        jae drv_trans_unknown_state;

        // (3) read current state.
        mov rdi, r12;                        // slot
        call driver_table_read_state_byte;   // rax = cur_state
        mov r14, rax;                        // from-state, for the audit record

        // (4) whitelist check.
        mov rdi, rax;                        // cur_state
        mov rsi, r13;                        // new_state
        call driver_lifecycle_transition_valid; // rax = 0 or 1

        // (5) invalid?
        cmp rax, 0;
        je  drv_trans_invalid;

        // (6) commit.
        mov rdi, r12;                        // slot
        mov rsi, r13;                        // new_state
        call driver_table_write_state_byte;

        // (7) R29.M6-002: audit the committed Handoff edge, and only it.
        cmp r13, 3;                          // DRIVER_STATE_HANDOFF
        jne drv_trans_ok;
        mov rdi, 3;                          // DRV_AUDIT_EV_HANDOFF
        xor rsi, rsi;                        // kind = 0: not a capability event
        mov rdx, r12;                        // subject   = driver slot
        mov rcx, r14;                        // principal = from-state
        xor r8,  r8;                         // outcome   = OK (committed)
        call drv_audit_emit;

      drv_trans_ok:
        // (8) OK.
        pop r14;
        pop r13;
        pop r12;
        xor rax, rax;                        // DRIVER_LIFECYCLE_OK
        ret;

      drv_trans_bad_slot:
        pop r14;
        pop r13;
        pop r12;
        mov rax, 0xFFFFFF01;                 // ERR_BAD_SLOT
        ret;

      drv_trans_unknown_state:
        pop r14;
        pop r13;
        pop r12;
        mov rax, 0xFFFFFF02;                 // ERR_UNKNOWN_STATE
        ret;

      drv_trans_invalid:
        pop r14;
        pop r13;
        pop r12;
        mov rax, 0xFFFFFF03;                 // ERR_INVALID_TRANSITION
        ret
      }
    }

  // ============================================================================
  // R29.M5-003 (#1038) — per-driver-process DMA-domain lifetime
  // ============================================================================
  //
  // Where the mint is wired, and why there
  // --------------------------------------
  // The domain is minted on the Init -> Running edge, inside
  // driver_lifecycle_start, and revoked after the driver reaches the
  // terminal Stopped state, inside driver_lifecycle_teardown. Three other
  // sites were candidates; each is wrong for a specific reason:
  //
  //   * driver_table_register (slot allocation). Registration is pure
  //     bookkeeping: the supervisor may register a driver it then
  //     declines to start — R29.M4's signature check takes exactly that
  //     path, walking Init -> Stopping without the driver ever executing.
  //     Minting there would strand one of 32 IOMMU rows behind a driver
  //     that never ran.
  //
  //   * Suspended -> Running (resume). A domain minted on resume would be
  //     a *different* domain than the one the driver was using before it
  //     suspended, silently dropping every mapping. Resume must find the
  //     domain it left; that is only true if the mint happened once, on
  //     the entry edge.
  //
  //   * First device_arrived. This is the natural-looking choice and it
  //     is the one D1.b explicitly rejects: minting on device arrival
  //     makes the domain's identity depend on which device showed up
  //     first, which is per-device granularity wearing a per-process
  //     label. design/drivers/blob-policy.md §2.4 fixes the mint "at
  //     driver-process spawn, before the first device_arrived message".
  //
  // Init -> Running is the FSM's single entry edge (see
  // DRIVER_LIFECYCLE_TABLE: byte 0 admits only Running). Putting the mint
  // there means there is exactly one code path that can create a domain
  // for a driver, which is what makes the cardinality claim checkable
  // rather than aspirational. The domain therefore exists for precisely
  // the driver's executable lifetime: it cannot be running without one,
  // and it cannot keep one after it stops.
  //
  // Ordering inside start: the cardinality check precedes the mint, so a
  // refused second start consumes no row. Every failure after the mint
  // rolls the mint back, so no partial state survives an error return.
  // ============================================================================

  // ============================================================================
  // driver_lifecycle_start(slot, cap_slot, parent_mem_slot, tail_word,
  //                        capacity_bytes) -> u64
  //
  // Spawn-time transition: mint the driver's one KIND_DMA_DOMAIN, record
  // it in the descriptor, and move Init -> Running.
  //
  // SysV ABI:
  //   rdi = slot             driver_table slot (0..31), state Init
  //   rsi = cap_slot         cap_table slot to receive the domain cap
  //   rdx = parent_mem_slot  ancestor KIND_MEMORY slot (the driver
  //                          process's memory root)
  //   rcx = tail_word        from dma_tail_pack(ctx_id, bdf, coherency)
  //   r8  = capacity_bytes   mapped-window ceiling (non-zero)
  //
  // Returns:
  //   DRIVER_LIFECYCLE_OK              (0)
  //   DRIVER_LIFECYCLE_ERR_BAD_SLOT    — slot >= 32 or not in_use.
  //   DRIVER_LIFECYCLE_ERR_NOT_INIT    — slot's state is not Init.
  //   DRIVER_LIFECYCLE_ERR_DOMAIN_EXISTS — slot already has a domain.
  //   a DMA_MINT_* code                — propagated verbatim from
  //                                      dma_cap_mint (see below).
  //   a DRIVER_TABLE_DOMAIN_* code     — propagated from set_domain.
  //   a DRIVER_LIFECYCLE_ERR_* code    — propagated from transition.
  //
  // The DMA_MINT_* code is propagated verbatim rather than collapsed into
  // one "mint failed" value. The five mint failures (bad parent kind,
  // illegal rights, row exhaustion, bad argument, bad coherency) call for
  // five different supervisor responses, and the code blocks are disjoint
  // by construction (DMA_* live at 0xFFFFFFD8.., DRIVER_LIFECYCLE_* at
  // 0xFFFFFF0x), so a caller can always tell which layer refused.
  // ============================================================================

  pub let driver_lifecycle_start : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (cap_slot: u64) (parent_mem_slot: u64)
       (tail_word: u64) (capacity_bytes: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M5-003 (#1038): driver-process spawn — mint exactly one KIND_DMA_DOMAIN and move the FSM Init -> Running. Sequence: (1) driver_table_slot_in_use(slot) == 0 -> ERR_BAD_SLOT. (2) driver_table_read_state_byte(slot) != DRIVER_STATE_INIT (0) -> ERR_NOT_INIT. (3) driver_table_has_domain(slot) != 0 -> ERR_DOMAIN_EXISTS — checked BEFORE the mint so a refused duplicate consumes no _dma_domain_table row. (4) dma_cap_mint(cap_slot, parent_mem_slot, R_DMA_ALL=0x618, tail_word, capacity_bytes); non-zero propagated verbatim. Rights are fixed at R_DMA_ALL rather than taken as a sixth argument: the supervisor mints the full set and hands the driver a diminished copy, and SysV has only six argument registers of which this call already uses five. (5) row_id = cap_table[cap_slot].target_ptr bits [15:0], read at stride 24. (6) driver_table_set_domain(slot, row_id, cap_slot); on failure revoke the just-minted cap and propagate. (7) driver_lifecycle_transition(slot, DRIVER_STATE_RUNNING); on failure clear the descriptor field AND revoke the cap, then propagate — no partial state survives an error return. (8) klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, drv_dom_mint_msg, drv_dom_k_row, row_id) audit line. Callee-save: r12=slot, r13=cap_slot, r14=parent then row_id, r15=tail_word, rbx=capacity_bytes. Five pushes leave rsp 16-byte aligned at every nested call (entry %16 == 8, five pushes -> %16 == 0).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // slot
        mov r13, rsi;                        // cap_slot
        mov r14, rdx;                        // parent_mem_slot
        mov r15, rcx;                        // tail_word
        mov rbx, r8;                         // capacity_bytes

        // (1) slot gate.
        mov rdi, r12;
        call driver_table_slot_in_use;
        cmp rax, 0;
        je  drv_start_bad_slot;

        // (2) state must be Init.
        mov rdi, r12;
        call driver_table_read_state_byte;
        cmp rax, 0;                          // DRIVER_STATE_INIT
        jne drv_start_not_init;

        // (3) D1.b cardinality — before any allocation.
        mov rdi, r12;
        call driver_table_has_domain;
        cmp rax, 0;
        jne drv_start_dom_exists;

        // (4) mint the domain.
        mov rdi, r13;                        // target cap slot
        mov rsi, r14;                        // parent KIND_MEMORY slot
        mov rdx, 0x618;                      // R_DMA_ALL
        mov rcx, r15;                        // tail_word
        mov r8,  rbx;                        // capacity_bytes
        call dma_cap_mint;
        cmp rax, 0;
        jne drv_start_epilogue;              // propagate DMA_MINT_* verbatim

        // (5) row_id = cap_table[cap_slot].target_ptr[15:0].
        mov rax, cap_table;
        mov r8, r13;
        shl r8, 3;
        mov r9, r13;
        shl r9, 4;
        add r8, r9;                          // cap_slot * 24
        add rax, r8;
        mov rax, [rax + 16];
        mov r10, 0xFFFF;
        and rax, r10;
        mov r14, rax;                        // row_id (parent no longer needed)

        // (6) record it in the descriptor.
        mov rdi, r12;
        mov rsi, r14;
        mov rdx, r13;
        call driver_table_set_domain;
        cmp rax, 0;
        jne drv_start_attach_fail;

        // (7) FSM Init -> Running.
        mov rdi, r12;
        mov rsi, 1;                          // DRIVER_STATE_RUNNING
        call driver_lifecycle_transition;
        cmp rax, 0;
        jne drv_start_trans_fail;

        // (8) audit.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + drv_dom_mint_msg];
        lea rcx, [rip + drv_dom_k_row];
        mov r8,  r14;                        // row_id
        call klog_s1_x1;

        xor rax, rax;                        // DRIVER_LIFECYCLE_OK
        jmp drv_start_epilogue;

      drv_start_attach_fail:
        // Roll back the mint — a refused attach must leave no cap behind.
        mov r15, rax;                        // save rc
        mov rdi, r13;
        call dma_cap_revoke;
        mov rax, r15;
        jmp drv_start_epilogue;

      drv_start_trans_fail:
        // Roll back attach + mint.
        mov r15, rax;                        // save rc
        mov rdi, r12;
        call driver_table_clear_domain;
        mov rdi, r13;
        call dma_cap_revoke;
        mov rax, r15;
        jmp drv_start_epilogue;

      drv_start_bad_slot:
        mov rax, 0xFFFFFF01;                 // ERR_BAD_SLOT
        jmp drv_start_epilogue;

      drv_start_not_init:
        mov rax, 0xFFFFFF04;                 // ERR_NOT_INIT
        jmp drv_start_epilogue;

      drv_start_dom_exists:
        mov rax, 0xFFFFFF05;                 // ERR_DOMAIN_EXISTS

      drv_start_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // driver_lifecycle_teardown(slot) -> u64
  //
  // Driver-process exit. Requires the FSM to have reached the terminal
  // Stopped state, then:
  //
  //   1. Releases the IOMMU context entry the domain owns, if any, via
  //      iommu_domain_unswitch. Doing this BEFORE the revoke is the whole
  //      ordering point: dma_cap_revoke frees the row, and a freed row
  //      cannot tell the hardware path which context entry to clear.
  //   2. Reads the row's parent_slot — the driver process's KIND_MEMORY
  //      root — and calls dma_cascade_revoke_by_parent on it. The cascade
  //      rather than a precise revoke is what closes the leak: at process
  //      exit the memory root dies, and any domain derived from it that
  //      the descriptor did not name (a supervisor bug, a partially-rolled-
  //      back start) would otherwise outlive the memory authority that
  //      justified it. A stale IOMMU context entry is a device with reach
  //      into memory nobody owns.
  //   3. Falls back to a precise dma_cap_revoke if the row somehow
  //      survived the cascade, and reports ERR_DOMAIN_REVOKE if even that
  //      leaves it live. Clearing the descriptor over a live row would
  //      make the leak invisible, which is worse than failing loudly.
  //   4. Clears the descriptor's domain field, so the slot may be
  //      re-registered and started again with a fresh domain.
  //
  // Idempotent on a slot with no domain (returns OK immediately), so a
  // supervisor may call it unconditionally on the exit path.
  //
  // SysV ABI: rdi = slot.
  // ============================================================================

  pub let driver_lifecycle_teardown : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R29.M5-003 (#1038): driver-process exit — release the context entry, revoke the domain, clear the descriptor field. Sequence: (1) driver_table_slot_in_use(slot) == 0 -> ERR_BAD_SLOT. (2) driver_table_read_state_byte(slot) != DRIVER_STATE_STOPPED (5) -> ERR_NOT_STOPPED. (3) driver_table_has_domain(slot) == 0 -> return OK (idempotent). (4) Read row_id + cap_slot from the descriptor. (5) dma_ctx_state(row_id): if neither DMA_CTX_NONE (0) nor DMA_DECODE_BAD, call iommu_domain_unswitch(cap_slot, row_id) and propagate any failure — the hardware entry must go before the row does. (6) dma_tail_decode_parent(row_id) BEFORE any revoke (the revoke frees the row); if it is not DMA_DECODE_BAD, dma_cascade_revoke_by_parent(parent). (7) If dma_tail_valid(row_id) still reports live, dma_cap_revoke(cap_slot); a non-zero rc there -> ERR_DOMAIN_REVOKE. (8) driver_table_clear_domain(slot). (9) klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, drv_dom_revoke_msg, drv_dom_k_row, row_id) audit line. Callee-save: r12=slot, r13=row_id, r14=cap_slot, r15=parent_slot, rbx=saved rc. Five pushes keep rsp 16-byte aligned at every nested call.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // slot

        // (1) slot gate.
        mov rdi, r12;
        call driver_table_slot_in_use;
        cmp rax, 0;
        je  drv_td_bad_slot;

        // (2) terminal-state gate.
        mov rdi, r12;
        call driver_table_read_state_byte;
        cmp rax, 5;                          // DRIVER_STATE_STOPPED
        jne drv_td_not_stopped;

        // (3) nothing to do?
        mov rdi, r12;
        call driver_table_has_domain;
        cmp rax, 0;
        je  drv_td_ok;

        // (4) descriptor fields.
        mov rdi, r12;
        call driver_table_read_domain_row;
        mov r13, rax;                        // row_id
        mov rdi, r12;
        call driver_table_read_domain_cap;
        mov r14, rax;                        // cap_slot

        // (5) release the context entry first.
        mov rdi, r13;
        call dma_ctx_state;
        cmp rax, 0;                          // DMA_CTX_NONE
        je  drv_td_ctx_done;
        mov r10, 0xFFFFFFFFFFFFFFFF;         // DMA_DECODE_BAD
        cmp rax, r10;
        je  drv_td_ctx_done;

        mov rdi, r14;
        mov rsi, r13;
        call iommu_domain_unswitch;
        cmp rax, 0;
        jne drv_td_epilogue;                 // propagate verbatim

      drv_td_ctx_done:
        // (6) cascade through the dying process's memory root.
        mov rdi, r13;
        call dma_tail_decode_parent;
        mov r15, rax;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r15, r10;
        je  drv_td_precise;

        mov rdi, r15;
        call dma_cascade_revoke_by_parent;

      drv_td_precise:
        // (7) precise fallback if the row outlived the cascade.
        mov rdi, r13;
        call dma_tail_valid;
        cmp rax, 0;
        je  drv_td_clear;

        mov rdi, r14;
        call dma_cap_revoke;
        cmp rax, 0;
        jne drv_td_revoke_fail;

        mov rdi, r13;
        call dma_tail_valid;
        cmp rax, 0;
        jne drv_td_revoke_fail;

      drv_td_clear:
        // (8) drop the descriptor field.
        mov rdi, r12;
        call driver_table_clear_domain;

        // (9) audit.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + drv_dom_revoke_msg];
        lea rcx, [rip + drv_dom_k_row];
        mov r8,  r13;                        // row_id
        call klog_s1_x1;

      drv_td_ok:
        xor rax, rax;                        // DRIVER_LIFECYCLE_OK
        jmp drv_td_epilogue;

      drv_td_bad_slot:
        mov rax, 0xFFFFFF01;                 // ERR_BAD_SLOT
        jmp drv_td_epilogue;

      drv_td_not_stopped:
        mov rax, 0xFFFFFF06;                 // ERR_NOT_STOPPED
        jmp drv_td_epilogue;

      drv_td_revoke_fail:
        mov rax, 0xFFFFFF07;                 // ERR_DOMAIN_REVOKE

      drv_td_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
