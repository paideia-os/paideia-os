// src/kernel/core/driver/keyring.pdx — R29.M4-002 (#1033)
//
// Pinned public-key ring: the set of trust anchors PaideiaOS ships in
// the kernel image, and the reader driver-artifact verification consults
// before it will judge a signature.
//
// Policy: design/drivers/blob-policy.md §1.2 (vendor key pinning) and
// §1.8 (keyring layout + embedding).
//
// -----------------------------------------------------------------------------
// Why the keys are embedded rather than read from a filesystem
// -----------------------------------------------------------------------------
//
// The keyring is what decides whether a driver artifact may be trusted.
// Anything the keyring itself depends on is therefore inside the trust
// boundary, and a filesystem is a very large thing to place inside it:
// the PdxFS-lite superblock is itself signature-checked
// (src/kernel/core/fs/pdxfs_lite/verify.pdx), so reading the trust
// anchors off a mounted volume would make the anchors depend on a
// verification that depends on the anchors. That circle has exactly one
// honest resolution — the root of trust must be present before any
// storage is, and must be covered by whatever signature covers the
// kernel image.
//
// So the three public keys are @include_bytes'd into .rodata at build
// time, exactly as src/kernel/boot/verify_self.pdx embeds the root key
// for the EFI self-check. They are available at the first instruction of
// kernel_main, before ACPI, before PCI enumeration, before NVMe, before
// mount. There is no init step, no allocation, and no failure mode
// between boot and first lookup. The build's own signature (the .pdxsig
// section tools/sign-efi.sh appends) covers them, which is precisely the
// property that makes them anchors.
//
// The cost is that rotating a key requires a kernel rebuild. That is
// deliberate and is stated as policy in blob-policy §1.2: "Rolling a
// vendor key requires a Paideia release; it is not a live-patchable
// configuration."
//
// -----------------------------------------------------------------------------
// Roles, not key names
// -----------------------------------------------------------------------------
//
// Lookup is by ROLE — paideia_root, vendor_intel, vendor_realtek — not
// by filename or fingerprint. A role is the question a caller actually
// has ("who is supposed to have signed this Intel firmware blob?"),
// and it is stable across the key rotations the filename encodes.
// blob-policy §1.2 shows the production layout, where each role
// eventually fans out to several year-suffixed keys
// (intel-firmware-ax211-2026.pk and siblings); at R29 each role resolves
// to a single dev key, and the fan-out becomes a second index level
// under the same role ids rather than a change to this interface.
//
// -----------------------------------------------------------------------------
// The dev keys are all-zero, and that is visible
// -----------------------------------------------------------------------------
//
// assets/keys/*.pub are 1952 zero bytes at R29 — no signing key exists
// until R32 provisions paideia_root_pk. The keyring does not pretend
// otherwise: keyring_fingerprint() over the three roles returns the same
// value for all three, because all three are the same 1952 zeros, and
// keyring_keys_distinct() reports 0 for exactly that reason. R32 lands
// three genuinely different keys and both facts flip. A witness that
// asserts distinctness today would have to be written to expect
// non-distinctness, which is why the predicate is a reported fact rather
// than an fsck failure: a keyring of identical dev keys is *correct* for
// this epoch and *wrong* for the next one, and the honest encoding of
// that is a queryable bit, not a hard error that has to be suppressed.
//
// -----------------------------------------------------------------------------
// Layout of the metadata table
// -----------------------------------------------------------------------------
//
// _keyring_meta is 3 entries x 4 u64 = 96 bytes of pure data:
//
//   +0   role_id        must equal the entry's own index
//   +8   algorithm_id   SIG_ALGO_ML_DSA_65 = 1
//   +16  pk_len         declared length in bytes; must be 1952
//   +24  reserved       0 at R29; the valid-since/valid-until window
//                       from blob-policy §1.2 lands here at R32
//
// The public-key ADDRESSES are deliberately not in this table. A static
// initializer holding the address of another static would need a
// relocation in what is otherwise position-independent .rodata, and
// would force an init pass to fix up — an init pass being exactly the
// pre-first-use dependency the embedding decision above was made to
// avoid. Instead keyring_pk_ptr resolves role -> address with a
// rip-relative lea per role. Three leas and a compare chain is cheaper
// than the relocation, and it means the keyring is usable with zero
// prior calls.
//
// The declared pk_len in the table is therefore not redundant with the
// embedded blob: the blob's true size is fixed at build time by the
// [u8; 1952] type (@include_bytes fails the build if the file is any
// other length), while pk_len is the number this module BELIEVES. fsck
// exists to prove those two agree by construction — see keyring_fsck.

module Keyring = structure {

  // ============================================================================
  // Role identifiers. Contiguous from 0 so a role is directly an index
  // into _keyring_meta; keyring_fsck proves that correspondence rather
  // than assuming it.
  // ============================================================================

  pub let KEYRING_ROLE_PAIDEIA_ROOT  : u64 = 0
  pub let KEYRING_ROLE_VENDOR_INTEL  : u64 = 1
  pub let KEYRING_ROLE_VENDOR_REALTEK: u64 = 2
  pub let KEYRING_ROLE_COUNT         : u64 = 3

  // ML-DSA-65 public key size, NIST FIPS 204 §5.4. Same constant as
  // SigVerify.SIG_ML_DSA_65_PK_BYTES and tools/sign-efi.sh PDX_PK_BYTES;
  // restated here so keyring_fsck is self-contained and a mismatch
  // between the two modules is a witness failure rather than a silent
  // agreement to be wrong together.
  pub let KEYRING_PK_BYTES : u64 = 1952

  // Algorithm id, shared with SigVerify.SIG_ALGO_ML_DSA_65 and the
  // .pdxsig manifest's algorithm_id field (blob-policy §1.3).
  pub let KEYRING_ALGO_ML_DSA_65 : u64 = 1

  // Bytes per _keyring_meta entry.
  pub let KEYRING_META_STRIDE : u64 = 32

  // ============================================================================
  // Return codes — 0xFFFFFD6x, between registry_lookup's 0xFFFFFD4x and
  // sig_verify's 0xFFFFFD8x, so a keyring failure is never confused with
  // a registry query failure or a signature verdict.
  //
  // keyring_lookup returns a public-key VIRTUAL ADDRESS on a hit, so
  // "not found" cannot be signalled by any small number that could also
  // be an address. The 0xFFFFFD6x codes are far below every kernel VA
  // and far above zero, and callers classify with one
  // `cmp rax, 0xFFFFFD60; jae`.
  // ============================================================================

  pub let KEYRING_OK               : u64 = 0
  pub let KEYRING_ERR_NO_SUCH_KEY  : u64 = 0xFFFFFD60
  pub let KEYRING_ERR_BAD_ROLE_ID  : u64 = 0xFFFFFD61
  pub let KEYRING_ERR_BAD_ALGO     : u64 = 0xFFFFFD62
  pub let KEYRING_ERR_BAD_PK_LEN   : u64 = 0xFFFFFD63
  pub let KEYRING_ERR_NULL_PK      : u64 = 0xFFFFFD64

  // ============================================================================
  // The pinned keys.
  //
  // Path from src/kernel/core/driver/keyring.pdx to assets/keys/:
  // four ../ steps (driver -> core -> kernel -> src -> repo root). One
  // more than src/kernel/boot/verify_self.pdx needs, which is the only
  // difference between the two embeddings.
  //
  // @align(64) is not decoration. It is the property
  // SigVerify.driver_sig_verify_algo gate 7 checks: a public key that is
  // not 64-byte aligned did not come from here, and the R32 lattice
  // verifier will burst-load key words in aligned 64-byte chunks.
  //
  // The [u8; 1952] type is the build-time length check. @include_bytes
  // on a file of any other size fails to compile, so the 1952-byte
  // invariant is established before the kernel exists rather than
  // discovered at boot.
  // ============================================================================

  pub let _keyring_pk_paideia_root : [u8; 1952] =
    @include_bytes("../../../../assets/keys/paideia-root-dev.pub") @align(64)

  pub let _keyring_pk_vendor_intel : [u8; 1952] =
    @include_bytes("../../../../assets/keys/intel-firmware-dev.pub") @align(64)

  pub let _keyring_pk_vendor_realtek : [u8; 1952] =
    @include_bytes("../../../../assets/keys/realtek-firmware-dev.pub") @align(64)

  // ============================================================================
  // _keyring_meta — 3 entries x {role_id, algorithm_id, pk_len, reserved}.
  // Pure data, no relocations; see the file header for why the key
  // addresses are not in here.
  // ============================================================================

  pub let _keyring_meta : [u64; 12] = [
    0, 1, 1952, 0,      // KEYRING_ROLE_PAIDEIA_ROOT
    1, 1, 1952, 0,      // KEYRING_ROLE_VENDOR_INTEL
    2, 1, 1952, 0       // KEYRING_ROLE_VENDOR_REALTEK
  ]

  // _keyring_fsck_bad_role: the role id at which the most recent
  // keyring_fsck failed, so a witness or a boot log can name the entry
  // rather than only the kind of failure. KEYRING_ROLE_COUNT (3) means
  // "no failure recorded".
  pub let mut _keyring_fsck_bad_role : u64 = 3

  // ============================================================================
  // keyring_role_count() -> u64
  // ============================================================================

  pub let keyring_role_count : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M4-002 (#1033): return the compile-time role count as an immediate. No memory touched. Leaf; no callee-save writes; no nested calls.",
      block: {
        mov rax, 3;                          // KEYRING_ROLE_COUNT
        ret
      }
    } @no_frame

  // ============================================================================
  // keyring_fsck_bad_role() -> u64
  // ============================================================================

  pub let keyring_fsck_bad_role : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-002 (#1033): read the role id recorded by the most recent keyring_fsck failure. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _keyring_fsck_bad_role];
        mov rax, [rax + 0];
        ret
      }
    } @no_frame

  // ============================================================================
  // keyring_pk_ptr(role_id) -> u64
  //
  //   rdi = role id
  //   -> rax = virtual address of the 1952-byte public key, or 0 for an
  //            unknown role.
  //
  // The role -> address resolver. Zero, not an error code, for an
  // unknown role: this is the raw primitive, and 0 is unambiguous
  // against every address it could otherwise return. keyring_lookup is
  // the checked interface callers should use; this one exists separately
  // so keyring_fsck can obtain an address WITHOUT going through the
  // validation it is trying to test — an fsck built on the checked
  // lookup would be asserting that the checks agree with themselves.
  // ============================================================================

  pub let keyring_pk_ptr : (u64) -> u64 !{mem} @{} =
    fn (role_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-002 (#1033): resolve a role id to the rip-relative address of its embedded public key via a three-way compare chain and one lea per arm. A jump table would need a relocation-bearing array of addresses, the very thing the file header explains _keyring_meta avoids; at three roles the compare chain is also fewer instructions. Unknown role falls through to xor rax,rax — 0, which no valid key address can be. The lea reads no memory (the {mem} effect is declared because the returned address denotes memory the caller will read). Leaf; no callee-save writes; no nested calls.",
      block: {
        cmp rdi, 0;                          // KEYRING_ROLE_PAIDEIA_ROOT
        je  keyring_pk_ptr_root;
        cmp rdi, 1;                          // KEYRING_ROLE_VENDOR_INTEL
        je  keyring_pk_ptr_intel;
        cmp rdi, 2;                          // KEYRING_ROLE_VENDOR_REALTEK
        je  keyring_pk_ptr_realtek;
        xor rax, rax;
        ret;

      keyring_pk_ptr_root:
        lea rax, [rip + _keyring_pk_paideia_root];
        ret;

      keyring_pk_ptr_intel:
        lea rax, [rip + _keyring_pk_vendor_intel];
        ret;

      keyring_pk_ptr_realtek:
        lea rax, [rip + _keyring_pk_vendor_realtek];
        ret
      }
    } @no_frame

  // ============================================================================
  // keyring_meta_field(role_id, field_index) -> u64
  //
  //   rdi = role id (0..2), rsi = field index (0..3)
  //   -> rax = the u64 at _keyring_meta[role_id * 4 + field_index], or
  //            KEYRING_ERR_BAD_ROLE_ID for an out-of-range role or field.
  //
  // Field indices: 0 = role_id, 1 = algorithm_id, 2 = pk_len,
  // 3 = reserved.
  //
  // Both bounds are checked before the address is formed, so no
  // combination of arguments can read outside the 96-byte table. That
  // matters more than it looks: the table sits in .rodata next to 5856
  // bytes of key material, and an unchecked index would read key bytes
  // and present them as metadata.
  // ============================================================================

  pub let keyring_meta_field : (u64, u64) -> u64 !{mem} @{} =
    fn (role_id: u64, field_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-002 (#1033): bounds-checked read of one u64 from the 3x4 metadata table. Both gates (role_id < 3, field_index < 4) precede any address arithmetic, so the load cannot leave the 96-byte table and read the adjacent key material. Offset = role_id*32 + field_index*8 computed as shl 5 and shl 3 — no imul, matching the shift-based stride arithmetic in registry_lookup.pdx and endpoint_table.pdx. Read-only; writes no memory. Leaf; no callee-save writes; no nested calls.",
      block: {
        cmp rdi, 3;                          // KEYRING_ROLE_COUNT
        jae keyring_meta_field_bad;
        cmp rsi, 4;                          // fields per entry
        jae keyring_meta_field_bad;

        mov r8, rdi;
        shl r8, 5;                           // role_id * 32
        mov r9, rsi;
        shl r9, 3;                           // field_index * 8
        add r8, r9;
        lea rax, [rip + _keyring_meta];
        add rax, r8;
        mov rax, [rax + 0];
        ret;

      keyring_meta_field_bad:
        mov rax, 0xFFFFFD61;                 // KEYRING_ERR_BAD_ROLE_ID
        ret
      }
    } @no_frame

  // ============================================================================
  // keyring_lookup(role_id) -> u64
  //
  //   rdi = role id
  //   -> rax = virtual address of the role's ML-DSA-65 public key,
  //            or KEYRING_ERR_NO_SUCH_KEY.
  //
  // The interface named by issue #1033, and the one every consumer
  // should use. It is the checked form: an unknown role, a role whose
  // metadata declares a non-ML-DSA-65 algorithm, a role whose declared
  // pk_len is not 1952, and a role whose key address resolves to 0 all
  // answer KEYRING_ERR_NO_SUCH_KEY.
  //
  // Collapsing those four distinct conditions into ONE error code is
  // deliberate. From the caller's position they are the same fact —
  // there is no usable ML-DSA-65 key for this role — and a caller that
  // could distinguish "role unknown" from "role present but declares the
  // wrong algorithm" would be tempted to handle the second case by
  // reaching past the keyring for the bytes anyway. keyring_fsck is
  // where the distinctions live, because there they drive a repair, not
  // a fallback. The one nuance a caller might want (was this a typo or a
  // corrupt ring?) is recoverable from a subsequent keyring_fsck call.
  //
  // The returned address is 64-byte aligned by construction, which is
  // what lets SigVerify.driver_sig_verify_algo gate 7 use alignment as a
  // proxy for keyring provenance.
  // ============================================================================

  pub let keyring_lookup : (u64) -> u64 !{mem} @{} =
    fn (role_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-002 (#1033): checked role -> public-key-address lookup. Three-push prologue (rbx, r12, r13) brings rsp%16 from 8 to 0 as SysV requires before the three nested calls; rbx holds role_id across them, r12 the 1952 comparand, and r13 is the alignment pad. Order: range gate on role_id first, then algorithm_id == 1 and pk_len == 1952 read through keyring_meta_field (itself bounds-checked), then keyring_pk_ptr, then a non-zero check on the resolved address. Every one of those failures returns the single code KEYRING_ERR_NO_SUCH_KEY — see the header for why they are not distinguished here. Read-only; writes no memory.",
      block: {
        push rbx;
        push r12;
        push r13;                            // rsp%16 = 0

        mov rbx, rdi;                        // role id

        cmp rbx, 3;                          // KEYRING_ROLE_COUNT
        jae keyring_lookup_miss;

        // ---- algorithm_id must be ML-DSA-65 ----
        mov rdi, rbx;
        mov rsi, 1;                          // field 1 = algorithm_id
        call keyring_meta_field;
        cmp rax, 1;                          // KEYRING_ALGO_ML_DSA_65
        jne keyring_lookup_miss;

        // ---- pk_len must be the ML-DSA-65 public key size ----
        mov rdi, rbx;
        mov rsi, 2;                          // field 2 = pk_len
        call keyring_meta_field;
        mov r12, 1952;                       // KEYRING_PK_BYTES
        cmp rax, r12;
        jne keyring_lookup_miss;

        // ---- resolve the address ----
        mov rdi, rbx;
        call keyring_pk_ptr;
        cmp rax, 0;
        je  keyring_lookup_miss;
        jmp keyring_lookup_ret;

      keyring_lookup_miss:
        mov rax, 0xFFFFFD60;                 // KEYRING_ERR_NO_SUCH_KEY

      keyring_lookup_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

  // ============================================================================
  // keyring_fingerprint(role_id) -> u64
  //
  //   rdi = role id
  //   -> rax = 64-bit FNV-1a hash of the role's 1952 public-key bytes,
  //            or 0 for an unknown role.
  //
  // The "fingerprints logged" half of issue #1033. FNV-1a rather than a
  // cryptographic digest because this is an identification aid for logs
  // and witnesses, not a security primitive: it answers "is the key in
  // this build the one I expect" for an operator reading a boot log, and
  // nothing depends on it being collision-resistant. SHA3-256 arrives
  // with the R32 crypto substrate and will replace this the moment there
  // is a reason to compare fingerprints across a trust boundary — which
  // there is not yet, because the fingerprint is never an input to a
  // trust decision anywhere in this file or in sig_verify.pdx.
  //
  // Naming it "fingerprint" while it is a non-cryptographic hash is the
  // one thing that could mislead later, so: this value MUST NOT be used
  // to decide whether two keys are the same key in any context where an
  // adversary chooses either of them. keyring_keys_distinct's use of it
  // is safe because both inputs are build-time constants.
  //
  // At R29 all three roles hash identically — all three files are 1952
  // zero bytes. That is the visible tell of the scaffold epoch, and it
  // is expected to change at R32.
  // ============================================================================

  pub let keyring_fingerprint : (u64) -> u64 !{mem} @{} =
    fn (role_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-002 (#1033): FNV-1a-64 over the role's 1952 embedded public-key bytes. Three-push prologue (rbx, r12, r13) brings rsp%16 to 0 for the one nested call (keyring_pk_ptr) and holds the running hash, the multiplier and the byte pointer across the loop. Unknown role returns 0 before any load. Per byte: mov_b zero-extending load, xor into the accumulator, imul by the FNV prime 0x100000001b3 — reg-reg imul only, the encoder form already used by hpet_now_ns; the 64-bit offset basis and prime are materialised with mov r64, imm64, the form already used by rsdp.pdx's signature constants. Non-cryptographic by intent and never an input to a trust decision (see header). Read-only; writes no memory.",
      block: {
        push rbx;
        push r12;
        push r13;                            // rsp%16 = 0

        call keyring_pk_ptr;                 // rdi already holds role_id
        cmp rax, 0;
        je  keyring_fingerprint_ret;         // unknown role -> 0

        mov rbx, rax;                        // key byte pointer
        mov r13, 0xcbf29ce484222325;         // FNV-1a-64 offset basis
        mov r12, 0x00000100000001b3;         // FNV-1a-64 prime
        mov rcx, 1952;                       // KEYRING_PK_BYTES

      keyring_fingerprint_scan:
        cmp rcx, 0;
        je  keyring_fingerprint_done;
        mov_b rax, [rbx + 0];
        xor r13, rax;
        mov rax, r13;
        imul rax, r12;
        mov r13, rax;
        add rbx, 1;
        sub rcx, 1;
        jmp keyring_fingerprint_scan;

      keyring_fingerprint_done:
        mov rax, r13;

      keyring_fingerprint_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

  // ============================================================================
  // keyring_keys_distinct() -> u64
  //
  //   -> rax = 1 if all three roles carry different key material,
  //            0 if any two roles share it.
  //
  // Reported, not enforced. At R29 this returns 0 because all three dev
  // keys are the same 1952 zero bytes, and that is the correct state for
  // this epoch — see the file header. R32 must flip it to 1, and a
  // regression test that pins the value across the R32 boundary is how
  // the flip gets noticed.
  //
  // Compares fingerprints rather than the 5856 raw bytes because both
  // inputs are build-time constants under no adversary's control; see
  // the caveat on keyring_fingerprint.
  // ============================================================================

  pub let keyring_keys_distinct : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-002 (#1033): pairwise fingerprint comparison across the three roles. Three-push prologue (rbx, r12, r13) brings rsp%16 to 0 for the three nested keyring_fingerprint calls and parks the three results. Any equal pair answers 0. Read-only; writes no memory.",
      block: {
        push rbx;
        push r12;
        push r13;                            // rsp%16 = 0

        xor rdi, rdi;
        call keyring_fingerprint;
        mov rbx, rax;

        mov rdi, 1;
        call keyring_fingerprint;
        mov r12, rax;

        mov rdi, 2;
        call keyring_fingerprint;
        mov r13, rax;

        xor rax, rax;
        cmp rbx, r12;
        je  keyring_keys_distinct_ret;
        cmp rbx, r13;
        je  keyring_keys_distinct_ret;
        cmp r12, r13;
        je  keyring_keys_distinct_ret;
        mov rax, 1;

      keyring_keys_distinct_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

  // ============================================================================
  // keyring_fsck() -> u64
  //
  //   -> rax = KEYRING_OK, or the first failure's code. On failure the
  //            offending role id is left in _keyring_fsck_bad_role,
  //            readable via keyring_fsck_bad_role().
  //
  // Walks all three entries and proves, for each:
  //
  //   a. meta[i].role_id == i          -> KEYRING_ERR_BAD_ROLE_ID
  //      The table is index-addressed everywhere else in this file; if a
  //      row's self-declared id disagreed with its position, every
  //      lookup would silently read another role's metadata.
  //   b. meta[i].algorithm_id == 1     -> KEYRING_ERR_BAD_ALGO
  //   c. meta[i].pk_len == 1952        -> KEYRING_ERR_BAD_PK_LEN
  //      The check issue #1033 names: the DECLARED length must equal
  //      ML-DSA-65's public key size. The embedded blob's true length is
  //      already fixed at 1952 by its [u8; 1952] type, so this is
  //      specifically about the number the module believes matching the
  //      number the build enforced — the pair that would otherwise drift
  //      apart the first time someone edited one of them.
  //   d. keyring_pk_ptr(i) != 0        -> KEYRING_ERR_NULL_PK
  //      Every declared role must actually resolve to embedded bytes; a
  //      role present in the table but missing from the resolver is a
  //      key that lookup would report as absent for no visible reason.
  //
  // Fail-fast on the first bad entry rather than accumulating: the
  // keyring is 96 bytes of build-time constants, so any failure here is
  // a build defect and the first one is the one to fix. Alignment is not
  // checked because @align(64) is a build-time guarantee, and it is
  // sig_verify gate 7 that enforces it where it matters — on the pointer
  // a caller actually presents.
  // ============================================================================

  pub let keyring_fsck : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-002 (#1033): four-property walk over the three keyring entries — self-consistent role id, ML-DSA-65 algorithm id, declared pk_len == 1952, and a resolvable non-null key address. Five-push prologue (rbx, r12, r13, r14, r15) brings rsp%16 from 8 to 0 as SysV requires before the nested keyring_meta_field / keyring_pk_ptr calls and holds the loop index and the pending error code across them; r14 carries the 1952 comparand so the imm need not be re-materialised inside the loop. Fail-fast: the first violated property stores its role id to _keyring_fsck_bad_role and returns its code. Writes only that one diagnostic word.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                            // rsp%16 = 0

        mov r14, 1952;                       // KEYRING_PK_BYTES
        xor rbx, rbx;                        // role index

      keyring_fsck_scan:
        cmp rbx, 3;                          // KEYRING_ROLE_COUNT
        jae keyring_fsck_clean;

        // ---- (a) meta[i].role_id == i ----
        mov rdi, rbx;
        xor rsi, rsi;                        // field 0 = role_id
        call keyring_meta_field;
        cmp rax, rbx;
        jne keyring_fsck_bad_role_id;

        // ---- (b) meta[i].algorithm_id == ML-DSA-65 ----
        mov rdi, rbx;
        mov rsi, 1;                          // field 1 = algorithm_id
        call keyring_meta_field;
        cmp rax, 1;                          // KEYRING_ALGO_ML_DSA_65
        jne keyring_fsck_bad_algo;

        // ---- (c) meta[i].pk_len == 1952 ----
        mov rdi, rbx;
        mov rsi, 2;                          // field 2 = pk_len
        call keyring_meta_field;
        cmp rax, r14;
        jne keyring_fsck_bad_pk_len;

        // ---- (d) the role resolves to embedded key bytes ----
        mov rdi, rbx;
        call keyring_pk_ptr;
        cmp rax, 0;
        je  keyring_fsck_null_pk;

        add rbx, 1;
        jmp keyring_fsck_scan;

      keyring_fsck_bad_role_id:
        mov r15, 0xFFFFFD61;                 // KEYRING_ERR_BAD_ROLE_ID
        jmp keyring_fsck_fail;

      keyring_fsck_bad_algo:
        mov r15, 0xFFFFFD62;                 // KEYRING_ERR_BAD_ALGO
        jmp keyring_fsck_fail;

      keyring_fsck_bad_pk_len:
        mov r15, 0xFFFFFD63;                 // KEYRING_ERR_BAD_PK_LEN
        jmp keyring_fsck_fail;

      keyring_fsck_null_pk:
        mov r15, 0xFFFFFD64;                 // KEYRING_ERR_NULL_PK

      keyring_fsck_fail:
        lea rcx, [rip + _keyring_fsck_bad_role];
        mov [rcx + 0], rbx;
        mov rax, r15;
        jmp keyring_fsck_ret;

      keyring_fsck_clean:
        mov rcx, 3;                          // KEYRING_ROLE_COUNT = "none"
        lea rax, [rip + _keyring_fsck_bad_role];
        mov [rax + 0], rcx;
        xor rax, rax;                        // KEYRING_OK

      keyring_fsck_ret:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame
}
