// src/kernel/core/driver/sig_telemetry.pdx — R29.M4-004 (#1035)
//
// Signing-failure telemetry and the audit path for blob-driver
// signature verification.
//
// Policy: design/drivers/blob-policy.md §1.5 (failure-mode taxonomy),
// §1.10 (this file: the audit record schema and level mapping), and
// D1.c — blob drivers have FULL audit access, no special-casing.
//
// -----------------------------------------------------------------------------
// Why the recording lives here and not at the call sites
// -----------------------------------------------------------------------------
//
// blob_load_verify (blob_load.pdx) calls blob_sig_audit unconditionally
// on every outcome — pass, scaffold, and each of the eleven failure
// codes. That is deliberate. "Every rejection is audited" cannot be a
// convention that N driver load paths each honour; it has to be a
// property of the one function that produces the verdict, or the first
// path someone adds in a hurry is the one that loads an unverified blob
// silently. The verifier records, and no caller can opt out.
//
// The record goes to two places at once and they are not the same
// substrate:
//
//   * A structured 8-field record in a small in-module ring, readable by
//     `safectl` and by the boot witness. This is the machine-readable
//     surface — the "dashboard hook" #1035 asks for. It survives
//     regardless of whether the audit bridge is armed.
//
//   * A klog line at the level the outcome deserves. Failures go at
//     LEVEL_ERROR, which is what carries them across
//     klog_audit_forward's filter (level <= 1) into the durable audit
//     log at /system/audit/log.pdaudit. Scaffold verdicts go at
//     LEVEL_WARN and successes at LEVEL_INFO — visible in dmesg,
//     deliberately NOT clogging the tamper-evident log with routine
//     traffic.
//
// The level mapping is therefore not cosmetic: it IS the filter that
// decides what becomes a durable audit record. Changing
// blob_audit_level changes what an auditor can see six months later.
//
// -----------------------------------------------------------------------------
// Which half failed is the operationally load-bearing field
// -----------------------------------------------------------------------------
//
// §1.5 assigns different severities to the two halves for a reason a
// single "signature verification failed" line destroys:
//
//   vendor-sig failure  -> the bytes on disk are not the bytes the
//                          vendor published. Corruption, or an attempted
//                          supply-chain substitution. Highest severity.
//   paideia-sig failure -> the blob may be a genuine vendor artefact
//                          that Paideia release engineering never
//                          reviewed or re-signed. A process failure, or
//                          a missed key roll.
//   both                -> catastrophic; §1.5 calls for an alert.
//   hash mismatch       -> the blob and its manifest disagree; the blob
//                          was tampered with or the manifest is stale.
//   manifest malformed  -> the .pdxsig is not parseable at all.
//
// So the record carries the gate id (blob_failed_gate) alongside the
// combined verdict, and BOTH raw per-gate SIG_* verdicts, so an operator
// reading the audit log can tell SIG_BAD_LENGTH (a wrong-sized signature
// field) from SIG_UNVERIFIABLE (real material, no substrate) without
// re-running anything.
//
// -----------------------------------------------------------------------------
// Record schema (blob-policy §1.10)
// -----------------------------------------------------------------------------
//
// 16 records x 8 qwords = 128 qwords. Drop-oldest, indexed by a
// monotonic sequence counter so `blob_audit_seq()` reports the true
// number of verifications ever performed even after the ring wraps —
// a ring that silently forgets how much it forgot is not an audit
// surface.
//
//   field 0  timestamp        raw TSC (kread_tsc). Wall-clock
//                             correlation is the audit log's job; what
//                             matters here is ordering and delta.
//   field 1  verdict          the combined BLOB_* verdict
//   field 2  gate             BLOB_GATE_* — which half/stage failed
//   field 3  vendor_role      keyring role id: blob identity, part 1
//   field 4  blob_len         from the manifest, 0 if none
//   field 5  hash_prefix      first 8 bytes of manifest.blob_hash:
//                             blob identity, part 2. A prefix rather
//                             than the whole digest because 8 bytes is
//                             enough to correlate a log line with a
//                             release artefact and the full digest is
//                             in the manifest the operator already has.
//   field 6  vendor_verdict   raw SIG_* from the vendor gate
//   field 7  paideia_verdict  raw SIG_* from the paideia gate
//
// Fields 4 and 5 are read at manifest offsets 48 (BLOB_OFF_BLOB_LEN) and
// 80 (BLOB_OFF_BLOB_HASH). That is a deliberate coupling to
// blob_load.pdx's parsed layout, and the only one in this file; if that
// layout moves, these two displacements move with it.

module SigTelemetry = structure {

  // ============================================================================
  // Ring geometry. 16 records is chosen so the index arithmetic is a
  // mask and the whole ring is one 1 KiB .bss object — large enough that
  // a boot's worth of blob loads (a handful) never wraps, small enough
  // that it costs nothing.
  // ============================================================================

  pub let BLOB_AUDIT_RECORDS      : u64 = 16
  pub let BLOB_AUDIT_RING_MASK    : u64 = 15
  pub let BLOB_AUDIT_FIELDS       : u64 = 8
  pub let BLOB_AUDIT_RECORD_BYTES : u64 = 64

  pub let BLOB_AUDIT_F_TS         : u64 = 0
  pub let BLOB_AUDIT_F_VERDICT    : u64 = 1
  pub let BLOB_AUDIT_F_GATE       : u64 = 2
  pub let BLOB_AUDIT_F_ROLE       : u64 = 3
  pub let BLOB_AUDIT_F_BLOB_LEN   : u64 = 4
  pub let BLOB_AUDIT_F_HASH_PFX   : u64 = 5
  pub let BLOB_AUDIT_F_VENDOR_V   : u64 = 6
  pub let BLOB_AUDIT_F_PAIDEIA_V  : u64 = 7

  // 16 records x 64 B = 1024 B = 128 u64. .bss; the boot zeroing plus the
  // sequence-counter gate in blob_audit_field mean no slot is ever read
  // before it is written.
  pub let mut _blob_audit_ring : [u64; 128] = uninit @align(64)

  // Monotonic across the whole boot; never masked. blob_audit_seq() is
  // the count of verifications performed, not the count retained.
  pub let mut _blob_audit_seq   : u64 = 0

  pub let mut _blob_audit_error : u64 = 0
  pub let mut _blob_audit_warn  : u64 = 0
  pub let mut _blob_audit_info  : u64 = 0

  // Scratch for the fields computed by nested calls, so blob_sig_audit
  // does not need a sixth callee-save register across them. Also useful
  // in their own right: `safectl` reads the last gate without decoding
  // the ring.
  pub let mut _blob_audit_last_gate : u64 = 0
  pub let mut _blob_audit_last_ts   : u64 = 0

  // ============================================================================
  // blob_audit_level(verdict: u64) -> u64
  //
  //   -> rax = LEVEL_INFO  (3) for BLOB_OK
  //            LEVEL_WARN  (2) for BLOB_UNSIGNED_SCAFFOLD
  //            LEVEL_ERROR (1) for everything else
  //
  // This is the audit-bridge filter in disguise. klog_audit_forward
  // forwards level <= 1, so exactly the failures — and no routine
  // traffic — become durable records in /system/audit/log.pdaudit.
  //
  // The scaffold verdict sits at WARN rather than ERROR on purpose: at
  // R29 EVERY blob is unsigned, so recording each one as a durable audit
  // failure would fill the tamper-evident log with a fact the boot log
  // already states once and teach operators to ignore it. It is loud in
  // dmesg and quiet in the audit log. When R32 makes the scaffold
  // verdict a hard rejection, its level moves to ERROR with the same
  // one-line edit that makes it a rejection.
  // ============================================================================

  pub let blob_audit_level : (u64) -> u64 !{} @{} =
    fn (verdict: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M4-004 (#1035): verdict -> klog level. Two exact compares (BLOB_OK -> LEVEL_INFO 3, BLOB_UNSIGNED_SCAFFOLD -> LEVEL_WARN 2), default LEVEL_ERROR 1. The default is the failing case deliberately: an unrecognised verdict must be loud and must reach the audit bridge, never be silently downgraded. No memory touched, no effects. Leaf; no callee-save writes; no nested calls. Labels prefixed blob_audit_level_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;                          // BLOB_OK
        jne blob_audit_level_not_ok;
        mov rax, 3;                          // LEVEL_INFO
        ret;

      blob_audit_level_not_ok:
        cmp rdi, 1;                          // BLOB_UNSIGNED_SCAFFOLD
        jne blob_audit_level_error;
        mov rax, 2;                          // LEVEL_WARN
        ret;

      blob_audit_level_error:
        mov rax, 1;                          // LEVEL_ERROR
        ret
      }
    }

  // ============================================================================
  // Simple readers over the counters. Each is one rip-relative load.
  // ============================================================================

  pub let blob_audit_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-004 (#1035): read the monotonic verification counter. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _blob_audit_seq];
        mov rax, [rax + 0];
        ret
      }
    }

  pub let blob_audit_error_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-004 (#1035): read the ERROR-level audit counter. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _blob_audit_error];
        mov rax, [rax + 0];
        ret
      }
    }

  pub let blob_audit_warn_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-004 (#1035): read the WARN-level audit counter. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _blob_audit_warn];
        mov rax, [rax + 0];
        ret
      }
    }

  pub let blob_audit_info_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-004 (#1035): read the INFO-level audit counter. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _blob_audit_info];
        mov rax, [rax + 0];
        ret
      }
    }

  pub let blob_audit_last_gate : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-004 (#1035): read the gate id of the most recent verification. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _blob_audit_last_gate];
        mov rax, [rax + 0];
        ret
      }
    }

  // ============================================================================
  // blob_audit_field(back: u64, field: u64) -> u64
  //
  //   rdi = 0 for the newest record, 1 for the one before it, ...
  //   rsi = field index 0..7
  //   -> rax = the field value, or 0 when the request names a record
  //            that does not exist (nothing recorded yet, more than 16
  //            back, or further back than the sequence counter reaches)
  //            or a field out of range.
  //
  // The `back >= seq` bound matters as much as `back >= 16`: without it,
  // a query for record 5 after only two verifications would read a slot
  // that has never been written and report it as history.
  // ============================================================================

  pub let blob_audit_field : (u64, u64) -> u64 !{mem} @{} =
    fn (back: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M4-004 (#1035): bounds-checked read into the audit ring. Three guards precede all address arithmetic — field < 8, back < 16 (ring depth), and back < seq (records actually written) — so no unwritten slot and no byte past the 1024-byte object is ever read. Index arithmetic: idx = (seq - 1 - back) & 15; byte offset = idx << 6 plus field << 3. r10/r11 are caller-save scratch; no prologue needed. Read-only. Leaf; no nested calls. Labels prefixed blob_audit_field_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _blob_audit_seq];
        mov r10, [r10 + 0];

        cmp r10, 0;
        je  blob_audit_field_zero;           // nothing recorded
        cmp rsi, 8;                          // BLOB_AUDIT_FIELDS
        jae blob_audit_field_zero;
        cmp rdi, 16;                         // BLOB_AUDIT_RECORDS
        jae blob_audit_field_zero;
        cmp rdi, r10;
        jae blob_audit_field_zero;           // further back than history

        sub r10, 1;
        sub r10, rdi;
        and r10, 15;                         // BLOB_AUDIT_RING_MASK
        shl r10, 6;                          // * BLOB_AUDIT_RECORD_BYTES

        mov rax, rsi;
        shl rax, 3;                          // field * 8
        add r10, rax;

        lea r11, [rip + _blob_audit_ring];
        add r11, r10;
        mov rax, [r11 + 0];
        ret;

      blob_audit_field_zero:
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // blob_sig_audit(verdict, vendor_verdict, paideia_verdict,
  //                vendor_role, manifest_ptr) -> ()
  //
  //   rdi = combined BLOB_* verdict
  //   rsi = raw SIG_* verdict from the vendor gate
  //   rdx = raw SIG_* verdict from the paideia gate
  //   rcx = keyring role id the manifest named as its vendor
  //   r8  = parsed manifest, or 0 (blob_len and hash prefix read from it)
  //
  // Called by blob_load_verify_with_hash on EVERY outcome. Appends the
  // structured record and emits the klog line whose level decides
  // whether the outcome becomes durable.
  //
  // A null manifest_ptr is not an error here — it is the ordinary shape
  // of the BLOB_ERR_BAD_MANIFEST_PTR rejection, which still deserves a
  // record. Fields 4 and 5 read 0 in that case rather than dereferencing.
  // ============================================================================

  pub let blob_sig_audit : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (verdict: u64, vendor_verdict: u64, paideia_verdict: u64,
        vendor_role: u64, manifest_ptr: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R29.M4-004 (#1035) + R51 Phase C (SUBSYS_DRIVER shard, design/kernel/boot-transcript.md §7): append the structured record, emit ONE English narrative header (verdict-agnostic `driver blob signature audit recorded`), then emit the level-classified fingerprint klog line. Five-push prologue (rbx, r12-r15): at entry rsp%16==8 and five pushes bring it to 0, which SysV requires before each of the three leaf-ish nested calls (blob_failed_gate, kread_tsc, blob_audit_level). rbx=verdict, r12=vendor_verdict, r13=paideia_verdict, r14=vendor_role, r15=manifest_ptr — all five must survive those calls. Gate id and timestamp are parked in module scalars rather than a sixth callee-save register, which also gives `safectl` a cheap read of the last outcome. Ring slot: idx = seq & 15, base = ring + (idx << 6); eight qword stores; manifest_ptr==0 substitutes zeros for the two manifest-derived fields instead of dereferencing (that is the ordinary shape of a BLOB_ERR_BAD_MANIFEST_PTR rejection, which still deserves a record). R51 narrative: emitted right after the level is computed (rax = 1|2|3 from blob_audit_level) and BEFORE the verdict-selected fingerprint dispatch.  Two-line strategy (§5.1 option A) rather than a bracketed suffix on any of the three verdict tags because `BLOB SIG OK` is allowlisted in tools/verify-fingerprint-coverage.sh with rationale `emitted only for verdict==0; no boot fixture is validly signed under R25.M5 dev-bypass keyring; needs R32`, and the allowlist matches by exact string — rewriting the tag body would break the allowlist entry, and touching verify-scripts is out of scope for this shard.  Keeping the three verdict tags byte-identical preserves both the allowlist entry and the OK-token coverage relationship for `BLOB SIG OK` unchanged.  Register discipline for the narrative call: at the blob_sig_audit_counted label rsp%16==0 and rax holds the level.  Idiom is `push rax` (rsp%16 -> 8, saves level) + `sub rsp, 8` (rsp%16 -> 0, SysV pre-call), then klog_s1(rax, SUBSYS_DRV_, tag_blob_sig_narrative), then `add rsp, 8` + `pop rax` restores both alignment and the level for the fingerprint dispatch that follows.  klog_s1 preserves rbx/r12-r15 (SysV callee-save) so all five audit registers survive the extra call.  Narrative fires at the same level as the fingerprint so runtime level filtering does not silently drop the narrative while keeping the classified fingerprint (or vice versa).  klog_s1_x2 takes its seventh argument on the caller stack, so the emit sequence is `sub rsp,8` (rsp%16 -> 8) then one push (-> 0) then the call then `add rsp,16`, keeping the wrapper's [rbp+16] contract exact. rdtsc's rax/rdx clobber is absorbed by kread_tsc itself. Writes only this module's storage. Labels prefixed blob_sig_audit_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                            // 5 pushes -> rsp%16 = 0

        mov rbx, rdi;                        // verdict
        mov r12, rsi;                        // vendor gate verdict
        mov r13, rdx;                        // paideia gate verdict
        mov r14, rcx;                        // vendor role
        mov r15, r8;                         // manifest_ptr

        // ---- Which gate does this verdict implicate? ----
        mov rdi, rbx;
        call blob_failed_gate;
        lea r10, [rip + _blob_audit_last_gate];
        mov [r10 + 0], rax;

        // ---- When ----
        call kread_tsc;
        lea r10, [rip + _blob_audit_last_ts];
        mov [r10 + 0], rax;

        // ---- Slot: base = ring + ((seq & 15) << 6) ----
        lea r10, [rip + _blob_audit_seq];
        mov r11, [r10 + 0];
        and r11, 15;                         // BLOB_AUDIT_RING_MASK
        shl r11, 6;                          // * BLOB_AUDIT_RECORD_BYTES
        lea r10, [rip + _blob_audit_ring];
        add r10, r11;                        // r10 = record base

        // field 0: timestamp
        lea r11, [rip + _blob_audit_last_ts];
        mov rax, [r11 + 0];
        mov [r10 + 0], rax;

        // field 1: combined verdict
        mov [r10 + 8], rbx;

        // field 2: gate
        lea r11, [rip + _blob_audit_last_gate];
        mov rax, [r11 + 0];
        mov [r10 + 16], rax;

        // field 3: vendor role
        mov [r10 + 24], r14;

        // fields 4 and 5: blob identity, from the manifest if there is one
        xor rax, rax;
        xor r11, r11;
        cmp r15, 0;
        je  blob_sig_audit_no_manifest;
        mov rax, [r15 + 48];                 // BLOB_OFF_BLOB_LEN
        mov r11, [r15 + 80];                 // BLOB_OFF_BLOB_HASH, first 8 B

      blob_sig_audit_no_manifest:
        mov [r10 + 32], rax;                 // field 4: blob_len
        mov [r10 + 40], r11;                 // field 5: hash prefix

        // fields 6 and 7: the raw per-gate verdicts
        mov [r10 + 48], r12;
        mov [r10 + 56], r13;

        // ---- Advance the monotonic counter ----
        lea r11, [rip + _blob_audit_seq];
        mov rax, [r11 + 0];
        add rax, 1;
        mov [r11 + 0], rax;

        // ---- Level, per-level counter, and the klog line ----
        mov rdi, rbx;
        call blob_audit_level;               // rax = 1, 2 or 3

        cmp rax, 1;
        jne blob_sig_audit_not_error;
        lea r11, [rip + _blob_audit_error];
        mov r10, [r11 + 0];
        add r10, 1;
        mov [r11 + 0], r10;
        jmp blob_sig_audit_counted;

      blob_sig_audit_not_error:
        cmp rax, 2;
        jne blob_sig_audit_not_warn;
        lea r11, [rip + _blob_audit_warn];
        mov r10, [r11 + 0];
        add r10, 1;
        mov [r11 + 0], r10;
        jmp blob_sig_audit_counted;

      blob_sig_audit_not_warn:
        lea r11, [rip + _blob_audit_info];
        mov r10, [r11 + 0];
        add r10, 1;
        mov [r11 + 0], r10;

      blob_sig_audit_counted:
        // R51 Phase C (SUBSYS_DRIVER shard, boot-transcript.md §7):
        // Emit ONE verdict-agnostic English narrative before the
        // classified BLOB SIG {OK,UNSIGNED,REJECT} fingerprint.  Level
        // matches the classified fingerprint (runtime level filtering
        // must not drop one without the other).  Two-line strategy
        // (§5.1 option A) rather than a bracketed suffix on the
        // verdict tags because `BLOB SIG OK` is allowlisted in
        // tools/verify-fingerprint-coverage.sh by exact string —
        // rewriting the tag body would break the allowlist entry, and
        // touching verify-scripts is out of scope for this shard.
        //
        // Register discipline: at this label rsp%16==0 (post-prologue,
        // all prior calls balanced) and rax = level (1|2|3 from
        // blob_audit_level).  `push rax` saves the level and shifts
        // rsp%16 to 8; `sub rsp, 8` re-aligns to 0 for the SysV call;
        // `add rsp, 8` and `pop rax` restore both alignment and level
        // for the verdict dispatch that follows.  klog_s1 preserves
        // rbx/r12-r15 (SysV callee-save) so all five audit registers
        // survive.
        push rax;                            // save level, rsp%16 -> 8
        sub rsp, 8;                          // align for call, rsp%16 -> 0
        mov rdi, rax;                        // level
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + tag_blob_sig_narrative];
        call klog_s1;
        add rsp, 8;                          // undo align, rsp%16 -> 8
        pop rax;                             // restore level, rsp%16 -> 0

        // rax still holds the level. Select the tag from the verdict so
        // an operator can grep the audit log for REJECT alone.
        mov rdi, rax;                        // level
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + tag_blob_sig_reject];
        cmp rbx, 1;
        jne blob_sig_audit_tag_done;
        lea rdx, [rip + tag_blob_sig_unsigned];

      blob_sig_audit_tag_done:
        cmp rbx, 0;
        jne blob_sig_audit_tag_final;
        lea rdx, [rip + tag_blob_sig_ok];

      blob_sig_audit_tag_final:
        lea rcx, [rip + k_verdict];
        mov r8,  rbx;                        // verdict value
        lea r9,  [rip + k_gate];

        sub rsp, 8;                          // rsp%16 -> 8
        lea r11, [rip + _blob_audit_last_gate];
        mov r11, [r11 + 0];
        push r11;                            // 7th arg; rsp%16 -> 0
        call klog_s1_x2;
        add rsp, 16;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
