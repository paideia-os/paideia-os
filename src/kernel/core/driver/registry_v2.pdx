// src/kernel/core/driver/registry_v2.pdx — R29.M3-001 (#1028)
//
// Driver registry v2 — versioned record schema + in-memory image
// encode/decode/seal/validate primitives.
//
// Full rationale, layout diagram, versioning + migration rules and
// signature discipline: design/drivers/registry-v2.md.
//
// Short form
// ----------
// `_driver_table` (driver_table.pdx) is *runtime* state — 32 rows,
// rebuilt from nothing every boot. Registry v2 is the *durable*
// artifact: for each installed driver, its name, semantic version, the
// KIND_HW-family capability manifest it is entitled to, and the effect
// row the elaborator proved for it (the row the cap-vs-effect walker
// C1301 enforces at compile time). A record is a projection of a live
// driver_table row plus the two fields the table does not carry
// (version + manifest bitmaps).
//
// The issue title says "cap'n proto persisted". Paideia has no Cap'n
// Proto elaborator support and will not grow one for a kernel-resident
// format; what is borrowed is the property Cap'n Proto is wanted for —
// a field-order-stable, offset-addressable encoding with no parse step.
// Every field below sits at a frozen byte offset; decoding is a load.
//
// Image layout (design/drivers/registry-v2.md §2)
// -----------------------------------------------
//   HEADER  32 B
//     [+0]  u32 magic          'P''D''X''R'  = 0x52584450 (LE)
//     [+4]  u16 schema_version = 2
//     [+6]  u16 header_bytes   = 32
//     [+8]  u32 record_bytes   = 96
//     [+12] u32 record_count   = N
//     [+16] u64 flags          = 0 (reserved)
//     [+24] u64 content_checksum over records[0..N)
//   RECORD  96 B each, N of them, starting at +32
//     [+0]  u64 header: [7:0] driver_table_slot, [15:8] lifecycle_state,
//                       [23:16] record_flags (bit0 = valid),
//                       [31:24] reserved, [63:32] pid
//     [+8]  u64 name[0..7]     — byte-identical to driver_table [+16]
//     [+16] u64 name[8..15]    — byte-identical to driver_table [+24]
//     [+24] u64 driver_version: [15:0] patch [31:16] minor [47:32] major
//     [+32] u64 cap_manifest_lo   (KIND_HW-family entitlement bitmap)
//     [+40] u64 cap_manifest_hi   (reserved; kinds >= 64)
//     [+48] u64 effect_row        (elaborator-proved effect bitmap)
//     [+56] u64 caps_manifest_offset (mirrors driver_table [+8])
//     [+64] u64 reserved
//     [+72] u64 reserved
//     [+80] u64 reserved
//     [+88] u64 record_checksum over record[0..88)
//   SIGNATURE BLOCK  3325 B, at +32+96N
//     [+0]  u32 sig_magic 'P''D''S''G' = 0x47534450 (LE)
//     [+4]  u16 sig_alg = 1 (ML-DSA-65)
//     [+6]  u16 reserved = 0
//     [+8]  u64 sig_bytes = 3309
//     [+16] u8[3309] signature — ALL ZERO at R28..R31 (scaffold)
//
// Total image bytes = 32 + 96*N + 3325 = 96*N + 3357.
//
// Why the header packs the way it does: a single qword load at [+0]
// yields magic | schema_version | header_bytes, and a single load at
// [+8] yields record_bytes | record_count. A reader that knows nothing
// else about the file can branch on the version after two loads, and
// header_bytes + record_bytes let a v3 reader stride v2 records without
// a compiled-in constant. That triple is the whole forward-compat
// contract (design/drivers/registry-v2.md §3).
//
// Signature: all-zero body at R28..R31 — same staging as the EFI image
// signing scaffold (tools/sign-efi.sh). The layout, length and algorithm
// tag are frozen now so that enabling real ML-DSA-65 signing later
// changes one function and zero offsets. An all-zero signature is never
// "valid" — it is "unsigned, scaffold epoch", and the validator asserts
// it is exactly zero so a partially-written signature is caught.
//
// Concurrency: R29.M3 is single-flow pre-scheduler-bringup. The image
// buffer has no lock; the supervisor is the only writer. SMP-safety
// revisits with the R29.M7 chaos-restart harness.

module RegistryV2 = structure {

  // ============================================================================
  // Geometry
  // ============================================================================

  pub let REGISTRY_V2_MAGIC            : u64 = 0x52584450   // 'P','D','X','R' LE
  pub let REGISTRY_V2_SCHEMA_VERSION   : u64 = 2
  pub let REGISTRY_V2_HEADER_BYTES     : u64 = 32
  pub let REGISTRY_V2_RECORD_BYTES     : u64 = 96
  pub let REGISTRY_V2_MAX_RECORDS      : u64 = 32           // == DRIVER_TABLE_SLOTS

  pub let REGISTRY_V2_SIG_MAGIC        : u64 = 0x47534450   // 'P','D','S','G' LE
  pub let REGISTRY_V2_SIG_ALG_ML_DSA_65: u64 = 1
  pub let REGISTRY_V2_SIG_BODY_BYTES   : u64 = 3309         // ML-DSA-65 sig length
  pub let REGISTRY_V2_SIG_HDR_BYTES    : u64 = 16
  pub let REGISTRY_V2_SIG_BLOCK_BYTES  : u64 = 3325         // 16 + 3309

  // Image bytes for the maximum record count:
  //   32 + 32*96 + 3325 = 6429 -> rounded to 6432 (804 u64s).
  pub let REGISTRY_V2_IMAGE_MAX_BYTES  : u64 = 6432

  // ============================================================================
  // Header field byte offsets (from image base)
  // ============================================================================

  pub let REGISTRY_V2_OFF_MAGIC        : u64 = 0
  pub let REGISTRY_V2_OFF_SCHEMA_VER   : u64 = 4
  pub let REGISTRY_V2_OFF_HEADER_BYTES : u64 = 6
  pub let REGISTRY_V2_OFF_RECORD_BYTES : u64 = 8
  pub let REGISTRY_V2_OFF_RECORD_COUNT : u64 = 12
  pub let REGISTRY_V2_OFF_FLAGS        : u64 = 16
  pub let REGISTRY_V2_OFF_CONTENT_SUM  : u64 = 24

  // ============================================================================
  // Record field byte offsets (from record base)
  // ============================================================================

  pub let REGISTRY_V2_REC_OFF_HEADER      : u64 = 0
  pub let REGISTRY_V2_REC_OFF_NAME_LO     : u64 = 8
  pub let REGISTRY_V2_REC_OFF_NAME_HI     : u64 = 16
  pub let REGISTRY_V2_REC_OFF_VERSION     : u64 = 24
  pub let REGISTRY_V2_REC_OFF_CAP_LO      : u64 = 32
  pub let REGISTRY_V2_REC_OFF_CAP_HI      : u64 = 40
  pub let REGISTRY_V2_REC_OFF_EFFECT_ROW  : u64 = 48
  pub let REGISTRY_V2_REC_OFF_CAPS_OFFSET : u64 = 56
  pub let REGISTRY_V2_REC_OFF_CHECKSUM    : u64 = 88
  pub let REGISTRY_V2_REC_SUM_SPAN        : u64 = 88   // bytes covered by checksum

  // ============================================================================
  // Signature-block field byte offsets (from sig-block base)
  // ============================================================================

  pub let REGISTRY_V2_SIG_OFF_MAGIC : u64 = 0
  pub let REGISTRY_V2_SIG_OFF_ALG   : u64 = 4
  pub let REGISTRY_V2_SIG_OFF_RSVD  : u64 = 6
  pub let REGISTRY_V2_SIG_OFF_LEN   : u64 = 8
  pub let REGISTRY_V2_SIG_OFF_BODY  : u64 = 16

  // ============================================================================
  // Return codes.
  //
  // 0xFFFFFD0x space — disjoint from lifecycle.pdx (0xFFFFFF0x) and
  // driver_table.pdx (0xFFFFFEx x) so a mixed-caller error trace names
  // the failing layer without ambiguity. Every fsck stage has its own
  // code so a boot-log triage identifies the failure without a debugger.
  // ============================================================================

  pub let REGISTRY_V2_OK                  : u64 = 0
  pub let REGISTRY_V2_ERR_BAD_INDEX       : u64 = 0xFFFFFD01
  pub let REGISTRY_V2_ERR_BAD_SLOT        : u64 = 0xFFFFFD02
  pub let REGISTRY_V2_ERR_TOO_MANY        : u64 = 0xFFFFFD03
  pub let REGISTRY_V2_ERR_BAD_MAGIC       : u64 = 0xFFFFFD04
  pub let REGISTRY_V2_ERR_BAD_VERSION     : u64 = 0xFFFFFD05
  pub let REGISTRY_V2_ERR_BAD_GEOMETRY    : u64 = 0xFFFFFD06
  pub let REGISTRY_V2_ERR_REC_CHECKSUM    : u64 = 0xFFFFFD07
  pub let REGISTRY_V2_ERR_CONTENT_SUM     : u64 = 0xFFFFFD08
  pub let REGISTRY_V2_ERR_SIG_MAGIC       : u64 = 0xFFFFFD09
  pub let REGISTRY_V2_ERR_SIG_ALG         : u64 = 0xFFFFFD0A
  pub let REGISTRY_V2_ERR_SIG_LEN         : u64 = 0xFFFFFD0B
  pub let REGISTRY_V2_ERR_SIG_NOT_ZERO    : u64 = 0xFFFFFD0C
  pub let REGISTRY_V2_ERR_SLOT_FREE       : u64 = 0xFFFFFD0D

  // ============================================================================
  // Backing storage — the live in-memory image. 6432 B = 804 u64s,
  // @align(64) so the header, every 96 B record and the signature block
  // each start on an 8 B boundary (96 and 32 are both 8-multiples).
  // ============================================================================

  pub let mut _registry_v2_buf : [u64; 804] = uninit @align(64)

  // ============================================================================
  // registry_v2_buf_addr() -> u64
  //
  // SysV: -> rax = kernel VA of the live image buffer.
  // ============================================================================

  pub let registry_v2_buf_addr : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M3-001 (#1028): return the kernel VA of the live registry image buffer via rip-relative lea. Pure address computation; no memory access. Leaf; no callee-save writes.",
      block: {
        lea rax, [rip + _registry_v2_buf];
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_total_bytes(count) -> u64
  //
  // SysV: rdi = record_count -> rax = 96*count + 3357
  //       (= HEADER 32 + records + SIG_BLOCK 3325).
  //
  // No bounds check — callers gate count first; the arithmetic is total
  // for any count and the gate belongs where the count originates.
  // ============================================================================

  pub let registry_v2_total_bytes : (u64) -> u64 !{} @{} =
    fn (count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M3-001 (#1028): image size for a record count. Multiply-by-96 via count*64 + count*32 (shl 6 + shl 5 + add) — no imul, matching driver_table.pdx's multiply-by-48 discipline. Add the constant 3357 (header 32 + signature block 3325). Pure computation. Leaf; no callee-save writes.",
      block: {
        mov r8, rdi;
        shl r8, 6;                          // count * 64
        mov r9, rdi;
        shl r9, 5;                          // count * 32
        add r8, r9;                         // count * 96
        mov r9, 3357;                       // 32 + 3325
        add r8, r9;
        mov rax, r8;
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_record_addr(image_ptr, index) -> u64
  //
  // SysV: rdi = image base VA, rsi = record index -> rax = image + 32 + index*96.
  //
  // Takes the image base as an argument (rather than assuming the live
  // buffer) so the identical decoder runs over a read-back scratch image
  // — the round-trip witness and the fsck path both need that.
  // ============================================================================

  pub let registry_v2_record_addr : (u64, u64) -> u64 !{} @{} =
    fn (image_ptr: u64, index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M3-001 (#1028): record address within an arbitrary image. index*96 via shl 6 + shl 5 + add (no imul), plus the 32 B header, plus the caller-supplied image base. Image-relative rather than buffer-relative so the same decoder serves the live image and a read-back scratch image. No bounds check — callers gate index. Pure computation. Leaf; no callee-save writes.",
      block: {
        mov r8, rsi;
        shl r8, 6;
        mov r9, rsi;
        shl r9, 5;
        add r8, r9;                         // index * 96
        add r8, rdi;                        // + image base
        mov r9, 32;
        add r8, r9;                         // + header bytes
        mov rax, r8;
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_sig_addr(image_ptr, count) -> u64
  //
  // SysV: rdi = image base VA, rsi = record_count
  //       -> rax = image + 32 + count*96 (base of the signature block).
  // ============================================================================

  pub let registry_v2_sig_addr : (u64, u64) -> u64 !{} @{} =
    fn (image_ptr: u64, count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M3-001 (#1028): signature-block base = image + 32 + count*96, i.e. exactly one record past the last record. Same shl 6 / shl 5 multiply-by-96. Pure computation. Leaf; no callee-save writes.",
      block: {
        mov r8, rsi;
        shl r8, 6;
        mov r9, rsi;
        shl r9, 5;
        add r8, r9;                         // count * 96
        add r8, rdi;
        mov r9, 32;
        add r8, r9;
        mov rax, r8;
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_checksum(ptr, len) -> u64
  //
  // SysV: rdi = byte pointer (8-aligned), rsi = byte length (multiple of 8)
  //       -> rax = 64-bit integrity digest.
  //
  // Not a cryptographic hash and not claimed to be one — the signature
  // block carries the cryptographic guarantee. This is the corruption
  // detector the fsck helper needs: it must catch a torn write, a
  // dropped chunk, or a single flipped bit, and it must be cheap enough
  // to run over the whole image on every load.
  //
  // Per-qword mix (xorshift-multiply-free; shl/shr/xor/add only, so no
  // imul dependency and identical cost on every microarchitecture):
  //
  //   acc ^= q
  //   acc += acc << 13
  //   acc ^= acc >> 7
  //   acc += acc << 17
  //
  // Seed 0x243F6A8885A308D3 (the first 64 bits of pi's fraction — the
  // conventional nothing-up-my-sleeve constant) so that an all-zero
  // buffer does not digest to zero, which would make "checksum absent"
  // and "checksum of a zeroed region" indistinguishable.
  //
  // len == 0 returns the bare seed (the digest of the empty span).
  // A non-multiple-of-8 len is truncated down to the last whole qword —
  // every span this file digests (88, and 96*N) is a multiple of 8 by
  // construction.
  // ============================================================================

  pub let registry_v2_checksum : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64, len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M3-001 (#1028): 64-bit integrity digest over an 8-aligned span. Loop loads one qword per iteration and applies a 4-step xorshift mix using only shl/shr/xor/add — no imul, so the digest is byte-identical across encoders and cheap in a boot path. Seeded with the pi-fraction constant so an all-zero span does not digest to zero. Read-only over the span; writes no memory. Registers: rax = accumulator, rcx = cursor, rdx = remaining bytes, r8/r9 = mix temporaries. All caller-saved — leaf function, no callee-save writes, no nested calls, no frame.",
      block: {
        mov rax, 0x243F6A8885A308D3;        // acc = seed
        mov rcx, rdi;                       // cursor
        mov rdx, rsi;                       // remaining bytes

      registry_v2_checksum_loop:
        cmp rdx, 8;
        jb  registry_v2_checksum_done;

        mov r8, [rcx + 0];
        xor rax, r8;                        // acc ^= q

        mov r8, rax;
        shl r8, 13;
        add rax, r8;                        // acc += acc << 13

        mov r8, rax;
        shr r8, 7;
        xor rax, r8;                        // acc ^= acc >> 7

        mov r8, rax;
        shl r8, 17;
        add rax, r8;                        // acc += acc << 17

        add rcx, 8;
        sub rdx, 8;
        jmp registry_v2_checksum_loop;

      registry_v2_checksum_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_header_init(count) -> u64
  //
  // SysV: rdi = record_count -> rax = REGISTRY_V2_OK / ERR_TOO_MANY.
  //
  // Writes the 32 B header of the live image: magic, schema_version,
  // header_bytes, record_bytes, record_count, flags = 0, and a zeroed
  // content_checksum (filled by registry_v2_seal once the records exist).
  //
  // Sized stores: mov_d for the two u32 fields, mov_w for the two u16
  // fields. A bare `mov [mem], reg` would widen to REX.W and clobber the
  // neighbouring field — the same sized-store discipline the IOAPIC and
  // fd_inherit paths follow.
  // ============================================================================

  pub let registry_v2_header_init : (u64) -> u64 !{mem} @{} =
    fn (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M3-001 (#1028): populate the live image's 32 B header. Bound-check count against REGISTRY_V2_MAX_RECORDS first so a rejected call leaves the buffer untouched (same preserve-on-failure ordering as tmpfs_create/tmpfs_write). Then rip-relative lea of the buffer and six sized stores: mov_d magic at +0, mov_w schema_version at +4, mov_w header_bytes at +6, mov_d record_bytes at +8, mov_d record_count at +12, full-width zero at +16 (flags) and +24 (content_checksum placeholder). Sized stores are mandatory here — a REX.W `mov` at +4 would overwrite record_bytes at +8. Leaf; no callee-save writes; no nested calls.",
      block: {
        cmp rdi, 32;                        // REGISTRY_V2_MAX_RECORDS
        ja  registry_v2_header_init_too_many;

        lea r10, [rip + _registry_v2_buf];

        mov r8, 0x52584450;                 // 'P','D','X','R'
        mov_d [r10 + 0], r8;

        mov r8, 2;                          // schema_version
        mov_w [r10 + 4], r8;

        mov r8, 32;                         // header_bytes
        mov_w [r10 + 6], r8;

        mov r8, 96;                         // record_bytes
        mov_d [r10 + 8], r8;

        mov_d [r10 + 12], rdi;              // record_count

        xor r8, r8;
        mov [r10 + 16], r8;                 // flags = 0
        mov [r10 + 24], r8;                 // content_checksum = 0 (sealed later)

        xor rax, rax;                       // REGISTRY_V2_OK
        ret;

      registry_v2_header_init_too_many:
        mov rax, 0xFFFFFD03;                // REGISTRY_V2_ERR_TOO_MANY
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_record_encode(index, slot, version, cap_lo, effect_row) -> u64
  //
  // SysV: rdi = record index (0..31)
  //       rsi = driver_table slot to project (0..31, must be in_use)
  //       rdx = driver_version (packed [15:0] patch [31:16] minor [47:32] major)
  //       rcx = cap_manifest_lo (KIND_HW-family entitlement bitmap)
  //       r8  = effect_row (elaborator-proved effect bitmap)
  //       -> rax = REGISTRY_V2_OK / ERR_BAD_INDEX / ERR_BAD_SLOT / ERR_SLOT_FREE
  //
  // Projects the live driver_table row into record `index`: slot,
  // lifecycle state and pid from the row header, name from the row's two
  // name qwords, caps_manifest_offset from row [+8]. The three caller-
  // supplied fields (version, cap manifest, effect row) are the ones the
  // table does not carry. cap_manifest_hi and the three reserved qwords
  // are written zero — the migration contract in
  // design/drivers/registry-v2.md §3 requires reserved bytes be zero so
  // that a future additive field's "unset" value is well-defined.
  //
  // The record checksum is computed last, over bytes [0..88), and stored
  // at [+88]; the digest deliberately excludes its own slot so verifying
  // never has to mutate the image being verified.
  // ============================================================================

  pub let registry_v2_record_encode : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (index: u64, slot: u64, version: u64, cap_lo: u64, effect_row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M3-001 (#1028): encode one registry record as a projection of driver_table row `slot`. Five-push prologue (rbx, r12, r13, r14, r15) ensures rsp%16==0 at the three nested call sites (driver_table_slot_in_use, driver_table_row_addr, registry_v2_checksum) per SysV AMD64, and preserves all five arguments across them. Gate order is index -> slot -> in_use, all before any store, so a rejected call leaves the image byte-identical (same preserve-on-failure ordering as driver_table_register). Record header packs pid<<32 | valid<<16 | state<<8 | slot: pid extracted by shr 32 then re-placed by shl 32, state by masking the row header's low byte, slot masked to 8 bits. r13 is repurposed from `version` to the record address after the version store — version is single-use, mirroring tmpfs_create's r15 type->new_ptr morph. Checksum spans [0..88) and is stored at +88, so the digest never covers itself and verification is read-only.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                           // rsp%16 = 0

        mov rbx, rdi;                       // index
        mov r12, rsi;                       // slot
        mov r13, rdx;                       // version (morphs to rec_addr later)
        mov r14, rcx;                       // cap_manifest_lo
        mov r15, r8;                        // effect_row

        // ---- Gates (all before any store) ----
        cmp rbx, 32;                        // REGISTRY_V2_MAX_RECORDS
        jae registry_v2_encode_bad_index;
        cmp r12, 32;                        // DRIVER_TABLE_SLOTS
        jae registry_v2_encode_bad_slot;

        mov rdi, r12;
        call driver_table_slot_in_use;
        cmp rax, 1;
        jne registry_v2_encode_slot_free;

        // ---- Source row ----
        mov rdi, r12;
        call driver_table_row_addr;         // rax = &_driver_table[slot]

        // ---- Destination record address: buf + 32 + index*96 ----
        mov r10, rbx;
        shl r10, 6;
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;                       // index * 96
        lea r11, [rip + _registry_v2_buf];
        add r10, r11;
        mov r11, 32;
        add r10, r11;                       // r10 = &record[index]

        // ---- [+0] header: pid<<32 | valid<<16 | state<<8 | slot ----
        mov rcx, [rax + 0];                 // driver_table row header
        mov rdx, rcx;
        shr rdx, 32;                        // pid in low 32
        shl rdx, 32;                        // pid back to [63:32]

        mov r8, rcx;
        mov r9, 0xFF;
        and r8, r9;                         // state byte
        shl r8, 8;
        or  rdx, r8;

        mov r8, 0x10000;                    // record_flags bit0 = valid
        or  rdx, r8;

        mov r8, r12;
        mov r9, 0xFF;
        and r8, r9;                         // slot & 0xFF
        or  rdx, r8;

        mov [r10 + 0], rdx;

        // ---- [+8]/[+16] name (byte-identical to the row's name field) ----
        mov rcx, [rax + 16];
        mov [r10 + 8], rcx;
        mov rcx, [rax + 24];
        mov [r10 + 16], rcx;

        // ---- [+24] version, [+32]/[+40] cap manifest, [+48] effect row ----
        mov [r10 + 24], r13;
        mov [r10 + 32], r14;
        xor rcx, rcx;
        mov [r10 + 40], rcx;                // cap_manifest_hi = 0 (reserved)
        mov [r10 + 48], r15;

        // ---- [+56] caps_manifest_offset (mirrors driver_table [+8]) ----
        mov rcx, [rax + 8];
        mov [r10 + 56], rcx;

        // ---- [+64]/[+72]/[+80] reserved = 0, [+88] checksum placeholder ----
        xor rcx, rcx;
        mov [r10 + 64], rcx;
        mov [r10 + 72], rcx;
        mov [r10 + 80], rcx;
        mov [r10 + 88], rcx;

        // ---- [+88] record checksum over [0..88) ----
        mov r13, r10;                       // stash rec_addr (version consumed)
        mov rdi, r10;
        mov rsi, 88;                        // REGISTRY_V2_REC_SUM_SPAN
        call registry_v2_checksum;
        mov [r13 + 88], rax;

        xor rax, rax;                       // REGISTRY_V2_OK
        jmp registry_v2_encode_ret;

      registry_v2_encode_bad_index:
        mov rax, 0xFFFFFD01;
        jmp registry_v2_encode_ret;

      registry_v2_encode_bad_slot:
        mov rax, 0xFFFFFD02;
        jmp registry_v2_encode_ret;

      registry_v2_encode_slot_free:
        mov rax, 0xFFFFFD0D;

      registry_v2_encode_ret:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_seal(count) -> u64
  //
  // SysV: rdi = record_count -> rax = REGISTRY_V2_OK / ERR_TOO_MANY.
  //
  // Closes the live image: computes the content checksum over
  // records[0..count) and stores it in the header, then lays down the
  // signature block immediately after the last record — magic, algorithm
  // tag, declared length, and an all-zero 3309 B body.
  //
  // Must be called after every record is encoded and before persisting;
  // encoding a record after sealing invalidates the content checksum.
  // ============================================================================

  pub let registry_v2_seal : (u64) -> u64 !{mem} @{} =
    fn (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M3-001 (#1028): seal the live image. Three-push prologue (rbx, r12, r13) ensures rsp%16==0 at the nested registry_v2_checksum call and preserves count + the two derived addresses across it. Bound-check count first (preserve-on-failure). Content checksum spans records[0..count) = count*96 bytes starting at buf+32, and is stored at header +24 — it deliberately excludes the header itself, because the header contains the checksum slot and a self-covering digest would need a two-pass write. Signature block base = buf + 32 + count*96 (one record past the last). Sized stores for the u32 magic (mov_d) and u16 alg/reserved (mov_w) so neighbouring fields survive; full-width store for the u64 declared length. Body zero-fill is a 3309-iteration byte loop using the `mov_b [dst], al` idiom (proven in klog/audit.pdx; avoids paideia-as#1270) — the buffer is `uninit`, so relying on .bss zero-init would be wrong on any re-seal.",
      block: {
        push rbx;
        push r12;
        push r13;                           // rsp%16 = 0

        cmp rdi, 32;                        // REGISTRY_V2_MAX_RECORDS
        ja  registry_v2_seal_too_many;

        mov rbx, rdi;                       // count

        // ---- Content checksum over records[0..count) ----
        mov r12, rbx;
        shl r12, 6;
        mov r13, rbx;
        shl r13, 5;
        add r12, r13;                       // count * 96 = record span bytes

        lea r13, [rip + _registry_v2_buf];  // r13 = image base

        mov rdi, r13;
        mov rsi, 32;
        add rdi, rsi;                       // &records[0]
        mov rsi, r12;                       // span bytes
        call registry_v2_checksum;

        lea r13, [rip + _registry_v2_buf];
        mov [r13 + 24], rax;                // header content_checksum

        // ---- Signature block base = buf + 32 + count*96 ----
        mov r12, rbx;
        shl r12, 6;
        mov rcx, rbx;
        shl rcx, 5;
        add r12, rcx;                       // count * 96
        add r12, r13;
        mov rcx, 32;
        add r12, rcx;                       // r12 = &sig_block

        mov r8, 0x47534450;                 // 'P','D','S','G'
        mov_d [r12 + 0], r8;
        mov r8, 1;                          // sig_alg = ML-DSA-65
        mov_w [r12 + 4], r8;
        xor r8, r8;
        mov_w [r12 + 6], r8;                // reserved = 0
        mov r8, 3309;                       // declared signature length
        mov [r12 + 8], r8;

        // ---- All-zero signature body (R28..R31 scaffold epoch) ----
        mov rcx, r12;
        mov r9, 16;
        add rcx, r9;                        // &sig_body
        mov r9, 3309;                       // REGISTRY_V2_SIG_BODY_BYTES
        xor rax, rax;

      registry_v2_seal_zero_loop:
        cmp r9, 0;
        je  registry_v2_seal_ok;
        mov_b [rcx + 0], al;
        inc rcx;
        dec r9;
        jmp registry_v2_seal_zero_loop;

      registry_v2_seal_ok:
        xor rax, rax;                       // REGISTRY_V2_OK
        jmp registry_v2_seal_ret;

      registry_v2_seal_too_many:
        mov rax, 0xFFFFFD03;

      registry_v2_seal_ret:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_image_count(image_ptr) -> u64
  //
  // SysV: rdi = image base VA -> rax = record_count field (u32, zero-extended).
  //
  // Decoder entry point: the count must be readable before the image is
  // known to be well-formed, because the count is what tells a reader how
  // many bytes to read back and where the signature block starts.
  // Unvalidated — callers pass the result through registry_v2_validate.
  // ============================================================================

  pub let registry_v2_image_count : (u64) -> u64 !{mem} @{} =
    fn (image_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M3-001 (#1028): extract record_count from an arbitrary image. One qword load at +8 yields record_bytes (low 32) | record_count (high 32); shr 32 isolates the count and zero-extends. Read-only. Leaf; no callee-save writes.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_field(image_ptr, index, field_off) -> u64
  //
  // SysV: rdi = image base VA, rsi = record index, rdx = field byte offset
  //       -> rax = the u64 at &record[index] + field_off.
  //
  // The generic decoder. Every record field is a full u64 at a frozen
  // offset (REGISTRY_V2_REC_OFF_*), so one accessor serves all of them —
  // eight one-line wrappers would carry no additional type safety in an
  // assembly-level ABI and would triple the surface to keep in sync with
  // the layout. Sub-fields of the packed header (slot / state / pid) are
  // extracted by the caller with the shifts documented in the layout.
  //
  // No bounds check on index or field_off — this is the inner decoder;
  // callers gate index against the validated record_count.
  // ============================================================================

  pub let registry_v2_field : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (image_ptr: u64, index: u64, field_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M3-001 (#1028): load one u64 record field from an arbitrary image. Address = image + 32 + index*96 + field_off, with index*96 via shl 6 + shl 5 + add (no imul). Read-only single load. Leaf; no callee-save writes; no nested calls.",
      block: {
        mov r8, rsi;
        shl r8, 6;
        mov r9, rsi;
        shl r9, 5;
        add r8, r9;                         // index * 96
        add r8, rdi;                        // + image base
        mov r9, 32;
        add r8, r9;                         // + header
        add r8, rdx;                        // + field offset
        mov rax, [r8 + 0];
        ret
      }
    } @no_frame

  // ============================================================================
  // registry_v2_validate(image_ptr) -> u64
  //
  // The fsck helper (design/drivers/registry-v2.md §4). SysV: rdi = image
  // base VA -> rax = REGISTRY_V2_OK, or the code of the first failing
  // stage. Runs entirely read-only over the image, so it is safe against
  // the live buffer, a read-back scratch image, or a mapped file.
  //
  // Stages, in order:
  //   1. magic          == 'PDXR'                  -> ERR_BAD_MAGIC
  //   2. schema_version == 2                       -> ERR_BAD_VERSION
  //      (a version ABOVE 2 is rejected too: silently ignoring a
  //       newer file's unknown records would be a downgrade attack
  //       that strips entitlements — see design §3.)
  //   3. header_bytes == 32 AND record_bytes == 96
  //      AND record_count <= 32                    -> ERR_BAD_GEOMETRY
  //   4. every record's stored checksum matches
  //      registry_v2_checksum(rec, 88)             -> ERR_REC_CHECKSUM
  //   5. header content_checksum matches
  //      registry_v2_checksum(&rec[0], count*96)   -> ERR_CONTENT_SUM
  //   6. sig_magic == 'PDSG'                       -> ERR_SIG_MAGIC
  //   7. sig_alg == 1 (ML-DSA-65)                  -> ERR_SIG_ALG
  //   8. sig_bytes == 3309                         -> ERR_SIG_LEN
  //   9. signature body is all zero                -> ERR_SIG_NOT_ZERO
  //
  // Stage 9 is the scaffold-epoch assertion. It is NOT "the signature
  // verified" — it is "this file is honestly unsigned and not
  // half-written". When real ML-DSA-65 signing lands the stage flips
  // from assert-zero to assert-verify and any file still carrying zeros
  // fails. There is no configuration knob between those two states.
  // ============================================================================

  pub let registry_v2_validate : (u64) -> u64 !{mem} @{} =
    fn (image_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M3-001 (#1028): read-only fsck over an arbitrary registry image. Five-push prologue (rbx, r12, r13, r14, r15) ensures rsp%16==0 at the nested registry_v2_checksum calls and preserves image_ptr / count / loop index / record address across them. Header decode needs only two qword loads: [+0] gives magic (low 32) | schema_version (bits 47:32) | header_bytes (bits 63:48), [+8] gives record_bytes (low 32) | record_count (high 32) — masks and shifts isolate each. Stage order is cheapest-and-most-discriminating first (magic, version, geometry) so a wholly foreign buffer is rejected before any checksum work. Per-record checksums precede the content checksum so a single corrupt record is attributed to its index rather than to the image as a whole. Signature stages last: they cost a 3309-byte scan and are pointless on an image whose records already failed. Every stage returns a distinct 0xFFFFFD0x code. No stores anywhere — validation must never mutate the artifact it judges, which is why the record digest spans [0..88) and excludes its own slot.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                           // rsp%16 = 0

        mov rbx, rdi;                       // image base

        // ---- Stage 1: magic ----
        mov rax, [rbx + 0];
        mov r9, 0xFFFFFFFF;
        and rax, r9;
        mov r9, 0x52584450;                 // 'P','D','X','R'
        cmp rax, r9;
        jne registry_v2_validate_bad_magic;

        // ---- Stage 2: schema_version ----
        mov rax, [rbx + 0];
        shr rax, 32;
        mov r9, 0xFFFF;
        and rax, r9;
        cmp rax, 2;                         // REGISTRY_V2_SCHEMA_VERSION
        jne registry_v2_validate_bad_version;

        // ---- Stage 3: geometry ----
        mov rax, [rbx + 0];
        shr rax, 48;                        // header_bytes
        cmp rax, 32;
        jne registry_v2_validate_bad_geom;

        mov rax, [rbx + 8];
        mov r9, 0xFFFFFFFF;
        and rax, r9;                        // record_bytes
        cmp rax, 96;
        jne registry_v2_validate_bad_geom;

        mov r12, [rbx + 8];
        shr r12, 32;                        // r12 = record_count
        cmp r12, 32;                        // REGISTRY_V2_MAX_RECORDS
        ja  registry_v2_validate_bad_geom;

        // ---- Stage 4: per-record checksums ----
        xor r13, r13;                       // r13 = record index

      registry_v2_validate_rec_loop:
        cmp r13, r12;
        jae registry_v2_validate_content;

        mov r14, r13;
        shl r14, 6;
        mov r15, r13;
        shl r15, 5;
        add r14, r15;                       // index * 96
        add r14, rbx;
        mov r15, 32;
        add r14, r15;                       // r14 = &record[index]

        mov rdi, r14;
        mov rsi, 88;                        // REGISTRY_V2_REC_SUM_SPAN
        call registry_v2_checksum;

        mov r15, [r14 + 88];
        cmp rax, r15;
        jne registry_v2_validate_rec_sum;

        add r13, 1;
        jmp registry_v2_validate_rec_loop;

        // ---- Stage 5: content checksum ----
      registry_v2_validate_content:
        mov r14, r12;
        shl r14, 6;
        mov r15, r12;
        shl r15, 5;
        add r14, r15;                       // count * 96

        mov rdi, rbx;
        mov rsi, 32;
        add rdi, rsi;                       // &record[0]
        mov rsi, r14;
        call registry_v2_checksum;

        mov r15, [rbx + 24];
        cmp rax, r15;
        jne registry_v2_validate_content_sum;

        // ---- Signature block base = image + 32 + count*96 ----
        mov r14, r12;
        shl r14, 6;
        mov r15, r12;
        shl r15, 5;
        add r14, r15;
        add r14, rbx;
        mov r15, 32;
        add r14, r15;                       // r14 = &sig_block

        // ---- Stage 6: sig magic ----
        mov rax, [r14 + 0];
        mov r9, 0xFFFFFFFF;
        and rax, r9;
        mov r9, 0x47534450;                 // 'P','D','S','G'
        cmp rax, r9;
        jne registry_v2_validate_sig_magic;

        // ---- Stage 7: sig alg ----
        mov rax, [r14 + 0];
        shr rax, 32;
        mov r9, 0xFFFF;
        and rax, r9;
        cmp rax, 1;                         // ML-DSA-65
        jne registry_v2_validate_sig_alg;

        // ---- Stage 8: declared length ----
        mov rax, [r14 + 8];
        mov r9, 3309;
        cmp rax, r9;
        jne registry_v2_validate_sig_len;

        // ---- Stage 9: body all zero (scaffold epoch) ----
        mov rcx, r14;
        mov r9, 16;
        add rcx, r9;                        // &sig_body
        mov r9, 3309;

      registry_v2_validate_sig_zero_loop:
        cmp r9, 0;
        je  registry_v2_validate_ok;
        mov al, [rcx + 0];
        mov r8, 0xFF;
        and rax, r8;
        cmp rax, 0;
        jne registry_v2_validate_sig_nonzero;
        inc rcx;
        dec r9;
        jmp registry_v2_validate_sig_zero_loop;

      registry_v2_validate_ok:
        xor rax, rax;                       // REGISTRY_V2_OK
        jmp registry_v2_validate_ret;

      registry_v2_validate_bad_magic:
        mov rax, 0xFFFFFD04;
        jmp registry_v2_validate_ret;

      registry_v2_validate_bad_version:
        mov rax, 0xFFFFFD05;
        jmp registry_v2_validate_ret;

      registry_v2_validate_bad_geom:
        mov rax, 0xFFFFFD06;
        jmp registry_v2_validate_ret;

      registry_v2_validate_rec_sum:
        mov rax, 0xFFFFFD07;
        jmp registry_v2_validate_ret;

      registry_v2_validate_content_sum:
        mov rax, 0xFFFFFD08;
        jmp registry_v2_validate_ret;

      registry_v2_validate_sig_magic:
        mov rax, 0xFFFFFD09;
        jmp registry_v2_validate_ret;

      registry_v2_validate_sig_alg:
        mov rax, 0xFFFFFD0A;
        jmp registry_v2_validate_ret;

      registry_v2_validate_sig_len:
        mov rax, 0xFFFFFD0B;
        jmp registry_v2_validate_ret;

      registry_v2_validate_sig_nonzero:
        mov rax, 0xFFFFFD0C;

      registry_v2_validate_ret:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame
}
