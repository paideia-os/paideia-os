// src/kernel/core/driver/driver_table.pdx — R29.M2-001 (#1023)
//
// 32-row driver descriptor table + register/lookup/state primitives.
// The storage substrate the R29.M2 lifecycle FSM (lifecycle.pdx) reads
// from and writes to.
//
// Design context
// --------------
// Per design/roadmap/next-wave-softarch.md §3 R29, every driver in
// PaideiaOS runs as its own userspace process holding narrow
// capabilities (per-vector IRQ + per-device IOMMU domain + per-endpoint
// MMIO) and is separately-restartable. The runtime state of each
// driver process (Init / Running / Suspended / Handoff / Stopping /
// Stopped) belongs to the kernel — a driver cannot forge or bypass its
// own lifecycle FSM, and the supervisor sees the table via a
// KIND_DRIVER capability (introduced separately in
// src/kernel/core/cap/driver_cap.pdx).
//
// This module is the descriptor storage — a 32-slot .bss array where
// each row holds the driver's runtime state byte, its process id, a
// short name (16 bytes, NUL-padded), and an offset into the
// capability-manifest region the supervisor keeps for that driver.
// lifecycle.pdx builds the FSM primitives on top of this storage;
// the KIND_DRIVER capability handler (R29.M3+) reads it to serve
// driver_supervisor_channel RPCs.
//
// The 32-slot cap is deliberate: the T14 G4 target hardware
// (design/drivers/architecture.md §2) needs ~24 drivers at boot
// (uart+pci+xhci+e1000e+nvme+display+audio+wifi+bt+ec+thermal+
// battery+backlight+i2c×3+gpio×2+lpss×2+ipu6+guc+hda) with headroom
// for hot-plug. 32 rounds to a power of two, matching the cap_table
// slot-count discipline (256 = 2^8 in src/kernel/core/cap/table.pdx).
//
// Row layout (48 bytes = six u64s)
// --------------------------------
//   [+0]  u64 header:
//         bits [7:0]   state (u8; DRIVER_STATE_INIT..DRIVER_STATE_STOPPED)
//         bits [15:8]  in_use (u8; 0=free, 1=allocated)
//         bits [31:16] reserved (must be zero)
//         bits [63:32] pid (u32)
//   [+8]  u64 caps_manifest_offset (u32 in low bits) — byte offset
//         into the supervisor's per-driver manifest region; not
//         interpreted by this file. Reserved high bits (u32) MUST
//         stay zero for future flags.
//   [+16] u64 name[0..7]  — first 8 bytes of the NUL-padded driver name.
//   [+24] u64 name[8..15] — last  8 bytes of the NUL-padded driver name.
//   [+32] u64 DMA-domain binding (R29.M5-003, #1038):
//         bits [15:0]  dma_domain_row_id  (row in _dma_domain_table)
//         bits [23:16] dma_domain_cap_slot (cap_table slot holding the
//                      driver's KIND_DMA_DOMAIN capability)
//         bit  [24]    dma_domain_present (0 = none, 1 = minted)
//         bits [63:25] reserved (must be zero)
//   [+40] u64 supervision word (R29.M7-001/004, #1044/#1047):
//         bits [4:0]   parent_slot        (0..31; meaningful iff bit 5)
//         bit  [5]     parent_present
//         bit  [6]     perm_failed        (restart budget exhausted)
//         bit  [7]     reserved
//         bits [15:8]  restart_count      (restarts in the current window)
//         bits [23:16] incarnation        (u8; identity of this life)
//         bits [63:24] window_start_coarse(TSC >> 20, 40 bits)
//
// Supervision word (R29.M7-001/004)
// ---------------------------------
// design/drivers/cascade-restart.md §2 explains why the parent link
// lives in the descriptor rather than in a side table: it is the same
// argument the [+32] DMA-domain field makes one field earlier. The row
// is the storage that would have to be corrupted for the supervision
// relation to break, so the row is where the relation is enforced. A
// side table could drift from the descriptor it describes; a field
// cannot drift from itself.
//
// The incarnation counter is the load-bearing half. It is NOT a restart
// tally (restart_count is, separately) — it is the identity of the
// driver's current life, bumped by driver_table_rearm_incarnation in
// the same store that resets the state byte. Every endpoint bound to
// this driver records the incarnation it was bound against
// (endpoint_table.pdx §binding word), which is what lets the kernel
// refuse a capability minted for a dead incarnation without keeping a
// revocation list.
//
// D1.b cardinality (R29.M5-003, #1038)
// ------------------------------------
// design/drivers/blob-policy.md §2 fixes IOMMU domain granularity at
// exactly ONE KIND_DMA_DOMAIN per driver process. The `present` bit at
// [+32] bit 24 is where that cardinality is *enforced*, not merely
// recorded: driver_table_set_domain refuses with
// DRIVER_TABLE_DOMAIN_EXISTS if the bit is already set, so a second mint
// against the same driver slot cannot succeed even if the caller reaches
// past the lifecycle FSM. The enforcement lives here rather than in
// lifecycle.pdx because this is the storage that would have to be
// corrupted for two domains to coexist — a check anywhere upstream is a
// convention, a check at the store is an invariant.
//
// The `present` bit is separate from a zero row_id sentinel for the same
// reason in_use is separate from a zero state byte: row 0 is a perfectly
// legal domain row, so "row_id == 0" cannot mean "no domain".
//
// Total: 6 * 8 = 48 bytes / row × 32 rows = 1536 bytes .bss, @align(64).
//
// State byte lives at [+0] byte 0 so an FSM transition is a single
// byte store — no need to read-modify-write the header u64. The
// separate in_use byte at [+1] distinguishes "free slot with state
// DRIVER_STATE_INIT=0" from "unregistered slot with byte==0". Without
// in_use the get_state discipline could not tell whether a zero byte
// meant "freshly-registered Init driver" or "never registered".
//
// Concurrency
// -----------
// R29.M2 substrate is single-flow pre-scheduler-bringup + non-
// preemptible; no ABA guard, no per-row lock. SMP-safety revisits
// at R29.M7 (chaos-restart harness). Every mutator here writes at
// most one u64 per operation, so a torn store cannot leave the row
// in an intermediate-illegal state observable from another CPU —
// but a concurrent register+get_state pair is undefined at R29.M2.

module DriverTable = structure {

  // ============================================================================
  // Table geometry
  // ============================================================================

  pub let DRIVER_TABLE_SLOTS    : u64 = 32
  pub let DRIVER_TABLE_ROW_BYTES: u64 = 48
  pub let DRIVER_TABLE_BYTES    : u64 = 1536         // 32 * 48

  // ============================================================================
  // Row-field byte offsets (from row base)
  // ============================================================================

  pub let DRIVER_ROW_OFF_STATE          : u64 = 0
  pub let DRIVER_ROW_OFF_IN_USE         : u64 = 1
  pub let DRIVER_ROW_OFF_HEADER         : u64 = 0    // full [+0] u64 header
  pub let DRIVER_ROW_OFF_CAPS_OFFSET    : u64 = 8
  pub let DRIVER_ROW_OFF_NAME_LO        : u64 = 16
  pub let DRIVER_ROW_OFF_NAME_HI        : u64 = 24
  pub let DRIVER_ROW_OFF_DMA_DOMAIN     : u64 = 32
  pub let DRIVER_ROW_OFF_SUPERVISION    : u64 = 40

  // R29.M7-001/004 (#1044/#1047) — supervision-word field geometry.
  // Named here (rather than only in restart.pdx) because this module
  // owns the store and enforces the perm_failed / incarnation
  // invariants against it.
  pub let DRIVER_SUP_PARENT_MASK        : u64 = 0x1F         // bits [4:0]
  pub let DRIVER_SUP_PARENT_PRESENT     : u64 = 0x20         // bit 5
  pub let DRIVER_SUP_PERM_FAILED        : u64 = 0x40         // bit 6
  pub let DRIVER_SUP_RESTARTS_SHIFT     : u64 = 8            // bits [15:8]
  pub let DRIVER_SUP_INCARN_SHIFT       : u64 = 16           // bits [23:16]
  pub let DRIVER_SUP_WINDOW_SHIFT       : u64 = 24           // bits [63:24]

  // ============================================================================
  // Return codes (disjoint from lifecycle.pdx's DRIVER_LIFECYCLE_* space
  // so a mixed-caller error trace remains observably distinct).
  // ============================================================================

  pub let DRIVER_TABLE_REGISTER_OK           : u64 = 0
  pub let DRIVER_TABLE_REGISTER_BAD_SLOT     : u64 = 0xFFFFFEFF
  pub let DRIVER_TABLE_REGISTER_ALREADY_USED : u64 = 0xFFFFFEFE

  // R29.M5-003 (#1038) — DMA-domain descriptor field. Codes continue the
  // same downward block so a mixed trace still names its origin.
  pub let DRIVER_TABLE_DOMAIN_OK             : u64 = 0
  pub let DRIVER_TABLE_DOMAIN_BAD_SLOT       : u64 = 0xFFFFFEFD

  // DRIVER_TABLE_DOMAIN_EXISTS is the D1.b cardinality refusal. It is a
  // DISTINCT code — not folded into BAD_ARG — because "you asked for a
  // second domain" and "you passed a malformed row id" call for opposite
  // supervisor responses: the first is a policy violation to audit, the
  // second is a caller bug to fix.
  pub let DRIVER_TABLE_DOMAIN_EXISTS         : u64 = 0xFFFFFEFC
  pub let DRIVER_TABLE_DOMAIN_BAD_ARG        : u64 = 0xFFFFFEFB

  // Read sentinel for driver_table_read_domain_{row,cap}: the slot is
  // out of range, not in_use, or carries no domain.
  pub let DRIVER_TABLE_DOMAIN_NONE           : u64 = 0xFFFFFFFFFFFFFFFF

  // R29.M7-001 (#1044) — re-arm codes. Continue the same downward block
  // so a mixed trace still names its origin. Four distinct refusals
  // rather than one: each names a DIFFERENT broken precondition and a
  // different fix, and collapsing them would make the one refusal that
  // matters most (PERM_FAILED — the escalation latch) indistinguishable
  // from a caller ordering bug.
  pub let DRIVER_TABLE_REARM_OK              : u64 = 0
  pub let DRIVER_TABLE_REARM_BAD_SLOT        : u64 = 0xFFFFFEFA
  pub let DRIVER_TABLE_REARM_NOT_STOPPED     : u64 = 0xFFFFFEF9
  pub let DRIVER_TABLE_REARM_DOMAIN_LIVE     : u64 = 0xFFFFFEF8
  pub let DRIVER_TABLE_REARM_PERM_FAILED     : u64 = 0xFFFFFEF7

  // ============================================================================
  // Backing storage — 32 rows × 48 B = 1536 B = 192 u64s, @align(64).
  //
  // .bss zero-init means every row starts with state=0 (INIT), in_use=0
  // (free), pid=0, caps_offset=0, name=empty. driver_table_register is
  // the only mutator that flips in_use to 1.
  // ============================================================================

  pub let mut _driver_table : [u64; 192] = uninit @align(64)

  // ============================================================================
  // driver_table_row_addr(slot) -> u64
  //
  // SysV ABI: rdi = slot -> rax = &_driver_table + slot * 48 (kernel VA).
  // No bounds check — internal helper, callers must gate slot first.
  // ============================================================================

  pub let driver_table_row_addr : (u64) -> u64 !{} @{} =
    fn (slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R29.M2-001 (#1023): compute row address for a slot in [0..DRIVER_TABLE_SLOTS). Multiply-by-48 via id*16 + id*32 (shl 4 + shl 5 + add) — no imul, matches endpoint_table.pdx's multiply-by-48 discipline. Add &_driver_table base. Pure computation; no memory access. Leaf function; no callee-save writes.",
      block: {
        mov r8, rdi;
        shl r8, 4;                          // slot * 16
        mov r9, rdi;
        shl r9, 5;                          // slot * 32
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // r8 = &row
        mov rax, r8;
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_slot_in_use(slot) -> u64
  //
  // SysV ABI: rdi = slot -> rax = 1 if slot < 32 AND row's in_use byte
  // (byte 1 of the [+0] u64) is non-zero; else 0.
  // ============================================================================

  pub let driver_table_slot_in_use : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): return 1 iff slot < DRIVER_TABLE_SLOTS AND row.in_use byte is non-zero. Bounds-check first, then compute row addr (multiply-by-48), load header u64, shift right 8 and mask 0xFF to extract in_use byte. Pure read; no writes to memory. Leaf function; no callee-save writes.",
      block: {
        cmp rdi, 32;                        // DRIVER_TABLE_SLOTS
        jae drv_slot_in_use_no;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        mov rax, [r8 + 0];
        shr rax, 8;                         // header >> 8 -> in_use in low byte
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  drv_slot_in_use_no;

        mov rax, 1;
        ret;

      drv_slot_in_use_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_register(slot, pid, name_ptr, caps_manifest_offset) -> u64
  //
  // SysV ABI:
  //   rdi = slot                    (target row index; 0..31)
  //   rsi = pid                     (u32 in low bits)
  //   rdx = name_ptr                (kernel VA of 16-byte NUL-padded name)
  //   rcx = caps_manifest_offset    (u32 in low bits)
  //
  // Returns:
  //   DRIVER_TABLE_REGISTER_OK          (0)          — row populated,
  //                                                    state=INIT, in_use=1.
  //   DRIVER_TABLE_REGISTER_BAD_SLOT    (0xFFFFFEFF) — slot >= 32.
  //   DRIVER_TABLE_REGISTER_ALREADY_USED(0xFFFFFEFE) — row already in_use.
  //
  // On success writes:
  //   [row+0]  = (pid << 32) | (1 << 8) | DRIVER_STATE_INIT (0)
  //              i.e. state byte = 0 at [+0], in_use = 1 at [+1],
  //              reserved bytes 2..3 = 0, pid at bytes 4..7.
  //   [row+8]  = caps_manifest_offset & 0xFFFFFFFF (upper 32 zero).
  //   [row+16] = *(u64 *)(name_ptr + 0)   — first 8 bytes.
  //   [row+24] = *(u64 *)(name_ptr + 8)   — last  8 bytes.
  //   [row+32] = 0
  //   [row+40] = 0
  //
  // Caller is responsible for ensuring name_ptr points to at least
  // 16 readable bytes; passing a shorter buffer risks reading past the
  // end. Convention: name is NUL-padded to 16 bytes; callers pass a
  // 16-byte rodata buffer.
  // ============================================================================

  pub let driver_table_register : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (pid: u64) (name_ptr: u64) (caps_manifest_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): register a driver descriptor at slot. Sequence: (1) bounds-check slot < DRIVER_TABLE_SLOTS -> BAD_SLOT on fail. (2) Compute row addr via multiply-by-48 (shl 4 + shl 5 + add), same shape as driver_table_row_addr but inlined for the fast path. (3) Load current header, extract in_use byte, if != 0 return ALREADY_USED (do not overwrite a live row — the supervisor must revoke first per design/drivers/framework.md §3.4). (4) Pack header: state=0 (INIT) at byte 0, in_use=1 at byte 1, reserved=0 at bytes 2..3, pid at bytes 4..7. Mask pid low 32 bits then shift left 32. OR with (1<<8). (5) Store header. (6) Store caps_manifest_offset & 0xFFFFFFFF at [+8]. (7) Copy 16-byte name via two u64 loads from name_ptr and stores to [+16] and [+24]. (8) Zero reserved slots [+32] and [+40]. Return REGISTER_OK. Preserve caller-save args across pushed callee-save. Written as unsafe block per paideia-as #913 discipline. r12 preserved to survive the potential future call chain, though this leaf currently makes no calls.",
      block: {
        // (1) Bounds-check slot.
        cmp rdi, 32;                        // DRIVER_TABLE_SLOTS
        jae drv_register_bad_slot;

        // Spill callee-save regs used for arg staging (r12..r15).
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rsi;                       // pid
        mov r13, rdx;                       // name_ptr
        mov r14, rcx;                       // caps_manifest_offset
        mov r15, rdi;                       // slot

        // (2) row = &_driver_table + slot * 48.
        mov r8, r15;
        shl r8, 4;
        mov r9, r15;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // r8 = &row

        // (3) already-in-use gate.
        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 8;
        mov r11, 0xFF;
        and r10, r11;
        cmp r10, 0;
        jne drv_register_already;

        // (4) build header:
        //   pid (low 32 bits) << 32 | (1 << 8) | 0(state=INIT).
        mov rax, r12;                       // pid
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        shl rax, 32;                        // pid at bytes 4..7
        mov r10, 1;
        shl r10, 8;                         // in_use = 1 at byte 1
        or  rax, r10;
        // state byte at [+0] = 0 (DRIVER_STATE_INIT) — implicit in
        // the zero low byte of rax.

        // (5) store header.
        mov [r8 + 0], rax;

        // (6) store caps_manifest_offset (low 32 bits).
        mov rax, r14;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        mov [r8 + 8], rax;

        // (7) copy 16-byte name via two u64 loads/stores.
        mov rax, [r13 + 0];
        mov [r8 + 16], rax;
        mov rax, [r13 + 8];
        mov [r8 + 24], rax;

        // (8) zero reserved slots.
        xor rax, rax;
        mov [r8 + 32], rax;
        mov [r8 + 40], rax;

        // Return OK.
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        xor rax, rax;                       // DRIVER_TABLE_REGISTER_OK
        ret;

      drv_register_already:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        mov rax, 0xFFFFFEFE;                // DRIVER_TABLE_REGISTER_ALREADY_USED
        ret;

      drv_register_bad_slot:
        mov rax, 0xFFFFFEFF;                // DRIVER_TABLE_REGISTER_BAD_SLOT
        ret
      }
    }

  // ============================================================================
  // driver_table_read_state_byte(slot) -> u64
  //
  // SysV ABI: rdi = slot -> rax = state byte (byte 0 of the [+0] u64).
  // No bounds check, no in_use check — internal helper. Callers must
  // gate slot AND in_use themselves.
  // ============================================================================

  pub let driver_table_read_state_byte : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): read state byte at row[+0] byte 0. Compute row addr (multiply-by-48), load header u64, mask 0xFF. Pure read; no writes. Leaf function; no callee-save writes. Used by lifecycle.pdx after its own slot + in_use gates.",
      block: {
        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, 0xFF;
        and rax, r10;
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_write_state_byte(slot, new_state) -> ()
  //
  // SysV ABI: rdi = slot, rsi = new_state (0..255; caller must gate).
  // Writes the low byte of new_state to row[+0] byte 0, preserving the
  // remaining seven bytes of the header (in_use, reserved, pid).
  //
  // No bounds check — internal helper. Callers must gate slot themselves.
  // Uses a read-modify-write on the header u64 rather than a raw byte
  // store so cross-CPU tearing behaviour matches the rest of the
  // R29.M2 substrate (a byte-store into a u64-aligned slot is fine on
  // x86-64 today but the RMW keeps the store discipline uniform with
  // the register-based helpers used elsewhere in the tree).
  // ============================================================================

  pub let driver_table_write_state_byte : (u64, u64) -> () !{mem} @{} =
    fn (slot: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): update state byte at row[+0] byte 0, preserving remaining seven bytes of the header (in_use at byte 1, reserved at bytes 2..3, pid at bytes 4..7). Compute row addr, load header, clear low byte via AND with ~0xFF (= 0xFFFFFFFFFFFFFF00), OR in new_state masked to low byte, store back. Single-byte precision matters: an accidental full-header overwrite would drop the in_use flag and pid. Leaf function; no callee-save writes. Called by lifecycle.pdx after transition validation.",
      block: {
        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        mov rax, [r8 + 0];                  // load header
        mov r10, 0xFFFFFFFFFFFFFF00;        // clear-low-byte mask
        and rax, r10;
        mov r10, rsi;                       // new_state
        mov r11, 0xFF;
        and r10, r11;                       // low byte only
        or  rax, r10;
        mov [r8 + 0], rax;                  // store updated header
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_read_pid(slot) -> u64
  //
  // SysV ABI: rdi = slot -> rax = pid (u32 in low bits).
  // No bounds check — internal helper. Extracts bits [63:32] of the row
  // header. Returns 0 if the row was never registered (pid stays zero
  // in .bss). Callers who need to distinguish "unregistered" from
  // "registered with pid=0" must check driver_table_slot_in_use first.
  // ============================================================================

  pub let driver_table_read_pid : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): read pid from row[+0] bits [63:32]. Compute row addr, load header, shift right 32 (pid was packed at bytes 4..7). No mask needed because we shift the upper 32 bits into the low 32; the low u32 of rax is now pid. Pure read; leaf function.",
      block: {
        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _driver_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 32;
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_read_caps_offset(slot) -> u64
  //
  // SysV ABI: rdi = slot -> rax = caps_manifest_offset (u32 in low bits).
  // Reads [row+8] low 32 bits. No bounds check — internal helper.
  // ============================================================================

  pub let driver_table_read_caps_offset : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): read caps_manifest_offset from row[+8] low 32 bits. Compute row addr, load [+8], mask 0xFFFFFFFF. Pure read; leaf function.",
      block: {
        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _driver_table];
        add r8, r9;

        mov rax, [r8 + 8];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret
      }
    } @no_frame

  // ============================================================================
  // R29.M5-003 (#1038) — per-driver-process DMA-domain descriptor field
  // ============================================================================
  //
  // driver_table_has_domain(slot)        -> 1 | 0
  // driver_table_set_domain(slot, row_id, cap_slot) -> rc
  // driver_table_read_domain_row(slot)   -> row_id  | DRIVER_TABLE_DOMAIN_NONE
  // driver_table_read_domain_cap(slot)   -> cap_slot| DRIVER_TABLE_DOMAIN_NONE
  // driver_table_clear_domain(slot)      -> ()
  //
  // All five gate on slot < DRIVER_TABLE_SLOTS AND row.in_use, so a
  // caller can never attach a domain to a slot that holds no driver —
  // which would strand a scarce IOMMU row behind a descriptor nobody
  // will ever tear down.
  // ============================================================================

  pub let driver_table_has_domain : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-003 (#1038): return 1 iff slot < DRIVER_TABLE_SLOTS AND row.in_use is set AND the DMA-domain present bit ([+32] bit 24) is set; else 0. Bounds-check, compute row addr (multiply-by-48), read the [+0] header for in_use, then read [+32] and test bit 24. Pure read; leaf function.",
      block: {
        cmp rdi, 32;                        // DRIVER_TABLE_SLOTS
        jae drv_has_dom_no;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        mov rax, [r8 + 0];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  drv_has_dom_no;                 // slot not in_use

        mov rax, [r8 + 32];
        shr rax, 24;                        // present bit -> bit 0
        mov r10, 1;
        and rax, r10;
        ret;

      drv_has_dom_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_set_domain(slot, row_id, cap_slot) -> u64
  //
  // THE D1.b cardinality gate. Returns:
  //   DRIVER_TABLE_DOMAIN_OK       (0)          — field written.
  //   DRIVER_TABLE_DOMAIN_BAD_SLOT (0xFFFFFEFD) — slot >= 32 or not in_use.
  //   DRIVER_TABLE_DOMAIN_EXISTS   (0xFFFFFEFC) — slot already carries a
  //                                               domain. Refused; the
  //                                               existing field is left
  //                                               byte-for-byte intact.
  //   DRIVER_TABLE_DOMAIN_BAD_ARG  (0xFFFFFEFB) — row_id >= 2^16 or
  //                                               cap_slot >= 256.
  //
  // SysV ABI: rdi = slot, rsi = row_id, rdx = cap_slot.
  // ============================================================================

  pub let driver_table_set_domain : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (row_id: u64) (cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-003 (#1038): attach exactly one KIND_DMA_DOMAIN to a driver slot. Gate order: (1) slot >= DRIVER_TABLE_SLOTS -> BAD_SLOT. (2) row_id >> 16 non-zero, or cap_slot >= 256 -> BAD_ARG (argument validation precedes the state read so a malformed call cannot be reported as a policy violation). (3) row.in_use zero -> BAD_SLOT. (4) [+32] bit 24 already set -> DOMAIN_EXISTS, returning WITHOUT touching the field: refusing while half-overwriting would leave the descriptor naming a domain the caller does not hold. (5) Commit [+32] = (row_id & 0xFFFF) | ((cap_slot & 0xFF) << 16) | (1 << 24) — a single u64 store that also zeroes the [63:25] reserved field. Leaf; no calls.",
      block: {
        cmp rdi, 32;                        // DRIVER_TABLE_SLOTS
        jae drv_set_dom_bad_slot;

        // Argument validation before any state inspection.
        mov r10, rsi;
        shr r10, 16;
        cmp r10, 0;
        jne drv_set_dom_bad_arg;

        cmp rdx, 256;
        jae drv_set_dom_bad_arg;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        // in_use gate.
        mov rax, [r8 + 0];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  drv_set_dom_bad_slot;

        // Cardinality gate — present bit already set?
        mov rax, [r8 + 32];
        shr rax, 24;
        mov r10, 1;
        and rax, r10;
        cmp rax, 0;
        jne drv_set_dom_exists;

        // Commit.
        mov rax, rsi;
        mov r10, 0xFFFF;
        and rax, r10;                       // row_id

        mov r11, rdx;
        mov r10, 0xFF;
        and r11, r10;
        shl r11, 16;
        or  rax, r11;                       // | cap_slot << 16

        mov r11, 1;
        shl r11, 24;
        or  rax, r11;                       // | present

        mov [r8 + 32], rax;

        xor rax, rax;                       // DRIVER_TABLE_DOMAIN_OK
        ret;

      drv_set_dom_exists:
        mov rax, 0xFFFFFEFC;                // DRIVER_TABLE_DOMAIN_EXISTS
        ret;

      drv_set_dom_bad_slot:
        mov rax, 0xFFFFFEFD;                // DRIVER_TABLE_DOMAIN_BAD_SLOT
        ret;

      drv_set_dom_bad_arg:
        mov rax, 0xFFFFFEFB;                // DRIVER_TABLE_DOMAIN_BAD_ARG
        ret
      }
    } @no_frame

  pub let driver_table_read_domain_row : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-003 (#1038): return the DMA-domain row id from [+32] bits [15:0], or DRIVER_TABLE_DOMAIN_NONE (0xFF..FF) when slot >= 32, the row is not in_use, or the present bit is clear. The sentinel is unambiguous: a legal row id is < DMA_DOMAIN_MAX (32). Pure read; leaf function.",
      block: {
        cmp rdi, 32;
        jae drv_rd_dom_row_none;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _driver_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  drv_rd_dom_row_none;

        mov rax, [r8 + 32];
        mov r10, rax;
        shr r10, 24;
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        je  drv_rd_dom_row_none;

        mov r10, 0xFFFF;
        and rax, r10;
        ret;

      drv_rd_dom_row_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let driver_table_read_domain_cap : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-003 (#1038): return the cap_table slot holding the driver's KIND_DMA_DOMAIN capability, from [+32] bits [23:16], or DRIVER_TABLE_DOMAIN_NONE when slot >= 32, the row is not in_use, or the present bit is clear. Sentinel unambiguous: a legal cap slot is < 256. Pure read; leaf function.",
      block: {
        cmp rdi, 32;
        jae drv_rd_dom_cap_none;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _driver_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  drv_rd_dom_cap_none;

        mov rax, [r8 + 32];
        mov r10, rax;
        shr r10, 24;
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        je  drv_rd_dom_cap_none;

        shr rax, 16;
        mov r10, 0xFF;
        and rax, r10;
        ret;

      drv_rd_dom_cap_none:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let driver_table_clear_domain : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M5-003 (#1038): zero the [+32] DMA-domain field, dropping the present bit along with the row id and cap slot. Bounds-check slot < DRIVER_TABLE_SLOTS -> silent no-op. Deliberately does NOT gate on in_use: teardown may need to clear the field on a row whose in_use was already dropped by an out-of-order unregister, and a clear can never be harmful. Full-word zero rather than a bit clear so no stale row id survives to be misread if a future revision widens the present test. Leaf function.",
      block: {
        cmp rdi, 32;
        jae drv_clr_dom_done;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _driver_table];
        add r8, r9;

        xor rax, rax;
        mov [r8 + 32], rax;

      drv_clr_dom_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // R29.M7-001/004 (#1044/#1047) — supervision word at [+40]
  // ============================================================================
  //
  // driver_table_read_sup(slot)            -> word | 0
  // driver_table_write_sup(slot, word)     -> ()
  // driver_table_rearm_incarnation(slot)   -> rc
  //
  // read/write gate on slot < DRIVER_TABLE_SLOTS AND row.in_use, so the
  // supervision relation can never name a slot that holds no driver —
  // the same gate the domain accessors use, for the same reason: a
  // parent link to an empty row would make the subtree computation in
  // restart.pdx return descendants nobody can stop.
  //
  // read returns 0 (not a sentinel) on a bad slot. Zero is a legal
  // supervision word — it means "no parent, no restarts, incarnation 0"
  // — and that is exactly the right reading for a slot that holds no
  // driver: it supervises nothing and has never been restarted. Every
  // field decoder in restart.pdx therefore behaves correctly on a bad
  // slot without a separate error path.
  // ============================================================================

  pub let driver_table_read_sup : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-001 (#1044): return the supervision word at row[+40], or 0 when slot >= DRIVER_TABLE_SLOTS or the row is not in_use. Bounds-check, compute row addr via the multiply-by-48 shift-add (shl 4 + shl 5 + add) used by every accessor in this file, read the [+0] header for in_use, then load [+40]. Zero rather than an error sentinel: a zero word decodes to 'no parent, zero restarts, incarnation 0', which is the correct reading for a slot holding no driver, so callers need no separate error path. Pure read; leaf function.",
      block: {
        cmp rdi, 32;                        // DRIVER_TABLE_SLOTS
        jae drv_rd_sup_zero;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        mov rax, [r8 + 0];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  drv_rd_sup_zero;                // slot not in_use

        mov rax, [r8 + 40];                 // DRIVER_ROW_OFF_SUPERVISION
        ret;

      drv_rd_sup_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let driver_table_write_sup : (u64, u64) -> () !{mem} @{} =
    fn (slot: u64) (word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-001 (#1044): store the supervision word at row[+40]. Silent no-op when slot >= DRIVER_TABLE_SLOTS or the row is not in_use — a write to an unoccupied row would install a supervision relation nobody can tear down, and refusing loudly here would force every caller in restart.pdx to carry an error path for a condition it has already gated. Single u64 store; the whole word is caller-owned, so no read-modify-write is needed. Leaf function.",
      block: {
        cmp rdi, 32;                        // DRIVER_TABLE_SLOTS
        jae drv_wr_sup_done;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        mov rax, [r8 + 0];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  drv_wr_sup_done;                // slot not in_use

        mov [r8 + 40], rsi;                 // DRIVER_ROW_OFF_SUPERVISION

      drv_wr_sup_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_rearm_incarnation(slot) -> u64
  //
  // Retire the current incarnation and install the next one in the same
  // descriptor slot. THIS IS NOT AN FSM TRANSITION — see
  // design/drivers/cascade-restart.md §4.2. Stopped stays terminal in
  // DRIVER_LIFECYCLE_TABLE; what comes back is a NEW driver life that
  // happens to reuse the slot, which is exactly the claim every stale-
  // capability refusal downstream depends on.
  //
  // The four gates are what stop this being a back door into the FSM:
  //
  //   BAD_SLOT     — slot >= 32 or not in_use.
  //   NOT_STOPPED  — the FSM has not reached its terminal state. Without
  //                  this gate a caller could reset a Running driver to
  //                  Init and forge a lifecycle.
  //   DOMAIN_LIVE  — [+32] still carries a KIND_DMA_DOMAIN. Re-arming
  //                  over a live domain would hand incarnation N+1 the
  //                  IOMMU authority of incarnation N — the precise
  //                  inheritance §4.2 forbids. driver_lifecycle_teardown
  //                  is the only thing that clears it, and it in turn
  //                  requires Stopped, so the two gates compose into
  //                  "the previous life is fully wound down".
  //   PERM_FAILED  — the escalation latch (bit 6). Terminality is
  //                  enforced HERE, at the store, rather than only in
  //                  restart.pdx, so it holds against every future
  //                  caller and not merely against the one that exists
  //                  today. A permanently-failed driver has exactly two
  //                  legal futures: stay Stopped, or be unregistered and
  //                  registered again as a genuinely new driver.
  //
  // Commit is three stores: state byte -> DRIVER_STATE_INIT (0)
  // preserving in_use/pid, [+32] -> 0, and [+40] with the incarnation
  // field incremented mod 256. The increment shares the commit with the
  // state reset so no observer can read incarnation N's number against
  // incarnation N+1's state. restart_count / window_start / parent link
  // are preserved untouched: the budget must survive a restart (that is
  // the whole point of a budget) and so must the supervision relation.
  //
  // SysV ABI: rdi = slot.
  // ============================================================================

  pub let driver_table_rearm_incarnation : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M7-001 (#1044): retire one driver incarnation and install the next in the same descriptor slot. Gate order: (1) slot >= DRIVER_TABLE_SLOTS -> REARM_BAD_SLOT. (2) row.in_use zero -> REARM_BAD_SLOT. (3) header state byte != DRIVER_STATE_STOPPED (5) -> REARM_NOT_STOPPED — without this the primitive would be an FSM bypass. (4) [+32] bit 24 (DMA-domain present) set -> REARM_DOMAIN_LIVE; re-arming over a live domain would let incarnation N+1 inherit N's IOMMU authority. (5) [+40] bit 6 (perm_failed) set -> REARM_PERM_FAILED; this is where escalation terminality is enforced as a storage invariant rather than a supervisor convention. Commit: (a) header = (header & ~0xFF) | 0 -> state DRIVER_STATE_INIT, preserving in_use at byte 1 and pid at bytes 4..7. (b) [+32] = 0. (c) [+40] = (word & 0xFFFFFFFFFF00FFFF) | (((incarn + 1) & 0xFF) << 16) — increments bits [23:16] mod 256 while preserving parent link, perm_failed, restart_count and window_start; the mask is written as an explicit constant rather than a NOT of the field mask so the encoder sees one immediate load. Register plan: r8 = row addr, r9 = table base then free, rax = header then scratch, r10/r11 = masks and field temporaries. Leaf; no calls; no callee-save writes.",
      block: {
        cmp rdi, 32;                        // DRIVER_TABLE_SLOTS
        jae drv_rearm_bad_slot;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;                         // slot * 48
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        mov rax, [r8 + 0];                  // header

        // (2) in_use gate.
        mov r10, rax;
        shr r10, 8;
        mov r11, 0xFF;
        and r10, r11;
        cmp r10, 0;
        je  drv_rearm_bad_slot;

        // (3) terminal-state gate.
        mov r10, rax;
        mov r11, 0xFF;
        and r10, r11;
        cmp r10, 5;                         // DRIVER_STATE_STOPPED
        jne drv_rearm_not_stopped;

        // (4) no live DMA domain.
        mov r10, [r8 + 32];
        shr r10, 24;                        // present bit -> bit 0
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        jne drv_rearm_domain_live;

        // (5) escalation latch.
        mov r11, [r8 + 40];                 // supervision word
        mov r10, r11;
        shr r10, 6;                         // perm_failed -> bit 0
        mov r9, 1;
        and r10, r9;
        cmp r10, 0;
        jne drv_rearm_perm_failed;

        // ---- Commit (a): state byte -> DRIVER_STATE_INIT (0) ----
        mov r10, 0xFFFFFFFFFFFFFF00;
        and rax, r10;
        mov [r8 + 0], rax;

        // ---- Commit (b): drop the (already-revoked) domain field ----
        xor rax, rax;
        mov [r8 + 32], rax;

        // ---- Commit (c): incarnation += 1 (mod 256) ----
        mov r10, r11;
        shr r10, 16;                        // DRIVER_SUP_INCARN_SHIFT
        mov r9, 0xFF;
        and r10, r9;
        add r10, 1;
        and r10, r9;                        // wrap at 256
        shl r10, 16;

        mov r9, 0xFFFFFFFFFF00FFFF;         // clear bits [23:16]
        and r11, r9;
        or  r11, r10;
        mov [r8 + 40], r11;

        xor rax, rax;                       // DRIVER_TABLE_REARM_OK
        ret;

      drv_rearm_bad_slot:
        mov rax, 0xFFFFFEFA;                // DRIVER_TABLE_REARM_BAD_SLOT
        ret;

      drv_rearm_not_stopped:
        mov rax, 0xFFFFFEF9;                // DRIVER_TABLE_REARM_NOT_STOPPED
        ret;

      drv_rearm_domain_live:
        mov rax, 0xFFFFFEF8;                // DRIVER_TABLE_REARM_DOMAIN_LIVE
        ret;

      drv_rearm_perm_failed:
        mov rax, 0xFFFFFEF7;                // DRIVER_TABLE_REARM_PERM_FAILED
        ret
      }
    } @no_frame

  // ============================================================================
  // driver_table_unregister(slot) -> ()
  //
  // SysV ABI: rdi = slot -> zeros the row at slot if slot < 32; no-op
  // otherwise. Full-row zero clears state, in_use, pid, name, caps
  // offset — leaves the slot free for a subsequent register call.
  //
  // Provided for the R29.M2 witness's cleanup discipline. In production
  // the supervisor unregisters only after driver_lifecycle_get_state
  // returns DRIVER_STATE_STOPPED; there is no gate in this helper.
  // ============================================================================

  pub let driver_table_unregister : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M2-001 (#1023): unregister a slot by zeroing its six u64s (48 bytes). Bounds-check slot < DRIVER_TABLE_SLOTS -> silent no-op on fail. Zero-fills clear state (byte 0), in_use (byte 1), pid (bytes 4..7), caps_offset ([+8]), name ([+16] / [+24]), and both reserved slots ([+32] / [+40]) so a subsequent register call reads .bss-fresh sentinels. Leaf function; no callee-save writes.",
      block: {
        cmp rdi, 32;
        jae drv_unregister_done;

        mov r8, rdi;
        shl r8, 4;
        mov r9, rdi;
        shl r9, 5;
        add r8, r9;
        lea r9, [rip + _driver_table];
        add r8, r9;                         // &row

        xor rax, rax;
        mov [r8 + 0],  rax;
        mov [r8 + 8],  rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;
        mov [r8 + 32], rax;
        mov [r8 + 40], rax;

      drv_unregister_done:
        ret
      }
    } @no_frame
}
