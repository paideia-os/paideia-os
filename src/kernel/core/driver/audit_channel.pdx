// src/kernel/core/driver/audit_channel.pdx — R29.M6-001..004
// (#1040 / #1041 / #1042 / #1043)
//
// `driver_audit_channel : Channel(DriverAuditSchema)` — the sealed,
// one-way stream carrying every capability mint, every capability
// revoke, and every driver handoff to audit_supervisor.
//
// Schema, sealing semantics and the reconciliation contract are
// specified in design/ipc/driver-audit-schema.md. This file is that
// document in code; the section numbers below refer to it.
//
// -----------------------------------------------------------------------------
// What "sealed" means here (§4)
// -----------------------------------------------------------------------------
//
// The softarch line for R29 says the channel is one-way and sealed.
// "Sealed" is the load-bearing word and it is easy to leave as an
// adjective. Four concrete properties discharge it:
//
//   append-only    drv_audit_emit is the only writer of the ring and of
//                  _drv_audit_seq. Nothing exported erases a record,
//                  rewinds the counter, or accepts a caller-supplied
//                  seq or seal — both are derived inside the emitter.
//
//   gap-evident    every record stores its own seq (field 0). The
//                  record at back-distance d must carry
//                  seq == head - 1 - d. drv_audit_gap_check enforces
//                  exactly that, so a deleted or reordered record is
//                  detected by position, not by hope. Ring wrap is not
//                  a gap: drv_audit_seq() is how many records ever
//                  existed and drv_audit_retained() how many are still
//                  held, so a reader always knows how much was
//                  forgotten.
//
//   tamper-evident field 7 is a hash chain over fields 0..6 and the
//                  previous record's seal. drv_audit_seal_mix is the
//                  single definition of the step, used by the emitter
//                  AND the verifier so they cannot drift. Mutating any
//                  retained record breaks its own seal and every later
//                  one. This is detection, not cryptography — see §4.3
//                  for exactly which adversary it does and does not
//                  stop.
//
//   unsuppressable drv_audit_emit is declared capabilities: {}. There
//                  is no right whose absence blocks emission and none
//                  whose possession permits suppression, so the audited
//                  driver cannot acquire, delegate or steal one.
//                  Emission also cannot fail and returns no status: a
//                  failable audit write invites callers to ignore the
//                  failure.
//
// -----------------------------------------------------------------------------
// Why the ring carries no provenance field (§3.2, §7 — D1.c, #1043)
// -----------------------------------------------------------------------------
//
// blob-policy §3 gives blob-consuming drivers the SAME audit access as
// native drivers. The weak way to honour that is to write no
// conditional. The strong way — taken here — is to withhold the input:
// no record field encodes provenance, and no function in this file
// takes a provenance, image-origin or trust-tier argument. The audit
// layer cannot special-case a blob driver because it is never told
// which drivers are blob drivers, so re-introducing discrimination
// requires first adding a field or a parameter, which is a visible
// change rather than a quiet conditional.
//
// -----------------------------------------------------------------------------
// Record schema (§3)
// -----------------------------------------------------------------------------
//
// 128 records x 8 qwords = 1024 qwords = 8 KiB .bss. Sized so a full
// boot's churn — every witness mint, revoke, cascade and handoff — fits
// without wrapping, which is what lets the reconciliation harness read
// the whole history rather than a suffix of it.
//
//   field 0  seq        this record's sequence number, assigned from a
//                       boot-monotonic counter that is never masked.
//                       Stored IN the record; that is what makes gaps
//                       detectable (§4.2).
//   field 1  event      DRV_AUDIT_EV_MINT / _REVOKE / _HANDOFF
//   field 2  kind       0x140 / 0x141 / 0x142 for cap events; 0 for
//                       handoff (a handoff is not a capability event)
//   field 3  subject    cap_table slot for mint/revoke; driver_table
//                       slot for handoff
//   field 4  principal  parent cap slot for mint; the slot itself for
//                       revoke; the FROM-state for handoff
//   field 5  outcome    0 on success, else the primitive's verbatim
//                       error code. Refusals ARE recorded (§3.1): a
//                       refused mint creates no descriptor and is
//                       therefore invisible to every state-based check,
//                       while being exactly the pattern an audit trail
//                       exists to surface.
//   field 6  ts         raw TSC. Ordering is carried by seq; ts exists
//                       for correlation with the durable log.
//   field 7  seal       chained seal over fields 0..6 and seal(n-1)

module AuditChannel = structure {

  // ============================================================================
  // Ring geometry. 128 records keeps the index arithmetic a mask and the
  // whole object one 8 KiB .bss allocation.
  // ============================================================================

  pub let DRV_AUDIT_RECORDS      : u64 = 128
  pub let DRV_AUDIT_RING_MASK    : u64 = 127
  pub let DRV_AUDIT_FIELDS       : u64 = 8
  pub let DRV_AUDIT_RECORD_BYTES : u64 = 64

  pub let DRV_AUDIT_F_SEQ        : u64 = 0
  pub let DRV_AUDIT_F_EVENT      : u64 = 1
  pub let DRV_AUDIT_F_KIND       : u64 = 2
  pub let DRV_AUDIT_F_SUBJECT    : u64 = 3
  pub let DRV_AUDIT_F_PRINCIPAL  : u64 = 4
  pub let DRV_AUDIT_F_OUTCOME    : u64 = 5
  pub let DRV_AUDIT_F_TS         : u64 = 6
  pub let DRV_AUDIT_F_SEAL       : u64 = 7

  pub let DRV_AUDIT_EV_MINT      : u64 = 1
  pub let DRV_AUDIT_EV_REVOKE    : u64 = 2
  pub let DRV_AUDIT_EV_HANDOFF   : u64 = 3

  // R29.M7-001/004/005 (#1044/#1047/#1048) — restart-family events.
  // All three carry kind = 0, following DRV_AUDIT_EV_HANDOFF's
  // convention for events that are not capability transitions: the
  // kind field is the cap kind, and a restart is not one. That keeps
  // drv_audit_balance_since / drv_audit_live_count — which filter on
  // kind — unaffected by restart traffic, so mint/revoke accounting
  // for a real cap kind stays exact across a restart storm.
  //
  //   RESTART  subject = driver slot
  //            principal = new incarnation (outcome 0: node restarted)
  //                      | the slot that died (outcome 1: descendant
  //                        cascaded to a stop and NOT restarted)
  //   ESCALATE subject = driver slot, principal = restart count,
  //            outcome 1 — the budget refused, node left permanently
  //            failed in the FSM's terminal state.
  //   CHANDEAD subject = driver slot, principal = endpoint id — one
  //            record per channel torn down, which is what lets the
  //            R29.M7 post-restart reconciler account for every
  //            endpoint a restart killed.
  pub let DRV_AUDIT_EV_RESTART   : u64 = 4
  pub let DRV_AUDIT_EV_ESCALATE  : u64 = 5
  pub let DRV_AUDIT_EV_CHANDEAD  : u64 = 6

  // R31.M1-001 (#1089) — one embedded-controller transaction was
  // authorised, or refused. Carries kind = 0, following the convention
  // DRV_AUDIT_EV_HANDOFF set for events that are not capability
  // transitions: the kind field is the cap kind, and a register access
  // is not one. That keeps drv_audit_balance_since / drv_audit_live_count
  // — which filter on kind — unaffected by transaction traffic, so
  // mint/revoke accounting for a real cap kind stays exact even under a
  // burst of EC activity.
  //
  //   subject   = the EC-space address the transaction named
  //   principal = (op << 32) | (value & 0xFF) — the operation, and for
  //               a write the byte it carried. Packed into one field
  //               because the record has five and both halves are
  //               needed: "which byte was written to charge control"
  //               is not answerable from the address alone, and this is
  //               the one device in the tree where the written value can
  //               persist across a reboot.
  //   outcome   = 0 if the transaction was permitted, else the
  //               EC_ACCESS_* refusal code.
  //
  // Emitted from inside core/drivers/ec/ec_access.pdx's gate, never from
  // a call site, per §5.1.
  pub let DRV_AUDIT_EV_EC_XACT   : u64 = 7

  // Return codes. Disjoint from every neighbouring block:
  // DRIVER_LIFECYCLE_* at 0xFFFFFF0x, DMA_* at 0xFFFFFFD5..DC,
  // MSIX_* at 0xFFFFFFE7..E9, HW_INT_* at 0xFFFFFFF7..FD.
  pub let DRV_AUDIT_OK           : u64 = 0
  pub let DRV_AUDIT_ERR_GAP      : u64 = 0xFFFFFFC7
  pub let DRV_AUDIT_ERR_SEAL     : u64 = 0xFFFFFFC6
  pub let DRV_AUDIT_ERR_WINDOWED : u64 = 0xFFFFFFC5
  pub let DRV_AUDIT_ERR_MISMATCH : u64 = 0xFFFFFFC4

  // Chain initialisation vector. Any fixed non-zero value works; a
  // recognisable one makes an unsealed / never-written chain head
  // obvious in a memory dump.
  pub let DRV_AUDIT_SEAL_IV      : u64 = 0x5044584155444954

  // 128 records x 64 B = 8192 B = 1024 u64.
  pub let mut _drv_audit_ring : [u64; 1024] = uninit @align(64)

  // Monotonic across the whole boot; never masked. This is the count of
  // events that ever happened, not the count retained.
  pub let mut _drv_audit_seq       : u64 = 0

  // Running chain head — seal(n) for the newest record. Initialised to
  // the IV so the very first record chains from a known value.
  pub let mut _drv_audit_seal_head : u64 = 0x5044584155444954

  // Scratch for the timestamp, so drv_audit_emit does not need a sixth
  // callee-save register across kread_tsc. Also gives safectl a cheap
  // read of when the last event happened.
  pub let mut _drv_audit_last_ts   : u64 = 0

  // ============================================================================
  // drv_audit_seal_mix(prev_seal: u64, rec_ptr: u64) -> u64
  //
  //   rdi = the previous record's seal (or DRV_AUDIT_SEAL_IV)
  //   rsi = base address of a record whose fields 0..6 are populated
  //   -> rax = seal(n)
  //
  // Folds the seven content fields one at a time:
  //
  //   h ^= field; h *= 0x9E3779B97F4A7C15; h = rotl(h, 29)
  //
  // The multiply-then-rotate pair is what propagates a single flipped
  // bit across the whole word, so a one-byte edit anywhere in a record
  // changes its seal and — because h feeds the next record — every seal
  // after it.
  //
  // This is the ONLY definition of the step. The emitter and
  // drv_audit_seal_check both call it, which is the property that stops
  // a verifier from drifting away from what it verifies. Rotation is
  // spelled shl/shr/or rather than rol because rol is not used anywhere
  // else in the kernel and this is not the place to find out whether the
  // assembler encodes it.
  // ============================================================================

  pub let drv_audit_seal_mix : (u64, u64) -> u64 !{mem} @{} =
    fn (prev_seal: u64, rec_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): hash-chain step over a record's seven content fields. rax = running h, r9 = the golden-ratio constant, r8 = field cursor 0..6, r10 = scratch for the loaded field and the rotate carry-out. Loop body is exactly: load field i at rsi + i*8, xor into h, imul by K, rotate left 29 via shl/shr/or. Reads only the 56 bytes of the record the caller names; writes nothing. Leaf; no nested calls; all registers touched (rax, r8, r9, r10) are caller-save so no prologue is needed. Labels prefixed drv_audit_seal_mix_ per reserved-label discipline.",
      block: {
        mov rax, rdi;                        // h = prev_seal
        mov r9,  0x9E3779B97F4A7C15;         // K
        xor r8,  r8;                         // field cursor

      drv_audit_seal_mix_loop:
        cmp r8, 7;                           // fields 0..6 (seal excluded)
        jae drv_audit_seal_mix_done;

        mov r10, r8;
        shl r10, 3;
        add r10, rsi;
        mov r10, [r10 + 0];                  // field value

        xor rax, r10;
        imul rax, r9;

        mov r10, rax;
        shl rax, 29;
        shr r10, 35;
        or  rax, r10;                        // rotl(h, 29)

        add r8, 1;
        jmp drv_audit_seal_mix_loop;

      drv_audit_seal_mix_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_emit(event, kind, subject, principal, outcome) -> ()
  //
  //   rdi = DRV_AUDIT_EV_*
  //   rsi = capability kind (0 for handoff)
  //   rdx = subject   (cap slot, or driver slot for handoff)
  //   rcx = principal (parent cap slot / the slot itself / from-state)
  //   r8  = outcome   (0 = success, else the primitive's error code)
  //
  // Called from INSIDE the mint / revoke / handoff primitives — never
  // from a call site (§5.1). Appends one record, seals it, and advances
  // the counter.
  //
  // Returns nothing and cannot fail. That is a deliberate narrowing of
  // the interface (§4.4): a status here would be a status callers could
  // ignore, and an emitter that can be made to fail is an emitter that
  // can be suppressed.
  //
  // Note the argument list: five arguments, none of which is provenance.
  // See §3.2 / §7 — that absence is the D1.c parity mechanism, not an
  // oversight.
  // ============================================================================

  pub let drv_audit_emit : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (event: u64, kind: u64, subject: u64, principal: u64,
        outcome: u64) -> unsafe {
      effects: {sysreg, mem}, capabilities: {},
      justification: "R29.M6-002 (#1041): append one sealed record. Five-push prologue (rbx, r12-r15): at entry rsp%16 == 8 and five pushes bring it to 0, which SysV requires at each of the two nested calls (kread_tsc, drv_audit_seal_mix). rbx=event, r12=kind, r13=subject, r14=principal, r15=outcome — all five must survive kread_tsc. The timestamp is parked in _drv_audit_last_ts rather than a sixth callee-save register, which also gives safectl a cheap read of the last event time. Slot: idx = seq & 127, base = ring + (idx << 6); seven qword stores for fields 0..6, then the seal. The record base is recomputed after the seal_mix call rather than held, because r10/r11 are caller-save and the callee clobbers both. Ordering is load-bearing: fields 0..6 are written BEFORE seal_mix reads them, and _drv_audit_seq is advanced LAST so a reader that interleaves never sees a slot counted before it is sealed. Writes only this module's storage; capabilities {} by design (§4.4). Labels prefixed drv_audit_emit_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                            // 5 pushes -> rsp%16 = 0

        mov rbx, rdi;                        // event
        mov r12, rsi;                        // kind
        mov r13, rdx;                        // subject
        mov r14, rcx;                        // principal
        mov r15, r8;                         // outcome

        // ---- When ----
        call kread_tsc;
        lea r10, [rip + _drv_audit_last_ts];
        mov [r10 + 0], rax;

        // ---- Slot: base = ring + ((seq & 127) << 6) ----
        lea r10, [rip + _drv_audit_seq];
        mov r11, [r10 + 0];                  // r11 = seq
        mov r10, r11;
        and r10, 127;                        // DRV_AUDIT_RING_MASK
        shl r10, 6;                          // * DRV_AUDIT_RECORD_BYTES
        lea rax, [rip + _drv_audit_ring];
        add rax, r10;
        mov r10, rax;                        // r10 = record base

        mov [r10 + 0],  r11;                 // field 0: seq
        mov [r10 + 8],  rbx;                 // field 1: event
        mov [r10 + 16], r12;                 // field 2: kind
        mov [r10 + 24], r13;                 // field 3: subject
        mov [r10 + 32], r14;                 // field 4: principal
        mov [r10 + 40], r15;                 // field 5: outcome

        lea rax, [rip + _drv_audit_last_ts];
        mov rax, [rax + 0];
        mov [r10 + 48], rax;                 // field 6: ts

        // ---- Seal the record against the running chain head ----
        lea rax, [rip + _drv_audit_seal_head];
        mov rdi, [rax + 0];                  // prev_seal
        mov rsi, r10;                        // record base
        call drv_audit_seal_mix;             // rax = seal(n)

        // Recompute the base: r10/r11 are caller-save and the call
        // clobbered both.
        lea r10, [rip + _drv_audit_seq];
        mov r11, [r10 + 0];
        and r11, 127;
        shl r11, 6;
        lea r10, [rip + _drv_audit_ring];
        add r10, r11;

        mov [r10 + 56], rax;                 // field 7: seal
        lea r10, [rip + _drv_audit_seal_head];
        mov [r10 + 0], rax;

        // ---- Advance the monotonic counter LAST ----
        lea r10, [rip + _drv_audit_seq];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // Readers. audit_supervisor's surface; also what the boot witness and
  // safectl use.
  // ============================================================================

  pub let drv_audit_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): read the boot-monotonic event counter — the number of records ever emitted, not the number retained. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _drv_audit_seq];
        mov rax, [rax + 0];
        ret
      }
    } @no_frame

  pub let drv_audit_seal_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): read the running seal chain head. rip-relative lea then one qword load. Leaf; no callee-save writes; no nested calls.",
      block: {
        lea rax, [rip + _drv_audit_seal_head];
        mov rax, [rax + 0];
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_retained() -> u64
  //
  //   -> rax = min(seq, DRV_AUDIT_RECORDS)
  //
  // How many records the ring still holds. Paired with drv_audit_seq()
  // this tells a reader exactly how many records the wrap forgot (§4.2)
  // — a ring that silently forgets how much it forgot is not an audit
  // surface.
  // ============================================================================

  pub let drv_audit_retained : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): min(seq, 128). Load seq, compare against DRV_AUDIT_RECORDS, clamp. Branch spelled with jae/jmp only. Leaf; no callee-save writes; no nested calls. Labels prefixed drv_audit_retained_ per reserved-label discipline.",
      block: {
        lea rax, [rip + _drv_audit_seq];
        mov rax, [rax + 0];
        cmp rax, 128;                        // DRV_AUDIT_RECORDS
        jae drv_audit_retained_clamp;
        ret;

      drv_audit_retained_clamp:
        mov rax, 128;
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_rec_base(back: u64) -> u64
  //
  //   rdi = 0 for the newest record, 1 for the one before it, ...
  //   -> rax = the record's base address, or 0 when the request names a
  //            record that does not exist.
  //
  // The `back >= seq` bound matters as much as `back >= 128`: without
  // it, a query for record 5 after two events would read a slot that has
  // never been written and report it as history.
  // ============================================================================

  pub let drv_audit_rec_base : (u64) -> u64 !{mem} @{} =
    fn (back: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): bounds-checked record address. Two guards precede all address arithmetic — back < 128 (ring depth) and back < seq (records actually written) — so no unwritten slot and no byte past the 8192-byte object is ever addressed. idx = (seq - 1 - back) & 127; byte offset = idx << 6. r10 is caller-save scratch; no prologue needed. Read-only. Leaf; no nested calls. Labels prefixed drv_audit_rec_base_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _drv_audit_seq];
        mov r10, [r10 + 0];

        cmp r10, 0;
        je  drv_audit_rec_base_zero;
        cmp rdi, 128;                        // DRV_AUDIT_RECORDS
        jae drv_audit_rec_base_zero;
        cmp rdi, r10;
        jae drv_audit_rec_base_zero;         // further back than history

        sub r10, 1;
        sub r10, rdi;
        and r10, 127;                        // DRV_AUDIT_RING_MASK
        shl r10, 6;                          // * DRV_AUDIT_RECORD_BYTES

        lea rax, [rip + _drv_audit_ring];
        add rax, r10;
        ret;

      drv_audit_rec_base_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_field(back: u64, field: u64) -> u64
  //
  //   -> rax = the field value, or 0 for an out-of-range record or field.
  //
  // Inlines the record-address arithmetic rather than calling
  // drv_audit_rec_base, so the reader stays a leaf with no stack
  // discipline at all — the same shape blob_audit_field uses.
  // ============================================================================

  pub let drv_audit_field : (u64, u64) -> u64 !{mem} @{} =
    fn (back: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): bounds-checked read into the audit ring. Three guards precede all address arithmetic — field < 8, back < 128, back < seq — so neither an unwritten slot nor a byte past the 8192-byte object is read. idx = (seq - 1 - back) & 127; byte offset = idx << 6 plus field << 3. r10/r11 are caller-save scratch. Read-only. Leaf; no nested calls. Labels prefixed drv_audit_field_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _drv_audit_seq];
        mov r10, [r10 + 0];

        cmp r10, 0;
        je  drv_audit_field_zero;
        cmp rsi, 8;                          // DRV_AUDIT_FIELDS
        jae drv_audit_field_zero;
        cmp rdi, 128;                        // DRV_AUDIT_RECORDS
        jae drv_audit_field_zero;
        cmp rdi, r10;
        jae drv_audit_field_zero;

        sub r10, 1;
        sub r10, rdi;
        and r10, 127;                        // DRV_AUDIT_RING_MASK
        shl r10, 6;

        mov rax, rsi;
        shl rax, 3;                          // field * 8
        add r10, rax;

        lea r11, [rip + _drv_audit_ring];
        add r11, r10;
        mov rax, [r11 + 0];
        ret;

      drv_audit_field_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_gap_check() -> u64
  //
  //   -> rax = DRV_AUDIT_OK (0), or DRV_AUDIT_ERR_GAP.
  //
  // The gap-detection rule of §4.2, verbatim: the record at
  // back-distance d must carry seq == head - 1 - d, for every d in
  // [0, retained).
  //
  // This is what converts "the stream looks plausible" into "the stream
  // is intact". Deleting a retained record shifts every later record's
  // position relative to its stored seq; overwriting one with a
  // plausible-looking record leaves its stored seq wrong for the slot it
  // now occupies. Both trip on the first offending d.
  //
  // Wrap is not a gap: the walk covers only the retained window, and the
  // distance between drv_audit_seq() and drv_audit_retained() is the
  // reader's account of what the ring dropped.
  // ============================================================================

  pub let drv_audit_gap_check : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): walk the retained window and assert each record's stored seq matches its position. r9 = head (seq), r8 = retained = min(head,128) computed inline with jae/jmp only, rcx = cursor d, r10/r11 = address and expected-seq scratch. An empty stream is vacuously gap-free and returns OK before any address arithmetic. All registers touched are caller-save; leaf, no nested calls, so no prologue. Read-only. Labels prefixed drv_audit_gap_ per reserved-label discipline.",
      block: {
        lea r9, [rip + _drv_audit_seq];
        mov r9, [r9 + 0];                    // head
        cmp r9, 0;
        je  drv_audit_gap_ok;                // empty stream: vacuously intact

        mov r8, r9;                          // retained = min(head, 128)
        cmp r9, 128;
        jb  drv_audit_gap_have;
        mov r8, 128;

      drv_audit_gap_have:
        xor rcx, rcx;                        // d = 0

      drv_audit_gap_loop:
        cmp rcx, r8;
        jae drv_audit_gap_ok;

        // expected = head - 1 - d
        mov r11, r9;
        sub r11, 1;
        sub r11, rcx;

        // base = ring + ((expected & 127) << 6)
        mov r10, r11;
        and r10, 127;
        shl r10, 6;
        lea rax, [rip + _drv_audit_ring];
        add rax, r10;

        mov rax, [rax + 0];                  // stored seq
        cmp rax, r11;
        jne drv_audit_gap_bad;

        add rcx, 1;
        jmp drv_audit_gap_loop;

      drv_audit_gap_ok:
        xor rax, rax;                        // DRV_AUDIT_OK
        ret;

      drv_audit_gap_bad:
        mov rax, 0xFFFFFFC7;                 // DRV_AUDIT_ERR_GAP
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_seal_check() -> u64
  //
  //   -> rax = DRV_AUDIT_OK (0), or DRV_AUDIT_ERR_SEAL.
  //
  // Recomputes the chain across the retained window and compares each
  // record's stored seal against it. Verification covers
  // [oldest+1, head]: the oldest retained record's predecessor has been
  // dropped by the wrap, so its seal has nothing to chain from. That
  // boundary is stated rather than papered over — closing it needs the
  // chain head persisted at wrap (design doc §9).
  //
  // Walks from the oldest verifiable record forward (d descending) so
  // the first reported failure is the EARLIEST corruption, not the
  // latest one it cascaded into.
  // ============================================================================

  pub let drv_audit_seal_check : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-001 (#1040): recompute the hash chain across the retained window. Five-push prologue (rbx, r12-r15): entry rsp%16 == 8, five pushes -> 0, satisfying SysV at the drv_audit_seal_mix call inside the loop. rbx = head, r12 = cursor d, r13 = retained, r14 = base of record d, r15 unused-but-pushed to keep the alignment arithmetic (and the pop sequence) uniform with drv_audit_emit. Per iteration: prev = record(d+1).seal, expected = drv_audit_seal_mix(prev, base(d)), compare to record(d).seal. Fewer than two retained records means nothing is chainable and OK is returned before any arithmetic. Read-only apart from the stack. Labels prefixed drv_audit_seal_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                            // 5 pushes -> rsp%16 = 0

        lea rbx, [rip + _drv_audit_seq];
        mov rbx, [rbx + 0];                  // head
        cmp rbx, 2;
        jb  drv_audit_seal_ok;               // nothing chainable

        mov r13, rbx;                        // retained = min(head, 128)
        cmp rbx, 128;
        jb  drv_audit_seal_have;
        mov r13, 128;

      drv_audit_seal_have:
        mov r12, r13;
        sub r12, 2;                          // d = retained - 2 (oldest verifiable)

      drv_audit_seal_loop:
        // base(d) = ring + (((head - 1 - d) & 127) << 6)
        mov r10, rbx;
        sub r10, 1;
        sub r10, r12;
        and r10, 127;
        shl r10, 6;
        lea r14, [rip + _drv_audit_ring];
        add r14, r10;                        // r14 = base(d)

        // prev seal = record(d+1).seal
        mov r10, rbx;
        sub r10, 1;
        sub r10, r12;
        sub r10, 1;                          // head - 1 - (d+1)
        and r10, 127;
        shl r10, 6;
        lea r11, [rip + _drv_audit_ring];
        add r11, r10;
        mov rdi, [r11 + 56];                 // prev seal

        mov rsi, r14;
        call drv_audit_seal_mix;             // rax = expected seal(d)

        mov r10, [r14 + 56];                 // stored seal(d)
        cmp rax, r10;
        jne drv_audit_seal_bad;

        cmp r12, 0;
        je  drv_audit_seal_ok;
        sub r12, 1;
        jmp drv_audit_seal_loop;

      drv_audit_seal_ok:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        xor rax, rax;                        // DRV_AUDIT_OK
        ret;

      drv_audit_seal_bad:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        mov rax, 0xFFFFFFC6;                 // DRV_AUDIT_ERR_SEAL
        ret
      }
    }

  // ============================================================================
  // drv_audit_window_ok(from_seq: u64) -> u64
  //
  //   -> rax = 1 iff the retained window still covers from_seq, else 0.
  //
  // The precondition every "since" query needs. A balance computed over
  // a window that has already dropped part of the range it claims to
  // cover is not a small error — it is a confident wrong answer, which
  // is the failure mode an audit tool must never have.
  // ============================================================================

  pub let drv_audit_window_ok : (u64) -> u64 !{mem} @{} =
    fn (from_seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-003 (#1042): from_seq must lie in [head - retained, head]. Load head, clamp retained to 128 with jb/jmp, compute oldest = head - retained, then two bounds. from_seq == head is accepted (an empty but well-defined range). Leaf; caller-save scratch only; no nested calls. Labels prefixed drv_audit_window_ per reserved-label discipline.",
      block: {
        lea r9, [rip + _drv_audit_seq];
        mov r9, [r9 + 0];                    // head

        cmp rdi, r9;
        ja  drv_audit_window_no;             // from the future

        mov r8, r9;                          // retained = min(head, 128)
        cmp r9, 128;
        jb  drv_audit_window_have;
        mov r8, 128;

      drv_audit_window_have:
        mov r10, r9;
        sub r10, r8;                         // oldest retained seq
        cmp rdi, r10;
        jb  drv_audit_window_no;

        mov rax, 1;
        ret;

      drv_audit_window_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_balance_since(kind: u64, from_seq: u64) -> u64
  //
  //   -> rax = (successful mints) - (successful revokes) of `kind` over
  //            records with seq >= from_seq, as a two's-complement value.
  //
  // Only outcome == 0 records count. A refused mint created no
  // descriptor, so counting it would make the balance disagree with the
  // live descriptor count by exactly the number of refusals — which is
  // to say, it would make the reconciliation report a leak every time
  // the supervisor was correctly told no.
  //
  // Records are visited newest-first and seq descends monotonically with
  // d, so the walk STOPS at the first record older than from_seq rather
  // than scanning the whole ring.
  // ============================================================================

  pub let drv_audit_balance_since : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64, from_seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-003 (#1042): signed mint/revoke balance for one kind over the retained suffix [from_seq, head). r9 = head, r8 = retained clamped to 128, rcx = cursor d, rax = accumulator, r10/r11 = record base and field scratch. Per record: stop if stored seq < from_seq (seq descends with d, so the first such record ends the walk); skip if kind mismatches or outcome != 0; then +1 for EV_MINT, -1 for EV_REVOKE and no change for anything else. Accumulator is two's complement, so a net-negative balance is representable and reconciles correctly under wrapping addition. Leaf; caller-save scratch only; no nested calls; read-only. Labels prefixed drv_audit_bal_ per reserved-label discipline.",
      block: {
        lea r9, [rip + _drv_audit_seq];
        mov r9, [r9 + 0];                    // head

        xor rax, rax;                        // accumulator
        cmp r9, 0;
        je  drv_audit_bal_done;

        mov r8, r9;                          // retained = min(head, 128)
        cmp r9, 128;
        jb  drv_audit_bal_have;
        mov r8, 128;

      drv_audit_bal_have:
        xor rcx, rcx;                        // d = 0

      drv_audit_bal_loop:
        cmp rcx, r8;
        jae drv_audit_bal_done;

        // base = ring + (((head - 1 - d) & 127) << 6)
        mov r10, r9;
        sub r10, 1;
        sub r10, rcx;
        and r10, 127;
        shl r10, 6;
        lea r11, [rip + _drv_audit_ring];
        add r11, r10;                        // r11 = record base

        mov r10, [r11 + 0];                  // stored seq
        cmp r10, rsi;
        jb  drv_audit_bal_done;              // older than from_seq: stop

        mov r10, [r11 + 16];                 // kind
        cmp r10, rdi;
        jne drv_audit_bal_next;

        mov r10, [r11 + 40];                 // outcome
        cmp r10, 0;
        jne drv_audit_bal_next;              // refusals do not move the balance

        mov r10, [r11 + 8];                  // event
        cmp r10, 1;                          // DRV_AUDIT_EV_MINT
        jne drv_audit_bal_not_mint;
        add rax, 1;
        jmp drv_audit_bal_next;

      drv_audit_bal_not_mint:
        cmp r10, 2;                          // DRV_AUDIT_EV_REVOKE
        jne drv_audit_bal_next;
        sub rax, 1;

      drv_audit_bal_next:
        add rcx, 1;
        jmp drv_audit_bal_loop;

      drv_audit_bal_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_live_count(kind: u64) -> u64
  //
  //   -> rax = number of live cap_table descriptors of that kind.
  //
  // The STATE-derived half of the reconciliation. Deriving it by
  // scanning cap_table — a different substrate from the audit ring — is
  // the entire point: a check that read the audit stream twice would
  // agree with itself regardless of what the descriptors actually say.
  //
  // O(256) with a 24-byte stride, matching the cascade walkers in
  // kind_hw_msix_vector.pdx and kind_dma_domain.pdx.
  // ============================================================================

  pub let drv_audit_live_count : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-003 (#1042): count live cap_table descriptors of one kind. Iterate slot 0..255; descriptor base = cap_table + slot*24 computed as (slot<<3) + (slot<<4) exactly as the existing cascade walkers do; load kind at [+0] and increment on an exact match. rcx = slot cursor, rax = count, r9/r10/r11 = address scratch — all caller-save, so leaf with no prologue. Read-only. Labels prefixed drv_audit_live_ per reserved-label discipline.",
      block: {
        xor rax, rax;                        // count
        xor rcx, rcx;                        // slot

      drv_audit_live_loop:
        cmp rcx, 256;
        jae drv_audit_live_done;

        mov r9, cap_table;
        mov r10, rcx;
        shl r10, 3;
        mov r11, rcx;
        shl r11, 4;
        add r10, r11;                        // slot * 24
        add r9, r10;

        mov r10, [r9 + 0];                   // kind
        cmp r10, rdi;
        jne drv_audit_live_next;
        add rax, 1;

      drv_audit_live_next:
        add rcx, 1;
        jmp drv_audit_live_loop;

      drv_audit_live_done:
        ret
      }
    } @no_frame

  // ============================================================================
  // drv_audit_reconcile(kind, from_seq, base_live) -> u64
  //
  //   rdi = capability kind
  //   rsi = the seq sampled when base_live was sampled
  //   rdx = the live descriptor count at that moment
  //   -> rax = DRV_AUDIT_OK, DRV_AUDIT_ERR_WINDOWED, or
  //            DRV_AUDIT_ERR_MISMATCH.
  //
  // The monotone descriptor-count check of #1042. Asserts
  //
  //   base_live + balance_since(kind, from_seq) == live_count(kind)
  //
  // i.e. that the audit stream's account of what was created and
  // destroyed matches the descriptors that actually exist.
  //
  // The two failures are kept distinct because they call for opposite
  // responses:
  //
  //   WINDOWED — the harness cannot answer: from_seq predates the
  //              retained window, so the balance would be computed over
  //              a truncated history. Reporting inability beats
  //              returning a confident wrong number.
  //   MISMATCH — the harness answered and the answer is no. Either a
  //              descriptor moved without a record (an emission gap) or
  //              a record claims a descriptor that is not there (a leak,
  //              or a cascade that freed rows without revoking
  //              descriptors — precisely the bug shape a per-child
  //              cascade emission (§5.2) exists to make visible).
  // ============================================================================

  pub let drv_audit_reconcile : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64, from_seq: u64, base_live: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R29.M6-003 (#1042): reconcile the audit-derived balance against the state-derived live count. Five-push prologue (rbx, r12-r15): entry rsp%16 == 8, five pushes -> 0 for the three nested calls (drv_audit_window_ok, drv_audit_balance_since, drv_audit_live_count). r12 = kind, r13 = from_seq, r14 = base_live, rbx = balance carried across the live_count call; r15 pushed for alignment uniformity. Window check runs FIRST so a truncated history is reported as WINDOWED rather than silently producing a wrong balance. The comparison is base_live + balance == live_count in wrapping u64 arithmetic, which is correct for a negative balance because both sides wrap identically. Read-only apart from the stack. Labels prefixed drv_audit_rec_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;                            // 5 pushes -> rsp%16 = 0

        mov r12, rdi;                        // kind
        mov r13, rsi;                        // from_seq
        mov r14, rdx;                        // base_live

        mov rdi, r13;
        call drv_audit_window_ok;
        cmp rax, 0;
        je  drv_audit_rec_windowed;

        mov rdi, r12;
        mov rsi, r13;
        call drv_audit_balance_since;        // rax = signed balance
        mov rbx, rax;

        mov rdi, r12;
        call drv_audit_live_count;           // rax = live descriptors

        add rbx, r14;                        // base_live + balance
        cmp rbx, rax;
        jne drv_audit_rec_mismatch;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        xor rax, rax;                        // DRV_AUDIT_OK
        ret;

      drv_audit_rec_windowed:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        mov rax, 0xFFFFFFC5;                 // DRV_AUDIT_ERR_WINDOWED
        ret;

      drv_audit_rec_mismatch:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        mov rax, 0xFFFFFFC4;                 // DRV_AUDIT_ERR_MISMATCH
        ret
      }
    }
}
