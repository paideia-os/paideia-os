// src/kernel/core/driver/lifecycle_schema.pdx — R29.M2-005 (#1027)
//
// driver_lifecycle_channel schema constants. Request/reply RPC from
// the userspace driver-lifecycle-supervisor to a driver process,
// commanding one of six FSM transitions defined in
// src/kernel/core/driver/lifecycle.pdx: start / init_done / suspend /
// resume / handoff_begin / stop.
//
// Design context
// --------------
// Per design/ipc/driver-lifecycle-schema.md and design/roadmap/next-
// wave-softarch.md §3 R29, `driver_lifecycle_channel : Channel(
// DriverLifecycleSchema)` maps 1:1 onto the FSM edges the R29.M2-001
// primitives (driver_lifecycle_transition + transition_valid) enforce.
// This module publishes the authoritative wire-format constants that
// every future encoder / decoder / dispatcher MUST match byte-for-byte.
//
// Scope of this landing (schema constants only)
// ---------------------------------------------
// Framing (8-byte header) lives in src/kernel/core/ipc/frame.pdx.
// Per-payload packers and the driver-side dispatch loop land with the
// R30 canonical example driver (lpss_uart). This module is the seam
// every future component links against; every ack the supervisor
// consumes with rc==DRV_LC_ACK_OK MUST correlate with a kernel-side
// `driver_lifecycle_transition` returning DRIVER_LIFECYCLE_OK, so the
// R29.M2-004 fuzz witness (this same landing wave) exercises the
// kernel half of the coupling directly against these constants.

module LifecycleSchema = structure {

  // ============================================================================
  // Schema version — appears in every request's frame header byte 1.
  // v1 is the initial landing. Version bumps trail actual field
  // additions per the "version monotonicity" invariant in design §6.
  // ============================================================================

  pub let DRV_LC_SCHEMA_VERSION           : u64 = 1

  // ============================================================================
  // Opcodes (v1). Match design doc §3 exactly.
  //
  // Every opcode maps 1:1 onto an FSM edge from
  // src/kernel/core/driver/lifecycle.pdx (see DRIVER_LIFECYCLE_TABLE
  // = 0x00000020101A1C02). Replies flip bit 7 per FRAME_OP_REPLY_BIT
  // in src/kernel/core/ipc/frame.pdx.
  // ============================================================================

  pub let DRV_LC_OP_START                 : u64 = 0x01
  pub let DRV_LC_OP_INIT_DONE             : u64 = 0x02
  pub let DRV_LC_OP_SUSPEND               : u64 = 0x03
  pub let DRV_LC_OP_RESUME                : u64 = 0x04
  pub let DRV_LC_OP_HANDOFF_BEGIN         : u64 = 0x05
  pub let DRV_LC_OP_STOP                  : u64 = 0x06

  // Reply-bit sentinel (mirror of FRAME_OP_REPLY_BIT); exposed so
  // dispatchers can name the bit rather than hard-code 0x80.
  pub let DRV_LC_OP_REPLY_BIT             : u64 = 0x80

  // Reply opcodes are (request_op | 0x80). Named here for the six
  // canonical edges so dispatch tables can branch by symbol.
  pub let DRV_LC_OP_START_REPLY           : u64 = 0x81
  pub let DRV_LC_OP_INIT_DONE_REPLY       : u64 = 0x82
  pub let DRV_LC_OP_SUSPEND_REPLY         : u64 = 0x83
  pub let DRV_LC_OP_RESUME_REPLY          : u64 = 0x84
  pub let DRV_LC_OP_HANDOFF_BEGIN_REPLY   : u64 = 0x85
  pub let DRV_LC_OP_STOP_REPLY            : u64 = 0x86

  // ============================================================================
  // Record sizes (bytes). Match design doc §4 exactly; every future
  // encoder MUST emit exactly this many bytes for the corresponding op.
  // ============================================================================

  pub let DRV_LC_SIZEOF_START_REQ         : u64 = 24
  pub let DRV_LC_SIZEOF_INIT_DONE_REQ     : u64 = 8
  pub let DRV_LC_SIZEOF_SUSPEND_REQ       : u64 = 16
  pub let DRV_LC_SIZEOF_RESUME_REQ        : u64 = 8
  pub let DRV_LC_SIZEOF_HANDOFF_BEGIN_REQ : u64 = 16
  pub let DRV_LC_SIZEOF_STOP_REQ          : u64 = 8
  pub let DRV_LC_SIZEOF_ACK_REP           : u64 = 8

  // ============================================================================
  // DrvLcStartReq field offsets (24 bytes = three u64s).
  //   [+0]  driver_slot   : u16   slot in _driver_table (0..31)
  //   [+2]  reserved0     : u16
  //   [+4]  flags         : u32   bit 0 = restart_from_snapshot
  //   [+8]  caps_manifest : u64   kernel VA of the manifest region
  //   [+16] timeout_ns    : u64   INIT_DONE deadline; 0 = none
  // ============================================================================

  pub let DRV_LC_START_OFF_SLOT           : u64 = 0
  pub let DRV_LC_START_OFF_FLAGS          : u64 = 4
  pub let DRV_LC_START_OFF_CAPS_MANIFEST  : u64 = 8
  pub let DRV_LC_START_OFF_TIMEOUT_NS     : u64 = 16
  pub let DRV_LC_START_FLAG_FROM_SNAPSHOT : u64 = 0x1

  // ============================================================================
  // DrvLcInitDoneReq field offsets (8 bytes = one u64).
  //   [+0]  driver_slot : u16   echo of start's slot
  //   [+2]  reserved0   : u16
  //   [+4]  init_flags  : u32   bit 0 = wants_msix
  // ============================================================================

  pub let DRV_LC_INIT_DONE_OFF_SLOT       : u64 = 0
  pub let DRV_LC_INIT_DONE_OFF_FLAGS      : u64 = 4
  pub let DRV_LC_INIT_DONE_FLAG_WANTS_MSIX: u64 = 0x1

  // ============================================================================
  // DrvLcSuspendReq field offsets (16 bytes = two u64s).
  //   [+0]  driver_slot : u16
  //   [+2]  power_state : u8    ACPI D-state (0..4)
  //   [+3]  reserved0   : u8
  //   [+4]  reserved1   : u32
  //   [+8]  timeout_ns  : u64   suspend-quiescence deadline; 0 = none
  // ============================================================================

  pub let DRV_LC_SUSPEND_OFF_SLOT         : u64 = 0
  pub let DRV_LC_SUSPEND_OFF_POWER_STATE  : u64 = 2
  pub let DRV_LC_SUSPEND_OFF_TIMEOUT_NS   : u64 = 8

  // ACPI D-state values (mirrored here so callers do not need to import
  // from a future acpi/power module before it lands).
  pub let DRV_LC_D_STATE_D0               : u64 = 0
  pub let DRV_LC_D_STATE_D1               : u64 = 1
  pub let DRV_LC_D_STATE_D2               : u64 = 2
  pub let DRV_LC_D_STATE_D3_HOT           : u64 = 3
  pub let DRV_LC_D_STATE_D3_COLD          : u64 = 4

  // ============================================================================
  // DrvLcResumeReq field offsets (8 bytes = one u64).
  //   [+0]  driver_slot : u16
  //   [+2]  reserved0   : u16
  //   [+4]  resume_hint : u32   bit 0 = expedited (skip probe re-scan)
  // ============================================================================

  pub let DRV_LC_RESUME_OFF_SLOT          : u64 = 0
  pub let DRV_LC_RESUME_OFF_HINT          : u64 = 4
  pub let DRV_LC_RESUME_HINT_EXPEDITED    : u64 = 0x1

  // ============================================================================
  // DrvLcHandoffBeginReq field offsets (16 bytes = two u64s).
  //   [+0]  driver_slot   : u16
  //   [+2]  reserved0     : u16
  //   [+4]  reserved1     : u32
  //   [+8]  snapshot_cap  : u64   Cap<KIND_MEMORY> for state serialization
  // ============================================================================

  pub let DRV_LC_HANDOFF_OFF_SLOT         : u64 = 0
  pub let DRV_LC_HANDOFF_OFF_SNAPSHOT_CAP : u64 = 8

  // ============================================================================
  // DrvLcStopReq field offsets (8 bytes = one u64).
  //   [+0]  driver_slot : u16
  //   [+2]  reason      : u8    see DRV_LC_STOP_REASON_*
  //   [+3]  reserved0   : u8
  //   [+4]  grace_ms    : u32   force-reap deadline in milliseconds
  // ============================================================================

  pub let DRV_LC_STOP_OFF_SLOT            : u64 = 0
  pub let DRV_LC_STOP_OFF_REASON          : u64 = 2
  pub let DRV_LC_STOP_OFF_GRACE_MS        : u64 = 4

  pub let DRV_LC_STOP_REASON_PLANNED      : u64 = 0
  pub let DRV_LC_STOP_REASON_CRASH_REPL   : u64 = 1
  pub let DRV_LC_STOP_REASON_DEV_DEPARTED : u64 = 2
  pub let DRV_LC_STOP_REASON_POLICY       : u64 = 3

  // ============================================================================
  // DrvLcAckRep field offsets (8 bytes = one u64).
  //   [+0]  driver_slot : u16   echo of request slot for correlation
  //   [+2]  reserved0   : u16
  //   [+4]  rc          : u32   0 = OK; else DRV_LC_ACK_ERR_*
  // ============================================================================

  pub let DRV_LC_ACK_OFF_SLOT             : u64 = 0
  pub let DRV_LC_ACK_OFF_RC               : u64 = 4

  // ============================================================================
  // Ack error codes.
  //
  // ERR_BAD_SLOT / ERR_INVALID_TRANSITION mirror
  // DRIVER_LIFECYCLE_ERR_BAD_SLOT (0xFFFFFF01) /
  // DRIVER_LIFECYCLE_ERR_INVALID_TRANSITION (0xFFFFFF03) returned by
  // driver_lifecycle_transition — but compacted to small u32 values
  // so a wire ack fits in the 8-byte DrvLcAckRep record.
  //
  // The R29.M2-004 fuzz witness enforces the kernel half of this
  // coupling: every valid (cur, new) pair the FSM whitelist admits
  // MUST be one for which the future supervisor sees DRV_LC_ACK_OK,
  // and every rejected pair MUST see one of the ERR codes below.
  // ============================================================================

  pub let DRV_LC_ACK_OK                   : u64 = 0
  pub let DRV_LC_ACK_ERR_BAD_SLOT         : u64 = 1
  pub let DRV_LC_ACK_ERR_INVALID_TRANS    : u64 = 2
  pub let DRV_LC_ACK_ERR_TIMEOUT          : u64 = 3
  pub let DRV_LC_ACK_ERR_DEVICE_GONE      : u64 = 4
  pub let DRV_LC_ACK_ERR_CAP_MISSING      : u64 = 5
  pub let DRV_LC_ACK_ERR_INTERNAL         : u64 = 6
}
