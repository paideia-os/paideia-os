// src/kernel/core/driver/hotplug_schema.pdx — R29.M2-003 (#1025)
//
// driver_hotplug_channel schema constants. Session-typed stream from a
// bus driver (PCI enumerator, xHCI hub monitor, LPSS bus driver, ...)
// to the userspace driver-loader process. Two event types in v1:
// device_arrived (carrying a Cap<KIND_DEVICE>) and device_departed.
//
// Design context
// --------------
// Per design/ipc/driver-hotplug-schema.md and design/roadmap/next-wave-
// softarch.md §3 R29, `driver_hotplug_channel : Channel(HotplugSchema)`
// is one of three schemas R29 introduces. This module publishes the
// authoritative wire-format constants that every future encoder /
// decoder / dispatcher MUST match byte-for-byte.
//
// Scope of this landing (schema constants only)
// ---------------------------------------------
// Framing (8-byte header) lives in src/kernel/core/ipc/frame.pdx.
// Per-payload packers land with R29.M3 registry v2 once the sender
// (bus driver) and receiver (driver loader) processes exist. This
// module is the constants seam every future component links against.

module HotplugSchema = structure {

  // ============================================================================
  // Schema version — appears in every request's frame header byte 1.
  // v1 is the initial landing. R29.M3 registry v2 remains on v1;
  // schema-version bumps trail actual field additions per the
  // "version monotonicity" invariant in the design doc §6.
  // ============================================================================

  pub let DRV_HP_SCHEMA_VERSION       : u64 = 1

  // ============================================================================
  // Opcodes (v1). Match design doc §3 exactly.
  //
  // Reply-bit range (0x80..0xFF) is unused for this stream — the
  // channel is fire-and-forget. Any op with bit 7 set is a schema
  // violation and MUST be rejected by the receiver.
  // ============================================================================

  pub let DRV_HP_OP_DEVICE_ARRIVED    : u64 = 0x01
  pub let DRV_HP_OP_DEVICE_DEPARTED   : u64 = 0x02

  // Reserved reply-bit sentinel — for symmetry with lifecycle_schema.pdx.
  // Never set on this channel; exposed so linters / dispatchers can
  // gate `op & DRV_HP_OP_REPLY_BIT != 0 -> reject`.
  pub let DRV_HP_OP_REPLY_BIT         : u64 = 0x80

  // ============================================================================
  // Record sizes (bytes). Match design doc §4 exactly; every future
  // encoder MUST emit exactly this many bytes for the corresponding op.
  // ============================================================================

  pub let DRV_HP_SIZEOF_ARRIVED       : u64 = 24
  pub let DRV_HP_SIZEOF_DEPARTED      : u64 = 8

  // ============================================================================
  // DrvHpArrivedReq field offsets (bytes, from record base).
  //
  // Row layout (24 bytes = three u64s in kernel-VA scratch):
  //   [+0]  bdf         : u16   (bus:8, dev:5, fn:3)
  //   [+2]  reserved0   : u16   MUST be 0
  //   [+4]  vendor_id   : u16
  //   [+6]  device_id   : u16
  //   [+8]  class_code  : u32   (class << 16 | subclass << 8 | prog_if)
  //   [+12] reserved1   : u32   MUST be 0
  //   [+16] device_cap  : u64   cap slot of a Cap<KIND_DEVICE> minted
  //                              by the sender against the loader's
  //                              cap table (out-of-band cap-transfer;
  //                              sender revokes on error).
  // ============================================================================

  pub let DRV_HP_ARRIVED_OFF_BDF          : u64 = 0
  pub let DRV_HP_ARRIVED_OFF_VENDOR       : u64 = 4
  pub let DRV_HP_ARRIVED_OFF_DEVICE       : u64 = 6
  pub let DRV_HP_ARRIVED_OFF_CLASS_CODE   : u64 = 8
  pub let DRV_HP_ARRIVED_OFF_DEVICE_CAP   : u64 = 16

  // ============================================================================
  // DrvHpDepartedReq field offsets (bytes, from record base).
  //
  // Row layout (8 bytes = one u64):
  //   [+0]  bdf         : u16
  //   [+2]  reserved0   : u16   MUST be 0
  //   [+4]  reason      : u32   see DRV_HP_DEPART_REASON_*
  // ============================================================================

  pub let DRV_HP_DEPARTED_OFF_BDF         : u64 = 0
  pub let DRV_HP_DEPARTED_OFF_REASON      : u64 = 4

  // ============================================================================
  // Departure reason codes. Loader treats unknown values as
  // DRV_HP_DEPART_REASON_SURPRISE — the pessimistic assumption that
  // pending I/O is guaranteed lost.
  // ============================================================================

  pub let DRV_HP_DEPART_REASON_GRACEFUL   : u64 = 0
  pub let DRV_HP_DEPART_REASON_SURPRISE   : u64 = 1
  pub let DRV_HP_DEPART_REASON_BUS_RESET  : u64 = 2
  pub let DRV_HP_DEPART_REASON_PROBE_REJ  : u64 = 3
}
