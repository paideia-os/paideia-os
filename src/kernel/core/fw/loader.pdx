// src/kernel/core/fw/loader.pdx -- R111.M6-024 (paideia-os #2376)
//                                   + R111.M6-023 (paideia-os #2375)
//                                     signed-hash-chain wire
//
// Kernel-side firmware manifest loader.  Parses the M6-022 manifest
// staged into boot_env @ +120/+128 by uefi_stub.pdx's
// efi_load_fw_manifest, verifies its whole-manifest Ed25519 signature
// (R111.M6-023 seam -- src/kernel/core/fw/manifest_sig.pdx), verifies
// each entry's per-blob SHA against the entry's truncated fingerprint,
// and dispatches each entry to the matching per-kind loader landed
// earlier in the M6 sub-wave:
//
//   kind=1 (microcode) -> core/cpu/microcode.pdx (R111.M6-019
//                         microcode_load_and_apply -- SDM Vol 3A
//                         section 9.11 WRMSR path).
//   kind=2 (GuC)       -> core/drivers/gpu/guc_verify.pdx (R37.M2-001
//                         gucv_verify -- dual-signature admission gate;
//                         the WOPCM staging half in guc_load.pdx is
//                         deferred until gmmio_bind + WOPCM alloc land).
//   kind=3 (HuC)       -> core/drivers/gpu/huc_load.pdx (R37.M8-001
//                         hucl_verify_vendor + hucl_verify_paideia --
//                         structural sig checks; the WOPCM staging
//                         inside hucl_load requires gmmio_bind==1 which
//                         is not established at this early boot stage).
//
// =============================================================================
// SCOPE -- what this milestone opens and what stays deferred
// =============================================================================
//
// R111.M6-024 lands the PARSE + DISPATCH backbone that ties the
// R111.M6-022 manifest carry to the M6-019/R37.M2/R37.M8 per-kind
// loaders.  Concretely:
//
//   * Manifest binary format (fw_manifest_t: 16-byte header + N x 32B
//     entries + 64-byte Ed25519 signature trailer) is frozen HERE.
//     mkimage.sh (R111.M7-025) is the sole producer; every consumer
//     (this loader, fw/manifest_sig.pdx's signature verifier, the
//     future in-kernel SHA-256 verifier) reads it via the offsets
//     published as `pub let` constants below.  The R111.M6-023
//     landing grew the on-wire schema by 64 bytes (sig trailer);
//     R111.M6-024's original layout was `16 + N*32` bytes (no
//     trailer), retired here.
//
//   * Whole-manifest signature verify runs the R111.M6-023 seam
//     fw_manifest_verify_signature (src/kernel/core/fw/manifest_sig.pdx)
//     BEFORE the per-entry dispatch loop.  On VERIFY FAIL the loader
//     emits `FW MANIFEST SIG FAIL reason=<dec>` and RETURNS 0 without
//     dispatching a single entry -- the "manifest sig FAIL -> skip ALL
//     entries" policy from issue #2375's requirements.  On VERIFY OK
//     it emits `FW MANIFEST SIG OK` and proceeds into the loop.  At
//     R111.M6-023 the sig-verify body is a dev-bypass accepting iff
//     the 64-byte trailer is all zero (see manifest_sig.pdx header
//     for the R32/R82 real-ed25519_verify drop-in path).
//
//   * Per-entry SHA-256 verify runs against the entry's 20-byte
//     truncated fingerprint via fw_manifest_sha256_verify (renamed
//     from the R111.M6-024 stub -- see the function's justification
//     for the dev-bypass semantics vs. the R32 real SHA256 drop-in).
//     The real in-kernel SHA-256 primitive lands under
//     KIND_HASH_SESSION (R32 wave-2); the seam is a call to a well-
//     named function that a later landing can bind to a live verifier
//     without touching the loader's dispatch loop.
//
//   * GuC / HuC WOPCM staging (gucl_load, hucl_load) stays deferred
//     because both require gmmio_is_bound == 1 (a live BAR window
//     handed in by an Iris Xe PCI probe) which R111.M6-024 does not
//     land.  The dispatch arms call the STRUCTURAL sig verifiers
//     (gucv_verify / hucl_verify_vendor + hucl_verify_paideia) --
//     enough to prove the loader picks the correct arm per kind AND
//     that the blob bytes actually reached the sig-slot offsets --
//     and defer the "kick WOPCM DMA + poll HUC_ACCEPTED" write chain
//     to whichever milestone lands the Iris Xe probe.
//
//   * The microcode arm calls microcode_load_and_apply (which DOES
//     issue the real WRMSR pair).  On QEMU-TCG the apply lands on the
//     APPLY_FAILED skip arm (rdmsr 0x8B EDX stays 0 -- no functional
//     apply path in TCG); on real T14 G4 silicon it should succeed
//     and emit MICROCODE APPLY OK per SDM section 9.11.7.  In either
//     case the loader wraps the outcome with a FW LOAD OK/SKIP line
//     tagging the entry by kind + size so the wire log carries a
//     normalized "one line per manifest entry" trail regardless of
//     which per-kind loader emitted its own subsystem-specific
//     fingerprint underneath.
//
// =============================================================================
// MANIFEST BINARY FORMAT (fw_manifest_t)
// =============================================================================
//
// Header (16 B, u32 fields, natural alignment):
//
//   Offset  Size  Field           Notes
//   ----------------------------------------------------------------------
//   +0      4     magic           u32 0x464D4450 (bytes 'P','D','M','F'
//                                     read as little-endian u32 per SDM
//                                     Vol 2A §3.4.1.1). Producers (M7-025
//                                     mkimage.sh) MUST emit bytes P,D,M,F
//                                     in that order — do NOT reverse.
//   +4      4     version         u32 1 (this milestone).  Bumped in a
//                                 later landing that changes the entry
//                                 layout; the loader refuses any value
//                                 != 1 with reason=BAD_VERSION.
//   +8      4     entry_count     u32 N.  Zero is legal (empty manifest;
//                                 loader returns 0 with no FW LOAD OK
//                                 emissions -- a legitimate "operator
//                                 shipped a manifest with no firmware
//                                 payloads" outcome).  IMPORTANT (R111
//                                 .M6-023, paideia-os #2422 CVE fix):
//                                 even for count==0, the whole-manifest
//                                 Ed25519 signature is STILL verified
//                                 (gate 5.5 below).  An empty unsigned
//                                 manifest is REJECTED with FW MANIFEST
//                                 SIG FAIL reason=2 + FW LOAD SKIP
//                                 kind=0 reason=10, identical to the
//                                 count>0 sig-fail shape; only the
//                                 per-entry dispatch loop is skipped on
//                                 count==0 (the FW MANIFEST SIG OK line
//                                 is still emitted on VERIFY PASS).
//                                 See fwl_load_count's inline SECURITY
//                                 NOTE for the pre-fix vulnerable shape
//                                 (`cmp rbx, 0; je fwl_done_zero`) that
//                                 short-circuited past both gate 5 and
//                                 gate 5.5.
//   +12     4     reserved        u32; must be 0 in v1 headers.  Not
//                                 gated on this milestone (a future
//                                 milestone MAY re-purpose it as a
//                                 flags word); documented so mkimage.sh
//                                 zero-fills it.
//
// Signature trailer (64 B, unaligned relative to entries):
//
//   Offset (from manifest_pa)         Size    Field
//   ---------------------------------------------------------------
//   +16 + N * 32                      64      Ed25519 signature over
//                                             bytes [0, +16 + N * 32).
//                                             At R111.M6-023 the
//                                             verifier is a dev-
//                                             bypass accepting iff
//                                             all 64 bytes are zero;
//                                             the R32/R82 real
//                                             ed25519_verify drop-in
//                                             consumes the same
//                                             layout unchanged.  See
//                                             src/kernel/core/fw/
//                                             manifest_sig.pdx.
//
// Entry (32 B, natural alignment, entries begin at +16):
//
//   Offset  Size  Field           Notes
//   ----------------------------------------------------------------------
//   +0      4     kind            u32 per FW_KIND_* constants below.
//                                 Unknown kinds skip with reason=6.
//   +4      4     offset          u32; blob start relative to the
//                                 manifest_pa base (i.e. the blob body
//                                 lives INSIDE the same pool alloc that
//                                 carries the header + entry table).
//                                 The loader gates offset + size <=
//                                 manifest_size before dereferencing so
//                                 a bogus entry cannot walk off the end
//                                 of the pool alloc.
//   +8      4     size            u32 blob length in bytes.
//   +12     20    sha256[20]      Truncated SHA-256 fingerprint (leading
//                                 20 bytes of the SHA-256 hash of the
//                                 blob body).  Per-issue spec (#2376);
//                                 rationale: a 20-byte tag matches the
//                                 32-byte-total entry-record size and
//                                 gives the manifest a 2^160 collision
//                                 space which is more than enough for
//                                 "did the operator swap files under
//                                 the manifest" detection.  Verified by
//                                 fw_manifest_sha256_verify (R111.M6-023
//                                 rename + real 20-byte compare vs.
//                                 a stubbed all-zero hash; dev-bypass
//                                 accepts iff entry.sha256 is all-zero.
//                                 Real primitive lands under
//                                 KIND_HASH_SESSION per R32 wave-2).
//
// =============================================================================
// FINGERPRINTS
// =============================================================================
//
//   OK   arm : `FW LOAD OK kind=<dec> size=<dec> ver=0x<hex>`
//              via klog_s1_d2_x1 (k_kind + k_size decimal, k_ver hex).
//              `ver` semantics: for kind=1 (microcode) it is the
//              post-apply revision returned by microcode_load_and_apply
//              (Intel-documented as a hex literal, e.g. 0x000000C6);
//              for kind=2/3 (GuC/HuC) it is 0 in this milestone (the
//              structural verifiers don't return a version).  KV order
//              (kind, size, ver) matches the klog_s1_d2_x1 signature
//              (2 decimal keys precede the hex key) rather than the
//              parent-issue narrative order (kind, ver, size); the
//              wrappers.pdx repertoire does not yet mint a
//              klog_s1_d1_x1_d1 wrapper, and re-ordering is
//              information-preserving.
//
//   SKIP arm : `FW LOAD SKIP kind=<dec> reason=<dec>`
//              via klog_s1_d2.  On per-entry failures kind is the
//              specific entry's kind; on manifest-level failures
//              (null pa, too small, bad magic, bad version, count
//              overflow) kind is 0.  Reason encoding:
//
//        1 = FW_SKIP_NULL_MANIFEST       manifest_pa == 0
//        2 = FW_SKIP_MANIFEST_TOO_SMALL  manifest_size < 16
//        3 = FW_SKIP_BAD_MAGIC           header magic != 0x464D4450
//        4 = FW_SKIP_BAD_VERSION         header version != 1
//        5 = FW_SKIP_COUNT_OVERFLOW      16 + count*32 + 64 > manifest_size
//                                        (also asserts room for the
//                                        R111.M6-023 Ed25519 sig
//                                        trailer -- see manifest_sig.
//                                        pdx FW_MANIFEST_SIG_BYTES).
//        6 = FW_SKIP_UNKNOWN_KIND        entry kind not in {1,2,3}
//        7 = FW_SKIP_ENTRY_OOB           offset+size > manifest_size - 64
//                                        (offset+size must not spill
//                                        into the sig trailer).
//        8 = FW_SKIP_SHA_MISMATCH        per-entry SHA verify failed
//        9 = FW_SKIP_LOADER_FAILED       per-kind loader returned error
//       10 = FW_SKIP_SIG_FAIL            whole-manifest sig verify
//                                        failed (kind=0; also carries
//                                        the sibling `FW MANIFEST SIG
//                                        FAIL reason=<dec>` line with
//                                        the fw_manifest_verify_
//                                        signature's specific reason
//                                        code -- see manifest_sig.pdx
//                                        FW_SIG_FAIL_*).  Emits the
//                                        SKIP so a golden pin sees a
//                                        single line-shape for "no
//                                        entries dispatched" across
//                                        all failure classes.
//
// R111.M6-023 SIGNATURE FINGERPRINT PAIR
// --------------------------------------
//
//   SIG_OK   arm : `FW MANIFEST SIG OK`
//                  via klog_s1 (no KV).  Emitted exactly once per
//                  boot on the happy path, immediately before the
//                  entry-dispatch loop begins.  Carries the OK
//                  token; the sibling allowlist entry in
//                  tools/verify-fingerprint-coverage.sh sits under
//                  the same wire-deferred posture as FW MANIFEST OK
//                  / FW LOAD OK / MICROCODE APPLY OK -- the
//                  R111.M7-025 mkimage.sh + an OVMF smoke mode +
//                  either real T14 G4 or a fidelity-upgraded QEMU
//                  are the four dependencies retire this line from
//                  the allowlist.
//
//   SIG_FAIL arm : `FW MANIFEST SIG FAIL reason=<dec>`
//                  via klog_s1_d1.  Reason = FW_SIG_FAIL_* from
//                  manifest_sig.pdx (1 = SIZE_TOO_SMALL, 2 = VERIFY).
//                  Followed by the umbrella `FW LOAD SKIP kind=0
//                  reason=10` (FW_SKIP_SIG_FAIL) so the SKIP-shape
//                  coverage taxonomy above stays complete.  No OK
//                  token -> not gate-visible in verify-fingerprint-
//                  coverage.sh.
//
// The OK arm carries the "FW LOAD OK" token so verify-fingerprint-
// coverage.sh requires the sibling allowlist entry (added at this
// landing under the same wire-deferred posture as MICROCODE APPLY OK
// / FW MANIFEST OK -- the manifest itself is a UEFI-only surface and
// mkimage.sh has not landed yet, so there is no live producer for the
// bytes this loader consumes).  The SKIP arm carries no OK token so
// the coverage extractor ignores it.
//
// =============================================================================
// REGISTER + ALIGNMENT LEDGER
// =============================================================================
//
// Caller convention: firmware_load_all_from_manifest is invoked from
// kernel_main_64's body via a bare `call` at rsp%16 == 8 body-wide,
// so entry rsp%16 == 0 (call pushed the 8-byte return address on top
// of a body at parity 8).  The entry `push rbp` (r30_platform_run
// pattern -- see witness/r30_platform.pdx L14-L27 for the load-bearing
// rationale) brings rsp%16 to 8; the four subsequent callee-save
// pushes (rbx, r12, r13, r14) preserve parity 8 (each push toggles by
// 8; four pushes toggle by 32 = 2 * 16 = 0 mod 16).  Body-wide
// rsp%16 == 8.
//
// Register plan (firmware_load_all_from_manifest):
//   rbp = frame pointer (parity-restoration push at entry, matches
//         r30_platform_run's discipline).
//   rbx = entry_count (survives across every per-entry loader call).
//   r12 = manifest_pa (survives; base for entry_pa computation and
//         blob_pa computation).
//   r13 = manifest_size (survives; bounds check operand).
//   r14 = loop index i in [0, entry_count) (survives).
//
// Every direct call to a helper from a top-level (manifest-level) skip
// arm is bracketed by an explicit `sub rsp, 8` / `add rsp, 8` pad so
// the callee sees rsp%16 == 8 at entry.  Loop-body calls (SHA verify,
// microcode/guc/huc dispatch, fwl_emit_ok, fwl_emit_skip) are
// bracketed by three per-iteration stack stores (kind, size, blob_pa
// at [rsp+16], [rsp+8], [rsp+0]) which reach rsp%16 == 0 pre-call
// without additional padding, and the corresponding `add rsp, 24`
// unwinds them symmetrically.
//
// Helper functions (fwl_emit_ok, fwl_emit_skip) assume standard SysV
// convention: entry rsp%16 == 8, all their internal klog calls
// bracketed by the count of stack args each klog wrapper's caller
// convention requires (klog_s1_d2 = 1 stack arg = 1 push before call;
// klog_s1_d2_x1 = 3 stack args = 3 pushes before call).
//
// =============================================================================
// ENCODER PITFALLS OBSERVED (per issue #2376 pitfall list)
// =============================================================================
//
//   * No `test rN, rN` -- every zero-check is `cmp rN, 0`.
//   * No 2-op `imul r, imm` -- entry stride 32 is `shl rax, 5`; blob
//     offset is a plain `add`.
//   * No `and reg, imm64` -- u32 loads use `mov <32-bit alias>, [mem]`
//     which zero-extends into the 64-bit register per SDM Vol 2A
//     section 3.4.1.1, matching the tlb_shootdown.pdx L138 idiom.
//   * No `cmp reg, [mem]` -- every memory read lands in a register
//     first, matching the microcode.pdx L138+ discipline.
//
// =============================================================================
// LABEL DISCIPLINE
// =============================================================================
//
// Local labels prefixed `fwl_` (main body), `fwlok_` (emit_ok helper),
// `fwlsk_` (emit_skip helper), `fwlsh_` (sha stub).  Grep audit
// 2026-09-07: none of these prefixes hit anywhere else in src/kernel/.

module Loader = structure {

  // ==========================================================================
  // Manifest schema constants (see file-header MANIFEST BINARY FORMAT).
  // ==========================================================================

  pub let FW_MANIFEST_MAGIC      : u64 = 0x464D4450      // bytes 'P','D','M','F' little-endian
  pub let FW_MANIFEST_VERSION_1  : u64 = 1
  pub let FW_MANIFEST_HDR_SIZE   : u64 = 16
  pub let FW_MANIFEST_ENTRY_SIZE : u64 = 32

  // R111.M6-023 sig trailer size mirror; canonical source is
  // manifest_sig.pdx FW_MANIFEST_SIG_BYTES.  Restated here because
  // the loader body's own count-overflow gate hardcodes the literal
  // 64 as an immediate rather than loading a module-scoped `let X :
  // u64 = imm` binding (paideia-as v0.22+ lacks a proven idiom for
  // that -- see pdxfs_lite/verify.pdx L44+ narrative).  Restated as a
  // documented mirror so a future encoder-idiom landing can retire
  // the two-source-of-truth pattern without a header edit.
  pub let FW_MANIFEST_SIG_TRAILER_SIZE : u64 = 64

  // Header field offsets.
  pub let FW_HDR_OFF_MAGIC       : u64 = 0
  pub let FW_HDR_OFF_VERSION     : u64 = 4
  pub let FW_HDR_OFF_COUNT       : u64 = 8
  pub let FW_HDR_OFF_RESERVED    : u64 = 12

  // Entry field offsets (relative to entry start).
  pub let FW_ENT_OFF_KIND        : u64 = 0
  pub let FW_ENT_OFF_OFFSET      : u64 = 4
  pub let FW_ENT_OFF_SIZE        : u64 = 8
  pub let FW_ENT_OFF_SHA256      : u64 = 12   // 20 bytes of truncated SHA-256

  // Firmware kinds.
  pub let FW_KIND_MICROCODE      : u64 = 1
  pub let FW_KIND_GUC            : u64 = 2
  pub let FW_KIND_HUC            : u64 = 3

  // Skip reason codes -- see file-header FINGERPRINTS narrative.
  pub let FW_SKIP_NULL_MANIFEST      : u64 = 1
  pub let FW_SKIP_MANIFEST_TOO_SMALL : u64 = 2
  pub let FW_SKIP_BAD_MAGIC          : u64 = 3
  pub let FW_SKIP_BAD_VERSION        : u64 = 4
  pub let FW_SKIP_COUNT_OVERFLOW     : u64 = 5
  pub let FW_SKIP_UNKNOWN_KIND       : u64 = 6
  pub let FW_SKIP_ENTRY_OOB          : u64 = 7
  pub let FW_SKIP_SHA_MISMATCH       : u64 = 8
  pub let FW_SKIP_LOADER_FAILED      : u64 = 9

  // R111.M6-023 (paideia-os #2375) whole-manifest sig verify failure.
  // Kind is always 0 on this SKIP arm (manifest-level failure).  The
  // sibling `FW MANIFEST SIG FAIL reason=<dec>` line (emitted by
  // fwl_emit_sig_fail) carries the specific FW_SIG_FAIL_* sub-reason
  // from manifest_sig.pdx.
  pub let FW_SKIP_SIG_FAIL           : u64 = 10

  // ==========================================================================
  // Fingerprint tags
  //
  // OK tag:   "FW LOAD OK\0"    -- 10 chars + NUL = 11 bytes.
  //   Carries the OK token; verify-fingerprint-coverage.sh requires
  //   the sibling allowlist entry (added at this landing under the
  //   same wire-deferred posture as MICROCODE APPLY OK / FW MANIFEST
  //   OK -- the manifest is a UEFI-only surface and mkimage.sh has
  //   not landed yet, so there is no live producer for the bytes
  //   this loader consumes).
  //
  // SKIP tag: "FW LOAD SKIP\0"  -- 12 chars + NUL = 13 bytes.
  //   No OK token -> invisible to the coverage extractor; the SKIP
  //   arm on the FW_SKIP_NULL_MANIFEST branch (kind=0 reason=1) is
  //   the marker a future -kernel-matrix golden could pin if we ever
  //   wire an unconditional call site.  M6-024 gates the call at
  //   kernel_main so the -kernel matrix stays silent on all FW LOAD
  //   lines; the FW MANIFEST NONE line (R111.M6-022) is the golden
  //   pin for "manifest not present" on that matrix.
  // ==========================================================================

  pub let tag_fw_load_ok   : [u8; 11] = "FW LOAD OK\0"
  pub let tag_fw_load_skip : [u8; 13] = "FW LOAD SKIP\0"

  // R111.M6-023 sig-verify fingerprint pair (see file header FINGERPRINTS
  // section under "R111.M6-023 SIGNATURE FINGERPRINT PAIR").
  //
  // SIG_OK tag:  "FW MANIFEST SIG OK\0"   -- 18 chars + NUL = 19 bytes.
  //   Carries the OK token; sibling allowlist entry lands in
  //   tools/verify-fingerprint-coverage.sh under the same wire-
  //   deferred posture as FW MANIFEST OK / FW LOAD OK / MICROCODE
  //   APPLY OK -- no live manifest producer until R111.M7-025
  //   mkimage.sh ships, and no OVMF smoke mode consumes it until
  //   R111.M2 opens boot_r111_uefi_bridge.
  //
  // SIG_FAIL tag: "FW MANIFEST SIG FAIL\0" -- 20 chars + NUL = 21 bytes.
  //   No OK token -> invisible to the coverage extractor.  Emitted
  //   with a k_reason KV via klog_s1_d1 (see fwl_emit_sig_fail).
  pub let tag_fw_manifest_sig_ok   : [u8; 19] = "FW MANIFEST SIG OK\0"
  pub let tag_fw_manifest_sig_fail : [u8; 21] = "FW MANIFEST SIG FAIL\0"

  // ==========================================================================
  // fw_manifest_sha256_verify(blob_pa, blob_size, sha_ptr) -> u64
  //
  // Returns 0 on SHA MATCH, non-zero (any) on SHA MISMATCH.  The
  // R111.M6-023 (paideia-os #2375) landing renamed and grew this
  // function from the R111.M6-024 (#2376) `fw_manifest_sha256_verify_
  // stub` (which returned 0 unconditionally) to a real 20-byte compare
  // against a stubbed all-zero hash.  Dev-bypass semantics match
  // pdxfs_lite/verify.pdx's pdxfs_sb_verify_sig (R25.M5-001, #929)
  // one-for-one: accept iff the on-manifest 20-byte SHA field is
  // bytewise all zero, reject on any non-zero byte.
  //
  // Two-source-of-truth burden retired when the real R32 in-kernel
  // SHA-256 primitive (KIND_HASH_SESSION per design/security/pq-trust-
  // root.md §0.2) lands: at that point the body gets a leading
  //     sha256(blob_pa, blob_size, scratch_32B);
  //     compare scratch_32B[0..20] against [sha_ptr+0..20];
  //     return 0 on match, non-zero on mismatch.
  // and the dev-bypass path drops in the same commit -- caller-side
  // ABI unchanged.
  //
  // Signature: (blob_pa: u64, blob_size: u64, sha_ptr: u64) -> u64
  //   blob_pa    -- PA of the blob body inside the manifest pool alloc.
  //                 ABI-reserved (UNUSED under dev-bypass); the real
  //                 sha256 primitive consumes this as the hash-input
  //                 base pointer.
  //   blob_size  -- length in bytes of the blob body.  ABI-reserved
  //                 (UNUSED under dev-bypass); the real primitive
  //                 consumes this as the hash-input length.
  //   sha_ptr    -- PA of the 20-byte truncated SHA-256 fingerprint
  //                 recorded in the manifest entry at [entry_pa + 12]
  //                 (FW_ENT_OFF_SHA256).  Read as 2 qwords + 1 dword
  //                 = 20 bytes; OR'd into an accumulator to detect
  //                 non-zero.
  //   returns 0  -- SHA MATCH (all 20 bytes of the entry.sha256 field
  //                 are zero -> dev-bypass accept).
  //   returns 1  -- SHA MISMATCH (any non-zero byte in the 20-byte
  //                 entry.sha256 field -> reject).
  //
  // Register plan (leaf; no callee-save touched):
  //   r10 = sha_ptr (base)
  //   r11 = accumulator (OR of the 20 bytes read as 2 qwords + 1 dword)
  //   rax = per-load scratch + final return
  //
  // Encoder posture: no test rN,rN (all cmp reg, 0), no 2-op imul
  // r,imm (no multiply), no and reg,imm64 (no bitmasking; the trailing
  // 4 bytes read via `mov eax, [mem]` which zero-extends into rax per
  // SDM Vol 2A §3.4.1.1), no cmp reg,[mem] (each load staged through
  // rax before the OR).
  //
  // Labels prefixed fwlsh_.
  // ==========================================================================

  pub let fw_manifest_sha256_verify : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (blob_pa: u64) (blob_size: u64) (sha_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R111.M6-023 (paideia-os #2375) rename + real-compare rebuild of the R111.M6-024 (#2376) fw_manifest_sha256_verify_stub. Dev-bypass real 20-byte compare against a stubbed all-zero hash: accept iff the 20-byte entry.sha256 field at sha_ptr is bytewise all zero, reject on any non-zero byte. Matches pdxfs_lite/verify.pdx's pdxfs_sb_verify_sig (R25.M5-001, #929) precedent one-for-one, rescaled from a 3400-byte ML-DSA-65 sig field to a 20-byte truncated SHA-256 fingerprint (2 qwords + 1 dword). When the real R32 in-kernel SHA-256 primitive lands (KIND_HASH_SESSION wave-2 per design/security/pq-trust-root.md §0.2), the body flips to (a) call sha256(blob_pa, blob_size, scratch_32B), (b) compare scratch_32B[0..20] against [sha_ptr+0..20] qword-by-qword + dword tail, (c) return 0 on match, non-zero on mismatch. blob_pa / blob_size are ABI-reserved (unused under dev-bypass) so the caller-side ABI stays unchanged across the drop-in -- mirrors pdxfs_sb_verify_sig's own reserved-but-unused pubkey_pa arg (see that file's L142). Register plan: r10 = sha_ptr, r11 = 20-byte OR accumulator, rax = per-load scratch + return. Leaf: rax/r10/r11 all SysV caller-save, no prologue. Body: (1) r10 = rdx (sha_ptr). (2) xor r11, r11 -- accumulator = 0. (3) rax = [r10+0] (qword 0 of the 20-byte SHA field); or r11, rax. (4) rax = [r10+8] (qword 1); or r11, rax. (5) eax = [r10+16] (dword tail = bytes [16..20], zero-extends into rax per SDM Vol 2A §3.4.1.1); or r11, rax. (6) cmp r11, 0; jne fwlsh_fail. (7) xor eax, eax; ret. fwlsh_fail: mov rax, 1; ret. The `1` return is the umbrella mismatch sentinel; the real primitive will encode a specific error class here without a caller-side change (the loader's gate 7 is `cmp rax, 0; je dispatch`, treating any non-zero as SHA mismatch reason=8). Encoder posture: no test rN,rN (cmp reg, 0), no 2-op imul r,imm (no multiply), no and reg,imm64 (dword tail read via zero-extending mov, not masked), no cmp reg,[mem] (loads staged through rax first). Labels prefixed fwlsh_ (grep audit 2026-09-07: no fwlsh_ hits elsewhere in src/kernel/).",
      block: {
        // (1) r10 = sha_ptr.
        mov r10, rdx;

        // (2) accumulator = 0.
        xor r11, r11;

        // (3) qword 0 of the 20-byte SHA field.
        mov rax, [r10 + 0];
        or  r11, rax;

        // (4) qword 1.
        mov rax, [r10 + 8];
        or  r11, rax;

        // (5) dword tail (bytes [16..20]); `mov eax, [mem]` zero-
        //     extends into rax per SDM Vol 2A §3.4.1.1, matching the
        //     tlb_shootdown.pdx L138 idiom.
        mov eax, [r10 + 16];
        or  r11, rax;

        // (6) Non-zero accumulator -> at least one non-zero byte in
        //     the 20-byte SHA field -> reject.
        cmp r11, 0;
        jne fwlsh_fail;

        // (7) All-zero SHA field -> dev-bypass accept.
        xor rax, rax;
        ret;

      fwlsh_fail:
        mov rax, 1;                                // umbrella SHA mismatch
        ret
      }
    }

  // ==========================================================================
  // fwl_emit_skip(kind, reason) -> ()
  //
  // Emits `FW LOAD SKIP kind=<dec> reason=<dec>` via klog_s1_d2.
  // Broken out of the main body so each SKIP arm (10 total: 5 manifest-
  // level + 5 per-entry) does not have to inline the 7-line klog
  // marshalling recipe.
  //
  // Args: rdi = kind (u64, 0 on manifest-level failures), rsi = reason.
  //
  // Alignment: entry rsp%16 == 8 (standard SysV callee entry after the
  // caller's `call` pushed the return address into a body at parity 0).
  // The single `push rsi` (staging the 7th arg for klog_s1_d2's [rbp+16]
  // slot) brings rsp%16 to 0 pre-call.  klog_s1_d2 sees rsp%16 == 8 at
  // entry (its own `push rbp` immediately toggles to 0 before its
  // sub rsp, 48 -- see klog/wrappers.pdx L266+).
  //
  // Labels prefixed fwlsk_.
  // ==========================================================================

  pub let fwl_emit_skip : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (kind: u64) (reason: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M6-024 (paideia-os #2376): FW LOAD SKIP fingerprint emitter. Wraps klog_s1_d2 with the fw-loader-specific tag (tag_fw_load_skip) and key set (k_kind decimal, k_reason decimal). Called from the main body's SKIP arms (5 manifest-level + 5 per-entry = 10 sites total); factored out so the body carries a `mov rdi/rsi; sub 8; call; add 8; jmp done` triplet per SKIP arm rather than a 7-line inline marshalling recipe. Args: rdi = kind (0 on manifest-level failures per file-header FINGERPRINTS narrative), rsi = reason (1..9 per the FW_SKIP_* constant table). No return value. Alignment: entry rsp%16==8, one `push rsi` reaches rsp%16==0 for the klog call. Encoder: no test rN,rN (no zero-checks needed -- the caller has already committed to emitting a SKIP), no 2-op imul r,imm (no arithmetic), no and reg,imm64, no cmp reg,[mem]. Labels prefixed fwlsk_ (grep audit 2026-09-07: no fwlsk_ elsewhere in src/kernel/).",
      block: {
        push rsi;                                  // [rbp+16] = reason (v2)
        mov r8, rdi;                               // v1 = kind
        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_fw_load_skip];
        lea rcx, [rip + k_kind];                   // k1 (dec)
        lea r9, [rip + k_reason];                  // k2 (dec)
        call klog_s1_d2;
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // fwl_emit_ok(kind, ver, size) -> ()
  //
  // Emits `FW LOAD OK kind=<dec> size=<dec> ver=0x<hex>` via
  // klog_s1_d2_x1.  KV order (kind, size, ver) matches the wrapper's
  // 2-dec + 1-hex signature; the file-header FINGERPRINTS narrative
  // documents why re-ordering is preferable to minting a new
  // klog_s1_d1_x1_d1 wrapper for this one call site.
  //
  // Args: rdi = kind, rsi = ver, rdx = size.
  //
  // Alignment: entry rsp%16 == 8.  klog_s1_d2_x1 takes 3 caller-side
  // stack args (vx, kx, vd2 in reverse push order), so 3 pushes bring
  // rsp%16 to 0 pre-call.
  //
  // Labels prefixed fwlok_.
  // ==========================================================================

  pub let fwl_emit_ok : (u64, u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (kind: u64) (ver: u64) (size: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M6-024 (paideia-os #2376): FW LOAD OK fingerprint emitter. Wraps klog_s1_d2_x1 with the fw-loader-specific tag (tag_fw_load_ok) and key set (k_kind decimal, k_size decimal, k_ver hex). Called from the main body's OK arm once per successfully-dispatched manifest entry (3 sites -- one per FW_KIND_* dispatch arm). Args: rdi = kind (1/2/3 per the FW_KIND_* constant table), rsi = ver (post-apply revision for kind=1 microcode, 0 for kind=2/3 GuC/HuC in this milestone), rdx = size (blob body length in bytes). No return value. KV order: klog_s1_d2_x1 signature is (kd1, vd1, kd2, vd2, kx, vx) so we render `kind=<dec> size=<dec> ver=0x<hex>` -- deliberate re-ordering from the parent-issue narrative order (kind, ver, size) because the wrappers.pdx repertoire has no klog_s1_d1_x1_d1 (dec+hex+dec) shape, and information-preserving re-ordering is the R111.M6-024 scope-appropriate answer (a follow-up minting wrapper landing could restore the narrative order if the KV ledger tools ever require positional stability). Push order (reverse-of-callee-frame): push vx (ver, becomes [rbp+32]), push k_ver (kx, becomes [rbp+24]), push size (vd2, becomes [rbp+16]) -- see klog/wrappers.pdx L540+ for the wrapper's own frame layout. 3 pushes bring rsp%16 from 8 to 0 pre-call. Encoder: no test rN,rN, no 2-op imul r,imm, no and reg,imm64, no cmp reg,[mem]. Labels prefixed fwlok_ (grep audit 2026-09-07: no fwlok_ elsewhere in src/kernel/).",
      block: {
        // Stage the 3 klog stack args in reverse call-frame order.
        // Wrapper reads [rbp+16]=vd2 (=size), [rbp+24]=kx (=&k_ver),
        // [rbp+32]=vx (=ver).  Caller pushes vx first (deepest), then
        // kx, then vd2 (topmost) so post-call-frame layout matches.
        push rsi;                                  // [rbp+32] = ver (vx)
        lea r10, [rip + k_ver];
        push r10;                                  // [rbp+24] = &k_ver (kx)
        push rdx;                                  // [rbp+16] = size (vd2)

        mov r8, rdi;                               // v1 = kind
        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_fw_load_ok];
        lea rcx, [rip + k_kind];                   // k1 (dec)
        lea r9, [rip + k_size];                    // k2 (dec)
        call klog_s1_d2_x1;
        add rsp, 24;
        ret
      }
    }

  // ==========================================================================
  // fwl_emit_sig_ok() -> ()
  //
  // Emits `FW MANIFEST SIG OK` via klog_s1 (no KV entries).  Called
  // exactly once per boot on the happy path, immediately BEFORE
  // firmware_load_all_from_manifest enters its entry-dispatch loop
  // (see gate 5.5 in the main body).
  //
  // Args: none.
  //
  // Alignment: entry rsp%16 == 8 (standard SysV callee entry after
  // the caller's `call` pushed the return address into a body at
  // parity 0).  klog_s1 has no push rbp (see wrappers.pdx L20+), so
  // it needs entry rsp%16 == 8 (SysV standard).  Body rsp is already
  // at parity 8, so a `sub rsp, 8` pad brings rsp to parity 0 pre-
  // call; the call pushes 8 bytes of return address, giving klog_s1
  // entry rsp%16 == 8.  A matching `add rsp, 8` unwinds.
  //
  // Labels prefixed fwlsigok_ (grep audit 2026-09-07: no fwlsigok_
  // elsewhere in src/kernel/).
  // ==========================================================================

  pub let fwl_emit_sig_ok : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M6-023 (paideia-os #2375): FW MANIFEST SIG OK fingerprint emitter. Wraps klog_s1 with the R111.M6-023-specific tag (tag_fw_manifest_sig_ok) and no KV entries. Called exactly once per boot on the happy path, immediately before firmware_load_all_from_manifest enters its entry-dispatch loop (see gate 5.5 in the main body). No args, no return value. Alignment: entry rsp%16==8, sub rsp, 8 -> rsp%16==0 pre-call, call klog_s1 (which sees rsp%16==8 at its own entry per SysV standard; klog_s1 has no push rbp -- see wrappers.pdx L20+), add rsp, 8 -> rsp%16==8, ret. Encoder posture per issue #2375 pitfall list: no test rN,rN (no zero-checks needed -- caller has already committed to emitting the OK line), no 2-op imul r,imm (no arithmetic), no and reg,imm64, no cmp reg,[mem]. Labels prefixed fwlsigok_.",
      block: {
        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_fw_manifest_sig_ok];
        sub rsp, 8;                                // pad -> rsp%16==0
        call klog_s1;
        add rsp, 8;                                // -> rsp%16==8
        ret
      }
    }

  // ==========================================================================
  // fwl_emit_sig_fail(reason) -> ()
  //
  // Emits `FW MANIFEST SIG FAIL reason=<dec>` via klog_s1_d1.  Called
  // exactly once per boot on the sig-verify failure path, immediately
  // before firmware_load_all_from_manifest short-returns 0 (skipping
  // ALL entries per issue #2375's boot policy).  A sibling `FW LOAD
  // SKIP kind=0 reason=10` line follows via fwl_emit_skip so the
  // SKIP-shape coverage taxonomy stays complete across all failure
  // classes.
  //
  // Args: rdi = reason (FW_SIG_FAIL_* from manifest_sig.pdx: 1 =
  // SIZE_TOO_SMALL, 2 = VERIFY).
  //
  // Alignment: entry rsp%16 == 8.  klog_s1_d1 takes all args in
  // registers (rdi/rsi/rdx/rcx/r8), no stack push; sub rsp, 8 pad
  // brings rsp to parity 0 pre-call, matching add rsp, 8 unwinds.
  //
  // Labels prefixed fwlsigfl_ (grep audit 2026-09-07: no fwlsigfl_
  // elsewhere in src/kernel/).
  // ==========================================================================

  pub let fwl_emit_sig_fail : (u64) -> () !{sysreg, mem} @{boot} =
    fn (reason: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M6-023 (paideia-os #2375): FW MANIFEST SIG FAIL fingerprint emitter. Wraps klog_s1_d1 with the R111.M6-023-specific tag (tag_fw_manifest_sig_fail) and a single k_reason decimal KV. Called exactly once per boot on the sig-verify failure path, immediately before firmware_load_all_from_manifest short-returns 0 (skipping ALL entries per issue #2375's `manifest sig FAIL -> skip ALL entries` policy). A sibling FW LOAD SKIP kind=0 reason=10 line follows (via fwl_emit_skip -> klog_s1_d2) so the SKIP-shape coverage taxonomy stays complete across all failure classes. Args: rdi = reason (FW_SIG_FAIL_* from manifest_sig.pdx: 1 = FW_SIG_FAIL_SIZE_TOO_SMALL, 2 = FW_SIG_FAIL_VERIFY). No return value. Alignment: entry rsp%16==8, sub rsp, 8 -> rsp%16==0 pre-call, call klog_s1_d1 (which pushes rbp itself and takes all args in registers -- see wrappers.pdx L226+), add rsp, 8 -> rsp%16==8, ret. Encoder posture per issue #2375 pitfall list: no test rN,rN (caller has already committed), no 2-op imul r,imm (no arithmetic), no and reg,imm64, no cmp reg,[mem]. Labels prefixed fwlsigfl_.",
      block: {
        mov r8, rdi;                               // v1 = reason (arg to klog_s1_d1)
        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_fw_manifest_sig_fail];
        lea rcx, [rip + k_reason];                 // k1 (dec)
        sub rsp, 8;                                // pad -> rsp%16==0
        call klog_s1_d1;
        add rsp, 8;                                // -> rsp%16==8
        ret
      }
    }

  // ==========================================================================
  // firmware_load_all_from_manifest(manifest_pa, manifest_size) -> u64
  //
  // The one public entry point of this module.  Parses the manifest
  // header at manifest_pa, iterates every entry, and dispatches per
  // kind -- see the file-header MANIFEST BINARY FORMAT and FINGERPRINTS
  // sections for the wire contract.
  //
  // Return value:
  //   0 always.  The FINGERPRINTS are the assertable datum; callers
  //   do not consume the return.  A future refinement MAY return a
  //   count of successfully-loaded entries; the return-0 convention
  //   is preserved here so kernel_main.pdx's wire is `call
  //   firmware_load_all_from_manifest;` with no post-call disposition.
  //
  // Gate order (each gate emits exactly one SKIP and returns, EXCEPT
  // per-entry gates which emit one SKIP and continue to the next
  // entry):
  //
  //   Manifest-level (return 0 on failure):
  //     (1) manifest_pa != 0                            else reason=1
  //     (2) manifest_size >= 16                         else reason=2
  //     (3) header magic == FW_MANIFEST_MAGIC           else reason=3
  //     (4) header version == 1                         else reason=4
  //     (5) 16 + count*32 + 64 <= manifest_size         else reason=5
  //         (grew by +64 in R111.M6-023 to require room
  //         for the Ed25519 sig trailer)
  //     (5.5) fw_manifest_verify_signature == 0         else reason=10
  //         + FW MANIFEST SIG FAIL reason=<FW_SIG_FAIL_*>
  //         (R111.M6-023 whole-manifest sig gate; skips
  //          ALL entries on failure).  On PASS emits
  //          FW MANIFEST SIG OK and proceeds.  Runs
  //          UNCONDITIONALLY on entry_count -- an empty
  //          (count==0) manifest is signature-verified
  //          just like any other (R111.M6-023 paideia-os
  //          #2422 CVE fix; see fwl_load_count SECURITY
  //          NOTE for the pre-fix vulnerable shape).
  //
  //   Per-entry (continue to next entry on failure):
  //     (6) entry.offset + entry.size <= manifest_size - 64  else reason=7
  //         (tightened by -64 in R111.M6-023 so a blob body
  //         cannot spill into the sig trailer's memory;
  //         gate 5 has already guaranteed manifest_size
  //         >= 16 + count*32 + 64 >= 80, so manifest_size
  //         - 64 does not underflow in u64 arithmetic).
  //     (7) fw_manifest_sha256_verify == 0              else reason=8
  //         (dev-bypass: accept iff entry.sha256 field
  //         is all-zero -- R111.M6-023 rename + real 20-
  //         byte compare, replacing the M6-024 stub that
  //         accepted everything).
  //     (8) kind in {1, 2, 3}                            else reason=6
  //     (9) per-kind loader returns 0/success            else reason=9
  //
  // On success dispatch: emit `FW LOAD OK kind=<n> size=<n> ver=0x<h>`
  // and continue to the next entry.
  //
  // Register plan:
  //   rbp = entry-frame push (parity restoration per r30_platform_run)
  //   rbx = entry_count
  //   r12 = manifest_pa
  //   r13 = manifest_size
  //   r14 = loop index i
  //
  // Stack per-iteration (loop-body only):
  //   [rsp+16] = kind (u64)
  //   [rsp+8]  = size (u64)
  //   [rsp+0]  = blob_pa (u64)
  //
  // Alignment: entry rsp%16==0 (bare-call from kernel_main body at
  // parity 8).  push rbp -> 8.  4 more pushes -> 8 (parity unchanged
  // by 4 pushes).  Body-wide rsp%16 == 8.  Manifest-level SKIP arms
  // wrap the emit call in sub rsp,8/add rsp,8.  Per-entry loop body
  // does 3 pushes -> 0 pre-call and matching add rsp,24.
  //
  // Labels prefixed fwl_.
  // ==========================================================================

  pub let firmware_load_all_from_manifest : (u64, u64) -> u64 !{sysreg, mem} @{boot} =
    fn (manifest_pa: u64) (manifest_size: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M6-024 (paideia-os #2376) + R111.M6-023 (paideia-os #2375) signed-hash-chain rebuild + R111.M6-023 (paideia-os #2422) empty-manifest sig-verify CVE fix (removed the `cmp rbx, 0; je fwl_done_zero` early-return at fwl_load_count that short-circuited past gates 5 and 5.5 whenever entry_count==0 -- see fwl_load_count's inline SECURITY NOTE for the vulnerable shape). Parses the R111.M6-022 manifest at RDI (manifest_pa, RSI=manifest_size) per the fw_manifest_t schema frozen in this file's header (16-byte header + N x 32B entries + 64-byte Ed25519 sig trailer), verifies the whole-manifest signature via fw_manifest_verify_signature (src/kernel/core/fw/manifest_sig.pdx) BEFORE the entry loop, then per-entry SHA-verifies via fw_manifest_sha256_verify and dispatches each entry to the matching per-kind loader landed earlier in the M6 sub-wave: kind=1 -> microcode_load_and_apply (R111.M6-019, SDM Vol 3A section 9.11 WRMSR path); kind=2 -> gucv_verify (R37.M2-001 dual-signature admission gate; WOPCM staging half in gucl_load is deferred until gmmio_bind + WOPCM alloc land); kind=3 -> hucl_verify_vendor + hucl_verify_paideia (R37.M8-001 structural sig checks; WOPCM staging inside hucl_load requires gmmio_is_bound==1 which is not established at this early boot stage). Emits `FW MANIFEST SIG OK` / `FW MANIFEST SIG FAIL reason=<dec>` (via fwl_emit_sig_ok / fwl_emit_sig_fail) on the whole-manifest gate, then `FW LOAD OK kind=<dec> size=<dec> ver=0x<hex>` per successful dispatch via fwl_emit_ok / klog_s1_d2_x1, or `FW LOAD SKIP kind=<dec> reason=<dec>` on any failure via fwl_emit_skip / klog_s1_d2. Gate order: (1) manifest_pa!=0 else reason=1, (2) manifest_size>=16 else reason=2, (3) magic==0x464D4450 else reason=3, (4) version==1 else reason=4, (5) 16+count*32+64<=manifest_size else reason=5 (M6-023 grew by +64 for sig trailer), (5.5) fw_manifest_verify_signature==0 else reason=10 + FW MANIFEST SIG FAIL reason=<FW_SIG_FAIL_*> (M6-023 whole-manifest sig gate; skips ALL entries on failure per issue #2375 boot policy); per-entry (6) offset+size<=manifest_size-64 else reason=7 (M6-023 tightened by -64 so a blob body cannot spill into the sig trailer's memory; gate 5 guarantees manifest_size>=80 so no u64 underflow), (7) fw_manifest_sha256_verify==0 else reason=8 (M6-023 dev-bypass real 20-byte compare; accept iff entry.sha256 all-zero, replaces M6-024 accept-everything stub), (8) kind in {1,2,3} else reason=6, (9) per-kind loader returns 0 else reason=9. Manifest-level failures return 0 with a single SKIP kind=0 (sig-fail additionally emits SIG FAIL line first); per-entry failures emit SKIP kind=<entry.kind> and continue to the next entry. Return value always 0 -- callers do not consume; fingerprints are the assertable datum. Register plan: rbp = entry-frame push (parity restoration per r30_platform_run's discipline, load-bearing because kernel_main body is at rsp%16==8 which puts callees at rsp%16==0 without the compensating push -- see witness/r30_platform.pdx L14-L27), rbx = entry_count, r12 = manifest_pa, r13 = manifest_size, r14 = loop index i. r12/r13/rbx/r14 preserved across the sig-verify call at gate 5.5 (fw_manifest_verify_signature is a leaf touching only rax/r10/r11 -- SysV callee-save honoured automatically). Per-iteration stack: [rsp+16]=kind, [rsp+8]=size, [rsp+0]=blob_pa. Alignment: entry rsp%16==0, push rbp -> 8, 4 more callee-save pushes (rbx,r12,r13,r14) -> 8 (unchanged by 4 pushes), body-wide rsp%16==8. Manifest-level SKIP arms bracket the fwl_emit_skip call in sub rsp,8/add rsp,8; gate 5.5 sub-calls (fw_manifest_verify_signature, fwl_emit_sig_ok, fwl_emit_sig_fail, fwl_emit_skip) use the same sub rsp,8/add rsp,8 pad pattern. Per-entry loop body pushes 3 locals -> rsp%16==0 pre-call for SHA verify, per-kind loader, and fwl_emit_ok/fwl_emit_skip; matching `add rsp, 24` unwinds locals before jmp fwl_loop_next. Encoder posture per issues #2376 + #2375 pitfall lists: no test rN,rN (all zero-checks cmp rN,0), no 2-op imul r,imm (entry stride 32 = shl rax,5), no and reg,imm64 (u32 loads use `mov <32bit alias>, [mem]` zero-extending idiom per SDM Vol 2A section 3.4.1.1), no cmp reg,[mem] (every mem read lands in a register first). Labels prefixed fwl_ / fwl_sig_ (grep audit 2026-09-07: no fwl_ or fwl_sig_ hits elsewhere in src/kernel/).",
      block: {
        push rbp;                                  // parity restore: 0 -> 8
        push rbx;                                  // -> 0
        push r12;                                  // -> 8
        push r13;                                  // -> 0
        push r14;                                  // -> 8
        // Body-wide rsp%16 == 8.

        mov r12, rdi;                              // r12 = manifest_pa
        mov r13, rsi;                              // r13 = manifest_size

        // ================================================================
        // Gate 1: manifest_pa != 0
        // ================================================================
        cmp r12, 0;
        jne fwl_check_size;

        mov rdi, 0;                                // kind = 0 (manifest-level)
        mov rsi, 1;                                // reason = NULL_MANIFEST
        sub rsp, 8;                                // pad -> rsp%16==0
        call fwl_emit_skip;
        add rsp, 8;                                // -> rsp%16==8
        jmp fwl_done_zero;

      fwl_check_size:
        // ================================================================
        // Gate 2: manifest_size >= 16 (room for the header)
        // ================================================================
        cmp r13, 16;
        jae fwl_check_magic;

        mov rdi, 0;
        mov rsi, 2;                                // reason = MANIFEST_TOO_SMALL
        sub rsp, 8;
        call fwl_emit_skip;
        add rsp, 8;
        jmp fwl_done_zero;

      fwl_check_magic:
        // ================================================================
        // Gate 3: header.magic @ +0 == 0x464D4450
        // ================================================================
        mov eax, [r12 + 0];                        // u32 zero-extends to rax
        mov ecx, 0x464D4450;                       // 32-bit imm zero-extends to rcx
        cmp rax, rcx;
        je fwl_check_version;

        mov rdi, 0;
        mov rsi, 3;                                // reason = BAD_MAGIC
        sub rsp, 8;
        call fwl_emit_skip;
        add rsp, 8;
        jmp fwl_done_zero;

      fwl_check_version:
        // ================================================================
        // Gate 4: header.version @ +4 == 1
        // ================================================================
        mov eax, [r12 + 4];
        cmp rax, 1;
        je fwl_load_count;

        mov rdi, 0;
        mov rsi, 4;                                // reason = BAD_VERSION
        sub rsp, 8;
        call fwl_emit_skip;
        add rsp, 8;
        jmp fwl_done_zero;

      fwl_load_count:
        // ================================================================
        // Load header.entry_count @ +8 into rbx (u32 zero-extends).
        //
        // A count of 0 is legal (empty manifest -- a legitimate
        // "operator shipped a manifest with no firmware payloads"
        // outcome); the entry-dispatch loop below terminates on the
        // first `cmp r14, rbx; jae fwl_done_zero` iteration, so no
        // FW LOAD OK / SKIP lines are emitted per-entry.
        //
        // SECURITY NOTE (R111.M6-023, paideia-os #2422 CVE fix):
        // There is INTENTIONALLY NO count==0 early-return here.  A
        // previous shape had `cmp rbx, 0; je fwl_done_zero;` at this
        // point, which SHORT-CIRCUITED past gate 5 (count-overflow /
        // room-for-sig-trailer) AND gate 5.5 (whole-manifest Ed25519
        // sig verify).  That let an ATTACKER pose an unsigned zero-
        // entry manifest as validated: the loader accepted it without
        // ever touching the 64-byte sig trailer, and downstream code
        // could not distinguish "empty and validated" from "empty and
        // unverified" because no FW MANIFEST SIG OK / FAIL line was
        // ever emitted.  The correct shape (this shape) lets control
        // fall through to gate 5 (which asserts manifest_size >=
        // 16 + 0*32 + 64 = 80 for the trailer's room) AND gate 5.5
        // (which invokes fw_manifest_verify_signature over bytes
        // [0, manifest_size - 64) of the pool alloc).  On sig VERIFY
        // OK the FW MANIFEST SIG OK line is emitted and control falls
        // into the loop which then terminates on i==0<count==0 without
        // dispatch.  On sig VERIFY FAIL the FW MANIFEST SIG FAIL +
        // FW LOAD SKIP kind=0 reason=10 pair is emitted (identical to
        // the count>0 sig-fail shape).  Witness: the appearance of
        // FW MANIFEST SIG OK / FAIL on an empty-manifest boot is the
        // regression trip-wire for this CVE (a future -kernel-matrix
        // golden that stages a valid-header count=0 all-zero-sig
        // manifest MUST see FW MANIFEST SIG OK; the same manifest
        // with any non-zero sig byte MUST see SIG FAIL reason=2 +
        // SKIP kind=0 reason=10; the same manifest with size < 80
        // MUST see SKIP kind=0 reason=5 -- three distinct outcomes
        // that pre-fix all collapsed to "silent return-0").
        // ================================================================
        mov ebx, [r12 + 8];

        // ================================================================
        // Gate 5: 16 + count*32 + 64 <= manifest_size
        //
        // Compute in rax; no 2-op imul r,imm (encoder pitfall) -- use
        // `shl rax, 5` for *32.  Overflow: count is u32 (max 2^32-1),
        // count << 5 fits in u64 without overflow (max 2^37-1); the
        // + 16 + 64 fits without overflow too (max 2^37).  R111.M6-023
        // grew this from `+ 16` to `+ 16 + 64` to also require room
        // for the Ed25519 sig trailer (FW_MANIFEST_SIG_TRAILER_SIZE).
        // ================================================================
        mov rax, rbx;
        shl rax, 5;                                // rax = count * 32
        add rax, 16;                               // rax = 16 + count*32
        add rax, 64;                               // rax = 16 + count*32 + 64 (sig trailer)
        cmp rax, r13;
        jbe fwl_sig_verify;

        mov rdi, 0;
        mov rsi, 5;                                // reason = COUNT_OVERFLOW
        sub rsp, 8;
        call fwl_emit_skip;
        add rsp, 8;
        jmp fwl_done_zero;

      fwl_sig_verify:
        // ================================================================
        // Gate 5.5 (R111.M6-023 #2375): whole-manifest Ed25519 sig
        // verify.  Runs BEFORE the entry-dispatch loop.  On VERIFY
        // FAIL emit `FW MANIFEST SIG FAIL reason=<FW_SIG_FAIL_*>` and
        // `FW LOAD SKIP kind=0 reason=10` and return 0 -- the
        // "manifest sig FAIL -> skip ALL entries" policy from issue
        // #2375.  On VERIFY OK emit `FW MANIFEST SIG OK` and proceed.
        //
        // Args to fw_manifest_verify_signature:
        //   rdi = manifest_pa   (r12)
        //   rsi = manifest_size (r13)
        //   rdx = pubkey_pa     (&fw_manifest_trust_root_pubkey)
        //
        // Return: 0 on PASS, FW_SIG_FAIL_* (non-zero) on FAIL.
        // Callee-saves r12/r13/rbx/r14 preserved automatically per
        // SysV convention (fw_manifest_verify_signature is a leaf
        // that touches only rax/r10/r11 -- see manifest_sig.pdx).
        // ================================================================
        mov rdi, r12;                              // manifest_pa
        mov rsi, r13;                              // manifest_size
        lea rdx, [rip + fw_manifest_trust_root_pubkey];
        sub rsp, 8;                                // pad -> rsp%16==0
        call fw_manifest_verify_signature;
        add rsp, 8;                                // -> rsp%16==8
        cmp rax, 0;
        je fwl_sig_ok;

        // Sig FAIL: emit the sig-specific line first (with the
        // FW_SIG_FAIL_* sub-reason still in rax), then the umbrella
        // SKIP line, then short-return skipping ALL entries.
        mov rdi, rax;                              // reason (FW_SIG_FAIL_*)
        sub rsp, 8;
        call fwl_emit_sig_fail;
        add rsp, 8;

        mov rdi, 0;                                // kind = 0 (manifest-level)
        mov rsi, 10;                               // reason = FW_SKIP_SIG_FAIL
        sub rsp, 8;
        call fwl_emit_skip;
        add rsp, 8;
        jmp fwl_done_zero;

      fwl_sig_ok:
        // Sig VERIFIED: emit the OK line and fall through into the
        // entry-dispatch loop.
        sub rsp, 8;
        call fwl_emit_sig_ok;
        add rsp, 8;

      fwl_init_loop:
        xor r14, r14;                              // i = 0

      fwl_loop:
        // ================================================================
        // Loop condition: i < entry_count
        // ================================================================
        cmp r14, rbx;
        jae fwl_done_zero;

        // ================================================================
        // Compute entry_pa = manifest_pa + 16 + i*32 into rax.
        // Rebuilt each iteration so no additional callee-save reg
        // burden.
        // ================================================================
        mov rax, r14;
        shl rax, 5;                                // rax = i * 32
        add rax, 16;                               // + header size
        add rax, r12;                              // + manifest_pa

        // Load entry fields (each u32 zero-extends into its 64-bit reg).
        mov ecx, [rax + 0];                        // rcx = kind
        mov r8d, [rax + 4];                        // r8  = offset
        mov r9d, [rax + 8];                        // r9  = size

        // ================================================================
        // Gate 6: offset + size <= manifest_size - 64 (per-entry bounds).
        //
        // offset and size are u32 (max 2^32-1 each); offset+size fits
        // in u64 without overflow (max 2^33-1).  The right-hand side
        // uses `manifest_size - 64` to defend against a blob body
        // spilling into the sig trailer's memory: gate 5 has already
        // guaranteed manifest_size >= 16 + count*32 + 64 >= 80, so
        // the subtraction does not underflow in u64 arithmetic.
        // R111.M6-023 tightened this from `<= manifest_size` to
        // `<= manifest_size - 64` for defense-in-depth alongside the
        // whole-manifest sig verify at gate 5.5.
        // ================================================================
        mov rax, r8;
        add rax, r9;                               // rax = offset + size
        mov r10, r13;
        sub r10, 64;                               // r10 = manifest_size - 64
        cmp rax, r10;
        jbe fwl_stage_locals;

        // OOB: emit SKIP kind=<kind> reason=7.  rcx holds kind but is
        // about to be clobbered by fwl_emit_skip's arg-move; we do the
        // move now.
        mov rdi, rcx;
        mov rsi, 7;                                // reason = ENTRY_OOB
        sub rsp, 8;
        call fwl_emit_skip;
        add rsp, 8;
        jmp fwl_loop_next;

      fwl_stage_locals:
        // ================================================================
        // Stage per-iteration locals on the stack so they survive the
        // per-kind loader call (and the SHA verify call).  Also brings
        // rsp%16 from 8 to 0 (3 pushes = 24 bytes = 8 mod 16), so the
        // subsequent direct calls are SysV-aligned without extra pad.
        //
        //   [rsp+16] = kind
        //   [rsp+8]  = size
        //   [rsp+0]  = blob_pa = manifest_pa + offset
        // ================================================================
        mov rax, r12;
        add rax, r8;                               // rax = blob_pa
        push rcx;                                  // [rsp+16] = kind
        push r9;                                   // [rsp+8]  = size
        push rax;                                  // [rsp+0]  = blob_pa

        // ================================================================
        // Gate 7: fw_manifest_sha256_verify(blob_pa, size, sha_ptr)
        //
        // sha_ptr = entry_pa + 12 = manifest_pa + 16 + i*32 + 12.
        // Rebuilt from r12+r14 rather than stashed to avoid burning a
        // callee-save reg on a value used once.  R111.M6-023 renamed
        // the callee from `_stub` and rebuilt its body to do a real
        // 20-byte compare against a stubbed all-zero hash (dev-bypass:
        // accept iff entry.sha256 is all-zero); caller-side ABI
        // unchanged.  Real R32 SHA-256 primitive drop-in path is
        // documented at the callee's justification.
        // ================================================================
        mov rdi, rax;                              // blob_pa (from [rsp+0])
        mov rsi, r9;                               // size (from r9, still live)
        mov rdx, r14;
        shl rdx, 5;
        add rdx, 16;                               // header size
        add rdx, 12;                               // sha256 field offset
        add rdx, r12;                              // + manifest_pa
        call fw_manifest_sha256_verify;
        cmp rax, 0;
        je fwl_dispatch;

        // SHA mismatch: emit SKIP kind=<kind> reason=8 and continue.
        mov rdi, [rsp + 16];                       // kind
        mov rsi, 8;                                // reason = SHA_MISMATCH
        call fwl_emit_skip;
        add rsp, 24;                               // drop locals
        jmp fwl_loop_next;

      fwl_dispatch:
        // ================================================================
        // Gate 8: dispatch on kind.  All arg registers are free at this
        // point (SHA stub returned into rax which we've compared and
        // dropped); locals live on the stack.
        // ================================================================
        mov rax, [rsp + 16];                       // kind
        cmp rax, 1;
        je fwl_disp_microcode;
        cmp rax, 2;
        je fwl_disp_guc;
        cmp rax, 3;
        je fwl_disp_huc;

        // Unknown kind: emit SKIP kind=<kind> reason=6.
        mov rdi, rax;
        mov rsi, 6;                                // reason = UNKNOWN_KIND
        call fwl_emit_skip;
        add rsp, 24;
        jmp fwl_loop_next;

      fwl_disp_microcode:
        // ================================================================
        // kind=1 microcode: microcode_load_and_apply(blob_pa, size).
        // Return value = post-apply revision (0 on skip, non-zero on
        // success).  On success we emit FW LOAD OK with ver=<new_rev>;
        // on failure (returns 0) we emit SKIP reason=9 (the underlying
        // MICROCODE APPLY SKIP fingerprint from microcode.pdx carries
        // the specific microcode-level reason code separately).
        // ================================================================
        mov rdi, [rsp + 0];                        // blob_pa
        mov rsi, [rsp + 8];                        // size
        call microcode_load_and_apply;
        cmp rax, 0;
        je fwl_disp_failed;

        mov rdi, 1;                                // kind = MICROCODE
        mov rsi, rax;                              // ver = new_rev
        mov rdx, [rsp + 8];                        // size
        call fwl_emit_ok;
        add rsp, 24;
        jmp fwl_loop_next;

      fwl_disp_guc:
        // ================================================================
        // kind=2 GuC: guc_firmware_bundle_verify(blob_pa, size).  R111
        // .M6-020 (#2372) Intel CSS-header parser — reads the raw Intel
        // firmware blob (module_type=6 gate + header_size_dw + vendor +
        // sw_version.major=70 + signature slot non-zero).  Returns 0
        // on OK, error code (0xFFFFEB7X) on any gate failure.
        //
        // Paideia-envelope dual-sig admission (gucv_verify) is a SEPARATE
        // downstream step: gucv_verify expects magic 'GUCF' at +0 +
        // vendor_sig +8 + paideia_sig +18, produced by a downstream
        // envelope-wrap helper that has not landed.  Wiring it here
        // would fail 100% of the time against a raw Intel blob (module
        // _type byte at +0 != ASCII 'G'). Follow-up: land envelope-wrap
        // helper + call gucv_verify after guc_firmware_bundle_verify
        // succeeds. WOPCM staging (gucl_load) further deferred pending
        // gmmio_is_bound == 1.
        // ================================================================
        mov rdi, [rsp + 0];                        // blob_pa
        mov rsi, [rsp + 8];                        // size
        call guc_firmware_bundle_verify;
        cmp rax, 0;
        jne fwl_disp_failed;

        mov rdi, 2;                                // kind = GUC
        mov rsi, 0;                                // ver = 0 (structural verifier has no revision)
        mov rdx, [rsp + 8];                        // size
        call fwl_emit_ok;
        add rsp, 24;
        jmp fwl_loop_next;

      fwl_disp_huc:
        // ================================================================
        // kind=3 HuC: huc_firmware_bundle_verify(blob_pa, size).  R111
        // .M6-021 (#2373) Intel CSS-header parser — same shape as GuC
        // above, module_type=7 gate, sw_version.major=16.
        //
        // Paideia envelope dual-sig (hucl_verify_vendor + _paideia)
        // deferred for the same reason as GuC — Intel blob at +0 has
        // module_type byte, not ASCII 'HUCF' magic.
        // ================================================================
        mov rdi, [rsp + 0];                        // blob_pa
        mov rsi, [rsp + 8];                        // size
        call huc_firmware_bundle_verify;
        cmp rax, 0;
        jne fwl_disp_failed;

        mov rdi, 3;                                // kind = HUC
        mov rsi, 0;                                // ver = 0
        mov rdx, [rsp + 8];                        // size
        call fwl_emit_ok;
        add rsp, 24;
        jmp fwl_loop_next;

      fwl_disp_failed:
        // Per-kind loader returned non-zero: emit SKIP kind=<kind>
        // reason=9 and continue.
        mov rdi, [rsp + 16];                       // kind
        mov rsi, 9;                                // reason = LOADER_FAILED
        call fwl_emit_skip;
        add rsp, 24;
        // fall through to fwl_loop_next

      fwl_loop_next:
        add r14, 1;
        jmp fwl_loop;

      fwl_done_zero:
        xor rax, rax;                              // return 0

        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        pop rbp;
        ret
      }
    }
}
