// src/kernel/core/fw/manifest_sig.pdx -- R111.M6-023 (paideia-os #2375)
//
// Firmware manifest SIGNED HASH CHAIN -- trust-root public-key material
// + Ed25519 signature-verify seam.
//
// =============================================================================
// SCOPE -- what this milestone opens and what stays deferred
// =============================================================================
//
// R111.M6-023 formalises the R111.M6-022 manifest carry (esp-layout.md
// §2 -- "signed hash chain, this milestone: carry + witness only; parse
// + verify at R111.M6-023") into a real signature-verify seam:
//
//   * Manifest binary format GROWS a 64-byte Ed25519 signature trailer
//     appended after the entry table.  Total layout is now
//         16 (header) + N * 32 (entries) + 64 (sig)   bytes
//     versus the R111.M6-024 layout of `16 + N * 32` bytes.  The trailer
//     lives at manifest_pa + manifest_size - 64.  The signature covers
//     bytes [0, manifest_size - 64) -- the header + entry table -- so
//     any tamper of magic / version / entry_count / any entry field
//     (kind / offset / size / sha256[20]) trips the verify.
//
//   * fw_manifest_verify_signature(manifest_pa, manifest_size, pubkey_pa)
//     is the seam a real Ed25519 primitive drops into (see R32 lattice /
//     Ed25519 roadmap under design/security/pq-trust-root.md §0.2's
//     hybrid Ed25519 + ML-DSA-65 posture).  At this landing the body is
//     a DEV-BYPASS accepting iff the 64-byte trailer is bytewise all
//     zero, matching pdxfs_lite/verify.pdx's pdxfs_sb_verify_sig
//     precedent (R25.M5-001, #929).  Two-source-of-truth invariant per
//     the M5 pattern: this body flips in lockstep with the real
//     ed25519_verify primitive when it lands, at which point the
//     dev-bypass path drops in the same commit.
//
//   * Firmware trust-root public key (fw_manifest_trust_root_pubkey)
//     is a hardcoded 32-byte array (Ed25519 pubkey length).  At R111
//     the array is all zeros -- pairs one-for-one with the dev-bypass
//     accept-all-zero-sig posture in fw_manifest_verify_signature; a
//     tamper of either half of that pair (real sig OR non-zero pubkey)
//     flips the gate to REJECT with no silent-fallback.  The R32/R82
//     signing-key ceremony (design/security/release-line-key-
//     management.md) replaces this array's contents with the release
//     public key.
//
//   * Per-entry SHA verification is a peer concern owned by
//     src/kernel/core/fw/loader.pdx's fw_manifest_sha256_verify (see
//     the parallel dev-bypass shape landed at this milestone -- accept
//     iff the 20-byte entry.sha256 field is all zero; real SHA256
//     primitive drops in at R32).  fw_manifest_verify_signature does
//     NOT descend into per-entry SHA checks: it is a whole-manifest
//     gate that runs BEFORE the per-entry dispatch loop, and a sig
//     FAIL causes ALL entries to be skipped (per issue #2375's boot
//     policy: "manifest sig FAIL -> skip ALL entries").
//
// =============================================================================
// SIGNATURE TRAILER LAYOUT
// =============================================================================
//
//   Offset (from manifest_pa)         Size    Field
//   ---------------------------------------------------------------
//   +0                                16      header (magic, version,
//                                             entry_count, reserved)
//   +16                               N * 32  entry table
//   +16 + N * 32                      64      Ed25519 signature over
//                                             bytes [0, +16 + N * 32)
//
// Signature message input: the concatenation of the header + entry
// table bytes (bytes [0, manifest_size - 64) of the manifest pool
// alloc, i.e. everything BEFORE the sig trailer).  A real Ed25519
// verify drop-in reads exactly those bytes.  The dev-bypass path
// checks only the trailer's zero-ness -- the message-input bytes are
// UNUSED at this landing per pdxfs_sb_verify_sig's own dev-bypass
// precedent (which likewise leaves 692 bytes of superblock header
// unhashed under the flag).
//
// =============================================================================
// FAILURE TAXONOMY (FW_SIG_FAIL_*)
// =============================================================================
//
//   FW_SIG_FAIL_SIZE_TOO_SMALL = 1    manifest_size < 16 + count*32 + 64
//                                     (caller-gate; documented here so
//                                     future non-loader callers reuse
//                                     the same reason code).
//   FW_SIG_FAIL_VERIFY         = 2    signature verify failed (real
//                                     Ed25519 will encode a specific
//                                     sub-code; this landing surfaces
//                                     the umbrella VERIFY reason for
//                                     any dev-bypass sig-trailer non-
//                                     zero byte).
//
// Loader-level (fw/loader.pdx) also mints FW_SKIP_SIG_FAIL = 10 for
// the SKIP tag emitted when firmware_load_all_from_manifest observes
// verify failure and shorts to skip-all-entries.
//
// =============================================================================
// ENCODER POSTURE (per issue #2375 pitfall list)
// =============================================================================
//
//   * No `test rN, rN` -- every zero-check is `cmp rN, 0`.
//   * No 2-op `imul r, imm` -- no multiply anywhere; the 8-qword OR
//     is unrolled.
//   * No `and reg, imm64` -- no bitmasking on the accept path.
//   * No `cmp reg, [mem]` -- every memory read lands in a register
//     first (mirroring the loader.pdx L138+ / microcode.pdx L138+
//     discipline).
//
// =============================================================================
// LABEL DISCIPLINE
// =============================================================================
//
// Labels prefixed `fwmsv_` (fw manifest sig verify).  Grep audit at
// this landing (2026-09-07): no `fwmsv_` hits anywhere else under
// src/kernel/.

module ManifestSig = structure {

  // ==========================================================================
  // Sig-trailer geometry.
  //
  // Ed25519 signatures are exactly 64 bytes per RFC 8032 §5.1.6
  // ("The signature is a 64-octet string").  Aligned to 8 so the
  // 8-qword accumulator loop can be unrolled without a tail dword
  // (64 / 8 = 8 qwords exactly).
  // ==========================================================================

  pub let FW_MANIFEST_SIG_BYTES  : u64 = 64        // Ed25519 signature length
  pub let FW_MANIFEST_SIG_QWORDS : u64 = 8         // 64 / 8

  // Ed25519 public keys are exactly 32 bytes per RFC 8032 §5.1.5
  // ("The public key A is the encoding of the point [s]B, [...] 32
  // octets").
  pub let FW_MANIFEST_PUBKEY_BYTES : u64 = 32

  // ==========================================================================
  // Failure reason codes (see file-header FAILURE TAXONOMY).
  //
  // Returned from fw_manifest_verify_signature; the caller
  // (firmware_load_all_from_manifest) forwards these into the
  // `FW MANIFEST SIG FAIL reason=<dec>` fingerprint.
  // ==========================================================================

  pub let FW_SIG_FAIL_SIZE_TOO_SMALL : u64 = 1
  pub let FW_SIG_FAIL_VERIFY         : u64 = 2

  // ==========================================================================
  // fw_manifest_trust_root_pubkey -- 32-byte Ed25519 public key.
  //
  // AT R111.M6-023: all zeros.  This pairs one-for-one with the
  // dev-bypass accept-all-zero-sig posture in
  // fw_manifest_verify_signature: a manifest whose 64-byte sig
  // trailer is all zero AND whose pubkey slot is all zero passes;
  // any tamper of EITHER half (a real Ed25519 sig with this all-zero
  // pubkey, OR a non-zero pubkey with an all-zero sig) flips the
  // gate to REJECT.
  //
  // AT R32/R82: the real release-line signing pubkey lands here
  // (source of truth: design/security/release-line-key-management.md
  // ceremony output).  When that pubkey lands, the dev-bypass path
  // in fw_manifest_verify_signature drops in the same commit and
  // the real ed25519_verify(msg, sig, pubkey=&this array) call
  // takes over.
  //
  // Rationale for hardcoded-in-kernel (as opposed to loaded from
  // boot_env or from an EFI variable): the trust root MUST resist
  // firmware-time or bootloader-time swap.  A boot_env slot would
  // let a compromised UEFI stub substitute a pubkey the attacker
  // controls; a hardcoded array is fixed at kernel-image sign time
  // and inherits the R28 kernel-image sig-verify (verify_self.pdx)
  // as its own root of trust.  design/security/secure-boot.md §3
  // describes this "trust root inside signed image" pattern under
  // the "no lateral trust escalation" rule.
  // ==========================================================================

  pub let fw_manifest_trust_root_pubkey : [u8; 32] = [
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8
  ]

  // ==========================================================================
  // fw_manifest_verify_signature(manifest_pa, manifest_size, pubkey_pa)
  //     -> u64
  //
  // Returns 0 on verify PASS, non-zero (FW_SIG_FAIL_*) on FAIL.
  //
  // Signature: (manifest_pa: u64, manifest_size: u64, pubkey_pa: u64) -> u64
  //   manifest_pa    -- PA of the manifest pool alloc (byte 0 of the
  //                     16-byte header).
  //   manifest_size  -- length in bytes of the manifest pool alloc
  //                     (including the 64-byte sig trailer).
  //   pubkey_pa      -- PA of the 32-byte Ed25519 public key.  At
  //                     R111.M6-023 the caller passes
  //                     &fw_manifest_trust_root_pubkey; the ABI is
  //                     frozen so a future landing can substitute a
  //                     different key (e.g. a per-ISO release key
  //                     read from a boot_env slot) without a caller-
  //                     side change.
  //
  //   returns 0  -- signature verified over bytes [0, size - 64)
  //                 against the sig trailer bytes [size - 64, size).
  //   returns FW_SIG_FAIL_SIZE_TOO_SMALL if manifest_size < 64 (a
  //                 caller-gate; belt-and-braces because the caller
  //                 in fw/loader.pdx has already checked
  //                 16+count*32+64 <= manifest_size, but this leaf
  //                 rejects independently so a misuse from a future
  //                 non-loader caller cannot underflow into a huge
  //                 sig_ptr).
  //   returns FW_SIG_FAIL_VERIFY otherwise on any non-zero byte in
  //                 the 64-byte sig trailer (dev-bypass semantics).
  //
  // MVP dev-bypass path (R111.M6-023):
  //   sig_ptr = manifest_pa + manifest_size - 64
  //   accept iff the 64 bytes at sig_ptr are bytewise all zero.
  //
  // R32/R82 drop-in path:
  //   ed25519_verify(msg = manifest_pa[0..manifest_size-64],
  //                  sig = manifest_pa[manifest_size-64..manifest_size],
  //                  pubkey = pubkey_pa)
  //   returns 0 on pass, FW_SIG_FAIL_VERIFY on cryptographic reject.
  //
  // Register plan (leaf; no callee-save touched):
  //   r10 = sig_ptr (base + size - 64)
  //   r11 = 8-qword OR accumulator
  //   rax = per-load scratch + return
  //
  // Alignment: entry rsp%16 == 8 (standard SysV callee entry).  No
  // frame, no nested calls -- straight-line body.
  //
  // Encoder posture: no test rN,rN (cmp rN, 0 for every zero-check),
  // no 2-op imul r,imm (no multiply), no and reg,imm64 (no
  // bitmasking), no cmp reg,[mem] (every load staged through rax
  // before the OR).
  //
  // Labels prefixed fwmsv_.
  // ==========================================================================

  pub let fw_manifest_verify_signature : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (manifest_pa: u64) (manifest_size: u64) (pubkey_pa: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R111.M6-023 (paideia-os #2375): firmware manifest Ed25519 signature-verify seam. MVP dev-bypass body -- accepts iff the 64-byte sig trailer at manifest_pa + manifest_size - 64 is bytewise all zero. Matches pdxfs_lite/verify.pdx's pdxfs_sb_verify_sig (R25.M5-001, #929) precedent one-for-one -- same all-zero-sig accept + non-zero-anywhere-in-sig reject shape, rescaled from 3400 B (ML-DSA-65) to 64 B (Ed25519) so the OR loop is 8 qwords unrolled instead of 425 qwords in a rcx-counted loop. Preconditions (checked by fw/loader.pdx caller before invocation): manifest_pa != 0, manifest_size >= 16 + count*32 + 64. This function additionally guards manifest_size < 64 with FW_SIG_FAIL_SIZE_TOO_SMALL for belt-and-braces against a future non-loader caller: a size < 64 would cause manifest_pa + manifest_size - 64 to compute a bogus sig_ptr on the wrong side of the pool alloc. Register plan: r10 = sig_ptr (manifest_pa + manifest_size - 64), r11 = 8-qword OR accumulator, rax = per-load scratch + final return. Leaf: rax/r10/r11 are all SysV caller-save; no prologue needed, no callee-save preserved. Body: (1) belt-and-braces size check -- cmp rsi, 64; jb fwmsv_size_fail. (2) r10 = manifest_pa (rdi) + manifest_size (rsi) - 64. (3) xor r11, r11 -- accumulator = 0. (4) 8 unrolled qword loads OR'd into r11 (bytes 0..64 of sig trailer). (5) cmp r11, 0; jne fwmsv_verify_fail. (6) All-zero -> xor eax, eax; ret. fwmsv_verify_fail: mov rax, 2 (FW_SIG_FAIL_VERIFY); ret. fwmsv_size_fail: mov rax, 1 (FW_SIG_FAIL_SIZE_TOO_SMALL); ret. When the real R32/R82 ed25519_verify primitive lands, this body is replaced with (a) the size gate (kept), (b) a call to ed25519_verify(rdi, rsi-64, r10, rdx) and (c) a translation of that primitive's return into FW_SIG_FAIL_VERIFY (non-zero) or 0 (verified). pubkey_pa (rdx) is accepted and dropped under dev-bypass -- kept in the ABI so the real ed25519_verify seam requires no caller-side change; mirrors ml_dsa_verify_stub's own reserved-but-unused pubkey_pa arg (pdxfs_lite/verify.pdx L196+). Encoder posture: no test rN,rN (all cmp reg, 0), no 2-op imul r,imm (no multiply -- 8 qwords unrolled), no and reg,imm64, no cmp reg,[mem] (each qword load staged through rax before OR). Labels prefixed fwmsv_ (grep audit 2026-09-07: no fwmsv_ hits anywhere else in src/kernel/).",
      block: {
        // (1) Belt-and-braces size gate: manifest_size >= 64.  The
        //     fw/loader.pdx caller has already verified
        //     16 + count*32 + 64 <= manifest_size, so this only
        //     triggers on a misuse from a future non-loader caller.
        cmp rsi, 64;
        jb fwmsv_size_fail;

        // (2) sig_ptr = manifest_pa + manifest_size - 64.
        mov r10, rdi;
        add r10, rsi;
        sub r10, 64;

        // (3) accumulator = 0.
        xor r11, r11;

        // (4) OR every qword (8 total = 64 bytes) into r11.
        mov rax, [r10 + 0];
        or  r11, rax;
        mov rax, [r10 + 8];
        or  r11, rax;
        mov rax, [r10 + 16];
        or  r11, rax;
        mov rax, [r10 + 24];
        or  r11, rax;
        mov rax, [r10 + 32];
        or  r11, rax;
        mov rax, [r10 + 40];
        or  r11, rax;
        mov rax, [r10 + 48];
        or  r11, rax;
        mov rax, [r10 + 56];
        or  r11, rax;

        // (5) Non-zero accumulator -> at least one non-zero byte in
        //     the sig trailer -> reject with FW_SIG_FAIL_VERIFY.
        cmp r11, 0;
        jne fwmsv_verify_fail;

        // (6) All-zero sig -> dev-bypass accept.
        xor rax, rax;
        ret;

      fwmsv_verify_fail:
        mov rax, 2;                                // FW_SIG_FAIL_VERIFY
        ret;

      fwmsv_size_fail:
        mov rax, 1;                                // FW_SIG_FAIL_SIZE_TOO_SMALL
        ret
      }
    }
}
