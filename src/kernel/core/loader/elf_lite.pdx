// src/kernel/core/loader/elf_lite.pdx — R15-m1-004 ELF-lite parser
// elf_lite_parse(image_base, length) — Lightweight ELF header validator & PT_LOAD counter
// Issue: #516
//
// Per design/milestones/r15-m1-004-elf-lite-parser.md:
//   Parse ELF64 executable header and count program headers with p_type == PT_LOAD (1).
//   Validates: magic, class, endianness, version, type (ET_EXEC), machine (EM_X86_64),
//   program header offset, entry size (must == 56), and bounds.
//
// Invariants:
//   - Only counts PT_LOAD (p_type == 1) program headers.
//   - Rejects on any bounds violation or format mismatch.
//   - Returns count (0 on any rejection).
//
// Justification: ELF parsing in supervisor mode for process image validation.
// Unsafe because it reads raw ELF structures from untrusted image memory.

module ElfLite = structure {
  // ELF64 magic (little-endian \x7fELF = 0x464C457F).
  let ELF_MAGIC : u64 = 0x464C457F

  // ELF class, endianness, version field values.
  let ELFCLASS64 : u64 = 2
  let ELFDATA2LSB : u64 = 1
  let EV_CURRENT : u64 = 1

  // ELF type and machine.
  let ET_EXEC : u64 = 2
  let EM_X86_64 : u64 = 0x3E

  // Program header type: PT_LOAD.
  let PT_LOAD : u64 = 1

  // Program header flags.
  let PF_X : u64 = 0x1
  let PF_W : u64 = 0x2
  let PF_R : u64 = 0x4

  // ELF header minimum size (64 bytes).
  let ELF_HEADER_MIN : u64 = 64

  // Program header entry size (56 bytes for ELF64).
  let PHDR_ENTRY_SIZE : u64 = 56

  // Error codes for elf_lite_load (R15-m1-005).
  let ELF_OK : u64 = 0
  let ELF_BAD_HDR : u64 = 0xFFFFFFFF
  let ELF_HIGH_HALF : u64 = 0xFFFFFFFE
  let ELF_WX : u64 = 0xFFFFFFFD
  let ELF_BAD_SIZE : u64 = 0xFFFFFFFC

  // R31.M2-1590 (#1590): per-segment memory-image bound. One frame is
  // allocated per 4 KiB of p_memsz out of a 1024-frame pool
  // (mm/phys_pool.pdx PHYS_POOL_PAGES), so 1 MiB is 256 frames — a
  // quarter of the machine for one segment, which is generous for
  // anything this loader is meant to carry and still finite in the face
  // of a malformed program header. See the §SIZE GATES block below.
  pub let ELF_MAX_SEG_BYTES : u64 = 0x100000
  let ELF_OOM : u64 = 0xFFFFFFFB
  let ELF_MAP_ERR : u64 = 0xFFFFFFFA

  // R20b.M4-002 (#1562): loader-side capability-seed hook failure.
  // Returned when elf_lite_load's post-aspace_map call into
  // loader_seed_caps (src/kernel/core/loader/seed_caps.pdx) rejects the
  // colocated InitCap sidecar. Distinct from ELF_MAP_ERR so the caller
  // (sys_execve.pdx §step 3.5) can distinguish "aspace ready but caps
  // could not be seeded" from "aspace mapping itself failed" — the
  // former still requires aspace teardown but the failure is downstream
  // of the ELF PT_LOAD loop. Value 0xFFFFFFF9 sits directly below
  // ELF_MAP_ERR (0xFFFFFFFA) in the descending taxonomy that
  // sys_execve's justification enumerates.
  let ELF_CAP_SEED_FAILED : u64 = 0xFFFFFFF9

  // elf_lite_parse(image_base, length) — Count PT_LOAD program headers.
  //
  // Signature: elf_lite_parse : (u64, u64) -> u64 !{mem} @{}
  // RDI (input): image_base (phys or virt address of ELF image)
  // RSI (input): length (byte count)
  // RAX (output): count of PT_LOAD headers (0 on any rejection)
  //
  // Clobbers: RAX, RCX, R8, R9, R10, R11, R12, R13, R14, R15
  // Callee-saved: r12, r13, r14 (pushed/popped in prologue/epilogue)
  pub let elf_lite_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (image_base: u64) (length: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R15-m1-004 (#516): Parse ELF64 header, validate format gates, and count PT_LOAD program headers. Reads raw ELF structures from image memory (untrusted, thus unsafe). Register plan: r12=image_base, r13=length, r14=PT_LOAD counter. Rejects on: bounds < 64, magic mismatch, class != 64-bit, endian != LSB, type != ET_EXEC, machine != x86-64, phdr offset overflow, phdr entry size != 56. Per design/milestones/r15-m1-004-elf-lite-parser.md.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;           // r12 = image_base
        mov r13, rsi;           // r13 = length

        // Step 1: Bounds gate — length >= 64
        cmp r13, 64;
        jl elf_lite_reject;

        // Step 2: Magic check — [rdi+0] == 0x464C457F (little-endian \x7fELF)
        mov rax, [r12 + 0];
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        cmp rax, 0x464C457F;
        jne elf_lite_reject;

        // Step 3a: Class gate — [rdi+4] == 2 (ELFCLASS64)
        mov rax, [r12 + 4];
        mov rcx, 0xFF;
        and rax, rcx;
        cmp rax, 2;
        jne elf_lite_reject;

        // Step 3b: Endian gate — [rdi+5] == 1 (LSB)
        mov rax, [r12 + 5];
        mov rcx, 0xFF;
        and rax, rcx;
        cmp rax, 1;
        jne elf_lite_reject;

        // Step 3c: Version gate — [rdi+6] == 1
        mov rax, [r12 + 6];
        mov rcx, 0xFF;
        and rax, rcx;
        cmp rax, 1;
        jne elf_lite_reject;

        // Step 4a: Type gate — [rdi+16] (u16, little-endian) == 2 (ET_EXEC)
        mov rax, [r12 + 16];
        mov rcx, 0xFFFF;
        and rax, rcx;
        cmp rax, 2;
        jne elf_lite_reject;

        // Step 4b: Machine gate — [rdi+18] (u16, little-endian) == 0x3E (EM_X86_64)
        mov rax, [r12 + 18];
        mov rcx, 0xFFFF;
        and rax, rcx;
        cmp rax, 0x3E;
        jne elf_lite_reject;

        // Step 5a: Read e_phoff (u64 at [rdi+32])
        mov r8, [r12 + 32];     // r8 = e_phoff

        // Step 5b: Read e_phentsize (u16 at [rdi+54]) — must equal 56
        mov rax, [r12 + 54];
        mov rcx, 0xFFFF;
        and rax, rcx;
        cmp rax, 56;
        jne elf_lite_reject;

        // Step 5c: Read e_phnum (u16 at [rdi+56])
        mov rax, [r12 + 56];    // Read u16
        mov rcx, 0xFFFF;        // Load mask
        and rax, rcx;           // Mask to u16
        mov r9, rax;            // r9 = e_phnum (zero-extended to u64)

        // Step 6: Overflow check — phoff + phnum*56 <= length
        mov r10, r9;
        mov r11, 56;
        imul r10, r11;          // r10 = phnum * 56
        add r10, r8;            // r10 = phoff + phnum*56
        cmp r10, r13;
        jg elf_lite_reject;

        // Step 7: Loop through program headers, count PT_LOAD
        xor r14, r14;           // r14 = PT_LOAD counter (0)
        xor r15, r15;           // r15 = phdr loop index (0)

        elf_lite_phdr_loop:
          // Check loop termination: i >= e_phnum
          cmp r15, r9;
          jge elf_lite_count_done;

          // Compute phdr address: image_base + phoff + i*56
          mov r10, r15;
          mov r11, 56;
          imul r10, r11;        // r10 = i * 56
          add r10, r8;          // r10 = phoff + i*56
          add r10, r12;         // r10 = image_base + phoff + i*56

          // Read p_type (u32 at [r10+0])
          mov rax, [r10 + 0];
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;
          cmp rax, 1;           // PT_LOAD == 1
          jne elf_lite_phdr_skip;

          // Increment PT_LOAD counter
          add r14, 1;

          elf_lite_phdr_skip:
          add r15, 1;
          jmp elf_lite_phdr_loop;

        elf_lite_count_done:
        // Return count in rax
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

        elf_lite_reject:
        mov rax, 0;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // elf_lite_load(user_pml4_pa, image_base, image_len, owner_task) — Load ELF64 executable into address space.
  //
  // Signature: elf_lite_load : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): user_pml4_pa (root page table for user address space)
  // RSI (input): image_base (phys or virt address of ELF image)
  // RDX (input): image_len (byte count of image)
  // RCX (input): owner_task (*task the image is being loaded FOR, or 0)
  // RAX (output): 0 on success, error code on failure
  //
  // R31.M2-1590 (#1590) — the owner_task argument
  // ---------------------------------------------
  // Until #1590 this function passed a hard-coded `task_ptr = 0` to
  // loader_seed_caps_from_symtab (see §elf_load_done below), with a comment
  // that the real pointer would be threaded through "when R21+ per-task
  // cap_tables land". That deferral outlived its premise. #1587 landed the
  // cap_owner column and #1587/#1589 landed the death-time owner sweep, and
  // BOTH key off the (pid, generation) of the task a capability was minted
  // for — which is precisely what this argument names. With the constant 0
  // in place, every capability seeded through the loader was stamped
  // CAP_OWNER_NONE, and CAP_OWNER_NONE is a value no sweep can ever match:
  // the sweep would run on the holder's death, match nothing, and report
  // success. Seeding without claiming is therefore not a missing nicety, it
  // is a silent capability leak that grows in severity with the authority
  // of the image — an ACPI supervisor holding KIND_OP_REGION windows is
  // exactly the process whose caps must not outlive it.
  //
  // Passing 0 remains legal and meaningful: it says "this image is being
  // loaded for no task", which is true of the structural loader witnesses
  // that load an image purely to exercise the parser. It is NOT a
  // don't-care.
  //
  // Clobbers: RAX, RCX, RDX, RSI, RDI, R8, R9, R10, R11
  // Callee-saved: r12, r13, r14, r15, rbx (pushed/popped in prologue/epilogue)
  pub let elf_lite_load : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (user_pml4_pa: u64) (image_base: u64) (image_len: u64) (owner_task: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R15-m1-005 (#517) + R31.M2-1590 (#1590): Load ELF64 executable into user address space. Validates header, iterates PT_LOAD segments, allocates physical pages, and maps them into user aspace with W^X checks and translated flags. Performs memory allocation, copying, and mapping operations—thus unsafe. Per design/milestones/r15-m1-005-elf-lite-load-into-aspace.md. #1590 adds a fourth argument, owner_task (rcx), spilled immediately to [rsp+72] in the pre-existing 96-byte frame because rcx is caller-save and is clobbered by the very first nested call; slots +72/+80/+88 were the frame's unused tail (the segment loop uses +0..+64). It is reloaded at elf_load_done and handed to loader_seed_caps_from_symtab as the task these capabilities are being minted FOR, replacing the `xor rdi, rdi` that had stood there since M6-001. That constant meant every loader-seeded capability carried CAP_OWNER_NONE, which the death-time owner sweep can never match -- a leak that reports success. Callers that genuinely load an image for no task pass 0 explicitly and still get CAP_OWNER_NONE, which is the correct answer for them rather than an accident.",
      block: {
        // Prologue: push callee-saved, allocate frame
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;
        sub rsp, 96;

        // Register setup
        mov r12, rdi;           // r12 = user_pml4_pa
        mov r13, rsi;           // r13 = image_base
        mov r14, rdx;           // r14 = image_len
        // R31.M2-1590: spill owner_task into the frame's unused tail. rcx is
        // caller-save and dies at the first nested call; the segment loop
        // owns [rsp+0..+64] and never touches +72.
        mov [rsp + 72], rcx;    // owner_task

        // === HEADER VALIDATION ===
        // Bounds gate — length >= 64
        cmp r14, 64;
        jl elf_load_bad_hdr;

        // Magic check — [r13+0] == 0x464C457F (little-endian \x7fELF)
        mov rax, [r13 + 0];
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        cmp rax, 0x464C457F;
        jne elf_load_bad_hdr;

        // Class gate — [r13+4] == 2 (ELFCLASS64)
        mov rax, [r13 + 4];
        mov rcx, 0xFF;
        and rax, rcx;
        cmp rax, 2;
        jne elf_load_bad_hdr;

        // Endian gate — [r13+5] == 1 (LSB)
        mov rax, [r13 + 5];
        mov rcx, 0xFF;
        and rax, rcx;
        cmp rax, 1;
        jne elf_load_bad_hdr;

        // Version gate — [r13+6] == 1
        mov rax, [r13 + 6];
        mov rcx, 0xFF;
        and rax, rcx;
        cmp rax, 1;
        jne elf_load_bad_hdr;

        // Type gate — [r13+16] (u16, LE) == 2 (ET_EXEC)
        mov rax, [r13 + 16];
        mov rcx, 0xFFFF;
        and rax, rcx;
        cmp rax, 2;
        jne elf_load_bad_hdr;

        // Machine gate — [r13+18] (u16, LE) == 0x3E (EM_X86_64)
        mov rax, [r13 + 18];
        mov rcx, 0xFFFF;
        and rax, rcx;
        cmp rax, 0x3E;
        jne elf_load_bad_hdr;

        // Read e_phentsize (u16 at [r13+54]) — must equal 56
        mov rax, [r13 + 54];
        mov rcx, 0xFFFF;
        and rax, rcx;
        cmp rax, 56;
        jne elf_load_bad_hdr;

        // Extract e_phoff (u64 at [r13+32])
        mov rax, [r13 + 32];
        mov [rsp + 0], rax;     // [rsp+0] = e_phoff

        // Extract e_phnum (u16 at [r13+56])
        mov rax, [r13 + 56];
        mov rcx, 0xFFFF;
        and rax, rcx;
        mov rbx, rax;           // rbx = e_phnum
        mov [rsp + 8], rax;     // [rsp+8] = e_phnum (backup)

        // === OVERFLOW CHECK: phoff + phnum*56 <= length ===
        mov r8, rbx;            // r8 = e_phnum
        mov r11, 56;
        imul r8, r11;           // r8 = phnum * 56
        mov r10, [rsp + 0];     // r10 = e_phoff
        add r8, r10;            // r8 = phoff + phnum*56
        cmp r8, r14;
        jg elf_load_bad_hdr;

        // === PT_LOAD LOOP ===
        xor r15, r15;           // r15 = segment loop counter

        elf_load_seg_loop:
          cmp r15, rbx;         // r15 vs e_phnum
          jge elf_load_done;

          // Compute phdr address: image_base + phoff + i*56
          mov r8, r15;
          mov r11, 56;
          imul r8, r11;         // r8 = i * 56
          mov r10, [rsp + 0];   // r10 = e_phoff
          add r8, r10;          // r8 = phoff + i*56
          add r8, r13;          // r8 = image_base + phoff + i*56

          // Read p_type (u32 at [r8+0])
          mov rax, [r8 + 0];
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;
          cmp rax, 1;           // PT_LOAD == 1
          jne elf_load_seg_skip;

          // Read p_flags (u32 at [r8+4])
          mov rax, [r8 + 4];
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;
          mov r9, rax;          // r9 = p_flags

          // === W^X CHECK: both W and X set => error ===
          mov rax, r9;
          and rax, 0x3;         // PF_W (0x2) | PF_X (0x1) = 0x3
          cmp rax, 0x3;         // both set
          je elf_load_wx_error;

          // Read p_offset (u64 at [r8+8])
          mov rax, [r8 + 8];
          mov [rsp + 16], rax;  // [rsp+16] = p_offset

          // Read p_vaddr (u64 at [r8+16])
          mov rax, [r8 + 16];
          mov [rsp + 24], rax;  // [rsp+24] = p_vaddr
          mov r10, rax;         // r10 = p_vaddr

          // === HIGH-HALF CHECK: vaddr >= 0xFFFF800000000000 => error ===
          mov rax, 0xFFFF800000000000;
          cmp r10, rax;
          jae elf_load_high_half_error;

          // Read p_filesz (u64 at [r8+32])
          mov rax, [r8 + 32];
          mov [rsp + 32], rax;  // [rsp+32] = p_filesz

          // Read p_memsz (u64 at [r8+40])
          mov rax, [r8 + 40];
          mov [rsp + 40], rax;  // [rsp+40] = p_memsz
          mov r11, rax;         // r11 = p_memsz

          // ==========================================================
          // === SIZE GATES (R31.M2-1590 / #1590) ===
          //
          // This was one line: `cmp p_memsz, image_len ; jg bad_size`,
          // commented "memsz should be reasonable". It compares a
          // MEMORY size against a FILE size, which is not a bound that
          // means anything — .bss is exactly the case where p_memsz
          // legitimately exceeds the whole image — and it used a SIGNED
          // jg on attacker-supplied u64s. It passed on every image in
          // the tree only because every image happened to be larger on
          // disk than in memory. echo_client, the first image with a
          // non-trivial .bss that anything actually loaded, failed it.
          //
          // Worse, the gate that WAS needed did not exist: nothing
          // checked that a segment's file-backed bytes lie inside the
          // image before the per-page copy loop read them. A crafted
          // p_offset walked off the end of .rodata.userbin.
          //
          // Three real bounds now, in increasing order of what they
          // protect:
          //
          //   (1) p_offset <= image_len, and p_filesz <= image_len -
          //       p_offset. The copy loop's source bytes must be inside
          //       the image. Written as a subtraction against a known-
          //       smaller value rather than `p_offset + p_filesz` so an
          //       adversarial header cannot wrap the addition past the
          //       comparison.
          //
          //   (2) p_filesz <= p_memsz. A segment claiming more file
          //       bytes than memory bytes is malformed, and the copy
          //       loop is bounded by p_memsz, so the excess would be
          //       silently truncated rather than diagnosed.
          //
          //   (3) p_memsz <= ELF_MAX_SEG_BYTES. A resource bound, not a
          //       structural one. The frame pool is 1024 pages total
          //       (mm/phys_pool.pdx) and this loop allocates one frame
          //       per 4 KiB of p_memsz, so an unbounded p_memsz lets a
          //       single malformed program header drain the machine.
          //       phys_alloc returning 0 is the backstop and still
          //       fires; this makes the refusal a diagnosis instead of
          //       an out-of-memory somewhere downstream.
          //
          // r11 = p_memsz, r14 = image_len, [rsp+16] = p_offset,
          // [rsp+32] = p_filesz. rax/rcx are dead here (the per-page
          // loop below re-initialises both); r9 (p_flags) and r10
          // (p_vaddr) are live and untouched.
          // ==========================================================

          // (1a) p_offset inside the image.
          mov rcx, [rsp + 16];  // p_offset
          cmp rcx, r14;
          ja elf_load_bad_size;

          // (1b) p_filesz within the image tail. rax = image_len -
          //      p_offset cannot wrap: (1a) established p_offset <= r14.
          mov rax, r14;
          sub rax, rcx;
          mov rcx, [rsp + 32];  // p_filesz
          cmp rcx, rax;
          ja elf_load_bad_size;

          // (2) p_filesz <= p_memsz.
          cmp rcx, r11;
          ja elf_load_bad_size;

          // (3) p_memsz within the per-segment resource bound.
          mov rax, 0x100000;    // ELF_MAX_SEG_BYTES (1 MiB = 256 frames)
          cmp r11, rax;
          ja elf_load_bad_size;

          // === PER-PAGE LOOP ===
          xor rax, rax;         // rax = offset within segment (use rax instead of rcx)
          mov [rsp + 64], rax;  // initialize page offset scratch to 0

          elf_load_page_loop:
            // R31.M2-1590 (#1590): p_memsz is RELOADED here every
            // iteration, not hoisted.
            //
            // It used to be loaded once, into r8, above the loop — and
            // then the copy step below reloads r8 with p_filesz
            // ("mov r8, [rsp + 32]") on the first iteration. From the
            // second iteration onward this bound therefore compared the
            // page offset against p_filesz instead of p_memsz.
            //
            // The consequence is that this loader has never mapped a
            // segment larger than one page. For every image in the tree
            // that was invisible, because every one of them has both
            // segments under 4 KiB; the loop exited after page 0 having
            // already covered the whole segment. echo_client is the
            // first image anything actually loads whose RW segment spans
            // three pages (8 bytes of .data plus 8 KiB of .bss), and it
            // faulted in ring 3 on its first write to .bss — page 0 was
            // mapped, pages 1 and 2 were not, and elf_lite_load returned
            // ELF_OK. A silently truncated address space is about the
            // worst failure shape available here: the load succeeds, the
            // task starts, and it dies at an arbitrary later instruction
            // with nothing connecting the fault to the loader.
            //
            // Reloading is the fix rather than moving p_filesz to
            // another register because the loop body's register pressure
            // is what created the collision in the first place; a bound
            // read from its spill slot cannot be clobbered by anything
            // between iterations.
            mov r8, [rsp + 40];  // r8 = p_memsz (per-iteration reload)
            cmp rax, r8;        // offset vs p_memsz
            jge elf_load_seg_skip;

            // Allocate physical page
            mov rdi, 0;         // phys_alloc(order=0) — RDI still held user_pml4_pa
                                // from this function's own parameter; phys_alloc's
                                // order-check (rdi != 0 => unsupported, returns 0)
                                // was misfiring on every call, surfacing as false OOM.
            call phys_alloc;    // rax = page pa (or 0 on failure); saves offset on stack
            cmp rax, 0;
            mov rdx, rax;       // rdx = allocated page_pa (save from clobbering)
            je elf_load_oom_error;
            mov [rsp + 48], rdx; // [rsp+48] = allocated page_pa

            // Zero page via manual loop (rep_stosq not supported)
            mov rdi, rdx;       // rdi = page pa
            xor r10, r10;       // r10 = zero loop counter (0)
            xor r11, r11;       // r11 = 0 (for zero value)

            elf_load_zero_loop:
              cmp r10, 512;     // 512 qwords = 4096 bytes
              jge elf_load_zero_done;
              mov [rdi], r11;
              add rdi, 8;
              add r10, 1;
              jmp elf_load_zero_loop;

            elf_load_zero_done:
            mov rax, [rsp + 64]; // Restore offset from stack

            // === PARTIAL COPY (via manual loop, rep_movsb not supported) ===
            // Check if this page's segment-relative offset is still within the
            // file-backed region: [0, p_filesz).
            // #679 fix: earlier code compared page_vaddr (an absolute VA like
            // 0x400000) against p_filesz (a raw size like 0xa20). That check
            // fires unconditionally for any realistic user program, silently
            // skipping the file → page copy and leaving every mapped page
            // zero-filled. Shell then #PFs on its first instruction (byte 0x00
            // = add [rax],al). Correct comparison is `offset vs p_filesz`.
            mov r8, [rsp + 32];  // r8 = p_filesz

            cmp rax, r8;         // segment-relative offset vs p_filesz
            jge elf_load_no_copy; // page fully past file end

            // Calculate copy size: min(4096, p_filesz - offset)
            mov rdx, r8;         // rdx = p_filesz
            sub rdx, rax;        // rdx = p_filesz - offset = remaining bytes
            cmp rdx, 4096;
            jle elf_load_copy_exact;
            mov rdx, 4096;       // cap at page size

            elf_load_copy_exact:
            // Source: image_base + p_offset + offset
            mov rsi, r13;        // rsi = image_base
            mov r10, [rsp + 16]; // r10 = p_offset
            add rsi, r10;        // + p_offset
            mov r10, [rsp + 64]; // r10 = offset
            add rsi, r10;        // + offset within segment

            // Dest: page_pa
            mov rdi, [rsp + 48]; // rdi = page_pa

            // Copy size: rdx (already set); use manual loop
            xor r10, r10;        // r10 = copy loop counter

            elf_load_copy_loop:
              cmp r10, rdx;
              jge elf_load_no_copy;
              mov r11b, [rsi + 0];
              mov [rdi + 0], r11b;
              add rsi, 1;
              add rdi, 1;
              add r10, 1;
              jmp elf_load_copy_loop;

            elf_load_no_copy:
            // === FLAG TRANSLATION ===
            // U (bit 2) always set
            // W (bit 1) if p_flags has PF_W (0x2)
            // NX (bit 63) if p_flags lacks PF_X (0x1)
            xor rcx, rcx;
            or rcx, 0x4;         // Set U (bit 2) using OR

            mov r10, r9;         // r10 = p_flags
            // Check for PF_W (bit 1)
            mov r11, r10;
            and r11, 0x2;
            cmp r11, 0;
            je elf_load_no_w;
            or rcx, 0x2;         // Set W (bit 1) using OR

            elf_load_no_w:
            // Check for PF_X (bit 0)
            mov r11, r10;
            and r11, 0x1;
            cmp r11, 0;
            jne elf_load_has_x;
            // Set NX (bit 63) by ORing with shift-constructed constant
            mov r11, 1;
            shl r11, 63;         // r11 = 0x8000000000000000
            or rcx, r11;

            elf_load_has_x:
            mov [rsp + 56], rcx; // [rsp+56] = translated flags

            // === ASPACE_MAP ===
            mov rdi, r12;        // rdi = user_pml4_pa
            mov rsi, [rsp + 24]; // rsi = p_vaddr
            mov r10, [rsp + 64]; // r10 = offset
            add rsi, r10;        // + offset => page vaddr
            mov rdx, [rsp + 48]; // rdx = page_pa
            mov rcx, [rsp + 56]; // rcx = translated flags

            call aspace_map;
            cmp rax, 0;
            jne elf_load_map_error;

            // Next page
            mov rax, [rsp + 64]; // rax = current offset
            add rax, 4096;       // rax += 4096
            mov [rsp + 64], rax; // save back to stack
            jmp elf_load_page_loop;

        elf_load_seg_skip:
          add r15, 1;
          jmp elf_load_seg_loop;

        elf_load_done:
          // === R20b.M6-001 (#1564): loader capability-seed hook — phase 2 ===
          // After every PT_LOAD segment has been mapped into user_pml4
          // (aspace_map committed) and BEFORE the ELF_OK success return,
          // invoke loader_seed_caps_from_symtab (src/kernel/core/loader/
          // seed_caps.pdx §Symbol walker semantics).
          //
          // Phase-2 posture (M6-001) retires the M4-002 (#1562) empty-
          // sidecar wire-in. The walker reads image_base's raw ELF
          // section header table + .symtab + .strtab to resolve
          // `_init_caps` and `_init_caps_count`, colocates them into
          // its own .bss sidecar scratch, and delegates to loader_seed_caps
          // for validate + mint. Images that don't declare a sidecar
          // (init.elf, shell.elf, child_hello.elf, true.elf at R20b)
          // reach a "no _init_caps symbol found" branch that returns
          // LOADER_SEED_OK without minting — so this replacement is
          // load-preserving for every existing binary.
          //
          // R31.M2-1590 (#1590): task_ptr is now the caller-supplied
          // owner_task, reloaded from the frame spill at [rsp+72].
          //
          // It used to be `xor rdi, rdi`, on the argument that a single
          // global cap_table made the pointer meaningless until per-task
          // CSpaces landed. That argument was about WHERE the descriptor
          // lives; the owner column (#1587) is about WHOSE it is, and the
          // two are independent. With the constant 0 here, loader_seed_caps
          // took its `task_ptr == 0 -> stamp nothing` branch on every real
          // image load, so every seeded capability was CAP_OWNER_NONE and
          // the death-time sweep in driver_death_notify could never match
          // it. The failure mode was silent by construction: the sweep ran,
          // matched zero slots, and returned successfully.
          //
          // On any non-zero rc (LOADER_SEED_FAILED == 0xFFFFFFF9) jump
          // to elf_load_seed_error, which propagates ELF_CAP_SEED_FAILED
          // to elf_lite_load's caller (sys_execve.pdx §step 3.5). The
          // caller then treats the image load as a failure and never
          // enqueues the task — no task can observe a partially-seeded
          // cap_table (fail-fast invariant per M4-001 §validator).
          //
          // Register usage: r12-r15 + rbx are callee-save-preserved
          // through the nested call (loader_seed_caps_from_symtab's own
          // 5-push prologue). rax/rcx/rdx/rsi/rdi caller-save scratch.
          // r13 = image_base, r14 = image_len (per this function's own
          // register plan established at prologue L231-233).
          mov rdi, [rsp + 72];  // task_ptr = owner_task (0 == "for no task")
          mov rsi, r13;         // image_base
          mov rdx, r14;         // image_len
          call loader_seed_caps_from_symtab;
          cmp rax, 0;
          jne elf_load_seed_error;
          xor rax, rax;         // rax = 0 (success)
          jmp elf_load_cleanup;

        // === ERROR PATHS ===
        elf_load_bad_hdr:
          mov rax, 0xFFFFFFFF;  // ELF_BAD_HDR
          jmp elf_load_cleanup;

        elf_load_wx_error:
          mov rax, 0xFFFFFFFD;  // ELF_WX
          jmp elf_load_cleanup;

        elf_load_high_half_error:
          mov rax, 0xFFFFFFFE;  // ELF_HIGH_HALF
          jmp elf_load_cleanup;

        elf_load_bad_size:
          mov rax, 0xFFFFFFFC;  // ELF_BAD_SIZE
          jmp elf_load_cleanup;

        elf_load_oom_error:
          mov rax, 0xFFFFFFFB;  // ELF_OOM
          jmp elf_load_cleanup;

        elf_load_map_error:
          mov rax, 0xFFFFFFFA;  // ELF_MAP_ERR
          jmp elf_load_cleanup;

        elf_load_seed_error:
          mov rax, 0xFFFFFFF9;  // ELF_CAP_SEED_FAILED (R20b.M4-002 #1562)
          jmp elf_load_cleanup;

        elf_load_cleanup:
          add rsp, 96;
          pop rbx;
          pop r15;
          pop r14;
          pop r13;
          pop r12;
          ret
      }
    } @no_frame
}
